        1   DEFINE BUFFER X_contract FOR ub.contract.
        2   DEFINE BUFFER X_contract-specif FOR ub.contract-specif.
        3   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-host-code    as integer   no-undo .
        5   define input parameter p-contract-code as integer   no-undo .
        6   define input parameter p-gds-code as integer   no-undo .
        7   DEF VAR vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
        8   DEF VAR vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
        9   DEF VAR vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       10   DEF VAR vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       11   DEF VAR vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       12   DEF VAR vss-description AS CHAR NO-UNDO INIT "Список истории спецификаций договоров":U.
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable v-waitfram-action01         as character   no-undo .
      118   define variable v-waitfram-action02         as character   no-undo .
      119   define variable v-waitfram-action03         as character   no-undo .
      120   define variable mWaitFramTextBeg            as character   no-undo.
      121   define variable mWaitFramTextEnd            as character   no-undo.
      122   define variable mWaitFramView               as logical     no-undo.
      123   define variable mWaitProcEvent              as logical     no-undo init yes.
      124   define variable mWaitFramInterval           as integer     no-undo init 1 .
      125   define variable mWaitFramStop               as logical     no-undo.
      126   define variable mWaitFramStopUser           as logical     no-undo.
      127   define variable mWaitFramStopTimeOut        as logical     no-undo.
      128   define variable mWaitFramStartProc          as datetime-tz no-undo.
      129   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      130   define button B-WaitFramStop auto-end-key
      131        label "Стоп"
      132        size 10 by 1 tooltip "Остоновить процесс".
      133   define button B-viewProcInfo
      134        label "Информация"
      135        size 15 by 1 tooltip "Информация о процесс".
      136   define frame waitfram
      137     v-waitfram-action01 format "x(72)" no-label skip
      138     v-waitfram-action02 format "x(72)" no-label skip
      139     v-waitfram-action03 format "x(72)" no-label skip
      140     B-viewProcInfo
      141     B-WaitFramStop at row 4 col 30
      142     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      143     .
      144   define new global shared variable mBatchMode as logical no-undo init ?.
      145   define variable mFramBachModHandle as handle no-undo.
      146   mFramBachModHandle = frame waitfram:handle.
      147   define variable mFameOldVis as logical no-undo.
      148   define variable mVisCUrentVin as logical no-undo.
      149   if session:batch-mode
      150   then
      151      mBatchMode = yes.
      152   if mBatchMode = ? then do:
      153     mVisCUrentVin = current-window:visible.
      154     mFameOldVis = mFramBachModHandle:visible.
      155     mFramBachModHandle:visible  = yes.
      156     mBatchMode = mFramBachModHandle:visible ne yes.
      157     mFramBachModHandle:visible = mFameOldVis.
      158     current-window:visible = mVisCUrentVin.
      159   end.
      160    if  log-manager:logfile-name ne ?
      161     then DO:
      162         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      163         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      164         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      165     end.
      166   on choose of B-WaitFramStop in frame waitfram
      167   do:
      168     mWaitFramStop = yes.
      169     mWaitFramStopUser = yes.
      170   end.
      171   function waitfram-check-timeout returns logical():
      172      define variable vtime as int64 no-undo.
      173      if mWaitFramStopTimeOut
      174      then
      175         return yes.
      176      vtime = ( now - mWaitFramStartProc ) / 1000 .
      177      if     mWaitFramTimeOut ne ?
      178         and mWaitFramTimeOut ne 0
      179         and mWaitFramTimeOut lt vtime
      180      then do:
      181         mWaitFramStopTimeOut = yes.
      182      end.
      183      return mWaitFramStopTimeOut.
      184   end.
      185   procedure waitfram-hide :
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       pause 0 before-hide .
      191       if not mBatchMode then
      192         hide frame waitfram .
      193     if     not mWaitFramView
      194        and mWaitProcEvent
      195     then
      196       process events .
      197     end.
      198   end procedure.
      199   procedure waitfram-show :
      200     define input  parameter p-message as character no-undo .
      201     define variable v-left-margin as integer   no-undo .
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       if length(p-message) <= 70 then do:
      207         assign
      208           v-left-margin = integer((70 - length(p-message)) / 2)
      209         .
      210         assign
      211           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      212         .
      213         assign
      214           v-waitfram-action01 = " "
      215           v-waitfram-action02 = " "
      216                                    + fill(" ", v-left-margin)
      217                                    + p-message
      218           v-waitfram-action03 = " "
      219         .
      220       end.
      221       else do:
      222         define variable vRindex1 as integer no-undo.
      223         define variable vRindex2 as integer no-undo.
      224         vRindex1 = r-index(p-message," ",70).
      225         if vRindex1 = 0
      226         then
      227            vRindex1 = 70.
      228         if length(p-message)  <= vRindex1 + 70 then do:
      229           assign
      230             v-waitfram-action01 = " "
      231             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      232             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      233           .
      234         end.
      235         else do:
      236           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      237           if vRindex2 <= vRindex1
      238           then
      239              vRindex2 = vRindex1 + 70.
      240           assign
      241             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      244           .
      245         end.
      246       end.
      247       B-viewProcInfo:visible   in frame waitfram = no.
      248       B-viewProcInfo:sensitive in frame waitfram = no.
      249       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      251       if  (   mWaitFramView
      252          or  mWaitProcEvent)
      253          and not mBatchMode
      254       then
      255          display
      256             v-waitfram-action01 skip
      257             v-waitfram-action02 skip
      258             v-waitfram-action03 skip
      259          with frame waitfram .
      260       if     mWaitFramView
      261          then do:
      262             if     mWaitFramInterval ne ?
      263                and not mBatchMode
      264             then
      265                wait-for go of frame waitfram pause mWaitFramInterval.
      266          end.
      267          else
      268             if     mWaitProcEvent
      269                and not mBatchMode
      270             then
      271                process events .
      272     end.
      273   end procedure.
      274      procedure waitfram-show-this:
      275         define input  parameter iInterval as int64 no-undo.
      276         define variable vtime as int64 no-undo.
      277         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      278         mWaitFramInterval = iInterval.
      279         run waitfram-show (substitute("&1&2 &3&4" ,
      280                                       mWaitFramTextBeg ,
      281                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      282                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      283                                       mWaitFramTextEnd
      284                                      )
      285                           ).
      286      end.
      287      procedure WaitFramRunPause:
      288         define input  parameter iInterval as dec no-undo.
      289         define variable vStart  as datetime-tz no-undo.
      290         define variable vend    as datetime-tz no-undo.
      291         define variable vint as int64 no-undo.
      292         define variable vOk as logical no-undo.
      293         vStart = now.
      294         vend   = vStart.
      295         publish "WaitFramPause" (iInterval,output vOk).
      296         vend   =  now.
      297         vint = vend - vStart.
      298         vint = iInterval - vint / 1000.
      299         if     not mWaitFramStop
      300            and (   vint > 0
      301                 or (    not vOk
      302                     and iInterval eq ?
      303                     )
      304                 )
      305         then
      306            run waitfram-show-this (iInterval).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and vint > 0
      312         then do:
      313            run gbl/pause.p (vint * 1000).
      314         end.
      315         if iInterval ne ?
      316         then
      317            publish "WaitFramStop".
      318         waitfram-check-timeout().
      319      end.
      320      procedure WaitFramWaitFor:
      321         define input  parameter iInterval as dec no-undo.
      322         assign
      323            mWaitFramStartProc   = now
      324            mWaitFramStopUser    = no
      325            mWaitFramStopTimeOut = no
      326         .
      327         block-wait:
      328         do while not mWaitFramStop:
      329            run WaitFramRunPause (iInterval).
      330            if  waitfram-check-timeout()
      331            then do:
      332               leave block-wait.
      333            end.
      334         end.
      335         run waitfram-hide.
      336      end.
      337   procedure waitfram-join :
      338     define input  parameter p-line-1  as character no-undo .
      339     define input  parameter p-line-2  as character no-undo .
      340     define input  parameter p-line-3  as character no-undo .
      341     define output parameter p-message as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       assign
      346         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      348                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      349       .
      350     end.
      351   end procedure.
      352   function waitfram-join-function returns character
      353     (input p-line-1 as character
      354     ,input p-line-2 as character
      355     ,input p-line-3 as character
      356     ).
      357     define variable v-message as character no-undo .
      358     run waitfram-join in this-procedure
      359       (input  p-line-1
      360       ,input  p-line-2
      361       ,input  p-line-3
      362       ,output v-message
      363       ) .
      364     return v-message .
      365   end function .
      366   define new global shared variable g#library  as handle no-undo .
      367   define new global shared variable g#library2 as handle no-undo .
      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   function usrfulnf returns character ( input p-user-id as character):
      370   define variable v-user-name as character no-undo .
      371   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      373     (input  p-user-id
      374     ,output v-user-name
      375     ) no-error .
      376   if error-status:error
      377   or v-user-name = ""
      378   then do:
      379     return p-user-id.
      380   end.
      381   else do:
      382     return v-user-name.
      383   end.
      384   end function.
      385   define temp-table temp-changes no-undo
      386     field f_name as character
      387     field l_name as character
      388     field v_old as character
      389     field v_new as character
      390   index pi is unique primary f_name.
      391   FUNCTION mark-string RETURNS CHARACTER
      392     ( input par-recid as recid, input mark-list as character)  FORWARD.
      393   DEFINE BUTTON B-Help
      394        LABEL "Помо&щь"
      395        SIZE 10 BY 1
      396        BGCOLOR 8 .
      397   DEFINE BUTTON b-quit AUTO-GO
      398        LABEL "&Выход"
      399        SIZE 10 BY 1
      400        BGCOLOR 8 .
      401   DEFINE VARIABLE artic AS CHARACTER FORMAT "X(15)":U
      402        LABEL "Артикул"
      403        VIEW-AS FILL-IN
      404        SIZE 13.5 BY 1 NO-UNDO.
      405   DEFINE VARIABLE gds-name AS CHARACTER FORMAT "X(256)":U
      406        LABEL "Наименование"
      407        VIEW-AS FILL-IN
      408        SIZE 60 BY 1 NO-UNDO.
      409   DEFINE VARIABLE prod AS CHARACTER FORMAT "X(256)":U
      410        LABEL "Производитель"
      411        VIEW-AS FILL-IN
      412        SIZE 16 BY 1 NO-UNDO.
      413   DEFINE QUERY br-c-contract FOR
      414         ub.c-contract-specif SCROLLING.
      415   DEFINE QUERY BR-changes FOR
      416         temp-changes SCROLLING.
      417   DEFINE BROWSE br-c-contract
      418     QUERY br-c-contract NO-LOCK DISPLAY
      419         ub.c-contract-specif.contract-num
      420         ub.c-contract-specif.host-code format ">>>>>>>>>>>>9":U
      421         ub.c-contract-specif.chip-num  COLUMN-LABEL "Щепка!изменения"
      422         ub.c-contract-specif.corr-user-db-num  COLUMN-LABEL "БД!изменения"
      423         ub.c-contract-specif.corr-date COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U      WIDTH 9
      424         STRING (ub.c-contract-specif.corr-time,"HH:MM:ss") COLUMN-LABEL "Время!изменения" FORMAT "X(8)":U
      425         usrfulnf(ub.c-contract-specif.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
      426       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.21 ROW-HEIGHT-CHARS .58.
      427   DEFINE BROWSE BR-changes
      428     QUERY BR-changes DISPLAY
      429         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(34)"
      430   temp-changes.v_old COLUMn-LABEL "Было" format "X(30)"
      431   temp-changes.v_new COLUMn-LABEL "Стало" format "X(30)"
      432       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.38.
      433   DEFINE FRAME Dialog-Frame
      434        b-quit AT ROW 1 COL 1
      435        B-Help AT ROW 1 COL 89
      436        artic AT ROW 2 COL 16.5 COLON-ALIGNED
      437        prod AT ROW 2 COL 46.5 COLON-ALIGNED
      438        gds-name AT ROW 3 COL 14 COLON-ALIGNED
      439        br-c-contract AT ROW 4.04 COL 1.38
      440        BR-changes AT ROW 13.5 COL 1.38
      441        "Товар" VIEW-AS TEXT
      442             SIZE 6.5 BY .67 AT ROW 2.21 COL 2
      443             FGCOLOR 4
      444        SPACE(90.88) SKIP(19.15)
      445       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      446            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      447            TITLE "Список договоров"
      448            CANCEL-BUTTON b-quit.
      449   ASSIGN
      450          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      451          FRAME Dialog-Frame:HIDDEN           = TRUE.
      452   ASSIGN
      453          artic:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      454   ASSIGN
      455          br-c-contract:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      456   ASSIGN
      457          gds-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      458   ASSIGN
      459          prod:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      460   ON VALUE-CHANGED OF br-c-contract IN FRAME Dialog-Frame
      461   DO:
      462     run proc-view-changes in this-procedure no-error.
      463   END.
      464   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      465   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      466   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   on help of frame Dialog-Frame
      468   do:
      469     run gbl/app_help.p
      470       (input this-procedure :file-name
      471       ,input ''
      472       ,input ?
      473       ) no-error.
      474     if error-status :error then do:
      475       message
      476         "Ошибка при вызове помощи"
      477         error-status :get-message(1)
      478         view-as alert-box .
      479     end.
      480   end.
      481   run minbtn-set in this-procedure .
      482   on choose of b-help in frame Dialog-Frame
      483   do:
      484     apply "help":u to frame Dialog-Frame .
      485   end.
      486   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      487   procedure minbtn-set :
      488       do
      489           on error undo, return error return-value
      490           :
      491           define variable ii              as integer       no-undo .
      492           define variable fh              as widget-handle no-undo .
      493           define variable hh              as widget-handle no-undo .
      494           define variable v-h             as handle        extent 4 no-undo .
      495           define variable v-name-button   as character     no-undo .
      496           define variable v-help-old-x    as decimal       no-undo .
      497           define variable v-help-old-y    as decimal       no-undo .
      498           define variable v-help-old-size as decimal       no-undo .
      499           define variable v-frame-width   as decimal       no-undo .
      500           define variable jj              as integer       no-undo .
      501           do
      502               on error undo, return error
      503               :
      504               assign
      505                   v-frame-width = frame Dialog-Frame:width - 0.3
      506                   fh            = frame Dialog-Frame:first-child
      507                   hh            = fh:first-child
      508                   ii            = 1
      509                   .
      510               do while valid-handle(hh):
      511                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      512                   do:
      513                       case lc(hh:name) :
      514                           when "b-help" then
      515                               do:
      516                                   hh:load-image-up("cmp/b-help.bmp":u) .
      517                                   hh:load-image-down("cmp/b-help.bmp":u) .
      518                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      519                                   hh:TOOLTIP = "Помощь" .
      520                                   v-help-old-x = hh:column .
      521                                   v-help-old-y = hh:row    .
      522                                   v-help-old-size = hh:width .
      523                                   hh:width-chars = 2.5 .
      524                               end.
      525                           when "b-print" then
      526                               do:
      527                                   hh:load-image("cmp/b-print.bmp":u) .
      528                                   hh:TOOLTIP = "Печать" .
      529                                   v-h[ii] = hh:handle .
      530                                   ii = ii + 1 .
      531                                   hh:width-chars = 3 .
      532                               end.
      533                           when "b-history" or
      534                           when "b-hist" then
      535                               do:
      536                                   hh:load-image("cmp/b-hist.bmp":u) .
      537                                   hh:TOOLTIP = "История" .
      538                                   v-h[ii] = hh:handle .
      539                                   ii = ii + 1 .
      540                                   hh:width-chars = 3 .
      541                               end.
      542                           when "b-sch" then
      543                               do:
      544                                   hh:load-image("cmp/b-sch.bmp":u) .
      545                                   hh:TOOLTIP = "Установка Фильтра" .
      546                                   v-h[ii] = hh:handle .
      547                                   ii = ii + 1 .
      548                                   hh:width-chars = 3 .
      549                               end.
      550                           when "b-hist-user" then
      551                               do:
      552                                   hh:load-image("cmp/b-hist.bmp":u) .
      553                                   hh:TOOLTIP = "История пользователя" .
      554                                   ii = ii + 1 .
      555                               end.
      556                       end case.
      557                   end.
      558                   hh = hh:next-sibling.
      559               end.
      560               b-help:column = v-frame-width - b-help:width-chars.
      561               jj = 0.
      562               repeat ii = 4 to 1 by -1 :
      563                   if valid-handle (v-h[ii] ) then
      564                   do:
      565                       jj  = jj + 1 .
      566                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      567                       v-h[ii]:row    = v-help-old-y .
      568                   end.
      569               end.
      570           end.
      571       end.
      572   end procedure.
      573   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      574   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      575   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      576   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      577   define variable v-diasize-current-frame-width  as decimal   no-undo .
      578   define variable v-diasize-current-frame-height as decimal   no-undo .
      579   define variable v-diasize-change-size          as logical   no-undo .
      580   define variable v-diasize-resize-button        as handle    no-undo .
      581   define variable v-diasize-wndmax               as logical   no-undo .
      582   define variable v-diasize-wndstore             as logical   no-undo .
      583   define variable v-diasize-proc-name            as character no-undo .
      584   define variable v-diasize-browse-handle        as handle    no-undo .
      585   define variable v-diasize-browse-number        as integer   no-undo .
      586   define variable v-diasize-need-full-display    as logical   no-undo init false .
      587   define temp-table temp-diasize-handle no-undo
      588     field handle-value  as handle
      589     field save-position as decimal
      590     index xpk is primary unique handle-value
      591     .
      592   define temp-table temp-browse-handle no-undo
      593     field browse-type   as character
      594     field browse-number as integer
      595     field browse-handle as handle
      596     field original-size as decimal
      597     index xpk is primary unique browse-type browse-number
      598     index xie browse-type browse-handle
      599   .
      600   procedure diasize_change-height :
      601     define input  parameter p-change-value  as decimal   no-undo .
      602     define input  parameter p-move-resize   as logical   no-undo .
      603     define variable v-field-group-handle    as handle    no-undo .
      604     define variable v-object-handle         as handle    no-undo .
      605     define variable v-frame-height          as decimal   no-undo .
      606     define variable v-frame-virtual-height  as decimal   no-undo .
      607     define variable v-browse-height         as decimal   no-undo .
      608     define variable v-window-height         as decimal   no-undo .
      609     define variable v-window-virtual-height as decimal   no-undo .
      610     define variable v-change-sign           as integer   no-undo .
      611     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      612     define buffer buf_temp-browse-handle  for temp-browse-handle .
      613     if p-change-value > 0
      614     then do:
      615       if frame Dialog-Frame :height + p-change-value
      616           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      617       then do:
      618         assign
      619           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      620                           - (frame Dialog-Frame :height-chars)
      621         .
      622         if p-change-value <= 0
      623         then do:
      624           run diasize_position-resize-button in this-procedure .
      625           return .
      626         end.
      627       end.
      628     end.
      629     if p-change-value < 0
      630     then do:
      631       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      632       then do:
      633         assign
      634           p-change-value = v-diasize-orig-frame-height
      635                          - (frame Dialog-Frame :height-chars)
      636         .
      637         if p-change-value >= 0
      638         then do:
      639           run diasize_position-resize-button in this-procedure .
      640           return .
      641         end.
      642       end.
      643     end.
      644     if p-change-value >= 0
      645     then do:
      646       assign
      647         v-change-sign = 1
      648       .
      649     end.
      650     else do:
      651       assign
      652         v-change-sign = -1
      653       .
      654     end.
      655     assign
      656       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      657     .
      658     if p-change-value = 0
      659     then do:
      660       run diasize_position-resize-button in this-procedure .
      661       return .
      662     end.
      663     move_block:
      664     do
      665     on error undo move_block, retry move_block
      666     :
      667       if retry
      668       then do:
      669         do
      670         on error undo move_block, leave move_block
      671         :
      672           if p-change-value > 0
      673           then do:
      674             for each buf_temp-diasize-handle
      675             on error undo, next
      676             :
      677               assign
      678                 v-object-handle = buf_temp-diasize-handle.handle-value
      679               .
      680               if v-object-handle <> v-diasize-resize-button
      681               then do:
      682                 assign
      683                   v-object-handle :row = buf_temp-diasize-handle.save-position
      684                 .
      685               end.
      686             end.
      687             assign
      688               v-diasize-browse-handle :height = v-browse-height
      689             .
      690             for each buf_temp-browse-handle
      691               where buf_temp-browse-handle.browse-type = 'height':u
      692             on error undo, next
      693             :
      694               assign
      695                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      696               .
      697             end.
      698             assign
      699               frame Dialog-Frame :height = v-frame-height
      700             .
      701             if frame Dialog-Frame :scrollable = true
      702             then do:
      703               assign
      704                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      705               .
      706             end.
      707             run diasize_position-resize-button in this-procedure .
      708           end.
      709           else do:
      710             if frame Dialog-Frame :scrollable = true
      711             then do:
      712               assign
      713                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      714               .
      715             end.
      716             assign
      717               frame Dialog-Frame :height = v-frame-height
      718             .
      719             assign
      720               v-diasize-browse-handle :height = v-browse-height
      721             .
      722             for each buf_temp-browse-handle
      723               where buf_temp-browse-handle.browse-type = 'height':u
      724             on error undo, next
      725             :
      726               assign
      727                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      728               .
      729             end.
      730             for each buf_temp-diasize-handle
      731             on error undo, next
      732             :
      733               assign
      734                 v-object-handle = buf_temp-diasize-handle.handle-value
      735               .
      736               if v-object-handle <> v-diasize-resize-button
      737               then do:
      738                 assign
      739                   v-object-handle :row = buf_temp-diasize-handle.save-position
      740                 .
      741               end.
      742             end.
      743             run diasize_position-resize-button in this-procedure .
      744           end.
      745           assign
      746             v-diasize-change-size = false
      747           .
      748           leave move_block .
      749         end.
      750       end.
      751       assign
      752         v-diasize-need-full-display = true
      753       .
      754       if v-diasize-change-size = false
      755       then do:
      756         assign
      757           v-diasize-change-size = true
      758         .
      759       end.
      760       else do:
      761         return .
      762       end.
      763       assign
      764         v-frame-height = frame Dialog-Frame :height
      765         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      766         v-browse-height = v-diasize-browse-handle :height
      767       .
      768       for each buf_temp-browse-handle
      769         where buf_temp-browse-handle.browse-type = 'height':u
      770       :
      771         assign
      772           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      773         .
      774       end.
      775       for each buf_temp-diasize-handle
      776       :
      777         delete buf_temp-diasize-handle .
      778       end.
      779       assign
      780         v-field-group-handle = frame Dialog-Frame :first-child
      781       .
      782       do while valid-handle(v-field-group-handle)
      783       :
      784         assign
      785           v-object-handle = v-field-group-handle :first-child
      786         .
      787         do while valid-handle(v-object-handle)
      788         :
      789           if  v-object-handle <> v-diasize-browse-handle :handle
      790           and can-query(v-object-handle, "row")
      791           and can-query(v-object-handle, "height")
      792           and ( v-object-handle :row > v-diasize-browse-handle :row )
      793           then do:
      794             find first buf_temp-browse-handle
      795               where buf_temp-browse-handle.browse-type   = 'height':u
      796                 and buf_temp-browse-handle.browse-handle = v-object-handle
      797               no-error .
      798             if available buf_temp-browse-handle
      799             then do:
      800             end.
      801             else do:
      802               create buf_temp-diasize-handle .
      803               assign
      804                 buf_temp-diasize-handle.handle-value  = v-object-handle
      805                 buf_temp-diasize-handle.save-position = v-object-handle :row
      806               .
      807             end.
      808           end.
      809           assign
      810             v-object-handle = v-object-handle :next-sibling
      811           .
      812         end.
      813         assign
      814           v-field-group-handle = v-field-group-handle :next-sibling
      815         .
      816       end.
      817       do with frame Dialog-Frame
      818       :
      819         hide v-diasize-resize-button .
      820         assign
      821           v-diasize-resize-button :row    = 1
      822           v-diasize-resize-button :column = 1
      823         .
      824       end.
      825       if p-change-value > 0
      826       then do:
      827         if frame Dialog-Frame :scrollable = true
      828         then do:
      829           assign
      830             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      831             no-error .
      832           if error-status :error
      833           or error-status :get-message(1) <> ""
      834           then do:
      835             undo move_block, retry move_block .
      836           end.
      837         end.
      838         assign
      839           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      840           no-error .
      841         if error-status :error
      842         or error-status :get-message(1) <> ""
      843         then do:
      844           undo move_block, retry move_block .
      845         end.
      846         assign
      847           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      848           no-error .
      849         if error-status :error
      850         or error-status :get-message(1) <> ""
      851         then do:
      852           undo move_block, retry move_block .
      853         end.
      854         for each buf_temp-browse-handle
      855           where buf_temp-browse-handle.browse-type = 'height':u
      856         on error undo move_block, retry move_block
      857         :
      858           assign
      859             buf_temp-browse-handle.browse-handle :height
      860               = buf_temp-browse-handle.browse-handle :height + p-change-value
      861             no-error .
      862           if error-status :error
      863           or error-status :get-message(1) <> ""
      864           then do:
      865             undo move_block, retry move_block .
      866           end.
      867         end.
      868         for each buf_temp-diasize-handle
      869         on error undo move_block, retry move_block
      870         :
      871           assign
      872             v-object-handle = buf_temp-diasize-handle.handle-value
      873           .
      874           if v-object-handle <> v-diasize-resize-button
      875           then do:
      876             assign
      877               v-object-handle :row = v-object-handle :row + p-change-value
      878               no-error .
      879             if error-status :error
      880             or error-status :get-message(1) <> ""
      881             then do:
      882               undo move_block, retry move_block .
      883             end.
      884           end.
      885         end.
      886       end.
      887       else do:
      888         for each buf_temp-diasize-handle
      889         on error undo move_block, retry move_block
      890         :
      891           assign
      892             v-object-handle = buf_temp-diasize-handle.handle-value
      893           .
      894           if v-object-handle <> v-diasize-resize-button
      895           then do:
      896             assign
      897               v-object-handle :row = v-object-handle :row + p-change-value
      898               no-error .
      899             if error-status :error
      900             or error-status :get-message(1) <> ""
      901             then do:
      902               undo move_block, retry move_block .
      903             end.
      904           end.
      905         end.
      906         assign
      907           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      908           no-error .
      909         if error-status :error
      910         or error-status :get-message(1) <> ""
      911         then do:
      912           undo move_block, retry move_block .
      913         end.
      914         for each buf_temp-browse-handle
      915           where buf_temp-browse-handle.browse-type = 'height':u
      916         on error undo move_block, retry move_block
      917         :
      918           assign
      919             buf_temp-browse-handle.browse-handle :height
      920               = buf_temp-browse-handle.browse-handle :height + p-change-value
      921             no-error .
      922           if error-status :error
      923           or error-status :get-message(1) <> ""
      924           then do:
      925             undo move_block, retry move_block .
      926           end.
      927         end.
      928         assign
      929           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      930           no-error .
      931         if error-status :error
      932         or error-status :get-message(1) <> ""
      933         then do:
      934           undo move_block, retry move_block .
      935         end.
      936         if frame Dialog-Frame :scrollable = true
      937         then do:
      938           assign
      939             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      940             no-error .
      941           if error-status :error
      942           or error-status :get-message(1) <> ""
      943           then do:
      944             undo move_block, retry move_block .
      945           end.
      946         end.
      947       end.
      948       if p-move-resize = true
      949       then do:
      950         run diasize_position-resize-button in this-procedure .
      951       end.
      952       if v-diasize-wndstore = true
      953       then do:
      954         if connected("ub") = true
      955         then do:
      956           define variable v-cntxt-db-num        as integer   no-undo .
      957           define variable v-cntxt-userid        as character no-undo .
      958           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      959                                             , OUTPUT v-cntxt-userid
      960                                             ) .
      961           run gbl/wndsizew.p
      962             (input  v-cntxt-db-num
      963             ,input  v-cntxt-userid
      964             ,input  v-diasize-proc-name
      965             ,input  'height':u
      966             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      967             ) .
      968         end.
      969       end.
      970     end.
      971     assign
      972       v-diasize-change-size = false
      973     .
      974   end procedure.
      975   procedure diasize_set-height :
      976     define input  parameter p-new-height  as decimal   no-undo .
      977     define input  parameter p-move-resize as logical   no-undo .
      978     do
      979     on error undo, return error return-value
      980     :
      981       run diasize_change-height in this-procedure
      982         (input  (p-new-height - frame Dialog-Frame :height)
      983         ,input  p-move-resize
      984         ) .
      985     end.
      986   end procedure.
      987   procedure diasize_change-width :
      988     define input  parameter p-change-value as decimal   no-undo .
      989     define input  parameter p-move-resize  as logical   no-undo .
      990     define variable v-field-group-handle   as handle    no-undo .
      991     define variable v-object-handle        as handle    no-undo .
      992     define variable v-frame-width          as decimal   no-undo .
      993     define variable v-frame-virtual-width  as decimal   no-undo .
      994     define variable v-browse-width         as decimal   no-undo .
      995     define variable v-window-width         as decimal   no-undo .
      996     define variable v-window-virtual-width as decimal   no-undo .
      997     define variable v-change-sign          as integer   no-undo .
      998     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      999     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1000     if p-change-value > 0
     1001     then do:
     1002       if frame Dialog-Frame :width + p-change-value >
     1003           session :width-chars
     1004       then do:
     1005         assign
     1006           p-change-value = session :width-chars - frame Dialog-Frame :width
     1007         .
     1008         if p-change-value <= 0
     1009         then do:
     1010           run diasize_position-resize-button in this-procedure .
     1011           return .
     1012         end.
     1013       end.
     1014     end.
     1015     if p-change-value < 0
     1016     then do:
     1017       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1018       then do:
     1019         assign
     1020           p-change-value = v-diasize-orig-frame-width
     1021                          - frame Dialog-Frame :width
     1022         .
     1023         if p-change-value >= 0
     1024         then do:
     1025           run diasize_position-resize-button in this-procedure .
     1026           return .
     1027         end.
     1028       end.
     1029     end.
     1030     if p-change-value >= 0
     1031     then do:
     1032       assign
     1033         v-change-sign = 1
     1034       .
     1035     end.
     1036     else do:
     1037       assign
     1038         v-change-sign = -1
     1039       .
     1040     end.
     1041     assign
     1042       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1043     .
     1044     if p-change-value = 0
     1045     then do:
     1046       run diasize_position-resize-button in this-procedure .
     1047       return .
     1048     end.
     1049     move_block:
     1050     do
     1051     on error undo move_block, leave move_block
     1052     :
     1053       if retry
     1054       then do:
     1055         do
     1056         on error undo move_block, leave move_block
     1057         :
     1058           if p-change-value > 0
     1059           then do:
     1060             for each buf_temp-diasize-handle
     1061             on error undo, next
     1062             :
     1063               assign
     1064                 v-object-handle = buf_temp-diasize-handle.handle-value
     1065               .
     1066               if v-object-handle <> v-diasize-resize-button
     1067               then do:
     1068                 assign
     1069                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1070                 .
     1071               end.
     1072             end.
     1073             assign
     1074               v-diasize-browse-handle :width = v-browse-width
     1075             .
     1076             for each buf_temp-browse-handle
     1077               where buf_temp-browse-handle.browse-type = 'width':u
     1078             on error undo, next
     1079             :
     1080               assign
     1081                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1082               .
     1083             end.
     1084             assign
     1085               frame Dialog-Frame :width = v-frame-width
     1086             .
     1087             if frame Dialog-Frame :scrollable = true
     1088             then do:
     1089               assign
     1090                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1091               .
     1092             end.
     1093             run diasize_position-resize-button in this-procedure .
     1094           end.
     1095           else do:
     1096             if frame Dialog-Frame :scrollable = true
     1097             then do:
     1098               assign
     1099                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1100               .
     1101             end.
     1102             assign
     1103               frame Dialog-Frame :width = v-frame-width
     1104             .
     1105             for each buf_temp-browse-handle
     1106               where buf_temp-browse-handle.browse-type = 'width':u
     1107             on error undo, next
     1108             :
     1109               assign
     1110                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1111               .
     1112             end.
     1113             assign
     1114               v-diasize-browse-handle :width = v-browse-width
     1115             .
     1116             for each buf_temp-diasize-handle
     1117             on error undo, next
     1118             :
     1119               assign
     1120                 v-object-handle = buf_temp-diasize-handle.handle-value
     1121               .
     1122               if v-object-handle <> v-diasize-resize-button
     1123               then do:
     1124                 assign
     1125                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1126                 .
     1127               end.
     1128             end.
     1129             run diasize_position-resize-button in this-procedure .
     1130           end.
     1131           assign
     1132             v-diasize-change-size = false
     1133           .
     1134           leave move_block .
     1135         end.
     1136       end.
     1137       assign
     1138         v-diasize-need-full-display = true
     1139       .
     1140       if v-diasize-change-size = false
     1141       then do:
     1142         assign
     1143           v-diasize-change-size = true
     1144         .
     1145       end.
     1146       else do:
     1147         return .
     1148       end.
     1149       assign
     1150         v-frame-width = frame Dialog-Frame :width
     1151         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1152         v-browse-width = v-diasize-browse-handle :width
     1153       .
     1154       for each buf_temp-browse-handle
     1155         where buf_temp-browse-handle.browse-type = 'width':u
     1156       :
     1157         assign
     1158           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1159         .
     1160       end.
     1161       for each buf_temp-diasize-handle
     1162       :
     1163         delete buf_temp-diasize-handle .
     1164       end.
     1165       assign
     1166         v-field-group-handle = frame Dialog-Frame :first-child
     1167       .
     1168       do while valid-handle(v-field-group-handle)
     1169       :
     1170         assign
     1171           v-object-handle = v-field-group-handle :first-child
     1172         .
     1173         do while valid-handle(v-object-handle)
     1174         :
     1175           if  v-object-handle <> v-diasize-browse-handle :handle
     1176           and v-object-handle <> v-diasize-resize-button
     1177           and can-query(v-object-handle, "row")
     1178           and can-query(v-object-handle, "height")
     1179           and ( v-object-handle :col + v-object-handle :width
     1180                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1181               )
     1182           then do:
     1183             find first buf_temp-browse-handle
     1184               where buf_temp-browse-handle.browse-type   = 'width':u
     1185                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1186               no-error .
     1187             if available buf_temp-browse-handle
     1188             then do:
     1189             end.
     1190             else do:
     1191               create buf_temp-diasize-handle .
     1192               assign
     1193                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1194                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1195               .
     1196             end.
     1197           end.
     1198           assign
     1199             v-object-handle = v-object-handle :next-sibling
     1200           .
     1201         end.
     1202         assign
     1203           v-field-group-handle = v-field-group-handle :next-sibling
     1204         .
     1205       end.
     1206       do with frame Dialog-Frame
     1207       :
     1208         hide v-diasize-resize-button .
     1209         v-diasize-resize-button :row = 1.
     1210         v-diasize-resize-button :column = 1.
     1211       end.
     1212       if p-change-value > 0
     1213       then do:
     1214         if frame Dialog-Frame :scrollable = true
     1215         then do:
     1216           assign
     1217             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1218             no-error .
     1219           if error-status :error
     1220           or error-status :get-message(1) <> ""
     1221           then do:
     1222             undo move_block, retry move_block.
     1223           end.
     1224         end.
     1225         assign
     1226           frame Dialog-Frame :width = v-frame-width + p-change-value
     1227           no-error .
     1228         if error-status :error
     1229         or error-status :get-message(1) <> ""
     1230         then do:
     1231           undo move_block, retry move_block.
     1232         end.
     1233         assign
     1234           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1235         no-error .
     1236         if error-status :error
     1237         or error-status :get-message(1) <> ""
     1238         then do:
     1239           undo move_block, retry move_block.
     1240         end.
     1241         for each buf_temp-browse-handle
     1242           where buf_temp-browse-handle.browse-type = 'width':u
     1243         on error undo move_block, retry move_block
     1244         :
     1245           assign
     1246             buf_temp-browse-handle.browse-handle :width
     1247               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1248             no-error .
     1249           if error-status :error
     1250           or error-status :get-message(1) <> ""
     1251           then do:
     1252             undo move_block, retry move_block .
     1253           end.
     1254         end.
     1255         for each buf_temp-diasize-handle
     1256         on error undo move_block, retry move_block
     1257         :
     1258           assign
     1259             v-object-handle = buf_temp-diasize-handle.handle-value
     1260           .
     1261           if v-object-handle <> v-diasize-resize-button
     1262           then do:
     1263             assign
     1264               v-object-handle :col = v-object-handle :col + p-change-value
     1265               no-error .
     1266             if error-status :error
     1267             or error-status :get-message(1) <> ""
     1268             then do:
     1269               undo move_block, retry move_block .
     1270             end.
     1271           end.
     1272         end.
     1273       end.
     1274       else do:
     1275         for each buf_temp-diasize-handle
     1276         on error undo move_block, retry move_block
     1277         :
     1278           assign
     1279             v-object-handle = buf_temp-diasize-handle.handle-value
     1280           .
     1281           if v-object-handle <> v-diasize-resize-button
     1282           then do:
     1283             assign
     1284               v-object-handle :col = v-object-handle :col + p-change-value
     1285               no-error .
     1286             if error-status :error
     1287             or error-status :get-message(1) <> ""
     1288             then do:
     1289               undo move_block, retry move_block .
     1290             end.
     1291           end.
     1292         end.
     1293         for each buf_temp-browse-handle
     1294           where buf_temp-browse-handle.browse-type = 'width':u
     1295         on error undo move_block, retry move_block
     1296         :
     1297           assign
     1298             buf_temp-browse-handle.browse-handle :width
     1299               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1300             no-error .
     1301           if error-status :error
     1302           or error-status :get-message(1) <> ""
     1303           then do:
     1304             undo move_block, retry move_block .
     1305           end.
     1306         end.
     1307         assign
     1308           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1309           no-error .
     1310         if error-status :error
     1311         or error-status :get-message(1) <> ""
     1312         then do:
     1313           undo move_block, retry move_block.
     1314         end.
     1315         assign
     1316           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1317         no-error .
     1318         if error-status :error
     1319         or error-status :get-message(1) <> ""
     1320         then do:
     1321           undo move_block, retry move_block.
     1322         end.
     1323         if frame Dialog-Frame :scrollable = true
     1324         then do:
     1325           assign
     1326             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1327           no-error .
     1328           if error-status :error
     1329           or error-status :get-message(1) <> ""
     1330           then do:
     1331             undo move_block, retry move_block.
     1332           end.
     1333         end.
     1334       end.
     1335       if p-move-resize
     1336       then do:
     1337         run diasize_position-resize-button in this-procedure .
     1338       end.
     1339       if v-diasize-wndstore = true
     1340       then do:
     1341         if connected("ub") = true
     1342         then do:
     1343           define variable v-cntxt-db-num        as integer   no-undo .
     1344           define variable v-cntxt-userid        as character no-undo .
     1345           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1346                                             , OUTPUT v-cntxt-userid
     1347                                             ) .
     1348           run gbl/wndsizew.p
     1349             (input  v-cntxt-db-num
     1350             ,input  v-cntxt-userid
     1351             ,input  v-diasize-proc-name
     1352             ,input  'width':u
     1353             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1354             ) .
     1355         end.
     1356       end.
     1357     end.
     1358     assign
     1359       v-diasize-change-size = false
     1360     .
     1361   end procedure.
     1362   procedure diasize_set-width :
     1363     define input  parameter p-new-width  as decimal   no-undo .
     1364     define input  parameter p-move-resize as logical   no-undo .
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368       run diasize_change-width in this-procedure
     1369         (input  (p-new-width - frame Dialog-Frame :width)
     1370         ,input  p-move-resize
     1371         ) .
     1372     end.
     1373   end procedure.
     1374   procedure diasize_position-resize-button :
     1375     do with frame Dialog-Frame
     1376     :
     1377       hide v-diasize-resize-button .
     1378       assign
     1379         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1380                     - 1
     1381                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1382         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1383                     - 1
     1384                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1385       .
     1386       view v-diasize-resize-button .
     1387     end.
     1388   end procedure.
     1389   on alt-right anywhere
     1390   do:
     1391     run diasize_change-width in this-procedure
     1392       (input 1
     1393       ,input true
     1394       ) .
     1395     return no-apply .
     1396   end.
     1397   on alt-left anywhere
     1398   do:
     1399     run diasize_change-width in this-procedure
     1400       (input -1
     1401       ,input true
     1402       ) .
     1403     return no-apply .
     1404   end.
     1405   on alt-down anywhere
     1406   do:
     1407     run diasize_change-height in this-procedure
     1408       (input 1
     1409       ,input true
     1410       ) .
     1411     return no-apply .
     1412   end.
     1413   on alt-up anywhere
     1414   do:
     1415     run diasize_change-height in this-procedure
     1416       (input -1
     1417       ,input true
     1418       ) .
     1419     return no-apply .
     1420   end.
     1421   on alt-enter of frame Dialog-Frame
     1422   do:
     1423     run diasize_maximize in this-procedure
     1424       (input  ?
     1425       ).
     1426     return no-apply .
     1427   end.
     1428   procedure diasize_end-move :
     1429     do
     1430     on error undo, return error return-value
     1431     :
     1432       define variable v-row-delta as decimal   no-undo .
     1433       define variable v-col-delta as decimal   no-undo .
     1434       define variable v-new-row as decimal   no-undo .
     1435       define variable v-new-col as decimal   no-undo .
     1436       assign
     1437         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1438         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1439       .
     1440       assign
     1441         v-row-delta = v-new-row - frame Dialog-Frame :height
     1442         v-col-delta = v-new-col - frame Dialog-Frame :width
     1443       .
     1444       run diasize_change-height in this-procedure
     1445         (input v-row-delta
     1446         ,input true
     1447         ) .
     1448       run diasize_change-width in this-procedure
     1449         (input v-col-delta
     1450         ,input true
     1451         ) .
     1452     end.
     1453   end procedure.
     1454   procedure diasize_maximize :
     1455     define input  parameter p-action as logical   no-undo .
     1456     do
     1457     on error undo, return error return-value
     1458     :
     1459       if p-action = ?
     1460       then do:
     1461         if v-diasize-need-maximize = true
     1462         then do:
     1463           assign
     1464             p-action = true
     1465           .
     1466         end.
     1467         else do:
     1468           assign
     1469             p-action = false
     1470           .
     1471         end.
     1472       end.
     1473       if p-action = true
     1474       then do:
     1475         run diasize_change-height in this-procedure
     1476           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1477               - frame Dialog-Frame :height-chars
     1478           ,input true
     1479           ) .
     1480         run diasize_change-width in this-procedure
     1481           (input session :width-chars
     1482               - frame Dialog-Frame :width-chars
     1483           ,input true
     1484           ) .
     1485         assign
     1486           v-diasize-need-maximize = false
     1487         .
     1488       end.
     1489       else do:
     1490         run diasize_change-width in this-procedure
     1491           (input v-diasize-orig-frame-width
     1492               - frame Dialog-Frame :width-chars
     1493           ,input true
     1494           ) .
     1495         run diasize_change-height in this-procedure
     1496           (input v-diasize-orig-frame-height
     1497               - frame Dialog-Frame :height-chars
     1498           ,input true
     1499           ) .
     1500         assign
     1501           v-diasize-need-maximize = true
     1502         .
     1503       end.
     1504     end.
     1505   end procedure.
     1506   procedure diasize_restore-orig-size :
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       assign
     1511         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1512         v-diasize-current-frame-height = frame Dialog-Frame :height
     1513       .
     1514       run diasize_set-height in this-procedure
     1515         (input  v-diasize-orig-frame-height
     1516         ,input  true
     1517         ) .
     1518       run diasize_set-width in this-procedure
     1519         (input  v-diasize-orig-frame-width
     1520         ,input  true
     1521         ) .
     1522     end.
     1523   end procedure.
     1524   procedure diasize_restore-current-size :
     1525     do
     1526     on error undo, return error return-value
     1527     :
     1528       run diasize_set-height in this-procedure
     1529         (input  v-diasize-current-frame-height
     1530         ,input  true
     1531         ) .
     1532       run diasize_set-width in this-procedure
     1533         (input  v-diasize-current-frame-width
     1534         ,input  true
     1535         ) .
     1536     end.
     1537   end procedure.
     1538   procedure diasize_set-browse-handle :
     1539     define input  parameter p-browse-handle as handle   no-undo .
     1540     define buffer buf_temp-browse-handle for temp-browse-handle .
     1541     do
     1542     on error undo, return error return-value
     1543     :
     1544       assign
     1545         v-diasize-browse-handle = p-browse-handle
     1546       .
     1547       for each buf_temp-browse-handle
     1548       on error undo, return error return-value
     1549       :
     1550         delete buf_temp-browse-handle .
     1551       end.
     1552     end.
     1553   end procedure.
     1554   procedure diasize_add_browse :
     1555     define input  parameter p-browse-type   as character no-undo .
     1556     define input  parameter p-browse-handle as handle    no-undo .
     1557     define buffer buf_temp-browse-handle for temp-browse-handle .
     1558     do
     1559     on error undo, return error return-value
     1560     :
     1561       assign
     1562         v-diasize-browse-number = v-diasize-browse-number + 1
     1563       .
     1564       create buf_temp-browse-handle .
     1565       assign
     1566         buf_temp-browse-handle.browse-type   = p-browse-type
     1567         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1568         buf_temp-browse-handle.browse-handle = p-browse-handle
     1569       .
     1570     end.
     1571   end procedure.
     1572   procedure diasize_init :
     1573     define variable v-default-value    as logical   no-undo .
     1574     define variable v-restore-saved    as logical   no-undo .
     1575     define variable v-resize-value-str as character no-undo .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       do with frame Dialog-Frame
     1580       :
     1581         assign
     1582           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1583           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1584           v-diasize-browse-handle     = browse br-c-contract :handle
     1585         .
     1586         create button v-diasize-resize-button
     1587         assign
     1588           parent        = frame Dialog-Frame :first-child
     1589           label         = "s"
     1590           height-pixels = 16
     1591           width-pixels  = 16
     1592           visible       = true
     1593           sensitive     = true
     1594           movable       = true
     1595           triggers:
     1596             on end-move persistent run diasize_end-move in this-procedure .
     1597           end triggers.
     1598         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1599         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1600         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1601         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1602         assign
     1603           v-diasize-wndmax = false
     1604         .
     1605         if connected("ub") = true
     1606         then do:
     1607           define variable v-cntxt-db-num        as integer   no-undo .
     1608           define variable v-cntxt-userid        as character no-undo .
     1609           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1610                                             , OUTPUT v-cntxt-userid
     1611                                             ) .
     1612           run gbl/wndpar_r.p
     1613             (input  v-cntxt-db-num
     1614             ,input  v-cntxt-userid
     1615             ,input  'wndmax':U
     1616             ,output v-diasize-wndmax
     1617             ,output v-default-value
     1618             ) .
     1619         end.
     1620         assign
     1621           v-diasize-wndstore = false
     1622         .
     1623         if connected("ub") = true
     1624         then do:
     1625           run gbl/wndpar_r.p
     1626             (input  v-cntxt-db-num
     1627             ,input  v-cntxt-userid
     1628             ,input  'wndstore':U
     1629             ,output v-diasize-wndstore
     1630             ,output v-default-value
     1631             ) .
     1632         end.
     1633         assign
     1634           v-diasize-proc-name = entry(1, program-name(2), '.')
     1635         .
     1636         if v-diasize-wndstore = true
     1637         then do:
     1638           assign
     1639             v-restore-saved = false
     1640           .
     1641           if connected("ub") = true
     1642           then do:
     1643             run gbl/wndsizer.p
     1644               (input  v-cntxt-db-num
     1645               ,input  v-cntxt-userid
     1646               ,input  v-diasize-proc-name
     1647               ,input  'height':u
     1648               ,output v-resize-value-str
     1649               ) .
     1650             if v-resize-value-str <> '':U
     1651             then do:
     1652               run diasize_change-height in this-procedure
     1653                 (input  integer(v-resize-value-str)
     1654                 ,input  true
     1655                 ) .
     1656               assign
     1657                 v-restore-saved = true
     1658               .
     1659             end.
     1660           end.
     1661           if connected("ub") = true
     1662           then do:
     1663             run gbl/wndsizer.p
     1664               (input  v-cntxt-db-num
     1665               ,input  v-cntxt-userid
     1666               ,input  v-diasize-proc-name
     1667               ,input  'width':u
     1668               ,output v-resize-value-str
     1669               ) .
     1670             if v-resize-value-str <> '':U
     1671             then do:
     1672               run diasize_change-width in this-procedure
     1673                 (input  integer(v-resize-value-str)
     1674                 ,input  true
     1675                 ) .
     1676               assign
     1677                 v-restore-saved = true
     1678               .
     1679             end.
     1680           end.
     1681           if v-restore-saved <> true
     1682           then do:
     1683             if v-diasize-wndmax = true
     1684             then do:
     1685               run diasize_maximize in this-procedure
     1686                 (input  true
     1687                 ) .
     1688             end.
     1689           end.
     1690         end.
     1691         else do:
     1692           if v-diasize-wndmax = true
     1693           then do:
     1694             run diasize_maximize in this-procedure
     1695               (input  true
     1696               ) .
     1697           end.
     1698         end.
     1699       end.
     1700     end.
     1701   end procedure.
     1702   procedure diasize_need-full-display :
     1703     define output parameter p-need-full-display as logical   no-undo .
     1704     do
     1705     on error undo, return error return-value
     1706     :
     1707       assign
     1708         p-need-full-display = v-diasize-need-full-display
     1709       .
     1710       assign
     1711         v-diasize-need-full-display = false
     1712       .
     1713     end.
     1714   end procedure.
     1715   procedure get-context :
     1716      define output parameter p-db-num as integer          no-undo.
     1717      define output parameter p-user-id as character        no-undo.
     1718      define variable v-login               as character    no-undo.
     1719      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1720      define buffer buf_user-login  for ub.user-login .
     1721      do
     1722      on error undo, return error
     1723      :
     1724            FIND FIRST buf_sys-ctrl no-lock.
     1725            ASSIGN
     1726               v-login = USERID("ub")
     1727               p-db-num = buf_sys-ctrl.db-num
     1728            .
     1729            FIND FIRST buf_user-login
     1730                 WHERE buf_user-login.db-num = p-db-num
     1731                   AND buf_user-login.user-login = v-login
     1732                 no-lock
     1733                 no-error
     1734                 .
     1735            IF AVAILABLE buf_user-login
     1736            THEN DO:
     1737               assign
     1738                  p-user-id = buf_user-login.user-id
     1739               .
     1740            END.
     1741      end.
     1742   end procedure.
     1743       run diasize_init in this-procedure .
     1744   MAIN-BLOCK:
     1745   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1746      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1747     find first X_contract-specif no-lock  where X_contract-specif.host-code = p-host-code and X_contract-specif.contract-num = p-contract-code and X_contract-specif.gds-code = p-gds-code no-error .
     1748     if not available X_contract-specif then do:
     1749       message  vss-workfile vss-revision vss-description skip  "Неверное значение параметра вызова p-host-code и/или p-contract-code"  p-host-code p-contract-code
     1750       view-as alert-box ERROR.
     1751       return.
     1752     end.
     1753     find first X_contract no-lock  where X_contract.host-code = p-host-code and X_contract.contract-code = p-contract-code .
     1754     find first ub.clients no-lock where ub.clients.obj-code = p-host-code and ub.clients.obj-type = 'орг':U .
     1755     find first ub.goods no-lock where ub.goods.gds-code = p-gds-code .
     1756     assign frame Dialog-Frame:title = "История спецификации" + chr(32)  + substitute("Фирма: (&1) &2 Договор : &3 от &4", p-host-code, ub.clients.obj-name,  X_contract.contract-prn-code, string(X_contract.contract-date,"99/99/9999")) .
     1757     assign
     1758       artic    = ub.goods.artic
     1759       prod     = ub.goods.prod-type + " " + string(goods.prod-code)
     1760       gds-name = ub.goods.gds-name
     1761     .
     1762     RUN enable_UI.
     1763     apply "VALUE-CHANGED" to br-c-contract.
     1764     WAIT-FOR GO OF FRAME Dialog-Frame.
     1765   END.
     1766   RUN disable_UI.
     1767   PROCEDURE disable_UI :
     1768     HIDE FRAME Dialog-Frame.
     1769   END PROCEDURE.
     1770   PROCEDURE enable_UI :
     1771     DISPLAY artic prod gds-name
     1772         WITH FRAME Dialog-Frame.
     1773     ENABLE b-quit B-Help br-c-contract BR-changes
     1774         WITH FRAME Dialog-Frame.
     1775     VIEW FRAME Dialog-Frame.
     1776     OPEN QUERY br-c-contract FOR EACH ub.c-contract-specif NO-LOCK       WHERE       ub.c-contract-specif.contract-num = p-contract-code AND       ub.c-contract-specif.gds-code = p-gds-code and       ub.c-contract-specif.host-code = p-host-code      BY ub.c-contract-specif.corr-date DESCENDING      BY ub.c-contract-specif.corr-time DESCENDING.
     1777   END PROCEDURE.
     1778   PROCEDURE proc-view-changes :
     1779     define buffer new_c-contract-specif for ub.c-contract-specif.
     1780     define buffer current_contract-specif for ub.contract-specif.
     1781     define variable v-chg-fields as character no-undo.
     1782     define variable v-old-fields as character no-undo.
     1783     define variable v-new-fields as character no-undo.
     1784     define variable ii as integer no-undo.
     1785     for each temp-changes:  delete temp-changes.  END.
     1786     if available ub.c-contract-specif then do:
     1787       find first new_c-contract-specif no-lock
     1788         where new_c-contract-specif.host-code    = ub.c-contract-specif.host-code
     1789           and new_c-contract-specif.contract-num = ub.c-contract-specif.contract-num
     1790           and new_c-contract-specif.gds-code     = ub.c-contract-specif.gds-code
     1791           and new_c-contract-specif.corr-user-db-num  = ub.c-contract-specif.corr-user-db-num
     1792           and new_c-contract-specif.chip-num     > ub.c-contract-specif.chip-num
     1793         no-error.
     1794       if not available new_c-contract-specif then do:
     1795         find first current_contract-specif no-lock
     1796           where current_contract-specif.host-code   = ub.c-contract-specif.host-code
     1797           and current_contract-specif.contract-num = ub.c-contract-specif.contract-num
     1798           and current_contract-specif.gds-code     = ub.c-contract-specif.gds-code
     1799         no-error.
     1800         if not available current_contract-specif then return error.
     1801         buffer-compare ub.c-contract-specif to current_contract-specif save result in v-chg-fields.
     1802       end.
     1803       else do:
     1804         buffer-compare new_c-contract-specif except chip-num to ub.c-contract-specif save result in v-chg-fields.
     1805       end.
     1806           do ii = 1 to num-entries(v-chg-fields):
     1807         CASE entry(ii, v-chg-fields):
     1808                           when "prc":U then do:       create temp-changes.       assign       temp-changes.f_name = "prc":U       temp-changes.l_name = "Процент отклонения"       temp-changes.v_old = string(ub.c-contract-specif.prc)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.prc)                                else string(current_contract-specif.prc))       .       end.
     1809                           when "price-cli":U then do:       create temp-changes.       assign       temp-changes.f_name = "price-cli":U       temp-changes.l_name = "Цена поставки"       temp-changes.v_old = string(ub.c-contract-specif.price-cli)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.price-cli)                                else string(current_contract-specif.price-cli))       .       end.
     1810                           when "qnty":U then do:       create temp-changes.       assign       temp-changes.f_name = "qnty":U       temp-changes.l_name = "Количество"       temp-changes.v_old = string(ub.c-contract-specif.qnty)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.qnty)                                else string(current_contract-specif.qnty))       .       end.
     1811                           when "cli-base-rate":U then do:       create temp-changes.       assign       temp-changes.f_name = "cli-base-rate":U       temp-changes.l_name = "Коэф."       temp-changes.v_old = string(ub.c-contract-specif.cli-base-rate)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.cli-base-rate)                                else string(current_contract-specif.cli-base-rate))       .       end.
     1812                           when "sum-cli":U then do:       create temp-changes.       assign       temp-changes.f_name = "sum-cli":U       temp-changes.l_name = "Сумма"       temp-changes.v_old = string(ub.c-contract-specif.sum-cli)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.sum-cli)                                else string(current_contract-specif.sum-cli))       .       end.
     1813                           when "VAT-pc":U then do:       create temp-changes.       assign       temp-changes.f_name = "VAT-pc":U       temp-changes.l_name = "НДС"       temp-changes.v_old = string(ub.c-contract-specif.VAT-pc)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.VAT-pc)                                else string(current_contract-specif.VAT-pc))       .       end.
     1814                           when "VAT-type":U then do:       create temp-changes.       assign       temp-changes.f_name = "VAT-type":U       temp-changes.l_name = "тип НДС"       temp-changes.v_old = string(ub.c-contract-specif.VAT-type)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.VAT-type)                                else string(current_contract-specif.VAT-type))       .       end.
     1815                           when "income-qnty":U then do:       create temp-changes.       assign       temp-changes.f_name = "income-qnty":U       temp-changes.l_name = "Принятое кол-во"       temp-changes.v_old = string(ub.c-contract-specif.income-qnty)       temp-changes.v_new = (if available new_c-contract-specif                                then string(new_c-contract-specif.income-qnty)                                else string(current_contract-specif.income-qnty))       .       end.
     1816         END CASE.
     1817       end.
     1818     end.
     1819     Open QUery br-changes for each temp-changes.
     1820   END PROCEDURE.
     1821   FUNCTION mark-string RETURNS CHARACTER
     1822     ( input par-recid as recid, input mark-list as character) :
     1823   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     1824   END FUNCTION.
