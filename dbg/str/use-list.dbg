        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input-output parameter line-rec as recid no-undo .
        4   define input  parameter p-doc-rec as recid no-undo .
        5   define input  parameter p-mode as logical   no-undo .
        6   define input  parameter p-handl-tt as handle no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: b59277d977a0, 2018, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Sep 23 12:18:40 2019 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: use-list.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/use-list.p $":U .
       12   define variable vss-description as character no-undo init "Документ инвентаризации".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define new shared temp-table gds-list no-undo like ub.goods
       75     field qnty   as decimal
       76     field to-del as logical
       77     field order-num as integer
       78     field to-sel as logical
       79     field promo-code as character
       80     field ActionId  as int64
       81     field db-num as integer
       82     index art  is primary unique artic prod-type prod-code
       83     index code is         unique gds-code
       84     index oi order-num
       85     index isel to-sel
       86     .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define  new shared  temp-table gds-list-hist no-undo
       89   field list-table as character
       90   field id as integer
       91   field line as integer
       92   field hist-mode as character
       93   field des as character
       94   field num-recs as integer
       95   field option_ as character
       96   field item_ as character
       97   field status_ as character
       98   field num-add as integer
       99   field num-ignored as integer
      100   field done as logical
      101   field err_ as logical
      102   field err-mes as character
      103   index pi is primary
      104   id
      105   line
      106   index isdone
      107   done
      108   .
      109   define new global shared variable g#lib-trn  as handle no-undo .
      110   define new global shared variable g#lib-trn2 as handle no-undo .
      111   define new global shared variable g#lib-trn3 as handle no-undo .
      112   define new global shared variable g#lib-trn4 as handle no-undo .
      113   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure doc-code:
      115   define input  parameter parmode          as   character           no-undo.
      116   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      117   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      118   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      119   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      120   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      121   define variable vardb-remote     as   logical             no-undo.
      122   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      123   define variable v-delimiter as character no-undo .
      124   do
      125   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      126   :
      127   find first buf_sys-ctrl no-lock .
      128   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      129     CASE parmode:
      130       when "main":u then do:
      131         if vardb-remote then do:
      132           assign
      133             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      134         end.
      135         else do:
      136           assign
      137             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      138         end.
      139       end.
      140       when "trio" then do:
      141         assign
      142           pardoc-code = replace (parroot-doc-code, "=", "*").
      143       end.
      144       otherwise do:
      145         assign
      146         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      147         no-error
      148         .
      149         if error-status:error  then do:
      150           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      151                                         ,chr(10)
      152                                         ,parmode
      153                                         ).
      154         end.
      155         if num-entries(parmode) = 1
      156         and parmode <> "chip":U
      157         and parmode <> "chip_s":U
      158         then do:
      159           assign
      160           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      161         end.
      162         else if (lookup("chip":U, parmode) > 0
      163                  or
      164                  lookup("chip_s":U, parmode) > 0) then do:
      165           assign
      166             vartemp-doc-code = parroot-doc-code.
      167           do while true:
      168             if index (vartemp-doc-code , ".") = 0 then
      169               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      170             else
      171               vartemp-doc-code  =
      172               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      173               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      174               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      175             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      176           end.
      177           assign
      178             pardoc-code = vartemp-doc-code.
      179         end.
      180       end.
      181     end CASE.
      182     if pardoc-code = '':U
      183     or (parroot-doc-code <> '':U
      184     and pardoc-code = parroot-doc-code) then do:
      185       undo, return error substitute("Ошибка при генерации номера документа&1"
      186                                     ,chr(10)).
      187     end.
      188   end.
      189   end. // procedure/method
      190   function get-doc-code-int64 returns int64
      191     ( input p-doc-code as character ) :
      192     define variable v-ind              as integer   no-undo .
      193     define variable v-num-entries      as integer   no-undo .
      194     define variable v-doc-code-int64   as int64     no-undo .
      195     define variable v-canonic-doc-code as character no-undo .
      196     assign
      197       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      198       v-canonic-doc-code = p-doc-code
      199     .
      200     do v-ind = 1 to v-num-entries
      201     :
      202       assign
      203         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      204       .
      205     end.
      206     assign
      207       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      208     .
      209     return v-doc-code-int64 .
      210   end. // function/method
      211   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   define variable v-waitfram-action01         as character   no-undo .
      213   define variable v-waitfram-action02         as character   no-undo .
      214   define variable v-waitfram-action03         as character   no-undo .
      215   define variable mWaitFramTextBeg            as character   no-undo.
      216   define variable mWaitFramTextEnd            as character   no-undo.
      217   define variable mWaitFramView               as logical     no-undo.
      218   define variable mWaitProcEvent              as logical     no-undo init yes.
      219   define variable mWaitFramInterval           as integer     no-undo init 1 .
      220   define variable mWaitFramStop               as logical     no-undo.
      221   define variable mWaitFramStopUser           as logical     no-undo.
      222   define variable mWaitFramStopTimeOut        as logical     no-undo.
      223   define variable mWaitFramStartProc          as datetime-tz no-undo.
      224   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      225   define button B-WaitFramStop auto-end-key
      226        label "Стоп"
      227        size 10 by 1 tooltip "Остоновить процесс".
      228   define button B-viewProcInfo
      229        label "Информация"
      230        size 15 by 1 tooltip "Информация о процесс".
      231   define frame waitfram
      232     v-waitfram-action01 format "x(72)" no-label skip
      233     v-waitfram-action02 format "x(72)" no-label skip
      234     v-waitfram-action03 format "x(72)" no-label skip
      235     B-viewProcInfo
      236     B-WaitFramStop at row 4 col 30
      237     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      238     .
      239   define new global shared variable mBatchMode as logical no-undo init ?.
      240   define variable mFramBachModHandle as handle no-undo.
      241   mFramBachModHandle = frame waitfram:handle.
      242   define variable mFameOldVis as logical no-undo.
      243   define variable mVisCUrentVin as logical no-undo.
      244   if session:batch-mode
      245   then
      246      mBatchMode = yes.
      247   if mBatchMode = ? then do:
      248     mVisCUrentVin = current-window:visible.
      249     mFameOldVis = mFramBachModHandle:visible.
      250     mFramBachModHandle:visible  = yes.
      251     mBatchMode = mFramBachModHandle:visible ne yes.
      252     mFramBachModHandle:visible = mFameOldVis.
      253     current-window:visible = mVisCUrentVin.
      254   end.
      255    if  log-manager:logfile-name ne ?
      256     then DO:
      257         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      258         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      259         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      260     end.
      261   on choose of B-WaitFramStop in frame waitfram
      262   do:
      263     mWaitFramStop = yes.
      264     mWaitFramStopUser = yes.
      265   end.
      266   function waitfram-check-timeout returns logical():
      267      define variable vtime as int64 no-undo.
      268      if mWaitFramStopTimeOut
      269      then
      270         return yes.
      271      vtime = ( now - mWaitFramStartProc ) / 1000 .
      272      if     mWaitFramTimeOut ne ?
      273         and mWaitFramTimeOut ne 0
      274         and mWaitFramTimeOut lt vtime
      275      then do:
      276         mWaitFramStopTimeOut = yes.
      277      end.
      278      return mWaitFramStopTimeOut.
      279   end.
      280   procedure waitfram-hide :
      281     if not session:batch-mode
      282     then do
      283     on error undo, return error return-value
      284     :
      285       pause 0 before-hide .
      286       if not mBatchMode then
      287         hide frame waitfram .
      288     end.
      289   end procedure.
      290   procedure waitfram-show :
      291     define input  parameter p-message as character no-undo .
      292     define variable v-left-margin as integer   no-undo .
      293     if not session:batch-mode
      294     then do
      295     on error undo, return error return-value
      296     :
      297       if length(p-message) <= 70 then do:
      298         assign
      299           v-left-margin = integer((70 - length(p-message)) / 2)
      300         .
      301         assign
      302           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      303         .
      304         assign
      305           v-waitfram-action01 = " "
      306           v-waitfram-action02 = " "
      307                                    + fill(" ", v-left-margin)
      308                                    + p-message
      309           v-waitfram-action03 = " "
      310         .
      311       end.
      312       else do:
      313         define variable vRindex1 as integer no-undo.
      314         define variable vRindex2 as integer no-undo.
      315         vRindex1 = r-index(p-message," ",70).
      316         if vRindex1 = 0
      317         then
      318            vRindex1 = 70.
      319         if length(p-message)  <= vRindex1 + 70 then do:
      320           assign
      321             v-waitfram-action01 = " "
      322             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      323             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      324           .
      325         end.
      326         else do:
      327           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      328           if vRindex2 <= vRindex1
      329           then
      330              vRindex2 = vRindex1 + 70.
      331           assign
      332             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      333             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      334             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      335           .
      336         end.
      337       end.
      338       B-viewProcInfo:visible   in frame waitfram = no.
      339       B-viewProcInfo:sensitive in frame waitfram = no.
      340       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      341       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      342       if  (   mWaitFramView
      343          or  mWaitProcEvent)
      344          and not mBatchMode
      345       then
      346          display
      347             v-waitfram-action01 skip
      348             v-waitfram-action02 skip
      349             v-waitfram-action03 skip
      350          with frame waitfram .
      351     end.
      352   end procedure.
      353      procedure waitfram-show-this:
      354         define input  parameter iInterval as int64 no-undo.
      355         define variable vtime as int64 no-undo.
      356         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      357         mWaitFramInterval = iInterval.
      358         run waitfram-show (substitute("&1&2 &3&4" ,
      359                                       mWaitFramTextBeg ,
      360                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      361                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      362                                       mWaitFramTextEnd
      363                                      )
      364                           ).
      365      end.
      366      procedure WaitFramRunPause:
      367         define input  parameter iInterval as dec no-undo.
      368         define variable vStart  as datetime-tz no-undo.
      369         define variable vend    as datetime-tz no-undo.
      370         define variable vint as int64 no-undo.
      371         define variable vOk as logical no-undo.
      372         vStart = now.
      373         vend   = vStart.
      374         publish "WaitFramPause" (iInterval,output vOk).
      375         vend   =  now.
      376         vint = vend - vStart.
      377         vint = iInterval - vint / 1000.
      378         if     not mWaitFramStop
      379            and (   vint > 0
      380                 or (    not vOk
      381                     and iInterval eq ?
      382                     )
      383                 )
      384         then
      385            run waitfram-show-this (iInterval).
      386         vend   =  now.
      387         vint = vend - vStart.
      388         vint = iInterval - vint / 1000.
      389         if     not mWaitFramStop
      390            and vint > 0
      391         then do:
      392            run gbl/pause.p (vint * 1000).
      393         end.
      394         if iInterval ne ?
      395         then
      396            publish "WaitFramStop".
      397         waitfram-check-timeout().
      398      end.
      399      procedure WaitFramWaitFor:
      400         define input  parameter iInterval as dec no-undo.
      401         assign
      402            mWaitFramStartProc   = now
      403            mWaitFramStopUser    = no
      404            mWaitFramStopTimeOut = no
      405         .
      406         block-wait:
      407         do while not mWaitFramStop:
      408            run WaitFramRunPause (iInterval).
      409            if  waitfram-check-timeout()
      410            then do:
      411               leave block-wait.
      412            end.
      413         end.
      414         run waitfram-hide.
      415      end.
      416   procedure waitfram-join :
      417     define input  parameter p-line-1  as character no-undo .
      418     define input  parameter p-line-2  as character no-undo .
      419     define input  parameter p-line-3  as character no-undo .
      420     define output parameter p-message as character no-undo .
      421     do
      422     on error undo, return error return-value
      423     :
      424       assign
      425         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      426                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      427                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      428       .
      429     end.
      430   end procedure.
      431   function waitfram-join-function returns character
      432     (input p-line-1 as character
      433     ,input p-line-2 as character
      434     ,input p-line-3 as character
      435     ).
      436     define variable v-message as character no-undo .
      437     run waitfram-join in this-procedure
      438       (input  p-line-1
      439       ,input  p-line-2
      440       ,input  p-line-3
      441       ,output v-message
      442       ) .
      443     return v-message .
      444   end function .
      445   define buffer t-doc        for ub.trn-doc.
      446   define buffer doc-line     for ub.doc-line.
      447   define buffer buf_bar-code for ub.bar-code  .
      448   define buffer buf_goods    for ub.goods  .
      449   define variable vartime    as integer no-undo.
      450   define variable varcount   as integer no-undo.
      451   define variable recid-line as recid   no-undo.
      452   define variable lns-cnt as integer no-undo .
      453   find first t-doc no-lock where recid(t-doc) = p-doc-rec no-error .
      454   if error-status :error then return error return-value .
      455   run waitfram-show in this-procedure ("Работа со списком в документе инвентаризации.") no-error.
      456   assign
      457     vartime = time.
      458   fill-list:
      459   do on error undo fill-list, return error return-value :
      460     assign
      461       varcount = 0.
      462     for each doc-line where doc-line.doc-code = t-doc.doc-code,
      463          first goods where goods.artic     = doc-line.artic
      464                           and goods.prod-type = doc-line.prod-type
      465                           and goods.prod-code = doc-line.prod-code no-lock  on error undo fill-list, return error return-value :
      466       assign
      467         varcount = varcount + 1.
      468       run waitfram-show in this-procedure (waitfram-join-function ("Работа со списком в документе инвентаризации.",
      469                                                                    "Запоминаем уже созданные строки.",
      470                                                                    substitute("Всего строк &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss"))
      471                                                                    )
      472                                            ) no-error.
      473   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   find gds-list
      475     where gds-list.prod-type = goods.prod-type
      476       and gds-list.prod-code = goods.prod-code
      477       and gds-list.artic     = goods.artic
      478     no-error .
      479   if available gds-list then do:
      480     assign
      481       gds-list.to-del = no
      482     .
      483   end.
      484   else do:
      485     define variable v-last4 as integer no-undo .
      486     find last gds-list use-index oi no-error.
      487     if available gds-list then do:
      488       v-last4 = gds-list.order-num .
      489     end.
      490     else do:
      491       v-last4 = 0 .
      492     end.
      493     create gds-list .
      494     buffer-copy goods to gds-list
      495     assign
      496       gds-list.to-del = no
      497       gds-list.order-num = v-last4 + 1
      498     .
      499     assign
      500       lns-cnt = lns-cnt + 1
      501       line-rec = recid (gds-list)
      502     .
      503   end.
      504       doc-line.prt-ok = yes.
      505     end.
      506     assign
      507       varcount = 0.
      508     for each gds-list where gds-list.to-del = yes on error undo fill-list, return error return-value :
      509       assign
      510         varcount = varcount + 1.
      511       run waitfram-show in this-procedure (waitfram-join-function ("Удаленние старого списка.",
      512                                                                    " ",
      513                                                                    substitute("Всего строк &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss"))
      514                                                                    )
      515                                           ) no-error.
      516       delete gds-list.
      517     end.
      518   end.
      519   if p-mode = true then do:
      520      run str/gds-list.w (parparentproc, t-doc.host-code, t-doc.obj-type, t-doc.obj-code).
      521   end.
      522   else do:
      523   define variable v-query-prepare as character no-undo .
      524   define variable v-handle-field as handle no-undo.
      525   define variable qh as handle no-undo.
      526   v-handle-field = p-handl-tt:buffer-field('b-c').
      527   v-query-prepare = "for each anlz-bc" .
      528   create query qh.
      529     qh:set-buffers(p-handl-tt).
      530     qh:query-prepare(v-query-prepare).
      531     qh:query-open.
      532     repeat :
      533       qh:get-next.
      534       if p-handl-tt:available then do:
      535          find first buf_bar-code no-lock where buf_bar-code.b-code = integer(v-handle-field:BUFFER-VALUE) no-error  .
      536          find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error .
      537          find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error .
      538          if not available gds-list then do:
      539             create gds-list.
      540             buffer-copy buf_goods to gds-list.
      541          end.
      542       end.
      543       else leave.
      544     end.
      545     delete widget qh.
      546   end.
      547   def var v-is-petrol as logical no-undo.
      548   def var v-is-pieces as logical no-undo.
      549   def var is-petrol as logical no-undo.
      550   fill-doc:
      551   do transaction on error undo fill-doc, return error return-value :
      552     assign
      553       varcount = 0.
      554     gds-lst_:
      555     for each gds-list,
      556          each goods where goods.prod-type = gds-list.prod-type
      557                          and goods.prod-code = gds-list.prod-code
      558                          and goods.artic     = gds-list.artic no-lock on error undo fill-doc, return error return-value :
      559       assign
      560         varcount = varcount + 1.
      561       run waitfram-show in this-procedure (waitfram-join-function ("Работа со списком в документе инвентаризации.", "Создание строк в документе.", substitute("Всего строк &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss")))) no-error.
      562   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      563     (
      564        input gds-list.artic
      565     ,  input gds-list.prod-type
      566     ,  input gds-list.prod-code
      567     , output v-is-petrol
      568     , output v-is-pieces
      569     ) no-error.
      570       if
      571         can-find (first ub.doc-line no-lock where
      572                    ub.doc-line.doc-code  = t-doc.doc-code)
      573       then do:
      574         if not (is-petrol = v-is-petrol)
      575         then do:
      576           run waitfram-hide in this-procedure.
      577           if is-petrol
      578           then do:
      579             message
      580               vss-workfile vss-revision vss-description skip
      581                 substitute("Ошибка при добавлении строки инвентаризации.") skip
      582                 substitute("Запрещено добавлять не топливный товар вместе с топливными.") skip
      583               return-value skip
      584               view-as alert-box error .
      585             undo gds-lst_, next gds-lst_.
      586           end.
      587           else do:
      588             message
      589               vss-workfile vss-revision vss-description skip
      590                 substitute("Ошибка при добавлении строки инвентаризации.") skip
      591                 substitute("Запрещено добавлять топливный товар вместе с не топливными.") skip
      592               return-value skip
      593               view-as alert-box error .
      594             undo gds-lst_, next gds-lst_.
      595           end.
      596         end.
      597       end.
      598       else is-petrol = v-is-petrol.
      599       gds-list.to-del = yes.
      600   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
      601   (input  parparentproc
      602   ,input  t-doc.doc-code
      603   ,input  goods.artic
      604   ,input  goods.prod-type
      605   ,input  goods.prod-code
      606   ,output recid-line
      607   ) no-error.
      608       if error-status:error then next.
      609       find first doc-line where recid(doc-line) = recid-line exclusive-lock.
      610       assign
      611         line-rec = recid-line.
      612       doc-line.prt-OK = ?.
      613     end.
      614     assign
      615       varcount = 0.
      616     for each doc-line where doc-line.doc-code = t-doc.doc-code
      617                            and doc-line.prt-ok   = yes            on error undo fill-doc, return error return-value :
      618       assign
      619         varcount = varcount + 1.
      620       run waitfram-show in this-procedure (waitfram-join-function ("Работа со списком в документе инвентаризации. ", "Удаление лишних записей.", substitute("Всего строк &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss")))) no-error.
      621       run del-line in this-procedure no-error.
      622       if error-status:error then do:
      623         return error return-value.
      624       end.
      625     end.
      626   end.
      627   procedure del-line :
      628     do on error undo, return error return-value
      629     :
      630       if not (t-doc.status_ = 'накл':U and
      631               t-doc.flag_   = no         ) then do:
      632         run trg/rsrv-del.p
      633           (input doc-line.doc-code
      634           ,input doc-line.artic
      635           ,input doc-line.prod-type
      636           ,input doc-line.prod-code
      637           ) no-error .
      638         if error-status :error then do:
      639           message
      640             "Ошибка при снятии резервов" skip
      641             "Документ" doc-line.doc-code skip
      642             "Артикул:" doc-line.artic doc-line.prod-type doc-line.prod-code skip
      643             return-value skip
      644             view-as alert-box error .
      645           undo, return error.
      646         end.
      647       end.
      648       delete doc-line.
      649     end.
      650   end procedure.
      651   run waitfram-hide in this-procedure no-error.
