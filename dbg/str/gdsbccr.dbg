        1   block-level on error undo, throw.
        2   define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
        3   define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
        4   define input parameter p-artic      like ub.gds-obj.artic     no-undo .
        5   define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
        6   define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
        7   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   def var vss-author      as character no-undo init "$Author: expertek $":U .
        9   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   def var vss-workfile    as character no-undo init "$Workfile: gdsbccr.p $":U .
       11   def var vss-archive     as character no-undo init "$Archive: str/gdsbccr.p $":U .
       12   def var vss-description as character no-undo init "Программа создания бар-кодов для всех партий свободной зоны товара".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define buffer buf_goods    for ub.goods .
       74   define buffer buf_parts    for ub.parts .
       75   define buffer buf_bar-code for ub.bar-code .
       76   main-block:
       77   do
       78   on error undo, return error
       79   :
       80     def var v-root-node    as integer no-undo .
       81     def var v-is-new       as logical no-undo .
       82     find first buf_goods no-lock
       83       where buf_goods.artic     = p-artic
       84         and buf_goods.prod-type = p-prod-type
       85         and buf_goods.prod-code = p-prod-code
       86       .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
       89     (input  p-artic
       90     ,input  p-prod-type
       91     ,input  p-prod-code
       92     ,output v-root-node
       93     )  .
       94     for each buf_parts no-lock
       95       where buf_parts.obj-type  = p-obj-type
       96         and buf_parts.obj-code  = p-obj-code
       97         and buf_parts.artic     = p-artic
       98         and buf_parts.prod-type = p-prod-type
       99         and buf_parts.prod-code = p-prod-code
      100         and buf_parts.out-code  = 'free-zone':U
      101     on error undo main-block, return error
      102     :
      103   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
      105     (input  buf_goods.gds-code
      106     ,input  v-root-node
      107     ,input  buf_parts.part-code
      108     ,input  buf_parts.in-code
      109     ,input  buf_goods.unit-base
      110     ,input  ?
      111     ,output v-is-new
      112     ,buffer buf_bar-code
      113     )  .
      114     end.
      115   end.
