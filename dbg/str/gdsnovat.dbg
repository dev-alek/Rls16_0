     2266     else do:
     2267       find first in-vatp_doc-attroprl no-lock
     2268         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
     2269           and in-vatp_doc-attroprl.attr-code = 'envd':U
     2270         no-error .
