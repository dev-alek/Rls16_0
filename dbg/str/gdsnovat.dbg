     2452   define variable v-all-total-road-tax-rubl as decimal no-undo .
     2453   assign
     2454     p-road-tax-base = ?
     2455     p-road-tax-rubl = ?
     2456     .
     2457     Find first buff-goods no-lock where
     2458           buff-goods.artic     = p-artic and
