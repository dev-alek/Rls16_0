     1702          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     1703          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale) * b-dl.vat-pc / (100 + b-dl.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     1704          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * b-dl.cons-vat-pc / (100 + b-dl.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale) * b-dl.vat-pc / (100 + b-dl.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1705          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     1706          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     1707          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1708          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale) * b-dl.vat-pc / (100 + b-dl.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1709          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * b-dl.cons-vat-pc / (100 + b-dl.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * b-dl.SLT-pc / (100 + b-dl.SLT-pc) - road-tax-rubl-sale) * b-dl.vat-pc / (100 + b-dl.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1710          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     1711       end.
     1712       if b-td.doc-type = 'инв':U then do:
     1713         ASSIGN
     1714                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     1715           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1716           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1717           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1718           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1719                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1720           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     1721           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     1722           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     1723           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     1724       end.
     1725       else do:
     1726         ASSIGN
     1727                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     1728           slt-base-sale               = varslt-base-factovp / varfact-qnty
     1729           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     1730           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     1731           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     1732                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     1733           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     1734           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     1735           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     1736           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     1737       end.
     1738     end.
     1739   end.
     1740   assign
     1741     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1742     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1743             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     1744             assign
     1745                 p-road-tax-base =  road-tax-base-sale
     1746                 p-road-tax-rubl =  road-tax-rubl-sale
     1747                 .
     1748             Assign
     1749                 p-calc-base   =  price-base-without-tax-sale
     1750                 p-calc-rubl   =  price-rubl-without-tax-sale
     1751                 p-price-base  =   price-base-without-tax-sale
     1752                       * (1 + v-bonus / 100)
     1753                       * (1 + p-disc / 100 )
     1754                       * (1 + (v-vat-pc / 100))
     1755                       * (1 + (v-slt-pc / 100))
     1756                       + p-road-tax-base
     1757                 p-price-rubl  = price-rubl-without-tax-sale
     1758                       * (1 + v-bonus / 100)
     1759                       * (1 + p-disc / 100 )
     1760                       * (1 + (v-vat-pc / 100))
     1761                       * (1 + (v-slt-pc / 100))
     1762                       + p-road-tax-rubl
     1763                 .
     1764            end.
     1765            else do:
     1766             Assign
     1767                 p-calc-base   =  p-base-novat
     1768                 p-calc-rubl   =  p-rubl-novat
     1769                 p-price-base  =   p-base-novat
     1770                       * (1 + v-bonus / 100)
     1771                       * (1 + p-disc / 100 )
     1772                       * (1 + (v-vat-pc / 100))
     1773                       * (1 + (v-slt-pc / 100))
     1774                 p-price-rubl  = p-rubl-novat
     1775                       * (1 + v-bonus / 100)
     1776                       * (1 + p-disc / 100 )
     1777                       * (1 + (v-vat-pc / 100))
     1778                       * (1 + (v-slt-pc / 100))
     1779                 .
     1780            end.
     1781     End.
     1782   when 'НсП':U then do:
     1783        find first buf_gds-obj no-lock
     1784           where buf_gds-obj.obj-type  = p-obj-type
     1785             and buf_gds-obj.obj-code  = p-obj-code
     1786             and buf_gds-obj.artic     = p-artic
     1787             and buf_gds-obj.prod-type = p-prod-type
     1788             and buf_gds-obj.prod-code = p-prod-code
     1789           no-error .
     1790         if available buf_gds-obj then do:
     1791           assign
     1792             p-calc-rubl   = buf_gds-obj.last-rubl
     1793             p-calc-base   = buf_gds-obj.last-base
     1794             p-price-base  = buf_gds-obj.last-base * (1 + v-slt-pc    / 100 )
     1795             p-price-rubl  = buf_gds-obj.last-rubl * (1 + v-slt-pc    / 100 )
     1796           .
     1797         end.
     1798         else do:
     1799           p-price-base  =  ? .
     1800           p-price-rubl  =  ? .
     1801               if v-cur-dn = ? then do:
     1802                 message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     1803                         "- расчет от старой цены продажи невозможен."
     1804                         view-as alert-box question buttons OK-Cancel update v-log.
     1805                         return error .
     1806                         end.
     1807               else do :
     1808                 find first buff-price-list-a where
     1809                           buff-price-list-a.doc-num = v-cur-dn and
     1810                           buff-price-list-a.b-code = v-bar-code    no-lock no-error .
     1811                 if not avail buff-price-list-a    Then
     1812                    assign
     1813                     parrecid   = ?
     1814                     price-base-with-tax-saleprl = ?
     1815                     price-rubl-with-tax-saleprl = ?
     1816                    .
     1817                 else  DO :
     1818                     parrecid = recid(buff-price-list-a) .
     1819                     run prl-vat in this-procedure ( input   parrecid               ,
     1820                     output  price-rubl-with-tax-saleprl    ,
     1821                     output  price-base-with-tax-saleprl    ,
     1822                     output  price-rubl-without-tax-saleprl ,
     1823                     output  price-base-without-tax-saleprl ,
     1824                     output  vat-base-saleprl               ,
     1825                     output  vat-rubl-saleprl               ,
     1826                     output  vat-base-buyerprl              ,
     1827                     output  vat-rubl-buyerprl              ,
     1828                     output  slt-base-saleprl               ,
     1829                     output  slt-rubl-saleprl               ,
     1830                     output  road-tax-base-saleprl          ,
     1831                     output  road-tax-rubl-saleprl          ,
     1832                     output  excise-base-saleprl            ,
     1833                     output  excise-rubl-saleprl            ,
     1834                     output  discnt-base-saleprl            ,
     1835                     output  discnt-rubl-saleprl             ) no-error .
     1836                     End.
     1837               end.
     1838           assign
     1839             p-calc-base   = price-base-with-tax-saleprl
     1840             p-price-base  = price-base-with-tax-saleprl * (1 + v-slt-pc    / 100 )
     1841             p-calc-rubl   = price-rubl-with-tax-saleprl
     1842             p-price-rubl  = price-rubl-with-tax-saleprl * (1 + v-slt-pc    / 100 )
     1843           .
     1844         end.
     1845   end.
     1846   when 'Стар-безНДС':U  then do:
     1847         if v-cur-dn = ? then do:
     1848           message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     1849                   "- расчет от старой цены продажи невозможен."
     1850                   view-as alert-box question buttons OK-Cancel update v-log.
     1851                   return error .
     1852                   end.
     1853         else do :
     1854           find first buff-price-list-a where
     1855                      buff-price-list-a.doc-num = v-cur-dn and
     1856                      buff-price-list-a.b-code = v-bar-code
     1857                      no-lock no-error .
     1858           l-vat = buff-price-list-a.vat-pc.
     1859           l-slt = buff-price-list-a.slt-pc.
     1860           if not avail buff-price-list-a
     1861               Then  parrecid = ?.
     1862               Else  DO :
     1863               parrecid = recid(buff-price-list-a) .
     1864               run prl-vat in this-procedure ( input   parrecid               ,
     1865               output  price-rubl-with-tax-saleprl    ,
     1866               output  price-base-with-tax-saleprl    ,
     1867               output  price-rubl-without-tax-saleprl ,
     1868               output  price-base-without-tax-saleprl ,
     1869               output  vat-base-saleprl               ,
     1870               output  vat-rubl-saleprl               ,
     1871               output  vat-base-buyerprl              ,
     1872               output  vat-rubl-buyerprl              ,
     1873               output  slt-base-saleprl               ,
     1874               output  slt-rubl-saleprl               ,
     1875               output  road-tax-base-saleprl          ,
     1876               output  road-tax-rubl-saleprl          ,
     1877               output  excise-base-saleprl            ,
     1878               output  excise-rubl-saleprl            ,
     1879               output  discnt-base-saleprl            ,
     1880               output  discnt-rubl-saleprl             ) no-error .
     1881               End.
     1882             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     1883             assign
     1884                 p-road-tax-base =  road-tax-base-saleprl
     1885                 p-road-tax-rubl =  road-tax-rubl-saleprl
     1886                 .
     1887             Assign
     1888                 p-calc-rubl   =  if var-pr-r-b = "rubl"  then  v-cur-pr else 0
     1889                 p-calc-base   =  if var-pr-r-b = "base" then   v-cur-pr else 0
     1890                 p-price-base  =  ( price-base-with-tax-saleprl
     1891                       - road-tax-base-saleprl)
     1892                       / (1 + (l-slt / 100))
     1893                       / (1 + (l-vat / 100))
     1894                       * (1 + v-bonus / 100)
     1895                       * (1 + p-disc    / 100 )
     1896                       * (1 + (v-vat-pc / 100))
     1897                       * (1 + (v-slt-pc / 100))
     1898                       + p-road-tax-base
     1899                 p-price-rubl  =   (price-rubl-with-tax-saleprl
     1900                       - road-tax-rubl-saleprl)
     1901                       / (1 + (l-slt / 100))
     1902                       / (1 + (l-vat / 100))
     1903                       * (1 + v-bonus / 100)
     1904                       * (1 + p-disc    / 100 )
     1905                       * (1 + (v-vat-pc / 100))
     1906                       * (1 + (v-slt-pc / 100))
     1907                       + p-road-tax-rubl
     1908                 .
     1909     end.
     1910   end.
     1911   end case.
     1912   if var-pr-r-b = "rubl" then
     1913   run compare_road-tax in this-procedure (input-output p-road-tax-rubl,  input v-bar-code, input  p-obj-type,  input p-obj-code,  input yes ).
     1914   else
     1915   run compare_road-tax in this-procedure (input-output p-road-tax-base,  input v-bar-code, input  p-obj-type,  input p-obj-code,  input yes ).
     1916   if p-price-base = 0 then do:
     1917     assign
     1918       p-price-base = ?
     1919     .
     1920   end.
     1921   if p-price-rubl = 0 then do:
     1922     assign
     1923       p-price-rubl = ?
     1924     .
     1925   end.
     1926   if (p-price-base = ?) <> (p-price-rubl = ?) then do:
     1927     message
     1928       vss-workfile vss-revision vss-description skip
     1929       "Цена в одной из валют не задана" skip
     1930       "p-price-base" p-price-base skip
     1931       "p-price-rubl" p-price-rubl skip
     1932       view-as alert-box error .
     1933     undo, return error .
     1934   end.
     1935   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1936   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   procedure prl-vat:
     1938     define input parameter parrecid as recid no-undo.
     1939       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     1940       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     1941       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     1942       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     1943       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     1944       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     1945       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     1946       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     1947       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     1948       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     1949       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     1950       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     1951       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     1952       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     1953       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     1954       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     1955       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     1956       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     1957       define buffer out-vatp_partsprl       for ub.parts.
     1958       define buffer out-vatp_sysconfprl     for ub.sysconf.
     1959       define buffer out-vatp_doc-lineprl    for ub.doc-line.
     1960       define buffer out-vatp_goodsprl       for ub.goods.
     1961       define buffer out-vatp_trn-docprl     for ub.trn-doc.
     1962       define buffer out-vatp_doc-attrprl    for ub.doc-attr.
     1963       define variable varprice-base-consprl      like ub.doc-line.price-base initial 0.00 no-undo.
     1964       define variable varprice-rubl-consprl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     1965       define variable varfrm-cnsv-typeprl         as   character                           no-undo.
     1966       define variable varfrm-cnsvprl              as   character                           no-undo.
     1967       define variable varroot-nodeprl             as   integer                             no-undo.
     1968       define variable varempty-scaleprl           as   logical                             no-undo.
     1969       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     1970       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1971       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1972       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1973       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     1974       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1975       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1976       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1977       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1978       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     1979       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1980       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1981       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1982       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1983       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     1984       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     1985       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1986       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1987       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1988       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     1989       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     1990       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1991       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     1992       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     1993       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1994       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1995       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1996       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1997       define variable varoutvprbprl               as   character                           no-undo.
     1998       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     1999       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     2000       define buffer   in-vatp-partsoprl    for ub.parts   .
     2001       define buffer   in-vatp-docoprl      for ub.trn-doc .
     2002       define buffer   in-vatp-goodsoprl    for ub.goods   .
     2003       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     2004       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     2005       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     2006       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
