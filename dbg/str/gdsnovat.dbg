     2464              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2465   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2466     (
     2467        input p-artic
     2468     ,  input p-prod-type
     2469     ,  input p-prod-code
     2470     , output is-petrolium
     2471     , output is-pieces
     2472     ) .
     2473              t-ret =  session:set-wait-state("") .
     2474              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     2475                   assign
     2476                     p-road-tax-base = ?
     2477                     p-road-tax-rubl = ?
     2478                     .
     2479                   return.
     2480              end.
     2481         end.
     2482         assign
     2483             v-total-avrg-qnty = 0
     2484             v-total-road-tax-base =  0
     2485             v-total-road-tax-rubl =  0
     2486             v-all-total-road-tax-base =  0
     2487             v-all-total-road-tax-rubl =  0
     2488             .
     2489         for each buf_parts no-lock
