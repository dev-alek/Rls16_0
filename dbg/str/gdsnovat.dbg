     2203     (output varoutvprbprl
     2204     )  .
     2205   if varoutvprbprl = "base":u then do:
     2206     assign
     2207           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     2208       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     2209     .
     2210   end.
     2211   else do:
     2212     assign
     2213           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     2214       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     2215     .
     2216   end.
     2217   if varoutvprbprl = "rubl":u then do:
     2218     assign
     2219           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
