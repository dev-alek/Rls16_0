     1373                     p-road-tax-rubl =  road-tax-rubl-loc
     1374                 .
     1375             assign
     1376                 p-calc-base   =  price-base-with-tax-loc
     1377                 p-calc-rubl   =  price-rubl-with-tax-loc
     1378                 p-price-base  =   (price-base-with-tax-loc -
     1379                                   vat-base-loc -
     1380                                   road-tax-base-loc )
     1381                                   * (1 + v-bonus / 100)
     1382                                   * (1 + p-disc / 100 )
     1383                                   * (1 + (v-vat-pc / 100))
     1384                                   * (1 + (v-slt-pc / 100))
     1385                                   + p-road-tax-base
     1386                 p-price-rubl  = (price-rubl-with-tax-loc -
     1387                                   vat-rubl-loc -
     1388                                   road-tax-rubl-loc )
     1389                                   * (1 + v-bonus / 100)
     1390                                   * (1 + p-disc / 100 )
     1391                                   * (1 + (v-vat-pc / 100))
     1392                                   * (1 + (v-slt-pc / 100))
     1393                                   + p-road-tax-rubl
     1394                 .
     1395         end.
     1396         else do:
     1397             assign
     1398                 p-calc-base   =  p-base-novat
     1399                 p-calc-rubl   =  p-rubl-novat
     1400                 p-price-base  =  p-base-novat
     1401                                   * (1 + v-bonus / 100)
     1402                                   * (1 +  p-disc / 100 )
     1403                                   * (1 + (v-vat-pc / 100))
     1404                                   * (1 + (v-slt-pc / 100))
     1405                 p-price-rubl  = p-rubl-novat
     1406                                   * (1 + v-bonus / 100)
     1407                                   * (1 + p-disc / 100 )
     1408                                   * (1 + (v-vat-pc / 100))
     1409                                   * (1 + (v-slt-pc / 100))
     1410                 .
     1411         end.
     1412     End.
     1413     when 'Накл-безНДС':U + "Other":U then DO:
     1414             find b-td where b-td.doc-code  = p-doc-num no-lock no-error .
     1415             find b-dl where     b-dl.doc-code = p-doc-num
     1416                             and b-dl.artic     = p-artic
     1417                             and b-dl.prod-type = p-prod-type
     1418                             and b-dl.prod-code = p-prod-code no-lock no-error.
     1419             if available b-dl then do:
     1420   if b-td.ext-doc-type = 'ot':U or
     1421      b-td.ext-doc-type = ?                 then do:
     1422     assign
     1423      out-vatp-have-vat-slt = yes.
     1424   end.
     1425   else do:
     1426     find first out-vatp_doc-attr no-lock
     1427       where out-vatp_doc-attr.doc-code  = b-td.doc-code
     1428         and out-vatp_doc-attr.attr-code = 'envd':U
     1429         no-error .
     1430     if not available out-vatp_doc-attr then do:
     1431       assign
     1432         out-vatp-have-vat-slt = yes.
     1433     end.
     1434     else do:
     1435        out-vatp-have-vat-slt = no.
     1436     end.
     1437   end.
     1438   find first out-vatp_goods where out-vatp_goods.artic     = b-dl.artic     and
     1439                                      out-vatp_goods.prod-type = b-dl.prod-type and
     1440                                      out-vatp_goods.prod-code = b-dl.prod-code no-lock.
     1441   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1443     (input  b-dl.artic
     1444     ,input  b-dl.prod-type
     1445     ,input  b-dl.prod-code
     1446     ,output varroot-node
     1447     ) no-error .
     1448   if error-status :error then do:
     1449     message
     1450       vss-workfile vss-revision vss-description skip
     1451       "Ошибка при определении корневого признака товара" skip
     1452       "Артикул" b-dl.artic b-dl.prod-type b-dl.prod-code skip
     1453       error-status :get-message(1) skip
     1454       return-value skip
     1455       view-as alert-box error .
     1456     undo, return error .
     1457   end.
     1458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1459     (input  varroot-node
     1460     ,input  'empty-scale=request'
     1461     ,output varempty-scale
     1462     ) no-error .
     1463   if error-status :error then do:
     1464     message
     1465       vss-workfile vss-revision vss-description skip
     1466       "Ошибка при определении атрибута признака" skip
     1467       "Артикул" b-dl.artic b-dl.prod-type b-dl.prod-code skip
     1468       "Признак" varroot-node skip
     1469       "Запрашивался атрибут" "empty-scale=request" skip
     1470       error-status :get-message(1) skip
     1471       return-value skip
     1472       view-as alert-box error .
     1473     undo, return error .
     1474   end.
     1475   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1477     (output varoutvprb
     1478     )  .
     1479   if varoutvprb = "base":u then do:
     1480     assign
     1481           road-tax-base-sale    =  (if b-dl.road-tax = ? then 0 else b-dl.road-tax * 1)
     1482       excise-base-sale      =  (if b-dl.excise   = ? then 0 else b-dl.excise   * 1)
     1483     .
     1484   end.
     1485   else do:
     1486     assign
     1487           road-tax-base-sale    =  (if b-dl.road-tax = ? then 0 else b-dl.road-tax / b-td.base-rate * b-td.base-scale)
     1488       excise-base-sale      =  (if b-dl.excise   = ? then 0 else b-dl.excise   / b-td.base-rate * b-td.base-scale)
     1489     .
