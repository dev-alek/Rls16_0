      224   function cross-list returns logical (
      225     input parfirst-stream  as character,
      226     input parsecond-stream as character,
      227     input pardelim         as character).
      228     if pardelim = ""
      229     or pardelim = ?
      230     then do:
      231       assign
      232         pardelim = ","
      233       .
      234     end.
      235     define variable vari            as integer no-undo .
      236     define variable varresult-cross as logical no-undo .
      237     assign
      238       varresult-cross = no
      239     .
      240     def var v-num-parfirst-stream as integer no-undo .
      241     assign
      242       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      243     .
      244     do vari = 1 to v-num-parfirst-stream
      245     :
      246       if lookup(entry(vari, parfirst-stream, pardelim)
      247                ,parsecond-stream
      248                ,pardelim
      249                ) > 0 then do:
      250         assign
      251           varresult-cross = yes
      252         .
      253         leave.
      254       end.
      255     end.
      256     return varresult-cross .
      257   end function.
