     2524       else do:
     2525            in-vatp-have-vat-slt = no.
     2526       end.
     2527     end.
     2528     assign
     2529      price-cli-with-tax-loc = buf_parts.price-cli
     2530      cli-base-rate          = buf_parts.cli-base-rate.
     2531     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2532              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2533     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2534             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2535             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2536             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2537             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2538             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2539             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2540       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2541     assign
     2542       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2543     assign
     2544       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2545       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2546       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2547       transport-cli-loc  = 0
     2548       other-cli-loc      = 0
     2549     .
     2550   ASSIGN
     2551             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2552       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2553   .
     2554           assign
     2555             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     2556             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     2557            .
     2558         end.
     2559             if v-total-avrg-qnty > 0 then  do :
     2560                 assign
     2561                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     2562                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     2563                     .
     2564              end.
     2565               if v-total-avrg-qnty <= 0 then do :
     2566                 find first buf_gds-obj no-lock
     2567                   where buf_gds-obj.obj-type  = p-obj-type
     2568                     and buf_gds-obj.obj-code  = p-obj-code
     2569                     and buf_gds-obj.artic     = p-artic
     2570                     and buf_gds-obj.prod-type = p-prod-type
     2571                     and buf_gds-obj.prod-code = p-prod-code
     2572                   no-error .
     2573                       if available buf_gds-obj then do :
     2574                         if buf_gds-obj.in-code <> "" then
     2575                              v-doc-code = buf_gds-obj.in-code.
     2576                         else do:
     2577                           if available ub.price-doc then  v-doc-code = ub.price-doc.out-code.
     2578                         end.
     2579   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     2581     (input  v-doc-code
     2582     ,output is-hold-td
     2583     )  .
     2584                         if is-hold-td = true then do:
     2585                           assign
     2586                               p-road-tax-rubl = 0
     2587                               p-road-tax-base = 0
     2588                               .
     2589                         end.
     2590                         else do:
     2591                             find b-td_trn-doc  where b-td_trn-doc.doc-code   = v-doc-code no-lock no-error .
     2592                             find b-dl_doc-line where b-dl_doc-line.doc-code  = b-td_trn-doc.doc-code
     2593                                             and b-dl_doc-line.artic     = p-artic
     2594                                             and b-dl_doc-line.prod-type = p-prod-type
     2595                                             and b-dl_doc-line.prod-code = p-prod-code no-lock no-error.
     2596                                   if available b-dl_doc-line then do :
     2597   assign
     2598     price-rubl-with-tax-loc = b-dl_doc-line.price-rubl
     2599     price-base-with-tax-loc = b-dl_doc-line.price-base
     2600   .
     2601   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2603     (output varinvprb
     2604     )  .
     2605      find first in-vatp_doc-attr no-lock
     2606       where in-vatp_doc-attr.doc-code  = b-td_trn-doc.doc-code
     2607         and in-vatp_doc-attr.attr-code = 'envd':U
     2608       no-error .
     2609       if available in-vatp_doc-attr
     2610          then do:
     2611          assign
     2612            in-vatp-have-vat-slt = no.
     2613      end.
     2614      else do:
     2615        assign
     2616          in-vatp-have-vat-slt = yes.
     2617      end.
     2618      find first in-vatp-goods where in-vatp-goods.artic     = b-dl_doc-line.artic     and
     2619                                        in-vatp-goods.prod-type = b-dl_doc-line.prod-type and
     2620                                        in-vatp-goods.prod-code = b-dl_doc-line.prod-code no-lock.
     2621      if (not b-td_trn-doc.internal and
     2622              b-td_trn-doc.doc-type = 'при':U) or
     2623         in-vatp-goods.gds-type = 'у':U then do:
     2624         if varinvprb = "base":u then do:
     2625           assign
     2626             road-tax-base-loc = b-dl_doc-line.road-tax
     2627             road-tax-rubl-loc = b-dl_doc-line.road-tax * b-td_trn-doc.base-rate / b-td_trn-doc.base-scale.
     2628         end.
     2629         else do:
     2630           ASSIGN
     2631             road-tax-rubl-loc = b-dl_doc-line.road-tax
     2632             road-tax-base-loc = b-dl_doc-line.road-tax / b-td_trn-doc.base-rate * b-td_trn-doc.base-scale.
     2633         end.
     2634         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2635         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2636         assign
     2637           road-tax-cli-loc = ?.
     2638         ASSIGN
     2639           transport-base-loc = (if b-dl_doc-line.transport-base = ? then 0 else b-dl_doc-line.transport-base)
     2640           transport-rubl-loc = (if b-dl_doc-line.transport-rubl = ? then 0 else b-dl_doc-line.transport-rubl)
     2641           transport-cli-loc  = 0
     2642           other-base-loc     = (if b-dl_doc-line.other-base     = ? then 0 else b-dl_doc-line.other-base)
     2643           other-rubl-loc     = (if b-dl_doc-line.other-rubl     = ? then 0 else b-dl_doc-line.other-rubl)
     2644           other-cli-loc      = 0
     2645           vat-pc-loc         = (if b-dl_doc-line.vat-pc         = ? then 0 else b-dl_doc-line.vat-pc)
     2646           slt-pc-loc         = (if b-dl_doc-line.slt-pc         = ? then 0 else b-dl_doc-line.slt-pc).
     2647                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2648               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2649         assign
     2650           vat-cli-loc            = ?
     2651           slt-cli-loc            = ?
     2652           price-cli-with-tax-loc = ?.
     2653      end.
     2654      else do:
     2655                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b-dl_doc-line.doc-code  and
     2656                                         in-vatp-parts.obj-type  = b-dl_doc-line.obj-type  and
     2657                                         in-vatp-parts.obj-code  = b-dl_doc-line.obj-code  and
     2658                                         in-vatp-parts.artic     = b-dl_doc-line.artic     and
     2659                                         in-vatp-parts.prod-type = b-dl_doc-line.prod-type and
     2660                                         in-vatp-parts.prod-code = b-dl_doc-line.prod-code
     2661                            use-index out-code no-lock:
     2662             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     2663                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     2664                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     2665                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     2666                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     2667                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     2668                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2669                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2670                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2671                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2672                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2673                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2674                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2675                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2676                         .
     2677         end.
     2678         ASSIGN
     2679           road-tax-base-loc   = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2680           road-tax-rubl-loc   = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2681           transport-base-loc  = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2682           transport-rubl-loc  = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2683           other-base-loc      = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2684           other-rubl-loc      = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     2685                                           vat-base-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-dl_doc-line.fact-qnty   else 0
     2686           slt-base-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-dl_doc-line.fact-qnty   else 0
     2687                   vat-rubl-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-dl_doc-line.fact-qnty   else 0
     2688           slt-rubl-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-dl_doc-line.fact-qnty   else 0
     2689           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     2690           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     2691         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     2692         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     2693         if transport-base-loc = ? then transport-base-loc = 0.
     2694         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     2695         if other-base-loc     = ? then other-base-loc     = 0.
     2696         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2697         assign
     2698           transport-cli-loc      = 0
     2699           other-cli-loc          = 0
     2700           road-tax-cli-loc       = ?
     2701           vat-cli-loc            = ?
     2702           slt-cli-loc            = ?
     2703           price-cli-with-tax-loc = ?.
     2704      end.
     2705   ASSIGN
     2706             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2707       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2708   .
     2709                                       assign
     2710                                           p-road-tax-rubl =  road-tax-rubl-loc
     2711                                           p-road-tax-base =  road-tax-base-loc
     2712                                           .
     2713                                   end.
     2714                         end.
     2715                        end.
     2716               end.
     2717   end procedure.
