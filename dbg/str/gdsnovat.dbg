     2493             and buf_parts.prod-type = p-prod-type
     2494             and buf_parts.prod-code = p-prod-code
     2495             and buf_parts.status_   = no
     2496             and buf_parts.out-code  = 'free-zone':U
     2497             and buf_parts.qnty      > 0
     2498         on error undo, return error
     2499         :
     2500            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     2501   assign
     2502     price-rubl-with-tax-loc = buf_parts.price-rubl
     2503     price-base-with-tax-loc = buf_parts.price-base
     2504   .
     2505   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2507     (output varinvprb
     2508     )  .
     2509     if buf_parts.out-code = 'free-zone':U     or
     2510        buf_parts.out-code = 'out-zone':U   or
     2511        buf_parts.doc-type = 'акт':U then do:
     2512       assign
     2513         in-vatp-have-vat-slt = yes.
     2514     end.
     2515     else do:
     2516       find first in-vatp_doc-attr no-lock
     2517         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     2518           and in-vatp_doc-attr.attr-code = 'envd':U
     2519         no-error .
     2520       if not available in-vatp_doc-attr then do:
