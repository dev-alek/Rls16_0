      848     ,output v-cur-ex
      849     )  .
      850   run main-road-tax in this-procedure
      851     ( input p-obj-type,
      852       input p-obj-code,
      853       input p-artic   ,
      854       input p-prod-type,
      855       input p-prod-code,
      856       input-output p-road-tax-base,
      857       input-output p-road-tax-rubl
      858       ) .
      859   case p-price-type :
      860     when 'Откат_цен':U then do:
      861       if v-cur-pr = ? then do:
      862         message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
      863                 "- откат цены невозможен."
      864                 view-as alert-box .
      865         return error .
      866       end.
      867       else do:
      868       v-cur-pr2 = ?.
      869       find first buf_last_last-price-doc no-lock where
      870                  buf_last_last-price-doc.doc-num = v-cur-dn no-error .
      871       if available buf_last_last-price-doc then do:
      872   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      874     (input  p-obj-type
      875     ,input  p-obj-code
      876     ,input  v-bar-code
      877     ,input  0
      878     ,input  buf_last_last-price-doc.fact-order
      879     ,output v-cur-dn2
      880     ,output v-cur-pr2
      881     ,output v-cur-rt2
      882     ,output v-cur-ex2
      883     )  .
      884       end.
      885       if v-cur-pr2 = ? then do:
      886         message "Нет предпоследнего Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
      887                 "- откат цены невозможен."
      888                 view-as alert-box.
      889                 return error .
      890         end.
      891         else do:
      892           if var-pr-r-b = "rubl"  then
      893           assign
      894             p-calc-base     =   v-cur-pr  / v-base-rate * v-base-scale
      895             p-calc-rubl     =   v-cur-pr
      896             p-price-base    =   v-cur-pr2 / v-base-rate * v-base-scale
      897             p-price-rubl    =   v-cur-pr2
      898             p-road-tax-base =   v-cur-rt2 / v-base-rate * v-base-scale
      899             p-road-tax-rubl =   v-cur-rt2
      900             .
      901           if var-pr-r-b = "base"  then
      902           assign
      903             p-calc-rubl     =   v-cur-pr  * v-base-rate / v-base-scale
      904             p-calc-base     =   v-cur-pr
      905             p-price-rubl    =   v-cur-pr2 * v-base-rate / v-base-scale
      906             p-price-base    =   v-cur-pr2
      907             p-road-tax-rubl =   v-cur-rt2 * v-base-rate / v-base-scale
      908             p-road-tax-base =   v-cur-rt2
      909             .
      910         end.
      911       end.
      912     end.
      913     when 'Учет+накл':U  then do:
      914       if buf_goods.gds-type = 'т':U then do:
      915         for each buf_parts no-lock
      916           where  buf_parts.obj-type  = p-obj-type
      917             and buf_parts.obj-code  = p-obj-code
      918             and buf_parts.artic     = p-artic
      919             and buf_parts.prod-type = p-prod-type
      920             and buf_parts.prod-code = p-prod-code
      921             and buf_parts.status_   = no
      922             and ( buf_parts.out-code  = 'free-zone':U
      923                 or buf_parts.out-code  = p-doc-num  )
      924         on error undo, return error
      925         :
      926           assign
      927             v-total-avrg-base = v-total-avrg-base
      928                               + (buf_parts.price-base * buf_parts.qnty)
      929             v-total-avrg-rubl = v-total-avrg-rubl
      930                               + (buf_parts.price-rubl * buf_parts.qnty)
      931             v-total-avrg-qnty = v-total-avrg-qnty
      932                               + buf_parts.qnty
      933           .
      934         end.
      935         if v-total-avrg-qnty > 0 then do:
      936           assign
      937             p-price-base = ( v-total-avrg-base / v-total-avrg-qnty ) * (1 + v-bonus / 100) * (1 + p-disc / 100)
      938             p-price-rubl = ( v-total-avrg-rubl / v-total-avrg-qnty ) * (1 + v-bonus / 100) * (1 + p-disc / 100)
      939           .
      940         end.
      941         else do:
      942           find first buf_gds-obj no-lock
      943             where buf_gds-obj.obj-type  = p-obj-type
      944               and buf_gds-obj.obj-code  = p-obj-code
      945               and buf_gds-obj.artic     = p-artic
      946               and buf_gds-obj.prod-type = p-prod-type
      947               and buf_gds-obj.prod-code = p-prod-code
      948             no-error .
      949           if available buf_gds-obj then do:
      950             assign
      951               p-price-base = ( buf_gds-obj.last-base ) * (1 + v-bonus / 100)  * (1 + p-disc / 100)
      952               p-price-rubl = ( buf_gds-obj.last-rubl ) * (1 + v-bonus / 100)  * (1 + p-disc / 100)
      953             .
      954           end.
      955         end.
      956       end.
      957       else do:
      958         find first buf_gds-obj no-lock
      959           where buf_gds-obj.obj-type  = p-obj-type
      960             and buf_gds-obj.obj-code  = p-obj-code
      961             and buf_gds-obj.artic     = p-artic
      962             and buf_gds-obj.prod-type = p-prod-type
      963             and buf_gds-obj.prod-code = p-prod-code
      964           no-error .
      965         if available buf_gds-obj then do:
      966           assign
      967             p-price-base = ( buf_gds-obj.price-base ) * (1 + v-bonus / 100) * (1 + p-disc / 100)
      968             p-price-rubl = ( buf_gds-obj.price-rubl ) * (1 + v-bonus / 100) * (1 + p-disc / 100)
      969           .
      970         end.
      971         else do:
      972           assign
      973             p-price-base = ?
      974             p-price-rubl = ?
      975           .
      976         end.
      977       end.
      978     end.
      979     when 'Уч+накл-НДС':U  or
      980     when 'Учет-безНДС':U then do:
      981        assign
      982             v-total-avrg-qnty  = 0
      983             v-total-price-base = 0
      984             v-total-price-rubl = 0
      985             v-total-road-tax-base =  0
      986             v-total-road-tax-rubl =  0
      987             v-all-total-road-tax-base =  0
      988             v-all-total-road-tax-rubl =  0
      989             .
      990         for each buf_parts no-lock
      991           where (
      992                 buf_parts.obj-type  = p-obj-type
      993             and buf_parts.obj-code  = p-obj-code
      994             and buf_parts.artic     = p-artic
      995             and buf_parts.prod-type = p-prod-type
      996             and buf_parts.prod-code = p-prod-code
      997             and buf_parts.status_   = no
      998             and buf_parts.out-code  = 'free-zone':U
      999             and buf_parts.qnty      > 0
     1000             ) or
     1001             (
     1002                 buf_parts.obj-type  = p-obj-type
     1003             and buf_parts.obj-code  = p-obj-code
     1004             and buf_parts.artic     = p-artic
     1005             and buf_parts.prod-type = p-prod-type
     1006             and buf_parts.prod-code = p-prod-code
     1007             and buf_parts.status_   = no
     1008             and buf_parts.out-code  = p-doc-num
     1009             )
     1010         on error undo, return error
     1011         :
     1012            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     1013   assign
     1014     price-rubl-with-tax-loc = buf_parts.price-rubl
     1015     price-base-with-tax-loc = buf_parts.price-base
     1016   .
     1017   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1019     (output varinvprb
     1020     )  .
     1021     if buf_parts.out-code = 'free-zone':U     or
     1022        buf_parts.out-code = 'out-zone':U   or
     1023        buf_parts.doc-type = 'акт':U then do:
     1024       assign
     1025         in-vatp-have-vat-slt = yes.
     1026     end.
     1027     else do:
     1028       find first in-vatp_doc-attr no-lock
     1029         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1030           and in-vatp_doc-attr.attr-code = 'envd':U
     1031         no-error .
     1032       if not available in-vatp_doc-attr then do:
     1033         assign
     1034           in-vatp-have-vat-slt = yes.
     1035       end.
     1036       else do:
     1037            in-vatp-have-vat-slt = no.
     1038       end.
     1039     end.
     1040     assign
     1041      price-cli-with-tax-loc = buf_parts.price-cli
     1042      cli-base-rate          = buf_parts.cli-base-rate.
     1043     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1044              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1045     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1046             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1047             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1048             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1049             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1050             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1051             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1052       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1053     assign
     1054       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1055     assign
     1056       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1057       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1058       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1059       transport-cli-loc  = 0
     1060       other-cli-loc      = 0
     1061     .
     1062   ASSIGN
     1063             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1064       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1065   .
     1066           assign
     1067             v-total-price-base    =  v-total-price-base +
     1068                         ( (price-base-with-tax-loc
     1069                         - vat-base-loc
     1070                         - road-tax-base-loc )
     1071                         * buf_parts.fact-qnty)
     1072             v-total-price-rubl    =  v-total-price-rubl +
     1073                          ( (price-rubl-with-tax-loc
     1074                          - road-tax-rubl-loc
     1075                          - vat-rubl-loc)
     1076                          * buf_parts.fact-qnty)
     1077             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     1078             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     1079            .
     1080         end.
     1081             if v-total-avrg-qnty > 0 then  DO:
     1082                 Assign
     1083                     p-calc-base     =  v-total-price-base / v-total-avrg-qnty
     1084                     p-calc-rubl     =  v-total-price-rubl / v-total-avrg-qnty
     1085                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     1086                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     1087                     p-price-base    =  p-calc-base
     1088                                         * (1 + v-bonus / 100)
     1089                                         * (1 + p-disc / 100)
     1090                                         * (1 + v-vat-pc / 100 )
     1091                                         * (1 + v-slt-pc / 100 )
     1092                                         + p-road-tax-base
     1093                     p-price-rubl    = ( p-calc-rubl )
     1094                                        * (1 + v-bonus / 100)
     1095                                        * (1 + p-disc / 100)
     1096                                        * (1 + v-vat-pc / 100)
     1097                                        * (1 + v-slt-pc / 100)
     1098                                        + p-road-tax-rubl
     1099                     .
     1100                End.
     1101               if v-total-avrg-qnty <= 0 then do:
     1102                 find first buf_gds-obj no-lock
     1103                   where buf_gds-obj.obj-type  = p-obj-type
     1104                     and buf_gds-obj.obj-code  = p-obj-code
     1105                     and buf_gds-obj.artic     = p-artic
     1106                     and buf_gds-obj.prod-type = p-prod-type
     1107                     and buf_gds-obj.prod-code = p-prod-code
     1108                   no-error .
     1109                       if available buf_gds-obj then do:
     1110                         find b-td where b-td.doc-code  = buf_gds-obj.in-code no-lock no-error .
     1111                         find b-dl where     b-dl.doc-code = buf_gds-obj.in-code
     1112                                         and b-dl.artic     = p-artic
     1113                                         and b-dl.prod-type = p-prod-type
     1114                                         and b-dl.prod-code = p-prod-code no-lock no-error.
     1115                         if avail b-dl then do :
     1116   assign
     1117     price-rubl-with-tax-loc = b-dl.price-rubl
     1118     price-base-with-tax-loc = b-dl.price-base
     1119   .
     1120   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1122     (output varinvprb
     1123     )  .
     1124      find first in-vatp_doc-attr no-lock
     1125       where in-vatp_doc-attr.doc-code  = b-td.doc-code
     1126         and in-vatp_doc-attr.attr-code = 'envd':U
     1127       no-error .
     1128       if available in-vatp_doc-attr
     1129          then do:
     1130          assign
     1131            in-vatp-have-vat-slt = no.
     1132      end.
     1133      else do:
     1134        assign
     1135          in-vatp-have-vat-slt = yes.
     1136      end.
     1137      find first in-vatp-goods where in-vatp-goods.artic     = b-dl.artic     and
     1138                                        in-vatp-goods.prod-type = b-dl.prod-type and
     1139                                        in-vatp-goods.prod-code = b-dl.prod-code no-lock.
     1140      if (not b-td.internal and
     1141              b-td.doc-type = 'при':U) or
     1142         in-vatp-goods.gds-type = 'у':U then do:
     1143         if varinvprb = "base":u then do:
     1144           assign
     1145             road-tax-base-loc = b-dl.road-tax
     1146             road-tax-rubl-loc = b-dl.road-tax * b-td.base-rate / b-td.base-scale.
