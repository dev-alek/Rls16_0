     1494       excise-rubl-sale      = (if b-dl.excise   = ? then 0 else b-dl.excise   * 1) .
     1495   end.
     1496   else do:
     1497     assign
     1498           road-tax-rubl-sale    = (if b-dl.road-tax = ? then 0 else b-dl.road-tax * b-td.base-rate / b-td.base-scale)
     1499       excise-rubl-sale      = (if b-dl.excise   = ? then 0 else b-dl.excise   * b-td.base-rate / b-td.base-scale) .
     1500   end.
     1501   assign
     1502     varis-cons-parts-have =  no.
     1503   assign
     1504     varfact-qnty       = 0
     1505     varcons-qnty       = 0
     1506     varprice-base-cons = 0
     1507     varprice-rubl-cons = 0.
     1508   find first out-vatp_doc-line where
     1509              out-vatp_doc-line.doc-code   = b-td.doc-code
     1510          and out-vatp_doc-line.artic      = b-dl.artic
     1511          and out-vatp_doc-line.prod-type  = b-dl.prod-type
     1512          and out-vatp_doc-line.prod-code  = b-dl.prod-code no-lock no-error.
     1513   if available out-vatp_doc-line           and
     1514     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1515     assign
     1516       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1517   end.
     1518   else do:
     1519     for each out-vatp_parts where out-vatp_parts.out-code   = b-td.doc-code
     1520                                  and out-vatp_parts.obj-type   = b-td.obj-type
     1521                                  and out-vatp_parts.obj-code   = b-td.obj-code
     1522                                  and out-vatp_parts.artic      = b-dl.artic
     1523                                  and out-vatp_parts.prod-type  = b-dl.prod-type
     1524                                  and out-vatp_parts.prod-code  = b-dl.prod-code no-lock :
     1525       if out-vatp_parts.purch-code = 2 then do:
     1526   assign
     1527     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1528     price-base-with-tax-loco = out-vatp_parts.price-base
     1529   .
     1530   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1532     (output varinvprbo
     1533     )  .
     1534     if out-vatp_parts.out-code = 'free-zone':U     or
     1535        out-vatp_parts.out-code = 'out-zone':U   or
     1536        out-vatp_parts.doc-type = 'акт':U then do:
     1537       assign
     1538         in-vatp-have-vat-slto = yes.
     1539     end.
     1540     else do:
     1541       find first in-vatp_doc-attro no-lock
     1542         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1543           and in-vatp_doc-attro.attr-code = 'envd':U
     1544         no-error .
     1545       if not available in-vatp_doc-attro then do:
     1546         assign
     1547           in-vatp-have-vat-slto = yes.
     1548       end.
     1549       else do:
     1550            in-vatp-have-vat-slto = no.
     1551       end.
     1552     end.
     1553     assign
     1554      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1555      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1556     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1557              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1558     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
