      698   define variable v-base-scale as decimal   no-undo .
      699   define variable v-bar-code like ub.bar-code.b-code no-undo .
      700   define variable parrecid as recid no-undo.
      701   define variable price-rubl-with-tax-saleprl    like doc-line.price-rubl no-undo.
      702   define variable price-base-with-tax-saleprl    like doc-line.price-base no-undo.
      703   define variable price-rubl-without-tax-saleprl like doc-line.price-rubl no-undo.
      704   define variable price-base-without-tax-saleprl like doc-line.price-base no-undo.
      705   define variable vat-base-saleprl               like doc-line.price-base no-undo.
