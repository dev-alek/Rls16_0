      708   define variable vat-rubl-buyerprl              like doc-line.price-rubl no-undo.
      709   define variable slt-base-saleprl               like doc-line.price-base no-undo.
      710   define variable slt-rubl-saleprl               like doc-line.price-rubl no-undo.
      711   define variable road-tax-base-saleprl          like doc-line.road-tax   no-undo.
      712   define variable road-tax-rubl-saleprl          like doc-line.road-tax   no-undo.
      713   define variable excise-base-saleprl            like doc-line.price-base no-undo.
      714   define variable excise-rubl-saleprl            like doc-line.price-rubl no-undo.
      715   define variable discnt-base-saleprl            like gds-dtl.discnt-base no-undo.
      716   define variable discnt-rubl-saleprl            like gds-dtl.discnt-rubl no-undo.
      717   define variable v-cur-dn as character no-undo .
      718   define variable v-cur-pr as decimal no-undo .
      719   define variable v-cur-rt as decimal no-undo .
      720   define variable v-cur-ex as decimal no-undo .
      721   define variable v-cur-dn2 as character no-undo .
      722   define variable v-cur-pr2 as decimal no-undo .
      723   define variable v-cur-rt2 as decimal no-undo .
      724   define variable v-cur-ex2 as decimal no-undo .
      725   define variable v-log as logical no-undo .
      726   define variable v-vat-pc                          like doc-line.vat-pc     no-undo.
      727   define variable v-slt-pc                          like doc-line.slt-pc     no-undo.
      728   define variable v-host-code                       like sysconf.host-code   no-undo.
      729   define variable l-slt like price-list.slt-pc no-undo .
      730   define variable l-vat like price-list.vat-pc no-undo .
      731   define variable pr-gen-mrgn as character no-undo .
      732   define variable par-type    as character no-undo .
      733   define variable v-tax-road as decimal no-undo .
      734   define variable v-bonus as decimal   no-undo .
      735   find first buf_goods no-lock
      736     where buf_goods.artic     = p-artic
      737       and buf_goods.prod-type = p-prod-type
      738       and buf_goods.prod-code = p-prod-code
      739     no-error .
      740   if not available buf_goods then do:
      741     message
      742       vss-workfile vss-revision vss-description skip
      743       "Не найден товар" skip
      744       "Артикул" p-artic p-prod-type p-prod-code skip
      745       view-as alert-box .
      746     undo, return error .
      747   end.
      748   v-bonus = 0.0 .
      749   define buffer bufb_trn-doc for ub.trn-doc  .
      750   define buffer buf_contract-specif-attr for ub.contract-specif-attr  .
      751   find first bufb_trn-doc no-lock where
      752              bufb_trn-doc.doc-code = p-doc-num
      753              no-error .
      754   if available bufb_trn-doc then do:
      755   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   ASSIGN
      757      i-gl-Host-Code      = 0
      758      i-gl-Contract-Code  = 0
      759      i-gl-Extent3        = 0
      760      .
      761   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      762       INPUT  bufb_trn-doc.host-code,
      763       INPUT  bufb_trn-doc.contract-code,
      764       OUTPUT i-gl-Extent3
      765      ).
      766   IF i-gl-Extent3[1] = 2 THEN DO:
      767      ASSIGN
      768         i-gl-Host-Code      = i-gl-Extent3[2]
      769         i-gl-Contract-Code  = i-gl-Extent3[3]
      770         .
      771   END. ELSE DO:
      772      ASSIGN
      773         i-gl-Host-Code      = bufb_trn-doc.host-code
      774         i-gl-Contract-Code  = bufb_trn-doc.contract-code
      775         .
      776   END.
      777       FIND FIRST buf_contract-specif-attr
      778              NO-LOCK
      779              WHERE
      780                  buf_contract-specif-attr.Host-code    = i-gl-Host-Code
      781              AND buf_contract-specif-attr.Contract-num = i-gl-Contract-Code
      782              AND buf_contract-specif-attr.Gds-code     = buf_goods.gds-code
      783              AND buf_contract-specif-attr.Attr-code    = 'bonus':U
      784              NO-ERROR
      785              .
      786       if available buf_contract-specif-attr
      787          then v-bonus = decimal (buf_contract-specif-attr.attr-value) .
      788          else v-bonus = 0.0 .
      789   end.
      790   empty temp-table thbjattr_thbj-attr.
      791     run adm/shattri.p (
