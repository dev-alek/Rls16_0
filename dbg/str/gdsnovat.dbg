     2433   define input-output parameter p-road-tax-base as decimal no-undo .
     2434   define input-output parameter p-road-tax-rubl as decimal no-undo .
     2435   define variable v-doc-code as character no-undo .
     2436   define buffer     buff-goods    for ub.goods      .
