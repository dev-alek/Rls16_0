      540   function hvrdtax return logical (input parrecid as recid):
      541   define variable varresult as logical no-undo.
      542   run hvrdtax-proc (input parrecid, output varresult).
      543   return varresult.
      544   end function.
      545   procedure hvrdtax-proc:
      546   define input  parameter parrecid  as recid   no-undo.
      547   define output parameter parresult as logical no-undo.
      548   define buffer bf_goods for ub.goods.
      549   define buffer bf_units for ub.units.
      550   define buffer rt_tax   for ub.tax.
      551   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      552   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      553   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      554   if available rt_tax and
      555       can-find(first ub.tax-units No-LOCK WHERE
      556                      ub.tax-units.tax-code = rt_tax.tax-code AND
      557                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      558                                                       else assign parresult = no.
      559   end procedure.
      560   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      562   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      564   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      565   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      566   ASSIGN
      567      v-S_CONTRACT                = "Contract":U
      568      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      569      v-DELIM_CHR_3               = ","
      570      .
      571   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      572   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      573   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      574   FUNCTION Can-Find-Spec RETURN LOGICAL (
      575      INPUT iHost-Code    AS INTEGER,
      576      INPUT iContract-Num AS INTEGER,
      577      INPUT iGds-Code     AS INTEGER ):
      578      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      579      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      580      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      581      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      582      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      583      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      584          INPUT  iHost-Code,
      585          INPUT  iContract-Num,
      586          OUTPUT iTmp-Extent3
      587          ).
      588      IF iTmp-Extent3[1] = 2 THEN DO:
      589         ASSIGN
      590            iTmp-Host-Code      = iTmp-Extent3[2]
      591            iTmp-Contract-Num   = iTmp-Extent3[3]
      592            .
      593      END. ELSE DO:
      594         ASSIGN
      595            iTmp-Host-Code      = iHost-Code
      596            iTmp-Contract-Num   = iContract-Num
      597            .
      598      END.
      599      IF iGds-Code = ? THEN DO:
      600         ASSIGN
      601            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      602                                  buf_Spec.Host-Code     = iTmp-Host-Code
      603                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      604                           ).
      605      END. ELSE DO:
      606            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      607                                  buf_Spec.Host-Code     = iTmp-Host-Code
      608                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      609                              AND buf_Spec.Gds-Code      = iGds-Code
      610                            ).
      611      END.
      612      RETURN (lRet).
      613   END FUNCTION.
      614   PROCEDURE MS-Contract-EXTENT-3:
      615      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      616      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      617      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      618      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      619      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      620      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      621      FIND FIRST buf_Cont-2 WHERE
      622                 buf_Cont-2.Host-Code      = i-Host-Code
      623             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      624           NO-LOCK NO-ERROR.
      625      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      626         RETURN.
      627      END.
      628      FOR FIRST buf_Ext-Classif WHERE
      629                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      630           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      631                                               STRING(i-Contract-code)
      632           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      633          NO-LOCK,
      634          EACH buf_Cont WHERE
      635               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      636           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      637          NO-LOCK:
      638          ASSIGN
      639             i-Ret[1] = 1
      640             i-Ret[2] = buf_Cont.Host-code
      641             i-Ret[3] = buf_Cont.Contract-code
      642             .
      643          LEAVE.
      644      END.
      645      IF i-Ret[1] <> 1 THEN DO:
      646         FOR FIRST buf_Ext-Classif WHERE
      647                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      648              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      649                                                  STRING(i-Contract-code)
      650              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      651             NO-LOCK,
      652             EACH buf_Cont WHERE
      653                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      654              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      655             NO-LOCK:
      656             ASSIGN
      657                i-Ret[1] = 2
      658                i-Ret[2] = buf_Cont.Host-code
      659                i-Ret[3] = buf_Cont.Contract-code
      660                .
      661             LEAVE.
      662         END.
      663      END.
      664      RETURN.
      665   END PROCEDURE.
