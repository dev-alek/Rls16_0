     2259                         string(YES)        + chr(4) +
     2260                         string(no)     + chr(4) +
     2261                         string(auto-comp)                + chr(4) +
     2262                         string(autofbr)                  + chr(4) +
     2263                         string(one-curs)                 + chr(4) +
     2264                         string(buf_shop.is-catering)     + chr(4) +
     2265                         string(v-is-tpsi-obj)            + chr(4) +
     2266                         string(restdish)                 + chr(4) +
     2267                         string(restingr)                 + chr(4) +
     2268                         string(resttpsi)                 + chr(4) +
     2269                         string(neg-tpsi-weight)          + chr(4) +
     2270                         string(neg-tpsi-qnty)            + chr(4) +
     2271                         string(neg-tpsi-oper)            + chr(4) +
     2272                         string(close-in-rfsl)            + chr(4) +
     2273                         pay-gds-algo
     2274         .
     2275   .
     2276         run str/saleclos.p (
     2277                         input this-procedure
     2278                        ,input this-procedure
     2279                        ,input this-procedure
     2280                        ,input v-parameter
     2281                        )  no-error.
     2282         if error-status:error
     2283         and return-value <> "error"
     2284         then do:
     2285           run write-to-log in this-procedure (
     2286                 input substitute( "!!!Ошибка при закрытии на факт документа продажи &1 в &2&3&4" +
     2287                                   "&5 &6"
     2288                                 , buf_inkas.inkas-code
     2289                                 , p-curr-obj-type
     2290                                 , p-curr-obj-code
     2291                                 , chr(10)
     2292                                 , error-status:get-message(1)
     2293                                 , return-value
     2294                                 )            ).
     2295            next _inkas.
     2296         end.
     2297       end.
     2298     end.
     2299   end procedure.
     2300   procedure proc-step-400 :
     2301   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     2302   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     2303   define input parameter p-process-only-new as logical no-undo .
     2304   define variable v-parameter as character no-undo .
     2305   define buffer buf_inkas for ub.inkas.
     2306   define buffer buf_chk-doc for ub.chk-doc.
     2307     do
     2308     on error undo, return error
     2309     :
     2310       _inkas:
     2311       for each buf_inkas where
     2312               buf_Inkas.obj-type = p-curr-obj-type
     2313           AND buf_Inkas.obj-code = p-curr-obj-code
     2314           AND buf_Inkas.status_ = 'новый':U:
     2315         if p-process-only-new then do:
     2316           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     2317           if not available temp-inkas then next _inkas.
     2318         end.
     2319         find first buf_chk-doc no-lock where
     2320                   buf_chk-doc.obj-type = p-curr-obj-type
     2321               AND buf_chk-doc.obj-code = p-curr-obj-code
     2322               AND buf_chk-doc.out-code = buf_inkas.inkas-code no-error.
     2323         if not available buf_chk-doc then do:
     2324           assign
     2325           v-parameter = string(2)                 + chr(4) +
     2326                         p-curr-obj-type           + chr(4) +
     2327                         string(p-curr-obj-code)   + chr(4) +
     2328                         string(no)                + chr(4) +
     2329                         buf_inkas.inkas-code
     2330           .
     2331           run str/del-sale.p (
     2332                           input this-procedure
     2333                         ,input this-procedure
     2334                         ,input this-procedure
     2335                         ,input v-parameter
     2336                         )  no-error.
     2337           if error-status:error
     2338           and return-value <> "error"
     2339           then do:
     2340             run write-to-log in this-procedure (
     2341                   input substitute( "!!!Ошибка при удалении пустой (без чеков) продажи &1 в &2&3&4" +
     2342                                     "&5 &6"
     2343                                   , buf_inkas.inkas-code
     2344                                   , p-curr-obj-type
     2345                                   , p-curr-obj-code
     2346                                   , chr(10)
     2347                                   , error-status:get-message(1)
     2348                                   , return-value
     2349                                   )            ).
     2350             next _inkas.
     2351           end.
     2352         end.
     2353       end.
     2354     end.
     2355   end procedure.
     2356   procedure get-db-num:
     2357     define output parameter pDbNum as integer no-undo.
     2358     pDbNum = g#db-num.
     2359   end.
     2360   procedure get-userid:
     2361     define output parameter pUserId as character no-undo.
     2362     assign
     2363       pUserId  = g#userid
     2364       .
     2365   end.
     2366   do
     2367   on error undo, return error
     2368   :
     2369       define variable v-ind                       as integer      no-undo.
     2370       define variable v-param-list                as character    no-undo.
     2371       define variable v-temp-obj-list             as character    no-undo.
     2372       define variable v-obj-list                  as character    no-undo.
     2373       define variable v-param-type                as character    no-undo.
     2374       define variable v-obj-counter               as integer      no-undo.
     2375       define variable v-range                     as integer      no-undo.
     2376       define variable v-host-code                 as integer      no-undo.
     2377       define variable v-start-state               as integer      no-undo .
     2378       define variable v-end-state                 as integer      no-undo .
     2379       define variable v-finalize-100              as logical      no-undo .
     2380       define variable v-finalize-200              as logical      no-undo .
     2381       define variable v-process-only-new          as logical      no-undo .
     2382       define variable v-parameter                 as character    no-undo .
     2383       define buffer buf_clients   for ub.clients .
     2384       define buffer buf_temp-obj  for temp-obj.
     2385       assign
     2386       log-file-name = "ext-sale.log".
     2387       run gbl/set-gbl.p
     2388         (input  true
     2389         ,input  g#auto-user-id
     2390         ,input  g#auto-user-password
     2391         ) no-error.
     2392       if error-status :error
     2393       then do:
     2394           run write-to-log( vss-workfile + chr(32)
     2395                           + "!!!Ошибка при инициализации переменных g#..." + chr(10)
     2396                           + error-status:get-message(error-status:num-messages)
     2397                           + return-value
     2398                           ) .
     2399           return error.
     2400       end.
     2401       run schedule-attr-value in this-procedure (
     2402             input p-cre-db-num
     2403           , input p-task-type
     2404           , input p-task-num
     2405           , input 'schedule-param-list':U
     2406           , output v-param-list
     2407           , output v-param-type
     2408       ).
     2409       if v-param-list = "":U then do:
     2410           run write-to-log( substitute("!!!Не заданы параметры обработки продаж в задаче &1&2"
     2411                                        , p-task-num
     2412                                        , chr(10)
     2413                                        )
     2414                           ) .
     2415       end.
     2416       assign
     2417           v-range = integer( entry( 1,  v-param-list ) )
     2418           v-start-state = (if num-entries(v-param-list) > 2 then integer(entry(3, v-param-list)) else 0)
     2419           v-end-state = (if num-entries(v-param-list) > 3 then integer(entry(4, v-param-list)) else 0)
     2420           v-finalize-100  = (if num-entries(v-param-list) > 4 then logical(entry(5, v-param-list)) else no)
     2421           v-finalize-200  = (if num-entries(v-param-list) > 4 then logical(entry(6, v-param-list)) else no)
     2422       .
     2423       if v-range = 2
     2424       then do:
     2425           if num-entries( v-param-list ) > 2
     2426           then do:
     2427               assign
     2428                   v-host-code = integer( entry( 2,  v-param-list ) )
     2429               .
     2430           end.
     2431           else do:
     2432               assign
     2433                   v-host-code = -1
     2434               .
     2435               run write-to-log in this-procedure (
     2436                   input vss-workfile + chr(32) + " Не удалось определить код фирмы для обработки документов продаж объектов фирмы."
     2437               ).
     2438           end.
     2439       end.
     2440       if v-range = 2
     2441       and v-host-code = -1
     2442       then do:
     2443           assign
     2444               v-range = 1
     2445           .
     2446       end.
     2447       if v-range <> 3 then run init-temphost.
     2448       case v-range
     2449       :
     2450           when 1
     2451           then do:
     2452               for each temp-obj
     2453               :
     2454                   if temp-obj.db-num = p-db-num
     2455                   then do:
     2456                       assign
     2457                           v-obj-list = v-obj-list
     2458                                           + ( if v-obj-list = "" then "" else "," )
     2459                                           + temp-obj.obj-type
     2460                                           + "," + string( temp-obj.obj-code )
     2461                       .
     2462                   end.
     2463               end.
     2464               assign
     2465                   v-range     = 3
     2466               .
     2467           end.
     2468           when 2
     2469           then do:
     2470               for each temp-obj
     2471               :
     2472                   if temp-obj.db-num = p-db-num
     2473                   and temp-obj.host-code = v-host-code
     2474                   then do:
     2475                       assign
     2476                           v-obj-list = v-obj-list
     2477                                           + ( if v-obj-list = "" then "" else "," )
     2478                                           + temp-obj.obj-type
     2479                                           + "," + string( temp-obj.obj-code )
     2480                       .
     2481                   end.
     2482               end.
     2483               assign
     2484                   v-range     = 3
     2485               .
     2486           end.
     2487           when 3
     2488           then do:
     2489               run schedule-attr-value in this-procedure (
     2490                     input p-cre-db-num
     2491                   , input p-task-type
     2492                   , input p-task-num
     2493                   , input 'schedule-obj-list':U
     2494                   , output v-temp-obj-list
     2495                   , output v-param-type
     2496               ).
     2497               do v-obj-counter = 1 to num-entries ( v-temp-obj-list ) / 2
     2498               :
     2499                   find first buf_clients no-lock
     2500                         where buf_clients.obj-type  = entry( v-obj-counter * 2 - 1, v-temp-obj-list )
     2501                           and buf_clients.obj-code = integer( entry( v-obj-counter * 2, v-temp-obj-list ) )
     2502                   no-error.
     2503                   if not available buf_clients
     2504                   then do:
     2505                       run write-to-log( vss-workfile + chr(32)
     2506                                       + substitute( " Ошибка обработки документов продаж по расписанию: Не найден заданный объект &1 &2" + chr(10)
     2507                                                       , buf_clients.obj-type
     2508                                                       , buf_clients.obj-code
     2509                                                   )
     2510                                       ) .
     2511                       undo, return error .
     2512                   end.
     2513                   else do:
     2514                       if buf_clients.db-num = p-db-num
     2515                       then do:
     2516                           assign
     2517                               v-obj-list = v-obj-list
     2518                                               + ( if v-obj-list = "" then "" else "," )
     2519                                               + buf_clients.obj-type
     2520                                               + "," + string( buf_clients.obj-code )
     2521                           .
     2522                           create buf_temp-obj .
     2523                           assign
     2524                             buf_temp-obj.obj-type  = buf_clients.obj-type
     2525                             buf_temp-obj.obj-code  = buf_clients.obj-code
     2526                             buf_temp-obj.host-code = buf_clients.host-code
     2527                             buf_temp-obj.db-num    = buf_clients.db-num
     2528                           .
     2529                       end.
     2530                   end.
     2531               end.
     2532           end.
     2533       end case.
     2534       if v-obj-list = ""
     2535       then do:
     2536           run write-to-log( vss-workfile + chr(32)
     2537                           + substitute( " Нет объектов для обработки документов продаж."
     2538                                           + chr(10) + "    Номер базы данных:                   &1"
     2539                                           + chr(10) + "    Задан список объектов:               &2"
     2540                                           + chr(10) + "    Тип обработки        :               &3"
     2541                                           , p-db-num
     2542                                           , v-obj-list
     2543                                           , v-range
     2544                                       )
     2545                           ) .
     2546           undo, return error .
     2547       end.
     2548   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2550     (output v-curr-r-b
     2551     )  .
     2552       _temp-obj:
     2553       for each temp-obj no-lock where
     2554                temp-obj.obj-type = 'маг':U:
     2555         if temp-obj.db-num <> g#db-num
     2556         or index(v-obj-list,  temp-obj.obj-type + chr(44) + string( temp-obj.obj-code )) = 0 then do:
     2557           next _temp-obj.
     2558         end.
     2559         assign
     2560           v-cntxt-obj-type      = temp-obj.obj-type
     2561           v-cntxt-obj-code      = temp-obj.obj-code
     2562           v-cntxt-host-code-obj = temp-obj.host-code
     2563           v-cntxt-db-num-obj    = temp-obj.db-num
     2564         .
     2565         run write-to-log in this-procedure (
     2566               input substitute( "            &1&2 Обработка документов продаж............."
     2567                                , temp-obj.obj-type
     2568                                , temp-obj.obj-code
     2569                                )
     2570                                           ).
     2571         if v-start-state = 0 then do:
     2572           assign
     2573           v-process-only-new = yes.
     2574           assign
     2575           v-parameter =
     2576                         temp-obj.obj-type         + chr(4) +
     2577                         string(temp-obj.obj-code) + chr(4) +
     2578                         string(p-cre-db-num) + chr(4) +
     2579                         string(p-task-type) + chr(4) +
     2580                         string(p-task-num).
     2581           run write-to-log in this-procedure (
     2582                 input substitute( "Создание документов продаж по шаблонам в &1&2..........."
     2583                                 , temp-obj.obj-type
     2584                                 , temp-obj.obj-code
     2585                                 )            ).
     2586           run str/salemake.p (
     2587                          input this-procedure
     2588                         ,input this-procedure
     2589                         ,input this-procedure
     2590                         ,input v-parameter  ) no-error .
     2591           if error-status:error then do:
     2592             run write-to-log in this-procedure (
     2593                   input substitute( "!!!Ошибка при создании документов продаж по шаблонам в &1&2&3" +
     2594                                     "&4 &5"
     2595                                   , temp-obj.obj-type
     2596                                   , temp-obj.obj-code
     2597                                   , chr(10)
     2598                                   , error-status:get-message(1)
     2599                                   , return-value
     2600                                   )            ).
     2601           end.
     2602         end.
     2603         if v-start-state <= 100
     2604         and v-end-state >= 100
     2605         then do:
     2606           run write-to-log in this-procedure (
     2607                 input substitute( "Закачка чеков в документы продажи в &1&2..........."
     2608                                 , temp-obj.obj-type
     2609                                 , temp-obj.obj-code
     2610                                 )            ).
     2611           run proc-step-100 in this-procedure(
     2612                                               input temp-obj.obj-type
     2613                                              ,input temp-obj.obj-code
     2614                                              ,input v-process-only-new
     2615                                              ,input v-finalize-100
     2616                                              )  no-error .
     2617           if error-status:error then do:
     2618             run write-to-log in this-procedure (
     2619                   input substitute( "!!!Ошибка при закачке чеков в документы продаж в &1&2&3" +
     2620                                     "&4 &5"
     2621                                   , temp-obj.obj-type
     2622                                   , temp-obj.obj-code
     2623                                   , chr(10)
     2624                                   , error-status:get-message(1)
     2625                                   , return-value
     2626                                   )            ).
     2627           end.
     2628         end.
     2629         process events.
     2630         if v-start-state <= 200
     2631         and v-end-state >= 200
     2632         then do:
     2633           run write-to-log in this-procedure (
     2634                 input substitute( "Резервирование в документах продаж в &1&2..........."
     2635                                 , temp-obj.obj-type
     2636                                 , temp-obj.obj-code
     2637                                 )            ).
     2638           run proc-step-200 in this-procedure(
     2639                                               input temp-obj.obj-type
     2640                                              ,input temp-obj.obj-code
     2641                                              ,input v-process-only-new
     2642                                              ,input v-finalize-200)  no-error .
     2643           if error-status:error then do:
     2644             run write-to-log in this-procedure (
     2645                   input substitute( "!!!Ошибка при резервировании документов продаж в &1&2&3" +
     2646                                     "&4 &5"
     2647                                   , temp-obj.obj-type
     2648                                   , temp-obj.obj-code
     2649                                   , chr(10)
     2650                                   , error-status:get-message(1)
     2651                                   , return-value
     2652                                   )            ).
     2653           end.
     2654         end.
     2655         process events.
     2656         if v-start-state <= 300
     2657         and v-end-state >= 300
     2658         then do:
     2659           run write-to-log in this-procedure (
     2660                 input substitute( "Закрытие на факт документов продаж в &1&2..........."
     2661                                 , temp-obj.obj-type
     2662                                 , temp-obj.obj-code
     2663                                 )            ).
     2664           run proc-step-300 in this-procedure(
     2665                                               input temp-obj.obj-type
     2666                                              ,input temp-obj.obj-code
     2667                                              ,input v-process-only-new)  no-error .
     2668           if error-status:error then do:
     2669             run write-to-log in this-procedure (
     2670                   input substitute( "!!!Ошибка при закрытии на факт документов продаж в &1&2&3" +
     2671                                     "&4 &5"
     2672                                   , temp-obj.obj-type
     2673                                   , temp-obj.obj-code
     2674                                   , chr(10)
     2675                                   , error-status:get-message(1)
     2676                                   , return-value
     2677                                   )            ).
     2678           end.
     2679         end.
     2680         if v-start-state <= 400
     2681         and v-end-state >= 400
     2682         then do:
     2683           run write-to-log in this-procedure (
     2684                 input substitute( "Удаление пустых(без чеков) документов продаж в &1&2..........."
     2685                                 , temp-obj.obj-type
     2686                                 , temp-obj.obj-code
     2687                                 )            ).
     2688           run proc-step-400 in this-procedure(
     2689                                               input temp-obj.obj-type
     2690                                              ,input temp-obj.obj-code
     2691                                              ,input v-process-only-new)  no-error .
     2692           if error-status:error then do:
     2693             run write-to-log in this-procedure (
     2694                   input substitute( "!!!Ошибка при удалении пустых (без чеков) документов продаж в &1&2&3" +
     2695                                     "&4 &5"
     2696                                   , temp-obj.obj-type
     2697                                   , temp-obj.obj-code
     2698                                   , chr(10)
     2699                                   , error-status:get-message(1)
     2700                                   , return-value
     2701                                   )            ).
     2702           end.
     2703         end.
     2704         process events.
     2705         run write-to-log in this-procedure (
     2706               input substitute( "Обработка документов продаж &1&2 завершена"
     2707                                , temp-obj.obj-type
     2708                                , temp-obj.obj-code
     2709                                )
     2710                                           ).
     2711       end.
     2712   end.
     2713   procedure mainmenu_getcntxt :
     2714   define output parameter p-cntxt-db-num                as integer   no-undo .
     2715   define output parameter p-cntxt-userid                as character no-undo .
     2716   define output parameter p-cntxt-level                 as character no-undo .
     2717   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     2718   define output parameter p-cntxt-obj-type              as character no-undo .
     2719   define output parameter p-cntxt-obj-code              as integer   no-undo .
     2720   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     2721   define output parameter p-cntxt-is-admin              as logical   no-undo .
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725     assign
     2726       p-cntxt-db-num          =  g#db-num
     2727       p-cntxt-userid          =  g#userid
     2728       p-cntxt-level           =  v-cntxt-level
     2729       p-cntxt-host-code-obj   =  v-cntxt-host-code-obj
     2730       p-cntxt-obj-type        =  v-cntxt-obj-type
     2731       p-cntxt-obj-code        =  v-cntxt-obj-code
     2732       p-cntxt-is-admin        =  v-cntxt-is-admin
     2733       p-cntxt-db-num-obj      =  v-cntxt-db-num-obj
     2734     .
     2735     end.
     2736    end procedure.
