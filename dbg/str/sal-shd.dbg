     2233           end.
     2234           when 'pay-gds-algo':U then do:
     2235             pay-gds-algo = thbjattr_thbj-attr.property-value-character.
     2236           end.
     2237         end case.
     2238       end.
     2239       assign
     2240       restdish = restdish and autofbr
     2241       restingr = restingr and autofbr
     2242       resttpsi = resttpsi and v-is-tpsi-obj
     2243       neg-tpsi-weight = neg-tpsi-weight and v-is-tpsi-obj
     2244       neg-tpsi-oper = neg-tpsi-oper and v-is-tpsi-obj
     2245       .
     2246       _inkas:
     2247       for each buf_inkas where
