     1730   .
     1731   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1732   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733     define variable v-cntxt-db-num        as integer   no-undo .
     1734     define variable v-cntxt-userid        as character no-undo .
     1735     define variable v-cntxt-level         as character no-undo .
     1736     define variable v-cntxt-host-code-obj as integer   no-undo .
     1737     define variable v-cntxt-obj-type      as character no-undo .
     1738     define variable v-cntxt-obj-code      as integer   no-undo .
     1739     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1740     define variable v-cntxt-is-admin      as logical   no-undo .
     1741   define new shared temp-table temp-inkas no-undo like ub.inkas.
     1742   define variable v-curr-r-b as character no-undo init 'rubl':U.
     1743   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1744   procedure proc-step-100 :
     1745   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     1746   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     1747   define input parameter p-process-only-new as logical no-undo .
     1748   define input parameter p-finalize         as logical no-undo .
     1749   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
     1750   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
     1751   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
     1752   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
     1753   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
     1754   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
     1755   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
     1756   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO.
     1757   DEFINE VARIABLE conf-attr AS character NO-UNDO.
     1758   DEFINE VARIABLE conf-par AS character NO-UNDO.
     1759   DEFINE VARIABLE par-type AS character NO-UNDO.
     1760   define variable v-parameter as character no-undo .
     1761   define variable v-is-wth as character no-undo .
     1762   define variable is-wth as logical   no-undo .
     1763   define variable sale-filter as logical no-undo .
     1764   define variable cas-shft    as logical no-undo init no.
     1765   define variable cas-curs    as logical no-undo init no.
     1766   define variable prcl-spl    as logical no-undo init no.
     1767   define variable pay-gds-algo as character no-undo.
     1768   define variable rdtaxcd     as INTEGER                  no-undo.
     1769   define variable exctaxcd    as INTEGER                  no-undo.
     1770   define variable factorrt    as decimal no-undo.
     1771   define variable btltaxcd    as INTEGER                  no-undo.
     1772   define variable p-day-only  as logical no-undo .
     1773   define variable v-param-type as character no-undo .
     1774   define variable v-value-character as character no-undo .
     1775   define variable v-value-date as date no-undo .
     1776   define variable v-value-decimal as decimal no-undo .
     1777   define variable v-value-integer as INTEGER no-undo .
     1778   define variable v-value-logical AS LOGICAL no-undo .
     1779   define variable v-tth as handle no-undo .
     1780   assign
     1781   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1782   define buffer buf_inkas for ub.inkas.
     1783   DEFINE BUFFER buf_shop FOR ub.shop.
     1784   define buffer buf_trn-doc for ub.trn-doc.
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1789     (input  'is-wth':u
     1790     ,input  '':u
     1791     ,input  '':u
     1792     ,input  0
     1793     ,input  '':u
     1794     ,input  '':u
     1795     ,input  '':u
     1796     ,input  no
     1797     ,output v-is-wth
     1798     ,output par-type
     1799     ) no-error .
     1800       if error-status :error
     1801       or par-type <> 'L':U
     1802       or v-is-wth <> 'yes':u
     1803       then do:
     1804         assign
     1805         is-wth = no
     1806         .
     1807       end.
     1808       else do:
     1809         is-wth = yes.
     1810       end.
     1811       FIND FIRST buf_shop NO-LOCK WHERE
     1812                 buf_shop.obj-code = p-curr-obj-code .
     1813       run gbl/tpsi-obj.p ( input p-curr-obj-type
     1814                           ,input p-curr-obj-code
     1815                           ,output v-is-tpsi-obj) no-error .
     1816       for each thbjattr_thbj-attr:
     1817         delete thbjattr_thbj-attr.
     1818       end.
     1819       run adm/shattri.p (
     1820           input "get":U
     1821           ,input  p-curr-obj-type
     1822           ,input  p-curr-obj-code
     1823           ,input  'autosale':U
     1824           ,input  "":U
     1825           ,output v-value-character
     1826           ,output v-value-date
     1827           ,output v-value-decimal
     1828           ,output v-value-integer
     1829           ,output v-value-logical
     1830           ,output v-param-type
     1831           ,INPUT-OUTPUT table-handle v-tth
     1832           ) no-error .
     1833       IF error-status:error then do:
     1834         run write-to-log in this-procedure (
     1835               input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     1836                 , p-curr-obj-type
     1837                 , p-curr-obj-code
     1838                 , chr(10)
     1839                 , error-status:get-message(1)
     1840                 , return-value )).
     1841          undo, return.
     1842       end.
     1843       for each  thbjattr_thbj-attr where
     1844                 thbjattr_thbj-attr.obj-type = p-curr-obj-type
     1845             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     1846             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     1847       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     1848         case thbjattr_thbj-attr.prop-code:
     1849           when 'autocomp':U then do:
     1850             auto-comp = thbjattr_thbj-attr.property-value-logical.
     1851           end.
     1852           when 'autofbr':U then do:
     1853             autofbr = thbjattr_thbj-attr.property-value-logical.
     1854           end.
     1855           when 'one-curs':U then do:
     1856             one-curs = thbjattr_thbj-attr.property-value-logical.
     1857           end.
     1858           when 'restdish':U then do:
     1859             restdish = thbjattr_thbj-attr.property-value-logical.
     1860           end.
     1861           when 'restingr':U then do:
     1862             restingr = thbjattr_thbj-attr.property-value-logical.
     1863           end.
     1864           when 'resttpsi':U then do:
     1865             resttpsi = thbjattr_thbj-attr.property-value-logical.
     1866           end.
     1867           when 'prcl-spl':U then do:
     1868             prcl-spl = thbjattr_thbj-attr.property-value-logical.
     1869           end.
     1870           when 'pay-gds-algo':U then do:
     1871             pay-gds-algo = thbjattr_thbj-attr.property-value-character.
     1872           end.
     1873           when 'sale-filter':U then do:
     1874             sale-filter = thbjattr_thbj-attr.property-value-logical.
     1875           end.
     1876         end case.
     1877         assign
     1878         restdish = restdish and autofbr
     1879         restingr = restingr and autofbr
     1880         resttpsi = resttpsi and v-is-tpsi-obj
     1881         .
     1882       end.
     1883       run adm/shattri.p (
     1884           input "get":U
     1885           ,input  p-curr-obj-type
     1886           ,input  p-curr-obj-code
     1887           ,input  'get-chk':U
     1888           ,input  "":U
     1889           ,output v-value-character
     1890           ,output v-value-date
     1891           ,output v-value-decimal
     1892           ,output v-value-integer
     1893           ,output v-value-logical
     1894           ,output v-param-type
     1895           ,INPUT-OUTPUT table-handle v-tth
     1896           ) no-error .
     1897       IF error-status:error then do:
     1898         run write-to-log in this-procedure (
     1899               input substitute("Ошибка при получении опций закачик чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     1900                 , p-curr-obj-type
     1901                 , p-curr-obj-code
     1902                 , chr(10)
     1903                 , error-status:get-message(1)
     1904                 , return-value )).
     1905          undo, return.
     1906       end.
     1907       for each  thbjattr_thbj-attr where
     1908                 thbjattr_thbj-attr.obj-type = p-curr-obj-type
     1909             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     1910             and thbjattr_thbj-attr.upper-prop-code = 'get-chk':U
     1911       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     1912         case thbjattr_thbj-attr.prop-code:
     1913           when 'cas-shft':U then do:
     1914             assign
     1915             cas-shft = thbjattr_thbj-attr.property-value-logical.
     1916           end.
     1917           when 'cas-curs':U then do:
     1918             assign
     1919             cas-curs = thbjattr_thbj-attr.property-value-logical.
     1920           end.
     1921         end case.
     1922       end.
     1923       assign
     1924       rdtaxcd  = integer('3':U)
     1925       exctaxcd = integer('4':U)
     1926       btltaxcd = integer('3':U).
     1927       _inkas:
     1928       for each buf_inkas where
     1929               buf_Inkas.obj-type = p-curr-obj-type
     1930           AND buf_Inkas.obj-code = p-curr-obj-code
     1931           AND buf_Inkas.status_ = 'новый':U,
     1932         first buf_trn-doc where
     1933              buf_trn-doc.doc-code = buf_inkas.inkas-code:
     1934         if p-process-only-new then do:
     1935           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     1936           if not available temp-inkas then next _inkas.
     1937         end.
     1938         if buf_trn-doc.flag_ <> no then NEXT _inkas.
     1939         assign
     1940         v-parameter =     string(if p-finalize then 3 else 2)
     1941                                                           + chr(4) +
     1942                           buf_inkas.inkas-code            + chr(4) +
     1943                           string(sale-filter)             + chr(4) +
     1944                           v-curr-r-b                      + chr(4) +
     1945                           string(is-wth)                  + chr(4) +
     1946                           string(cas-shft)                + chr(4) +
     1947                           string(one-curs)                + chr(4) +
     1948                           string(cas-curs)                + chr(4) +
     1949                           string(prcl-spl)                + chr(4) +
     1950                           pay-gds-algo                    + chr(4) +
     1951                           string(rdtaxcd)                 + chr(4) +
     1952                           string(exctaxcd)                + chr(4) +
     1953                           string(factorrt)                + chr(4) +
     1954                           string(btltaxcd)                + chr(4) +
     1955                           string(buf_shop.day-only)
     1956         .
     1957         run str/saleincl.p (
     1958                         input this-procedure
     1959                        ,input this-procedure
     1960                        ,input this-procedure
     1961                        ,input v-parameter
     1962                        )  no-error.
     1963         if error-status:error
     1964         and return-value <> "error"
     1965         then do:
     1966           run write-to-log in this-procedure (
     1967                 input substitute( "!!!Ошибка при закачке чеков в документ продажи &1 в &2&3&4" +
     1968                                   "&5 &6"
     1969                                 , buf_inkas.inkas-code
     1970                                 , p-curr-obj-type
     1971                                 , p-curr-obj-code
     1972                                 , chr(10)
     1973                                 , error-status:get-message(1)
     1974                                 , return-value
     1975                                 )            ).
     1976            next _inkas.
     1977         end.
     1978       end.
     1979     end.
     1980   end procedure.
     1981   procedure proc-step-200 :
     1982   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     1983   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     1984   define input parameter p-process-only-new as logical no-undo .
     1985   define input parameter p-finalize         as logical no-undo .
     1986   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
     1987   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
     1988   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
     1989   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
     1990   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
     1991   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
     1992   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
     1993   define variable neg-tpsi-weight as logical no-undo .
     1994   define variable neg-tpsi-oper as logical no-undo .
     1995   define variable neg-tpsi-qnty as decimal no-undo .
     1996   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO.
     1997   define variable v-parameter as character no-undo .
     1998   define variable v-param-type as character no-undo .
     1999   define variable v-value-character as character no-undo .
     2000   define variable v-value-date as date no-undo .
     2001   define variable v-value-decimal as decimal no-undo .
     2002   define variable v-value-integer as INTEGER no-undo .
     2003   define variable v-value-logical AS LOGICAL no-undo .
     2004   define variable v-tth as handle no-undo .
     2005   assign
     2006   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2007   DEFINE BUFFER buf_shop FOR ub.shop.
     2008   define buffer buf_inkas for ub.inkas.
     2009   define buffer buf_trn-doc for ub.trn-doc.
     2010     do
     2011     on error undo, return error
     2012     :
     2013      FIND FIRST buf_shop NO-LOCK WHERE
     2014                buf_shop.obj-code = p-curr-obj-code.
     2015      run gbl/tpsi-obj.p (
     2016                     input p-curr-obj-type
     2017                   , input p-curr-obj-code
     2018                   , output v-is-tpsi-obj) no-error .
     2019     for each thbjattr_thbj-attr:
     2020       delete thbjattr_thbj-attr.
     2021     end.
     2022     run adm/shattri.p (
     2023         input "get":U
     2024         ,input  p-curr-obj-type
     2025         ,input  p-curr-obj-code
     2026         ,input  'autosale':U
     2027         ,input  "":U
     2028         ,output v-value-character
     2029         ,output v-value-date
     2030         ,output v-value-decimal
     2031         ,output v-value-integer
     2032         ,output v-value-logical
     2033         ,output v-param-type
     2034         ,INPUT-OUTPUT table-handle v-tth
     2035         ) no-error .
     2036     IF error-status:error then do:
     2037       run write-to-log in this-procedure (
     2038             input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     2039               , p-curr-obj-type
     2040               , p-curr-obj-code
     2041               , chr(10)
     2042               , error-status:get-message(1)
     2043               , return-value )).
     2044         undo, return.
     2045     end.
     2046     for each  thbjattr_thbj-attr where
     2047               thbjattr_thbj-attr.obj-type = p-curr-obj-type
     2048           and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     2049           and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     2050     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     2051       case thbjattr_thbj-attr.prop-code:
     2052         when 'autofbr':U then do:
     2053           autofbr = thbjattr_thbj-attr.property-value-logical.
     2054         end.
     2055         when 'one-curs':U then do:
     2056           one-curs = thbjattr_thbj-attr.property-value-logical.
     2057         end.
     2058         when 'restdish':U then do:
     2059           restdish = thbjattr_thbj-attr.property-value-logical.
     2060         end.
     2061         when 'restingr':U then do:
     2062           restingr = thbjattr_thbj-attr.property-value-logical.
     2063         end.
     2064         when 'resttpsi':U then do:
     2065           resttpsi = thbjattr_thbj-attr.property-value-logical.
     2066         end.
     2067         when 'neg-tpsi-weight':U then do:
     2068           neg-tpsi-weight = thbjattr_thbj-attr.property-value-logical.
     2069         end.
     2070         when 'neg-tpsi-qnty':U then do:
     2071           neg-tpsi-qnty = thbjattr_thbj-attr.property-value-decimal.
     2072         end.
     2073         when 'neg-tpsi-oper':U then do:
     2074           neg-tpsi-oper = thbjattr_thbj-attr.property-value-logical.
     2075         end.
     2076       end case.
     2077       assign
     2078       restdish = restdish and autofbr
     2079       restingr = restingr and autofbr
     2080       resttpsi = resttpsi and v-is-tpsi-obj
     2081       .
     2082     end.
     2083       _inkas:
     2084       for each buf_inkas where
     2085               buf_Inkas.obj-type = p-curr-obj-type
     2086           AND buf_Inkas.obj-code = p-curr-obj-code
     2087           AND buf_Inkas.status_ = 'новый':U,
     2088           first buf_trn-doc where
     2089                 buf_trn-doc.doc-code = buf_inkas.inkas-code:
     2090         if p-process-only-new then do:
     2091           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     2092           if not available temp-inkas then next _inkas.
     2093         end.
     2094         assign
     2095         v-parameter =   v-curr-r-b                       + chr(4) +
     2096                         buf_inkas.inkas-code             + chr(4) +
     2097                         string(if p-finalize then 3 else 2)
     2098                                                          + chr(4) +
     2099                         string(autofbr)                  + chr(4) +
     2100                         string(buf_shop.is-catering)     + chr(4) +
     2101                         string(v-is-tpsi-obj)            + chr(4) +
     2102                         string(restdish)                 + chr(4) +
     2103                         string(restingr)                 + chr(4) +
     2104                         string(resttpsi)                 + chr(4) +
     2105                         string(neg-tpsi-weight)          + chr(4) +
     2106                         string(neg-tpsi-qnty)            + chr(4) +
     2107                         string(neg-tpsi-oper)
     2108         .
     2109   .
     2110         run str/salersrv.p (
     2111                         input this-procedure
     2112                        ,input this-procedure
     2113                        ,input this-procedure
     2114                        ,input v-parameter
     2115                        )  no-error.
     2116         if error-status:error
     2117         and return-value <> "error"
     2118         then do:
     2119           run write-to-log in this-procedure (
     2120                 input substitute( "!!!Ошибка при резервировании в документе продажи &1 в &2&3&4" +
     2121                                   "&5 &6"
     2122                                 , buf_inkas.inkas-code
     2123                                 , p-curr-obj-type
     2124                                 , p-curr-obj-code
     2125                                 , chr(10)
     2126                                 , error-status:get-message(1)
     2127                                 , return-value
     2128                                 )            ).
     2129            next _inkas.
     2130         end.
     2131       end.
     2132     end.
     2133   end procedure.
     2134   procedure proc-step-300 :
     2135   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     2136   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     2137   define input parameter p-process-only-new as logical no-undo .
     2138   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
