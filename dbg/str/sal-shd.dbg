        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-cre-db-num  as character    no-undo.
        4   define input parameter p-task-type   as character    no-undo.
        5   define input parameter p-task-num    as integer      no-undo.
        6   define input parameter p-db-num      as integer      no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Обработка документов продаж по расписанию".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define  shared variable g#auto-pid           as integer   no-undo .
       84   define  shared variable conn-par             as character no-undo .
       85   define  shared variable g#auto-user-id       as character no-undo .
       86   define  shared variable g#auto-user-login    as character no-undo .
       87   define  shared variable g#auto-user-password as character no-undo .
       88   define  shared variable v-socket             as logical   no-undo .
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  shared variable auto-window-h     as handle    no-undo .
       91   define  shared variable auto-log-msg-h    as handle    no-undo .
       92   define  shared variable hand-log-msg-h    as handle    no-undo .
       93   define  shared variable log-file-name     as character no-undo initial ? .
       94   define  shared variable add-log-file-name as character no-undo initial ? .
       95   define  shared variable writelogvalue     as character no-undo initial ? .
       96   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure cur-time :
       98      define output parameter p-today as date      no-undo .
       99      define output parameter p-time  as integer   no-undo .
      100     do
      101     on error undo, return error
      102     :
      103       define variable v-date1 as date      no-undo .
      104       define variable v-date2 as date      no-undo .
      105       define variable v-time  as integer   no-undo .
      106       assign
      107         v-date1 = today
      108         v-time  = time
      109         v-date2 = today
      110       .
      111       if v-date1 <> v-date2
      112       then do:
      113         assign
      114           v-date1 = today
      115           v-time  = v-time
      116         .
      117       end.
      118       assign
      119         p-today = v-date1
      120         p-time  = v-time
      121       .
      122     end.
      123   end.
      124   function cur-time-date returns character
      125   :
      126     return string(today, '99/99/9999':U) .
      127   end.
      128   function cur-time-mjd returns decimal
      129   :
      130     define variable v-date as date      no-undo .
      131     define variable v-time as integer   no-undo .
      132     run cur-time in this-procedure
      133       (output v-date
      134       ,output v-time
      135       ) .
      136     return integer(v-date) - 2400002 + (v-time / 86400) .
      137   end.
      138   function cur-time-get-ending-index returns integer
      139   (input p-number as integer
      140   )
      141   :
      142     if p-number < 0
      143     or p-number = ?
      144     then do:
      145       return 1 .
      146     end.
      147     define variable v-rest as integer   no-undo .
      148     assign
      149       p-number = p-number modulo 100
      150     .
      151     if p-number < 20
      152     then do:
      153       assign
      154         v-rest = p-number
      155       .
      156     end.
      157     else do:
      158       assign
      159         v-rest = p-number modulo 10
      160       .
      161     end.
      162     case v-rest :
      163       when 1
      164       then do:
      165         return 2 .
      166       end.
      167       when 2 or
      168       when 3 or
      169       when 4
      170       then do:
      171         return 3 .
      172       end.
      173       otherwise do:
      174         return 1 .
      175       end.
      176     end case .
      177   end.
      178   procedure cur-time-mjd-to-date :
      179      define input  parameter i-mjd-diff as decimal no-undo.
      180      define output parameter o-Date     as date    no-undo.
      181      define output parameter o-Time     as integer no-undo.
      182      define variable v-day-number as integer   no-undo .
      183      if    i-mjd-diff < 0
      184         or i-mjd-diff = ?
      185      then do:
      186         return "?" .
      187      end.
      188      assign
      189         v-day-number = truncate(i-mjd-diff,0).
      190         o-Date = date(v-day-number + 2400002).
      191         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193   end.
      194   function cur-time-mjd-to-string returns character
      195   (input p-mjd-diff as decimal
      196   )
      197   :
      198     define variable v-day-number as integer   no-undo .
      199     define variable v-seconds    as integer   no-undo .
      200     define variable v-hour       as integer   no-undo .
      201     define variable v-min        as integer   no-undo .
      202     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      203     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      204     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      205     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      206     if p-mjd-diff < 0
      207     or p-mjd-diff = ?
      208     then do:
      209       return "?" .
      210     end.
      211     assign
      212       v-day-number = integer(truncate(p-mjd-diff,0))
      213       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215     if v-seconds > 86400
      216     then do:
      217       assign
      218         v-seconds = 86400 - 1
      219       .
      220     end.
      221     if v-seconds < 0
      222     then do:
      223       assign
      224         v-seconds = 0
      225       .
      226     end.
      227     assign
      228       v-hour = truncate(v-seconds / 3600, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 3600
      232     .
      233     assign
      234       v-min = truncate(v-seconds / 60, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 60
      238     .
      239     return
      240         (if v-day-number <> 0
      241           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0
      245           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      249           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      250           else ""
      251         )
      252       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      253       .
      254   end.
      255   function cur-time-string returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      264   end.
      265   function cur-time-string-sec returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      274   end.
      275   function cur-time-custom  returns character
      276   (input p-prefix as character
      277   ,input p-date-format as character
      278   ,input p-delimiter as character
      279   ,input p-time-format as character
      280   ,input p-suffix as character
      281   )
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return
      290       p-prefix
      291       + string(v-date, p-date-format)
      292       + p-delimiter
      293       + string(v-time, p-time-format)
      294       + p-suffix
      295       .
      296   end.
      297   function cur-time-print  returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-datetime returns datetime
      308   :
      309     define variable v-char as character no-undo .
      310     define variable v-datetime as datetime no-undo .
      311     v-char = cur-time-string().
      312     v-datetime = datetime(v-char).
      313     return  v-datetime.
      314   end.
      315   function cur-time-string-msec returns character
      316   :
      317     define variable v-date as datetime  no-undo .
      318     v-date = now.
      319     return string(v-date) .
      320   end.
      321   define stream LogStream .
      322   define variable mNoTime as logical no-undo.
      323   procedure write-to-log-notime :
      324     define input param i-str as character no-undo .
      325     mNoTime = yes.
      326     run write-to-log (i-str).
      327     mNoTime = no.
      328   end.
      329   procedure write-to-log :
      330     define input param p-str as character no-undo .
      331     do
      332     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      333     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      334     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      335     :
      336       define variable log-res        as logical   no-undo .
      337       define variable v-jj           as integer   no-undo .
      338       if    mNoTime
      339          or writelogvalue eq "AsyncProc"
      340       then
      341          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      342       else
      343          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      344       if auto-log-msg-h <> ? then do:
      345         log-res = auto-log-msg-h:move-to-eof( ) .
      346         log-res = auto-log-msg-h:insert-string( p-str ).
      347       end.
      348       if hand-log-msg-h <> ? then do:
      349         log-res = hand-log-msg-h:move-to-eof( ) .
      350         log-res = hand-log-msg-h:insert-string( p-str ).
      351       end.
      352       assign
      353         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      354         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      355         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      356       .
      357       if add-log-file-name <> ? then do:
      358         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      359           run gbl/fileapnd.p
      360             ( input entry(v-jj, add-log-file-name, chr(1) )
      361             ,input p-str
      362             ,input 20
      363             ) no-error .
      364           if error-status:error then do:
      365             return error return-value .
      366           end.
      367         end.
      368       end.
      369       if writelogvalue eq "AsyncProc"
      370       then do:
      371          p-str = trim(p-str, (chr(13) + chr(10)) )
      372       .
      373          Publish "WriteLogAsunc" (p-str,yes).
      374       end.
      375       else if writelogvalue <> "yes" then do:
      376         run gbl/fileapnd.p
      377           ( input log-file-name
      378           ,input p-str
      379           ,input 20
      380           ) no-error .
      381         if error-status:error then do:
      382           return error return-value .
      383         end.
      384       end.
      385     end.
      386   end procedure.
      387   procedure write-to-screen :
      388     define input param p-str as character no-undo .
      389     do
      390     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      391     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      392     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      393     :
      394       define variable log-res as logical no-undo.
      395       assign
      396         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      397       .
      398       if auto-log-msg-h <> ?
      399       then do:
      400         log-res = auto-log-msg-h:move-to-eof( ) .
      401         log-res = auto-log-msg-h:insert-string( p-str ).
      402       end.
      403       if hand-log-msg-h <> ?
      404       then do:
      405         log-res = hand-log-msg-h:move-to-eof( ) .
      406         log-res = hand-log-msg-h:insert-string( p-str ).
      407       end.
      408     end.
      409   end procedure.
      410   procedure send-msg-to-email :
      411     define input  parameter p-subject      as character no-undo .
      412     define input  parameter p-text-err     as character no-undo .
      413     define input  parameter p-attach-files as character no-undo .
      414     do
      415     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      416     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      417     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      418     :
      419       define variable v-tth             as handle    no-undo .
      420       define variable v-value-character as character no-undo .
      421       define variable v-value-date      as date      no-undo .
      422       define variable v-value-decimal   as decimal   no-undo .
      423       define variable v-value-integer   as integer   no-undo .
      424       define variable v-value-logical   as logical   no-undo .
      425       define variable v-param-type      as character no-undo .
      426       define variable v-email       as character no-undo .
      427       define variable v-tmp-str     as character no-undo .
      428       define variable v-tmp1-str    as character no-undo .
      429       define variable v-ind         as integer   no-undo .
      430       define variable v-num-entries as integer   no-undo .
      431       delete object v-tth no-error.
      432       run adm/shattri.p
      433         ( input "get":U
      434          ,input  "":U
      435          ,input  0
      436          ,input  'auto-task':U
      437          ,input  'send-msg-to-email':U
      438          ,output v-value-character
      439          ,output v-value-date
      440          ,output v-value-decimal
      441          ,output v-value-integer
      442          ,output v-value-logical
      443          ,output v-param-type
      444          ,input-output table-handle v-tth
      445         ) no-error .
      446       if not error-status :error  then do:
      447         assign
      448           v-tmp-str = v-value-character
      449         .
      450       end.
      451       delete object v-tth no-error.
      452       assign
      453         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      454         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      455         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      456         v-num-entries = num-entries( v-tmp-str, chr(44) )
      457         v-email       = "":U
      458       .
      459       do v-ind = 1 to v-num-entries
      460       :
      461         assign
      462           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      463         .
      464         if trim( v-tmp1-str ) <> "":U then do:
      465           if v-email = "":U then do:
      466             assign
      467               v-email = v-tmp1-str
      468             .
      469           end.
      470           else do:
      471             assign
      472               v-email = v-email + chr(44) + v-tmp1-str
      473             .
      474           end.
      475         end.
      476       end.
      477       if v-email <> "":U then do:
      478         run gbl/sendmail.p
      479           ( input v-email
      480           , input p-subject
      481           , input p-text-err
      482           , input p-attach-files
      483           ) no-error .
      484         if error-status :error
      485           or return-value <> "":U
      486         then do:
      487           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      488         end.
      489       end.
      490     end.
      491   end procedure.
      492   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   define temp-table temp-schedule-free no-undo
      494   field free-id as character
      495   field free-task-name as character
      496   field proc-run-name as character
      497   field proc-param-edit-name as character
      498   field conf-param as character
      499   field is-gbd as logical
      500   field is-ubd as logical
      501   field enable-concurrent-0 as logical
      502   field enable-concurrent-db as logical
      503   field other-info as character
      504   field enc-key as character
      505   field is-rum as logical
      506   index pi is unique primary
      507   free-id.
      508   procedure schedule-attr-name :
      509   do
      510     on error undo, return error
      511     :
      512     define input  parameter p-code           as character no-undo .
      513     define output parameter p-type           as character no-undo .
      514     define output parameter p-format         as character no-undo .
      515     define output parameter p-label          as character no-undo .
      516     define output parameter p-user-can-edit  as logical   no-undo .
      517     define output parameter p-output-display as logical   no-undo .
      518     define output parameter p-other          as character no-undo .
      519       if index(p-code, chr(4)) > 0 then do:
      520         p-code = entry(1, p-code, chr(4)).
      521       end.
      522       case p-code :
      523               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      524               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      525               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      526               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      527               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      528               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      529               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      530               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      531               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      532         otherwise do:
      533           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      534         end.
      535       end.
      536     end.
      537   end procedure.
      538   procedure schedule-attr-tooltip :
      539   do
      540     on error undo, return error
      541     :
      542       define input  parameter p-code    as character no-undo .
      543       define output parameter p-tooltip as character no-undo .
      544       define output parameter p-label   as character no-undo .
      545       if index(p-code, chr(4)) > 0 then do:
      546         p-code = entry(1, p-code, chr(4)).
      547       end.
      548       case p-code :
      549               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      550               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      551               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      552               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      553               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      554               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      555               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      556               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      557               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      558         otherwise do:
      559               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      560         end.
      561       end.
      562     end.
      563   end procedure.
      564   procedure schedule-attr-value :
      565   do
      566   on error undo, return error return-value
      567   :
      568   define input parameter  p-cre-db-num as integer    no-undo.
      569   define input parameter  p-task-type  as character  no-undo.
      570   define input parameter  p-task-num   as integer    no-undo.
      571   define input parameter  p-code       as character  no-undo.
      572   define output parameter p-value      as character  no-undo.
      573   define output parameter p-type       as character  no-undo.
      574       define variable v-format         as character no-undo .
      575       define variable v-label          as character no-undo .
      576       define variable v-user-can-edit  as logical   no-undo .
      577       define variable v-output-display as logical   no-undo .
      578       define variable v-other          as character no-undo .
      579       define buffer buf_schedule-attr for ub.schedule-attr.
      580       run schedule-attr-name in this-procedure (
      581             input  p-code
      582           , output p-type
      583           , output v-format
      584           , output v-label
      585           , output v-user-can-edit
      586           , output v-output-display
      587           , output v-other
      588       ) no-error .
      589       if error-status :error
      590       then do:
      591           undo, return error return-value .
      592       end.
      593       if p-code begins ('schd-free-id':U + chr(4))
      594       and entry(2, p-code, chr(4)) = '':U then do:
      595         find first buf_schedule-attr no-lock
      596             where buf_schedule-attr.cre-db-num = p-cre-db-num
      597               and buf_schedule-attr.task-type  = p-task-type
      598               and buf_schedule-attr.task-num   = p-task-num
      599               and buf_schedule-attr.attr-code  begins p-code
      600         no-error .
      601       end.
      602       else do:
      603         find first buf_schedule-attr no-lock
      604             where buf_schedule-attr.cre-db-num = p-cre-db-num
      605               and buf_schedule-attr.task-type  = p-task-type
      606               and buf_schedule-attr.task-num   = p-task-num
      607               and buf_schedule-attr.attr-code  = p-code
      608         no-error .
      609       end.
      610       if available buf_schedule-attr
      611       then do:
      612           assign
      613               p-value = buf_schedule-attr.attr-value
      614           .
      615       end.
      616       else do:
      617         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      618            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      619         end.
      620         else do:
      621           assign
      622               p-value = if p-type = 'L':U then "no":U else ""
      623           .
      624         end.
      625       end.
      626   end.
      627   end procedure.
      628   procedure schedule-attr-write :
      629   do
      630   on error undo, return error
      631   :
      632   define input parameter p-cre-db-num  as integer   no-undo.
      633   define input parameter p-task-type   as character no-undo.
      634   define input parameter p-task-num    as integer   no-undo.
      635   define input parameter p-code        as character no-undo.
      636   define input parameter p-value       as character no-undo.
      637       define variable v-type              as character                no-undo.
      638       define variable v-format            as character                no-undo.
      639       define variable v-label             as character                no-undo.
      640       define variable v-user-can-edit     as logical                  no-undo.
      641       define variable v-output-display    as logical                  no-undo.
      642       define variable v-other             as character                no-undo.
      643       define buffer buf_schedule-attr for ub.schedule-attr .
      644       run schedule-attr-name in this-procedure (
      645             input  p-code
      646           , output v-type
      647           , output v-format
      648           , output v-label
      649           , output v-user-can-edit
      650           , output v-output-display
      651           , output v-other
      652       ) no-error.
      653       if error-status :error
      654       then do:
      655           undo, return error return-value.
      656       end.
      657       find first buf_schedule-attr exclusive-lock
      658            where buf_schedule-attr.cre-db-num = p-cre-db-num
      659              and buf_schedule-attr.task-type  = p-task-type
      660              and buf_schedule-attr.task-num   = p-task-num
      661              and buf_schedule-attr.attr-code  = p-code
      662       no-error.
      663       if not available buf_schedule-attr
      664       then do:
      665           create buf_schedule-attr.
      666           assign
      667             buf_schedule-attr.cre-db-num = p-cre-db-num
      668             buf_schedule-attr.task-type  = p-task-type
      669             buf_schedule-attr.task-num   = p-task-num
      670             buf_schedule-attr.attr-code  = p-code
      671             buf_schedule-attr.attr-value = p-value
      672           .
      673       end.
      674       else do:
      675           assign
      676               buf_schedule-attr.attr-value = p-value
      677           .
      678       end.
      679   end.
      680   end procedure.
      681   procedure schedule-attr-delete :
      682   do
      683   on error undo, return error
      684   :
      685   define input  parameter p-cre-db-num  as integer   no-undo.
      686   define input  parameter p-task-type   as character no-undo.
      687   define input  parameter p-task-num    as integer   no-undo.
      688   define input  parameter p-code        as character no-undo.
      689   define output parameter p-deleted     as logical   no-undo.
      690       define buffer buf_schedule-attr for ub.schedule-attr .
      691       define variable v-type              as character                no-undo.
      692       define variable v-format            as character                no-undo.
      693       define variable v-label             as character                no-undo.
      694       define variable v-user-can-edit     as logical                  no-undo.
      695       define variable v-output-display    as logical                  no-undo.
      696       define variable v-other             as character                no-undo.
      697       run schedule-attr-name in this-procedure (
      698             input p-code
      699           , output v-type
      700           , output v-format
      701           , output v-label
      702           , output v-user-can-edit
      703           , output v-output-display
      704           , output v-other
      705       ) no-error .
      706       if error-status :error
      707       then do:
      708           undo, return error return-value .
      709       end.
      710       find first buf_schedule-attr exclusive-lock
      711            where buf_schedule-attr.cre-db-num = p-cre-db-num
      712              and buf_schedule-attr.task-type  = p-task-type
      713              and buf_schedule-attr.task-num   = p-task-num
      714              and buf_schedule-attr.attr-code  = p-code
      715       no-error.
      716       if not available buf_schedule-attr
      717       then do:
      718           assign
      719               p-deleted = no
      720           .
      721       end.
      722       else do:
      723           delete buf_schedule-attr.
      724           assign
      725               p-deleted = yes
      726           .
      727       end.
      728   end.
      729   end procedure.
      730   procedure schedule-attr-news :
      731   do
      732   on error undo, return error
      733   :
      734       define input  parameter p-code           as character no-undo .
      735       define output parameter p-news           as logical   no-undo .
      736       if index(p-code, chr(4)) > 0 then do:
      737         p-code = entry(1, p-code, chr(4)).
      738       end.
      739       case p-code :
      740               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      741               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      742               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      743               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      744               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      745               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      746               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      747               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      748               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      749         otherwise do:
      750           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      751         end.
      752       end.
      753   end.
      754   end procedure.
      755   procedure schedule-attr-extract-logical :
      756   do
      757   on error undo, return error
      758   :
      759   define input  parameter p-parameter-number   as integer      no-undo.
      760   define input  parameter p-parameter-list     as character    no-undo.
      761   define output parameter p-parameter-value   as logical      no-undo.
      762       if num-entries( p-parameter-list ) > p-parameter-number - 1
      763       then do:
      764           assign
      765               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      766           .
      767       end.
      768       else do:
      769           assign
      770               p-parameter-value   = no
      771           .
      772       end.
      773   end.
      774   end procedure.
      775   procedure schedule-attr-get-free-id :
      776   do
      777   on error undo, return error return-value
      778   :
      779     define input  parameter p-cre-db-num  as integer   no-undo.
      780     define input  parameter p-task-type   as character no-undo.
      781     define input  parameter p-task-num    as integer   no-undo.
      782     define output parameter p-free-id     as character no-undo.
      783     define buffer buf_schedule-attr for ub.schedule-attr.
      784     find first buf_schedule-attr no-lock
      785         where buf_schedule-attr.cre-db-num = p-cre-db-num
      786           and buf_schedule-attr.task-type  = p-task-type
      787           and buf_schedule-attr.task-num   = p-task-num
      788           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      789     no-error .
      790     if available buf_schedule-attr then
      791     assign
      792     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      793     no-error
      794     .
      795   end.
      796   end procedure.
      797   procedure schedule-attr-get-free-props :
      798     define input parameter p-free-id as character no-undo .
      799     define output parameter p-value as character no-undo .
      800     define buffer buf_temp-schedule-free for temp-schedule-free.
      801     do
      802     on error undo, return error return-value
      803     :
      804       find first buf_temp-schedule-free no-lock no-error .
      805       if not available buf_temp-schedule-free then do:
      806         run schedule-attr-fill-free-props in this-procedure .
      807       end.
      808       find first buf_temp-schedule-free where
      809               buf_temp-schedule-free.free-id = p-free-id no-error.
      810       if available buf_temp-schedule-free then do:
      811         assign
      812         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      813                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      814                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      815                   buf_temp-schedule-free.conf-param           + chr(4) +
      816                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      817                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      818                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      819                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      820                   buf_temp-schedule-free.other-info
      821         .
      822       end.
      823       else do:
      824        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      825                              "id произвольной задачи - &5"
      826                              ,vss-workfile
      827                              ,vss-revision
      828                              ,vss-description
      829                              ,chr(10)
      830                              ,p-free-id).
      831       end.
      832     end.
      833   end procedure.
      834   procedure schedule-attr-is-rum-free-id :
      835   define input parameter p-free-id as character no-undo .
      836   define output parameter p-is-rum as logical no-undo .
      837   define buffer buf_temp-schedule-free for temp-schedule-free.
      838   do
      839   on error undo, return error
      840   :
      841       find first buf_temp-schedule-free no-lock no-error .
      842       if not available buf_temp-schedule-free then do:
      843         run schedule-attr-fill-free-props in this-procedure .
      844       end.
      845       find first buf_temp-schedule-free where
      846               buf_temp-schedule-free.free-id = p-free-id no-error.
      847       if available buf_temp-schedule-free
      848       and buf_temp-schedule-free.is-rum
      849       then do:
      850         p-is-rum = yes.
      851       end.
      852   end.
      853   end procedure.
      854   procedure schedule-attr-fill-free-props :
      855   define variable v-path                    as character                no-undo .
      856   DEFINE VARIABLE v-full-path               as character                no-undo .
      857   DEFINE VARIABLE v-file-name               as character                no-undo .
      858   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      859   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      860   define buffer buf_temp-schedule-free for temp-schedule-free.
      861   define variable v-answer as logical no-undo .
      862     do
      863     on error undo, return error substitute("&1 &2 &3&4&5&4"
      864                                           ,vss-workfile
      865                                           ,vss-revision
      866                                           ,vss-description
      867                                           ,chr(10)
      868                                           ,error-status:get-message(1) )
      869     :
      870       run gbl/filename.p (
      871                       input 'cmp/shd-free.d'
      872                     ,output v-full-path
      873                     ,output v-path
      874                     ,output v-file-name
      875                     ,output v-file-name-no-ext
      876                     ,output v-file-name-ext
      877                     ) .
      878       input from value(v-full-path).
      879       repeat :
      880         create buf_temp-schedule-free.
      881         import buf_temp-schedule-free.
      882       END.
      883       input close.
      884       _ff:
      885       for each buf_temp-schedule-free :
      886         if buf_temp-schedule-free.free-id = '':U then do:
      887            delete buf_temp-schedule-free.
      888            next _ff.
      889          end.
      890          run schedule-attr-check-enc in this-procedure (
      891                                                       input  buf_temp-schedule-free.free-id
      892                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      893                                                               buf_temp-schedule-free.proc-param-edit-name +
      894                                                               buf_temp-schedule-free.conf-param +
      895                                                               string(buf_temp-schedule-free.is-gbd) +
      896                                                               string(buf_temp-schedule-free.is-ubd) +
      897                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      898                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      899                                                               string(buf_temp-schedule-free.other-info)
      900                                                               )
      901                                                       ,input  buf_temp-schedule-free.enc-key
      902                                                       ,output v-answer    ) no-error .
      903          if error-status:error
      904          or not v-answer then delete buf_temp-schedule-free.
      905        end.
      906     end.
      907   end procedure.
      908   Function schedule-attr-reverse returns character (str as character).
      909      define variable rev_incl_s as character init "" no-undo .
      910      define variable rev_incl_i as integer no-undo .
      911      define variable rev_incl_l as integer no-undo .
      912      rev_incl_l = length(str).
      913      do rev_incl_i = 1 to rev_incl_l:
      914         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      915      end.
      916      return rev_incl_s.
      917   end.
      918   procedure schedule-attr-check-enc.
      919     define input  parameter p-free-id   as character no-undo .
      920     define input  parameter p-value     as character no-undo .
      921     define input  parameter p-enc-value as character no-undo .
      922     define output parameter p-answer    as logical   no-undo .
      923     define variable tmp         as character no-undo .
      924     define variable v-enc-value as character no-undo .
      925     assign
      926     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      927     .
      928     run schedule-attr-pswd-enc in this-procedure
      929       ( input tmp
      930        ,output v-enc-value
      931       ) no-error .
      932     if error-status:error then do:
      933       message
      934         vss-workfile vss-revision vss-description skip
      935         "Ошибка при вызове процедуры pswd-enc" skip
      936         return-value skip
      937         error-status :get-message(1) skip
      938         view-as alert-box error .
      939       undo, return error .
      940     end.
      941     if v-enc-value = p-enc-value then do:
      942       assign
      943         p-answer = true
      944       .
      945     end.
      946     else do:
      947       assign
      948         p-answer = false
      949       .
      950     end.
      951   end.
      952   procedure schedule-attr-conf-enc.
      953     define input  parameter p-free-id   as character no-undo .
      954     define input  parameter p-value     as character no-undo .
      955     define output parameter p-enc-value as character no-undo .
      956     define variable tmp         as character no-undo .
      957     assign
      958       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      959     .
      960     run schedule-attr-pswd-enc in this-procedure
      961       ( input tmp
      962        ,output p-enc-value
      963       ) no-error .
      964     if error-status:error then do:
      965       message
      966         vss-workfile vss-revision vss-description skip
      967         "Ошибка при вызове процедуры pswd-enc" skip
      968         return-value skip
      969         error-status :get-message(1) skip
      970         view-as alert-box error .
      971       undo, return error .
      972     end.
      973   end procedure.
      974   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   procedure schedule-attr-pswd-enc :
      976     define input parameter  pswd     as character no-undo .
      977     define output parameter enc-pswd as character no-undo .
      978     do
      979     on error undo, return error return-value
      980     :
      981       assign
      982         enc-pswd = encode(pswd + string(index(pswd, "k")))
      983       .
      984     end.
      985   end procedure.
      986   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   define  temp-table temp-host no-undo
      988     field host-code like ub.store.host-code
      989     index xpk host-code
      990   .
      991   define  temp-table temp-obj no-undo
      992     field obj-type  like ub.clients.obj-type
      993     field obj-code  like ub.clients.obj-code
      994     field host-code like ub.store.host-code
      995     field db-num    like ub.clients.db-num
      996     index xpk  obj-type obj-code
      997     index xie1 host-code
      998     index xie2 db-num host-code
      999   .
     1000   procedure init-temphost:
     1001     define buffer buf_store   for ub.store .
     1002     define buffer buf_shop    for ub.shop .
     1003     define buffer buf_clients for ub.clients .
     1004     define buffer buf_db for ub.db .
     1005     define buffer buf_temp-host for temp-host .
     1006     define buffer buf_temp-obj for temp-obj .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       for each buf_store
     1011       on error undo, return error
     1012       :
     1013         find first buf_temp-host
     1014           where buf_temp-host.host-code = buf_store.host-code
     1015           no-error .
     1016         if not available buf_temp-host
     1017         then do:
     1018           create buf_temp-host .
     1019           assign
     1020             buf_temp-host.host-code = buf_store.host-code
     1021           .
     1022         end.
     1023         find first buf_clients no-lock
     1024           where buf_clients.obj-type = 'скл':U
     1025             and buf_clients.obj-code = buf_store.obj-code
     1026           no-error .
     1027         if not available buf_clients
     1028         then do:
     1029           message
     1030             "Ошибка при поиске клиента" skip
     1031             "Клиент" 'скл':U buf_store.obj-code skip
     1032             view-as alert-box error .
     1033           undo, return error .
     1034         end.
     1035         create buf_temp-obj .
     1036         assign
     1037           buf_temp-obj.obj-type  = 'скл':U
     1038           buf_temp-obj.obj-code  = buf_store.obj-code
     1039           buf_temp-obj.host-code = buf_store.host-code
     1040           buf_temp-obj.db-num    = buf_clients.db-num
     1041         .
     1042       end.
     1043       for each buf_shop
     1044       on error undo, return error
     1045       :
     1046         find first buf_temp-host
     1047           where buf_temp-host.host-code = buf_shop.host-code
     1048           no-error .
     1049         if not available buf_temp-host
     1050         then do:
     1051           create buf_temp-host .
     1052           assign
     1053             buf_temp-host.host-code = buf_shop.host-code
     1054           .
     1055         end.
     1056         find first buf_clients no-lock
     1057           where buf_clients.obj-type = 'маг':U
     1058             and buf_clients.obj-code = buf_shop.obj-code
     1059           no-error .
     1060         if not available buf_clients then do:
     1061           message
     1062             "Ошибка при поиске клиента" skip
     1063             "Клиент" 'маг':U buf_shop.obj-code skip
     1064             view-as alert-box error .
     1065           undo, return error .
     1066         end.
     1067         create buf_temp-obj .
     1068         assign
     1069           buf_temp-obj.obj-type  = 'маг':U
     1070           buf_temp-obj.obj-code  = buf_shop.obj-code
     1071           buf_temp-obj.host-code = buf_shop.host-code
     1072           buf_temp-obj.db-num    = buf_clients.db-num
     1073         .
     1074       end.
     1075     end.
     1076   end.
     1077   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   define variable v-loc-counter as integer no-undo .
     1079   define variable v-counter-visible as logical no-undo .
     1080   define variable v-view-log as logical no-undo .
     1081   define stream auto2dia.
     1082   PROCEDURE write-log-and-file :
     1083   do
     1084   on error undo, return error
     1085   :
     1086     define input parameter p-tab-position   as integer   no-undo.
     1087     define input parameter p-file-name      as character no-undo .
     1088     define input parameter p-log-level      as integer   no-undo .
     1089     define input parameter p-log-string     AS CHARacter NO-UNDO.
     1090     define variable v-jj as integer   no-undo .
     1091     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
     1092     if p-file-name <> '':U then do:
     1093       do v-jj = 1 to num-entries(p-file-name, chr(1)):
     1094         run  auto2dia-writefile in this-procedure (
     1095                                         input entry(v-jj, p-file-name, chr(1))
     1096                                         ,input p-log-level
     1097                                         ,input (p-log-string + chr(10))
     1098                                       ) no-error .
     1099       end.
     1100     end.
     1101     if writelogvalue eq "AsyncProc"
     1102     then
     1103        run write-to-log in this-procedure( p-log-string) .
     1104   end.
     1105   END PROCEDURE.
     1106   PROCEDURE get-title :
     1107   do
     1108   on error undo, return error
     1109   :
     1110   define output parameter p-title     as character    no-undo.
     1111   end.
     1112   END PROCEDURE.
     1113   PROCEDURE set-title :
     1114   do
     1115   on error undo, return error
     1116   :
     1117   define input parameter p-title     as character    no-undo.
     1118   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
     1119   end.
     1120   END PROCEDURE.
     1121   PROCEDURE get-counter-value :
     1122   do
     1123   on error undo, return error
     1124   :
     1125   define output parameter p-counter     as integer    no-undo.
     1126       assign
     1127       p-counter  = v-loc-counter
     1128       .
     1129   end.
     1130   END PROCEDURE.
     1131   PROCEDURE set-counter-value :
     1132   do
     1133   on error undo, return error
     1134   :
