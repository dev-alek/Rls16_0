     1161   END PROCEDURE.
     1162   PROCEDURE write-counter :
     1163   do
     1164   on error undo, return error
     1165   :
     1166   define input parameter p-counter-string     as character    no-undo.
     1167   if v-counter-visible then
     1168   run write-message in parparentproc ( input p-counter-string) .
     1169   process events.
     1170   end.
     1171   END PROCEDURE.
     1172   PROCEDURE get-stop-state :
     1173   do
     1174   on error undo, return error
     1175   :
     1176   define output parameter p-stop-state    as logical      no-undo.
     1177   end.
     1178   END PROCEDURE.
     1179   PROCEDURE set-view-log :
     1180   do
     1181   on error undo, return error
     1182   :
     1183   define input parameter p-view-log     as logical    no-undo.
     1184       assign
     1185       v-view-log = p-view-log
     1186       .
     1187   end.
     1188   END PROCEDURE.
     1189   PROCEDURE get-view-log :
     1190   do
     1191   on error undo, return error
     1192   :
     1193   define output parameter p-view-log     as logical    no-undo.
     1194       assign
     1195       p-view-log = v-view-log
     1196       .
     1197   end.
     1198   END PROCEDURE.
     1199   PROCEDURE write-log :
     1200   do
     1201   on error undo, return error
     1202   :
     1203   define input parameter p-tab-position   as integer      no-undo.
     1204   define input parameter p-log-string     as character    no-undo.
     1205   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
     1206                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
     1207                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1208                                       ELSE p-log-string))).
     1209   end.
     1210   END PROCEDURE.
     1211   procedure writelog :
     1212   do
     1213   on error undo, return error
     1214   :
     1215   define input parameter p-file-name AS CHAR     NO-UNDO.
     1216   define input parameter p-log-level AS INTEGER  NO-UNDO.
     1217   define input parameter p-log-string  AS CHAR     NO-UNDO.
     1218     if p-file-name <> "" then
     1219     run  auto2dia-Writefile in this-procedure (
     1220                                       input p-file-name
     1221                                     ,input p-log-level
     1222                                     ,input p-log-string
     1223                                   ) no-error .
     1224      process events.
     1225   end.
     1226   end procedure.
     1227   PROCEDURE auto2dia-writefile:
     1228     define input parameter sFileName AS CHAR     NO-UNDO.
     1229     define input parameter iLogLevel AS INTEGER  NO-UNDO.
     1230     define input parameter sToWrite  AS CHAR     NO-UNDO.
     1231     define variable v-SlashPos  as integer no-undo .
     1232     define variable v-lDirName  as character no-undo .
     1233     define variable v-lDirName2 as character no-undo .
     1234     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
     1235     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
     1236     FILE-INFO:FILE-NAME = v-lDirName .
     1237     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
     1238     if v-lDirName2 <> ? then do :
     1239   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
     1240       PUT STREAM auto2dia UNFORMATTED chr(10).
     1241       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1242                                         OR sToWrite = "&Line") THEN "" ELSE
     1243                                         cur-time-string-sec() + " ").
     1244       PUT STREAM auto2dia UNFORMATTED
     1245               (IF sToWrite = "&Line" THEN FILL("-", 80)
     1246                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1247                ELSE sToWrite).
     1248   OUTPUT STREAM auto2dia CLOSE.
     1249     end .
     1250   END PROCEDURE.
     1251   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     1253   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     1254     field cst-code                like ub.trn-doc.cst-code
     1255     field part-code               like ub.parts.part-code
     1256     .
     1257   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     1258   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     1259   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     1260   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   define new global shared variable g#trdcalib as handle no-undo.
     1262   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   define NEW SHARED temp-table tt0-info no-undo
     1264   field doc-code   like ub.trn-doc.doc-code
     1265   field artic      like ub.doc-line.artic
     1266   field prod-type  like ub.doc-line.prod-type
     1267   field prod-code  like ub.doc-line.prod-code
     1268   field prt-code  like ub.gds-dtl.prt-code
     1269   field obj-type   like ub.doc-line.obj-type
     1270   field obj-code   like ub.doc-line.obj-code
     1271   field error-message as character
     1272   field a-to-res as decimal
     1273   field was-res as decimal
     1274   field to-res as decimal
     1275   field is-res as decimal
     1276   field o-was-res as decimal
     1277   field o-to-res as decimal
     1278   field o-is-res as decimal
     1279   index pi is unique primary
     1280   obj-type
     1281   obj-code
     1282   artic
     1283   prod-type
     1284   prod-code
     1285   index iartic
     1286   artic
     1287   prod-type
     1288   prod-code
     1289   .
