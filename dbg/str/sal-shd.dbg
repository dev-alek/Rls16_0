     2174       run adm/shattri.p (
     2175           input "get":U
     2176           ,input  p-curr-obj-type
     2177           ,input  p-curr-obj-code
     2178           ,input  'autosale':U
     2179           ,input  "":U
     2180           ,output v-value-character
     2181           ,output v-value-date
     2182           ,output v-value-decimal
     2183           ,output v-value-integer
     2184           ,output v-value-logical
     2185           ,output v-param-type
     2186           ,INPUT-OUTPUT table-handle v-tth
     2187           ) no-error .
     2188       IF error-status:error then do:
     2189         run write-to-log in this-procedure (
     2190               input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     2191                 , p-curr-obj-type
     2192                 , p-curr-obj-code
     2193                 , chr(10)
     2194                 , error-status:get-message(1)
     2195                 , return-value )).
     2196          undo, return.
     2197       end.
     2198       for each  thbjattr_thbj-attr where
     2199                 thbjattr_thbj-attr.obj-type = p-curr-obj-type
     2200             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     2201             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     2202       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     2203         case thbjattr_thbj-attr.prop-code:
     2204           when 'autocomp':U then do:
     2205             auto-comp = thbjattr_thbj-attr.property-value-logical.
     2206           end.
     2207           when 'autofbr':U then do:
     2208             autofbr = thbjattr_thbj-attr.property-value-logical.
     2209           end.
     2210           when 'one-curs':U then do:
     2211             one-curs = thbjattr_thbj-attr.property-value-logical.
     2212           end.
     2213           when 'restdish':U then do:
     2214             restdish = thbjattr_thbj-attr.property-value-logical.
     2215           end.
     2216           when 'restingr':U then do:
     2217             restingr = thbjattr_thbj-attr.property-value-logical.
     2218           end.
     2219           when 'resttpsi':U then do:
     2220             resttpsi = thbjattr_thbj-attr.property-value-logical.
     2221           end.
     2222           when 'neg-tpsi-weight':U then do:
     2223             neg-tpsi-weight = thbjattr_thbj-attr.property-value-logical.
     2224           end.
     2225           when 'neg-tpsi-oper':U then do:
