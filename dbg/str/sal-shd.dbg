     1291   define NEW SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     1292   define NEW SHARED temp-table tt0-parts    no-undo like ub.parts.
     1293   define NEW SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
     1294   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1295   define variable v-ps as character no-undo .
     1296   assign
     1297   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     1298                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     1299                     , buf_sale-doc.out-code
     1300                     , buf_sale-doc.obj-type
     1301                     , buf_sale-doc.obj-code
     1302                     , chr(4)
     1303                     , buf_sale-doc.tot-lines
     1304                     , buf_sale-doc.tot-dtl
     1305                     ).
     1306   return v-Ps.
     1307   END FUNCTION.
     1308   procedure create-tt0-doc-line-gds-dtl :
     1309   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     1310   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     1311   define input parameter p-ext-doc-type        as character no-undo .
     1312   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     1313   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     1314   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     1315   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     1316   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     1317   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     1318   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1319   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1320   define parameter buffer b-doc-line           for ub.doc-line.
     1321   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     1322   define parameter buffer buf_sale-doc for ub.sale-doc.
     1323   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     1324   define buffer other_doc-line for ub.doc-line.
     1325   define buffer other_gds-dtl for ub.gds-dtl.
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       find first tt0-doc-line where
     1330                 tt0-doc-line.obj-type = p-proprietor-obj-type
     1331             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     1332             AND tt0-doc-line.prod-type = p-prod-type
     1333             AND tt0-doc-line.prod-code = p-prod-code
     1334             AND tt0-doc-line.artic     = p-artic
     1335             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     1336             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     1337       if not available tt0-doc-line then do:
     1338         create tt0-doc-line.
     1339         buffer-copy b-doc-line
     1340         except
     1341         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     1342         to tt0-doc-line
     1343         assign
     1344         tt0-doc-line.status_ = 'нередакт':U
     1345         tt0-doc-line.ext-doc-type = p-ext-doc-type
     1346         tt0-doc-line.obj-type = p-proprietor-obj-type
     1347         tt0-doc-line.obj-code = p-proprietor-obj-code
     1348         tt0-doc-line.doc-code = p-doc-code
     1349         .
     1350       end.
     1351       if p-doc-code <> "":U then do:
     1352         find first other_doc-line no-lock where
     1353                 other_doc-line.doc-code = p-doc-code
     1354             AND  other_doc-line.artic    = p-artic
     1355             AND  other_doc-line.prod-type = p-prod-type
     1356             AND  other_doc-line.prod-code = p-prod-code no-error .
     1357         if available other_doc-line then do:
     1358           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     1359           assign
     1360           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     1361           .
     1362         end.
     1363         else do:
     1364           assign
     1365           tt0-doc-line.doc-code = '':U
     1366           .
     1367         end.
     1368       end.
     1369       find first tt0-gds-dtl where
     1370               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1371           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1372           AND tt0-gds-dtl.prod-type = p-prod-type
     1373           AND tt0-gds-dtl.prod-code = p-prod-code
     1374           AND tt0-gds-dtl.artic     = p-artic
     1375           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     1376       if not available tt0-gds-dtl then do:
     1377         create tt0-gds-dtl.
     1378         buffer-copy b-gds-dtl
     1379         except
     1380         obj-type obj-code doc-code doc-qnty fact-qnty
     1381         to tt0-gds-dtl
     1382         assign
     1383         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1384         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1385         tt0-gds-dtl.doc-code = p-doc-code
     1386         .
     1387       end.
     1388       if p-doc-code <> "":U then do:
     1389           find first other_gds-dtl no-lock where
     1390                   other_gds-dtl.doc-code = p-doc-code
     1391               AND  other_gds-dtl.artic    = p-artic
     1392               AND  other_gds-dtl.prod-type    = p-prod-type
     1393               AND  other_gds-dtl.prod-code    = p-prod-code
     1394               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     1395           if available other_gds-dtl then do:
     1396             assign
     1397             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     1398             .
     1399           end.
     1400           else do:
     1401             assign
     1402             tt0-gds-dtl.doc-code = '':U
     1403             .
     1404           end.
     1405       end.
     1406       assign
     1407       old-qnty = tt0-gds-dtl.doc-qnty
     1408       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     1409       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     1410       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     1411       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     1412       .
     1413     end.
     1414   end procedure.
     1415   procedure fill-tt-tpsi-table :
     1416   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     1417   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     1418   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     1419   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     1420   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     1421   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     1422   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     1423   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1424   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     1425   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     1426   define buffer buf_goods for ub.goods.
     1427   define buffer buf_doc-line for ub.doc-line.
     1428   define buffer buf_gds-dtl for ub.gds-dtl.
     1429   define buffer buf_sale-doc for ub.sale-doc.
     1430     do
     1431     on error undo, return error
     1432     :
     1433       _doc-line:
     1434       for each buf_Doc-line no-lock where
     1435             buf_doc-line.doc-code = p-doc-code,
     1436         first buf_goods no-lock where
     1437             buf_goods.artic = buf_doc-line.artic
     1438        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     1439        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     1440           each buf_gds-dtl no-lock where
     1441             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     1442         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     1443         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1444         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1445         assign
     1446         v-ext-doc-type = "":U.
     1447         run tpsi-preselect-gds-proprietor in this-procedure (
     1448                                                     input buf_goods.gds-code
     1449                                                   ,input g#db-num
     1450                                                   ,output v-proprietor-host-code
     1451                                                   ,output v-proprietor-obj-type
     1452                                                   ,output v-proprietor-obj-code ) no-error .
     1453         if v-proprietor-host-code = p-host-code then do:
     1454           assign
     1455           v-ext-doc-type = 'ev':U .
     1456         end.
     1457         else do:
     1458           assign
     1459           v-ext-doc-type =  'ee':U .
     1460         end.
     1461         if  (v-proprietor-obj-type = p-obj-type
     1462         AND v-proprietor-obj-code = p-obj-code)
     1463         OR (v-proprietor-obj-type = "":U
     1464         AND v-proprietor-obj-code = 0)
     1465         OR v-proprietor-obj-code = ?
     1466         then next _doc-line.
     1467         find first buf_sale-doc no-lock where
     1468                   buf_sale-doc.inkas-code = p-doc-code
     1469              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     1470              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     1471              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     1472              no-error .
     1473         run create-tt0-doc-line-gds-dtl  in this-procedure (
     1474                                                              input v-proprietor-obj-type
     1475                                                             ,input v-proprietor-obj-code
     1476                                                             ,input v-ext-doc-type
     1477                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     1478                                                             ,input buf_doc-line.artic
     1479                                                             ,input buf_Doc-line.prod-type
     1480                                                             ,input buf_doc-line.prod-code
     1481                                                             ,input buf_gds-dtl.prt-code
     1482                                                             ,input 0
     1483                                                             ,output v-was-gds-dtl-fact-qnty
     1484                                                             ,output v-gds-dtl-fact-qnty
     1485                                                             ,buffer buf_doc-line
     1486                                                             ,buffer buf_gds-dtl
     1487                                                             ,buffer buf_sale-doc
     1488                                                           ).
     1489       end.
     1490     end.
     1491   end procedure.
     1492   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1494   procedure get-alias-type-price-obj :
     1495   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1496   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1497   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1498   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1499   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1500   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1501   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1502   define output parameter p-alias-type-price as character no-undo .
     1503   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1504   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1505   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1506   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1507   define variable v-mediat-objf               as character no-undo .
     1508   define variable v-param-type as character no-undo .
     1509   define variable v-value-character as character no-undo .
     1510   define variable v-value-date as date no-undo .
     1511   define variable v-value-decimal as decimal no-undo .
     1512   define variable v-value-integer as INTEGER no-undo .
     1513   define variable v-value-logical AS LOGICAL no-undo .
     1514   define variable v-tth as handle no-undo .
     1515   assign
     1516   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1517   define buffer buf_trn-doc for ub.trn-doc.
     1518     _main:
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       run adm/shattri.p (
     1523         input "get":U
     1524         ,input  p-prop-obj-type
     1525         ,input  p-prop-obj-code
     1526         ,input  'alias-tpsi':U
     1527         ,input  '':U
     1528         ,output v-value-character
     1529         ,output v-value-date
     1530         ,output v-value-decimal
     1531         ,output v-value-integer
     1532         ,output v-value-logical
     1533         ,output v-param-type
     1534         ,INPUT-OUTPUT table-handle v-tth
     1535         ) no-error .
     1536       if error-status:error
     1537       then do:
     1538         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1539                                 , p-prop-obj-type
     1540                                 , p-prop-obj-code).
     1541       end.
     1542       find first thbjattr_thbj-attr where
     1543                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1544             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1545             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1546             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1547       if not available thbjattr_thbj-attr
     1548       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1549         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1550                                 , p-prop-obj-type
     1551                                 , p-prop-obj-code).
     1552       end.
     1553       assign
     1554       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1555       if p-prop-host-code = p-host-code
     1556       and (p-alias-type-price = '':U
     1557       or   p-alias-type-price <> '5':U)
     1558       then  do:
     1559         assign
     1560         p-ext-doc-type = 'ev':U
     1561         p-price-obj-type = p-obj-type
     1562         p-price-obj-code = p-obj-code
     1563         p-alias-type-price = '3':U
     1564         .
     1565       end.
     1566       else do:
     1567         if p-prop-host-code = p-host-code  then do:
     1568           assign
     1569           p-ext-doc-type = 'ev':U
     1570           p-price-obj-type = p-obj-type
     1571           p-price-obj-code = p-obj-code
     1572           .
     1573         end.
     1574         else do:
     1575           assign
     1576           p-ext-doc-type = 'ee':U.
     1577           assign
     1578           v-mediat-obj-type = "":U
     1579           v-mediat-obj-code = 0
     1580           v-mediat-objf = "":U
     1581           .
     1582           if p-alias-type-price = '4':U then do:
     1583             find first thbjattr_thbj-attr where
     1584                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1585                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1586                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1587                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1588             if not available thbjattr_thbj-attr
     1589             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1590               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1591                                       , p-prop-obj-type
     1592                                       , p-prop-obj-code).
     1593             end.
     1594             assign
     1595             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1596             v-mediat-obj-type = entry(1, v-mediat-objf)
     1597             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1598             no-error
     1599             .
     1600             if error-status:error then do:
     1601               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1602                                       , p-prop-obj-type
     1603                                       , p-prop-obj-code).
     1604             end.
     1605           end.
     1606           CASE p-alias-type-price:
     1607             when '1':U then do:
     1608               assign
     1609               p-price-obj-type = p-prop-obj-type
     1610               p-price-obj-code = p-prop-obj-code
     1611               .
     1612             end.
     1613             when '2':U then do:
     1614               assign
     1615               p-price-obj-type = p-prop-obj-type
     1616               p-price-obj-code = p-prop-obj-code
     1617               .
     1618             end.
     1619             when '3':U
     1620             or
     1621             when '5':U
     1622             then do:
     1623               assign
     1624               p-price-obj-type = p-obj-type
     1625               p-price-obj-code = p-obj-code
     1626               .
     1627             end.
     1628             when '4':U then do:
     1629               assign
     1630               p-price-obj-type = v-mediat-obj-type
     1631               p-price-obj-code = v-mediat-obj-code
     1632               .
     1633             end.
     1634           END CASE.
     1635         end.
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure write-tt0-info:
     1640   define input parameter p-artic as character no-undo .
     1641   define input parameter p-prod-type as character no-undo .
     1642   define input parameter p-prod-code as integer no-undo .
     1643   define input parameter p-prt-code as integer no-undo .
     1644   define input parameter p-obj-type as character no-undo .
     1645   define input parameter p-obj-code as integer no-undo .
     1646   define input parameter p-doc-code as character no-undo .
     1647   define input parameter p-from-tpsi as logical no-undo .
     1648   define input parameter p-all-qnty as decimal no-undo .
     1649   define input parameter p-was-res as decimal no-undo .
     1650   define input parameter p-to-res as decimal no-undo .
     1651   define input parameter p-is-res as decimal no-undo .
     1652   define input parameter p-o-was-res as decimal no-undo .
     1653   define input parameter p-o-to-res as decimal no-undo .
     1654   define input parameter p-o-is-res as decimal no-undo .
     1655   define input parameter p-mess   as character no-undo .
     1656   define buffer buf_tt0-info for tt0-info.
     1657     do
     1658     on error undo, return error return-value
     1659     :
     1660       find first buf_tt0-info where
     1661                buf_tt0-info.artic = p-artic
     1662            and buf_tt0-info.prod-type = p-prod-type
     1663            and buf_tt0-info.prod-code = p-prod-code
     1664            and buf_tt0-info.prt-code = p-prt-code
     1665            no-error .
     1666       if not available buf_tt0-info then do:
     1667         create buf_tt0-info.
     1668         assign
     1669         buf_tt0-info.artic = p-artic
     1670         buf_tt0-info.prod-type = p-prod-type
     1671         buf_tt0-info.prod-code = p-prod-code
     1672         buf_tt0-info.prt-code  = p-prt-code
     1673         buf_tt0-info.obj-type  = p-obj-type
     1674         buf_tt0-info.obj-code  = p-obj-code
     1675         buf_tt0-info.a-to-res  = ?
     1676         buf_tt0-info.to-res    = ?
     1677         buf_tt0-info.was-res   = ?
     1678         buf_tt0-info.o-was-res = ?
     1679         buf_tt0-info.o-to-res  = ?
     1680         buf_tt0-info.o-is-res  = ?
     1681         buf_tt0-info.is-res    = ?
     1682         .
     1683       end.
     1684       assign
     1685       buf_tt0-info.a-to-res  =
     1686                                 (if buf_tt0-info.a-to-res <> ?
     1687                                 and p-all-qnty = ?
     1688                                 then buf_tt0-info.a-to-res
     1689                                 else p-all-qnty)
     1690       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1691                                 and p-was-res = ?
     1692                                 then buf_tt0-info.was-res
     1693                                 else p-was-res)
     1694       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1695                                 and p-to-res = ?
     1696                                 then buf_tt0-info.to-res
     1697                                 else p-to-res)
     1698       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1699                                 and p-is-res = ?
     1700                                 then buf_tt0-info.is-res
     1701                                 else p-is-res)
     1702       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1703                                 and p-o-was-res = ?
     1704                                 then buf_tt0-info.o-was-res
     1705                                 else p-o-was-res)
     1706       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1707                                 and p-o-to-res = ?
     1708                                 then buf_tt0-info.o-to-res
     1709                                 else p-o-to-res)
     1710       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1711                                 and p-o-is-res = ?
     1712                                 then buf_tt0-info.o-is-res
     1713                                 else p-o-is-res)
     1714       .
     1715       assign
     1716       buf_tt0-info.doc-code  = p-doc-code
     1717       buf_tt0-info.error-message   = p-mess
     1718       .
     1719     end.
     1720   end procedure.
     1721   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   define NEW SHARED temp-table dtl-rests-mark no-undo
     1723   field artic like ub.gds-dtl.artic
