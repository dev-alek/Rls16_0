     2840     define variable v-change-sign          as integer   no-undo .
     2841     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2842     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2843     if p-change-value > 0
     2844     then do:
     2845       if frame Dialog-Frame :width + p-change-value >
     2846           session :width-chars
     2847       then do:
     2848         assign
     2849           p-change-value = session :width-chars - frame Dialog-Frame :width
     2850         .
     2851         if p-change-value <= 0
     2852         then do:
     2853           run diasize_position-resize-button in this-procedure .
     2854           return .
     2855         end.
     2856       end.
     2857     end.
     2858     if p-change-value < 0
     2859     then do:
     2860       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2861       then do:
     2862         assign
     2863           p-change-value = v-diasize-orig-frame-width
     2864                          - frame Dialog-Frame :width
     2865         .
     2866         if p-change-value >= 0
     2867         then do:
     2868           run diasize_position-resize-button in this-procedure .
     2869           return .
     2870         end.
     2871       end.
     2872     end.
     2873     if p-change-value >= 0
     2874     then do:
     2875       assign
     2876         v-change-sign = 1
     2877       .
     2878     end.
     2879     else do:
     2880       assign
     2881         v-change-sign = -1
     2882       .
     2883     end.
     2884     assign
     2885       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2886     .
     2887     if p-change-value = 0
     2888     then do:
     2889       run diasize_position-resize-button in this-procedure .
     2890       return .
     2891     end.
