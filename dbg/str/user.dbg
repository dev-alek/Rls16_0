        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Пользователь системы".
        7   define new global shared variable g#language as character no-undo .
        8   if g#language <> '' and g#language <> 'rus':U then do:
        9     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       10   end.
       11   define new global shared variable g#library  as handle no-undo .
       12   define new global shared variable g#library2 as handle no-undo .
       13   define   shared variable g#auto as logical no-undo.
       14   define   shared variable g#news as logical no-undo.
       15   define   shared variable g#oxml as logical no-undo.
       16   define   shared variable g#esys as logical no-undo.
       17   define   shared variable g#news-source-db as integer no-undo.
       18   define   shared variable g#esys-source-esys as integer no-undo.
       19   define   shared variable g#db-num as integer   no-undo .
       20   define   shared variable g#userid as character no-undo .
       21   define   shared variable g#passwd as character no-undo .
       22   define temp-table UserDbAdm
       23   field db-num as integer
       24   field db-adm as logical
       25   field db-usr as logical
       26   field db-block as logical
       27   index pi is unique db-num
       28   index adm db-adm db-usr
       29   .
       30   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31   procedure cur-time :
       32      define output parameter p-today as date      no-undo .
       33      define output parameter p-time  as integer   no-undo .
       34     do
       35     on error undo, return error
       36     :
       37       define variable v-date1 as date      no-undo .
       38       define variable v-date2 as date      no-undo .
       39       define variable v-time  as integer   no-undo .
       40       assign
       41         v-date1 = today
       42         v-time  = time
       43         v-date2 = today
       44       .
       45       if v-date1 <> v-date2
       46       then do:
       47         assign
       48           v-date1 = today
       49           v-time  = v-time
       50         .
       51       end.
       52       assign
       53         p-today = v-date1
       54         p-time  = v-time
       55       .
       56     end.
       57   end.
       58   function cur-time-date returns character
       59   :
       60     return string(today, '99/99/9999':U) .
       61   end.
       62   function cur-time-mjd returns decimal
       63   :
       64     define variable v-date as date      no-undo .
       65     define variable v-time as integer   no-undo .
       66     run cur-time in this-procedure
       67       (output v-date
       68       ,output v-time
       69       ) .
       70     return integer(v-date) - 2400002 + (v-time / 86400) .
       71   end.
       72   function cur-time-get-ending-index returns integer
       73   (input p-number as integer
       74   )
       75   :
       76     if p-number < 0
       77     or p-number = ?
       78     then do:
       79       return 1 .
       80     end.
       81     define variable v-rest as integer   no-undo .
       82     assign
       83       p-number = p-number modulo 100
       84     .
       85     if p-number < 20
       86     then do:
       87       assign
       88         v-rest = p-number
       89       .
       90     end.
       91     else do:
       92       assign
       93         v-rest = p-number modulo 10
       94       .
       95     end.
       96     case v-rest :
       97       when 1
       98       then do:
       99         return 2 .
      100       end.
      101       when 2 or
      102       when 3 or
      103       when 4
      104       then do:
      105         return 3 .
      106       end.
      107       otherwise do:
      108         return 1 .
      109       end.
      110     end case .
      111   end.
      112   procedure cur-time-mjd-to-date :
      113      define input  parameter i-mjd-diff as decimal no-undo.
      114      define output parameter o-Date     as date    no-undo.
      115      define output parameter o-Time     as integer no-undo.
      116      define variable v-day-number as integer   no-undo .
      117      if    i-mjd-diff < 0
      118         or i-mjd-diff = ?
      119      then do:
      120         return "?" .
      121      end.
      122      assign
      123         v-day-number = truncate(i-mjd-diff,0).
      124         o-Date = date(v-day-number + 2400002).
      125         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      126     .
      127   end.
      128   function cur-time-mjd-to-string returns character
      129   (input p-mjd-diff as decimal
      130   )
      131   :
      132     define variable v-day-number as integer   no-undo .
      133     define variable v-seconds    as integer   no-undo .
      134     define variable v-hour       as integer   no-undo .
      135     define variable v-min        as integer   no-undo .
      136     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      137     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      138     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      139     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      140     if p-mjd-diff < 0
      141     or p-mjd-diff = ?
      142     then do:
      143       return "?" .
      144     end.
      145     assign
      146       v-day-number = integer(truncate(p-mjd-diff,0))
      147       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      148     .
      149     if v-seconds > 86400
      150     then do:
      151       assign
      152         v-seconds = 86400 - 1
      153       .
      154     end.
      155     if v-seconds < 0
      156     then do:
      157       assign
      158         v-seconds = 0
      159       .
      160     end.
      161     assign
      162       v-hour = truncate(v-seconds / 3600, 0)
      163     .
      164     assign
      165       v-seconds = v-seconds modulo 3600
      166     .
      167     assign
      168       v-min = truncate(v-seconds / 60, 0)
      169     .
      170     assign
      171       v-seconds = v-seconds modulo 60
      172     .
      173     return
      174         (if v-day-number <> 0
      175           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      176           else ""
      177         )
      178       + (if v-day-number <> 0 or v-hour <> 0
      179           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      180           else ""
      181         )
      182       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      183           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      184           else ""
      185         )
      186       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      187       .
      188   end.
      189   function cur-time-string returns character
      190   :
      191     define variable v-date as date      no-undo .
      192     define variable v-time as integer   no-undo .
      193     run cur-time in this-procedure
      194       (output v-date
      195       ,output v-time
      196       ) .
      197     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      198   end.
      199   function cur-time-string-sec returns character
      200   :
      201     define variable v-date as date      no-undo .
      202     define variable v-time as integer   no-undo .
      203     run cur-time in this-procedure
      204       (output v-date
      205       ,output v-time
      206       ) .
      207     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      208   end.
      209   function cur-time-custom  returns character
      210   (input p-prefix as character
      211   ,input p-date-format as character
      212   ,input p-delimiter as character
      213   ,input p-time-format as character
      214   ,input p-suffix as character
      215   )
      216   :
      217     define variable v-date as date      no-undo .
      218     define variable v-time as integer   no-undo .
      219     run cur-time in this-procedure
      220       (output v-date
      221       ,output v-time
      222       ) .
      223     return
      224       p-prefix
      225       + string(v-date, p-date-format)
      226       + p-delimiter
      227       + string(v-time, p-time-format)
      228       + p-suffix
      229       .
      230   end.
      231   function cur-time-print  returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-datetime returns datetime
      242   :
      243     define variable v-char as character no-undo .
      244     define variable v-datetime as datetime no-undo .
      245     v-char = cur-time-string().
      246     v-datetime = datetime(v-char).
      247     return  v-datetime.
      248   end.
      249   function cur-time-string-msec returns character
      250   :
      251     define variable v-date as datetime  no-undo .
      252     v-date = now.
      253     return string(v-date) .
      254   end.
      255   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure sys-time_get-sys :
      257     define output parameter p-year         as integer   no-undo .
      258     define output parameter p-month        as integer   no-undo .
      259     define output parameter p-day          as integer   no-undo .
      260     define output parameter p-hour         as integer   no-undo .
      261     define output parameter p-minute       as integer   no-undo .
      262     define output parameter p-second       as integer   no-undo .
      263     define output parameter p-milliseconds as integer   no-undo .
      264     define variable v-system-time-structure as memptr    no-undo.
      265     do
      266     on error undo, return error return-value
      267     :
      268       assign
      269         set-size(v-system-time-structure) = 16
      270       .
      271       run GetSystemTime
      272         (input  get-pointer-value(v-system-time-structure)
      273         ) .
      274       assign
      275         p-year         = get-short(v-system-time-structure,  1)
      276         p-month        = get-short(v-system-time-structure,  3)
      277         p-day          = get-short(v-system-time-structure,  7)
      278         p-hour         = get-short(v-system-time-structure,  9)
      279         p-minute       = get-short(v-system-time-structure, 11)
      280         p-second       = get-short(v-system-time-structure, 13)
      281         p-milliseconds = get-short(v-system-time-structure, 15)
      282       .
      283       assign
      284         set-size(v-system-time-structure) = 0
      285       .
      286     end.
      287   end procedure.
      288   procedure sys-time_get-comp-user-name :
      289     define output parameter p-computer-name as character no-undo .
      290     define output parameter p-user-name     as character no-undo .
      291     define output parameter p-process-pid   as integer   no-undo .
      292     define variable v-return-value  as integer   no-undo .
      293     define variable v-buffer-length as integer   no-undo .
      294     define variable v-buffer-memptr as memptr    no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         v-buffer-length = 1024
      300         set-size(v-buffer-memptr) = v-buffer-length + 4
      301       .
      302       assign
      303         put-long(v-buffer-memptr, 1) = v-buffer-length
      304       .
      305       run GetComputerNameA
      306         (input  get-pointer-value(v-buffer-memptr) + 4
      307         ,input  get-pointer-value(v-buffer-memptr)
      308         ,output v-return-value
      309         ) .
      310       if v-return-value <> 0
      311       then do:
      312         assign
      313           p-computer-name = get-string(v-buffer-memptr, 5)
      314         .
      315       end.
      316       assign
      317         put-long(v-buffer-memptr, 1) = v-buffer-length
      318       .
      319       run GetUserNameA
      320         (input  get-pointer-value(v-buffer-memptr) + 4
      321         ,input  get-pointer-value(v-buffer-memptr)
      322         ,output v-return-value
      323         ) .
      324       if v-return-value <> 0
      325       then do:
      326         assign
      327           p-user-name = get-string(v-buffer-memptr, 5)
      328         .
      329       end.
      330       run GetCurrentProcessId
      331         (output p-process-pid
      332         ) .
      333       assign
      334         set-size(v-buffer-memptr) = 0
      335       .
      336     end.
      337   end procedure.
      338   procedure sys-time_get-http :
      339     define output parameter p-http-time as character no-undo .
      340     define variable v-year         as integer   no-undo .
      341     define variable v-month        as integer   no-undo .
      342     define variable v-day-of-week  as integer   no-undo .
      343     define variable v-day          as integer   no-undo .
      344     define variable v-hour         as integer   no-undo .
      345     define variable v-minute       as integer   no-undo .
      346     define variable v-second       as integer   no-undo .
      347     define variable v-milliseconds as integer   no-undo .
      348     do
      349     on error undo, return error return-value
      350     :
      351       run sys-time_get-sys in this-procedure
      352         (output v-year
      353         ,output v-month
      354         ,output v-day
      355         ,output v-hour
      356         ,output v-minute
      357         ,output v-second
      358         ,output v-milliseconds
      359         ) .
      360       assign
      361         v-day-of-week = weekday(date(v-month, v-day, v-year))
      362         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      363                     + ', ':u
      364                     + string(v-day, '99':u)
      365                     + ' ':u
      366                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      367                     + ' ':u
      368                     + string(v-year, '9999':u)
      369                     + ' ':u
      370                     + string(v-hour, '99':u)
      371                     + ':':u
      372                     + string(v-minute, '99':u)
      373                     + ':':u
      374                     + string(v-second, '99':u)
      375                     + ' ':u
      376                     + 'GMT':u
      377       .
      378     end.
      379   end procedure.
      380   procedure sys-time_set-sys :
      381     define input  parameter p-year         as integer   no-undo .
      382     define input  parameter p-month        as integer   no-undo .
      383     define input  parameter p-day          as integer   no-undo .
      384     define input  parameter p-hour         as integer   no-undo .
      385     define input  parameter p-minute       as integer   no-undo .
      386     define input  parameter p-second       as integer   no-undo .
      387     define input  parameter p-milliseconds as integer   no-undo .
      388     define variable v-system-time-structure as memptr    no-undo.
      389     define variable v-return-value as integer   no-undo .
      390     define variable v-day-of-week  as integer   no-undo .
      391     do
      392     on error undo, return error return-value
      393     :
      394       assign
      395         v-day-of-week = weekday(date(p-month, p-day, p-year))
      396       .
      397       assign
      398         set-size(v-system-time-structure) = 16
      399       .
      400       assign
      401         put-short(v-system-time-structure,  1) = p-year
      402         put-short(v-system-time-structure,  3) = p-month
      403         put-short(v-system-time-structure,  5) = v-day-of-week
      404         put-short(v-system-time-structure,  7) = p-day
      405         put-short(v-system-time-structure,  9) = p-hour
      406         put-short(v-system-time-structure, 11) = p-minute
      407         put-short(v-system-time-structure, 13) = p-second
      408         put-short(v-system-time-structure, 15) = p-milliseconds
      409       .
      410       run SetSystemTime
      411         (input  get-pointer-value(v-system-time-structure)
      412         ,output v-return-value
      413         ) .
      414       assign
      415         set-size(v-system-time-structure) = 0
      416       .
      417       if v-return-value = 0
      418       then do:
      419         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      420       end.
      421     end.
      422   end procedure.
      423   procedure sys-time_sys-to-mjd :
      424     define input  parameter p-year         as integer   no-undo .
      425     define input  parameter p-month        as integer   no-undo .
      426     define input  parameter p-day          as integer   no-undo .
      427     define input  parameter p-hour         as integer   no-undo .
      428     define input  parameter p-minute       as integer   no-undo .
      429     define input  parameter p-second       as integer   no-undo .
      430     define input  parameter p-milliseconds as integer   no-undo .
      431     define output parameter p-mjd          as decimal   no-undo .
      432     define variable v-year-correction as decimal   no-undo .
      433     define variable v-shift-year as decimal   no-undo .
      434     do
      435     on error undo, return error return-value
      436     :
      437       assign
      438         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      439         v-shift-year      = decimal(p-year) + v-year-correction
      440         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      441               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      442               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      443               + decimal(p-day) - 2432076.0
      444               + p-hour / 24.0
      445               + p-minute / 1440.0
      446               + p-second / 86400.0
      447               + p-milliseconds / 86400000.0
      448       .
      449     end.
      450   end procedure.
      451   procedure sys-time_sys-to-loc :
      452     define input  parameter p-sys-year         as integer   no-undo .
      453     define input  parameter p-sys-month        as integer   no-undo .
      454     define input  parameter p-sys-day          as integer   no-undo .
      455     define input  parameter p-sys-hour         as integer   no-undo .
      456     define input  parameter p-sys-minute       as integer   no-undo .
      457     define input  parameter p-sys-second       as integer   no-undo .
      458     define input  parameter p-sys-milliseconds as integer   no-undo .
      459     define output parameter p-loc-year         as integer   no-undo .
      460     define output parameter p-loc-month        as integer   no-undo .
      461     define output parameter p-loc-day          as integer   no-undo .
      462     define output parameter p-loc-hour         as integer   no-undo .
      463     define output parameter p-loc-minute       as integer   no-undo .
      464     define output parameter p-loc-second       as integer   no-undo .
      465     define output parameter p-loc-milliseconds as integer   no-undo .
      466     define variable v-system-time-structure as memptr    no-undo.
      467     define variable v-return-value          as integer   no-undo .
      468     define variable v-sys-day-of-week       as integer   no-undo .
      469     do
      470     on error undo, return error return-value
      471     :
      472       assign
      473         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      474       .
      475       assign
      476         set-size(v-system-time-structure) = 32
      477       .
      478       assign
      479         put-short(v-system-time-structure,  1) = p-sys-year
      480         put-short(v-system-time-structure,  3) = p-sys-month
      481         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      482         put-short(v-system-time-structure,  7) = p-sys-day
      483         put-short(v-system-time-structure,  9) = p-sys-hour
      484         put-short(v-system-time-structure, 11) = p-sys-minute
      485         put-short(v-system-time-structure, 13) = p-sys-second
      486         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      487       .
      488       run SystemTimeToTzSpecificLocalTime
      489         (input  0
      490         ,input  get-pointer-value(v-system-time-structure)
      491         ,input  get-pointer-value(v-system-time-structure) + 16
      492         ,output v-return-value
      493         ) .
      494       assign
      495         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      496         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      497         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      498         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      499         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      500         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      501         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      502       .
      503       assign
      504         set-size(v-system-time-structure) = 0
      505       .
      506       if v-return-value = 0
      507       then do:
      508         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      509       end.
      510     end.
      511   end procedure.
      512   procedure sys-time_mjd-to-sys :
      513     define input  parameter p-mjd          as decimal   no-undo .
      514     define output parameter p-year         as integer   no-undo .
      515     define output parameter p-month        as integer   no-undo .
      516     define output parameter p-day          as integer   no-undo .
      517     define output parameter p-hour         as integer   no-undo .
      518     define output parameter p-minute       as integer   no-undo .
      519     define output parameter p-second       as integer   no-undo .
      520     define output parameter p-milliseconds as integer   no-undo .
      521     define variable v-year-correction as decimal   no-undo .
      522     define variable v-shift-year      as decimal   no-undo .
      523     define variable v-conv-date     as date      no-undo .
      524     define variable v-int-part      as integer   no-undo .
      525     define variable v-fraction-part as decimal   no-undo .
      526     do
      527     on error undo, return error return-value
      528     :
      529       assign
      530         v-int-part      = integer(truncate(p-mjd, 0))
      531         v-fraction-part = p-mjd - v-int-part
      532         v-conv-date     = date(11, 17, 1858) + v-int-part
      533         p-year          = year(v-conv-date)
      534         p-month         = month(v-conv-date)
      535         p-day           = day(v-conv-date)
      536         v-fraction-part = v-fraction-part * 24.0
      537         p-hour          = integer(truncate(v-fraction-part, 0))
      538         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      539         p-minute        = integer(truncate(v-fraction-part, 0))
      540         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      541         p-second        = integer(truncate(v-fraction-part, 0))
      542         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      543         p-milliseconds  = integer(v-fraction-part)
      544       .
      545     end.
      546   end procedure.
      547   procedure sys-time_mjd-to-loc :
      548     define input  parameter p-mjd              as decimal   no-undo .
      549     define output parameter p-loc-year         as integer   no-undo .
      550     define output parameter p-loc-month        as integer   no-undo .
      551     define output parameter p-loc-day          as integer   no-undo .
      552     define output parameter p-loc-hour         as integer   no-undo .
      553     define output parameter p-loc-minute       as integer   no-undo .
      554     define output parameter p-loc-second       as integer   no-undo .
      555     define output parameter p-loc-milliseconds as integer   no-undo .
      556     define variable v-sys-year         as integer   no-undo .
      557     define variable v-sys-month        as integer   no-undo .
      558     define variable v-sys-day          as integer   no-undo .
      559     define variable v-sys-hour         as integer   no-undo .
      560     define variable v-sys-minute       as integer   no-undo .
      561     define variable v-sys-second       as integer   no-undo .
      562     define variable v-sys-milliseconds as integer   no-undo .
      563     do
      564     on error undo, return error return-value
      565     :
      566       run sys-time_mjd-to-sys
      567         (input  p-mjd
      568         ,output v-sys-year
      569         ,output v-sys-month
      570         ,output v-sys-day
      571         ,output v-sys-hour
      572         ,output v-sys-minute
      573         ,output v-sys-second
      574         ,output v-sys-milliseconds
      575         ) .
      576       run sys-time_sys-to-loc
      577         (input  v-sys-year
      578         ,input  v-sys-month
      579         ,input  v-sys-day
      580         ,input  v-sys-hour
      581         ,input  v-sys-minute
      582         ,input  v-sys-second
      583         ,input  v-sys-milliseconds
      584         ,output p-loc-year
      585         ,output p-loc-month
      586         ,output p-loc-day
      587         ,output p-loc-hour
      588         ,output p-loc-minute
      589         ,output p-loc-second
      590         ,output p-loc-milliseconds
      591         ) .
      592     end.
      593   end procedure.
      594   function sys-time_get-mjd-func returns decimal
      595   :
      596     define variable v-year         as integer   no-undo .
      597     define variable v-month        as integer   no-undo .
      598     define variable v-day          as integer   no-undo .
      599     define variable v-hour         as integer   no-undo .
      600     define variable v-minute       as integer   no-undo .
      601     define variable v-second       as integer   no-undo .
      602     define variable v-milliseconds as integer   no-undo .
      603     define variable v-mjd          as decimal   no-undo .
      604     run sys-time_get-sys in this-procedure
      605       (output v-year
      606       ,output v-month
      607       ,output v-day
      608       ,output v-hour
      609       ,output v-minute
      610       ,output v-second
      611       ,output v-milliseconds
      612       ) .
      613     run sys-time_sys-to-mjd in this-procedure
      614       (input  v-year
      615       ,input  v-month
      616       ,input  v-day
      617       ,input  v-hour
      618       ,input  v-minute
      619       ,input  v-second
      620       ,input  v-milliseconds
      621       ,output v-mjd
      622       ) .
      623     return v-mjd .
      624   end function .
      625   function sys-time_get-sys-str-func returns character
      626   :
      627     define variable v-utc-time as character no-undo .
      628     define variable v-year         as integer   no-undo .
      629     define variable v-month        as integer   no-undo .
      630     define variable v-day          as integer   no-undo .
      631     define variable v-hour         as integer   no-undo .
      632     define variable v-minute       as integer   no-undo .
      633     define variable v-second       as integer   no-undo .
      634     define variable v-milliseconds as integer   no-undo .
      635     run sys-time_get-sys in this-procedure
      636       (output v-year
      637       ,output v-month
      638       ,output v-day
      639       ,output v-hour
      640       ,output v-minute
      641       ,output v-second
      642       ,output v-milliseconds
      643       ) .
      644     assign
      645       v-utc-time  = 'UTC ':u
      646                   + string(v-year,         '9999':u)
      647                   + '/':u
      648                   + string(v-month,        '99':u)
      649                   + '/':u
      650                   + string(v-day,          '99':u)
      651                   + ' ':u
      652                   + string(v-hour,         '99':u)
      653                   + ':':u
      654                   + string(v-minute,       '99':u)
      655                   + ':':u
      656                   + string(v-second,       '99':u)
      657                   + ' ':u
      658                   + string(v-milliseconds, '999':u)
      659     .
      660     return v-utc-time.
      661   end function .
      662   function sys-time_mjd-to-loc-str-func returns character
      663     (v-sys-mjd as decimal)
      664   :
      665     define variable v-loc-str          as character no-undo .
      666     define variable v-loc-year         as integer   no-undo .
      667     define variable v-loc-month        as integer   no-undo .
      668     define variable v-loc-day          as integer   no-undo .
      669     define variable v-loc-hour         as integer   no-undo .
      670     define variable v-loc-minute       as integer   no-undo .
      671     define variable v-loc-second       as integer   no-undo .
      672     define variable v-loc-milliseconds as integer   no-undo .
      673     run sys-time_mjd-to-loc in this-procedure
      674       (input  v-sys-mjd
      675       ,output v-loc-year
      676       ,output v-loc-month
      677       ,output v-loc-day
      678       ,output v-loc-hour
      679       ,output v-loc-minute
      680       ,output v-loc-second
      681       ,output v-loc-milliseconds
      682       ) .
      683     assign
      684       v-loc-str = substitute('&1/&2/&3 &4:&5'
      685                             ,string(v-loc-day,    '99':U)
      686                             ,string(v-loc-month,  '99':U)
      687                             ,string(v-loc-year,   '9999':U)
      688                             ,string(v-loc-hour,   '99':U)
      689                             ,string(v-loc-minute, '99':U)
      690                             )
      691     .
      692     return v-loc-str .
      693   end function .
