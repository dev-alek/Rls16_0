     3180         run diasize_position-resize-button in this-procedure .
     3181       end.
     3182       if v-diasize-wndstore = true
     3183       then do:
     3184         if connected("ub") = true
     3185         then do:
     3186           define variable v-cntxt-db-num        as integer   no-undo .
     3187           define variable v-cntxt-userid        as character no-undo .
     3188           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3189                                             , OUTPUT v-cntxt-userid
     3190                                             ) .
     3191           run gbl/wndsizew.p
     3192             (input  v-cntxt-db-num
     3193             ,input  v-cntxt-userid
     3194             ,input  v-diasize-proc-name
     3195             ,input  'width':u
     3196             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3197             ) .
     3198         end.
     3199       end.
     3200     end.
     3201     assign
     3202       v-diasize-change-size = false
     3203     .
     3204   end procedure.
     3205   procedure diasize_set-width :
     3206     define input  parameter p-new-width  as decimal   no-undo .
     3207     define input  parameter p-move-resize as logical   no-undo .
     3208     do
     3209     on error undo, return error return-value
     3210     :
     3211       run diasize_change-width in this-procedure
     3212         (input  (p-new-width - frame Dialog-Frame :width)
     3213         ,input  p-move-resize
     3214         ) .
     3215     end.
     3216   end procedure.
     3217   procedure diasize_position-resize-button :
     3218     do with frame Dialog-Frame
     3219     :
     3220       hide v-diasize-resize-button .
     3221       assign
     3222         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3223                     - 1
     3224                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3225         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3226                     - 1
     3227                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3228       .
     3229       view v-diasize-resize-button .
     3230     end.
     3231   end procedure.
     3232   on alt-right anywhere
     3233   do:
     3234     run diasize_change-width in this-procedure
     3235       (input 1
     3236       ,input true
     3237       ) .
     3238     return no-apply .
     3239   end.
     3240   on alt-left anywhere
     3241   do:
     3242     run diasize_change-width in this-procedure
     3243       (input -1
     3244       ,input true
     3245       ) .
     3246     return no-apply .
     3247   end.
     3248   on alt-down anywhere
     3249   do:
     3250     run diasize_change-height in this-procedure
     3251       (input 1
     3252       ,input true
     3253       ) .
     3254     return no-apply .
     3255   end.
     3256   on alt-up anywhere
     3257   do:
     3258     run diasize_change-height in this-procedure
     3259       (input -1
     3260       ,input true
     3261       ) .
     3262     return no-apply .
     3263   end.
     3264   on alt-enter of frame Dialog-Frame
     3265   do:
     3266     run diasize_maximize in this-procedure
     3267       (input  ?
     3268       ).
     3269     return no-apply .
     3270   end.
     3271   procedure diasize_end-move :
     3272     do
     3273     on error undo, return error return-value
     3274     :
     3275       define variable v-row-delta as decimal   no-undo .
     3276       define variable v-col-delta as decimal   no-undo .
     3277       define variable v-new-row as decimal   no-undo .
     3278       define variable v-new-col as decimal   no-undo .
     3279       assign
     3280         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3281         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3282       .
     3283       assign
     3284         v-row-delta = v-new-row - frame Dialog-Frame :height
     3285         v-col-delta = v-new-col - frame Dialog-Frame :width
     3286       .
     3287       run diasize_change-height in this-procedure
     3288         (input v-row-delta
     3289         ,input true
     3290         ) .
     3291       run diasize_change-width in this-procedure
     3292         (input v-col-delta
     3293         ,input true
     3294         ) .
     3295     end.
     3296   end procedure.
     3297   procedure diasize_maximize :
     3298     define input  parameter p-action as logical   no-undo .
     3299     do
     3300     on error undo, return error return-value
     3301     :
     3302       if p-action = ?
     3303       then do:
     3304         if v-diasize-need-maximize = true
     3305         then do:
     3306           assign
     3307             p-action = true
     3308           .
     3309         end.
     3310         else do:
     3311           assign
     3312             p-action = false
     3313           .
     3314         end.
     3315       end.
     3316       if p-action = true
     3317       then do:
     3318         run diasize_change-height in this-procedure
     3319           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3320               - frame Dialog-Frame :height-chars
     3321           ,input true
     3322           ) .
     3323         run diasize_change-width in this-procedure
     3324           (input session :width-chars
     3325               - frame Dialog-Frame :width-chars
     3326           ,input true
     3327           ) .
     3328         assign
     3329           v-diasize-need-maximize = false
     3330         .
     3331       end.
     3332       else do:
     3333         run diasize_change-width in this-procedure
     3334           (input v-diasize-orig-frame-width
     3335               - frame Dialog-Frame :width-chars
     3336           ,input true
     3337           ) .
     3338         run diasize_change-height in this-procedure
     3339           (input v-diasize-orig-frame-height
     3340               - frame Dialog-Frame :height-chars
     3341           ,input true
     3342           ) .
     3343         assign
     3344           v-diasize-need-maximize = true
     3345         .
     3346       end.
     3347     end.
     3348   end procedure.
     3349   procedure diasize_restore-orig-size :
     3350     do
     3351     on error undo, return error return-value
     3352     :
     3353       assign
     3354         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3355         v-diasize-current-frame-height = frame Dialog-Frame :height
     3356       .
     3357       run diasize_set-height in this-procedure
     3358         (input  v-diasize-orig-frame-height
     3359         ,input  true
     3360         ) .
     3361       run diasize_set-width in this-procedure
     3362         (input  v-diasize-orig-frame-width
     3363         ,input  true
     3364         ) .
     3365     end.
     3366   end procedure.
     3367   procedure diasize_restore-current-size :
     3368     do
     3369     on error undo, return error return-value
     3370     :
     3371       run diasize_set-height in this-procedure
     3372         (input  v-diasize-current-frame-height
     3373         ,input  true
     3374         ) .
     3375       run diasize_set-width in this-procedure
     3376         (input  v-diasize-current-frame-width
     3377         ,input  true
     3378         ) .
     3379     end.
     3380   end procedure.
     3381   procedure diasize_set-browse-handle :
     3382     define input  parameter p-browse-handle as handle   no-undo .
     3383     define buffer buf_temp-browse-handle for temp-browse-handle .
     3384     do
     3385     on error undo, return error return-value
     3386     :
     3387       assign
     3388         v-diasize-browse-handle = p-browse-handle
     3389       .
     3390       for each buf_temp-browse-handle
     3391       on error undo, return error return-value
     3392       :
     3393         delete buf_temp-browse-handle .
     3394       end.
     3395     end.
     3396   end procedure.
     3397   procedure diasize_add_browse :
     3398     define input  parameter p-browse-type   as character no-undo .
     3399     define input  parameter p-browse-handle as handle    no-undo .
     3400     define buffer buf_temp-browse-handle for temp-browse-handle .
     3401     do
     3402     on error undo, return error return-value
     3403     :
     3404       assign
     3405         v-diasize-browse-number = v-diasize-browse-number + 1
     3406       .
     3407       create buf_temp-browse-handle .
     3408       assign
     3409         buf_temp-browse-handle.browse-type   = p-browse-type
     3410         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3411         buf_temp-browse-handle.browse-handle = p-browse-handle
     3412       .
     3413     end.
     3414   end procedure.
     3415   procedure diasize_init :
     3416     define variable v-default-value    as logical   no-undo .
     3417     define variable v-restore-saved    as logical   no-undo .
     3418     define variable v-resize-value-str as character no-undo .
     3419     do
     3420     on error undo, return error return-value
     3421     :
     3422       do with frame Dialog-Frame
     3423       :
     3424         assign
     3425           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3426           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3427           v-diasize-browse-handle     = browse BRUserUbd :handle
     3428         .
     3429         create button v-diasize-resize-button
     3430         assign
     3431           parent        = frame Dialog-Frame :first-child
     3432           label         = "s"
     3433           height-pixels = 16
     3434           width-pixels  = 16
     3435           visible       = true
     3436           sensitive     = true
     3437           movable       = true
     3438           triggers:
     3439             on end-move persistent run diasize_end-move in this-procedure .
     3440           end triggers.
     3441         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3442         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3443         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3444         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3445         assign
     3446           v-diasize-wndmax = false
     3447         .
     3448         if connected("ub") = true
     3449         then do:
     3450           define variable v-cntxt-db-num        as integer   no-undo .
     3451           define variable v-cntxt-userid        as character no-undo .
     3452           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3453                                             , OUTPUT v-cntxt-userid
     3454                                             ) .
     3455           run gbl/wndpar_r.p
     3456             (input  v-cntxt-db-num
     3457             ,input  v-cntxt-userid
     3458             ,input  'wndmax':U
     3459             ,output v-diasize-wndmax
     3460             ,output v-default-value
     3461             ) .
     3462         end.
     3463         assign
     3464           v-diasize-wndstore = false
     3465         .
     3466         if connected("ub") = true
     3467         then do:
     3468           run gbl/wndpar_r.p
     3469             (input  v-cntxt-db-num
     3470             ,input  v-cntxt-userid
     3471             ,input  'wndstore':U
     3472             ,output v-diasize-wndstore
     3473             ,output v-default-value
     3474             ) .
     3475         end.
     3476         assign
     3477           v-diasize-proc-name = entry(1, program-name(2), '.')
     3478         .
     3479         if v-diasize-wndstore = true
     3480         then do:
     3481           assign
     3482             v-restore-saved = false
     3483           .
     3484           if connected("ub") = true
     3485           then do:
     3486             run gbl/wndsizer.p
     3487               (input  v-cntxt-db-num
     3488               ,input  v-cntxt-userid
     3489               ,input  v-diasize-proc-name
     3490               ,input  'height':u
     3491               ,output v-resize-value-str
     3492               ) .
     3493             if v-resize-value-str <> '':U
     3494             then do:
     3495               run diasize_change-height in this-procedure
     3496                 (input  integer(v-resize-value-str)
     3497                 ,input  true
     3498                 ) .
     3499               assign
     3500                 v-restore-saved = true
     3501               .
     3502             end.
     3503           end.
     3504           if connected("ub") = true
     3505           then do:
     3506             run gbl/wndsizer.p
     3507               (input  v-cntxt-db-num
     3508               ,input  v-cntxt-userid
     3509               ,input  v-diasize-proc-name
     3510               ,input  'width':u
     3511               ,output v-resize-value-str
     3512               ) .
     3513             if v-resize-value-str <> '':U
     3514             then do:
     3515               run diasize_change-width in this-procedure
     3516                 (input  integer(v-resize-value-str)
     3517                 ,input  true
     3518                 ) .
     3519               assign
     3520                 v-restore-saved = true
     3521               .
     3522             end.
     3523           end.
     3524           if v-restore-saved <> true
     3525           then do:
     3526             if v-diasize-wndmax = true
     3527             then do:
     3528               run diasize_maximize in this-procedure
     3529                 (input  true
     3530                 ) .
     3531             end.
     3532           end.
     3533         end.
     3534         else do:
     3535           if v-diasize-wndmax = true
     3536           then do:
     3537             run diasize_maximize in this-procedure
     3538               (input  true
     3539               ) .
     3540           end.
     3541         end.
     3542       end.
     3543     end.
     3544   end procedure.
     3545   procedure diasize_need-full-display :
     3546     define output parameter p-need-full-display as logical   no-undo .
     3547     do
     3548     on error undo, return error return-value
     3549     :
     3550       assign
     3551         p-need-full-display = v-diasize-need-full-display
     3552       .
     3553       assign
     3554         v-diasize-need-full-display = false
     3555       .
     3556     end.
     3557   end procedure.
     3558   procedure get-context :
     3559      define output parameter p-db-num as integer          no-undo.
     3560      define output parameter p-user-id as character        no-undo.
     3561      define variable v-login               as character    no-undo.
     3562      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3563      define buffer buf_user-login  for ub.user-login .
     3564      do
     3565      on error undo, return error
     3566      :
     3567            FIND FIRST buf_sys-ctrl no-lock.
     3568            ASSIGN
     3569               v-login = USERID("ub")
     3570               p-db-num = buf_sys-ctrl.db-num
     3571            .
     3572            FIND FIRST buf_user-login
     3573                 WHERE buf_user-login.db-num = p-db-num
     3574                   AND buf_user-login.user-login = v-login
     3575                 no-lock
     3576                 no-error
     3577                 .
     3578            IF AVAILABLE buf_user-login
     3579            THEN DO:
     3580               assign
     3581                  p-user-id = buf_user-login.user-id
     3582               .
     3583            END.
     3584      end.
     3585   end procedure.
     3586       run diasize_init in this-procedure .
     3587   MAIN-BLOCK:
     3588   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3589      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3590   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3591     run mainmenu_getcntxt in parparentproc
     3592       (output v-cntxt-db-num
     3593       ,output v-cntxt-userid
     3594       ,output v-cntxt-level
     3595       ,output v-cntxt-host-code-obj
     3596       ,output v-cntxt-obj-type
     3597       ,output v-cntxt-obj-code
     3598       ,output v-cntxt-db-num-obj
     3599       ,output v-cntxt-is-admin
     3600       ) .
     3601       run init-fields in this-procedure .
     3602       RUN enable_UI.
     3603       find first user-account-attr where user-account-attr.user-id    eq g#userid
     3604                                      and user-account-attr.attr-code  eq "superadm"
     3605       no-lock no-error.
     3606       if     available user-account-attr
     3607          and logical(user-account-attr.attr-value) eq yes
     3608       then
     3609          mSyperAdm = yes.
     3610       apply "VALUE-CHANGED" to rad-adm-gbd.
     3611       apply "VALUE-CHANGED" to rad-adm-ubd.
     3612       TOG-superAdm:sensitive = mSyperAdm.
     3613       RAD-adm-gbd:sensitive = mSyperAdm.
     3614       RAD-adm-Ubd:sensitive = mSyperAdm.
     3615       RAD-adm-gbd:visible = g#db-num eq 0.
     3616       RAD-adm-Ubd:visible = g#db-num eq 0.
     3617       if p-mode = 'ПРОСМОТР':U
     3618       then do:
     3619           disable
     3620               all
     3621           except
     3622               b-help
     3623               b-close
     3624           with frame Dialog-Frame .
     3625           apply "entry":U to b-close.
     3626       end.
     3627       else do:
     3628           apply "entry":U to fi-last-name.
     3629       end.
     3630       WAIT-FOR GO OF FRAME Dialog-Frame.
     3631   END.
     3632   RUN disable_UI.
     3633   PROCEDURE check-user :
     3634       define output parameter p-have-error    as logical          no-undo.
     3635       define output parameter p-error-desc    as character        no-undo.
     3636       define output parameter p-focus-widget  as handle           no-undo.
     3637   do
     3638   with frame Dialog-Frame
     3639   on error undo, return error
     3640   :
     3641       if fi-nik :screen-value = "":U
     3642       then do:
     3643           assign
     3644               p-have-error = yes
     3645               p-error-desc = substitute( "Не задан псевдоним пользователя.&1&1Для корректного отображения пользователя в системе&1необходимо определить псевдоним.&1&1Определите псевдоним пользователя.", chr(10) )
     3646               p-focus-widget = fi-nik :handle
     3647           .
     3648       end.
     3649       if fi-last-name :screen-value = "":U
     3650       then do:
     3651           if p-have-error = no
     3652           then do:
     3653               assign
     3654                   p-focus-widget = fi-last-name :handle
     3655               .
     3656           end.
     3657           assign
     3658               p-have-error = yes
     3659               p-error-desc = substitute( "&2Не задана фамилия пользователя.&1&1Для корректного отображения пользователя в системе&1необходимо ввести фамилию.&1&1Введите фамилию пользователя."
     3660                                   , chr(10)
     3661                                   , ( if p-error-desc = "":U then "":U else p-error-desc + chr(10) + chr(10) )
     3662                                   )
     3663           .
     3664       end.
     3665   end.
     3666   END PROCEDURE.
     3667   PROCEDURE disable_UI :
     3668     HIDE FRAME Dialog-Frame.
     3669   END PROCEDURE.
     3670   PROCEDURE enable_UI :
     3671     DISPLAY fi-last-name fi-first-name fi-second-name fi-PS-label-2 fi-nik
     3672             fi-phone-number fi-mobile-phone-number fi-company fi-department
     3673             fi-position fi-room fi-e-mail fi-internal-phone-number
     3674             fi-PS-label ed-PS fi-user-id
     3675             fi-psn-code v-psn-name
     3676             RAD-adm-gbd TOG-superAdm RAD-adm-Ubd
     3677         WITH FRAME Dialog-Frame.
     3678     ENABLE b-exit b-close b-help fi-last-name fi-first-name fi-second-name fi-nik
     3679            fi-phone-number fi-mobile-phone-number fi-company fi-department
     3680            fi-position fi-room fi-e-mail fi-internal-phone-number ed-PS
     3681            fi-psn-code b-psn v-psn-name
     3682            btnAdm BtnDel
     3683            RAD-adm-gbd TOG-superAdm  RAD-adm-Ubd BRUserUbd
     3684         WITH FRAME Dialog-Frame.
     3685     VIEW FRAME Dialog-Frame.
     3686     OPEN QUERY BRUserUbd FOR EACH UserDbAdm NO-LOCK INDEXED-REPOSITION.
     3687   END PROCEDURE.
     3688   PROCEDURE get-nik-autofill :
     3689       define input parameter p-last-name      as character        no-undo.
     3690       define input parameter p-first-name     as character        no-undo.
     3691       define input parameter p-second-name    as character        no-undo.
     3692       define input parameter p-nik            as character        no-undo.
     3693       define output parameter p-nik-autofill  as logical          no-undo.
     3694   do
     3695   on error undo, return error
     3696   :
     3697       if p-nik = trim( substitute( "&1 &2 &3", p-last-name, p-first-name, p-second-name ) )
     3698       then do:
     3699           assign
     3700               p-nik-autofill = yes
     3701           .
     3702       end.
     3703       else do:
     3704           assign
     3705               p-nik-autofill = no
     3706           .
     3707       end.
     3708   end.
     3709   END PROCEDURE.
     3710   PROCEDURE init-fields :
     3711   do
     3712   on error undo, return error
     3713   :
     3714       define buffer buf_clients     for ub.clients .
     3715       assign
     3716           v-user-exit-enabled = no
     3717           p-accepted          = no
     3718       .
     3719       IF p-in-psn-code <> 0
     3720       OR p-in-psn-code <> ?
     3721       THEN DO:
     3722         FIND FIRST buf_clients
     3723              WHERE buf_clients.obj-code = p-in-psn-code
     3724                and buf_clients.obj-type = 'чел':U
     3725              no-lock
     3726              no-error
     3727              .
     3728       END.
     3729       assign
     3730           fi-user-id                  = p-in-user-id
     3731           fi-last-name                = p-in-last-name
     3732           fi-first-name               = p-in-first-name
     3733           fi-second-name              = p-in-second-name
     3734           fi-nik                      = p-in-nik
     3735           fi-phone-number             = p-in-phone-number
     3736           fi-mobile-phone-number      = p-in-mobile-phone-number
     3737           fi-company                  = p-in-company
     3738           fi-department               = p-in-department
     3739           fi-position                 = p-in-position
     3740           fi-room                     = p-in-room
     3741           fi-e-mail                   = p-in-e-mail
     3742           fi-internal-phone-number    = p-in-internal-phone-number
     3743           ed-PS                       = p-in-PS
     3744           fi-psn-code                 = p-in-psn-code
     3745           v-psn-name                  = IF AVAILABLE buf_clients THEN buf_clients.obj-name ELSE "Не найден"
     3746           rad-adm-gbd                 = if i-adm-gbd eq yes
     3747                                         then 1
     3748                                         else if i-adm-gbd eq no
     3749                                         then 3
     3750                                         else 2
     3751           tog-superAdm                = i-superAdm
     3752           rad-adm-Ubd                 = if i-adm-Ubd eq yes
     3753                                         then 1
     3754                                         else if i-adm-Ubd eq no
     3755                                         then 3
     3756                                         else 2
     3757       .
     3758       run get-nik-autofill in this-procedure (
     3759             input fi-last-name
     3760           , input fi-first-name
     3761           , input fi-second-name
     3762           , input fi-nik
     3763           , output v-user-nik-autofill
     3764       ).
     3765   end.
     3766   END PROCEDURE.
     3767   PROCEDURE person-user :
     3768   define input-output parameter p-code               as integer          no-undo.
     3769   define input-output parameter p-name               as character        no-undo.
     3770   do
     3771   on error undo, return error
     3772   :
     3773      define buffer buf_clients     for ub.clients .
     3774      define variable v-recid-person as character no-undo.
     3775      run ref/cli-all.w ( input parparentproc
     3776                        , input "b-sel"
     3777                        , input 'чел':U
     3778                        , input 'все':U
     3779                        , input 'текущие':U
     3780                        , input ?
     3781                        , input ",,,,,,NO,,"
     3782                        , input "lock-cli-type":U
     3783                        , output v-recid-person
     3784                        ) .
     3785      IF v-recid-person <> "":U
     3786      THEN DO:
     3787         FIND FIRST buf_clients
     3788              WHERE RECID(buf_clients) = INTEGER(ENTRY(1, v-recid-person))
     3789              no-lock
     3790              no-error
     3791              .
     3792         IF AVAILABLE buf_clients
     3793         THEN DO:
     3794            ASSIGN
     3795               p-code = buf_clients.obj-code
     3796               p-name = buf_clients.obj-name
     3797            .
     3798         END.
     3799         ELSE DO:
     3800            assign
     3801               p-code = ?
     3802               p-name = "":U
     3803            .
     3804         END.
     3805      END.
     3806   end.
     3807   END PROCEDURE.
     3808   FUNCTION GetAdm RETURNS CHARACTER
     3809     (  ) :
     3810     RETURN if UserDbAdm.db-adm
     3811            then "Администратор"
     3812            else if UserDbAdm.db-block
     3813            then "Заблокирована"
     3814            else if UserDbAdm.db-usr
     3815            then "Пользователь"
     3816            else "Отсутствует"
     3817              .
     3818   END FUNCTION.
