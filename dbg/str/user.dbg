     2825         (input  (p-new-height - frame Dialog-Frame :height)
     2826         ,input  p-move-resize
     2827         ) .
     2828     end.
     2829   end procedure.
     2830   procedure diasize_change-width :
     2831     define input  parameter p-change-value as decimal   no-undo .
     2832     define input  parameter p-move-resize  as logical   no-undo .
     2833     define variable v-field-group-handle   as handle    no-undo .
