      731   function get-user-login returns character
      732     ( p-user-id as character ) :
      733     define variable v-user-login as character no-undo .
      734     run procedure-get-user-login in this-procedure (
      735         input p-user-id
      736       , output v-user-login
      737     ) .
      738     return v-user-login .
      739   end function.
      740   procedure procedure-get-user-login :
      741   define input  parameter p-user-id    as character no-undo .
      742   define output parameter p-user-login as character no-undo .
      743       define buffer buf_user-login for ub.user-login .
      744   do
      745   for buf_user-login
      746   on error undo, return error return-value
      747   :
      748       assign
      749           p-user-login = "":U
      750       .
      751       for each buf_user-login no-lock
      752          where buf_user-login.user-id = p-user-id
      753       by buf_user-login.db-num
      754       :
      755           assign
      756               p-user-login = substitute( "&1&2&3"
      757                                   , p-user-login
      758                                   , ( if p-user-login = "":U then "":U else ",":U )
      759                                   , buf_user-login.db-num )
      760           .
      761       end.
      762   end.
      763   end procedure.
      764   procedure SetAttrUserId:
      765      define input  parameter iDb-num      as integer   no-undo.
      766      define input  parameter iUserId      as character no-undo.
      767      define input  parameter iAttrCode    as character no-undo.
      768      define input  parameter iAttrValue   as character no-undo.
      769      define buffer user-login-attr  for ub.user-login-attr .
      770      find first user-login-attr where user-login-attr.db-num    eq idb-num
      771                                   and user-login-attr.user-id   eq iuserid
      772                                   and user-login-attr.attr-code eq iAttrCode
      773      exclusive-lock no-error.
      774      if     not available user-login-attr
      775         and iAttrValue ne ?
      776      then do:
      777         create user-login-attr.
      778         assign
      779            user-login-attr.db-num     = idb-num
      780            user-login-attr.user-id    = iuserid
      781            user-login-attr.attr-code  = iAttrCode
      782         .
      783      end.
      784      if iAttrValue eq ?
      785      then do:
      786         if available ub.user-login-attr
      787         then
      788            delete ub.user-login-attr.
      789      end.
      790      else
      791         user-login-attr.attr-value = iAttrValue.
      792   end procedure.
      793   function GetAttrUserId returns character (
      794      input iDb-num      as integer  ,
      795      input iUserId      as character,
      796      input iAttrCode    as character):
      797      define buffer user-login-attr  for ub.user-login-attr .
      798      find first user-login-attr where user-login-attr.db-num    eq idb-num
      799                                   and user-login-attr.user-id   eq iuserid
      800                                   and user-login-attr.attr-code eq iAttrCode
      801      no-lock no-error.
      802      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
      803   end function.
      804   procedure getAccountSetting :
      805      define input  parameter i-user-id  as character no-undo.
      806      define output parameter o-adm-Ubd  as logical no-undo init ?.
      807      define output parameter v-adm-GBD  as logical no-undo.
      808      define output parameter o-superAdm as logical no-undo.
      809      define input-output parameter table for UserDbAdm .
      810      define variable v-adm-Ubd-int as integer no-undo.
      811      define buffer user-login for ub.user-login.
      812      define buffer db         for ub.db.
      813      define buffer user-account-attr for ub.user-account-attr.
      814      find first user-login where user-login.db-num  eq 0
      815                              and user-login.user-id eq i-user-id
      816      no-lock no-error.
      817      if available user-login
      818      then
      819         v-adm-gbd = user-login.user-administrator.
      820      else
      821         v-adm-gbd = ?.
      822      for each userDbAdm:
      823         delete userDbAdm.
      824      end.
      825      block-db:
      826      for each db where db.db-num ne 0 no-lock:
      827         if G#db-num ne 0
      828            and G#db-num ne db.db-num
      829         then
      830            next block-db.
      831         create UserDbAdm.
      832         UserDbAdm.db-num = ub.db.db-num.
      833         find first user-login where user-login.db-num  eq db.db-num
      834                                 and user-login.user-id eq i-user-id
      835         no-lock no-error.
      836         if not available user-login
      837         then
      838            v-adm-Ubd-int = 2.
      839         else if user-login.status_ eq 1
      840         then do:
      841            v-adm-Ubd-int = 2.
      842             UserDbAdm.db-block = yes.
      843             UserDbAdm.db-usr   = yes.
      844         end.
      845         else if user-login.user-administrator
      846         then do:
      847            UserDbAdm.db-adm = yes.
      848            UserDbAdm.db-usr = yes.
      849            if v-adm-Ubd-int eq 0
      850            then
      851               v-adm-Ubd-int = 1.
      852            else if v-adm-Ubd-int eq 3
      853            then do:
      854               v-adm-Ubd-int = 2.
      855            end.
      856         end.
      857         else do:
      858            if available ub.user-login
      859            then
      860               UserDbAdm.db-usr = yes.
      861            if v-adm-Ubd-int eq 0
      862            then
      863               v-adm-Ubd-int = 3.
      864            else if v-adm-Ubd-int eq 1
      865            then do:
      866               v-adm-Ubd-int = 2.
      867            end.
      868         end.
      869      end.
      870      if  v-adm-Ubd-int eq 1
      871      then
      872         o-adm-Ubd = true.
      873      else if v-adm-Ubd-int eq 3
      874      then
      875         o-adm-Ubd = false.
      876      find first user-account-attr where user-account-attr.user-id  eq i-user-id
      877                                     and user-account-attr.attr-code  eq "superADm"
      878      no-lock no-error.
      879      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
      880   end.
      881   function check_alphanumeric returns character (
      882   input ipwd as character ,
      883   input itype as character ):
      884      define variable vCharEng as character no-undo
      885      init "abcdefghijklmnopqrstuvwxyz".
      886      define variable vCharRus as character no-undo
      887      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
      888      define variable vi as integer no-undo.
      889      define variable vdigitFl as logical no-undo.
      890      define variable vCharEngFl as logical no-undo.
      891      define variable vCharRusFl as logical no-undo.
      892      define variable vCharSpeFl as logical no-undo.
      893      define variable vTextNew as character no-undo.
      894      define variable vTextOld as character no-undo.
      895      vTextNew = ipwd.
      896      vTextOld = vTextNew.
      897      do vi = 0 to 9:
      898         vTextNew = replace(vTextNew,string (vi),"").
      899      end.
      900      if length(vTextOld) ne length(vTextNew)
      901      then
      902         vdigitFL = yes.
      903      vTextOld = vTextNew.
      904      do vi = 1 to length(vCharEng):
      905         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
      906      end.
      907      if length(vTextOld) ne length(vTextNew)
      908      then
      909         vCharEngFl = yes.
      910      vTextOld = vTextNew.
      911      do vi = 1 to length(vCharRus):
      912         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
      913      end.
      914      if length(vTextOld) ne length(vTextNew)
      915      then
      916         vCharEngFl = yes.
      917      if length(vTextNew) > 0
      918      then
      919         vCharSpeFl = yes.
      920      define variable vReturn as character no-undo.
      921      assign
      922         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
      923         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
      924         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
      925         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
      926         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
      927      .
      928      vReturn = substring (vReturn,3) no-error.
      929      return vReturn.
      930   end.
      931   procedure SaveLastPWD:
      932      define input  parameter iDb-num as integer   no-undo.
      933      define input  parameter iUserId as character no-undo.
      934      define input  parameter IPWD    as character no-undo.
      935      define buffer user-login-attr  for ub.user-login-attr .
      936      find first user-login-attr where user-login-attr.db-num    eq idb-num
      937                                   and user-login-attr.user-id   eq iuserid
      938                                   and user-login-attr.attr-code eq "LastPWD"
      939      exclusive-lock no-error.
      940      if not available user-login-attr
      941      then do:
      942         create user-login-attr.
      943         assign
      944            user-login-attr.db-num     = idb-num
      945            user-login-attr.user-id    = iuserid
      946            user-login-attr.attr-code  = "LastPWD"
      947            user-login-attr.attr-value = ipwd
      948         .
      949      end.
      950      else do:
      951         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
      952         if num-entries (user-login-attr.attr-value , chr(5)) > 50
      953         then
      954            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
      955      end.
      956   end procedure.
      957   function  CheckLastPWD returns character  (
      958      input  iDb-num    as integer  ,
      959      input  iUserId    as character,
      960      input  IPWD       as character,
      961      input  Iadm       as logical ) :
      962      define buffer user-login       for ub.user-login .
      963      define buffer user-login-attr  for ub.user-login-attr .
      964      define variable vError as character  no-undo.
      965      define variable v-obyznumbukv as logical no-undo .
      966      define variable v-minparol as integer no-undo .
      967      define variable v-tth as handle no-undo .
      968      define variable VadmSuff as character no-undo.
      969      define variable v-param-type as character no-undo .
      970      define variable v-value-character as character no-undo .
      971      define variable v-value-date as date no-undo .
      972      define variable v-value-decimal as decimal no-undo .
      973      define variable v-value-integer as integer no-undo .
      974      define variable v-value-logical as logical no-undo .
      975      find first user-login where user-login.db-num    eq idb-num
      976                              and user-login.user-id   eq iUserId
      977      no-lock no-error.
      978      if Iadm
      979      then
      980         VadmSuff = 'Adm':U.
      981      run adm/shattri.p (
      982           input "get":U
      983           ,input  '':U
      984           ,input  0
      985           ,input  'staff':U
      986           ,input  'minparol':U + VadmSuff
      987           ,output v-value-character
      988           ,output v-value-date
      989           ,output v-value-decimal
      990           ,output v-minparol
      991           ,output v-value-logical
      992           ,output v-param-type
      993           ,input-output table-handle v-tth
      994           )  .
      995       if v-minparol <> 0  then do:
      996          if length(ipwd) < v-minparol
      997           then do:
      998              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
      999           end.
     1000       end.
     1001       run adm/shattri.p (
     1002           input "get":U
     1003           ,input  '':U
     1004           ,input  0
     1005           ,input  'staff':U
     1006           ,input  'obyznumbukv':U + VadmSuff
     1007           ,output v-value-character
     1008           ,output v-value-date
     1009           ,output v-value-decimal
     1010           ,output v-value-integer
     1011           ,output v-obyznumbukv
     1012           ,output v-param-type
     1013           ,input-output table-handle v-tth
     1014           )  .
     1015      if v-obyznumbukv = true
     1016      then do:
     1017         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1018         then do:
     1019            vError = vError + (if vError eq "" then "" else ", " )
     1020                   + "В пароле должны содержаться буквы и цифры".
     1021         end.
     1022      end.
     1023      define variable v-encode-value as character no-undo.
     1024      define variable v-Lastpaswd    as integer no-undo.
     1025      run adm/pswd-enc.p
     1026         (input  encode(ipwd)
     1027         ,output v-encode-value
     1028         ).
     1029      v-encode-value = encode(v-encode-value).
     1030      run adm/shattri.p (
     1031           input "get":U
     1032           ,input  '':U
     1033           ,input  0
     1034           ,input  'staff':U
     1035           ,input  'LastPaswd':U + VadmSuff
     1036           ,output v-value-character
     1037           ,output v-value-date
     1038           ,output v-value-decimal
     1039           ,output v-Lastpaswd
     1040           ,output v-value-logical
     1041           ,output v-param-type
     1042           ,input-output table-handle v-tth
     1043           )  .
     1044      if v-Lastpaswd ne 0
     1045      then do:
     1046         define variable vLastPwd as character no-undo.
     1047         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1048         if vLastPwd ne ?
     1049         then do:
     1050            define variable Vi as integer no-undo.
     1051            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1052            if     vi ne 0
     1053               and vi le v-Lastpaswd
     1054            then
     1055               vError = vError + (if vError eq "" then "" else ", " )
     1056                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1057         end.
     1058      end.
     1059      delete object v-tth.
     1060      return vError.
     1061   end function.
     1062   procedure availOneAdm:
     1063      define input-output parameter table for UserDbAdm.
     1064      define output parameter oAdm as logical no-undo.
     1065      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1066      oadm = available UserDbAdm.
     1067   end.
     1068   procedure update-user-login:
     1069      define input  parameter i-db-num     as integer          no-undo.
     1070      define input  parameter i-user-id    as character        no-undo.
     1071      define input  parameter i-user-login as character no-undo.
     1072      define input  parameter i-max-discnt as decimal no-undo.
     1073      define input  parameter i-quest-print as logical no-undo.
     1074      define input  parameter i-encoded-pass as character no-undo.
     1075      define input  parameter i-nextcon as logical no-undo.
     1076      define input  parameter i-user-administrator as logical no-undo.
     1077      define input  parameter i-Manual     as logical no-undo.
     1078      define input  parameter i-adm-gbd as logical no-undo.
     1079      define input  parameter i-adm-ubd as logical no-undo.
     1080      define input-output parameter table for UserDbAdm.
     1081      define buffer buf_user-login        for user-login.
     1082      do
     1083   for buf_user-login
     1084   on error undo, return error
     1085   :
     1086           if     i-Manual
     1087              and G#db-num eq 0
     1088           then do:
     1089              if     i-adm-gbd ne ?
     1090              then do:
     1091                 do transaction
     1092                 on error undo, return error return-value
     1093                 :
     1094                     find first buf_user-login where buf_user-login.db-num             eq 0
     1095                                                 and buf_user-login.user-login         eq i-user-login
     1096                                                 and buf_user-login.status_            eq 0
     1097                                                 and buf_user-login.user-id            ne i-user-id
     1098                     no-lock no-error.
     1099                     if available buf_user-login
     1100                     then
     1101                        undo, return error "Уже есть такой логин в ГБД".
     1102                     find first buf_user-login where buf_user-login.db-num             = 0
     1103                                                 and buf_user-login.user-id            = i-user-id
     1104                     exclusive-lock no-error.
     1105                     if not available buf_user-login
     1106                     then do:
     1107                        create buf_user-login .
     1108                        assign
     1109                            buf_user-login.db-num             = 0
     1110                            buf_user-login.user-id            = i-user-id
     1111                            buf_user-login.status_            = 0
     1112                        .
     1113                     end.
     1114                     assign
     1115                         buf_user-login.user-login         = i-user-login
     1116                         buf_user-login.user-administrator = i-adm-gbd
     1117                         buf_user-login.max-discnt         = i-max-discnt
     1118                         buf_user-login.quest-print        = i-quest-print
     1119                         buf_user-login.user-password-encoded = i-encoded-pass
     1120                     .
     1121                     if i-nextcon ne ?
     1122                     then do:
     1123                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1124                     end.
     1125                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1126                     if error-status:error
     1127                     then
     1128                        return error return-value.
     1129                 end.
     1130              end.
     1131              else do transaction on error undo, return error return-value:
     1132                  find first buf_user-login where buf_user-login.db-num             = 0
     1133                                              and buf_user-login.user-id            = i-user-id
     1134                  exclusive-lock no-error.
     1135                  if available buf_user-login
     1136                  then
     1137                     delete buf_user-login.
     1138              end.
     1139              if     i-adm-ubd ne ?
     1140              then do:
     1141                 do transaction
     1142                 on error undo, return error return-value
     1143                 :
     1144                     define variable vDbError as character no-undo.
     1145                     block-db:
     1146                     for each db where db.db-num ne 0
     1147                     no-lock:
     1148                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1149                                                    and buf_user-login.user-login         eq i-user-login
     1150                                                    and buf_user-login.status_            eq 0
     1151                                                    and buf_user-login.user-id            ne i-user-id
     1152                        no-lock no-error.
     1153                        if available buf_user-login
     1154                        then do:
     1155                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1156                           next block-db.
     1157                        end.
     1158                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1159                                                    and buf_user-login.user-id            = i-user-id
     1160                        exclusive-lock no-error.
     1161                        if not available buf_user-login
     1162                        then do:
     1163                           create buf_user-login .
     1164                           assign
     1165                               buf_user-login.db-num             = db.db-num
     1166                               buf_user-login.user-id            = i-user-id
     1167                               buf_user-login.status_            = 0
     1168                               buf_user-login.user-password-encoded = i-encoded-pass
     1169                           .
     1170                        end.
     1171                        assign
     1172                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1173                            buf_user-login.user-login         = i-user-login
     1174                            buf_user-login.user-administrator = i-adm-ubd
     1175                            buf_user-login.max-discnt         = i-max-discnt
     1176                            buf_user-login.quest-print        = i-quest-print
     1177                        .
     1178                        if i-nextcon ne ?
     1179                        then do:
     1180                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1181                        end.
     1182                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1183                        if error-status:error
     1184                        then
     1185                           return error return-value.
     1186                    end.
     1187                    if vDbError ne ""
     1188                    then
     1189                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1190                 end.
     1191              end.
     1192              else do:
     1193                 do transaction
     1194                 on error undo, return error return-value
     1195                 :
     1196                     block-UserDb:
     1197                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1198                     no-lock:
     1199                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1200                                                    and buf_user-login.user-login         eq i-user-login
     1201                                                    and buf_user-login.status_            eq 0
     1202                                                    and buf_user-login.user-id            ne i-user-id
     1203                        no-lock no-error.
     1204                        if available buf_user-login and UserDbAdm.db-usr
     1205                        then do:
     1206                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1207                           next block-UserDb.
     1208                        end.
     1209                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1210                                                    and buf_user-login.user-id            = i-user-id
     1211                        exclusive-lock no-error.
     1212                        if UserDbAdm.db-usr
     1213                        then do:
     1214                           if not available buf_user-login
     1215                           then do:
     1216                              create buf_user-login .
     1217                              assign
     1218                                  buf_user-login.db-num             = UserDbAdm.db-num
     1219                                  buf_user-login.user-id            = i-user-id
     1220                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1221                                  buf_user-login.user-password-encoded = i-encoded-pass
     1222                              .
     1223                           end.
     1224                           assign
     1225                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1226                               buf_user-login.user-login         = i-user-login
     1227                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1228                               buf_user-login.max-discnt         = i-max-discnt
     1229                               buf_user-login.quest-print        = i-quest-print
     1230                           .
     1231                           if i-nextcon ne ?
     1232                           then do:
     1233                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1234                           end.
     1235                           if UserDbAdm.db-adm
     1236                           then do:
     1237                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1238                              if error-status:error
     1239                              then
     1240                                 undo, return error return-value.
     1241                           end.
     1242                       end.
     1243                       else do:
     1244                          if available buf_user-login
     1245                          then do:
     1246                             define variable vok as logical no-undo.
     1247                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1248                             if not vok
     1249                             then
     1250                                undo, return error return-value.
     1251                          end.
     1252                       end.
     1253                    end.
     1254                     if vDbError ne ""
     1255                     then
     1256                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1257                 end.
     1258              end.
     1259           end.
     1260           else do transaction
     1261           on error undo, return error return-value
     1262           :
     1263              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1264                                          and buf_user-login.user-id            = i-user-id
     1265              exclusive-lock no-error.
     1266              if not available buf_user-login
     1267              then do:
     1268                 create buf_user-login .
     1269                 assign
     1270                    buf_user-login.db-num             = i-db-num
     1271                    buf_user-login.user-id            = i-user-id
     1272                    buf_user-login.status_            = 0
     1273                 .
     1274              end.
     1275              assign
     1276                   buf_user-login.user-login         = i-user-login
     1277                   buf_user-login.user-administrator = i-user-administrator
     1278                   buf_user-login.max-discnt         = i-max-discnt
     1279                   buf_user-login.quest-print        = i-quest-print
     1280                   buf_user-login.user-password-encoded = i-encoded-pass
     1281               .
     1282               if i-user-administrator
     1283               then
     1284                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1285               if i-nextcon ne ?
     1286               then do:
     1287                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1288               end.
     1289           end.
     1290       end.
     1291   end procedure.
     1292   procedure addobj:
     1293      define input  parameter i-db-num as integer no-undo.
     1294      define input  parameter i-user-id as character no-undo.
     1295      define buffer buf_user-obj     for ub.user-obj.
     1296      define buffer buf_clients      for ub.clients.
     1297      if i-db-num <> 0 then do:
     1298          for each buf_clients
     1299              where buf_clients.db-num = i-db-num
     1300              and ( buf_clients.obj-type = 'маг':U
     1301                 or buf_clients.obj-type = 'скл':U
     1302                  )
     1303              no-lock:
     1304             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1305                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1306                                     and buf_user-obj.user-id      = i-user-id
     1307                                     and buf_user-obj.db-num       = i-db-num
     1308                                   no-lock)
     1309                                   then next.
     1310             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1311          end.
     1312       end.
     1313       else do:
     1314          for each buf_clients
     1315              where
     1316                  ( buf_clients.obj-type = 'маг':U
     1317                 or buf_clients.obj-type = 'скл':U
     1318                  )
     1319              no-lock:
     1320             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1321                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1322                                     and buf_user-obj.user-id      = i-user-id
     1323                                     and buf_user-obj.db-num       = i-db-num
     1324                                   no-lock)
     1325                                   then next.
     1326             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1327          end.
     1328       end.
     1329   end.
     1330   procedure enbl-obj :
     1331      define input  parameter i-db-num  as integer   no-undo.
     1332      define input  parameter i-user-id as character no-undo.
     1333      define input  parameter i-type    as character no-undo.
     1334      define input  parameter i-code    as integer   no-undo.
     1335       define variable v-host-code    as integer      no-undo.
     1336       define variable v-host-name    as character    no-undo.
     1337       define variable v-base-code    as integer      no-undo.
     1338       define buffer buf_user-obj      for ub.user-obj.
     1339       define buffer buf_user-host     for ub.user-host.
     1340       define buffer buf_clients       for ub.clients.
     1341   do
     1342   for buf_user-obj
     1343     , buf_user-host
     1344     , buf_clients
     1345   on error undo, return error
     1346   :
     1347       find first buf_user-obj exclusive-lock
     1348            where buf_user-obj.db-num    = i-db-num
     1349              and buf_user-obj.user-id   = i-user-id
     1350              and buf_user-obj.obj-type  = i-type
     1351              and buf_user-obj.obj-code  = i-code
     1352       no-error.
     1353       if not available buf_user-obj
     1354       then do:
     1355           find first buf_clients no-lock
     1356                where buf_clients.obj-type = i-type
     1357                  and buf_clients.obj-code = i-code
     1358           .
     1359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1361     (input  i-type
     1362     ,input  i-code
     1363     ,output v-host-code
     1364     ,output v-host-name
     1365     )  .
     1366   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1368     (input  v-host-code
     1369     ,output v-base-code
     1370     )  .
     1371           create buf_user-obj.
     1372           assign
     1373               buf_user-obj.db-num    = i-db-num
     1374               buf_user-obj.user-id   = i-user-id
     1375               buf_user-obj.obj-type  = i-type
     1376               buf_user-obj.obj-code  = i-code
     1377               buf_user-obj.host-code = v-host-code
     1378           .
     1379           find first buf_user-host exclusive-lock
     1380                where buf_user-host.db-num    = i-db-num
     1381                  and buf_user-host.user-id   = i-user-id
     1382                  and buf_user-host.host-code = v-host-code
     1383           no-error.
     1384           if not available buf_user-host
     1385           then do:
     1386               create buf_user-host.
     1387               assign
     1388                   buf_user-host.db-num    = i-db-num
     1389                   buf_user-host.user-id   = i-user-id
     1390                   buf_user-host.host-code = v-host-code
     1391               .
     1392           end.
     1393      end.
     1394   end.
     1395   end procedure.
     1396   procedure procedure-user-login-change-password :
     1397      define input  parameter p-db-num         as integer          no-undo.
     1398      define input  parameter p-user-id        as character        no-undo.
     1399      define input  parameter iChange          as logical          no-undo.
     1400      define variable v-can-edit         as logical   no-undo .
     1401      define variable v-encoded-pass     as character no-undo .
     1402      define variable v-encoded-pass-old as character no-undo .
     1403      define variable v-nextcon          as logical   no-undo .
     1404      define variable VadmSuff           as character no-undo.
     1405      define variable vChange as logical no-undo.
     1406      define variable v-param-type as character no-undo .
     1407      define variable v-value-character as character no-undo .
     1408      define variable v-value-date as date no-undo .
     1409      define variable v-value-decimal as decimal no-undo .
     1410      define variable v-value-integer as integer no-undo .
     1411      define variable v-value-logical as logical no-undo .
     1412      define variable v-tth           as handle  no-undo .
     1413      define buffer buf_lock_user-login for user-login.
     1414      define buffer buf_init_user-account for user-account.
     1415      do:
     1416         find first buf_lock_user-login no-lock
     1417                 where buf_lock_user-login.db-num  = p-db-num
     1418                   and buf_lock_user-login.user-id = p-user-id
     1419         no-error.
     1420         if not available buf_lock_user-login then do:
     1421            message
     1422               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1423               view-as alert-box error .
     1424               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1425         end.
     1426         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1427         if     available buf_lock_user-login
     1428            and buf_lock_user-login.user-administrator
     1429         then
     1430            VadmSuff = 'Adm':U.
     1431         define variable v-TimeAvail as integer no-undo.
     1432         define variable v-DateChg   as date    no-undo.
     1433         define variable v-Time      as integer no-undo.
     1434         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1435         run adm/shattri.p (
     1436              input "get":U
     1437              ,input  '':U
     1438              ,input  0
     1439              ,input  'staff':U
     1440              ,input  'TimeBlock':U + VadmSuff
     1441              ,output v-value-character
     1442              ,output v-value-date
     1443              ,output v-value-decimal
     1444              ,output v-TimeAvail
     1445              ,output v-value-logical
     1446              ,output v-param-type
     1447              ,input-output table-handle v-tth
     1448              )  .
     1449         if     not iChange
     1450            and v-TimeAvail ne 0
     1451            and v-DateChg + v-TimeAvail < today
     1452         then do:
     1453            do trans:
     1454               find current buf_lock_user-login exclusive-lock.
     1455               buf_lock_user-login.status_ = 1.
     1456            end.
     1457            return error "Ваша учетная запись заблокирована." .
     1458         end.
     1459         run adm/shattri.p (
     1460              input "get":U
     1461              ,input  '':U
     1462              ,input  0
     1463              ,input  'staff':U
     1464              ,input  'TimeAvail':U + VadmSuff
     1465              ,output v-value-character
     1466              ,output v-value-date
     1467              ,output v-value-decimal
     1468              ,output v-TimeAvail
     1469              ,output v-value-logical
     1470              ,output v-param-type
     1471              ,input-output table-handle v-tth
     1472              )  .
     1473         delete object v-tth.
     1474         define variable vfl as logical no-undo.
     1475         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1476         if    vfl eq yes
     1477            or (     v-TimeAvail ne 0
     1478                 and v-DateChg + v-TimeAvail < today)
     1479            or iChange
     1480         then do:
     1481             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1482             no-lock.
     1483             assign
     1484             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1485             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1486             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1487                v-encoded-pass = v-encoded-pass-old.
     1488                run adm/chg-pswd.w ( input  this-procedure
     1489                                   , input  p-db-num
     1490                                   , input  buf_lock_user-login.user-id
     1491                                   , input  buf_lock_user-login.user-login
     1492                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1493                                                                   , buf_init_user-account.first-name
     1494                                                                   , buf_init_user-account.second-name
     1495                                          )
     1496                                   , input  iChange
     1497                                   , input  yes
     1498                                   , input  buf_lock_user-login.user-password-encoded
     1499                                   , input  yes
     1500                                   , input  buf_lock_user-login.user-administrator
     1501                                   , output v-encoded-pass
     1502                                   , output v-nextcon
     1503                                   ) no-error .
     1504               if error-status :error
     1505               then do:
     1506                 message
     1507                    vss-workfile vss-revision vss-description skip
     1508                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1509                    error-status :get-message(1) skip
     1510                    return-value skip
     1511                    view-as alert-box error .
     1512                 undo, return error return-value .
     1513                end.
     1514                if    v-encoded-pass = v-encoded-pass-old
     1515                then do:
     1516                    message
     1517                       vss-workfile vss-revision vss-description skip
     1518                       "Старый пароль и новый равны. Смените пароль.":U skip
     1519                       error-status :get-message(1) skip
     1520                       return-value skip
     1521                       view-as alert-box error .
     1522                end.
     1523                else if v-encoded-pass eq ?
     1524                then do:
     1525                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1526                   view-as alert-box error.
     1527                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1528                end.
     1529             end.
     1530             if v-encoded-pass <> ? then
     1531             do trans:
     1532                find current buf_lock_user-login
     1533                      exclusive-lock
     1534                   .
     1535                assign
     1536                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1537                .
     1538                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1539                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1540                release buf_lock_user-login .
     1541                message
     1542                   "Пароль успешно изменен"
     1543                   view-as alert-box information
     1544                .
     1545             end.
     1546          end.
     1547      end.
     1548   end procedure.
     1549   procedure procedure-user-login-delete :
     1550      define input  parameter i-db-num     as integer          no-undo.
     1551      define input  parameter i-user-id    as character        no-undo.
     1552      define output parameter o-deleted   as logical          no-undo.
     1553      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1554   end.
     1555   procedure procedure-user-login-delete-question :
     1556   define input  parameter i-db-num     as integer          no-undo.
     1557   define input  parameter i-user-id    as character        no-undo.
     1558   define input  parameter i-question as logical no-undo.
     1559   define output parameter o-deleted   as logical          no-undo.
     1560     define variable v-can-edit as logical   no-undo .
     1561       define buffer buf_user-login         for user-login .
     1562       define buffer buf_user-account       for user-account.
     1563       define buffer buf_init_user-account  for user-account.
     1564   do
     1565   for buf_user-login
     1566     , buf_user-account
     1567   on error undo, return error return-value
     1568   :
     1569       assign
     1570           o-deleted = no
     1571       .
     1572       find first buf_init_user-account no-lock
     1573            where buf_init_user-account.user-id = i-user-id
     1574           .
     1575       if available buf_init_user-account
     1576       then do:
     1577         do transaction
     1578         on error undo, return error return-value
     1579         :
     1580           run can-edit-login in this-procedure (
     1581                 input  i-db-num
     1582               , output v-can-edit
     1583           ).
     1584           if v-can-edit <> true
     1585           then do:
     1586             message
     1587               "Нельзя удалять логин пользователя для базы" i-db-num
     1588             view-as alert-box error .
     1589             undo, return error return-value .
     1590           end.
     1591           find first buf_user-login exclusive-lock
     1592                where buf_user-login.db-num  = i-db-num
     1593                  and buf_user-login.user-id = i-user-id
     1594           no-error no-wait.
     1595           if not available buf_user-login
     1596           then do:
     1597             if locked( buf_user-login )
     1598             then do:
     1599               find first buf_user-login no-lock
     1600                    where buf_user-login.db-num  = i-db-num
     1601                      and buf_user-login.user-id = i-user-id
     1602               .
     1603               message
     1604                 "Удаление логина невозможно" skip
     1605                 "Пользователь в данный момент работает в системе" skip
     1606                 "БД" i-db-num skip
     1607                 "Идентификатор" i-user-id skip
     1608                 "Псевдоним"                    buf_init_user-account.nik skip
     1609                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1610                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1611                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1612                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1613                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1614                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1615                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1616                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1617                 view-as alert-box error .
     1618             end.
     1619             else do:
     1620               message
     1621                 "У пользователя нет логина" skip
     1622                 "БД" i-db-num skip
     1623                 "Идентификатор" i-user-id skip
     1624                 "Удаление невозможно" skip
     1625                 view-as alert-box error .
     1626             end.
     1627             undo, return error return-value .
     1628           end.
     1629           define variable v-ok as logical   no-undo .
     1630           if not i-question
     1631           then
     1632              v-ok = yes.
     1633           else do:
     1634              find first buf_user-account no-lock
     1635                   where buf_user-account.user-id = buf_user-login.user-id
     1636              .
     1637              message
     1638                "Удаление логина пользователя"
     1639                skip "Идентификатор" buf_user-account.user-id
     1640                skip "Псевдоним"    buf_user-account.nik
     1641                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1642                skip "Логин для базы данных" buf_user-login.db-num
     1643                skip "Логин" buf_user-login.user-login
     1644                skip (1)
     1645                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1646                skip (1)
     1647                "Продолжить?"
     1648              view-as alert-box question
     1649              buttons yes-no
     1650              update v-ok .
     1651           end.
     1652           if v-ok = yes
     1653           then do:
     1654               run str/usrlog03.p (
     1655                     input buf_user-login.db-num
     1656                   , input buf_user-login.user-id
     1657               ).
     1658               assign
     1659                   o-deleted = yes
     1660               .
     1661           end.
     1662         end.
     1663       end.
     1664     end.
     1665   end procedure.
     1666   define input parameter parparentproc                as widget-handle    no-undo .
     1667   define input parameter p-parent-handle              as handle           no-undo.
