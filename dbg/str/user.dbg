     2196      display
     2197         fi-psn-code
     2198         v-psn-name
     2199      with frame Dialog-Frame.
     2200   END.
     2201   ON ANY-PRINTABLE OF fi-last-name IN FRAME Dialog-Frame
     2202   or DELETE-CHARACTER OF fi-last-name IN FRAME Dialog-Frame
     2203   or BACKSPACE OF fi-last-name IN FRAME Dialog-Frame
     2204   or ANY-PRINTABLE OF fi-first-name IN FRAME Dialog-Frame
     2205   or DELETE-CHARACTER OF fi-first-name IN FRAME Dialog-Frame
     2206   or BACKSPACE OF fi-first-name IN FRAME Dialog-Frame
     2207   or ANY-PRINTABLE OF fi-second-name IN FRAME Dialog-Frame
     2208   or DELETE-CHARACTER OF fi-second-name IN FRAME Dialog-Frame
     2209   or BACKSPACE OF fi-second-name IN FRAME Dialog-Frame
     2210   DO:
     2211       if v-user-nik-autofill = yes
     2212       then do:
     2213           assign
     2214               fi-last-name
     2215               fi-first-name
     2216               fi-second-name
     2217           .
     2218       end.
     2219   END.
     2220   ON VALUE-CHANGED OF fi-last-name IN FRAME Dialog-Frame
     2221   or VALUE-CHANGED OF fi-first-name   IN FRAME Dialog-Frame
     2222   or VALUE-CHANGED OF fi-second-name  IN FRAME Dialog-Frame
     2223   DO:
     2224       if v-user-nik-autofill = yes
     2225       then do:
     2226           assign
     2227               fi-last-name
     2228               fi-first-name
     2229               fi-second-name
     2230           .
     2231           assign
     2232               fi-nik = trim( substitute( "&1 &2 &3", fi-last-name, fi-first-name, fi-second-name ) )
     2233           .
     2234           display
     2235               fi-nik
     2236           with frame Dialog-Frame.
     2237       end.
     2238   END.
     2239   ON LEAVE OF fi-nik IN FRAME Dialog-Frame
     2240   DO:
     2241       assign
     2242           fi-last-name
     2243           fi-first-name
     2244           fi-second-name
     2245           fi-nik
     2246       .
     2247       run get-nik-autofill in this-procedure (
     2248             input fi-last-name
     2249           , input fi-first-name
     2250           , input fi-second-name
     2251           , input fi-nik
     2252           , output v-user-nik-autofill
     2253       ).
     2254   END.
     2255   ON LEAVE OF fi-psn-code IN FRAME Dialog-Frame
     2256   DO:
     2257      define buffer buf_clients     for ub.clients .
     2258      assign
     2259         fi-psn-code
     2260      .
     2261      FIND FIRST buf_clients
     2262           WHERE buf_clients.obj-code = fi-psn-code
     2263             and buf_clients.obj-type = 'чел':U
     2264           no-lock
     2265           no-error
     2266           .
     2267      IF AVAILABLE buf_clients
     2268      THEN DO:
     2269         ASSIGN
     2270            v-psn-name = buf_clients.obj-name
     2271         .
     2272      END.
     2273      ELSE DO:
     2274         assign
     2275            fi-psn-code = ?
     2276            v-psn-name  = "":U
     2277         .
     2278      END.
     2279      display
     2280         fi-psn-code
     2281         v-psn-name
     2282      with frame Dialog-Frame.
     2283   END.
     2284   ON VALUE-CHANGED OF RAD-adm-gbd IN FRAME Dialog-Frame
     2285   DO:
     2286      tog-superadm:visible = rad-adm-gbd:screen-value eq "1".
     2287      if not tog-superadm:visible
     2288      then
     2289         tog-superadm:screen-value = "no".
     2290   END.
     2291   ON VALUE-CHANGED OF RAD-adm-Ubd IN FRAME Dialog-Frame
     2292   DO:
     2293      btnAdm:visible   = RAD-adm-Ubd:screen-value eq "2" and mSyperAdm.
     2294      BtnDel:visible   = RAD-adm-Ubd:screen-value eq "2" and mSyperAdm.
     2295      BRUserUbd:visible = RAD-adm-Ubd:screen-value eq "2" or g#db-num ne 0.
     2296   END.
     2297   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   on F2 of frame Dialog-Frame anywhere do:
     2299     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
     2300     return no-apply.
     2301   end.
     2302   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2303   on CTRL-F7 of frame Dialog-Frame anywhere do:
     2304     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame Dialog-Frame. END.
     2305     return no-apply.
     2306   end.
     2307   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2308   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2309   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2310   on help of frame Dialog-Frame
     2311   do:
     2312     run gbl/app_help.p
     2313       (input this-procedure :file-name
     2314       ,input ''
     2315       ,input ?
     2316       ) no-error.
     2317     if error-status :error then do:
     2318       message
     2319         "Ошибка при вызове помощи"
     2320         error-status :get-message(1)
     2321         view-as alert-box .
     2322     end.
     2323   end.
     2324   run minbtn-set in this-procedure .
     2325   on choose of b-help in frame Dialog-Frame
     2326   do:
     2327     apply "help":u to frame Dialog-Frame .
     2328   end.
     2329   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2330   procedure minbtn-set :
     2331       do
     2332           on error undo, return error return-value
     2333           :
     2334           define variable ii              as integer       no-undo .
     2335           define variable fh              as widget-handle no-undo .
     2336           define variable hh              as widget-handle no-undo .
     2337           define variable v-h             as handle        extent 4 no-undo .
     2338           define variable v-name-button   as character     no-undo .
     2339           define variable v-help-old-x    as decimal       no-undo .
     2340           define variable v-help-old-y    as decimal       no-undo .
     2341           define variable v-help-old-size as decimal       no-undo .
     2342           define variable v-frame-width   as decimal       no-undo .
     2343           define variable jj              as integer       no-undo .
     2344           do
     2345               on error undo, return error
     2346               :
     2347               assign
     2348                   v-frame-width = frame Dialog-Frame:width - 0.3
     2349                   fh            = frame Dialog-Frame:first-child
     2350                   hh            = fh:first-child
     2351                   ii            = 1
     2352                   .
     2353               do while valid-handle(hh):
     2354                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2355                   do:
     2356                       case lc(hh:name) :
     2357                           when "b-help" then
     2358                               do:
     2359                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2360                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2361                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2362                                   hh:TOOLTIP = "Помощь" .
     2363                                   v-help-old-x = hh:column .
     2364                                   v-help-old-y = hh:row    .
     2365                                   v-help-old-size = hh:width .
     2366                                   hh:width-chars = 2.5 .
     2367                               end.
     2368                           when "b-print" then
     2369                               do:
     2370                                   hh:load-image("cmp/b-print.bmp":u) .
     2371                                   hh:TOOLTIP = "Печать" .
     2372                                   v-h[ii] = hh:handle .
     2373                                   ii = ii + 1 .
     2374                                   hh:width-chars = 3 .
     2375                               end.
     2376                           when "b-history" or
     2377                           when "b-hist" then
     2378                               do:
     2379                                   hh:load-image("cmp/b-hist.bmp":u) .
     2380                                   hh:TOOLTIP = "История" .
     2381                                   v-h[ii] = hh:handle .
     2382                                   ii = ii + 1 .
     2383                                   hh:width-chars = 3 .
     2384                               end.
     2385                           when "b-sch" then
     2386                               do:
     2387                                   hh:load-image("cmp/b-sch.bmp":u) .
     2388                                   hh:TOOLTIP = "Установка Фильтра" .
     2389                                   v-h[ii] = hh:handle .
     2390                                   ii = ii + 1 .
     2391                                   hh:width-chars = 3 .
     2392                               end.
     2393                           when "b-hist-user" then
     2394                               do:
     2395                                   hh:load-image("cmp/b-hist.bmp":u) .
     2396                                   hh:TOOLTIP = "История пользователя" .
     2397                                   ii = ii + 1 .
     2398                               end.
     2399                       end case.
     2400                   end.
     2401                   hh = hh:next-sibling.
     2402               end.
     2403               b-help:column = v-frame-width - b-help:width-chars.
     2404               jj = 0.
     2405               repeat ii = 4 to 1 by -1 :
     2406                   if valid-handle (v-h[ii] ) then
     2407                   do:
     2408                       jj  = jj + 1 .
     2409                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2410                       v-h[ii]:row    = v-help-old-y .
     2411                   end.
     2412               end.
     2413           end.
     2414       end.
     2415   end procedure.
     2416   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2417   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2418   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2419   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2420   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2421   define variable v-diasize-current-frame-height as decimal   no-undo .
     2422   define variable v-diasize-change-size          as logical   no-undo .
     2423   define variable v-diasize-resize-button        as handle    no-undo .
     2424   define variable v-diasize-wndmax               as logical   no-undo .
     2425   define variable v-diasize-wndstore             as logical   no-undo .
     2426   define variable v-diasize-proc-name            as character no-undo .
     2427   define variable v-diasize-browse-handle        as handle    no-undo .
     2428   define variable v-diasize-browse-number        as integer   no-undo .
     2429   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2430   define temp-table temp-diasize-handle no-undo
     2431     field handle-value  as handle
     2432     field save-position as decimal
     2433     index xpk is primary unique handle-value
     2434     .
     2435   define temp-table temp-browse-handle no-undo
     2436     field browse-type   as character
     2437     field browse-number as integer
     2438     field browse-handle as handle
     2439     field original-size as decimal
     2440     index xpk is primary unique browse-type browse-number
     2441     index xie browse-type browse-handle
     2442   .
     2443   procedure diasize_change-height :
     2444     define input  parameter p-change-value  as decimal   no-undo .
     2445     define input  parameter p-move-resize   as logical   no-undo .
     2446     define variable v-field-group-handle    as handle    no-undo .
     2447     define variable v-object-handle         as handle    no-undo .
     2448     define variable v-frame-height          as decimal   no-undo .
     2449     define variable v-frame-virtual-height  as decimal   no-undo .
     2450     define variable v-browse-height         as decimal   no-undo .
     2451     define variable v-window-height         as decimal   no-undo .
     2452     define variable v-window-virtual-height as decimal   no-undo .
     2453     define variable v-change-sign           as integer   no-undo .
     2454     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2455     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2456     if p-change-value > 0
     2457     then do:
     2458       if frame Dialog-Frame :height + p-change-value
     2459           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2460       then do:
     2461         assign
     2462           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2463                           - (frame Dialog-Frame :height-chars)
     2464         .
     2465         if p-change-value <= 0
     2466         then do:
     2467           run diasize_position-resize-button in this-procedure .
     2468           return .
     2469         end.
     2470       end.
     2471     end.
     2472     if p-change-value < 0
     2473     then do:
     2474       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2475       then do:
     2476         assign
     2477           p-change-value = v-diasize-orig-frame-height
     2478                          - (frame Dialog-Frame :height-chars)
     2479         .
     2480         if p-change-value >= 0
     2481         then do:
     2482           run diasize_position-resize-button in this-procedure .
     2483           return .
     2484         end.
     2485       end.
     2486     end.
     2487     if p-change-value >= 0
     2488     then do:
     2489       assign
     2490         v-change-sign = 1
     2491       .
     2492     end.
     2493     else do:
     2494       assign
     2495         v-change-sign = -1
     2496       .
     2497     end.
     2498     assign
     2499       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2500     .
     2501     if p-change-value = 0
     2502     then do:
     2503       run diasize_position-resize-button in this-procedure .
     2504       return .
     2505     end.
     2506     move_block:
     2507     do
     2508     on error undo move_block, retry move_block
     2509     :
     2510       if retry
     2511       then do:
     2512         do
     2513         on error undo move_block, leave move_block
     2514         :
     2515           if p-change-value > 0
     2516           then do:
     2517             for each buf_temp-diasize-handle
     2518             on error undo, next
     2519             :
     2520               assign
     2521                 v-object-handle = buf_temp-diasize-handle.handle-value
     2522               .
     2523               if v-object-handle <> v-diasize-resize-button
     2524               then do:
     2525                 assign
     2526                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2527                 .
     2528               end.
     2529             end.
     2530             assign
     2531               v-diasize-browse-handle :height = v-browse-height
     2532             .
     2533             for each buf_temp-browse-handle
     2534               where buf_temp-browse-handle.browse-type = 'height':u
     2535             on error undo, next
     2536             :
     2537               assign
     2538                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2539               .
     2540             end.
     2541             assign
     2542               frame Dialog-Frame :height = v-frame-height
     2543             .
     2544             if frame Dialog-Frame :scrollable = true
     2545             then do:
     2546               assign
     2547                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2548               .
     2549             end.
     2550             run diasize_position-resize-button in this-procedure .
     2551           end.
     2552           else do:
     2553             if frame Dialog-Frame :scrollable = true
     2554             then do:
     2555               assign
     2556                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2557               .
     2558             end.
     2559             assign
     2560               frame Dialog-Frame :height = v-frame-height
     2561             .
     2562             assign
     2563               v-diasize-browse-handle :height = v-browse-height
     2564             .
     2565             for each buf_temp-browse-handle
     2566               where buf_temp-browse-handle.browse-type = 'height':u
     2567             on error undo, next
     2568             :
     2569               assign
