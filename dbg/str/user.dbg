     1787   procedure proc-alt-shift-f2:
     1788     if not ibs.th.gbl.gbl-var:rcode
     1789   then
     1790     run gbl\inidebug.p .
     1791   end.
     1792   procedure proc-alt-shift-f3:
     1793     run gbl/prvssinf.p
     1794       ( input this-procedure
     1795       ) .
     1796   end.
     1797   define variable v-inform-launched as logical no-undo initial false .
     1798   procedure proc-alt-shift-f4:
     1799     define variable v-action as character no-undo .
     1800     if v-inform-launched = false then do:
     1801       assign
     1802         v-inform-launched = true
     1803       .
     1804       run gbl/d-inform.w
     1805         (  input self
     1806         ,  input this-procedure
     1807         , output v-action
     1808         ) no-error .
     1809       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1810       assign
     1811         v-inform-launched = false
     1812       .
     1813     end.
     1814   end.
     1815   procedure proc-alt-f1:
     1816     run gbl/corrhelp.p
     1817       (input this-procedure
     1818       ) .
     1819   end .
     1820   on alt-shift-f2 anywhere do:
     1821     run proc-alt-shift-f2.
     1822   end.
     1823   on alt-shift-f3 anywhere do:
     1824     run proc-alt-shift-f3 in this-procedure .
     1825   end.
     1826   on alt-shift-f4 anywhere do:
     1827     run proc-alt-shift-f4 in this-procedure.
     1828   end.
     1829   on alt-f1 anywhere do:
     1830     run proc-alt-f1 in this-procedure .
     1831   end.
     1832   define variable v-user-exit-enabled     as logical      no-undo.
     1833   define variable v-user-nik-autofill     as logical      no-undo.
     1834   define variable mSyperAdm               as logical      no-undo.
     1835   define variable mchenglistubd           as logical no-undo.
     1836   FUNCTION GetAdm RETURNS CHARACTER
     1837     (  )  FORWARD.
     1838   DEFINE BUTTON b-close AUTO-END-KEY
     1839        LABEL "&Отмена"
     1840        SIZE 10 BY 1
     1841        BGCOLOR 8 .
     1842   DEFINE BUTTON b-exit AUTO-GO
     1843        LABEL "&Ввод"
     1844        SIZE 10 BY 1
     1845        BGCOLOR 8 .
     1846   DEFINE BUTTON b-help
     1847        LABEL "Помо&щь"
     1848        SIZE 10 BY 1
     1849        BGCOLOR 8 .
     1850   DEFINE BUTTON b-psn
     1851        IMAGE-UP FILE "btn-down-arrow":U
     1852        IMAGE-DOWN FILE "btn-down-arrow":U
     1853        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1854        LABEL "Button 1"
     1855        SIZE 3 BY 1.
     1856   DEFINE BUTTON btnAdm
     1857        LABEL "Админ/Пользователь"
     1858        SIZE 20 BY 1.
     1859   DEFINE BUTTON BtnDel
     1860        LABEL "Удалить"
     1861        SIZE 10 BY 1.
     1862   DEFINE VARIABLE ed-PS AS CHARACTER
     1863        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1864        SIZE 32.5 BY 2.25 NO-UNDO.
     1865   DEFINE VARIABLE fi-company AS CHARACTER FORMAT "X(256)":U
     1866        LABEL "Организация"
     1867        VIEW-AS FILL-IN
     1868        SIZE 15 BY 1 NO-UNDO.
     1869   DEFINE VARIABLE fi-department AS CHARACTER FORMAT "X(256)":U
     1870        LABEL "Отдел"
     1871        VIEW-AS FILL-IN
     1872        SIZE 15 BY 1 NO-UNDO.
     1873   DEFINE VARIABLE fi-e-mail AS CHARACTER FORMAT "X(256)":U
     1874        LABEL "E-Mail"
     1875        VIEW-AS FILL-IN
     1876        SIZE 15 BY 1 NO-UNDO.
     1877   DEFINE VARIABLE fi-first-name AS CHARACTER FORMAT "X(256)":U
     1878        LABEL "Имя"
     1879        VIEW-AS FILL-IN
     1880        SIZE 15 BY 1 NO-UNDO.
     1881   DEFINE VARIABLE fi-internal-phone-number AS CHARACTER FORMAT "X(256)":U
     1882        LABEL "Раб.телефон"
     1883        VIEW-AS FILL-IN
     1884        SIZE 15 BY 1 NO-UNDO.
     1885   DEFINE VARIABLE fi-last-name AS CHARACTER FORMAT "X(256)":U
     1886        LABEL "Фамилия"
     1887        VIEW-AS FILL-IN
     1888        SIZE 32.5 BY 1 NO-UNDO.
     1889   DEFINE VARIABLE fi-mobile-phone-number AS CHARACTER FORMAT "X(256)":U
     1890        LABEL "Моб.Телефон"
     1891        VIEW-AS FILL-IN
     1892        SIZE 15 BY 1 NO-UNDO.
     1893   DEFINE VARIABLE fi-nik AS CHARACTER FORMAT "X(256)":U
     1894        VIEW-AS FILL-IN
     1895        SIZE 32.5 BY 1
     1896        FGCOLOR 1  NO-UNDO.
     1897   DEFINE VARIABLE fi-phone-number AS CHARACTER FORMAT "X(256)":U
     1898        LABEL "Телефон"
     1899        VIEW-AS FILL-IN
     1900        SIZE 15 BY 1 NO-UNDO.
     1901   DEFINE VARIABLE fi-position AS CHARACTER FORMAT "X(256)":U
     1902        LABEL "Должность"
     1903        VIEW-AS FILL-IN
     1904        SIZE 15 BY 1 NO-UNDO.
     1905   DEFINE VARIABLE fi-PS-label AS CHARACTER FORMAT "X(256)":U INITIAL "Примечание:"
     1906        VIEW-AS FILL-IN
     1907        SIZE 12 BY 1 NO-UNDO.
     1908   DEFINE VARIABLE fi-PS-label-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Псевдоним:"
     1909        VIEW-AS FILL-IN
     1910        SIZE 11 BY 1
     1911        FGCOLOR 1  NO-UNDO.
     1912   DEFINE VARIABLE fi-psn-code AS INTEGER FORMAT "->>>>>>>>9":U INITIAL 0
     1913        LABEL "Физ. лицо"
     1914        VIEW-AS FILL-IN
     1915        SIZE 11.5 BY 1 NO-UNDO.
     1916   DEFINE VARIABLE fi-room AS CHARACTER FORMAT "X(256)":U
     1917        LABEL "Комната"
     1918        VIEW-AS FILL-IN
     1919        SIZE 15 BY 1 NO-UNDO.
     1920   DEFINE VARIABLE fi-second-name AS CHARACTER FORMAT "X(256)":U
     1921        LABEL "Отчество"
     1922        VIEW-AS FILL-IN
     1923        SIZE 15 BY 1 NO-UNDO.
     1924   DEFINE VARIABLE fi-user-id AS CHARACTER FORMAT "X(256)":U
     1925        LABEL "ID"
     1926         VIEW-AS TEXT
     1927        SIZE 15 BY .67
     1928        FGCOLOR 4  NO-UNDO.
     1929   DEFINE VARIABLE v-psn-name AS CHARACTER FORMAT "X(256)":U
     1930        VIEW-AS FILL-IN
     1931        SIZE 17 BY 1 NO-UNDO.
     1932   DEFINE VARIABLE RAD-adm-gbd AS INTEGER INITIAL 2
     1933        VIEW-AS RADIO-SET VERTICAL
     1934        RADIO-BUTTONS
     1935             "Администратор ГБД", 1,
     1936   "Пользователь ГБД", 3,
     1937   "Отсутствует ", 2
     1938        SIZE 28.5 BY 3 NO-UNDO.
     1939   DEFINE VARIABLE RAD-adm-Ubd AS INTEGER INITIAL 2
     1940        VIEW-AS RADIO-SET VERTICAL
     1941        RADIO-BUTTONS
     1942             "Администратор всех Убд", 1,
     1943   "Пользователь всех УБД", 3,
     1944   "Выборочно ", 2
     1945        SIZE 40.5 BY 3 NO-UNDO.
     1946   DEFINE VARIABLE TOG-superAdm AS LOGICAL INITIAL no
     1947        LABEL "Супер Администратор"
     1948        VIEW-AS TOGGLE-BOX
     1949        SIZE 22.5 BY .83 NO-UNDO.
     1950   DEFINE QUERY BRUserUbd FOR
     1951         UserDbAdm SCROLLING.
     1952   DEFINE BROWSE BRUserUbd
     1953     QUERY BRUserUbd NO-LOCK DISPLAY
     1954         UserDbAdm.db-num COLUMN-LABEL "УБД"
     1955         getadm() COLUMN-LABEL "Роль" format "x(15)"
     1956       WITH NO-ROW-MARKERS SEPARATORS SIZE 35.5 BY 7.75 FIT-LAST-COLUMN.
     1957   DEFINE FRAME Dialog-Frame
     1958        b-exit AT ROW 1 COL 1
     1959        b-close AT ROW 1 COL 11
     1960        b-help AT ROW 1 COL 36.5
     1961        fi-last-name AT ROW 3.5 COL 5.63 WIDGET-ID 2
     1962        RAD-adm-gbd AT ROW 3.5 COL 50 NO-LABEL WIDGET-ID 36
     1963        fi-first-name AT ROW 4.75 COL 9.63 WIDGET-ID 4
     1964        fi-second-name AT ROW 6 COL 4.5 WIDGET-ID 6
     1965        TOG-superAdm AT ROW 6.5 COL 50 WIDGET-ID 38
     1966        fi-PS-label-2 AT ROW 7.25 COL 3 NO-LABEL WIDGET-ID 34
     1967        fi-nik AT ROW 7.25 COL 14.5 NO-LABEL WIDGET-ID 32
     1968        RAD-adm-Ubd AT ROW 7.25 COL 50 NO-LABEL WIDGET-ID 42
     1969        fi-phone-number AT ROW 8.5 COL 5.5 WIDGET-ID 8
     1970        fi-mobile-phone-number AT ROW 9.75 COL 1.5 WIDGET-ID 10
     1971        fi-company AT ROW 11 COL 1.63 WIDGET-ID 12
     1972        BRUserUbd AT ROW 11 COL 51 WIDGET-ID 200
     1973        fi-department AT ROW 12.25 COL 7.5 WIDGET-ID 14
     1974        fi-position AT ROW 13.5 COL 3.5 WIDGET-ID 28
     1975        fi-room AT ROW 14.75 COL 5.5 WIDGET-ID 16
     1976        fi-e-mail AT ROW 16 COL 6.5 WIDGET-ID 18
     1977        fi-internal-phone-number AT ROW 17.25 COL 1.5 WIDGET-ID 22
     1978        fi-psn-code AT ROW 18.5 COL 12.5 COLON-ALIGNED WIDGET-ID 36
     1979        b-psn AT ROW 18.5 COL 26.5 WIDGET-ID 38
     1980        v-psn-name AT ROW 18.5 COL 28 COLON-ALIGNED NO-LABEL WIDGET-ID 40
     1981        fi-PS-label AT ROW 19.75 COL 1.5 NO-LABEL WIDGET-ID 26
     1982        ed-PS AT ROW 19.75 COL 14.5 NO-LABEL WIDGET-ID 24
     1983        btnAdm AT ROW 19 COL 51 WIDGET-ID 46
     1984        BtnDel AT ROW 19 COL 71.5 WIDGET-ID 48
     1985        fi-user-id AT ROW 2.5 COL 10.5 WIDGET-ID 30
     1986        SPACE(61.00) SKIP(19.07)
     1987       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1988            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1989            TITLE "Пользователь системы"
     1990            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-close WIDGET-ID 100.
     1991   ASSIGN
     1992          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1993          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1994   ASSIGN
     1995          v-psn-name:READ-ONLY IN FRAME Dialog-Frame          = TRUE
     1996          TOG-superAdm:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1997   ON GO OF FRAME Dialog-Frame
     1998   DO:
     1999       define variable v-have-error     as logical      no-undo.
     2000       define variable v-error-desc     as character    no-undo.
     2001       define variable v-focus-widget   as handle       no-undo.
     2002       run check-user in this-procedure (
     2003             output v-have-error
     2004           , output v-error-desc
     2005           , output v-focus-widget
     2006       ).
     2007       if v-have-error = yes
     2008       then do:
     2009           if valid-handle( v-focus-widget )
     2010           then do:
     2011               apply "entry" to v-focus-widget.
     2012           end.
     2013           message
     2014               "Ошибка ввода параметров пользователя."
     2015               skip (1)
     2016               skip v-error-desc
     2017           view-as alert-box.
     2018           undo, return no-apply.
     2019       end.
     2020       assign
     2021           v-user-exit-enabled = yes
     2022       .
     2023       if v-user-exit-enabled = yes
     2024       then do:
     2025           assign
     2026               fi-last-name
     2027               fi-first-name
     2028               fi-second-name
     2029               fi-phone-number
     2030               fi-mobile-phone-number
     2031               fi-company
     2032               fi-department
     2033               fi-position
     2034               fi-room
     2035               fi-e-mail
     2036               fi-internal-phone-number
     2037               fi-psn-code
     2038               ed-PS
     2039               rad-adm-gbd
     2040               TOG-superAdm
     2041               RAD-adm-Ubd
     2042           .
     2043           assign
     2044               p-out-last-name             = fi-last-name
     2045               p-out-first-name            = fi-first-name
     2046               p-out-second-name           = fi-second-name
     2047               p-out-nik                   = fi-nik
     2048               p-out-phone-number          = fi-phone-number
     2049               p-out-mobile-phone-number   = fi-mobile-phone-number
     2050               p-out-company               = fi-company
     2051               p-out-department            = fi-department
     2052               p-out-position              = fi-position
     2053               p-out-room                  = fi-room
     2054               p-out-e-mail                = fi-e-mail
     2055               p-out-internal-phone-number = fi-internal-phone-number
     2056               p-out-PS                    = ed-PS
     2057               p-out-psn-code              = fi-psn-code
     2058               o-adm-gbd                   = if rad-adm-gbd eq 1
     2059                                             then yes
     2060                                             else if rad-adm-gbd eq 3
     2061                                             then no
     2062                                             else ?
     2063               o-superAdm                  = TOG-superAdm
     2064               o-adm-Ubd                   = if RAD-adm-Ubd eq 1
     2065                                             then yes
     2066                                             else if RAD-adm-Ubd eq 3
     2067                                             then no
     2068                                             else ?
     2069           .
     2070           if o-adm-ubd eq i-adm-ubd
     2071              and not mchenglistubd
     2072           then
     2073              o-adm-ubd = ?.
     2074           if p-out-last-name              <> p-in-last-name
     2075           or p-out-first-name             <> p-in-first-name
     2076           or p-out-second-name            <> p-in-second-name
     2077           or p-out-nik                    <> p-in-nik
     2078           or p-out-phone-number           <> p-in-phone-number
     2079           or p-out-mobile-phone-number    <> p-in-mobile-phone-number
     2080           or p-out-company                <> p-in-company
     2081           or p-out-department             <> p-in-department
     2082           or p-out-position               <> p-in-position
     2083           or p-out-room                   <> p-in-room
     2084           or p-out-e-mail                 <> p-in-e-mail
     2085           or p-out-internal-phone-number  <> p-in-internal-phone-number
     2086           or p-out-PS                     <> p-in-PS
     2087           or p-out-psn-code               <> p-in-psn-code
     2088           or (o-adm-gbd                   <> i-adm-gbd)
     2089           or o-superAdm                   <> i-superAdm
     2090           or (    o-adm-Ubd ne ?
     2091               and o-adm-Ubd               <> i-adm-Ubd)
     2092           or mchenglistubd
     2093           then do:
     2094               assign
     2095                   p-accepted = yes
     2096               .
     2097           end.
     2098       end.
     2099   END.
     2100   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2101   DO:
     2102     APPLY "END-ERROR":U TO SELF.
     2103   END.
     2104   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     2105   DO:
     2106   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2107   if lookup(self :type
     2108            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2109            ) = 0
     2110   then do:
     2111     message
     2112       "$Workfile$"
     2113       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2114       "Интерфейсный элемент" self :name  skip
     2115       "Тип" self :type  skip
     2116       "Процедура" this-procedure :file-name skip
     2117       view-as alert-box .
     2118   end.
     2119   else do:
     2120     apply "entry":u to self  .
     2121     if focus :handle <> self :handle  then do:
     2122       return no-apply .
     2123     end.
     2124   end.
     2125       assign
     2126           v-user-exit-enabled     = yes
     2127           p-accepted              = no
     2128       .
     2129   END.
     2130   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2131   DO:
