     2151   END.
     2152   ON CHOOSE OF btnAdm IN FRAME Dialog-Frame
     2153   DO:
     2154      define variable vrowid as rowid no-undo.
     2155      if available UserDbAdm
     2156      then do:
     2157         if UserDbAdm.db-usr
     2158         then
     2159            if UserDbAdm.db-block
     2160            then do:
     2161               UserDbAdm.db-adm = yes.
     2162               UserDbAdm.db-block = no.
     2163             end.
     2164             else if UserDbAdm.db-adm
     2165             then
     2166                UserDbAdm.db-adm = no.
     2167             else
     2168                UserDbAdm.db-block = yes.
     2169         else
     2170            UserDbAdm.db-usr = yes.
     2171         vrowid = rowid(UserDbAdm).
     2172         BRUserUbd:refresh () no-error.
     2173         reposition BRUserUbd to rowid vrowid no-error .
     2174         mchenglistubd = yes.
     2175      end.
     2176   END.
     2177   ON CHOOSE OF BtnDel IN FRAME Dialog-Frame
     2178   DO:
     2179      define variable vrowid as rowid no-undo.
     2180      if available UserDbAdm
     2181      then do:
     2182         assign
     2183            UserDbAdm.db-adm = no
     2184            UserDbAdm.db-usr = no
     2185            UserDbAdm.db-block = no.
     2186            vrowid = rowid(UserDbAdm)
     2187         .
     2188         BRUserUbd:refresh () no-error.
     2189         reposition BRUserUbd to rowid vrowid no-error .
     2190         mchenglistubd = yes.
     2191      end.
     2192   END.
     2193   ON CHOOSE OF b-psn IN FRAME Dialog-Frame
     2194   DO:
