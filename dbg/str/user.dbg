     1706   procedure vss-get-info :
     1707     define output parameter p-vss-revision    like vss-revision    no-undo .
     1708     define output parameter p-vss-author      like vss-author      no-undo .
     1709     define output parameter p-vss-date        like vss-date        no-undo .
     1710     define output parameter p-vss-workfile    like vss-workfile    no-undo .
     1711     define output parameter p-vss-archive     like vss-archive     no-undo .
     1712     define output parameter p-vss-description like vss-description no-undo .
     1713     assign
     1714       p-vss-revision    = vss-revision
     1715       p-vss-author      = vss-author
     1716       p-vss-date        = vss-date
     1717       p-vss-workfile    = vss-workfile
     1718       p-vss-archive     = vss-archive
     1719       p-vss-description = vss-description
     1720     .
     1721   end procedure.
     1722   procedure vss-get-parameters :
     1723     define output parameter p-vss-parameters as character no-undo .
     1724   end procedure.
     1725   define new global shared variable g#vssrevis-logger as handle    no-undo .
     1726   define variable v-vssrevis-logevent                 as logical   no-undo init false .
     1727   define variable v-vssrevis-logger                   as handle    no-undo .
     1728   procedure vss-logevent :
     1729     define input  parameter p-extra-paramters as character no-undo .
     1730     define variable v-vssrevis-parameters as character no-undo .
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       if  valid-handle(v-vssrevis-logger)
     1735       and v-vssrevis-logger :get-signature("logevent") <> ""
     1736       then do:
     1737         run vss-get-parameters in this-procedure
     1738           (output v-vssrevis-parameters
     1739           ).
     1740         run logevent in v-vssrevis-logger
     1741           (input vss-workfile
     1742           ,input vss-revision
     1743           ,input v-vssrevis-parameters
     1744           ,input p-extra-paramters
     1745           ).
     1746       end.
     1747     end.
     1748   end procedure.
     1749   assign
     1750     v-vssrevis-logger = g#vssrevis-logger
     1751   .
     1752   if  valid-handle(v-vssrevis-logger)
     1753   and v-vssrevis-logger :get-signature("logevent") <> ""
     1754   then do:
     1755     assign
     1756       v-vssrevis-logevent = true
     1757     .
     1758     run vss-logevent in this-procedure (input vss-description) .
     1759   end.
     1760   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
