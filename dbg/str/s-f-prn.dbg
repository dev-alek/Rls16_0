     1023   define variable v-torgconf-doc-code             as character    no-undo.
     1024   define variable v-torgconf-doc-date             as character    no-undo.
     1025   define stream Out-stream .
     1026       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1027       output close.
     1028       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) .
     1029       output close.
     1030   define variable str                     as character            no-undo.
     1031   define variable gds-str                 as character            no-undo.
     1032   define variable gds-str1                as character            no-undo.
     1033   define variable gds-str2                as character            no-undo.
     1034   define variable v-lines-counter         as integer              no-undo.
     1035   define variable v-tot-sum               as decimal              no-undo.
     1036   define variable v-tot-VAT               as decimal              no-undo.
     1037   define variable v-tot-sum-no-VAT        as decimal              no-undo.
     1038   define variable sym1 as char init ":" no-undo.
     1039   define variable sym2 as char init ":" no-undo.
     1040   define variable sym3 as char init ":" no-undo.
     1041   define variable sym4 as char init ":" no-undo.
     1042   define variable sym5 as char init ":" no-undo.
     1043   define variable sym6 as char init ":" no-undo.
     1044   define variable sym7 as char init ":" no-undo.
     1045   define variable sym8 as char init ":" no-undo.
     1046   define variable sym9 as char init ":" no-undo.
     1047   define variable sym10 as char init ":" no-undo.
     1048   define variable sym11 as char init ":" no-undo.
     1049   define variable sym12 as char init ":" no-undo.
     1050   define variable sym13 as char init ":" no-undo.
     1051   define variable v-single-line    as character            no-undo.
     1052   define variable v-propis         as character            no-undo.
     1053   define variable v-propis-cop     as character            no-undo.
     1054   define buffer buf_schet-fact-doc        for schet-fact-doc .
     1055   define buffer buf_schet-fact-line       for schet-fact-line .
     1056         define frame factur
     1057           sym1 column-label ":!:" format "X(1)" space(0)
     1058           buf_schet-fact-line.gds-name    column-label "Наименование товара! ":C59 format "X(59)" space(0)
     1059           sym2 column-label ":!:" format "X(1)" space(0)
     1060           buf_schet-fact-line.unit-base   column-label "Ед.!изм." format "X(4)" space(0)
     1061           sym3 column-label ":!:" format "X(1)" space(0)
     1062           buf_schet-fact-line.fact-qnty   column-label "Количество ! " format ">>>>>>9.<<<" space(0)
     1063           sym4 column-label ":!:" format "X(1)" space(0)
     1064           buf_schet-fact-line.price-rubl  column-label "Цена!за ед.изм.":C12 format "->>>>>>>9.99" space(0)
     1065           sym5 column-label ":!:" format "X(1)" space(0)
     1066           buf_schet-fact-line.sum-rubl column-label "Стоимость товаров!всего без налога":C17 format "->>>>>>>>>>>>9.99" space(0)
     1067           sym6 column-label ":!:" format "X(1)" space(0)
     1068           buf_schet-fact-line.excise column-label "в т.ч.!акциз":C9 format ">>>>>9.99" space(0)
     1069           sym7 column-label ":!:" format "X(1)" space(0)
     1070           buf_schet-fact-line.Vat-pc column-label "Ставка!налога":C6 format ">9.9<%" space(0)
     1071           sym8 column-label ":!:" format "X(1)" space(0)
     1072           buf_schet-fact-line.VAT-rubl column-label "Сумма!налога":C12 format "->>>>>>>9.99" space(0)
     1073           sym9 column-label ":!:" format "X(1)" space(0)
     1074           buf_schet-fact-line.sum-rubl-VAT column-label "Ст-ть товаров!с учетом налога":c15 format "->>>>>>>>>>9.99" space(0)
     1075           sym11 column-label ":!:" format "X(1)" space(0)
     1076           buf_schet-fact-line.country column-label "Страна!происхождения":C15 format "X(15)" space(0)
     1077           sym12 column-label ":!:" format "X(1)" space(0)
     1078           buf_schet-fact-line.gtd column-label "Номер грузовой таможенной!декларации":C26 format "X(26)" space(0)
     1079           sym13 column-label ":!:" format "X(1)" space(0)
     1080        header
     1081           ( if PAGE-NUMBER( Out-stream ) > 1
     1082             then string( "Документ N: " + v-torgconf-doc-code + " от " + v-torgconf-doc-date )
     1083             else "":U )                                                       at 40 format "X(50)"
     1084           string( "Страница " + string( PAGE-NUMBER( Out-stream ), ">>9" ) )  at 180 format "X(13)" skip
     1085           v-single-line format "X(198)" at 1
     1086        with width 235 down stream-io.
     1087   if session :set-wait-state( "compiler" ) then.
     1088     find first buf_schet-fact-doc no-lock where recid( buf_schet-fact-doc ) = rec_id .
     1089     assign
     1090       v-torgconf-doc-code = buf_schet-fact-doc.doc-code
     1091       v-torgconf-doc-date = string(buf_schet-fact-doc.doc-date,"99/99/9999")
     1092     .
     1093     assign
     1094       v-single-line   = fill("-", 198)
     1095       v-lines-counter = 1
     1096     .
     1097   output stream Out-stream to value( string( session:temp-directory +
     1098                                        "rpt" + string( g#report-num ) ) )
     1099                                        page-size  value(43) .
     1100     run facturxl-init in this-procedure .
     1101     run print-header in this-procedure .
     1102     form header
     1103       v-single-line format "X(198)" at 1 skip  "Продолжение - на следующей странице" at 30 skip
     1104       with frame Bottomframe width 235 page-bottom no-labels no-box .
     1105     view stream Out-stream frame Bottomframe .
     1106     form with frame factur .
     1107     for each buf_schet-fact-line no-lock  where buf_schet-fact-line.doc-code = buf_schet-fact-doc.doc-code
     1108     break by buf_schet-fact-line.line-num
     1109     :
     1110       run print-line in this-procedure .
     1111     end.
     1112     put stream Out-stream  v-single-line format "X(198)"   .
     1113     if line-counter( Out-stream ) + 7 > page-size( Out-stream ) then  page stream Out-stream.
     1114     run facturxl-write-cell-data in this-procedure ( input "it_SumNoVAT":U , input string( v-tot-sum-no-VAT ) ).
     1115     run facturxl-write-cell-data in this-procedure ( input "it_VATsum":U   , input string( v-tot-VAT ) ).
     1116     run facturxl-write-cell-data in this-procedure ( input "it_sum":U      , input string( v-tot-sum ) ).
     1117     run rep/wp-rub.p ( input v-tot-sum , output v-propis, output v-propis-cop ).
     1118     down stream Out-stream with frame factur .
     1119     put stream Out-stream  skip  ": Всего к оплате  " v-propis format "X(107)"
     1120       ":"   v-tot-VAT format ">>>>>>>>9.99"
     1121       ":"   v-tot-sum format ">>>>>>>>>>>9.99"
     1122       ":               :                          :"
     1123     .
     1124     put stream Out-stream v-single-line format "X(198)" at 1 .
     1125       put stream Out-stream
     1126           skip
     1127           space(5) "Руководитель предприятия" format "X(50)" "/ " fill( "_", 36 ) format "X(36)" " /"
     1128           "     Гл. бухгалтер" format "X(50)" "/ " fill( "_", 36 ) format "X(36)" " /"
     1129       .
     1130     put stream Out-stream
     1131           skip  space(10) "М.П." format "X(5)"
     1132           skip  space(5) "Выдал" format "X(50)" skip
     1133     .
     1134     run facturxl-close in this-procedure .
     1135     hide stream Out-stream frame Bottomframe .
     1136     output stream Out-stream close.
     1137   if session :set-wait-state( "" ) then.
     1138     define variable v-user-action as character no-undo .
     1139     define variable v-printed as logical   no-undo .
     1140     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     1141     os-rename
     1142         value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1143         value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1144     .
     1145     run gbl/prnfilen.w
     1146       (input  ""
     1147       ,input  8
     1148       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1149       ,input  7
     1150       ,output v-user-action
     1151       ,output v-printed
     1152       ) .
     1153     os-delete value( string( session:temp-directory ) +  "$" + string( g#report-num ) + ".txl" ) .
     1154     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     1155   end.
     1156   procedure print-more:
     1157     do on error undo, return error :
     1158       def var v-start-string as character no-undo.
     1159       def var v-add-string as character no-undo.
     1160       assign v-start-string = gds-str2 .
     1161       do while trim(v-start-string) <> "" :
     1162         assign gds-str = v-start-string.
     1163         v-add-string = breakstr(gds-str, 59, input-output v-add-string, input-output v-start-string).
     1164         display stream Out-stream
     1165           sym1 fill(" ",17) + v-add-string @ buf_schet-fact-line.gds-name sym2 sym3 sym4 sym5 sym6 sym7 sym8  sym9  sym11 sym12 sym13
     1166         with frame factur .
     1167         down stream Out-stream 1 with frame factur .
     1168       end.
     1169     end.
     1170   end procedure.
     1171   procedure print-line :
     1172     do on error undo, return error :
     1173       display stream Out-stream
     1174         sym1  buf_schet-fact-line.gds-name
     1175         sym2  buf_schet-fact-line.unit-base
     1176         sym3  buf_schet-fact-line.fact-qnty
     1177         sym4  buf_schet-fact-line.price-rubl
     1178         sym5  buf_schet-fact-line.sum-rubl
     1179         sym6  buf_schet-fact-line.excise
     1180         sym7  buf_schet-fact-line.Vat-pc
     1181         sym8  buf_schet-fact-line.VAT-rubl
     1182         sym9  buf_schet-fact-line.sum-rubl-VAT
     1183         sym11 buf_schet-fact-line.country
     1184         sym12 buf_schet-fact-line.GTD
     1185         sym13
     1186       with frame factur .
     1187       down stream Out-stream 1 with frame factur .
     1188       run facturxl-write-line-data in this-procedure (
     1189           input buf_schet-fact-line.gds-name
     1190         , input buf_schet-fact-line.unit-base
     1191         , input buf_schet-fact-line.fact-qnty
     1192         , input buf_schet-fact-line.price-rubl
     1193         , input buf_schet-fact-line.sum-rubl
     1194         , input buf_schet-fact-line.excise
     1195         , input buf_schet-fact-line.Vat-pc
     1196         , input buf_schet-fact-line.VAT-rubl
     1197         , input buf_schet-fact-line.sum-rubl-VAT
     1198         , input buf_schet-fact-line.country
     1199         , input buf_schet-fact-line.GTD
     1200       ).
     1201       assign
     1202         v-tot-sum-no-VAT  = v-tot-sum-no-VAT + buf_schet-fact-line.sum-rubl
     1203         v-tot-VAT         = v-tot-VAT        + buf_schet-fact-line.VAT-rubl
     1204         v-tot-sum         = v-tot-sum        + buf_schet-fact-line.sum-rubl-VAT
     1205         v-lines-counter   = v-lines-counter + 1
     1206       .
     1207     end.
     1208   end procedure.
     1209   procedure print-header :
     1210     define variable v-print-doc      as character           no-undo.
     1211     define variable v-par-type       as character           no-undo.
     1212     define variable t-num            as character           no-undo.
     1213     define variable v-plat-rasch-doc as character    no-undo.
     1214     define variable v-rubl-name      as character    no-undo.
     1215   define buffer buf_currency for ub.currency.
     1216   assign v-plat-rasch-doc    = "":U  .
     1217    do on error undo, return error :
     1218   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1219   empty temp-table thbjattr_thbj-attr.
     1220   run adm/shattri.p (
     1221      input "get":U
     1222     ,input v-cntxt-obj-type
     1223     ,input v-cntxt-obj-code
     1224     ,input 'prt-firm':U
     1225     ,input  ""
     1226     ,output v-value-character
     1227     ,output v-value-date
     1228     ,output v-value-decimal
     1229     ,output v-value-integer
     1230     ,output v-value-logical
     1231     ,output par-type
     1232     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1233     ) no-error .
     1234       for each thbjattr_thbj-attr :
     1235           if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     1236       end.
     1237       if v-print-doc <> 'yes'  then assign v-print-doc = "no"  .
     1238       assign  t-num = substitute( "&1         от &2 &3" , v-torgconf-doc-code , v-torgconf-doc-date
     1239              , ( if buf_schet-fact-doc.status_ <> 'факт':U then string( "(" + caps( buf_schet-fact-doc.status_ ) + ")" ) else "":U ) )
     1240       .
     1241       assign v-plat-rasch-doc = buf_schet-fact-doc.in-doc-code + " от " + string(buf_schet-fact-doc.in-doc-date, "99/99/9999") .
     1242   find first buf_currency no-lock
     1243            where buf_currency.curr-code = 0
     1244       .
     1245       assign
     1246           v-rubl-name = buf_currency.curr-name
     1247       .
     1248   put stream Out-stream
     1249                   space(25) string( "СЧЕТ-ФАКТУРА N " +  t-num ) format "X(190)"
     1250           skip(1) space(5) string( "Продавец " + fill( " ", 31 ) + buf_schet-fact-doc.cli-name ) format "X(190)"
     1251           skip    space(5) string( "Адрес "    + fill( " ", 34 ) + buf_schet-fact-doc.cli-address ) format "X(190)"
     1252           skip    space(5) string( "Идентификационный номер продавца (ИНН/КПП) " + buf_schet-fact-doc.cli-inn + "/" + buf_schet-fact-doc.cli-kpp ) format "X(190)"
     1253           skip    space(5) string( "Грузоотправитель и его адрес " + fill( " ", 10 ) + buf_schet-fact-doc.Gruz-otprav ) format "X(190)"
     1254           skip    space(5) string( "Грузополучатель и его адрес" + fill( " ", 12 ) + buf_schet-fact-doc.Gruz-poluch )   format "X(190)"
     1255           skip    space(5) string( "К платежно-расчетному документу        " + v-plat-rasch-doc ) format "X(190)"
     1256           skip(1) space(5) string( "Покупатель" + fill( " ", 29 ) + buf_schet-fact-doc.own-name ) format "X(190)"
     1257           skip    space(5) string( "Адрес" + fill( " ", 34 ) + buf_schet-fact-doc.own-address ) format "X(190)"
     1258           skip    space(5) string( "Идентификационный номер покупателя (ИНН/КПП)" + buf_schet-fact-doc.own-inn + "/" + buf_schet-fact-doc.own-kpp ) format "X(190)"
     1259           skip    space(5) string( "Валюта : " + v-rubl-name ) format "X(190)"
     1260           skip
     1261       .
     1262       run facturxl-write-cell-data in this-procedure ( input "h_docCode":U , input v-torgconf-doc-code ).
     1263       run facturxl-write-cell-data in this-procedure ( input "h_docDate":U , input v-torgconf-doc-date ).
     1264       run facturxl-write-cell-data in this-procedure ( input "h_supplier":U , input buf_schet-fact-doc.cli-name ).
     1265       run facturxl-write-cell-data in this-procedure ( input "h_supplierAddr":U , input buf_schet-fact-doc.cli-address ).
     1266       run facturxl-write-cell-data in this-procedure ( input "h_supplierINN":U , input buf_schet-fact-doc.cli-inn + "/" + buf_schet-fact-doc.cli-kpp ).
     1267       run facturxl-write-cell-data in this-procedure ( input "h_cargoFrom":U , input buf_schet-fact-doc.Gruz-otprav ).
     1268       run facturxl-write-cell-data in this-procedure ( input "h_cargoTo":U , input buf_schet-fact-doc.Gruz-poluch ).
     1269       run facturxl-write-cell-data in this-procedure ( input "h_platDoc":U , input v-plat-rasch-doc ).
     1270       run facturxl-write-cell-data in this-procedure ( input "h_saler":U   , input buf_schet-fact-doc.own-name ).
     1271       run facturxl-write-cell-data in this-procedure ( input "h_salerAddr":U , input buf_schet-fact-doc.own-address ).
     1272       run facturxl-write-cell-data in this-procedure ( input "h_salerINN":U , input buf_schet-fact-doc.own-inn + "/" + buf_schet-fact-doc.own-kpp ).
     1273       run facturxl-write-cell-data in this-procedure ( input "h_currency":U , input v-rubl-name ).
     1274   end.
     1275   end procedure.
