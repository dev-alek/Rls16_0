      931        v-cntxp-obj-code <> 0 then do:
      932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      933     (input  'is-prt'
      934     ,input  0
      935     ,input  ''
      936     ,input  0
      937     ,input  ''
      938     ,input  ''
      939     ,input  ''
      940     ,input  yes
      941     ,output v-cntxp-conf-par
      942     ,output v-cntxp-par-type
      943     ) no-error .
      944       case v-cntxp-obj-type :
      945         when 'скл':U then do:
      946           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      947           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      948           assign
      949             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      950             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      951             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      952             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      953             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      954             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      955             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      956             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      957             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      958             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      959             v-cntxp-load-time       = bf-cntxp_store.load-time
      960             v-cntxp-holidays        = bf-cntxp_store.holidays
      961             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      962             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      963             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      964             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      965             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      966             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      967             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      968             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      969             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      970             .
      971         end.
      972         when 'маг':U then do:
      973           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      974           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      975           assign
      976             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      977             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      978             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      979             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      980             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      981             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      982             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      983             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      984             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      985             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      986             v-cntxp-load-time       = bf-cntxp_shop.load-time
      987             v-cntxp-holidays        = bf-cntxp_shop.holidays
      988             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      989             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      990             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      991             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      992             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      993             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      994             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      995             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      996             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      997             .
      998         end.
      999       end case.
     1000     end.
     1001   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
