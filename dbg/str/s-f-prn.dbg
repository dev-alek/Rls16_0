      779           buf_temp_line-data.UAES         = p-UAES
      780           buf_temp_line-data.OKEI         = p-OKEI
      781           buf_temp_line-data.EI           = p-EI
      782           buf_temp_line-data.qnty         = p-qnty
      783           buf_temp_line-data.price        = p-price
      784           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
      785           buf_temp_line-data.SumActciz    = p-SumActciz
