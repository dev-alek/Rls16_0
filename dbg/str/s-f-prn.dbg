      807   end procedure.
      808   procedure facturxl-run-excel :
      809   define input parameter p-header-filename    as character        no-undo.
      810   define input parameter p-data-filename      as character        no-undo.
      811       define variable v-template-file-name    as character    no-undo.
      812       define variable v-vb-file-name          as character    no-undo.
      813       define buffer buf_temp-param for temp-param .
      814   do
      815   for buf_temp-param
      816   on error undo, return error
      817   :
      818       create buf_temp-param.
      819       assign
      820           v-template-file-name    = search( "exe/sf_97.xlt" )
      821           v-vb-file-name          = search( "exe/t_97.bas")
      822       .
      823       if v-template-file-name = ?
      824       or v-template-file-name = "":U
      825       then do:
      826           message
      827               "Ошибка имени файла шаблона."
      828           view-as alert-box error.
      829       end.
      830       if v-vb-file-name = ?
      831       or v-vb-file-name = "":U
      832       then do:
      833           message
      834               "Ошибка имени файла кода обработки."
      835           view-as alert-box error.
      836       end.
      837       run paramls-write in this-procedure (
      838             input "template":U
      839           , input "template-file-name":U
      840           , input v-template-file-name
      841       ).
      842       run paramls-write in this-procedure (
      843             input "template":U
      844           , input "vb-file-name":U
      845           , input v-vb-file-name
      846       ).
      847       run paramls-write in this-procedure (
      848             input "data":U
      849           , input "data-header-filename":U
      850           , input p-header-filename
      851       ).
      852       run paramls-write in this-procedure (
      853             input "data":U
      854           , input "data-filename":U
      855           , input p-data-filename
      856       ).
      857       run gbl/macroxlt.p (
      858           input-output table buf_temp-param
      859       ) no-error.
      860       if error-status :error
      861       then do:
      862           message
      863                    vss-workfile vss-revision vss-description
      864               skip(1)
      865               skip "Ошибка создания файла Excel."
      866               skip return-value
      867               skip trim(error-status :get-message(1))
      868                    trim(error-status :get-message(2))
      869                    trim(error-status :get-message(3))
      870           view-as alert-box error.
      871           undo, return error .
      872       end.
      873   end.
      874   end procedure.
