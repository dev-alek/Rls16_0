      395   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      396   procedure paramls-clear :
      397     define buffer buf_temp-param for temp-param .
      398     do
      399     on error undo, return error return-value
      400     :
      401       for each buf_temp-param
      402       on error undo, return error
      403       :
      404         delete buf_temp-param .
      405       end.
      406     end.
      407   end procedure.
      408   procedure paramls-write :
      409     define input  parameter p-code     as character no-undo .
      410     define input  parameter p-sub-code as character no-undo .
      411     define input  parameter p-value    as character no-undo .
      412     define buffer buf_temp-param for temp-param .
      413     do
      414     on error undo, return error return-value
      415     :
      416       find first buf_temp-param
      417         where buf_temp-param.param-code     = p-code
      418           and buf_temp-param.param-sub-code = p-sub-code
      419         no-error .
      420       if not available buf_temp-param then do:
      421         create buf_temp-param .
      422         assign
      423           buf_temp-param.param-code     = p-code
      424           buf_temp-param.param-sub-code = p-sub-code
      425         .
      426       end.
      427       assign
      428         buf_temp-param.param-value = p-value
      429       .
      430     end.
      431   end procedure.
      432   procedure paramls-read :
      433     define input  parameter p-code          as character no-undo .
      434     define input  parameter p-sub-code      as character no-undo .
      435     define input  parameter p-default-value as character no-undo .
      436     define output parameter p-value         as character no-undo .
      437     define buffer buf_temp-param for temp-param .
      438     do
      439     on error undo, return error return-value
      440     :
      441       find first buf_temp-param
      442         where buf_temp-param.param-code     = p-code
      443           and buf_temp-param.param-sub-code = p-sub-code
      444         no-error .
      445       if available buf_temp-param then do:
      446         assign
      447           p-value = buf_temp-param.param-value
      448         .
      449       end.
      450       else do:
      451         assign
      452           p-value = p-default-value
      453         .
      454       end.
      455     end.
      456   end procedure.
      457   procedure paramls-append :
      458     define input  parameter p-code     as character no-undo .
      459     define input  parameter p-sub-code as character no-undo .
      460     define input  parameter p-value    as character no-undo .
      461     define buffer buf_temp-param for temp-param .
      462     do
      463     on error undo, return error return-value
      464     :
      465       find first buf_temp-param
      466            where buf_temp-param.param-code     = p-code
      467              and buf_temp-param.param-sub-code = p-sub-code
      468         no-error .
      469       if not available buf_temp-param then do:
      470         create buf_temp-param .
      471         assign
      472           buf_temp-param.param-code     = p-code
      473           buf_temp-param.param-sub-code = p-sub-code
      474           buf_temp-param.param-value    = p-value
      475         .
      476       end.
      477       else do:
      478           assign
      479               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      480           .
      481       end.
      482     end.
      483   end procedure.
      484   define variable vss-include-info5 as character format "X(65)" no-undo
      485   initial "@(#)$Workfile$ $Revision$".
      486   define stream excel-line.
      487   define stream excel-cell.
      488   define temp-table temp_cell-data no-undo
      489       field data-key as character
      490       field data-value as character
      491       index pi is primary unique data-key
      492   .
      493   define temp-table temp_line-data no-undo
      494       field data-key     as character
      495       field xl-line-id   as integer
      496       field Name         as character
      497       field pokazately   as character
      498       field UAES         as character
      499       field OKEI         as character
      500       field EI           as character
      501       field qnty         as character
      502       field price        as character
      503       field SumNoVAT     as character
      504       field SumActciz    as character
      505       field VATpc        as character
      506       field VATsum       as character
      507       field sum          as character
      508       field countrycode  as character
      509       field country      as character
      510       field GTD          as character
      511       index pi is primary unique xl-line-id
      512   .
      513   define variable v-facturxl-current-data-row     as integer      no-undo.
      514   define variable v-facturxl-cell-file-name       as character    no-undo.
      515   define variable v-facturxl-data-file-name       as character    no-undo.
      516   procedure facturxl-init :
      517       define buffer buf_temp_cell-data        for temp_cell-data.
      518       define buffer buf_usr-flt               for ubflt.usr-flt.
      519       define variable v-column-list as character no-undo .
      520       define variable v-column-type as character no-undo .
      521       define variable v-num-cloumns as integer no-undo .
      522   do
      523   for buf_temp_cell-data
      524     , buf_usr-flt
      525   on error undo, return error
      526   :
      527       assign
      528           v-facturxl-current-data-row = 0
      529       .
      530       run gbl/_tmpfile.p (
      531             input "xd"
      532           , input ".txt"
      533           , output v-facturxl-data-file-name
      534       ).
      535       output stream excel-line to value( v-facturxl-data-file-name ).
      536       run gbl/_tmpfile.p (
      537             input "xc"
      538           , input ".txt"
      539           , output v-facturxl-cell-file-name
      540       ).
      541       output stream excel-cell to value( v-facturxl-cell-file-name ).
      542       run facturxl-write-cell-data in this-procedure (
      543             input "valutCode":U
      544           , input if printrubl then "0":U else "1":U
      545       ).
      546     if lookup ("corr" , p-mode) <> 0 then do :
      547       v-column-list = "Name,pokazately,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum":U .
      548       v-column-type = "S,S,S,I,S,D,C,C,S,D,C,C":U .
      549     end.
      550     else do :
      551       v-column-list = "Name,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum,countrycode,country,GTD":U .
      552       v-column-type = "S,S,I,S,D,C,C,S,D,C,C,I,S,S":U .
      553     end.
      554     v-num-cloumns = num-entries(v-column-list) .
      555     run facturxl-write-cell-data in this-procedure (
      556             input "columnList":U
      557           , input v-column-list
      558     ).
      559     run facturxl-write-cell-data in this-procedure (
      560             input "columnType":U
      561           , input v-column-type
      562     ).
      563     run facturxl-write-cell-data in this-procedure (
      564             input "columnAmount":U
      565           , input string(v-num-cloumns)
      566     ).
      567     if lookup ("corr" , p-mode) <> 0 then .
      568     else do :
      569       run facturxl-write-cell-data in this-procedure (
      570             input "subtotalList":U
      571           , input "SumNoVAT,VATsum,sum":U
      572       ).
      573       run facturxl-write-cell-data in this-procedure (
      574             input "subtotalType":U
      575           , input "S,S,S":U
      576       ).
      577       run facturxl-write-cell-data in this-procedure (
      578             input "subtotalAmount":U
      579           , input "3":U
      580       ).
      581     end.
      582   end.
      583   end procedure.
      584   procedure facturxl-close :
      585   do
      586   on error undo, return error
      587   :
      588       output stream excel-line close.
      589       output stream excel-cell close.
      590       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      591           export "exe/sf_97.xlt":U.
      592           export "exe/t_97.bas":U.
      593           export v-facturxl-cell-file-name.
      594           export v-facturxl-data-file-name.
      595       output close.
      596   end.
      597   end procedure.
