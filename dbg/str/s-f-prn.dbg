       79   function breakstr returns character ( input        for-name    as character,
       80                                         input        line-length as integer,
       81                                         input-output line1       as character,
       82                                         input-output line2       as character ) :
       83     define variable ii as integer no-undo.
       84     if length( for-name ) > line-length then do:
       85       assign ii    = 1
       86              line1 = "":u
       87              line2 = "":u.
       88       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       89         assign line1 =       substring( for-name, 1, line-length     )
       90                line2 = trim( substring( for-name,    line-length + 1 ) ).
       91       end.                                                     else do:
       92         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       93           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       94                  ii    = ii    + 1.
       95           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       96             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       97           end.
       98         end.
       99         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      100       end.
      101     end.                                else do:
      102       assign line1 = for-name
      103              line2 = "":u.
      104     end.
      105     return ( line1 ).
      106   end function.
      107   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
