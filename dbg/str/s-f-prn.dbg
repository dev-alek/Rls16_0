      654   procedure facturxl-write-cell-data :
      655   define input parameter p-data-key   as character        no-undo.
      656   define input parameter p-data-value as character        no-undo.
      657       define buffer buf_temp_cell-data     for temp_cell-data.
      658   do
      659   for buf_temp_cell-data
      660   on error undo, return error
      661   :
      662       find first buf_temp_cell-data
      663            where buf_temp_cell-data.data-key = p-data-key
      664       no-error.
      665       if not available buf_temp_cell-data
      666       then do:
      667           create buf_temp_cell-data.
      668           assign
      669               buf_temp_cell-data.data-key = p-data-key
      670           .
      671       end.
      672       assign
      673           buf_temp_cell-data.data-value = p-data-value
      674       .
      675       put stream excel-cell unformatted
      676                           buf_temp_cell-data.data-key
      677           chr(9)   buf_temp_cell-data.data-value
      678           chr(10)
      679       .
      680   end.
      681   end procedure.
      682   procedure facturxl-write-line-data :
      683   define input parameter p-Name          as character        no-undo.
      684   define input parameter p-UAES          as character        no-undo.
      685   define input parameter p-OKEI          as character        no-undo.
      686   define input parameter p-EI            as character        no-undo.
      687   define input parameter p-qnty          as character        no-undo.
      688   define input parameter p-price         as character        no-undo.
      689   define input parameter p-SumNoVAT      as character        no-undo.
      690   define input parameter p-SumActciz     as character        no-undo.
      691   define input parameter p-VATpc         as character        no-undo.
      692   define input parameter p-VATsum        as character        no-undo.
      693   define input parameter p-sum           as character        no-undo.
      694   define input parameter p-countrycode   as character        no-undo.
      695   define input parameter p-country       as character        no-undo.
      696   define input parameter p-GTD           as character        no-undo.
      697       define buffer buf_temp_line-data        for temp_line-data.
      698   do
      699   for buf_temp_line-data
      700   on error undo, return error
      701   :
      702       for each buf_temp_line-data
      703       :
      704           delete buf_temp_line-data.
      705       end.
      706       create buf_temp_line-data.
      707       assign
      708           v-facturxl-current-data-row = v-facturxl-current-data-row + 1
      709       .
      710       assign
      711           buf_temp_line-data.data-key     = "LD":U
      712           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
      713           buf_temp_line-data.Name         = p-Name
      714           buf_temp_line-data.UAES         = p-UAES
      715           buf_temp_line-data.OKEI         = p-OKEI
      716           buf_temp_line-data.EI           = p-EI
      717           buf_temp_line-data.qnty         = p-qnty
      718           buf_temp_line-data.price        = p-price
      719           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
      720           buf_temp_line-data.SumActciz    = p-SumActciz
      721           buf_temp_line-data.VATpc        = p-VATpc
      722           buf_temp_line-data.VATsum       = p-VATsum
      723           buf_temp_line-data.sum          = p-sum
      724           buf_temp_line-data.countrycode  = p-countrycode
      725           buf_temp_line-data.country      = p-country
      726           buf_temp_line-data.GTD          = p-GTD
      727       .
      728       put stream excel-line unformatted
      729                           buf_temp_line-data.data-key
      730           chr(9)   buf_temp_line-data.Name
      731           chr(9)   buf_temp_line-data.UAES
      732           chr(9)   buf_temp_line-data.OKEI
      733           chr(9)   buf_temp_line-data.EI
      734           chr(9)   buf_temp_line-data.qnty
      735           chr(9)   buf_temp_line-data.price
      736           chr(9)   buf_temp_line-data.SumNoVAT
      737           chr(9)   buf_temp_line-data.SumActciz
      738           chr(9)   buf_temp_line-data.VATpc
      739           chr(9)   buf_temp_line-data.VATsum
      740           chr(9)   buf_temp_line-data.sum
      741           chr(9)   buf_temp_line-data.countrycode
      742           chr(9)   buf_temp_line-data.country
      743           chr(9)   buf_temp_line-data.GTD
      744           chr(10)
      745       .
      746   end.
      747   end procedure.
      748   procedure facturxl-write-line-data-corr :
      749   define input parameter p-Name          as character        no-undo.
