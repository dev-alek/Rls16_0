        1   define input parameter parparentproc  as widget-handle  no-undo.
        2   define input parameter p-status       as character      no-undo.
        3   define input parameter p-store-type   as character      no-undo.
        4   define input parameter p-store-code   as integer        no-undo.
        5   define input parameter p-userid       as character      no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Список План-меню или Счет-заказов".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298     define variable v-cntxt-db-num        as integer   no-undo .
      299     define variable v-cntxt-userid        as character no-undo .
      300     define variable v-cntxt-level         as character no-undo .
      301     define variable v-cntxt-host-code-obj as integer   no-undo .
      302     define variable v-cntxt-obj-type      as character no-undo .
      303     define variable v-cntxt-obj-code      as integer   no-undo .
      304     define variable v-cntxt-db-num-obj    as integer   no-undo .
      305     define variable v-cntxt-is-admin      as logical   no-undo .
      306   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure doc-code:
      308   define input  parameter parmode          as   character           no-undo.
      309   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      310   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      311   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      312   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      313   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      314   define variable vardb-remote     as   logical             no-undo.
      315   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      316   define variable v-delimiter as character no-undo .
      317   do
      318   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      319   :
      320   find first buf_sys-ctrl no-lock .
      321   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      322     CASE parmode:
      323       when "main":u then do:
      324         if vardb-remote then do:
      325           assign
      326             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      327         end.
      328         else do:
      329           assign
      330             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      331         end.
      332       end.
      333       when "trio" then do:
      334         assign
      335           pardoc-code = replace (parroot-doc-code, "=", "*").
      336       end.
      337       otherwise do:
      338         assign
      339         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      340         no-error
      341         .
      342         if error-status:error  then do:
      343           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      344                                         ,chr(10)
      345                                         ,parmode
      346                                         ).
      347         end.
      348         if num-entries(parmode) = 1
      349         and parmode <> "chip":U
      350         and parmode <> "chip_s":U
      351         then do:
      352           assign
      353           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      354         end.
      355         else if (lookup("chip":U, parmode) > 0
      356                  or
      357                  lookup("chip_s":U, parmode) > 0) then do:
      358           assign
      359             vartemp-doc-code = parroot-doc-code.
      360           do while true:
      361             if index (vartemp-doc-code , ".") = 0 then
      362               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      363             else
      364               vartemp-doc-code  =
      365               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      366               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      367               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      368             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      369           end.
      370           assign
      371             pardoc-code = vartemp-doc-code.
      372         end.
      373       end.
      374     end CASE.
      375     if pardoc-code = '':U
      376     or (parroot-doc-code <> '':U
      377     and pardoc-code = parroot-doc-code) then do:
      378       undo, return error substitute("Ошибка при генерации номера документа&1"
      379                                     ,chr(10)).
      380     end.
      381   end.
      382   end. // procedure/method
      383   function get-doc-code-int64 returns int64
      384     ( input p-doc-code as character ) :
      385     define variable v-ind              as integer   no-undo .
      386     define variable v-num-entries      as integer   no-undo .
      387     define variable v-doc-code-int64   as int64     no-undo .
      388     define variable v-canonic-doc-code as character no-undo .
      389     assign
      390       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      391       v-canonic-doc-code = p-doc-code
      392     .
      393     do v-ind = 1 to v-num-entries
      394     :
      395       assign
      396         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      397       .
      398     end.
      399     assign
      400       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      401     .
      402     return v-doc-code-int64 .
      403   end. // function/method
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      406   procedure partslib-clear-temp-parts :
      407     define buffer buf_temp-parts for temp-parts .
      408     do
      409     on error undo, return error
      410     :
      411       for each buf_temp-parts
      412       on error undo, return error
      413       :
      414         delete buf_temp-parts .
      415       end.
      416     end.
      417   end procedure.
      418   procedure partslib-create-temp-parts :
      419     define parameter buffer buf_parts       for ub.parts .
      420     define parameter buffer buf_temp-parts  for temp-parts .
      421     define input  parameter p-goods-twounit as logical   no-undo .
      422     define variable v-base-part-code as character no-undo .
      423     do
      424     on error undo, return error
      425     :
      426       if p-goods-twounit = true
      427       then do:
      428         assign
      429           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      430         .
      431       end.
      432       else do:
      433         assign
      434           v-base-part-code = buf_parts.part-code
      435         .
      436       end.
      437       find first buf_temp-parts exclusive-lock
      438         where buf_temp-parts.obj-type  = buf_parts.obj-type
      439           and buf_temp-parts.obj-code  = buf_parts.obj-code
      440           and buf_temp-parts.artic     = buf_parts.artic
      441           and buf_temp-parts.prod-type = buf_parts.prod-type
      442           and buf_temp-parts.prod-code = buf_parts.prod-code
      443           and buf_temp-parts.in-code   = buf_parts.in-code
      444           and buf_temp-parts.out-code  = 'free-zone':U
      445           and buf_temp-parts.part-code = v-base-part-code
      446         no-error.
      447       if not available buf_temp-parts
      448       then do:
      449         create buf_temp-parts .
      450         buffer-copy buf_parts to buf_temp-parts
      451         assign
      452           buf_temp-parts.out-code  = 'free-zone':U
      453           buf_temp-parts.part-code = v-base-part-code
      454           buf_temp-parts.rsrv-free = yes
      455           buf_temp-parts.status_   = no
      456           buf_temp-parts.qnty      = 0
      457           buf_temp-parts.fact-qnty = 0
      458           buf_temp-parts.real-qnty = 0
      459           buf_temp-parts.cli-qnty  = 0
      460         .
      461       end.
      462     end.
      463   end procedure.
      464   procedure partslib-init-temp-parts :
      465     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      466     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      467     define input parameter p-artic           like ub.parts.artic     no-undo .
      468     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      469     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      470     define buffer buf_parts      for ub.parts .
      471     define buffer buf_temp-parts for temp-parts .
      472     define variable v-goods-twounit    as logical   no-undo .
      473     do
      474     on error undo, return error
      475     :
      476   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      478     (input  p-artic
      479     ,input  p-prod-type
      480     ,input  p-prod-code
      481     ,input  'twounit=request':u
      482     ,output v-goods-twounit
      483     ) no-error .
      484       if error-status :error
      485       then do:
      486         message
      487           vss-workfile vss-revision vss-description skip
      488           vss-include-info3 skip
      489           "Ошибка при определении атрибута товара" skip
      490           "Артикул" p-artic p-prod-type p-prod-code skip
      491           "twounit=request" skip
      492           error-status :get-message(1) skip
      493           return-value skip
      494           view-as alert-box error .
      495         undo, return error return-value .
      496       end.
      497       run partslib-clear-temp-parts in this-procedure .
      498       for each buf_parts
      499         where buf_parts.obj-type  = p-obj-type
      500           and buf_parts.obj-code  = p-obj-code
      501           and buf_parts.artic     = p-artic
      502           and buf_parts.prod-type = p-prod-type
      503           and buf_parts.prod-code = p-prod-code
      504           and buf_parts.rsrv-free = yes
      505           and buf_parts.status_   = no
      506           and buf_parts.in-code   <> buf_parts.out-code
      507       on error undo, return error
      508       :
      509         run partslib-create-temp-parts in this-procedure
      510           (buffer buf_parts
      511           ,buffer buf_temp-parts
      512           ,input  v-goods-twounit
      513           ) .
      514         define variable v-parts-qnty          as decimal   no-undo .
      515         define variable v-parts-cli-qnty      as decimal   no-undo .
      516         define variable v-parts-free-qnty     as decimal   no-undo .
      517         define variable v-parts-free-cli-qnty as decimal   no-undo .
      518         if buf_parts.out-code = 'free-zone':U
      519         then do:
      520           assign
      521             v-parts-qnty          = buf_parts.qnty
      522             v-parts-cli-qnty      = buf_parts.cli-qnty
      523             v-parts-free-qnty     = buf_parts.qnty
      524             v-parts-free-cli-qnty = buf_parts.cli-qnty
      525           .
      526         end.
      527         else do:
      528           assign
      529             v-parts-qnty          = abs(buf_parts.qnty)
      530             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      531             v-parts-free-qnty     = 0
      532             v-parts-free-cli-qnty = 0
      533           .
      534         end.
      535         assign
      536           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      537           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      538           buf_temp-parts.real-qnty     = 0
      539           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      540           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      541           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      542         .
      543       end.
      544     end.
      545   end procedure.
      546   procedure partslib-init-temp-parts-by-factord :
      547     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      548     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      549     define input parameter p-artic              like ub.parts.artic     no-undo .
      550     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      551     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      552     define input parameter p-fact-order         as decimal   no-undo .
      553     define input parameter p-include-fact-order as logical   no-undo .
      554     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      555     define buffer buf_gds-obj  for ub.gds-obj .
      556     do
      557     on error undo, return error
      558     :
      559       do transaction
      560       on error undo, return error
      561       :
      562   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      564     (input  p-obj-type
      565     ,input  p-obj-code
      566     ,input  p-artic
      567     ,input  p-prod-type
      568     ,input  p-prod-code
      569     ,buffer buf_gds-obj
      570     ) no-error .
      571         if error-status :error
      572         then do:
      573           message
      574             vss-workfile vss-revision vss-description skip
      575             vss-include-info3 skip
      576             "Невозможно найти товар на объекте" skip
      577             "Объект" p-obj-type p-obj-code skip
      578             "Артикул" p-artic p-prod-type p-prod-code skip
      579             error-status :get-message(1) skip
      580             return-value skip
      581             view-as alert-box error .
      582           undo, return error .
      583         end.
      584         find current buf_gds-obj exclusive-lock .
      585       end.
      586       run partslib-init-temp-parts in this-procedure
      587         (input p-obj-type
      588         ,input p-obj-code
      589         ,input p-artic
      590         ,input p-prod-type
      591         ,input p-prod-code
      592         ) no-error .
      593       if error-status :error
      594       then do:
      595         message
      596           vss-workfile vss-revision vss-description skip
      597           vss-include-info3 skip
      598           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      599           "Объект" p-obj-type p-obj-code skip
      600           "Артикул" p-artic p-prod-type p-prod-code skip
      601           "p-fact-order" p-fact-order skip
      602           view-as alert-box error .
      603         undo, return error .
      604       end.
      605       if p-include-fact-order = true
      606       then do:
      607         assign
      608           p-fact-order = p-fact-order - 0.0000000001
      609         .
      610       end.
      611       define variable v-max-fact-order as character no-undo .
      612       run factord-max-fact-order in this-procedure
      613         (output v-max-fact-order
      614         ) no-error .
      615       if error-status :error
      616       then do:
      617         message
      618           vss-workfile vss-revision vss-description skip
      619           vss-include-info3 skip
      620           "Ошибка при вызове процедуры factord-max-fact-order" skip
      621           "Объект" p-obj-type p-obj-code skip
      622           "Артикул" p-artic p-prod-type p-prod-code skip
      623           "p-fact-order" p-fact-order skip
      624           view-as alert-box error .
      625         undo, return error .
      626       end.
      627       run partslib-update-by-factord in this-procedure
      628         (input p-obj-type
      629         ,input p-obj-code
      630         ,input p-artic
      631         ,input p-prod-type
      632         ,input p-prod-code
      633         ,input p-fact-order
      634         ,input v-max-fact-order
      635         ,input false
      636         ) no-error .
      637       if error-status :error
      638       then do:
      639         message
      640           vss-workfile vss-revision vss-description skip
      641           vss-include-info3 skip
      642           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      643           "Объект" p-obj-type p-obj-code skip
      644           "Артикул" p-artic p-prod-type p-prod-code skip
      645           "p-fact-order" p-fact-order skip
      646           "v-max-fact-order" v-max-fact-order skip
      647           view-as alert-box error .
      648         undo, return error .
      649       end.
      650     end.
      651   end procedure.
      652   procedure partslib-update-by-factord :
      653     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      654     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      655     define input parameter p-artic              like ub.parts.artic     no-undo .
      656     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      657     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      658     define input parameter p-start-fact-order   as decimal   no-undo .
      659     define input parameter p-end-fact-order     as decimal   no-undo .
      660     define input parameter p-lock-gds-obj       as logical   no-undo .
      661     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      662     define buffer buf_gds-obj  for ub.gds-obj .
      663     define buffer buf_doc-line for ub.doc-line .
      664     define variable v-total-parts-qnty as decimal   no-undo .
      665     define variable v-goods-gds-goods  as logical   no-undo .
      666     define variable v-goods-twounit    as logical   no-undo .
      667     do
      668     on error undo, return error
      669     :
      670       if p-start-fact-order > p-end-fact-order
      671       then do:
      672         message
      673           vss-workfile vss-revision vss-description skip
      674           vss-include-info3 skip
      675           "Ошибка задания входных параметров" skip
      676           "Начало интервала превышает конец интервала" skip
      677           "Объект" p-obj-type p-obj-code skip
      678           "Артикул" p-artic p-prod-type p-prod-code skip
      679           "p-start-fact-order" p-start-fact-order skip
      680           "p-end-fact-order"   p-end-fact-order skip
      681           view-as alert-box error .
      682         undo, return error .
      683       end.
      684       if p-lock-gds-obj = true
      685       then do:
      686         do transaction
      687         on error undo, return error
      688         :
      689   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      691     (input  p-obj-type
      692     ,input  p-obj-code
      693     ,input  p-artic
      694     ,input  p-prod-type
      695     ,input  p-prod-code
      696     ,buffer buf_gds-obj
      697     ) no-error .
      698           if error-status :error
      699           then do:
      700             message
      701               vss-workfile vss-revision vss-description skip
      702               vss-include-info3 skip
      703               "Невозможно найти gds-obj" skip
      704               error-status :get-message(1) skip
      705               return-value skip
      706               view-as alert-box error .
      707             undo, return error .
      708           end.
      709           find current buf_gds-obj exclusive-lock .
      710         end.
      711       end.
      712   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      714     (input  p-artic
      715     ,input  p-prod-type
      716     ,input  p-prod-code
      717     ,input  'gds-goods=request':u
      718     ,output v-goods-gds-goods
      719     ) no-error .
      720       if error-status :error
      721       then do:
      722         message
      723           vss-workfile vss-revision vss-description skip
      724           vss-include-info3 skip
      725           "Ошибка при определении атрибута товара" skip
      726           "Артикул" p-artic p-prod-type p-prod-code skip
      727           "gds-goods=request" skip
      728           error-status :get-message(1) skip
      729           return-value skip
      730           view-as alert-box error .
      731         undo, return error return-value .
      732       end.
      733   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      735     (input  p-artic
      736     ,input  p-prod-type
      737     ,input  p-prod-code
      738     ,input  'twounit=request':u
      739     ,output v-goods-twounit
      740     ) no-error .
      741       if error-status :error
      742       then do:
      743         message
      744           vss-workfile vss-revision vss-description skip
      745           vss-include-info3 skip
      746           "Ошибка при определении атрибута товара" skip
      747           "Артикул" p-artic p-prod-type p-prod-code skip
      748           "twounit=request" skip
      749           error-status :get-message(1) skip
      750           return-value skip
      751           view-as alert-box error .
      752         undo, return error return-value .
      753       end.
      754       for each buf_doc-line no-lock
      755         where buf_doc-line.obj-type   = p-obj-type
      756           and buf_doc-line.obj-code   = p-obj-code
      757           and buf_doc-line.artic      = p-artic
      758           and buf_doc-line.prod-type  = p-prod-type
      759           and buf_doc-line.prod-code  = p-prod-code
      760           and buf_doc-line.status_    = 'факт':U
      761           and buf_doc-line.fact-order > p-start-fact-order
      762           and buf_doc-line.fact-order <= p-end-fact-order
      763       on error undo, return error
      764       :
      765         run partslib-process-document in this-procedure
      766           (input  buf_doc-line.doc-code
      767           ,input  p-obj-type
      768           ,input  p-obj-code
      769           ,input  p-artic
      770           ,input  p-prod-type
      771           ,input  p-prod-code
      772           ,input  v-goods-gds-goods
      773           ,input  v-goods-twounit
      774           ,output v-total-parts-qnty
      775           ) no-error .
      776         if error-status :error
      777         then do:
      778           message
      779             vss-workfile vss-revision vss-description skip
      780             vss-include-info3 skip
      781             "Ошибка при вызове процедуры partslib-process-document" skip
      782             "Документ" buf_doc-line.doc-code skip
      783             "Объект" p-obj-type p-obj-code skip
      784             "Артикул" p-artic p-prod-type p-prod-code skip
      785             "p-start-fact-order" p-start-fact-order skip
      786             "p-end-fact-order" p-end-fact-order skip
      787             error-status :get-message(1) skip
      788             return-value skip
      789             view-as alert-box error .
      790           undo, return error return-value .
      791         end.
      792       end.
      793     end.
      794   end procedure.
      795   procedure partslib-process-document :
      796     define input  parameter p-doc-code         as character no-undo .
      797     define input  parameter p-obj-type         as character no-undo .
      798     define input  parameter p-obj-code         as integer   no-undo .
      799     define input  parameter p-artic            as character no-undo .
      800     define input  parameter p-prod-type        as character no-undo .
      801     define input  parameter p-prod-code        as integer   no-undo .
      802     define input  parameter p-goods-gds-goods  as logical   no-undo .
      803     define input  parameter p-goods-twounit    as logical   no-undo .
      804     define output parameter p-total-parts-qnty as decimal   no-undo .
      805     define variable v-parts-sign as integer   no-undo .
      806     define buffer buf_trn-doc    for ub.trn-doc .
      807     define buffer buf_doc-line   for ub.doc-line .
      808     define buffer buf_parts      for ub.parts .
      809     define buffer buf_temp-parts for temp-parts .
      810     do
      811     on error undo, return error return-value
      812     :
      813       find first buf_trn-doc no-lock
      814         where buf_trn-doc.doc-code = p-doc-code
      815         no-error .
      816       if not available buf_trn-doc
      817       then do:
      818         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      819                                      ,p-doc-code
      820                                      ) .
      821       end.
      822       case buf_trn-doc.doc-type
      823       :
      824         when 'при':U or
      825         when 'возврат':U or
      826         when 'инв':U
      827         then do:
      828           assign
      829             v-parts-sign = -1
      830           .
      831         end.
      832         when 'рас':U or
      833         when 'спи':U
      834         then do:
      835           assign
      836             v-parts-sign = 1
      837           .
      838         end.
      839         otherwise do:
      840           undo, return error substitute("Неизвестный тип документа &1"
      841                                       ,buf_trn-doc.doc-type
      842                                       ) .
      843         end.
      844       end.
      845       find first buf_doc-line no-lock
      846         where buf_doc-line.doc-code  = p-doc-code
      847           and buf_doc-line.artic     = p-artic
      848           and buf_doc-line.prod-type = p-prod-type
      849           and buf_doc-line.prod-code = p-prod-code
      850         no-error .
      851       if not available buf_doc-line
      852       then do:
      853         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      854                                      ,p-doc-code
      855                                      ,artic
      856                                      ,prod-type
      857                                      ,prod-code
      858                                      ) .
      859       end.
      860       assign
      861         p-total-parts-qnty = 0
      862       .
      863       if p-goods-gds-goods = true
      864       then do:
      865         for each buf_parts no-lock
      866           where buf_parts.out-code  = p-doc-code
      867             and buf_parts.obj-type  = p-obj-type
      868             and buf_parts.obj-code  = p-obj-code
      869             and buf_parts.artic     = p-artic
      870             and buf_parts.prod-type = p-prod-type
      871             and buf_parts.prod-code = p-prod-code
      872         on error undo, return error
      873         :
      874           run partslib-create-temp-parts in this-procedure
      875             (buffer buf_parts
      876             ,buffer buf_temp-parts
      877             ,input  p-goods-twounit
      878             ) .
      879           assign
      880             p-total-parts-qnty        = p-total-parts-qnty
      881                                       + v-parts-sign * buf_parts.fact-qnty
      882             buf_temp-parts.qnty       = buf_temp-parts.qnty
      883                                       + v-parts-sign * buf_parts.fact-qnty
      884             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      885                                       + v-parts-sign * buf_parts.fact-qnty
      886             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      887                                       + v-parts-sign * buf_parts.cli-qnty
      888           .
      889           if buf_temp-parts.qnty = 0
      890           then do:
      891             delete buf_temp-parts .
      892           end.
      893         end.
      894       end.
      895       else do:
      896         assign
      897           p-total-parts-qnty = p-total-parts-qnty
      898                              + v-parts-sign * buf_doc-line.fact-qnty
      899         .
      900       end.
      901     end.
      902   end procedure.
      903   procedure partslib-init-temp-parts-by-date :
      904     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      905     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      906     define input parameter p-artic           like ub.parts.artic     no-undo .
      907     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      908     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      909     define input parameter p-fact-date       as date      no-undo .
      910     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      911     do
      912     on error undo, return error
      913     :
      914       define variable v-fact-order                as decimal   no-undo .
      915       define variable v-shift-end-fact-order      as decimal   no-undo .
      916       define variable v-day-end-fact-order        as decimal   no-undo .
      917       run factord in this-procedure
      918         (input  p-fact-date
      919         ,input  1
      920         ,input  1
      921         ,input  ?
      922         ,input  0
      923         ,input  false
      924         ,output v-fact-order
      925         ,output v-shift-end-fact-order
      926         ,output v-day-end-fact-order
      927         ) no-error .
      928       if error-status :error
      929       then do:
      930         message
      931           vss-workfile vss-revision vss-description skip
      932           vss-include-info3 skip
      933           "Ошибка при определении момента времени, на который требуется остаток" skip
      934           "Объект" p-obj-type p-obj-code skip
      935           "Артикул" p-artic p-prod-type p-prod-code skip
      936           "Дата" p-fact-date skip
      937           view-as alert-box error .
      938         undo, return error .
      939       end.
      940       run partslib-init-temp-parts-by-factord in this-procedure
      941         (input p-obj-type
      942         ,input p-obj-code
      943         ,input p-artic
      944         ,input p-prod-type
      945         ,input p-prod-code
      946         ,input v-day-end-fact-order
      947         ,input false
      948         ) no-error .
      949       if error-status :error
      950       then do:
      951         message
      952           vss-workfile vss-revision vss-description skip
      953           vss-include-info3 skip
      954           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      955           "Объект" p-obj-type p-obj-code skip
      956           "Артикул" p-artic p-prod-type p-prod-code skip
      957           "Дата" p-fact-date skip
      958           view-as alert-box error .
      959         undo, return error .
      960       end.
      961     end.
      962   end procedure.
      963   procedure partslib-calc-cost :
      964     define output parameter p-fact-qnty      as decimal   no-undo .
      965     define output parameter p-vat-pc         as decimal   no-undo .
      966     define output parameter p-slt-pc         as decimal   no-undo .
      967     define output parameter p-sum-base       as decimal   no-undo .
      968     define output parameter p-sum-rubl       as decimal   no-undo .
      969     define output parameter p-vat-base       as decimal   no-undo .
      970     define output parameter p-vat-rubl       as decimal   no-undo .
      971     define output parameter p-slt-base       as decimal   no-undo .
      972     define output parameter p-slt-rubl       as decimal   no-undo .
      973     define output parameter p-road-tax-base  as decimal   no-undo .
      974     define output parameter p-road-tax-rubl  as decimal   no-undo .
      975     define output parameter p-transport-base as decimal   no-undo .
      976     define output parameter p-transport-rubl as decimal   no-undo .
      977     define output parameter p-other-base     as decimal   no-undo .
      978     define output parameter p-other-rubl     as decimal   no-undo .
      979     define output parameter p-excise-base    as decimal   no-undo .
      980     define output parameter p-excise-rubl    as decimal   no-undo .
      981     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      982     do
      983     on error undo, return error return-value
      984     :
      985       define buffer buf_temp-parts for temp-parts .
      986       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      987       define buffer   in-vatp-parts    for ub.parts   .
      988       define buffer   in-vatp-doc      for ub.trn-doc .
      989       define buffer   in-vatp-goods    for ub.goods   .
      990       define buffer   in-vatp-sysconf  for ub.sysconf .
      991       define buffer   in-vatp_doc-attr for ub.doc-attr.
      992       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      993       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      994       define variable varinvprb                  as   character              no-undo.
      995       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      996       define variable cli-base-rate              as   decimal                no-undo.
      997       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      998       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      999       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1000       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1001       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1002       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1003       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1004       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1005       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1006       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1007       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1008       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1009       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1010       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1011       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1012       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1013       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1014       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1015       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1016       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1017       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1018       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1019       define variable varinvatp-envd             as   character              no-undo.
     1020       define variable varinvatp-type             as   character              no-undo.
     1021       for each buf_temp-parts
     1022       on error undo, return error
     1023       :
     1024   assign
     1025     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1026     price-base-with-tax-loc = buf_temp-parts.price-base
     1027   .
     1028   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1030     (output varinvprb
     1031     )  .
     1032     if buf_temp-parts.out-code = 'free-zone':U     or
     1033        buf_temp-parts.out-code = 'out-zone':U   or
     1034        buf_temp-parts.doc-type = 'акт':U then do:
     1035       assign
     1036         in-vatp-have-vat-slt = yes.
     1037     end.
     1038     else do:
     1039       find first in-vatp_doc-attr no-lock
     1040         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1041           and in-vatp_doc-attr.attr-code = 'envd':U
     1042         no-error .
     1043       if not available in-vatp_doc-attr then do:
     1044         assign
     1045           in-vatp-have-vat-slt = yes.
     1046       end.
     1047       else do:
     1048            in-vatp-have-vat-slt = no.
     1049       end.
     1050     end.
     1051     assign
     1052      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1053      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1054     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1055              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1056     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1057             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1058             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1059             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1060             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1061             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1062             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1063       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1064     assign
     1065       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1066     assign
     1067       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1068       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1069       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1070       transport-cli-loc  = 0
     1071       other-cli-loc      = 0
     1072     .
     1073   ASSIGN
     1074             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1075       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1076   .
     1077         assign
     1078           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1079           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1080           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1081           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1082           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1083           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1084           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1085           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1086           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1087           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1088           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1089           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1090           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1091           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1092           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1093           p-excise-base    = p-excise-base    + 0
     1094           p-excise-rubl    = p-excise-rubl    + 0
     1095         .
     1096       end.
     1097       if p-fact-qnty      = ?
     1098       or p-sum-base       = ?
     1099       or p-sum-rubl       = ?
     1100       or p-vat-base       = ?
     1101       or p-vat-rubl       = ?
     1102       or p-slt-base       = ?
     1103       or p-slt-rubl       = ?
     1104       or p-road-tax-base  = ?
     1105       or p-road-tax-rubl  = ?
     1106       or p-transport-base = ?
     1107       or p-transport-rubl = ?
     1108       or p-other-base     = ?
     1109       or p-other-rubl     = ?
     1110       or p-excise-base    = ?
     1111       or p-excise-rubl    = ?
     1112       then do:
     1113         message
     1114           vss-workfile vss-revision vss-description skip
     1115           vss-include-info3 skip
     1116           "Программа in-vatp.i вернула неопределенные значения" skip
     1117           "p-fact-qnty"      p-fact-qnty      skip
     1118           "p-sum-base"       p-sum-base       skip
     1119           "p-sum-rubl"       p-sum-rubl       skip
     1120           "p-vat-base"       p-vat-base       skip
     1121           "p-vat-rubl"       p-vat-rubl       skip
     1122           "p-slt-base"       p-slt-base       skip
     1123           "p-slt-rubl"       p-slt-rubl       skip
     1124           "p-road-tax-base"  p-road-tax-base  skip
     1125           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1126           "p-transport-base" p-transport-base skip
     1127           "p-transport-rubl" p-transport-rubl skip
     1128           "p-other-base"     p-other-base     skip
     1129           "p-other-rubl"     p-other-rubl     skip
     1130           "p-excise-base"    p-excise-base    skip
     1131           "p-excise-rubl"    p-excise-rubl    skip
     1132           view-as alert-box error .
     1133         undo, return error .
     1134       end.
     1135     end.
     1136   end procedure.
     1137   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1138       def var log-file-name as char no-undo.
     1139       if search('fbrpln.log') = ?
     1140       then do:
     1141           assign
     1142               log-file-name = ""
     1143           .
     1144       end.
     1145       else do:
     1146           assign
     1147               log-file-name = 'fbrpln.log'
     1148           .
     1149       end.
     1150       DEF STREAM stm-log.
     1151       PROCEDURE writelog:
     1152       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     1153       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     1154       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     1155       if p-file-name <> ""
     1156       then do:
     1157       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     1158           PUT STREAM stm-log UNFORMATTED chr(10).
     1159           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     1160                                           OR p-log-string = "&Line") THEN "" ELSE
     1161                                           cur-time-string-sec() + " ").
     1162           PUT STREAM stm-log UNFORMATTED
     1163                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     1164                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1165                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     1166       OUTPUT STREAM stm-log CLOSE.
     1167       end.
     1168       END PROCEDURE.
