     7084                        vss-workfile vss-revision vss-description
     7085                   skip "Ошибка изменения документа план-меню."
     7086                   skip return-value
     7087                   skip trim(error-status :get-message(1))
     7088                        trim(error-status :get-message(2))
     7089                        trim(error-status :get-message(3))
     7090               view-as alert-box error.
