     1712   procedure fbrlib_get-default-pay-code :
     1713   define input parameter p-obj-type   as character        no-undo.
     1714   define input parameter p-obj-code   as integer          no-undo.
     1715   define output parameter p-pay-code  as integer          no-undo.
     1716   define variable v-host-code as integer no-undo .
     1717   define buffer buf_shop          for ub.shop.
     1718   define buffer buf_store         for ub.store.
     1719   define buffer buf_sysconf       for ub.sysconf.
     1720   do
     1721   for buf_shop
     1722     , buf_store
     1723     , buf_sysconf
     1724   on error undo, return error
     1725   :
     1726     case p-obj-type  :
     1727       when 'маг':U then do:
     1728           find first buf_shop no-lock
     1729                 where buf_shop.obj-code = p-obj-code
     1730           no-error.
     1731           if available buf_shop
     1732           then do:
     1733               assign
     1734                   p-pay-code = buf_shop.fbr-pay
     1735               .
     1736           end.
     1737       end.
     1738       when 'скл':U then do:
     1739           find first buf_store no-lock
     1740                 where buf_store.obj-code = p-obj-code
     1741           no-error.
     1742           if available buf_store
     1743           then do:
     1744               assign
     1745                   p-pay-code = buf_store.fbr-pay
     1746               .
     1747           end.
     1748       end.
     1749     end case.
     1750     if p-pay-code = ?
     1751     or p-pay-code = 0
     1752     then do:
     1753   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1755     (input  p-obj-type
     1756     ,input  p-obj-code
     1757     ,output v-host-code
     1758     )  .
     1759         find first buf_sysconf no-lock
     1760               where buf_sysconf.host-code = v-host-code
     1761         no-error.
     1762         if available buf_sysconf
     1763         then do:
     1764             assign
     1765                 p-pay-code = buf_sysconf.fbr-pay
     1766             .
     1767         end.
     1768     end.
     1769     if p-pay-code = ?
     1770     or p-pay-code = 0
     1771     then do:
     1772   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1774     (input  p-obj-type
     1775     ,input  p-obj-code
     1776     ,output p-pay-code
     1777     )  .
     1778     end.
     1779   end.
     1780   end procedure.
     1781   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1782   do
     1783   on error undo, return error
     1784   :
     1785   define input parameter p-fbr-doc-code as character    no-undo.
     1786       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1787       define variable v-gds-name      as character    no-undo.
     1788       define buffer buf_fbr-doc               for ub.fbr-doc.
     1789       define buffer buf_fbr-line              for ub.fbr-line.
     1790       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1791       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1792       find first buf_fbr-doc no-lock
     1793            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1794       .
     1795       for each buf_temp_fbrlib_recipe
     1796       :
     1797           delete buf_temp_fbrlib_recipe.
     1798       end.
     1799       for each buf_fbr-line no-lock
     1800          where buf_fbr-line.doc-code = p-fbr-doc-code
     1801       :
     1802           find first buf_temp_fbrlib_recipe
     1803                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1804           no-error.
     1805           if not available buf_temp_fbrlib_recipe
     1806           then do:
     1807               create buf_temp_fbrlib_recipe.
     1808               assign
     1809                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1810                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1811               .
     1812           end.
     1813       end.
     1814       for each buf_temp_fbrlib_recipe
     1815       :
     1816           assign
     1817               buf_temp_fbrlib_recipe.count-income                = 0
     1818               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1819               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1820               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1821               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1822               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1823               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1824               buf_temp_fbrlib_recipe.count-write-off             = 0
     1825               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1826               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1827               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1828               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1829               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1830               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1831           .
     1832           for each buf_fbr-line no-lock
     1833              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1834                and buf_fbr-line.trn-type     = 'при':U
     1835                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1836           :
     1837               if ( buf_fbr-line.price-base   = ?
     1838                   or buf_fbr-line.price-rubl = ?
     1839                   or buf_fbr-line.price-base <= 0
     1840                   or buf_fbr-line.price-rubl <= 0 )
     1841               and buf_fbr-line.fact-qnty <> 0
     1842               and buf_fbr-line.rsrv-qnty <> ?
     1843               and buf_fbr-doc.is-free    = no
     1844               then do:
     1845   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1847     (input  buf_fbr-line.artic
     1848     ,input  buf_fbr-line.prod-type
     1849     ,input  buf_fbr-line.prod-code
     1850     ,output v-gds-name
     1851     ) no-error .
     1852                   if error-status :error
     1853                   then do:
     1854                       assign
     1855                           v-gds-name = ""
     1856                       .
     1857                   end.
     1858                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1859                                                 ,vss-description
     1860                                                 ,buf_fbr-doc.doc-code
     1861                                                 ,chr(10)
     1862                                                 ,buf_fbr-line.recipe-code
     1863                                                 ,buf_fbr-line.artic
     1864                                                 ,v-gds-name).
     1865               end.
     1866               assign
     1867                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1868                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1869                                                                   + buf_fbr-line.fact-qnty
     1870                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1871                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1872               .
     1873               if buf_fbr-line.is-waste = no
     1874               then do:
     1875                   assign
     1876                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1877                                                                       + buf_fbr-line.price-sum-base
     1878                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1879                                                                       + buf_fbr-line.price-sum-rubl
     1880                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1881                                                                       + buf_fbr-line.price-sum-vat-base
     1882                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1883                                                                       + buf_fbr-line.price-sum-vat-rubl
     1884                   .
     1885               end.
     1886           end.
     1887           for each buf_fbr-line no-lock
     1888              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1889                and buf_fbr-line.trn-type     = 'спи':U
     1890                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1891           :
     1892               if ( buf_fbr-line.price-base   = ?
     1893                   or buf_fbr-line.price-rubl = ?
     1894                   or buf_fbr-line.price-base <= 0
     1895                   or buf_fbr-line.price-rubl <= 0 )
     1896               and buf_fbr-line.fact-qnty <> 0
     1897               and buf_fbr-line.rsrv-qnty <> ?
     1898               and buf_fbr-doc.is-free    = no
     1899               and buf_fbr-doc.status_    = 'разрешен':U
     1900               then do:
     1901   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1902   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1903     (input  buf_fbr-line.artic
     1904     ,input  buf_fbr-line.prod-type
     1905     ,input  buf_fbr-line.prod-code
     1906     ,output v-gds-name
     1907     ) no-error .
     1908                   if error-status :error
     1909                   then do:
     1910                       assign
     1911                           v-gds-name = ""
     1912                       .
     1913                   end.
     1914                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1915                                                 ,vss-description
     1916                                                 ,buf_fbr-doc.doc-code
     1917                                                 ,chr(10)
     1918                                                 ,buf_fbr-line.recipe-code
     1919                                                 ,buf_fbr-line.artic
     1920                                                 ,v-gds-name).
     1921               end.
     1922               assign
     1923                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1924                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1925                                                                   + buf_fbr-line.fact-qnty
     1926                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1927                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1928               .
     1929               if buf_fbr-line.is-waste = no
     1930               then do:
     1931                   assign
     1932                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1933                                                                       + buf_fbr-line.price-sum-base
     1934                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1935                                                                       + buf_fbr-line.price-sum-rubl
     1936                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1937                                                                       + buf_fbr-line.price-sum-vat-base
     1938                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1939                                                                       + buf_fbr-line.price-sum-vat-rubl
     1940                   .
     1941               end.
     1942           end.
     1943           if buf_fbr-doc.status_    = 'разрешен':U
     1944           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1945           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1946           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1947           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1948               )
     1949           then do:
     1950            undo, return error
     1951               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1952                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1953                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1954                           "Сумма в &9.&4&7&4&4&8&2"
     1955                          , buf_fbr-doc.doc-code
     1956                          , chr(10)
     1957                          , buf_temp_fbrlib_recipe.recipe-code
     1958                          , chr(9)
     1959                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1960                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1961                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1962                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1963                          , "руб"
     1964                          )
     1965              +
     1966              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1967                         "НДС в &7.&1&5&1&1&6&4"
     1968                        ,  chr(9)
     1969                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1970                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1971                        ,chr(10)
     1972                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1973                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1974                        ,"руб"
     1975                        )       .
     1976           end.
     1977       end.
     1978   end.
     1979   end procedure.
     1980   procedure fbrlib-fill-sum-fbr-doc :
     1981   do
     1982   on error undo, return error
     1983   :
     1984   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1985   define input parameter p-mode           as character    no-undo.
     1986       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1987       define buffer buf_fbr-doc           for ub.fbr-doc.
     1988       define buffer buf_fbr-line          for ub.fbr-line.
     1989       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1990       define variable v-in-count          as integer       no-undo.
     1991       define variable v-out-count         as integer       no-undo.
     1992       find first buf_fbr-doc exclusive-lock
     1993            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1994       .
     1995       find first buf_temp_fbrlib_recipe no-error.
     1996       if not available buf_temp_fbrlib_recipe
     1997       then do:
     1998           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1999               input buf_fbr-doc.doc-code
     2000           ) no-error.
     2001           if error-status :error
     2002           then do:
     2003               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2004                                              , vss-description
     2005                                              , chr(10)
     2006                                              , error-status:get-message(1)
     2007                                              , return-value ).
     2008           end.
     2009       end.
     2010       assign
     2011           v-in-count                  = 0
     2012           buf_fbr-doc.in-qnty         = 0
     2013           buf_fbr-doc.in-sale         = 0
     2014           buf_fbr-doc.in-base         = 0
     2015           buf_fbr-doc.in-rubl         = 0
     2016           buf_fbr-doc.in-vat-base     = 0
     2017           buf_fbr-doc.in-vat-rubl     = 0
     2018           v-out-count                 = 0
     2019           buf_fbr-doc.out-qnty        = 0
     2020           buf_fbr-doc.out-sale        = 0
     2021           buf_fbr-doc.out-base        = 0
     2022           buf_fbr-doc.out-rubl        = 0
     2023           buf_fbr-doc.out-vat-base    = 0
     2024           buf_fbr-doc.out-vat-rubl    = 0
     2025       .
     2026       for each buf_temp_fbrlib_recipe
     2027       :
     2028           assign
     2029               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2030               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2031               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2032               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2033               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2034               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2035               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2036               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2037               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2038               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2039               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2040               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2041               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2042               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2043           .
     2044       end.
     2045       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2046       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2047       or p-mode <> 'факт':U
     2048       then do:
     2049           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2050           then do:
     2051               assign
     2052                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2053                                   + string( v-out-count, ">>>,>>9" )
     2054                                   + chr(10) + "Строк исходных товаров : "
     2055                                   + string( v-in-count, ">>>,>>9" )
     2056               .
     2057           end.
     2058       end.
     2059       else do:
     2060         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2061                                       "Сумма списанных товаров в &3 - &4&2" +
     2062                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2063                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2064                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2065                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2066                                       , buf_fbr-doc.doc-code
     2067                                       , chr(10)
     2068                                       , "рублях"
     2069                                       , round( buf_fbr-doc.out-rubl, 2 )
     2070                                       , round( buf_fbr-doc.in-rubl,  2 )
     2071                                       , round( buf_fbr-doc.in-rubl,  2 )
     2072                                       , round( buf_fbr-doc.out-base, 2 )
     2073                                       , round( buf_fbr-doc.in-base,  2 )).
     2074       end.
     2075   end.
     2076   end procedure.
     2077   procedure fbrlib-calc-prices :
     2078   do
     2079   on error undo, return error
     2080   :
     2081   define input parameter p-fbr-line-recid as recid        no-undo.
     2082   define input parameter p-price-obj-type as character    no-undo.
     2083   define input parameter p-price-obj-code as integer      no-undo.
     2084   define output parameter p-current-price as decimal      no-undo.
     2085       define variable v-void          as decimal       no-undo.
     2086       define variable v-void-char     as character     no-undo.
     2087       define variable v-gds-code      as integer       no-undo.
     2088       define variable v-b-code        as integer       no-undo.
     2089       define buffer buf_fbr-doc   for ub.fbr-doc.
     2090       define buffer buf_fbr-line  for ub.fbr-line.
     2091       define buffer buf_gds-prt   for ub.gds-prt.
     2092       define buffer buf_bar-code  for ub.bar-code.
     2093       find first buf_fbr-line no-lock
     2094           where recid( buf_fbr-line ) = p-fbr-line-recid
     2095       .
     2096   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2098     (input  buf_fbr-line.artic
     2099     ,input  buf_fbr-line.prod-type
     2100     ,input  buf_fbr-line.prod-code
     2101     ,output v-gds-code
     2102     ) no-error .
     2103       if error-status :error
     2104       then do:
     2105         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2106                                         ,vss-workfile
     2107                                         ,vss-revision
     2108                                         ,vss-description
     2109                                         ,chr(10)
     2110                                         , error-status:get-message(1)
     2111                                         , return-value
     2112                                         , buf_fbr-line.artic
     2113                                         ).
     2114       end.
     2115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2116     (input  v-gds-code
     2117     ,input  ?
     2118     ,output v-b-code
     2119     ) no-error .
     2120       if error-status :error
     2121       then do:
     2122         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2123                                         ,vss-workfile
     2124                                         ,vss-revision
     2125                                         ,vss-description
     2126                                         ,chr(10)
     2127                                         , error-status:get-message(1)
     2128                                         , return-value
     2129                                         , v-gds-code
     2130                                         ).
     2131       end.
     2132       if buf_fbr-line.is-calc = no
     2133       then do:
     2134   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2136     (input  p-price-obj-type
     2137     ,input  p-price-obj-code
     2138     ,input  v-b-code
     2139     ,input  0
     2140     ,input  0
     2141     ,output v-void-char
     2142     ,output p-current-price
     2143     ,output v-void
     2144     ,output v-void
     2145     ) no-error .
     2146           if error-status :error
     2147           then do:
     2148             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2149                                             ,vss-workfile
     2150                                             ,vss-revision
     2151                                             ,vss-description
     2152                                             ,chr(10)
     2153                                             , error-status:get-message(1)
     2154                                             , return-value
     2155                                             , v-gds-code
     2156                                             ).
     2157           end.
     2158       end.
     2159       else do:
     2160           assign
     2161               p-current-price = buf_fbr-line.price-sale
     2162           .
     2163       end.
     2164   end.
     2165   end procedure.
     2166   procedure fbrlib-put-in-order-recipe :
     2167   do
     2168   on error undo, return error
     2169   :
     2170   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2171       define variable v-recipe-counter    as integer          no-undo.
     2172       define variable v-recipe-amount     as integer init 0   no-undo.
     2173       define variable v-child-counter     as integer          no-undo.
     2174       define variable v-is-call-cycle     as logical          no-undo.
     2175       define variable v-str as character     no-undo.
     2176       define buffer buf_in_fbr-line       for ub.fbr-line.
     2177       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2178       define buffer buf_fbr-line          for ub.fbr-line.
     2179       define buffer buf_recipe-gds        for ub.recipe-gds.
     2180       define buffer buf_recipe            for ub.recipe.
     2181       for each temp_recipe-childs-qnty
     2182       :
     2183           delete temp_recipe-childs-qnty.
     2184       end.
     2185       for each temp_recipe-childs
     2186       :
     2187           delete temp_recipe-childs.
     2188       end.
     2189       for each temp_recipe-order
     2190       :
     2191           delete temp_recipe-order.
     2192       end.
     2193       for each buf_fbr-line no-lock
     2194          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2195       on error undo, return error
     2196       :
     2197           find first temp_recipe-childs-qnty
     2198                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2199           no-error.
     2200           if not available temp_recipe-childs-qnty
     2201           then do:
     2202               create temp_recipe-childs-qnty.
     2203               assign
     2204                   v-recipe-amount                     = v-recipe-amount + 1
     2205                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2206                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2207                   temp_recipe-childs-qnty.childs-qnty = 0
     2208                   v-child-counter                     = 0
     2209               .
     2210           end.
     2211       end.
     2212       for each buf_in_fbr-line no-lock
     2213          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2214            and buf_in_fbr-line.trn-type = 'спи':U
     2215       on error undo, return error
     2216       :
     2217           for each buf_dress_fbr-line no-lock
     2218              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2219                and buf_dress_fbr-line.trn-type    = 'при':U
     2220                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2221                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2222                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2223           on error undo, return error
     2224           :
     2225               find first buf_recipe no-lock
     2226                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2227               .
     2228               if buf_in_fbr-line.is-comp = yes
     2229               then do:
     2230                   find last temp_recipe-childs-qnty
     2231                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2232                   .
     2233                   assign
     2234                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2235                   .
     2236                   create temp_recipe-childs.
     2237                   assign
     2238                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2239                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2240                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2241                   .
     2242               end.
     2243               else do:
     2244               end.
     2245           end.
     2246       end.
     2247       for each buf_in_fbr-line no-lock
     2248          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2249            and buf_in_fbr-line.trn-type = 'при':U
     2250       on error undo, return error
     2251       :
     2252           find first buf_recipe no-lock
     2253                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2254           no-error.
     2255           if buf_in_fbr-line.is-comp = no
     2256           then do:
     2257           end.
     2258           else do:
     2259               for each buf_recipe-gds no-lock
     2260               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2261               :
     2262                   for each buf_fbr-line no-lock
     2263                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2264                       and buf_fbr-line.trn-type    = 'при':U
     2265                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2266                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2267                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2268                   on error undo, return error
     2269                   :
     2270                       find first buf_recipe no-lock
     2271                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2272                       .
     2273                       if buf_recipe.recipe-type = 'разделка':U
     2274                       then do:
     2275                       end.
     2276                       else do:
     2277                           find last temp_recipe-childs-qnty
     2278                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2279                           .
     2280                           assign
     2281                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2282                           .
     2283                           create temp_recipe-childs.
     2284                           assign
     2285                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2286                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2287                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2288                           .
     2289                       end.
     2290                   end.
     2291               end.
     2292           end.
     2293       end.
     2294       for each temp_recipe-order
     2295       on error undo, return error
     2296       :
     2297           delete temp_recipe-order.
     2298       end.
     2299       assign
     2300           v-fbrlib-recipe-order = 0
     2301       .
     2302       do v-recipe-counter = 1 to v-recipe-amount
     2303       on error undo, return error
     2304       :
     2305           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2306                 input v-recipe-counter
     2307               , input 0
     2308               , output v-is-call-cycle
     2309           ).
     2310           if v-is-call-cycle = yes
     2311           then do:
     2312               message
     2313                       "Достигнут максимальный уровень вложенности рецептов."
     2314                   skip(1)
     2315                   skip "Невозможно упорядочить рецепты."
     2316                   skip(1)
     2317                   skip "Необходимо изменить структуру рецептов,"
     2318                   skip "используемых при формировании"
     2319                   skip "данного документа производства."
     2320               view-as alert-box error
     2321               title "Невозможно рассчитать документ производства".
     2322               for each temp_recipe-childs-qnty
     2323               :
     2324                   delete temp_recipe-childs-qnty.
     2325               end.
     2326               for each temp_recipe-childs
     2327               :
     2328                   delete temp_recipe-childs.
     2329               end.
     2330               for each temp_recipe-order
     2331               :
     2332                   delete temp_recipe-order.
     2333               end.
     2334               for each temp_recipe-order
     2335               on error undo, return error
     2336               :
     2337                   delete temp_recipe-order.
     2338               end.
     2339               for each temp_fbrlib_recipe
     2340               on error undo, return error
     2341               :
     2342                   delete temp_recipe-order.
     2343               end.
     2344               undo, return error.
     2345           end.
     2346       end.
     2347   end.
     2348   end procedure.
     2349   procedure fbrlib-add-recipe-in-tmp-order :
     2350   do
     2351   on error undo, return error
     2352   :
     2353   define input parameter p-order              as integer      no-undo.
     2354   define input parameter p-call-counter       as integer      no-undo.
     2355   define output parameter p-is-call-cycle     as logical      no-undo.
     2356       define variable v-nodes-counter     as integer       no-undo.
     2357       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2358       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2359       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2360       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2361       assign
     2362           p-call-counter = p-call-counter + 1
     2363       .
     2364       if p-call-counter > 50
     2365       then do:
     2366           assign
     2367               p-is-call-cycle = yes
     2368           .
     2369       end.
     2370       else do:
     2371           find first buf_temp_recipe-childs-qnty
     2372                where buf_temp_recipe-childs-qnty.order = p-order
     2373           .
     2374           find first buf_temp_recipe-order
     2375                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2376           no-error.
     2377           if not available buf_temp_recipe-order
     2378           then do:
     2379               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2380               :
     2381                   find first buf_temp_recipe-childs
     2382                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2383                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2384                   .
     2385                   find first buf_c_temp_recipe-childs-qnty
     2386                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2387                   .
     2388                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2389                         input buf_c_temp_recipe-childs-qnty.order
     2390                       , input p-call-counter
     2391                       , output p-is-call-cycle
     2392                   ).
     2393                   if p-is-call-cycle = yes
     2394                   then do:
     2395                       return.
     2396                   end.
     2397               end.
     2398               assign
     2399                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2400               .
     2401               create buf_temp_recipe-order.
     2402               assign
     2403                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2404                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2405               .
     2406           end.
     2407       end.
     2408   end.
     2409   end procedure.
     2410   procedure fbrlib-get-trn-type :
     2411   define input parameter p-recipe-code    as character    no-undo.
     2412   define input parameter p-goods-recid    as recid        no-undo.
     2413   define input parameter p-is-integration as logical      no-undo.
     2414   define output parameter p-is-comp       as logical      no-undo.
     2415   define output parameter p-trn-type      as character    no-undo.
     2416   define buffer buf_recipe    for ub.recipe.
     2417   define buffer buf_goods     for ub.goods.
     2418   do
     2419   for buf_recipe
     2420     , buf_goods
     2421   on error undo, return error
     2422   :
     2423       find first buf_goods no-lock
     2424            where recid( buf_goods ) = p-goods-recid
     2425       .
     2426       find first buf_recipe no-lock
     2427            where buf_recipe.recipe-code = p-recipe-code
     2428       no-error.
     2429       if not available buf_recipe
     2430       then do:
     2431           assign
     2432               p-is-comp = no
     2433               p-trn-type = "":U
     2434           .
     2435           undo, return.
     2436       end.
     2437       if  buf_recipe.artic        = buf_goods.artic
     2438       and buf_recipe.prod-type    = buf_goods.prod-type
     2439       and buf_recipe.prod-code    = buf_goods.prod-code
     2440       then do:
     2441           assign
     2442               p-is-comp = yes
     2443           .
     2444       end.
     2445       else do:
     2446           assign
     2447               p-is-comp = no
     2448           .
     2449       end.
     2450       case buf_recipe.recipe-type
     2451       :
     2452           when 'производство':U
     2453           then do:
     2454               if p-is-comp = yes
     2455               then do:
     2456                   assign
     2457                       p-trn-type = 'при':U
     2458                   .
     2459               end.
     2460               else do:
     2461                   assign
     2462                       p-trn-type = 'спи':U
     2463                   .
     2464               end.
     2465           end.
     2466           when 'альтернатива':U
     2467           then do:
     2468               if p-is-comp = yes
     2469               then do:
     2470                   assign
     2471                       p-trn-type = 'при':U
     2472                   .
     2473               end.
     2474               else do:
     2475                   assign
     2476                       p-trn-type = 'спи':U
     2477                   .
     2478               end.
     2479           end.
     2480           when 'разделка':U
     2481           then do:
     2482               if p-is-comp = no
     2483               then do:
     2484                   assign
     2485                       p-trn-type = 'при':U
     2486                   .
     2487               end.
     2488               else do:
     2489                   assign
     2490                       p-trn-type = 'спи':U
     2491                   .
     2492               end.
     2493           end.
     2494           when 'комплектация':U
     2495           then do:
     2496               if p-is-integration = ?
     2497               then do:
     2498                   message
     2499                       "Выберите тип операции по рецепту комплектации:"
     2500                       skip (2) "YES - комплектация"
     2501                       skip     "NO - разукомплектация"
     2502                   view-as alert-box question
     2503                   buttons YES-NO
     2504                   update p-is-integration.
     2505               end.
     2506               if p-is-integration = yes
     2507               then do:
     2508                   if p-is-comp = yes
     2509                   then do:
     2510                       assign
     2511                           p-trn-type = 'при':U
     2512                       .
     2513                   end.
     2514                   else do:
     2515                       assign
     2516                           p-trn-type = 'спи':U
     2517                       .
     2518                   end.
     2519               end.
     2520               else do:
     2521                   if p-is-comp = yes
     2522                   then do:
     2523                       assign
     2524                           p-trn-type = 'спи':U
     2525                       .
     2526                   end.
     2527                   else do:
     2528                       assign
     2529                           p-trn-type = 'при':U
     2530                       .
     2531                   end.
     2532               end.
     2533           end.
     2534       end case.
     2535   end.
     2536   end procedure.
     2537   procedure fbrlib-get-mark :
     2538   define input parameter p-recipe-code    as character    no-undo.
     2539   define output parameter p-mark          as logical    no-undo.
     2540   define buffer buf_goods-attr     for ub.goods-attr.
     2541   define buffer buf_recipe-gds for ub.recipe-gds .
     2542       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2543            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2544                                               buf_goods-attr.attr-code = 'mark-type':U:
     2545            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2546               p-mark = true .
     2547               return .
     2548            end.
     2549       end.
     2550   end procedure.
     2551   procedure fbrlib-check-temp-tables :
     2552   do
     2553   on error undo, return error
     2554   :
     2555   define input parameter p-title  as character    no-undo.
     2556       define variable v-str               as character        no-undo.
     2557       assign
     2558           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2559       .
     2560       for each temp_recipe-childs-qnty
     2561       on error undo, return error
     2562       :
     2563           assign
     2564               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2565                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2566                       + "   " + string( temp_recipe-childs-qnty.order )
     2567                       + chr(10)
     2568           .
     2569       end.
     2570       assign
     2571           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2572       .
     2573       for each temp_recipe-childs
     2574       on error undo, return error
     2575       :
     2576           assign
     2577               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2578                       + "   " + string( temp_recipe-childs.child-code )
     2579                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2580                       + chr(10)
     2581           .
     2582       end.
     2583       assign
     2584           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2585       .
     2586       for each temp_recipe-order
     2587       on error undo, return error
     2588       :
     2589           assign
     2590               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2591                       + "   " + string( temp_recipe-order.order )
     2592                       + chr(10)
     2593           .
     2594       end.
     2595       assign
     2596           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2597       .
     2598       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2599       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2600       for each temp_fbrlib_recipe
     2601       on error undo, return error
     2602       :
     2603           assign
     2604               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2605                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2606                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2607                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2608                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2609                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2610                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2611                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2612                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2613                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2614                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2615                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2616                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2617                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2618                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2619                       + chr(10)
     2620           .
     2621           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2622       end.
     2623   end.
     2624   end procedure.
     2625   procedure fbrlib-s-coeff-value :
     2626   define input  parameter p-gds-code    as integer        no-undo.
     2627   define input  parameter p-date        as date           no-undo.
     2628   define input  parameter p-obj-type    as character      no-undo.
     2629   define input  parameter p-obj-code    as integer        no-undo.
     2630   define output parameter p-coeff-value as decimal        no-undo.
     2631   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2632       define variable v-date          as date         no-undo.
     2633       define variable v-host-code     as integer      no-undo.
     2634       define buffer buf_goods       for ub.goods.
     2635       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2636       define buffer buf_clients     for ub.clients.
     2637       define buffer buf_s-coeff     for ub.s-coeff.
     2638   do
     2639   for buf_goods
     2640     , buf_fbr-gds-obj
     2641     , buf_clients
     2642     , buf_s-coeff
     2643   on error undo, return error return-value
     2644   :
     2645       find first buf_goods no-lock
     2646            where buf_goods.gds-code = p-gds-code
     2647       no-error .
     2648       if not available buf_goods
     2649       then do:
     2650          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2651       end.
     2652       find first buf_clients no-lock
     2653            where buf_clients.obj-type = p-obj-type
     2654              and buf_clients.obj-code = p-obj-code
     2655       no-error.
     2656       if not available buf_clients
     2657       then do:
     2658          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2659       end.
     2660       assign
     2661           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2662       .
     2663       find first buf_fbr-gds-obj no-lock
     2664            where buf_fbr-gds-obj.gds-code = p-gds-code
     2665              and buf_fbr-gds-obj.obj-type = p-obj-type
     2666              and buf_fbr-gds-obj.obj-code = p-obj-code
     2667       no-error.
     2668       if not available buf_fbr-gds-obj
     2669       or buf_fbr-gds-obj.is-season = no
     2670       then do:
     2671           assign
     2672               p-coeff-value = 0
     2673           .
     2674           return.
     2675       end.
     2676   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2678     (input  p-obj-type
     2679     ,input  p-obj-code
     2680     ,output v-host-code
     2681     )  .
     2682       find last buf_s-coeff no-lock
     2683           where buf_s-coeff.gds-code = p-gds-code
     2684             and buf_s-coeff.host-code = v-host-code
     2685             and buf_s-coeff.obj-type = p-obj-type
     2686             and buf_s-coeff.obj-code = p-obj-code
     2687             and buf_s-coeff.s-date <= v-date
     2688       no-error.
     2689       if available buf_s-coeff
     2690       then do:
     2691           assign
     2692               p-coeff-value = buf_s-coeff.coeff-value
     2693           .
     2694           return.
     2695       end.
     2696       find last buf_s-coeff no-lock
     2697           where buf_s-coeff.gds-code = p-gds-code
     2698             and buf_s-coeff.host-code = v-host-code
     2699             and buf_s-coeff.obj-type = "":U
     2700             and buf_s-coeff.obj-code = 0
     2701             and buf_s-coeff.s-date <= v-date
     2702       no-error.
     2703       if available buf_s-coeff
     2704       then do:
     2705           assign
     2706               p-coeff-value = buf_s-coeff.coeff-value
     2707           .
     2708           return.
     2709       end.
     2710       find last buf_s-coeff no-lock
     2711           where buf_s-coeff.gds-code = p-gds-code
     2712             and buf_s-coeff.host-code = 0
     2713             and buf_s-coeff.obj-type = "":U
     2714             and buf_s-coeff.obj-code = 0
     2715             and buf_s-coeff.s-date <= v-date
     2716       no-error.
     2717       if available buf_s-coeff
     2718       then do:
     2719           assign
     2720               p-coeff-value = buf_s-coeff.coeff-value
     2721           .
     2722       end.
     2723       else do:
     2724           assign
     2725               p-coeff-value = 0
     2726           .
     2727       end.
     2728   end.
     2729   end procedure.
     2730   procedure fbrlib_create-fbr-recipe-gds :
     2731   define input parameter p-doc-code         as character      no-undo.
     2732   define input parameter p-recipe-code      as character      no-undo.
     2733   define input parameter p-prod-type        as character      no-undo.
     2734   define input parameter p-prod-code        as integer        no-undo.
     2735   define input parameter p-artic            as character      no-undo.
     2736   define input parameter p-gds-code         as integer        no-undo.
     2737   define input parameter p-is-waste         as logical        no-undo.
     2738   define input parameter p-proc-number      as integer        no-undo.
     2739   define input parameter p-obj-date         as date           no-undo.
     2740   define input parameter p-obj-type         as character      no-undo.
     2741   define input parameter p-obj-code         as integer        no-undo.
     2742   define input parameter p-calc-method      as decimal        no-undo.
     2743   define input parameter p-coeff-waste      as decimal        no-undo.
     2744   define input parameter p-orig-qnty        as decimal        no-undo.
     2745   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2746       define variable v-coeff-season  as decimal      no-undo.
     2747       define variable v-void-decimal  as decimal      no-undo.
     2748       define variable v-void-integer  as integer      no-undo.
     2749       define variable v-recipe-type   as character    no-undo.
     2750       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2751       define buffer buf_goods             for ub.goods.
     2752       define buffer buf_recipe            for ub.recipe.
     2753   do
     2754   for buf_fbr-recipe-gds
     2755     , buf_recipe
     2756     , buf_goods
     2757   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2758   :
     2759       find first buf_fbr-recipe-gds exclusive-lock
     2760            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2761              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2762              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2763              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2764              and buf_fbr-recipe-gds.artic       = p-artic
     2765       no-error.
     2766       if not available buf_fbr-recipe-gds
     2767       then do:
     2768           create buf_fbr-recipe-gds.
     2769           assign
     2770               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2771               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2772               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2773               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2774               buf_fbr-recipe-gds.artic              = p-artic
     2775               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2776               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2777               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2778               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2779               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2780           .
     2781           find first buf_goods no-lock
     2782                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2783                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2784                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2785           .
     2786           run fbrlib-s-coeff-value in this-procedure (
     2787                 input buf_goods.gds-code
     2788               , input p-obj-date
     2789               , input p-obj-type
     2790               , input p-obj-code
     2791               , output v-coeff-season
     2792           ) no-error.
     2793           if error-status:error
     2794           then do:
     2795               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2796           end.
     2797           assign
     2798               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2799               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2800               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2801           .
     2802           run fbrlib-get-recipe-type in this-procedure (
     2803                 input buf_fbr-recipe-gds.doc-code
     2804               , input buf_fbr-recipe-gds.recipe-code
     2805               , output v-recipe-type
     2806           ).
     2807           if v-recipe-type <> 'производство':U
     2808           then do:
     2809               assign
     2810                   buf_fbr-recipe-gds.coeff-value  = 0
     2811                   buf_fbr-recipe-gds.coeff-waste  = 0
     2812                   buf_fbr-recipe-gds.calc-method  = 1
     2813                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2814               .
     2815           end.
     2816           else do:
     2817               run fbrlib-calc-brutto in this-procedure (
     2818                     input v-recipe-type
     2819                   , input buf_fbr-recipe-gds.qnty
     2820                   , input buf_fbr-recipe-gds.coeff-value
     2821                   , input buf_fbr-recipe-gds.coeff-waste
     2822                   , input 0
     2823                   , input 3
     2824                   , output v-void-decimal
     2825                   , output v-void-decimal
     2826                   , output buf_fbr-recipe-gds.brutto-qnty
     2827                   , output v-void-integer
     2828               ).
     2829               assign
     2830                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2831               .
     2832               run fbrlib-calc-brutto in this-procedure (
     2833                     input v-recipe-type
     2834                   , input buf_fbr-recipe-gds.qnty
     2835                   , input buf_fbr-recipe-gds.coeff-value
     2836                   , input buf_fbr-recipe-gds.coeff-waste
     2837                   , input buf_fbr-recipe-gds.brutto-qnty
     2838                   , input buf_fbr-recipe-gds.calc-method
     2839                   , output buf_fbr-recipe-gds.qnty
     2840                   , output v-void-decimal
     2841                   , output v-void-decimal
     2842                   , output v-void-integer
     2843               ).
     2844           end.
     2845       end.
     2846   end.
     2847   end procedure.
     2848   procedure fbrlib-set-default-recipe :
     2849   define input parameter p-obj-type   as character    no-undo.
     2850   define input parameter p-obj-code   as integer      no-undo.
     2851   define input parameter p-gds-code   as integer      no-undo.
     2852       define variable v-artic             as character    no-undo.
     2853       define variable v-prod-type         as character    no-undo.
     2854       define variable v-prod-code         as character    no-undo.
     2855       define variable v-recipe-code       as character    no-undo.
     2856       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2857       define variable v-recipe-found      as logical      no-undo.
     2858       define buffer buf_recipe        for ub.recipe.
     2859       define buffer buf_other_recipe  for ub.recipe.
     2860       define buffer buf_goods         for ub.goods.
     2861       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2862   do
     2863   for buf_recipe
     2864     , buf_goods
     2865     , buf_fbr-gds-obj
     2866   on error undo, return error
     2867   :
     2868       find first buf_goods no-lock
     2869            where buf_goods.gds-code = p-gds-code
     2870       .
     2871       run fbrlib-get-obj-recipe in this-procedure (
     2872             input p-obj-type
     2873           , input p-obj-code
     2874           , input p-gds-code
     2875           , output v-recipe-code
     2876       ).
     2877       if v-recipe-code <> ""
     2878       then do:
     2879           find first buf_recipe no-lock
     2880               where buf_recipe.recipe-code = v-recipe-code
     2881           no-error.
     2882           if not available buf_recipe
     2883           then do:
     2884               assign
     2885                   v-recipe-code = ""
     2886               .
     2887           end.
     2888       end.
     2889       if v-recipe-code = ""
     2890       then do:
     2891           find first buf_fbr-gds-obj exclusive-lock
     2892                where buf_fbr-gds-obj.obj-type = p-obj-type
     2893                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2894                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2895           no-error.
     2896           if not available buf_fbr-gds-obj
     2897           then do:
     2898               run ref/fgdsobj1.p (
     2899                     input-output v-fbr-gds-obj-recid
     2900                   , input 'ДОБАВЛЕНИЕ':U
     2901                   , input no
     2902                   , input p-gds-code
     2903                   , input p-obj-type
     2904                   , input p-obj-code
     2905                   , input 0
     2906                   , input ""
     2907                   , input 0
     2908                   , input no
     2909                   , input no
     2910                   , input no
     2911                   , input no
     2912                   , input no
     2913                   , input no
     2914               ) no-error.
     2915               if error-status:error
     2916               then do:
     2917                   message
     2918                           vss-workfile vss-revision vss-description
     2919                       skip "Ошибка изменения атрибутов товара на объекте"
     2920                       skip return-value
     2921                       skip trim(error-status :get-message(1))
     2922                               trim(error-status :get-message(2))
     2923                               trim(error-status :get-message(3))
     2924                   view-as alert-box error.
     2925                   undo, return error .
     2926               end.
     2927               find first buf_fbr-gds-obj exclusive-lock
     2928                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2929               .
     2930           end.
     2931           assign
     2932               v-recipe-found = no
     2933           .
     2934           for first buf_recipe no-lock
     2935               where buf_recipe.obj-type    = p-obj-type
     2936                 and buf_recipe.obj-code    = p-obj-code
     2937                 and buf_recipe.artic       = buf_goods.artic
     2938                 and buf_recipe.prod-type   = buf_goods.prod-type
     2939                 and buf_recipe.prod-code   = buf_goods.prod-code
     2940                 and buf_recipe.recipe-type = 'производство':U
     2941                 or (
     2942                     buf_recipe.obj-type    = ""
     2943                 and buf_recipe.obj-code    = 0
     2944                 and buf_recipe.artic       = buf_goods.artic
     2945                 and buf_recipe.prod-type   = buf_goods.prod-type
     2946                 and buf_recipe.prod-code   = buf_goods.prod-code
     2947                 and buf_recipe.recipe-type = 'производство':U
     2948                     )
     2949           :
     2950               assign
     2951                   v-recipe-found = yes
     2952                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2953               .
     2954           end.
     2955           if v-recipe-found = no
     2956           then do:
     2957               for first buf_recipe no-lock
     2958                   where buf_recipe.obj-type    = p-obj-type
     2959                     and buf_recipe.obj-code    = p-obj-code
     2960                     and buf_recipe.artic       = buf_goods.artic
     2961                     and buf_recipe.prod-type   = buf_goods.prod-type
     2962                     and buf_recipe.prod-code   = buf_goods.prod-code
     2963                     and buf_recipe.recipe-type <> 'альтернатива':U
     2964                     or (
     2965                         buf_recipe.obj-type    = ""
     2966                     and buf_recipe.obj-code    = 0
     2967                     and buf_recipe.artic       = buf_goods.artic
     2968                     and buf_recipe.prod-type   = buf_goods.prod-type
     2969                     and buf_recipe.prod-code   = buf_goods.prod-code
     2970                     and buf_recipe.recipe-type <> 'альтернатива':U
     2971                         )
     2972               :
     2973                   assign
     2974                       v-recipe-found = yes
     2975                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2976                   .
     2977               end.
     2978               if v-recipe-found = no
     2979               then do:
     2980                   for first buf_recipe no-lock
     2981                       where buf_recipe.obj-type    = p-obj-type
     2982                         and buf_recipe.obj-code    = p-obj-code
     2983                         and buf_recipe.artic       = buf_goods.artic
     2984                         and buf_recipe.prod-type   = buf_goods.prod-type
     2985                         and buf_recipe.prod-code   = buf_goods.prod-code
     2986                         or (
     2987                             buf_recipe.obj-type    = ""
     2988                         and buf_recipe.obj-code    = 0
     2989                         and buf_recipe.artic       = buf_goods.artic
     2990                         and buf_recipe.prod-type   = buf_goods.prod-type
     2991                         and buf_recipe.prod-code   = buf_goods.prod-code
     2992                             )
     2993                   :
     2994                       assign
     2995                           v-recipe-found = yes
     2996                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2997                       .
     2998                   end.
     2999                   if v-recipe-found = no
     3000                   then do:
     3001                       assign
     3002                           buf_fbr-gds-obj.default-recipe-code = ""
     3003                       .
     3004                   end.
     3005               end.
     3006           end.
     3007       end.
     3008   end.
     3009   end procedure.
     3010   procedure fbrlib-get-obj-recipe :
     3011   define input parameter p-obj-type       as character    no-undo.
     3012   define input parameter p-obj-code       as integer      no-undo.
     3013   define input parameter p-gds-code       as integer      no-undo.
     3014   define output parameter p-recipe-code   as character    no-undo.
     3015       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3016   do
     3017   for buf_fbr-gds-obj
     3018   on error undo, return error
     3019   :
     3020       find first buf_fbr-gds-obj no-lock
     3021            where buf_fbr-gds-obj.obj-type = p-obj-type
     3022              and buf_fbr-gds-obj.obj-code = p-obj-code
     3023              and buf_fbr-gds-obj.gds-code = p-gds-code
     3024       no-error.
     3025       if available buf_fbr-gds-obj
     3026       then do:
     3027           assign
     3028               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3029           .
     3030       end.
     3031       else do:
     3032           assign
     3033               p-recipe-code = ""
     3034           .
     3035       end.
     3036   end.
     3037   end procedure.
     3038   procedure fbrlib-create-or-update-recipe-gds :
     3039   define input parameter p-recipe-code    as character        no-undo.
     3040   define input parameter p-gds-code       as integer          no-undo.
     3041   define input parameter p-is-waste       as logical          no-undo.
     3042   define input parameter p-qnty           as decimal          no-undo.
     3043   define input parameter p-proc-number    as integer          no-undo.
     3044   define input parameter p-nws-self       as logical          no-undo.
     3045       define variable v-max-proc-num  as integer      no-undo.
     3046       define variable v-recipe-type   as character    no-undo.
     3047       define buffer buf_goods             for ub.goods.
     3048       define buffer buf_recipe-gds        for ub.recipe-gds.
     3049       define buffer buf_recipe            for ub.recipe.
     3050       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3051   do
     3052   for buf_goods
     3053     , buf_recipe-gds
     3054     , buf_recipe
     3055     , buf_proc_recipe-gds
     3056   on error undo, return error
     3057   :
     3058       find first buf_recipe no-lock
     3059            where buf_recipe.recipe-code = p-recipe-code
     3060       .
     3061       find first buf_goods no-lock
     3062            where buf_goods.gds-code = p-gds-code
     3063       .
     3064       find first buf_recipe-gds
     3065            where buf_recipe-gds.recipe-code = p-recipe-code
     3066              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3067              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3068              and buf_recipe-gds.artic       = buf_goods.artic
     3069       no-error.
     3070       if not available buf_recipe-gds
     3071       then do:
     3072           create buf_recipe-gds.
     3073           assign
     3074               buf_recipe-gds.recipe-code = p-recipe-code
     3075               buf_recipe-gds.gds-code    = p-gds-code
     3076               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3077               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3078               buf_recipe-gds.artic       = buf_goods.artic
     3079           .
     3080           assign
     3081               buf_recipe-gds.is-waste    = no
     3082               buf_recipe-gds.qnty        = 0
     3083               buf_recipe-gds.coeff-waste = 0
     3084               buf_recipe-gds.brutto-qnty = 0
     3085               buf_recipe-gds.proc-number = 0
     3086               buf_recipe-gds.nws-self    = no
     3087           .
     3088       end.
     3089       assign
     3090           buf_recipe-gds.is-waste    = p-is-waste
     3091       .
     3092       run fbrlib-get-recipe-type in this-procedure (
     3093             input "":U
     3094           , input buf_recipe-gds.recipe-code
     3095           , output v-recipe-type
     3096       ).
     3097       if v-recipe-type <> 'производство':U
     3098       then do:
     3099           assign
     3100               buf_recipe-gds.calc-method = 1
     3101               buf_recipe-gds.qnty        = p-qnty
     3102               buf_recipe-gds.brutto-qnty = p-qnty
     3103               buf_recipe-gds.coeff-waste = 0
     3104           .
     3105       end.
     3106       else do:
     3107           assign
     3108               buf_recipe-gds.calc-method = 1
     3109               buf_recipe-gds.brutto-qnty = p-qnty
     3110           .
     3111           run fbrlib-calc-brutto in this-procedure (
     3112                 input v-recipe-type
     3113               , input 0
     3114               , input 0
     3115               , input buf_recipe-gds.coeff-waste
     3116               , input buf_recipe-gds.brutto-qnty
     3117               , input 1
     3118               , output buf_recipe-gds.qnty
     3119               , output buf_recipe-gds.coeff-waste
     3120               , output buf_recipe-gds.brutto-qnty
     3121               , output buf_recipe-gds.calc-method
     3122           ).
     3123       end.
     3124       assign
     3125           buf_recipe-gds.nws-self    = p-nws-self
     3126       .
     3127       if buf_recipe.recipe-type = 'альтернатива':U
     3128       and buf_recipe-gds.proc-number <> 0
     3129       then do:
     3130       end.
     3131       else do:
     3132           if p-proc-number <> 0
     3133           then do:
     3134               assign
     3135                   buf_recipe-gds.proc-number = p-proc-number
     3136               .
     3137           end.
     3138           else do:
     3139               assign
     3140                   v-max-proc-num = 0
     3141               .
     3142               for each buf_proc_recipe-gds no-lock
     3143                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3144               :
     3145                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3146                   then do:
     3147                       assign
     3148                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3149                       .
     3150                   end.
     3151               end.
     3152               assign
     3153                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3154               .
     3155           end.
     3156       end.
     3157   end.
     3158   end procedure.
     3159   PROCEDURE fbrlib-create-or-update-recipe :
     3160   define input parameter p-mode               as character    no-undo.
     3161   define input parameter p-obj-type           as character    no-undo.
     3162   define input parameter p-obj-code           as integer      no-undo.
     3163   define input parameter p-recipe-code        as character    no-undo.
     3164   define input parameter p-recipe-type        as character    no-undo.
     3165   define input parameter p-gds-code           as integer      no-undo.
     3166   define input parameter p-name               as character    no-undo.
     3167   define input parameter p-design             as character    no-undo.
     3168   define input parameter p-order              as integer      no-undo.
     3169   define input parameter p-quality            as character    no-undo.
     3170   define input parameter p-ref-num            as character    no-undo.
     3171   define input parameter p-technique          as character    no-undo.
     3172   define input parameter p-template           as character    no-undo.
     3173   define input parameter p-qnty               as decimal      no-undo.
     3174   define input parameter p-portion-qnty       as integer      no-undo.
     3175   define input parameter p-portion-weight     as decimal      no-undo.
     3176   define output parameter p-new-recipe-code   as character    no-undo.
     3177       define variable v-host-code         as integer      no-undo.
     3178       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3179       define buffer buf_recipe    for ub.recipe.
     3180       define buffer buf_goods     for ub.goods.
     3181   do
     3182   for buf_recipe
     3183     , buf_goods
     3184   on error undo, return error
     3185   :
     3186       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3187       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3188       then do:
     3189           message
     3190               skip "Ошибка задания типа операции для создания или измения рецепта."
     3191               skip (1)
     3192               skip "Задан тип операции:" p-mode
     3193           view-as alert-box error.
     3194           undo, return error .
     3195       end.
     3196       if p-recipe-code = ""
     3197       then do:
     3198   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3200     (input  p-obj-type
     3201     ,input  p-obj-code
     3202     ,output v-host-code
     3203     )  .
     3204           find first buf_goods no-lock
     3205                where buf_goods.gds-code = p-gds-code
     3206           .
     3207           create buf_recipe .
     3208           run fbrcode-gen-recipe-code in this-procedure (
     3209                 input p-obj-type
     3210               , input p-obj-code
     3211               , output buf_recipe.recipe-code
     3212           ).
     3213           assign
     3214               buf_recipe.artic               = buf_goods.artic
     3215               buf_recipe.prod-type           = buf_goods.prod-type
     3216               buf_recipe.prod-code           = buf_goods.prod-code
     3217               buf_recipe.recipe-type         = p-recipe-type
     3218               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3219               buf_recipe.gds-code            = p-gds-code
     3220               buf_recipe.host-code           = v-host-code
     3221               buf_recipe.obj-type            = p-obj-type
     3222               buf_recipe.obj-code            = p-obj-code
     3223               buf_recipe.recipe-design       = ""
     3224               buf_recipe.recipe-order        = 0
     3225               buf_recipe.recipe-quality      = ""
     3226               buf_recipe.recipe-ref-num      = ""
     3227               buf_recipe.recipe-technique    = ""
     3228               buf_recipe.recipe-template     = ""
     3229               buf_recipe.qnty                = 1.0
     3230               buf_recipe.portion-qnty        = 1
     3231               buf_recipe.portion-weight      = 0
     3232           .
     3233       end.
     3234       if p-name <> ""
     3235       then do:
     3236           assign
     3237               buf_recipe.recipe-name = p-name
     3238           .
     3239       end.
     3240       assign
     3241           buf_recipe.recipe-design       = p-design
     3242           buf_recipe.recipe-order        = p-order
     3243           buf_recipe.recipe-quality      = p-quality
     3244           buf_recipe.recipe-ref-num      = p-ref-num
     3245           buf_recipe.recipe-technique    = p-technique
     3246           buf_recipe.recipe-template     = p-template
     3247           buf_recipe.qnty                = p-qnty
     3248           buf_recipe.portion-qnty        = p-portion-qnty
     3249           buf_recipe.portion-weight      = p-portion-weight
     3250       .
     3251       assign
     3252           p-new-recipe-code = buf_recipe.recipe-code
     3253       .
     3254       run fbrlib-set-default-recipe in this-procedure (
     3255             input p-obj-type
     3256           , input p-obj-code
     3257           , input buf_goods.gds-code
     3258       ).
     3259   end.
     3260   END PROCEDURE.
     3261   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3262   define input parameter parparentproc-handle as widget-handle no-undo .
     3263   define input parameter p-doc-code   as character no-undo.
     3264   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3265       define variable v-shift-on      as logical      no-undo.
     3266       define variable v-shift-date    as date         no-undo.
     3267       define variable v-shift-num     as integer      no-undo.
     3268       define variable v-shift-name    as character    no-undo.
     3269       define variable v-obj-date      as date         no-undo.
     3270       define variable v-chip-num      as integer      no-undo.
     3271       define buffer buf_fbr-doc       for ub.fbr-doc.
     3272       define buffer buf_fbr-line      for ub.fbr-line.
     3273       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3274       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3275       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3276       define buffer buf_marking-lines for ub.marking-lines .
     3277       define buffer buf_marking       for ub.marking .
     3278       define buffer buf_goods         for ub.goods .
     3279   do
     3280   for buf_fbr-doc
     3281     , buf_fbr-line
     3282     , buf_c-fbr-doc
     3283     , buf_fbr-recipe
     3284     , buf_fbr-recipe-gds
     3285     , buf_goods
     3286     , buf_marking
     3287     , buf_marking-lines
     3288   on error undo, return error
     3289   :
     3290   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3291     define variable v-cntxt-db-num        as integer   no-undo .
     3292     define variable v-cntxt-userid        as character no-undo .
     3293     define variable v-cntxt-level         as character no-undo .
     3294     define variable v-cntxt-host-code-obj as integer   no-undo .
     3295     define variable v-cntxt-obj-type      as character no-undo .
     3296     define variable v-cntxt-obj-code      as integer   no-undo .
     3297     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3298     define variable v-cntxt-is-admin      as logical   no-undo .
     3299   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3300     run mainmenu_getcntxt in parparentproc-handle
     3301       (output v-cntxt-db-num
     3302       ,output v-cntxt-userid
     3303       ,output v-cntxt-level
     3304       ,output v-cntxt-host-code-obj
     3305       ,output v-cntxt-obj-type
     3306       ,output v-cntxt-obj-code
     3307       ,output v-cntxt-db-num-obj
     3308       ,output v-cntxt-is-admin
     3309       ) .
     3310       if search ("delfbr.err") <> ?
     3311       then do:
     3312           os-delete "delfbr.err".
     3313       end.
     3314     _del-block:
     3315       do transaction
     3316     on error undo _del-block, return error return-value
     3317     on endkey undo _del-block , return error return-value
     3318     on stop undo _del-block , return error return-value
     3319       :
     3320           find first buf_fbr-doc exclusive-lock
     3321                where buf_fbr-doc.doc-code = p-doc-code
     3322           no-error.
     3323           if not available buf_fbr-doc
     3324           then do:
     3325         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3326                                           ,vss-workfile
     3327                                           ,vss-revision
     3328                                           ,vss-description
     3329                                           ,chr(10)
     3330                                           , p-doc-code).
     3331           end.
     3332           run fbrlib-delete-fact-trn-doc in this-procedure (
     3333               input parparentproc-handle
     3334              ,input p-doc-code
     3335              ,input 'при':U
     3336              ,input p-chip-num
     3337              ,output v-chip-num
     3338           ) no-error.
     3339           if error-status :error
     3340           then do:
     3341               run fbrlib-print-del-error-message in this-procedure .
     3342         undo _del-block, return error.
     3343           end.
     3344           assign
     3345           p-chip-num = (if p-chip-num = ?
     3346                         then v-chip-num
     3347                         else p-chip-num).
     3348           run fbrlib-delete-fact-trn-doc in this-procedure (
     3349               input parparentproc-handle
     3350              ,input p-doc-code
     3351              ,input 'рас':U
     3352              ,input p-chip-num
     3353              ,output v-chip-num
     3354           ) no-error.
     3355           if error-status :error
     3356           then do:
     3357               run fbrlib-print-del-error-message in this-procedure .
     3358         undo _del-block, return error.
     3359           end.
     3360           run fbrlib-delete-fact-trn-doc in this-procedure (
     3361               input parparentproc-handle
     3362              ,input p-doc-code
     3363              ,input 'спи':U
     3364              ,input p-chip-num
     3365              ,output v-chip-num
     3366           ) no-error.
     3367           if error-status :error
     3368           then do:
     3369               run fbrlib-print-del-error-message in this-procedure .
     3370         undo _del-block, return error.
     3371           end.
     3372           create buf_c-fbr-doc.
     3373           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3374   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3376     (input  buf_fbr-doc.obj-type
     3377     ,input  buf_fbr-doc.obj-code
     3378     ,output v-obj-date
     3379     ) no-error .
     3380           if error-status :error
     3381           or v-obj-date = ?
     3382           then do:
     3383         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3384           end.
     3385   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3387     (input  buf_fbr-doc.obj-type
     3388     ,input  buf_fbr-doc.obj-code
     3389     ,input  'shift-on=request'
     3390     ,output v-shift-on
     3391     )  .
     3392           if v-shift-on
     3393           then do:
     3394   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3396     (input  buf_fbr-doc.obj-type
     3397     ,input  buf_fbr-doc.obj-code
     3398     ,output v-shift-date
     3399     ,output v-shift-num
     3400     ,output v-shift-name
     3401     ) no-error .
     3402               if error-status :error
     3403               then do:
     3404           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3405               end.
     3406           end.
     3407           else do:
     3408               assign
     3409                   v-shift-date = ?
     3410                   v-shift-num  = ?
     3411                   v-shift-name = ?
     3412               .
     3413           end.
     3414           define variable v-today       as date         no-undo.
     3415           define variable v-time        as integer      no-undo.
     3416           run cur-time in this-procedure (
     3417                 output v-today
     3418               , output v-time
     3419           ).
     3420           assign
     3421               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3422               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3423               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3424               buf_c-fbr-doc.corr-date        = v-today
     3425               buf_c-fbr-doc.corr-time        = v-time
     3426               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3427               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3428               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3429               buf_c-fbr-doc.is-del           = yes
     3430           .
     3431           assign
     3432               buf_fbr-doc.is-del = yes
     3433           .
     3434           for each buf_fbr-line exclusive-lock
     3435              where buf_fbr-line.doc-code = p-doc-code
     3436       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3437       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3438       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3439           :
     3440               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3441                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3442                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3443               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3444                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3445                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3446                                                       and buf_marking-lines.in-code  = "manufacturing"
     3447                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3448                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3449                                                       and buf_marking-lines.prt-code = 0
     3450               :
     3451                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3452                   assign
     3453                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3454                   .
     3455                 end .
     3456                 delete buf_marking-lines.
     3457               end .
     3458               delete buf_fbr-line.
     3459           end.
     3460           for each buf_fbr-recipe exclusive-lock
     3461              where buf_fbr-recipe.doc-code = p-doc-code
     3462       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3463       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3464       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3465           :
     3466               delete buf_fbr-recipe.
     3467           end.
     3468           for each buf_fbr-recipe-gds exclusive-lock
     3469              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3470       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3471       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3472       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3473           :
     3474               delete buf_fbr-recipe-gds.
     3475           end.
     3476           delete buf_fbr-doc.
     3477       end.
     3478   end.
     3479   END PROCEDURE.
     3480   PROCEDURE fbrlib-del-trn-doc :
     3481   do
     3482   on error undo, return error
     3483   :
     3484   define input parameter parparentproc        as widget-handle no-undo .
     3485   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3486   define input parameter p-trn-doc-type       as character    no-undo.
     3487   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3488   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3489       define variable v-trn-doc-doc-code  as character     no-undo.
     3490       define buffer buf_trn-doc       for ub.trn-doc.
     3491   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3492     define variable v-cntxt-db-num        as integer   no-undo .
     3493     define variable v-cntxt-userid        as character no-undo .
     3494     define variable v-cntxt-level         as character no-undo .
     3495     define variable v-cntxt-host-code-obj as integer   no-undo .
     3496     define variable v-cntxt-obj-type      as character no-undo .
     3497     define variable v-cntxt-obj-code      as integer   no-undo .
     3498     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3499     define variable v-cntxt-is-admin      as logical   no-undo .
     3500   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3501     run mainmenu_getcntxt in parparentproc
     3502       (output v-cntxt-db-num
     3503       ,output v-cntxt-userid
     3504       ,output v-cntxt-level
     3505       ,output v-cntxt-host-code-obj
     3506       ,output v-cntxt-obj-type
     3507       ,output v-cntxt-obj-code
     3508       ,output v-cntxt-db-num-obj
     3509       ,output v-cntxt-is-admin
     3510       ) .
     3511       run fbrcode-trn-doc in this-procedure (
     3512             input 'производство':U
     3513           , input p-fbr-doc-doc-code
     3514           , input p-trn-doc-type
     3515           , output v-trn-doc-doc-code
     3516       ).
     3517       find first buf_trn-doc no-lock
     3518            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3519       no-error.
     3520       if available buf_trn-doc
     3521       then do:
     3522           run str/del-doc.p (
     3523                 input parparentproc
     3524               , input buf_trn-doc.doc-code
     3525               , input v-cntxt-db-num
     3526               , input "del-doc.err"
     3527               , input ?
     3528               , input p-fbr-doc-doc-code
     3529               , input v-cntxt-userid
     3530               , input 0
     3531               , input p-phchip-num
     3532               , output p-chip-num
     3533           ) no-error.
     3534           if error-status :error
     3535           then do:
     3536             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3537                                           ,v-trn-doc-doc-code
     3538                                           ,p-fbr-doc-doc-code
     3539                                           , chr(10)
     3540                                           , error-status:get-message(1)
     3541                                           , return-value ).
     3542           end.
     3543       end.
     3544   end.
     3545   END PROCEDURE.
     3546   PROCEDURE fbrlib-delete-fact-trn-doc :
     3547   define input parameter parparentproc    as widget-handle    no-undo.
     3548   define input parameter p-fbr-doc-code   as character        no-undo.
     3549   define input parameter p-doc-type       as character    no-undo.
     3550   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3551   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3552       define variable v-doc-code          as character        no-undo.
     3553       define variable v-ext-doc-type      as character        no-undo.
     3554       define variable v-trn-doc-recid     as recid            no-undo.
     3555       define variable varchip-code        as integer          no-undo.
     3556       define variable varchip-code2       as integer          no-undo.
     3557       define variable v-chip-counter      as integer          no-undo.
     3558       define buffer buf_trn-doc       for ub.trn-doc.
     3559       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3560       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3561   do
     3562   for buf_trn-doc
     3563     , buf_pri_trn-doc
     3564     , buf_cons_trn-doc
     3565   on error undo, return error
     3566   :
     3567   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3568     define variable v-cntxt-db-num        as integer   no-undo .
     3569     define variable v-cntxt-userid        as character no-undo .
     3570     define variable v-cntxt-level         as character no-undo .
     3571     define variable v-cntxt-host-code-obj as integer   no-undo .
     3572     define variable v-cntxt-obj-type      as character no-undo .
     3573     define variable v-cntxt-obj-code      as integer   no-undo .
     3574     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3575     define variable v-cntxt-is-admin      as logical   no-undo .
     3576   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3577     run mainmenu_getcntxt in parparentproc
     3578       (output v-cntxt-db-num
     3579       ,output v-cntxt-userid
     3580       ,output v-cntxt-level
     3581       ,output v-cntxt-host-code-obj
     3582       ,output v-cntxt-obj-type
     3583       ,output v-cntxt-obj-code
     3584       ,output v-cntxt-db-num-obj
     3585       ,output v-cntxt-is-admin
     3586       ) .
     3587       run fbrcode-trn-doc in this-procedure (
     3588             input 'производство':U
     3589           , input p-fbr-doc-code
     3590           , input p-doc-type
     3591           , output v-doc-code
     3592       ).
     3593       find first buf_trn-doc no-lock
     3594            where buf_trn-doc.doc-code = v-doc-code
     3595       no-error.
     3596       if not available buf_trn-doc
     3597       then do:
     3598           if p-doc-type <> 'спи':U
     3599           then do:
     3600               message
     3601                   "Не найден документ '" p-doc-type "'"
     3602                   "по документу производства " p-fbr-doc-code
     3603               view-as alert-box.
     3604               undo, return error.
     3605           end.
     3606           else do:
     3607           end.
     3608       end.
     3609       else do:
     3610           assign
     3611               v-trn-doc-recid = recid( buf_trn-doc )
     3612               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3613           .
     3614           if v-ext-doc-type = 'ev':U
     3615           then do:
     3616               find first buf_pri_trn-doc no-lock
     3617                    where buf_pri_trn-doc.out-code     = v-doc-code
     3618                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3619               no-error.
     3620               if available buf_pri_trn-doc
     3621               then do:
     3622                   run str/del-doc.p (
     3623                         input parparentproc
     3624                       , input buf_pri_trn-doc.doc-code
     3625                       , input v-cntxt-db-num
     3626                       , input "delfbr.err"
     3627                       , input ?
     3628                       , input p-fbr-doc-code
     3629                       , input v-cntxt-userid
     3630                       , input 0
     3631                       , input (if p-ph-chip-num <> ?
     3632                               then p-ph-chip-num
     3633                               else (if varchip-code <> 0
     3634                                   then varchip-code
     3635                                   else ?)
     3636                               )
     3637                       , output varchip-code2
     3638                   ) no-error.
     3639                   if error-status :error
     3640                   then do:
     3641                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3642                                                   ,buf_pri_trn-doc.doc-code
     3643                                                   ,p-fbr-doc-code
     3644                                                   , chr(10)
     3645                                                   , error-status:get-message(1)
     3646                                                   , return-value ).
     3647                   end.
     3648               end.
     3649           end.
     3650           define buffer buf_out_trn-doc       for ub.trn-doc.
     3651           if p-doc-type = 'при':U
     3652           then do:
     3653               assign
     3654                   v-chip-counter = 0
     3655               .
     3656               for each buf_out_trn-doc exclusive-lock
     3657                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3658               on error undo, return error
     3659               :
     3660                   assign
     3661                       v-chip-counter = v-chip-counter + 1
     3662                   .
     3663                   if v-chip-counter > 1
     3664                   then do:
     3665                       assign
     3666                           varchip-code = varchip-code2
     3667                       .
     3668                   end.
     3669                   run str/del-doc.p (
     3670                         input parparentproc
     3671                       , input buf_out_trn-doc.doc-code
     3672                       , input v-cntxt-db-num
     3673                       , input "delfbr.err"
     3674                       , input ?
     3675                       , input p-fbr-doc-code
     3676                       , input v-cntxt-userid
     3677                       , input 0
     3678                       , input (if p-ph-chip-num <> ?
     3679                               then p-ph-chip-num
     3680                               else (if varchip-code <> 0
     3681                                   then varchip-code
     3682                                   else ?)
     3683                               )
     3684                       , output varchip-code2
     3685                   ) no-error.
     3686                   if error-status :error
     3687                   then do:
     3688                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3689                                                   ,buf_out_trn-doc.doc-code
     3690                                                   ,buf_trn-doc.doc-code
     3691                                                   ,p-fbr-doc-code
     3692                                                   , chr(10)
     3693                                                   , error-status:get-message(1)
     3694                                                   , return-value ).
     3695                   end.
     3696               end.
     3697           end.
     3698           run str/del-doc.p (
     3699                 input parparentproc
     3700               , input buf_trn-doc.doc-code
     3701               , input v-cntxt-db-num
     3702               , input "delfbr.err"
     3703               , input ?
     3704               , input p-fbr-doc-code
     3705               , input v-cntxt-userid
     3706               , input 0
     3707               , input (if p-ph-chip-num <> ?
     3708                        then p-ph-chip-num
     3709                        else (if varchip-code <> 0
     3710                              then varchip-code
     3711                              else ?)
     3712                        )
     3713               , output varchip-code2
     3714           ) no-error.
     3715           if error-status :error
     3716           then do:
     3717               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3718                                             ,buf_trn-doc.doc-code
     3719                                             ,p-fbr-doc-code
     3720                                             , chr(10)
     3721                                             , error-status:get-message(1)
     3722                                             , return-value ).
     3723           end.
     3724           if p-doc-type = 'рас':U
     3725           or p-doc-type = 'спи':U
     3726           then do:
     3727               assign
     3728                   v-chip-counter = 0
     3729               .
     3730               for each buf_cons_trn-doc no-lock
     3731                  where buf_cons_trn-doc.out-code      = v-doc-code
     3732                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3733               :
     3734                   assign
     3735                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3736                       v-chip-counter = v-chip-counter + 1
     3737                   .
     3738                   assign
     3739                   varchip-code = if v-chip-counter = 2
     3740                                  then varchip-code2
     3741                                  else varchip-code.
     3742                   run str/del-doc.p (
     3743                         input parparentproc
     3744                       , input buf_cons_trn-doc.doc-code
     3745                       , input v-cntxt-db-num
     3746                       , input "delfbr.err"
     3747                       , input ?
     3748                       , input ?
     3749                       , input v-cntxt-userid
     3750                       , input 0
     3751                       , input (if p-ph-chip-num <> ?
     3752                                then p-ph-chip-num
     3753                                else ( if v-chip-counter = 1
     3754                                       then ?
     3755                                       else varchip-code )
     3756                                )
     3757                       , output varchip-code2
     3758                   ) no-error.
     3759                   if error-status :error
     3760                   then do:
     3761                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3762                                                     ,buf_cons_trn-doc.doc-code
     3763                                                     ,p-fbr-doc-code
     3764                                                     , chr(10)
     3765                                                     , error-status:get-message(1)
     3766                                                     , return-value ).
     3767                   end.
     3768                   assign
     3769                       p-chip-num = varchip-code2
     3770                   .
     3771               end.
     3772           end.
     3773           assign
     3774               p-chip-num = varchip-code2
     3775           .
     3776       end.
     3777   end.
     3778   END PROCEDURE.
     3779   PROCEDURE fbrlib-print-del-error-message :
     3780   do
     3781   on error undo, return error
     3782   :
     3783       define variable v-user-action   as character    no-undo.
     3784       define variable v-printed       as logical      no-undo.
     3785       message
     3786           vss-workfile vss-revision vss-description
     3787           skip "Ошибка при удалении документа."
     3788           skip return-value
     3789           skip trim(error-status :get-message(1))
     3790           skip trim(error-status :get-message(2))
     3791           skip trim(error-status :get-message(3))
     3792       view-as alert-box error.
     3793       if search ("delfbr.err") <> ?
     3794       then do:
     3795         run gbl/prnfilen.w
     3796           (input  "Ошибки при удалении документа производства"
     3797           ,input  0
     3798           ,input  "delfbr.err"
     3799           ,input  7
     3800           ,output v-user-action
     3801           ,output v-printed
     3802           ).
     3803       end.
     3804   end.
     3805   END PROCEDURE.
     3806   procedure fbrlib-calc-brutto :
     3807   define input parameter p-recipe-type        as character        no-undo.
     3808   define input parameter p-netto              as decimal          no-undo.
     3809   define input parameter p-coeff-value        as decimal          no-undo.
     3810   define input parameter p-coeff-waste        as decimal          no-undo.
     3811   define input parameter p-brutto             as decimal          no-undo.
     3812   define input parameter p-calc-method        as integer          no-undo.
     3813   define output parameter p-new-netto         as decimal          no-undo.
     3814   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3815   define output parameter p-new-brutto        as decimal          no-undo.
     3816   define output parameter p-new-calc-method   as integer          no-undo.
     3817   do
     3818   on error undo, return error
     3819   :
     3820       if p-recipe-type <> 'производство':U
     3821       then do:
     3822           assign
     3823               p-new-coeff-waste = 0
     3824               p-new-calc-method = 1
     3825               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3826               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3827           .
     3828       end.
     3829       else do:
     3830           assign
     3831               p-new-calc-method = p-calc-method
     3832           .
     3833           if p-coeff-waste = 0
     3834           then do:
     3835               assign
     3836                   p-coeff-value = 0
     3837               .
     3838           end.
     3839           case p-calc-method
     3840           :
     3841               when 1
     3842               then do:
     3843                   assign
     3844                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3845                       p-new-coeff-waste   = p-coeff-waste
     3846                       p-new-brutto        = p-brutto
     3847                   .
     3848               end.
     3849               when 2
     3850               then do:
     3851                   assign
     3852                       p-new-netto         = p-netto
     3853                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3854                       p-new-brutto        = p-brutto
     3855                   .
     3856               end.
     3857               when 3
     3858               then do:
     3859                   assign
     3860                       p-new-netto         = p-netto
     3861                       p-new-coeff-waste   = p-coeff-waste
     3862                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3863                   .
     3864               end.
     3865               otherwise do:
     3866                   define variable v-yesno    as logical      no-undo.
     3867                   assign
     3868                       v-yesno = yes
     3869                   .
     3870                   message
     3871                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3872                       skip "Значение метода должно быть 1, 2 или 3."
     3873                       skip(1)
     3874                       skip "Заданное значение:" p-calc-method
     3875                       skip(1)
     3876                       skip "Установить значение метода расчета 1"
     3877                       skip "(расчет нетто по брутто и проценту потерь)?"
     3878                   view-as alert-box warning
     3879                   buttons yes-no
     3880                   title "Неверное значение метода пересчета в строках документа-производства"
     3881                   update v-yesno
     3882                   .
     3883                   if v-yesno = yes
     3884                   then do:
     3885                       assign
     3886                           p-new-calc-method   = 1
     3887                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3888                           p-new-coeff-waste   = p-coeff-waste
     3889                           p-new-brutto        = p-brutto
     3890                       .
     3891                   end.
     3892                   else do:
     3893                       message
     3894                               vss-workfile vss-revision vss-description
     3895                           skip(1)
     3896                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3897                           skip return-value
     3898                           skip trim(error-status :get-message(1))
     3899                               trim(error-status :get-message(2))
     3900                               trim(error-status :get-message(3))
     3901                       view-as alert-box error
     3902                       title "Неверное значение метода расчета"
     3903                       .
     3904                       undo, return error .
     3905                   end.
     3906               end.
     3907           end case.
     3908       end.
     3909   end.
     3910   end procedure.
     3911   procedure fbrlib-check-brutto :
     3912   define input parameter p-recipe-type        as character        no-undo.
     3913   define input parameter p-netto              as decimal          no-undo.
     3914   define input parameter p-coeff-value        as decimal          no-undo.
     3915   define input parameter p-coeff-waste        as decimal          no-undo.
     3916   define input parameter p-brutto             as decimal          no-undo.
     3917   define input parameter p-calc-method        as integer          no-undo.
     3918   define output parameter p-error-message     as character        no-undo.
     3919   define output parameter p-not-good          as logical          no-undo.
     3920   do
     3921   on error undo, return error
     3922   :
     3923       if p-recipe-type <> 'производство':U
     3924       then do:
     3925           if p-netto <> p-brutto
     3926           or p-coeff-waste <> 0
     3927           then do:
     3928               assign
     3929                   p-not-good      = yes
     3930                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3931                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3932               .
     3933           end.
     3934       end.
     3935       else do:
     3936           if p-coeff-waste = 0
     3937           then do:
     3938               assign
     3939                   p-coeff-value = 0
     3940               .
     3941           end.
     3942           case p-calc-method
     3943           :
     3944               when 1
     3945               then do:
     3946                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3947                   then do:
     3948                       assign
     3949                           p-not-good      = yes
     3950                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3951                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3952                       .
     3953                   end.
     3954               end.
     3955               when 2
     3956               then do:
     3957                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3958                   then do:
     3959                       assign
     3960                           p-not-good      = yes
     3961                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3962                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3963                       .
     3964                   end.
     3965               end.
     3966               when 3
     3967               then do:
     3968                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3969                   then do:
     3970                       assign
     3971                           p-not-good      = yes
     3972                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3973                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3974                       .
     3975                   end.
     3976               end.
     3977               otherwise do:
     3978                   assign
     3979                       p-not-good      = yes
     3980                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3981                   .
     3982               end.
     3983           end case.
     3984       end.
     3985   end.
     3986   end procedure.
     3987   procedure fbrlib-check-fbr-recipe :
     3988   define input parameter p-doc-code       as character        no-undo.
     3989   define input parameter p-recipe-code    as character        no-undo.
     3990   define output parameter p-is-correct    as logical          no-undo.
     3991       define variable v-comp-factor    as decimal      no-undo.
     3992       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3993       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3994       define buffer buf_fbr-line          for ub.fbr-line.
     3995   do
     3996   for buf_fbr-recipe
     3997     , buf_fbr-recipe-gds
     3998     , buf_fbr-line
     3999   on error undo, return error
     4000   :
     4001       assign
     4002           p-is-correct = yes
     4003       .
     4004       find first buf_fbr-recipe no-lock
     4005            where buf_fbr-recipe.doc-code    = p-doc-code
     4006              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4007       .
     4008       if not available buf_fbr-recipe then do:
     4009         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4010       end.
     4011       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4012       then do:
     4013       end.
     4014       else do:
     4015           find first buf_fbr-line no-lock
     4016                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4017                  and buf_fbr-line.is-comp     = yes
     4018                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4019                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4020                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4021                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4022           .
     4023           assign
     4024               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4025           .
     4026           recipe-line-cycle:
     4027           for each buf_fbr-recipe-gds no-lock
     4028              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4029                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4030           on error undo, return error
     4031           :
     4032               find first buf_fbr-line no-lock
     4033                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4034                      and buf_fbr-line.is-comp     = no
     4035                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4036                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4037                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4038                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4039               .
     4040               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4041               then do:
     4042                   assign
     4043                       p-is-correct = no
     4044                   .
     4045                   leave recipe-line-cycle.
     4046               end.
     4047           end.
     4048       end.
     4049   end.
     4050   end procedure.
     4051   procedure fbrlib-get-recipe-type :
     4052   define input parameter p-fbr-doc-code   as character        no-undo.
     4053   define input parameter p-recipe-code    as character        no-undo.
     4054   define output parameter p-recipe-type   as character        no-undo.
     4055       define buffer buf_recipe        for ub.recipe.
     4056       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4057   do
     4058   for buf_recipe
     4059     , buf_fbr-recipe
     4060   on error undo, return error
     4061   :
     4062       if p-fbr-doc-code = ""
     4063       then do:
     4064           find first buf_recipe no-lock
     4065                where buf_recipe.recipe-code = p-recipe-code
     4066           no-error.
     4067           if available buf_recipe
     4068           then do:
     4069               assign
     4070                   p-recipe-type = buf_recipe.recipe-type
     4071               .
     4072           end.
     4073           else do:
     4074               assign
     4075                   p-recipe-type = "":U
     4076               .
     4077           end.
     4078       end.
     4079       else do:
     4080           find first buf_fbr-recipe no-lock
     4081                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4082                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4083           no-error.
     4084           if available buf_fbr-recipe
     4085           then do:
     4086               assign
     4087                   p-recipe-type = buf_fbr-recipe.recipe-type
     4088               .
     4089           end.
     4090           else do:
     4091               assign
     4092                   p-recipe-type = "":U
     4093               .
     4094           end.
     4095       end.
     4096   end.
     4097   end procedure.
     4098   PROCEDURE calc-comp-from-ingr :
     4099   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4100   define input parameter p-fact-qnty                          as decimal      no-undo.
     4101   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4102   define output parameter p-comp-qnty                         as decimal      no-undo.
     4103       define variable v-ingr-qnty     as decimal       no-undo.
     4104       define buffer buf_i_fbr-line    for ub.fbr-line.
     4105       define buffer buf_fbr-line      for ub.fbr-line.
     4106       define buffer buf_recipe        for ub.fbr-recipe.
     4107       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4108   do
     4109   for buf_i_fbr-line
     4110     , buf_fbr-line
     4111     , buf_recipe
     4112     , buf_recipe-gds
     4113   on error undo, return error
     4114   :
     4115       find first buf_i_fbr-line no-lock
     4116            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4117       .
     4118       find first buf_recipe no-lock
     4119            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4120              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4121       no-error.
     4122       if not available buf_recipe
     4123       then do:
     4124           message
     4125                   vss-workfile vss-revision vss-description
     4126               skip "В строке производства не указан рецепт."
     4127               skip "Невозможно рассчитать количество составного товара."
     4128               skip return-value
     4129               skip trim(error-status :get-message(1))
     4130                   trim(error-status :get-message(2))
     4131                   trim(error-status :get-message(3))
     4132           view-as alert-box error.
     4133           undo, return error .
     4134       end.
     4135       if buf_recipe.recipe-type = 'альтернатива':U
     4136       then do:
     4137           for each buf_fbr-line no-lock
     4138              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4139                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4140                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4141           on error undo, return error
     4142           :
     4143               find first buf_recipe-gds no-lock
     4144                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4145                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4146                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4147                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4148                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4149               .
     4150               assign
     4151                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4152               .
     4153           end.
     4154           assign
     4155               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4156           .
     4157       end.
     4158       else do:
     4159           find first buf_recipe-gds no-lock
     4160                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4161                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4162                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4163                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4164                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4165           .
     4166           assign
     4167               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4168           .
     4169       end.
     4170       find first buf_fbr-line no-lock
     4171            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4172              and buf_fbr-line.is-comp     = yes
     4173              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4174       .
     4175       assign
     4176           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4177       .
     4178   end.
     4179   END PROCEDURE.
     4180   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4181   define input parameter p-recipe-code    as character    no-undo.
     4182   define input parameter p-gds-code       as integer      no-undo.
     4183   define output parameter p-line-qnty     as decimal      no-undo.
     4184   define output parameter p-used-qnty     as decimal      no-undo.
     4185   define output parameter p-recipe-qnty   as decimal      no-undo.
     4186       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4187   do
     4188   for buf_temp_dressing-ingr
     4189   on error undo, return error
     4190   :
     4191       find first buf_temp_dressing-ingr no-lock
     4192            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4193              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4194       no-error.
     4195       if available buf_temp_dressing-ingr
     4196       then do:
     4197           assign
     4198               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4199               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4200               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4201           .
     4202       end.
     4203       else do:
     4204           assign
     4205               p-line-qnty     = 0
     4206               p-used-qnty     = 0
     4207               p-recipe-qnty   = 0
     4208           .
     4209       end.
     4210   end.
     4211   END PROCEDURE.
     4212   PROCEDURE fbrlib_adjust-recipe :
     4213   do
     4214   on error undo, return error
     4215   :
     4216   define input parameter parparentproc as widget-handle no-undo .
     4217   define input parameter p-fbrhist-handle as handle no-undo .
     4218   define input parameter p-doc-code       as character    no-undo.
     4219   define input parameter p-recipe-code    as character    no-undo.
     4220   define input parameter p-price-sale-obj-type as character no-undo .
     4221   define input parameter p-price-sale-obj-code as integer no-undo .
     4222       define variable v-recipe-qnty       as decimal      no-undo.
     4223       define variable v-comp-qnty         as decimal      no-undo.
     4224       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4225       define variable v-ingr-qnty         as decimal      no-undo.
     4226       define variable v-qnty              as decimal      no-undo.
     4227       define variable v-coeff-waste       as decimal      no-undo.
     4228       define variable v-brutto-qnty       as decimal      no-undo.
     4229       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4230       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4231       define buffer buf_fbr-line          for ub.fbr-line.
     4232       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4233       find first buf_fbr-recipe no-lock
     4234            where buf_fbr-recipe.doc-code      = p-doc-code
     4235              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4236       .
     4237       assign
     4238           v-recipe-qnty = buf_fbr-recipe.qnty
     4239       .
     4240       find first buf_fbr-line no-lock
     4241            where buf_fbr-line.doc-code    = p-doc-code
     4242              and buf_fbr-line.is-comp     = yes
     4243              and buf_fbr-line.recipe-code = p-recipe-code
     4244       .
     4245       assign
     4246           v-comp-qnty = buf_fbr-line.fact-qnty
     4247       .
     4248       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4249       then do:
     4250       end.
     4251       else do:
     4252           for each buf_fbr-recipe-gds no-lock
     4253              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4254                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4255           on error undo, return error
     4256           :
     4257               find first buf_fbr-line no-lock
     4258                    where buf_fbr-line.doc-code    = p-doc-code
     4259                      and buf_fbr-line.is-comp     = no
     4260                      and buf_fbr-line.recipe-code = p-recipe-code
     4261                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4262                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4263                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4264               .
     4265               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4266               then do:
     4267                   do transaction
     4268                   on error undo, return error
     4269                   :
     4270                       find first buf_el_fbr-recipe-gds exclusive-lock
     4271                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4272                       .
     4273                       assign
     4274                           buf_el_fbr-recipe-gds.calc-method   = 1
     4275                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4276                       .
     4277                       run fbrlib-calc-brutto in this-procedure (
     4278                             input buf_fbr-recipe.recipe-type
     4279                           , input 0
     4280                           , input buf_el_fbr-recipe-gds.coeff-value
     4281                           , input buf_el_fbr-recipe-gds.coeff-waste
     4282                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4283                           , input 1
     4284                           , output buf_el_fbr-recipe-gds.qnty
     4285                           , output buf_el_fbr-recipe-gds.coeff-waste
     4286                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4287                           , output buf_el_fbr-recipe-gds.calc-method
     4288                       ).
     4289                   end.
     4290               end.
     4291           end.
     4292           run fbrlib_adjust-doc-lines in this-procedure (
     4293                 input parparentproc
     4294               , input p-fbrhist-handle
     4295               , input p-doc-code
     4296               , input p-recipe-code
     4297               , input p-price-sale-obj-type
     4298               , input p-price-sale-obj-code
     4299           ).
     4300       end.
     4301   end.
     4302   END PROCEDURE.
     4303   PROCEDURE fbrlib_adjust-doc-lines :
     4304   define input parameter parparentproc as widget-handle no-undo .
     4305   define input parameter p-fbrhist-handle as handle no-undo .
     4306   define input parameter p-doc-code       as character    no-undo.
     4307   define input parameter p-recipe-code    as character    no-undo.
     4308   define input parameter p-price-sale-obj-type as character no-undo .
     4309   define input parameter p-price-sale-obj-code as integer no-undo .
     4310   define variable v-comp-qnty         as decimal      no-undo.
     4311   define variable v-trn-type          as character    no-undo.
     4312   define variable v-ingr-qnty         as decimal      no-undo.
     4313   define variable v-recipe-qnty       as decimal      no-undo.
     4314   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4315   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4316   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4317   define buffer buf_fbr-line          for ub.fbr-line.
     4318   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4319   define buffer buf_goods             for ub.goods.
     4320   define buffer buf_fbr-doc           for ub.fbr-doc.
     4321   do
     4322   for buf_fbr-recipe
     4323     , buf_fbr-recipe-gds
     4324     , buf_fbr-line
     4325     , buf_coeff_fbr-line
     4326     , buf_goods
     4327     , buf_fbr-doc
     4328   on error undo, return error
     4329   :
     4330       find first buf_fbr-line no-lock
     4331            where buf_fbr-line.doc-code      = p-doc-code
     4332              and buf_fbr-line.is-comp       = yes
     4333              and buf_fbr-line.recipe-code   = p-recipe-code
     4334       .
     4335       find first buf_fbr-doc no-lock
     4336            where buf_fbr-doc.doc-code      = p-doc-code
     4337       .
     4338       assign
     4339           v-comp-qnty = buf_fbr-line.fact-qnty
     4340           v-trn-type  = buf_fbr-line.trn-type
     4341       .
     4342       find first buf_fbr-recipe no-lock
     4343            where buf_fbr-recipe.doc-code    = p-doc-code
     4344              and buf_fbr-recipe.recipe-code = p-recipe-code
     4345       .
     4346       assign
     4347       v-recipe-qnty = buf_fbr-recipe.qnty
     4348       .
     4349       do transaction
     4350       on error undo, return error
     4351       :
     4352           for each buf_fbr-recipe-gds no-lock
     4353              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4354                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4355           on error undo, return error
     4356           :
     4357               find first buf_fbr-line no-lock
     4358                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4359                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4360                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4361                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4362                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4363               no-error.
     4364               if not available buf_fbr-line
     4365               then do:
     4366                   find first buf_goods no-lock
     4367                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4368                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4369                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4370                   .
     4371                   run str/fbr-crln.p (
     4372                         input parparentproc
     4373                       , input recid( buf_fbr-doc )
     4374                       , input recid( buf_goods )
     4375                       , input buf_fbr-recipe-gds.recipe-code
     4376                       , input v-trn-type
     4377                       , input no
     4378                       , input no
     4379                       , input buf_fbr-doc.obj-type
     4380                       , input buf_fbr-doc.obj-code
     4381                       , output v-fbr-v-fbr-doc-line-recid
     4382                   ).
     4383                   find first buf_fbr-line no-lock
     4384                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4385                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4386                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4387                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4388                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4389                   no-error.
     4390                   if not available buf_fbr-line
     4391                   then do:
     4392                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4393                                                      , p-doc-code
     4394                                                      , buf_fbr-recipe-gds.artic
     4395                                                      , buf_fbr-recipe-gds.prod-type
     4396                                                      , buf_fbr-recipe-gds.prod-code).
     4397                   end.
     4398               end.
     4399               find first buf_coeff_fbr-line exclusive-lock
     4400                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4401               .
     4402               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4403               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4404               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4405               then do:
     4406                   assign
     4407                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4408                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4409                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4410                   .
     4411               end.
     4412           end.
     4413       end.
     4414       define variable v-need-goods    as logical       no-undo.
     4415       define variable v-need-goods-list       as character     no-undo.
     4416       define variable v-need-goods-qnty-list  as character     no-undo.
     4417       find first buf_fbr-line no-lock
     4418            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4419              and buf_fbr-line.is-comp     = yes
     4420              and buf_fbr-line.recipe-code = p-recipe-code
     4421       .
     4422       run str/fbr-qnty.p (
     4423             input parparentproc
     4424           , input p-fbrhist-handle
     4425           , input recid( buf_fbr-doc )
     4426           , input recid( buf_fbr-line )
     4427           , input no
     4428           , input "ingr"
     4429           , input no
     4430           , input p-price-sale-obj-type
     4431           , input p-price-sale-obj-code
     4432           , input no
     4433           , input no
     4434           , input no
     4435           , output v-need-goods
     4436           , output v-need-goods-list
     4437           , output v-need-goods-qnty-list
     4438       ).
     4439   end.
     4440   END PROCEDURE.
     4441   procedure fbrlib_check-before-close :
     4442   define input parameter p-doc-code as character no-undo .
     4443   define variable same-sale as decimal no-undo .
     4444   define variable is-waste as logical no-undo .
     4445   define variable fix-price as logical no-undo .
     4446   define buffer buf_fbr-doc for ub.fbr-doc.
     4447   define buffer buf_fbr-line for ub.fbr-line.
     4448   define buffer buf_goods for ub.goods.
     4449   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4450   do
     4451   on error undo, return error
     4452   :
     4453     for each buf_fbr-line no-lock
     4454         where buf_fbr-line.doc-code = p-doc-code
     4455       , each buf_goods no-lock
     4456         where buf_goods.artic     = buf_fbr-line.artic
     4457           and buf_goods.prod-type = buf_fbr-line.prod-type
     4458           and buf_goods.prod-code = buf_fbr-line.prod-code
     4459     break by buf_fbr-line.prod-type
     4460           by buf_fbr-line.prod-code
     4461           by buf_fbr-line.artic
     4462     :
     4463       if first-of (buf_fbr-line.artic)
     4464       then do:
     4465         assign
     4466         same-sale = buf_fbr-line.price-sale
     4467         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4468         fix-price = buf_fbr-line.is-calc
     4469         .
     4470       end.
     4471       if same-sale <> buf_fbr-line.price-sale
     4472       then do:
     4473           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4474                                         ,p-doc-code
     4475                                         ,buf_goods.artic
     4476                                         ,buf_goods.gds-name
     4477                                         ,chr(10)).
     4478       end.
     4479       if fix-price <> buf_fbr-line.is-calc then do:
     4480           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4481                                         ,p-doc-code
     4482                                         ,buf_goods.artic
     4483                                         ,buf_goods.gds-name
     4484                                         ,chr(10)).
     4485       end.
     4486       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4487       then do:
     4488         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4489                                         ,p-doc-code
     4490                                         ,buf_goods.artic
     4491                                         ,buf_goods.gds-name
     4492                                         ,chr(10)).
     4493       end.
     4494       if buf_fbr-line.rsrv-qnty <> ?
     4495       and buf_goods.gds-type <> 'у':U
     4496       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4497       and buf_fbr-line.fact-qnty <> 0
     4498       then do:
     4499         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4500           if  can-find(first buf_fbr-gds-obj no-lock where
     4501                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4502               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4503               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4504               and buf_fbr-gds-obj.is-null-price  )  then .
     4505                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4506                                         ,p-doc-code
     4507                                         ,buf_goods.artic
     4508                                         ,buf_goods.gds-name
     4509                                         ,chr(10)
     4510                                         ,buf_fbr-line.recipe-code
     4511                                         ).
     4512         end.
     4513         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4514                                         ,p-doc-code
     4515                                         ,buf_goods.artic
     4516                                         ,buf_goods.gds-name
     4517                                         ,chr(10)
     4518                                         ,buf_fbr-line.recipe-code
     4519                                         ).
     4520       end.
     4521     end.
     4522   end.
     4523   end procedure.
     4524   procedure fbrrest-get-free-qnty :
     4525   do
     4526   on error undo, return error
     4527   :
     4528   define input parameter p-obj-type       as character            no-undo.
     4529   define input parameter p-obj-code       as integer              no-undo.
     4530   define input parameter p-gds-code       as integer              no-undo.
     4531   define input parameter p-autofbr        as logical              no-undo.
     4532   define output parameter p-avail-qnty    as decimal              no-undo.
     4533       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     4534       define variable v-free-qnty as decimal       no-undo.
     4535       define buffer buf_goods         for ub.goods.
     4536       define buffer buf_gds-obj       for ub.gds-obj.
     4537       define buffer buf_temp-parts    for temp-parts.
     4538       find first buf_goods no-lock
     4539            where buf_goods.gds-code = p-gds-code
     4540       .
     4541       assign
     4542           p-avail-qnty = 0
     4543       .
     4544       run partslib-init-temp-parts in this-procedure (
     4545             input p-obj-type
     4546           , input p-obj-code
     4547           , input buf_goods.artic
     4548           , input buf_goods.prod-type
     4549           , input buf_goods.prod-code
     4550       ).
     4551       assign
     4552           v-free-qnty = 0
     4553       .
     4554       for each buf_temp-parts
     4555       on error undo, return error
     4556       :
     4557           if buf_temp-parts.qnty > 0
     4558           then do:
     4559               assign
     4560                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     4561               .
     4562           end.
     4563       end.
     4564       assign
     4565           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     4566       .
     4567   end.
     4568   end procedure.
     4569   procedure fbrrest-get-catering-object :
     4570   do
     4571   on error undo, return error
     4572   :
     4573   define input parameter p-obj-code            as integer      no-undo.
     4574   define output parameter p-catering-obj-type  as character    no-undo.
     4575   define output parameter p-catering-obj-code  as integer      no-undo.
     4576       define buffer buf_shop              for ub.shop.
