     4578            where buf_shop.obj-code = p-obj-code
     4579       .
     4580       assign
     4581           p-catering-obj-type = buf_shop.kitchen-store-type
     4582           p-catering-obj-code = buf_shop.kitchen-store-code
     4583       .
     4584   end.
     4585   end procedure.
     4586   define variable vss-include-info40 as character format "X(65)" no-undo
     4587   initial "@(#)$Workfile$ $Revision$".
     4588   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4589   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     4590       define variable v-upper-code as int no-undo.
     4591       define variable v-value as character no-undo.
     4592       define variable v-type as character no-undo.
     4593       define buffer lc_gds-grp for ub.gds-grp.
     4594       define buffer lc_goods for ub.goods.
     4595      if p-gds-code <> 0 then do:
     4596       find first lc_goods where lc_goods.gds-code = p-gds-code.
     4597       v-upper-code = lc_goods.grp-code.
     4598       do while v-upper-code > 0 :
     4599           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4600           run ggoattr-value(
     4601             input lc_gds-grp.node-code,
     4602             input 0,
     4603             input "",
     4604             input 0,
     4605             input 'ban-sales-via-cd':U,
     4606             output v-value,
     4607             output v-type
     4608           ).
     4609          if v-value = "yes" then
     4610             return true.
     4611          else
     4612          do:
     4613             run ggoattr-value(
     4614                input lc_gds-grp.node-code,
     4615                input v-cntxt-host-code-obj,
     4616                input "",
     4617                input 0,
     4618                input 'ban-sales-via-cd':U,
     4619                output v-value,
     4620                output v-type
     4621                ).
     4622             if v-value = "yes" then
     4623                return true.
     4624             else
     4625             do:
     4626                run ggoattr-value(
     4627                   input lc_gds-grp.node-code,
     4628                   input v-cntxt-host-code-obj,
     4629                   input v-cntxt-obj-type,
     4630                   input v-cntxt-obj-code,
     4631                   input 'ban-sales-via-cd':U,
     4632                   output v-value,
     4633                   output v-type
     4634                   ).
     4635                if v-value = "yes" then
     4636                   return true.
     4637                else v-upper-code = lc_gds-grp.upper-code.
     4638             end .
     4639          end.
     4640         end.
     4641       end.
     4642       if v-value = "" or logical(v-value) = false then return false .
     4643   end.
     4644   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     4645       define variable v-upper-code as int no-undo.
     4646       define variable v-value as character no-undo.
     4647       define variable v-type as character no-undo.
     4648       define buffer lc_gds-grp for ub.gds-grp.
     4649       define buffer lc_goods for ub.goods.
     4650       v-upper-code = p-grp-code.
     4651       do while v-upper-code > 0 :
     4652           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4653           run ggoattr-value(
     4654             input lc_gds-grp.node-code,
     4655             input 0,
     4656             input "",
     4657             input 0,
     4658             input 'ban-sales-via-cd':U,
     4659             output v-value,
     4660             output v-type
     4661           ).
     4662          if v-value = "yes" then
     4663             return true.
     4664          else
     4665          do:
     4666             run ggoattr-value(
     4667                input lc_gds-grp.node-code,
     4668                input v-cntxt-host-code-obj,
     4669                input "",
     4670                input 0,
     4671                input 'ban-sales-via-cd':U,
     4672                output v-value,
     4673                output v-type
     4674                ).
     4675             if v-value = "yes" then
     4676                return true.
     4677             else
     4678             do:
     4679                run ggoattr-value(
     4680                   input lc_gds-grp.node-code,
     4681                   input v-cntxt-host-code-obj,
     4682                   input v-cntxt-obj-type,
     4683                   input v-cntxt-obj-code,
     4684                   input 'ban-sales-via-cd':U,
     4685                   output v-value,
     4686                   output v-type
     4687                   ).
     4688                if v-value = "yes" then
     4689                   return true.
     4690                else v-upper-code = lc_gds-grp.upper-code.
     4691             end .
     4692          end.
     4693         end.
     4694   end.
     4695   define temp-table temp_goods-qnty no-undo
     4696       field gds-code      as integer
     4697       field artic         as character
     4698       field prod-type     as character
     4699       field prod-code     as integer
     4700       field recipe-type   as character
     4701       field recipe-code   as character
     4702       field trn-type      as character
     4703       field need-qnty     as decimal
     4704       field calculated    as logical
     4705       index pi is primary unique gds-code recipe-code
     4706       index cl calculated
     4707   .
     4708   PROCEDURE create-initial-temp-goods :
     4709   do
     4710   on error undo, return error
     4711   :
     4712   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4713   define input parameter p-artic              as character    no-undo.
     4714   define input parameter p-prod-type          as character    no-undo.
     4715   define input parameter p-prod-code          as integer      no-undo.
     4716   define input parameter p-trn-type           as character    no-undo.
     4717   define input parameter p-recipe-type        as character    no-undo.
     4718   define input parameter p-recipe-code        as character    no-undo.
     4719   define input parameter p-need-qnty          as decimal      no-undo.
     4720   define output parameter p-same-good             as logical      no-undo.
     4721   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     4722       define variable v-gds-code    as integer      no-undo.
     4723       define buffer buf_fbr-doc               for ub.fbr-doc.
     4724       define buffer buf_fbr-line              for ub.fbr-line.
     4725       define buffer buf_recipe                for ub.fbr-recipe.
     4726       define buffer buf_obj_recipe            for ub.recipe.
     4727       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4728       run clear-temp-tables in this-procedure.
     4729   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4731     (input  p-artic
     4732     ,input  p-prod-type
     4733     ,input  p-prod-code
     4734     ,output v-gds-code
     4735     )  .
     4736       create buf_temp_goods-qnty.
     4737       assign
     4738           buf_temp_goods-qnty.gds-code    = v-gds-code
     4739           buf_temp_goods-qnty.artic       = p-artic
     4740           buf_temp_goods-qnty.prod-type   = p-prod-type
     4741           buf_temp_goods-qnty.prod-code   = p-prod-code
     4742           buf_temp_goods-qnty.trn-type    = p-trn-type
     4743           buf_temp_goods-qnty.recipe-type = p-recipe-type
     4744           buf_temp_goods-qnty.recipe-code = p-recipe-code
     4745           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     4746           buf_temp_goods-qnty.calculated  = no
     4747       .
     4748       assign
     4749           p-same-good                 = no
     4750           p-same-good-old-qnty        = 0
     4751       .
     4752       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     4753       for each buf_fbr-line no-lock
     4754          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4755            and buf_fbr-line.is-comp  = yes
     4756       on error undo, return error
     4757       :
     4758           find first buf_temp_goods-qnty
     4759                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     4760                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     4761                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     4762           no-error.
     4763           if available buf_temp_goods-qnty
     4764           then do:
     4765               assign
     4766                   p-same-good                 = yes
     4767                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     4768                   buf_temp_goods-qnty.calculated  = no
     4769               .
     4770           end.
     4771           else do:
     4772               define variable v-recipe-type   as character     no-undo.
     4773               run copy-recipe-in-doc in this-procedure (
     4774                     input p-fbr-doc-doc-code
     4775                   , input buf_fbr-line.recipe-code
     4776                   , input buf_fbr-doc.doc-date
     4777                   , input buf_fbr-doc.obj-type
     4778                   , input buf_fbr-doc.obj-code
     4779               ).
     4780               find first buf_recipe no-lock
     4781                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     4782                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     4783               no-error.
     4784               if available buf_recipe
     4785               then do:
     4786                   assign
     4787                       v-recipe-type = buf_recipe.recipe-type
     4788                   .
     4789                   if v-recipe-type = 'разделка':U
     4790                   or ( v-recipe-type = 'комплектация':U
     4791                       and buf_fbr-line.trn-type = 'спи':U )
     4792                   then do:
     4793                       run fill-temp-dressing-ingr in this-procedure (
     4794                             input buf_fbr-line.doc-code
     4795                           , input buf_recipe.recipe-code
     4796                       ).
     4797                   end.
     4798               end.
     4799               else do:
     4800                   assign
     4801                       v-recipe-type = ?
     4802                   .
     4803               end.
     4804   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4806     (input  buf_fbr-line.artic
     4807     ,input  buf_fbr-line.prod-type
     4808     ,input  buf_fbr-line.prod-code
     4809     ,output v-gds-code
     4810     )  .
     4811               create buf_temp_goods-qnty.
     4812               assign
     4813                   buf_temp_goods-qnty.gds-code    = v-gds-code
     4814                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     4815                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     4816                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     4817                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     4818                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     4819                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     4820                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     4821                   buf_temp_goods-qnty.calculated  = yes
     4822               .
     4823           end.
     4824       end.
     4825   end.
     4826   END PROCEDURE.
     4827   PROCEDURE calc-not-calculated-goods :
     4828   do
     4829   on error undo, return error
     4830   :
     4831   define input parameter p-mainmenu-handle        as handle           no-undo.
     4832   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     4833   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     4834   define input parameter p-same-good              as logical          no-undo.
     4835   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     4836   define input parameter p-always-select-recipe   as logical          no-undo.
     4837   define input parameter p-add-childs             as logical          no-undo.
     4838   define input parameter p-price-sale-obj-type    as character        no-undo.
     4839   define input parameter p-price-sale-obj-code    as integer          no-undo.
     4840   define input parameter p-autofbr                as logical          no-undo.
     4841   define input parameter p-have-store             as logical          no-undo.
     4842       define variable v-counter               as integer       no-undo.
     4843       define variable v-recipe-type           as character     no-undo.
     4844       define variable v-recipe-code           as character     no-undo.
     4845       define variable v-recipe-found          as logical       no-undo.
     4846       define variable v-gds-code              as integer       no-undo.
     4847       define variable v-yesno                 as logical       no-undo.
     4848       define variable v-fbr-line-recid        as recid         no-undo.
     4849       define variable v-recipe-recid-list     as character     no-undo.
     4850       define variable v-need-goods            as logical       no-undo.
     4851       define variable v-need-goods-list       as character     no-undo.
     4852       define variable v-need-goods-qnty-list  as character     no-undo.
     4853       define variable v-have-rights           as logical       no-undo.
     4854       define variable v-trn-type              as character     no-undo.
     4855       define variable v-is-comp               as logical       no-undo.
     4856       define variable v-host-code             as integer       no-undo.
     4857       define variable v-is-manual-input       as logical       no-undo.
     4858       define variable v-add-good              as logical       no-undo.
     4859       define variable v-cancel                as logical       no-undo.
     4860       define variable v-value          as character no-undo .
     4861       define variable v-type           as character no-undo .
     4862       define variable v-attr-value     as character no-undo .
     4863       define variable v-attr-value-rec as character no-undo .
     4864       define variable v-attr-type      as character no-undo .
     4865       define variable v-mark-qnty      as decimal no-undo init ? .
     4866       define buffer buf_obj_recipe            for recipe.
     4867       define buffer buf_obj_recipe-gds        for recipe-gds.
     4868       define buffer buf_fbr-recipe            for fbr-recipe.
     4869       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     4870       define buffer buf_goods                 for goods.
     4871       define buffer buf_fbr-doc               for fbr-doc.
     4872       define buffer buf_fbr-line              for fbr-line.
     4873       define buffer buf_comp_fbr-line         for fbr-line.
     4874       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4875       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     4876       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     4877       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     4878       define buffer buf_marking-lines         for ub.marking-lines .
     4879       define buffer buf_marking               for ub.marking .
     4880      define variable v-ban-recipes as logical no-undo .
     4881      define variable v-ban-altr    as logical no-undo .
     4882      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     4883      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     4884       find first buf_fbr-doc no-lock
     4885            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4886       .
     4887       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     4888       find first buf_start_temp_goods-qnty
     4889            where buf_start_temp_goods-qnty.calculated = no
     4890       no-error.
     4891       calc-not-calculated-goods:
     4892       do while available buf_start_temp_goods-qnty
     4893       :
     4894           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     4895           find first buf_goods no-lock
     4896                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     4897           .
     4898           if buf_start_temp_goods-qnty.recipe-code = ?
     4899           then do:
     4900               assign
     4901                   v-is-manual-input = yes
     4902               .
     4903           end.
     4904           else do:
     4905               assign
     4906                   v-is-manual-input = no
     4907               .
     4908           end.
     4909           if buf_start_temp_goods-qnty.recipe-code = ?
     4910           or p-always-select-recipe = yes
     4911           then do:
     4912               assign
     4913                   v-yesno     = ?
     4914                   v-add-good  = no
     4915               .
     4916               do while v-yesno = ?
     4917               and v-add-good = no
     4918               :
     4919                   run ref/rcp-all.w (
     4920                         input p-mainmenu-handle
     4921                       , input "b-add,b-sel"
     4922                       , input 'все':U
     4923                       , input recid( buf_goods )
     4924                       , input buf_fbr-doc.obj-type
     4925                       , input buf_fbr-doc.obj-code
     4926                       , output v-recipe-recid-list
     4927                   ) no-error.
     4928                   if error-status :error
     4929                   or v-recipe-recid-list = ""
     4930                   then do:
     4931                       message
     4932                           "Отменить добавление товара?"
     4933                           skip(1)
     4934                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     4935                           skip(1)
     4936                           skip "Yes - отменить добавление текущего товара"
     4937                           skip "No  - отменить добавление всех товаров списка"
     4938                           skip "Cancel - вернуться к выбору рецепта"
     4939                       view-as alert-box question
     4940                       buttons yes-no-cancel
     4941                       title "Отмена"
     4942                       update v-yesno
     4943                       .
     4944                   end.
     4945                   else do:
     4946         if v-ban-altr or v-ban-recipes then
     4947         do:
     4948            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     4949               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     4950               do:
     4951                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4952                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4953                        , input  'mark-type':U
     4954                        , output v-attr-value
     4955                        , output v-attr-type
     4956                        ) no-error .
     4957                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4958                     do:
     4959                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     4960                           view-as alert-box.
     4961                        return .
     4962                     end.
     4963                  end.
     4964               end.
     4965               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     4966               do:
     4967                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     4968                  do:
     4969                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     4970                        view-as alert-box.
     4971                     return .
     4972                  end.
     4973               end.
     4974               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     4975               do:
     4976                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4977                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4978                        , input  'mark-type':U
     4979                        , output v-attr-value
     4980                        , output v-attr-type
     4981                        ) no-error .
     4982                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4983                     do:
     4984                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     4985                           , input  'mark-type':U
     4986                           , output v-attr-value-rec
     4987                           , output v-attr-type
     4988                           ) no-error .
     4989                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     4990                        do:
     4991                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     4992                              view-as alert-box.
     4993                           return .
     4994                        end.
     4995                        else leave.
     4996                     end.
     4997                  end.
     4998               end.
     4999            end.
     5000         end.
     5001                       assign
     5002                           v-add-good = yes
     5003                       .
     5004                   end.
     5005               end.
     5006               if v-add-good = no
     5007               then do:
     5008                   if v-yesno = yes
     5009                   then do:
     5010                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5011                       :
     5012                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5013                           assign
     5014                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5015                           .
     5016                         end .
     5017                         delete tt-marking-lines .
     5018                       end .
     5019                       delete buf_start_temp_goods-qnty.
     5020                       find first buf_start_temp_goods-qnty
     5021                               where buf_start_temp_goods-qnty.calculated = no
     5022                       no-error.
     5023                       next calc-not-calculated-goods.
     5024                   end.
     5025                   else do:
     5026                       undo, return error .
     5027                   end.
     5028               end.
     5029               find first buf_obj_recipe no-lock
     5030                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
     5031               no-error.
