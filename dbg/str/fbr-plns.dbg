     7835   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7836   procedure minbtn-set :
     7837       do
     7838           on error undo, return error return-value
     7839           :
     7840           define variable ii              as integer       no-undo .
     7841           define variable fh              as widget-handle no-undo .
     7842           define variable hh              as widget-handle no-undo .
     7843           define variable v-h             as handle        extent 4 no-undo .
     7844           define variable v-name-button   as character     no-undo .
     7845           define variable v-help-old-x    as decimal       no-undo .
     7846           define variable v-help-old-y    as decimal       no-undo .
     7847           define variable v-help-old-size as decimal       no-undo .
     7848           define variable v-frame-width   as decimal       no-undo .
     7849           define variable jj              as integer       no-undo .
     7850           do
     7851               on error undo, return error
     7852               :
     7853               assign
     7854                   v-frame-width = frame Dialog-Frame:width - 0.3
     7855                   fh            = frame Dialog-Frame:first-child
     7856                   hh            = fh:first-child
     7857                   ii            = 1
     7858                   .
     7859               do while valid-handle(hh):
     7860                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7861                   do:
     7862                       case lc(hh:name) :
     7863                           when "b-help" then
     7864                               do:
     7865                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7866                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7867                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7868                                   hh:TOOLTIP = "Помощь" .
     7869                                   v-help-old-x = hh:column .
     7870                                   v-help-old-y = hh:row    .
     7871                                   v-help-old-size = hh:width .
     7872                                   hh:width-chars = 2.5 .
     7873                               end.
     7874                           when "b-print" then
     7875                               do:
     7876                                   hh:load-image("cmp/b-print.bmp":u) .
     7877                                   hh:TOOLTIP = "Печать" .
     7878                                   v-h[ii] = hh:handle .
     7879                                   ii = ii + 1 .
     7880                                   hh:width-chars = 3 .
     7881                               end.
     7882                           when "b-history" or
     7883                           when "b-hist" then
     7884                               do:
     7885                                   hh:load-image("cmp/b-hist.bmp":u) .
     7886                                   hh:TOOLTIP = "История" .
     7887                                   v-h[ii] = hh:handle .
     7888                                   ii = ii + 1 .
     7889                                   hh:width-chars = 3 .
     7890                               end.
     7891                           when "b-sch" then
     7892                               do:
     7893                                   hh:load-image("cmp/b-sch.bmp":u) .
     7894                                   hh:TOOLTIP = "Установка Фильтра" .
     7895                                   v-h[ii] = hh:handle .
     7896                                   ii = ii + 1 .
     7897                                   hh:width-chars = 3 .
     7898                               end.
     7899                           when "b-hist-user" then
     7900                               do:
     7901                                   hh:load-image("cmp/b-hist.bmp":u) .
     7902                                   hh:TOOLTIP = "История пользователя" .
     7903                                   ii = ii + 1 .
     7904                               end.
     7905                       end case.
     7906                   end.
     7907                   hh = hh:next-sibling.
     7908               end.
     7909               b-help:column = v-frame-width - b-help:width-chars.
     7910               jj = 0.
     7911               repeat ii = 4 to 1 by -1 :
     7912                   if valid-handle (v-h[ii] ) then
     7913                   do:
     7914                       jj  = jj + 1 .
     7915                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7916                       v-h[ii]:row    = v-help-old-y .
     7917                   end.
     7918               end.
     7919           end.
     7920       end.
     7921   end procedure.
     7922   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     7923   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     7924   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     7925   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     7926   define variable v-diasize-current-frame-width  as decimal   no-undo .
     7927   define variable v-diasize-current-frame-height as decimal   no-undo .
     7928   define variable v-diasize-change-size          as logical   no-undo .
     7929   define variable v-diasize-resize-button        as handle    no-undo .
     7930   define variable v-diasize-wndmax               as logical   no-undo .
     7931   define variable v-diasize-wndstore             as logical   no-undo .
     7932   define variable v-diasize-proc-name            as character no-undo .
     7933   define variable v-diasize-browse-handle        as handle    no-undo .
     7934   define variable v-diasize-browse-number        as integer   no-undo .
     7935   define variable v-diasize-need-full-display    as logical   no-undo init false .
     7936   define temp-table temp-diasize-handle no-undo
     7937     field handle-value  as handle
     7938     field save-position as decimal
     7939     index xpk is primary unique handle-value
     7940     .
     7941   define temp-table temp-browse-handle no-undo
     7942     field browse-type   as character
     7943     field browse-number as integer
     7944     field browse-handle as handle
     7945     field original-size as decimal
     7946     index xpk is primary unique browse-type browse-number
     7947     index xie browse-type browse-handle
     7948   .
     7949   procedure diasize_change-height :
     7950     define input  parameter p-change-value  as decimal   no-undo .
     7951     define input  parameter p-move-resize   as logical   no-undo .
     7952     define variable v-field-group-handle    as handle    no-undo .
     7953     define variable v-object-handle         as handle    no-undo .
     7954     define variable v-frame-height          as decimal   no-undo .
     7955     define variable v-frame-virtual-height  as decimal   no-undo .
     7956     define variable v-browse-height         as decimal   no-undo .
     7957     define variable v-window-height         as decimal   no-undo .
     7958     define variable v-window-virtual-height as decimal   no-undo .
     7959     define variable v-change-sign           as integer   no-undo .
     7960     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7961     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7962     if p-change-value > 0
     7963     then do:
     7964       if frame Dialog-Frame :height + p-change-value
     7965           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     7966       then do:
     7967         assign
     7968           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     7969                           - (frame Dialog-Frame :height-chars)
     7970         .
     7971         if p-change-value <= 0
     7972         then do:
     7973           run diasize_position-resize-button in this-procedure .
     7974           return .
     7975         end.
     7976       end.
     7977     end.
     7978     if p-change-value < 0
     7979     then do:
     7980       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     7981       then do:
     7982         assign
     7983           p-change-value = v-diasize-orig-frame-height
     7984                          - (frame Dialog-Frame :height-chars)
     7985         .
     7986         if p-change-value >= 0
     7987         then do:
     7988           run diasize_position-resize-button in this-procedure .
     7989           return .
     7990         end.
     7991       end.
     7992     end.
     7993     if p-change-value >= 0
     7994     then do:
     7995       assign
     7996         v-change-sign = 1
     7997       .
     7998     end.
     7999     else do:
     8000       assign
     8001         v-change-sign = -1
     8002       .
     8003     end.
     8004     assign
     8005       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     8006     .
     8007     if p-change-value = 0
     8008     then do:
     8009       run diasize_position-resize-button in this-procedure .
     8010       return .
     8011     end.
     8012     move_block:
     8013     do
     8014     on error undo move_block, retry move_block
     8015     :
     8016       if retry
     8017       then do:
     8018         do
     8019         on error undo move_block, leave move_block
     8020         :
     8021           if p-change-value > 0
     8022           then do:
     8023             for each buf_temp-diasize-handle
     8024             on error undo, next
     8025             :
     8026               assign
     8027                 v-object-handle = buf_temp-diasize-handle.handle-value
     8028               .
     8029               if v-object-handle <> v-diasize-resize-button
     8030               then do:
     8031                 assign
     8032                   v-object-handle :row = buf_temp-diasize-handle.save-position
     8033                 .
     8034               end.
     8035             end.
     8036             assign
     8037               v-diasize-browse-handle :height = v-browse-height
     8038             .
     8039             for each buf_temp-browse-handle
     8040               where buf_temp-browse-handle.browse-type = 'height':u
     8041             on error undo, next
     8042             :
     8043               assign
     8044                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     8045               .
     8046             end.
     8047             assign
     8048               frame Dialog-Frame :height = v-frame-height
     8049             .
     8050             if frame Dialog-Frame :scrollable = true
     8051             then do:
     8052               assign
     8053                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     8054               .
     8055             end.
     8056             run diasize_position-resize-button in this-procedure .
     8057           end.
     8058           else do:
     8059             if frame Dialog-Frame :scrollable = true
     8060             then do:
     8061               assign
     8062                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     8063               .
     8064             end.
     8065             assign
     8066               frame Dialog-Frame :height = v-frame-height
     8067             .
     8068             assign
     8069               v-diasize-browse-handle :height = v-browse-height
     8070             .
     8071             for each buf_temp-browse-handle
     8072               where buf_temp-browse-handle.browse-type = 'height':u
     8073             on error undo, next
     8074             :
     8075               assign
     8076                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     8077               .
     8078             end.
     8079             for each buf_temp-diasize-handle
     8080             on error undo, next
     8081             :
     8082               assign
     8083                 v-object-handle = buf_temp-diasize-handle.handle-value
     8084               .
     8085               if v-object-handle <> v-diasize-resize-button
     8086               then do:
     8087                 assign
     8088                   v-object-handle :row = buf_temp-diasize-handle.save-position
     8089                 .
     8090               end.
     8091             end.
     8092             run diasize_position-resize-button in this-procedure .
     8093           end.
     8094           assign
     8095             v-diasize-change-size = false
     8096           .
     8097           leave move_block .
     8098         end.
     8099       end.
     8100       assign
     8101         v-diasize-need-full-display = true
     8102       .
     8103       if v-diasize-change-size = false
     8104       then do:
     8105         assign
     8106           v-diasize-change-size = true
     8107         .
     8108       end.
     8109       else do:
     8110         return .
     8111       end.
     8112       assign
     8113         v-frame-height = frame Dialog-Frame :height
     8114         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     8115         v-browse-height = v-diasize-browse-handle :height
     8116       .
     8117       for each buf_temp-browse-handle
     8118         where buf_temp-browse-handle.browse-type = 'height':u
     8119       :
     8120         assign
     8121           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     8122         .
     8123       end.
     8124       for each buf_temp-diasize-handle
     8125       :
     8126         delete buf_temp-diasize-handle .
     8127       end.
     8128       assign
     8129         v-field-group-handle = frame Dialog-Frame :first-child
     8130       .
     8131       do while valid-handle(v-field-group-handle)
     8132       :
     8133         assign
     8134           v-object-handle = v-field-group-handle :first-child
     8135         .
     8136         do while valid-handle(v-object-handle)
     8137         :
     8138           if  v-object-handle <> v-diasize-browse-handle :handle
     8139           and can-query(v-object-handle, "row")
     8140           and can-query(v-object-handle, "height")
     8141           and ( v-object-handle :row > v-diasize-browse-handle :row )
     8142           then do:
     8143             find first buf_temp-browse-handle
     8144               where buf_temp-browse-handle.browse-type   = 'height':u
     8145                 and buf_temp-browse-handle.browse-handle = v-object-handle
     8146               no-error .
     8147             if available buf_temp-browse-handle
     8148             then do:
     8149             end.
     8150             else do:
     8151               create buf_temp-diasize-handle .
     8152               assign
     8153                 buf_temp-diasize-handle.handle-value  = v-object-handle
     8154                 buf_temp-diasize-handle.save-position = v-object-handle :row
     8155               .
     8156             end.
     8157           end.
     8158           assign
     8159             v-object-handle = v-object-handle :next-sibling
     8160           .
     8161         end.
     8162         assign
     8163           v-field-group-handle = v-field-group-handle :next-sibling
     8164         .
     8165       end.
     8166       do with frame Dialog-Frame
     8167       :
     8168         hide v-diasize-resize-button .
     8169         assign
     8170           v-diasize-resize-button :row    = 1
     8171           v-diasize-resize-button :column = 1
     8172         .
     8173       end.
     8174       if p-change-value > 0
     8175       then do:
     8176         if frame Dialog-Frame :scrollable = true
     8177         then do:
     8178           assign
     8179             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     8180             no-error .
     8181           if error-status :error
     8182           or error-status :get-message(1) <> ""
     8183           then do:
     8184             undo move_block, retry move_block .
     8185           end.
     8186         end.
     8187         assign
     8188           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     8189           no-error .
     8190         if error-status :error
     8191         or error-status :get-message(1) <> ""
     8192         then do:
     8193           undo move_block, retry move_block .
     8194         end.
     8195         assign
     8196           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     8197           no-error .
     8198         if error-status :error
     8199         or error-status :get-message(1) <> ""
     8200         then do:
     8201           undo move_block, retry move_block .
     8202         end.
     8203         for each buf_temp-browse-handle
     8204           where buf_temp-browse-handle.browse-type = 'height':u
     8205         on error undo move_block, retry move_block
     8206         :
     8207           assign
     8208             buf_temp-browse-handle.browse-handle :height
     8209               = buf_temp-browse-handle.browse-handle :height + p-change-value
     8210             no-error .
     8211           if error-status :error
     8212           or error-status :get-message(1) <> ""
     8213           then do:
     8214             undo move_block, retry move_block .
     8215           end.
     8216         end.
     8217         for each buf_temp-diasize-handle
     8218         on error undo move_block, retry move_block
     8219         :
     8220           assign
     8221             v-object-handle = buf_temp-diasize-handle.handle-value
     8222           .
     8223           if v-object-handle <> v-diasize-resize-button
     8224           then do:
     8225             assign
     8226               v-object-handle :row = v-object-handle :row + p-change-value
     8227               no-error .
     8228             if error-status :error
     8229             or error-status :get-message(1) <> ""
     8230             then do:
     8231               undo move_block, retry move_block .
     8232             end.
     8233           end.
     8234         end.
     8235       end.
     8236       else do:
     8237         for each buf_temp-diasize-handle
     8238         on error undo move_block, retry move_block
     8239         :
     8240           assign
     8241             v-object-handle = buf_temp-diasize-handle.handle-value
     8242           .
     8243           if v-object-handle <> v-diasize-resize-button
     8244           then do:
     8245             assign
     8246               v-object-handle :row = v-object-handle :row + p-change-value
     8247               no-error .
     8248             if error-status :error
     8249             or error-status :get-message(1) <> ""
     8250             then do:
     8251               undo move_block, retry move_block .
     8252             end.
     8253           end.
     8254         end.
     8255         assign
     8256           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     8257           no-error .
     8258         if error-status :error
     8259         or error-status :get-message(1) <> ""
     8260         then do:
     8261           undo move_block, retry move_block .
     8262         end.
     8263         for each buf_temp-browse-handle
     8264           where buf_temp-browse-handle.browse-type = 'height':u
     8265         on error undo move_block, retry move_block
     8266         :
     8267           assign
     8268             buf_temp-browse-handle.browse-handle :height
     8269               = buf_temp-browse-handle.browse-handle :height + p-change-value
     8270             no-error .
     8271           if error-status :error
     8272           or error-status :get-message(1) <> ""
     8273           then do:
     8274             undo move_block, retry move_block .
     8275           end.
     8276         end.
     8277         assign
     8278           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     8279           no-error .
     8280         if error-status :error
     8281         or error-status :get-message(1) <> ""
     8282         then do:
     8283           undo move_block, retry move_block .
     8284         end.
     8285         if frame Dialog-Frame :scrollable = true
     8286         then do:
     8287           assign
     8288             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     8289             no-error .
     8290           if error-status :error
     8291           or error-status :get-message(1) <> ""
     8292           then do:
     8293             undo move_block, retry move_block .
     8294           end.
     8295         end.
     8296       end.
     8297       if p-move-resize = true
     8298       then do:
     8299         run diasize_position-resize-button in this-procedure .
     8300       end.
     8301       if v-diasize-wndstore = true
     8302       then do:
     8303         if connected("ub") = true
     8304         then do:
     8305           define variable v-cntxt-db-num        as integer   no-undo .
     8306           define variable v-cntxt-userid        as character no-undo .
     8307           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8308                                             , OUTPUT v-cntxt-userid
     8309                                             ) .
     8310           run gbl/wndsizew.p
     8311             (input  v-cntxt-db-num
     8312             ,input  v-cntxt-userid
     8313             ,input  v-diasize-proc-name
     8314             ,input  'height':u
     8315             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     8316             ) .
     8317         end.
     8318       end.
     8319     end.
     8320     assign
     8321       v-diasize-change-size = false
     8322     .
     8323   end procedure.
     8324   procedure diasize_set-height :
     8325     define input  parameter p-new-height  as decimal   no-undo .
     8326     define input  parameter p-move-resize as logical   no-undo .
     8327     do
     8328     on error undo, return error return-value
     8329     :
     8330       run diasize_change-height in this-procedure
     8331         (input  (p-new-height - frame Dialog-Frame :height)
     8332         ,input  p-move-resize
     8333         ) .
     8334     end.
     8335   end procedure.
     8336   procedure diasize_change-width :
     8337     define input  parameter p-change-value as decimal   no-undo .
     8338     define input  parameter p-move-resize  as logical   no-undo .
     8339     define variable v-field-group-handle   as handle    no-undo .
     8340     define variable v-object-handle        as handle    no-undo .
     8341     define variable v-frame-width          as decimal   no-undo .
     8342     define variable v-frame-virtual-width  as decimal   no-undo .
     8343     define variable v-browse-width         as decimal   no-undo .
     8344     define variable v-window-width         as decimal   no-undo .
     8345     define variable v-window-virtual-width as decimal   no-undo .
     8346     define variable v-change-sign          as integer   no-undo .
     8347     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     8348     define buffer buf_temp-browse-handle  for temp-browse-handle .
     8349     if p-change-value > 0
     8350     then do:
     8351       if frame Dialog-Frame :width + p-change-value >
     8352           session :width-chars
     8353       then do:
     8354         assign
     8355           p-change-value = session :width-chars - frame Dialog-Frame :width
     8356         .
     8357         if p-change-value <= 0
     8358         then do:
     8359           run diasize_position-resize-button in this-procedure .
     8360           return .
     8361         end.
     8362       end.
     8363     end.
     8364     if p-change-value < 0
     8365     then do:
     8366       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     8367       then do:
     8368         assign
     8369           p-change-value = v-diasize-orig-frame-width
     8370                          - frame Dialog-Frame :width
     8371         .
     8372         if p-change-value >= 0
     8373         then do:
     8374           run diasize_position-resize-button in this-procedure .
     8375           return .
     8376         end.
     8377       end.
     8378     end.
     8379     if p-change-value >= 0
     8380     then do:
     8381       assign
     8382         v-change-sign = 1
     8383       .
     8384     end.
     8385     else do:
     8386       assign
     8387         v-change-sign = -1
     8388       .
     8389     end.
     8390     assign
     8391       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     8392     .
     8393     if p-change-value = 0
     8394     then do:
     8395       run diasize_position-resize-button in this-procedure .
     8396       return .
     8397     end.
     8398     move_block:
     8399     do
     8400     on error undo move_block, leave move_block
     8401     :
     8402       if retry
     8403       then do:
     8404         do
     8405         on error undo move_block, leave move_block
     8406         :
     8407           if p-change-value > 0
     8408           then do:
     8409             for each buf_temp-diasize-handle
     8410             on error undo, next
     8411             :
     8412               assign
     8413                 v-object-handle = buf_temp-diasize-handle.handle-value
     8414               .
     8415               if v-object-handle <> v-diasize-resize-button
     8416               then do:
     8417                 assign
     8418                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8419                 .
     8420               end.
     8421             end.
     8422             assign
     8423               v-diasize-browse-handle :width = v-browse-width
     8424             .
     8425             for each buf_temp-browse-handle
     8426               where buf_temp-browse-handle.browse-type = 'width':u
     8427             on error undo, next
     8428             :
     8429               assign
     8430                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8431               .
     8432             end.
     8433             assign
     8434               frame Dialog-Frame :width = v-frame-width
     8435             .
     8436             if frame Dialog-Frame :scrollable = true
     8437             then do:
     8438               assign
     8439                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     8440               .
     8441             end.
     8442             run diasize_position-resize-button in this-procedure .
     8443           end.
     8444           else do:
     8445             if frame Dialog-Frame :scrollable = true
     8446             then do:
     8447               assign
     8448                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     8449               .
     8450             end.
     8451             assign
     8452               frame Dialog-Frame :width = v-frame-width
     8453             .
     8454             for each buf_temp-browse-handle
     8455               where buf_temp-browse-handle.browse-type = 'width':u
     8456             on error undo, next
     8457             :
     8458               assign
     8459                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8460               .
     8461             end.
     8462             assign
     8463               v-diasize-browse-handle :width = v-browse-width
     8464             .
     8465             for each buf_temp-diasize-handle
     8466             on error undo, next
     8467             :
     8468               assign
     8469                 v-object-handle = buf_temp-diasize-handle.handle-value
     8470               .
     8471               if v-object-handle <> v-diasize-resize-button
     8472               then do:
     8473                 assign
     8474                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8475                 .
     8476               end.
     8477             end.
     8478             run diasize_position-resize-button in this-procedure .
     8479           end.
     8480           assign
     8481             v-diasize-change-size = false
     8482           .
     8483           leave move_block .
     8484         end.
     8485       end.
     8486       assign
     8487         v-diasize-need-full-display = true
     8488       .
     8489       if v-diasize-change-size = false
     8490       then do:
     8491         assign
     8492           v-diasize-change-size = true
     8493         .
     8494       end.
     8495       else do:
     8496         return .
     8497       end.
     8498       assign
     8499         v-frame-width = frame Dialog-Frame :width
     8500         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     8501         v-browse-width = v-diasize-browse-handle :width
     8502       .
     8503       for each buf_temp-browse-handle
     8504         where buf_temp-browse-handle.browse-type = 'width':u
     8505       :
     8506         assign
     8507           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     8508         .
     8509       end.
     8510       for each buf_temp-diasize-handle
     8511       :
     8512         delete buf_temp-diasize-handle .
     8513       end.
     8514       assign
     8515         v-field-group-handle = frame Dialog-Frame :first-child
     8516       .
     8517       do while valid-handle(v-field-group-handle)
     8518       :
     8519         assign
     8520           v-object-handle = v-field-group-handle :first-child
     8521         .
     8522         do while valid-handle(v-object-handle)
     8523         :
     8524           if  v-object-handle <> v-diasize-browse-handle :handle
     8525           and v-object-handle <> v-diasize-resize-button
     8526           and can-query(v-object-handle, "row")
     8527           and can-query(v-object-handle, "height")
     8528           and ( v-object-handle :col + v-object-handle :width
     8529                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     8530               )
     8531           then do:
     8532             find first buf_temp-browse-handle
     8533               where buf_temp-browse-handle.browse-type   = 'width':u
     8534                 and buf_temp-browse-handle.browse-handle = v-object-handle
     8535               no-error .
     8536             if available buf_temp-browse-handle
     8537             then do:
     8538             end.
     8539             else do:
     8540               create buf_temp-diasize-handle .
     8541               assign
     8542                 buf_temp-diasize-handle.handle-value  = v-object-handle
     8543                 buf_temp-diasize-handle.save-position = v-object-handle :col
     8544               .
     8545             end.
     8546           end.
     8547           assign
     8548             v-object-handle = v-object-handle :next-sibling
     8549           .
     8550         end.
     8551         assign
     8552           v-field-group-handle = v-field-group-handle :next-sibling
     8553         .
     8554       end.
     8555       do with frame Dialog-Frame
     8556       :
     8557         hide v-diasize-resize-button .
     8558         v-diasize-resize-button :row = 1.
     8559         v-diasize-resize-button :column = 1.
     8560       end.
     8561       if p-change-value > 0
     8562       then do:
     8563         if frame Dialog-Frame :scrollable = true
     8564         then do:
     8565           assign
     8566             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     8567             no-error .
     8568           if error-status :error
     8569           or error-status :get-message(1) <> ""
     8570           then do:
     8571             undo move_block, retry move_block.
     8572           end.
     8573         end.
     8574         assign
     8575           frame Dialog-Frame :width = v-frame-width + p-change-value
     8576           no-error .
     8577         if error-status :error
     8578         or error-status :get-message(1) <> ""
     8579         then do:
     8580           undo move_block, retry move_block.
     8581         end.
     8582         assign
     8583           v-diasize-browse-handle :width = v-browse-width + p-change-value
     8584         no-error .
     8585         if error-status :error
     8586         or error-status :get-message(1) <> ""
     8587         then do:
     8588           undo move_block, retry move_block.
     8589         end.
     8590         for each buf_temp-browse-handle
     8591           where buf_temp-browse-handle.browse-type = 'width':u
     8592         on error undo move_block, retry move_block
     8593         :
     8594           assign
     8595             buf_temp-browse-handle.browse-handle :width
     8596               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8597             no-error .
     8598           if error-status :error
     8599           or error-status :get-message(1) <> ""
     8600           then do:
     8601             undo move_block, retry move_block .
     8602           end.
     8603         end.
     8604         for each buf_temp-diasize-handle
     8605         on error undo move_block, retry move_block
     8606         :
     8607           assign
     8608             v-object-handle = buf_temp-diasize-handle.handle-value
     8609           .
     8610           if v-object-handle <> v-diasize-resize-button
     8611           then do:
     8612             assign
     8613               v-object-handle :col = v-object-handle :col + p-change-value
     8614               no-error .
     8615             if error-status :error
     8616             or error-status :get-message(1) <> ""
     8617             then do:
     8618               undo move_block, retry move_block .
     8619             end.
     8620           end.
     8621         end.
     8622       end.
     8623       else do:
     8624         for each buf_temp-diasize-handle
     8625         on error undo move_block, retry move_block
     8626         :
     8627           assign
     8628             v-object-handle = buf_temp-diasize-handle.handle-value
     8629           .
     8630           if v-object-handle <> v-diasize-resize-button
     8631           then do:
     8632             assign
     8633               v-object-handle :col = v-object-handle :col + p-change-value
     8634               no-error .
     8635             if error-status :error
     8636             or error-status :get-message(1) <> ""
     8637             then do:
     8638               undo move_block, retry move_block .
     8639             end.
     8640           end.
     8641         end.
     8642         for each buf_temp-browse-handle
     8643           where buf_temp-browse-handle.browse-type = 'width':u
     8644         on error undo move_block, retry move_block
     8645         :
     8646           assign
     8647             buf_temp-browse-handle.browse-handle :width
     8648               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8649             no-error .
     8650           if error-status :error
     8651           or error-status :get-message(1) <> ""
     8652           then do:
     8653             undo move_block, retry move_block .
     8654           end.
     8655         end.
     8656         assign
     8657           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     8658           no-error .
     8659         if error-status :error
     8660         or error-status :get-message(1) <> ""
     8661         then do:
     8662           undo move_block, retry move_block.
     8663         end.
     8664         assign
     8665           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     8666         no-error .
     8667         if error-status :error
     8668         or error-status :get-message(1) <> ""
     8669         then do:
     8670           undo move_block, retry move_block.
     8671         end.
     8672         if frame Dialog-Frame :scrollable = true
     8673         then do:
     8674           assign
     8675             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     8676           no-error .
     8677           if error-status :error
     8678           or error-status :get-message(1) <> ""
     8679           then do:
     8680             undo move_block, retry move_block.
     8681           end.
     8682         end.
     8683       end.
     8684       if p-move-resize
     8685       then do:
     8686         run diasize_position-resize-button in this-procedure .
     8687       end.
     8688       if v-diasize-wndstore = true
     8689       then do:
     8690         if connected("ub") = true
     8691         then do:
     8692           define variable v-cntxt-db-num        as integer   no-undo .
     8693           define variable v-cntxt-userid        as character no-undo .
     8694           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8695                                             , OUTPUT v-cntxt-userid
     8696                                             ) .
     8697           run gbl/wndsizew.p
     8698             (input  v-cntxt-db-num
     8699             ,input  v-cntxt-userid
     8700             ,input  v-diasize-proc-name
     8701             ,input  'width':u
     8702             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     8703             ) .
     8704         end.
     8705       end.
     8706     end.
     8707     assign
     8708       v-diasize-change-size = false
     8709     .
     8710   end procedure.
     8711   procedure diasize_set-width :
     8712     define input  parameter p-new-width  as decimal   no-undo .
     8713     define input  parameter p-move-resize as logical   no-undo .
     8714     do
     8715     on error undo, return error return-value
     8716     :
     8717       run diasize_change-width in this-procedure
     8718         (input  (p-new-width - frame Dialog-Frame :width)
     8719         ,input  p-move-resize
     8720         ) .
     8721     end.
     8722   end procedure.
     8723   procedure diasize_position-resize-button :
     8724     do with frame Dialog-Frame
     8725     :
     8726       hide v-diasize-resize-button .
     8727       assign
     8728         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     8729                     - 1
     8730                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     8731         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     8732                     - 1
     8733                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     8734       .
     8735       view v-diasize-resize-button .
     8736     end.
     8737   end procedure.
     8738   on alt-right anywhere
     8739   do:
     8740     run diasize_change-width in this-procedure
     8741       (input 1
     8742       ,input true
     8743       ) .
     8744     return no-apply .
     8745   end.
     8746   on alt-left anywhere
     8747   do:
     8748     run diasize_change-width in this-procedure
     8749       (input -1
     8750       ,input true
     8751       ) .
     8752     return no-apply .
     8753   end.
     8754   on alt-down anywhere
     8755   do:
     8756     run diasize_change-height in this-procedure
     8757       (input 1
     8758       ,input true
     8759       ) .
     8760     return no-apply .
     8761   end.
     8762   on alt-up anywhere
     8763   do:
     8764     run diasize_change-height in this-procedure
     8765       (input -1
     8766       ,input true
     8767       ) .
     8768     return no-apply .
     8769   end.
     8770   on alt-enter of frame Dialog-Frame
     8771   do:
     8772     run diasize_maximize in this-procedure
     8773       (input  ?
     8774       ).
     8775     return no-apply .
     8776   end.
     8777   procedure diasize_end-move :
     8778     do
     8779     on error undo, return error return-value
     8780     :
     8781       define variable v-row-delta as decimal   no-undo .
     8782       define variable v-col-delta as decimal   no-undo .
     8783       define variable v-new-row as decimal   no-undo .
     8784       define variable v-new-col as decimal   no-undo .
     8785       assign
     8786         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     8787         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     8788       .
     8789       assign
     8790         v-row-delta = v-new-row - frame Dialog-Frame :height
     8791         v-col-delta = v-new-col - frame Dialog-Frame :width
     8792       .
     8793       run diasize_change-height in this-procedure
     8794         (input v-row-delta
     8795         ,input true
     8796         ) .
     8797       run diasize_change-width in this-procedure
     8798         (input v-col-delta
     8799         ,input true
     8800         ) .
     8801     end.
     8802   end procedure.
     8803   procedure diasize_maximize :
     8804     define input  parameter p-action as logical   no-undo .
     8805     do
     8806     on error undo, return error return-value
     8807     :
     8808       if p-action = ?
     8809       then do:
     8810         if v-diasize-need-maximize = true
     8811         then do:
     8812           assign
     8813             p-action = true
     8814           .
     8815         end.
     8816         else do:
     8817           assign
     8818             p-action = false
     8819           .
     8820         end.
     8821       end.
     8822       if p-action = true
     8823       then do:
     8824         run diasize_change-height in this-procedure
     8825           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     8826               - frame Dialog-Frame :height-chars
     8827           ,input true
     8828           ) .
     8829         run diasize_change-width in this-procedure
     8830           (input session :width-chars
     8831               - frame Dialog-Frame :width-chars
     8832           ,input true
     8833           ) .
     8834         assign
     8835           v-diasize-need-maximize = false
     8836         .
     8837       end.
     8838       else do:
     8839         run diasize_change-width in this-procedure
     8840           (input v-diasize-orig-frame-width
     8841               - frame Dialog-Frame :width-chars
     8842           ,input true
     8843           ) .
     8844         run diasize_change-height in this-procedure
     8845           (input v-diasize-orig-frame-height
     8846               - frame Dialog-Frame :height-chars
     8847           ,input true
     8848           ) .
     8849         assign
     8850           v-diasize-need-maximize = true
     8851         .
     8852       end.
     8853     end.
     8854   end procedure.
     8855   procedure diasize_restore-orig-size :
     8856     do
     8857     on error undo, return error return-value
     8858     :
     8859       assign
     8860         v-diasize-current-frame-width  = frame Dialog-Frame :width
     8861         v-diasize-current-frame-height = frame Dialog-Frame :height
     8862       .
     8863       run diasize_set-height in this-procedure
     8864         (input  v-diasize-orig-frame-height
     8865         ,input  true
     8866         ) .
     8867       run diasize_set-width in this-procedure
     8868         (input  v-diasize-orig-frame-width
     8869         ,input  true
     8870         ) .
     8871     end.
     8872   end procedure.
     8873   procedure diasize_restore-current-size :
     8874     do
     8875     on error undo, return error return-value
     8876     :
     8877       run diasize_set-height in this-procedure
     8878         (input  v-diasize-current-frame-height
     8879         ,input  true
     8880         ) .
     8881       run diasize_set-width in this-procedure
     8882         (input  v-diasize-current-frame-width
     8883         ,input  true
     8884         ) .
     8885     end.
     8886   end procedure.
     8887   procedure diasize_set-browse-handle :
     8888     define input  parameter p-browse-handle as handle   no-undo .
     8889     define buffer buf_temp-browse-handle for temp-browse-handle .
     8890     do
     8891     on error undo, return error return-value
     8892     :
     8893       assign
     8894         v-diasize-browse-handle = p-browse-handle
     8895       .
     8896       for each buf_temp-browse-handle
     8897       on error undo, return error return-value
     8898       :
     8899         delete buf_temp-browse-handle .
     8900       end.
     8901     end.
     8902   end procedure.
     8903   procedure diasize_add_browse :
     8904     define input  parameter p-browse-type   as character no-undo .
     8905     define input  parameter p-browse-handle as handle    no-undo .
     8906     define buffer buf_temp-browse-handle for temp-browse-handle .
     8907     do
     8908     on error undo, return error return-value
     8909     :
     8910       assign
     8911         v-diasize-browse-number = v-diasize-browse-number + 1
     8912       .
     8913       create buf_temp-browse-handle .
     8914       assign
     8915         buf_temp-browse-handle.browse-type   = p-browse-type
     8916         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     8917         buf_temp-browse-handle.browse-handle = p-browse-handle
     8918       .
     8919     end.
     8920   end procedure.
     8921   procedure diasize_init :
     8922     define variable v-default-value    as logical   no-undo .
     8923     define variable v-restore-saved    as logical   no-undo .
     8924     define variable v-resize-value-str as character no-undo .
     8925     do
     8926     on error undo, return error return-value
     8927     :
     8928       do with frame Dialog-Frame
     8929       :
     8930         assign
     8931           v-diasize-orig-frame-height = frame Dialog-Frame :height
     8932           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     8933           v-diasize-browse-handle     = browse br-table :handle
     8934         .
     8935         create button v-diasize-resize-button
     8936         assign
     8937           parent        = frame Dialog-Frame :first-child
     8938           label         = "s"
     8939           height-pixels = 16
     8940           width-pixels  = 16
     8941           visible       = true
     8942           sensitive     = true
     8943           movable       = true
     8944           triggers:
     8945             on end-move persistent run diasize_end-move in this-procedure .
     8946           end triggers.
     8947         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     8948         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     8949         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     8950         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     8951         assign
     8952           v-diasize-wndmax = false
     8953         .
     8954         if connected("ub") = true
     8955         then do:
     8956           define variable v-cntxt-db-num        as integer   no-undo .
     8957           define variable v-cntxt-userid        as character no-undo .
     8958           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8959                                             , OUTPUT v-cntxt-userid
     8960                                             ) .
     8961           run gbl/wndpar_r.p
     8962             (input  v-cntxt-db-num
     8963             ,input  v-cntxt-userid
     8964             ,input  'wndmax':U
     8965             ,output v-diasize-wndmax
     8966             ,output v-default-value
     8967             ) .
     8968         end.
     8969         assign
     8970           v-diasize-wndstore = false
     8971         .
     8972         if connected("ub") = true
     8973         then do:
     8974           run gbl/wndpar_r.p
     8975             (input  v-cntxt-db-num
     8976             ,input  v-cntxt-userid
     8977             ,input  'wndstore':U
     8978             ,output v-diasize-wndstore
     8979             ,output v-default-value
     8980             ) .
     8981         end.
     8982         assign
     8983           v-diasize-proc-name = entry(1, program-name(2), '.')
     8984         .
     8985         if v-diasize-wndstore = true
     8986         then do:
     8987           assign
     8988             v-restore-saved = false
     8989           .
     8990           if connected("ub") = true
     8991           then do:
     8992             run gbl/wndsizer.p
     8993               (input  v-cntxt-db-num
     8994               ,input  v-cntxt-userid
     8995               ,input  v-diasize-proc-name
     8996               ,input  'height':u
     8997               ,output v-resize-value-str
     8998               ) .
     8999             if v-resize-value-str <> '':U
     9000             then do:
     9001               run diasize_change-height in this-procedure
     9002                 (input  integer(v-resize-value-str)
     9003                 ,input  true
     9004                 ) .
     9005               assign
     9006                 v-restore-saved = true
     9007               .
     9008             end.
     9009           end.
     9010           if connected("ub") = true
     9011           then do:
     9012             run gbl/wndsizer.p
     9013               (input  v-cntxt-db-num
     9014               ,input  v-cntxt-userid
     9015               ,input  v-diasize-proc-name
     9016               ,input  'width':u
     9017               ,output v-resize-value-str
     9018               ) .
     9019             if v-resize-value-str <> '':U
     9020             then do:
     9021               run diasize_change-width in this-procedure
     9022                 (input  integer(v-resize-value-str)
     9023                 ,input  true
     9024                 ) .
     9025               assign
     9026                 v-restore-saved = true
     9027               .
     9028             end.
     9029           end.
     9030           if v-restore-saved <> true
     9031           then do:
     9032             if v-diasize-wndmax = true
     9033             then do:
     9034               run diasize_maximize in this-procedure
     9035                 (input  true
     9036                 ) .
     9037             end.
     9038           end.
     9039         end.
     9040         else do:
     9041           if v-diasize-wndmax = true
     9042           then do:
     9043             run diasize_maximize in this-procedure
     9044               (input  true
     9045               ) .
     9046           end.
     9047         end.
     9048       end.
     9049     end.
     9050   end procedure.
     9051   procedure diasize_need-full-display :
     9052     define output parameter p-need-full-display as logical   no-undo .
     9053     do
     9054     on error undo, return error return-value
     9055     :
     9056       assign
     9057         p-need-full-display = v-diasize-need-full-display
     9058       .
     9059       assign
     9060         v-diasize-need-full-display = false
     9061       .
     9062     end.
     9063   end procedure.
     9064   procedure get-context :
     9065      define output parameter p-db-num as integer          no-undo.
     9066      define output parameter p-user-id as character        no-undo.
     9067      define variable v-login               as character    no-undo.
     9068      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     9069      define buffer buf_user-login  for ub.user-login .
     9070      do
     9071      on error undo, return error
     9072      :
     9073            FIND FIRST buf_sys-ctrl no-lock.
     9074            ASSIGN
     9075               v-login = USERID("ub")
     9076               p-db-num = buf_sys-ctrl.db-num
     9077            .
     9078            FIND FIRST buf_user-login
     9079                 WHERE buf_user-login.db-num = p-db-num
     9080                   AND buf_user-login.user-login = v-login
     9081                 no-lock
     9082                 no-error
     9083                 .
     9084            IF AVAILABLE buf_user-login
     9085            THEN DO:
     9086               assign
     9087                  p-user-id = buf_user-login.user-id
     9088               .
     9089            END.
     9090      end.
     9091   end procedure.
     9092       run diasize_init in this-procedure .
     9093   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     9094   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     9095   MAIN-BLOCK:
     9096   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     9097      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     9098       run fbrhist-read-conf in this-procedure .
     9099   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9100     run mainmenu_getcntxt in parparentproc
     9101       (output v-cntxt-db-num
     9102       ,output v-cntxt-userid
     9103       ,output v-cntxt-level
     9104       ,output v-cntxt-host-code-obj
     9105       ,output v-cntxt-obj-type
     9106       ,output v-cntxt-obj-code
     9107       ,output v-cntxt-db-num-obj
     9108       ,output v-cntxt-is-admin
     9109       ) .
     9110       run init-fields in this-procedure.
     9111       RUN enable_UI.
     9112       run ui-disable-all in this-procedure.
     9113       run ui-enable in this-procedure.
     9114       apply "entry" to br-table.
     9115     WAIT-FOR GO OF FRAME Dialog-Frame.
     9116   END.
     9117   RUN disable_UI.
     9118   PROCEDURE add-doc :
     9119   do
     9120   on error undo, return error
     9121   :
     9122       run str/fbr-pln.w (
     9123             input parparentproc
     9124           , input this-procedure
     9125           , input 'ДОБАВЛЕНИЕ':U
     9126           , input ""
     9127           , input p-store-type
     9128           , input p-store-code
     9129           , input p-userid
     9130       ).
     9131   end.
     9132   END PROCEDURE.
     9133   PROCEDURE change-doc :
     9134   do
     9135   on error undo, return error
     9136   :
     9137   define input parameter p-doc-code   as character    no-undo.
     9138       define variable v-focused-row       as integer  no-undo.
     9139       define variable v-repositioned-row  as integer  no-undo.
     9140       assign
     9141           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     9142           v-repositioned-row = current-result-row( "br-table" )
     9143       .
     9144       run str/fbr-pln.w (
     9145             input parparentproc
     9146           , input this-procedure
     9147           , input 'ИЗМЕНЕНИЕ':U
     9148           , input p-doc-code
     9149           , input p-store-type
     9150           , input p-store-code
     9151           , input p-userid
     9152       ).
     9153       run local-open-query in this-procedure .
     9154       br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9155       reposition br-table to row v-repositioned-row.
     9156   end.
     9157   END PROCEDURE.
     9158   PROCEDURE close-to-fact :
     9159   define input parameter p-doc-code    as character    no-undo.
     9160   do
     9161   on error undo, return error
     9162   :
     9163       define variable v-focused-row       as integer  no-undo.
     9164       define variable v-repositioned-row  as integer  no-undo.
     9165       assign
     9166           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     9167           v-repositioned-row = current-result-row( "br-table" )
     9168       .
     9169       run str/diallog.w (
     9170             input parparentproc
     9171           , input this-procedure
     9172           , input "str/fbrplnft.p":U
     9173           , input p-doc-code
     9174           , input no
     9175           , input "":U
     9176           , input substitute( "Закрытие план-меню до статуса факт. Номер документа план-меню: &1", p-doc-code )
     9177       ) .
     9178       run local-open-query in this-procedure .
     9179       br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9180       reposition br-table to row v-repositioned-row.
     9181   end.
     9182   END PROCEDURE.
     9183   PROCEDURE close-to-permitted :
     9184   define input parameter p-doc-code    as character    no-undo.
     9185       define variable v-focused-row       as integer      no-undo.
     9186       define variable v-repositioned-row  as integer      no-undo.
     9187       define variable v-yesno             as logical      no-undo.
     9188       define variable v-hst-upper-code    as integer      no-undo.
     9189       define buffer buf_fbr-pln-line  for fbr-pln-line.
     9190       define buffer buf_goods         for goods.
     9191       define buffer buf_fbr-pln       for fbr-pln.
     9192   do
     9193   for buf_fbr-pln-line
     9194     , buf_goods
     9195     , buf_fbr-pln
     9196   on error undo, return error
     9197   :
     9198       assign
     9199           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     9200           v-repositioned-row = current-result-row( "br-table" )
     9201       .
     9202       do transaction
     9203       on error undo, return error
     9204       :
     9205           check-zero-qnty:
     9206           for each buf_fbr-pln-line exclusive-lock
     9207              where buf_fbr-pln-line.doc-code = p-doc-code
     9208           on error undo, return error
     9209           :
     9210               if buf_fbr-pln-line.fact-qnty = 0
     9211               then do:
     9212                   find first buf_goods no-lock
     9213                        where buf_goods.gds-code = buf_fbr-pln-line.gds-code
     9214                   .
     9215                   assign
     9216                       v-yesno = yes
     9217                   .
     9218                   message
     9219                       "Строка документа содержит товар с нулевым количеством."
     9220                       skip (1)
     9221                       skip "Товар:" buf_fbr-pln-line.artic buf_goods.gds-name
     9222                       skip (1)
     9223                       skip "Вы можете удалить строку товара и продолжить закрытие документа"
     9224                       skip "Или прервать процесс закрытия для редактирования документа."
     9225                       skip (1)
     9226                       skip "OK - удалить строку и продолжить"
     9227                       skip "Cancel  - прервать процедуру закрытия"
     9228                       skip (1)
     9229                       skip "Удалить строку с нулевым количеством?"
     9230                   view-as alert-box warning
     9231                   buttons ok-cancel
     9232                   title "Строка с нулевым количеством"
     9233                   update v-yesno.
     9234                   if v-yesno = yes
     9235                   then do:
     9236                       define variable v-gds-code    as integer      no-undo.
     9237                       assign
     9238                           v-gds-code = buf_fbr-pln-line.gds-code
     9239                       .
     9240                       delete buf_fbr-pln-line.
     9241                       run fbrhist-write in this-procedure (
     9242                             input v-cntxt-userid
     9243                           , input p-store-type
     9244                           , input p-store-code
     9245                           , input 'зак_док':U + ",":U + 'выбор':U + ",":U + 'удл_стр':U
     9246                           , input 2
     9247                           , input "close-to-permitted"
     9248                           , input "doc-code:" + p-doc-code
     9249                           , input p-doc-code
     9250                           , input 'план-меню':U
     9251                           , input 'новый':U
     9252                           , input no
     9253                           , input ""
     9254                           , input ""
     9255                           , input v-gds-code
     9256                           , input ""
     9257                           , input 0
     9258                           , input "Удаление строки с нулевым количеством"
     9259                           , input no
     9260                       ).
     9261                       next check-zero-qnty.
     9262                   end.
     9263                   else do:
     9264                       undo, return error.
     9265                   end.
     9266               end.
     9267           end.
     9268       end.
     9269       find first buf_fbr-pln-line no-lock
     9270            where buf_fbr-pln-line.doc-code = p-doc-code
     9271       no-error.
     9272       if not available buf_fbr-pln-line
     9273       then do:
     9274           message
     9275               "В документе нет строк."
     9276               skip "Пустой документ будет удален."
     9277               skip(1)
     9278               skip "Номер документа:" p-doc-code
     9279           view-as alert-box information.
     9280           do transaction
     9281           on error undo, return error
     9282           :
     9283               find first buf_fbr-pln exclusive-lock
     9284                    where buf_fbr-pln.doc-code = p-doc-code
     9285               .
     9286               delete buf_fbr-pln.
     9287               run fbrhist-write in this-procedure (
     9288                     input v-cntxt-userid
     9289                   , input p-store-type
     9290                   , input p-store-code
     9291                   , input 'зак_док':U + ",":U + 'удл_док':U
     9292                   , input 1
     9293                   , input "close-to-permitted"
     9294                   , input "doc-code:" + p-doc-code
     9295                   , input p-doc-code
     9296                   , input 'план-меню':U
     9297                   , input 'новый':U
     9298                   , input no
     9299                   , input ""
     9300                   , input ""
     9301                   , input 0
     9302                   , input ""
     9303                   , input 0
     9304                   , input "Удаление пустого документа"
     9305                   , input no
     9306               ).
     9307           end.
     9308       end.
     9309       else do:
     9310           run str/diallog.w (
     9311                 input parparentproc
     9312               , input this-procedure
     9313               , input "str/fbrplnpm.p":U
     9314               , input p-doc-code
     9315               , input no
     9316               , input "":U
     9317               , input substitute( "Закрытие план-меню до статуса разрешен. Номер документа план-меню: &1", p-doc-code )
     9318           ) no-error.
     9319           if error-status:error
     9320           then do:
     9321               message
     9322                       vss-workfile vss-revision vss-description
     9323                   skip "Ошибка при закрытии документа план-меню до статуса разрешен."
     9324                   skip return-value
     9325                   skip trim(error-status :get-message(1))
     9326                       trim(error-status :get-message(2))
     9327                       trim(error-status :get-message(3))
     9328               view-as alert-box error.
     9329               run fbrhist-write in this-procedure (
     9330                     input v-cntxt-userid
     9331                   , input p-store-type
     9332                   , input p-store-code
     9333                   , input 'зак_док':U + ",":U + 'удл_док':U
     9334                   , input 1
     9335                   , input "close-to-permitted"
     9336                   , input "doc-code:" + p-doc-code
     9337                   , input p-doc-code
     9338                   , input 'план-меню':U
     9339                   , input 'новый':U
     9340                   , input no
     9341                   , input ""
     9342                   , input ""
     9343                   , input 0
     9344                   , input ""
     9345                   , input 0
     9346                   , input "Удаление пустого документа"
     9347                   , input no
     9348               ).
     9349               undo, return error .
     9350           end.
     9351       end.
     9352       run local-open-query in this-procedure .
     9353       br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9354       reposition br-table to row v-repositioned-row.
     9355   end.
     9356   END PROCEDURE.
     9357   PROCEDURE delete-doc :
     9358   do
     9359   on error undo, return error
     9360   :
     9361   define input parameter p-doc-code as character    no-undo.
     9362       define variable v-yesno    as logical        no-undo.
     9363       define variable v-focused-row       as integer  no-undo.
     9364       define variable v-repositioned-row  as integer  no-undo.
     9365       define buffer buf_fbr-pln       for fbr-pln.
     9366       define buffer buf_fbr-pln-line  for fbr-pln-line.
     9367       assign
     9368           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     9369           v-repositioned-row = current-result-row( "br-table" )
     9370       .
     9371       find first buf_fbr-pln exclusive-lock
     9372            where buf_fbr-pln.doc-code = p-doc-code
     9373       no-error.
     9374       if available buf_fbr-pln
     9375       then do:
     9376           assign
     9377               v-yesno = no
     9378           .
     9379           message
     9380                    "Удаление документа."
     9381               skip (1)
     9382               skip "Номер документа:" p-doc-code
     9383               skip "Дата документа:" buf_fbr-pln.doc-date
     9384               skip "Удалить документ?"
     9385           view-as alert-box information
     9386           buttons yes-no
     9387           title "Удаление документа"
     9388           update v-yesno.
     9389           if v-yesno = yes
     9390           then do:
     9391               for each buf_fbr-pln-line exclusive-lock
     9392                  where buf_fbr-pln-line.doc-code = buf_fbr-pln.doc-code
     9393               on error undo, return error
     9394               :
     9395                   delete buf_fbr-pln-line.
     9396               end.
     9397               delete buf_fbr-pln.
     9398           end.
     9399       end.
     9400       run local-open-query in this-procedure .
     9401       br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9402       reposition br-table to row v-repositioned-row.
     9403   end.
     9404   END PROCEDURE.
     9405   PROCEDURE disable_UI :
     9406     HIDE FRAME Dialog-Frame.
     9407   END PROCEDURE.
     9408   PROCEDURE enable_UI :
     9409     DISPLAY EDITOR-1
     9410         WITH FRAME Dialog-Frame.
     9411     ENABLE b-exit b-help b-add b-lkp b-chg b-del b-close b-open b-history b-print
     9412            br-table EDITOR-1
     9413         WITH FRAME Dialog-Frame.
     9414     VIEW FRAME Dialog-Frame.
     9415     run local-open-query in this-procedure .
     9416   END PROCEDURE.
     9417   PROCEDURE init-fields :
     9418   do
     9419   on error undo, return error
     9420   :
     9421   end.
     9422   END PROCEDURE.
     9423   PROCEDURE local-open-query :
     9424       if p-status = '':U
     9425       then do:
     9426           open query br-table
     9427           for each buf_init_fbr-pln no-lock
     9428              where buf_init_fbr-pln.obj-type = p-store-type
     9429                and buf_init_fbr-pln.obj-code = p-store-code
     9430           by buf_init_fbr-pln.doc-date descending
     9431           .
     9432       end.
     9433       else do:
     9434           open query br-table
     9435           for each buf_init_fbr-pln no-lock
     9436              where buf_init_fbr-pln.obj-type = p-store-type
     9437                and buf_init_fbr-pln.obj-code = p-store-code
     9438                and buf_init_fbr-pln.status_  = p-status
     9439           by buf_init_fbr-pln.doc-date descending
     9440           .
     9441       end.
     9442    END PROCEDURE.
     9443   PROCEDURE open-doc :
     9444   define input parameter p-doc-code as character    no-undo.
     9445   do
     9446   on error undo, return error
     9447   :
     9448       define variable v-focused-row       as integer  no-undo.
     9449       define variable v-repositioned-row  as integer  no-undo.
     9450       assign
     9451           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     9452           v-repositioned-row = current-result-row( "br-table" )
     9453       .
     9454       run str/fbrplnop.p (
     9455           input p-doc-code
     9456       ).
     9457       run local-open-query in this-procedure .
     9458       br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9459       reposition br-table to row v-repositioned-row.
     9460   end.
     9461   END PROCEDURE.
     9462   PROCEDURE print-doc :
     9463   define input parameter p-fbr-pln-recid   as recid    no-undo.
     9464   do
     9465   on error undo, return error
     9466   :
     9467         run rep/fplndprn.w (
     9468             input parparentproc
     9469           , input p-fbr-pln-recid
     9470       ).
     9471   end.
     9472   END PROCEDURE.
     9473   PROCEDURE reposition-query :
     9474   define input parameter p-direction  as character    no-undo.
     9475   define output parameter p-doc-code  as character    no-undo.
     9476       define buffer buf_fbr-pln       for fbr-pln.
     9477   do
     9478   for buf_fbr-pln
     9479   on error undo, return error
     9480   :
     9481       case p-direction
     9482       :
     9483           when 'prev':U
     9484           then do:
     9485               get prev br-table.
     9486               if available buf_init_fbr-pln
     9487               then do:
     9488                   assign
     9489                       p-doc-code = buf_init_fbr-pln.doc-code
     9490                   .
     9491               end.
     9492               else do:
     9493                   assign
     9494                       p-doc-code = 'first':U
     9495                   .
     9496               end.
     9497           end.
     9498           when 'next':U
     9499           then do:
     9500               get next br-table.
     9501               if available buf_init_fbr-pln
     9502               then do:
     9503                   assign
     9504                       p-doc-code = buf_init_fbr-pln.doc-code
     9505                   .
     9506               end.
     9507               else do:
     9508                   assign
     9509                       p-doc-code = 'last':U
     9510                   .
     9511               end.
     9512           end.
     9513           when 'first':U
     9514           then do:
     9515               get first br-table.
     9516               if available buf_init_fbr-pln
     9517               then do:
     9518                   assign
     9519                       p-doc-code = buf_init_fbr-pln.doc-code
     9520                   .
     9521               end.
     9522               else do:
     9523                   assign
     9524                       p-doc-code = ""
     9525                   .
     9526               end.
     9527           end.
     9528           when 'last':U
     9529           then do:
     9530               get last br-table.
     9531               if available buf_init_fbr-pln
     9532               then do:
     9533                   assign
     9534                       p-doc-code = buf_init_fbr-pln.doc-code
     9535                   .
     9536               end.
     9537               else do:
     9538                   assign
     9539                       p-doc-code = ""
     9540                   .
     9541               end.
     9542           end.
     9543           otherwise do:
     9544               assign
     9545                   p-doc-code = p-direction
     9546               .
     9547           end.
     9548       end case.
     9549       if p-doc-code  <> ""
     9550       and p-doc-code <> 'first':U
     9551       and p-doc-code <> 'last':U
     9552       then do:
     9553           find first buf_fbr-pln no-lock
     9554                where buf_fbr-pln.doc-code = p-doc-code
     9555           no-error.
     9556           if available buf_fbr-pln
     9557           then do:
     9558               reposition br-table to recid recid( buf_fbr-pln ) no-error .
     9559           end.
     9560           else do:
     9561               assign
     9562                   p-doc-code = ""
     9563               .
     9564           end.
     9565       end.
     9566   end.
     9567   END PROCEDURE.
     9568   PROCEDURE reposition-to-recid :
     9569   define input parameter p-fbr-pln-recid  as recid        no-undo.
     9570   do
     9571   on error undo, return error
     9572   :
     9573       if p-fbr-pln-recid <> ?
     9574       then do:
     9575           reposition br-table to recid p-fbr-pln-recid no-error .
     9576       end.
     9577       do with frame Dialog-Frame
     9578       :
     9579           apply "entry":u to browse br-table .
     9580       end.
     9581   end.
     9582   END PROCEDURE.
     9583   PROCEDURE ui-disable-all :
     9584   do
     9585   on error undo, return error
     9586   :
     9587       disable
     9588           b-add
     9589           b-del
     9590           b-chg
     9591           b-close
     9592           b-open
     9593       with frame Dialog-Frame .
     9594   end.
     9595   END PROCEDURE.
     9596   PROCEDURE ui-enable :
     9597       define variable v-current-db-num    as integer        no-undo.
     9598       define buffer buf_clients       for clients.
     9599   do
     9600   for buf_clients
     9601   on error undo, return error
     9602   :
     9603   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     9605     (output v-current-db-num
     9606     )  .
     9607       find first buf_clients no-lock
     9608            where buf_clients.obj-type = p-store-type
     9609              and buf_clients.obj-code = p-store-code
     9610       .
     9611       if v-current-db-num = buf_clients.db-num
     9612       then do:
     9613           enable
     9614               b-add
     9615               b-del
     9616               b-chg
     9617               b-close
     9618               b-open
     9619           with frame Dialog-Frame .
     9620       end.
     9621   end.
     9622   END PROCEDURE.
     9623   PROCEDURE view-doc :
     9624   do
     9625   on error undo, return error
     9626   :
     9627   define input parameter p-doc-code as character    no-undo.
     9628       run str/fbr-pln.w (
     9629             input parparentproc
     9630           , input this-procedure
     9631           , input 'ПРОСМОТР':U
     9632           , input p-doc-code
     9633           , input p-store-type
     9634           , input p-store-code
     9635           , input p-userid
     9636       ).
     9637   end.
     9638   END PROCEDURE.
