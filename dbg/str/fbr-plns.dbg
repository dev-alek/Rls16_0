     6825           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
     6826           v-fbrhist-upper-code        = v-fbrhist-current-code
     6827       .
     6828   end.
     6829   end procedure.
     6830   procedure fbrhist-save-current-code :
