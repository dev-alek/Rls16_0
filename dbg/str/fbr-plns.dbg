     5329           end.
     5330           run fbrlib-get-trn-type in this-procedure (
     5331                 input buf_fbr-recipe.recipe-code
     5332               , input recid( buf_goods )
     5333               , input ( if buf_start_temp_goods-qnty.trn-type = ?
     5334                         then ?
     5335                         else ( if buf_start_temp_goods-qnty.trn-type = 'при':U
     5336                                then yes
     5337                                else no ) )
     5338               , output v-is-comp
     5339               , output v-trn-type
     5340           ).
     5341           assign
     5342               buf_start_temp_goods-qnty.trn-type = v-trn-type
     5343           .
     5344           run str/fbr-crln.p (
     5345                 input p-mainmenu-handle
     5346               , input recid( buf_fbr-doc )
     5347               , input recid( buf_goods )
     5348               , input buf_fbr-recipe.recipe-code
     5349               , input v-trn-type
     5350               , input v-is-comp
     5351               , input yes
     5352               , input buf_fbr-doc.obj-type
     5353               , input buf_fbr-doc.obj-code
     5354               , output v-fbr-line-recid
     5355           ).
     5356           if buf_start_temp_goods-qnty.need-qnty = ?
     5357           then do:
     5358               find first tt-marking-lines no-error .
     5359               if available tt-marking-lines
     5360               then do :
     5361                 assign v-mark-qnty = 0 .
     5362                 for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5363                 first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5364                                           and buf_goods.prod-type = buf_fbr-line.prod-type
     5365                                           and buf_goods.prod-code = buf_fbr-line.prod-code,
     5366                 each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5367                 :
     5368                   assign v-mark-qnty = v-mark-qnty + tt-marking-lines.box-qnty .
     5369                 end .
     5370               end .
     5371               run str/fbr-line.w (
     5372                     input p-fbrhist-handle
     5373                   , input buf_fbr-doc.status_
     5374                   , input p-fbr-doc-doc-code
     5375                   , input v-fbr-line-recid
     5376                   , input v-mark-qnty
     5377                   , output v-cancel
     5378               ) no-error.
     5379               if error-status :error
     5380               or v-cancel = yes
     5381               then do:
     5382                   find first buf_fbr-line exclusive-lock
     5383                        where recid( buf_fbr-line ) = v-fbr-line-recid
     5384                   .
     5385                   for first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5386                                             and buf_goods.prod-type = buf_fbr-line.prod-type
     5387                                             and buf_goods.prod-code = buf_fbr-line.prod-code,
     5388                   each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5389                   :
     5390                     for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5391                       assign
     5392                         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5393                       .
     5394                     end .
     5395                   end .
     5396                   delete buf_fbr-line.
     5397                   run clear-temp-tables in this-procedure.
     5398                   return.
     5399               end.
     5400               for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5401               first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5402                                         and buf_goods.prod-type = buf_fbr-line.prod-type
     5403                                         and buf_goods.prod-code = buf_fbr-line.prod-code,
     5404               each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5405               :
     5406                 create buf_marking-lines .
     5407                 assign
     5408                   buf_marking-lines.mark      = tt-marking-lines.mark
     5409                   buf_marking-lines.obj-type  = buf_fbr-doc.obj-type
     5410                   buf_marking-lines.obj-code  = buf_fbr-doc.obj-code
     5411                   buf_marking-lines.gds-code  = buf_goods.gds-code
     5412                   buf_marking-lines.in-code   = "manufacturing"
     5413                   buf_marking-lines.out-code  = buf_fbr-line.doc-code
     5414                   buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5415                   buf_marking-lines.prt-code  = 0
     5416                   buf_marking-lines.doc-level = 1
     5417                 .
     5418               end .
     5419               find first buf_fbr-line exclusive-lock
     5420                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5421               .
     5422               if p-same-good = yes
     5423               then do:
     5424                   if p-autofbr = yes
     5425                   then do:
     5426                       assign
     5427                           v-yesno = yes
     5428                       .
     5429                   end.
     5430                   else do:
     5431                       message
     5432                                "Товар уже есть в документе."
     5433                           skip "Вы можете добавить введенное количество в строку документа,"
     5434                           skip "изменить количество в документе на введенное"
     5435                           skip "или отменить добавление товара, оставив рецепт без изменений"
     5436                           skip(1)
     5437                           skip "Артикул товара:        " buf_start_temp_goods-qnty.artic
     5438                           skip "Количество в документе:" p-same-good-old-qnty
     5439                           skip(1)
     5440                           skip "Добавить в строку?"
     5441                       view-as alert-box question
     5442                       buttons yes-no-cancel
     5443                       title "Добавление товара"
     5444                       update v-yesno.
     5445                       if v-yesno = ?
     5446                       then do:
     5447                           assign
     5448                               buf_start_temp_goods-qnty.need-qnty   = p-same-good-old-qnty
     5449                               buf_start_temp_goods-qnty.calculated  = yes
     5450                           .
     5451                           run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Расчитанная строка документа оставлена без изменений. Количество &1", buf_start_temp_goods-qnty.need-qnty ) ).
     5452                           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5453                           find first buf_start_temp_goods-qnty
     5454                                where buf_start_temp_goods-qnty.calculated = no
     5455                           no-error.
     5456                           next calc-not-calculated-goods.
     5457                       end.
     5458                   end.
     5459                   assign
     5460                       buf_start_temp_goods-qnty.calculated  = no
     5461                   .
     5462                   if v-yesno = yes
     5463                   then do:
     5464                       assign
     5465                           buf_fbr-line.fact-qnty = buf_fbr-line.fact-qnty + p-same-good-old-qnty
     5466                       .
     5467                   end.
     5468                   run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Количество в рассчитанной строке документа изменено на &1", buf_fbr-line.fact-qnty ) ).
     5469               end.
     5470               assign
     5471                   buf_start_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5472                   buf_start_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5473                   buf_start_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5474               .
     5475           end.
     5476           run writelog in this-procedure ( log-file-name, 2, "Идем по ингредиентам товара." ).
     5477           for each buf_fbr-recipe-gds no-lock
     5478              where buf_fbr-recipe-gds.doc-code    = buf_fbr-recipe.doc-code
     5479                and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     5480           on error undo, return error
     5481           :
     5482               find first buf_goods no-lock
     5483                    where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5484                      and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5485                      and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5486               .
     5487               assign
     5488                   v-is-comp = no
     5489                   v-trn-type = ( if buf_start_temp_goods-qnty.trn-type = 'при':U then 'спи':U else 'при':U )
     5490               .
     5491               run str/fbr-crln.p (
     5492                     input p-mainmenu-handle
     5493                   , input recid( buf_fbr-doc )
     5494                   , input recid( buf_goods )
     5495                   , input buf_fbr-recipe.recipe-code
     5496                   , input v-trn-type
     5497                   , input v-is-comp
     5498                   , input yes
     5499                   , input buf_fbr-doc.obj-type
     5500                   , input buf_fbr-doc.obj-code
     5501                   , output v-fbr-line-recid
     5502               ).
     5503               find first buf_fbr-line no-lock
     5504                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5505               .
     5506               run writelog in this-procedure ( log-file-name, 3, substitute( "Создана строка ингредиента с артикулом '&1'", buf_fbr-line.artic ) ).
     5507           end.
     5508           run writelog in this-procedure ( log-file-name, 2, substitute( "Упорядочивание рецептов. Идем по рецептам с последнего." ) ).
     5509           run fbrlib-put-in-order-recipe in this-procedure (
     5510               input buf_fbr-doc.doc-code
     5511           ) no-error.
     5512           if error-status :error
     5513           then do:
     5514               for each buf_del_temp_goods-qnty
     5515               :
     5516                   delete buf_del_temp_goods-qnty.
     5517               end.
     5518               undo, return error.
     5519           end.
     5520           find last temp_recipe-order.
     5521           calc-all-recipes:
     5522           do while available temp_recipe-order
     5523           :
     5524               run writelog in this-procedure ( log-file-name, 3, substitute( "Обработка рецепта номер: &1", temp_recipe-order.recipe-code ) ).
     5525               find first buf_comp_fbr-line exclusive-lock
     5526                    where buf_comp_fbr-line.doc-code    = p-fbr-doc-doc-code
     5527                      and buf_comp_fbr-line.is-comp     = yes
     5528                      and buf_comp_fbr-line.recipe-code = temp_recipe-order.recipe-code
     5529               .
     5530               find first buf_temp_goods-qnty
     5531                    where buf_temp_goods-qnty.artic        = buf_comp_fbr-line.artic
     5532                      and buf_temp_goods-qnty.prod-type    = buf_comp_fbr-line.prod-type
     5533                      and buf_temp_goods-qnty.prod-code    = buf_comp_fbr-line.prod-code
     5534                      and buf_temp_goods-qnty.recipe-code  = buf_comp_fbr-line.recipe-code
     5535               no-error.
     5536               if not available buf_temp_goods-qnty
     5537               or buf_temp_goods-qnty.calculated = no
     5538               then do:
     5539                   run writelog in this-procedure ( log-file-name, 4, "Товар рецепта не рассчитан. Рассчитываем." ).
     5540                   if available buf_temp_goods-qnty
     5541                   and buf_temp_goods-qnty.need-qnty <> buf_comp_fbr-line.fact-qnty
     5542                   then do:
     5543                       assign
     5544                           buf_comp_fbr-line.fact-qnty = buf_temp_goods-qnty.need-qnty
     5545                       .
     5546                       run writelog in this-procedure ( log-file-name, 5, substitute( "Прописываем количество в строку составного товара: &1", buf_comp_fbr-line.fact-qnty  ) ).
     5547                   end.
     5548                   run str/fbr-qnty.p (
     5549                         input p-mainmenu-handle
     5550                       , input p-fbrhist-handle
     5551                       , input recid( buf_fbr-doc )
     5552                       , input recid( buf_comp_fbr-line )
     5553                       , input no
     5554                       , input "ingr"
     5555                       , input no
     5556                       , input p-price-sale-obj-type
     5557                       , input p-price-sale-obj-code
     5558                       , input yes
     5559                       , input p-autofbr
     5560                       , input p-have-store
     5561                       , output v-need-goods
     5562                       , output v-need-goods-list
     5563                       , output v-need-goods-qnty-list
     5564                   ).
     5565                   if p-add-childs  = yes
     5566                   and v-need-goods = yes
     5567                   then do:
     5568                       do v-counter = 1 to num-entries( v-need-goods-list ) / 2
     5569                       :
     5570                           run add-new-recipe in this-procedure (
     5571                                 input p-mainmenu-handle
     5572                               , input buf_fbr-doc.doc-code
     5573                               , input entry( 2 * v-counter, v-need-goods-list )
     5574                               , input integer( entry( 2 * v-counter - 1 , v-need-goods-list ) )
     5575                               , input decimal( entry( v-counter, v-need-goods-qnty-list ) )
     5576                               , input p-autofbr
     5577                               , input p-have-store
     5578                           ).
     5579                       end.
     5580                       leave calc-all-recipes.
     5581                   end.
     5582               end.
     5583               find prev temp_recipe-order no-error.
     5584           end.
     5585           assign
     5586               buf_start_temp_goods-qnty.calculated = yes
     5587           .
     5588           if buf_start_temp_goods-qnty.recipe-type = 'разделка':U
     5589           or ( buf_start_temp_goods-qnty.recipe-type = 'комплектация':U
     5590                and buf_start_temp_goods-qnty.trn-type = 'спи':U )
     5591           then do:
     5592               run fill-temp-dressing-ingr in this-procedure (
     5593                     input buf_fbr-doc.doc-code
     5594                   , input buf_start_temp_goods-qnty.recipe-code
     5595               ).
     5596           end.
     5597           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5598           find first buf_start_temp_goods-qnty
     5599                where buf_start_temp_goods-qnty.calculated = no
     5600           no-error.
     5601       end.
     5602   end.
     5603   END PROCEDURE.
     5604   PROCEDURE clear-temp-tables :
     5605   do
     5606   on error undo, return error
     5607   :
     5608       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5609       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5610       for each buf_temp_goods-qnty
     5611       on error undo, return error
     5612       :
     5613           delete buf_temp_goods-qnty.
     5614       end.
     5615       for each buf_temp_dressing-ingr
     5616       on error undo, return error
     5617       :
     5618           delete buf_temp_dressing-ingr.
     5619       end.
     5620   end.
     5621   END PROCEDURE.
     5622   PROCEDURE copy-recipe-in-doc :
     5623   define input parameter p-doc-code       as character             no-undo.
     5624   define input parameter p-recipe-code    as character             no-undo.
     5625   define input parameter p-obj-date       as date                  no-undo.
     5626   define input parameter p-obj-type       like ub.clients.obj-type no-undo.
     5627   define input parameter p-obj-code       like ub.clients.obj-code no-undo.
     5628       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5629       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5630       define buffer buf_recipe            for ub.recipe.
     5631       define buffer buf_recipe-gds        for ub.recipe-gds.
     5632   do
     5633   for buf_fbr-recipe
     5634     , buf_fbr-recipe-gds
     5635     , buf_recipe
     5636     , buf_recipe-gds
     5637   on error undo, return error return-value
     5638   :
     5639   find first buf_recipe no-lock
     5640        where buf_recipe.recipe-code = p-recipe-code
     5641   .
     5642   find first buf_fbr-recipe exclusive-lock
     5643        where buf_fbr-recipe.doc-code      = p-doc-code
     5644          and buf_fbr-recipe.recipe-code   = p-recipe-code
     5645   no-error.
     5646   if not available buf_fbr-recipe
     5647   then do:
     5648     create buf_fbr-recipe.
     5649     assign
     5650       buf_fbr-recipe.doc-code     = p-doc-code
     5651       buf_fbr-recipe.recipe-code  = p-recipe-code
     5652       buf_fbr-recipe.recipe-type  = buf_recipe.recipe-type
     5653     .
     5654     for each buf_recipe-gds exclusive-lock
     5655        where buf_recipe-gds.recipe-code = p-recipe-code
     5656     on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     5657           run fbrlib_create-fbr-recipe-gds in this-procedure (
     5658                 input p-doc-code
     5659               , input buf_recipe-gds.recipe-code
     5660               , input buf_recipe-gds.prod-type
     5661               , input buf_recipe-gds.prod-code
     5662               , input buf_recipe-gds.artic
     5663               , input buf_recipe-gds.gds-code
     5664               , input buf_recipe-gds.is-waste
     5665               , input buf_recipe-gds.proc-number
     5666               , input p-obj-date
     5667               , input p-obj-type
     5668               , input p-obj-code
     5669               , input buf_recipe-gds.calc-method
     5670               , input buf_recipe-gds.coeff-waste
     5671               , input buf_recipe-gds.qnty
     5672               , input buf_recipe-gds.brutto-qnty
     5673         ) no-error.
     5674         if error-status:error
     5675         then do:
     5676               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     5677         end.
     5678     end.
     5679     buffer-copy buf_recipe to buf_fbr-recipe.
     5680   end.
     5681   end.
     5682   END PROCEDURE.
     5683   PROCEDURE fill-temp-dressing-ingr :
     5684   do
     5685   on error undo, return error
     5686   :
     5687   define input parameter p-doc-code       as character    no-undo.
     5688   define input parameter p-recipe-code    as character    no-undo.
     5689       define variable v-free-qnty     as decimal       no-undo.
     5690       define buffer buf_fbr-doc               for ub.fbr-doc.
     5691       define buffer buf_c_fbr-line            for ub.fbr-line.
     5692       define buffer buf_i_fbr-line            for ub.fbr-line.
     5693       define buffer buf_i_other_fbr-line      for ub.fbr-line.
     5694       define buffer buf_goods                 for ub.goods.
     5695       define buffer buf_recipe                for ub.fbr-recipe.
     5696       define buffer buf_recipe-gds            for ub.fbr-recipe-gds.
     5697       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5698       find first buf_fbr-doc no-lock
     5699            where buf_fbr-doc.doc-code = p-doc-code
     5700       .
     5701       find first buf_recipe no-lock
     5702            where buf_recipe.doc-code    = p-doc-code
     5703              and buf_recipe.recipe-code = p-recipe-code
     5704       .
     5705       find first buf_c_fbr-line no-lock
     5706            where buf_c_fbr-line.doc-code    = p-doc-code
     5707              and buf_c_fbr-line.is-comp     = yes
     5708              and buf_c_fbr-line.recipe-code = p-recipe-code
     5709       .
     5710       if buf_recipe.recipe-type <> 'разделка':U
     5711       and ( buf_recipe.recipe-type <> 'комплектация':U
     5712            or buf_c_fbr-line.trn-type <> 'спи':U )
     5713       then do:
     5714           message
     5715                    vss-workfile vss-revision vss-description
     5716               skip "Процедура fill-temp-dressing-ingr применима только к рецептам разделки и разукомплектации."
     5717               skip return-value
     5718           view-as alert-box error.
     5719           undo, return error .
     5720       end.
     5721       for each buf_temp_dressing-ingr
     5722       :
     5723           delete buf_temp_dressing-ingr.
     5724       end.
     5725       for each buf_i_fbr-line no-lock
     5726          where buf_i_fbr-line.doc-code    = p-doc-code
     5727            and buf_i_fbr-line.is-comp     = no
     5728            and buf_i_fbr-line.recipe-code = p-recipe-code
     5729       on error undo, return error
     5730       :
     5731           find first buf_goods no-lock
     5732                where buf_goods.artic      = buf_i_fbr-line.artic
     5733                  and buf_goods.prod-type  = buf_i_fbr-line.prod-type
     5734                  and buf_goods.prod-code  = buf_i_fbr-line.prod-code
     5735           .
     5736           find first buf_temp_dressing-ingr
     5737                where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5738                  and buf_temp_dressing-ingr.gds-code    = buf_goods.gds-code
     5739           no-error.
     5740           if not available buf_temp_dressing-ingr
     5741           then do:
     5742               create buf_temp_dressing-ingr.
     5743               assign
     5744                   buf_temp_dressing-ingr.recipe-code  = p-recipe-code
     5745                   buf_temp_dressing-ingr.gds-code     = buf_goods.gds-code
     5746                   buf_temp_dressing-ingr.used-qnty    = 0
     5747                   buf_temp_dressing-ingr.line-qnty    = 0
     5748                   buf_temp_dressing-ingr.recipe-qnty  = 0
     5749               .
     5750           end.
     5751           run fbrrest-get-free-qnty in this-procedure (
     5752                 input buf_fbr-doc.obj-type
     5753               , input buf_fbr-doc.obj-code
     5754               , input buf_goods.gds-code
     5755               , input no
     5756               , output v-free-qnty
     5757           ).
     5758           find first buf_recipe-gds no-lock
     5759                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5760                  and buf_recipe-gds.recipe-code = p-recipe-code
     5761                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5762                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5763                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5764           .
     5765           for each buf_i_other_fbr-line no-lock
     5766              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5767                and buf_i_other_fbr-line.is-comp     = no
     5768                and buf_i_other_fbr-line.recipe-code <> p-recipe-code
     5769                and buf_i_other_fbr-line.artic       = buf_i_fbr-line.artic
     5770                and buf_i_other_fbr-line.prod-type   = buf_i_fbr-line.prod-type
     5771                and buf_i_other_fbr-line.prod-code   = buf_i_fbr-line.prod-code
     5772           :
     5773               assign
     5774                   buf_temp_dressing-ingr.line-qnty    = buf_temp_dressing-ingr.line-qnty
     5775                                                           + buf_i_other_fbr-line.fact-qnty
     5776               .
     5777           end.
     5778           if available buf_temp_dressing-ingr
     5779           then do:
     5780               assign
     5781                   buf_temp_dressing-ingr.used-qnty = buf_temp_dressing-ingr.line-qnty - v-free-qnty
     5782               .
     5783           end.
     5784       end.
     5785       for each buf_temp_dressing-ingr
     5786          where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5787       :
     5788           find first buf_goods no-lock
     5789                where buf_goods.gds-code = buf_temp_dressing-ingr.gds-code
     5790           .
     5791           for each buf_i_other_fbr-line no-lock
     5792              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5793                and buf_i_other_fbr-line.is-comp     = no
     5794                and buf_i_other_fbr-line.recipe-code = buf_temp_dressing-ingr.recipe-code
     5795                and buf_i_other_fbr-line.artic       = buf_goods.artic
     5796                and buf_i_other_fbr-line.prod-type   = buf_goods.prod-type
     5797                and buf_i_other_fbr-line.prod-code   = buf_goods.prod-code
     5798           on error undo, return error
     5799           :
     5800               assign
     5801                   buf_temp_dressing-ingr.recipe-qnty = buf_temp_dressing-ingr.recipe-qnty
     5802                                                       + buf_i_other_fbr-line.fact-qnty
     5803               .
     5804           end.
     5805       end.
     5806   end.
     5807   END PROCEDURE.
     5808   PROCEDURE test-temp-tables :
     5809       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5810       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5811   do
     5812   on error undo, return error
     5813   :
     5814   define input parameter p-title  as character    no-undo.
     5815   define variable v-str               as character        no-undo.
     5816       assign
     5817           v-str = p-title + " temp_goods-qnty:"
     5818       .
     5819       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5820       for each buf_temp_goods-qnty
     5821       on error undo, return error
     5822       :
     5823           assign
     5824               v-str   = string( buf_temp_goods-qnty.gds-code )
     5825                       + "   " + ( if buf_temp_goods-qnty.recipe-type = ? then "?" else string( buf_temp_goods-qnty.recipe-type ) )
     5826                       + "   " + ( if buf_temp_goods-qnty.recipe-code = ? then "?" else string( buf_temp_goods-qnty.recipe-code ) )
     5827                       + "   " + ( if buf_temp_goods-qnty.trn-type = ?    then "?" else string( buf_temp_goods-qnty.trn-type ) )
     5828                       + "   " + ( if buf_temp_goods-qnty.need-qnty = ?   then "?" else string( buf_temp_goods-qnty.need-qnty ) )
     5829                       + "   " + string( buf_temp_goods-qnty.calculated )
     5830           .
     5831           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5832       end.
     5833       assign
     5834           v-str = "        temp_dressing-ingr:"
     5835       .
     5836       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5837       for each buf_temp_dressing-ingr
     5838       on error undo, return error
     5839       :
     5840           assign
     5841               v-str   = string( buf_temp_dressing-ingr.recipe-code  )
     5842                       + "   " + string( buf_temp_dressing-ingr.gds-code )
     5843                       + "   " + ( if buf_temp_dressing-ingr.line-qnty = ?   then "?" else string( buf_temp_dressing-ingr.line-qnty ) )
     5844                       + "   " + ( if buf_temp_dressing-ingr.used-qnty = ?   then "?" else string( buf_temp_dressing-ingr.used-qnty ) )
     5845                       + "   " + ( if buf_temp_dressing-ingr.recipe-qnty = ? then "?" else string( buf_temp_dressing-ingr.recipe-qnty ) )
     5846           .
     5847           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5848       end.
     5849   end.
     5850   END PROCEDURE.
     5851   PROCEDURE add-new-recipe :
     5852   do
     5853   on error undo, return error
     5854   :
     5855   define input parameter p-mainmenu-handle    as handle           no-undo.
     5856   define input parameter p-doc-code           as character        no-undo.
     5857   define input parameter p-trn-type           as character        no-undo.
     5858   define input parameter p-gds-code           as integer          no-undo.
     5859   define input parameter p-need-qnty          as decimal          no-undo.
     5860   define input parameter p-autofbr            as logical          no-undo.
     5861   define input parameter p-have-store         as logical          no-undo.
     5862       define variable v-comp-gds-code         as integer          no-undo.
     5863       define variable v-comp-trn-type         as character        no-undo.
     5864       define variable v-comp-need-qnty        as decimal          no-undo.
     5865       define variable v-comp-recipe-type      as character        no-undo.
     5866       define variable v-comp-recipe-code      as character        no-undo.
     5867       define variable v-comp-recipe-found     as logical          no-undo.
     5868       define variable v-ext-comp-recipe-type  as character        no-undo.
     5869       define variable v-no-add-good           as logical          no-undo.
     5870       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5871       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     5872       define buffer buf_goods                 for ub.goods.
     5873       define buffer buf_fbr-line              for ub.fbr-line.
     5874       define buffer buf_fbr-doc               for ub.fbr-doc.
     5875       define variable v-value          as character no-undo .
     5876       define variable v-type           as character no-undo .
     5877       define variable v-attr-value     as character no-undo .
     5878       define variable v-attr-value-rec as character no-undo .
     5879       define variable v-attr-type      as character no-undo .
     5880       define variable v-ban-recipes as logical no-undo .
     5881       define variable v-ban-altr    as logical no-undo .
     5882       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     5883       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     5884       find first buf_fbr-doc no-lock
     5885            where buf_fbr-doc.doc-code = p-doc-code
     5886       .
     5887       run extend-noweight-gds-qnty in this-procedure (
     5888             input p-gds-code
     5889           , input p-need-qnty
     5890           , output p-need-qnty
     5891       ).
     5892       run select-recipe in this-procedure (
     5893             input p-mainmenu-handle
     5894           , input buf_fbr-doc.obj-type
     5895           , input buf_fbr-doc.obj-code
     5896           , input p-gds-code
     5897           , input p-trn-type
     5898           , input p-need-qnty
     5899           , input p-autofbr
     5900           , input p-have-store
     5901           , output v-comp-gds-code
     5902           , output v-comp-trn-type
     5903           , output v-comp-need-qnty
     5904           , output v-comp-recipe-type
     5905           , output v-comp-recipe-code
     5906           , output v-comp-recipe-found
     5907           , output v-no-add-good
     5908       ) no-error.
     5909       if not error-status :error
     5910       and v-comp-recipe-found = yes
     5911       and v-no-add-good       = no
     5912       then do:
     5913           find first buf_goods no-lock
     5914                where buf_goods.gds-code = v-comp-gds-code
     5915           .
     5916           assign
     5917               v-ext-comp-recipe-type = v-comp-recipe-type
     5918           .
     5919           if v-comp-recipe-type = 'комплектация':U
     5920           and v-comp-trn-type   = 'спи':U
     5921           then do:
     5922               assign
     5923                   v-ext-comp-recipe-type = 'разделка':U
     5924               .
     5925           end.
     5926           case v-ext-comp-recipe-type
     5927           :
     5928               when 'разделка':U
     5929               then do:
     5930                   find first buf_temp_goods-qnty
     5931                        where buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5932                          and buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5933                   no-error.
     5934                   if not available buf_temp_goods-qnty
     5935                   then do:
     5936                       create buf_temp_goods-qnty.
     5937                       assign
     5938                           buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5939                           buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     5940                           buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5941                           buf_temp_goods-qnty.artic       = buf_goods.artic
     5942                           buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     5943                           buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     5944                           buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     5945                           buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     5946                           buf_temp_goods-qnty.calculated  = no
     5947                       .
     5948                   end.
     5949                   else do:
     5950                       find first buf_goods no-lock
     5951                            where buf_goods.gds-code = p-gds-code
     5952                       .
     5953                       find first buf_fbr-line no-lock
     5954                            where buf_fbr-line.doc-code    = p-doc-code
     5955                              and buf_fbr-line.trn-type    = p-trn-type
     5956                              and buf_fbr-line.recipe-code = v-comp-recipe-code
     5957                              and buf_fbr-line.artic       = buf_goods.artic
     5958                              and buf_fbr-line.prod-type   = buf_goods.prod-type
     5959                              and buf_fbr-line.prod-code   = buf_goods.prod-code
     5960                       no-error.
     5961                       if available buf_fbr-line
     5962                       then do:
     5963                           define variable v-line-qnty             as decimal   no-undo.
     5964                           define variable v-used-qnty             as decimal   no-undo.
     5965                           define variable v-free-qnty             as decimal   no-undo.
     5966                           define variable v-recipe-qnty           as decimal   no-undo.
     5967                           define variable v-comp-fbr-line-recid   as recid     no-undo.
     5968                           run get-temp_dressing-ingr-used-qnty in this-procedure (
     5969                                 input v-comp-recipe-code
     5970                               , input p-gds-code
     5971                               , output v-line-qnty
     5972                               , output v-used-qnty
     5973                               , output v-recipe-qnty
     5974                           ).
     5975                           run fbrrest-get-free-qnty in this-procedure (
     5976                                 input buf_fbr-doc.obj-type
     5977                               , input buf_fbr-doc.obj-code
     5978                               , input p-gds-code
     5979                               , input p-autofbr
     5980                               , output v-free-qnty
     5981                           ).
     5982                           assign
     5983                               p-need-qnty = p-need-qnty + v-recipe-qnty
     5984                           .
     5985                           run calc-comp-from-ingr in this-procedure (
     5986                                 input recid( buf_fbr-line )
     5987                               , input p-need-qnty
     5988                               , output v-comp-fbr-line-recid
     5989                               , output v-comp-need-qnty
     5990                           ) .
     5991                       end.
     5992                       assign
     5993                           buf_temp_goods-qnty.need-qnty   = maximum( buf_temp_goods-qnty.need-qnty, v-comp-need-qnty )
     5994                           buf_temp_goods-qnty.calculated  = no
     5995                       .
     5996                   end.
     5997               end.
     5998               otherwise do:
     5999         if v-ban-altr or v-ban-recipes then
     6000         do:
     6001             if v-ext-comp-recipe-type = 'производство':U and v-ban-recipes then
     6002             do:
     6003                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6004                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6005                      , input  'mark-type':U
     6006                      , output v-attr-value
     6007                      , output v-attr-type
     6008                      ) no-error .
     6009                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6010                   do:
     6011                      message "Рецепт производства " + v-comp-recipe-code + " содержит маркированный товар."
     6012                         view-as alert-box.
     6013                      return .
     6014                   end.
     6015                end.
     6016             end.
     6017             if v-ext-comp-recipe-type = 'альтернатива':U and v-ban-altr then
     6018             do:
     6019                if not check-ban-sales-via-cd(buf_goods.gds-code) then
     6020                do:
     6021                  message "Рецепт альтернатива " + v-comp-recipe-code + " входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     6022                    view-as alert-box.
     6023                  return .
     6024                end.
     6025             end.
     6026             if v-ext-comp-recipe-type = 'комплектация':U and v-ban-recipes then
     6027             do:
     6028                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6029                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6030                      , input  'mark-type':U
     6031                      , output v-attr-value
     6032                      , output v-attr-type
     6033                      ) no-error .
     6034                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6035                   do:
     6036                      run gds-attr-value in this-procedure  ( input  p-gds-code
     6037                         , input  'mark-type':U
     6038                         , output v-attr-value-rec
     6039                         , output v-attr-type
     6040                         ) no-error .
     6041                      if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     6042                      do:
     6043                         message "Рецепт комплектации " + v-comp-recipe-code + " должен быть маркированным"
     6044                            view-as alert-box.
     6045                         return .
     6046                      end.
     6047                      else leave.
     6048                   end.
     6049                end.
     6050             end.
     6051         end.
     6052                   find first buf_temp_goods-qnty
     6053                        where buf_temp_goods-qnty.gds-code = p-gds-code
     6054                          and buf_temp_goods-qnty.trn-type = p-trn-type
     6055                   no-error.
     6056                   if available buf_temp_goods-qnty
     6057                   then do:
     6058                       assign
     6059                           buf_temp_goods-qnty.need-qnty  = buf_temp_goods-qnty.need-qnty + p-need-qnty
     6060                       .
     6061                       if buf_temp_goods-qnty.recipe-code <> ""
     6062                       then do:
     6063                           assign
     6064                               buf_temp_goods-qnty.calculated = no
     6065                           .
     6066                       end.
     6067                       run writelog in this-procedure ( log-file-name, 5, substitute( "Раскрутка ингредиетнов: добавляем товар '&1' к уже рассчитанному: &2", buf_temp_goods-qnty.artic, buf_temp_goods-qnty.need-qnty  ) ).
     6068                   end.
     6069                   else do:
     6070                       find first buf_temp_goods-qnty
     6071                            where buf_temp_goods-qnty.gds-code = v-comp-gds-code
     6072                              and buf_temp_goods-qnty.trn-type = v-comp-trn-type
     6073                       no-error.
     6074                       if not available buf_temp_goods-qnty
     6075                       then do:
     6076                           create buf_temp_goods-qnty.
     6077                           find first buf_goods no-lock
     6078                                where buf_goods.gds-code = v-comp-gds-code
     6079                           .
     6080                           assign
     6081                               buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6082                               buf_temp_goods-qnty.artic       = buf_goods.artic
     6083                               buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6084                               buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6085                               buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6086                               buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6087                               buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6088                               buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6089                               buf_temp_goods-qnty.calculated  = no
     6090                           .
     6091                           run writelog in this-procedure ( log-file-name, 5, "Раскрутка ингредиентов: добавляем товар как не рассчитанный." ).
     6092                       end.
     6093                   end.
     6094               end.
     6095           end case.
     6096           if available buf_temp_goods-qnty
     6097           then do:
     6098               run extend-noweight-gds-qnty in this-procedure (
     6099                     input buf_temp_goods-qnty.gds-code
     6100                   , input buf_temp_goods-qnty.need-qnty
     6101                   , output buf_temp_goods-qnty.need-qnty
     6102               ).
     6103           end.
     6104           find first buf_goods no-lock
     6105                where buf_goods.gds-code = v-comp-gds-code
     6106           .
     6107           if v-ext-comp-recipe-type = 'разделка':U
     6108           then do:
     6109               find first buf_fbr-line exclusive-lock
     6110                   where buf_fbr-line.doc-code    = p-doc-code
     6111                   and buf_fbr-line.trn-type    = v-comp-trn-type
     6112                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6113                   and buf_fbr-line.artic       = buf_goods.artic
     6114                   and buf_fbr-line.prod-type   = buf_goods.prod-type
     6115                   and buf_fbr-line.prod-code   = buf_goods.prod-code
     6116               no-error.
     6117               if available buf_fbr-line
     6118               then do:
     6119                   assign
     6120                       buf_fbr-line.fact-qnty = 0
     6121                   .
     6122               end.
     6123           end.
     6124           else do:
     6125               for each buf_fbr-line exclusive-lock
     6126               where buf_fbr-line.doc-code    = p-doc-code
     6127                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6128               on error undo, return error
     6129               :
     6130                   delete buf_fbr-line.
     6131               end.
     6132           end.
     6133       end.
     6134   end.
     6135   END PROCEDURE.
     6136   PROCEDURE extend-noweight-gds-qnty :
     6137   do
     6138   on error undo, return error
     6139   :
     6140   define input parameter p-gds-code   as integer      no-undo.
     6141   define input parameter p-in-qnty    as decimal      no-undo.
     6142   define output parameter p-out-qnty  as decimal      no-undo.
     6143       define buffer buf_goods                 for ub.goods.
     6144       define buffer buf_units                 for ub.units.
     6145       find first buf_goods no-lock
     6146            where buf_goods.gds-code = p-gds-code
     6147       .
     6148       find first buf_units no-lock
     6149            where buf_units.unit-name = buf_goods.unit-base
     6150       .
     6151       assign
     6152           p-out-qnty = p-in-qnty
     6153       .
     6154       if not ( lookup( 'вес':U, buf_units.type ) > 0
     6155                or lookup ('дро':U, buf_units.type) > 0 )
     6156       then do:
     6157           if p-out-qnty <> truncate( p-out-qnty, 0 )
     6158           then do:
     6159               assign
     6160                   p-out-qnty = truncate( p-out-qnty, 0 ) + 1
     6161               .
     6162           end.
     6163       end.
     6164   end.
     6165   END PROCEDURE.
     6166   PROCEDURE select-recipe :
     6167   do
     6168   on error undo, return error
     6169   :
     6170   define input parameter p-mainmenu-handle    as handle           no-undo.
     6171   define input parameter p-obj-type           as character        no-undo.
     6172   define input parameter p-obj-code           as integer          no-undo.
     6173   define input parameter p-gds-code           as integer          no-undo.
     6174   define input parameter p-trn-type           as character        no-undo.
     6175   define input parameter p-gds-qnty           as decimal          no-undo.
     6176   define input parameter p-autofbr            as logical          no-undo.
     6177   define input parameter p-have-store         as logical          no-undo.
     6178   define output parameter p-out-gds-code      as integer          no-undo.
     6179   define output parameter p-out-trn-type      as character        no-undo.
     6180   define output parameter p-out-gds-qnty      as decimal          no-undo.
     6181   define output parameter p-out-recipe-type   as character        no-undo.
     6182   define output parameter p-out-recipe-code   as character        no-undo.
     6183   define output parameter p-recipe-found      as logical          no-undo.
     6184   define output parameter p-no-need-good      as logical          no-undo.
     6185   define variable v-host-code             as integer      no-undo.
     6186   define variable v-value-character as character  no-undo .
     6187   define variable v-value-date      as date       no-undo .
     6188   define variable v-value-decimal   as decimal    no-undo .
     6189   define variable v-value-integer   as integer    no-undo .
     6190   define variable v-value-logical   as logical    no-undo .
     6191   define variable v-tth             as handle     no-undo .
     6192   define variable v-param-type            as character no-undo .
     6193   define variable v-type                  as character    no-undo.
     6194   define variable v-recipe-type           as character    no-undo.
     6195   define variable v-recipe-list           as character    no-undo.
     6196   define variable v-is-comp               as logical      no-undo.
     6197   define variable v-is-integration        as logical      no-undo.
     6198   define variable v-cancel                as logical      no-undo.
     6199   define variable v-yesno                 as logical      no-undo.
     6200   define variable v-default-recipe-code   as character    no-undo.
     6201       define buffer buf_recipe            for ub.recipe.
     6202       define buffer buf_goods             for ub.goods.
     6203       define buffer buf_selected_recipe   for ub.recipe.
     6204       define buffer buf_recipe-gds        for ub.recipe-gds.
     6205       define buffer buf_ingr_goods        for ub.goods.
     6206       run writelog in this-procedure (
     6207           input log-file-name
     6208           , input 0
     6209           , input "******** select-recipe ***************************************"
     6210       ).
     6211       find first buf_goods no-lock
     6212            where buf_goods.gds-code = p-gds-code
     6213       .
     6214       if p-trn-type = ?
     6215       then do:
     6216           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     6217           undo, return error.
     6218       end.
     6219   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6221     (input  p-obj-type
     6222     ,input  p-obj-code
     6223     ,output v-host-code
     6224     )  .
     6225       run adm/shattri.p ( input "get":U
     6226                         , input  '':u
     6227                         , input  0
     6228                         , input  'fbrattr':U
     6229                         , input  'fbr-frcp':U
     6230                         , output v-value-character
     6231                         , output v-value-date
     6232                         , output v-value-decimal
     6233                         , output v-value-integer
     6234                         , output v-value-logical
     6235                         , output v-param-type
     6236                         , input-output table-handle v-tth
     6237                         ) no-error .
     6238       if error-status :error then do:
     6239          assign
     6240             v-value-logical = FALSE
     6241          .
     6242       end.
     6243       run writelog in this-procedure (
     6244             input log-file-name
     6245           , input 1
     6246           , input substitute( "fbr-frcp = '&1'", v-value-logical )
     6247       ).
     6248       assign
     6249           p-out-recipe-type = ?
     6250           p-out-recipe-code = ?
     6251           v-recipe-type = ?
     6252       .
     6253       run fbrlib-get-obj-recipe in this-procedure (
     6254             input p-obj-type
     6255           , input p-obj-code
     6256           , input p-gds-code
     6257           , output v-default-recipe-code
     6258       ).
     6259       comp-recipe:
     6260       for each buf_recipe no-lock
     6261          where ( buf_recipe.obj-type = p-obj-type
     6262              and buf_recipe.obj-code = p-obj-code
     6263              and buf_recipe.artic     = buf_goods.artic
     6264              and buf_recipe.prod-type = buf_goods.prod-type
     6265              and buf_recipe.prod-code = buf_goods.prod-code
     6266              and buf_recipe.stts      <> 2
     6267             )
     6268             or ( buf_recipe.obj-type = ""
     6269              and buf_recipe.obj-code = 0
     6270              and buf_recipe.artic     = buf_goods.artic
     6271              and buf_recipe.prod-type = buf_goods.prod-type
     6272              and buf_recipe.prod-code = buf_goods.prod-code
     6273              and buf_recipe.stts      <> 2
     6274             )
     6275       :
     6276           if  ( p-autofbr = yes or v-value-logical = yes ) and buf_recipe.recipe-code <> v-default-recipe-code
     6277           then do:
     6278               undo comp-recipe, next comp-recipe.
     6279           end.
     6280           run writelog in this-procedure (
     6281                 input log-file-name
     6282               , input 3
     6283               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6284           ).
     6285           if p-autofbr = yes
     6286           and buf_recipe.recipe-type <> 'производство':U
     6287           and buf_recipe.recipe-type <> 'альтернатива':U
     6288           and buf_recipe.recipe-type <> 'комплектация':U
     6289           and buf_recipe.recipe-type <> 'комплектация':U
     6290           then do:
     6291               next comp-recipe.
     6292           end.
     6293           if p-trn-type = 'при':U
     6294           and buf_recipe.recipe-type = 'разделка':U
     6295           then do:
     6296               run writelog in this-procedure (
     6297                     input log-file-name
     6298                   , input 4
     6299                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     6300               ).
     6301               next comp-recipe.
     6302           end.
     6303           if p-trn-type = 'спи':U
     6304           and buf_recipe.recipe-type <> 'разделка':U
     6305           and buf_recipe.recipe-type <> 'комплектация':U
     6306           then do:
     6307               run writelog in this-procedure (
     6308                     input log-file-name
     6309                   , input 4
     6310                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     6311               ).
     6312               next comp-recipe.
     6313           end.
     6314           if v-recipe-type = ?
     6315           then do:
     6316               assign
     6317                   p-out-recipe-type = buf_recipe.recipe-type
     6318                   p-out-recipe-code = buf_recipe.recipe-code
     6319                   v-recipe-type = "recipe"
     6320                   v-is-integration = yes
     6321               .
     6322               run writelog in this-procedure (
     6323                     input log-file-name
     6324                   , input 4
     6325                   , input "Найден первый подходящий рецепт для составного"
     6326               ).
     6327               if v-value-logical
     6328               then do:
     6329                   run writelog in this-procedure (
     6330                       input log-file-name
     6331                       , input 4
     6332                       , input "Включен параметр fbr-frcp. Больше рецепт не ищем"
     6333                   ).
     6334                   leave comp-recipe.
     6335               end.
     6336               if p-autofbr = yes
     6337               then do:
     6338                   run writelog in this-procedure (
     6339                         input log-file-name
     6340                       , input 4
     6341                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     6342                   ).
     6343                   leave comp-recipe.
     6344               end.
     6345           end.
     6346           else do:
     6347               run writelog in this-procedure (
     6348                     input log-file-name
     6349                   , input 4
     6350                   , input "Найден еще один подходящий рецепт"
     6351               ).
     6352               assign
     6353                   v-yesno = ?
     6354                   p-no-need-good = yes
     6355               .
     6356               do while v-yesno = ?
     6357               and p-no-need-good = yes
     6358               :
     6359                   run ref/rcp-all.w (
     6360                         input p-mainmenu-handle
     6361                       , input "b-sel"
     6362                       , input 'все':U
     6363                       , input recid( buf_goods )
     6364                       , input p-obj-type
     6365                       , input p-obj-code
     6366                       , output v-recipe-list
     6367                   ) no-error.
     6368                   if error-status :error
     6369                   or v-recipe-list = ""
     6370                   then do:
     6371                       message
     6372                           "Отменить добавление товара?"
     6373                           skip(1)
     6374                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     6375                           skip(1)
     6376                           skip "Yes - отменить добавление текущего товара"
     6377                           skip "No  - отменить добавление товаров"
     6378                           skip "Cancel - вернуться к выбору рецептов"
     6379                       view-as alert-box question
     6380                       buttons yes-no-cancel
     6381                       title "Отмена"
     6382                       update v-yesno
     6383                       .
     6384                   end.
     6385                   else do:
     6386                       assign
     6387                           p-no-need-good = no
     6388                       .
     6389                   end.
     6390               end.
     6391               if p-no-need-good = yes
     6392               then do:
     6393                   if v-yesno = no
     6394                   then do:
     6395                       undo, return error .
     6396                   end.
     6397                   else do:
     6398                       return.
     6399                   end.
     6400               end.
     6401               find first buf_selected_recipe no-lock
     6402                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     6403               no-error.
     6404               if not available buf_selected_recipe
     6405               then do:
     6406                   assign
     6407                       p-out-recipe-type = ?
     6408                       p-out-recipe-code = ?
     6409                       v-is-integration  = ?
     6410                   .
     6411               end.
     6412               else do:
     6413                   assign
     6414                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     6415                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     6416                       v-recipe-type       = "recipe"
     6417                       v-is-integration    = yes
     6418                   .
     6419                   leave comp-recipe.
     6420               end.
     6421           end.
     6422       end.
     6423       if v-recipe-type = ?
     6424       and p-autofbr = no
     6425       then do:
     6426           run writelog in this-procedure (
     6427                 input log-file-name
     6428               , input 3
     6429               , input "Поиск товара среди ингредиентов рецептов."
     6430           ).
     6431           search-recipe-gds:
     6432           for each buf_recipe-gds
     6433              where buf_recipe-gds.artic       = buf_goods.artic
     6434                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6435                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6436           :
     6437               find first buf_recipe no-lock
     6438                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     6439                      and buf_recipe.obj-type    = p-obj-type
     6440                      and buf_recipe.obj-code    = p-obj-code
     6441                    no-error
     6442               .
     6443               if not available buf_recipe then next search-recipe-gds.
     6444               find buf_ingr_goods no-lock
     6445                   where buf_ingr_goods.gds-code = buf_recipe.gds-code
     6446               .
     6447               if buf_ingr_goods.stts <> 0 then do:
     6448                   run writelog in this-procedure (
     6449                         input log-file-name
     6450                       , input 3
     6451                       , input subst("Рецепт &1 на товар &2 не подходит т.к. товар удален", buf_recipe.recipe-code, buf_ingr_goods.gds-code)
     6452                   ).
     6453                   next search-recipe-gds.
     6454               end.
     6455               run writelog in this-procedure (
     6456                     input log-file-name
     6457                   , input 3
     6458                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6459               ).
     6460               if p-trn-type = 'при':U
     6461               and buf_recipe.recipe-type <> 'разделка':U
     6462               and buf_recipe.recipe-type <> 'комплектация':U
     6463               then do:
     6464                   run writelog in this-procedure (
     6465                         input log-file-name
     6466                       , input 3
     6467                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     6468                   ).
     6469                   next search-recipe-gds.
     6470               end.
     6471               if p-trn-type = 'спи':U
     6472               and buf_recipe.recipe-type = 'разделка':U
     6473               then do:
     6474                   run writelog in this-procedure (
     6475                         input log-file-name
     6476                       , input 3
     6477                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     6478                   ).
     6479                   next search-recipe-gds.
     6480               end.
     6481               if v-recipe-type = ?
     6482               then do:
     6483                   assign
     6484                       p-out-recipe-type   = buf_recipe.recipe-type
     6485                       p-out-recipe-code   = buf_recipe.recipe-code
     6486                       v-recipe-type       = "recipe-gds"
     6487                       v-is-integration    = no
     6488                   .
     6489                   if v-value-logical
     6490                   then do:
     6491                       leave search-recipe-gds.
     6492                   end.
     6493               end.
     6494               else do:
     6495                   assign
     6496                       p-out-recipe-type = ?
     6497                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     6498                       v-is-integration  = ?
     6499                   .
     6500               end.
     6501           end.
     6502       end.
     6503       if p-out-recipe-type = ?
     6504       and p-out-recipe-code = ?
     6505       then do:
     6506           assign
     6507               p-recipe-found = no
     6508           .
     6509       end.
     6510       else do:
     6511           if p-out-recipe-type = ?
     6512           then do:
     6513               define variable v-recipe-recid-list as character     no-undo.
     6514               run str/rcp-sel.w (
     6515                     input p-mainmenu-handle
     6516                   , input buf_goods.gds-code
     6517                   , input 'при':U
     6518                   , output p-out-recipe-code
     6519                   , output v-is-integration
     6520                   , output v-cancel
     6521               ) .
     6522               if v-cancel = yes
     6523               then do:
     6524                   assign
     6525                       p-recipe-found = no
     6526                       p-no-need-good = yes
     6527                   .
     6528                   return.
     6529               end.
     6530           end.
     6531           assign
     6532               p-recipe-found = yes
     6533           .
     6534           find first buf_recipe no-lock
     6535                where buf_recipe.recipe-code = p-out-recipe-code
     6536           .
     6537           find first buf_goods no-lock
     6538                where buf_goods.artic      = buf_recipe.artic
     6539                  and buf_goods.prod-type  = buf_recipe.prod-type
     6540                  and buf_goods.prod-code  = buf_recipe.prod-code
     6541           .
     6542           assign
     6543               p-out-recipe-type   = buf_recipe.recipe-type
     6544               p-out-gds-code      = buf_goods.gds-code
     6545           .
     6546           run fbrlib-get-trn-type in this-procedure (
     6547                 input buf_recipe.recipe-code
     6548               , input recid( buf_goods )
     6549               , input v-is-integration
     6550               , output v-is-comp
     6551               , output p-out-trn-type
     6552           ).
     6553           run writelog in this-procedure (
     6554                 input log-file-name
     6555               , input 1
     6556               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     6557                                   , p-out-recipe-code
     6558                                   , v-is-comp
     6559                                   , buf_goods.artic
     6560                                   , buf_goods.gds-name
     6561                                   , p-out-trn-type )
     6562           ).
     6563           if p-out-gds-code <> p-gds-code
     6564           then do:
     6565               run writelog in this-procedure (
     6566                     input log-file-name
     6567                   , input 1
     6568                   , input "Необходимый товар является ингредиентом"
     6569               ).
     6570               find first buf_goods no-lock
     6571                    where buf_goods.gds-code = p-gds-code
     6572               .
     6573               find first buf_recipe-gds no-lock
     6574                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     6575                      and buf_recipe-gds.artic       = buf_goods.artic
     6576                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6577                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6578               .
     6579               if buf_recipe-gds.brutto-qnty = ?
     6580               or buf_recipe-gds.brutto-qnty = 0
     6581               then do:
     6582                   message
     6583                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     6584                       skip "Продолжение расчета документа невозможно."
     6585                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     6586                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     6587                   view-as alert-box error.
     6588                   undo, return error .
     6589               end.
     6590               assign
     6591                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     6592                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     6593               .
     6594               run writelog in this-procedure (
     6595                   input log-file-name
     6596                   , input 1
     6597                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     6598                                       , p-gds-qnty
     6599                                       , p-out-gds-qnty
     6600                                       , p-out-recipe-code
     6601                                       , p-out-trn-type )
     6602               ).
     6603           end.
     6604           else do:
     6605               assign
     6606                   p-out-gds-qnty = p-gds-qnty
     6607                   p-out-trn-type = p-trn-type
     6608               .
     6609               run writelog in this-procedure (
     6610                     input log-file-name
     6611                   , input 1
     6612                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     6613                                       , p-out-gds-qnty
     6614                                       , p-out-recipe-code
     6615                                       , p-out-trn-type )
     6616               ).
     6617           end.
     6618       end.
     6619   end.
     6620   END PROCEDURE.
     6621   define variable vss-include-info51 as character format "X(65)" no-undo
     6622   initial "@(#)$Workfile$ $Revision$".
     6623   define temp-table temp_fbr-history no-undo like ub.fbr-history .
     6624   define variable v-fbrhist-history-level     as integer      no-undo.
     6625   define variable v-fbrhist-upper-obj-type    as character    no-undo.
     6626   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
     6627   define variable v-fbrhist-upper-code        as integer      no-undo.
     6628   define variable v-fbrhist-current-obj-type  as character    no-undo.
     6629   define variable v-fbrhist-current-obj-code  as integer      no-undo.
     6630   define variable v-fbrhist-current-code      as integer      no-undo.
     6631   define variable v-fbrhist-saved-obj-type    as character    no-undo.
     6632   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
     6633   define variable v-fbrhist-saved-code        as integer      no-undo.
     6634   procedure fbrhist-write :
     6635   define input parameter p-userid                 as character        no-undo.
     6636   define input parameter p-obj-type               as character        no-undo.
     6637   define input parameter p-obj-code               as integer          no-undo.
     6638   define input parameter p-hst-type               as character        no-undo.
     6639   define input parameter p-hst-level              as integer          no-undo.
     6640   define input parameter p-procedure-name         as character        no-undo.
     6641   define input parameter p-procedure-parameters   as character        no-undo.
     6642   define input parameter p-doc-code               as character        no-undo.
     6643   define input parameter p-doc-type               as character        no-undo.
     6644   define input parameter p-status_                as character        no-undo.
     6645   define input parameter p-is-free                as logical          no-undo.
     6646   define input parameter p-recipe-code            as character        no-undo.
     6647   define input parameter p-recipe-type            as character        no-undo.
     6648   define input parameter p-gds-code               as integer          no-undo.
     6649   define input parameter p-trn-type               as character        no-undo.
     6650   define input parameter p-qnty                   as decimal          no-undo.
     6651   define input parameter p-PS                     as character        no-undo.
     6652   define input parameter p-is-error               as logical          no-undo.
     6653       define variable v-today                         as date         no-undo.
     6654       define variable v-obj-date                      as date         no-undo.
     6655       define variable v-time                          as integer      no-undo.
     6656       define variable v-host-code                     as integer      no-undo.
     6657       define variable v-db-num                        as integer      no-undo.
     6658       define buffer buf_temp_fbr-history       for temp_fbr-history.
     6659       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
     6660   do
     6661   for buf_temp_fbr-history
     6662     , buf_upper_temp_fbr-history
     6663   on error undo, return error
     6664   :
     6665       if v-fbrhist-history-level = 0
     6666       or v-fbrhist-history-level < p-hst-level
     6667       then do:
     6668           undo, return .
     6669       end.
     6670       if v-fbrhist-upper-code <> 0
     6671       then do:
     6672           find first buf_upper_temp_fbr-history no-lock
     6673                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
     6674                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
     6675                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
     6676           no-error.
     6677       end.
     6678   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6680     (input  p-obj-type
     6681     ,input  p-obj-code
     6682     ,output v-obj-date
     6683     )  .
     6684       run cur-time in this-procedure (
     6685             output v-today
     6686           , output v-time
     6687       ).
     6688   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6690     (input  p-obj-type
     6691     ,input  p-obj-code
     6692     ,output v-host-code
     6693     )  .
     6694   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     6696     (output v-db-num
     6697     )  .
     6698       create buf_temp_fbr-history.
     6699       assign
     6700           buf_temp_fbr-history.obj-type                = p-obj-type
     6701           buf_temp_fbr-history.obj-code                = p-obj-code
     6702           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
     6703           buf_temp_fbr-history.hst-type                = p-hst-type
     6704           buf_temp_fbr-history.hst-level               = p-hst-level
     6705           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
     6706           buf_temp_fbr-history.procedure-name          = p-procedure-name
     6707           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
     6708           buf_temp_fbr-history.doc-code                = p-doc-code
     6709           buf_temp_fbr-history.doc-type                = p-doc-type
     6710           buf_temp_fbr-history.status_                 = p-status_
     6711           buf_temp_fbr-history.is-free                 = p-is-free
     6712           buf_temp_fbr-history.recipe-code             = p-recipe-code
     6713           buf_temp_fbr-history.recipe-type             = p-recipe-type
     6714           buf_temp_fbr-history.gds-code                = p-gds-code
     6715           buf_temp_fbr-history.trn-type                = p-trn-type
     6716           buf_temp_fbr-history.qnty                    = p-qnty
     6717           buf_temp_fbr-history.PS                      = p-ps
     6718           buf_temp_fbr-history.is-error                = p-is-error
     6719           buf_temp_fbr-history.db-num                  = v-db-num
     6720           buf_temp_fbr-history.user-name               = p-userid
     6721           buf_temp_fbr-history.sys-date                = v-today
     6722           buf_temp_fbr-history.sys-time-int            = v-time
     6723           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
     6724           buf_temp_fbr-history.obj-date                = v-obj-date
     6725           buf_temp_fbr-history.host-code               = v-host-code
     6726       .
     6727       assign
     6728           v-fbrhist-current-obj-type                   = p-obj-type
     6729           v-fbrhist-current-obj-code                   = p-obj-code
     6730           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
     6731       .
     6732       if available buf_upper_temp_fbr-history
     6733       then do:
     6734           assign
     6735               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
     6736                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
     6737                                               + "-":U + string( buf_temp_fbr-history.obj-code )
     6738                                               + "-":U + string( buf_temp_fbr-history.hst-code )
     6739           .
     6740       end.
     6741       else do:
     6742           assign
     6743               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
     6744                                  + "-":U + string( buf_temp_fbr-history.obj-code )
     6745                                  + "-":U + string( buf_temp_fbr-history.hst-code )
     6746           .
     6747       end.
     6748   end.
     6749   end procedure.
     6750   procedure fbrhist-read-conf :
     6751   do
     6752   on error undo, return error
     6753   :
     6754      define variable v-value-character as character  no-undo .
     6755      define variable v-value-date      as date       no-undo .
     6756      define variable v-value-decimal   as decimal    no-undo .
     6757      define variable v-value-logical   as logical    no-undo .
     6758      define variable v-tth             as handle     no-undo .
     6759      define variable v-param-type            as character no-undo .
     6760      run adm/shattri.p ( input "get":U
     6761                        , input  '':u
     6762                        , input  0
     6763                        , input  'fbrattr':U
     6764                        , input  'fbrhstlv':U
     6765                        , output v-value-character
     6766                        , output v-value-date
     6767                        , output v-value-decimal
     6768                        , output v-fbrhist-history-level
     6769                        , output v-value-logical
     6770                        , output v-param-type
     6771                        , input-output table-handle v-tth
     6772                        ) no-error .
     6773      if error-status :error then do:
     6774         assign
     6775            v-fbrhist-history-level = 0
     6776         .
     6777      end.
     6778   end.
     6779   end procedure.
     6780   procedure fbrhist-table-to-base :
     6781       define buffer buf_fbr-history       for ub.fbr-history.
     6782       define buffer buf_temp_fbr-history  for temp_fbr-history.
     6783   do
     6784   for buf_fbr-history
     6785     , buf_temp_fbr-history
     6786   on error undo, return error
     6787   :
     6788       for each buf_temp_fbr-history
     6789       on error undo, return error
     6790       :
     6791           create buf_fbr-history.
     6792           buffer-copy buf_temp_fbr-history to buf_fbr-history.
     6793       end.
     6794   end.
     6795   end procedure.
     6796   procedure fbrhist-init :
     6797       define buffer buf_temp_fbr-history      for temp_fbr-history.
     6798   do
     6799   for buf_temp_fbr-history
     6800   on error undo, return error
     6801   :
     6802       for each buf_temp_fbr-history
     6803       :
     6804           delete buf_temp_fbr-history.
     6805       end.
     6806       assign
     6807           v-fbrhist-upper-obj-type    = ""
     6808           v-fbrhist-upper-obj-code    = 0
     6809           v-fbrhist-upper-code        = 0
     6810           v-fbrhist-current-obj-type  = ""
     6811           v-fbrhist-current-obj-code  = 0
     6812           v-fbrhist-current-code      = 0
     6813           v-fbrhist-saved-obj-type    = ""
     6814           v-fbrhist-saved-obj-code    = 0
     6815           v-fbrhist-saved-code        = 0
     6816       .
     6817   end.
     6818   end procedure.
     6819   procedure fbrhist-set-upper-code :
