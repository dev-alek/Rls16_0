     5191             otherwise do:
     5192               message
     5193                 vss-workfile vss-revision vss-description skip
     5194                 "Неизвестный тип рецепта производства" skip
     5195                 "Тип рецепта" buf_fbr-recipe.recipe-type skip
     5196                 "Документ производства" buf_fbr-recipe.doc-code skip
     5197                 "Код рецепта" buf_fbr-recipe.recipe-code skip
