     5040                            where buf_start_temp_goods-qnty.calculated = no
     5041                       no-error.
     5042                       next calc-not-calculated-goods.
     5043                   end.
     5044                   else do:
     5045                       message
     5046                           "Неверно выбран рецепт для товара."
     5047                       view-as alert-box information.
     5048                       undo, return error .
     5049                   end.
     5050               end.
     5051               else do:
