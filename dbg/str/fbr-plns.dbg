     5053                         input buf_fbr-doc.doc-code
     5054                       , input buf_obj_recipe.recipe-code
     5055                       , input buf_fbr-doc.doc-date
     5056                       , input buf_fbr-doc.obj-type
     5057                       , input buf_fbr-doc.obj-code
     5058                   ).
