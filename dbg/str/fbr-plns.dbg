     5206                   skip(1) "Обратитесь к администратору."
     5207                   skip(1) return-value
     5208               view-as alert-box information.
     5209               run clear-temp-tables in this-procedure .
     5210               undo, return error.
     5211           end.
     5212           find first buf_fbr-line no-lock
     5213                where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     5214                  and buf_fbr-line.is-comp     = yes
     5215                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5216           no-error.
     5217           if available buf_fbr-line
     5218           then do:
     5219               define buffer buf_change_fbr-line      for ub.fbr-line.
     5220               run writelog in this-procedure ( log-file-name, 3, "В документе уже есть выбранный рецепт." ).
     5221               if buf_start_temp_goods-qnty.need-qnty = ?
     5222               and v-is-manual-input = yes
     5223               then do:
     5224                   define variable v-old-fact-qnty  as decimal       no-undo.
     5225                   define variable v-old-price-sale as decimal       no-undo.
     5226                   assign
     5227                       v-old-fact-qnty  = buf_fbr-line.fact-qnty
     5228                       v-old-price-sale = buf_fbr-line.price-sale
     5229                   .
     5230                   run str/fbr-line.w (
     5231                         input p-fbrhist-handle
     5232                       , input buf_fbr-doc.status_
     5233                       , input p-fbr-doc-doc-code
     5234                       , input recid( buf_fbr-line )
     5235                       , input ?
     5236                       , output v-cancel
     5237                   ).
     5238                   if error-status :error
     5239                   or v-cancel = yes
     5240                   then do:
     5241                       find first buf_change_fbr-line exclusive-lock
     5242                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5243                              and buf_change_fbr-line.is-comp     = yes
     5244                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5245                       .
     5246                       message
     5247                                vss-workfile vss-revision vss-description
     5248                           skip "Ошибка изменения строки."
     5249                           skip return-value
     5250                           skip trim(error-status :get-message(1))
     5251                                trim(error-status :get-message(2))
     5252                                trim(error-status :get-message(3))
     5253                           skip buf_change_fbr-line.fact-qnty
     5254                       view-as alert-box error.
     5255                       assign
     5256                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5257                           buf_change_fbr-line.price-sale = v-old-price-sale
     5258                       .
     5259                       run clear-temp-tables in this-procedure.
     5260                       return.
     5261                   end.
     5262                   if buf_fbr-line.fact-qnty <= v-old-fact-qnty
     5263                   then do:
     5264                       define variable v-gds-name    as character    no-undo.
     5265   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     5267     (input  buf_fbr-line.artic
     5268     ,input  buf_fbr-line.prod-type
     5269     ,input  buf_fbr-line.prod-code
     5270     ,output v-gds-name
     5271     )  .
     5272                       message
