     6863   procedure proc-alt-shift-f2:
     6864     if not ibs.th.gbl.gbl-var:rcode
     6865   then
     6866     run gbl\inidebug.p .
     6867   end.
     6868   procedure proc-alt-shift-f3:
     6869     run gbl/prvssinf.p
     6870       ( input this-procedure
     6871       ) .
     6872   end.
     6873   define variable v-inform-launched as logical no-undo initial false .
     6874   procedure proc-alt-shift-f4:
     6875     define variable v-action as character no-undo .
     6876     if v-inform-launched = false then do:
     6877       assign
     6878         v-inform-launched = true
     6879       .
     6880       run gbl/d-inform.w
     6881         (  input self
     6882         ,  input this-procedure
     6883         , output v-action
     6884         ) no-error .
     6885       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     6886       assign
     6887         v-inform-launched = false
     6888       .
     6889     end.
     6890   end.
     6891   procedure proc-alt-f1:
     6892     run gbl/corrhelp.p
     6893       (input this-procedure
     6894       ) .
     6895   end .
     6896   on alt-shift-f2 anywhere do:
     6897     run proc-alt-shift-f2.
     6898   end.
     6899   on alt-shift-f3 anywhere do:
     6900     run proc-alt-shift-f3 in this-procedure .
     6901   end.
     6902   on alt-shift-f4 anywhere do:
     6903     run proc-alt-shift-f4 in this-procedure.
     6904   end.
     6905   on alt-f1 anywhere do:
     6906     run proc-alt-f1 in this-procedure .
     6907   end.
     6908   define variable v-fbr-plns-history-level    as integer      no-undo.
     6909   define variable v-fbr-plns-hst-upper-code   as integer      no-undo.
     6910   define buffer buf_init_fbr-pln       for fbr-pln.
     6911   DEFINE BUTTON b-add
     6912        LABEL "&Добавить"
     6913        SIZE 10 BY 1.
     6914   DEFINE BUTTON b-chg
     6915        LABEL "&Изменить"
     6916        SIZE 10 BY 1.
     6917   DEFINE BUTTON b-close
     6918        LABEL "&Закрыть"
     6919        SIZE 10 BY 1.
     6920   DEFINE BUTTON b-del
     6921        LABEL "&Удалить"
     6922        SIZE 10 BY 1.
     6923   DEFINE BUTTON b-exit
     6924        LABEL "&Выход"
     6925        SIZE 10 BY 1
     6926        BGCOLOR 8 .
     6927   DEFINE BUTTON b-help
     6928        LABEL "Помощ&ь"
     6929        SIZE 10 BY 1
     6930        BGCOLOR 8 .
     6931   DEFINE BUTTON b-history
     6932        LABEL "И&стория"
     6933        SIZE 10 BY 1.
     6934   DEFINE BUTTON b-lkp
     6935        LABEL "&Просмотр"
     6936        SIZE 10 BY 1.
     6937   DEFINE BUTTON b-open
     6938        LABEL "&Открыть"
     6939        SIZE 10 BY 1.
     6940   DEFINE BUTTON b-print
     6941        LABEL "Пе&чать"
     6942        SIZE 10 BY 1.
     6943   DEFINE BUTTON b-sel
     6944        LABEL "*"
     6945        SIZE 3 BY 1.
     6946   DEFINE BUTTON b-select
     6947        LABEL "В&ыбор"
     6948        SIZE 10 BY 1.
     6949   DEFINE VARIABLE EDITOR-1 AS CHARACTER
     6950        VIEW-AS EDITOR
     6951        SIZE 96.88 BY 2.21 NO-UNDO.
     6952   DEFINE QUERY br-table FOR
     6953         buf_init_fbr-pln SCROLLING.
     6954   DEFINE BROWSE br-table
     6955     QUERY br-table NO-LOCK DISPLAY
     6956         buf_init_fbr-pln.status_
     6957         buf_init_fbr-pln.doc-code
     6958         substring( string( buf_init_fbr-pln.doc-date ), 1, 5 ) COLUMN-LABEL "Дата" FORMAT "X(5)"
     6959         buf_init_fbr-pln.fact-date
     6960         buf_init_fbr-pln.obj-type + string( buf_init_fbr-pln.obj-code ) COLUMN-LABEL "Объект" FORMAT "X(8)"
     6961         buf_init_fbr-pln.creid COLUMN-LABEL "Оператор" FORMAT "X(15)"
     6962         buf_init_fbr-pln.customer COLUMN-LABEL "Заказчик" FORMAT "X(33)"
     6963       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 17.38.
     6964   DEFINE FRAME Dialog-Frame
     6965        b-exit AT ROW 1.17 COL 1.63
     6966        b-sel AT ROW 1.17 COL 11.63
     6967        b-select AT ROW 1.17 COL 14.63
     6968        b-help AT ROW 1.17 COL 88.63
     6969        b-add AT ROW 2.5 COL 1.63
     6970        b-lkp AT ROW 2.5 COL 11.63
     6971        b-chg AT ROW 2.5 COL 21.63
     6972        b-del AT ROW 2.5 COL 31.63
     6973        b-close AT ROW 2.5 COL 41.63
     6974        b-open AT ROW 2.5 COL 51.63
     6975        b-history AT ROW 2.5 COL 78.63
     6976        b-print AT ROW 2.5 COL 88.63
     6977        br-table AT ROW 3.67 COL 1.63
     6978        EDITOR-1 AT ROW 21.17 COL 1.63 NO-LABEL
     6979        SPACE(0.46) SKIP(0.15)
     6980       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6981            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6982            TITLE "Список План-меню".
     6983   ASSIGN
     6984          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     6985          FRAME Dialog-Frame:HIDDEN           = TRUE.
     6986   ASSIGN
     6987          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     6988   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     6989   DO:
     6990     APPLY "END-ERROR":U TO SELF.
     6991   END.
     6992   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     6993   DO:
     6994       define variable v-have-rights    as logical        no-undo.
     6995   define variable vss-include-info55 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6996   do:
     6997     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6998       (input  v-cntxt-db-num
     6999       ,input  v-cntxt-userid
     7000       ,input  0
     7001       ,input  'actn_res-pln-menu_update':U
     7002       ,input  'firm':U
     7003       ,input  v-cntxt-host-code-obj
     7004       ,input  '':U
     7005       ,input  0
     7006       ,input  0
     7007       ,input  0
     7008       ,input  0
     7009       ,input  yes
     7010       ,output v-have-rights
     7011       )  .
     7012   end.
     7013       if v-have-rights = yes
     7014       then do:
     7015           run add-doc in this-procedure.
     7016           run local-open-query in this-procedure .
     7017       end.
     7018   END.
     7019   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     7020   DO:
     7021       define variable v-have-rights    as logical        no-undo.
     7022   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7023   do:
     7024     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7025       (input  v-cntxt-db-num
