     1289   define variable vss-include-info11 as character format "X(65)" no-undo
     1290   initial "@(#)$Workfile$ $Revision$".
     1291   procedure fbrpln-create-line :
     1292   define input parameter p-doc-code       as character    no-undo.
     1293   define input parameter p-gds-code       as integer      no-undo.
     1294   define input parameter p-recipe-code    as character    no-undo.
     1295   define input parameter p-fbr-obj-type   as character    no-undo.
     1296   define input parameter p-fbr-obj-code   as integer      no-undo.
     1297   define input parameter p-silence        as logical      no-undo.
     1298   define input parameter p-qnty           as decimal      no-undo.
     1299       define buffer buf_fbr-pln       for fbr-pln.
     1300       define buffer buf_fbr-pln-line  for fbr-pln-line.
     1301       define buffer buf_goods         for goods.
     1302   do
     1303   for buf_fbr-pln
     1304     , buf_fbr-pln-line
     1305     , buf_goods
     1306   on error undo, return error
     1307   :
     1308       find first buf_fbr-pln no-lock
     1309            where buf_fbr-pln.doc-code = p-doc-code
     1310       .
     1311       if buf_fbr-pln.status_ <> 'новый':U
     1312       then do:
     1313           if p-silence = no
     1314           then do:
     1315               message
     1316                   skip "Добавить строки можно только"
     1317                   skip "в документ в статусе 'новый'"
     1318               view-as alert-box error.
     1319           end.
     1320           undo, return error .
     1321       end.
     1322       find first buf_goods no-lock
     1323            where buf_goods.gds-code = p-gds-code
     1324       .
     1325       if p-recipe-code <> ""
     1326       and p-fbr-obj-type = ""
     1327       and p-fbr-obj-code = 0
     1328       then do:
     1329           if p-silence = no
     1330           then do:
     1331               message
     1332                   skip "Не задан объект для производства товара с рецептом."
     1333                   skip "Товар: " buf_goods.artic buf_goods.gds-name
     1334                   skip(1)
     1335                   skip "Товар не может быть включен в план-меню."
     1336               view-as alert-box error.
     1337           end.
     1338           undo, return error .
     1339       end.
     1340       do transaction
     1341       on error undo, return error
     1342       :
     1343           create buf_fbr-pln-line.
     1344           assign
     1345               buf_fbr-pln-line.doc-code       = p-doc-code
     1346               buf_fbr-pln-line.gds-code       = p-gds-code
     1347               buf_fbr-pln-line.recipe-code    = p-recipe-code
     1348               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
     1349               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
     1350               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
     1351               buf_fbr-pln-line.fact-qnty      = p-qnty
     1352               buf_fbr-pln-line.artic          = buf_goods.artic
     1353               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
     1354               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
     1355               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
     1356               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
     1357               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
     1358           .
     1359       end.
     1360   end.
     1361   end procedure.
     1362   procedure fbrpln-create-doc :
     1363   define input parameter p-obj-type   as character    no-undo.
     1364   define input parameter p-obj-code   as integer      no-undo.
     1365   define input parameter p-doc-type   as character    no-undo.
     1366   define input parameter p-db-remote  as logical          no-undo.
     1367   define input parameter p-userid     as character        no-undo.
     1368   define output parameter p-doc-code  as character    no-undo.
     1369       define variable v-today     as date           no-undo.
     1370       define variable v-time      as integer        no-undo.
     1371       define variable v-host-code as integer        no-undo.
     1372       define variable v-doc-code  as character      no-undo.
     1373       define buffer buf_fbr-pln       for fbr-pln.
     1374   do
     1375   for buf_fbr-pln
     1376   on error undo, return error
     1377   :
     1378       run cur-time in this-procedure (
     1379             output v-today
     1380           , output v-time
     1381       ).
     1382   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1384     (input  p-obj-type
     1385     ,input  p-obj-code
     1386     ,output v-host-code
     1387     )  .
     1388       run fbrpln-doc-code (
     1389             input p-obj-type
     1390           , input p-obj-code
     1391           , input p-db-remote
     1392           , output v-doc-code
     1393       ).
     1394       create buf_fbr-pln.
     1395       assign
     1396           buf_fbr-pln.doc-code        = v-doc-code
     1397           buf_fbr-pln.doc-type        = p-doc-type
     1398           buf_fbr-pln.obj-type        = p-obj-type
     1399           buf_fbr-pln.obj-code        = p-obj-code
     1400           buf_fbr-pln.doc-date        = v-today
     1401           buf_fbr-pln.creid           = p-userid
     1402           buf_fbr-pln.PS              = ""
     1403           buf_fbr-pln.fact-date       = ?
     1404           buf_fbr-pln.fact-time       = ?
     1405           buf_fbr-pln.fact-num        = 0
     1406           buf_fbr-pln.fact-order      = 0
     1407           buf_fbr-pln.host-code       = v-host-code
     1408           buf_fbr-pln.status_         = 'новый':U
     1409           buf_fbr-pln.sys-date        = v-today
     1410           buf_fbr-pln.sys-time-int    = v-time
     1411           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
     1412           buf_fbr-pln.user-name       = p-userid
     1413       .
     1414       assign
     1415           p-doc-code = buf_fbr-pln.doc-code
     1416       .
     1417   end.
     1418   end procedure.
     1419   procedure fbrpln-create-fbr-doc :
     1420   define input parameter p-obj-type       as character        no-undo.
     1421   define input parameter p-obj-code       as integer          no-undo.
     1422   define input parameter p-pln-doc-code   as character        no-undo.
     1423   define input parameter p-db-remote      as logical          no-undo.
     1424   define input parameter p-userid         as character        no-undo.
     1425   define output parameter p-doc-code      as character        no-undo.
     1426       define variable v-today         as date             no-undo.
     1427       define variable v-host-code     as integer          no-undo.
     1428       define variable v-base-code     as integer          no-undo.
     1429       define buffer buf_curr-accnt    for curr-accnt.
     1430       define buffer buf_fbr-doc       for fbr-doc.
     1431       define buffer buf_fbr-pln       for fbr-pln.
     1432   do
     1433   for buf_curr-accnt
     1434     , buf_fbr-doc
     1435     , buf_fbr-pln
     1436   on error undo, return error
     1437   :
     1438   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1440     (input  p-obj-type
     1441     ,input  p-obj-code
     1442     ,output v-today
     1443     )  .
     1444   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1446     (input  p-obj-type
     1447     ,input  p-obj-code
     1448     ,output v-host-code
     1449     )  .
     1450   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1451   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1452     (input  v-host-code
     1453     ,output v-base-code
     1454     )  .
     1455       find last buf_curr-accnt no-lock
     1456           where buf_curr-accnt.curr-code = v-base-code
     1457             and buf_curr-accnt.exch-date <= v-today
     1458       use-index pi
     1459       no-error.
     1460       if not available buf_curr-accnt
     1461       then do:
     1462           message
     1463               "На дату" v-today "неизвестен курс базовой валюты."
     1464           view-as alert-box error.
     1465           undo, return error.
     1466       end.
     1467       run doc-code in this-procedure (
     1468             input  "main"
     1469           , input  p-obj-type
     1470           , input  p-obj-code
     1471           , input  ?
     1472           , output p-doc-code
     1473       ) no-error.
     1474       if error-status:error
     1475       then do:
     1476           message
     1477               "Ошибка при генерации номера документа производства."
     1478               skip return-value
     1479               skip trim(error-status :get-message(1))
     1480                       trim(error-status :get-message(2))
     1481                       trim(error-status :get-message(3))
     1482           view-as alert-box error.
     1483           return error.
     1484       end.
     1485       run trg/chkdocnm.p (
     1486             input p-doc-code
     1487           , input "fbr-doc"
     1488           , input "?"
     1489       ) no-error.
     1490       if error-status:error
     1491       then do:
     1492           message
     1493                       vss-workfile vss-revision vss-description
     1494               skip "Ошибка при проверке номера для нового документа."
     1495               skip return-value
     1496               skip trim(error-status :get-message(1))
     1497                       trim(error-status :get-message(2))
     1498                       trim(error-status :get-message(3))
     1499           view-as alert-box error.
     1500           undo, return error .
     1501       end.
     1502       create buf_fbr-doc.
     1503       assign
     1504           buf_fbr-doc.doc-code  = p-doc-code
     1505           buf_fbr-doc.creid     = p-userid
     1506           buf_fbr-doc.doc-date  = v-today
     1507           buf_fbr-doc.doc-type  = 'производство':U
     1508           buf_fbr-doc.host-code = v-host-code
     1509           buf_fbr-doc.obj-type  = p-obj-type
     1510           buf_fbr-doc.obj-code  = p-obj-code
     1511           buf_fbr-doc.PS        = "@"
     1512           buf_fbr-doc.status_   = 'новый':U
     1513           buf_fbr-doc.out-code  = p-pln-doc-code
     1514       .
     1515   end.
     1516   end procedure.
     1517   procedure fbrpln-doc-code :
     1518   define input parameter p-obj-type   as character    no-undo.
     1519   define input parameter p-obj-code   as integer      no-undo.
     1520   define input parameter p-db-remote  as logical      no-undo.
     1521   define output parameter p-doc-code  as character    no-undo.
     1522   do
     1523   on error undo, return error
     1524   :
     1525       if p-db-remote = yes
     1526       then do:
     1527           assign
     1528               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
     1529                           + "-"
     1530                           + trim( string( p-obj-code, ">>>>9" ) )
     1531                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1532           .
     1533       end.
     1534       else do:
     1535           assign
     1536               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
     1537           .
     1538       end.
     1539   end.
     1540   end procedure.
