        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: set-prsp.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: str/set-prsp.p $":U .
        7   def var vss-description as character no-undo init "Установка специальной цены продаже по партиям".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   function cross-list returns logical (
       69     input parfirst-stream  as character,
       70     input parsecond-stream as character,
       71     input pardelim         as character).
       72     if pardelim = ""
       73     or pardelim = ?
       74     then do:
       75       assign
       76         pardelim = ","
       77       .
       78     end.
       79     define variable vari            as integer no-undo .
       80     define variable varresult-cross as logical no-undo .
       81     assign
       82       varresult-cross = no
       83     .
       84     def var v-num-parfirst-stream as integer no-undo .
       85     assign
       86       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
       87     .
       88     do vari = 1 to v-num-parfirst-stream
       89     :
       90       if lookup(entry(vari, parfirst-stream, pardelim)
       91                ,parsecond-stream
       92                ,pardelim
       93                ) > 0 then do:
       94         assign
       95           varresult-cross = yes
       96         .
       97         leave.
       98       end.
       99     end.
      100     return varresult-cross .
      101   end function.
      102   define input  parameter pardoc-code          like trn-doc.doc-code      no-undo.
      103   define input  parameter parobj-type          like trn-doc.obj-type      no-undo.
      104   define input  parameter parobj-code          like trn-doc.obj-code      no-undo.
      105   define input  parameter parartic             like doc-line.artic        no-undo.
      106   define input  parameter parprod-type         like doc-line.prod-type    no-undo.
      107   define input  parameter parprod-code         like doc-line.prod-code    no-undo.
      108   define output parameter parsaleparts         as   logical               no-undo.
      109   define output parameter parsp-sum-price-sale like price-list.price-sale no-undo.
      110   define output parameter parsp-sum-road-tax   like price-list.road-tax   no-undo.
      111   define output parameter parsp-sum-excise     like price-list.excise     no-undo.
      112   define output parameter parsp-prc-price-sale like price-list.price-sale no-undo.
      113   define output parameter parsp-prc-road-tax   like price-list.road-tax   no-undo.
      114   define output parameter parsp-prc-excise     like price-list.excise     no-undo.
      115   define variable         vardoc-num           like price-list.doc-num    no-undo.
      116   define variable         varprice-sale        like price-list.price-sale no-undo.
      117   define variable         varroad-tax          like price-list.road-tax   no-undo.
      118   define variable         varexcise            like price-list.excise     no-undo.
      119   define variable         varparts-b-code      like bar-code.b-code       no-undo.
      120   define variable         varfact-qnty         like parts.fact-qnty       no-undo.
      121   find first goods where goods.artic     = parartic     and
      122                          goods.prod-type = parprod-type and
      123                          goods.prod-code = parprod-code no-lock.
      124   find first units where units.unit-name = goods.unit-base no-lock.
      125   if cross-list(units.type, 'прп':U, ",") then do:
      126      for each parts where parts.out-code  = pardoc-code  and
      127                           parts.obj-type  = parobj-type  and
      128                           parts.obj-code  = parobj-code  and
      129                           parts.artic     = parartic     and
      130                           parts.prod-type = parprod-type and
      131                           parts.prod-code = parprod-code no-lock :
      132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
      133     (buffer parts
      134     ,output varparts-b-code
      135     ) no-error .
      136          if error-status:error then do:
      137             return error "Не найдена бар-код партии "                    +
      138                          " Документ "          + string(parts.out-code)  +
      139                          " Тип объекта "       + string(parts.obj-type)  +
      140                          " Код объекта "       + string(parts.obj-code)  +
      141                          " Артикул "           + string(parts.artic)     +
      142                          " Тип производителя " + string(parts.prod-type) +
      143                          " Код производителя " + string(parts.prod-code) +
      144                          " Код партии "        + string(parts.part-code) +
      145                          " Прих.накл "         + string(parts.in-code)   .
      146          end.
      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      149     (input  parts.obj-type
      150     ,input  parts.obj-code
      151     ,input  varparts-b-code
      152     ,input  0
      153     ,input  0
      154     ,output vardoc-num
      155     ,output varprice-sale
      156     ,output varroad-tax
      157     ,output varexcise
      158     ) no-error .
      159         if varprice-sale = ? then
      160            return error "Не найдена цена товара на партию "       +
      161                         " Документ "          + string(parts.out-code)  +
      162                         " Тип объекта "       + string(parts.obj-type)  +
      163                         " Код объекта "       + string(parts.obj-code)  +
      164                         " Артикул "           + string(parts.artic)     +
      165                         " Тип производителя " + string(parts.prod-type) +
      166                         " Код производителя " + string(parts.prod-code) +
      167                         " Бар-код "           + string(varparts-b-code) +
      168                         " Код партии "        + string(parts.part-code) +
      169                         " Прих.накл "         + string(parts.in-code).
      170         assign parsp-sum-price-sale = parsp-sum-price-sale + varprice-sale * parts.fact-qnty
      171                parsp-sum-road-tax   = parsp-sum-road-tax   + varroad-tax   * parts.fact-qnty
      172                parsp-sum-excise     = parsp-sum-excise     + varexcise     * parts.fact-qnty
      173                varfact-qnty         = varfact-qnty         +                 parts.fact-qnty.
      174      end.
      175      assign
      176      parsp-prc-price-sale = parsp-sum-price-sale / varfact-qnty
      177      parsp-prc-road-tax   = parsp-sum-road-tax   / varfact-qnty
      178      parsp-prc-excise     = parsp-sum-excise     / varfact-qnty.
      179   end.
      180   else assign parsaleparts = no.
