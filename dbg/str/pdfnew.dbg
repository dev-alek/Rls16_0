     1946         view-as alert-box question
     1947         buttons yes-no
     1948         update v-ok as logical.
     1949       if v-ok then do:
     1950          repeat i = 1 to nn :
     1951             v-recid = int(entry( i , p-rec-list )) .
     1952             find first del_price-doc-forming no-lock where
     1953                  recid(del_price-doc-forming) = v-recid no-error .
     1954                  if available del_price-doc-forming then do:
     1955                     find first del_price-list-type no-lock where
     1956                                del_price-list-type.plt-id = del_price-doc-forming.plt-id and
     1957                                del_price-list-type.plt-db-num = del_price-doc-forming.plt-db-num
     1958                                no-error .
     1959                       if  del_price-list-type.main = true  and
     1960                           del_price-doc-forming.stts = integer('3':U)   then do:
     1961                             message substitute("Удалять ДНЦ &1 нельзя !" , del_price-doc-forming.pdf-id) view-as alert-box information .
     1962                           end.
     1963                           else do:
     1964                           run price-doc-forming-delete (
     1965                               del_price-doc-forming.plt-db-num ,
     1966                               del_price-doc-forming.plt-id     ,
     1967                               del_price-doc-forming.pdf-db     ,
     1968                               del_price-doc-forming.pdf-id     ,
     1969                               v-cntxt-db-num                   ,
     1970                               v-cntxt-userid                   )
     1971                               no-error .
     1972                       end.
     1973                  end.
     1974          end.
     1975       end.
     1976    end.
     1977    p-rec-list = "" .
     1978    if error-status :error then return no-apply .
     1979    run openbr in this-procedure .
     1980   END.
