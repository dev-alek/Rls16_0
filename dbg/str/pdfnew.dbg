     2134   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2135   on help of frame Dialog-Frame
     2136   do:
     2137     run gbl/app_help.p
     2138       (input this-procedure :file-name
     2139       ,input ''
     2140       ,input ?
     2141       ) no-error.
     2142     if error-status :error then do:
     2143       message
     2144         "Ошибка при вызове помощи"
     2145         error-status :get-message(1)
     2146         view-as alert-box .
     2147     end.
     2148   end.
     2149   run minbtn-set in this-procedure .
     2150   on choose of b-help in frame Dialog-Frame
     2151   do:
     2152     apply "help":u to frame Dialog-Frame .
     2153   end.
     2154   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2155   procedure minbtn-set :
     2156       do
     2157           on error undo, return error return-value
     2158           :
     2159           define variable ii              as integer       no-undo .
     2160           define variable fh              as widget-handle no-undo .
     2161           define variable hh              as widget-handle no-undo .
     2162           define variable v-h             as handle        extent 4 no-undo .
     2163           define variable v-name-button   as character     no-undo .
     2164           define variable v-help-old-x    as decimal       no-undo .
     2165           define variable v-help-old-y    as decimal       no-undo .
     2166           define variable v-help-old-size as decimal       no-undo .
     2167           define variable v-frame-width   as decimal       no-undo .
     2168           define variable jj              as integer       no-undo .
     2169           do
     2170               on error undo, return error
     2171               :
     2172               assign
     2173                   v-frame-width = frame Dialog-Frame:width - 0.3
     2174                   fh            = frame Dialog-Frame:first-child
     2175                   hh            = fh:first-child
     2176                   ii            = 1
     2177                   .
     2178               do while valid-handle(hh):
     2179                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2180                   do:
     2181                       case lc(hh:name) :
     2182                           when "b-help" then
     2183                               do:
     2184                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2185                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2186                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2187                                   hh:TOOLTIP = "Помощь" .
     2188                                   v-help-old-x = hh:column .
     2189                                   v-help-old-y = hh:row    .
     2190                                   v-help-old-size = hh:width .
     2191                                   hh:width-chars = 2.5 .
     2192                               end.
     2193                           when "b-print" then
     2194                               do:
     2195                                   hh:load-image("cmp/b-print.bmp":u) .
     2196                                   hh:TOOLTIP = "Печать" .
     2197                                   v-h[ii] = hh:handle .
     2198                                   ii = ii + 1 .
     2199                                   hh:width-chars = 3 .
     2200                               end.
     2201                           when "b-history" or
     2202                           when "b-hist" then
     2203                               do:
     2204                                   hh:load-image("cmp/b-hist.bmp":u) .
     2205                                   hh:TOOLTIP = "История" .
     2206                                   v-h[ii] = hh:handle .
     2207                                   ii = ii + 1 .
     2208                                   hh:width-chars = 3 .
     2209                               end.
     2210                           when "b-sch" then
     2211                               do:
     2212                                   hh:load-image("cmp/b-sch.bmp":u) .
     2213                                   hh:TOOLTIP = "Установка Фильтра" .
     2214                                   v-h[ii] = hh:handle .
     2215                                   ii = ii + 1 .
     2216                                   hh:width-chars = 3 .
     2217                               end.
     2218                           when "b-hist-user" then
     2219                               do:
     2220                                   hh:load-image("cmp/b-hist.bmp":u) .
     2221                                   hh:TOOLTIP = "История пользователя" .
     2222                                   ii = ii + 1 .
     2223                               end.
     2224                       end case.
     2225                   end.
     2226                   hh = hh:next-sibling.
     2227               end.
     2228               b-help:column = v-frame-width - b-help:width-chars.
     2229               jj = 0.
     2230               repeat ii = 4 to 1 by -1 :
     2231                   if valid-handle (v-h[ii] ) then
     2232                   do:
     2233                       jj  = jj + 1 .
     2234                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2235                       v-h[ii]:row    = v-help-old-y .
     2236                   end.
     2237               end.
     2238           end.
     2239       end.
     2240   end procedure.
     2241   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
