     1441   define variable v-rec-list-cli as character no-undo .
     1442   define variable g-log          as logical   no-undo .
     1443   define variable br-handle      as handle no-undo.
     1444   define variable buffer-handle  as handle no-undo.
     1445   define variable next-prev      as logical no-undo .
     1446   define variable v-rec-list     as character no-undo .
     1447   define variable ref-rec        as recid no-undo.
     1448   define variable loc_gop-db-num as integer no-undo.
     1449   define variable loc_gop-id     as integer no-undo.
     1450   define variable var-paket      as logical   no-undo init false .
     1451   function mark-string returns character
     1452     ( buffer loc-table for ub.price-doc-forming, input mark-list as character  ) :
     1453     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
     1454   end function.
     1455   function stts-string returns character
     1456     ( buffer loc-table for ub.price-doc-forming   ) :
     1457    case loc-table.stts :
     1458       when 0 then return 'новый':U .
     1459       when 1 then return 'удал':U .
     1460       when 3 then return 'факт':U .
     1461    end case.
     1462   end function.
     1463   function activ-pr returns character
     1464     ( buffer loc-table for ub.price-doc-forming  ) :
     1465   define buffer buf_price-all for ub.price-all  .
     1466   define buffer buf2_price-all for ub.price-all  .
     1467     find first buf_price-all no-lock where
     1468                buf_price-all.pdf-db = loc-table.pdf-db  and
     1469                buf_price-all.pdf-id = loc-table.pdf-id  and
     1470                buf_price-all.plt-db-num = loc-table.plt-db-num and
     1471                buf_price-all.plt-id     = loc-table.plt-id and
     1472                buf_price-all.status_    = 'акт':U
     1473                no-error .
     1474      if available buf_price-all then do:
     1475               find first buf2_price-all no-lock where
     1476                         buf2_price-all.pdf-db = loc-table.pdf-db  and
     1477                         buf2_price-all.pdf-id = loc-table.pdf-id  and
     1478                         buf2_price-all.plt-db-num = loc-table.plt-db-num and
     1479                         buf2_price-all.plt-id     = loc-table.plt-id and
     1480                         buf2_price-all.status_    <> 'акт':U
     1481                         no-error .
     1482                if available buf2_price-all then return "не все" .
     1483                else return "все +" .
     1484         end.
     1485      else do:
     1486         return "".
     1487      end.
     1488   end function.
     1489   DEFINE QUERY external_tables FOR buf_price-list-type.
     1490   DEFINE BUTTON B-add
     1491        LABEL "Добавить"
     1492        SIZE 10 BY 1 TOOLTIP "Добавить новый ДНЦ"
     1493        BGCOLOR 8 .
     1494   DEFINE BUTTON B-Cancel AUTO-END-KEY
     1495        LABEL "Выход"
     1496        SIZE 10 BY 1 TOOLTIP "Выход из режима"
     1497        BGCOLOR 8 .
     1498   DEFINE BUTTON B-chg
     1499        LABEL "Изменить"
     1500        SIZE 10 BY 1 TOOLTIP "Изменение ДНЦ"
     1501        BGCOLOR 8 .
     1502   DEFINE BUTTON B-close
     1503        LABEL "Закрыть"
     1504        SIZE 10 BY 1 TOOLTIP "Закрыть ДНЦ"
     1505        BGCOLOR 8 .
     1506   DEFINE BUTTON B-del
     1507        LABEL "Удалить"
     1508        SIZE 10 BY 1 TOOLTIP "Удалить ДНЦ"
     1509        BGCOLOR 8 .
     1510   DEFINE BUTTON B-Help
     1511        LABEL "Помо&щь"
     1512        SIZE 3 BY 1
     1513        BGCOLOR 8 .
     1514   DEFINE BUTTON B-history
     1515        LABEL "История"
     1516        SIZE 3 BY 1 TOOLTIP "История изменения документа"
     1517        BGCOLOR 8 .
     1518   DEFINE BUTTON B-lkp
     1519        LABEL "Просмотр"
     1520        SIZE 10 BY 1 TOOLTIP "Просмотр ДНЦ"
     1521        BGCOLOR 8 .
     1522   DEFINE BUTTON B-mark
     1523        LABEL "*"
     1524        SIZE 3.25 BY 1 TOOLTIP "Отметить строки"
     1525        BGCOLOR 8 .
     1526   DEFINE BUTTON B-print
     1527        LABEL "Печать"
     1528        SIZE 3 BY 1 TOOLTIP "Печать ДНЦ"
     1529        BGCOLOR 8 .
     1530   DEFINE BUTTON B-sel AUTO-GO
     1531        LABEL "Выбор"
     1532        SIZE 10 BY 1 TOOLTIP "Выбрать ДНЦ"
     1533        BGCOLOR 8 .
     1534   DEFINE VARIABLE FILL-IN-6 AS CHARACTER FORMAT "X(256)":U INITIAL "№ ДНЦ:"
     1535         VIEW-AS TEXT
     1536        SIZE 6 BY .67
     1537        FGCOLOR 4  NO-UNDO.
     1538   DEFINE VARIABLE loc-pdf-id AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1539        VIEW-AS FILL-IN
     1540        SIZE 14 BY 1 TOOLTIP "Поиск по коду документа НЦ" NO-UNDO.
     1541   DEFINE VARIABLE v-user-name AS CHARACTER FORMAT "X(256)":U
     1542        LABEL "Опер"
     1543         VIEW-AS TEXT
     1544        SIZE 20 BY .67 TOOLTIP "Кто изменял"
     1545        FGCOLOR 4  NO-UNDO.
     1546   DEFINE VARIABLE T-paket AS LOGICAL INITIAL no
     1547        LABEL "пакетный режим"
     1548        VIEW-AS TOGGLE-BOX
     1549        SIZE 17 BY .83 NO-UNDO.
     1550   DEFINE QUERY BROWSE-1grp FOR
     1551         buf_price-doc-forming,
     1552         buf_price-list-type,
     1553         x_grp-obj-price SCROLLING.
     1554   DEFINE BROWSE BROWSE-1grp
     1555     QUERY BROWSE-1grp NO-LOCK DISPLAY
     1556         mark-string ( buffer buf_price-doc-forming, p-rec-list ) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1557         stts-string ( buffer buf_price-doc-forming )             COLUMN-LABEL "Ста-!тус" FORMAT "x(4)":U
     1558         buf_price-doc-forming.pdf-id   COLUMN-LABEL "Код ДНЦ! " FORMAT ">>>>>>>>>9":U
     1559         buf_price-doc-forming.sys-date         COLUMN-LABEL "Дата!изм"  FORMAT "99/99/99":U
     1560         buf_price-doc-forming.sys-time-chr     COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1561         buf_price-doc-forming.name   COLUMN-LABEL "Название документа! " FORMAT "X(100)":U WIDTH 30
     1562         buf_price-list-type.plt-id   COLUMN-LABEL "Код!типа" FORMAT ">>>>>9":U
     1563         buf_price-list-type.main     COLUMN-LABEL "Г! " FORMAT "+/ ":U
     1564         buf_price-list-type.name               COLUMN-LABEL "Тип прайс-листа! " FORMAT "X(100)":U WIDTH 30
     1565         buf_price-doc-forming.db-num-chg       COLUMN-LABEL "БД!изм"    FORMAT ">>>>9":U
     1566         buf_price-doc-forming.pdf-db           COLUMN-LABEL "БД!док" FORMAT ">>>>9":U
     1567         buf_price-list-type.plt-db-num         COLUMN-LABEL "БД!ТПЛ" FORMAT ">>>>9":U
     1568         buf_price-doc-forming.out-code         COLUMN-LABEL "№!накл" FORMAT "X(16)":U
     1569     ENABLE
     1570         buf_price-doc-forming.name
     1571       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.63 BY 18.5 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1572   DEFINE FRAME Dialog-Frame
     1573        B-Cancel AT ROW 1 COL 1
     1574        B-mark AT ROW 1 COL 11
     1575        B-sel AT ROW 1 COL 14.25
     1576        B-add AT ROW 1 COL 24.25
     1577        B-lkp AT ROW 1 COL 34.25
     1578        B-chg AT ROW 1 COL 44.25
     1579        B-del AT ROW 1 COL 54.25
     1580        B-close AT ROW 1 COL 64.25
     1581        B-history AT ROW 1 COL 89.5
     1582        B-Help AT ROW 1 COL 93
     1583        B-print AT ROW 1 COL 96.5
     1584        loc-pdf-id AT ROW 2 COL 15.5 COLON-ALIGNED NO-LABEL
     1585        T-paket AT ROW 2 COL 82.5 WIDGET-ID 4
     1586        BROWSE-1grp AT ROW 3.25 COL 1.38
     1587        FILL-IN-6 AT ROW 2.21 COL 11 NO-LABEL
     1588        v-user-name AT ROW 22 COL 77 COLON-ALIGNED WIDGET-ID 2
     1589        SPACE(1.38) SKIP(0.46)
     1590       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1591            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1592            TITLE "Список ДНЦ по ГПЛ (для ПЕРЕОЦЕНОК)"
     1593            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
     1594   ASSIGN
     1595          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1596          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1597   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1598   DO:
     1599     APPLY "END-ERROR":U TO SELF.
     1600   END.
     1601   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1602   DO:
     1603      define variable g#log as logical   no-undo .
     1604   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   do:
     1606     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1607       (input  v-cntxt-db-num
     1608       ,input  v-cntxt-userid
     1609       ,input  0
     1610       ,input  'actn_pdf_update':U
     1611       ,input  'global':U
     1612       ,input  v-cntxt-host-code-obj
     1613       ,input  v-cntxt-obj-type
     1614       ,input  v-cntxt-obj-code
     1615       ,input  0
     1616       ,input  0
     1617       ,input  0
     1618       ,input  true
     1619       ,output g#log
     1620       )  .
     1621   end.
     1622     if not g#log then return .
     1623     define variable v-rec-id as recid no-undo .
     1624     define variable v-recid as character no-undo .
     1625     define buffer buf1_price-list-type for ub.price-list-type  .
     1626     define variable v-only-main as logical   no-undo .
     1627     define variable v-plt-id     as integer   no-undo .
     1628     define variable v-plt-db-num as integer   no-undo .
     1629     next-prev = false .
     1630   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstmain in g#library
     1632     (output v-only-main
     1633     )  .
     1634   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1636     (input  parParentProc
     1637     ,input  v-cntxt-obj-type
     1638     ,input  v-cntxt-obj-code
     1639     ,input  no
     1640     ,output v-plt-id
     1641     ,output v-plt-db-num
     1642     ) no-error .
     1643        find first buf1_price-list-type no-lock where
     1644                   buf1_price-list-type.plt-id = v-plt-id and
     1645                   buf1_price-list-type.plt-db-num = v-plt-db-num
     1646                   no-error .
     1647     if available buf1_price-list-type then do:
     1648         if buf1_price-list-type.stts <> integer('0':U) then do:
     1649            message "ДНЦ можно создать только с текущим типом прайс-листов !" view-as alert-box information  .
     1650            return .
     1651         end.
     1652         if buf1_price-list-type.under-type-list <> 0 then do:
     1653            message "Нельзя выбирать подчиненный прайс-лист !" view-as alert-box information  .
     1654            return .
     1655         end.
     1656         if buf1_price-list-type.gop-id = 0 then do:
     1657            message "Этот тип прайс-листа действует на ВСЕ объекты системы ."
     1658                    "Вы действительно хотите создать одинаковые цены на ВСЕХ объектах ? " view-as alert-box question
     1659                    buttons yes-no
     1660                    update v-okk as logical
     1661                    .
     1662            if v-okk = false then return .
     1663         end.
     1664         run str/df-price.w
     1665           ( input parparentproc,
     1666             input 'ДОБАВЛЕНИЕ':U ,
     1667             input buf1_price-list-type.plt-id,
     1668             input buf1_price-list-type.plt-db-num ,
     1669             input ? ,
     1670             output v-rec-list ,
     1671             input-output v-rec-id ,
     1672             input-output br-handle ,
     1673             input-output buffer-handle ,
     1674             input-output next-prev
     1675             ) .
     1676         run openbr in this-procedure .
     1677         reposition BROWSE-1grp to recid v-rec-id no-error .
     1678         apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1679       end.
     1680       else do:
     1681         message "Не выбран ТПЛ !!!" view-as alert-box .
     1682         return no-apply .
     1683       end.
     1684   END.
     1685   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1686   DO:
     1687      define variable g#log as logical   no-undo .
     1688   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   do:
     1690     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1691       (input  v-cntxt-db-num
     1692       ,input  v-cntxt-userid
     1693       ,input  0
     1694       ,input  'actn_pdf_update':U
     1695       ,input  'global':U
     1696       ,input  v-cntxt-host-code-obj
     1697       ,input  v-cntxt-obj-type
     1698       ,input  v-cntxt-obj-code
     1699       ,input  0
     1700       ,input  0
     1701       ,input  0
     1702       ,input  true
     1703       ,output g#log
     1704       )  .
     1705   end.
     1706     if not g#log then return .
     1707     next-prev = false .
     1708     if not available buf_price-doc-forming then return .
     1709     if buf_price-doc-forming.stts <> integer('0':U) then do:
     1710      message "Закрытые или удаленные ДНЦ корректировать нельзя! "
     1711            view-as alert-box information .
     1712      return .
     1713      end.
     1714     define variable v-rec-id as recid no-undo .
     1715     define variable v-recid as character no-undo .
     1716     if available buf_price-doc-forming then do:
     1717         v-rec-id = recid (buf_price-doc-forming) .
     1718         run str/df-price.w
     1719         ( input parparentproc,
     1720           input 'ИЗМЕНЕНИЕ':U ,
     1721           input buf_price-doc-forming.plt-id,
     1722           input buf_price-doc-forming.plt-db-num ,
     1723           input ? ,
     1724           output v-rec-list ,
     1725           input-output v-rec-id ,
     1726           input-output br-handle ,
     1727           input-output buffer-handle ,
     1728           input-output next-prev
     1729           ) .
     1730         run openbr in this-procedure .
     1731         reposition BROWSE-1grp to recid v-rec-id no-error .
     1732         apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1733       end.
     1734   END.
     1735   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     1736   DO:
     1737      define variable g#log as logical   no-undo .
     1738   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   do:
     1740     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1741       (input  v-cntxt-db-num
     1742       ,input  v-cntxt-userid
     1743       ,input  0
     1744       ,input  'actn_pdf_close':U
     1745       ,input  'global':U
     1746       ,input  v-cntxt-host-code-obj
     1747       ,input  v-cntxt-obj-type
     1748       ,input  v-cntxt-obj-code
     1749       ,input  0
     1750       ,input  0
     1751       ,input  0
     1752       ,input  true
     1753       ,output g#log
     1754       )  .
     1755   end.
     1756     if not g#log then return .
     1757   define variable v-rec-id as recid no-undo .
     1758   define variable v-mode as character no-undo .
     1759   define variable v-ask-pr as logical   no-undo .
     1760    if var-paket = false then do:
     1761     if not available buf_price-doc-forming then return .
     1762     if buf_price-doc-forming.stts <> integer('0':U) then do:
     1763      message "Закрытые или удаленные ДНЦ закрывать нельзя! "
     1764               view-as alert-box information .
     1765      return .
     1766      end.
     1767     v-rec-id = recid(buf_price-doc-forming) .
     1768     if buf_price-list-type.main = true  then do:
     1769        run str/pdf-cask.w ( input parparentproc , input recid( buf_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     1770        if v-mode = "" or  v-ask-pr = ? then return no-apply.
     1771     end.
     1772     else do:
     1773     message "Закрывать ДНЦ" buf_price-doc-forming.pdf-id "?"
     1774         view-as alert-box question
     1775         buttons yes-no
     1776         update var-ok as logical
     1777         .
     1778     if var-ok =  false then return .
     1779     end.
     1780       run str/diallog.w
     1781           (parparentproc
     1782           , this-procedure
     1783           , 'str/pdf-clos.p':U
     1784           , ( string(v-rec-id) + chr(4) +
     1785              'no' + chr(4) +
     1786              'no' + chr(4) +
     1787              '?' + chr(4) +
     1788              '?' + chr(4) +
     1789              string(v-mode) + chr(4) +
     1790              '?' + chr(4) +
     1791              string(v-ask-pr)  )
     1792           , yes
     1793           , '':U
     1794           , 'Закрытие ДНЦ') no-error .
     1795       if error-status :error then
     1796       message
     1797         error-status :get-message(1) skip
     1798         return-value skip
     1799         "Ошибка закрытия ДНЦ"
     1800         view-as alert-box error
     1801       .
     1802     end.
     1803     else do:
     1804         define variable nn as integer   no-undo .
     1805         define variable v-recid as recid no-undo .
     1806         define buffer cl_price-doc-forming for ub.price-doc-forming  .
     1807         define buffer cl_price-list-type for ub.price-list-type  .
     1808         define variable i as integer   no-undo .
     1809         nn = num-entries(p-rec-list) .
     1810             if nn = 0 then do:
     1811                 message "Не выбрано ни одной строки для закрытия! "  view-as alert-box information .
     1812                 return .
     1813             end.
     1814             message substitute("Закрыть &1 отмеченных ДНЦ ?  " , nn)
     1815               view-as alert-box question
     1816               buttons yes-no
     1817               update v-ok as logical.
     1818             if v-ok then do:
     1819               repeat i = 1 to nn :
     1820                   v-recid = int(entry( i , p-rec-list )) .
     1821                   find first cl_price-doc-forming no-lock where
     1822                       recid(cl_price-doc-forming) = v-recid no-error .
     1823                       if available cl_price-doc-forming then do:
     1824                           find first cl_price-list-type no-lock where
     1825                                     cl_price-list-type.plt-id = cl_price-doc-forming.plt-id and
     1826                                     cl_price-list-type.plt-db-num = cl_price-doc-forming.plt-db-num
     1827                                     no-error .
     1828                                if cl_price-doc-forming.stts <> integer('0':U)   then do:
     1829                                   message substitute("ДНЦ &1 закрыть уже нельзя !" , cl_price-doc-forming.pdf-id) view-as alert-box information .
     1830                                 end.
     1831                                 else do:
     1832                                     if cl_price-list-type.main = true  then do:
     1833                                         if v-mode = "" or  v-ask-pr = ? then
     1834                                         run str/pdf-cask.w ( input parparentproc , input recid(cl_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     1835                                             if v-mode = "" or  v-ask-pr = ? then do:
     1836                                                 next.
     1837                                             end.
     1838                                     end.
     1839                                       run str/diallog.w
     1840                                           (parparentproc
     1841                                           , this-procedure
     1842                                           , 'str/pdf-clos.p':U
     1843                                           , ( string(recid(cl_price-doc-forming )) + chr(4) +
     1844                                             'no' + chr(4) +
     1845                                             'no' + chr(4) +
     1846                                             '?' + chr(4) +
     1847                                             '?' + chr(4) +
     1848                                             string(v-mode) + chr(4) +
     1849                                             '?' + chr(4) +
     1850                                             string(v-ask-pr)  )
     1851                                           , yes
     1852                                           , '':U
     1853                                           , 'Закрытие ДНЦ') no-error .
     1854                             end.
     1855                       end.
     1856               end.
     1857             end.
     1858     end.
     1859     run openbr in this-procedure .
     1860     reposition BROWSE-1grp to recid v-rec-id no-error .
     1861     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1862   END.
     1863   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1864   DO:
     1865   if not available buf_price-doc-forming then return .
     1866      define variable g#log as logical   no-undo .
