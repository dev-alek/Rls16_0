     2260   define temp-table temp-browse-handle no-undo
     2261     field browse-type   as character
     2262     field browse-number as integer
     2263     field browse-handle as handle
     2264     field original-size as decimal
     2265     index xpk is primary unique browse-type browse-number
     2266     index xie browse-type browse-handle
     2267   .
     2268   procedure diasize_change-height :
     2269     define input  parameter p-change-value  as decimal   no-undo .
     2270     define input  parameter p-move-resize   as logical   no-undo .
     2271     define variable v-field-group-handle    as handle    no-undo .
     2272     define variable v-object-handle         as handle    no-undo .
     2273     define variable v-frame-height          as decimal   no-undo .
     2274     define variable v-frame-virtual-height  as decimal   no-undo .
     2275     define variable v-browse-height         as decimal   no-undo .
     2276     define variable v-window-height         as decimal   no-undo .
     2277     define variable v-window-virtual-height as decimal   no-undo .
     2278     define variable v-change-sign           as integer   no-undo .
     2279     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2280     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2281     if p-change-value > 0
     2282     then do:
     2283       if frame Dialog-Frame :height + p-change-value
     2284           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2285       then do:
     2286         assign
     2287           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2288                           - (frame Dialog-Frame :height-chars)
     2289         .
     2290         if p-change-value <= 0
     2291         then do:
     2292           run diasize_position-resize-button in this-procedure .
     2293           return .
     2294         end.
     2295       end.
     2296     end.
     2297     if p-change-value < 0
     2298     then do:
     2299       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2300       then do:
     2301         assign
     2302           p-change-value = v-diasize-orig-frame-height
     2303                          - (frame Dialog-Frame :height-chars)
     2304         .
     2305         if p-change-value >= 0
     2306         then do:
     2307           run diasize_position-resize-button in this-procedure .
     2308           return .
     2309         end.
     2310       end.
     2311     end.
     2312     if p-change-value >= 0
     2313     then do:
     2314       assign
     2315         v-change-sign = 1
     2316       .
     2317     end.
     2318     else do:
     2319       assign
     2320         v-change-sign = -1
     2321       .
     2322     end.
     2323     assign
     2324       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2325     .
     2326     if p-change-value = 0
     2327     then do:
     2328       run diasize_position-resize-button in this-procedure .
     2329       return .
     2330     end.
     2331     move_block:
     2332     do
     2333     on error undo move_block, retry move_block
     2334     :
     2335       if retry
     2336       then do:
     2337         do
     2338         on error undo move_block, leave move_block
     2339         :
     2340           if p-change-value > 0
     2341           then do:
     2342             for each buf_temp-diasize-handle
     2343             on error undo, next
     2344             :
     2345               assign
     2346                 v-object-handle = buf_temp-diasize-handle.handle-value
     2347               .
     2348               if v-object-handle <> v-diasize-resize-button
     2349               then do:
     2350                 assign
     2351                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2352                 .
     2353               end.
     2354             end.
     2355             assign
     2356               v-diasize-browse-handle :height = v-browse-height
     2357             .
     2358             for each buf_temp-browse-handle
     2359               where buf_temp-browse-handle.browse-type = 'height':u
     2360             on error undo, next
     2361             :
     2362               assign
     2363                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2364               .
     2365             end.
     2366             assign
     2367               frame Dialog-Frame :height = v-frame-height
     2368             .
     2369             if frame Dialog-Frame :scrollable = true
     2370             then do:
     2371               assign
     2372                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2373               .
     2374             end.
     2375             run diasize_position-resize-button in this-procedure .
     2376           end.
     2377           else do:
     2378             if frame Dialog-Frame :scrollable = true
     2379             then do:
     2380               assign
     2381                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2382               .
     2383             end.
     2384             assign
     2385               frame Dialog-Frame :height = v-frame-height
     2386             .
     2387             assign
     2388               v-diasize-browse-handle :height = v-browse-height
     2389             .
     2390             for each buf_temp-browse-handle
     2391               where buf_temp-browse-handle.browse-type = 'height':u
     2392             on error undo, next
     2393             :
     2394               assign
     2395                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2396               .
     2397             end.
     2398             for each buf_temp-diasize-handle
     2399             on error undo, next
     2400             :
     2401               assign
     2402                 v-object-handle = buf_temp-diasize-handle.handle-value
     2403               .
     2404               if v-object-handle <> v-diasize-resize-button
     2405               then do:
     2406                 assign
     2407                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2408                 .
     2409               end.
     2410             end.
     2411             run diasize_position-resize-button in this-procedure .
     2412           end.
     2413           assign
     2414             v-diasize-change-size = false
     2415           .
     2416           leave move_block .
     2417         end.
     2418       end.
     2419       assign
     2420         v-diasize-need-full-display = true
     2421       .
     2422       if v-diasize-change-size = false
     2423       then do:
     2424         assign
     2425           v-diasize-change-size = true
     2426         .
     2427       end.
     2428       else do:
     2429         return .
     2430       end.
     2431       assign
     2432         v-frame-height = frame Dialog-Frame :height
     2433         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2434         v-browse-height = v-diasize-browse-handle :height
     2435       .
     2436       for each buf_temp-browse-handle
     2437         where buf_temp-browse-handle.browse-type = 'height':u
     2438       :
     2439         assign
     2440           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2441         .
     2442       end.
     2443       for each buf_temp-diasize-handle
     2444       :
     2445         delete buf_temp-diasize-handle .
     2446       end.
     2447       assign
     2448         v-field-group-handle = frame Dialog-Frame :first-child
     2449       .
     2450       do while valid-handle(v-field-group-handle)
     2451       :
     2452         assign
     2453           v-object-handle = v-field-group-handle :first-child
     2454         .
     2455         do while valid-handle(v-object-handle)
     2456         :
     2457           if  v-object-handle <> v-diasize-browse-handle :handle
     2458           and can-query(v-object-handle, "row")
     2459           and can-query(v-object-handle, "height")
     2460           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2461           then do:
     2462             find first buf_temp-browse-handle
     2463               where buf_temp-browse-handle.browse-type   = 'height':u
     2464                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2465               no-error .
     2466             if available buf_temp-browse-handle
     2467             then do:
     2468             end.
     2469             else do:
     2470               create buf_temp-diasize-handle .
     2471               assign
     2472                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2473                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2474               .
     2475             end.
     2476           end.
     2477           assign
     2478             v-object-handle = v-object-handle :next-sibling
     2479           .
     2480         end.
     2481         assign
     2482           v-field-group-handle = v-field-group-handle :next-sibling
     2483         .
     2484       end.
     2485       do with frame Dialog-Frame
     2486       :
     2487         hide v-diasize-resize-button .
     2488         assign
     2489           v-diasize-resize-button :row    = 1
     2490           v-diasize-resize-button :column = 1
     2491         .
     2492       end.
     2493       if p-change-value > 0
     2494       then do:
     2495         if frame Dialog-Frame :scrollable = true
     2496         then do:
     2497           assign
     2498             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2499             no-error .
     2500           if error-status :error
     2501           or error-status :get-message(1) <> ""
     2502           then do:
     2503             undo move_block, retry move_block .
     2504           end.
     2505         end.
     2506         assign
     2507           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2508           no-error .
     2509         if error-status :error
     2510         or error-status :get-message(1) <> ""
     2511         then do:
     2512           undo move_block, retry move_block .
     2513         end.
     2514         assign
     2515           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2516           no-error .
     2517         if error-status :error
     2518         or error-status :get-message(1) <> ""
     2519         then do:
     2520           undo move_block, retry move_block .
     2521         end.
     2522         for each buf_temp-browse-handle
     2523           where buf_temp-browse-handle.browse-type = 'height':u
     2524         on error undo move_block, retry move_block
     2525         :
     2526           assign
     2527             buf_temp-browse-handle.browse-handle :height
     2528               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2529             no-error .
     2530           if error-status :error
     2531           or error-status :get-message(1) <> ""
     2532           then do:
     2533             undo move_block, retry move_block .
     2534           end.
     2535         end.
     2536         for each buf_temp-diasize-handle
     2537         on error undo move_block, retry move_block
     2538         :
     2539           assign
     2540             v-object-handle = buf_temp-diasize-handle.handle-value
     2541           .
     2542           if v-object-handle <> v-diasize-resize-button
     2543           then do:
     2544             assign
     2545               v-object-handle :row = v-object-handle :row + p-change-value
     2546               no-error .
     2547             if error-status :error
     2548             or error-status :get-message(1) <> ""
     2549             then do:
     2550               undo move_block, retry move_block .
     2551             end.
     2552           end.
     2553         end.
     2554       end.
     2555       else do:
     2556         for each buf_temp-diasize-handle
     2557         on error undo move_block, retry move_block
     2558         :
     2559           assign
     2560             v-object-handle = buf_temp-diasize-handle.handle-value
     2561           .
     2562           if v-object-handle <> v-diasize-resize-button
     2563           then do:
     2564             assign
     2565               v-object-handle :row = v-object-handle :row + p-change-value
     2566               no-error .
     2567             if error-status :error
     2568             or error-status :get-message(1) <> ""
     2569             then do:
     2570               undo move_block, retry move_block .
     2571             end.
     2572           end.
     2573         end.
     2574         assign
     2575           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2576           no-error .
     2577         if error-status :error
     2578         or error-status :get-message(1) <> ""
     2579         then do:
     2580           undo move_block, retry move_block .
     2581         end.
     2582         for each buf_temp-browse-handle
     2583           where buf_temp-browse-handle.browse-type = 'height':u
     2584         on error undo move_block, retry move_block
     2585         :
     2586           assign
     2587             buf_temp-browse-handle.browse-handle :height
     2588               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2589             no-error .
     2590           if error-status :error
     2591           or error-status :get-message(1) <> ""
     2592           then do:
     2593             undo move_block, retry move_block .
     2594           end.
     2595         end.
     2596         assign
     2597           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2598           no-error .
     2599         if error-status :error
     2600         or error-status :get-message(1) <> ""
     2601         then do:
     2602           undo move_block, retry move_block .
     2603         end.
     2604         if frame Dialog-Frame :scrollable = true
     2605         then do:
     2606           assign
     2607             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2608             no-error .
     2609           if error-status :error
     2610           or error-status :get-message(1) <> ""
     2611           then do:
     2612             undo move_block, retry move_block .
     2613           end.
     2614         end.
     2615       end.
     2616       if p-move-resize = true
     2617       then do:
     2618         run diasize_position-resize-button in this-procedure .
     2619       end.
     2620       if v-diasize-wndstore = true
     2621       then do:
     2622         if connected("ub") = true
     2623         then do:
     2624           define variable v-cntxt-db-num        as integer   no-undo .
     2625           define variable v-cntxt-userid        as character no-undo .
     2626           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2627                                             , OUTPUT v-cntxt-userid
     2628                                             ) .
     2629           run gbl/wndsizew.p
     2630             (input  v-cntxt-db-num
     2631             ,input  v-cntxt-userid
     2632             ,input  v-diasize-proc-name
     2633             ,input  'height':u
     2634             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2635             ) .
     2636         end.
     2637       end.
     2638     end.
     2639     assign
     2640       v-diasize-change-size = false
     2641     .
     2642   end procedure.
     2643   procedure diasize_set-height :
     2644     define input  parameter p-new-height  as decimal   no-undo .
     2645     define input  parameter p-move-resize as logical   no-undo .
     2646     do
     2647     on error undo, return error return-value
     2648     :
     2649       run diasize_change-height in this-procedure
     2650         (input  (p-new-height - frame Dialog-Frame :height)
     2651         ,input  p-move-resize
     2652         ) .
     2653     end.
     2654   end procedure.
     2655   procedure diasize_change-width :
     2656     define input  parameter p-change-value as decimal   no-undo .
     2657     define input  parameter p-move-resize  as logical   no-undo .
     2658     define variable v-field-group-handle   as handle    no-undo .
     2659     define variable v-object-handle        as handle    no-undo .
     2660     define variable v-frame-width          as decimal   no-undo .
     2661     define variable v-frame-virtual-width  as decimal   no-undo .
     2662     define variable v-browse-width         as decimal   no-undo .
     2663     define variable v-window-width         as decimal   no-undo .
     2664     define variable v-window-virtual-width as decimal   no-undo .
     2665     define variable v-change-sign          as integer   no-undo .
     2666     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2667     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2668     if p-change-value > 0
     2669     then do:
     2670       if frame Dialog-Frame :width + p-change-value >
     2671           session :width-chars
     2672       then do:
     2673         assign
     2674           p-change-value = session :width-chars - frame Dialog-Frame :width
     2675         .
     2676         if p-change-value <= 0
     2677         then do:
     2678           run diasize_position-resize-button in this-procedure .
     2679           return .
     2680         end.
     2681       end.
     2682     end.
     2683     if p-change-value < 0
     2684     then do:
     2685       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2686       then do:
     2687         assign
     2688           p-change-value = v-diasize-orig-frame-width
     2689                          - frame Dialog-Frame :width
     2690         .
     2691         if p-change-value >= 0
     2692         then do:
     2693           run diasize_position-resize-button in this-procedure .
     2694           return .
     2695         end.
     2696       end.
     2697     end.
     2698     if p-change-value >= 0
     2699     then do:
     2700       assign
     2701         v-change-sign = 1
     2702       .
     2703     end.
     2704     else do:
     2705       assign
     2706         v-change-sign = -1
     2707       .
     2708     end.
     2709     assign
     2710       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2711     .
     2712     if p-change-value = 0
     2713     then do:
     2714       run diasize_position-resize-button in this-procedure .
     2715       return .
     2716     end.
     2717     move_block:
     2718     do
     2719     on error undo move_block, leave move_block
     2720     :
     2721       if retry
     2722       then do:
     2723         do
     2724         on error undo move_block, leave move_block
     2725         :
     2726           if p-change-value > 0
     2727           then do:
     2728             for each buf_temp-diasize-handle
     2729             on error undo, next
     2730             :
     2731               assign
     2732                 v-object-handle = buf_temp-diasize-handle.handle-value
     2733               .
     2734               if v-object-handle <> v-diasize-resize-button
     2735               then do:
     2736                 assign
     2737                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2738                 .
     2739               end.
     2740             end.
     2741             assign
     2742               v-diasize-browse-handle :width = v-browse-width
     2743             .
     2744             for each buf_temp-browse-handle
     2745               where buf_temp-browse-handle.browse-type = 'width':u
     2746             on error undo, next
     2747             :
     2748               assign
     2749                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2750               .
     2751             end.
     2752             assign
     2753               frame Dialog-Frame :width = v-frame-width
     2754             .
     2755             if frame Dialog-Frame :scrollable = true
     2756             then do:
     2757               assign
     2758                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2759               .
     2760             end.
     2761             run diasize_position-resize-button in this-procedure .
     2762           end.
     2763           else do:
     2764             if frame Dialog-Frame :scrollable = true
     2765             then do:
     2766               assign
     2767                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2768               .
     2769             end.
     2770             assign
     2771               frame Dialog-Frame :width = v-frame-width
     2772             .
     2773             for each buf_temp-browse-handle
     2774               where buf_temp-browse-handle.browse-type = 'width':u
     2775             on error undo, next
     2776             :
     2777               assign
     2778                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2779               .
     2780             end.
     2781             assign
     2782               v-diasize-browse-handle :width = v-browse-width
     2783             .
     2784             for each buf_temp-diasize-handle
     2785             on error undo, next
     2786             :
     2787               assign
     2788                 v-object-handle = buf_temp-diasize-handle.handle-value
     2789               .
     2790               if v-object-handle <> v-diasize-resize-button
     2791               then do:
     2792                 assign
     2793                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2794                 .
     2795               end.
     2796             end.
     2797             run diasize_position-resize-button in this-procedure .
     2798           end.
     2799           assign
     2800             v-diasize-change-size = false
     2801           .
     2802           leave move_block .
     2803         end.
     2804       end.
     2805       assign
     2806         v-diasize-need-full-display = true
     2807       .
     2808       if v-diasize-change-size = false
     2809       then do:
     2810         assign
     2811           v-diasize-change-size = true
     2812         .
     2813       end.
     2814       else do:
     2815         return .
     2816       end.
     2817       assign
     2818         v-frame-width = frame Dialog-Frame :width
     2819         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2820         v-browse-width = v-diasize-browse-handle :width
     2821       .
     2822       for each buf_temp-browse-handle
     2823         where buf_temp-browse-handle.browse-type = 'width':u
     2824       :
     2825         assign
     2826           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2827         .
     2828       end.
     2829       for each buf_temp-diasize-handle
     2830       :
     2831         delete buf_temp-diasize-handle .
     2832       end.
     2833       assign
     2834         v-field-group-handle = frame Dialog-Frame :first-child
     2835       .
     2836       do while valid-handle(v-field-group-handle)
     2837       :
     2838         assign
     2839           v-object-handle = v-field-group-handle :first-child
     2840         .
     2841         do while valid-handle(v-object-handle)
     2842         :
     2843           if  v-object-handle <> v-diasize-browse-handle :handle
     2844           and v-object-handle <> v-diasize-resize-button
     2845           and can-query(v-object-handle, "row")
     2846           and can-query(v-object-handle, "height")
     2847           and ( v-object-handle :col + v-object-handle :width
     2848                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2849               )
     2850           then do:
     2851             find first buf_temp-browse-handle
     2852               where buf_temp-browse-handle.browse-type   = 'width':u
     2853                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2854               no-error .
     2855             if available buf_temp-browse-handle
     2856             then do:
     2857             end.
     2858             else do:
     2859               create buf_temp-diasize-handle .
     2860               assign
     2861                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2862                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2863               .
     2864             end.
     2865           end.
     2866           assign
     2867             v-object-handle = v-object-handle :next-sibling
     2868           .
     2869         end.
     2870         assign
     2871           v-field-group-handle = v-field-group-handle :next-sibling
     2872         .
     2873       end.
     2874       do with frame Dialog-Frame
     2875       :
     2876         hide v-diasize-resize-button .
     2877         v-diasize-resize-button :row = 1.
     2878         v-diasize-resize-button :column = 1.
     2879       end.
     2880       if p-change-value > 0
     2881       then do:
     2882         if frame Dialog-Frame :scrollable = true
     2883         then do:
     2884           assign
     2885             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2886             no-error .
     2887           if error-status :error
     2888           or error-status :get-message(1) <> ""
     2889           then do:
     2890             undo move_block, retry move_block.
     2891           end.
     2892         end.
     2893         assign
     2894           frame Dialog-Frame :width = v-frame-width + p-change-value
     2895           no-error .
     2896         if error-status :error
     2897         or error-status :get-message(1) <> ""
     2898         then do:
     2899           undo move_block, retry move_block.
     2900         end.
     2901         assign
     2902           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2903         no-error .
     2904         if error-status :error
     2905         or error-status :get-message(1) <> ""
     2906         then do:
     2907           undo move_block, retry move_block.
     2908         end.
     2909         for each buf_temp-browse-handle
     2910           where buf_temp-browse-handle.browse-type = 'width':u
     2911         on error undo move_block, retry move_block
     2912         :
     2913           assign
     2914             buf_temp-browse-handle.browse-handle :width
     2915               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2916             no-error .
     2917           if error-status :error
     2918           or error-status :get-message(1) <> ""
     2919           then do:
     2920             undo move_block, retry move_block .
     2921           end.
     2922         end.
     2923         for each buf_temp-diasize-handle
     2924         on error undo move_block, retry move_block
     2925         :
     2926           assign
     2927             v-object-handle = buf_temp-diasize-handle.handle-value
     2928           .
     2929           if v-object-handle <> v-diasize-resize-button
     2930           then do:
     2931             assign
     2932               v-object-handle :col = v-object-handle :col + p-change-value
     2933               no-error .
     2934             if error-status :error
     2935             or error-status :get-message(1) <> ""
     2936             then do:
     2937               undo move_block, retry move_block .
     2938             end.
     2939           end.
     2940         end.
     2941       end.
     2942       else do:
     2943         for each buf_temp-diasize-handle
     2944         on error undo move_block, retry move_block
     2945         :
     2946           assign
     2947             v-object-handle = buf_temp-diasize-handle.handle-value
     2948           .
     2949           if v-object-handle <> v-diasize-resize-button
     2950           then do:
     2951             assign
     2952               v-object-handle :col = v-object-handle :col + p-change-value
     2953               no-error .
     2954             if error-status :error
     2955             or error-status :get-message(1) <> ""
     2956             then do:
     2957               undo move_block, retry move_block .
     2958             end.
     2959           end.
     2960         end.
     2961         for each buf_temp-browse-handle
     2962           where buf_temp-browse-handle.browse-type = 'width':u
     2963         on error undo move_block, retry move_block
     2964         :
     2965           assign
     2966             buf_temp-browse-handle.browse-handle :width
     2967               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2968             no-error .
     2969           if error-status :error
     2970           or error-status :get-message(1) <> ""
     2971           then do:
     2972             undo move_block, retry move_block .
     2973           end.
     2974         end.
     2975         assign
     2976           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2977           no-error .
     2978         if error-status :error
     2979         or error-status :get-message(1) <> ""
     2980         then do:
     2981           undo move_block, retry move_block.
     2982         end.
     2983         assign
     2984           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2985         no-error .
     2986         if error-status :error
     2987         or error-status :get-message(1) <> ""
     2988         then do:
     2989           undo move_block, retry move_block.
     2990         end.
     2991         if frame Dialog-Frame :scrollable = true
     2992         then do:
     2993           assign
     2994             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2995           no-error .
     2996           if error-status :error
     2997           or error-status :get-message(1) <> ""
     2998           then do:
     2999             undo move_block, retry move_block.
     3000           end.
     3001         end.
     3002       end.
     3003       if p-move-resize
     3004       then do:
     3005         run diasize_position-resize-button in this-procedure .
     3006       end.
     3007       if v-diasize-wndstore = true
     3008       then do:
     3009         if connected("ub") = true
     3010         then do:
     3011           define variable v-cntxt-db-num        as integer   no-undo .
     3012           define variable v-cntxt-userid        as character no-undo .
     3013           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3014                                             , OUTPUT v-cntxt-userid
     3015                                             ) .
     3016           run gbl/wndsizew.p
     3017             (input  v-cntxt-db-num
     3018             ,input  v-cntxt-userid
     3019             ,input  v-diasize-proc-name
     3020             ,input  'width':u
     3021             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3022             ) .
     3023         end.
     3024       end.
     3025     end.
     3026     assign
     3027       v-diasize-change-size = false
     3028     .
     3029   end procedure.
     3030   procedure diasize_set-width :
     3031     define input  parameter p-new-width  as decimal   no-undo .
     3032     define input  parameter p-move-resize as logical   no-undo .
     3033     do
     3034     on error undo, return error return-value
     3035     :
     3036       run diasize_change-width in this-procedure
     3037         (input  (p-new-width - frame Dialog-Frame :width)
     3038         ,input  p-move-resize
     3039         ) .
     3040     end.
     3041   end procedure.
     3042   procedure diasize_position-resize-button :
     3043     do with frame Dialog-Frame
     3044     :
     3045       hide v-diasize-resize-button .
     3046       assign
     3047         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3048                     - 1
     3049                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3050         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3051                     - 1
     3052                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3053       .
     3054       view v-diasize-resize-button .
     3055     end.
     3056   end procedure.
     3057   on alt-right anywhere
     3058   do:
     3059     run diasize_change-width in this-procedure
     3060       (input 1
     3061       ,input true
     3062       ) .
     3063     return no-apply .
     3064   end.
     3065   on alt-left anywhere
     3066   do:
     3067     run diasize_change-width in this-procedure
     3068       (input -1
     3069       ,input true
     3070       ) .
     3071     return no-apply .
     3072   end.
     3073   on alt-down anywhere
     3074   do:
     3075     run diasize_change-height in this-procedure
     3076       (input 1
     3077       ,input true
     3078       ) .
     3079     return no-apply .
     3080   end.
     3081   on alt-up anywhere
     3082   do:
     3083     run diasize_change-height in this-procedure
     3084       (input -1
     3085       ,input true
     3086       ) .
     3087     return no-apply .
     3088   end.
     3089   on alt-enter of frame Dialog-Frame
     3090   do:
     3091     run diasize_maximize in this-procedure
     3092       (input  ?
     3093       ).
     3094     return no-apply .
     3095   end.
     3096   procedure diasize_end-move :
     3097     do
     3098     on error undo, return error return-value
     3099     :
     3100       define variable v-row-delta as decimal   no-undo .
     3101       define variable v-col-delta as decimal   no-undo .
     3102       define variable v-new-row as decimal   no-undo .
     3103       define variable v-new-col as decimal   no-undo .
     3104       assign
     3105         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3106         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3107       .
     3108       assign
     3109         v-row-delta = v-new-row - frame Dialog-Frame :height
     3110         v-col-delta = v-new-col - frame Dialog-Frame :width
     3111       .
     3112       run diasize_change-height in this-procedure
     3113         (input v-row-delta
     3114         ,input true
     3115         ) .
     3116       run diasize_change-width in this-procedure
     3117         (input v-col-delta
     3118         ,input true
     3119         ) .
     3120     end.
     3121   end procedure.
     3122   procedure diasize_maximize :
     3123     define input  parameter p-action as logical   no-undo .
     3124     do
     3125     on error undo, return error return-value
     3126     :
     3127       if p-action = ?
     3128       then do:
     3129         if v-diasize-need-maximize = true
     3130         then do:
     3131           assign
     3132             p-action = true
     3133           .
     3134         end.
     3135         else do:
     3136           assign
     3137             p-action = false
     3138           .
     3139         end.
     3140       end.
     3141       if p-action = true
     3142       then do:
     3143         run diasize_change-height in this-procedure
     3144           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3145               - frame Dialog-Frame :height-chars
     3146           ,input true
     3147           ) .
     3148         run diasize_change-width in this-procedure
     3149           (input session :width-chars
     3150               - frame Dialog-Frame :width-chars
     3151           ,input true
     3152           ) .
     3153         assign
     3154           v-diasize-need-maximize = false
     3155         .
     3156       end.
     3157       else do:
     3158         run diasize_change-width in this-procedure
     3159           (input v-diasize-orig-frame-width
     3160               - frame Dialog-Frame :width-chars
     3161           ,input true
     3162           ) .
     3163         run diasize_change-height in this-procedure
     3164           (input v-diasize-orig-frame-height
     3165               - frame Dialog-Frame :height-chars
     3166           ,input true
     3167           ) .
     3168         assign
     3169           v-diasize-need-maximize = true
     3170         .
     3171       end.
     3172     end.
     3173   end procedure.
     3174   procedure diasize_restore-orig-size :
     3175     do
     3176     on error undo, return error return-value
     3177     :
     3178       assign
     3179         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3180         v-diasize-current-frame-height = frame Dialog-Frame :height
     3181       .
     3182       run diasize_set-height in this-procedure
     3183         (input  v-diasize-orig-frame-height
     3184         ,input  true
     3185         ) .
     3186       run diasize_set-width in this-procedure
     3187         (input  v-diasize-orig-frame-width
     3188         ,input  true
     3189         ) .
     3190     end.
     3191   end procedure.
     3192   procedure diasize_restore-current-size :
     3193     do
     3194     on error undo, return error return-value
     3195     :
     3196       run diasize_set-height in this-procedure
     3197         (input  v-diasize-current-frame-height
     3198         ,input  true
     3199         ) .
     3200       run diasize_set-width in this-procedure
     3201         (input  v-diasize-current-frame-width
     3202         ,input  true
     3203         ) .
     3204     end.
     3205   end procedure.
     3206   procedure diasize_set-browse-handle :
     3207     define input  parameter p-browse-handle as handle   no-undo .
     3208     define buffer buf_temp-browse-handle for temp-browse-handle .
     3209     do
     3210     on error undo, return error return-value
     3211     :
     3212       assign
     3213         v-diasize-browse-handle = p-browse-handle
     3214       .
     3215       for each buf_temp-browse-handle
     3216       on error undo, return error return-value
     3217       :
     3218         delete buf_temp-browse-handle .
     3219       end.
     3220     end.
     3221   end procedure.
     3222   procedure diasize_add_browse :
     3223     define input  parameter p-browse-type   as character no-undo .
     3224     define input  parameter p-browse-handle as handle    no-undo .
     3225     define buffer buf_temp-browse-handle for temp-browse-handle .
     3226     do
     3227     on error undo, return error return-value
     3228     :
     3229       assign
     3230         v-diasize-browse-number = v-diasize-browse-number + 1
     3231       .
     3232       create buf_temp-browse-handle .
     3233       assign
     3234         buf_temp-browse-handle.browse-type   = p-browse-type
     3235         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3236         buf_temp-browse-handle.browse-handle = p-browse-handle
     3237       .
     3238     end.
     3239   end procedure.
     3240   procedure diasize_init :
     3241     define variable v-default-value    as logical   no-undo .
     3242     define variable v-restore-saved    as logical   no-undo .
     3243     define variable v-resize-value-str as character no-undo .
     3244     do
     3245     on error undo, return error return-value
     3246     :
     3247       do with frame Dialog-Frame
     3248       :
     3249         assign
     3250           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3251           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3252           v-diasize-browse-handle     = browse BROWSE-1grp :handle
     3253         .
     3254         create button v-diasize-resize-button
     3255         assign
     3256           parent        = frame Dialog-Frame :first-child
     3257           label         = "s"
     3258           height-pixels = 16
     3259           width-pixels  = 16
     3260           visible       = true
     3261           sensitive     = true
     3262           movable       = true
     3263           triggers:
     3264             on end-move persistent run diasize_end-move in this-procedure .
     3265           end triggers.
     3266         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3267         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3268         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3269         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3270         assign
     3271           v-diasize-wndmax = false
     3272         .
     3273         if connected("ub") = true
     3274         then do:
     3275           define variable v-cntxt-db-num        as integer   no-undo .
     3276           define variable v-cntxt-userid        as character no-undo .
     3277           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3278                                             , OUTPUT v-cntxt-userid
     3279                                             ) .
     3280           run gbl/wndpar_r.p
     3281             (input  v-cntxt-db-num
     3282             ,input  v-cntxt-userid
     3283             ,input  'wndmax':U
     3284             ,output v-diasize-wndmax
     3285             ,output v-default-value
     3286             ) .
     3287         end.
     3288         assign
     3289           v-diasize-wndstore = false
     3290         .
     3291         if connected("ub") = true
     3292         then do:
     3293           run gbl/wndpar_r.p
     3294             (input  v-cntxt-db-num
     3295             ,input  v-cntxt-userid
     3296             ,input  'wndstore':U
     3297             ,output v-diasize-wndstore
     3298             ,output v-default-value
     3299             ) .
     3300         end.
     3301         assign
     3302           v-diasize-proc-name = entry(1, program-name(2), '.')
     3303         .
     3304         if v-diasize-wndstore = true
     3305         then do:
     3306           assign
     3307             v-restore-saved = false
     3308           .
     3309           if connected("ub") = true
     3310           then do:
     3311             run gbl/wndsizer.p
     3312               (input  v-cntxt-db-num
     3313               ,input  v-cntxt-userid
     3314               ,input  v-diasize-proc-name
     3315               ,input  'height':u
     3316               ,output v-resize-value-str
     3317               ) .
     3318             if v-resize-value-str <> '':U
     3319             then do:
     3320               run diasize_change-height in this-procedure
     3321                 (input  integer(v-resize-value-str)
     3322                 ,input  true
     3323                 ) .
     3324               assign
     3325                 v-restore-saved = true
     3326               .
     3327             end.
     3328           end.
     3329           if connected("ub") = true
     3330           then do:
     3331             run gbl/wndsizer.p
     3332               (input  v-cntxt-db-num
     3333               ,input  v-cntxt-userid
     3334               ,input  v-diasize-proc-name
     3335               ,input  'width':u
     3336               ,output v-resize-value-str
     3337               ) .
     3338             if v-resize-value-str <> '':U
     3339             then do:
     3340               run diasize_change-width in this-procedure
     3341                 (input  integer(v-resize-value-str)
     3342                 ,input  true
     3343                 ) .
     3344               assign
     3345                 v-restore-saved = true
     3346               .
     3347             end.
     3348           end.
     3349           if v-restore-saved <> true
     3350           then do:
     3351             if v-diasize-wndmax = true
     3352             then do:
     3353               run diasize_maximize in this-procedure
     3354                 (input  true
     3355                 ) .
     3356             end.
     3357           end.
     3358         end.
     3359         else do:
     3360           if v-diasize-wndmax = true
     3361           then do:
     3362             run diasize_maximize in this-procedure
     3363               (input  true
     3364               ) .
     3365           end.
     3366         end.
     3367       end.
     3368     end.
     3369   end procedure.
     3370   procedure diasize_need-full-display :
     3371     define output parameter p-need-full-display as logical   no-undo .
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375       assign
     3376         p-need-full-display = v-diasize-need-full-display
     3377       .
     3378       assign
     3379         v-diasize-need-full-display = false
     3380       .
     3381     end.
     3382   end procedure.
     3383   procedure get-context :
     3384      define output parameter p-db-num as integer          no-undo.
     3385      define output parameter p-user-id as character        no-undo.
     3386      define variable v-login               as character    no-undo.
     3387      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3388      define buffer buf_user-login  for ub.user-login .
     3389      do
     3390      on error undo, return error
     3391      :
     3392            FIND FIRST buf_sys-ctrl no-lock.
     3393            ASSIGN
     3394               v-login = USERID("ub")
     3395               p-db-num = buf_sys-ctrl.db-num
     3396            .
     3397            FIND FIRST buf_user-login
     3398                 WHERE buf_user-login.db-num = p-db-num
     3399                   AND buf_user-login.user-login = v-login
     3400                 no-lock
     3401                 no-error
     3402                 .
     3403            IF AVAILABLE buf_user-login
     3404            THEN DO:
     3405               assign
     3406                  p-user-id = buf_user-login.user-id
     3407               .
     3408            END.
     3409      end.
     3410   end procedure.
     3411       run diasize_init in this-procedure .
     3412   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3413   on f5 of frame Dialog-Frame anywhere
     3414   do:
     3415     run openbr in this-procedure .
     3416       apply "VALUE-CHANGED" to BROWSE-1grp.
     3417   end.
     3418   MAIN-BLOCK:
     3419   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3420      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3421     buf_price-list-type.name:resizable in browse BROWSE-1grp   = true .
     3422     buf_price-doc-forming.name:resizable in browse BROWSE-1grp   = true .
     3423     buf_price-doc-forming.name:read-only in browse BROWSE-1grp   = true .
     3424     frame Dialog-Frame:TITLE = ( if p-mode = "pl-type":U  then ("ДНЦ по ТИПУ прайс-листа № " + string( p-plt-id) + " БД " + string( p-plt-db-num))
     3425                                                           else "Список ДНЦ по ГПЛ (для ПЕРЕОЦЕНОК)" ) +
     3426                                                           " Объект "  + p-obj-type + string(p-obj-code)
     3427                                                            .
     3428     run init-proc in this-procedure .
     3429     run enable_ui in this-procedure .
     3430     apply "VALUE-CHANGED" to BROWSE-1grp IN FRAME Dialog-Frame .
     3431     disable
     3432        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     3433        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     3434        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     3435        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     3436        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     3437       with frame Dialog-Frame .
     3438     WAIT-FOR GO OF FRAME Dialog-Frame.
     3439   END.
     3440   run disable_ui in this-procedure .
     3441   PROCEDURE disable_UI :
     3442     HIDE FRAME Dialog-Frame.
     3443   END PROCEDURE.
     3444   PROCEDURE enable_UI :
     3445     DISPLAY loc-pdf-id T-paket FILL-IN-6 v-user-name
     3446         WITH FRAME Dialog-Frame.
     3447     ENABLE B-Cancel B-mark B-sel B-add B-lkp B-chg B-del B-close B-history B-Help
     3448            B-print loc-pdf-id T-paket BROWSE-1grp FILL-IN-6 v-user-name
     3449         WITH FRAME Dialog-Frame.
     3450     VIEW FRAME Dialog-Frame.
     3451     OPEN QUERY BROWSE-1grp FOR     EACH buf_price-doc-forming WHERE        buf_price-doc-forming.stts = 0     ,            FIRST buf_price-list-type  WHERE           buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num ,            FIRST x_grp-obj-price WHERE           x_grp-obj-price.gop-id     = buf_price-list-type.gop-id   AND           x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num .
     3452   END PROCEDURE.
     3453   PROCEDURE init-proc :
     3454   run metod-obj-in-gop in this-procedure (
     3455       v-cntxt-db-num ,
     3456       p-obj-type    ,
     3457       p-obj-code
     3458       ).
     3459   END PROCEDURE.
     3460   PROCEDURE openbr :
     3461     OPEN QUERY BROWSE-1grp FOR     EACH buf_price-doc-forming WHERE        buf_price-doc-forming.stts = 0     ,            FIRST buf_price-list-type  WHERE           buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num ,            FIRST x_grp-obj-price WHERE           x_grp-obj-price.gop-id     = buf_price-list-type.gop-id   AND           x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num .
     3462   END PROCEDURE.
     3463   PROCEDURE seach-pdf-id :
     3464   define input  parameter p-id as INTEGER no-undo .
     3465   define input  parameter p-next as logical   no-undo .
     3466   if p-next = true then do:
     3467      find next buf_price-doc-forming no-lock where
     3468         buf_price-doc-forming.pdf-id     = p-id no-error .
     3469         if not available buf_price-doc-forming then do:
     3470           message "Еще запись не найдена ! " view-as alert-box information .
     3471           return .
     3472         end.
     3473   end.
     3474   else do:
     3475     find first buf_price-doc-forming no-lock where
     3476                buf_price-doc-forming.pdf-id     = p-id
     3477    no-error .
     3478                 if not available buf_price-doc-forming then do:
     3479                   message "Запись не найдена !" view-as alert-box information .
     3480                   return .
     3481                 end.
     3482   end.
     3483   reposition BROWSE-1grp to rowid rowid(buf_price-doc-forming) no-error .
     3484   apply "value-changed" to BROWSE-1grp in frame Dialog-Frame.
     3485   END PROCEDURE.
