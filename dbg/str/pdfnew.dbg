     1899       ,input  0
     1900       ,input  0
     1901       ,input  0
     1902       ,input  true
     1903       ,output g#log
     1904       )  .
     1905   end.
     1906     end.
     1907     if not g#log then return .
     1908   if var-paket = false  then do:
     1909     if not available buf_price-doc-forming then return .
     1910     if buf_price-list-type.main = true  and
     1911        buf_price-doc-forming.stts = integer('3':U)
     1912        then do:
     1913         message "ДНЦ :" buf_price-doc-forming.name skip
     1914                 "№" buf_price-doc-forming.pdf-id
     1915                 "главного типа  - удалять нельзя !!!"
     1916                 view-as alert-box error
     1917                 title "Внимание !" .
     1918                 return.
     1919     end.
     1920     message "Удалять ДНЦ : " buf_price-doc-forming.name skip
     1921             "№" buf_price-doc-forming.pdf-id "?"
     1922             view-as alert-box question
     1923             buttons yes-no update g-ok as log.
     1924     if not g-ok then return .
     1925     run price-doc-forming-delete (
     1926         buf_price-doc-forming.plt-db-num ,
     1927         buf_price-doc-forming.plt-id     ,
     1928         buf_price-doc-forming.pdf-db     ,
     1929         buf_price-doc-forming.pdf-id     ,
     1930         v-cntxt-db-num                   ,
     1931         v-cntxt-userid                   )
     1932         no-error .
     1933    end.
     1934    else do:
     1935    define variable nn as integer   no-undo .
     1936    define variable v-recid as recid no-undo .
     1937    define buffer del_price-doc-forming for ub.price-doc-forming  .
     1938    define buffer del_price-list-type for ub.price-list-type  .
