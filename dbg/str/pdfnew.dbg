     2115   ON VALUE-CHANGED OF T-paket IN FRAME Dialog-Frame
     2116   DO:
     2117      assign T-paket .
     2118      var-paket = t-paket .
     2119      if T-paket then do:
     2120         enable  b-close b-del b-mark with frame Dialog-Frame .
     2121         disable b-add b-chg   with frame Dialog-Frame .
     2122      end.
     2123      else do:
     2124         if LOOKUP ("b-add":U,    p-bttns) <> 0 then
     2125            enable  b-add with frame Dialog-Frame .
     2126         if LOOKUP ("b-chg":U,    p-bttns) <> 0 then
     2127            enable  b-chg with frame Dialog-Frame .
     2128         if LOOKUP ("b-mark":U,    p-bttns) = 0 then
     2129            disable  b-mark with frame Dialog-Frame .
     2130      end.
     2131   END.
     2132   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
