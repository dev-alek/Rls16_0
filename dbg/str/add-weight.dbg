        1   define input parameter p-gds-code as integer   no-undo .
        2   define output parameter p-weight as decimal   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Масса товара ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   DEFINE BUTTON B-Cancel AUTO-END-KEY
       68        LABEL "Отмена"
       69        SIZE 10 BY 1
       70        BGCOLOR 8 .
       71   DEFINE BUTTON B-Help
       72        LABEL "Помощь"
       73        SIZE 10 BY 1
       74        BGCOLOR 8 .
       75   DEFINE BUTTON B-OK AUTO-GO
       76        LABEL "Ввод"
       77        SIZE 10 BY 1
       78        BGCOLOR 8 .
       79   DEFINE VARIABLE v-gds-unit AS CHARACTER FORMAT "X(8)":U
       80         VIEW-AS TEXT
       81        SIZE 6.4 BY .62 NO-UNDO.
       82   DEFINE VARIABLE v-weight AS DECIMAL FORMAT ">,>>>,>>>,>>9.999":U INITIAL 0
       83        LABEL "Введите массу товара"
       84        VIEW-AS FILL-IN
       85        SIZE 15.8 BY 1 NO-UNDO.
       86   DEFINE FRAME Dialog-Frame
       87        B-OK AT ROW 1 COL 1
       88        B-Cancel AT ROW 1 COL 11
       89        B-Help AT ROW 1 COL 43.6
       90        v-weight AT ROW 3.76 COL 24.2 COLON-ALIGNED
       91        v-gds-unit AT ROW 4.1 COL 41 COLON-ALIGNED NO-LABEL
       92        SPACE(4.39) SKIP(1.13)
       93       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       94            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       95            TITLE "Ввод массы"
       96            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
       97   ASSIGN
       98          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       99          FRAME Dialog-Frame:HIDDEN           = TRUE.
      100   ON GO OF FRAME Dialog-Frame
      101   DO:
      102     RUN save-proc no-error .
      103     if error-status :error then do:
      104         message
      105           return-value
      106           view-as alert-box error
      107         .
      108         return no-apply .
      109     end.
      110   END.
      111   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      112   DO:
      113     APPLY "END-ERROR":U TO SELF.
      114   END.
      115   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      116   DO:
      117     p-weight = 0 .
      118   END.
      119   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      120   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   on help of frame Dialog-Frame
      123   do:
      124     run gbl/app_help.p
      125       (input this-procedure :file-name
      126       ,input ''
      127       ,input ?
      128       ) no-error.
      129     if error-status :error then do:
      130       message
      131         "Ошибка при вызове помощи"
      132         error-status :get-message(1)
      133         view-as alert-box .
      134     end.
      135   end.
      136   run minbtn-set in this-procedure .
      137   on choose of b-help in frame Dialog-Frame
      138   do:
      139     apply "help":u to frame Dialog-Frame .
      140   end.
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   procedure minbtn-set :
      143       do
      144           on error undo, return error return-value
      145           :
      146           define variable ii              as integer       no-undo .
      147           define variable fh              as widget-handle no-undo .
      148           define variable hh              as widget-handle no-undo .
      149           define variable v-h             as handle        extent 4 no-undo .
      150           define variable v-name-button   as character     no-undo .
      151           define variable v-help-old-x    as decimal       no-undo .
      152           define variable v-help-old-y    as decimal       no-undo .
      153           define variable v-help-old-size as decimal       no-undo .
      154           define variable v-frame-width   as decimal       no-undo .
      155           define variable jj              as integer       no-undo .
      156           do
      157               on error undo, return error
      158               :
      159               assign
      160                   v-frame-width = frame Dialog-Frame:width - 0.3
      161                   fh            = frame Dialog-Frame:first-child
      162                   hh            = fh:first-child
      163                   ii            = 1
      164                   .
      165               do while valid-handle(hh):
      166                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      167                   do:
      168                       case lc(hh:name) :
      169                           when "b-help" then
      170                               do:
      171                                   hh:load-image-up("cmp/b-help.bmp":u) .
      172                                   hh:load-image-down("cmp/b-help.bmp":u) .
      173                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      174                                   hh:TOOLTIP = "Помощь" .
      175                                   v-help-old-x = hh:column .
      176                                   v-help-old-y = hh:row    .
      177                                   v-help-old-size = hh:width .
      178                                   hh:width-chars = 2.5 .
      179                               end.
      180                           when "b-print" then
      181                               do:
      182                                   hh:load-image("cmp/b-print.bmp":u) .
      183                                   hh:TOOLTIP = "Печать" .
      184                                   v-h[ii] = hh:handle .
      185                                   ii = ii + 1 .
      186                                   hh:width-chars = 3 .
      187                               end.
      188                           when "b-history" or
      189                           when "b-hist" then
      190                               do:
      191                                   hh:load-image("cmp/b-hist.bmp":u) .
      192                                   hh:TOOLTIP = "История" .
      193                                   v-h[ii] = hh:handle .
      194                                   ii = ii + 1 .
      195                                   hh:width-chars = 3 .
      196                               end.
      197                           when "b-sch" then
      198                               do:
      199                                   hh:load-image("cmp/b-sch.bmp":u) .
      200                                   hh:TOOLTIP = "Установка Фильтра" .
      201                                   v-h[ii] = hh:handle .
      202                                   ii = ii + 1 .
      203                                   hh:width-chars = 3 .
      204                               end.
      205                           when "b-hist-user" then
      206                               do:
      207                                   hh:load-image("cmp/b-hist.bmp":u) .
      208                                   hh:TOOLTIP = "История пользователя" .
      209                                   ii = ii + 1 .
      210                               end.
      211                       end case.
      212                   end.
      213                   hh = hh:next-sibling.
      214               end.
      215               b-help:column = v-frame-width - b-help:width-chars.
      216               jj = 0.
      217               repeat ii = 4 to 1 by -1 :
      218                   if valid-handle (v-h[ii] ) then
      219                   do:
      220                       jj  = jj + 1 .
      221                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      222                       v-h[ii]:row    = v-help-old-y .
      223                   end.
      224               end.
      225           end.
      226       end.
      227   end procedure.
      228   MAIN-BLOCK:
      229   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      230      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      231       RUN enable_UI.
      232       RUN proc-calc IN THIS-PROCEDURE NO-ERROR.
      233       WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-weight.
      234   END.
      235   RUN disable_UI.
      236   PROCEDURE disable_UI :
      237     HIDE FRAME Dialog-Frame.
      238   END PROCEDURE.
      239   PROCEDURE enable_UI :
      240     DISPLAY v-weight v-gds-unit
      241         WITH FRAME Dialog-Frame.
      242     ENABLE B-OK B-Cancel B-Help v-weight
      243         WITH FRAME Dialog-Frame.
      244     VIEW FRAME Dialog-Frame.
      245   END PROCEDURE.
      246   PROCEDURE proc-calc :
      247      define buffer buf_goods for ub.goods .
      248      find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      249      if available (buf_goods) then v-gds-unit:screen-value in frame Dialog-Frame = buf_goods.unit-base .
      250   END PROCEDURE.
      251   PROCEDURE save-proc :
      252   ASSIGN FRAME Dialog-Frame
      253       v-weight
      254       .
      255       if v-weight = 0 then do:
      256          return error "Не введена масса товара!" .
      257       end.
      258       p-weight = v-weight .
      259   END PROCEDURE.
