        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo.
        3   define input  parameter p-doc-code    as character no-undo .
        4   define input  parameter p-gds-code    as integer   no-undo .
        5   define input  parameter p-node-code   as integer   no-undo .
        6   define input  parameter p-mode        as character no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: prt-edit.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: str/prt-edit.p $":U .
       12   define variable vss-description as character no-undo initial "Вызов редактирования признака в расходной накладной".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u,parparentproc,p-doc-code,p-gds-code,p-node-code,p-mode)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define buffer buf_gds-prt  for ub.gds-prt .
       77   define buffer buf_goods    for ub.goods .
       78   define buffer buf_doc-line for ub.doc-line .
       79   do
       80   on error undo, return error return-value
       81   :
       82     find first buf_gds-prt no-lock
       83       where buf_gds-prt.node-code = p-node-code
       84       no-error .
       85     if not available buf_gds-prt
       86     then do:
       87       message
       88         vss-workfile vss-revision vss-description skip
       89         "Ошибка задания входных параметров" skip
       90         view-as alert-box error .
       91       undo, return error return-value .
       92     end.
       93     define new shared buffer t-doc for trn-doc .
       94     find first t-doc exclusive-lock
       95       where t-doc.doc-code = p-doc-code
       96       .
       97     find first buf_goods no-lock
       98       where buf_goods.gds-code = p-gds-code
       99       .
      100     find first buf_doc-line no-lock
      101       where buf_doc-line.doc-code  = p-doc-code
      102         and buf_doc-line.artic     = buf_goods.artic
      103         and buf_doc-line.prod-type = buf_goods.prod-type
      104         and buf_doc-line.prod-code = buf_goods.prod-code
      105       .
      106     run str/out-prt.w
      107       (input parparentproc
      108       ,input recid(t-doc)
      109       ,input recid(buf_doc-line)
      110       ,input recid(buf_goods)
      111       ,input p-mode
      112       ,input recid(buf_gds-prt)
      113       ,input 'терм':U
      114       ) no-error.
      115   end.
