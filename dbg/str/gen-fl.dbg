      609       ) .
      610   define temp-table tt-add no-undo like ub.add-doc.
      611   define temp-table tt-trn no-undo like ub.trn-doc.
      612   define temp-table tt-ord no-undo like ub.ord-doc.
      613   define temp-table tt-rcv no-undo like ub.ord-doc-rcv.
      614   define temp-table c-tt-trn no-undo like ub.c-trn-doc.
      615   define variable v-type-trn-doc as character no-undo .
      616   DEFINE BUTTON b-exec
      617        LABEL "В&ыполнить"
      618        SIZE 15 BY 1.
      619   DEFINE BUTTON b-exit AUTO-END-KEY
      620        LABEL "&Выход"
      621        SIZE 12 BY 1.
      622   DEFINE BUTTON B-help DEFAULT
      623        LABEL "Помо&щь"
      624        SIZE 12 BY 1
      625        BGCOLOR 8 .
      626   DEFINE BUTTON i-exit
      627        IMAGE-UP FILE "cmp/i-run.bmp":U
      628        IMAGE-DOWN FILE "cmp/i-run.bmp":U
      629        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
      630        LABEL ""
      631        SIZE 2.5 BY .75.
      632   DEFINE VARIABLE res AS CHARACTER
      633        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      634        SIZE 85 BY 7.46 NO-UNDO.
      635   DEFINE VARIABLE date-end AS DATE FORMAT "99/99/9999":U
      636        VIEW-AS FILL-IN
      637        SIZE 11.38 BY 1 NO-UNDO.
      638   DEFINE VARIABLE FILL-IN-10 AS CHARACTER FORMAT "X(256)":U INITIAL "Обработать накладные по :"
      639         VIEW-AS TEXT
      640        SIZE 26 BY 1 NO-UNDO.
      641   DEFINE VARIABLE FILL-IN-11 AS CHARACTER FORMAT "X(256)":U INITIAL "Формировать:"
      642         VIEW-AS TEXT
      643        SIZE 12.5 BY 1 NO-UNDO.
      644   DEFINE VARIABLE FILL-IN-12 AS CHARACTER FORMAT "X(256)":U INITIAL "Обсчитывать документы:"
      645         VIEW-AS TEXT
      646        SIZE 29.63 BY 1 NO-UNDO.
      647   DEFINE VARIABLE FILL-IN-13 AS CHARACTER FORMAT "X(256)":U INITIAL "Дата ФО:"
      648         VIEW-AS TEXT
      649        SIZE 8.5 BY 1 TOOLTIP "Дата док. для ФО" NO-UNDO.
      650   DEFINE VARIABLE FILL-IN-14 AS CHARACTER FORMAT "X(256)":U INITIAL "Расчет налогов по ставкам:"
      651         VIEW-AS TEXT
      652        SIZE 26 BY 1 NO-UNDO.
      653   DEFINE VARIABLE v-info AS CHARACTER FORMAT "X(256)":U
      654         VIEW-AS TEXT
      655        SIZE 80 BY 1
      656        FGCOLOR 4  NO-UNDO.
      657   DEFINE VARIABLE R-cons AS INTEGER
      658        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      659        RADIO-BUTTONS
      660             "Совокупно", 1,
      661   "Раздельно", 2
      662        SIZE 33.5 BY 1 TOOLTIP "раздельно - по каждой накладной отдельное ФО" NO-UNDO.
      663   DEFINE VARIABLE R-nalog AS INTEGER
      664        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      665        RADIO-BUTTONS
      666             "Совокупно", 1,
      667   "Раздельно", 2
      668        SIZE 33.5 BY 1 TOOLTIP "раздельно - по каждой ставке налога отдельное ФО" NO-UNDO.
      669   DEFINE VARIABLE R-trn AS INTEGER
      670        VIEW-AS RADIO-SET VERTICAL
      671        RADIO-BUTTONS
