      850           input table tt-trn ,
      851           input-output res,
      852           input radio-set-1,
      853           INPUT  t-adm
      854           ) no-error .
      855         run str/gen-flp.p (
      856             INPUT parParentProc ,
      857             input par-host-code ,
      858             input date-end   ,
      859             input 2  ,
      860             input R-cons     ,
      861             INPUT r-nalog ,
      862             input table tt-trn ,
      863             input-output res,
      864             input radio-set-1,
      865             INPUT  t-adm
      866             ) no-error .
      867     END.
      868     IF r-trn = ? OR  r-trn = 1 OR r-trn = 2 THEN DO:
      869         run str/gen-flp.p (
      870             INPUT parParentProc ,
      871             input par-host-code ,
      872             input date-end   ,
      873             input r-trn  ,
      874             input R-cons     ,
      875             INPUT r-nalog ,
      876             input table tt-trn ,
      877             input-output res ,
      878             input radio-set-1,
      879             INPUT  t-adm
      880             ) no-error .
      881     END.
      882       if r-trn = 4 then do:
      883         run str/gen-flo.p (
      884           INPUT parParentProc ,
      885           input par-host-code ,
      886           input date-end   ,
      887           input 4  ,
      888           input R-cons     ,
      889           INPUT r-nalog ,
      890           input table tt-ord ,
      891           input-output res,
      892           input radio-set-1,
      893           INPUT  t-adm,
      894           input 'рас':U
      895           ) no-error .
      896       end.
      897       if r-trn = 5 then do:
      898         run str/gen-flrv.p (
      899           INPUT parParentProc ,
      900           input par-host-code ,
      901           input date-end   ,
      902           input 5  ,
      903           input R-cons     ,
      904           INPUT r-nalog ,
      905           input table tt-rcv ,
      906           input-output res,
      907           input radio-set-1,
      908           INPUT  t-adm
      909           ) no-error .
      910       end.
      911       if r-trn = 7 then do:
      912         run str/gen-flad.p (
      913           INPUT parParentProc ,
      914           input par-host-code ,
      915           input date-end   ,
      916           input 7  ,
      917           input R-cons     ,
      918           input r-nalog ,
      919           input table tt-add ,
      920           input-output res,
      921           input radio-set-1,
      922           input  t-adm
      923           ) no-error .
      924       end.
      925       if r-trn = 6 then do:
      926         run str/gen-flsp.p (
      927             INPUT parParentProc ,
      928             input par-host-code ,
      929             input date-end   ,
      930             input radio-set-1,
      931             input "",
      932             input-output res
      933         ) no-error .
      934       end.
      935       if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      936   end.
      937   IF r-trn <= 3  THEN DO:
      938       if p-mode = "del":u or par-list-trn = ?  then do:
      939         res = res +  chr(10) + "--- ПО УДАЛЕННЫМ ДОКУМЕНТАМ ( 2 прохода ) ---".
      940         IF r-trn = 3 THEN DO:
      941             run str/gen-flpd.p (
      942                   INPUT parParentProc ,
      943                   input par-host-code ,
      944                   input date-end   ,
      945                   input 1  ,
      946                   input R-cons     ,
      947                   INPUT r-nalog ,
      948                   input table c-tt-trn ,
      949                   input-output res ,
      950                   input radio-set-1
      951                   ) no-error .
      952             if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      953             run str/gen-flpd.p (
      954                   INPUT parParentProc ,
      955                   input par-host-code ,
      956                   input date-end   ,
      957                   input 2  ,
      958                   input R-cons     ,
      959                   INPUT r-nalog ,
      960                   input table c-tt-trn ,
      961                   input-output res ,
      962                   input radio-set-1
      963                   ) no-error .
      964             if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      965             run str/gen-flpr.p (
      966                   INPUT parParentProc ,
      967                   input par-host-code ,
      968                   input date-end   ,
      969                   input 1  ,
      970                   input R-cons     ,
      971                   INPUT r-nalog ,
      972                   input table c-tt-trn ,
      973                   input-output res ,
      974                   input radio-set-1
      975                   ) no-error .
      976             if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      977             run str/gen-flpr.p (
      978                   INPUT parParentProc ,
      979                   input par-host-code ,
      980                   input date-end   ,
      981                   input 2  ,
      982                   input R-cons     ,
      983                   INPUT r-nalog ,
      984                   input table c-tt-trn ,
      985                   input-output res ,
      986                   input radio-set-1
      987                   ) no-error .
      988                   if error-status :error then res = res + chr(10) + error-status :get-message(1) .
      989         END.
      990         if r-trn = 1 or r-trn = 2 then do :
      991             run str/gen-flpd.p (
      992                 INPUT parParentProc ,
      993                 input par-host-code ,
      994                 input date-end   ,
      995                 input r-trn  ,
      996                 input R-cons     ,
      997                 INPUT r-nalog ,
      998                 input table c-tt-trn ,
      999                 input-output res,
     1000                 input radio-set-1
     1001                 ) no-error .
     1002                 if error-status :error then res = res + chr(10) + error-status :get-message(1) .
     1003             run str/gen-flpr.p (
     1004                 INPUT parParentProc ,
     1005                 input par-host-code ,
     1006                 input date-end   ,
     1007                 input r-trn  ,
     1008                 input R-cons     ,
     1009                 INPUT r-nalog ,
     1010                 input table c-tt-trn ,
     1011                 input-output res ,
     1012                 input radio-set-1
     1013                 ) no-error .
     1014                 if error-status :error then res = res + chr(10) + error-status :get-message(1) .
     1015         END.
     1016       end.
     1017   end.
     1018   display res with frame Dialog-Frame .
     1019   END.
     1020   ON ENTRY OF date-end IN FRAME Dialog-Frame
     1021   DO:
     1022     RADIO-SET-1:RADIO-BUTTONS = "Сегодня,1," + ( INPUT date-end ) + ",2 ".
     1023     DISPLAY RADIO-SET-1 WITH FRAME Dialog-Frame .
     1024   END.
     1025   ON LEAVE OF date-end IN FRAME Dialog-Frame
     1026   DO:
     1027     ASSIGN date-end.
     1028     RADIO-SET-1:RADIO-BUTTONS = "Сегодня,1," + STRING(date-end,"99/99/9999") + ",2" .
     1029     DISPLAY RADIO-SET-1 WITH FRAME Dialog-Frame .
     1030   END.
     1031   ON return OF date-end IN FRAME Dialog-Frame
     1032   DO:
     1033       run next-focus in this-procedure  (input  date-end:handle ) .
     1034     return no-apply .
     1035   END.
     1036   ON return OF R-cons IN FRAME Dialog-Frame
     1037   DO:
     1038        run next-focus in this-procedure  (input  R-cons:handle ) .
     1039     return no-apply .
     1040   END.
     1041   ON return OF R-nalog IN FRAME Dialog-Frame
     1042   DO:
     1043        run next-focus in this-procedure  (input  R-nalog:handle ) .
     1044     return no-apply .
     1045   END.
     1046   ON return OF R-trn IN FRAME Dialog-Frame
     1047   DO:
     1048        run next-focus in this-procedure  (input  R-trn:handle ) .
     1049     return no-apply .
     1050   END.
     1051   ON return OF RADIO-SET-1 IN FRAME Dialog-Frame
     1052   DO:
     1053       run next-focus in this-procedure  (input  RADIO-SET-1:handle ) .
     1054    return no-apply .
     1055   END.
     1056   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1057   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1058   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   on help of frame Dialog-Frame
     1060   do:
     1061     run gbl/app_help.p
     1062       (input this-procedure :file-name
     1063       ,input ''
     1064       ,input ?
     1065       ) no-error.
     1066     if error-status :error then do:
     1067       message
     1068         "Ошибка при вызове помощи"
     1069         error-status :get-message(1)
     1070         view-as alert-box .
     1071     end.
     1072   end.
     1073   run minbtn-set in this-procedure .
     1074   on choose of b-help in frame Dialog-Frame
     1075   do:
     1076     apply "help":u to frame Dialog-Frame .
     1077   end.
     1078   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   procedure minbtn-set :
     1080       do
     1081           on error undo, return error return-value
     1082           :
     1083           define variable ii              as integer       no-undo .
     1084           define variable fh              as widget-handle no-undo .
     1085           define variable hh              as widget-handle no-undo .
     1086           define variable v-h             as handle        extent 4 no-undo .
     1087           define variable v-name-button   as character     no-undo .
     1088           define variable v-help-old-x    as decimal       no-undo .
     1089           define variable v-help-old-y    as decimal       no-undo .
     1090           define variable v-help-old-size as decimal       no-undo .
     1091           define variable v-frame-width   as decimal       no-undo .
     1092           define variable jj              as integer       no-undo .
     1093           do
     1094               on error undo, return error
     1095               :
     1096               assign
     1097                   v-frame-width = frame Dialog-Frame:width - 0.3
     1098                   fh            = frame Dialog-Frame:first-child
     1099                   hh            = fh:first-child
     1100                   ii            = 1
     1101                   .
     1102               do while valid-handle(hh):
     1103                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1104                   do:
     1105                       case lc(hh:name) :
     1106                           when "b-help" then
     1107                               do:
     1108                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1109                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1111                                   hh:TOOLTIP = "Помощь" .
     1112                                   v-help-old-x = hh:column .
     1113                                   v-help-old-y = hh:row    .
     1114                                   v-help-old-size = hh:width .
     1115                                   hh:width-chars = 2.5 .
     1116                               end.
     1117                           when "b-print" then
     1118                               do:
     1119                                   hh:load-image("cmp/b-print.bmp":u) .
     1120                                   hh:TOOLTIP = "Печать" .
     1121                                   v-h[ii] = hh:handle .
     1122                                   ii = ii + 1 .
     1123                                   hh:width-chars = 3 .
     1124                               end.
     1125                           when "b-history" or
     1126                           when "b-hist" then
     1127                               do:
     1128                                   hh:load-image("cmp/b-hist.bmp":u) .
     1129                                   hh:TOOLTIP = "История" .
     1130                                   v-h[ii] = hh:handle .
     1131                                   ii = ii + 1 .
     1132                                   hh:width-chars = 3 .
     1133                               end.
     1134                           when "b-sch" then
     1135                               do:
     1136                                   hh:load-image("cmp/b-sch.bmp":u) .
     1137                                   hh:TOOLTIP = "Установка Фильтра" .
     1138                                   v-h[ii] = hh:handle .
     1139                                   ii = ii + 1 .
     1140                                   hh:width-chars = 3 .
     1141                               end.
     1142                           when "b-hist-user" then
     1143                               do:
     1144                                   hh:load-image("cmp/b-hist.bmp":u) .
     1145                                   hh:TOOLTIP = "История пользователя" .
     1146                                   ii = ii + 1 .
     1147                               end.
     1148                       end case.
     1149                   end.
     1150                   hh = hh:next-sibling.
     1151               end.
     1152               b-help:column = v-frame-width - b-help:width-chars.
     1153               jj = 0.
     1154               repeat ii = 4 to 1 by -1 :
     1155                   if valid-handle (v-h[ii] ) then
     1156                   do:
     1157                       jj  = jj + 1 .
     1158                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1159                       v-h[ii]:row    = v-help-old-y .
     1160                   end.
     1161               end.
     1162           end.
     1163       end.
     1164   end procedure.
     1165   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1166   on ' ' of date-end in frame Dialog-Frame
     1167   do:
     1168     if (can-query (self, "sensitive")
     1169        and
     1170        self :sensitive = true
     1171        )
     1172     or (can-query (self, "read-only")
     1173        and
     1174        self :read-only = false
     1175        )
     1176     then do:
     1177       assign
     1178         self :screen-value = ?
     1179       .
     1180     end.
     1181     return no-apply.
     1182   end.
     1183   on delete-character of date-end in frame Dialog-Frame
     1184   do:
     1185     if (can-query (self, "sensitive")
     1186        and
     1187        self :sensitive = true
     1188        )
     1189     or (can-query (self, "read-only")
     1190        and
     1191        self :read-only = false
     1192        )
     1193     then do:
     1194       assign
     1195         self :screen-value = ?
     1196       .
     1197     end.
     1198     return no-apply.
     1199   end.
     1200   on ctrl-d of date-end in frame Dialog-Frame
     1201   do:
     1202     define variable v-curr-sv-date as date no-undo .
     1203     if (can-query (self, "sensitive")
     1204        and
     1205        self :sensitive = true
     1206        )
     1207     or (can-query (self, "read-only")
     1208        and
     1209        self :read-only = false
     1210        )
     1211     then do:
     1212       if self :handle <> focus :handle
     1213       then do:
     1214         apply "entry":u to self .
     1215       end.
     1216       run gbl/getcurdt.p
     1217         (output v-curr-sv-date
     1218         ) .
     1219       assign
     1220         self :screen-value = string(v-curr-sv-date) .
     1221       .
     1222     end.
     1223     return no-apply.
     1224   end.
     1225   on ctrl-b of date-end in frame Dialog-Frame
     1226   do:
     1227     if (can-query (self, "sensitive")
     1228        and
     1229        self :sensitive = true
     1230        )
     1231     or (can-query (self, "read-only")
     1232        and
     1233        self :read-only = false
     1234        )
     1235     then do:
     1236       if self :handle <> focus :handle
     1237       then do:
     1238         apply "entry":u to self .
     1239       end.
     1240       define variable v-curr-sv-date as date no-undo .
     1241       define variable v-new-sv-date  as date no-undo .
     1242       assign
     1243         v-curr-sv-date = date(self :screen-value) no-error
     1244       .
     1245       if v-curr-sv-date = ?
     1246       then do:
     1247         run gbl/getcurdt.p
     1248           (output v-curr-sv-date
     1249           ) .
     1250       end.
     1251       if v-curr-sv-date <> ?
     1252       then do:
     1253         assign
     1254           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1255         .
     1256         assign
     1257           self :screen-value = string(v-new-sv-date) .
     1258         .
     1259       end.
     1260     end.
     1261     return no-apply .
     1262   end.
     1263   on ctrl-e of date-end in frame Dialog-Frame
     1264   do:
     1265     if (can-query (self, "sensitive")
     1266        and
     1267        self :sensitive = true
     1268        )
     1269     or (can-query (self, "read-only")
     1270        and
     1271        self :read-only = false
     1272        )
     1273     then do:
     1274       if self :handle <> focus :handle
     1275       then do:
     1276         apply "entry":u to self .
     1277       end.
     1278       define variable v-curr-sv-date as date no-undo .
     1279       define variable v-new-sv-date  as date no-undo .
     1280       assign
     1281         v-curr-sv-date = date(self :screen-value) no-error
     1282       .
     1283       if v-curr-sv-date = ?
     1284       then do:
     1285         run gbl/getcurdt.p
     1286           (output v-curr-sv-date
     1287           ) .
     1288       end.
     1289       if v-curr-sv-date <> ?
     1290       then do:
     1291         run gbl/lastdate.p
     1292           (input  v-curr-sv-date
     1293           ,output v-new-sv-date
     1294           ).
     1295         assign
     1296           self :screen-value = string(v-new-sv-date) .
     1297         .
     1298       end.
     1299     end.
     1300     return no-apply .
     1301   end.
     1302   on ctrl-f of date-end in frame Dialog-Frame
     1303   do:
     1304     if (can-query (self, "sensitive")
     1305        and
     1306        self :sensitive = true
     1307        )
     1308     or (can-query (self, "read-only")
     1309        and
     1310        self :read-only = false
     1311        )
     1312     then do:
     1313       if self :handle <> focus :handle
     1314       then do:
     1315         apply "entry":u to self .
     1316       end.
     1317       define variable v-ok            as logical   no-undo .
     1318       define variable v-curr-sv-date  as date      no-undo .
     1319       define variable v-description   as character no-undo .
     1320       assign
     1321         v-curr-sv-date = date(self :screen-value) no-error
     1322       .
     1323       if v-curr-sv-date = ?
     1324       then do:
     1325         run gbl/getcurdt.p
     1326           (output v-curr-sv-date
     1327           ) .
     1328       end.
     1329       if v-curr-sv-date <> ?
     1330       then do:
     1331         run gbl/d-inpday.w
     1332           (input ?
     1333           ,input "Выбор даты"
     1334           ,input v-description
     1335           ,input ""
     1336           ,input-output v-curr-sv-date
     1337           ,output v-ok
     1338           ).
     1339         if v-ok = true
     1340         then do:
     1341           assign
     1342             self :screen-value = string(v-curr-sv-date) .
     1343           .
     1344         end.
     1345       end.
     1346     end.
     1347     return no-apply .
     1348   end.
     1349     define MENU m-ed-date9
     1350       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1351       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1352       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1353       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1354       .
     1355     if date-end :POPUP-MENU in frame Dialog-Frame = ?
     1356     then do:
     1357       ASSIGN
     1358         date-end :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1359         date-end :MENU-MOUSE in frame Dialog-Frame = 3
     1360       .
     1361     end.
     1362     define variable v-label-handle9 as handle no-undo .
     1363     assign
     1364       v-label-handle9 = date-end :side-label-handle in frame Dialog-Frame
     1365     .
     1366     if valid-handle (v-label-handle9)
     1367     then do:
     1368       if v-label-handle9 :tooltip = ""
     1369       or v-label-handle9 :tooltip = ?
     1370       then do:
     1371         assign
     1372           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1373         .
     1374       end.
     1375     end.
     1376     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1377       apply "ctrl-b":U to date-end in frame Dialog-Frame .
     1378     END.
     1379     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1380       apply "ctrl-d":U to date-end in frame Dialog-Frame .
     1381     END.
     1382     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1383       apply "ctrl-e":U to date-end in frame Dialog-Frame .
     1384     END.
     1385     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1386       apply "ctrl-f":U to date-end in frame Dialog-Frame .
     1387     END.
     1388   MAIN-BLOCK:
     1389   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1390      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1391   define variable v-right-supp as logical no-undo .
     1392     v-right-supp = true .
     1393   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   do:
     1395     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1396       (input  v-cntxt-db-num
     1397       ,input  v-cntxt-userid
     1398       ,input  0
     1399       ,input  'actn_fin-supp':U
     1400       ,input  'firm':U
     1401       ,input  par-host-code
     1402       ,input  ''
     1403       ,input  0
     1404       ,input  0
     1405       ,input  0
     1406       ,input  0
     1407       ,input  true
     1408       ,output v-right-supp
     1409       )  .
     1410   end.
     1411   if v-right-supp = false then return .
     1412   date-end = date(cur-time-date()) .
     1413   v-type-trn-doc =  'ee,es,re,rs,we,wm,pc,':U + 'ie,ep,':U  + 'vt,ap,mp,vp,':U.
     1414     if par-list-trn = ? then
     1415     RUN enable_UI.
     1416     else
     1417     RUN enable_my.
     1418     WAIT-FOR GO OF FRAME Dialog-Frame focus date-end .
     1419   END.
     1420   RUN disable_UI.
     1421   PROCEDURE disable_UI :
     1422     HIDE FRAME Dialog-Frame.
     1423   END PROCEDURE.
     1424   PROCEDURE enable_my :
     1425    do
     1426    on error undo, return error return-value
     1427    :
     1428     v-info = "Выбрано " + string( num-entries( par-list-trn)  ) + " документов " .
     1429     DISPLAY r-nalog  R-cons res FILL-IN-10 FILL-IN-11 FILL-IN-12 FILL-IN-14 v-info
     1430         WITH FRAME Dialog-Frame.
     1431     ENABLE b-exit b-exec B-help R-cons res r-nalog i-exit
     1432         WITH FRAME Dialog-Frame.
     1433     VIEW FRAME Dialog-Frame.
     1434     end.
     1435   END PROCEDURE.
     1436   PROCEDURE enable_UI :
     1437     DISPLAY date-end R-trn R-cons R-nalog RADIO-SET-1 res FILL-IN-10 FILL-IN-11
     1438             FILL-IN-12 FILL-IN-14 FILL-IN-13 v-info
     1439         WITH FRAME Dialog-Frame.
     1440     ENABLE b-exit b-exec B-help i-exit date-end R-trn R-cons R-nalog RADIO-SET-1
     1441            res FILL-IN-13
     1442         WITH FRAME Dialog-Frame.
     1443     VIEW FRAME Dialog-Frame.
     1444   END PROCEDURE.
     1445   PROCEDURE next-focus :
     1446    do
     1447    on error undo, return error return-value
     1448    :
     1449     define input parameter p-widget-handle as handle no-undo .
     1450     define variable l-apply-entry as logical no-undo .
     1451     assign
     1452       l-apply-entry =   true
     1453     .
     1454     do with frame Dialog-Frame :
     1455       if  date-end:handle   = p-widget-handle then do:  if r-trn:sensitive then do:  apply "entry":u to r-trn .   return . end. end.
     1456       if  r-trn:handle  = p-widget-handle then do:              if r-cons:sensitive then do:     apply "entry":u to r-cons .      return . end. end.
     1457       if  r-cons:handle     = p-widget-handle then do:  if r-nalog:sensitive then do:     apply "entry":u to r-nalog .     return . end. end.
     1458       if  r-nalog:handle     = p-widget-handle then do:  if radio-set-1:sensitive then do:     apply "entry":u to radio-set-1 .     return . end. end.
     1459       if  radio-set-1:handle     = p-widget-handle then do:  if b-exec:sensitive then do:     apply "entry":u to b-exec .      return . end. end.
     1460     end.
     1461    end.
     1462   END PROCEDURE.
     1463   PROCEDURE update-res :
     1464    do
     1465    on error undo, return error return-value
     1466    :
     1467    define variable v-count as integer no-undo .
     1468    assign frame Dialog-Frame
     1469     date-end
     1470     R-cons
     1471     r-nalog
     1472     r-trn
     1473     no-error .
     1474   if not  error-status :error  then do:
     1475       res =  "" .
     1476       res = "ВЫБРАНО : " + chr(10) .
     1477       res = res + "Условие оплаты по договору : " + chr(10) + radio-label( string(r-trn) , r-trn:radio-buttons) .
     1478   end.
     1479   else do:
     1480       res =  "" .
     1481       r-trn = 0 .
     1482   end.
     1483   for each tt-trn :
     1484      if lookup( tt-trn.ext-doc-type , v-type-trn-doc) = 0 then do:
     1485         res = res + "неверный тип " + func-get-name-from-ext-type(tt-trn.ext-doc-type,no) + " -   накладную " + tt-trn.doc-code + " пропускаем "  + chr(10) .
     1486      end.
     1487   end.
     1488       display res with frame Dialog-Frame .
     1489     end.
     1490   END PROCEDURE.
