      673   "По поставкам заказа", 5,
      674   "По поставке (приходные накладные)", 1,
      675   "По реализации (расходные накладные)", 2,
      676   "По доп.расходам", 7,
      677   "По всем накладным", 3,
      678   "По спецификации", 6
      679        SIZE 38.5 BY 5.25 TOOLTIP "Генерация по типу" NO-UNDO.
      680   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      681        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      682        RADIO-BUTTONS
      683             "Сегодня", 1,
      684   "99/99/9999", 2
      685        SIZE 34 BY 1 TOOLTIP "Дата док. для ФО" NO-UNDO.
      686   DEFINE VARIABLE T-adm AS LOGICAL INITIAL no
      687        LABEL "Не учитывать флаги генерации"
      688        VIEW-AS TOGGLE-BOX
      689        SIZE 38 BY .83 NO-UNDO.
      690   DEFINE FRAME Dialog-Frame
      691        b-exit AT ROW 1 COL 1
      692        b-exec AT ROW 1 COL 13
      693        B-help AT ROW 1 COL 73
      694        i-exit AT ROW 1.13 COL 13.25 WIDGET-ID 2
      695        date-end AT ROW 2.25 COL 26 COLON-ALIGNED NO-LABEL
      696        T-adm AT ROW 2.25 COL 41
      697        R-trn AT ROW 3.5 COL 14 NO-LABEL
      698        R-cons AT ROW 8.96 COL 31 NO-LABEL
      699        R-nalog AT ROW 9.96 COL 31 NO-LABEL
      700        RADIO-SET-1 AT ROW 11 COL 31 NO-LABEL
      701        res AT ROW 14.92 COL 1 NO-LABEL
      702        FILL-IN-10 AT ROW 2.21 COL 1 NO-LABEL
      703        FILL-IN-11 AT ROW 3.25 COL 1 NO-LABEL
      704        FILL-IN-12 AT ROW 8.96 COL 1 NO-LABEL
      705        FILL-IN-14 AT ROW 9.96 COL 1 NO-LABEL
      706        FILL-IN-13 AT ROW 11 COL 1 NO-LABEL
      707        v-info AT ROW 13.92 COL 1 NO-LABEL
      708        SPACE(5.00) SKIP(7.61)
      709       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      710            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      711            TITLE "Генерация расходных финансовых обязательств"
      712            CANCEL-BUTTON b-exit.
      713   ASSIGN
      714          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      715          FRAME Dialog-Frame:HIDDEN           = TRUE.
      716   ASSIGN
      717          T-adm:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      718   ON ALT-CTRL-A OF FRAME Dialog-Frame
      719   ANYWHERE DO:
      720     if t-adm :visible = false then do:
      721         view t-adm in frame Dialog-Frame.
      722         t-adm = yes.
      723         enable t-adm with frame Dialog-Frame.
      724         display t-adm with frame Dialog-Frame.
      725     end.
      726     else do:
      727         t-adm = no.
      728         display t-adm with frame Dialog-Frame.
      729         hide t-adm in frame Dialog-Frame.
      730     end.
      731   END.
      732   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      733   DO:
      734     APPLY "END-ERROR":U TO SELF.
      735   END.
      736   ON CHOOSE OF b-exec IN FRAME Dialog-Frame
      737   DO:
      738     assign
      739     date-end R-cons r-trn radio-set-1 r-nalog  t-adm
      740     no-error.
      741     define variable v-calc as integer no-undo .
      742     define buffer buf_add-doc     for ub.add-doc.
      743     define buffer buf_trn-doc     for ub.trn-doc.
      744     define buffer buf_ord-doc     for ub.ord-doc.
      745     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
      746     define buffer buf_c-trn-doc   for ub.c-trn-doc.
      747     define buffer buf_contract    for ub.contract.
      748     for each tt-add : delete tt-add. end.
      749     for each tt-rcv : delete tt-rcv. end.
      750     for each tt-ord : delete tt-ord. end.
      751     for each tt-trn : delete tt-trn. end.
      752     for each c-tt-trn : delete c-tt-trn. end.
      753   define variable v-1 as integer   no-undo .
      754   v-1 = num-entries(par-list-trn) .
      755     if par-list-trn <> ? then do:
      756        r-trn = ? .
      757       repeat v-calc = 1 to v-1 :
      758             if p-mode = "" then do:
      759               find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer (entry(v-calc,par-list-trn)) no-error .
      760               if available buf_trn-doc then do:
      761                 create tt-trn.
      762                 BUFFER-COPY buf_trn-doc to tt-trn.
      763               end.
      764             end.
      765             if p-mode = "del" then do:
      766               find first buf_c-trn-doc no-lock where recid(buf_c-trn-doc) = integer (entry(v-calc,par-list-trn)) no-error .
      767               if available buf_c-trn-doc then do:
      768                 create c-tt-trn.
      769                 BUFFER-COPY buf_c-trn-doc to c-tt-trn.
      770               end.
      771             end.
      772             if p-mode = "order" then do:
      773               find first buf_ord-doc no-lock where recid(buf_ord-doc) = integer(entry(v-calc,par-list-trn)) no-error .
      774               if available buf_ord-doc then do:
      775                 create tt-ord.
      776                 BUFFER-COPY buf_ord-doc to tt-ord.
      777               end.
      778             end.
      779             if p-mode = "rcv" then do:
      780               find first buf_ord-doc-rcv no-lock where recid(buf_ord-doc-rcv) = integer(entry(v-calc,par-list-trn)) no-error .
      781               if available buf_ord-doc-rcv then do:
      782                 create tt-rcv.
      783                 BUFFER-COPY buf_ord-doc-rcv to tt-rcv.
      784               end.
      785             end.
      786             if p-mode = "add" then do:
      787               find first buf_add-doc no-lock where recid(buf_add-doc) = integer(entry(v-calc,par-list-trn)) no-error .
      788               if available buf_add-doc then do:
      789                 create tt-add.
      790                 BUFFER-COPY buf_add-doc to tt-add.
      791               end.
      792             end.
      793       end.
      794     end.
      795     run update-res no-error .
      796     if error-status :error then do:  end.
      797   if p-mode = "order" then do:
      798     run str/gen-flo.p (
      799       input parParentProc ,
      800       input par-host-code ,
      801       input date-end   ,
      802       input ?  ,
      803       input R-cons     ,
