      550   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   function func-get-name-from-ext-type   returns char
      552     ( p-ext-type as character   ,
      553       p-caps     as logical ).
      554   define variable v-ext-name as character no-undo .
      555   run get-name-from-ext-type in this-procedure (
      556       input p-ext-type  ,
      557       input p-caps  ,
      558       output v-ext-name )
      559       no-error .
      560       if error-status :error then do:
      561          assign
      562            v-ext-name = p-ext-type
      563          .
      564       end.
      565    return (v-ext-name) .
      566   end.
      567   procedure get-name-from-ext-type :
      568    do
      569    on error undo, return error return-value
      570    :
      571   define input  parameter p-ext-type as character no-undo .
      572   define input  parameter p-caps     as logical no-undo   .
      573   define output parameter p-ext-name as character no-undo .
      574   define variable v-num as integer no-undo .
      575     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      576       message
      577         vss-include-info3 skip
      578         "Неправильно задано значение входящего параметра! "
      579         "Нет такого типа документов " p-ext-type
      580         view-as alert-box error .
      581         undo, return error .
      582     end.
      583     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      584     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      585     if p-caps  = true then do :
      586        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      587     end .
      588     end.
      589   end procedure.
      590   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591     define variable v-cntxt-db-num        as integer   no-undo .
      592     define variable v-cntxt-userid        as character no-undo .
      593     define variable v-cntxt-level         as character no-undo .
      594     define variable v-cntxt-host-code-obj as integer   no-undo .
      595     define variable v-cntxt-obj-type      as character no-undo .
      596     define variable v-cntxt-obj-code      as integer   no-undo .
      597     define variable v-cntxt-db-num-obj    as integer   no-undo .
      598     define variable v-cntxt-is-admin      as logical   no-undo .
      599   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600     run mainmenu_getcntxt in parparentproc
      601       (output v-cntxt-db-num
      602       ,output v-cntxt-userid
      603       ,output v-cntxt-level
      604       ,output v-cntxt-host-code-obj
      605       ,output v-cntxt-obj-type
      606       ,output v-cntxt-obj-code
      607       ,output v-cntxt-db-num-obj
