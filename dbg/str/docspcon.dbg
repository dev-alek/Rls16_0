      231   define new global shared variable g#language as character no-undo .
      232   if g#language <> '' and g#language <> 'rus':U then do:
      233     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      234   end.
      235   procedure proc-alt-shift-f2:
      236     if not ibs.th.gbl.gbl-var:rcode
      237   then
      238     run gbl\inidebug.p .
      239   end.
      240   procedure proc-alt-shift-f3:
      241     run gbl/prvssinf.p
      242       ( input this-procedure
      243       ) .
      244   end.
      245   define variable v-inform-launched as logical no-undo initial false .
      246   procedure proc-alt-shift-f4:
      247     define variable v-action as character no-undo .
      248     if v-inform-launched = false then do:
      249       assign
      250         v-inform-launched = true
      251       .
      252       run gbl/d-inform.w
      253         (  input self
      254         ,  input this-procedure
      255         , output v-action
      256         ) no-error .
      257       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      258       assign
      259         v-inform-launched = false
      260       .
      261     end.
      262   end.
      263   procedure proc-alt-f1:
      264     run gbl/corrhelp.p
      265       (input this-procedure
      266       ) .
      267   end .
      268   on alt-shift-f2 anywhere do:
      269     run proc-alt-shift-f2.
      270   end.
      271   on alt-shift-f3 anywhere do:
      272     run proc-alt-shift-f3 in this-procedure .
      273   end.
      274   on alt-shift-f4 anywhere do:
      275     run proc-alt-shift-f4 in this-procedure.
      276   end.
      277   on alt-f1 anywhere do:
      278     run proc-alt-f1 in this-procedure .
      279   end.
      280   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   procedure tax-name:
      282   define input  parameter pardef-tax  as character           no-undo.
      283   define output parameter parname-tax as character initial ? no-undo.
      284   define buffer bf_tax for ub.tax.
      285   do on error undo, return error :
      286      case pardef-tax:
      287         when 'vat':U then do:
      288                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      289         end.
      290         when 'slt':U then do:
      291                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      292         end.
      293         when 'rdt':U then do:
      294                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      295         end.
      296         when 'exc':U then do:
      297                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      298         end.
      299         otherwise do:
      300            return error "Задан неверный параметр " + pardef-tax + " .".
      301         end.
      302      end case.
      303   end.
      304   end procedure.
