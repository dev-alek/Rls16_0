      381   DEFINE FRAME fr-D-SplitByContract-8
      382       Btn_Exit            AT ROW  1.00 COL  1.00
      383     b-help           AT ROW  1.00 COL 11.00
      384     table-type            AT ROW  2.20 COL  1.00 NO-LABEL
      385     b-supp                AT ROW  3.40 COL  1.00
      386     b-supp-grp            AT ROW 14.10 COL  1.00
      387     b-slts-vats-cons      AT ROW  3.40 COL  1.00
      388     b-slts-vats-cons-grp  AT ROW 14.10 COL  1.00
      389     b-slt-vat-cons        AT ROW  3.40 COL  1.00
      390     b-slt-vat-cons-grp    AT ROW 14.10 COL  1.00
      391     b-title               AT ROW  3.40 COL  1.00
      392     b-supp-slts-vats-cons AT ROW  3.40 COL  1.00 SKIP( 0.12 )
      393   WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      394        TITLE "УЧЕТ (Договоры)" DEFAULT-BUTTON Btn_Exit.
      395   ASSIGN FRAME fr-D-SplitByContract-8 :SCROLLABLE = NO.
      396   ASSIGN b-supp                :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 5
      397          b-supp-grp            :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 5
      398          b-supp-slts-vats-cons :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 6
      399          b-slts-vats-cons      :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 4
      400          b-slts-vats-cons-grp  :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 4
      401          b-slt-vat-cons        :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 4
      402          b-slt-vat-cons-grp    :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 4
      403          b-title               :NUM-LOCKED-COLUMNS IN FRAME fr-D-SplitByContract-8 = 2.
      404   ON WINDOW-CLOSE OF FRAME fr-D-SplitByContract-8 DO: APPLY "END-ERROR":U TO SELF. END.
      405   ON VALUE-CHANGED OF table-type IN FRAME fr-D-SplitByContract-8 DO:
      406     ASSIGN table-type.
      407     CASE table-type :
      408       WHEN 1 THEN DO:
      409         DISABLE b-supp-slts-vats-cons b-slts-vats-cons b-slts-vats-cons-grp b-slt-vat-cons
      410                 b-slt-vat-cons-grp    b-title
      411         WITH FRAME fr-D-SplitByContract-8.
      412         ASSIGN  b-supp-slts-vats-cons :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      413                 b-slts-vats-cons      :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      414                 b-slts-vats-cons-grp  :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      415                 b-slt-vat-cons        :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      416                 b-slt-vat-cons-grp    :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      417                 b-title               :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      418                 b-supp                :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      419                 b-supp-grp            :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES.
      420         ENABLE  b-supp b-supp-grp WITH FRAME fr-D-SplitByContract-8.
      421         OPEN QUERY b-supp                FOR EACH d-supp-fin.
      422         OPEN QUERY b-supp-grp            FOR EACH d-supp-grp-fin.
      423         APPLY "ENTRY":U TO b-supp IN FRAME fr-D-SplitByContract-8.
      424       END.
      425       WHEN 2 THEN DO:
      426         DISABLE b-supp-slts-vats-cons b-slts-vats-cons b-slts-vats-cons-grp b-supp
      427                 b-supp-grp            b-title
      428         WITH FRAME fr-D-SplitByContract-8.
      429         ASSIGN  b-supp-slts-vats-cons :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      430                 b-slts-vats-cons      :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      431                 b-slts-vats-cons-grp  :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      432                 b-slt-vat-cons        :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      433                 b-slt-vat-cons-grp    :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      434                 b-title               :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      435                 b-supp                :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      436                 b-supp-grp            :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO.
      437         ENABLE  b-slt-vat-cons b-slt-vat-cons-grp WITH FRAME fr-D-SplitByContract-8.
      438         OPEN QUERY b-slt-vat-cons        FOR EACH d-slt-vat-cons-fin.
      439         OPEN QUERY b-slt-vat-cons-grp    FOR EACH d-slt-vat-cons-grp-fin.
      440         APPLY "ENTRY":U TO b-slt-vat-cons IN FRAME fr-D-SplitByContract-8.
      441       END.
      442       WHEN 3 THEN DO:
      443         DISABLE b-supp-slts-vats-cons b-slt-vat-cons b-slt-vat-cons-grp b-supp
      444                 b-supp-grp            b-title
      445         WITH FRAME fr-D-SplitByContract-8.
      446         ASSIGN  b-supp-slts-vats-cons :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      447                 b-slts-vats-cons      :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      448                 b-slts-vats-cons-grp  :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      449                 b-slt-vat-cons        :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      450                 b-slt-vat-cons-grp    :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      451                 b-title               :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      452                 b-supp                :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      453                 b-supp-grp            :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO.
      454         ENABLE  b-slts-vats-cons b-slts-vats-cons-grp WITH FRAME fr-D-SplitByContract-8.
      455         OPEN QUERY b-slts-vats-cons      FOR EACH d-slts-vats-cons-fin.
      456         OPEN QUERY b-slts-vats-cons-grp  FOR EACH d-slts-vats-cons-grp-fin.
      457         APPLY "ENTRY":U TO b-slts-vats-cons IN FRAME fr-D-SplitByContract-8.
      458       END.
      459       WHEN 4 THEN DO:
      460         DISABLE b-slt-vat-cons   b-slt-vat-cons-grp   b-supp b-supp-grp b-title
      461                 b-slts-vats-cons b-slts-vats-cons-grp
      462         WITH FRAME fr-D-SplitByContract-8.
      463         ASSIGN  b-supp-slts-vats-cons :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      464                 b-slts-vats-cons      :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      465                 b-slts-vats-cons-grp  :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      466                 b-slt-vat-cons        :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      467                 b-slt-vat-cons-grp    :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      468                 b-title               :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      469                 b-supp                :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      470                 b-supp-grp            :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO.
      471         ENABLE  b-supp-slts-vats-cons WITH FRAME fr-D-SplitByContract-8.
      472         OPEN QUERY b-supp-slts-vats-cons FOR EACH d-supp-slts-vats-cons-fin.
      473         APPLY "ENTRY":U TO b-supp-slts-vats-cons IN FRAME fr-D-SplitByContract-8.
      474       END.
      475       WHEN 5 THEN DO:
      476         DISABLE b-slt-vat-cons   b-slt-vat-cons-grp   b-supp b-supp-grp
      477                 b-slts-vats-cons b-slts-vats-cons-grp b-supp-slts-vats-cons
      478         WITH FRAME fr-D-SplitByContract-8.
      479         ASSIGN  b-supp-slts-vats-cons :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      480                 b-slts-vats-cons      :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      481                 b-slts-vats-cons-grp  :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      482                 b-slt-vat-cons        :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      483                 b-slt-vat-cons-grp    :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      484                 b-title               :VISIBLE IN FRAME fr-D-SplitByContract-8 = YES
      485                 b-supp                :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO
      486                 b-supp-grp            :VISIBLE IN FRAME fr-D-SplitByContract-8 = NO.
      487         ENABLE  b-title WITH FRAME fr-D-SplitByContract-8.
      488         OPEN QUERY b-title               FOR EACH tt-title-fin.
      489         APPLY "ENTRY":U TO b-title IN FRAME fr-D-SplitByContract-8.
      490       END.
      491     END CASE.
      492   END.
      493   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   on F1 of frame fr-D-SplitByContract-8 anywhere do:
      495     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-SplitByContract-8. END.
      496     return no-apply.
      497   end.
      498   IF VALID-HANDLE( ACTIVE-WINDOW ) AND FRAME fr-D-SplitByContract-8 :PARENT = ? THEN FRAME fr-D-SplitByContract-8 :PARENT = ACTIVE-WINDOW.
      499   IF CURRENT-WINDOW :WINDOW-STATE = WINDOW-MINIMIZED THEN DO: CURRENT-WINDOW :WINDOW-STATE = WINDOW-NORMAL. END.
      500   ON WINDOW-CLOSE OF FRAME fr-D-SplitByContract-8 DO: APPLY "END-ERROR":U TO SELF. END.
      501   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   on help of frame fr-D-SplitByContract-8
      503   do:
      504     run gbl/app_help.p
      505       (input this-procedure :file-name
      506       ,input ''
      507       ,input ?
      508       ) no-error.
      509     if error-status :error then do:
      510       message
      511         "Ошибка при вызове помощи"
      512         error-status :get-message(1)
      513         view-as alert-box .
      514     end.
      515   end.
      516   run minbtn-set in this-procedure .
      517   on choose of b-help in frame fr-D-SplitByContract-8
      518   do:
      519     apply "help":u to frame fr-D-SplitByContract-8 .
      520   end.
      521   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   procedure minbtn-set :
      523       do
      524           on error undo, return error return-value
      525           :
      526           define variable ii              as integer       no-undo .
      527           define variable fh              as widget-handle no-undo .
      528           define variable hh              as widget-handle no-undo .
      529           define variable v-h             as handle        extent 4 no-undo .
      530           define variable v-name-button   as character     no-undo .
      531           define variable v-help-old-x    as decimal       no-undo .
      532           define variable v-help-old-y    as decimal       no-undo .
      533           define variable v-help-old-size as decimal       no-undo .
      534           define variable v-frame-width   as decimal       no-undo .
      535           define variable jj              as integer       no-undo .
      536           do
      537               on error undo, return error
      538               :
      539               assign
      540                   v-frame-width = frame fr-D-SplitByContract-8:width - 0.3
      541                   fh            = frame fr-D-SplitByContract-8:first-child
      542                   hh            = fh:first-child
      543                   ii            = 1
      544                   .
      545               do while valid-handle(hh):
      546                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      547                   do:
      548                       case lc(hh:name) :
      549                           when "b-help" then
      550                               do:
      551                                   hh:load-image-up("cmp/b-help.bmp":u) .
      552                                   hh:load-image-down("cmp/b-help.bmp":u) .
      553                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      554                                   hh:TOOLTIP = "Помощь" .
      555                                   v-help-old-x = hh:column .
      556                                   v-help-old-y = hh:row    .
      557                                   v-help-old-size = hh:width .
      558                                   hh:width-chars = 2.5 .
      559                               end.
      560                           when "b-print" then
      561                               do:
      562                                   hh:load-image("cmp/b-print.bmp":u) .
      563                                   hh:TOOLTIP = "Печать" .
      564                                   v-h[ii] = hh:handle .
      565                                   ii = ii + 1 .
      566                                   hh:width-chars = 3 .
      567                               end.
      568                           when "b-history" or
      569                           when "b-hist" then
      570                               do:
      571                                   hh:load-image("cmp/b-hist.bmp":u) .
      572                                   hh:TOOLTIP = "История" .
      573                                   v-h[ii] = hh:handle .
      574                                   ii = ii + 1 .
      575                                   hh:width-chars = 3 .
      576                               end.
      577                           when "b-sch" then
      578                               do:
      579                                   hh:load-image("cmp/b-sch.bmp":u) .
      580                                   hh:TOOLTIP = "Установка Фильтра" .
      581                                   v-h[ii] = hh:handle .
      582                                   ii = ii + 1 .
      583                                   hh:width-chars = 3 .
      584                               end.
      585                           when "b-hist-user" then
      586                               do:
      587                                   hh:load-image("cmp/b-hist.bmp":u) .
      588                                   hh:TOOLTIP = "История пользователя" .
      589                                   ii = ii + 1 .
      590                               end.
      591                       end case.
      592                   end.
      593                   hh = hh:next-sibling.
      594               end.
      595               b-help:column = v-frame-width - b-help:width-chars.
      596               jj = 0.
      597               repeat ii = 4 to 1 by -1 :
      598                   if valid-handle (v-h[ii] ) then
      599                   do:
      600                       jj  = jj + 1 .
      601                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      602                       v-h[ii]:row    = v-help-old-y .
      603                   end.
      604               end.
      605           end.
      606       end.
      607   end procedure.
      608   Main-Block:
      609   DO ON ERROR   UNDO Main-Block, LEAVE Main-Block
      610      ON END-KEY UNDO Main-Block, LEAVE Main-Block :
      611     RUN tax-name IN THIS-PROCEDURE ( INPUT 'rdt':U, OUTPUT v_road-tax-label ) NO-ERROR.
      612     ASSIGN d-slts-vats-cons-fin.road-tax      :LABEL IN BROWSE b-slts-vats-cons      = v_road-tax-label
      613            d-slts-vats-cons-grp-fin.road-tax  :LABEL IN BROWSE b-slts-vats-cons-grp  = v_road-tax-label
      614            d-supp-slts-vats-cons-fin.road-tax :LABEL IN BROWSE b-supp-slts-vats-cons = v_road-tax-label
      615            d-slt-vat-cons-grp-fin.road-tax    :LABEL IN BROWSE b-slt-vat-cons-grp    = v_road-tax-label
      616            d-slt-vat-cons-fin.road-tax        :LABEL IN BROWSE b-slt-vat-cons        = v_road-tax-label
      617            tt-title-fin.road-tax              :LABEL IN BROWSE b-title               = v_road-tax-label
      618            d-supp-fin.road-tax                :LABEL IN BROWSE b-supp                = v_road-tax-label
      619            d-supp-grp-fin.road-tax            :LABEL IN BROWSE b-supp-grp            = v_road-tax-label.
      620     DISPLAY                      table-type WITH FRAME fr-D-SplitByContract-8.
      621     ENABLE  Btn_Exit b-help table-type WITH FRAME fr-D-SplitByContract-8.
      622     APPLY   "VALUE-CHANGED":U TO table-type   IN FRAME fr-D-SplitByContract-8.
      623     WAIT-FOR GO OF FRAME fr-D-SplitByContract-8.
      624   END.
      625   HIDE FRAME fr-D-SplitByContract-8 NO-PAUSE.
