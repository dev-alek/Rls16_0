        1   block-level on error undo, throw.
        2   define input parameter p-doc-code as character no-undo .
        3   define input parameter p-obj-type as character no-undo .
        4   define input parameter p-obj-code as integer no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: del-invc.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/del-invc.p $":U .
       10   define variable vss-description as character no-undo init "Удаление чеков по инвентаризации".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable ii as integer no-undo .
       81   _main:
       82   do
       83   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       84   :
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   .
       87   FOR EACH ub.chk-doc WHERE
       88             ub.chk-doc.obj-type = p-obj-type AND
       89             ub.chk-doc.obj-code = p-obj-code AND
       90             ub.chk-doc.out-code = p-doc-code
       91   on error undo _main, return error substitute("Ошибка при удалении/отвязывании чеков при удалении документа &1", p-doc-code)
       92             :
       93       FOR EACH ub.chk-gds WHERE
       94                 ub.chk-gds.doc-code = ub.chk-doc.doc-code :
       95         if g#news then do:
       96           delete ub.chk-gds.
       97         end.
       98         else do:
       99           ub.chk-gds.out-code = ? .
      100           for each ub.marking-chk where ub.marking-chk.doc-code = ub.chk-gds.doc-code
      101                                     and ub.marking-chk.line-num = ub.chk-gds.line-num :
      102             ub.marking-chk.sts = 0 .
      103           end .
      104         end.
      105       END .
      106       FOR EACH ub.chk-pay WHERE
      107                 ub.chk-pay.doc-code = ub.chk-doc.doc-code :
      108         if g#news then do:
      109           delete ub.chk-pay.
      110         end.
      111         else do:
      112           ub.chk-pay.out-code = ? .
      113         end.
      114       END .
      115       FOR EACH ub.chk-discnt WHERE
      116                 ub.chk-discnt.doc-code = ub.chk-doc.doc-code :
      117         if g#news then do:
      118           delete ub.chk-discnt.
      119         end.
      120         else do:
      121           ub.chk-discnt.out-code = ? .
      122         end.
      123       END .
      124       FOR EACH ub.chk-doc-attr WHERE
      125                 ub.chk-doc-attr.doc-code = ub.chk-doc.doc-code :
      126         if g#news then do:
      127           delete ub.chk-doc-attr.
      128         end.
      129         else do:
      130            ub.chk-doc-attr.out-code = ?.
      131         end.
      132       END .
      133       FOR EACH ub.chk-gds-pay WHERE
      134                ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code :
      135         delete ub.chk-gds-pay.
      136       END .
      137       FOR EACH ub.c-chk-gds WHERE
      138                 ub.c-chk-gds.doc-code = ub.chk-doc.doc-code :
      139         if g#news then do:
      140           delete ub.c-chk-gds.
      141         end.
      142         else do:
      143           ub.c-chk-gds.out-code = ? .
      144         end.
      145       END .
      146       FOR EACH ub.c-chk-pay WHERE
      147                 ub.c-chk-pay.doc-code = ub.chk-doc.doc-code :
      148         if g#news then do:
      149           delete ub.c-chk-pay.
      150         end.
      151         else do:
      152           ub.c-chk-pay.out-code = ? .
      153         end.
      154       END .
      155       FOR EACH ub.c-chk-discnt WHERE
      156                 ub.c-chk-discnt.doc-code = ub.chk-doc.doc-code :
      157         if g#news then do:
      158           delete ub.c-chk-discnt.
      159         end.
      160         else do:
      161           ub.c-chk-discnt.out-code = ? .
      162         end.
      163       END .
      164       FOR EACH ub.c-chk-doc-attr WHERE
      165                 ub.c-chk-doc-attr.doc-code = ub.chk-doc.doc-code :
      166         if g#news then do:
      167           delete ub.c-chk-doc-attr.
      168         end.
      169       END .
      170       FOR EACH ub.c-chk-doc WHERE
      171                 ub.c-chk-doc.doc-code = ub.chk-doc.doc-code :
      172         if g#news then do:
      173           delete ub.c-chk-doc.
      174         end.
      175         else do:
      176           ub.c-chk-doc.out-code = ? .
      177         end.
      178       END .
      179       if g#news then do:
      180         delete ub.chk-doc.
      181       end.
      182       else do:
      183         assign
      184         ub.chk-doc.out-code = ?
      185         ii = ii + 1
      186         .
      187       end.
      188           .
      189   END .
      190   end.
