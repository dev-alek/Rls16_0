     7155     then do:
     7156       for each buf_gds-list-hist where
     7157                buf_gds-list-hist.id = p-id
     7158           and  buf_gds-list-hist.item_  <> '':U:
     7159         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7160         find clients where rowid (clients) = v-rowid no-lock.
