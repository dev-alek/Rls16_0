     4127     if available buf_bar-code then do:
     4128           find first l-goods where
     4129                     l-goods.gds-code =
     4130     buf_bar-code.gds-code No-LOCK.
     4131           find first l-gds-list where
     4132                     l-gds-list.artic = l-goods.artic AND
     4133                     l-gds-list.prod-type = l-goods.prod-type AND
     4134                     l-gds-list.prod-code = l-goods.prod-code no-lock no-error.
     4135       if available l-gds-list then do:
     4136         line-rec = recid (l-gds-list).
     4137         reposition br-list to recid line-rec no-error.
     4138         apply "value-changed" to br-list in frame Dialog-Frame.
     4139       end.
     4140       else do:
     4141         message "Строка не найдена."
     4142                 view-as alert-box error.
     4143       end.
     4144     end.
     4145     else
     4146       message "Бар-код не найден."
     4147               view-as alert-box error.
     4148     apply "entry" to loc-code in frame Dialog-Frame.
     4149   END PROCEDURE.
     4150   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4151     assign
     4152     frame Dialog-Frame
     4153     loc-name.
     4154       if last-event:label = "Ctrl-J" then
     4155         find next l-gds-list where
     4156                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4157                   ub.goods.prod-type = l-gds-list.prod-type and
     4158                   ub.goods.prod-code = l-gds-list.prod-code and
     4159                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4160       else
     4161         find first l-gds-list where
     4162                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4163                   ub.goods.prod-type = l-gds-list.prod-type and
     4164                   ub.goods.prod-code = l-gds-list.prod-code and
     4165                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4166       if available l-gds-list then do:
     4167         line-rec = recid (l-gds-list).
     4168         reposition br-list to recid line-rec no-error.
     4169            apply "value-changed" to br-list in frame Dialog-Frame.
     4170       end.
     4171       else do:
     4172         message "Строка не найдена."
     4173                 view-as alert-box error.
     4174       end.
     4175     apply "entry" to loc-name in frame Dialog-Frame.
     4176   END PROCEDURE.
     4177   on value-changed of br-list in frame Dialog-Frame do:
     4178   if not available gds-list or recid (gds-list) <> line-rec then do:
     4179       hide loc-art in frame Dialog-Frame.
     4180       loc-art = "".
     4181   end.
     4182   if available gds-list then do:     find ub.clients where ub.clients.obj-type = gds-list.prod-type                    and ub.clients.obj-code = gds-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     4183   end.
