     3298   define variable vss-include-info21 as character format "X(65)" no-undo
     3299   initial "@(#)$Workfile$ $Revision$".
     3300   procedure grplib-get-full-name :
     3301      define input parameter p-node-code  as integer      no-undo.
     3302      define output parameter p-full-name as character    no-undo.
     3303      do
     3304   on error undo, return error
     3305   :
     3306       define variable v-upper-code    as integer           no-undo.
     3307       define buffer buf_gds-grp       for ub.gds-grp.
     3308       define buffer buf_upper_gds-grp for ub.gds-grp.
     3309       find first buf_gds-grp no-lock
     3310            where buf_gds-grp.node-code = p-node-code
     3311       no-error.
     3312       if not available buf_gds-grp
     3313       then do:
     3314           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3315       end.
     3316       assign
     3317           p-full-name  = ""
     3318           v-upper-code = 1
     3319       .
     3320       do while buf_gds-grp.upper-code <> 0
     3321       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3322       :
     3323           assign
     3324               p-full-name  = buf_gds-grp.node-name
     3325                            + (if p-full-name <> "" then chr(47) else "")
     3326                            + p-full-name
     3327               v-upper-code = buf_gds-grp.upper-code
     3328           .
     3329           find first buf_gds-grp no-lock
     3330                where buf_gds-grp.node-code = v-upper-code
     3331           no-error.
     3332           if not available buf_gds-grp
     3333           then do:
     3334               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3335                                   + string( v-upper-code )
     3336                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3337           end.
     3338       end.
     3339       assign
     3340       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3341       .
     3342   end.
     3343   end .
     3344   procedure grplib-get-node-from-full-name :
     3345   define input parameter p-full-name as character no-undo .
     3346   define output parameter p-node-code as integer no-undo .
     3347   define variable v-ii as integer no-undo .
     3348   define variable v-upper-code as integer no-undo .
     3349   define variable v-root-code as integer no-undo .
     3350   define variable v-entry as character no-undo .
     3351   define buffer buf_gds-grp       for ub.gds-grp.
     3352   do
     3353   on error undo, return error
     3354   :
     3355     find first buf_gds-grp no-lock
     3356         where buf_gds-grp.upper-code = 0
     3357     no-error .
     3358     if not available buf_gds-grp
     3359     then do:
     3360         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3361     end.
     3362     else do:
     3363       assign
     3364       v-root-code = buf_gds-grp.node-code
     3365       .
     3366     end.
     3367     v-upper-code = v-root-code.
     3368     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3369       assign
     3370       v-entry = entry(v-ii, p-full-name, chr(47)).
     3371       if v-entry = '' then leave.
     3372       find first buf_gds-grp no-lock where
     3373                 buf_gds-grp.node-name = v-entry
     3374             and buf_gds-grp.upper-code = v-upper-code
     3375             no-error.
     3376       if not available buf_gds-grp then do:
     3377         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3378       end.
     3379       else do:
     3380         p-node-code = buf_gds-grp.node-code.
     3381         v-upper-code = buf_gds-grp.node-code.
     3382       end.
     3383     end.
     3384   end.
     3385   end .
     3386   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3387   procedure cli-grplib-get-full-name :
     3388      define input parameter  p-node-code  as integer      no-undo.
     3389      define output parameter p-full-name as character    no-undo.
     3390   do
     3391   on error undo, return error
     3392   :
     3393       define variable v-upper-code    as integer           no-undo.
     3394       define buffer buf_cli-grp       for ub.cli-grp.
     3395       define buffer buf_upper_cli-grp for ub.cli-grp.
     3396       find first buf_cli-grp no-lock
     3397            where buf_cli-grp.node-code = p-node-code
     3398       no-error.
     3399       if not available buf_cli-grp
     3400       then do:
     3401           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     3402       end.
     3403       assign
     3404           p-full-name  = ""
     3405           v-upper-code = 1
     3406       .
     3407       do while buf_cli-grp.upper-code <> 0
     3408       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3409       :
     3410           assign
     3411               p-full-name  = buf_cli-grp.node-name
     3412                            + (if p-full-name <> "" then chr(47) else "")
     3413                            + p-full-name
     3414               v-upper-code = buf_cli-grp.upper-code
     3415           .
     3416           find first buf_cli-grp no-lock
     3417                where buf_cli-grp.node-code = v-upper-code
     3418           no-error.
     3419           if not available buf_cli-grp
     3420           then do:
     3421               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     3422                                   + string( v-upper-code )
     3423                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3424           end.
     3425       end.
     3426       assign
     3427       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3428       .
     3429   end.
     3430   end .
     3431   procedure cgrplib-get-node-from-full-name :
     3432   define input parameter p-full-name as character no-undo .
     3433   define output parameter p-node-code as integer no-undo .
     3434   define variable v-ii as integer no-undo .
     3435   define variable v-upper-code as integer no-undo .
     3436   define variable v-root-code as integer no-undo .
     3437   define variable v-entry as character no-undo .
     3438   define buffer buf_cli-grp       for ub.cli-grp.
     3439   do
     3440   on error undo, return error
     3441   :
     3442     find first buf_cli-grp no-lock
     3443         where buf_cli-grp.upper-code = 0
     3444     no-error .
     3445     if not available buf_cli-grp
     3446     then do:
     3447         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     3448     end.
     3449     else do:
     3450       assign
     3451       v-root-code = buf_cli-grp.node-code
     3452       .
     3453     end.
     3454     v-upper-code = v-root-code.
     3455     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3456       assign
     3457       v-entry = entry(v-ii, p-full-name, chr(47)).
     3458       if v-entry = '' then leave.
     3459       find first buf_cli-grp no-lock where
     3460                 buf_cli-grp.node-name = v-entry
     3461             and buf_cli-grp.upper-code = v-upper-code
     3462             no-error.
     3463       if not available buf_cli-grp then do:
     3464         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3465       end.
     3466       else do:
     3467         p-node-code = buf_cli-grp.node-code.
     3468         v-upper-code = buf_cli-grp.node-code.
     3469       end.
     3470     end.
     3471   end.
     3472   end .
