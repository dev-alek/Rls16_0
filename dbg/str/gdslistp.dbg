     4897     define variable v-window-width         as decimal   no-undo .
     4898     define variable v-window-virtual-width as decimal   no-undo .
     4899     define variable v-change-sign          as integer   no-undo .
     4900     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4901     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4902     if p-change-value > 0
     4903     then do:
     4904       if frame Dialog-Frame :width + p-change-value >
     4905           session :width-chars
     4906       then do:
     4907         assign
     4908           p-change-value = session :width-chars - frame Dialog-Frame :width
     4909         .
     4910         if p-change-value <= 0
     4911         then do:
     4912           run diasize_position-resize-button in this-procedure .
     4913           return .
     4914         end.
     4915       end.
     4916     end.
     4917     if p-change-value < 0
     4918     then do:
     4919       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4920       then do:
     4921         assign
     4922           p-change-value = v-diasize-orig-frame-width
     4923                          - frame Dialog-Frame :width
     4924         .
     4925         if p-change-value >= 0
     4926         then do:
     4927           run diasize_position-resize-button in this-procedure .
     4928           return .
     4929         end.
     4930       end.
     4931     end.
     4932     if p-change-value >= 0
     4933     then do:
     4934       assign
     4935         v-change-sign = 1
     4936       .
     4937     end.
     4938     else do:
     4939       assign
     4940         v-change-sign = -1
     4941       .
     4942     end.
     4943     assign
     4944       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4945     .
     4946     if p-change-value = 0
     4947     then do:
     4948       run diasize_position-resize-button in this-procedure .
     4949       return .
     4950     end.
