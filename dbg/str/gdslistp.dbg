     5998   END PROCEDURE.
     5999   procedure proc-b-macro :
     6000   define input parameter p-option as character no-undo .
     6001   define variable glog as logical no-undo .
     6002   define variable v-id as integer no-undo .
     6003   define variable v-result as character no-undo .
     6004   define variable v-des as character no-undo .
     6005   define variable v-hist-mode as character no-undo .
     6006   define variable v-file as logical no-undo .
     6007   define variable v-full-path        as character no-undo .
     6008   define variable v-path             as character no-undo .
     6009   define variable v-file-name        as character no-undo .
     6010   define variable v-file-name-no-ext as character no-undo .
     6011   define variable v-file-name-ext    as character no-undo .
     6012   define variable v-rid-list as character no-undo .
     6013   define variable v-ok as logical no-undo .
     6014   define buffer buf_gds-list-hist for gds-list-hist.
     6015   define buffer buf_clob-bind for ub.clob-bind.
     6016   define buffer buf_clob-data for ub.clob-data.
     6017   do
     6018   on error undo, return error
     6019   :
     6020     if v-macro-is-running then do:
     6021     end.
     6022     else do:
     6023       glog = yes.
     6024       if an-listp-start-macro-id >= 1 then do:
     6025         case p-option:
     6026           when "file" then do:
     6027         message
     6028         "Согласно командам формирования списка из записанного макроса"
     6029         view-as alert-box question buttons OK-Cancel update glog.
     6030           end.
     6031           when "lob" then do:
     6032             message
     6033             "Нелья!"
     6034             view-as alert-box question buttons OK-Cancel update glog.
     6035             run ui-on in this-procedure .
     6036             return error.
     6037           end.
     6038         end case.
     6039         if not glog then do:
     6040           run ui-on in this-procedure .
     6041           return error.
     6042         end.
     6043         if an-listp-end-macro-id = ? then do:
     6044           assign
     6045           an-listp-end-macro-id  = v-seq.
     6046           for each macro-list-hist:
     6047             delete macro-list-hist.
     6048           end.
     6049           for each buf_gds-list-hist where
     6050                   buf_gds-list-hist.id >=  an-listp-start-macro-id
     6051             and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     6052             create macro-list-hist.
     6053             buffer-copy buf_gds-list-hist
     6054             except id num-recs num-add num-ignored
     6055             to macro-list-hist
     6056             assign
     6057             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6058             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6059             macro-list-hist.done = no
     6060             .
     6061           end.
     6062         end.
     6063         else do:
     6064           find last macro-list-hist no-error.
     6065           if available macro-list-hist then do:
     6066             v-id = macro-list-hist.id.
     6067           end.
     6068         end.
     6069       end.
     6070       else do:
     6071         case p-option:
     6072           when "file" then do:
     6073         message
     6074         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6075         view-as alert-box question buttons OK-Cancel update glog.
     6076         if not glog then do:
     6077           run ui-on in this-procedure .
     6078           return error.
     6079         end.
     6080         system-dialog get-file f-name
     6081           filters "Макрос формирования списка *.gdm" "*.gdm"
     6082           title "Выберите файл макроса"
     6083           INITIAL-DIR "."
     6084           return-to-start-dir
     6085           must-exist
     6086           update glog
     6087           default-extension "gdm".
     6088         if not glog then do:
     6089           run ui-on in this-procedure .
     6090           return error.
     6091         end.
     6092           end.
     6093           when "lob" then do:
     6094             message
     6095             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6096             view-as alert-box question buttons OK-Cancel update glog.
     6097             if not glog then do:
     6098               run ui-on in this-procedure .
     6099               return error.
     6100             end.
     6101             run ref/clobbnds.w ( input parparentproc
     6102                                 ,input this-procedure:handle
     6103                                 ,input 'b-sel'
     6104                                 ,input "uniq-key-rec"
     6105                                 ,input ""
     6106                                 ,input 'list-macro':U
     6107                                 ,input 'gds-list'
     6108                                 ,input -1
     6109                                 ,input-output v-rid-list) no-error.
     6110             if v-rid-list = '' then do:
     6111               run ui-on in this-procedure.
     6112               return error.
     6113             end.
     6114             find first buf_clob-bind no-lock where
     6115                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6116             if not available buf_clob-bind then do:
     6117               message
     6118               "Не найдена ссылка на макрос, сохраненный в БД!"
     6119               view-as alert-box error .
     6120               run ui-on in this-procedure .
     6121               return error.
     6122             end.
     6123             find first buf_clob-data no-lock where
     6124                       buf_clob-data.db-num = buf_clob-bind.db-num
     6125                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6126             if not available buf_clob-data then do:
     6127               message
     6128               "Не найдена ссылка на макрос, сохраненный в БД!"
     6129               view-as alert-box error .
     6130               run ui-on in this-procedure .
     6131               return error.
     6132             end.
     6133             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6134               message
     6135               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6136                         , buf_clob-data.db-num
     6137                         , chr(10))
     6138              view-as alert-box question buttons yes-no update v-ok.
     6139              if not v-ok then do:
     6140                 run ui-on in this-procedure .
     6141                 return error.
     6142              end.
     6143             end.
     6144             run gbl/_tmpfile.p ( input ""
     6145                           ,input "tmp"
     6146                           ,output v-file-name) .
     6147             copy-lob from object buf_clob-data.cdata
     6148             to file f-name.
     6149             run gbl/filename.p
     6150               (input  v-file-name
     6151               ,output f-name
     6152               ,output v-path
     6153               ,output v-file-name
     6154               ,output v-file-name-no-ext
     6155               ,output v-file-name-ext
     6156               ) no-error .
     6157             if error-status:error then do:
     6158             end.
     6159           end.
     6160         end case.
     6161         for each macro-list-hist:
     6162           delete macro-list-hist.
     6163         end.
     6164         input stream sout from value (f-name).
     6165         _macro:
     6166         repeat:
     6167           create macro-list-hist.
     6168           import stream sout macro-list-hist no-error.
     6169           if error-status:error then do:
     6170               undo _macro, next _macro.
     6171           end.
     6172           assign
     6173           macro-list-hist.num-rec = 0
     6174           macro-list-hist.num-add = 0
     6175           macro-list-hist.num-ignored = 0
     6176           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6177           macro-list-hist.done = no
     6178           .
     6179         end.
     6180         find first macro-list-hist where
     6181                 macro-list-hist.id = 0.
     6182         delete macro-list-hist.
     6183         input stream sout close.
     6184         If p-option = "lob" then do:
     6185          os-delete value(f-name).
     6186         end.
     6187         v-file = yes.
     6188       end.
     6189       an-listp-macros-label-id = v-seq.
     6190       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6191                                           , input-output v-seq
     6192                                           , input 0
     6193                                           , input '>':U
     6194                                           , input (if v-file
     6195                                                   then substitute("Файл макроса : &1", f-name)
     6196                                                   else substitute("Записанный макрос")
     6197                                                   )
     6198                                           , input tot-lns
     6199                                           , input 'macro':U
     6200                                           , input '':U
     6201                                           , input (if v-file then f-name else '':U)
     6202                                           , input '':U
     6203                                           , input ?
     6204                                           ).
     6205     end.
     6206     disable
     6207     b-record
     6208     b-macro
     6209     with frame Dialog-Frame .
     6210     hide
     6211     b-record in frame Dialog-Frame .
     6212     enable
     6213     b-clear-macro with frame Dialog-Frame .
     6214     v-macro-is-running = yes.
     6215     run str/listmcro.w (input parparentproc
     6216                   ,input this-procedure:handle
     6217                   ,input "Макрос формирования списка товаров" + chr(4) + "gdm"
     6218                   ,input "b-play,b-step"
     6219                   ,input-output v-current-step
     6220                   ,input v-id
     6221                   ,output v-result) no-error .
     6222     if error-status:error
     6223     or v-result = "b-stop"
     6224     or v-result = 'end':U
     6225     then do:
     6226       for each macro-list-hist:
     6227         delete macro-list-hist.
     6228       end.
     6229       assign
     6230       an-listp-start-macro-id = ?
     6231       an-listp-end-macro-id = ?
     6232       an-listp-macros-label-id = 0
     6233       .
     6234       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6235       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6236       if v-result = 'b-stop' then do:
     6237         assign
     6238         v-hist-mode = '[]':U
     6239         v-des = "Выполнение макроса прекращено пользователем"
     6240         .
     6241         hide
     6242         b-clear-macro
     6243         b-stop
     6244         in frame Dialog-Frame .
     6245         enable
     6246         b-record
     6247         with frame Dialog-Frame .
     6248       end.
     6249       if v-result = 'end' then do:
     6250         assign
     6251         v-hist-mode = '<':U
     6252         v-des = "Выполнение макроса завершено"
     6253         .
     6254         hide
     6255         b-clear-macro
     6256         b-stop
     6257         in frame Dialog-Frame .
     6258         enable
     6259         b-record
     6260         with frame Dialog-Frame .
     6261       end.
     6262       if error-status:error then do:
     6263         assign
     6264         v-hist-mode = 'E':U
     6265         v-des = "Выполнение макроса прекращено из-за ошибки"
     6266         .
     6267       end.
     6268       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6269                                           , input-output v-seq
     6270                                           , input 0
     6271                                           , input v-hist-mode
     6272                                           , input v-des
     6273                                           , input tot-lns
     6274                                           , input 'macro':U
     6275                                           , input '':U
     6276                                           , input f-name
     6277                                           , input '':U
     6278                                           , input ?
     6279                                           ) no-error .
     6280       assign
     6281       v-macro-is-running = no
     6282       v-current-step = 0
     6283       .
     6284     end.
     6285     enable
     6286     b-macro
     6287     with frame Dialog-Frame .
     6288   end.
     6289   end procedure.
     6290   procedure proc-create-macro-list-hist :
     6291   define input parameter p-list-table as character no-undo .
     6292   define input parameter p-id as integer           no-undo .
     6293   define input parameter p-line as integer         no-undo .
     6294   define input parameter p-hist-mode as character  no-undo .
     6295   define input parameter p-des as character        no-undo .
     6296   define input parameter p-option_ as character    no-undo .
     6297   define input parameter p-item_ as character      no-undo .
     6298   define input parameter p-status_ as character    no-undo .
     6299   define buffer buf_macro-list-hist for macro-list-hist.
     6300   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6301     do
     6302     on error undo, return error return-value
     6303     :
     6304       create buf_macro-list-hist.
     6305       assign
     6306       buf_macro-list-hist.list-table = p-list-table
     6307       buf_macro-list-hist.id         = p-id
     6308       buf_macro-list-hist.line       = p-line
     6309       buf_macro-list-hist.hist-mode  = p-hist-mode
     6310       buf_macro-list-hist.des        = p-des
     6311       buf_macro-list-hist.option_    = p-option_
     6312       buf_macro-list-hist.item_      = p-item_
     6313       buf_macro-list-hist.status_    = p-status_
     6314       .
     6315       if p-keep-query then do:
     6316         create buf_keep-macro-list-hist.
     6317         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6318       end.
     6319     end.
     6320   end procedure.
     6321   procedure proc-macro-play :
     6322   define input parameter p-id as integer no-undo .
     6323   define input parameter p-step as logical no-undo .
     6324   define input parameter p-max-id as integer no-undo .
     6325   define variable v-id as integer no-undo .
     6326   define variable v-rowid   as rowid no-undo .
     6327   define variable v-tbl-name as character no-undo .
     6328   define variable v-old-seq as integer no-undo .
     6329   define variable v-current-id as integer no-undo .
     6330   define variable v-temp-seq as integer no-undo .
     6331   define variable v-rs-do-error as logical no-undo .
     6332   define  buffer buf_macro-list-hist for macro-list-hist.
     6333   define  buffer buf_gds-list-hist for gds-list-hist.
     6334   do
     6335   on error undo, return error return-value
     6336   :
     6337     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6338       assign
     6339       v-current-id = v-current-id + 1
     6340       v-id = macro-list-hist.id.
     6341       CASE entry(1, macro-list-hist.option_, chr(4)):
     6342         when 'macro':U
     6343         or
     6344         when 'title':U
     6345         or
     6346         when 'start':U
     6347         then do:
     6348         end.
     6349         when 'clear':U then do:
     6350           for each gds-list:
     6351             delete gds-list.
     6352           end.
     6353           for each gds-list-hist where gds-list-hist.id > an-listp-macros-label-id:
     6354             delete gds-list-hist.
     6355           end.
     6356           tot-lns = 0.
     6357           v-seq = an-listp-macros-label-id + 1.
     6358           v-no-hist = 0.
     6359           create buf_gds-list-hist.
     6360           buffer-copy macro-list-hist
     6361           to buf_gds-list-hist
     6362           assign buf_gds-list-hist.id = v-seq
     6363           v-temp-seq = v-seq
     6364           v-seq = v-seq + 1
     6365           v-no-hist = v-no-hist + 1
     6366           .
     6367           run ui-on in this-procedure .
     6368         end.
     6369         when 'single' then do:
     6370            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6371                                                 ,input ?
     6372                                                 ,input 'ub'
     6373                                                 ,input ?
     6374                                                 ,input no-lock
     6375                                                 ,output v-rowid
     6376                                                 ,output v-tbl-name) no-error .
     6377           if not error-status:error then do:
     6378             CASE macro-list-hist.hist-mode:
     6379               when '+':U then do:
     6380                 run proc-b-add in this-procedure(input yes
     6381                                                 ,input v-rowid
     6382                                                 ,input macro-list-hist.option_
     6383                                                 ,input macro-list-hist.status_) no-error .
     6384               end.
     6385               when '-':U then do:
     6386                 run proc-b-del in this-procedure(input yes
     6387                                                 ,input v-rowid
     6388                                                 ,input macro-list-hist.option_
     6389                                                 ,input macro-list-hist.status_) no-error .
     6390               end.
     6391               when '*':U then do:
     6392                 run proc-b-rest in this-procedure(input yes
     6393                                                  ,input v-rowid
     6394                                                  ,input macro-list-hist.option_
     6395                                                  ,input macro-list-hist.status_) no-error .
     6396               end.
     6397             END.
     6398             if error-status:error then do:
     6399                 return ("error" + chr(4) + return-value) .
     6400             end.
     6401             find first  buf_gds-list-hist where
     6402                     buf_gds-list-hist.id = v-seq - 1 no-error .
     6403             if available buf_gds-list-hist then
     6404             assign
     6405             macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6406             macro-list-hist.num-add = buf_gds-list-hist.num-add
     6407             macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6408             .
     6409           end.
     6410           else do:
     6411             return ("error" + chr(4) + return-value).
     6412           end.
     6413         end.
     6414         otherwise do:
     6415           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6416           or lookup(macro-list-hist.option_, '':U) > 0
     6417           then do:
     6418             if macro-list-hist.line = 0 then do:
     6419               v-no-hist = 0.
     6420               for each buf_macro-list-hist where
     6421                       buf_macro-list-hist.id = v-id:
     6422                 create buf_gds-list-hist.
     6423                 buffer-copy buf_macro-list-hist
     6424                 except id  num-recs num-add num-ignored done
     6425                 to buf_gds-list-hist
     6426                 assign
     6427                 buf_gds-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6428                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6429                 v-seq = (if buf_macro-list-hist.line = 0
     6430                         then (v-seq + 1)
     6431                         else v-seq)
     6432                 v-no-hist = v-no-hist + 1
     6433                 .
     6434               end.
     6435               if v-no-hist = 1 then v-no-hist = 0.
     6436               run rs-do in this-procedure (input yes
     6437                                         , input p-step
     6438                                         , input macro-list-hist.option_
     6439                                         , input macro-list-hist.status_
     6440                                         , input get-line-mode(macro-list-hist.hist-mode)
     6441                                         , input v-temp-seq
     6442                                         ) no-error .
     6443               if error-status:error then do:
     6444                 assign
     6445                 v-rs-do-error = yes.
     6446               end.
     6447               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6448                 run proc-b-rest-2 in this-procedure .
     6449                 run ui-on in this-procedure .
     6450               end.
     6451               for each buf_gds-list-hist where
     6452                       buf_gds-list-hist.id = v-temp-seq,
     6453                  first buf_macro-list-hist where
     6454                       buf_macro-list-hist.id = v-id
     6455                   AND buf_macro-list-hist.line = buf_gds-list-hist.line:
     6456                  assign
     6457                  buf_macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6458                  buf_macro-list-hist.num-add = buf_gds-list-hist.num-add
     6459                  buf_macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6460                  .
     6461               end.
     6462               if v-rs-do-error then do:
     6463                 run ui-on in this-procedure .
     6464                 return ("error" + chr(4) + return-value).
     6465               end.
     6466               v-id = macro-list-hist.id.
     6467             end.
     6468           end.
     6469         end.
     6470       END CASE.
     6471     end.
     6472   end.
     6473   end procedure.
     6474   procedure proc-b-rest-2 :
     6475     do
     6476     on error undo, return error
     6477     :
     6478       for each gds-list:
     6479         if gds-list.to-del = ? then do:
     6480           assign
     6481           gds-list.to-del = no
     6482           .
     6483         end.
     6484         else do:
     6485           delete gds-list.
     6486         end.
     6487       end.
     6488       tot-lns = lns-cnt.
     6489     end.
     6490   end procedure.
     6491   PROCEDURE proc-expand :
     6492   define input parameter p-shift as integer no-undo .
     6493   define input parameter p-from as integer no-undo .
     6494   define input parameter p-to as integer no-undo .
     6495   define input parameter p-forcer-name as character no-undo .
     6496   define variable fh as widget-handle no-undo .
     6497   define variable hh as widget-handle no-undo .
     6498   define variable lh as widget-handle no-undo .
     6499   define variable ii as INTEGER no-undo .
     6500   ASSIGN
     6501   fh = frame Dialog-Frame:first-child
     6502   hh = fh:first-child
     6503   .
     6504   CASE v-expand:
     6505     WHEN YES THEN DO:
     6506       ASSIGN
     6507       v-expand = NO.
     6508       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6509         ASSIGN
     6510         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6511         hh:ROW          = (hh:ROW - p-shift).
     6512         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6513       END.
     6514     END.
     6515     WHEN NO THEN DO:
     6516       v-expand = YES.
     6517       v-downed = ''.
     6518       _do:
     6519       do while valid-handle(hh):
     6520         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6521          AND hh:ROW >= p-from
     6522          AND hh:ROW <= p-to
     6523          and lookup(hh:name, p-forcer-name) = 0
     6524          THEN DO:
     6525           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6526           hh:ROW          = (hh:ROW + p-shift).
     6527           ASSIGN
     6528           v-downed = v-downed + chr(44) + STRING(hh).
     6529           IF hh:TYPE = "fill-in"
     6530           AND valid-handle(hh:side-label-handle) THEN dO:
     6531             assign
     6532             lh = hh:SIDE-LABEL-HANDLE
     6533             lh:ROW = lh:ROW + p-shift
     6534             v-downed = v-downed + chr(44) + STRING(lh)
     6535             .
     6536            END.
     6537          END.
     6538          hh = hh:next-sibling.
     6539       END.
     6540       v-downed = trim(v-downed, chr(44)).
     6541     END.
     6542   END CASE.
     6543   END PROCEDURE.
     6544   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     6545   DO:
     6546   define variable glog as logical no-undo .
     6547   define buffer buf_gds-list for gds-list.
     6548   if available gds-list then   do:
     6549     find first buf_gds-list where
     6550              recid(buf_gds-list) = recid(gds-list).
     6551     assign
     6552     buf_gds-list.to-sel = not (buf_gds-list.to-sel).
     6553     glog = br-list:refresh().
     6554     if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK,RETURN":U) = 0  then  do:
     6555        glog = br-list:select-next-row ().
     6556        APPLY "VALUE-CHANGED" to br-list.
     6557     end.
     6558   end.
     6559   APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6560   END.
     6561   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     6562   DO:
     6563   define buffer buf_gds-list for gds-list.
     6564   if not available gds-list then return no-apply.
     6565   find first buf_gds-list where
     6566             recid(buf_gds-list) = recid(gds-list).
     6567   assign
     6568   buf_gds-list.to-sel = not (buf_gds-list.to-sel)
     6569   .
     6570   APPLY "CHOOSE" to b-exit.
     6571   END.
     6572   if lookup(bttns, "hide") = 0 then do:
     6573     run diasize_add_browse in this-procedure
     6574       (input  'height':u
     6575       ,input  browse BR-option :handle
     6576       ) .
     6577     run diasize_init in this-procedure .
     6578   end.
     6579   define variable v-ok as logical   no-undo .
     6580   assign
     6581     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6582   .
     6583   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     6584   MAIN-BLOCK:
     6585   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6586     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6587   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6588   define variable varscales-pref-type42 as character no-undo.
     6589   varscales-pref  = ?.
     6590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6591     (input  'sclspref':u
     6592     ,input  '':u
     6593     ,input  '':u
     6594     ,input  0
     6595     ,input  '':u
