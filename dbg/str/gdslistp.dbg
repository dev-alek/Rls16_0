    11313   PROCEDURE trig-dis-gds-rule :
    11314   define variable v-rid-list as character no-undo .
    11315   define variable v-pos-type as character no-undo .
    11316   define variable v-templ-rl-root as integer no-undo .
    11317   define variable v-time-templ-rl-root as integer no-undo .
    11318   define variable v-cfg-nonunique as character no-undo .
    11319   define variable v-nonunique as character no-undo .
    11320   define variable v-discnt-role as character no-undo .
    11321   define variable v-obj-type as character no-undo .
    11322   define variable v-obj-code as integer no-undo .
    11323   define variable r-b-code as integer no-undo .
    11324   define variable v-sts as integer no-undo .
    11325   define variable glog as logical no-undo .
    11326   define variable v-mode as character no-undo .
    11327   define variable v-item as character no-undo .
    11328   define variable v-rule-num as integer no-undo .
    11329   define variable dflt-cd as character no-undo .
    11330   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    11331   define buffer buf_dis-rule for ub.dis-rule.
    11332   if v-cntxt-obj-type = 'скл':U then do:
    11333     dflt-cd = '-':U.
    11334   end.
    11335   else do:
    11336   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11337   define variable v-param-type72 as character no-undo .
    11338   define variable v-value-date72 as date no-undo .
    11339   define variable v-value-decimal72 as decimal no-undo .
    11340   define variable v-value-integer72 as INTEGER no-undo .
    11341   define variable v-value-logical72 AS LOGICAL no-undo .
    11342   define variable v-tth72 as handle no-undo .
    11343   run adm/shattri.p (
    11344       input "get":U
    11345       ,input  v-cntxt-obj-type
    11346       ,input  v-cntxt-obj-code
    11347       ,input  'cd-sending':U
    11348       ,input  'dflt-cd':U
    11349       ,output dflt-cd
    11350       ,output v-value-date72
    11351       ,output v-value-decimal72
    11352       ,output v-value-integer72
    11353       ,output v-value-logical72
    11354       ,output v-param-type72
    11355       ,INPUT-OUTPUT table-handle v-tth72
    11356       )  .
    11357   delete object v-tth72 no-error.
    11358     assign
    11359     v-pos-type = dflt-cd + chr(44) + '-':U + chr(44) + 'bo':U.
    11360   end.
    11361   run ref/dis-pos.w ( INPUT parparentproc
    11362                       ,INPUT "b-sel":U
    11363                       ,INPUT (if rs-list-method = "dis-gds-rule"
    11364                              then "cd-type-list-without-template-pos"
    11365                              else "cd-type-list")
    11366                       ,INPUT 1
    11367                       ,INPUT 1
    11368                       ,INPUT 1
    11369                       ,input 'dis-gds-rule':U
    11370                       ,input '':U
    11371                       ,input ?
    11372                       ,INPUT v-pos-type
    11373                       ,input '':U
    11374                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
    11375   IF ERROR-STATUS:ERROR
    11376   OR v-rid-list = '':U THEN DO:
    11377     RETURN.
    11378   END.
    11379   FIND FIRST buf_dis-cfg-rule NO-LOCK where
    11380             recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
    11381   assign
    11382   v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
    11383   v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
    11384   V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
    11385   v-discnt-role = buf_dis-cfg-rule.discnt-role
    11386   .
    11387   if rs-list-method = "dis-gds-rule" then do:
    11388     message
    11389     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) skip
    11390     stat-line(rs-status)
    11391     view-as alert-box question buttons OK-Cancel update glog.
    11392   end.
    11393   else do:
    11394     message
    11395     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) "и определенным номером правила скидки" skip
    11396     stat-line(rs-status)
    11397     view-as alert-box question buttons OK-Cancel update glog.
    11398   end.
    11399   if not glog then do:
    11400     return error.
    11401   end.
    11402   if (buf_dis-cfg-rule.has-global +
    11403       buf_dis-cfg-rule.has-host +
    11404       buf_dis-cfg-rule.has-obj) > 1 then do:
    11405     define variable v-sel-vals as character no-undo .
    11406     define variable v-sel-labels as character no-undo .
    11407     define variable var-region as character no-undo .
    11408     assign
    11409     v-sel-vals = v-sel-vals +
    11410                   (if buf_dis-cfg-rule.has-global = 1
    11411                   then (fill(chr(32), 3)  + string(0) + chr(4) )
    11412                   else "":U)
    11413     v-sel-labels = v-sel-labels +
    11414                   (if buf_dis-cfg-rule.has-global  = 1
    11415                   then ("Глобально" + chr(4) )
    11416                   else "":U)
    11417     .
    11418     assign
    11419     v-sel-vals = v-sel-vals +
    11420                   (if buf_dis-cfg-rule.has-host = 1
    11421                   then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(4) )
    11422                   else "":U)
    11423     v-sel-labels = v-sel-labels +
    11424                   (if buf_dis-cfg-rule.has-host = 1
    11425                   then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(4) )
    11426                   else "":U)
    11427     .
    11428     assign
    11429     v-sel-vals = v-sel-vals +
    11430                   (if buf_dis-cfg-rule.has-obj = 1
    11431                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11432                   else "":U)
    11433     v-sel-labels = v-sel-labels +
    11434                   (if buf_dis-cfg-rule.has-obj = 1
    11435                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11436                   else "":U)
    11437     .
    11438     run gbl/d-list.w (
    11439                         input "b-sel":U
    11440                         ,input "Выберите область действия"
    11441                         ,input v-sel-vals
    11442                         ,input v-sel-labels
    11443                         ,input chr(4)
    11444                         ,input "":U
    11445                         ,output var-region) no-error.
    11446     if error-status:error then do:
    11447       return error.
    11448     end.
    11449     assign
    11450     v-obj-type = substring(var-region, 1, 3)
    11451     v-obj-code = integer(substring(var-region, 4))
    11452     v-sel-obj-type = v-obj-type
    11453     v-sel-obj-code = v-obj-code
    11454     .
    11455   end.
    11456   else do:
    11457     if buf_dis-cfg-rule.has-obj = 1 then do:
    11458   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11459   run userobjs_select-one in this-procedure
    11460     (input  parparentproc
    11461     ,input  v-cntxt-db-num
    11462     ,input  v-cntxt-userid
    11463     ,input  v-cntxt-host-code-obj
    11464     ,input  v-cntxt-obj-type
    11465     ,input  v-cntxt-obj-code
    11466     ,output v-user-select
    11467     ,output v-sel-obj-type
    11468     ,output v-sel-obj-code
    11469     )  .
    11470       if not v-user-select then do:
    11471         return error.
    11472       end.
    11473       assign
    11474       v-obj-type = v-sel-obj-type
    11475       v-obj-code = v-sel-obj-code
    11476       .
    11477     end.
    11478     if buf_dis-cfg-rule.has-host = 1 then do:
    11479       define variable v-host-code as integer no-undo .
    11480       assign
    11481       v-obj-type = 'орг':U
    11482       v-obj-code = v-cntxt-host-code-obj
    11483       .
    11484     end.
    11485     if buf_dis-cfg-rule.has-glob = 1 then do:
    11486       assign
    11487       v-obj-type = '':U
    11488       v-obj-code = 0
    11489       .
    11490     end.
    11491   end.
    11492   if rs-list-method = "dis-gds-rule" then do:
    11493     assign
    11494     dsp-rs = substitute("ВСЕ товары с установленным типом скидки &1 &2"
    11495                       , get-objregion(v-obj-type, v-obj-code), stat-line(rs-status))
    11496     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-discnt-role   .
    11497   end.
    11498   else do:
    11499     v-mode = (if v-obj-type = 'маг':U
    11500               or v-obj-type = 'скл':U
    11501               then "upper-rule-num-object":u
    11502               else ('dis-gds-rule':U + "=" + v-discnt-role)).
    11503     run ref/dis-ruls.w (
    11504                  input parparentproc
    11505                 ,input 0
    11506                 ,input v-obj-type
    11507                 ,input v-obj-code
    11508                 ,input "b-add,b-sel":U
    11509                 ,input v-mode
    11510                 ,input v-templ-rl-root
    11511                 ,input v-time-templ-rl-root
    11512                 ,input r-b-code
    11513                 ,input-output v-sts
    11514                 ,input-output v-rid-list ) no-error .
    11515     if v-rid-list = '':u then do:
    11516       return error.
    11517     end.
    11518     find first buf_dis-rule no-lock where
    11519              recid(buf_dis-rule) = integer(v-rid-list) no-error.
    11520     if available buf_dis-rule then do:
    11521     assign
    11522     dsp-rs = substitute("ВСЕ товары с установленным типом скидки: &1, № правила &2 &3"
    11523                         ,get-objregion(v-obj-type, v-obj-code)
    11524                         ,v-rule-num
    11525                         ,stat-line(rs-status))
    11526     v-item = v-sel-obj-type + chr(3) +
    11527               string(v-sel-obj-code) + chr(3) +
    11528                 v-discnt-role + chr(3) + string(buf_dis-rule.rule-num)
    11529     .
    11530   end.
    11531     else do:
    11532       message
    11533       substitute("Не найдено провило скидки с recid &1", v-rid-list)
    11534       view-as alert-box error .
    11535       return error.
    11536     end.
    11537   end.
    11538   v-no-hist = 0.
    11539   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11540                                       , input-output v-seq
    11541                                       , input 0
    11542                                       , input '':U
    11543                                       , input dsp-rs
    11544                                       , input tot-lns
    11545                                       , input rs-list-method
    11546                                       , input rs-status
    11547                                       , input v-item
    11548                                       , input '':U
    11549                                       , input ?
    11550                                       ).
    11551   END PROCEDURE.
    11552   procedure proc-scn-tsd :
    11553   define variable glog as logical no-undo .
    11554   define buffer buf_gds-list-hist for gds-list-hist.
    11555     do
    11556     on error undo, return error
    11557     :
    11558     run str/diallog.w (parparentproc
    11559                 , this-procedure
    11560                 , 'str/rsendtsd.p':U
    11561                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code))
    11562                 , no
    11563                 , '':U
    11564                 , 'Пересылка товаров на ТСД') no-error .
    11565     end.
    11566   end procedure.
    11567   procedure proc-macros :
    11568   define variable glog as logical no-undo .
    11569   define variable v-option as integer no-undo .
    11570   define buffer buf_gds-list-hist for gds-list-hist.
    11571   define buffer buf_macro-list-hist for macro-list-hist.
    11572   if can-find(first macro-list-hist) then do:
    11573     run gbl/d-askw.w ( input "Сохранение макроса"
    11574                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    11575                   ,input "|"
    11576                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    11577                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    11578                   ,input 1
    11579                   ,input 3
    11580                   ,output v-option).
    11581     if v-option = 3 then return no-apply.
    11582     v-option = 1.
    11583   end.
    11584   else do:
    11585     message
    11586     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    11587     view-as alert-box question buttons yes-no update glog.
    11588     v-option = 2.
    11589     if not glog then do:
    11590       return no-apply.
    11591     end.
    11592   end.
    11593     do
    11594     on error undo, return error
    11595     :
    11596     assign
    11597       f-name = "default.gdm"
    11598       glog = yes
    11599       .
    11600     system-dialog get-file f-name
    11601       filters "Макрос создания списка товара *.gdm" "*.gdm"
    11602       ask-overwrite
    11603       save-as
    11604       use-filename
    11605       update glog
    11606       default-extension "gdm".
    11607     if not glog then do:
    11608       apply "entry" to br-list in frame Dialog-Frame.
    11609       return no-apply.
    11610     end.
    11611     run waitfram-show in this-procedure ("Сохранение макроса формирования списка товара.    ЖДИТЕ...").
    11612     output stream PrnLibStream to value (f-name).
    11613     case v-option:
    11614       when 1 then do:
    11615         for each buf_macro-list-hist:
    11616           export stream PrnLibStream
    11617           buf_macro-list-hist.
    11618         end.
    11619       end.
    11620       when 2 then do:
    11621     for each buf_gds-list-hist:
    11622         export stream PrnLibStream
    11623         buf_gds-list-hist.
    11624     end.
    11625       end.
    11626     end case.
    11627     output stream PrnLibStream close.
    11628     run waitfram-hide in this-procedure .
    11629     end.
    11630   end procedure.
    11631   PROCEDURE trig-tax-rate-value :
    11632   define input parameter p-rs-list-method as character no-undo .
    11633   define output parameter p-date as date no-undo .
    11634   DEFINE VARIABLE v-codes          as character           no-undo.
    11635   DEFINE VARIABLE v-labels         as character           no-undo.
    11636   DEFINE VARIABLE v-type           as character           no-undo.
    11637   DEFINE VARIABLE v-format         as character           no-undo.
    11638   DEFINE VARIABLE v-values         as character           no-undo.
    11639   DEFINE VARIABLE v-code-output    as character           no-undo.
    11640   DEFINE VARIABLE v-value-output   as character           no-undo.
    11641   define variable vlabel           as character           no-undo .
    11642   define variable v-date-chr       as character           no-undo .
    11643   DEFINE VARIABLE v-time           as integer             no-undo .
    11644   DEFINE VARIABLE v-ref-list           as character           no-undo .
    11645   DEFINE VARIABLE jj                   as integer             no-undo .
    11646   define variable glog as logical no-undo .
    11647   assign
    11648   v-attr-code = ""
    11649   vvalue = ""
    11650   v-codes = '1':U + chr(4) + '2':U
    11651   v-labels = "НДС" + chr(4) +  "НП"
    11652   v-values = "0" + chr(4) + "0"
    11653   v-format = ">9.99":U + chr(4) + ">9.99":U
    11654   v-type = 'D':U + chr(4) + 'D':U
    11655   .
    11656   run gbl/d-listv.w (
    11657                  "b-mark,b-sel":U
    11658                 ,"Выберите налоги"
    11659                 , v-codes
    11660                 , v-labels
    11661                 , v-values
    11662                 , v-format
    11663                 , v-type
    11664                 , chr(4)
    11665                 , "":U
    11666                 , output v-attr-code
    11667                 , output vvalue
    11668                 ).
    11669   if v-attr-code = "" then do:
    11670     return error.
    11671   end.
    11672   do jj = 1 to num-entries(v-attr-code, chr(4)):
    11673     assign
    11674     vlabel = vlabel + entry(LOOKUP(entry(jj, v-attr-code, chr(4)), v-codes, chr(4)), v-labels, chr(4)) + "=":U + entry(jj, vvalue, chr(4)) + chr(10)
    11675     .
    11676   end.
    11677   run cur-time in this-procedure(output p-date, output v-time).
    11678   assign
    11679   v-date-chr = string(p-date, "99/99/9999":U)
    11680   .
    11681   run gbl/d-prompt.w (
    11682     'title=':u + "Введите дату значения налогов" + '\':u
    11683   + 'text1=':u + "Дата" + '\':u
    11684   + 'format=' + "99/99/9999" + '\':u
    11685   + 'type=' + 'T':U + '\':u
    11686   + 'fillin_row=2\':u
    11687   + 'fillin_col=4\':u
    11688   + 'fillin_width=20\':u
    11689   + 'fillin_height=1\':u
    11690   + 'max-chars=70\':u
    11691   + 'readonly=no' + '\':u
    11692   , input-output v-date-chr
    11693   ).
    11694   if return-value = 'false':u then return error.
    11695   assign
    11696   p-date = date( integer(substr(v-date-chr, 4, 2))
    11697                 ,integer(substr(v-date-chr, 1, 2))
    11698                 ,integer(substr(v-date-chr, 7, 4))
    11699                )
    11700   no-error .
    11701   if error-status:error then return error.
    11702   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11703   run userobjs_select-one in this-procedure
    11704     (input  parparentproc
    11705     ,input  v-cntxt-db-num
    11706     ,input  v-cntxt-userid
    11707     ,input  v-cntxt-host-code-obj
    11708     ,input  v-cntxt-obj-type
    11709     ,input  v-cntxt-obj-code
    11710     ,output v-user-select
    11711     ,output v-sel-obj-type
    11712     ,output v-sel-obj-code
    11713     )  .
    11714   if not v-user-select then do:
    11715     return error.
    11716   end.
    11717   glog = yes.
    11718   if p-rs-list-method = "tax-rate-value":U then do:
    11719     message
    11720     "Все товары с заданными значениями налогов на объекте на дату" v-date-chr skip
    11721     vlabel skip
    11722     stat-line(rs-status)
    11723     view-as alert-box question buttons OK-Cancel update glog.
    11724   end.
    11725   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11726     message
    11727     "Товары объекта с заданными значениями налогов на объекте на дату" v-date-chr skip
    11728     vlabel skip
    11729     stat-line(rs-status)
    11730     view-as alert-box question buttons OK-Cancel update glog.
    11731   end.
    11732   if not glog then do:
    11733     return error.
    11734   end.
    11735   if p-rs-list-method = "tax-rate-value":U then do:
    11736     dsp-rs = substitute("ВСЕ товары с заданными значениями налогов на объекте &1 на дату &2 &3", vlabel, p-date, stat-line(rs-status)).
    11737   end.
    11738   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11739     dsp-rs = substitute("Товары объекта &1 с заданными значениями налогов на объекте &2 на дату &3 &4", vlabel, vlabel, p-date, stat-line(rs-status)).
    11740   end.
    11741   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11742                                       , input-output v-seq
    11743                                       , input 0
    11744                                       , input '':U
    11745                                       , input dsp-rs
    11746                                       , input tot-lns
    11747                                       , input rs-list-method
    11748                                       , input rs-status
    11749                                       , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) +
    11750                                               string(p-date, "99/99/9999") + chr(3) + v-attr-code + chr(3) + vvalue
    11751                                       , input '':U
    11752                                       , input ?
    11753                                       ).
    11754   END PROCEDURE.
    11755   procedure proc-b-add :
    11756   define input parameter p-from-macro as logical no-undo .
    11757   define input parameter p-rowid as rowid no-undo .
    11758   define input parameter rs-list-method as character no-undo .
    11759   define input parameter rs-status as character no-undo .
    11760     do
    11761     on error undo, return error
    11762     :
    11763     line-mode = 'ДОБАВЛЕНИЕ':U.
    11764     if rs-list-method = "single" then do:
    11765        v-no-hist = - 1.
    11766       if p-from-macro then do:
    11767         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
    11768       end.
    11769       else do:
    11770         run ref/gds-ref.p ( parparentproc
    11771                         ,"b-sel,b-add"
    11772                         ,?
    11773                         ,?
    11774                         ,?
    11775                         ,?
    11776                         ,?
    11777                         ,?
    11778                         ,?
    11779                         ,p-curr-obj-type
    11780                         ,p-curr-obj-code
    11781                         ,?
    11782                         , output ref-list).
    11783         apply "entry" to br-list in frame Dialog-Frame.
    11784         if ref-list = "" then
    11785           return no-apply.
    11786         find ub.goods where recid (ub.goods) = integer (ref-list) no-lock.
    11787       end.
    11788       if available goods then do:
    11789         run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    11790         tot-lns = tot-lns + 1.
    11791         run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11792       end.
    11793       else do:
    11794         return error "Нет в БД такого товара".
    11795       end.
    11796       run UI-on  in this-procedure.
    11797     end.
    11798     else
    11799       run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11800     end.
    11801   end procedure.
    11802   procedure proc-b-del :
    11803   define input parameter p-from-macro as logical no-undo .
    11804   define input parameter p-rowid as rowid no-undo .
    11805   define input parameter rs-list-method as character no-undo .
    11806   define input parameter rs-status as character no-undo .
    11807   define variable v-rep-rec as recid no-undo .
    11808   define variable glog as logical no-undo .
    11809     do
    11810     on error undo, return error
    11811     :
    11812       line-mode = 'удаление':U.
    11813       if rs-list-method = "single" then do:
    11814         v-no-hist = - 1.
    11815         if p-from-macro then do:
    11816           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11817           if not available ub.goods then return error "Нет в БД такого товара".
    11818           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11819         end.
    11820         if available gds-list then do:
    11821           line-rec = recid (gds-list).
    11822           get next br-list.
    11823           if available gds-list then v-rep-rec = recid (gds-list).
    11824           else do:
    11825             reposition br-list to recid line-rec no-error.
    11826             get prev br-list.
    11827             if available gds-list then v-rep-rec = recid (gds-list).
    11828           end.
    11829           reposition br-list to recid line-rec no-error.
    11830           tot-lns = tot-lns - 1.
    11831           run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11832           delete gds-list.
    11833           line-rec = v-rep-rec.
    11834           run UI-on in this-procedure.
    11835         end.
    11836         else do:
    11837           return error "Нет в списке товаров такого товара".
    11838         end.
    11839       end.
    11840       else do:
    11841         glog = no.
    11842         message "Удалить товары ПО заданному УСЛОВИЮ ?   Вы уверены ?"
    11843         view-as alert-box question buttons OK-Cancel update glog.
    11844         if not glog then
    11845           return no-apply.
    11846         run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11847       end.
    11848     end.
    11849   end procedure.
    11850   procedure proc-b-rest :
    11851   define input parameter p-from-macro as logical no-undo .
    11852   define input parameter p-rowid as rowid no-undo .
    11853   define input parameter rs-list-method as character no-undo .
    11854   define input parameter rs-status as character no-undo .
    11855   define buffer buf_gds-list-hist for gds-list-hist.
    11856   define variable glog as logical no-undo .
    11857     do
    11858     on error undo, return error
    11859     :
    11860       line-mode = 'ОСТАВИТЬ':U.
    11861       if rs-list-method = "single" then do:
    11862         v-no-hist = - 1.
    11863         if p-from-macro then do:
    11864           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11865           if not available ub.goods then return error substitute("Нет в БД такого товара").
    11866           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11867         end.
    11868         if available gds-list then do:
    11869           if p-from-macro then do:
    11870             glog = yes.
    11871           end.
    11872           else do:
    11873             glog = no.
    11874             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11875             view-as alert-box question buttons OK-Cancel update glog.
    11876             if not glog then return error.
    11877           end.
    11878           line-rec = recid (gds-list).
    11879           v-seq = 1.
    11880           for each buf_gds-list-hist:
    11881             delete buf_gds-list-hist.
    11882           end.
    11883           run write-hist  in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11884           for each gds-list:
    11885             if line-rec <> recid (gds-list) then delete gds-list.
    11886           end.
    11887           assign
    11888           tot-lns = 1
    11889           .
    11890           run UI-on  in this-procedure.
    11891         end.
    11892         else do:
    11893           return error substitute("Нет в списке такого товара").
    11894         end.
    11895       end.
    11896       else do:
    11897         glog = no.
    11898         if not p-from-macro then do:
    11899           message "Оставить товары ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11900           view-as alert-box question buttons OK-Cancel update glog.
    11901           if not glog then
    11902             return no-apply.
    11903         end.
    11904         assign
    11905         lns-cnt = 0
    11906         lns-ignore = 0
    11907         .
    11908         run rs-do  in this-procedure ( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11909         for each gds-list:
    11910           if gds-list.to-del = ? then do:
    11911             assign
    11912             gds-list.to-del = no
    11913             .
    11914           end.
    11915           else do:
    11916             delete gds-list.
    11917           end.
    11918         end.
    11919         tot-lns = lns-cnt.
    11920         run UI-on  in this-procedure.
    11921         message
    11922         "Оставлено строк :" lns-cnt skip(0)
    11923         string(if lns-ignore <> 0
    11924         then ("Проигнорировано строк :" + string(lns-ignore))
    11925         else "":U)
    11926         .
    11927       end.
    11928     end.
    11929   end procedure.
    11930   procedure proc-b-obj :
    11931     define input parameter p-mode as character no-undo .
    11932     define buffer buf_clients  for ub.clients.
    11933     do
    11934     on error undo, return error
    11935     :
    11936       if p-mode = "change":U then do:
    11937   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11938   run userobjs_select-one in this-procedure
    11939     (input  parparentproc
    11940     ,input  v-cntxt-db-num
    11941     ,input  v-cntxt-userid
    11942     ,input  v-cntxt-host-code-obj
    11943     ,input  v-cntxt-obj-type
    11944     ,input  v-cntxt-obj-code
    11945     ,output v-user-select
    11946     ,output v-sel-obj-type
    11947     ,output v-sel-obj-code
    11948     )  .
    11949       end.
    11950       if v-user-select then do:
    11951         find first buf_clients no-lock where
    11952                    buf_clients.obj-type = v-sel-obj-type
    11953                and buf_clients.obj-code = v-sel-obj-code no-error.
    11954         if not available buf_clients then do: return error. end.
    11955         assign
    11956           p-curr-obj-type = buf_clients.obj-type
    11957           p-curr-obj-code = buf_clients.obj-code
    11958           p-curr-host-code = buf_clients.host-code
    11959           v-obj-type = buf_clients.obj-type
    11960           v-obj-code = buf_clients.obj-code
    11961           v-obj-name = buf_clients.obj-name
    11962         .
    11963         if lookup(bttns, "hide") = 0 then do:
    11964           display
    11965           v-obj-name
    11966           v-obj-type
    11967           v-obj-code
    11968           with frame Dialog-Frame.
    11969         end.
    11970       end.
    11971     end.
    11972   end procedure.
    11973   procedure proc-file-list-methods :
    11974   define input parameter p-from-macro as logical no-undo .
    11975   define input parameter rs-list-method as character no-undo .
    11976   define input parameter rs-status as character no-undo .
    11977   define input parameter line-mode as character no-undo .
    11978   define input parameter p-id      as integer no-undo .
    11979   define variable ss as character no-undo .
    11980   define variable b-c as integer no-undo.
    11981   define variable imp-type like ub.goods.prod-type no-undo.
    11982   define variable imp-code like ub.goods.prod-code no-undo.
    11983   define variable imp-art like ub.goods.artic no-undo.
    11984   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
    11985   define variable imp-doc-type as character no-undo.
    11986   define variable scan-qnty as dec no-undo.
    11987   define variable bc-qnty as dec no-undo.
    11988   define variable varresult   as character         no-undo.
    11989   define variable vartype-bc  as character         no-undo.
    11990   define variable varweight   as decimal           no-undo.
    11991   define variable v-full-path        as character no-undo .
    11992   define variable v-path             as character no-undo .
    11993   define variable v-file-name        as character no-undo .
    11994   define variable v-file-name-no-ext as character no-undo .
    11995   define variable v-file-name-ext    as character no-undo .
    11996   define variable v-num-add          as integer no-undo .
    11997   define variable v-num-ignored      as integer no-undo .
    11998   define variable v-tbl-row          as rowid no-undo .
    11999   define variable v-tbl-name         as character no-undo .
    12000   define buffer buf_gds-list-hist for gds-list-hist.
    12001   define buffer buf_clob-data for ub.clob-data.
    12002   define buffer buf_clob-bind for ub.clob-bind.
    12003   do
    12004   on error undo, return error
    12005   :
    12006   find first buf_gds-list-hist where
    12007             buf_gds-list-hist.id = p-id
    12008         AND buf_gds-list-hist.item_ <> '':U .
    12009   if rs-list-method = "clob-data" then do:
    12010     run gen-row-keyr in this-procedure (
    12011      input  buf_gds-list-hist.item_
    12012     ,input  ?
    12013     ,input  "ub"
    12014     ,input  ?
    12015     ,input NO-LOCK
    12016     ,output v-tbl-row
    12017     ,output v-tbl-name  ) no-error.
    12018     if error-status :error then do:
    12019       message
    12020       "Ошибка при поиске хранимого файла"
    12021       view-as alert-box error.
    12022       return error.
    12023     end.
    12024     find first buf_clob-bind no-lock where
    12025               rowid(buf_clob-bind) = v-tbl-row .
    12026     find first buf_clob-data no-lock where
    12027               buf_clob-data.db-num = buf_clob-bind.db-num
    12028           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
    12029     if error-status :error then do:
    12030       message
    12031       "Ошибка при пополучении хранимого файла"
    12032       view-as alert-box error.
    12033       return error.
    12034     end.
    12035     run gbl/_tmpfile.p ( input ""
    12036                   ,input "tmp"
    12037                   ,output v-file-name) .
    12038     copy-lob from object buf_clob-data.cdata
    12039     to file v-file-name.
    12040   end.
    12041   run gbl/filename.p
    12042       (input  (if rs-list-method = "clob-data" then v-file-name else buf_gds-list-hist.item_  )
    12043     ,output v-full-path
    12044     ,output v-path
    12045     ,output v-file-name
    12046     ,output v-file-name-no-ext
    12047     ,output v-file-name-ext
    12048     ) no-error .
    12049     if error-status:error then do: end. else do:
    12050     input stream sout from value (v-full-path).
    12051     CASE rs-list-method:
    12052       when "doc-list" then do:
    12053         repeat:
    12054           import stream sout imp-doc-code imp-doc-type no-error.
    12055           if imp-doc-type = 'переоценка':U then do:
    12056             find first ub.price-doc No-LOCK WHERE
    12057                       ub.price-doc.doc-num = imp-doc-code No-ERROR.
    12058             if avail(ub.price-doc) then do:
    12059               FOR EACH ub.price-list No-LOCK WHERE
    12060                       ub.price-list.doc-num = ub.price-doc.doc-num,
    12061                   FIRST ub.goods No-LOCK WHERE
    12062                         ub.goods.artic = ub.price-list.artic AND
    12063                         ub.goods.prod-type = ub.price-list.prod-type AND
    12064                         ub.goods.prod-code = ub.price-list.prod-code:
    12065                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12066                 if available gds-list and
    12067                   gds-list.artic = ub.goods.artic and
    12068                   gds-list.prod-type = ub.goods.prod-type and
    12069                   gds-list.prod-code = ub.goods.prod-code then
    12070                   gds-list.qnty = scan-qnty.
    12071               END.
    12072             end.
    12073           end.
    12074           else do:
    12075             find first ub.trn-doc NO-LOCK where
    12076                       ub.trn-doc.doc-code = imp-doc-code No-ERROR.
    12077             if avail(ub.trn-doc) then do:
    12078               FOR EACH ub.doc-line NO-LOCK where
    12079                       ub.doc-line.doc-code = ub.trn-doc.doc-code,
    12080                   FIRST ub.goods where ub.goods.artic = ub.doc-line.artic
    12081                               and ub.goods.prod-type = ub.doc-line.prod-type
    12082                               and ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK:
    12083                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12084                 if available gds-list and
    12085                   gds-list.artic = ub.goods.artic and
    12086                   gds-list.prod-type = ub.goods.prod-type and
    12087                   gds-list.prod-code = ub.goods.prod-code then
    12088                   gds-list.qnty = scan-qnty.
    12089               end.
    12090             end.
    12091           end.
    12092         end.
    12093       end.
    12094       when "prod-list" then do:
    12095         repeat:
    12096           import stream sout imp-type imp-code no-error.
    12097           for each ub.goods where ub.goods.prod-type = imp-type
    12098                       and ub.goods.prod-code = imp-code no-lock:
    12099             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12100           end.
    12101         end.
    12102       end.
    12103       when "supp-list" then do:
    12104         repeat:
    12105           import stream sout imp-type imp-code no-error.
    12106           for each ub.cli-gds where ub.cli-gds.cli-type = imp-type
    12107                               and ub.cli-gds.cli-code = imp-code
    12108                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
    12109                 first ub.goods where ub.goods.artic = ub.cli-gds.artic
    12110                             and ub.goods.prod-type = ub.cli-gds.prod-type
    12111                             and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
    12112             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12113           end.
    12114         end.
    12115       end.
    12116       when "cli-list" then do:
    12117         input stream sout from value (f-cli-name).
    12118         repeat:
    12119           import stream sout imp-type imp-code no-error.
    12120           for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
    12121                             and ub.trn-doc.cli-code = imp-code no-lock:
    12122             for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
    12123                 first ub.goods where ub.goods.artic = ub.doc-line.artic
    12124                               and ub.goods.prod-type = ub.doc-line.prod-type
    12125                               and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
    12126               run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12127             end.
    12128           end.
    12129         end.
    12130       end.
    12131       when "file"
    12132       or when "clob-data"
    12133       then do:
    12134         repeat:
    12135           import stream sout imp-type imp-code imp-art scan-qnty no-error.
    12136           find ub.goods where ub.goods.prod-type = imp-type
    12137                       and ub.goods.prod-code = imp-code
    12138                       and ub.goods.artic     = imp-art no-lock no-error.
    12139           if available ub.goods then run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12140           if available ub.goods and  available gds-list and
    12141             gds-list.artic = ub.goods.artic and
    12142             gds-list.prod-type = ub.goods.prod-type and
    12143             gds-list.prod-code = ub.goods.prod-code then
    12144             gds-list.qnty = scan-qnty.
    12145         end.
    12146         if rs-list-method = "clob-data" then do:
    12147           os-delete value(v-full-path) .
    12148         end.
    12149       end.
    12150       when "scaner" then do:
    12151         repeat:
    12152           import stream sout unformatted ss.
    12153           ss = trim (ss).
    12154           if ss = "" then next.
    12155           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
    12156             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
    12157             else next.
    12158           assign
    12159             scan-qnty = dec (entry (2, ss))
    12160             ss = trim (entry (1, ss)).
    12161   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12162   (
    12163    input  parparentproc
    12164   ,input  ss
    12165   ,input  ?
    12166   ,input  p-curr-obj-type
    12167   ,input  p-curr-obj-code
    12168   ,input  yes
    12169   ,input  no
    12170   ,input  varscales-pref
    12171   ,input  varpgscales-pref
    12172   ,output varresult
    12173   ,output vartype-bc
    12174   ,output varweight
    12175   ,buffer ub.bar-code
    12176   ,buffer ub.prod-bc
    12177   ,buffer ub.place
    12178   ) no-error.
    12179           if not available ub.bar-code then next.
    12180           bc-qnty = ub.bar-code.cli-base-rate.
    12181           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
    12182           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12183           if available gds-list and
    12184             gds-list.artic = ub.goods.artic and
    12185             gds-list.prod-type = ub.goods.prod-type and
    12186             gds-list.prod-code = ub.goods.prod-code then
    12187             gds-list.qnty = gds-list.qnty + scan-qnty * bc-qnty.
    12188         end.
    12189       end.
    12190     END CASE.
    12191     input stream sout close.
    12192     assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
    12193     end.
    12194   end.
    12195   end procedure.
    12196   procedure analysis:
    12197   define input  parameter p-method as character no-undo .
    12198   define variable glog as logical   no-undo .
    12199   define variable v-run as character no-undo .
    12200   define variable an-option as character no-undo .
    12201   define variable v-tbl-name as character no-undo .
    12202   define variable v-bh as handle no-undo .
    12203   define variable v-recs as integer   no-undo .
    12204   define variable v-temp-seq as integer   no-undo .
    12205   define variable v-line as integer   no-undo .
    12206   define variable v-item as character no-undo .
    12207   define variable v-tot-lns as integer   no-undo .
    12208   do
    12209   on error undo, return error return-value
    12210   :
    12211     glog = yes.
    12212     CASE p-method:
    12213       when "abcxyz":U then do:
    12214         assign
    12215         dsp-rs = substitute("Товары ABC/XYZ анализа.&1&2",  stat-line(rs-status))
    12216         v-run = 'ref/abcxyzv.w':U
    12217         an-option = "abcxyz"
    12218         v-tbl-name = 'abcxyz-analysis':U
    12219         v-bh       = buffer ub.abcxyz-analysis:handle
    12220         .
    12221       end.
    12222       when "abc-analysis":U then do:
    12223         assign
    12224         dsp-rs = substitute("Товары ABC анализа.&1&2",  stat-line(rs-status))
    12225         v-run = 'ref/abcanal.w':U
    12226         an-option = "abc"
    12227         v-tbl-name = 'abc-analysis':U
    12228         v-bh       = buffer ub.abc-analysis:Handle
    12229         .
    12230       end.
    12231       when "xyz-analysis":U then do:
    12232         assign
    12233         dsp-rs = substitute("Товары XYZ анализа.&1&2",  stat-line(rs-status))
    12234         v-run = 'ref/xyzanal.w':U
    12235         an-option = "xyz"
    12236         v-tbl-name = 'xyz-analysis':U
    12237         v-bh       = buffer ub.xyz-analysis:Handle
    12238         .
    12239       end.
    12240     END CASE.
    12241     message
    12242     dsp-rs
    12243     view-as alert-box question buttons OK-Cancel update glog.
    12244     if not glog then do:
    12245       run UI-on  in this-procedure.
    12246       return error.
    12247     end.
    12248     run value(v-run)(parparentproc,"b-sel":U, output ref-list).
    12249     if ref-list <> "" then run ref/togabc.w (input an-option, output list-abcxyz).
    12250     if ref-list = "" or list-abcxyz = "" then do:
    12251       run UI-on in this-procedure.
    12252       return error.
    12253     end.
    12254     if num-entries(ref-list) = 1 then do:
    12255       CASE rs-list-method:
    12256         when "abcxyz":U then do:
    12257           find abcxyz-analysis where recid (abcxyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12258           dsp-rs = substitute("ABCXYZ Анализ : &1&2&3"
    12259                               ,abcxyz-analysis.abcx-name
    12260                               , chr(10)
    12261                               , stat-line(rs-status)
    12262                               ).
    12263         end.
    12264         when "abc-analysis":U then do:
    12265           find abc-analysis where recid (abc-analysis) = integer(entry(1, ref-list)) no-lock.
    12266           dsp-rs = substitute("ABC Анализ : &1&2&3"
    12267                               ,abc-analysis.abc-name
    12268                               , chr(10)
    12269                               , stat-line(rs-status)
    12270                               ).
    12271         end.
    12272         when "xyz-analysis":U then do:
    12273           find xyz-analysis where recid (xyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12274           dsp-rs = substitute("XYZ Анализ : &1&2&3"
    12275                               ,xyz-analysis.xyz-name
    12276                               ,chr(10)
    12277                               ,stat-line(rs-status)
    12278                               ).
    12279         end.
    12280       end CASE.
    12281       v-recs = num-entries(list-abcxyz).
    12282       do num-rec = 0 to v-recs:
    12283         if num-rec = 0 then do:
    12284           assign
    12285           v-temp-seq = v-seq
    12286           v-line     = 0
    12287           v-item     = '':U
    12288           v-tot-lns = tot-lns
    12289           .
    12290         end.
    12291         else do:
    12292           assign
    12293           v-temp-seq = v-seq - 1
    12294           v-line     = num-rec
    12295           dsp-rs = substitute("Группа &1", entry(num-rec, list-abcxyz))
    12296           v-item     = entry(num-rec, list-abcxyz)
    12297           v-tbl-name = '':U
    12298           v-bh       = ?
    12299           v-tot-lns = tot-lns + num-rec
    12300           .
    12301         end.
    12302         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12303         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12304                                             , input-output v-temp-seq
    12305                                             , input v-line
    12306                                             , input '':U
    12307                                             , input dsp-rs
    12308                                             , input v-tot-lns
    12309                                             , input rs-list-method
    12310                                             , input rs-status
    12311                                             , input v-item
    12312                                             , input v-tbl-name
    12313                                             , input v-bh
    12314                                             ).
    12315         if num-rec = 0 then v-seq  = v-temp-seq.
    12316       end.
    12317     end.
    12318   end.
    12319   end procedure.
    12320   procedure collection :
    12321   define input  parameter p-method as character no-undo .
    12322   define variable glog as logical   no-undo .
    12323   define variable v-run as character no-undo .
    12324   define variable an-option as character no-undo .
    12325   define variable v-tbl-name as character no-undo .
    12326   define variable v-bh as handle no-undo .
    12327   define variable v-recs as integer   no-undo .
    12328   define variable v-temp-seq as integer   no-undo .
    12329   define variable v-line as integer   no-undo .
    12330   define variable v-item as character no-undo .
    12331   define variable v-tot-lns as integer   no-undo .
    12332   do
    12333   on error undo, return error return-value
    12334   :
    12335     glog = yes.
    12336     CASE p-method:
    12337       when "collection":U then do:
    12338         assign
    12339         dsp-rs = substitute("Товары по коллекции.&1&2",  stat-line(rs-status))
    12340         v-run = 'ref/collec.w':U
    12341         an-option = "sea"
    12342         v-tbl-name = 'season'
    12343         v-bh       = buffer ub.season:Handle
    12344         .
    12345       end.
    12346     END CASE.
    12347     message
    12348     dsp-rs
    12349     view-as alert-box question buttons OK-Cancel update glog.
    12350     if not glog then do:
    12351       run UI-on.
    12352       return error.
    12353     end.
    12354     run value(v-run) (parParentProc, "b-sel":U, output ref-list).
    12355     if ref-list = "" then do:
    12356       run UI-on.
    12357       return error.
    12358     end.
    12359     if num-entries(ref-list) = 1 then do:
    12360       CASE rs-list-method:
    12361         when "collection":U then do:
    12362           find ub.season where recid (ub.season) = integer(entry(1, ref-list)) no-lock.
    12363           dsp-rs = substitute("Коллекция : &1&2&3"
    12364                               ,ub.season.sea-name
    12365                               , chr(10)
    12366                               , stat-line(rs-status)
    12367                               ).
    12368         end.
    12369       end CASE.
    12370       v-recs = num-entries(ref-list).
    12371       do num-rec = 0 to v-recs:
    12372         if num-rec = 0 then do:
    12373           assign
    12374           v-temp-seq = v-seq
    12375           v-line     = 0
    12376           v-item     = '':U
    12377           v-tot-lns = tot-lns
    12378           .
    12379         end.
    12380         else do:
    12381           assign
    12382           v-temp-seq = v-seq - 1
    12383           v-line     = num-rec
    12384           v-item     = entry(num-rec, ref-list)
    12385           v-tbl-name = '':U
    12386           v-bh       = ?
    12387           v-tot-lns = tot-lns + num-rec
    12388           .
    12389         end.
    12390         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12391         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12392                                             , input-output v-temp-seq
    12393                                             , input v-line
    12394                                             , input '':U
    12395                                             , input dsp-rs
    12396                                             , input v-tot-lns
    12397                                             , input rs-list-method
    12398                                             , input rs-status
    12399                                             , input v-item
    12400                                             , input v-tbl-name
    12401                                             , input v-bh
    12402                                             ).
    12403         if num-rec = 0 then v-seq  = v-temp-seq.
    12404       end.
    12405     end.
    12406   end.
    12407   end procedure.
    12408   procedure object-options :
    12409   define input  parameter p-method as character no-undo .
    12410   define variable glog as logical   no-undo .
    12411   define variable v-message as character no-undo .
    12412   define buffer buf_gds-list-hist for gds-list-hist.
    12413   define buffer buf_user-obj for ub.user-obj.
    12414   do
    12415   on error undo, return error return-value
    12416   :
    12417     glog = yes.
    12418     case p-method:
    12419       when "object" then do:
    12420         assign
    12421         v-message = substitute("Все товары из справочника товаров по объекту.&1&2"
    12422                                 , chr(10)
    12423                                 , stat-line(rs-status))
    12424         dsp-rs    = "Все товары по объекту : &1 &2"
    12425         .
    12426       end.
    12427       when "available"  then do:
    12428           assign
    12429           v-message = substitute("Все товары, остаток которых на объекте > 0.&1&2"
    12430                                 , chr(10)
    12431                                 , stat-line(rs-status))
    12432           dsp-rs =   "ВСЕ товары, имеющиеся в наличии на/в &1 &2"
    12433           .
    12434       end.
    12435       when "neg-rest" then do:
    12436           assign
    12437           v-message = substitute("Все товары с отрицательными остатками на объекте.&1&2"
    12438                                 , chr(10)
    12439                                 , stat-line(rs-status))
    12440           dsp-rs     = "ВСЕ товары с отрицательными остатками на/в &1 &2"
    12441           .
    12442       end.
    12443       when "neg-part" then do:
    12444           assign
    12445           v-message = substitute("Все товары, имеющие отрицательные партии на объекте (остаток при этом может быть любым).&1&2"
    12446                                 , chr(10)
    12447                                 , stat-line(rs-status))
    12448           dsp-rs    = "ВСЕ товары с отрицательными партиями на/в &1 &2"
    12449           .
    12450       end.
    12451       when "neg-part-free" then do:
    12452           assign
    12453           v-message = substitute("Все товары, имеющие отрицательные партии в свободной зоне на объекте (остаток при этом может быть любым).&1&2"
    12454                                 , chr(10)
    12455                                 , stat-line(rs-status))
    12456           dsp-rs    = "ВСЕ товары с отрицательными партиями в свободной зоне на/в &1 &2"
    12457           .
    12458       end.
    12459       when "neg-prt" then do:
    12460           assign
    12461           v-message = substitute("Все товары с признаками с отрицательными остатками по признакам на объекте.&1&2"
    12462                                 , chr(10)
    12463                                 , stat-line(rs-status))
    12464           dsp-rs    =  "ВСЕ товары с признаками с отриц. ост. по признаку на/в &1 &2"
    12465           .
    12466       end.
    12467       when "nul-rest" then do:
    12468           assign
    12469           v-message = substitute("Все товары с нулевыми остатками на объекте.&1&2"
    12470                                 , chr(10)
    12471                                 , stat-line(rs-status))
    12472           dsp-rs     = "ВСЕ товары с нулевыми остатками на/в &1 &2"
    12473           .
    12474       end.
    12475       when  "input" then do:
    12476         assign
    12477         v-message = substitute("Все товары, когда либо бывшие (или имеющиеся сейчас) на объекте.&1&2"
    12478                                 , chr(10)
    12479                                 , stat-line(rs-status))
    12480         dsp-rs = "ВСЕ товары, проходившие когда-либо по &1 &2"
    12481         .
    12482       end.
    12483       when "with-price" then do:
    12484         assign
    12485         v-message = substitute("Все товары на объекте, имеющие продажную цену > 0 .&1&2"
    12486                                 , chr(10)
    12487                                 , stat-line(rs-status))
    12488         dsp-rs     = "ВСЕ товары, имеющие цену > 0 по &1 &2"
    12489         .
    12490       end.
    12491       when "ov-req" then do:
    12492         assign
    12493         v-message = substitute("Товары, которые нельзя расходовать с объекта без переоценки&1" +
    12494                               "(попадающие под действие настройки, требующей переоценки после&1" +
    12495                               "любого прихода на объект).&1&2"
    12496                                 , chr(10)
    12497                                 , stat-line(rs-status))
    12498         dsp-rs = "Товары, по которым требуется переоценка после ПРИХОДА на/в &1 &2 "
    12499         .
    12500       end.
    12501       WHEN "inv-req" then do:
    12502         assign
    12503         v-message = substitute("Товары, количество по которым изменялось со времени последней&1" +
    12504                                 "инвентаризации на объекте (своей для каждого товара).&1&2"
    12505                                 , chr(10)
    12506                                 , stat-line(rs-status))
    12507         dsp-rs = "Товары, по которым были ОБОРОТЫ после ИНВЕНТАРИЗАЦИИ на/в &1 &2"
    12508         .
    12509       end.
    12510       when "etalon" then do:
    12511         ASSIGN
    12512         v-message = substitute("Все товары из справочника товаров по ТЕКУЩЕМУ объекту, цены по которым&1" +
    12513                                 "НЕ совпадают с ценами на выбранном ЭТАЛОННОМ объекте&1" +
    12514                                 "(только при условии, что цена есть на том и другом объектах).&1&2"
    12515                                 , chr(10)
    12516                                 , stat-line(rs-status))
    12517         dsp-rs = "Цены на/в &1 &2, не совпадающие с ценами на &3 &4"
    12518         .
    12519       end.
    12520     END CASE.
    12521     message v-message
    12522     view-as alert-box question buttons OK-Cancel update glog.
    12523     if not glog then do:
    12524       run UI-on  in this-procedure.
    12525       return error.
    12526     end.
    12527       ref-list = "":U.
    12528   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12529   run userobjs_select-one in this-procedure
    12530     (input  parparentproc
    12531     ,input  v-cntxt-db-num
    12532     ,input  v-cntxt-userid
    12533     ,input  v-cntxt-host-code-obj
    12534     ,input  v-cntxt-obj-type
    12535     ,input  v-cntxt-obj-code
    12536     ,output v-user-select
    12537     ,output v-sel-obj-type
    12538     ,output v-sel-obj-code
    12539     )  .
    12540                            if not v-user-select then do:     run UI-on in this-procedure .     return no-apply.   end.
    12541       find first buf_user-obj no-lock where
    12542                 buf_user-obj.obj-type = v-sel-obj-type
    12543             and buf_user-obj.obj-code = v-sel-obj-code
    12544             AND buf_user-obj.db-num = v-cntxt-db-num
    12545             AND buf_user-obj.user-id = v-cntxt-userid  no-error .
    12546       if not available buf_user-obj then do:
    12547         run ui-on in this-procedure .
    12548         return error.
    12549       end.
    12550       if p-method = "etalon"
    12551       and p-curr-obj-type = v-sel-obj-type
    12552       and p-curr-obj-code = v-sel-obj-code then do:
    12553         message "Бессмысленно сравнивать цены для одного и того же объекта.".
    12554         run UI-on  in this-procedure.
    12555         return error.
    12556       end.
    12557       if p-method = "etalon":U then do:
    12558         assign
    12559         dsp-rs = replace(dsp-rs, "&1", p-curr-obj-type)
    12560         dsp-rs = replace(dsp-rs, "&2", string(p-curr-obj-code))
    12561         dsp-rs = replace(dsp-rs, "&3", v-sel-obj-type)
    12562         dsp-rs = replace(dsp-rs, "&4", string(v-sel-obj-code))
    12563         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12564         .
    12565       end.
    12566       else do:
    12567         assign
    12568         dsp-rs = replace(dsp-rs, "&1", v-sel-obj-type)
    12569         dsp-rs = replace(dsp-rs, "&2", string(v-sel-obj-code))
    12570         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12571         .
    12572       end.
    12573       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12574                                           , input-output v-seq
    12575                                           , input 0
    12576                                           , input '':U
    12577                                           , input dsp-rs
    12578                                           , input tot-lns
    12579                                           , input p-method
    12580                                           , input rs-status
    12581                                           , input '':U
    12582                                           , input 'user-obj':U
    12583                                           , input buffer buf_user-obj:handle
    12584                                           ).
    12585   end.
    12586   end procedure.
    12587   PROCEDURE reposition-goods :
    12588   define input  parameter p-direction   as character no-undo .
    12589   define output parameter p-recid as recid no-undo .
    12590   define buffer buf_goods for ub.goods.
    12591   case p-direction :
    12592     when "first":U
    12593     then do:
    12594       get first br-list.
    12595     end.
    12596     when "last":U
    12597     then do:
    12598       get last br-list.
    12599     end.
    12600     when "prev":U
    12601     then do:
    12602       get prev br-list.
    12603       if not available gds-list then do:
    12604         message
    12605         "Это первый товар списка"
    12606         view-as alert-box.
    12607       end.
    12608     end.
    12609     when "next":U
    12610     then do:
    12611       get next br-list.
    12612       if not available gds-list then do:
    12613         message
    12614         "Это последний товар списка"
    12615         view-as alert-box.
    12616       end.
    12617     end.
    12618   end case .
    12619   find first buf_goods no-lock where
    12620           buf_goods.gds-code = gds-list.gds-code no-error.
    12621   if available gds-list then do:
    12622     assign
    12623     p-recid = recid(buf_goods)
    12624     .
    12625   end.
    12626   run reposition-query in this-procedure
    12627     (input recid(gds-list)
    12628     ).
    12629   END PROCEDURE.
    12630   PROCEDURE reposition-query :
    12631   define input parameter p-recid as recid no-undo .
    12632   if p-recid <> ?
    12633   then do:
    12634     reposition br-list to recid p-recid no-error.
    12635   end.
    12636   do with frame Dialog-Frame:
    12637     apply "entry":u to browse br-list .
    12638     apply "VALUE-CHANGED":u to browse br-list .
    12639   end.
    12640   END PROCEDURE.
    12641   procedure cb_fill-lob-res-list :
    12642   define input  parameter p-full-path as character no-undo .
    12643   output to value (p-full-path).
    12644   for each gds-list:
    12645     export gds-list.prod-type
    12646           gds-list.prod-code
    12647           gds-list.artic
    12648           gds-list.qnty
    12649           .
    12650   end.
    12651   output close.
    12652   end procedure.
    12653   procedure cb_fill-lob-res-list-macro :
    12654   define input  parameter p-full-path as character no-undo .
    12655   define buffer buf_gds-list-hist for gds-list-hist.
    12656   output to value (p-full-path).
    12657   for each buf_gds-list-hist:
    12658       export
    12659       buf_gds-list-hist.
    12660   end.
    12661   output close.
    12662   end procedure.
    12663   procedure cb_get-next-gds-by-gds-code :
    12664   define input parameter p-gds-code as integer no-undo .
    12665   define input parameter p-bh as handle no-undo .
    12666   define buffer buf_gds-list for gds-list.
    12667   find first buf_gds-list no-lock where
    12668             buf_gds-list.gds-code > p-gds-code no-error.
    12669   if available buf_gds-list then do:
    12670     p-bh:buffer-create().
    12671     p-bh:buffer-copy(buffer buf_gds-list:handle).
    12672   end.
    12673   else do:
    12674   end.
    12675   end procedure.
    12676   procedure m-gds-save-db-proc :
    12677   define variable v-rid-list as character no-undo .
    12678   if lookup("clobbnds_add", bttns) > 0 then do:
    12679     run clobbnds_add in p-parent-handle
    12680                     ( input this-procedure:handle
    12681                      ,input 'list':U
    12682                      ,input "gds-list"
    12683                      ).
    12684   end.
    12685   if lookup("clobbnds_chg", bttns) > 0 then do:
    12686     run clobbnds_chg in p-parent-handle
    12687                     ( input this-procedure:handle
    12688                      ).
    12689   end.
    12690   return.
    12691   end procedure.
    12692   procedure m-macros-save-db-proc :
    12693   define variable v-rid-list as character no-undo .
    12694   if lookup("clobbnds_add", bttns) > 0 then do:
    12695     run clobbnds_add in p-parent-handle
    12696                     ( input this-procedure:handle
    12697                      ,input 'list-macro':U
    12698                      ,input "gds-list"
    12699                      ).
    12700   end.
    12701   if lookup("clobbnds_chg", bttns) > 0 then do:
    12702     run clobbnds_chg in p-parent-handle
    12703                     ( input this-procedure:handle
    12704                      ).
    12705   end.
    12706   return.
    12707   end procedure.
    12708   procedure grplib-get-full-name-alc-type :
    12709   do
    12710   on error undo, return error
    12711   :
    12712   define input parameter p-node-code  as integer      no-undo.
    12713   define output parameter p-full-name as character    no-undo.
    12714       define buffer buf_alc-type       for ub.alc-type.
    12715       find first buf_alc-type no-lock
    12716            where buf_alc-type.alc-type-inner-code = p-node-code
    12717       no-error.
    12718       if not available buf_alc-type
    12719       then do:
    12720           undo, return error "grplib-get-full-name-alc-type: Не найден вид алкогольной продукции с кодом " + string( p-node-code ).
    12721       end.
    12722       assign
    12723       p-full-name = buf_alc-type.alc-type-name
    12724       .
    12725   end.
    12726   end procedure.
