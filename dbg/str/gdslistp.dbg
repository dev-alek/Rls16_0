     7261           and  buf_gds-list-hist.item_  <> '':U:
     7262         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next _ii.
     7263         find first ub.trn-doc no-lock where
     7264                 rowid(ub.trn-doc) = v-rowid no-error.
     7265         if not avail ub.trn-doc then next _ii.
     7266         for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
     7267             first ub.goods where ub.goods.artic     = ub.doc-line.artic
     7268                           and ub.goods.prod-type = ub.doc-line.prod-type
     7269                           and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
     7270           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     7271           if glog and
     7272               available gds-list and
     7273               gds-list.artic = ub.goods.artic and
     7274               gds-list.prod-type = ub.goods.prod-type and
     7275               gds-list.prod-code = ub.goods.prod-code then do:
     7276             gds-list.qnty = if can-do ('рас,спи':U, ub.trn-doc.doc-type) then
     7277                         gds-list.qnty - ub.doc-line.fact-qnty
     7278                       else
     7279                         gds-list.qnty + ub.doc-line.fact-qnty.
     7280             if gds-list.qnty < 0 then do:
     7281               if not p-from-macro or p-step then
     7282               message "Артикул:" ub.doc-line.artic skip
     7283                       "Количество в накладной:" ub.doc-line.fact-qnty skip
     7284                       "Итоговое количество в списке:" gds-list.qnty skip (2)
     7285                       "Заменено на 0."
     7286                       view-as alert-box .
     7287               gds-list.qnty = 0.
