    11239       dsp-rs = substitute("ФиБ партии свободной зоны на &1&2 &4", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11240       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11241       .
    11242     end.
    11243   END CASE.
    11244   v-no-hist = 0.
