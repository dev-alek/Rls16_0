       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       71   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       72   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       73   ASSIGN
       74      v-S_CONTRACT                = "Contract":U
       75      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       76      v-DELIM_CHR_3               = ","
       77      .
       78   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
       79   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
       80   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       81   FUNCTION Can-Find-Spec RETURN LOGICAL (
       82      INPUT iHost-Code    AS INTEGER,
       83      INPUT iContract-Num AS INTEGER,
       84      INPUT iGds-Code     AS INTEGER ):
       85      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
       86      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
       87      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
       88      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       89      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
       90      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
       91          INPUT  iHost-Code,
       92          INPUT  iContract-Num,
       93          OUTPUT iTmp-Extent3
       94          ).
       95      IF iTmp-Extent3[1] = 2 THEN DO:
       96         ASSIGN
       97            iTmp-Host-Code      = iTmp-Extent3[2]
       98            iTmp-Contract-Num   = iTmp-Extent3[3]
       99            .
      100      END. ELSE DO:
      101         ASSIGN
      102            iTmp-Host-Code      = iHost-Code
      103            iTmp-Contract-Num   = iContract-Num
      104            .
      105      END.
      106      IF iGds-Code = ? THEN DO:
      107         ASSIGN
      108            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      109                                  buf_Spec.Host-Code     = iTmp-Host-Code
      110                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      111                           ).
      112      END. ELSE DO:
      113            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      114                                  buf_Spec.Host-Code     = iTmp-Host-Code
      115                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      116                              AND buf_Spec.Gds-Code      = iGds-Code
      117                            ).
      118      END.
      119      RETURN (lRet).
      120   END FUNCTION.
      121   PROCEDURE MS-Contract-EXTENT-3:
      122      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      123      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      124      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      125      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      126      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      127      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      128      FIND FIRST buf_Cont-2 WHERE
      129                 buf_Cont-2.Host-Code      = i-Host-Code
      130             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      131           NO-LOCK NO-ERROR.
      132      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      133         RETURN.
      134      END.
      135      FOR FIRST buf_Ext-Classif WHERE
      136                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      137           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      138                                               STRING(i-Contract-code)
      139           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      140          NO-LOCK,
      141          EACH buf_Cont WHERE
      142               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      143           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      144          NO-LOCK:
      145          ASSIGN
      146             i-Ret[1] = 1
      147             i-Ret[2] = buf_Cont.Host-code
      148             i-Ret[3] = buf_Cont.Contract-code
      149             .
      150          LEAVE.
      151      END.
      152      IF i-Ret[1] <> 1 THEN DO:
      153         FOR FIRST buf_Ext-Classif WHERE
      154                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      155              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      156                                                  STRING(i-Contract-code)
      157              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      158             NO-LOCK,
      159             EACH buf_Cont WHERE
      160                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      161              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      162             NO-LOCK:
      163             ASSIGN
      164                i-Ret[1] = 2
      165                i-Ret[2] = buf_Cont.Host-code
      166                i-Ret[3] = buf_Cont.Contract-code
      167                .
      168             LEAVE.
      169         END.
      170      END.
      171      RETURN.
      172   END PROCEDURE.
