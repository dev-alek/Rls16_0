     4012   PROCEDURE proc-valchg-a-n-c:
     4013     case input frame Dialog-Frame a-n-c :
     4014       when "art" then do:
     4015         apply "entry" to br-list in frame Dialog-Frame.
     4016         hide loc-name loc-code
     4017         in frame Dialog-Frame.
     4018         loc-art = "".
     4019       end.
     4020       when "name" then do:
     4021         enable loc-name with frame Dialog-Frame.
     4022         disp loc-name with frame Dialog-Frame.
     4023         hide loc-art loc-code
     4024         in frame Dialog-Frame.
     4025         apply "entry" to loc-name in frame Dialog-Frame.
     4026       end.
     4027       when "code"
     4028    or when "DataMatrix" then
     4029       do:
     4030         enable loc-code with frame Dialog-Frame.
     4031         disp loc-code with frame Dialog-Frame.
     4032         hide loc-art loc-name
     4033         in frame Dialog-Frame.
     4034         apply "entry" to loc-code in frame Dialog-Frame.
     4035       end.
     4036     end CASE.
     4037   END PROCEDURE.
     4038   PROCEDURE proc-any-printable-br-list :
     4039     if input frame Dialog-Frame a-n-c = "art" then do:
     4040       if last-event:label = " " and
     4041          loc-art = "" then
     4042       return error.
     4043       find first l-gds-list where
     4044                   l-gds-list.artic begins (loc-art + last-event:label)
     4045                  no-lock no-error.
     4046       if available l-gds-list then do:
     4047         loc-art = loc-art + last-event:label.
     4048         disp loc-art with frame Dialog-Frame.
     4049         line-rec = recid (l-gds-list).
     4050         reposition br-list to recid line-rec no-error.
     4051         apply "value-changed" to br-list in frame Dialog-Frame.
     4052       end.
     4053     end.
     4054   END PROCEDURE.
     4055   PROCEDURE proc-backspace-br-list:
     4056     if input frame Dialog-Frame a-n-c = "art" then do:
     4057       if loc-art = "" then
     4058         return error.
     4059       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4060       find first l-gds-list where
     4061                   l-gds-list.artic begins loc-art
     4062                  no-lock.
     4063       disp loc-art with frame Dialog-Frame.
     4064       line-rec = recid (l-gds-list).
     4065       reposition br-list to recid line-rec no-error.
     4066       apply "value-changed" to br-list in frame Dialog-Frame.
     4067     end.
     4068   END PROCEDURE.
     4069   PROCEDURE proc-mouse-dbl-click-loc-code:
     4070   def var str-code as integer no-undo.
     4071   define variable varresult   as character         no-undo.
     4072   define variable vartype-bc  as character         no-undo.
     4073   define variable varweight   as decimal           no-undo.
     4074   define buffer l-goods for ub.goods.
     4075   define buffer l-bar-code for ub.bar-code.
     4076   define buffer buf_bar-code for ub.bar-code .
     4077   define buffer buf_prod-bc for ub.prod-bc.
     4078   define buffer buf_place for ub.place.
     4079     assign
     4080     frame Dialog-Frame
     4081     loc-code
     4082     a-n-c.
     4083     if a-n-c = "datamatrix"
     4084     then do:
     4085   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4086   (
     4087    input  parparentproc
     4088   ,input  loc-code
     4089   ,input  ?
     4090   ,input  p-curr-obj-type
     4091   ,input  p-curr-obj-code
     4092   ,input  yes
     4093   ,input  no
     4094   ,input  varscales-pref30
     4095   ,input  varpgscales-pref30
     4096   ,output varresult
     4097   ,output vartype-bc
     4098   ,output varweight
     4099   ,buffer buf_bar-code
     4100   ,buffer buf_prod-bc
     4101   ,buffer buf_place
     4102   ) no-error.
     4103        if varresult eq "prod-bc"
     4104        then
     4105           loc-code:screen-value in frame Dialog-Frame = buf_prod-bc.b-str.
     4106     end.
     4107     else do:
     4108   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4109   (
     4110    input  parparentproc
     4111   ,input  loc-code
     4112   ,input  ?
     4113   ,input  p-curr-obj-type
     4114   ,input  p-curr-obj-code
     4115   ,input  yes
     4116   ,input  no
     4117   ,input  varscales-pref30
