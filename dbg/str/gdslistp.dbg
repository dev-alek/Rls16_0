     7131         for each ub.clients where ub.clients.grp-name begins grp-path no-lock:
     7132           if rs-list-method = "grp-prod" then do:
     7133           for each ub.goods where ub.goods.prod-type = ub.clients.obj-type
     7134                           and ub.goods.prod-code = ub.clients.obj-code no-lock:
     7135             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     7136           end.
     7137           end.
     7138           if rs-list-method = "grp-supp" then do:
     7139             for each ub.cli-gds where ub.cli-gds.cli-type = ub.clients.obj-type
     7140                               and ub.cli-gds.cli-code = ub.clients.obj-code
     7141                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
     7142                 each ub.goods where goods.artic = ub.cli-gds.artic
     7143                               and ub.goods.prod-type = ub.cli-gds.prod-type
     7144                               and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
     7145               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     7146             end.
     7147           end.
     7148         end.
     7149         assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7150       end.
     7151     end.
     7152     when "producer"
     7153     or
