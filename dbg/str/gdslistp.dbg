     7096         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7097         grp-path = "".
