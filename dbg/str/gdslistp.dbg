    10678       END CASE.
    10679       if v-spr = "":U then do:
    10680         run gbl/d-prompt.w (
    10681           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10682         + 'text1=':u + vlabel + '\':u
    10683         + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
    10684         + 'type=' + vtype + '\':u
    10685         + 'fillin_row=2\':u
    10686         + 'fillin_col=4\':u
    10687         + 'fillin_width=20\':u
    10688         + 'fillin_height=1\':u
    10689         + 'max-chars=70\':u
    10690         + 'readonly=no\':u
    10691         , input-output vvalue
    10692         ).
    10693         if return-value = 'false':U then do:
    10694           return error.
    10695         end.
