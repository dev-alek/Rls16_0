     5173           end.
     5174         end.
     5175       end.
     5176       else do:
     5177         for each buf_temp-diasize-handle
     5178         on error undo move_block, retry move_block
     5179         :
     5180           assign
     5181             v-object-handle = buf_temp-diasize-handle.handle-value
     5182           .
     5183           if v-object-handle <> v-diasize-resize-button
     5184           then do:
     5185             assign
     5186               v-object-handle :col = v-object-handle :col + p-change-value
     5187               no-error .
     5188             if error-status :error
     5189             or error-status :get-message(1) <> ""
     5190             then do:
     5191               undo move_block, retry move_block .
     5192             end.
     5193           end.
     5194         end.
     5195         for each buf_temp-browse-handle
     5196           where buf_temp-browse-handle.browse-type = 'width':u
     5197         on error undo move_block, retry move_block
     5198         :
     5199           assign
     5200             buf_temp-browse-handle.browse-handle :width
     5201               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5202             no-error .
     5203           if error-status :error
     5204           or error-status :get-message(1) <> ""
     5205           then do:
     5206             undo move_block, retry move_block .
     5207           end.
     5208         end.
     5209         assign
     5210           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5211           no-error .
     5212         if error-status :error
     5213         or error-status :get-message(1) <> ""
     5214         then do:
     5215           undo move_block, retry move_block.
     5216         end.
     5217         assign
     5218           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5219         no-error .
     5220         if error-status :error
     5221         or error-status :get-message(1) <> ""
     5222         then do:
     5223           undo move_block, retry move_block.
     5224         end.
     5225         if frame Dialog-Frame :scrollable = true
     5226         then do:
     5227           assign
     5228             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5229           no-error .
     5230           if error-status :error
     5231           or error-status :get-message(1) <> ""
     5232           then do:
     5233             undo move_block, retry move_block.
     5234           end.
     5235         end.
     5236       end.
     5237       if p-move-resize
     5238       then do:
     5239         run diasize_position-resize-button in this-procedure .
     5240       end.
     5241       if v-diasize-wndstore = true
     5242       then do:
     5243         if connected("ub") = true
     5244         then do:
     5245           define variable v-cntxt-db-num        as integer   no-undo .
     5246           define variable v-cntxt-userid        as character no-undo .
     5247           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5248                                             , OUTPUT v-cntxt-userid
     5249                                             ) .
     5250           run gbl/wndsizew.p
     5251             (input  v-cntxt-db-num
     5252             ,input  v-cntxt-userid
     5253             ,input  v-diasize-proc-name
     5254             ,input  'width':u
     5255             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5256             ) .
     5257         end.
     5258       end.
     5259     end.
     5260     assign
     5261       v-diasize-change-size = false
     5262     .
     5263   end procedure.
     5264   procedure diasize_set-width :
     5265     define input  parameter p-new-width  as decimal   no-undo .
     5266     define input  parameter p-move-resize as logical   no-undo .
     5267     do
     5268     on error undo, return error return-value
     5269     :
     5270       run diasize_change-width in this-procedure
     5271         (input  (p-new-width - frame Dialog-Frame :width)
     5272         ,input  p-move-resize
     5273         ) .
     5274     end.
     5275   end procedure.
     5276   procedure diasize_position-resize-button :
     5277     do with frame Dialog-Frame
     5278     :
     5279       hide v-diasize-resize-button .
     5280       assign
     5281         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5282                     - 1
     5283                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5284         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5285                     - 1
     5286                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5287       .
     5288       view v-diasize-resize-button .
     5289     end.
     5290   end procedure.
     5291   on alt-right anywhere
     5292   do:
     5293     run diasize_change-width in this-procedure
     5294       (input 1
     5295       ,input true
     5296       ) .
     5297     return no-apply .
     5298   end.
     5299   on alt-left anywhere
     5300   do:
     5301     run diasize_change-width in this-procedure
     5302       (input -1
     5303       ,input true
     5304       ) .
     5305     return no-apply .
     5306   end.
     5307   on alt-down anywhere
     5308   do:
     5309     run diasize_change-height in this-procedure
     5310       (input 1
     5311       ,input true
     5312       ) .
     5313     return no-apply .
     5314   end.
     5315   on alt-up anywhere
     5316   do:
     5317     run diasize_change-height in this-procedure
     5318       (input -1
     5319       ,input true
     5320       ) .
     5321     return no-apply .
     5322   end.
     5323   on alt-enter of frame Dialog-Frame
     5324   do:
     5325     run diasize_maximize in this-procedure
     5326       (input  ?
     5327       ).
     5328     return no-apply .
     5329   end.
     5330   procedure diasize_end-move :
     5331     do
     5332     on error undo, return error return-value
     5333     :
     5334       define variable v-row-delta as decimal   no-undo .
     5335       define variable v-col-delta as decimal   no-undo .
     5336       define variable v-new-row as decimal   no-undo .
     5337       define variable v-new-col as decimal   no-undo .
     5338       assign
     5339         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5340         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5341       .
     5342       assign
     5343         v-row-delta = v-new-row - frame Dialog-Frame :height
     5344         v-col-delta = v-new-col - frame Dialog-Frame :width
     5345       .
     5346       run diasize_change-height in this-procedure
     5347         (input v-row-delta
     5348         ,input true
     5349         ) .
     5350       run diasize_change-width in this-procedure
     5351         (input v-col-delta
     5352         ,input true
     5353         ) .
     5354     end.
     5355   end procedure.
     5356   procedure diasize_maximize :
     5357     define input  parameter p-action as logical   no-undo .
     5358     do
     5359     on error undo, return error return-value
     5360     :
     5361       if p-action = ?
     5362       then do:
     5363         if v-diasize-need-maximize = true
     5364         then do:
     5365           assign
     5366             p-action = true
     5367           .
     5368         end.
     5369         else do:
     5370           assign
     5371             p-action = false
     5372           .
     5373         end.
     5374       end.
     5375       if p-action = true
     5376       then do:
     5377         run diasize_change-height in this-procedure
     5378           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5379               - frame Dialog-Frame :height-chars
     5380           ,input true
     5381           ) .
     5382         run diasize_change-width in this-procedure
     5383           (input session :width-chars
     5384               - frame Dialog-Frame :width-chars
     5385           ,input true
     5386           ) .
     5387         assign
     5388           v-diasize-need-maximize = false
     5389         .
     5390       end.
     5391       else do:
     5392         run diasize_change-width in this-procedure
     5393           (input v-diasize-orig-frame-width
     5394               - frame Dialog-Frame :width-chars
     5395           ,input true
     5396           ) .
     5397         run diasize_change-height in this-procedure
     5398           (input v-diasize-orig-frame-height
     5399               - frame Dialog-Frame :height-chars
     5400           ,input true
     5401           ) .
     5402         assign
     5403           v-diasize-need-maximize = true
     5404         .
     5405       end.
     5406     end.
     5407   end procedure.
     5408   procedure diasize_restore-orig-size :
     5409     do
     5410     on error undo, return error return-value
     5411     :
     5412       assign
     5413         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5414         v-diasize-current-frame-height = frame Dialog-Frame :height
     5415       .
     5416       run diasize_set-height in this-procedure
     5417         (input  v-diasize-orig-frame-height
     5418         ,input  true
     5419         ) .
     5420       run diasize_set-width in this-procedure
     5421         (input  v-diasize-orig-frame-width
     5422         ,input  true
     5423         ) .
     5424     end.
     5425   end procedure.
     5426   procedure diasize_restore-current-size :
     5427     do
     5428     on error undo, return error return-value
     5429     :
     5430       run diasize_set-height in this-procedure
     5431         (input  v-diasize-current-frame-height
     5432         ,input  true
     5433         ) .
     5434       run diasize_set-width in this-procedure
     5435         (input  v-diasize-current-frame-width
     5436         ,input  true
     5437         ) .
     5438     end.
     5439   end procedure.
     5440   procedure diasize_set-browse-handle :
     5441     define input  parameter p-browse-handle as handle   no-undo .
     5442     define buffer buf_temp-browse-handle for temp-browse-handle .
     5443     do
     5444     on error undo, return error return-value
     5445     :
     5446       assign
     5447         v-diasize-browse-handle = p-browse-handle
     5448       .
     5449       for each buf_temp-browse-handle
     5450       on error undo, return error return-value
     5451       :
     5452         delete buf_temp-browse-handle .
     5453       end.
     5454     end.
     5455   end procedure.
     5456   procedure diasize_add_browse :
     5457     define input  parameter p-browse-type   as character no-undo .
     5458     define input  parameter p-browse-handle as handle    no-undo .
     5459     define buffer buf_temp-browse-handle for temp-browse-handle .
     5460     do
     5461     on error undo, return error return-value
     5462     :
     5463       assign
     5464         v-diasize-browse-number = v-diasize-browse-number + 1
     5465       .
     5466       create buf_temp-browse-handle .
     5467       assign
     5468         buf_temp-browse-handle.browse-type   = p-browse-type
     5469         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5470         buf_temp-browse-handle.browse-handle = p-browse-handle
     5471       .
     5472     end.
     5473   end procedure.
     5474   procedure diasize_init :
     5475     define variable v-default-value    as logical   no-undo .
     5476     define variable v-restore-saved    as logical   no-undo .
     5477     define variable v-resize-value-str as character no-undo .
     5478     do
     5479     on error undo, return error return-value
     5480     :
     5481       do with frame Dialog-Frame
     5482       :
     5483         assign
     5484           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5485           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5486           v-diasize-browse-handle     = browse br-list :handle
     5487         .
     5488         create button v-diasize-resize-button
     5489         assign
     5490           parent        = frame Dialog-Frame :first-child
     5491           label         = "s"
     5492           height-pixels = 16
     5493           width-pixels  = 16
     5494           visible       = true
     5495           sensitive     = true
     5496           movable       = true
     5497           triggers:
     5498             on end-move persistent run diasize_end-move in this-procedure .
     5499           end triggers.
     5500         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5501         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5502         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5503         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5504         assign
     5505           v-diasize-wndmax = false
     5506         .
     5507         if connected("ub") = true
     5508         then do:
     5509           define variable v-cntxt-db-num        as integer   no-undo .
     5510           define variable v-cntxt-userid        as character no-undo .
     5511           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5512                                             , OUTPUT v-cntxt-userid
     5513                                             ) .
     5514           run gbl/wndpar_r.p
     5515             (input  v-cntxt-db-num
     5516             ,input  v-cntxt-userid
     5517             ,input  'wndmax':U
     5518             ,output v-diasize-wndmax
     5519             ,output v-default-value
     5520             ) .
     5521         end.
     5522         assign
     5523           v-diasize-wndstore = false
     5524         .
     5525         if connected("ub") = true
     5526         then do:
     5527           run gbl/wndpar_r.p
     5528             (input  v-cntxt-db-num
     5529             ,input  v-cntxt-userid
     5530             ,input  'wndstore':U
     5531             ,output v-diasize-wndstore
     5532             ,output v-default-value
     5533             ) .
     5534         end.
     5535         assign
     5536           v-diasize-proc-name = entry(1, program-name(2), '.')
     5537         .
     5538         if v-diasize-wndstore = true
     5539         then do:
     5540           assign
     5541             v-restore-saved = false
     5542           .
     5543           if connected("ub") = true
     5544           then do:
     5545             run gbl/wndsizer.p
     5546               (input  v-cntxt-db-num
     5547               ,input  v-cntxt-userid
     5548               ,input  v-diasize-proc-name
     5549               ,input  'height':u
     5550               ,output v-resize-value-str
     5551               ) .
     5552             if v-resize-value-str <> '':U
     5553             then do:
     5554               run diasize_change-height in this-procedure
     5555                 (input  integer(v-resize-value-str)
     5556                 ,input  true
     5557                 ) .
     5558               assign
     5559                 v-restore-saved = true
     5560               .
     5561             end.
     5562           end.
     5563           if connected("ub") = true
     5564           then do:
     5565             run gbl/wndsizer.p
     5566               (input  v-cntxt-db-num
     5567               ,input  v-cntxt-userid
     5568               ,input  v-diasize-proc-name
     5569               ,input  'width':u
     5570               ,output v-resize-value-str
     5571               ) .
     5572             if v-resize-value-str <> '':U
     5573             then do:
     5574               run diasize_change-width in this-procedure
     5575                 (input  integer(v-resize-value-str)
     5576                 ,input  true
     5577                 ) .
     5578               assign
     5579                 v-restore-saved = true
     5580               .
     5581             end.
     5582           end.
     5583           if v-restore-saved <> true
     5584           then do:
     5585             if v-diasize-wndmax = true
     5586             then do:
     5587               run diasize_maximize in this-procedure
     5588                 (input  true
     5589                 ) .
     5590             end.
     5591           end.
     5592         end.
     5593         else do:
     5594           if v-diasize-wndmax = true
     5595           then do:
     5596             run diasize_maximize in this-procedure
     5597               (input  true
     5598               ) .
     5599           end.
     5600         end.
     5601       end.
     5602     end.
     5603   end procedure.
     5604   procedure diasize_need-full-display :
     5605     define output parameter p-need-full-display as logical   no-undo .
     5606     do
     5607     on error undo, return error return-value
     5608     :
     5609       assign
     5610         p-need-full-display = v-diasize-need-full-display
     5611       .
     5612       assign
     5613         v-diasize-need-full-display = false
     5614       .
     5615     end.
     5616   end procedure.
     5617   procedure get-context :
     5618      define output parameter p-db-num as integer          no-undo.
     5619      define output parameter p-user-id as character        no-undo.
     5620      define variable v-login               as character    no-undo.
     5621      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5622      define buffer buf_user-login  for ub.user-login .
     5623      do
     5624      on error undo, return error
     5625      :
     5626            FIND FIRST buf_sys-ctrl no-lock.
     5627            ASSIGN
     5628               v-login = USERID("ub")
     5629               p-db-num = buf_sys-ctrl.db-num
     5630            .
     5631            FIND FIRST buf_user-login
     5632                 WHERE buf_user-login.db-num = p-db-num
     5633                   AND buf_user-login.user-login = v-login
     5634                 no-lock
     5635                 no-error
     5636                 .
     5637            IF AVAILABLE buf_user-login
     5638            THEN DO:
     5639               assign
     5640                  p-user-id = buf_user-login.user-id
     5641               .
     5642            END.
     5643      end.
     5644   end procedure.
     5645   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5646   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5647   define variable v-no-context as logical no-undo .
     5648   define variable v-user-obj-type as character no-undo .
     5649   define variable v-user-obj-code as integer no-undo .
     5650   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5651                                            , input p-no-context as logical ):
     5652   define variable v-uniq-key-rec as character no-undo .
     5653   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5654     v-uniq-key-rec = 'clients':U + chr(3) +
     5655                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5656                     entry(5, p-uniq-key-rec, chr(3)).
     5657   end.
     5658   else do:
     5659     v-uniq-key-rec = p-uniq-key-rec.
     5660     case entry(1, p-uniq-key-rec, chr(3)):
     5661        when 'user-obj':U then do:
     5662          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5663          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5664        end.
     5665     end case.
     5666   end.
     5667   return v-uniq-key-rec.
     5668   end function.
     5669   procedure find-user-obj-rowid :
     5670   define input parameter p-rowid as rowid no-undo .
     5671   define input parameter p-no-context as logical no-undo .
     5672   define output parameter p-user-obj-type as character no-undo .
     5673   define output parameter p-user-obj-code as integer no-undo .
     5674   define buffer user-obj_clients for ub.clients.
     5675   define buffer user-obj_user-obj for ub.user-obj .
     5676   if p-no-context then do:
     5677     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5678     assign
     5679     p-user-obj-type = user-obj_clients.obj-type
     5680     p-user-obj-code = user-obj_clients.obj-code.
     5681   end.
     5682   else do:
     5683     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5684     if not available user-obj_user-obj then do:
     5685       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5686     end.
     5687     assign
     5688     p-user-obj-type = user-obj_user-obj.obj-type
     5689     p-user-obj-code = user-obj_user-obj.obj-code.
     5690   end.
     5691   end procedure.
     5692   define variable an-listp-start-macro-id as integer no-undo init ?.
     5693   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5694   define variable an-listp-macros-label-id as integer   no-undo .
     5695   define variable v-macro-is-running as logical no-undo .
     5696   define variable v-current-step as integer no-undo .
     5697   define variable v-expand as logical no-undo .
     5698   define variable v-downed as character no-undo .
     5699   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5700   define     temp-table keep-macro-list-hist no-undo
     5701   field list-table as character
     5702   field id as integer
     5703   field line as integer
     5704   field hist-mode as character
     5705   field des as character
     5706   field num-recs as integer
     5707   field option_ as character
     5708   field item_ as character
     5709   field status_ as character
     5710   field num-add as integer
     5711   field num-ignored as integer
     5712   field done as logical
     5713   field err_ as logical
     5714   field err-mes as character
     5715   index pi is primary
     5716   id
     5717   line
     5718   index isdone
     5719   done
     5720   .
     5721   procedure assign-nums :
     5722   define input-output parameter p-num-add as integer no-undo .
     5723   define input-output parameter p-num-rec as integer no-undo .
     5724   define input-output parameter p-num-ignored as integer no-undo .
     5725   define input parameter p-line-mode as character no-undo .
     5726   assign
     5727   p-num-add  = lns-cnt - v-num-add
     5728   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5729                             then (tot-lns + p-num-add)
     5730                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5731   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5732   p-num-ignored = lns-ignore  - v-num-ignored
     5733   v-num-add             = lns-cnt
     5734   v-num-ignored         = lns-ignore
     5735   .
     5736   END PROCEDURE.
     5737   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5738   or INSERT-MODE of br-list
     5739   DO:
     5740   define variable glog as logical no-undo .
     5741   define buffer buf-gds-list-hist for gds-list-hist.
     5742   define buffer buf_macro-list-hist for macro-list-hist.
     5743   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5744    if p-keep-query then do:
     5745       glog = no.
     5746       message "Реинициализация списка. Вы уверены ?"
     5747               view-as alert-box question buttons OK-Cancel update glog.
     5748       if not glog then return no-apply.
     5749       if session:set-wait-state( "COMPILER" )  then .
     5750       for each gds-list:
     5751         delete gds-list.
     5752       end.
     5753       if session:set-wait-state( "" )  then .
     5754       tot-lns = 0.
     5755       v-seq = 1.
     5756       for each buf-gds-list-hist:
     5757         delete buf-gds-list-hist.
     5758       end.
     5759      for each buf_keep-macro-list-hist:
     5760        create buf_macro-list-hist.
     5761      end.
     5762      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5763      run create-gds-list-hist in this-procedure (
     5764                                             input 'ДОБАВЛЕНИЕ':U
     5765                                           , input-output v-seq
     5766                                           , input 0
     5767                                           , input '0':U
     5768                                           , input "# Реинициализация списка."
     5769                                           , input 0
     5770                                           , input "init"
     5771                                           , input '':U
     5772                                           , input '':U
     5773                                           , input '':U
     5774                                           , input ?
     5775                                           ).
     5776       display
     5777       tot-lns @ f-tot-lns
     5778       ? @ ub.clients.obj-name
     5779       ? @ ub.gds-prt.node-name
     5780       ? @ ub.bar-code.b-code
     5781       with frame Dialog-Frame.
     5782       run ui-on in this-procedure .
     5783    end.
     5784    else do:
     5785      assign rs-list-method = "single".
     5786      run proc-b-add in this-procedure(input no
     5787                                     ,input ?
     5788                                     ,input rs-list-method
     5789                                     ,input rs-status)  no-error .
     5790     if error-status:error then return no-apply.
     5791   end.
     5792   END.
     5793   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5794   or DELETE-CHARACTER of br-list
     5795   DO:
     5796     if not available gds-list then return no-apply.
     5797     assign rs-list-method = "single".
     5798       run proc-b-del in this-procedure(
     5799                                                  input no
     5800                                                 ,input ?
     5801                                                 ,input rs-list-method
     5802                                                 ,input rs-status) no-error .
     5803     if error-status:error then return no-apply.
     5804   END.
     5805   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5806   DO:
     5807   if not available gds-list then return no-apply.
     5808     assign rs-list-method = "single".
     5809    run proc-b-rest in this-procedure(
     5810                                                   input no
     5811                                                  ,input ?
     5812                                                  ,input rs-list-method
     5813                                                  ,input rs-status) no-error .
     5814     if error-status:error then return no-apply.
     5815   END.
     5816   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5817     assign
     5818     macro-play-option = 'file':U.
     5819     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5820   end.
     5821   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5822     assign
     5823     macro-play-option = 'lob':U.
     5824     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5825   end.
     5826   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5827   DO:
     5828   if macro-play-option = '':U then do:
     5829         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5830   end.
     5831   if macro-play-option = '':U then return no-apply.
     5832   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5833   if error-status:error then return no-apply.
     5834   END.
     5835   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5836   DO:
     5837   define variable glog as logical no-undo .
     5838   message
     5839   "Начать запись макроса формирования списка?"
     5840   view-as alert-box QUESTION buttons yes-no update glog.
     5841   if not glog then return no-apply.
     5842   assign
     5843   an-listp-start-macro-id = v-seq
     5844   an-listp-end-macro-id = ?
     5845   .
     5846     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     5847     menu-item m-macro-lob:sensitive in menu m-play = no.
     5848   disable
     5849   b-record with frame Dialog-Frame .
     5850   hide
     5851   b-record
     5852   b-macro
     5853   in frame Dialog-Frame .
     5854   enable
     5855   b-stop with frame Dialog-Frame .
     5856   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5857                                       , input-output v-seq
     5858                                       , input 0
     5859                                       , input 'o':U
     5860                                       , input "Начата запись макроса формирования списка"
     5861                                       , input tot-lns
     5862                                       , input 'macro':U
     5863                                       , input '':U
     5864                                       , input '':U
     5865                                       , input '':U
     5866                                       , input ?
     5867                                       ).
     5868   END.
     5869   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5870   DO:
     5871   define variable glog as logical no-undo .
     5872   define variable v-id as integer no-undo .
     5873   define buffer buf_gds-list-hist for gds-list-hist.
     5874   message
     5875   "Закончить запись макроса формирования списка?"
     5876   view-as alert-box QUESTION buttons yes-no update glog.
     5877   if not glog then return no-apply.
     5878   assign
     5879   an-listp-end-macro-id = v-seq.
     5880   disable
     5881   b-stop with frame Dialog-Frame .
     5882   hide
     5883   b-stop in frame Dialog-Frame .
     5884   enable
     5885   b-record
     5886   b-macro
     5887   with frame Dialog-Frame .
     5888   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5889                                       , input-output v-seq
     5890                                       , input 0
     5891                                       , input '[]':U
     5892                                       , input "Закончена запись макроса формирования списка"
     5893                                       , input tot-lns
     5894                                       , input 'macro':U
     5895                                       , input '':U
     5896                                       , input '':U
     5897                                       , input '':U
     5898                                       , input ?
     5899                                       ).
     5900   for each macro-list-hist:
     5901     delete macro-list-hist.
     5902   end.
     5903   for each buf_gds-list-hist where
     5904           buf_gds-list-hist.id >=  an-listp-start-macro-id
     5905     and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     5906     create macro-list-hist.
     5907     buffer-copy buf_gds-list-hist
     5908     except id num-recs num-add num-ignored
     5909     to macro-list-hist
     5910     assign
     5911     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5912     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5913     .
     5914   end.
     5915   END.
     5916   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5917   DO:
     5918   disable
     5919   b-clear-macro with frame Dialog-Frame .
     5920   assign
     5921   an-listp-start-macro-id = ?
     5922   an-listp-end-macro-id = ?
     5923   an-listp-macros-label-id = 0
     5924   .
     5925   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5926   for each macro-list-hist:
     5927     delete macro-list-hist.
     5928   end.
     5929   hide
     5930   b-clear-macro in frame Dialog-Frame .
     5931   enable
     5932   b-record
     5933   b-macro
     5934   with frame Dialog-Frame .
     5935   END.
     5936   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5937   DO:
     5938     assign
     5939     Rs-list-method = temp-list.fvalue
     5940     .
     5941     run proc-vc-rs-list-method in this-procedure no-error .
     5942     if error-status:error then return no-apply.
     5943   END.
     5944   PROCEDURE get-operation :
     5945   define input parameter p-message as character no-undo .
     5946   define output parameter p-operation as integer no-undo .
     5947     do
     5948     on error undo, return error
     5949     :
     5950       run gbl/d-askw.w (
     5951                     input "Выбор операции над заданным списком"
     5952                    ,input (p-message + chr(10) +
     5953                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5954                    ,input "|"
     5955                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5956                            "Удалить" + "|" +
     5957                            "Оставить" + "|" +
     5958                            "Отказ")
     5959                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5960                           "Удалить полученный список из уже имеющегося" + "|" +
     5961                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5962                           "Ничего не делать")
     5963                    ,input  (if p-keep-query then 2 else 1)
     5964                    ,input  4
     5965                    ,output p-operation).
     5966      if p-operation = 4 then do:
     5967         return error .
     5968      end.
     5969     end.
     5970   END PROCEDURE.
