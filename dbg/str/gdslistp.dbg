    11209     when "parts-last-date":U then do:
    11210       assign
    11211       v-message = substitute("ФиБ партии свободной зоны на &1&2", chr(10), stat-line(rs-status))
    11212       .
    11213     end.
    11214   END CASE.
    11215   message
    11216   v-message
    11217   view-as alert-box question buttons OK-Cancel update glog.
    11218   if not glog then do:
    11219     return error.
