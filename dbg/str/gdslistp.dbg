     4877   procedure diasize_set-height :
     4878     define input  parameter p-new-height  as decimal   no-undo .
     4879     define input  parameter p-move-resize as logical   no-undo .
     4880     do
     4881     on error undo, return error return-value
     4882     :
     4883       run diasize_change-height in this-procedure
     4884         (input  (p-new-height - frame Dialog-Frame :height)
     4885         ,input  p-move-resize
     4886         ) .
     4887     end.
     4888   end procedure.
     4889   procedure diasize_change-width :
     4890     define input  parameter p-change-value as decimal   no-undo .
     4891     define input  parameter p-move-resize  as logical   no-undo .
     4892     define variable v-field-group-handle   as handle    no-undo .
     4893     define variable v-object-handle        as handle    no-undo .
