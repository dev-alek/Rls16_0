     6803   HIDE FRAME Dialog-Frame.
     6804   PROCEDURE UI-on:
     6805   define variable v-recid0 as recid no-undo.
     6806   define variable v-start as logical no-undo .
     6807   define buffer buf_temp-list for temp-list.
     6808   define buffer buf_gds-list-hist for gds-list-hist.
     6809     find first buf_gds-list-hist where buf_gds-list-hist.id = 0 no-error.
     6810     if available buf_gds-list-hist then
     6811     assign
     6812     frame Dialog-Frame:title = substitute("СПИСОК  ТОВАРОВ &1",  string(buf_gds-list-hist.des, "X(60)"))
     6813     .
     6814       assign
     6815       frame Dialog-Frame:title = p-title
     6816       .
     6817     if tot-lns = ? then do:
     6818       v-start = yes.
     6819       for each l-gds-list :
     6820         accumulate l-gds-list.artic (count).
     6821       end.
     6822       tot-lns = (accum count l-gds-list.artic).
     6823       if tot-lns > 0 then do:
     6824         find last  buf_gds-list-hist no-error .
     6825         v-seq = (if available buf_gds-list-hist then buf_gds-list-hist.id else 0)  + 1.
     6826         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6827                                              , input-output v-seq
     6828                                              , input 0
     6829                                              , input 'S':U
     6830                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6831                                              , input tot-lns
     6832                                              , input "start":U
     6833                                              , input '':U
     6834                                              , input '':U
     6835                                              , input '':U
     6836                                              , input ?
     6837                                              ).
     6838       end.
     6839       else do:
     6840         line-mode = 'ДОБАВЛЕНИЕ':U.
     6841         for each buf_gds-list-hist:
     6842           delete buf_gds-list-hist.
     6843         end.
     6844         v-seq = 1.
     6845         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6846                                              , input-output v-seq
     6847                                              , input 0
     6848                                              , input '':U
     6849                                              , input "# Исходный список товаров пуст."
     6850                                              , input tot-lns
     6851                                              , input 'start':U
     6852                                              , input '':U
     6853                                              , input '':U
     6854                                              , input '':U
     6855                                              , input ?
     6856                                              ).
     6857       end.
     6858     end.
     6859     hide loc-art in frame Dialog-Frame loc-name loc-code in frame Dialog-Frame.
     6860     assign
     6861     loc-art = ""
     6862     RS-list-method = "single"
     6863     .
     6864     find first buf_temp-list no-lock where
     6865                buf_temp-list.fvalue = rs-list-method.
     6866     assign
     6867     v-recid0 = recid(buf_temp-list).
     6868     open query br-option for each temp-list no-lock .
     6869     if v-seq > 1 then
     6870     find last buf_gds-list-hist no-lock where
     6871               buf_gds-list-hist.id = (v-seq - 1)
     6872          and  buf_gds-list-hist.line = 0 no-error .
     6873     DISPLAY br-option
     6874     (if available buf_gds-list-hist
     6875     then buf_gds-list-hist.des
     6876     else '') @ dsp-rs
     6877     RS-Status WITH FRAME Dialog-Frame.
     6878     ENABLE
     6879     b-macro  when v-start
     6880     b-record when v-start
     6881     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6882     if v-start then do:
     6883       hide
     6884       b-sel
     6885       b-mark
     6886       b-stop
     6887       b-clear-macro
     6888       in frame Dialog-Frame.
     6889       if lookup("b-sel", bttns) > 0
     6890       or lookup("b-mark", bttns) > 0
     6891       then do:
     6892         gds-list.to-sel:visible in browse br-list = yes.
     6893       end.
     6894       else do:
     6895         gds-list.to-sel:visible in browse br-list = no.
     6896       end.
     6897       if bttns <> '':U then do:
     6898         run proc-expand in this-procedure ( input 1, input b-sel:row, input br-list:row, input "b-sel,b-mark").
     6899       end.
     6900     end.
     6901     v-start = no.
     6902     if is-tsd = no then do:
     6903       menu-item m-scn-save:sensitive in menu m-save = no.
     6904     end.
     6905     if lookup('list':U, bttns) > 0 then do:
     6906        menu-item m-gds-save-db:sensitive  in menu m-save = no.
     6907     end.
     6908     if lookup('list-macro':U, bttns) > 0 then do:
     6909        menu-item m-macros-save-db:sensitive  in menu m-save = no.
     6910     end.
     6911     reposition br-option to recid v-recid0.
     6912     if tot-lns > 0 then do:
     6913       Enable b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6914       b-mark when lookup("b-mark", bttns) > 0
     6915       b-sel  when lookup("b-sel", bttns) > 0
     6916       WITH FRAME Dialog-Frame.
     6917     end.
     6918     else do:
     6919       DISABLE b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6920       b-mark b-sel
     6921       WITH FRAME Dialog-Frame.
     6922     end.
     6923     open query br-list for each gds-list no-lock indexed-reposition.
     6924     if line-rec <> ? then
     6925       reposition br-list to recid line-rec no-error.
     6926     apply "entry" to br-list in frame Dialog-Frame.
     6927     if available gds-list then do:     find ub.clients where ub.clients.obj-type = gds-list.prod-type                    and ub.clients.obj-code = gds-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     6928   END PROCEDURE.
     6929   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6930   PROCEDURE ex-gds :
     6931       define parameter buffer buf_goods for ub.goods.
     6932       define input parameter rs-list-method as character no-undo .
     6933       define input parameter rs-status as character no-undo .
     6934       define input parameter line-mode as character no-undo .
     6935       if rs-list-method = "single":U or
     6936           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
     6937           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
     6938       do:
     6939           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
     6940           do:
     6941               if rs-list-method = "tsd":U then
     6942               do:
     6943                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6944                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6945                       find first gds-list where gds-list.artic = buf_goods.artic
     6946                           and gds-list.prod-type = buf_goods.prod-type
     6947                           and gds-list.prod-code = buf_goods.prod-code no-error.
     6948                       if available gds-list then
     6949                       do:
     6950                           if line-mode = 'удаление':U then
     6951                           do:
     6952                               lns-cnt = lns-cnt + 1.
     6953                               delete gds-list.
     6954                           end.
     6955                           else
     6956                           do:
     6957                               if gds-list.to-del = ? then.
     6958                               else
     6959                               do:
     6960                                   lns-cnt = lns-cnt + 1.
     6961                                   gds-list.to-del = ?.
     6962                               end.
     6963                           end.
     6964                       end.
     6965                   end.
     6966               end.
     6967               else
     6968               do:
     6969                   find first gds-list where gds-list.artic = buf_goods.artic
     6970                       and gds-list.prod-type = buf_goods.prod-type
     6971                       and gds-list.prod-code = buf_goods.prod-code no-error.
     6972                   if available gds-list then
     6973                   do:
     6974                       if line-mode = 'удаление':U then
     6975                       do:
     6976                           lns-cnt = lns-cnt + 1.
     6977                           delete gds-list.
     6978                       end.
     6979                       else
     6980                       do:
     6981                           if gds-list.to-del = ? then.
     6982                           else
     6983                           do:
     6984                               lns-cnt = lns-cnt + 1.
     6985                               gds-list.to-del = ?.
     6986                           end.
     6987                       end.
     6988                   end.
     6989               end.
     6990           end.
     6991           else
     6992               if line-mode = 'ДОБАВЛЕНИЕ':U then
     6993               do:
     6994   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6995   find gds-list
     6996     where gds-list.prod-type = buf_goods.prod-type
     6997       and gds-list.prod-code = buf_goods.prod-code
     6998       and gds-list.artic     = buf_goods.artic
     6999     no-error .
     7000   if available gds-list then do:
     7001     assign
     7002       gds-list.to-del = no
     7003     .
     7004   end.
     7005   else do:
     7006     define variable v-last48 as integer no-undo .
     7007     find last gds-list use-index oi no-error.
     7008     if available gds-list then do:
     7009       v-last48 = gds-list.order-num .
     7010     end.
     7011     else do:
     7012       v-last48 = 0 .
     7013     end.
     7014     create gds-list .
     7015     buffer-copy buf_goods to gds-list
     7016     assign
     7017       gds-list.to-del = no
     7018       gds-list.order-num = v-last48 + 1
     7019     .
     7020     assign
     7021       lns-cnt = lns-cnt + 1
     7022       line-rec = recid (gds-list)
     7023     .
     7024   end.
     7025                   if rs-list-method = "tsd":U  then
     7026                   do:
     7027                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     7028                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     7029                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error.
     7030                           if available gds-list then
     7031                           do:
     7032                               gds-list.qnty = decimal(ub.Code.CodeValue) .
     7033                           end.
     7034                       end.
     7035                   end.
     7036               end.
     7037           if lns-cnt modulo 25 = 0 then
     7038               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7039       end.
     7040       else
     7041           assign
     7042               lns-ignore = lns-ignore + 1
     7043               .
     7044   end.
     7045   PROCEDURE rs-do:
     7046   define input parameter p-from-macro as logical no-undo .
     7047   define input parameter p-step as logical no-undo .
     7048   define input parameter rs-list-method as character no-undo .
     7049   define input parameter rs-status as character no-undo .
     7050   define input parameter line-mode as character no-undo .
     7051   define input parameter p-id      as integer no-undo .
     7052   define variable grp-path like ub.goods.grp-name no-undo.
     7053   define variable another-price like ub.price-list.price-sale no-undo.
     7054   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7055   define variable v-rowid   as rowid no-undo .
     7056   define variable v-tbl-name as character no-undo .
     7057   define variable v-discnt-role as character no-undo .
     7058   define variable v-nonunique as character no-undo .
     7059   define variable vvalue-int as integer no-undo .
     7060   define variable glog as logical no-undo .
     7061   define variable v-date-chr as character no-undo .
     7062   define variable v-date as date no-undo .
     7063   define buffer buf_gds-list-hist for gds-list-hist.
     7064   define buffer buf_user-obj for ub.user-obj.
     7065   define buffer buf_units for ub.units.
     7066   define buffer buf_parts for ub.parts.
     7067   do
     7068   on error undo, return error return-value
     7069   :
     7070   assign
     7071   lns-cnt = 0
     7072   lns-ignore = 0
     7073   v-num-add     = 0
     7074   v-num-ignored = 0
     7075   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7076   .
     7077   run write-hist in this-procedure ( input p-from-macro
     7078                                     ,input rs-list-method
     7079                                     ,input rs-status
     7080                                     ,input line-mode).
     7081   if session:set-wait-state( "COMPILER" )  then .
     7082   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7083   case rs-list-method:
