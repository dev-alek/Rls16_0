     3732       + 'fillin_col=4\':u
     3733       + 'fillin_width=60\':u
     3734       + 'fillin_height=1\':u
     3735       + 'max-chars=60\':u
     3736       + 'readonly=no\':u
     3737       , input-output v-value
     3738       ).
     3739   if return-value = 'false':u then return NO-apply.
