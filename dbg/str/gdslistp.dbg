     7213     when "etalon" then do:
     7214       find first buf_gds-list-hist where
     7215                buf_gds-list-hist.id = p-id
     7216           and  buf_gds-list-hist.item_  <> '':U.
     7217       run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
     7218         run find-user-obj-rowid in this-procedure ( input v-rowid, input v-no-context, output v-user-obj-type, output v-user-obj-code ).
     7219         for each ub.gds-obj where
     7220               ub.gds-obj.obj-type = p-curr-obj-type and
     7221               ub.gds-obj.obj-code = p-curr-obj-code no-lock,
     7222           first ub.goods where
     7223               ub.goods.prod-type = ub.gds-obj.prod-type and
     7224               ub.goods.prod-code = ub.gds-obj.prod-code and
     7225               ub.goods.artic     = ub.gds-obj.artic no-lock,
     7226           each ub.gds-prt where
     7227               ub.gds-prt.upper-code = ub.goods.prt-root no-lock,
     7228           each ub.bar-code where
     7229               ub.bar-code.gds-code  = ub.goods.gds-code and
     7230               ub.bar-code.node-code = ub.gds-prt.node-code and
     7231               ub.bar-code.unit-cli  = ub.goods.unit-base and
     7232               ub.bar-code.in-code   = "" and
     7233               ub.bar-code.part-code = "" no-lock:
     7234           find last ub.price-list where
     7235                     ub.price-list.obj-type  = p-curr-obj-type and
     7236                     ub.price-list.obj-code  = p-curr-obj-code and
     7237                     ub.price-list.b-code    = ub.bar-code.b-code and
     7238                     ub.price-list.price-type = ""
     7239                     use-index fact-close no-lock no-error.
     7240           if available ub.price-list and
     7241             ub.price-list.fact-order <> 0 then do:
     7242             another-price = ub.price-list.price-sale.
     7243             find last ub.price-list where ub.price-list.obj-type  = v-user-obj-type
     7244                                   and ub.price-list.obj-code  = v-user-obj-code
     7245                                   and ub.price-list.b-code    = bar-code.b-code
     7246                                   use-index fact-close no-lock no-error.
     7247             if available ub.price-list and
     7248               ub.price-list.fact-order <> 0 and
     7249               ub.price-list.price-sale <> another-price then
     7250               run ex-gds  in this-procedure( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
