    10485   PROCEDURE trig-attr :
    10486   define input parameter p-attr-table as character no-undo .
    10487   define input parameter p-list       as character no-undo .
    10488   DEFINE VARIABLE ii as integer no-undo .
    10489   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10490   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10491   DEFINE VARIABLE vtooltip             as character           no-undo.
    10492   DEFINE VARIABLE vlabel               as character           no-undo .
    10493   DEFINE VARIABLE vtype                as character           no-undo .
    10494   DEFINE VARIABLE vformat              as character           no-undo .
    10495   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
    10496   DEFINE VARIABLE voutput-display      as logical             no-undo .
    10497   DEFINE VARIABLE vother               as character           no-undo .
    10498   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10499   DEFINE VARIABLE jj                   as integer             no-undo .
    10500   DEFINE VARIABLE v-spr                as character           no-undo .
    10501   DEFINE VARIABLE v-spr-param          as character           no-undo .
    10502   DEFINE VARIABLE v-setted             as logical             no-undo .
