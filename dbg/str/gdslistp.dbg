     7169                             and ub.cli-gds.cli-code = ub.clients.obj-code
     7170                             and ub.cli-gds.host-code = p-curr-host-code
     7171                             and ub.cli-gds.in-qnty <> 0 no-lock,
     7172               first ub.goods where ub.goods.artic = ub.cli-gds.artic
     7173                           and ub.goods.prod-type = ub.cli-gds.prod-type
     7174                           and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
