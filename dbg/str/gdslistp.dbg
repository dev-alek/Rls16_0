     7197     when "object" then do:
     7198       find first buf_gds-list-hist where
     7199                buf_gds-list-hist.id = p-id
     7200           and  buf_gds-list-hist.item_  <> '':U.
     7201       run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
     7202        run find-user-obj-rowid in this-procedure ( input v-rowid, input v-no-context, output v-user-obj-type, output v-user-obj-code ).
     7203         for each ub.gds-obj where ub.gds-obj.obj-type = v-user-obj-type
     7204                           and ub.gds-obj.obj-code = v-user-obj-code no-lock,
     7205             first ub.goods where ub.goods.prod-type = ub.gds-obj.prod-type
     7206                         and ub.goods.prod-code = ub.gds-obj.prod-code
     7207                         and ub.goods.artic = ub.gds-obj.artic no-lock:
     7208           run ex-gds in this-procedure( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
