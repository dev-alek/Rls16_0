    10639       end.
    10640       if  v-init <> "":U then do:
    10641           run  value(v-init)
    10642                       in this-procedure (
    10643                                            input 0
    10644                                          , input v-sel-obj-type
    10645                                          , input v-sel-obj-code
    10646                                          , output vvalue) no-error .
    10647             if error-status:error then do:
