     4369   on help of frame Dialog-Frame
     4370   do:
     4371     run gbl/app_help.p
     4372       (input this-procedure :file-name
     4373       ,input ''
     4374       ,input ?
     4375       ) no-error.
     4376     if error-status :error then do:
     4377       message
     4378         "Ошибка при вызове помощи"
