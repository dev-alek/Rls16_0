     3755   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3756   define variable glog as logical no-undo .
     3757   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3758   if lookup(b-save :type in frame Dialog-Frame
     3759            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3760            ) = 0
     3761   then do:
     3762     message
     3763       "$Workfile$"
     3764       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3765       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3766       "Тип" self :type in frame Dialog-Frame skip
     3767       "Процедура" this-procedure :file-name skip
     3768       view-as alert-box .
     3769   end.
     3770   else do:
     3771     apply "entry":u to b-save in frame Dialog-Frame .
     3772     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3773       return no-apply .
     3774     end.
     3775   end.
     3776     assign
     3777       f-name = "default.gds"
     3778       glog = yes
     3779       .
     3780     system-dialog get-file f-name
     3781       filters "Списки товаров *.gds" "*.gds"
     3782       ask-overwrite
     3783       save-as
     3784       use-filename
     3785       update glog
     3786       default-extension "gds".
     3787     if not glog then do:
     3788       apply "entry" to br-list in frame Dialog-Frame.
     3789       return no-apply.
     3790     end.
     3791     output to value (f-name).
     3792     for each gds-list:
     3793       export gds-list.prod-type
     3794             gds-list.prod-code
     3795             gds-list.artic
     3796             gds-list.qnty
     3797             .
     3798     end.
     3799     output close.
     3800   END.
