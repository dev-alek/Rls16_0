     6754     gds-list.grp-name:resizable in browse br-list = true
     6755     RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     6756                               "Все!" + chr(44) + 'все':U + chr(44) +
     6757                               "Неактивные-" + chr(44) + 'удаленные':U
     6758     RS-status = 'текущие':U
     6759     .
