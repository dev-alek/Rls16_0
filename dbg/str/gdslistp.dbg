     3672       f-tot-lns AT ROW 5.25 col 65 no-label
     3673       br-list  AT ROW 6 COL 1
     3674       ub.clients.obj-name  at row 22 col 6 colon-aligned label "Пр-ль" fgcolor 4
     3675       ub.gds-prt.node-name at row 22 col 40 colon-aligned label "Шкала" fgcolor 4
     3676       ub.bar-code.b-code   at row 22 col 60 colon-aligned label "Код" format "9999999999" fgcolor 4
     3677       SPACE(0) SKIP(0)
     3678       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3679           SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     3680           TITLE "СПИСОК  ТОВАРОВ":L
     3681           DEFAULT-BUTTON b-exit.
     3682   ASSIGN
     3683     b-save:POPUP-MENU IN FRAME Dialog-Frame = MENU m-save:HANDLE
     3684     b-macro:POPUP-MENU IN FRAME Dialog-Frame = MENU m-play:HANDLE
     3685     FRAME Dialog-Frame:SCROLLABLE = FALSE
     3686     b-save:MENU-MOUSE = 1
     3687     b-macro:menu-mouse = 1
     3688     .
