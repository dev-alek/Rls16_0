     1697   procedure userobjs_clear :
     1698     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1699     do
     1700     on error undo, return error return-value
     1701     :
     1702       for each buf_userobjs_temp-user-obj
     1703       on error undo, return error return-value
     1704       :
     1705         delete buf_userobjs_temp-user-obj .
     1706       end.
     1707     end.
     1708   end .
     1709   procedure userobjs_object-count :
     1710     define output parameter p-total-count as integer   no-undo .
     1711     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1712     do
     1713     on error undo, return error return-value
     1714     :
     1715       assign
     1716         p-total-count = 0
     1717       .
     1718       for each buf_userobjs_temp-user-obj
     1719       on error undo, return error return-value
     1720       :
     1721         assign
     1722           p-total-count = p-total-count + 1
     1723         .
     1724       end.
     1725     end.
     1726   end.
     1727   procedure userobjs_append :
     1728      define input  parameter p-obj-type as character no-undo .
     1729      define input  parameter p-obj-code as integer   no-undo .
     1730     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       find first buf_userobjs_temp-user-obj
     1735         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1736           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1737         no-error .
     1738       if not available buf_userobjs_temp-user-obj
     1739       then do:
     1740         create buf_userobjs_temp-user-obj .
     1741         assign
     1742           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1743           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1744         .
     1745       end.
     1746     end.
     1747   end.
     1748   procedure userobjs_object-exist :
     1749     define output parameter p-object-exist as logical   no-undo .
     1750     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1751     do
     1752     on error undo, return error return-value
     1753     :
     1754       find first buf_userobjs_temp-user-obj
     1755         no-error .
     1756       if not available buf_userobjs_temp-user-obj
     1757       then do:
     1758         assign
     1759           p-object-exist = false
     1760         .
     1761       end.
     1762       else do:
     1763         assign
     1764           p-object-exist = true
     1765         .
     1766       end.
     1767     end.
     1768   end.
     1769   procedure userobjs_transfer :
     1770     define input  parameter p-callback-handle as handle no-undo .
     1771     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1772     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1773     do
     1774     on error undo, return error return-value
     1775     :
     1776       if valid-handle(p-callback-handle) <> true
     1777       then do:
     1778         message
     1779           vss-workfile vss-revision vss-description skip
     1780           "Ошибка задания входных параметров" skip
     1781           "Неизвестный указатель на процедуру" skip
     1782           view-as alert-box error .
     1783         undo, return error return-value .
     1784       end.
     1785       if p-callback-handle :get-signature("userobjs_append") = ""
     1786       then do:
     1787         message
     1788           vss-workfile vss-revision vss-description skip
     1789           "Ошибка задания входных параметров" skip
     1790           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1791                     ,p-callback-handle :file-name
     1792                     ) skip
     1793           view-as alert-box error .
     1794         undo, return error return-value .
     1795       end.
     1796       for each buf_userobjs_temp-user-obj
     1797       on error undo, return error return-value
     1798       :
     1799         run userobjs_append in p-callback-handle
     1800           (input  buf_userobjs_temp-user-obj.obj-type
     1801           ,input  buf_userobjs_temp-user-obj.obj-code
     1802           ) .
     1803       end.
     1804     end.
     1805   end procedure.
