    10504   define variable v-item               as character           no-undo .
    10505   define variable glog as logical no-undo .
    10506   define variable v-list               as character           no-undo .
    10507   assign
    10508   v-attr-code = ""
    10509   vattr-codes = ""
    10510   vattr-labels = ""
    10511   vvalue = ""
    10512   .
    10513   DO ii = 1 to num-entries ( p-list):
    10514       CASE p-attr-table:
    10515         when "gds-obj-attr" then do:
    10516           run gdsoattr-name  in this-procedure (
    10517                                                 input entry(ii, p-list)
    10518                                                 ,output vtype
    10519                                                 ,output vformat
    10520                                                 ,output vlabel
    10521                                                 ,output vuser-can-edit
    10522                                                 ,output voutput-display
    10523                                                 ,output vother) no-error.
    10524         end.
    10525         when "gds-host-attr" then do:
    10526           v-list = 'no-envd,':u.
    10527           run gdshattr-name in this-procedure (
    10528                                                 input entry(ii, p-list)
    10529                                               ,output vtype
    10530                                               ,output vformat
    10531                                               ,output vlabel
    10532                                               ,output vuser-can-edit
    10533                                               ,output voutput-display
    10534                                               ,output vother) no-error.
    10535         end.
    10536         WHEN "goods-attr" then do:
    10537           run gds-attr-name in this-procedure (
    10538                                                 input entry(ii, p-list)
    10539                                                 ,output vtype
    10540                                                 ,output vformat
    10541                                                 ,output vlabel
    10542                                                 ,output vuser-can-edit
    10543                                                 ,output voutput-display
    10544                                                 ,output vother) no-error.
    10545         end.
    10546       END CASE.
    10547       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
    10548           assign
    10549           vattr-codes = vattr-codes + chr(4) + entry(ii, p-list)
    10550           vattr-labels = vattr-labels + chr(4) + vlabel
    10551           .
    10552       end.
    10553   end.
    10554   run gbl/d-list.w ( input "b-sel":U
    10555                     ,input "Выберите атрибут"
    10556                     ,input vattr-codes
    10557                     ,input vattr-labels
    10558                     ,input chr(4)
    10559                     ,input "":U
    10560                     ,output v-attr-code).
    10561   if v-attr-code = "" then do:
    10562     return error.
    10563   end.
    10564   glog = yes.
    10565   CASE rs-list-method:
    10566     when "gds-obj-attr":U then do:
    10567       run gdsoattr-tooltip  in this-procedure( input v-attr-code,
    10568                            output vtooltip,
