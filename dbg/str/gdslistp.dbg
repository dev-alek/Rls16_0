     4383   run minbtn-set in this-procedure .
     4384   on choose of b-help in frame Dialog-Frame
     4385   do:
     4386     apply "help":u to frame Dialog-Frame .
     4387   end.
     4388   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4389   procedure minbtn-set :
     4390       do
     4391           on error undo, return error return-value
     4392           :
     4393           define variable ii              as integer       no-undo .
     4394           define variable fh              as widget-handle no-undo .
     4395           define variable hh              as widget-handle no-undo .
     4396           define variable v-h             as handle        extent 4 no-undo .
     4397           define variable v-name-button   as character     no-undo .
     4398           define variable v-help-old-x    as decimal       no-undo .
     4399           define variable v-help-old-y    as decimal       no-undo .
     4400           define variable v-help-old-size as decimal       no-undo .
     4401           define variable v-frame-width   as decimal       no-undo .
     4402           define variable jj              as integer       no-undo .
     4403           do
     4404               on error undo, return error
     4405               :
     4406               assign
     4407                   v-frame-width = frame Dialog-Frame:width - 0.3
     4408                   fh            = frame Dialog-Frame:first-child
     4409                   hh            = fh:first-child
     4410                   ii            = 1
     4411                   .
     4412               do while valid-handle(hh):
     4413                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4414                   do:
     4415                       case lc(hh:name) :
     4416                           when "b-help" then
     4417                               do:
     4418                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4419                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4420                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4421                                   hh:TOOLTIP = "Помощь" .
     4422                                   v-help-old-x = hh:column .
     4423                                   v-help-old-y = hh:row    .
     4424                                   v-help-old-size = hh:width .
     4425                                   hh:width-chars = 2.5 .
     4426                               end.
     4427                           when "b-print" then
     4428                               do:
     4429                                   hh:load-image("cmp/b-print.bmp":u) .
     4430                                   hh:TOOLTIP = "Печать" .
     4431                                   v-h[ii] = hh:handle .
     4432                                   ii = ii + 1 .
     4433                                   hh:width-chars = 3 .
     4434                               end.
     4435                           when "b-history" or
     4436                           when "b-hist" then
     4437                               do:
     4438                                   hh:load-image("cmp/b-hist.bmp":u) .
     4439                                   hh:TOOLTIP = "История" .
     4440                                   v-h[ii] = hh:handle .
     4441                                   ii = ii + 1 .
     4442                                   hh:width-chars = 3 .
     4443                               end.
     4444                           when "b-sch" then
     4445                               do:
     4446                                   hh:load-image("cmp/b-sch.bmp":u) .
     4447                                   hh:TOOLTIP = "Установка Фильтра" .
     4448                                   v-h[ii] = hh:handle .
     4449                                   ii = ii + 1 .
     4450                                   hh:width-chars = 3 .
     4451                               end.
     4452                           when "b-hist-user" then
     4453                               do:
     4454                                   hh:load-image("cmp/b-hist.bmp":u) .
     4455                                   hh:TOOLTIP = "История пользователя" .
     4456                                   ii = ii + 1 .
     4457                               end.
     4458                       end case.
     4459                   end.
     4460                   hh = hh:next-sibling.
     4461               end.
     4462               b-help:column = v-frame-width - b-help:width-chars.
     4463               jj = 0.
     4464               repeat ii = 4 to 1 by -1 :
     4465                   if valid-handle (v-h[ii] ) then
     4466                   do:
     4467                       jj  = jj + 1 .
     4468                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4469                       v-h[ii]:row    = v-help-old-y .
     4470                   end.
     4471               end.
     4472           end.
     4473       end.
     4474   end procedure.
     4475   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4476   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4477   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4478   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4479   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4480   define variable v-diasize-current-frame-height as decimal   no-undo .
     4481   define variable v-diasize-change-size          as logical   no-undo .
     4482   define variable v-diasize-resize-button        as handle    no-undo .
     4483   define variable v-diasize-wndmax               as logical   no-undo .
     4484   define variable v-diasize-wndstore             as logical   no-undo .
     4485   define variable v-diasize-proc-name            as character no-undo .
     4486   define variable v-diasize-browse-handle        as handle    no-undo .
     4487   define variable v-diasize-browse-number        as integer   no-undo .
     4488   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4489   define temp-table temp-diasize-handle no-undo
     4490     field handle-value  as handle
     4491     field save-position as decimal
     4492     index xpk is primary unique handle-value
     4493     .
     4494   define temp-table temp-browse-handle no-undo
     4495     field browse-type   as character
     4496     field browse-number as integer
     4497     field browse-handle as handle
     4498     field original-size as decimal
     4499     index xpk is primary unique browse-type browse-number
     4500     index xie browse-type browse-handle
     4501   .
     4502   procedure diasize_change-height :
     4503     define input  parameter p-change-value  as decimal   no-undo .
     4504     define input  parameter p-move-resize   as logical   no-undo .
     4505     define variable v-field-group-handle    as handle    no-undo .
     4506     define variable v-object-handle         as handle    no-undo .
     4507     define variable v-frame-height          as decimal   no-undo .
     4508     define variable v-frame-virtual-height  as decimal   no-undo .
     4509     define variable v-browse-height         as decimal   no-undo .
     4510     define variable v-window-height         as decimal   no-undo .
     4511     define variable v-window-virtual-height as decimal   no-undo .
     4512     define variable v-change-sign           as integer   no-undo .
     4513     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4514     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4515     if p-change-value > 0
     4516     then do:
     4517       if frame Dialog-Frame :height + p-change-value
     4518           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4519       then do:
     4520         assign
     4521           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4522                           - (frame Dialog-Frame :height-chars)
     4523         .
     4524         if p-change-value <= 0
     4525         then do:
     4526           run diasize_position-resize-button in this-procedure .
     4527           return .
     4528         end.
     4529       end.
     4530     end.
     4531     if p-change-value < 0
     4532     then do:
     4533       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4534       then do:
     4535         assign
     4536           p-change-value = v-diasize-orig-frame-height
     4537                          - (frame Dialog-Frame :height-chars)
     4538         .
     4539         if p-change-value >= 0
     4540         then do:
     4541           run diasize_position-resize-button in this-procedure .
     4542           return .
     4543         end.
     4544       end.
     4545     end.
     4546     if p-change-value >= 0
     4547     then do:
     4548       assign
     4549         v-change-sign = 1
     4550       .
     4551     end.
     4552     else do:
     4553       assign
     4554         v-change-sign = -1
     4555       .
     4556     end.
