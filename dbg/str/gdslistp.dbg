    10894   PROCEDURE trig-fbr :
    10895   define input parameter p-method as character no-undo .
    10896   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10897   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10898   DEFINE VARIABLE vlabel               as character           no-undo .
    10899   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10900   DEFINE VARIABLE v-fbr-list           as character           no-undo .
    10901   define variable v-grp-recid          as recid               no-undo .
    10902   define variable v-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo.
    10903   define variable glog as logical no-undo .
    10904   define variable v-item               as character           no-undo .
    10905   define variable v-fbr-obj-type       like ub.fbr-gds-obj.obj-type no-undo .
    10906   define variable v-fbr-obj-code       like ub.fbr-gds-obj.obj-code no-undo .
    10907   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10908   if p-method = "fbr-gds-obj-val" then do:
    10909     assign
    10910     v-attr-code = ""
    10911     vattr-codes = "is-cd,is-menu,is-null-price,is-modificator,is-season,is-semi-finished,fbr-grp-code,fbr-obj-code"
    10912     vattr-labels = "Отправлять на кассу РЕСТОРАНА,Является блюдом меню,Без цены,Модификатор блюда,Применять сезонный коэффициент," +
    10913                   "Является полуфабрикатом,Группа меню,Кухня"
    10914     vvalue = ""
    10915     .
    10916     run gbl/d-list.w ( input "b-sel":U
    10917                       ,input "Выберите атрибут"
    10918                       ,input vattr-codes
    10919                       ,input vattr-labels
    10920                       ,input chr(44)
    10921                       ,input "":U
    10922                       ,output v-attr-code).
    10923     if v-attr-code = "" then do:
    10924       return error.
    10925     end.
    10926     assign
    10927     vlabel =  entry(lookup(v-attr-code, vattr-codes) ,vattr-labels)
    10928     glog = yes.
    10929   end.
    10930   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10931   run userobjs_select-one in this-procedure
    10932     (input  parparentproc
    10933     ,input  v-cntxt-db-num
    10934     ,input  v-cntxt-userid
    10935     ,input  v-cntxt-host-code-obj
    10936     ,input  v-cntxt-obj-type
    10937     ,input  v-cntxt-obj-code
    10938     ,output v-user-select
    10939     ,output v-sel-obj-type
    10940     ,output v-sel-obj-code
    10941     )  .
    10942     if not v-user-select then do:
    10943       return error.
    10944     end.
    10945   if p-method = "fbr-gds-obj-val" then do:
    10946     CASE v-attr-code:
    10947       when "fbr-grp-code" then do:
    10948           run ref/fbrggrp.w (
    10949                   input ?
    10950                 ,input v-sel-obj-type
    10951                 ,input v-sel-obj-code
    10952                 ,input "b-sel"
    10953                 ,input-output v-grp-recid
    10954             ).
    10955         if v-grp-recid = ? then return error.
    10956         FIND FIRST buf_fbr-gds-grp no-lock where
    10957                 recid(buf_fbr-gds-grp) = v-grp-recid No-ERROR.
    10958         if not avail buf_fbr-gds-grp then return error.
    10959         assign
    10960         vvalue = string(buf_fbr-gds-grp.node-code)
    10961         vlabel = vlabel + " = ":U + buf_fbr-gds-grp.node-name
    10962         .
    10963       end.
    10964       when "fbr-obj-code" then do:
    10965         message
    10966         "Выберите объект-КУХНЮ для товара объекта" v-sel-obj-type v-sel-obj-code
    10967         view-as alert-box.
    10968   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10969   run userobjs_select-one in this-procedure
    10970     (input  parparentproc
    10971     ,input  v-cntxt-db-num
    10972     ,input  v-cntxt-userid
    10973     ,input  v-cntxt-host-code-obj
    10974     ,input  v-cntxt-obj-type
    10975     ,input  v-cntxt-obj-code
    10976     ,output v-user-select
    10977     ,output v-fbr-obj-type
    10978     ,output v-fbr-obj-code
    10979     )  .
    10980         assign
    10981         vvalue = string(v-fbr-obj-code)
    10982         .
    10983       end.
    10984       otherwise do:
    10985         assign
    10986         vvalue = "yes":U
    10987         .
    10988         run gbl/d-prompt.w (
    10989           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10990         + 'text1=':u + vlabel + '\':u
    10991         + 'format=yes/no' + '\':u
    10992         + 'type=logical' + '\':u
    10993         + 'fillin_row=2\':u
    10994         + 'fillin_col=4\':u
    10995         + 'fillin_width=20\':u
    10996         + 'fillin_height=1\':u
    10997         + 'max-chars=70\':u
    10998         + 'readonly=no\':u
    10999         , input-output vvalue
    11000         ).
    11001         if return-value = 'false':U then do:
    11002           return error.
    11003         end.
    11004       end.
    11005     END CASE.
    11006     assign
    11007     dsp-rs = substitute("Товары объекта &1&2 с атрибутом РЕСТОРАН &3 =&4&5&5"
    11008                          ,  v-sel-obj-type, v-sel-obj-code, vlabel, vvalue
    11009                          , chr(10)
    11010                          , stat-line(rs-status)
    11011                          )
    11012     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    11013     .
    11014   end.
    11015   else do:
    11016     assign
    11017     dsp-rs = substitute("Товары объекта &1&2, имеющие атрибут РЕСТОРАН&3&4"
    11018                        ,  v-sel-obj-type
    11019                         , v-sel-obj-code
    11020                          , chr(10)
    11021                          , stat-line(rs-status)
    11022                        )
    11023      v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3)
    11024      .
    11025   end.
    11026     message
    11027     dsp-rs skip
    11028     view-as alert-box question buttons OK-Cancel update glog.
    11029   if not glog then do:
    11030     return error.
    11031   end.
    11032   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11033                                       , input-output v-seq
    11034                                       , input 0
    11035                                       , input '':U
    11036                                       , input dsp-rs
    11037                                       , input tot-lns
    11038                                       , input rs-list-method
    11039                                       , input rs-status
    11040                                       , input v-item
    11041                                       , input '':U
    11042                                       , input ?
    11043                                       ).
    11044   END PROCEDURE.
    11045   PROCEDURE proc-scales-gds :
    11046   define input parameter rs-list-method as character no-undo .
    11047   define variable v-ref-list as character no-undo .
    11048   define variable v-rid-list as character no-undo .
    11049   define variable glog as logical no-undo .
    11050   define variable v-message as character no-undo .
    11051   define variable v-item as character no-undo .
    11052   define buffer buf_scales for ub.scales.
    11053   glog = yes.
    11054   CASE rs-list-method:
    11055     when "scales-gds":U then do:
    11056       assign
    11057       v-message = substitute("Все товары на весах на объекте&1&2", chr(10), stat-line(rs-status))
    11058       .
    11059     end.
    11060     when "scales-gds-num":U then do:
    11061       assign
    11062       v-message = substitute("Товары на одних весах на объекте &1&2", chr(10), stat-line(rs-status))
    11063       .
    11064     end.
    11065   END CASE.
    11066   message
    11067   v-message
    11068   view-as alert-box question buttons OK-Cancel update glog.
    11069   if not glog then do:
    11070     return error.
    11071   end.
    11072   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11073   run userobjs_select-one in this-procedure
    11074     (input  parparentproc
    11075     ,input  v-cntxt-db-num
    11076     ,input  v-cntxt-userid
    11077     ,input  v-cntxt-host-code-obj
    11078     ,input  v-cntxt-obj-type
    11079     ,input  v-cntxt-obj-code
    11080     ,output v-user-select
    11081     ,output v-sel-obj-type
    11082     ,output v-sel-obj-code
    11083     )  .
    11084   if not v-user-select then do:
    11085     return error.
    11086   end.
    11087   if rs-list-method = "scales-gds-num" then do:
    11088     run ref/scales.w ( input parparentproc
    11089                       ,input v-sel-obj-type
    11090                       ,input v-sel-obj-code
    11091                       ,input "b-sel"
    11092                       ,input 'db':U
    11093                       ,output v-rid-list).
    11094     if v-rid-list = '':U then do:
    11095       return error.
    11096     end.
    11097     find first buf_scales no-lock where
    11098               recid(buf_scales) = integer(v-rid-list).
    11099   end.
    11100   CASE rs-list-method:
    11101     when "scales-gds":U then do:
    11102       assign
    11103       dsp-rs = substitute("ВСЕ товары на весах на объекте &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11104       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11105       .
    11106     end.
    11107     when "scales-gds-num":U then do:
    11108       assign
    11109       dsp-rs = substitute("Товары на весах &1 на объекте &2&3 &4", buf_scales.scales-num, v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11110       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(buf_scales.scales-num)
    11111       .
    11112     end.
    11113   END CASE.
    11114   v-no-hist = 0.
    11115   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11116                                       , input-output v-seq
    11117                                       , input 0
    11118                                       , input '':U
    11119                                       , input dsp-rs
    11120                                       , input tot-lns
    11121                                       , input rs-list-method
    11122                                       , input rs-status
    11123                                       , input v-item
    11124                                       , input '':U
    11125                                       , input ?
    11126                                       ).
    11127   END PROCEDURE.
    11128   PROCEDURE proc-parts-last-date :
    11129   define input parameter rs-list-method as character no-undo .
    11130   define variable v-value-integer as integer   no-undo .
    11131   define variable glog as logical no-undo .
    11132   define variable v-message as character no-undo .
    11133   define variable v-item as character no-undo .
    11134   glog = yes.
    11135   CASE rs-list-method:
    11136     when "parts-last-date":U then do:
    11137       assign
    11138       v-message = substitute("Партии свободной зоны на &1&2 с истекающим сроком хранения", chr(10), stat-line(rs-status))
    11139       .
    11140     end.
    11141   END CASE.
    11142   message
    11143   v-message
    11144   view-as alert-box question buttons OK-Cancel update glog.
    11145   if not glog then do:
    11146     return error.
    11147   end.
    11148   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11149   run userobjs_select-one in this-procedure
    11150     (input  parparentproc
    11151     ,input  v-cntxt-db-num
    11152     ,input  v-cntxt-userid
    11153     ,input  v-cntxt-host-code-obj
    11154     ,input  v-cntxt-obj-type
    11155     ,input  v-cntxt-obj-code
    11156     ,output v-user-select
    11157     ,output v-sel-obj-type
    11158     ,output v-sel-obj-code
    11159     )  .
    11160   if not v-user-select then do:
    11161     return error.
    11162   end.
    11163   run gbl/d-integer.w (
    11164           input ?
    11165         ,input (
    11166         'title=':u + substitute("Введите кол-во дней в течение которых истекает срок хранения") + '\':u
    11167       + 'text1=':u + "Кол-во дней" + '\':u
    11168       + 'format=' + ">>9" + '\':u
    11169       + 'fillin_row=3\':u
    11170       + 'fillin_col=4\':u
    11171       + 'fillin_width=20\':u
    11172       + 'fillin_height=1\':u
    11173       + 'max-chars=70\':u
    11174       + 'readonly=' +  'no':u + '\':u)
    11175       , input-output v-value-integer
    11176       , output v-ok
    11177           ).
    11178   if not v-ok then return error.
    11179   CASE rs-list-method:
    11180     when "parts-last-date":U then do:
    11181       assign
    11182       dsp-rs = substitute("Партии свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    11183       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    11184       .
    11185     end.
    11186   END CASE.
    11187   v-no-hist = 0.
    11188   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11189                                       , input-output v-seq
    11190                                       , input 0
    11191                                       , input '':U
    11192                                       , input dsp-rs
    11193                                       , input tot-lns
    11194                                       , input rs-list-method
    11195                                       , input rs-status
    11196                                       , input v-item
    11197                                       , input '':U
    11198                                       , input ?
    11199                                       ).
    11200   END PROCEDURE.
    11201   PROCEDURE proc-parts-fib :
    11202   define input parameter rs-list-method as character no-undo .
    11203   define variable v-value-integer as integer   no-undo .
    11204   define variable glog as logical no-undo .
    11205   define variable v-message as character no-undo .
    11206   define variable v-item as character no-undo .
    11207   glog = yes.
