     4209   ON CHOOSE OF b-hist IN FRAME Dialog-Frame DO:
     4210   define buffer buf_gds-list-hist for gds-list-hist.
     4211   run prn-lib-open-stream  in this-procedure (
     4212                                                input parParentProc
     4213                                               ,input 43
     4214                                               ,input yes
     4215                                               ,input no
     4216                                               ).
     4217   find first buf_gds-list-hist no-lock where buf_gds-list-hist.id = 0 no-error .
     4218   PUT  STREAM PrnLibStream unformatted
     4219   SPACE(25) "История создания списка товаров "
     4220   (if available buf_gds-list-hist
     4221   then buf_gds-list-hist.des
     4222   else "БЕЗЫМЯННЫЙ") skip(0)
     4223   space(25) cur-time-print() skip(1)
     4224   .
     4225   put stream PrnLibStream unformatted
     4226   string("№", "X(9)") chr(32)
     4227   string("Действие", "X(9)") chr(32)
     4228   string("записей", "X(9)") chr(32)
     4229   string(" = итого", "X(12)") chr(32)
     4230   string("Множество", "X(155)")
     4231   skip(0)
     4232   fill('-':U, 9) chr(32)
     4233   fill('-':U, 9) chr(32)
     4234   fill('-':U, 9) chr(32)
     4235   fill('-':U, 12) chr(32)
     4236   fill('-':U, 155)
     4237   skip(0)
     4238   .
     4239   for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     4240   by buf_gds-list-hist.id
     4241   :
     4242     put stream PrnLibStream unformatted
     4243     (if buf_gds-list-hist.line = 0
     4244      then string(buf_gds-list-hist.id, ">>>>>>>>9")
     4245      else fill(chr(32) , 9)
     4246     )  chr(32)
     4247     (if buf_gds-list-hist.item_ <> '':U
     4248      then string(buf_gds-list-hist.hist-mode, "X(8)")
     4249      else fill( chr(32), 8)) chr(32)
     4250     string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4251     string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4252     string(buf_gds-list-hist.des, "X(155)") skip.
     4253   end.
     4254   output stream prnlibstream close.
     4255     run prn-lib-prn-file in this-procedure (
     4256                                               input parParentProc
     4257                                               ,input 8
     4258                                               ).
