     6677         p-curr-obj-code = buf_clients.obj-code
     6678         p-curr-host-code = buf_clients.host-code
     6679         v-no-obj = yes
     6680         .
     6681       end.
     6682       else do:
     6683         message
     6684         "Текущий объект не может быть установлен" skip
     6685         view-as alert-box error .
     6686         undo, return error.
     6687       end.
     6688     end.
     6689     if not (p-curr-obj-type = '':U
     6690             and
     6691             p-curr-obj-code = 0) then do:
     6692       find first buf_clients no-lock
