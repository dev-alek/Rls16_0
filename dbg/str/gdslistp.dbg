      234   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   FUNCTION get-region RETURNS CHARACTER
      236     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      237     define variable par-region as character no-undo.
      238     if parhost-code = 0 and
      239          parobj-type = "":U and
      240          parobj-code = 0 then do:
      241          par-region = "Глобально".
      242          return par-region.
      243       end.
      244       if parobj-type = 'орг':U then do:
      245          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      246          return par-region.
      247       end.
      248       if parobj-type = 'регион':U
      249       then do:
      250          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      251          return par-region.
      252       end.
      253       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      254       return par-region.
      255   END FUNCTION.
      256   FUNCTION get-objregion RETURNS CHARACTER
      257     (  input parobj-type as character, input parobj-code as integer ) :
      258     define variable par-region as character no-undo.
      259     if  parobj-type = "":U and
      260         parobj-code = 0
      261     then do:
      262        par-region = "Глобально".
      263     end.
      264     else if parobj-type = 'орг':U
      265     then do:
      266        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      267     end.
      268     else if parobj-type = 'регион':U
      269     then do:
      270        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      271     end.
      272     else
      273        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      274     return par-region.
      275   END FUNCTION.
