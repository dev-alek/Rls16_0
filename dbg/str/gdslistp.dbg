    10622           .
    10623         end.
    10624       end.
    10625   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10626   run userobjs_select-one in this-procedure
    10627     (input  parparentproc
