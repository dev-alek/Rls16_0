     7118       end.
     7119     end.
     7120     when "grp-prod"
     7121     or
     7122     when "grp-supp"
     7123     then do:
     7124       for each buf_gds-list-hist where
     7125                buf_gds-list-hist.id = p-id
     7126           and  buf_gds-list-hist.item_  <> '':U:
     7127         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7128         find ub.cli-grp where rowid (ub.cli-grp) = v-rowid no-lock.
     7129         grp-path = "".
