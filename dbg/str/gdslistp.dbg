     8175                      , output lns-cnt
     8176                      , output line-rec
     8177                      ) .
     8178        assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8179     end.
     8180       when "no-recipe-gds":U then do:
     8181        for each buf_gds-list-hist where
     8182                buf_gds-list-hist.id = p-id
     8183           and  buf_gds-list-hist.item_ <> '':U:
     8184         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8185         grp-path = "".
     8186         find first gds-grp no-lock where rowid(gds-grp) = v-rowid.
     8187         run grplib-get-full-name in this-procedure (gds-grp.node-code, output grp-path).
     8188         goods:
     8189         for each goods where goods.grp-name begins grp-path no-lock,
     8190             each recipe no-lock where recipe.artic = ub.goods.artic
     8191                           and recipe.prod-type = ub.goods.prod-type
     8192                           and recipe.prod-code = ub.goods.prod-code :
     8193             for each recipe-gds where recipe-gds.recipe-code = recipe.recipe-code no-lock:
     8194             if can-find(first gds-obj no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8195                                     and gds-obj.obj-code = v-cntxt-obj-code
     8196                                     and gds-obj.gds-code = recipe-gds.gds-code
     8197                                     and gds-obj.fact-qnty > 0) then.
     8198             else do:
     8199                   run ex-gds  in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8200                   next goods.
     8201               end.
     8202             end.
     8203         end.
     8204         assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8205        end.
     8206     end.
     8207     when "move-date":U then do:
     8208         find first buf_gds-list-hist where
     8209             buf_gds-list-hist.id = p-id
     8210         AND buf_gds-list-hist.item_ <> '':U .
     8211         for each gds-obj  no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8212                                     and gds-obj.obj-code = v-cntxt-obj-code
     8213                                     and gds-obj.last-doc >= date(buf_gds-list-hist.item_):
     8214             for first goods no-lock where
     8215                   goods.artic = ub.gds-obj.artic
     8216               and goods.prod-type = ub.gds-obj.prod-type
     8217               and goods.prod-code = ub.gds-obj.prod-code:
     8218               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8219               assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8220             end.
     8221         end.
     8222     end.
     8223   end.
     8224   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8225   if session:set-wait-state( "" )  then .
     8226   case line-mode :
     8227     when 'ДОБАВЛЕНИЕ':U then do:
     8228       tot-lns = tot-lns + lns-cnt.
     8229       if not p-from-macro or p-step then
     8230       message
     8231       "Добавлено строк :" lns-cnt skip(0)
     8232       string(if lns-ignore <> 0
     8233       then ("Проигнорировано строк :" + string(lns-ignore))
     8234       else "":U)
     8235       .
     8236     end.
     8237     when 'удаление':U then do:
     8238       tot-lns = tot-lns - lns-cnt.
     8239       if not p-from-macro or p-step then
     8240       message
     8241       "Удалено строк :" lns-cnt skip(0)
     8242       string(if lns-ignore <> 0
     8243       then ("Проигнорировано строк :" + string(lns-ignore))
     8244       else "":U)
     8245       .
     8246     end.
     8247   end.
     8248   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on in this-procedure.
     8249   end.
     8250   END PROCEDURE.
     8251   PROCEDURE write-hist :
     8252   define input parameter p-from-macro as logical no-undo .
     8253   define input parameter rs-list-method as character no-undo .
     8254   define input parameter rs-status as character no-undo .
     8255   define input parameter line-mode as character no-undo .
     8256   define variable v-ii as integer no-undo .
     8257   define variable v-temp-seq as integer no-undo .
     8258   if rs-list-method = "single" then do:
     8259     if v-no-hist < 0 then do:
     8260       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8261                                           , input-output v-seq
     8262                                           , input 0
     8263                                           , input get-hist-mode(line-mode)
     8264                                           , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8265                                           , input tot-lns
     8266                                           , input rs-list-method
     8267                                           , input rs-status
     8268                                           , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8269                                           , input '':U
     8270                                           , input ?
     8271                                           ).
     8272     end.
     8273     else do:
     8274       v-temp-seq = v-seq - 1.
     8275       do v-ii = 0 to v-no-hist:
     8276         run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8277                                             , input-output v-temp-seq
     8278                                             , input v-ii
     8279                                             , input get-hist-mode(line-mode)
     8280                                             , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8281                                             , input tot-lns
     8282                                             , input '':U
     8283                                             , input '':U
     8284                                             , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8285                                             , input '':U
     8286                                             , input ?
     8287                                             ).
     8288       end.
     8289     end.
     8290   end.
     8291   else do:
     8292     v-temp-seq = v-seq - 1.
     8293     do v-ii = 0 to v-no-hist:
     8294       run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8295                                           , input-output  v-temp-seq
     8296                                           , input v-ii
     8297                                           , input get-hist-mode(line-mode)
     8298                                           , input '':U
     8299                                           , input tot-lns
     8300                                           , input rs-list-method
     8301                                           , input '':U
     8302                                           , input '':U
     8303                                           , input '':U
     8304                                           , input ?
     8305                                           ).
     8306     end.
     8307   end.
     8308   END PROCEDURE.
     8309   procedure list_inf-local:
     8310   define variable glog as logical no-undo .
     8311   for each tt-goods:
     8312     delete tt-goods.
     8313   end.
     8314   for each tt-clients:
     8315     delete tt-clients.
     8316   end.
     8317   for each gds-list:
     8318   find ub.goods where ub.goods.artic     = gds-list.artic     and
     8319                   ub.goods.prod-type = gds-list.prod-type and
     8320                   ub.goods.prod-code = gds-list.prod-code no-lock.
     8321       create tt-goods.
     8322       buffer-copy ub.goods to tt-goods.
     8323   end.
     8324   create tt-clients.
     8325   assign tt-clients.obj-type = p-curr-obj-type
     8326         tt-clients.obj-code = p-curr-obj-code.
     8327   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8328   do:
     8329     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8330       (input  v-cntxt-db-num
     8331       ,input  v-cntxt-userid
     8332       ,input  0
     8333       ,input  'actn_reference_archive':U
     8334       ,input  'global':U
     8335       ,input  0
     8336       ,input  '':U
     8337       ,input  0
     8338       ,input  0
     8339       ,input  0
     8340       ,input  0
     8341       ,input  true
     8342       ,output glog
     8343       )  .
     8344   end.
     8345   if glog then run arc/gds_inf.w
     8346   (input  parparentproc
     8347   ,input  v-cntxt-obj-type
     8348   ,input  v-cntxt-obj-code ).
     8349   end procedure.
     8350   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8351   DEFINE VARIABLE var-stat-line as character no-undo .
     8352   CASE p-status-chr:
     8353     when 'все':U then do:
     8354       assign
     8355       var-stat-line = "(текущие и неактивные товары)"
     8356       .
     8357     end.
     8358     when 'текущие':U then do:
     8359       assign
     8360       var-stat-line = "(текущие товары)"
     8361       .
     8362     end.
     8363     when 'удаленные':U then do:
     8364       assign
     8365       var-stat-line = "(неактивные товары)"
     8366       .
     8367     end.
     8368   END CASE.
     8369   return var-stat-line .
     8370   END.
     8371   procedure proc-vc-rs-list-method :
     8372   define variable v-operation as integer no-undo .
     8373   define variable glog as logical no-undo .
     8374   define variable ii as integer no-undo .
     8375   define variable v-recs as integer no-undo .
     8376   define variable v-line as integer no-undo .
     8377   define variable v-item as character no-undo .
     8378   define variable v-tbl-name as character no-undo .
     8379   define variable v-bh as handle no-undo .
     8380   define variable v-tot-lns as integer no-undo .
     8381   define variable v-grp-rec as recid no-undo .
     8382   define variable v-ref-rec as recid no-undo .
     8383   define variable v-dopstr as character no-undo .
     8384   define variable v-input-output as character no-undo .
     8385   define variable v-doc-rec as recid no-undo .
     8386   define variable v-temp-seq as integer no-undo .
     8387   define variable v-message as character no-undo .
     8388   define variable grp-path as character no-undo .
     8389   define variable v-rid-list as character no-undo .
     8390   define variable v-uniq-key-rec as character no-undo .
     8391   define buffer buf_gds-list-hist for gds-list-hist.
     8392   define buffer buf_clob-bind for ub.clob-bind.
     8393   do
     8394   on error undo, return error
     8395   :
     8396     v-no-hist = - 1.
     8397     if temp-list.fvalue = "single" then
     8398     run UI-on in this-procedure.
     8399     else do:
     8400       v-no-hist = 0.
     8401       case rs-list-method:
     8402         when "all" then do:
     8403           glog = yes.
     8404           message "Все товары из справочника товаров"
     8405           skip stat-line(rs-status)
     8406           view-as alert-box question buttons OK-Cancel update glog.
     8407           if not glog then do:
     8408             run UI-on in this-procedure.
     8409             return error .
     8410           end.
     8411           v-no-hist = 1.
     8412           run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8413                                               , input-output v-seq
     8414                                               , input 0
     8415                                               , input '':U
     8416                                               , input substitute('Все товары &1', stat-line(rs-status))
     8417                                               , input tot-lns
     8418                                               , input rs-list-method
     8419                                               , input rs-status
     8420                                               , input 'all':U
     8421                                               , input '':U
     8422                                               , input ?
     8423                                               ).
     8424         end.
     8425         when "gds-grp" or
     8426         when "goods" or
     8427         when "gds-obj":U or
     8428         when "gds-obj-fact":U or
     8429         when "gds-obj-free":U or
     8430         when "no-recipe-gds":U
     8431         then do:
     8432           if rs-list-method = "gds-grp" or rs-list-method = "no-recipe-gds" then do:
     8433             glog = yes.
     8434             message "1 или несколько групп товаров"
     8435             skip stat-line(rs-status)
     8436             view-as alert-box question buttons OK-Cancel update glog.
     8437             if not glog then do:
     8438               run UI-on in this-procedure.
     8439               return error.
     8440             end.
     8441             grp-list = "".
     8442             ref-list = "".
     8443             run ref/gds-grp.w (input parparentproc
     8444                           ,input "b-sel,b-mark"
     8445                           ,input p-curr-obj-type
     8446                           ,input p-curr-obj-code
     8447                           ,input-output grp-list).
     8448           end.
     8449           else do:
     8450             glog = yes.
     8451             message "1 или несколько произвольных товаров из справочника."
     8452             skip stat-line(rs-status)
     8453             view-as alert-box question buttons OK-Cancel update glog.
     8454             if not glog then do:
     8455               run UI-on in this-procedure.
     8456               return error.
     8457             end.
     8458             run ref/gds-ref.p ( parparentproc
     8459                             ,"b-sel,b-mark,b-add"
     8460                             ,?
     8461                             ,?
     8462                             ,(if rs-list-method = "goods"
     8463                               then 'все':U
     8464                               else (if rs-list-method = "gds-obj":U
     8465                                     then 'объект':U
     8466                                     else (if rs-list-method = "gds-obj-fact":U
     8467                                           then 'факт':U
     8468                                           else (if rs-list-method = "gds-obj-free":U
     8469                                                 then 'свободно':U
     8470                                                 else ?
     8471                                                 )
     8472                                           )
     8473                                     )
     8474                             )
     8475                             ,?
     8476                             ,?
     8477                             ,?
     8478                             ,?
     8479                             ,p-curr-obj-type
     8480                             ,p-curr-obj-code
     8481                             ,?
     8482                             , output ref-list).
     8483             grp-list = ?.
     8484           end.
     8485           if grp-list <> ? and
     8486           grp-list <> "" then do:
     8487             v-recs = num-entries (grp-list).
     8488             do num-rec = 0 to v-recs:
     8489               if v-recs = 1 then do:
     8490                 num-rec = 1 .
     8491               end.
     8492               if num-rec > 0 then do:
     8493                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8494                 find ub.gds-grp where recid (ub.gds-grp) = v-grp-rec no-lock.
     8495                 run grplib-get-full-name in this-procedure (ub.gds-grp.node-code, output grp-path).
     8496               end.
     8497               if v-recs = 1 then do:
     8498                 assign
     8499                 v-temp-seq = v-seq
     8500                 v-line     = 0
     8501                 dsp-rs = substitute("Группа : &1 &3", grp-path, stat-line(rs-status))
     8502                 v-item     = '':U
     8503                 v-tbl-name = 'gds-grp':U
     8504                 v-bh       = buffer ub.gds-grp:handle
     8505                 v-tot-lns = tot-lns
     8506                 .
     8507               end.
     8508               else do:
     8509                 if num-rec = 0 then do:
     8510                   assign
     8511                   v-temp-seq = v-seq
     8512                   v-line     = 0
     8513                   dsp-rs = substitute("Группы : &1", stat-line(rs-status))
     8514                   v-item     = '':U
     8515                   v-tbl-name = '':U
     8516                   v-bh       = ?
     8517                   v-tot-lns = tot-lns
     8518                   .
     8519                 end.
     8520                 else do:
     8521                   assign
     8522                   v-temp-seq = v-seq - 1
     8523                   v-line     = num-rec
     8524                   dsp-rs = substitute("&1", grp-path)
     8525                   v-item     = '':U
     8526                   v-tbl-name = 'gds-grp':U
     8527                   v-bh       = buffer ub.gds-grp:handle
     8528                   v-tot-lns = tot-lns + num-rec
     8529                   .
     8530                 end.
     8531               end.
     8532               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8533               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8534                                                   , input-output v-temp-seq
     8535                                                   , input v-line
     8536                                                   , input '':U
     8537                                                   , input dsp-rs
     8538                                                   , input v-tot-lns
     8539                                                   , input rs-list-method
     8540                                                   , input rs-status
     8541                                                   , input v-item
     8542                                                   , input v-tbl-name
     8543                                                   , input v-bh
     8544                                                   ).
     8545               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8546             end.
     8547           end.
     8548           else if ref-list <> "" then do:
     8549             v-recs = num-entries (ref-list).
     8550             do num-rec = 0 to v-recs:
     8551               if v-recs = 1 then do:
     8552                 num-rec = 1 .
     8553               end.
     8554               if num-rec > 0 then do:
     8555                 v-ref-rec = integer (entry (num-rec, ref-list)).
     8556                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8557               end.
     8558               if v-recs = 1 then do:
     8559                 assign
     8560                 v-temp-seq = v-seq
     8561                 v-line     = 0
     8562                 dsp-rs = substitute("Товар :&1 &2", ub.goods.gds-name, stat-line(rs-status))
     8563                 v-item     = '':U
     8564                 v-tbl-name = 'goods':U
     8565                 v-bh       = buffer goods:handle
     8566                 v-tot-lns = tot-lns
     8567                 .
     8568               end.
     8569               else do:
     8570                 if num-rec = 0 then do:
     8571                   assign
     8572                   v-temp-seq = v-seq
     8573                   v-line     = 0
     8574                   dsp-rs = substitute("Товары : &1", stat-line(rs-status))
     8575                   v-item     = '':U
     8576                   v-tbl-name = '':U
     8577                   v-bh       = ?
     8578                   v-tot-lns = tot-lns
     8579                   .
     8580                 end.
     8581                 else do:
     8582                   assign
     8583                   v-temp-seq = v-seq - 1
     8584                   v-line     = num-rec
     8585                   dsp-rs = substitute("код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     8586                   v-item     = '':U
     8587                   v-tbl-name = 'goods':U
     8588                   v-bh       = buffer ub.goods:handle
     8589                   v-tot-lns = tot-lns + num-rec
     8590                   .
     8591                 end.
     8592               end.
     8593               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8594               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8595                                                   , input-output v-temp-seq
     8596                                                   , input v-line
     8597                                                   , input '':U
     8598                                                   , input dsp-rs
     8599                                                   , input v-tot-lns
     8600                                                   , input rs-list-method
     8601                                                   , input rs-status
     8602                                                   , input v-item
     8603                                                   , input v-tbl-name
     8604                                                   , input v-bh
     8605                                                   ).
     8606               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8607             end.
     8608           end.
     8609           else do:
     8610             run UI-on in this-procedure.
     8611             return error.
     8612           end.
     8613         end.
     8614         when "grp-prod" or
     8615         when "producer" then do:
     8616           if rs-list-method = "grp-prod" then do:
     8617             glog = yes.
     8618             message "товары по производителям из 1 или нескольких групп."
     8619             skip stat-line(rs-status)
     8620             view-as alert-box question buttons OK-Cancel update glog.
     8621             if not glog then do:
     8622               run UI-on in this-procedure.
     8623               return error.
     8624             end.
     8625             grp-list = "".
     8626             ref-list = "".
     8627             run ref/cli-grps.w ( input parparentproc
     8628                                 ,input "b-sel,b-mark"
     8629                                 ,input-output grp-list).
     8630           end.
     8631           else do:
     8632             glog = yes.
     8633             message "товары по 1 или нескольким производителям из справочника."
     8634             skip stat-line(rs-status)
     8635             view-as alert-box question buttons OK-Cancel update glog.
     8636             if not glog then do:
     8637               run UI-on in this-procedure.
     8638               return error.
