    10650                 .
    10651             end.
    10652       end.
    10653       CASE vtype:
    10654         when 'L':U then do:
    10655           assign
    10656           vvalue = "yes":U
    10657           .
    10658         end.
    10659         when 'I':U or when 'D':U then do:
    10660           assign
    10661           vvalue = if v-init <> "":U
    10662                         then vvalue
    10663                         else string(0)
    10664           .
    10665         end.
    10666         when 'T':U then do:
    10667           assign
