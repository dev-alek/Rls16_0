        1   block-level on error undo, throw.
        2   define input-output parameter p-rec as recid no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: chksplit.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/chksplit.p $":U .
        8   define variable vss-description as character no-undo init "Утилита деления чеков на товары и услуги".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   DEFINE VARIABLE v-office as logical no-undo .
       70   DEFINE VARIABLE v-sum-goods like ub.chk-doc.tot-doc .
       71   DEFINE VARIABLE v-sum-office like ub.chk-doc.tot-doc .
       72   DEFINE VARIABLE v-discnt-goods like ub.chk-doc.discnt .
       73   DEFINE VARIABLE v-discnt-office like ub.chk-doc.discnt .
       74   DEFINE VARIABLE v-netto-goods like ub.chk-doc.netto .
       75   DEFINE VARIABLE v-netto-office like ub.chk-doc.netto .
       76   DEFINE VARIABLE v-write-off-goods like ub.chk-doc.netto .
       77   DEFINE VARIABLE v-write-off-office like ub.chk-doc.netto .
       78   DEFINE VARIABLE v-is-office as logical no-undo .
       79   DEFINE VARIABLE v-ratio-goods-sum as decimal no-undo .
       80   DEFINE VARIABLE v-ratio-office-sum as decimal no-undo .
       81   DEFINE VARIABLE v-ratio-goods-netto as decimal no-undo .
       82   DEFINE VARIABLE v-ratio-office-netto as decimal no-undo .
       83   DEFINE VARIABLE v-ratio-goods-discnt as decimal no-undo .
       84   DEFINE VARIABLE v-ratio-office-discnt as decimal no-undo .
       85   DEFINE VARIABLE v-ratio-goods-bonus as decimal no-undo .
       86   DEFINE VARIABLE v-ratio-office-bonus as decimal no-undo .
       87   DEFINE VARIABLE v-object-sum as decimal no-undo .
       88   DEFINE VARIABLE v-object-sum-bonus as decimal no-undo .
       89   DEFINE VARIABLE v-object-sum-goods as decimal no-undo .
       90   DEFINE VARIABLE v-object-sum-office as decimal no-undo .
       91   DEFINE VARIABLE v-object-sum-goods-bonus as decimal no-undo .
       92   DEFINE VARIABLE v-object-sum-office-bonus as decimal no-undo .
       93   DEFINE VARIABLE v-tot-doc-annu as decimal no-undo .
       94   DEFINE VARIABLE v-netto-annu as decimal no-undo .
       95   DEFINE VARIABLE current-line-num like ub.chk-discnt.line-num no-undo .
       96   DEFINE VARIABLE current-line-num-bonus like ub.chk-discnt.line-num no-undo .
       97   DEFINE VARIABLE num-pay as integer no-undo .
       98   define variable v-curr-r-b as character no-undo .
       99   define variable v-is-annu as logical no-undo .
      100   define buffer buf_chk-doc for ub.chk-doc.
      101   define buffer buf1_chk-doc for ub.chk-doc.
      102   define buffer buf2_chk-doc for ub.chk-doc.
      103   define buffer buf_chk-gds for ub.chk-gds.
      104   define buffer buf1_chk-gds for ub.chk-gds.
      105   define buffer buf2_chk-gds for ub.chk-gds.
      106   define buffer buf_chk-pay for ub.chk-pay.
      107   define buffer buf1_chk-pay for ub.chk-pay.
      108   define buffer buf2_chk-pay for ub.chk-pay.
      109   define buffer buf_chk-discnt for ub.chk-discnt.
      110   define buffer buf1_chk-discnt for ub.chk-discnt.
      111   define buffer buf2_chk-discnt for ub.chk-discnt.
      112   define buffer buf_bar-code for ub.bar-code.
      113   define buffer buf_goods for ub.goods.
      114   define temp-table temp-goods no-undo
      115     field line-num like ub.chk-gds.line-num
      116     field object-sum like ub.chk-discnt.object-sum
      117     index pi is unique primary
      118     line-num.
      119   define temp-table temp-office no-undo
      120     field line-num like ub.chk-gds.line-num
      121     field object-sum like ub.chk-discnt.object-sum
      122     index pi is unique primary
      123     line-num.
      124   _main:
      125   do
      126   on error undo, return error
      127   :
      128     find first buf_chk-doc exclusive-lock where
      129               recid(buf_chk-doc) = p-rec no-error .
      130     if not avail buf_chk-doc then do:
      131       undo, return error substitute("не найден чек: recid &1"
      132                                     ,p-rec
      133                                     ).
      134     end.
      135     if buf_chk-doc.out-code <> ? then do:
      136       undo, return error substitute("чек &1 привязан к продаже", buf_chk-doc.doc-code).
      137     end.
      138     if buf_Chk-doc.chk-type = integer('8':U) then do:
      139       assign
      140       v-is-annu = yes.
      141     end.
      142     if buf_chk-doc.office = 'т':U
      143     or buf_chk-doc.office = 'у':U then return.
      144     if not trim(trim(trim(trim(buf_chk-doc.office, 'т':U), 'у':U), chr(44))) = '':U
      145     or not(lookup('т':U, buf_chk-doc.office) > 0
      146       and lookup('у':U, buf_chk-doc.office) > 0 )
      147     then do:
      148       return substitute("чек &1 не может быть разбит на товары и услуги&2имеются ошибки в чеке&3"
      149                                      ,buf_chk-doc.doc-code
      150                                      ,chr(10)
      151                                      ,buf_chk-doc.office).
      152     end.
      153   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      155     (output v-curr-r-b
      156     )  .
      157     create buf1_chk-doc.
      158     buffer-copy buf_chk-doc except doc-code to buf1_chk-doc
      159     assign
      160     buf1_chk-doc.doc-code = buf_chk-doc.doc-code + "-":U + 'т':U
      161     buf1_chk-doc.PS = buf1_chk-doc.ps + "@":U + "split":U
      162     .
      163     assign
      164     p-rec = recid(buf1_chk-doc)
      165     .
      166     create buf2_chk-doc.
      167     buffer-copy buf_chk-doc except doc-code to buf2_chk-doc
      168     assign
      169     buf2_chk-doc.doc-code = buf_chk-doc.doc-code + "-":U + 'у':U
      170     buf2_chk-doc.PS = buf2_chk-doc.ps + "@":U + "split":U
      171     .
      172     for each buf_chk-gds where
      173               buf_chk-gds.doc-code = buf_chk-doc.doc-code:
      174       find first buf_bar-code no-lock where
      175                  buf_bar-code.b-code = buf_chk-gds.b-code no-error .
      176       if not available buf_bar-code then do:
      177         undo _main, return error substitute("не найден бар-код &1:&2чек &3 строка &4"
      178                                            , buf_chk-gds.b-code
      179                                            , chr(10)
      180                                            , buf_chk-doc.doc-code
      181                                            , buf_chk-gds.line-num)
      182                                            .
      183       end.
      184       find first buf_goods no-lock where
      185                  buf_goods.gds-code = buf_bar-code.gds-code no-error .
      186       if not available buf_goods then do:
      187         undo _main, return error substitute("не найден товар для бар-кода &1:&2чек &3 строка &4"
      188                                            , buf_chk-gds.b-code
      189                                            , chr(10)
      190                                            , buf_chk-doc.doc-code
      191                                            , buf_chk-gds.line-num)
      192                                            .
      193       end.
      194       assign
      195       v-office = trim(buf_chk-gds.line-type, chr(44)) begins 'у':U
      196       .
      197       case v-office:
      198         when no then do:
      199           if v-is-annu then do:
      200             assign
      201             v-tot-doc-annu = v-tot-doc-annu + buf_chk-gds.src-price * buf_chk-gds.src-qnty
      202             v-sum-goods = v-sum-goods + buf_chk-gds.src-price * buf_chk-gds.src-qnty
      203             v-discnt-goods = v-discnt-goods + buf_chk-gds.src-discnt * buf_chk-gds.src-qnty
      204             v-netto-goods = v-netto-goods + (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty
      205             v-netto-annu = v-netto-annu + (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty
      206             v-write-off-goods = v-write-off-goods + (if buf_chk-gds.write-off-code <> 0
      207                                                     and buf_chk-gds.write-off-code <> ?
      208                                                     then ((if buf_chk-gds.write-off-code > 0 then 1 else - 1) *
      209                                                             buf_chk-gds.src-qnty * (buf_chk-gds.src-price - buf_chk-gds.src-discnt)
      210                                                           )
      211                                                     else 0)
      212             .
      213           end.
      214           else do:
      215             assign
      216             v-sum-goods = v-sum-goods + buf_chk-gds.price-base * buf_chk-gds.doc-qnty
      217             v-discnt-goods = v-discnt-goods + buf_chk-gds.discnt * buf_chk-gds.doc-qnty
      218             v-netto-goods = v-netto-goods + (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty
      219             v-netto-annu = v-netto-annu + (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty
      220             v-write-off-goods = v-write-off-goods + (if buf_chk-gds.write-off-code <> 0
      221                                                     and buf_chk-gds.write-off-code <> ?
      222                                                     then ((if buf_chk-gds.write-off-code > 0 then 1 else - 1) *
      223                                                             buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
      224                                                           )
      225                                                     else 0)
      226             .
      227           end.
      228           create buf1_chk-gds.
      229           buffer-copy buf_chk-gds except doc-code to buf1_chk-gds
      230           assign
      231           buf1_chk-gds.doc-code = buf1_chk-doc.doc-code
      232           .
      233           create temp-goods.
      234           assign
      235           temp-goods.line-num = buf_chk-gds.line-num
      236           temp-goods.object-sum = buf_chk-gds.src-price * buf_chk-gds.src-qnty
      237           .
      238         end.
      239         when yes then do:
      240           if buf_chk-doc.chk-type = integer('8':U) then do:
      241             assign
      242             v-tot-doc-annu = v-tot-doc-annu + buf_chk-gds.src-price * buf_chk-gds.src-qnty
      243             v-sum-office = v-sum-office + buf_chk-gds.src-price * buf_chk-gds.src-qnty
      244             v-discnt-office = v-discnt-office + buf_chk-gds.src-discnt * buf_chk-gds.src-qnty
      245             v-netto-office = v-netto-office + (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty
      246             v-netto-annu = v-netto-annu + (buf_chk-gds.src-price - buf_chk-gds.src-discnt) * buf_chk-gds.src-qnty
      247             v-write-off-office = v-write-off-office + (if buf_chk-gds.write-off-code <> 0
      248                                                     and buf_chk-gds.write-off-code <> ?
      249                                                     then ((if buf_chk-gds.write-off-code > 0 then 1 else - 1) *
      250                                                             buf_chk-gds.src-qnty * (buf_chk-gds.src-price - buf_chk-gds.src-discnt)
      251                                                           )
      252                                                     else 0)
      253             .
      254           end.
      255           else do:
      256             assign
      257             v-sum-office = v-sum-office + buf_chk-gds.price-base * buf_chk-gds.doc-qnty
      258             v-discnt-office = v-discnt-office + buf_chk-gds.discnt * buf_chk-gds.doc-qnty
      259             v-netto-office = v-netto-office + (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty
      260             v-write-off-office = v-write-off-office + (if buf_chk-gds.write-off-code <> 0
      261                                                     and buf_chk-gds.write-off-code <> ?
      262                                                     then ((if buf_chk-gds.write-off-code > 0 then 1 else - 1) *
      263                                                             buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
      264                                                           )
      265                                                     else 0)
      266             .
      267           end.
      268           create buf2_chk-gds.
      269           buffer-copy buf_chk-gds except doc-code to buf2_chk-gds
      270           assign
      271           buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
      272           .
      273           create temp-office.
      274           assign
      275           temp-office.line-num = buf_chk-gds.line-num
      276           temp-office.object-sum = buf_chk-gds.src-price * buf_chk-gds.src-qnty
      277           .
      278         end.
      279       END case.
      280         delete buf_chk-gds.
      281      end.
      282      if  buf_chk-doc.chk-type = integer('8':U) then do:
      283       for each buf_Chk-discnt no-lock where
      284               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
      285           AND buf_chk-discnt.record-type = 0:
      286         if NOT (buf_chk-discnt.line-type = integer('2':U) or
      287                 buf_chk-discnt.line-type = integer('3':U) or
      288                 buf_chk-discnt.line-type = integer('4':U) or
      289                 buf_chk-discnt.line-type = integer('5':U)
      290               ) then NEXT.
      291         if buf_chk-discnt.value-type = integer('1':U)
      292         and buf_chk-discnt.object-line-num = 0 then do:
      293           assign
      294           v-netto-goods = v-netto-goods  - (v-netto-goods * buf_chk-discnt.discnt-value-pcnt) / 100
      295           v-netto-office = v-netto-office  - (v-netto-office * buf_chk-discnt.discnt-value-pcnt) / 100
      296           v-netto-annu = v-netto-annu - (v-netto-annu * buf_chk-discnt.discnt-value-pcnt) / 100
      297           .
      298         end.
      299         else do:
      300           assign
      301           v-netto-goods = v-netto-goods * (v-netto-annu - buf_chk-discnt.discnt-value-abs) / v-netto-annu
      302           v-netto-office = v-netto-office * (v-netto-annu - buf_chk-discnt.discnt-value-abs) / v-netto-annu
      303           v-netto-annu = v-netto-annu - buf_chk-discnt.discnt-value-abs.
      304         end.
      305       end.
      306       assign
      307       v-ratio-goods-sum = v-sum-goods / v-tot-doc-annu
      308       v-ratio-office-sum = v-sum-office / v-tot-doc-annu
      309       buf1_chk-doc.sub-discnt = (if buf_chk-doc.sub-discnt <> ?
      310                                 and buf_chk-doc.sub-discnt <> 0
      311                                 then v-write-off-goods
      312                                 else 0)
      313       buf2_chk-doc.sub-discnt = if buf_chk-doc.sub-discnt <> ?
      314                                 and buf_chk-doc.sub-discnt <> 0
      315                                 then v-write-off-office
      316                                 else 0
      317       buf1_chk-doc.tot-doc = if buf_chk-doc.tot-doc <> ?
      318                              and buf_chk-doc.tot-doc <> 0
      319                              then  (v-sum-goods + (if v-tot-doc-annu < 0
      320                                                    then 0
      321                                                    else - buf1_chk-doc.sub-discnt)
      322                                    )
      323                              else buf_chk-doc.tot-doc
      324       buf2_chk-doc.tot-doc = if buf_chk-doc.tot-doc <> ?
      325                              and buf_chk-doc.tot-doc <> 0
      326                              then (v-sum-office + (if v-tot-doc-annu < 0
      327                                                   then 0
      328                                                   else - buf2_chk-doc.sub-discnt)
      329                                   )
      330                              else buf_chk-doc.tot-doc
      331       buf1_chk-doc.netto = if buf_chk-doc.netto <> ?
      332                            and buf_chk-doc.netto <> 0
      333                            then (v-netto-goods - v-write-off-goods)
      334                            else buf_chk-doc.netto
      335       buf2_chk-doc.netto = if buf_chk-doc.netto <> ?
      336                            and buf_chk-doc.netto <> 0
      337                            then (v-netto-office - v-write-off-office)
      338                            else buf_chk-doc.netto
      339       buf1_chk-doc.discnt = if buf_chk-doc.discnt <> ?
      340                             and buf_chk-doc.discnt <> 0
      341                             then v-discnt-goods
      342                             else buf_chk-doc.discnt
      343       buf2_chk-doc.discnt = if buf_chk-doc.discnt <> ?
      344                             and buf_chk-doc.discnt <> 0
      345                             then v-discnt-office
      346                             else buf_chk-doc.discnt
      347       buf1_chk-doc.d-pcnt = if buf1_chk-doc.tot-doc = 0
      348                             or buf1_chk-doc.tot-doc = ?
      349                               then 0
      350                               else ( buf1_chk-doc.discnt / buf1_chk-doc.tot-doc * 100 )
      351       buf2_chk-doc.d-pcnt = if buf2_chk-doc.tot-doc = 0
      352                             or buf2_chk-doc.tot-doc = ?
      353                               then 0
      354                               else ( buf2_chk-doc.discnt / buf2_chk-doc.tot-doc * 100 )
      355       buf1_chk-doc.office = 'т':U
      356       buf2_chk-doc.office = 'у':U
      357       v-ratio-goods-netto = (v-netto-goods - v-write-off-goods) / v-netto-annu
      358       v-ratio-office-netto = (v-netto-office - v-write-off-office) / v-netto-annu
      359       .
      360      end.
      361      else do:
      362       assign
      363       v-ratio-goods-sum = v-sum-goods / buf_chk-doc.tot-doc
      364       v-ratio-office-sum = v-sum-office / buf_chk-doc.tot-doc
      365       buf1_chk-doc.sub-discnt = v-write-off-goods
      366       buf2_chk-doc.sub-discnt = v-write-off-office
      367       buf1_chk-doc.tot-doc = v-sum-goods + (if buf_Chk-doc.chk-type = integer('6':U)
      368                                             or buf_Chk-doc.chk-type = integer('96':U)
      369                                             then 0
      370                                             else - buf1_chk-doc.sub-discnt)
      371       buf2_chk-doc.tot-doc = v-sum-office + (if buf_Chk-doc.chk-type = integer('6':U)
      372                                             or buf_Chk-doc.chk-type = integer('96':U)
      373                                             then 0
      374                                             else - buf2_chk-doc.sub-discnt)
      375       buf1_chk-doc.netto = v-netto-goods - buf1_chk-doc.sub-discnt
      376       buf2_chk-doc.netto = v-netto-office - buf2_chk-doc.sub-discnt
      377       buf1_chk-doc.discnt = v-discnt-goods
      378       buf2_chk-doc.discnt = v-discnt-office
      379       buf1_chk-doc.d-pcnt = if buf1_chk-doc.tot-doc = 0
      380                               then 0
      381                               else ( buf1_chk-doc.discnt / buf1_chk-doc.tot-doc * 100 )
      382       buf2_chk-doc.d-pcnt = if buf2_chk-doc.tot-doc = 0
      383                               then 0
      384                               else ( buf2_chk-doc.discnt / buf2_chk-doc.tot-doc * 100 )
      385       buf1_chk-doc.office = 'т':U
      386       buf2_chk-doc.office = 'у':U
      387       v-ratio-goods-netto = buf1_chk-doc.netto / buf_chk-doc.netto
      388       v-ratio-office-netto = buf2_chk-doc.netto / buf_chk-doc.netto
      389       .
      390      end.
      391      for each buf_chk-pay where
      392               buf_chk-pay.doc-code = buf_chk-doc.doc-code:
      393        num-pay = num-pay + 1.
      394      end.
      395      if num-pay = 1 then do:
      396        for each buf_chk-pay where
      397                 buf_chk-pay.doc-code = buf_chk-doc.doc-code:
      398         create buf1_chk-pay.
      399         buffer-copy buf_chk-pay except doc-code to buf1_chk-pay
      400         assign
      401         buf1_chk-pay.doc-code = buf1_chk-doc.doc-code
      402         buf1_chk-pay.tot-base = (if v-curr-r-b = 'base':U and  not v-is-annu
      403                                 then buf1_chk-doc.netto
      404                                 else  v-ratio-goods-netto * buf_chk-pay.tot-base
      405                                 )
      406         buf1_chk-pay.tot-rubl = (if v-curr-r-b = 'rubl':U and  not v-is-annu
      407                                  then buf1_chk-doc.netto
      408                                  ELSE v-ratio-goods-netto * buf_chk-pay.tot-rubl
      409                                  )
      410         buf1_chk-pay.tot-sum = v-ratio-goods-netto * buf_chk-PAY.TOT-SUM
      411         .
      412         create buf2_chk-pay.
      413         buffer-copy buf_chk-pay except doc-code to buf2_chk-pay
      414         assign
      415         buf2_chk-pay.doc-code = buf2_chk-doc.doc-code
      416         buf2_chk-pay.tot-base = If v-is-annu
      417                                 then (v-ratio-office-netto * buf_chk-pay.tot-base)
      418                                 else (buf_chk-pay.tot-base - buf1_chk-pay.tot-base)
      419         buf2_chk-pay.tot-rubl = If v-is-annu
      420                                 then (v-ratio-office-netto * buf_chk-pay.tot-rubl)
      421                                 else (buf_chk-pay.tot-rubl - buf1_chk-pay.tot-rubl)
      422         buf2_chk-pay.tot-sum = If v-is-annu
      423                                then v-ratio-office-netto * buf_chk-PAY.TOT-SUM
      424                                else (buf_chk-pay.tot-sum - buf1_chk-pay.tot-sum)
      425         .
      426         delete buf_chk-pay.
      427        end.
      428      end.
      429      else do:
      430       for each buf_chk-pay where
      431                 buf_chk-pay.doc-code = buf_chk-doc.doc-code:
      432         create buf1_chk-pay.
      433         buffer-copy buf_chk-pay except doc-code to buf1_chk-pay
      434         assign
      435         buf1_chk-pay.doc-code = buf1_chk-doc.doc-code
      436         buf1_chk-pay.tot-sum = v-ratio-goods-netto * buf_chk-pay.tot-sum
      437         buf1_chk-pay.tot-base = v-ratio-goods-netto * buf_chk-pay.tot-base
      438         buf1_chk-pay.tot-rubl = v-ratio-goods-netto * buf_chk-pay.tot-rubl
      439         .
      440         create buf2_chk-pay.
      441         buffer-copy buf_chk-pay except doc-code to buf2_chk-pay
      442         assign
      443         buf2_chk-pay.doc-code = buf2_chk-doc.doc-code
      444         buf2_chk-pay.tot-sum = v-ratio-office-netto * buf_chk-pay.tot-sum
      445         buf2_chk-pay.tot-base = v-ratio-office-netto * buf_chk-pay.tot-base
      446         buf2_chk-pay.tot-rubl = v-ratio-office-netto * buf_chk-pay.tot-rubl
      447         .
      448         delete buf_chk-pay.
      449       end.
      450      end.
      451      assign
      452      current-line-num = 0
      453      .
      454      _buf_chk-didscnt:
      455      for each buf_chk-discnt where
      456               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
      457      by buf_chk-discnt.line-num
      458      by buf_chk-discnt.discnt-id
      459      by abs(buf_chk-discnt.object-line-num)
      460      by buf_chk-discnt.object-line-num
      461      :
      462        CASE buf_chk-discnt.record-type:
      463          when 0 then do:
      464           for each temp-goods no-lock where
      465                     abs(temp-goods.line-num) > abs(current-line-num) and
      466                     abs(temp-goods.line-num) <= abs(buf_chk-discnt.line-num):
      467               assign
      468               v-object-sum-goods = v-object-sum-goods + temp-goods.object-sum
      469               .
      470           end.
      471           for each temp-office no-lock where
      472                     abs(temp-office.line-num) > abs(current-line-num) and
      473                     abs(temp-office.line-num) <= abs(buf_chk-discnt.line-num):
      474               assign
      475               v-object-sum-office = v-object-sum-office + temp-office.object-sum
      476               .
      477           end.
      478           assign
      479           v-object-sum = v-object-sum-goods + v-object-sum-office
      480           v-ratio-goods-discnt = v-object-sum-goods / v-object-sum
      481           v-ratio-office-discnt = v-object-sum-office / v-object-sum
      482           .
      483           assign
      484           current-line-num = buf_chk-discnt.line-num
      485           .
      486           if buf_chk-discnt.line-type = integer('1':U)
      487           and can-find(first temp-office where
      488                              temp-office.line-num = buf_chk-discnt.object-line-num) then do:
      489           end.
      490           else do:
      491             create buf1_chk-discnt.
      492             buffer-copy buf_chk-discnt except doc-code to buf1_chk-discnt
      493             assign
      494             buf1_chk-discnt.doc-code = buf1_chk-doc.doc-code
      495             .
      496             CASE buf_chk-discnt.line-type:
      497               when integer('2':U) or when integer('3':U) then do:
      498                 assign
      499                 buf1_chk-discnt.object-sum = v-ratio-goods-discnt * buf_chk-discnt.object-sum
      500                 buf1_chk-discnt.discnt-value-abs = v-ratio-goods-discnt * buf_chk-discnt.discnt-value-abs
      501                 buf1_chk-discnt.discnt-value-pcnt =  if buf1_chk-discnt.object-sum <> 0
      502                                                     then buf1_chk-discnt.discnt-value-abs / buf1_chk-discnt.object-sum * 100
      503                                                     else 0
      504                 .
      505               end.
      506               when integer('4':U) or when integer('5':U) then do:
      507               assign
      508               buf1_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * v-ratio-goods-netto
      509               buf1_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * v-ratio-goods-netto
      510               buf1_chk-discnt.discnt-value-pcnt =  if buf1_chk-discnt.object-sum <> 0
      511                                                     then buf1_chk-discnt.discnt-value-abs / buf1_chk-discnt.object-sum * 100
      512                                                     else 0
      513               .
      514               end.
      515             END CASE.
      516             v-object-sum-goods = v-object-sum-goods - buf1_chk-discnt.discnt-value-abs.
      517           end.
      518           if buf_chk-discnt.line-type = integer('1':U)
      519           and can-find(first temp-goods where
      520                              temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
      521           end.
      522           else do:
      523             create buf2_chk-discnt.
      524             buffer-copy buf_chk-discnt except doc-code to buf2_chk-discnt
      525             assign
      526             buf2_chk-discnt.doc-code = buf2_chk-doc.doc-code
      527             .
      528             CASE buf_chk-discnt.line-type:
      529               when integer('2':U) or when integer('3':U) then do:
      530                 assign
      531                 buf2_chk-discnt.object-sum = v-ratio-office-discnt * buf_chk-discnt.object-sum
      532                 buf2_chk-discnt.discnt-value-abs = v-ratio-office-discnt * buf_chk-discnt.discnt-value-abs
      533                 buf2_chk-discnt.discnt-value-pcnt =  if buf2_chk-discnt.object-sum <> 0
      534                                                     then buf2_chk-discnt.discnt-value-abs / buf2_chk-discnt.object-sum * 100
      535                                                     else 0
      536                 .
      537               end.
      538               when integer('4':U) or when integer('5':U) then do:
      539               assign
      540               buf2_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * v-ratio-office-netto
      541               buf2_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * v-ratio-office-netto
      542               buf2_chk-discnt.discnt-value-pcnt =  if buf2_chk-discnt.object-sum <> 0
      543                                                     then buf2_chk-discnt.discnt-value-abs / buf2_chk-discnt.object-sum * 100
      544                                                     else 0
      545               .
      546               end.
      547             END CASE.
      548             v-object-sum-office = v-object-sum-office - buf2_chk-discnt.discnt-value-abs.
      549           end.
      550           assign
      551           v-object-sum = v-object-sum-goods + v-object-sum-office
      552           v-ratio-goods-discnt = v-object-sum-goods / v-object-sum
      553           v-ratio-office-discnt = v-object-sum-office / v-object-sum
      554           .
      555         end.
      556         when 1 then do:
      557           if can-find(first temp-office where
      558                             temp-office.line-num = buf_chk-discnt.object-line-num) then do:
      559           end.
      560           else do:
      561             create buf1_chk-discnt.
      562             buffer-copy buf_chk-discnt except doc-code to buf1_chk-discnt
      563             assign
      564             buf1_chk-discnt.doc-code = buf1_chk-doc.doc-code
      565             .
      566           end.
      567           if can-find(first temp-goods where
      568                             temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
      569           end.
      570           else do:
      571             create buf2_chk-discnt.
      572             buffer-copy buf_chk-discnt except doc-code to buf2_chk-discnt
      573             assign
      574             buf2_chk-discnt.doc-code = buf2_chk-doc.doc-code
      575             .
      576           end.
      577         end.
      578         when 2 then do:
      579           if can-find(first temp-office where
      580                             temp-office.line-num = buf_chk-discnt.object-line-num) then do:
      581           end.
      582           else do:
      583             create buf1_chk-discnt.
      584             buffer-copy buf_chk-discnt except doc-code to buf1_chk-discnt
      585             assign
      586             buf1_chk-discnt.doc-code = buf1_chk-doc.doc-code
      587             .
      588           end.
      589           if can-find(first temp-goods where
      590                             temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
      591           end.
      592           else do:
      593             create buf2_chk-discnt.
      594             buffer-copy buf_chk-discnt except doc-code to buf2_chk-discnt
      595             assign
      596             buf2_chk-discnt.doc-code = buf2_chk-doc.doc-code
      597             .
      598           end.
      599         end.
      600         when 4 then do:
      601           for each temp-goods no-lock where
      602                     abs(temp-goods.line-num) > abs(current-line-num-bonus) and
      603                     abs(temp-goods.line-num) <= abs(buf_chk-discnt.line-num):
      604               assign
      605               v-object-sum-goods-bonus = v-object-sum-goods-bonus + temp-goods.object-sum
      606               .
      607           end.
      608           for each temp-office no-lock where
      609                     abs(temp-office.line-num) > abs(current-line-num-bonus) and
      610                     abs(temp-office.line-num) <= abs(buf_chk-discnt.line-num):
      611               assign
      612               v-object-sum-office-bonus = v-object-sum-office-bonus + temp-office.object-sum
      613               .
      614           end.
      615           assign
      616           v-object-sum-bonus = v-object-sum-goods-bonus + v-object-sum-office-bonus
      617           v-ratio-goods-bonus = ( if v-object-sum-bonus = 0
      618                                   then 0
      619                                   else v-object-sum-goods-bonus / v-object-sum-bonus)
      620           v-ratio-office-bonus = (if v-object-sum-bonus = 0
      621                                   then 0
      622                                   else v-object-sum-office-bonus / v-object-sum-bonus)
      623           .
      624           assign
      625           current-line-num-bonus = buf_chk-discnt.line-num
      626           .
      627           if buf_chk-discnt.line-type = integer('1':U)
      628           and can-find(first temp-office where
      629                              temp-office.line-num = buf_chk-discnt.object-line-num) then do:
      630           end.
      631           else do:
      632             create buf1_chk-discnt.
      633             buffer-copy buf_chk-discnt except doc-code to buf1_chk-discnt
      634             assign
      635             buf1_chk-discnt.doc-code = buf1_chk-doc.doc-code
      636             .
      637             CASE buf_chk-discnt.line-type:
      638               when integer('2':U) or when integer('3':U) then do:
      639                 assign
      640                 buf1_chk-discnt.object-sum = v-ratio-goods-bonus * buf_chk-discnt.object-sum
      641                 buf1_chk-discnt.discnt-value-abs = v-ratio-goods-bonus * buf_chk-discnt.discnt-value-abs
      642                 buf1_chk-discnt.discnt-value-pcnt =  if buf1_chk-discnt.object-sum <> 0
      643                                                     then buf1_chk-discnt.discnt-value-abs / buf1_chk-discnt.object-sum * 100
      644                                                     else 0
      645                 .
      646               end.
      647               when integer('4':U) or when integer('5':U) then do:
      648               assign
      649               buf1_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * v-ratio-goods-netto
      650               buf1_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * v-ratio-goods-netto
      651               buf1_chk-discnt.discnt-value-pcnt =  if buf1_chk-discnt.object-sum <> 0
      652                                                     then buf1_chk-discnt.discnt-value-abs / buf1_chk-discnt.object-sum * 100
      653                                                     else 0
      654               .
      655               end.
      656             END CASE.
      657           end.
      658           if buf_chk-discnt.line-type = integer('1':U)
      659           and can-find(first temp-goods where
      660                              temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
      661           end.
      662           else do:
      663             create buf2_chk-discnt.
      664             buffer-copy buf_chk-discnt except doc-code to buf2_chk-discnt
      665             assign
      666             buf2_chk-discnt.doc-code = buf2_chk-doc.doc-code
      667             .
      668             CASE buf_chk-discnt.line-type:
      669               when integer('2':U) or when integer('3':U) then do:
      670                 assign
      671                 buf2_chk-discnt.object-sum = v-ratio-office-bonus * buf_chk-discnt.object-sum
      672                 buf2_chk-discnt.discnt-value-abs = v-ratio-office-bonus * buf_chk-discnt.discnt-value-abs
      673                 buf2_chk-discnt.discnt-value-pcnt =  if buf2_chk-discnt.object-sum <> 0
      674                                                     then buf2_chk-discnt.discnt-value-abs / buf2_chk-discnt.object-sum * 100
      675                                                     else 0
      676                 .
      677               end.
      678               when integer('4':U) or when integer('5':U) then do:
      679               assign
      680               buf2_chk-discnt.discnt-value-abs = buf_chk-discnt.discnt-value-abs * v-ratio-office-netto
      681               buf2_chk-discnt.object-sum       = buf_chk-discnt.discnt-value-abs * v-ratio-office-netto
      682               buf2_chk-discnt.discnt-value-pcnt =  if buf2_chk-discnt.object-sum <> 0
      683                                                     then buf2_chk-discnt.discnt-value-abs / buf2_chk-discnt.object-sum * 100
      684                                                     else 0
      685               .
      686               end.
      687             END CASE.
      688           end.
      689           assign
      690           v-object-sum-bonus = v-object-sum-goods-bonus + v-object-sum-office-bonus
      691           v-ratio-goods-bonus = v-object-sum-goods-bonus / v-object-sum-bonus
      692           v-ratio-office-bonus = v-object-sum-office-bonus / v-object-sum-bonus
      693           .
      694         end.
      695         when 5 then do:
      696           if can-find(first temp-office where
      697                             temp-office.line-num = buf_chk-discnt.object-line-num) then do:
      698           end.
      699           else do:
      700             create buf1_chk-discnt.
      701             buffer-copy buf_chk-discnt except doc-code to buf1_chk-discnt
      702             assign
      703             buf1_chk-discnt.doc-code = buf1_chk-doc.doc-code
      704             .
      705           end.
      706           if can-find(first temp-goods where
      707                             temp-goods.line-num = buf_chk-discnt.object-line-num) then do:
      708           end.
      709           else do:
      710             create buf2_chk-discnt.
      711             buffer-copy buf_chk-discnt except doc-code to buf2_chk-discnt
      712             assign
      713             buf2_chk-discnt.doc-code = buf2_chk-doc.doc-code
      714             .
      715           end.
      716         end.
      717        END CASE.
      718        delete buf_chk-discnt.
      719      end.
      720      delete buf_chk-doc.
      721      return ''.
      722   end.
