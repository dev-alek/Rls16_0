        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-news     as logical no-undo .
        6   define input parameter p-auto     as logical no-undo .
        7   define input parameter p-mode     as character no-undo .
        8   define input parameter log-file-name as character no-undo .
        9   define input parameter p-url as character no-undo .
       10   define input parameter p-post-file-name as character no-undo .
       11   define input parameter p-response-file-name as character no-undo .
       12   define input parameter p-response-time   as integer no-undo .
       13   DEFINE INPUT PARAMETER p-mess AS CHAR NO-UNDO.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Запуск на выполнение командной строки без экрана".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       80      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       83     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       84   FUNCTION GetLastError
       85            RETURNS INTEGER
       86            ()
       87            IN hpWinFunc.
       88   FUNCTION GetParent
       89            RETURNS INTEGER
       90            (input hwnd as INTEGER)
       91            IN hpWinFunc.
       92   FUNCTION ShowLastError
       93            RETURNS INTEGER
       94            ()
       95            IN hpWinFunc.
       96   FUNCTION CreateProcess
       97            RETURNS INTEGER
       98            (input CommandLine as CHAR,
       99             input CurrentDir  as CHAR,
      100             input wShowWindow as INTEGER)
      101            in hpWinFunc.
      102   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   function IsProcessRunning return integer
      104     (PID AS INTEGER) :
      105     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
      106     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
      107     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
      108     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
      109     define variable rv          as integer no-undo .
      110     RUN OpenProcess in hpapi
      111                     ( 1024,
      112                       0,
      113                       PID,
      114                       OUTPUT hProcess).
      115     IF hProcess NE 0 THEN DO:
      116        RUN GetExitcodeProcess in hpapi
      117                     ( hProcess,
      118                       OUTPUT ExitCode,
      119                       OUTPUT ReturnValue).
      120        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
      121             then  - 1
      122             else ReturnValue).
      123        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
      124     END.
      125     RETURN rv.
      126   end.
      127   define variable Cmd                       AS CHARacter                No-UNDO.
      128   define variable cmd-out                   as character                no-undo .
      129   define variable v-result                  as character                no-undo .
      130   define variable curl-path                 as character                no-undo .
      131   define variable HiNSTANCE                 AS INTEGER                  NO-UNDO.
      132   define variable v-path                    as character                no-undo .
      133   DEFINE VARIABLE v-full-path               as character                no-undo .
      134   DEFINE VARIABLE v-file-name               as character                no-undo .
      135   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      136   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      137   define variable v-errrs                   as character                no-undo .
      138   define variable v-std-err-file-name       as character                no-undo .
      139   define variable bat-file                  as character                no-undo.
      140   define variable v-size                    as integer                  no-undo .
      141   define variable rv                        as integer                  no-undo .
      142   define variable v-pid                     as integer                  no-undo .
      143   define variable v-instant                 as logical                  no-undo .
      144   main-block:
      145   do
      146   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message (1))
      147   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      148   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      149   :
      150     assign
      151       curl-path = search("exe/curl.exe")
      152     .
      153     if curl-path = ? then do:
      154       undo main-block, return error "Не найден путь к файлу exe/curl.exe" .
      155     end.
      156     if num-entries(p-mode) > 1 then do:
      157       if entry(2,p-mode) = "instant" then do:
      158         v-instant = yes.
      159       end.
      160       p-mode = entry(1, p-mode).
      161     end.
      162     OS-DELETE value(p-response-file-name).
      163     run write-log-and-file in p-log-handle (
      164         input 1
      165       , input log-file-name
      166       , input 1
      167       , input p-mess      ).
      168     if (p-news or p-auto)
      169     and p-mode <>'get'
      170     then do:
      171       run gbl/_tmpfile.p (
      172                           input ""
      173                         , input "err"
      174                         , output v-std-err-file-name) .
      175       run gbl/_tmpfile.p (
      176                           input ""
      177                         , input "bat"
      178                         , output bat-file) .
      179       assign
      180       cmd = substitute('"&1" -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 --stderr &4 '
      181                       , curl-path
      182                       , p-post-file-name
      183                       , p-url
      184                       , v-std-err-file-name
      185                       )
      186       .
      187       output to value(bat-file) convert target "ibm866".
      188       PUT  UNFORMATTED cmd SKIP.
      189       output close.
      190     end.
      191     else do:
      192       run gbl/_tmpfile.p (
      193                           input ""
      194                         , input "bat"
      195                         , output bat-file) .
      196       assign
      197       cmd = substitute('"&1" -0 --trace-ascii test.txt -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      198                       , curl-path
      199                       , p-post-file-name
      200                       , p-url
      201                       , p-response-file-name)
      202       .
      203       output to value(bat-file) convert target "ibm866".
      204       PUT  UNFORMATTED cmd SKIP.
      205       output close.
      206     end.
      207     if (p-news = yes
      208     or p-auto = yes) then do:
      209       run gbl/run-gpid.p (
      210                         input bat-file
      211                        ,input '':U
      212                        ,output v-pid).
      213     end.
      214     else do:
      215       OS-COMMAND silent  value(bat-file).
      216     end.
      217     define variable v-time-count as integer no-undo .
      218     define variable v-err-file-found as logical no-undo .
      219     if v-instant then do:
      220       p-response-time = p-response-time * 2.
      221     end.
      222     if (not (p-news = yes or p-auto = yes) )
      223     or p-mode = 'get'
      224     then do:
      225       REPEAT:
      226         _repeat:
      227         REPEAT WHILE v-time-count < p-response-time :
      228           assign
      229             v-time-count = v-time-count + 1
      230           .
      231           run gbl/pause.p( 1000).
      232           assign
      233             FILE-INFO :FILE-NAME = p-response-file-name
      234           .
      235           if file-info = ? then do:
      236             v-time-count = v-time-count - 1.
      237             run gbl/pause.p( 1000).
      238             next _repeat.
      239           end.
      240           IF INDEX(FILE-INFO:FILE-TYPE, "F")  > 0 then  do:
      241             input from value(p-response-file-name).
      242             import unformatted v-result no-error .
      243             input close.
      244             if error-status:error
      245             or not (v-result begins "<?xml") then do:
      246               v-errrs = error-status:get-message(1) .
      247               OS-DELETE value(p-post-file-name).
      248               OS-DELETE value(p-response-file-name).
      249               OS-DELETE value(bat-file).
      250               return error.
      251             end.
      252             assign
      253               v-err-file-found = true
      254             .
      255             leave .
      256          end.
      257        END.
      258        if v-time-count > p-response-time
      259        or v-err-file-found = yes
      260        then leave.
      261        v-time-count = v-time-count + 1.
      262        if error-status:error then do:
      263           v-time-count = v-time-count + 1.
      264        end.
      265      end.
      266      if v-err-file-found <> true then do:
      267         run write-log-and-file in p-log-handle (
      268             input 1
      269           , input log-file-name
      270           , input 1
      271           , input substitute("Превышено время ожидания &1&2Не найден файл с результатом выполнения задания &3&2&4"
      272                             , p-response-time
      273                             , chr(10)
      274                             , cmd
      275                             , v-errrs)
      276                              ).
      277         OS-DELETE value(bat-file).
      278         if not (p-news = ? and p-auto = ?) then
      279         OS-DELETE value(p-post-file-name).
      280       end.
      281       else do:
      282         run write-log-and-file in p-log-handle (
      283             input 1
      284           , input log-file-name
      285           , input 1
      286           , input substitute("Время ожидания выполнения задания на кассе - &1 c"
      287                             , v-time-count
      288                              )).
      289       end.
      290     end.
      291     else do:
      292       _nrepeat:
      293       REPEAT WHILE v-time-count < 14 :
      294         assign
      295           v-time-count = v-time-count + 1
      296         .
      297         pause 1 no-message .
      298         rv = IsProcessRunning(v-pid).
      299         if rv >= 0 then do:
      300           run write-log-and-file in p-log-handle (
      301               input 1
      302             , input log-file-name
      303             , input 1
      304             , input substitute("Время ожидания выполнения задания на кассе - &1 с"
      305                               , v-time-count
      306                               )).
      307           assign
      308           FILE-INFO :FILE-NAME = v-std-err-file-name
      309           .
      310           if file-info:full-pathname = v-std-err-file-name  then do:
      311              run gbl/filesize.p ( input v-std-err-file-name
      312                              ,output v-size ) no-error .
      313              if v-size <> 0 then do:
      314                run gbl/filename.p (
      315                   input p-post-file-name
      316                 ,output v-full-path
      317                 ,output v-path
      318                 ,output v-file-name
      319                 ,output v-file-name-no-ext
      320                 ,output v-file-name-ext
      321                 ) no-error .
      322               run copyto-log-and-file in p-log-handle ( input v-std-err-file-name
      323                                                       ,input 1
      324                                                       ,input log-file-name
      325                                                       ,input 1
      326                                                       ).
      327               os-delete value (v-std-err-file-name).
      328               if not v-instant then do:
      329               run gbl/dir-cre.p ( input v-path + '\undelivered\') no-error .
      330               if error-status:error then do:
      331                 run write-log-and-file in p-log-handle (
      332                       input 1
      333                     , input log-file-name
      334                     , input 1
      335                     , input substitute(
      336                                       "!!!Каталог &1 для хранения НЕДОСТАВЛЕННЫХ файлов не найден&2" +
      337                                       "и/или попытка его создания не удалась:&2&3 &4"
      338                                       , v-path + '\undelivered\'
      339                                       , chr(10)
      340                                       , error-status:get-message(1)
      341                                       , return-value
      342                                       )).
      343                 return "error".
      344               end.
      345               else do:
      346                 os-rename value( p-post-file-name  )  value( v-path + '\undelivered\' + v-file-name ) .
      347               end.
      348               end.
      349             end.
      350             else do:
      351               os-delete value (v-std-err-file-name).
      352             end.
      353           end.
      354           leave _nrepeat.
      355         end.
      356       end.
      357       if v-time-count >= 14 then do:
      358         run write-log-and-file in p-log-handle (
      359             input 1
      360           , input log-file-name
      361           , input 1
      362           , input substitute("Время ожидания выполнения задания на кассе - &1 с"
      363                             , v-time-count
      364                             )).
      365       end.
      366     end.
      367     OS-DELETE value(bat-file).
      368     OS-DELETE value(p-post-file-name).
      369   end.
