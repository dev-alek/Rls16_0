        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-request-dir  as character no-undo .
        6   define input parameter p-temp-dir   as character no-undo .
        7   define input parameter p-tempfile   as character no-undo .
        8   define input parameter p-dir-path   as character no-undo .
        9   define input parameter p-is-script as logical no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: 2014/01/27 14:27:46 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: runtekka.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: str/runtekka.p $":U .
       15   define variable vss-description as character no-undo init "Запуск дополнительной сессии для коммуникации с кассой МАРИЯ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable tempfile     as character no-undo.
       75   define variable tempfile-tsk as character no-undo .
       76   define variable res          as character no-undo .
       77   define variable v-cmdln      as character no-undo .
       78   define variable v-exefile    as character no-undo .
       79   define variable v-inifile    as character no-undo .
       80   define variable err-file     as character no-undo .
       81   define variable bat-file-name as character no-undo .
       82   define variable v-params as character no-undo .
       83   define stream for-task .
       84   do
       85   on error undo, return error return-value
       86   :
       87     assign
       88     tempfile-tsk = p-temp-dir  + p-tempfile + '.':U + 'tsk':U
       89     .
       90     if p-is-script then do:
       91       run gbl/_tmpfile.p (
       92                            input "":U
       93                          , input "":U
       94                          , output err-file) .
       95       p-temp-dir = trim(p-temp-dir, chr(34)).
       96       assign
       97       err-file = err-file + ".err":u
       98       v-params =
       99                 "%" + chr(126) + "1 -param":U + chr(32) + chr(34)
      100                 + p-dir-path + chr(44)
      101                 + err-file + chr(44)
      102                 + tempfile-tsk + chr(44)
      103                 + p-temp-dir + chr(34)
      104       .
      105     end.
      106     else do:
      107       run gbl/getexini.p
      108         (output v-exefile
      109         ,output v-inifile
      110         ) no-error .
      111       if error-status :error
      112       then do:
      113         message
      114           vss-workfile vss-revision vss-description skip
      115           "Ошибка при определении имени выполняемого файла и *.ini файла" skip
      116           error-status :get-message(1) skip
      117           return-value skip
      118           view-as alert-box error .
      119         undo, return error .
      120       end.
      121       run gbl/_tmpfile.p (
      122                            input ""
      123                           ,input ""
      124                           ,output err-file) .
      125       p-temp-dir = trim(p-temp-dir, chr(34)).
      126       assign
      127       err-file = err-file + ".err":u
      128       v-cmdln  =
      129                   v-exefile
      130                 + chr(32) + "-ininame":u + chr(32) + v-inifile
      131                 + chr(32) + "-p":U + chr(32) + "exttekka.p":u
      132                 + chr(32) + "-param":U + chr(32) + chr(34)
      133                 + p-dir-path + chr(44)
      134                 + err-file + chr(44)
      135                 + tempfile-tsk + chr(44)
      136                 + p-temp-dir + chr(34)
      137       .
      138     end.
      139     run write-log in p-log-handle (
      140                                   input  1
      141                                   ,input substitute("Выполнение команды &1", v-cmdln     )) .
      142     if not p-is-script then do:
      143       run gbl/syn3.p
      144         (
      145          input v-cmdln
      146         ,input err-file
      147         ,input "Ждите! Идет обмен информацией с ТЭККА..."
      148         ,output res
      149         ) no-error .
      150     end.
      151     else do:
      152       assign
      153       bat-file-name = p-request-dir  + p-tempfile + '.':U + 'bat':U.
      154       run gbl/syn5.p
      155         (
      156          input v-params
      157         ,input err-file
      158         ,input bat-file-name
      159         ,input "Ждите! Идет обмен информацией с ТЭККА..."
      160         ,output res
      161         ) no-error .
      162     end.
      163     if res <>  "":U
      164     then do:
      165       undo, return error substitute("Не  удалось  обменяться информацией с ТЭККА:&1&2", chr(10), res).
      166     end.
      167   end.
