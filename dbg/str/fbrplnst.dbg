     1044                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1045                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1046                 and buf_parts.artic     = buf_doc-line.artic
     1047                 and buf_parts.prod-type = buf_doc-line.prod-type
     1048                 and buf_parts.prod-code = buf_doc-line.prod-code
     1049             on error undo, return error
     1050             :
