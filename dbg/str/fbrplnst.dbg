      949     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      950     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      951     do
      952     on error undo, return error
      953     :
      954       define buffer   in-vatp-trn-doc  for ub.trn-doc .
