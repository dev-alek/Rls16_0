     2794                           , input 'план-меню':U
     2795                           , input 'новый':U
     2796                           , input no
     2797                           , input ""
     2798                           , input ""
     2799                           , input temp_fbrrep-goods.gds-code
     2800                           , input 'ev':U
     2801                           , input v-need-qnty
     2802                           , input substitute( "Создана строка запроса &1 на объекте &2 &3. Артикул: &4. Количество: &5."
     2803                                               , v-trn-doc-code
     2804                                               , v-store-obj-type
     2805                                               , v-store-obj-code
     2806                                               , temp_fbrrep-goods.artic
     2807                                               , v-need-qnty
     2808                                           )
     2809                           , input no
     2810                       ).
     2811                   end.
     2812               end.
     2813           end.
     2814       end.
     2815       find first buf_doc-line no-lock
     2816            where buf_doc-line.doc-code    = v-trn-doc-code
     2817       no-error.
     2818       if not available buf_doc-line
     2819       then do:
     2820           delete buf_trn-doc.
     2821           assign
     2822               p-doc-created = yes
     2823           .
     2824           if valid-handle( p-fbrhist-handle )
     2825           then do:
     2826               run fbrhist-write in p-fbrhist-handle (
     2827                     input v-cntxt-userid
     2828                   , input v-store-obj-type
     2829                   , input v-store-obj-code
     2830                   , input 'соз_стр':U
     2831                   , input 2
     2832                   , input "str/fbrplnst.p"
     2833                   , input substitute( "fbr-pln-doc-code:&1,kitchen-obj-code:&2,fbr-doc-code:&3"
     2834                                       , p-fbr-pln-doc-code
     2835                                       , p-kitchen-obj-code
     2836                                       , p-fbr-doc-code
     2837                                       )
     2838                   , input p-fbr-pln-doc-code
     2839                   , input 'план-меню':U
     2840                   , input 'новый':U
     2841                   , input no
     2842                   , input ""
     2843                   , input ""
     2844                   , input 0
     2845                   , input ""
     2846                   , input 0
     2847                   , input substitute( "В документе нет строк. Запрос &1 удален."
     2848                                       , v-trn-doc-code
     2849                                   )
     2850                   , input no
     2851               ).
     2852           end.
     2853       end.
     2854       else do:
     2855           assign
     2856               buf_trn-doc.out-code = p-fbr-doc-code
     2857           .
     2858           run gbl/calc-trn.p (
     2859               input parparentproc
     2860             , input recid( buf_trn-doc )
     2861           ).
     2862           assign
     2863               p-doc-created = yes
     2864           .
     2865       end.
     2866   end.
