     1332                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1333                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1334                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1335                         .
     1336         end.
     1337         ASSIGN
     1338           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1339           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1340           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1341           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1342           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1343           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1344                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1345           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1346                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1347           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1348           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1349           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1350         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1351         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1352         if transport-base-loc = ? then transport-base-loc = 0.
     1353         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1354         if other-base-loc     = ? then other-base-loc     = 0.
     1355         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1356         assign
     1357           transport-cli-loc      = 0
     1358           other-cli-loc          = 0
     1359           road-tax-cli-loc       = ?
     1360           vat-cli-loc            = ?
     1361           slt-cli-loc            = ?
     1362           price-cli-with-tax-loc = ?.
     1363      end.
     1364   ASSIGN
     1365             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1366       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1367   .
     1368             assign
     1369               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1370               v-vat-pc              = vat-pc-loc
     1371               v-slt-pc              = slt-pc-loc
     1372               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1373               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1374               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1375               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1376               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1377               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1378               v-road-tax-base       =  0
     1379               v-road-tax-rubl       =  0
     1380               v-excise-base         =  0
     1381               v-excise-rubl         =  0
     1382               v-transport-base      =  0
     1383               v-transport-rubl      =  0
     1384               v-other-base          =  0
     1385               v-other-rubl          =  0
     1386             .
     1387       end.
     1388     end.
     1389   end procedure.
     1390   procedure fbrrep-fill-qnty-and-prices :
     1391   do
     1392   on error undo, return error
     1393   :
     1394   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1395       define variable v-gds-code  as integer       no-undo.
     1396       define variable v-gds-name  as character     no-undo.
     1397       define variable v-sign      as decimal       no-undo.
     1398       define buffer buf_fbr-line          for ub.fbr-line.
     1399       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1400       for each buf_fbr-line no-lock
     1401          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1402       on error undo, return error
     1403       :
     1404           find first buf_temp_fbrrep-goods
     1405                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1406                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1407                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1408           use-index ar
     1409           no-error.
     1410           if not available buf_temp_fbrrep-goods
     1411           then do:
     1412               create buf_temp_fbrrep-goods.
     1413   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1415     (input  buf_fbr-line.artic
     1416     ,input  buf_fbr-line.prod-type
     1417     ,input  buf_fbr-line.prod-code
     1418     ,output v-gds-code
     1419     )  .
     1420   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1422     (input  buf_fbr-line.artic
     1423     ,input  buf_fbr-line.prod-type
     1424     ,input  buf_fbr-line.prod-code
     1425     ,output v-gds-name
     1426     )  .
     1427   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1429     (input  buf_fbr-line.artic
     1430     ,input  buf_fbr-line.prod-type
     1431     ,input  buf_fbr-line.prod-code
     1432     ,input  'gds-goods=request':u
     1433     ,output buf_temp_fbrrep-goods.is-not-office
     1434     )  .
     1435               assign
     1436                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     1437                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     1438                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     1439                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     1440                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     1441                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     1442                   buf_temp_fbrrep-goods.fact-qnty            = 0
     1443                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1444                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     1445                   buf_temp_fbrrep-goods.income-qnty          = 0
     1446                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1447                   buf_temp_fbrrep-goods.cost-rubl            = 0
     1448                   buf_temp_fbrrep-goods.cost-base            = 0
     1449                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1450                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     1451                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1452                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     1453                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1454                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1455                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     1456                   buf_temp_fbrrep-goods.deleted              = no
     1457               .
     1458   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1460     (input  v-gds-code
     1461     ,output buf_temp_fbrrep-goods.unit-base
     1462     )  .
     1463           end.
     1464           case buf_fbr-line.trn-type
     1465           :
     1466               when 'при':U
     1467               then do:
     1468                   assign
     1469                       v-sign                                  = 1
     1470                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     1471                   .
     1472                   if buf_fbr-line.rsrv-qnty <> ?
     1473                   then do:
     1474                       assign
     1475                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1476                       .
     1477                   end.
     1478               end.
     1479               when 'спи':U
     1480               then do:
     1481                   assign
     1482                       v-sign                                  = -1
     1483                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     1484                   .
     1485                   if buf_fbr-line.rsrv-qnty <> ?
     1486                   then do:
     1487                       assign
     1488                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1489                       .
     1490                   end.
     1491               end.
     1492           end case.
     1493           assign
     1494               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     1495               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     1496               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     1497               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     1498           .
     1499       end.
     1500       run test-temp-tables in this-procedure .
     1501   end.
     1502   end procedure.
     1503   procedure fbrrep-fill-for-fbr-actp :
     1504   do
     1505   on error undo, return error
     1506   :
     1507   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1508       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1509       define buffer buf_fbr-line          for ub.fbr-line.
     1510       run fbrrep-fill-qnty-and-prices in this-procedure (
     1511           input p-fbr-doc-doc-code
     1512       ).
     1513       for each buf_temp_fbrrep-goods
     1514       :
     1515           assign
     1516               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1517               buf_temp_fbrrep-goods.sum-cost-base     = 0
     1518               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1519               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1520               buf_temp_fbrrep-goods.cost-rubl     = 0
     1521               buf_temp_fbrrep-goods.cost-base     = 0
     1522               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1523               buf_temp_fbrrep-goods.vat-cost-base = 0
     1524           .
     1525           if buf_temp_fbrrep-goods.income-qnty = 0
     1526           or buf_temp_fbrrep-goods.write-off-qnty = 0
     1527           then do:
     1528               assign
     1529                   buf_temp_fbrrep-goods.deleted   = yes
     1530                   buf_temp_fbrrep-goods.fact-qnty = 0
     1531               .
     1532           end.
     1533           else do:
     1534               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     1535               then do:
     1536                   assign
     1537                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1538                   .
     1539                   for each buf_fbr-line no-lock
     1540                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1541                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1542                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1543                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1544                        and buf_fbr-line.trn-type  = 'при':U
     1545                   :
     1546                       assign
     1547                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1548                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1549                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1550                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1551                       .
     1552                   end.
     1553                   assign
     1554                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1555                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1556                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1557                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1558                   .
     1559               end.
     1560               else do:
     1561                   assign
     1562                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1563                   .
     1564                   for each buf_fbr-line no-lock
     1565                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1566                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1567                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1568                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1569                        and buf_fbr-line.trn-type  = 'спи':U
     1570                   :
     1571                       assign
     1572                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1573                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1574                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1575                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1576                       .
     1577                   end.
     1578                   assign
     1579                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1580                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1581                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1582                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1583                   .
     1584               end.
     1585           end.
     1586       end.
     1587       for each buf_temp_fbrrep-goods
     1588          where buf_temp_fbrrep-goods.deleted = yes
     1589       on error undo, return error
     1590       :
     1591           delete buf_temp_fbrrep-goods.
     1592       end.
     1593       run test-temp-tables in this-procedure .
     1594   end.
     1595   end procedure.
     1596   procedure fbrrep-fill-for-op-del :
     1597   do
     1598   on error undo, return error
     1599   :
     1600   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1601   define input parameter p-db-remote          as logical          no-undo.
     1602       define variable v-serv-code as character    no-undo.
     1603       define variable v-in-code   as character    no-undo.
     1604       define variable v-out-code  as character    no-undo.
     1605       define variable v-trn-qnty  as decimal       no-undo.
     1606       define variable v-sign      as decimal       no-undo.
     1607       define variable v-qnty      as decimal       no-undo.
     1608       define buffer buf_fbr-doc           for ub.fbr-doc.
     1609       define buffer buf_fbr-line          for ub.fbr-line.
     1610       define buffer buf_goods             for ub.goods .
     1611       define buffer buf_doc-line          for ub.doc-line .
     1612       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     1613       run fbrrep-fill-qnty-and-prices in this-procedure (
     1614           input p-fbr-doc-doc-code
     1615       ).
     1616       for each buf_temp_fbrrep-goods
     1617       on error undo, return error
     1618       :
     1619           if buf_temp_fbrrep-goods.income-qnty <> 0
     1620           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     1621           then do:
     1622               assign
     1623                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     1624               .
     1625               if v-qnty = 0
     1626               then do:
     1627                   find first buf_fbr-line no-lock
     1628                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1629                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     1630                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     1631                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     1632                          and buf_fbr-line.fact-qnty   <> 0
     1633                   no-error.
     1634                   if available buf_fbr-line
     1635                   then do:
     1636                       assign
     1637                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     1638                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     1639                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     1640                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     1641                       .
     1642                   end.
     1643                   else do:
     1644                       assign
     1645                           buf_temp_fbrrep-goods.cost-rubl     = 0
     1646                           buf_temp_fbrrep-goods.cost-base     = 0
     1647                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1648                           buf_temp_fbrrep-goods.vat-cost-base = 0
     1649                       .
     1650                   end.
     1651               end.
     1652               else do:
     1653                   assign
     1654                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     1655                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     1656                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     1657                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     1658                   .
     1659               end.
     1660           end.
     1661           else do:
     1662               assign
     1663                   buf_temp_fbrrep-goods.cost-rubl     = 0
     1664                   buf_temp_fbrrep-goods.cost-base     = 0
     1665                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1666                   buf_temp_fbrrep-goods.vat-cost-base = 0
     1667               .
     1668           end.
     1669       end.
     1670       for each buf_temp_fbrrep-goods
     1671       :
     1672           if buf_temp_fbrrep-goods.is-waste = yes
     1673           then do:
     1674               assign
     1675                   buf_temp_fbrrep-goods.deleted = yes
     1676               .
     1677           end.
     1678           else do:
     1679               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     1680               and buf_temp_fbrrep-goods.income-qnty <> 0
     1681               then do:
     1682                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     1683                   then do:
     1684                       assign
     1685                           buf_temp_fbrrep-goods.deleted = yes
     1686                       .
     1687                   end.
     1688                   else do:
     1689                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     1690                       then do:
     1691                           assign
     1692                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     1693                               buf_temp_fbrrep-goods.income-qnty       = 0
     1694                           .
     1695                       end.
     1696                       else do:
     1697                           assign
     1698                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     1699                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     1700                           .
     1701                       end.
     1702                   end.
     1703               end.
     1704           end.
     1705       end.
     1706       for each buf_temp_fbrrep-goods
     1707          where buf_temp_fbrrep-goods.deleted = yes
     1708       on error undo, return error
     1709       :
     1710           delete buf_temp_fbrrep-goods.
     1711       end.
     1712       run test-temp-tables in this-procedure .
     1713       find first buf_fbr-doc no-lock
     1714            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     1715       .
     1716       assign
     1717           v-out-code = p-fbr-doc-doc-code
     1718       .
     1719       run doc-code in this-procedure (
     1720             input  "pair"
     1721           , input  buf_fbr-doc.obj-type
     1722           , input  buf_fbr-doc.obj-code
     1723           , input  v-out-code
     1724           , output v-in-code
     1725       ) no-error.
     1726       if error-status:error
     1727       then do:
     1728           message
     1729                    vss-workfile vss-revision vss-description
     1730               skip "Ошибка вычисления номера приходной накладной."
     1731               skip return-value
     1732               skip trim(error-status :get-message(1))
     1733                    trim(error-status :get-message(2))
     1734                    trim(error-status :get-message(3))
     1735           view-as alert-box error.
     1736           undo, return error .
     1737       end.
     1738       run doc-code in this-procedure (
     1739             input  "trio"
     1740           , input  buf_fbr-doc.obj-type
     1741           , input  buf_fbr-doc.obj-code
     1742           , input  v-in-code
     1743           , output v-serv-code
     1744       ) no-error.
     1745       if error-status:error
     1746       then do:
     1747           message
     1748                    vss-workfile vss-revision vss-description
     1749               skip "Ошибка вычисления номера накладной расхода."
     1750               skip return-value
     1751               skip trim(error-status :get-message(1))
     1752                    trim(error-status :get-message(2))
     1753                    trim(error-status :get-message(3))
     1754           view-as alert-box error.
     1755           undo, return error .
     1756       end.
     1757       for each buf_temp_fbrrep-goods
     1758       on error undo, return error
     1759       :
     1760           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     1761           then do:
     1762               find first buf_doc-line no-lock
     1763                    where buf_doc-line.doc-code  = v-in-code
     1764                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1765                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1766                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1767               no-error.
     1768               if available buf_doc-line
     1769               then do:
     1770                   assign
     1771                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     1772                   .
     1773               end.
     1774               else do:
     1775                   assign
     1776                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1777                   .
     1778               end.
     1779           end.
     1780           else do:
     1781               if buf_temp_fbrrep-goods.is-not-office = no
     1782               then do:
     1783                   find first buf_doc-line no-lock
     1784                        where buf_doc-line.doc-code  = v-serv-code
     1785                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1786                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1787                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1788                   no-error.
     1789               end.
     1790               else do:
     1791                   find first buf_doc-line no-lock
     1792                        where buf_doc-line.doc-code  = v-out-code
     1793                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1794                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1795                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1796                   no-error.
     1797               end.
     1798               if available buf_doc-line
     1799               then do:
     1800                   assign
     1801                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     1802                   .
     1803               end.
     1804               else do:
     1805                   assign
     1806                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1807                   .
     1808               end.
     1809           end.
     1810           if available buf_doc-line
     1811           then do:
     1812               define variable v-void              as decimal       no-undo.
     1813               define variable v-fact-qnty         as decimal       no-undo.
     1814               define variable v-sum-base          as decimal       no-undo.
     1815               define variable v-sum-rubl          as decimal       no-undo.
     1816               define variable v-vat-base          as decimal       no-undo.
     1817               define variable v-vat-rubl          as decimal       no-undo.
     1818               define variable v-slt-base          as decimal       no-undo.
     1819               define variable v-slt-rubl          as decimal       no-undo.
     1820               define variable v-road-tax-base     as decimal       no-undo.
     1821               define variable v-road-tax-rubl     as decimal       no-undo.
     1822               define variable v-transport-base    as decimal       no-undo.
     1823               define variable v-transport-rubl    as decimal       no-undo.
     1824               define variable v-other-base        as decimal       no-undo.
     1825               define variable v-other-rubl        as decimal       no-undo.
     1826               define variable v-excise-base       as decimal       no-undo.
     1827               define variable v-excise-rubl       as decimal       no-undo.
     1828               run r-cost in this-procedure (
     1829                     input buf_doc-line.doc-code
     1830                   , input buf_doc-line.artic
     1831                   , input buf_doc-line.prod-type
     1832                   , input buf_doc-line.prod-code
     1833                   , output v-fact-qnty
     1834                   , output v-void
     1835                   , output v-void
     1836                   , output v-sum-base
     1837                   , output v-sum-rubl
     1838                   , output v-vat-base
     1839                   , output v-vat-rubl
     1840                   , output v-slt-base
     1841                   , output v-slt-rubl
     1842                   , output v-road-tax-base
     1843                   , output v-road-tax-rubl
     1844                   , output v-transport-base
     1845                   , output v-transport-rubl
     1846                   , output v-other-base
     1847                   , output v-other-rubl
     1848                   , output v-excise-base
     1849                   , output v-excise-rubl
     1850               ).
     1851               assign
     1852                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     1853               .
     1854               assign
     1855                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     1856                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     1857                   v-sum-rubl = v-sum-rubl   * v-sign
     1858                   v-sum-base = v-sum-base   * v-sign
     1859                   v-vat-rubl = v-vat-rubl   * v-sign
     1860                   v-vat-base = v-vat-base   * v-sign
     1861                   v-fact-qnty = v-fact-qnty * v-sign
     1862               .
     1863               output to "fbrrep.txt" append .
     1864               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     1865               output close.
     1866               assign
     1867                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     1868                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     1869                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     1870                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     1871               .
     1872               if buf_temp_fbrrep-goods.fact-qnty          = 0
     1873               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1874               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     1875               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1876               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1877               then do:
     1878                   assign
     1879                       buf_temp_fbrrep-goods.deleted = yes
     1880                   .
     1881               end.
     1882           end.
     1883       end.
     1884       for each buf_temp_fbrrep-goods
     1885          where buf_temp_fbrrep-goods.deleted = yes
     1886       on error undo, return error
     1887       :
     1888           delete buf_temp_fbrrep-goods.
     1889       end.
     1890       run test-temp-tables in this-procedure .
     1891   end.
     1892   end procedure.
     1893   procedure test-temp-tables :
     1894   do
     1895   on error undo, return error
     1896   :
     1897       define variable v-str   as character     no-undo.
     1898       assign
     1899           v-str = ""
     1900       .
     1901       for each temp_fbrrep-goods
     1902       :
     1903           assign
     1904               v-str = v-str
     1905                   + chr(10) + temp_fbrrep-goods.artic
     1906                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     1907                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     1908                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     1909                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     1910                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     1911                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     1912                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     1913           .
     1914       end.
     1915       output to "fbrrep.txt" append .
     1916       put unformatted skip(2) v-str.
     1917       output close.
     1918   end.
     1919   end procedure.
     1920   procedure fbrrep-test-fbrdoc-for-fact :
     1921   do
     1922   on error undo, return error
     1923   :
     1924   define output parameter p-have-error        as logical      no-undo.
     1925       define buffer buf_fbr-line          for ub.fbr-line.
     1926       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1927       for each buf_temp_fbrrep-goods
     1928       on error undo, return error
     1929       :
     1930       end.
     1931   end.
     1932   end procedure.
     1933   procedure fbrrep-fill-qnty-and-prices-gds :
     1934   do
     1935   on error undo, return error
     1936   :
     1937   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1938   define input parameter p-gds-code           as integer      no-undo.
     1939       define variable v-sign      as decimal       no-undo.
     1940       define buffer buf_fbr-line          for ub.fbr-line.
     1941       define buffer buf_goods             for ub.goods.
     1942       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1943       find first buf_goods no-lock
     1944            where buf_goods.gds-code = p-gds-code
     1945       .
     1946       find first buf_temp_fbrrep-goods
     1947            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     1948              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     1949              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     1950       use-index ar
     1951       no-error.
     1952       if available buf_temp_fbrrep-goods
     1953       then do:
     1954           delete buf_temp_fbrrep-goods.
     1955       end.
     1956       create buf_temp_fbrrep-goods.
     1957   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1959     (input  buf_goods.artic
     1960     ,input  buf_goods.prod-type
     1961     ,input  buf_goods.prod-code
     1962     ,input  'gds-goods=request':u
     1963     ,output buf_temp_fbrrep-goods.is-not-office
     1964     )  .
     1965       assign
     1966           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     1967           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     1968           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     1969           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     1970           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     1971           buf_temp_fbrrep-goods.is-waste             = no
     1972           buf_temp_fbrrep-goods.fact-qnty            = 0
     1973           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1974           buf_temp_fbrrep-goods.write-off-qnty       = 0
     1975           buf_temp_fbrrep-goods.income-qnty          = 0
     1976           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1977           buf_temp_fbrrep-goods.cost-rubl            = 0
     1978           buf_temp_fbrrep-goods.cost-base            = 0
     1979           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1980           buf_temp_fbrrep-goods.sum-cost-base        = 0
     1981           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1982           buf_temp_fbrrep-goods.vat-cost-base        = 0
     1983           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1984           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1985           buf_temp_fbrrep-goods.price-sale           = 0
     1986           buf_temp_fbrrep-goods.deleted              = no
     1987       .
     1988   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1990     (input  p-gds-code
     1991     ,output buf_temp_fbrrep-goods.unit-base
     1992     )  .
     1993       for each buf_fbr-line no-lock
     1994          where buf_fbr-line.prod-type = buf_goods.prod-type
     1995            and buf_fbr-line.prod-code = buf_goods.prod-code
     1996            and buf_fbr-line.artic     = buf_goods.artic
     1997            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1998       on error undo, return error
     1999       :
     2000           case buf_fbr-line.trn-type
     2001           :
     2002               when 'при':U
     2003               then do:
     2004                   assign
     2005                       v-sign                                          = 1
     2006                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2007                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2008                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2009                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2010                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2011                   .
     2012                   if buf_fbr-line.rsrv-qnty <> ?
     2013                   then do:
     2014                       assign
     2015                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2016                       .
     2017                   end.
     2018               end.
     2019               when 'спи':U
     2020               then do:
     2021                   assign
     2022                       v-sign                                  = -1
     2023                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2024                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2025                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2026                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2027                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2028                   .
     2029                   if buf_fbr-line.rsrv-qnty <> ?
     2030                   then do:
     2031                       assign
     2032                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2033                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2034                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2035                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2036                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2037                       .
     2038                   end.
     2039               end.
     2040           end case.
     2041           assign
     2042               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2043               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2044               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2045               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2046               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2047               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2048               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2049               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2050               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2051               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2052           .
     2053       end.
     2054       run test-temp-tables in this-procedure .
     2055   end.
     2056   end procedure.
     2057   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   procedure doc-code:
     2059   define input  parameter parmode          as   character           no-undo.
     2060   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2061   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2062   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2063   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2064   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2065   define variable vardb-remote     as   logical             no-undo.
     2066   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2067   define variable v-delimiter as character no-undo .
     2068   do
     2069   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2070   :
     2071   find first buf_sys-ctrl no-lock .
     2072   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2073     CASE parmode:
     2074       when "main":u then do:
     2075         if vardb-remote then do:
     2076           assign
     2077             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2078         end.
     2079         else do:
     2080           assign
     2081             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2082         end.
     2083       end.
     2084       when "trio" then do:
     2085         assign
     2086           pardoc-code = replace (parroot-doc-code, "=", "*").
     2087       end.
     2088       otherwise do:
     2089         assign
     2090         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2091         no-error
     2092         .
     2093         if error-status:error  then do:
     2094           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2095                                         ,chr(10)
     2096                                         ,parmode
     2097                                         ).
     2098         end.
     2099         if num-entries(parmode) = 1
     2100         and parmode <> "chip":U
     2101         and parmode <> "chip_s":U
     2102         then do:
     2103           assign
     2104           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2105         end.
     2106         else if (lookup("chip":U, parmode) > 0
     2107                  or
     2108                  lookup("chip_s":U, parmode) > 0) then do:
     2109           assign
     2110             vartemp-doc-code = parroot-doc-code.
     2111           do while true:
     2112             if index (vartemp-doc-code , ".") = 0 then
     2113               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2114             else
     2115               vartemp-doc-code  =
     2116               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2117               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2118               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2119             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2120           end.
     2121           assign
     2122             pardoc-code = vartemp-doc-code.
     2123         end.
     2124       end.
     2125     end CASE.
     2126     if pardoc-code = '':U
     2127     or (parroot-doc-code <> '':U
     2128     and pardoc-code = parroot-doc-code) then do:
     2129       undo, return error substitute("Ошибка при генерации номера документа&1"
     2130                                     ,chr(10)).
     2131     end.
     2132   end.
     2133   end. // procedure/method
     2134   function get-doc-code-int64 returns int64
     2135     ( input p-doc-code as character ) :
     2136     define variable v-ind              as integer   no-undo .
     2137     define variable v-num-entries      as integer   no-undo .
     2138     define variable v-doc-code-int64   as int64     no-undo .
     2139     define variable v-canonic-doc-code as character no-undo .
     2140     assign
     2141       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2142       v-canonic-doc-code = p-doc-code
     2143     .
     2144     do v-ind = 1 to v-num-entries
     2145     :
     2146       assign
     2147         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2148       .
     2149     end.
     2150     assign
     2151       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2152     .
     2153     return v-doc-code-int64 .
     2154   end. // function/method
     2155   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2156   procedure cur-time :
     2157      define output parameter p-today as date      no-undo .
     2158      define output parameter p-time  as integer   no-undo .
     2159     do
     2160     on error undo, return error
     2161     :
     2162       define variable v-date1 as date      no-undo .
     2163       define variable v-date2 as date      no-undo .
     2164       define variable v-time  as integer   no-undo .
     2165       assign
     2166         v-date1 = today
     2167         v-time  = time
     2168         v-date2 = today
     2169       .
     2170       if v-date1 <> v-date2
     2171       then do:
     2172         assign
     2173           v-date1 = today
     2174           v-time  = v-time
     2175         .
     2176       end.
     2177       assign
     2178         p-today = v-date1
     2179         p-time  = v-time
     2180       .
     2181     end.
     2182   end.
     2183   function cur-time-date returns character
     2184   :
     2185     return string(today, '99/99/9999':U) .
     2186   end.
     2187   function cur-time-mjd returns decimal
     2188   :
     2189     define variable v-date as date      no-undo .
     2190     define variable v-time as integer   no-undo .
     2191     run cur-time in this-procedure
     2192       (output v-date
     2193       ,output v-time
     2194       ) .
     2195     return integer(v-date) - 2400002 + (v-time / 86400) .
     2196   end.
     2197   function cur-time-get-ending-index returns integer
     2198   (input p-number as integer
     2199   )
     2200   :
     2201     if p-number < 0
     2202     or p-number = ?
     2203     then do:
     2204       return 1 .
     2205     end.
     2206     define variable v-rest as integer   no-undo .
     2207     assign
     2208       p-number = p-number modulo 100
     2209     .
     2210     if p-number < 20
     2211     then do:
     2212       assign
     2213         v-rest = p-number
     2214       .
     2215     end.
     2216     else do:
     2217       assign
     2218         v-rest = p-number modulo 10
     2219       .
     2220     end.
     2221     case v-rest :
     2222       when 1
     2223       then do:
     2224         return 2 .
     2225       end.
     2226       when 2 or
     2227       when 3 or
     2228       when 4
     2229       then do:
     2230         return 3 .
     2231       end.
     2232       otherwise do:
     2233         return 1 .
     2234       end.
     2235     end case .
     2236   end.
     2237   procedure cur-time-mjd-to-date :
     2238      define input  parameter i-mjd-diff as decimal no-undo.
     2239      define output parameter o-Date     as date    no-undo.
     2240      define output parameter o-Time     as integer no-undo.
     2241      define variable v-day-number as integer   no-undo .
     2242      if    i-mjd-diff < 0
     2243         or i-mjd-diff = ?
     2244      then do:
     2245         return "?" .
     2246      end.
     2247      assign
     2248         v-day-number = truncate(i-mjd-diff,0).
     2249         o-Date = date(v-day-number + 2400002).
     2250         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2251     .
     2252   end.
     2253   function cur-time-mjd-to-string returns character
     2254   (input p-mjd-diff as decimal
     2255   )
     2256   :
     2257     define variable v-day-number as integer   no-undo .
     2258     define variable v-seconds    as integer   no-undo .
     2259     define variable v-hour       as integer   no-undo .
     2260     define variable v-min        as integer   no-undo .
     2261     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2262     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2263     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2264     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2265     if p-mjd-diff < 0
     2266     or p-mjd-diff = ?
     2267     then do:
     2268       return "?" .
     2269     end.
     2270     assign
     2271       v-day-number = integer(truncate(p-mjd-diff,0))
     2272       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2273     .
     2274     if v-seconds > 86400
     2275     then do:
     2276       assign
     2277         v-seconds = 86400 - 1
     2278       .
     2279     end.
     2280     if v-seconds < 0
     2281     then do:
     2282       assign
     2283         v-seconds = 0
     2284       .
     2285     end.
     2286     assign
     2287       v-hour = truncate(v-seconds / 3600, 0)
     2288     .
     2289     assign
     2290       v-seconds = v-seconds modulo 3600
     2291     .
     2292     assign
     2293       v-min = truncate(v-seconds / 60, 0)
     2294     .
     2295     assign
     2296       v-seconds = v-seconds modulo 60
     2297     .
     2298     return
     2299         (if v-day-number <> 0
     2300           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2301           else ""
     2302         )
     2303       + (if v-day-number <> 0 or v-hour <> 0
     2304           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2305           else ""
     2306         )
     2307       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2308           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2309           else ""
     2310         )
     2311       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2312       .
     2313   end.
     2314   function cur-time-string returns character
     2315   :
     2316     define variable v-date as date      no-undo .
     2317     define variable v-time as integer   no-undo .
     2318     run cur-time in this-procedure
     2319       (output v-date
     2320       ,output v-time
     2321       ) .
     2322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2323   end.
     2324   function cur-time-string-sec returns character
     2325   :
     2326     define variable v-date as date      no-undo .
     2327     define variable v-time as integer   no-undo .
     2328     run cur-time in this-procedure
     2329       (output v-date
     2330       ,output v-time
     2331       ) .
     2332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2333   end.
     2334   function cur-time-custom  returns character
     2335   (input p-prefix as character
     2336   ,input p-date-format as character
     2337   ,input p-delimiter as character
     2338   ,input p-time-format as character
     2339   ,input p-suffix as character
     2340   )
     2341   :
     2342     define variable v-date as date      no-undo .
     2343     define variable v-time as integer   no-undo .
     2344     run cur-time in this-procedure
     2345       (output v-date
     2346       ,output v-time
     2347       ) .
     2348     return
     2349       p-prefix
     2350       + string(v-date, p-date-format)
     2351       + p-delimiter
     2352       + string(v-time, p-time-format)
     2353       + p-suffix
     2354       .
     2355   end.
     2356   function cur-time-print  returns character
     2357   :
     2358     define variable v-date as date      no-undo .
     2359     define variable v-time as integer   no-undo .
     2360     run cur-time in this-procedure
     2361       (output v-date
     2362       ,output v-time
     2363       ) .
     2364     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2365   end.
     2366   function cur-time-datetime returns datetime
     2367   :
     2368     define variable v-char as character no-undo .
     2369     define variable v-datetime as datetime no-undo .
     2370     v-char = cur-time-string().
     2371     v-datetime = datetime(v-char).
     2372     return  v-datetime.
     2373   end.
     2374   function cur-time-string-msec returns character
     2375   :
     2376     define variable v-date as datetime  no-undo .
     2377     v-date = now.
     2378     return string(v-date) .
     2379   end.
     2380   define variable vss-include-info21 as character format "X(65)" no-undo
     2381   initial "@(#)$Workfile$ $Revision$".
     2382   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2383   define new global shared variable g#trdcalib as handle no-undo.
     2384   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2385     define variable v-cntxt-db-num        as integer   no-undo .
     2386     define variable v-cntxt-userid        as character no-undo .
     2387     define variable v-cntxt-level         as character no-undo .
     2388     define variable v-cntxt-host-code-obj as integer   no-undo .
     2389     define variable v-cntxt-obj-type      as character no-undo .
     2390     define variable v-cntxt-obj-code      as integer   no-undo .
     2391     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2392     define variable v-cntxt-is-admin      as logical   no-undo .
     2393       define variable v-trn-doc-code              as character        no-undo.
     2394       define variable v-free-qnty                 as decimal          no-undo.
     2395       define variable v-need-qnty                 as decimal          no-undo.
     2396       define variable v-store-obj-type            as character        no-undo.
     2397       define variable v-store-obj-code            as integer          no-undo.
     2398       define variable v-host-code                 as integer          no-undo.
     2399       define variable v-host-name                 as character        no-undo.
     2400       define variable v-base-code                 as integer          no-undo.
     2401       define variable v-down-pay                  as integer          no-undo.
     2402       define variable v-today                     as date             no-undo.
     2403       define variable v-vat-pc                    as decimal          no-undo.
     2404       define variable v-slt-pc                    as decimal          no-undo.
     2405       define variable v-prt-root                  as integer          no-undo.
     2406       define variable v-have-goods-for-inquiry    as logical          no-undo.
     2407       define variable v-is-base                   as logical          no-undo .
     2408       define variable v-fbrplnst-history-level    as integer          no-undo.
     2409       define variable v-fbrplnst-hst-upper-code   as integer          no-undo.
     2410       define variable v-upper-code                as integer          no-undo.
     2411       define variable v-db-num                    as integer      no-undo.
     2412       define buffer buf_fbr-pln       for fbr-pln.
     2413       define buffer buf_trn-doc       for trn-doc.
     2414       define buffer buf_curr-accnt    for curr-accnt.
     2415       define buffer buf_doc-line      for doc-line.
     2416       define buffer buf_gds-dtl       for gds-dtl.
     2417       define buffer buf_sysconf       for sysconf.
     2418       define buffer buf_goods         for goods.
