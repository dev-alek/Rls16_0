        1   block-level on error undo, throw.
        2   define  input parameter parparentproc        as widget-handle  no-undo.
        3   define  input parameter p-fbrhist-handle     as widget-handle  no-undo.
        4   define  input parameter p-fbrhist-upper-code as integer        no-undo.
        5   define  input parameter p-fbr-pln-doc-code   as character      no-undo.
        6   define  input parameter p-kitchen-obj-code   as integer        no-undo.
        7   define  input parameter p-fbr-doc-code       as character      no-undo.
        8   define output parameter p-doc-created        as logical        no-undo.
        9   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo initial "$Date: 2014/01/27 14:27:46 $":U .
       12   define variable vss-workfile    as character no-undo initial "$Workfile: fbrplnst.p $":U .
       13   define variable vss-archive     as character no-undo initial "$Archive: str/fbrplnst.p $":U .
       14   define variable vss-description as character no-undo initial "Создание запроса на объекте для план-меню":U .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       90   procedure partslib-clear-temp-parts :
       91     define buffer buf_temp-parts for temp-parts .
       92     do
       93     on error undo, return error
       94     :
       95       for each buf_temp-parts
       96       on error undo, return error
       97       :
       98         delete buf_temp-parts .
       99       end.
      100     end.
      101   end procedure.
      102   procedure partslib-create-temp-parts :
      103     define parameter buffer buf_parts       for ub.parts .
      104     define parameter buffer buf_temp-parts  for temp-parts .
      105     define input  parameter p-goods-twounit as logical   no-undo .
      106     define variable v-base-part-code as character no-undo .
      107     do
      108     on error undo, return error
      109     :
      110       if p-goods-twounit = true
      111       then do:
      112         assign
      113           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      114         .
      115       end.
      116       else do:
      117         assign
      118           v-base-part-code = buf_parts.part-code
      119         .
      120       end.
      121       find first buf_temp-parts exclusive-lock
      122         where buf_temp-parts.obj-type  = buf_parts.obj-type
      123           and buf_temp-parts.obj-code  = buf_parts.obj-code
      124           and buf_temp-parts.artic     = buf_parts.artic
      125           and buf_temp-parts.prod-type = buf_parts.prod-type
      126           and buf_temp-parts.prod-code = buf_parts.prod-code
      127           and buf_temp-parts.in-code   = buf_parts.in-code
      128           and buf_temp-parts.out-code  = 'free-zone':U
      129           and buf_temp-parts.part-code = v-base-part-code
      130         no-error.
      131       if not available buf_temp-parts
      132       then do:
      133         create buf_temp-parts .
      134         buffer-copy buf_parts to buf_temp-parts
      135         assign
      136           buf_temp-parts.out-code  = 'free-zone':U
      137           buf_temp-parts.part-code = v-base-part-code
      138           buf_temp-parts.rsrv-free = yes
      139           buf_temp-parts.status_   = no
      140           buf_temp-parts.qnty      = 0
      141           buf_temp-parts.fact-qnty = 0
      142           buf_temp-parts.real-qnty = 0
      143           buf_temp-parts.cli-qnty  = 0
      144         .
      145       end.
      146     end.
      147   end procedure.
      148   procedure partslib-init-temp-parts :
      149     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      150     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      151     define input parameter p-artic           like ub.parts.artic     no-undo .
      152     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      153     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      154     define buffer buf_parts      for ub.parts .
      155     define buffer buf_temp-parts for temp-parts .
      156     define variable v-goods-twounit    as logical   no-undo .
      157     do
      158     on error undo, return error
      159     :
      160   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      162     (input  p-artic
      163     ,input  p-prod-type
      164     ,input  p-prod-code
      165     ,input  'twounit=request':u
      166     ,output v-goods-twounit
      167     ) no-error .
      168       if error-status :error
      169       then do:
      170         message
      171           vss-workfile vss-revision vss-description skip
      172           vss-include-info0 skip
      173           "Ошибка при определении атрибута товара" skip
      174           "Артикул" p-artic p-prod-type p-prod-code skip
      175           "twounit=request" skip
      176           error-status :get-message(1) skip
      177           return-value skip
      178           view-as alert-box error .
      179         undo, return error return-value .
      180       end.
      181       run partslib-clear-temp-parts in this-procedure .
      182       for each buf_parts
      183         where buf_parts.obj-type  = p-obj-type
      184           and buf_parts.obj-code  = p-obj-code
      185           and buf_parts.artic     = p-artic
      186           and buf_parts.prod-type = p-prod-type
      187           and buf_parts.prod-code = p-prod-code
      188           and buf_parts.rsrv-free = yes
      189           and buf_parts.status_   = no
      190           and buf_parts.in-code   <> buf_parts.out-code
      191       on error undo, return error
      192       :
      193         run partslib-create-temp-parts in this-procedure
      194           (buffer buf_parts
      195           ,buffer buf_temp-parts
      196           ,input  v-goods-twounit
      197           ) .
      198         define variable v-parts-qnty          as decimal   no-undo .
      199         define variable v-parts-cli-qnty      as decimal   no-undo .
      200         define variable v-parts-free-qnty     as decimal   no-undo .
      201         define variable v-parts-free-cli-qnty as decimal   no-undo .
      202         if buf_parts.out-code = 'free-zone':U
      203         then do:
      204           assign
      205             v-parts-qnty          = buf_parts.qnty
      206             v-parts-cli-qnty      = buf_parts.cli-qnty
      207             v-parts-free-qnty     = buf_parts.qnty
      208             v-parts-free-cli-qnty = buf_parts.cli-qnty
      209           .
      210         end.
      211         else do:
      212           assign
      213             v-parts-qnty          = abs(buf_parts.qnty)
      214             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      215             v-parts-free-qnty     = 0
      216             v-parts-free-cli-qnty = 0
      217           .
      218         end.
      219         assign
      220           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      221           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      222           buf_temp-parts.real-qnty     = 0
      223           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      224           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      225           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      226         .
      227       end.
      228     end.
      229   end procedure.
      230   procedure partslib-init-temp-parts-by-factord :
      231     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      232     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      233     define input parameter p-artic              like ub.parts.artic     no-undo .
      234     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      235     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      236     define input parameter p-fact-order         as decimal   no-undo .
      237     define input parameter p-include-fact-order as logical   no-undo .
      238     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      239     define buffer buf_gds-obj  for ub.gds-obj .
      240     do
      241     on error undo, return error
      242     :
      243       do transaction
      244       on error undo, return error
      245       :
      246   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      248     (input  p-obj-type
      249     ,input  p-obj-code
      250     ,input  p-artic
      251     ,input  p-prod-type
      252     ,input  p-prod-code
      253     ,buffer buf_gds-obj
      254     ) no-error .
      255         if error-status :error
      256         then do:
      257           message
      258             vss-workfile vss-revision vss-description skip
      259             vss-include-info0 skip
      260             "Невозможно найти товар на объекте" skip
      261             "Объект" p-obj-type p-obj-code skip
      262             "Артикул" p-artic p-prod-type p-prod-code skip
      263             error-status :get-message(1) skip
      264             return-value skip
      265             view-as alert-box error .
      266           undo, return error .
      267         end.
      268         find current buf_gds-obj exclusive-lock .
      269       end.
      270       run partslib-init-temp-parts in this-procedure
      271         (input p-obj-type
      272         ,input p-obj-code
      273         ,input p-artic
      274         ,input p-prod-type
      275         ,input p-prod-code
      276         ) no-error .
      277       if error-status :error
      278       then do:
      279         message
      280           vss-workfile vss-revision vss-description skip
      281           vss-include-info0 skip
      282           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      283           "Объект" p-obj-type p-obj-code skip
      284           "Артикул" p-artic p-prod-type p-prod-code skip
      285           "p-fact-order" p-fact-order skip
      286           view-as alert-box error .
      287         undo, return error .
      288       end.
      289       if p-include-fact-order = true
      290       then do:
      291         assign
      292           p-fact-order = p-fact-order - 0.0000000001
      293         .
      294       end.
      295       define variable v-max-fact-order as character no-undo .
      296       run factord-max-fact-order in this-procedure
      297         (output v-max-fact-order
      298         ) no-error .
      299       if error-status :error
      300       then do:
      301         message
      302           vss-workfile vss-revision vss-description skip
      303           vss-include-info0 skip
      304           "Ошибка при вызове процедуры factord-max-fact-order" skip
      305           "Объект" p-obj-type p-obj-code skip
      306           "Артикул" p-artic p-prod-type p-prod-code skip
      307           "p-fact-order" p-fact-order skip
      308           view-as alert-box error .
      309         undo, return error .
      310       end.
      311       run partslib-update-by-factord in this-procedure
      312         (input p-obj-type
      313         ,input p-obj-code
      314         ,input p-artic
      315         ,input p-prod-type
      316         ,input p-prod-code
      317         ,input p-fact-order
      318         ,input v-max-fact-order
      319         ,input false
      320         ) no-error .
      321       if error-status :error
      322       then do:
      323         message
      324           vss-workfile vss-revision vss-description skip
      325           vss-include-info0 skip
      326           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      327           "Объект" p-obj-type p-obj-code skip
      328           "Артикул" p-artic p-prod-type p-prod-code skip
      329           "p-fact-order" p-fact-order skip
      330           "v-max-fact-order" v-max-fact-order skip
      331           view-as alert-box error .
      332         undo, return error .
      333       end.
      334     end.
      335   end procedure.
      336   procedure partslib-update-by-factord :
      337     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      338     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      339     define input parameter p-artic              like ub.parts.artic     no-undo .
      340     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      341     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      342     define input parameter p-start-fact-order   as decimal   no-undo .
      343     define input parameter p-end-fact-order     as decimal   no-undo .
      344     define input parameter p-lock-gds-obj       as logical   no-undo .
      345     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      346     define buffer buf_gds-obj  for ub.gds-obj .
      347     define buffer buf_doc-line for ub.doc-line .
      348     define variable v-total-parts-qnty as decimal   no-undo .
      349     define variable v-goods-gds-goods  as logical   no-undo .
      350     define variable v-goods-twounit    as logical   no-undo .
      351     do
      352     on error undo, return error
      353     :
      354       if p-start-fact-order > p-end-fact-order
      355       then do:
      356         message
      357           vss-workfile vss-revision vss-description skip
      358           vss-include-info0 skip
      359           "Ошибка задания входных параметров" skip
      360           "Начало интервала превышает конец интервала" skip
      361           "Объект" p-obj-type p-obj-code skip
      362           "Артикул" p-artic p-prod-type p-prod-code skip
      363           "p-start-fact-order" p-start-fact-order skip
      364           "p-end-fact-order"   p-end-fact-order skip
      365           view-as alert-box error .
      366         undo, return error .
      367       end.
      368       if p-lock-gds-obj = true
      369       then do:
      370         do transaction
      371         on error undo, return error
      372         :
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      375     (input  p-obj-type
      376     ,input  p-obj-code
      377     ,input  p-artic
      378     ,input  p-prod-type
      379     ,input  p-prod-code
      380     ,buffer buf_gds-obj
      381     ) no-error .
      382           if error-status :error
      383           then do:
      384             message
      385               vss-workfile vss-revision vss-description skip
      386               vss-include-info0 skip
      387               "Невозможно найти gds-obj" skip
      388               error-status :get-message(1) skip
      389               return-value skip
      390               view-as alert-box error .
      391             undo, return error .
      392           end.
      393           find current buf_gds-obj exclusive-lock .
      394         end.
      395       end.
      396   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      398     (input  p-artic
      399     ,input  p-prod-type
      400     ,input  p-prod-code
      401     ,input  'gds-goods=request':u
      402     ,output v-goods-gds-goods
      403     ) no-error .
      404       if error-status :error
      405       then do:
      406         message
      407           vss-workfile vss-revision vss-description skip
      408           vss-include-info0 skip
      409           "Ошибка при определении атрибута товара" skip
      410           "Артикул" p-artic p-prod-type p-prod-code skip
      411           "gds-goods=request" skip
      412           error-status :get-message(1) skip
      413           return-value skip
      414           view-as alert-box error .
      415         undo, return error return-value .
      416       end.
      417   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      419     (input  p-artic
      420     ,input  p-prod-type
      421     ,input  p-prod-code
      422     ,input  'twounit=request':u
      423     ,output v-goods-twounit
      424     ) no-error .
      425       if error-status :error
      426       then do:
      427         message
      428           vss-workfile vss-revision vss-description skip
      429           vss-include-info0 skip
      430           "Ошибка при определении атрибута товара" skip
      431           "Артикул" p-artic p-prod-type p-prod-code skip
      432           "twounit=request" skip
      433           error-status :get-message(1) skip
      434           return-value skip
      435           view-as alert-box error .
      436         undo, return error return-value .
      437       end.
      438       for each buf_doc-line no-lock
      439         where buf_doc-line.obj-type   = p-obj-type
      440           and buf_doc-line.obj-code   = p-obj-code
      441           and buf_doc-line.artic      = p-artic
      442           and buf_doc-line.prod-type  = p-prod-type
      443           and buf_doc-line.prod-code  = p-prod-code
      444           and buf_doc-line.status_    = 'факт':U
      445           and buf_doc-line.fact-order > p-start-fact-order
      446           and buf_doc-line.fact-order <= p-end-fact-order
      447       on error undo, return error
      448       :
      449         run partslib-process-document in this-procedure
      450           (input  buf_doc-line.doc-code
      451           ,input  p-obj-type
      452           ,input  p-obj-code
      453           ,input  p-artic
      454           ,input  p-prod-type
      455           ,input  p-prod-code
      456           ,input  v-goods-gds-goods
      457           ,input  v-goods-twounit
      458           ,output v-total-parts-qnty
      459           ) no-error .
      460         if error-status :error
      461         then do:
      462           message
      463             vss-workfile vss-revision vss-description skip
      464             vss-include-info0 skip
      465             "Ошибка при вызове процедуры partslib-process-document" skip
      466             "Документ" buf_doc-line.doc-code skip
      467             "Объект" p-obj-type p-obj-code skip
      468             "Артикул" p-artic p-prod-type p-prod-code skip
      469             "p-start-fact-order" p-start-fact-order skip
      470             "p-end-fact-order" p-end-fact-order skip
      471             error-status :get-message(1) skip
      472             return-value skip
      473             view-as alert-box error .
      474           undo, return error return-value .
      475         end.
      476       end.
      477     end.
      478   end procedure.
      479   procedure partslib-process-document :
      480     define input  parameter p-doc-code         as character no-undo .
      481     define input  parameter p-obj-type         as character no-undo .
      482     define input  parameter p-obj-code         as integer   no-undo .
      483     define input  parameter p-artic            as character no-undo .
      484     define input  parameter p-prod-type        as character no-undo .
      485     define input  parameter p-prod-code        as integer   no-undo .
      486     define input  parameter p-goods-gds-goods  as logical   no-undo .
      487     define input  parameter p-goods-twounit    as logical   no-undo .
      488     define output parameter p-total-parts-qnty as decimal   no-undo .
      489     define variable v-parts-sign as integer   no-undo .
      490     define buffer buf_trn-doc    for ub.trn-doc .
      491     define buffer buf_doc-line   for ub.doc-line .
      492     define buffer buf_parts      for ub.parts .
      493     define buffer buf_temp-parts for temp-parts .
      494     do
      495     on error undo, return error return-value
      496     :
      497       find first buf_trn-doc no-lock
      498         where buf_trn-doc.doc-code = p-doc-code
      499         no-error .
      500       if not available buf_trn-doc
      501       then do:
      502         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      503                                      ,p-doc-code
      504                                      ) .
      505       end.
      506       case buf_trn-doc.doc-type
      507       :
      508         when 'при':U or
      509         when 'возврат':U or
      510         when 'инв':U
      511         then do:
      512           assign
      513             v-parts-sign = -1
      514           .
      515         end.
      516         when 'рас':U or
      517         when 'спи':U
      518         then do:
      519           assign
      520             v-parts-sign = 1
      521           .
      522         end.
      523         otherwise do:
      524           undo, return error substitute("Неизвестный тип документа &1"
      525                                       ,buf_trn-doc.doc-type
      526                                       ) .
      527         end.
      528       end.
      529       find first buf_doc-line no-lock
      530         where buf_doc-line.doc-code  = p-doc-code
      531           and buf_doc-line.artic     = p-artic
      532           and buf_doc-line.prod-type = p-prod-type
      533           and buf_doc-line.prod-code = p-prod-code
      534         no-error .
      535       if not available buf_doc-line
      536       then do:
      537         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      538                                      ,p-doc-code
      539                                      ,artic
      540                                      ,prod-type
      541                                      ,prod-code
      542                                      ) .
      543       end.
      544       assign
      545         p-total-parts-qnty = 0
      546       .
      547       if p-goods-gds-goods = true
      548       then do:
      549         for each buf_parts no-lock
      550           where buf_parts.out-code  = p-doc-code
      551             and buf_parts.obj-type  = p-obj-type
      552             and buf_parts.obj-code  = p-obj-code
      553             and buf_parts.artic     = p-artic
      554             and buf_parts.prod-type = p-prod-type
      555             and buf_parts.prod-code = p-prod-code
      556         on error undo, return error
      557         :
      558           run partslib-create-temp-parts in this-procedure
      559             (buffer buf_parts
      560             ,buffer buf_temp-parts
      561             ,input  p-goods-twounit
      562             ) .
      563           assign
      564             p-total-parts-qnty        = p-total-parts-qnty
      565                                       + v-parts-sign * buf_parts.fact-qnty
      566             buf_temp-parts.qnty       = buf_temp-parts.qnty
      567                                       + v-parts-sign * buf_parts.fact-qnty
      568             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      569                                       + v-parts-sign * buf_parts.fact-qnty
      570             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      571                                       + v-parts-sign * buf_parts.cli-qnty
      572           .
      573           if buf_temp-parts.qnty = 0
      574           then do:
      575             delete buf_temp-parts .
      576           end.
      577         end.
      578       end.
      579       else do:
      580         assign
      581           p-total-parts-qnty = p-total-parts-qnty
      582                              + v-parts-sign * buf_doc-line.fact-qnty
      583         .
      584       end.
      585     end.
      586   end procedure.
      587   procedure partslib-init-temp-parts-by-date :
      588     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      589     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      590     define input parameter p-artic           like ub.parts.artic     no-undo .
      591     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      592     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      593     define input parameter p-fact-date       as date      no-undo .
      594     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      595     do
      596     on error undo, return error
      597     :
      598       define variable v-fact-order                as decimal   no-undo .
      599       define variable v-shift-end-fact-order      as decimal   no-undo .
      600       define variable v-day-end-fact-order        as decimal   no-undo .
      601       run factord in this-procedure
      602         (input  p-fact-date
      603         ,input  1
      604         ,input  1
      605         ,input  ?
      606         ,input  0
      607         ,input  false
      608         ,output v-fact-order
      609         ,output v-shift-end-fact-order
      610         ,output v-day-end-fact-order
      611         ) no-error .
      612       if error-status :error
      613       then do:
      614         message
      615           vss-workfile vss-revision vss-description skip
      616           vss-include-info0 skip
      617           "Ошибка при определении момента времени, на который требуется остаток" skip
      618           "Объект" p-obj-type p-obj-code skip
      619           "Артикул" p-artic p-prod-type p-prod-code skip
      620           "Дата" p-fact-date skip
      621           view-as alert-box error .
      622         undo, return error .
      623       end.
      624       run partslib-init-temp-parts-by-factord in this-procedure
      625         (input p-obj-type
      626         ,input p-obj-code
      627         ,input p-artic
      628         ,input p-prod-type
      629         ,input p-prod-code
      630         ,input v-day-end-fact-order
      631         ,input false
      632         ) no-error .
      633       if error-status :error
      634       then do:
      635         message
      636           vss-workfile vss-revision vss-description skip
      637           vss-include-info0 skip
      638           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      639           "Объект" p-obj-type p-obj-code skip
      640           "Артикул" p-artic p-prod-type p-prod-code skip
      641           "Дата" p-fact-date skip
      642           view-as alert-box error .
      643         undo, return error .
      644       end.
      645     end.
      646   end procedure.
      647   procedure partslib-calc-cost :
      648     define output parameter p-fact-qnty      as decimal   no-undo .
      649     define output parameter p-vat-pc         as decimal   no-undo .
      650     define output parameter p-slt-pc         as decimal   no-undo .
      651     define output parameter p-sum-base       as decimal   no-undo .
      652     define output parameter p-sum-rubl       as decimal   no-undo .
      653     define output parameter p-vat-base       as decimal   no-undo .
      654     define output parameter p-vat-rubl       as decimal   no-undo .
      655     define output parameter p-slt-base       as decimal   no-undo .
      656     define output parameter p-slt-rubl       as decimal   no-undo .
      657     define output parameter p-road-tax-base  as decimal   no-undo .
      658     define output parameter p-road-tax-rubl  as decimal   no-undo .
      659     define output parameter p-transport-base as decimal   no-undo .
      660     define output parameter p-transport-rubl as decimal   no-undo .
      661     define output parameter p-other-base     as decimal   no-undo .
      662     define output parameter p-other-rubl     as decimal   no-undo .
      663     define output parameter p-excise-base    as decimal   no-undo .
      664     define output parameter p-excise-rubl    as decimal   no-undo .
      665     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      666     do
      667     on error undo, return error return-value
      668     :
      669       define buffer buf_temp-parts for temp-parts .
      670       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      671       define buffer   in-vatp-parts    for ub.parts   .
      672       define buffer   in-vatp-doc      for ub.trn-doc .
      673       define buffer   in-vatp-goods    for ub.goods   .
      674       define buffer   in-vatp-sysconf  for ub.sysconf .
      675       define buffer   in-vatp_doc-attr for ub.doc-attr.
      676       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      677       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      678       define variable varinvprb                  as   character              no-undo.
      679       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      680       define variable cli-base-rate              as   decimal                no-undo.
      681       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      682       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      683       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      684       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      685       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      686       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      687       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      688       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      689       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      690       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      691       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      692       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      693       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      694       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      695       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      696       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      697       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      698       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      699       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      700       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      701       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      702       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      703       define variable varinvatp-envd             as   character              no-undo.
      704       define variable varinvatp-type             as   character              no-undo.
      705       for each buf_temp-parts
      706       on error undo, return error
      707       :
      708   assign
      709     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      710     price-base-with-tax-loc = buf_temp-parts.price-base
      711   .
      712   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      714     (output varinvprb
      715     )  .
      716     if buf_temp-parts.out-code = 'free-zone':U     or
      717        buf_temp-parts.out-code = 'out-zone':U   or
      718        buf_temp-parts.doc-type = 'акт':U then do:
      719       assign
      720         in-vatp-have-vat-slt = yes.
      721     end.
      722     else do:
      723       find first in-vatp_doc-attr no-lock
      724         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      725           and in-vatp_doc-attr.attr-code = 'envd':U
      726         no-error .
      727       if not available in-vatp_doc-attr then do:
      728         assign
      729           in-vatp-have-vat-slt = yes.
      730       end.
      731       else do:
      732            in-vatp-have-vat-slt = no.
      733       end.
      734     end.
      735     assign
      736      price-cli-with-tax-loc = buf_temp-parts.price-cli
      737      cli-base-rate          = buf_temp-parts.cli-base-rate.
      738     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      739              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      740     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      741             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      742             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      743             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      744             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      745             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      746             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      747       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      748     assign
      749       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      750     assign
      751       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      752       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      753       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      754       transport-cli-loc  = 0
      755       other-cli-loc      = 0
      756     .
      757   ASSIGN
      758             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      759       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      760   .
      761         assign
      762           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      763           p-vat-pc         = p-vat-pc         + vat-pc-loc
      764           p-slt-pc         = p-slt-pc         + slt-pc-loc
      765           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      766           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      767           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      768           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      769           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      770           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      771           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      772           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      773           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      774           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      775           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      776           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      777           p-excise-base    = p-excise-base    + 0
      778           p-excise-rubl    = p-excise-rubl    + 0
      779         .
      780       end.
      781       if p-fact-qnty      = ?
      782       or p-sum-base       = ?
      783       or p-sum-rubl       = ?
      784       or p-vat-base       = ?
      785       or p-vat-rubl       = ?
      786       or p-slt-base       = ?
      787       or p-slt-rubl       = ?
      788       or p-road-tax-base  = ?
      789       or p-road-tax-rubl  = ?
      790       or p-transport-base = ?
      791       or p-transport-rubl = ?
      792       or p-other-base     = ?
      793       or p-other-rubl     = ?
      794       or p-excise-base    = ?
      795       or p-excise-rubl    = ?
      796       then do:
      797         message
      798           vss-workfile vss-revision vss-description skip
      799           vss-include-info0 skip
      800           "Программа in-vatp.i вернула неопределенные значения" skip
      801           "p-fact-qnty"      p-fact-qnty      skip
      802           "p-sum-base"       p-sum-base       skip
      803           "p-sum-rubl"       p-sum-rubl       skip
      804           "p-vat-base"       p-vat-base       skip
      805           "p-vat-rubl"       p-vat-rubl       skip
      806           "p-slt-base"       p-slt-base       skip
      807           "p-slt-rubl"       p-slt-rubl       skip
      808           "p-road-tax-base"  p-road-tax-base  skip
      809           "p-road-tax-rubl"  p-road-tax-rubl  skip
      810           "p-transport-base" p-transport-base skip
      811           "p-transport-rubl" p-transport-rubl skip
      812           "p-other-base"     p-other-base     skip
      813           "p-other-rubl"     p-other-rubl     skip
      814           "p-excise-base"    p-excise-base    skip
      815           "p-excise-rubl"    p-excise-rubl    skip
      816           view-as alert-box error .
      817         undo, return error .
      818       end.
      819     end.
      820   end procedure.
      821   procedure fbrrest-get-free-qnty :
      822   do
      823   on error undo, return error
      824   :
      825   define input parameter p-obj-type       as character            no-undo.
      826   define input parameter p-obj-code       as integer              no-undo.
      827   define input parameter p-gds-code       as integer              no-undo.
      828   define input parameter p-autofbr        as logical              no-undo.
      829   define output parameter p-avail-qnty    as decimal              no-undo.
      830       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
      831       define variable v-free-qnty as decimal       no-undo.
      832       define buffer buf_goods         for ub.goods.
      833       define buffer buf_gds-obj       for ub.gds-obj.
      834       define buffer buf_temp-parts    for temp-parts.
      835       find first buf_goods no-lock
      836            where buf_goods.gds-code = p-gds-code
      837       .
      838       assign
      839           p-avail-qnty = 0
      840       .
      841       run partslib-init-temp-parts in this-procedure (
      842             input p-obj-type
      843           , input p-obj-code
      844           , input buf_goods.artic
      845           , input buf_goods.prod-type
      846           , input buf_goods.prod-code
      847       ).
      848       assign
      849           v-free-qnty = 0
      850       .
      851       for each buf_temp-parts
      852       on error undo, return error
      853       :
      854           if buf_temp-parts.qnty > 0
      855           then do:
      856               assign
      857                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
      858               .
      859           end.
      860       end.
      861       assign
      862           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
      863       .
      864   end.
      865   end procedure.
      866   procedure fbrrest-get-catering-object :
      867   do
      868   on error undo, return error
      869   :
      870   define input parameter p-obj-code            as integer      no-undo.
      871   define output parameter p-catering-obj-type  as character    no-undo.
      872   define output parameter p-catering-obj-code  as integer      no-undo.
