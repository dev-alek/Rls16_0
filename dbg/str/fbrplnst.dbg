     1151      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1152                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1153                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1154      if (not buf_trn-doc.internal and
     1155              buf_trn-doc.doc-type = 'при':U) or
