        1   define input  parameter parparentproc as   handle              no-undo .
        2   define input  parameter parobj-type   like ub.clients.obj-type no-undo.
        3   define input  parameter parobj-code   like ub.clients.obj-code no-undo.
        4   define output parameter parrec-id     as   recid initial ?     no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Диалог на добавление пистолета ТРК".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable varmes-log as logical no-undo.
      126   define variable varobj-type like ub.clients.obj-type no-undo.
      127   define variable varobj-code like ub.clients.obj-code no-undo.
      128   define variable varbuttons  as   character        no-undo.
      129   define variable varps-upd   as   logical          no-undo.
      130   procedure pumpnzav:
      131   define input parameter parobj-type    like ub.clients.obj-type    no-undo.
      132   define input parameter parobj-code    like ub.clients.obj-code    no-undo.
      133   define input parameter parpump-code   like ub.pump.pump-code      no-undo.
      134   define input parameter parnozzle-code like ub.nozzle.nozzle-code  no-undo.
      135   define input parameter paris-meas     like ub.pump-nozzle.is-meas no-undo.
      136   define input parameter paref-nid      like ub.pump-nozzle.ef-nid no-undo.
      137   define buffer bf_clients     for ub.clients.
      138   define buffer bf_pump        for ub.pump.
      139   define buffer bf_nozzle      for ub.nozzle.
      140   define buffer bf_pump-nozzle for ub.pump-nozzle.
      141   define buffer bf_rvs-doc     for ub.rvs-doc.
      142   define buffer bf_icnt-doc    for ub.icnt-doc.
      143   find first bf_clients where bf_clients.obj-type = parobj-type and
      144                               bf_clients.obj-code = parobj-code no-lock no-error.
      145   if not available bf_clients then
      146      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      147   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      148                            bf_pump.obj-code  = parobj-code  and
      149                            bf_pump.pump-code = parpump-code no-lock no-error.
      150   if not available bf_pump then
      151      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      152   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      153                              bf_nozzle.obj-code    = parobj-code    and
      154                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      155   if not available bf_nozzle then
      156      return error SUBSTITUTE("Нет пистолета ТРК с номером &1", parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      157    find first bf_rvs-doc where bf_rvs-doc.obj-type =  parobj-type       and
      158                                bf_rvs-doc.obj-code =  parobj-code       and
      159                                bf_rvs-doc.status_  <> 'факт':U           and
      160                                bf_rvs-doc.rvs-type <> 'перед_док':U and
      161                                bf_rvs-doc.rvs-type <> 'после_док':U  and
      162                                bf_rvs-doc.rvs-type <> 'проверка':U       no-lock no-error.
      163   if available bf_rvs-doc then do:
      164      return error SUBSTITUTE("На объекте есть открытый документ сверки &1 .", bf_rvs-doc.rvs-code).
      165   end.
      166   find first bf_icnt-doc where bf_icnt-doc.obj-type  =  parobj-type and
      167                                bf_icnt-doc.obj-code  =  parobj-code and
      168                                bf_icnt-doc.status_   <> 'факт':U     no-lock no-error.
      169   if available bf_icnt-doc then do:
      170      return error SUBSTITUTE("На объекте есть открытый документ инвентаризации счетчиков ТРК &1 .", bf_icnt-doc.doc-code).
      171   end.
      172   find first bf_pump-nozzle where bf_pump-nozzle.obj-type    = parobj-type    and
      173                                   bf_pump-nozzle.obj-code    = parobj-code    and
      174                                   bf_pump-nozzle.pump-code   = parpump-code   and
      175                                   bf_pump-nozzle.nozzle-code = parnozzle-code no-lock no-error.
      176   if available bf_pump-nozzle then
      177                return error SUBSTITUTE ("Уже есть запись ТРК-пистолет с номером ТРК &1 и номером пистолета &2", parpump-code, parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      178   create bf_pump-nozzle.
      179   assign bf_pump-nozzle.obj-type    = parobj-type
      180          bf_pump-nozzle.obj-code    = parobj-code
      181          bf_pump-nozzle.pump-code   = parpump-code
      182          bf_pump-nozzle.nozzle-code = parnozzle-code
      183          bf_pump-nozzle.is-meas     = paris-meas
      184          bf_pump-nozzle.ef-nid      = paref-nid
      185          .
      186   end procedure.
      187   define variable is-ef-chr as character no-undo .
      188   define variable var-type as character no-undo .
      189   define variable is-ef as logical no-undo .
      190   DEFINE BUTTON b-cancel AUTO-END-KEY
      191        LABEL "&Отмена"
      192        SIZE 10 BY 1
      193        BGCOLOR 8 .
      194   DEFINE BUTTON b-help
      195        LABEL "Помо&щь"
      196        SIZE 10 BY 1
      197        BGCOLOR 8 .
      198   DEFINE BUTTON b-nozzle
      199        IMAGE-UP FILE "btn-down-arrow":U
      200        IMAGE-DOWN FILE "btn-down-arrow":U
      201        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      202        LABEL "b-nozzle"
      203        SIZE 3 BY .87.
      204   DEFINE BUTTON b-pump
      205        IMAGE-UP FILE "btn-down-arrow":U
      206        IMAGE-DOWN FILE "btn-down-arrow":U
      207        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      208        LABEL ""
      209        SIZE 3 BY .87.
      210   DEFINE BUTTON b-save AUTO-GO
      211        LABEL "&Ввод"
      212        SIZE 10 BY 1
      213        BGCOLOR 8 .
      214   DEFINE VARIABLE varef-nid AS CHARACTER FORMAT "X(256)":U
      215        LABEL "Идентиф. EasyFuel"
      216        VIEW-AS FILL-IN
      217        SIZE 9 BY 1 NO-UNDO.
      218   DEFINE VARIABLE varnozzle-code AS INTEGER FORMAT ">9":U INITIAL 0
      219        LABEL "Номер пистолета ТРК"
      220        VIEW-AS FILL-IN
      221        SIZE 3 BY 1 NO-UNDO.
      222   DEFINE VARIABLE varpump-code AS INTEGER FORMAT ">9":U INITIAL 0
      223        LABEL "Номер ТРК"
      224        VIEW-AS FILL-IN
      225        SIZE 3 BY 1 NO-UNDO.
      226   DEFINE VARIABLE varis-meas AS LOGICAL INITIAL yes
      227        LABEL "Измеряется"
      228        VIEW-AS TOGGLE-BOX
      229        SIZE 23.9 BY .83 NO-UNDO.
      230   DEFINE FRAME Dialog-Frame
      231        b-save AT ROW 1 COL 1
      232        b-cancel AT ROW 1 COL 11
      233        b-help AT ROW 1 COL 21
      234        varpump-code AT ROW 2.63 COL 22.1 COLON-ALIGNED
      235        b-pump AT ROW 2.67 COL 27.8
      236        varnozzle-code AT ROW 4.2 COL 3.1
      237        b-nozzle AT ROW 4.2 COL 27.8
      238        varis-meas AT ROW 5.57 COL 3.5
      239        varef-nid AT ROW 6.87 COL 18 COLON-ALIGNED WIDGET-ID 2
      240        SPACE(4.29) SKIP(0.42)
      241       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      242            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      243            TITLE "Добавление  ТРК-пистолет"
      244            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      245   ASSIGN
      246          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      247          FRAME Dialog-Frame:HIDDEN           = TRUE.
      248   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      249   DO:
      250     APPLY "END-ERROR":U TO SELF.
      251   END.
      252   ON CHOOSE OF b-nozzle IN FRAME Dialog-Frame
      253   DO:
      254     define variable varrec-id_nozzle as recid initial ? no-undo.
      255     define buffer bf_nozzle for ub.nozzle.
      256     run str/nozzlerf.w
      257       ( input  parparentproc
      258        ,input  parobj-type
      259        ,input  parobj-code
      260        ,output varrec-id_nozzle
      261       ).
      262     if varrec-id_nozzle <> ? then do:
      263        find first bf_nozzle where recid(bf_nozzle) = varrec-id_nozzle no-lock no-error.
      264        if available bf_nozzle then do:
      265           display bf_nozzle.nozzle-code @ varnozzle-code with frame Dialog-Frame.
      266        end.
      267     end.
      268   END.
      269   ON CHOOSE OF b-pump IN FRAME Dialog-Frame
      270   DO:
      271     define variable varrec-id_pump as recid initial ? no-undo.
      272     define buffer bf_pump for ub.pump.
      273     run str/pumprf.w
      274       ( input parparentproc
      275        ,input  parobj-type
      276        ,input  parobj-code
      277        ,output varrec-id_pump
      278       ).
      279     if varrec-id_pump <> ? then do:
      280        find first bf_pump where recid(bf_pump) = varrec-id_pump no-lock no-error.
      281        if available bf_pump then do:
      282           display bf_pump.pump-code @ varpump-code with frame Dialog-Frame.
      283        end.
      284     end.
      285   END.
      286   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      287   DO:
      288   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   if lookup(self :type
      290            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      291            ) = 0
      292   then do:
      293     message
      294       "$Workfile$"
      295       "Указанному интерфейсному элементу фокус не может быть передан" skip
      296       "Интерфейсный элемент" self :name  skip
      297       "Тип" self :type  skip
      298       "Процедура" this-procedure :file-name skip
      299       view-as alert-box .
      300   end.
      301   else do:
      302     apply "entry":u to self  .
      303     if focus :handle <> self :handle  then do:
      304       return no-apply .
      305     end.
      306   end.
      307     assign frame Dialog-Frame varpump-code varnozzle-code varis-meas.
      308     if is-ef then do:
      309     assign
      310     varef-nid.
      311     end.
      312     run pumpnzav in this-procedure ( input parobj-type
      313                                      ,input parobj-code
      314                                      ,input varpump-code
      315                                      ,input varnozzle-code
      316                                      ,input varis-meas
      317                                      ,input varef-nid
      318                         ) no-error.
      319     if error-status:error then do:
      320   message
      321     vss-workfile vss-revision vss-description skip
      322     "Ошибка при создании записи ТРК-пистолет" skip
      323     "-----------Cистемная ошибка------------" skip
      324     return-value skip
      325     "------Ошибка исполнения программы------" skip
      326     trim(error-status :get-message(1)) +
      327     trim(error-status :get-message(2)) +
      328     trim(error-status :get-message(3)) +
      329     trim(error-status :get-message(4)) +
      330     trim(error-status :get-message(5)) skip
      331     view-as alert-box error .
      332        return no-apply.
      333     end.
      334     find first ub.pump-nozzle where ub.pump-nozzle.obj-type    = parobj-type    and
      335                                  ub.pump-nozzle.obj-code    = parobj-code    and
      336                                  ub.pump-nozzle.pump-code   = varpump-code   and
      337                                  ub.pump-nozzle.nozzle-code = varnozzle-code no-lock.
      338     assign parrec-id = recid(ub.pump-nozzle).
      339   END.
      340   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      341   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      342   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   on help of frame Dialog-Frame
      344   do:
      345     run gbl/app_help.p
      346       (input this-procedure :file-name
      347       ,input ''
      348       ,input ?
      349       ) no-error.
      350     if error-status :error then do:
      351       message
      352         "Ошибка при вызове помощи"
      353         error-status :get-message(1)
      354         view-as alert-box .
      355     end.
      356   end.
      357   run minbtn-set in this-procedure .
      358   on choose of b-help in frame Dialog-Frame
      359   do:
      360     apply "help":u to frame Dialog-Frame .
      361   end.
      362   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure minbtn-set :
      364       do
      365           on error undo, return error return-value
      366           :
      367           define variable ii              as integer       no-undo .
      368           define variable fh              as widget-handle no-undo .
      369           define variable hh              as widget-handle no-undo .
      370           define variable v-h             as handle        extent 4 no-undo .
      371           define variable v-name-button   as character     no-undo .
      372           define variable v-help-old-x    as decimal       no-undo .
      373           define variable v-help-old-y    as decimal       no-undo .
      374           define variable v-help-old-size as decimal       no-undo .
      375           define variable v-frame-width   as decimal       no-undo .
      376           define variable jj              as integer       no-undo .
      377           do
      378               on error undo, return error
      379               :
      380               assign
      381                   v-frame-width = frame Dialog-Frame:width - 0.3
      382                   fh            = frame Dialog-Frame:first-child
      383                   hh            = fh:first-child
      384                   ii            = 1
      385                   .
      386               do while valid-handle(hh):
      387                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      388                   do:
      389                       case lc(hh:name) :
      390                           when "b-help" then
      391                               do:
      392                                   hh:load-image-up("cmp/b-help.bmp":u) .
      393                                   hh:load-image-down("cmp/b-help.bmp":u) .
      394                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      395                                   hh:TOOLTIP = "Помощь" .
      396                                   v-help-old-x = hh:column .
      397                                   v-help-old-y = hh:row    .
      398                                   v-help-old-size = hh:width .
      399                                   hh:width-chars = 2.5 .
      400                               end.
      401                           when "b-print" then
      402                               do:
      403                                   hh:load-image("cmp/b-print.bmp":u) .
      404                                   hh:TOOLTIP = "Печать" .
      405                                   v-h[ii] = hh:handle .
      406                                   ii = ii + 1 .
      407                                   hh:width-chars = 3 .
      408                               end.
      409                           when "b-history" or
      410                           when "b-hist" then
      411                               do:
      412                                   hh:load-image("cmp/b-hist.bmp":u) .
      413                                   hh:TOOLTIP = "История" .
      414                                   v-h[ii] = hh:handle .
      415                                   ii = ii + 1 .
      416                                   hh:width-chars = 3 .
      417                               end.
      418                           when "b-sch" then
      419                               do:
      420                                   hh:load-image("cmp/b-sch.bmp":u) .
      421                                   hh:TOOLTIP = "Установка Фильтра" .
      422                                   v-h[ii] = hh:handle .
      423                                   ii = ii + 1 .
      424                                   hh:width-chars = 3 .
      425                               end.
      426                           when "b-hist-user" then
      427                               do:
      428                                   hh:load-image("cmp/b-hist.bmp":u) .
      429                                   hh:TOOLTIP = "История пользователя" .
      430                                   ii = ii + 1 .
      431                               end.
      432                       end case.
      433                   end.
      434                   hh = hh:next-sibling.
      435               end.
      436               b-help:column = v-frame-width - b-help:width-chars.
      437               jj = 0.
      438               repeat ii = 4 to 1 by -1 :
      439                   if valid-handle (v-h[ii] ) then
      440                   do:
      441                       jj  = jj + 1 .
      442                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      443                       v-h[ii]:row    = v-help-old-y .
      444                   end.
      445               end.
      446           end.
      447       end.
      448   end procedure.
      449   MAIN-BLOCK:
      450   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      451      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      453     (input  'is-ef'
      454     ,input  ''
      455     ,input  ''
      456     ,input  0
      457     ,input  ''
      458     ,input  ''
      459     ,input  ''
      460     ,input  no
      461     ,output is-ef-chr
      462     ,output var-type
      463     ) no-error .
      464     if NOT error-status:error
      465     and logical(is-ef-chr) = yes then do:
      466       is-ef = YES.
      467     end.
      468     RUN enable_UI.
      469     IF NOT is-ef THEN DO:
      470       HIDE
      471       varef-nid IN frame Dialog-Frame.
      472     END.
      473     WAIT-FOR GO OF FRAME Dialog-Frame.
      474   END.
      475   RUN disable_UI.
      476   PROCEDURE disable_UI :
      477     HIDE FRAME Dialog-Frame.
      478   END PROCEDURE.
      479   PROCEDURE enable_UI :
      480     DISPLAY varpump-code varnozzle-code varis-meas varef-nid
      481         WITH FRAME Dialog-Frame.
      482     ENABLE b-save b-cancel b-help varpump-code b-pump varnozzle-code b-nozzle
      483            varis-meas varef-nid
      484         WITH FRAME Dialog-Frame.
      485     VIEW FRAME Dialog-Frame.
