     6968   procedure grp-obj-notcorr-value :
     6969   do
     6970   on error undo, return error
     6971   :
     6972   define input parameter p-node-code             as integer      no-undo.
     6973   define input parameter p-obj-type              as character    no-undo.
     6974   define input parameter p-obj-code              as integer      no-undo.
     6975   define output parameter p-notcorr              as character    no-undo init ?.
     6976   define output parameter p-range-notcorr     as integer      no-undo.
     6977   define output parameter p-exists-notcorr    as logical      no-undo.
     6978   define variable v-host-code as integer      no-undo.
     6979   DEFINE VARIABLE v-found as logical no-undo .
     6980   DEFINE VARIABLE v-exists as logical no-undo .
     6981   DEFINE VARIABLE v-range as integer no-undo .
     6982   DEFINE VARIABLE jj as integer no-undo .
     6983   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6984   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6985   define buffer buf_gds-grp for ub.gds-grp.
     6986   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     6987   find first buf_gds-grp no-lock where
     6988              buf_gds-grp.node-code = p-node-code no-error .
     6989   if not avail buf_gds-grp and p-node-code <> 0 then do:
     6990     message
     6991       vss-workfile vss-revision vss-description
     6992       skip "Не удалось найти группу товаров с кодом" p-node-code
     6993       view-as alert-box error .
     6994     undo, return error .
     6995   end.
     6996   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6998     (input  p-obj-type
     6999     ,input  p-obj-code
     7000     ,output v-host-code
     7001     ) no-error .
     7002   if error-status :error
     7003   then do:
     7004       message
     7005         vss-workfile vss-revision vss-description
     7006         skip "Не удалось найти фирму объекта"
     7007         skip p-obj-type p-obj-code
     7008         skip return-value
     7009         skip trim(error-status :get-message(1))
     7010       view-as alert-box error.
     7011       undo, return error .
     7012   end.
     7013   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7014   do while v-found = no and jj < 2:
     7015     if v-range <> 3 then do:
     7016       find first buf_gds-grp-obj no-lock
     7017           where buf_gds-grp-obj.node-code = p-node-code
     7018             and buf_gds-grp-obj.host-code = v-host-code
     7019             and buf_gds-grp-obj.obj-type  = p-obj-type
     7020             and buf_gds-grp-obj.obj-code  = p-obj-code
     7021       no-error .
     7022     end.
     7023     if v-range = 3 or not available buf_gds-grp-obj
     7024     then do:
     7025        if v-range <> 2 then do:
     7026           find first buf_gds-grp-obj no-lock
     7027               where buf_gds-grp-obj.node-code = p-node-code
     7028                 and buf_gds-grp-obj.host-code = v-host-code
     7029                 and buf_gds-grp-obj.obj-type  = ""
     7030                 and buf_gds-grp-obj.obj-code  = 0
     7031           no-error .
     7032         end.
     7033         if v-range = 2 or not available buf_gds-grp-obj
     7034         then do:
     7035             if v-range <> 1 then do:
     7036               find first buf_gds-grp-obj no-lock
     7037                   where buf_gds-grp-obj.node-code = p-node-code
     7038                   and buf_gds-grp-obj.host-code = 0
     7039                   and buf_gds-grp-obj.obj-type  = ""
     7040                   and buf_gds-grp-obj.obj-code  = 0
     7041               no-error .
     7042             end.
     7043             if v-range = 1 or not available buf_gds-grp-obj
     7044             then do:
     7045                 assign
     7046                     v-exists = no
     7047                 .
     7048             end.
     7049             else do:
     7050                 assign
     7051                     v-exists = yes
     7052                     v-range = 1
     7053                 .
     7054             end.
     7055         end.
     7056         else do:
     7057             assign
     7058                 v-exists = yes
     7059                 v-range  = 2
     7060             .
     7061         end.
     7062     end.
     7063     else do:
     7064         assign
     7065             v-exists = yes
     7066             v-range  = 3
     7067         .
     7068     end.
     7069     if available buf_gds-grp-obj
     7070     then do:
     7071       find first buf_gds-grp-obj-attr no-lock
     7072         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7073           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7074           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7075           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7076           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7077         no-error .
     7078       if available buf_gds-grp-obj-attr then do:
     7079         assign
     7080           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7081         .
     7082       end.
     7083       else do:
     7084         assign
     7085           v-notcorr-value = ?
     7086         .
     7087       end.
     7088       assign
     7089       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7090                           then yes
     7091                           else p-exists-notcorr)
     7092       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7093                         then v-range
     7094                         else p-range-notcorr
     7095       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7096                         then v-notcorr-value
     7097                         else p-notcorr
     7098       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7099       jj = jj + 1
     7100       .
     7101     end.
     7102     else do:
     7103       assign
     7104       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7105       jj = jj + 1
     7106       .
     7107     end.
     7108   end.
     7109   end.
     7110   end procedure.
