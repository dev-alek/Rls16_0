    12654       , output v-xml-file-name
    12655       , output v-xml-file-name-path
    12656       , output v-log-file-name
    12657       , output v-locked
    12658   ).
    12659   run write-log-and-file in p-log-handle (
    12660         input 1
    12661       , input log-file-name
    12662       , input 1
    12663       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    12664                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    12665                         )
    12666                                         ).
    12667   run write-log-and-file in p-log-handle (
    12668         input 1
    12669       , input log-file-name
    12670       , input 1
    12671       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
    12672                                         ).
    12673   assign
