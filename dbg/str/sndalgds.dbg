     6100   procedure fact-order-mpl :
     6101     do
     6102     on error undo, return error return-value
     6103     :
     6104   define input  parameter p-doc-date as date     no-undo .
     6105   define input  parameter p-obj-type as character no-undo .
     6106   define input  parameter p-obj-code as integer   no-undo .
     6107   define output parameter p-fact-order as decimal   no-undo .
     6108   define variable v-fact-date            as date    no-undo .
     6109   define variable v-fact-time            as integer no-undo .
     6110   define variable v-fact-order           as decimal no-undo .
     6111   define variable v-shift-end-fact-order as decimal no-undo .
     6112   define variable v-day-end-fact-order   as decimal no-undo .
     6113   define variable l-shift-on as logical no-undo .
     6114   define variable l-date as date      no-undo .
     6115   define variable l-time as integer   no-undo .
     6116   define variable shift-date as date      no-undo .
     6117   define variable shift-num  as integer   no-undo .
     6118   define variable shift-name as character no-undo .
     6119   define variable max-fact-order as decimal   no-undo .
     6120   define buffer buf_global-state for ub.global-state  .
     6121   find first buf_global-state no-lock no-error .
     6122   if not available buf_global-state then do:
     6123      message
     6124        "Не заданы параметры ценообразования!"
     6125        view-as alert-box error
     6126      .
     6127      return error return-value .
     6128   end.
     6129     run cur-time in this-procedure
     6130     ( output v-fact-date ,
     6131       output v-fact-time  ).
     6132   if p-doc-date = ? then do:
     6133   if buf_global-state.pl-use-sys-date-time  = true then do:
     6134         run factord in this-procedure
     6135           (input  v-fact-date
     6136           ,input  v-fact-time
     6137           ,input  v-fact-time
     6138           ,input  ?
     6139           ,input  ?
     6140           ,input  false
     6141           ,output v-fact-order
     6142           ,output v-shift-end-fact-order
     6143           ,output v-day-end-fact-order
     6144           ) no-error .
     6145         if error-status :error
     6146         or v-fact-order = ?
     6147         or v-fact-order = 0 then do:
     6148           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6149         end.
     6150         p-fact-order = v-fact-order .
     6151   end.
     6152   else do:
     6153   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6155     (input  p-obj-type
     6156     ,input  p-obj-code
     6157     ,input  'shift-on=request'
     6158     ,output l-shift-on
     6159     ) no-error .
     6160         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6161         if p-doc-date <> ? then do:
     6162         end.
     6163          run gbl/factdate.p
     6164          ( input        p-obj-type  ,
     6165            input        p-obj-code  ,
     6166            input-output v-fact-date ,
     6167            input-output v-fact-time ,
     6168            input-output shift-date      ,
     6169            input-output shift-num       ,
     6170            input-output shift-name      ,
     6171            input        yes
     6172            ) no-error .
     6173         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6174         run factord in this-procedure
     6175           (input  v-fact-date
     6176           ,input  v-fact-time
     6177           ,input  v-fact-time
     6178           ,input  shift-date
     6179           ,input  shift-num
     6180           ,input  l-shift-on
     6181           ,output v-fact-order
     6182           ,output v-shift-end-fact-order
     6183           ,output v-day-end-fact-order
     6184           ) no-error .
     6185         if error-status :error
     6186         or v-fact-order = ?
     6187         or v-fact-order = 0 then do:
     6188           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6189         end.
     6190         p-fact-order = v-fact-order .
     6191   end.
     6192   end.
     6193   else do:
     6194          run gbl/factdate.p
     6195          ( input        p-obj-type  ,
     6196            input        p-obj-code  ,
     6197            input-output v-fact-date ,
     6198            input-output v-fact-time ,
     6199            input-output shift-date      ,
     6200            input-output shift-num       ,
     6201            input-output shift-name      ,
     6202            input        yes
     6203            ) no-error .
     6204         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6205         v-fact-date = p-doc-date .
     6206         run factord in this-procedure
     6207           (input  v-fact-date
     6208           ,input  v-fact-time
     6209           ,input  v-fact-time
     6210           ,input  shift-date
     6211           ,input  shift-num
     6212           ,input  l-shift-on
     6213           ,output v-fact-order
     6214           ,output v-shift-end-fact-order
     6215           ,output v-day-end-fact-order
     6216           ) no-error .
     6217         if error-status :error
     6218         or v-fact-order = ?
     6219         or v-fact-order = 0 then do:
     6220           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6221         end.
     6222         p-fact-order = v-fact-order .
     6223   end.
     6224     end.
     6225   end procedure.
