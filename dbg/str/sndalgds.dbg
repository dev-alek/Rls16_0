    10433   DEFINE VARIABLE second-name as character no-undo.
    10434   define variable nam-2str-shift as integer no-undo .
    10435   define variable v-length as integer no-undo .
    10436   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
    10437   define variable std-disc-dec as decimal no-undo .
    10438   define variable std-disc-reason as integer no-undo .
    10439   define variable std-disc-lim as date no-undo .
    10440   define variable temp-disc-dec as decimal no-undo .
    10441   define variable temp-disc-reason as integer no-undo .
    10442   define variable temp-disc-start as date no-undo .
    10443   define variable temp-disc-end as date no-undo .
    10444   define variable temp-disc-time-start as integer no-undo .
    10445   define variable temp-disc-time-end as integer no-undo .
    10446   define variable temp-disc-weekday as integer no-undo .
    10447   define variable v-version-dec as decimal no-undo .
    10448   define variable v-kat-num as integer no-undo .
    10449   define variable v-kat-discnt as decimal no-undo .
    10450   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
    10451   define variable IBM2-short as character no-undo .
    10452   define variable v-what-find as character no-undo .
    10453   define variable v-plu as character no-undo .
    10454   define variable v-pl-code as integer no-undo .
    10455   define variable v-marketer-action as character no-undo .
    10456   define variable v-versiond as decimal no-undo .
    10457   define variable v-b-code-to-find as logical no-undo .
    10458   define variable v-maria-discnt-value as character no-undo .
    10459   define variable v-ii as integer no-undo .
    10460   define variable v-dop as character no-undo .
    10461   define variable v-gds-rule-num as integer no-undo .
    10462   define variable v-maria-rule-num as integer no-undo .
    10463   define variable v-discreteness as character no-undo .
    10464   define variable wd-option as integer no-undo .
    10465   define variable wgd-option as integer no-undo .
    10466   define variable v-type as logical   no-undo .
    10467   define variable  s as char no-undo.
    10468   define variable articul as char no-undo.
    10469   define variable v-disc-price-sale as decimal no-undo .
    10470   define variable v-pdf-id as integer no-undo .
    10471   define variable v-pdf-db-num as integer no-undo .
    10472   define buffer buf_cash-dis-rule for cash-dis-rule .
    10473   define buffer buf_cd-plu for ub.cd-plu.
    10474   define buffer buf_dis-rule for ub.dis-rule.
    10475   define buffer buf_place for ub.place.
    10476   define buffer buf_pl-gds for ub.pl-gds.
    10477   define buffer bcash-gds for cash-gds.
    10478   define buffer buf_cash-desk-attr for cash-desk-attr.
    10479   define variable vcash-desk-stndart as logical no-undo init yes.
    10480   assign
    10481   v-version-dec = decimal(p-version)
    10482   no-error .
    10483   if buf_cash-desk.autonomy = integer('2':U)
    10484   then do:
    10485      vcash-desk-stndart = no.
    10486   end.
    10487     if buf_cash-desk.device-kind = 2 then vcash-desk-stndart = no.
    10488   define variable is-petrol   as logical   no-undo.
    10489   define variable is-pieces   as logical   no-undo.
    10490   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10491     (
    10492        input cash-gds.artic
    10493     ,  input ?
    10494     ,  input cash-gds.gds-code
    10495     , output is-petrol
    10496     , output is-pieces
    10497     ) NO-ERROR.
    10498   if     not vcash-desk-stndart
    10499      and not is-petrol
    10500   then
    10501      return.
    10502   if cash-gds.std-discnt-rule > 0 then do:
    10503     find first cash-dis-rule no-lock where
    10504               cash-dis-rule.rule-num =  cash-gds.std-discnt-rule no-error .
    10505     if available cash-dis-rule then do:
    10506       find first cash-dis-time-rule no-lock where
    10507                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10508       assign
    10509       std-disc-dec = - cash-dis-rule.discnt-value
    10510       std-disc-reason = 0
    10511       no-error
    10512       .
    10513       if available cash-dis-time-rule then do:
    10514         assign
    10515         std-disc-lim = cash-dis-time-rule.date-to
    10516         .
    10517         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
    10518         assign
    10519         std-disc-dec = 0
    10520         std-disc-reason = 0
    10521         .
    10522         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10523         assign
    10524         std-disc-dec = 0
    10525         std-disc-reason = 0
    10526         .
    10527       end.
    10528     end.
    10529   end.
    10530   if cash-gds.wd > 1 then do:
    10531     find first cash-dis-rule no-lock where
    10532               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
    10533     if available cash-dis-rule then  do:
    10534       assign
    10535       wd-option = integer(cash-dis-rule.discnt-value).
    10536     end.
    10537   end.
    10538   if cash-gds.wd = 1 then do:
    10539      wd-option = 1.
    10540   end.
    10541   if cash-gds.wgd > 0 then do:
    10542     find first cash-dis-rule no-lock where
    10543               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
    10544     if available cash-dis-rule then  do:
    10545       assign
    10546       wgd-option = integer(cash-dis-rule.discnt-value).
    10547     end.
    10548   end.
    10549   if cash-gds.temp-discnt-rule <> 0 then do:
    10550     assign
    10551     temp-disc-dec = 0
    10552     .
    10553     find first cash-dis-rule no-lock where
    10554               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
    10555     if available cash-dis-rule
    10556              and cash-dis-rule.is-term = yes then do:
    10557       if cash-dis-rule.time-rule-num > 0 then do:
    10558         find first cash-dis-time-rule no-lock where
    10559                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10560         if available cash-dis-time-rule
    10561         and cash-dis-time-rule.templ-rl-root = 50001
    10562             or
    10563             (
    10564              (
    10565               (cash-dis-time-rule.date-from < today)
    10566               or
    10567               (cash-dis-time-rule.date-from = 12/31/1989)
    10568              )
    10569             and
    10570             (
    10571              (cash-dis-time-rule.date-to >= today)
    10572              or
    10573              (cash-dis-time-rule.date-to = 12/31/1989)
    10574             )
    10575            ) then do:
    10576            temp-disc-dec = ?.
    10577         end.
    10578         else do:
    10579           assign
    10580           temp-disc-dec = 0
    10581           .
    10582         end.
    10583       end.
    10584       else do:
    10585         temp-disc-dec = ?.
    10586       end.
    10587       if temp-disc-dec = ? then do:
    10588         case cash-dis-rule.value-type:
    10589           when integer('1':U) then do:
    10590         assign
    10591         temp-disc-dec = - cash-dis-rule.discnt-value
    10592         .
    10593       end.
    10594           when integer('11':U) then do:
    10595             find first cash-gds-discnt where
    10596                       cash-gds-discnt.b-code = cash-gds.b-code
    10597                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    10598                   and cash-gds-discnt.obj-type = 'маг':U
    10599                   and cash-gds-discnt.obj-code = i-obj-code
    10600                   no-error.
    10601             if available cash-gds-discnt then do:
    10602               assign
    10603               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
    10604               .
    10605             end.
    10606             else do:
    10607              assign
    10608               temp-disc-dec = 0.
    10609             end.
    10610           end.
    10611           otherwise do:
    10612             temp-disc-dec = 0.
    10613           end.
    10614         end case.
    10615       end.
    10616     end.
    10617   end.
    10618   CASE pos-type:
    10619     when 'MAGIA-XML':U
    10620     then do:
    10621       if cash-gds.b-str <> "":U then do:
    10622         return.
    10623       end.
    10624       assign
    10625       chk_name = replace(cash-gds.gds-name, chr(34), "":U) + cash-gds.f-name
    10626       .
    10627       if cash-gds.unit-base <> cash-gds.unit-cli then
    10628       assign
    10629       chk_name = string(substr(chk_name, 1, max(33, 50 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))) +
    10630                         "*":U +
    10631                         trim(string( cash-gds.cli-base-rate ), chr(32)), "x(50)":U ).
    10632       else
    10633       chk_name = string(chk_name, "X(50)":U).
    10634       assign
    10635       second-name = replace(cash-gds.gds-namelong, chr(39), "":U)
    10636       second-name =   (chr(34) +
    10637                         TRIM(CAPS(string( replace(second-name, chr(34), "":U), "X(40)":U )))
    10638                         + chr(34) )
    10639       .
    10640       if cash-gds.unit-base <> cash-gds.unit-cli then
    10641       assign
    10642       second-name = string(substr(second-name, 1, max(23, 40 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))  ) +
    10643                         "*":U +
    10644                         trim(string(cash-gds.cli-base-rate), chr(32)), "x(40)":U ).
    10645       else
    10646       second-name = string(second-name, "X(40)":U).
    10647       if tax-cass AND cash-gds.new-good then do:
    10648           for each cash-txr No-LOCK WHERE
    10649                     cash-txr.rc = cash-gds.rc AND
    10650                     cash-txr.host-code = ub.shop.host-code AND
    10651                     cash-txr.obj-type = 'маг':U AND
    10652                     cash-txr.obj-code = ub.shop.obj-code:
    10653             run putc-13(buffer buf_cash-desk
    10654                       , input pos-type
    10655                       , input p-cash-os
    10656                       , input yes
    10657                       ).
    10658           end.
    10659       end.
    10660   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10661   define variable mi-entry as integer no-undo .
    10662   define variable v-out-code like ub.fbr-gds-grp.out-code no-undo .
    10663   define variable v-out-code-0 like ub.fbr-gds-grp.out-code no-undo .
    10664   define variable v-global-code like ub.fbr-gds-grp.global-code no-undo .
    10665   define variable v-xml-vat like ub.tax-rate-value.rate-value no-undo .
    10666   define variable v-xml-slt like ub.tax-rate-value.rate-value no-undo .
    10667   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10668   define buffer buf_tax-rate for ub.tax-rate.
    10669   find first buf_fbr-gds-grp no-lock where
    10670              buf_fbr-gds-grp.obj-type = 'маг':U
    10671          AND buf_fbr-gds-grp.obj-code = i-obj-code
    10672         AND buf_fbr-gds-grp.node-code = cash-gds.fbr-grp-code no-error .
    10673   if avail buf_Fbr-gds-grp then do:
    10674     assign
    10675     v-out-code = buf_fbr-gds-grp.out-code
    10676     v-global-code = buf_fbr-gds-grp.global-code
    10677     .
    10678   end.
    10679   else do:
    10680     assign
    10681     v-global-code = cash-gds.fbr-grp-code-0
    10682     .
    10683   end.
    10684   if v-global-code  > 0
    10685   then do:
    10686     find first buf_fbr-gds-grp no-lock where
    10687               buf_fbr-gds-grp.obj-type = "":U
    10688           AND buf_fbr-gds-grp.obj-code = 0
    10689           AND buf_fbr-gds-grp.node-code = v-global-code no-error .
    10690     if avail buf_Fbr-gds-grp then do:
    10691       assign
    10692       v-out-code-0 = buf_fbr-gds-grp.out-code
    10693       .
    10694     end.
    10695     else do:
    10696       v-out-code-0 = 0.
    10697     end.
    10698   end.
    10699   if v-out-code = 0
    10700   and cash-gds.is-modificator = 0
    10701   then do:
    10702       run write-log-and-file in p-log-handle (
    10703             input 1
    10704           , input log-file-name
    10705           , input 1
    10706           , input substitute("!!!Ошибка при получении характеристик товара &1 &2 на объекте: &3"
    10707                               , cash-gds.gds-code
    10708                               , cash-gds.gds-name
    10709                               , "не указана группа меню на кассе"
    10710                               )
    10711                                 ).
    10712       assign
    10713       v-view-log = yes
    10714       .
    10715   end.
    10716   if v-out-code <> 0
    10717   or v-is-modificator
    10718   then do:
    10719     run bgelib-tag-open in this-procedure ( input 2, input "Item", input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U":U then "ADD" else "DEL":U), OS2-time, cash-gds.b-code)).
    10720     run bgelib-tag-put in this-procedure ( input 3, input "ItemName"       , input trim(second-name, chr(32)), input 1 ).
    10721     run bgelib-tag-put in this-procedure ( input 3, input "ItemAltName"    , input trim(chk_name, chr(34)), input 1 ).
    10722     run bgelib-tag-put in this-procedure ( input 3, input "ItemMainPrice"  , input string(0), input 1 ).
    10723     run bgelib-tag-put in this-procedure ( input 3, input "ItemPriceCurrency"  , input string(v-r-b-curr-magia), input 1 ).
    10724     run bgelib-tag-put in this-procedure ( input 3, input "ItemGroup"      , input string( if v-out-code-0 = 0 then 9998 else v-out-code-0), input 1 ).
    10725     run bgelib-tag-put in this-procedure ( input 3, input "ItemDepartId"   , input string( cash-gds.departid ), input 1 ).
    10726     run bgelib-tag-put in this-procedure ( input 3, input "ItemLock"       , input (if action = "U":U then string(0) else string(1)), input 1 ).
    10727     run bgelib-tag-open in this-procedure ( input 3, input "ItemStatus"        ,       input "" ).
    10728     run bgelib-tag-put in this-procedure ( input 4, input "ISNullPrice"        , input string( cash-gds.zp ), input 1 ).
    10729     run bgelib-tag-put in this-procedure ( input 4, input "ISMenu"            , input string( cash-gds.is-menu ), input 1 ).
    10730     run bgelib-tag-put in this-procedure ( input 4, input "ISSemiFinished"     , input string( cash-gds.is-semi-finished ), input 1 ).
    10731     run bgelib-tag-put in this-procedure ( input 4, input "ISModificator"     , input string( cash-gds.is-modificator ), input 1 ).
    10732     run bgelib-tag-close in this-procedure ( input 3, input "ItemStatus").
    10733     if tax-cass
    10734     AND action = "U":U then do:
    10735       do mi-entry = 1 to num-entries(cash-gds.tax-string, chr(32)):
    10736         if entry(mi-entry, cash-gds.tax-string, chr(32)) <> "":U then do:
    10737           find first buf_tax-rate no-lock where
    10738                       buf_tax-rate.rate-code = integer(entry(mi-entry, cash-gds.tax-string, chr(32))) no-error .
    10739           if available buf_tax-rate
