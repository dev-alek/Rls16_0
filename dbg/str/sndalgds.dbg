    11089           and buf_cash-dis-rule.root then do:
    11090           end.
    11091           else do:
    11092             case buf_cash-dis-rule.value-type:
    11093               when integer('1':U) then do:
    11094                 assign
    11095                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
    11096                 .
    11097               end.
    11098               when integer('11':U) then do:
    11099                 find first cash-gds-discnt where
    11100                           cash-gds-discnt.b-code = cash-gds.b-code
    11101                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    11102                       and cash-gds-discnt.obj-type = 'маг':U
    11103                       and cash-gds-discnt.obj-code = i-obj-code
    11104                       no-error.
    11105                 if available cash-gds-discnt then do:
    11106                   assign
    11107                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
    11108                   .
    11109                 end.
    11110                 else do:
    11111                   assign
    11112                   temp-disc-dec = 0.
    11113                 end.
    11114               end.
    11115               otherwise do:
    11116                 temp-disc-dec = 0.
    11117               end.
    11118             end case.
    11119           end.
    11120           assign
    11121           temp-disc-reason = 0
    11122           temp-disc-weekday = 0
    11123           no-error
    11124           .
    11125           assign
    11126           temp-disc-start = cash-dis-time-rule.date-from
