     7223   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7224   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7225   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7226   procedure create-dis-rule :
     7227   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7228   define input parameter p-tree as logical no-undo .
     7229   define buffer buf_dis-rule for ub.dis-rule.
     7230   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7231   define buffer term_dis-rule for ub.dis-rule.
     7232   define buffer term_dis-time-rule for ub.dis-time-rule.
     7233   define buffer root_cash-dis-rule for cash-dis-rule.
     7234   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7235   define buffer term_cash-dis-rule for cash-dis-rule.
     7236   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7237     do
     7238     on error undo, return error
     7239     :
     7240       find first root_cash-dis-rule no-lock where                                                         ~
     7241                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7242       if not available root_cash-dis-rule then do:
     7243         find first buf_dis-rule no-lock where
     7244                   buf_dis-rule.rule-num = p-rule-num no-error.
     7245         if available buf_dis-rule then do:
     7246           if buf_dis-rule.time-rule-num <> 0 then do:
     7247             find first buf_dis-time-rule no-lock where
     7248                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7249           end.
     7250           create root_cash-dis-rule.
     7251           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7252           if available buf_dis-time-rule then do:
     7253             find first root_cash-dis-time-rule no-lock where
     7254                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7255             if not available root_cash-dis-time-rule then do:
     7256               create root_cash-dis-time-rule.
     7257               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7258             end.
     7259           end.
     7260           else do:
     7261             assign
     7262             root_cash-dis-rule.time-rule-num = 0.
     7263           end.
     7264           if buf_dis-rule.uniq-field <> "":U then do:
     7265             for each term_dis-rule no-lock where
     7266                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7267               if term_dis-rule.time-rule-num <> 0 then do:
     7268                 find first term_dis-time-rule no-lock where
     7269                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7270               end.
     7271               create term_cash-dis-rule.
     7272               buffer-copy term_dis-rule to term_cash-dis-rule.
     7273               if term_dis-rule.time-rule-num = 0
     7274               or available term_dis-time-rule
     7275               or root_cash-dis-rule.time-rule-num = 0
     7276               then do:
     7277                 if available term_dis-time-rule then do:
     7278                   find first term_cash-dis-time-rule no-lock where
     7279                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7280                   if not available term_cash-dis-time-rule then do:
     7281                     create term_cash-dis-time-rule.
     7282                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7283                   end.
     7284                 end.
     7285               end.
     7286             end.
     7287           end.
     7288         end.
     7289       end.
     7290     end.
     7291   end procedure.
     7292   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7293   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7294   function ncr-amnt-disc returns character (
     7295     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7296   define variable v-result as character no-undo .
     7297   define variable ii as integer no-undo .
     7298   define variable v-entry as character no-undo extent 3.
     7299   for each cash-dis-rule  no-lock where
     7300         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7301     assign
     7302     ii = ii + 1
     7303     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7304                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7305     .
     7306   end.
     7307   if v-entry[2] = "":U then
     7308   assign
     7309   v-entry[2] = v-entry[1]
     7310   .
     7311   if v-entry[3] = "":U then
     7312   assign
     7313   v-entry[3] = v-entry[2]
     7314   .
     7315   assign
     7316   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7317   .
     7318   return v-result.
     7319   END FUNCTION.
     7320   function ncr-date-disc returns character (
     7321     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7322   define variable v-result as character no-undo .
     7323   define variable ii as integer no-undo .
     7324   define variable v-entry as character no-undo extent 3.
     7325   for each cash-dis-rule  no-lock where
     7326         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7327       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7328     assign
     7329     ii = ii + 1
     7330     v-entry[ii] =
     7331                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7332                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7333                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7334                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7335                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7336                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7337                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7338   end.
     7339   if v-entry[2] = "":U then
     7340   assign
     7341   v-entry[2] = v-entry[1]
     7342   .
     7343   if v-entry[3] = "":U then
     7344   assign
     7345   v-entry[3] = v-entry[2]
     7346   .
     7347   assign
     7348   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7349   .
     7350   return v-result.
     7351   END FUNCTION.
     7352   function ncr-temp-disc returns character (
     7353     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7354   define variable v-result as character no-undo .
     7355   define variable ii as integer no-undo .
     7356   define variable v-entry as character no-undo extent 3.
     7357   define variable v-dec as decimal no-undo .
     7358   define variable v-disc-price-sale as decimal no-undo .
     7359   define variable v-pdf-id as integer no-undo .
     7360   define variable v-pdf-db-num as integer no-undo .
     7361   define buffer buf_cash-dis-rule for cash-dis-rule.
     7362   find first buf_cash-dis-rule where
     7363            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7364   if not available buf_cash-dis-rule then return "":U.
     7365   if buf_cash-dis-rule.templ-rl-root <> 29
     7366   and buf_cash-dis-rule.templ-rl-root <> 86
     7367   then do:
     7368     assign
     7369     v-entry[1] =
     7370     "000"                                                   +
     7371     "0"                                                     +
     7372     "0000"                                                  +
     7373     "2359"                                                     +
     7374      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7375      .
     7376   end.
     7377   else do:
     7378     for each cash-dis-rule  no-lock where
     7379           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7380         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7381       case cash-dis-rule.value-type:
     7382         when integer('1':U) then do:
     7383           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7384         end.
     7385         when integer('12':U) then do:
     7386           find first cash-gds-discnt where
     7387                     cash-gds-discnt.b-code = cash-gds.b-code
     7388                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7389                 and cash-gds-discnt.obj-type = 'маг':U
     7390                 and cash-gds-discnt.obj-code = i-obj-code
     7391                 no-error.
     7392           if not available cash-gds-discnt then do:
     7393             v-dec = cash-gds.price-sale.
     7394           end.
     7395           else do:
     7396             assign
     7397             v-dec = cash-gds-discnt.discnt-value
     7398             .
     7399           end.
     7400         end.
     7401         otherwise do:
     7402           v-dec = cash-gds.price-sale.
     7403         end.
     7404       end case.
     7405       assign
     7406       ii = ii + 1
     7407       v-entry[ii] =
     7408                     "000"                                                   +
     7409                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7410                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7411                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7412                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7413                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7414                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7415                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7416                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7417                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7418                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7419                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7420       .
     7421   if ii = 3 then leave.
     7422     end.
     7423   end.
     7424   if v-entry[2] = "":U then
     7425   assign
     7426   v-entry[2] = v-entry[1]
     7427   .
     7428   if v-entry[3] = "":U then
     7429   assign
     7430   v-entry[3] = v-entry[2]
     7431   .
     7432   assign
     7433   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7434   .
     7435   return v-result.
     7436   END FUNCTION.
     7437   function ncr-d-rank returns character (
     7438     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7439   define variable v-result as character no-undo .
     7440   define variable ii as integer no-undo .
     7441   do ii = 1 to length(p-d-rank):
     7442     CASE substr(p-d-rank, ii, 1):
     7443       when "X":U then do:
     7444         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7445       end.
     7446       when "T":U then do:
     7447         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7448       end.
     7449       when "D":U then do:
     7450         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7451       end.
     7452     END CASE.
     7453     if v-result <> "":U then LEAVE.
     7454   end.
     7455   if v-result = "":U then v-result = chr(32).
     7456   return v-result.
     7457   END FUNCTION.
     7458   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7459       define variable v-upper-code as int no-undo.
     7460       define variable v-value as character no-undo.
     7461       define variable v-type as character no-undo.
     7462       define buffer lc_gds-grp for ub.gds-grp.
     7463       define buffer lc_goods for ub.goods.
     7464      if p-gds-code <> 0 then do:
     7465       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7466       v-upper-code = lc_goods.grp-code.
     7467       do while v-upper-code > 0 :
     7468           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7469           run ggoattr-value(
     7470             input lc_gds-grp.node-code,
     7471             input 0,
     7472             input "",
     7473             input 0,
     7474             input 'ban-sales-via-cd':U,
     7475             output v-value,
     7476             output v-type
     7477           ).
     7478          if v-value = "yes" then
     7479             return true.
     7480          else
     7481          do:
     7482             run ggoattr-value(
     7483                input lc_gds-grp.node-code,
     7484                input shop.host-code,
     7485                input "",
     7486                input 0,
     7487                input 'ban-sales-via-cd':U,
     7488                output v-value,
     7489                output v-type
     7490                ).
     7491             if v-value = "yes" then
     7492                return true.
     7493             else
     7494             do:
     7495                run ggoattr-value(
     7496                   input lc_gds-grp.node-code,
     7497                   input shop.host-code,
     7498                   input 'маг':U,
     7499                   input i-obj-code,
     7500                   input 'ban-sales-via-cd':U,
     7501                   output v-value,
     7502                   output v-type
     7503                   ).
     7504                if v-value = "yes" then
     7505                   return true.
     7506                else v-upper-code = lc_gds-grp.upper-code.
     7507             end .
     7508          end.
     7509         end.
     7510       end.
     7511   end.
     7512   FUNCTION convert-tax-code returns integer
     7513                                             ( input p-rate-code as integer
     7514                                              ,input p-cdtaxlst  as character
     7515                                             ) :
     7516   define variable jj as integer no-undo .
     7517     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7518       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7519         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7520       end.
     7521     end.
     7522   END FUNCTION.
     7523   FUNCTION convert-maria-tax-code returns character
     7524                                             ( input p-vat-rate-code as integer
     7525                                              ,input p-slt-rate-code as integer
     7526                                              ,input p-cdtaxlst  as character
     7527                                             ) :
     7528   define variable jj as integer no-undo .
     7529   define variable aa as character no-undo extent 8.
     7530   define variable v-return-value as character no-undo .
     7531     do jj = 1 to 8:
     7532       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7533         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7534           aa[jj] = '1'.
     7535         end.
     7536         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7537           aa[jj] = '1'.
     7538         end.
     7539       end.
     7540       if aa[jj] = '':U then aa[jj] = '0'.
     7541       v-return-value = aa[jj] + v-return-value.
     7542     end.
     7543   return v-return-value.
     7544   END FUNCTION.
     7545   FUNCTION convert-maria-tax-code-2 returns integer
     7546                                             ( input p-rate-code as integer
     7547                                              ,input p-cdtaxlst  as character
     7548                                             ) :
     7549   define variable jj as integer no-undo .
     7550   define variable v-return-value as integer no-undo .
     7551     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7552       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7553         return jj.
     7554       end.
     7555     end.
     7556   return 0.
     7557   END FUNCTION.
     7558   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
