      108   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   def new shared var bc-frmt as character no-undo .
      110   def new shared var bc-pfx  as character no-undo .
      111   def var bc-par-type as character no-undo .
      112       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      113       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      114           do:
      115               message "Не задан или не верно задан ТИП собственного бар-кода!"
      116                   view-as alert-box ERROR TITLE "".
      117               return error.
      118           end.
      119       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      120       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      121           do:
      122               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      123                   view-as alert-box ERROR TITLE "".
      124               return error.
      125           end.
      126   PROCEDURE gen-bc:
      127     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      128     def output parameter full-b-code     as character init ""    no-undo .
      129   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     define variable tmp-str3  as character no-undo.
      131     define variable tmp-num3  as character no-undo.
      132     define variable i3        as integer   no-undo.
      133     define variable sum3      as integer   no-undo.
      134     define variable len-code3 as integer   no-undo.
      135     define variable varcont3  as logical   initial yes no-undo.
      136     CASE bc-frmt :
      137       WHEN "EAN13" THEN do:
      138         assign
      139           tmp-str3 = string( internal-b-code, "999999999999" )
      140         .
      141       end.
      142       WHEN "EAN8" THEN do:
      143         assign
      144           tmp-str3 = string( internal-b-code, "9999999" )
      145         .
      146       end.
      147       OTHERWISE DO:
      148           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      149           view-as alert-box error.
      150           return error.
      151       END.
      152     END CASE.
      153     if varcont3 = yes then do:
      154       if integer( substring( tmp-str3, 1, length( bc-pfx ) ) ) <> 0
      155       then do:
      156         message
      157           "Невозможно сформировать бар-код" SKIP
      158           "для товара с кодом: " internal-b-code
      159           view-as alert-box error title "подрезание кода".
      160         return error.
      161       end.
      162       else do:
      163         assign
      164           full-b-code = bc-pfx + substring( tmp-str3, length( bc-pfx ) + 1, length( tmp-str3 ) - length( bc-pfx ) )
      165           len-code3    = length( full-b-code )
      166         .
      167         define variable v-sum-char3 as character no-undo .
      168         assign
      169           sum3 = 0
      170         .
      171         do i3 = 1 to len-code3 by 2
      172         :
      173           assign
      174             v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      175           .
      176           if v-sum-char3 < "0"
      177           or v-sum-char3 > "9"
      178           then do:
      179             message
      180               "Невозможно сформировать бар-код" skip
      181               "для товара с кодом: " internal-b-code skip
      182               view-as alert-box error title "подсчет контрольной суммы".
      183             return error.
      184           end.
      185           assign
      186             sum3 = sum3 + integer(v-sum-char3)
      187           .
      188         end.
      189         if varcont3 = yes then do:
      190           assign
      191             sum3 = sum3 * 3
      192           .
      193           do i3 = 2 to len-code3 by 2
      194           :
      195             assign
      196               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      197             .
      198             if v-sum-char3 < "0"
      199             or v-sum-char3 > "9"
      200             then do:
      201               message
      202                 "Невозможно сформировать бар-код" skip
      203                 "для товара с кодом: " internal-b-code skip
      204                 view-as alert-box error title "подсчет контрольной суммы".
      205               return error.
      206             end.
      207             assign
      208               sum3 = sum3 + integer(v-sum-char3)
      209             .
      210           end.
      211           if varcont3 = yes then do:
      212              if sum3 mod 10 = 0 then do:
      213                assign
      214                  full-b-code = full-b-code + '0'
      215                .
      216              end.
      217              else do:
      218                assign
      219                  full-b-code = full-b-code + string(10 - sum3 mod 10)
      220                .
      221              end.
      222           end.
      223         end.
      224       end.
      225     end.
      226   END PROCEDURE.
