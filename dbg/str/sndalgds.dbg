     8032             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8033             cash-gds-discnt.obj-type = parobj-type
     8034             cash-gds-discnt.obj-code = parobj-code
     8035             cash-gds-discnt.discnt-value = v-disc-price-sale
     8036             .
