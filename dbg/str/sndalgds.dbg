     7597   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7598   PROCEDURE asc-gds.
     7599   DEFINE parameter buffer loc-goods for ub.goods.
     7600   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7601   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7602   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7603   DEFINE parameter buffer loc-price-list for ub.price-list.
     7604   DEFINE parameter buffer loc-units for ub.units.
     7605   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7606   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7607   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7608   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7609   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7610   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7611   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7612   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7613   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7614   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7615   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7616   define variable v-disc-price-sale as decimal no-undo .
     7617   define variable v-pdf-id as integer no-undo .
     7618   define variable v-pdf-db-num as integer no-undo .
     7619   define variable v-oss as character no-undo.
     7620   define variable v-gtd as character no-undo .
     7621   define variable v-is-gas as character no-undo .
     7622   define variable v-ban-bonus as character no-undo .
     7623   define variable v-ptrl-as-good as character no-undo .
     7624   define variable v-type as character no-undo .
     7625   define variable disc-b-code as integer no-undo .
     7626   define variable v-main-prt-b-code as integer no-undo .
     7627   define variable IBM-good-code as character no-undo .
     7628   define variable IBM-good-code-2 as character no-undo .
     7629   define variable IBM2-short      as character no-undo .
     7630   define variable v-gds-null-price as character no-undo .
     7631   define variable iii as integer no-undo .
     7632   define variable v-mask-full as character no-undo .
     7633   define variable v-mask-short as character no-undo .
     7634   define variable vKKT as integer no-undo.
     7635   define variable attrValue as character no-undo.
     7636   define variable attrType  as character no-undo.
     7637   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7638   define buffer buf_price-list for ub.price-list.
     7639   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7640   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7641   define buffer main-prt-bar-code  for ub.bar-code.
     7642   define buffer buf_goods-attr for goods-attr.
     7643   define buffer b-code for code.
     7644   if action = "U" then do:
     7645     if loc-bar-code.stts = Integer('79':U) then return.
     7646       for-price = ?.
     7647   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7649     (input  'маг':U
     7650     ,input  ub.shop.obj-code
     7651     ,input  loc-bar-code.b-code
     7652     ,input  main-b-code
     7653     ,input  0
     7654     ,output v-doc-num
     7655     ,output for-price
     7656     ,output for-road
     7657     ,output for-excise
     7658     ) no-error .
     7659       if error-status:error then do:
     7660           if g#news
     7661           or g#auto
     7662           or g#esys
     7663           then return error.
     7664           else do:
     7665               error-status:error = no.
     7666               message "Ошибка при определении цены на товар "
     7667                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7668               view-as alert-box ERROR.
     7669               return.
     7670           end.
     7671       end.
     7672       if return-value = "error" then do:
     7673           if for-price = ? then do:
     7674             return.
     7675           end.
     7676           if not g#news
     7677           and not g#auto
     7678           and not g#esys
     7679           then
     7680           message prichina view-as alert-box ERROR.
     7681           return error.
     7682       end.
     7683       else if (for-price = ? or for-price = 0) then do:
     7684         if v-is-restaurant and v-is-null-price  then do:
     7685           assign
     7686           for-price = 0.
     7687         end.
     7688         else do:
     7689           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7690                                                  ,input 'null-price':U
     7691                                                  ,output v-gds-null-price
     7692                                                  ,output v-type) no-error.
     7693           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7694           return "NEXT".
     7695         end.
     7696       end.
     7697     end.
     7698     else do:
     7699           for-price = 0.
     7700     end.
     7701   for-price = round-m( for-price , rnd-znak ).
     7702   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7703   start-paket = no.
     7704   if not avail cash-gds then do:
     7705   create cash-gds.
     7706   error-status:error = false.
     7707   end.
     7708   cash-gds.crf = cr + 1.
     7709   cr = cr + 1.
     7710   if loc-bar-code.in-code <> ''
     7711   or loc-bar-code.part-code <> ''
     7712   then do:
     7713     find first main-prt-bar-code no-lock where
     7714               main-prt-bar-code.gds-code = loc-goods.gds-code
     7715           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7716           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7717           and main-prt-bar-code.part-code = ''
     7718           and main-prt-bar-code.in-code = '' no-error.
     7719     if available main-prt-bar-code then do:
     7720       v-main-prt-b-code = main-prt-bar-code.b-code.
     7721     end.
     7722   end.
     7723   else do:
     7724     v-main-prt-b-code = loc-bar-code.b-code.
     7725   end.
     7726   find first tt-tax no-lock where
     7727              tt-tax.tax-code = vattaxcd no-error .
     7728   do iii = 1 to num-entries(mask_s-c) :
     7729     assign
     7730       v-mask-full  = trim(entry(iii, mask_s-c))
     7731       v-mask-short = entry(1, v-mask-full, "*")
     7732       loc-prod-bc  = trim(loc-prod-bc)
     7733     .
     7734     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7735       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7736   end.
     7737   define variable vBc-on as logical no-undo.
     7738   if loc-prod-bc ne ?
     7739   then do:
     7740       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7741                            and prod-bc.b-str  eq loc-prod-bc
     7742                            no-lock no-error.
     7743       if available prod-bc
     7744       then
     7745          vBc-on = prod-bc.bc-on.
     7746       else
     7747          vBc-on = yes.
     7748   end.
     7749   else
     7750      vBc-on = yes.
     7751   run gdsoattr-value in this-procedure (
     7752     'dt-seasons':U,
     7753     loc-goods.gds-code,
     7754     parobj-type,
     7755     parobj-code,
     7756     output attrValue,
     7757     output attrType
     7758   ) no-error.
     7759   if attrValue <> "" then do:
     7760     find first b-code where
     7761                b-code.parent = "DTSeasons"
     7762            and b-code.code   = attrValue
     7763          no-lock no-error.
     7764     v-main-prt-b-code = integer(b-code.code).
     7765   end.
     7766   else release b-code.
     7767   assign
     7768   cash-gds.gds-code = loc-goods.gds-code
     7769   cash-gds.artic = loc-goods.artic
     7770   cash-gds.b-code = loc-bar-code.b-code
     7771   cash-gds.main-prt-b-code = v-main-prt-b-code
     7772   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7773   cash-gds.bc-on-type = loc-bc-on-type
     7774   cash-gds.bc-on = vBc-on
     7775   cash-gds.unit-cli = loc-bar-code.unit-cli
     7776   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7777   cash-gds.std-discnt-rule = std-discnt-rule_
     7778   cash-gds.gds-namelong = loc-goods.gds-name
     7779   cash-gds.gds-name = IF nam-2str
     7780                       then if available b-code then b-code.codename else loc-goods.gds-name
     7781                       else (
     7782                             IF nam-artc
     7783                             then loc-goods.artic
     7784                             else if available b-code
     7785                                  then b-code.codename
     7786                                  else (if loc-goods.chk-name <> ""
     7787                                        then loc-goods.chk-name
     7788                                        else loc-goods.gds-name)
     7789                            )
     7790   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7791   cash-gds.unit-base = loc-goods.unit-base
     7792   cash-gds.grp-code = for-grp-code
     7793   cash-gds.fp = for-fp
     7794   cash-gds.ingredient = loc-goods.struct
     7795   cash-gds.producer = for-producer
     7796   cash-gds.producer-int = for-producer-int
     7797   cash-gds.alpha1     = loc-goods.alpha1.
     7798     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7799                                            ,input 'office-type':U
     7800                                            ,output v-oss
     7801                                            ,output v-type) no-error.
     7802   cash-gds.office-type = v-oss.
     7803     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7804                                            ,input 'type-method-calc':U
     7805                                            ,output v-oss
     7806                                            ,output v-type) no-error.
     7807   if v-oss <> "" then
     7808     assign
     7809       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7810       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7811     .
     7812   else
     7813     assign
     7814       cash-gds.CalculationMethod = 0
     7815       cash-gds.CalculationMethodRestr = 0
     7816     .
     7817   assign
     7818   cash-gds.fact-qnty = for-fact-qnty
     7819   cash-gds.okei = loc-bc-units-okei
     7820   cash-gds.kat-discnt-method = kat-discnt-method_
     7821   cash-gds.temp-discnt-method = temp-discnt-method_
     7822   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7823                                then  kat-discnt-rule_pdf
     7824                                else  kat-discnt-rule_)
     7825   cash-gds.date-discnt-rule = date-discnt-rule_
     7826   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7827   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7828   cash-gds.wgd-rule = for-wgd
     7829   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7830                           then 1
     7831                           else 0)
     7832   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7833                        or for-petrol-purse
     7834                        then (cash-gds.gds-stat + 8)
     7835                        else cash-gds.gds-stat)
     7836   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7837                       then (cash-gds.gds-stat + 16)
     7838                       else cash-gds.gds-stat
     7839   cash-gds.gds-stat = if cash-gds.fp
     7840                       then (cash-gds.gds-stat + 2)
     7841                       else cash-gds.gds-stat
     7842   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7843                       then (cash-gds.gds-stat + 128)
     7844                       else cash-gds.gds-stat
     7845   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7846   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7847                                then temp-discnt-rule_pdf
     7848                                else temp-discnt-rule_)
     7849   cash-gds.wd-rule = for-wd
     7850   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7851   cash-gds.need-auth = (if need-auth then 1 else 0)
     7852   cash-gds.price-sale =  for-price
     7853   cash-gds.unit-type = loc-units.type
     7854   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7855   cash-gds.tax-string = tax-string
     7856   cash-gds.new-good = new-good
     7857   cash-gds.rc = recid(loc-goods)
     7858   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7859   cash-gds.vat-pc = (if avail tt-tax
     7860                      then tt-tax.rate-value
     7861                      else 0)
     7862   cash-gds.vat-code = (if avail tt-tax
     7863                        then tt-tax.rate-code
     7864                        else ?)
     7865   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7866   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7867   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7868   cash-gds.fbr-grp-code = v-fbr-grp-code
     7869   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7870   cash-gds.DepartID = v-fbr-obj-code
     7871   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7872   cash-gds.node-code = loc-bar-code.node-code
     7873   cash-gds.taracode = for-taracode
     7874   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7875                            and loc-bar-code.in-code = ""
     7876                            and loc-bar-code.part-code = ""
     7877                            and cash-gds.unit-base = cash-gds.unit-cli
     7878                            then yes
     7879                            else no)
     7880   cash-gds.obj-type = parobj-type
     7881   cash-gds.obj-code = parobj-code
     7882   .
     7883   assign
     7884   cash-gds.gds-name1 =   name-2cdf(
     7885                         input name-2cd
     7886                       , input yes
     7887                       , input cod-pcod
     7888                       , input cash-gds.b-code
     7889                       , input loc-goods.gds-code
     7890                       , input loc-goods.artic
     7891                       , input loc-goods.engl-name
     7892                       , input loc-bar-code.in-code
     7893                       , input loc-bar-code.part-code
     7894                       , input parobj-type
     7895                       , input parobj-code
     7896                       , input loc-goods.alpha1
     7897                       , output v-gtd
     7898                       )
     7899   cash-gds.gtd   = v-gtd
     7900   .
     7901   vKKT = 255.
     7902   find first b-code where
     7903              b-code.parent  = "okei-kkt"
     7904          and b-code.code    = string(cash-gds.okei)
     7905          and b-code.status_ = 0
     7906   no-lock no-error.
     7907   if avail b-code then
     7908      vKKT = integer(b-code.CodeName) no-error.
     7909   if error-status:error then vKKT = 255.
     7910   cash-gds.kkt = vKKT.
     7911   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7912      run gds-attr-value in this-procedure  (
     7913                                             input cash-gds.gds-code
     7914                                            ,input 'fuel-type':U
     7915                                            ,output v-is-gas
     7916                                            ,output v-type) no-error.
     7917      run gds-attr-value in this-procedure  (
     7918                                             input cash-gds.gds-code
     7919                                            ,input 'ptrl-as-good':U
     7920                                            ,output v-ptrl-as-good
     7921                                            ,output v-type) no-error.
     7922      assign
     7923      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7924      no-error .
     7925      assign
     7926      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7927      no-error .
     7928      if cash-gds.is-gas then do:
     7929        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7930      end.
     7931   end.
     7932      run gds-attr-value in this-procedure  (
     7933                                             input cash-gds.gds-code
     7934                                            ,input 'ban-bonus':U
     7935                                            ,output v-ban-bonus
     7936                                            ,output v-type) no-error.
     7937     assign
     7938      cash-gds.wd = int(logical(v-ban-bonus))
     7939      no-error .
     7940   if how-temp-disc = 'temp-disc':U then do:
     7941     case temp-discnt-method_:
     7942       when "" then do:
     7943       end.
     7944       when "bar-code.b-code" then do:
     7945         if loc-bar-code.in-code <> ''
     7946         or loc-bar-code.part-code <> ''
     7947         then do:
     7948           disc-b-code = cash-gds.main-prt-b-code.
     7949         end.
     7950         else do:
     7951           disc-b-code = cash-gds.b-code.
     7952         end.
     7953         find first buf_temp-dis-gds-rule where
     7954                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7955             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7956         if available buf_temp-dis-gds-rule then do:
     7957             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7958         end.
     7959       end.
     7960       otherwise do:
     7961         cash-gds.temp-discnt-rule = 0.
     7962       end.
     7963     end.
     7964   end.
     7965   assign
     7966   cash-gds.gds-name1 =   name-2cdf(
     7967                         input name-2cd
     7968                       , input yes
     7969                       , input cod-pcod
     7970                       , input cash-gds.b-code
     7971                       , input loc-goods.gds-code
     7972                       , input loc-goods.artic
     7973                       , input loc-goods.engl-name
     7974                       , input loc-bar-code.in-code
     7975                       , input loc-bar-code.part-code
     7976                       , input parobj-type
     7977                       , input parobj-code
     7978                       , input loc-goods.alpha1
     7979                       , output v-gtd
     7980                       )
     7981   cash-gds.gtd   = v-gtd
     7982   .
