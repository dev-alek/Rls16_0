    14089   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14090   define variable v-found121 as logical no-undo .
    14091   define variable v-is-script121 as logical no-undo.
    14092   define variable v-fields-shift121 as integer no-undo .
    14093      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    14094      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    14095      then do:
    14096        v-fields-shift121 = - 1.
    14097   if v-record <> '':U then
    14098       run maria-put in this-procedure (
    14099                                       buffer for-cash-desk
    14100                                     , input out
    14101                                     , input fname
    14102                                     , input yes
    14103                                     , input v-fields-shift121
    14104                                     , input yes
    14105                                     , input 24
    14106                                     , input 1
    14107                                     , input string(1)
    14108                                     , input v-record
    14109                                       ).
    14110      end.
    14111   find first temp-tekka-tsk no-error.
    14112   if available temp-tekka-tsk then do:
    14113      v-found121 = yes.
    14114   end.
    14115   if v-found121 = yes then do:
    14116   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    14117   v-is-script121 = no.
    14118   for each temp-tekka-tsk:
    14119     if (temp-tekka-tsk.num-rec > 0
    14120     or temp-tekka-tsk.send-get = 'task')
    14121     and temp-tekka-tsk.task-num = fname then do:
    14122       export stream IBmSTREAM temp-tekka-tsk.
    14123       v-found121 = yes.
    14124     end.
    14125     if temp-tekka-tsk.is-script then do:
    14126       v-is-script121 = yes.
    14127     end.
    14128     delete temp-tekka-tsk.
    14129   end.
    14130   output stream IBMStream
    14131   close.
    14132   run write-log-and-file in p-log-handle (
    14133         input 1
    14134       , input log-file-name
    14135       , input 1
    14136       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
    14137                           , (out + fname)
    14138                           , chr(10)
    14139                           , (out + fname + '.tsk')
    14140                           )
    14141                                          ).
    14142   run str/runtekka.p (
    14143                        input parparentproc
    14144                       ,input p-parent-handle
    14145                       ,input p-log-handle
    14146                       ,input out
    14147                       ,input out
    14148                       ,input fname
    14149                       ,input v-remote
    14150                       ,input v-is-script121
    14151                       ) no-error .
    14152   if error-status:error then do:
    14153     for each temp-tekka-tsk:
    14154       os-delete value( temp-tekka-tsk.filename) .
    14155       delete temp-tekka-tsk.
    14156     end.
    14157     run write-log-and-file in p-log-handle (
    14158           input 1
    14159         , input log-file-name
    14160         , input 1
    14161         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    14162                              ,for-cash-desk.cash-num
    14163                              ,chr(10)
    14164                              ,return-value
    14165                           )
    14166                                           ).
    14167     assign
    14168     v-view-log = yes
    14169     .
    14170       for each temp-cd-plu:
    14171         delete temp-cd-plu.
    14172       end.
    14173     return "error":U.
    14174   end.
    14175   else do:
    14176     for each temp-cd-plu,
    14177         first buf_cd-plu where
    14178                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    14179                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    14180                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    14181                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    14182                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    14183       if temp-cd-plu.to-del = yes
    14184       and v-del-mrkt-gds
    14185       then do:
    14186         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    14187           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    14188           assign
    14189           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    14190           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    14191           .
    14192         end.
    14193         if buf_cd-plu.charkey_one = '':U then do:
    14194           delete buf_cd-plu.
    14195           NEXT.
    14196         end.
    14197       end.
    14198       if temp-cd-plu.charkey_two = "":U
    14199       then
