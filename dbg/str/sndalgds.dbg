    10048   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10049   procedure ibm-gdsc :
    10050   define input  parameter p-zeros         as logical no-undo .
    10051   define output parameter IBM-good-code as character no-undo .
    10052   define output parameter IBM-good-code-2 as character no-undo .
    10053   define output parameter IBM2-short      as character no-undo .
    10054   define variable v-delim as character no-undo .
    10055   define variable v-format-str-16 as character no-undo .
    10056     do
    10057     on error undo, return error
    10058     :
    10059       if p-zeros then do:
    10060         assign
    10061         v-delim = '0'
    10062         v-format-str-16 =  "9999999999999999"
    10063         .
    10064       end.
    10065       else do:
    10066         assign
    10067         v-delim = chr(32)
    10068         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10069         .
    10070       end.
    10071       if cash-gds.b-str = "" then do:
    10072         assign
    10073         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10074         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10075         or cash-gds.unit-base <> cash-gds.unit-cli
    10076         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10077         then
    10078         do:
    10079           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10080               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10081             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10082             iBM2-short = bar_code.
    10083             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10084           END.
    10085           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10086               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10087             IBM-good-code-2 = b_code.
    10088           end.
    10089         end.
    10090       end.
    10091       else do:
    10092         IBm-good-code =
    10093         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10094           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10095            or
    10096            cash-gds.bc-on-type = 'pglc':U)
    10097         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10098         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10099       end.
    10100     end.
    10101   end procedure.
    10102   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10103   procedure ncr-gdsc :
    10104   define output parameter IBM-good-code as character no-undo .
    10105   define output parameter IBM-good-code-2 as character no-undo .
    10106   define output parameter is-sc as logical no-undo .
    10107   define output parameter p-taracode-bc as character no-undo .
    10108   define variable v-taracode-bc as character no-undo .
    10109   define variable v-type as character no-undo .
    10110   define variable v-bc-buf as character no-undo .
    10111   define variable iii as integer no-undo .
    10112     do
    10113     on error undo, return error
    10114     :
    10115       if cash-gds.b-str = "" then do:
    10116         assign
    10117         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
    10118         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
    10119           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10120               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10121             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10122             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
    10123           end.
    10124           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10125               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10126             IBM-good-code-2 = b_code.
    10127           end.
    10128         end.
    10129       end.
    10130       else do:
    10131         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10132         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10133                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10134                              or
    10135                              cash-gds.bc-on-type = 'pglc':U)
    10136                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10137                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10138                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10139          if action <> "D":U then do:
    10140           is-sc = no.
    10141           find first request_prod-bc no-lock where
    10142                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10143           if not avail request_prod-bc then do :
    10144             if mask_s-c <> "" then do :
    10145               iii_ :
    10146               do iii = 1 to num-entries(mask_s-c) :
    10147                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10148                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10149                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10150                   if available request_prod-bc then leave iii_ .
    10151                 end.
    10152               end.
    10153             end.
    10154           end.
    10155           if avail request_prod-bc then do :
    10156             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10157   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10159     (buffer request_prod-bc
    10160     ,input  'scaleable=request'
    10161     ,output is-sc
    10162     ) no-error .
    10163             end.
    10164             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10165                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10166                then do:
    10167   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10168     define variable tmp-str85  as character no-undo.
    10169     define variable tmp-num85  as character no-undo.
    10170     define variable i85        as integer   no-undo.
    10171     define variable sum85      as integer   no-undo.
    10172     define variable len-code85 as integer   no-undo.
    10173     define variable varcont85  as logical   initial yes no-undo.
    10174     CASE ncrsc-frmt :
    10175       WHEN "EAN13" THEN do:
    10176         assign
    10177           tmp-str85 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10178         .
    10179       end.
    10180       WHEN "EAN8" THEN do:
    10181         assign
    10182           tmp-str85 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10183         .
    10184       end.
    10185       OTHERWISE DO:
    10186           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    10187           view-as alert-box error.
    10188           return error.
    10189       END.
    10190     END CASE.
    10191     if varcont85 = yes then do:
    10192       if integer( substring( tmp-str85, 1, length( ncrsc-pfx ) ) ) <> 0
    10193       then do:
    10194         message
    10195           "Невозможно сформировать бар-код" SKIP
    10196           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10197           view-as alert-box error title "подрезание кода".
    10198         return error.
    10199       end.
    10200       else do:
    10201         assign
    10202           IBm-good-code = ncrsc-pfx + substring( tmp-str85, length( ncrsc-pfx ) + 1, length( tmp-str85 ) - length( ncrsc-pfx ) )
    10203           len-code85    = length( IBm-good-code )
    10204         .
    10205         define variable v-sum-char85 as character no-undo .
    10206         assign
    10207           sum85 = 0
    10208         .
    10209         do i85 = 1 to len-code85 by 2
    10210         :
    10211           assign
    10212             v-sum-char85 = substr(IBm-good-code, len-code85 - i85 + 1, 1)
    10213           .
    10214           if v-sum-char85 < "0"
    10215           or v-sum-char85 > "9"
    10216           then do:
    10217             message
    10218               "Невозможно сформировать бар-код" skip
    10219               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10220               view-as alert-box error title "подсчет контрольной суммы".
    10221             return error.
    10222           end.
    10223           assign
    10224             sum85 = sum85 + integer(v-sum-char85)
    10225           .
    10226         end.
    10227         if varcont85 = yes then do:
    10228           assign
    10229             sum85 = sum85 * 3
    10230           .
    10231           do i85 = 2 to len-code85 by 2
    10232           :
    10233             assign
    10234               v-sum-char85 = substr(IBm-good-code, len-code85 - i85 + 1, 1)
    10235             .
    10236             if v-sum-char85 < "0"
    10237             or v-sum-char85 > "9"
    10238             then do:
    10239               message
    10240                 "Невозможно сформировать бар-код" skip
    10241                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10242                 view-as alert-box error title "подсчет контрольной суммы".
    10243               return error.
    10244             end.
    10245             assign
    10246               sum85 = sum85 + integer(v-sum-char85)
    10247             .
    10248           end.
    10249           if varcont85 = yes then do:
    10250              if sum85 mod 10 = 0 then do:
    10251                assign
    10252                  IBm-good-code = IBm-good-code + '0'
    10253                .
    10254              end.
    10255              else do:
    10256                assign
    10257                  IBm-good-code = IBm-good-code + string(10 - sum85 mod 10)
    10258                .
    10259              end.
    10260           end.
    10261         end.
    10262       end.
    10263     end.
    10264             end.
    10265             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10266                cash-gds.bc-on-type = 'pglc':U
    10267                then do:
    10268   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10269     define variable tmp-str86  as character no-undo.
    10270     define variable tmp-num86  as character no-undo.
    10271     define variable i86        as integer   no-undo.
    10272     define variable sum86      as integer   no-undo.
    10273     define variable len-code86 as integer   no-undo.
    10274     define variable varcont86  as logical   initial yes no-undo.
    10275     CASE ncrpg-frmt :
    10276       WHEN "EAN13" THEN do:
    10277         assign
    10278           tmp-str86 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10279         .
    10280       end.
    10281       WHEN "EAN8" THEN do:
    10282         assign
    10283           tmp-str86 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10284         .
    10285       end.
    10286       OTHERWISE DO:
    10287           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrpg-frmt " ."
    10288           view-as alert-box error.
    10289           return error.
    10290       END.
    10291     END CASE.
    10292     if varcont86 = yes then do:
    10293       if integer( substring( tmp-str86, 1, length( ncrpg-pfx ) ) ) <> 0
    10294       then do:
    10295         message
    10296           "Невозможно сформировать бар-код" SKIP
    10297           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10298           view-as alert-box error title "подрезание кода".
    10299         return error.
    10300       end.
    10301       else do:
    10302         assign
    10303           IBm-good-code = ncrpg-pfx + substring( tmp-str86, length( ncrpg-pfx ) + 1, length( tmp-str86 ) - length( ncrpg-pfx ) )
    10304           len-code86    = length( IBm-good-code )
    10305         .
    10306         define variable v-sum-char86 as character no-undo .
    10307         assign
    10308           sum86 = 0
    10309         .
    10310         do i86 = 1 to len-code86 by 2
    10311         :
    10312           assign
    10313             v-sum-char86 = substr(IBm-good-code, len-code86 - i86 + 1, 1)
    10314           .
    10315           if v-sum-char86 < "0"
    10316           or v-sum-char86 > "9"
    10317           then do:
    10318             message
    10319               "Невозможно сформировать бар-код" skip
    10320               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10321               view-as alert-box error title "подсчет контрольной суммы".
    10322             return error.
    10323           end.
    10324           assign
    10325             sum86 = sum86 + integer(v-sum-char86)
    10326           .
    10327         end.
    10328         if varcont86 = yes then do:
    10329           assign
    10330             sum86 = sum86 * 3
    10331           .
    10332           do i86 = 2 to len-code86 by 2
    10333           :
    10334             assign
    10335               v-sum-char86 = substr(IBm-good-code, len-code86 - i86 + 1, 1)
    10336             .
    10337             if v-sum-char86 < "0"
    10338             or v-sum-char86 > "9"
    10339             then do:
    10340               message
    10341                 "Невозможно сформировать бар-код" skip
    10342                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10343                 view-as alert-box error title "подсчет контрольной суммы".
    10344               return error.
    10345             end.
    10346             assign
    10347               sum86 = sum86 + integer(v-sum-char86)
    10348             .
    10349           end.
    10350           if varcont86 = yes then do:
    10351              if sum86 mod 10 = 0 then do:
    10352                assign
    10353                  IBm-good-code = IBm-good-code + '0'
    10354                .
    10355              end.
    10356              else do:
    10357                assign
    10358                  IBm-good-code = IBm-good-code + string(10 - sum86 mod 10)
    10359                .
    10360              end.
    10361           end.
    10362         end.
    10363       end.
    10364     end.
    10365             end.
    10366           end.
    10367         end.
    10368       end.
    10369       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10370       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
    10371             or
    10372             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
    10373       then do:
    10374           run bc-oattr_value in this-procedure ( input cash-gds.b-code
    10375                                               ,input 'taracode-bc':U
    10376                                               ,input 'маг':U
    10377                                               ,input i-obj-code
    10378                                               ,output v-taracode-bc
    10379                                               ,output v-type) no-error.
    10380           if not error-status:error
    10381           and v-taracode-bc <> '' then do:
    10382             is-sc = yes.
    10383             p-taracode-bc = v-taracode-bc.
    10384           end.
    10385       end.
    10386     end.
    10387   end procedure.
    10388   procedure finish-send :
    10389     do
    10390     on error undo, return error
    10391     :
    10392   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10393   if v-view-log
    10394   and not g#news
    10395   and not g#auto
    10396   then do:
    10397     message
    10398     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10399     "!!!Внимательно прочитайте Log-file!!"
    10400     view-as alert-box error .
    10401        define variable v-user-action88   as character no-undo .
    10402     define variable v-printed88       as logical   no-undo .
    10403     run gbl/prnfilen.w
    10404       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10405       ,input  0
    10406       ,input  (string("./":U) + log-file-name)
    10407       ,input  7
    10408       ,output v-user-action88
    10409       ,output v-printed88
    10410       ) .
    10411   end.
    10412   if v-view-log = true
    10413   and (g#news
    10414   or g#auto)
    10415   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10416   then do:
    10417      run cb_set-view-log in p-parent-handle ( input yes).
    10418   end.
    10419       define variable v-save-file-name as character no-undo .
    10420       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10421       OS-APPEND value(log-file-name) value(v-save-file-name).
    10422       OS-DELETE value(log-file-name).
    10423     end.
    10424   end procedure.
    10425   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
    10426   PROCEDURE putc-gds.
    10427   define parameter buffer buf_cash-desk for ub.cash-desk.
    10428   define input parameter pos-type as char no-undo.
    10429   define input parameter p-version like ub.cash-desk.version no-undo .
    10430   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    10431   define variable ff  as  int     no-undo.
