    11128           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
    11129           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
    11130           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
    11131                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
    11132                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
    11133                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
    11134                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
    11135                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
    11136                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
    11137           .
