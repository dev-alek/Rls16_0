     6312   define variable v-trn-pay-code  as integer   no-undo .
     6313   define variable v-cash-pay-curr as integer   no-undo .
     6314   define variable v-cash-pay-code as integer   no-undo .
     6315   do
     6316   on error undo, return error return-value
     6317   :
     6318   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6319   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6320   if p-fact-order = ? then do:
     6321     run fact-order-mpl (
     6322         input   today       ,
     6323         input   p-obj-type  ,
     6324         input   p-obj-code  ,
     6325         output  p-fact-order ).
     6326   end.
     6327   if p-vid-pay <> "" then do:
     6328      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6329      if available buf_pay-type
     6330         then v-trn-pay-code = buf_pay-type.obj-code.
     6331         else v-trn-pay-code =  0.
     6332   end.
     6333   else v-trn-pay-code = 0 .
     6334   if p-cash-pay-type <> "" then do:
     6335      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6336      if available buf_pay-type
     6337         then
     6338           assign
     6339             v-cash-pay-curr = buf_cash-pay.curr-code
     6340             v-cash-pay-code = buf_cash-pay.cdpay-code
     6341           .
     6342         else
     6343           assign
     6344             v-cash-pay-curr = 0
     6345             v-cash-pay-code = 0
     6346             .
     6347   end.
     6348   else
     6349     assign
     6350       v-cash-pay-curr = 0
     6351       v-cash-pay-code = 0
     6352       .
     6353   for each tt_price-all  : delete tt_price-all . end.
     6354   assign
     6355     p-plt-id             = ?
     6356     p-plt-db-num         = ?
     6357     p-pdf-id             = ?
     6358     p-pdf-db-num         = ?
     6359     p-sale-price-base    = ?
     6360     p-sale-price-rubl    = ?
     6361     v-cli-oborot         = 0
     6362   .
     6363   find first buf_global-state no-lock no-error .
     6364   if not available buf_global-state then do:
     6365      message
     6366        "Не заданы параметры ценообразования!"
     6367        view-as alert-box error
     6368      .
     6369      return error return-value .
     6370   end.
     6371   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6373     (input  p-obj-type
     6374     ,input  p-obj-code
     6375     ,output to-day
     6376     )  .
     6377   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6379     (input  p-obj-type
     6380     ,input  p-obj-code
     6381     ,output v-host-code
     6382     )  .
     6383   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6385     (input  v-host-code
     6386     ,input  to-day
     6387     ,output v-base-rate0
     6388     ,output v-base-scale0
     6389     )  .
     6390     v-cli-oborot-ALL  = 0 .
     6391     for each buf_turnover-buyer-main no-lock  where
     6392              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6393              buf_turnover-buyer-main.cli-code = p-cli-code
     6394              :
     6395              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6396     end.
     6397   for each buf_price-all no-lock where
     6398            buf_price-all.obj-type = p-obj-type and
     6399            buf_price-all.obj-code = p-obj-code and
     6400            buf_price-all.gds-code = buf_goods.gds-code and
     6401            buf_price-all.status_  = 'акт':U  and
     6402          ( p-only-b-code = false   or
     6403          ( buf_price-all.b-code = p-main-b-code or
     6404            buf_price-all.b-code = p-b-code))    and
     6405           ( p-only-b-code = true  or
     6406             buf_price-all.b-code = p-b-code)
     6407             and
     6408             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6409           ( buf_price-all.fact-order-sys-to = ? or
     6410             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6411           :
     6412            v-interv   = "" .
     6413            v-grp-name = "" .
     6414            v-pay-name = "" .
     6415            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6416            if buf_price-all.bgr-id > 0 then do:
     6417               find first buf_buyer-group no-lock where
     6418                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6419                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6420               if available buf_buyer-group then do:
     6421                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6422                  find first buf_buyer-in-buyer-group no-lock where
     6423                             buf_buyer-in-buyer-group.stts         = 0 and
     6424                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6425                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6426                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6427                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6428                             no-error .
     6429                             if not available buf_buyer-in-buyer-group then do:
     6430                                v-grp-name = "".
     6431                                next.
     6432                             end.
     6433                             v-grp-name = buf_buyer-group.name .
     6434                  end.
     6435               end.
     6436               else do:
     6437                    v-grp-name = "".
     6438                    next.
     6439               end.
     6440            end.
     6441            if buf_price-all.tog-id > 0 then do:
     6442               find first buf_turnover-group no-lock where
     6443                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6444                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6445               if available buf_turnover-group then do:
     6446                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6447                     v-cli-oborot = v-cli-oborot-all  .
     6448                     find first buf1_tnv-in-turnover-group no-lock where
     6449                                buf1_tnv-in-turnover-group.stts       =  0     and
     6450                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6451                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6452                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6453                     find first buf2_tnv-in-turnover-group no-lock where
     6454                                buf2_tnv-in-turnover-group.stts       =  0     and
     6455                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6456                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6457                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6458                     if not (available buf1_tnv-in-turnover-group and
     6459                             available buf2_tnv-in-turnover-group ) then do:
     6460                             v-grp-name = "".
     6461                             next .
     6462                     end.
     6463                     v-grp-name = buf_turnover-group.name.
     6464                  end.
     6465               end.
     6466               else do:
     6467                    v-grp-name = "".
     6468                    next.
     6469               end.
     6470            end.
     6471            if buf_price-all.plt-fix-cource-crc-base = true then
     6472               assign
     6473                 v-base-rate  = buf_price-all.pdf-base-rate
     6474                 v-base-scale = buf_price-all.pdf-base-scale
     6475               .
     6476               else
     6477               assign
     6478                 v-base-rate  = v-base-rate0
     6479                 v-base-scale = v-base-scale0
     6480               .
     6481            if buf_price-all.plt-fix-cource-crc-doc = true then
     6482               assign
     6483                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6484                 v-exch-scale = buf_price-all.pdf-exch-scale
     6485               .
     6486               else do:
     6487   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6489     (input  buf_price-all.curr-code
     6490     ,input  to-day
     6491     ,output v-exch-rate0
     6492     ,output v-exch-scale0
     6493     ,output v-curr-abbr
     6494     )  .
     6495               assign
     6496                 v-exch-rate  = v-exch-rate0
     6497                 v-exch-scale = v-exch-scale0
     6498                 .
     6499              end.
     6500              v-date-1 = date ( "" )  .
     6501              if buf_price-all.fact-order-sys-from > 0 then do:
     6502                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6503                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6504                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6505              end.
     6506              v-date-2 =  date ( "" )  .
     6507              if buf_price-all.fact-order-sys-to > 0 then do:
     6508                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6509                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6510                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6511              end.
     6512              if buf_price-all.qnty-from <> ? then do :
     6513                 if not (
     6514                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6515                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6516                 ) then do:
     6517                        v-interv = "".
     6518                        next.
     6519                 end.
     6520                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6521              end.
     6522              if buf_price-all.sum-from <> ? then do :
     6523                 if not (
     6524                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6525                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6526                 ) then do:
     6527                    v-interv = "".
     6528                    next.
     6529                 end.
     6530                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6531              end.
     6532              if buf_price-all.turnover-from <> ? then do :
     6533                 if not (
     6534                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6535                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6536                 ) then do:
     6537                    v-interv = "".
     6538                    next.
     6539                 end.
     6540                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6541              end.
     6542              if buf_price-all.use-pay-type = 1 then do :
     6543                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6544                    v-pay-name = "" .
     6545                    next.
     6546                  end.
     6547                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6548              end.
     6549              if buf_price-all.use-cash-pay = 1 then do :
     6550                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6551                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6552                   v-pay-name = "" .
     6553                   next.
     6554                 end.
     6555                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6556              end.
     6557             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6558             create tt_price-all .
     6559             buffer-copy buf_price-all to tt_price-all
     6560             assign
     6561               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6562               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6563               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6564               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6565               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6566               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6567               tt_price-all.price-sale     = buf_price-all.price-sale
     6568               tt_price-all.road-tax       = buf_price-all.road-tax
     6569               tt_price-all.excise         = buf_price-all.excise
     6570               tt_price-all.pdf-exch-rate   = v-exch-rate
     6571               tt_price-all.pdf-exch-scale  = v-exch-scale
     6572               tt_price-all.pdf-base-rate   = v-base-rate
     6573               tt_price-all.pdf-base-scale  = v-base-scale
     6574               tt_price-all.grp-name        = v-grp-name
     6575               tt_price-all.date-1          = v-date-1
     6576               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6577               tt_price-all.time-1          = buf_price-all.start-sys-time
     6578               tt_price-all.date-2          = v-date-2
     6579               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6580               tt_price-all.time-2          = buf_price-all.end-sys-time
     6581               tt_price-all.interv-name     = v-interv
     6582               tt_price-all.pay-name        = v-pay-name
     6583               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6584             .
     6585   end.
     6586   define variable vt-plt-id as integer   no-undo .
     6587   define variable vt-plt-db as integer   no-undo .
     6588   define variable vt-pdf-id as integer   no-undo .
     6589   define variable vt-pdf-db as integer   no-undo .
     6590   define buffer neos_price-all for tt_price-all  .
     6591   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6592       if available tt_price-all then do:
     6593        assign
     6594          vt-plt-id = tt_price-all.plt-id
     6595          vt-plt-db = tt_price-all.plt-db-num
     6596          vt-pdf-id = tt_price-all.pdf-id
     6597          vt-pdf-db = tt_price-all.pdf-db
     6598        .
     6599        if tt_price-all.b-code = p-b-code then do:
     6600             assign
     6601               p-plt-id           = tt_price-all.plt-id
     6602               p-plt-db-num       = tt_price-all.plt-db-num
     6603               p-pdf-id           = tt_price-all.pdf-id
     6604               p-pdf-db-num       = tt_price-all.pdf-db
     6605               p-sale-price-base  = tt_price-all.price-sale-base
     6606               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6607               p-road-tax-base    = tt_price-all.road-tax-base
     6608               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6609               p-excise-base      = tt_price-all.excise-base
     6610               p-excise-rubl      = tt_price-all.excise-rubl
     6611               .
     6612        end.
     6613        else do:
     6614          find first neos_price-all where
     6615                     neos_price-all.b-code     = p-b-code  and
     6616                     neos_price-all.plt-id     = vt-plt-id and
     6617                     neos_price-all.plt-db-num = vt-plt-db and
     6618                     neos_price-all.pdf-id     = vt-pdf-id and
     6619                     neos_price-all.pdf-db     = vt-pdf-db
     6620                     use-index pi no-error .
     6621            if available neos_price-all then do:
     6622             assign
     6623               p-plt-id           = tt_price-all.plt-id
     6624               p-plt-db-num       = tt_price-all.plt-db-num
     6625               p-pdf-id           = tt_price-all.pdf-id
     6626               p-pdf-db-num       = tt_price-all.pdf-db
     6627               p-sale-price-base  = neos_price-all.price-sale-base
     6628               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6629               p-road-tax-base    = neos_price-all.road-tax-base
     6630               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6631               p-excise-base      = neos_price-all.excise-base
     6632               p-excise-rubl      = neos_price-all.excise-rubl
     6633               .
     6634            end.
     6635            else do:
     6636                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6637                 if error-status :error    then do:
     6638                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6639                   return error return-value .
     6640                 end.
     6641             assign
     6642               p-plt-id           = tt_price-all.plt-id
     6643               p-plt-db-num       = tt_price-all.plt-db-num
     6644               p-pdf-id           = tt_price-all.pdf-id
     6645               p-pdf-db-num       = tt_price-all.pdf-db
     6646               p-sale-price-base  = tt_price-all.price-sale-base
     6647               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6648               p-road-tax-base    = tt_price-all.road-tax-base
     6649               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6650               p-excise-base      = tt_price-all.excise-base
     6651               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6652               .
     6653            end.
     6654        end.
     6655     end.
     6656   end.
     6657   end procedure.
     6658   procedure mpl-tpl-auto :
     6659   define input  parameter p-b-code     as integer   no-undo .
     6660   define input  parameter p-obj-type   as character no-undo .
     6661   define input  parameter p-obj-code   as integer   no-undo .
     6662   define input  parameter p-plt-id     as integer   no-undo .
     6663   define input  parameter p-plt-db-num as integer   no-undo .
     6664   define input  parameter p-fact-order as decimal   no-undo .
     6665   define output parameter p-sale-price as decimal   no-undo .
     6666   define output parameter p-pdf-id     as integer   no-undo .
     6667   define output parameter p-pdf-db-num as integer   no-undo .
     6668     do
     6669     on error undo, return error return-value
     6670     :
     6671   if p-fact-order = ? then do:
     6672     run fact-order-mpl (
     6673         input   today       ,
     6674         input   p-obj-type  ,
     6675         input   p-obj-code  ,
     6676         output  p-fact-order ) .
     6677   end.
     6678   assign
     6679     p-pdf-id      = ?
     6680     p-pdf-db-num  = ?
     6681     p-sale-price  = ?
     6682   .
     6683   define buffer buf_bar-code for ub.bar-code  .
     6684   define buffer buf_goods for ub.goods  .
     6685   find first buf_bar-code no-lock where
     6686              buf_bar-code.b-code = p-b-code
     6687              no-error .
     6688   if error-status :error then return error return-value .
     6689   find first buf_goods no-lock where
     6690              buf_goods.gds-code = buf_bar-code.gds-code
     6691              no-error .
     6692   if error-status :error then return error return-value .
     6693   define variable v-main-b-code as integer   no-undo .
     6694   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6695     (input  buf_goods.gds-code
     6696     ,input  ?
     6697     ,output v-main-b-code
     6698     )  .
     6699   define buffer buf_price-all for ub.price-all  .
     6700   for each tt_price-all : delete tt_price-all. end.
     6701       for each buf_price-all no-lock where
     6702               buf_price-all.plt-id     = p-plt-id                 and
     6703               buf_price-all.plt-db-num = p-plt-db-num             and
     6704               buf_price-all.obj-type   = p-obj-type               and
     6705               buf_price-all.obj-code   = p-obj-code               and
     6706               buf_price-all.gds-code   = buf_goods.gds-code       and
     6707             ( buf_price-all.b-code = v-main-b-code or
     6708               buf_price-all.b-code = p-b-code)    and
     6709               buf_price-all.status_    = 'акт':U         and
     6710               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6711             ( buf_price-all.fact-order-sys-to = ? or
     6712               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6713               :
     6714                 create tt_price-all .
     6715                 buffer-copy buf_price-all to tt_price-all
     6716                 assign
     6717                   tt_price-all.price-sale  = buf_price-all.price-sale
     6718                 .
     6719       end.
     6720   define variable vt-plt-id as integer   no-undo .
     6721   define variable vt-plt-db as integer   no-undo .
     6722   define variable vt-pdf-id as integer   no-undo .
     6723   define variable vt-pdf-db as integer   no-undo .
     6724   define buffer neos_price-all for tt_price-all  .
     6725   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6726       if available tt_price-all then do:
     6727        assign
     6728          vt-plt-id = tt_price-all.plt-id
     6729          vt-plt-db = tt_price-all.plt-db-num
     6730          vt-pdf-id = tt_price-all.pdf-id
     6731          vt-pdf-db = tt_price-all.pdf-db
     6732        .
     6733        if tt_price-all.b-code = p-b-code then do:
     6734             assign
     6735               p-plt-id           = tt_price-all.plt-id
     6736               p-plt-db-num       = tt_price-all.plt-db-num
     6737               p-pdf-id           = tt_price-all.pdf-id
     6738               p-pdf-db-num       = tt_price-all.pdf-db
     6739               p-sale-price       = tt_price-all.price-sale
     6740               .
     6741        end.
     6742        else do:
     6743          find first neos_price-all where
     6744                     neos_price-all.b-code     = p-b-code  and
     6745                     neos_price-all.plt-id     = vt-plt-id and
     6746                     neos_price-all.plt-db-num = vt-plt-db and
     6747                     neos_price-all.pdf-id     = vt-pdf-id and
     6748                     neos_price-all.pdf-db     = vt-pdf-db
     6749                     use-index pi no-error .
     6750            if available neos_price-all then do:
     6751             assign
     6752               p-plt-id           = tt_price-all.plt-id
     6753               p-plt-db-num       = tt_price-all.plt-db-num
     6754               p-pdf-id           = tt_price-all.pdf-id
     6755               p-pdf-db-num       = tt_price-all.pdf-db
     6756               p-sale-price       = neos_price-all.price-sale
     6757               .
     6758            end.
     6759            else do:
     6760           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6761           if error-status :error    then do:
     6762              message "Не найден бар-код" p-b-code view-as alert-box error .
     6763              return error return-value .
     6764           end.
     6765             assign
     6766               p-plt-id           = tt_price-all.plt-id
     6767               p-plt-db-num       = tt_price-all.plt-db-num
     6768               p-pdf-id           = tt_price-all.pdf-id
     6769               p-pdf-db-num       = tt_price-all.pdf-db
     6770               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6771               .
     6772            end.
     6773        end.
     6774     end.
     6775     end.
     6776   end procedure.
