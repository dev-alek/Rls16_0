     3013   procedure xml-cd-write-header:
     3014   do
     3015   on error undo, return error
     3016   :
     3017   define input parameter p-xml-file-name       as character    no-undo.
     3018   define input parameter p-xml-file-name-path  as character    no-undo.
     3019   define input parameter p-doc-name            as character    no-undo.
     3020   define input parameter p-version             as character    no-undo.
     3021   define input parameter p-obj-list            as character    no-undo.
     3022   define input parameter p-correspondent       as character    no-undo .
     3023   define input parameter p-write-header        as logical      no-undo .
     3024   define variable OS-time as character no-undo .
     3025   define variable id as character no-undo .
     3026   define buffer buf_db for ub.db.
     3027   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3028   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3029   assign
     3030   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3031   .
     3032   run bgelib-tag-open in this-procedure (
     3033                                        1
     3034                                       ,p-doc-name
     3035                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3036                                         ).
     3037   if p-write-header then do:
     3038     run bgelib-tag-open(2, "Header","").
     3039     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3040     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3041     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3042     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3043     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3044     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3045     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3046     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3047     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3048     run bgelib-tag-close( 2, "Header" ).
     3049   end.
     3050   output stream stmXMLOut close.
     3051   end.
     3052   end procedure.
     3053   procedure xml-cd-write-footer:
     3054   do
     3055   on error undo, return error
     3056   :
     3057   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3058   define input parameter p-xml-file-name as character    no-undo.
     3059   define input parameter p-doc-name      as character    no-undo .
     3060   define variable v-error-num     as integer           no-undo.
     3061   define variable v-md5-signature as character no-undo .
     3062   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3063   run bgelib-tag-close( 0, p-doc-name ).
     3064   put stream stmXMLOut unformatted skip.
     3065   output stream stmXMLOut close.
     3066   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3067   if v-error-num > 0
     3068   then do:
     3069      return error.
     3070   end.
     3071   if opsys = "unix"
     3072   then do:
     3073       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3074   end.
     3075   end.
     3076   end procedure.
     3077   procedure xml-cd-filename :
     3078   do
     3079   on error undo, return error
     3080   :
     3081   define input parameter  p-out               as character no-undo .
     3082   define output parameter p-xml-file-name     as character    no-undo.
     3083   define output parameter p-xml-file-name-path   as character    no-undo.
     3084   define output parameter p-log-file-name     as character    no-undo.
     3085   define output parameter p-locked            as logical      no-undo.
     3086   define variable v-out as character     no-undo.
     3087   define variable loc#log as logical no-undo .
     3088   define variable BadFlag as logical no-undo .
     3089   define variable fq as integer no-undo .
     3090   define variable v-remote as character no-undo .
     3091   assign
     3092   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3093   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3094   p-log-file-name = p-out + "actions.log"
     3095   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3096   .
     3097   end.
     3098   end procedure.
     3099   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3100   define variable v-date-str as character no-undo .
     3101   assign
     3102   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3103                string(Month(p-date), "99":U) + "-":U +
     3104                string(DAY(p-date), "99":U).
     3105   return v-date-str.
     3106   END FUNCTION.
     3107   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3108   define variable v-date-str as character no-undo .
     3109   assign
     3110   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3111                string(Month(p-date), "99":U) + "-":U +
     3112                string(DAY(p-date), "99":U) + chr(32) +
     3113                string(p-time, "HH:MM:SS").
     3114   return v-date-str.
     3115   END FUNCTION.
     3116   function string-to-date returns date ( input p-string  as character):
     3117     define variable v-date as date no-undo .
     3118     assign
     3119     v-date = date(integer(substring(p-string, 4, 2))
     3120                   ,integer(substring(p-string, 1, 2))
     3121                   ,integer(substring(p-string, 7, 4))
     3122                  ) no-error .
     3123     if error-status:error then return ?.
     3124     return v-date.
     3125   END FUNCTION.
     3126   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3127   define variable v-time as integer no-undo init ?.
     3128   define variable v-dop1 as character no-undo .
     3129   define variable v-dop2 as character no-undo .
     3130   assign
     3131   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3132   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3133   no-error .
     3134   if error-status:error then return ?.
     3135   assign
     3136   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3137             integer(entry(2, v-dop2, ";":U)) * 60 +
     3138             integer(entry(3, v-dop2, ";":U)) no-error .
     3139   return v-time.
     3140   END FUNCTION.
     3141   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3142   procedure gdcstcod_cst-code :
     3143     define input  parameter p-obj-type  as character no-undo .
     3144     define input  parameter p-obj-code  as integer   no-undo .
     3145     define input  parameter p-gds-code  as integer   no-undo .
     3146     define input  parameter p-in-code   as character no-undo .
     3147     define input  parameter p-part-code as character no-undo .
     3148     define output parameter p-cst-code  as character no-undo .
     3149     define buffer buf_goods for ub.goods .
     3150     define buffer buf_parts for ub.parts .
     3151     do
     3152     on error undo, return error return-value
     3153     :
     3154       assign
     3155         p-cst-code = ''
     3156       .
     3157       find first buf_goods no-lock
     3158         where buf_goods.gds-code = p-gds-code
     3159         no-error .
     3160       if not available buf_goods
     3161       then do:
     3162         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3163       end.
     3164       if p-in-code = ?
     3165       then do:
     3166         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3167       end.
     3168       if p-part-code = ?
     3169       then do:
     3170         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3171       end.
     3172       if p-in-code = '':u
     3173       then do:
     3174         find first buf_parts no-lock
     3175           where buf_parts.obj-type  = p-obj-type
     3176             and buf_parts.obj-code  = p-obj-code
     3177             and buf_parts.artic     = buf_goods.artic
     3178             and buf_parts.prod-type = buf_goods.prod-type
     3179             and buf_parts.prod-code = buf_goods.prod-code
     3180             and buf_parts.out-code  = 'free-zone':U
     3181             and buf_parts.status_   = false
     3182           no-error .
     3183         if available buf_parts
     3184         then do:
     3185           assign
     3186             p-cst-code = buf_parts.cst-code
     3187           .
     3188         end.
     3189       end.
     3190       else do:
     3191         find first buf_parts no-lock
     3192           where buf_parts.obj-type  = p-obj-type
     3193             and buf_parts.obj-code  = p-obj-code
     3194             and buf_parts.artic     = buf_goods.artic
     3195             and buf_parts.prod-type = buf_goods.prod-type
     3196             and buf_parts.prod-code = buf_goods.prod-code
     3197             and buf_parts.out-code  = 'free-zone':U
     3198             and buf_parts.in-code   = p-in-code
     3199             and buf_parts.part-code = p-part-code
     3200           no-error .
     3201         if available buf_parts
     3202         then do:
     3203           assign
     3204             p-cst-code = buf_parts.cst-code
     3205           .
     3206         end.
     3207       end.
     3208     end.
     3209   end procedure.
