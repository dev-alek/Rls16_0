     1478   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1479   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1481   procedure disrules-fill-properties:
     1482   define input  parameter p-templ-rl-root as integer   no-undo .
     1483   define buffer buf_drt-prop for ub.drt-prop.
     1484   define buffer buf_temp-drt-prop for temp-drt-prop.
     1485   do
     1486   on error undo, return error return-value
     1487   :
     1488     for each buf_temp-drt-prop:
     1489       delete buf_temp-drt-prop.
     1490     end.
     1491     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1492       create buf_temp-drt-prop.
     1493       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1494     end.
     1495   end.
     1496   end procedure.
     1497   ~
     1498   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   procedure discfgru-check :
     1500   define input parameter p-table-name as character no-undo .
     1501   define input parameter p-templ-rl-root as integer no-undo .
     1502   define input parameter p-time-templ-rl-root as integer no-undo .
     1503   define input parameter p-pos-type as character no-undo .
     1504   define output parameter p-disnct-role as character no-undo .
     1505   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       find first buf_dis-cfg-rule no-lock where
     1510               buf_dis-cfg-rule.table-name = p-table-name
     1511           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1512           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1513           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1514       if not available buf_dis-cfg-rule
     1515       or p-pos-type = "":U
     1516       then do:
     1517          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1518                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1519                                  , p-templ-rl-root
     1520                                  , (if p-time-templ-rl-root = ?
     1521                                     then '':U
     1522                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1523                                     )
     1524                                  ).
     1525       end.
     1526       assign
     1527       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1528       .
     1529     end.
     1530   end procedure.
     1531   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1532   FUNCTION get-region RETURNS CHARACTER
     1533     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1534     define variable par-region as character no-undo.
     1535     if parhost-code = 0 and
     1536          parobj-type = "":U and
     1537          parobj-code = 0 then do:
     1538          par-region = "Глобально".
     1539          return par-region.
     1540       end.
     1541       if parobj-type = 'орг':U then do:
     1542          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1543          return par-region.
     1544       end.
     1545       if parobj-type = 'регион':U
     1546       then do:
     1547          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1548          return par-region.
     1549       end.
     1550       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1551       return par-region.
     1552   END FUNCTION.
     1553   FUNCTION get-objregion RETURNS CHARACTER
     1554     (  input parobj-type as character, input parobj-code as integer ) :
     1555     define variable par-region as character no-undo.
     1556     if  parobj-type = "":U and
     1557         parobj-code = 0
     1558     then do:
     1559        par-region = "Глобально".
     1560     end.
     1561     else if parobj-type = 'орг':U
     1562     then do:
     1563        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1564     end.
     1565     else if parobj-type = 'регион':U
     1566     then do:
     1567        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1568     end.
     1569     else
     1570        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1571     return par-region.
     1572   END FUNCTION.
     1573   procedure disgdsru-name :
     1574   define buffer buf_dis-rule for ub.dis-rule.
     1575   do
     1576     on error undo, return error
     1577     :
     1578     define input  parameter p-templ-rl-root  as integer no-undo .
     1579     define output parameter p-label          as character no-undo .
     1580     find first buf_dis-rule no-lock where
     1581               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1582     if available buf_dis-rule
     1583     then do:
     1584       if buf_dis-rule.rule-num > 0 then
     1585       p-label = buf_dis-rule.des.
     1586     end.
     1587     else do:
     1588       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1589     end.
     1590   end.
     1591   end procedure.
     1592   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1593   define variable v-rule-label as character no-undo .
     1594   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1595                                        ,output v-rule-label) no-error.
     1596   return v-rule-label.
     1597   end function.
     1598   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1599   define variable v-rule-label as character no-undo .
     1600   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1601   end function.
     1602   procedure disgdsru-write :
     1603     do
     1604     on error undo, return error
     1605     :
     1606       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1607       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1608       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1609       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1610       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1611       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1612       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1613       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1614       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1615       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1616       define buffer buf_dis-rule for ub.dis-rule.
     1617       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1618       define variable v-label          as character no-undo .
     1619       define variable v-discnt-role as character no-undo .
     1620       run discfgru-check in this-procedure (
     1621                                             input 'dis-gds-rule':U
     1622                                            ,input p-templ-rl-root
     1623                                            ,input p-time-templ-rl-root
     1624                                            ,input p-pos-type
     1625                                            ,output v-discnt-role
     1626                                             ) no-error .
     1627       if error-status :error then do:
     1628         undo, return error return-value .
     1629       end.
     1630       if p-discnt-role = ? then do:
     1631         p-discnt-role = v-discnt-role.
     1632       end.
     1633       if p-discnt-role <> v-discnt-role then do:
     1634         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1635                                 ,p-gds-code
     1636                                 ,p-obj-type
     1637                                 ,p-obj-code
     1638                                 ,p-pos-type
     1639                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1640                                 ,chr(10)
     1641                                 ,p-templ-rl-root
     1642                                 ,p-rule-num).
     1643       end.
     1644       if p-pos-type = ? then do:
     1645   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1646   define variable v-param-type22 as character no-undo .
     1647   define variable v-value-date22 as date no-undo .
     1648   define variable v-value-decimal22 as decimal no-undo .
     1649   define variable v-value-integer22 as INTEGER no-undo .
     1650   define variable v-value-logical22 AS LOGICAL no-undo .
     1651   define variable v-tth22 as handle no-undo .
     1652   run adm/shattri.p (
     1653       input "get":U
     1654       ,input  p-obj-type
     1655       ,input  p-obj-code
     1656       ,input  'cd-sending':U
     1657       ,input  'dflt-cd':U
     1658       ,output p-pos-type
     1659       ,output v-value-date22
     1660       ,output v-value-decimal22
     1661       ,output v-value-integer22
     1662       ,output v-value-logical22
     1663       ,output v-param-type22
     1664       ,INPUT-OUTPUT table-handle v-tth22
     1665       )  .
     1666   delete object v-tth22 no-error.
     1667       end.
     1668       find first buf_dis-rule no-lock where
     1669                 buf_dis-rule.rule-num = p-rule-num no-error.
     1670       if not available buf_Dis-rule then do:
     1671         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1672                                 ,p-gds-code
     1673                                 ,p-obj-type
     1674                                 ,p-obj-code
     1675                                 ,p-pos-type
     1676                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1677                                 ,chr(10)
     1678                                 ,p-rule-num).
     1679       end.
     1680       if buf_dis-rule.root <> yes then do:
     1681         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1682                                 ,p-gds-code
     1683                                 ,p-obj-type
     1684                                 ,p-obj-code
     1685                                 ,p-pos-type
     1686                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1687                                 ,chr(10)
     1688                                 ,p-rule-num).
     1689       end.
     1690       if not (p-obj-type = buf_dis-rule.obj-type
     1691           and p-obj-code = buf_dis-rule.obj-code)
     1692       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1693                and
     1694                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1695        then do:
     1696         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1697                                 ,p-gds-code
     1698                                 ,p-obj-type
     1699                                 ,p-obj-code
     1700                                 ,p-pos-type
     1701                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1702                                 ,chr(10)
     1703                                 ) +
     1704                             substitute("Правило скидки &1 определено для &2&3" +
     1705                                        "а привязка к товару для &4"
     1706                                        ,buf_dis-rule.rule-num
     1707                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1708                                        ,chr(10)
     1709                                        ,get-objregion( p-obj-type, p-obj-code)
     1710                                        ))
     1711                                 .
     1712       end.
     1713       find first buf_dis-gds-rule exclusive-lock where
     1714                  buf_dis-gds-rule.gds-code  = p-gds-code
     1715              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1716              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1717              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1718              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1719              and buf_dis-gds-rule.nonunique = p-nonunique
     1720              no-error .
     1721       if not available buf_dis-gds-rule then do:
     1722         find first buf_dis-gds-rule exclusive-lock where
     1723                   buf_dis-gds-rule.gds-code  = p-gds-code
     1724               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1725               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1726               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1727               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1728               no-error .
     1729         if available buf_Dis-gds-rule then do:
     1730           if p-nonunique = ''
     1731           and available buf_dis-gds-rule
     1732           then do:
     1733             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1734                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1735                                      , p-gds-code
     1736                                      , buf_Dis-rule.obj-type
     1737                                      , buf_Dis-rule.obj-code
     1738                                      , p-nonunique
     1739                                     ).
     1740           end.
     1741           if available buf_dis-gds-rule
     1742           and buf_dis-gds-rule.nonunique = ''
     1743           and p-nonunique <> ''then do:
     1744             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1745                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1746                                      , p-gds-code
     1747                                      , buf_Dis-rule.obj-type
     1748                                      , buf_Dis-rule.obj-code
     1749                                     ).
     1750           end.
     1751         end.
     1752         create buf_dis-gds-rule .
     1753         assign
     1754         buf_dis-gds-rule.gds-code  = p-gds-code
     1755         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1756         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1757         buf_dis-gds-rule.pos-type = p-pos-type
     1758         buf_dis-gds-rule.discnt-role = v-discnt-role
     1759         buf_dis-gds-rule.rule-num = p-rule-num
     1760         buf_dis-gds-rule.nonunique = p-nonunique
     1761         no-error
     1762         .
     1763       end.
     1764       ASSIGN
     1765       buf_dis-gds-rule.rule-num = p-rule-num
     1766       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1767       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1768       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1769       buf_dis-gds-rule.nonunique = p-nonunique
     1770       no-error.
     1771     end.
     1772   end procedure.
     1773   PROCEDURE cmp-disgdsru-write :
     1774   do
     1775   on error undo, return error
     1776   :
     1777     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1778     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1779     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1780     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1781     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1782     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1783     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1784     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1785     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1786     define variable v-rule-label          as character no-undo .
     1787     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1788     define buffer buf_dis-rule     for ub.dis-rule.
     1789     run disgdsru-name in this-procedure (
     1790                                         input  p-templ-rl-root
     1791                                         ,output v-rule-label
     1792                                         ) no-error .
     1793     if error-status :error then do:
     1794       undo, return error return-value .
     1795     end.
     1796     find first buf_tt0-dis-gds-rule exclusive-lock where
     1797                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1798             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1799             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1800             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1801             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1802             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1803             no-error .
     1804     if not available buf_tt0-dis-gds-rule then do:
     1805       create buf_tt0-dis-gds-rule .
     1806       assign
     1807       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1808       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1809       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1810       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1811       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1812       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1813       no-error
     1814       .
     1815     end.
     1816     find first buf_dis-rule no-lock where
     1817               buf_dis-rule.rule-num = p-rule-num.
     1818     ASSIGN
     1819     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1820     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1821     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1822     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1823     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1824     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1825     no-error.
     1826     release buf_tt0-dis-gds-rule no-error .
     1827     if error-status:error then do:
     1828       undo, return error return-value .
     1829     end.
     1830   end.
     1831   END PROCEDURE.
     1832   define variable vss-include-info23 as character format "X(65)" no-undo
     1833   initial "@(#)$Workfile$ $Revision$".
     1834   define variable v-bgelib-bgefmt        as character         no-undo.
     1835   define variable v-bgelib-bgeflold      as character         no-undo.
     1836   define stream stmXMLOut.
     1837   define stream stmXMLLog.
     1838   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1839   procedure cur-time :
     1840      define output parameter p-today as date      no-undo .
     1841      define output parameter p-time  as integer   no-undo .
     1842     do
     1843     on error undo, return error
     1844     :
     1845       define variable v-date1 as date      no-undo .
     1846       define variable v-date2 as date      no-undo .
     1847       define variable v-time  as integer   no-undo .
     1848       assign
     1849         v-date1 = today
     1850         v-time  = time
     1851         v-date2 = today
     1852       .
     1853       if v-date1 <> v-date2
     1854       then do:
     1855         assign
     1856           v-date1 = today
     1857           v-time  = v-time
     1858         .
     1859       end.
     1860       assign
     1861         p-today = v-date1
     1862         p-time  = v-time
     1863       .
     1864     end.
     1865   end.
     1866   function cur-time-date returns character
     1867   :
     1868     return string(today, '99/99/9999':U) .
     1869   end.
     1870   function cur-time-mjd returns decimal
     1871   :
     1872     define variable v-date as date      no-undo .
     1873     define variable v-time as integer   no-undo .
     1874     run cur-time in this-procedure
     1875       (output v-date
     1876       ,output v-time
     1877       ) .
     1878     return integer(v-date) - 2400002 + (v-time / 86400) .
     1879   end.
     1880   function cur-time-get-ending-index returns integer
     1881   (input p-number as integer
     1882   )
     1883   :
     1884     if p-number < 0
     1885     or p-number = ?
     1886     then do:
     1887       return 1 .
     1888     end.
     1889     define variable v-rest as integer   no-undo .
     1890     assign
     1891       p-number = p-number modulo 100
     1892     .
     1893     if p-number < 20
     1894     then do:
     1895       assign
     1896         v-rest = p-number
     1897       .
     1898     end.
     1899     else do:
     1900       assign
     1901         v-rest = p-number modulo 10
     1902       .
     1903     end.
     1904     case v-rest :
     1905       when 1
     1906       then do:
     1907         return 2 .
     1908       end.
     1909       when 2 or
     1910       when 3 or
     1911       when 4
     1912       then do:
     1913         return 3 .
     1914       end.
     1915       otherwise do:
     1916         return 1 .
     1917       end.
     1918     end case .
     1919   end.
     1920   procedure cur-time-mjd-to-date :
     1921      define input  parameter i-mjd-diff as decimal no-undo.
     1922      define output parameter o-Date     as date    no-undo.
     1923      define output parameter o-Time     as integer no-undo.
     1924      define variable v-day-number as integer   no-undo .
     1925      if    i-mjd-diff < 0
     1926         or i-mjd-diff = ?
     1927      then do:
     1928         return "?" .
     1929      end.
     1930      assign
     1931         v-day-number = truncate(i-mjd-diff,0).
     1932         o-Date = date(v-day-number + 2400002).
     1933         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1934     .
     1935   end.
     1936   function cur-time-mjd-to-string returns character
     1937   (input p-mjd-diff as decimal
     1938   )
     1939   :
     1940     define variable v-day-number as integer   no-undo .
     1941     define variable v-seconds    as integer   no-undo .
     1942     define variable v-hour       as integer   no-undo .
     1943     define variable v-min        as integer   no-undo .
     1944     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1945     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1946     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1947     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1948     if p-mjd-diff < 0
     1949     or p-mjd-diff = ?
     1950     then do:
     1951       return "?" .
     1952     end.
     1953     assign
     1954       v-day-number = integer(truncate(p-mjd-diff,0))
     1955       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1956     .
     1957     if v-seconds > 86400
     1958     then do:
     1959       assign
     1960         v-seconds = 86400 - 1
     1961       .
     1962     end.
     1963     if v-seconds < 0
     1964     then do:
     1965       assign
     1966         v-seconds = 0
     1967       .
     1968     end.
     1969     assign
     1970       v-hour = truncate(v-seconds / 3600, 0)
     1971     .
     1972     assign
     1973       v-seconds = v-seconds modulo 3600
     1974     .
     1975     assign
     1976       v-min = truncate(v-seconds / 60, 0)
     1977     .
     1978     assign
     1979       v-seconds = v-seconds modulo 60
     1980     .
     1981     return
     1982         (if v-day-number <> 0
     1983           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1984           else ""
     1985         )
     1986       + (if v-day-number <> 0 or v-hour <> 0
     1987           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1988           else ""
     1989         )
     1990       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1991           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1992           else ""
     1993         )
     1994       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1995       .
     1996   end.
     1997   function cur-time-string returns character
     1998   :
     1999     define variable v-date as date      no-undo .
     2000     define variable v-time as integer   no-undo .
     2001     run cur-time in this-procedure
     2002       (output v-date
     2003       ,output v-time
     2004       ) .
     2005     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2006   end.
     2007   function cur-time-string-sec returns character
     2008   :
     2009     define variable v-date as date      no-undo .
     2010     define variable v-time as integer   no-undo .
     2011     run cur-time in this-procedure
     2012       (output v-date
     2013       ,output v-time
     2014       ) .
     2015     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2016   end.
     2017   function cur-time-custom  returns character
     2018   (input p-prefix as character
     2019   ,input p-date-format as character
     2020   ,input p-delimiter as character
     2021   ,input p-time-format as character
     2022   ,input p-suffix as character
     2023   )
     2024   :
     2025     define variable v-date as date      no-undo .
     2026     define variable v-time as integer   no-undo .
     2027     run cur-time in this-procedure
     2028       (output v-date
     2029       ,output v-time
     2030       ) .
     2031     return
     2032       p-prefix
     2033       + string(v-date, p-date-format)
     2034       + p-delimiter
     2035       + string(v-time, p-time-format)
     2036       + p-suffix
     2037       .
     2038   end.
     2039   function cur-time-print  returns character
     2040   :
     2041     define variable v-date as date      no-undo .
     2042     define variable v-time as integer   no-undo .
     2043     run cur-time in this-procedure
     2044       (output v-date
     2045       ,output v-time
     2046       ) .
     2047     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2048   end.
     2049   function cur-time-datetime returns datetime
     2050   :
     2051     define variable v-char as character no-undo .
     2052     define variable v-datetime as datetime no-undo .
     2053     v-char = cur-time-string().
     2054     v-datetime = datetime(v-char).
     2055     return  v-datetime.
     2056   end.
     2057   function cur-time-string-msec returns character
     2058   :
     2059     define variable v-date as datetime  no-undo .
     2060     v-date = now.
     2061     return string(v-date) .
     2062   end.
     2063   define variable vss-include-info25 as character format "X(65)" no-undo
     2064   initial "@(#)$Workfile$ $Revision$".
     2065   procedure xmlchar-test :
     2066   define input parameter p-in-string          as character        no-undo.
     2067   define output parameter p-out-string-enc    as character        no-undo.
     2068   define output parameter p-out-string-dec    as character        no-undo.
     2069   do
     2070   on error undo, return error
     2071   :
     2072          run xmlchar-encode in this-procedure
     2073       (
     2074             input p-in-string
     2075           , output p-out-string-enc
     2076       ).
     2077          run xmlchar-decode in this-procedure
     2078       (
     2079             input p-out-string-enc
     2080           , output p-out-string-dec
     2081       ).
