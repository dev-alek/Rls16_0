     4732   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4733   PROCEDURE cd-mrkt_plu-marketer :
     4734   define input parameter p-silence as logical no-undo .
     4735   define parameter buffer buf_cash-desk for ub.cash-desk.
     4736   define input parameter p-id as character no-undo .
     4737   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4738   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4739   define input parameter p-loc-ean as logical no-undo .
     4740   define input parameter p-is-petrolium as logical no-undo .
     4741   define input parameter p-extra as character no-undo .
     4742   define variable v-tot-gds as integer no-undo .
     4743   define variable v-max-gds as integer no-undo .
     4744   define variable v-petrol-start as integer no-undo .
     4745   define variable v-petrol-range as integer no-undo .
     4746   DEFINE VARIABLE v-today as date no-undo .
     4747   DEFINE VARIABLE v-time as integer no-undo .
     4748   define variable v-plu-type as character no-undo .
     4749   define variable v-int as integer no-undo .
     4750   define buffer  buf_cd-plu for ub.cd-plu.
     4751   define buffer  loc_cd-plu for ub.cd-plu.
     4752   define variable  ii as integer no-undo.
     4753   define variable v-mes as character no-undo .
     4754   _main:
     4755   DO ON ERROR undo, leave on stop undo, leave:
     4756     if buf_cash-desk.pos-type <> 'MARIA':U
     4757     or buf_cash-desk.cash-num <> 0 then do:
     4758       assign
     4759       v-mes =
     4760       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4761                 , buf_cash-desk.pos-type).
     4762       if not p-silence then
     4763       message
     4764       v-mes
     4765       view-as alert-box error .
     4766       return error v-mes.
     4767     end.
     4768     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4769                                     ,input 'MARIA_operative':U
     4770                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4771                                           and p-is-petrolium
     4772                                           then 'tot-petrol':U
     4773                                           else 'tot-gds':U)
     4774                                     , output v-mes).
     4775     if v-tot-gds = ? then undo _main, return error v-mes.
     4776     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4777                                     ,input 'MARIA_general':U
     4778                                     ,input 'max-gds':U
     4779                                     ,output v-mes).
     4780     if v-max-gds = ? then undo _main, return error v-mes.
     4781     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4782                                          ,input 'petrolium-range':U
     4783                                          ,input 'petrolium-range':U
     4784                                          ,output v-mes).
     4785     if v-petrol-range = ? then undo _main, return error v-mes.
     4786     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4787       assign
     4788       v-petrol-start = 1
     4789       v-max-gds = (if p-is-petrolium
     4790                    then v-petrol-range
     4791                    else v-max-gds)
     4792       v-plu-type = (if p-is-petrolium
     4793                  then 'топ':U
     4794                  else '':U)
     4795       .
     4796       if p-is-petrolium then do:
     4797         if p-id = '':U then do:
     4798           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4799                               "Невозможно привязать к кассе типа &3"
     4800                               , p-b-str
     4801                               , chr(10)
     4802                               , 'MARIA':U).
     4803           if not p-silence then
     4804           message
     4805           v-mes
     4806           view-as alert-box error .
     4807           return error v-mes.
     4808         end.
     4809         assign
     4810         v-int = integer(p-id)
     4811         no-error
     4812         .
     4813         if error-status:error
     4814         or v-int > v-petrol-range then do:
     4815           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4816                               "в диапазоны номеров резервуаров для кассы типа &4"
     4817                               , p-id
     4818                               , p-b-str
     4819                               , chr(10)
     4820                               , 'MARIA':U).
     4821           if not p-silence then
     4822           message
     4823           v-mes
     4824           view-as alert-box error .
     4825           return error v-mes.
     4826         end.
     4827       end.
     4828     end.
     4829     if buf_cash-desk.pos-type = 'MARIA':U
     4830     and p-is-petrolium then do:
     4831       find first loc_cd-plu where
     4832                loc_cd-plu.obj-type = 'маг':U
     4833            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4834            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4835            and loc_cd-plu.plu-type = 'топ':U
     4836      no-error .
     4837      if available loc_cd-plu then do:
     4838        if loc_cd-plu.b-code = p-b-code
     4839        and loc_cd-plu.b-str = p-b-str then do:
     4840           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4841                               , p-id
     4842                               , p-b-str
     4843                               , chr(10)
     4844                               ).
     4845           if not p-silence then
     4846           message
     4847           v-mes
     4848           view-as alert-box WARNING .
     4849           return v-mes.
     4850        end.
     4851        else do:
     4852           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4853                               "нельзя его привязать к топливу &2&3"
     4854                               , p-id
     4855                               , loc_cd-plu.b-str
     4856                               , chr(10)
     4857                               , p-b-str).
     4858           if not p-silence then
     4859           message
     4860           v-mes
     4861           view-as alert-box error .
     4862           return error v-mes.
     4863        end.
     4864      end.
     4865      ii = v-int.
     4866     end.
     4867     else do:
     4868       DO ii = (if p-is-petrolium
     4869               then v-petrol-start
     4870               else (if buf_cash-desk.pos-type = 'MARIA':U
     4871                    then 1
     4872                    else (if v-petrol-start = 1
     4873                           then (v-petrol-range + 1)
     4874                           else 1)
     4875                   )
     4876               )
     4877         to v-max-gds :
     4878         if not can-find (loc_cd-plu where
     4879                         loc_cd-plu.obj-type = 'маг':U
     4880                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4881                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4882                      and loc_cd-plu.plu-type = v-plu-type
     4883                      and loc_cd-plu.plu-code = ii
     4884                       )
     4885         then LEAVE .
     4886       END .
     4887     end.
     4888     if ii > v-max-gds then do:
     4889         if not p-silence then
     4890         message
     4891         substitute("Превышено максимально допустимое количество &5 &1" +
     4892                   "для касс &2 &3&4"
     4893                   , chr(10)
     4894                   , v-max-gds
     4895                   , 'маг':U
     4896                   , buf_cash-desk.obj-code
     4897                   , (if p-is-petrolium then "топлив" else "товаров")
     4898                   )
     4899         view-as alert-box ERROR .
     4900         undo, return error "max-gds":U.
     4901     end.
     4902     DO ii = (if p-is-petrolium
     4903              then v-petrol-start
     4904              else (if v-petrol-start = 1
     4905                    then (v-petrol-range + 1)
     4906                    else 1)
     4907              )
     4908        to v-max-gds :
     4909       if not can-find (loc_cd-plu where
     4910                         loc_cd-plu.obj-type = 'маг':U
     4911                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4912                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4913                      and loc_cd-plu.plu-type = v-plu-type
     4914                      and loc_cd-plu.plu-code = ii
     4915                      )
     4916       then LEAVE .
     4917     END .
     4918     if ii > v-max-gds then do:
     4919         if not p-silence then
     4920         message
     4921         substitute("Превышено максимально допустимое количество &5 &1" +
     4922                   "для касс &2 &3&4"
     4923                   , chr(10)
     4924                   , v-max-gds
     4925                   , 'маг':U
     4926                   , buf_cash-desk.obj-code
     4927                   , (if p-is-petrolium then "топлив" else "товаров")
     4928                   )
     4929         view-as alert-box ERROR .
     4930         undo, return error "max-gds":U.
     4931     end.
     4932     run cur-time in this-procedure ( output v-today, output v-time).
     4933     create buf_cd-plu.
     4934     assign
     4935     buf_cd-plu.b-code = p-b-code
     4936     buf_cd-plu.b-str = p-b-str
     4937     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4938                                         then buf_cash-desk.addr-path
     4939                                         else "U":U)
     4940     buf_cd-plu.to-send = yes
     4941     buf_cd-plu.charkey_one = "":U
     4942     buf_cd-plu.to-del = no
     4943     buf_cd-plu.plu-code = ii
     4944     buf_cd-plu.obj-type = 'маг':U
     4945     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4946     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4947     buf_cd-plu.plu-type = v-plu-type
     4948     buf_cd-plu.logkey_one = p-loc-ean
     4949     buf_cd-plu.key#_one = integer(p-extra)
     4950     .
     4951     run cd-attr-write  in this-procedure (
     4952                                           input   buf_cash-desk.db-num
     4953                                           ,input  buf_cash-desk.obj-code
     4954                                           ,input  buf_cash-desk.pos-type
     4955                                           ,input  buf_cash-desk.cash-num
     4956                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4957                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4958                                                 and p-is-petrolium
     4959                                                 then 'tot-petrol':U
     4960                                                 else 'tot-gds':U)
     4961                                           ,input ''
     4962                                           ,input ?
     4963                                           ,input 0.0
     4964                                           ,input  (v-tot-gds + 1)
     4965                                           ,input no
     4966                                          ) no-error .
     4967     if error-status:error then do:
     4968       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4969                          ,buf_cash-desk.cash-num
     4970                          , 'маг':U
     4971                          ,buf_cash-desk.obj-code
     4972                          , chr(10)
     4973                          , error-status:get-message(1)
     4974                          , return-value
     4975                          ).
     4976       if not p-silence then
     4977       message
     4978       v-mes
     4979       view-as alert-box error .
     4980       undo _main, return error v-mes.
     4981     end.
     4982     run cd-attr-write  in this-procedure (
     4983                                           input   buf_cash-desk.db-num
     4984                                           ,input  buf_cash-desk.obj-code
     4985                                           ,input  buf_cash-desk.pos-type
     4986                                           ,input  buf_cash-desk.cash-num
     4987                                           ,input  'MARIA_operative':U
     4988                                           ,input  'to-send':U
     4989                                           ,input ''
     4990                                           ,input ?
     4991                                           ,input 0.0
     4992                                           ,input 0
     4993                                           ,input yes
     4994                                          ) no-error .
     4995     if error-status:error then do:
     4996       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     4997                          ,buf_cash-desk.cash-num
     4998                          , 'маг':U
     4999                          ,buf_cash-desk.obj-code
     5000                          , chr(10)
     5001                          , error-status:get-message(1)
     5002                          , return-value
     5003                          ).
     5004       if not p-silence then
     5005       message
     5006       v-mes
     5007       view-as alert-box error .
     5008       undo _main, return error v-mes.
     5009     end.
     5010     return "":U.
     5011   end.
     5012   END PROCEDURE.
     5013   procedure cd-mrkt_update-marketer :
     5014   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5015   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5016   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5017   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5018   define input parameter p-is-petrolium as logical no-undo .
     5019   define variable v-to-send as logical no-undo .
     5020   define variable v-tot-gds as integer no-undo .
     5021   define variable v-max-plu as integer no-undo .
     5022   define buffer buf_cd-plu for ub.cd-plu.
     5023   define variable v-plu-type as character no-undo .
     5024     do
     5025     on error undo, return error
     5026     :
     5027       v-to-send = no.
     5028       v-tot-gds = 0.
     5029       assign
     5030       v-plu-type = (if p-is-petrolium
     5031                     then  'топ':U
     5032                     else '':U
     5033                 )
     5034       .
     5035       FOR EACH buf_cd-plu WHERE
     5036              buf_cd-plu.obj-type = 'маг':U
     5037         and  buf_cd-plu.obj-code = p-obj-code
     5038         and  buf_cd-plu.pos-type = p-pos-type
     5039         and  buf_cd-plu.plu-type = v-plu-type
     5040             :
     5041         if  buf_cd-plu.to-del
     5042         or  buf_cd-plu.to-send then do:
     5043           assign
     5044           v-to-send = yes.
     5045         end.
     5046         assign
     5047         v-tot-gds = v-tot-gds + 1.
     5048       end.
     5049       run cd-attr-write  in this-procedure (
     5050                                               input   p-db-num
     5051                                               ,input  p-obj-code
     5052                                               ,input  p-pos-type
     5053                                               ,input  p-cash-num
     5054                                               ,input  'MARIA_operative':U
     5055                                               ,input  (if p-pos-type = 'MARIA':U
     5056                                                        and p-is-petrolium
     5057                                                        then  'tot-petrol':U
     5058                                                        else 'tot-gds':U)
     5059                                               ,input ''
     5060                                               ,input ?
     5061                                               ,input 0.0
     5062                                               ,input v-tot-gds
     5063                                               ,input no
     5064                                                                                           ) no-error .
     5065       if error-status:error then do:
     5066           UNDO, RETURN ERROR RETURN-VALUE.
     5067       END.
     5068       run cd-attr-write  in this-procedure (
     5069                                               input   p-db-num
     5070                                               ,input  p-obj-code
     5071                                               ,input  p-pos-type
     5072                                               ,input  p-cash-num
     5073                                               ,input  'MARIA_operative':U
     5074                                               ,input  (if p-pos-type = 'MARIA':U
     5075                                                        and p-is-petrolium
     5076                                                        then  'petrol-to-send':U
     5077                                                        else 'to-send':U)
     5078                                               ,input ''
     5079                                               ,input ?
     5080                                               ,input 0.0
     5081                                               ,input 0
     5082                                               ,input v-to-send
     5083                                               ) no-error .
     5084       if error-status:error then do:
     5085           UNDO, RETURN ERROR RETURN-VALUE.
     5086       END.
     5087       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5088                buf_cd-plu.obj-type = 'маг':U
     5089            and buf_cd-plu.obj-code = p-obj-code
     5090            and buf_cd-plu.pos-type = p-pos-type
     5091            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5092       if available buf_cd-plu then do:
     5093         if v-max-plu < buf_cd-plu.plu-code
     5094         then
     5095         v-max-plu = buf_cd-plu.plu-code .
     5096       end.
     5097       else do:
     5098         v-max-plu = 0.
     5099       end.
     5100       run cd-attr-write  in this-procedure (
     5101                                             input   p-db-num
     5102                                             ,input  p-obj-code
     5103                                             ,input  p-pos-type
     5104                                             ,input  p-cash-num
     5105                                             ,input  'MARIA_operative':U
     5106                                             ,input  (if p-pos-type = 'MARIA':U
     5107                                                     and p-is-petrolium
     5108                                                     then 'max-petrol-plu':U
     5109                                                     else 'max-plu':U)
     5110                                               ,input ''
     5111                                               ,input ?
     5112                                               ,input 0.0
     5113                                               ,input v-max-plu
     5114                                               ,input no
     5115                                             ) no-error .
     5116       if error-status:error then do:
     5117           UNDO, RETURN ERROR RETURN-VALUE.
     5118       END.
     5119     end.
     5120   end procedure.
     5121   PROCEDURE cd-mrkt_clu-marketer :
     5122   define input parameter p-silence as logical no-undo .
     5123   define parameter buffer buf_cash-desk for ub.cash-desk.
     5124   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5125   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5126   define variable v-tot-cli as integer no-undo .
     5127   define variable v-max-cli as integer no-undo .
     5128   DEFINE VARIABLE v-today as date no-undo .
     5129   DEFINE VARIABLE v-time as integer no-undo .
     5130   define buffer  buf_cd-clu for ub.cd-clu.
     5131   define buffer  loc_cd-clu for ub.cd-clu.
     5132   define variable  ii as integer no-undo.
     5133   define variable v-mes as character no-undo .
     5134   _main:
     5135   DO ON ERROR undo, leave on stop undo, leave:
     5136     if buf_cash-desk.pos-type <> 'MARIA':U
     5137     or buf_cash-desk.cash-num <> 0 then do:
     5138       assign
     5139       v-mes =
     5140       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5141                 , buf_cash-desk.pos-type).
     5142       if not p-silence then
     5143       message
     5144       v-mes
     5145       view-as alert-box error .
     5146       return error v-mes.
     5147     end.
     5148     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5149                                     ,input 'MARIA_operative':U
     5150                                     ,input 'tot-cli':U
     5151                                     ,output v-mes).
     5152     if v-tot-cli = ? then undo _main, return error v-mes.
     5153     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5154                                     ,input 'MARIA_general':U
     5155                                     ,input 'max-cli':U
     5156                                     , output v-mes).
     5157     if v-max-cli = ? then undo _main, return error v-mes.
     5158     DO ii = 1
     5159        to v-max-cli :
     5160       if not can-find (loc_cd-clu where
     5161                       loc_cd-clu.obj-type = 'маг':U
     5162                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5163                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5164                   and loc_cd-clu.clu-type = '':U
     5165                   and loc_cd-clu.clu-code = ii
     5166                      )
     5167       then LEAVE .
     5168     END .
     5169     if ii > v-max-cli then do:
     5170         if not p-silence then
     5171         message
     5172         substitute("Превышено максимально допустимое количество клиентов &1" +
     5173                   "для касс &2 &3&4"
     5174                   , chr(10)
     5175                   , v-max-cli
     5176                   , 'маг':U
     5177                   , buf_cash-desk.obj-code
     5178                   )
     5179         view-as alert-box ERROR .
     5180         undo, return error "max-cli":U.
     5181     end.
     5182     run cur-time in this-procedure ( output v-today, output v-time).
     5183     create buf_cd-clu.
     5184     assign
     5185     buf_cd-clu.cli-code = p-obj-code
     5186     buf_cd-clu.cli-type = p-obj-type
     5187     buf_cd-clu.obj-type = 'маг':U
     5188     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5189     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5190     buf_cd-clu.clu-type = '':U
     5191     buf_cd-clu.to-send = yes
     5192     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5193                               then buf_cash-desk.addr-path
     5194                               else "U":U)
     5195     buf_cd-clu.clu-code = ii
     5196     .
     5197     run cd-attr-write  in this-procedure (
     5198                                           input   buf_cash-desk.db-num
     5199                                           ,input  buf_cash-desk.obj-code
     5200                                           ,input  buf_cash-desk.pos-type
     5201                                           ,input  buf_cash-desk.cash-num
     5202                                           ,input  'MARIA_operative':U
     5203                                           ,input  'tot-cli':U
     5204                                           ,input ''
     5205                                           ,input ?
     5206                                           ,input 0.0
     5207                                           ,input  (v-tot-cli + 1)
     5208                                           ,input no
     5209                                          ) no-error .
     5210     if error-status:error then do:
     5211       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5212                          ,buf_cash-desk.cash-num
     5213                          , 'маг':U
     5214                          ,buf_cash-desk.obj-code
     5215                          , chr(10)
     5216                          , error-status:get-message(1)
     5217                          , return-value
     5218                          ).
     5219       if not p-silence then
     5220       message
     5221       v-mes
     5222       view-as alert-box error .
     5223       undo _main, return error v-mes.
     5224     end.
     5225     run cd-attr-write  in this-procedure (
     5226                                           input   buf_cash-desk.db-num
     5227                                           ,input  buf_cash-desk.obj-code
     5228                                           ,input  buf_cash-desk.pos-type
     5229                                           ,input  buf_cash-desk.cash-num
     5230                                           ,input  'MARIA_operative':U
     5231                                           ,input  'cli-to-send':U
     5232                                           ,input ''
     5233                                           ,input ?
     5234                                           ,input 0.0
     5235                                           ,input 0
     5236                                           ,input yes
     5237                                          ) no-error .
     5238     if error-status:error then do:
     5239       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5240                          ,buf_cash-desk.cash-num
     5241                          , 'маг':U
     5242                          ,buf_cash-desk.obj-code
     5243                          , chr(10)
     5244                          , error-status:get-message(1)
     5245                          , return-value
     5246                          ).
     5247       if not p-silence then
     5248       message
     5249       v-mes
     5250       view-as alert-box error .
     5251       undo _main, return error v-mes.
     5252     end.
     5253     return "":U.
     5254   end.
     5255   END PROCEDURE.
     5256   procedure cd-mrkt_update-marketer-cli :
     5257   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5258   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5259   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5260   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5261   define variable v-cli-to-send as logical no-undo .
     5262   define variable v-tot-cli as integer no-undo .
     5263   define variable v-max-clu as integer no-undo .
     5264   define buffer buf_cd-clu for ub.cd-clu.
     5265   do
     5266   on error undo, return error return-value
     5267   :
     5268     v-cli-to-send = no.
     5269     v-tot-cli = 0.
     5270     FOR EACH buf_cd-clu WHERE
     5271           buf_cd-clu.obj-type = 'маг':U
     5272       and buf_cd-clu.obj-code =  p-obj-code
     5273       and buf_cd-clu.pos-type =  p-pos-type
     5274       and buf_cd-clu.clu-type =  '':U
     5275       :
     5276       if buf_cd-clu.to-del = yes then do:
     5277         assign
     5278         v-cli-to-send = yes.
     5279       end.
     5280       assign
     5281       v-tot-cli = v-tot-cli + 1.
     5282     end.
     5283     run cd-attr-write  in this-procedure (
     5284                                             input   p-db-num
     5285                                             ,input  p-obj-code
     5286                                             ,input  p-pos-type
     5287                                             ,input  p-cash-num
     5288                                             ,input  'MARIA_operative':U
     5289                                             ,input  'tot-cli':U
     5290                                             ,input ''
     5291                                             ,input ?
     5292                                             ,input 0.0
     5293                                             ,input v-tot-cli
     5294                                             ,input no
     5295                                             ) no-error .
     5296     if error-status:error then do:
     5297         UNDO, RETURN ERROR RETURN-VALUE.
     5298     END.
     5299     run cd-attr-write  in this-procedure (
     5300                                             input   p-db-num
     5301                                             ,input  p-obj-code
     5302                                             ,input  p-pos-type
     5303                                             ,input  p-cash-num
     5304                                             ,input  'MARIA_operative':U
     5305                                             ,input  'cli-to-send':U
     5306                                             ,input ''
     5307                                             ,input ?
     5308                                             ,input 0.0
     5309                                             ,input 0
     5310                                             ,input v-cli-to-send
     5311                                             ) no-error .
     5312     if error-status:error then do:
     5313         UNDO, RETURN ERROR RETURN-VALUE.
     5314     END.
     5315     FIND LAST buf_cd-clu WHERE
     5316             buf_cd-clu.obj-type = 'маг':U
     5317         and buf_cd-clu.obj-code = p-obj-code
     5318         and buf_cd-clu.pos-type = p-pos-type
     5319         and buf_cd-clu.clu-type = '':U
     5320         NO-LOCK use-index pi no-error .
     5321     if available buf_cd-clu then do:
     5322       if v-max-clu < buf_cd-clu.clu-code
     5323       then
     5324       v-max-clu = buf_cd-clu.clu-code.
     5325     end.
     5326     else do:
     5327       v-max-clu = 0.
     5328     end.
     5329     run cd-attr-write  in this-procedure (
     5330                                           input   p-db-num
     5331                                           ,input  p-obj-code
     5332                                           ,input  p-pos-type
     5333                                           ,input  p-cash-num
     5334                                           ,input  'MARIA_operative':U
     5335                                           ,input  'max-clu':U
     5336                                           ,input ''
     5337                                           ,input ?
     5338                                           ,input 0.0
     5339                                           ,input v-max-clu
     5340                                           ,input no
     5341                                           ) no-error .
     5342     if error-status:error then do:
     5343         UNDO, RETURN ERROR RETURN-VALUE.
     5344     END.
     5345   end.
     5346   end procedure.
