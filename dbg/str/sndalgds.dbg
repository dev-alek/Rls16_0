     3247   procedure alienini-getkey :
     3248   define input parameter i-filename as char.
     3249   define input parameter i-section as char.
     3250   define input parameter i-key as char.
     3251   define output parameter o-value as char.
     3252   define variable EntryPointer as integer no-undo.
     3253   define variable mem1 as memptr no-undo.
     3254   define variable mem2 as memptr no-undo.
     3255   define variable mem1size as integer no-undo.
     3256   define variable mem2size as integer no-undo.
     3257   define variable ii       as integer    no-undo.
     3258   define variable cbReturnSize  as integer    no-undo.
     3259   assign
     3260   set-size(mem1)  = 4000
     3261   mem1size = 4000.
     3262   if i-key = "" then EntryPointer = 0.
     3263   else do:
     3264     assign
     3265     set-size(mem2) = 128
     3266     mem2size = 128
     3267     EntryPointer = get-pointer-value(mem2)
     3268     put-string(mem2, 1) = i-key.
     3269   end.
     3270   run getprivateprofilestringA
     3271                                 (i-section,
     3272                                  EntryPointer,
     3273                                  "",
     3274                                  get-pointer-value(mem1),
     3275                                  input mem1size,
     3276                                  i-filename,
     3277                                  output cbReturnSize).
     3278   do ii = 1 to cbReturnSize:
     3279     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3280                  then o-value + ","
     3281                  else o-value + chr(get-byte(mem1, ii)).
     3282   end.
     3283     set-size(mem1) = 0.
     3284     set-size(mem2) = 0.
     3285   end procedure.
     3286   procedure alienini-putkey :
     3287   define input parameter i-filename as char.
     3288   define input parameter i-section as char.
     3289   define input parameter i-key as char.
     3290   define input parameter i-value as char.
     3291   define variable cbReturnSize as integer.
     3292   run writeprivateprofilestringA
     3293                                  (i-section,
     3294                                   i-key,
     3295                                   i-value,
     3296                                   i-filename,
     3297                                   output cbReturnSize ).
     3298   end procedure.
     3299   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3300     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3301     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3302     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3303     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3304     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3305     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3306     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3307   END PROCEDURE.
     3308   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3309     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3310     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3311     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3312     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3313     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3314   END PROCEDURE.
     3315   define   temp-table temp-tekka-tsk no-undo
     3316   field filename      as character
     3317   field obj-num       as integer
     3318   field obj-name      as character
     3319   field num-records   as integer
     3320   field max-records   as integer
     3321   field min-plu       as integer
     3322   field max-plu       as integer
     3323   field num-fields    as integer
     3324   field task-num      as character
     3325   field by-record     as logical
     3326   field send-get      as character
     3327   field cash-num      as integer
     3328   field cash-num-char as character
     3329   field port-num      as character
     3330   field way           as character
     3331   field is-script     as logical
     3332   field pswd          as character
     3333   field waiting-sek   as integer
     3334   field other-info    as character
     3335   field order-num     as integer
     3336   field secondary     as integer
     3337   field shift-fields  as integer
     3338   field binary        as logical
     3339   field range         as integer
     3340   index pi is unique primary
     3341   filename
     3342   range
     3343   index lpi
     3344   filename
     3345   min-plu
     3346   index gpi
     3347   filename
     3348   max-plu
     3349   index iorder
     3350   order-num
     3351   .
     3352   define   temp-table temp-tekka-schema no-undo
     3353   field obj-num as integer
     3354   field obj-name as character
     3355   field field-num as integer
     3356   field field-name as character
     3357   field num-records as integer
     3358   field size_ as integer
     3359   field host as character
     3360   field progress-type as character
     3361   field custom-type as character
     3362   field start-pos as integer
     3363   field end-pos as integer
     3364   field bin-group as character
     3365   index pi is unique primary
     3366   host obj-num field-num
     3367   .
     3368   define temp-table temp-tekka-record no-undo
     3369   field obj-num as integer
     3370   field plu as integer
     3371   field body as character
     3372   field shift as integer
     3373   index pi is unique primary obj-num plu.
     3374   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3375   define variable v-is-closed-shift-journal as integer no-undo .
     3376   assign
     3377   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3378                               +
     3379                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3380                               +
     3381                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3382   .
     3383   return v-is-closed-shift-journal.
     3384   END FUNCTION.
     3385   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3386   define variable v-is-first-journal as logical no-undo .
     3387   assign
     3388   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3389                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3390                     or (p-journal-num =  integer(entry(1, '17':U)))
     3391                     or (p-journal-num = integer(entry(1, '16':U)))
     3392   .
     3393   return v-is-first-journal.
     3394   END FUNCTION.
     3395   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3396   define variable v-is-petrol-journal as logical no-undo .
     3397   assign
     3398   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3399   return v-is-petrol-journal.
     3400   END FUNCTION.
     3401   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3402   define variable v-max-record-num as integer no-undo .
     3403   assign
     3404   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3405                       then 1489
     3406                       else 2340).
     3407   return v-max-record-num.
     3408   END FUNCTION.
     3409   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3410   define variable v-max-record-num as integer no-undo .
     3411   assign
     3412   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3413                       then 1489 * num-entries('30,31,32,33':U)
     3414                       else 2340 * num-entries('17':U)).
     3415   return v-max-record-num.
     3416   END FUNCTION.
     3417   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3418                                           ,input p-rec-no as integer):
     3419   define variable v-num-recs as integer no-undo .
     3420   if tekka-is-petrol-journal (p-journal-num) then do:
     3421     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3422       assign
     3423       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3424       .
     3425     end.
     3426     else do:
     3427       assign
     3428       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3429       .
     3430     end.
     3431   end.
     3432   else do:
     3433     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3434       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3435         assign
     3436         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3437         .
     3438       end.
     3439       else do:
     3440         assign
     3441         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3442         .
     3443       end.
     3444     end.
     3445     else do:
     3446       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3447         assign
     3448         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3449         .
     3450       end.
     3451       else do:
     3452         assign
     3453         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3454         .
     3455       end.
     3456     end.
     3457   end.
     3458   return v-num-recs.
     3459   END FUNCTION.
     3460   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3461                                              ,input p-is-petrol as logical
     3462                                              ,input p-is-current as logical
     3463                                              ,output p-rec-no as decimal
     3464                                              ):
     3465   define variable v-obj-num0 as integer no-undo .
     3466   define variable v-obj-num as integer no-undo .
     3467   define variable v-obj-num2 as integer no-undo .
     3468   define variable p-num-recs2 as integer no-undo .
     3469   define variable p-rec-no2 as integer no-undo .
     3470   if p-is-petrol then do:
     3471     assign
     3472     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3473     .
     3474     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3475     then
     3476     assign
     3477     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3478     p-rec-no = p-num-recs modulo 1489
     3479     .
     3480     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3481     then
     3482     assign
     3483     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3484     p-rec-no = p-num-recs modulo 1489
     3485     .
     3486   end.
     3487   else do:
     3488     assign
     3489     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3490     p-num-recs = trunc(p-num-recs, 0)
     3491     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3492     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3493     .
     3494     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3495     then
     3496     assign
     3497     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3498     p-rec-no = p-num-recs modulo 2340
     3499     .
     3500     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3501     then
     3502     assign
     3503     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3504     p-rec-no = p-num-recs modulo 2340
     3505     .
     3506     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3507     then
     3508     assign
     3509     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3510     p-rec-no2 = p-num-recs2 modulo 2978
     3511     .
     3512     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3513     then
     3514     assign
     3515     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3516     p-rec-no2 = p-num-recs2 modulo 2978
     3517     .
     3518     assign
     3519     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3520     .
     3521   end.
     3522   if v-obj-num = 0 then v-obj-num = 100.
     3523   return v-obj-num.
     3524   END FUNCTION.
     3525   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3526   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3527   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3528      if p-is-ptrl then
     3529      return integer(entry(1, '26,27,28,29':U)).
     3530      if not p-is-ptrl then
     3531      return integer(entry(1, '16':U)).
     3532   end.
     3533   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3534   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3535   return 0.
     3536   END FUNCTION.
     3537   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3538   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3539   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3540     if p-is-ptrl then
     3541     return integer(entry(1, '26,27,28,29':U)).
     3542     if not p-is-ptrl then
     3543     return integer(entry(1, '16':U)).
     3544   end.
     3545   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3546   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3547   return 0.
     3548   END FUNCTION.
     3549   PROCEDURE maria-put:
     3550   define parameter buffer buf_cash-desk for ub.cash-desk.
     3551   define input parameter p-out    as character no-undo .
     3552   define input parameter p-fname as character no-undo .
     3553   define input parameter p-by-record as logical no-undo .
     3554   define input parameter p-shift-fields as integer no-undo .
     3555   define input parameter p-binary as logical no-undo .
     3556   define input parameter p-obj-num as integer no-undo .
     3557   define input parameter p-max-records as integer no-undo .
     3558   define input parameter p-plu as integer no-undo .
     3559   define input parameter p-value as character no-undo .
     3560   define variable v-file-name as character no-undo .
     3561   define variable v-create as logical no-undo .
     3562   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3563   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3564   output stream IBMSTREAM
     3565   to value(v-file-name) append .
     3566   Put  stream IBMSTREAM unformatted
     3567   p-plu
     3568   chr(3)
     3569   p-value
     3570   skip.
     3571   output stream IBMSTREAM
     3572   close.
     3573   if not p-by-record then do:
     3574     find first buf_temp-tekka-tsk where
     3575               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3576     if not available buf_temp-tekka-tsk then do:
     3577       v-create = yes.
     3578     end.
     3579   end.
     3580   else do:
     3581     find first buf_temp-tekka-tsk where
     3582               buf_temp-tekka-tsk.filename  = v-file-name
     3583           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3584     if not available buf_temp-tekka-tsk
     3585     then do:
     3586       find first buf_temp-tekka-tsk where
     3587                 buf_temp-tekka-tsk.filename  = v-file-name
     3588             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3589       if not available buf_temp-tekka-tsk
     3590       then do:
     3591         v-create = yes.
     3592       end.
     3593     end.
     3594   end.
     3595   if v-create then do:
     3596     create buf_temp-tekka-tsk.
     3597     assign
     3598     buf_temp-tekka-tsk.filename = v-file-name
     3599     buf_temp-tekka-tsk.range    = p-plu
     3600     buf_temp-tekka-tsk.obj-num = p-obj-num
     3601     buf_temp-tekka-tsk.obj-name = '':U
     3602     buf_temp-tekka-tsk.num-records = 0
     3603     buf_temp-tekka-tsk.max-records = p-max-records
     3604     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3605     buf_temp-tekka-tsk.task-num = p-fname
     3606     buf_temp-tekka-tsk.by-record = p-by-record
     3607     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3608     buf_temp-tekka-tsk.binary = p-binary
     3609     buf_temp-tekka-tsk.send-get = 'send'
     3610     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3611     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3612     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3613     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3614                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3615                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3616                                 then 'local'
     3617                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3618     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3619     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3620     buf_temp-tekka-tsk.waiting-sek = 30
     3621     buf_temp-tekka-tsk.min-plu     = p-plu
     3622     buf_temp-tekka-tsk.max-plu     = p-plu
     3623     .
     3624   end.
     3625   assign
     3626   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3627   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3628   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3629   .
     3630   END PROCEDURE.
     3631   PROCEDURE maria-get:
     3632   define parameter buffer buf_cash-desk for ub.cash-desk.
     3633   define input parameter p-out    as character no-undo .
     3634   define input parameter p-fname as character no-undo .
     3635   define input parameter p-by-record as logical no-undo .
     3636   define input parameter p-obj-num as integer no-undo .
     3637   define input parameter p-num-fields as integer no-undo .
     3638   define input parameter p-max-records as integer no-undo .
     3639   define input parameter p-min-plu as integer no-undo .
     3640   define input parameter p-max-plu as integer no-undo .
     3641   define input parameter p-other as character no-undo .
     3642   define input parameter p-order-num as integer no-undo .
     3643   define variable v-file-name as character no-undo .
     3644   define variable v-secondary-obj-num as character no-undo .
     3645   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3646   if p-by-record then do:
     3647     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3648   end.
     3649   else do:
     3650     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3651   end.
     3652   find first buf_temp-tekka-tsk where
     3653             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3654   if not available buf_temp-tekka-tsk then do:
     3655     create buf_temp-tekka-tsk.
     3656     assign
     3657     buf_temp-tekka-tsk.filename = v-file-name
     3658     buf_temp-tekka-tsk.obj-num = p-obj-num
     3659     buf_temp-tekka-tsk.obj-name = '':U
     3660     buf_temp-tekka-tsk.max-records = p-max-records
     3661     buf_temp-tekka-tsk.num-fields = p-num-fields
     3662     buf_temp-tekka-tsk.task-num = p-fname
     3663     buf_temp-tekka-tsk.by-record = p-by-record
     3664     buf_temp-tekka-tsk.send-get = 'get'
     3665     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3666     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3667     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3668     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3669                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3670                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3671                                   then 'local'
     3672                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3673     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3674     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3675     buf_temp-tekka-tsk.waiting-sek = 30
     3676     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3677     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3678     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3679                                       and p-max-plu <> ?
     3680                                       then p-max-plu - p-min-plu + 1
     3681                                       else 0)
     3682     buf_temp-tekka-tsk.other-info = p-other
     3683     buf_temp-tekka-tsk.order-num = p-order-num
     3684     .
     3685     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3686       assign
     3687       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3688       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3689       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3690       no-error
     3691       .
     3692       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3693     end.
     3694   end.
     3695   END PROCEDURE.
     3696   PROCEDURE maria-task:
     3697   define parameter buffer buf_cash-desk for ub.cash-desk.
     3698   define input parameter p-fname as character no-undo .
     3699   define input parameter p-obj-num-list as character no-undo .
     3700   define input parameter p-parameters as character no-undo .
     3701   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3702   find first buf_temp-tekka-tsk where
     3703             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3704   if not available buf_temp-tekka-tsk then do:
     3705     create buf_temp-tekka-tsk.
     3706     assign
     3707     buf_temp-tekka-tsk.filename = ''
     3708     buf_temp-tekka-tsk.range = 1
     3709     buf_temp-tekka-tsk.obj-num = 0
     3710     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3711     buf_temp-tekka-tsk.task-num = p-fname
     3712     buf_temp-tekka-tsk.by-record = no
     3713     buf_temp-tekka-tsk.send-get = 'task'
     3714     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3715     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3716     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3717     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3718                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3719                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3720                                   then 'local'
     3721                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3722     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3723     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3724     buf_temp-tekka-tsk.waiting-sek = 30
     3725     buf_temp-tekka-tsk.other-info = p-parameters
     3726     buf_temp-tekka-tsk.order-num = 0
     3727     .
     3728   end.
     3729   END PROCEDURE.
     3730   procedure tekkatsk-verify-schema :
     3731   define input parameter p-obj-list as character no-undo .
     3732   define input parameter p-dir-path as character no-undo .
     3733   define variable v-obj-num as integer no-undo .
     3734   define variable v-obj-name as character no-undo .
     3735   define variable v-num-records as integer no-undo .
     3736   define variable v-size_ as integer no-undo .
     3737   define variable v-value as character no-undo .
     3738   define variable ii as integer no-undo .
     3739   define variable jj as integer no-undo .
     3740   define variable ii-ibs as integer no-undo .
     3741   define variable ii-tekka as integer no-undo .
     3742   define variable v-result as character no-undo .
     3743   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3744   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3745     do
     3746     on error undo, return error
     3747     :
     3748        for each buf_temp-tekka-schema:
     3749          delete buf_temp-tekka-schema.
     3750        end.
     3751        input from value('tekkasch.d').
     3752        repeat :
     3753          create buf_temp-tekka-schema.
     3754          import buf_temp-tekka-schema.
     3755          assign
     3756          buf_temp-tekka-schema.host = 'IBS'
     3757          ii = ii + 1.
     3758          .
     3759        end.
     3760        input close.
     3761        ii-ibs = ii.
     3762         _ii:
     3763         do ii = 1 to 256:
     3764           if p-obj-list = "ALL"
     3765           or lookup(string(ii), p-obj-list) > 0 then do:
     3766             assign
     3767             v-obj-num = 0
     3768             v-obj-name = ''
     3769             v-num-records = 0
     3770             v-size_ = 0
     3771             .
     3772             run alienini-getkey in this-procedure (
     3773                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3774                                                     ,input ('obj' + string(ii, '999'))
     3775                                                     ,input 'oname'
     3776                                                     ,output v-value) no-error .
     3777             if v-value = ? then next _ii.
     3778             assign
     3779             v-obj-num = ii
     3780             v-obj-name = v-value
     3781             .
     3782             run alienini-getkey in this-procedure (
     3783                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3784                                                     ,input ('obj' + string(ii, '999'))
     3785                                                     ,input 'size'
     3786                                                     ,output v-value) no-error .
     3787             assign
     3788             v-num-records = integer(v-value) no-error  .
     3789             if error-status:error
     3790             or v-num-records = 0 then next _ii.
     3791             run alienini-getkey in this-procedure (
     3792                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3793                                                     ,input 'obj' + string(ii, '999')
     3794                                                     ,input 'f000'
     3795                                                     ,output v-value) no-error .
     3796             assign
     3797             v-size_ = integer(v-value) no-error  .
     3798             if error-status:error
     3799             or v-size_ = 0 then next _ii.
     3800             _jj:
     3801             do jj = 1 to 256:
     3802               run alienini-getkey in this-procedure (
     3803                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3804                                                       ,input 'obj' + string(ii, '999')
     3805                                                       ,input 'f' + string(jj, '999')
     3806                                                       ,output v-value) no-error .
     3807               if v-value = ? then next _ii.
     3808               create buf_temp-tekka-schema.
     3809               assign
     3810               buf_temp-tekka-schema.host = 'tekka'
     3811               buf_temp-tekka-schema.obj-num = v-obj-num
     3812               buf_temp-tekka-schema.obj-name = v-obj-name
     3813               buf_temp-tekka-schema.num-records = v-num-records
     3814               buf_temp-tekka-schema.size_ = v-size_
     3815               buf_temp-tekka-schema.field-num = jj
     3816               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3817               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3818                                                  then entry(2, entry(2, v-value, '#'), ':')
     3819                                                  else '':U)
     3820               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3821               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3822               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3823                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3824               no-error
     3825               .
     3826               if error-status:error then do:
     3827                 delete buf_temp-tekka-schema.
     3828                 next _jj.
     3829               end.
     3830               run alienini-getkey in this-procedure (
     3831                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3832                                                       ,input 'obj' + string(ii, '999') + 'name'
     3833                                                       ,input 'n' + string(jj, '999')
     3834                                                       ,output v-value) no-error .
     3835               if v-value <> ? then
     3836               buf_temp-tekka-schema.field-name = v-value.
     3837             end.
     3838           end.
     3839         end.
     3840         ii-tekka = ii - 1.
     3841        if p-obj-list <> 'ALL' then do:
     3842         if ii-tekka <> ii-ibs then do:
     3843           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3844                                   , ii-ibs
     3845                                   , ii-tekka).
     3846         end.
     3847        end.
     3848        for each buf_temp-tekka-schema where
     3849               buf_temp-tekka-schema.host = 'tekka':
     3850          find first buf2_temp-tekka-schema where
     3851                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3852                AND buf2_temp-tekka-schema.host = 'ibs'
     3853                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3854          if not available buf2_temp-tekka-schema then do:
     3855           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3856                                   , buf_temp-tekka-schema.field-num
     3857                                   , buf_temp-tekka-schema.obj-num).
     3858          end.
     3859          buffer-compare buf_temp-tekka-schema
     3860          to buf2_temp-tekka-schema
     3861          save result in v-result.
     3862          if v-result <> '':U then do:
     3863           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3864                                   , buf_temp-tekka-schema.field-num
     3865                                   , buf_temp-tekka-schema.obj-num).
     3866          end.
     3867        end.
     3868     end.
     3869   end procedure.
     3870   FUNCTION set-Sx returns character (input p-string as character):
     3871   return p-string.
     3872   END FUNCTION.
     3873   FUNCTION get-Sx returns character (input p-string  as character):
     3874   return p-string.
     3875   END FUNCTION.
     3876   FUNCTION set-B returns character (input p-string  as character):
     3877   return chr(integer(p-string)).
     3878   END FUNCTION.
     3879   FUNCTION get-B returns character (input p-string  as character):
     3880   return string(asc(p-string)).
     3881   END FUNCTION.
     3882   FUNCTION set-BF returns character (input p-string  as character):
     3883   define variable v-dopi as integer no-undo .
     3884   define variable ii as integer no-undo .
     3885   do ii = 1 to 8:
     3886     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3887   end.
     3888   return chr(v-dopi).
     3889   END FUNCTION.
     3890   FUNCTION get-BF returns character (input p-string  as character):
     3891   define variable v-dopi as integer no-undo .
     3892   define variable v-dops as character no-undo .
     3893   define variable ii as integer no-undo .
     3894   v-dopi = asc(p-string).
     3895   do ii = 8 to 1 BY -1:
     3896     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3897   end.
     3898   return v-dops.
     3899   END FUNCTION.
     3900   FUNCTION set-BN returns character (input p-string  as character
     3901                                     ,input p-bin-group as character):
     3902   define variable v-dopi as integer no-undo .
     3903   define variable ii as integer no-undo .
     3904   define variable jj as integer no-undo .
     3905   define variable v-grp-nums as integer no-undo .
     3906   define variable v-dopi2 as integer no-undo .
     3907   v-grp-nums = num-entries(p-bin-group).
     3908   do jj = 0 to v-grp-nums - 1:
     3909     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3910     do ii = 1 to 8:
     3911       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3912     end.
     3913   end.
     3914   return chr(v-dopi).
     3915   END FUNCTION.
     3916   FUNCTION get-BN returns character (input p-string  as character
     3917                                     ,input p-bin-group as character):
     3918   define variable v-dopi as integer no-undo .
     3919   define variable v-dops as character no-undo .
     3920   define variable v-grp-nums as integer no-undo .
     3921   define variable ii as integer no-undo .
     3922   define variable jj as integer no-undo .
     3923   v-dopi = asc(p-string).
     3924   v-grp-nums = num-entries(p-bin-group).
     3925   do jj = 1 to v-grp-nums:
     3926   do ii = 8 to 1 BY -1:
     3927     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3928   end.
     3929   end.
     3930   return v-dops.
     3931   END FUNCTION.
     3932   procedure fill-temp-cd :
     3933   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3934   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3935   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3936   define input parameter p-clear-table as logical no-undo .
     3937   define buffer buf_temp-cd for temp-cd.
     3938   define buffer buf_cash-desk for ub.cash-desk.
     3939     do
     3940     on error undo, return error
     3941     :
     3942        if p-clear-table  then do:
     3943          for each buf_temp-cd:
     3944            delete buf_temp-cd.
     3945          end.
     3946        end.
     3947        for each buf_cash-desk no-lock where
     3948               buf_cash-desk.db-num = p-db-num
     3949           AND buf_cash-desk.obj-code = p-obj-code
     3950           and buf_cash-desk.cash-on  = yes
     3951        BREAK by buf_cash-desk.pos-type:
     3952          if first-of(buf_cash-desk.pos-type) then do:
     3953            create buf_temp-cd.
     3954            buffer-copy buf_cash-desk to buf_temp-cd.
     3955          end.
     3956        end.
     3957     end.
     3958   end procedure.
     3959   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3960   FUNCTION name-2cdf returns character
     3961                      (  input p-name-2cd as character
     3962                       , input p-mode as logical
     3963                       , input p-cod-pcod as logical
     3964                       , input p-b-code  as integer
     3965                       , input p-gds-code as integer
     3966                       , input p-artic   as character
     3967                       , input p-engl-name  as character
     3968                       , input p-in-code as character
     3969                       , input p-part-code as character
     3970                       , input p-obj-type as character
     3971                       , input p-obj-code as integer
     3972                       , input p-alpha1 as character
     3973                       , output p-gtd as character
     3974                       ) :
     3975   define variable v-name-2cd as character no-undo .
     3976   define variable v-dop-alt-name as character no-undo.
     3977   define variable v-type as character no-undo.
     3978   define buffer buf_parts for ub.parts.
     3979   define buffer buf_code for ub.code.
     3980   if not p-mode and p-name-2cd = "PLU":U then do:
     3981     return "PLU кассы":U.
     3982   end.
     3983   if not p-mode then do:
     3984     if p-name-2cd <> "GTD":U
     3985     and  p-name-2cd <> "alpha1|gtd":U
     3986     then do:
     3987     assign
     3988     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     3989   end.
     3990   end.
     3991   if p-part-code = "":U or p-cod-pcod = no then do:
     3992     run gdsoattr-value in this-procedure (
     3993       'dt-seasons':U,
     3994       p-gds-code,
     3995       p-obj-type,
     3996       p-obj-code,
     3997       output v-dop-alt-name,
     3998       output v-type
     3999     ) no-error.
     4000     if v-dop-alt-name <> "" then do:
     4001       find first buf_code where
     4002                  buf_code.parent = "DTSeasons"
     4003              and buf_code.code   = v-dop-alt-name
     4004            no-lock no-error.
     4005       if available buf_code then
     4006         assign
     4007           p-engl-name = ""
     4008           v-dop-alt-name =  buf_code.misc1
     4009         .
     4010     end.
     4011     else do:
     4012       run gdsoattr-value in this-procedure
     4013                           ( input  'dop-alt-name-o':U
     4014                            ,input  p-gds-code
     4015                            ,input  p-obj-type
     4016                            ,input  p-obj-code
     4017                            ,output v-dop-alt-name
     4018                            ,output v-type
     4019                           ) no-error .
     4020     end.
     4021     CASE p-name-2cd:
     4022       when "name" then do:
     4023         if p-mode then return p-engl-name + v-dop-alt-name.
     4024         return "Англ. название".
     4025       end.
     4026       when "code":U then do:
     4027         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4028         return "Лок. код товара"  .
     4029       end.
     4030       when "GTD":U
     4031       or
     4032       when "name-GTD":U
     4033       or
     4034       when "code-GTD":U
     4035       or
     4036       when "alpha1|gtd":U
     4037       or
     4038       when "name-alpha1|gtd":U
     4039       or
     4040       when "code-alpha1|gtd":U
     4041       then do:
     4042         if p-mode then do:
     4043           run gdcstcod_cst-code  in this-procedure (
     4044                                                       input  p-obj-type
     4045                                                       ,input  p-obj-code
     4046                                                       ,input  p-gds-code
     4047                                                       ,input  p-in-code
     4048                                                       ,input  p-part-code
     4049                                                       ,output p-gtd
     4050                                                       ) no-error .
     4051         end.
     4052         if p-name-2cd = "name-gtd":U then do:
     4053           if p-mode then return p-engl-name  + v-dop-alt-name.
     4054           return "Англ. название".
     4055         end.
     4056         if p-name-2cd = "name-alpha1|gtd":U then do:
     4057           if p-mode then return p-engl-name  + v-dop-alt-name.
     4058           return "Англ. название".
     4059         end.
     4060         if p-name-2cd = "code-GTD":U then do:
     4061           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4062           return "Лок. код товара"  .
     4063         end.
     4064         if p-name-2cd = "code-alpha1|gtd":U then do:
     4065           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4066           return "Лок. код товара"  .
     4067         end.
     4068         if p-mode then do:
     4069           if p-name-2cd = "GTD" then  return p-gtd.
     4070           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4071         end.
     4072         if p-name-2cd = "GTD" then  return "Код ГТД".
     4073         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4074       end.
     4075     END CASE.
     4076   end.
     4077   else do:
     4078     if p-name-2cd = "name-gtd":U
     4079     or p-name-2cd = "code-GTD":U
     4080     or p-name-2cd = "name-alpha1|GTD":U
     4081     or p-name-2cd = "code-alpha1|GTD":U
     4082     or p-name-2cd = "alpha1|GTD":U
     4083     then do:
     4084       if p-mode then do:
     4085         run gdcstcod_cst-code  in this-procedure (
     4086                                                      input  p-obj-type
     4087                                                     ,input  p-obj-code
     4088                                                     ,input  p-gds-code
     4089                                                     ,input  p-in-code
     4090                                                     ,input  p-part-code
     4091                                                     ,output p-gtd
     4092                                                     ) no-error .
     4093       end.
     4094       else do:
     4095         if p-name-2cd = "gtd":U then
     4096         p-gtd = "Код ГТД".
     4097         if p-name-2cd = "alpha1|Gtd":U then
     4098         p-gtd = "Страна|Код ГТД".
     4099       end.
     4100     end.
     4101     if p-mode then  return p-part-code.
     4102     return "Код партии".
     4103   end.
     4104   END FUNCTION.
     4105   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4106                                            ,input p-nam-2str as logical
     4107                                            ,input p-nam-artc as logical
     4108                                            ,input p-unit-cli-type as character
     4109                                            ,input p-unit-base as character
     4110                                            ,input p-unit-cli as character
     4111                                            ,input p-cli-base-rate as decimal
     4112                                            ,input p-artic as character
     4113                                            ,input p-f-name as character
     4114                                            ,input p-gds-name as character
     4115                                            ,input p-gds-name1 as character
     4116                                            ,output p-second-name as character):
     4117   define variable v-length as integer no-undo .
     4118   define variable nam-2str-shift as integer no-undo .
     4119   define variable chk_name as character no-undo .
     4120   assign
     4121   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4122   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4123   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4124               then 5
     4125               else v-length)
     4126   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4127   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4128   .
     4129   if p-nam-artc then do:
     4130     assign
     4131     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4132       .
     4133   end.
     4134   else  do:
     4135     assign
     4136     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4137     .
     4138   end.
     4139   if p-unit-base <> p-unit-cli then do:
     4140     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4141     assign
     4142     chk_name = string(substr(chk_name
     4143                               ,1
     4144                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4145                       "*":U +
     4146                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4147   end.
     4148   else do:
     4149     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4150   end.
     4151   if p-nam-2str then do:
     4152     assign
     4153     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4154     chk_name = substr(chk_name, 1, v-length)
     4155     .
     4156   end.
     4157   else do:
     4158     assign
     4159     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4160     p-second-name =   (chr(34) +
     4161                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4162                       + chr(34) )
     4163     .
     4164   end.
     4165   return chk_name.
     4166   end function.
     4167   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4168   procedure disrules-get-interface-form :
     4169   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4170   define output parameter p-form-name as character no-undo .
     4171   define buffer buf_temp-drt-prop for temp-drt-prop.
     4172   define buffer buf_drt-prop for ub.drt-prop.
     4173   find first buf_temp-drt-prop where
     4174             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4175         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4176         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4177   if not available buf_temp-drt-prop then do:
     4178     find first buf_drt-prop where
     4179               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4180           and buf_drt-prop.upper-prop-code = "InputForm"
     4181           and buf_drt-prop.prop-code = "FormName" no-error.
     4182     if available buf_drt-prop then do:
     4183       p-form-name = buf_drt-prop.property-value.
     4184     end.
     4185     else do:
     4186       p-form-name = "ref/dis-ruli.w".
     4187     end.
     4188   end.
     4189   else do:
