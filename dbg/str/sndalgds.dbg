    12325                     string(action, "X(1)") '0000000000000'.
    12326                     put skip.
    12327                 end.
    12328                 if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12329                     (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12330                     put unformatted (fill(" " , 16 -  length(bar_code)) + bar_code) '00101'
    12331                                                   caps(string(chk_name,'x(20)'))
    12332                                                   string(( cash-gds.price-sale * 100 ) ,'99999999') .
    12333                     put unformatted '0000000000000000000000000000000'
    12334                     string(action, "X(1)") '0000000000000'.
    12335                     put skip.
    12336                 end.
    12337             end.
    12338             else do:
    12339               put unformatted ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12340                                         '00101' caps( string( chk_name, 'x(20)' ) )
    12341                                       string( ( cash-gds.price-sale * 100 ) ,'99999999') .
    12342               put unformatted '0000000000000000000000000000000'
    12343               string(action, "X(1)") '0000000000000'.
    12344               put skip.
    12345             end.
    12346           end.
    12347         end.
    12348       when 'NCR-GM':U
    12349       or when 'NCR-AS@R':U
    12350       then do:
    12351   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12352   define variable ncr-disc-string as character no-undo .
    12353   if nam-artc then
    12354   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    12355   else  do:
    12356     chk_name = "" .
    12357     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
    12358       chk_name = chk_name + entry( ff, cash-gds.gds-name, '"' ) .
    12359     END .
    12360     if chk_name = "" then
    12361     chk_name = cash-gds.gds-name .
    12362     chk_name = chk_name + cash-gds.f-name .
    12363   end.
    12364   if (cash-gds.unit-base <> cash-gds.unit-cli) and
    12365      cash-gds.cli-base-rate <> 1 then
    12366   assign
    12367   chk_name = string(substr(chk_name, 1, 19 - length(string(cash-gds.cli-base-rate))) + "*" + string( cash-gds.cli-base-rate ), "x(20)" ).
    12368   else
    12369   chk_name = string(chk_name, "X(20)").
    12370   assign
    12371   ncrdsc = "0":U
    12372   conf-par = "":U
    12373   par-type ="":U
    12374   .
    12375   if std-disc-dec <> 0
    12376   or pos-type = 'NCR-AS@R':U
    12377   then do:
    12378     do ff = 1 to num-entries(ncrgmdsc, ";":U):
    12379       assign
    12380       par-type = entry(ff, ncrgmdsc , ";":U)
    12381       conf-par = entry(2, par-type, "=":U)
    12382       no-error
    12383       .
    12384       if error-status:error then do:
    12385         LEAVE.
    12386       end.
    12387       if conf-par  = string( - std-disc-dec) then do:
    12388         ncrdsc =  entry(1, par-type, "=").
    12389         LEAVE.
    12390       end.
    12391     end.
    12392   end.
    12393   assign
    12394   IBM-good-code = "":U
    12395   is-sc = no
    12396   .
    12397   run ncr-gdsc in this-procedure (output IBM-good-code
    12398                                 , output IBM-good-code-2
    12399                                 , output is-sc
    12400                                 , output taracode-bc
    12401                                 ) no-error .
    12402   if IBM-good-code = "":U then
    12403   assign
    12404   IBM-good-code= IBM-good-code-2
    12405   .
    12406   assign
    12407   conf-par =  ncr-d-rank(ncrdrank, cash-gds.qnty-discnt-rule,  cash-gds.temp-discnt-rule, cash-gds.date-discnt-rule )
    12408   .
    12409   do2:
    12410   do while IBm-good-code <> "":U:
    12411     if action = "D":U then do:
    12412       put stream IBMStream unformatted
    12413       fill(chr(32), 3)
    12414       IBM-good-code
    12415       "-":U
    12416       fill(chr(32), 61)
    12417       chr(10)
    12418       .
    12419     end.
    12420     else do:
    12421       if conf-par = "T":U then do:
    12422         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12423       end.
    12424       if conf-par = "D":U then do:
    12425         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12426       end.
    12427       if conf-par = "X":U then do:
    12428          ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12429       end.
    12430       if ncr-disc-string = '':U then
    12431       conf-par = chr(32) .
    12432       put stream IBMStream unformatted
    12433       fill(chr(32), 3)
    12434       IBM-good-code
    12435       string(if cash-gds.grp-code = 0 then 1 else cash-gds.grp-code , "9999":U)
    12436       (if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12437       or (is-sc
    12438       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12439       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    12440       then "2":U
    12441       else "0":U)
    12442       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    12443        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    12444        or is-sc
    12445        then "1":U
    12446        else "0":U)
    12447         (if pos-type = 'NCR-GM':U or
    12448         wd-option = 0
    12449         then   ncrdsc
    12450         else '0':U)
    12451        (if cash-gds.vat-code = ? or
    12452        cash-gds.vat-code > 7 then
    12453        "0"
    12454        else string(cash-gds.vat-code, "9"))
    12455       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12456       or (is-sc
    12457       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12458       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    12459       and  (cash-gds.taracode  <> '':u
    12460            or taracode-bc <> '')
    12461       then (if taracode-bc <> ''
    12462             then taracode-bc
    12463             else cash-gds.taracode)
    12464       else '00'
    12465       )
    12466       (if cash-gds.unit-cli begins "№"
    12467        then substring(cash-gds.unit-cli, 2, 2)
    12468        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    12469       "0010":U
    12470       "0000":U
    12471       chk_name
    12472       fill(chr(32), 4)
    12473       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12474       fill(chr(32), 8)
    12475       conf-par
    12476       replace(string( cash-gds.price-sale, "999999.99")
    12477              , ".":U, "":U
    12478              )
    12479       chr(10)
    12480       .
    12481       if pos-type = 'NCR-AS@R':U
    12482       and ncrdsc <> '0':U
    12483       and wd-option > 0
    12484       and cash-gds.std-discnt-rule > 0
    12485       then do:
    12486         run create-ncr-kat-discnt in this-procedure (
    12487                                                     input string(cash-gds.gds-code)
    12488                                                     ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12489                                                     ,input chk_name
    12490                                                     ,input (if action = 'D':U then 0 else cash-gds.std-discnt-rule)
    12491                                                     ,input ?
    12492                                                     ,input 'time-rule-num':U
    12493                                                     ,input ?
    12494                                                     ) no-error .
    12495       end.
    12496       ncr-disc-string = '':U.
    12497       if conf-par = "T":U then do:
    12498         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12499         if ncr-disc-string <> '':U then
    12500         PUT stream IBMstream unformatted
    12501         chr(32)
    12502         "T":U
    12503         chr(32)
    12504         IBM-good-code
    12505         chr(32)
    12506         chr(32)
    12507         ncr-disc-string
    12508         chr(10)
    12509         .
    12510       end.
    12511       if conf-par = "D":U then do:
    12512         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12513         if ncr-disc-string <> '':U then
    12514         PUT stream IBMstream unformatted
    12515         chr(32)
    12516         "D":U
    12517         chr(32)
    12518         IBM-good-code
    12519         chr(32)
    12520         chr(32)
    12521         ncr-disc-string
    12522         chr(10)
    12523         .
    12524       end.
    12525       if conf-par = "X":U then do:
    12526         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12527         if ncr-disc-string <> '':U then
    12528         PUT stream IBMstream unformatted
    12529         chr(32)
    12530         "X":U
    12531         chr(32)
    12532         IBm-good-code
    12533         chr(32)
    12534         chr(32)
    12535         ncr-disc-string
    12536         chr(10)
    12537         .
    12538       end.
    12539     end.
    12540     if pos-type = 'NCR-AS@R':U
    12541     and cash-gds.kat-discnt-rule <> 0
    12542     then do:
    12543       case how-pcnt-kat :
    12544         when 'pcnt-kat-pdf':U then do:
    12545             v-kat-discnt = cash-gds.price-sale.
    12546           end.
    12547         otherwise do:
    12548           v-kat-discnt = ?.
    12549         end.
    12550       end case.
    12551       run create-ncr-kat-discnt in this-procedure (
    12552                                                    input string(cash-gds.gds-code)
    12553                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12554                                                   ,input chk_name
    12555                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12556                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12557                                                   ,input 'time-rule-num':U
    12558                                                   ,input v-kat-discnt
    12559                                                   ) no-error .
    12560       if error-status:error then do:
    12561       end.
    12562     end.
    12563     if IBM-good-code = IBM-good-code-2 then leave do2.
    12564     assign
    12565     IBM-good-code = IBM-good-code-2
    12566     .
    12567   end.
    12568       end.
    12569     END CASE .
    12570   END PROCEDURE .
    12571   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12572   PROCEDURE   for-cash-cycle:
    12573   DEFINE VARIABLE fname-list as character no-undo .
    12574   DEFINE VARIABLE out-list as character no-undo .
    12575   DEFINE VARIABLE var-file-num as integer no-undo .
    12576   DEFINE VARIABLE v-dir-remote as character no-undo .
    12577   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
    12578   define variable v-plu as character no-undo .
    12579   define variable v-pl-code as integer no-undo .
    12580   define variable ss  as character no-undo .
    12581   define variable ss0  as character no-undo .
    12582   define variable v-temp-kat-file as character no-undo .
    12583   define variable v-kat-file as character no-undo .
    12584   define variable v-kat-file-save as character no-undo .
    12585   define variable v-updated-subject-dis-kat as logical no-undo .
    12586   define variable v-next as logical no-undo .
    12587   define variable v-cd-subject-code as character no-undo .
    12588   define variable v-cd-disc-string as character no-undo .
    12589   define variable v-versiond as decimal no-undo .
    12590   define variable v-maria-discnt-value as character no-undo .
    12591   define variable v-ii as integer no-undo .
    12592   define variable v-dop as character no-undo .
    12593   define variable v-gds-rule-num as integer no-undo .
    12594   define variable v-maria-rule-num as integer no-undo .
    12595   define buffer for-cash-desk for ub.cash-desk.
    12596   define buffer buf_cd-plu for ub.cd-plu.
    12597   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    12598   define buffer buf_cash-gds for cash-gds.
    12599   define buffer buf_dis-rule for ub.dis-rule.
    12600   define buffer buf_place for ub.place.
    12601   define buffer buf_pl-gds for ub.pl-gds.
    12602   FOR EACH for-cash-desk NO-LOCK WHERE
    12603           for-cash-desk.db-num = g#db-num AND
    12604           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12605           for-cash-desk.obj-code = i-obj-code AND
    12606    for-cash-desk.cash-on  = yes
    12607       BREAK
    12608       BY for-cash-desk.db-num
    12609       BY for-cash-desk.obj-code
    12610       BY for-cash-desk.pos-type
    12611       BY for-cash-desk.cash-on
    12612       BY for-cash-desk.cash-num
    12613       :
    12614     if LOOKUP(ub.cash-desk.pos-type,
    12615               ('NCR-GM':U + chr(44) +
    12616                'IBM-XML':U + chr(44) +
    12617                'MAGIA-XML':U + chr(44) +
    12618                'NCR-AS@R':U  + chr(44) +
    12619                'Autotank':U
    12620                  )) > 0
    12621     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    12622     if LOOKUP(ub.cash-desk.pos-type,
    12623               'MARIA':U
    12624                  ) > 0 then do:
    12625       if for-cash-desk.autonomy = integer('2':U) then do:
    12626         assign
    12627         v-cd-list-update = for-cash-desk.addr-path
    12628         v-cd-list-delete = for-cash-desk.addr-path
    12629         .
    12630         NEXT.
    12631       end.
    12632       else do:
    12633         if v-cd-list-update = '':U then nExt.
    12634       end.
    12635     end.
    12636     run write-log-and-file in p-log-handle (
    12637           input 1
    12638         , input log-file-name
    12639         , input 1
    12640         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
    12641                           )
    12642                                           ).
    12643   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12644   case for-cash-desk.pos-type:
    12645       when 'IBM-XML':U or when 'Autotank':U
    12646         or
    12647       when 'InfoKiosk':U
    12648         or
    12649       when 'Autotank':U
    12650     then do:
    12651   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12652   run xml-cd-filename in this-procedure (
