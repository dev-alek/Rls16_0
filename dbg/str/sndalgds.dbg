    14562   _do26:
    14563   do vdr-26 = 1 to 3:
    14564     CASE vdr-26:
    14565       when 1 then do:
    14566         assign
    14567         vc-obj-code = ub.shop.obj-code
    14568         vc-obj-type = 'маг':U
    14569         vc-host-code = ub.shop.host-code
    14570         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    14571         .
    14572       end.
    14573       when 2 then do:
    14574         assign
    14575         vc-obj-code = 0
    14576         vc-obj-type = '':U
    14577         vc-host-code = ub.shop.host-code
    14578         vc-region    = substitute("Фирма &1&2", vc-host-code)
    14579         .
    14580       end.
    14581       when 3 then do:
    14582         assign
    14583         vc-obj-code = 0
    14584         vc-obj-type = '':U
    14585         vc-host-code = 0
    14586         vc-region    = "Глобально"
    14587         .
    14588       end.
    14589     END CASE.
    14590     find ub.dis-rule no-lock where
    14591                   ub.dis-rule.upper-rule-num = 26
    14592               and ub.dis-rule.host-code = vc-host-code
    14593               AND ub.dis-rule.obj-type = vc-obj-type
    14594               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    14595     if available ub.dis-rule then LEAVE _do26.
    14596   end.
    14597   if available ub.dis-rule then do:
    14598     for each buf_dis-rule no-lock where
    14599             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    14600       assign
    14601       ncrgmdsc = ncrgmdsc + (if ncrgmdsc = "":U then "":U else ";") +
    14602                   string(buf_dis-rule.dis-kat) + "=":U +
    14603                   string(buf_dis-rule.discnt-value).
    14604     end.
    14605   end.
