     4580           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-periodic-tasks in g#attr-lib
     4581         (input  p-db-num
     4582         ,input  p-obj-code
     4583         ,input  p-pos-type
     4584         ,input  p-cash-num
     4585         ,input-output p-value
     4586         ,output p-setted
     4587         ) no-error .
     4588       if error-status :error
     4589       then do:
     4590         undo, return error return-value .
     4591       end.
     4592     end.
     4593   end procedure.
     4594   function cd-attr_get-attr-int returns integer
     4595   (buffer buf_cash-desk for ub.cash-desk
     4596   ,input p-upper-attr-code as character
     4597   ,input p-attr-code as character
