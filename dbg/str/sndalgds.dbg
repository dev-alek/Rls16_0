    14437                                 , 'маг':U
    14438                                 , abs(i-obj-code)).
    14439     end.
    14440     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    14441       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    14442                               and ub.curr-shop.obj-type = 'маг':U
    14443                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    14444                               use-index pi NO-ERROR.
    14445       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
