     2084   procedure xmlchar-encode :
     2085   define input parameter p-in-string      as character        no-undo.
     2086   define output parameter p-out-string    as character        no-undo.
     2087       define variable v-position      as integer      no-undo.
     2088       define variable v-current-char  as character    no-undo.
     2089   do
     2090   on error undo, return error
     2091   :
     2092       assign
     2093           p-out-string = "":U
     2094       .
     2095       case p-in-string
     2096       :
     2097           when ?
     2098           then do:
     2099               assign
     2100                   p-out-string = "?":U
     2101               .
     2102           end.
     2103           when "?":U
     2104           then do:
     2105               assign
     2106                   p-out-string = "&#63;":U
     2107               .
     2108           end.
     2109           otherwise do:
     2110               do v-position = 1 to length( p-in-string )
     2111               :
     2112                   assign
     2113                       v-current-char = substring( p-in-string, v-position, 1 )
     2114                   .
     2115                   case v-current-char
     2116                   :
     2117                       when "&":U
     2118                       then do:
     2119                           assign
     2120                               p-out-string = p-out-string + "&amp;":U
     2121                           .
     2122                       end.
     2123                       when ">":U
     2124                       then do:
     2125                           assign
     2126                               p-out-string = p-out-string + "&gt;":U
     2127                           .
     2128                       end.
     2129                       when "<":U
     2130                       then do:
     2131                           assign
     2132                               p-out-string = p-out-string + "&lt;":U
     2133                           .
     2134                       end.
     2135                       when "'":U
     2136                       then do:
     2137                           assign
     2138                               p-out-string = p-out-string + "&apos;":U
     2139                           .
     2140                       end.
     2141                       when '"':U
     2142                       then do:
     2143                           assign
     2144                               p-out-string = p-out-string + "&quot;":U
     2145                           .
     2146                       end.
     2147                       when chr(1)
     2148                       then do:
     2149                           assign
     2150                               p-out-string = p-out-string + "":U
     2151                           .
     2152                       end.
     2153                       when chr(2)
     2154                       then do:
     2155                           assign
     2156                               p-out-string = p-out-string + "":U
     2157                           .
     2158                       end.
     2159                       when chr(3)
     2160                       then do:
     2161                           assign
     2162                               p-out-string = p-out-string + "":U
     2163                           .
     2164                       end.
     2165                       when chr(4)
     2166                       then do:
     2167                           assign
     2168                               p-out-string = p-out-string + "":U
     2169                           .
     2170                       end.
     2171                       when chr(5)
     2172                       then do:
     2173                           assign
     2174                               p-out-string = p-out-string + "":U
     2175                           .
     2176                       end.
     2177                       when chr(6)
     2178                       then do:
     2179                           assign
     2180                               p-out-string = p-out-string + "":U
     2181                           .
     2182                       end.
     2183                       when chr(7)
     2184                       then do:
     2185                           assign
     2186                               p-out-string = p-out-string + "":U
     2187                           .
     2188                       end.
     2189                       when chr(8)
     2190                       then do:
     2191                           assign
     2192                               p-out-string = p-out-string + "":U
     2193                           .
     2194                       end.
     2195                       when chr(9)
     2196                       then do:
     2197                           assign
     2198                               p-out-string = p-out-string + "":U
     2199                           .
     2200                       end.
     2201                       when chr(29)
     2202                       then do:
     2203                           assign
     2204                               p-out-string = p-out-string + "":U
     2205                           .
     2206                       end.
     2207                       when chr(10)
     2208                       then do:
     2209                           assign
     2210                               p-out-string = p-out-string + "&#10;":U
     2211                           .
     2212                       end.
     2213                       when chr(13)
     2214                       then do:
     2215                           assign
     2216                               p-out-string = p-out-string + "&#13;":U
     2217                           .
     2218                       end.
     2219                       otherwise do:
     2220                           assign
     2221                               p-out-string = p-out-string + v-current-char
     2222                           .
     2223                       end.
     2224                   end case.
     2225               end.
     2226           end.
     2227       end case.
     2228   end.
     2229   end .
     2230   procedure xmlchar-encode-1c :
     2231   define input parameter p-in-string      as character        no-undo.
     2232   define output parameter p-out-string    as character        no-undo.
     2233       define variable v-position      as integer      no-undo.
     2234       define variable v-current-char  as character    no-undo.
     2235   do
     2236   on error undo, return error
     2237   :
     2238       assign
     2239           p-out-string = "":U
     2240       .
     2241       case p-in-string
     2242       :
     2243           when ?
     2244           then do:
     2245               assign
     2246                   p-out-string = "?":U
     2247               .
     2248           end.
     2249           otherwise do:
     2250               do v-position = 1 to length( p-in-string )
     2251               :
     2252                   assign
     2253                       v-current-char = substring( p-in-string, v-position, 1 )
     2254                   .
     2255                   case v-current-char
     2256                   :
     2257                       when chr(1)
     2258                       then do:
     2259                           assign
     2260                               p-out-string = p-out-string + " ":U
     2261                           .
     2262                       end.
     2263                       when chr(2)
     2264                       then do:
     2265                           assign
     2266                               p-out-string = p-out-string + " ":U
     2267                           .
     2268                       end.
     2269                       when chr(3)
     2270                       then do:
     2271                           assign
     2272                               p-out-string = p-out-string + " ":U
     2273                           .
     2274                       end.
     2275                       when chr(4)
     2276                       then do:
     2277                           assign
     2278                               p-out-string = p-out-string + " ":U
     2279                           .
     2280                       end.
     2281                       when chr(5)
     2282                       then do:
     2283                           assign
     2284                               p-out-string = p-out-string + " ":U
     2285                           .
     2286                       end.
     2287                       when chr(6)
     2288                       then do:
     2289                           assign
     2290                               p-out-string = p-out-string + " ":U
     2291                           .
     2292                       end.
     2293                       when chr(7)
     2294                       then do:
     2295                           assign
     2296                               p-out-string = p-out-string + " ":U
     2297                           .
     2298                       end.
     2299                       when chr(8)
     2300                       then do:
     2301                           assign
     2302                               p-out-string = p-out-string + " ":U
     2303                           .
     2304                       end.
     2305                       when chr(9)
     2306                       then do:
     2307                           assign
     2308                               p-out-string = p-out-string + " ":U
     2309                           .
     2310                       end.
     2311                       when chr(29)
     2312                       then do:
     2313                           assign
     2314                               p-out-string = p-out-string + " ":U
     2315                           .
     2316                       end.
     2317                       when chr(10)
     2318                       then do:
     2319                           assign
     2320                               p-out-string = p-out-string + " ":U
     2321                           .
     2322                       end.
     2323                       when chr(13)
     2324                       then do:
     2325                           assign
     2326                               p-out-string = p-out-string + " ":U
     2327                           .
     2328                       end.
     2329                       otherwise do:
     2330                           assign
     2331                               p-out-string = p-out-string + v-current-char
     2332                           .
     2333                       end.
     2334                   end case.
     2335               end.
     2336           end.
     2337       end case.
     2338   end.
     2339   end .
     2340   procedure xmlchar-decode :
     2341   define input parameter p-in-string      as character        no-undo.
     2342   define output parameter p-out-string    as character        no-undo.
     2343       define variable v-position      as integer      no-undo.
     2344       define variable v-last-position as integer      no-undo.
     2345       define variable v-temp-integer  as integer      no-undo.
     2346       define variable v-current-char  as character    no-undo.
     2347       define variable v-next-char     as character    no-undo.
     2348       define variable v-success       as logical      no-undo.
     2349   do
     2350   on error undo, return error
     2351   :
     2352       assign
     2353           p-out-string = "":U
     2354           v-position   = 0
     2355       .
     2356       replace-cycle:
     2357       do while yes
     2358       on error undo, return error
     2359       :
     2360           assign
     2361               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2362           .
     2363           if v-last-position <= v-position
     2364           then do:
     2365               if v-position = 0
     2366               then do:
     2367                   assign
     2368                       p-out-string = p-in-string
     2369                   .
     2370               end.
     2371               else do:
     2372                   assign
     2373                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2374                   .
     2375               end.
     2376               leave replace-cycle.
     2377           end.
     2378           else do:
     2379               assign
     2380                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2381                   v-position      = v-last-position
     2382                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2383               .
     2384               if v-current-char = "#":U
     2385               then do:
     2386                   assign
     2387                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2388                   .
     2389                   if v-last-position > 0
     2390                   then do:
     2391                       run xmlchar-read-integer in this-procedure
     2392                        (
     2393                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2394                           , output v-temp-integer
     2395                           , output v-success
     2396                       ).
     2397                       if v-success = yes
     2398                       and v-temp-integer >= 1
     2399                       and v-temp-integer <= 255
     2400                       then do:
     2401                           assign
     2402                               p-out-string = p-out-string + chr( v-temp-integer )
     2403                               v-position   = v-last-position + 1
     2404                           .
     2405                       end.
     2406                       else do:
     2407                           assign
     2408                               p-out-string = p-out-string + "&":U
     2409                               v-position   = v-position   + 1
     2410                           .
     2411                       end.
     2412                   end.
     2413                   else do:
     2414                       assign
     2415                           p-out-string = p-out-string + "&":U
     2416                           v-position   = v-position   + 1
     2417                       .
     2418                   end.
     2419               end.
     2420               else do:
     2421                   case substring( p-in-string, v-position + 1, 3 )
     2422                   :
     2423                       when "lt;":U
     2424                       then do:
     2425                           assign
     2426                               p-out-string = p-out-string + "<":U
     2427                               v-position   = v-position   + 3
     2428                           .
     2429                       end.
     2430                       when "gt;":U
     2431                       then do:
     2432                           assign
     2433                               p-out-string = p-out-string + ">":U
     2434                               v-position   = v-position   + 3
     2435                           .
     2436                       end.
     2437                       otherwise do:
     2438                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2439                           then do:
     2440                               assign
     2441                                   p-out-string = p-out-string + "&":U
     2442                                   v-position   = v-position   + 4
     2443                               .
     2444                           end.
     2445                           else do:
     2446                               case substring( p-in-string, v-position + 1, 5 )
     2447                               :
     2448                                   when "quot;":U
     2449                                   then do:
     2450                                       assign
     2451                                           p-out-string = p-out-string + '"':U
     2452                                           v-position   = v-position   + 5
     2453                                       .
     2454                                   end.
     2455                                   when "apos;":U
     2456                                   then do:
     2457                                       assign
     2458                                           p-out-string = p-out-string + "'":U
     2459                                           v-position   = v-position   + 5
     2460                                       .
     2461                                   end.
     2462                                   otherwise do:
     2463                                       assign
     2464                                           p-out-string = p-out-string + "&":U
     2465                                       .
     2466                                   end.
     2467                               end case.
     2468                           end.
     2469                       end.
     2470                   end case.
     2471               end.
     2472           end.
     2473       end.
     2474   end.
     2475   end .
     2476   procedure xmlchar-read-integer :
     2477   define input parameter p-input-string      as character        no-undo.
     2478   define output parameter p-output-integer   as integer          no-undo.
     2479   define output parameter p-success       as logical          no-undo.
     2480   do
     2481   on error undo, return error
     2482   :
     2483       assign
     2484           p-output-integer = integer( p-input-string )
     2485       no-error.
     2486       if error-status :error
     2487       then do:
     2488           assign
     2489               p-success           = no
     2490               p-output-integer    = 0
     2491           .
     2492       end.
     2493       else do:
     2494           assign
     2495               p-success           = yes
     2496           .
     2497       end.
     2498   end.
     2499   end.
     2500   define variable v-bgelib-bgeclall           as logical      no-undo.
     2501   define variable v-bgelib-bgedict            as logical      no-undo.
     2502   define temp-table temp_ext-doc-type no-undo
     2503       field edt-key               as integer
     2504       field ext-doc-type          as character
     2505       field ext-doc-type-label    as character
     2506       index pi is primary unique
     2507           edt-key
     2508   .
     2509   define temp-table temp_bgelib_goods no-undo
     2510       field gds-code as integer
     2511       index pi is primary unique
     2512           gds-code
     2513   .
     2514   define temp-table temp_bgelib_clients no-undo
     2515       field obj-type as character
     2516       field obj-code as integer
     2517       index pi is primary unique
     2518           obj-type
     2519           obj-code
     2520   .
     2521   define temp-table temp_bgelib_dis-card no-undo
     2522       field d-card as character
     2523       index pi is primary unique
     2524           d-card
     2525   .
     2526   define temp-table temp_bgelib_trn-doc no-undo
     2527       field doc-code as integer
     2528   .
     2529   procedure bgelib-tag-open:
     2530   do
     2531   on error undo, return error
     2532   :
     2533   define input parameter v-tag-level  as integer      no-undo.
     2534   define input parameter v-tag-name   as character    no-undo.
     2535   define input parameter v-tag-value  as character    no-undo.
     2536       put stream stmXMLOut unformatted
     2537           chr(10)
     2538           + fill(" ", 4 * v-tag-level)
     2539           + "<" + v-tag-name
     2540           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2541           + v-tag-value + ">"
     2542       .
     2543   end.
     2544   end procedure.
     2545   procedure bgelib-tag-put:
     2546   do
     2547   on error undo, return error
     2548   :
     2549   define input parameter v-tag-level      as integer      no-undo.
     2550   define input parameter v-tag-name       as character    no-undo.
     2551   define input parameter v-tag-value      as character    no-undo.
     2552   define input parameter v-empty-mode     as integer      no-undo.
     2553       v-tag-name = trim(v-tag-name).
     2554       if  v-empty-mode = 1
     2555       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2556       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2557       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2558       then do:
     2559           run xmlchar-encode in this-procedure (
     2560                 input v-tag-value
     2561               , output v-tag-value
     2562           ).
     2563           put stream stmXMLOut unformatted
     2564               chr(10) + fill(" ", 4 * v-tag-level)
     2565                           + '<' + v-tag-name + '>'
     2566                           + v-tag-value
     2567                           + '</' + v-tag-name + '>'
     2568           .
     2569       end.
     2570   end.
     2571   end procedure.
     2572   procedure bgelib-tag-close:
     2573   do
     2574   on error undo, return error
     2575   :
     2576   define input parameter v-tag-level as integer      no-undo.
     2577   define input parameter v-tag-name  as character    no-undo.
     2578       put stream stmXMLOut unformatted
     2579           chr(10)
     2580           + fill( " ", 4 * v-tag-level)
     2581           + '</' + v-tag-name + '>'
     2582       .
     2583   end.
     2584   end procedure.
     2585   procedure bgelib-write-log:
     2586   do
     2587   on error undo, return error
     2588   :
     2589   define input parameter v-filename   as character    no-undo.
     2590   define input parameter v-log-level  as integer      no-undo.
     2591   define input parameter v-out-string as character    no-undo.
     2592       output stream stmXMLLog to value( v-filename ) append.
     2593       put stream stmXMLLog unformatted
     2594           chr(10)
     2595       .
     2596       put stream stmXMLLog unformatted
     2597           ( if v-log-level = 0
     2598             or v-out-string = "&DLine"
     2599             or v-out-string = "&Line"
     2600             then ""
     2601             else cur-time-string-sec() + " " )
     2602       .
     2603       put stream stmXMLLog unformatted
     2604           ( if v-out-string = "&Line"
     2605             then fill( "-", 80 )
     2606             else if v-out-string = "&DLine"
     2607                  then fill( "=", 80 )
     2608                  else v-out-string )
     2609       .
     2610       output stream stmXMLLog close.
     2611   end.
     2612   end procedure.
     2613   procedure bgelib-write-edt:
     2614   do
     2615   on error undo, return error
     2616   :
     2617   define input parameter v-editor-handle    as handle       no-undo.
     2618   define input parameter v-log-level        as integer      no-undo.
     2619   define input parameter v-out-string       as character    no-undo.
     2620       if valid-handle ( v-editor-handle )
     2621       then do:
     2622           v-editor-handle :move-to-eof().
     2623           v-editor-handle :insert-string( ( if v-log-level = 0
     2624                                             or v-out-string = "&DLine"
     2625                                             or v-out-string = "&Line"
     2626                                             then ""
     2627                                             else cur-time-string-sec() + " "
     2628                                         ) ).
     2629           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2630                                             then fill( "-", 80 )
     2631                                             else if v-out-string = "&DLine" then fill("=", 80)
     2632                                             else fill( " ", v-log-level) + v-out-string
     2633                                         ) ).
     2634           v-editor-handle :insert-string( chr(10) ).
     2635       end.
     2636       process events.
     2637       output to 'bgescn.txt' append.
     2638           put unformatted
     2639               chr(10)
     2640               string( ( if v-log-level = 0
     2641                         or v-out-string = "&DLine"
     2642                         or v-out-string = "&Line"
     2643                         then ""
     2644                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2645                     ) )
     2646               string( ( if v-out-string = "&Line"
     2647                         then fill( "-", 80 )
     2648                         else if v-out-string = "&DLine"
     2649                              then fill( "=", 80 )
     2650                              else fill( " ", v-log-level ) + v-out-string
     2651                     ) )
     2652           .
     2653       output close.
     2654   end.
     2655   end procedure.
     2656   procedure bgelib-show-cnt:
     2657   do
     2658   on error undo, return error
     2659   :
     2660   define input parameter v-fillin-handle     as handle   no-undo.
     2661       if valid-handle( v-fillin-handle )
     2662       then do:
     2663           assign
     2664               v-fillin-handle :visible = true
     2665           .
     2666       end.
     2667   end.
     2668   end procedure.
     2669   procedure bgelib-hide-cnt:
     2670   do
     2671   on error undo, return error
     2672   :
     2673   define input parameter v-fillin-handle     as handle   no-undo.
     2674       if valid-handle( v-fillin-handle )
     2675       then do:
     2676           assign v-fillin-handle :visible = false.
     2677       end.
     2678   end.
     2679   end procedure.
     2680   procedure bgelib-write-cnt:
     2681   do
     2682   on error undo, return error
     2683   :
     2684   define input parameter v-fillin-handle    as handle       no-undo.
     2685   define input parameter v-fillin-string    as character    no-undo.
     2686       if valid-handle( v-fillin-handle )
     2687       then do:
     2688           assign
     2689               v-fillin-handle :SCREEN-value = v-fillin-string
     2690           .
     2691       end.
     2692   end.
     2693   end procedure.
     2694   procedure bgelib-write-header:
     2695   do
     2696   on error undo, return error
     2697   :
     2698   define input parameter p-first-file     as logical      no-undo.
     2699   define input parameter p-xml-file-name  as character    no-undo.
     2700   define input parameter p-list-file-name as character    no-undo.
     2701   define input parameter p-file-number    as integer      no-undo.
     2702   define input parameter p-have-prev      as logical      no-undo.
     2703   define input parameter p-prev-filename  as character    no-undo.
     2704   define input parameter p-obj-list       as character    no-undo.
     2705   define input parameter p-doc-type-list  as character    no-undo.
     2706   define input parameter p-parameter-list as character    no-undo.
     2707       define variable v-counter    as integer        no-undo.
     2708       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2709       put stream stmXMLOut unformatted
     2710           "<?xml version='1.0' encoding='windows-1251'?>"
     2711       .
     2712       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2713       run bgelib-tag-open( input 0, input "header", input "" ).
     2714       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2715       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2716       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2717       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2718       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2719       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2720       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2721       :
     2722           run bgelib-tag-put(
     2723                 input 1
     2724               , input entry( 2 * v-counter, p-parameter-list )
     2725               , input entry( 2 * v-counter + 1, p-parameter-list )
     2726               , input 0
     2727           ).
     2728       end.
     2729       run bgelib-tag-close( input 0, input "header" ).
     2730       output stream stmXMLOut close.
     2731       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2732       if p-first-file = yes
     2733       then do:
     2734           put stream stmXMLOut unformatted
     2735               "<?xml version='1.0' encoding='windows-1251'?>"
     2736           .
     2737           run bgelib-tag-open( input 0, input "export", input "" ).
     2738       end.
     2739       run bgelib-tag-open( input 1, input "file", input "" ).
     2740       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2741       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2742       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2743       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2744       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2745       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2746       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2747       :
     2748           run bgelib-tag-put(
     2749                 input 2
     2750               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2751               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2752               , input 0
     2753           ).
     2754       end.
     2755       run bgelib-tag-close( input 1, input "file" ).
     2756       output stream stmXMLOut close.
     2757   end.
     2758   end procedure.
     2759   procedure bgelib-write-footer:
     2760   do
     2761   on error undo, return error
     2762   :
     2763   define input parameter p-last-file      as logical      no-undo.
     2764   define input parameter p-xml-file-name  as character    no-undo.
     2765   define input parameter p-list-file-name as character    no-undo.
     2766   define input parameter p-have-next      as logical      no-undo.
     2767   define input parameter p-next-file-name as character    no-undo.
     2768       define variable v-error-num     as integer           no-undo.
     2769       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2770       if p-have-next = yes
     2771       then do:
     2772           run bgelib-tag-open( input 0, input "footer", "" ).
     2773           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2774           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2775           run bgelib-tag-close( input 0, input "footer" ).
     2776       end.
     2777       run bgelib-tag-close( input 0, input "root" ).
     2778       output stream stmXMLOut close.
     2779       run bge/os_copy.p (
     2780             input "M"
     2781           , input p-xml-file-name + "tmp"
     2782           , input p-xml-file-name + "xml"
     2783           , output v-error-num
     2784       ).
     2785       if p-last-file = yes
     2786       then do:
     2787           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2788               run bgelib-tag-close( input 0, input "export" ).
     2789           output stream stmXMLOut close.
     2790           run bge/os_copy.p (
     2791                 input "M"
     2792               , input p-list-file-name + "tmp"
     2793               , input p-list-file-name + "xml"
     2794               , output v-error-num
     2795           ).
     2796       end.
     2797   end.
     2798   end procedure.
     2799   procedure bgelib-filename :
     2800   do
     2801   on error undo, return error
     2802   :
     2803   define input parameter p-prefix             as character    no-undo.
     2804   define output parameter p-xml-file-name     as character    no-undo.
     2805   define output parameter p-log-file-name     as character    no-undo.
     2806   define output parameter p-list-file-name    as character    no-undo.
     2807       define variable v-home-dir  as character    no-undo.
     2808       define variable v-error-num as integer      no-undo.
     2809       get-key-value section "BGE" key "outdir" value v-home-dir.
     2810       if v-home-dir = ?
     2811       then do:
     2812           message
     2813             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2814             skip(1)
     2815             skip "Обратитесь к администратору."
     2816           view-as alert-box error.
     2817           undo, return error .
     2818       end.
     2819       run gbl/dir-cre.p (
     2820           input v-home-dir
     2821       ) no-error.
     2822       if error-status :error
     2823       then do:
     2824           message
     2825             skip "Неверно задан каталог экспорта."
     2826             skip(1)
     2827             skip "Обратитесь к администратору."
     2828           view-as alert-box error.
     2829           undo, return error .
     2830       end.
     2831       run bge/genfname.p (
     2832             input v-home-dir
     2833           , input p-prefix
     2834           , input ""
     2835           , input "xml"
     2836           , input "tmp"
     2837           , output p-xml-file-name
     2838       ).
     2839       assign
     2840           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2841           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2842           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2843       .
     2844   end.
     2845   end procedure.
     2846   procedure bgelib-read-config :
     2847   do
     2848   on error undo, return error
     2849   :
     2850   define variable v-par-type as character     no-undo.
     2851     define variable v-param-type      as character  no-undo .
     2852     define variable v-value-character as character  no-undo .
     2853     define variable v-value-date      as date       no-undo .
     2854     define variable v-value-decimal   as decimal    no-undo .
     2855     define variable v-value-integer   as integer    no-undo .
     2856     define variable v-value-logical   as logical    no-undo .
     2857     define variable v-tth             as handle     no-undo .
     2858       assign
     2859           v-bgelib-bgeclall = no
     2860           v-bgelib-bgedict  = no
     2861       .
     2862       run adm/shattri.p ( input "get":U
     2863                         , input  '':u
     2864                         , input  0
     2865                         , input  'bge-export':U
     2866                         , input  'bgeclall':U
     2867                         , output v-value-character
     2868                         , output v-value-date
     2869                         , output v-value-decimal
     2870                         , output v-value-integer
     2871                         , output v-value-logical
     2872                         , output v-param-type
     2873                         , input-output table-handle v-tth
     2874                         ) no-error .
     2875       if error-status :error
     2876       then do:
     2877         assign
     2878           v-bgelib-bgeclall = no
     2879         .
     2880       end.
     2881       else do:
     2882         assign
     2883           v-bgelib-bgeclall = v-value-logical
     2884         .
     2885       end.
     2886       delete object v-tth.
     2887       run adm/shattri.p ( input "get":U
     2888                         , input  '':u
     2889                         , input  0
     2890                         , input  'bge-export':U
     2891                         , input  'bgedict':U
     2892                         , output v-value-character
     2893                         , output v-value-date
     2894                         , output v-value-decimal
     2895                         , output v-value-integer
     2896                         , output v-value-logical
     2897                         , output v-param-type
     2898                         , input-output table-handle v-tth
     2899                         ) no-error .
     2900       if error-status :error
     2901       then do:
     2902         assign
     2903           v-bgelib-bgedict = no
     2904         .
     2905       end.
     2906       else do:
     2907         assign
     2908           v-bgelib-bgedict = v-value-logical
     2909         .
     2910       end.
     2911       delete object v-tth.
     2912       run adm/shattri.p ( input "get":U
     2913                         , input  '':u
     2914                         , input  0
     2915                         , input  'bge-export':U
     2916                         , input  'bgefmt':U
     2917                         , output v-value-character
     2918                         , output v-value-date
     2919                         , output v-value-decimal
     2920                         , output v-value-integer
     2921                         , output v-value-logical
     2922                         , output v-param-type
     2923                         , input-output table-handle v-tth
     2924                         ) no-error .
     2925       if error-status :error
     2926       then do:
     2927         assign
     2928           v-bgelib-bgefmt  = "xml":U
     2929         .
     2930       end.
     2931       else do:
     2932         assign
     2933           v-bgelib-bgefmt  = v-value-character
     2934         .
     2935       end.
     2936       delete object v-tth.
     2937       run adm/shattri.p ( input "get":U
     2938                         , input  '':u
     2939                         , input  0
     2940                         , input  'bge-export':U
     2941                         , input  'bgeflold':U
     2942                         , output v-value-character
     2943                         , output v-value-date
     2944                         , output v-value-decimal
     2945                         , output v-value-integer
     2946                         , output v-value-logical
     2947                         , output v-param-type
     2948                         , input-output table-handle v-tth
     2949                         ) no-error .
     2950       if error-status :error
     2951       then do:
     2952         assign
     2953           v-bgelib-bgeflold  = "old":U
     2954         .
     2955       end.
     2956       else do:
     2957         assign
     2958           v-bgelib-bgeflold  = v-value-character
     2959         .
     2960       end.
     2961       delete object v-tth.
     2962   end.
     2963   end procedure.
     2964   procedure bgelib-check-file-size :
     2965   do
     2966   on error undo, return error
     2967   :
     2968   define input parameter p-out-filename   as character    no-undo.
     2969   define output parameter p-is-big        as logical      no-undo.
     2970       define variable v-current-position    as integer        no-undo.
     2971       assign
     2972           v-current-position = seek( stmXMLOut )
     2973       .
     2974       if v-current-position / 1024 / 1024  >= 100
     2975       then do:
     2976           assign
     2977               p-is-big = yes
     2978           .
     2979       end.
     2980   end.
     2981   end procedure.
     2982   procedure bgelib-init-ext-doc-type :
     2983       define variable v-counter    as integer      no-undo.
     2984       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2985   do
     2986   for buf_temp_ext-doc-type
     2987   on error undo, return error
     2988   :
     2989       empty temp-table buf_temp_ext-doc-type.
     2990       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2991       :
     2992           create buf_temp_ext-doc-type.
     2993           assign
     2994               buf_temp_ext-doc-type.edt-key               = v-counter
     2995               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2996               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2997           .
     2998       end.
     2999   end.
     3000   end procedure.
     3001   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3002   define variable v-xml-file-name     as character            no-undo.
     3003   define variable v-xml-file-name-path as character            no-undo.
     3004   define variable v-log-file-name     as character            no-undo.
     3005   define variable v-locked            as logical              no-undo.
     3006   define variable v-log-string        as character            no-undo.
     3007   define variable v-oper-num          as integer              no-undo.
     3008   define variable v-obj-list          as character            no-undo.
     3009   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
