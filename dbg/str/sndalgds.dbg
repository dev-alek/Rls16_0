    12675   .
    12676   run xml-cd-write-header in this-procedure (
    12677         input v-xml-file-name
    12678       , input v-xml-file-name-path
    12679       , input 'data'
    12680       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    12681       , input v-obj-list
    12682       , input (
    12683                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    12684                   then (if for-cash-desk.autonomy = integer('0':U)
    12685                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    12686                         else ("КМ"   )
    12687                         )
    12688                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    12689                   )
    12690               )
    12691       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    12692   ).
    12693   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    12694   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    12695     end.
    12696     when 'MAGIA-XML':U then do:
    12697   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12698   run xml-cd-filename in this-procedure (
    12699         input out
    12700       , output v-xml-file-name
    12701       , output v-xml-file-name-path
    12702       , output v-log-file-name
    12703       , output v-locked
    12704   ).
    12705   run write-log-and-file in p-log-handle (
    12706         input 1
    12707       , input log-file-name
    12708       , input 1
    12709       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    12710                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    12711                         )
    12712                                         ).
    12713   run write-log-and-file in p-log-handle (
    12714         input 1
    12715       , input log-file-name
    12716       , input 1
    12717       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
    12718                                         ).
    12719   assign
    12720   v-obj-list = 'маг':U + string(i-obj-code)
    12721   .
    12722   run xml-cd-write-header in this-procedure (
    12723         input v-xml-file-name
    12724       , input v-xml-file-name-path
    12725       , input 'data'
    12726       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    12727       , input v-obj-list
    12728       , input (
    12729                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    12730                   then (if for-cash-desk.autonomy = integer('0':U)
    12731                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    12732                         else ("КМ"   )
    12733                         )
    12734                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    12735                   )
    12736               )
    12737       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    12738   ).
    12739   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    12740   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    12741     end.
    12742     when 'IBM':U
    12743     then do:
    12744   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12745   if for-cash-desk.cash-os = ""
    12746   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    12747   then NEXT.
    12748   assign
    12749   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
    12750               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    12751   Cash-DOS = NOT CASH-OS2
    12752   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
    12753   v-dir-remote-tmp = v-remote + "tmp":U
    12754   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
    12755   .
    12756   if for-cash-desk.remote = 1 then do:
    12757     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
    12758       if error-status:error then do:
    12759         run write-log-and-file in p-log-handle (
    12760               input 1
    12761             , input log-file-name
    12762             , input 1
    12763             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    12764                               "и/или попытка его создания не удалась"
    12765                               ,v-dir-remote-tmp
    12766                               ,for-cash-desk.cash-num
    12767                               ,chr(10)
    12768                               )
    12769                                               ).
    12770         NEXT.
    12771     end.
    12772     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
    12773       if error-status:error then do:
    12774         run write-log-and-file in p-log-handle (
    12775               input 1
    12776             , input log-file-name
    12777             , input 1
    12778             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    12779                               "и/или попытка его создания не удалась"
    12780                               ,v-dir-remote
    12781                               ,for-cash-desk.cash-num
    12782                               ,chr(10)
    12783                               )
    12784                                               ).
    12785         NEXT.
    12786       end.
    12787   end.
    12788   output stream IBMStream
    12789   to value( (if for-cash-desk.remote = 1
    12790               then (v-dir-remote-tmp + chr(47) + "fl":U)
    12791               else out) + fname + '.dat' ) convert target "ibm866".
    12792   OS2-time =       ( if Cash-OS2 then
    12793                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
    12794                         else "" )
    12795   .
    12796     end.
    12797     when 'OMRON-NEW':U then do:
    12798   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12799   assign
