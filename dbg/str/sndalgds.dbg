      368   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      370                                                                     input  orders as integer):
      371   define variable  round-m-sum as decimal no-undo.
      372   if orders >= 0 then
      373   round-m-sum = round(mysum,orders).
      374   else
      375   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      376   return round-m-sum.
      377   END FUNCTION.
      378   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   procedure factord :
      380     define input  parameter p-fact-date            as date    no-undo .
      381     define input  parameter p-fact-time            as integer no-undo .
      382     define input  parameter p-fact-num             as integer no-undo .
      383     define input  parameter p-shift-date           as date    no-undo .
      384     define input  parameter p-shift-num            as integer no-undo .
      385     define input  parameter p-shift-on             as logical no-undo .
      386     define output parameter p-fact-order           as decimal no-undo .
      387     define output parameter p-shift-end-fact-order as decimal no-undo .
      388     define output parameter p-day-end-fact-order   as decimal no-undo .
      389     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      390     if p-fact-date = ?
      391     then do:
      392       return error "Не указана фактическая дата" .
      393     end.
      394     define variable v-fact-date-num as integer no-undo .
      395     assign
      396       v-fact-date-num = integer(p-fact-date)
      397     .
      398     if p-fact-num = ?
      399     or p-fact-num = 0
      400     then do:
      401       return error "Не задан p-fact-num " + string(p-fact-num) .
      402     end.
      403     if p-fact-num < 0
      404     then do:
      405       return error "Отрицательный fact-num " + string(p-fact-num) .
      406     end.
      407     if p-fact-num >= 100000000
      408     then do:
      409       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      410     end.
      411     if p-shift-on = true
      412     then do:
      413       if p-shift-date = ?
      414       then do:
      415         return error "Не задана дата смены" .
      416       end.
      417       if p-shift-num = ?
      418       or p-shift-num = 0
      419       then do:
      420         return error "Не задан номер смены" .
      421       end.
      422     end.
      423     else do:
      424       assign
      425         p-shift-date = p-fact-date
      426         p-shift-num  = 24
      427       .
      428     end.
      429     define variable v-shift-offset as integer no-undo .
      430     if p-shift-date = p-fact-date
      431     then do:
      432       assign
      433         v-shift-offset = 1
      434       .
      435     end.
      436     if p-shift-date < p-fact-date
      437     then do:
      438       assign
      439         v-shift-offset = 0
      440       .
      441     end.
      442     if p-shift-date > p-fact-date
      443     then do:
      444       message
      445         vss-workfile vss-revision vss-description skip
      446         "Неправильная дата закрытия смены" skip
      447         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      448         view-as alert-box error .
      449       undo, return error
      450         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      451           ,string(p-fact-date, '99/99/9999':U)
      452           ,string(p-shift-date, '99/99/9999':U)
      453           )
      454       .
      455     end.
      456     if p-shift-num < 1
      457     or p-shift-num > 24
      458     then do:
      459       message
      460         vss-workfile vss-revision vss-description skip
      461         "Неправильный номер смены" skip
      462         "p-shift-num" p-shift-num skip
      463         view-as alert-box error .
      464       undo, return error return-value .
      465     end.
      466     assign
      467       p-fact-order           = v-fact-date-num
      468                              + v-shift-offset * 0.5
      469                              + p-shift-num    * 0.02 - 0.01
      470                              + p-fact-num     * 0.0000000001
      471       p-shift-end-fact-order = v-fact-date-num
      472                              + v-shift-offset * 0.5
      473                              + p-shift-num    * 0.02
      474       p-day-end-fact-order   = v-fact-date-num
      475                              + 0.99
      476     .
      477     if p-fact-order           <= v-fact-date-num
      478     or p-shift-end-fact-order <= v-fact-date-num
      479     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      480     or p-shift-end-fact-order >= p-day-end-fact-order
      481     then do:
      482       message
      483         vss-workfile vss-revision vss-description skip
      484         "Внутренняя ошибка при генерации фактического номера" skip
      485         "p-fact-date"            p-fact-date            skip
      486         "p-fact-time"            p-fact-time            skip
      487         "p-fact-num"             p-fact-num             skip
      488         "p-shift-date"           p-shift-date           skip
      489         "p-shift-num"            p-shift-num            skip
      490         "p-shift-on"             p-shift-on             skip
      491         "p-shift-end-fact-order" p-shift-end-fact-order skip
      492         "p-day-end-fact-order"   p-day-end-fact-order   skip
      493         "v-fact-date-num"        v-fact-date-num        skip
      494         view-as alert-box error .
      495       undo, return error return-value .
      496     end.
      497   end procedure.
      498   procedure day-begin-fact-order :
      499     define input  parameter p-fact-date            as date    no-undo .
      500     define output parameter p-day-begin-fact-order as decimal no-undo .
      501     do
      502     on error undo, return error return-value
      503     :
      504       if p-fact-date = ?
      505       then do:
      506         assign
      507           p-day-begin-fact-order = 0
      508         .
      509       end.
      510       else do:
      511         assign
      512           p-day-begin-fact-order = integer(p-fact-date)
      513         .
      514       end.
      515     end.
      516   end procedure.
      517   procedure factord-max-fact-order :
      518     define output parameter p-max-fact-order as decimal   no-undo .
      519     do
      520     on error undo, return error return-value
      521     :
      522       run day-begin-fact-order in this-procedure
      523         (input  date(1, 1, 5000)
      524         ,output p-max-fact-order
      525         ) .
      526     end.
      527   end procedure.
      528   procedure factord-cut-archive :
      529     define input  parameter p-obj-type             as character no-undo .
      530     define input  parameter p-obj-code             as integer   no-undo .
      531     define input  parameter p-fact-date            as date      no-undo .
      532     define output parameter p-shift-on             as logical   no-undo .
      533     define output parameter p-shift-date           as date      no-undo .
      534     define output parameter p-shift-num            as integer   no-undo .
      535     define output parameter p-day-end-fact-order   as decimal   no-undo .
      536     define output parameter p-shift-end-fact-order as decimal   no-undo .
      537     define variable v-fact-order as decimal   no-undo .
      538     define buffer buf_shift-obj for ub.shift-obj .
      539     do
      540     on error undo, return error return-value
      541     :
      542   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      544     (input  p-obj-type
      545     ,input  p-obj-code
      546     ,input  'shift-on=request'
      547     ,output p-shift-on
      548     ) no-error .
      549       if error-status :error
      550       then do:
      551         message
      552           vss-workfile vss-revision vss-description skip
      553           "Ошибка при определении атрибута объекта" skip
      554           "Объект" p-obj-type p-obj-code skip
      555           error-status :get-message(1) skip
      556           return-value skip
      557           view-as alert-box error .
      558         undo, return error return-value .
      559       end.
      560       if p-shift-on = false
      561       then do:
      562         assign
      563           p-shift-date               = ?
      564           p-shift-num                = 0
      565         .
      566       end.
      567       else do:
      568         find first buf_shift-obj share-lock
      569           where buf_shift-obj.obj-type   = p-obj-type
      570             and buf_shift-obj.obj-code   = p-obj-code
      571             and buf_shift-obj.shift-date > p-fact-date
      572           use-index pi
      573           no-error .
      574         if not available buf_shift-obj
      575         or buf_shift-obj.status_ <> 'зкр':U
      576         then do:
      577           message
      578             vss-workfile vss-revision vss-description skip
      579             "Невозможно вычислить последнюю смену" skip
      580             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      581             "Объект" p-obj-type p-obj-code skip
      582             "Дата" p-fact-date skip
      583             view-as alert-box error .
      584           undo, return error return-value .
      585         end.
      586         find last buf_shift-obj share-lock
      587           where buf_shift-obj.obj-type = p-obj-type
      588             and buf_shift-obj.obj-code = p-obj-code
      589             and buf_shift-obj.shift-date <= p-fact-date
      590           use-index pi
      591           no-error .
      592         if available buf_shift-obj
      593         then do:
      594           if  buf_shift-obj.status_ = 'зкр':U
      595           then do:
      596             assign
      597               p-shift-date = buf_shift-obj.shift-date
      598               p-shift-num  = buf_shift-obj.shift-num
      599             .
      600           end.
      601           else do:
      602             message
      603               vss-workfile vss-revision vss-description skip
      604               "Невозможно вычислить последнюю смену" skip
      605               "Статус смены отличен от статуса" 'зкр':U skip
      606               "Объект" p-obj-type p-obj-code skip
      607               "Дата" p-fact-date skip
      608               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      609               view-as alert-box error .
      610             undo, return error return-value .
      611           end.
      612         end.
      613         else do:
      614           assign
      615             p-shift-date = p-fact-date - 1
      616             p-shift-num  = 1
      617           .
      618         end.
      619       end.
      620       run factord in this-procedure
      621         (input  p-fact-date
      622         ,input  1
      623         ,input  1
      624         ,input  p-shift-date
      625         ,input  p-shift-num
      626         ,input  p-shift-on
      627         ,output v-fact-order
      628         ,output p-shift-end-fact-order
      629         ,output p-day-end-fact-order
      630         ) no-error .
      631       if error-status :error
      632       then do:
      633         message
      634           vss-workfile vss-revision vss-description skip
      635           "Ошибка при вызове процедуры factord"
      636           error-status :get-message(1) skip
      637           return-value skip
      638           view-as alert-box error .
      639         undo, return error return-value .
      640       end.
      641     end.
      642   end procedure.
      643   procedure factord-lock-shift :
      644     define input  parameter p-obj-type  as character no-undo .
      645     define input  parameter p-obj-code  as integer   no-undo .
      646     define input  parameter p-fact-date as date      no-undo .
      647     define parameter buffer buf_shift-obj for ub.shift-obj .
      648     define variable v-shift-on      as logical   no-undo .
      649     define variable v-extra-message as character no-undo .
      650     define variable v-error as character no-undo .
      651     do
      652     on error undo, return error return-value
      653     :
      654   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      656     (input  p-obj-type
      657     ,input  p-obj-code
      658     ,input  'shift-on=request'
      659     ,output v-shift-on
      660     ) no-error .
      661       if error-status :error
      662       then do:
      663         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      664         undo, return error v-error .
      665       end.
      666       if v-shift-on = true
      667       then do:
      668         find first buf_shift-obj share-lock
      669           where buf_shift-obj.obj-type   = p-obj-type
      670             and buf_shift-obj.obj-code   = p-obj-code
      671             and buf_shift-obj.shift-date > p-fact-date
      672           use-index pi
      673           no-error .
      674         if not available buf_shift-obj
      675         or buf_shift-obj.status_ <> 'зкр':U
      676         then do:
      677           find last buf_shift-obj
      678             where buf_shift-obj.obj-type = p-obj-type
      679               and buf_shift-obj.obj-code = p-obj-code
      680               and buf_shift-obj.status_  = 'зкр':U
      681             use-index stts
      682             no-error .
      683           if available buf_shift-obj
      684           then do:
      685             assign
      686               v-extra-message =
      687                     substitute("Дата начала последеней закрытой смены на объекте &1"
      688                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      689                               )
      690             .
      691           end.
      692           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      693           undo, return error v-error .
      694         end.
      695       end.
      696     end.
      697   end procedure.
      698   procedure factord-end-day :
      699     define input  parameter p-fact-date            as date    no-undo .
      700     define output parameter p-day-end-fact-order   as decimal no-undo .
      701     do
      702     on error undo, return error return-value
      703     :
      704       if p-fact-date = ?
      705       then do:
      706         return error "Не указана фактическая дата" .
      707       end.
      708       assign
      709         p-day-end-fact-order = integer(p-fact-date) + 0.99
      710       .
      711     end.
      712   end procedure.
      713   procedure factord-to-date :
      714     define input  parameter p-fact-order as decimal no-undo .
      715     define output parameter p-fact-date  as date    no-undo .
      716     define variable v-ref-date  as date      no-undo .
      717     define variable v-ref-delta as integer   no-undo .
      718     do
      719     on error undo, return error return-value
      720     :
      721       if p-fact-order = ?
      722       or p-fact-order = 0
      723       then do:
      724         return error "Не указан fact-order" .
      725       end.
      726       assign
      727         v-ref-date  = date(1, 1, 2000)
      728       .
      729       assign
      730         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      731       .
      732       assign
      733         p-fact-date = v-ref-date + v-ref-delta
      734       .
      735     end.
      736   end procedure.
      737   procedure factord-to-fact-num :
      738     define input  parameter p-fact-order as decimal no-undo .
      739     define output parameter p-fact-num   as integer no-undo .
      740     define variable v-fact-order-trunc as decimal no-undo .
      741     do
      742     on error undo, return error return-value
      743     :
      744       if p-fact-order = ?
      745       or p-fact-order = 0
      746       then do:
      747         return error "Не указан fact-order" .
      748       end.
      749       assign
      750        v-fact-order-trunc = truncate(p-fact-order, 2)
      751       .
      752       assign
      753         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      754       .
      755     end.
      756   end procedure.
      757   procedure factord-to-shift-num :
      758     define input  parameter p-fact-order as decimal no-undo .
      759     define output parameter p-shift-num   as integer no-undo .
      760     define variable  p-shift-numd  as decimal   no-undo .
      761     define variable v-fact-order-trunc as decimal no-undo .
      762     do
      763     on error undo, return error return-value
      764     :
      765       if p-fact-order = ?
      766       or p-fact-order = 0
      767       then do:
      768         return error "Не указан fact-order" .
      769       end.
      770       assign
      771        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      772       .
      773       if v-fact-order-trunc < 0.5 then do:
      774         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      775       end.
      776       assign
      777         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      778         .
      779        assign
      780         p-shift-num = truncate (p-shift-numd , 0)
      781       .
      782     end.
      783   end procedure.
      784   define new global shared variable g#lib-trn  as handle no-undo .
      785   define new global shared variable g#lib-trn2 as handle no-undo .
      786   define new global shared variable g#lib-trn3 as handle no-undo .
      787   define new global shared variable g#lib-trn4 as handle no-undo .
      788   define temp-table  tt-tax no-undo
      789     field tax-code    like ub.tax.tax-code
      790     field individual  like ub.tax.individual
      791     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      792     field rate-code   like ub.tax-rate.rate-code
      793     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      794     field tax-type    like ub.tax.tax-type
      795     field rate-value  like ub.tax-rate-value.rate-value
      796     field tax-rate-gds-rc  as recid
      797     field to-cashdesk like ub.tax.to-cashdesk
      798     index tax-code is unique primary tax-code
      799     .
      800   procedure tax-val :
      801     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      802     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      803     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      804     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      805     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      806     define input  parameter       parunits-type like ub.units.type         no-undo.
      807     define input  parameter       parrec-id     as recid                   no-undo.
      808     define input  parameter       paris-log     as logical                 no-undo.
      809     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      810     define input  parameter       vattaxcdvalue as integer                 no-undo.
      811     define input  parameter       exctaxcdvalue as integer                 no-undo.
      812     define input  parameter       only-check    as logical                 no-undo.
      813     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      814     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      815     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      816     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      817     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      818     define output parameter       parerr-mes    as character               no-undo.
      819     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      820     do
      821     on error undo, return error return-value
      822     :
      823   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      825   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      826   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      827   define variable gp-excise     like ub.price-list.excise     no-undo.
      828   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      829   define variable gp-fact-order as decimal   no-undo .
      830   define variable gp-price-sale-parts as decimal   no-undo .
      831       define buffer buf_tax          for ub.tax .
      832       define buffer buf_tax-rate     for ub.tax-rate .
      833       define buffer buf_tax-units    for ub.tax-units .
      834       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      835       define buffer buf_goods        for ub.goods .
      836       define buffer buf_bar-code     for ub.bar-code .
      837       define buffer buf_prod-bc      for ub.prod-bc .
      838       define buffer buf_units        for ub.units .
      839       define buffer buf_shop         for ub.shop .
      840       define buffer buf_store        for ub.store .
      841       define buffer buf_gds-prt      for ub.gds-prt .
      842       define buffer buf_tt-tax       for tt-tax .
      843       define variable varrate-value    as decimal   initial ? no-undo.
      844       define variable pr-list-recid    as recid     initial ? no-undo.
      845       define variable varmes           as character no-undo.
      846       define variable varfactorrtvalue as char      initial ? no-undo.
      847       define variable varfactorrttype  as char      initial ? no-undo.
      848       define variable is-petrolium     as logical no-undo.
      849       define variable is-pieces        as logical no-undo.
      850       define variable vargds-code      like ub.goods.gds-code no-undo.
      851       define variable pargds-code      like ub.goods.gds-code no-undo.
      852       define variable var-fact-order   as decimal no-undo .
      853       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      854       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      855       define variable currate-gds-rc   as recid no-undo .
      856       define variable v-today          as date no-undo .
      857       define variable v-time           as integer no-undo .
      858       for each buf_tt-tax:
      859         delete buf_tt-tax.
      860       end.
      861       run cur-time in this-procedure(output v-today, output v-time).
      862       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      863       if parartic     = ?
      864       or parprod-type = ?
      865       or parprod-code = ?
      866       or parunit-base = ?
      867       then do:
      868         find first buf_goods no-lock
      869           where recid(buf_goods) = parrec-id
      870           no-error .
      871       end.
      872       else do:
      873         find first buf_goods no-lock
      874           where buf_goods.artic = parartic
      875             and buf_goods.prod-type = parprod-type
      876             and buf_goods.prod-code = parprod-code
      877           no-error .
      878       end.
      879       if not available buf_goods then do:
      880         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      881         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      882       end.
      883       assign
      884         parartic     = buf_goods.artic
      885         parprod-type = buf_goods.prod-type
      886         parprod-code = buf_goods.prod-code
      887         parunit-base = buf_goods.unit-base
      888         pargds-code  = buf_goods.gds-code
      889       .
      890       if parunits-type = ?
      891       then do:
      892         find buf_units no-lock
      893           where buf_units.unit-name = parunit-base
      894           no-error .
      895         if not available buf_units then do:
      896           assign
      897             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      898           .
      899           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      900         end.
      901         assign
      902           parunits-type = buf_units.type
      903         .
      904       end.
      905       if parhost-code = ?
      906       or parhost-code = 0
      907       then do:
      908   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      909   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      910     (input  parobj-type
      911     ,input  abs(parobj-code)
      912     ,output parhost-code
      913     ) no-error .
      914         if error-status :error then do:
      915           assign
      916             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      917               ,string(parobj-type)
      918               ,string(parobj-code)
      919               ) + chr(10)
      920           .
      921           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      922         end.
      923       end.
      924       assign
      925         vargds-code = buf_goods.gds-code
      926       .
      927       for each buf_tax-units no-lock
      928         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      929       ,first buf_tax no-lock
      930         where buf_tax.tax-code = buf_tax-units.tax-code
      931       :
      932         find first buf_tt-tax where
      933                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      934         if not available buf_tt-tax then do:
      935           create buf_tt-tax .
      936         end.
      937         assign
      938           buf_tt-tax.tax-code = buf_tax.tax-code
      939         .
      940         if buf_tax.individual = false then do:
      941           assign
      942             currate-gds-rc = ?
      943           .
      944           _tax-rate-gds:
      945           for each buf_tax-rate-gds no-lock where
      946                   buf_tax-rate-gds.gds-code = pargds-code and
      947                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      948           first buf_tax-rate where
      949                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      950                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      951           by buf_tax-rate-gds.host-code
      952           by buf_tax-rate-gds.obj-type
      953           by buf_tax-rate-gds.obj-code
      954           by buf_tax-rate-gds.fact-order
      955           :
      956             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      957               next _tax-rate-gds.
      958             end.
      959             if buf_tax-rate-gds.host-code = 0 or
      960               ((buf_tax-rate-gds.host-code = parhost-code) or
      961               (buf_tax-rate-gds.obj-type = parobj-type AND
      962               buf_tax-rate-gds.obj-code = parobj-code))
      963             then do:
      964               assign
      965               currate-code = buf_tax-rate.rate-code
      966               currate-name = buf_tax-rate.rate-name
      967               currate-gds-rc = recid(buf_tax-rate)
      968               .
      969             end.
      970             else do:
      971               next _tax-rate-gds.
      972             end.
      973           end.
      974           if currate-gds-rc = ? then do:
      975             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      976                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      977                             chr(10).
      978             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      979           end.
      980         end.
      981         assign
      982           buf_tt-tax.rate-code   = currate-code
      983           buf_tt-tax.individual  = buf_tax.individual
      984           buf_tt-tax.tax-name    = buf_tax.tax-name
      985           buf_tt-tax.rate-name   = currate-name
      986           buf_tt-tax.tax-type    = buf_tax.tax-type
      987           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
      988           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
      989         .
      990       end.
      991       if parprice-sale = ?
      992       or parexcise     = ?
      993       or parroad-tax   = ?
      994       then do:
      995         if parnode-code = ? then do:
