        1   block-level on error undo, throw.
        2   define input  parameter iUtil as class ibs.th.utl.method-for-draw-utility no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision: 7b0cc5f31b3c, 1617, rls $":U.
        4   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U.
        5   define variable vss-date        as character no-undo initial "$Date: Tue Nov 06 04:41:38 2018 +0300 $":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile: rvs-auto-draw.p $":U.
        7   define variable vss-archive     as character no-undo initial "$Archive: str/rvs-auto-draw.p $":U.
        8   define variable vss-description as character no-undo initial "Автоматическое создание контрольной сверки":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   define new shared variable g#auto-pid           as integer   no-undo .
       65   define new shared variable conn-par             as character no-undo .
       66   define new shared variable g#auto-user-id       as character no-undo .
       67   define new shared variable g#auto-user-login    as character no-undo .
       68   define new shared variable g#auto-user-password as character no-undo .
       69   define new shared variable v-socket             as logical   no-undo .
       70   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new shared variable auto-window-h     as handle    no-undo .
       72   define new shared variable auto-log-msg-h    as handle    no-undo .
       73   define new shared variable hand-log-msg-h    as handle    no-undo .
       74   define new shared variable log-file-name     as character no-undo initial ? .
       75   define new shared variable add-log-file-name as character no-undo initial ? .
       76   define new shared variable writelogvalue     as character no-undo initial ? .
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define stream LogStream .
      307   define variable mNoTime as logical no-undo.
      308   procedure write-to-log-notime :
      309     define input param i-str as character no-undo .
      310     mNoTime = yes.
      311     run write-to-log (i-str).
      312     mNoTime = no.
      313   end.
      314   procedure write-to-log :
      315     define input param p-str as character no-undo .
      316     do
      317     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      318     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      319     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      320     :
      321       define variable log-res        as logical   no-undo .
      322       define variable v-jj           as integer   no-undo .
      323       if    mNoTime
      324          or writelogvalue eq "AsyncProc"
      325       then
      326          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      327       else
      328          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      329       if auto-log-msg-h <> ? then do:
      330         log-res = auto-log-msg-h:move-to-eof( ) .
      331         log-res = auto-log-msg-h:insert-string( p-str ).
      332       end.
      333       if hand-log-msg-h <> ? then do:
      334         log-res = hand-log-msg-h:move-to-eof( ) .
      335         log-res = hand-log-msg-h:insert-string( p-str ).
      336       end.
      337       assign
      338         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      339         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      340         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      341       .
      342       if add-log-file-name <> ? then do:
      343         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      344           run gbl/fileapnd.p
      345             ( input entry(v-jj, add-log-file-name, chr(1) )
      346             ,input p-str
      347             ,input 20
      348             ) no-error .
      349           if error-status:error then do:
      350             return error return-value .
      351           end.
      352         end.
      353       end.
      354       if writelogvalue eq "AsyncProc"
      355       then do:
      356          p-str = trim(p-str, (chr(13) + chr(10)) )
      357       .
      358          Publish "WriteLogAsunc" (p-str,yes).
      359       end.
      360       else if writelogvalue <> "yes" then do:
      361         run gbl/fileapnd.p
      362           ( input log-file-name
      363           ,input p-str
      364           ,input 20
      365           ) no-error .
      366         if error-status:error then do:
      367           return error return-value .
      368         end.
      369       end.
      370     end.
      371   end procedure.
      372   procedure write-to-screen :
      373     define input param p-str as character no-undo .
      374     do
      375     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      376     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      377     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      378     :
      379       define variable log-res as logical no-undo.
      380       assign
      381         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      382       .
      383       if auto-log-msg-h <> ?
      384       then do:
      385         log-res = auto-log-msg-h:move-to-eof( ) .
      386         log-res = auto-log-msg-h:insert-string( p-str ).
      387       end.
      388       if hand-log-msg-h <> ?
      389       then do:
      390         log-res = hand-log-msg-h:move-to-eof( ) .
      391         log-res = hand-log-msg-h:insert-string( p-str ).
      392       end.
      393     end.
      394   end procedure.
      395   procedure send-msg-to-email :
      396     define input  parameter p-subject      as character no-undo .
      397     define input  parameter p-text-err     as character no-undo .
      398     define input  parameter p-attach-files as character no-undo .
      399     do
      400     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      401     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      403     :
      404       define variable v-tth             as handle    no-undo .
      405       define variable v-value-character as character no-undo .
      406       define variable v-value-date      as date      no-undo .
      407       define variable v-value-decimal   as decimal   no-undo .
      408       define variable v-value-integer   as integer   no-undo .
      409       define variable v-value-logical   as logical   no-undo .
      410       define variable v-param-type      as character no-undo .
      411       define variable v-email       as character no-undo .
      412       define variable v-tmp-str     as character no-undo .
      413       define variable v-tmp1-str    as character no-undo .
      414       define variable v-ind         as integer   no-undo .
      415       define variable v-num-entries as integer   no-undo .
      416       delete object v-tth no-error.
      417       run adm/shattri.p
      418         ( input "get":U
      419          ,input  "":U
      420          ,input  0
      421          ,input  'auto-task':U
      422          ,input  'send-msg-to-email':U
      423          ,output v-value-character
      424          ,output v-value-date
      425          ,output v-value-decimal
      426          ,output v-value-integer
      427          ,output v-value-logical
      428          ,output v-param-type
      429          ,input-output table-handle v-tth
      430         ) no-error .
      431       if not error-status :error  then do:
      432         assign
      433           v-tmp-str = v-value-character
      434         .
      435       end.
      436       delete object v-tth no-error.
      437       assign
      438         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      439         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      440         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      441         v-num-entries = num-entries( v-tmp-str, chr(44) )
      442         v-email       = "":U
      443       .
      444       do v-ind = 1 to v-num-entries
      445       :
      446         assign
      447           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      448         .
      449         if trim( v-tmp1-str ) <> "":U then do:
      450           if v-email = "":U then do:
      451             assign
      452               v-email = v-tmp1-str
      453             .
      454           end.
      455           else do:
      456             assign
      457               v-email = v-email + chr(44) + v-tmp1-str
      458             .
      459           end.
      460         end.
      461       end.
      462       if v-email <> "":U then do:
      463         run gbl/sendmail.p
      464           ( input v-email
      465           , input p-subject
      466           , input p-text-err
      467           , input p-attach-files
      468           ) no-error .
      469         if error-status :error
      470           or return-value <> "":U
      471         then do:
      472           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      473         end.
      474       end.
      475     end.
      476   end procedure.
      477   run adm/autoinit.p ("","").
      478   subscribe   to "RvsParam" anywhere run-procedure "ParamRvs".
      479   subscribe   to "getObjList" anywhere run-procedure "ObjList".
      480   run str/rvs-auto.p (iUtil:parparentproc,this-procedure,this-procedure,ibs.th.gbl.gbl-var:g#db-num,?,?,ibs.th.gbl.gbl-var:g#db-num).
      481   unsubscribe to "getObjList".
      482   unsubscribe to "RvsParam".
      483   procedure ObjList:
      484      define output parameter oAnswer as char no-undo.
      485      oAnswer = substitute("&1*&2",iUtil:Obj-type,iUtil:Obj-code).
      486   end procedure.
      487   procedure ParamRvs:
      488      define output parameter oAnswer as char no-undo.
      489      // нулевая сверка
      490      oAnswer = "yes".
      491   end procedure.
