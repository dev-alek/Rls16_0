    10477         assign
    10478           sum87 = 0
    10479         .
    10480         do i87 = 1 to len-code87 by 2
    10481         :
    10482           assign
    10483             v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10484           .
    10485           if v-sum-char87 < "0"
