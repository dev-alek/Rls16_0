    14394       end.
    14395     return "error":U.
    14396   end.
    14397   else do:
    14398     for each temp-cd-plu,
    14399         first buf_cd-plu where
    14400                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    14401                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    14402                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    14403                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    14404                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    14405       if temp-cd-plu.to-del = yes
    14406       and v-del-mrkt-gds
    14407       then do:
    14408         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    14409           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    14410           assign
    14411           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    14412           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    14413           .
    14414         end.
    14415         if buf_cd-plu.charkey_one = '':U then do:
    14416           delete buf_cd-plu.
    14417           NEXT.
    14418         end.
    14419       end.
    14420       if temp-cd-plu.charkey_two = "":U
    14421       then
    14422       assign
    14423       buf_cd-plu.charkey_two = "":U
    14424       buf_cd-plu.to-send = no
    14425       .
    14426       delete temp-cd-plu.
    14427     end.
    14428   end.
    14429   end.
