      150   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   def new shared var bc-frmt as character no-undo .
      152   def new shared var bc-pfx  as character no-undo .
      153   def var bc-par-type as character no-undo .
      154       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      155       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      156           do:
      157               message "Не задан или не верно задан ТИП собственного бар-кода!"
      158                   view-as alert-box ERROR TITLE "".
      159               return error.
      160           end.
      161       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      162       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      163           do:
      164               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      165                   view-as alert-box ERROR TITLE "".
      166               return error.
      167           end.
      168   PROCEDURE gen-bc:
      169     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      170     def output parameter full-b-code     as character init ""    no-undo .
      171   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172     define variable tmp-str5  as character no-undo.
      173     define variable tmp-num5  as character no-undo.
      174     define variable i5        as integer   no-undo.
      175     define variable sum5      as integer   no-undo.
      176     define variable len-code5 as integer   no-undo.
      177     define variable varcont5  as logical   initial yes no-undo.
      178     CASE bc-frmt :
      179       WHEN "EAN13" THEN do:
      180         assign
      181           tmp-str5 = string( internal-b-code, "999999999999" )
      182         .
      183       end.
      184       WHEN "EAN8" THEN do:
      185         assign
      186           tmp-str5 = string( internal-b-code, "9999999" )
      187         .
      188       end.
      189       OTHERWISE DO:
      190           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      191           view-as alert-box error.
      192           return error.
      193       END.
      194     END CASE.
      195     if varcont5 = yes then do:
      196       if integer( substring( tmp-str5, 1, length( bc-pfx ) ) ) <> 0
      197       then do:
      198         message
      199           "Невозможно сформировать бар-код" SKIP
      200           "для товара с кодом: " internal-b-code
      201           view-as alert-box error title "подрезание кода".
      202         return error.
      203       end.
      204       else do:
      205         assign
      206           full-b-code = bc-pfx + substring( tmp-str5, length( bc-pfx ) + 1, length( tmp-str5 ) - length( bc-pfx ) )
      207           len-code5    = length( full-b-code )
      208         .
      209         define variable v-sum-char5 as character no-undo .
      210         assign
      211           sum5 = 0
      212         .
      213         do i5 = 1 to len-code5 by 2
      214         :
      215           assign
      216             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      217           .
      218           if v-sum-char5 < "0"
      219           or v-sum-char5 > "9"
      220           then do:
      221             message
      222               "Невозможно сформировать бар-код" skip
      223               "для товара с кодом: " internal-b-code skip
      224               view-as alert-box error title "подсчет контрольной суммы".
      225             return error.
      226           end.
      227           assign
      228             sum5 = sum5 + integer(v-sum-char5)
      229           .
      230         end.
      231         if varcont5 = yes then do:
      232           assign
      233             sum5 = sum5 * 3
      234           .
      235           do i5 = 2 to len-code5 by 2
      236           :
      237             assign
      238               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      239             .
      240             if v-sum-char5 < "0"
      241             or v-sum-char5 > "9"
      242             then do:
      243               message
      244                 "Невозможно сформировать бар-код" skip
      245                 "для товара с кодом: " internal-b-code skip
      246                 view-as alert-box error title "подсчет контрольной суммы".
      247               return error.
      248             end.
      249             assign
      250               sum5 = sum5 + integer(v-sum-char5)
      251             .
      252           end.
      253           if varcont5 = yes then do:
      254              if sum5 mod 10 = 0 then do:
      255                assign
      256                  full-b-code = full-b-code + '0'
      257                .
      258              end.
      259              else do:
      260                assign
      261                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      262                .
      263              end.
      264           end.
      265         end.
      266       end.
      267     end.
      268   END PROCEDURE.
