     1137             find FIRST buf_prod-bc where
     1138                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1139                         buf_prod-bc.bc-on = yes no-lock no-error.
     1140             if not available buf_prod-bc then do:
     1141               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1142                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
