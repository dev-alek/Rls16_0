    12545   assign
    12546   ncrdsc = "0":U
    12547   conf-par = "":U
    12548   par-type ="":U
    12549   .
    12550   if std-disc-dec <> 0
    12551   or pos-type = 'NCR-AS@R':U
    12552   then do:
    12553     do ff = 1 to num-entries(ncrgmdsc, ";":U):
    12554       assign
    12555       par-type = entry(ff, ncrgmdsc , ";":U)
    12556       conf-par = entry(2, par-type, "=":U)
    12557       no-error
    12558       .
    12559       if error-status:error then do:
    12560         LEAVE.
    12561       end.
    12562       if conf-par  = string( - std-disc-dec) then do:
    12563         ncrdsc =  entry(1, par-type, "=").
    12564         LEAVE.
    12565       end.
    12566     end.
    12567   end.
    12568   assign
    12569   IBM-good-code = "":U
    12570   is-sc = no
    12571   .
    12572   run ncr-gdsc in this-procedure (output IBM-good-code
    12573                                 , output IBM-good-code-2
    12574                                 , output is-sc
    12575                                 , output taracode-bc
    12576                                 ) no-error .
