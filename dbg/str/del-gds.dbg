    10569           view-as alert-box error title "подрезание кода".
    10570         return error.
    10571       end.
    10572       else do:
    10573         assign
    10574           IBm-good-code = ncrpg-pfx + substring( tmp-str88, length( ncrpg-pfx ) + 1, length( tmp-str88 ) - length( ncrpg-pfx ) )
    10575           len-code88    = length( IBm-good-code )
