    10444     define variable varcont87  as logical   initial yes no-undo.
    10445     CASE ncrsc-frmt :
    10446       WHEN "EAN13" THEN do:
    10447         assign
    10448           tmp-str87 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10449         .
    10450       end.
    10451       WHEN "EAN8" THEN do:
    10452         assign
