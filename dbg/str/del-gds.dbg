     7668   define variable v-main-prt-b-code as integer no-undo .
     7669   define variable IBM-good-code as character no-undo .
     7670   define variable IBM-good-code-2 as character no-undo .
     7671   define variable IBM2-short      as character no-undo .
     7672   define variable v-gds-null-price as character no-undo .
     7673   define variable iii as integer no-undo .
     7674   define variable v-mask-full as character no-undo .
     7675   define variable v-mask-short as character no-undo .
     7676   define variable vKKT as integer no-undo.
     7677   define variable attrValue as character no-undo.
     7678   define variable attrType  as character no-undo.
     7679   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7680   define buffer buf_price-list for ub.price-list.
