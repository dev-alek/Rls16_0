    10831         if available cash-dis-time-rule
    10832         and cash-dis-time-rule.templ-rl-root = 50001
    10833             or
    10834             (
    10835              (
    10836               (cash-dis-time-rule.date-from < today)
    10837               or
    10838               (cash-dis-time-rule.date-from = 12/31/1989)
    10839              )
    10840             and
    10841             (
    10842              (cash-dis-time-rule.date-to >= today)
    10843              or
    10844              (cash-dis-time-rule.date-to = 12/31/1989)
    10845             )
    10846            ) then do:
    10847            temp-disc-dec = ?.
    10848         end.
    10849         else do:
    10850           assign
    10851           temp-disc-dec = 0
    10852           .
    10853         end.
    10854       end.
    10855       else do:
    10856         temp-disc-dec = ?.
    10857       end.
    10858       if temp-disc-dec = ? then do:
    10859         case cash-dis-rule.value-type:
    10860           when integer('1':U) then do:
    10861         assign
    10862         temp-disc-dec = - cash-dis-rule.discnt-value
    10863         .
    10864       end.
    10865           when integer('11':U) then do:
