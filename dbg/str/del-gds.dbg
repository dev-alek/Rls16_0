     1155                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1156               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1157             end.
     1158           end.
     1159           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1160             ASSIGN
     1161             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1162                                   then integer(buf_prod-bc.b-str)
     1163                                   else buf_bar-code.b-code
     1164             buf_tt-tax.rate-value  = parroad-tax
     1165             buf_tt-tax.tax-rate-gds-rc  = ?
     1166             NO-ERROR.
