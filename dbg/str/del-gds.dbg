     1520   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1522   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1523   procedure disrules-fill-properties:
     1524   define input  parameter p-templ-rl-root as integer   no-undo .
     1525   define buffer buf_drt-prop for ub.drt-prop.
     1526   define buffer buf_temp-drt-prop for temp-drt-prop.
     1527   do
     1528   on error undo, return error return-value
     1529   :
     1530     for each buf_temp-drt-prop:
     1531       delete buf_temp-drt-prop.
     1532     end.
     1533     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1534       create buf_temp-drt-prop.
     1535       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1536     end.
     1537   end.
     1538   end procedure.
     1539   ~
     1540   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1541   procedure discfgru-check :
     1542   define input parameter p-table-name as character no-undo .
     1543   define input parameter p-templ-rl-root as integer no-undo .
     1544   define input parameter p-time-templ-rl-root as integer no-undo .
     1545   define input parameter p-pos-type as character no-undo .
     1546   define output parameter p-disnct-role as character no-undo .
     1547   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       find first buf_dis-cfg-rule no-lock where
     1552               buf_dis-cfg-rule.table-name = p-table-name
     1553           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1554           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1555           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1556       if not available buf_dis-cfg-rule
     1557       or p-pos-type = "":U
     1558       then do:
     1559          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1560                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1561                                  , p-templ-rl-root
     1562                                  , (if p-time-templ-rl-root = ?
     1563                                     then '':U
     1564                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1565                                     )
     1566                                  ).
     1567       end.
     1568       assign
     1569       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1570       .
     1571     end.
     1572   end procedure.
     1573   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1574   FUNCTION get-region RETURNS CHARACTER
     1575     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1576     define variable par-region as character no-undo.
     1577     if parhost-code = 0 and
     1578          parobj-type = "":U and
     1579          parobj-code = 0 then do:
     1580          par-region = "Глобально".
     1581          return par-region.
     1582       end.
     1583       if parobj-type = 'орг':U then do:
     1584          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1585          return par-region.
     1586       end.
     1587       if parobj-type = 'регион':U
     1588       then do:
     1589          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1590          return par-region.
     1591       end.
     1592       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1593       return par-region.
     1594   END FUNCTION.
     1595   FUNCTION get-objregion RETURNS CHARACTER
     1596     (  input parobj-type as character, input parobj-code as integer ) :
     1597     define variable par-region as character no-undo.
     1598     if  parobj-type = "":U and
     1599         parobj-code = 0
     1600     then do:
     1601        par-region = "Глобально".
     1602     end.
     1603     else if parobj-type = 'орг':U
     1604     then do:
     1605        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1606     end.
     1607     else if parobj-type = 'регион':U
     1608     then do:
     1609        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1610     end.
     1611     else
     1612        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1613     return par-region.
     1614   END FUNCTION.
     1615   procedure disgdsru-name :
     1616   define buffer buf_dis-rule for ub.dis-rule.
     1617   do
     1618     on error undo, return error
     1619     :
     1620     define input  parameter p-templ-rl-root  as integer no-undo .
     1621     define output parameter p-label          as character no-undo .
     1622     find first buf_dis-rule no-lock where
     1623               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1624     if available buf_dis-rule
     1625     then do:
     1626       if buf_dis-rule.rule-num > 0 then
     1627       p-label = buf_dis-rule.des.
     1628     end.
     1629     else do:
     1630       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1631     end.
     1632   end.
     1633   end procedure.
     1634   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1635   define variable v-rule-label as character no-undo .
     1636   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1637                                        ,output v-rule-label) no-error.
     1638   return v-rule-label.
     1639   end function.
     1640   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1641   define variable v-rule-label as character no-undo .
     1642   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1643   end function.
     1644   procedure disgdsru-write :
     1645     do
     1646     on error undo, return error
     1647     :
     1648       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1649       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1650       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1651       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1652       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1653       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1654       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1655       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1656       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1657       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1658       define buffer buf_dis-rule for ub.dis-rule.
     1659       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1660       define variable v-label          as character no-undo .
     1661       define variable v-discnt-role as character no-undo .
     1662       run discfgru-check in this-procedure (
     1663                                             input 'dis-gds-rule':U
     1664                                            ,input p-templ-rl-root
     1665                                            ,input p-time-templ-rl-root
     1666                                            ,input p-pos-type
     1667                                            ,output v-discnt-role
     1668                                             ) no-error .
     1669       if error-status :error then do:
     1670         undo, return error return-value .
     1671       end.
     1672       if p-discnt-role = ? then do:
     1673         p-discnt-role = v-discnt-role.
     1674       end.
     1675       if p-discnt-role <> v-discnt-role then do:
     1676         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1677                                 ,p-gds-code
     1678                                 ,p-obj-type
     1679                                 ,p-obj-code
     1680                                 ,p-pos-type
     1681                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1682                                 ,chr(10)
     1683                                 ,p-templ-rl-root
     1684                                 ,p-rule-num).
     1685       end.
     1686       if p-pos-type = ? then do:
     1687   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   define variable v-param-type24 as character no-undo .
     1689   define variable v-value-date24 as date no-undo .
     1690   define variable v-value-decimal24 as decimal no-undo .
     1691   define variable v-value-integer24 as INTEGER no-undo .
     1692   define variable v-value-logical24 AS LOGICAL no-undo .
     1693   define variable v-tth24 as handle no-undo .
     1694   run adm/shattri.p (
     1695       input "get":U
     1696       ,input  p-obj-type
     1697       ,input  p-obj-code
     1698       ,input  'cd-sending':U
     1699       ,input  'dflt-cd':U
     1700       ,output p-pos-type
     1701       ,output v-value-date24
     1702       ,output v-value-decimal24
     1703       ,output v-value-integer24
     1704       ,output v-value-logical24
     1705       ,output v-param-type24
     1706       ,INPUT-OUTPUT table-handle v-tth24
     1707       )  .
     1708   delete object v-tth24 no-error.
     1709       end.
     1710       find first buf_dis-rule no-lock where
     1711                 buf_dis-rule.rule-num = p-rule-num no-error.
     1712       if not available buf_Dis-rule then do:
     1713         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1714                                 ,p-gds-code
     1715                                 ,p-obj-type
     1716                                 ,p-obj-code
     1717                                 ,p-pos-type
     1718                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1719                                 ,chr(10)
     1720                                 ,p-rule-num).
     1721       end.
     1722       if buf_dis-rule.root <> yes then do:
     1723         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1724                                 ,p-gds-code
     1725                                 ,p-obj-type
     1726                                 ,p-obj-code
     1727                                 ,p-pos-type
     1728                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1729                                 ,chr(10)
     1730                                 ,p-rule-num).
     1731       end.
     1732       if not (p-obj-type = buf_dis-rule.obj-type
     1733           and p-obj-code = buf_dis-rule.obj-code)
     1734       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1735                and
     1736                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1737        then do:
     1738         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1739                                 ,p-gds-code
     1740                                 ,p-obj-type
     1741                                 ,p-obj-code
     1742                                 ,p-pos-type
     1743                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1744                                 ,chr(10)
     1745                                 ) +
     1746                             substitute("Правило скидки &1 определено для &2&3" +
     1747                                        "а привязка к товару для &4"
     1748                                        ,buf_dis-rule.rule-num
     1749                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1750                                        ,chr(10)
     1751                                        ,get-objregion( p-obj-type, p-obj-code)
     1752                                        ))
     1753                                 .
     1754       end.
     1755       find first buf_dis-gds-rule exclusive-lock where
     1756                  buf_dis-gds-rule.gds-code  = p-gds-code
     1757              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1758              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1759              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1760              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1761              and buf_dis-gds-rule.nonunique = p-nonunique
     1762              no-error .
     1763       if not available buf_dis-gds-rule then do:
     1764         find first buf_dis-gds-rule exclusive-lock where
     1765                   buf_dis-gds-rule.gds-code  = p-gds-code
     1766               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1767               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1768               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1769               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1770               no-error .
     1771         if available buf_Dis-gds-rule then do:
     1772           if p-nonunique = ''
     1773           and available buf_dis-gds-rule
     1774           then do:
     1775             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1776                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1777                                      , p-gds-code
     1778                                      , buf_Dis-rule.obj-type
     1779                                      , buf_Dis-rule.obj-code
     1780                                      , p-nonunique
     1781                                     ).
     1782           end.
     1783           if available buf_dis-gds-rule
     1784           and buf_dis-gds-rule.nonunique = ''
     1785           and p-nonunique <> ''then do:
     1786             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1787                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1788                                      , p-gds-code
     1789                                      , buf_Dis-rule.obj-type
     1790                                      , buf_Dis-rule.obj-code
     1791                                     ).
     1792           end.
     1793         end.
     1794         create buf_dis-gds-rule .
     1795         assign
     1796         buf_dis-gds-rule.gds-code  = p-gds-code
     1797         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1798         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1799         buf_dis-gds-rule.pos-type = p-pos-type
     1800         buf_dis-gds-rule.discnt-role = v-discnt-role
     1801         buf_dis-gds-rule.rule-num = p-rule-num
     1802         buf_dis-gds-rule.nonunique = p-nonunique
     1803         no-error
     1804         .
     1805       end.
     1806       ASSIGN
     1807       buf_dis-gds-rule.rule-num = p-rule-num
     1808       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1809       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1810       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1811       buf_dis-gds-rule.nonunique = p-nonunique
     1812       no-error.
     1813     end.
     1814   end procedure.
     1815   PROCEDURE cmp-disgdsru-write :
     1816   do
     1817   on error undo, return error
     1818   :
     1819     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1820     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1821     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1822     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1823     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1824     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1825     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1826     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1827     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1828     define variable v-rule-label          as character no-undo .
     1829     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1830     define buffer buf_dis-rule     for ub.dis-rule.
     1831     run disgdsru-name in this-procedure (
     1832                                         input  p-templ-rl-root
     1833                                         ,output v-rule-label
     1834                                         ) no-error .
     1835     if error-status :error then do:
     1836       undo, return error return-value .
     1837     end.
     1838     find first buf_tt0-dis-gds-rule exclusive-lock where
     1839                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1840             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1841             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1842             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1843             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1844             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1845             no-error .
     1846     if not available buf_tt0-dis-gds-rule then do:
     1847       create buf_tt0-dis-gds-rule .
     1848       assign
     1849       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1850       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1851       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1852       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1853       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1854       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1855       no-error
     1856       .
     1857     end.
     1858     find first buf_dis-rule no-lock where
     1859               buf_dis-rule.rule-num = p-rule-num.
     1860     ASSIGN
     1861     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1862     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1863     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1864     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1865     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1866     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1867     no-error.
     1868     release buf_tt0-dis-gds-rule no-error .
     1869     if error-status:error then do:
     1870       undo, return error return-value .
     1871     end.
     1872   end.
     1873   END PROCEDURE.
     1874   define variable vss-include-info25 as character format "X(65)" no-undo
     1875   initial "@(#)$Workfile$ $Revision$".
     1876   define variable v-bgelib-bgefmt        as character         no-undo.
