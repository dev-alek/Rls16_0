    12391             put stream bar unformatted s skip.
    12392         end.
    12393       end.
    12394       when 'OMRON':U then  do:
    12395           chk_name = string( if nam-artc then cash-gds.artic else cash-gds.gds-name, "x(15)" ) + cash-gds.f-name +
    12396           (if cash-gds.unit-cli = cash-gds.unit-base then "" else ("*" + trim(string(cash-gds.cli-base-rate), chr(32)))).
    12397           if cash-gds.b-str = "" then do:
    12398               assign
    12399               b_code = string(cash-gds.b-code,'>>>>>>>>>>>>>>>9').
    12400               run gen-bc(input cash-gds.b-code, output bar_code) no-error.
    12401               if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12402                   (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12403                   put unformatted b_code '00101' caps(string(chk_name,'x(20)'))
    12404                                         string( ( cash-gds.price-sale * 100 ) ,'99999999').
    12405                   put unformatted '0000000000000000000000000000000'
    12406                   string(action, "X(1)") '0000000000000'.
    12407                   put skip.
    12408               end.
    12409               if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12410                   (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12411                   put unformatted (fill(" " , 16 -  length(bar_code)) + bar_code) '00101'
    12412                                                 caps(string(chk_name,'x(20)'))
    12413                                                 string(( cash-gds.price-sale * 100 ) ,'99999999') .
    12414                   put unformatted '0000000000000000000000000000000'
    12415                   string(action, "X(1)") '0000000000000'.
    12416                   put skip.
    12417               end.
    12418           end.
    12419           else do:
    12420             put unformatted ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12421                                       '00101' caps( string( chk_name, 'x(20)' ) )
    12422                                     string( ( cash-gds.price-sale * 100 ) ,'99999999') .
    12423             put unformatted '0000000000000000000000000000000'
    12424             string(action, "X(1)") '0000000000000'.
    12425             put skip.
    12426           end.
    12427         end.
    12428         when 'OMRON-NEW':U then  do:
    12429           assign
    12430           v-versiond = decimal(p-version)
    12431           no-error .
    12432           chk_name = string( if nam-artc then cash-gds.artic else cash-gds.gds-name, "x(15)" ) + cash-gds.f-name +
    12433           (if cash-gds.unit-cli = cash-gds.unit-base then "" else ("*" + trim(string(cash-gds.cli-base-rate), chr(32)))).
    12434           if v-versiond >= 33.0 then do:
