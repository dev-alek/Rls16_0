    14203                                       , input yes
    14204                                       , input 0
    14205                                       , input no
    14206                                       , input 7
    14207                                       , input 5000
    14208                                       , input v-plu
    14209                                       , input '001').
    14210         define variable maria-good-code122 as character no-undo .
    14211       assign
    14212         maria-good-code122 = left-trim(ibm-good-code, '0')
    14213         maria-good-code122 = fill('0', 14 - length(maria-good-code122)) + maria-good-code122
    14214       .
    14215         run maria-put in this-procedure (
    14216                                         buffer for-cash-desk
    14217                                       , input out
    14218                                       , input fname
    14219                                       , input yes
    14220                                       , input 0
    14221                                       , input no
    14222                                       , input 8
    14223                                       , input 5000
    14224                                       , input v-plu
    14225                                       , input (if v-marketer-action = "U"
    14226                                                 then (substring(maria-good-code122, 1, 5) + chr(4) +
    14227                                                       substring(maria-good-code122, 6, 14)
    14228                                                     )
    14229                                                 else (fill('0', 5) + chr(4) + fill('0', 9)))
    14230                                           ).
    14231         run maria-put in this-procedure (
    14232                                         buffer for-cash-desk
