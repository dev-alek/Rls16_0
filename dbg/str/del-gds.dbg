    14247                                       , input out
    14248                                       , input fname
    14249                                       , input yes
    14250                                       , input 0
    14251                                       , input no
    14252                                       , input 10
    14253                                       , input 5000
    14254                                       , input v-plu
    14255                                       , input (if v-marketer-action = "U"
    14256                                                 then (
    14257                                                     string(cash-gds.gds-stat MODULO 2) +
    14258                                                     string(if cash-gds.fp then 1 else 0) +
    14259                                                     string(cash-gds.office) )
    14260                                                 else '000')
    14261                                             ).
    14262         run maria-put in this-procedure (
