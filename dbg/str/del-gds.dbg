    10868                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    10869                   and cash-gds-discnt.obj-type = 'маг':U
    10870                   and cash-gds-discnt.obj-code = i-obj-code
    10871                   no-error.
    10872             if available cash-gds-discnt then do:
    10873               assign
