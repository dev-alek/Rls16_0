     4580     define input parameter parparentproc as widget-handle no-undo .
     4581     define input  parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     4582     define input  parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     4583     define input  parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
