     6644               p-plt-db-num       = tt_price-all.plt-db-num
     6645               p-pdf-id           = tt_price-all.pdf-id
     6646               p-pdf-db-num       = tt_price-all.pdf-db
     6647               p-sale-price-base  = tt_price-all.price-sale-base
     6648               p-sale-price-rubl  = tt_price-all.price-sale-rubl
