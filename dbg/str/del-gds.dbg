    15213                               and ub.curr-shop.obj-type = 'маг':U
    15214                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    15215                               use-index pi NO-ERROR.
    15216       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
