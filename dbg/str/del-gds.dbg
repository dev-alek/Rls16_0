    14649           ,output v-value-integer
    14650           ,output v-value-logical
    14651           ,output v-param-type
    14652           ,INPUT-OUTPUT table-handle v-tth
    14653           ) no-error .
    14654     IF not error-status:error
    14655     then dob-curr = v-value-character.
    14656     else do:
    14657       return error substitute("Ошибки при проверке параметра КОДЫ ДОПОЛН ВАЛЮТ ДЛЯ КАССЫ &1 для &2&3"
    14658                                 , 'IPC-Servis+':U
    14659                                 , 'маг':U
    14660                                 , abs(i-obj-code)).
    14661     end.
    14662     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
