      410   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      412                                                                     input  orders as integer):
      413   define variable  round-m-sum as decimal no-undo.
      414   if orders >= 0 then
      415   round-m-sum = round(mysum,orders).
      416   else
      417   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      418   return round-m-sum.
      419   END FUNCTION.
      420   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   procedure factord :
      422     define input  parameter p-fact-date            as date    no-undo .
      423     define input  parameter p-fact-time            as integer no-undo .
      424     define input  parameter p-fact-num             as integer no-undo .
      425     define input  parameter p-shift-date           as date    no-undo .
      426     define input  parameter p-shift-num            as integer no-undo .
      427     define input  parameter p-shift-on             as logical no-undo .
      428     define output parameter p-fact-order           as decimal no-undo .
      429     define output parameter p-shift-end-fact-order as decimal no-undo .
      430     define output parameter p-day-end-fact-order   as decimal no-undo .
      431     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      432     if p-fact-date = ?
      433     then do:
      434       return error "Не указана фактическая дата" .
      435     end.
      436     define variable v-fact-date-num as integer no-undo .
      437     assign
      438       v-fact-date-num = integer(p-fact-date)
      439     .
      440     if p-fact-num = ?
      441     or p-fact-num = 0
      442     then do:
      443       return error "Не задан p-fact-num " + string(p-fact-num) .
      444     end.
      445     if p-fact-num < 0
      446     then do:
      447       return error "Отрицательный fact-num " + string(p-fact-num) .
      448     end.
      449     if p-fact-num >= 100000000
      450     then do:
      451       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      452     end.
      453     if p-shift-on = true
      454     then do:
      455       if p-shift-date = ?
      456       then do:
      457         return error "Не задана дата смены" .
      458       end.
      459       if p-shift-num = ?
      460       or p-shift-num = 0
      461       then do:
      462         return error "Не задан номер смены" .
      463       end.
      464     end.
      465     else do:
      466       assign
      467         p-shift-date = p-fact-date
      468         p-shift-num  = 24
      469       .
      470     end.
      471     define variable v-shift-offset as integer no-undo .
      472     if p-shift-date = p-fact-date
      473     then do:
      474       assign
      475         v-shift-offset = 1
      476       .
      477     end.
      478     if p-shift-date < p-fact-date
      479     then do:
      480       assign
      481         v-shift-offset = 0
      482       .
      483     end.
      484     if p-shift-date > p-fact-date
      485     then do:
      486       message
      487         vss-workfile vss-revision vss-description skip
      488         "Неправильная дата закрытия смены" skip
      489         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      490         view-as alert-box error .
      491       undo, return error
      492         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      493           ,string(p-fact-date, '99/99/9999':U)
      494           ,string(p-shift-date, '99/99/9999':U)
      495           )
      496       .
      497     end.
      498     if p-shift-num < 1
      499     or p-shift-num > 24
      500     then do:
      501       message
      502         vss-workfile vss-revision vss-description skip
      503         "Неправильный номер смены" skip
      504         "p-shift-num" p-shift-num skip
      505         view-as alert-box error .
      506       undo, return error return-value .
      507     end.
      508     assign
      509       p-fact-order           = v-fact-date-num
      510                              + v-shift-offset * 0.5
      511                              + p-shift-num    * 0.02 - 0.01
      512                              + p-fact-num     * 0.0000000001
      513       p-shift-end-fact-order = v-fact-date-num
      514                              + v-shift-offset * 0.5
      515                              + p-shift-num    * 0.02
      516       p-day-end-fact-order   = v-fact-date-num
      517                              + 0.99
      518     .
      519     if p-fact-order           <= v-fact-date-num
      520     or p-shift-end-fact-order <= v-fact-date-num
      521     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      522     or p-shift-end-fact-order >= p-day-end-fact-order
      523     then do:
      524       message
      525         vss-workfile vss-revision vss-description skip
      526         "Внутренняя ошибка при генерации фактического номера" skip
      527         "p-fact-date"            p-fact-date            skip
      528         "p-fact-time"            p-fact-time            skip
      529         "p-fact-num"             p-fact-num             skip
      530         "p-shift-date"           p-shift-date           skip
      531         "p-shift-num"            p-shift-num            skip
      532         "p-shift-on"             p-shift-on             skip
      533         "p-shift-end-fact-order" p-shift-end-fact-order skip
      534         "p-day-end-fact-order"   p-day-end-fact-order   skip
      535         "v-fact-date-num"        v-fact-date-num        skip
      536         view-as alert-box error .
      537       undo, return error return-value .
      538     end.
      539   end procedure.
      540   procedure day-begin-fact-order :
      541     define input  parameter p-fact-date            as date    no-undo .
      542     define output parameter p-day-begin-fact-order as decimal no-undo .
      543     do
      544     on error undo, return error return-value
      545     :
      546       if p-fact-date = ?
      547       then do:
      548         assign
      549           p-day-begin-fact-order = 0
      550         .
      551       end.
      552       else do:
      553         assign
      554           p-day-begin-fact-order = integer(p-fact-date)
      555         .
      556       end.
      557     end.
      558   end procedure.
      559   procedure factord-max-fact-order :
      560     define output parameter p-max-fact-order as decimal   no-undo .
      561     do
      562     on error undo, return error return-value
      563     :
      564       run day-begin-fact-order in this-procedure
      565         (input  date(1, 1, 5000)
      566         ,output p-max-fact-order
      567         ) .
      568     end.
      569   end procedure.
      570   procedure factord-cut-archive :
      571     define input  parameter p-obj-type             as character no-undo .
      572     define input  parameter p-obj-code             as integer   no-undo .
      573     define input  parameter p-fact-date            as date      no-undo .
      574     define output parameter p-shift-on             as logical   no-undo .
      575     define output parameter p-shift-date           as date      no-undo .
      576     define output parameter p-shift-num            as integer   no-undo .
      577     define output parameter p-day-end-fact-order   as decimal   no-undo .
      578     define output parameter p-shift-end-fact-order as decimal   no-undo .
      579     define variable v-fact-order as decimal   no-undo .
      580     define buffer buf_shift-obj for ub.shift-obj .
      581     do
      582     on error undo, return error return-value
      583     :
      584   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      586     (input  p-obj-type
      587     ,input  p-obj-code
      588     ,input  'shift-on=request'
      589     ,output p-shift-on
      590     ) no-error .
      591       if error-status :error
      592       then do:
      593         message
      594           vss-workfile vss-revision vss-description skip
      595           "Ошибка при определении атрибута объекта" skip
      596           "Объект" p-obj-type p-obj-code skip
      597           error-status :get-message(1) skip
      598           return-value skip
      599           view-as alert-box error .
      600         undo, return error return-value .
      601       end.
      602       if p-shift-on = false
      603       then do:
      604         assign
      605           p-shift-date               = ?
      606           p-shift-num                = 0
      607         .
      608       end.
      609       else do:
      610         find first buf_shift-obj share-lock
      611           where buf_shift-obj.obj-type   = p-obj-type
      612             and buf_shift-obj.obj-code   = p-obj-code
      613             and buf_shift-obj.shift-date > p-fact-date
      614           use-index pi
      615           no-error .
      616         if not available buf_shift-obj
      617         or buf_shift-obj.status_ <> 'зкр':U
      618         then do:
      619           message
      620             vss-workfile vss-revision vss-description skip
      621             "Невозможно вычислить последнюю смену" skip
      622             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      623             "Объект" p-obj-type p-obj-code skip
      624             "Дата" p-fact-date skip
      625             view-as alert-box error .
      626           undo, return error return-value .
      627         end.
      628         find last buf_shift-obj share-lock
      629           where buf_shift-obj.obj-type = p-obj-type
      630             and buf_shift-obj.obj-code = p-obj-code
      631             and buf_shift-obj.shift-date <= p-fact-date
      632           use-index pi
      633           no-error .
      634         if available buf_shift-obj
      635         then do:
      636           if  buf_shift-obj.status_ = 'зкр':U
      637           then do:
      638             assign
      639               p-shift-date = buf_shift-obj.shift-date
      640               p-shift-num  = buf_shift-obj.shift-num
      641             .
      642           end.
      643           else do:
      644             message
      645               vss-workfile vss-revision vss-description skip
      646               "Невозможно вычислить последнюю смену" skip
      647               "Статус смены отличен от статуса" 'зкр':U skip
      648               "Объект" p-obj-type p-obj-code skip
      649               "Дата" p-fact-date skip
      650               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      651               view-as alert-box error .
      652             undo, return error return-value .
      653           end.
      654         end.
      655         else do:
      656           assign
      657             p-shift-date = p-fact-date - 1
      658             p-shift-num  = 1
      659           .
      660         end.
      661       end.
      662       run factord in this-procedure
      663         (input  p-fact-date
      664         ,input  1
      665         ,input  1
      666         ,input  p-shift-date
      667         ,input  p-shift-num
      668         ,input  p-shift-on
      669         ,output v-fact-order
      670         ,output p-shift-end-fact-order
      671         ,output p-day-end-fact-order
      672         ) no-error .
      673       if error-status :error
      674       then do:
      675         message
      676           vss-workfile vss-revision vss-description skip
      677           "Ошибка при вызове процедуры factord"
      678           error-status :get-message(1) skip
      679           return-value skip
      680           view-as alert-box error .
      681         undo, return error return-value .
      682       end.
      683     end.
      684   end procedure.
      685   procedure factord-lock-shift :
      686     define input  parameter p-obj-type  as character no-undo .
      687     define input  parameter p-obj-code  as integer   no-undo .
      688     define input  parameter p-fact-date as date      no-undo .
      689     define parameter buffer buf_shift-obj for ub.shift-obj .
      690     define variable v-shift-on      as logical   no-undo .
      691     define variable v-extra-message as character no-undo .
      692     define variable v-error as character no-undo .
      693     do
      694     on error undo, return error return-value
      695     :
      696   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      698     (input  p-obj-type
      699     ,input  p-obj-code
      700     ,input  'shift-on=request'
      701     ,output v-shift-on
      702     ) no-error .
      703       if error-status :error
      704       then do:
      705         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      706         undo, return error v-error .
      707       end.
      708       if v-shift-on = true
      709       then do:
      710         find first buf_shift-obj share-lock
      711           where buf_shift-obj.obj-type   = p-obj-type
      712             and buf_shift-obj.obj-code   = p-obj-code
      713             and buf_shift-obj.shift-date > p-fact-date
      714           use-index pi
      715           no-error .
      716         if not available buf_shift-obj
      717         or buf_shift-obj.status_ <> 'зкр':U
      718         then do:
      719           find last buf_shift-obj
      720             where buf_shift-obj.obj-type = p-obj-type
      721               and buf_shift-obj.obj-code = p-obj-code
      722               and buf_shift-obj.status_  = 'зкр':U
      723             use-index stts
      724             no-error .
      725           if available buf_shift-obj
      726           then do:
      727             assign
      728               v-extra-message =
      729                     substitute("Дата начала последеней закрытой смены на объекте &1"
      730                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      731                               )
      732             .
      733           end.
      734           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      735           undo, return error v-error .
      736         end.
      737       end.
      738     end.
      739   end procedure.
      740   procedure factord-end-day :
      741     define input  parameter p-fact-date            as date    no-undo .
      742     define output parameter p-day-end-fact-order   as decimal no-undo .
      743     do
      744     on error undo, return error return-value
      745     :
      746       if p-fact-date = ?
      747       then do:
      748         return error "Не указана фактическая дата" .
      749       end.
      750       assign
      751         p-day-end-fact-order = integer(p-fact-date) + 0.99
      752       .
      753     end.
      754   end procedure.
      755   procedure factord-to-date :
      756     define input  parameter p-fact-order as decimal no-undo .
      757     define output parameter p-fact-date  as date    no-undo .
      758     define variable v-ref-date  as date      no-undo .
      759     define variable v-ref-delta as integer   no-undo .
      760     do
      761     on error undo, return error return-value
      762     :
      763       if p-fact-order = ?
      764       or p-fact-order = 0
      765       then do:
      766         return error "Не указан fact-order" .
      767       end.
      768       assign
      769         v-ref-date  = date(1, 1, 2000)
      770       .
      771       assign
      772         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      773       .
      774       assign
      775         p-fact-date = v-ref-date + v-ref-delta
      776       .
      777     end.
      778   end procedure.
      779   procedure factord-to-fact-num :
      780     define input  parameter p-fact-order as decimal no-undo .
      781     define output parameter p-fact-num   as integer no-undo .
      782     define variable v-fact-order-trunc as decimal no-undo .
      783     do
      784     on error undo, return error return-value
      785     :
      786       if p-fact-order = ?
      787       or p-fact-order = 0
      788       then do:
      789         return error "Не указан fact-order" .
      790       end.
      791       assign
      792        v-fact-order-trunc = truncate(p-fact-order, 2)
      793       .
      794       assign
      795         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      796       .
      797     end.
      798   end procedure.
      799   procedure factord-to-shift-num :
      800     define input  parameter p-fact-order as decimal no-undo .
      801     define output parameter p-shift-num   as integer no-undo .
      802     define variable  p-shift-numd  as decimal   no-undo .
      803     define variable v-fact-order-trunc as decimal no-undo .
      804     do
      805     on error undo, return error return-value
      806     :
      807       if p-fact-order = ?
      808       or p-fact-order = 0
      809       then do:
      810         return error "Не указан fact-order" .
      811       end.
      812       assign
      813        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      814       .
      815       if v-fact-order-trunc < 0.5 then do:
      816         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      817       end.
      818       assign
      819         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      820         .
      821        assign
      822         p-shift-num = truncate (p-shift-numd , 0)
      823       .
      824     end.
      825   end procedure.
      826   define new global shared variable g#lib-trn  as handle no-undo .
      827   define new global shared variable g#lib-trn2 as handle no-undo .
      828   define new global shared variable g#lib-trn3 as handle no-undo .
      829   define new global shared variable g#lib-trn4 as handle no-undo .
      830   define temp-table  tt-tax no-undo
      831     field tax-code    like ub.tax.tax-code
      832     field individual  like ub.tax.individual
      833     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      834     field rate-code   like ub.tax-rate.rate-code
      835     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      836     field tax-type    like ub.tax.tax-type
      837     field rate-value  like ub.tax-rate-value.rate-value
      838     field tax-rate-gds-rc  as recid
      839     field to-cashdesk like ub.tax.to-cashdesk
      840     index tax-code is unique primary tax-code
      841     .
      842   procedure tax-val :
      843     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      844     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      845     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      846     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      847     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      848     define input  parameter       parunits-type like ub.units.type         no-undo.
      849     define input  parameter       parrec-id     as recid                   no-undo.
      850     define input  parameter       paris-log     as logical                 no-undo.
      851     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      852     define input  parameter       vattaxcdvalue as integer                 no-undo.
      853     define input  parameter       exctaxcdvalue as integer                 no-undo.
      854     define input  parameter       only-check    as logical                 no-undo.
      855     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      856     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      857     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      858     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      859     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      860     define output parameter       parerr-mes    as character               no-undo.
      861     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      862     do
      863     on error undo, return error return-value
      864     :
      865   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      867   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      868   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      869   define variable gp-excise     like ub.price-list.excise     no-undo.
      870   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      871   define variable gp-fact-order as decimal   no-undo .
      872   define variable gp-price-sale-parts as decimal   no-undo .
      873       define buffer buf_tax          for ub.tax .
      874       define buffer buf_tax-rate     for ub.tax-rate .
      875       define buffer buf_tax-units    for ub.tax-units .
      876       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      877       define buffer buf_goods        for ub.goods .
      878       define buffer buf_bar-code     for ub.bar-code .
      879       define buffer buf_prod-bc      for ub.prod-bc .
      880       define buffer buf_units        for ub.units .
      881       define buffer buf_shop         for ub.shop .
      882       define buffer buf_store        for ub.store .
      883       define buffer buf_gds-prt      for ub.gds-prt .
      884       define buffer buf_tt-tax       for tt-tax .
      885       define variable varrate-value    as decimal   initial ? no-undo.
      886       define variable pr-list-recid    as recid     initial ? no-undo.
      887       define variable varmes           as character no-undo.
      888       define variable varfactorrtvalue as char      initial ? no-undo.
      889       define variable varfactorrttype  as char      initial ? no-undo.
      890       define variable is-petrolium     as logical no-undo.
      891       define variable is-pieces        as logical no-undo.
      892       define variable vargds-code      like ub.goods.gds-code no-undo.
      893       define variable pargds-code      like ub.goods.gds-code no-undo.
      894       define variable var-fact-order   as decimal no-undo .
      895       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      896       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      897       define variable currate-gds-rc   as recid no-undo .
      898       define variable v-today          as date no-undo .
      899       define variable v-time           as integer no-undo .
      900       for each buf_tt-tax:
      901         delete buf_tt-tax.
      902       end.
      903       run cur-time in this-procedure(output v-today, output v-time).
      904       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      905       if parartic     = ?
      906       or parprod-type = ?
      907       or parprod-code = ?
      908       or parunit-base = ?
      909       then do:
      910         find first buf_goods no-lock
      911           where recid(buf_goods) = parrec-id
      912           no-error .
      913       end.
      914       else do:
      915         find first buf_goods no-lock
      916           where buf_goods.artic = parartic
      917             and buf_goods.prod-type = parprod-type
      918             and buf_goods.prod-code = parprod-code
      919           no-error .
      920       end.
      921       if not available buf_goods then do:
      922         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      923         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      924       end.
      925       assign
      926         parartic     = buf_goods.artic
      927         parprod-type = buf_goods.prod-type
      928         parprod-code = buf_goods.prod-code
      929         parunit-base = buf_goods.unit-base
      930         pargds-code  = buf_goods.gds-code
      931       .
      932       if parunits-type = ?
      933       then do:
      934         find buf_units no-lock
      935           where buf_units.unit-name = parunit-base
      936           no-error .
      937         if not available buf_units then do:
      938           assign
      939             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      940           .
      941           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      942         end.
      943         assign
      944           parunits-type = buf_units.type
      945         .
      946       end.
      947       if parhost-code = ?
      948       or parhost-code = 0
      949       then do:
      950   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      952     (input  parobj-type
      953     ,input  abs(parobj-code)
      954     ,output parhost-code
      955     ) no-error .
      956         if error-status :error then do:
      957           assign
      958             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      959               ,string(parobj-type)
      960               ,string(parobj-code)
      961               ) + chr(10)
      962           .
      963           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      964         end.
      965       end.
      966       assign
      967         vargds-code = buf_goods.gds-code
      968       .
      969       for each buf_tax-units no-lock
      970         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      971       ,first buf_tax no-lock
      972         where buf_tax.tax-code = buf_tax-units.tax-code
      973       :
      974         find first buf_tt-tax where
      975                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      976         if not available buf_tt-tax then do:
      977           create buf_tt-tax .
      978         end.
      979         assign
      980           buf_tt-tax.tax-code = buf_tax.tax-code
      981         .
      982         if buf_tax.individual = false then do:
      983           assign
      984             currate-gds-rc = ?
      985           .
      986           _tax-rate-gds:
      987           for each buf_tax-rate-gds no-lock where
      988                   buf_tax-rate-gds.gds-code = pargds-code and
      989                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      990           first buf_tax-rate where
      991                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      992                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      993           by buf_tax-rate-gds.host-code
      994           by buf_tax-rate-gds.obj-type
      995           by buf_tax-rate-gds.obj-code
      996           by buf_tax-rate-gds.fact-order
      997           :
      998             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      999               next _tax-rate-gds.
     1000             end.
     1001             if buf_tax-rate-gds.host-code = 0 or
     1002               ((buf_tax-rate-gds.host-code = parhost-code) or
     1003               (buf_tax-rate-gds.obj-type = parobj-type AND
     1004               buf_tax-rate-gds.obj-code = parobj-code))
     1005             then do:
