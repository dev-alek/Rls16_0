    13638             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) <= v-cd-disc-string then do:
    13639               next  _for_rr3.
    13640             end.
    13641           find first  cash-ncr-save-param no-lock where
    13642                         cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    13643                     AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    13644                                                       substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    13645           if available cash-ncr-save-param then do:
    13646             put stream plucash unformatted
    13647             cash-ncr-save-param.cd-line
