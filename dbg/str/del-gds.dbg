    12663                                                     ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12664                                                     ,input chk_name
    12665                                                     ,input (if action = 'D':U then 0 else cash-gds.std-discnt-rule)
    12666                                                     ,input ?
    12667                                                     ,input 'time-rule-num':U
    12668                                                     ,input ?
    12669                                                     ) no-error .
    12670       end.
    12671       ncr-disc-string = '':U.
    12672       if conf-par = "T":U then do:
    12673         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12674         if ncr-disc-string <> '':U then
    12675         PUT stream IBMstream unformatted
    12676         chr(32)
    12677         "T":U
    12678         chr(32)
    12679         IBM-good-code
    12680         chr(32)
    12681         chr(32)
    12682         ncr-disc-string
    12683         chr(10)
    12684         .
    12685       end.
    12686       if conf-par = "D":U then do:
    12687         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12688         if ncr-disc-string <> '':U then
    12689         PUT stream IBMstream unformatted
    12690         chr(32)
    12691         "D":U
    12692         chr(32)
    12693         IBM-good-code
    12694         chr(32)
    12695         chr(32)
    12696         ncr-disc-string
    12697         chr(10)
    12698         .
    12699       end.
    12700       if conf-par = "X":U then do:
    12701         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12702         if ncr-disc-string <> '':U then
    12703         PUT stream IBMstream unformatted
    12704         chr(32)
    12705         "X":U
    12706         chr(32)
    12707         IBm-good-code
    12708         chr(32)
    12709         chr(32)
    12710         ncr-disc-string
    12711         chr(10)
    12712         .
    12713       end.
    12714     end.
    12715     if pos-type = 'NCR-AS@R':U
    12716     and cash-gds.kat-discnt-rule <> 0
    12717     then do:
    12718       case how-pcnt-kat :
    12719         when 'pcnt-kat-pdf':U then do:
    12720             v-kat-discnt = cash-gds.price-sale.
    12721           end.
    12722         otherwise do:
    12723           v-kat-discnt = ?.
    12724         end.
    12725       end case.
    12726       run create-ncr-kat-discnt in this-procedure (
    12727                                                    input string(cash-gds.gds-code)
    12728                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12729                                                   ,input chk_name
    12730                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12731                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12732                                                   ,input 'time-rule-num':U
    12733                                                   ,input v-kat-discnt
    12734                                                   ) no-error .
    12735       if error-status:error then do:
    12736       end.
    12737     end.
    12738     if IBM-good-code = IBM-good-code-2 then leave do2.
    12739     assign
    12740     IBM-good-code = IBM-good-code-2
    12741     .
    12742   end.
    12743       end.
    12744     END CASE .
    12745   END PROCEDURE .
    12746   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12747   PROCEDURE   for-cash-cycle:
    12748   DEFINE VARIABLE fname-list as character no-undo .
    12749   DEFINE VARIABLE out-list as character no-undo .
    12750   DEFINE VARIABLE var-file-num as integer no-undo .
    12751   DEFINE VARIABLE v-dir-remote as character no-undo .
    12752   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
    12753   define variable v-plu as character no-undo .
    12754   define variable v-pl-code as integer no-undo .
    12755   define variable ss  as character no-undo .
    12756   define variable ss0  as character no-undo .
    12757   define variable v-temp-kat-file as character no-undo .
    12758   define variable v-kat-file as character no-undo .
    12759   define variable v-kat-file-save as character no-undo .
    12760   define variable v-updated-subject-dis-kat as logical no-undo .
    12761   define variable v-next as logical no-undo .
    12762   define variable v-cd-subject-code as character no-undo .
    12763   define variable v-cd-disc-string as character no-undo .
    12764   define variable v-versiond as decimal no-undo .
    12765   define variable v-maria-discnt-value as character no-undo .
    12766   define variable v-ii as integer no-undo .
    12767   define variable v-dop as character no-undo .
    12768   define variable v-gds-rule-num as integer no-undo .
    12769   define variable v-maria-rule-num as integer no-undo .
    12770   define buffer for-cash-desk for ub.cash-desk.
    12771   define buffer buf_cd-plu for ub.cd-plu.
    12772   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    12773   define buffer buf_cash-gds for cash-gds.
    12774   define buffer buf_dis-rule for ub.dis-rule.
    12775   define buffer buf_place for ub.place.
    12776   define buffer buf_pl-gds for ub.pl-gds.
    12777   FOR EACH for-cash-desk NO-LOCK WHERE
    12778           for-cash-desk.db-num = g#db-num AND
    12779           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12780           for-cash-desk.obj-code = i-obj-code AND
    12781    for-cash-desk.cash-on  = yes
    12782       BREAK
    12783       BY for-cash-desk.db-num
    12784       BY for-cash-desk.obj-code
    12785       BY for-cash-desk.pos-type
    12786       BY for-cash-desk.cash-on
    12787       BY for-cash-desk.cash-num
    12788       :
    12789     if LOOKUP(ub.cash-desk.pos-type,
    12790               ('NCR-GM':U + chr(44) +
    12791                'IBM-XML':U + chr(44) +
    12792                'MAGIA-XML':U + chr(44) +
    12793                'NCR-AS@R':U  + chr(44) +
    12794                'Autotank':U
    12795                  )) > 0
    12796     and for-cash-desk.autonomy = integer('1':U) then NEXT.
