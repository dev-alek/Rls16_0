    12583   .
    12584   do2:
    12585   do while IBm-good-code <> "":U:
    12586     if action = "D":U then do:
    12587       put stream IBMStream unformatted
    12588       fill(chr(32), 3)
    12589       IBM-good-code
    12590       "-":U
    12591       fill(chr(32), 61)
    12592       chr(10)
    12593       .
    12594     end.
    12595     else do:
    12596       if conf-par = "T":U then do:
    12597         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12598       end.
    12599       if conf-par = "D":U then do:
    12600         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12601       end.
    12602       if conf-par = "X":U then do:
    12603          ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12604       end.
    12605       if ncr-disc-string = '':U then
    12606       conf-par = chr(32) .
    12607       put stream IBMStream unformatted
    12608       fill(chr(32), 3)
    12609       IBM-good-code
    12610       string(if cash-gds.grp-code = 0 then 1 else cash-gds.grp-code , "9999":U)
    12611       (if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12612       or (is-sc
    12613       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12614       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    12615       then "2":U
    12616       else "0":U)
    12617       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    12618        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    12619        or is-sc
    12620        then "1":U
    12621        else "0":U)
    12622         (if pos-type = 'NCR-GM':U or
    12623         wd-option = 0
    12624         then   ncrdsc
    12625         else '0':U)
    12626        (if cash-gds.vat-code = ? or
    12627        cash-gds.vat-code > 7 then
    12628        "0"
    12629        else string(cash-gds.vat-code, "9"))
    12630       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12631       or (is-sc
    12632       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12633       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    12634       and  (cash-gds.taracode  <> '':u
    12635            or taracode-bc <> '')
    12636       then (if taracode-bc <> ''
    12637             then taracode-bc
    12638             else cash-gds.taracode)
    12639       else '00'
    12640       )
    12641       (if cash-gds.unit-cli begins "№"
    12642        then substring(cash-gds.unit-cli, 2, 2)
    12643        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    12644       "0010":U
    12645       "0000":U
    12646       chk_name
    12647       fill(chr(32), 4)
    12648       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12649       fill(chr(32), 8)
    12650       conf-par
    12651       replace(string( cash-gds.price-sale, "999999.99")
    12652              , ".":U, "":U
    12653              )
    12654       chr(10)
    12655       .
    12656       if pos-type = 'NCR-AS@R':U
    12657       and ncrdsc <> '0':U
    12658       and wd-option > 0
    12659       and cash-gds.std-discnt-rule > 0
    12660       then do:
    12661         run create-ncr-kat-discnt in this-procedure (
