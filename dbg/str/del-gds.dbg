     5490   procedure gds-attr-delete :
     5491     define input  parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     5492     define input  parameter p-code     like ub.goods-attr.attr-code  no-undo .
     5493     define output parameter p-deleted  as logical no-undo .
     5494     do
