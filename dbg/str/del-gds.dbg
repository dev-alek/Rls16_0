     6355   define variable v-cash-pay-curr as integer   no-undo .
     6356   define variable v-cash-pay-code as integer   no-undo .
     6357   do
     6358   on error undo, return error return-value
     6359   :
     6360   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6361   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6362   if p-fact-order = ? then do:
     6363     run fact-order-mpl (
     6364         input   today       ,
     6365         input   p-obj-type  ,
     6366         input   p-obj-code  ,
     6367         output  p-fact-order ).
     6368   end.
     6369   if p-vid-pay <> "" then do:
     6370      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6371      if available buf_pay-type
     6372         then v-trn-pay-code = buf_pay-type.obj-code.
     6373         else v-trn-pay-code =  0.
     6374   end.
     6375   else v-trn-pay-code = 0 .
     6376   if p-cash-pay-type <> "" then do:
     6377      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6378      if available buf_pay-type
     6379         then
     6380           assign
     6381             v-cash-pay-curr = buf_cash-pay.curr-code
     6382             v-cash-pay-code = buf_cash-pay.cdpay-code
     6383           .
     6384         else
     6385           assign
     6386             v-cash-pay-curr = 0
     6387             v-cash-pay-code = 0
     6388             .
     6389   end.
     6390   else
     6391     assign
     6392       v-cash-pay-curr = 0
     6393       v-cash-pay-code = 0
     6394       .
     6395   for each tt_price-all  : delete tt_price-all . end.
     6396   assign
     6397     p-plt-id             = ?
     6398     p-plt-db-num         = ?
     6399     p-pdf-id             = ?
     6400     p-pdf-db-num         = ?
     6401     p-sale-price-base    = ?
     6402     p-sale-price-rubl    = ?
     6403     v-cli-oborot         = 0
     6404   .
     6405   find first buf_global-state no-lock no-error .
     6406   if not available buf_global-state then do:
     6407      message
     6408        "Не заданы параметры ценообразования!"
     6409        view-as alert-box error
     6410      .
     6411      return error return-value .
     6412   end.
     6413   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
