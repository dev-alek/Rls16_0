     6418     )  .
     6419   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6420   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6421     (input  p-obj-type
     6422     ,input  p-obj-code
     6423     ,output v-host-code
     6424     )  .
     6425   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6427     (input  v-host-code
     6428     ,input  to-day
     6429     ,output v-base-rate0
     6430     ,output v-base-scale0
     6431     )  .
     6432     v-cli-oborot-ALL  = 0 .
     6433     for each buf_turnover-buyer-main no-lock  where
     6434              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6435              buf_turnover-buyer-main.cli-code = p-cli-code
     6436              :
     6437              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6438     end.
     6439   for each buf_price-all no-lock where
     6440            buf_price-all.obj-type = p-obj-type and
     6441            buf_price-all.obj-code = p-obj-code and
     6442            buf_price-all.gds-code = buf_goods.gds-code and
     6443            buf_price-all.status_  = 'акт':U  and
     6444          ( p-only-b-code = false   or
     6445          ( buf_price-all.b-code = p-main-b-code or
     6446            buf_price-all.b-code = p-b-code))    and
     6447           ( p-only-b-code = true  or
     6448             buf_price-all.b-code = p-b-code)
     6449             and
     6450             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6451           ( buf_price-all.fact-order-sys-to = ? or
     6452             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6453           :
     6454            v-interv   = "" .
     6455            v-grp-name = "" .
     6456            v-pay-name = "" .
     6457            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6458            if buf_price-all.bgr-id > 0 then do:
     6459               find first buf_buyer-group no-lock where
     6460                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6461                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6462               if available buf_buyer-group then do:
     6463                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6464                  find first buf_buyer-in-buyer-group no-lock where
     6465                             buf_buyer-in-buyer-group.stts         = 0 and
     6466                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6467                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6468                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6469                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6470                             no-error .
     6471                             if not available buf_buyer-in-buyer-group then do:
     6472                                v-grp-name = "".
     6473                                next.
     6474                             end.
     6475                             v-grp-name = buf_buyer-group.name .
     6476                  end.
     6477               end.
     6478               else do:
     6479                    v-grp-name = "".
     6480                    next.
     6481               end.
     6482            end.
     6483            if buf_price-all.tog-id > 0 then do:
     6484               find first buf_turnover-group no-lock where
     6485                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6486                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6487               if available buf_turnover-group then do:
     6488                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6489                     v-cli-oborot = v-cli-oborot-all  .
     6490                     find first buf1_tnv-in-turnover-group no-lock where
     6491                                buf1_tnv-in-turnover-group.stts       =  0     and
     6492                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6493                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6494                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6495                     find first buf2_tnv-in-turnover-group no-lock where
     6496                                buf2_tnv-in-turnover-group.stts       =  0     and
     6497                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6498                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6499                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6500                     if not (available buf1_tnv-in-turnover-group and
     6501                             available buf2_tnv-in-turnover-group ) then do:
     6502                             v-grp-name = "".
     6503                             next .
     6504                     end.
     6505                     v-grp-name = buf_turnover-group.name.
     6506                  end.
     6507               end.
     6508               else do:
     6509                    v-grp-name = "".
     6510                    next.
     6511               end.
     6512            end.
     6513            if buf_price-all.plt-fix-cource-crc-base = true then
     6514               assign
     6515                 v-base-rate  = buf_price-all.pdf-base-rate
     6516                 v-base-scale = buf_price-all.pdf-base-scale
     6517               .
     6518               else
     6519               assign
     6520                 v-base-rate  = v-base-rate0
     6521                 v-base-scale = v-base-scale0
     6522               .
     6523            if buf_price-all.plt-fix-cource-crc-doc = true then
     6524               assign
     6525                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6526                 v-exch-scale = buf_price-all.pdf-exch-scale
     6527               .
     6528               else do:
     6529   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6531     (input  buf_price-all.curr-code
     6532     ,input  to-day
     6533     ,output v-exch-rate0
     6534     ,output v-exch-scale0
     6535     ,output v-curr-abbr
     6536     )  .
     6537               assign
     6538                 v-exch-rate  = v-exch-rate0
     6539                 v-exch-scale = v-exch-scale0
     6540                 .
     6541              end.
     6542              v-date-1 = date ( "" )  .
     6543              if buf_price-all.fact-order-sys-from > 0 then do:
     6544                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6545                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6546                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6547              end.
     6548              v-date-2 =  date ( "" )  .
     6549              if buf_price-all.fact-order-sys-to > 0 then do:
     6550                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6551                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6552                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6553              end.
     6554              if buf_price-all.qnty-from <> ? then do :
     6555                 if not (
     6556                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6557                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6558                 ) then do:
     6559                        v-interv = "".
     6560                        next.
     6561                 end.
     6562                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6563              end.
     6564              if buf_price-all.sum-from <> ? then do :
     6565                 if not (
     6566                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6567                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6568                 ) then do:
     6569                    v-interv = "".
     6570                    next.
     6571                 end.
     6572                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6573              end.
     6574              if buf_price-all.turnover-from <> ? then do :
     6575                 if not (
     6576                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6577                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6578                 ) then do:
     6579                    v-interv = "".
     6580                    next.
     6581                 end.
     6582                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6583              end.
     6584              if buf_price-all.use-pay-type = 1 then do :
     6585                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6586                    v-pay-name = "" .
     6587                    next.
     6588                  end.
     6589                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6590              end.
     6591              if buf_price-all.use-cash-pay = 1 then do :
     6592                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6593                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6594                   v-pay-name = "" .
     6595                   next.
     6596                 end.
     6597                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6598              end.
     6599             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6600             create tt_price-all .
     6601             buffer-copy buf_price-all to tt_price-all
     6602             assign
     6603               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6604               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6605               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6606               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6607               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6608               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6609               tt_price-all.price-sale     = buf_price-all.price-sale
     6610               tt_price-all.road-tax       = buf_price-all.road-tax
     6611               tt_price-all.excise         = buf_price-all.excise
     6612               tt_price-all.pdf-exch-rate   = v-exch-rate
     6613               tt_price-all.pdf-exch-scale  = v-exch-scale
     6614               tt_price-all.pdf-base-rate   = v-base-rate
     6615               tt_price-all.pdf-base-scale  = v-base-scale
     6616               tt_price-all.grp-name        = v-grp-name
     6617               tt_price-all.date-1          = v-date-1
     6618               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6619               tt_price-all.time-1          = buf_price-all.start-sys-time
     6620               tt_price-all.date-2          = v-date-2
     6621               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6622               tt_price-all.time-2          = buf_price-all.end-sys-time
     6623               tt_price-all.interv-name     = v-interv
     6624               tt_price-all.pay-name        = v-pay-name
     6625               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6626             .
     6627   end.
     6628   define variable vt-plt-id as integer   no-undo .
     6629   define variable vt-plt-db as integer   no-undo .
     6630   define variable vt-pdf-id as integer   no-undo .
     6631   define variable vt-pdf-db as integer   no-undo .
     6632   define buffer neos_price-all for tt_price-all  .
     6633   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6634       if available tt_price-all then do:
     6635        assign
     6636          vt-plt-id = tt_price-all.plt-id
     6637          vt-plt-db = tt_price-all.plt-db-num
     6638          vt-pdf-id = tt_price-all.pdf-id
     6639          vt-pdf-db = tt_price-all.pdf-db
     6640        .
     6641        if tt_price-all.b-code = p-b-code then do:
     6642             assign
