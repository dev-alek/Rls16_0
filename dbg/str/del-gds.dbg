    14271                                       , input v-plu
    14272                                       , input (if v-marketer-action = "U"
    14273                                                 then  string(cash-gds.b-code, "999999999")
    14274                                                 else "000000000")
    14275                                             ).
    14276         run maria-put in this-procedure (
    14277                                         buffer for-cash-desk
    14278                                       , input out
    14279                                       , input fname
    14280                                       , input yes
    14281                                       , input 0
    14282                                       , input no
    14283                                       , input (if integer(v-plu) <= v-20-part1
    14284                                               then 20
    14285                                               else 21)
    14286                                       , input (if integer(v-plu) <= v-20-part1
    14287                                               then 2621
    14288                                               else 2379)
    14289                                       , input v-plu
    14290                                       , input (if v-marketer-action = 'U':U
    14291                                                 then string(convert-maria-tax-code(cash-gds.vat-code, 0  , cdtaxlst), "X(8)")
    14292                                                 else '00000000':U) + chr(4) + chk_name).
    14293         run maria-put in this-procedure (
