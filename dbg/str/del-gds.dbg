     8044                                             ,input 'маг':U
     8045                                             ,input i-obj-code
     8046                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8047                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8048                                             ,input ?
     8049                                             ,output v-disc-price-sale
     8050                                             ,output v-pdf-id
     8051                                             ,output v-pdf-db-num ) no-error.
     8052         if error-status:error
     8053         or v-disc-price-sale = 0
     8054         or v-disc-price-sale = ?
     8055         then do:
     8056         end.
     8057         else do:
     8058           find first  cash-gds-discnt where
     8059                     cash-gds-discnt.b-code = cash-gds.b-code
     8060                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8061                   and cash-gds-discnt.obj-type = parobj-type
     8062                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8063           if not available cash-gds-discnt then do:
     8064             find first  cash-gds-discnt where
     8065                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8066             if not available cash-gds-discnt then do:
     8067               create cash-gds-discnt.
     8068               assign
     8069               cash-gds-discnt.crf = crgd + 1.
     8070             end.
     8071             crgd = crgd + 1.
     8072             assign
     8073             cash-gds-discnt.b-code = cash-gds.b-code
     8074             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8075             cash-gds-discnt.obj-type = parobj-type
     8076             cash-gds-discnt.obj-code = parobj-code
     8077             cash-gds-discnt.discnt-value = v-disc-price-sale
     8078             .
     8079             release cash-gds-discnt.
     8080           end.
     8081         end.
     8082       end.
     8083     end.
     8084     if cash-gds.temp-discnt-rule <> 0
     8085     and how-temp-disc = 'temp-disc-pdf':U
     8086     then do:
     8087       for each cash-dis-rule no-lock where
     8088             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8089         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8090         and cash-dis-rule.is-term = yes
     8091       :
     8092         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8093                                             ,input 'маг':U
     8094                                             ,input i-obj-code
     8095                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8096                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8097                                             ,input ?
     8098                                             ,output v-disc-price-sale
     8099                                             ,output v-pdf-id
     8100                                             ,output v-pdf-db-num ) no-error.
     8101         if error-status:error
     8102         or v-disc-price-sale = 0
     8103         or v-disc-price-sale = ?
     8104         then do:
     8105         end.
     8106         else do:
     8107           find first  cash-gds-discnt where
     8108                     cash-gds-discnt.b-code = cash-gds.b-code
     8109                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8110                   and cash-gds-discnt.obj-type = parobj-type
     8111                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8112           if not available cash-gds-discnt then do:
     8113             find first  cash-gds-discnt where
     8114                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8115             if not available cash-gds-discnt then do:
     8116               create cash-gds-discnt.
     8117               assign
     8118               cash-gds-discnt.crf = crgd + 1.
     8119             end.
     8120             crgd = crgd + 1.
     8121             assign
     8122             cash-gds-discnt.b-code = cash-gds.b-code
     8123             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8124             cash-gds-discnt.obj-type = parobj-type
     8125             cash-gds-discnt.obj-code = parobj-code
     8126             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8127             release cash-gds-discnt.
     8128           end.
     8129         end.
     8130       end.
     8131     end.
     8132   end.
     8133   END PROCEDURE.
