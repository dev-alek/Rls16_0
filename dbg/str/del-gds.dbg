    10262                                 , gds-list.prod-type
    10263                                 , gds-list.prod-code
    10264                                 )
    10265                                   ).
    10266         assign
    10267         v-view-log = yes
    10268         .
    10269       end.
    10270       ACCUMULATE gds-list.artic (COUNT).
    10271       if ( (accum count gds-list.artic)  modulo cdpcknum)  = 0 then do:
    10272         run get-stop-state in p-log-handle (output v-stop).
    10273         if v-stop then do:
    10274           run write-log-and-file in p-log-handle (
    10275                 input 1
    10276               , input log-file-name
    10277               , input 1
    10278               , input substitute("!!!Процедура пересылки остановлена пользователем"
    10279                                   )
    10280                                     ).
    10281           leave _gds-list.
    10282         end.
    10283         else do:
    10284           assign
    10285           error-status:error = no.
    10286           if cr > 0 then
    10287           RUN SENDING no-error.
    10288           if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
    10289           assign
    10290           start-paket = yes
    10291           cr = 0
    10292           crgd = 0
    10293           start-paket-txr = yes
    10294           cr-txr = 0
    10295           cr-ncr-dis-kat = 0
    10296           .
    10297         end.
    10298       end.
    10299   END .
    10300   end.
    10301   assign
    10302   error-status:error = no.
    10303   if cr > 0 and not v-stop then
    10304   RUN SENDING no-error.
    10305   if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
    10306   FOR EACH cash-gds :
    10307       delete cash-gds.
    10308   END.
    10309   FOR EACH cash-txr :
    10310       delete cash-txr.
    10311   END.
    10312   run write-log-and-file in p-log-handle (
    10313         input 1
    10314       , input log-file-name
    10315       , input 1
    10316       , input substitute("Удалены товары c касс объекта &1&2", 'маг':U, i-obj-code)
    10317                                             ).
    10318   run finish-send in this-procedure no-error .
    10319   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10320   procedure ibm-gdsc :
    10321   define input  parameter p-zeros         as logical no-undo .
    10322   define output parameter IBM-good-code as character no-undo .
    10323   define output parameter IBM-good-code-2 as character no-undo .
    10324   define output parameter IBM2-short      as character no-undo .
    10325   define variable v-delim as character no-undo .
    10326   define variable v-format-str-16 as character no-undo .
    10327     do
    10328     on error undo, return error
    10329     :
    10330       if p-zeros then do:
    10331         assign
    10332         v-delim = '0'
    10333         v-format-str-16 =  "9999999999999999"
    10334         .
    10335       end.
    10336       else do:
    10337         assign
    10338         v-delim = chr(32)
    10339         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10340         .
    10341       end.
    10342       if cash-gds.b-str = "" then do:
    10343         assign
    10344         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10345         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10346         or cash-gds.unit-base <> cash-gds.unit-cli
    10347         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10348         then
    10349         do:
    10350           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10351               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10352             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10353             iBM2-short = bar_code.
    10354             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10355           END.
    10356           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10357               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10358             IBM-good-code-2 = b_code.
    10359           end.
    10360         end.
    10361       end.
    10362       else do:
    10363         IBm-good-code =
    10364         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10365           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10366            or
    10367            cash-gds.bc-on-type = 'pglc':U)
    10368         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10369         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10370       end.
    10371     end.
    10372   end procedure.
    10373   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10374   procedure ncr-gdsc :
    10375   define output parameter IBM-good-code as character no-undo .
    10376   define output parameter IBM-good-code-2 as character no-undo .
