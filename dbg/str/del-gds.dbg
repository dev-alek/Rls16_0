     7265   def var vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7266   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7267   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7268   procedure create-dis-rule :
     7269   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7270   define input parameter p-tree as logical no-undo .
     7271   define buffer buf_dis-rule for ub.dis-rule.
     7272   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7273   define buffer term_dis-rule for ub.dis-rule.
     7274   define buffer term_dis-time-rule for ub.dis-time-rule.
     7275   define buffer root_cash-dis-rule for cash-dis-rule.
     7276   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7277   define buffer term_cash-dis-rule for cash-dis-rule.
     7278   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7279     do
     7280     on error undo, return error
     7281     :
     7282       find first root_cash-dis-rule no-lock where                                                         ~
     7283                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7284       if not available root_cash-dis-rule then do:
     7285         find first buf_dis-rule no-lock where
     7286                   buf_dis-rule.rule-num = p-rule-num no-error.
     7287         if available buf_dis-rule then do:
     7288           if buf_dis-rule.time-rule-num <> 0 then do:
     7289             find first buf_dis-time-rule no-lock where
     7290                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7291           end.
     7292           create root_cash-dis-rule.
     7293           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7294           if available buf_dis-time-rule then do:
     7295             find first root_cash-dis-time-rule no-lock where
     7296                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7297             if not available root_cash-dis-time-rule then do:
     7298               create root_cash-dis-time-rule.
     7299               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7300             end.
     7301           end.
     7302           else do:
     7303             assign
     7304             root_cash-dis-rule.time-rule-num = 0.
     7305           end.
     7306           if buf_dis-rule.uniq-field <> "":U then do:
     7307             for each term_dis-rule no-lock where
     7308                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7309               if term_dis-rule.time-rule-num <> 0 then do:
     7310                 find first term_dis-time-rule no-lock where
     7311                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7312               end.
     7313               create term_cash-dis-rule.
     7314               buffer-copy term_dis-rule to term_cash-dis-rule.
     7315               if term_dis-rule.time-rule-num = 0
     7316               or available term_dis-time-rule
     7317               or root_cash-dis-rule.time-rule-num = 0
     7318               then do:
     7319                 if available term_dis-time-rule then do:
     7320                   find first term_cash-dis-time-rule no-lock where
     7321                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7322                   if not available term_cash-dis-time-rule then do:
     7323                     create term_cash-dis-time-rule.
     7324                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7325                   end.
     7326                 end.
     7327               end.
     7328             end.
     7329           end.
     7330         end.
     7331       end.
     7332     end.
     7333   end procedure.
     7334   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7335   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7336   function ncr-amnt-disc returns character (
     7337     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7338   define variable v-result as character no-undo .
     7339   define variable ii as integer no-undo .
     7340   define variable v-entry as character no-undo extent 3.
     7341   for each cash-dis-rule  no-lock where
     7342         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7343     assign
     7344     ii = ii + 1
     7345     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7346                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7347     .
     7348   end.
     7349   if v-entry[2] = "":U then
     7350   assign
     7351   v-entry[2] = v-entry[1]
     7352   .
     7353   if v-entry[3] = "":U then
     7354   assign
     7355   v-entry[3] = v-entry[2]
     7356   .
     7357   assign
     7358   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7359   .
     7360   return v-result.
     7361   END FUNCTION.
     7362   function ncr-date-disc returns character (
     7363     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7364   define variable v-result as character no-undo .
     7365   define variable ii as integer no-undo .
     7366   define variable v-entry as character no-undo extent 3.
     7367   for each cash-dis-rule  no-lock where
     7368         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7369       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7370     assign
     7371     ii = ii + 1
     7372     v-entry[ii] =
     7373                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7374                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7375                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7376                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7377                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7378                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7379                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7380   end.
     7381   if v-entry[2] = "":U then
     7382   assign
     7383   v-entry[2] = v-entry[1]
     7384   .
     7385   if v-entry[3] = "":U then
     7386   assign
     7387   v-entry[3] = v-entry[2]
     7388   .
     7389   assign
     7390   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7391   .
     7392   return v-result.
     7393   END FUNCTION.
     7394   function ncr-temp-disc returns character (
     7395     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7396   define variable v-result as character no-undo .
     7397   define variable ii as integer no-undo .
     7398   define variable v-entry as character no-undo extent 3.
     7399   define variable v-dec as decimal no-undo .
     7400   define variable v-disc-price-sale as decimal no-undo .
     7401   define variable v-pdf-id as integer no-undo .
     7402   define variable v-pdf-db-num as integer no-undo .
     7403   define buffer buf_cash-dis-rule for cash-dis-rule.
     7404   find first buf_cash-dis-rule where
     7405            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7406   if not available buf_cash-dis-rule then return "":U.
     7407   if buf_cash-dis-rule.templ-rl-root <> 29
     7408   and buf_cash-dis-rule.templ-rl-root <> 86
     7409   then do:
     7410     assign
     7411     v-entry[1] =
     7412     "000"                                                   +
     7413     "0"                                                     +
     7414     "0000"                                                  +
     7415     "2359"                                                     +
     7416      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7417      .
     7418   end.
     7419   else do:
     7420     for each cash-dis-rule  no-lock where
     7421           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7422         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7423       case cash-dis-rule.value-type:
     7424         when integer('1':U) then do:
     7425           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7426         end.
     7427         when integer('12':U) then do:
     7428           find first cash-gds-discnt where
     7429                     cash-gds-discnt.b-code = cash-gds.b-code
     7430                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7431                 and cash-gds-discnt.obj-type = 'маг':U
     7432                 and cash-gds-discnt.obj-code = i-obj-code
     7433                 no-error.
     7434           if not available cash-gds-discnt then do:
     7435             v-dec = cash-gds.price-sale.
     7436           end.
     7437           else do:
     7438             assign
     7439             v-dec = cash-gds-discnt.discnt-value
     7440             .
     7441           end.
     7442         end.
     7443         otherwise do:
     7444           v-dec = cash-gds.price-sale.
     7445         end.
     7446       end case.
     7447       assign
     7448       ii = ii + 1
     7449       v-entry[ii] =
     7450                     "000"                                                   +
     7451                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7452                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7453                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7454                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7455                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7456                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7457                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7458                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7459                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7460                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7461                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7462       .
     7463   if ii = 3 then leave.
     7464     end.
     7465   end.
     7466   if v-entry[2] = "":U then
     7467   assign
     7468   v-entry[2] = v-entry[1]
     7469   .
     7470   if v-entry[3] = "":U then
     7471   assign
     7472   v-entry[3] = v-entry[2]
     7473   .
     7474   assign
     7475   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7476   .
     7477   return v-result.
     7478   END FUNCTION.
     7479   function ncr-d-rank returns character (
     7480     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7481   define variable v-result as character no-undo .
     7482   define variable ii as integer no-undo .
     7483   do ii = 1 to length(p-d-rank):
     7484     CASE substr(p-d-rank, ii, 1):
     7485       when "X":U then do:
     7486         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7487       end.
     7488       when "T":U then do:
     7489         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7490       end.
     7491       when "D":U then do:
     7492         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7493       end.
     7494     END CASE.
     7495     if v-result <> "":U then LEAVE.
     7496   end.
     7497   if v-result = "":U then v-result = chr(32).
     7498   return v-result.
     7499   END FUNCTION.
     7500   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7501       define variable v-upper-code as int no-undo.
     7502       define variable v-value as character no-undo.
     7503       define variable v-type as character no-undo.
     7504       define buffer lc_gds-grp for ub.gds-grp.
     7505       define buffer lc_goods for ub.goods.
     7506      if p-gds-code <> 0 then do:
     7507       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7508       v-upper-code = lc_goods.grp-code.
     7509       do while v-upper-code > 0 :
     7510           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7511           run ggoattr-value(
     7512             input lc_gds-grp.node-code,
     7513             input 0,
     7514             input "",
     7515             input 0,
     7516             input 'ban-sales-via-cd':U,
     7517             output v-value,
     7518             output v-type
     7519           ).
     7520          if v-value = "yes" then
     7521             return true.
     7522          else
     7523          do:
     7524             run ggoattr-value(
     7525                input lc_gds-grp.node-code,
     7526                input shop.host-code,
     7527                input "",
     7528                input 0,
     7529                input 'ban-sales-via-cd':U,
     7530                output v-value,
     7531                output v-type
     7532                ).
     7533             if v-value = "yes" then
     7534                return true.
     7535             else
     7536             do:
     7537                run ggoattr-value(
     7538                   input lc_gds-grp.node-code,
     7539                   input shop.host-code,
     7540                   input 'маг':U,
     7541                   input i-obj-code,
     7542                   input 'ban-sales-via-cd':U,
     7543                   output v-value,
     7544                   output v-type
     7545                   ).
     7546                if v-value = "yes" then
     7547                   return true.
     7548                else v-upper-code = lc_gds-grp.upper-code.
     7549             end .
     7550          end.
     7551         end.
     7552       end.
     7553   end.
     7554   FUNCTION convert-tax-code returns integer
     7555                                             ( input p-rate-code as integer
     7556                                              ,input p-cdtaxlst  as character
     7557                                             ) :
     7558   define variable jj as integer no-undo .
     7559     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7560       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7561         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7562       end.
     7563     end.
     7564   END FUNCTION.
     7565   FUNCTION convert-maria-tax-code returns character
     7566                                             ( input p-vat-rate-code as integer
     7567                                              ,input p-slt-rate-code as integer
     7568                                              ,input p-cdtaxlst  as character
     7569                                             ) :
     7570   define variable jj as integer no-undo .
     7571   define variable aa as character no-undo extent 8.
     7572   define variable v-return-value as character no-undo .
     7573     do jj = 1 to 8:
     7574       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7575         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7576           aa[jj] = '1'.
     7577         end.
     7578         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7579           aa[jj] = '1'.
     7580         end.
     7581       end.
     7582       if aa[jj] = '':U then aa[jj] = '0'.
     7583       v-return-value = aa[jj] + v-return-value.
     7584     end.
     7585   return v-return-value.
     7586   END FUNCTION.
     7587   FUNCTION convert-maria-tax-code-2 returns integer
     7588                                             ( input p-rate-code as integer
     7589                                              ,input p-cdtaxlst  as character
     7590                                             ) :
     7591   define variable jj as integer no-undo .
     7592   define variable v-return-value as integer no-undo .
     7593     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7594       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7595         return jj.
     7596       end.
     7597     end.
     7598   return 0.
     7599   END FUNCTION.
