    12802         v-cd-list-update = for-cash-desk.addr-path
    12803         v-cd-list-delete = for-cash-desk.addr-path
    12804         .
    12805         NEXT.
    12806       end.
    12807       else do:
    12808         if v-cd-list-update = '':U then nExt.
    12809       end.
