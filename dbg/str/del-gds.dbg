    12458                     put unformatted
    12459                     (fill(" " , 16 -  length(bar_code)) + bar_code)
    12460                     '00101'
    12461                     caps(string(chk_name,'x(20)'))
    12462                     string(( cash-gds.price-sale * 100 ) ,'999999999999') .
    12463                     put unformatted
    12464                     '000000000000000000000000000'
    12465                     string(action, "X(1)")
    12466                     fill('0':U , 12)
    12467                     string(v-r-b-curr-magia, "9")
    12468                     fill('0':U , 104)
    12469                     .
    12470                     put skip.
    12471                 end.
    12472             end.
    12473             else do:
    12474               put unformatted
    12475               ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12476               '00101'
    12477               caps( string( chk_name, 'x(20)' ) )
    12478               string( ( cash-gds.price-sale * 100 ) ,'999999999999')
    12479               .
    12480               put unformatted
    12481               '000000000000000000000000000'
    12482               string(action, "X(1)")
    12483               fill('0':U , 12)
    12484               string(v-r-b-curr-magia, "9")
    12485               fill('0':U , 104)
    12486               .
    12487               put skip.
    12488             end.
    12489           end.
    12490           else do:
    12491             if cash-gds.b-str = "" then do:
    12492                 assign
    12493                 b_code = string(cash-gds.b-code,'>>>>>>>>>>>>>>>9').
    12494                 run gen-bc(input cash-gds.b-code, output bar_code) no-error.
    12495                 if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12496                     (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12497                     put unformatted b_code '00101' caps(string(chk_name,'x(20)'))
    12498                                           string( ( cash-gds.price-sale * 100 ) ,'99999999').
    12499                     put unformatted '0000000000000000000000000000000'
    12500                     string(action, "X(1)") '0000000000000'.
    12501                     put skip.
    12502                 end.
    12503                 if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12504                     (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12505                     put unformatted (fill(" " , 16 -  length(bar_code)) + bar_code) '00101'
    12506                                                   caps(string(chk_name,'x(20)'))
    12507                                                   string(( cash-gds.price-sale * 100 ) ,'99999999') .
    12508                     put unformatted '0000000000000000000000000000000'
    12509                     string(action, "X(1)") '0000000000000'.
