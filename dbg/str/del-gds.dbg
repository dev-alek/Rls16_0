    10875               .
    10876             end.
    10877             else do:
    10878              assign
    10879               temp-disc-dec = 0.
    10880             end.
    10881           end.
    10882           otherwise do:
    10883             temp-disc-dec = 0.
    10884           end.
    10885         end case.
    10886       end.
    10887     end.
    10888   end.
