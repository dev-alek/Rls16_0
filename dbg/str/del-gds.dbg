     7010   procedure grp-obj-notcorr-value :
     7011   do
     7012   on error undo, return error
     7013   :
     7014   define input parameter p-node-code             as integer      no-undo.
     7015   define input parameter p-obj-type              as character    no-undo.
     7016   define input parameter p-obj-code              as integer      no-undo.
     7017   define output parameter p-notcorr              as character    no-undo init ?.
     7018   define output parameter p-range-notcorr     as integer      no-undo.
     7019   define output parameter p-exists-notcorr    as logical      no-undo.
     7020   define variable v-host-code as integer      no-undo.
     7021   DEFINE VARIABLE v-found as logical no-undo .
     7022   DEFINE VARIABLE v-exists as logical no-undo .
     7023   DEFINE VARIABLE v-range as integer no-undo .
     7024   DEFINE VARIABLE jj as integer no-undo .
     7025   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7026   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7027   define buffer buf_gds-grp for ub.gds-grp.
     7028   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7029   find first buf_gds-grp no-lock where
     7030              buf_gds-grp.node-code = p-node-code no-error .
     7031   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7032     message
     7033       vss-workfile vss-revision vss-description
     7034       skip "Не удалось найти группу товаров с кодом" p-node-code
     7035       view-as alert-box error .
     7036     undo, return error .
     7037   end.
     7038   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7040     (input  p-obj-type
     7041     ,input  p-obj-code
     7042     ,output v-host-code
     7043     ) no-error .
     7044   if error-status :error
     7045   then do:
     7046       message
     7047         vss-workfile vss-revision vss-description
     7048         skip "Не удалось найти фирму объекта"
     7049         skip p-obj-type p-obj-code
     7050         skip return-value
     7051         skip trim(error-status :get-message(1))
     7052       view-as alert-box error.
     7053       undo, return error .
     7054   end.
     7055   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7056   do while v-found = no and jj < 2:
     7057     if v-range <> 3 then do:
     7058       find first buf_gds-grp-obj no-lock
     7059           where buf_gds-grp-obj.node-code = p-node-code
     7060             and buf_gds-grp-obj.host-code = v-host-code
     7061             and buf_gds-grp-obj.obj-type  = p-obj-type
     7062             and buf_gds-grp-obj.obj-code  = p-obj-code
     7063       no-error .
     7064     end.
     7065     if v-range = 3 or not available buf_gds-grp-obj
     7066     then do:
     7067        if v-range <> 2 then do:
     7068           find first buf_gds-grp-obj no-lock
     7069               where buf_gds-grp-obj.node-code = p-node-code
     7070                 and buf_gds-grp-obj.host-code = v-host-code
     7071                 and buf_gds-grp-obj.obj-type  = ""
     7072                 and buf_gds-grp-obj.obj-code  = 0
     7073           no-error .
     7074         end.
     7075         if v-range = 2 or not available buf_gds-grp-obj
     7076         then do:
     7077             if v-range <> 1 then do:
     7078               find first buf_gds-grp-obj no-lock
     7079                   where buf_gds-grp-obj.node-code = p-node-code
     7080                   and buf_gds-grp-obj.host-code = 0
     7081                   and buf_gds-grp-obj.obj-type  = ""
     7082                   and buf_gds-grp-obj.obj-code  = 0
     7083               no-error .
     7084             end.
     7085             if v-range = 1 or not available buf_gds-grp-obj
     7086             then do:
     7087                 assign
     7088                     v-exists = no
     7089                 .
     7090             end.
     7091             else do:
     7092                 assign
     7093                     v-exists = yes
     7094                     v-range = 1
     7095                 .
     7096             end.
     7097         end.
     7098         else do:
     7099             assign
     7100                 v-exists = yes
     7101                 v-range  = 2
     7102             .
     7103         end.
     7104     end.
     7105     else do:
     7106         assign
     7107             v-exists = yes
     7108             v-range  = 3
     7109         .
     7110     end.
     7111     if available buf_gds-grp-obj
     7112     then do:
     7113       find first buf_gds-grp-obj-attr no-lock
     7114         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7115           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7116           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7117           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7118           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7119         no-error .
     7120       if available buf_gds-grp-obj-attr then do:
     7121         assign
     7122           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7123         .
     7124       end.
     7125       else do:
     7126         assign
     7127           v-notcorr-value = ?
     7128         .
     7129       end.
     7130       assign
     7131       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7132                           then yes
     7133                           else p-exists-notcorr)
     7134       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7135                         then v-range
     7136                         else p-range-notcorr
     7137       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7138                         then v-notcorr-value
     7139                         else p-notcorr
     7140       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7141       jj = jj + 1
     7142       .
     7143     end.
     7144     else do:
     7145       assign
     7146       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7147       jj = jj + 1
     7148       .
     7149     end.
     7150   end.
     7151   end.
     7152   end procedure.
