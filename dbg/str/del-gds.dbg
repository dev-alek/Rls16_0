    10659   procedure finish-send :
    10660     do
    10661     on error undo, return error
    10662     :
    10663   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10664   if v-view-log
    10665   and not g#news
    10666   and not g#auto
    10667   then do:
    10668     message
    10669     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10670     "!!!Внимательно прочитайте Log-file!!"
    10671     view-as alert-box error .
    10672        define variable v-user-action90   as character no-undo .
    10673     define variable v-printed90       as logical   no-undo .
    10674     run gbl/prnfilen.w
    10675       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10676       ,input  0
    10677       ,input  (string("./":U) + log-file-name)
    10678       ,input  7
    10679       ,output v-user-action90
    10680       ,output v-printed90
    10681       ) .
    10682   end.
    10683   if v-view-log = true
    10684   and (g#news
    10685   or g#auto)
    10686   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10687   then do:
    10688      run cb_set-view-log in p-parent-handle ( input yes).
    10689   end.
    10690       define variable v-save-file-name as character no-undo .
    10691       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10692       OS-APPEND value(log-file-name) value(v-save-file-name).
    10693       OS-DELETE value(log-file-name).
    10694     end.
    10695   end procedure.
    10696   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
