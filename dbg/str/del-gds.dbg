     6661                     neos_price-all.pdf-db     = vt-pdf-db
     6662                     use-index pi no-error .
     6663            if available neos_price-all then do:
     6664             assign
     6665               p-plt-id           = tt_price-all.plt-id
     6666               p-plt-db-num       = tt_price-all.plt-db-num
     6667               p-pdf-id           = tt_price-all.pdf-id
     6668               p-pdf-db-num       = tt_price-all.pdf-db
     6669               p-sale-price-base  = neos_price-all.price-sale-base
     6670               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6671               p-road-tax-base    = neos_price-all.road-tax-base
     6672               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6673               p-excise-base      = neos_price-all.excise-base
     6674               p-excise-rubl      = neos_price-all.excise-rubl
     6675               .
     6676            end.
     6677            else do:
     6678                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6679                 if error-status :error    then do:
     6680                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6681                   return error return-value .
     6682                 end.
     6683             assign
     6684               p-plt-id           = tt_price-all.plt-id
     6685               p-plt-db-num       = tt_price-all.plt-db-num
     6686               p-pdf-id           = tt_price-all.pdf-id
     6687               p-pdf-db-num       = tt_price-all.pdf-db
     6688               p-sale-price-base  = tt_price-all.price-sale-base
     6689               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6690               p-road-tax-base    = tt_price-all.road-tax-base
     6691               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6692               p-excise-base      = tt_price-all.excise-base
     6693               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6694               .
     6695            end.
     6696        end.
     6697     end.
     6698   end.
     6699   end procedure.
     6700   procedure mpl-tpl-auto :
     6701   define input  parameter p-b-code     as integer   no-undo .
     6702   define input  parameter p-obj-type   as character no-undo .
     6703   define input  parameter p-obj-code   as integer   no-undo .
     6704   define input  parameter p-plt-id     as integer   no-undo .
     6705   define input  parameter p-plt-db-num as integer   no-undo .
     6706   define input  parameter p-fact-order as decimal   no-undo .
     6707   define output parameter p-sale-price as decimal   no-undo .
     6708   define output parameter p-pdf-id     as integer   no-undo .
     6709   define output parameter p-pdf-db-num as integer   no-undo .
     6710     do
     6711     on error undo, return error return-value
     6712     :
     6713   if p-fact-order = ? then do:
     6714     run fact-order-mpl (
     6715         input   today       ,
     6716         input   p-obj-type  ,
     6717         input   p-obj-code  ,
     6718         output  p-fact-order ) .
     6719   end.
     6720   assign
     6721     p-pdf-id      = ?
     6722     p-pdf-db-num  = ?
     6723     p-sale-price  = ?
     6724   .
     6725   define buffer buf_bar-code for ub.bar-code  .
     6726   define buffer buf_goods for ub.goods  .
     6727   find first buf_bar-code no-lock where
     6728              buf_bar-code.b-code = p-b-code
     6729              no-error .
     6730   if error-status :error then return error return-value .
     6731   find first buf_goods no-lock where
     6732              buf_goods.gds-code = buf_bar-code.gds-code
     6733              no-error .
     6734   if error-status :error then return error return-value .
     6735   define variable v-main-b-code as integer   no-undo .
     6736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6737     (input  buf_goods.gds-code
     6738     ,input  ?
     6739     ,output v-main-b-code
     6740     )  .
     6741   define buffer buf_price-all for ub.price-all  .
     6742   for each tt_price-all : delete tt_price-all. end.
     6743       for each buf_price-all no-lock where
     6744               buf_price-all.plt-id     = p-plt-id                 and
     6745               buf_price-all.plt-db-num = p-plt-db-num             and
     6746               buf_price-all.obj-type   = p-obj-type               and
     6747               buf_price-all.obj-code   = p-obj-code               and
     6748               buf_price-all.gds-code   = buf_goods.gds-code       and
     6749             ( buf_price-all.b-code = v-main-b-code or
     6750               buf_price-all.b-code = p-b-code)    and
     6751               buf_price-all.status_    = 'акт':U         and
     6752               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6753             ( buf_price-all.fact-order-sys-to = ? or
     6754               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6755               :
     6756                 create tt_price-all .
     6757                 buffer-copy buf_price-all to tt_price-all
     6758                 assign
     6759                   tt_price-all.price-sale  = buf_price-all.price-sale
     6760                 .
     6761       end.
     6762   define variable vt-plt-id as integer   no-undo .
     6763   define variable vt-plt-db as integer   no-undo .
     6764   define variable vt-pdf-id as integer   no-undo .
     6765   define variable vt-pdf-db as integer   no-undo .
     6766   define buffer neos_price-all for tt_price-all  .
     6767   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6768       if available tt_price-all then do:
     6769        assign
     6770          vt-plt-id = tt_price-all.plt-id
     6771          vt-plt-db = tt_price-all.plt-db-num
     6772          vt-pdf-id = tt_price-all.pdf-id
     6773          vt-pdf-db = tt_price-all.pdf-db
     6774        .
     6775        if tt_price-all.b-code = p-b-code then do:
     6776             assign
     6777               p-plt-id           = tt_price-all.plt-id
     6778               p-plt-db-num       = tt_price-all.plt-db-num
     6779               p-pdf-id           = tt_price-all.pdf-id
     6780               p-pdf-db-num       = tt_price-all.pdf-db
     6781               p-sale-price       = tt_price-all.price-sale
     6782               .
     6783        end.
     6784        else do:
     6785          find first neos_price-all where
     6786                     neos_price-all.b-code     = p-b-code  and
     6787                     neos_price-all.plt-id     = vt-plt-id and
     6788                     neos_price-all.plt-db-num = vt-plt-db and
     6789                     neos_price-all.pdf-id     = vt-pdf-id and
     6790                     neos_price-all.pdf-db     = vt-pdf-db
     6791                     use-index pi no-error .
     6792            if available neos_price-all then do:
     6793             assign
     6794               p-plt-id           = tt_price-all.plt-id
     6795               p-plt-db-num       = tt_price-all.plt-db-num
     6796               p-pdf-id           = tt_price-all.pdf-id
     6797               p-pdf-db-num       = tt_price-all.pdf-db
     6798               p-sale-price       = neos_price-all.price-sale
     6799               .
     6800            end.
     6801            else do:
     6802           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6803           if error-status :error    then do:
     6804              message "Не найден бар-код" p-b-code view-as alert-box error .
     6805              return error return-value .
     6806           end.
     6807             assign
     6808               p-plt-id           = tt_price-all.plt-id
     6809               p-plt-db-num       = tt_price-all.plt-db-num
     6810               p-pdf-id           = tt_price-all.pdf-id
     6811               p-pdf-db-num       = tt_price-all.pdf-db
     6812               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6813               .
     6814            end.
     6815        end.
     6816     end.
     6817     end.
     6818   end procedure.
