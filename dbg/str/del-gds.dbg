    13614             ss skip.
    13615             NEXT _rr2.
    13616           end.
    13617           if not v-updated-subject-dis-kat then do:
    13618             find first buf_cash-ncr-dis-kat no-lock where
    13619                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    13620                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
    13621             if not available buf_cash-ncr-dis-kat then do:
