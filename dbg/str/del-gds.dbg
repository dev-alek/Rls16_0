     6334   define buffer buf_bar-code               for ub.bar-code  .
     6335   define buffer buf_pay-type               for ub.pay-type  .
     6336   define buffer buf_cash-pay               for ub.cash-pay  .
     6337   define variable to-day          as date      no-undo .
