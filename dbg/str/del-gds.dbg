     6320   define output parameter p-road-tax-rubl as decimal   no-undo .
     6321   define output parameter p-excise-base   as decimal   no-undo .
     6322   define output parameter p-excise-rubl   as decimal   no-undo .
     6323   define variable v-cli-oborot-ALL as decimal   no-undo .
     6324   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6325   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
