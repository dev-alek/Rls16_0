     8036   if action = "U" then do:
     8037     if cash-gds.kat-discnt-rule <> 0
     8038     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8039     then do:
     8040       for each cash-dis-rule no-lock where
     8041             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8042       :
