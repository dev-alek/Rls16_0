    10459           return error.
    10460       END.
    10461     END CASE.
    10462     if varcont87 = yes then do:
    10463       if integer( substring( tmp-str87, 1, length( ncrsc-pfx ) ) ) <> 0
    10464       then do:
    10465         message
    10466           "Невозможно сформировать бар-код" SKIP
    10467           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10468           view-as alert-box error title "подрезание кода".
    10469         return error.
