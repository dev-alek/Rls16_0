    14137                                           , input fname
    14138                                           , input yes
    14139                                           , input 0
    14140                                           , input no
    14141                                           , input 13
    14142                                           , input 1
    14143                                           , input v-plu-pet122
    14144                                           , input (if v-marketer-action = 'u':U
    14145                                                   then string(cash-gds.price-sale * 100, "999999999")
    14146                                                   else '000000000')
    14147             ).
    14148       v-maria-discnt-value = string(0, '999').
    14149         if action <> 'D':U
    14150         and v-marketer-action <> 'D'
    14151         then do:
    14152         _do:
    14153         do v-ii = 1 to num-entries(drgdsrank):
    14154           assign
    14155           v-gds-rule-num = buffer cash-gds:buffer-field(entry(2, entry(v-ii, drgdsrank), chr(47))):buffer-value.
    14156           if v-gds-rule-num = 0 then next _do.
    14157           find first buf_dis-rule no-lock where
    14158             buf_dis-rule.obj-type = 'маг':U
    14159                 AND buf_dis-rule.obj-code = i-obj-code
    14160                 AND buf_dis-rule.rule-num = v-gds-rule-num
    14161                 AND buf_dis-rule.sts = integer('0':U) no-error .
    14162           if not available buf_dis-rule then do:
    14163             next _do.
    14164           end.
    14165           else do:
    14166             if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
    14167               assign
    14168               v-dop = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
    14169               v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
    14170               v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
    14171               v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
    14172               .
    14173             end.
    14174           end.
    14175           LEAVE _do.
    14176         end.
    14177       end.
    14178       assign
    14179       entry(integer(v-plu), v-record, chr(4)) = v-maria-discnt-value
    14180       no-error
    14181       .
    14182       end.
    14183     end.
    14184     else do:
    14185       if v-marketer-action = 'D' then do:
