     4774   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4775   PROCEDURE cd-mrkt_plu-marketer :
     4776   define input parameter p-silence as logical no-undo .
     4777   define parameter buffer buf_cash-desk for ub.cash-desk.
     4778   define input parameter p-id as character no-undo .
     4779   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4780   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4781   define input parameter p-loc-ean as logical no-undo .
     4782   define input parameter p-is-petrolium as logical no-undo .
     4783   define input parameter p-extra as character no-undo .
     4784   define variable v-tot-gds as integer no-undo .
     4785   define variable v-max-gds as integer no-undo .
     4786   define variable v-petrol-start as integer no-undo .
     4787   define variable v-petrol-range as integer no-undo .
     4788   DEFINE VARIABLE v-today as date no-undo .
     4789   DEFINE VARIABLE v-time as integer no-undo .
     4790   define variable v-plu-type as character no-undo .
     4791   define variable v-int as integer no-undo .
     4792   define buffer  buf_cd-plu for ub.cd-plu.
     4793   define buffer  loc_cd-plu for ub.cd-plu.
     4794   define variable  ii as integer no-undo.
     4795   define variable v-mes as character no-undo .
     4796   _main:
     4797   DO ON ERROR undo, leave on stop undo, leave:
     4798     if buf_cash-desk.pos-type <> 'MARIA':U
     4799     or buf_cash-desk.cash-num <> 0 then do:
     4800       assign
     4801       v-mes =
     4802       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4803                 , buf_cash-desk.pos-type).
     4804       if not p-silence then
     4805       message
     4806       v-mes
     4807       view-as alert-box error .
     4808       return error v-mes.
     4809     end.
     4810     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4811                                     ,input 'MARIA_operative':U
     4812                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4813                                           and p-is-petrolium
     4814                                           then 'tot-petrol':U
     4815                                           else 'tot-gds':U)
     4816                                     , output v-mes).
     4817     if v-tot-gds = ? then undo _main, return error v-mes.
     4818     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4819                                     ,input 'MARIA_general':U
     4820                                     ,input 'max-gds':U
     4821                                     ,output v-mes).
     4822     if v-max-gds = ? then undo _main, return error v-mes.
     4823     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4824                                          ,input 'petrolium-range':U
     4825                                          ,input 'petrolium-range':U
     4826                                          ,output v-mes).
     4827     if v-petrol-range = ? then undo _main, return error v-mes.
     4828     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4829       assign
     4830       v-petrol-start = 1
     4831       v-max-gds = (if p-is-petrolium
     4832                    then v-petrol-range
     4833                    else v-max-gds)
     4834       v-plu-type = (if p-is-petrolium
     4835                  then 'топ':U
     4836                  else '':U)
     4837       .
     4838       if p-is-petrolium then do:
     4839         if p-id = '':U then do:
     4840           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4841                               "Невозможно привязать к кассе типа &3"
     4842                               , p-b-str
     4843                               , chr(10)
     4844                               , 'MARIA':U).
     4845           if not p-silence then
     4846           message
     4847           v-mes
     4848           view-as alert-box error .
     4849           return error v-mes.
     4850         end.
     4851         assign
     4852         v-int = integer(p-id)
     4853         no-error
     4854         .
     4855         if error-status:error
     4856         or v-int > v-petrol-range then do:
     4857           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4858                               "в диапазоны номеров резервуаров для кассы типа &4"
     4859                               , p-id
     4860                               , p-b-str
     4861                               , chr(10)
     4862                               , 'MARIA':U).
     4863           if not p-silence then
     4864           message
     4865           v-mes
     4866           view-as alert-box error .
     4867           return error v-mes.
     4868         end.
     4869       end.
     4870     end.
     4871     if buf_cash-desk.pos-type = 'MARIA':U
     4872     and p-is-petrolium then do:
     4873       find first loc_cd-plu where
     4874                loc_cd-plu.obj-type = 'маг':U
     4875            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4876            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4877            and loc_cd-plu.plu-type = 'топ':U
     4878      no-error .
     4879      if available loc_cd-plu then do:
     4880        if loc_cd-plu.b-code = p-b-code
     4881        and loc_cd-plu.b-str = p-b-str then do:
     4882           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4883                               , p-id
     4884                               , p-b-str
     4885                               , chr(10)
     4886                               ).
     4887           if not p-silence then
     4888           message
     4889           v-mes
     4890           view-as alert-box WARNING .
     4891           return v-mes.
     4892        end.
     4893        else do:
     4894           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4895                               "нельзя его привязать к топливу &2&3"
     4896                               , p-id
     4897                               , loc_cd-plu.b-str
     4898                               , chr(10)
     4899                               , p-b-str).
     4900           if not p-silence then
     4901           message
     4902           v-mes
     4903           view-as alert-box error .
     4904           return error v-mes.
     4905        end.
     4906      end.
     4907      ii = v-int.
     4908     end.
     4909     else do:
     4910       DO ii = (if p-is-petrolium
     4911               then v-petrol-start
     4912               else (if buf_cash-desk.pos-type = 'MARIA':U
     4913                    then 1
     4914                    else (if v-petrol-start = 1
     4915                           then (v-petrol-range + 1)
     4916                           else 1)
     4917                   )
     4918               )
     4919         to v-max-gds :
     4920         if not can-find (loc_cd-plu where
     4921                         loc_cd-plu.obj-type = 'маг':U
     4922                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4923                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4924                      and loc_cd-plu.plu-type = v-plu-type
     4925                      and loc_cd-plu.plu-code = ii
     4926                       )
     4927         then LEAVE .
     4928       END .
     4929     end.
     4930     if ii > v-max-gds then do:
     4931         if not p-silence then
     4932         message
     4933         substitute("Превышено максимально допустимое количество &5 &1" +
     4934                   "для касс &2 &3&4"
     4935                   , chr(10)
     4936                   , v-max-gds
     4937                   , 'маг':U
     4938                   , buf_cash-desk.obj-code
     4939                   , (if p-is-petrolium then "топлив" else "товаров")
     4940                   )
     4941         view-as alert-box ERROR .
     4942         undo, return error "max-gds":U.
     4943     end.
     4944     DO ii = (if p-is-petrolium
     4945              then v-petrol-start
     4946              else (if v-petrol-start = 1
     4947                    then (v-petrol-range + 1)
     4948                    else 1)
     4949              )
     4950        to v-max-gds :
     4951       if not can-find (loc_cd-plu where
     4952                         loc_cd-plu.obj-type = 'маг':U
     4953                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4954                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4955                      and loc_cd-plu.plu-type = v-plu-type
     4956                      and loc_cd-plu.plu-code = ii
     4957                      )
     4958       then LEAVE .
     4959     END .
     4960     if ii > v-max-gds then do:
     4961         if not p-silence then
     4962         message
     4963         substitute("Превышено максимально допустимое количество &5 &1" +
     4964                   "для касс &2 &3&4"
     4965                   , chr(10)
     4966                   , v-max-gds
     4967                   , 'маг':U
     4968                   , buf_cash-desk.obj-code
     4969                   , (if p-is-petrolium then "топлив" else "товаров")
     4970                   )
     4971         view-as alert-box ERROR .
     4972         undo, return error "max-gds":U.
     4973     end.
     4974     run cur-time in this-procedure ( output v-today, output v-time).
     4975     create buf_cd-plu.
     4976     assign
     4977     buf_cd-plu.b-code = p-b-code
     4978     buf_cd-plu.b-str = p-b-str
     4979     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4980                                         then buf_cash-desk.addr-path
     4981                                         else "U":U)
     4982     buf_cd-plu.to-send = yes
     4983     buf_cd-plu.charkey_one = "":U
     4984     buf_cd-plu.to-del = no
     4985     buf_cd-plu.plu-code = ii
     4986     buf_cd-plu.obj-type = 'маг':U
     4987     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4988     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4989     buf_cd-plu.plu-type = v-plu-type
     4990     buf_cd-plu.logkey_one = p-loc-ean
     4991     buf_cd-plu.key#_one = integer(p-extra)
     4992     .
     4993     run cd-attr-write  in this-procedure (
     4994                                           input   buf_cash-desk.db-num
     4995                                           ,input  buf_cash-desk.obj-code
     4996                                           ,input  buf_cash-desk.pos-type
     4997                                           ,input  buf_cash-desk.cash-num
     4998                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4999                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5000                                                 and p-is-petrolium
     5001                                                 then 'tot-petrol':U
     5002                                                 else 'tot-gds':U)
     5003                                           ,input ''
     5004                                           ,input ?
     5005                                           ,input 0.0
     5006                                           ,input  (v-tot-gds + 1)
     5007                                           ,input no
     5008                                          ) no-error .
     5009     if error-status:error then do:
     5010       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     5011                          ,buf_cash-desk.cash-num
     5012                          , 'маг':U
     5013                          ,buf_cash-desk.obj-code
     5014                          , chr(10)
     5015                          , error-status:get-message(1)
     5016                          , return-value
     5017                          ).
     5018       if not p-silence then
     5019       message
     5020       v-mes
     5021       view-as alert-box error .
     5022       undo _main, return error v-mes.
     5023     end.
     5024     run cd-attr-write  in this-procedure (
     5025                                           input   buf_cash-desk.db-num
     5026                                           ,input  buf_cash-desk.obj-code
     5027                                           ,input  buf_cash-desk.pos-type
     5028                                           ,input  buf_cash-desk.cash-num
     5029                                           ,input  'MARIA_operative':U
     5030                                           ,input  'to-send':U
     5031                                           ,input ''
     5032                                           ,input ?
     5033                                           ,input 0.0
     5034                                           ,input 0
     5035                                           ,input yes
     5036                                          ) no-error .
     5037     if error-status:error then do:
     5038       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5039                          ,buf_cash-desk.cash-num
     5040                          , 'маг':U
     5041                          ,buf_cash-desk.obj-code
     5042                          , chr(10)
     5043                          , error-status:get-message(1)
     5044                          , return-value
     5045                          ).
     5046       if not p-silence then
     5047       message
     5048       v-mes
     5049       view-as alert-box error .
     5050       undo _main, return error v-mes.
     5051     end.
     5052     return "":U.
     5053   end.
     5054   END PROCEDURE.
     5055   procedure cd-mrkt_update-marketer :
     5056   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5057   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5058   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5059   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5060   define input parameter p-is-petrolium as logical no-undo .
     5061   define variable v-to-send as logical no-undo .
     5062   define variable v-tot-gds as integer no-undo .
     5063   define variable v-max-plu as integer no-undo .
     5064   define buffer buf_cd-plu for ub.cd-plu.
     5065   define variable v-plu-type as character no-undo .
     5066     do
     5067     on error undo, return error
     5068     :
     5069       v-to-send = no.
     5070       v-tot-gds = 0.
     5071       assign
     5072       v-plu-type = (if p-is-petrolium
     5073                     then  'топ':U
     5074                     else '':U
     5075                 )
     5076       .
     5077       FOR EACH buf_cd-plu WHERE
     5078              buf_cd-plu.obj-type = 'маг':U
     5079         and  buf_cd-plu.obj-code = p-obj-code
     5080         and  buf_cd-plu.pos-type = p-pos-type
     5081         and  buf_cd-plu.plu-type = v-plu-type
     5082             :
     5083         if  buf_cd-plu.to-del
     5084         or  buf_cd-plu.to-send then do:
     5085           assign
     5086           v-to-send = yes.
     5087         end.
     5088         assign
     5089         v-tot-gds = v-tot-gds + 1.
     5090       end.
     5091       run cd-attr-write  in this-procedure (
     5092                                               input   p-db-num
     5093                                               ,input  p-obj-code
     5094                                               ,input  p-pos-type
     5095                                               ,input  p-cash-num
     5096                                               ,input  'MARIA_operative':U
     5097                                               ,input  (if p-pos-type = 'MARIA':U
     5098                                                        and p-is-petrolium
     5099                                                        then  'tot-petrol':U
     5100                                                        else 'tot-gds':U)
     5101                                               ,input ''
     5102                                               ,input ?
     5103                                               ,input 0.0
     5104                                               ,input v-tot-gds
     5105                                               ,input no
     5106                                                                                           ) no-error .
     5107       if error-status:error then do:
     5108           UNDO, RETURN ERROR RETURN-VALUE.
     5109       END.
     5110       run cd-attr-write  in this-procedure (
     5111                                               input   p-db-num
     5112                                               ,input  p-obj-code
     5113                                               ,input  p-pos-type
     5114                                               ,input  p-cash-num
     5115                                               ,input  'MARIA_operative':U
     5116                                               ,input  (if p-pos-type = 'MARIA':U
     5117                                                        and p-is-petrolium
     5118                                                        then  'petrol-to-send':U
     5119                                                        else 'to-send':U)
     5120                                               ,input ''
     5121                                               ,input ?
     5122                                               ,input 0.0
     5123                                               ,input 0
     5124                                               ,input v-to-send
     5125                                               ) no-error .
     5126       if error-status:error then do:
     5127           UNDO, RETURN ERROR RETURN-VALUE.
     5128       END.
     5129       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5130                buf_cd-plu.obj-type = 'маг':U
     5131            and buf_cd-plu.obj-code = p-obj-code
     5132            and buf_cd-plu.pos-type = p-pos-type
     5133            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5134       if available buf_cd-plu then do:
     5135         if v-max-plu < buf_cd-plu.plu-code
     5136         then
     5137         v-max-plu = buf_cd-plu.plu-code .
     5138       end.
     5139       else do:
     5140         v-max-plu = 0.
     5141       end.
     5142       run cd-attr-write  in this-procedure (
     5143                                             input   p-db-num
     5144                                             ,input  p-obj-code
     5145                                             ,input  p-pos-type
     5146                                             ,input  p-cash-num
     5147                                             ,input  'MARIA_operative':U
     5148                                             ,input  (if p-pos-type = 'MARIA':U
     5149                                                     and p-is-petrolium
     5150                                                     then 'max-petrol-plu':U
     5151                                                     else 'max-plu':U)
     5152                                               ,input ''
     5153                                               ,input ?
     5154                                               ,input 0.0
     5155                                               ,input v-max-plu
     5156                                               ,input no
     5157                                             ) no-error .
     5158       if error-status:error then do:
     5159           UNDO, RETURN ERROR RETURN-VALUE.
     5160       END.
     5161     end.
     5162   end procedure.
     5163   PROCEDURE cd-mrkt_clu-marketer :
     5164   define input parameter p-silence as logical no-undo .
     5165   define parameter buffer buf_cash-desk for ub.cash-desk.
     5166   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5167   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5168   define variable v-tot-cli as integer no-undo .
     5169   define variable v-max-cli as integer no-undo .
     5170   DEFINE VARIABLE v-today as date no-undo .
     5171   DEFINE VARIABLE v-time as integer no-undo .
     5172   define buffer  buf_cd-clu for ub.cd-clu.
     5173   define buffer  loc_cd-clu for ub.cd-clu.
     5174   define variable  ii as integer no-undo.
     5175   define variable v-mes as character no-undo .
     5176   _main:
     5177   DO ON ERROR undo, leave on stop undo, leave:
     5178     if buf_cash-desk.pos-type <> 'MARIA':U
     5179     or buf_cash-desk.cash-num <> 0 then do:
     5180       assign
     5181       v-mes =
     5182       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5183                 , buf_cash-desk.pos-type).
     5184       if not p-silence then
     5185       message
     5186       v-mes
     5187       view-as alert-box error .
     5188       return error v-mes.
     5189     end.
     5190     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5191                                     ,input 'MARIA_operative':U
     5192                                     ,input 'tot-cli':U
     5193                                     ,output v-mes).
     5194     if v-tot-cli = ? then undo _main, return error v-mes.
     5195     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5196                                     ,input 'MARIA_general':U
     5197                                     ,input 'max-cli':U
     5198                                     , output v-mes).
     5199     if v-max-cli = ? then undo _main, return error v-mes.
     5200     DO ii = 1
     5201        to v-max-cli :
     5202       if not can-find (loc_cd-clu where
     5203                       loc_cd-clu.obj-type = 'маг':U
     5204                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5205                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5206                   and loc_cd-clu.clu-type = '':U
     5207                   and loc_cd-clu.clu-code = ii
     5208                      )
     5209       then LEAVE .
     5210     END .
     5211     if ii > v-max-cli then do:
     5212         if not p-silence then
     5213         message
     5214         substitute("Превышено максимально допустимое количество клиентов &1" +
     5215                   "для касс &2 &3&4"
     5216                   , chr(10)
     5217                   , v-max-cli
     5218                   , 'маг':U
     5219                   , buf_cash-desk.obj-code
     5220                   )
     5221         view-as alert-box ERROR .
     5222         undo, return error "max-cli":U.
     5223     end.
     5224     run cur-time in this-procedure ( output v-today, output v-time).
     5225     create buf_cd-clu.
     5226     assign
     5227     buf_cd-clu.cli-code = p-obj-code
     5228     buf_cd-clu.cli-type = p-obj-type
     5229     buf_cd-clu.obj-type = 'маг':U
     5230     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5231     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5232     buf_cd-clu.clu-type = '':U
     5233     buf_cd-clu.to-send = yes
     5234     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5235                               then buf_cash-desk.addr-path
     5236                               else "U":U)
     5237     buf_cd-clu.clu-code = ii
     5238     .
     5239     run cd-attr-write  in this-procedure (
     5240                                           input   buf_cash-desk.db-num
     5241                                           ,input  buf_cash-desk.obj-code
     5242                                           ,input  buf_cash-desk.pos-type
     5243                                           ,input  buf_cash-desk.cash-num
     5244                                           ,input  'MARIA_operative':U
     5245                                           ,input  'tot-cli':U
     5246                                           ,input ''
     5247                                           ,input ?
     5248                                           ,input 0.0
     5249                                           ,input  (v-tot-cli + 1)
     5250                                           ,input no
     5251                                          ) no-error .
     5252     if error-status:error then do:
     5253       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5254                          ,buf_cash-desk.cash-num
     5255                          , 'маг':U
     5256                          ,buf_cash-desk.obj-code
     5257                          , chr(10)
     5258                          , error-status:get-message(1)
     5259                          , return-value
     5260                          ).
     5261       if not p-silence then
     5262       message
     5263       v-mes
     5264       view-as alert-box error .
     5265       undo _main, return error v-mes.
     5266     end.
     5267     run cd-attr-write  in this-procedure (
     5268                                           input   buf_cash-desk.db-num
     5269                                           ,input  buf_cash-desk.obj-code
     5270                                           ,input  buf_cash-desk.pos-type
     5271                                           ,input  buf_cash-desk.cash-num
     5272                                           ,input  'MARIA_operative':U
     5273                                           ,input  'cli-to-send':U
     5274                                           ,input ''
     5275                                           ,input ?
     5276                                           ,input 0.0
     5277                                           ,input 0
     5278                                           ,input yes
     5279                                          ) no-error .
     5280     if error-status:error then do:
     5281       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5282                          ,buf_cash-desk.cash-num
     5283                          , 'маг':U
     5284                          ,buf_cash-desk.obj-code
     5285                          , chr(10)
     5286                          , error-status:get-message(1)
     5287                          , return-value
     5288                          ).
     5289       if not p-silence then
     5290       message
     5291       v-mes
     5292       view-as alert-box error .
     5293       undo _main, return error v-mes.
     5294     end.
     5295     return "":U.
     5296   end.
     5297   END PROCEDURE.
     5298   procedure cd-mrkt_update-marketer-cli :
     5299   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5300   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5301   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5302   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5303   define variable v-cli-to-send as logical no-undo .
     5304   define variable v-tot-cli as integer no-undo .
     5305   define variable v-max-clu as integer no-undo .
     5306   define buffer buf_cd-clu for ub.cd-clu.
     5307   do
     5308   on error undo, return error return-value
     5309   :
     5310     v-cli-to-send = no.
     5311     v-tot-cli = 0.
     5312     FOR EACH buf_cd-clu WHERE
     5313           buf_cd-clu.obj-type = 'маг':U
     5314       and buf_cd-clu.obj-code =  p-obj-code
     5315       and buf_cd-clu.pos-type =  p-pos-type
     5316       and buf_cd-clu.clu-type =  '':U
     5317       :
     5318       if buf_cd-clu.to-del = yes then do:
     5319         assign
     5320         v-cli-to-send = yes.
     5321       end.
     5322       assign
     5323       v-tot-cli = v-tot-cli + 1.
     5324     end.
     5325     run cd-attr-write  in this-procedure (
     5326                                             input   p-db-num
     5327                                             ,input  p-obj-code
     5328                                             ,input  p-pos-type
     5329                                             ,input  p-cash-num
     5330                                             ,input  'MARIA_operative':U
     5331                                             ,input  'tot-cli':U
     5332                                             ,input ''
     5333                                             ,input ?
     5334                                             ,input 0.0
     5335                                             ,input v-tot-cli
     5336                                             ,input no
     5337                                             ) no-error .
     5338     if error-status:error then do:
     5339         UNDO, RETURN ERROR RETURN-VALUE.
     5340     END.
     5341     run cd-attr-write  in this-procedure (
     5342                                             input   p-db-num
     5343                                             ,input  p-obj-code
     5344                                             ,input  p-pos-type
     5345                                             ,input  p-cash-num
     5346                                             ,input  'MARIA_operative':U
     5347                                             ,input  'cli-to-send':U
     5348                                             ,input ''
     5349                                             ,input ?
     5350                                             ,input 0.0
     5351                                             ,input 0
     5352                                             ,input v-cli-to-send
     5353                                             ) no-error .
     5354     if error-status:error then do:
     5355         UNDO, RETURN ERROR RETURN-VALUE.
     5356     END.
     5357     FIND LAST buf_cd-clu WHERE
     5358             buf_cd-clu.obj-type = 'маг':U
     5359         and buf_cd-clu.obj-code = p-obj-code
     5360         and buf_cd-clu.pos-type = p-pos-type
     5361         and buf_cd-clu.clu-type = '':U
     5362         NO-LOCK use-index pi no-error .
     5363     if available buf_cd-clu then do:
     5364       if v-max-clu < buf_cd-clu.clu-code
     5365       then
     5366       v-max-clu = buf_cd-clu.clu-code.
     5367     end.
     5368     else do:
     5369       v-max-clu = 0.
     5370     end.
     5371     run cd-attr-write  in this-procedure (
     5372                                           input   p-db-num
     5373                                           ,input  p-obj-code
     5374                                           ,input  p-pos-type
     5375                                           ,input  p-cash-num
     5376                                           ,input  'MARIA_operative':U
     5377                                           ,input  'max-clu':U
     5378                                           ,input ''
     5379                                           ,input ?
     5380                                           ,input 0.0
     5381                                           ,input v-max-clu
     5382                                           ,input no
     5383                                           ) no-error .
     5384     if error-status:error then do:
     5385         UNDO, RETURN ERROR RETURN-VALUE.
     5386     END.
     5387   end.
     5388   end procedure.
