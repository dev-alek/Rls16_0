    14315      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    14316      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    14317      then do:
    14318        v-fields-shift123 = - 1.
    14319   if v-record <> '':U then
    14320       run maria-put in this-procedure (
    14321                                       buffer for-cash-desk
    14322                                     , input out
    14323                                     , input fname
    14324                                     , input yes
    14325                                     , input v-fields-shift123
    14326                                     , input yes
    14327                                     , input 24
    14328                                     , input 1
    14329                                     , input string(1)
    14330                                     , input v-record
    14331                                       ).
    14332      end.
    14333   find first temp-tekka-tsk no-error.
    14334   if available temp-tekka-tsk then do:
    14335      v-found123 = yes.
    14336   end.
    14337   if v-found123 = yes then do:
    14338   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    14339   v-is-script123 = no.
    14340   for each temp-tekka-tsk:
    14341     if (temp-tekka-tsk.num-rec > 0
    14342     or temp-tekka-tsk.send-get = 'task')
    14343     and temp-tekka-tsk.task-num = fname then do:
    14344       export stream IBmSTREAM temp-tekka-tsk.
    14345       v-found123 = yes.
    14346     end.
    14347     if temp-tekka-tsk.is-script then do:
    14348       v-is-script123 = yes.
    14349     end.
    14350     delete temp-tekka-tsk.
    14351   end.
    14352   output stream IBMStream
    14353   close.
    14354   run write-log-and-file in p-log-handle (
    14355         input 1
