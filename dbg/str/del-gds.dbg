    14297                                       , input yes
    14298                                       , input 0
    14299                                       , input no
    14300                                       , input 6
    14301                                       , input 5000
    14302                                       , input v-plu
    14303                                       , input (if cash-gds.grp-code = 0
    14304                                                then '001'
    14305                                                else string(cash-gds.grp-code, "999"))).
    14306       end.
    14307     end.
    14308   end.
    14309     end.
    14310   END .
