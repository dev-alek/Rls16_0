    12444                     caps(string(chk_name,'x(20)'))
    12445                     string( ( cash-gds.price-sale * 100 ) ,'999999999999')
    12446                     .
    12447                     put unformatted
    12448                     '000000000000000000000000000'
    12449                     string(action, "X(1)")
    12450                     fill('0':U , 12)
    12451                     string(v-r-b-curr-magia, "9")
    12452                     fill('0':U , 104)
    12453                     .
    12454                     put skip.
    12455                 end.
    12456                 if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
