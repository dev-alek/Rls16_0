     6339   define variable v-base-scale0   as decimal   no-undo .
     6340   define variable v-exch-rate0    as decimal   no-undo .
     6341   define variable v-exch-scale0   as decimal   no-undo .
     6342   define variable v-base-rate     as decimal   no-undo .
     6343   define variable v-base-scale    as decimal   no-undo .
     6344   define variable v-exch-rate     as decimal   no-undo .
     6345   define variable v-exch-scale    as decimal   no-undo .
     6346   define variable v-host-code     as integer   no-undo .
     6347   define variable v-curr-abbr     as character no-undo .
     6348   define variable v-grp-name      as character no-undo .
     6349   define variable v-date-1        as date      no-undo .
     6350   define variable v-date-2        as date      no-undo .
     6351   define variable v-interv        as character no-undo .
     6352   define variable v-pay-name      as character no-undo .
