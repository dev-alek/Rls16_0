     3272   define variable v-cd-list-update             as character no-undo .
     3273   define variable v-cd-list-delete             as character no-undo .
     3274   define variable v-param-type as character no-undo .
     3275   define variable v-value-character as character no-undo .
     3276   define variable v-value-date as date no-undo .
     3277   define variable v-value-decimal as decimal no-undo .
     3278   define variable v-value-integer as INTEGER no-undo .
     3279   define variable v-value-logical AS LOGICAL no-undo .
     3280   define variable v-tth as handle no-undo .
     3281   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3282   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3283   assign
     3284   v-tth = buffer thbjattr_thbj-attr:table-handle .
     3285   define stream   IBMStream .
     3286   define temp-table temp-cd no-undo like ub.cash-desk .
     3287   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3288   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   procedure alienini-getkey :
     3290   define input parameter i-filename as char.
     3291   define input parameter i-section as char.
     3292   define input parameter i-key as char.
     3293   define output parameter o-value as char.
     3294   define variable EntryPointer as integer no-undo.
     3295   define variable mem1 as memptr no-undo.
     3296   define variable mem2 as memptr no-undo.
     3297   define variable mem1size as integer no-undo.
     3298   define variable mem2size as integer no-undo.
     3299   define variable ii       as integer    no-undo.
     3300   define variable cbReturnSize  as integer    no-undo.
     3301   assign
     3302   set-size(mem1)  = 4000
     3303   mem1size = 4000.
     3304   if i-key = "" then EntryPointer = 0.
     3305   else do:
     3306     assign
     3307     set-size(mem2) = 128
     3308     mem2size = 128
     3309     EntryPointer = get-pointer-value(mem2)
     3310     put-string(mem2, 1) = i-key.
     3311   end.
     3312   run getprivateprofilestringA
     3313                                 (i-section,
     3314                                  EntryPointer,
     3315                                  "",
     3316                                  get-pointer-value(mem1),
     3317                                  input mem1size,
     3318                                  i-filename,
     3319                                  output cbReturnSize).
     3320   do ii = 1 to cbReturnSize:
     3321     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3322                  then o-value + ","
     3323                  else o-value + chr(get-byte(mem1, ii)).
     3324   end.
     3325     set-size(mem1) = 0.
     3326     set-size(mem2) = 0.
     3327   end procedure.
     3328   procedure alienini-putkey :
     3329   define input parameter i-filename as char.
     3330   define input parameter i-section as char.
     3331   define input parameter i-key as char.
     3332   define input parameter i-value as char.
     3333   define variable cbReturnSize as integer.
     3334   run writeprivateprofilestringA
     3335                                  (i-section,
     3336                                   i-key,
     3337                                   i-value,
     3338                                   i-filename,
     3339                                   output cbReturnSize ).
     3340   end procedure.
     3341   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3342     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3343     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3344     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3345     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3346     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3347     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3348     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3349   END PROCEDURE.
     3350   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3351     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3352     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3353     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3354     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3355     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3356   END PROCEDURE.
     3357   define   temp-table temp-tekka-tsk no-undo
     3358   field filename      as character
     3359   field obj-num       as integer
     3360   field obj-name      as character
     3361   field num-records   as integer
     3362   field max-records   as integer
     3363   field min-plu       as integer
     3364   field max-plu       as integer
     3365   field num-fields    as integer
     3366   field task-num      as character
     3367   field by-record     as logical
     3368   field send-get      as character
     3369   field cash-num      as integer
     3370   field cash-num-char as character
     3371   field port-num      as character
     3372   field way           as character
     3373   field is-script     as logical
     3374   field pswd          as character
     3375   field waiting-sek   as integer
     3376   field other-info    as character
     3377   field order-num     as integer
     3378   field secondary     as integer
     3379   field shift-fields  as integer
     3380   field binary        as logical
     3381   field range         as integer
     3382   index pi is unique primary
     3383   filename
     3384   range
     3385   index lpi
     3386   filename
     3387   min-plu
     3388   index gpi
     3389   filename
     3390   max-plu
     3391   index iorder
     3392   order-num
     3393   .
     3394   define   temp-table temp-tekka-schema no-undo
     3395   field obj-num as integer
     3396   field obj-name as character
     3397   field field-num as integer
     3398   field field-name as character
     3399   field num-records as integer
     3400   field size_ as integer
     3401   field host as character
     3402   field progress-type as character
     3403   field custom-type as character
     3404   field start-pos as integer
     3405   field end-pos as integer
     3406   field bin-group as character
     3407   index pi is unique primary
     3408   host obj-num field-num
     3409   .
     3410   define temp-table temp-tekka-record no-undo
     3411   field obj-num as integer
     3412   field plu as integer
     3413   field body as character
     3414   field shift as integer
     3415   index pi is unique primary obj-num plu.
     3416   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3417   define variable v-is-closed-shift-journal as integer no-undo .
     3418   assign
     3419   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3420                               +
     3421                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3422                               +
     3423                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3424   .
     3425   return v-is-closed-shift-journal.
     3426   END FUNCTION.
     3427   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3428   define variable v-is-first-journal as logical no-undo .
     3429   assign
     3430   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3431                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3432                     or (p-journal-num =  integer(entry(1, '17':U)))
     3433                     or (p-journal-num = integer(entry(1, '16':U)))
     3434   .
     3435   return v-is-first-journal.
     3436   END FUNCTION.
     3437   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3438   define variable v-is-petrol-journal as logical no-undo .
     3439   assign
     3440   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3441   return v-is-petrol-journal.
     3442   END FUNCTION.
     3443   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3444   define variable v-max-record-num as integer no-undo .
     3445   assign
     3446   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3447                       then 1489
     3448                       else 2340).
     3449   return v-max-record-num.
     3450   END FUNCTION.
     3451   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3452   define variable v-max-record-num as integer no-undo .
     3453   assign
     3454   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3455                       then 1489 * num-entries('30,31,32,33':U)
     3456                       else 2340 * num-entries('17':U)).
     3457   return v-max-record-num.
     3458   END FUNCTION.
     3459   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3460                                           ,input p-rec-no as integer):
     3461   define variable v-num-recs as integer no-undo .
     3462   if tekka-is-petrol-journal (p-journal-num) then do:
     3463     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3464       assign
     3465       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3466       .
     3467     end.
     3468     else do:
     3469       assign
     3470       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3471       .
     3472     end.
     3473   end.
     3474   else do:
     3475     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3476       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3477         assign
     3478         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3479         .
     3480       end.
     3481       else do:
     3482         assign
     3483         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3484         .
     3485       end.
     3486     end.
     3487     else do:
     3488       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3489         assign
     3490         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3491         .
     3492       end.
     3493       else do:
     3494         assign
     3495         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3496         .
     3497       end.
     3498     end.
     3499   end.
     3500   return v-num-recs.
     3501   END FUNCTION.
     3502   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3503                                              ,input p-is-petrol as logical
     3504                                              ,input p-is-current as logical
     3505                                              ,output p-rec-no as decimal
     3506                                              ):
     3507   define variable v-obj-num0 as integer no-undo .
     3508   define variable v-obj-num as integer no-undo .
     3509   define variable v-obj-num2 as integer no-undo .
     3510   define variable p-num-recs2 as integer no-undo .
     3511   define variable p-rec-no2 as integer no-undo .
     3512   if p-is-petrol then do:
     3513     assign
     3514     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3515     .
     3516     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3517     then
     3518     assign
     3519     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3520     p-rec-no = p-num-recs modulo 1489
     3521     .
     3522     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3523     then
     3524     assign
     3525     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3526     p-rec-no = p-num-recs modulo 1489
     3527     .
     3528   end.
     3529   else do:
     3530     assign
     3531     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3532     p-num-recs = trunc(p-num-recs, 0)
     3533     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3534     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3535     .
     3536     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3537     then
     3538     assign
     3539     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3540     p-rec-no = p-num-recs modulo 2340
     3541     .
     3542     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3543     then
     3544     assign
     3545     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3546     p-rec-no = p-num-recs modulo 2340
     3547     .
     3548     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3549     then
     3550     assign
     3551     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3552     p-rec-no2 = p-num-recs2 modulo 2978
     3553     .
     3554     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3555     then
     3556     assign
     3557     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3558     p-rec-no2 = p-num-recs2 modulo 2978
     3559     .
     3560     assign
     3561     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3562     .
     3563   end.
     3564   if v-obj-num = 0 then v-obj-num = 100.
     3565   return v-obj-num.
     3566   END FUNCTION.
     3567   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3568   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3569   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3570      if p-is-ptrl then
     3571      return integer(entry(1, '26,27,28,29':U)).
     3572      if not p-is-ptrl then
     3573      return integer(entry(1, '16':U)).
     3574   end.
     3575   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3576   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3577   return 0.
     3578   END FUNCTION.
     3579   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3580   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3581   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3582     if p-is-ptrl then
     3583     return integer(entry(1, '26,27,28,29':U)).
     3584     if not p-is-ptrl then
     3585     return integer(entry(1, '16':U)).
     3586   end.
     3587   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3588   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3589   return 0.
     3590   END FUNCTION.
     3591   PROCEDURE maria-put:
     3592   define parameter buffer buf_cash-desk for ub.cash-desk.
     3593   define input parameter p-out    as character no-undo .
     3594   define input parameter p-fname as character no-undo .
     3595   define input parameter p-by-record as logical no-undo .
     3596   define input parameter p-shift-fields as integer no-undo .
     3597   define input parameter p-binary as logical no-undo .
     3598   define input parameter p-obj-num as integer no-undo .
     3599   define input parameter p-max-records as integer no-undo .
     3600   define input parameter p-plu as integer no-undo .
     3601   define input parameter p-value as character no-undo .
     3602   define variable v-file-name as character no-undo .
     3603   define variable v-create as logical no-undo .
     3604   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3605   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3606   output stream IBMSTREAM
     3607   to value(v-file-name) append .
     3608   Put  stream IBMSTREAM unformatted
     3609   p-plu
     3610   chr(3)
     3611   p-value
     3612   skip.
     3613   output stream IBMSTREAM
     3614   close.
     3615   if not p-by-record then do:
     3616     find first buf_temp-tekka-tsk where
     3617               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3618     if not available buf_temp-tekka-tsk then do:
     3619       v-create = yes.
     3620     end.
     3621   end.
     3622   else do:
     3623     find first buf_temp-tekka-tsk where
     3624               buf_temp-tekka-tsk.filename  = v-file-name
     3625           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3626     if not available buf_temp-tekka-tsk
     3627     then do:
     3628       find first buf_temp-tekka-tsk where
     3629                 buf_temp-tekka-tsk.filename  = v-file-name
     3630             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3631       if not available buf_temp-tekka-tsk
     3632       then do:
     3633         v-create = yes.
     3634       end.
     3635     end.
     3636   end.
     3637   if v-create then do:
     3638     create buf_temp-tekka-tsk.
     3639     assign
     3640     buf_temp-tekka-tsk.filename = v-file-name
     3641     buf_temp-tekka-tsk.range    = p-plu
     3642     buf_temp-tekka-tsk.obj-num = p-obj-num
     3643     buf_temp-tekka-tsk.obj-name = '':U
     3644     buf_temp-tekka-tsk.num-records = 0
     3645     buf_temp-tekka-tsk.max-records = p-max-records
     3646     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3647     buf_temp-tekka-tsk.task-num = p-fname
     3648     buf_temp-tekka-tsk.by-record = p-by-record
     3649     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3650     buf_temp-tekka-tsk.binary = p-binary
     3651     buf_temp-tekka-tsk.send-get = 'send'
     3652     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3653     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3654     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3655     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3656                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3657                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3658                                 then 'local'
     3659                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3660     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3661     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3662     buf_temp-tekka-tsk.waiting-sek = 30
     3663     buf_temp-tekka-tsk.min-plu     = p-plu
     3664     buf_temp-tekka-tsk.max-plu     = p-plu
     3665     .
     3666   end.
     3667   assign
     3668   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3669   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3670   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3671   .
     3672   END PROCEDURE.
     3673   PROCEDURE maria-get:
     3674   define parameter buffer buf_cash-desk for ub.cash-desk.
     3675   define input parameter p-out    as character no-undo .
     3676   define input parameter p-fname as character no-undo .
     3677   define input parameter p-by-record as logical no-undo .
     3678   define input parameter p-obj-num as integer no-undo .
     3679   define input parameter p-num-fields as integer no-undo .
     3680   define input parameter p-max-records as integer no-undo .
     3681   define input parameter p-min-plu as integer no-undo .
     3682   define input parameter p-max-plu as integer no-undo .
     3683   define input parameter p-other as character no-undo .
     3684   define input parameter p-order-num as integer no-undo .
     3685   define variable v-file-name as character no-undo .
     3686   define variable v-secondary-obj-num as character no-undo .
     3687   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3688   if p-by-record then do:
     3689     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3690   end.
     3691   else do:
     3692     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3693   end.
     3694   find first buf_temp-tekka-tsk where
     3695             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3696   if not available buf_temp-tekka-tsk then do:
     3697     create buf_temp-tekka-tsk.
     3698     assign
     3699     buf_temp-tekka-tsk.filename = v-file-name
     3700     buf_temp-tekka-tsk.obj-num = p-obj-num
     3701     buf_temp-tekka-tsk.obj-name = '':U
     3702     buf_temp-tekka-tsk.max-records = p-max-records
     3703     buf_temp-tekka-tsk.num-fields = p-num-fields
     3704     buf_temp-tekka-tsk.task-num = p-fname
     3705     buf_temp-tekka-tsk.by-record = p-by-record
     3706     buf_temp-tekka-tsk.send-get = 'get'
     3707     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3708     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3709     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3710     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3711                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3712                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3713                                   then 'local'
     3714                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3715     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3716     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3717     buf_temp-tekka-tsk.waiting-sek = 30
     3718     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3719     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3720     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3721                                       and p-max-plu <> ?
     3722                                       then p-max-plu - p-min-plu + 1
     3723                                       else 0)
     3724     buf_temp-tekka-tsk.other-info = p-other
     3725     buf_temp-tekka-tsk.order-num = p-order-num
     3726     .
     3727     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3728       assign
     3729       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3730       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3731       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3732       no-error
     3733       .
     3734       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3735     end.
     3736   end.
     3737   END PROCEDURE.
     3738   PROCEDURE maria-task:
     3739   define parameter buffer buf_cash-desk for ub.cash-desk.
     3740   define input parameter p-fname as character no-undo .
     3741   define input parameter p-obj-num-list as character no-undo .
     3742   define input parameter p-parameters as character no-undo .
     3743   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3744   find first buf_temp-tekka-tsk where
     3745             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3746   if not available buf_temp-tekka-tsk then do:
     3747     create buf_temp-tekka-tsk.
     3748     assign
     3749     buf_temp-tekka-tsk.filename = ''
     3750     buf_temp-tekka-tsk.range = 1
     3751     buf_temp-tekka-tsk.obj-num = 0
     3752     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3753     buf_temp-tekka-tsk.task-num = p-fname
     3754     buf_temp-tekka-tsk.by-record = no
     3755     buf_temp-tekka-tsk.send-get = 'task'
     3756     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3757     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3758     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3759     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3760                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3761                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3762                                   then 'local'
     3763                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3764     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3765     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3766     buf_temp-tekka-tsk.waiting-sek = 30
     3767     buf_temp-tekka-tsk.other-info = p-parameters
     3768     buf_temp-tekka-tsk.order-num = 0
     3769     .
     3770   end.
     3771   END PROCEDURE.
     3772   procedure tekkatsk-verify-schema :
     3773   define input parameter p-obj-list as character no-undo .
     3774   define input parameter p-dir-path as character no-undo .
     3775   define variable v-obj-num as integer no-undo .
     3776   define variable v-obj-name as character no-undo .
     3777   define variable v-num-records as integer no-undo .
     3778   define variable v-size_ as integer no-undo .
     3779   define variable v-value as character no-undo .
     3780   define variable ii as integer no-undo .
     3781   define variable jj as integer no-undo .
     3782   define variable ii-ibs as integer no-undo .
     3783   define variable ii-tekka as integer no-undo .
     3784   define variable v-result as character no-undo .
     3785   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3786   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3787     do
     3788     on error undo, return error
     3789     :
     3790        for each buf_temp-tekka-schema:
     3791          delete buf_temp-tekka-schema.
     3792        end.
     3793        input from value('tekkasch.d').
     3794        repeat :
     3795          create buf_temp-tekka-schema.
     3796          import buf_temp-tekka-schema.
     3797          assign
     3798          buf_temp-tekka-schema.host = 'IBS'
     3799          ii = ii + 1.
     3800          .
     3801        end.
     3802        input close.
     3803        ii-ibs = ii.
     3804         _ii:
     3805         do ii = 1 to 256:
     3806           if p-obj-list = "ALL"
     3807           or lookup(string(ii), p-obj-list) > 0 then do:
     3808             assign
     3809             v-obj-num = 0
     3810             v-obj-name = ''
     3811             v-num-records = 0
     3812             v-size_ = 0
     3813             .
     3814             run alienini-getkey in this-procedure (
     3815                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3816                                                     ,input ('obj' + string(ii, '999'))
     3817                                                     ,input 'oname'
     3818                                                     ,output v-value) no-error .
     3819             if v-value = ? then next _ii.
     3820             assign
     3821             v-obj-num = ii
     3822             v-obj-name = v-value
     3823             .
     3824             run alienini-getkey in this-procedure (
     3825                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3826                                                     ,input ('obj' + string(ii, '999'))
     3827                                                     ,input 'size'
     3828                                                     ,output v-value) no-error .
     3829             assign
     3830             v-num-records = integer(v-value) no-error  .
     3831             if error-status:error
     3832             or v-num-records = 0 then next _ii.
     3833             run alienini-getkey in this-procedure (
     3834                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3835                                                     ,input 'obj' + string(ii, '999')
     3836                                                     ,input 'f000'
     3837                                                     ,output v-value) no-error .
     3838             assign
     3839             v-size_ = integer(v-value) no-error  .
     3840             if error-status:error
     3841             or v-size_ = 0 then next _ii.
     3842             _jj:
     3843             do jj = 1 to 256:
     3844               run alienini-getkey in this-procedure (
     3845                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3846                                                       ,input 'obj' + string(ii, '999')
     3847                                                       ,input 'f' + string(jj, '999')
     3848                                                       ,output v-value) no-error .
     3849               if v-value = ? then next _ii.
     3850               create buf_temp-tekka-schema.
     3851               assign
     3852               buf_temp-tekka-schema.host = 'tekka'
     3853               buf_temp-tekka-schema.obj-num = v-obj-num
     3854               buf_temp-tekka-schema.obj-name = v-obj-name
     3855               buf_temp-tekka-schema.num-records = v-num-records
     3856               buf_temp-tekka-schema.size_ = v-size_
     3857               buf_temp-tekka-schema.field-num = jj
     3858               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3859               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3860                                                  then entry(2, entry(2, v-value, '#'), ':')
     3861                                                  else '':U)
     3862               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3863               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3864               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3865                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3866               no-error
     3867               .
     3868               if error-status:error then do:
     3869                 delete buf_temp-tekka-schema.
     3870                 next _jj.
     3871               end.
     3872               run alienini-getkey in this-procedure (
     3873                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3874                                                       ,input 'obj' + string(ii, '999') + 'name'
     3875                                                       ,input 'n' + string(jj, '999')
     3876                                                       ,output v-value) no-error .
     3877               if v-value <> ? then
     3878               buf_temp-tekka-schema.field-name = v-value.
     3879             end.
     3880           end.
     3881         end.
     3882         ii-tekka = ii - 1.
     3883        if p-obj-list <> 'ALL' then do:
     3884         if ii-tekka <> ii-ibs then do:
     3885           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3886                                   , ii-ibs
     3887                                   , ii-tekka).
     3888         end.
     3889        end.
     3890        for each buf_temp-tekka-schema where
     3891               buf_temp-tekka-schema.host = 'tekka':
     3892          find first buf2_temp-tekka-schema where
     3893                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3894                AND buf2_temp-tekka-schema.host = 'ibs'
     3895                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3896          if not available buf2_temp-tekka-schema then do:
     3897           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3898                                   , buf_temp-tekka-schema.field-num
     3899                                   , buf_temp-tekka-schema.obj-num).
     3900          end.
     3901          buffer-compare buf_temp-tekka-schema
     3902          to buf2_temp-tekka-schema
     3903          save result in v-result.
     3904          if v-result <> '':U then do:
     3905           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3906                                   , buf_temp-tekka-schema.field-num
     3907                                   , buf_temp-tekka-schema.obj-num).
     3908          end.
     3909        end.
     3910     end.
     3911   end procedure.
     3912   FUNCTION set-Sx returns character (input p-string as character):
     3913   return p-string.
     3914   END FUNCTION.
     3915   FUNCTION get-Sx returns character (input p-string  as character):
     3916   return p-string.
     3917   END FUNCTION.
     3918   FUNCTION set-B returns character (input p-string  as character):
     3919   return chr(integer(p-string)).
     3920   END FUNCTION.
     3921   FUNCTION get-B returns character (input p-string  as character):
     3922   return string(asc(p-string)).
     3923   END FUNCTION.
     3924   FUNCTION set-BF returns character (input p-string  as character):
     3925   define variable v-dopi as integer no-undo .
     3926   define variable ii as integer no-undo .
     3927   do ii = 1 to 8:
     3928     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3929   end.
     3930   return chr(v-dopi).
     3931   END FUNCTION.
     3932   FUNCTION get-BF returns character (input p-string  as character):
     3933   define variable v-dopi as integer no-undo .
     3934   define variable v-dops as character no-undo .
     3935   define variable ii as integer no-undo .
     3936   v-dopi = asc(p-string).
     3937   do ii = 8 to 1 BY -1:
     3938     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3939   end.
     3940   return v-dops.
     3941   END FUNCTION.
     3942   FUNCTION set-BN returns character (input p-string  as character
     3943                                     ,input p-bin-group as character):
     3944   define variable v-dopi as integer no-undo .
     3945   define variable ii as integer no-undo .
     3946   define variable jj as integer no-undo .
     3947   define variable v-grp-nums as integer no-undo .
     3948   define variable v-dopi2 as integer no-undo .
     3949   v-grp-nums = num-entries(p-bin-group).
     3950   do jj = 0 to v-grp-nums - 1:
     3951     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3952     do ii = 1 to 8:
     3953       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3954     end.
     3955   end.
     3956   return chr(v-dopi).
     3957   END FUNCTION.
     3958   FUNCTION get-BN returns character (input p-string  as character
     3959                                     ,input p-bin-group as character):
     3960   define variable v-dopi as integer no-undo .
     3961   define variable v-dops as character no-undo .
     3962   define variable v-grp-nums as integer no-undo .
     3963   define variable ii as integer no-undo .
     3964   define variable jj as integer no-undo .
     3965   v-dopi = asc(p-string).
     3966   v-grp-nums = num-entries(p-bin-group).
     3967   do jj = 1 to v-grp-nums:
     3968   do ii = 8 to 1 BY -1:
     3969     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3970   end.
     3971   end.
     3972   return v-dops.
     3973   END FUNCTION.
     3974   procedure fill-temp-cd :
     3975   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3976   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3977   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3978   define input parameter p-clear-table as logical no-undo .
     3979   define buffer buf_temp-cd for temp-cd.
     3980   define buffer buf_cash-desk for ub.cash-desk.
     3981     do
     3982     on error undo, return error
     3983     :
     3984        if p-clear-table  then do:
     3985          for each buf_temp-cd:
     3986            delete buf_temp-cd.
     3987          end.
     3988        end.
     3989        for each buf_cash-desk no-lock where
     3990               buf_cash-desk.db-num = p-db-num
     3991           AND buf_cash-desk.obj-code = p-obj-code
     3992           and buf_cash-desk.cash-on  = yes
     3993        BREAK by buf_cash-desk.pos-type:
     3994          if first-of(buf_cash-desk.pos-type) then do:
     3995            create buf_temp-cd.
     3996            buffer-copy buf_cash-desk to buf_temp-cd.
     3997          end.
     3998        end.
     3999     end.
     4000   end procedure.
     4001   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4002   FUNCTION name-2cdf returns character
     4003                      (  input p-name-2cd as character
     4004                       , input p-mode as logical
     4005                       , input p-cod-pcod as logical
     4006                       , input p-b-code  as integer
     4007                       , input p-gds-code as integer
     4008                       , input p-artic   as character
     4009                       , input p-engl-name  as character
     4010                       , input p-in-code as character
     4011                       , input p-part-code as character
     4012                       , input p-obj-type as character
     4013                       , input p-obj-code as integer
     4014                       , input p-alpha1 as character
     4015                       , output p-gtd as character
     4016                       ) :
     4017   define variable v-name-2cd as character no-undo .
     4018   define variable v-dop-alt-name as character no-undo.
     4019   define variable v-type as character no-undo.
     4020   define buffer buf_parts for ub.parts.
     4021   define buffer buf_code for ub.code.
     4022   if not p-mode and p-name-2cd = "PLU":U then do:
     4023     return "PLU кассы":U.
     4024   end.
     4025   if not p-mode then do:
     4026     if p-name-2cd <> "GTD":U
     4027     and  p-name-2cd <> "alpha1|gtd":U
     4028     then do:
     4029     assign
     4030     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4031   end.
     4032   end.
     4033   if p-part-code = "":U or p-cod-pcod = no then do:
     4034     run gdsoattr-value in this-procedure (
     4035       'dt-seasons':U,
     4036       p-gds-code,
     4037       p-obj-type,
     4038       p-obj-code,
     4039       output v-dop-alt-name,
     4040       output v-type
     4041     ) no-error.
     4042     if v-dop-alt-name <> "" then do:
     4043       find first buf_code where
     4044                  buf_code.parent = "DTSeasons"
     4045              and buf_code.code   = v-dop-alt-name
     4046            no-lock no-error.
     4047       if available buf_code then
     4048         assign
     4049           p-engl-name = ""
     4050           v-dop-alt-name =  buf_code.misc1
     4051         .
     4052     end.
     4053     else do:
     4054       run gdsoattr-value in this-procedure
     4055                           ( input  'dop-alt-name-o':U
     4056                            ,input  p-gds-code
     4057                            ,input  p-obj-type
     4058                            ,input  p-obj-code
     4059                            ,output v-dop-alt-name
     4060                            ,output v-type
     4061                           ) no-error .
     4062     end.
     4063     CASE p-name-2cd:
     4064       when "name" then do:
     4065         if p-mode then return p-engl-name + v-dop-alt-name.
     4066         return "Англ. название".
     4067       end.
     4068       when "code":U then do:
     4069         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4070         return "Лок. код товара"  .
     4071       end.
     4072       when "GTD":U
     4073       or
     4074       when "name-GTD":U
     4075       or
     4076       when "code-GTD":U
     4077       or
     4078       when "alpha1|gtd":U
     4079       or
     4080       when "name-alpha1|gtd":U
     4081       or
     4082       when "code-alpha1|gtd":U
     4083       then do:
     4084         if p-mode then do:
     4085           run gdcstcod_cst-code  in this-procedure (
     4086                                                       input  p-obj-type
     4087                                                       ,input  p-obj-code
     4088                                                       ,input  p-gds-code
     4089                                                       ,input  p-in-code
     4090                                                       ,input  p-part-code
     4091                                                       ,output p-gtd
     4092                                                       ) no-error .
     4093         end.
     4094         if p-name-2cd = "name-gtd":U then do:
     4095           if p-mode then return p-engl-name  + v-dop-alt-name.
     4096           return "Англ. название".
     4097         end.
     4098         if p-name-2cd = "name-alpha1|gtd":U then do:
     4099           if p-mode then return p-engl-name  + v-dop-alt-name.
     4100           return "Англ. название".
     4101         end.
     4102         if p-name-2cd = "code-GTD":U then do:
     4103           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4104           return "Лок. код товара"  .
     4105         end.
     4106         if p-name-2cd = "code-alpha1|gtd":U then do:
     4107           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4108           return "Лок. код товара"  .
     4109         end.
     4110         if p-mode then do:
     4111           if p-name-2cd = "GTD" then  return p-gtd.
     4112           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4113         end.
     4114         if p-name-2cd = "GTD" then  return "Код ГТД".
     4115         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4116       end.
     4117     END CASE.
     4118   end.
     4119   else do:
     4120     if p-name-2cd = "name-gtd":U
     4121     or p-name-2cd = "code-GTD":U
     4122     or p-name-2cd = "name-alpha1|GTD":U
     4123     or p-name-2cd = "code-alpha1|GTD":U
     4124     or p-name-2cd = "alpha1|GTD":U
     4125     then do:
     4126       if p-mode then do:
     4127         run gdcstcod_cst-code  in this-procedure (
     4128                                                      input  p-obj-type
     4129                                                     ,input  p-obj-code
     4130                                                     ,input  p-gds-code
     4131                                                     ,input  p-in-code
     4132                                                     ,input  p-part-code
     4133                                                     ,output p-gtd
     4134                                                     ) no-error .
     4135       end.
     4136       else do:
     4137         if p-name-2cd = "gtd":U then
     4138         p-gtd = "Код ГТД".
     4139         if p-name-2cd = "alpha1|Gtd":U then
     4140         p-gtd = "Страна|Код ГТД".
     4141       end.
     4142     end.
     4143     if p-mode then  return p-part-code.
     4144     return "Код партии".
     4145   end.
     4146   END FUNCTION.
     4147   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4148                                            ,input p-nam-2str as logical
     4149                                            ,input p-nam-artc as logical
     4150                                            ,input p-unit-cli-type as character
     4151                                            ,input p-unit-base as character
     4152                                            ,input p-unit-cli as character
     4153                                            ,input p-cli-base-rate as decimal
     4154                                            ,input p-artic as character
     4155                                            ,input p-f-name as character
     4156                                            ,input p-gds-name as character
     4157                                            ,input p-gds-name1 as character
     4158                                            ,output p-second-name as character):
     4159   define variable v-length as integer no-undo .
     4160   define variable nam-2str-shift as integer no-undo .
     4161   define variable chk_name as character no-undo .
     4162   assign
     4163   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4164   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4165   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4166               then 5
     4167               else v-length)
     4168   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4169   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4170   .
     4171   if p-nam-artc then do:
     4172     assign
     4173     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4174       .
     4175   end.
     4176   else  do:
     4177     assign
     4178     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4179     .
     4180   end.
     4181   if p-unit-base <> p-unit-cli then do:
     4182     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4183     assign
     4184     chk_name = string(substr(chk_name
     4185                               ,1
     4186                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4187                       "*":U +
     4188                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4189   end.
     4190   else do:
     4191     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4192   end.
     4193   if p-nam-2str then do:
     4194     assign
     4195     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4196     chk_name = substr(chk_name, 1, v-length)
     4197     .
     4198   end.
     4199   else do:
     4200     assign
     4201     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4202     p-second-name =   (chr(34) +
     4203                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4204                       + chr(34) )
     4205     .
     4206   end.
     4207   return chk_name.
     4208   end function.
     4209   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4210   procedure disrules-get-interface-form :
     4211   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4212   define output parameter p-form-name as character no-undo .
     4213   define buffer buf_temp-drt-prop for temp-drt-prop.
     4214   define buffer buf_drt-prop for ub.drt-prop.
     4215   find first buf_temp-drt-prop where
     4216             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4217         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4218         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4219   if not available buf_temp-drt-prop then do:
     4220     find first buf_drt-prop where
     4221               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4222           and buf_drt-prop.upper-prop-code = "InputForm"
     4223           and buf_drt-prop.prop-code = "FormName" no-error.
     4224     if available buf_drt-prop then do:
     4225       p-form-name = buf_drt-prop.property-value.
     4226     end.
     4227     else do:
     4228       p-form-name = "ref/dis-ruli.w".
     4229     end.
     4230   end.
     4231   else do:
     4232     p-form-name = buf_temp-drt-prop.property-value.
     4233   end.
     4234   end procedure.
