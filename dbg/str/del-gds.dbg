    14187                                       buffer for-cash-desk
    14188                                     , input out
    14189                                     , input fname
    14190                                     , input 0
    14191                                     , input no
    14192                                     , input yes
    14193                                     , input 6
    14194                                     , input 5000
    14195                                     , input v-plu
    14196                                     , input '000').
    14197       end.
    14198       else do:
