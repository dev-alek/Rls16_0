     1880   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1881   procedure cur-time :
     1882      define output parameter p-today as date      no-undo .
     1883      define output parameter p-time  as integer   no-undo .
     1884     do
     1885     on error undo, return error
     1886     :
     1887       define variable v-date1 as date      no-undo .
     1888       define variable v-date2 as date      no-undo .
     1889       define variable v-time  as integer   no-undo .
     1890       assign
     1891         v-date1 = today
     1892         v-time  = time
     1893         v-date2 = today
     1894       .
     1895       if v-date1 <> v-date2
     1896       then do:
     1897         assign
     1898           v-date1 = today
     1899           v-time  = v-time
     1900         .
     1901       end.
     1902       assign
     1903         p-today = v-date1
     1904         p-time  = v-time
     1905       .
     1906     end.
     1907   end.
     1908   function cur-time-date returns character
     1909   :
     1910     return string(today, '99/99/9999':U) .
     1911   end.
     1912   function cur-time-mjd returns decimal
     1913   :
     1914     define variable v-date as date      no-undo .
     1915     define variable v-time as integer   no-undo .
     1916     run cur-time in this-procedure
     1917       (output v-date
     1918       ,output v-time
     1919       ) .
     1920     return integer(v-date) - 2400002 + (v-time / 86400) .
     1921   end.
     1922   function cur-time-get-ending-index returns integer
     1923   (input p-number as integer
     1924   )
     1925   :
     1926     if p-number < 0
     1927     or p-number = ?
     1928     then do:
     1929       return 1 .
     1930     end.
     1931     define variable v-rest as integer   no-undo .
     1932     assign
     1933       p-number = p-number modulo 100
     1934     .
     1935     if p-number < 20
     1936     then do:
     1937       assign
     1938         v-rest = p-number
     1939       .
     1940     end.
     1941     else do:
     1942       assign
     1943         v-rest = p-number modulo 10
     1944       .
     1945     end.
     1946     case v-rest :
     1947       when 1
     1948       then do:
     1949         return 2 .
     1950       end.
     1951       when 2 or
     1952       when 3 or
     1953       when 4
     1954       then do:
     1955         return 3 .
     1956       end.
     1957       otherwise do:
     1958         return 1 .
     1959       end.
     1960     end case .
     1961   end.
     1962   procedure cur-time-mjd-to-date :
     1963      define input  parameter i-mjd-diff as decimal no-undo.
     1964      define output parameter o-Date     as date    no-undo.
     1965      define output parameter o-Time     as integer no-undo.
     1966      define variable v-day-number as integer   no-undo .
     1967      if    i-mjd-diff < 0
     1968         or i-mjd-diff = ?
     1969      then do:
     1970         return "?" .
     1971      end.
     1972      assign
     1973         v-day-number = truncate(i-mjd-diff,0).
     1974         o-Date = date(v-day-number + 2400002).
     1975         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1976     .
     1977   end.
     1978   function cur-time-mjd-to-string returns character
     1979   (input p-mjd-diff as decimal
     1980   )
     1981   :
     1982     define variable v-day-number as integer   no-undo .
     1983     define variable v-seconds    as integer   no-undo .
     1984     define variable v-hour       as integer   no-undo .
     1985     define variable v-min        as integer   no-undo .
     1986     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1987     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1988     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1989     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1990     if p-mjd-diff < 0
     1991     or p-mjd-diff = ?
     1992     then do:
     1993       return "?" .
     1994     end.
     1995     assign
     1996       v-day-number = integer(truncate(p-mjd-diff,0))
     1997       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1998     .
     1999     if v-seconds > 86400
     2000     then do:
     2001       assign
     2002         v-seconds = 86400 - 1
     2003       .
     2004     end.
     2005     if v-seconds < 0
     2006     then do:
     2007       assign
     2008         v-seconds = 0
     2009       .
     2010     end.
     2011     assign
     2012       v-hour = truncate(v-seconds / 3600, 0)
     2013     .
     2014     assign
     2015       v-seconds = v-seconds modulo 3600
     2016     .
     2017     assign
     2018       v-min = truncate(v-seconds / 60, 0)
     2019     .
     2020     assign
     2021       v-seconds = v-seconds modulo 60
     2022     .
     2023     return
     2024         (if v-day-number <> 0
     2025           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2026           else ""
     2027         )
     2028       + (if v-day-number <> 0 or v-hour <> 0
     2029           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2030           else ""
     2031         )
     2032       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2033           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2034           else ""
     2035         )
     2036       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2037       .
     2038   end.
     2039   function cur-time-string returns character
     2040   :
     2041     define variable v-date as date      no-undo .
     2042     define variable v-time as integer   no-undo .
     2043     run cur-time in this-procedure
     2044       (output v-date
     2045       ,output v-time
     2046       ) .
     2047     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2048   end.
     2049   function cur-time-string-sec returns character
     2050   :
     2051     define variable v-date as date      no-undo .
     2052     define variable v-time as integer   no-undo .
     2053     run cur-time in this-procedure
     2054       (output v-date
     2055       ,output v-time
     2056       ) .
     2057     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2058   end.
     2059   function cur-time-custom  returns character
     2060   (input p-prefix as character
     2061   ,input p-date-format as character
     2062   ,input p-delimiter as character
     2063   ,input p-time-format as character
     2064   ,input p-suffix as character
     2065   )
     2066   :
     2067     define variable v-date as date      no-undo .
     2068     define variable v-time as integer   no-undo .
     2069     run cur-time in this-procedure
     2070       (output v-date
     2071       ,output v-time
     2072       ) .
     2073     return
     2074       p-prefix
     2075       + string(v-date, p-date-format)
     2076       + p-delimiter
     2077       + string(v-time, p-time-format)
     2078       + p-suffix
     2079       .
     2080   end.
     2081   function cur-time-print  returns character
     2082   :
     2083     define variable v-date as date      no-undo .
     2084     define variable v-time as integer   no-undo .
     2085     run cur-time in this-procedure
     2086       (output v-date
     2087       ,output v-time
     2088       ) .
     2089     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2090   end.
     2091   function cur-time-datetime returns datetime
     2092   :
     2093     define variable v-char as character no-undo .
     2094     define variable v-datetime as datetime no-undo .
     2095     v-char = cur-time-string().
     2096     v-datetime = datetime(v-char).
     2097     return  v-datetime.
     2098   end.
     2099   function cur-time-string-msec returns character
     2100   :
     2101     define variable v-date as datetime  no-undo .
     2102     v-date = now.
     2103     return string(v-date) .
     2104   end.
     2105   define variable vss-include-info27 as character format "X(65)" no-undo
     2106   initial "@(#)$Workfile$ $Revision$".
     2107   procedure xmlchar-test :
     2108   define input parameter p-in-string          as character        no-undo.
     2109   define output parameter p-out-string-enc    as character        no-undo.
     2110   define output parameter p-out-string-dec    as character        no-undo.
     2111   do
     2112   on error undo, return error
     2113   :
     2114          run xmlchar-encode in this-procedure
     2115       (
     2116             input p-in-string
     2117           , output p-out-string-enc
     2118       ).
     2119          run xmlchar-decode in this-procedure
     2120       (
     2121             input p-out-string-enc
     2122           , output p-out-string-dec
     2123       ).
     2124   end.
     2125   end .
     2126   procedure xmlchar-encode :
     2127   define input parameter p-in-string      as character        no-undo.
     2128   define output parameter p-out-string    as character        no-undo.
     2129       define variable v-position      as integer      no-undo.
     2130       define variable v-current-char  as character    no-undo.
     2131   do
     2132   on error undo, return error
     2133   :
     2134       assign
     2135           p-out-string = "":U
     2136       .
     2137       case p-in-string
     2138       :
     2139           when ?
     2140           then do:
     2141               assign
     2142                   p-out-string = "?":U
     2143               .
     2144           end.
     2145           when "?":U
     2146           then do:
     2147               assign
     2148                   p-out-string = "&#63;":U
     2149               .
     2150           end.
     2151           otherwise do:
     2152               do v-position = 1 to length( p-in-string )
     2153               :
     2154                   assign
     2155                       v-current-char = substring( p-in-string, v-position, 1 )
     2156                   .
     2157                   case v-current-char
     2158                   :
     2159                       when "&":U
     2160                       then do:
     2161                           assign
     2162                               p-out-string = p-out-string + "&amp;":U
     2163                           .
     2164                       end.
     2165                       when ">":U
     2166                       then do:
     2167                           assign
     2168                               p-out-string = p-out-string + "&gt;":U
     2169                           .
     2170                       end.
     2171                       when "<":U
     2172                       then do:
     2173                           assign
     2174                               p-out-string = p-out-string + "&lt;":U
     2175                           .
     2176                       end.
     2177                       when "'":U
     2178                       then do:
     2179                           assign
     2180                               p-out-string = p-out-string + "&apos;":U
     2181                           .
     2182                       end.
     2183                       when '"':U
     2184                       then do:
     2185                           assign
     2186                               p-out-string = p-out-string + "&quot;":U
     2187                           .
     2188                       end.
     2189                       when chr(1)
     2190                       then do:
     2191                           assign
     2192                               p-out-string = p-out-string + "":U
     2193                           .
     2194                       end.
     2195                       when chr(2)
     2196                       then do:
     2197                           assign
     2198                               p-out-string = p-out-string + "":U
     2199                           .
     2200                       end.
     2201                       when chr(3)
     2202                       then do:
     2203                           assign
     2204                               p-out-string = p-out-string + "":U
     2205                           .
     2206                       end.
     2207                       when chr(4)
     2208                       then do:
     2209                           assign
     2210                               p-out-string = p-out-string + "":U
     2211                           .
     2212                       end.
     2213                       when chr(5)
     2214                       then do:
     2215                           assign
     2216                               p-out-string = p-out-string + "":U
     2217                           .
     2218                       end.
     2219                       when chr(6)
     2220                       then do:
     2221                           assign
     2222                               p-out-string = p-out-string + "":U
     2223                           .
     2224                       end.
     2225                       when chr(7)
     2226                       then do:
     2227                           assign
     2228                               p-out-string = p-out-string + "":U
     2229                           .
     2230                       end.
     2231                       when chr(8)
     2232                       then do:
     2233                           assign
     2234                               p-out-string = p-out-string + "":U
     2235                           .
     2236                       end.
     2237                       when chr(9)
     2238                       then do:
     2239                           assign
     2240                               p-out-string = p-out-string + "":U
     2241                           .
     2242                       end.
     2243                       when chr(29)
     2244                       then do:
     2245                           assign
     2246                               p-out-string = p-out-string + "":U
     2247                           .
     2248                       end.
     2249                       when chr(10)
     2250                       then do:
     2251                           assign
     2252                               p-out-string = p-out-string + "&#10;":U
     2253                           .
     2254                       end.
     2255                       when chr(13)
     2256                       then do:
     2257                           assign
     2258                               p-out-string = p-out-string + "&#13;":U
     2259                           .
     2260                       end.
     2261                       otherwise do:
     2262                           assign
     2263                               p-out-string = p-out-string + v-current-char
     2264                           .
     2265                       end.
     2266                   end case.
     2267               end.
     2268           end.
     2269       end case.
     2270   end.
     2271   end .
     2272   procedure xmlchar-encode-1c :
     2273   define input parameter p-in-string      as character        no-undo.
     2274   define output parameter p-out-string    as character        no-undo.
     2275       define variable v-position      as integer      no-undo.
     2276       define variable v-current-char  as character    no-undo.
     2277   do
     2278   on error undo, return error
     2279   :
     2280       assign
     2281           p-out-string = "":U
     2282       .
     2283       case p-in-string
     2284       :
     2285           when ?
     2286           then do:
     2287               assign
     2288                   p-out-string = "?":U
     2289               .
     2290           end.
     2291           otherwise do:
     2292               do v-position = 1 to length( p-in-string )
     2293               :
     2294                   assign
     2295                       v-current-char = substring( p-in-string, v-position, 1 )
     2296                   .
     2297                   case v-current-char
     2298                   :
     2299                       when chr(1)
     2300                       then do:
     2301                           assign
     2302                               p-out-string = p-out-string + " ":U
     2303                           .
     2304                       end.
     2305                       when chr(2)
     2306                       then do:
     2307                           assign
     2308                               p-out-string = p-out-string + " ":U
     2309                           .
     2310                       end.
     2311                       when chr(3)
     2312                       then do:
     2313                           assign
     2314                               p-out-string = p-out-string + " ":U
     2315                           .
     2316                       end.
     2317                       when chr(4)
     2318                       then do:
     2319                           assign
     2320                               p-out-string = p-out-string + " ":U
     2321                           .
     2322                       end.
     2323                       when chr(5)
     2324                       then do:
     2325                           assign
     2326                               p-out-string = p-out-string + " ":U
     2327                           .
     2328                       end.
     2329                       when chr(6)
     2330                       then do:
     2331                           assign
     2332                               p-out-string = p-out-string + " ":U
     2333                           .
     2334                       end.
     2335                       when chr(7)
     2336                       then do:
     2337                           assign
     2338                               p-out-string = p-out-string + " ":U
     2339                           .
     2340                       end.
     2341                       when chr(8)
     2342                       then do:
     2343                           assign
     2344                               p-out-string = p-out-string + " ":U
     2345                           .
     2346                       end.
     2347                       when chr(9)
     2348                       then do:
     2349                           assign
     2350                               p-out-string = p-out-string + " ":U
     2351                           .
     2352                       end.
     2353                       when chr(29)
     2354                       then do:
     2355                           assign
     2356                               p-out-string = p-out-string + " ":U
     2357                           .
     2358                       end.
     2359                       when chr(10)
     2360                       then do:
     2361                           assign
     2362                               p-out-string = p-out-string + " ":U
     2363                           .
     2364                       end.
     2365                       when chr(13)
     2366                       then do:
     2367                           assign
     2368                               p-out-string = p-out-string + " ":U
     2369                           .
     2370                       end.
     2371                       otherwise do:
     2372                           assign
     2373                               p-out-string = p-out-string + v-current-char
     2374                           .
     2375                       end.
     2376                   end case.
     2377               end.
     2378           end.
     2379       end case.
     2380   end.
     2381   end .
     2382   procedure xmlchar-decode :
     2383   define input parameter p-in-string      as character        no-undo.
     2384   define output parameter p-out-string    as character        no-undo.
     2385       define variable v-position      as integer      no-undo.
     2386       define variable v-last-position as integer      no-undo.
     2387       define variable v-temp-integer  as integer      no-undo.
     2388       define variable v-current-char  as character    no-undo.
     2389       define variable v-next-char     as character    no-undo.
     2390       define variable v-success       as logical      no-undo.
     2391   do
     2392   on error undo, return error
     2393   :
     2394       assign
     2395           p-out-string = "":U
     2396           v-position   = 0
     2397       .
     2398       replace-cycle:
     2399       do while yes
     2400       on error undo, return error
     2401       :
     2402           assign
     2403               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2404           .
     2405           if v-last-position <= v-position
     2406           then do:
     2407               if v-position = 0
     2408               then do:
     2409                   assign
     2410                       p-out-string = p-in-string
     2411                   .
     2412               end.
     2413               else do:
     2414                   assign
     2415                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2416                   .
     2417               end.
     2418               leave replace-cycle.
     2419           end.
     2420           else do:
     2421               assign
     2422                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2423                   v-position      = v-last-position
     2424                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2425               .
     2426               if v-current-char = "#":U
     2427               then do:
     2428                   assign
     2429                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2430                   .
     2431                   if v-last-position > 0
     2432                   then do:
     2433                       run xmlchar-read-integer in this-procedure
     2434                        (
     2435                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2436                           , output v-temp-integer
     2437                           , output v-success
     2438                       ).
     2439                       if v-success = yes
     2440                       and v-temp-integer >= 1
     2441                       and v-temp-integer <= 255
     2442                       then do:
     2443                           assign
     2444                               p-out-string = p-out-string + chr( v-temp-integer )
     2445                               v-position   = v-last-position + 1
     2446                           .
     2447                       end.
     2448                       else do:
     2449                           assign
     2450                               p-out-string = p-out-string + "&":U
     2451                               v-position   = v-position   + 1
     2452                           .
     2453                       end.
     2454                   end.
     2455                   else do:
     2456                       assign
     2457                           p-out-string = p-out-string + "&":U
     2458                           v-position   = v-position   + 1
     2459                       .
     2460                   end.
     2461               end.
     2462               else do:
     2463                   case substring( p-in-string, v-position + 1, 3 )
     2464                   :
     2465                       when "lt;":U
     2466                       then do:
     2467                           assign
     2468                               p-out-string = p-out-string + "<":U
     2469                               v-position   = v-position   + 3
     2470                           .
     2471                       end.
     2472                       when "gt;":U
     2473                       then do:
     2474                           assign
     2475                               p-out-string = p-out-string + ">":U
     2476                               v-position   = v-position   + 3
     2477                           .
     2478                       end.
     2479                       otherwise do:
     2480                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2481                           then do:
     2482                               assign
     2483                                   p-out-string = p-out-string + "&":U
     2484                                   v-position   = v-position   + 4
     2485                               .
     2486                           end.
     2487                           else do:
     2488                               case substring( p-in-string, v-position + 1, 5 )
     2489                               :
     2490                                   when "quot;":U
     2491                                   then do:
     2492                                       assign
     2493                                           p-out-string = p-out-string + '"':U
     2494                                           v-position   = v-position   + 5
     2495                                       .
     2496                                   end.
     2497                                   when "apos;":U
     2498                                   then do:
     2499                                       assign
     2500                                           p-out-string = p-out-string + "'":U
     2501                                           v-position   = v-position   + 5
     2502                                       .
     2503                                   end.
     2504                                   otherwise do:
     2505                                       assign
     2506                                           p-out-string = p-out-string + "&":U
     2507                                       .
     2508                                   end.
     2509                               end case.
     2510                           end.
     2511                       end.
     2512                   end case.
     2513               end.
     2514           end.
     2515       end.
     2516   end.
     2517   end .
     2518   procedure xmlchar-read-integer :
     2519   define input parameter p-input-string      as character        no-undo.
     2520   define output parameter p-output-integer   as integer          no-undo.
     2521   define output parameter p-success       as logical          no-undo.
     2522   do
     2523   on error undo, return error
     2524   :
     2525       assign
     2526           p-output-integer = integer( p-input-string )
     2527       no-error.
     2528       if error-status :error
     2529       then do:
     2530           assign
     2531               p-success           = no
     2532               p-output-integer    = 0
     2533           .
     2534       end.
     2535       else do:
     2536           assign
     2537               p-success           = yes
     2538           .
     2539       end.
     2540   end.
     2541   end.
     2542   define variable v-bgelib-bgeclall           as logical      no-undo.
     2543   define variable v-bgelib-bgedict            as logical      no-undo.
     2544   define temp-table temp_ext-doc-type no-undo
     2545       field edt-key               as integer
     2546       field ext-doc-type          as character
     2547       field ext-doc-type-label    as character
     2548       index pi is primary unique
     2549           edt-key
     2550   .
     2551   define temp-table temp_bgelib_goods no-undo
     2552       field gds-code as integer
     2553       index pi is primary unique
     2554           gds-code
     2555   .
     2556   define temp-table temp_bgelib_clients no-undo
     2557       field obj-type as character
     2558       field obj-code as integer
     2559       index pi is primary unique
     2560           obj-type
     2561           obj-code
     2562   .
     2563   define temp-table temp_bgelib_dis-card no-undo
     2564       field d-card as character
     2565       index pi is primary unique
     2566           d-card
     2567   .
     2568   define temp-table temp_bgelib_trn-doc no-undo
     2569       field doc-code as integer
     2570   .
     2571   procedure bgelib-tag-open:
     2572   do
     2573   on error undo, return error
     2574   :
     2575   define input parameter v-tag-level  as integer      no-undo.
     2576   define input parameter v-tag-name   as character    no-undo.
     2577   define input parameter v-tag-value  as character    no-undo.
     2578       put stream stmXMLOut unformatted
     2579           chr(10)
     2580           + fill(" ", 4 * v-tag-level)
     2581           + "<" + v-tag-name
     2582           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2583           + v-tag-value + ">"
     2584       .
     2585   end.
     2586   end procedure.
     2587   procedure bgelib-tag-put:
     2588   do
     2589   on error undo, return error
     2590   :
     2591   define input parameter v-tag-level      as integer      no-undo.
     2592   define input parameter v-tag-name       as character    no-undo.
     2593   define input parameter v-tag-value      as character    no-undo.
     2594   define input parameter v-empty-mode     as integer      no-undo.
     2595       v-tag-name = trim(v-tag-name).
     2596       if  v-empty-mode = 1
     2597       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2598       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2599       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2600       then do:
     2601           run xmlchar-encode in this-procedure (
     2602                 input v-tag-value
     2603               , output v-tag-value
     2604           ).
     2605           put stream stmXMLOut unformatted
     2606               chr(10) + fill(" ", 4 * v-tag-level)
     2607                           + '<' + v-tag-name + '>'
     2608                           + v-tag-value
     2609                           + '</' + v-tag-name + '>'
     2610           .
     2611       end.
     2612   end.
     2613   end procedure.
     2614   procedure bgelib-tag-close:
     2615   do
     2616   on error undo, return error
     2617   :
     2618   define input parameter v-tag-level as integer      no-undo.
     2619   define input parameter v-tag-name  as character    no-undo.
     2620       put stream stmXMLOut unformatted
     2621           chr(10)
     2622           + fill( " ", 4 * v-tag-level)
     2623           + '</' + v-tag-name + '>'
     2624       .
     2625   end.
     2626   end procedure.
     2627   procedure bgelib-write-log:
     2628   do
     2629   on error undo, return error
     2630   :
     2631   define input parameter v-filename   as character    no-undo.
     2632   define input parameter v-log-level  as integer      no-undo.
     2633   define input parameter v-out-string as character    no-undo.
     2634       output stream stmXMLLog to value( v-filename ) append.
     2635       put stream stmXMLLog unformatted
     2636           chr(10)
     2637       .
     2638       put stream stmXMLLog unformatted
     2639           ( if v-log-level = 0
     2640             or v-out-string = "&DLine"
     2641             or v-out-string = "&Line"
     2642             then ""
     2643             else cur-time-string-sec() + " " )
     2644       .
     2645       put stream stmXMLLog unformatted
     2646           ( if v-out-string = "&Line"
     2647             then fill( "-", 80 )
     2648             else if v-out-string = "&DLine"
     2649                  then fill( "=", 80 )
     2650                  else v-out-string )
     2651       .
     2652       output stream stmXMLLog close.
     2653   end.
     2654   end procedure.
     2655   procedure bgelib-write-edt:
     2656   do
     2657   on error undo, return error
     2658   :
     2659   define input parameter v-editor-handle    as handle       no-undo.
     2660   define input parameter v-log-level        as integer      no-undo.
     2661   define input parameter v-out-string       as character    no-undo.
     2662       if valid-handle ( v-editor-handle )
     2663       then do:
     2664           v-editor-handle :move-to-eof().
     2665           v-editor-handle :insert-string( ( if v-log-level = 0
     2666                                             or v-out-string = "&DLine"
     2667                                             or v-out-string = "&Line"
     2668                                             then ""
     2669                                             else cur-time-string-sec() + " "
     2670                                         ) ).
     2671           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2672                                             then fill( "-", 80 )
     2673                                             else if v-out-string = "&DLine" then fill("=", 80)
     2674                                             else fill( " ", v-log-level) + v-out-string
     2675                                         ) ).
     2676           v-editor-handle :insert-string( chr(10) ).
     2677       end.
     2678       process events.
     2679       output to 'bgescn.txt' append.
     2680           put unformatted
     2681               chr(10)
     2682               string( ( if v-log-level = 0
     2683                         or v-out-string = "&DLine"
     2684                         or v-out-string = "&Line"
     2685                         then ""
     2686                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2687                     ) )
     2688               string( ( if v-out-string = "&Line"
     2689                         then fill( "-", 80 )
     2690                         else if v-out-string = "&DLine"
     2691                              then fill( "=", 80 )
     2692                              else fill( " ", v-log-level ) + v-out-string
     2693                     ) )
     2694           .
     2695       output close.
     2696   end.
     2697   end procedure.
     2698   procedure bgelib-show-cnt:
     2699   do
     2700   on error undo, return error
     2701   :
     2702   define input parameter v-fillin-handle     as handle   no-undo.
     2703       if valid-handle( v-fillin-handle )
     2704       then do:
     2705           assign
     2706               v-fillin-handle :visible = true
     2707           .
     2708       end.
     2709   end.
     2710   end procedure.
     2711   procedure bgelib-hide-cnt:
     2712   do
     2713   on error undo, return error
     2714   :
     2715   define input parameter v-fillin-handle     as handle   no-undo.
     2716       if valid-handle( v-fillin-handle )
     2717       then do:
     2718           assign v-fillin-handle :visible = false.
     2719       end.
     2720   end.
     2721   end procedure.
     2722   procedure bgelib-write-cnt:
     2723   do
     2724   on error undo, return error
     2725   :
     2726   define input parameter v-fillin-handle    as handle       no-undo.
     2727   define input parameter v-fillin-string    as character    no-undo.
     2728       if valid-handle( v-fillin-handle )
     2729       then do:
     2730           assign
     2731               v-fillin-handle :SCREEN-value = v-fillin-string
     2732           .
     2733       end.
     2734   end.
     2735   end procedure.
     2736   procedure bgelib-write-header:
     2737   do
     2738   on error undo, return error
     2739   :
     2740   define input parameter p-first-file     as logical      no-undo.
     2741   define input parameter p-xml-file-name  as character    no-undo.
     2742   define input parameter p-list-file-name as character    no-undo.
     2743   define input parameter p-file-number    as integer      no-undo.
     2744   define input parameter p-have-prev      as logical      no-undo.
     2745   define input parameter p-prev-filename  as character    no-undo.
     2746   define input parameter p-obj-list       as character    no-undo.
     2747   define input parameter p-doc-type-list  as character    no-undo.
     2748   define input parameter p-parameter-list as character    no-undo.
     2749       define variable v-counter    as integer        no-undo.
     2750       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2751       put stream stmXMLOut unformatted
     2752           "<?xml version='1.0' encoding='windows-1251'?>"
     2753       .
     2754       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2755       run bgelib-tag-open( input 0, input "header", input "" ).
     2756       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2757       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2758       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2759       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2760       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2761       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2762       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2763       :
     2764           run bgelib-tag-put(
     2765                 input 1
     2766               , input entry( 2 * v-counter, p-parameter-list )
     2767               , input entry( 2 * v-counter + 1, p-parameter-list )
     2768               , input 0
     2769           ).
     2770       end.
     2771       run bgelib-tag-close( input 0, input "header" ).
     2772       output stream stmXMLOut close.
     2773       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2774       if p-first-file = yes
     2775       then do:
     2776           put stream stmXMLOut unformatted
     2777               "<?xml version='1.0' encoding='windows-1251'?>"
     2778           .
     2779           run bgelib-tag-open( input 0, input "export", input "" ).
     2780       end.
     2781       run bgelib-tag-open( input 1, input "file", input "" ).
     2782       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2783       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2784       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2785       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2786       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2787       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2788       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2789       :
     2790           run bgelib-tag-put(
     2791                 input 2
     2792               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2793               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2794               , input 0
     2795           ).
     2796       end.
     2797       run bgelib-tag-close( input 1, input "file" ).
     2798       output stream stmXMLOut close.
     2799   end.
     2800   end procedure.
     2801   procedure bgelib-write-footer:
     2802   do
     2803   on error undo, return error
     2804   :
     2805   define input parameter p-last-file      as logical      no-undo.
     2806   define input parameter p-xml-file-name  as character    no-undo.
     2807   define input parameter p-list-file-name as character    no-undo.
     2808   define input parameter p-have-next      as logical      no-undo.
     2809   define input parameter p-next-file-name as character    no-undo.
     2810       define variable v-error-num     as integer           no-undo.
     2811       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2812       if p-have-next = yes
     2813       then do:
     2814           run bgelib-tag-open( input 0, input "footer", "" ).
     2815           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2816           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2817           run bgelib-tag-close( input 0, input "footer" ).
     2818       end.
     2819       run bgelib-tag-close( input 0, input "root" ).
     2820       output stream stmXMLOut close.
     2821       run bge/os_copy.p (
     2822             input "M"
     2823           , input p-xml-file-name + "tmp"
     2824           , input p-xml-file-name + "xml"
     2825           , output v-error-num
     2826       ).
     2827       if p-last-file = yes
     2828       then do:
     2829           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2830               run bgelib-tag-close( input 0, input "export" ).
     2831           output stream stmXMLOut close.
     2832           run bge/os_copy.p (
     2833                 input "M"
     2834               , input p-list-file-name + "tmp"
     2835               , input p-list-file-name + "xml"
     2836               , output v-error-num
     2837           ).
     2838       end.
     2839   end.
     2840   end procedure.
     2841   procedure bgelib-filename :
     2842   do
     2843   on error undo, return error
     2844   :
     2845   define input parameter p-prefix             as character    no-undo.
     2846   define output parameter p-xml-file-name     as character    no-undo.
     2847   define output parameter p-log-file-name     as character    no-undo.
     2848   define output parameter p-list-file-name    as character    no-undo.
     2849       define variable v-home-dir  as character    no-undo.
     2850       define variable v-error-num as integer      no-undo.
     2851       get-key-value section "BGE" key "outdir" value v-home-dir.
     2852       if v-home-dir = ?
     2853       then do:
     2854           message
     2855             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2856             skip(1)
     2857             skip "Обратитесь к администратору."
     2858           view-as alert-box error.
     2859           undo, return error .
     2860       end.
     2861       run gbl/dir-cre.p (
     2862           input v-home-dir
     2863       ) no-error.
     2864       if error-status :error
     2865       then do:
     2866           message
     2867             skip "Неверно задан каталог экспорта."
     2868             skip(1)
     2869             skip "Обратитесь к администратору."
     2870           view-as alert-box error.
     2871           undo, return error .
     2872       end.
     2873       run bge/genfname.p (
     2874             input v-home-dir
     2875           , input p-prefix
     2876           , input ""
     2877           , input "xml"
     2878           , input "tmp"
     2879           , output p-xml-file-name
     2880       ).
     2881       assign
     2882           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2883           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2884           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2885       .
     2886   end.
     2887   end procedure.
     2888   procedure bgelib-read-config :
     2889   do
     2890   on error undo, return error
     2891   :
     2892   define variable v-par-type as character     no-undo.
     2893     define variable v-param-type      as character  no-undo .
     2894     define variable v-value-character as character  no-undo .
     2895     define variable v-value-date      as date       no-undo .
     2896     define variable v-value-decimal   as decimal    no-undo .
     2897     define variable v-value-integer   as integer    no-undo .
     2898     define variable v-value-logical   as logical    no-undo .
     2899     define variable v-tth             as handle     no-undo .
     2900       assign
     2901           v-bgelib-bgeclall = no
     2902           v-bgelib-bgedict  = no
     2903       .
     2904       run adm/shattri.p ( input "get":U
     2905                         , input  '':u
     2906                         , input  0
     2907                         , input  'bge-export':U
     2908                         , input  'bgeclall':U
     2909                         , output v-value-character
     2910                         , output v-value-date
     2911                         , output v-value-decimal
     2912                         , output v-value-integer
     2913                         , output v-value-logical
     2914                         , output v-param-type
     2915                         , input-output table-handle v-tth
     2916                         ) no-error .
     2917       if error-status :error
     2918       then do:
     2919         assign
     2920           v-bgelib-bgeclall = no
     2921         .
     2922       end.
     2923       else do:
     2924         assign
     2925           v-bgelib-bgeclall = v-value-logical
     2926         .
     2927       end.
     2928       delete object v-tth.
     2929       run adm/shattri.p ( input "get":U
     2930                         , input  '':u
     2931                         , input  0
     2932                         , input  'bge-export':U
     2933                         , input  'bgedict':U
     2934                         , output v-value-character
     2935                         , output v-value-date
     2936                         , output v-value-decimal
     2937                         , output v-value-integer
     2938                         , output v-value-logical
     2939                         , output v-param-type
     2940                         , input-output table-handle v-tth
     2941                         ) no-error .
     2942       if error-status :error
     2943       then do:
     2944         assign
     2945           v-bgelib-bgedict = no
     2946         .
     2947       end.
     2948       else do:
     2949         assign
     2950           v-bgelib-bgedict = v-value-logical
     2951         .
     2952       end.
     2953       delete object v-tth.
     2954       run adm/shattri.p ( input "get":U
     2955                         , input  '':u
     2956                         , input  0
     2957                         , input  'bge-export':U
     2958                         , input  'bgefmt':U
     2959                         , output v-value-character
     2960                         , output v-value-date
     2961                         , output v-value-decimal
     2962                         , output v-value-integer
     2963                         , output v-value-logical
     2964                         , output v-param-type
     2965                         , input-output table-handle v-tth
     2966                         ) no-error .
     2967       if error-status :error
     2968       then do:
     2969         assign
     2970           v-bgelib-bgefmt  = "xml":U
     2971         .
     2972       end.
     2973       else do:
     2974         assign
     2975           v-bgelib-bgefmt  = v-value-character
     2976         .
     2977       end.
     2978       delete object v-tth.
     2979       run adm/shattri.p ( input "get":U
     2980                         , input  '':u
     2981                         , input  0
     2982                         , input  'bge-export':U
     2983                         , input  'bgeflold':U
     2984                         , output v-value-character
     2985                         , output v-value-date
     2986                         , output v-value-decimal
     2987                         , output v-value-integer
     2988                         , output v-value-logical
     2989                         , output v-param-type
     2990                         , input-output table-handle v-tth
     2991                         ) no-error .
     2992       if error-status :error
     2993       then do:
     2994         assign
     2995           v-bgelib-bgeflold  = "old":U
     2996         .
     2997       end.
     2998       else do:
     2999         assign
     3000           v-bgelib-bgeflold  = v-value-character
     3001         .
     3002       end.
     3003       delete object v-tth.
     3004   end.
     3005   end procedure.
     3006   procedure bgelib-check-file-size :
     3007   do
     3008   on error undo, return error
     3009   :
     3010   define input parameter p-out-filename   as character    no-undo.
     3011   define output parameter p-is-big        as logical      no-undo.
     3012       define variable v-current-position    as integer        no-undo.
     3013       assign
     3014           v-current-position = seek( stmXMLOut )
     3015       .
     3016       if v-current-position / 1024 / 1024  >= 100
     3017       then do:
     3018           assign
     3019               p-is-big = yes
     3020           .
     3021       end.
     3022   end.
     3023   end procedure.
     3024   procedure bgelib-init-ext-doc-type :
     3025       define variable v-counter    as integer      no-undo.
     3026       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3027   do
     3028   for buf_temp_ext-doc-type
     3029   on error undo, return error
     3030   :
     3031       empty temp-table buf_temp_ext-doc-type.
     3032       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3033       :
     3034           create buf_temp_ext-doc-type.
     3035           assign
     3036               buf_temp_ext-doc-type.edt-key               = v-counter
     3037               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3038               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3039           .
     3040       end.
     3041   end.
     3042   end procedure.
     3043   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3044   define variable v-xml-file-name     as character            no-undo.
     3045   define variable v-xml-file-name-path as character            no-undo.
     3046   define variable v-log-file-name     as character            no-undo.
     3047   define variable v-locked            as logical              no-undo.
     3048   define variable v-log-string        as character            no-undo.
     3049   define variable v-oper-num          as integer              no-undo.
     3050   define variable v-obj-list          as character            no-undo.
     3051   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3052   DEF VAR intRep      AS INT NO-UNDO.
     3053   define variable hEDT             AS HANDLE NO-UNDO.
     3054   define variable hCNT             AS HANDLE NO-UNDO.
     3055   procedure xml-cd-write-header:
     3056   do
     3057   on error undo, return error
     3058   :
     3059   define input parameter p-xml-file-name       as character    no-undo.
     3060   define input parameter p-xml-file-name-path  as character    no-undo.
     3061   define input parameter p-doc-name            as character    no-undo.
     3062   define input parameter p-version             as character    no-undo.
     3063   define input parameter p-obj-list            as character    no-undo.
     3064   define input parameter p-correspondent       as character    no-undo .
     3065   define input parameter p-write-header        as logical      no-undo .
     3066   define variable OS-time as character no-undo .
     3067   define variable id as character no-undo .
     3068   define buffer buf_db for ub.db.
     3069   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3070   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3071   assign
     3072   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3073   .
     3074   run bgelib-tag-open in this-procedure (
     3075                                        1
     3076                                       ,p-doc-name
     3077                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3078                                         ).
     3079   if p-write-header then do:
     3080     run bgelib-tag-open(2, "Header","").
     3081     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3082     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3083     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3084     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3085     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3086     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3087     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3088     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3089     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3090     run bgelib-tag-close( 2, "Header" ).
     3091   end.
     3092   output stream stmXMLOut close.
     3093   end.
     3094   end procedure.
     3095   procedure xml-cd-write-footer:
     3096   do
     3097   on error undo, return error
     3098   :
     3099   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3100   define input parameter p-xml-file-name as character    no-undo.
     3101   define input parameter p-doc-name      as character    no-undo .
     3102   define variable v-error-num     as integer           no-undo.
     3103   define variable v-md5-signature as character no-undo .
     3104   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3105   run bgelib-tag-close( 0, p-doc-name ).
     3106   put stream stmXMLOut unformatted skip.
     3107   output stream stmXMLOut close.
     3108   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3109   if v-error-num > 0
     3110   then do:
     3111      return error.
     3112   end.
     3113   if opsys = "unix"
     3114   then do:
     3115       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3116   end.
     3117   end.
     3118   end procedure.
     3119   procedure xml-cd-filename :
     3120   do
     3121   on error undo, return error
     3122   :
     3123   define input parameter  p-out               as character no-undo .
     3124   define output parameter p-xml-file-name     as character    no-undo.
     3125   define output parameter p-xml-file-name-path   as character    no-undo.
     3126   define output parameter p-log-file-name     as character    no-undo.
     3127   define output parameter p-locked            as logical      no-undo.
     3128   define variable v-out as character     no-undo.
     3129   define variable loc#log as logical no-undo .
     3130   define variable BadFlag as logical no-undo .
     3131   define variable fq as integer no-undo .
     3132   define variable v-remote as character no-undo .
     3133   assign
     3134   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3135   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3136   p-log-file-name = p-out + "actions.log"
     3137   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3138   .
     3139   end.
     3140   end procedure.
     3141   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3142   define variable v-date-str as character no-undo .
     3143   assign
     3144   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3145                string(Month(p-date), "99":U) + "-":U +
     3146                string(DAY(p-date), "99":U).
     3147   return v-date-str.
     3148   END FUNCTION.
     3149   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3150   define variable v-date-str as character no-undo .
     3151   assign
     3152   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3153                string(Month(p-date), "99":U) + "-":U +
     3154                string(DAY(p-date), "99":U) + chr(32) +
     3155                string(p-time, "HH:MM:SS").
     3156   return v-date-str.
     3157   END FUNCTION.
     3158   function string-to-date returns date ( input p-string  as character):
     3159     define variable v-date as date no-undo .
     3160     assign
     3161     v-date = date(integer(substring(p-string, 4, 2))
     3162                   ,integer(substring(p-string, 1, 2))
     3163                   ,integer(substring(p-string, 7, 4))
     3164                  ) no-error .
     3165     if error-status:error then return ?.
     3166     return v-date.
     3167   END FUNCTION.
     3168   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3169   define variable v-time as integer no-undo init ?.
     3170   define variable v-dop1 as character no-undo .
     3171   define variable v-dop2 as character no-undo .
     3172   assign
     3173   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3174   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3175   no-error .
     3176   if error-status:error then return ?.
     3177   assign
     3178   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3179             integer(entry(2, v-dop2, ";":U)) * 60 +
     3180             integer(entry(3, v-dop2, ";":U)) no-error .
     3181   return v-time.
     3182   END FUNCTION.
     3183   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3184   procedure gdcstcod_cst-code :
     3185     define input  parameter p-obj-type  as character no-undo .
     3186     define input  parameter p-obj-code  as integer   no-undo .
     3187     define input  parameter p-gds-code  as integer   no-undo .
     3188     define input  parameter p-in-code   as character no-undo .
     3189     define input  parameter p-part-code as character no-undo .
     3190     define output parameter p-cst-code  as character no-undo .
     3191     define buffer buf_goods for ub.goods .
     3192     define buffer buf_parts for ub.parts .
     3193     do
     3194     on error undo, return error return-value
     3195     :
     3196       assign
     3197         p-cst-code = ''
     3198       .
     3199       find first buf_goods no-lock
     3200         where buf_goods.gds-code = p-gds-code
     3201         no-error .
     3202       if not available buf_goods
     3203       then do:
     3204         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3205       end.
     3206       if p-in-code = ?
     3207       then do:
     3208         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3209       end.
     3210       if p-part-code = ?
     3211       then do:
     3212         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3213       end.
     3214       if p-in-code = '':u
     3215       then do:
     3216         find first buf_parts no-lock
     3217           where buf_parts.obj-type  = p-obj-type
     3218             and buf_parts.obj-code  = p-obj-code
     3219             and buf_parts.artic     = buf_goods.artic
     3220             and buf_parts.prod-type = buf_goods.prod-type
     3221             and buf_parts.prod-code = buf_goods.prod-code
     3222             and buf_parts.out-code  = 'free-zone':U
     3223             and buf_parts.status_   = false
     3224           no-error .
     3225         if available buf_parts
     3226         then do:
     3227           assign
     3228             p-cst-code = buf_parts.cst-code
     3229           .
     3230         end.
     3231       end.
     3232       else do:
     3233         find first buf_parts no-lock
     3234           where buf_parts.obj-type  = p-obj-type
     3235             and buf_parts.obj-code  = p-obj-code
     3236             and buf_parts.artic     = buf_goods.artic
     3237             and buf_parts.prod-type = buf_goods.prod-type
     3238             and buf_parts.prod-code = buf_goods.prod-code
     3239             and buf_parts.out-code  = 'free-zone':U
     3240             and buf_parts.in-code   = p-in-code
     3241             and buf_parts.part-code = p-part-code
     3242           no-error .
     3243         if available buf_parts
     3244         then do:
     3245           assign
     3246             p-cst-code = buf_parts.cst-code
     3247           .
     3248         end.
     3249       end.
     3250     end.
     3251   end procedure.
     3252   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3253   define variable fname                        as character      no-undo .
     3254   define variable out                          as character      no-undo .
     3255   define variable out2                          as character      no-undo .
