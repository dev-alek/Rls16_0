    14234                                       , input fname
    14235                                       , input yes
    14236                                       , input 0
    14237                                       , input no
    14238                                       , input 9
    14239                                       , input 5000
    14240                                       , input v-plu
    14241                                       , input (if v-marketer-action = 'u':U
    14242                                               then string(cash-gds.price-sale * 100, "999999999")
    14243                                               else '000000000')
    14244         ).
    14245         run maria-put in this-procedure (
