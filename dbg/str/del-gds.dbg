    10787         .
    10788         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
    10789         assign
    10790         std-disc-dec = 0
    10791         std-disc-reason = 0
    10792         .
    10793         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10794         assign
    10795         std-disc-dec = 0
    10796         std-disc-reason = 0
    10797         .
