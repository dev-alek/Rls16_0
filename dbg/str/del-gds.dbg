    12376                 s = '"' + trim( bar_code ) + '","' + articul + '","NOSIZE",' + string(cash-gds.cli-base-rate).
    12377                 put stream bar unformatted s skip.
    12378             end.
    12379           end.
    12380         end.
    12381         else do:
