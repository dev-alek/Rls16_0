     6142   procedure fact-order-mpl :
     6143     do
     6144     on error undo, return error return-value
     6145     :
     6146   define input  parameter p-doc-date as date     no-undo .
     6147   define input  parameter p-obj-type as character no-undo .
     6148   define input  parameter p-obj-code as integer   no-undo .
     6149   define output parameter p-fact-order as decimal   no-undo .
     6150   define variable v-fact-date            as date    no-undo .
     6151   define variable v-fact-time            as integer no-undo .
     6152   define variable v-fact-order           as decimal no-undo .
     6153   define variable v-shift-end-fact-order as decimal no-undo .
     6154   define variable v-day-end-fact-order   as decimal no-undo .
     6155   define variable l-shift-on as logical no-undo .
     6156   define variable l-date as date      no-undo .
     6157   define variable l-time as integer   no-undo .
     6158   define variable shift-date as date      no-undo .
     6159   define variable shift-num  as integer   no-undo .
     6160   define variable shift-name as character no-undo .
     6161   define variable max-fact-order as decimal   no-undo .
     6162   define buffer buf_global-state for ub.global-state  .
     6163   find first buf_global-state no-lock no-error .
     6164   if not available buf_global-state then do:
     6165      message
     6166        "Не заданы параметры ценообразования!"
     6167        view-as alert-box error
     6168      .
     6169      return error return-value .
     6170   end.
     6171     run cur-time in this-procedure
     6172     ( output v-fact-date ,
     6173       output v-fact-time  ).
     6174   if p-doc-date = ? then do:
     6175   if buf_global-state.pl-use-sys-date-time  = true then do:
     6176         run factord in this-procedure
     6177           (input  v-fact-date
     6178           ,input  v-fact-time
     6179           ,input  v-fact-time
     6180           ,input  ?
     6181           ,input  ?
     6182           ,input  false
     6183           ,output v-fact-order
     6184           ,output v-shift-end-fact-order
     6185           ,output v-day-end-fact-order
     6186           ) no-error .
     6187         if error-status :error
     6188         or v-fact-order = ?
     6189         or v-fact-order = 0 then do:
     6190           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6191         end.
     6192         p-fact-order = v-fact-order .
     6193   end.
     6194   else do:
     6195   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6197     (input  p-obj-type
     6198     ,input  p-obj-code
     6199     ,input  'shift-on=request'
     6200     ,output l-shift-on
     6201     ) no-error .
     6202         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6203         if p-doc-date <> ? then do:
     6204         end.
     6205          run gbl/factdate.p
     6206          ( input        p-obj-type  ,
     6207            input        p-obj-code  ,
     6208            input-output v-fact-date ,
     6209            input-output v-fact-time ,
     6210            input-output shift-date      ,
     6211            input-output shift-num       ,
     6212            input-output shift-name      ,
     6213            input        yes
     6214            ) no-error .
     6215         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6216         run factord in this-procedure
     6217           (input  v-fact-date
     6218           ,input  v-fact-time
     6219           ,input  v-fact-time
     6220           ,input  shift-date
     6221           ,input  shift-num
     6222           ,input  l-shift-on
     6223           ,output v-fact-order
     6224           ,output v-shift-end-fact-order
     6225           ,output v-day-end-fact-order
     6226           ) no-error .
     6227         if error-status :error
     6228         or v-fact-order = ?
     6229         or v-fact-order = 0 then do:
     6230           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6231         end.
     6232         p-fact-order = v-fact-order .
     6233   end.
     6234   end.
     6235   else do:
     6236          run gbl/factdate.p
     6237          ( input        p-obj-type  ,
     6238            input        p-obj-code  ,
     6239            input-output v-fact-date ,
     6240            input-output v-fact-time ,
     6241            input-output shift-date      ,
     6242            input-output shift-num       ,
     6243            input-output shift-name      ,
     6244            input        yes
     6245            ) no-error .
     6246         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6247         v-fact-date = p-doc-date .
     6248         run factord in this-procedure
     6249           (input  v-fact-date
     6250           ,input  v-fact-time
     6251           ,input  v-fact-time
     6252           ,input  shift-date
     6253           ,input  shift-num
     6254           ,input  l-shift-on
     6255           ,output v-fact-order
     6256           ,output v-shift-end-fact-order
     6257           ,output v-day-end-fact-order
     6258           ) no-error .
     6259         if error-status :error
     6260         or v-fact-order = ?
     6261         or v-fact-order = 0 then do:
     6262           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6263         end.
     6264         p-fact-order = v-fact-order .
     6265   end.
     6266     end.
     6267   end procedure.
