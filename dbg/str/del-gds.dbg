    10385     :
    10386       if cash-gds.b-str = "" then do:
    10387         assign
    10388         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
    10389         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
    10390           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10391               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10392             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10393             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
    10394           end.
    10395           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10396               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10397             IBM-good-code-2 = b_code.
    10398           end.
    10399         end.
    10400       end.
    10401       else do:
    10402         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10403         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10404                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10405                              or
    10406                              cash-gds.bc-on-type = 'pglc':U)
    10407                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10408                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10409                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10410          if action <> "D":U then do:
    10411           is-sc = no.
    10412           find first request_prod-bc no-lock where
    10413                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10414           if not avail request_prod-bc then do :
    10415             if mask_s-c <> "" then do :
    10416               iii_ :
    10417               do iii = 1 to num-entries(mask_s-c) :
    10418                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10419                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10420                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10421                   if available request_prod-bc then leave iii_ .
    10422                 end.
    10423               end.
    10424             end.
    10425           end.
    10426           if avail request_prod-bc then do :
    10427             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10428   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10430     (buffer request_prod-bc
    10431     ,input  'scaleable=request'
