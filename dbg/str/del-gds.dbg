     7682   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7683   define buffer main-prt-bar-code  for ub.bar-code.
     7684   define buffer buf_goods-attr for goods-attr.
     7685   define buffer b-code for code.
     7686   if action = "U" then do:
     7687     if loc-bar-code.stts = Integer('79':U) then return.
     7688       for-price = ?.
     7689   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7691     (input  'маг':U
     7692     ,input  ub.shop.obj-code
     7693     ,input  loc-bar-code.b-code
     7694     ,input  main-b-code
     7695     ,input  0
     7696     ,output v-doc-num
     7697     ,output for-price
     7698     ,output for-road
     7699     ,output for-excise
     7700     ) no-error .
     7701       if error-status:error then do:
     7702           if g#news
     7703           or g#auto
     7704           or g#esys
     7705           then return error.
     7706           else do:
     7707               error-status:error = no.
     7708               message "Ошибка при определении цены на товар "
     7709                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7710               view-as alert-box ERROR.
     7711               return.
     7712           end.
     7713       end.
     7714       if return-value = "error" then do:
     7715           if for-price = ? then do:
     7716             return.
     7717           end.
     7718           if not g#news
     7719           and not g#auto
     7720           and not g#esys
     7721           then
     7722           message prichina view-as alert-box ERROR.
     7723           return error.
     7724       end.
     7725       else if (for-price = ? or for-price = 0) then do:
     7726         if v-is-restaurant and v-is-null-price  then do:
     7727           assign
     7728           for-price = 0.
     7729         end.
     7730         else do:
     7731           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7732                                                  ,input 'null-price':U
     7733                                                  ,output v-gds-null-price
     7734                                                  ,output v-type) no-error.
     7735           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7736           return "NEXT".
     7737         end.
     7738       end.
     7739     end.
     7740     else do:
     7741           for-price = 0.
     7742     end.
     7743   for-price = round-m( for-price , rnd-znak ).
     7744   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7745   start-paket = no.
     7746   if not avail cash-gds then do:
     7747   create cash-gds.
     7748   error-status:error = false.
     7749   end.
     7750   cash-gds.crf = cr + 1.
     7751   cr = cr + 1.
     7752   if loc-bar-code.in-code <> ''
     7753   or loc-bar-code.part-code <> ''
     7754   then do:
     7755     find first main-prt-bar-code no-lock where
     7756               main-prt-bar-code.gds-code = loc-goods.gds-code
     7757           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7758           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7759           and main-prt-bar-code.part-code = ''
     7760           and main-prt-bar-code.in-code = '' no-error.
     7761     if available main-prt-bar-code then do:
     7762       v-main-prt-b-code = main-prt-bar-code.b-code.
     7763     end.
     7764   end.
     7765   else do:
     7766     v-main-prt-b-code = loc-bar-code.b-code.
     7767   end.
     7768   find first tt-tax no-lock where
     7769              tt-tax.tax-code = vattaxcd no-error .
     7770   do iii = 1 to num-entries(mask_s-c) :
     7771     assign
     7772       v-mask-full  = trim(entry(iii, mask_s-c))
     7773       v-mask-short = entry(1, v-mask-full, "*")
     7774       loc-prod-bc  = trim(loc-prod-bc)
     7775     .
     7776     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7777       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7778   end.
     7779   define variable vBc-on as logical no-undo.
     7780   if loc-prod-bc ne ?
     7781   then do:
     7782       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7783                            and prod-bc.b-str  eq loc-prod-bc
     7784                            no-lock no-error.
     7785       if available prod-bc
     7786       then
     7787          vBc-on = prod-bc.bc-on.
     7788       else
     7789          vBc-on = yes.
     7790   end.
     7791   else
     7792      vBc-on = yes.
     7793   run gdsoattr-value in this-procedure (
     7794     'dt-seasons':U,
     7795     loc-goods.gds-code,
     7796     parobj-type,
     7797     parobj-code,
     7798     output attrValue,
     7799     output attrType
     7800   ) no-error.
     7801   if attrValue <> "" then do:
     7802     find first b-code where
     7803                b-code.parent = "DTSeasons"
     7804            and b-code.code   = attrValue
     7805          no-lock no-error.
     7806     v-main-prt-b-code = integer(b-code.code).
     7807   end.
     7808   else release b-code.
     7809   assign
     7810   cash-gds.gds-code = loc-goods.gds-code
     7811   cash-gds.artic = loc-goods.artic
     7812   cash-gds.b-code = loc-bar-code.b-code
     7813   cash-gds.main-prt-b-code = v-main-prt-b-code
     7814   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7815   cash-gds.bc-on-type = loc-bc-on-type
     7816   cash-gds.bc-on = vBc-on
     7817   cash-gds.unit-cli = loc-bar-code.unit-cli
     7818   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7819   cash-gds.std-discnt-rule = std-discnt-rule_
     7820   cash-gds.gds-namelong = loc-goods.gds-name
     7821   cash-gds.gds-name = IF nam-2str
     7822                       then if available b-code then b-code.codename else loc-goods.gds-name
     7823                       else (
     7824                             IF nam-artc
     7825                             then loc-goods.artic
     7826                             else if available b-code
     7827                                  then b-code.codename
     7828                                  else (if loc-goods.chk-name <> ""
     7829                                        then loc-goods.chk-name
     7830                                        else loc-goods.gds-name)
     7831                            )
     7832   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7833   cash-gds.unit-base = loc-goods.unit-base
     7834   cash-gds.grp-code = for-grp-code
     7835   cash-gds.fp = for-fp
     7836   cash-gds.ingredient = loc-goods.struct
     7837   cash-gds.producer = for-producer
     7838   cash-gds.producer-int = for-producer-int
     7839   cash-gds.alpha1     = loc-goods.alpha1.
     7840     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7841                                            ,input 'office-type':U
     7842                                            ,output v-oss
     7843                                            ,output v-type) no-error.
     7844   cash-gds.office-type = v-oss.
     7845     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7846                                            ,input 'type-method-calc':U
     7847                                            ,output v-oss
     7848                                            ,output v-type) no-error.
     7849   if v-oss <> "" then
     7850     assign
     7851       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7852       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7853     .
     7854   else
     7855     assign
     7856       cash-gds.CalculationMethod = 0
     7857       cash-gds.CalculationMethodRestr = 0
     7858     .
     7859   assign
     7860   cash-gds.fact-qnty = for-fact-qnty
     7861   cash-gds.okei = loc-bc-units-okei
     7862   cash-gds.kat-discnt-method = kat-discnt-method_
     7863   cash-gds.temp-discnt-method = temp-discnt-method_
     7864   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7865                                then  kat-discnt-rule_pdf
     7866                                else  kat-discnt-rule_)
     7867   cash-gds.date-discnt-rule = date-discnt-rule_
     7868   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7869   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7870   cash-gds.wgd-rule = for-wgd
     7871   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7872                           then 1
     7873                           else 0)
     7874   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7875                        or for-petrol-purse
     7876                        then (cash-gds.gds-stat + 8)
     7877                        else cash-gds.gds-stat)
     7878   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7879                       then (cash-gds.gds-stat + 16)
     7880                       else cash-gds.gds-stat
     7881   cash-gds.gds-stat = if cash-gds.fp
     7882                       then (cash-gds.gds-stat + 2)
     7883                       else cash-gds.gds-stat
     7884   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7885                       then (cash-gds.gds-stat + 128)
     7886                       else cash-gds.gds-stat
     7887   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7888   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7889                                then temp-discnt-rule_pdf
     7890                                else temp-discnt-rule_)
     7891   cash-gds.wd-rule = for-wd
     7892   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7893   cash-gds.need-auth = (if need-auth then 1 else 0)
     7894   cash-gds.price-sale =  for-price
     7895   cash-gds.unit-type = loc-units.type
     7896   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7897   cash-gds.tax-string = tax-string
     7898   cash-gds.new-good = new-good
     7899   cash-gds.rc = recid(loc-goods)
     7900   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7901   cash-gds.vat-pc = (if avail tt-tax
     7902                      then tt-tax.rate-value
     7903                      else 0)
     7904   cash-gds.vat-code = (if avail tt-tax
     7905                        then tt-tax.rate-code
     7906                        else ?)
     7907   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7908   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7909   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7910   cash-gds.fbr-grp-code = v-fbr-grp-code
     7911   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7912   cash-gds.DepartID = v-fbr-obj-code
     7913   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7914   cash-gds.node-code = loc-bar-code.node-code
     7915   cash-gds.taracode = for-taracode
     7916   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7917                            and loc-bar-code.in-code = ""
     7918                            and loc-bar-code.part-code = ""
     7919                            and cash-gds.unit-base = cash-gds.unit-cli
     7920                            then yes
     7921                            else no)
     7922   cash-gds.obj-type = parobj-type
     7923   cash-gds.obj-code = parobj-code
     7924   .
     7925   assign
     7926   cash-gds.gds-name1 =   name-2cdf(
     7927                         input name-2cd
     7928                       , input yes
     7929                       , input cod-pcod
     7930                       , input cash-gds.b-code
     7931                       , input loc-goods.gds-code
     7932                       , input loc-goods.artic
     7933                       , input loc-goods.engl-name
     7934                       , input loc-bar-code.in-code
     7935                       , input loc-bar-code.part-code
     7936                       , input parobj-type
     7937                       , input parobj-code
     7938                       , input loc-goods.alpha1
     7939                       , output v-gtd
     7940                       )
     7941   cash-gds.gtd   = v-gtd
     7942   .
     7943   vKKT = 255.
     7944   find first b-code where
     7945              b-code.parent  = "okei-kkt"
     7946          and b-code.code    = string(cash-gds.okei)
     7947          and b-code.status_ = 0
     7948   no-lock no-error.
     7949   if avail b-code then
     7950      vKKT = integer(b-code.CodeName) no-error.
     7951   if error-status:error then vKKT = 255.
     7952   cash-gds.kkt = vKKT.
     7953   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7954      run gds-attr-value in this-procedure  (
     7955                                             input cash-gds.gds-code
     7956                                            ,input 'fuel-type':U
     7957                                            ,output v-is-gas
     7958                                            ,output v-type) no-error.
     7959      run gds-attr-value in this-procedure  (
     7960                                             input cash-gds.gds-code
     7961                                            ,input 'ptrl-as-good':U
     7962                                            ,output v-ptrl-as-good
     7963                                            ,output v-type) no-error.
     7964      assign
     7965      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7966      no-error .
     7967      assign
     7968      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7969      no-error .
     7970      if cash-gds.is-gas then do:
     7971        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7972      end.
     7973   end.
     7974      run gds-attr-value in this-procedure  (
     7975                                             input cash-gds.gds-code
     7976                                            ,input 'ban-bonus':U
     7977                                            ,output v-ban-bonus
     7978                                            ,output v-type) no-error.
     7979     assign
     7980      cash-gds.wd = int(logical(v-ban-bonus))
     7981      no-error .
     7982   if how-temp-disc = 'temp-disc':U then do:
     7983     case temp-discnt-method_:
     7984       when "" then do:
     7985       end.
     7986       when "bar-code.b-code" then do:
     7987         if loc-bar-code.in-code <> ''
     7988         or loc-bar-code.part-code <> ''
     7989         then do:
     7990           disc-b-code = cash-gds.main-prt-b-code.
     7991         end.
     7992         else do:
     7993           disc-b-code = cash-gds.b-code.
     7994         end.
     7995         find first buf_temp-dis-gds-rule where
     7996                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7997             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7998         if available buf_temp-dis-gds-rule then do:
     7999             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     8000         end.
     8001       end.
     8002       otherwise do:
     8003         cash-gds.temp-discnt-rule = 0.
     8004       end.
     8005     end.
     8006   end.
