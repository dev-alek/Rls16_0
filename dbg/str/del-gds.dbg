    12329       end.
    12330   if cash-gds.b-str = ""
    12331       or lookup('вес':U, cash-gds.unit-cli-type) > 0
    12332       then do:
    12333           if ub.sysconf.base-code <> 0  or v-type = true  then do:
    12334           s = '"' + articul + '","'  + chk_name + '","' +
    12335               (if cash-gds.unit-cli = "кг."
    12336                or cash-gds.unit-cli = "кг"
    12337                then "КГ"
    12338                else cash-gds.unit-cli) +
    12339                 v-discreteness +
    12340                 string(cash-gds.producer, "X(20)") + '","' +
    12341                 STRING(I-OBJ-CODE)                  + '","' +
    12342                 substring(for-shop-name , 1, 20)    + '",'  +
    12343                 '0,0,0,"NOSIZE"," "," "," "," "," ",0.00,' +
    12344                   trim(string( (if v-type = true
    12345                               then  cash-gds.price-sale / curr_cass
    12346                               else cash-gds.price-sale),">>>>>9.99")) +
    12347                 '," ",' + chr(34) + string(cash-gds.vat-pc) + chr(34)  + ',"1",,0,0'.
    12348           end.
    12349           else do:
    12350           s = '"' + articul + '","'  + chk_name + '","' +
    12351               (if cash-gds.unit-cli = "кг."
    12352                or cash-gds.unit-cli = "кг"
    12353                then "КГ"
    12354                else cash-gds.unit-cli) +
    12355                 v-discreteness +
    12356                 string(cash-gds.producer, "X(20)") + '","'  +
    12357                 STRING(I-OBJ-CODE)                  + '","'  +
    12358                 substring(for-shop-name , 1, 20)    + '",'   +
    12359                 '0,0,0,"NOSIZE"," "," "," "," "," ",' +
    12360                 trim( string( cash-gds.price-sale ,">>>>>>>>>>9.99")) +
    12361                 ',0.00," ",'  + chr(34) + string(cash-gds.vat-pc) + chr(34)  +  ',"1",,0,0'.
    12362           end.
    12363           put stream plucash unformatted s skip.
    12364           if lookup('вес':U, cash-gds.unit-cli-type) = 0
    12365           or (lookup('вес':U, cash-gds.unit-cli-type) > 0
    12366               and not ub.shop.cd-sc-base
    12367               and cash-gds.unit-cli = cash-gds.unit-base)
    12368           then do:
    12369             if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12370                 (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12371                 s = '"' + string( cash-gds.b-code ) + '","' + articul + '","NOSIZE",' + string(cash-gds.cli-base-rate).
