    10487           then do:
    10488             message
    10489               "Невозможно сформировать бар-код" skip
    10490               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10491               view-as alert-box error title "подсчет контрольной суммы".
    10492             return error.
    10493           end.
    10494           assign
    10495             sum87 = sum87 + integer(v-sum-char87)
    10496           .
    10497         end.
    10498         if varcont87 = yes then do:
    10499           assign
    10500             sum87 = sum87 * 3
    10501           .
    10502           do i87 = 2 to len-code87 by 2
    10503           :
    10504             assign
    10505               v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10506             .
    10507             if v-sum-char87 < "0"
    10508             or v-sum-char87 > "9"
    10509             then do:
    10510               message
    10511                 "Невозможно сформировать бар-код" skip
    10512                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10513                 view-as alert-box error title "подсчет контрольной суммы".
    10514               return error.
    10515             end.
    10516             assign
    10517               sum87 = sum87 + integer(v-sum-char87)
    10518             .
    10519           end.
    10520           if varcont87 = yes then do:
    10521              if sum87 mod 10 = 0 then do:
    10522                assign
    10523                  IBm-good-code = IBm-good-code + '0'
    10524                .
    10525              end.
    10526              else do:
    10527                assign
    10528                  IBm-good-code = IBm-good-code + string(10 - sum87 mod 10)
    10529                .
    10530              end.
    10531           end.
    10532         end.
    10533       end.
    10534     end.
    10535             end.
    10536             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10537                cash-gds.bc-on-type = 'pglc':U
    10538                then do:
    10539   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10540     define variable tmp-str88  as character no-undo.
