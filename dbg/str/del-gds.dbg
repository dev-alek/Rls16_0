    13584                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    13585                 and crf <= cr-ncr-dis-kat
    13586           by buf_cash-ncr-dis-kat.cd-subject-code
    13587           by buf_cash-ncr-dis-kat.cd-disc-string
    13588           :
