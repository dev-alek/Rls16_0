     1144             end.
     1145           end.
     1146           else do:
     1147             find buf_bar-code where
     1148                   buf_bar-code.gds-code  = vargds-code     and
     1149                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1150                   buf_bar-code.part-code = ""           and
     1151                   buf_bar-code.in-code   = ""           and
     1152                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1153             if not available buf_bar-code then do:
