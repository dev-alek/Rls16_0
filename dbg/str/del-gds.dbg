    10471       else do:
    10472         assign
    10473           IBm-good-code = ncrsc-pfx + substring( tmp-str87, length( ncrsc-pfx ) + 1, length( tmp-str87 ) - length( ncrsc-pfx ) )
    10474           len-code87    = length( IBm-good-code )
    10475         .
