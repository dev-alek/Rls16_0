    12523       when 'NCR-GM':U
    12524       or when 'NCR-AS@R':U
    12525       then do:
    12526   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12527   define variable ncr-disc-string as character no-undo .
    12528   if nam-artc then
    12529   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    12530   else  do:
    12531     chk_name = "" .
    12532     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
    12533       chk_name = chk_name + entry( ff, cash-gds.gds-name, '"' ) .
    12534     END .
    12535     if chk_name = "" then
    12536     chk_name = cash-gds.gds-name .
    12537     chk_name = chk_name + cash-gds.f-name .
    12538   end.
    12539   if (cash-gds.unit-base <> cash-gds.unit-cli) and
    12540      cash-gds.cli-base-rate <> 1 then
    12541   assign
    12542   chk_name = string(substr(chk_name, 1, 19 - length(string(cash-gds.cli-base-rate))) + "*" + string( cash-gds.cli-base-rate ), "x(20)" ).
    12543   else
