    12383             put stream bar unformatted s skip.
    12384         end.
    12385         if lookup('вес':U, cash-gds.unit-cli-type) > 0 then do:
    12386             s = '"' + string(ipcsc-pfx)  + string( cash-gds.b-str ) + '","' + articul + '","NOSIZE",' + string(cash-gds.cli-base-rate).
    12387             put stream bar unformatted s skip.
