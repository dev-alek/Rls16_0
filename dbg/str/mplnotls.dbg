        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as handle no-undo .
        3   define input  parameter p-pdf-id as integer   no-undo .
        4   define input  parameter p-pdf-db as integer   no-undo .
        5   define input  parameter p-plt-id as integer   no-undo .
        6   define input  parameter p-plt-db as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: mplnotls.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/mplnotls.p $":U .
       12   define variable vss-description as character no-undo init "проверка, что ни одна из старых цен в переоценке не потеряна".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     run mainmenu_getcntxt in parparentproc
       80       (output v-cntxt-db-num
       81       ,output v-cntxt-userid
       82       ,output v-cntxt-level
       83       ,output v-cntxt-host-code-obj
       84       ,output v-cntxt-obj-type
       85       ,output v-cntxt-obj-code
       86       ,output v-cntxt-db-num-obj
       87       ,output v-cntxt-is-admin
       88       ) .
       89   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define new global shared variable g#language as character no-undo .
       91   if g#language <> '' and g#language <> 'rus':U then do:
       92     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       93   end.
       94   define temp-table x_obj-group no-undo like ub.clients  .
       95   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       96   procedure metod-gop-obj :
       97     do
       98     on error undo, return error return-value
       99     :
      100   define input  parameter p-cntxt-db-num as integer   no-undo .
      101   define input  parameter p-gop-id       as integer   no-undo .
      102   define input  parameter p-gop-db-num   as integer   no-undo .
      103   define buffer buf1_clients for ub.clients  .
      104   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      105   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      106   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      107   for each  x_obj-group : delete x_obj-group. end.
      108   if p-gop-id = 0 or p-gop-id = ?  then do:
      109      if p-cntxt-db-num = 0  then do:
      110           for each buf1_clients no-lock where
      111                   (buf1_clients.obj-type = 'маг':U  or
      112                    buf1_clients.obj-type = 'скл':U  )
      113                   and
      114                   buf1_clients.db-num >= 0  and
      115                   buf1_clients.stts = 0
      116                   :
      117             create x_obj-group .
      118             assign
      119               x_obj-group.obj-code   = buf1_clients.obj-code
      120               x_obj-group.obj-type   = buf1_clients.obj-type
      121               x_obj-group.obj-name   = buf1_clients.obj-name
      122               x_obj-group.db-num     = buf1_clients.db-num
      123             .
      124           end.
      125      end.
      126      else do:
      127           for each buf1_clients no-lock where
      128                   (buf1_clients.obj-type = 'маг':U  or
      129                    buf1_clients.obj-type = 'скл':U  ) and
      130                    buf1_clients.db-num = p-cntxt-db-num  and
      131                    buf1_clients.stts = 0
      132                   :
      133             create x_obj-group .
      134             assign
      135               x_obj-group.obj-code   = buf1_clients.obj-code
      136               x_obj-group.obj-type   = buf1_clients.obj-type
      137               x_obj-group.obj-name   = buf1_clients.obj-name
      138               x_obj-group.db-num     = buf1_clients.db-num
      139             .
      140           end.
      141      end.
      142   end.
      143   else do:
      144         for each buf_db-grp-obj-price  where
      145                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      146                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      147                 buf_db-grp-obj-price.stts = 0  no-lock :
      148           for each buf1_clients no-lock where
      149                  (buf1_clients.obj-type = 'маг':U  or
      150                   buf1_clients.obj-type = 'скл':U  ) and
      151                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      152                   buf1_clients.stts = 0
      153                   :
      154             create x_obj-group .
      155             assign
      156               x_obj-group.obj-code   = buf1_clients.obj-code
      157               x_obj-group.obj-type   = buf1_clients.obj-type
      158               x_obj-group.obj-name   = buf1_clients.obj-name
      159               x_obj-group.db-num     = buf1_clients.db-num
      160             .
      161           end.
      162         end.
      163       for each buf_host-grp-obj-price where
      164               buf_host-grp-obj-price.gop-id     = p-gop-id and
      165               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      166               buf_host-grp-obj-price.stts = 0
      167               no-lock :
      168         for each buf1_clients no-lock where
      169                (buf1_clients.obj-type = 'маг':U  or
      170                 buf1_clients.obj-type = 'скл':U  ) and
      171                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      172                 buf1_clients.stts = 0
      173                 :
      174             find first x_obj-group no-lock  where
      175                       x_obj-group.obj-code   = buf1_clients.obj-code and
      176                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      177             if not available  x_obj-group then   create x_obj-group .
      178             assign
      179               x_obj-group.obj-code   = buf1_clients.obj-code
      180               x_obj-group.obj-type   = buf1_clients.obj-type
      181               x_obj-group.obj-name   = buf1_clients.obj-name
      182               x_obj-group.db-num     = buf1_clients.db-num
      183             .
      184         end.
      185       end.
      186       for each buf_obj-grp-obj-price where
      187               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      188               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      189               buf_obj-grp-obj-price.stts = 0
      190               no-lock :
      191         for each buf1_clients no-lock where
      192                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      193                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      194                   buf1_clients.stts     = 0
      195                   :
      196             find first  x_obj-group no-lock  where
      197                         x_obj-group.obj-code   = buf1_clients.obj-code and
      198                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      199             if not available  x_obj-group then   create x_obj-group .
      200             assign
      201               x_obj-group.obj-code   = buf1_clients.obj-code
      202               x_obj-group.obj-type   = buf1_clients.obj-type
      203               x_obj-group.obj-name   = buf1_clients.obj-name
      204               x_obj-group.db-num     = buf1_clients.db-num
      205             .
      206         end.
      207       end.
      208   end.
      209   end.
      210   end procedure.
      211   procedure metod-obj-in-gop :
      212   define input  parameter p-curr-db-num as integer   no-undo .
      213   define input  parameter p-obj-type as character no-undo .
      214   define input  parameter p-obj-code as integer   no-undo .
      215   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      216     do
      217     on error undo, return error return-value
      218     :
      219       empty temp-table x_grp-obj-price.
      220       for each buf_grp-obj-price where
      221                buf_grp-obj-price.stts = 0
      222                no-lock :
      223                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      224                  for each x_obj-group where
      225                           x_obj-group.obj-type = p-obj-type and
      226                           x_obj-group.obj-code = p-obj-code :
      227                       create  x_grp-obj-price.
      228                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      229                  end.
      230       end.
      231     end.
      232   end procedure.
      233   procedure metod-delobj-usr :
      234   define input  parameter p-pdf-id  as integer   no-undo .
      235   define input  parameter p-pdf-db  as integer   no-undo .
      236   define input  parameter p-plt-id  as integer   no-undo .
      237   define input  parameter p-plt-db-num as integer   no-undo .
      238   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      239     do
      240     on error undo, return error return-value
      241     :
      242   for each buf_price-doc-forming-attr no-lock  where
      243            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      244            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      245            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      246            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      247            buf_price-doc-forming-attr.attr-code begins "obj" :
      248      for each x_obj-group  where
      249               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      250               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      251        delete x_obj-group.
      252      end.
      253   end.
      254     if not can-find (first x_obj-group) then do:
      255        return "nullobj" .
      256     end.
      257   end.
      258   end procedure.
      259   procedure metod-obj-pdf :
      260   define input  parameter p-cntxt-db-num as integer   no-undo .
      261   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      262   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      263   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      264   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      265   define buffer buf_price-list-type for ub.price-list-type  .
      266   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      267     do
      268     on error undo, return error return-value
      269     :
      270    for each  x_obj-group : delete x_obj-group. end.
      271    find first buf_price-list-type no-lock where
      272               buf_price-list-type.plt-id = p-plt-id and
      273               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      274   if error-status :error then return error return-value .
      275    find first buf_price-doc-forming no-lock where
      276               buf_price-doc-forming.plt-id     = p-plt-id and
      277               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      278               buf_price-doc-forming.pdf-id     = p-pdf-id and
      279               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      280               no-error .
      281   if error-status :error then return error return-value .
      282     run metod-gop-obj in this-procedure (
      283         p-cntxt-db-num,
      284         buf_price-list-type.gop-id ,
      285         buf_price-list-type.gop-db-num
      286         ) no-error .
      287     run metod-delobj-usr in this-procedure (
      288       buf_price-doc-forming.pdf-id ,
      289       buf_price-doc-forming.pdf-db ,
      290       buf_price-doc-forming.plt-id ,
      291       buf_price-doc-forming.plt-db-num
      292       ) no-error .
      293     end.
      294   end procedure.
      295   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      298   define variable par-type          as character no-undo.
      299   define variable v-value-character as character no-undo .
      300   define variable v-value-date      as date      no-undo .
      301   define variable v-value-decimal   as decimal   no-undo .
      302   define variable v-value-integer   as integer   no-undo .
      303   define variable v-value-logical   as logical   no-undo .
      304   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      305   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      306   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      307   define variable gp-excise     like ub.price-list.excise     no-undo.
      308   define variable gp-b-code     like ub.price-list.b-code     no-undo.
      309   define buffer buf-price-list-type    for ub.price-list-type  .
      310   define buffer main-list  for ub.price-doc-forming-gds.
      311   define buffer main-list2 for ub.price-doc-forming-gds.
      312   define buffer sub-list   for ub.price-doc-forming-gds.
      313   define buffer old-list   for ub.price-list.
      314   define buffer temp-price-doc for ub.price-doc.
      315   define variable par-pr-notls as character no-undo.
      316   define variable par-pr-dscnt as character no-undo.
      317   define variable par-pr-equ-dq as integer no-undo.
      318   define variable ok-dscnt     as logical  no-undo.
      319   define variable v-gds-code as integer   no-undo .
      320   define variable v-b-code   as integer   no-undo .
      321   define variable v-str1 as character no-undo .
      322   define buffer buf_goods for ub.goods  .
      323   define buffer buf_bar-code for ub.bar-code  .
      324   define buffer buf_parts for ub.parts  .
      325   for each main-list no-lock where
      326            main-list.pdf-id = p-pdf-id and
      327            main-list.pdf-db = p-pdf-db and
      328            main-list.plt-id = p-plt-id and
      329            main-list.plt-db = p-plt-db
      330            :
      331            find first buf_goods no-lock where
      332                       buf_goods.artic     = main-list.artic     and
      333                       buf_goods.prod-type = main-list.prod-type and
      334                       buf_goods.prod-code = main-list.prod-code no-error .
      335            if error-status :error then do:
      336               return error substitute("Нет товара &1 &2&3 в справочнике товаров." , main-list.artic , main-list.prod-type , main-list.prod-code ).
      337            end.
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      339     (input  buf_goods.gds-code
      340     ,input  ?
      341     ,output v-b-code
      342     ) no-error .
      343             if error-status :error then do:
      344                return error return-value + error-status :get-message(1) .
      345             end.
      346            find first main-list2 no-lock where
      347                       main-list2.pdf-id = p-pdf-id and
      348                       main-list2.pdf-db = p-pdf-db and
      349                       main-list2.plt-id = p-plt-id and
      350                       main-list2.plt-db-num = p-plt-db and
      351                       main-list2.b-code = v-b-code
      352                       no-error .
      353           if not available main-list2 then do:
      354           end.
      355   end.
      356   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   empty temp-table thbjattr_thbj-attr.
      358   run adm/shattri.p (
      359      input "get":U
      360     ,input v-cntxt-obj-type
      361     ,input v-cntxt-obj-code
      362     ,input 'overval':U
      363     ,input  ""
      364     ,output v-value-character
      365     ,output v-value-date
      366     ,output v-value-decimal
      367     ,output v-value-integer
      368     ,output v-value-logical
      369     ,output par-type
      370     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      371     ) no-error .
      372   for each thbjattr_thbj-attr :
      373       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U  then par-pr-dscnt  = string( thbjattr_thbj-attr.property-value-logical) .
      374       if thbjattr_thbj-attr.prop-code = 'pr-notls':U  then par-pr-notls  = string( thbjattr_thbj-attr.property-value-logical) .
      375       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
      376   end.
      377   empty temp-table thbjattr_thbj-attr.
      378   if par-pr-notls <> "yes" then
      379     return.
      380   ok-dscnt = false  .
      381   find first  buf-price-list-type no-lock where
      382               buf-price-list-type.plt-id     = p-plt-id and
      383               buf-price-list-type.plt-db-num = p-plt-db no-error .
      384   run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf-price-list-type.gop-id , buf-price-list-type.gop-db-num) .
      385   for each x_obj-group :
      386   for each main-list where
      387            main-list.pdf-id = p-pdf-id and
      388            main-list.pdf-db = p-pdf-db and
      389            main-list.plt-id = p-plt-id and
      390            main-list.plt-db = p-plt-db
      391             :
      392   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      394     (input  x_obj-group.obj-type
      395     ,input  x_obj-group.obj-code
      396     ,input  main-list.b-code
      397     ,input  0
      398     ,input  0
      399     ,output gp-doc-num
      400     ,output gp-price-sale
      401     ,output gp-road-tax
      402     ,output gp-excise
      403     ) no-error .
      404       if error-status :error then do:
      405         return error "Ошибка поиска цены главного кода " + error-status :get-message(1) + return-value .
      406       end.
      407     for each  old-list no-lock where
      408               old-list.doc-num    = gp-doc-num and
      409               old-list.artic      = main-list.artic and
      410               old-list.prod-type  = main-list.prod-type and
      411               old-list.prod-code  = main-list.prod-code and
      412               old-list.main-price = no:
      413       find sub-list where
      414            sub-list.pdf-id = p-pdf-id and
      415            sub-list.pdf-db = p-pdf-db and
      416            sub-list.plt-id = p-plt-id and
      417            sub-list.plt-db = p-plt-db and
      418            sub-list.b-code  = old-list.b-code  no-error.
      419       if not available sub-list then do:
      420         if par-pr-equ-dq = 1  then do:
      421            find first buf_bar-code no-lock where
      422                       buf_bar-code.b-code = old-list.b-code and
      423                       buf_bar-code.in-code <> "" no-error .
      424             find first buf_parts no-lock where
      425                   buf_parts.out-code    = 'free-zone':U           and
      426                   buf_parts.obj-type    = x_obj-group.obj-type   and
      427                   buf_parts.obj-code    = x_obj-group.obj-code   and
      428                   buf_parts.rsrv-free   = true                   and
      429                   buf_parts.status_     = false                  and
      430                   buf_parts.artic       = old-list.artic         and
      431                   buf_parts.prod-type   = old-list.prod-type     and
      432                   buf_parts.prod-code   = old-list.prod-code     and
      433                   buf_parts.part-code   = buf_bar-code.part-code and
      434                   buf_parts.in-code     = buf_bar-code.in-code
      435                   no-error .
      436         if available buf_bar-code then do:
      437            if buf_bar-code.in-code <> "" and not available buf_parts then next.
      438         end.
      439           return error substitute( "Потеряна по крайней мере одна существующая цена, &1
      440                        что запрещено настройкой pr-notls. &1
      441                        Код:&2  &1
      442                        Номер предыдущей переоценки: &3" ,
      443                        chr(10) , old-list.b-code ,  gp-doc-num ).
      444         end.
      445         else next.
      446       end.
      447       if par-pr-dscnt = "yes" then do:
      448             if not ok-dscnt and
      449               sub-list.d-pcnt <> old-list.d-pcnt then do:
      450                 find first buf_goods no-lock where
      451                             buf_goods.artic     = sub-list.artic     and
      452                             buf_goods.prod-type = sub-list.prod-type and
      453                             buf_goods.prod-code = sub-list.prod-code no-error .
      454                   v-str1 = substitute("ДНЦ. Изменилась по крайней мере одна скидка&4 Товар &5 &6&4 Код: &1&4 Старая скидка: &2 % (переоценка &7)&4 Новая скидка: &3 %" ,
      455                                         old-list.b-code,
      456                                         old-list.d-pcnt,
      457                                         sub-list.d-pcnt,
      458                                         chr(10),
      459                                         buf_goods.artic,
      460                                         buf_goods.gds-name,
      461                                         old-list.doc-num
      462                                         ).
      463                   message
      464                     v-str1 skip (2)
      465                     "Продолжать?"
      466                     view-as alert-box question buttons OK-Cancel update ok-dscnt.
      467                 if not ok-dscnt then
      468                    return error  v-str1.
      469             end.
      470       end.
      471     end.
      472   end.
      473   end.
