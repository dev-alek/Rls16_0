      130   define  stream PrnLibStream.
      131   procedure prn-lib-prn-file :
      132     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      133     define input parameter p-DIsabledoptions as integer no-undo .
      134     define variable v-report-name as character no-undo .
      135     define variable v-user-action as character no-undo .
      136     define variable v-printed     as logical   no-undo .
      137     define variable v-exist       as logical   no-undo .
      138     do
      139       on error undo, return error
      140       :
      141       run prn-lib-get-report-name  in this-procedure (
      142         input parParentProc
      143         ,output v-report-name
      144         ).
      145   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      147     (input  v-report-name
      148     ,input  2
      149     ,output v-exist
      150     )  .
      151       if NOT v-exist then
      152       DO:
      153         Message
      154           "Нет заданий на печать ! "
      155           view-as alert-box .
      156         Return  .
      157       End.
      158       run gbl/prnfilen.w
      159         (input  ""
      160         ,input  p-DisabledOptions
      161         ,input  string(v-report-name )
      162         ,input  7
      163         ,output v-user-action
      164         ,output v-printed
      165         ) .
      166       if v-printed then
      167       do:
      168         return "YES" .
      169       end.
      170       else
      171       do:
      172         return "NO" .
      173       end.
      174     end.
      175   end procedure.
      176   procedure prn-lib-open-stream :
      177     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      178     define input parameter p-page-size    as integer no-undo .
      179     define input parameter p-is-stream    as logical no-undo .
      180     define input parameter p-append       as logical no-undo .
      181     define variable v-report-name as character no-undo .
      182     do
      183       on error undo, return error
      184       :
      185       run prn-lib-get-report-name  in this-procedure (
      186         input parParentProc
      187         ,output v-report-name
      188         ).
      189       if p-is-stream then
      190       do:
      191         if p-append then
      192         do:
      193           output stream PrnLibStream to value( v-report-name )
      194             page-size value(p-page-size) append .
      195         end.
      196         if not p-append then
      197         do:
      198           output stream PrnLibStream to value( v-report-name )
      199             page-size value(p-page-size) .
      200         end.
      201       end.
      202       if not p-is-stream then
      203       do:
      204         if p-append then
      205         do:
      206           output to value( v-report-name )
      207             page-size value(p-page-size) append .
      208         end.
      209         if not p-append then
      210         do:
      211           output to value( v-report-name )
      212             page-size value(p-page-size) .
      213         end.
      214       end.
      215     end.
      216   end procedure.
      217   procedure prn-lib-open-exp :
      218     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      219     define input parameter p-is-stream    as logical no-undo .
      220     define input parameter p-is-append    as logical no-undo .
      221     define output parameter p-ReportFileName as char init "report" no-undo.
      222     define output parameter p-process as logical no-undo .
      223     define variable glog as logical no-undo .
      224     do
      225       on error undo, return error
      226       :
      227       SYSTEM-DIALOG GET-FILE p-ReportFileName
      228         TITLE      "Укажите путь"
      229         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      230         ASK-OVERWRITE
      231         CREATE-TEST-FILE
      232         SAVE-AS
      233         USE-FILENAME
      234         DEFAULT-EXTENSION "txt"
      235         UPDATE glog
      236         .
      237       if not glog then  return.
      238       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      239       if p-is-stream then
      240       do:
      241         if p-is-append then
      242         do:
      243           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      244         end.
      245         else
      246         do:
      247           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      248         end.
      249       end.
      250       else
      251       do:
      252         if p-is-append then
      253         do:
      254           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      255         end.
      256         else
      257         do:
      258           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      259         end.
      260       end.
      261       p-process = yes.
      262     end.
      263   end procedure.
      264   procedure prn-lib-get-report-name :
      265     define input parameter parParentProc  as widget-handle no-undo.
      266     define output parameter p-report-name as character no-undo .
      267     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      268   end procedure.
      269   procedure prn-lib-reportviewer-report-name :
      270     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      271     define input parameter p-report-name-html as character no-undo .
      272     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      273   end procedure.
      274   procedure prn-lib-reportviewer :
      275     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      276     define input parameter p-report-name-html as character no-undo .
      277     define input parameter p-param        as character no-undo .
      278     define variable v-excel           as character no-undo init 'TRUE' .
      279     define variable v-value-character as character no-undo .
      280     define variable v-value-integer   as character no-undo .
      281     define variable v-value-date      as date      no-undo .
      282     define variable v-value-decimal   as decimal   no-undo .
      283     define variable rep-excel         as logical   no-undo .
      284     define variable excel-string      as character no-undo .
      285     define variable v-param-type      as character no-undo .
      286     define variable v-tth             as handle    no-undo .
      287     run adm/shattri.p (
      288       input "get":U
      289       ,input  ""
      290       ,input  0
      291       ,input  'report-glob':U
      292       ,input  'rep-excel':U
      293       ,output v-value-character
      294       ,output v-value-date
      295       ,output v-value-decimal
      296       ,output v-value-integer
      297       ,output rep-excel
      298       ,output v-param-type
      299       ,INPUT-OUTPUT table-handle v-tth
      300       )  .
      301     if rep-excel then v-excel = "TRUE" .
      302     else v-excel = "FALSE" .
      303     if p-param eq ""
      304     then
      305        p-param = "EXCEL:" + v-excel.
      306     else
      307        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      308     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      309   end procedure.
      310   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure cur-time :
      312      define output parameter p-today as date      no-undo .
      313      define output parameter p-time  as integer   no-undo .
      314     do
      315     on error undo, return error
      316     :
      317       define variable v-date1 as date      no-undo .
      318       define variable v-date2 as date      no-undo .
      319       define variable v-time  as integer   no-undo .
      320       assign
      321         v-date1 = today
      322         v-time  = time
      323         v-date2 = today
      324       .
      325       if v-date1 <> v-date2
      326       then do:
      327         assign
      328           v-date1 = today
      329           v-time  = v-time
      330         .
      331       end.
      332       assign
      333         p-today = v-date1
      334         p-time  = v-time
      335       .
      336     end.
      337   end.
      338   function cur-time-date returns character
      339   :
      340     return string(today, '99/99/9999':U) .
      341   end.
      342   function cur-time-mjd returns decimal
      343   :
      344     define variable v-date as date      no-undo .
      345     define variable v-time as integer   no-undo .
      346     run cur-time in this-procedure
      347       (output v-date
      348       ,output v-time
      349       ) .
      350     return integer(v-date) - 2400002 + (v-time / 86400) .
      351   end.
      352   function cur-time-get-ending-index returns integer
      353   (input p-number as integer
      354   )
      355   :
      356     if p-number < 0
      357     or p-number = ?
      358     then do:
      359       return 1 .
      360     end.
      361     define variable v-rest as integer   no-undo .
      362     assign
      363       p-number = p-number modulo 100
      364     .
      365     if p-number < 20
      366     then do:
      367       assign
      368         v-rest = p-number
      369       .
      370     end.
      371     else do:
      372       assign
      373         v-rest = p-number modulo 10
      374       .
      375     end.
      376     case v-rest :
      377       when 1
      378       then do:
      379         return 2 .
      380       end.
      381       when 2 or
      382       when 3 or
      383       when 4
      384       then do:
      385         return 3 .
      386       end.
      387       otherwise do:
      388         return 1 .
      389       end.
      390     end case .
      391   end.
      392   procedure cur-time-mjd-to-date :
      393      define input  parameter i-mjd-diff as decimal no-undo.
      394      define output parameter o-Date     as date    no-undo.
      395      define output parameter o-Time     as integer no-undo.
      396      define variable v-day-number as integer   no-undo .
      397      if    i-mjd-diff < 0
      398         or i-mjd-diff = ?
      399      then do:
      400         return "?" .
      401      end.
      402      assign
      403         v-day-number = truncate(i-mjd-diff,0).
      404         o-Date = date(v-day-number + 2400002).
      405         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      406     .
      407   end.
      408   function cur-time-mjd-to-string returns character
      409   (input p-mjd-diff as decimal
      410   )
      411   :
      412     define variable v-day-number as integer   no-undo .
      413     define variable v-seconds    as integer   no-undo .
      414     define variable v-hour       as integer   no-undo .
      415     define variable v-min        as integer   no-undo .
      416     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      417     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      418     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      419     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      420     if p-mjd-diff < 0
      421     or p-mjd-diff = ?
      422     then do:
      423       return "?" .
      424     end.
      425     assign
      426       v-day-number = integer(truncate(p-mjd-diff,0))
      427       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      428     .
      429     if v-seconds > 86400
      430     then do:
      431       assign
      432         v-seconds = 86400 - 1
      433       .
      434     end.
      435     if v-seconds < 0
      436     then do:
      437       assign
      438         v-seconds = 0
      439       .
      440     end.
      441     assign
      442       v-hour = truncate(v-seconds / 3600, 0)
      443     .
      444     assign
      445       v-seconds = v-seconds modulo 3600
      446     .
      447     assign
      448       v-min = truncate(v-seconds / 60, 0)
      449     .
      450     assign
      451       v-seconds = v-seconds modulo 60
      452     .
      453     return
      454         (if v-day-number <> 0
      455           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      456           else ""
      457         )
      458       + (if v-day-number <> 0 or v-hour <> 0
      459           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      460           else ""
      461         )
      462       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      463           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      464           else ""
      465         )
      466       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      467       .
      468   end.
      469   function cur-time-string returns character
      470   :
      471     define variable v-date as date      no-undo .
      472     define variable v-time as integer   no-undo .
      473     run cur-time in this-procedure
      474       (output v-date
      475       ,output v-time
      476       ) .
      477     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      478   end.
      479   function cur-time-string-sec returns character
      480   :
      481     define variable v-date as date      no-undo .
      482     define variable v-time as integer   no-undo .
      483     run cur-time in this-procedure
      484       (output v-date
      485       ,output v-time
      486       ) .
      487     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      488   end.
      489   function cur-time-custom  returns character
      490   (input p-prefix as character
      491   ,input p-date-format as character
      492   ,input p-delimiter as character
      493   ,input p-time-format as character
      494   ,input p-suffix as character
      495   )
      496   :
      497     define variable v-date as date      no-undo .
      498     define variable v-time as integer   no-undo .
      499     run cur-time in this-procedure
      500       (output v-date
      501       ,output v-time
      502       ) .
      503     return
      504       p-prefix
      505       + string(v-date, p-date-format)
      506       + p-delimiter
      507       + string(v-time, p-time-format)
      508       + p-suffix
      509       .
      510   end.
      511   function cur-time-print  returns character
      512   :
      513     define variable v-date as date      no-undo .
      514     define variable v-time as integer   no-undo .
      515     run cur-time in this-procedure
      516       (output v-date
      517       ,output v-time
      518       ) .
      519     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      520   end.
      521   function cur-time-datetime returns datetime
      522   :
      523     define variable v-char as character no-undo .
      524     define variable v-datetime as datetime no-undo .
      525     v-char = cur-time-string().
      526     v-datetime = datetime(v-char).
      527     return  v-datetime.
      528   end.
      529   function cur-time-string-msec returns character
      530   :
      531     define variable v-date as datetime  no-undo .
      532     v-date = now.
      533     return string(v-date) .
      534   end.
      535   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   define variable v-waitfram-action01         as character   no-undo .
      537   define variable v-waitfram-action02         as character   no-undo .
      538   define variable v-waitfram-action03         as character   no-undo .
      539   define variable mWaitFramTextBeg            as character   no-undo.
      540   define variable mWaitFramTextEnd            as character   no-undo.
      541   define variable mWaitFramView               as logical     no-undo.
      542   define variable mWaitProcEvent              as logical     no-undo init yes.
      543   define variable mWaitFramInterval           as integer     no-undo init 1 .
      544   define variable mWaitFramStop               as logical     no-undo.
      545   define variable mWaitFramStopUser           as logical     no-undo.
      546   define variable mWaitFramStopTimeOut        as logical     no-undo.
      547   define variable mWaitFramStartProc          as datetime-tz no-undo.
      548   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      549   define button B-WaitFramStop auto-end-key
      550        label "Стоп"
      551        size 10 by 1 tooltip "Остоновить процесс".
      552   define button B-viewProcInfo
      553        label "Информация"
      554        size 15 by 1 tooltip "Информация о процесс".
      555   define frame waitfram
      556     v-waitfram-action01 format "x(72)" no-label skip
      557     v-waitfram-action02 format "x(72)" no-label skip
      558     v-waitfram-action03 format "x(72)" no-label skip
      559     B-viewProcInfo
      560     B-WaitFramStop at row 4 col 30
      561     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      562     .
      563   define new global shared variable mBatchMode as logical no-undo init ?.
      564   define variable mFramBachModHandle as handle no-undo.
      565   mFramBachModHandle = frame waitfram:handle.
      566   define variable mFameOldVis as logical no-undo.
      567   define variable mVisCUrentVin as logical no-undo.
      568   if session:batch-mode
      569   then
      570      mBatchMode = yes.
      571   if mBatchMode = ? then do:
      572     mVisCUrentVin = current-window:visible.
      573     mFameOldVis = mFramBachModHandle:visible.
      574     mFramBachModHandle:visible  = yes.
      575     mBatchMode = mFramBachModHandle:visible ne yes.
      576     mFramBachModHandle:visible = mFameOldVis.
      577     current-window:visible = mVisCUrentVin.
      578   end.
      579    if  log-manager:logfile-name ne ?
      580     then DO:
      581         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      582         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      583         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      584     end.
      585   on choose of B-WaitFramStop in frame waitfram
      586   do:
      587     mWaitFramStop = yes.
      588     mWaitFramStopUser = yes.
      589   end.
      590   function waitfram-check-timeout returns logical():
      591      define variable vtime as int64 no-undo.
      592      if mWaitFramStopTimeOut
      593      then
      594         return yes.
      595      vtime = ( now - mWaitFramStartProc ) / 1000 .
      596      if     mWaitFramTimeOut ne ?
      597         and mWaitFramTimeOut ne 0
      598         and mWaitFramTimeOut lt vtime
      599      then do:
      600         mWaitFramStopTimeOut = yes.
      601      end.
      602      return mWaitFramStopTimeOut.
      603   end.
      604   procedure waitfram-hide :
      605     if not session:batch-mode
      606     then do
      607     on error undo, return error return-value
      608     :
      609       pause 0 before-hide .
      610       if not mBatchMode then
      611         hide frame waitfram .
      612     if     not mWaitFramView
      613        and mWaitProcEvent
      614     then
      615       process events .
      616     end.
      617   end procedure.
      618   procedure waitfram-show :
      619     define input  parameter p-message as character no-undo .
      620     define variable v-left-margin as integer   no-undo .
      621     if not session:batch-mode
      622     then do
      623     on error undo, return error return-value
      624     :
      625       if length(p-message) <= 70 then do:
      626         assign
      627           v-left-margin = integer((70 - length(p-message)) / 2)
      628         .
      629         assign
      630           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      631         .
      632         assign
      633           v-waitfram-action01 = " "
      634           v-waitfram-action02 = " "
      635                                    + fill(" ", v-left-margin)
      636                                    + p-message
      637           v-waitfram-action03 = " "
      638         .
      639       end.
      640       else do:
      641         define variable vRindex1 as integer no-undo.
      642         define variable vRindex2 as integer no-undo.
      643         vRindex1 = r-index(p-message," ",70).
      644         if vRindex1 = 0
      645         then
      646            vRindex1 = 70.
      647         if length(p-message)  <= vRindex1 + 70 then do:
      648           assign
      649             v-waitfram-action01 = " "
      650             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      651             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      652           .
      653         end.
      654         else do:
      655           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      656           if vRindex2 <= vRindex1
      657           then
      658              vRindex2 = vRindex1 + 70.
      659           assign
      660             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      661             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      662             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      663           .
      664         end.
      665       end.
      666       B-viewProcInfo:visible   in frame waitfram = no.
      667       B-viewProcInfo:sensitive in frame waitfram = no.
      668       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      669       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      670       if  (   mWaitFramView
      671          or  mWaitProcEvent)
      672          and not mBatchMode
      673       then
      674          display
      675             v-waitfram-action01 skip
      676             v-waitfram-action02 skip
      677             v-waitfram-action03 skip
      678          with frame waitfram .
      679       if     mWaitFramView
      680          then do:
      681             if     mWaitFramInterval ne ?
      682                and not mBatchMode
      683             then
      684                wait-for go of frame waitfram pause mWaitFramInterval.
      685          end.
      686          else
      687             if     mWaitProcEvent
      688                and not mBatchMode
      689             then
      690                process events .
      691     end.
      692   end procedure.
      693      procedure waitfram-show-this:
      694         define input  parameter iInterval as int64 no-undo.
      695         define variable vtime as int64 no-undo.
      696         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      697         mWaitFramInterval = iInterval.
      698         run waitfram-show (substitute("&1&2 &3&4" ,
      699                                       mWaitFramTextBeg ,
      700                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      701                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      702                                       mWaitFramTextEnd
      703                                      )
      704                           ).
      705      end.
      706      procedure WaitFramRunPause:
      707         define input  parameter iInterval as dec no-undo.
      708         define variable vStart  as datetime-tz no-undo.
      709         define variable vend    as datetime-tz no-undo.
      710         define variable vint as int64 no-undo.
      711         define variable vOk as logical no-undo.
      712         vStart = now.
      713         vend   = vStart.
      714         publish "WaitFramPause" (iInterval,output vOk).
      715         vend   =  now.
      716         vint = vend - vStart.
      717         vint = iInterval - vint / 1000.
      718         if     not mWaitFramStop
      719            and (   vint > 0
      720                 or (    not vOk
      721                     and iInterval eq ?
      722                     )
      723                 )
      724         then
      725            run waitfram-show-this (iInterval).
      726         vend   =  now.
      727         vint = vend - vStart.
      728         vint = iInterval - vint / 1000.
      729         if     not mWaitFramStop
      730            and vint > 0
      731         then do:
      732            run gbl/pause.p (vint * 1000).
      733         end.
      734         if iInterval ne ?
      735         then
      736            publish "WaitFramStop".
      737         waitfram-check-timeout().
      738      end.
      739      procedure WaitFramWaitFor:
      740         define input  parameter iInterval as dec no-undo.
      741         assign
      742            mWaitFramStartProc   = now
      743            mWaitFramStopUser    = no
      744            mWaitFramStopTimeOut = no
      745         .
      746         block-wait:
      747         do while not mWaitFramStop:
      748            run WaitFramRunPause (iInterval).
      749            if  waitfram-check-timeout()
      750            then do:
      751               leave block-wait.
      752            end.
      753         end.
      754         run waitfram-hide.
      755      end.
      756   procedure waitfram-join :
      757     define input  parameter p-line-1  as character no-undo .
      758     define input  parameter p-line-2  as character no-undo .
      759     define input  parameter p-line-3  as character no-undo .
      760     define output parameter p-message as character no-undo .
      761     do
      762     on error undo, return error return-value
      763     :
      764       assign
      765         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      766                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      767                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      768       .
      769     end.
      770   end procedure.
      771   function waitfram-join-function returns character
      772     (input p-line-1 as character
      773     ,input p-line-2 as character
      774     ,input p-line-3 as character
      775     ).
      776     define variable v-message as character no-undo .
      777     run waitfram-join in this-procedure
      778       (input  p-line-1
      779       ,input  p-line-2
      780       ,input  p-line-3
      781       ,output v-message
      782       ) .
      783     return v-message .
      784   end function .
      785   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786     define variable v-cntxt-db-num        as integer   no-undo .
      787     define variable v-cntxt-userid        as character no-undo .
      788     define variable v-cntxt-level         as character no-undo .
      789     define variable v-cntxt-host-code-obj as integer   no-undo .
      790     define variable v-cntxt-obj-type      as character no-undo .
      791     define variable v-cntxt-obj-code      as integer   no-undo .
      792     define variable v-cntxt-db-num-obj    as integer   no-undo .
      793     define variable v-cntxt-is-admin      as logical   no-undo .
      794   DEFINE BUTTON B-help DEFAULT
      795        LABEL "Помо&щь"
      796        SIZE 10 BY 1
      797        BGCOLOR 8 .
      798   DEFINE BUTTON b-ok AUTO-END-KEY
      799        LABEL "&Выход"
      800        SIZE 10 BY 1.
      801   DEFINE BUTTON B-print DEFAULT
      802        LABEL "&Печать"
      803        SIZE 10 BY 1
      804        BGCOLOR 8 .
      805   DEFINE BUTTON B-trn DEFAULT
      806        LABEL "&Накл."
      807        SIZE 10 BY 1 TOOLTIP "Просмотр накладной"
      808        BGCOLOR 8 .
      809   DEFINE BUTTON B-trn-2 DEFAULT
      810        LABEL "&Исх накл."
      811        SIZE 10 BY 1 TOOLTIP "Просмотр порождающей  накладной"
      812        BGCOLOR 8 .
      813   DEFINE QUERY BR-goods FOR
      814         tt-goods,
      815         clients SCROLLING.
      816   DEFINE QUERY BR-parts FOR
      817         c-fin-gds-part SCROLLING.
      818   DEFINE BROWSE BR-goods
      819     QUERY BR-goods NO-LOCK DISPLAY
      820         tt-goods.gds-type COLUMN-LABEL "Т" FORMAT "X(1)":U
      821         tt-goods.gds-code COLUMN-LABEL "Код!товара" FORMAT "999999999":U
      822         tt-goods.artic FORMAT "X(16)":U
      823         tt-goods.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
      824         tt-goods.unit-cli COLUMN-LABEL "Ед.из!пост." FORMAT "X(3)":U
      825         tt-goods.gds-name FORMAT "X(48)":U
      826         clients.obj-name COLUMN-LABEL "Производитель" FORMAT "X(20)":U
      827         tt-goods.grp-name FORMAT "X(40)":U
      828     ENABLE
      829         tt-goods.gds-type
      830       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 7.33.
      831   DEFINE BROWSE BR-parts
      832     QUERY BR-parts NO-LOCK DISPLAY
      833         c-fin-gds-part.out-code COLUMN-LABEL "№ накл" FORMAT "X(14)":U
      834         c-fin-gds-part.fact-date COLUMN-LABEL "Дата!закрытия" FORMAT "99/99/99":U
      835         c-fin-gds-part.fact-qnty COLUMN-LABEL "Факт!кол-во" FORMAT "->>,>>>,>>9.999":U
      836         c-fin-gds-part.sum-rubl COLUMN-LABEL "Сумма(руб)" FORMAT "->,>>>,>>>,>>>,>>9.99":U
      837         c-fin-gds-part.vat-pc FORMAT ">9.9<%":U
      838         c-fin-gds-part.vat-type FORMAT "X(8)":U
      839         c-fin-gds-part.SLT-pc FORMAT ">9.9<%":U
      840         c-fin-gds-part.SLT-type FORMAT "X(8)":U
      841         c-fin-gds-part.in-code FORMAT "X(14)":U
      842         c-fin-gds-part.obj-code FORMAT "99999":U
      843         c-fin-gds-part.obj-type FORMAT "X(3)":U
      844         c-fin-gds-part.sum-base COLUMN-LABEL "Сумма(б.в.)" FORMAT "->,>>>,>>>,>>>,>>9.99":U
      845         c-fin-gds-part.part-code COLUMN-LABEL "№ партии" FORMAT "X(5)":U
      846         c-fin-gds-part.user-name COLUMN-LABEL "Создал" FORMAT "X(8)":U
      847     ENABLE
      848         c-fin-gds-part.part-code
      849       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 8.92
      850            TITLE "Партии товара".
      851   DEFINE FRAME Dialog-Frame
      852        b-ok AT ROW 1 COL 1
      853        B-print AT ROW 1 COL 78
      854        B-help AT ROW 1 COL 88
      855        BR-goods AT ROW 2.04 COL 1
      856        BR-parts AT ROW 10.33 COL 1
      857        B-trn AT ROW 19.46 COL 1.25
      858        B-trn-2 AT ROW 19.58 COL 87.63
      859        SPACE(0.62) SKIP(0.58)
      860       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      861            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      862            TITLE "Партии документа".
      863   ASSIGN
      864          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      865          FRAME Dialog-Frame:HIDDEN           = TRUE.
      866   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      867   DO:
      868     APPLY "END-ERROR":U TO SELF.
      869   END.
      870   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      871   DO:
      872     run proc-print in this-procedure .
      873     OPEN QUERY BR-goods FOR EACH tt-goods NO-LOCK,       EACH clients WHERE clients.obj-code = tt-goods.prod-code   AND clients.obj-type = tt-goods.prod-type NO-LOCK.    OPEN QUERY BR-parts FOR EACH c-fin-gds-part       WHERE c-fin-gds-part.fin-ob-code = p-fin-doc-code and ub.c-fin-gds-part.host-code   = p-host-code and ub.c-fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
      874   END.
      875   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      876   DO:
      877     if available c-fin-gds-part and  c-fin-gds-part.out-code <> "" then do:
      878         run str/fishdoc.p (
      879                   input parParentProc ,
      880                   input c-fin-gds-part.host-code ,
      881                   input c-fin-gds-part.obj-type,
      882                   input c-fin-gds-part.obj-code,
      883                   input c-fin-gds-part.out-code ,
      884                   input c-fin-gds-part.gds-code ) .
      885   end.
      886   END.
      887   ON CHOOSE OF B-trn-2 IN FRAME Dialog-Frame
      888   DO:
      889   define buffer buf_parts-attr for ub.parts-attr.
      890     if available c-fin-gds-part and  c-fin-gds-part.in-code <> "" then do:
      891        find first buf_parts-attr no-lock where
      892                   buf_parts-attr.in-code      = c-fin-gds-part.in-code  and
      893                   buf_parts-attr.part-code    = c-fin-gds-part.part-code and
      894                   buf_parts-attr.gds-code     = c-fin-gds-part.gds-code
      895                   no-error .
      896                   if available buf_parts-attr then
      897                       run str/fishdoc.p (
      898                        input  parparentproc ,
      899                        input  c-fin-gds-part.host-code ,
      900                        input  c-fin-gds-part.obj-type,
      901                        input  c-fin-gds-part.obj-code,
      902                        input  buf_parts-attr.income-in-code ,
      903                        input  c-fin-gds-part.gds-code
      904                             ) .
      905                       else
      906                       run str/fishdoc.p (
      907                       input parparentproc ,
      908                       input c-fin-gds-part.host-code ,
      909                       input c-fin-gds-part.obj-type,
      910                       input c-fin-gds-part.obj-code,
      911                       input c-fin-gds-part.in-code ,
      912                       input c-fin-gds-part.gds-code
      913                             ) .
      914   end.
      915   end.
      916   ON VALUE-CHANGED OF BR-goods IN FRAME Dialog-Frame
      917   DO:
      918     OPEN QUERY BR-parts FOR EACH c-fin-gds-part       WHERE c-fin-gds-part.fin-ob-code = p-fin-doc-code and ub.c-fin-gds-part.host-code   = p-host-code and ub.c-fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
      919   END.
      920   on F9 of frame dialog-frame anywhere do:
      921     run show-gds in this-procedure .
      922     return no-apply.
      923   END.
      924   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
