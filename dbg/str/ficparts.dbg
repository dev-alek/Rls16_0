     1630         .
     1631         do while valid-handle(v-object-handle)
     1632         :
     1633           if  v-object-handle <> v-diasize-browse-handle :handle
     1634           and v-object-handle <> v-diasize-resize-button
     1635           and can-query(v-object-handle, "row")
     1636           and can-query(v-object-handle, "height")
     1637           and ( v-object-handle :col + v-object-handle :width
     1638                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1639               )
     1640           then do:
     1641             find first buf_temp-browse-handle
     1642               where buf_temp-browse-handle.browse-type   = 'width':u
     1643                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1644               no-error .
     1645             if available buf_temp-browse-handle
     1646             then do:
     1647             end.
     1648             else do:
     1649               create buf_temp-diasize-handle .
     1650               assign
     1651                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1652                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1653               .
     1654             end.
     1655           end.
     1656           assign
     1657             v-object-handle = v-object-handle :next-sibling
     1658           .
     1659         end.
     1660         assign
     1661           v-field-group-handle = v-field-group-handle :next-sibling
     1662         .
     1663       end.
     1664       do with frame Dialog-Frame
     1665       :
     1666         hide v-diasize-resize-button .
     1667         v-diasize-resize-button :row = 1.
     1668         v-diasize-resize-button :column = 1.
     1669       end.
     1670       if p-change-value > 0
     1671       then do:
     1672         if frame Dialog-Frame :scrollable = true
     1673         then do:
     1674           assign
     1675             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block.
     1681           end.
     1682         end.
     1683         assign
     1684           frame Dialog-Frame :width = v-frame-width + p-change-value
     1685           no-error .
     1686         if error-status :error
     1687         or error-status :get-message(1) <> ""
     1688         then do:
     1689           undo move_block, retry move_block.
     1690         end.
     1691         assign
     1692           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1693         no-error .
     1694         if error-status :error
     1695         or error-status :get-message(1) <> ""
     1696         then do:
     1697           undo move_block, retry move_block.
     1698         end.
     1699         for each buf_temp-browse-handle
     1700           where buf_temp-browse-handle.browse-type = 'width':u
     1701         on error undo move_block, retry move_block
     1702         :
     1703           assign
     1704             buf_temp-browse-handle.browse-handle :width
     1705               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1706             no-error .
     1707           if error-status :error
     1708           or error-status :get-message(1) <> ""
     1709           then do:
     1710             undo move_block, retry move_block .
     1711           end.
     1712         end.
     1713         for each buf_temp-diasize-handle
     1714         on error undo move_block, retry move_block
     1715         :
     1716           assign
     1717             v-object-handle = buf_temp-diasize-handle.handle-value
     1718           .
     1719           if v-object-handle <> v-diasize-resize-button
     1720           then do:
     1721             assign
     1722               v-object-handle :col = v-object-handle :col + p-change-value
     1723               no-error .
     1724             if error-status :error
     1725             or error-status :get-message(1) <> ""
     1726             then do:
     1727               undo move_block, retry move_block .
     1728             end.
     1729           end.
     1730         end.
     1731       end.
     1732       else do:
     1733         for each buf_temp-diasize-handle
     1734         on error undo move_block, retry move_block
     1735         :
     1736           assign
     1737             v-object-handle = buf_temp-diasize-handle.handle-value
     1738           .
     1739           if v-object-handle <> v-diasize-resize-button
     1740           then do:
     1741             assign
     1742               v-object-handle :col = v-object-handle :col + p-change-value
     1743               no-error .
     1744             if error-status :error
     1745             or error-status :get-message(1) <> ""
     1746             then do:
     1747               undo move_block, retry move_block .
     1748             end.
     1749           end.
     1750         end.
     1751         for each buf_temp-browse-handle
     1752           where buf_temp-browse-handle.browse-type = 'width':u
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             buf_temp-browse-handle.browse-handle :width
     1757               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1758             no-error .
     1759           if error-status :error
     1760           or error-status :get-message(1) <> ""
     1761           then do:
     1762             undo move_block, retry move_block .
     1763           end.
     1764         end.
     1765         assign
     1766           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1767           no-error .
     1768         if error-status :error
     1769         or error-status :get-message(1) <> ""
     1770         then do:
     1771           undo move_block, retry move_block.
     1772         end.
     1773         assign
     1774           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1775         no-error .
     1776         if error-status :error
     1777         or error-status :get-message(1) <> ""
     1778         then do:
     1779           undo move_block, retry move_block.
     1780         end.
     1781         if frame Dialog-Frame :scrollable = true
     1782         then do:
     1783           assign
     1784             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1785           no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block.
     1790           end.
     1791         end.
     1792       end.
     1793       if p-move-resize
     1794       then do:
     1795         run diasize_position-resize-button in this-procedure .
     1796       end.
     1797       if v-diasize-wndstore = true
     1798       then do:
     1799         if connected("ub") = true
     1800         then do:
     1801           define variable v-cntxt-db-num        as integer   no-undo .
     1802           define variable v-cntxt-userid        as character no-undo .
     1803           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1804                                             , OUTPUT v-cntxt-userid
     1805                                             ) .
     1806           run gbl/wndsizew.p
     1807             (input  v-cntxt-db-num
     1808             ,input  v-cntxt-userid
     1809             ,input  v-diasize-proc-name
     1810             ,input  'width':u
     1811             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1812             ) .
     1813         end.
     1814       end.
     1815     end.
     1816     assign
     1817       v-diasize-change-size = false
     1818     .
     1819   end procedure.
     1820   procedure diasize_set-width :
     1821     define input  parameter p-new-width  as decimal   no-undo .
     1822     define input  parameter p-move-resize as logical   no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       run diasize_change-width in this-procedure
     1827         (input  (p-new-width - frame Dialog-Frame :width)
     1828         ,input  p-move-resize
     1829         ) .
     1830     end.
     1831   end procedure.
     1832   procedure diasize_position-resize-button :
     1833     do with frame Dialog-Frame
     1834     :
     1835       hide v-diasize-resize-button .
     1836       assign
     1837         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1838                     - 1
     1839                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1840         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1841                     - 1
     1842                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1843       .
     1844       view v-diasize-resize-button .
     1845     end.
     1846   end procedure.
     1847   on alt-right anywhere
     1848   do:
     1849     run diasize_change-width in this-procedure
     1850       (input 1
     1851       ,input true
     1852       ) .
     1853     return no-apply .
     1854   end.
     1855   on alt-left anywhere
     1856   do:
     1857     run diasize_change-width in this-procedure
     1858       (input -1
     1859       ,input true
     1860       ) .
     1861     return no-apply .
     1862   end.
     1863   on alt-down anywhere
     1864   do:
     1865     run diasize_change-height in this-procedure
     1866       (input 1
     1867       ,input true
     1868       ) .
     1869     return no-apply .
     1870   end.
     1871   on alt-up anywhere
     1872   do:
     1873     run diasize_change-height in this-procedure
     1874       (input -1
     1875       ,input true
     1876       ) .
     1877     return no-apply .
     1878   end.
     1879   on alt-enter of frame Dialog-Frame
     1880   do:
     1881     run diasize_maximize in this-procedure
     1882       (input  ?
     1883       ).
     1884     return no-apply .
     1885   end.
     1886   procedure diasize_end-move :
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       define variable v-row-delta as decimal   no-undo .
     1891       define variable v-col-delta as decimal   no-undo .
     1892       define variable v-new-row as decimal   no-undo .
     1893       define variable v-new-col as decimal   no-undo .
     1894       assign
     1895         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1896         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1897       .
     1898       assign
     1899         v-row-delta = v-new-row - frame Dialog-Frame :height
     1900         v-col-delta = v-new-col - frame Dialog-Frame :width
     1901       .
     1902       run diasize_change-height in this-procedure
     1903         (input v-row-delta
     1904         ,input true
     1905         ) .
     1906       run diasize_change-width in this-procedure
     1907         (input v-col-delta
     1908         ,input true
     1909         ) .
     1910     end.
     1911   end procedure.
     1912   procedure diasize_maximize :
     1913     define input  parameter p-action as logical   no-undo .
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       if p-action = ?
     1918       then do:
     1919         if v-diasize-need-maximize = true
     1920         then do:
     1921           assign
     1922             p-action = true
     1923           .
     1924         end.
     1925         else do:
     1926           assign
     1927             p-action = false
     1928           .
     1929         end.
     1930       end.
     1931       if p-action = true
     1932       then do:
     1933         run diasize_change-height in this-procedure
     1934           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1935               - frame Dialog-Frame :height-chars
     1936           ,input true
     1937           ) .
     1938         run diasize_change-width in this-procedure
     1939           (input session :width-chars
     1940               - frame Dialog-Frame :width-chars
     1941           ,input true
     1942           ) .
     1943         assign
     1944           v-diasize-need-maximize = false
     1945         .
     1946       end.
     1947       else do:
     1948         run diasize_change-width in this-procedure
     1949           (input v-diasize-orig-frame-width
     1950               - frame Dialog-Frame :width-chars
     1951           ,input true
     1952           ) .
     1953         run diasize_change-height in this-procedure
     1954           (input v-diasize-orig-frame-height
     1955               - frame Dialog-Frame :height-chars
     1956           ,input true
     1957           ) .
     1958         assign
     1959           v-diasize-need-maximize = true
     1960         .
     1961       end.
     1962     end.
     1963   end procedure.
     1964   procedure diasize_restore-orig-size :
     1965     do
     1966     on error undo, return error return-value
     1967     :
     1968       assign
     1969         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1970         v-diasize-current-frame-height = frame Dialog-Frame :height
     1971       .
     1972       run diasize_set-height in this-procedure
     1973         (input  v-diasize-orig-frame-height
     1974         ,input  true
     1975         ) .
     1976       run diasize_set-width in this-procedure
     1977         (input  v-diasize-orig-frame-width
     1978         ,input  true
     1979         ) .
     1980     end.
     1981   end procedure.
     1982   procedure diasize_restore-current-size :
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986       run diasize_set-height in this-procedure
     1987         (input  v-diasize-current-frame-height
     1988         ,input  true
     1989         ) .
     1990       run diasize_set-width in this-procedure
     1991         (input  v-diasize-current-frame-width
     1992         ,input  true
     1993         ) .
     1994     end.
     1995   end procedure.
     1996   procedure diasize_set-browse-handle :
     1997     define input  parameter p-browse-handle as handle   no-undo .
     1998     define buffer buf_temp-browse-handle for temp-browse-handle .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       assign
     2003         v-diasize-browse-handle = p-browse-handle
     2004       .
     2005       for each buf_temp-browse-handle
     2006       on error undo, return error return-value
     2007       :
     2008         delete buf_temp-browse-handle .
     2009       end.
     2010     end.
     2011   end procedure.
     2012   procedure diasize_add_browse :
     2013     define input  parameter p-browse-type   as character no-undo .
     2014     define input  parameter p-browse-handle as handle    no-undo .
     2015     define buffer buf_temp-browse-handle for temp-browse-handle .
     2016     do
     2017     on error undo, return error return-value
     2018     :
     2019       assign
     2020         v-diasize-browse-number = v-diasize-browse-number + 1
     2021       .
     2022       create buf_temp-browse-handle .
     2023       assign
     2024         buf_temp-browse-handle.browse-type   = p-browse-type
     2025         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2026         buf_temp-browse-handle.browse-handle = p-browse-handle
     2027       .
     2028     end.
     2029   end procedure.
     2030   procedure diasize_init :
     2031     define variable v-default-value    as logical   no-undo .
     2032     define variable v-restore-saved    as logical   no-undo .
     2033     define variable v-resize-value-str as character no-undo .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       do with frame Dialog-Frame
     2038       :
     2039         assign
     2040           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2041           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2042           v-diasize-browse-handle     = browse br-goods :handle
     2043         .
     2044         create button v-diasize-resize-button
     2045         assign
     2046           parent        = frame Dialog-Frame :first-child
     2047           label         = "s"
     2048           height-pixels = 16
     2049           width-pixels  = 16
     2050           visible       = true
     2051           sensitive     = true
     2052           movable       = true
     2053           triggers:
     2054             on end-move persistent run diasize_end-move in this-procedure .
     2055           end triggers.
     2056         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2057         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2058         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2059         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2060         assign
     2061           v-diasize-wndmax = false
     2062         .
     2063         if connected("ub") = true
     2064         then do:
     2065           define variable v-cntxt-db-num        as integer   no-undo .
     2066           define variable v-cntxt-userid        as character no-undo .
     2067           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2068                                             , OUTPUT v-cntxt-userid
     2069                                             ) .
     2070           run gbl/wndpar_r.p
     2071             (input  v-cntxt-db-num
     2072             ,input  v-cntxt-userid
     2073             ,input  'wndmax':U
     2074             ,output v-diasize-wndmax
     2075             ,output v-default-value
     2076             ) .
     2077         end.
     2078         assign
     2079           v-diasize-wndstore = false
     2080         .
     2081         if connected("ub") = true
     2082         then do:
     2083           run gbl/wndpar_r.p
     2084             (input  v-cntxt-db-num
     2085             ,input  v-cntxt-userid
     2086             ,input  'wndstore':U
     2087             ,output v-diasize-wndstore
     2088             ,output v-default-value
     2089             ) .
     2090         end.
     2091         assign
     2092           v-diasize-proc-name = entry(1, program-name(2), '.')
     2093         .
     2094         if v-diasize-wndstore = true
     2095         then do:
     2096           assign
     2097             v-restore-saved = false
     2098           .
     2099           if connected("ub") = true
     2100           then do:
     2101             run gbl/wndsizer.p
     2102               (input  v-cntxt-db-num
     2103               ,input  v-cntxt-userid
     2104               ,input  v-diasize-proc-name
     2105               ,input  'height':u
     2106               ,output v-resize-value-str
     2107               ) .
     2108             if v-resize-value-str <> '':U
     2109             then do:
     2110               run diasize_change-height in this-procedure
     2111                 (input  integer(v-resize-value-str)
     2112                 ,input  true
     2113                 ) .
     2114               assign
     2115                 v-restore-saved = true
     2116               .
     2117             end.
     2118           end.
     2119           if connected("ub") = true
     2120           then do:
     2121             run gbl/wndsizer.p
     2122               (input  v-cntxt-db-num
     2123               ,input  v-cntxt-userid
     2124               ,input  v-diasize-proc-name
     2125               ,input  'width':u
     2126               ,output v-resize-value-str
     2127               ) .
     2128             if v-resize-value-str <> '':U
     2129             then do:
     2130               run diasize_change-width in this-procedure
     2131                 (input  integer(v-resize-value-str)
     2132                 ,input  true
     2133                 ) .
     2134               assign
     2135                 v-restore-saved = true
     2136               .
     2137             end.
     2138           end.
     2139           if v-restore-saved <> true
     2140           then do:
     2141             if v-diasize-wndmax = true
     2142             then do:
     2143               run diasize_maximize in this-procedure
     2144                 (input  true
     2145                 ) .
     2146             end.
     2147           end.
     2148         end.
     2149         else do:
     2150           if v-diasize-wndmax = true
     2151           then do:
     2152             run diasize_maximize in this-procedure
     2153               (input  true
     2154               ) .
     2155           end.
     2156         end.
     2157       end.
     2158     end.
     2159   end procedure.
     2160   procedure diasize_need-full-display :
     2161     define output parameter p-need-full-display as logical   no-undo .
     2162     do
     2163     on error undo, return error return-value
     2164     :
     2165       assign
     2166         p-need-full-display = v-diasize-need-full-display
     2167       .
     2168       assign
     2169         v-diasize-need-full-display = false
     2170       .
     2171     end.
     2172   end procedure.
     2173   procedure get-context :
     2174      define output parameter p-db-num as integer          no-undo.
     2175      define output parameter p-user-id as character        no-undo.
     2176      define variable v-login               as character    no-undo.
     2177      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2178      define buffer buf_user-login  for ub.user-login .
     2179      do
     2180      on error undo, return error
     2181      :
     2182            FIND FIRST buf_sys-ctrl no-lock.
     2183            ASSIGN
     2184               v-login = USERID("ub")
     2185               p-db-num = buf_sys-ctrl.db-num
     2186            .
     2187            FIND FIRST buf_user-login
     2188                 WHERE buf_user-login.db-num = p-db-num
     2189                   AND buf_user-login.user-login = v-login
     2190                 no-lock
     2191                 no-error
     2192                 .
     2193            IF AVAILABLE buf_user-login
     2194            THEN DO:
     2195               assign
     2196                  p-user-id = buf_user-login.user-id
     2197               .
     2198            END.
     2199      end.
     2200   end procedure.
     2201   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2202   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2203   MAIN-BLOCK:
     2204   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2205      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2206   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2207     run mainmenu_getcntxt in parparentproc
     2208       (output v-cntxt-db-num
     2209       ,output v-cntxt-userid
     2210       ,output v-cntxt-level
     2211       ,output v-cntxt-host-code-obj
     2212       ,output v-cntxt-obj-type
     2213       ,output v-cntxt-obj-code
     2214       ,output v-cntxt-db-num-obj
     2215       ,output v-cntxt-is-admin
     2216       ) .
     2217     run make-tt-goods in this-procedure .
     2218     run enable_ui in this-procedure .
     2219   run diasize_add_browse in this-procedure
     2220       (input  'width':u
     2221       ,input  browse br-parts :handle
     2222       ) .
     2223   run diasize_init in this-procedure .
     2224   tt-goods.gds-name:resizable in browse BR-goods   = true .
     2225   clients.obj-name:resizable in browse BR-goods   = true .
     2226   tt-goods.grp-name:resizable in browse BR-goods   = true .
     2227     WAIT-FOR GO OF FRAME Dialog-Frame.
     2228   END.
     2229   run disable_ui in this-procedure .
     2230   PROCEDURE disable_UI :
     2231     HIDE FRAME Dialog-Frame.
     2232   END PROCEDURE.
     2233   PROCEDURE enable_UI :
     2234     ENABLE b-ok B-print B-help BR-goods BR-parts B-trn B-trn-2
     2235         WITH FRAME Dialog-Frame.
     2236     VIEW FRAME Dialog-Frame.
     2237     OPEN QUERY BR-goods FOR EACH tt-goods NO-LOCK,       EACH clients WHERE clients.obj-code = tt-goods.prod-code   AND clients.obj-type = tt-goods.prod-type NO-LOCK.    OPEN QUERY BR-parts FOR EACH c-fin-gds-part       WHERE c-fin-gds-part.fin-ob-code = p-fin-doc-code and ub.c-fin-gds-part.host-code   = p-host-code and ub.c-fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
     2238   END PROCEDURE.
     2239   PROCEDURE make-tt-goods :
     2240   ASSIGN frame Dialog-Frame:TITLE =
     2241    "Партии по документу Внутр.№ " + string(p-fin-doc-code)  +
     2242    "   ФИРМА: "  +  string(p-host-code)
     2243    .
     2244   define buffer buf_c-fin-gds-part for ub.c-fin-gds-part .
     2245   define buffer buf_goods for ub.goods .
     2246   for each tt-goods : delete tt-goods. end.
     2247   for each buf_c-fin-gds-part no-lock where
     2248       buf_c-fin-gds-part.host-code = p-host-code and
     2249       buf_c-fin-gds-part.fin-ob-code  = p-fin-doc-code :
     2250       if not can-find (first tt-goods where tt-goods.gds-code = buf_c-fin-gds-part.gds-code ) then do:
     2251         find first buf_goods where buf_goods.gds-code = buf_c-fin-gds-part.gds-code no-lock no-error .
     2252         if available buf_goods then do:
     2253             create tt-goods.
     2254             BUFFER-COPY buf_goods TO tt-goods .
     2255         end.
     2256       end.
     2257   end.
     2258     tt-goods.gds-type :read-only in browse br-goods = true .
     2259     c-fin-gds-part.part-code :read-only in browse br-parts = true .
     2260   END PROCEDURE.
     2261   PROCEDURE proc-print :
     2262   do
     2263    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2264    :
     2265   define variable g-log as logical no-undo .
     2266   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2267   do:
     2268     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2269       (input  v-cntxt-db-num
     2270       ,input  v-cntxt-userid
     2271       ,input  0
     2272       ,input  'actn_fin-liability_print':U
     2273       ,input  'firm':U
     2274       ,input  p-host-code
     2275       ,input  '':U
     2276       ,input  0
     2277       ,input  0
     2278       ,input  0
     2279       ,input  0
     2280       ,input  true
     2281       ,output g-log
     2282       )  .
     2283   end.
     2284   if not g-log then  return .
     2285   define variable date_string     as      char    no-undo.
     2286   define variable Line                as      char    no-undo.
     2287   define variable for-time as char.
     2288   DEFINE FRAME prt-frame
     2289         tt-goods.gds-code      COLUMN-LABEL "Код!товара" FORMAT "999999999":U
     2290         tt-goods.unit-base     COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     2291         tt-goods.gds-name      FORMAT "X(25)":U
     2292         c-fin-gds-part.status_dop   FORMAT "X(6)":U
     2293         c-fin-gds-part.out-code  COLUMN-LABEL "№ накл" FORMAT "X(14)":U
     2294         c-fin-gds-part.fact-date COLUMN-LABEL "Дата!закрытия" FORMAT "99/99/99":U
     2295         c-fin-gds-part.fact-qnty COLUMN-LABEL "Факт!кол-во" FORMAT "->>,>>>,>>9.999":U
     2296         c-fin-gds-part.sum-rubl  COLUMN-LABEL "Сумма(руб)" FORMAT "->,>>>,>>>,>>>,>>9.99":U
     2297         c-fin-gds-part.vat-pc    FORMAT ">9.9<%":U
     2298         c-fin-gds-part.SLT-pc    FORMAT ">9.9<%":U
     2299         c-fin-gds-part.obj-code  FORMAT "99999":U
     2300         c-fin-gds-part.obj-type  FORMAT "X(3)":U
     2301         c-fin-gds-part.in-code   FORMAT "X(14)":U COLUMN-LABEL "№ док.в парт."
     2302         c-fin-gds-part.part-code COLUMN-LABEL "№ партии" FORMAT "X(5)":U
     2303         c-fin-gds-part.user-name COLUMN-LABEL "Создал" FORMAT "X(8)":U
     2304           HEADER  date_string AT 5 format "X(35)"
     2305                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     2306                       Line format "X(165)" AT 1
     2307       with width 232 down stream-io use-text    .
     2308       Line = fill("-", 225).
     2309       date_string = cur-time-print() .
     2310       run prn-lib-open-stream in this-procedure (
     2311          input parParentProc
     2312         ,input 43
     2313         ,input yes
     2314         ,input no
     2315         ).
     2316       PUT  STREAM PrnLibStream
     2317       SPACE(25) ( frame Dialog-Frame:title )
     2318       format "x(116)" SKIP(1) .
     2319       FORM HEADER
     2320               Line format "X(177)" AT 1 SKIP
     2321               "Продолжение - на следующей странице" AT 30 SKIP
     2322               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2323       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2324       FORM with FRAME prt-frame  .
     2325       run waitfram-show in this-procedure ("Ждите...").
     2326       find first tt-goods no-lock no-error .
     2327        for each tt-goods
     2328            on error undo, return error :
     2329               OPEN QUERY BR-parts FOR EACH c-fin-gds-part       WHERE c-fin-gds-part.fin-ob-code = p-fin-doc-code and ub.c-fin-gds-part.host-code   = p-host-code and ub.c-fin-gds-part.gds-code    = tt-goods.gds-code NO-LOCK.
     2330               DO WHILE available c-fin-gds-part :
     2331                   Display STREAM PrnLibStream
     2332                     tt-goods.gds-code
     2333                     tt-goods.unit-base
     2334                     tt-goods.gds-name
     2335                     c-fin-gds-part.status_dop
     2336                     c-fin-gds-part.out-code
     2337                     c-fin-gds-part.fact-date
     2338                     c-fin-gds-part.fact-qnty
     2339                     c-fin-gds-part.sum-rubl
     2340                     c-fin-gds-part.vat-pc
     2341                     c-fin-gds-part.SLT-pc
     2342                     c-fin-gds-part.obj-code
     2343                     c-fin-gds-part.obj-type
     2344                     c-fin-gds-part.in-code
     2345                     c-fin-gds-part.part-code
     2346                     c-fin-gds-part.user-name
     2347                       with FRAME prt-frame .
     2348                       DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     2349                       GET next br-parts.
     2350                 END.
     2351        end.
     2352         UNDERLINE  STREAM PrnLibStream
     2353              tt-goods.gds-code
     2354              tt-goods.unit-base
     2355              tt-goods.gds-name
     2356              c-fin-gds-part.status_dop
     2357              c-fin-gds-part.out-code
     2358              c-fin-gds-part.fact-date
     2359              c-fin-gds-part.fact-qnty
     2360              c-fin-gds-part.sum-rubl
     2361              c-fin-gds-part.vat-pc
     2362              c-fin-gds-part.SLT-pc
     2363              c-fin-gds-part.obj-code
     2364              c-fin-gds-part.obj-type
     2365              c-fin-gds-part.in-code
     2366              c-fin-gds-part.part-code
     2367              c-fin-gds-part.user-name
     2368       with FRAME prt-frame .
     2369       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2370       HIDE  STREAM PrnLibStream FRAME CheckList.
     2371       output  STREAM PrnLibStream CLOSE.
     2372       run waitfram-hide in this-procedure .
     2373       run prn-lib-prn-file in this-procedure (
     2374           input parParentProc
     2375          ,input 8
     2376           ).
     2377    end.
     2378   end procedure.
     2379   PROCEDURE show-gds :
     2380   do
     2381    on error undo, return error return-value
     2382    :
     2383     define buffer buf_goods for ub.goods.
     2384     define variable gds-rec as recid no-undo.
     2385     if not available tt-goods then  return no-apply.
     2386     find first buf_goods where buf_goods.gds-code = tt-goods.gds-code no-lock no-error .
     2387     if not available buf_goods then  return no-apply.
     2388     gds-rec = recid (Buf_goods).
     2389     find first shop where shop.host-code = p-host-code  no-lock no-error .
     2390     if available shop then
     2391        run str/showgds.p ( input parParentProc
     2392                           ,input ?
     2393                           ,input buf_goods.gds-code
     2394                           ,input 'ПРОСМОТР':U ) .
     2395     apply "entry" to br-goods in frame Dialog-Frame.
     2396   end.
     2397   END PROCEDURE.
