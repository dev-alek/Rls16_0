      943   end.
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   procedure minbtn-set :
      946       do
      947           on error undo, return error return-value
      948           :
      949           define variable ii              as integer       no-undo .
      950           define variable fh              as widget-handle no-undo .
      951           define variable hh              as widget-handle no-undo .
      952           define variable v-h             as handle        extent 4 no-undo .
      953           define variable v-name-button   as character     no-undo .
      954           define variable v-help-old-x    as decimal       no-undo .
      955           define variable v-help-old-y    as decimal       no-undo .
      956           define variable v-help-old-size as decimal       no-undo .
      957           define variable v-frame-width   as decimal       no-undo .
      958           define variable jj              as integer       no-undo .
      959           do
      960               on error undo, return error
      961               :
      962               assign
      963                   v-frame-width = frame Dialog-Frame:width - 0.3
      964                   fh            = frame Dialog-Frame:first-child
      965                   hh            = fh:first-child
      966                   ii            = 1
      967                   .
      968               do while valid-handle(hh):
      969                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      970                   do:
      971                       case lc(hh:name) :
      972                           when "b-help" then
      973                               do:
      974                                   hh:load-image-up("cmp/b-help.bmp":u) .
      975                                   hh:load-image-down("cmp/b-help.bmp":u) .
      976                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      977                                   hh:TOOLTIP = "Помощь" .
      978                                   v-help-old-x = hh:column .
      979                                   v-help-old-y = hh:row    .
      980                                   v-help-old-size = hh:width .
      981                                   hh:width-chars = 2.5 .
      982                               end.
      983                           when "b-print" then
      984                               do:
      985                                   hh:load-image("cmp/b-print.bmp":u) .
      986                                   hh:TOOLTIP = "Печать" .
      987                                   v-h[ii] = hh:handle .
      988                                   ii = ii + 1 .
      989                                   hh:width-chars = 3 .
      990                               end.
      991                           when "b-history" or
      992                           when "b-hist" then
      993                               do:
      994                                   hh:load-image("cmp/b-hist.bmp":u) .
      995                                   hh:TOOLTIP = "История" .
      996                                   v-h[ii] = hh:handle .
      997                                   ii = ii + 1 .
      998                                   hh:width-chars = 3 .
      999                               end.
     1000                           when "b-sch" then
     1001                               do:
     1002                                   hh:load-image("cmp/b-sch.bmp":u) .
     1003                                   hh:TOOLTIP = "Установка Фильтра" .
     1004                                   v-h[ii] = hh:handle .
     1005                                   ii = ii + 1 .
     1006                                   hh:width-chars = 3 .
     1007                               end.
     1008                           when "b-hist-user" then
     1009                               do:
     1010                                   hh:load-image("cmp/b-hist.bmp":u) .
     1011                                   hh:TOOLTIP = "История пользователя" .
     1012                                   ii = ii + 1 .
     1013                               end.
     1014                       end case.
     1015                   end.
     1016                   hh = hh:next-sibling.
     1017               end.
     1018               b-help:column = v-frame-width - b-help:width-chars.
     1019               jj = 0.
     1020               repeat ii = 4 to 1 by -1 :
     1021                   if valid-handle (v-h[ii] ) then
     1022                   do:
     1023                       jj  = jj + 1 .
     1024                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1025                       v-h[ii]:row    = v-help-old-y .
     1026                   end.
     1027               end.
     1028           end.
     1029       end.
     1030   end procedure.
