     1396           assign
     1397             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1398             no-error .
     1399           if error-status :error
     1400           or error-status :get-message(1) <> ""
     1401           then do:
     1402             undo move_block, retry move_block .
     1403           end.
     1404         end.
     1405       end.
     1406       if p-move-resize = true
     1407       then do:
     1408         run diasize_position-resize-button in this-procedure .
     1409       end.
     1410       if v-diasize-wndstore = true
     1411       then do:
     1412         if connected("ub") = true
     1413         then do:
     1414           define variable v-cntxt-db-num        as integer   no-undo .
     1415           define variable v-cntxt-userid        as character no-undo .
     1416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1417                                             , OUTPUT v-cntxt-userid
     1418                                             ) .
     1419           run gbl/wndsizew.p
     1420             (input  v-cntxt-db-num
     1421             ,input  v-cntxt-userid
     1422             ,input  v-diasize-proc-name
     1423             ,input  'height':u
     1424             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1425             ) .
     1426         end.
     1427       end.
     1428     end.
     1429     assign
     1430       v-diasize-change-size = false
     1431     .
     1432   end procedure.
     1433   procedure diasize_set-height :
     1434     define input  parameter p-new-height  as decimal   no-undo .
     1435     define input  parameter p-move-resize as logical   no-undo .
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439       run diasize_change-height in this-procedure
     1440         (input  (p-new-height - frame Dialog-Frame :height)
     1441         ,input  p-move-resize
     1442         ) .
     1443     end.
     1444   end procedure.
     1445   procedure diasize_change-width :
     1446     define input  parameter p-change-value as decimal   no-undo .
     1447     define input  parameter p-move-resize  as logical   no-undo .
     1448     define variable v-field-group-handle   as handle    no-undo .
     1449     define variable v-object-handle        as handle    no-undo .
     1450     define variable v-frame-width          as decimal   no-undo .
     1451     define variable v-frame-virtual-width  as decimal   no-undo .
     1452     define variable v-browse-width         as decimal   no-undo .
     1453     define variable v-window-width         as decimal   no-undo .
     1454     define variable v-window-virtual-width as decimal   no-undo .
     1455     define variable v-change-sign          as integer   no-undo .
     1456     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1457     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1458     if p-change-value > 0
     1459     then do:
     1460       if frame Dialog-Frame :width + p-change-value >
     1461           session :width-chars
     1462       then do:
     1463         assign
     1464           p-change-value = session :width-chars - frame Dialog-Frame :width
     1465         .
     1466         if p-change-value <= 0
     1467         then do:
     1468           run diasize_position-resize-button in this-procedure .
     1469           return .
     1470         end.
     1471       end.
     1472     end.
     1473     if p-change-value < 0
     1474     then do:
     1475       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1476       then do:
     1477         assign
     1478           p-change-value = v-diasize-orig-frame-width
     1479                          - frame Dialog-Frame :width
     1480         .
     1481         if p-change-value >= 0
     1482         then do:
     1483           run diasize_position-resize-button in this-procedure .
     1484           return .
     1485         end.
     1486       end.
     1487     end.
     1488     if p-change-value >= 0
     1489     then do:
     1490       assign
     1491         v-change-sign = 1
     1492       .
     1493     end.
     1494     else do:
     1495       assign
     1496         v-change-sign = -1
     1497       .
     1498     end.
     1499     assign
     1500       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1501     .
     1502     if p-change-value = 0
     1503     then do:
     1504       run diasize_position-resize-button in this-procedure .
     1505       return .
     1506     end.
     1507     move_block:
     1508     do
     1509     on error undo move_block, leave move_block
     1510     :
     1511       if retry
     1512       then do:
     1513         do
     1514         on error undo move_block, leave move_block
     1515         :
     1516           if p-change-value > 0
     1517           then do:
     1518             for each buf_temp-diasize-handle
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 v-object-handle = buf_temp-diasize-handle.handle-value
     1523               .
     1524               if v-object-handle <> v-diasize-resize-button
     1525               then do:
     1526                 assign
     1527                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1528                 .
     1529               end.
     1530             end.
     1531             assign
     1532               v-diasize-browse-handle :width = v-browse-width
     1533             .
