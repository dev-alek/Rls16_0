     1593         end.
     1594       end.
     1595       assign
     1596         v-diasize-need-full-display = true
     1597       .
     1598       if v-diasize-change-size = false
     1599       then do:
     1600         assign
     1601           v-diasize-change-size = true
     1602         .
     1603       end.
     1604       else do:
     1605         return .
     1606       end.
     1607       assign
     1608         v-frame-width = frame Dialog-Frame :width
     1609         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1610         v-browse-width = v-diasize-browse-handle :width
     1611       .
     1612       for each buf_temp-browse-handle
     1613         where buf_temp-browse-handle.browse-type = 'width':u
     1614       :
     1615         assign
     1616           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1617         .
     1618       end.
