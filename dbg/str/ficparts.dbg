     1358             or error-status :get-message(1) <> ""
     1359             then do:
     1360               undo move_block, retry move_block .
     1361             end.
     1362           end.
     1363         end.
     1364         assign
     1365           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1366           no-error .
     1367         if error-status :error
     1368         or error-status :get-message(1) <> ""
     1369         then do:
     1370           undo move_block, retry move_block .
     1371         end.
     1372         for each buf_temp-browse-handle
     1373           where buf_temp-browse-handle.browse-type = 'height':u
     1374         on error undo move_block, retry move_block
     1375         :
     1376           assign
     1377             buf_temp-browse-handle.browse-handle :height
     1378               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1379             no-error .
