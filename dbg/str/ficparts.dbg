        3   define input parameter p-fin-doc-code like ub.c-fin-ob.doc-code no-undo.
        4   define input parameter p-host-code    like ub.c-fin-ob.host-code no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
