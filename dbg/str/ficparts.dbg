     1057   .
     1058   procedure diasize_change-height :
     1059     define input  parameter p-change-value  as decimal   no-undo .
     1060     define input  parameter p-move-resize   as logical   no-undo .
     1061     define variable v-field-group-handle    as handle    no-undo .
     1062     define variable v-object-handle         as handle    no-undo .
     1063     define variable v-frame-height          as decimal   no-undo .
     1064     define variable v-frame-virtual-height  as decimal   no-undo .
     1065     define variable v-browse-height         as decimal   no-undo .
     1066     define variable v-window-height         as decimal   no-undo .
     1067     define variable v-window-virtual-height as decimal   no-undo .
     1068     define variable v-change-sign           as integer   no-undo .
     1069     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1070     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1071     if p-change-value > 0
     1072     then do:
     1073       if frame Dialog-Frame :height + p-change-value
     1074           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1075       then do:
     1076         assign
     1077           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1078                           - (frame Dialog-Frame :height-chars)
     1079         .
     1080         if p-change-value <= 0
     1081         then do:
     1082           run diasize_position-resize-button in this-procedure .
     1083           return .
     1084         end.
     1085       end.
     1086     end.
     1087     if p-change-value < 0
     1088     then do:
     1089       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1090       then do:
     1091         assign
     1092           p-change-value = v-diasize-orig-frame-height
     1093                          - (frame Dialog-Frame :height-chars)
     1094         .
     1095         if p-change-value >= 0
     1096         then do:
     1097           run diasize_position-resize-button in this-procedure .
     1098           return .
     1099         end.
     1100       end.
     1101     end.
     1102     if p-change-value >= 0
     1103     then do:
     1104       assign
     1105         v-change-sign = 1
     1106       .
     1107     end.
     1108     else do:
     1109       assign
     1110         v-change-sign = -1
     1111       .
     1112     end.
     1113     assign
     1114       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1115     .
     1116     if p-change-value = 0
     1117     then do:
     1118       run diasize_position-resize-button in this-procedure .
     1119       return .
     1120     end.
     1121     move_block:
     1122     do
     1123     on error undo move_block, retry move_block
     1124     :
     1125       if retry
     1126       then do:
     1127         do
     1128         on error undo move_block, leave move_block
     1129         :
     1130           if p-change-value > 0
     1131           then do:
     1132             for each buf_temp-diasize-handle
     1133             on error undo, next
     1134             :
     1135               assign
     1136                 v-object-handle = buf_temp-diasize-handle.handle-value
     1137               .
     1138               if v-object-handle <> v-diasize-resize-button
     1139               then do:
     1140                 assign
     1141                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1142                 .
     1143               end.
     1144             end.
     1145             assign
     1146               v-diasize-browse-handle :height = v-browse-height
     1147             .
     1148             for each buf_temp-browse-handle
     1149               where buf_temp-browse-handle.browse-type = 'height':u
     1150             on error undo, next
     1151             :
     1152               assign
     1153                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1154               .
     1155             end.
     1156             assign
     1157               frame Dialog-Frame :height = v-frame-height
     1158             .
     1159             if frame Dialog-Frame :scrollable = true
     1160             then do:
     1161               assign
     1162                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1163               .
     1164             end.
     1165             run diasize_position-resize-button in this-procedure .
     1166           end.
     1167           else do:
     1168             if frame Dialog-Frame :scrollable = true
     1169             then do:
     1170               assign
     1171                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1172               .
     1173             end.
     1174             assign
     1175               frame Dialog-Frame :height = v-frame-height
     1176             .
     1177             assign
     1178               v-diasize-browse-handle :height = v-browse-height
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'height':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             for each buf_temp-diasize-handle
     1189             on error undo, next
     1190             :
     1191               assign
     1192                 v-object-handle = buf_temp-diasize-handle.handle-value
     1193               .
     1194               if v-object-handle <> v-diasize-resize-button
     1195               then do:
     1196                 assign
     1197                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1198                 .
     1199               end.
     1200             end.
     1201             run diasize_position-resize-button in this-procedure .
     1202           end.
     1203           assign
     1204             v-diasize-change-size = false
     1205           .
     1206           leave move_block .
     1207         end.
     1208       end.
     1209       assign
     1210         v-diasize-need-full-display = true
     1211       .
     1212       if v-diasize-change-size = false
     1213       then do:
     1214         assign
     1215           v-diasize-change-size = true
     1216         .
     1217       end.
     1218       else do:
     1219         return .
     1220       end.
     1221       assign
     1222         v-frame-height = frame Dialog-Frame :height
     1223         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1224         v-browse-height = v-diasize-browse-handle :height
     1225       .
     1226       for each buf_temp-browse-handle
     1227         where buf_temp-browse-handle.browse-type = 'height':u
     1228       :
     1229         assign
     1230           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1231         .
     1232       end.
     1233       for each buf_temp-diasize-handle
     1234       :
     1235         delete buf_temp-diasize-handle .
     1236       end.
     1237       assign
     1238         v-field-group-handle = frame Dialog-Frame :first-child
     1239       .
     1240       do while valid-handle(v-field-group-handle)
     1241       :
     1242         assign
     1243           v-object-handle = v-field-group-handle :first-child
     1244         .
     1245         do while valid-handle(v-object-handle)
     1246         :
     1247           if  v-object-handle <> v-diasize-browse-handle :handle
     1248           and can-query(v-object-handle, "row")
     1249           and can-query(v-object-handle, "height")
     1250           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1251           then do:
     1252             find first buf_temp-browse-handle
     1253               where buf_temp-browse-handle.browse-type   = 'height':u
     1254                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1255               no-error .
     1256             if available buf_temp-browse-handle
     1257             then do:
     1258             end.
     1259             else do:
     1260               create buf_temp-diasize-handle .
     1261               assign
     1262                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1263                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1264               .
     1265             end.
     1266           end.
     1267           assign
     1268             v-object-handle = v-object-handle :next-sibling
     1269           .
     1270         end.
     1271         assign
     1272           v-field-group-handle = v-field-group-handle :next-sibling
     1273         .
     1274       end.
     1275       do with frame Dialog-Frame
     1276       :
     1277         hide v-diasize-resize-button .
     1278         assign
     1279           v-diasize-resize-button :row    = 1
     1280           v-diasize-resize-button :column = 1
     1281         .
     1282       end.
     1283       if p-change-value > 0
     1284       then do:
     1285         if frame Dialog-Frame :scrollable = true
     1286         then do:
     1287           assign
     1288             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1289             no-error .
     1290           if error-status :error
     1291           or error-status :get-message(1) <> ""
     1292           then do:
     1293             undo move_block, retry move_block .
     1294           end.
     1295         end.
     1296         assign
     1297           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1298           no-error .
     1299         if error-status :error
     1300         or error-status :get-message(1) <> ""
     1301         then do:
     1302           undo move_block, retry move_block .
     1303         end.
     1304         assign
     1305           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1306           no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block .
     1311         end.
     1312         for each buf_temp-browse-handle
     1313           where buf_temp-browse-handle.browse-type = 'height':u
     1314         on error undo move_block, retry move_block
     1315         :
     1316           assign
     1317             buf_temp-browse-handle.browse-handle :height
     1318               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1319             no-error .
     1320           if error-status :error
     1321           or error-status :get-message(1) <> ""
     1322           then do:
     1323             undo move_block, retry move_block .
     1324           end.
     1325         end.
     1326         for each buf_temp-diasize-handle
     1327         on error undo move_block, retry move_block
     1328         :
     1329           assign
     1330             v-object-handle = buf_temp-diasize-handle.handle-value
     1331           .
     1332           if v-object-handle <> v-diasize-resize-button
     1333           then do:
     1334             assign
     1335               v-object-handle :row = v-object-handle :row + p-change-value
     1336               no-error .
     1337             if error-status :error
     1338             or error-status :get-message(1) <> ""
     1339             then do:
     1340               undo move_block, retry move_block .
     1341             end.
     1342           end.
     1343         end.
     1344       end.
     1345       else do:
     1346         for each buf_temp-diasize-handle
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             v-object-handle = buf_temp-diasize-handle.handle-value
     1351           .
     1352           if v-object-handle <> v-diasize-resize-button
     1353           then do:
     1354             assign
     1355               v-object-handle :row = v-object-handle :row + p-change-value
     1356               no-error .
