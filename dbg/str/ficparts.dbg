     1564               where buf_temp-browse-handle.browse-type = 'width':u
     1565             on error undo, next
     1566             :
     1567               assign
     1568                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1569               .
     1570             end.
     1571             assign
     1572               v-diasize-browse-handle :width = v-browse-width
     1573             .
     1574             for each buf_temp-diasize-handle
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 v-object-handle = buf_temp-diasize-handle.handle-value
     1579               .
