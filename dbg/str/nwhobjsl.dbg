        1   define input-output parameter v-select-obj-type as character no-undo .
        2   define input-output parameter v-select-obj-code as integer   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Выбрать объект для показа документов пришедших по новостям".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define temp-table temp-obj-code no-undo
      115     field temp-obj-type   as character format "X(3)"  label "Тип"
      116     field temp-obj-code   as integer   format ">>>>9" label "Код"
      117     field temp-obj-name   as character format "x(40)" label "Имя объекта"
      118     field temp-db-num     as integer format ">9"      label "БД"
      119     index xpk is primary temp-db-num temp-obj-type temp-obj-code
      120   .
      121   define variable v-obj-type-code as character no-undo
      122      format "x(9)" label "Объект" .
      123   DEFINE BUTTON b-cancel AUTO-END-KEY
      124        LABEL "&Отмена"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-help
      128        LABEL "Помо&щь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-sel AUTO-GO
      132        LABEL "&Выбор"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE QUERY BROWSE-1 FOR
      136         temp-obj-code SCROLLING.
      137   DEFINE BROWSE BROWSE-1
      138     QUERY BROWSE-1 DISPLAY
      139         temp-obj-code.temp-obj-type + " " + string(temp-obj-code.temp-obj-code) @ v-obj-type-code
      140         temp-obj-code.temp-db-num
      141         temp-obj-code.temp-obj-name
      142       WITH NO-ROW-MARKERS SEPARATORS SIZE 55.13 BY 13.58.
      143   DEFINE FRAME Dialog-Frame
      144        b-sel AT ROW 1 COL 1
      145        b-cancel AT ROW 1 COL 11
      146        b-help AT ROW 1 COL 21
      147        BROWSE-1 AT ROW 2.42 COL 2.88
      148        SPACE(0.73) SKIP(0.28)
      149       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      150            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      151            TITLE "Объекты"
      152            DEFAULT-BUTTON b-sel.
      153   ASSIGN
      154          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      155          FRAME Dialog-Frame:HIDDEN           = TRUE.
      156   ON GO OF FRAME Dialog-Frame
      157   DO:
      158     if available temp-obj-code
      159     then do:
      160       assign
      161         v-select-obj-type = temp-obj-code.temp-obj-type
      162         v-select-obj-code = temp-obj-code.temp-obj-code
      163       .
      164     end.
      165     else do:
      166       assign
      167         v-select-obj-type = ""
      168         v-select-obj-code = 0
      169       .
      170     end.
      171   END.
      172   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      173   DO:
      174     APPLY "END-ERROR":U TO SELF.
      175   END.
      176   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      177   DO:
      178     apply 'go':u to frame Dialog-Frame .
      179   END.
      180   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      181   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      182   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on help of frame Dialog-Frame
      184   do:
      185     run gbl/app_help.p
      186       (input this-procedure :file-name
      187       ,input ''
      188       ,input ?
      189       ) no-error.
      190     if error-status :error then do:
      191       message
      192         "Ошибка при вызове помощи"
      193         error-status :get-message(1)
      194         view-as alert-box .
      195     end.
      196   end.
      197   run minbtn-set in this-procedure .
      198   on choose of b-help in frame Dialog-Frame
      199   do:
      200     apply "help":u to frame Dialog-Frame .
      201   end.
      202   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure minbtn-set :
      204       do
      205           on error undo, return error return-value
      206           :
      207           define variable ii              as integer       no-undo .
      208           define variable fh              as widget-handle no-undo .
      209           define variable hh              as widget-handle no-undo .
      210           define variable v-h             as handle        extent 4 no-undo .
      211           define variable v-name-button   as character     no-undo .
      212           define variable v-help-old-x    as decimal       no-undo .
      213           define variable v-help-old-y    as decimal       no-undo .
      214           define variable v-help-old-size as decimal       no-undo .
      215           define variable v-frame-width   as decimal       no-undo .
      216           define variable jj              as integer       no-undo .
      217           do
      218               on error undo, return error
      219               :
      220               assign
      221                   v-frame-width = frame Dialog-Frame:width - 0.3
      222                   fh            = frame Dialog-Frame:first-child
      223                   hh            = fh:first-child
      224                   ii            = 1
      225                   .
      226               do while valid-handle(hh):
      227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      228                   do:
      229                       case lc(hh:name) :
      230                           when "b-help" then
      231                               do:
      232                                   hh:load-image-up("cmp/b-help.bmp":u) .
      233                                   hh:load-image-down("cmp/b-help.bmp":u) .
      234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      235                                   hh:TOOLTIP = "Помощь" .
      236                                   v-help-old-x = hh:column .
      237                                   v-help-old-y = hh:row    .
      238                                   v-help-old-size = hh:width .
      239                                   hh:width-chars = 2.5 .
      240                               end.
      241                           when "b-print" then
      242                               do:
      243                                   hh:load-image("cmp/b-print.bmp":u) .
      244                                   hh:TOOLTIP = "Печать" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-history" or
      250                           when "b-hist" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-sch" then
      259                               do:
      260                                   hh:load-image("cmp/b-sch.bmp":u) .
      261                                   hh:TOOLTIP = "Установка Фильтра" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-hist-user" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История пользователя" .
      270                                   ii = ii + 1 .
      271                               end.
      272                       end case.
      273                   end.
      274                   hh = hh:next-sibling.
      275               end.
      276               b-help:column = v-frame-width - b-help:width-chars.
      277               jj = 0.
      278               repeat ii = 4 to 1 by -1 :
      279                   if valid-handle (v-h[ii] ) then
      280                   do:
      281                       jj  = jj + 1 .
      282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      283                       v-h[ii]:row    = v-help-old-y .
      284                   end.
      285               end.
      286           end.
      287       end.
      288   end procedure.
      289   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      290   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      291   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      292   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      293   define variable v-diasize-current-frame-width  as decimal   no-undo .
      294   define variable v-diasize-current-frame-height as decimal   no-undo .
      295   define variable v-diasize-change-size          as logical   no-undo .
      296   define variable v-diasize-resize-button        as handle    no-undo .
      297   define variable v-diasize-wndmax               as logical   no-undo .
      298   define variable v-diasize-wndstore             as logical   no-undo .
      299   define variable v-diasize-proc-name            as character no-undo .
      300   define variable v-diasize-browse-handle        as handle    no-undo .
      301   define variable v-diasize-browse-number        as integer   no-undo .
      302   define variable v-diasize-need-full-display    as logical   no-undo init false .
      303   define temp-table temp-diasize-handle no-undo
      304     field handle-value  as handle
      305     field save-position as decimal
      306     index xpk is primary unique handle-value
      307     .
      308   define temp-table temp-browse-handle no-undo
      309     field browse-type   as character
      310     field browse-number as integer
      311     field browse-handle as handle
      312     field original-size as decimal
      313     index xpk is primary unique browse-type browse-number
      314     index xie browse-type browse-handle
      315   .
      316   procedure diasize_change-height :
      317     define input  parameter p-change-value  as decimal   no-undo .
      318     define input  parameter p-move-resize   as logical   no-undo .
      319     define variable v-field-group-handle    as handle    no-undo .
      320     define variable v-object-handle         as handle    no-undo .
      321     define variable v-frame-height          as decimal   no-undo .
      322     define variable v-frame-virtual-height  as decimal   no-undo .
      323     define variable v-browse-height         as decimal   no-undo .
      324     define variable v-window-height         as decimal   no-undo .
      325     define variable v-window-virtual-height as decimal   no-undo .
      326     define variable v-change-sign           as integer   no-undo .
      327     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      328     define buffer buf_temp-browse-handle  for temp-browse-handle .
      329     if p-change-value > 0
      330     then do:
      331       if frame Dialog-Frame :height + p-change-value
      332           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      333       then do:
      334         assign
      335           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      336                           - (frame Dialog-Frame :height-chars)
      337         .
      338         if p-change-value <= 0
      339         then do:
      340           run diasize_position-resize-button in this-procedure .
      341           return .
      342         end.
      343       end.
      344     end.
      345     if p-change-value < 0
      346     then do:
      347       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      348       then do:
      349         assign
      350           p-change-value = v-diasize-orig-frame-height
      351                          - (frame Dialog-Frame :height-chars)
      352         .
      353         if p-change-value >= 0
      354         then do:
      355           run diasize_position-resize-button in this-procedure .
      356           return .
      357         end.
      358       end.
      359     end.
      360     if p-change-value >= 0
      361     then do:
      362       assign
      363         v-change-sign = 1
      364       .
      365     end.
      366     else do:
      367       assign
      368         v-change-sign = -1
      369       .
      370     end.
      371     assign
      372       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      373     .
      374     if p-change-value = 0
      375     then do:
      376       run diasize_position-resize-button in this-procedure .
      377       return .
      378     end.
      379     move_block:
      380     do
      381     on error undo move_block, retry move_block
      382     :
      383       if retry
      384       then do:
      385         do
      386         on error undo move_block, leave move_block
      387         :
      388           if p-change-value > 0
      389           then do:
      390             for each buf_temp-diasize-handle
      391             on error undo, next
      392             :
      393               assign
      394                 v-object-handle = buf_temp-diasize-handle.handle-value
      395               .
      396               if v-object-handle <> v-diasize-resize-button
      397               then do:
      398                 assign
      399                   v-object-handle :row = buf_temp-diasize-handle.save-position
      400                 .
      401               end.
      402             end.
      403             assign
      404               v-diasize-browse-handle :height = v-browse-height
      405             .
      406             for each buf_temp-browse-handle
      407               where buf_temp-browse-handle.browse-type = 'height':u
      408             on error undo, next
      409             :
      410               assign
      411                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      412               .
      413             end.
      414             assign
      415               frame Dialog-Frame :height = v-frame-height
      416             .
      417             if frame Dialog-Frame :scrollable = true
      418             then do:
      419               assign
      420                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      421               .
      422             end.
      423             run diasize_position-resize-button in this-procedure .
      424           end.
      425           else do:
      426             if frame Dialog-Frame :scrollable = true
      427             then do:
      428               assign
      429                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      430               .
      431             end.
      432             assign
      433               frame Dialog-Frame :height = v-frame-height
      434             .
      435             assign
      436               v-diasize-browse-handle :height = v-browse-height
      437             .
      438             for each buf_temp-browse-handle
      439               where buf_temp-browse-handle.browse-type = 'height':u
      440             on error undo, next
      441             :
      442               assign
      443                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      444               .
      445             end.
      446             for each buf_temp-diasize-handle
      447             on error undo, next
      448             :
      449               assign
      450                 v-object-handle = buf_temp-diasize-handle.handle-value
      451               .
      452               if v-object-handle <> v-diasize-resize-button
      453               then do:
      454                 assign
      455                   v-object-handle :row = buf_temp-diasize-handle.save-position
      456                 .
      457               end.
      458             end.
      459             run diasize_position-resize-button in this-procedure .
      460           end.
      461           assign
      462             v-diasize-change-size = false
      463           .
      464           leave move_block .
      465         end.
      466       end.
      467       assign
      468         v-diasize-need-full-display = true
      469       .
      470       if v-diasize-change-size = false
      471       then do:
      472         assign
      473           v-diasize-change-size = true
      474         .
      475       end.
      476       else do:
      477         return .
      478       end.
      479       assign
      480         v-frame-height = frame Dialog-Frame :height
      481         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      482         v-browse-height = v-diasize-browse-handle :height
      483       .
      484       for each buf_temp-browse-handle
      485         where buf_temp-browse-handle.browse-type = 'height':u
      486       :
      487         assign
      488           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      489         .
      490       end.
      491       for each buf_temp-diasize-handle
      492       :
      493         delete buf_temp-diasize-handle .
      494       end.
      495       assign
      496         v-field-group-handle = frame Dialog-Frame :first-child
      497       .
      498       do while valid-handle(v-field-group-handle)
      499       :
      500         assign
      501           v-object-handle = v-field-group-handle :first-child
      502         .
      503         do while valid-handle(v-object-handle)
      504         :
      505           if  v-object-handle <> v-diasize-browse-handle :handle
      506           and can-query(v-object-handle, "row")
      507           and can-query(v-object-handle, "height")
      508           and ( v-object-handle :row > v-diasize-browse-handle :row )
      509           then do:
      510             find first buf_temp-browse-handle
      511               where buf_temp-browse-handle.browse-type   = 'height':u
      512                 and buf_temp-browse-handle.browse-handle = v-object-handle
      513               no-error .
      514             if available buf_temp-browse-handle
      515             then do:
      516             end.
      517             else do:
      518               create buf_temp-diasize-handle .
      519               assign
      520                 buf_temp-diasize-handle.handle-value  = v-object-handle
      521                 buf_temp-diasize-handle.save-position = v-object-handle :row
      522               .
      523             end.
      524           end.
      525           assign
      526             v-object-handle = v-object-handle :next-sibling
      527           .
      528         end.
      529         assign
      530           v-field-group-handle = v-field-group-handle :next-sibling
      531         .
      532       end.
      533       do with frame Dialog-Frame
      534       :
      535         hide v-diasize-resize-button .
      536         assign
      537           v-diasize-resize-button :row    = 1
      538           v-diasize-resize-button :column = 1
      539         .
      540       end.
      541       if p-change-value > 0
      542       then do:
      543         if frame Dialog-Frame :scrollable = true
      544         then do:
      545           assign
      546             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      547             no-error .
      548           if error-status :error
      549           or error-status :get-message(1) <> ""
      550           then do:
      551             undo move_block, retry move_block .
      552           end.
      553         end.
      554         assign
      555           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      556           no-error .
      557         if error-status :error
      558         or error-status :get-message(1) <> ""
      559         then do:
      560           undo move_block, retry move_block .
      561         end.
      562         assign
      563           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      564           no-error .
      565         if error-status :error
      566         or error-status :get-message(1) <> ""
      567         then do:
      568           undo move_block, retry move_block .
      569         end.
      570         for each buf_temp-browse-handle
      571           where buf_temp-browse-handle.browse-type = 'height':u
      572         on error undo move_block, retry move_block
      573         :
      574           assign
      575             buf_temp-browse-handle.browse-handle :height
      576               = buf_temp-browse-handle.browse-handle :height + p-change-value
      577             no-error .
      578           if error-status :error
      579           or error-status :get-message(1) <> ""
      580           then do:
      581             undo move_block, retry move_block .
      582           end.
      583         end.
      584         for each buf_temp-diasize-handle
      585         on error undo move_block, retry move_block
      586         :
      587           assign
      588             v-object-handle = buf_temp-diasize-handle.handle-value
      589           .
      590           if v-object-handle <> v-diasize-resize-button
      591           then do:
      592             assign
      593               v-object-handle :row = v-object-handle :row + p-change-value
      594               no-error .
      595             if error-status :error
      596             or error-status :get-message(1) <> ""
      597             then do:
      598               undo move_block, retry move_block .
      599             end.
      600           end.
      601         end.
      602       end.
      603       else do:
      604         for each buf_temp-diasize-handle
      605         on error undo move_block, retry move_block
      606         :
      607           assign
      608             v-object-handle = buf_temp-diasize-handle.handle-value
      609           .
      610           if v-object-handle <> v-diasize-resize-button
      611           then do:
      612             assign
      613               v-object-handle :row = v-object-handle :row + p-change-value
      614               no-error .
      615             if error-status :error
      616             or error-status :get-message(1) <> ""
      617             then do:
      618               undo move_block, retry move_block .
      619             end.
      620           end.
      621         end.
      622         assign
      623           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      624           no-error .
      625         if error-status :error
      626         or error-status :get-message(1) <> ""
      627         then do:
      628           undo move_block, retry move_block .
      629         end.
      630         for each buf_temp-browse-handle
      631           where buf_temp-browse-handle.browse-type = 'height':u
      632         on error undo move_block, retry move_block
      633         :
      634           assign
      635             buf_temp-browse-handle.browse-handle :height
      636               = buf_temp-browse-handle.browse-handle :height + p-change-value
      637             no-error .
      638           if error-status :error
      639           or error-status :get-message(1) <> ""
      640           then do:
      641             undo move_block, retry move_block .
      642           end.
      643         end.
      644         assign
      645           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      646           no-error .
      647         if error-status :error
      648         or error-status :get-message(1) <> ""
      649         then do:
      650           undo move_block, retry move_block .
      651         end.
      652         if frame Dialog-Frame :scrollable = true
      653         then do:
      654           assign
      655             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      656             no-error .
      657           if error-status :error
      658           or error-status :get-message(1) <> ""
      659           then do:
      660             undo move_block, retry move_block .
      661           end.
      662         end.
      663       end.
      664       if p-move-resize = true
      665       then do:
      666         run diasize_position-resize-button in this-procedure .
      667       end.
      668       if v-diasize-wndstore = true
      669       then do:
      670         if connected("ub") = true
      671         then do:
      672           define variable v-cntxt-db-num        as integer   no-undo .
      673           define variable v-cntxt-userid        as character no-undo .
      674           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      675                                             , OUTPUT v-cntxt-userid
      676                                             ) .
      677           run gbl/wndsizew.p
      678             (input  v-cntxt-db-num
      679             ,input  v-cntxt-userid
      680             ,input  v-diasize-proc-name
      681             ,input  'height':u
      682             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      683             ) .
      684         end.
      685       end.
      686     end.
      687     assign
      688       v-diasize-change-size = false
      689     .
      690   end procedure.
      691   procedure diasize_set-height :
      692     define input  parameter p-new-height  as decimal   no-undo .
      693     define input  parameter p-move-resize as logical   no-undo .
      694     do
      695     on error undo, return error return-value
      696     :
      697       run diasize_change-height in this-procedure
      698         (input  (p-new-height - frame Dialog-Frame :height)
      699         ,input  p-move-resize
      700         ) .
      701     end.
      702   end procedure.
      703   procedure diasize_change-width :
      704     define input  parameter p-change-value as decimal   no-undo .
      705     define input  parameter p-move-resize  as logical   no-undo .
      706     define variable v-field-group-handle   as handle    no-undo .
      707     define variable v-object-handle        as handle    no-undo .
      708     define variable v-frame-width          as decimal   no-undo .
      709     define variable v-frame-virtual-width  as decimal   no-undo .
      710     define variable v-browse-width         as decimal   no-undo .
      711     define variable v-window-width         as decimal   no-undo .
      712     define variable v-window-virtual-width as decimal   no-undo .
      713     define variable v-change-sign          as integer   no-undo .
      714     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      715     define buffer buf_temp-browse-handle  for temp-browse-handle .
      716     if p-change-value > 0
      717     then do:
      718       if frame Dialog-Frame :width + p-change-value >
      719           session :width-chars
      720       then do:
      721         assign
      722           p-change-value = session :width-chars - frame Dialog-Frame :width
      723         .
      724         if p-change-value <= 0
      725         then do:
      726           run diasize_position-resize-button in this-procedure .
      727           return .
      728         end.
      729       end.
      730     end.
      731     if p-change-value < 0
      732     then do:
      733       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      734       then do:
      735         assign
      736           p-change-value = v-diasize-orig-frame-width
      737                          - frame Dialog-Frame :width
      738         .
      739         if p-change-value >= 0
      740         then do:
      741           run diasize_position-resize-button in this-procedure .
      742           return .
      743         end.
      744       end.
      745     end.
      746     if p-change-value >= 0
      747     then do:
      748       assign
      749         v-change-sign = 1
      750       .
      751     end.
      752     else do:
      753       assign
      754         v-change-sign = -1
      755       .
      756     end.
      757     assign
      758       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      759     .
      760     if p-change-value = 0
      761     then do:
      762       run diasize_position-resize-button in this-procedure .
      763       return .
      764     end.
      765     move_block:
      766     do
      767     on error undo move_block, leave move_block
      768     :
      769       if retry
      770       then do:
      771         do
      772         on error undo move_block, leave move_block
      773         :
      774           if p-change-value > 0
      775           then do:
      776             for each buf_temp-diasize-handle
      777             on error undo, next
      778             :
      779               assign
      780                 v-object-handle = buf_temp-diasize-handle.handle-value
      781               .
      782               if v-object-handle <> v-diasize-resize-button
      783               then do:
      784                 assign
      785                   v-object-handle :col = buf_temp-diasize-handle.save-position
      786                 .
      787               end.
      788             end.
      789             assign
      790               v-diasize-browse-handle :width = v-browse-width
      791             .
      792             for each buf_temp-browse-handle
      793               where buf_temp-browse-handle.browse-type = 'width':u
      794             on error undo, next
      795             :
      796               assign
      797                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      798               .
      799             end.
      800             assign
      801               frame Dialog-Frame :width = v-frame-width
      802             .
      803             if frame Dialog-Frame :scrollable = true
      804             then do:
      805               assign
      806                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      807               .
      808             end.
      809             run diasize_position-resize-button in this-procedure .
      810           end.
      811           else do:
      812             if frame Dialog-Frame :scrollable = true
      813             then do:
      814               assign
      815                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      816               .
      817             end.
      818             assign
      819               frame Dialog-Frame :width = v-frame-width
      820             .
      821             for each buf_temp-browse-handle
      822               where buf_temp-browse-handle.browse-type = 'width':u
      823             on error undo, next
      824             :
      825               assign
      826                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      827               .
      828             end.
      829             assign
      830               v-diasize-browse-handle :width = v-browse-width
      831             .
      832             for each buf_temp-diasize-handle
      833             on error undo, next
      834             :
      835               assign
      836                 v-object-handle = buf_temp-diasize-handle.handle-value
      837               .
      838               if v-object-handle <> v-diasize-resize-button
      839               then do:
      840                 assign
      841                   v-object-handle :col = buf_temp-diasize-handle.save-position
      842                 .
      843               end.
      844             end.
      845             run diasize_position-resize-button in this-procedure .
      846           end.
      847           assign
      848             v-diasize-change-size = false
      849           .
      850           leave move_block .
      851         end.
      852       end.
      853       assign
      854         v-diasize-need-full-display = true
      855       .
      856       if v-diasize-change-size = false
      857       then do:
      858         assign
      859           v-diasize-change-size = true
      860         .
      861       end.
      862       else do:
      863         return .
      864       end.
      865       assign
      866         v-frame-width = frame Dialog-Frame :width
      867         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      868         v-browse-width = v-diasize-browse-handle :width
      869       .
      870       for each buf_temp-browse-handle
      871         where buf_temp-browse-handle.browse-type = 'width':u
      872       :
      873         assign
      874           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      875         .
      876       end.
      877       for each buf_temp-diasize-handle
      878       :
      879         delete buf_temp-diasize-handle .
      880       end.
      881       assign
      882         v-field-group-handle = frame Dialog-Frame :first-child
      883       .
      884       do while valid-handle(v-field-group-handle)
      885       :
      886         assign
      887           v-object-handle = v-field-group-handle :first-child
      888         .
      889         do while valid-handle(v-object-handle)
      890         :
      891           if  v-object-handle <> v-diasize-browse-handle :handle
      892           and v-object-handle <> v-diasize-resize-button
      893           and can-query(v-object-handle, "row")
      894           and can-query(v-object-handle, "height")
      895           and ( v-object-handle :col + v-object-handle :width
      896                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      897               )
      898           then do:
      899             find first buf_temp-browse-handle
      900               where buf_temp-browse-handle.browse-type   = 'width':u
      901                 and buf_temp-browse-handle.browse-handle = v-object-handle
      902               no-error .
      903             if available buf_temp-browse-handle
      904             then do:
      905             end.
      906             else do:
      907               create buf_temp-diasize-handle .
      908               assign
      909                 buf_temp-diasize-handle.handle-value  = v-object-handle
      910                 buf_temp-diasize-handle.save-position = v-object-handle :col
      911               .
      912             end.
      913           end.
      914           assign
      915             v-object-handle = v-object-handle :next-sibling
      916           .
      917         end.
      918         assign
      919           v-field-group-handle = v-field-group-handle :next-sibling
      920         .
      921       end.
      922       do with frame Dialog-Frame
      923       :
      924         hide v-diasize-resize-button .
      925         v-diasize-resize-button :row = 1.
      926         v-diasize-resize-button :column = 1.
      927       end.
      928       if p-change-value > 0
      929       then do:
      930         if frame Dialog-Frame :scrollable = true
      931         then do:
      932           assign
      933             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      934             no-error .
      935           if error-status :error
      936           or error-status :get-message(1) <> ""
      937           then do:
      938             undo move_block, retry move_block.
      939           end.
      940         end.
      941         assign
      942           frame Dialog-Frame :width = v-frame-width + p-change-value
      943           no-error .
      944         if error-status :error
      945         or error-status :get-message(1) <> ""
      946         then do:
      947           undo move_block, retry move_block.
      948         end.
      949         assign
      950           v-diasize-browse-handle :width = v-browse-width + p-change-value
      951         no-error .
      952         if error-status :error
      953         or error-status :get-message(1) <> ""
      954         then do:
      955           undo move_block, retry move_block.
      956         end.
      957         for each buf_temp-browse-handle
      958           where buf_temp-browse-handle.browse-type = 'width':u
      959         on error undo move_block, retry move_block
      960         :
      961           assign
      962             buf_temp-browse-handle.browse-handle :width
      963               = buf_temp-browse-handle.browse-handle :width + p-change-value
      964             no-error .
      965           if error-status :error
      966           or error-status :get-message(1) <> ""
      967           then do:
      968             undo move_block, retry move_block .
      969           end.
      970         end.
      971         for each buf_temp-diasize-handle
      972         on error undo move_block, retry move_block
      973         :
      974           assign
      975             v-object-handle = buf_temp-diasize-handle.handle-value
      976           .
      977           if v-object-handle <> v-diasize-resize-button
      978           then do:
      979             assign
      980               v-object-handle :col = v-object-handle :col + p-change-value
      981               no-error .
      982             if error-status :error
      983             or error-status :get-message(1) <> ""
      984             then do:
      985               undo move_block, retry move_block .
      986             end.
      987           end.
      988         end.
      989       end.
      990       else do:
      991         for each buf_temp-diasize-handle
      992         on error undo move_block, retry move_block
      993         :
      994           assign
      995             v-object-handle = buf_temp-diasize-handle.handle-value
      996           .
      997           if v-object-handle <> v-diasize-resize-button
      998           then do:
      999             assign
     1000               v-object-handle :col = v-object-handle :col + p-change-value
     1001               no-error .
     1002             if error-status :error
     1003             or error-status :get-message(1) <> ""
     1004             then do:
     1005               undo move_block, retry move_block .
     1006             end.
     1007           end.
     1008         end.
     1009         for each buf_temp-browse-handle
     1010           where buf_temp-browse-handle.browse-type = 'width':u
     1011         on error undo move_block, retry move_block
     1012         :
     1013           assign
     1014             buf_temp-browse-handle.browse-handle :width
     1015               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1016             no-error .
     1017           if error-status :error
     1018           or error-status :get-message(1) <> ""
     1019           then do:
     1020             undo move_block, retry move_block .
     1021           end.
     1022         end.
     1023         assign
     1024           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1025           no-error .
     1026         if error-status :error
     1027         or error-status :get-message(1) <> ""
     1028         then do:
     1029           undo move_block, retry move_block.
     1030         end.
     1031         assign
     1032           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1033         no-error .
     1034         if error-status :error
     1035         or error-status :get-message(1) <> ""
     1036         then do:
     1037           undo move_block, retry move_block.
     1038         end.
     1039         if frame Dialog-Frame :scrollable = true
     1040         then do:
     1041           assign
     1042             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1043           no-error .
     1044           if error-status :error
     1045           or error-status :get-message(1) <> ""
     1046           then do:
     1047             undo move_block, retry move_block.
     1048           end.
     1049         end.
     1050       end.
     1051       if p-move-resize
     1052       then do:
     1053         run diasize_position-resize-button in this-procedure .
     1054       end.
     1055       if v-diasize-wndstore = true
     1056       then do:
     1057         if connected("ub") = true
     1058         then do:
     1059           define variable v-cntxt-db-num        as integer   no-undo .
     1060           define variable v-cntxt-userid        as character no-undo .
     1061           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1062                                             , OUTPUT v-cntxt-userid
     1063                                             ) .
     1064           run gbl/wndsizew.p
     1065             (input  v-cntxt-db-num
     1066             ,input  v-cntxt-userid
     1067             ,input  v-diasize-proc-name
     1068             ,input  'width':u
     1069             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1070             ) .
     1071         end.
     1072       end.
     1073     end.
     1074     assign
     1075       v-diasize-change-size = false
     1076     .
     1077   end procedure.
     1078   procedure diasize_set-width :
     1079     define input  parameter p-new-width  as decimal   no-undo .
     1080     define input  parameter p-move-resize as logical   no-undo .
     1081     do
     1082     on error undo, return error return-value
     1083     :
     1084       run diasize_change-width in this-procedure
     1085         (input  (p-new-width - frame Dialog-Frame :width)
     1086         ,input  p-move-resize
     1087         ) .
     1088     end.
     1089   end procedure.
     1090   procedure diasize_position-resize-button :
     1091     do with frame Dialog-Frame
     1092     :
     1093       hide v-diasize-resize-button .
     1094       assign
     1095         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1096                     - 1
     1097                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1098         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1099                     - 1
     1100                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1101       .
     1102       view v-diasize-resize-button .
     1103     end.
     1104   end procedure.
     1105   on alt-right anywhere
     1106   do:
     1107     run diasize_change-width in this-procedure
     1108       (input 1
     1109       ,input true
     1110       ) .
     1111     return no-apply .
     1112   end.
     1113   on alt-left anywhere
     1114   do:
     1115     run diasize_change-width in this-procedure
     1116       (input -1
     1117       ,input true
     1118       ) .
     1119     return no-apply .
     1120   end.
     1121   on alt-down anywhere
     1122   do:
     1123     run diasize_change-height in this-procedure
     1124       (input 1
     1125       ,input true
     1126       ) .
     1127     return no-apply .
     1128   end.
     1129   on alt-up anywhere
     1130   do:
     1131     run diasize_change-height in this-procedure
     1132       (input -1
     1133       ,input true
     1134       ) .
     1135     return no-apply .
     1136   end.
     1137   on alt-enter of frame Dialog-Frame
     1138   do:
     1139     run diasize_maximize in this-procedure
     1140       (input  ?
     1141       ).
     1142     return no-apply .
     1143   end.
     1144   procedure diasize_end-move :
     1145     do
     1146     on error undo, return error return-value
     1147     :
     1148       define variable v-row-delta as decimal   no-undo .
     1149       define variable v-col-delta as decimal   no-undo .
     1150       define variable v-new-row as decimal   no-undo .
     1151       define variable v-new-col as decimal   no-undo .
     1152       assign
     1153         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1154         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1155       .
     1156       assign
     1157         v-row-delta = v-new-row - frame Dialog-Frame :height
     1158         v-col-delta = v-new-col - frame Dialog-Frame :width
     1159       .
     1160       run diasize_change-height in this-procedure
     1161         (input v-row-delta
     1162         ,input true
     1163         ) .
     1164       run diasize_change-width in this-procedure
     1165         (input v-col-delta
     1166         ,input true
     1167         ) .
     1168     end.
     1169   end procedure.
     1170   procedure diasize_maximize :
     1171     define input  parameter p-action as logical   no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       if p-action = ?
     1176       then do:
     1177         if v-diasize-need-maximize = true
     1178         then do:
     1179           assign
     1180             p-action = true
     1181           .
     1182         end.
     1183         else do:
     1184           assign
     1185             p-action = false
     1186           .
     1187         end.
     1188       end.
     1189       if p-action = true
     1190       then do:
     1191         run diasize_change-height in this-procedure
     1192           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1193               - frame Dialog-Frame :height-chars
     1194           ,input true
     1195           ) .
     1196         run diasize_change-width in this-procedure
     1197           (input session :width-chars
     1198               - frame Dialog-Frame :width-chars
     1199           ,input true
     1200           ) .
     1201         assign
     1202           v-diasize-need-maximize = false
     1203         .
     1204       end.
     1205       else do:
     1206         run diasize_change-width in this-procedure
     1207           (input v-diasize-orig-frame-width
     1208               - frame Dialog-Frame :width-chars
     1209           ,input true
     1210           ) .
     1211         run diasize_change-height in this-procedure
     1212           (input v-diasize-orig-frame-height
     1213               - frame Dialog-Frame :height-chars
     1214           ,input true
     1215           ) .
     1216         assign
     1217           v-diasize-need-maximize = true
     1218         .
     1219       end.
     1220     end.
     1221   end procedure.
     1222   procedure diasize_restore-orig-size :
     1223     do
     1224     on error undo, return error return-value
     1225     :
     1226       assign
     1227         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1228         v-diasize-current-frame-height = frame Dialog-Frame :height
     1229       .
     1230       run diasize_set-height in this-procedure
     1231         (input  v-diasize-orig-frame-height
     1232         ,input  true
     1233         ) .
     1234       run diasize_set-width in this-procedure
     1235         (input  v-diasize-orig-frame-width
     1236         ,input  true
     1237         ) .
     1238     end.
     1239   end procedure.
     1240   procedure diasize_restore-current-size :
     1241     do
     1242     on error undo, return error return-value
     1243     :
     1244       run diasize_set-height in this-procedure
     1245         (input  v-diasize-current-frame-height
     1246         ,input  true
     1247         ) .
     1248       run diasize_set-width in this-procedure
     1249         (input  v-diasize-current-frame-width
     1250         ,input  true
     1251         ) .
     1252     end.
     1253   end procedure.
     1254   procedure diasize_set-browse-handle :
     1255     define input  parameter p-browse-handle as handle   no-undo .
     1256     define buffer buf_temp-browse-handle for temp-browse-handle .
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       assign
     1261         v-diasize-browse-handle = p-browse-handle
     1262       .
     1263       for each buf_temp-browse-handle
     1264       on error undo, return error return-value
     1265       :
     1266         delete buf_temp-browse-handle .
     1267       end.
     1268     end.
     1269   end procedure.
     1270   procedure diasize_add_browse :
     1271     define input  parameter p-browse-type   as character no-undo .
     1272     define input  parameter p-browse-handle as handle    no-undo .
     1273     define buffer buf_temp-browse-handle for temp-browse-handle .
     1274     do
     1275     on error undo, return error return-value
     1276     :
     1277       assign
     1278         v-diasize-browse-number = v-diasize-browse-number + 1
     1279       .
     1280       create buf_temp-browse-handle .
     1281       assign
     1282         buf_temp-browse-handle.browse-type   = p-browse-type
     1283         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1284         buf_temp-browse-handle.browse-handle = p-browse-handle
     1285       .
     1286     end.
     1287   end procedure.
     1288   procedure diasize_init :
     1289     define variable v-default-value    as logical   no-undo .
     1290     define variable v-restore-saved    as logical   no-undo .
     1291     define variable v-resize-value-str as character no-undo .
     1292     do
     1293     on error undo, return error return-value
     1294     :
     1295       do with frame Dialog-Frame
     1296       :
     1297         assign
     1298           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1299           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1300           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1301         .
     1302         create button v-diasize-resize-button
     1303         assign
     1304           parent        = frame Dialog-Frame :first-child
     1305           label         = "s"
     1306           height-pixels = 16
     1307           width-pixels  = 16
     1308           visible       = true
     1309           sensitive     = true
     1310           movable       = true
     1311           triggers:
     1312             on end-move persistent run diasize_end-move in this-procedure .
     1313           end triggers.
     1314         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1315         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1316         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1317         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1318         assign
     1319           v-diasize-wndmax = false
     1320         .
     1321         if connected("ub") = true
     1322         then do:
     1323           define variable v-cntxt-db-num        as integer   no-undo .
     1324           define variable v-cntxt-userid        as character no-undo .
     1325           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1326                                             , OUTPUT v-cntxt-userid
     1327                                             ) .
     1328           run gbl/wndpar_r.p
     1329             (input  v-cntxt-db-num
     1330             ,input  v-cntxt-userid
     1331             ,input  'wndmax':U
     1332             ,output v-diasize-wndmax
     1333             ,output v-default-value
     1334             ) .
     1335         end.
     1336         assign
     1337           v-diasize-wndstore = false
     1338         .
     1339         if connected("ub") = true
     1340         then do:
     1341           run gbl/wndpar_r.p
     1342             (input  v-cntxt-db-num
     1343             ,input  v-cntxt-userid
     1344             ,input  'wndstore':U
     1345             ,output v-diasize-wndstore
     1346             ,output v-default-value
     1347             ) .
     1348         end.
     1349         assign
     1350           v-diasize-proc-name = entry(1, program-name(2), '.')
     1351         .
     1352         if v-diasize-wndstore = true
     1353         then do:
     1354           assign
     1355             v-restore-saved = false
     1356           .
     1357           if connected("ub") = true
     1358           then do:
     1359             run gbl/wndsizer.p
     1360               (input  v-cntxt-db-num
     1361               ,input  v-cntxt-userid
     1362               ,input  v-diasize-proc-name
     1363               ,input  'height':u
     1364               ,output v-resize-value-str
     1365               ) .
     1366             if v-resize-value-str <> '':U
     1367             then do:
     1368               run diasize_change-height in this-procedure
     1369                 (input  integer(v-resize-value-str)
     1370                 ,input  true
     1371                 ) .
     1372               assign
     1373                 v-restore-saved = true
     1374               .
     1375             end.
     1376           end.
     1377           if connected("ub") = true
     1378           then do:
     1379             run gbl/wndsizer.p
     1380               (input  v-cntxt-db-num
     1381               ,input  v-cntxt-userid
     1382               ,input  v-diasize-proc-name
     1383               ,input  'width':u
     1384               ,output v-resize-value-str
     1385               ) .
     1386             if v-resize-value-str <> '':U
     1387             then do:
     1388               run diasize_change-width in this-procedure
     1389                 (input  integer(v-resize-value-str)
     1390                 ,input  true
     1391                 ) .
     1392               assign
     1393                 v-restore-saved = true
     1394               .
     1395             end.
     1396           end.
     1397           if v-restore-saved <> true
     1398           then do:
     1399             if v-diasize-wndmax = true
     1400             then do:
     1401               run diasize_maximize in this-procedure
     1402                 (input  true
     1403                 ) .
     1404             end.
     1405           end.
     1406         end.
     1407         else do:
     1408           if v-diasize-wndmax = true
     1409           then do:
     1410             run diasize_maximize in this-procedure
     1411               (input  true
     1412               ) .
     1413           end.
     1414         end.
     1415       end.
     1416     end.
     1417   end procedure.
     1418   procedure diasize_need-full-display :
     1419     define output parameter p-need-full-display as logical   no-undo .
     1420     do
     1421     on error undo, return error return-value
     1422     :
     1423       assign
     1424         p-need-full-display = v-diasize-need-full-display
     1425       .
     1426       assign
     1427         v-diasize-need-full-display = false
     1428       .
     1429     end.
     1430   end procedure.
     1431   procedure get-context :
     1432      define output parameter p-db-num as integer          no-undo.
     1433      define output parameter p-user-id as character        no-undo.
     1434      define variable v-login               as character    no-undo.
     1435      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1436      define buffer buf_user-login  for ub.user-login .
     1437      do
     1438      on error undo, return error
     1439      :
     1440            FIND FIRST buf_sys-ctrl no-lock.
     1441            ASSIGN
     1442               v-login = USERID("ub")
     1443               p-db-num = buf_sys-ctrl.db-num
     1444            .
     1445            FIND FIRST buf_user-login
     1446                 WHERE buf_user-login.db-num = p-db-num
     1447                   AND buf_user-login.user-login = v-login
     1448                 no-lock
     1449                 no-error
     1450                 .
     1451            IF AVAILABLE buf_user-login
     1452            THEN DO:
     1453               assign
     1454                  p-user-id = buf_user-login.user-id
     1455               .
     1456            END.
     1457      end.
     1458   end procedure.
     1459       run diasize_init in this-procedure .
     1460   if browse BROWSE-1:set-repositioned-row(5, "CONDITIONAL" ) then .
     1461   run init-temp-table in this-procedure .
     1462   MAIN-BLOCK:
     1463   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1464      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1465     RUN enable_UI.
     1466     WAIT-FOR GO OF FRAME Dialog-Frame.
     1467   END.
     1468   RUN disable_UI.
     1469   PROCEDURE disable_UI :
     1470     HIDE FRAME Dialog-Frame.
     1471   END PROCEDURE.
     1472   PROCEDURE enable_UI :
     1473     ENABLE b-sel b-cancel b-help BROWSE-1
     1474         WITH FRAME Dialog-Frame.
     1475     VIEW FRAME Dialog-Frame.
     1476     run local-open-query in this-procedure .
     1477   END PROCEDURE.
     1478   PROCEDURE init-temp-table :
     1479     define buffer buf_nws-doc-hist for ub.nws-doc-hist .
     1480     define buffer buf_temp-obj-code for temp-obj-code .
     1481     define buffer buf_clients for ub.clients .
     1482     for each buf_nws-doc-hist
     1483     on error undo, return error return-value
     1484     :
     1485       find first buf_temp-obj-code
     1486         where buf_temp-obj-code.temp-obj-type   = buf_nws-doc-hist.obj-type
     1487           and buf_temp-obj-code.temp-obj-code = buf_nws-doc-hist.obj-code
     1488         no-error .
     1489       if not available buf_temp-obj-code
     1490       then do:
     1491         create buf_temp-obj-code .
     1492         assign
     1493           buf_temp-obj-code.temp-obj-type = buf_nws-doc-hist.obj-type
     1494           buf_temp-obj-code.temp-obj-code = buf_nws-doc-hist.obj-code
     1495         .
     1496         find first buf_clients no-lock
     1497           where buf_clients.obj-type = buf_temp-obj-code.temp-obj-type
     1498             and buf_clients.obj-code = buf_temp-obj-code.temp-obj-code
     1499           .
     1500         assign
     1501           buf_temp-obj-code.temp-obj-name = buf_clients.obj-name
     1502         .
     1503   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1504   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1505     (input  buf_temp-obj-code.temp-obj-type
     1506     ,input  buf_temp-obj-code.temp-obj-code
     1507     ,output buf_temp-obj-code.temp-db-num
     1508     )  .
     1509       end.
     1510     end.
     1511   END PROCEDURE.
     1512   PROCEDURE local-open-query :
     1513     define variable v-reposition-rowid as rowid     no-undo .
     1514     find first temp-obj-code
     1515       where temp-obj-code.temp-obj-type = v-select-obj-type
     1516         and temp-obj-code.temp-obj-code =v-select-obj-code
     1517       no-error .
     1518     if available temp-obj-code
     1519     then do:
     1520       assign
     1521         v-reposition-rowid = rowid(temp-obj-code)
     1522       .
     1523     end.
     1524     else do:
     1525       find last temp-obj-code no-error .
     1526          if available temp-obj-code
     1527          then do:
     1528       assign
     1529         v-reposition-rowid = rowid(temp-obj-code)
     1530       .
     1531          end.
     1532          else do:
     1533       assign
     1534         v-reposition-rowid = ?
     1535       .
     1536       end.
     1537     end.
     1538     OPEN QUERY BROWSE-1 FOR EACH temp-obj-code.
     1539     if v-reposition-rowid <> ?
     1540     then do:
     1541       reposition BROWSE-1 to rowid v-reposition-rowid .
     1542     end.
     1543     apply 'entry':u to browse BROWSE-1 .
     1544   END PROCEDURE.
