     2297   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   PROCEDURE term-prt.
     2299   define input parameter rs-list-method as character no-undo .
     2300   define input parameter rs-status as character no-undo .
     2301   define input parameter line-mode as character no-undo .
     2302   define input parameter c-root like ub.gds-prt.prt-root no-undo.
     2303   define input parameter c-node like ub.gds-prt.node-code no-undo.
     2304   define buffer b-g-p for ub.gds-prt.
     2305   define buffer pr-bc for ub.bar-code .
     2306   define buffer b-bc for ub.bar-code .
     2307   define buffer p-bar-code for ub.bar-code .
     2308   define buffer b-units for ub.units.
     2309   define variable pusto as char init "" no-undo.
     2310   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2312     (input  ub.goods.gds-code
     2313     ,input  ?
     2314     ,output main-b-code
     2315     ) no-error .
     2316     if LOOKUP('топ':U, ub.units.type) > 0 and
     2317         LOOKUP('дро':U, ub.units.type) > 0 AND
     2318         ub.goods.gds-type = 'т':U
     2319     then do:
     2320           petrol-trk = yes.
     2321     end.
     2322     else petrol-trk = no.
     2323     _b-g-p:
     2324      FOR EACH ub.bar-code NO-LOCK where
     2325               ub.bar-code.gds-code = ub.goods.gds-code,
     2326         FIRST b-g-p NO-LOCK WHERE
     2327               b-g-p.node-code = ub.bar-code.node-code
     2328          AND  b-g-p.prt-root = c-root
     2329          AND  b-g-p.is-term = yes
     2330        :
     2331        if ub.bar-code.part-code <> ""
     2332        OR ub.bar-code.in-code <> ""
     2333        OR ub.bar-code.unit-cli <> ub.goods.unit-base then NEXT _b-g-p.
     2334   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2335   FIND FIRST ub.prt-obj WHERE
     2336           ub.prt-obj.obj-type = p-curr-obj-type AND
     2337           ub.prt-obj.obj-code = p-curr-obj-code AND
     2338           ub.prt-obj.prod-type = ub.goods.prod-type AND
     2339           ub.prt-obj.prod-code = ub.goods.prod-code AND
     2340           ub.prt-obj.artic = ub.goods.artic AND
     2341           ub.prt-obj.prt-code = b-g-p.node-code NO-LOCK NO-ERROR .
     2342   if v-is-restaurant and v-is-null-price then.
     2343   else do:
     2344   if (NOT temp-shop.all-prt )
     2345       AND  ub.goods.gds-type = 'т':U
     2346       AND  NOT l-empty-scale then do:
     2347     if not available ub.prt-obj then do:
     2348       if temp-shop.sub-store-on then do:
     2349         if NOT can-find( first ub.gds-dtl where
     2350                             ub.gds-dtl.artic = ub.goods.artic AND
     2351                             ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2352                             ub.gds-dtl.prod-code = ub.goods.prod-code AND
     2353                             ub.gds-dtl.prt-code = b-g-p.node-code AND
     2354                             ub.gds-dtl.obj-type =  temp-shop.sub-store-type AND
     2355                             ub.gds-dtl.obj-code = temp-shop.sub-store-code) then
     2356                     NEXT _b-g-p.
     2357       end.
     2358       else do:
     2359                     NEXT _b-g-p.
     2360       end.
     2361     end.
     2362   end.
     2363   end.
     2364   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2365     if ((LOOKUP('сер':U, ub.units.type) = 0  and not cashparts) OR
     2366         (LOOKUP('сер':U, ub.units.type) > 0 and NOT temp-shop.cd-parts-ser)
     2367        )
     2368       then do:
     2369   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   FIND FIRST b-units No-LOCK WHERE
     2371              b-units.unit-name = ub.bar-code.unit-cli No-ERROR.
     2372   if (temp-shop.cd-bc-base or temp-shop.cd-loc-base) and (NOT petrol-trk
     2373   or v-notcd
     2374   )
     2375   then do:
     2376         run asc-gds in this-procedure (
     2377         input rs-list-method,
     2378         input rs-status,
     2379         input line-mode,
     2380         buffer ub.goods,
     2381         buffer ub.bar-code,
     2382         buffer ub.gds-prt,
     2383         buffer ub.gds-obj,
     2384         buffer ub.price-list,
     2385         buffer ub.units,
     2386         buffer b-g-p,
     2387         input ?,
     2388         input '',
     2389         input (if avail b-units then b-units.type else ub.units.type),
     2390         input (if avail b-units then b-units.okei else ub.units.okei),
     2391         input ub.sysconf.host-code,
     2392         input p-curr-obj-type,
     2393         input p-curr-obj-code
     2394         )  no-error .
     2395        if error-status:error then return error.
     2396   end.
     2397   if temp-shop.cd-pb-base or temp-shop.cd-pb-alt or temp-shop.cd-sc-base OR petrol-trk then do:
     2398     FOR EACH ub.prod-bc NO-LOCK WHERE
     2399              ub.prod-bc.b-code = ub.bar-code.b-code
     2400                 :
     2401         if  ub.prod-bc.b-str = string( ub.bar-code.b-code )
     2402             AND
     2403             (
     2404             (ub.goods.unit-base = ub.bar-code.unit-cli AND temp-shop.cd-loc-base) OR
     2405             (NOT ub.goods.unit-base = ub.bar-code.unit-cli AND temp-shop.cd-loc-alt)
     2406             ) AND
     2407             (NOT petrol-trk
     2408             or v-notcd
     2409             )
     2410             then NEXT.
     2411       if temp-shop.cd-sc-base AND
     2412       (LOOKUP('вес':U, ub.units.type) > 0
     2413       or
     2414       LOOKUP('топ':U, ub.units.type) > 0
     2415       or
     2416       ub.prod-bc.bc-on-type = 'pglc':U
     2417       )
     2418       and
     2419       ub.bar-code.unit-cli = ub.goods.unit-base then do:
     2420         if not ub.prod-bc.bc-on-type = 'pglc':U then do:
     2421   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2423     (buffer ub.prod-bc
     2424     ,input  (if LOOKUP('вес':U, ub.units.type) > 0 then 'weight=request':U  else 'petrolium=request':U )
     2425     ,output g#log
     2426     ) no-error .
     2427           if error-status:error or not g#log then NEXT.
     2428         end.
     2429         run asc-gds in this-procedure (
     2430           input rs-list-method,
     2431           input rs-status,
     2432           input line-mode,
     2433           buffer ub.goods,
     2434           buffer ub.bar-code,
     2435           buffer ub.gds-prt,
     2436           buffer ub.gds-obj,
     2437           buffer ub.price-list,
     2438           buffer ub.units,
     2439           buffer b-g-p,
     2440           input ub.prod-bc.b-str,
     2441           input ub.prod-bc.bc-on-type,
     2442           input (if avail b-units then b-units.type else ub.units.type),
     2443           input (if avail b-units then b-units.okei else ub.units.okei),
     2444           input ub.sysconf.host-code,
     2445           input p-curr-obj-type,
     2446           input p-curr-obj-code
     2447           ) no-error.
     2448         if error-status:error then return error.
     2449         NEXT.
     2450       end.
     2451       if ((temp-shop.cd-pb-base AND ub.bar-code.unit-cli = ub.goods.unit-base
     2452       AND LOOKUP('вес':U, units.type) = 0
     2453       and ub.prod-bc.bc-on-type <> 'pglc':U
     2454       ) OR
     2455           (temp-shop.cd-pb-alt AND ub.bar-code.unit-cli <> ub.goods.unit-base)) then do:
     2456         run asc-gds in this-procedure (
     2457           input rs-list-method,
     2458           input rs-status,
     2459           input line-mode,
     2460           buffer ub.goods,
     2461           buffer ub.bar-code,
     2462           buffer ub.gds-prt,
     2463           buffer ub.gds-obj,
     2464           buffer ub.price-list,
     2465           buffer ub.units,
     2466           buffer b-g-p,
     2467           input ub.prod-bc.b-str,
     2468           input ub.prod-bc.bc-on-type,
     2469           input (if avail b-units then b-units.type else ub.units.type),
     2470           input (if avail b-units then b-units.okei else ub.units.okei),
     2471           input ub.sysconf.host-code,
     2472           input p-curr-obj-type,
     2473           input p-curr-obj-code
     2474           ) no-error.
     2475        if error-status:error then return error.
     2476       end.
     2477     END.
     2478   end.
     2479   if NOT petrol-trk
     2480   or v-notcd
     2481   then do:
     2482     FOR EACH b-bc WHERE
     2483               b-bc.gds-code = ub.goods.gds-code AND
     2484               b-bc.node-code = ub.bar-code.node-code AND
     2485               b-bc.part-code = pusto AND
     2486               b-bc.in-code = pusto NO-LOCK :
     2487       if  b-bc.unit-cli <> ub.goods.unit-base then do:
     2488       FIND FIRST b-units No-LOCK WHERE
     2489                  b-units.unit-name = b-bc.unit-cli NO-ERROR.
     2490       if temp-shop.cd-bc-alt or temp-shop.cd-loc-alt then do:
     2491             run asc-gds in this-procedure (
     2492               input rs-list-method,
     2493               input rs-status,
     2494               input line-mode,
