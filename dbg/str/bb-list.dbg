     3508             input (if avail b-units then b-units.type else ub.units.type),
     3509             input (if avail b-units then b-units.okei else ub.units.okei),
     3510             input ub.sysconf.host-code,
     3511             input p-curr-obj-type,
     3512             input p-curr-obj-code
     3513             ) no-error.
     3514           if error-status:error then return error.
     3515         END.
     3516       end.
     3517       end.
     3518     END.
     3519   end.
     3520           end.
     3521         end.
     3522       end.
     3523       else do:
     3524         FOR EACH ub.parts NO-LOCK  WHERE
     3525                   ub.parts.obj-type  = p-curr-obj-type AND
     3526                   ub.parts.obj-code  = p-curr-obj-code AND
     3527                   ub.parts.artic     = ub.goods.artic AND
     3528                   ub.parts.prod-type = ub.goods.prod-type AND
     3529                   ub.parts.prod-code = ub.goods.prod-code AND
     3530                   ub.parts.rsrv-free = yes AND
     3531                   ub.parts.status_ = no AND
     3532                   ub.parts.part-code <> ""
     3533         break
