     2039   procedure fltfield-clear :
     2040     define output parameter loc-fld as character no-undo.
     2041     define output parameter loc-lab as character no-undo .
     2042     define output parameter loc-spr as character no-undo .
     2043     define output parameter loc-dim as character no-undo .
     2044     assign
     2045       loc-fld = ""
     2046       loc-lab = ""
     2047       loc-spr = ""
     2048       loc-dim = "0"
     2049     .
     2050   end procedure .
     2051   procedure fltfield-add :
     2052     define input        parameter par-fld as character no-undo.
     2053     define input        parameter par-lab as character no-undo .
     2054     define input        parameter par-spr as character no-undo .
     2055     define input-output parameter loc-fld as character no-undo.
     2056     define input-output parameter loc-lab as character no-undo .
     2057     define input-output parameter loc-spr as character no-undo .
     2058     define input-output parameter loc-dim as character no-undo .
     2059     do
     2060     on error undo, return error
     2061     :
     2062       assign
     2063       loc-fld = if loc-dim = '0'
     2064                 then par-fld
     2065                 else (loc-fld + chr(44) + par-fld)
     2066       loc-lab = if loc-dim = '0'
     2067                 then par-lab
     2068                 else (loc-lab + chr(44) + par-lab)
     2069       loc-spr = if loc-dim = '0'
     2070                 then par-spr
     2071                 else (loc-spr + chr(44) + par-spr)
     2072       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     2073                 string(integer(if num-entries(loc-dim) > 1
     2074                               then entry(2, loc-dim)
     2075                               else entry(1, loc-dim)
     2076                               ) + 1)
     2077       no-error
     2078       .
     2079     end.
     2080   end procedure.
