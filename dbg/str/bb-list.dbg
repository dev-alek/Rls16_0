     9061             run gbl/d-askw.w (input "Вопрос",
     9062                                   input  ("На каждом объекте весовые товары взвешиваются" + chr(10)
     9063                                           + "с ипользованием определенного кода" + chr(10)
     9064                                           + "(Атрибут товара на объекте ВЕСОВОЙ КОД)" + chr(10)
     9065                                           + "Определите какие коды включать в выборку"
     9066                                           ),
