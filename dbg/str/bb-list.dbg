     8087     (buffer buf_prod-bc
     8088     ,input  'global=request':u
     8089     ,output l-prod-bc-glob
     8090     ) no-error .
     8091                 if not l-prod-bc-glob then next _prod-bc.
     8092                 find first buf_bar-code no-lock
     8093                   where buf_bar-code.b-code = buf_prod-bc.b-code
     8094                 .
     8095                 if available buf_bar-code then do:
     8096                   find first ub.goods no-lock
     8097                     where ub.goods.gds-code = buf_bar-code.gds-code
     8098                     no-error
     8099                   .
     8100                   case v-using:
     8101                     when "all" then do:
     8102                     end.
     8103                     otherwise do:
     8104                       _gds-obj-attr:
     8105                       for each buf_clients no-lock where
     8106                               buf_clients.db-num = v-db-num,
     8107                           each buf_gds-obj-attr no-lock where
     8108                               buf_gds-obj-attr.obj-type = buf_clients.obj-type
     8109                           and  buf_gds-obj-attr.obj-code = buf_clients.obj-code
     8110                           and  buf_gds-obj-attr.gds-code = ub.goods.gds-code :
     8111                         if buf_gds-obj-attr.attr-value = buf_prod-bc.b-str
     8112                         and v-using = "nonusing" then do:
     8113                           find first buf_scales-gds no-lock where
     8114                                   buf_scales-gds.db-num = v-db-num
     8115                               and buf_scales-gds.obj-type = buf_clients.obj-type
     8116                               and buf_scales-gds.obj-code = buf_clients.obj-code
     8117                               and buf_scales-gds.b-code = buf_bar-code.b-code no-error.
     8118                           if available buf_scales-gds then do:
     8119                             next _prod-bc.
     8120                           end.
     8121                         end.
     8122                         if buf_gds-obj-attr.attr-value = buf_prod-bc.b-str
     8123                         and v-using = "using" then do:
     8124                           leave _gds-obj-attr.
     8125                         end.
     8126                       end.
     8127                       if v-using = "using"
     8128                       and not available buf_gds-obj-attr then next _prod-bc.
     8129                     end.
     8130                   end case.
     8131                   run get-prt-and-unit in this-procedure (
     8132                                                             input ub.goods.prt-root
     8133                                                           ,input ub.goods.unit-base
     8134                                                           ,output l-empty-scale
     8135                                                           ) .
     8136                   run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode ,  input l-empty-scale, input buf_prod-bc.b-str, input no, buffer buf_bar-code, buffer buf_prod-bc).
     8137                 end.
     8138               end.
     8139             end.
     8140           end.
     8141         end.
     8142         assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8143       end.
     8144     end.
     8145     when "filter" then do:
     8146       define variable v-filter-var as character no-undo .
     8147       find first buf_bb-list-hist where
     8148               buf_bb-list-hist.id = p-id
     8149           AND buf_bb-list-hist.item_ <> '':U .
     8150       run proc-write-filter-expression-var in this-procedure ( input buf_bb-list-hist.item_, output v-filter-var ).
     8151       run gbl/bb-fill.p (
     8152                       input "Формирование списка по фильтру (без учета сортировки)"
     8153                     , input rs-list-method
     8154                     , input rs-status
     8155                     , input line-mode
     8156                     , input v-filter-var
     8157                     , output lns-cnt
     8158                     , output line-rec
     8159                     ) .
     8160       assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8161     end.
     8162   end.
     8163   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8164   if session:set-wait-state( "" )  then .
     8165   case line-mode :
     8166     when 'ДОБАВЛЕНИЕ':U then do:
     8167       tot-lns = tot-lns + lns-cnt.
     8168       if not p-from-macro or p-step then
     8169       message
     8170       "Добавлено строк :" lns-cnt skip(0)
     8171       string(if lns-ignore <> 0
     8172       then ("Проигнорировано строк :" + string(lns-ignore))
     8173       else "":U)
     8174       .
     8175     end.
     8176     when 'удаление':U then do:
     8177       tot-lns = tot-lns - lns-cnt.
     8178       if not p-from-macro or p-step then
     8179       message
     8180       "Удалено строк :" lns-cnt skip(0)
     8181       string(if lns-ignore <> 0
     8182       then ("Проигнорировано строк :" + string(lns-ignore))
     8183       else "":U)
     8184       .
     8185     end.
     8186   end.
     8187   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on.
     8188   end.
     8189   END PROCEDURE.
     8190   procedure proc-file-list-methods :
     8191   define input parameter p-from-macro as logical no-undo .
     8192   define input parameter rs-list-method as character no-undo .
     8193   define input parameter rs-status as character no-undo .
     8194   define input parameter line-mode as character no-undo .
     8195   define input parameter p-id      as integer no-undo .
     8196   define variable ss as character no-undo .
     8197   define variable b-c as integer no-undo.
     8198   define variable imp-type like ub.goods.prod-type no-undo.
     8199   define variable imp-code like ub.goods.prod-code no-undo.
     8200   define variable imp-art like ub.goods.artic no-undo.
     8201   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     8202   define variable imp-doc-type as character no-undo.
     8203   define variable scan-qnty as dec no-undo.
     8204   define variable bc-qnty as dec no-undo.
     8205   define variable varresult   as character         no-undo.
     8206   define variable vartype-bc  as character         no-undo.
     8207   define variable varweight   as decimal           no-undo.
     8208   define variable v-full-path        as character no-undo .
     8209   define variable v-path             as character no-undo .
     8210   define variable v-file-name        as character no-undo .
     8211   define variable v-file-name-no-ext as character no-undo .
     8212   define variable v-file-name-ext    as character no-undo .
     8213   define buffer buf_bb-list-hist for bb-list-hist.
     8214   do
     8215   on error undo, return error
     8216   :
     8217   find first buf_bb-list-hist where
     8218             buf_bb-list-hist.id = p-id
     8219         AND buf_bb-list-hist.item_ <> '':U .
     8220   run gbl/filename.p
     8221     (input  entry(1, buf_bb-list-hist.item_, chr(4) )
     8222     ,output v-full-path
     8223     ,output v-path
     8224     ,output v-file-name
     8225     ,output v-file-name-no-ext
     8226     ,output v-file-name-ext
     8227     ) no-error .
     8228     if error-status:error then do: end. else do:
     8229     input stream sout from value (v-full-path).
     8230     CASE rs-list-method:
     8231       when "file-gds" then do:
     8232         if p-from-macro then
     8233         run restore-codes in this-procedure (input entry(2, buf_bb-list-hist.item, chr(4)), input p-curr-obj-type, input p-curr-obj-code).
     8234         repeat:
     8235             import stream sout imp-type imp-code imp-art scan-qnty no-error.
     8236             find ub.goods where ub.goods.prod-type = imp-type
     8237                         and ub.goods.prod-code = imp-code
     8238                         and ub.goods.artic     = imp-art no-lock no-error.
     8239             if available ub.goods then do:
     8240               assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8241               run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     8242             end.
     8243           end.
     8244       end.
     8245       when "scaner" then do:
     8246          repeat:
     8247           import stream sout unformatted ss.
     8248           ss = trim (ss).
     8249           if ss = "" then next.
     8250           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
     8251             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
     8252             else next.
     8253             assign
     8254             scan-qnty = dec (entry (2, ss))
     8255             ss = trim (entry (1, ss)).
     8256   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     8257   (
     8258    input  parparentproc
     8259   ,input  ss
     8260   ,input  ?
     8261   ,input  p-curr-obj-type
     8262   ,input  p-curr-obj-type
     8263   ,input  yes
     8264   ,input  no
     8265   ,input  varscales-pref
     8266   ,input  varpgscales-pref
     8267   ,output varresult
     8268   ,output vartype-bc
     8269   ,output varweight
     8270   ,buffer ub.bar-code
     8271   ,buffer ub.prod-bc
     8272   ,buffer ub.place
     8273   ) no-error.
     8274           if not available ub.bar-code then next.
     8275           bc-qnty = ub.bar-code.cli-base-rate.
     8276           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8277           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK no-error.
     8278           if available ub.goods then do:
     8279             run get-prt-and-unit in this-procedure (
     8280                                                     input ub.goods.prt-root
     8281                                                     ,input ub.goods.unit-base
     8282                                                     ,output l-empty-scale
     8283                                                     ) .
     8284             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input (not available prod-bc), buffer bar-code, buffer prod-bc).
     8285             if available bb-list and
     8286               bb-list.artic = ub.goods.artic and
     8287               bb-list.prod-type = ub.goods.prod-type and
     8288               bb-list.prod-code = ub.goods.prod-code then
     8289               bb-list.qnty = bb-list.qnty + scan-qnty * bc-qnty.
     8290           end.
     8291         end.
     8292       end.
     8293     END CASE.
     8294     input stream sout close.
     8295     assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8296     end.
     8297   end.
     8298   END PROCEDURE.
     8299   PROCEDURE write-hist :
     8300   define input parameter p-from-macro as logical no-undo .
     8301   define input parameter rs-list-method as character no-undo .
     8302   define input parameter rs-status as character no-undo .
     8303   define input parameter line-mode as character no-undo .
     8304   define parameter buffer buf_goods for ub.goods.
     8305   define variable v-ii as integer no-undo .
     8306   define variable v-temp-seq as integer no-undo .
     8307   if rs-list-method begins "single" then do:
     8308     if v-no-hist < 0 then do:
     8309       run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8310                                           , input-output v-seq
     8311                                           , input 0
     8312                                           , input get-hist-mode(line-mode)
     8313                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8314                                                   then (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8315                                                             , buf_goods.gds-code
     8316                                                             , buf_goods.artic
     8317                                                             , buf_goods.prod-type
     8318                                                             , buf_goods.prod-code
     8319                                                             , buf_goods.gds-name) +
     8320                                                          (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8321                                                   else substitute("КОД &1 товар c гл.кодом &2 &3 &4&5 &6"
     8322                                                             , (if bb-list.b-str <> '':U then bb-list.b-str else string(bb-list.b-code))
     8323                                                             , bb-list.gds-code
     8324                                                             , bb-list.artic
     8325                                                             , bb-list.prod-type
     8326                                                             , bb-list.prod-code
     8327                                                             , bb-list.gds-name)
     8328                                                   )
     8329                                           , input tot-lns
     8330                                           , input (rs-list-method + (if line-mode = 'ДОБАВЛЕНИЕ':U
     8331                                                                     then '':U
     8332                                                                     else (chr(4) + (if bb-list.b-str <> '':U
     8333                                                                                           then 'prod-bc':U
     8334                                                                                           else (if bb-list.loc-ean
     8335                                                                                                 then 'loc-ean':U
     8336                                                                                                 else 'bar-code':U)
     8337                                                                                           )
     8338                                                                           )
     8339                                                                     )
     8340                                                   )
     8341                                           , input rs-status
     8342                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8343                                                    then ('goods':U + chr(3) + string(buf_goods.gds-code) + chr(4) +
     8344                                                          (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8345                                                    else (if bb-list.b-str <> '':u and bb-list.loc-ean = no
     8346                                                         then ('prod-bc':U + chr(3) + bb-list.b-str)
     8347                                                         else ('bar-code':U + chr(3) + string(bb-list.b-code))
     8348                                                         )
     8349                                                    )
     8350                                           , input '':U
     8351                                           , input ?
     8352                                           ).
     8353     end.
     8354     else do:
     8355       v-temp-seq = v-seq - 1.
     8356       do v-ii = 0 to v-no-hist:
     8357         run create-bb-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8358                                             , input-output v-temp-seq
     8359                                             , input v-ii
     8360                                             , input get-hist-mode(line-mode)
     8361                                             , input (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8362                                                               , bb-list.gds-code
     8363                                                               , bb-list.artic
     8364                                                               , bb-list.prod-type
     8365                                                               , bb-list.prod-code
     8366                                                               , bb-list.gds-name) +
     8367                                                      (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8368                                             , input tot-lns
     8369                                             , input '':U
     8370                                             , input '':U
     8371                                             , input ('goods':U + chr(3) + string(bb-list.gds-code) +
     8372                                                     (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8373                                             , input '':U
     8374                                             , input ?
     8375                                             ).
     8376       end.
     8377     end.
     8378   end.
     8379   else do:
     8380     v-temp-seq = v-seq - 1.
     8381     do v-ii = 0 to v-no-hist:
     8382       run create-bb-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8383                                           , input-output  v-temp-seq
     8384                                           , input v-ii
     8385                                           , input get-hist-mode(line-mode)
     8386                                           , input '':U
     8387                                           , input tot-lns
     8388                                           , input rs-list-method
     8389                                           , input '':U
     8390                                           , input '':U
     8391                                           , input '':U
     8392                                           , input ?
     8393                                           ).
     8394     end.
     8395   end.
     8396   END.
     8397   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8398   DEFINE VARIABLE var-stat-line as character no-undo .
     8399   CASE p-status-chr:
     8400     when 'все':U then do:
     8401       assign
     8402       var-stat-line = "(текущие и удаленные товары)"
     8403       .
     8404     end.
     8405     when 'текущие':U then do:
     8406       assign
     8407       var-stat-line = "(текущие товары)"
     8408       .
     8409     end.
     8410     when 'удаленные':U then do:
     8411       assign
     8412       var-stat-line = "(неактивные товары)"
     8413       .
     8414     end.
     8415   END CASE.
     8416   return var-stat-line .
     8417   END.
     8418   procedure proc-vc-rs-list-method :
     8419   define variable v-operation as integer no-undo .
     8420   define variable main-code like ub.bar-code.b-code no-undo .
     8421   define variable v-chk-date-chr as character no-undo .
     8422   define variable dsp-rs-option as character no-undo .
     8423   define variable v-curr-host-code like ub.sysconf.host-code no-undo .
     8424   define variable v-item_ as character no-undo .
     8425   define variable v-tbl-name as character no-undo .
     8426   define variable v-bh as handle no-undo .
     8427   define variable v-recs as integer   no-undo .
     8428   define variable v-temp-seq as integer   no-undo .
     8429   define variable v-line as integer   no-undo .
     8430   define variable v-tot-lns as integer   no-undo .
     8431   define variable f-name as character no-undo .
     8432   define variable rid-list as character no-undo .
     8433   define variable bar_code as character no-undo .
     8434   define variable v-jj as integer no-undo .
     8435   define variable v-rid as recid no-undo .
     8436   define buffer buf_bb-list-hist for bb-list-hist.
     8437   define buffer buf_prod-bc for ub.prod-bc.
     8438   define buffer buf_bar-code for ub.bar-code.
     8439   define buffer buf_cash-desk for ub.cash-desk.
     8440   define buffer buf_db for ub.db.
     8441     do
     8442     on error undo, return error
     8443     :
