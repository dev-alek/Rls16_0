     3674               buffer ub.price-list,
     3675               buffer ub.units,
     3676               buffer b-g-p,
     3677               input ?,
     3678               input '',
     3679               input (if avail b-units then b-units.type else ub.units.type),
     3680               input (if avail b-units then b-units.okei else ub.units.okei),
     3681               input ub.sysconf.host-code,
     3682               input p-curr-obj-type,
     3683               input p-curr-obj-code
     3684               ) no-error.
     3685        if error-status:error then return error.
     3686        end.
     3687        if temp-shop.cd-pb-alt then do:
     3688          FOR EACH ub.prod-bc NO-LOCK WHERE
     3689                   ub.prod-bc.b-code = b-bc.b-code
     3690                  :
     3691           if ub.prod-bc.b-str = string( b-bc.b-code ) AND temp-shop.cd-loc-alt then NEXT.
     3692           run asc-gds in this-procedure (
     3693             input rs-list-method,
     3694             input rs-status,
     3695             input line-mode,
     3696             buffer ub.goods,
     3697             buffer b-bc,
     3698             buffer ub.gds-prt,
