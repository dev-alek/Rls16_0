     3483               input (if avail b-units then b-units.okei else ub.units.okei),
     3484               input ub.sysconf.host-code,
     3485               input p-curr-obj-type,
     3486               input p-curr-obj-code
     3487               ) no-error.
     3488        if error-status:error then return error.
     3489        end.
     3490        if temp-shop.cd-pb-alt then do:
     3491          FOR EACH ub.prod-bc NO-LOCK WHERE
     3492                   ub.prod-bc.b-code = b-bc.b-code
     3493                  :
     3494           if ub.prod-bc.b-str = string( b-bc.b-code ) AND temp-shop.cd-loc-alt then NEXT.
     3495           run asc-gds in this-procedure (
     3496             input rs-list-method,
     3497             input rs-status,
     3498             input line-mode,
     3499             buffer ub.goods,
     3500             buffer b-bc,
     3501             buffer ub.gds-prt,
     3502             buffer ub.gds-obj,
     3503             buffer ub.price-list,
     3504             buffer ub.units,
     3505             buffer b-g-p,
     3506             input ub.prod-bc.b-str,
