    10594   PROCEDURE proc-parts-end :
    10595   define input parameter rs-list-method as character no-undo .
    10596   define variable v-value-integer as integer   no-undo .
    10597   define variable glog as logical no-undo .
    10598   define variable v-message as character no-undo .
    10599   define variable v-item as character no-undo .
    10600   define variable v-from-date as date no-undo .
    10601   define variable v-to-date as date no-undo .
    10602   define buffer buf_rp-by-call for ub.rp-by-call.
    10603   find first buf_rp-by-call no-lock where
    10604             buf_rp-by-call.profile_id = 62 no-error.
    10605   if not available buf_rp-by-call then do:
    10606     message
    10607     "В вашей системе НЕ ВКЛЮЧЕН профайл установки флагов на закончившиеся партии" skip
    10608     "Отбор невозможен"
    10609     view-as alert-box error .
    10610     return error.
    10611   end.
    10612   assign
    10613   frame Dialog-Frame
    10614   t-parts-not-blank
    10615   t-parts-all
    10616   .
    10617   if not (t-parts-not-blank or t-parts-all ) then do:
    10618     message
    10619     "У Вас не включен флаг <на непуст. № парт.> ИЛИ <все партии>" skip
    10620     "Вы уверены, что Вам нужны коды ПАРТИЙ?"
    10621     view-as alert-box question buttons yes-no update glog.
    10622     if not glog then do:
    10623       undo, return error .
    10624     end.
    10625   end.
    10626   glog = yes.
    10627   CASE rs-list-method:
    10628     when "parts-end-date-obj":U then do:
    10629       assign
    10630       v-message = substitute("Лок.коды закончившихся партий по объекту &1&2", chr(10), stat-line(rs-status))
    10631       .
    10632     end.
    10633     when "parts-ean-end-date-obj":U then do:
    10634       assign
    10635       v-message = substitute("Лок.коды (EAN) закончившихся партий по объекту &1&2", chr(10), stat-line(rs-status))
    10636       .
    10637     end.
    10638   END CASE.
    10639   message
    10640   v-message
    10641   view-as alert-box question buttons OK-Cancel update glog.
    10642   if not glog then do:
    10643     return error.
    10644   end.
    10645   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10646   run userobjs_select-one in this-procedure
    10647     (input  parparentproc
    10648     ,input  v-cntxt-db-num
    10649     ,input  v-cntxt-userid
    10650     ,input  v-cntxt-host-code-obj
    10651     ,input  v-cntxt-obj-type
    10652     ,input  v-cntxt-obj-code
    10653     ,output v-user-select
    10654     ,output v-sel-obj-type
    10655     ,output v-sel-obj-code
    10656     )  .
    10657   if not v-user-select then do:
    10658     return error.
    10659   end.
    10660   message
    10661   "Выберите начальную и конечную даты, между которыми было обнаружено, что партия закончилась"
    10662   view-as alert-box.
    10663   run gbl/get-per.w ( output glog
    10664                      ,input-output v-from-date
    10665                      ,input-output v-to-date
    10666                      ) no-error.
    10667   CASE rs-list-method:
    10668     when "parts-end-date-obj":U then do:
    10669       assign
    10670       dsp-rs = substitute("Лок.коды закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10671       v-item = v-sel-obj-type + chr(3) +
    10672                string(v-sel-obj-code) + chr(3) +
    10673                string(v-from-date, "99/99/9999") + chr(3) +
    10674                string(v-to-date, "99/99/9999")
    10675       .
    10676     end.
    10677     when "parts-ean-end-date-obj":U then do:
    10678       assign
    10679       dsp-rs = substitute("Лок.коды (EAN) закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10680       v-item = v-sel-obj-type + chr(3) +
    10681                string(v-sel-obj-code) + chr(3) +
    10682                string(v-from-date, "99/99/9999") + chr(3) +
    10683                string(v-to-date, "99/99/9999")
    10684       .
    10685     end.
    10686   END CASE.
    10687   v-no-hist = 0.
    10688   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10689                                       , input-output v-seq
    10690                                       , input 0
    10691                                       , input '':U
    10692                                       , input dsp-rs
    10693                                       , input tot-lns
    10694                                       , input rs-list-method
    10695                                       , input rs-status
    10696                                       , input v-item
    10697                                       , input '':U
    10698                                       , input ?
    10699                                       ).
    10700   END PROCEDURE.
