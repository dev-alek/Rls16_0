     6742     ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6743     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6744   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
