    10435           input ?
    10436         ,input (
    10437         'title=':u + substitute("Введите кол-во дней, в течение которых истекает срок хранения") + '\':u
    10438       + 'text1=':u + "Кол-во дней" + '\':u
    10439       + 'format=' + "->>9" + '\':u
    10440       + 'fillin_row=3\':u
    10441       + 'fillin_col=4\':u
    10442       + 'fillin_width=20\':u
    10443       + 'fillin_height=1\':u
    10444       + 'max-chars=70\':u
    10445       + 'readonly=' +  'no':u + '\':u)
    10446       , input-output v-value-integer
    10447       , output v-ok
    10448           ).
    10449   if not v-ok then return error.
