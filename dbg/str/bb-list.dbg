     9299           end.
     9300           otherwise do:
     9301             assign
     9302             dsp-rs = "":U.
     9303             run UI-on.
     9304             return error.
     9305           end.
     9306         END CASE.
     9307         if error-status:error then do:
     9308           run UI-on.
     9309           return error return-value .
     9310         end.
     9311       end.
     9312       assign
     9313       rs-list-method = temp-list.fvalue
     9314       .
     9315       find last buf_bb-list-hist no-lock where
     9316                 buf_bb-list-hist.id = (v-seq - 1)
     9317           and  buf_bb-list-hist.line = 0 no-error .
     9318       DISPLAY
     9319       (if available buf_bb-list-hist
     9320       then buf_bb-list-hist.des
     9321       else '') @ dsp-rs
     9322       with frame Dialog-Frame.
     9323       if tot-lns = 0
     9324       then do:
     9325         run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
     9326       end.
     9327     end.
     9328   end.
     9329   end procedure.
     9330   procedure proc-scn-tsd :
     9331     do
     9332     on error undo, return error
     9333     :
     9334     run str/diallog.w (parparentproc
     9335                 , this-procedure
     9336                 , 'str/send-tsd.p':U
     9337                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code) + chr(4) + "bb-list":U)
     9338                 , no
     9339                 , '':U
     9340                 , 'Пересылка товаров на ТСД') no-error .
     9341     end.
     9342   end procedure.
     9343   procedure proc-b-add :
     9344   define input parameter p-from-macro as logical no-undo .
     9345   define input parameter p-rowid as rowid no-undo .
     9346   define input parameter rs-list-method as character no-undo .
     9347   define input parameter rs-status as character no-undo .
     9348     do
     9349     on error undo, return error
     9350     :
     9351     line-mode = 'ДОБАВЛЕНИЕ':U.
     9352     if rs-list-method = "single" then do:
     9353        v-no-hist = - 1.
     9354       if p-from-macro then do:
     9355       end.
     9356       else do:
     9357         assign
     9358         frame Dialog-Frame
     9359         T-all-prt
     9360         T-bc-alt
     9361         T-bc-base
     9362         T-loc-alt
     9363         T-loc-base
     9364         T-parts-all
     9365         T-parts-not-blank
     9366         T-parts-ser
     9367         T-pb-alt
     9368         T-pb-base
     9369         T-sc-base
     9370         .
     9371         if (
     9372         T-all-prt or
     9373         T-bc-alt  or
     9374         T-bc-base or
     9375         T-loc-alt or
     9376         T-loc-base  or
     9377         T-parts-all  or
     9378         T-parts-not-blank or
     9379         T-parts-ser or
     9380         T-pb-alt    or
     9381         T-pb-base   or
     9382         T-sc-base) = no then do:
     9383           message
     9384           "Не выбран ни один тип кодов!"
     9385           view-as alert-box error .
     9386           undo, return error .
     9387         end.
     9388         assign
     9389         temp-shop.obj-code = p-curr-obj-code
     9390         temp-shop.all-prt = T-all-prt
     9391         temp-shop.cd-bc-alt = T-bc-alt
     9392         temp-shop.cd-bc-base = T-bc-base
     9393         temp-shop.cd-loc-alt = T-loc-alt
     9394         temp-shop.cd-loc-base = T-loc-base
     9395         temp-shop.cd-parts-all = T-parts-all
     9396         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9397         temp-shop.cd-parts-ser = T-parts-ser
     9398         temp-shop.cd-pb-alt = T-pb-alt
     9399         temp-shop.cd-pb-base = T-pb-base
     9400         temp-shop.cd-sc-base = T-sc-base
     9401         .
     9402       end.
     9403       if p-from-macro then do:
     9404         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
     9405       end.
     9406       else do:
     9407         run ref/gds-ref.p ( input parparentproc
     9408                         ,input "b-sel,b-add"
     9409                         ,input ?
     9410                         ,input ?
     9411                         ,input ?
     9412                         ,input ?
     9413                         ,input ?
     9414                         ,input ?
     9415                         ,input ?
     9416                         ,input p-curr-obj-type
     9417                         ,input p-curr-obj-code
     9418                         ,input ?
     9419                         ,output ref-list).
     9420         apply "entry" to br-list in frame Dialog-Frame.
     9421         if ref-list = "" then
     9422           return no-apply.
     9423         find goods where recid (goods) = integer (ref-list) no-lock no-error.
     9424       end.
     9425       if available goods then do:
     9426         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     9427         tot-lns = tot-lns + lns-cnt.
     9428         run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer goods).
     9429       end.
     9430       else do:
     9431         return error "Нет в БД такого товара".
     9432       end.
     9433       run UI-on.
     9434     end.
     9435     else
     9436       run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9437     end.
     9438   end procedure.
     9439   procedure proc-b-del :
     9440   define input parameter p-from-macro as logical no-undo .
     9441   define input parameter p-rowid as rowid no-undo .
     9442   define input parameter rs-list-method as character no-undo .
     9443   define input parameter rs-status as character no-undo .
     9444   define variable v-rep-rec as recid no-undo .
     9445   define buffer buf_prod-bc for ub.prod-bc.
     9446   define buffer buf_bar-code for ub.bar-code.
     9447     do
     9448     on error undo, return error
     9449     :
     9450       line-mode = 'удаление':U.
     9451       if rs-list-method begins "single" then do:
     9452        v-no-hist = - 1.
     9453         if p-from-macro then do:
     9454           CASE entry(2, rs-list-method, chr(4) ):
     9455             when 'prod-bc':U then do:
     9456               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9457               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9458               find first bb-list where
     9459                          bb-list.b-code = buf_prod-bc.b-code
     9460                      AND bb-list.b-str = buf_prod-bc.b-str no-error.
     9461             end.
     9462             when 'bar-code':U
     9463             or
     9464             when 'loc-ean':U then do:
     9465               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9466               if not available buf_bar-code then return error "Нет в БД такого кода".
     9467               find first bb-list where
     9468                          bb-list.b-code = buf_bar-code.b-code
     9469                      AND bb-list.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9470             end.
     9471           END CASE.
     9472         end.
     9473         if available bb-list then do:
     9474           line-rec = recid (bb-list).
     9475           get next br-list.
     9476           if available bb-list then v-rep-rec = recid (bb-list).
     9477           else do:
     9478             reposition br-list to recid line-rec no-error.
     9479             get prev br-list.
     9480             if available bb-list then v-rep-rec = recid (bb-list).
     9481           end.
     9482           reposition br-list to recid line-rec no-error.
     9483           tot-lns = tot-lns - 1.
     9484           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9485           delete bb-list.
     9486           line-rec = v-rep-rec.
     9487           run UI-on.
     9488         end.
     9489         else do:
     9490           return error "Нет в списке кодов такого кода".
     9491         end.
     9492       end.
     9493       else do:
     9494         glog = no.
     9495         message "Удалить коды ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     9496                 view-as alert-box question buttons OK-Cancel update glog.
     9497         if not glog then  return error.
     9498         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9499       end.
     9500     end.
     9501   end procedure.
     9502   procedure proc-b-rest :
     9503   define input parameter p-from-macro as logical no-undo .
     9504   define input parameter p-rowid as rowid no-undo .
     9505   define input parameter rs-list-method as character no-undo .
     9506   define input parameter rs-status as character no-undo .
     9507   define buffer buf_bb-list-hist for bb-list-hist.
     9508   define buffer buf_prod-bc for ub.prod-bc.
     9509   define buffer buf_bar-code for ub.bar-code.
     9510     do
     9511     on error undo, return error
     9512     :
     9513       line-mode = 'ОСТАВИТЬ':U.
     9514       if rs-list-method begins "single" then do:
     9515         v-no-hist = - 1.
     9516         if p-from-macro then do:
     9517           CASE entry(2, rs-list-method, chr(4) ):
     9518             when 'prod-bc':U then do:
     9519               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9520               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9521               find first bb-list where
     9522                          bb-list.b-code = buf_prod-bc.b-code
     9523                      AND bb-list.b-str = buf_prod-bc.b-str no-error.
     9524             end.
     9525             when 'bar-code':U
     9526             or
     9527             when 'loc-ean':U  then do:
     9528               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9529               if not available buf_bar-code then return error "Нет в БД такого кода".
     9530               find first bb-list where
     9531                          bb-list.b-code = buf_bar-code.b-code
     9532                      AND bb-list.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9533             end.
     9534           END CASE.
     9535         end.
     9536         if available bb-list then do:
     9537         if p-from-macro then do:
     9538             glog = yes.
     9539           end.
     9540           else do:
     9541             glog = no.
     9542             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9543                     view-as alert-box question buttons OK-Cancel update glog.
     9544             if not glog then return error.
     9545           end.
     9546           line-rec = recid (bb-list).
     9547           v-seq = 1.
     9548           for each buf_bb-list-hist:
     9549             delete buf_bb-list-hist.
     9550           end.
     9551           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9552           for each bb-list:
     9553             if line-rec <> recid (bb-list) then delete bb-list.
     9554           end.
     9555           tot-lns = 1.
     9556           run UI-on.
     9557         end.
     9558       end.
     9559       else do:
     9560         glog = no.
     9561         if not p-from-macro then do:
     9562         message "Оставить коды ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9563                 view-as alert-box question buttons OK-Cancel update glog.
     9564           if not glog then
     9565           return no-apply.
     9566         end.
     9567         assign
     9568         lns-cnt = 0
     9569         lns-ignore = 0
     9570         .
     9571         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9572         for each bb-list:
     9573           if bb-list.to-del = ? then do:
     9574             assign
     9575             bb-list.to-del = no
     9576             .
     9577           end.
     9578           else do:
     9579             delete bb-list.
     9580           end.
     9581         end.
     9582         tot-lns = lns-cnt.
     9583         run UI-on.
     9584         message
     9585         "Оставлено строк :" lns-cnt skip(0)
     9586         string(if lns-ignore <> 0
     9587         then ("Проигнорировано строк :" + string(lns-ignore))
     9588         else "":U)
     9589         .
     9590       end.
     9591     end.
     9592   end procedure.
     9593   procedure process-one-good :
     9594   define input  parameter rs-list-method as character no-undo .
     9595   define input  parameter rs-status as character no-undo .
     9596   define input  parameter line-mode as character no-undo .
     9597   define parameter buffer goods for ub.goods.
     9598     do
     9599     on error undo, return error
     9600     :
     9601         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     9602         run get-prt-and-unit in this-procedure (
     9603                                                  input ub.goods.prt-root
     9604                                                 ,input ub.goods.unit-base
     9605                                                 ,output l-empty-scale
     9606                                                 ) .
     9607         FIND FIRST ub.gds-obj WHERE
     9608                   ub.gds-obj.obj-type = p-curr-obj-type AND
     9609                   ub.gds-obj.obj-code = p-curr-obj-code AND
     9610                   ub.gds-obj.artic = ub.goods.artic AND
     9611                   ub.gds-obj.prod-type = ub.goods.prod-type AND
     9612                   ub.gds-obj.prod-code = ub.goods.prod-code nO-LOCK NO-ERROR.
     9613         if v-is-restaurant then do:
     9614           find first buf_fbr-gds-obj no-lock where
     9615                     buf_fbr-gds-obj.obj-type = p-curr-obj-type
     9616                 AND buf_fbr-gds-obj.obj-code = p-curr-obj-code
     9617                 AND buf_fbr-gds-obj.gds-code = ub.goods.gds-code no-error .
     9618           if    available buf_fbr-gds-obj
     9619             and not buf_fbr-gds-obj.is-cd
     9620           then
     9621              NEXT.
     9622         end.
     9623         run get-gds-obj-fields in this-procedure(
     9624                                                    buffer ub.gds-obj
     9625                                                   ,input no
     9626                                                   ,input ub.goods.gds-code
     9627                                                   ,input p-curr-obj-code
     9628                                                   ,input p-curr-obj-type
     9629                                                   ,output for-fact-qnty
     9630                                                   ,output cashparts
     9631                                                   ,output v-is-null-price
     9632                                                   ) no-error .
     9633       RUN term-prt in this-procedure (
     9634                     input rs-list-method
     9635                   , input rs-status
     9636                   , input line-mode
     9637                   , input ub.gds-prt.prt-root
     9638                   , input ?) no-error.
     9639     end.
     9640   end procedure.
     9641   procedure get-gds-obj-fields :
     9642   define parameter buffer buf_gds-obj for ub.gds-obj .
     9643   define input parameter par-find-buffer as logical no-undo .
     9644   define input parameter par-gds-code like ub.goods.gds-code no-undo .
     9645   define input parameter par-obj-code like ub.clients.obj-code no-undo .
     9646   define input parameter par-obj-type like ub.clients.obj-type no-undo .
     9647   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
     9648   define output parameter par-cash-parts as logical no-undo .
     9649   define output parameter p-is-null-price like ub.fbr-gds-obj.is-null-price  no-undo .
     9650     do
     9651     on error undo, return error
     9652     :
     9653       if par-find-buffer then do:
     9654         find first buf_gds-obj no-lock where
     9655                   buf_gds-obj.gds-code = par-gds-code AND
     9656                   buf_gds-obj.obj-type = par-obj-type AND
     9657                   buf_gds-obj.obj-code = par-obj-code no-error .
     9658       end.
     9659       if not avail buf_gds-obj
     9660       and (p-curr-obj-type = 'маг':U and ub.shop.is-catering = no)
     9661       then do:
     9662         return.
     9663       end.
     9664       assign
     9665       par-fact-qnty = (if available buf_gds-obj
     9666                        then buf_gds-obj.fact-qnty
     9667                        else 0)
     9668       .
     9669       assign
     9670       par-cash-parts = (if available buf_gds-obj
     9671                         then buf_gds-obj.cash-parts
     9672                         else no)
     9673       .
     9674       if available buf_fbr-gds-obj then do:
     9675         assign
     9676         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
     9677         .
     9678       end.
     9679     end.
     9680   end procedure.
     9681   procedure get-prt-and-unit :
     9682   define input parameter par-prt-root like ub.goods.prt-root no-undo .
     9683   define input parameter par-unit-base like ub.goods.unit-base no-undo .
     9684   define output parameter par-empty-scale as logical no-undo .
     9685     do
     9686     on error undo, return error
     9687     :
     9688       FIND FIRST ub.gds-prt where
     9689                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
     9690       assign
     9691       par-empty-scale =  NOT (v-doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
     9692       .
     9693       FIND FIRST ub.units WHERE
     9694                  ub.units.unit-name = par-unit-base NO-LOCK .
     9695     end.
     9696   end procedure.
     9697   procedure proc-b-cd :
     9698   define input parameter p-fill-temp-shop as logical no-undo .
     9699     do
     9700     on error undo, return error
     9701     :
     9702     if available ub.shop then do:
     9703       assign
     9704       temp-shop.obj-code =    ub.shop.obj-code
     9705       t-all-prt         =    ub.shop.all-prt
     9706       t-bc-alt          =    ub.shop.cd-bc-alt
     9707       t-bc-base         =    ub.shop.cd-bc-base
     9708       t-loc-alt         =    ub.shop.cd-loc-alt
     9709       t-loc-base        =    ub.shop.cd-loc-base
     9710       t-parts-all       =    ub.shop.cd-parts-all
     9711       t-parts-not-blank =    ub.shop.cd-parts-not-blank
     9712       t-parts-ser       =    ub.shop.cd-parts-ser
     9713       t-pb-alt          =    ub.shop.cd-pb-alt
     9714       t-pb-base         =    ub.shop.cd-pb-base
     9715       t-sc-base         =    ub.shop.cd-sc-base
     9716       .
     9717       if (t-all-prt or
     9718       t-bc-alt     or
     9719       t-bc-base    or
     9720       t-loc-alt    or
     9721       t-loc-base   or
     9722       t-parts-all  or
     9723       t-parts-not-blank or
     9724       t-parts-ser       or
     9725       t-pb-alt          or
     9726       t-pb-base         or
     9727       t-sc-base ) = no then do:
     9728         message
     9729         substitute("Для магазина &1 не выбран ни один тип кодов, выбираем основные локальные&2"  +
     9730                    "Иначе список формировать бесполезно"
     9731                    , shop.obj-code
     9732                    , chr(10))
     9733         view-as alert-box warning.
     9734         t-loc-base = yes.
     9735       end.
     9736       if p-fill-temp-shop then do:
     9737         assign
     9738         temp-shop.obj-code = p-curr-obj-code
     9739         temp-shop.all-prt = T-all-prt
     9740         temp-shop.cd-bc-alt = T-bc-alt
     9741         temp-shop.cd-bc-base = T-bc-base
     9742         temp-shop.cd-loc-alt = T-loc-alt
     9743         temp-shop.cd-loc-base = T-loc-base
     9744         temp-shop.cd-parts-all = T-parts-all
     9745         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9746         temp-shop.cd-parts-ser = T-parts-ser
     9747         temp-shop.cd-pb-alt = T-pb-alt
     9748         temp-shop.cd-pb-base = T-pb-base
     9749         temp-shop.cd-sc-base = T-sc-base
     9750         .
     9751       end.
     9752     end.
     9753     else do:
     9754       assign
     9755       temp-shop.obj-code =  ub.store.obj-code
     9756       t-loc-base         =   yes
     9757       t-all-prt          = no
     9758       t-bc-alt           = no
     9759       t-bc-base          = no
     9760       t-loc-alt          = no
     9761       t-parts-all        = no
     9762       t-parts-not-blank  = no
     9763       t-parts-ser        = no
     9764       t-pb-alt           = no
     9765       t-pb-base          = no
     9766       t-sc-base          = no
     9767       .
     9768       if p-fill-temp-shop then do:
     9769         assign
     9770         temp-shop.obj-code = p-curr-obj-code
     9771         temp-shop.all-prt = T-all-prt
     9772         temp-shop.cd-bc-alt = T-bc-alt
     9773         temp-shop.cd-bc-base = T-bc-base
     9774         temp-shop.cd-loc-alt = T-loc-alt
     9775         temp-shop.cd-loc-base = T-loc-base
     9776         temp-shop.cd-parts-all = T-parts-all
     9777         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9778         temp-shop.cd-parts-ser = T-parts-ser
     9779         temp-shop.cd-pb-alt = T-pb-alt
     9780         temp-shop.cd-pb-base = T-pb-base
     9781         temp-shop.cd-sc-base = T-sc-base
     9782         .
     9783       end.
     9784     end.
     9785       display
     9786       T-loc-base
     9787       T-pb-base
     9788       T-loc-alt
     9789       T-pb-alt
     9790       T-bc-base
     9791       T-sc-base
     9792       T-bc-alt
     9793       T-all-prt
     9794       T-parts-ser
     9795       T-parts-not-blank
     9796       T-parts-all
     9797       with frame Dialog-Frame.
     9798     run proc-cd2 in this-procedure .
     9799     end.
     9800   end procedure.
     9801   procedure proc-cd2 :
     9802   define variable v-fvalue as character no-undo .
     9803     do
     9804     on error undo, return error
     9805     :
     9806       if available temp-list then v-fvalue = temp-list.fvalue.
     9807       CASE v-fvalue:
     9808         when "all"
     9809         or
     9810         when "goods"
     9811         or
     9812         when "gds-list"
     9813         or
     9814         when "file-gds" then do:
     9815           ENABLE
     9816           T-loc-base
     9817           T-loc-alt
     9818           T-bc-base
     9819           T-bc-alt
     9820           T-all-prt
     9821           T-parts-ser
     9822           T-parts-not-blank
     9823           T-parts-all
     9824           T-pb-base
     9825           T-pb-alt
     9826           T-sc-base
     9827           WITH FRAME Dialog-Frame.
     9828         end.
     9829         otherwise do:
     9830           disable
     9831           T-loc-base
     9832           T-loc-alt
     9833           T-bc-base
     9834           T-bc-alt
     9835           T-all-prt
     9836           T-parts-ser
     9837           T-parts-not-blank
     9838           T-parts-all
     9839           T-pb-base
     9840           T-pb-alt
     9841           T-sc-base
     9842           WITH FRAME Dialog-Frame.
     9843         end.
     9844       END CASE.
     9845     end.
     9846   end procedure.
     9847   procedure proc-b-optimize :
     9848   define input  parameter p-from-macro as logical   no-undo .
     9849   define input parameter rs-list-method as character no-undo .
     9850   define input parameter rs-status as character no-undo .
     9851   define input parameter p-option as character no-undo .
     9852   define variable v-cnt as integer   no-undo .
     9853   define variable v-temp-seq as integer   no-undo .
     9854   define variable l-prod-bc-petrolium as logical no-undo .
     9855   define variable l-prod-bc-weight as logical no-undo .
     9856   define buffer b-str_bb-list for bb-list.
     9857   define buffer b-code_bb-list for bb-list.
     9858   define buffer buf_prod-bc for ub.prod-bc.
     9859   define buffer buf_bar-code for ub.bar-code.
     9860   define buffer buf_goods for ub.goods.
     9861   define buffer buf_bb-list-hist for bb-list-hist.
     9862     do
     9863     on error undo, return error
     9864     :
     9865       case p-option:
     9866         when "delnprod-bc" then  do:
     9867           for each b-str_bb-list no-lock :
     9868             if b-str_bb-list.b-str <> "":U
     9869             and b-str_bb-list.loc-ean  = no
     9870             then do:
     9871               for each b-code_bb-list where
     9872                          b-code_bb-list.b-code = b-str_bb-list.b-code
     9873                     AND  (b-code_bb-list.b-str = "":U
     9874                           or
     9875                           b-code_bb-list.loc-ean = yes)
     9876                     :
     9877                 delete b-code_bb-list.
     9878                 v-cnt = v-cnt + 1.
     9879               end.
     9880             end.
     9881           end.
     9882         end.
     9883         when "repnprod-bc" then  do:
     9884           for each b-code_bb-list :
     9885             if b-code_bb-list.b-str =  '':U
     9886             or b-code_bb-list.loc-ean = yes then do:
     9887               find first buf_prod-bc no-lock where
     9888                         buf_prod-bc.b-code = b-code_bb-list.b-code
     9889                     AND buf_prod-bc.bc-on = yes no-error.
     9890               if available buf_prod-bc then do:
     9891                 find first b-str_bb-list no-lock where
     9892                            b-str_bb-list.b-code = buf_prod-bc.b-code
     9893                       AND  b-str_bb-list.b-str = buf_prod-bc.b-str no-error .
     9894                 if available b-str_bb-list then next.
     9895                 assign
     9896                 l-prod-bc-petrolium = no
     9897                 l-prod-bc-weight = no
     9898                 .
     9899   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9901     (buffer buf_prod-bc
     9902     ,input  'weight=request':u
     9903     ,output l-prod-bc-weight
     9904     ) no-error .
     9905                 if error-status:error
     9906                 or l-prod-bc-weight then next.
     9907   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9908   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9909     (buffer buf_prod-bc
     9910     ,input  'petrolium=request':u
     9911     ,output l-prod-bc-petrolium
     9912     ) no-error .
     9913                 if error-status:error
     9914                 or l-prod-bc-petrolium then next.
     9915                 find first buf_bar-code no-lock where
     9916                             buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     9917                 if available buf_bar-code then do:
     9918                   find first ub.goods no-lock where
     9919                             ub.goods.gds-code = buf_bar-code.gds-code no-error.
     9920                   if available goods then do:
     9921                     run get-prt-and-unit in this-procedure (
     9922                                                             input ub.goods.prt-root
     9923                                                             ,input ub.goods.unit-base
     9924                                                             ,output l-empty-scale
     9925                                                             ) .
     9926                     delete b-code_bb-list.
     9927                     v-cnt = v-cnt + 1.
     9928                     run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     9929                   end.
     9930                 end.
     9931               end.
     9932             end.
     9933           end.
     9934         end.
     9935       end case.
     9936       lns-cnt = lns-cnt - v-cnt.
     9937     end.
     9938   end procedure.
     9939   procedure proc-b-obj :
     9940     define input parameter p-mode as character no-undo .
     9941     define variable v-rid-list as character no-undo .
     9942     define buffer buf_clients  for ub.clients.
     9943     define buffer buf_user-obj for ub.user-obj.
     9944     do
     9945     on error undo, return error
     9946     :
     9947       find first buf_user-obj no-lock where
     9948                  buf_user-obj.user-id = v-cntxt-userid
     9949              and buf_user-obj.db-num = v-cntxt-db-num
     9950              and buf_user-obj.obj-type  = p-curr-obj-type
     9951              and buf_user-obj.obj-code  = p-curr-obj-code no-error .
     9952       assign
     9953         v-rid-list = ( if available buf_user-obj then string( recid( buf_user-obj ) ) else "":U )
     9954       .
     9955       if p-mode = "change":U then do:
     9956   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9957   run userobjs_select-one in this-procedure
     9958     (input  parparentproc
     9959     ,input  v-cntxt-db-num
     9960     ,input  v-cntxt-userid
     9961     ,input  v-cntxt-host-code-obj
     9962     ,input  v-cntxt-obj-type
     9963     ,input  v-cntxt-obj-code
     9964     ,output v-user-select
     9965     ,output v-sel-obj-type
     9966     ,output v-sel-obj-code
     9967     )  .
     9968         if v-user-select then do:
     9969           FIND FIRST buf_user-obj NO-LOCK WHERE
     9970                     buf_user-obj.obj-type = buf_user-obj.obj-type
     9971               and buf_user-obj.obj-code = buf_user-obj.obj-code
     9972               and buf_user-obj.db-num = v-cntxt-db-num
     9973               and buf_user-obj.user-id = v-cntxt-userid    NO-ERROR.
     9974           if not available buf_user-obj then do: return no-apply. end.
     9975           find first buf_clients no-lock where
     9976                     buf_clients.obj-type = buf_user-obj.obj-type
     9977                 and buf_clients.obj-code = buf_user-obj.obj-code no-error.
     9978           if not available buf_clients then do: return error. end.
     9979           assign
     9980             p-curr-obj-type = buf_clients.obj-type
     9981             p-curr-obj-code = buf_clients.obj-code
     9982             v-host-code = buf_clients.host-code
     9983             v-obj-type = buf_clients.obj-type
     9984             v-obj-code = buf_clients.obj-code
     9985             v-obj-name = buf_clients.obj-name
     9986           .
     9987           display
     9988           v-obj-name
     9989           v-obj-type
     9990           v-obj-code
     9991           with frame Dialog-Frame.
     9992         end.
     9993       end.
     9994     end.
     9995   end procedure.
     9996   procedure restore-codes :
     9997   define input  parameter p-codes as character no-undo .
     9998   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     9999   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
    10000     do
    10001     on error undo, return error return-value
    10002     :
    10003       if p-obj-type = 'маг':U then do:
    10004       assign
    10005       temp-shop.obj-code =   p-obj-code
    10006       t-all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
    10007       t-bc-alt          =    lookup('bc-alt':U, p-codes, chr(32) ) > 0
    10008       t-bc-base         =    lookup('bc-base':U, p-codes, chr(32) ) > 0
    10009       t-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
    10010       t-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
    10011       t-parts-all       =    lookup('parts-all':U, p-codes, chr(32) ) > 0
    10012       t-parts-not-blank =    lookup('parts-not-blank':U, p-codes, chr(32) ) > 0
    10013       t-parts-ser       =    lookup('parts-ser':U, p-codes, chr(32) ) > 0
    10014       t-pb-alt          =    lookup('pb-alt':U, p-codes, chr(32) ) > 0
    10015       t-pb-base         =    lookup('pb-base':U, p-codes, chr(32) ) > 0
    10016       t-sc-base         =    lookup('sc-base':U, p-codes, chr(32) ) > 0
    10017       temp-shop.all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
    10018       temp-shop.cd-bc-alt          =    lookup('bc-alt':U, p-codes, chr(32) ) > 0
    10019       temp-shop.cd-bc-base         =    lookup('bc-base':U, p-codes, chr(32) ) > 0
    10020       temp-shop.cd-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
    10021       temp-shop.cd-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
    10022       temp-shop.cd-parts-all       =    lookup('parts-all':U, p-codes, chr(32) ) > 0
    10023       temp-shop.cd-parts-not-blank =    lookup('parts-not-blank':U, p-codes, chr(32) ) > 0
    10024       temp-shop.cd-parts-ser       =    lookup('parts-ser':U, p-codes, chr(32) ) > 0
    10025       temp-shop.cd-pb-alt          =    lookup('pb-alt':U, p-codes, chr(32) ) > 0
    10026       temp-shop.cd-pb-base         =    lookup('pb-base':U, p-codes, chr(32) ) > 0
    10027       temp-shop.cd-sc-base         =    lookup('sc-base':U, p-codes, chr(32) ) > 0
    10028       .
    10029       display
    10030       T-loc-base
    10031       T-pb-base
    10032       T-loc-alt
    10033       T-pb-alt
    10034       T-bc-base
    10035       T-sc-base
    10036       T-bc-alt
    10037       T-all-prt
    10038       T-parts-ser
    10039       T-parts-not-blank
    10040       T-parts-all
    10041       with frame Dialog-Frame.
    10042     end.
    10043     run proc-cd2 in this-procedure .
    10044     end.
    10045   end procedure.
    10046   procedure proc-macros :
    10047   define variable glog as logical no-undo .
    10048   define variable v-option as integer no-undo .
    10049   define buffer buf_bb-list-hist for bb-list-hist.
    10050   define buffer buf_macro-list-hist for macro-list-hist.
    10051   if can-find(first macro-list-hist) then do:
    10052     run gbl/d-askw.w ( input "Сохранение макроса"
    10053                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    10054                   ,input "|"
    10055                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    10056                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    10057                   ,input 1
    10058                   ,input 3
    10059                   ,output v-option).
    10060     if v-option = 3 then return no-apply.
    10061     v-option = 1.
    10062   end.
    10063   else do:
    10064     message
    10065     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    10066     view-as alert-box question buttons yes-no update glog.
    10067     v-option = 2.
    10068     if not glog then do:
    10069       return no-apply.
    10070     end.
    10071   end.
    10072     do
    10073     on error undo, return error
    10074     :
    10075     assign
    10076       f-name = "default.bbm"
    10077       glog = yes
    10078       .
    10079     system-dialog get-file f-name
    10080       filters "Макрос создания списка кодов *.bbm" "*.bbm"
    10081       ask-overwrite
    10082       save-as
    10083       use-filename
    10084       update glog
    10085       default-extension "bbm".
    10086     if not glog then do:
    10087       apply "entry" to br-list in frame Dialog-Frame.
    10088       return no-apply.
    10089     end.
    10090     run waitfram-show in this-procedure ("Сохранение макроса формирования списка кодов.    ЖДИТЕ...").
    10091     output stream PrnLibStream to value (f-name).
    10092     case v-option:
    10093       when 1 then do:
    10094         for each buf_macro-list-hist:
    10095           export stream PrnLibStream
    10096           buf_macro-list-hist.
    10097         end.
    10098       end.
    10099       when 2 then do:
    10100     for each buf_bb-list-hist:
    10101         export stream PrnLibStream
    10102         buf_bb-list-hist.
    10103     end.
    10104       end.
    10105     end case.
    10106     output stream PrnLibStream close.
    10107     run waitfram-hide in this-procedure .
    10108     end.
    10109   end procedure.
    10110   PROCEDURE reposition-goods :
    10111   define input  parameter p-direction   as character no-undo .
    10112   define output parameter p-recid as recid no-undo .
    10113   define buffer buf_goods for ub.goods.
    10114   case p-direction :
    10115     when "first":U
    10116     then do:
    10117       get first br-list.
    10118     end.
    10119     when "last":U
    10120     then do:
    10121       get last br-list.
    10122     end.
    10123     when "prev":U
    10124     then do:
    10125       get prev br-list.
    10126       if not available bb-list then do:
    10127         message
    10128         "Это первый товар списка"
    10129         view-as alert-box.
    10130       end.
    10131     end.
    10132     when "next":U
    10133     then do:
    10134       get next br-list.
    10135       if not available bb-list then do:
    10136         message
    10137         "Это последний товар списка"
    10138         view-as alert-box.
    10139       end.
    10140     end.
    10141   end case .
    10142   find first buf_goods no-lock where
    10143           buf_goods.gds-code = bb-list.gds-code no-error.
    10144   if available bb-list then do:
    10145     assign
    10146     p-recid = recid(buf_goods)
    10147     .
    10148   end.
    10149   run reposition-query in this-procedure
    10150     (input recid(bb-list)
    10151     ).
    10152   END PROCEDURE.
    10153   PROCEDURE reposition-query :
    10154   define input parameter p-recid as recid no-undo .
    10155   if p-recid <> ?
    10156   then do:
    10157     reposition br-list to recid p-recid no-error.
    10158   end.
    10159   do with frame Dialog-Frame:
    10160     apply "entry":u to browse br-list .
    10161     apply "VALUE-CHANGED":u to browse br-list .
    10162   end.
    10163   END PROCEDURE.
    10164   procedure proc-cd :
    10165   define variable v-num as integer no-undo .
    10166   define variable v-action as character no-undo .
    10167   define buffer buf_bb-list for bb-list.
    10168   if p-curr-obj-type <> 'маг':U then return.
    10169   run gbl/d-askw.w (
    10170                     input "Отослать на кассы"
    10171                    ,input "Передача/удаление списка кодов на кассу/с кассы"
    10172                    ,input "|"
    10173                    ,input "Передача|Удаление|Отмена"
    10174                    ,input "Передача на кассу|Удаление с кассы|Отмена"
    10175                    ,input 1
    10176                    ,input 3
    10177                    ,output v-num).
    10178   if v-num = 3 then return.
    10179   v-action = (if v-num = 1 then "U":U else "D").
    10180   define variable v-chk-act-host-code as integer   no-undo .
    10181   define variable v-ok as logical no-undo .
    10182   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10184     (input  'маг':U
    10185     ,input  abs(p-curr-obj-code)
    10186     ,output v-chk-act-host-code
    10187     )  .
    10188   if v-action = "U" then do:
    10189   define variable vss-include-info75 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10190   do:
    10191     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10192       (input  v-cntxt-db-num
    10193       ,input  v-cntxt-userid
    10194       ,input  0
    10195       ,input  'actn_cashdesk-goods_add-def':U
    10196       ,input  'object':U
    10197       ,input  v-chk-act-host-code
    10198       ,input  'маг':U
    10199       ,input  abs(p-curr-obj-code)
    10200       ,input  0
    10201       ,input  0
    10202       ,input  0
    10203       ,input  true
    10204       ,output v-ok
    10205       )  .
    10206   end.
    10207   end.
    10208   else do:
    10209   define variable vss-include-info76 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10210   do:
    10211     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10212       (input  v-cntxt-db-num
    10213       ,input  v-cntxt-userid
    10214       ,input  0
    10215       ,input  'actn_cashdesk-goods_deletion':U
    10216       ,input  'object':U
    10217       ,input  v-chk-act-host-code
    10218       ,input  'маг':U
    10219       ,input  abs(p-curr-obj-code)
    10220       ,input  0
    10221       ,input  0
    10222       ,input  0
    10223       ,input  true
    10224       ,output v-ok
    10225       )  .
    10226   end.
    10227   end.
    10228   if NOT v-ok then return .
    10229   for each bc-list:
    10230     delete bc-list.
    10231   end.
    10232   for each pbc-list:
    10233     delete pbc-list.
    10234   end.
    10235   for each buf_bb-list:
    10236     if buf_bb-list.b-str <> ""
    10237     and buf_bb-list.loc-ean = no
    10238     then do:
    10239       create pbc-list.
    10240       buffer-copy buf_bb-list to pbc-list.
    10241       if v-action = "D" then do:
    10242         assign
    10243         pbc-list.del = yes.
    10244       end.
    10245       release pbc-list.
    10246     end.
    10247     else do:
    10248       find first bc-list where
    10249                 bc-list.b-code = buf_bb-list.b-code no-error.
    10250       if not available bc-list then do:
    10251       create bc-list.
    10252       buffer-copy buf_bb-list to bc-list.
    10253         if v-action = "D" then do:
    10254           assign
    10255           bc-list.del = yes.
    10256         end.
    10257       release bc-list.
    10258       end.
    10259     end.
    10260   end.
    10261   if can-find(first bc-list no-lock) then do:
    10262       run str/diallog.w ( input parparentproc
    10263                     , input this-procedure
    10264                     , input 'str/send-bcn.p':U
    10265                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10266                     , input (if can-find(first pbc-list no-lock)
    10267                              then yes
    10268                              else no)
    10269                     , input 'Прервать'
    10270                     , input (if v-action = "U"
    10271                              then 'Отсылка бар-кодов на кассу'
    10272                              else 'Удаление бар-кодов c кассы'
    10273                              )) no-error .
    10274   end.
    10275   if can-find(first pbc-list no-lock) then do:
    10276       run str/diallog.w ( input parparentproc
    10277                     , input this-procedure
    10278                     , input 'str/s-prdbcn.p':U
    10279                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10280                     , input no
    10281                     , input 'Прервать'
    10282                     , input (if v-action = "U"
    10283                              then 'Отсылка ДопБК на кассу'
    10284                              else 'Удаление ДопБК с кассы'
    10285                              )) no-error .
    10286   end.
    10287   end procedure.
    10288   PROCEDURE proc-parts-cashparts :
    10289   define input parameter rs-list-method as character no-undo .
    10290   define variable v-value-integer as integer   no-undo .
    10291   define variable glog as logical no-undo .
    10292   define variable v-message as character no-undo .
    10293   define variable v-item as character no-undo .
    10294   assign
    10295   frame Dialog-Frame
    10296   t-parts-not-blank
    10297   t-parts-all
