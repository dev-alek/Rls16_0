     3710             ) no-error.
     3711           if error-status:error then return error.
     3712         END.
     3713       end.
     3714       end.
     3715     END.
     3716   end.
     3717             END.
     3718           END.
     3719         END.
     3720       end.
     3721     end.
     3722     end.
     3723   END PROCEDURE .
     3724   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3725   procedure asc-gds :
     3726   define input parameter rs-list-method as character no-undo .
     3727   define input parameter rs-status as character no-undo .
     3728   define input parameter line-mode as character no-undo .
     3729   DEFINE parameter buffer loc-goods for ub.goods.
     3730   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     3731   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     3732   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     3733   DEFINE parameter buffer loc-price-list for ub.price-list.
     3734   DEFINE parameter buffer loc-units for ub.units.
     3735   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     3736   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     3737   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     3738   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     3739   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     3740   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     3741   define input parameter parobj-type like ub.clients.obj-type no-undo .
     3742   define input parameter parobj-code like ub.clients.obj-code no-undo .
     3743   define variable IBM-good-code as character no-undo .
     3744   define variable bar_code as character no-undo .
     3745   define buffer buf_prod-bc for ub.prod-bc.
     3746     do
     3747     on error undo, return error
     3748     :
     3749       if loc-prod-bc <> "":U and loc-prod-bc <> ? then do:
     3750         find first buf_prod-bc no-lock where
     3751                   buf_prod-bc.b-code = loc-bar-code.b-code
     3752              and  buf_prod-bc.b-str = loc-prod-bc no-error.
     3753         run ex-bbc in this-procedure ( input rs-list-method
     3754                                       ,input rs-status
     3755                                       ,input line-mode
     3756                                       ,input l-empty-scale
     3757                                       ,input loc-prod-bc
     3758                                       ,input no
     3759                                       ,buffer loc-bar-code
     3760                                       ,buffer buf_prod-bc).
     3761       end.
     3762       else do:
     3763         if  (LOOKUP( 'вес':U, loc-units.type ) = 0 or v-notcd)
     3764         or loc-goods.unit-base <> loc-bar-code.unit-cli then do:
     3765           if (temp-shop.cd-loc-base and loc-bar-code.unit-cli = loc-goods.unit-base)
     3766           or (temp-shop.cd-loc-alt  and loc-bar-code.unit-cli <> loc-goods.unit-base)
     3767           then
     3768           run ex-bbc in this-procedure ( input rs-list-method
     3769                                         ,input rs-status
     3770                                         ,input line-mode
     3771                                         ,input l-empty-scale
     3772                                         ,input "":U
     3773                                         ,input no
     3774                                         ,buffer loc-bar-code
     3775                                         ,buffer buf_prod-bc).
     3776           if temp-shop.cd-bc-base
     3777           and loc-bar-code.unit-cli = loc-goods.unit-base then do:
     3778             RUN gen-bc( input loc-bar-code.b-code, output bar_code ).
     3779             IBM-good-code  = trim( bar_code ) .
     3780             run ex-bbc in this-procedure ( input rs-list-method
     3781                                           ,input rs-status
     3782                                           ,input line-mode
     3783                                           ,input l-empty-scale
     3784                                           ,input IBM-good-code
     3785                                           ,input yes
     3786                                           ,buffer loc-bar-code
     3787                                           ,buffer buf_prod-bc).
     3788           end.
     3789           if temp-shop.cd-bc-alt
     3790           and loc-bar-code.unit-cli <> loc-goods.unit-base
     3791           then  do:
     3792             RUN gen-bc( input loc-bar-code.b-code, output bar_code ).
     3793             IBM-good-code  = trim( bar_code ) .
     3794             run ex-bbc in this-procedure ( input rs-list-method
     3795                                           ,input rs-status
     3796                                           ,input line-mode
     3797                                           ,input l-empty-scale
     3798                                           ,input IBM-good-code
     3799                                           ,input yes
     3800                                           ,buffer loc-bar-code
     3801                                           ,buffer buf_prod-bc).
     3802           end.
     3803         end.
     3804       end.
     3805     end.
     3806   end procedure.
     3807   DEFINE FRAME Dialog-Frame
     3808       dsp-rs  AT ROW 1 COL 1 NO-LABEL
     3809       b-exit  AT ROW 2 COL 1
     3810       b-save  AT ROW 2 COL 11
     3811       b-print AT ROW 2 COL 21
     3812       b-hist  AT ROW 2 COL 31
     3813       b-lkp   AT ROW 2 COL 41
     3814       b-clr   AT ROW 2 COL 51
     3815       b-help  AT ROW 2 COL 61
     3816       b-cd    AT ROW 2 COL 81
     3817       b-add   AT ROW 3 COL 19
     3818       b-del   AT ROW 3 COL 33
     3819       b-rest  AT ROW 3 COL 47
     3820       v-obj-type at row 4 col 2 No-LABEL
     3821       v-obj-code at row 4 col 6 No-LABEL
     3822       b-obj at row 4 col 12
     3823       v-obj-name at row 4 col 15 No-LABEL
     3824       loc-art  AT ROW 4 COL 27 COLON-ALIGNED label "Начало артикула"
     3825       loc-name AT ROW 4 COL 27 COLON-ALIGNED label "Начало названия" format "x(40)"
     3826       loc-code AT ROW 4 COL 27 COLON-ALIGNED label "Бар-код (весь)" format "x(13)"
     3827       loc-b-str AT ROW 4 COL 27 COLON-ALIGNED label "ДопБК" format "x(13)"
     3828       a-n-c    at row 3 col 1 no-label
     3829       T-loc-base AT ROW 3  COL 61
     3830       T-pb-base  AT ROW 3  COL 80
     3831       T-loc-alt  AT ROW 3.75 COL 61
     3832       T-pb-alt   AT ROW 3.75 COL 80
     3833       T-bc-base  AT ROW 4.5  COL 61
     3834       T-sc-base  AT ROW 4.5  COL 80
     3835       T-bc-alt   AT ROW 5.25  COL 61
     3836       T-all-prt  AT ROW 5.25  COL 80
     3837       T-parts-ser AT ROW 6 COL 80
     3838       T-parts-not-blank AT ROW 6.75 COL 80
     3839       T-parts-all AT ROW 7.5 COL 80
     3840       RS-status at row 5 col 2 no-label
     3841       b-macro AT ROW 4.7 col 44
     3842       b-record AT ROW 4.7 col 47
     3843       b-stop   AT ROW 4.7 col 47
     3844       b-clear-macro AT ROW 4.7 col 47
     3845       b-optimize AT ROW 5 COL 34
     3846       f-tot-lns AT ROW 5 col 52 no-label
     3847       br-list  AT ROW 6 COL 1
     3848       br-option AT ROW 8.5 COL 70
     3849       ub.clients.obj-name  at row 22 col 6 colon-aligned label "Пр-ль" fgcolor 4
     3850       ub.gds-prt.node-name at row 22 col 45 colon-aligned label "Шкала" fgcolor 4
     3851       ub.bar-code.b-code   at row 22 col 67 colon-aligned label "Код" format "9999999999" fgcolor 4
     3852       SPACE(0) SKIP(0)
     3853       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3854           SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     3855           TITLE "СПИСОК  КОДОВ":L
     3856           DEFAULT-BUTTON b-exit.
     3857   ASSIGN
     3858     b-save:POPUP-MENU IN FRAME Dialog-Frame = MENU m-save:HANDLE
     3859     FRAME Dialog-Frame:SCROLLABLE = FALSE
     3860     b-save:MENU-MOUSE = 1
     3861     b-optimize:POPUP-MENU IN FRAME Dialog-Frame = MENU m-optimize:HANDLE
     3862     b-optimize:MENU-MOUSE = 1
     3863     .
     3864   on
     3865     return of
     3866     br-list in frame Dialog-Frame do:
     3867     apply "choose" to b-lkp in frame Dialog-Frame.
     3868     return no-apply.
     3869   end.
     3870   on choose of b-obj in frame Dialog-Frame do:
     3871     run proc-b-obj in this-procedure ( input "change":U ).
     3872   end.
     3873   ON CHOOSE OF MENU-ITEM m-cd  DO:
     3874   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3875   if lookup(b-save :type in frame Dialog-Frame
     3876            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3877            ) = 0
     3878   then do:
     3879     message
     3880       "$Workfile$"
     3881       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3882       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3883       "Тип" self :type in frame Dialog-Frame skip
     3884       "Процедура" this-procedure :file-name skip
     3885       view-as alert-box .
     3886   end.
     3887   else do:
     3888     apply "entry":u to b-save in frame Dialog-Frame .
     3889     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3890       return no-apply .
     3891     end.
     3892   end.
     3893   run proc-cd in this-procedure no-error.
     3894   end.
     3895   ON CHOOSE OF MENU-ITEM m-title-save  DO:
     3896   define variable v-value as character no-undo .
     3897     run gbl/d-prompt.w (
     3898         'title=':u + "Введите ИМЯ СПИСКА КОДОВ" + '\':u
     3899       + 'format=' + "X(60)" + '\':u
     3900       + 'type=' + 'C':U + '\':u
     3901       + 'fillin_row=2\':u
     3902       + 'fillin_col=4\':u
     3903       + 'fillin_width=60\':u
     3904       + 'fillin_height=1\':u
     3905       + 'max-chars=60\':u
     3906       + 'readonly=no\':u
     3907       , input-output v-value
     3908       ).
     3909   if return-value = 'false':u then return NO-apply.
     3910   run create-bb-list-hist in this-procedure (input 'title'
     3911                                        , input-output v-seq
     3912                                        , input 0
     3913                                        , input 'N':U
     3914                                        , input v-value
     3915                                        , input tot-lns
     3916                                        , input "title"
     3917                                        , input '':U
     3918                                        , input '':U
     3919                                        , input '':U
     3920                                        , input ?
     3921                                        ).
     3922   assign
     3923   frame Dialog-Frame:title = substitute("СПИСОК  КОДОВ &1", v-value).
     3924   END.
     3925   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3926   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
