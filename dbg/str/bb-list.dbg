      241   def new shared var bc-frmt as character no-undo .
      242   def new shared var bc-pfx  as character no-undo .
      243   def var bc-par-type as character no-undo .
      244       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      245       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      246           do:
      247               message "Не задан или не верно задан ТИП собственного бар-кода!"
      248                   view-as alert-box ERROR TITLE "".
      249               return error.
      250           end.
      251       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      252       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      253           do:
      254               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      255                   view-as alert-box ERROR TITLE "".
      256               return error.
      257           end.
      258   PROCEDURE gen-bc:
      259     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      260     def output parameter full-b-code     as character init ""    no-undo .
      261   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262     define variable tmp-str4  as character no-undo.
      263     define variable tmp-num4  as character no-undo.
      264     define variable i4        as integer   no-undo.
      265     define variable sum4      as integer   no-undo.
      266     define variable len-code4 as integer   no-undo.
      267     define variable varcont4  as logical   initial yes no-undo.
      268     CASE bc-frmt :
      269       WHEN "EAN13" THEN do:
      270         assign
      271           tmp-str4 = string( internal-b-code, "999999999999" )
      272         .
      273       end.
      274       WHEN "EAN8" THEN do:
      275         assign
      276           tmp-str4 = string( internal-b-code, "9999999" )
      277         .
      278       end.
      279       OTHERWISE DO:
      280           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      281           view-as alert-box error.
      282           return error.
      283       END.
      284     END CASE.
      285     if varcont4 = yes then do:
      286       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      287       then do:
      288         message
      289           "Невозможно сформировать бар-код" SKIP
      290           "для товара с кодом: " internal-b-code
      291           view-as alert-box error title "подрезание кода".
      292         return error.
      293       end.
      294       else do:
      295         assign
      296           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      297           len-code4    = length( full-b-code )
      298         .
      299         define variable v-sum-char4 as character no-undo .
      300         assign
      301           sum4 = 0
      302         .
      303         do i4 = 1 to len-code4 by 2
      304         :
      305           assign
      306             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      307           .
      308           if v-sum-char4 < "0"
      309           or v-sum-char4 > "9"
      310           then do:
      311             message
      312               "Невозможно сформировать бар-код" skip
      313               "для товара с кодом: " internal-b-code skip
      314               view-as alert-box error title "подсчет контрольной суммы".
      315             return error.
      316           end.
      317           assign
      318             sum4 = sum4 + integer(v-sum-char4)
      319           .
      320         end.
      321         if varcont4 = yes then do:
      322           assign
      323             sum4 = sum4 * 3
      324           .
      325           do i4 = 2 to len-code4 by 2
      326           :
      327             assign
      328               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      329             .
      330             if v-sum-char4 < "0"
      331             or v-sum-char4 > "9"
      332             then do:
      333               message
      334                 "Невозможно сформировать бар-код" skip
      335                 "для товара с кодом: " internal-b-code skip
      336                 view-as alert-box error title "подсчет контрольной суммы".
      337               return error.
      338             end.
      339             assign
      340               sum4 = sum4 + integer(v-sum-char4)
      341             .
      342           end.
      343           if varcont4 = yes then do:
      344              if sum4 mod 10 = 0 then do:
      345                assign
      346                  full-b-code = full-b-code + '0'
      347                .
      348              end.
      349              else do:
      350                assign
      351                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      352                .
      353              end.
      354           end.
      355         end.
      356       end.
      357     end.
      358   END PROCEDURE.
      359   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   procedure gen-key-rec :
      362     define input  parameter p-tbl-name    as character no-undo.
      363     define input  parameter p-bh_tbl-name as handle    no-undo.
      364     define output parameter p-key-rec     as character no-undo.
      365     do
      366     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      367     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      369     :
      370       define variable fh               as handle    no-undo .
      371       define variable v-ok             as logical   no-undo .
      372       define variable v-inform         as character no-undo .
      373       define variable v-ind            as integer   no-undo .
      374       define variable v-idx-field-qnty as integer   no-undo .
      375       if p-tbl-name = ?
      376         or p-tbl-name = "":U
      377       then do:
      378         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      379       end.
      380       if not p-bh_tbl-name:available then do:
      381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      382       end.
      383       assign
      384         p-key-rec = p-tbl-name
      385         v-inform  = p-bh_tbl-name:index-information(1)
      386         v-ind     = 2
      387       .
      388       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      389       on error undo, return error
      390       :
      391         assign
      392           v-inform = p-bh_tbl-name:index-information( v-ind )
      393           v-ind    = v-ind + 1
      394         .
      395       end.
      396       if v-inform = ?
      397         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      398         or entry( 3, v-inform, ",":U ) <> "1":U
      399       then do:
      400         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      401       end.
      402       else do:
      403         assign
      404           v-idx-field-qnty = num-entries( v-inform ) - 4
      405         .
      406         if v-idx-field-qnty < 2 then do:
      407           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      408         end.
      409         do v-ind = 1 to v-idx-field-qnty by 2
      410         on error undo, return error
      411         :
      412           assign
      413             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      414             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      415           .
      416         end.
      417       end.
      418       if p-key-rec = ? then do:
      419         assign
      420           p-key-rec = "":U
      421         .
      422         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      423       end.
      424     end.
      425     return.
      426   end procedure.
      427   procedure gen-where-keyr-tab :
      428     define input  parameter i-tableSerach as character no-undo.
      429     define input  parameter i-tablekey   as character  no-undo.
      430     define input  parameter p-key-rec    as character  no-undo.
      431     define input  parameter p-key-handle as handle     no-undo .
      432     define input  parameter p-db-name    as character  no-undo .
      433     define input  parameter p-tt-handle  as handle     no-undo .
      434     define output parameter o-Where      as character  no-undo.
      435     do
      436     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      437     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      438     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      439     :
      440       define variable v-full-tbl-name  as character no-undo .
      441       define variable bh_tbl-name      as handle    no-undo .
      442       define variable fh_key           as handle    no-undo .
      443       define variable fh_search        as handle    no-undo .
      444       define variable v-field-num      as integer   no-undo .
      445       define variable v-count-fld      as integer   no-undo .
      446       define variable v-inform         as character no-undo .
      447       define variable v-ind            as integer   no-undo .
      448       define variable v-idx-field-qnty as integer   no-undo .
      449       define variable v-field-name     as character no-undo .
      450       define variable v-field-val      as character no-undo .
      451       define variable v-word-link      as character no-undo .
      452       define variable vTable           as character no-undo.
      453       define variable bh_tbl-key       as handle    no-undo .
      454       assign
      455         p-key-rec = trim( p-key-rec )
      456       .
      457       if p-key-handle <> ? then do:
      458         if not valid-handle(p-key-handle)
      459            or p-key-handle:type <> "buffer"
      460         then do:
      461           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      462         end.
      463         if num-entries( p-key-rec, chr(3) ) > 1
      464           or p-key-rec = ?
      465           or p-key-rec = "":U
      466         then do:
      467           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      468         end.
      469       end.
      470       else do:
      471         if p-key-rec = ?
      472           or p-key-rec = "":U
      473         then do:
      474           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      475         end.
      476       end.
      477       assign
      478         vTable = entry( 1 , p-key-rec, chr(3) )
      479       .
      480       if p-tt-handle <> ?
      481         and ( not valid-handle(p-tt-handle)
      482               or p-tt-handle:type <> "buffer"
      483             )
      484       then do:
      485         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      486       end.
      487       if p-tt-handle = ? then do:
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      490         .
      491         create buffer bh_tbl-name for table v-full-tbl-name .
      492       end.
      493       else do:
      494         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      495       end.
      496       assign
      497         v-inform = bh_tbl-name:index-information(1)
      498         v-ind    = 2
      499       .
      500       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      501       on error undo, return error
      502       :
      503         assign
      504           v-inform = bh_tbl-name:index-information( v-ind )
      505           v-ind    = v-ind + 1
      506         .
      507       end.
      508       if v-inform = ?
      509         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      510         or entry( 3, v-inform, ",":U ) <> "1":U
      511       then do:
      512         delete object bh_tbl-name no-error.
      513         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      514       end.
      515       assign
      516         v-idx-field-qnty = num-entries( v-inform ) - 4
      517       .
      518       if v-idx-field-qnty < 2 then do:
      519         delete object bh_tbl-name no-error.
      520         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      521       end.
      522       assign
      523         o-where     = "where":U
      524         v-word-link = "":U
      525         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      526         v-count-fld = 0
      527       .
      528       if i-tablekey ne "" and i-tablekey ne ?
      529       then do:
      530         assign
      531           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      532         .
      533         create buffer bh_tbl-key for table v-full-tbl-name .
      534       end.
      535       if i-tableSerach ne "" and i-tableSerach ne ?
      536       then do:
      537         delete object bh_tbl-name no-error.
      538         assign
      539           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      540         .
      541         create buffer bh_tbl-name for table v-full-tbl-name .
      542       end.
      543       block_where:
      544       do v-ind = 1 to v-idx-field-qnty by 2
      545       on error undo, return error
      546       :
      547         assign
      548           v-count-fld = v-count-fld + 1
      549         .
      550         if p-key-handle = ?
      551           and v-count-fld > v-field-num
      552         then do:
      553           leave block_where.
      554         end.
      555         define variable VfieldKeyTable as handle no-undo.
      556         assign
      557           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      558           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      559         .
      560         if     bh_tbl-key ne ?
      561         then do:
      562            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      563            if VfieldKeyTable eq ?
      564            then next block_where.
      565         end.
      566         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      567         then
      568            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      569         else
      570            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      571         if p-key-handle = ? then do:
      572           assign
      573             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      574           .
      575         end.
      576         else do:
      577           assign
      578             fh_key = p-key-handle:buffer-field( v-field-name )
      579           .
      580           if fh_key = ?
      581             or not valid-handle( fh_key )
      582           then do:
      583             delete object bh_tbl-name.
      584             if     bh_tbl-key ne ?
      585             then
      586                delete object bh_tbl-key.
      587             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      588           end.
      589           assign
      590             v-field-val = fh_key:buffer-value
      591           .
      592         end.
      593         if fh_search:data-type ="character":U then do:
      594           assign
      595             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      596             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      597             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      598             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      599             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      600             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      601             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      602             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      603             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      604             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      605             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      606             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      607             v-field-val = substitute( '"&1"', v-field-val )
      608           .
      609         end.
      610         assign
      611           o-where = substitute( "&1 &2", o-where, v-field-val )
      612         .
      613         if v-word-link = "":U then do:
      614           assign
      615             v-word-link = "and":U
      616           .
      617         end.
      618       end.
      619       delete object bh_tbl-name.
      620       if     bh_tbl-key ne ?
      621       then
      622          delete object bh_tbl-key.
      623       if p-key-handle = ?
      624         and v-count-fld <> v-field-num
      625       then do:
      626         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      627       end.
      628     end.
      629   end procedure.
      630   procedure gen-hn-keyr-tab :
      631     define input  parameter i-tableSerach as character no-undo.
      632     define input  parameter i-tablekey   as character no-undo.
      633     define input  parameter p-key-rec    as character no-undo.
      634     define input  parameter p-key-handle as handle    no-undo .
      635     define input  parameter p-db-name    as character no-undo .
      636     define input  parameter p-tt-handle  as handle    no-undo .
      637     define input  parameter p-stts-lock  as integer   no-undo .
      638     define output parameter o-hn         as handle    no-undo.
      639     define variable v-full-tbl-name as character no-undo.
      640     define variable v-where         as character no-undo.
      641     define variable bh_tbl-name     as handle    no-undo.
      642     define variable vTable          as character no-undo.
      643     do
      644     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      645     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      646     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      647         run gen-where-keyr-tab(i-tableSerach,
      648                                i-tablekey,
      649                                p-key-rec,
      650                                p-key-handle,
      651                                p-db-name,
      652                                p-tt-handle,
      653                                output v-where).
      654         if i-tableSerach ne "" and i-tableSerach ne ?
      655         then do:
      656            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      657            create buffer bh_tbl-name for table v-full-tbl-name .
      658         end.
      659         else do:
      660            if p-tt-handle = ? then do:
      661               assign
      662                  vTable = entry( 1 , p-key-rec, chr(3) )
      663               .
      664               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      665               create buffer bh_tbl-name for table v-full-tbl-name .
      666            end.
      667            else do:
      668               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      669            end.
      670         end.
      671         if p-tt-handle = ? then do:
      672            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      673         end.
      674         else do:
      675            bh_tbl-name:find-first( v-where ) no-error .
      676         end.
      677         o-hn = bh_tbl-name.
      678      end.
      679   end procedure.
      680   procedure gen-hn-keyr :
      681     define input  parameter p-key-rec    as character no-undo.
      682     define input  parameter p-key-handle as handle    no-undo .
      683     define input  parameter p-db-name    as character no-undo .
      684     define input  parameter p-tt-handle  as handle    no-undo .
      685     define input  parameter p-stts-lock  as integer   no-undo .
      686     define output parameter o-hn         as handle    no-undo.
      687     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      688   end.
      689   procedure gen-row-keyr :
      690     define input  parameter p-key-rec    as character no-undo.
      691     define input  parameter p-key-handle as handle    no-undo .
      692     define input  parameter p-db-name    as character no-undo .
      693     define input  parameter p-tt-handle  as handle    no-undo .
      694     define input  parameter p-stts-lock  as integer   no-undo .
      695     define output parameter p-tbl-row    as rowid     no-undo.
      696     define output parameter p-tbl-name   as character no-undo.
      697     define variable vHn as handle no-undo.
      698       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      699       p-tbl-row = if vHn:available then vHn:rowid else ?.
      700       p-tbl-name =  vHn:table.
      701       delete object vHn no-error.
      702     if p-tbl-row = ? then do:
      703       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      704     end.
      705     else do:
      706       return.
      707     end.
      708   end procedure.
      709   procedure gen-key-fv :
      710     define input  parameter p-key-rec    as character no-undo .
      711     define output parameter p-field-list as character no-undo .
      712     define output parameter p-value-list as character no-undo.
      713     do
      714     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      715     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      716     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      717     :
      718       define variable v-full-tbl-name  as character no-undo .
      719       define variable bh_tbl-name      as handle    no-undo .
      720       define variable v-tbl-name       as character no-undo .
      721       define variable v-field-num      as integer   no-undo .
      722       define variable v-count-fld      as integer   no-undo .
      723       define variable v-inform         as character no-undo .
      724       define variable v-ind            as integer   no-undo .
      725       define variable v-idx-field-qnty as integer   no-undo .
      726       define variable v-delim-key      as character no-undo .
      727       if p-key-rec = ?
      728         or p-key-rec = "":U
      729       then do:
      730         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      731       end.
      732       assign
      733         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      734         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      735       .
      736       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      737       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      738       assign
      739         v-inform = bh_tbl-name:index-information(1)
      740         v-ind    = 2
      741       .
      742       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      743       on error undo, return error
      744       :
      745         assign
      746           v-inform = bh_tbl-name:index-information( v-ind )
      747           v-ind    = v-ind + 1
      748         .
      749       end.
      750       if v-inform = ?
      751         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      752         or entry( 3, v-inform, ",":U ) <> "1":U
      753       then do:
      754         delete object bh_tbl-name no-error.
      755         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      756       end.
      757       assign
      758         v-idx-field-qnty = num-entries( v-inform ) - 4
      759       .
      760       if v-idx-field-qnty < 2 then do:
      761         delete object bh_tbl-name no-error.
      762         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      763       end.
      764       assign
      765         p-field-list = "":U
      766         p-value-list = "":U
      767         v-delim-key  = "":U
      768         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      769         v-count-fld  = 0
      770       .
      771       block_where:
      772       do v-ind = 1 to v-idx-field-qnty by 2
      773       on error undo, return error
      774       :
      775         assign
      776           v-count-fld = v-count-fld + 1
      777         .
      778         if v-count-fld > v-field-num then do:
      779           leave block_where.
      780         end.
      781         assign
      782           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      783           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      784         .
      785         if v-ind = 1 then do:
      786           assign
      787             v-delim-key = chr(3)
      788           .
      789         end.
      790       end.
      791       delete object bh_tbl-name.
      792       if v-count-fld <> v-field-num then do:
      793         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      794       end.
      795     end.
      796   end procedure.
      797   procedure gen-key-field :
      798     define input  parameter p-table      as character no-undo .
      799     define output parameter p-field-list as character no-undo .
      800     do
      801     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      802     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      803     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      804     :
      805       define variable v-full-tbl-name  as character no-undo .
      806       define variable bh_tbl-name      as handle    no-undo .
      807       define variable v-tbl-name       as character no-undo .
      808       define variable v-field-num      as integer   no-undo .
      809       define variable v-count-fld      as integer   no-undo .
      810       define variable v-inform         as character no-undo .
      811       define variable v-ind            as integer   no-undo .
      812       define variable v-idx-field-qnty as integer   no-undo .
      813       define variable v-delim-key      as character no-undo .
      814       if p-table = ?
      815         or p-table = "":U
      816       then do:
      817         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      818       end.
      819       assign
      820         v-tbl-name      = p-table
      821         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      822       .
      823       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      824       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      825       assign
      826         v-inform = bh_tbl-name:index-information(1)
      827         v-ind    = 2
      828       .
      829       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      830       on error undo, return error
      831       :
      832         assign
      833           v-inform = bh_tbl-name:index-information( v-ind )
      834           v-ind    = v-ind + 1
      835         .
      836       end.
      837       if v-inform = ?
      838         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      839         or entry( 3, v-inform, ",":U ) <> "1":U
      840       then do:
      841         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      842       end.
      843       assign
      844         v-idx-field-qnty = num-entries( v-inform ) - 4
      845       .
      846       if v-idx-field-qnty < 2 then do:
      847         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      848       end.
      849       assign
      850         p-field-list = "":U
      851         v-delim-key  = "":U
      852         v-count-fld  = 0
      853       .
      854       block_where:
      855       do v-ind = 1 to v-idx-field-qnty by 2
      856       on error undo, return error
      857       :
      858         assign
      859           v-count-fld = v-count-fld + 1
      860         .
      861         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      862         if v-ind = 1 then do:
      863           assign
      864             v-delim-key = chr(3)
      865           .
      866         end.
      867       end.
      868       delete object bh_tbl-name.
      869     end.
      870   end procedure.
      871   procedure create-bb-list-hist :
      872   define input parameter p-mode as character no-undo .
      873   define input-output parameter p-seq as integer no-undo .
      874   define input parameter p-line as integer no-undo .
      875   define variable p-list-table as character no-undo .
      876   define input parameter p-hist-mode as character no-undo .
      877   define input parameter p-des as character no-undo .
      878   define input parameter p-num-recs as integer no-undo .
      879   define input parameter p-option as character no-undo .
      880   define input parameter p-status_ as character no-undo .
      881   define input parameter p-item as character no-undo .
      882   define input parameter p-tbl-name as character no-undo .
      883   define input parameter p-bh_tbl-name as handle no-undo .
      884   define variable v-num-add as integer no-undo .
      885   define variable v-num-ignored as integer no-undo .
      886   define buffer buf_bb-list-hist for bb-list-hist.
      887     do
      888     on error undo, return error
      889     :
      890       CASE p-mode:
      891         when 'title' then do:
      892           find first buf_bb-list-hist where
      893                      buf_bb-list-hist.id = 0   no-error.
      894           if not available buf_bb-list-hist then do:
      895             create buf_bb-list-hist.
      896             assign
      897             buf_bb-list-hist.id = 0
      898             buf_bb-list-hist.line = 0
      899             buf_bb-list-hist.list-table = '':U
      900             .
      901           end.
      902           assign
      903           buf_bb-list-hist.des =  p-des
      904           buf_bb-list-hist.num-recs = p-num-recs
      905           buf_bb-list-hist.option_  = p-option
      906           buf_bb-list-hist.item_ = p-item
      907           .
      908         end.
      909         when 'ДОБАВЛЕНИЕ':U then do:
      910           if p-option begins 'single' then do:
      911             CASE p-hist-mode:
      912               when '+':U then do:
      913                 assign
      914                 v-num-add = 1
      915                 v-num-ignored  = 0
      916                 .
      917               end.
      918               when '-':U then do:
      919                 assign
      920                 v-num-add = 1
      921                 v-num-ignored  = 0
      922                 .
      923               end.
      924               when '*':U then do:
      925                 assign
      926                 v-num-add = p-num-recs - 1
      927                 p-num-recs = 1
      928                 v-num-ignored  = 0
      929                 .
      930               end.
      931             END CASE.
      932           end.
      933           create buf_bb-list-hist.
      934           assign
      935           buf_bb-list-hist.id = p-seq
      936           buf_bb-list-hist.list-table = p-list-table
      937            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      938           buf_bb-list-hist.des =  p-des
      939           buf_bb-list-hist.line = p-line
      940           buf_bb-list-hist.num-recs = p-num-recs
      941           buf_bb-list-hist.option_  = p-option
      942           buf_bb-list-hist.item_ = p-item
      943           buf_bb-list-hist.hist-mode =  p-hist-mode
      944           buf_bb-list-hist.status_ =  p-status_
      945           buf_bb-list-hist.num-add = v-num-add
      946           buf_bb-list-hist.num-ignored = v-num-ignored
      947           .
      948         end.
      949         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      950           find first buf_bb-list-hist where
      951                     buf_bb-list-hist.id = p-seq
      952                 and buf_bb-list-hist.line = p-line no-error .
      953           if  available buf_bb-list-hist then do:
      954             assign
      955             buf_bb-list-hist.des =  p-des
      956             buf_bb-list-hist.num-recs = p-num-recs
      957             buf_bb-list-hist.option_  = p-option
      958             buf_bb-list-hist.item_ = p-item
      959             buf_bb-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      960                                        then p-list-table
      961                                        else buf_bb-list-hist.list-table)
      962             .
      963           end.
      964         end.
      965         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      966           find first buf_bb-list-hist where
      967                     buf_bb-list-hist.id = p-seq
      968                 and buf_bb-list-hist.line = p-line  no-error .
      969           if available buf_bb-list-hist then do:
      970             assign
      971             buf_bb-list-hist.hist-mode =  p-hist-mode
      972             buf_bb-list-hist.num-recs  = (if buf_bb-list-hist.line = 0 then p-num-recs else buf_bb-list-hist.num-recs)
      973             buf_bb-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      974                                        then p-list-table
      975                                        else buf_bb-list-hist.list-table)
      976             .
      977           end.
      978         end.
      979       END CASE.
      980       if p-tbl-name <> "":U
      981       and valid-handle(p-bh_tbl-name)
      982       then do:
      983         run gen-key-rec  in this-procedure (
      984                                               input  p-tbl-name
      985                                              ,input  p-bh_tbl-name
      986                                              ,output p-item) no-error .
      987         if not error-status:error then do:
      988           assign
      989           buf_bb-list-hist.item_ = p-item
      990           .
      991         end.
      992         else do:
      993           assign
      994           buf_bb-list-hist.item_ = "!ERROR"
      995           .
      996         end.
      997       end.
      998     end.
      999   end procedure.
     1000   FUNCTION get-line-mode returns character(input p-hist-mode as character):
     1001   case p-hist-mode:
     1002     when '+':U then
     1003       return  'ДОБАВЛЕНИЕ':U.
     1004     when '-':U then
     1005       return  'удаление':U.
     1006     when '*':U then
     1007       return  'ОСТАВИТЬ':U.
     1008   end CASE.
     1009   END FUNCTION.
     1010   FUNCTION get-hist-mode returns character(input p-line-mode as character):
     1011   case p-line-mode:
     1012     when 'ДОБАВЛЕНИЕ':U then
     1013       return  "+".
     1014     when 'удаление':U then
     1015       return  "-".
     1016     when 'ОСТАВИТЬ':U then
     1017       return  "*".
     1018   end CASE.
     1019   END FUNCTION.
     1020   procedure proc-write-filter-expression :
     1021   define input parameter p-filter-expression as character no-undo .
     1022   define variable v-ii as integer no-undo .
     1023   output to value(string(g#report-num) + ".whr").
     1024   put .
     1025   if num-entries(p-filter-expression) > 0 then do:
     1026      put unformatted 'and ('.
     1027      do v-ii = 1 to num-entries(p-filter-expression):
     1028        put unformatted entry(v-ii, p-filter-expression) skip.
     1029      end.
     1030      put unformatted ')'.
     1031   end.
     1032   output close.
     1033   end procedure.
     1034   procedure proc-write-filter-expression-var :
     1035   define input parameter p-filter-expression as character no-undo .
     1036   define output parameter p-string as character no-undo .
     1037   define variable v-ii as integer no-undo .
     1038   if num-entries(p-filter-expression) > 0 then do:
     1039      p-string = 'and ('.
     1040      do v-ii = 1 to num-entries(p-filter-expression):
     1041        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1042      end.
     1043      p-string = p-string + ')'.
     1044   end.
     1045   end procedure.
     1046   define new global shared variable g#libbcrcn as handle no-undo .
     1047   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   define variable v-waitfram-action01         as character   no-undo .
     1049   define variable v-waitfram-action02         as character   no-undo .
     1050   define variable v-waitfram-action03         as character   no-undo .
     1051   define variable mWaitFramTextBeg            as character   no-undo.
     1052   define variable mWaitFramTextEnd            as character   no-undo.
     1053   define variable mWaitFramView               as logical     no-undo.
     1054   define variable mWaitProcEvent              as logical     no-undo init yes.
     1055   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1056   define variable mWaitFramStop               as logical     no-undo.
     1057   define variable mWaitFramStopUser           as logical     no-undo.
     1058   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1059   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1060   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1061   define button B-WaitFramStop auto-end-key
     1062        label "Стоп"
     1063        size 10 by 1 tooltip "Остоновить процесс".
     1064   define button B-viewProcInfo
     1065        label "Информация"
     1066        size 15 by 1 tooltip "Информация о процесс".
     1067   define frame waitfram
     1068     v-waitfram-action01 format "x(72)" no-label skip
     1069     v-waitfram-action02 format "x(72)" no-label skip
     1070     v-waitfram-action03 format "x(72)" no-label skip
     1071     B-viewProcInfo
     1072     B-WaitFramStop at row 4 col 30
     1073     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1074     .
     1075   define new global shared variable mBatchMode as logical no-undo init ?.
     1076   define variable mFramBachModHandle as handle no-undo.
     1077   mFramBachModHandle = frame waitfram:handle.
     1078   define variable mFameOldVis as logical no-undo.
     1079   define variable mVisCUrentVin as logical no-undo.
     1080   if session:batch-mode
     1081   then
     1082      mBatchMode = yes.
     1083   if mBatchMode = ? then do:
     1084     mVisCUrentVin = current-window:visible.
     1085     mFameOldVis = mFramBachModHandle:visible.
     1086     mFramBachModHandle:visible  = yes.
     1087     mBatchMode = mFramBachModHandle:visible ne yes.
     1088     mFramBachModHandle:visible = mFameOldVis.
     1089     current-window:visible = mVisCUrentVin.
     1090   end.
     1091    if  log-manager:logfile-name ne ?
     1092     then DO:
     1093         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1094         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1095         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1096     end.
     1097   on choose of B-WaitFramStop in frame waitfram
     1098   do:
     1099     mWaitFramStop = yes.
     1100     mWaitFramStopUser = yes.
     1101   end.
     1102   function waitfram-check-timeout returns logical():
     1103      define variable vtime as int64 no-undo.
     1104      if mWaitFramStopTimeOut
     1105      then
     1106         return yes.
     1107      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1108      if     mWaitFramTimeOut ne ?
     1109         and mWaitFramTimeOut ne 0
     1110         and mWaitFramTimeOut lt vtime
     1111      then do:
     1112         mWaitFramStopTimeOut = yes.
     1113      end.
     1114      return mWaitFramStopTimeOut.
     1115   end.
     1116   procedure waitfram-hide :
     1117     if not session:batch-mode
     1118     then do
     1119     on error undo, return error return-value
     1120     :
     1121       pause 0 before-hide .
     1122       if not mBatchMode then
     1123         hide frame waitfram .
     1124     if     not mWaitFramView
     1125        and mWaitProcEvent
     1126     then
     1127       process events .
     1128     end.
     1129   end procedure.
     1130   procedure waitfram-show :
     1131     define input  parameter p-message as character no-undo .
     1132     define variable v-left-margin as integer   no-undo .
     1133     if not session:batch-mode
     1134     then do
     1135     on error undo, return error return-value
     1136     :
     1137       if length(p-message) <= 70 then do:
     1138         assign
     1139           v-left-margin = integer((70 - length(p-message)) / 2)
     1140         .
     1141         assign
     1142           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1143         .
     1144         assign
     1145           v-waitfram-action01 = " "
     1146           v-waitfram-action02 = " "
     1147                                    + fill(" ", v-left-margin)
     1148                                    + p-message
     1149           v-waitfram-action03 = " "
     1150         .
     1151       end.
     1152       else do:
     1153         define variable vRindex1 as integer no-undo.
     1154         define variable vRindex2 as integer no-undo.
     1155         vRindex1 = r-index(p-message," ",70).
     1156         if vRindex1 = 0
     1157         then
     1158            vRindex1 = 70.
     1159         if length(p-message)  <= vRindex1 + 70 then do:
     1160           assign
     1161             v-waitfram-action01 = " "
     1162             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1163             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1164           .
     1165         end.
     1166         else do:
     1167           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1168           if vRindex2 <= vRindex1
     1169           then
     1170              vRindex2 = vRindex1 + 70.
     1171           assign
     1172             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1173             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1174             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1175           .
     1176         end.
     1177       end.
     1178       B-viewProcInfo:visible   in frame waitfram = no.
     1179       B-viewProcInfo:sensitive in frame waitfram = no.
     1180       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1181       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1182       if  (   mWaitFramView
     1183          or  mWaitProcEvent)
     1184          and not mBatchMode
     1185       then
     1186          display
     1187             v-waitfram-action01 skip
     1188             v-waitfram-action02 skip
     1189             v-waitfram-action03 skip
     1190          with frame waitfram .
     1191       if     mWaitFramView
     1192          then do:
     1193             if     mWaitFramInterval ne ?
     1194                and not mBatchMode
     1195             then
     1196                wait-for go of frame waitfram pause mWaitFramInterval.
     1197          end.
     1198          else
     1199             if     mWaitProcEvent
     1200                and not mBatchMode
     1201             then
     1202                process events .
     1203     end.
     1204   end procedure.
     1205      procedure waitfram-show-this:
     1206         define input  parameter iInterval as int64 no-undo.
     1207         define variable vtime as int64 no-undo.
     1208         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1209         mWaitFramInterval = iInterval.
     1210         run waitfram-show (substitute("&1&2 &3&4" ,
     1211                                       mWaitFramTextBeg ,
     1212                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1213                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1214                                       mWaitFramTextEnd
     1215                                      )
     1216                           ).
     1217      end.
     1218      procedure WaitFramRunPause:
     1219         define input  parameter iInterval as dec no-undo.
     1220         define variable vStart  as datetime-tz no-undo.
     1221         define variable vend    as datetime-tz no-undo.
     1222         define variable vint as int64 no-undo.
     1223         define variable vOk as logical no-undo.
     1224         vStart = now.
     1225         vend   = vStart.
     1226         publish "WaitFramPause" (iInterval,output vOk).
     1227         vend   =  now.
     1228         vint = vend - vStart.
     1229         vint = iInterval - vint / 1000.
     1230         if     not mWaitFramStop
     1231            and (   vint > 0
     1232                 or (    not vOk
     1233                     and iInterval eq ?
     1234                     )
     1235                 )
     1236         then
     1237            run waitfram-show-this (iInterval).
     1238         vend   =  now.
     1239         vint = vend - vStart.
     1240         vint = iInterval - vint / 1000.
     1241         if     not mWaitFramStop
     1242            and vint > 0
     1243         then do:
     1244            run gbl/pause.p (vint * 1000).
     1245         end.
     1246         if iInterval ne ?
     1247         then
     1248            publish "WaitFramStop".
     1249         waitfram-check-timeout().
     1250      end.
     1251      procedure WaitFramWaitFor:
     1252         define input  parameter iInterval as dec no-undo.
     1253         assign
     1254            mWaitFramStartProc   = now
     1255            mWaitFramStopUser    = no
     1256            mWaitFramStopTimeOut = no
     1257         .
     1258         block-wait:
     1259         do while not mWaitFramStop:
     1260            run WaitFramRunPause (iInterval).
     1261            if  waitfram-check-timeout()
     1262            then do:
     1263               leave block-wait.
     1264            end.
     1265         end.
     1266         run waitfram-hide.
     1267      end.
     1268   procedure waitfram-join :
     1269     define input  parameter p-line-1  as character no-undo .
     1270     define input  parameter p-line-2  as character no-undo .
     1271     define input  parameter p-line-3  as character no-undo .
     1272     define output parameter p-message as character no-undo .
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       assign
     1277         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1278                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1279                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1280       .
     1281     end.
     1282   end procedure.
     1283   function waitfram-join-function returns character
     1284     (input p-line-1 as character
     1285     ,input p-line-2 as character
     1286     ,input p-line-3 as character
     1287     ).
     1288     define variable v-message as character no-undo .
     1289     run waitfram-join in this-procedure
     1290       (input  p-line-1
     1291       ,input  p-line-2
     1292       ,input  p-line-3
     1293       ,output v-message
     1294       ) .
     1295     return v-message .
     1296   end function .
     1297   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   procedure cur-time :
     1299      define output parameter p-today as date      no-undo .
     1300      define output parameter p-time  as integer   no-undo .
     1301     do
     1302     on error undo, return error
     1303     :
     1304       define variable v-date1 as date      no-undo .
     1305       define variable v-date2 as date      no-undo .
     1306       define variable v-time  as integer   no-undo .
     1307       assign
     1308         v-date1 = today
     1309         v-time  = time
     1310         v-date2 = today
     1311       .
     1312       if v-date1 <> v-date2
     1313       then do:
     1314         assign
     1315           v-date1 = today
     1316           v-time  = v-time
     1317         .
     1318       end.
     1319       assign
     1320         p-today = v-date1
     1321         p-time  = v-time
     1322       .
     1323     end.
     1324   end.
     1325   function cur-time-date returns character
     1326   :
     1327     return string(today, '99/99/9999':U) .
     1328   end.
     1329   function cur-time-mjd returns decimal
     1330   :
     1331     define variable v-date as date      no-undo .
     1332     define variable v-time as integer   no-undo .
     1333     run cur-time in this-procedure
     1334       (output v-date
     1335       ,output v-time
     1336       ) .
     1337     return integer(v-date) - 2400002 + (v-time / 86400) .
     1338   end.
     1339   function cur-time-get-ending-index returns integer
     1340   (input p-number as integer
     1341   )
     1342   :
     1343     if p-number < 0
     1344     or p-number = ?
     1345     then do:
     1346       return 1 .
     1347     end.
     1348     define variable v-rest as integer   no-undo .
     1349     assign
     1350       p-number = p-number modulo 100
     1351     .
     1352     if p-number < 20
     1353     then do:
     1354       assign
     1355         v-rest = p-number
     1356       .
     1357     end.
     1358     else do:
     1359       assign
     1360         v-rest = p-number modulo 10
     1361       .
     1362     end.
     1363     case v-rest :
     1364       when 1
     1365       then do:
     1366         return 2 .
     1367       end.
     1368       when 2 or
     1369       when 3 or
     1370       when 4
     1371       then do:
     1372         return 3 .
     1373       end.
     1374       otherwise do:
     1375         return 1 .
     1376       end.
     1377     end case .
     1378   end.
     1379   procedure cur-time-mjd-to-date :
     1380      define input  parameter i-mjd-diff as decimal no-undo.
     1381      define output parameter o-Date     as date    no-undo.
     1382      define output parameter o-Time     as integer no-undo.
     1383      define variable v-day-number as integer   no-undo .
     1384      if    i-mjd-diff < 0
     1385         or i-mjd-diff = ?
     1386      then do:
     1387         return "?" .
     1388      end.
     1389      assign
     1390         v-day-number = truncate(i-mjd-diff,0).
     1391         o-Date = date(v-day-number + 2400002).
     1392         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1393     .
     1394   end.
     1395   function cur-time-mjd-to-string returns character
     1396   (input p-mjd-diff as decimal
     1397   )
     1398   :
     1399     define variable v-day-number as integer   no-undo .
     1400     define variable v-seconds    as integer   no-undo .
     1401     define variable v-hour       as integer   no-undo .
     1402     define variable v-min        as integer   no-undo .
     1403     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1404     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1405     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1406     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1407     if p-mjd-diff < 0
     1408     or p-mjd-diff = ?
     1409     then do:
     1410       return "?" .
     1411     end.
     1412     assign
     1413       v-day-number = integer(truncate(p-mjd-diff,0))
     1414       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1415     .
     1416     if v-seconds > 86400
     1417     then do:
     1418       assign
     1419         v-seconds = 86400 - 1
     1420       .
     1421     end.
     1422     if v-seconds < 0
     1423     then do:
     1424       assign
     1425         v-seconds = 0
     1426       .
     1427     end.
     1428     assign
     1429       v-hour = truncate(v-seconds / 3600, 0)
     1430     .
     1431     assign
     1432       v-seconds = v-seconds modulo 3600
     1433     .
     1434     assign
     1435       v-min = truncate(v-seconds / 60, 0)
     1436     .
     1437     assign
     1438       v-seconds = v-seconds modulo 60
     1439     .
     1440     return
     1441         (if v-day-number <> 0
     1442           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1443           else ""
     1444         )
     1445       + (if v-day-number <> 0 or v-hour <> 0
     1446           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1447           else ""
     1448         )
     1449       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1450           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1451           else ""
     1452         )
     1453       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1454       .
     1455   end.
     1456   function cur-time-string returns character
     1457   :
     1458     define variable v-date as date      no-undo .
     1459     define variable v-time as integer   no-undo .
     1460     run cur-time in this-procedure
     1461       (output v-date
     1462       ,output v-time
     1463       ) .
     1464     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1465   end.
     1466   function cur-time-string-sec returns character
     1467   :
     1468     define variable v-date as date      no-undo .
     1469     define variable v-time as integer   no-undo .
     1470     run cur-time in this-procedure
     1471       (output v-date
     1472       ,output v-time
     1473       ) .
     1474     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1475   end.
     1476   function cur-time-custom  returns character
     1477   (input p-prefix as character
     1478   ,input p-date-format as character
     1479   ,input p-delimiter as character
     1480   ,input p-time-format as character
     1481   ,input p-suffix as character
     1482   )
     1483   :
     1484     define variable v-date as date      no-undo .
     1485     define variable v-time as integer   no-undo .
     1486     run cur-time in this-procedure
     1487       (output v-date
     1488       ,output v-time
     1489       ) .
     1490     return
     1491       p-prefix
     1492       + string(v-date, p-date-format)
     1493       + p-delimiter
     1494       + string(v-time, p-time-format)
     1495       + p-suffix
     1496       .
     1497   end.
     1498   function cur-time-print  returns character
     1499   :
     1500     define variable v-date as date      no-undo .
     1501     define variable v-time as integer   no-undo .
     1502     run cur-time in this-procedure
     1503       (output v-date
     1504       ,output v-time
     1505       ) .
     1506     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1507   end.
     1508   function cur-time-datetime returns datetime
     1509   :
     1510     define variable v-char as character no-undo .
     1511     define variable v-datetime as datetime no-undo .
     1512     v-char = cur-time-string().
     1513     v-datetime = datetime(v-char).
     1514     return  v-datetime.
     1515   end.
     1516   function cur-time-string-msec returns character
     1517   :
     1518     define variable v-date as datetime  no-undo .
     1519     v-date = now.
     1520     return string(v-date) .
     1521   end.
     1522   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1523     define variable v-cntxt-db-num        as integer   no-undo .
     1524     define variable v-cntxt-userid        as character no-undo .
     1525     define variable v-cntxt-level         as character no-undo .
     1526     define variable v-cntxt-host-code-obj as integer   no-undo .
     1527     define variable v-cntxt-obj-type      as character no-undo .
     1528     define variable v-cntxt-obj-code      as integer   no-undo .
     1529     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1530     define variable v-cntxt-is-admin      as logical   no-undo .
     1531   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1532   define  stream PrnLibStream.
     1533   procedure prn-lib-prn-file :
     1534     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1535     define input parameter p-DIsabledoptions as integer no-undo .
     1536     define variable v-report-name as character no-undo .
     1537     define variable v-user-action as character no-undo .
     1538     define variable v-printed     as logical   no-undo .
     1539     define variable v-exist       as logical   no-undo .
     1540     do
     1541       on error undo, return error
     1542       :
     1543       run prn-lib-get-report-name  in this-procedure (
     1544         input parParentProc
     1545         ,output v-report-name
     1546         ).
     1547   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1549     (input  v-report-name
     1550     ,input  2
     1551     ,output v-exist
     1552     )  .
     1553       if NOT v-exist then
     1554       DO:
     1555         Message
     1556           "Нет заданий на печать ! "
     1557           view-as alert-box .
     1558         Return  .
     1559       End.
     1560       run gbl/prnfilen.w
     1561         (input  ""
     1562         ,input  p-DisabledOptions
     1563         ,input  string(v-report-name )
     1564         ,input  7
     1565         ,output v-user-action
     1566         ,output v-printed
     1567         ) .
     1568       if v-printed then
     1569       do:
     1570         return "YES" .
     1571       end.
     1572       else
     1573       do:
     1574         return "NO" .
     1575       end.
     1576     end.
     1577   end procedure.
     1578   procedure prn-lib-open-stream :
     1579     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1580     define input parameter p-page-size    as integer no-undo .
     1581     define input parameter p-is-stream    as logical no-undo .
     1582     define input parameter p-append       as logical no-undo .
     1583     define variable v-report-name as character no-undo .
     1584     do
     1585       on error undo, return error
     1586       :
     1587       run prn-lib-get-report-name  in this-procedure (
     1588         input parParentProc
     1589         ,output v-report-name
     1590         ).
     1591       if p-is-stream then
     1592       do:
     1593         if p-append then
     1594         do:
     1595           output stream PrnLibStream to value( v-report-name )
     1596             page-size value(p-page-size) append .
     1597         end.
     1598         if not p-append then
     1599         do:
     1600           output stream PrnLibStream to value( v-report-name )
     1601             page-size value(p-page-size) .
     1602         end.
     1603       end.
     1604       if not p-is-stream then
     1605       do:
     1606         if p-append then
     1607         do:
     1608           output to value( v-report-name )
     1609             page-size value(p-page-size) append .
     1610         end.
     1611         if not p-append then
     1612         do:
     1613           output to value( v-report-name )
     1614             page-size value(p-page-size) .
     1615         end.
     1616       end.
     1617     end.
     1618   end procedure.
     1619   procedure prn-lib-open-exp :
     1620     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1621     define input parameter p-is-stream    as logical no-undo .
     1622     define input parameter p-is-append    as logical no-undo .
     1623     define output parameter p-ReportFileName as char init "report" no-undo.
     1624     define output parameter p-process as logical no-undo .
     1625     define variable glog as logical no-undo .
     1626     do
     1627       on error undo, return error
     1628       :
     1629       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1630         TITLE      "Укажите путь"
     1631         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1632         ASK-OVERWRITE
     1633         CREATE-TEST-FILE
     1634         SAVE-AS
     1635         USE-FILENAME
     1636         DEFAULT-EXTENSION "txt"
     1637         UPDATE glog
     1638         .
     1639       if not glog then  return.
     1640       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1641       if p-is-stream then
     1642       do:
     1643         if p-is-append then
     1644         do:
     1645           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1646         end.
     1647         else
     1648         do:
     1649           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1650         end.
     1651       end.
     1652       else
     1653       do:
     1654         if p-is-append then
     1655         do:
     1656           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1657         end.
     1658         else
     1659         do:
     1660           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1661         end.
     1662       end.
     1663       p-process = yes.
     1664     end.
     1665   end procedure.
     1666   procedure prn-lib-get-report-name :
     1667     define input parameter parParentProc  as widget-handle no-undo.
     1668     define output parameter p-report-name as character no-undo .
     1669     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1670   end procedure.
     1671   procedure prn-lib-reportviewer-report-name :
     1672     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1673     define input parameter p-report-name-html as character no-undo .
     1674     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1675   end procedure.
     1676   procedure prn-lib-reportviewer :
     1677     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1678     define input parameter p-report-name-html as character no-undo .
     1679     define input parameter p-param        as character no-undo .
     1680     define variable v-excel           as character no-undo init 'TRUE' .
     1681     define variable v-value-character as character no-undo .
     1682     define variable v-value-integer   as character no-undo .
     1683     define variable v-value-date      as date      no-undo .
     1684     define variable v-value-decimal   as decimal   no-undo .
     1685     define variable rep-excel         as logical   no-undo .
     1686     define variable excel-string      as character no-undo .
     1687     define variable v-param-type      as character no-undo .
     1688     define variable v-tth             as handle    no-undo .
     1689     run adm/shattri.p (
     1690       input "get":U
     1691       ,input  ""
     1692       ,input  0
     1693       ,input  'report-glob':U
     1694       ,input  'rep-excel':U
     1695       ,output v-value-character
     1696       ,output v-value-date
     1697       ,output v-value-decimal
     1698       ,output v-value-integer
     1699       ,output rep-excel
     1700       ,output v-param-type
     1701       ,INPUT-OUTPUT table-handle v-tth
     1702       )  .
     1703     if rep-excel then v-excel = "TRUE" .
     1704     else v-excel = "FALSE" .
     1705     if p-param eq ""
     1706     then
     1707        p-param = "EXCEL:" + v-excel.
     1708     else
     1709        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1710     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1711   end procedure.
