     6786   end.
     6787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6788     (input  'is-tsd'
     6789     ,input  0
     6790     ,input  '':U
     6791     ,input  0
     6792     ,input  ''
     6793     ,input  ''
     6794     ,input  ''
     6795     ,input  no
     6796     ,output conf-par
     6797     ,output par-type
     6798     ) no-error .
     6799     assign
     6800     is-tsd = (if conf-par = "yes" then yes else no)
     6801     .
     6802   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6803     run mainmenu_getcntxt in parparentproc
     6804       (output v-cntxt-db-num
     6805       ,output v-cntxt-userid
     6806       ,output v-cntxt-level
     6807       ,output v-cntxt-host-code-obj
     6808       ,output v-cntxt-obj-type
     6809       ,output v-cntxt-obj-code
     6810       ,output v-cntxt-db-num-obj
     6811       ,output v-cntxt-is-admin
     6812       ) .
     6813     if p-curr-obj-type = '':U
     6814     and p-curr-obj-code = 0 then do:
     6815   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6816   run userobjs_select-one in this-procedure
     6817     (input  parparentproc
     6818     ,input  v-cntxt-db-num
     6819     ,input  v-cntxt-userid
     6820     ,input  v-cntxt-host-code-obj
     6821     ,input  v-cntxt-obj-type
     6822     ,input  v-cntxt-obj-code
     6823     ,output v-user-select
     6824     ,output v-sel-obj-type
     6825     ,output v-sel-obj-code
     6826     )  .
     6827       if v-user-select then do: ~
     6828         FIND FIRST buf_user-obj no-lock where
     6829                 buf_user-obj.obj-type = v-sel-obj-type
     6830             and buf_user-obj.obj-code = v-sel-obj-code  No-ERROR.
     6831         if not avail buf_user-obj then return no-apply.
     6832         find first buf_clients no-lock where
     6833                   buf_clients.obj-type = buf_user-obj.obj-type
     6834               and buf_clients.obj-code = buf_user-obj.obj-code no-error.
     6835         if not available buf_clients then return error.
     6836         assign
     6837         p-curr-obj-type = buf_clients.obj-type
     6838         p-curr-obj-code = buf_clients.obj-code
     6839         v-host-code = buf_clients.host-code
     6840         v-no-obj = yes
     6841         .
     6842       end.
     6843       else do:
     6844         message
     6845         "Текущий объект не может быть установлен" skip
     6846         view-as alert-box error .
     6847         undo, return error.
     6848       end.
     6849     end.
     6850     if not (p-curr-obj-type = '':U
     6851             and
     6852             p-curr-obj-code = 0) then do:
     6853       find first buf_clients no-lock
     6854           where buf_clients.obj-type = p-curr-obj-type
     6855           AND    buf_clients.obj-code = p-curr-obj-code no-error.
     6856       if not available buf_clients
     6857       or not (buf_clients.obj-type = 'маг':U
     6858         or
     6859         buf_clients.obj-type = 'скл':U
     6860         )
     6861       then do:
     6862         assign
     6863         p-curr-obj-type = '':U
     6864         p-curr-obj-code = 0
     6865         .
     6866         message
     6867         vss-workfile vss-revision vss-description skip
     6868         "Неверно заданы входные параметры p-curr-obj-type и/или p-curr-obj-code"
     6869         p-curr-obj-type p-curr-obj-code
     6870         view-as alert-box error .
     6871         undo main-block, return error.
     6872       end.
     6873     end.
     6874     assign
     6875     line-rec = ?
     6876     .
     6877     assign
     6878     br-option:column-scrolling in frame Dialog-Frame  = no
     6879     RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     6880                               "Все!" + chr(44) + 'все':U + chr(44) +
     6881                               "Неактивные-" + chr(44) + 'удаленные':U
     6882     RS-status = 'текущие':U
     6883     .
     6884     if v-no-obj
     6885     or v-cntxt-level <>  'object':U then do:
     6886       if v-obj-name = "":U then do:
     6887         run proc-b-obj in this-procedure ( input "":U ).
     6888       end.
     6889       display
     6890         b-obj
     6891         v-obj-type
     6892         v-obj-code
     6893         v-obj-name
     6894       with frame Dialog-Frame .
     6895       enable
     6896         b-obj
     6897       with frame Dialog-Frame .
     6898     end.
     6899     else do:
     6900       assign
     6901       v-obj-type  = p-curr-obj-type
     6902       v-obj-code  = p-curr-obj-code
     6903       .
     6904       if v-obj-type = 'маг':U then do:
     6905         find first ub.shop no-lock where
     6906                   ub.shop.obj-code = v-obj-code.
     6907         find first sysconf no-lock where
     6908                   sysconf.host-code = shop.host-code .
     6909         assign
     6910         v-is-restaurant = ub.shop.is-catering
     6911         v-doc-prt = ub.shop.doc-prt.
     6912         .
     6913       end.
     6914       else do:
     6915         find first ub.store no-lock where
     6916                   ub.store.obj-code = p-curr-obj-code.
     6917         find first sysconf no-lock where
     6918                   sysconf.host-code = store.host-code .
     6919         v-doc-prt = ub.store.doc-prt.
     6920       end.
     6921       run proc-fill-temp-list in this-procedure .
     6922       for each temp-shop:
     6923         delete temp-shop.
     6924       end.
     6925       create temp-shop.
     6926       run proc-b-cd in this-procedure  ( input yes).
     6927     end.
     6928     run UI-on.
     6929     WAIT-FOR GO OF FRAME Dialog-Frame focus br-list.
     6930   END.
     6931   HIDE FRAME Dialog-Frame.
     6932   PROCEDURE UI-on:
     6933   define variable v-recid0 as recid no-undo.
     6934   define variable v-start as logical no-undo .
     6935   define buffer buf_temp-list for temp-list.
     6936   define buffer buf_bb-list-hist for bb-list-hist.
     6937   bb-list.part-code:resizable in browse br-list = yes.
     6938   bb-list.in-code:resizable in browse br-list = yes.
     6939   if v-cntxt-level <> 'object':U
     6940   or v-cntxt-obj-type <> 'маг':U then do:
     6941     assign
     6942     MENU-ITEM m-cd:sensitive in menu m-save = no.
     6943   end.
     6944     find first buf_bb-list-hist where buf_bb-list-hist.id = 0 no-error.
     6945     if available buf_bb-list-hist then
     6946     assign
     6947     frame Dialog-Frame:title = substitute("СПИСОК  КОДОВ &1",  string(buf_bb-list-hist.des, "X(60)"))
     6948     .
     6949     if tot-lns = ? then do:
     6950       v-start = yes.
     6951       for each l-bb-list :
     6952         accumulate l-bb-list.artic (count).
     6953       end.
     6954       tot-lns = (accum count l-bb-list.artic).
     6955       if tot-lns > 0 then do:
     6956         find last  buf_bb-list-hist no-error .
     6957         if available buf_bb-list-hist and buf_bb-list-hist.id = 1 and v-start then delete buf_bb-list-hist.
     6958         v-seq = (if available buf_bb-list-hist then buf_bb-list-hist.id else 0)  + 1.
     6959         run create-bb-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6960                                              , input-output v-seq
     6961                                              , input 0
     6962                                              , input 'S':U
     6963                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6964                                              , input tot-lns
     6965                                              , input "start":U
     6966                                              , input '':U
     6967                                              , input '':U
     6968                                              , input '':U
     6969                                              , input ?
     6970                                              ).
     6971       end.
     6972       else do:
     6973         line-mode = 'ДОБАВЛЕНИЕ':U.
     6974         for each buf_bb-list-hist:
     6975           delete buf_bb-list-hist.
     6976         end.
     6977         v-seq = 1.
     6978         run create-bb-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6979                                              , input-output v-seq
     6980                                              , input 0
     6981                                              , input '':U
     6982                                              , input "# Исходный список кодов пуст."
     6983                                              , input tot-lns
     6984                                              , input 'start':U
     6985                                              , input '':U
     6986                                              , input '':U
     6987                                              , input '':U
     6988                                              , input ?
     6989                                              ).
     6990       end.
     6991     end.
     6992     hide loc-art in frame Dialog-Frame loc-name loc-code loc-b-str in frame Dialog-Frame.
     6993     assign
     6994       loc-art = ""
     6995       RS-list-method = "single"
     6996       dsp-rs = "Всего строк в списке кодов : " + string (tot-lns).
     6997     find first buf_temp-list no-lock where
     6998                buf_temp-list.fvalue = rs-list-method.
     6999     assign
     7000     v-recid0 = recid(buf_temp-list).
     7001     open query br-option for each temp-list no-lock .
     7002     DISPLAY br-option dsp-rs RS-Status WITH FRAME Dialog-Frame.
     7003     ENABLE
     7004     b-exit b-add b-hist b-help br-option br-list RS-Status b-cd
     7005     T-loc-base
     7006     T-loc-alt
     7007     T-bc-base
     7008     T-bc-alt
     7009     T-all-prt
     7010     T-parts-ser
     7011     T-parts-not-blank
     7012     T-parts-all
     7013     T-pb-base
     7014     T-pb-alt
     7015     T-sc-base
     7016     WITH FRAME Dialog-Frame.
     7017     if is-tsd = no then do:
     7018       menu-item m-scn-save:sensitive in menu m-save = no.
     7019     end.
     7020     reposition br-option to recid v-recid0.
     7021     if tot-lns > 0 then
     7022       ENABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7023     else do:
     7024       DISABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7025     end.
     7026     open query br-list for each bb-list no-lock indexed-reposition.
     7027    if v-seq > 1 then
     7028     find last buf_bb-list-hist no-lock where
     7029               buf_bb-list-hist.id = (v-seq - 1)
     7030          and  buf_bb-list-hist.line = 0 no-error .
     7031     DISPLAY br-option
     7032     (if available buf_bb-list-hist
     7033     then buf_bb-list-hist.des
     7034     else '') @ dsp-rs
     7035     RS-Status WITH FRAME Dialog-Frame.
     7036     ENABLE
     7037     b-macro  when v-start
     7038     b-record when v-start
     7039     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     7040     if v-start then do:
     7041       hide
     7042       b-stop
     7043       b-clear-macro
     7044       in frame Dialog-Frame.
     7045     end.
     7046     v-start = no.
     7047     if line-rec <> ? then
     7048       reposition br-list to recid line-rec no-error.
     7049     apply "entry" to br-list in frame Dialog-Frame.
     7050     if available bb-list then do:     find ub.clients where ub.clients.obj-type = bb-list.prod-type                    and ub.clients.obj-code = bb-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = bb-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = bb-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = bb-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   disp tot-lns @ f-tot-lns with frame Dialog-Frame.
     7051   END PROCEDURE.
     7052   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7053   PROCEDURE ex-bbc :
     7054   define input parameter rs-list-method as character no-undo .
     7055   define input parameter rs-status as character no-undo .
     7056   define input parameter line-mode as character no-undo .
     7057   define input parameter p-empty-scale as logical no-undo .
     7058   define input parameter p-b-str as character no-undo .
     7059   define input parameter p-is-loc-ean as logical no-undo .
     7060   define parameter buffer buf_bar-code for ub.bar-code.
     7061   define parameter buffer buf_prod-bc for ub.prod-bc.
     7062   define variable v-f-name like ub.gds-prt.f-name no-undo .
     7063   define buffer buf_gds-prt for ub.gds-prt.
     7064   if available buf_prod-bc then
     7065   p-b-str = buf_prod-bc.b-str.
     7066   if rs-list-method begins "single":U or
     7067     (ub.goods.stts = 0  and rs-status <> 'удаленные':U) or
     7068     (ub.goods.stts <> 0 and rs-status <> 'текущие':U) then do:
     7069     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     7070       find first bb-list where bb-list.gds-code  = ub.goods.gds-code
     7071                        and bb-list.b-code    = buf_bar-code.b-code
     7072                        and bb-list.b-str     = p-b-str  no-error.
     7073       if available bb-list then do:
     7074         if line-mode = 'удаление':U then do:
     7075           lns-cnt = lns-cnt + 1.
     7076           delete bb-list.
     7077         end.
     7078         else do:
     7079           if bb-list.to-del = ? then.
     7080           else do:
     7081             lns-cnt = lns-cnt + 1.
     7082             bb-list.to-del = ?.
     7083           end.
     7084         end.
     7085       end.
     7086     end.
     7087     else
     7088       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     7089         if p-empty-scale then  do:
     7090         end.
     7091         else do:
     7092           find first buf_gds-prt no-lock where
     7093                     buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     7094           if not available buf_gds-prt then v-f-name = "!!!Неизвестный признак шкалы".
     7095           else v-f-name = buf_gds-prt.f-name.
     7096         end.
     7097   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7098   find first bb-list
     7099     where bb-list.gds-code = buf_bar-code.gds-code
     7100       and bb-list.b-code   = buf_bar-code.b-code
     7101       and bb-list.b-str    = p-b-str
     7102     no-error .
     7103   if available bb-list then do:
     7104     assign
     7105       bb-list.to-del = no
     7106     .
     7107   end.
     7108   else do:
     7109     define variable v-last62 as integer no-undo .
     7110     find last bb-list use-index oi no-error.
     7111     if available bb-list then do:
     7112       v-last62 = bb-list.order-num .
     7113     end.
     7114     else do:
     7115       v-last62 = 0 .
     7116     end.
     7117     create bb-list .
     7118     buffer-copy ub.goods to bb-list
     7119     assign
     7120       bb-list.to-del = no
     7121       bb-list.order-num = v-last62 + 1
     7122       bb-list.b-code = buf_bar-code.b-code
     7123       bb-list.bc-cli-base-rate = buf_bar-code.cli-base-rate
     7124       bb-list.bc-cr-db-num     = buf_bar-code.cr-db-num
     7125       bb-list.in-code       = buf_bar-code.in-code
     7126       bb-list.node-code     = buf_bar-code.node-code
     7127       bb-list.part-code     = buf_bar-code.part-code
     7128       bb-list.stts_         = buf_bar-code.stts_
     7129       bb-list.bc-unit-cli   = buf_bar-code.unit-cli
     7130       bb-list.b-str         = p-b-str
     7131       bb-list.f-name        = v-f-name
     7132       bb-list.loc-ean       = p-is-loc-ean
     7133       .
     7134       if available buf_prod-bc
     7135       then
     7136       assign
     7137       bb-list.bc-on-type    = buf_prod-bc.bc-on-type
     7138       bb-list.bc-on         = buf_prod-bc.bc-on
     7139       bb-list.pbc-cr-db-num = buf_prod-bc.cr-db-num
     7140       .
     7141     assign
     7142       lns-cnt = lns-cnt + 1
     7143       line-rec = recid (bb-list)
     7144     .
     7145   end.
     7146       end.
     7147     if lns-cnt modulo 25 = 0 then
     7148     disp "ЖДИТЕ...    Обработано кодов :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7149   end.
     7150   else
     7151   assign
     7152   lns-ignore = lns-ignore + 1
     7153   .
     7154   end.
     7155   PROCEDURE rs-do :
     7156   define input parameter p-from-macro as logical no-undo .
     7157   define input parameter p-step as logical no-undo .
     7158   define input parameter rs-list-method as character no-undo .
     7159   define input parameter rs-status as character no-undo .
     7160   define input parameter line-mode as character no-undo .
     7161   define input parameter p-id      as integer no-undo .
     7162   define variable v-rowid   as rowid no-undo .
     7163   define variable v-tbl-name as character no-undo .
     7164   define variable glog as logical no-undo .
     7165   define buffer buf_bb-list-hist for bb-list-hist.
     7166   define variable another-price like ub.price-list.price-sale no-undo.
     7167   define variable scan-qnty as dec no-undo.
     7168   define variable bc-qnty as dec no-undo.
     7169   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7170   define variable varresult   as character         no-undo.
     7171   define variable vartype-bc  as character         no-undo.
     7172   define variable varweight   as decimal           no-undo.
     7173   define variable v-value-integer as integer   no-undo .
     7174   define variable v-db-num as integer no-undo .
     7175   define variable l-prod-bc-weight as logical no-undo .
     7176   define variable l-prod-bc-pgweight as logical no-undo .
     7177   define variable l-prod-bc-glob as logical no-undo .
     7178   define variable v-is-weight as logical no-undo .
     7179   define variable IBM-good-code as character no-undo .
     7180   define variable bar_code as character no-undo .
     7181   define variable v-prev-b-code as integer no-undo .
     7182   define variable v-b-code as integer   no-undo .
     7183   define variable v-from-date as date no-undo .
     7184   define variable v-to-date as date no-undo .
     7185   define variable v-from-date-str as character no-undo .
     7186   define variable v-to-date-str as character no-undo .
     7187   define variable v-using as character no-undo .
     7188   define buffer buf_prod-bc for ub.prod-bc.
     7189   define buffer buf_bar-code for ub.bar-code.
     7190   define buffer buf_cd-plu for ub.cd-plu.
     7191   define buffer buf_parts for ub.parts.
     7192   define buffer buf_gds-obj for ub.gds-obj.
     7193   define buffer buf_parts-obj-attr for ub.parts-obj-attr.
     7194   define buffer buf_code-range for ub.code-range.
     7195   define buffer buf_prod-bc-db for ub.prod-bc-db.
     7196   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     7197   define buffer buf_scales-gds for ub.scales-gds.
     7198   do
     7199   on error undo, return error return-value
     7200   :
     7201   if p-from-macro then do:
     7202   end.
     7203   else do:
     7204     assign
     7205     frame Dialog-Frame
     7206     T-all-prt
     7207     T-bc-alt
     7208     T-bc-base
     7209     T-loc-alt
     7210     T-loc-base
     7211     T-parts-all
     7212     T-parts-not-blank
     7213     T-parts-ser
     7214     T-pb-alt
     7215     T-pb-base
     7216     T-sc-base
     7217     .
     7218     if (
     7219     T-all-prt or
     7220     T-bc-alt  or
     7221     T-bc-base or
     7222     T-loc-alt or
     7223     T-loc-base  or
     7224     T-parts-all  or
     7225     T-parts-not-blank or
     7226     T-parts-ser or
     7227     T-pb-alt    or
     7228     T-pb-base   or
     7229     T-sc-base) = no then do:
     7230       message
     7231       "Не выбран ни один тип кодов!"
     7232       view-as alert-box error .
     7233       undo, return error .
     7234     end.
     7235     assign
     7236     temp-shop.obj-code = p-curr-obj-code
     7237     temp-shop.all-prt = T-all-prt
     7238     temp-shop.cd-bc-alt = T-bc-alt
     7239     temp-shop.cd-bc-base = T-bc-base
     7240     temp-shop.cd-loc-alt = T-loc-alt
     7241     temp-shop.cd-loc-base = T-loc-base
     7242     temp-shop.cd-parts-all = T-parts-all
     7243     temp-shop.cd-parts-not-blank = T-parts-not-blank
     7244     temp-shop.cd-parts-ser = T-parts-ser
     7245     temp-shop.cd-pb-alt = T-pb-alt
     7246     temp-shop.cd-pb-base = T-pb-base
     7247     temp-shop.cd-sc-base = T-sc-base
     7248     .
     7249   end.
     7250   assign
     7251   lns-cnt = 0
     7252   lns-ignore = 0
     7253   v-num-add  = 0
     7254   v-num-ignored = 0
     7255   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7256   .
     7257   run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     7258   if session:set-wait-state( "COMPILER" )  then .
     7259   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7260   case rs-list-method:
     7261     when "optimize"  then do:
     7262       find first buf_bb-list-hist where
     7263                  buf_bb-list-hist.id = p-id .
     7264       run proc-b-optimize(input p-from-macro
     7265                         , input rs-list-method
     7266                         , input rs-status
     7267                         , input buf_bb-list-hist.item_
     7268                         ) no-error .
     7269       assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7270     end.
     7271     when "all" then do:
     7272       find first buf_bb-list-hist where
     7273                  buf_bb-list-hist.id = p-id .
     7274       if p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7275       for each goods no-lock:
     7276         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7277         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode, buffer goods) no-error .
     7278       end.
     7279       assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7280     end.
     7281     when "goods" then do:
     7282       for each buf_bb-list-hist where
     7283                buf_bb-list-hist.id = p-id:
     7284         if buf_bb-list-hist.line = 0
     7285         and p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7286         if buf_bb-list-hist.line <> 0 then do:
     7287           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7288           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7289           find goods where rowid (goods) = v-rowid no-lock.
     7290           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     7291           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7292         end.
     7293       end.
     7294     end.
     7295     when "goods-b-code"
     7296     or
     7297     when "goods-b-code-ean"
     7298     then do:
     7299       for each buf_bb-list-hist where
     7300                buf_bb-list-hist.id = p-id
     7301           and  buf_bb-list-hist.item_ <> '':U:
     7302         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7303         find first buf_bar-code no-lock where
     7304                   rowid(buf_bar-code) = v-rowid no-error.
     7305         if available buf_bar-code then do:
     7306           run get-prt-and-unit in this-procedure (
     7307                                                   input goods.prt-root
     7308                                                   ,input goods.unit-base
     7309                                                   ,output l-empty-scale
     7310                                                   ) .
     7311           if rs-list-method = "goods-b-code":U then
     7312           run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7313           if rs-list-method = "goods-b-code-ean":U then do:
     7314             RUN gen-bc( input buf_bar-code.b-code, output bar_code ).
     7315             IBM-good-code  = trim( bar_code ) .
     7316             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input IBM-good-code, input yes, buffer buf_bar-code, buffer buf_prod-bc).
     7317           end.
     7318           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7319         end.
     7320       end.
     7321     end.
     7322     when "goods-b-str" then do:
     7323       for each buf_bb-list-hist where
     7324                buf_bb-list-hist.id = p-id
     7325           and  buf_bb-list-hist.item_ <> '':U:
     7326         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7327         find first buf_prod-bc no-lock where
     7328                 rowid(buf_prod-bc) = v-rowid no-error.
     7329         if available buf_prod-bc then do:
     7330           find first buf_bar-code no-lock where
     7331                     buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     7332           if available buf_prod-bc then do:
     7333             run get-prt-and-unit in this-procedure (
     7334                                                     input goods.prt-root
     7335                                                     ,input goods.unit-base
     7336                                                     ,output l-empty-scale
     7337                                                     ) .
     7338             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode ,  input l-empty-scale, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7339           end.
     7340         end.
     7341       end.
     7342     end.
     7343     when "gds-list"  then do:
     7344       for each buf_bb-list-hist where
     7345                buf_bb-list-hist.id = p-id:
     7346         if buf_bb-list-hist.line = 0
     7347         and p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7348         if buf_bb-list-hist.line <> 0 then do:
     7349           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7350           find first goods no-lock where rowid(goods) = v-rowid.
     7351           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7352           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode,buffer goods) no-error .
     7353           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7354         end.
     7355       end.
     7356     end.
     7357     when "file-gds"
     7358     or
     7359     when "scaner"
     7360     then do:
     7361       run proc-file-list-methods in this-procedure(input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id). .
     7362     end.
     7363     when "last-check":U then do:
     7364       find first buf_bb-list-hist where
     7365                buf_bb-list-hist.id = p-id
     7366            AND buf_bb-list-hist.item_ <> '':U .
     7367       assign
