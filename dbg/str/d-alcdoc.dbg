      829         (input  (p-new-height - frame Dialog-Frame :height)
      830         ,input  p-move-resize
      831         ) .
      832     end.
      833   end procedure.
      834   procedure diasize_change-width :
      835     define input  parameter p-change-value as decimal   no-undo .
      836     define input  parameter p-move-resize  as logical   no-undo .
