     1190           define variable v-cntxt-db-num        as integer   no-undo .
     1191           define variable v-cntxt-userid        as character no-undo .
     1192           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1193                                             , OUTPUT v-cntxt-userid
     1194                                             ) .
     1195           run gbl/wndsizew.p
     1196             (input  v-cntxt-db-num
     1197             ,input  v-cntxt-userid
     1198             ,input  v-diasize-proc-name
     1199             ,input  'width':u
     1200             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1201             ) .
     1202         end.
     1203       end.
     1204     end.
     1205     assign
     1206       v-diasize-change-size = false
     1207     .
     1208   end procedure.
     1209   procedure diasize_set-width :
     1210     define input  parameter p-new-width  as decimal   no-undo .
     1211     define input  parameter p-move-resize as logical   no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       run diasize_change-width in this-procedure
     1216         (input  (p-new-width - frame Dialog-Frame :width)
     1217         ,input  p-move-resize
     1218         ) .
     1219     end.
     1220   end procedure.
     1221   procedure diasize_position-resize-button :
     1222     do with frame Dialog-Frame
     1223     :
     1224       hide v-diasize-resize-button .
     1225       assign
     1226         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1227                     - 1
     1228                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1229         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1230                     - 1
     1231                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1232       .
     1233       view v-diasize-resize-button .
     1234     end.
     1235   end procedure.
     1236   on alt-right anywhere
     1237   do:
     1238     run diasize_change-width in this-procedure
     1239       (input 1
     1240       ,input true
     1241       ) .
     1242     return no-apply .
     1243   end.
     1244   on alt-left anywhere
     1245   do:
     1246     run diasize_change-width in this-procedure
     1247       (input -1
     1248       ,input true
     1249       ) .
     1250     return no-apply .
     1251   end.
     1252   on alt-down anywhere
     1253   do:
     1254     run diasize_change-height in this-procedure
     1255       (input 1
     1256       ,input true
     1257       ) .
     1258     return no-apply .
     1259   end.
     1260   on alt-up anywhere
     1261   do:
     1262     run diasize_change-height in this-procedure
     1263       (input -1
     1264       ,input true
     1265       ) .
     1266     return no-apply .
     1267   end.
     1268   on alt-enter of frame Dialog-Frame
     1269   do:
     1270     run diasize_maximize in this-procedure
     1271       (input  ?
     1272       ).
     1273     return no-apply .
     1274   end.
     1275   procedure diasize_end-move :
     1276     do
     1277     on error undo, return error return-value
     1278     :
     1279       define variable v-row-delta as decimal   no-undo .
     1280       define variable v-col-delta as decimal   no-undo .
     1281       define variable v-new-row as decimal   no-undo .
     1282       define variable v-new-col as decimal   no-undo .
     1283       assign
     1284         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1285         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1286       .
     1287       assign
     1288         v-row-delta = v-new-row - frame Dialog-Frame :height
     1289         v-col-delta = v-new-col - frame Dialog-Frame :width
     1290       .
     1291       run diasize_change-height in this-procedure
     1292         (input v-row-delta
     1293         ,input true
     1294         ) .
     1295       run diasize_change-width in this-procedure
     1296         (input v-col-delta
     1297         ,input true
     1298         ) .
     1299     end.
     1300   end procedure.
     1301   procedure diasize_maximize :
     1302     define input  parameter p-action as logical   no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       if p-action = ?
     1307       then do:
     1308         if v-diasize-need-maximize = true
     1309         then do:
     1310           assign
     1311             p-action = true
     1312           .
     1313         end.
     1314         else do:
     1315           assign
     1316             p-action = false
     1317           .
     1318         end.
     1319       end.
     1320       if p-action = true
     1321       then do:
     1322         run diasize_change-height in this-procedure
     1323           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1324               - frame Dialog-Frame :height-chars
     1325           ,input true
     1326           ) .
     1327         run diasize_change-width in this-procedure
     1328           (input session :width-chars
     1329               - frame Dialog-Frame :width-chars
     1330           ,input true
     1331           ) .
     1332         assign
     1333           v-diasize-need-maximize = false
     1334         .
     1335       end.
     1336       else do:
     1337         run diasize_change-width in this-procedure
     1338           (input v-diasize-orig-frame-width
     1339               - frame Dialog-Frame :width-chars
     1340           ,input true
     1341           ) .
     1342         run diasize_change-height in this-procedure
     1343           (input v-diasize-orig-frame-height
     1344               - frame Dialog-Frame :height-chars
     1345           ,input true
     1346           ) .
     1347         assign
     1348           v-diasize-need-maximize = true
     1349         .
     1350       end.
     1351     end.
     1352   end procedure.
     1353   procedure diasize_restore-orig-size :
     1354     do
     1355     on error undo, return error return-value
     1356     :
     1357       assign
     1358         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1359         v-diasize-current-frame-height = frame Dialog-Frame :height
     1360       .
     1361       run diasize_set-height in this-procedure
     1362         (input  v-diasize-orig-frame-height
     1363         ,input  true
     1364         ) .
     1365       run diasize_set-width in this-procedure
     1366         (input  v-diasize-orig-frame-width
     1367         ,input  true
     1368         ) .
     1369     end.
     1370   end procedure.
     1371   procedure diasize_restore-current-size :
     1372     do
     1373     on error undo, return error return-value
     1374     :
     1375       run diasize_set-height in this-procedure
     1376         (input  v-diasize-current-frame-height
     1377         ,input  true
     1378         ) .
     1379       run diasize_set-width in this-procedure
     1380         (input  v-diasize-current-frame-width
     1381         ,input  true
     1382         ) .
     1383     end.
     1384   end procedure.
     1385   procedure diasize_set-browse-handle :
     1386     define input  parameter p-browse-handle as handle   no-undo .
     1387     define buffer buf_temp-browse-handle for temp-browse-handle .
     1388     do
     1389     on error undo, return error return-value
     1390     :
     1391       assign
     1392         v-diasize-browse-handle = p-browse-handle
     1393       .
     1394       for each buf_temp-browse-handle
     1395       on error undo, return error return-value
     1396       :
     1397         delete buf_temp-browse-handle .
     1398       end.
     1399     end.
     1400   end procedure.
     1401   procedure diasize_add_browse :
     1402     define input  parameter p-browse-type   as character no-undo .
     1403     define input  parameter p-browse-handle as handle    no-undo .
     1404     define buffer buf_temp-browse-handle for temp-browse-handle .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       assign
     1409         v-diasize-browse-number = v-diasize-browse-number + 1
     1410       .
     1411       create buf_temp-browse-handle .
     1412       assign
     1413         buf_temp-browse-handle.browse-type   = p-browse-type
     1414         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1415         buf_temp-browse-handle.browse-handle = p-browse-handle
     1416       .
     1417     end.
     1418   end procedure.
     1419   procedure diasize_init :
     1420     define variable v-default-value    as logical   no-undo .
     1421     define variable v-restore-saved    as logical   no-undo .
     1422     define variable v-resize-value-str as character no-undo .
     1423     do
     1424     on error undo, return error return-value
     1425     :
     1426       do with frame Dialog-Frame
     1427       :
     1428         assign
     1429           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1430           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1431           v-diasize-browse-handle     = browse br-alcdoc :handle
     1432         .
     1433         create button v-diasize-resize-button
     1434         assign
     1435           parent        = frame Dialog-Frame :first-child
     1436           label         = "s"
     1437           height-pixels = 16
     1438           width-pixels  = 16
     1439           visible       = true
     1440           sensitive     = true
     1441           movable       = true
     1442           triggers:
     1443             on end-move persistent run diasize_end-move in this-procedure .
     1444           end triggers.
     1445         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1446         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1447         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1448         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1449         assign
     1450           v-diasize-wndmax = false
     1451         .
     1452         if connected("ub") = true
     1453         then do:
     1454           define variable v-cntxt-db-num        as integer   no-undo .
     1455           define variable v-cntxt-userid        as character no-undo .
     1456           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1457                                             , OUTPUT v-cntxt-userid
     1458                                             ) .
     1459           run gbl/wndpar_r.p
     1460             (input  v-cntxt-db-num
     1461             ,input  v-cntxt-userid
     1462             ,input  'wndmax':U
     1463             ,output v-diasize-wndmax
     1464             ,output v-default-value
     1465             ) .
     1466         end.
     1467         assign
     1468           v-diasize-wndstore = false
     1469         .
     1470         if connected("ub") = true
     1471         then do:
     1472           run gbl/wndpar_r.p
     1473             (input  v-cntxt-db-num
     1474             ,input  v-cntxt-userid
     1475             ,input  'wndstore':U
     1476             ,output v-diasize-wndstore
     1477             ,output v-default-value
     1478             ) .
     1479         end.
     1480         assign
     1481           v-diasize-proc-name = entry(1, program-name(2), '.')
     1482         .
     1483         if v-diasize-wndstore = true
     1484         then do:
     1485           assign
     1486             v-restore-saved = false
     1487           .
     1488           if connected("ub") = true
     1489           then do:
     1490             run gbl/wndsizer.p
     1491               (input  v-cntxt-db-num
     1492               ,input  v-cntxt-userid
     1493               ,input  v-diasize-proc-name
     1494               ,input  'height':u
     1495               ,output v-resize-value-str
     1496               ) .
     1497             if v-resize-value-str <> '':U
     1498             then do:
     1499               run diasize_change-height in this-procedure
     1500                 (input  integer(v-resize-value-str)
     1501                 ,input  true
     1502                 ) .
     1503               assign
     1504                 v-restore-saved = true
     1505               .
     1506             end.
     1507           end.
     1508           if connected("ub") = true
     1509           then do:
     1510             run gbl/wndsizer.p
     1511               (input  v-cntxt-db-num
     1512               ,input  v-cntxt-userid
     1513               ,input  v-diasize-proc-name
     1514               ,input  'width':u
     1515               ,output v-resize-value-str
     1516               ) .
     1517             if v-resize-value-str <> '':U
     1518             then do:
     1519               run diasize_change-width in this-procedure
     1520                 (input  integer(v-resize-value-str)
     1521                 ,input  true
     1522                 ) .
     1523               assign
     1524                 v-restore-saved = true
     1525               .
     1526             end.
     1527           end.
     1528           if v-restore-saved <> true
     1529           then do:
     1530             if v-diasize-wndmax = true
     1531             then do:
     1532               run diasize_maximize in this-procedure
     1533                 (input  true
     1534                 ) .
     1535             end.
     1536           end.
     1537         end.
     1538         else do:
     1539           if v-diasize-wndmax = true
     1540           then do:
     1541             run diasize_maximize in this-procedure
     1542               (input  true
     1543               ) .
     1544           end.
     1545         end.
     1546       end.
     1547     end.
     1548   end procedure.
     1549   procedure diasize_need-full-display :
     1550     define output parameter p-need-full-display as logical   no-undo .
     1551     do
     1552     on error undo, return error return-value
     1553     :
     1554       assign
     1555         p-need-full-display = v-diasize-need-full-display
     1556       .
     1557       assign
     1558         v-diasize-need-full-display = false
     1559       .
     1560     end.
     1561   end procedure.
     1562   procedure get-context :
     1563      define output parameter p-db-num as integer          no-undo.
     1564      define output parameter p-user-id as character        no-undo.
     1565      define variable v-login               as character    no-undo.
     1566      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1567      define buffer buf_user-login  for ub.user-login .
     1568      do
     1569      on error undo, return error
     1570      :
     1571            FIND FIRST buf_sys-ctrl no-lock.
     1572            ASSIGN
     1573               v-login = USERID("ub")
     1574               p-db-num = buf_sys-ctrl.db-num
     1575            .
     1576            FIND FIRST buf_user-login
     1577                 WHERE buf_user-login.db-num = p-db-num
     1578                   AND buf_user-login.user-login = v-login
     1579                 no-lock
     1580                 no-error
     1581                 .
     1582            IF AVAILABLE buf_user-login
     1583            THEN DO:
     1584               assign
     1585                  p-user-id = buf_user-login.user-id
     1586               .
     1587            END.
     1588      end.
     1589   end procedure.
     1590       run diasize_init in this-procedure .
     1591   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1592   do:
     1593     br-alcdoc :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1594   end.
     1595   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   on f5 of frame Dialog-Frame anywhere
     1597   do:
     1598     if available tt_alcdoc then     v-cur-recid = recid(tt_alcdoc).   run OpenBR in this-procedure.   reposition br-alcdoc to recid v-cur-recid no-error.   apply 'entry' to br-alcdoc in frame Dialog-Frame.
     1599       apply "VALUE-CHANGED" to br-alcdoc.
     1600   end.
     1601   MAIN-BLOCK:
     1602   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1603      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1604     find bf_trn-doc no-lock where recid(bf_trn-doc) = p-doc-recid no-error.
     1605     if not available bf_trn-doc then do:
     1606       message
     1607         vss-workfile vss-revision vss-description skip
     1608         "Ошибка задания входных параметров" skip
     1609         "Не найдена запись документа (trn-doc)" skip
     1610         view-as alert-box error .
     1611       return error return-value .
     1612     end.
     1613     fi-default-printer = session :printer-name.
     1614     run OpenBr.
     1615     RUN enable_UI.
     1616     apply "entry" to br-alcdoc in frame Dialog-Frame.
     1617     WAIT-FOR GO OF FRAME Dialog-Frame.
     1618   END.
     1619   RUN disable_UI.
     1620   PROCEDURE create-temp-table :
     1621     for each tt_alcdoc :
     1622       delete tt_alcdoc.
     1623     end.
     1624     for each bf_doc-line no-lock
     1625           where bf_doc-line.doc-code = bf_trn-doc.doc-code
     1626        ,each bf_parts
     1627           where bf_parts.obj-type  = bf_trn-doc.obj-type   and
     1628                 bf_parts.obj-code  = bf_trn-doc.obj-code   and
     1629                 bf_parts.prod-type = bf_doc-line.prod-type and
     1630                 bf_parts.prod-code = bf_doc-line.prod-code and
     1631                 bf_parts.artic     = bf_doc-line.artic     and
     1632                 bf_parts.out-code  = bf_trn-doc.doc-code
     1633       :
     1634       if bf_parts.alc-ref-ab-path <> '' then do:
     1635         find first tt_alcdoc
     1636           where tt_alcdoc.doc-type  = 1
     1637             and tt_alcdoc.file-name = bf_parts.alc-ref-ab-path
     1638           no-error.
     1639         if not available tt_alcdoc then do:
     1640           create tt_alcdoc.
     1641           assign
     1642             tt_alcdoc.selected  = yes
     1643             tt_alcdoc.doc-type  = 1
     1644             tt_alcdoc.doc-name  = "Справки А,Б"
     1645             tt_alcdoc.file-name = bf_parts.alc-ref-ab-path
     1646           .
     1647         end.
     1648       end.
     1649       if bf_parts.alc-quality-certif-path <> '' then do:
     1650         find first tt_alcdoc
     1651           where tt_alcdoc.doc-type  = 2
     1652             and tt_alcdoc.file-name = bf_parts.alc-quality-certif-path
     1653           no-error.
     1654         if not available tt_alcdoc then do:
     1655           create tt_alcdoc.
     1656           assign
     1657             tt_alcdoc.selected  = yes
     1658             tt_alcdoc.doc-type  = 2
     1659             tt_alcdoc.doc-name  = "Удостоверение качества"
     1660             tt_alcdoc.file-name = bf_parts.alc-quality-certif-path
     1661           .
     1662         end.
     1663       end.
     1664       if bf_parts.alc-certif-path <> '' then do:
     1665         find first tt_alcdoc
     1666           where tt_alcdoc.doc-type  = 3
     1667             and tt_alcdoc.file-name = bf_parts.alc-certif-path
     1668           no-error.
     1669         if not available tt_alcdoc then do:
     1670           create tt_alcdoc.
     1671           assign
     1672             tt_alcdoc.selected  = yes
     1673             tt_alcdoc.doc-type  = 3
     1674             tt_alcdoc.doc-name  = "Сертификат соответствия"
     1675             tt_alcdoc.file-name = bf_parts.alc-certif-path
     1676           .
     1677         end.
     1678       end.
     1679     end.
     1680   END PROCEDURE.
     1681   PROCEDURE disable_UI :
     1682     HIDE FRAME Dialog-Frame.
     1683   END PROCEDURE.
     1684   PROCEDURE enable_UI :
     1685     DISPLAY fi-default-printer
     1686         WITH FRAME Dialog-Frame.
     1687     ENABLE b-exit b-mark b-deselect b-print b-help br-alcdoc
     1688         WITH FRAME Dialog-Frame.
     1689     VIEW FRAME Dialog-Frame.
     1690   END PROCEDURE.
     1691   PROCEDURE OpenBR :
     1692     run create-temp-table.
     1693     open query br-alcdoc for each tt_alcdoc.
     1694   END PROCEDURE.
