      846     define buffer buf_temp-browse-handle  for temp-browse-handle .
      847     if p-change-value > 0
      848     then do:
      849       if frame Dialog-Frame :width + p-change-value >
      850           session :width-chars
      851       then do:
      852         assign
      853           p-change-value = session :width-chars - frame Dialog-Frame :width
      854         .
      855         if p-change-value <= 0
      856         then do:
      857           run diasize_position-resize-button in this-procedure .
      858           return .
      859         end.
      860       end.
      861     end.
      862     if p-change-value < 0
