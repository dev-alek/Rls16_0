      864       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      865       then do:
      866         assign
      867           p-change-value = v-diasize-orig-frame-width
      868                          - frame Dialog-Frame :width
      869         .
      870         if p-change-value >= 0
      871         then do:
      872           run diasize_position-resize-button in this-procedure .
      873           return .
      874         end.
      875       end.
      876     end.
      877     if p-change-value >= 0
      878     then do:
      879       assign
      880         v-change-sign = 1
      881       .
      882     end.
      883     else do:
      884       assign
      885         v-change-sign = -1
      886       .
      887     end.
      888     assign
      889       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      890     .
      891     if p-change-value = 0
      892     then do:
      893       run diasize_position-resize-button in this-procedure .
      894       return .
      895     end.
