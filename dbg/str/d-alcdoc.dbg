        1   define input parameter p-doc-recid as recid no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список сохраненных файлов в партиях алкогольной продукции".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable v-cur-recid as recid no-undo.
      112   define variable v-log       as logical no-undo.
      113   define buffer bf_trn-doc   for ub.trn-doc.
      114   define buffer bf_doc-line  for ub.doc-line.
      115   define buffer bf_parts     for ub.parts.
      116   define temp-table tt_alcdoc no-undo
      117     field selected  as logical
      118     field doc-type  as integer
      119     field doc-name  as character
      120     field file-name as character
      121     index ind1 is primary
      122       doc-type
      123       file-name
      124     .
      125   define buffer bf_tt_alcdoc for tt_alcdoc.
      126   define stream out-stream.
      127   DEFINE BUTTON b-deselect
      128        LABEL "&Снять *"
      129        SIZE 10 BY 1.
      130   DEFINE BUTTON b-exit AUTO-END-KEY
      131        LABEL "&Выход"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-help
      135        LABEL "Помо&щь":L
      136        SIZE 10 BY 1.
      137   DEFINE BUTTON b-mark
      138        LABEL "&*"
      139        SIZE 3 BY 1.
      140   DEFINE BUTTON b-print
      141        LABEL "Пе&чать"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE VARIABLE fi-default-printer AS CHARACTER FORMAT "X(256)":U
      145         VIEW-AS TEXT
      146        SIZE 82.5 BY .67
      147        FGCOLOR 4  NO-UNDO.
      148   DEFINE QUERY br-alcdoc FOR
      149         tt_alcdoc SCROLLING.
      150   DEFINE BROWSE br-alcdoc
      151     QUERY br-alcdoc DISPLAY
      152         tt_alcdoc.selected FORMAT "*/":U COLUMN-LABEL "*":U
      153         tt_alcdoc.doc-name FORMAT "x(30)":U COLUMN-LABEL "Тип документа"
      154         tt_alcdoc.file-name FORMAT "x(45)":U COLUMN-LABEL "Имя файла"
      155       WITH NO-ROW-MARKERS SEPARATORS SIZE 83.5 BY 16 EXPANDABLE.
      156   DEFINE FRAME Dialog-Frame
      157        b-exit AT ROW 1 COL 1.5
      158        b-mark AT ROW 1 COL 11.5
      159        b-deselect AT ROW 1 COL 14.5
      160        b-print AT ROW 1 COL 34.5
      161        b-help AT ROW 1 COL 75
      162        br-alcdoc AT ROW 2.33 COL 1.5
      163        fi-default-printer AT ROW 18.6 COL 1.5 NO-LABEL
      164        SPACE(1.29) SKIP(0.19)
      165       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      166            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      167            TITLE "Список сохраненных файлов для алкогольной продукции".
      168   ASSIGN
      169          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      170          FRAME Dialog-Frame:HIDDEN           = TRUE.
      171   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      172   DO:
      173     APPLY "END-ERROR":U TO SELF.
      174   END.
      175   ON CHOOSE OF b-deselect IN FRAME Dialog-Frame
      176   DO:
      177     for each bf_tt_alcdoc :
      178       bf_tt_alcdoc.selected = no.
      179     end.
      180     v-log = br-alcdoc:refresh() .
      181     apply "entry" to br-alcdoc .
      182   END.
      183   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      184   DO:
      185     if not available tt_alcdoc then
      186       return no-apply.
      187     assign
      188       tt_alcdoc.selected = not tt_alcdoc.selected
      189       .
      190     v-log = br-alcdoc:refresh() .
      191     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      192       v-log = br-alcdoc:select-next-row ().
      193       apply "value-changed" to br-alcdoc in frame Dialog-Frame.
      194     end.
      195     apply "entry" to br-alcdoc .
      196   END.
      197   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      198   DO:
      199     define variable lOK             as logical no-undo.
      200     define variable v-print-command as character no-undo.
      201     define variable v-full-filename as character no-undo.
      202     define variable v-exefile       as character no-undo.
      203     define variable v-inifile       as character no-undo.
      204     define variable v-batfile       as character no-undo.
      205     define variable v-printername   as character no-undo.
      206     define variable v-tempfile      as character no-undo.
      207     define variable v-list-codepage as character no-undo.
      208     find first bf_tt_alcdoc no-error.
      209     if not available bf_tt_alcdoc then
      210       return no-apply.
      211     find first bf_tt_alcdoc where bf_tt_alcdoc.selected = yes no-error.
      212     if not available bf_tt_alcdoc then do:
      213       message "Не выбраны документы для печати"
      214         view-as alert-box warning.
      215       apply "entry" to br-alcdoc.
      216       return no-apply.
      217     end.
      218     get-key-value section "AlcPrint":U key "ConStrPA":U value v-print-command .
      219     if v-print-command = ? then do:
      220       run gbl/getexini.p
      221         (output v-exefile
      222         ,output v-inifile
      223         ) no-error .
      224       message
      225         "Не задана командная строка для печати в *.ini файле" skip
      226         "*.ini файл " v-inifile skip
      227         "Секция: AlcPrint" skip
      228         "Ключ:   ConStrPA" skip
      229         view-as alert-box error.
      230       return no-apply.
      231     end.
      232     assign
      233       file-info:file-name = v-print-command
      234       v-batfile           = file-info:full-pathname
      235     .
      236     if v-batfile = ? then do:
      237       run gbl/getexini.p
      238         (output v-exefile
      239         ,output v-inifile
      240         ) no-error .
      241       message
      242         "Указанный командный файл для печати не найден" skip
      243         "*.ini файл " v-inifile skip
      244         "Секция: AlcPrint" skip
      245         "Ключ:   ConStrPA" skip
      246         "Строка:" v-print-command
      247         view-as alert-box error.
      248       return no-apply.
      249     end.
      250     get-key-value section "AlcPrint":U key "ListCodePage":U value v-list-codepage.
      251     if v-list-codepage = ? then v-list-codepage = "IBM866":U.
      252     message "Распечатать выбранные сопроводительные документы ?"
      253       view-as alert-box question buttons yes-no
      254       update lOK.
      255     if not lOK then do:
      256       apply "entry" to br-alcdoc.
      257       return no-apply.
      258     end.
      259     v-printername = string(session:printer-name).
      260     Print_Block:
      261     do on error undo, leave Print_Block :
      262       v-tempfile = "printpar.txt".
      263       output stream out-stream to value(v-tempfile)
      264              convert target v-list-codepage.
      265       File_Loop:
      266       for each bf_tt_alcdoc where bf_tt_alcdoc.selected = yes
      267             break by bf_tt_alcdoc.doc-type
      268                   by bf_tt_alcdoc.file-name
      269         :
      270         assign
      271           file-info:file-name = bf_tt_alcdoc.file-name
      272           v-full-filename     = file-info:full-pathname
      273         .
      274         if v-full-filename = ? then do:
      275           if last(bf_tt_alcdoc.file-name) then do:
      276             message "Файл '" + bf_tt_alcdoc.file-name +
      277                     "' не найден или недостаточно прав для его просмотра."
      278               view-as alert-box warning.
      279             leave File_Loop.
      280           end.
      281           else do:
      282             message "Файл '" + bf_tt_alcdoc.file-name +
      283                     "' не найден или недостаточно прав для его просмотра."
      284                     "Печатать остальные файлы ?"
      285               view-as alert-box warning buttons yes-no
      286               update lOK.
      287             if lOK then next File_Loop.
      288             else do:
      289               output stream out-stream close.
      290               leave Print_Block.
      291             end.
      292           end.
      293         end.
      294         put stream out-stream unformatted
      295           v-full-filename skip.
      296       end.
      297       output stream out-stream close.
      298       os-command no-wait value (substitute ('start /MIN &1 &2 &3',
      299                                             v-batfile, v-tempfile, v-printername
      300                                            )
      301                                ).
      302     end.
      303     apply "entry" to br-alcdoc.
      304   END.
      305   ON RETURN OF br-alcdoc IN FRAME Dialog-Frame
      306   or MOUSE-SELECT-DBLCLICK OF br-alcdoc IN FRAME Dialog-Frame
      307   DO:
      308     apply "choose" to b-mark in frame Dialog-Frame .
      309     return no-apply .
      310   END.
      311   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      312   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      313   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   on help of frame Dialog-Frame
      315   do:
      316     run gbl/app_help.p
      317       (input this-procedure :file-name
      318       ,input ''
      319       ,input ?
      320       ) no-error.
      321     if error-status :error then do:
      322       message
      323         "Ошибка при вызове помощи"
      324         error-status :get-message(1)
      325         view-as alert-box .
      326     end.
      327   end.
      328   run minbtn-set in this-procedure .
      329   on choose of b-help in frame Dialog-Frame
      330   do:
      331     apply "help":u to frame Dialog-Frame .
      332   end.
      333   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   procedure minbtn-set :
      335       do
      336           on error undo, return error return-value
      337           :
      338           define variable ii              as integer       no-undo .
      339           define variable fh              as widget-handle no-undo .
      340           define variable hh              as widget-handle no-undo .
      341           define variable v-h             as handle        extent 4 no-undo .
      342           define variable v-name-button   as character     no-undo .
      343           define variable v-help-old-x    as decimal       no-undo .
      344           define variable v-help-old-y    as decimal       no-undo .
      345           define variable v-help-old-size as decimal       no-undo .
      346           define variable v-frame-width   as decimal       no-undo .
      347           define variable jj              as integer       no-undo .
      348           do
      349               on error undo, return error
      350               :
      351               assign
      352                   v-frame-width = frame Dialog-Frame:width - 0.3
      353                   fh            = frame Dialog-Frame:first-child
      354                   hh            = fh:first-child
      355                   ii            = 1
      356                   .
      357               do while valid-handle(hh):
      358                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      359                   do:
      360                       case lc(hh:name) :
      361                           when "b-help" then
      362                               do:
      363                                   hh:load-image-up("cmp/b-help.bmp":u) .
      364                                   hh:load-image-down("cmp/b-help.bmp":u) .
      365                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      366                                   hh:TOOLTIP = "Помощь" .
      367                                   v-help-old-x = hh:column .
      368                                   v-help-old-y = hh:row    .
      369                                   v-help-old-size = hh:width .
      370                                   hh:width-chars = 2.5 .
      371                               end.
      372                           when "b-print" then
      373                               do:
      374                                   hh:load-image("cmp/b-print.bmp":u) .
      375                                   hh:TOOLTIP = "Печать" .
      376                                   v-h[ii] = hh:handle .
      377                                   ii = ii + 1 .
      378                                   hh:width-chars = 3 .
      379                               end.
      380                           when "b-history" or
      381                           when "b-hist" then
      382                               do:
      383                                   hh:load-image("cmp/b-hist.bmp":u) .
      384                                   hh:TOOLTIP = "История" .
      385                                   v-h[ii] = hh:handle .
      386                                   ii = ii + 1 .
      387                                   hh:width-chars = 3 .
      388                               end.
      389                           when "b-sch" then
      390                               do:
      391                                   hh:load-image("cmp/b-sch.bmp":u) .
      392                                   hh:TOOLTIP = "Установка Фильтра" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-hist-user" then
      398                               do:
      399                                   hh:load-image("cmp/b-hist.bmp":u) .
      400                                   hh:TOOLTIP = "История пользователя" .
      401                                   ii = ii + 1 .
      402                               end.
      403                       end case.
      404                   end.
      405                   hh = hh:next-sibling.
      406               end.
      407               b-help:column = v-frame-width - b-help:width-chars.
      408               jj = 0.
      409               repeat ii = 4 to 1 by -1 :
      410                   if valid-handle (v-h[ii] ) then
      411                   do:
      412                       jj  = jj + 1 .
      413                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      414                       v-h[ii]:row    = v-help-old-y .
      415                   end.
      416               end.
      417           end.
      418       end.
      419   end procedure.
      420   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      421   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      422   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      423   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      424   define variable v-diasize-current-frame-width  as decimal   no-undo .
      425   define variable v-diasize-current-frame-height as decimal   no-undo .
      426   define variable v-diasize-change-size          as logical   no-undo .
      427   define variable v-diasize-resize-button        as handle    no-undo .
      428   define variable v-diasize-wndmax               as logical   no-undo .
      429   define variable v-diasize-wndstore             as logical   no-undo .
      430   define variable v-diasize-proc-name            as character no-undo .
      431   define variable v-diasize-browse-handle        as handle    no-undo .
      432   define variable v-diasize-browse-number        as integer   no-undo .
      433   define variable v-diasize-need-full-display    as logical   no-undo init false .
      434   define temp-table temp-diasize-handle no-undo
      435     field handle-value  as handle
      436     field save-position as decimal
      437     index xpk is primary unique handle-value
      438     .
      439   define temp-table temp-browse-handle no-undo
      440     field browse-type   as character
      441     field browse-number as integer
      442     field browse-handle as handle
      443     field original-size as decimal
      444     index xpk is primary unique browse-type browse-number
      445     index xie browse-type browse-handle
      446   .
      447   procedure diasize_change-height :
      448     define input  parameter p-change-value  as decimal   no-undo .
      449     define input  parameter p-move-resize   as logical   no-undo .
      450     define variable v-field-group-handle    as handle    no-undo .
      451     define variable v-object-handle         as handle    no-undo .
      452     define variable v-frame-height          as decimal   no-undo .
      453     define variable v-frame-virtual-height  as decimal   no-undo .
      454     define variable v-browse-height         as decimal   no-undo .
      455     define variable v-window-height         as decimal   no-undo .
      456     define variable v-window-virtual-height as decimal   no-undo .
      457     define variable v-change-sign           as integer   no-undo .
      458     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      459     define buffer buf_temp-browse-handle  for temp-browse-handle .
      460     if p-change-value > 0
      461     then do:
      462       if frame Dialog-Frame :height + p-change-value
      463           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      464       then do:
      465         assign
      466           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      467                           - (frame Dialog-Frame :height-chars)
      468         .
      469         if p-change-value <= 0
      470         then do:
      471           run diasize_position-resize-button in this-procedure .
      472           return .
      473         end.
      474       end.
      475     end.
      476     if p-change-value < 0
      477     then do:
      478       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      479       then do:
      480         assign
      481           p-change-value = v-diasize-orig-frame-height
      482                          - (frame Dialog-Frame :height-chars)
      483         .
      484         if p-change-value >= 0
      485         then do:
      486           run diasize_position-resize-button in this-procedure .
      487           return .
      488         end.
      489       end.
      490     end.
      491     if p-change-value >= 0
      492     then do:
      493       assign
      494         v-change-sign = 1
      495       .
      496     end.
      497     else do:
      498       assign
      499         v-change-sign = -1
      500       .
      501     end.
      502     assign
      503       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      504     .
      505     if p-change-value = 0
      506     then do:
      507       run diasize_position-resize-button in this-procedure .
      508       return .
      509     end.
      510     move_block:
      511     do
      512     on error undo move_block, retry move_block
      513     :
      514       if retry
      515       then do:
      516         do
      517         on error undo move_block, leave move_block
      518         :
      519           if p-change-value > 0
      520           then do:
      521             for each buf_temp-diasize-handle
      522             on error undo, next
      523             :
      524               assign
      525                 v-object-handle = buf_temp-diasize-handle.handle-value
      526               .
      527               if v-object-handle <> v-diasize-resize-button
      528               then do:
      529                 assign
      530                   v-object-handle :row = buf_temp-diasize-handle.save-position
      531                 .
      532               end.
      533             end.
      534             assign
      535               v-diasize-browse-handle :height = v-browse-height
      536             .
      537             for each buf_temp-browse-handle
      538               where buf_temp-browse-handle.browse-type = 'height':u
      539             on error undo, next
      540             :
      541               assign
      542                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      543               .
      544             end.
      545             assign
      546               frame Dialog-Frame :height = v-frame-height
      547             .
      548             if frame Dialog-Frame :scrollable = true
      549             then do:
      550               assign
      551                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      552               .
      553             end.
