        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Библиотека для работы с атрибутами для резервуаров".
        9   do:
       10     this-proc-hndl = this-procedure.
       11   end.
       12   procedure placelib_write-attr:
       13   define input  parameter p-code     like ub.place-attr.attr-code .
       14   define input  parameter p-obj-code like ub.place-attr.obj-code .
       15   define input  parameter p-obj-type like ub.place-attr.obj-type .
       16   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       17   define input  parameter p-value    like ub.place-attr.attr-value .
       18   define output parameter p-ok       as logical.
       19   define buffer buf_place-attr for ub.place-attr .
       20     do on error undo, return error return-value :
       21        p-ok = false.
       22        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       23                                                   and buf_place-attr.obj-code    = p-obj-code
       24                                                   and buf_place-attr.obj-type    = p-obj-type
       25                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       26        if not available buf_place-attr then do :
       27           create buf_place-attr.
       28           assign
       29             buf_place-attr.attr-code   = p-code
       30             buf_place-attr.attr-value  = p-value
       31             buf_place-attr.obj-code    = p-obj-code
       32             buf_place-attr.obj-type    = p-obj-type
       33             buf_place-attr.pl-code     = p-pl-code
       34           .
       35           p-ok = true.
       36        end.
       37        else do:
       38           buf_place-attr.attr-value  = p-value .
       39           p-ok = true.
       40        end.
       41     end.
       42   end.
       43   procedure placelib_get-attr:
       44   define input  parameter  p-code     like ub.place-attr.attr-code .
       45   define input  parameter  p-obj-code like ub.place-attr.obj-code .
       46   define input  parameter  p-obj-type like ub.place-attr.obj-type .
       47   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
       48   define output parameter  p-value    like ub.place-attr.attr-value .
       49   define output parameter  p-ok       as logical.
       50   define buffer buf_place-attr for ub.place-attr .
       51     do on error undo, return error return-value :
       52        p-ok = false.
       53        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
       54                                                   and buf_place-attr.obj-code    = p-obj-code
       55                                                   and buf_place-attr.obj-type    = p-obj-type
       56                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       57        if available buf_place-attr then do :
       58          p-value = buf_place-attr.attr-value.
       59          p-ok = true.
       60        end.
       61        else do :
       62          p-ok = false.
       63        end.
       64     end.
       65   end.
       66   procedure placelib_del-attr:
       67   define input parameter  p-code     like ub.place-attr.attr-code .
       68   define input parameter  p-obj-code like ub.place-attr.obj-code .
       69   define input parameter  p-obj-type like ub.place-attr.obj-type .
       70   define input parameter  p-pl-code  like ub.place-attr.pl-code .
       71   define input parameter  p-value    like ub.place-attr.attr-value .
       72   define output parameter p-ok       as logical.
       73   define buffer buf_place-attr for ub.place-attr .
       74     do on error undo, return error return-value :
       75        p-ok = false.
       76        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       77                                                   and buf_place-attr.obj-code    = p-obj-code
       78                                                   and buf_place-attr.obj-type    = p-obj-type
       79                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       80        if available buf_place-attr then do :
       81           delete buf_place-attr.
       82           p-ok = true.
       83        end.
       84     end.
       85   end.
