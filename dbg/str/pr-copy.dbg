     1060   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1062   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1064   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1065   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1066   ASSIGN
     1067      v-S_CONTRACT                = "Contract":U
     1068      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1069      v-DELIM_CHR_3               = ","
     1070      .
     1071   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1072   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1073   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1074   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1075      INPUT iHost-Code    AS INTEGER,
     1076      INPUT iContract-Num AS INTEGER,
     1077      INPUT iGds-Code     AS INTEGER ):
     1078      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1079      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1080      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1081      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1082      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1083      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1084          INPUT  iHost-Code,
     1085          INPUT  iContract-Num,
     1086          OUTPUT iTmp-Extent3
     1087          ).
     1088      IF iTmp-Extent3[1] = 2 THEN DO:
     1089         ASSIGN
     1090            iTmp-Host-Code      = iTmp-Extent3[2]
     1091            iTmp-Contract-Num   = iTmp-Extent3[3]
     1092            .
     1093      END. ELSE DO:
     1094         ASSIGN
     1095            iTmp-Host-Code      = iHost-Code
     1096            iTmp-Contract-Num   = iContract-Num
     1097            .
     1098      END.
     1099      IF iGds-Code = ? THEN DO:
     1100         ASSIGN
     1101            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1102                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1103                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1104                           ).
     1105      END. ELSE DO:
     1106            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1107                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1108                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1109                              AND buf_Spec.Gds-Code      = iGds-Code
     1110                            ).
     1111      END.
     1112      RETURN (lRet).
     1113   END FUNCTION.
     1114   PROCEDURE MS-Contract-EXTENT-3:
     1115      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1116      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1117      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1118      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1119      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1120      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1121      FIND FIRST buf_Cont-2 WHERE
     1122                 buf_Cont-2.Host-Code      = i-Host-Code
     1123             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1124           NO-LOCK NO-ERROR.
     1125      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1126         RETURN.
     1127      END.
     1128      FOR FIRST buf_Ext-Classif WHERE
     1129                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1130           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1131                                               STRING(i-Contract-code)
     1132           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1133          NO-LOCK,
     1134          EACH buf_Cont WHERE
     1135               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1136           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1137          NO-LOCK:
     1138          ASSIGN
     1139             i-Ret[1] = 1
     1140             i-Ret[2] = buf_Cont.Host-code
     1141             i-Ret[3] = buf_Cont.Contract-code
     1142             .
     1143          LEAVE.
     1144      END.
     1145      IF i-Ret[1] <> 1 THEN DO:
     1146         FOR FIRST buf_Ext-Classif WHERE
     1147                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1148              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1149                                                  STRING(i-Contract-code)
     1150              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1151             NO-LOCK,
     1152             EACH buf_Cont WHERE
     1153                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1154              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1155             NO-LOCK:
     1156             ASSIGN
     1157                i-Ret[1] = 2
     1158                i-Ret[2] = buf_Cont.Host-code
     1159                i-Ret[3] = buf_Cont.Contract-code
     1160                .
     1161             LEAVE.
     1162         END.
     1163      END.
     1164      RETURN.
     1165   END PROCEDURE.
