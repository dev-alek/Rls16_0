     1670      .
     1671   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1673     (input  ?
     1674     ,input  l-type
     1675     ,input  l-code
     1676     ,output par-pr-nakl-ie
     1677     ,output par-pr-nakl-iv
     1678     ,output par-pr-nakl-im
     1679     ) no-error .
     1680      define variable ii as integer   no-undo .
     1681      define variable nn as integer   no-undo .
     1682      define variable v-fullname as character no-undo .
     1683      nn = num-entries ( par-pr-nogds ).
     1684      par-pr-nogds-long = "".
     1685      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1686         repeat ii = 1 to nn :
     1687           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1688           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1689         end.
     1690         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1691      end.
     1692   l-par = true .
     1693   end procedure.
     1694   PROCEDURE cre-pr-list:
     1695   define input  parameter bc      like ub.price-list.b-code no-undo.
     1696   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1697   define output parameter new-rec as recid             no-undo.
     1698   define buffer buf-price-list for ub.price-list.
     1699   define buffer buf-price-doc  for ub.price-doc.
     1700   define buffer buf-bar-code   for ub.bar-code.
     1701   define buffer buf-goods      for ub.goods.
     1702   define buffer buf-gds-prt    for ub.gds-prt.
     1703   define buffer root-gds-prt   for ub.gds-prt.
     1704   define variable cur-pr like ub.price-list.price-sale no-undo.
     1705   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1706   define variable cur-ex like ub.price-list.excise     no-undo.
     1707   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1708   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1709   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1710   define variable cur-rt-base as decimal no-undo .
     1711   define variable cur-rt-rubl as decimal no-undo .
     1712   define variable p-hostcode as int no-undo .
     1713   define variable v-line-num as integer no-undo .
     1714   define variable v-skip-del-gds as logical no-undo initial no .
     1715   cre-pr:
     1716   do on error undo cre-pr, return error:
     1717     find  buf-bar-code no-lock where
     1718           buf-bar-code.b-code = bc.
     1719     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1720     if error-status :error then do:
     1721       message
     1722         return-value skip
     1723         "Ошибка !"
     1724         view-as alert-box error
     1725       .
     1726       undo cre-pr, return.
     1727     end.
     1728     find  buf-goods no-lock where
     1729           buf-goods.gds-code = buf-bar-code.gds-code.
     1730     find first root-gds-prt no-lock where
     1731               root-gds-prt.upper-code = buf-goods.prt-root.
     1732     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1733       buf-bar-code.in-code <> "" then do:
     1734       message
     1735         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1736         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1737         view-as alert-box error.
     1738       undo cre-pr, return.
     1739     end.
     1740     find  buf-gds-prt no-lock where
     1741           buf-gds-prt.node-code = buf-bar-code.node-code.
     1742     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1743       message
     1744         "Не допускается создавать цены на удаленные товары!" skip (2)
     1745         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1746         view-as alert-box error.
     1747       undo cre-pr, return.
     1748     end.
     1749     find  buf-price-doc where
     1750           buf-price-doc.doc-num = new-num.
     1751   define variable v-ret as logical no-undo .
     1752      run ver-modificator-price-is-null (
     1753             input    buf-goods.artic        ,
     1754             input    buf-goods.prod-type    ,
     1755             input    buf-goods.prod-code    ,
     1756             input    buf-price-doc.obj-type   ,
     1757             input    buf-price-doc.obj-code   ,
     1758             output   v-ret ).
     1759         if v-ret = false then dO:
     1760             message
     1761               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1762               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1763               view-as alert-box error.
     1764             undo cre-pr, return.
     1765           end.
     1766   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1768     (input  buf-price-doc.obj-type
     1769     ,input  buf-price-doc.obj-code
     1770     ,output p-hostcode
     1771     ) no-error .
     1772   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1774     (input  buf-goods.gds-code
     1775     ,input  '1':U
     1776     ,input  ?
     1777     ,input  p-hostcode
     1778     ,input  buf-price-doc.obj-type
     1779     ,input  buf-price-doc.obj-code
     1780     ,output local_vat-pc
     1781     ) no-error .
     1782   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1784     (input  buf-goods.gds-code
     1785     ,input  '2':U
     1786     ,input  ?
     1787     ,input  p-hostcode
     1788     ,input  buf-price-doc.obj-type
     1789     ,input  buf-price-doc.obj-code
     1790     ,output local_slt-pc
     1791     ) no-error .
     1792   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1794     (input  buf-price-doc.obj-type
     1795     ,input  buf-price-doc.obj-code
     1796     ,input  bc
     1797     ,input  0
     1798     ,input  0
     1799     ,output cur-dn
     1800     ,output cur-pr
     1801     ,output cur-rt
     1802     ,output cur-ex
     1803     ) no-error .
     1804     find first buf-price-list where
     1805               buf-price-list.b-code  = buf-bar-code.b-code and
     1806               buf-price-list.doc-num = new-num  and
     1807               buf-price-list.price-type = ""    no-error .
     1808     if not available buf-price-list then do:
     1809       run calc-price-line-num (input  new-num , output v-line-num) .
     1810       create buf-price-list.
     1811       assign
     1812         buf-price-list.line-num  = v-line-num
     1813         buf-price-list.b-code    = buf-bar-code.b-code
     1814         buf-price-list.doc-num   = buf-price-doc.doc-num
     1815         buf-price-list.prod-type = buf-goods.prod-type
     1816         buf-price-list.prod-code = buf-goods.prod-code
     1817         buf-price-list.artic     = buf-goods.artic
     1818         buf-price-list.obj-type  = buf-price-doc.obj-type
     1819         buf-price-list.obj-code  = buf-price-doc.obj-code
     1820         buf-price-list.vat-pc    = local_vat-pc
     1821         buf-price-list.slt-pc    = local_slt-pc
     1822         buf-price-list.price-prev = cur-pr
     1823         .
     1824       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1825           buf-bar-code.in-code   = "" and
     1826           buf-bar-code.part-code = "" and
     1827           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1828         buf-price-list.main-price = yes.
     1829         if cur-pr <> ? then do:
     1830           run exp-prt (input buf-goods.gds-code,
     1831                       input cur-dn,
     1832                       input new-num,
     1833                       output new-rec) no-error.
     1834           if error-status :error then do:
     1835             message
     1836               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1837               view-as alert-box error.
     1838             undo cre-pr, return error.
     1839           end.
     1840         end.
     1841       end.
     1842       else do:
     1843         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1844           buf-price-list.d-pcnt = ?.
     1845         end.
     1846         buf-price-list.main-price = no.
     1847       end.
     1848     end.
     1849   end.
     1850   new-rec = recid (buf-price-list).
     1851   END PROCEDURE.
     1852   procedure calc-price-line-num :
     1853    do
     1854    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1855    :
     1856   define input parameter p-doc-num as character no-undo .
     1857   define output parameter p-num  as integer no-undo .
     1858   define variable v-fact as integer no-undo .
     1859   define buffer buf_1_price-list for ub.price-list .
     1860   p-num = 1 .
     1861   find last  buf_1_price-list no-lock where
     1862              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     1863              if available buf_1_price-list then
     1864                   assign
     1865                     v-fact = buf_1_price-list.line-num
     1866                   .
     1867   v-fact = v-fact + 1.
     1868   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     1869    end.
     1870   end procedure.
     1871   PROCEDURE del-pr-list:
     1872   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1873   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1874   define input parameter round-method as character         no-undo.
     1875   define input parameter round-base   as decimal      no-undo.
     1876   define buffer buf-price-list for ub.price-list.
     1877   define buffer buf-bar-code   for ub.bar-code.
     1878   define buffer buf-goods      for ub.goods.
     1879   define variable l-ov-on as logical no-undo .
     1880   del-pr:
     1881   do on error undo del-pr, return error:
     1882     find first  buf-price-list no-lock where
     1883                 buf-price-list.doc-num    = d-num and
     1884                 buf-price-list.b-code     = bc and
     1885                 buf-price-list.price-type = "" no-error.
     1886     if not available buf-price-list then
     1887       undo del-pr, return error.
     1888     find  buf-goods no-lock where
     1889           buf-goods.prod-type = buf-price-list.prod-type and
     1890           buf-goods.prod-code = buf-price-list.prod-code and
     1891           buf-goods.artic     = buf-price-list.artic.
     1892     if buf-price-list.main-price then do:
     1893       for each  buf-price-list exclusive-lock where
     1894                 buf-price-list.doc-num   = d-num and
     1895                 buf-price-list.artic     = buf-goods.artic and
     1896                 buf-price-list.prod-type = buf-goods.prod-type and
     1897                 buf-price-list.prod-code = buf-goods.prod-code,
     1898           first buf-bar-code no-lock where
     1899                 buf-bar-code.b-code = buf-price-list.b-code
     1900       on error undo del-pr, return error:
     1901   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1902   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1903     (input  ub.buf-price-list.obj-type
     1904     ,input  ub.buf-price-list.obj-code
     1905     ,input  ub.buf-price-list.artic
     1906     ,input  ub.buf-price-list.prod-type
     1907     ,input  ub.buf-price-list.prod-code
     1908     ,input  'ov-on=request:exclusive'
     1909     ,output l-ov-on
     1910     ) no-error .
     1911         if error-status:error then do:
     1912           message
     1913             vss-workfile vss-revision vss-description skip
     1914             "Ошибка получения признака товара на объекте" skip
     1915             error-status :get-message(1) skip
     1916             return-value skip
     1917             view-as alert-box error .
     1918         end.
     1919         if l-ov-on then do:
     1920   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1922     (input  ub.buf-price-list.obj-type
     1923     ,input  ub.buf-price-list.obj-code
     1924     ,input  ub.buf-price-list.artic
     1925     ,input  ub.buf-price-list.prod-type
     1926     ,input  ub.buf-price-list.prod-code
     1927     ,input  'ov-on=false'
     1928     ,output l-ov-on
     1929     ) no-error .
     1930           if error-status :error then do:
     1931           end.
     1932          end.
     1933         delete buf-price-list.
     1934       end.
     1935     end.
     1936     else do:
     1937       find  buf-bar-code no-lock where
     1938             buf-bar-code.b-code = buf-price-list.b-code.
     1939       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1940         message
     1941           "Нельзя удалить неосновную цену." skip
     1942           "Неосновная цена (скидка) не может быть неопределенной." skip
     1943           "Код:" bc skip
     1944           "Переоценка:" d-num
     1945           view-as alert-box error.
     1946         undo del-pr, return error.
     1947       end.
     1948       find current buf-price-list exclusive-lock no-error .
     1949       delete buf-price-list.
     1950       run calc-base-upd (input buf-bar-code.b-code,
     1951                         input d-num,
     1952                         input round-method,
     1953                         input round-base) no-error.
     1954       if error-status :error then
     1955         undo del-pr, return error.
     1956     end.
     1957   end.
     1958   END PROCEDURE.
     1959   PROCEDURE calc-base-upd:
     1960   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1961   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1962   define input parameter round-method as character         no-undo.
     1963   define input parameter round-base   as decimal      no-undo.
     1964   define buffer alt-bar-code   for ub.bar-code.
     1965   define buffer alt-price-list for ub.price-list.
     1966   define buffer buf-bar-code   for ub.bar-code.
     1967   define buffer buf-goods      for ub.goods.
     1968   calc-base:
     1969   do on error undo calc-base, return error:
     1970     find  buf-bar-code no-lock where
     1971           buf-bar-code.b-code = bc.
     1972     find  buf-goods no-lock where
     1973           buf-goods.gds-code = buf-bar-code.gds-code.
     1974     for each  alt-bar-code no-lock where
     1975               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     1976               alt-bar-code.node-code = buf-bar-code.node-code and
     1977               alt-bar-code.part-code = buf-bar-code.part-code and
     1978               alt-bar-code.in-code   = buf-bar-code.in-code and
     1979               alt-bar-code.unit-cli <> buf-goods.unit-base,
     1980         each  alt-price-list where
     1981               alt-price-list.doc-num    = d-num and
     1982               alt-price-list.b-code     = alt-bar-code.b-code and
     1983               alt-price-list.price-type = ""
     1984         on error undo calc-base, return error:
     1985       run calc-pr-alt (input d-num,
     1986                       input alt-bar-code.b-code,
     1987                       input round-method,
     1988                       input round-base) no-error.
     1989       if error-status:error then
     1990         undo calc-base, return error.
     1991     end.
     1992   end.
     1993   END PROCEDURE.
     1994   PROCEDURE calc-pr-alt:
     1995   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1996   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1997   define input parameter r-method as character             no-undo.
     1998   define input parameter r-base   as decimal              no-undo.
     1999   define buffer buf-price-doc  for ub.price-doc.
     2000   define buffer buf-price-list for ub.price-list.
     2001   define buffer buf-bar-code   for ub.bar-code.
     2002   define buffer buf-goods      for ub.goods.
     2003   define buffer old-price-list for ub.price-list.
     2004   define variable pr-rec   as   recid                  no-undo.
     2005   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2006   pr-alt:
     2007   do on error undo pr-alt, return error:
     2008     if r-method = ? or
     2009        r-base = ? then do:
     2010       message
     2011         "Нельзя удалить основную цену." skip
     2012         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2013         "Код:" bc skip
     2014         "Переоценка:" d-num
     2015         view-as alert-box error.
     2016       undo pr-alt, return error.
     2017     end.
     2018     find  buf-price-doc where
     2019           buf-price-doc.doc-num = d-num.
     2020     find  buf-bar-code no-lock where
     2021           buf-bar-code.b-code = bc.
     2022     find  buf-goods no-lock where
     2023           buf-goods.gds-code = buf-bar-code.gds-code.
     2024     find  buf-price-list where
     2025           buf-price-list.doc-num = buf-price-doc.doc-num and
     2026           buf-price-list.b-code  = bc.
     2027     if buf-price-list.d-pcnt = ? then do:
     2028   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2030     (input  buf-price-doc.obj-type
     2031     ,input  buf-price-doc.obj-code
     2032     ,input  bc
     2033     ,input  0
     2034     ,input  0
     2035     ,output pr-rec
     2036     ,output pr-c-b-r
     2037     )  .
     2038       find old-price-list no-lock where
     2039           recid (old-price-list) = pr-rec no-error.
     2040       if available old-price-list and
     2041         old-price-list.b-code = bc then
     2042         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2043       else
     2044         buf-price-list.d-pcnt = 0.
     2045     end.
     2046      if buf-price-list.d-pcnt = ? then do:
     2047         assign
     2048           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2049           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2050           .
     2051     end.
     2052     else do:
     2053         assign
     2054           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2055                                         buf-bar-code.cli-base-rate *
     2056                                         (1 - buf-price-list.d-pcnt / 100)
     2057           buf-price-list.calc-method =  'Основная':U
     2058           .
     2059   case r-method :
     2060     when '9-окончание':U then do:
     2061       if buf-price-list.price-sale < 29 then do:
     2062         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2063           assign
     2064             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2065           .
     2066         end.
     2067       end.
     2068       else do:
     2069         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2070           assign
     2071             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2072                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2073                   - 1 ) * 10
     2074                 + 9
     2075           .
     2076         end.
     2077         else do:
     2078           assign
     2079             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2080                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2081                   ) * 10
     2082                 + 9
     2083           .
     2084         end.
     2085         assign
     2086           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2087         .
     2088       end.
     2089     end.
     2090     when '9-99окончание':U then do:
     2091       if buf-price-list.price-sale < r-base then do:
     2092         assign
     2093           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2094         .
     2095       end.
     2096       else do:
     2097         assign
     2098           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2099         .
     2100       end.
     2101     end.
     2102     when 'Без-дробных':U then do:
     2103       assign
     2104         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2105       .
     2106     end.
     2107     when 'Произвольно':U then do:
     2108       if r-base <> 0 then do:
     2109         assign
     2110           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2111         .
     2112         if buf-price-list.price-sale = 0 then do:
     2113           assign
     2114             buf-price-list.price-sale = r-base
     2115           .
     2116         end.
     2117       end.
     2118     end.
     2119     when 'Вверх':U then do:
     2120       if r-base <> 0 then do:
     2121         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2122           assign
     2123             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2124           .
     2125         end.
     2126       end.
     2127       if buf-price-list.price-sale = 0 then do:
     2128         assign
     2129           buf-price-list.price-sale = r-base
     2130         .
     2131       end.
     2132     end.
     2133     when 'Коэффициент':U then do:
     2134       if r-base <> 0 then do:
     2135         assign
     2136           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2137         .
     2138       end.
     2139     end.
     2140     when 'Отключено':U then do:
     2141     end.
     2142     otherwise do:
     2143       message
     2144         vss-workfile vss-revision vss-description skip
     2145         "Неизвестный метод округления продажной цены" skip
     2146         "round-method" r-method skip
     2147         "round-base"   r-base   skip
     2148         "price"        buf-price-list.price-sale             skip
     2149         view-as alert-box error .
     2150     end.
     2151   end.
     2152     end.
     2153   end.
     2154   END PROCEDURE.
     2155   PROCEDURE calc-pr-discnt:
     2156   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2157   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2158   define buffer buf-price-doc  for ub.price-doc.
     2159   define buffer buf-price-list for ub.price-list.
     2160   define buffer buf-bar-code   for ub.bar-code.
     2161   define buffer buf-goods      for ub.goods.
     2162   define buffer old-price-list for ub.price-list.
     2163   define variable pr-rec   as   recid                  no-undo.
     2164   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2165   pr-discnt:
     2166   do on error undo pr-discnt, return error:
     2167     find  buf-price-doc where
     2168           buf-price-doc.doc-num = d-num.
     2169     find  buf-bar-code no-lock where
     2170           buf-bar-code.b-code = bc.
     2171     find  buf-goods no-lock where
     2172           buf-goods.gds-code = buf-bar-code.gds-code.
     2173     find  buf-price-list where
     2174           buf-price-list.doc-num = buf-price-doc.doc-num and
     2175           buf-price-list.b-code  = bc.
     2176     buf-price-list.d-pcnt = (1 -
     2177                              buf-price-list.price-sale /
     2178                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2179                              buf-bar-code.cli-base-rate) *
     2180                              100
     2181                              .
     2182   end.
     2183   END PROCEDURE.
     2184   PROCEDURE calc-pr-sub :
     2185   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2186   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2187   define  input  parameter calc-method  as character    no-undo.
     2188   define  input  parameter increase-pc  as decimal      no-undo.
     2189   define  input  parameter round-method as character    no-undo.
     2190   define  input  parameter round-base   as decimal      no-undo.
     2191   define  output parameter calc-rec     as recid        no-undo.
     2192   define  buffer buf-price-list for ub.price-list.
     2193   define  buffer buf-bar-code   for ub.bar-code.
     2194   define  buffer buf-goods      for ub.goods.
     2195   define  buffer buf-gds-prt    for ub.gds-prt.
     2196   define  buffer buf-gds-grp    for ub.gds-grp.
     2197   define  buffer buf-price-doc  for ub.price-doc.
     2198   calc-sub:
     2199   do on error undo calc-sub, return error:
     2200     find  buf-bar-code no-lock where
     2201           buf-bar-code.b-code = bc.
     2202     find  buf-goods no-lock where
     2203           buf-goods.gds-code = buf-bar-code.gds-code.
     2204     find  buf-gds-prt no-lock where
     2205           buf-gds-prt.node-code = buf-bar-code.node-code.
     2206     find  buf-price-list where
     2207           buf-price-list.doc-num    = d-num and
     2208           buf-price-list.b-code     = bc and
     2209           buf-price-list.price-type = "".
     2210     find  buf-price-doc where
     2211           buf-price-doc.doc-num = d-num.
     2212     calc-rec = recid (buf-price-list).
     2213     if buf-price-list.main-price then do:
     2214       for each  buf-price-list where
     2215                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2216                 buf-price-list.main-price = no and
     2217                 buf-price-list.artic      = buf-goods.artic and
     2218                 buf-price-list.prod-type  = buf-goods.prod-type and
     2219                 buf-price-list.prod-code  = buf-goods.prod-code,
     2220           first buf-bar-code no-lock where
     2221                 buf-bar-code.b-code   = buf-price-list.b-code and
     2222                 buf-bar-code.unit-cli = buf-goods.unit-base
     2223           on error undo calc-sub, return error:
     2224         run calc-pr-list (input  buf-bar-code.b-code,
     2225                           input  buf-price-list.doc-num,
     2226                           input  calc-method,
     2227                           input  increase-pc,
     2228                           input  round-method,
     2229                           input  round-base,
     2230                           input ? ,
     2231                           input ? ,
     2232                           input ? ,
     2233                           input ? ,
     2234                           output calc-rec) no-error.
     2235         if error-status :error then
     2236           undo calc-sub, return error.
     2237         calc-rec = recid (buf-price-list).
     2238       end.
     2239       for each  buf-price-list where
     2240                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2241                 buf-price-list.main-price = no and
     2242                 buf-price-list.artic      = buf-goods.artic and
     2243                 buf-price-list.prod-type  = buf-goods.prod-type and
     2244                 buf-price-list.prod-code  = buf-goods.prod-code,
     2245           first buf-bar-code no-lock where
     2246                 buf-bar-code.b-code    = buf-price-list.b-code and
     2247                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2248           on error undo calc-sub, return error:
     2249         run calc-pr-alt (input buf-price-doc.doc-num,
     2250                         input buf-bar-code.b-code,
     2251                         input round-method,
     2252                         input round-base) no-error.
     2253         if error-status :error then
     2254           undo calc-sub, return error.
     2255       end.
     2256     end.
     2257     else do:
     2258       run calc-base-upd (input buf-bar-code.b-code,
     2259                         input buf-price-doc.doc-num,
     2260                         input round-method,
     2261                         input round-base) no-error.
     2262       if error-status :error then
     2263         undo calc-sub, return error.
     2264     end.
     2265   end.
     2266   END PROCEDURE.
     2267   procedure ver-pr-nogds :
     2268   define input  parameter p-gds-code      as integer   no-undo .
     2269   define input  parameter p-par-pr-nogds  as character no-undo .
     2270   define output parameter p-not           as logical   no-undo .
     2271   define output parameter p-str           as character no-undo .
     2272   define buffer buf_goods for ub.goods  .
     2273   define variable nn as integer   no-undo .
     2274   define variable ii as integer   no-undo .
     2275   define variable v-namegrp as character no-undo .
     2276     do
     2277     on error undo, return error return-value
     2278     :
     2279     if p-par-pr-nogds = "1" then do:
     2280        assign
     2281         p-not = true
     2282         p-str = ""
     2283        .
     2284        return .
     2285     end.
     2286     assign
     2287       p-not = false
     2288       p-str = ""
     2289     .
     2290     find first buf_goods no-lock where
     2291                buf_goods.gds-code = p-gds-code no-error .
     2292     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2293     repeat ii = 1 to nn:
     2294        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2295        if buf_goods.grp-name  begins v-namegrp  then do:
     2296           assign
     2297             p-not = true
     2298             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2299           .
     2300           leave .
     2301        end.
     2302     end.
     2303     end.
     2304   end procedure.
     2305   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2306   procedure ver-modificator-price-is-null :
     2307    do
     2308    on error undo, return error return-value
     2309    :
     2310   define input parameter p-artic     like ub.goods.artic no-undo.
     2311   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     2312   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     2313   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     2314   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     2315   define output parameter p-ret as logical no-undo .
     2316   define variable v-gds-code  like ub.goods.gds-code no-undo .
     2317   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2318   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2320     (input  p-artic
     2321     ,input  p-prod-type
     2322     ,input  p-prod-code
     2323     ,output v-gds-code
     2324     )  .
     2325   p-ret = true .
     2326   find first buf_fbr-gds-obj no-lock where
     2327               buf_fbr-gds-obj.gds-code = v-gds-code and
     2328               buf_fbr-gds-obj.obj-code = p-obj-code and
     2329               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
     2330    if available buf_fbr-gds-obj then
     2331                 if buf_fbr-gds-obj.is-modificator = true and
     2332                    buf_fbr-gds-obj.is-null-price = true
     2333                    then  p-ret = false .
     2334    end.
     2335   end procedure.
     2336   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2337   procedure doc-code:
     2338   define input  parameter parmode          as   character           no-undo.
     2339   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2340   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2341   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2342   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2343   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2344   define variable vardb-remote     as   logical             no-undo.
     2345   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2346   define variable v-delimiter as character no-undo .
     2347   do
     2348   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2349   :
     2350   find first buf_sys-ctrl no-lock .
     2351   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2352     CASE parmode:
     2353       when "main":u then do:
     2354         if vardb-remote then do:
     2355           assign
     2356             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2357         end.
     2358         else do:
     2359           assign
     2360             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2361         end.
     2362       end.
     2363       when "trio" then do:
     2364         assign
     2365           pardoc-code = replace (parroot-doc-code, "=", "*").
     2366       end.
     2367       otherwise do:
     2368         assign
     2369         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2370         no-error
     2371         .
     2372         if error-status:error  then do:
     2373           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2374                                         ,chr(10)
     2375                                         ,parmode
     2376                                         ).
     2377         end.
     2378         if num-entries(parmode) = 1
     2379         and parmode <> "chip":U
     2380         and parmode <> "chip_s":U
     2381         then do:
     2382           assign
     2383           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2384         end.
     2385         else if (lookup("chip":U, parmode) > 0
     2386                  or
     2387                  lookup("chip_s":U, parmode) > 0) then do:
     2388           assign
     2389             vartemp-doc-code = parroot-doc-code.
     2390           do while true:
     2391             if index (vartemp-doc-code , ".") = 0 then
     2392               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2393             else
     2394               vartemp-doc-code  =
     2395               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2396               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2397               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2398             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2399           end.
     2400           assign
     2401             pardoc-code = vartemp-doc-code.
     2402         end.
     2403       end.
     2404     end CASE.
     2405     if pardoc-code = '':U
     2406     or (parroot-doc-code <> '':U
     2407     and pardoc-code = parroot-doc-code) then do:
     2408       undo, return error substitute("Ошибка при генерации номера документа&1"
     2409                                     ,chr(10)).
     2410     end.
     2411   end.
     2412   end. // procedure/method
     2413   function get-doc-code-int64 returns int64
     2414     ( input p-doc-code as character ) :
     2415     define variable v-ind              as integer   no-undo .
     2416     define variable v-num-entries      as integer   no-undo .
     2417     define variable v-doc-code-int64   as int64     no-undo .
     2418     define variable v-canonic-doc-code as character no-undo .
     2419     assign
     2420       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2421       v-canonic-doc-code = p-doc-code
     2422     .
     2423     do v-ind = 1 to v-num-entries
     2424     :
     2425       assign
     2426         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2427       .
     2428     end.
     2429     assign
     2430       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2431     .
     2432     return v-doc-code-int64 .
     2433   end. // function/method
     2434   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2435   procedure exp-prt :
     2436     define input  parameter  g-code  like ub.goods.gds-code    no-undo.
     2437     define input  parameter  old-num like ub.price-doc.doc-num no-undo.
     2438     define input  parameter  new-num like ub.price-doc.doc-num no-undo.
     2439     define output parameter  new-rec as recid               no-undo.
     2440     do
     2441     on error undo, return error return-value
     2442     :
     2443     define buffer buf-bar-code   for ub.bar-code.
     2444     define buffer buf-goods      for ub.goods.
     2445     define buffer buf-price-list for ub.price-list.
     2446     find buf-goods no-lock where
     2447         buf-goods.gds-code = g-code.
     2448     if par-pr-altex = "yes" and
     2449        par-pr-notls = "yes" then do:
     2450   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2451   for each  buf-price-list where
     2452             buf-price-list.doc-num    = old-num and
     2453             buf-price-list.artic      = buf-goods.artic and
     2454             buf-price-list.prod-type  = buf-goods.prod-type and
     2455             buf-price-list.prod-code  = buf-goods.prod-code and
     2456             buf-price-list.main-price = no,
     2457       first buf-bar-code no-lock where
     2458             buf-bar-code.b-code   = buf-price-list.b-code and
     2459             buf-bar-code.unit-cli <> buf-goods.unit-base:
     2460     run cre-pr-list (input  buf-bar-code.b-code,
     2461                      input  new-num,
     2462                      output new-rec) no-error.
     2463     if error-status:error then do:
     2464       message
     2465         "Ошибка cre-pr-list." skip
     2466         "Код:" buf-bar-code.b-code
     2467         view-as alert-box.
     2468       next.
     2469     end.
     2470   end.
     2471     end.
     2472     if par-pr-sclex = "yes" and
     2473       par-pr-notls = "yes" then do:
     2474   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2475       define buffer buf_alt-calc_price-doc39 for ub.price-doc .
     2476     find first buf_alt-calc_price-doc39 no-lock
     2477       where buf_alt-calc_price-doc39.doc-num = old-num
     2478       .
     2479     define variable v-ok as logical   no-undo .
     2480   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2481   do:
     2482     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2483       (input  v-cntxt-db-num
     2484       ,input  v-cntxt-userid
     2485       ,input  0
     2486       ,input  'actn_overvalue_properties':U
     2487       ,input  'object':U
     2488       ,input  buf_alt-calc_price-doc39.host-code
     2489       ,input  buf_alt-calc_price-doc39.obj-type
     2490       ,input  buf_alt-calc_price-doc39.obj-code
     2491       ,input  0
     2492       ,input  0
     2493       ,input  0
     2494       ,input  false
     2495       ,output v-ok
     2496       )  .
     2497   end.
     2498     if v-ok then do:
     2499   for each  buf-price-list where
     2500             buf-price-list.doc-num    = old-num and
     2501             buf-price-list.artic      = buf-goods.artic and
     2502             buf-price-list.prod-type  = buf-goods.prod-type and
     2503             buf-price-list.prod-code  = buf-goods.prod-code and
     2504             buf-price-list.main-price = no,
     2505       first buf-bar-code no-lock where
     2506             buf-bar-code.b-code   = buf-price-list.b-code and
     2507             buf-bar-code.in-code = "" and
     2508             buf-bar-code.unit-cli = buf-goods.unit-base:
     2509     run cre-pr-list (input  buf-bar-code.b-code,
     2510                      input  new-num,
     2511                      output new-rec) no-error.
     2512     if error-status:error then do:
     2513       message
     2514         "Ошибка cre-pr-list." skip
     2515         "Код:" buf-bar-code.b-code
     2516         view-as alert-box.
     2517       next.
     2518     end.
     2519   end.
     2520   end.
     2521     end.
     2522     end.
     2523   end procedure.
