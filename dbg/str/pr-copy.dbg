        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter x-doc-num as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: pr-copy.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/pr-copy.p $":U .
        9   define variable vss-description as character no-undo init "Копирование переоценок по списку объектов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table userobjs_temp-user-obj no-undo
       81     field obj-type as character
       82     field obj-code as integer
       83     index xpk is primary unique obj-type obj-code
       84     .
       85   procedure userobjs_clear :
       86     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       87     do
       88     on error undo, return error return-value
       89     :
       90       for each buf_userobjs_temp-user-obj
       91       on error undo, return error return-value
       92       :
       93         delete buf_userobjs_temp-user-obj .
       94       end.
       95     end.
       96   end .
       97   procedure userobjs_object-count :
       98     define output parameter p-total-count as integer   no-undo .
       99     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      100     do
      101     on error undo, return error return-value
      102     :
      103       assign
      104         p-total-count = 0
      105       .
      106       for each buf_userobjs_temp-user-obj
      107       on error undo, return error return-value
      108       :
      109         assign
      110           p-total-count = p-total-count + 1
      111         .
      112       end.
      113     end.
      114   end.
      115   procedure userobjs_append :
      116      define input  parameter p-obj-type as character no-undo .
      117      define input  parameter p-obj-code as integer   no-undo .
      118     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      119     do
      120     on error undo, return error return-value
      121     :
      122       find first buf_userobjs_temp-user-obj
      123         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      124           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      125         no-error .
      126       if not available buf_userobjs_temp-user-obj
      127       then do:
      128         create buf_userobjs_temp-user-obj .
      129         assign
      130           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      131           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      132         .
      133       end.
      134     end.
      135   end.
      136   procedure userobjs_object-exist :
      137     define output parameter p-object-exist as logical   no-undo .
      138     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      139     do
      140     on error undo, return error return-value
      141     :
      142       find first buf_userobjs_temp-user-obj
      143         no-error .
      144       if not available buf_userobjs_temp-user-obj
      145       then do:
      146         assign
      147           p-object-exist = false
      148         .
      149       end.
      150       else do:
      151         assign
      152           p-object-exist = true
      153         .
      154       end.
      155     end.
      156   end.
      157   procedure userobjs_transfer :
      158     define input  parameter p-callback-handle as handle no-undo .
      159     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      160     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      161     do
      162     on error undo, return error return-value
      163     :
      164       if valid-handle(p-callback-handle) <> true
      165       then do:
      166         message
      167           vss-workfile vss-revision vss-description skip
      168           "Ошибка задания входных параметров" skip
      169           "Неизвестный указатель на процедуру" skip
      170           view-as alert-box error .
      171         undo, return error return-value .
      172       end.
      173       if p-callback-handle :get-signature("userobjs_append") = ""
      174       then do:
      175         message
      176           vss-workfile vss-revision vss-description skip
      177           "Ошибка задания входных параметров" skip
      178           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      179                     ,p-callback-handle :file-name
      180                     ) skip
      181           view-as alert-box error .
      182         undo, return error return-value .
      183       end.
      184       for each buf_userobjs_temp-user-obj
      185       on error undo, return error return-value
      186       :
      187         run userobjs_append in p-callback-handle
      188           (input  buf_userobjs_temp-user-obj.obj-type
      189           ,input  buf_userobjs_temp-user-obj.obj-code
      190           ) .
      191       end.
      192     end.
      193   end procedure.
      194   procedure userobjs_select-one :
      195      define input  parameter parparentproc     as widget-handle no-undo .
      196      define input  parameter p-db-num          as integer   no-undo .
      197      define input  parameter p-user-id         as character no-undo .
      198      define input  parameter p-host-code-obj   as integer   no-undo .
      199      define input  parameter p-obj-type        as character no-undo .
      200      define input  parameter p-obj-code        as integer   no-undo .
      201      define output parameter p-user-select     as logical   no-undo .
      202      define output parameter p-select-obj-type as character no-undo .
      203      define output parameter p-select-obj-code as character no-undo .
      204     do
      205     on error undo, return error return-value
      206     :
      207       run gbl/userobjs.w
      208         (input  parparentproc
      209         ,input  this-procedure :handle
      210         ,input  p-db-num
      211         ,input  p-user-id
      212         ,input  p-host-code-obj
      213         ,input  p-obj-type
      214         ,input  p-obj-code
      215         ,INPUT  "b-sel"
      216         ,output p-user-select
      217         ,output p-select-obj-type
      218         ,output p-select-obj-code
      219         ) .
      220     end.
      221   end.
      222   procedure userobjs_select-many :
      223     define input  parameter parparentproc   as widget-handle no-undo .
      224     define input  parameter p-db-num        as integer   no-undo .
      225     define input  parameter p-user-id       as character no-undo .
      226     define input  parameter p-host-code-obj as integer   no-undo .
      227     define input  parameter p-obj-type      as character no-undo .
      228     define input  parameter p-obj-code      as integer   no-undo .
      229     define output parameter p-user-select   as logical   no-undo .
      230     define variable v-select-obj-type as character no-undo .
      231     define variable v-select-obj-code as integer   no-undo .
      232     do
      233     on error undo, return error return-value
      234     :
      235       run gbl/userobjs.w
      236         (input  parparentproc
      237         ,input  this-procedure :handle
      238         ,input  p-db-num
      239         ,input  p-user-id
      240         ,input  p-host-code-obj
      241         ,input  p-obj-type
      242         ,input  p-obj-code
      243         ,INPUT  "b-sel,b-mark"
      244         ,output p-user-select
      245         ,output v-select-obj-type
      246         ,output v-select-obj-code
      247         ) .
      248     end.
      249   end.
      250   procedure thobjs :
      251      define input        parameter parparentproc     as widget-handle no-undo .
      252      define input        parameter i-bttns           as character     no-undo .
      253      define input        parameter i-list-mode       as character     no-undo.
      254      define input        parameter i-obj-type        as character     no-undo.
      255      define input        parameter i-db-num          as integer       no-undo.
      256      define input        parameter i-host-code       as integer       no-undo.
      257      define input-output parameter p-rid-list        as character     no-undo .
      258   run ref/thobjs.p
      259           ( input parparentproc
      260            ,input  this-procedure :handle
      261           , input i-bttns
      262           , input i-list-mode
      263           , input i-obj-type
      264           , input i-db-num
      265           , input i-host-code
      266           , input-output p-rid-list ) no-error .
      267   end.
      268   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      269   procedure check-use-bar-code :
      270     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
      271     do
      272     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      273     on stop   undo, return error substitute( "&1. stop", vss-include-info2 )
      274     on endkey undo, return error substitute( "&1. endkey", vss-include-info2 )
      275     :
      276       define buffer buf_bar-code for ub.bar-code .
      277       find first buf_bar-code no-lock
      278         where buf_bar-code.b-code     = p-b-code
      279         no-error .
      280       if not available buf_bar-code then do:
      281         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info2, p-b-code ) .
      282       end.
      283       if buf_bar-code.stts = integer('99':U) then do:
      284         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      285                                 + "Выполняется удаление бар-кода"
      286                                 ,vss-include-info2
      287                                 ,p-b-code
      288                                 ,chr(10)
      289                               ) .
      290       end.
      291       if buf_bar-code.stts = integer('79':U) then do:
      292         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      293                                 + "Бар-код выключен"
      294                                 ,vss-include-info2
      295                                 ,p-b-code
      296                                 ,chr(10)
      297                               ) .
      298       end.
      299       return .
      300     end.
      301   end procedure.
      302   define variable new-price-num  as character no-undo .
      303   define variable new-rec as recid no-undo .
      304   define variable g#log as logical no-undo .
      305   define buffer b-price-doc for price-doc   .
      306   define buffer b-price-list for price-list .
      307   define buffer new-price-doc for price-doc   .
      308   define buffer new-price-list for price-list .
      309   do
      310   on error undo, return error return-value
      311   :
      312   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313     run mainmenu_getcntxt in parparentproc
      314       (output v-cntxt-db-num
      315       ,output v-cntxt-userid
      316       ,output v-cntxt-level
      317       ,output v-cntxt-host-code-obj
      318       ,output v-cntxt-obj-type
      319       ,output v-cntxt-obj-code
      320       ,output v-cntxt-db-num-obj
      321       ,output v-cntxt-is-admin
      322       ) .
      323     define variable v-user-select as logical   no-undo .
      324   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325   run userobjs_select-many in this-procedure
      326     (input  parparentproc
      327     ,input  v-cntxt-db-num
      328     ,input  v-cntxt-userid
      329     ,input  v-cntxt-host-code-obj
      330     ,input  v-cntxt-obj-type
      331     ,input  v-cntxt-obj-code
      332     ,output v-user-select
      333     )  .
      334     if v-user-select <> true
      335     then do:
      336       message
      337         "Объект не выбран"
      338         view-as alert-box information .
      339       return .
      340     end.
      341     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      342     for each buf_userobjs_temp-user-obj
      343     on error undo, return error return-value
      344     :
      345       find first clients no-lock
      346         where clients.obj-type = buf_userobjs_temp-user-obj.obj-type
      347           and clients.obj-code = buf_userobjs_temp-user-obj.obj-code
      348         no-error .
      349       find first b-price-doc no-lock
      350         where b-price-doc.doc-num = x-doc-num
      351         no-error .
      352       if not available b-price-doc
      353       then do:
      354         message
      355           vss-workfile vss-revision vss-description skip
      356           "не найдена переоценка" x-doc-num
      357           view-as alert-box error .
      358         undo, return error return-value .
      359       end.
      360       define variable p-price-doc-recid  as recid no-undo .
      361       define variable calc-rec     as recid        no-undo.
      362       run prcreate-new-price-doc in this-procedure ( input v-cntxt-db-num ,
      363                                     input clients.obj-type  ,
      364                                     input clients.obj-code   ,
      365                                     input b-price-doc.plt-id      ,
      366                                     input b-price-doc.plt-db-num  ,
      367                                     input b-price-doc.pdf-id      ,
      368                                     input b-price-doc.pdf-db  ,
      369                                     output p-price-doc-recid  ) .
      370       find first new-price-doc where recid(new-price-doc) =  p-price-doc-recid  exclusive-lock  no-error .
      371             new-price-doc.PS = b-price-doc.ps + " --- копия переоценки № " + x-doc-num .
      372       for each b-price-list  where b-price-list.doc-num = x-doc-num no-lock :
      373                 run cre-pr-list in this-procedure (
      374                       input   b-price-list.b-code   ,
      375                       input   new-price-doc.doc-num ,
      376                       output  calc-rec   ) .
      377       find first new-price-list where recid(new-price-list) =  calc-rec  exclusive-lock  no-error .
      378             if available new-price-list then
      379               new-price-list.price-sale = b-price-list.price-sale  .
      380       end.
      381     end.
      382   end.
      383   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      385                                           local-doc-num as char).
      386   define buffer base-price        for ub.price-list.
      387   define variable local-main-code like ub.bar-code.b-code no-undo.
      388   define variable local-base-code like ub.bar-code.b-code no-undo.
      389     run prc-base-code (input local-bc, output local-base-code).
      390     find base-price no-lock where
      391          base-price.doc-num = local-doc-num and
      392          base-price.b-code  = local-base-code and
      393          base-price.price-type = "" no-error.
      394     if not available base-price then do:
      395       run prc-main-code (input local-bc, output local-main-code).
      396       find  base-price no-lock where
      397             base-price.doc-num = local-doc-num and
      398             base-price.b-code  = local-main-code and
      399             base-price.price-type = "" no-error.
      400     end.
      401     if available base-price then
      402       return (base-price.price-sale).
      403     else
      404       return (?).
      405   END FUNCTION.
      406   procedure prc-main-code:
      407   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      408   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      409   define buffer local-bar-code        for ub.bar-code.
      410   define buffer local-goods           for ub.goods.
      411   define buffer main-code             for ub.bar-code.
      412   define buffer main-prt              for ub.gds-prt.
      413     local-main-code = ?.
      414     find local-bar-code no-lock where
      415          local-bar-code.b-code = local-bc no-error.
      416     if not available local-bar-code then
      417       return.
      418     find local-goods no-lock where
      419          local-goods.gds-code = local-bar-code.gds-code.
      420     find first  main-prt no-lock where
      421                 main-prt.upper-code = local-goods.prt-root.
      422     find  main-code no-lock where
      423           main-code.gds-code  = local-bar-code.gds-code and
      424           main-code.in-code   = "" and
      425           main-code.part-code = "" and
      426           main-code.unit-cli  = local-goods.unit-base and
      427           main-code.node-code = main-prt.node-code.
      428     local-main-code = main-code.b-code.
      429   end procedure.
      430   procedure prc-base-code:
      431   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      432   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      433   define buffer local-bar-code for ub.bar-code.
      434   define buffer local-goods    for ub.goods.
      435   define buffer base-code      for ub.bar-code.
      436     local-base-code = ?.
      437     find local-bar-code no-lock where
      438          local-bar-code.b-code = local-bc no-error.
      439     if not available local-bar-code then
      440       return.
      441     find local-goods no-lock where
      442          local-goods.gds-code = local-bar-code.gds-code.
      443     find base-code no-lock where
      444          base-code.gds-code  = local-bar-code.gds-code and
      445          base-code.node-code = local-bar-code.node-code and
      446          base-code.in-code   = local-bar-code.in-code and
      447          base-code.part-code = local-bar-code.part-code and
      448          base-code.unit-cli  = local-goods.unit-base.
      449     local-base-code = base-code.b-code.
      450   end procedure.
      451   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      453   procedure prcreate-new-price-doc :
      454   do
      455   on error undo, return error return-value
      456   :
      457   define input  parameter p-curr-db-num  as integer   no-undo .
      458   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      459   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      460   define input  parameter p-plt-id       as integer   no-undo .
      461   define input  parameter p-plt-db-num   as integer   no-undo .
      462   define input  parameter p-pdf-id       as integer   no-undo .
      463   define input  parameter p-pdf-db-num   as integer   no-undo .
      464   define output parameter p-price-doc-recid  as recid                no-undo.
      465   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      466   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      467   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      468   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      469   define buffer buf_price-doc-forming for ub.price-doc-forming.
      470   define buffer buf_price-doc         for ub.price-doc.
      471   find first buf_price-doc-forming no-lock where
      472              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      473              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      474              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      475              buf_price-doc-forming.plt-id     = p-plt-id
      476              no-error .
      477   if not available buf_price-doc-forming and p-plt-id = ? then do:
      478      run create_new_price-doc-forming
      479           ( input p-obj-type ,
      480             input p-obj-code ,
      481             output p-pdf-db-num ,
      482             output p-pdf-id ,
      483             output p-plt-db-num ,
      484             output p-plt-id
      485             ).
      486       find first buf_price-doc-forming no-lock where
      487                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      488                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      489                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      490                 buf_price-doc-forming.plt-id     = p-plt-id
      491                 no-error .
      492   end.
      493       create buf_price-doc .
      494       run doc-code in this-procedure
      495       (input  "main",
      496        input  p-obj-type  ,
      497        input  p-obj-code  ,
      498        input  ?,
      499        output buf_price-doc.doc-num) no-error.
      500       if error-status:error then do:
      501         message vss-workfile vss-revision vss-description skip
      502                error-status :get-message(1)
      503               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      504         return error.
      505       end.
      506   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      508     (input  p-obj-type
      509     ,input  p-obj-code
      510     ,output v-host-code
      511     )  .
      512       v-obj-current-date  = today .
      513       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      514           v-base-rate   =  buf_price-doc-forming.base-rate  .
      515           v-base-scale  =  buf_price-doc-forming.base-scale .
      516       end.
      517       else do:
      518   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      520     (input  v-host-code
      521     ,input  v-obj-current-date
      522     ,output v-base-rate
      523     ,output v-base-scale
      524     )  .
      525       end.
      526      assign
      527       buf_price-doc.base-rate      = v-base-rate
      528       buf_price-doc.base-scale     = v-base-scale
      529       buf_price-doc.cr-db-num      = p-curr-db-num
      530       buf_price-doc.doc-date       = v-obj-current-date
      531       buf_price-doc.fact-num       = 0
      532       buf_price-doc.host-code      = v-host-code
      533       buf_price-doc.is-corr        = false
      534       buf_price-doc.is-del         = false
      535       buf_price-doc.obj-code       = p-obj-code
      536       buf_price-doc.obj-type       = p-obj-type
      537       buf_price-doc.out-code       = ""
      538       buf_price-doc.pdf-db         = p-pdf-db-num
      539       buf_price-doc.pdf-id         = p-pdf-id
      540       buf_price-doc.plt-db-num     = p-plt-db-num
      541       buf_price-doc.plt-id         = p-plt-id
      542       buf_price-doc.PS             = "@ "
      543       buf_price-doc.rest-base      = 0
      544       buf_price-doc.rest-last      = 0
      545       buf_price-doc.rest-qnty      = 0
      546       buf_price-doc.rest-sale      = 0
      547       buf_price-doc.sale-base      = 0
      548       buf_price-doc.status_        = 'новый':U
      549       .
      550       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      551       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      552       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      553       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      554       assign
      555           p-price-doc-recid = recid ( buf_price-doc )
      556       .
      557   end.
      558   end procedure.
      559   procedure prcreate-new-price-list :
      560   do
      561   on error undo, return error return-value
      562   :
      563   define input parameter p-price-doc-recid   as recid                    no-undo.
      564   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      565   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      566   define output parameter p-update           as logical                  no-undo.
      567   define variable kk as integer no-undo .
      568   define var v-b-code    like ub.bar-code.b-code     no-undo.
      569   define variable p-hostcode as int no-undo .
      570   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      571   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      572   define buffer buf_price-doc        for ub.price-doc.
      573   define buffer buf_price-list       for ub.price-list.
      574   define buffer buf_bar-code         for ub.bar-code.
      575   define buffer buf_goods            for ub.goods.
      576   define buffer buf_root_gds-prt     for ub.gds-prt.
      577   define buffer buf_gds-prt          for ub.gds-prt.
      578   find first buf_price-doc no-lock
      579        where recid( buf_price-doc ) = p-price-doc-recid
      580   .
      581   find first buf_goods no-lock
      582        where buf_goods.gds-code = p-gds-code
      583   .
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      585     (input  p-gds-code
      586     ,input  ?
      587     ,output v-b-code
      588     ) no-error .
      589   if error-status :error
      590   then do:
      591       message
      592           "Не найден основной бар-код"
      593           skip "для товара "
      594           skip string(buf_goods.artic)
      595           skip buf_goods.gds-name
      596       view-as alert-box
      597       title "Ошибка при выполнении prcreate.i".
      598       undo, return error .
      599   end.
      600   find first buf_bar-code no-lock
      601        where buf_bar-code.b-code = v-b-code
      602   no-error.
      603   if error-status :error
      604   then do:
      605       message
      606           "Не найдена запись bar-code"
      607           skip "для товара "
      608           skip string(buf_goods.artic)
      609           skip buf_goods.gds-name
      610           skip "С основным бар-кодом"
      611           skip string(v-b-code)
      612       view-as alert-box
      613       title "Ошибка при выполнении prcreate.i".
      614       undo, return error .
      615   end.
      616   find first buf_root_gds-prt no-lock
      617        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      618   .
      619   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      620     and buf_bar-code.in-code <> ""
      621   then do:
      622       message
      623           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      624           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      625           view-as alert-box error.
      626       undo, return error.
      627   end.
      628   find first buf_gds-prt no-lock
      629        where buf_gds-prt.node-code = buf_bar-code.node-code
      630   .
      631   find first buf_price-list
      632        where buf_price-list.doc-num = buf_price-doc.doc-num
      633          and buf_price-list.b-code  = v-b-code
      634   no-error.
      635   if available buf_price-list
      636   then do:
      637       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      638          skip "  Цена:   " buf_price-list.price-sale
      639          skip "Цена будет изменена"
      640       view-as alert-box warning.
      641       assign
      642           p-update = yes
      643       .
      644   end.
      645   else do:
      646   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      648     (input  buf_price-doc.obj-type
      649     ,input  buf_price-doc.obj-code
      650     ,output p-hostcode
      651     ) no-error .
      652   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      654     (input  buf_goods.gds-code
      655     ,input  '1':U
      656     ,input  ?
      657     ,input  p-hostcode
      658     ,input  buf_price-doc.obj-type
      659     ,input  buf_price-doc.obj-code
      660     ,output local_vat-pc
      661     ) no-error .
      662   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      664     (input  buf_goods.gds-code
      665     ,input  '2':U
      666     ,input  ?
      667     ,input  p-hostcode
      668     ,input  buf_price-doc.obj-type
      669     ,input  buf_price-doc.obj-code
      670     ,output local_slt-pc
      671     ) no-error .
      672       kk = kk + 1.
      673   define variable v-main-bar-code as integer   no-undo .
      674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      675     (input  buf_goods.gds-code
      676     ,input  ?
      677     ,output v-main-bar-code
      678     )  .
      679       create buf_price-list.
      680       assign
      681           buf_price-list.line-num    = kk
      682           buf_price-list.doc-num     = buf_price-doc.doc-num
      683           buf_price-list.b-code      = buf_bar-code.b-code
      684           buf_price-list.artic       = buf_goods.artic
      685           buf_price-list.prod-type   = buf_goods.prod-type
      686           buf_price-list.prod-code   = buf_goods.prod-code
      687           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      688           buf_price-list.calc-method = 'Отсутствует':U
      689           buf_price-list.obj-type    = buf_price-doc.obj-type
      690           buf_price-list.obj-code    = buf_price-doc.obj-code
      691           buf_price-list.price-sale  = p-price-sale
      692           buf_price-list.vat-pc      = local_vat-pc
      693           buf_price-list.slt-pc      = local_slt-pc
      694           p-update                   = no
      695       .
      696   end.
      697   end.
      698   end procedure.
      699   procedure create_new_price-doc-forming :
      700   define input  parameter p-obj-type   as character no-undo .
      701   define input  parameter p-obj-code   as integer   no-undo .
      702   define output parameter p-pdf-db-num as integer   no-undo .
      703   define output parameter p-pdf-id     as integer   no-undo .
      704   define output parameter p-plt-db-num as integer   no-undo .
      705   define output parameter p-plt-id     as integer   no-undo .
      706   define buffer buf_price-list-type for ub.price-list-type  .
      707   define variable v-host-code  as integer   no-undo .
      708   define variable v-base-rate  as decimal   no-undo .
      709   define variable v-base-scale as integer   no-undo .
      710   define variable v-exch-rate  as decimal   no-undo .
      711   define variable v-exch-scale as integer   no-undo .
      712   define variable v-base as logical   no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      718     (output v-base
      719     )  .
      720   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      722     (input  p-obj-type
      723     ,input  p-obj-code
      724     ,output v-host-code
      725     )  .
      726   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      728     (input  v-host-code
      729     ,input  today
      730     ,output v-base-rate
      731     ,output v-base-scale
      732     )  .
      733   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
      735     (input  ?
      736     ,input  p-obj-type
      737     ,input  p-obj-code
      738     ,input  yes
      739     ,output p-plt-id
      740     ,output p-plt-db-num
      741     )  .
      742      create ub.price-doc-forming.
      743      assign
      744         ub.price-doc-forming.plt-id       = p-plt-id
      745         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      746         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      747         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      748         ub.price-doc-forming.base-rate    = v-base-rate
      749         ub.price-doc-forming.base-scale   = v-base-scale
      750         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      751         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      752         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      753         ub.price-doc-forming.stts         = 0
      754         ub.price-doc-forming.sys-date     = today
      755         ub.price-doc-forming.sys-time     = time
      756         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      757         ub.price-doc-forming.who          = v-cntxt-userid
      758         ub.price-doc-forming.name         = "автосоздание"
      759      .
      760      assign
      761       p-pdf-db-num  = ub.price-doc-forming.pdf-db
      762       p-pdf-id      = ub.price-doc-forming.pdf-id
      763       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      764       p-plt-id      = ub.price-doc-forming.plt-id
      765      .
      766     end.
      767   end procedure.
      768   procedure prcreate-new-price-doc-forming-gds :
      769   define input  parameter p-price-doc-forming-recid as recid  no-undo.
      770   define input  parameter p-obj-type   as character no-undo .
      771   define input  parameter p-obj-code   as integer   no-undo .
      772   define input  parameter par-pr-notls as character no-undo .
      773   define input  parameter par-pr-altex as character no-undo .
      774   define input  parameter par-pr-sclex as character no-undo .
      775   define input  parameter p-line-num    as integer   no-undo .
      776   define input  parameter p-gds-code    as integer   no-undo .
      777   define input  parameter p-price-sale  as decimal   no-undo .
      778   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      779   define buffer buf_goods for ub.goods  .
      780   define buffer buf_bar-code for ub.bar-code  .
      781   define buffer main_bar-code for ub.bar-code  .
      782   define variable main-b-code as integer   no-undo .
      783   define variable v-sec as integer   no-undo .
      784     do
      785     on error undo, return error return-value
      786     :
      787   define variable v-cur-dn as character no-undo .
      788   define variable v-cur-pr as decimal   no-undo .
      789   define variable v-cur-rt as decimal   no-undo .
      790   define variable v-cur-ex as decimal   no-undo .
      791   find first buf_price-doc-forming no-lock where
      792              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      793              if error-status :error then return error .
      794   find first buf_goods no-lock where
      795              buf_goods.gds-code  = p-gds-code no-error .
      796              if error-status :error then return error .
      797   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      798     (input  buf_goods.gds-code
      799     ,input  ?
      800     ,output main-b-code
      801     ) no-error .
      802   run check-use-bar-code (main-b-code) no-error .
      803   if error-status :error then return .
      804   run create-line-pdf-mpl-lib (
      805        input buf_price-doc-forming.plt-db-num
      806       ,input buf_price-doc-forming.plt-id
      807       ,input buf_price-doc-forming.pdf-db
      808       ,input buf_price-doc-forming.pdf-id
      809       ,input p-line-num
      810       ,input main-b-code
      811       ,input buf_goods.artic
      812       ,input buf_goods.prod-type
      813       ,input buf_goods.prod-code
      814       ,input ""
      815       ,input 0
      816       ,input p-price-sale
      817       ,input ""
      818       ,input 0
      819      ,input-output v-sec ) no-error .
      820      if error-status :error  then do:
      821        message
      822          vss-workfile vss-revision vss-description skip
      823          error-status :get-message(1) skip
      824          return-value skip
      825          "2"
      826          view-as alert-box error
      827        .
      828      end.
      829   define buffer old_price-list for ub.price-list  .
      830   if par-pr-notls = "yes" then do:
      831   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      833     (input  p-obj-type
      834     ,input  p-obj-code
      835     ,input  main-b-code
      836     ,input  0
      837     ,input  0
      838     ,output v-cur-dn
      839     ,output v-cur-pr
      840     ,output v-cur-rt
      841     ,output v-cur-ex
      842     )  .
      843   end.
      844   if par-pr-altex = "yes" and
      845      par-pr-notls = "yes" then do:
      846       if v-cur-dn <> "" then do:
      847           for each old_price-list no-lock where
      848                    old_price-list.doc-num = v-cur-dn and
      849                    old_price-list.artic      = buf_goods.artic and
      850                    old_price-list.prod-type  = buf_goods.prod-type and
      851                    old_price-list.prod-code  = buf_goods.prod-code and
      852                    old_price-list.main-price = no,
      853                   first buf_bar-code no-lock where
      854                         buf_bar-code.b-code   = old_price-list.b-code and
      855                         buf_bar-code.unit-cli <> buf_goods.unit-base
      856                         :
      857                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      858                          if error-status :error then next.
      859                    run create-line-pdf-mpl-lib (
      860                          input buf_price-doc-forming.plt-db-num
      861                         ,input buf_price-doc-forming.plt-id
      862                         ,input buf_price-doc-forming.pdf-db
      863                         ,input buf_price-doc-forming.pdf-id
      864                         ,input p-line-num
      865                         ,input old_price-list.b-code
      866                         ,input buf_goods.artic
      867                         ,input buf_goods.prod-type
      868                         ,input buf_goods.prod-code
      869                         ,input ""
      870                         ,input 0
      871                         ,input old_price-list.price-sale
      872                         ,input ""
      873                         ,input 0
      874                        ,input-output v-sec ) no-error .
      875           end.
      876       end.
      877   end.
      878   if par-pr-sclex = "yes" and
      879      par-pr-notls = "yes" then do:
      880       if v-cur-dn <> "" then do:
      881           for each old_price-list no-lock where
      882                    old_price-list.doc-num    = v-cur-dn and
      883                    old_price-list.artic      = buf_goods.artic and
      884                    old_price-list.prod-type  = buf_goods.prod-type and
      885                    old_price-list.prod-code  = buf_goods.prod-code and
      886                    old_price-list.main-price = no,
      887                   first buf_bar-code no-lock where
      888                         buf_bar-code.b-code   = old_price-list.b-code and
      889                         buf_bar-code.in-code  = "" and
      890                         buf_bar-code.unit-cli = buf_goods.unit-base
      891                         :
      892                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      893                          if error-status :error then next.
      894                    run create-line-pdf-mpl-lib (
      895                          input buf_price-doc-forming.plt-db-num
      896                         ,input buf_price-doc-forming.plt-id
      897                         ,input buf_price-doc-forming.pdf-db
      898                         ,input buf_price-doc-forming.pdf-id
      899                         ,input p-line-num
      900                         ,input old_price-list.b-code
      901                         ,input buf_goods.artic
      902                         ,input buf_goods.prod-type
      903                         ,input buf_goods.prod-code
      904                         ,input ""
      905                         ,input 0
      906                         ,input old_price-list.price-sale
      907                         ,input ""
      908                         ,input 0
      909                       ,input-output v-sec ) no-error .
      910           end.
      911       end.
      912   end.
      913   end.
      914   end procedure.
      915   procedure copy_new_price-doc-forming :
      916   define input  parameter       p-recid      as recid no-undo .
      917   define input-output parameter p-plt-db-num as integer   no-undo .
      918   define input-output parameter p-plt-id     as integer   no-undo .
      919   define output parameter       p-pdf-db-num as integer   no-undo .
      920   define output parameter       p-pdf-id     as integer   no-undo .
      921   define buffer buf_price-list-type        for ub.price-list-type  .
      922   define buffer buf_price-doc-forming      for ub.price-doc-forming .
      923   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
      924   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
      925   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
      926   define variable v-host-code  as integer   no-undo .
      927   define variable v-base-rate  as decimal   no-undo .
      928   define variable v-base-scale as integer   no-undo .
      929   define variable v-exch-rate  as decimal   no-undo .
      930   define variable v-exch-scale as integer   no-undo .
      931   define variable v-base as logical   no-undo .
      932   define variable v-name as character no-undo .
      933     do
      934     on error undo, return error return-value
      935     :
      936   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      938     (output v-base
      939     )  .
      940   find first buf_price-list-type no-lock where
      941              buf_price-list-type.plt-db-num = p-plt-db-num and
      942              buf_price-list-type.plt-id     = p-plt-id no-error .
      943   if error-status :error then return error "Не найден ТПЛ".
      944   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
      945   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
      946       if available buf_price-doc-forming then do :
      947           assign
      948             v-base-rate  = buf_price-doc-forming.base-rate
      949             v-base-scale = buf_price-doc-forming.base-scale
      950             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
      951           .
      952       end.
      953       else do:
      954           assign
      955             v-base-rate  = 1
      956             v-base-scale = 1
      957             v-name       = "Автосоздание"
      958           .
      959       end.
      960      create ub.price-doc-forming.
      961      assign
      962         ub.price-doc-forming.plt-id       = p-plt-id
      963         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      964         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      965         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      966         ub.price-doc-forming.base-rate    = v-base-rate
      967         ub.price-doc-forming.base-scale   = v-base-scale
      968         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      969         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      970         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      971         ub.price-doc-forming.stts         = 0
      972         ub.price-doc-forming.sys-date     = today
      973         ub.price-doc-forming.sys-time     = time
      974         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      975         ub.price-doc-forming.who          = v-cntxt-userid
      976         ub.price-doc-forming.name         = v-name
      977      .
      978      assign
      979       p-pdf-db-num  = ub.price-doc-forming.pdf-db
      980       p-pdf-id      = ub.price-doc-forming.pdf-id
      981       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      982       p-plt-id      = ub.price-doc-forming.plt-id
      983      .
      984     end.
      985     if not available buf_price-doc-forming then return .
      986   for each buf_price-doc-forming-attr no-lock where
      987            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
      988            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
      989            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
      990            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
      991       create ub.price-doc-forming-attr.
      992       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
      993       assign
      994         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
      995         ub.price-doc-forming-attr.plt-id      = p-plt-id
      996         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
      997         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
      998         .
      999   end.
     1000   for each buf_price-doc-forming-gds no-lock where
     1001            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1002            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1003            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1004            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1005       create ub.price-doc-forming-gds.
     1006       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1007       assign
     1008         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1009         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1010         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1011         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1012       .
     1013   end.
     1014   for each buf_pd-forming-gds-attr no-lock where
     1015            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1016            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1017            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1018            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1019       create ub.price-doc-forming-gdsattr.
     1020       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1021       assign
     1022         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1023         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1024         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1025         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1026       .
     1027   end.
     1028   end procedure.
