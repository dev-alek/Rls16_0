     1359   procedure grp-obj-notcorr-value :
     1360   do
     1361   on error undo, return error
     1362   :
     1363   define input parameter p-node-code             as integer      no-undo.
     1364   define input parameter p-obj-type              as character    no-undo.
     1365   define input parameter p-obj-code              as integer      no-undo.
     1366   define output parameter p-notcorr              as character    no-undo init ?.
     1367   define output parameter p-range-notcorr     as integer      no-undo.
     1368   define output parameter p-exists-notcorr    as logical      no-undo.
     1369   define variable v-host-code as integer      no-undo.
     1370   DEFINE VARIABLE v-found as logical no-undo .
     1371   DEFINE VARIABLE v-exists as logical no-undo .
     1372   DEFINE VARIABLE v-range as integer no-undo .
     1373   DEFINE VARIABLE jj as integer no-undo .
     1374   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1375   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1376   define buffer buf_gds-grp for ub.gds-grp.
     1377   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1378   find first buf_gds-grp no-lock where
     1379              buf_gds-grp.node-code = p-node-code no-error .
     1380   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1381     message
     1382       vss-workfile vss-revision vss-description
     1383       skip "Не удалось найти группу товаров с кодом" p-node-code
     1384       view-as alert-box error .
     1385     undo, return error .
     1386   end.
     1387   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1389     (input  p-obj-type
     1390     ,input  p-obj-code
     1391     ,output v-host-code
     1392     ) no-error .
     1393   if error-status :error
     1394   then do:
     1395       message
     1396         vss-workfile vss-revision vss-description
     1397         skip "Не удалось найти фирму объекта"
     1398         skip p-obj-type p-obj-code
     1399         skip return-value
     1400         skip trim(error-status :get-message(1))
     1401       view-as alert-box error.
     1402       undo, return error .
     1403   end.
     1404   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1405   do while v-found = no and jj < 2:
     1406     if v-range <> 3 then do:
     1407       find first buf_gds-grp-obj no-lock
     1408           where buf_gds-grp-obj.node-code = p-node-code
     1409             and buf_gds-grp-obj.host-code = v-host-code
     1410             and buf_gds-grp-obj.obj-type  = p-obj-type
     1411             and buf_gds-grp-obj.obj-code  = p-obj-code
     1412       no-error .
     1413     end.
     1414     if v-range = 3 or not available buf_gds-grp-obj
     1415     then do:
     1416        if v-range <> 2 then do:
     1417           find first buf_gds-grp-obj no-lock
     1418               where buf_gds-grp-obj.node-code = p-node-code
     1419                 and buf_gds-grp-obj.host-code = v-host-code
     1420                 and buf_gds-grp-obj.obj-type  = ""
     1421                 and buf_gds-grp-obj.obj-code  = 0
     1422           no-error .
     1423         end.
     1424         if v-range = 2 or not available buf_gds-grp-obj
     1425         then do:
     1426             if v-range <> 1 then do:
     1427               find first buf_gds-grp-obj no-lock
     1428                   where buf_gds-grp-obj.node-code = p-node-code
     1429                   and buf_gds-grp-obj.host-code = 0
     1430                   and buf_gds-grp-obj.obj-type  = ""
     1431                   and buf_gds-grp-obj.obj-code  = 0
     1432               no-error .
     1433             end.
     1434             if v-range = 1 or not available buf_gds-grp-obj
     1435             then do:
     1436                 assign
     1437                     v-exists = no
     1438                 .
     1439             end.
     1440             else do:
     1441                 assign
     1442                     v-exists = yes
     1443                     v-range = 1
     1444                 .
     1445             end.
     1446         end.
     1447         else do:
     1448             assign
     1449                 v-exists = yes
     1450                 v-range  = 2
     1451             .
     1452         end.
     1453     end.
     1454     else do:
     1455         assign
     1456             v-exists = yes
     1457             v-range  = 3
     1458         .
     1459     end.
     1460     if available buf_gds-grp-obj
     1461     then do:
     1462       find first buf_gds-grp-obj-attr no-lock
     1463         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1464           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1465           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1466           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1467           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1468         no-error .
     1469       if available buf_gds-grp-obj-attr then do:
     1470         assign
     1471           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1472         .
     1473       end.
     1474       else do:
     1475         assign
     1476           v-notcorr-value = ?
     1477         .
     1478       end.
     1479       assign
     1480       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1481                           then yes
     1482                           else p-exists-notcorr)
     1483       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1484                         then v-range
     1485                         else p-range-notcorr
     1486       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1487                         then v-notcorr-value
     1488                         else p-notcorr
     1489       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1490       jj = jj + 1
     1491       .
     1492     end.
     1493     else do:
     1494       assign
     1495       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1496       jj = jj + 1
     1497       .
     1498     end.
     1499   end.
     1500   end.
     1501   end procedure.
     1502   define variable vss-include-info23 as character format "X(65)" no-undo
     1503   initial "@(#)$Workfile$ $Revision$".
     1504   procedure grplib-get-full-name :
     1505      define input parameter p-node-code  as integer      no-undo.
     1506      define output parameter p-full-name as character    no-undo.
     1507      do
     1508   on error undo, return error
     1509   :
     1510       define variable v-upper-code    as integer           no-undo.
     1511       define buffer buf_gds-grp       for ub.gds-grp.
     1512       define buffer buf_upper_gds-grp for ub.gds-grp.
     1513       find first buf_gds-grp no-lock
     1514            where buf_gds-grp.node-code = p-node-code
     1515       no-error.
     1516       if not available buf_gds-grp
     1517       then do:
     1518           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1519       end.
     1520       assign
     1521           p-full-name  = ""
     1522           v-upper-code = 1
     1523       .
     1524       do while buf_gds-grp.upper-code <> 0
     1525       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1526       :
     1527           assign
     1528               p-full-name  = buf_gds-grp.node-name
     1529                            + (if p-full-name <> "" then chr(47) else "")
     1530                            + p-full-name
     1531               v-upper-code = buf_gds-grp.upper-code
     1532           .
     1533           find first buf_gds-grp no-lock
     1534                where buf_gds-grp.node-code = v-upper-code
     1535           no-error.
     1536           if not available buf_gds-grp
     1537           then do:
     1538               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1539                                   + string( v-upper-code )
     1540                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1541           end.
     1542       end.
     1543       assign
     1544       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1545       .
     1546   end.
     1547   end .
     1548   procedure grplib-get-node-from-full-name :
     1549   define input parameter p-full-name as character no-undo .
     1550   define output parameter p-node-code as integer no-undo .
     1551   define variable v-ii as integer no-undo .
     1552   define variable v-upper-code as integer no-undo .
     1553   define variable v-root-code as integer no-undo .
     1554   define variable v-entry as character no-undo .
     1555   define buffer buf_gds-grp       for ub.gds-grp.
     1556   do
     1557   on error undo, return error
     1558   :
     1559     find first buf_gds-grp no-lock
     1560         where buf_gds-grp.upper-code = 0
     1561     no-error .
     1562     if not available buf_gds-grp
     1563     then do:
     1564         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1565     end.
     1566     else do:
     1567       assign
     1568       v-root-code = buf_gds-grp.node-code
     1569       .
     1570     end.
     1571     v-upper-code = v-root-code.
     1572     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1573       assign
     1574       v-entry = entry(v-ii, p-full-name, chr(47)).
     1575       if v-entry = '' then leave.
     1576       find first buf_gds-grp no-lock where
     1577                 buf_gds-grp.node-name = v-entry
     1578             and buf_gds-grp.upper-code = v-upper-code
     1579             no-error.
     1580       if not available buf_gds-grp then do:
     1581         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1582       end.
     1583       else do:
     1584         p-node-code = buf_gds-grp.node-code.
     1585         v-upper-code = buf_gds-grp.node-code.
     1586       end.
     1587     end.
     1588   end.
     1589   end .
     1590   procedure  chec-par :
     1591   define output parameter l-par as logical no-undo .
     1592   define input parameter l-host like ub.clients.obj-code no-undo .
     1593   define input parameter l-type like ub.clients.obj-type no-undo .
     1594   define input parameter l-code like ub.clients.obj-code no-undo .
     1595   define variable par-type          as character no-undo.
     1596   define variable v-value-character as character no-undo .
     1597   define variable v-value-date      as date      no-undo .
     1598   define variable v-value-decimal   as decimal   no-undo .
     1599   define variable v-value-integer   as integer   no-undo .
     1600   define variable v-value-logical   as logical   no-undo .
     1601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1602     (input  'alcohol'
     1603     ,input  l-host
     1604     ,input  l-type
     1605     ,input  l-code
     1606     ,input  ''
     1607     ,input  ''
     1608     ,input  ''
     1609     ,input  no
     1610     ,output par-alcohol
     1611     ,output par-type
     1612     ) no-error .
     1613    .
     1614   empty temp-table thbjattr_thbj-attr.
     1615   run adm/shattri.p (
     1616      input "get":U
     1617     ,input l-type
     1618     ,input l-code
     1619     ,input 'overval':U
     1620     ,input  ""
     1621     ,output v-value-character
     1622     ,output v-value-date
     1623     ,output v-value-decimal
     1624     ,output v-value-integer
     1625     ,output v-value-logical
     1626     ,output par-type
     1627     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1628     ) no-error .
     1629   for each thbjattr_thbj-attr :
     1630       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1631       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1632       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1633       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1634       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1635       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1636       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1637       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1638       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1639       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1640       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1641       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1642       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1643       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1644       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1645       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1646       if v-cntxt-db-num = 0 then do:
     1647         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1648         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1649       end.
     1650       else do:
     1651         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1652         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1653       end.
     1654   end.
     1655   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1657     (input  ?
     1658     ,input  l-type
     1659     ,input  l-code
     1660     ,output par-gen-mrgn-ie
