      496        SIZE 9 BY 1.
      497   DEFINE BUTTON b-exp-nd
      498        LABEL "&>>":L
      499        SIZE 4.5 BY 1.
      500   DEFINE BUTTON b-exp-tree
      501        LABEL ">>&->>":L
      502        SIZE 9 BY 1.
      503   DEFINE BUTTON b-amnt
      504        LABEL "&Колич":L
      505        SIZE 9 BY 1.
      506   DEFINE BUTTON b-codes
      507        LABEL "&Коды":L
      508        SIZE 9 BY 1.
      509   DEFINE MENU m-alt
      510          MENU-ITEM m-alt-current  LABEL "Существующие неосновные цены"
      511          MENU-ITEM m-alt-all      LABEL "Все неосновные коды"
      512          rule
      513          MENU-ITEM m-prod-all     LABEL "Дополнительные коды"
      514          .
      515   DEFINE MENU MENU-b-print
      516          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      517          MENU-ITEM m_vert         LABEL "Уровни по вертикали"
      518          .
      519   DEFINE BUTTON b-alt
      520        LABEL "&Неос/Доп":L
      521        SIZE 9 BY 1.
      522   DEFINE BUTTON b-rest
      523        LABEL "&Остатки":L
      524        SIZE 9 BY 1.
      525   DEFINE MENU m-inf
      526          MENU-ITEM m-inf-prt      LABEL "По признаку"
      527          MENU-ITEM m-inf-gds      LABEL "По товару"
      528          .
      529   DEFINE BUTTON b-info
      530        LABEL "&Архив":L
      531        SIZE 9 BY 1.
      532   DEFINE BUTTON b-print
      533        LABEL "Пе&чать":L
      534        SIZE 9 BY 1.
      535   DEFINE BUTTON b-help
      536        LABEL "Помо&щь":L
      537        SIZE 9 BY 1.
      538   DEFINE FRAME d-gds-prt
      539     b-exit     AT ROW 1.25  COL 1
      540     b-sel      AT ROW 1.25  COL 10
      541     b-del      AT ROW 1.25  COL 19
      542     b-exp-nd   AT ROW 1.25  COL 28
      543     b-exp-tree AT ROW 1.25  COL 32.5
      544     b-amnt     AT ROW 1.25  COL 41.5
      545     b-codes    AT ROW 1.25  COL 50.5
      546     b-alt      AT ROW 1.25  COL 59.5
      547     b-rest     AT ROW 1.25  COL 68.5
      548     b-info     AT ROW 1.25  COL 77.5
      549     b-print    AT ROW 1.25  COL 76.5
      550     b-help     AT ROW 1.25  COL 78.5
      551     ub.doc-line.doc-qnty
      552                at row 2.5   col 30  label "Товар" format "->>>,>>>,>>9.<<<"
      553     ub.goods.unit-base at row 2.5   col 70  no-label      format "x(3)"
      554     flt-amnt        at row 3.5   col 5   label "Только с количествами" view-as toggle-box
      555     br-gds-prt      AT ROW 4.5   COL 2
      556     WITH size 96 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      557     ASSIGN
      558     b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      559     br-gds-prt :set-repositioned-row (10, "conditional").
      560     b-print:MENU-MOUSE in frame d-gds-prt  = 1.
      561     ASSIGN
      562       FRAME d-gds-prt:SCROLLABLE = FALSE
      563       b-info    :POPUP-MENU IN FRAME d-gds-prt         = MENU m-inf  :HANDLE
      564       b-info    :MENU-MOUSE                                = 1
      565       b-alt     :POPUP-MENU IN FRAME d-gds-prt         = MENU m-alt  :HANDLE
      566       b-alt     :MENU-MOUSE                                = 1
      567       .
      568   on value-changed of flt-amnt do:
      569     gds-prt-row = current-result-row ("br-gds-prt").
      570     find first prt-tree.
      571     if input frame d-gds-prt flt-amnt then
      572       run exp-tree.
      573       run UI-on.
      574   end.
      575   on row-display of br-gds-prt do:
      576     if prt-tree.is-root then
      577       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      578     else
      579       if not prt-tree.is-term then
      580         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      581   end.
      582   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      583     prt-rec = prt-tree.rid.
      584     return "exit":U.
      585   END.
      586   ON CHOOSE OF b-sel IN FRAME d-gds-prt  DO:
      587     prt-rec = prt-tree.rid.
      588   END.
      589   ON choose of b-del IN FRAME d-gds-prt DO:
      590      def var gds-prt-recid as recid   no-undo.
      591      def var chg-qnty      as decimal no-undo.
      592     if available prt-tree then do:
      593        assign
      594          gds-prt-recid = recid(prt-tree)
      595          prt-tree.doc-amnt = 0
      596        .
      597       disp prt-tree.doc-amnt with browse br-gds-prt.
      598     end.
      599     def buffer b-gds-prt for gds-prt .
      600     find gds-dtl exclusive-lock where
      601         gds-dtl.artic     = doc-line.artic and
      602         gds-dtl.prod-code = doc-line.prod-code and
      603         gds-dtl.prod-type = doc-line.prod-type and
      604         gds-dtl.doc-code  = doc-line.doc-code and
      605         gds-dtl.prt-code  = prt-tree.n-code no-error.
      606     if available gds-dtl then do:
      607       chg-qnty =  - ( gds-dtl.doc-qnty ).
      608       run trg/rsrv-dtl.p
      609         ( input        ParParentProc
      610         , input        'reserv':U
      611         , buffer       gds-dtl
      612         , input-output chg-qnty
      613         , input-output doc-line.price-base
      614         , input-output doc-line.price-rubl
      615         , input        -1
      616         , input ""
      617         ) no-error .
      618       if error-status :error
      619       then do:
      620         message
      621           vss-workfile vss-revision vss-description skip
      622           error-status :get-message(1) skip
      623           return-value skip
      624           "rsrv-dtl.p "
      625           view-as alert-box error
      626         .
      627       end.
      628       delete gds-dtl .
      629     end.
      630     run clc-nd (buffer prt-tree).
      631     disp  prt-tree.doc-amnt
      632           prt-tree.bc
      633           with browse br-gds-prt.
      634     find first prt-tree.
      635      run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      636     run ui-on.
      637     reposition br-gds-prt to recid gds-prt-recid no-error.
      638   END.
      639   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      640     gds-prt-row = current-result-row ("br-gds-prt").
      641     run exp-nd (?).
      642     run UI-on.
      643   END.
      644   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      645     gds-prt-row = current-result-row ("br-gds-prt").
      646     run exp-tree.
      647     run UI-on.
      648   END.
      649   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      650     gds-prt-row = current-result-row ("br-gds-prt").
      651     if prt-tree.is-term then do:
      652       if b-amnt:sensitive then
      653         apply "choose" to b-amnt in frame d-gds-prt.
      654     end.
      655     else
      656       apply "choose" to b-exp-nd in frame d-gds-prt.
      657     return no-apply.
      658   END.
      659   ON CHOOSE OF b-amnt IN FRAME d-gds-prt  DO:
      660     DEFINE VARIABLE rid-list as character no-undo .
      661     gds-prt-row = current-result-row ("br-gds-prt").
      662     if not prt-tree.is-root and
      663        not prt-tree.is-term then do:
      664       message "Данный признак промежуточный и не может быть выбран."
      665               view-as alert-box error.
      666       return no-apply.
      667     end.
      668     case ub.trn-doc.doc-type:
      669       when 'при':U or
      670       when 'рас':U or
      671       when 'спи':U or
      672       when 'возврат':U then
      673         run str/out-prt.w (
      674                         parParentProc ,
      675                         doc-rec       ,
      676                         line-rec      ,
      677                         gds-rec       ,
      678                         prt-mode      ,
      679                         prt-tree.rid,
      680                        (if prt-tree.is-term then 'терм':U  else 'корн':U))
      681                        no-error.
      682       when 'инв':U then do:
      683         if ub.trn-doc.ext-doc-type = 'vt':U then do:
      684           run str/inv-prt.w (
      685                         parParentProc ,
      686                         doc-rec       ,
      687                         line-rec      ,
      688                         gds-rec       ,
      689                         prt-mode      ,
      690                         prt-tree.rid,
      691                          (if prt-tree.is-term then
      692                             'терм':U
      693                           else
      694                             'корн':U)) no-error.
      695         end.
      696         else do:
      697           message "Работа с признаками запрещена при работе с документом, имеющим расширенный тип: " ub.trn-doc.ext-doc-type "."
      698           view-as alert-box.
      699           return no-apply.
      700         end.
      701       end.
      702     end.
      703     if not error-status:error then do:
      704       run clc-nd (buffer prt-tree).
      705       disp  prt-tree.doc-amnt
      706             prt-tree.bc
      707             with browse br-gds-prt.
      708       find first prt-tree.
      709        run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      710       run ui-on.
      711     end.
      712   END.
      713   ON CHOOSE OF b-codes IN FRAME d-gds-prt do:
      714     run cre-code no-error.
      715     if error-status :error then
      716       return no-apply.
      717     prt-rec = prt-tree.rid.
      718     run ref/alt-bc.w (
      719                   input parParentProc
      720                 , input store-type
      721                 , input store-code
      722                 , input prt-tree.bc).
      723     apply "entry" to br-gds-prt in frame d-gds-prt.
      724   END.
      725   ON CHOOSE OF menu-item m-alt-current do:
      726     run cre-code no-error.
      727     if error-status :error then
      728       return no-apply.
      729     run ref/alt-cds.w ( input parParentProc
      730                        ,input store-type
      731                        ,input store-code
      732                        ,input "code-current"
      733                        ,input ub.goods.gds-code
      734                        ,input prt-tree.bc
      735                        ,output rec-list).
      736     apply "entry" to br-gds-prt in frame d-gds-prt.
      737   END.
      738   ON CHOOSE OF menu-item m-alt-all do:
      739     run cre-code no-error.
      740     if error-status :error then
      741       return no-apply.
      742     run ref/alt-cds.w ( input parParentProc
      743                        ,input store-type
      744                        ,input store-code
      745                        ,input "code-all"
      746                        ,input ub.goods.gds-code
      747                        ,input prt-tree.bc
      748                        ,output rec-list).
      749     apply "entry" to br-gds-prt in frame d-gds-prt.
      750   END.
      751   ON CHOOSE OF menu-item m-prod-all do:
      752     run cre-code no-error.
      753     if error-status :error then
      754       return no-apply.
      755     run ref/prod-cds.w (parParentProc, store-type, store-code,
      756                     "code-all", ub.goods.gds-code, prt-tree.bc, output rec-list).
      757     apply "entry" to br-gds-prt in frame d-gds-prt.
      758   END.
      759   ON CHOOSE OF menu-item m-inf-prt
      760   do:
      761   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   do:
      763     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      764       (input  v-cntxt-db-num
      765       ,input  v-cntxt-userid
      766       ,input  0
      767       ,input  'actn_reference_archive':U
      768       ,input  'firm':U
      769       ,input  v-cntxt-host-code-obj
      770       ,input  '':U
      771       ,input  0
      772       ,input  0
      773       ,input  0
      774       ,input  0
      775       ,input  true
      776       ,output g#log
      777       )  .
      778   end.
      779     if g#log then
      780       run ref/prt_inf.w (buffer ub.goods,
      781                      input prt-tree.n-code,
      782                      input store-type,
      783                      input store-code).
      784     apply "entry" to br-gds-prt in frame d-gds-prt.
      785   END.
      786   ON CHOOSE OF menu-item m-inf-gds do:
      787      run local-gds_inf.
      788   END.
      789   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      790     prt-rec = prt-tree.rid.
      791       run rep/gds-objs.w (parparentproc, ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, g#host-code, prt-tree.n-code).
      792     apply "entry" to br-gds-prt in frame d-gds-prt.
      793   END.
      794   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      795     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      796   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   on help of frame d-gds-prt
      798   do:
      799     run gbl/app_help.p
      800       (input this-procedure :file-name
      801       ,input ''
      802       ,input ?
      803       ) no-error.
      804     if error-status :error then do:
      805       message
      806         "Ошибка при вызове помощи"
      807         error-status :get-message(1)
      808         view-as alert-box .
      809     end.
      810   end.
      811   run minbtn-set in this-procedure .
      812   on choose of b-help in frame d-gds-prt
      813   do:
      814     apply "help":u to frame d-gds-prt .
      815   end.
      816   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      817   procedure minbtn-set :
      818       do
      819           on error undo, return error return-value
      820           :
      821           define variable ii              as integer       no-undo .
      822           define variable fh              as widget-handle no-undo .
      823           define variable hh              as widget-handle no-undo .
      824           define variable v-h             as handle        extent 4 no-undo .
      825           define variable v-name-button   as character     no-undo .
      826           define variable v-help-old-x    as decimal       no-undo .
      827           define variable v-help-old-y    as decimal       no-undo .
      828           define variable v-help-old-size as decimal       no-undo .
      829           define variable v-frame-width   as decimal       no-undo .
      830           define variable jj              as integer       no-undo .
      831           do
      832               on error undo, return error
      833               :
      834               assign
      835                   v-frame-width = frame d-gds-prt:width - 0.3
      836                   fh            = frame d-gds-prt:first-child
      837                   hh            = fh:first-child
      838                   ii            = 1
      839                   .
      840               do while valid-handle(hh):
      841                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      842                   do:
      843                       case lc(hh:name) :
      844                           when "b-help" then
      845                               do:
      846                                   hh:load-image-up("cmp/b-help.bmp":u) .
      847                                   hh:load-image-down("cmp/b-help.bmp":u) .
      848                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      849                                   hh:TOOLTIP = "Помощь" .
      850                                   v-help-old-x = hh:column .
      851                                   v-help-old-y = hh:row    .
      852                                   v-help-old-size = hh:width .
      853                                   hh:width-chars = 2.5 .
      854                               end.
      855                           when "b-print" then
      856                               do:
      857                                   hh:load-image("cmp/b-print.bmp":u) .
      858                                   hh:TOOLTIP = "Печать" .
      859                                   v-h[ii] = hh:handle .
      860                                   ii = ii + 1 .
      861                                   hh:width-chars = 3 .
      862                               end.
      863                           when "b-history" or
      864                           when "b-hist" then
      865                               do:
      866                                   hh:load-image("cmp/b-hist.bmp":u) .
      867                                   hh:TOOLTIP = "История" .
      868                                   v-h[ii] = hh:handle .
      869                                   ii = ii + 1 .
      870                                   hh:width-chars = 3 .
      871                               end.
      872                           when "b-sch" then
      873                               do:
      874                                   hh:load-image("cmp/b-sch.bmp":u) .
      875                                   hh:TOOLTIP = "Установка Фильтра" .
      876                                   v-h[ii] = hh:handle .
      877                                   ii = ii + 1 .
      878                                   hh:width-chars = 3 .
      879                               end.
      880                           when "b-hist-user" then
      881                               do:
      882                                   hh:load-image("cmp/b-hist.bmp":u) .
      883                                   hh:TOOLTIP = "История пользователя" .
      884                                   ii = ii + 1 .
      885                               end.
      886                       end case.
      887                   end.
      888                   hh = hh:next-sibling.
      889               end.
      890               b-help:column = v-frame-width - b-help:width-chars.
      891               jj = 0.
      892               repeat ii = 4 to 1 by -1 :
      893                   if valid-handle (v-h[ii] ) then
      894                   do:
      895                       jj  = jj + 1 .
      896                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      897                       v-h[ii]:row    = v-help-old-y .
      898                   end.
      899               end.
      900           end.
      901       end.
      902   end procedure.
      903   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
      904   find ub.goods no-lock where
      905        recid (ub.goods) = gds-rec.
      906   find ub.gds-prt no-lock where
      907        ub.gds-prt.upper-code = ub.goods.prt-root.
      908   find ub.trn-doc no-lock where
      909        recid (ub.trn-doc) = doc-rec.
      910   find ub.doc-line no-lock where
      911        recid (ub.doc-line) = line-rec.
      912   assign
      913   store-type = ub.trn-doc.obj-type
      914   store-code = ub.trn-doc.obj-code
      915   .
      916   g#log = session:set-wait-state ("COMPILER") .
      917   ENABLE br-gds-prt
      918          b-exit
      919          b-help
      920          b-rest
      921          b-del
      922          b-exp-nd
      923          b-exp-tree with FRAME d-gds-prt.
      924   run cre-nd (buffer  ub.gds-prt, buffer prt-tree, 0).
      925   find first prt-tree.
      926   run exp-nd (yes).
      927   FRAME d-gds-prt:title =
      928     ub.goods.artic + " " + ub.goods.gds-name + "  -  " + prt-mode.
      929   ENABLE b-sel when prt-mode = 'выбор':U
      930          b-info
      931          b-codes b-alt b-amnt
      932          with FRAME d-gds-prt.
      933   ENABLE flt-amnt with FRAME d-gds-prt.
      934   find first prt-tree.
      935    run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      936   run ui-on.
      937   g#log = session:set-wait-state ( "" ) .
      938   do on endkey undo, leave  on error undo, leave:
      939     WAIT-FOR GO OF FRAME d-gds-prt.
      940   end.
      941   run disable_ui.
      942   PROCEDURE disable_UI :
      943     HIDE FRAME d-gds-prt.
      944   END PROCEDURE.
      945   PROCEDURE UI-on :
      946   find  ub.prt-obj where  ub.prt-obj.prt-code  =  ub.gds-prt.node-code
      947                  and  ub.prt-obj.prod-code = ub.goods.prod-code
      948                  and  ub.prt-obj.prod-type = ub.goods.prod-type
      949                  and  ub.prt-obj.artic     = ub.goods.artic
      950                  and  ub.prt-obj.obj-code  = store-code
      951                  and  ub.prt-obj.obj-type  = store-type
      952                  no-lock no-error.
      953   find ub.doc-line where recid (ub.doc-line) = line-rec no-lock.
      954   old_qnty = ub.doc-line.doc-qnty - ub.doc-line.fact-qnty.
      955   if old_qnty = ? then
      956     if available  ub.prt-obj then
      957       old_qnty =  ub.prt-obj.fact-qnty.
      958     else
      959       old_qnty = 0.
      960   disp ub.goods.unit-base ub.doc-line.doc-qnty
      961       with frame d-gds-prt.
      962   if input frame d-gds-prt flt-amnt then
      963     OPEN QUERY br-gds-prt
      964       FOR EACH  prt-tree where
      965                 prt-tree.visible = yes and
      966                 (prt-tree.is-term = no or
      967                 prt-tree.doc-amnt <> 0 or
      968                 prt-tree.fac-amnt <> 0
      969                 ) no-lock.
      970   else
      971   OPEN QUERY  br-gds-prt
      972     FOR EACH  prt-tree where
      973               prt-tree.visible = yes no-lock.
      974   reposition br-gds-prt to row gds-prt-row no-error.
      975   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
      976   END PROCEDURE.
      977   PROCEDURE calc-tree:
      978   def output param doc-accum like ub.gds-dtl.doc-qnty  no-undo.
      979   def output param fac-accum like ub.gds-dtl.fact-qnty no-undo.
      980   def buffer b-gds-dtl for ub.gds-dtl.
      981   for each b-gds-dtl no-lock where
      982            b-gds-dtl.doc-code  = ub.doc-line.doc-code and
      983            b-gds-dtl.artic     = ub.doc-line.artic and
      984            b-gds-dtl.prod-type = ub.doc-line.prod-type and
      985            b-gds-dtl.prod-code = ub.doc-line.prod-code:
      986     accumulate b-gds-dtl.doc-qnty  (total)
      987                b-gds-dtl.fact-qnty (total)
      988                .
      989   end.
      990   assign
      991     doc-accum  = (accum total b-gds-dtl.doc-qnty)
      992     fac-accum  = (accum total b-gds-dtl.fact-qnty)
      993     .
      994   END PROCEDURE.
      995   PROCEDURE exp-nd :
      996   def input param make-visible as logical no-undo.
      997   define variable nd-level as integer no-undo.
      998   def buffer b-prt-tree for prt-tree.
      999   if prt-tree.exp then do:
     1000     nd-level = prt-tree.level.
     1001     find b-prt-tree where
     1002          recid (b-prt-tree) = recid (prt-tree).
     1003     inverse:
     1004     do while true:
     1005       find next b-prt-tree no-error.
     1006       if not available b-prt-tree then
     1007         leave inverse.
     1008       if b-prt-tree.level > nd-level then do:
     1009         if make-visible = ? then
     1010           make-visible = not (b-prt-tree.visible).
     1011         if not make-visible or
     1012            b-prt-tree.level - nd-level = 1 then do:
     1013           b-prt-tree.visible = make-visible.
     1014           if not b-prt-tree.is-term then
     1015             b-prt-tree.mark = "»".
     1016         end.
     1017       end.
     1018       else
     1019         leave inverse.
     1020     end.
     1021   end.
     1022   else do:
     1023     prt-tree.exp = yes.
     1024     run cre-level (recid (prt-tree), prt-tree.level + 1).
     1025     make-visible = yes.
     1026   end.
     1027   if not prt-tree.is-term then
     1028     if make-visible then
     1029       prt-tree.mark = " ".
     1030     else
     1031       prt-tree.mark = "»".
     1032   END PROCEDURE.
     1033   PROCEDURE exp-tree :
     1034     define variable rid as recid no-undo.
     1035     do
     1036     on error undo, return error return-value
     1037     :
     1038       tree-level = prt-tree.level.
     1039       run waitfram-show in this-procedure
     1040         (input "Раскрывается шкала. Ждите..."
     1041         ).
     1042       tree:
     1043       do while true:
     1044         rid = recid (prt-tree).
     1045         run exp-nd (yes).
     1046         find prt-tree where rid = recid (prt-tree).
     1047         find next prt-tree no-error.
     1048         if not available prt-tree or
     1049           prt-tree.level <= tree-level
     1050           then
     1051           leave tree.
     1052       end.
     1053       run waitfram-hide in this-procedure .
     1054     end.
     1055   END PROCEDURE.
     1056   PROCEDURE cre-level:
     1057   def input param prt-tree-rec as recid   no-undo.
     1058   def input param cur-lev      as integer no-undo.
     1059   def buffer b-gds-prt  for  ub.gds-prt.
     1060   def buffer b-prt-tree for prt-tree.
     1061   define variable up-code like  ub.gds-prt.node-code no-undo.
     1062   find b-prt-tree where
     1063        recid (b-prt-tree) = prt-tree-rec.
     1064   up-code = b-prt-tree.n-code.
     1065   for each b-gds-prt no-lock where
     1066            b-gds-prt.upper-code = up-code
     1067            by b-gds-prt.prt-num:
     1068     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
     1069   end.
     1070   END PROCEDURE.
     1071   PROCEDURE cre-nd:
     1072   def param buffer b-gds-prt  for  ub.gds-prt.
     1073   def param buffer b-prt-tree for prt-tree.
     1074   def input param cur-lev as integer no-undo.
     1075   create b-prt-tree.
     1076   assign
     1077     b-prt-tree.n-code   = b-gds-prt.node-code
     1078     b-prt-tree.level    = cur-lev
     1079     b-prt-tree.n-name   = b-gds-prt.node-name
     1080     b-prt-tree.rid      = recid (b-gds-prt)
     1081     b-prt-tree.visible  = yes
     1082     b-prt-tree.is-term  = b-gds-prt.is-term
     1083     b-prt-tree.is-root  = b-gds-prt.root
     1084     .
     1085   if b-gds-prt.is-term then
     1086     assign
     1087       b-prt-tree.mark = " "
     1088       b-prt-tree.exp = yes
     1089       .
     1090   else
     1091     assign
     1092       b-prt-tree.mark = "»"
     1093       b-prt-tree.exp = no
     1094       .
     1095   run clc-nd (buffer b-prt-tree).
     1096   END PROCEDURE.
     1097   PROCEDURE clc-nd:
     1098   def param buffer b-prt-tree for prt-tree.
     1099   def buffer b-gds-prt for  ub.gds-prt.
     1100   find b-gds-prt no-lock where
     1101        recid (b-gds-prt) = b-prt-tree.rid.
     1102   find  ub.prt-obj no-lock where
     1103          ub.prt-obj.prt-code  = b-gds-prt.node-code and
     1104          ub.prt-obj.obj-type  = store-type and
     1105          ub.prt-obj.obj-code  = store-code and
     1106          ub.prt-obj.artic     = ub.goods.artic and
     1107          ub.prt-obj.prod-type = ub.goods.prod-type and
     1108          ub.prt-obj.prod-code = ub.goods.prod-code no-error.
     1109   if available  ub.prt-obj then do:
     1110     assign
     1111       b-prt-tree.free-qnty  =  ub.prt-obj.free-qnty
     1112       b-prt-tree.fact-qnty  =  ub.prt-obj.fact-qnty
     1113       .
     1114     b-prt-tree.price =  ub.prt-obj.price-sale.
     1115   end.
     1116   find  ub.gds-dtl no-lock where
     1117         ub.gds-dtl.artic = ub.doc-line.artic and
     1118         ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     1119         ub.gds-dtl.prod-type = ub.doc-line.prod-type and
     1120         ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     1121         ub.gds-dtl.prt-code = b-gds-prt.node-code no-error.
     1122   if available  ub.gds-dtl then
     1123     assign
     1124       b-prt-tree.doc-amnt =  ub.gds-dtl.doc-qnty
     1125       b-prt-tree.fac-amnt =  ub.gds-dtl.fact-qnty
     1126       .
     1127   else
     1128     assign
     1129       b-prt-tree.fac-amnt = 0
     1130       b-prt-tree.doc-amnt = 0
     1131       .
     1132   find  ub.bar-code no-lock where
     1133         ub.bar-code.gds-code  = ub.goods.gds-code and
     1134         ub.bar-code.node-code = b-gds-prt.node-code and
     1135         ub.bar-code.part-code = "" and
     1136         ub.bar-code.in-code   = "" and
     1137         ub.bar-code.unit-cli  = ub.goods.unit-base no-error.
     1138   if available ub.bar-code then
     1139     b-prt-tree.bc = ub.bar-code.b-code.
     1140   else
     1141     b-prt-tree.bc = ?.
     1142   END PROCEDURE.
     1143   PROCEDURE cre-code:
     1144   define variable is-new as log no-undo.
     1145   def buffer buf_bar-code for ub.bar-code.
     1146     if not prt-tree.is-term and
     1147        not prt-tree.is-root then do:
     1148       message
     1149         "Узел промежуточный. Работа с кодами запрещена."
     1150         view-as alert-box error.
     1151       return error.
     1152     end.
     1153     if prt-tree.bc = ? then do:
     1154       g#log = no.
     1155       message "Основной код для данного признака отсутствует. Создать код?"
     1156               view-as alert-box question buttons YES-NO update g#log.
     1157       if not g#log then
     1158         return error.
     1159   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   do:
     1161     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1162       (input  v-cntxt-db-num
     1163       ,input  v-cntxt-userid
     1164       ,input  0
     1165       ,input  'actn_main-barcode_preparation':U
     1166       ,input  'global':U
     1167       ,input  0
     1168       ,input  '':U
     1169       ,input  0
     1170       ,input  0
     1171       ,input  0
     1172       ,input  0
     1173       ,input  true
     1174       ,output g#log
     1175       )  .
     1176   end.
     1177       if not g#log then do:
     1178         return error.
     1179       END.
     1180   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1182     (input  ub.goods.gds-code
     1183     ,input  prt-tree.n-code
     1184     ,input  ''
     1185     ,input  ''
     1186     ,input  ub.goods.unit-base
     1187     ,input  1
     1188     ,output is-new
     1189     ,buffer buf_bar-code
     1190     ) no-error .
     1191       if error-status :error then do:
     1192         message
     1193           "Ошибка поиска / создания основного кода." skip
     1194           "Код товара:"        ub.goods.gds-code skip
     1195           "Код признака:"      prt-tree.n-code skip
     1196           "Единица измерения:" ub.goods.unit-base skip
     1197           error-status :get-message(1) skip
     1198           return-value skip
     1199           view-as alert-box error.
     1200         return error.
     1201       end.
     1202       prt-tree.bc = buf_bar-code.b-code.
     1203       disp prt-tree.bc with browse br-gds-prt.
     1204     end.
     1205   end.
     1206   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   procedure local-gds_inf :
     1208     for each tt-goods
     1209     :
     1210       delete tt-goods.
     1211     end.
     1212     for each tt-clients
     1213     :
     1214       delete tt-clients.
     1215     end.
     1216     create tt-goods.
     1217     buffer-copy ub.goods to tt-goods.
     1218     create tt-clients.
     1219     assign
     1220       tt-clients.obj-type = store-type
     1221       tt-clients.obj-code = store-code
     1222     .
     1223     define variable v-ok as logical   no-undo .
     1224     define variable v-chk-act-host-code as integer   no-undo .
     1225   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1227     (input  tt-clients.obj-type
     1228     ,input  tt-clients.obj-code
     1229     ,output v-chk-act-host-code
     1230     )  .
     1231   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1232   do:
     1233     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1234       (input  v-cntxt-db-num
     1235       ,input  v-cntxt-userid
     1236       ,input  0
     1237       ,input  'actn_reference_archive':U
     1238       ,input  'firm':U
     1239       ,input  v-chk-act-host-code
     1240       ,input  '':U
     1241       ,input  0
     1242       ,input  0
     1243       ,input  0
     1244       ,input  0
     1245       ,input  true
     1246       ,output v-ok
     1247       )  .
     1248   end.
     1249     if v-ok then do:
     1250       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
     1251     end.
     1252   end procedure.
