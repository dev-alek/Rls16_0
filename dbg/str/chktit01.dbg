        1   block-level on error undo, throw.
        2   define input-output parameter p-rid as recid no-undo .
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-doc-code like ub.chk-doc.doc-code no-undo .
        5   define input parameter p-doc-type as integer no-undo .
        6   define input parameter p-chk-type like ub.chk-doc.chk-type no-undo .
        7   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        8   define input parameter p-obj-type like ub.chk-doc.obj-type no-undo .
        9   define input parameter p-obj-code like ub.chk-doc.obj-code no-undo .
       10   define input parameter p-chk-date like ub.chk-doc.chk-date no-undo .
       11   define input parameter p-chk-time like ub.chk-doc.chk-time no-undo  .
       12   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
       13   define input parameter p-shift-num like ub.chk-doc.shift-num no-undo .
       14   define input parameter p-shift-name like ub.chk-doc.shift-name no-undo .
       15   define input parameter p-pay-desk like ub.chk-doc.pay-desk no-undo .
       16   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
       17   define input-output parameter p-cash-rate like ub.chk-doc.cash-rate no-undo .
       18   define input parameter p-cashier like ub.chk-doc.cashier no-undo .
       19   define input parameter p-sales-man like ub.chk-doc.sales-man no-undo .
       20   define input parameter p-d-card like ub.chk-doc.d-card no-undo .
       21   define input parameter p-chk-num like ub.chk-doc.chk-num no-undo .
       22   define input parameter p-z-number like ub.chk-doc.z-number no-undo .
       23   define input parameter p-PS like ub.chk-doc.PS no-undo .
       24   define input parameter p-lines-exist as logical no-undo .
       25   define input parameter r-b as character no-undo .
       26   define input parameter cas-shft as logical no-undo .
       27   define input parameter l-shift-on as logical no-undo .
       28   define input parameter t-shft as integer no-undo .
       29   define input parameter v-shft as integer no-undo .
       30   define input parameter cas-curs as logical no-undo .
       31   define input parameter hnum as logical no-undo .
       32   define output parameter par-chk-type as character no-undo .
       33   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       34   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       35   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       36   define variable vss-workfile    as character no-undo init "$Workfile: chktit01.p $":U .
       37   define variable vss-archive     as character no-undo init "$Archive: str/chktit01.p $":U .
       38   define variable vss-description as character no-undo init "Сохранение изменений в чеке МЦ".
       39   procedure vss-get-info :
       40     define output parameter p-vss-revision    like vss-revision    no-undo .
       41     define output parameter p-vss-author      like vss-author      no-undo .
       42     define output parameter p-vss-date        like vss-date        no-undo .
       43     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       44     define output parameter p-vss-archive     like vss-archive     no-undo .
       45     define output parameter p-vss-description like vss-description no-undo .
       46     assign
       47       p-vss-revision    = vss-revision
       48       p-vss-author      = vss-author
       49       p-vss-date        = vss-date
       50       p-vss-workfile    = vss-workfile
       51       p-vss-archive     = vss-archive
       52       p-vss-description = vss-description
       53     .
       54   end procedure.
       55   procedure vss-get-parameters :
       56     define output parameter p-vss-parameters as character no-undo .
       57   end procedure.
       58   define new global shared variable g#vssrevis-logger as handle    no-undo .
       59   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       60   define variable v-vssrevis-logger                   as handle    no-undo .
       61   procedure vss-logevent :
       62     define input  parameter p-extra-paramters as character no-undo .
       63     define variable v-vssrevis-parameters as character no-undo .
       64     do
       65     on error undo, return error return-value
       66     :
       67       if  valid-handle(v-vssrevis-logger)
       68       and v-vssrevis-logger :get-signature("logevent") <> ""
       69       then do:
       70         run vss-get-parameters in this-procedure
       71           (output v-vssrevis-parameters
       72           ).
       73         run logevent in v-vssrevis-logger
       74           (input vss-workfile
       75           ,input vss-revision
       76           ,input v-vssrevis-parameters
       77           ,input p-extra-paramters
       78           ).
       79       end.
       80     end.
       81   end procedure.
       82   assign
       83     v-vssrevis-logger = g#vssrevis-logger
       84   .
       85   if  valid-handle(v-vssrevis-logger)
       86   and v-vssrevis-logger :get-signature("logevent") <> ""
       87   then do:
       88     assign
       89       v-vssrevis-logevent = true
       90     .
       91     run vss-logevent in this-procedure (input vss-description) .
       92   end.
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   DEFINE VARIABLE varcash-rate like ub.curr-shop.exch-rate no-undo .
       98   define buffer buf_chk-doc for ub.chk-doc.
       99   do
      100   on error undo, return error return-value
      101   :
      102   varcash-rate = p-cash-rate.
      103   if lookup(string(p-chk-type), '2,3,4,5,7':U) = 0 then do:
      104     message
      105     substitute("Неверный типа чека = &1", p-chk-type)
      106     view-as alert-box error .
      107     undo, return error .
      108   end.
      109   run trg/chktit02.p (
      110                   input (if p-mode = 'ДОБАВЛЕНИЕ':U then yes else no)
      111                  ,input p-doc-code
      112                  ,input p-doc-type
      113                  ,input p-host-code
      114                  ,input p-obj-type
      115                  ,input p-obj-code
      116                  ,input p-chk-date
      117                  ,input p-chk-time
      118                  ,input p-shift-date
      119                  ,input p-shift-num
      120                  ,input p-shift-name
      121                  ,input p-pay-desk
      122                  ,input p-pos-type
      123                  ,input-output varcash-rate
      124                  ,input p-cashier
      125                  ,input p-sales-man
      126                  ,input p-d-card
      127                  ,input p-z-number
      128                  ,input p-PS
      129                  ,input p-lines-exist
      130                  ,input r-b
      131                  ,input cas-shft
      132                  ,input l-shift-on
      133                  ,input t-shft
      134                  ,input v-shft
      135                  ,input cas-curs
      136                  ,input hnum
      137               ) no-error.
      138   if error-status:error then undo, return error return-value.
      139   if return-value <> "":U then do:
      140   end.
      141   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      142     FIND FIRST buf_chk-doc No-LOCK WHERE
      143               buf_chk-doc.obj-type = p-obj-type and
      144               buf_chk-doc.obj-code = p-obj-code and
      145               buf_chk-doc.chk-date = p-chk-date and
      146               buf_chk-doc.pay-desk = p-pay-desk and
      147               buf_chk-doc.chk-time = p-chk-time and
      148               buf_chk-doc.chk-num  = p-chk-num NO-ERROR .
      149     if avail buf_chk-doc and not recid(buf_chk-doc) = p-rid then do:
      150       message  substitute( "Уже есть чек МЦ&1магазин &2&1касса &3&1дата чека &4&1" +
      151                                "время чека &5&1номер чека на кассе &6"
      152                                ,p-obj-code
      153                                ,p-pay-desk
      154                                ,string(p-chk-date, "99/99/9999")
      155                                ,string(p-chk-time, "HH:MM")
      156                                ,p-chk-num )
      157       view-as alert-box error .
      158       undo, return error '':U.
      159     end.
      160   end.
      161   if p-lines-exist and
      162      not can-find (first ub.chk-pay No-LOCK WHERE
      163                          ub.chk-pay.doc-code = p-doc-code) then do:
      164     undo, return error substitute("В чеке МЦ &1 отсутствуют строки&2Сохранение невозможно"
      165                             , p-doc-code
      166                             , chr(10)).
      167   end.
      168   if p-mode = 'ДОБАВЛЕНИЕ':U and p-rid = ? then do:
      169     create buf_chk-doc.
      170     assign p-rid = recid(buf_chk-doc).
      171   end.
      172   else do:
      173     FIND FIRST buf_chk-doc EXCLUSIVE-LOCK WHERE
      174               recid(buf_chk-doc) = p-rid NO-WAIT No-ERROR.
      175     if locked buf_chk-doc then do:
      176       undo, return error substitute("Чек МЦ &1 занят", p-doc-code).
      177     end.
      178     if not avail buf_chk-doc then do:
      179       undo, return error substitute("Не найден чек МЦ &1", p-doc-code).
      180     end.
      181     if buf_chk-doc.out-code <> ? then do:
      182       undo, return error substitute("Чек МЦ &1&2Включен в документ&2Изменение невозможно"
      183                               ,p-doc-code
      184                               , chr(10)).
      185     end.
      186     if p-chk-type <> buf_chk-doc.chk-type AND
      187        can-find(first ub.chk-pay where ub.chk-pay.doc-code = buf_chk-doc.doc-code) then do:
      188       message vss-workfile vss-revision vss-description skip
      189       "Неверный вызов - с изменением типа чека МЦ"
      190       view-as alert-box error .
      191       undo, return error '':U.
      192     end.
      193   end.
      194   assign
      195   buf_chk-doc.doc-code = p-doc-code
      196   buf_chk-doc.obj-type = p-obj-type
      197   buf_chk-doc.obj-code = p-obj-code
      198   buf_chk-doc.chk-type = p-chk-type
      199   buf_chk-doc.chk-date = p-chk-date
      200   buf_chk-doc.chk-time = p-chk-time
      201   buf_chk-doc.src-shift-date = p-shift-date
      202   buf_chk-doc.shift-date = if t-shft < 0 AND buf_chk-doc.chk-time < abs(t-shft)
      203                         then (buf_chk-doc.chk-date - 1)
      204                         else (if buf_chk-doc.src-shift-date = ?
      205                               then buf_chk-doc.chk-date
      206                               else buf_chk-doc.src-shift-date)
      207   buf_chk-doc.shift-num = p-shift-num
      208   buf_chk-doc.shift-name = p-shift-name
      209   buf_chk-doc.pay-desk = p-pay-desk
      210   buf_chk-doc.cash-rate = if cas-curs then p-cash-rate else varcash-rate
      211   buf_chk-doc.cashier = p-cashier
      212   buf_chk-doc.sales-man = p-sales-man
      213   buf_chk-doc.d-card = p-d-card
      214   buf_chk-doc.chk-num = p-chk-num
      215   buf_chk-doc.z-number = p-z-number
      216   buf_chk-doc.ps = p-ps
      217   buf_chk-doc.correct = yes
      218   buf_chk-doc.office = ?
      219   buf_chk-doc.out-code = ?
      220   buf_chk-doc.tot-doc = 0
      221   buf_chk-doc.netto = 0
      222   buf_chk-doc.discnt = 0
      223   buf_chk-doc.d-pcnt = 0
      224   buf_chk-doc.src-d-pcnt = 0
      225   buf_chk-doc.doc-qnty = 0
      226   buf_chk-doc.src-tot-doc = 0
      227   buf_chk-doc.src-d-mask = ''
      228   buf_chk-doc.d-mask = ''
      229   buf_chk-doc.d-card = ''
      230   buf_chk-doc.src-d-card = ''
      231   buf_chk-doc.src-cli-type = ?
      232   buf_chk-doc.src-cli-code = ?
      233   buf_chk-doc.cli-type = ?
      234   buf_chk-doc.cli-code = ?
      235   buf_chk-doc.doc-num2 = ?
      236   buf_chk-doc.out-2-code = ?
      237   .
      238   if p-mode = 'ДОБАВЛЕНИЕ':U or p-rid <> ? then release buf_chk-doc no-error.
      239   if error-status:error then undo, return error substitute("Ошибка при сохранения чека МЦ:&1&2&1&3", chr(10), error-status:get-message(1) , return-value ).
      240   return '':U.
      241   end.
