     3791   define variable v-b-code as integer no-undo .
     3792   define temp-table temp-cd-clu no-undo like ub.cd-clu.
     3793   define buffer buf_dis-card-property for ub.dis-card-property.
     3794   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3795     define variable v-cntxt-db-num        as integer   no-undo .
     3796     define variable v-cntxt-userid        as character no-undo .
     3797     define variable v-cntxt-level         as character no-undo .
     3798     define variable v-cntxt-host-code-obj as integer   no-undo .
     3799     define variable v-cntxt-obj-type      as character no-undo .
     3800     define variable v-cntxt-obj-code      as integer   no-undo .
     3801     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3802     define variable v-cntxt-is-admin      as logical   no-undo .
     3803   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     3804   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3805   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     3806   procedure disrules-fill-properties:
     3807   define input  parameter p-templ-rl-root as integer   no-undo .
     3808   define buffer buf_drt-prop for ub.drt-prop.
     3809   define buffer buf_temp-drt-prop for temp-drt-prop.
     3810   do
     3811   on error undo, return error return-value
     3812   :
     3813     for each buf_temp-drt-prop:
     3814       delete buf_temp-drt-prop.
     3815     end.
     3816     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     3817       create buf_temp-drt-prop.
