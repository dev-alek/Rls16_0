     5260     cash-cli.is-pboul  = ub.firm.is-pboul
     5261     cash-cli.okonh     = trim(ub.firm.okonh)
     5262     cash-cli.okpo      = trim(ub.firm.okpo)
     5263     cash-cli.phone1-note  = trim(ub.firm.phone1-note)
     5264     cash-cli.post-addr1 = trim( ub.firm.post-addr1 )
     5265     cash-cli.post-addr2 = trim( ub.firm.post-addr2 )
     5266     cash-cli.cli-inn = trim(ub.firm.inn)
     5267     cash-cli.cli-phone = trim(ub.firm.phone)
     5268     cash-cli.cli-ind = ub.firm.ind
     5269     cash-cli.justface = 1
     5270     cash-cli.kpp     = ub.firm.kpp
     5271     .
     5272   end.
     5273   else do:
     5274     if ub.clients.obj-type = 'чел':U then do:
     5275       FIND ub.person WHERE ub.person.psn-code = ub.clients.obj-code .
     5276       assign
     5277       cash-cli.cli-type = 'чел':U
     5278       cash-cli.cli-code = ub.clients.obj-code
     5279       cash-cli.cli-city = ub.person.city
     5280       cash-cli.cli-adr = trim( ub.person.address )
     5281       cash-cli.cli-inn = trim(ub.person.inn)
     5282       cash-cli.cli-phone = trim(ub.person.phone1)
     5283       cash-cli.cli-ind = ub.person.ind
     5284       cash-cli.phone1  = trim(ub.person.phone1)
     5285       cash-cli.e-mail = trim( ub.person.e-mail )
     5286       cash-cli.fax     = trim( ub.person.fax)
     5287       cash-cli.position  = trim( ub.person.position)
     5288       cash-cli.is-pboul  = ub.person.is-pboul
     5289       cash-cli.okonh     = trim(ub.person.okonh)
     5290       cash-cli.okpo      = trim(ub.person.okpo)
     5291       cash-cli.post-box  = trim(ub.person.post-box)
     5292       cash-cli.justface = 0
     5293       cash-cli.kpp     = ub.person.kpp
     5294       .
     5295     end.
     5296     else do:
     5297       NEXT .
     5298     end.
     5299   end.
     5300   assign
     5301   cash-cli.mask-card     = ub.dis-card.mask-card
     5302   cash-cli.current-saldo =  (if ub.dis-card.credit-card = yes
