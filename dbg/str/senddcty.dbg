     4680                                                 , input 1 ).
     4681           if cash-cli.cli-name2 <> "":u then
     4682           run bgelib-tag-put in this-procedure ( input 3, input "ClientName2"       , input  cash-cli.cli-name2, input 1 ).
     4683           if cash-cli.cli-name3 <> "":u then
     4684           run bgelib-tag-put in this-procedure ( input 3, input "ClientName3"       , input  cash-cli.cli-name3, input 1 ).
     4685           if cash-cli.cli-city <> "":u then
     4686           run bgelib-tag-put in this-procedure ( input 3, input "ClientCity"       , input cash-cli.cli-city, input 1 ).
     4687           if cash-cli.cli-adr <> "":u then
     4688           run bgelib-tag-put in this-procedure ( input 3, input "ClientAddress"    , input cash-cli.cli-adr, input 1 ).
     4689           if string(cash-cli.cli-ind) <> "":u then
     4690           run bgelib-tag-put in this-procedure ( input 3, input "ClientIndex"      , input string(cash-cli.cli-ind), input 1 ).
     4691           if cash-cli.cli-phone <> "":u then
     4692           run bgelib-tag-put in this-procedure ( input 3, input "ClientPhone"      , input cash-cli.cli-phone, input 1 ).
     4693           if cash-cli.cli-INN <> "":u then
     4694           run bgelib-tag-put in this-procedure ( input 3, input "ClientINN"        , input cash-cli.cli-inn, input 1 ).
     4695           run bgelib-tag-put in this-procedure ( input 3, input "ClientJustFace"   , input string(cash-cli.justface), input 1 ).
     4696           if cash-cli.passport <> "":u
     4697           and cash-cli.passport <> chr(4)
     4698           then
     4699           run bgelib-tag-put in this-procedure ( input 3, input "ClientPassport"    ,
     4700                                                           input replace(cash-cli.passport, chr(4), chr(32)) , input 1 ).
     4701           if cash-cli.given-by <> "":u then
     4702           run bgelib-tag-put in this-procedure ( input 3, input "ClientPassportPlace" , input cash-cli.given-by, input 1 ).
     4703         if cash-cli.emitent-host-code = 0 then  do:
     4704           assign
     4705           v-r-b-code = 0
     4706           no-error
     4707           .
     4708         end.
     4709         else do:
     4710   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     4712     (input  ub.shop.host-code
     4713     ,output v-r-b-code
     4714     )  .
     4715         end.
     4716         if error-status:error then do:
     4717           return error
     4718           substitute("Карта &1:не удалось определить код валюты продажи для типа карт &2: код эмитента &3"
     4719                     ,  cash-cli.d-card
     4720                     , cash-cli.type
     4721                     ,  cash-cli.emitent-host-code
     4722                     ).
     4723         end.
     4724         else do:
     4725           if cash-cli.pay-code <> 0 then do:
     4726             find first buf_cash-pay no-lock where
     4727                       buf_cash-pay.cdpay-code = cash-cli.pay-code
     4728                   AND buf_cash-pay.curr-code = v-r-b-code no-error .
     4729             if error-status:error then do:
     4730               return error
     4731               substitute("Карта &1:не найден тип кассового платежа для типа карт &2: код платежа &3, код валюты &4"
     4732                         ,  cash-cli.d-card
     4733                         , cash-cli.type
     4734                         ,  cash-cli.pay-code
     4735                         , v-r-b-code).
     4736             end.
     4737             find first buf_currency no-lock where
     4738                       buf_Currency.curr-code = v-r-b-code no-error .
     4739             if error-status:error then do:
     4740               return error
     4741             substitute("Карта &1:не найдена валюта для типа кассового платежа для типа карт &2: код платежа &3, код валюты &4"
     4742                       ,  cash-cli.d-card
     4743                       , cash-cli.type
     4744                       ,  cash-cli.pay-code
     4745                       , v-r-b-code).
     4746             end.
     4747           end.
     4748         end.
     4749         assign
     4750         v-magia-card-operation = if cash-cli.credit-card then 1
     4751                                   else (if cash-cli.staff-card
     4752                                         then 3
     4753                                         else ( if cash-cli.debet-card
     4754                                               then 2
     4755                                               else 0
     4756                                               )
     4757                                       )
     4758         v-magia-curr-code = (if available buf_cash-pay
     4759                             then (if buf_cash-pay.is-cash
     4760                                     then (if buf_currency.curr-code = 0 then 1 else buf_currency.okv-code)
     4761                                     else (10000 + cash-cli.pay-code)
     4762                                     )
     4763                             else ?)
     4764         .
     4765         run bgelib-tag-put in this-procedure ( input 3, input "ClientCode"       , input string(cash-cli.cli-code + 1000000000 * cash-cli.justface), input 1 ).
     4766         run bgelib-tag-put in this-procedure ( input 3, input "CardDisCat"       , input string(v-magia-kat-pcnt), input 1 ).
     4767         run bgelib-tag-put in this-procedure ( input 3, input "CardType"        , input string(cash-cli.card-media), input 1 ).
     4768         run bgelib-tag-put in this-procedure ( input 3, input "CardOperation"   , input string(v-magia-card-operation), input 1 ).
     4769         run bgelib-tag-put in this-procedure ( input 3, input "CardNumber"      , input v-full-number, input 1 ).
     4770         if cash-cli.cli-message <> ?
     4771         then
     4772         run bgelib-tag-put in this-procedure ( input 3, input "CardMessage"     , input string(cash-cli.cli-message), input 1 ).
     4773         run bgelib-tag-put in this-procedure ( input 3, input "CardFiscal"      ,  input string(if cash-cli.fiscal-pay then 1 else 0), input 1 ).
     4774         if v-magia-curr-code <> ? then
     4775         run bgelib-tag-put in this-procedure ( input 3, input "CardCurrCode"    ,  input string(v-magia-curr-code), input 1 ).
     4776         run bgelib-tag-put in this-procedure ( input 3, input "CardMixedPay"    ,  input string(if cash-cli.mixed-pay then 1 else 0), input 1 ).
     4777         run bgelib-tag-put in this-procedure ( input 3, input "CardSaldo"        , input string(cash-cli.current-saldo), input 1 ).
     4778         run bgelib-tag-put in this-procedure ( input 3, input "CardLimit"        , input string(- cash-cli.lim-kr), input 1 ).
     4779         run bgelib-tag-put in this-procedure ( input 3, input "CardLock"         ,
     4780                                             input string(if lookup('тек':U, cash-cli.status_ ) > 0
     4781                                                                 then 0
     4782                                                                 else 1
     4783                                                         )
     4784                                                         , input 1 ).
     4785         run bgelib-tag-close in this-procedure ( input 2, input "Card").
     4786       end.
     4787     end.
     4788     when 'IPC-Servis+':U then  do:
     4789       FIND FIRST ub.dis-card-type No-LOCK WHERE
     4790                   ub.dis-card-type.type = cash-cli.type AND
     4791                   ub.dis-card-type.emitent-host-code = cash-cli.emitent-host-code AND
     4792                   ub.dis-card-type.host-code = 0 AND
     4793                   ub.dis-card-type.obj-type = "":U AND
     4794                   ub.dis-card-type.obj-code = 0 No-ERROR.
     4795       if not cash-cli.mask-card then do:
     4796         PUT UNFORMATTED
     4797         (ub.dis-card-type.dc-pfx + cash-cli.d-card) ","
     4798         '"' caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)")) '"' ","
     4799         string( if cash-cli.d-pcnt-byshop
     4800               then (v-d-pcnt)
     4801               else ( cash-cli.d-pcnt ) , "->>9.99" ) ","
     4802         string( 0, ">>>>>>>>9")
     4803         SKIP.
     4804       end.
     4805     end.
     4806     when 'OMRON':U then do:
     4807       if not cash-cli.mask-card then do:
     4808         PUT unformatted
     4809         string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     4810         "000000000000"
     4811         caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     4812         fill( " ", 20)
     4813         caps( string( cash-cli.cli-adr , "x(25)" ) )
     4814         caps( string( cash-cli.cli-city , "x(20)" ) )
     4815         string( cash-cli.cli-ind, ">>>>>9" )
     4816         fill(" ", 14)
     4817         fill(" ", 14)
     4818         string(today, "999999")
     4819         (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     4820                 (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     4821                 else "D":U)
     4822                 else string( action, "x(1)" )
     4823                 )
     4824         string( if cash-cli.d-pcnt-byshop
     4825                 then ( round(v-d-pcnt, 2) * 100 )
     4826                 else ( round(cash-cli.d-pcnt, 2) * 100 )
     4827               , "9999" )
     4828         SKIP
     4829         .
     4830       end.
     4831     end.
     4832     when 'OMRON-NEW':U then  do:
     4833       if not cash-cli.mask-card then do:
     4834         assign
     4835         v-versiond = decimal(p-version)
     4836         no-error .
     4837         if v-versiond >= 33.0 then do:
     4838           PUT unformatted
     4839           string( fill( "0", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     4840           "000000000000"
     4841           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     4842           fill( " ", 20)
     4843           caps( string( cash-cli.cli-adr , "x(25)" ) )
     4844           caps( string( cash-cli.cli-city , "x(20)" ) )
     4845           string( cash-cli.cli-ind, ">>>>>9" )
     4846           fill(" ", 14)
     4847           fill(" ", 14)
     4848           string(today, "999999")
     4849           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     4850                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     4851                   else "D":U)
     4852                   else string( action, "x(1)" )
     4853                   )
     4854           string( if cash-cli.d-pcnt-byshop
     4855                   then ( round(v-d-pcnt, 2) * 100 )
     4856                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     4857                 , "9999" )
     4858           replace(string(today, "99/99/9999"), chr(47), "":U)
     4859           '00':U
     4860           '000':U
     4861           fill( chr(32) , 31)
     4862           SKIP.
     4863         end.
     4864         else do:
     4865           PUT unformatted
     4866           string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     4867           "000000000000"
     4868           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     4869           fill( " ", 20)
     4870           caps( string( cash-cli.cli-adr , "x(25)" ) )
     4871           caps( string( cash-cli.cli-city , "x(20)" ) )
     4872           string( cash-cli.cli-ind, ">>>>>9" )
     4873           fill(" ", 14)
     4874           fill(" ", 14)
     4875           string(today, "999999")
     4876           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     4877                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     4878                   else "D":U)
     4879                   else string( action, "x(1)" )
     4880                   )
     4881           string( if cash-cli.d-pcnt-byshop
     4882                   then ( round(v-d-pcnt, 2) * 100 )
     4883                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     4884                 , "9999" )
     4885           SKIP
     4886           .
     4887         end.
     4888       end.
     4889     end.
     4890     when 'NCR-GM':U
     4891     or when 'NCR-AS@R':U
     4892     then do:
     4893       if length(cash-cli.d-card) > (if pos-type = 'NCR-GM':U then 10 else 12) then do:
     4894         if not (g#news or g#esys) then  do:
     4895           run write-log-and-file in p-log-handle (
     4896                 input 1
     4897               , input log-file-name
     4898               , input 1
     4899               , input substitute("!Ошибка при пересылке на кассу: Данные по дисконтной карте &1 не могут быть переданы на кассу NCR"
     4900                      , cash-cli.d-card )
     4901                                                 ).
     4902         end.
     4903         return .
     4904       end.
     4905       if cash-cli.kat-pcnt <> 0
     4906       AND (cash-cli.kat-pcnt < 10
     4907       or cash-cli.kat-pcnt > 99)
     4908       then do:
     4909         if not (g#news or g#esys) then  do:
     4910           run write-log-and-file in p-log-handle (
     4911                 input 1
     4912               , input log-file-name
     4913               , input 1
     4914               , input substitute("!Ошибка при пересылке на кассу:&2Данные по дисконтной карте &1 не могут быть переданы на кассу NCR&2" +
     4915                                  "Неверное значение категории карты: &3"
     4916                                  , cash-cli.d-card
     4917                                  , chr(10)
     4918                                  , cash-cli.kat-pcnt
     4919                                  )
     4920                                                 ).
     4921         end.
     4922         return .
     4923       end.
     4924       if not cash-cli.mask-card then do:
     4925         if (g#news or g#esys or run-from = "O":U or run-from = "E":U ) and
     4926             lookup('тек':U, cash-cli.status_ ) = 0  or
     4927             action = "D":U then do:
     4928           PUT stream IBMstream unformatted
     4929           "C1":U
     4930           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     4931           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     4932           "-":U
     4933           fill("-":U, 61)
     4934           chr(10)
     4935           "C2":U
     4936           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     4937           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     4938           "-":U
     4939           fill("-":U, 61)
     4940           chr(10)
     4941           .
     4942         end.
     4943         else do:
     4944           PUT stream IBMstream unformatted
     4945           "C1":U
     4946           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     4947           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     4948           "00":U
     4949           string(cash-cli.kat-pcnt, "99")
     4950           replace(string((if cash-cli.d-pcnt-method = integer('1':U)
     4951                         or cash-cli.d-pcnt-method = integer('3':U)
     4952                         then cash-cli.d-pcnt
     4953                         else 0), "999.9":U ), ".":U, "")
     4954           replace(string((if cash-cli.d-pcnt-method = integer('2':U)
     4955                         or cash-cli.d-pcnt-method = integer('3':U)
     4956                         then cash-cli.cash-d-pcnt
     4957                         else 0), "999.9":U ), ".":U, "")
     4958           "0000":U
     4959           "00000000":U
     4960           replace(string(cash-cli.lim-kr, "999999.99":U ), ".":U, "":U)
     4961           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(30)" ) )
     4962           chr(10)
     4963           "C2":U
     4964           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     4965           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     4966           fill(chr(32), 2)
     4967           caps( string( cash-cli.cli-adr , "x(30)" ) )
     4968           (if cash-cli.property-value-chr[1] <> '':U
     4969           then (cash-cli.property-value-chr[1] + chr(32) + cash-cli.property-value-chr[2])
     4970           else
     4971           (string( cash-cli.cli-ind, ">>>>>9" ) + chr(32) + caps( string( cash-cli.cli-city , "x(23)" ) ))
     4972           )
     4973           chr(10)
     4974           .
     4975         end.
     4976       end.
     4977     end.
     4978     when 'r-keeper':U then do:
     4979       if g#news
     4980       or g#esys
     4981       or action <> "D"
     4982       and not cash-cli.mask-card
     4983       then do:
     4984         if length(cash-cli.d-card) > 9 then do:
     4985           run write-log-and-file in p-log-handle (
     4986                 input 1
     4987               , input log-file-name
     4988               , input 1
     4989               , input substitute("!Невозможно переслать на кассу типа &1 карту &2: слишком длинный номер карты"
     4990                                 , cash-cli.d-card
     4991                                 , 'r-keeper':U
     4992                                 )
     4993                                                 ).
     4994         end.
     4995         put stream IBMStream unformatted
     4996         cash-cli.d-card chr(44)
     4997         windows-date-format(if cash-cli.valid-date = 12/31/9999
     4998                then (today + 36500)
     4999                else cash-cli.valid-date, v-date-format) chr(44)
     5000         chr(44)
     5001         chr(44)
     5002         chr(44)
     5003         entry(1, cash-cli.cli-name, chr(4)) chr(44)
     5004         (if not cash-cli.credit-card
     5005         then 0
     5006         else 4
     5007         )  chr(44)
     5008       cash-cli.lim-kr
     5009         skip.
     5010       end.
     5011     end.
     5012     when 'MARIA':U then do:
     5013       if p-send-cli then do:
     5014         find first buf_cd-clu EXCLUSIVE-LOCK where
     5015                   buf_cd-clu.obj-type = 'маг':U
     5016               and buf_cd-clu.obj-code = abs((if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code))
     5017               and buf_cd-clu.pos-type = 'MARIA':U
     5018               and buf_cd-clu.clu-type = '':U
     5019               AND buf_cd-clu.cli-type = cash-cli.cli-type
     5020               AND buf_cd-clu.cli-code = cash-cli.cli-code  NO-ERROR.
     5021         if not available buf_cd-clu then do:
     5022           if v-del-mrkt-cli = no then do:
     5023             run write-log-and-file in p-log-handle (
     5024                   input 1
     5025                 , input log-file-name
     5026                 , input 1
     5027                 , input substitute("!!!Клиент &1&2 &3 не включен в число КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     5028                                     "пропускается...."
     5029                                     , cash-cli.cli-type
     5030                                     , cash-cli.cli-code
     5031                                     , cash-cli.obj-name
     5032                                     , pos-type
     5033                                     , 'маг':U
     5034                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     5035                                     , chr(10)
     5036                                     )
     5037                                       ).
     5038           end.
     5039         end.
     5040         assign
     5041         v-clu = buf_cd-clu.clu-code.
     5042         if (buf_cd-clu.to-del and v-del-mrkt-cli)
     5043         or action = "D" then do:
     5044           assign
     5045           v-marketer-action = "D":U.
     5046           if v-del-mrkt-cli then do:
     5047             create temp-cd-clu.
     5048             buffer-copy buf_cd-clu
     5049             to temp-cd-clu
     5050             assign
     5051             buf_cd-clu.charkey_one = v-cd-list-delete
     5052             .
     5053           end.
     5054           else do:
     5055             run write-log-and-file in p-log-handle (
     5056                   input 1
     5057                 , input log-file-name
     5058                 , input 1
     5059                 , input substitute("!!!Клиент &1&2 &3 может быть удален с кассы типа &4 ТОЛЬКО при удалении из числа КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     5060                                     "пропускается...."
     5061                                     , cash-cli.cli-type
     5062                                     , cash-cli.cli-code
     5063                                     , cash-cli.obj-name
     5064                                     , pos-type
     5065                                     , 'маг':U
     5066                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     5067                                     , chr(10)
     5068                                     )
     5069                                       ).
     5070             v-view-log = yes.
     5071           end.
     5072         end.
     5073         else do:
     5074           assign
     5075           v-marketer-action = action.
     5076           if buf_cd-clu.to-send then do:
     5077             create temp-cd-clu.
     5078             buffer-copy buf_cd-clu
     5079             to temp-cd-clu
     5080             assign
     5081             temp-cd-clu.charkey_two = ""
     5082             temp-cd-clu.to-send = no
     5083             .
     5084           end.
     5085         end.
     5086         run maria-put in this-procedure (
     5087                                         buffer buf_cash-desk
     5088                                       , input out
     5089                                       , input fname
     5090                                       , input yes
     5091                                       , input 0
     5092                                       , input no
     5093                                       , input 1
     5094                                       , input 200
     5095                                       , input string(v-clu)
     5096                                       , input (if v-marketer-action = 'd' then '':U else string(cash-cli.obj-name, "X(18)"))).
     5097         v-maria-discnt-value = string(0, '999').
     5098         if action <> 'D':U  then do:
     5099           _do:
     5100           do v-ii = 1 to 2:
     5101             if v-ii = 1 then
     5102             assign
     5103             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-debet-pay"):buffer-value.
     5104             if v-ii = 2 then
     5105             assign
     5106             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-credit-pay"):buffer-value.
     5107             find first buf_dis-rule no-lock where
     5108               buf_dis-rule.obj-type = 'маг':U
     5109                   AND buf_dis-rule.obj-code = i-obj-code
     5110                   AND buf_dis-rule.rule-num = v-dc-rule-num
     5111                   AND buf_dis-rule.sts = integer('0':U) no-error .
     5112             if available buf_dis-rule then do:
     5113               if buf_dis-rule.discnt-type = integer('13':U) then do:
     5114                 assign
     5115                 v-maria-discnt-value = string('003')
     5116                 .
     5117               end.
     5118               else do:
     5119                 if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
     5120                   assign
     5121                   v-dop = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
     5122                   v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
     5123                   v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
     5124                   v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     5125                   .
     5126                 end.
     5127               end.
     5128             end.
     5129             else do:
     5130             end.
     5131             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     5132           end.
     5133         end.
     5134         else do:
     5135           do v-ii = 1 to 2:
     5136             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     5137           end.
     5138         end.
     5139       end.
     5140     end.
     5141   END CASE .
     5142   END PROCEDURE .
     5143   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5144   PROCEDURE putc-dis-card-mask.
     5145   define parameter buffer buf_cash-desk for ub.cash-desk.
     5146   define input parameter p-pos-type as character no-undo.
     5147   define input parameter p-version as character no-undo .
     5148   define variable v-host-code like ub.sysconf.host-code no-undo .
     5149   define variable v-version-dec as decimal no-undo .
     5150   define variable v-reg-cahs  as integer  no-undo .
     5151   define buffer buf_dis-card-mask for ub.dis-card-mask.
     5152   define buffer buf_dis-card-mask-attr  for ub.dis-card-mask-attr.
     5153   define buffer buf_dis-card-type for ub.dis-card-type.
     5154   define buffer bf_dis-card-type for ub.dis-card-type.
     5155   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5156   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5157     (input  p-obj-type
     5158     ,input  i-obj-code
     5159     ,output v-host-code
     5160     )  .
     5161   assign
     5162   v-version-dec = decimal(p-version) no-error .
     5163       if     choice     eq 4
     5164          and p-pos-type eq 'IBM-XML':U
     5165       then do:
     5166           run bgelib-tag-open in this-procedure ( input 2, input "MaskCard"
     5167               , input substitute("code='&1' ctrl='&2' tms='&3'", "*"
     5168               ,(if action = "U":U then 'ADD':U else 'DEL')
     5169               ,OS2-time)).
     5170           run bgelib-tag-close in this-procedure ( input 2, input "MaskCard").
     5171       end.
     5172   else
     5173   _mask:
     5174   for each buf_dis-card-mask no-lock where
     5175         buf_dis-card-mask.host-code = 0
     5176       OR (buf_dis-card-mask.host-code = v-host-code
     5177           AND buf_dis-card-mask.obj-code = 0)
     5178       or (buf_dis-card-mask.obj-type = p-obj-type
     5179           AND
     5180           buf_dis-card-mask.obj-code = i-obj-code)
     5181           ,
     5182      first buf_dis-card-type no-lock where
     5183            buf_dis-card-type.emitent-host-code = buf_dis-card-mask.emitent-host-code
     5184        AND buf_dis-card-type.type              = buf_dis-card-mask.type    :
     5185     if choice = 2 then do:
     5186       find first temp-dis-card-mask no-lock where
     5187                 temp-dis-card-mask.mask-num = buf_dis-card-mask.mask-num no-error .
     5188       if not available temp-dis-card-mask then next _mask.
     5189     end.
     5190     if buf_dis-card-mask.use-on = integer('2':U) then next.
     5191     find first buf_dis-card-mask-attr no-lock where buf_dis-card-mask-attr.attr-code = "reg-cash" and buf_dis-card-mask-attr.mask-num = buf_dis-card-mask.mask-num no-error .
     5192     if available (buf_dis-card-mask-attr) then do:
     5193      if buf_dis-card-mask-attr.attr-value = "yes" then v-reg-cahs = 1 .
     5194      else v-reg-cahs = 0 .
     5195     end.
     5196     else do:
     5197     v-reg-cahs = 0 .
     5198     end.
     5199     find first dis-card no-lock where
     5200                dis-card.d-card = buf_dis-card-mask.mask no-error .
     5201     if available dis-card and
     5202     buf_dis-card-mask.cli-code <> 0 then do:
     5203       find first ub.clients no-lock where
     5204                 ub.clients.obj-type = buf_dis-card-mask.cli-type
     5205           AND  ub.clients.obj-code = buf_dis-card-mask.cli-code no-error .
     5206       if not available ub.clients then next _mask.
     5207       find first ub.dis-card-type no-lock where
     5208                 ub.dis-card-type.type = buf_dis-card-mask.type
     5209             AND ub.dis-card-type.emitent-host-code = buf_dis-card-mask.emitent-host-code
     5210                   no-error .
     5211   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5212   FIND FIRST cash-cli where cash-cli.crf = (cr + 1) No-ERROR.
     5213   start-paket = no.
     5214   if not avail cash-cli then
     5215   create cash-cli.
     5216   else do:
     5217     assign
     5218     cash-cli.cli-adr   = ""
     5219     cash-cli.cli-adr2  = ""
     5220     cash-cli.director  = ""
     5221     cash-cli.engl-name = ""
     5222     cash-cli.telex     = "":U
     5223     cash-cli.phone1-note  = "":U
     5224     cash-cli.post-addr1 = "":U
     5225     cash-cli.post-addr2 = "":U
