     1271   define variable v-xml-file-name     as character            no-undo.
     1272   define variable v-xml-file-name-path as character            no-undo.
     1273   define variable v-log-file-name     as character            no-undo.
     1274   define variable v-locked            as logical              no-undo.
     1275   define variable v-log-string        as character            no-undo.
     1276   define variable v-oper-num          as integer              no-undo.
