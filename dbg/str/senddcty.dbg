     5547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5548     (
     5549      input  buf_dis-card-mask.type
     5550     ,input  buf_dis-card-mask.emitent-host-code
     5551     ,input  0
     5552     ,input  '':U
     5553     ,input  0
     5554     ,input  'def-pcnt':U
     5555     ,output v-d-pcnt0
     5556     )  .
     5557   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5559     (
     5560      input  buf_dis-card-mask.type
     5561     ,input  buf_dis-card-mask.emitent-host-code
     5562     ,input  0
     5563     ,input  '':U
     5564     ,input  0
     5565     ,input  'def-pcnt':U
     5566     ,output v-cash-d-pcnt0
     5567     )  .
     5568   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5570     (
     5571      input  buf_dis-card-mask.type
     5572     ,input  buf_dis-card-mask.emitent-host-code
     5573     ,input  0
     5574     ,input  '':U
     5575     ,input  0
     5576     ,input  'def-categ':U
     5577     ,output v-categ0
     5578     )  .
     5579     if v-d-pcnt0 = ? then do:
     5580       v-d-pcnt0 = 0.
     5581     end.
     5582     if v-cash-d-pcnt0 = ? then do:
     5583       v-cash-d-pcnt0 = 0.
     5584     end.
     5585     if v-categ0 = ? then do:
     5586       v-categ0 = 0.
     5587     end.
     5588     if available cash-cli and cash-cli.d-pcnt-byshop then do:
     5589       v-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     5590                         , input cash-cli.emitent-host-code
     5591                         , input cash-cli.type
     5592                         , input ub.sysconf.host-code
     5593                         , input 'маг':U
     5594                         , input (if g#news
     5595                                   or g#esys
     5596                                   then buf_cash-desk.obj-code
     5597                                   else i-obj-code)
     5598                         , input 1
     5599                         , input cash-cli.d-pcnt
     5600                         , input cash-cli.cash-d-pcnt
     5601                         , input cash-cli.kat-pcnt), "%()i ")).
     5602       v-cash-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     5603                         , input cash-cli.emitent-host-code
     5604                         , input cash-cli.type
     5605                         , input ub.sysconf.host-code
     5606                         , input 'маг':U
     5607                         , input (if g#news
     5608                                   or g#esys
     5609                                   then buf_cash-desk.obj-code
     5610                                   else i-obj-code)
     5611                         , input 1
     5612                         , input cash-cli.d-pcnt
     5613                         , input cash-cli.cash-d-pcnt
     5614                         , input cash-cli.kat-pcnt), "%()i ")).
     5615       v-categ = integer(trim(get-dpcn ( input cash-cli.d-card
     5616                         , input cash-cli.emitent-host-code
     5617                         , input cash-cli.type
     5618                         , input ub.sysconf.host-code
     5619                         , input 'маг':U
     5620                         , input (if g#news
     5621                                   or g#esys
     5622                                   then buf_cash-desk.obj-code
     5623                                   else i-obj-code)
     5624                         , input 1
     5625                         , input cash-cli.d-pcnt
     5626                         , input cash-cli.cash-d-pcnt
     5627                         , input cash-cli.kat-pcnt), "%()i ")).
     5628     end.
     5629     CASE p-pos-type:
     5630       when 'IBM':U then do:
     5631         put stream IBMStream unformatted
     5632         '20' chr(32)
     5633         chr(34) string( action, "x(1)" ) chr(34) chr(32)
     5634         string(buf_Dis-card-mask.rank) chr(32)
     5635         chr(34)
     5636         string( fill( chr(32) , 19 - length(trim(string(BUF_DIS-CARD-MASK.mask)))
     5637                     ) + buf_dis-card-mask.mask
     5638               )
     5639         chr(34) chr(32)
     5640         (if v-version-dec >= 4.54
     5641         then 5
     5642         else (if buf_dis-card-mask.cli-code <> 0
     5643               then 2
     5644               else 1)
     5645         ) chr(32)
     5646         chr(34)
     5647         (if buf_dis-card-mask.cli-mask <> '':U
     5648         then replace(buf_dis-card-mask.cli-mask, 'C', chr(63))
     5649         else string(fill( chr(32), 19)))  chr(34)  chr(32)
     5650         chr(34)
     5651         (if buf_dis-card-mask.cli-code <> 0
     5652         then string( fill( chr(32) , 16 - length( trim(string((if BUF_DIS-CARD-MASK.cli-type = 'орг':U then 1 else 0) * 1000000000 + BUF_DIS-CARD-MASK.cli-code ) ) ) )
     5653               + string((if BUF_DIS-CARD-MASK.cli-type = 'орг':U then 1 else 0) * 1000000000 + BUF_DIS-CARD-MASK.cli-code)
     5654               )
     5655         else string(fill( chr(32), 15) + "0":U)
     5656         )  chr(34)  chr(32)
     5657         (if available cash-cli
     5658         then string( if cash-cli.d-pcnt-byshop and avail bf_dis-card-type
     5659                 then (- v-d-pcnt)
     5660                 else ( - cash-cli.d-pcnt ) , "->>9.99" )
     5661         else string(- v-d-pcnt0, "->>9.99")
     5662         )  chr(32)
     5663         (if available cash-cli
     5664         then  string( cash-cli.kat-pcnt, ">>>9" )
     5665         else  string(v-categ)
     5666         )  chr(32)
     5667         Os2-time
     5668         chr(10).
     5669       end.
     5670       when 'IBM-XML':U then do:
     5671         run bgelib-tag-open in this-procedure ( input 2, input "MaskCard"
     5672                                               , input substitute("code='&1' ctrl='&2' tms='&3'", buf_dis-card-mask.rank
     5673                                               ,(if action = "U":U then if buf_dis-card-mask.stts eq 0
     5674                                                                        then 'ADD'
     5675                                                                        else 'DEL'
     5676                                                 else 'DEL')
     5677                                               ,OS2-time)).
     5678         run bgelib-tag-put in this-procedure ( input 3, input "MCCard", input buf_dis-card-mask.mask, input 1 ).
     5679         if v-version-dec >= 1.05 then do:
     5680           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(5), input 1 ).
     5681         end.
     5682         else do:
     5683           if buf_dis-card-mask.cli-code  = 0
     5684           then
     5685           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(1), input 1 ).
     5686           else
     5687           run bgelib-tag-put in this-procedure ( input 3, input "MCType", input string(2), input 1 ).
     5688         end.
     5689         if buf_dis-card-mask.cli-mask <> '':U
     5690         then
     5691         run bgelib-tag-put in this-procedure ( input 3, input "MCRule"
     5692                                               , input  replace(buf_dis-card-mask.cli-mask, 'C', chr(63))
     5693                                               , input 1 ).
     5694         if buf_dis-card-mask.cli-code <> 0
     5695         then
     5696         run bgelib-tag-put in this-procedure ( input 3, input "MCClient"
     5697                                               , input  string((if buf_dis-card-mask.cli-type = 'орг':U then 1 else 0) * 1000000000 + buf_dis-card-mask.cli-code)
     5698                                               , input 1 ).
     5699         if available cash-cli
     5700         then
     5701         run bgelib-tag-put in this-procedure ( input 3, input "MCValue"
     5702                                              , input  string( if cash-cli.d-pcnt-byshop and avail bf_dis-card-type
     5703                                                               then (- v-d-pcnt)
     5704                                                               else ( - cash-cli.d-pcnt ) , "->>9.99" )
     5705                                              , input 1 ).
     5706         else
     5707         run bgelib-tag-put in this-procedure ( input 3, input "MCValue", input string(- v-d-pcnt0, "->>9.99"), input 1 ).
     5708         if available cash-cli
     5709         then
     5710         run bgelib-tag-put in this-procedure ( input 3, input "MCCat", input string( cash-cli.kat-pcnt, ">>>9" ), input 1 ).
     5711         else
     5712         run bgelib-tag-put in this-procedure ( input 3, input "MCCat", input string(v-categ0), input 1 ).
     5713         run bgelib-tag-put in this-procedure ( input 3, input "MCLock"
     5714                                             , input string(0), input 1 ).
     5715         run bgelib-tag-put in this-procedure ( input 3, input "MCBarRead", input string(v-reg-cahs), input 1 ).
     5716         run bgelib-tag-close in this-procedure ( input 2, input "MaskCard").
     5717       end.
     5718     END CASE .
     5719   END.
     5720   END PROCEDURE .
     5721   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5722   PROCEDURE   for-cash-cycle:
     5723   DEFINE VARIABLE v-dir-remote as character no-undo .
     5724   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     5725   define variable v-version-dec as decimal no-undo .
     5726   define buffer for-cash-desk for ub.cash-desk.
     5727   _for-cash-desk:
     5728     FOR EACH for-cash-desk NO-LOCK WHERE
     5729             for-cash-desk.db-num = g#db-num AND
     5730             for-cash-desk.obj-code = ub.cash-desk.obj-code AND
     5731             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     5732             for-cash-desk.cash-on  = yes
     5733       BREAK
     5734       BY for-cash-desk.db-num
     5735       BY for-cash-desk.obj-code
     5736       BY for-cash-desk.pos-type
     5737       BY for-cash-desk.cash-on
     5738       :
     5739       IF (LOOKUP(ub.cash-desk.pos-type,
     5740                 ('NCR-GM':U + chr(44) +
     5741                  'IBM-XML':U + chr(44) +
     5742                  'MAGIA-XML':U + chr(44) +
     5743                  'NCR-AS@R':U
     5744                  )) > 0
     5745        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     5746        run write-log-and-file in p-log-handle (
     5747             input 1
     5748           , input log-file-name
     5749           , input 1
     5750           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     5751                                                         ).
     5752   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5753   case for-cash-desk.pos-type:
     5754       when 'IBM-XML':U or when 'Autotank':U
     5755     then do:
     5756   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5757   run xml-cd-filename in this-procedure (
     5758         input out
     5759       , output v-xml-file-name
     5760       , output v-xml-file-name-path
     5761       , output v-log-file-name
     5762       , output v-locked
     5763   ).
     5764   run write-log-and-file in p-log-handle (
     5765         input 1
     5766       , input log-file-name
     5767       , input 1
     5768       , input substitute( ("'Пересылка данных по типам-маскам карт'" + " &1")
     5769                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     5770                         )
     5771                                         ).
     5772   run write-log-and-file in p-log-handle (
     5773         input 1
     5774       , input log-file-name
     5775       , input 1
     5776       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     5777                                         ).
     5778   assign
     5779   v-obj-list = 'маг':U + string(i-obj-code)
     5780   .
     5781   run xml-cd-write-header in this-procedure (
     5782         input v-xml-file-name
     5783       , input v-xml-file-name-path
     5784       , input 'data'
     5785       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     5786       , input v-obj-list
     5787       , input (
     5788                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     5789                   then (if for-cash-desk.autonomy = integer('0':U)
     5790                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     5791                         else ("КМ"   )
     5792                         )
     5793                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     5794                   )
     5795               )
     5796       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     5797   ).
     5798   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     5799   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     5800     end.
     5801     when 'IBM':U
     5802     then do:
     5803   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5804   if for-cash-desk.cash-os = ""
     5805   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     5806   then NEXT.
     5807   assign
     5808   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     5809               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     5810   Cash-DOS = NOT CASH-OS2
     5811   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     5812   v-dir-remote-tmp = v-remote + "tmp":U
     5813   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     5814   .
     5815   if for-cash-desk.remote = 1 then do:
     5816     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     5817       if error-status:error then do:
     5818         run write-log-and-file in p-log-handle (
     5819               input 1
     5820             , input log-file-name
     5821             , input 1
     5822             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     5823                               "и/или попытка его создания не удалась"
     5824                               ,v-dir-remote-tmp
     5825                               ,for-cash-desk.cash-num
     5826                               ,chr(10)
     5827                               )
     5828                                               ).
     5829         NEXT.
     5830     end.
     5831     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     5832       if error-status:error then do:
     5833         run write-log-and-file in p-log-handle (
     5834               input 1
     5835             , input log-file-name
     5836             , input 1
     5837             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     5838                               "и/или попытка его создания не удалась"
     5839                               ,v-dir-remote
     5840                               ,for-cash-desk.cash-num
     5841                               ,chr(10)
     5842                               )
     5843                                               ).
     5844         NEXT.
     5845       end.
     5846   end.
     5847   output stream IBMStream
     5848   to value( (if for-cash-desk.remote = 1
     5849               then (v-dir-remote-tmp + chr(47) + "fl":U)
     5850               else out) + fname + '.dat' ) convert target "ibm866".
     5851   OS2-time =       ( if Cash-OS2 then
     5852                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     5853                         else "" )
     5854   .
     5855     end.
     5856   END CASE.
     5857       assign
     5858       v-version-dec = decimal(for-cash-desk.version) no-error .
     5859       if v-version-dec < 4.4
     5860       and for-cash-desk.pos-type = 'IBM':U then do:
     5861         run write-log-and-file in p-log-handle (
     5862             input 1
     5863           , input log-file-name
     5864           , input 1
     5865           , input substitute("Для пересылки на кассу типа &1 версия ПО кассы должна быть > 4.4, а у кассы &2 - версия ПО &3"
     5866                             , for-cash-desk.pos-type
     5867                             , for-cash-desk.cash-num
     5868                             , for-cash-desk.version
     5869                             )
     5870                                                       ).
     5871         assign
     5872         v-view-log = yes.
     5873         next _for-cash-desk.
     5874       end.
     5875       RUN putc-dis-card-mask ( buffer for-cash-desk
     5876                               ,input for-cash-desk.pos-type
     5877                               ,input for-cash-desk.version ).
     5878   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5879   case for-cash-desk.pos-type:
     5880       when 'IBM-XML':U or when 'Autotank':U
     5881     then do:
     5882   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5883   output stream stmxmlout close.
     5884   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     5885       , input 'data'
     5886   ).
     5887   run write-log-and-file in p-log-handle (
     5888         input 1
     5889       , input log-file-name
     5890       , input 1
     5891       , input substitute( "Данные выгружены в файл &1"
     5892                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     5893                         )
     5894                                          ).
     5895   if (
     5896   not (g#news or g#auto or g#esys )
     5897   or
     5898   (
     5899   for-cash-desk.pos-type = 'MAGIA-XML':U
     5900   or
     5901     (for-cash-desk.pos-type = 'IBM-XML':U
     5902   or (for-cash-desk.pos-type = 'Autotank':U
     5903     and
     5904     for-cash-desk.autonomy = integer('2':U))
     5905     )))
     5906   then do:
     5907     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     5908       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     5909                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     5910                   ( if action = 'U'
     5911                     then ('Ждите - ' + 'добавление данных по типам-маскам карт')
     5912                     else ('Ждите - ' + 'удаление данных по типам-маскам карт') ) +
     5913                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     5914                     ' Подождите 15 сек ',
     5915                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     5916                     'Подождите: касса обрабатывает запрос',
     5917                     15 ) no-error.
     5918       if error-status:error then do:
     5919         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     5920         run write-log-and-file in p-log-handle (
     5921               input 1
     5922             , input log-file-name
     5923             , input 1
     5924             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     5925                                   for-cash-desk.cash-num
     5926                               )
     5927                                               ).
     5928         assign
     5929         v-view-log = yes
     5930         .
     5931         return "error":U.
     5932       end.
     5933     end.
     5934     if (for-cash-desk.pos-type = 'IBM-XML':U
     5935     and for-cash-desk.autonomy = integer('0':U))
     5936     or (for-cash-desk.pos-type = 'Autotank':U
     5937     and for-cash-desk.autonomy = integer('2':U))
     5938     then do:
     5939       run str/post-xml.p
     5940         (
     5941          input parparentproc
     5942         ,input p-parent-handle
     5943         ,input p-log-handle
     5944         ,input g#news or g#esys
     5945         ,input g#auto
     5946         ,input 'send'
     5947         ,input log-file-name
     5948         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     5949         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     5950         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     5951         ,input 30
     5952         ,input   ( if action = 'U'
     5953                     then ('Ждите - ' + 'добавление данных по типам-маскам карт')
     5954                     else ('Ждите - ' + 'удаление данных по типам-маскам карт') ) +
     5955                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     5956         ) no-error .
     5957       if error-status:error
     5958       or return-value = "error" then do:
     5959         run write-log-and-file in p-log-handle (
     5960               input 1
     5961             , input log-file-name
     5962             , input 1
     5963             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     5964                                   ,for-cash-desk.obj-code
     5965                                   ,for-cash-desk.cash-num
     5966                                   , chr(10)
     5967                                   , error-status:get-message(1)
     5968                                   , return-value
     5969                               )
     5970                                               ).
     5971         assign
     5972         v-view-log = yes
     5973         .
     5974       end.
     5975     end.
     5976     if not available ub.shop then do:
     5977       find first ub.shop no-lock where
     5978                 ub.shop.obj-code = for-cash-desk.obj-code.
     5979     end.
     5980     if
     5981     not (g#news or g#esys)
     5982     then do:
     5983       run str/getxibmf.p (
     5984                       input parparentproc
     5985                     ,input p-log-handle
     5986                     ,input 'маг':U
     5987                     ,input for-cash-desk.obj-code
     5988                     ,input ub.shop.host-code
     5989                     ,input in_
     5990                     ,input spl
     5991                     ,input (in_ + sav)
     5992                     ,input for-cash-desk.pos-type
     5993                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     5994                             and for-cash-desk.autonomy = integer('0':U))
     5995                             or (for-cash-desk.pos-type = 'Autotank':U
     5996                             and for-cash-desk.autonomy = integer('2':U))
     5997                             then "utf-8":U
     5998                             else "windows-1251")
     5999                     ,input log-file-name
     6000                     ,input "data":U
     6001                     ,input v-xml-file-name
     6002                     ,input-output v-view-log
     6003                     ) no-error .
     6004       if error-status:error then do:
     6005         run write-log-and-file in p-log-handle (
     6006               input 1
     6007             , input log-file-name
     6008             , input 1
     6009             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     6010                                   ,for-cash-desk.obj-code
     6011                                   ,for-cash-desk.cash-num
     6012                               )
     6013                                               ).
     6014         assign
     6015         v-view-log = yes
     6016         .
     6017       end.
     6018     end.
     6019   end.
     6020   if g#news
     6021   or g#auto
     6022   or g#esys
     6023   and for-cash-desk.pos-type = 'MAGIA-XML':U
     6024   then do:
     6025   end.
     6026     end.
     6027     when 'IBM':U
     6028     then do:
     6029   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6030   output stream IBMStream close.
     6031   output stream IBMStream
     6032   to value( (if for-cash-desk.remote = 1
     6033               then (v-dir-remote-tmp + chr(47) + "fl":U)
     6034               else out) + fname + '.ad0' ) convert target "ibm866".
     6035   put stream IBMStream ' ' skip(1).
     6036    put stream IBMStream unformatted '  ' for-cash-desk.addr-path ' plu' skip.
     6037   output stream IBMStream close.
     6038   OS-RENAME
     6039   VALUE((if for-cash-desk.remote = 1
     6040           then (v-dir-remote-tmp + chr(47) + "fl":U)
     6041           else out) + fname + '.ad0')
     6042   VALUE((if for-cash-desk.remote = 1
     6043           then (v-dir-remote + chr(47) + "fl":U)
     6044           else out) + fname + '.adr').
     6045   os-er = OS-ERROR.
     6046   run write-log-and-file in p-log-handle (
     6047         input 1
     6048       , input log-file-name
     6049       , input 1
     6050       , input substitute( "Данные выгружены в файл &1, файл адреса &2"
     6051                           , ((if for-cash-desk.remote = 1
     6052                               then (v-dir-remote + chr(47) + "fl":U)
     6053                               else out) + fname + '.dat')
     6054                           , ((if for-cash-desk.remote = 1
     6055                               then (v-dir-remote + chr(47) + "fl":U)
     6056                               else out) + fname + '.adr')
     6057                           )
     6058                                          ).
     6059   if os-er <> 0 then do:
     6060     run write-log-and-file in p-log-handle (
     6061           input 1
     6062         , input log-file-name
     6063         , input 1
     6064         , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     6065                               for-cash-desk.cash-num
     6066                           )
     6067                                           ).
     6068         assign
     6069         v-view-log = yes
     6070         .
     6071         return "error":U.
     6072   end.
     6073   if for-cash-desk.remote = 1 then do:
     6074     OS-RENAME
     6075     VALUE(v-dir-remote-tmp + chr(47) + "fl":U + fname + '.dat')
     6076     VALUE(v-dir-remote  + chr(47) + "fl":U + fname + '.dat').
     6077     os-er = OS-ERROR.
     6078     if os-er <> 0 then do:
     6079         run write-log-and-file in p-log-handle (
     6080               input 1
     6081             , input log-file-name
     6082             , input 1
     6083             , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     6084                                   for-cash-desk.cash-num
     6085                               )
     6086                                               ).
     6087         assign
     6088         v-view-log = yes
     6089         .
     6090         return "error":U.
     6091     end.
     6092     run write-log-and-file in p-log-handle (
     6093           input 1
     6094         , input log-file-name
     6095         , input 1
     6096         , input substitute( "Данные выгружены в файл &1",
     6097                               (v-dir-remote  + chr(47) + "fl":U + fname + '.dat')
     6098                           )
     6099                                           ).
     6100   end.
     6101   else do:
     6102     if not g#news
     6103     and not g#auto
     6104     and not g#esys
     6105     then do:
     6106     end.
     6107   end.
     6108     end.
     6109   END CASE.
     6110     END .
     6111   END PROCEDURE.
     6112   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6113   PROCEDURE SENDING:
     6114   DEFINE VARIABLE fq as integer no-undo .
     6115   FOR EACH ub.cash-desk NO-LOCK WHERE
     6116           ub.cash-desk.db-num = g#db-num
     6117        AND ub.cash-desk.obj-code = i-obj-code
     6118        AND ub.cash-desk.cash-on
     6119   BREAK
     6120   By ub.cash-desk.pos-type :
     6121     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     6122   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6123   define variable dflt-cd50 as character no-undo .
     6124   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6125   define variable v-param-type51 as character no-undo .
     6126   define variable v-value-date51 as date no-undo .
     6127   define variable v-value-decimal51 as decimal no-undo .
     6128   define variable v-value-integer51 as INTEGER no-undo .
     6129   define variable v-value-logical51 AS LOGICAL no-undo .
     6130   define variable v-tth51 as handle no-undo .
     6131   run adm/shattri.p (
     6132       input "get":U
     6133       ,input  'маг':U
     6134       ,input  ub.cash-desk.obj-code
     6135       ,input  'cd-sending':U
     6136       ,input  'dflt-cd':U
     6137       ,output dflt-cd50
     6138       ,output v-value-date51
     6139       ,output v-value-decimal51
     6140       ,output v-value-integer51
     6141       ,output v-value-logical51
     6142       ,output v-param-type51
     6143       ,INPUT-OUTPUT table-handle v-tth51
     6144       ) no-error .
     6145   delete object v-tth51 no-error.
     6146   case ub.cash-desk.pos-type:
     6147       when 'IBM-XML':U or when 'Autotank':U
     6148     then do:
     6149   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6150   run str/get-inis.p (
     6151                   input 'маг':U
     6152                 , input ub.cash-desk.obj-code
     6153                 , input ub.cash-desk.pos-type
     6154                 , input cash-desk.remote
     6155                 , input "send":U
     6156                 , output out
     6157                 , output out2
     6158                 , output in_
     6159                 , output spl
     6160                 , output sav
     6161                 , output v-remote
     6162                 )  no-error .
     6163   if error-status:error then do:
     6164     run write-log-and-file in p-log-handle (
     6165           input 1
     6166         , input log-file-name
     6167         , input 1
     6168         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     6169                             , ub.cash-desk.pos-type
     6170                             , ub.cash-desk.obj-code
     6171                             , chr(10)
     6172                             , error-status:get-message(1)
     6173                             , return-value )).
     6174     assign
     6175     v-view-log = yes.
     6176     return error.
     6177   end.
     6178   if ub.cash-desk.pos-type = 'IBM-XML':U
     6179   or ub.cash-desk.pos-type = 'Autotank':U
     6180   then do:
     6181     file-info:file-name = (out  + "undelivered").
     6182     if file-info:FULL-PATHNAME <> ? then do:
     6183       run str/rsndxibm.p ( input parparentproc
     6184                           ,input p-parent-handle
     6185                           ,input p-log-handle
     6186                           ,input out  + "undelivered" ) no-error.
     6187     end.
     6188   end.
     6189     end.
     6190     when 'IBM':U
     6191     then do:
     6192   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6193   run str/get-inis.p (
     6194                   input 'маг':U
     6195                 , input ub.cash-desk.obj-code
     6196                 , input ub.cash-desk.pos-type
     6197                 , input cash-desk.remote
     6198                 , input "send":U
     6199                 , output out
     6200                 , output out2
     6201                 , output in_
     6202                 , output spl
     6203                 , output sav
     6204                 , output v-remote
     6205                 )  no-error .
     6206   if error-status:error then do:
     6207     run write-log-and-file in p-log-handle (
     6208           input 1
     6209         , input log-file-name
     6210         , input 1
     6211         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     6212                             , ub.cash-desk.pos-type
     6213                             , ub.cash-desk.obj-code
     6214                             , chr(10)
     6215                             , error-status:get-message(1)
     6216                             , return-value )).
     6217     assign
     6218     v-view-log = yes.
     6219     return error.
     6220   end.
     6221     end.
     6222   END CASE.
     6223       RUN for-cash-cycle no-error.
     6224     END.
     6225     IF LAST-OF(ub.cash-desk.pos-type) then do:
     6226   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6227   case ub.cash-desk.pos-type:
     6228   END CASE.
     6229     END.
     6230   END.
     6231   END PROCEDURE.
     6232   run write-log-and-file in p-log-handle (
     6233         input 1
     6234       , input log-file-name
     6235       , input 1
     6236       , input substitute("Пересылка на кассы &2&3 информации о типах-масках карт", p-obj-type, i-obj-code)
     6237                                             ).
     6238   find first ub.shop no-lock where
     6239             ub.shop.obj-code = abs(i-obj-code).
     6240   find first ub.sysconf no-lock where
     6241             ub.sysconf.host-code = ub.shop.host-code.
     6242   RUN SENDING no-error.
     6243   if error-status:error then do:
     6244     run write-log-and-file in p-log-handle (
     6245           input 1
     6246         , input log-file-name
     6247         , input 1
     6248         , input substitute( "!!!Ошибки при отсылке информации о типах-масках карт на кассы &1&2"
     6249                            , p-obj-type
     6250                            , i-obj-code
     6251                           )
     6252                                           ).
     6253     assign
     6254     v-view-log = yes
     6255     .
     6256   end.
     6257     finally :
     6258         output to value(log-file-name) append. // если файла нет
     6259         put skip.
     6260         output close.
     6261   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6262   if v-view-log
     6263   and not g#news
     6264   and not g#auto
     6265   then do:
     6266     message
     6267     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     6268     "!!!Внимательно прочитайте Log-file!!"
     6269     view-as alert-box error .
     6270        define variable v-user-action56   as character no-undo .
     6271     define variable v-printed56       as logical   no-undo .
     6272     run gbl/prnfilen.w
     6273       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     6274       ,input  0
     6275       ,input  (string("./":U) + log-file-name)
     6276       ,input  7
     6277       ,output v-user-action56
     6278       ,output v-printed56
     6279       ) .
     6280   end.
     6281   if v-view-log = true
     6282   and (g#news
     6283   or g#auto)
     6284   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     6285   then do:
     6286      run cb_set-view-log in p-parent-handle ( input yes).
     6287   end.
     6288       run write-log-and-file in p-log-handle (
     6289           input 1
     6290         , input log-file-name
     6291         , input 1
     6292         , input substitute("&1", chr(10))
     6293       ).
     6294       define variable v-save-file-name as character no-undo .
     6295       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     6296       OS-APPEND value(log-file-name) value(v-save-file-name).
     6297       OS-DELETE value(log-file-name).
     6298     end finally .
