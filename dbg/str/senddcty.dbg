     5337   cash-cli.valid-date  = (if ub.dis-card.valid-date <> ?
     5338                           then ub.dis-card.valid-date
     5339                           else cash-cli.valid-date)
     5340   .
     5341   if cash-cli.card-media = integer('5':U) then do:
