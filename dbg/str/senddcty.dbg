      100   define buffer buf_dis-card-mask for ub.dis-card-mask.
      101   define variable vss-include-info0 as character format "X(65)" no-undo
      102   initial "@(#)$Workfile$ $Revision$".
      103   define variable v-bgelib-bgefmt        as character         no-undo.
