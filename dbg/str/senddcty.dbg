     1574   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1575   define variable v-is-closed-shift-journal as integer no-undo .
     1576   assign
     1577   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1578                               +
     1579                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1580                               +
     1581                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1582   .
     1583   return v-is-closed-shift-journal.
     1584   END FUNCTION.
     1585   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1586   define variable v-is-first-journal as logical no-undo .
     1587   assign
     1588   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1589                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1590                     or (p-journal-num =  integer(entry(1, '17':U)))
     1591                     or (p-journal-num = integer(entry(1, '16':U)))
     1592   .
     1593   return v-is-first-journal.
     1594   END FUNCTION.
     1595   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1596   define variable v-is-petrol-journal as logical no-undo .
     1597   assign
     1598   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1599   return v-is-petrol-journal.
     1600   END FUNCTION.
     1601   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1602   define variable v-max-record-num as integer no-undo .
     1603   assign
     1604   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1605                       then 1489
     1606                       else 2340).
     1607   return v-max-record-num.
     1608   END FUNCTION.
     1609   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1610   define variable v-max-record-num as integer no-undo .
     1611   assign
     1612   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1613                       then 1489 * num-entries('30,31,32,33':U)
     1614                       else 2340 * num-entries('17':U)).
     1615   return v-max-record-num.
     1616   END FUNCTION.
     1617   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1618                                           ,input p-rec-no as integer):
     1619   define variable v-num-recs as integer no-undo .
     1620   if tekka-is-petrol-journal (p-journal-num) then do:
     1621     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1622       assign
     1623       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1624       .
     1625     end.
     1626     else do:
     1627       assign
     1628       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1629       .
     1630     end.
     1631   end.
     1632   else do:
     1633     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1634       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1635         assign
     1636         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1637         .
     1638       end.
     1639       else do:
     1640         assign
     1641         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1642         .
     1643       end.
     1644     end.
     1645     else do:
     1646       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1647         assign
     1648         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1649         .
     1650       end.
     1651       else do:
     1652         assign
     1653         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1654         .
     1655       end.
     1656     end.
     1657   end.
     1658   return v-num-recs.
     1659   END FUNCTION.
     1660   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1661                                              ,input p-is-petrol as logical
     1662                                              ,input p-is-current as logical
     1663                                              ,output p-rec-no as decimal
     1664                                              ):
     1665   define variable v-obj-num0 as integer no-undo .
     1666   define variable v-obj-num as integer no-undo .
     1667   define variable v-obj-num2 as integer no-undo .
     1668   define variable p-num-recs2 as integer no-undo .
     1669   define variable p-rec-no2 as integer no-undo .
     1670   if p-is-petrol then do:
     1671     assign
     1672     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1673     .
     1674     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1675     then
     1676     assign
     1677     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1678     p-rec-no = p-num-recs modulo 1489
     1679     .
     1680     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1681     then
     1682     assign
     1683     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1684     p-rec-no = p-num-recs modulo 1489
     1685     .
     1686   end.
     1687   else do:
     1688     assign
     1689     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1690     p-num-recs = trunc(p-num-recs, 0)
     1691     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1692     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1693     .
     1694     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1695     then
     1696     assign
     1697     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1698     p-rec-no = p-num-recs modulo 2340
     1699     .
     1700     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1701     then
     1702     assign
     1703     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1704     p-rec-no = p-num-recs modulo 2340
     1705     .
     1706     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1707     then
     1708     assign
     1709     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1710     p-rec-no2 = p-num-recs2 modulo 2978
     1711     .
     1712     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1713     then
     1714     assign
     1715     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1716     p-rec-no2 = p-num-recs2 modulo 2978
     1717     .
     1718     assign
     1719     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1720     .
     1721   end.
     1722   if v-obj-num = 0 then v-obj-num = 100.
     1723   return v-obj-num.
     1724   END FUNCTION.
     1725   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1726   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1727   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1728      if p-is-ptrl then
     1729      return integer(entry(1, '26,27,28,29':U)).
     1730      if not p-is-ptrl then
     1731      return integer(entry(1, '16':U)).
     1732   end.
     1733   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1734   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1735   return 0.
     1736   END FUNCTION.
     1737   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1738   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1739   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1740     if p-is-ptrl then
     1741     return integer(entry(1, '26,27,28,29':U)).
     1742     if not p-is-ptrl then
     1743     return integer(entry(1, '16':U)).
     1744   end.
     1745   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1746   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1747   return 0.
     1748   END FUNCTION.
     1749   PROCEDURE maria-put:
     1750   define parameter buffer buf_cash-desk for ub.cash-desk.
     1751   define input parameter p-out    as character no-undo .
     1752   define input parameter p-fname as character no-undo .
     1753   define input parameter p-by-record as logical no-undo .
     1754   define input parameter p-shift-fields as integer no-undo .
     1755   define input parameter p-binary as logical no-undo .
     1756   define input parameter p-obj-num as integer no-undo .
     1757   define input parameter p-max-records as integer no-undo .
     1758   define input parameter p-plu as integer no-undo .
     1759   define input parameter p-value as character no-undo .
     1760   define variable v-file-name as character no-undo .
     1761   define variable v-create as logical no-undo .
     1762   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1763   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1764   output stream IBMSTREAM
     1765   to value(v-file-name) append .
     1766   Put  stream IBMSTREAM unformatted
     1767   p-plu
     1768   chr(3)
     1769   p-value
     1770   skip.
     1771   output stream IBMSTREAM
     1772   close.
     1773   if not p-by-record then do:
     1774     find first buf_temp-tekka-tsk where
     1775               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1776     if not available buf_temp-tekka-tsk then do:
     1777       v-create = yes.
     1778     end.
     1779   end.
     1780   else do:
     1781     find first buf_temp-tekka-tsk where
     1782               buf_temp-tekka-tsk.filename  = v-file-name
     1783           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1784     if not available buf_temp-tekka-tsk
     1785     then do:
     1786       find first buf_temp-tekka-tsk where
     1787                 buf_temp-tekka-tsk.filename  = v-file-name
     1788             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1789       if not available buf_temp-tekka-tsk
     1790       then do:
     1791         v-create = yes.
     1792       end.
     1793     end.
     1794   end.
     1795   if v-create then do:
     1796     create buf_temp-tekka-tsk.
     1797     assign
     1798     buf_temp-tekka-tsk.filename = v-file-name
     1799     buf_temp-tekka-tsk.range    = p-plu
     1800     buf_temp-tekka-tsk.obj-num = p-obj-num
     1801     buf_temp-tekka-tsk.obj-name = '':U
     1802     buf_temp-tekka-tsk.num-records = 0
     1803     buf_temp-tekka-tsk.max-records = p-max-records
     1804     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1805     buf_temp-tekka-tsk.task-num = p-fname
     1806     buf_temp-tekka-tsk.by-record = p-by-record
     1807     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1808     buf_temp-tekka-tsk.binary = p-binary
     1809     buf_temp-tekka-tsk.send-get = 'send'
     1810     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1811     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1812     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1813     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1814                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1815                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1816                                 then 'local'
     1817                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1818     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1819     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1820     buf_temp-tekka-tsk.waiting-sek = 30
     1821     buf_temp-tekka-tsk.min-plu     = p-plu
     1822     buf_temp-tekka-tsk.max-plu     = p-plu
     1823     .
     1824   end.
     1825   assign
     1826   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1827   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1828   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1829   .
     1830   END PROCEDURE.
     1831   PROCEDURE maria-get:
     1832   define parameter buffer buf_cash-desk for ub.cash-desk.
     1833   define input parameter p-out    as character no-undo .
     1834   define input parameter p-fname as character no-undo .
     1835   define input parameter p-by-record as logical no-undo .
     1836   define input parameter p-obj-num as integer no-undo .
     1837   define input parameter p-num-fields as integer no-undo .
     1838   define input parameter p-max-records as integer no-undo .
     1839   define input parameter p-min-plu as integer no-undo .
     1840   define input parameter p-max-plu as integer no-undo .
     1841   define input parameter p-other as character no-undo .
     1842   define input parameter p-order-num as integer no-undo .
     1843   define variable v-file-name as character no-undo .
     1844   define variable v-secondary-obj-num as character no-undo .
     1845   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1846   if p-by-record then do:
     1847     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1848   end.
     1849   else do:
     1850     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1851   end.
     1852   find first buf_temp-tekka-tsk where
     1853             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1854   if not available buf_temp-tekka-tsk then do:
     1855     create buf_temp-tekka-tsk.
     1856     assign
     1857     buf_temp-tekka-tsk.filename = v-file-name
     1858     buf_temp-tekka-tsk.obj-num = p-obj-num
     1859     buf_temp-tekka-tsk.obj-name = '':U
     1860     buf_temp-tekka-tsk.max-records = p-max-records
     1861     buf_temp-tekka-tsk.num-fields = p-num-fields
     1862     buf_temp-tekka-tsk.task-num = p-fname
     1863     buf_temp-tekka-tsk.by-record = p-by-record
     1864     buf_temp-tekka-tsk.send-get = 'get'
     1865     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1866     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1867     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1868     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1869                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1870                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1871                                   then 'local'
     1872                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1873     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1874     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1875     buf_temp-tekka-tsk.waiting-sek = 30
     1876     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1877     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1878     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1879                                       and p-max-plu <> ?
     1880                                       then p-max-plu - p-min-plu + 1
     1881                                       else 0)
     1882     buf_temp-tekka-tsk.other-info = p-other
     1883     buf_temp-tekka-tsk.order-num = p-order-num
     1884     .
     1885     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1886       assign
     1887       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1888       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1889       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1890       no-error
     1891       .
     1892       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1893     end.
     1894   end.
     1895   END PROCEDURE.
     1896   PROCEDURE maria-task:
     1897   define parameter buffer buf_cash-desk for ub.cash-desk.
     1898   define input parameter p-fname as character no-undo .
     1899   define input parameter p-obj-num-list as character no-undo .
     1900   define input parameter p-parameters as character no-undo .
     1901   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1902   find first buf_temp-tekka-tsk where
     1903             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1904   if not available buf_temp-tekka-tsk then do:
     1905     create buf_temp-tekka-tsk.
     1906     assign
     1907     buf_temp-tekka-tsk.filename = ''
     1908     buf_temp-tekka-tsk.range = 1
     1909     buf_temp-tekka-tsk.obj-num = 0
     1910     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1911     buf_temp-tekka-tsk.task-num = p-fname
     1912     buf_temp-tekka-tsk.by-record = no
     1913     buf_temp-tekka-tsk.send-get = 'task'
     1914     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1915     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1916     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1917     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1918                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1919                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1920                                   then 'local'
     1921                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1922     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1923     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1924     buf_temp-tekka-tsk.waiting-sek = 30
     1925     buf_temp-tekka-tsk.other-info = p-parameters
     1926     buf_temp-tekka-tsk.order-num = 0
     1927     .
     1928   end.
     1929   END PROCEDURE.
     1930   procedure tekkatsk-verify-schema :
     1931   define input parameter p-obj-list as character no-undo .
     1932   define input parameter p-dir-path as character no-undo .
     1933   define variable v-obj-num as integer no-undo .
     1934   define variable v-obj-name as character no-undo .
     1935   define variable v-num-records as integer no-undo .
     1936   define variable v-size_ as integer no-undo .
     1937   define variable v-value as character no-undo .
     1938   define variable ii as integer no-undo .
     1939   define variable jj as integer no-undo .
     1940   define variable ii-ibs as integer no-undo .
     1941   define variable ii-tekka as integer no-undo .
     1942   define variable v-result as character no-undo .
     1943   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1944   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1945     do
     1946     on error undo, return error
     1947     :
     1948        for each buf_temp-tekka-schema:
     1949          delete buf_temp-tekka-schema.
     1950        end.
     1951        input from value('tekkasch.d').
     1952        repeat :
     1953          create buf_temp-tekka-schema.
     1954          import buf_temp-tekka-schema.
     1955          assign
     1956          buf_temp-tekka-schema.host = 'IBS'
     1957          ii = ii + 1.
     1958          .
     1959        end.
     1960        input close.
     1961        ii-ibs = ii.
     1962         _ii:
     1963         do ii = 1 to 256:
     1964           if p-obj-list = "ALL"
     1965           or lookup(string(ii), p-obj-list) > 0 then do:
     1966             assign
     1967             v-obj-num = 0
     1968             v-obj-name = ''
     1969             v-num-records = 0
     1970             v-size_ = 0
     1971             .
     1972             run alienini-getkey in this-procedure (
     1973                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1974                                                     ,input ('obj' + string(ii, '999'))
     1975                                                     ,input 'oname'
     1976                                                     ,output v-value) no-error .
     1977             if v-value = ? then next _ii.
     1978             assign
     1979             v-obj-num = ii
     1980             v-obj-name = v-value
     1981             .
     1982             run alienini-getkey in this-procedure (
     1983                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1984                                                     ,input ('obj' + string(ii, '999'))
     1985                                                     ,input 'size'
     1986                                                     ,output v-value) no-error .
     1987             assign
     1988             v-num-records = integer(v-value) no-error  .
     1989             if error-status:error
     1990             or v-num-records = 0 then next _ii.
     1991             run alienini-getkey in this-procedure (
     1992                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1993                                                     ,input 'obj' + string(ii, '999')
     1994                                                     ,input 'f000'
     1995                                                     ,output v-value) no-error .
     1996             assign
     1997             v-size_ = integer(v-value) no-error  .
     1998             if error-status:error
     1999             or v-size_ = 0 then next _ii.
     2000             _jj:
     2001             do jj = 1 to 256:
     2002               run alienini-getkey in this-procedure (
     2003                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2004                                                       ,input 'obj' + string(ii, '999')
     2005                                                       ,input 'f' + string(jj, '999')
     2006                                                       ,output v-value) no-error .
     2007               if v-value = ? then next _ii.
     2008               create buf_temp-tekka-schema.
     2009               assign
     2010               buf_temp-tekka-schema.host = 'tekka'
     2011               buf_temp-tekka-schema.obj-num = v-obj-num
     2012               buf_temp-tekka-schema.obj-name = v-obj-name
     2013               buf_temp-tekka-schema.num-records = v-num-records
     2014               buf_temp-tekka-schema.size_ = v-size_
     2015               buf_temp-tekka-schema.field-num = jj
     2016               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2017               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2018                                                  then entry(2, entry(2, v-value, '#'), ':')
     2019                                                  else '':U)
     2020               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2021               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2022               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2023                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2024               no-error
     2025               .
     2026               if error-status:error then do:
     2027                 delete buf_temp-tekka-schema.
     2028                 next _jj.
     2029               end.
     2030               run alienini-getkey in this-procedure (
     2031                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2032                                                       ,input 'obj' + string(ii, '999') + 'name'
     2033                                                       ,input 'n' + string(jj, '999')
     2034                                                       ,output v-value) no-error .
     2035               if v-value <> ? then
     2036               buf_temp-tekka-schema.field-name = v-value.
     2037             end.
     2038           end.
     2039         end.
     2040         ii-tekka = ii - 1.
     2041        if p-obj-list <> 'ALL' then do:
     2042         if ii-tekka <> ii-ibs then do:
     2043           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2044                                   , ii-ibs
     2045                                   , ii-tekka).
     2046         end.
     2047        end.
     2048        for each buf_temp-tekka-schema where
     2049               buf_temp-tekka-schema.host = 'tekka':
     2050          find first buf2_temp-tekka-schema where
     2051                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2052                AND buf2_temp-tekka-schema.host = 'ibs'
     2053                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2054          if not available buf2_temp-tekka-schema then do:
     2055           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2056                                   , buf_temp-tekka-schema.field-num
     2057                                   , buf_temp-tekka-schema.obj-num).
     2058          end.
     2059          buffer-compare buf_temp-tekka-schema
     2060          to buf2_temp-tekka-schema
     2061          save result in v-result.
     2062          if v-result <> '':U then do:
     2063           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2064                                   , buf_temp-tekka-schema.field-num
     2065                                   , buf_temp-tekka-schema.obj-num).
     2066          end.
     2067        end.
     2068     end.
     2069   end procedure.
     2070   FUNCTION set-Sx returns character (input p-string as character):
     2071   return p-string.
     2072   END FUNCTION.
     2073   FUNCTION get-Sx returns character (input p-string  as character):
     2074   return p-string.
     2075   END FUNCTION.
     2076   FUNCTION set-B returns character (input p-string  as character):
     2077   return chr(integer(p-string)).
     2078   END FUNCTION.
     2079   FUNCTION get-B returns character (input p-string  as character):
     2080   return string(asc(p-string)).
     2081   END FUNCTION.
     2082   FUNCTION set-BF returns character (input p-string  as character):
     2083   define variable v-dopi as integer no-undo .
     2084   define variable ii as integer no-undo .
     2085   do ii = 1 to 8:
     2086     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2087   end.
     2088   return chr(v-dopi).
     2089   END FUNCTION.
     2090   FUNCTION get-BF returns character (input p-string  as character):
     2091   define variable v-dopi as integer no-undo .
     2092   define variable v-dops as character no-undo .
     2093   define variable ii as integer no-undo .
     2094   v-dopi = asc(p-string).
     2095   do ii = 8 to 1 BY -1:
     2096     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2097   end.
     2098   return v-dops.
     2099   END FUNCTION.
     2100   FUNCTION set-BN returns character (input p-string  as character
     2101                                     ,input p-bin-group as character):
     2102   define variable v-dopi as integer no-undo .
     2103   define variable ii as integer no-undo .
     2104   define variable jj as integer no-undo .
     2105   define variable v-grp-nums as integer no-undo .
     2106   define variable v-dopi2 as integer no-undo .
     2107   v-grp-nums = num-entries(p-bin-group).
     2108   do jj = 0 to v-grp-nums - 1:
     2109     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2110     do ii = 1 to 8:
     2111       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2112     end.
     2113   end.
     2114   return chr(v-dopi).
     2115   END FUNCTION.
     2116   FUNCTION get-BN returns character (input p-string  as character
     2117                                     ,input p-bin-group as character):
     2118   define variable v-dopi as integer no-undo .
     2119   define variable v-dops as character no-undo .
     2120   define variable v-grp-nums as integer no-undo .
     2121   define variable ii as integer no-undo .
     2122   define variable jj as integer no-undo .
     2123   v-dopi = asc(p-string).
     2124   v-grp-nums = num-entries(p-bin-group).
     2125   do jj = 1 to v-grp-nums:
     2126   do ii = 8 to 1 BY -1:
     2127     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2128   end.
     2129   end.
     2130   return v-dops.
     2131   END FUNCTION.
     2132   procedure fill-temp-cd :
     2133   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2134   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2135   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2136   define input parameter p-clear-table as logical no-undo .
     2137   define buffer buf_temp-cd for temp-cd.
     2138   define buffer buf_cash-desk for ub.cash-desk.
     2139     do
     2140     on error undo, return error
     2141     :
     2142        if p-clear-table  then do:
     2143          for each buf_temp-cd:
     2144            delete buf_temp-cd.
     2145          end.
     2146        end.
     2147        for each buf_cash-desk no-lock where
     2148               buf_cash-desk.db-num = p-db-num
     2149           AND buf_cash-desk.obj-code = p-obj-code
     2150           and buf_cash-desk.cash-on  = yes
     2151        BREAK by buf_cash-desk.pos-type:
     2152          if first-of(buf_cash-desk.pos-type) then do:
     2153            create buf_temp-cd.
     2154            buffer-copy buf_cash-desk to buf_temp-cd.
     2155          end.
     2156        end.
     2157     end.
     2158   end procedure.
