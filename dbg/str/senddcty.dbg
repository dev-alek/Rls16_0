     3959       end.
     3960       if loc-d-v = ? then do:
     3961         find first buf_dis-card-property no-lock where
     3962                   buf_dis-card-property.d-card = p-d-card
     3963               and buf_dis-card-property.dtm-code = 26
     3964               and buf_dis-card-property.host-code = parhost-code
     3965               and buf_dis-card-property.obj-type = ''
     3966               and buf_dis-card-property.obj-code = 0
