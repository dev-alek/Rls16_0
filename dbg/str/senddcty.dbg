     2256   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258   define variable v-disprop-menu-section-num as integer no-undo .
     2259   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2261   procedure gen-key-rec :
     2262     define input  parameter p-tbl-name    as character no-undo.
     2263     define input  parameter p-bh_tbl-name as handle    no-undo.
     2264     define output parameter p-key-rec     as character no-undo.
     2265     do
     2266     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2267     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2268     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2269     :
     2270       define variable fh               as handle    no-undo .
     2271       define variable v-ok             as logical   no-undo .
     2272       define variable v-inform         as character no-undo .
     2273       define variable v-ind            as integer   no-undo .
     2274       define variable v-idx-field-qnty as integer   no-undo .
     2275       if p-tbl-name = ?
     2276         or p-tbl-name = "":U
     2277       then do:
     2278         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     2279       end.
     2280       if not p-bh_tbl-name:available then do:
     2281         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     2282       end.
     2283       assign
     2284         p-key-rec = p-tbl-name
     2285         v-inform  = p-bh_tbl-name:index-information(1)
     2286         v-ind     = 2
     2287       .
     2288       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2289       on error undo, return error
     2290       :
     2291         assign
     2292           v-inform = p-bh_tbl-name:index-information( v-ind )
     2293           v-ind    = v-ind + 1
     2294         .
     2295       end.
     2296       if v-inform = ?
     2297         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2298         or entry( 3, v-inform, ",":U ) <> "1":U
     2299       then do:
     2300         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     2301       end.
     2302       else do:
     2303         assign
     2304           v-idx-field-qnty = num-entries( v-inform ) - 4
     2305         .
     2306         if v-idx-field-qnty < 2 then do:
     2307           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     2308         end.
     2309         do v-ind = 1 to v-idx-field-qnty by 2
     2310         on error undo, return error
     2311         :
     2312           assign
     2313             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2314             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2315           .
     2316         end.
     2317       end.
     2318       if p-key-rec = ? then do:
     2319         assign
     2320           p-key-rec = "":U
     2321         .
     2322         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     2323       end.
     2324     end.
     2325     return.
     2326   end procedure.
     2327   procedure gen-where-keyr-tab :
     2328     define input  parameter i-tableSerach as character no-undo.
     2329     define input  parameter i-tablekey   as character  no-undo.
     2330     define input  parameter p-key-rec    as character  no-undo.
     2331     define input  parameter p-key-handle as handle     no-undo .
     2332     define input  parameter p-db-name    as character  no-undo .
     2333     define input  parameter p-tt-handle  as handle     no-undo .
     2334     define output parameter o-Where      as character  no-undo.
     2335     do
     2336     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2337     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2338     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2339     :
     2340       define variable v-full-tbl-name  as character no-undo .
     2341       define variable bh_tbl-name      as handle    no-undo .
     2342       define variable fh_key           as handle    no-undo .
     2343       define variable fh_search        as handle    no-undo .
     2344       define variable v-field-num      as integer   no-undo .
     2345       define variable v-count-fld      as integer   no-undo .
     2346       define variable v-inform         as character no-undo .
     2347       define variable v-ind            as integer   no-undo .
     2348       define variable v-idx-field-qnty as integer   no-undo .
     2349       define variable v-field-name     as character no-undo .
     2350       define variable v-field-val      as character no-undo .
     2351       define variable v-word-link      as character no-undo .
     2352       define variable vTable           as character no-undo.
     2353       define variable bh_tbl-key       as handle    no-undo .
     2354       assign
     2355         p-key-rec = trim( p-key-rec )
     2356       .
     2357       if p-key-handle <> ? then do:
     2358         if not valid-handle(p-key-handle)
     2359            or p-key-handle:type <> "buffer"
     2360         then do:
     2361           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     2362         end.
     2363         if num-entries( p-key-rec, chr(3) ) > 1
     2364           or p-key-rec = ?
     2365           or p-key-rec = "":U
     2366         then do:
     2367           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     2368         end.
     2369       end.
     2370       else do:
     2371         if p-key-rec = ?
     2372           or p-key-rec = "":U
     2373         then do:
     2374           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     2375         end.
     2376       end.
     2377       assign
     2378         vTable = entry( 1 , p-key-rec, chr(3) )
     2379       .
     2380       if p-tt-handle <> ?
     2381         and ( not valid-handle(p-tt-handle)
     2382               or p-tt-handle:type <> "buffer"
     2383             )
     2384       then do:
     2385         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     2386       end.
     2387       if p-tt-handle = ? then do:
     2388         assign
     2389           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2390         .
     2391         create buffer bh_tbl-name for table v-full-tbl-name .
     2392       end.
     2393       else do:
     2394         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2395       end.
     2396       assign
     2397         v-inform = bh_tbl-name:index-information(1)
     2398         v-ind    = 2
     2399       .
     2400       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2401       on error undo, return error
     2402       :
     2403         assign
     2404           v-inform = bh_tbl-name:index-information( v-ind )
     2405           v-ind    = v-ind + 1
     2406         .
     2407       end.
     2408       if v-inform = ?
     2409         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2410         or entry( 3, v-inform, ",":U ) <> "1":U
     2411       then do:
     2412         delete object bh_tbl-name no-error.
     2413         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     2414       end.
     2415       assign
     2416         v-idx-field-qnty = num-entries( v-inform ) - 4
     2417       .
     2418       if v-idx-field-qnty < 2 then do:
     2419         delete object bh_tbl-name no-error.
     2420         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     2421       end.
     2422       assign
     2423         o-where     = "where":U
     2424         v-word-link = "":U
     2425         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2426         v-count-fld = 0
     2427       .
     2428       if i-tablekey ne "" and i-tablekey ne ?
     2429       then do:
     2430         assign
     2431           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2432         .
     2433         create buffer bh_tbl-key for table v-full-tbl-name .
     2434       end.
     2435       if i-tableSerach ne "" and i-tableSerach ne ?
     2436       then do:
     2437         delete object bh_tbl-name no-error.
     2438         assign
     2439           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2440         .
     2441         create buffer bh_tbl-name for table v-full-tbl-name .
     2442       end.
     2443       block_where:
     2444       do v-ind = 1 to v-idx-field-qnty by 2
     2445       on error undo, return error
     2446       :
     2447         assign
     2448           v-count-fld = v-count-fld + 1
     2449         .
     2450         if p-key-handle = ?
     2451           and v-count-fld > v-field-num
     2452         then do:
     2453           leave block_where.
     2454         end.
     2455         define variable VfieldKeyTable as handle no-undo.
     2456         assign
     2457           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2458           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2459         .
     2460         if     bh_tbl-key ne ?
     2461         then do:
     2462            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2463            if VfieldKeyTable eq ?
     2464            then next block_where.
     2465         end.
     2466         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2467         then
     2468            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2469         else
     2470            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2471         if p-key-handle = ? then do:
     2472           assign
     2473             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2474           .
     2475         end.
     2476         else do:
     2477           assign
     2478             fh_key = p-key-handle:buffer-field( v-field-name )
     2479           .
     2480           if fh_key = ?
     2481             or not valid-handle( fh_key )
     2482           then do:
     2483             delete object bh_tbl-name.
     2484             if     bh_tbl-key ne ?
     2485             then
     2486                delete object bh_tbl-key.
     2487             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     2488           end.
     2489           assign
     2490             v-field-val = fh_key:buffer-value
     2491           .
     2492         end.
     2493         if fh_search:data-type ="character":U then do:
     2494           assign
     2495             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2496             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2497             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2498             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2499             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2500             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2501             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2502             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2503             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2504             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2505             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2506             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2507             v-field-val = substitute( '"&1"', v-field-val )
     2508           .
     2509         end.
     2510         assign
     2511           o-where = substitute( "&1 &2", o-where, v-field-val )
     2512         .
     2513         if v-word-link = "":U then do:
     2514           assign
     2515             v-word-link = "and":U
     2516           .
     2517         end.
     2518       end.
     2519       delete object bh_tbl-name.
     2520       if     bh_tbl-key ne ?
     2521       then
     2522          delete object bh_tbl-key.
     2523       if p-key-handle = ?
     2524         and v-count-fld <> v-field-num
     2525       then do:
     2526         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     2527       end.
     2528     end.
     2529   end procedure.
     2530   procedure gen-hn-keyr-tab :
     2531     define input  parameter i-tableSerach as character no-undo.
     2532     define input  parameter i-tablekey   as character no-undo.
     2533     define input  parameter p-key-rec    as character no-undo.
     2534     define input  parameter p-key-handle as handle    no-undo .
     2535     define input  parameter p-db-name    as character no-undo .
     2536     define input  parameter p-tt-handle  as handle    no-undo .
     2537     define input  parameter p-stts-lock  as integer   no-undo .
     2538     define output parameter o-hn         as handle    no-undo.
     2539     define variable v-full-tbl-name as character no-undo.
     2540     define variable v-where         as character no-undo.
     2541     define variable bh_tbl-name     as handle    no-undo.
     2542     define variable vTable          as character no-undo.
     2543     do
     2544     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2545     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2546     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2547         run gen-where-keyr-tab(i-tableSerach,
     2548                                i-tablekey,
     2549                                p-key-rec,
     2550                                p-key-handle,
     2551                                p-db-name,
     2552                                p-tt-handle,
     2553                                output v-where).
     2554         if i-tableSerach ne "" and i-tableSerach ne ?
     2555         then do:
     2556            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2557            create buffer bh_tbl-name for table v-full-tbl-name .
     2558         end.
     2559         else do:
     2560            if p-tt-handle = ? then do:
     2561               assign
     2562                  vTable = entry( 1 , p-key-rec, chr(3) )
     2563               .
     2564               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2565               create buffer bh_tbl-name for table v-full-tbl-name .
     2566            end.
     2567            else do:
     2568               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2569            end.
     2570         end.
     2571         if p-tt-handle = ? then do:
     2572            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2573         end.
     2574         else do:
     2575            bh_tbl-name:find-first( v-where ) no-error .
     2576         end.
     2577         o-hn = bh_tbl-name.
     2578      end.
     2579   end procedure.
     2580   procedure gen-hn-keyr :
     2581     define input  parameter p-key-rec    as character no-undo.
     2582     define input  parameter p-key-handle as handle    no-undo .
     2583     define input  parameter p-db-name    as character no-undo .
     2584     define input  parameter p-tt-handle  as handle    no-undo .
     2585     define input  parameter p-stts-lock  as integer   no-undo .
     2586     define output parameter o-hn         as handle    no-undo.
     2587     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2588   end.
     2589   procedure gen-row-keyr :
     2590     define input  parameter p-key-rec    as character no-undo.
     2591     define input  parameter p-key-handle as handle    no-undo .
     2592     define input  parameter p-db-name    as character no-undo .
     2593     define input  parameter p-tt-handle  as handle    no-undo .
     2594     define input  parameter p-stts-lock  as integer   no-undo .
     2595     define output parameter p-tbl-row    as rowid     no-undo.
     2596     define output parameter p-tbl-name   as character no-undo.
     2597     define variable vHn as handle no-undo.
     2598       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2599       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2600       p-tbl-name =  vHn:table.
     2601       delete object vHn no-error.
     2602     if p-tbl-row = ? then do:
     2603       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     2604     end.
     2605     else do:
     2606       return.
     2607     end.
     2608   end procedure.
     2609   procedure gen-key-fv :
     2610     define input  parameter p-key-rec    as character no-undo .
     2611     define output parameter p-field-list as character no-undo .
     2612     define output parameter p-value-list as character no-undo.
     2613     do
     2614     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2615     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2616     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2617     :
     2618       define variable v-full-tbl-name  as character no-undo .
     2619       define variable bh_tbl-name      as handle    no-undo .
     2620       define variable v-tbl-name       as character no-undo .
     2621       define variable v-field-num      as integer   no-undo .
     2622       define variable v-count-fld      as integer   no-undo .
     2623       define variable v-inform         as character no-undo .
     2624       define variable v-ind            as integer   no-undo .
     2625       define variable v-idx-field-qnty as integer   no-undo .
     2626       define variable v-delim-key      as character no-undo .
     2627       if p-key-rec = ?
     2628         or p-key-rec = "":U
     2629       then do:
     2630         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     2631       end.
     2632       assign
     2633         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2634         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2635       .
     2636       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2637       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     2638       assign
     2639         v-inform = bh_tbl-name:index-information(1)
     2640         v-ind    = 2
     2641       .
     2642       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2643       on error undo, return error
     2644       :
     2645         assign
     2646           v-inform = bh_tbl-name:index-information( v-ind )
     2647           v-ind    = v-ind + 1
     2648         .
     2649       end.
     2650       if v-inform = ?
     2651         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2652         or entry( 3, v-inform, ",":U ) <> "1":U
     2653       then do:
     2654         delete object bh_tbl-name no-error.
     2655         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     2656       end.
     2657       assign
     2658         v-idx-field-qnty = num-entries( v-inform ) - 4
     2659       .
     2660       if v-idx-field-qnty < 2 then do:
     2661         delete object bh_tbl-name no-error.
     2662         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     2663       end.
     2664       assign
     2665         p-field-list = "":U
     2666         p-value-list = "":U
     2667         v-delim-key  = "":U
     2668         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2669         v-count-fld  = 0
     2670       .
     2671       block_where:
     2672       do v-ind = 1 to v-idx-field-qnty by 2
     2673       on error undo, return error
     2674       :
     2675         assign
     2676           v-count-fld = v-count-fld + 1
     2677         .
     2678         if v-count-fld > v-field-num then do:
     2679           leave block_where.
     2680         end.
     2681         assign
     2682           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2683           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2684         .
     2685         if v-ind = 1 then do:
     2686           assign
     2687             v-delim-key = chr(3)
     2688           .
     2689         end.
     2690       end.
     2691       delete object bh_tbl-name.
     2692       if v-count-fld <> v-field-num then do:
     2693         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     2694       end.
     2695     end.
     2696   end procedure.
     2697   procedure gen-key-field :
     2698     define input  parameter p-table      as character no-undo .
     2699     define output parameter p-field-list as character no-undo .
     2700     do
     2701     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2702     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2703     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2704     :
     2705       define variable v-full-tbl-name  as character no-undo .
     2706       define variable bh_tbl-name      as handle    no-undo .
     2707       define variable v-tbl-name       as character no-undo .
     2708       define variable v-field-num      as integer   no-undo .
     2709       define variable v-count-fld      as integer   no-undo .
     2710       define variable v-inform         as character no-undo .
     2711       define variable v-ind            as integer   no-undo .
     2712       define variable v-idx-field-qnty as integer   no-undo .
     2713       define variable v-delim-key      as character no-undo .
     2714       if p-table = ?
     2715         or p-table = "":U
     2716       then do:
     2717         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     2718       end.
     2719       assign
     2720         v-tbl-name      = p-table
     2721         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2722       .
     2723       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2724       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     2725       assign
     2726         v-inform = bh_tbl-name:index-information(1)
     2727         v-ind    = 2
     2728       .
     2729       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2730       on error undo, return error
     2731       :
     2732         assign
     2733           v-inform = bh_tbl-name:index-information( v-ind )
     2734           v-ind    = v-ind + 1
     2735         .
     2736       end.
     2737       if v-inform = ?
     2738         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2739         or entry( 3, v-inform, ",":U ) <> "1":U
     2740       then do:
     2741         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     2742       end.
     2743       assign
     2744         v-idx-field-qnty = num-entries( v-inform ) - 4
     2745       .
     2746       if v-idx-field-qnty < 2 then do:
     2747         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     2748       end.
     2749       assign
     2750         p-field-list = "":U
     2751         v-delim-key  = "":U
     2752         v-count-fld  = 0
     2753       .
     2754       block_where:
     2755       do v-ind = 1 to v-idx-field-qnty by 2
     2756       on error undo, return error
     2757       :
     2758         assign
     2759           v-count-fld = v-count-fld + 1
     2760         .
     2761         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2762         if v-ind = 1 then do:
     2763           assign
     2764             v-delim-key = chr(3)
     2765           .
     2766         end.
     2767       end.
     2768       delete object bh_tbl-name.
     2769     end.
     2770   end procedure.
     2771   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772   define new global shared variable g#lib-nws as handle no-undo .
     2773   procedure disproph_write-dis-card-property-proc  :
     2774   define parameter buffer buf_dis-card-property for ub.dis-card-property .
     2775   define parameter buffer buf_dis-card for ub.dis-card.
     2776   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
     2777   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
     2778   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
     2779   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
     2780   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
     2781   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
     2782   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
     2783   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
     2784   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
     2785   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
     2786   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
     2787   define input parameter p-action      as integer no-undo .
     2788   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
     2789   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
     2790   define input-output parameter p-chip-num as integer no-undo .
     2791   define input-output parameter p-corr-date as date no-undo .
     2792   define input-output parameter p-corr-time as integer no-undo .
     2793   define variable v-date as date      no-undo.
     2794   define variable v-time  as integer   no-undo.
     2795   define variable v-uniq-key-rec as character no-undo .
     2796   define variable v-send as integer no-undo .
     2797   define buffer buf_c-dc-hist for ub.c-dc-hist.
     2798   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
     2799     main-block:
     2800     do
     2801     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2802     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2803     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2804     :
     2805       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
     2806         message
     2807           vss-workfile vss-revision vss-description skip
     2808           "Ошибка задания входных параметров" skip
     2809           "Не определена запись СВОЙСТВА ДК" skip
     2810           view-as alert-box error .
     2811         undo, return error .
     2812       end.
     2813     v-send = integer('0':U).
     2814     if not p-action = integer('1':U) then do:
     2815       if available buf_dis-card then do:
     2816         if g#news then do:
     2817   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2818   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     2819     (input  g#db-num
     2820     ,input  'dis-card-property':U
     2821     ,input  0
     2822     ,input  '':U
     2823     ,input  0
     2824     ,input  buf_dis-card.type
     2825     ,input  '':U
     2826     ,input  '':U
     2827     ,input  buf_dis-card.emitent-host-code
     2828     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     2829     ,input  0
     2830     ,input  'nws-to-hist'
     2831     ,output v-send
     2832     ) no-error .
     2833         end.
     2834         else do:
     2835   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     2837     (input  g#db-num
     2838     ,input  'dis-card-property':U
     2839     ,input  0
     2840     ,input  '':U
     2841     ,input  0
     2842     ,input  buf_dis-card.type
     2843     ,input  '':U
     2844     ,input  '':U
     2845     ,input  buf_dis-card.emitent-host-code
     2846     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     2847     ,input  0
     2848     ,input  'hist-from-prim'
     2849     ,output v-send
     2850     ) no-error .
     2851         end.
     2852       end.
     2853     end.
     2854     if v-send >= 0 then do:
     2855       run cur-time in this-procedure(output v-date, output v-time).
     2856       if p-action = integer('1':U) then do:
     2857         create buf_c-dis-card-property.
     2858         assign
     2859         buf_c-dis-card-property.d-card            = p-d-card
     2860         buf_c-dis-card-property.card-num          = p-card-num
     2861         buf_c-dis-card-property.host-code         = p-host-code
     2862         buf_c-dis-card-property.obj-type          = p-obj-type
     2863         buf_c-dis-card-property.obj-code          = p-obj-code
     2864         buf_c-dis-card-property.dt-code           = p-dt-code
     2865         buf_c-dis-card-property.node-code         = p-node-code
     2866         buf_c-dis-card-property.dtm-code         = p-dtm-code
     2867         buf_c-dis-card-property.main-card         = p-main-card
     2868         buf_c-dis-card-property.first-main-card   = p-first-main-card
     2869         buf_c-dis-card-property.first-card        = p-first-card
     2870         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
     2871                                                      then next-value (s-dc-chip, ub)
     2872                                                      else p-chip-num)
     2873         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
     2874                                                      then v-time
     2875                                                      else p-corr-time)
     2876         buf_c-dis-card-property.corr-user-db-num  = g#db-num
     2877         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
     2878         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
     2879                                                      then v-date
     2880                                                      else p-corr-date)
     2881         .
     2882       end.
     2883       else do:
     2884         create buf_c-dis-card-property.
     2885         buffer-copy buf_dis-card-property to buf_c-dis-card-property
     2886         assign
     2887         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
     2888         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
     2889         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
     2890         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
     2891         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
     2892         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
     2893         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
     2894         buf_c-dis-card-property.obj-type          = p-obj-type
     2895         buf_c-dis-card-property.obj-code          = p-obj-code
     2896         buf_c-dis-card-property.node-code         = p-node-code
     2897         buf_c-dis-card-property.dtm-code         = p-dtm-code
     2898         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
     2899                                                       then next-value (s-dc-chip, ub)
     2900                                                       else p-chip-num)
     2901         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
     2902                                                       then v-time
     2903                                                       else p-corr-time)
     2904         buf_c-dis-card-property.corr-user-db-num   = g#db-num
     2905               buf_c-dis-card-property.corr-user-name    = (if g#news
     2906                                                      then (chr(4) +  'СПН':U)
     2907                                                      else (if g#esys
     2908                                                            then (chr(4) +  'ВС':U)
     2909                                                            else g#userid
     2910                                                            )
     2911                                                      )
     2912         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     2913                                                       then v-date
     2914                                                       else p-corr-date)
     2915         .
     2916         run gen-key-rec in this-procedure (
     2917                                             input 'dis-card-property':U
     2918                                           ,input buffer buf_dis-card-property:handle
     2919                                           ,output v-uniq-key-rec).
     2920       end.
     2921       if p-chip-num = 0   then do:
     2922         create buf_c-dc-hist.
     2923         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     2924         assign
     2925         buf_c-dc-hist.action =  p-action
     2926         buf_c-dc-hist.subject = 'dis-card-property':U
     2927         buf_c-dc-hist.is-news = g#news
     2928         buf_c-dc-hist.source-type = p-source-type
     2929         buf_c-dc-hist.source-ref = p-source-ref
     2930         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
     2931         .
     2932       end.
     2933       assign
     2934       p-chip-num = buf_c-dis-card-property.chip-num
     2935       p-corr-date = buf_c-dis-card-property.corr-date
     2936       p-corr-time = buf_c-dis-card-property.corr-time
     2937       .
     2938       run disproph_send-nws in this-procedure (
     2939                                                 buffer buf_c-dis-card-property
     2940                                                ,buffer buf_c-dc-hist
     2941                                                ,buffer buf_dis-card
     2942                                                 ).
     2943       end.
     2944     end.
     2945   end procedure.
     2946   procedure disproph_send-nws :
     2947   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     2948   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     2949   define parameter buffer buf_Dis-card for ub.dis-card.
     2950   define variable v-dh-hn as integer no-undo .
     2951   main-block:
     2952   do
     2953   on error undo, return error return-value
     2954   :
     2955     if g#news
     2956     and g#db-num > 0
     2957     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     2958     then return.
     2959     if g#db-num = 0
     2960     or (g#news
     2961         and g#db-num > 0
     2962         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     2963         )
     2964     then do:
     2965       if not available buf_dis-card then do:
     2966         find first buf_dis-card no-lock where
     2967                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     2968       end.
     2969       if not available buf_dis-card then do:
     2970         assign
     2971         v-dh-hn = integer('0':U).
     2972       end.
     2973       else do:
     2974   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2975   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     2976     (input  g#db-num
     2977     ,input  'dis-card-property':U
     2978     ,input  0
     2979     ,input  '':U
     2980     ,input  0
     2981     ,input  buf_dis-card.type
     2982     ,input  '':U
     2983     ,input  '':U
     2984     ,input  buf_dis-card.emitent-host-code
     2985     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     2986     ,input  0
     2987     ,input  'hist-to-nws'
     2988     ,output v-dh-hn
     2989     ) no-error .
     2990       end.
     2991       if v-dh-hn >= 0 then do:
     2992         run str/callnews.p (
     2993           input 'c-dis-card-property':U
     2994           ,input (buffer buf_c-dis-card-property:handle)
     2995           ) no-error .
     2996         if error-status:error then do:
     2997           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     2998         end.
     2999         if available buf_c-dc-hist then do:
     3000           run str/callnews.p (
     3001             input 'c-dc-hist':U
     3002             ,input (buffer buf_c-dc-hist:handle)
     3003             ) no-error .
     3004           if error-status:error then do:
     3005             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3006           end.
     3007         end.
     3008       end.
     3009     end.
     3010   end.
     3011   end procedure.
     3012   procedure discprop-node-code :
     3013   define input parameter p-dtm-code as integer no-undo .
     3014   define input parameter p-node-code as integer no-undo .
     3015   define output parameter p-data-type as character no-undo .
     3016   define output parameter p-format as character no-undo .
     3017   define output parameter p-label as character no-undo .
     3018   define output parameter p-range as integer no-undo .
     3019   define output parameter p-rw-option as character no-undo .
     3020   define buffer buf_prop-map for ub.prop-map.
     3021   define buffer buf_prop-head for ub.prop-head.
     3022   do
     3023   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3024   :
     3025   find first buf_prop-head no-lock where
     3026             buf_prop-head.dtm-code = p-dtm-code no-error .
     3027   if available buf_prop-head then do:
     3028     if p-node-code > 0 then do:
     3029       find first buf_prop-map no-lock where
     3030                 buf_prop-map.dtm-code = p-dtm-code
     3031             and buf_prop-map.node-code = p-node-code no-error .
     3032       if available buf_prop-map then do:
     3033         assign
     3034         p-data-type = buf_prop-map.node-value-type
     3035         p-format = buf_prop-map.node-format
     3036         p-label = buf_prop-map.node-label
     3037         p-rw-option = buf_prop-map.rw-option
     3038         .
     3039       end.
     3040     end.
     3041     if buf_prop-head.storage-place  = "":U
     3042     and buf_prop-head.storage-place-host  > "":U
     3043     and buf_prop-head.storage-place-obj  > "":U then do:
     3044       p-range =  12.
     3045     end.
     3046     if buf_prop-head.storage-place  > "":U
     3047     and buf_prop-head.storage-place-host  > "":U
     3048     and buf_prop-head.storage-place-obj  > "":U then do:
     3049       p-range =  3.
     3050     end.
     3051     if buf_prop-head.storage-place  > "":U
     3052     and buf_prop-head.storage-place-host  > "":U
     3053     and buf_prop-head.storage-place-obj  = "":U then do:
     3054       p-range =  2.
     3055     end.
     3056     if buf_prop-head.storage-place  = "":U
     3057     and buf_prop-head.storage-place-host  > "":U
     3058     and buf_prop-head.storage-place-obj  = "":U then do:
     3059       p-range =  1.
     3060     end.
     3061     if buf_prop-head.storage-place  > "":U
     3062     and buf_prop-head.storage-place-host  = "":U
     3063     and buf_prop-head.storage-place-obj  = "":U then do:
     3064       p-range =  0.
     3065     end.
     3066   end.
     3067   end.
     3068   end procedure.
     3069   procedure discprop-initial:
     3070   define input parameter p-dtm-code as integer no-undo .
     3071   define input parameter p-node-code as integer no-undo .
     3072   define output parameter p-init-value-character as character no-undo .
     3073   define output parameter p-init-value-date as date no-undo .
     3074   define output parameter p-init-value-decimal as decimal no-undo .
     3075   define output parameter p-init-value-integer as integer no-undo .
     3076   define output parameter p-init-value-logical as logical no-undo .
     3077   define buffer buf_prop-map for ub.prop-map.
     3078   find first buf_prop-map no-lock where
     3079             buf_prop-map.dtm-code = p-dtm-code
     3080         and buf_prop-map.node-code = p-node-code no-error.
     3081   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     3082                                                               , p-node-code
     3083                                                               , p-dtm-code).
     3084   assign
     3085   p-init-value-character = buf_prop-map.init-value-character
     3086   p-init-value-date = buf_prop-map.init-value-date
     3087   p-init-value-decimal = buf_prop-map.init-value-decimal
     3088   p-init-value-integer = buf_prop-map.init-value-integer
     3089   p-init-value-logical = buf_prop-map.init-value-logical
     3090   .
     3091   end procedure.
     3092   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     3093   define buffer buf_attr-prop for ub.attr-prop.
     3094   find first buf_attr-prop no-lock where
     3095             buf_attr-prop.table-name = 'dis-card-property':U
     3096         and buf_attr-prop.templ-rl-root = p-dtm-code
     3097         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     3098         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     3099   if not available buf_attr-prop
     3100   or logical(buf_attr-prop.property-value) = no then do:
     3101     return no.
     3102   end.
     3103   return yes.
     3104   end function.
     3105   procedure discprop-edit :
     3106   define input parameter p-dtm-code-node-name as character no-undo .
     3107   define output parameter p-edit-menu-section-num as integer no-undo .
     3108   define buffer buf_attr-prop for ub.attr-prop.
     3109   do
     3110   on error undo, return error return-value
     3111   :
     3112     find first buf_attr-prop no-lock where
     3113             buf_attr-prop.table-name = 'dis-card-property':U
     3114        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     3115        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     3116        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     3117     if available buf_attr-prop then do:
     3118       assign
     3119       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     3120     end.
     3121   end.
     3122   end procedure.
     3123   procedure discprop-node-name :
     3124   define input parameter p-dtm-code-node-name as character no-undo .
     3125   define output parameter p-tool-tip as character no-undo .
     3126   define output parameter p-node-label as character no-undo .
     3127   define buffer buf_prop-map for ub.prop-map.
     3128   define buffer buf_prop-head for ub.prop-head.
     3129   do
     3130   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3131   :
     3132     find first buf_prop-head no-lock where
     3133               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     3134     assign
     3135     p-tool-tip   = if available buf_prop-head
     3136                    then buf_prop-head.prop-des
     3137                    else entry(1, p-dtm-code-node-name, chr(4) )
     3138     p-node-label = (if available buf_prop-head
     3139                     then buf_prop-head.prop-label
     3140                     else '':U)
     3141     .
     3142     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     3143       find first buf_prop-map no-lock where
     3144                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     3145           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     3146       if available buf_prop-map then do:
     3147         assign
     3148         p-tool-tip   = buf_prop-map.node-description
     3149         p-node-label = (if available buf_prop-head
     3150                         then buf_prop-head.prop-label
     3151                         else '':U) + ":" + buf_prop-map.node-label
     3152         .
     3153       end.
     3154     end.
     3155   end.
     3156   end procedure.
     3157   procedure discprop-write :
     3158   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     3159   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     3160   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     3161   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     3162   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     3163   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     3164   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     3165   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     3166   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     3167   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     3168   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     3169   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     3170   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     3171   define input parameter p-source-type     as character no-undo .
     3172   define input parameter p-source-ref      as character no-undo .
     3173   define input-output parameter p-chip-num as integer no-undo .
     3174   define input-output parameter p-corr-date as date no-undo .
     3175   define input-output parameter p-corr-time as integer no-undo .
     3176   do
     3177   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3178   :
     3179     define buffer buf_dis-card-property for ub.dis-card-property .
     3180     define buffer buf_dis-card for ub.dis-card.
     3181     define buffer buf_prop-ref for ub.prop-ref.
     3182     define variable v-data-type      as character no-undo .
     3183     define variable v-data-type-1    as character no-undo .
     3184     define variable v-format         as character no-undo .
     3185     define variable v-label          as character no-undo .
     3186     define variable v-range          as integer   no-undo .
     3187     define variable v-rw-option      as character no-undo .
     3188     run discprop-node-code in this-procedure
     3189       (
     3190        input  p-dtm-code
     3191       ,input  p-node-code
     3192       ,output v-data-type
     3193       ,output v-format
     3194       ,output v-label
     3195       ,output v-range
     3196       ,output v-rw-option
     3197       ) no-error .
     3198     if error-status :error then do:
     3199       undo, return error return-value .
     3200     end.
     3201     v-data-type-1 = entry(1, v-data-type).
     3202     if p-dt-code = ? then do:
     3203       find buf_prop-ref no-lock where
     3204           buf_prop-ref.dtm-code = p-dtm-code
     3205       and buf_prop-ref.sum-id = p-sum-id no-error.
     3206       if not available buf_prop-ref then do:
     3207         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     3208                                       ,p-dtm-code
     3209                                       ,p-sum-id).
     3210       end.
     3211       assign
     3212       p-dt-code = buf_prop-ref.dt-code.
     3213     end.
     3214     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     3215       undo, return error "Нельзя редактировать свойство в данной БД".
     3216     end.
     3217     run discprop-check in this-procedure (
     3218                                             input v-range
     3219                                           ,input p-d-card
     3220                                           ,input p-host-code
     3221                                           ,input p-obj-type
     3222                                           ,input p-obj-code
     3223                                           ,input p-dtm-code
     3224                                           ,input p-node-code
     3225                                           ,input p-dt-code
     3226                                         ) no-error .
     3227     if error-status:error then undo,  return error return-value .
     3228     find first buf_dis-card-property exclusive-lock
     3229       where buf_dis-card-property.d-card    = p-d-card
     3230         and buf_dis-card-property.host-code = p-host-code
     3231         and buf_dis-card-property.obj-type  = p-obj-type
     3232         and buf_dis-card-property.obj-code  = p-obj-code
     3233         and buf_dis-card-property.dt-code = p-dt-code
     3234         and buf_dis-card-property.node-code = p-node-code
     3235       no-error .
     3236       find first buf_dis-card no-lock where
     3237                   buf_dis-card.d-card = p-d-card.
     3238     if not available buf_dis-card-property then do:
     3239       create buf_dis-card-property .
     3240       assign
     3241         buf_dis-card-property.d-card    = p-d-card
     3242         buf_dis-card-property.host-code = p-host-code
     3243         buf_dis-card-property.obj-type  = p-obj-type
     3244         buf_dis-card-property.obj-code  = p-obj-code
     3245         buf_dis-card-property.dt-code = p-dt-code
     3246         buf_dis-card-property.node-code = p-node-code
     3247         buf_dis-card-property.dtm-code = p-dtm-code
     3248         buf_dis-card-property.sum-id   = p-sum-id
     3249         buf_dis-card-property.card-num  = buf_dis-card.card-num
     3250         buf_dis-card-property.main-card  = buf_dis-card.main-card
     3251         buf_dis-card-property.first-card  = buf_dis-card.first-card
     3252         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     3253       .
     3254     end.
     3255     else do:
     3256       if (v-data-type-1 = 'character':U
     3257       and buf_dis-card-property.property-value-character = p-value-character)
     3258       or  (v-data-type-1 = 'date':U
     3259           and buf_dis-card-property.property-value-date = p-value-date)
     3260       or  (v-data-type-1 = 'decimal':U
     3261           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     3262       or  (v-data-type-1 = 'integer':U
     3263           and buf_dis-card-property.property-value-integer = p-value-integer)
     3264       or  (v-data-type-1 = 'logical':U
     3265           and buf_dis-card-property.property-value-logical = p-value-logical)
     3266       then return.
     3267     end.
     3268     run disproph_write-dis-card-property-proc  in this-procedure (
     3269             buffer buf_dis-card-property
     3270             ,buffer Buf_dis-card
     3271             ,input p-d-card
     3272             ,input p-dt-code
     3273             ,input p-host-code
     3274             ,input p-obj-type
     3275             ,input p-obj-code
     3276             ,input p-dtm-code
     3277             ,input buf_dis-card.card-num
     3278             ,input buf_dis-card.main-card
     3279             ,input buf_dis-card.first-card
     3280             ,input buf_dis-card.first-main-card
     3281             ,input p-node-code
     3282             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     3283             ,input p-source-type
     3284             ,input p-source-ref
     3285             ,input-output p-chip-num
     3286             ,input-output p-corr-date
     3287             ,input-output p-corr-time
     3288             ).
     3289     assign
     3290     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     3291                                                       then p-value-character
     3292                                                       else buf_dis-card-property.property-value-character)
     3293     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     3294                                                       then p-value-date
     3295                                                       else buf_dis-card-property.property-value-date)
     3296     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     3297                                                       then p-value-decimal
     3298                                                       else buf_dis-card-property.property-value-decimal)
     3299     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     3300                                                       then p-value-integer
     3301                                                       else buf_dis-card-property.property-value-integer)
     3302     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     3303                                                       then p-value-logical
     3304                                                       else buf_dis-card-property.property-value-logical)
     3305     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     3306     .
     3307     release buf_dis-card-property no-error .
     3308     if error-status:error then do:
     3309       return error return-value .
     3310     end.
     3311   end.
     3312   end procedure.
     3313   procedure discprop-delete :
     3314   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     3315   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     3316   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     3317   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     3318   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     3319   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     3320   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     3321   define input parameter p-source-type as character no-undo .
     3322   define input parameter p-source-ref as character no-undo .
     3323   define output parameter p-deleted  as logical no-undo.
     3324   define input-output parameter p-chip-num as integer no-undo .
     3325   define input-output parameter p-corr-date as date no-undo .
     3326   define input-output parameter p-corr-time as integer no-undo .
     3327   do
     3328   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3329   :
     3330   define buffer buf_dis-card-property for ub.dis-card-property .
     3331   define buffer buf_dis-card for ub.dis-card.
     3332   define variable v-data-type      as character no-undo .
     3333   define variable v-format         as character no-undo .
     3334   define variable v-label          as character no-undo .
     3335   define variable v-range          as integer   no-undo .
     3336   define variable v-rw-option      as character   no-undo .
     3337     run discprop-node-code in this-procedure
     3338       (input  p-dtm-code
     3339       ,input  p-node-code
     3340       ,output v-data-type
     3341       ,output v-format
     3342       ,output v-label
     3343       ,output v-range
     3344       ,output v-rw-option
     3345       ) no-error .
     3346     if error-status :error then do:
     3347       undo, return error return-value .
     3348     end.
     3349     find first buf_dis-card-property exclusive-lock
     3350       where buf_dis-card-property.d-card    = p-d-card
     3351         and buf_dis-card-property.host-code = p-host-code
     3352         and buf_dis-card-property.obj-type  = p-obj-type
     3353         and buf_dis-card-property.obj-code  = p-obj-code
     3354         and buf_dis-card-property.dt-code = p-dt-code
     3355         and buf_dis-card-property.node-code = p-node-code
     3356       no-error NO-WAIT.
     3357     if not available buf_dis-card-property then do:
     3358       p-deleted = no.
     3359     end.
     3360     else do:
     3361       run disproph_write-dis-card-property-proc  in this-procedure (
     3362            buffer buf_dis-card-property
     3363           ,buffer buf_dis-card
     3364           ,input buf_dis-card-property.d-card
     3365           ,input buf_dis-card-property.dt-code
     3366           ,input buf_dis-card-property.host-code
     3367           ,input buf_dis-card-property.obj-type
     3368           ,input buf_dis-card-property.obj-code
     3369           ,input buf_dis-card-property.dtm-code
     3370           ,input buf_dis-card-property.card-num
     3371           ,input buf_dis-card-property.main-card
     3372           ,input buf_dis-card-property.first-card
     3373           ,input buf_dis-card-property.first-main-card
     3374           ,input buf_dis-card-property.node-code
     3375           ,input integer('99':U)
     3376           ,input p-source-type
     3377           ,input p-source-ref
     3378           ,input-output p-chip-num
     3379           ,input-output p-corr-date
     3380           ,input-output p-corr-time
     3381            ).
     3382       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     3383       delete buf_dis-card-property no-error .
     3384       if error-status:error then do:
     3385         return error return-value.
     3386       end.
     3387       p-deleted = yes.
     3388     end.
     3389   end.
     3390   end procedure.
     3391   procedure discprop-check :
     3392   define input parameter p-range  as integer no-undo .
     3393   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     3394   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     3395   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     3396   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     3397   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     3398   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     3399   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     3400   define variable v-message as character no-undo .
     3401   define buffer buf_sysconf for ub.sysconf.
     3402   define buffer buf_clients for ub.clients.
     3403   define buffer buf_dis-card for ub.dis-card.
     3404   define buffer buf_attr-prop for ub.attr-prop.
     3405   do
     3406   on error undo, return error return-value
     3407   :
     3408     if p-host-code > 0 then do:
     3409       FIND FIRST buf_sysconf No-LOCK WHERE
     3410                 buf_sysconf.host-code = p-host-code No-ERROR.
     3411       IF NOT AVAIL buf_sysconf THEN DO:
     3412         v-message = substitute("Не найдена фирма &1", p-host-code).
     3413         RETURN ERROR v-message.
     3414       END.
     3415     end.
     3416     if p-obj-type <> "":U or
     3417         p-obj-code <> 0 then do:
     3418       find first buf_clients No-LOCK WHERE
     3419                 buf_clients.obj-type = p-obj-type AND
     3420                 buf_clients.obj-code = p-obj-code no-error .
     3421       if not available buf_clients then do:
     3422         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     3423         RETURN ERROR v-message.
     3424       end.
     3425     end.
     3426     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     3427       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     3428                               , p-obj-type
     3429                               , p-obj-code
     3430                               , p-host-code).
     3431       RETURN ERROR v-message.
     3432     end.
     3433     if p-d-card <> "":U then do:
     3434       find first buf_dis-card No-LOCK WHERE
     3435                   buf_dis-card.d-card = p-d-card No-ERROR.
     3436       if not avail buf_dis-card then do:
     3437         v-message =substitute("Не найдена ДК").
     3438         return error  v-message.
     3439       end.
     3440       if buf_dis-card.emitent-host-code <> 0
     3441       and p-host-code <> buf_dis-card.emitent-host-code then do:
     3442         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     3443         return error v-message.
     3444       end.
     3445       if buf_dis-card.emitent-host-code = 0
     3446       and p-range = 1
     3447       and p-host-code <> 0 then do:
     3448         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     3449                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     3450                                 , chr(10)
     3451                               ).
     3452         return error v-message.
     3453       end.
     3454     end.
     3455   end.
     3456   end procedure.
     3457   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3458   define variable dcard-algo-field-name as character no-undo extent 3 init [
     3459    'd-pcnt':U
     3460   ,'cash-d-pcnt':U
     3461   ,'pcnt-kat':U].
     3462   define variable algo-field-abbr as character no-undo extent 3 init [
     3463    'ITEM%':U
     3464   ,'TOTAL%':U
     3465   ,'CATEG':U].
     3466   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     3467   define variable v-date-str as character no-undo .
     3468   assign
     3469   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     3470                string(Month(p-date), "99":U) + chr(47) +
     3471                string(DAY(p-date), "99":U).
     3472   return v-date-str.
     3473   END FUNCTION.
     3474   function dct-algo-string-to-date returns date ( input p-string  as character):
     3475     define variable v-date as date no-undo .
     3476     assign
     3477     v-date = date(integer(substring(p-string, 6, 2))
     3478                   ,integer(substring(p-string, 9, 2))
     3479                   ,integer(substring(p-string, 1, 4))
     3480                  ) no-error .
     3481     if error-status:error then return ?.
     3482     return v-date.
     3483   END FUNCTION.
     3484   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     3485   define buffer buf_prop-ref for ub.prop-ref.
     3486   find first buf_prop-ref no-lock where
     3487             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     3488   if not available buf_prop-ref then do:
     3489     return chr(63).
     3490   end.
     3491   return buf_prop-ref.sum-id.
     3492   END FUNCTION.
     3493   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     3494   define variable v-des as character no-undo .
     3495   define buffer buf_prop-ref for ub.prop-ref.
     3496   define buffer buf_prop-head for ub.prop-head.
     3497   find first buf_prop-ref no-lock where
     3498             buf_prop-ref.dt-code = p-dt-code no-error.
     3499   if not available buf_prop-ref then do:
     3500     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     3501   end.
     3502   find first buf_prop-head no-lock where
     3503           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     3504   if not available buf_prop-head then do:
     3505     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     3506   end.
     3507   assign
     3508   v-des = substitute("&1  &2 &3"
     3509                     , buf_prop-head.prop-name
     3510                     , buf_prop-ref.sum-id
     3511                     , buf_prop-ref.caller_id).
     3512   return v-des.
     3513   end FUNCTION.
     3514   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     3515                                                               ,input p-dt-code as integer
     3516                                                               ,input p-node-code as integer
     3517                                                               ):
     3518   define variable v-des as character no-undo .
     3519   define buffer buf_prop-ref for ub.prop-ref.
     3520   define buffer buf_prop-head for ub.prop-head.
     3521   define buffer buf_prop-map for ub.prop-map.
     3522   find first buf_prop-ref no-lock where
     3523             buf_prop-ref.dt-code = p-dt-code no-error.
     3524   if not available buf_prop-ref then do:
     3525     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     3526   end.
     3527   find first buf_prop-head no-lock where
     3528           buf_prop-head.dtm-code = p-dtm-code no-error.
     3529   if not available buf_prop-head then do:
     3530     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     3531   end.
     3532   find first buf_prop-map no-lock where
     3533           buf_prop-map.dtm-code = p-dtm-code
     3534       and buf_prop-map.node-code = p-node-code no-error .
     3535   if not available buf_prop-map then do:
     3536     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     3537                       , p-dt-code
     3538                       , buf_prop-head.prop-label
     3539                       , p-node-code).
     3540   end.
     3541   assign
     3542   v-des = substitute("&1.&2 &3 &4"
     3543                     , buf_prop-head.prop-label
     3544                     , buf_prop-map.node-label
     3545                     , buf_prop-ref.sum-id
     3546                     , buf_prop-ref.caller_id).
     3547   return v-des.
     3548   end FUNCTION.
     3549   function dct-algo-get-prev-sum-id RETURNS integer (
     3550                                                       input p-dt-code as integer
     3551                                                      ):
     3552   define variable v-dtm-code as integer no-undo .
     3553   define variable v-sum-id as character no-undo .
     3554   define variable v-caller-id as character no-undo .
     3555   define buffer buf_prop-ref for ub.prop-ref.
     3556   find first buf_prop-ref no-lock where
     3557           buf_prop-ref.dt-code = p-dt-code no-error.
     3558   if not available buf_prop-ref then return ?.
     3559   assign
     3560   v-dtm-code = buf_prop-ref.dtm-code
     3561   v-sum-id = buf_prop-ref.sum-id.
     3562   v-caller-id = buf_prop-ref.caller_id.
     3563   find last buf_prop-ref no-lock where
     3564             buf_prop-ref.dtm-code = v-dtm-code
     3565        and  buf_prop-ref.sum-id < v-sum-id
     3566        and  buf_prop-ref.caller_id = v-caller-id
     3567        no-error.
     3568   if available buf_prop-ref then return buf_prop-ref.dt-code.
     3569   return -1 .
     3570   END FUNCTION.
     3571   FUNCTION dct-algo-get_dcproperty-value returns logical (
     3572                                                             input p-prop-name as character
     3573                                                           , input p-d-card    as character
     3574                                                           , input p-host-code as integer
     3575                                                           , input p-obj-type  as character
     3576                                                           , input p-obj-code  as integer
     3577                                                           , output p-value-character as character
     3578                                                           , output p-value-date   as date
     3579                                                           , output p-value-integer as integer
     3580                                                           , output p-value-decimal as decimal
     3581                                                           , output p-value-logical as logical):
     3582     return no.
     3583   END FUNCTION.
     3584   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     3585                                                             input p-d-card    as character
     3586                                                           , input p-emitent-host-code as integer
     3587                                                           , input p-type as character
     3588                                                           , input p-host-code as integer
     3589                                                           , input p-obj-type  as character
     3590                                                           , input p-obj-code  as integer
     3591                                                           , output p-value-chr as character):
     3592   define variable v-dt-code as integer no-undo .
     3593   define variable v-node-code as integer no-undo .
     3594   define variable v-field-name as character no-undo .
     3595   define variable v-storage-place as character no-undo .
     3596   define variable v-sum-id-value as character no-undo .
     3597   define variable v-sum-id-output as logical no-undo .
     3598   define variable v-value-chr as character no-undo .
     3599   define variable v-ii as integer no-undo .
     3600   define buffer buf_dis-card-property for ub.dis-card-property.
     3601   define buffer buf_dis-host for ub.dis-host.
     3602   define buffer buf_dis-obj for ub.dis-obj.
     3603   run get-cd-sumid in this-procedure (
     3604                                         input p-emitent-host-code
     3605                                        ,input p-type
     3606                                        ,input p-host-code
     3607                                        ,input p-obj-type
     3608                                        ,input p-obj-code
     3609                                        ,output v-sum-id-value
     3610                                        ,output v-sum-id-output
     3611                                       ) no-error.
     3612   if not v-sum-id-output then do:
     3613     return no.
     3614   end.
     3615   do v-ii = 1 to num-entries(v-sum-id-value):
     3616     assign
     3617     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     3618     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     3619     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     3620     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     3621     no-error .
     3622     if not error-status:error then do:
     3623       case v-storage-place:
     3624         when 'dis-card-property':U then do:
     3625           find first buf_dis-card-property no-lock where
     3626                     buf_dis-card-property.d-card = p-d-card
     3627               and  buf_dis-card-property.host-code = p-host-code
     3628               and  buf_dis-card-property.obj-type = p-obj-type
     3629               and  buf_dis-card-property.obj-code = p-obj-code
     3630               and  buf_dis-card-property.dt-code = v-dt-code
     3631               and  buf_dis-card-property.node-code = v-node-code no-error .
     3632           if available buf_dis-card-property then do:
     3633             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     3634           end.
     3635           else do:
     3636             v-value-chr = chr(63).
     3637           end.
     3638         end.
     3639         when 'dis-obj':U then do:
     3640           find first buf_dis-obj no-lock where
     3641                     buf_dis-obj.d-card = p-d-card
     3642               and  buf_dis-obj.obj-type = p-obj-type
     3643               and  buf_dis-obj.obj-code = p-obj-code
     3644               and  buf_dis-obj.dt-code = v-dt-code no-error .
     3645           if available buf_dis-obj then do:
     3646             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     3647           end.
     3648           else do:
     3649             v-value-chr = chr(63).
     3650           end.
     3651         end.
     3652         when 'dis-host':U then do:
     3653           find first buf_dis-host no-lock where
     3654                     buf_dis-host.d-card = p-d-card
     3655               and  buf_dis-host.host-code = p-host-code
     3656               and  buf_dis-host.dt-code = v-dt-code no-error .
     3657           if available buf_dis-host then do:
     3658             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     3659           end.
     3660           else do:
     3661             v-value-chr = chr(63).
     3662           end.
     3663         end.
     3664       end.
     3665     end.
     3666     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     3667   end.
     3668   END FUNCTION.
     3669   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     3670     ( INPUT p-custom-sent as character ) :
     3671   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     3672   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     3673   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     3674   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     3675   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     3676   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     3677   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     3678   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     3679   assign
     3680   v-storage-place = entry(1, p-custom-sent, chr(4))
     3681   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     3682   v-sum-id   = entry(3, p-custom-sent, chr(4))
     3683   v-caller-id = entry(4, p-custom-sent, chr(4))
     3684   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     3685   no-error .
     3686   IF ERROR-STATUS:ERROR THEN DO:
     3687     MESSAGE
     3688     "Не могу разобрать строку, описывающую итог"
     3689      VIEW-AS ALERT-BOX WARNING.
     3690     RETURN chr(63).
     3691   END.
     3692   FIND FIRST buf_prop-ref NO-LOCK WHERE
     3693             buf_prop-ref.dtm-code = v-dtm-code
     3694        AND  buf_prop-ref.sum-id = v-sum-id
     3695        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     3696   IF NOT AVAILABLE buf_prop-ref THEN DO:
     3697     FIND FIRST buf_prop-ref NO-LOCK WHERE
     3698               buf_prop-ref.dtm-code = v-dtm-code
     3699         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     3700     IF NOT AVAILABLE buf_prop-ref THEN DO:
     3701         MESSAGE
     3702         "Не могу разобрать строку, описывающую итог"
     3703          VIEW-AS ALERT-BOX WARNING.
     3704         RETURN chr(63).
     3705      end.
     3706   end.
     3707   ASSIGN
     3708   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     3709                                                          ,buf_prop-ref.dt-code
     3710                                                          ,v-node-code).
     3711   RETURN v-sum-id-description.
     3712   END FUNCTION.
     3713   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3714   function windows-date-format returns character ( input p-date  as date, input p-format as character ):
     3715   define variable v-string-date as character no-undo .
     3716   CASE p-format:
     3717     when "dd.mm.yyyy":U
     3718     or
     3719     when "dd.mm.yy":U
     3720     or
     3721     when "dd/mm/yy":U
     3722     then do:
     3723       assign
     3724       p-format = replace(p-format, "dd", "99")
     3725       p-format = replace(p-format, "mm", "99")
     3726       p-format = replace(p-format, "yy", "99")
     3727       v-string-date = string(p-date, p-format)
     3728       .
     3729     end.
     3730     when "d.m.yy":U then do:
     3731       ASSIGN
     3732       v-string-date = string(day(p-date), ">9") + string(month(p-date), ">9") +
     3733                       substring(string(p-date, "99/99/99"), 7, 2)
     3734       .
     3735     end.
     3736     when "yyyy-mm-dd":U then do:
     3737       ASSIGN
     3738       v-string-date = string(year(p-date), "9999") + "-":U + string(month(p-date), "99") + string(day(p-date), "99")
     3739       .
     3740     end.
     3741   END CASE.
     3742   return v-string-date.
     3743   END FUNCTION.
     3744   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3745   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
