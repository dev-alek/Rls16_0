      107   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure cur-time :
      109      define output parameter p-today as date      no-undo .
      110      define output parameter p-time  as integer   no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       define variable v-date1 as date      no-undo .
      115       define variable v-date2 as date      no-undo .
      116       define variable v-time  as integer   no-undo .
      117       assign
      118         v-date1 = today
      119         v-time  = time
      120         v-date2 = today
      121       .
      122       if v-date1 <> v-date2
      123       then do:
      124         assign
      125           v-date1 = today
      126           v-time  = v-time
      127         .
      128       end.
      129       assign
      130         p-today = v-date1
      131         p-time  = v-time
      132       .
      133     end.
      134   end.
      135   function cur-time-date returns character
      136   :
      137     return string(today, '99/99/9999':U) .
      138   end.
      139   function cur-time-mjd returns decimal
      140   :
      141     define variable v-date as date      no-undo .
      142     define variable v-time as integer   no-undo .
      143     run cur-time in this-procedure
      144       (output v-date
      145       ,output v-time
      146       ) .
      147     return integer(v-date) - 2400002 + (v-time / 86400) .
      148   end.
      149   function cur-time-get-ending-index returns integer
      150   (input p-number as integer
      151   )
      152   :
      153     if p-number < 0
      154     or p-number = ?
      155     then do:
      156       return 1 .
      157     end.
      158     define variable v-rest as integer   no-undo .
      159     assign
      160       p-number = p-number modulo 100
      161     .
      162     if p-number < 20
      163     then do:
      164       assign
      165         v-rest = p-number
      166       .
      167     end.
      168     else do:
      169       assign
      170         v-rest = p-number modulo 10
      171       .
      172     end.
      173     case v-rest :
      174       when 1
      175       then do:
      176         return 2 .
      177       end.
      178       when 2 or
      179       when 3 or
      180       when 4
      181       then do:
      182         return 3 .
      183       end.
      184       otherwise do:
      185         return 1 .
      186       end.
      187     end case .
      188   end.
      189   procedure cur-time-mjd-to-date :
      190      define input  parameter i-mjd-diff as decimal no-undo.
      191      define output parameter o-Date     as date    no-undo.
      192      define output parameter o-Time     as integer no-undo.
      193      define variable v-day-number as integer   no-undo .
      194      if    i-mjd-diff < 0
      195         or i-mjd-diff = ?
      196      then do:
      197         return "?" .
      198      end.
      199      assign
      200         v-day-number = truncate(i-mjd-diff,0).
      201         o-Date = date(v-day-number + 2400002).
      202         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204   end.
      205   function cur-time-mjd-to-string returns character
      206   (input p-mjd-diff as decimal
      207   )
      208   :
      209     define variable v-day-number as integer   no-undo .
      210     define variable v-seconds    as integer   no-undo .
      211     define variable v-hour       as integer   no-undo .
      212     define variable v-min        as integer   no-undo .
      213     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      214     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      215     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      216     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      217     if p-mjd-diff < 0
      218     or p-mjd-diff = ?
      219     then do:
      220       return "?" .
      221     end.
      222     assign
      223       v-day-number = integer(truncate(p-mjd-diff,0))
      224       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226     if v-seconds > 86400
      227     then do:
      228       assign
      229         v-seconds = 86400 - 1
      230       .
      231     end.
      232     if v-seconds < 0
      233     then do:
      234       assign
      235         v-seconds = 0
      236       .
      237     end.
      238     assign
      239       v-hour = truncate(v-seconds / 3600, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 3600
      243     .
      244     assign
      245       v-min = truncate(v-seconds / 60, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 60
      249     .
      250     return
      251         (if v-day-number <> 0
      252           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0
      256           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      260           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      261           else ""
      262         )
      263       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      264       .
      265   end.
      266   function cur-time-string returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      275   end.
      276   function cur-time-string-sec returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      285   end.
      286   function cur-time-custom  returns character
      287   (input p-prefix as character
      288   ,input p-date-format as character
      289   ,input p-delimiter as character
      290   ,input p-time-format as character
      291   ,input p-suffix as character
      292   )
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return
      301       p-prefix
      302       + string(v-date, p-date-format)
      303       + p-delimiter
      304       + string(v-time, p-time-format)
      305       + p-suffix
      306       .
      307   end.
      308   function cur-time-print  returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      317   end.
      318   function cur-time-datetime returns datetime
      319   :
      320     define variable v-char as character no-undo .
      321     define variable v-datetime as datetime no-undo .
      322     v-char = cur-time-string().
      323     v-datetime = datetime(v-char).
      324     return  v-datetime.
      325   end.
      326   function cur-time-string-msec returns character
      327   :
      328     define variable v-date as datetime  no-undo .
      329     v-date = now.
      330     return string(v-date) .
      331   end.
      332   define variable vss-include-info2 as character format "X(65)" no-undo
      333   initial "@(#)$Workfile$ $Revision$".
      334   procedure xmlchar-test :
      335   define input parameter p-in-string          as character        no-undo.
      336   define output parameter p-out-string-enc    as character        no-undo.
      337   define output parameter p-out-string-dec    as character        no-undo.
      338   do
      339   on error undo, return error
      340   :
      341          run xmlchar-encode in this-procedure
      342       (
      343             input p-in-string
      344           , output p-out-string-enc
      345       ).
      346          run xmlchar-decode in this-procedure
      347       (
      348             input p-out-string-enc
      349           , output p-out-string-dec
      350       ).
      351   end.
      352   end .
      353   procedure xmlchar-encode :
      354   define input parameter p-in-string      as character        no-undo.
      355   define output parameter p-out-string    as character        no-undo.
      356       define variable v-position      as integer      no-undo.
      357       define variable v-current-char  as character    no-undo.
      358   do
      359   on error undo, return error
      360   :
      361       assign
      362           p-out-string = "":U
      363       .
      364       case p-in-string
      365       :
      366           when ?
      367           then do:
      368               assign
      369                   p-out-string = "?":U
      370               .
      371           end.
      372           when "?":U
      373           then do:
      374               assign
      375                   p-out-string = "&#63;":U
      376               .
      377           end.
      378           otherwise do:
      379               do v-position = 1 to length( p-in-string )
      380               :
      381                   assign
      382                       v-current-char = substring( p-in-string, v-position, 1 )
      383                   .
      384                   case v-current-char
      385                   :
      386                       when "&":U
      387                       then do:
      388                           assign
      389                               p-out-string = p-out-string + "&amp;":U
      390                           .
      391                       end.
      392                       when ">":U
      393                       then do:
      394                           assign
      395                               p-out-string = p-out-string + "&gt;":U
      396                           .
      397                       end.
      398                       when "<":U
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "&lt;":U
      402                           .
      403                       end.
      404                       when "'":U
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "&apos;":U
      408                           .
      409                       end.
      410                       when '"':U
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "&quot;":U
      414                           .
      415                       end.
      416                       when chr(1)
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "":U
      420                           .
      421                       end.
      422                       when chr(2)
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "":U
      426                           .
      427                       end.
      428                       when chr(3)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(4)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(5)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(6)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "":U
      450                           .
      451                       end.
      452                       when chr(7)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "":U
      456                           .
      457                       end.
      458                       when chr(8)
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "":U
      462                           .
      463                       end.
      464                       when chr(9)
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "":U
      468                           .
      469                       end.
      470                       when chr(29)
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "":U
      474                           .
      475                       end.
      476                       when chr(10)
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "&#10;":U
      480                           .
      481                       end.
      482                       when chr(13)
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "&#13;":U
      486                           .
      487                       end.
      488                       otherwise do:
      489                           assign
      490                               p-out-string = p-out-string + v-current-char
      491                           .
      492                       end.
      493                   end case.
      494               end.
      495           end.
      496       end case.
      497   end.
      498   end .
      499   procedure xmlchar-encode-1c :
