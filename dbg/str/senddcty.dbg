     1282   procedure xml-cd-write-header:
     1283   do
     1284   on error undo, return error
     1285   :
     1286   define input parameter p-xml-file-name       as character    no-undo.
     1287   define input parameter p-xml-file-name-path  as character    no-undo.
     1288   define input parameter p-doc-name            as character    no-undo.
     1289   define input parameter p-version             as character    no-undo.
     1290   define input parameter p-obj-list            as character    no-undo.
     1291   define input parameter p-correspondent       as character    no-undo .
     1292   define input parameter p-write-header        as logical      no-undo .
     1293   define variable OS-time as character no-undo .
     1294   define variable id as character no-undo .
     1295   define buffer buf_db for ub.db.
     1296   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1297   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1298   assign
     1299   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1300   .
     1301   run bgelib-tag-open in this-procedure (
     1302                                        1
     1303                                       ,p-doc-name
     1304                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1305                                         ).
     1306   if p-write-header then do:
     1307     run bgelib-tag-open(2, "Header","").
     1308     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1309     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1310     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1311     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1312     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1313     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1314     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1315     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1316     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1317     run bgelib-tag-close( 2, "Header" ).
     1318   end.
     1319   output stream stmXMLOut close.
     1320   end.
     1321   end procedure.
     1322   procedure xml-cd-write-footer:
     1323   do
     1324   on error undo, return error
     1325   :
     1326   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1327   define input parameter p-xml-file-name as character    no-undo.
     1328   define input parameter p-doc-name      as character    no-undo .
     1329   define variable v-error-num     as integer           no-undo.
     1330   define variable v-md5-signature as character no-undo .
     1331   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1332   run bgelib-tag-close( 0, p-doc-name ).
     1333   put stream stmXMLOut unformatted skip.
     1334   output stream stmXMLOut close.
     1335   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1336   if v-error-num > 0
     1337   then do:
     1338      return error.
     1339   end.
     1340   if opsys = "unix"
     1341   then do:
     1342       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1343   end.
     1344   end.
     1345   end procedure.
     1346   procedure xml-cd-filename :
     1347   do
     1348   on error undo, return error
     1349   :
     1350   define input parameter  p-out               as character no-undo .
     1351   define output parameter p-xml-file-name     as character    no-undo.
     1352   define output parameter p-xml-file-name-path   as character    no-undo.
     1353   define output parameter p-log-file-name     as character    no-undo.
     1354   define output parameter p-locked            as logical      no-undo.
     1355   define variable v-out as character     no-undo.
     1356   define variable loc#log as logical no-undo .
     1357   define variable BadFlag as logical no-undo .
     1358   define variable fq as integer no-undo .
     1359   define variable v-remote as character no-undo .
     1360   assign
     1361   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1362   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1363   p-log-file-name = p-out + "actions.log"
     1364   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1365   .
     1366   end.
     1367   end procedure.
     1368   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1369   define variable v-date-str as character no-undo .
     1370   assign
     1371   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1372                string(Month(p-date), "99":U) + "-":U +
     1373                string(DAY(p-date), "99":U).
     1374   return v-date-str.
     1375   END FUNCTION.
     1376   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1377   define variable v-date-str as character no-undo .
     1378   assign
     1379   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1380                string(Month(p-date), "99":U) + "-":U +
     1381                string(DAY(p-date), "99":U) + chr(32) +
     1382                string(p-time, "HH:MM:SS").
     1383   return v-date-str.
     1384   END FUNCTION.
     1385   function string-to-date returns date ( input p-string  as character):
     1386     define variable v-date as date no-undo .
     1387     assign
     1388     v-date = date(integer(substring(p-string, 4, 2))
     1389                   ,integer(substring(p-string, 1, 2))
     1390                   ,integer(substring(p-string, 7, 4))
     1391                  ) no-error .
     1392     if error-status:error then return ?.
     1393     return v-date.
     1394   END FUNCTION.
     1395   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1396   define variable v-time as integer no-undo init ?.
     1397   define variable v-dop1 as character no-undo .
     1398   define variable v-dop2 as character no-undo .
     1399   assign
     1400   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1401   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1402   no-error .
     1403   if error-status:error then return ?.
     1404   assign
     1405   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1406             integer(entry(2, v-dop2, ";":U)) * 60 +
     1407             integer(entry(3, v-dop2, ";":U)) no-error .
     1408   return v-time.
     1409   END FUNCTION.
