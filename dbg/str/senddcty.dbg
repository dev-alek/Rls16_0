     5243   error-status:error = false.
     5244   cash-cli.crf = cr + 1.
     5245   cr = cr + 1.
     5246   if ub.clients.obj-type = 'орг':U then do:
     5247     FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code .
