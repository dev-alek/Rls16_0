     3775   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3776   define variable v-sum-id-c as character no-undo .
     3777   define variable v-sum-id as character no-undo .
     3778   define variable iid as integer no-undo .
     3779   define variable v-num-entries as integer no-undo .
     3780   define variable v-ii as integer no-undo .
     3781   define variable v-sum-id-value as character no-undo .
     3782   define variable v-sum-id-output as logical no-undo .
     3783   define variable  v-property-value-chr as character no-undo .
     3784   define variable v-d-pcnt as decimal no-undo .
     3785   define variable v-cash-d-pcnt as decimal no-undo .
     3786   define variable v-categ as integer no-undo .
     3787   define variable v-d-pcnt0 as decimal no-undo .
     3788   define variable v-cash-d-pcnt0 as decimal no-undo .
     3789   define variable v-categ0 as integer no-undo .
