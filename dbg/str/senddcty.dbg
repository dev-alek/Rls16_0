     5395         cash-cli.cli-name2 = ub.person.name1
     5396         cash-cli.cli-name3 = ub.person.name2
     5397         cash-cli.given-by = ub.person.given-by
     5398         cash-cli.passport = ub.person.passp-ser + chr(4) + ub.person.passp-num
     5399         .
     5400       end.
     5401       .
     5402     end.
     5403   END CASE.
     5404   assign
     5405   cash-cli.cli-name = replace(cash-cli.cli-name, chr(34), "":U)
     5406   cash-cli.cli-city = replace(cash-cli.cli-city, chr(34), "":U)
     5407   cash-cli.cli-adr = replace(cash-cli.cli-adr, chr(34), "":U)
     5408   .
     5409   for each buf_dis-card-property no-lock where
     5410             buf_dis-card-property.dtm-code = 18
