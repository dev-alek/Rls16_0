     3822   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     3823   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     3824   procedure create-dis-rule :
     3825   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     3826   define input parameter p-tree as logical no-undo .
     3827   define buffer buf_dis-rule for ub.dis-rule.
     3828   define buffer buf_dis-time-rule for ub.dis-time-rule.
     3829   define buffer term_dis-rule for ub.dis-rule.
     3830   define buffer term_dis-time-rule for ub.dis-time-rule.
     3831   define buffer root_cash-dis-rule for cash-dis-rule.
     3832   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     3833   define buffer term_cash-dis-rule for cash-dis-rule.
     3834   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     3835     do
     3836     on error undo, return error
     3837     :
     3838       find first root_cash-dis-rule no-lock where                                                         ~
     3839                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     3840       if not available root_cash-dis-rule then do:
     3841         find first buf_dis-rule no-lock where
     3842                   buf_dis-rule.rule-num = p-rule-num no-error.
     3843         if available buf_dis-rule then do:
     3844           if buf_dis-rule.time-rule-num <> 0 then do:
     3845             find first buf_dis-time-rule no-lock where
     3846                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     3847           end.
     3848           create root_cash-dis-rule.
     3849           buffer-copy buf_dis-rule to root_cash-dis-rule.
     3850           if available buf_dis-time-rule then do:
     3851             find first root_cash-dis-time-rule no-lock where
     3852                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     3853             if not available root_cash-dis-time-rule then do:
     3854               create root_cash-dis-time-rule.
     3855               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     3856             end.
     3857           end.
     3858           else do:
     3859             assign
     3860             root_cash-dis-rule.time-rule-num = 0.
     3861           end.
     3862           if buf_dis-rule.uniq-field <> "":U then do:
     3863             for each term_dis-rule no-lock where
     3864                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     3865               if term_dis-rule.time-rule-num <> 0 then do:
     3866                 find first term_dis-time-rule no-lock where
     3867                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     3868               end.
     3869               create term_cash-dis-rule.
     3870               buffer-copy term_dis-rule to term_cash-dis-rule.
     3871               if term_dis-rule.time-rule-num = 0
     3872               or available term_dis-time-rule
     3873               or root_cash-dis-rule.time-rule-num = 0
     3874               then do:
     3875                 if available term_dis-time-rule then do:
     3876                   find first term_cash-dis-time-rule no-lock where
     3877                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     3878                   if not available term_cash-dis-time-rule then do:
     3879                     create term_cash-dis-time-rule.
     3880                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     3881                   end.
     3882                 end.
     3883               end.
     3884             end.
     3885           end.
     3886         end.
     3887       end.
     3888     end.
     3889   end procedure.
