     5353          and buf_Dis-card-property.dtm-code = integer(25)
     5354          and buf_Dis-card-property.node-code = integer(3)
     5355          and buf_Dis-card-property.host-code = 0
     5356          and buf_Dis-card-property.obj-type = ''
