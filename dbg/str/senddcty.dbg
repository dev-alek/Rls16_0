     3891   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3892   FUNCTION get-dpcn RETURNS CHARACTER (
     3893        input p-d-card as character
     3894       ,input p-emitent-host-code as integer
     3895       ,input p-type as character
     3896       ,input parhost-code as integer
     3897       ,input parobj-type as character
     3898       ,input parobj-code as integer
     3899       ,input p-node-code as integer
     3900       ,input p-d-pcnt as decimal
     3901       ,input p-cash-d-pcnt as decimal
     3902       ,input p-category as integer
     3903       ) :
     3904   define buffer buf_dis-card-type for ub.dis-card-type.
     3905   define variable loc-d-v as decimal no-undo init ?.
     3906   define variable v-discnt-role as character no-undo .
     3907   define buffer buf_dis-card-property for ub.dis-card-property.
     3908   find first buf_dis-card-type no-lock where
     3909             buf_dis-card-type.type = p-type
     3910         and buf_dis-card-type.emitent-host-code = p-emitent-host-code
     3911         and buf_dis-card-type.host-code = 0
     3912         and buf_dis-card-type.obj-type = '':U
     3913         and buf_dis-card-type.obj-code = 0 no-error.
     3914   if available buf_dis-card-type then do:
     3915     case p-node-code:
     3916       when 1 then do:
     3917         assign
     3918         v-discnt-role = 'def-pcnt':U .
     3919       end.
     3920       when 2 then do:
     3921         assign
     3922         v-discnt-role = 'def-cash-pcnt':U.
     3923       end.
     3924       when 3 then do:
     3925         assign
     3926         v-discnt-role = 'def-categ':U.
     3927       end.
     3928     end case.
     3929     if buf_dis-card-type.d-pcnt-byshop then do:
     3930      find first buf_dis-card-property no-lock where
     3931                buf_dis-card-property.d-card = p-d-card
     3932            and buf_dis-card-property.dtm-code = 26
     3933            and buf_dis-card-property.host-code = parhost-code
     3934            and buf_dis-card-property.obj-type = parobj-type
     3935            and buf_dis-card-property.obj-code = parobj-code
     3936            and buf_dis-card-property.node-code = p-node-code no-error.
     3937      if available buf_dis-card-property then do:
     3938        if v-discnt-role = 'def-categ':U then do:
     3939          assign
     3940          loc-d-v = buf_dis-card-property.property-value-integer.
     3941        end.
     3942        else do:
     3943          assign
     3944          loc-d-v = buf_dis-card-property.property-value-decimal.
     3945        end.
     3946      end.
     3947      if loc-d-v = ? then do:
     3948   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
