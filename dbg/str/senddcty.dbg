     2216   FIELD mask-card         like ub.dis-card.mask-card
     2217   FIELD valid-date        as date initial 12/31/9999
     2218   FIELD property-value-chr as character extent 4
     2219   field dcr-pcnt            as integer
     2220   field dcr-abs             as integer
     2221   field dcr-pcnt-qnty       as integer
     2222   field dcr-pcnt-tot        as integer
