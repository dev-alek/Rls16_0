     3980   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     3982     (
     3983      input  p-type
     3984     ,input  p-emitent-host-code
     3985     ,input  parhost-code
     3986     ,input  ''
     3987     ,input  0
     3988     ,input  v-discnt-role
     3989     ,output loc-d-v
     3990     ) no-error .
     3991       end.
     3992       if loc-d-v = ? then do:
     3993         case v-discnt-role:
     3994           when 'def-categ':U then do:
     3995             loc-d-v = p-category.
     3996           end.
     3997           when 'def-pcnt':U then do:
     3998             loc-d-v = p-d-pcnt.
     3999           end.
     4000           when 'def-cash-pcnt':U then do:
     4001             loc-d-v = p-cash-d-pcnt.
     4002           end.
     4003         end case.
     4004       end.
     4005       if v-discnt-role = 'def-categ':U then do:
     4006         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     4007       end.
     4008       else do:
     4009         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     4010       end.
     4011     end.
     4012   end.
     4013   else do:
     4014    return "ОШИБКА-НЕТ ТИПА".
     4015   end.
     4016   case v-discnt-role:
     4017     when 'def-categ':U then do:
     4018        loc-d-v = p-category.
     4019        return string(loc-d-v, ">>>9").
     4020     end.
     4021     when 'def-pcnt':U then do:
     4022       loc-d-v = p-d-pcnt.
     4023       return string(loc-d-v, "->9.99%").
     4024     end.
     4025     when 'def-cash-pcnt':U then do:
     4026       loc-d-v = p-cash-d-pcnt.
     4027       return string(loc-d-v, "->9.99%").
     4028     end.
     4029   end case.
     4030   END FUNCTION.
