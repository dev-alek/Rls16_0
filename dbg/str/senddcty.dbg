     5412        AND  buf_dis-card-property.HOST-CODE = 0
     5413        AND  buf_dis-card-property.obj-type = '':U
     5414        AND  buf_dis-card-property.obj-code = 0
     5415     break
     5416     by buf_dis-card-property.dt-code:
     5417     if first-of(buf_dis-card-property.dt-code) then do:
     5418       v-gds-code = -1.
     5419       v-gds-code =  propreft-string-to-petrol(buf_dis-card-property.sum-id) no-error .
     5420       if not error-status:error
     5421       and v-gds-code <> 0 then do:
     5422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5423     (input  v-gds-code
