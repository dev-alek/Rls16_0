        1   block-level on error undo, throw.
        2   define input parameter d-num like ub.price-doc.doc-num.
        3   define variable vss-revision    as character no-undo init "$Revision: dd1d4e728915, 350, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        5   define variable vss-date        as character no-undo init "$Date: Thu Dec 17 17:50:27 2015 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: pr-tot.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/pr-tot.p $":U .
        8   define variable vss-description as character no-undo init "Расчет сумм по документу переоценки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure create-price-list-attr :
       79    do
       80    on error undo, return error return-value
       81    :
       82   define input parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
       83   define input parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
       84   define input parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
       85   define input parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
       86   define input parameter p-price-type   like ub.price-list-attr.price-type no-undo .
       87   define buffer buf_price-list-attr for ub.price-list-attr.
       88   find first buf_price-list-attr  exclusive-lock  where
       89     buf_price-list-attr.attr-code    = p-attr-code    and
       90     buf_price-list-attr.b-code       = p-b-code       and
       91     buf_price-list-attr.doc-num      = p-doc-num      and
       92     buf_price-list-attr.price-type   = p-price-type  no-error .
       93     if not available  buf_price-list-attr then do:
       94         create buf_price-list-attr.
       95         assign
       96           buf_price-list-attr.attr-code    = p-attr-code
       97           buf_price-list-attr.attr-value   = p-attr-value
       98           buf_price-list-attr.b-code       = p-b-code
       99           buf_price-list-attr.doc-num      = p-doc-num
      100           buf_price-list-attr.price-type   = p-price-type
      101         .
      102     end.
      103     else do:
      104           buf_price-list-attr.attr-value   = p-attr-value .
      105     end.
      106    end.
      107   end procedure.
      108   procedure view-price-list-attr :
      109    do
      110    on error undo, return error return-value
      111    :
      112   define input  parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
      113   define input  parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
      114   define input  parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
      115   define input  parameter p-price-type   like ub.price-list-attr.price-type no-undo .
      116   define output parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
      117   define buffer buf_price-list-attr for ub.price-list-attr.
      118   find first buf_price-list-attr no-lock where
      119     buf_price-list-attr.attr-code    = p-attr-code    and
      120     buf_price-list-attr.b-code       = p-b-code       and
      121     buf_price-list-attr.doc-num      = p-doc-num      and
      122     buf_price-list-attr.price-type   = p-price-type  no-error .
      123     if available  buf_price-list-attr then do:
      124         assign
      125           p-attr-value = buf_price-list-attr.attr-value
      126         .
      127     end.
      128     else do:
      129           p-attr-value = ? .
      130     end.
      131    end.
      132   end procedure.
      133   procedure pdoc-forming-attr :
      134   define input  parameter p-plt-id       as integer   no-undo .
      135   define input  parameter p-plt-db-num   as integer   no-undo .
      136   define input  parameter p-pdf-id       as integer   no-undo .
      137   define input  parameter p-pdf-db       as integer   no-undo .
      138   define input  parameter p-attr-code    as character no-undo .
      139   define input  parameter p-val          as character no-undo .
      140     do
      141     on error undo, return error return-value
      142     :
      143     find first  ub.price-doc-forming-attr exclusive-lock where
      144                 ub.price-doc-forming-attr.plt-id       = p-plt-id       and
      145                 ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
      146                 ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
      147                 ub.price-doc-forming-attr.pdf-db       = p-pdf-db       and
      148                 ub.price-doc-forming-attr.attr-code    = p-attr-code
      149                 no-error .
      150       if not available  ub.price-doc-forming-attr then create ub.price-doc-forming-attr.
      151       assign
      152         ub.price-doc-forming-attr.plt-id       = p-plt-id
      153         ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num
      154         ub.price-doc-forming-attr.pdf-id       = p-pdf-id
      155         ub.price-doc-forming-attr.pdf-db       = p-pdf-db
      156         ub.price-doc-forming-attr.attr-code    = p-attr-code
      157         ub.price-doc-forming-attr.attr-value   = p-val
      158       .
      159     end.
      160   end procedure.
      161   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   define variable v-waitfram-action01         as character   no-undo .
      163   define variable v-waitfram-action02         as character   no-undo .
      164   define variable v-waitfram-action03         as character   no-undo .
      165   define variable mWaitFramTextBeg            as character   no-undo.
      166   define variable mWaitFramTextEnd            as character   no-undo.
      167   define variable mWaitFramView               as logical     no-undo.
      168   define variable mWaitProcEvent              as logical     no-undo init yes.
      169   define variable mWaitFramInterval           as integer     no-undo init 1 .
      170   define variable mWaitFramStop               as logical     no-undo.
      171   define variable mWaitFramStopUser           as logical     no-undo.
      172   define variable mWaitFramStopTimeOut        as logical     no-undo.
      173   define variable mWaitFramStartProc          as datetime-tz no-undo.
      174   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      175   define button B-WaitFramStop auto-end-key
      176        label "Стоп"
      177        size 10 by 1 tooltip "Остоновить процесс".
      178   define button B-viewProcInfo
      179        label "Информация"
      180        size 15 by 1 tooltip "Информация о процесс".
      181   define frame waitfram
      182     v-waitfram-action01 format "x(72)" no-label skip
      183     v-waitfram-action02 format "x(72)" no-label skip
      184     v-waitfram-action03 format "x(72)" no-label skip
      185     B-viewProcInfo
      186     B-WaitFramStop at row 4 col 30
      187     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      188     .
      189   define new global shared variable mBatchMode as logical no-undo init ?.
      190   define variable mFramBachModHandle as handle no-undo.
      191   mFramBachModHandle = frame waitfram:handle.
      192   define variable mFameOldVis as logical no-undo.
      193   define variable mVisCUrentVin as logical no-undo.
      194   if session:batch-mode
      195   then
      196      mBatchMode = yes.
      197   if mBatchMode = ? then do:
      198     mVisCUrentVin = current-window:visible.
      199     mFameOldVis = mFramBachModHandle:visible.
      200     mFramBachModHandle:visible  = yes.
      201     mBatchMode = mFramBachModHandle:visible ne yes.
      202     mFramBachModHandle:visible = mFameOldVis.
      203     current-window:visible = mVisCUrentVin.
      204   end.
      205    if  log-manager:logfile-name ne ?
      206     then DO:
      207         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      208         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      209         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      210     end.
      211   on choose of B-WaitFramStop in frame waitfram
      212   do:
      213     mWaitFramStop = yes.
      214     mWaitFramStopUser = yes.
      215   end.
      216   function waitfram-check-timeout returns logical():
      217      define variable vtime as int64 no-undo.
      218      if mWaitFramStopTimeOut
      219      then
      220         return yes.
      221      vtime = ( now - mWaitFramStartProc ) / 1000 .
      222      if     mWaitFramTimeOut ne ?
      223         and mWaitFramTimeOut ne 0
      224         and mWaitFramTimeOut lt vtime
      225      then do:
      226         mWaitFramStopTimeOut = yes.
      227      end.
      228      return mWaitFramStopTimeOut.
      229   end.
      230   procedure waitfram-hide :
      231     if not session:batch-mode
      232     then do
      233     on error undo, return error return-value
      234     :
      235       pause 0 before-hide .
      236       if not mBatchMode then
      237         hide frame waitfram .
      238     if     not mWaitFramView
      239        and mWaitProcEvent
      240     then
      241       process events .
      242     end.
      243   end procedure.
      244   procedure waitfram-show :
      245     define input  parameter p-message as character no-undo .
      246     define variable v-left-margin as integer   no-undo .
      247     if not session:batch-mode
      248     then do
      249     on error undo, return error return-value
      250     :
      251       if length(p-message) <= 70 then do:
      252         assign
      253           v-left-margin = integer((70 - length(p-message)) / 2)
      254         .
      255         assign
      256           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      257         .
      258         assign
      259           v-waitfram-action01 = " "
      260           v-waitfram-action02 = " "
      261                                    + fill(" ", v-left-margin)
      262                                    + p-message
      263           v-waitfram-action03 = " "
      264         .
      265       end.
      266       else do:
      267         define variable vRindex1 as integer no-undo.
      268         define variable vRindex2 as integer no-undo.
      269         vRindex1 = r-index(p-message," ",70).
      270         if vRindex1 = 0
      271         then
      272            vRindex1 = 70.
      273         if length(p-message)  <= vRindex1 + 70 then do:
      274           assign
      275             v-waitfram-action01 = " "
      276             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      277             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      278           .
      279         end.
      280         else do:
      281           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      282           if vRindex2 <= vRindex1
      283           then
      284              vRindex2 = vRindex1 + 70.
      285           assign
      286             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      287             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      288             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      289           .
      290         end.
      291       end.
      292       B-viewProcInfo:visible   in frame waitfram = no.
      293       B-viewProcInfo:sensitive in frame waitfram = no.
      294       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      295       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      296       if  (   mWaitFramView
      297          or  mWaitProcEvent)
      298          and not mBatchMode
      299       then
      300          display
      301             v-waitfram-action01 skip
      302             v-waitfram-action02 skip
      303             v-waitfram-action03 skip
      304          with frame waitfram .
      305       if     mWaitFramView
      306          then do:
      307             if     mWaitFramInterval ne ?
      308                and not mBatchMode
      309             then
      310                wait-for go of frame waitfram pause mWaitFramInterval.
      311          end.
      312          else
      313             if     mWaitProcEvent
      314                and not mBatchMode
      315             then
      316                process events .
      317     end.
      318   end procedure.
      319      procedure waitfram-show-this:
      320         define input  parameter iInterval as int64 no-undo.
      321         define variable vtime as int64 no-undo.
      322         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      323         mWaitFramInterval = iInterval.
      324         run waitfram-show (substitute("&1&2 &3&4" ,
      325                                       mWaitFramTextBeg ,
      326                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      327                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      328                                       mWaitFramTextEnd
      329                                      )
      330                           ).
      331      end.
      332      procedure WaitFramRunPause:
      333         define input  parameter iInterval as dec no-undo.
      334         define variable vStart  as datetime-tz no-undo.
      335         define variable vend    as datetime-tz no-undo.
      336         define variable vint as int64 no-undo.
      337         define variable vOk as logical no-undo.
      338         vStart = now.
      339         vend   = vStart.
      340         publish "WaitFramPause" (iInterval,output vOk).
      341         vend   =  now.
      342         vint = vend - vStart.
      343         vint = iInterval - vint / 1000.
      344         if     not mWaitFramStop
      345            and (   vint > 0
      346                 or (    not vOk
      347                     and iInterval eq ?
      348                     )
      349                 )
      350         then
      351            run waitfram-show-this (iInterval).
      352         vend   =  now.
      353         vint = vend - vStart.
      354         vint = iInterval - vint / 1000.
      355         if     not mWaitFramStop
      356            and vint > 0
      357         then do:
      358            run gbl/pause.p (vint * 1000).
      359         end.
      360         if iInterval ne ?
      361         then
      362            publish "WaitFramStop".
      363         waitfram-check-timeout().
      364      end.
      365      procedure WaitFramWaitFor:
      366         define input  parameter iInterval as dec no-undo.
      367         assign
      368            mWaitFramStartProc   = now
      369            mWaitFramStopUser    = no
      370            mWaitFramStopTimeOut = no
      371         .
      372         block-wait:
      373         do while not mWaitFramStop:
      374            run WaitFramRunPause (iInterval).
      375            if  waitfram-check-timeout()
      376            then do:
      377               leave block-wait.
      378            end.
      379         end.
      380         run waitfram-hide.
      381      end.
      382   procedure waitfram-join :
      383     define input  parameter p-line-1  as character no-undo .
      384     define input  parameter p-line-2  as character no-undo .
      385     define input  parameter p-line-3  as character no-undo .
      386     define output parameter p-message as character no-undo .
      387     do
      388     on error undo, return error return-value
      389     :
      390       assign
      391         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      392                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      393                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      394       .
      395     end.
      396   end procedure.
      397   function waitfram-join-function returns character
      398     (input p-line-1 as character
      399     ,input p-line-2 as character
      400     ,input p-line-3 as character
      401     ).
      402     define variable v-message as character no-undo .
      403     run waitfram-join in this-procedure
      404       (input  p-line-1
      405       ,input  p-line-2
      406       ,input  p-line-3
      407       ,output v-message
      408       ) .
      409     return v-message .
      410   end function .
      411   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   define new global shared variable g#attr-lib  as handle no-undo .
      413   define variable v-attr-lib-variable as handle no-undo .
