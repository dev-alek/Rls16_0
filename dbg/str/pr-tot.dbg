     1289   define variable v-price-sale                   as decimal no-undo .
     1290   define variable v-rest-sale                    as decimal no-undo .
     1291   define variable par-is-pharm         as character no-undo .
     1292   define variable par-type             as character no-undo .
     1293   define variable v-gds-null-price     as character no-undo initial "" .
     1294     v-price-list-total       = 0.
     1295     find ub.price-doc exclusive-lock where
     1296          ub.price-doc.doc-num = d-num.
     1297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1298     (input  'is-pharm'
     1299     ,input  0
     1300     ,input  ''
     1301     ,input  0
     1302     ,input  ''
     1303     ,input  ''
     1304     ,input  ''
     1305     ,input  no
     1306     ,output par-is-pharm
     1307     ,output par-type
     1308     ) no-error .
     1309     .
     1310   if par-is-pharm = "yes"  then do:
     1311   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$workfile: $ $revision: $".
     1312   define variable v-o-pharm    as character no-undo .
     1313   define variable v-o-var-type as character no-undo .
     1314     run clntattr-value in this-procedure
     1315       ( input   ub.price-doc.obj-type ,
     1316         input   ub.price-doc.obj-code ,
     1317         input  'pharm':U,
     1318         output v-o-pharm    ,
     1319         output v-o-var-type )
     1320        no-error .
     1321     if v-o-pharm <> "yes":u or error-status :error then do:
     1322        par-is-pharm = "no"  .
     1323     end.
     1324   end.
     1325   if par-is-pharm = "yes" then do:
     1326      run str/pr-totp.p ( input ub.price-doc.doc-num ) no-error.
     1327      return .
     1328   end.
     1329     run waitfram-show in this-procedure  ("Расчет строк по документу переоценки. Ждите ...").
     1330     chk-prices :
     1331     for each  Buf_price-list where
     1332               Buf_price-list.doc-num = d-num,
     1333         first Buf_bar-code no-lock where
     1334               Buf_bar-code.b-code = Buf_price-list.b-code,
     1335         first Buf_goods no-lock where
     1336               Buf_goods.gds-code = Buf_bar-code.gds-code
     1337         on error undo chk-prices, return error:
     1338       run gds-attr-value in this-procedure (input Buf_goods.gds-code
     1339                                            ,input 'null-price':U
     1340                                            ,output v-gds-null-price
     1341                                            ,output par-type ) no-error .
     1342       if Buf_price-list.price-sale < 0 or
     1343          Buf_price-list.price-sale = ? or
     1344          (Buf_price-list.price-sale = 0 and not logical(v-gds-null-price)) then do:
     1345         message
     1346           "Цена не должна быть меньше или равна 0, или равна ?." skip
     1347           "Артикул: " Buf_goods.artic Buf_goods.gds-name
     1348           view-as alert-box error.
     1349         run waitfram-hide in this-procedure .
     1350         undo chk-prices, return error.
     1351       end.
     1352         run create-price-list-attr in this-procedure
     1353         ( "full-price-sale":U ,
     1354           Buf_price-list.price-sale    ,
     1355           Buf_price-list.b-code ,
     1356           Buf_price-list.doc-num ,
     1357           Buf_price-list.price-type  ).
     1358       if Buf_goods.unit-base = Buf_bar-code.unit-cli then
     1359         Buf_price-list.doc-qnty = 0.
     1360         v-price-list-total = v-price-list-total + 1.
     1361     end.
     1362     if ub.price-doc.status_ = 'новый':U and
     1363        substr ( ub.price-doc.PS, 1, 1 ) = "@" then
     1364       ub.price-doc.PS = "@  Строк в приказе: " + string ( v-price-list-total, ">>>>>9").
     1365     assign
     1366       v-price-list-total       = 0
     1367       v-avrg-r-b               = 0
     1368       v-last-r-b               = 0
     1369       v-doc-qnty               = 0
     1370       v-price-sale             = 0
     1371       v-rest-sale              = 0
     1372       .
     1373     run waitfram-show in this-procedure ("Расчет итогов по документу переоценки. Ждите ...") .
     1374     clc-tot :
     1375     for each  Buf_price-list where
     1376               Buf_price-list.doc-num = d-num and
     1377               Buf_price-list.main-price = yes,
     1378         first Buf_bar-code no-lock where
     1379               Buf_bar-code.b-code = Buf_price-list.b-code,
     1380         first Buf_gds-obj where
     1381               Buf_gds-obj.gds-code = Buf_bar-code.gds-code and
     1382               Buf_gds-obj.obj-type = Buf_price-list.obj-type and
     1383               Buf_gds-obj.obj-code = Buf_price-list.obj-code,
     1384         first Buf_goods no-lock where
     1385               Buf_goods.gds-code = Buf_bar-code.gds-code
     1386         on error undo clc-tot, return error
     1387         :
     1388           v-price-list-total = v-price-list-total + 1.
     1389           if v-price-list-total modulo 100 = 0 then
     1390             run waitfram-show in this-procedure ("Расчет итогов. Главных цен: " +
     1391                             string (v-price-list-total)).
     1392           Buf_price-list.doc-qnty = Buf_gds-obj.fact-qnty.
     1393           for each  sub-list where
     1394                     sub-list.doc-num    = d-num and
     1395                     sub-list.main-price = no and
     1396                     sub-list.artic      = Buf_price-list.artic and
     1397                     sub-list.prod-type  = Buf_price-list.prod-type and
     1398                     sub-list.prod-code  = Buf_price-list.prod-code,
     1399               each  sub-code no-lock where
     1400                     sub-code.b-code = sub-list.b-code,
     1401               each  Buf_prt-obj no-lock where
     1402                     Buf_prt-obj.artic     = Buf_price-list.artic and
     1403                     Buf_prt-obj.prod-type = Buf_price-list.prod-type and
     1404                     Buf_prt-obj.prod-code = Buf_price-list.prod-code and
     1405                     Buf_prt-obj.prt-code  = sub-code.node-code and
     1406                     Buf_prt-obj.obj-type  = Buf_price-list.obj-type and
     1407                     Buf_prt-obj.obj-code  = Buf_price-list.obj-code
     1408           on error undo clc-tot, return error
     1409           on stop undo clc-tot, return error:
     1410             if sub-code.unit-cli <> Buf_goods.unit-base then
     1411               next.
     1412             assign
     1413               sub-list.doc-qnty = Buf_prt-obj.fact-qnty
     1414               Buf_price-list.doc-qnty = Buf_price-list.doc-qnty - sub-list.doc-qnty
     1415               v-price-sale = v-price-sale
     1416                           + ( sub-list.price-sale - Buf_prt-obj.price-sale) * sub-list.doc-qnty
     1417               .
     1418           end.
     1419       assign
     1420         v-avrg-r-b   = v-avrg-r-b
     1421                      +  ( if var-pr-r-b = "rubl" then Buf_gds-obj.fact-rubl else Buf_gds-obj.fact-base )
     1422         v-doc-qnty   = v-doc-qnty
     1423                      + Buf_gds-obj.fact-qnty
     1424         v-price-sale = v-price-sale
     1425                      + ( buf_price-list.price-sale - Buf_gds-obj.price-sale) * Buf_price-list.doc-qnty
     1426         v-rest-sale  = v-rest-sale
     1427                      + Buf_gds-obj.fact-sale
     1428         .
     1429       if Buf_goods.gds-type = 'т':U then
     1430          if var-pr-r-b = "rubl" then
     1431              v-last-r-b   = v-last-r-b
     1432                           + Buf_gds-obj.last-rubl * Buf_gds-obj.fact-qnty.
     1433             else
     1434              v-last-r-b   = v-last-r-b
     1435                           + Buf_gds-obj.last-base * Buf_gds-obj.fact-qnty.
     1436     end.
     1437     assign
     1438       ub.price-doc.rest-last     = v-last-r-b
     1439       ub.price-doc.rest-base     = v-avrg-r-b
     1440       ub.price-doc.rest-sale     = v-rest-sale
     1441       ub.price-doc.sale-base     = v-price-sale
     1442       ub.price-doc.rest-qnty     = v-doc-qnty
     1443       .
     1444     release ub.price-doc.
     1445     run waitfram-hide in this-procedure .
