        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-shift-on as logical no-undo .
        4   define input parameter p-chk-rec as recid no-undo .
        5   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
        6   define input parameter p-shift-num like ub.chk-doc.shift-num no-undo .
        7   define input parameter p-shift-name as character no-undo .
        8   define input parameter p-shift-reservoir-from as int no-undo.
        9   define input parameter p-shift-reservoir-to as int no-undo.
       10   define input parameter p-change-fields as character no-undo .
       11   define input parameter p-can-back-shift as logical no-undo .
       12   define output parameter p-added as logical no-undo .
       13   define output parameter p-changed as logical no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision: 6557e99634e7, 3192, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       16   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:28 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: chkshift.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: str/chkshift.p $":U .
       19   define variable vss-description as character no-undo init "Изменение даты и или номера смены для одного чека".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   DEFINE VARIABLE cas-shft as logical no-undo .
       81   DEFINE VARIABLE conf-attr as character no-undo .
       82   define variable v-is-update as logical no-undo .
       83   define variable v-chip-num like ub.c-chk-doc.chip-num no-undo .
       84   define variable v-shift-date as date no-undo.
       85   define variable v-shift-num as integer no-undo.
       86   define variable v-shift-name2 as character no-undo .
       87   define variable v-check-shift-date as date no-undo.
       88   define variable v-check-shift-num as integer no-undo.
       89   define variable v-check-shift-name as character no-undo .
       90   define buffer bf_chk-doc for ub.chk-doc .
       91   define buffer buf_shift-obj for ub.shift-obj.
       92   define buffer buf_chk-gds for ub.chk-gds.
       93   define buffer buf_place for ub.place.
       94   define buffer bf_chk-discnt for ub.chk-discnt.
       95   do
       96   on error undo, return error
       97   :
       98     find first bf_chk-doc where
       99                recid(bf_chk-doc) = p-chk-rec.
      100     if bf_chk-doc.out-code <> ? then return error.
      101     if bf_chk-doc.chk-type = 13 or bf_chk-doc.chk-type = 40 then return error .
      102     assign
      103     cas-shft = no.
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   define variable v-param-type0 as character no-undo .
      106   define variable v-value-character0 as character no-undo .
      107   define variable v-value-date0 as date no-undo .
      108   define variable v-value-decimal0 as decimal no-undo .
      109   define variable v-value-integer0 as INTEGER no-undo .
      110   define variable v-tth0 as handle no-undo .
      111   run adm/shattri.p (
      112       input "get":U
      113       ,input  bf_chk-doc.obj-type
      114       ,input  bf_chk-doc.obj-code
      115       ,input  'get-chk':U
      116       ,input  'cas-shft':U
      117       ,output v-value-character0
      118       ,output v-value-date0
      119       ,output v-value-decimal0
      120       ,output v-value-integer0
      121       ,output cas-shft
      122       ,output v-param-type0
      123       ,INPUT-OUTPUT table-handle v-tth0
      124       )  .
      125   delete object v-tth0.
      126     assign
      127     v-check-shift-date = (if lookup("shift-date":U, p-change-fields) > 0
      128                           then p-shift-date
      129                           else bf_chk-doc.shift-date)
      130     v-check-shift-num = (if lookup("shift-num":U, p-change-fields) > 0
      131                           then p-shift-num
      132                           else bf_chk-doc.shift-num
      133                           )
      134     v-check-shift-name = (if lookup("shift-name":U, p-change-fields) > 0
      135                           then p-shift-name
      136                           else bf_chk-doc.shift-name
      137                           )
      138    .
      139     CASE cas-shft:
      140       when yes then do:
      141         if v-check-shift-date = ? then return error.
      142         if p-shift-on then do:
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      145     (input  bf_chk-doc.obj-type
      146     ,input  bf_Chk-doc.obj-code
      147     ,output v-shift-date
      148     ,output v-shift-num
      149     ,output v-shift-name2
      150     ) no-error .
      151           if error-status:error then do:
      152             if p-can-back-shift = no then do:
      153               return error return-value .
      154             end.
      155           end.
      156           find first buf_shift-obj no-lock where
      157                     buf_shift-obj.obj-type = bf_chk-doc.obj-type
      158                 and  buf_shift-obj.obj-code = bf_chk-doc.obj-code
      159                 and  buf_shift-obj.shift-date = v-check-shift-date
      160                 and  buf_shift-obj.shift-num =  v-check-shift-num
      161                 and  buf_shift-obj.shift-name =  v-check-shift-name
      162                 no-error.
      163           if not available buf_shift-obj then return error substitute('Нет смены &1(&2) от &3 для &4&5'
      164                                                                       ,v-check-shift-name
      165                                                                       ,v-check-shift-num
      166                                                                       ,string(v-check-shift-date, "99/99/9999")
      167                                                                       ,bf_chk-doc.obj-type
      168                                                                       ,bf_chk-doc.obj-code).
      169           if v-check-shift-date <> v-shift-date
      170           or v-check-shift-num <> v-shift-num
      171           or integer(v-check-shift-name) <> integer(v-shift-name2)
      172           then do:
      173             if p-can-back-shift then do:
      174               if available buf_shift-obj
      175               and not (buf_shift-obj.status_ = 'тек':U
      176                     or buf_shift-obj.status_ = 'ожд':U
      177                     or buf_shift-obj.status_ = 'зкр':U)
      178                     then do:
      179                 if not available buf_shift-obj then return error substitute('Смена &1(&2) от &3 для &4&5&6" +
      180                                                                             "имеет статус &7'
      181                                                                             ,buf_shift-obj.shift-name
      182                                                                             ,buf_shift-obj.shift-num
      183                                                                             ,string(buf_shift-obj.shift-date, "99/99/9999")
      184                                                                             ,bf_chk-doc.obj-type
      185                                                                             ,bf_chk-doc.obj-code
      186                                                                             ,chr(10)
      187                                                                             ,buf_shift-obj.status_
      188                                                                             ).
      189               end.
      190             end.
      191             else do:
      192               if available buf_shift-obj
      193               and not (buf_shift-obj.status_ = 'тек':U
      194                     or buf_shift-obj.status_ = 'ожд':U) then do:
      195                 if not available buf_shift-obj then return error substitute('Смена &1(&2) от &3 для &4&5&6" +
      196                                                                             "имеет статус &7'
      197                                                                             ,buf_shift-obj.shift-name
      198                                                                             ,buf_shift-obj.shift-num
      199                                                                             ,string(buf_shift-obj.shift-date, "99/99/9999")
      200                                                                             ,bf_chk-doc.obj-type
      201                                                                             ,bf_chk-doc.obj-code
      202                                                                             ,chr(10)
      203                                                                             ,buf_shift-obj.status_
      204                                                                             ).
      205               end.
      206             end.
      207           end.
      208           if (bf_chk-doc.shift-date <> buf_shift-obj.shift-date
      209           or bf_chk-doc.shift-num <> buf_shift-obj.shift-num
      210           or integer(bf_chk-doc.shift-name) <> integer(buf_shift-obj.shift-name)
      211           ) then do:
      212             assign
      213             p-added = yes.
      214           end.
      215         end.
      216         else do:
      217           if v-check-shift-num = 0 then return error.
      218           if v-check-shift-date > bf_chk-doc.chk-date then return error.
      219           if integer(v-check-shift-name) = 0 then return error.
      220         end.
      221       end.
      222       when no then do:
      223         if v-check-shift-date > bf_chk-doc.chk-date then return error.
      224         if v-check-shift-num <> 0 then return error.
      225         if integer(v-check-shift-name) <> 0 then return error.
      226         if bf_chk-doc.shift-date <> v-shift-date
      227         then do:
      228           assign
      229           p-added = yes.
      230         end.
      231       end.
      232     END CASE.
      233     run trg/chk-doch.p (
      234                     buffer bf_chk-doc
      235                   , input no
      236                   , input no
      237                   , input no
      238                   , input-output v-chip-num
      239                   , output v-is-update).
      240     assign
      241     bf_chk-doc.shift-date = v-check-shift-date
      242     bf_chk-doc.shift-num = v-check-shift-num
      243     bf_chk-doc.shift-name = string(integer(v-check-shift-name))
      244     .
      245     if bf_chk-doc.shift-date    <> v-check-shift-date
      246       or bf_chk-doc.shift-num   <> v-check-shift-num
      247       or bf_chk-doc.shift-name  <> string(integer(v-check-shift-name)) then
      248           p-changed = true.
      249       for each bf_chk-discnt where bf_chk-discnt.doc-code = bf_chk-doc.doc-code:
      250       assign
      251         bf_chk-discnt.shift-date = v-check-shift-date
      252         bf_chk-discnt.shift-num = v-check-shift-num
      253         .
      254       release bf_chk-discnt.
      255       end.
      256     if lookup("shift-reservoir-to", p-change-fields) > 0 then
      257       do:
      258         for each buf_chk-gds
      259           where buf_chk-gds.doc-code = bf_chk-doc.doc-code
      260               and buf_chk-gds.pl-code = p-shift-reservoir-from
      261                   :
      262                       find first buf_place
      263                           where buf_place.pl-code = p-shift-reservoir-to
      264                           no-error.
      265                       if avail buf_place then do:
      266                           buf_chk-gds.pl-code = buf_place.pl-code.
      267                           buf_chk-gds.loc1    = buf_place.loc1.
      268                           p-changed = true.
      269                       end.
      270         end.
      271       end.
      272     if (bf_chk-doc.shift-date = v-shift-date
      273     and bf_chk-doc.shift-num = v-shift-num
      274     and bf_chk-doc.shift-name = v-shift-name2
      275         )
      276     or (p-shift-on
      277         and
      278         bf_chk-doc.shift-date = buf_shift-obj.shift-date
      279         and
      280         bf_chk-doc.shift-num = buf_shift-obj.shift-num
      281         and
      282         bf_chk-doc.shift-name = buf_shift-obj.shift-name)
      283     then do:
      284       assign
      285       bf_chk-doc.office = replace(bf_chk-doc.office, 'смн-ош':U, '':U)
      286       bf_chk-doc.office = replace(bf_chk-doc.office, (chr(44) + chr(44)), chr(44))
      287       bf_chk-doc.office = trim(bf_chk-doc.office, chr(44))
      288       bf_chk-doc.correct = (replace(replace(replace(bf_chk-doc.office, 'т':U, '':U), 'у':U, ''), chr(44), '') = '')
      289       .
      290     end.
      291     run trg/chk-doch.p (
      292                     buffer bf_chk-doc
      293                   , input yes
      294                   , input no
      295                   , input no
      296                   , input-output v-chip-num
      297                   , output v-is-update).
      298     bf_chk-doc.ps = if v-is-update
      299                     then (if index(bf_chk-doc.ps, "shift!") > 0
      300                           then bf_chk-doc.ps
      301                           else ("!shift!":U +  left-trim(bf_chk-doc.PS, "!":U))
      302                           )
      303                     else bf_chk-doc.ps.
      304   end.
