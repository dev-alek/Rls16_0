     2833           do:
     2834               assign
     2835                   f-boss-name = ?
     2836                   f-agnt-name = ?
     2837                   f-wrkr-name = ?
     2838                   f-obj-name  = ?
     2839                   f-cre-name  = ?
     2840                   .
     2841   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2842   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     2843     (input  r-doc.creid
     2844     ,output f-cre-name
     2845     )  .
     2846               find first buf_clients no-lock
     2847                   where buf_clients.obj-type = 'чел':U
     2848                   and buf_clients.obj-code = r-doc.boss
     2849                   no-error.
     2850               if available buf_clients then
     2851               do:
     2852                   assign
     2853                       f-boss-name = buf_clients.obj-name
     2854                       .
     2855               end.
     2856               find first buf_clients no-lock
     2857                   where buf_clients.obj-type = 'чел':U
     2858                   and buf_clients.obj-code = r-doc.agnt
     2859                   no-error.
     2860               if available buf_clients then
     2861               do:
     2862                   assign
     2863                       f-agnt-name = buf_clients.obj-name
     2864                       .
     2865               end.
     2866               find first buf_clients no-lock
     2867                   where buf_clients.obj-type = 'чел':U
     2868                   and buf_clients.obj-code = r-doc.wrkr
     2869                   no-error.
     2870               if available buf_clients then
     2871               do:
     2872                   assign
     2873                       f-wrkr-name = buf_clients.obj-name
     2874                       .
     2875               end.
     2876               find first buf_clients no-lock
     2877                   where buf_clients.obj-type = r-doc.obj-type
     2878                   and buf_clients.obj-code = r-doc.obj-code
     2879                   no-error.
     2880               if available buf_clients then
     2881               do:
     2882                   assign
     2883                       f-obj-name = buf_clients.obj-name
     2884                       .
     2885               end.
     2886               assign
     2887                   ed-notes = r-doc.ps
     2888                   .
