      643     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      644        v-cntxp-obj-code <> 0 then do:
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      646     (input  'is-prt'
      647     ,input  0
      648     ,input  ''
      649     ,input  0
      650     ,input  ''
      651     ,input  ''
      652     ,input  ''
      653     ,input  yes
      654     ,output v-cntxp-conf-par
      655     ,output v-cntxp-par-type
      656     ) no-error .
      657       case v-cntxp-obj-type :
      658         when 'скл':U then do:
      659           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      660           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      661           assign
      662             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      663             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      664             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      665             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      666             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      667             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      668             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      669             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      670             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      671             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      672             v-cntxp-load-time       = bf-cntxp_store.load-time
      673             v-cntxp-holidays        = bf-cntxp_store.holidays
      674             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      675             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      676             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      677             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      678             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      679             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      680             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      681             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      682             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      683             .
      684         end.
      685         when 'маг':U then do:
      686           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      687           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      688           assign
      689             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      690             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      691             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      692             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      693             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      694             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      695             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      696             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      697             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      698             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      699             v-cntxp-load-time       = bf-cntxp_shop.load-time
      700             v-cntxp-holidays        = bf-cntxp_shop.holidays
