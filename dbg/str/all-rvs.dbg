     2131           do:
     2132             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2133             is-mes = is-mes + "Не заполнена должность первого участника комиссии." + chr(10).
     2134           end.
     2135         end.
     2136         find first fio_inv-doc-attr no-lock where
     2137           fio_inv-doc-attr.doc-code = v-inv-doc and
     2138           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player2':U and
     2139           fio_inv-doc-attr.attr-value <> "" no-error .
     2140         if not available (fio_inv-doc-attr) then
