     2182           find first pos_inv-doc-attr no-lock where
     2183             pos_inv-doc-attr.doc-code = v-inv-doc and
     2184             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player3':U and
     2185             pos_inv-doc-attr.attr-value <> "" no-error .
     2186           if not available (pos_inv-doc-attr) then
     2187           do:
     2188             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2189             is-mes = is-mes + "Не заполнена должность третьего участника комиссии." + chr(10).
     2190           end.
     2191         end.
     2192         if is-mes <> "" then do:
     2193         message
     2194           is-mes
     2195           view-as alert-box .
     2196         undo tr, leave.
     2197         end.
     2198       end.
     2199               run str/trn-stat.p
     2200                   ( input parparentproc
     2201                   , input this-procedure
     2202                   , input '<закрытие документа>':U
     2203                   , input v-inv-doc
     2204                   , input ?
     2205                   , input v-cntxt-db-num
     2206                   , input ?
     2207                   , input ?
     2208                   , input ?
     2209                   , input ?
     2210                   , input yes
     2211                   , output varchg-inv
     2212                   , output table gds-list
     2213                   ) no-error.
