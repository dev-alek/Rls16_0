     2143             pos_inv-doc-attr.doc-code = v-inv-doc and
     2144             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player2':U and
     2145             pos_inv-doc-attr.attr-value <> "" no-error .
     2146           if available (pos_inv-doc-attr) then
     2147           do:
     2148             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2149             is-mes = is-mes + "Не заполнена ФИО второго участника комиссии." + chr(10).
     2150           end.
     2151         end.
     2152         else
     2153         do:
     2154           find first pos_inv-doc-attr no-lock where
     2155             pos_inv-doc-attr.doc-code = v-inv-doc and
     2156             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player2':U and
     2157             pos_inv-doc-attr.attr-value <> "" no-error .
     2158           if not available (pos_inv-doc-attr) then
     2159           do:
     2160             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2161             is-mes = is-mes + "Не заполнена должность второго участника комиссии." + chr(10).
     2162           end.
     2163         end.
     2164         find first fio_inv-doc-attr no-lock where
     2165           fio_inv-doc-attr.doc-code = v-inv-doc and
     2166           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player3':U and
     2167           fio_inv-doc-attr.attr-value <> "" no-error .
     2168         if not available (fio_inv-doc-attr) then
     2169         do:
     2170           find first pos_inv-doc-attr no-lock where
     2171             pos_inv-doc-attr.doc-code = v-inv-doc and
     2172             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player3':U and
     2173             pos_inv-doc-attr.attr-value <> "" no-error .
     2174           if available (pos_inv-doc-attr) then
     2175           do:
     2176             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2177             is-mes = is-mes + "Не заполнена ФИО третьего участника комиссии." + chr(10).
     2178           end.
     2179         end.
     2180         else
