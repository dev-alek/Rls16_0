     2126           find first pos_inv-doc-attr no-lock where
     2127             pos_inv-doc-attr.doc-code = v-inv-doc and
     2128             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U and
     2129             pos_inv-doc-attr.attr-value <> "" no-error .
