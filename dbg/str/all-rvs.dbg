     3866   procedure diasize_position-resize-button :
     3867     do with frame d-all-r-docs
     3868     :
     3869       hide v-diasize-resize-button .
     3870       assign
     3871         v-diasize-resize-button :row = frame d-all-r-docs :height - v-diasize-resize-button :height
     3872                     - 1
     3873                     - (frame d-all-r-docs :border-bottom-pixels / session :pixels-per-row)
     3874         v-diasize-resize-button :col = frame d-all-r-docs :width - v-diasize-resize-button :width
     3875                     - 1
     3876                     - (frame d-all-r-docs :border-right-pixels / session :pixels-per-column)
     3877       .
     3878       view v-diasize-resize-button .
     3879     end.
     3880   end procedure.
     3881   on alt-right anywhere
     3882   do:
     3883     run diasize_change-width in this-procedure
     3884       (input 1
     3885       ,input true
     3886       ) .
     3887     return no-apply .
     3888   end.
     3889   on alt-left anywhere
