     2977   end.
     2978   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2979   procedure minbtn-set :
     2980       do
     2981           on error undo, return error return-value
     2982           :
     2983           define variable ii              as integer       no-undo .
     2984           define variable fh              as widget-handle no-undo .
     2985           define variable hh              as widget-handle no-undo .
     2986           define variable v-h             as handle        extent 4 no-undo .
     2987           define variable v-name-button   as character     no-undo .
     2988           define variable v-help-old-x    as decimal       no-undo .
     2989           define variable v-help-old-y    as decimal       no-undo .
     2990           define variable v-help-old-size as decimal       no-undo .
     2991           define variable v-frame-width   as decimal       no-undo .
     2992           define variable jj              as integer       no-undo .
     2993           do
     2994               on error undo, return error
     2995               :
     2996               assign
     2997                   v-frame-width = frame d-all-r-docs:width - 0.3
     2998                   fh            = frame d-all-r-docs:first-child
     2999                   hh            = fh:first-child
     3000                   ii            = 1
     3001                   .
     3002               do while valid-handle(hh):
     3003                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3004                   do:
     3005                       case lc(hh:name) :
     3006                           when "b-help" then
     3007                               do:
     3008                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3009                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3010                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3011                                   hh:TOOLTIP = "Помощь" .
     3012                                   v-help-old-x = hh:column .
     3013                                   v-help-old-y = hh:row    .
     3014                                   v-help-old-size = hh:width .
     3015                                   hh:width-chars = 2.5 .
     3016                               end.
     3017                           when "b-print" then
     3018                               do:
     3019                                   hh:load-image("cmp/b-print.bmp":u) .
     3020                                   hh:TOOLTIP = "Печать" .
     3021                                   v-h[ii] = hh:handle .
     3022                                   ii = ii + 1 .
     3023                                   hh:width-chars = 3 .
     3024                               end.
     3025                           when "b-history" or
     3026                           when "b-hist" then
     3027                               do:
     3028                                   hh:load-image("cmp/b-hist.bmp":u) .
     3029                                   hh:TOOLTIP = "История" .
     3030                                   v-h[ii] = hh:handle .
     3031                                   ii = ii + 1 .
     3032                                   hh:width-chars = 3 .
     3033                               end.
     3034                           when "b-sch" then
     3035                               do:
     3036                                   hh:load-image("cmp/b-sch.bmp":u) .
     3037                                   hh:TOOLTIP = "Установка Фильтра" .
     3038                                   v-h[ii] = hh:handle .
     3039                                   ii = ii + 1 .
     3040                                   hh:width-chars = 3 .
     3041                               end.
     3042                           when "b-hist-user" then
     3043                               do:
     3044                                   hh:load-image("cmp/b-hist.bmp":u) .
     3045                                   hh:TOOLTIP = "История пользователя" .
     3046                                   ii = ii + 1 .
     3047                               end.
     3048                       end case.
     3049                   end.
     3050                   hh = hh:next-sibling.
     3051               end.
     3052               b-help:column = v-frame-width - b-help:width-chars.
     3053               jj = 0.
     3054               repeat ii = 4 to 1 by -1 :
     3055                   if valid-handle (v-h[ii] ) then
     3056                   do:
     3057                       jj  = jj + 1 .
     3058                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3059                       v-h[ii]:row    = v-help-old-y .
     3060                   end.
     3061               end.
     3062           end.
     3063       end.
     3064   end procedure.
     3065   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3066   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3067   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3068   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3069   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3070   define variable v-diasize-current-frame-height as decimal   no-undo .
     3071   define variable v-diasize-change-size          as logical   no-undo .
     3072   define variable v-diasize-resize-button        as handle    no-undo .
     3073   define variable v-diasize-wndmax               as logical   no-undo .
     3074   define variable v-diasize-wndstore             as logical   no-undo .
     3075   define variable v-diasize-proc-name            as character no-undo .
     3076   define variable v-diasize-browse-handle        as handle    no-undo .
     3077   define variable v-diasize-browse-number        as integer   no-undo .
     3078   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3079   define temp-table temp-diasize-handle no-undo
     3080     field handle-value  as handle
     3081     field save-position as decimal
     3082     index xpk is primary unique handle-value
     3083     .
     3084   define temp-table temp-browse-handle no-undo
     3085     field browse-type   as character
     3086     field browse-number as integer
     3087     field browse-handle as handle
     3088     field original-size as decimal
     3089     index xpk is primary unique browse-type browse-number
     3090     index xie browse-type browse-handle
     3091   .
     3092   procedure diasize_change-height :
     3093     define input  parameter p-change-value  as decimal   no-undo .
     3094     define input  parameter p-move-resize   as logical   no-undo .
     3095     define variable v-field-group-handle    as handle    no-undo .
     3096     define variable v-object-handle         as handle    no-undo .
     3097     define variable v-frame-height          as decimal   no-undo .
     3098     define variable v-frame-virtual-height  as decimal   no-undo .
     3099     define variable v-browse-height         as decimal   no-undo .
     3100     define variable v-window-height         as decimal   no-undo .
     3101     define variable v-window-virtual-height as decimal   no-undo .
     3102     define variable v-change-sign           as integer   no-undo .
     3103     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3104     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3105     if p-change-value > 0
     3106     then do:
     3107       if frame d-all-r-docs :height + p-change-value
     3108           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3109       then do:
     3110         assign
     3111           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3112                           - (frame d-all-r-docs :height-chars)
     3113         .
     3114         if p-change-value <= 0
     3115         then do:
     3116           run diasize_position-resize-button in this-procedure .
     3117           return .
     3118         end.
     3119       end.
     3120     end.
     3121     if p-change-value < 0
     3122     then do:
     3123       if frame d-all-r-docs :height + p-change-value < v-diasize-orig-frame-height
     3124       then do:
     3125         assign
     3126           p-change-value = v-diasize-orig-frame-height
     3127                          - (frame d-all-r-docs :height-chars)
     3128         .
     3129         if p-change-value >= 0
     3130         then do:
     3131           run diasize_position-resize-button in this-procedure .
     3132           return .
     3133         end.
     3134       end.
     3135     end.
     3136     if p-change-value >= 0
     3137     then do:
     3138       assign
     3139         v-change-sign = 1
     3140       .
     3141     end.
     3142     else do:
     3143       assign
     3144         v-change-sign = -1
     3145       .
     3146     end.
     3147     assign
     3148       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3149     .
     3150     if p-change-value = 0
     3151     then do:
     3152       run diasize_position-resize-button in this-procedure .
     3153       return .
     3154     end.
     3155     move_block:
     3156     do
     3157     on error undo move_block, retry move_block
     3158     :
     3159       if retry
     3160       then do:
     3161         do
     3162         on error undo move_block, leave move_block
     3163         :
     3164           if p-change-value > 0
     3165           then do:
     3166             for each buf_temp-diasize-handle
     3167             on error undo, next
     3168             :
     3169               assign
     3170                 v-object-handle = buf_temp-diasize-handle.handle-value
     3171               .
     3172               if v-object-handle <> v-diasize-resize-button
     3173               then do:
     3174                 assign
     3175                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3176                 .
     3177               end.
     3178             end.
     3179             assign
     3180               v-diasize-browse-handle :height = v-browse-height
     3181             .
     3182             for each buf_temp-browse-handle
     3183               where buf_temp-browse-handle.browse-type = 'height':u
     3184             on error undo, next
     3185             :
     3186               assign
     3187                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3188               .
     3189             end.
     3190             assign
     3191               frame d-all-r-docs :height = v-frame-height
     3192             .
     3193             if frame d-all-r-docs :scrollable = true
     3194             then do:
     3195               assign
     3196                 frame d-all-r-docs :virtual-height = v-frame-virtual-height
     3197               .
     3198             end.
     3199             run diasize_position-resize-button in this-procedure .
     3200           end.
     3201           else do:
     3202             if frame d-all-r-docs :scrollable = true
     3203             then do:
     3204               assign
     3205                 frame d-all-r-docs :virtual-height = v-frame-virtual-height
     3206               .
     3207             end.
     3208             assign
     3209               frame d-all-r-docs :height = v-frame-height
     3210             .
     3211             assign
     3212               v-diasize-browse-handle :height = v-browse-height
     3213             .
     3214             for each buf_temp-browse-handle
     3215               where buf_temp-browse-handle.browse-type = 'height':u
     3216             on error undo, next
     3217             :
     3218               assign
     3219                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3220               .
     3221             end.
     3222             for each buf_temp-diasize-handle
     3223             on error undo, next
     3224             :
     3225               assign
     3226                 v-object-handle = buf_temp-diasize-handle.handle-value
     3227               .
     3228               if v-object-handle <> v-diasize-resize-button
     3229               then do:
     3230                 assign
     3231                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3232                 .
     3233               end.
     3234             end.
     3235             run diasize_position-resize-button in this-procedure .
     3236           end.
     3237           assign
     3238             v-diasize-change-size = false
     3239           .
     3240           leave move_block .
     3241         end.
     3242       end.
     3243       assign
     3244         v-diasize-need-full-display = true
     3245       .
     3246       if v-diasize-change-size = false
     3247       then do:
     3248         assign
     3249           v-diasize-change-size = true
     3250         .
     3251       end.
     3252       else do:
     3253         return .
     3254       end.
     3255       assign
     3256         v-frame-height = frame d-all-r-docs :height
     3257         v-frame-virtual-height = frame d-all-r-docs :virtual-height
     3258         v-browse-height = v-diasize-browse-handle :height
     3259       .
     3260       for each buf_temp-browse-handle
     3261         where buf_temp-browse-handle.browse-type = 'height':u
     3262       :
     3263         assign
     3264           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3265         .
     3266       end.
     3267       for each buf_temp-diasize-handle
     3268       :
     3269         delete buf_temp-diasize-handle .
     3270       end.
     3271       assign
     3272         v-field-group-handle = frame d-all-r-docs :first-child
     3273       .
     3274       do while valid-handle(v-field-group-handle)
     3275       :
     3276         assign
     3277           v-object-handle = v-field-group-handle :first-child
     3278         .
     3279         do while valid-handle(v-object-handle)
     3280         :
     3281           if  v-object-handle <> v-diasize-browse-handle :handle
     3282           and can-query(v-object-handle, "row")
     3283           and can-query(v-object-handle, "height")
     3284           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3285           then do:
     3286             find first buf_temp-browse-handle
     3287               where buf_temp-browse-handle.browse-type   = 'height':u
     3288                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3289               no-error .
     3290             if available buf_temp-browse-handle
     3291             then do:
     3292             end.
     3293             else do:
     3294               create buf_temp-diasize-handle .
     3295               assign
     3296                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3297                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3298               .
     3299             end.
     3300           end.
     3301           assign
     3302             v-object-handle = v-object-handle :next-sibling
     3303           .
     3304         end.
     3305         assign
     3306           v-field-group-handle = v-field-group-handle :next-sibling
     3307         .
     3308       end.
     3309       do with frame d-all-r-docs
     3310       :
     3311         hide v-diasize-resize-button .
     3312         assign
     3313           v-diasize-resize-button :row    = 1
     3314           v-diasize-resize-button :column = 1
     3315         .
     3316       end.
     3317       if p-change-value > 0
     3318       then do:
     3319         if frame d-all-r-docs :scrollable = true
     3320         then do:
     3321           assign
