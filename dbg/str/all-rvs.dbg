        1   using ibs.th.gbl.storage.*.
        2   DEFINE NEW SHARED BUFFER r-doc FOR rvs-doc.
        3   define input parameter parparentproc as handle    no-undo.
        4   define input parameter parlist-mode  as character no-undo.
        5   define input parameter parstatus     as character no-undo.
        6   define output parameter out-rec      as recid     no-undo.
        7   define variable vss-revision    as character no-undo initial "$Revision$":U .
        8   define variable vss-author      as character no-undo initial "$Author$":U .
        9   define variable vss-date        as character no-undo initial "$Date$":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       11   define variable vss-archive     as character no-undo initial "$Archive$":U .
       12   define variable vss-description as character no-undo initial "Список документов сверки":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#language as character no-undo .
      113   if g#language <> '' and g#language <> 'rus':U then do:
      114     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      115   end.
      116   define new global shared variable g#library  as handle no-undo .
      117   define new global shared variable g#library2 as handle no-undo .
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define variable v-waitfram-action01         as character   no-undo .
      120   define variable v-waitfram-action02         as character   no-undo .
      121   define variable v-waitfram-action03         as character   no-undo .
      122   define variable mWaitFramTextBeg            as character   no-undo.
      123   define variable mWaitFramTextEnd            as character   no-undo.
      124   define variable mWaitFramView               as logical     no-undo.
      125   define variable mWaitProcEvent              as logical     no-undo init yes.
      126   define variable mWaitFramInterval           as integer     no-undo init 1 .
      127   define variable mWaitFramStop               as logical     no-undo.
      128   define variable mWaitFramStopUser           as logical     no-undo.
      129   define variable mWaitFramStopTimeOut        as logical     no-undo.
      130   define variable mWaitFramStartProc          as datetime-tz no-undo.
      131   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      132   define button B-WaitFramStop auto-end-key
      133        label "Стоп"
      134        size 10 by 1 tooltip "Остоновить процесс".
      135   define button B-viewProcInfo
      136        label "Информация"
      137        size 15 by 1 tooltip "Информация о процесс".
      138   define frame waitfram
      139     v-waitfram-action01 format "x(72)" no-label skip
      140     v-waitfram-action02 format "x(72)" no-label skip
      141     v-waitfram-action03 format "x(72)" no-label skip
      142     B-viewProcInfo
      143     B-WaitFramStop at row 4 col 30
      144     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      145     .
      146   define new global shared variable mBatchMode as logical no-undo init ?.
      147   define variable mFramBachModHandle as handle no-undo.
      148   mFramBachModHandle = frame waitfram:handle.
      149   define variable mFameOldVis as logical no-undo.
      150   define variable mVisCUrentVin as logical no-undo.
      151   if session:batch-mode
      152   then
      153      mBatchMode = yes.
      154   if mBatchMode = ? then do:
      155     mVisCUrentVin = current-window:visible.
      156     mFameOldVis = mFramBachModHandle:visible.
      157     mFramBachModHandle:visible  = yes.
      158     mBatchMode = mFramBachModHandle:visible ne yes.
      159     mFramBachModHandle:visible = mFameOldVis.
      160     current-window:visible = mVisCUrentVin.
      161   end.
      162    if  log-manager:logfile-name ne ?
      163     then DO:
      164         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      165         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      166         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      167     end.
      168   on choose of B-WaitFramStop in frame waitfram
      169   do:
      170     mWaitFramStop = yes.
      171     mWaitFramStopUser = yes.
      172   end.
      173   function waitfram-check-timeout returns logical():
      174      define variable vtime as int64 no-undo.
      175      if mWaitFramStopTimeOut
      176      then
      177         return yes.
      178      vtime = ( now - mWaitFramStartProc ) / 1000 .
      179      if     mWaitFramTimeOut ne ?
      180         and mWaitFramTimeOut ne 0
      181         and mWaitFramTimeOut lt vtime
      182      then do:
      183         mWaitFramStopTimeOut = yes.
      184      end.
      185      return mWaitFramStopTimeOut.
      186   end.
      187   procedure waitfram-hide :
      188     if not session:batch-mode
      189     then do
      190     on error undo, return error return-value
      191     :
      192       pause 0 before-hide .
      193       if not mBatchMode then
      194         hide frame waitfram .
      195     end.
      196   end procedure.
      197   procedure waitfram-show :
      198     define input  parameter p-message as character no-undo .
      199     define variable v-left-margin as integer   no-undo .
      200     if not session:batch-mode
      201     then do
      202     on error undo, return error return-value
      203     :
      204       if length(p-message) <= 70 then do:
      205         assign
      206           v-left-margin = integer((70 - length(p-message)) / 2)
      207         .
      208         assign
      209           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      210         .
      211         assign
      212           v-waitfram-action01 = " "
      213           v-waitfram-action02 = " "
      214                                    + fill(" ", v-left-margin)
      215                                    + p-message
      216           v-waitfram-action03 = " "
      217         .
      218       end.
      219       else do:
      220         define variable vRindex1 as integer no-undo.
      221         define variable vRindex2 as integer no-undo.
      222         vRindex1 = r-index(p-message," ",70).
      223         if vRindex1 = 0
      224         then
      225            vRindex1 = 70.
      226         if length(p-message)  <= vRindex1 + 70 then do:
      227           assign
      228             v-waitfram-action01 = " "
      229             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      230             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      231           .
      232         end.
      233         else do:
      234           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      235           if vRindex2 <= vRindex1
      236           then
      237              vRindex2 = vRindex1 + 70.
      238           assign
      239             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      242           .
      243         end.
      244       end.
      245       B-viewProcInfo:visible   in frame waitfram = no.
      246       B-viewProcInfo:sensitive in frame waitfram = no.
      247       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       if  (   mWaitFramView
      250          or  mWaitProcEvent)
      251          and not mBatchMode
      252       then
      253          display
      254             v-waitfram-action01 skip
      255             v-waitfram-action02 skip
      256             v-waitfram-action03 skip
      257          with frame waitfram .
      258     end.
      259   end procedure.
      260      procedure waitfram-show-this:
      261         define input  parameter iInterval as int64 no-undo.
      262         define variable vtime as int64 no-undo.
      263         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      264         mWaitFramInterval = iInterval.
      265         run waitfram-show (substitute("&1&2 &3&4" ,
      266                                       mWaitFramTextBeg ,
      267                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      268                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      269                                       mWaitFramTextEnd
      270                                      )
      271                           ).
      272      end.
      273      procedure WaitFramRunPause:
      274         define input  parameter iInterval as dec no-undo.
      275         define variable vStart  as datetime-tz no-undo.
      276         define variable vend    as datetime-tz no-undo.
      277         define variable vint as int64 no-undo.
      278         define variable vOk as logical no-undo.
      279         vStart = now.
      280         vend   = vStart.
      281         publish "WaitFramPause" (iInterval,output vOk).
      282         vend   =  now.
      283         vint = vend - vStart.
      284         vint = iInterval - vint / 1000.
      285         if     not mWaitFramStop
      286            and (   vint > 0
      287                 or (    not vOk
      288                     and iInterval eq ?
      289                     )
      290                 )
      291         then
      292            run waitfram-show-this (iInterval).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and vint > 0
      298         then do:
      299            run gbl/pause.p (vint * 1000).
      300         end.
      301         if iInterval ne ?
      302         then
      303            publish "WaitFramStop".
      304         waitfram-check-timeout().
      305      end.
      306      procedure WaitFramWaitFor:
      307         define input  parameter iInterval as dec no-undo.
      308         assign
      309            mWaitFramStartProc   = now
      310            mWaitFramStopUser    = no
      311            mWaitFramStopTimeOut = no
      312         .
      313         block-wait:
      314         do while not mWaitFramStop:
      315            run WaitFramRunPause (iInterval).
      316            if  waitfram-check-timeout()
      317            then do:
      318               leave block-wait.
      319            end.
      320         end.
      321         run waitfram-hide.
      322      end.
      323   procedure waitfram-join :
      324     define input  parameter p-line-1  as character no-undo .
      325     define input  parameter p-line-2  as character no-undo .
      326     define input  parameter p-line-3  as character no-undo .
      327     define output parameter p-message as character no-undo .
      328     do
      329     on error undo, return error return-value
      330     :
      331       assign
      332         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      333                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      334                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      335       .
      336     end.
      337   end procedure.
      338   function waitfram-join-function returns character
      339     (input p-line-1 as character
      340     ,input p-line-2 as character
      341     ,input p-line-3 as character
      342     ).
      343     define variable v-message as character no-undo .
      344     run waitfram-join in this-procedure
      345       (input  p-line-1
      346       ,input  p-line-2
      347       ,input  p-line-3
      348       ,output v-message
      349       ) .
      350     return v-message .
      351   end function .
