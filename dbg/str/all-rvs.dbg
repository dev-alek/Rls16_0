     5358                             ,input parameter-6-49
     5359                             ,input parameter-7-49
     5360                             )
     5361         .
     5362         assign
     5363           l-filter-open-49 = true
     5364         .
     5365       end.
     5366       if l-filter-open-49 = false then do:
     5367         message
     5368           "Ошибка при фильтрации / сортировке" skip
     5369           "Будут показаны записи без учета фильтра" skip
     5370           view-as alert-box .
     5371       end.
     5372       else do:
     5373           assign
     5374             l-query-was-opened = true
     5375           .
     5376       end.
     5377     end.
     5378     if l-filter-open-49 = false then do:
     5379       open query br-r-docs for each r-doc
     5380         where r-doc.obj-type = varobj-type and
     5381                                   r-doc.obj-code = varobj-code and
     5382                                   r-doc.status_  = 'факт':U     and
     5383                                   r-doc.rvs-type = 'контроль':U
     5384         indexed-reposition
     5385     .
     5386         assign
     5387           l-query-was-opened = true
     5388         .
     5389     end.
     5390                   enable b-sel with frame d-all-r-docs.
     5391               end.
     5392       end case.
     5393       apply "entry" to br-r-docs in frame d-all-r-docs.
     5394       if rvs-rec <> ? then
     5395       do:
     5396           reposition br-r-docs to recid rvs-rec no-error.
     5397       end.
     5398       if available r-doc then
     5399       do:
     5400     apply "value-changed" to br-r-docs in frame d-all-r-docs.
     5401       end.
     5402       run waitfram-hide in this-procedure .
     5403   END PROCEDURE.
     5404   PROCEDURE proc-copy :
     5405   define variable v-str as character no-undo.
     5406       define variable jj    as integer   no-undo.
     5407       do
     5408           on error   undo, return error
     5409           on end-key undo, return error
     5410           on stop    undo, return error
     5411           :
     5412           if not available r-doc then
     5413           do:
     5414               message "Не выбрана сверка, из которой нужно сделать сменную." view-as alert-box.
     5415               return error.
     5416           end.
     5417           run str/ctrc2sht.p
     5418               ( input parparentproc
     5419               ,input recid( r-doc )
     5420               ) no-error.
     5421           if error-status :error then
     5422           do:
     5423               assign
     5424                   v-str = "":U.
     5425               do jj = 1 to error-status :num-messages :
     5426                   assign
     5427                       v-str = v-str + ( if v-str = "":U then "":U else chr(10) ) + error-status :get-message( jj ).
     5428               end.
     5429               assign
     5430                   v-str = v-str + ( if v-str = "":U then "":U else chr(10) ) + return-value.
     5431               message
     5432                   "Ошибка создания сверки." skip
     5433                   v-str
     5434                   view-as alert-box error title " О Ш И Б К А ! ! ! ".
     5435               for each tt-susp-chk:
     5436                   find first ub.susp-chk exclusive-lock where ub.susp-chk.doc-code = tt-susp-chk.doc-code no-error .
     5437                   if not available (ub.susp-chk) then
     5438                   do:
     5439                       create ub.susp-chk .
     5440                       buffer-copy tt-susp-chk to ub.susp-chk .
     5441                   end.
     5442                   else do:
     5443                       ub.susp-chk.reason-name = tt-susp-chk.reason-name .
     5444                       ub.susp-chk.link-chk = tt-susp-chk.link-chk .
     5445                   end.
     5446               end.
     5447               return error.
     5448           end.
     5449       end.
     5450   END PROCEDURE.
     5451   PROCEDURE proc-del :
     5452   define variable del-rec   as recid   no-undo.
     5453       define variable unrv-qnty as decimal no-undo.
     5454       define variable varfind   as logical no-undo.
     5455       define buffer bf-prev_rvs-doc  for ub.rvs-doc.
     5456       define buffer bf_trn-doc       for ub.trn-doc.
     5457       define buffer bf_doc-line      for ub.doc-line.
     5458       define buffer bf_goods         for ub.goods.
     5459       define buffer bf_rvs-line      for ub.rvs-line.
     5460       define buffer bf-prev_rvs-line for ub.rvs-line.
     5461       do
     5462           on error   undo, return error
     5463           on end-key undo, return error
     5464           on stop    undo, return error
     5465           :
     5466           if r-doc.status_ <> 'новый':U
     5467               and r-doc.status_ <> 'факт':U
     5468               then
     5469           do:
     5470               message
     5471                   "Документ в данном статусе не может быть удален."
     5472                   view-as alert-box.
     5473               return error   "Документ сверки с типом 'смена' в данном статусе не может быть удален" .
     5474           end.
     5475           if r-doc.status_ = 'факт':U then
     5476           do:
     5477               if r-doc.rvs-type = 'смена':U then
     5478               do:
     5479                   message
     5480                       "Документ сверки с типом 'смена' в данном статусе не может быть удален"
     5481                       view-as alert-box.
     5482                   return error   "Документ сверки с типом 'смена' в данном статусе не может быть удален" .
     5483               end.
     5484               else
     5485               do:
     5486                   if r-doc.rvs-type <> 'контроль':U then
     5487                   do:
     5488                       message
     5489                           "Закрытый документ сверки с типом, отличным от 'контроль', не может быть удален"
     5490                           view-as alert-box.
     5491                       return error "Закрытый документ сверки с типом, отличным от 'контроль', не может быть удален" .
     5492                   end.
     5493                   else
     5494                   do:
     5495                       case r-doc.rvs-type :
     5496                           when 'контроль':U then
     5497                               do:
     5498   define variable vss-include-info50 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5499   do:
     5500     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5501       (input  v-cntxt-db-num
     5502       ,input  v-cntxt-userid
     5503       ,input  0
     5504       ,input  'actn_rvs-control_del-fact':U
     5505       ,input  'object':U
     5506       ,input  r-doc.host-code
     5507       ,input  r-doc.obj-type
     5508       ,input  r-doc.obj-code
     5509       ,input  0
     5510       ,input  0
     5511       ,input  0
     5512       ,input  true
     5513       ,output varlog
     5514       )  .
     5515   end.
     5516                               end.
     5517                           otherwise
     5518                           do:
     5519                               message
     5520                                   vss-workfile vss-revision vss-description skip
     5521                                   "Неизвестный тип документа сверки" skip
     5522                                   "Тип документа сверки" r-doc.rvs-type skip
     5523                                   "Код документа сверки" r-doc.rvs-code skip
     5524                                   view-as alert-box error .
     5525                               undo, return no-apply .
     5526                           end.
     5527                       end case .
     5528                       if varlog <> yes then
     5529                       do:
     5530                           return error.
     5531                       end.
     5532                       for each bf_rvs-line no-lock
     5533                           where bf_rvs-line.rvs-code = r-doc.rvs-code
     5534                           on error undo, return error
     5535                           :
     5536                           assign
     5537                               varfind = no
     5538                               .
     5539                           for each bf-prev_rvs-doc no-lock
     5540                               where bf-prev_rvs-doc.obj-type   = r-doc.obj-type
     5541                               and bf-prev_rvs-doc.obj-code   = r-doc.obj-code
     5542                               and bf-prev_rvs-doc.fact-order < r-doc.fact-order
     5543                               ,first bf-prev_rvs-line no-lock
     5544                               where bf-prev_rvs-line.rvs-code = bf-prev_rvs-doc.rvs-code
     5545                               and bf-prev_rvs-line.gds-code = bf_rvs-line.gds-code
     5546                               on error undo, return error
     5547                               :
     5548                               assign
     5549                                   varfind = yes.
     5550                               leave.
     5551                           end.
     5552                           if varfind <> yes then
     5553                           do:
     5554                               find first bf_goods no-lock
     5555                                   where bf_goods.gds-code = bf_rvs-line.gds-code
     5556                                   .
     5557                               find first bf_doc-line no-lock
     5558                                   where bf_doc-line.obj-type  = r-doc.obj-type
     5559                                   and bf_doc-line.obj-code  = r-doc.obj-code
     5560                                   and bf_doc-line.artic     = bf_goods.artic
     5561                                   and bf_doc-line.prod-type = bf_goods.prod-type
     5562                                   and bf_doc-line.prod-code = bf_goods.prod-code
     5563                                   no-error.
     5564                               if available bf_doc-line then
     5565                               do:
     5566                                   message
     5567                                       "Нельзя удалить сверку, являющуюся первой контрольной для товара."
     5568                                       "На объекте есть складские документы по этому товару. Номер документа " bf_doc-line.doc-code
     5569                                       " Товар " bf_doc-line.artic " " bf_doc-line.prod-type " " bf_doc-line.prod-code
     5570                                       view-as alert-box.
     5571                                   return error substitute (      "Нельзя удалить сверку, являющуюся первой контрольной для товара.
     5572                     На объекте есть складские документы по этому товару. Номер документа  &1 
     5573                     Товар &2&3&4 " , bf_doc-line.doc-code , bf_doc-line.artic , bf_doc-line.prod-type, bf_doc-line.prod-code).
     5574                               end.
     5575                           end.
     5576                           find first bf_trn-doc no-lock where bf_trn-doc.out-code = r-doc.rvs-code no-error.
     5577                           if available bf_trn-doc then
     5578                           do:
     5579                               message "К сверке есть привязанные складские документы. Удалить нельзя."
     5580                                   "Номер документа " bf_trn-doc.doc-code " ."
     5581                                   view-as alert-box.
     5582                               return error "К сверке есть привязанные складские документы. Удалить нельзя." .
     5583                           end.
     5584                       end.
     5585                   end.
     5586               end.
     5587           end.
     5588           assign
     5589               varlog = no.
     5590           message
     5591               "Удалить документ сверки №" r-doc.rvs-code "?" skip
     5592               "   Вы уверены ?"
     5593               view-as alert-box question buttons OK-Cancel update varlog.
     5594           assign
     5595               rvs-rec = recid( r-doc )
     5596               .
     5597           if not varlog then
     5598           do:
     5599               find first r-doc no-lock
     5600                   where recid (r-doc) = rvs-rec
     5601                   .
     5602               return no-apply.
     5603           end.
     5604           case r-doc.rvs-type
     5605               :
     5606               when 'перед_док':U
     5607               or
     5608               when 'после_док':U
     5609               then
     5610                   do:
     5611   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5612   do:
     5613     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5614       (input  v-cntxt-db-num
     5615       ,input  v-cntxt-userid
     5616       ,input  0
     5617       ,input  'actn_rvs-on-doc_deletion':U
     5618       ,input  'object':U
     5619       ,input  r-doc.host-code
     5620       ,input  r-doc.obj-type
     5621       ,input  r-doc.obj-code
     5622       ,input  0
     5623       ,input  0
     5624       ,input  0
     5625       ,input  true
     5626       ,output varlog
     5627       )  .
     5628   end.
     5629                   end.
     5630               when 'смена':U then
     5631                   do:
     5632   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5633   do:
     5634     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5635       (input  v-cntxt-db-num
     5636       ,input  v-cntxt-userid
     5637       ,input  0
     5638       ,input  'actn_rvs-shift_deletion':U
     5639       ,input  'object':U
     5640       ,input  r-doc.host-code
     5641       ,input  r-doc.obj-type
     5642       ,input  r-doc.obj-code
     5643       ,input  0
     5644       ,input  0
     5645       ,input  0
     5646       ,input  true
     5647       ,output varlog
     5648       )  .
     5649   end.
     5650                   end.
     5651               when 'контроль':U then
     5652                   do:
     5653   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5654   do:
     5655     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5656       (input  v-cntxt-db-num
     5657       ,input  v-cntxt-userid
     5658       ,input  0
     5659       ,input  'actn_rvs-control_deletion':U
     5660       ,input  'object':U
     5661       ,input  r-doc.host-code
     5662       ,input  r-doc.obj-type
     5663       ,input  r-doc.obj-code
     5664       ,input  0
     5665       ,input  0
     5666       ,input  0
     5667       ,input  true
     5668       ,output varlog
     5669       )  .
     5670   end.
     5671                   end.
     5672               otherwise
     5673               do:
     5674                   message
     5675                       vss-workfile vss-revision vss-description skip
     5676                       "Неизвестный тип документа сверки" skip
     5677                       "Тип документа сверки" r-doc.rvs-type skip
     5678                       "Код документа сверки" r-doc.rvs-code skip
     5679                       view-as alert-box error .
     5680                   undo, return no-apply .
     5681               end.
     5682           end case .
     5683           if not varlog then
     5684           do:
     5685               find first r-doc no-lock
     5686                   where recid (r-doc) = rvs-rec
     5687                   .
     5688               return no-apply.
     5689           end.
     5690           run waitfram-show in this-procedure
     5691               ( input "Удаление документа сверки № " + r-doc.rvs-code + ". Ждите..."
     5692               ).
     5693           assign
     5694               br-handle = br-r-docs :handle in frame d-all-r-docs
     5695               del-rec   = recid( r-doc )
     5696               .
     5697           if valid-handle( br-handle ) then
     5698           do:
     5699               assign
     5700                   varlog = br-handle :select-next-row( )
     5701                   .
     5702               if varlog <> true then
     5703               do:
     5704                   assign
     5705                       varlog = br-handle :select-prev-row( )
     5706                       .
     5707               end.
     5708               if varlog = true then
     5709               do:
     5710                   assign
     5711                       rvs-rec = recid( r-doc )
     5712                       .
     5713               end.
     5714           end.
     5715           del-doc:
     5716           do transaction
     5717               on stop    undo del-doc, retry del-doc
     5718               on error   undo del-doc, retry del-doc
     5719               on end-key undo del-doc, retry del-doc
     5720               :
     5721               if retry then
     5722               do:
     5723                   message
     5724                       vss-workfile vss-revision vss-description skip
     5725                       substitute("Ошибка при удалении сверки.") skip
     5726                       error-status :get-message(1) skip
     5727                       return-value skip
     5728                       view-as alert-box error .
     5729                   leave del-doc .
     5730               end.
     5731               find first r-doc exclusive-lock
     5732                   where recid( r-doc ) = del-rec
     5733                   .
     5734               assign
     5735                   r-doc.is-del = true
     5736                   .
     5737               delete r-doc.
     5738           end.
     5739           run waitfram-hide in this-procedure .
     5740       end.
     5741   END PROCEDURE.
     5742   PROCEDURE UI-on :
     5743   ENABLE
     5744           b-quit
     5745           b-lkp
     5746           b-print
     5747           b-sch
     5748           b-hist
     5749           b-help
     5750           ed-notes
     5751           br-r-docs
     5752           WITH FRAME d-all-r-docs.
     5753       ASSIGN
     5754           r-doc.state-level-water:READ-ONLY in browse br-r-docs = YES
     5755       .
     5756       run OpenBr in this-procedure .
     5757   END PROCEDURE.
     5758   PROCEDURE userlogrvs :
     5759   define input parameter p-vid-action as integer  no-undo .
     5760   define input parameter p-mess as char no-undo.
     5761       define variable v-person as character no-undo.
     5762       define variable v-vid-param  as longchar no-undo .
     5763     define variable v-result as integer no-undo.
     5764     define variable varshift-date as date no-undo.
     5765     define variable  varshift-num as integer no-undo.
     5766     define variable varshift-name as char no-undo.
     5767   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     5769     (input  r-doc.obj-type
     5770     ,input  r-doc.obj-code
     5771     ,output varshift-date
     5772     ,output varshift-num
     5773     ,output varshift-name
     5774     ) no-error .
     5775           for first  ub.clients where ub.clients.obj-type = 'чел':U and  ub.clients.obj-code = ub.c-rvs-doc.boss no-lock :
     5776               v-person = clients.obj-name.
     5777           end.
     5778       v-vid-param =
     5779           "Initiator=" + "User" + chr(4) +
     5780           "ResponsiblePerson=" + (if v-person <> ?  then v-person else "") + chr(4) +
     5781           "SHOP_NUM=" + string(r-doc.obj-code) + chr(4) +
     5782           "DocNum=" + string(r-doc.rvs-code) + chr(4) +
     5783           "FactDate=" + (if string(r-doc.fact-date) = ? then '' else string(r-doc.fact-date)) + chr(4) +
     5784           "DocType=" + string(r-doc.rvs-type) + chr(4) +
     5785           "SHIFT_NUM_DOC=" + (if string(r-doc.shift-num) = ? then '' else string(r-doc.shift-num)) + (if string(r-doc.shift-date) = ? then '' else string(r-doc.shift-date ,  "99999999" )) + chr(4) +
     5786           "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
     5787           "Status=" + string(r-doc.status_) + chr(4) +
     5788           "RESULT=" + string( 1 ) + chr(4) +
     5789           "Description=" + p-mess no-error.
     5790           run trg/userlog.p (
     5791               input if p-vid-action = 60 then 'delete_err':U else 'update_err':U
     5792               , input 'rvs-doc':U
     5793               , input ( buffer r-doc :handle )
     5794               , input p-vid-action
     5795               , input v-vid-param
     5796               ) no-error.
     5797           if error-status :error
     5798               then
     5799           do:
     5800               message substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     5801                   , chr(10)
     5802                   , vss-workfile
     5803                   , return-value
     5804                   , error-status :get-message ( 1 ) )
     5805                   view-as alert-box.
     5806               return no-apply.
     5807           end.
     5808   END PROCEDURE.
     5809   FUNCTION mark-string RETURNS CHARACTER
     5810       ( p-rec as recid ) :
     5811       def buffer loc-rvs-doc for ub.rvs-doc  .
     5812       find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
     5813       if error-status :error then return '' .
     5814       if can-do (del-list, string (recid (loc-rvs-doc))) then RETURN "*".
     5815       else RETURN "".
     5816   END FUNCTION.
     5817   FUNCTION get-input-type RETURNS CHARACTER
     5818       ( p-rec as recid ) :
     5819       def buffer loc-rvs-doc for ub.rvs-doc  .
     5820       define buffer loc-rvs-line for ub.rvs-line .
     5821       define buffer loc-rvs-line-attr for ub.rvs-line-attr .
     5822       define variable v-doc-input-type as character no-undo .
     5823       define variable v-input-type-list as character no-undo .
     5824       find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
     5825       for each loc-rvs-line no-lock where loc-rvs-line.rvs-code = loc-rvs-doc.rvs-code :
     5826         find first loc-rvs-line-attr no-lock
     5827               where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
     5828               and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
     5829               and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
     5830               and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
     5831               and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
     5832               and loc-rvs-line-attr.attr-code = 'input-type'
     5833               no-error.
     5834         if available loc-rvs-line-attr
     5835         then do :
     5836           v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
     5837         end.
     5838       end.
     5839       if trim(v-input-type-list) = ""
     5840       then do :
     5841         for each loc-rvs-line no-lock where loc-rvs-line.rvs-code = loc-rvs-doc.rvs-code :
     5842           find first loc-rvs-line-attr no-lock
     5843                 where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
     5844                 and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
     5845                 and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
     5846                 and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
     5847                 and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
     5848                 and loc-rvs-line-attr.attr-code = 'input-type-p'
     5849                 no-error.
     5850           if available loc-rvs-line-attr
     5851           then do :
     5852             v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
     5853           end.
     5854           find first loc-rvs-line-attr no-lock
     5855                 where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
     5856                 and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
     5857                 and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
     5858                 and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
     5859                 and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
     5860                 and loc-rvs-line-attr.attr-code = 'input-type-t'
     5861                 no-error.
     5862           if available loc-rvs-line-attr
     5863           then do :
     5864             v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
     5865           end.
     5866           find first loc-rvs-line-attr no-lock
     5867                 where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
     5868                 and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
     5869                 and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
     5870                 and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
     5871                 and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
     5872                 and loc-rvs-line-attr.attr-code = 'input-type-l'
     5873                 no-error.
     5874           if available loc-rvs-line-attr
     5875           then do :
     5876             v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
     5877           end.
     5878         end.
     5879       end .
     5880       v-input-type-list = left-trim(v-input-type-list, ",") .
     5881       if can-do(v-input-type-list, 'а')
     5882       and not can-do(v-input-type-list, 'ф')
     5883       and not can-do(v-input-type-list, 'ак')
     5884       and not can-do(v-input-type-list, 'фк')
     5885       and not can-do(v-input-type-list, 'п')
     5886       then v-doc-input-type = 'а'.
     5887       if can-do(v-input-type-list, 'ф')
     5888       and not can-do(v-input-type-list, 'а')
     5889       and not can-do(v-input-type-list, 'ак')
     5890       and not can-do(v-input-type-list, 'фк')
     5891       and not can-do(v-input-type-list, 'п')
     5892       then v-doc-input-type = 'ф'.
     5893       if  not can-do(v-input-type-list, 'ф')
     5894       and can-do(v-input-type-list, 'ак')
     5895       and not can-do(v-input-type-list, 'п')
     5896       then v-doc-input-type = 'ак'.
     5897       if ((can-do(v-input-type-list, 'ф')
     5898       or can-do(v-input-type-list, 'п'))
     5899       and can-do(v-input-type-list, 'а'))
     5900       or can-do(v-input-type-list, 'фк')
     5901       then v-doc-input-type = 'фк'.
     5902       if can-do(v-input-type-list, 'р')
     5903       and not can-do(v-input-type-list, 'а')
     5904       and not can-do(v-input-type-list, 'ф')
     5905       and not can-do(v-input-type-list, 'к')
     5906       and not can-do(v-input-type-list, 'п')
     5907       then v-doc-input-type = 'р'.
     5908       if v-doc-input-type = 'а'
     5909       and (can-do(v-input-type-list, 'р')
     5910         or can-do(v-input-type-list, ''))
     5911       then v-doc-input-type = 'ак'.
     5912       if v-doc-input-type = 'ф'
     5913       and (can-do(v-input-type-list, 'р')
     5914         or can-do(v-input-type-list, ''))
     5915       then v-doc-input-type = 'фк'.
     5916       if v-doc-input-type = ? then v-doc-input-type = '' .
     5917       return v-doc-input-type .
     5918   END FUNCTION.
     5919   FUNCTION shift-name RETURNS CHARACTER
     5920       ( p-rec as recid ) :
     5921       def buffer loc-rvs-doc for ub.rvs-doc  .
     5922       find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
     5923       if error-status :error then return '' .
     5924       if loc-rvs-doc.shift-date = ? then
     5925       do:
     5926           return "":u.
     5927       end.
     5928       else
     5929       do:
     5930           if loc-rvs-doc.shift-num = integer(loc-rvs-doc.shift-name) then
     5931           do:
     5932               return loc-rvs-doc.shift-name.
     5933           end.
     5934           else
     5935           do:
     5936               return loc-rvs-doc.shift-name + "(" + string(loc-rvs-doc.shift-num) + ")".
     5937           end.
     5938       end.
     5939   end function.
