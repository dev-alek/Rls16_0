     1667        SIZE 10 BY 1.
     1668   DEFINE BUTTON Btn_Copy
     1669        LABEL "&Ст.Смен."
     1670        SIZE 10 BY 1 TOOLTIP "Сделать сменную сверку на основе контрольной (полной)".
     1671   DEFINE VARIABLE ed-notes AS CHARACTER
     1672        VIEW-AS EDITOR
     1673        SIZE 99 BY 2
     1674        BGCOLOR 8  NO-UNDO.
     1675   DEFINE VARIABLE f-agnt-name AS CHARACTER FORMAT "X(19)":U
     1676        LABEL "Исп"
