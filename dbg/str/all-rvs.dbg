     2238               do:
     2239                   assign
     2240                       buf-spi_trn-doc.status_ = 'разрешен':U
     2241                       buf-spi_trn-doc.flag_   = yes
     2242                       .
     2243                   run str/trn-stat.p
     2244                       ( input parparentproc
     2245                       , input this-procedure
     2246                       , input '<закрытие документа>':U
     2247                       , input buf-spi_trn-doc.doc-code
     2248                       , input ?
     2249                       , input v-cntxt-db-num
     2250                       , input ?
     2251                       , input ?
     2252                       , input ?
     2253                       , input ?
     2254                       , input yes
     2255                       , output varchg-inv
     2256                       , output table gds-list
