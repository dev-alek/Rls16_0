     1693         VIEW-AS TEXT
     1694        SIZE 19.5 BY .67 NO-UNDO.
     1695   DEFINE NEW SHARED QUERY br-r-docs for r-doc SCROLLING.
     1696   DEFINE BROWSE br-r-docs
     1697     QUERY br-r-docs DISPLAY
     1698         mark-string (recid( r-doc)) @ mark COLUMN-LABEL '*'  FORMAT "x(1)"
     1699        (substring (r-doc.rvs-type, 1, 9))  COLUMN-LABEL ' Tип '  FORMAT "x(9)"
     1700        autorvs (recid(r-doc))  COLUMN-LABEL ' '  format "x(1)"
     1701        get-input-type (recid( r-doc)) COLUMN-LABEL 'тв'  format "x(2)"
     1702        r-doc.status_  column-label 'Стат'  format "x(5)"
     1703        r-doc.rvs-code  column-label 'Документ'  format "x(12)"
     1704        (substring ((string (r-doc.doc-date)), 1, 5))  COLUMN-LABEL 'Дата'  format "x(5)"
     1705        r-doc.fact-date  COLUMN-LABEL 'Факт'
     1706        string(r-doc.fact-time,'hh:mm:ss')  COLUMN-LABEL 'Время'
     1707        r-doc.out-code  column-label 'Документ'
     1708        (substring ((string (r-doc.shift-date)), 1, 5)) column-label 'Смена' format "x(5)"
     1709        shift-name (recid(r-doc)) column-label '№' format "x(6)"
     1710        r-doc.state-measure-qnty
     1711        r-doc.measure-qnty
     1712        r-doc.state-brutto-qnty
     1713        r-doc.brutto-qnty
     1714        r-doc.system-qnty
     1715        r-doc.system-cli-qnty
     1716        r-doc.system-cli-avrg-qnty
     1717        r-doc.measure-cli-qnty format "->>,>>>,>>>,>>>.<<<"
     1718        r-doc.state-measure-cli-qnty format "->>,>>>,>>>,>>>.<<<"
     1719        r-doc.brutto-cli-qnty
     1720        r-doc.state-brutto-cli-qnty
     1721        r-doc.meas-mh-qnty format "->>,>>>,>>>,>>>.<<<"
     1722        r-doc.state-mh-qnty format "->>,>>>,>>>,>>>.<<<"
     1723        r-doc.meas-am-qnty format "->>,>>>,>>>,>>>.<<<"
     1724        r-doc.state-am-qnty format "->>,>>>,>>>,>>>.<<<"
     1725        r-doc.meas-cf-qnty
     1726        r-doc.state-cf-qnty
     1727        r-doc.level-petrol
     1728        r-doc.state-level-petrol format "->>,>>>,>>>.<<<"
     1729        r-doc.level-total
     1730        r-doc.state-level-total
     1731        r-doc.level-water
     1732        r-doc.state-level-water
     1733        ENABLE r-doc.state-level-water
     1734       WITH SEPARATORS SIZE 99 BY 16.75.
     1735   DEFINE FRAME d-all-r-docs
     1736        b-quit AT ROW 1 COL 1
     1737        b-mark AT ROW 1 COL 11
     1738        b-sel AT ROW 1 COL 14
     1739        b-add AT ROW 1 COL 24
     1740        b-lkp AT ROW 2 COL 24
     1741        b-chg AT ROW 2 COL 34
     1742        b-del AT ROW 2 COL 44
     1743        b-close AT ROW 1 COL 34
     1744        b-open AT ROW 1 COL 44
     1745        b-hist AT ROW 1 COL 89.5 WIDGET-ID 64
     1746        b-help AT ROW 1 COL 92.5
     1747        Btn_Copy AT ROW 2 COL 54
     1748        b-inv AT ROW 1 COL 74
     1749        b-sch AT ROW 2 COL 85.5
     1750        b-print AT ROW 2 COL 92.5
     1751        br-r-docs AT ROW 3 COL 1
     1752        ed-notes AT ROW 21.5 COL 1 NO-LABEL
     1753        f-boss-name AT ROW 20 COL 5 COLON-ALIGNED
     1754        f-obj-name AT ROW 20 COL 35 COLON-ALIGNED
     1755        f-agnt-name AT ROW 20.75 COL 5 COLON-ALIGNED
     1756        f-wrkr-name AT ROW 20.75 COL 35 COLON-ALIGNED
     1757        f-cre-name AT ROW 20.75 COL 65 COLON-ALIGNED
     1758        SPACE(13.50) SKIP(2.08)
     1759       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1760            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1761            TITLE "<insert dialog title>".
     1762   ASSIGN
     1763          FRAME d-all-r-docs:SCROLLABLE       = FALSE
     1764          FRAME d-all-r-docs:HIDDEN           = TRUE.
     1765   ASSIGN
     1766          br-r-docs:NUM-LOCKED-COLUMNS IN FRAME d-all-r-docs     = 4
     1767          br-r-docs:COLUMN-RESIZABLE IN FRAME d-all-r-docs       = TRUE.
     1768   ON WINDOW-CLOSE OF FRAME d-all-r-docs
     1769   DO:
     1770           APPLY "END-ERROR":U TO SELF.
     1771       END.
     1772   ON CHOOSE OF b-add IN FRAME d-all-r-docs
     1773   DO:
     1774           define buffer bf_icnt-doc for ub.icnt-doc.
     1775           define buffer bf_rvs-doc  for ub.rvs-doc.
     1776           find first bf_icnt-doc no-lock
     1777               where bf_icnt-doc.obj-type  = v-cntxt-obj-type
     1778               and bf_icnt-doc.obj-code  = v-cntxt-obj-code
     1779               and bf_icnt-doc.doc-type  = 'инв-сч-трк':U
     1780               AND bf_icnt-doc.status_  <> 'факт':U
     1781               no-error.
     1782           if available bf_icnt-doc then
     1783           do:
     1784               message
     1785                   "Имеется не закрытый документ инвентаризации счетчиков ТРК " bf_icnt-doc.doc-code " ."
     1786                   view-as alert-box error.
     1787               return no-apply.
     1788           end.
     1789           find first bf_rvs-doc no-lock
     1790               where bf_rvs-doc.obj-type =  v-cntxt-obj-type
     1791               and bf_rvs-doc.obj-code =  v-cntxt-obj-code
     1792               and bf_rvs-doc.status_  <> 'факт':U
     1793               and ( bf_rvs-doc.rvs-type = 'смена':U
     1794               or bf_rvs-doc.rvs-type = 'контроль':U
     1795               and bf_rvs-doc.is-full  = yes
     1796               )
     1797               no-error.
     1798           if available bf_rvs-doc then
     1799           do:
     1800               message
     1801                   "Имеется не закрытый документ сверки " bf_rvs-doc.rvs-code " ."
     1802                   view-as alert-box error.
     1803               return no-apply.
     1804           end.
     1805           assign
     1806               rvs-rec = ?
     1807               .
     1808           do
     1809               on stop undo, return no-apply
     1810               :
     1811               run str/rvs-add.w
     1812                   ( input parparentproc
     1813                   ,input 'ДОБАВЛЕНИЕ':U
     1814                   ,output rvs-rec
     1815                   ) no-error.
     1816               if error-status :error then
     1817               do:
     1818                   undo, return no-apply.
     1819               end.
     1820           end.
     1821           if rvs-rec = ? then
     1822           do:
     1823               return no-apply.
     1824           end.
     1825           message
     1826               "Новый документ сверки добавлен в Базу Данных."
     1827               view-as alert-box information.
     1828           run UI-on in this-procedure.
     1829       END.
     1830   ON CHOOSE OF b-chg IN FRAME d-all-r-docs
     1831   DO:
     1832           define buffer bf_trn-doc for ub.trn-doc.
     1833           if not available r-doc then do:     message       "Неправильный выбор документа сверки."       view-as alert-box .     return no-apply.   end.   else do:     assign       rvs-rec = recid (r-doc)     .   end.
     1834     if r-doc.status_ = 'факт':U
     1835       or r-doc.status_ = 'нередакт':U
     1836     then do:
     1837           message
     1838               "Данный документ сверки закрыт по факту или не может быть обработан в этом списке."
     1839               view-as alert-box.
     1840           return no-apply.
     1841       end.
     1842   find first bf_trn-doc
     1843       where bf_trn-doc.out-code = r-doc.rvs-code
     1844       no-error.
     1845   if available bf_trn-doc then
     1846   do:
     1847       message
     1848           "По сверке есть инвентаризация. Изменять сверку нельзя."
     1849           view-as alert-box.
     1850       return no-apply.
     1851   end.
     1852   assign
     1853       rvs-rec = recid( r-doc )
     1854       .
     1855   run str/rvs-doc.w
     1856       ( input        parparentproc
     1857       ,input        'ИЗМЕНЕНИЕ':U
     1858       ,input        r-doc.rvs-type
     1859       ,input        no
     1860       ,input-output rvs-rec
     1861       ) no-error.
     1862   if error-status :error then
     1863   do:
     1864       find r-doc no-lock
     1865           where recid (r-doc) = rvs-rec
     1866           .
     1867       return no-apply.
     1868   end.
     1869   apply "entry" to br-r-docs in frame d-all-r-docs.
     1870   run UI-on in this-procedure .
     1871   END.
     1872   ON CHOOSE OF b-close IN FRAME d-all-r-docs
     1873   DO:
     1874           define variable varchg-inv as logical   no-undo.
     1875           define variable v-inv-doc  as character no-undo .
     1876           if not available r-doc then do:     message       "Неправильный выбор документа сверки."       view-as alert-box .     return no-apply.   end.   else do:     assign       rvs-rec = recid (r-doc)     .   end.
     1877     if r-doc.status_ = 'факт':U
     1878       or r-doc.status_ = 'нередакт':U
     1879     then do:
     1880           message
     1881               "Данный документ сверки закрыт по факту или не может быть обработан в этом списке."
     1882               view-as alert-box.
     1883           return no-apply.
     1884       end.
     1885   if r-doc.status_ = 'новый':U then
     1886   do:
     1887       assign
     1888           varlog = no
     1889           .
     1890       message
     1891           "Вы хотите завершить редактирование документа сверки?"
     1892           view-as alert-box question buttons yes-no update varlog .
     1893       if varlog <> yes then
     1894       do:
     1895           return no-apply.
     1896       end.
     1897       tr:
     1898       do transaction
     1899           on error   undo tr, leave
     1900           on end-key undo tr, leave
     1901           on stop    undo tr, leave
     1902           :
     1903   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
     1904                         input recid(r-doc) ,
     1905                         input yes ) no-error .
     1906         if error-status :error then do:
     1907           message
     1908             "Ошибка при закрытии документа сверки." skip
     1909             error-status:get-message(1) skip
     1910             return-value
     1911             view-as alert-box error.
     1912           run userlogrvs(58, return-value + error-status:get-message(1) ) .
     1913           undo tr, leave.
     1914         end.
     1915       end.
     1916   end.
     1917   else
     1918   do:
     1919       find first buf-inv_trn-doc no-lock
     1920           where buf-inv_trn-doc.out-code = r-doc.rvs-code
     1921           no-error.
     1922       if ambiguous buf-inv_trn-doc then
     1923       do:
     1924           message
     1925               "Найдено более одного складского документа связанного со сверкой."
     1926               view-as alert-box error.
     1927           return no-apply.
     1928       end.
     1929       if available buf-inv_trn-doc then
     1930       do:
     1931           if buf-inv_trn-doc.doc-type <> 'инв':U then
     1932           do:
     1933               message
     1934                   "Документ связанный с документом сверки не яв-ся инвентаризацией."
     1935                   view-as alert-box error.
     1936               return no-apply.
     1937           end.
     1938           if buf-inv_trn-doc.status_ <> 'нередакт':U
     1939               or buf-inv_trn-doc.flag_ <> yes
     1940               then
     1941           do:
     1942               message
     1943                   substitute( "Ошибка в документе инвентаризации &1 по сверке.", buf-inv_trn-doc.doc-code ) skip
     1944                   substitute( "Связанный со сверкой документ инвентаризации не находится в статусе &1", 'нередакт':U )
     1945                   view-as alert-box error.
     1946               return no-apply.
     1947           end.
     1948           assign
     1949               varstr    = " документ инвентаризации"
     1950               v-inv-doc = buf-inv_trn-doc.doc-code
     1951               .
     1952       end.
     1953       assign
     1954           varlog = no
     1955           .
     1956       message
     1957           substitute( "Вы хотите закрыть документ сверки &1?", (if varstr <> "" then "и" else "") + varstr )
     1958           view-as alert-box question buttons yes-no update varlog.
     1959       if varlog <> yes then
     1960       do:
     1961           return no-apply.
     1962       end.
     1963       find first ub.rvs-line no-lock
     1964           where ub.rvs-line.rvs-code           = r-doc.rvs-code
     1965           and ub.rvs-line.state-measure-qnty = ?
     1966           no-error.
     1967       if available ub.rvs-line then
     1968       do:
     1969           find first ub.goods no-lock
     1970               where ub.goods.gds-code = ub.rvs-line.gds-code.
     1971           run placelib_get-attr(input "place-virtual"
     1972               ,input rvs-line.obj-code
     1973               ,input rvs-line.obj-type
     1974               ,input rvs-line.pl-code
     1975               ,output v-value
     1976               ,output v-ok) no-error.
     1977           is-vir = if (v-ok and logical(v-value)) then true else false.
     1978           if not is-gas(ub.rvs-line.gds-code) and not is-vir then
     1979           do:
     1980               message
     1981                   substitute( "Не заданы фактические остатки по товару &1 (&2)", ub.goods.gds-code, ub.goods.gds-name )
     1982                   view-as alert-box error.
     1983               return no-apply.
     1984           end.
     1985       end.
     1986       tr:
     1987       do transaction
     1988           on error   undo tr, leave
     1989           on end-key undo tr, leave
     1990           on stop    undo tr, leave
     1991           :
     1992   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
     1993                         input recid(r-doc) ,
     1994                         input yes ) no-error .
     1995           if error-status :error then
     1996           do:
     1997               message
     1998                   "Ошибка при закрытии документа сверки." skip
     1999                   error-status:get-message(1) skip
     2000                   return-value
     2001                   view-as alert-box error.
     2002               run userlogrvs(58, return-value + error-status:get-message(1) ) .
     2003               undo tr, leave.
     2004           end.
     2005           release r-doc no-error .
     2006           if error-status :error then
     2007           do:
     2008               message
     2009                   "Ошибка при закрытии документа сверки." skip
     2010                   error-status:get-message(1) skip
     2011                   return-value
     2012                   view-as alert-box error.
     2013               undo tr, leave.
     2014           end.
     2015           find first buf-inv_trn-doc exclusive-lock
     2016               where buf-inv_trn-doc.doc-code = v-inv-doc
     2017               no-error.
     2018           if available buf-inv_trn-doc then
     2019           do:
     2020               assign
     2021                   buf-inv_trn-doc.status_ = 'разрешен':U
     2022                   buf-inv_trn-doc.flag_   = yes
     2023                   .
     2024       define variable is-pos   as logical   no-undo .
     2025       define variable is-date  as logical   no-undo .
     2026       define variable is-fio   as logical   no-undo .
     2027       define variable is-check as logical   no-undo .
     2028       define variable is-mes   as character no-undo .
     2029       define buffer fio_inv-doc-attr    for ub.inv-doc-attr .
     2030       define buffer pos_inv-doc-attr    for ub.inv-doc-attr .
     2031       define buffer prikaz_inv-doc-attr for ub.inv-doc-attr .
     2032       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = v-inv-doc and
     2033         ub.inv-doc-attr.attr-code = "invTech" and
     2034         ub.inv-doc-attr.attr-value = string(true) no-error .
     2035       if not available (ub.inv-doc-attr) then
     2036       do:
     2037         if not can-find (first prikaz_inv-doc-attr no-lock where prikaz_inv-doc-attr.doc-code = v-inv-doc and
     2038           prikaz_inv-doc-attr.attr-code = 'trdcattr-prikaz-date':U and
     2039           prikaz_inv-doc-attr.attr-value <> "") then
     2040         do:
     2041           is-date = true .
     2042           is-check = true .
     2043         end.
     2044         if not can-find (first fio_inv-doc-attr no-lock where fio_inv-doc-attr.doc-code = v-inv-doc and
     2045           (fio_inv-doc-attr.attr-code = 'trdcattr-fio-agent':U or
     2046           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player1':U or
     2047           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player2':U or
     2048           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player3':U) and
     2049           fio_inv-doc-attr.attr-value <> "") then
     2050         do:
     2051           is-fio = true .
     2052           is-check = true .
     2053         end.
     2054         if not can-find (first fio_inv-doc-attr no-lock where fio_inv-doc-attr.doc-code = v-inv-doc and
     2055           (fio_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U or
     2056           fio_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U or
     2057           fio_inv-doc-attr.attr-code = 'trdcattr-pos-player2':U or
     2058           fio_inv-doc-attr.attr-code = 'trdcattr-pos-player3':U) and
     2059           fio_inv-doc-attr.attr-value <> "")then
     2060         do:
     2061           is-pos = true .
     2062           is-check = true .
     2063         end.
     2064         if is-check then
     2065         do:
     2066           is-mes = "Ошибка при закрытии документа инвентаризации." .
     2067           if is-date then
     2068           do:
     2069             is-mes = is-mes + chr(10) + "Не указана дата приказа." .
     2070           end.
     2071           if is-fio then
     2072           do:
     2073             is-mes = is-mes + chr(10) + "Не указано ФИО." .
     2074           end.
     2075           if is-pos then
     2076           do:
     2077             is-mes = is-mes + chr(10) + "Не указана должность." .
     2078           end.
     2079         end.
     2080         find first fio_inv-doc-attr no-lock where
     2081           fio_inv-doc-attr.doc-code = v-inv-doc and
     2082           fio_inv-doc-attr.attr-code = 'trdcattr-fio-agent':U and
     2083           fio_inv-doc-attr.attr-value <> "" no-error .
     2084         if not available (fio_inv-doc-attr) then
     2085         do:
     2086           find first pos_inv-doc-attr no-lock where
     2087             pos_inv-doc-attr.doc-code = v-inv-doc and
     2088             pos_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U and
     2089             pos_inv-doc-attr.attr-value <> "" no-error .
     2090           if available (pos_inv-doc-attr) then
     2091           do:
     2092             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2093             is-mes = is-mes + "Не заполнена ФИО председателя комиссии." + chr(10).
     2094           end.
     2095         end.
     2096         else
     2097         do:
     2098           find first pos_inv-doc-attr no-lock where
     2099             pos_inv-doc-attr.doc-code = v-inv-doc and
     2100             pos_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U and
     2101             pos_inv-doc-attr.attr-value <> "" no-error .
     2102           if not available (pos_inv-doc-attr) then
     2103           do:
     2104             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2105             is-mes = is-mes + "Не заполнена должность председателя комиссии." + chr(10).
     2106           end.
     2107         end.
     2108         find first fio_inv-doc-attr no-lock where
     2109           fio_inv-doc-attr.doc-code = v-inv-doc and
     2110           fio_inv-doc-attr.attr-code = 'trdcattr-fio-player1':U and
     2111           fio_inv-doc-attr.attr-value <> "" no-error .
     2112         if not available (fio_inv-doc-attr) then
     2113         do:
     2114           find first pos_inv-doc-attr no-lock where
     2115             pos_inv-doc-attr.doc-code = v-inv-doc and
     2116             pos_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U and
     2117             pos_inv-doc-attr.attr-value <> "" no-error .
     2118           if available (pos_inv-doc-attr) then
     2119           do:
     2120             if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     2121             is-mes = is-mes + "Не заполнена ФИО первого участника комиссии." + chr(10).
     2122           end.
     2123         end.
     2124         else
