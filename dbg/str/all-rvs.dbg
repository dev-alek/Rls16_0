     3920   procedure diasize_end-move :
     3921     do
     3922     on error undo, return error return-value
     3923     :
     3924       define variable v-row-delta as decimal   no-undo .
     3925       define variable v-col-delta as decimal   no-undo .
     3926       define variable v-new-row as decimal   no-undo .
     3927       define variable v-new-col as decimal   no-undo .
     3928       assign
     3929         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3930         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3931       .
     3932       assign
     3933         v-row-delta = v-new-row - frame d-all-r-docs :height
     3934         v-col-delta = v-new-col - frame d-all-r-docs :width
     3935       .
     3936       run diasize_change-height in this-procedure
     3937         (input v-row-delta
     3938         ,input true
     3939         ) .
     3940       run diasize_change-width in this-procedure
     3941         (input v-col-delta
     3942         ,input true
     3943         ) .
     3944     end.
     3945   end procedure.
     3946   procedure diasize_maximize :
     3947     define input  parameter p-action as logical   no-undo .
     3948     do
     3949     on error undo, return error return-value
     3950     :
     3951       if p-action = ?
     3952       then do:
     3953         if v-diasize-need-maximize = true
     3954         then do:
     3955           assign
     3956             p-action = true
     3957           .
     3958         end.
     3959         else do:
     3960           assign
     3961             p-action = false
     3962           .
     3963         end.
     3964       end.
     3965       if p-action = true
     3966       then do:
     3967         run diasize_change-height in this-procedure
     3968           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3969               - frame d-all-r-docs :height-chars
     3970           ,input true
     3971           ) .
     3972         run diasize_change-width in this-procedure
     3973           (input session :width-chars
     3974               - frame d-all-r-docs :width-chars
     3975           ,input true
     3976           ) .
     3977         assign
     3978           v-diasize-need-maximize = false
     3979         .
     3980       end.
     3981       else do:
     3982         run diasize_change-width in this-procedure
     3983           (input v-diasize-orig-frame-width
     3984               - frame d-all-r-docs :width-chars
     3985           ,input true
     3986           ) .
     3987         run diasize_change-height in this-procedure
     3988           (input v-diasize-orig-frame-height
     3989               - frame d-all-r-docs :height-chars
     3990           ,input true
     3991           ) .
     3992         assign
     3993           v-diasize-need-maximize = true
     3994         .
     3995       end.
     3996     end.
     3997   end procedure.
     3998   procedure diasize_restore-orig-size :
     3999     do
     4000     on error undo, return error return-value
     4001     :
     4002       assign
     4003         v-diasize-current-frame-width  = frame d-all-r-docs :width
     4004         v-diasize-current-frame-height = frame d-all-r-docs :height
     4005       .
     4006       run diasize_set-height in this-procedure
     4007         (input  v-diasize-orig-frame-height
     4008         ,input  true
     4009         ) .
     4010       run diasize_set-width in this-procedure
     4011         (input  v-diasize-orig-frame-width
     4012         ,input  true
     4013         ) .
     4014     end.
     4015   end procedure.
     4016   procedure diasize_restore-current-size :
     4017     do
     4018     on error undo, return error return-value
     4019     :
     4020       run diasize_set-height in this-procedure
     4021         (input  v-diasize-current-frame-height
     4022         ,input  true
     4023         ) .
     4024       run diasize_set-width in this-procedure
     4025         (input  v-diasize-current-frame-width
     4026         ,input  true
     4027         ) .
     4028     end.
     4029   end procedure.
     4030   procedure diasize_set-browse-handle :
     4031     define input  parameter p-browse-handle as handle   no-undo .
     4032     define buffer buf_temp-browse-handle for temp-browse-handle .
     4033     do
     4034     on error undo, return error return-value
     4035     :
     4036       assign
     4037         v-diasize-browse-handle = p-browse-handle
     4038       .
     4039       for each buf_temp-browse-handle
     4040       on error undo, return error return-value
     4041       :
     4042         delete buf_temp-browse-handle .
     4043       end.
     4044     end.
     4045   end procedure.
     4046   procedure diasize_add_browse :
     4047     define input  parameter p-browse-type   as character no-undo .
     4048     define input  parameter p-browse-handle as handle    no-undo .
     4049     define buffer buf_temp-browse-handle for temp-browse-handle .
     4050     do
     4051     on error undo, return error return-value
     4052     :
     4053       assign
     4054         v-diasize-browse-number = v-diasize-browse-number + 1
     4055       .
     4056       create buf_temp-browse-handle .
     4057       assign
     4058         buf_temp-browse-handle.browse-type   = p-browse-type
     4059         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4060         buf_temp-browse-handle.browse-handle = p-browse-handle
     4061       .
     4062     end.
     4063   end procedure.
     4064   procedure diasize_init :
     4065     define variable v-default-value    as logical   no-undo .
     4066     define variable v-restore-saved    as logical   no-undo .
     4067     define variable v-resize-value-str as character no-undo .
     4068     do
     4069     on error undo, return error return-value
     4070     :
     4071       do with frame d-all-r-docs
     4072       :
     4073         assign
     4074           v-diasize-orig-frame-height = frame d-all-r-docs :height
     4075           v-diasize-orig-frame-width  = frame d-all-r-docs :width
     4076           v-diasize-browse-handle     = browse br-r-docs :handle
     4077         .
     4078         create button v-diasize-resize-button
     4079         assign
     4080           parent        = frame d-all-r-docs :first-child
     4081           label         = "s"
     4082           height-pixels = 16
     4083           width-pixels  = 16
     4084           visible       = true
     4085           sensitive     = true
     4086           movable       = true
     4087           triggers:
     4088             on end-move persistent run diasize_end-move in this-procedure .
     4089           end triggers.
     4090         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4091         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4092         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4093         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4094         assign
     4095           v-diasize-wndmax = false
     4096         .
     4097         if connected("ub") = true
     4098         then do:
     4099           define variable v-cntxt-db-num        as integer   no-undo .
     4100           define variable v-cntxt-userid        as character no-undo .
     4101           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4102                                             , OUTPUT v-cntxt-userid
     4103                                             ) .
     4104           run gbl/wndpar_r.p
     4105             (input  v-cntxt-db-num
     4106             ,input  v-cntxt-userid
     4107             ,input  'wndmax':U
     4108             ,output v-diasize-wndmax
     4109             ,output v-default-value
     4110             ) .
     4111         end.
     4112         assign
     4113           v-diasize-wndstore = false
     4114         .
     4115         if connected("ub") = true
     4116         then do:
     4117           run gbl/wndpar_r.p
     4118             (input  v-cntxt-db-num
     4119             ,input  v-cntxt-userid
     4120             ,input  'wndstore':U
     4121             ,output v-diasize-wndstore
     4122             ,output v-default-value
     4123             ) .
     4124         end.
     4125         assign
     4126           v-diasize-proc-name = entry(1, program-name(2), '.')
     4127         .
     4128         if v-diasize-wndstore = true
     4129         then do:
     4130           assign
     4131             v-restore-saved = false
     4132           .
     4133           if connected("ub") = true
     4134           then do:
     4135             run gbl/wndsizer.p
     4136               (input  v-cntxt-db-num
     4137               ,input  v-cntxt-userid
     4138               ,input  v-diasize-proc-name
     4139               ,input  'height':u
     4140               ,output v-resize-value-str
     4141               ) .
     4142             if v-resize-value-str <> '':U
     4143             then do:
     4144               run diasize_change-height in this-procedure
     4145                 (input  integer(v-resize-value-str)
     4146                 ,input  true
     4147                 ) .
     4148               assign
     4149                 v-restore-saved = true
     4150               .
     4151             end.
     4152           end.
     4153           if connected("ub") = true
     4154           then do:
     4155             run gbl/wndsizer.p
     4156               (input  v-cntxt-db-num
     4157               ,input  v-cntxt-userid
     4158               ,input  v-diasize-proc-name
     4159               ,input  'width':u
     4160               ,output v-resize-value-str
     4161               ) .
     4162             if v-resize-value-str <> '':U
     4163             then do:
     4164               run diasize_change-width in this-procedure
     4165                 (input  integer(v-resize-value-str)
     4166                 ,input  true
     4167                 ) .
     4168               assign
     4169                 v-restore-saved = true
     4170               .
     4171             end.
     4172           end.
     4173           if v-restore-saved <> true
     4174           then do:
     4175             if v-diasize-wndmax = true
     4176             then do:
     4177               run diasize_maximize in this-procedure
     4178                 (input  true
     4179                 ) .
     4180             end.
     4181           end.
     4182         end.
     4183         else do:
     4184           if v-diasize-wndmax = true
     4185           then do:
     4186             run diasize_maximize in this-procedure
     4187               (input  true
     4188               ) .
     4189           end.
     4190         end.
     4191       end.
     4192     end.
     4193   end procedure.
     4194   procedure diasize_need-full-display :
     4195     define output parameter p-need-full-display as logical   no-undo .
     4196     do
     4197     on error undo, return error return-value
     4198     :
     4199       assign
     4200         p-need-full-display = v-diasize-need-full-display
     4201       .
     4202       assign
     4203         v-diasize-need-full-display = false
     4204       .
     4205     end.
     4206   end procedure.
     4207   procedure get-context :
     4208      define output parameter p-db-num as integer          no-undo.
     4209      define output parameter p-user-id as character        no-undo.
     4210      define variable v-login               as character    no-undo.
     4211      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4212      define buffer buf_user-login  for ub.user-login .
     4213      do
     4214      on error undo, return error
     4215      :
     4216            FIND FIRST buf_sys-ctrl no-lock.
     4217            ASSIGN
     4218               v-login = USERID("ub")
     4219               p-db-num = buf_sys-ctrl.db-num
     4220            .
     4221            FIND FIRST buf_user-login
     4222                 WHERE buf_user-login.db-num = p-db-num
     4223                   AND buf_user-login.user-login = v-login
     4224                 no-lock
     4225                 no-error
     4226                 .
     4227            IF AVAILABLE buf_user-login
     4228            THEN DO:
     4229               assign
     4230                  p-user-id = buf_user-login.user-id
     4231               .
     4232            END.
     4233      end.
     4234   end procedure.
     4235       run diasize_init in this-procedure .
     4236   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4237   on CTRL-P, CTRL-З of frame d-all-r-docs anywhere do:
     4238     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-all-r-docs. END.
     4239     return no-apply.
     4240   end.
     4241   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4242   on F3 of frame d-all-r-docs anywhere do:
     4243     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-all-r-docs. END.
     4244     return no-apply.
     4245   end.
     4246   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4247   on CTRL-N, CTRL-Т of frame d-all-r-docs anywhere do:
     4248     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-all-r-docs. END.
     4249     return no-apply.
     4250   end.
     4251   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4252   on F4 of frame d-all-r-docs anywhere do:
     4253     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-all-r-docs. END.
     4254     return no-apply.
     4255   end.
     4256   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4257   on CTRL-F7 of frame d-all-r-docs anywhere do:
     4258     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame d-all-r-docs. END.
     4259     return no-apply.
     4260   end.
     4261   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4262   on CTRL-F8 of frame d-all-r-docs anywhere do:
     4263     if b-open :sensitive then DO: apply "CHOOSE":U to b-open in frame d-all-r-docs. END.
     4264     return no-apply.
     4265   end.
     4266   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4267   on F8 of frame d-all-r-docs anywhere do:
     4268     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-all-r-docs. END.
     4269     return no-apply.
     4270   end.
     4271   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4272   on INS of frame d-all-r-docs anywhere do:
     4273     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-all-r-docs. END.
     4274     return no-apply.
     4275   end.
     4276   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4277   procedure set-filter-name :
     4278   define input parameter p-filter-name as character no-undo .
     4279     do with frame d-all-r-docs:
     4280       if p-filter-name > "" then do:
     4281         assign
     4282           frame d-all-r-docs:title
     4283             = frame d-all-r-docs:title + "   ФИЛЬТР: " + p-filter-name.
     4284         .
     4285         assign
     4286           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     4287         .
     4288       end.
     4289       else do:
     4290         assign
     4291           b-sch :tooltip = ""
     4292         .
     4293       end.
     4294     end.
     4295   end procedure.
     4296   def var sort-labelbr-r-docs   as character no-undo .
     4297   def var sort-clmnbr-r-docs    as handle    no-undo .
     4298   def var cur-clmnbr-r-docs     as handle    no-undo .
     4299   def var cur-clmn-locbr-r-docs as integer   no-undo .
     4300   def var re-querybr-r-docs     as logical   initial no no-undo .
     4301   on start-search, ctrl-o of br-r-docs in frame d-all-r-docs do:
     4302      run sort-brbr-r-docs
     4303        (input (if available r-doc
     4304                then recid(r-doc)
     4305                else ?
     4306               )
     4307        ).
     4308   end.
     4309   PROCEDURE sort-brbr-r-docs :
     4310     define input parameter p-recid as recid no-undo .
     4311     if re-querybr-r-docs = no then do:
     4312       assign
     4313          cur-clmnbr-r-docs = br-r-docs:current-column in frame d-all-r-docs
     4314       .
     4315       if sort-clmnbr-r-docs <> ? then sort-clmnbr-r-docs:column-fgcolor = 0.
     4316       if cur-clmnbr-r-docs = sort-clmnbr-r-docs then do:
     4317         assign
     4318            sort-labelbr-r-docs = ""
     4319            sort-clmnbr-r-docs = ?
     4320         .
     4321        end.
     4322        else do:
     4323          assign
     4324            sort-labelbr-r-docs = cur-clmnbr-r-docs:label
     4325            sort-clmnbr-r-docs  = cur-clmnbr-r-docs
     4326            sort-clmnbr-r-docs:column-fgcolor = 4
     4327          .
     4328        end.
     4329      end.
     4330     assign
     4331       cur-clmn-locbr-r-docs = 1
     4332     .
     4333     def var column-handle as handle no-undo .
     4334     column-handle = br-r-docs:first-column.
     4335     do while valid-handle(column-handle) :
     4336       if column-handle = cur-clmnbr-r-docs then do:
     4337         leave .
     4338       end.
     4339       column-handle = column-handle:NEXT-COLUMN.
     4340       assign
     4341         cur-clmn-locbr-r-docs = cur-clmn-locbr-r-docs + 1
     4342       .
     4343     end.
     4344     case sort-labelbr-r-docs:
     4345           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(r-doc)) ', chr(34) )     .     run OpenBr   . END.
     4346           when ' Tип '  then DO:    assign       sort-column-name = "(substring (r-doc.rvs-type, 1, 9))"     .     run OpenBr   . END.
     4347           when ' '  then DO:   assign       sort-column-name = substitute('dynamic-function(&1autorvs&1, recid(r-doc)) ', chr(34) )     .     run OpenBr   . END.
     4348           when 'Стат'  then DO:    assign       sort-column-name = "r-doc.status_"     .     run OpenBr   . END.
     4349           when 'Документ'  then DO:    assign       sort-column-name = "r-doc.rvs-code"     .     run OpenBr   . END.
     4350           when 'Дата'  then DO:    assign       sort-column-name = "(substring ((string (r-doc.doc-date)), 1, 5))"     .     run OpenBr   . END.
     4351           when 'Факт'  then DO:    assign       sort-column-name = "r-doc.fact-date"     .     run OpenBr   . END.
     4352           when 'Время'  then DO:    assign       sort-column-name = "string(r-doc.fact-time,'hh:mm:ss')"     .     run OpenBr   . END.
     4353           when 'Документ'  then DO:    assign       sort-column-name = "r-doc.out-code"     .     run OpenBr   . END.
     4354           when 'Смена'  then DO:    assign       sort-column-name = "(substring ((string (r-doc.shift-date)), 1, 5))"     .     run OpenBr   . END.
     4355           when '№'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-name&1, recid( r-doc)) ', chr(34) )     .     run OpenBr   . END.
     4356           when r-doc.state-measure-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-measure-qnty"     .     run OpenBr   . END.
     4357           when r-doc.measure-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.measure-qnty"     .     run OpenBr   . END.
     4358           when r-doc.state-brutto-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-brutto-qnty"     .     run OpenBr   . END.
     4359           when r-doc.brutto-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.brutto-qnty"     .     run OpenBr   . END.
     4360           when r-doc.system-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.system-qnty"     .     run OpenBr   . END.
     4361           when r-doc.system-cli-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.system-cli-qnty"     .     run OpenBr   . END.
     4362           when r-doc.system-cli-avrg-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.system-cli-avrg-qnty"     .     run OpenBr   . END.
     4363           when r-doc.measure-cli-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.measure-cli-qnty"     .     run OpenBr   . END.
     4364           when r-doc.state-measure-cli-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-measure-cli-qnty"     .     run OpenBr   . END.
     4365           when r-doc.brutto-cli-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.brutto-cli-qnty"     .     run OpenBr   . END.
     4366           when r-doc.state-brutto-cli-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-brutto-cli-qnty"     .     run OpenBr   . END.
     4367           when r-doc.meas-mh-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.meas-mh-qnty"     .     run OpenBr   . END.
     4368           when r-doc.state-mh-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-mh-qnty"     .     run OpenBr   . END.
     4369           when r-doc.meas-am-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.meas-am-qnty"     .     run OpenBr   . END.
     4370           when r-doc.state-am-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-am-qnty"     .     run OpenBr   . END.
     4371           when r-doc.meas-cf-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.meas-cf-qnty"     .     run OpenBr   . END.
     4372           when r-doc.state-cf-qnty:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-cf-qnty"     .     run OpenBr   . END.
     4373           when r-doc.level-petrol:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.level-petrol"     .     run OpenBr   . END.
     4374           when r-doc.state-level-petrol:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-level-petrol"     .     run OpenBr   . END.
     4375           when r-doc.level-total:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.level-total"     .     run OpenBr   . END.
     4376           when r-doc.state-level-total:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-level-total"     .     run OpenBr   . END.
     4377           when r-doc.level-water:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.level-water"     .     run OpenBr   . END.
     4378           when r-doc.state-level-water:label in browse br-r-docs then DO:    assign       sort-column-name = "r-doc.state-level-water"     .     run OpenBr   . END.
     4379           when 'тв'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-input-type&1, recid(r-doc)) ', chr(34) )     .     run OpenBr   . END.
     4380       otherwise do:
     4381         assign
     4382           sort-column-name = ""
     4383         .
     4384         run OpenBr.
     4385           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-r-docs') then do:
     4386             run mv-brw-defaultbr-r-docs.
     4387           end.
     4388         if sort-labelbr-r-docs <> "" then do:
     4389           assign
     4390             cur-clmnbr-r-docs:column-fgcolor = 0
     4391           .
     4392         end.
     4393         assign
     4394           cur-clmn-locbr-r-docs = ?
     4395         .
     4396       end.
     4397     end case.
     4398       if cur-clmn-locbr-r-docs <> ? then do:
     4399         if can-do( this-procedure:internal-entries, 'ch-clmnbr-r-docs') then do:
     4400           run ch-clmnbr-r-docs in this-procedure (cur-clmn-locbr-r-docs).
     4401         end.
     4402       end.
     4403     if p-recid <> ? then do:
     4404       reposition br-r-docs to recid p-recid no-error.
     4405       apply "value-changed" to br-r-docs in frame d-all-r-docs.
     4406     end.
     4407     apply "entry" to br-r-docs in frame d-all-r-docs.
     4408   END PROCEDURE.
     4409   procedure re-open-query-srt-clmnbr-r-docs:
     4410   if cur-clmnbr-r-docs = ? then do:
     4411      run OpenBr.
     4412   end.
     4413   else do:
     4414      assign re-querybr-r-docs = yes.
     4415      run sort-brbr-r-docs
     4416        (input (if available r-doc
     4417                then recid(r-doc)
     4418                else ?
     4419               )
     4420        ).
     4421      assign re-querybr-r-docs = no.
     4422   end.
     4423   end.
     4424   MAIN-BLOCK:
     4425   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4426       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4427   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4428   DEF VAR cur-clmn-numbr-r-docs as INT EXTENT 34 no-undo.
     4429   DEF VAR varmvibr-r-docs       as INT no-undo.
     4430   DEF VAR varmvjbr-r-docs       as INT no-undo.
     4431   DEF VAR varmvkbr-r-docs       as INT no-undo.
     4432   DEF VAR varmvlbr-r-docs       as INT no-undo.
     4433   DEF VAR move-elementbr-r-docs as INT no-undo.
     4434   def var jjbr-r-docs           as int no-undo.
     4435   do varmvibr-r-docs = 1 to EXTENT(cur-clmn-numbr-r-docs):
     4436     ASSIGN cur-clmn-numbr-r-docs[varmvibr-r-docs] = varmvibr-r-docs.
     4437   END.
     4438   RUN start-mv-clmnbr-r-docs.
     4439   PROCEDURE start-mv-clmnbr-r-docs:
     4440   def var old-session as logical no-undo.
     4441      old-session = SESSION:IMMEDIATE-DISPLAY.
     4442      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4443      SESSION:IMMEDIATE-DISPLAY = old-session.
     4444   END.
     4445   ON ctrl-cursor-right OF BROWSE br-r-docs do:
     4446     RUN re-move-clmnbr-r-docs ( 4, 34).
     4447   END.
     4448   ON ctrl-cursor-left OF BROWSE br-r-docs do:
     4449     RUN re-move-clmnbr-r-docs (34, 4).
     4450   END.
     4451   PROCEDURE re-move-clmnbr-r-docs:
     4452     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4453     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4454     DO varmvibr-r-docs = 1 TO EXTENT(cur-clmn-numbr-r-docs):
     4455       if cur-clmn-numbr-r-docs[varmvibr-r-docs] = source-column THEN cur-clmn-numbr-r-docs[varmvibr-r-docs] = -1.
     4456     END.
     4457     if br-r-docs:MOVE-COLUMN(source-column, target-column) IN FRAME d-all-r-docs then.
     4458     if source-column > target-column THEN
     4459     DO varmvjbr-r-docs = source-column - 1 to target-column BY -1:
     4460       DO varmvibr-r-docs = 1 TO EXTENT(cur-clmn-numbr-r-docs):
     4461           if cur-clmn-numbr-r-docs[varmvibr-r-docs] = varmvjbr-r-docs THEN DO:
     4462             cur-clmn-numbr-r-docs[varmvibr-r-docs] = cur-clmn-numbr-r-docs[varmvibr-r-docs] + 1.
     4463           END.
     4464       END.
     4465     END.
     4466     ELSE
     4467     DO varmvjbr-r-docs = source-column + 1 to target-column:
     4468       DO varmvibr-r-docs = 1 TO EXTENT(cur-clmn-numbr-r-docs):
     4469         if cur-clmn-numbr-r-docs[varmvibr-r-docs] = varmvjbr-r-docs THEN DO:
     4470           cur-clmn-numbr-r-docs[varmvibr-r-docs] = cur-clmn-numbr-r-docs[varmvibr-r-docs] - 1.
     4471         END.
     4472       END.
     4473     END.
     4474     DO varmvibr-r-docs = 1 TO EXTENT(cur-clmn-numbr-r-docs):
     4475       if cur-clmn-numbr-r-docs[varmvibr-r-docs] = -1 THEN cur-clmn-numbr-r-docs[varmvibr-r-docs] = target-column.
     4476     END.
     4477   END PROCEDURE.
     4478   PROCEDURE ch-clmnbr-r-docs:
     4479     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4480     if cur-clmn-loc <= 4 then do:
     4481       return .
     4482     end.
     4483     DO varmvibr-r-docs = 1 TO EXTENT(cur-clmn-numbr-r-docs):
     4484       if cur-clmn-numbr-r-docs[varmvibr-r-docs] = cur-clmn-loc THEN move-elementbr-r-docs = varmvibr-r-docs.
     4485     END.
     4486     RUN re-move-clmnbr-r-docs (cur-clmn-loc, 4).
     4487   END PROCEDURE.
     4488   PROCEDURE mv-brw-defaultbr-r-docs:
     4489   def var old-session as logical no-undo.
     4490     old-session = SESSION:IMMEDIATE-DISPLAY.
     4491     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4492     do varmvlbr-r-docs = 4 to EXTENT(cur-clmn-numbr-r-docs):
     4493       RUN re-move-clmnbr-r-docs (cur-clmn-numbr-r-docs[varmvlbr-r-docs], varmvlbr-r-docs).
     4494     END.
     4495     RUN start-mv-clmnbr-r-docs.
     4496     SESSION:IMMEDIATE-DISPLAY = old-session.
     4497   END PROCEDURE.
     4498   .
     4499       do ii = 1 to 34:
     4500           bcol[ii] = br-r-docs:get-browse-column(ii).
     4501       end.
     4502       assign
     4503           filter-point = "all-rvs":U
     4504           .
     4505       run UI-on in this-procedure .
     4506       WAIT-FOR GO OF FRAME d-all-r-docs focus br-r-docs.
     4507   END.
     4508   RUN disable_UI in this-procedure .
     4509   PROCEDURE delete-doc-inv :
     4510   define input parameter pardoc-rec as recid no-undo.
     4511       do
     4512           on error  undo, return error substitute( "&1 (delete-doc-inv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4513           on stop   undo, return error substitute( "&1 (delete-doc-inv). stop", vss-workfile )
     4514           on endkey undo, return error substitute( "&1 (delete-doc-inv). endkey", vss-workfile )
     4515           :
     4516           define variable varchg-inv    as logical   no-undo.
     4517           define variable v-docs-list   as character no-undo .
     4518           define variable v-ind         as integer   no-undo .
     4519           define variable v-num-entries as integer   no-undo .
     4520           define variable v-doc-code    as character no-undo .
     4521           define variable v-chip-num    as integer   no-undo .
     4522           define variable v-user-action as character no-undo .
     4523           define variable v-printed     as logical   no-undo .
     4524           define buffer buf_parts       for ub.parts .
     4525           define buffer buf-inv_trn-doc for ub.trn-doc .
     4526           define buffer buf-add_trn-doc for ub.trn-doc .
     4527           find first buf-inv_trn-doc exclusive-lock
     4528               where recid( buf-inv_trn-doc ) = pardoc-rec
     4529               .
     4530           assign
     4531               v-docs-list = buf-inv_trn-doc.doc-code
     4532               .
     4533           for each buf-add_trn-doc
     4534               where buf-add_trn-doc.out-code = buf-inv_trn-doc.doc-code
     4535               on error undo, return error return-value
     4536               :
     4537               assign
     4538                   v-docs-list = buf-add_trn-doc.doc-code + ",":U + v-docs-list
     4539                   .
     4540           end.
     4541           assign
     4542               v-num-entries = num-entries( v-docs-list )
     4543               .
     4544           do v-ind = 1 to v-num-entries
     4545               on error undo, return error return-value
     4546               :
     4547               assign
     4548                   v-doc-code = entry( v-ind, v-docs-list )
     4549                   .
     4550               find first buf-add_trn-doc exclusive-lock
     4551                   where buf-add_trn-doc.doc-code = v-doc-code
     4552                   .
     4553               assign
     4554                   buf-add_trn-doc.status_ = 'разрешен':U
     4555                   buf-add_trn-doc.flag_   = yes
     4556                   .
     4557               run str/trn-stat.p
     4558                   ( input parparentproc
     4559                   , input this-procedure
     4560                   ,input '<открытие документа>':U
     4561                   ,input buf-add_trn-doc.doc-code
     4562                   ,input ?
     4563                   ,input v-cntxt-db-num
     4564                   ,input ?
     4565                   ,input ?
     4566                   ,input ?
     4567                   ,input ?
     4568                   ,input yes
     4569                   ,output varchg-inv
     4570                   ,output table gds-list
     4571                   ) no-error.
     4572               if error-status :error then
     4573               do:
     4574                   undo, return error return-value.
     4575               end.
     4576               release buf-add_trn-doc.
     4577               find first buf-add_trn-doc exclusive-lock
     4578                   where buf-add_trn-doc.doc-code = v-doc-code
     4579                   .
     4580               run str/trn-stat.p
     4581                   ( input parparentproc
     4582                   , input this-procedure
     4583                   ,input '<открытие документа>':U
     4584                   ,input buf-add_trn-doc.doc-code
     4585                   ,input ?
     4586                   ,input v-cntxt-db-num
     4587                   ,input ?
     4588                   ,input ?
     4589                   ,input ?
     4590                   ,input ?
     4591                   ,input yes
     4592                   ,output varchg-inv
     4593                   ,output table gds-list
     4594                   ) no-error.
     4595               if error-status :error then
     4596               do:
     4597                   undo, return error return-value.
     4598               end.
     4599               case buf-add_trn-doc.doc-type :
     4600                   when 'при':U then
     4601                       do:
     4602   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4603   do:
     4604     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4605       (input  v-cntxt-db-num
     4606       ,input  v-cntxt-userid
     4607       ,input  0
     4608       ,input  'actn_income_preparation':U
     4609       ,input  'object':U
     4610       ,input  buf-add_trn-doc.host-code
     4611       ,input  buf-add_trn-doc.obj-type
     4612       ,input  buf-add_trn-doc.obj-code
     4613       ,input  0
     4614       ,input  0
     4615       ,input  0
     4616       ,input  true
     4617       ,output varlog
     4618       )  .
     4619   end.
     4620                       end.
     4621                   when 'рас':U then
     4622                       do:
     4623   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4624   do:
     4625     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4626       (input  v-cntxt-db-num
     4627       ,input  v-cntxt-userid
     4628       ,input  0
     4629       ,input  'actn_expense_preparation':U
     4630       ,input  'object':U
     4631       ,input  buf-add_trn-doc.host-code
     4632       ,input  buf-add_trn-doc.obj-type
     4633       ,input  buf-add_trn-doc.obj-code
     4634       ,input  0
     4635       ,input  0
     4636       ,input  0
     4637       ,input  true
     4638       ,output varlog
     4639       )  .
     4640   end.
     4641                       end.
     4642                   when 'спи':U then
     4643                       do:
     4644   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4645   do:
     4646     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4647       (input  v-cntxt-db-num
     4648       ,input  v-cntxt-userid
     4649       ,input  0
     4650       ,input  'actn_write-off_preparation':U
     4651       ,input  'object':U
     4652       ,input  buf-add_trn-doc.host-code
     4653       ,input  buf-add_trn-doc.obj-type
     4654       ,input  buf-add_trn-doc.obj-code
     4655       ,input  0
     4656       ,input  0
     4657       ,input  0
     4658       ,input  true
     4659       ,output varlog
     4660       )  .
     4661   end.
     4662                       end.
     4663                   when 'инв':U then
     4664                       do:
     4665   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4666   do:
     4667     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4668       (input  v-cntxt-db-num
     4669       ,input  v-cntxt-userid
     4670       ,input  0
     4671       ,input  'actn_inventory_delete':U
     4672       ,input  'object':U
     4673       ,input  buf-add_trn-doc.host-code
     4674       ,input  buf-add_trn-doc.obj-type
     4675       ,input  buf-add_trn-doc.obj-code
     4676       ,input  0
     4677       ,input  0
     4678       ,input  0
     4679       ,input  true
     4680       ,output varlog
     4681       )  .
     4682   end.
     4683                       end.
     4684                   when 'возврат':U then
     4685                       do:
     4686   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4687   do:
     4688     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4689       (input  v-cntxt-db-num
     4690       ,input  v-cntxt-userid
     4691       ,input  0
     4692       ,input  'actn_return_preparation':U
     4693       ,input  'object':U
     4694       ,input  buf-add_trn-doc.host-code
     4695       ,input  buf-add_trn-doc.obj-type
     4696       ,input  buf-add_trn-doc.obj-code
     4697       ,input  0
     4698       ,input  0
     4699       ,input  0
     4700       ,input  true
     4701       ,output varlog
     4702       )  .
     4703   end.
     4704                       end.
     4705                   otherwise
     4706                   do:
     4707                       message
     4708                           vss-workfile vss-revision vss-description skip
     4709                           "Неизвестный тип документа" skip
     4710                           "Тип документа" buf-add_trn-doc.doc-type skip
     4711                           "Код документа" buf-add_trn-doc.doc-code skip
     4712                           view-as alert-box error .
     4713                       undo, return no-apply .
     4714                   end.
     4715               end case .
     4716               if varlog <> yes
     4717                   then
     4718               do:
     4719                   undo, return error.
     4720               end.
     4721               run waitfram-show in this-procedure ( input "Удаление документа № " + buf-add_trn-doc.doc-code + ". Ждите..." ).
     4722               if search ("del-doc.err") <> ? then
     4723               do:
     4724                   os-delete "del-doc.err".
     4725               end.
     4726               run str/del-doc.p
     4727                   ( input  parparentproc
     4728                   , input  buf-add_trn-doc.doc-code
     4729                   , input  v-cntxt-db-num
     4730                   , input  "del-doc.err":U
     4731                   , input  ?
     4732                   , input  ?
     4733                   , input  v-cntxt-userid
     4734                   , input  0
     4735                   , input  ?
     4736                   , output v-chip-num
     4737                   ) no-error.
     4738               if error-status:error then
     4739               do:
     4740                   run waitfram-hide in this-procedure .
     4741                   message
     4742                       vss-workfile vss-revision vss-description skip
     4743                       "Ошибка при удалении документа." skip
     4744                       return-value
     4745                       view-as alert-box error.
     4746                   if search ("del-doc.err") <> ? then
     4747                   do:
     4748                       run gbl/prnfilen.w
     4749                           (input  "Ошибки при удалении документа"
     4750                           ,input  0
     4751                           ,input  "del-doc.err"
     4752                           ,input  7
     4753                           ,output v-user-action
     4754                           ,output v-printed
     4755                           ).
     4756                   end.
     4757                   undo, return error.
     4758               end.
     4759               rvsinvstrObj = new rvsinvstr ().
     4760               rvsinvstrObj:DeleteDB(r-doc.rvs-code, r-doc.obj-type, r-doc.obj-code).
     4761               run waitfram-hide in this-procedure .
     4762           end.
     4763       end.
     4764   end procedure.
     4765   PROCEDURE disable_UI :
     4766     HIDE FRAME d-all-r-docs.
     4767   END PROCEDURE.
     4768   PROCEDURE enable_UI :
     4769     DISPLAY ed-notes f-boss-name f-obj-name f-agnt-name f-wrkr-name f-cre-name
     4770         WITH FRAME d-all-r-docs.
     4771     ENABLE b-quit b-mark b-sel b-add b-lkp b-chg b-del b-close b-open b-hist
     4772            b-help Btn_Copy b-inv b-sch b-print br-r-docs ed-notes
     4773         WITH FRAME d-all-r-docs.
     4774     VIEW FRAME d-all-r-docs.
     4775     OPEN QUERY br-r-docs FOR EACH r-doc .
     4776   END PROCEDURE.
     4777   PROCEDURE local-mark :
     4778   if not available r-doc then
     4779       do:
     4780           message "Неправильный выбор строки.".
     4781           return .
     4782       end.
     4783   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4784   define variable v-str-recid39 as character no-undo .
     4785   define variable v-num-entry39 as integer   no-undo .
     4786   assign
     4787     v-str-recid39 = trim( string( recid( r-doc ) , "->>>>>>>>>>>9":U ) )
     4788     v-num-entry39 = lookup( v-str-recid39 , del-list )
     4789   .
     4790   if v-num-entry39 > 0 then do:
     4791     assign
     4792       entry( v-num-entry39, del-list ) = "":U
     4793       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4794     .
     4795   end.
     4796   else do:
     4797     assign
     4798       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid39
     4799     .
     4800   end.
     4801       br-r-docs:refresh() in frame d-all-r-docs .
     4802   END PROCEDURE.
     4803   PROCEDURE Openbr :
     4804   define variable sort-column-phrase as character no-undo .
     4805       define variable l-query-was-opened as logical   no-undo .
     4806       define buffer bf_clients for ub.clients.
     4807       run waitfram-show in this-procedure
     4808           (input "Ждите..."
     4809           ).
     4810       case sort-column-name :
     4811           when "" then
     4812               do:
     4813                   assign
     4814                       sort-column-phrase = ""
     4815                       .
     4816               end.
     4817           otherwise
     4818           do:
     4819               assign
     4820                   sort-column-phrase = "by " + sort-column-name
     4821                   .
     4822           end.
     4823       end case.
     4824       assign
     4825           varobj-type  = v-cntxt-obj-type
     4826           varobj-code  = v-cntxt-obj-code
     4827           varhost-code = v-cntxt-host-code-obj
     4828           vartest-asi  = 'проверка':U
     4829       .
     4830       find first bf_clients  where bf_clients.obj-type = v-cntxt-obj-type and
     4831           bf_clients.obj-code = v-cntxt-obj-code no-lock.
     4832       case parlist-mode:
     4833           when 'работа':U then
     4834               do:
     4835                   assign
     4836                       frame d-all-r-docs:title = "ДОКУМЕНТЫ СВЕРКИ".
