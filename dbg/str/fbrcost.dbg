      479                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      480                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      481                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      482                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      483                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      484                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      485                         .
      486         end.
      487         ASSIGN
      488           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      489           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      490           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      491           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      492           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      493           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      494                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      495           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      496                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      497           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      498           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      499           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      500         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      501         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      502         if transport-base-loc = ? then transport-base-loc = 0.
      503         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      504         if other-base-loc     = ? then other-base-loc     = 0.
      505         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      506         assign
      507           transport-cli-loc      = 0
      508           other-cli-loc          = 0
      509           road-tax-cli-loc       = ?
      510           vat-cli-loc            = ?
      511           slt-cli-loc            = ?
      512           price-cli-with-tax-loc = ?.
      513      end.
      514   ASSIGN
      515             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      516       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      517   .
      518             assign
      519               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      520               v-vat-pc              = vat-pc-loc
      521               v-slt-pc              = slt-pc-loc
      522               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
      523               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
      524               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
      525               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
      526               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
      527               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
      528               v-road-tax-base       =  0
      529               v-road-tax-rubl       =  0
      530               v-excise-base         =  0
      531               v-excise-rubl         =  0
      532               v-transport-base      =  0
      533               v-transport-rubl      =  0
      534               v-other-base          =  0
      535               v-other-rubl          =  0
      536             .
      537       end.
      538     end.
      539   end procedure.
      540   do
      541   on error undo, return error return-value
      542   :
      543       define variable v-fact-qnty      as decimal       no-undo.
      544       define variable v-vat-pc         as decimal       no-undo.
      545       define variable v-slt-pc         as decimal       no-undo.
      546       define variable v-slt-base       as decimal       no-undo.
      547       define variable v-slt-rubl       as decimal       no-undo.
      548       define variable v-road-tax-base  as decimal       no-undo.
      549       define variable v-road-tax-rubl  as decimal       no-undo.
      550       define variable v-transport-base as decimal       no-undo.
      551       define variable v-transport-rubl as decimal       no-undo.
      552       define variable v-other-base     as decimal       no-undo.
      553       define variable v-other-rubl     as decimal       no-undo.
      554       define variable v-excise-base    as decimal       no-undo.
      555       define variable v-excise-rubl    as decimal       no-undo.
      556       define buffer buf_doc-line  for doc-line.
      557       define buffer buf_goods     for goods.
      558       define buffer buf_gds-obj   for gds-obj.
      559       find first buf_doc-line no-lock
      560            where recid( buf_doc-line ) = p-doc-line-recid
      561       .
      562       find first buf_goods no-lock
      563            where buf_goods.artic     = buf_doc-line.artic
      564              and buf_goods.prod-type = buf_doc-line.prod-type
      565              and buf_goods.prod-code = buf_doc-line.prod-code
      566       .
      567       if buf_goods.gds-type = 'у':U
      568       then do:
      569           find first buf_gds-obj no-lock
      570                where buf_gds-obj.obj-type  = buf_doc-line.obj-type
      571                  and buf_gds-obj.obj-code  = buf_doc-line.obj-code
      572                  and buf_gds-obj.artic     = buf_doc-line.artic
      573                  and buf_gds-obj.prod-type = buf_doc-line.prod-type
      574                  and buf_gds-obj.prod-code = buf_doc-line.prod-code
      575           .
      576           assign
      577               p-sum-base = buf_gds-obj.price-base     * ( -1 ) * p-qnty
      578               p-sum-rubl = buf_gds-obj.price-rubl     * ( -1 ) * p-qnty
      579               p-vat-base = 0
      580               p-vat-rubl = 0
      581           .
      582       end.
      583       else do:
      584           run r-cost in this-procedure (
      585                 input buf_doc-line.doc-code
      586               , input buf_doc-line.artic
      587               , input buf_doc-line.prod-type
      588               , input buf_doc-line.prod-code
      589               , output v-fact-qnty
      590               , output v-vat-pc
      591               , output v-slt-pc
      592               , output p-sum-base
      593               , output p-sum-rubl
      594               , output p-vat-base
      595               , output p-vat-rubl
      596               , output v-slt-base
      597               , output v-slt-rubl
      598               , output v-road-tax-base
      599               , output v-road-tax-rubl
      600               , output v-transport-base
      601               , output v-transport-rubl
      602               , output v-other-base
      603               , output v-other-rubl
      604               , output v-excise-base
      605               , output v-excise-rubl
      606           ).
      607       end.
      608       assign
      609         p-sum-base = p-sign * p-sum-base
      610         p-sum-rubl = p-sign * p-sum-rubl
      611         p-vat-base = p-sign * p-vat-base
      612         p-vat-rubl = p-sign * p-vat-rubl
      613         p-vat-pc   = v-vat-pc
      614       .
      615   end.
