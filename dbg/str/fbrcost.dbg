        1   block-level on error undo, throw.
        2   define input parameter p-doc-line-recid    as recid     no-undo .
        3   define input parameter p-sign              as integer   no-undo.
        4   define input parameter p-qnty              as decimal   no-undo.
        5   define output parameter p-sum-base         as decimal   no-undo .
        6   define output parameter p-sum-rubl         as decimal   no-undo .
        7   define output parameter p-vat-base         as decimal   no-undo .
        8   define output parameter p-vat-rubl         as decimal   no-undo .
        9   define output parameter p-vat-pc           as decimal   no-undo.
       10   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo initial "$Workfile: fbrcost.p $":U .
       14   define variable vss-archive     as character no-undo initial "$Archive: str/fbrcost.p $":U .
       15   define variable vss-description as character no-undo init "Суммы по строке документа для использования в производстве".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable vss-include-info0 as character format "X(65)" no-undo
       77   initial "@(#)$Workfile$ $Revision$".
       78   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure r-cost :
       80     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
       81     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
       82     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
       83     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
       84     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
       85     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
       86     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
       87     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
       88     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
       89     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
       90     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
       91     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
       92     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
       93     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
       94     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
       95     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
       96     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
       97     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
       98     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
       99     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      100     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      105       define buffer   in-vatp-parts    for ub.parts   .
      106       define buffer   in-vatp-doc      for ub.trn-doc .
      107       define buffer   in-vatp-goods    for ub.goods   .
      108       define buffer   in-vatp-sysconf  for ub.sysconf .
      109       define buffer   in-vatp_doc-attr for ub.doc-attr.
      110       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      111       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      112       define variable varinvprb                  as   character              no-undo.
      113       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      114       define variable cli-base-rate              as   decimal                no-undo.
      115       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      116       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      117       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      118       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      119       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      120       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      121       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      122       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      123       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      124       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      125       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      126       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      127       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      128       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      129       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      130       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      131       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      132       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      133       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      134       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      135       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      136       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      137       define variable varinvatp-envd             as   character              no-undo.
      138       define variable varinvatp-type             as   character              no-undo.
      139       def var v-parts-fact-qnty as decimal   no-undo .
      140       define buffer buf_parts    for ub.parts    .
      141       define buffer buf_goods    for ub.goods    .
      142       define buffer buf_trn-doc  for ub.trn-doc  .
      143       define buffer buf_doc-line for ub.doc-line .
      144       find first buf_doc-line no-lock
      145         where buf_doc-line.doc-code  = v-doc-code
      146           and buf_doc-line.artic     = v-artic
      147           and buf_doc-line.prod-type = v-prod-type
      148           and buf_doc-line.prod-code = v-prod-code
      149         no-error .
      150       if not available buf_doc-line then do:
      151         message
      152           vss-workfile vss-revision vss-description skip
      153           vss-include-info1 skip
      154           "Ошибка задания входных параметров" skip
      155           "Не найдена строка документа"  skip
      156           "Документ" v-doc-code skip
      157           "Артикул" v-artic v-prod-type v-prod-code skip
      158           view-as alert-box error .
      159         return error .
      160       end.
      161       find first buf_trn-doc no-lock
      162         where buf_trn-doc.doc-code = v-doc-code
      163         no-error .
      164       if not available buf_trn-doc then do:
      165         message
      166           vss-workfile vss-revision vss-description skip
      167           vss-include-info1 skip
      168           "Ошибка задания входных параметров" skip
      169           "Не найден документ" skip
      170           "Документ" v-doc-code skip
      171           "Артикул" v-artic v-prod-type v-prod-code skip
      172           view-as alert-box error .
      173         undo, return error .
      174       end.
      175       find first buf_goods no-lock
      176         where buf_goods.artic     = buf_doc-line.artic
      177           and buf_goods.prod-type = buf_doc-line.prod-type
      178           and buf_goods.prod-code = buf_doc-line.prod-code
      179         no-error .
      180       if not available buf_goods then do:
      181         message
      182           vss-workfile vss-revision vss-description skip
      183           vss-include-info1 skip
      184           "Ошибка задания входных параметров" skip
      185           "Не найден товар" skip
      186           "Документ" v-doc-code skip
      187           "Артикул" v-artic v-prod-type v-prod-code skip
      188           view-as alert-box error .
      189         undo, return error .
      190       end.
      191       if buf_goods.gds-type = 'т':U then do:
      192             for each buf_parts no-lock
      193               where buf_parts.out-code  = buf_trn-doc.doc-code
      194                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      195                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      196                 and buf_parts.artic     = buf_doc-line.artic
      197                 and buf_parts.prod-type = buf_doc-line.prod-type
      198                 and buf_parts.prod-code = buf_doc-line.prod-code
      199             on error undo, return error
      200             :
      201   assign
      202     price-rubl-with-tax-loc = buf_parts.price-rubl
      203     price-base-with-tax-loc = buf_parts.price-base
      204   .
      205   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      207     (output varinvprb
      208     )  .
      209     if buf_parts.out-code = 'free-zone':U     or
      210        buf_parts.out-code = 'out-zone':U   or
      211        buf_parts.doc-type = 'акт':U then do:
      212       assign
      213         in-vatp-have-vat-slt = yes.
      214     end.
      215     else do:
      216       find first in-vatp_doc-attr no-lock
      217         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      218           and in-vatp_doc-attr.attr-code = 'envd':U
      219         no-error .
      220       if not available in-vatp_doc-attr then do:
      221         assign
      222           in-vatp-have-vat-slt = yes.
      223       end.
      224       else do:
      225            in-vatp-have-vat-slt = no.
      226       end.
      227     end.
      228     assign
      229      price-cli-with-tax-loc = buf_parts.price-cli
      230      cli-base-rate          = buf_parts.cli-base-rate.
      231     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      232              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      233     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      234             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      235             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      236             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      237             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      238             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      239             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      240       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      241     assign
      242       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      243     assign
      244       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      245       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      246       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      247       transport-cli-loc  = 0
      248       other-cli-loc      = 0
      249     .
      250   ASSIGN
      251             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      252       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      253   .
      254               assign
      255                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
      256                                       or buf_trn-doc.doc-type = 'возврат':U
      257                                       or buf_trn-doc.doc-type = 'инв':U
      258                                       then buf_parts.fact-qnty
      259                                       else - buf_parts.fact-qnty
      260                                      )
      261               .
      262               assign
      263                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      264                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
      265                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
      266                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
      267                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
      268                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
      269                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
      270                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
      271                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
      272                 v-excise-base         =   0
      273                 v-excise-rubl         =   0
      274                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
      275                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
      276                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
      277                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
      278               .
      279           end.
      280   assign
      281     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      282     price-base-with-tax-loc = buf_doc-line.price-base
      283   .
      284   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      286     (output varinvprb
      287     )  .
      288      find first in-vatp_doc-attr no-lock
      289       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      290         and in-vatp_doc-attr.attr-code = 'envd':U
      291       no-error .
      292       if available in-vatp_doc-attr
      293          then do:
      294          assign
      295            in-vatp-have-vat-slt = no.
      296      end.
      297      else do:
      298        assign
      299          in-vatp-have-vat-slt = yes.
      300      end.
      301      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
      302                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
      303                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
      304      if (not buf_trn-doc.internal and
      305              buf_trn-doc.doc-type = 'при':U) or
      306         in-vatp-goods.gds-type = 'у':U then do:
      307         if varinvprb = "base":u then do:
      308           assign
      309             road-tax-base-loc = buf_doc-line.road-tax
      310             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
      311         end.
      312         else do:
      313           ASSIGN
      314             road-tax-rubl-loc = buf_doc-line.road-tax
      315             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
      316         end.
      317         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      318         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      319         assign
      320           road-tax-cli-loc = ?.
      321         ASSIGN
      322           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
      323           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
      324           transport-cli-loc  = 0
      325           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
      326           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
      327           other-cli-loc      = 0
      328           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
      329           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
      330                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
