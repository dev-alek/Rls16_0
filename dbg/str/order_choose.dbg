       39   define variable vss-revision    as character no-undo init "$Revision$":u .
       40   define variable vss-author      as character no-undo init "$Author$":u .
       41   define variable vss-date        as character no-undo init "$Date$":u .
       42   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       43   define variable vss-archive     as character no-undo init "$Archive$":u .
