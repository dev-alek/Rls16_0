     2290       field have-prod as logical
     2291       index pi is primary unique
     2292       artic
     2293       prod-type
     2294       prod-code
     2295       .
     2296   define stream slog.
     2297   define stream stream-err.
     2298   head-col =
     2299       '*'     + '#' +
     2300       'Код'     + '#' +
     2301       'Артикул'     + '#' +
     2302       'Произво-!дитель'     + '#' +
     2303       'Наименование'     + '#' +
     2304       'Цена!поставщика'     + '#' +
     2305       'Количество'     + '#' +
     2306       'Ед.!изм'
     2307       .
     2308   FUNCTION f-bonus RETURNS DECIMAL
     2309       ( input par-recid as recid )  FORWARD.
     2310   FUNCTION f-prc-min RETURNS DECIMAL
     2311       ( input par-recid as recid )  FORWARD.
     2312   FUNCTION get-b-code RETURNS CHARACTER
     2313       ( input gds-code as integer )  FORWARD.
     2314   FUNCTION get-ext-artic RETURNS CHARACTER
     2315       ( input p-recid as recid )  FORWARD.
     2316   FUNCTION get-gds-name RETURNS CHARACTER
     2317       ( input p-gds-code as integer )  FORWARD.
     2318   FUNCTION get-grp RETURNS CHARACTER
