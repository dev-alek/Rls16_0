     2320   FUNCTION mark-string RETURNS CHARACTER
     2321       ( input p-recid as recid, input mark-list as character  ) :
     2322       RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2323   END FUNCTION.
     2324   DEFINE BUTTON B-allmark
     2325       LABEL "&+"
     2326       SIZE 3 BY 1 TOOLTIP "Отметить все".
     2327   DEFINE BUTTON B-Help
     2328       LABEL "Помо&щь"
     2329       SIZE 3 BY 1
     2330       BGCOLOR 8 .
     2331   DEFINE BUTTON B-mark
     2332       LABEL "&*"
     2333       SIZE 3 BY 1.
     2334   DEFINE BUTTON b-quit AUTO-GO
     2335       LABEL "&Выход"
     2336       SIZE 10 BY 1
     2337       BGCOLOR 8 .
     2338   DEFINE BUTTON b-sel AUTO-GO
     2339       LABEL "Вы&бор"
     2340       SIZE 10 BY 1
     2341       BGCOLOR 8 .
     2342   DEFINE BUTTON B-unmark
     2343       LABEL "-"
     2344       SIZE 3 BY 1 TOOLTIP "Снять все *".
     2345   DEFINE VARIABLE mark-num   AS INTEGER   FORMAT ">>>>9":U INITIAL 0
     2346       VIEW-AS TEXT
     2347       SIZE 5.5 BY 1 NO-UNDO.
     2348   DEFINE VARIABLE sch-str    AS CHARACTER FORMAT "X(256)"
     2349       VIEW-AS FILL-IN
     2350       SIZE 44.38 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     2351   DEFINE VARIABLE RADIO-find AS INTEGER
     2352       VIEW-AS RADIO-SET HORIZONTAL
     2353       RADIO-BUTTONS
     2354       "коду", 1,
     2355       "артикулу", 2,
     2356       "названию", 3
     2357       SIZE 44 BY 1 NO-UNDO.
     2358   DEFINE QUERY spec-List FOR
     2359       tt_contract-specif SCROLLING.
     2360   DEFINE BROWSE spec-List
     2361       QUERY spec-List DISPLAY
     2362       mark-string( input recid(tt_contract-specif), input v-rid-list) column-label "*" format "X(1)":U
     2363       get-b-code(tt_contract-specif.gds-code) @ p-bcode  COLUMN-LABEL 'Код'  Format "X(16)"
     2364        tt_contract-specif.artic    COLUMN-LABEL 'Артикул'  Format "x(16)"
     2365        tt_contract-specif.gds-name    COLUMN-LABEL 'Наименование'
     2366       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 17.25 FIT-LAST-COLUMN.
     2367   DEFINE FRAME Dialog-Frame
     2368       b-quit AT ROW 1 COL 1
     2369       B-mark AT ROW 1 COL 11
     2370       b-sel AT ROW 1 COL 20
     2371       B-Help AT ROW 1 COL 97.88
     2372       B-allmark AT ROW 2 COL 11
     2373       B-unmark AT ROW 2 COL 14.13
     2374       RADIO-find AT ROW 3.38 COL 12 NO-LABEL
     2375       sch-str AT ROW 3.38 COL 54.5 COLON-ALIGNED NO-LABEL
     2376       spec-List AT ROW 4.54 COL 1
     2377       mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     2378       "Поиск по" VIEW-AS TEXT
     2379       SIZE 9 BY 1 AT ROW 3.38 COL 1
     2380       FGCOLOR 4
     2381       SPACE(91.37) SKIP(18.95)
     2382       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2383       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2384       TITLE "Товарная спецификация к договору"
     2385       DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
     2386   ASSIGN
     2387       FRAME Dialog-Frame:SCROLLABLE = FALSE
     2388       FRAME Dialog-Frame:HIDDEN     = TRUE.
     2389   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2390       DO:
     2391           APPLY "END-ERROR":U TO SELF.
     2392       END.
     2393   ON CHOOSE OF B-allmark IN FRAME Dialog-Frame
     2394       DO:
     2395           define variable loc#log as logical no-undo .
     2396           if available tt_contract-specif then
     2397           do:
     2398               v-rid-list = "" .
     2399               for each tt_contract-specif no-lock:
     2400   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2401   define variable v-str-recid20 as character no-undo .
     2402   define variable v-num-entry20 as integer   no-undo .
     2403   assign
     2404     v-str-recid20 = trim( string( recid( tt_contract-specif ) , "->>>>>>>>>>>9":U ) )
     2405     v-num-entry20 = lookup( v-str-recid20 , v-rid-list )
     2406   .
     2407   if v-num-entry20 > 0 then do:
     2408     assign
     2409       entry( v-num-entry20, v-rid-list ) = "":U
     2410       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2411     .
     2412   end.
     2413   else do:
     2414     assign
     2415       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     2416     .
     2417   end.
     2418                   loc#log = spec-List:refresh() .
     2419               end.
     2420           end.
     2421           if num-entries( v-rid-list ) <> 0 then
     2422           do:
     2423               display
     2424                   num-entries( v-rid-list ) @ mark-num
     2425                   with frame Dialog-Frame.
     2426           end.
     2427       END.
     2428   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2429       DO:
     2430           define variable loc#log as logical no-undo .
     2431           if available tt_contract-specif then
     2432           do:
     2433   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2434   define variable v-str-recid22 as character no-undo .
     2435   define variable v-num-entry22 as integer   no-undo .
     2436   assign
     2437     v-str-recid22 = trim( string( recid( tt_contract-specif ) , "->>>>>>>>>>>9":U ) )
     2438     v-num-entry22 = lookup( v-str-recid22 , v-rid-list )
     2439   .
     2440   if v-num-entry22 > 0 then do:
     2441     assign
     2442       entry( v-num-entry22, v-rid-list ) = "":U
     2443       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2444     .
     2445   end.
     2446   else do:
     2447     assign
     2448       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid22
     2449     .
     2450   end.
     2451               row_spec = rowid(tt_contract-specif).
     2452               loc#log = spec-List:refresh() .
     2453               reposition spec-List to rowid row_spec.
     2454               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     2455               do:
     2456                   loc#log = spec-List:select-next-row ().
     2457                   apply "VALUE-CHANGED" to spec-List in frame Dialog-Frame.
     2458               end.
     2459               if num-entries( v-rid-list ) = 0 then
     2460               do:
     2461                   hide mark-num in frame Dialog-Frame.
     2462               end.
     2463               else
     2464               do:
     2465                   display
     2466                       num-entries( v-rid-list ) @ mark-num
     2467                       with frame Dialog-Frame.
     2468               end.
     2469           end.
     2470           apply "entry" to spec-List in frame Dialog-Frame.
     2471       END.
     2472   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2473       DO:
     2474           find first temp-conn no-error.
     2475           if available temp-conn then
     2476           do:
     2477               run gbl/markqwa.p ( input b-sel:sensitive, input string(temp-conn.ri)) no-error.
     2478               if error-status:error then
     2479               do:
     2480                   apply "entry" to spec-List .
     2481                   return no-apply.
     2482               end.
     2483           end.
     2484       END.
     2485   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     2486       DO:
     2487           define buffer buf_goods for ub.goods .
     2488           define variable ii as integer no-undo .
     2489           define variable kk as integer no-undo .
     2490           empty temp-table gds-list .
     2491           if v-rid-list <> "" then
     2492           do:
     2493               do kk = 1 to num-entries (v-rid-list):
     2494                   find first tt_contract-specif where recid (tt_contract-specif) = integer(entry (kk,v-rid-list,",")) no-error .
     2495                   if available (tt_contract-specif) then
     2496                   do:
     2497                       find first buf_goods no-lock where buf_goods.gds-code = tt_contract-specif.gds-code no-error .
     2498                       if available (buf_goods) then
     2499                       do:
     2500                           do ii = 1 to num-entries (v-rid-list,","):
     2501                               for each buf_contract-specif no-lock where buf_contract-specif.contract-num = tt_contract-specif.contract-num:
     2502                                   find first ub.contract no-lock where ub.contract.contract-code = buf_contract-specif.contract-num no-error .
     2503                                   find first gds-list where gds-list.gds-code = buf_goods.gds-code and gds-list.contract = ub.contract.contract-prn-code no-error .
     2504                                   if not available (gds-list) then
     2505                                   do:
     2506                                       create gds-list .
     2507                                       buffer-copy buf_goods to gds-list .
     2508                                       gds-list.contract = ub.contract.contract-prn-code .
     2509                                       gds-list.contract-code = ub.contract.contract-code .
     2510                                       gds-list.unit-base = buf_contract-specif.unit-base .
     2511                                   end.
     2512                               end.
     2513                           end.
     2514                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error .
     2515                           if not available (gds-list) then
     2516                           do:
     2517                               create gds-list .
     2518                               buffer-copy buf_goods to gds-list .
     2519                           end.
     2520                       end.
     2521                   end.
     2522               end.
     2523           end.
     2524           else
     2525           do:
     2526               if available (tt_contract-specif) then
     2527               do:
     2528                   find first buf_goods no-lock where buf_goods.gds-code = tt_contract-specif.gds-code no-error .
     2529                   if available (buf_goods) then
     2530                   do:
     2531                       do ii = 1 to num-entries (v-rid-list,","):
     2532                           for each buf_contract-specif no-lock where buf_contract-specif.contract-num = tt_contract-specif.contract-num:
     2533                               find first ub.contract no-lock where ub.contract.contract-code = buf_contract-specif.contract-num no-error .
     2534                               find first gds-list where gds-list.gds-code = buf_goods.gds-code and gds-list.contract = ub.contract.contract-prn-code no-error .
     2535                               if not available (gds-list) then
     2536                               do:
     2537                                   create gds-list .
     2538                                   buffer-copy buf_goods to gds-list .
     2539                                   gds-list.contract = ub.contract.contract-prn-code .
     2540                                   gds-list.contract-code = ub.contract.contract-code .
     2541                               end.
     2542                           end.
     2543                       end.
     2544                       find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error .
     2545                       if not available (gds-list) then
     2546                       do:
     2547                           create gds-list .
     2548                           buffer-copy buf_goods to gds-list .
     2549                       end.
     2550                   end.
     2551               end.
     2552           end.
     2553           if par-params <> "" then
     2554               run crt-orderLine (
     2555                   input par-params,
     2556                   input pDocCode,
     2557                   input pDbNum,
     2558                   input table tt-gds-list)no-error .
     2559       END.
     2560   ON CHOOSE OF B-unmark IN FRAME Dialog-Frame
     2561       DO:
     2562           define variable loc#log as logical no-undo .
     2563           v-rid-list = "" .
     2564           loc#log = spec-List:refresh() .
     2565           hide mark-num in frame Dialog-Frame.
     2566       END.
     2567   ON VALUE-CHANGED OF RADIO-find IN FRAME Dialog-Frame
     2568       DO:
     2569           assign RADIO-find .
     2570           if sch-str <> "" then
     2571           do:
     2572               run proc-find-code in this-procedure ( input no, input sch-str) no-error.
     2573               if error-status:error then return no-apply.
     2574           end.
     2575       END.
     2576   ON CTRL-J OF sch-str IN FRAME Dialog-Frame
     2577       DO:
     2578           assign sch-str .
     2579           assign RADIO-find .
     2580           run proc-find-code in this-procedure ( input yes, input sch-str) no-error.
     2581           if error-status:error then return no-apply.
     2582       END.
     2583   ON RETURN OF sch-str IN FRAME Dialog-Frame
     2584       DO:
     2585           assign sch-str .
     2586           assign RADIO-find .
     2587           run proc-find-code in this-procedure ( input no, input sch-str) no-error.
     2588           if error-status:error then return no-apply.
     2589       END.
     2590   ON RETURN OF spec-List IN FRAME Dialog-Frame
     2591       or MOUSE-SELECT-DBLCLICK OF spec-List IN FRAME Dialog-Frame
     2592       DO:
     2593           if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     2594       END.
     2595   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2596   on help of frame Dialog-Frame
     2597   do:
     2598     run gbl/app_help.p
     2599       (input this-procedure :file-name
     2600       ,input ''
     2601       ,input ?
     2602       ) no-error.
     2603     if error-status :error then do:
     2604       message
     2605         "Ошибка при вызове помощи"
     2606         error-status :get-message(1)
     2607         view-as alert-box .
     2608     end.
     2609   end.
     2610   run minbtn-set in this-procedure .
     2611   on choose of b-help in frame Dialog-Frame
     2612   do:
     2613     apply "help":u to frame Dialog-Frame .
     2614   end.
     2615   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   procedure minbtn-set :
     2617       do
     2618           on error undo, return error return-value
     2619           :
     2620           define variable ii              as integer       no-undo .
     2621           define variable fh              as widget-handle no-undo .
     2622           define variable hh              as widget-handle no-undo .
     2623           define variable v-h             as handle        extent 4 no-undo .
     2624           define variable v-name-button   as character     no-undo .
     2625           define variable v-help-old-x    as decimal       no-undo .
     2626           define variable v-help-old-y    as decimal       no-undo .
     2627           define variable v-help-old-size as decimal       no-undo .
     2628           define variable v-frame-width   as decimal       no-undo .
     2629           define variable jj              as integer       no-undo .
     2630           do
     2631               on error undo, return error
     2632               :
     2633               assign
     2634                   v-frame-width = frame Dialog-Frame:width - 0.3
     2635                   fh            = frame Dialog-Frame:first-child
     2636                   hh            = fh:first-child
     2637                   ii            = 1
     2638                   .
     2639               do while valid-handle(hh):
     2640                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2641                   do:
     2642                       case lc(hh:name) :
     2643                           when "b-help" then
     2644                               do:
     2645                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2646                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2647                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2648                                   hh:TOOLTIP = "Помощь" .
     2649                                   v-help-old-x = hh:column .
     2650                                   v-help-old-y = hh:row    .
     2651                                   v-help-old-size = hh:width .
     2652                                   hh:width-chars = 2.5 .
     2653                               end.
     2654                           when "b-print" then
     2655                               do:
     2656                                   hh:load-image("cmp/b-print.bmp":u) .
     2657                                   hh:TOOLTIP = "Печать" .
     2658                                   v-h[ii] = hh:handle .
     2659                                   ii = ii + 1 .
     2660                                   hh:width-chars = 3 .
     2661                               end.
     2662                           when "b-history" or
     2663                           when "b-hist" then
     2664                               do:
     2665                                   hh:load-image("cmp/b-hist.bmp":u) .
     2666                                   hh:TOOLTIP = "История" .
     2667                                   v-h[ii] = hh:handle .
     2668                                   ii = ii + 1 .
     2669                                   hh:width-chars = 3 .
     2670                               end.
     2671                           when "b-sch" then
     2672                               do:
     2673                                   hh:load-image("cmp/b-sch.bmp":u) .
     2674                                   hh:TOOLTIP = "Установка Фильтра" .
     2675                                   v-h[ii] = hh:handle .
     2676                                   ii = ii + 1 .
     2677                                   hh:width-chars = 3 .
     2678                               end.
     2679                           when "b-hist-user" then
     2680                               do:
     2681                                   hh:load-image("cmp/b-hist.bmp":u) .
     2682                                   hh:TOOLTIP = "История пользователя" .
     2683                                   ii = ii + 1 .
     2684                               end.
     2685                       end case.
     2686                   end.
     2687                   hh = hh:next-sibling.
     2688               end.
     2689               b-help:column = v-frame-width - b-help:width-chars.
     2690               jj = 0.
     2691               repeat ii = 4 to 1 by -1 :
     2692                   if valid-handle (v-h[ii] ) then
     2693                   do:
     2694                       jj  = jj + 1 .
     2695                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2696                       v-h[ii]:row    = v-help-old-y .
     2697                   end.
     2698               end.
     2699           end.
     2700       end.
     2701   end procedure.
     2702   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2703   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2704   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2705   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2706   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2707   define variable v-diasize-current-frame-height as decimal   no-undo .
     2708   define variable v-diasize-change-size          as logical   no-undo .
     2709   define variable v-diasize-resize-button        as handle    no-undo .
     2710   define variable v-diasize-wndmax               as logical   no-undo .
     2711   define variable v-diasize-wndstore             as logical   no-undo .
     2712   define variable v-diasize-proc-name            as character no-undo .
     2713   define variable v-diasize-browse-handle        as handle    no-undo .
     2714   define variable v-diasize-browse-number        as integer   no-undo .
     2715   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2716   define temp-table temp-diasize-handle no-undo
     2717     field handle-value  as handle
     2718     field save-position as decimal
     2719     index xpk is primary unique handle-value
     2720     .
     2721   define temp-table temp-browse-handle no-undo
     2722     field browse-type   as character
     2723     field browse-number as integer
     2724     field browse-handle as handle
     2725     field original-size as decimal
     2726     index xpk is primary unique browse-type browse-number
     2727     index xie browse-type browse-handle
     2728   .
     2729   procedure diasize_change-height :
     2730     define input  parameter p-change-value  as decimal   no-undo .
     2731     define input  parameter p-move-resize   as logical   no-undo .
     2732     define variable v-field-group-handle    as handle    no-undo .
     2733     define variable v-object-handle         as handle    no-undo .
     2734     define variable v-frame-height          as decimal   no-undo .
     2735     define variable v-frame-virtual-height  as decimal   no-undo .
     2736     define variable v-browse-height         as decimal   no-undo .
     2737     define variable v-window-height         as decimal   no-undo .
     2738     define variable v-window-virtual-height as decimal   no-undo .
     2739     define variable v-change-sign           as integer   no-undo .
     2740     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2741     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2742     if p-change-value > 0
     2743     then do:
     2744       if frame Dialog-Frame :height + p-change-value
     2745           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2746       then do:
     2747         assign
     2748           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2749                           - (frame Dialog-Frame :height-chars)
     2750         .
     2751         if p-change-value <= 0
     2752         then do:
     2753           run diasize_position-resize-button in this-procedure .
     2754           return .
     2755         end.
     2756       end.
     2757     end.
     2758     if p-change-value < 0
     2759     then do:
     2760       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2761       then do:
     2762         assign
     2763           p-change-value = v-diasize-orig-frame-height
     2764                          - (frame Dialog-Frame :height-chars)
     2765         .
     2766         if p-change-value >= 0
     2767         then do:
     2768           run diasize_position-resize-button in this-procedure .
     2769           return .
     2770         end.
     2771       end.
     2772     end.
     2773     if p-change-value >= 0
     2774     then do:
     2775       assign
     2776         v-change-sign = 1
     2777       .
     2778     end.
     2779     else do:
     2780       assign
     2781         v-change-sign = -1
     2782       .
     2783     end.
     2784     assign
     2785       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2786     .
     2787     if p-change-value = 0
     2788     then do:
     2789       run diasize_position-resize-button in this-procedure .
     2790       return .
     2791     end.
     2792     move_block:
     2793     do
     2794     on error undo move_block, retry move_block
     2795     :
     2796       if retry
     2797       then do:
     2798         do
     2799         on error undo move_block, leave move_block
     2800         :
     2801           if p-change-value > 0
     2802           then do:
     2803             for each buf_temp-diasize-handle
     2804             on error undo, next
     2805             :
     2806               assign
     2807                 v-object-handle = buf_temp-diasize-handle.handle-value
     2808               .
     2809               if v-object-handle <> v-diasize-resize-button
     2810               then do:
     2811                 assign
     2812                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2813                 .
     2814               end.
     2815             end.
     2816             assign
     2817               v-diasize-browse-handle :height = v-browse-height
     2818             .
     2819             for each buf_temp-browse-handle
     2820               where buf_temp-browse-handle.browse-type = 'height':u
     2821             on error undo, next
     2822             :
     2823               assign
     2824                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2825               .
     2826             end.
     2827             assign
     2828               frame Dialog-Frame :height = v-frame-height
     2829             .
     2830             if frame Dialog-Frame :scrollable = true
     2831             then do:
     2832               assign
     2833                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2834               .
     2835             end.
     2836             run diasize_position-resize-button in this-procedure .
     2837           end.
     2838           else do:
     2839             if frame Dialog-Frame :scrollable = true
     2840             then do:
     2841               assign
     2842                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2843               .
     2844             end.
     2845             assign
     2846               frame Dialog-Frame :height = v-frame-height
     2847             .
     2848             assign
     2849               v-diasize-browse-handle :height = v-browse-height
     2850             .
     2851             for each buf_temp-browse-handle
     2852               where buf_temp-browse-handle.browse-type = 'height':u
     2853             on error undo, next
     2854             :
     2855               assign
     2856                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2857               .
     2858             end.
     2859             for each buf_temp-diasize-handle
     2860             on error undo, next
     2861             :
     2862               assign
     2863                 v-object-handle = buf_temp-diasize-handle.handle-value
     2864               .
     2865               if v-object-handle <> v-diasize-resize-button
     2866               then do:
     2867                 assign
     2868                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2869                 .
     2870               end.
     2871             end.
     2872             run diasize_position-resize-button in this-procedure .
     2873           end.
     2874           assign
     2875             v-diasize-change-size = false
     2876           .
     2877           leave move_block .
     2878         end.
     2879       end.
     2880       assign
     2881         v-diasize-need-full-display = true
     2882       .
     2883       if v-diasize-change-size = false
     2884       then do:
     2885         assign
     2886           v-diasize-change-size = true
     2887         .
     2888       end.
     2889       else do:
     2890         return .
     2891       end.
     2892       assign
     2893         v-frame-height = frame Dialog-Frame :height
     2894         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2895         v-browse-height = v-diasize-browse-handle :height
     2896       .
     2897       for each buf_temp-browse-handle
     2898         where buf_temp-browse-handle.browse-type = 'height':u
     2899       :
     2900         assign
     2901           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2902         .
     2903       end.
     2904       for each buf_temp-diasize-handle
     2905       :
     2906         delete buf_temp-diasize-handle .
     2907       end.
     2908       assign
     2909         v-field-group-handle = frame Dialog-Frame :first-child
     2910       .
     2911       do while valid-handle(v-field-group-handle)
     2912       :
     2913         assign
     2914           v-object-handle = v-field-group-handle :first-child
     2915         .
     2916         do while valid-handle(v-object-handle)
     2917         :
     2918           if  v-object-handle <> v-diasize-browse-handle :handle
     2919           and can-query(v-object-handle, "row")
     2920           and can-query(v-object-handle, "height")
     2921           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2922           then do:
     2923             find first buf_temp-browse-handle
     2924               where buf_temp-browse-handle.browse-type   = 'height':u
     2925                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2926               no-error .
     2927             if available buf_temp-browse-handle
     2928             then do:
     2929             end.
     2930             else do:
     2931               create buf_temp-diasize-handle .
     2932               assign
     2933                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2934                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2935               .
     2936             end.
     2937           end.
     2938           assign
     2939             v-object-handle = v-object-handle :next-sibling
     2940           .
     2941         end.
     2942         assign
     2943           v-field-group-handle = v-field-group-handle :next-sibling
     2944         .
     2945       end.
     2946       do with frame Dialog-Frame
     2947       :
     2948         hide v-diasize-resize-button .
     2949         assign
     2950           v-diasize-resize-button :row    = 1
     2951           v-diasize-resize-button :column = 1
     2952         .
     2953       end.
     2954       if p-change-value > 0
     2955       then do:
     2956         if frame Dialog-Frame :scrollable = true
     2957         then do:
     2958           assign
     2959             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2960             no-error .
     2961           if error-status :error
     2962           or error-status :get-message(1) <> ""
     2963           then do:
     2964             undo move_block, retry move_block .
     2965           end.
     2966         end.
     2967         assign
     2968           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2969           no-error .
     2970         if error-status :error
     2971         or error-status :get-message(1) <> ""
     2972         then do:
     2973           undo move_block, retry move_block .
     2974         end.
     2975         assign
     2976           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2977           no-error .
     2978         if error-status :error
     2979         or error-status :get-message(1) <> ""
     2980         then do:
     2981           undo move_block, retry move_block .
     2982         end.
     2983         for each buf_temp-browse-handle
     2984           where buf_temp-browse-handle.browse-type = 'height':u
     2985         on error undo move_block, retry move_block
     2986         :
     2987           assign
     2988             buf_temp-browse-handle.browse-handle :height
     2989               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2990             no-error .
     2991           if error-status :error
     2992           or error-status :get-message(1) <> ""
     2993           then do:
     2994             undo move_block, retry move_block .
     2995           end.
     2996         end.
     2997         for each buf_temp-diasize-handle
     2998         on error undo move_block, retry move_block
     2999         :
     3000           assign
     3001             v-object-handle = buf_temp-diasize-handle.handle-value
     3002           .
     3003           if v-object-handle <> v-diasize-resize-button
     3004           then do:
     3005             assign
     3006               v-object-handle :row = v-object-handle :row + p-change-value
     3007               no-error .
     3008             if error-status :error
     3009             or error-status :get-message(1) <> ""
     3010             then do:
     3011               undo move_block, retry move_block .
     3012             end.
     3013           end.
     3014         end.
     3015       end.
     3016       else do:
     3017         for each buf_temp-diasize-handle
     3018         on error undo move_block, retry move_block
     3019         :
     3020           assign
     3021             v-object-handle = buf_temp-diasize-handle.handle-value
     3022           .
     3023           if v-object-handle <> v-diasize-resize-button
     3024           then do:
     3025             assign
     3026               v-object-handle :row = v-object-handle :row + p-change-value
     3027               no-error .
     3028             if error-status :error
     3029             or error-status :get-message(1) <> ""
     3030             then do:
     3031               undo move_block, retry move_block .
     3032             end.
     3033           end.
     3034         end.
     3035         assign
     3036           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3037           no-error .
     3038         if error-status :error
     3039         or error-status :get-message(1) <> ""
     3040         then do:
     3041           undo move_block, retry move_block .
     3042         end.
     3043         for each buf_temp-browse-handle
     3044           where buf_temp-browse-handle.browse-type = 'height':u
     3045         on error undo move_block, retry move_block
     3046         :
     3047           assign
     3048             buf_temp-browse-handle.browse-handle :height
     3049               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3050             no-error .
     3051           if error-status :error
     3052           or error-status :get-message(1) <> ""
     3053           then do:
     3054             undo move_block, retry move_block .
     3055           end.
     3056         end.
     3057         assign
     3058           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3059           no-error .
     3060         if error-status :error
     3061         or error-status :get-message(1) <> ""
     3062         then do:
     3063           undo move_block, retry move_block .
     3064         end.
     3065         if frame Dialog-Frame :scrollable = true
     3066         then do:
     3067           assign
     3068             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3069             no-error .
     3070           if error-status :error
     3071           or error-status :get-message(1) <> ""
     3072           then do:
     3073             undo move_block, retry move_block .
     3074           end.
     3075         end.
     3076       end.
     3077       if p-move-resize = true
     3078       then do:
     3079         run diasize_position-resize-button in this-procedure .
     3080       end.
     3081       if v-diasize-wndstore = true
     3082       then do:
     3083         if connected("ub") = true
     3084         then do:
     3085           define variable v-cntxt-db-num        as integer   no-undo .
     3086           define variable v-cntxt-userid        as character no-undo .
     3087           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3088                                             , OUTPUT v-cntxt-userid
     3089                                             ) .
     3090           run gbl/wndsizew.p
     3091             (input  v-cntxt-db-num
     3092             ,input  v-cntxt-userid
     3093             ,input  v-diasize-proc-name
     3094             ,input  'height':u
     3095             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3096             ) .
     3097         end.
     3098       end.
     3099     end.
     3100     assign
     3101       v-diasize-change-size = false
     3102     .
     3103   end procedure.
     3104   procedure diasize_set-height :
     3105     define input  parameter p-new-height  as decimal   no-undo .
     3106     define input  parameter p-move-resize as logical   no-undo .
     3107     do
     3108     on error undo, return error return-value
     3109     :
     3110       run diasize_change-height in this-procedure
     3111         (input  (p-new-height - frame Dialog-Frame :height)
     3112         ,input  p-move-resize
     3113         ) .
     3114     end.
     3115   end procedure.
     3116   procedure diasize_change-width :
     3117     define input  parameter p-change-value as decimal   no-undo .
     3118     define input  parameter p-move-resize  as logical   no-undo .
     3119     define variable v-field-group-handle   as handle    no-undo .
     3120     define variable v-object-handle        as handle    no-undo .
     3121     define variable v-frame-width          as decimal   no-undo .
     3122     define variable v-frame-virtual-width  as decimal   no-undo .
     3123     define variable v-browse-width         as decimal   no-undo .
     3124     define variable v-window-width         as decimal   no-undo .
     3125     define variable v-window-virtual-width as decimal   no-undo .
     3126     define variable v-change-sign          as integer   no-undo .
     3127     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3128     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3129     if p-change-value > 0
     3130     then do:
     3131       if frame Dialog-Frame :width + p-change-value >
     3132           session :width-chars
     3133       then do:
     3134         assign
     3135           p-change-value = session :width-chars - frame Dialog-Frame :width
     3136         .
     3137         if p-change-value <= 0
     3138         then do:
     3139           run diasize_position-resize-button in this-procedure .
     3140           return .
     3141         end.
     3142       end.
     3143     end.
     3144     if p-change-value < 0
     3145     then do:
     3146       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3147       then do:
     3148         assign
     3149           p-change-value = v-diasize-orig-frame-width
     3150                          - frame Dialog-Frame :width
     3151         .
     3152         if p-change-value >= 0
     3153         then do:
     3154           run diasize_position-resize-button in this-procedure .
     3155           return .
     3156         end.
     3157       end.
     3158     end.
     3159     if p-change-value >= 0
     3160     then do:
     3161       assign
     3162         v-change-sign = 1
     3163       .
     3164     end.
     3165     else do:
     3166       assign
     3167         v-change-sign = -1
     3168       .
     3169     end.
     3170     assign
     3171       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3172     .
     3173     if p-change-value = 0
     3174     then do:
     3175       run diasize_position-resize-button in this-procedure .
     3176       return .
     3177     end.
     3178     move_block:
     3179     do
     3180     on error undo move_block, leave move_block
     3181     :
     3182       if retry
     3183       then do:
     3184         do
     3185         on error undo move_block, leave move_block
     3186         :
     3187           if p-change-value > 0
     3188           then do:
     3189             for each buf_temp-diasize-handle
     3190             on error undo, next
     3191             :
     3192               assign
     3193                 v-object-handle = buf_temp-diasize-handle.handle-value
     3194               .
     3195               if v-object-handle <> v-diasize-resize-button
     3196               then do:
     3197                 assign
     3198                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3199                 .
     3200               end.
     3201             end.
     3202             assign
     3203               v-diasize-browse-handle :width = v-browse-width
     3204             .
     3205             for each buf_temp-browse-handle
     3206               where buf_temp-browse-handle.browse-type = 'width':u
     3207             on error undo, next
     3208             :
     3209               assign
     3210                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3211               .
     3212             end.
     3213             assign
     3214               frame Dialog-Frame :width = v-frame-width
     3215             .
     3216             if frame Dialog-Frame :scrollable = true
     3217             then do:
     3218               assign
     3219                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3220               .
     3221             end.
     3222             run diasize_position-resize-button in this-procedure .
     3223           end.
     3224           else do:
     3225             if frame Dialog-Frame :scrollable = true
     3226             then do:
     3227               assign
     3228                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3229               .
     3230             end.
     3231             assign
     3232               frame Dialog-Frame :width = v-frame-width
     3233             .
     3234             for each buf_temp-browse-handle
     3235               where buf_temp-browse-handle.browse-type = 'width':u
     3236             on error undo, next
     3237             :
     3238               assign
     3239                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3240               .
     3241             end.
     3242             assign
     3243               v-diasize-browse-handle :width = v-browse-width
     3244             .
     3245             for each buf_temp-diasize-handle
     3246             on error undo, next
     3247             :
     3248               assign
     3249                 v-object-handle = buf_temp-diasize-handle.handle-value
     3250               .
     3251               if v-object-handle <> v-diasize-resize-button
     3252               then do:
     3253                 assign
     3254                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3255                 .
     3256               end.
     3257             end.
     3258             run diasize_position-resize-button in this-procedure .
     3259           end.
     3260           assign
     3261             v-diasize-change-size = false
     3262           .
     3263           leave move_block .
     3264         end.
     3265       end.
     3266       assign
     3267         v-diasize-need-full-display = true
     3268       .
     3269       if v-diasize-change-size = false
     3270       then do:
     3271         assign
     3272           v-diasize-change-size = true
     3273         .
     3274       end.
     3275       else do:
     3276         return .
     3277       end.
     3278       assign
     3279         v-frame-width = frame Dialog-Frame :width
     3280         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3281         v-browse-width = v-diasize-browse-handle :width
     3282       .
     3283       for each buf_temp-browse-handle
     3284         where buf_temp-browse-handle.browse-type = 'width':u
     3285       :
     3286         assign
     3287           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3288         .
     3289       end.
     3290       for each buf_temp-diasize-handle
     3291       :
     3292         delete buf_temp-diasize-handle .
     3293       end.
     3294       assign
     3295         v-field-group-handle = frame Dialog-Frame :first-child
     3296       .
     3297       do while valid-handle(v-field-group-handle)
     3298       :
     3299         assign
     3300           v-object-handle = v-field-group-handle :first-child
     3301         .
     3302         do while valid-handle(v-object-handle)
     3303         :
     3304           if  v-object-handle <> v-diasize-browse-handle :handle
     3305           and v-object-handle <> v-diasize-resize-button
     3306           and can-query(v-object-handle, "row")
     3307           and can-query(v-object-handle, "height")
     3308           and ( v-object-handle :col + v-object-handle :width
     3309                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3310               )
     3311           then do:
     3312             find first buf_temp-browse-handle
     3313               where buf_temp-browse-handle.browse-type   = 'width':u
     3314                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3315               no-error .
     3316             if available buf_temp-browse-handle
     3317             then do:
     3318             end.
     3319             else do:
     3320               create buf_temp-diasize-handle .
     3321               assign
     3322                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3323                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3324               .
     3325             end.
     3326           end.
     3327           assign
     3328             v-object-handle = v-object-handle :next-sibling
     3329           .
     3330         end.
     3331         assign
     3332           v-field-group-handle = v-field-group-handle :next-sibling
     3333         .
     3334       end.
     3335       do with frame Dialog-Frame
     3336       :
     3337         hide v-diasize-resize-button .
     3338         v-diasize-resize-button :row = 1.
     3339         v-diasize-resize-button :column = 1.
     3340       end.
     3341       if p-change-value > 0
     3342       then do:
     3343         if frame Dialog-Frame :scrollable = true
     3344         then do:
     3345           assign
     3346             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3347             no-error .
     3348           if error-status :error
     3349           or error-status :get-message(1) <> ""
     3350           then do:
     3351             undo move_block, retry move_block.
     3352           end.
     3353         end.
     3354         assign
     3355           frame Dialog-Frame :width = v-frame-width + p-change-value
     3356           no-error .
     3357         if error-status :error
     3358         or error-status :get-message(1) <> ""
     3359         then do:
     3360           undo move_block, retry move_block.
     3361         end.
     3362         assign
     3363           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3364         no-error .
     3365         if error-status :error
     3366         or error-status :get-message(1) <> ""
     3367         then do:
     3368           undo move_block, retry move_block.
     3369         end.
     3370         for each buf_temp-browse-handle
     3371           where buf_temp-browse-handle.browse-type = 'width':u
     3372         on error undo move_block, retry move_block
     3373         :
     3374           assign
     3375             buf_temp-browse-handle.browse-handle :width
     3376               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3377             no-error .
     3378           if error-status :error
     3379           or error-status :get-message(1) <> ""
     3380           then do:
     3381             undo move_block, retry move_block .
     3382           end.
     3383         end.
     3384         for each buf_temp-diasize-handle
     3385         on error undo move_block, retry move_block
     3386         :
     3387           assign
     3388             v-object-handle = buf_temp-diasize-handle.handle-value
     3389           .
     3390           if v-object-handle <> v-diasize-resize-button
     3391           then do:
     3392             assign
     3393               v-object-handle :col = v-object-handle :col + p-change-value
     3394               no-error .
     3395             if error-status :error
     3396             or error-status :get-message(1) <> ""
     3397             then do:
     3398               undo move_block, retry move_block .
     3399             end.
     3400           end.
     3401         end.
     3402       end.
     3403       else do:
     3404         for each buf_temp-diasize-handle
     3405         on error undo move_block, retry move_block
     3406         :
     3407           assign
     3408             v-object-handle = buf_temp-diasize-handle.handle-value
     3409           .
     3410           if v-object-handle <> v-diasize-resize-button
     3411           then do:
     3412             assign
     3413               v-object-handle :col = v-object-handle :col + p-change-value
     3414               no-error .
     3415             if error-status :error
     3416             or error-status :get-message(1) <> ""
     3417             then do:
     3418               undo move_block, retry move_block .
     3419             end.
     3420           end.
     3421         end.
     3422         for each buf_temp-browse-handle
     3423           where buf_temp-browse-handle.browse-type = 'width':u
     3424         on error undo move_block, retry move_block
     3425         :
     3426           assign
     3427             buf_temp-browse-handle.browse-handle :width
     3428               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3429             no-error .
     3430           if error-status :error
     3431           or error-status :get-message(1) <> ""
     3432           then do:
     3433             undo move_block, retry move_block .
     3434           end.
     3435         end.
     3436         assign
     3437           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3438           no-error .
     3439         if error-status :error
     3440         or error-status :get-message(1) <> ""
     3441         then do:
     3442           undo move_block, retry move_block.
     3443         end.
     3444         assign
     3445           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3446         no-error .
     3447         if error-status :error
     3448         or error-status :get-message(1) <> ""
     3449         then do:
     3450           undo move_block, retry move_block.
     3451         end.
     3452         if frame Dialog-Frame :scrollable = true
     3453         then do:
     3454           assign
     3455             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3456           no-error .
     3457           if error-status :error
     3458           or error-status :get-message(1) <> ""
     3459           then do:
     3460             undo move_block, retry move_block.
     3461           end.
     3462         end.
     3463       end.
     3464       if p-move-resize
     3465       then do:
     3466         run diasize_position-resize-button in this-procedure .
     3467       end.
     3468       if v-diasize-wndstore = true
     3469       then do:
     3470         if connected("ub") = true
     3471         then do:
     3472           define variable v-cntxt-db-num        as integer   no-undo .
     3473           define variable v-cntxt-userid        as character no-undo .
     3474           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3475                                             , OUTPUT v-cntxt-userid
     3476                                             ) .
     3477           run gbl/wndsizew.p
     3478             (input  v-cntxt-db-num
     3479             ,input  v-cntxt-userid
     3480             ,input  v-diasize-proc-name
     3481             ,input  'width':u
     3482             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3483             ) .
     3484         end.
     3485       end.
     3486     end.
     3487     assign
     3488       v-diasize-change-size = false
     3489     .
     3490   end procedure.
     3491   procedure diasize_set-width :
     3492     define input  parameter p-new-width  as decimal   no-undo .
     3493     define input  parameter p-move-resize as logical   no-undo .
     3494     do
     3495     on error undo, return error return-value
     3496     :
     3497       run diasize_change-width in this-procedure
     3498         (input  (p-new-width - frame Dialog-Frame :width)
     3499         ,input  p-move-resize
     3500         ) .
     3501     end.
     3502   end procedure.
     3503   procedure diasize_position-resize-button :
     3504     do with frame Dialog-Frame
     3505     :
     3506       hide v-diasize-resize-button .
     3507       assign
     3508         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3509                     - 1
     3510                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3511         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3512                     - 1
     3513                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3514       .
     3515       view v-diasize-resize-button .
     3516     end.
     3517   end procedure.
     3518   on alt-right anywhere
     3519   do:
     3520     run diasize_change-width in this-procedure
     3521       (input 1
     3522       ,input true
     3523       ) .
     3524     return no-apply .
     3525   end.
     3526   on alt-left anywhere
     3527   do:
     3528     run diasize_change-width in this-procedure
     3529       (input -1
     3530       ,input true
     3531       ) .
     3532     return no-apply .
     3533   end.
     3534   on alt-down anywhere
     3535   do:
     3536     run diasize_change-height in this-procedure
     3537       (input 1
     3538       ,input true
     3539       ) .
     3540     return no-apply .
     3541   end.
     3542   on alt-up anywhere
     3543   do:
     3544     run diasize_change-height in this-procedure
     3545       (input -1
     3546       ,input true
     3547       ) .
     3548     return no-apply .
     3549   end.
     3550   on alt-enter of frame Dialog-Frame
     3551   do:
     3552     run diasize_maximize in this-procedure
     3553       (input  ?
     3554       ).
     3555     return no-apply .
     3556   end.
     3557   procedure diasize_end-move :
     3558     do
     3559     on error undo, return error return-value
     3560     :
     3561       define variable v-row-delta as decimal   no-undo .
     3562       define variable v-col-delta as decimal   no-undo .
     3563       define variable v-new-row as decimal   no-undo .
     3564       define variable v-new-col as decimal   no-undo .
     3565       assign
     3566         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3567         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3568       .
     3569       assign
     3570         v-row-delta = v-new-row - frame Dialog-Frame :height
     3571         v-col-delta = v-new-col - frame Dialog-Frame :width
     3572       .
     3573       run diasize_change-height in this-procedure
     3574         (input v-row-delta
     3575         ,input true
     3576         ) .
     3577       run diasize_change-width in this-procedure
     3578         (input v-col-delta
     3579         ,input true
     3580         ) .
     3581     end.
     3582   end procedure.
     3583   procedure diasize_maximize :
     3584     define input  parameter p-action as logical   no-undo .
     3585     do
     3586     on error undo, return error return-value
     3587     :
     3588       if p-action = ?
     3589       then do:
     3590         if v-diasize-need-maximize = true
     3591         then do:
     3592           assign
     3593             p-action = true
     3594           .
     3595         end.
     3596         else do:
     3597           assign
     3598             p-action = false
     3599           .
     3600         end.
     3601       end.
     3602       if p-action = true
     3603       then do:
     3604         run diasize_change-height in this-procedure
     3605           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3606               - frame Dialog-Frame :height-chars
     3607           ,input true
     3608           ) .
     3609         run diasize_change-width in this-procedure
     3610           (input session :width-chars
     3611               - frame Dialog-Frame :width-chars
     3612           ,input true
     3613           ) .
     3614         assign
     3615           v-diasize-need-maximize = false
     3616         .
     3617       end.
     3618       else do:
     3619         run diasize_change-width in this-procedure
     3620           (input v-diasize-orig-frame-width
     3621               - frame Dialog-Frame :width-chars
     3622           ,input true
     3623           ) .
     3624         run diasize_change-height in this-procedure
     3625           (input v-diasize-orig-frame-height
     3626               - frame Dialog-Frame :height-chars
     3627           ,input true
     3628           ) .
     3629         assign
     3630           v-diasize-need-maximize = true
     3631         .
     3632       end.
     3633     end.
     3634   end procedure.
     3635   procedure diasize_restore-orig-size :
     3636     do
     3637     on error undo, return error return-value
     3638     :
     3639       assign
     3640         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3641         v-diasize-current-frame-height = frame Dialog-Frame :height
     3642       .
     3643       run diasize_set-height in this-procedure
     3644         (input  v-diasize-orig-frame-height
     3645         ,input  true
     3646         ) .
     3647       run diasize_set-width in this-procedure
     3648         (input  v-diasize-orig-frame-width
     3649         ,input  true
     3650         ) .
     3651     end.
     3652   end procedure.
     3653   procedure diasize_restore-current-size :
     3654     do
     3655     on error undo, return error return-value
     3656     :
     3657       run diasize_set-height in this-procedure
     3658         (input  v-diasize-current-frame-height
     3659         ,input  true
     3660         ) .
     3661       run diasize_set-width in this-procedure
     3662         (input  v-diasize-current-frame-width
     3663         ,input  true
     3664         ) .
     3665     end.
     3666   end procedure.
     3667   procedure diasize_set-browse-handle :
     3668     define input  parameter p-browse-handle as handle   no-undo .
     3669     define buffer buf_temp-browse-handle for temp-browse-handle .
     3670     do
     3671     on error undo, return error return-value
     3672     :
     3673       assign
     3674         v-diasize-browse-handle = p-browse-handle
     3675       .
     3676       for each buf_temp-browse-handle
     3677       on error undo, return error return-value
     3678       :
     3679         delete buf_temp-browse-handle .
     3680       end.
     3681     end.
     3682   end procedure.
     3683   procedure diasize_add_browse :
     3684     define input  parameter p-browse-type   as character no-undo .
     3685     define input  parameter p-browse-handle as handle    no-undo .
     3686     define buffer buf_temp-browse-handle for temp-browse-handle .
     3687     do
     3688     on error undo, return error return-value
     3689     :
     3690       assign
     3691         v-diasize-browse-number = v-diasize-browse-number + 1
     3692       .
     3693       create buf_temp-browse-handle .
     3694       assign
     3695         buf_temp-browse-handle.browse-type   = p-browse-type
     3696         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3697         buf_temp-browse-handle.browse-handle = p-browse-handle
     3698       .
     3699     end.
     3700   end procedure.
     3701   procedure diasize_init :
     3702     define variable v-default-value    as logical   no-undo .
     3703     define variable v-restore-saved    as logical   no-undo .
     3704     define variable v-resize-value-str as character no-undo .
     3705     do
     3706     on error undo, return error return-value
     3707     :
     3708       do with frame Dialog-Frame
     3709       :
     3710         assign
     3711           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3712           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3713           v-diasize-browse-handle     = browse spec-List :handle
     3714         .
     3715         create button v-diasize-resize-button
     3716         assign
     3717           parent        = frame Dialog-Frame :first-child
     3718           label         = "s"
     3719           height-pixels = 16
     3720           width-pixels  = 16
     3721           visible       = true
     3722           sensitive     = true
     3723           movable       = true
     3724           triggers:
     3725             on end-move persistent run diasize_end-move in this-procedure .
     3726           end triggers.
     3727         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3728         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3729         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3730         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3731         assign
     3732           v-diasize-wndmax = false
     3733         .
     3734         if connected("ub") = true
     3735         then do:
     3736           define variable v-cntxt-db-num        as integer   no-undo .
     3737           define variable v-cntxt-userid        as character no-undo .
     3738           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3739                                             , OUTPUT v-cntxt-userid
     3740                                             ) .
     3741           run gbl/wndpar_r.p
     3742             (input  v-cntxt-db-num
     3743             ,input  v-cntxt-userid
     3744             ,input  'wndmax':U
     3745             ,output v-diasize-wndmax
     3746             ,output v-default-value
     3747             ) .
     3748         end.
     3749         assign
     3750           v-diasize-wndstore = false
     3751         .
     3752         if connected("ub") = true
     3753         then do:
     3754           run gbl/wndpar_r.p
     3755             (input  v-cntxt-db-num
     3756             ,input  v-cntxt-userid
     3757             ,input  'wndstore':U
     3758             ,output v-diasize-wndstore
     3759             ,output v-default-value
     3760             ) .
     3761         end.
     3762         assign
     3763           v-diasize-proc-name = entry(1, program-name(2), '.')
     3764         .
     3765         if v-diasize-wndstore = true
     3766         then do:
     3767           assign
     3768             v-restore-saved = false
     3769           .
     3770           if connected("ub") = true
     3771           then do:
     3772             run gbl/wndsizer.p
     3773               (input  v-cntxt-db-num
     3774               ,input  v-cntxt-userid
     3775               ,input  v-diasize-proc-name
     3776               ,input  'height':u
     3777               ,output v-resize-value-str
     3778               ) .
     3779             if v-resize-value-str <> '':U
     3780             then do:
     3781               run diasize_change-height in this-procedure
     3782                 (input  integer(v-resize-value-str)
     3783                 ,input  true
     3784                 ) .
     3785               assign
     3786                 v-restore-saved = true
     3787               .
     3788             end.
     3789           end.
     3790           if connected("ub") = true
     3791           then do:
     3792             run gbl/wndsizer.p
     3793               (input  v-cntxt-db-num
     3794               ,input  v-cntxt-userid
     3795               ,input  v-diasize-proc-name
     3796               ,input  'width':u
     3797               ,output v-resize-value-str
     3798               ) .
     3799             if v-resize-value-str <> '':U
     3800             then do:
     3801               run diasize_change-width in this-procedure
     3802                 (input  integer(v-resize-value-str)
     3803                 ,input  true
     3804                 ) .
     3805               assign
     3806                 v-restore-saved = true
     3807               .
     3808             end.
     3809           end.
     3810           if v-restore-saved <> true
     3811           then do:
     3812             if v-diasize-wndmax = true
     3813             then do:
     3814               run diasize_maximize in this-procedure
     3815                 (input  true
     3816                 ) .
     3817             end.
     3818           end.
     3819         end.
     3820         else do:
     3821           if v-diasize-wndmax = true
     3822           then do:
     3823             run diasize_maximize in this-procedure
     3824               (input  true
     3825               ) .
     3826           end.
     3827         end.
     3828       end.
     3829     end.
     3830   end procedure.
     3831   procedure diasize_need-full-display :
     3832     define output parameter p-need-full-display as logical   no-undo .
     3833     do
     3834     on error undo, return error return-value
     3835     :
     3836       assign
     3837         p-need-full-display = v-diasize-need-full-display
     3838       .
     3839       assign
     3840         v-diasize-need-full-display = false
     3841       .
     3842     end.
     3843   end procedure.
     3844   procedure get-context :
     3845      define output parameter p-db-num as integer          no-undo.
     3846      define output parameter p-user-id as character        no-undo.
     3847      define variable v-login               as character    no-undo.
     3848      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3849      define buffer buf_user-login  for ub.user-login .
     3850      do
     3851      on error undo, return error
     3852      :
     3853            FIND FIRST buf_sys-ctrl no-lock.
     3854            ASSIGN
     3855               v-login = USERID("ub")
     3856               p-db-num = buf_sys-ctrl.db-num
     3857            .
     3858            FIND FIRST buf_user-login
     3859                 WHERE buf_user-login.db-num = p-db-num
     3860                   AND buf_user-login.user-login = v-login
     3861                 no-lock
     3862                 no-error
     3863                 .
     3864            IF AVAILABLE buf_user-login
     3865            THEN DO:
     3866               assign
     3867                  p-user-id = buf_user-login.user-id
     3868               .
     3869            END.
     3870      end.
     3871   end procedure.
     3872       run diasize_init in this-procedure .
     3873   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3874     run mainmenu_getcntxt in parparentproc
     3875       (output v-cntxt-db-num
     3876       ,output v-cntxt-userid
     3877       ,output v-cntxt-level
     3878       ,output v-cntxt-host-code-obj
     3879       ,output v-cntxt-obj-type
     3880       ,output v-cntxt-obj-code
     3881       ,output v-cntxt-db-num-obj
     3882       ,output v-cntxt-is-admin
     3883       ) .
     3884   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3885   on f5 of frame Dialog-Frame anywhere
     3886   do:
     3887     run OpenBr  in this-procedure ( input yes, input no, input '':U).
     3888       apply "VALUE-CHANGED" to spec-List.
     3889   end.
     3890   on F9 of frame Dialog-Frame anywhere
     3891       do:
     3892           if not available buf_contract-specif then  return no-apply.
     3893           find first ub.goods no-lock where ub.goods.gds-code = buf_contract-specif.gds-code .
     3894           gds-rec = recid (ub.goods) .
     3895           run ref/gds-form.w
     3896               (input  parParentProc
     3897               ,input  'ПРОСМОТР':U
     3898               ,input  v-cntxt-obj-type
     3899               ,input  v-cntxt-obj-code
     3900               ,input ?
     3901               ,input-output gds-rec
     3902               ).
     3903           apply "entry" to spec-List in frame Dialog-Frame.
     3904           return no-apply.
     3905       end.
     3906   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3907       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3908   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3909   do:
     3910     spec-List :SET-REPOSITIONED-ROW(16, "CONDITIONAL") .
     3911   end.
     3912   MAIN-BLOCK:
     3913   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3914       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3915       find first ub.clients no-lock where
     3916           ub.clients.obj-type = 'орг':U
     3917           and ub.clients.obj-code = p-host-code .
     3918       assign
     3919           frame Dialog-Frame:title = substitute(" Фирма: (&1) &2 Товарная спецификация к договорам"
     3920                                                     ,p-host-code
     3921                                                     ,ub.clients.obj-name).
     3922       run init-browse-p  in this-procedure  no-error .
     3923       run myenable in this-procedure no-error .
     3924       if error-status:error then  return .
     3925       OPEN QUERY spec-List FOR EACH tt_contract-specif NO-LOCK indexed-reposition.
     3926       WAIT-FOR GO OF FRAME Dialog-Frame.
     3927   END.
     3928   run disable_ui in this-procedure .
     3929   PROCEDURE disable_UI :
     3930       HIDE FRAME Dialog-Frame.
     3931   END PROCEDURE.
     3932   PROCEDURE enable_UI :
     3933       DISPLAY RADIO-find sch-str mark-num
     3934           WITH FRAME Dialog-Frame.
     3935       ENABLE b-quit B-mark b-sel B-Help B-allmark B-unmark RADIO-find sch-str
     3936           spec-List mark-num
     3937           WITH FRAME Dialog-Frame.
     3938       VIEW FRAME Dialog-Frame.
     3939   END PROCEDURE.
     3940   PROCEDURE init-browse-p :
     3941       define buffer buf_contract-specif for ub.contract-specif .
     3942       define buffer buf_trn-doc         for ub.trn-doc .
     3943       define buffer buf_clients         for ub.clients .
     3944       define buffer buf_doc-line        for ub.doc-line .
     3945       define buffer buf_goods           for ub.goods .
     3946       define variable ii as integer no-undo .
     3947       empty temp-table tt_contract-specif .
     3948       if p-doc-num <> 0 then
     3949       do:
     3950           for each ub.contract-specif no-lock where ub.contract-specif.contract-num = p-doc-num:
     3951               find first tt-gds-list no-lock where tt-gds-list.gds-code = ub.contract-specif.gds-code no-error .
     3952               if available (tt-gds-list) then next .
     3953               create tt_contract-specif .
     3954               buffer-copy ub.contract-specif to tt_contract-specif .
     3955           end.
     3956       end.
     3957       else
     3958       do:
     3959           find first buf_clients no-lock where recid(buf_clients) = recid_client no-error .
     3960           if available (buf_clients) then
     3961           do:
     3962               for each buf_trn-doc no-lock where buf_trn-doc.obj-code = v-cntxt-obj-code and
     3963                   buf_trn-doc.obj-type = v-cntxt-obj-type and
     3964                   buf_trn-doc.cli-code = buf_clients.obj-code and
     3965                   buf_trn-doc.cli-type = buf_clients.obj-type and
     3966                   buf_trn-doc.ext-doc-type = 'ie':U and
     3967                   buf_trn-doc.status_ = 'факт':U:
     3968                   for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code and
     3969                       buf_doc-line.obj-code = buf_trn-doc.obj-code and
     3970                       buf_doc-line.obj-type = buf_trn-doc.obj-type,
     3971                       first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and
     3972                       buf_goods.prod-code = buf_doc-line.prod-code and
     3973                       buf_goods.prod-type = buf_doc-line.prod-type:
     3974                       find first tt_contract-specif where tt_contract-specif.gds-code = buf_goods.gds-code no-error .
     3975                       if not available (tt_contract-specif) then
     3976                       do:
     3977                           create tt_contract-specif .
     3978                           assign
     3979                               tt_contract-specif.gds-code  = buf_goods.gds-code
     3980                               tt_contract-specif.artic     = buf_goods.artic
     3981                               tt_contract-specif.prod-code = buf_goods.prod-code
     3982                               tt_contract-specif.prod-type = buf_goods.prod-type
     3983                               tt_contract-specif.gds-name  = buf_goods.gds-name
     3984                               tt_contract-specif.unit-base = buf_goods.unit-base
     3985                               .
     3986                       end.
     3987                   end.
     3988               end.
     3989           end.
     3990       end.
     3991   END PROCEDURE.
     3992   PROCEDURE MyEnable :
     3993       DISPLAY
     3994           sch-str
     3995           RADIO-find
     3996           mark-num
     3997           WITH FRAME Dialog-Frame .
     3998       ENABLE
     3999           b-quit
     4000           B-mark
     4001           when (lookup("B-mark":U, bttns) > 0)
     4002           B-unmark
     4003           when (lookup("B-mark":U, bttns) > 0)
     4004           B-allmark
     4005           when (lookup("B-mark":U, bttns) > 0)
     4006           b-sel
     4007           when (lookup("b-sel":U, bttns) > 0)
     4008           B-Help
     4009           sch-str
     4010           RADIO-find
     4011           spec-List
     4012           mark-num
     4013           WITH FRAME Dialog-Frame .
     4014       VIEW FRAME Dialog-Frame .
     4015   END PROCEDURE.
     4016   PROCEDURE OpenBr :
     4017       define input  parameter p-open-query     as logical   no-undo .
     4018       define input  parameter p-find-next      as logical   no-undo .
     4019       define input  parameter p-find-condition as character no-undo .
     4020       define variable l-query-was-opened as logical no-undo .
     4021       define variable sort-column-phrase as character no-undo .
     4022       case sort-column-name :
     4023           when "" then
     4024               assign
     4025                   sort-column-phrase = ""  .
     4026           otherwise
     4027           assign
     4028               sort-column-phrase = "by " + sort-column-name .
     4029       end case.
     4030       define variable l-open-query as logical no-undo .
     4031       filter-point = filter-point0 .
     4032       IF AVAILABLE tt_contract-specif THEN
     4033       DO:
     4034           ASSIGN
     4035               v-doc-rec = recid (tt_contract-specif) .
     4036       END.
     4037   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4038   define variable  l-disable-where-30  as logical   no-undo .
     4039   define variable  l-filter-open-30    as logical   .
     4040   define variable  flt-rec-30       as recid     no-undo .
     4041   define variable  filter-name-30      as character no-undo .
     4042   define variable  where-phrase-30     as character no-undo .
     4043   define variable  sort-phrase-30      as character no-undo .
     4044   define variable  where-phrase-rus-30 as character no-undo .
     4045   define variable  sort-phrase-rus-30  as character no-undo .
     4046     run waitfram-show in this-procedure
     4047       (input "ЖДИТЕ ..."
     4048       ).
     4049   run gbl/flt-get.p
     4050     (input filter-point
     4051     ,output flt-rec-30
     4052     ,output filter-name-30
     4053     ,output where-phrase-30
     4054     ,output sort-phrase-30
     4055     ,output where-phrase-rus-30
     4056     ,output sort-phrase-rus-30
     4057     ).
     4058   if p-open-query then do:
     4059     assign
     4060       l-filter-open-30 = false
     4061     .
     4062     if flt-rec-30 <> ?
     4063       or sort-column-phrase > ""
     4064     then do:
     4065       define variable  parameter-2-30 as character no-undo .
     4066       define variable  parameter-3-30 as character no-undo .
     4067       define variable  parameter-4-30 as character no-undo .
     4068       define variable  parameter-5-30 as character no-undo .
     4069       define variable  parameter-6-30 as character no-undo .
     4070       define variable  parameter-7-30 as character no-undo .
     4071         assign
     4072         parameter-3-30 =
     4073                                 "FOR EACH tt_contract-specif"
     4074         parameter-4-30 =
     4075           (
     4076             if (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-30) <> ""
     4077             then  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " " + where-phrase-30
     4078             else "true"
     4079           )
     4080         parameter-5-30 = (" " + "" + " " + "")
     4081         parameter-6-30 = if sort-phrase-30 = ''
     4082                              then
     4083           (
     4084           " " + "  " +
     4085             " " + sort-column-phrase +
     4086           " " + " "
     4087           )
     4088                              else
     4089           (
     4090           " " + "  " +
     4091             " " + sort-column-phrase +
     4092           " " + sort-phrase-30
     4093           )
     4094         parameter-7-30 =
     4095           "   "
     4096       .
     4097       do
     4098       on stop undo, leave
     4099       on error undo, leave
     4100       :
     4101         assign
     4102           l-disable-where-30 =
     4103             (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-30 = "")
     4104         .
     4105         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4106                             ,input query spec-List:handle
     4107                             ,input parameter-3-30
     4108                             ,input parameter-4-30
     4109                             ,input parameter-5-30
     4110                             ,input parameter-6-30
     4111                             ,input parameter-7-30
     4112                             )
     4113         .
     4114         assign
     4115           l-filter-open-30 = true
     4116         .
     4117       end.
     4118       if l-filter-open-30 = false then do:
     4119         message
     4120           "Ошибка при фильтрации / сортировке" skip
     4121           "Будут показаны записи без учета фильтра" skip
     4122           view-as alert-box .
     4123       end.
     4124       else do:
     4125           assign
     4126             l-query-was-opened = true
     4127           .
     4128       end.
     4129     end.
     4130     if l-filter-open-30 = false then do:
     4131       OPEN QUERY spec-List FOR EACH tt_contract-specif NO-LOCK
     4132         where  tt_contract-specif.host-code = p-host-code
     4133     .
     4134         assign
     4135           l-query-was-opened = true
     4136         .
     4137     end.
     4138   end.
     4139   else do:
     4140     assign
     4141       v-doc-rec = recid( tt_contract-specif )
     4142     .
     4143     do
     4144     on stop undo, leave
     4145     on error undo, leave
     4146     :
     4147       if query spec-List:handle:get-buffer-handle(1) = (buffer tt_contract-specif:handle) then do:
     4148         assign
     4149         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4150         parameter-4-30 =
     4151           "where ":u +  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " ":u + where-phrase-30 + " ":u + p-find-condition + " " + ""
     4152         parameter-5-30 = "  "
     4153       .
     4154         run fltopend_fltfindd in this-procedure  (
     4155                             input this-procedure:handle
     4156                             ,input query spec-List:handle
     4157                             ,input rowid(tt_contract-specif)
     4158                             ,input logical(parameter-2-30)
     4159                             ,input no-lock
     4160                             ,input (buffer tt_contract-specif:handle)
     4161                             ,input parameter-4-30
     4162                             ,input parameter-5-30
     4163                             ) no-error.
     4164         .
     4165         assign
     4166           v-doc-rec = integer(return-value)
     4167           v-fltopend-rowid[1] = ?
     4168         .
     4169       end.
     4170       else do:
     4171         assign
     4172         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4173         parameter-3-30 =  "FOR EACH tt_contract-specif"
     4174         parameter-4-30 =
     4175           (
     4176             if (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-30) <> ""
     4177             then  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " " + where-phrase-30
     4178             else "true"
     4179           )
     4180         parameter-5-30 = (" " + "" + " " + "" + " " + p-find-condition)
     4181         parameter-6-30 = if sort-phrase-30 = ''
     4182                              then
     4183           (
     4184           " " + "  " +
     4185             " " + sort-column-phrase +
     4186           " " + " "
     4187           )
     4188                              else
     4189           (
     4190           " " + "  " +
     4191             " " + sort-column-phrase +
     4192           " " + sort-phrase-30
     4193           )
     4194         parameter-7-30 =
     4195           "   "
     4196       .
     4197         run fltopend_fltfindq in this-procedure  (
     4198                             input this-procedure:handle
     4199                             ,input query spec-List:handle
     4200                             ,input logical(parameter-2-30)
     4201                             ,input no-lock
     4202                             ,input parameter-3-30
     4203                             ,input parameter-4-30
     4204                             ,input parameter-5-30
     4205                             ,input parameter-6-30
     4206                             ,input parameter-7-30
     4207                             ,output v-fltopend-rowid
     4208                             ) no-error.
     4209         .
     4210         v-doc-rec = ?.
     4211       end.
     4212       assign
     4213         l-query-was-opened = true
     4214       .
     4215     end.
     4216   end.
     4217     run waitfram-hide in this-procedure .
     4218       IF v-doc-rec <> ? THEN
     4219       DO:
     4220           REPOSITION spec-List to RECID v-doc-rec NO-ERROR.
     4221       END.
     4222       APPLY
     4223           "entry" to spec-List in frame Dialog-Frame.
     4224   END PROCEDURE.
     4225   PROCEDURE proc-add-ass :
     4226       define buffer bb_contract-specif for ub.contract-specif  .
     4227       define variable v-ass-m    as logical   no-undo init false .
     4228       define variable v-log      as logical   no-undo .
     4229       define variable p-rid-list as character no-undo .
     4230       if not can-find( first temp-conn) then
     4231       do:
     4232           message "Не выделено ни одного товара !" view-as alert-box .
     4233           return .
     4234       end.
     4235       if v-cntxt-db-num <> 0 then
     4236       do :
     4237           if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     4238               ub.assortment-matrix.db-num = v-cntxt-db-num )  then v-ass-m = true  .
     4239       end.
     4240       else
     4241       do:
     4242           if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then v-ass-m = true  .
     4243       end.
     4244       if v-ass-m = false  then return .
     4245   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4246   do:
     4247     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4248       (input  v-cntxt-db-num
     4249       ,input  v-cntxt-userid
     4250       ,input  0
     4251       ,input  'actn_assort-matr-gds_add-def':U
     4252       ,input  'global':U
     4253       ,input  0
     4254       ,input  '':U
     4255       ,input  0
     4256       ,input  0
     4257       ,input  0
     4258       ,input  0
     4259       ,input  true
     4260       ,output v-log
     4261       )  .
     4262   end.
     4263       if not v-log then return  .
     4264       message "Добавить выбранные товары спецификации в Ассортиментные матрицы ?"
     4265           "Если ДА , укажите в какие."
     4266           view-as alert-box question
     4267           buttons yes-no
     4268           update v-okk as logical
     4269           .
     4270       if not v-okk then return .
     4271       run ref/assmatr.w (
     4272           input parParentProc
     4273           ,input "b-sel,b-mark"
     4274           ,input v-cntxt-obj-type
     4275           ,input v-cntxt-obj-code
     4276           ,input ?
     4277           ,input ?
     4278           ,input-output p-rid-list
     4279           ) no-error  .
     4280       if error-status :error then message
     4281               vss-workfile vss-revision vss-description skip
     4282               error-status :get-message(1) skip
     4283               return-value skip
     4284               ""
     4285               view-as alert-box error
     4286               .
     4287       run waitfram-show in this-procedure ( input "Добавление в Ассортиментные матрицы")  .
     4288       for each temp-conn,
     4289           first bb_contract-specif no-lock  where
     4290           recid(bb_contract-specif) = temp-conn.ri :
     4291           run add-assmatr in this-procedure ( input bb_contract-specif.gds-code
     4292               ,input p-rid-list) .
     4293       end.
     4294       run waitfram-hide in this-procedure .
     4295   END PROCEDURE.
     4296   PROCEDURE proc-export-excel :
