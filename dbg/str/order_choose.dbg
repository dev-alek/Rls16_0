       45   procedure vss-get-info :
       46     define output parameter p-vss-revision    like vss-revision    no-undo .
       47     define output parameter p-vss-author      like vss-author      no-undo .
       48     define output parameter p-vss-date        like vss-date        no-undo .
       49     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       50     define output parameter p-vss-archive     like vss-archive     no-undo .
       51     define output parameter p-vss-description like vss-description no-undo .
       52     assign
       53       p-vss-revision    = vss-revision
       54       p-vss-author      = vss-author
       55       p-vss-date        = vss-date
       56       p-vss-workfile    = vss-workfile
       57       p-vss-archive     = vss-archive
       58       p-vss-description = vss-description
       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define new global shared variable g#language as character no-undo .
      100   if g#language <> '' and g#language <> 'rus':U then do:
      101     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      102   end.
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   define variable v-waitfram-action01         as character   no-undo .
      105   define variable v-waitfram-action02         as character   no-undo .
      106   define variable v-waitfram-action03         as character   no-undo .
      107   define variable mWaitFramTextBeg            as character   no-undo.
      108   define variable mWaitFramTextEnd            as character   no-undo.
      109   define variable mWaitFramView               as logical     no-undo.
      110   define variable mWaitProcEvent              as logical     no-undo init yes.
      111   define variable mWaitFramInterval           as integer     no-undo init 1 .
      112   define variable mWaitFramStop               as logical     no-undo.
      113   define variable mWaitFramStopUser           as logical     no-undo.
      114   define variable mWaitFramStopTimeOut        as logical     no-undo.
      115   define variable mWaitFramStartProc          as datetime-tz no-undo.
      116   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      117   define button B-WaitFramStop auto-end-key
      118        label "Стоп"
      119        size 10 by 1 tooltip "Остоновить процесс".
      120   define button B-viewProcInfo
      121        label "Информация"
      122        size 15 by 1 tooltip "Информация о процесс".
      123   define frame waitfram
      124     v-waitfram-action01 format "x(72)" no-label skip
      125     v-waitfram-action02 format "x(72)" no-label skip
      126     v-waitfram-action03 format "x(72)" no-label skip
      127     B-viewProcInfo
      128     B-WaitFramStop at row 4 col 30
      129     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      130     .
      131   define new global shared variable mBatchMode as logical no-undo init ?.
      132   define variable mFramBachModHandle as handle no-undo.
      133   mFramBachModHandle = frame waitfram:handle.
      134   define variable mFameOldVis as logical no-undo.
      135   define variable mVisCUrentVin as logical no-undo.
      136   if session:batch-mode
      137   then
      138      mBatchMode = yes.
      139   if mBatchMode = ? then do:
      140     mVisCUrentVin = current-window:visible.
      141     mFameOldVis = mFramBachModHandle:visible.
      142     mFramBachModHandle:visible  = yes.
      143     mBatchMode = mFramBachModHandle:visible ne yes.
      144     mFramBachModHandle:visible = mFameOldVis.
      145     current-window:visible = mVisCUrentVin.
      146   end.
      147    if  log-manager:logfile-name ne ?
      148     then DO:
      149         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      150         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      151         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      152     end.
      153   on choose of B-WaitFramStop in frame waitfram
      154   do:
      155     mWaitFramStop = yes.
      156     mWaitFramStopUser = yes.
      157   end.
      158   function waitfram-check-timeout returns logical():
      159      define variable vtime as int64 no-undo.
      160      if mWaitFramStopTimeOut
      161      then
      162         return yes.
      163      vtime = ( now - mWaitFramStartProc ) / 1000 .
      164      if     mWaitFramTimeOut ne ?
      165         and mWaitFramTimeOut ne 0
      166         and mWaitFramTimeOut lt vtime
      167      then do:
      168         mWaitFramStopTimeOut = yes.
      169      end.
      170      return mWaitFramStopTimeOut.
      171   end.
      172   procedure waitfram-hide :
      173     if not session:batch-mode
      174     then do
      175     on error undo, return error return-value
      176     :
      177       pause 0 before-hide .
      178       if not mBatchMode then
      179         hide frame waitfram .
      180     if     not mWaitFramView
      181        and mWaitProcEvent
      182     then
      183       process events .
      184     end.
      185   end procedure.
      186   procedure waitfram-show :
      187     define input  parameter p-message as character no-undo .
      188     define variable v-left-margin as integer   no-undo .
      189     if not session:batch-mode
      190     then do
      191     on error undo, return error return-value
      192     :
      193       if length(p-message) <= 70 then do:
      194         assign
      195           v-left-margin = integer((70 - length(p-message)) / 2)
      196         .
      197         assign
      198           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      199         .
      200         assign
      201           v-waitfram-action01 = " "
      202           v-waitfram-action02 = " "
      203                                    + fill(" ", v-left-margin)
      204                                    + p-message
      205           v-waitfram-action03 = " "
      206         .
      207       end.
      208       else do:
      209         define variable vRindex1 as integer no-undo.
      210         define variable vRindex2 as integer no-undo.
      211         vRindex1 = r-index(p-message," ",70).
      212         if vRindex1 = 0
      213         then
      214            vRindex1 = 70.
      215         if length(p-message)  <= vRindex1 + 70 then do:
      216           assign
      217             v-waitfram-action01 = " "
      218             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      219             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      220           .
      221         end.
      222         else do:
      223           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      224           if vRindex2 <= vRindex1
      225           then
      226              vRindex2 = vRindex1 + 70.
      227           assign
      228             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      230             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      231           .
      232         end.
      233       end.
      234       B-viewProcInfo:visible   in frame waitfram = no.
      235       B-viewProcInfo:sensitive in frame waitfram = no.
      236       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      237       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      238       if  (   mWaitFramView
      239          or  mWaitProcEvent)
      240          and not mBatchMode
      241       then
      242          display
      243             v-waitfram-action01 skip
      244             v-waitfram-action02 skip
      245             v-waitfram-action03 skip
      246          with frame waitfram .
      247       if     mWaitFramView
      248          then do:
      249             if     mWaitFramInterval ne ?
      250                and not mBatchMode
      251             then
      252                wait-for go of frame waitfram pause mWaitFramInterval.
      253          end.
      254          else
      255             if     mWaitProcEvent
      256                and not mBatchMode
      257             then
      258                process events .
      259     end.
      260   end procedure.
      261      procedure waitfram-show-this:
      262         define input  parameter iInterval as int64 no-undo.
      263         define variable vtime as int64 no-undo.
      264         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      265         mWaitFramInterval = iInterval.
      266         run waitfram-show (substitute("&1&2 &3&4" ,
      267                                       mWaitFramTextBeg ,
      268                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      269                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      270                                       mWaitFramTextEnd
      271                                      )
      272                           ).
      273      end.
      274      procedure WaitFramRunPause:
      275         define input  parameter iInterval as dec no-undo.
      276         define variable vStart  as datetime-tz no-undo.
      277         define variable vend    as datetime-tz no-undo.
      278         define variable vint as int64 no-undo.
      279         define variable vOk as logical no-undo.
      280         vStart = now.
      281         vend   = vStart.
      282         publish "WaitFramPause" (iInterval,output vOk).
      283         vend   =  now.
      284         vint = vend - vStart.
      285         vint = iInterval - vint / 1000.
      286         if     not mWaitFramStop
      287            and (   vint > 0
      288                 or (    not vOk
      289                     and iInterval eq ?
      290                     )
      291                 )
      292         then
      293            run waitfram-show-this (iInterval).
      294         vend   =  now.
      295         vint = vend - vStart.
      296         vint = iInterval - vint / 1000.
      297         if     not mWaitFramStop
      298            and vint > 0
      299         then do:
      300            run gbl/pause.p (vint * 1000).
      301         end.
      302         if iInterval ne ?
      303         then
      304            publish "WaitFramStop".
      305         waitfram-check-timeout().
      306      end.
      307      procedure WaitFramWaitFor:
      308         define input  parameter iInterval as dec no-undo.
      309         assign
      310            mWaitFramStartProc   = now
      311            mWaitFramStopUser    = no
      312            mWaitFramStopTimeOut = no
      313         .
      314         block-wait:
      315         do while not mWaitFramStop:
      316            run WaitFramRunPause (iInterval).
      317            if  waitfram-check-timeout()
      318            then do:
      319               leave block-wait.
      320            end.
      321         end.
      322         run waitfram-hide.
      323      end.
      324   procedure waitfram-join :
      325     define input  parameter p-line-1  as character no-undo .
      326     define input  parameter p-line-2  as character no-undo .
      327     define input  parameter p-line-3  as character no-undo .
      328     define output parameter p-message as character no-undo .
      329     do
      330     on error undo, return error return-value
      331     :
      332       assign
      333         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      334                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      335                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      336       .
      337     end.
      338   end procedure.
      339   function waitfram-join-function returns character
      340     (input p-line-1 as character
      341     ,input p-line-2 as character
      342     ,input p-line-3 as character
      343     ).
      344     define variable v-message as character no-undo .
      345     run waitfram-join in this-procedure
      346       (input  p-line-1
      347       ,input  p-line-2
      348       ,input  p-line-3
      349       ,output v-message
      350       ) .
      351     return v-message .
      352   end function .
      353   define new global shared variable g#library  as handle no-undo .
      354   define new global shared variable g#library2 as handle no-undo .
      355   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   procedure cur-time :
      357      define output parameter p-today as date      no-undo .
      358      define output parameter p-time  as integer   no-undo .
      359     do
      360     on error undo, return error
      361     :
      362       define variable v-date1 as date      no-undo .
      363       define variable v-date2 as date      no-undo .
      364       define variable v-time  as integer   no-undo .
      365       assign
      366         v-date1 = today
      367         v-time  = time
      368         v-date2 = today
      369       .
      370       if v-date1 <> v-date2
      371       then do:
      372         assign
      373           v-date1 = today
      374           v-time  = v-time
      375         .
      376       end.
      377       assign
      378         p-today = v-date1
      379         p-time  = v-time
      380       .
      381     end.
      382   end.
      383   function cur-time-date returns character
      384   :
      385     return string(today, '99/99/9999':U) .
      386   end.
      387   function cur-time-mjd returns decimal
      388   :
      389     define variable v-date as date      no-undo .
      390     define variable v-time as integer   no-undo .
      391     run cur-time in this-procedure
      392       (output v-date
      393       ,output v-time
      394       ) .
      395     return integer(v-date) - 2400002 + (v-time / 86400) .
      396   end.
      397   function cur-time-get-ending-index returns integer
      398   (input p-number as integer
      399   )
      400   :
      401     if p-number < 0
      402     or p-number = ?
      403     then do:
      404       return 1 .
      405     end.
      406     define variable v-rest as integer   no-undo .
      407     assign
      408       p-number = p-number modulo 100
      409     .
      410     if p-number < 20
      411     then do:
      412       assign
      413         v-rest = p-number
      414       .
      415     end.
      416     else do:
      417       assign
      418         v-rest = p-number modulo 10
      419       .
      420     end.
      421     case v-rest :
      422       when 1
      423       then do:
      424         return 2 .
      425       end.
      426       when 2 or
      427       when 3 or
      428       when 4
      429       then do:
      430         return 3 .
      431       end.
      432       otherwise do:
      433         return 1 .
      434       end.
      435     end case .
      436   end.
      437   procedure cur-time-mjd-to-date :
      438      define input  parameter i-mjd-diff as decimal no-undo.
      439      define output parameter o-Date     as date    no-undo.
      440      define output parameter o-Time     as integer no-undo.
      441      define variable v-day-number as integer   no-undo .
      442      if    i-mjd-diff < 0
      443         or i-mjd-diff = ?
      444      then do:
      445         return "?" .
      446      end.
      447      assign
      448         v-day-number = truncate(i-mjd-diff,0).
      449         o-Date = date(v-day-number + 2400002).
      450         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      451     .
      452   end.
      453   function cur-time-mjd-to-string returns character
      454   (input p-mjd-diff as decimal
      455   )
      456   :
      457     define variable v-day-number as integer   no-undo .
      458     define variable v-seconds    as integer   no-undo .
      459     define variable v-hour       as integer   no-undo .
      460     define variable v-min        as integer   no-undo .
      461     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      462     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      463     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      464     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      465     if p-mjd-diff < 0
      466     or p-mjd-diff = ?
      467     then do:
      468       return "?" .
      469     end.
      470     assign
      471       v-day-number = integer(truncate(p-mjd-diff,0))
      472       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      473     .
      474     if v-seconds > 86400
      475     then do:
      476       assign
      477         v-seconds = 86400 - 1
      478       .
      479     end.
      480     if v-seconds < 0
      481     then do:
      482       assign
      483         v-seconds = 0
      484       .
      485     end.
      486     assign
      487       v-hour = truncate(v-seconds / 3600, 0)
      488     .
      489     assign
      490       v-seconds = v-seconds modulo 3600
      491     .
      492     assign
      493       v-min = truncate(v-seconds / 60, 0)
      494     .
      495     assign
      496       v-seconds = v-seconds modulo 60
      497     .
      498     return
      499         (if v-day-number <> 0
      500           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      501           else ""
      502         )
      503       + (if v-day-number <> 0 or v-hour <> 0
      504           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      505           else ""
      506         )
      507       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      508           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      509           else ""
      510         )
      511       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      512       .
      513   end.
      514   function cur-time-string returns character
      515   :
      516     define variable v-date as date      no-undo .
      517     define variable v-time as integer   no-undo .
      518     run cur-time in this-procedure
      519       (output v-date
      520       ,output v-time
      521       ) .
      522     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      523   end.
      524   function cur-time-string-sec returns character
      525   :
      526     define variable v-date as date      no-undo .
      527     define variable v-time as integer   no-undo .
      528     run cur-time in this-procedure
      529       (output v-date
      530       ,output v-time
      531       ) .
      532     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      533   end.
      534   function cur-time-custom  returns character
      535   (input p-prefix as character
      536   ,input p-date-format as character
      537   ,input p-delimiter as character
      538   ,input p-time-format as character
      539   ,input p-suffix as character
      540   )
      541   :
      542     define variable v-date as date      no-undo .
      543     define variable v-time as integer   no-undo .
      544     run cur-time in this-procedure
      545       (output v-date
      546       ,output v-time
      547       ) .
      548     return
      549       p-prefix
      550       + string(v-date, p-date-format)
      551       + p-delimiter
      552       + string(v-time, p-time-format)
      553       + p-suffix
      554       .
      555   end.
      556   function cur-time-print  returns character
      557   :
      558     define variable v-date as date      no-undo .
      559     define variable v-time as integer   no-undo .
      560     run cur-time in this-procedure
      561       (output v-date
      562       ,output v-time
      563       ) .
      564     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      565   end.
      566   function cur-time-datetime returns datetime
      567   :
      568     define variable v-char as character no-undo .
      569     define variable v-datetime as datetime no-undo .
      570     v-char = cur-time-string().
      571     v-datetime = datetime(v-char).
      572     return  v-datetime.
      573   end.
      574   function cur-time-string-msec returns character
      575   :
      576     define variable v-date as datetime  no-undo .
      577     v-date = now.
      578     return string(v-date) .
      579   end.
      580   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      582   define  shared variable RepPathName        as character no-undo .
      583   define  shared variable PrintRubl          as logical   no-undo .
      584   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   define  stream PrnLibStream.
      586   procedure prn-lib-prn-file :
      587     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      588     define input parameter p-DIsabledoptions as integer no-undo .
      589     define variable v-report-name as character no-undo .
      590     define variable v-user-action as character no-undo .
      591     define variable v-printed     as logical   no-undo .
      592     define variable v-exist       as logical   no-undo .
      593     do
      594       on error undo, return error
      595       :
      596       run prn-lib-get-report-name  in this-procedure (
      597         input parParentProc
      598         ,output v-report-name
      599         ).
      600   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      602     (input  v-report-name
      603     ,input  2
      604     ,output v-exist
      605     )  .
      606       if NOT v-exist then
      607       DO:
      608         Message
      609           "Нет заданий на печать ! "
      610           view-as alert-box .
      611         Return  .
      612       End.
      613       run gbl/prnfilen.w
      614         (input  ""
      615         ,input  p-DisabledOptions
      616         ,input  string(v-report-name )
      617         ,input  7
      618         ,output v-user-action
      619         ,output v-printed
      620         ) .
      621       if v-printed then
      622       do:
      623         return "YES" .
      624       end.
      625       else
      626       do:
      627         return "NO" .
      628       end.
      629     end.
      630   end procedure.
      631   procedure prn-lib-open-stream :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-page-size    as integer no-undo .
      634     define input parameter p-is-stream    as logical no-undo .
      635     define input parameter p-append       as logical no-undo .
      636     define variable v-report-name as character no-undo .
      637     do
      638       on error undo, return error
      639       :
      640       run prn-lib-get-report-name  in this-procedure (
      641         input parParentProc
      642         ,output v-report-name
      643         ).
      644       if p-is-stream then
      645       do:
      646         if p-append then
      647         do:
      648           output stream PrnLibStream to value( v-report-name )
      649             page-size value(p-page-size) append .
      650         end.
      651         if not p-append then
      652         do:
      653           output stream PrnLibStream to value( v-report-name )
      654             page-size value(p-page-size) .
      655         end.
      656       end.
      657       if not p-is-stream then
      658       do:
      659         if p-append then
      660         do:
      661           output to value( v-report-name )
      662             page-size value(p-page-size) append .
      663         end.
      664         if not p-append then
      665         do:
      666           output to value( v-report-name )
      667             page-size value(p-page-size) .
      668         end.
      669       end.
      670     end.
      671   end procedure.
      672   procedure prn-lib-open-exp :
      673     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      674     define input parameter p-is-stream    as logical no-undo .
      675     define input parameter p-is-append    as logical no-undo .
      676     define output parameter p-ReportFileName as char init "report" no-undo.
      677     define output parameter p-process as logical no-undo .
      678     define variable glog as logical no-undo .
      679     do
      680       on error undo, return error
      681       :
      682       SYSTEM-DIALOG GET-FILE p-ReportFileName
      683         TITLE      "Укажите путь"
      684         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      685         ASK-OVERWRITE
      686         CREATE-TEST-FILE
      687         SAVE-AS
      688         USE-FILENAME
      689         DEFAULT-EXTENSION "txt"
      690         UPDATE glog
      691         .
      692       if not glog then  return.
      693       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      694       if p-is-stream then
      695       do:
      696         if p-is-append then
      697         do:
      698           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      699         end.
      700         else
      701         do:
      702           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      703         end.
      704       end.
      705       else
      706       do:
      707         if p-is-append then
      708         do:
      709           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      710         end.
      711         else
      712         do:
      713           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      714         end.
      715       end.
      716       p-process = yes.
      717     end.
      718   end procedure.
      719   procedure prn-lib-get-report-name :
      720     define input parameter parParentProc  as widget-handle no-undo.
      721     define output parameter p-report-name as character no-undo .
      722     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      723   end procedure.
      724   procedure prn-lib-reportviewer-report-name :
      725     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      726     define input parameter p-report-name-html as character no-undo .
      727     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      728   end procedure.
      729   procedure prn-lib-reportviewer :
      730     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      731     define input parameter p-report-name-html as character no-undo .
      732     define input parameter p-param        as character no-undo .
      733     define variable v-excel           as character no-undo init 'TRUE' .
      734     define variable v-value-character as character no-undo .
      735     define variable v-value-integer   as character no-undo .
      736     define variable v-value-date      as date      no-undo .
      737     define variable v-value-decimal   as decimal   no-undo .
      738     define variable rep-excel         as logical   no-undo .
      739     define variable excel-string      as character no-undo .
      740     define variable v-param-type      as character no-undo .
      741     define variable v-tth             as handle    no-undo .
      742     run adm/shattri.p (
      743       input "get":U
      744       ,input  ""
      745       ,input  0
      746       ,input  'report-glob':U
      747       ,input  'rep-excel':U
      748       ,output v-value-character
      749       ,output v-value-date
      750       ,output v-value-decimal
      751       ,output v-value-integer
      752       ,output rep-excel
      753       ,output v-param-type
      754       ,INPUT-OUTPUT table-handle v-tth
      755       )  .
      756     if rep-excel then v-excel = "TRUE" .
      757     else v-excel = "FALSE" .
      758     if p-param eq ""
      759     then
      760        p-param = "EXCEL:" + v-excel.
      761     else
      762        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      763     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      764   end procedure.
      765   define new global shared variable g#libbcrcn as handle no-undo .
      766   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   procedure integerm :
      768     define input  parameter p-string      as character no-undo .
      769     define input  parameter p-allow-sign  as logical   no-undo .
      770     define input  parameter p-allow-comma as logical   no-undo .
      771     define output parameter p-value       as integer   no-undo .
      772     define output parameter p-data-valid  as logical   no-undo .
      773     define output parameter p-message     as character no-undo .
      774     define variable v-replace-string as character no-undo .
      775     do
      776     on error undo, return error return-value
      777     :
      778       if p-string = ?
      779       then do:
      780         assign
      781           p-value      = ?
      782           p-data-valid = false
      783           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      784         .
      785         return .
      786       end.
      787       if p-string = ""
      788       then do:
      789         assign
      790           p-value      = ?
      791           p-data-valid = false
      792           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      793         .
      794         return .
      795       end.
      796       assign
      797         p-value = integer(p-string) no-error
      798       .
      799       if error-status :error = true
      800       then do:
      801         assign
      802           p-value      = ?
      803           p-data-valid = false
      804           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      805                                    ,p-string
      806                                    )
      807         .
      808         return .
      809       end.
      810       if index(p-string, ' ':u) > 0
      811       then do:
      812         assign
      813           p-value      = ?
      814           p-data-valid = false
      815           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      816                                    + "Строка содержит символы пробела"
      817                                    ,p-string
      818                                    )
      819         .
      820         return .
      821       end.
      822       assign
      823         v-replace-string = p-string
      824         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      825         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      826         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      827         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      828         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      829         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      830         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      831         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      832         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      833       .
      834       if p-allow-sign = true
      835       then do:
      836         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      837         then do:
      838           assign
      839             v-replace-string = substring(v-replace-string, 2)
      840           .
      841         end.
      842       end.
      843       else do:
      844         if substring(v-replace-string, 1, 1) = '+':u
      845         then do:
      846           assign
      847             p-value      = ?
      848             p-data-valid = false
      849             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      850                                     + "Задан параметр недопустимости знака челого числа. "
      851                                     + "Строка содержит символ плюс. "
      852                                     ,p-string
      853                                     )
      854           .
      855           return .
      856         end.
      857         if substring(v-replace-string, 1, 1) = '-':u
      858         then do:
      859           assign
      860             p-value      = ?
      861             p-data-valid = false
      862             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      863                                     + "Задан параметр недопустимости знака челого числа. "
      864                                     + "Строка содержит символ минус. "
      865                                     ,p-string
      866                                     )
      867           .
      868           return .
      869         end.
      870       end.
      871       if p-allow-comma = true
      872       then do:
      873         assign
      874           v-replace-string = replace(v-replace-string, ',', '')
      875         .
      876       end.
      877       else do:
      878         if index(v-replace-string, ',') > 0
      879         then do:
      880           assign
      881             p-value      = ?
      882             p-data-valid = false
      883             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      884                                     + "Задан параметр недопустимости знака разделителя тысяч."
      885                                     + "Строка содержит знак разделителя тысяч. "
      886                                     ,p-string
      887                                     )
      888           .
      889           return .
      890         end.
      891       end.
      892       if index(p-string, '.') > 0
      893       then do:
      894         assign
      895           p-value      = ?
      896           p-data-valid = false
      897           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      898                                    + "Строка содержит знак десятичной точки"
      899                                    ,p-string
      900                                    )
      901         .
      902         return .
      903       end.
      904       if v-replace-string <> fill('9', length(v-replace-string))
      905       then do:
      906         assign
      907           p-value      = ?
      908           p-data-valid = false
      909           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      910                                    + "Встречены символы, недопустимые для целого числа '&2'"
      911                                    ,p-string
      912                                    ,replace(v-replace-string, '9', '')
      913                                    )
      914         .
      915         return .
      916       end.
      917       assign
      918         p-data-valid = true
      919         p-message    = ""
      920       .
      921     end.
      922   end procedure.
      923   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      925   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      926   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      927   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      928   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      929   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      930   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      931   procedure uf-name :
      932     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      933     define output parameter p-use-List_     as logical   no-undo .
      934     define output parameter p-type-List_     as character no-undo .
      935     define output parameter p-format-List_   as character no-undo .
      936     define output parameter p-use-Naim      as logical   no-undo .
      937     define output parameter p-type-Naim      as character no-undo .
      938     define output parameter p-format-Naim    as character no-undo .
      939     define output parameter p-use-print-graft as logical   no-undo .
      940     define output parameter p-use-sort-gr   as logical   no-undo .
      941     define output parameter p-use-type-price as logical   no-undo .
      942     define output parameter p-use-type-val  as logical   no-undo .
      943     define output parameter p-label          as character no-undo .
      944     define output parameter p-tooltip        as character no-undo .
      945     define output parameter p-user-can-edit  as logical   no-undo .
      946     define output parameter p-output-display as logical   no-undo .
      947     define output parameter p-other          as character no-undo .
      948     do
      949     on error undo, return error
      950     :
      951       case p-code :
      952               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      953               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      954               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      955               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      956               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      957               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      958               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      959               when 'findocs-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника платежей"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника платежей"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      960               when 'fin-obi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
