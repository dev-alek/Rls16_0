     1028   procedure uf-get :
     1029     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1030     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1031     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1032     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1033     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1034     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1035     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1036     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1037     do
     1038     on error undo, return error
     1039     :
     1040       define buffer buf_usr-flt for ubflt.usr-flt .
     1041       define variable v-use-List_     as logical   no-undo .
     1042       define variable v-type-List_     as character no-undo .
     1043       define variable v-format-List_   as character no-undo .
     1044       define variable v-use-Naim      as logical   no-undo .
     1045       define variable v-type-Naim      as character no-undo .
     1046       define variable v-format-Naim    as character no-undo .
     1047       define variable v-use-print-graft as logical   no-undo .
     1048       define variable v-use-sort-gr     as logical   no-undo .
     1049       define variable v-use-type-price  as logical   no-undo .
     1050       define variable v-use-type-val    as logical   no-undo .
     1051       define variable v-label          as character no-undo .
     1052       define variable v-tooltip        as character no-undo .
     1053       define variable v-user-can-edit  as logical   no-undo .
     1054       define variable v-output-display as logical   no-undo .
     1055       define variable v-other          as character no-undo .
     1056       run uf-name in this-procedure
     1057          (input  entry(1, p-code, chr(4))
     1058         ,output v-use-List_
     1059         ,output v-type-List_
     1060         ,output v-format-List_
     1061         ,output v-use-Naim
     1062         ,output v-type-Naim
     1063         ,output v-format-Naim
     1064         ,output v-use-print-graft
     1065         ,output v-use-sort-gr
     1066         ,output v-use-type-price
     1067         ,output v-use-type-val
     1068         ,output v-label
     1069         ,output v-tooltip
     1070         ,output v-user-can-edit
     1071         ,output v-output-display
     1072         ,output v-other
     1073         ) no-error .
     1074       if error-status :error then do:
     1075         undo, return error return-value .
     1076       end.
     1077       find first buf_usr-flt no-lock where
     1078                  buf_usr-flt.Call-point     = p-code AND
     1079                  buf_usr-flt.user-name       = p-user-name
     1080         no-error .
     1081       if avail buf_usr-flt then do:
     1082         assign
     1083         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1084         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1085         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1086         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1087         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1088         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1089         .
     1090       end.
     1091       else do:
     1092         assign
     1093         p-List_        = (if v-use-List_       then "":U                    else ?)
     1094         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1095         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1096         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1097         p-type-price   = (if v-use-type-price  then no                      else ?)
     1098         p-type-val     = (if v-use-List_       then no                      else ?)
     1099         .
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure uf-set :
     1104     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1105     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1106     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1107     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1108     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1109     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1110     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1111     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1112     do
     1113     on error undo, return error
     1114     :
     1115       define buffer buf_usr-flt for ubflt.usr-flt .
     1116       define variable v-use-List_     as logical   no-undo .
     1117       define variable v-type-List_     as character no-undo .
     1118       define variable v-format-List_   as character no-undo .
     1119       define variable v-use-Naim      as logical   no-undo .
     1120       define variable v-type-Naim      as character no-undo .
     1121       define variable v-format-Naim    as character no-undo .
     1122       define variable v-use-print-graft as logical   no-undo .
     1123       define variable v-use-sort-gr   as logical   no-undo .
     1124       define variable v-use-type-price as logical   no-undo .
     1125       define variable v-use-type-val  as logical   no-undo .
     1126       define variable v-tooltip        as character no-undo .
     1127       define variable v-label          as character no-undo .
     1128       define variable v-user-can-edit  as logical   no-undo .
     1129       define variable v-output-display as logical   no-undo .
     1130       define variable v-other          as character no-undo .
     1131       run uf-name in this-procedure
     1132         (input  entry(1, p-code, chr(4))
     1133         ,output v-use-List_
     1134         ,output v-type-List_
     1135         ,output v-format-List_
     1136         ,output v-use-Naim
     1137         ,output v-type-Naim
     1138         ,output v-format-Naim
     1139         ,output v-use-print-graft
     1140         ,output v-use-sort-gr
     1141         ,output v-use-type-price
     1142         ,output v-use-type-val
     1143         ,output v-label
     1144         ,output v-tooltip
     1145         ,output v-user-can-edit
     1146         ,output v-output-display
     1147         ,output v-other
     1148         ) no-error .
     1149       if error-status :error then do:
     1150         undo, return error return-value .
     1151       end.
     1152       find first buf_usr-flt where
     1153                  buf_usr-flt.Call-point     = p-code AND
     1154                  buf_usr-flt.user-name       = p-user-name
     1155         no-error .
     1156       if not avail buf_usr-flt then do:
     1157           create buf_usr-flt .
     1158           assign
     1159           buf_usr-flt.call-point = p-code
     1160           buf_usr-flt.user-name  = p-user-name
     1161           .
     1162       end.
     1163       if avail buf_usr-flt then do:
     1164        assign
     1165        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1166        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1167        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1168        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1169        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1170        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1171       .
     1172       release buf_usr-flt.
     1173       end.
     1174       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1175     end.
     1176   end procedure.
     1177   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178     define variable v-cntxt-db-num        as integer   no-undo .
     1179     define variable v-cntxt-userid        as character no-undo .
     1180     define variable v-cntxt-level         as character no-undo .
     1181     define variable v-cntxt-host-code-obj as integer   no-undo .
     1182     define variable v-cntxt-obj-type      as character no-undo .
     1183     define variable v-cntxt-obj-code      as integer   no-undo .
     1184     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1185     define variable v-cntxt-is-admin      as logical   no-undo .
     1186   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1188   procedure fltopend_fltopend :
     1189   define input parameter p-parent-handle as handle no-undo .
     1190   define input parameter p-qh as handle no-undo .
     1191   define input parameter p-flt-open-open-query  as character no-undo .
     1192   define input parameter p-where-cond as character no-undo .
     1193   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1194   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1195   define input parameter p-indexed-reposition as character no-undo .
     1196     do
     1197     on error undo, return error
     1198     :
     1199   define variable v-prepare-string as character no-undo .
     1200   define variable glog as logical no-undo .
     1201   assign
     1202   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1203                      p-where-cond + chr(32)  +
     1204                      p-use-indFIRST-query-tail + chr(32) +
     1205                      p-use-ind-sort-clmn-by + chr(32) +
     1206                      p-indexed-reposition
     1207   .
     1208   assign
     1209   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1210   if not glog
     1211   or error-status:error then do:
     1212     message error-status:get-message(1) view-as alert-box .
     1213     undo, return error .
     1214   end.
     1215   assign
     1216   glog = p-qh:query-open no-error .
     1217   if not glog
     1218   or error-status:error then do:
     1219     message error-status:get-message(1) view-as alert-box .
     1220     undo, return error .
     1221   end.
     1222     end.
     1223   end procedure.
     1224   procedure fltopend_fltfindd :
     1225   define input parameter p-parent-handle as handle no-undo .
     1226   define input parameter p-qh as handle no-undo .
     1227   define input parameter p-rowid as rowid no-undo .
     1228   define input parameter p-next as logical no-undo .
     1229   define input parameter p-lock as integer no-undo .
     1230   define input parameter p-bh as handle no-undo .
     1231   define input parameter p-where-cond as character no-undo .
     1232   define input parameter p-use-index-phrase as character no-undo .
     1233   define variable glog as logical no-undo .
     1234   define variable v-qh as handle no-undo .
     1235   define variable v-bh as handle no-undo .
     1236   define variable v-recid as recid no-undo .
     1237   define variable v-prepare-string as character no-undo .
     1238   do
     1239   on error undo, return error
     1240   on stop undo, return error
     1241   :
     1242     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1243     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1244     create query v-qh.
     1245     v-qh:set-buffers(v-bh).
     1246     v-prepare-string = substitute("for each &1 &2 &3"
     1247                                     ,v-bh:name
     1248                                     ,p-where-cond
     1249                                     ,p-use-index-phrase).
     1250     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1251     if not glog then do:
     1252       delete object v-qh.
     1253       delete object v-bh.
     1254       undo, return error .
     1255     end.
     1256     glog = v-qh:query-open no-error .
     1257     if not glog then do:
     1258       delete object v-qh.
     1259       delete object v-bh.
     1260       undo, return error .
     1261     end.
     1262     if p-next then do:
     1263       v-qh:reposition-to-rowid(p-rowid) no-error .
     1264       glog = v-qh:get-next( p-lock) no-error .
     1265       glog = v-qh:get-next( p-lock) no-error .
     1266       if not glog or v-qh:query-off-end = yes then do:
     1267         glog = v-qh:get-first( p-lock) no-error .
     1268       end.
     1269     end.
     1270     else do:
     1271       glog = v-qh:get-first( p-lock) no-error .
     1272     end.
     1273     v-recid = v-bh:recid no-error .
     1274     delete object v-qh.
     1275     delete object v-bh.
     1276     return string(v-recid) .
     1277   end.
     1278   end procedure.
     1279   procedure fltopend_fltfindq :
     1280   define input parameter p-parent-handle as handle no-undo .
     1281   define input parameter p-qh as handle no-undo .
     1282   define input parameter p-next as logical no-undo .
     1283   define input parameter p-lock as integer no-undo .
     1284   define input parameter p-flt-open-open-query  as character no-undo .
     1285   define input parameter p-where-cond as character no-undo .
     1286   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1287   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1288   define input parameter p-indexed-reposition as character no-undo .
     1289   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1290   define variable glog as logical no-undo .
     1291   define variable v-qh as handle no-undo .
     1292   define variable v-bh as handle no-undo extent 18.
     1293   define variable v-rowid as rowid no-undo extent 18.
     1294   define variable v-ii as integer no-undo .
     1295   define variable v-prepare-string as character no-undo .
     1296   do
     1297   on error undo, return error
     1298   on stop undo, return error
     1299   :
     1300     create query v-qh.
     1301     do v-ii = 1 to p-qh:num-buffers:
     1302       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1303       assign
     1304       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1305       no-error.
     1306       v-qh:add-buffer(v-bh[v-ii]).
     1307     end.
     1308     assign
     1309     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1310                       p-where-cond + chr(32)  +
     1311                       p-use-indFIRST-query-tail + chr(32) +
     1312                       p-use-ind-sort-clmn-by + chr(32) +
     1313                       p-indexed-reposition
     1314     .
     1315     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1316     if not glog then do:
     1317       delete object v-qh.
     1318       do v-ii = 1 to p-qh:num-buffers:
     1319         delete object v-bh[v-ii].
     1320       end.
     1321       undo, return error .
     1322     end.
     1323     glog = v-qh:query-open no-error .
     1324     if not glog then do:
     1325       delete object v-qh.
     1326       do v-ii = 1 to p-qh:num-buffers:
     1327         delete object v-bh[v-ii].
     1328       end.
     1329       undo, return error .
     1330     end.
     1331     if p-next then do:
     1332       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1333       glog = v-qh:get-next( p-lock) no-error .
     1334       glog = v-qh:get-next( p-lock) no-error .
     1335       if not glog or v-qh:query-off-end = yes then do:
     1336         glog = v-qh:get-first( p-lock) no-error .
     1337       end.
     1338     end.
     1339     else do:
     1340       glog = v-qh:get-first( p-lock) no-error .
     1341     end.
     1342     do v-ii = 1 to p-qh:num-buffers:
     1343       assign
     1344       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1345       no-error.
     1346     end.
     1347     delete object v-qh.
     1348     do v-ii = 1 to p-qh:num-buffers:
     1349       delete object v-bh[v-ii].
     1350     end.
     1351   end.
     1352   end procedure.
