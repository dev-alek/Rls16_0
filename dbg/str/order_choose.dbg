     1525   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   procedure factord :
     1527     define input  parameter p-fact-date            as date    no-undo .
     1528     define input  parameter p-fact-time            as integer no-undo .
     1529     define input  parameter p-fact-num             as integer no-undo .
     1530     define input  parameter p-shift-date           as date    no-undo .
     1531     define input  parameter p-shift-num            as integer no-undo .
     1532     define input  parameter p-shift-on             as logical no-undo .
     1533     define output parameter p-fact-order           as decimal no-undo .
     1534     define output parameter p-shift-end-fact-order as decimal no-undo .
     1535     define output parameter p-day-end-fact-order   as decimal no-undo .
     1536     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1537     if p-fact-date = ?
     1538     then do:
     1539       return error "Не указана фактическая дата" .
     1540     end.
     1541     define variable v-fact-date-num as integer no-undo .
     1542     assign
     1543       v-fact-date-num = integer(p-fact-date)
     1544     .
     1545     if p-fact-num = ?
     1546     or p-fact-num = 0
     1547     then do:
     1548       return error "Не задан p-fact-num " + string(p-fact-num) .
     1549     end.
     1550     if p-fact-num < 0
     1551     then do:
     1552       return error "Отрицательный fact-num " + string(p-fact-num) .
     1553     end.
     1554     if p-fact-num >= 100000000
     1555     then do:
     1556       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1557     end.
     1558     if p-shift-on = true
     1559     then do:
     1560       if p-shift-date = ?
     1561       then do:
     1562         return error "Не задана дата смены" .
     1563       end.
     1564       if p-shift-num = ?
     1565       or p-shift-num = 0
     1566       then do:
     1567         return error "Не задан номер смены" .
     1568       end.
     1569     end.
     1570     else do:
     1571       assign
     1572         p-shift-date = p-fact-date
     1573         p-shift-num  = 24
     1574       .
     1575     end.
     1576     define variable v-shift-offset as integer no-undo .
     1577     if p-shift-date = p-fact-date
     1578     then do:
     1579       assign
     1580         v-shift-offset = 1
     1581       .
     1582     end.
     1583     if p-shift-date < p-fact-date
     1584     then do:
     1585       assign
     1586         v-shift-offset = 0
     1587       .
     1588     end.
     1589     if p-shift-date > p-fact-date
     1590     then do:
     1591       message
     1592         vss-workfile vss-revision vss-description skip
     1593         "Неправильная дата закрытия смены" skip
     1594         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1595         view-as alert-box error .
     1596       undo, return error
     1597         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1598           ,string(p-fact-date, '99/99/9999':U)
     1599           ,string(p-shift-date, '99/99/9999':U)
     1600           )
     1601       .
     1602     end.
     1603     if p-shift-num < 1
     1604     or p-shift-num > 24
     1605     then do:
     1606       message
     1607         vss-workfile vss-revision vss-description skip
     1608         "Неправильный номер смены" skip
     1609         "p-shift-num" p-shift-num skip
     1610         view-as alert-box error .
     1611       undo, return error return-value .
     1612     end.
     1613     assign
     1614       p-fact-order           = v-fact-date-num
     1615                              + v-shift-offset * 0.5
     1616                              + p-shift-num    * 0.02 - 0.01
     1617                              + p-fact-num     * 0.0000000001
     1618       p-shift-end-fact-order = v-fact-date-num
     1619                              + v-shift-offset * 0.5
     1620                              + p-shift-num    * 0.02
     1621       p-day-end-fact-order   = v-fact-date-num
     1622                              + 0.99
     1623     .
     1624     if p-fact-order           <= v-fact-date-num
     1625     or p-shift-end-fact-order <= v-fact-date-num
     1626     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1627     or p-shift-end-fact-order >= p-day-end-fact-order
     1628     then do:
     1629       message
     1630         vss-workfile vss-revision vss-description skip
     1631         "Внутренняя ошибка при генерации фактического номера" skip
     1632         "p-fact-date"            p-fact-date            skip
     1633         "p-fact-time"            p-fact-time            skip
     1634         "p-fact-num"             p-fact-num             skip
     1635         "p-shift-date"           p-shift-date           skip
     1636         "p-shift-num"            p-shift-num            skip
     1637         "p-shift-on"             p-shift-on             skip
     1638         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1639         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1640         "v-fact-date-num"        v-fact-date-num        skip
     1641         view-as alert-box error .
     1642       undo, return error return-value .
     1643     end.
     1644   end procedure.
     1645   procedure day-begin-fact-order :
     1646     define input  parameter p-fact-date            as date    no-undo .
     1647     define output parameter p-day-begin-fact-order as decimal no-undo .
     1648     do
     1649     on error undo, return error return-value
     1650     :
     1651       if p-fact-date = ?
     1652       then do:
     1653         assign
     1654           p-day-begin-fact-order = 0
     1655         .
     1656       end.
     1657       else do:
     1658         assign
     1659           p-day-begin-fact-order = integer(p-fact-date)
     1660         .
     1661       end.
     1662     end.
     1663   end procedure.
     1664   procedure factord-max-fact-order :
     1665     define output parameter p-max-fact-order as decimal   no-undo .
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       run day-begin-fact-order in this-procedure
     1670         (input  date(1, 1, 5000)
     1671         ,output p-max-fact-order
     1672         ) .
     1673     end.
     1674   end procedure.
     1675   procedure factord-cut-archive :
     1676     define input  parameter p-obj-type             as character no-undo .
     1677     define input  parameter p-obj-code             as integer   no-undo .
     1678     define input  parameter p-fact-date            as date      no-undo .
     1679     define output parameter p-shift-on             as logical   no-undo .
     1680     define output parameter p-shift-date           as date      no-undo .
     1681     define output parameter p-shift-num            as integer   no-undo .
     1682     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1683     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1684     define variable v-fact-order as decimal   no-undo .
     1685     define buffer buf_shift-obj for ub.shift-obj .
     1686     do
     1687     on error undo, return error return-value
     1688     :
     1689   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1691     (input  p-obj-type
     1692     ,input  p-obj-code
     1693     ,input  'shift-on=request'
     1694     ,output p-shift-on
     1695     ) no-error .
     1696       if error-status :error
     1697       then do:
     1698         message
     1699           vss-workfile vss-revision vss-description skip
     1700           "Ошибка при определении атрибута объекта" skip
     1701           "Объект" p-obj-type p-obj-code skip
     1702           error-status :get-message(1) skip
     1703           return-value skip
     1704           view-as alert-box error .
     1705         undo, return error return-value .
     1706       end.
     1707       if p-shift-on = false
     1708       then do:
     1709         assign
     1710           p-shift-date               = ?
     1711           p-shift-num                = 0
     1712         .
     1713       end.
     1714       else do:
     1715         find first buf_shift-obj share-lock
     1716           where buf_shift-obj.obj-type   = p-obj-type
     1717             and buf_shift-obj.obj-code   = p-obj-code
     1718             and buf_shift-obj.shift-date > p-fact-date
     1719           use-index pi
     1720           no-error .
     1721         if not available buf_shift-obj
     1722         or buf_shift-obj.status_ <> 'зкр':U
     1723         then do:
     1724           message
     1725             vss-workfile vss-revision vss-description skip
     1726             "Невозможно вычислить последнюю смену" skip
     1727             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1728             "Объект" p-obj-type p-obj-code skip
     1729             "Дата" p-fact-date skip
     1730             view-as alert-box error .
     1731           undo, return error return-value .
     1732         end.
     1733         find last buf_shift-obj share-lock
     1734           where buf_shift-obj.obj-type = p-obj-type
     1735             and buf_shift-obj.obj-code = p-obj-code
     1736             and buf_shift-obj.shift-date <= p-fact-date
     1737           use-index pi
     1738           no-error .
     1739         if available buf_shift-obj
     1740         then do:
     1741           if  buf_shift-obj.status_ = 'зкр':U
     1742           then do:
     1743             assign
     1744               p-shift-date = buf_shift-obj.shift-date
     1745               p-shift-num  = buf_shift-obj.shift-num
     1746             .
     1747           end.
     1748           else do:
     1749             message
     1750               vss-workfile vss-revision vss-description skip
     1751               "Невозможно вычислить последнюю смену" skip
     1752               "Статус смены отличен от статуса" 'зкр':U skip
     1753               "Объект" p-obj-type p-obj-code skip
     1754               "Дата" p-fact-date skip
     1755               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1756               view-as alert-box error .
     1757             undo, return error return-value .
     1758           end.
     1759         end.
     1760         else do:
     1761           assign
     1762             p-shift-date = p-fact-date - 1
     1763             p-shift-num  = 1
     1764           .
     1765         end.
     1766       end.
     1767       run factord in this-procedure
     1768         (input  p-fact-date
     1769         ,input  1
     1770         ,input  1
     1771         ,input  p-shift-date
     1772         ,input  p-shift-num
     1773         ,input  p-shift-on
     1774         ,output v-fact-order
     1775         ,output p-shift-end-fact-order
     1776         ,output p-day-end-fact-order
     1777         ) no-error .
     1778       if error-status :error
     1779       then do:
     1780         message
     1781           vss-workfile vss-revision vss-description skip
     1782           "Ошибка при вызове процедуры factord"
     1783           error-status :get-message(1) skip
     1784           return-value skip
     1785           view-as alert-box error .
     1786         undo, return error return-value .
     1787       end.
     1788     end.
     1789   end procedure.
     1790   procedure factord-lock-shift :
     1791     define input  parameter p-obj-type  as character no-undo .
     1792     define input  parameter p-obj-code  as integer   no-undo .
     1793     define input  parameter p-fact-date as date      no-undo .
     1794     define parameter buffer buf_shift-obj for ub.shift-obj .
     1795     define variable v-shift-on      as logical   no-undo .
     1796     define variable v-extra-message as character no-undo .
     1797     define variable v-error as character no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1803     (input  p-obj-type
     1804     ,input  p-obj-code
     1805     ,input  'shift-on=request'
     1806     ,output v-shift-on
     1807     ) no-error .
     1808       if error-status :error
     1809       then do:
     1810         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1811         undo, return error v-error .
     1812       end.
     1813       if v-shift-on = true
     1814       then do:
     1815         find first buf_shift-obj share-lock
     1816           where buf_shift-obj.obj-type   = p-obj-type
     1817             and buf_shift-obj.obj-code   = p-obj-code
     1818             and buf_shift-obj.shift-date > p-fact-date
     1819           use-index pi
     1820           no-error .
     1821         if not available buf_shift-obj
     1822         or buf_shift-obj.status_ <> 'зкр':U
     1823         then do:
     1824           find last buf_shift-obj
     1825             where buf_shift-obj.obj-type = p-obj-type
     1826               and buf_shift-obj.obj-code = p-obj-code
     1827               and buf_shift-obj.status_  = 'зкр':U
     1828             use-index stts
     1829             no-error .
     1830           if available buf_shift-obj
     1831           then do:
     1832             assign
     1833               v-extra-message =
     1834                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1835                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1836                               )
     1837             .
     1838           end.
     1839           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1840           undo, return error v-error .
     1841         end.
     1842       end.
     1843     end.
     1844   end procedure.
     1845   procedure factord-end-day :
     1846     define input  parameter p-fact-date            as date    no-undo .
     1847     define output parameter p-day-end-fact-order   as decimal no-undo .
     1848     do
     1849     on error undo, return error return-value
     1850     :
     1851       if p-fact-date = ?
     1852       then do:
     1853         return error "Не указана фактическая дата" .
     1854       end.
     1855       assign
     1856         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1857       .
     1858     end.
     1859   end procedure.
     1860   procedure factord-to-date :
     1861     define input  parameter p-fact-order as decimal no-undo .
     1862     define output parameter p-fact-date  as date    no-undo .
     1863     define variable v-ref-date  as date      no-undo .
     1864     define variable v-ref-delta as integer   no-undo .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       if p-fact-order = ?
     1869       or p-fact-order = 0
     1870       then do:
     1871         return error "Не указан fact-order" .
     1872       end.
     1873       assign
     1874         v-ref-date  = date(1, 1, 2000)
     1875       .
     1876       assign
     1877         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1878       .
     1879       assign
     1880         p-fact-date = v-ref-date + v-ref-delta
     1881       .
     1882     end.
     1883   end procedure.
     1884   procedure factord-to-fact-num :
     1885     define input  parameter p-fact-order as decimal no-undo .
     1886     define output parameter p-fact-num   as integer no-undo .
     1887     define variable v-fact-order-trunc as decimal no-undo .
     1888     do
     1889     on error undo, return error return-value
     1890     :
     1891       if p-fact-order = ?
     1892       or p-fact-order = 0
     1893       then do:
     1894         return error "Не указан fact-order" .
     1895       end.
     1896       assign
     1897        v-fact-order-trunc = truncate(p-fact-order, 2)
     1898       .
     1899       assign
     1900         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1901       .
     1902     end.
     1903   end procedure.
     1904   procedure factord-to-shift-num :
     1905     define input  parameter p-fact-order as decimal no-undo .
     1906     define output parameter p-shift-num   as integer no-undo .
     1907     define variable  p-shift-numd  as decimal   no-undo .
     1908     define variable v-fact-order-trunc as decimal no-undo .
     1909     do
     1910     on error undo, return error return-value
     1911     :
     1912       if p-fact-order = ?
     1913       or p-fact-order = 0
     1914       then do:
     1915         return error "Не указан fact-order" .
     1916       end.
     1917       assign
     1918        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1919       .
     1920       if v-fact-order-trunc < 0.5 then do:
     1921         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1922       end.
     1923       assign
     1924         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1925         .
     1926        assign
     1927         p-shift-num = truncate (p-shift-numd , 0)
     1928       .
     1929     end.
     1930   end procedure.
     1931   function round-maxInt returns decimal
     1932       (input p-dec as decimal) forward.
     1933   function round-maxDec returns decimal
     1934       (input p-dec as decimal) forward.
     1935   function round-minInt returns decimal
     1936       (input p-dec as decimal) forward.
     1937   define variable rPeriodZakaz       as integer   no-undo .
     1938   define variable vDaySale           as integer   no-undo .
     1939   define variable pGarantDay         as integer   no-undo .
     1940   define variable pDelDayGoods       as logical   no-undo .
     1941   define variable typeDocChoose      as character no-undo .
     1942   define variable dateZakaz          as character no-undo .
     1943   define variable zakazPeriod        as character no-undo .
     1944   define variable qntyPeriod         as integer   no-undo .
     1945   define variable pDateOrder         as date      no-undo .
     1946   define variable vLine              as integer   no-undo .
     1947   define variable vDateStart         as date      no-undo .
     1948   define variable vDateEnd           as date      no-undo .
     1949   define variable periodDate         as date      no-undo .
     1950   define variable v-fact-orderStart  as decimal   no-undo .
     1951   define variable v-fact-orderEnd    as decimal   no-undo .
     1952   define variable v-fact-order-start as decimal   no-undo .
     1953   define variable v-fact-order-end   as decimal   no-undo .
     1954   define buffer buf_PromoGoogs      for ub.PromoGoods .
     1955   define buffer buf_PromoAction     for ub.PromoAction .
     1956   define buffer buf_stk-line        for ub.stk-line .
     1957   define buffer buf_trn-doc         for ub.trn-doc .
     1958   define buffer buf_goods-attr      for ub.goods-attr .
     1959   define buffer buf_cli-gds         for ub.cli-gds .
     1960   define buffer buf_temp-gds-qnty   for temp-gds-qnty .
     1961   define buffer buf_doc-line        for ub.doc-line .
     1962   define buffer buf_order-line      for ub.order-line .
     1963   define buffer buf_order-doc       for ub.order-doc .
     1964   define buffer buf_contract-specif for ub.contract-specif .
     1965   procedure crt-orderLine:
     1966       define input parameter par-params      as character no-undo .
     1967       define input parameter pDocCode as integer no-undo .
     1968       define input parameter pDbNum as integer no-undo .
     1969       define input parameter table for tt-gds-list .
     1970       define variable kk as integer no-undo .
     1971       define variable ii as integer no-undo .
     1972       pDateOrder = date(entry(1,par-params,chr(4))) .
     1973       rPeriodZakaz = integer(entry(2,par-params,chr(4))) .
     1974       vDaySale = integer (entry(3,par-params,chr(4))) .
     1975       pGarantDay = integer(entry(4,par-params,chr(4))) .
     1976       pDelDayGoods = logical(entry(5,par-params,chr(4))) .
     1977       typeDocChoose = entry(6,par-params,chr(4)) .
     1978       dateZakaz = entry(7,par-params,chr(4)) .
     1979       find first buf_order-doc no-lock where buf_order-doc.doc-code = pDocCode and
     1980           buf_order-doc.db-num = pDbNum no-error .
     1981       find last buf_order-line no-lock where buf_order-line.doc-code = pDocCode and
     1982           buf_order-line.db-num = pDbNum no-error .
     1983       if available (buf_order-line) then vLine = buf_order-line.line-num .
     1984       do kk = 1 to num-entries (dateZakaz,chr(7)):
     1985           zakazPeriod = entry(kk,dateZakaz,chr(7)) .
     1986           create tt-dateZakaz .
     1987           assign
     1988               tt-dateZakaz.id        = kk
     1989               tt-dateZakaz.dateStart = date(entry(1,zakazPeriod,chr(8)))
     1990               tt-dateZakaz.dateEnd   = date(entry(2,zakazPeriod,chr(8)))
     1991               .
     1992       end.
     1993       for each tt-dateZakaz:
     1994           qntyPeriod = qntyPeriod + 1 .
     1995           if tt-dateZakaz.dateStart < vDateStart or vDateStart = ? then vDateStart = tt-dateZakaz.dateStart .
     1996           if tt-dateZakaz.dateEnd > vDateEnd or vDateEnd = ? then vDateEnd = tt-dateZakaz.dateEnd .
     1997       end.
     1998       for each gds-list:
     1999           for first buf_goods-attr no-lock where buf_goods-attr.gds-code = gds-list.gds-code and
     2000               buf_goods-attr.attr-code = 'min-zapas':U:
     2001               gds-list.minZapas = decimal (buf_goods-attr.attr-value) .
     2002           end.
     2003       end.
     2004       for each gds-list:
     2005           find first tt-zakaz no-lock where tt-zakaz.gds-code = gds-list.gds-code no-error .
     2006           if available (tt-zakaz) then next .
     2007           create tt-zakaz .
     2008           assign
     2009               tt-zakaz.gds-code          = gds-list.gds-code
     2010               tt-zakaz.artic             = gds-list.artic
     2011               tt-zakaz.gds-name          = gds-list.gds-name
     2012               tt-zakaz.prod-code         = gds-list.prod-code
     2013               tt-zakaz.prod-type         = gds-list.prod-type
     2014               tt-zakaz.garant-stock      = 0
     2015               tt-zakaz.minZapas          = gds-list.minZapas
     2016               tt-zakaz.ostatokDay        = 0
     2017               tt-zakaz.ostatokGoods      = 0
     2018               tt-zakaz.rest              = 0
     2019               tt-zakaz.qntyDay           = kk - 1
     2020               tt-zakaz.qntyDaySale       = 0
     2021               tt-zakaz.average-sales     = 0
     2022               tt-zakaz.order-qnty        = 0
     2023               tt-zakaz.volMinZapas       = 0
     2024               tt-zakaz.sales             = 0
     2025               tt-zakaz.volume-goods      = 0
     2026               tt-zakaz.contract-prn-code = gds-list.contract
     2027               tt-zakaz.contract-code     = gds-list.contract-code
     2028               .
     2029           for each buf_cli-gds no-lock where buf_cli-gds.artic = gds-list.artic and
     2030               buf_cli-gds.prod-code = gds-list.prod-code and
     2031               buf_cli-gds.prod-type = gds-list.prod-type:
     2032               tt-zakaz.rest = tt-zakaz.rest + buf_cli-gds.supp-qnty .
     2033           end.
     2034           empty temp-table temp-gds-qnty .
     2035           if pDelDayGoods then run ost-gds-day(vDateStart, vDateEnd, gds-list.gds-code, v-cntxt-obj-type, v-cntxt-obj-code, tt-zakaz.rest) .
     2036           for each tt-dateZakaz:
     2037               run day-begin-fact-order in this-procedure ( input tt-dateZakaz.dateStart
     2038                   , output v-fact-order-start
     2039                   ).
     2040               run factord-end-day in this-procedure ( input tt-dateZakaz.dateEnd
     2041                   , output v-fact-order-end
     2042                   ).
     2043               if pDelDayGoods then
     2044               do:
     2045                   for each buf_temp-gds-qnty where buf_temp-gds-qnty.gds-code = gds-list.gds-code and
     2046                       buf_temp-gds-qnty.ost > 0 and
     2047                       buf_temp-gds-qnty.day >= tt-dateZakaz.dateStart and
     2048                       buf_temp-gds-qnty.day <= tt-dateZakaz.dateEnd:
     2049                       tt-zakaz.qntyDayGoods = tt-zakaz.qntyDayGoods + 1 .
     2050                   end.
     2051               end.
     2052               else tt-zakaz.qntyDayGoods = tt-dateZakaz.dateEnd - tt-dateZakaz.dateStart + 1.
     2053               do ii = 0 to num-entries (typeDocChoose,chr(7)):
     2054                   for each buf_doc-line no-lock
     2055                       where
     2056                       buf_doc-line.ext-doc-type = entry(ii,typeDocChoose,chr(7)) and
     2057                       buf_doc-line.obj-code = v-cntxt-obj-code and
     2058                       buf_doc-line.obj-type = v-cntxt-obj-type and
     2059                       buf_doc-line.artic = gds-list.artic and
     2060                       buf_doc-line.prod-code = gds-list.prod-code and
     2061                       buf_doc-line.prod-type = gds-list.prod-type and
     2062                       buf_doc-line.fact-order >= v-fact-order-start and
     2063                       buf_doc-line.fact-order <= v-fact-order-end :
     2064                       tt-zakaz.qntyDaySale = tt-zakaz.qntyDaySale + 1 .
     2065                       case entry(ii,typeDocChoose,chr(7)):
     2066                           when   'ie':U  or
     2067                           when   'im':U     then
     2068                               do:
     2069                                   tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2070                               end.
     2071                           when  'we':U      then
     2072                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2073                           when  'wm':U       then
     2074                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2075                           when  'em':U       then
     2076                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2077                           when  'ev':U      then
     2078                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2079                           when  'rv':U  then
     2080                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2081                           when  'ee':U      then
     2082                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2083                           when  're':U  then
     2084                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2085                           when  'es':U     then
     2086                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     2087                           when  'rs':U then
     2088                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2089                           when  'we':U then
     2090                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     2091                       end case.
     2092                   end.
     2093               end.
     2094           end.
     2095           if tt-zakaz.qntyDayGoods <> 0 then tt-zakaz.average-sales = round-maxDec(tt-zakaz.sales / tt-zakaz.qntyDayGoods) .
     2096           if tt-zakaz.qntyDayGoods <> 0 then
     2097           do:
     2098               if tt-zakaz.rest > -1 then
     2099               do:
     2100                   tt-zakaz.ostatokDay = tt-zakaz.rest - ((integer(pDateOrder - date(today)) * tt-zakaz.average-sales)) .
     2101                   if tt-zakaz.ostatokDay < 0 then tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale).
     2102                   else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.ostatokDay) .
     2103               end.
     2104               else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.rest).
     2105               if tt-zakaz.qntyDaySale <> 0 then
     2106               do:
     2107                   tt-zakaz.volMinZapas = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.minZapas) .
     2108                   tt-zakaz.garant-stock = pGarantDay * tt-zakaz.average-sales .
     2109                   tt-zakaz.order-qnty = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.minZapas + tt-zakaz.garant-stock) .
     2110                   if tt-zakaz.average-sales <> 0 then tt-zakaz.ostatokGoods = round-minInt(tt-zakaz.rest / tt-zakaz.average-sales) .
     2111               end.
     2112               else tt-zakaz.volume-goods = 0 .
     2113           end.
     2114           for each buf_PromoGoogs no-lock where buf_PromoGoogs.gds-code = gds-list.gds-code,
     2115               first buf_PromoAction no-lock where buf_PromoAction.id = buf_PromoGoogs.idAction and
     2116               buf_PromoAction.end-date >= today and buf_PromoAction.beg-date <= today and buf_PromoAction.Status_ = 1:
     2117               tt-zakaz.promo = true .
     2118           end.
     2119           find first buf_goods no-lock where
     2120               buf_goods.gds-code = tt-zakaz.gds-code.
     2121           create buf_order-line.
     2122           assign
     2123               vLine                        = vLine + 1
     2124               buf_order-line.doc-code      = pDocCode
     2125               buf_order-line.db-num        = pDbNum
     2126               buf_order-line.line-num      = vLine
     2127               buf_order-line.gds-code      = tt-zakaz.gds-code
     2128               buf_order-line.artic         = tt-zakaz.artic
     2129               buf_order-line.prod-type     = if avail buf_goods then buf_goods.prod-type else ""
     2130               buf_order-line.prod-code     = if avail buf_goods then buf_goods.prod-code else 0
     2131               buf_order-line.order-qnty    = tt-zakaz.order-qnty
     2132               buf_order-line.fact-qnty     = tt-zakaz.order-qnty
     2133               buf_order-line.rest          = tt-zakaz.rest
     2134               buf_order-line.sales         = tt-zakaz.sales
     2135               buf_order-line.average-sales = tt-zakaz.average-sales
     2136               buf_order-line.stock-goods   = if tt-zakaz.average-sales = 0 and tt-zakaz.ostatokDay <> 0 then -1 else integer(tt-zakaz.ostatokGoods)
     2137               buf_order-line.volume-goods  = tt-zakaz.volume-goods
     2138               buf_order-line.volume-stock  = if tt-zakaz.minZapas > tt-zakaz.rest then tt-zakaz.minZapas else tt-zakaz.volMinZapas
     2139               buf_order-line.min-stock     = tt-zakaz.minZapas
     2140               buf_order-line.garant-stock  = tt-zakaz.garant-stock
     2141               buf_order-line.promo         = tt-zakaz.promo
     2142               .
     2143           validate buf_order-line.
     2144       end .
     2145   end procedure .
     2146   procedure ost-gds-day :
     2147       do
     2148           on error undo, return error return-value
     2149           :
     2150           define input parameter p-dateStart as decimal no-undo .
     2151           define input parameter p-dateEnd as decimal no-undo .
     2152           define input parameter p-gds-code like ub.goods.gds-code no-undo .
     2153           define input parameter p-obj-type as character no-undo .
     2154           define input parameter p-obj-code as integer no-undo .
     2155           define input parameter p-ost-today as decimal no-undo .
     2156           define variable vOst as decimal no-undo .
     2157           define buffer p_goods     for ub.goods .
     2158           define buffer p-doc-line  for ub.doc-line .
     2159           define buffer pc-gds-obj  for ub.c-gds-obj .
     2160           define buffer pc-gds-obj2 for ub.c-gds-obj .
     2161           find first p_goods no-lock where p_goods.gds-code = p-gds-code no-error .
     2162           if error-status :error then return error .
     2163           do periodDate = vDateStart to vDateEnd:
     2164               create temp-gds-qnty .
     2165               assign
     2166                   temp-gds-qnty.day      = periodDate
     2167                   temp-gds-qnty.gds-code = p_goods.gds-code
     2168                   .
     2169               find first pc-gds-obj no-lock where pc-gds-obj.gds-code = p_goods.gds-code and
     2170                   pc-gds-obj.obj-code = p-obj-code and
     2171                   pc-gds-obj.obj-type = p-obj-type and
     2172                   pc-gds-obj.corr-date = periodDate no-error .
     2173               if not available (pc-gds-obj) then
     2174               do:
     2175                   find last pc-gds-obj2 no-lock where pc-gds-obj2.gds-code = p_goods.gds-code and
     2176                       pc-gds-obj2.obj-code = p-obj-code and
     2177                       pc-gds-obj2.obj-type = p-obj-type and
     2178                       pc-gds-obj2.corr-date < periodDate no-error .
     2179                   if available (pc-gds-obj2) then temp-gds-qnty.ost = pc-gds-obj2.fact-qnty .
     2180               end.
     2181               else temp-gds-qnty.ost = pc-gds-obj.fact-qnty .
     2182           end.
     2183       end.
     2184   end procedure.
     2185   function round-maxInt returns decimal
     2186       (input p-dec as decimal):
     2187       define variable p-int as decimal no-undo .
     2188       if absolute(p-dec - TRUNCATE (p-dec, 0)) < 0.5
     2189           then
     2190       do:
     2191           if p-dec > 0 then p-int = integer (p-dec + 0.4) .
     2192           else p-int = integer(p-dec) .
     2193       end .
     2194       else
     2195       do:
     2196           if p-dec < 0 then p-int = integer (p-dec + 0.4) .
     2197           else p-int = integer(p-dec) .
     2198       end.
     2199       return p-int .
     2200   end function.
     2201   function round-minInt returns decimal
     2202       (input p-dec as decimal):
     2203       define variable p-int as decimal no-undo .
     2204       if absolute(p-dec - TRUNCATE (p-dec, 0)) > 0.5
     2205           then
     2206       do:
     2207           if p-dec > 0 then p-int = integer (p-dec - 0.4) .
     2208           else p-int = integer(p-dec) .
     2209       end .
     2210       else
     2211       do:
     2212           if p-dec < 0 then p-int = integer (p-dec - 0.4) .
     2213           else p-int = integer(p-dec) .
     2214       end.
     2215       return p-int .
     2216   end function.
     2217   function round-maxDec returns decimal
     2218       (input p-dec as decimal):
     2219       define variable p-int as decimal no-undo .
     2220       if p-dec - TRUNCATE (p-dec, 1) > 0
     2221           then
     2222       do:
     2223           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     2224           else p-int = TRUNCATE (p-dec, 1) + 0.1 .
     2225       end.
     2226       else
     2227       do:
     2228           if p-dec - TRUNCATE (p-dec, 1) > 0
     2229               then
     2230           do:
     2231               p-int = TRUNCATE (p-dec, 1) - 0.1.
     2232           end.
     2233           else
     2234           do:
     2235               assign
     2236                   p-int = TRUNCATE (p-dec, 1) .
     2237               .
     2238           end.
     2239       end.
     2240       return p-int .
     2241   end function.
     2242   function round-minDec returns decimal
     2243       (input p-dec as decimal):
     2244       define variable p-int as decimal no-undo .
     2245       if p-dec - TRUNCATE (p-dec, 1) < 0
     2246           then
     2247       do:
     2248           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     2249           else p-int = TRUNCATE (p-dec, 1) - 0.1 .
     2250       end.
     2251       else
     2252       do:
     2253           if p-dec - TRUNCATE (p-dec, 1) > 0
     2254               then
     2255           do:
     2256               p-int = TRUNCATE (p-dec, 1) - 0.1.
     2257           end.
     2258           else
     2259           do:
     2260               assign
     2261                   p-int = p-dec
     2262                   .
     2263           end.
     2264       end.
     2265       return p-int .
     2266   end function.
     2267   function round-minDec returns decimal
     2268       (input p-dec as decimal) forward.
     2269   define variable r-2                 as integer   no-undo init 1 .
     2270   define variable v-mark-seq          as integer   no-undo.
     2271   define variable p-bcode             as character no-undo .
     2272   define variable p-prod              as character no-undo .
     2273   define variable p-grp               as character no-undo .
     2274   define variable p-bonus             as decimal   no-undo .
     2275   define variable v-cli-base-rate-ord as decimal   no-undo .
     2276   define variable v-unit-cli-ord      as character no-undo .
     2277   define variable v-cli-base-rate-rcv as decimal   no-undo .
     2278   define variable v-unit-cli-rcv      as character no-undo .
     2279   create gds-list-flt.
     2280   gds-list-flt.gds-code = 0 .
     2281   release gds-list-flt .
     2282   define temp-table temp-conn no-undo
     2283       field ri       as recid
     2284       field mark-seq as integer
     2285       index pi is primary ri
     2286       .
     2287   define temp-table tt_contract-specif like ub.contract-specif
