     4455   FUNCTION f-bonus RETURNS DECIMAL
     4456       ( input par-recid as recid ) :
     4457       define buffer buf_contract-specif for ub.contract-specif  .
     4458       define variable v-bonus as decimal no-undo .
     4459       find first buf_contract-specif no-lock where
     4460           recid(buf_contract-specif) = par-recid no-error .
     4461       if error-status :error then return 0.0 .
     4462       v-bonus = 0.0 .
     4463       run read-bonus in this-procedure
     4464           ( buf_contract-specif.contract-num,
     4465           buf_contract-specif.host-code ,
     4466           buf_contract-specif.gds-code ,
     4467           output v-bonus
     4468           ) no-error .
     4469       return v-bonus .
     4470   END FUNCTION.
     4471   FUNCTION f-prc-min RETURNS DECIMAL
     4472       ( input par-recid as recid ) :
     4473       define buffer buf_contract-specif for ub.contract-specif  .
     4474       define variable v-prc-min as decimal no-undo .
     4475       find first buf_contract-specif no-lock where
     4476           recid(buf_contract-specif) = par-recid no-error .
     4477       if error-status :error then return 0.0 .
     4478       v-prc-min = 0.0 .
     4479       run read-prc-min in this-procedure
     4480           ( buf_contract-specif.contract-num,
     4481           buf_contract-specif.host-code ,
     4482           buf_contract-specif.gds-code ,
     4483           output v-prc-min
     4484           ) no-error .
     4485       return v-prc-min .
     4486   END FUNCTION.
     4487   FUNCTION get-b-code RETURNS CHARACTER
     4488       ( input gds-code as integer ) :
     4489       define variable ret    as character no-undo .
     4490       define variable b-code as integer   no-undo .
     4491       assign
     4492           ret = "" .
     4493   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4494     (input  gds-code
     4495     ,input  ?
     4496     ,output b-code
     4497     ) no-error .
     4498       if error-status :error then
     4499       do:
     4500       end.
     4501       else assign ret = string(b-code) .
     4502       RETURN ret .
     4503   END FUNCTION.
     4504   FUNCTION get-ext-artic RETURNS CHARACTER
     4505       ( input p-recid as recid ) :
     4506       define variable ret as character no-undo .
     4507       define buffer bf_contract-specif for ub.contract-specif  .
     4508       define buffer bf_contract        for ub.contract  .
     4509       define buffer bf_ext-artic       for ub.ext-artic  .
     4510       define buffer bf_goods           for ub.goods  .
     4511       assign
     4512           ret = "" .
     4513       find first tt_contract-specif no-lock  where recid(tt_contract-specif)  =  p-recid no-error .
     4514       if error-status :error then
     4515       do:
     4516           message
     4517               vss-workfile vss-revision vss-description skip
     4518               error-status :get-message(1) skip
     4519               return-value skip
     4520               ""
     4521               view-as alert-box error
     4522               .
     4523       end.
     4524       find first bf_ext-artic where bf_ext-artic.gds-code   = tt_contract-specif.gds-code
     4525           and bf_ext-artic.status_    <> 'удал':U
     4526           no-error .
     4527       if error-status :error then
     4528       do:
     4529           ret = ''  .
     4530       end.
     4531       else
     4532       do:
     4533           assign
     4534               ret = string(bf_ext-artic.gds-code)
     4535               .
     4536           if ret = ? then ret = "".
     4537       end.
     4538       RETURN ret .
     4539   END FUNCTION.
     4540   FUNCTION get-gds-name RETURNS CHARACTER
     4541       ( input p-gds-code as integer ) :
     4542       define variable ret as character no-undo .
     4543       define buffer bf_goods for ub.goods  .
     4544       assign
     4545           ret = "" .
     4546       find first bf_goods no-lock where
     4547           bf_goods.gds-code = p-gds-code no-error  .
     4548       if error-status :error then
     4549       do:
     4550       end.
     4551       else assign ret = bf_goods.gds-name  .
     4552       RETURN ret .
     4553   END FUNCTION.
     4554   FUNCTION get-grp RETURNS CHARACTER
     4555       ( input gds-code as integer ) :
     4556       define buffer buf_goods for ub.goods.
     4557       find first buf_goods no-lock where buf_goods.gds-code = gds-code .
     4558       RETURN buf_goods.grp-name .
     4559   END FUNCTION.
