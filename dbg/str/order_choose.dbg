     4328   PROCEDURE proc-find-code :
     4329       define input parameter p-next as logical no-undo.
     4330       define input parameter p-code as character no-undo .
     4331       define buffer buf_contract-specif for tt_contract-specif .
     4332       define variable row_spec as rowid   no-undo .
     4333       define variable loc#log  as logical no-undo .
     4334       assign
     4335           p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     4336       case RADIO-find :
     4337           when 1 then
     4338               do:
     4339                   find first buf_contract-specif no-lock where string(buf_contract-specif.gds-code) begins p-code no-error .
     4340                   if not available (buf_contract-specif) then message "Не найден код начинающийся с " + p-code
     4341                           view-as alert-box.
     4342                   if available buf_contract-specif then
     4343                   do:
     4344                       row_spec = rowid(buf_contract-specif).
     4345                       loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     4346                       reposition spec-List to rowid row_spec.
     4347                   end.
     4348                   apply "entry" to spec-List in frame Dialog-Frame.
     4349               end.
     4350           when 2 then
     4351               do:
     4352                   find first buf_contract-specif no-lock where string(buf_contract-specif.artic) begins p-code no-error .
     4353                   if not available (buf_contract-specif) then message "Не найден артикул начинающийся с " + p-code
     4354                           view-as alert-box.
     4355                   if available buf_contract-specif then
     4356                   do:
     4357                       row_spec = rowid(buf_contract-specif).
     4358                       loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     4359                       reposition spec-List to rowid row_spec.
     4360                   end.
     4361                   apply "entry" to spec-List in frame Dialog-Frame.
     4362               end.
     4363           when 3 then
     4364               do:
     4365                   find first buf_contract-specif no-lock where string(buf_contract-specif.gds-name) begins p-code no-error .
     4366                   if not available (buf_contract-specif) then message "Не найден товар начинающийся с " + p-code
     4367                           view-as alert-box.
     4368                   if available buf_contract-specif then
     4369                   do:
     4370                       row_spec = rowid(buf_contract-specif).
     4371                       loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     4372                       reposition spec-List to rowid row_spec.
     4373                   end.
     4374                   apply "entry" to spec-List in frame Dialog-Frame.
     4375               end.
     4376           when 4 then
     4377               do:
     4378               end.
     4379       end.
     4380   END PROCEDURE.
     4381   PROCEDURE proc-import-excel :
     4382   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4383   do:
     4384     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4385       (input  v-cntxt-db-num
     4386       ,input  v-cntxt-userid
     4387       ,input  0
     4388       ,input  'actn_fin-contract_modernization':U
     4389       ,input  'firm':U
     4390       ,input  p-host-code
     4391       ,input  '':U
     4392       ,input  0
     4393       ,input  0
     4394       ,input  0
     4395       ,input  0
     4396       ,input  true
     4397       ,output g-log
     4398       )  .
     4399   end.
     4400       if not g-log then  return .
     4401       run str/diallog.w (
     4402           input parParentProc
     4403           , input this-procedure
     4404           , input ("utl/thbjrumr.w":U + chr(4)
     4405           + chr(4)
     4406           + string(2)       + chr(4)
     4407           )
     4408           , input ('edoc':U + chr(4) +
     4409           'excel-import_specif':U + chr(4) +
     4410           string(buf_contract.contract-code)
     4411           )
     4412           , input no
     4413           , input "&Стоп"
     4414           , input substitute("Импорт спецификации из EXCEL") ) no-error .
     4415       run proc-sum in this-procedure .
     4416       run openbr in this-procedure ( input yes, input no, input '':u).
     4417   END PROCEDURE.
