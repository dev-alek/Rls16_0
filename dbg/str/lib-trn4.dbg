     1463                               p-out-string = p-out-string + " ":U
     1464                           .
     1465                       end.
     1466                       when chr(10)
     1467                       then do:
     1468                           assign
     1469                               p-out-string = p-out-string + " ":U
     1470                           .
     1471                       end.
     1472                       when chr(13)
     1473                       then do:
     1474                           assign
     1475                               p-out-string = p-out-string + " ":U
     1476                           .
     1477                       end.
     1478                       otherwise do:
     1479                           assign
     1480                               p-out-string = p-out-string + v-current-char
     1481                           .
     1482                       end.
     1483                   end case.
     1484               end.
     1485           end.
     1486       end case.
     1487   end.
     1488   end .
     1489   procedure xmlchar-decode :
     1490   define input parameter p-in-string      as character        no-undo.
     1491   define output parameter p-out-string    as character        no-undo.
     1492       define variable v-position      as integer      no-undo.
     1493       define variable v-last-position as integer      no-undo.
     1494       define variable v-temp-integer  as integer      no-undo.
     1495       define variable v-current-char  as character    no-undo.
     1496       define variable v-next-char     as character    no-undo.
     1497       define variable v-success       as logical      no-undo.
     1498   do
     1499   on error undo, return error
     1500   :
     1501       assign
     1502           p-out-string = "":U
     1503           v-position   = 0
     1504       .
     1505       replace-cycle:
     1506       do while yes
     1507       on error undo, return error
     1508       :
     1509           assign
     1510               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1511           .
     1512           if v-last-position <= v-position
     1513           then do:
     1514               if v-position = 0
     1515               then do:
     1516                   assign
     1517                       p-out-string = p-in-string
     1518                   .
     1519               end.
     1520               else do:
     1521                   assign
     1522                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1523                   .
     1524               end.
     1525               leave replace-cycle.
     1526           end.
     1527           else do:
     1528               assign
     1529                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1530                   v-position      = v-last-position
     1531                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1532               .
     1533               if v-current-char = "#":U
     1534               then do:
     1535                   assign
     1536                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1537                   .
     1538                   if v-last-position > 0
     1539                   then do:
     1540                       run xmlchar-read-integer in this-procedure
     1541                        (
     1542                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1543                           , output v-temp-integer
     1544                           , output v-success
     1545                       ).
     1546                       if v-success = yes
     1547                       and v-temp-integer >= 1
     1548                       and v-temp-integer <= 255
     1549                       then do:
     1550                           assign
     1551                               p-out-string = p-out-string + chr( v-temp-integer )
     1552                               v-position   = v-last-position + 1
     1553                           .
     1554                       end.
     1555                       else do:
     1556                           assign
     1557                               p-out-string = p-out-string + "&":U
     1558                               v-position   = v-position   + 1
     1559                           .
     1560                       end.
     1561                   end.
     1562                   else do:
     1563                       assign
     1564                           p-out-string = p-out-string + "&":U
     1565                           v-position   = v-position   + 1
     1566                       .
     1567                   end.
     1568               end.
     1569               else do:
     1570                   case substring( p-in-string, v-position + 1, 3 )
     1571                   :
     1572                       when "lt;":U
     1573                       then do:
     1574                           assign
     1575                               p-out-string = p-out-string + "<":U
     1576                               v-position   = v-position   + 3
     1577                           .
     1578                       end.
     1579                       when "gt;":U
     1580                       then do:
     1581                           assign
     1582                               p-out-string = p-out-string + ">":U
     1583                               v-position   = v-position   + 3
     1584                           .
     1585                       end.
     1586                       otherwise do:
     1587                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1588                           then do:
     1589                               assign
     1590                                   p-out-string = p-out-string + "&":U
     1591                                   v-position   = v-position   + 4
     1592                               .
     1593                           end.
     1594                           else do:
     1595                               case substring( p-in-string, v-position + 1, 5 )
     1596                               :
     1597                                   when "quot;":U
     1598                                   then do:
     1599                                       assign
     1600                                           p-out-string = p-out-string + '"':U
     1601                                           v-position   = v-position   + 5
     1602                                       .
     1603                                   end.
     1604                                   when "apos;":U
     1605                                   then do:
     1606                                       assign
     1607                                           p-out-string = p-out-string + "'":U
     1608                                           v-position   = v-position   + 5
     1609                                       .
     1610                                   end.
     1611                                   otherwise do:
     1612                                       assign
     1613                                           p-out-string = p-out-string + "&":U
     1614                                       .
     1615                                   end.
     1616                               end case.
     1617                           end.
     1618                       end.
     1619                   end case.
     1620               end.
     1621           end.
     1622       end.
     1623   end.
     1624   end .
     1625   procedure xmlchar-read-integer :
     1626   define input parameter p-input-string      as character        no-undo.
     1627   define output parameter p-output-integer   as integer          no-undo.
     1628   define output parameter p-success       as logical          no-undo.
     1629   do
     1630   on error undo, return error
     1631   :
     1632       assign
     1633           p-output-integer = integer( p-input-string )
     1634       no-error.
     1635       if error-status :error
     1636       then do:
     1637           assign
     1638               p-success           = no
     1639               p-output-integer    = 0
     1640           .
     1641       end.
     1642       else do:
     1643           assign
     1644               p-success           = yes
     1645           .
     1646       end.
     1647   end.
     1648   end.
     1649   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1650   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1651   define new global shared variable g#attr-lib  as handle no-undo .
     1652   define variable v-attr-lib-variable as handle no-undo .
     1653   define variable mMRCCode  as logical    no-undo.
     1654   define variable mTypeMark as character  no-undo.
     1655   function IS-NeedMark returns logical
     1656   ( input ib-code as integer  ,
     1657     input ib-str as character ):
     1658      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1659      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1660                                    and buf_prod-bc-attr.b-str  eq ib-str
     1661                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1662        no-lock no-error.
     1663      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1664   end.
     1665   function repTegforDm return char
     1666   (iDM as char ):
     1667       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1668       define variable vteg as character no-undo.
     1669       define variable oDM as character no-undo.
     1670       define variable vi as integer no-undo.
     1671       oDM = iDm.
     1672       do vi = 1 to num-entries(vTeglist):
     1673          vTeg = entry(vi,vTeglist).
     1674          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1675       end.
     1676       return oDM.
     1677   end.
     1678   function repSpecSimbforDm return char
     1679   (iDM as char ):
     1680       define variable oDM as character no-undo.
     1681     run
     1682       xmlchar-decode(iDM, output oDM).
     1683     return repTegforDm (oDM).
     1684   end.
     1685   function CheckGtin return logical
     1686   (iGtin as char):
     1687      define variable bar_code as character no-undo.
     1688      define variable vGtin as logical no-undo init "yes".
     1689      if length(iGtin) eq 14
     1690      then do:
     1691         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1692         run str/chk-sum.p
     1693          (input-output bar_code ) no-error .
     1694         if iGtin ne  bar_code
     1695         then
     1696            vGtin = no.
     1697      end.
     1698      else
     1699         vGtin = no.
     1700      return vgtin.
     1701   end.
     1702   function repSpecSimbforXlm return char
     1703   (iDM as char ):
     1704       iDM = replace(iDM,chr(29),"").
     1705       return iDM.
     1706   end.
     1707   function getGtinByDM return char
     1708   (IDM as char):
     1709      define variable VTXT as char no-undo.
     1710      define variable vGtin as char no-undo.
     1711      vTXt = IdM.
     1712      vGtin = IDM.
     1713      if    length(vtxt) > 14
     1714      then do:
     1715         if   vtxt begins "(01)"
     1716                or vtxt begins "(02)"
     1717         then
     1718            vGtin = substring(vtxt,5,14).
     1719         else if   (vtxt begins "01"
     1720                or vtxt begins "02" )
     1721                and (   (    substring(iDm,17,2) eq "21"
     1722                         and length(vtxt) >= 21)
     1723                     or substring(iDm,17,2) eq "37"
     1724                     or substring(iDm,17,4) eq "(37)" )
     1725         then do:
     1726            vGtin = substring(vtxt,3,14).
     1727            if not checkGtin(vGtin)
     1728            then
     1729               vGtin = substring(vtxt,1,14).
     1730         end.
     1731         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1732             or length(vtxt) eq 14 + 7 + 4
     1733             or length(vtxt) eq 14 + 7
     1734         then
     1735            vGtin = substring(vtxt,1,14).
     1736      end.
     1737      if not checkGtin(vGtin)
     1738      then
     1739         vGtin = "".
     1740      return vgtin.
     1741   end.
     1742   function getGdsCodeByGtin return int
     1743   (iGtin as char):
     1744      define buffer prod-bc  for ub.prod-bc.
     1745      define buffer bar-code for ub.bar-code.
     1746      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1747      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1748      return if avail bar-code then bar-code.gds-code else ?.
     1749   end.
     1750   function getQntyCodeByGtin return decimal
     1751   (iGtin as char):
     1752      define buffer prod-bc  for ub.prod-bc.
     1753      define buffer bar-code for ub.bar-code.
     1754      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1755      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1756      return if avail bar-code then bar-code.cli-base-rate else ?.
     1757   end.
     1758   function getGdsCodeByDM return int
     1759   (iDm as char):
     1760      define variable vGtin as char no-undo.
     1761      define buffer prod-bc for ub.prod-bc.
     1762      vGtin  = getGtinByDM (IDM ).
     1763      return getGdsCodeByGtin (vGtin).
     1764   end.
     1765   function ChekTypeMarkByGds return logical
     1766   (iGds-code as integer ):
     1767      define buffer goods-attr for ub.goods-attr.
     1768      find first goods-attr where goods-attr.gds-code   = iGds-code
     1769                              and goods-attr.attr-code  = 'mark-type':U
     1770      no-lock no-error.
     1771      if available goods-attr
     1772      then do:
     1773         mTypeMark = goods-attr.attr-value.
     1774         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1775           .
     1776      end.
     1777      else
     1778         return no.
     1779   end.
     1780   function ChekTypeMarkByDm return logical
     1781   (iDM as char ):
     1782      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1783   end.
     1784   function ChekTypeMarkByGtin return logical
     1785   (iGtin as char ):
     1786      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1787   end.
     1788   function GetNextElement return character
     1789     (input iAllTeg        as logical
     1790     ,output oteg          as character
     1791     ,output otegval       as character
     1792     ,input-output pstr    as character
     1793      ):
     1794        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1795        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1796        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1797        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1798        define variable vTeg as character no-undo.
     1799        define variable vLength as integer no-undo.
     1800        define variable vi as integer no-undo.
     1801        define variable vj as integer no-undo.
     1802        define buffer code for ub.code.
     1803        find first code where Code.parent eq "MarkType"
     1804                          and Code.CodeValue   eq mTypeMark
     1805                          no-lock no-error.
     1806        if     available code
     1807           and Code.misc1 ne ""
     1808           and Code.misc1 ne ?
     1809        then do:
     1810           integer (Code.misc1) no-error.
     1811           if not error-status:error
     1812           then
     1813             entry (4,vlistleng) = Code.misc1.
     1814        end.
     1815        if iAllTeg
     1816        then
     1817           assign
     1818              vlistElem     = vlistElem    + vlistElemDop
     1819              vlistleng     = vlistleng    + vlistlengDop
     1820           .
     1821        else if mMRCCode
     1822        then
     1823           assign
     1824              vlistElem     = vlistElem    + ",(8005),8005"
     1825              vlistleng     = vlistleng    + ",000006,0006"
     1826           .
     1827       block-elem:
     1828       do vi = 1 to num-entries(vlistElem):
     1829          vTeg = entry(vi,vlistElem).
     1830          if pstr begins vTeg
     1831          then do:
     1832             if    vTeg eq "21"
     1833             then
     1834                vLength = index(pstr,chr(29)) - 2 no-error.
     1835             if vLength  <= 0
     1836             then
     1837                vLength = int(entry(vi,vlistleng)).
     1838             otegval = substring (pstr,length(vteg) + 1, vLength).
     1839             oteg = replace(replace(vteg,")",""),"(","").
     1840             vTeg = vteg + otegval.
     1841             otegval = replace(otegval,chr(29),"").
     1842             oteg = replace(replace(oteg,")",""),"(","").
     1843             pstr = substring (pstr,length(vTeg)+ 1).
     1844             vTeg = replace(vTeg,chr(29),"").
     1845             leave block-elem.
     1846          end.
     1847          else
     1848             vTeg = "".
     1849       end.
     1850       return vteg.
     1851   end.
     1852   function GetCodeIdent return character
     1853   (iDm as char):
     1854      define variable Velement   as character no-undo init "first".
     1855      define variable oCodeIdent as character no-undo.
     1856      define variable vteg as character no-undo.
     1857      define variable vtegval as character no-undo.
     1858      define variable vGtin as character no-undo.
     1859      define buffer marking for ub.marking.
     1860      for first marking no-lock where
     1861                marking.mark eq iDm
     1862            and marking.unit-ext = "LEVEL2"
     1863      :
     1864        return iDm.
     1865      end.
     1866      vGtin  = getGtinByDM (iDm ).
     1867      ChekTypeMarkByDm(idm).
     1868      if iDm begins 'tech_':U
     1869      then
     1870         oCodeIdent = iDm.
     1871      else if length(iDm) < 21
     1872      then do:
     1873         find first marking where marking.mark eq idm
     1874         no-lock no-error.
     1875         oCodeIdent = if available marking then marking.mark else  ?.
     1876      end.
     1877      else if     length(iDm) eq 29
     1878         and not iDm begins "01"
     1879         and not iDm begins "02"
     1880      then
     1881         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1882      else  if     length(iDm) >= 24
     1883               and (  iDm begins "01"
     1884                   or iDm begins "02")
     1885               and  substring(iDm,17,2) ne "21"
     1886      then do:
     1887         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1888                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1889         then
     1890            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1891         else
     1892            oCodeIdent = iDM.
     1893      end.
     1894      else  if     (   length(iDm) eq 25
     1895                    or length(iDm) eq 21)
     1896               and (not iDm begins "01"
     1897               and  not iDm begins "02")
     1898      then
     1899         oCodeIdent = substring(iDm,1,21).
     1900      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1901      then
     1902         oCodeIdent = substring(iDm,1,21).
     1903      else do while Velement ne "" and idm ne "":
     1904         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1905         oCodeIdent = oCodeIdent + Velement.
     1906      end.
     1907      return oCodeIdent.
     1908   end.
     1909   function GetTegCod return character
     1910   (icodeIdent as char, iTeg as char):
     1911      define variable Velement   as character no-undo init "first".
     1912      define variable oTeg as character no-undo init ?.
     1913      define variable vteg as character no-undo.
     1914      define variable vtegval as character no-undo.
     1915      if     ((length(icodeIdent) eq 21
     1916         and not icodeIdent begins "01"
     1917         and not icodeIdent begins "02")
     1918         or
     1919             ( length(icodeIdent) eq 25
     1920               and not icodeIdent begins "01"
     1921               and not icodeIdent begins "02"))
     1922      then do:
     1923         if iTeg eq "01" or iTeg eq "02"
     1924         then
     1925            oTeg = substring(icodeIdent,1,21).
     1926         else  if  iTeg eq "21"
     1927         then
     1928            oTeg = substring(icodeIdent,15,7).
     1929      end.
     1930      else do:
     1931         ChekTypeMarkByDm(icodeIdent).
     1932         block-teg:
     1933            do while Velement ne "" and icodeIdent ne "":
     1934            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1935            if    Velement begins iTeg
     1936               or Velement begins "(" + iTeg + ")"
     1937            then do:
     1938               oTeg = vtegval.
     1939               leave block-teg.
     1940            end.
     1941         end.
     1942      end.
     1943      return oTeg.
     1944   end.
     1945   function isOAD return logical
     1946   (icodeIdent as character):
     1947      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1948   end.
     1949   function isMark return logical
     1950   (icodeIdent as character):
     1951      define buffer buf_marking for ub.marking.
     1952      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1953             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1954   end.
     1955   function addBracketForCode return character
     1956   (icodeIdent as char):
     1957      define variable Velement   as character no-undo init "first".
     1958      define variable oTeg as character no-undo.
     1959      define variable vteg as character no-undo.
     1960      define variable vtegval as character no-undo.
     1961      define buffer marking for ub.marking.
     1962      find first marking no-lock where
     1963                 marking.mark begins icodeIdent no-error.
     1964      if    not ChekTypeMarkByDm(icodeIdent)
     1965         or length(icodeIdent) le 24
     1966         or (avail marking and marking.unit-ext = "LEVEL2")
     1967      then
     1968         oTeg = icodeIdent.
     1969      else do:
     1970         if (  icodeIdent begins "01"
     1971            or icodeIdent begins "02"
     1972            ) and CheckGtin(substring (icodeIdent,3,14))
     1973            and substring (icodeIdent,17,2) eq "21"
     1974         then do:
     1975            mMRCCode = yes.
     1976            ChekTypeMarkByDm(icodeIdent).
     1977            block-teg:
     1978            do while Velement ne "" and icodeIdent ne "":
     1979               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1980               if vteg ne ""
     1981               then
     1982                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1983            end.
     1984            mMRCCode = no.
     1985         end.
     1986         else do:
     1987            oTeg = icodeIdent.
     1988         end.
     1989      end.
     1990      return oTeg.
     1991   end.
     1992   function getlevelByCodId return int
     1993   (iCode as char):
     1994      define variable vLength as int no-undo.
     1995      define variable vLevel  as int no-undo.
     1996      if not ChekTypeMarkByDM (icode) then return ?.
     1997      vLength = length(iCode).
     1998      if    vLength eq 18
     1999         or vLength eq 20
     2000      then
     2001         Vlevel = 4.
     2002      else if vLength eq 21
     2003      then
     2004         Vlevel = 1.
     2005      else if vLength eq 25
     2006      then do:
     2007         if  iCode begins "01"
     2008         then
     2009            Vlevel = 3.
     2010         else
     2011            Vlevel = 1.
     2012      end.
     2013      else if     vLength >= 26
     2014              and vLength <= 46
     2015      then do:
     2016         if    substring(iCode,17,2) eq "11"
     2017            or substring(iCode,17,2) eq "13"
     2018            or (    substring(iCode,17,2) eq "21"
     2019                and vLength >= 33
     2020                and substring(iCode,26,4) ne "8005")
     2021         then
     2022            Vlevel = 4.
     2023         else if    vLength eq 31
     2024                 or vLength eq 38
     2025                 or vLength eq 39
     2026                 or vLength eq 45
     2027         then
     2028            Vlevel = 1.
     2029         else if    vLength eq 35
     2030                 or vLength eq 43
     2031         then
     2032            Vlevel = 3.
     2033         else
     2034            Vlevel = ?.
     2035      end.
     2036      else
     2037         Vlevel = ?.
     2038      return Vlevel.
     2039   end.
     2040   function getLevelMotpBycodid return character
     2041   (iDm as char):
     2042      define variable vLevel as integer no-undo.
     2043      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2044      vLevel = getlevelByCodId(iDm).
     2045      if    vLevel eq ?
     2046         or vLevel < 1
     2047         or vLevel > 6
     2048      then
     2049         return ?.
     2050      else
     2051         return entry(vlevel,vList).
     2052   end.
     2053   function getLevelUTDByLevelMotp return character
     2054   (iUnit as char):
     2055      define variable vLevel as integer no-undo.
     2056      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2057      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2058      vLevel = lookup(iUnit,vListMOTP).
     2059      if    vLevel eq ?
     2060         or vLevel < 1
     2061         or vLevel > 4
     2062      then
     2063         return ?.
     2064      else
     2065         return entry(vlevel,vListutd).
     2066   end.
     2067   function getLevelMotpByDM return character
     2068   (iDm as char):
     2069      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2070   end.
     2071   function getLevelUTDByCodId return character
     2072   (iDm as char):
     2073      define variable vLevel as integer no-undo.
     2074      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2075      vLevel = getlevelByCodId(iDm).
     2076      if    vLevel eq ?
     2077         or vLevel < 1
     2078         or vLevel > 4
     2079      then
     2080         return ?.
     2081      else
     2082         return entry(vlevel,vList).
     2083   end.
     2084   function getLevelUTDByDM return character
     2085   (iDm as char):
     2086      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2087   end.
     2088   define variable mNotMarkQnty as logical no-undo.
     2089   function getQntyUTDByCodId return decimal
     2090   (iDM as char):
     2091      define variable vLevel as integer no-undo.
     2092      define variable vList as character no-undo init "1,5,10,500".
     2093      define variable vGtin as character no-undo.
     2094      define variable vqnty as decimal no-undo init ?.
     2095      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2096      if vqnty eq ?
     2097      then do:
     2098         if not mNotMarkQnty
     2099         then do:
     2100            define buffer marking for ub.marking.
     2101            define variable vCodident as character no-undo.
     2102            vCodident = GetCodeIdent(idm).
     2103            find first marking where marking.mark begins vCodident no-lock no-error.
     2104            if     available marking
     2105               and marking.box-qnty ne ?
     2106            then
     2107               return marking.box-qnty.
     2108         end.
     2109         vGtin = getGtinByDm(iDM).
     2110         if ChekTypeMarkByGtin (vGtin)
     2111         then do:
     2112            vLevel = getlevelByCodId(iDM).
     2113            if     vLevel >= 1
     2114               and vLevel <= 4
     2115            then
     2116               vqnty = int(entry(vlevel,vList)).
     2117         end.
     2118         else
     2119            vqnty = getQntyCodeByGtin(vgtin).
     2120      end.
     2121      return vqnty.
     2122   end.
     2123   function getQntyUTDByDM return decimal
     2124   (iDm as char):
     2125      define variable vDM as character no-undo.
     2126      if     length (iDm) ne 25
     2127         and length (iDm) ne 29
     2128         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2129      then
     2130         vDM = substring (iDm,1,length (iDm) - 6 ).
     2131      else
     2132         vDM = substring (iDm,1,length (iDm) - 4 ).
     2133      return getQntyUTDByCodId(vDM).
     2134   end.
     2135   function getMRC4 return decimal
     2136   (iMRC as char):
     2137      define variable oMrc     as decimal no-undo init ?.
     2138      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2139      define variable vi       as integer no-undo.
     2140      define variable vfound   as integer no-undo.
     2141      define variable vposStart   as integer no-undo.
     2142      do:
     2143      OMRc = 0.
     2144      do vi = 1 to 4:
     2145         define variable vsimb as character no-undo.
     2146         vsimb = substring(iMRC,vi,1).
     2147         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2148         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2149         if vfound > 0
     2150         then
     2151            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2152         end.
     2153         OMRc = OMRc / 100.
     2154      end.
     2155      return OMRc.
     2156   end.
     2157   function getMRCByDM return decimal
     2158   (iDm as char):
     2159      define variable vMRC     as character no-undo.
     2160      define variable oMrc     as decimal no-undo init ?.
     2161      define variable Velement as character no-undo init "empty".
     2162      define variable vteg as character no-undo.
     2163      define variable vtegval as character no-undo.
     2164      if    length(idm) eq 14 + 7 + 4 + 4
     2165         or length(idm) eq 14 + 7 + 4
     2166      then do:
     2167         vMRC = substring(idm,22,4).
     2168         omrc = getMRC4(vMRC).
     2169      end.
     2170      else do:
     2171          ChekTypeMarkByDm(iDm).
     2172          block-mrc:
     2173          do while Velement ne "" and idm ne "":
     2174             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2175             if Velement begins "8005"
     2176             then do:
     2177                vMRC = substring(Velement,5,6).
     2178                leave block-mrc.
     2179             end.
     2180             else if Velement begins "(8005)"
     2181             then do:
     2182                vMRC = substring(Velement,7,6).
     2183                leave block-mrc.
     2184             end.
     2185          end.
     2186          if vMRC ne ""
     2187          then
     2188             OMRc = dec(vmrc) / 100 no-error.
     2189      end.
     2190      return OMRc.
     2191   end.
     2192   function MoveDate return Date
     2193   (idate as date,
     2194    iMonth as int64):
     2195      define variable vMonth   as int64 no-undo.
     2196      define variable vYear    as int64 no-undo.
     2197      define variable vDateNew as date  no-undo.
     2198       define variable vDay     as int64 no-undo.
     2199       vMonth = month(iDate) + iMonth.
     2200       vYear =  year(iDate).
     2201       if vMonth <= 0
     2202       then assign
     2203          vMonth = vMonth + 12
     2204           vYear  = vYear - 1
     2205       .
     2206       else if vMonth > 12
     2207       then assign
     2208          vMonth = vMonth - 12
     2209           vYear  = vYear + 1
     2210       .
     2211       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2212       do while error-status:error eq yes:
     2213          VDay = vDay + 1.
     2214          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2215       end.
     2216       if VDay > 0
     2217       then
     2218          vDateNew + 1.
     2219       return vDateNew.
     2220   end.
     2221   procedure checkEMRC:
     2222   define input  parameter iDm as character no-undo.
     2223   define output parameter vok as logical   no-undo init yes.
     2224      define variable v-value-emrc as character no-undo.
     2225      define variable v-type-emrc  as character no-undo.
     2226      define variable vDateIso     as character no-undo.
     2227      define variable vMRC         as decimal no-undo.
     2228      define variable vqnty        as decimal no-undo.
     2229      define variable vPrice       as decimal no-undo.
     2230      define variable vparent      as character no-undo.
     2231      define variable vgds-code    as integer no-undo.
     2232      define buffer code for ub.code.
     2233      vMRC = getMRCByDM(iDm).
     2234      if vMRC > 0
     2235      then do:
     2236         vgds-code = getGdsCodeByDM(iDm).
     2237         vqnty     = getQntyUTDByDM(iDm).
     2238               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2239            (
     2240             input   vgds-code
     2241            ,input   'emrc-type':U
     2242            ,output   v-value-emrc
     2243            ,output   v-type-emrc
     2244          ) no-error.
     2245          if     v-value-emrc ne ""
     2246             and v-value-emrc ne ?
     2247          then do:
     2248             vDateIso = iso-date(today).
     2249             vPrice = vMRC / vqnty.
     2250             vparent ="emc" + chr(4) + v-value-emrc.
     2251             find last code where Code.parent      eq vparent
     2252                              and Code.code        le vDateIso
     2253                              and code.status_  eq 0
     2254             no-lock no-error.
     2255             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2256             then
     2257                vOk = true .
     2258             else do:
     2259                 define variable vText      as character no-undo.
     2260                 define variable vDate      as date no-undo.
     2261                 define variable vDateLast  as character no-undo.
     2262                 define variable vDateFirst as character no-undo.
     2263                 define variable vDate3     as date no-undo.
     2264                 vdate = date(code.misc1).
     2265                 vDateLast = code.misc1.
     2266                 vDate3 = MoveDate(today, - 3 ).
     2267                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2268                                      string(vDate3  , "99/99/9999"),
     2269                                      string(vDate   , "99/99/9999")
     2270                                      ).
     2271                 vdateIso = iso-date(vdate3).
     2272                 find last code  where Code.parent      eq vparent
     2273                                   and Code.code        le vDateIso
     2274                                   and code.status_  eq 0 no-lock no-error.
     2275                 if available code
     2276                 then
     2277                    vDateIso = code.code.
     2278                 vDateFirst = vDateIso.
     2279                 vDateLast = iso-date(vdate).
     2280                 define variable vGood as logical no-undo.
     2281                 define variable vDateSale as date no-undo.
     2282                 define buffer bcode for code.
     2283                 for last code where Code.parent   eq vparent
     2284                                 and code.status_  eq 0
     2285                                 and code.code     < vDateLast
     2286                                 and code.code     >= vDateFirst
     2287                 no-lock:
     2288                    find first bcode where bCode.parent   eq vparent
     2289                                       and bcode.status_  eq 0
     2290                                       and bcode.code     > code.code no-lock no-error.
     2291                    if available bcode
     2292                    then do:
     2293                       if vPrice < dec(Code.CodeValue)
     2294                       then
     2295                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2296                                                     chr(10),
     2297                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2298                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2299                                                     ).
     2300                       else do:
     2301                          vGood = yes.
     2302                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2303                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2304                                                     chr(10),
     2305                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2306                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2307                                                     string(         vDateSale            ,"99/99/9999"),
     2308                                                     string(vDateSale - today)
     2309                                                     ).
     2310                       end.
     2311                    end.
     2312                 end.
     2313                 if vgood
     2314                 then do:
     2315                    define variable choice as integer no-undo .
     2316                    run gbl/d-askw.w (input "Уточнение"
     2317                           ,input  vText
     2318                           ,input "|"
     2319                           ,input "Принять|Вернуть"
     2320                           ,input "Принять данный товар|Вернуть товар постащику"
     2321                           ,input 1
     2322                           ,input 2
     2323                           ,output choice) no-error.
     2324                    vok = choice eq 1.
     2325                 end.
     2326                 else
     2327                    vok =false.
     2328             end.
     2329          end.
     2330      end.
     2331   end.
     2332   function addGs2Mark return character
     2333   (iMark as char):
     2334      define variable vDM   as character no-undo.
     2335      define variable vIdx  as integer   no-undo.
     2336      if index(iMark,chr(29),1) > 0
     2337      then return iMark.
     2338      if substring(iMark,26,4) = "8005" then
     2339      do:
     2340        vIdx = index(iMark,"93",26 + 4 + 5).
     2341        if vIdx > 1 then do:
     2342          vDM = substitute("&1&4&2&4&3",
     2343                           substring(iMark,1,25),
     2344                           substring(iMark,26,vIdx - 25 - 1),
     2345                           substring(iMark,vIdx),
     2346                           chr(29)) no-error.
     2347          vIdx = index(vDm,"240",vIdx + 4).
     2348          if vIdx > 0 then
     2349          do:
     2350            vDM = substitute("&1&3&2",
     2351                             substring(vDm,1,vIdx - 1),
     2352                             substring(vDm,vIdx),
     2353                             chr(29)) no-error.
     2354          end.
     2355        end.
     2356        else
     2357          vDM = substitute("&1&3&2",
     2358                           substring(iMark,1,25),
     2359                           substring(iMark,26),
     2360                           chr(29)) no-error.
     2361      end.
     2362      else if substring(iMark,32,2) = "91" then
     2363      do:
     2364        vIdx = index(iMark,"92",32).
     2365        if vIdx > 1 then
     2366          vDM = substitute("&1&4&2&4&3",
     2367                           substring(iMark,1,31),
     2368                           substring(iMark,32,vIdx - 31 - 1),
     2369                           substring(iMark,vIdx),
     2370                           chr(29)) no-error.
     2371        else
     2372          vDM = substitute("&1&3&2",
     2373                           substring(iMark,1,31),
     2374                           substring(iMark,32),
     2375                           chr(29)) no-error.
     2376      end.
     2377      else if substring(iMark,39,2) = "91" then
     2378      do:
     2379        vIdx = index(iMark,"92",38).
     2380        if vIdx > 1 then
     2381          vDM = substitute("&1&4&2&4&3",
     2382                           substring(iMark,1,38),
     2383                           substring(iMark,39,vIdx - 38 - 1),
     2384                           substring(iMark,vIdx),
     2385                           chr(29)) no-error.
     2386        else
     2387          vDM = substitute("&1&3&2",
     2388                           substring(iMark,1,38),
     2389                           substring(iMark,39),
     2390                           chr(29)) no-error.
     2391      end.
     2392      else if substring(iMark,25,2) = "93" then
     2393      do:
     2394        vIdx = index(iMark,"92",25).
     2395        if vIdx > 1 then
     2396          vDM = substitute("&1&4&2&4&3",
     2397                           substring(iMark,1,24),
     2398                           substring(iMark,25,vIdx - 24 - 1),
     2399                           substring(iMark,vIdx),
     2400                           chr(29)) no-error.
     2401        else
     2402          vIdx = index(iMark,"3103",25).
     2403          if vIdx > 0 then
     2404          vDM = substitute("&1&4&2&4&3",
     2405                           substring(iMark,1,24),
     2406                           substring(iMark,25,vIdx - 24 - 1),
     2407                           substring(iMark,vIdx),
     2408                           chr(29)) no-error.
     2409          else
     2410            vDM = substitute("&1&3&2",
     2411                             substring(iMark,1,24),
     2412                             substring(iMark,25),
     2413                             chr(29)) no-error.
     2414      end.
     2415      else if substring(iMark,32,2) = "93" then
     2416      do:
     2417        vDM = substitute("&1&3&2",
     2418              substring(iMark,1,31),
     2419              substring(iMark,32),
     2420              chr(29)) no-error.
     2421      end.
     2422      return if vDM <> "" then vDm else iMark.
     2423   end.
     2424   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2425   function getattrUtdex returns char
     2426   (idb-num   as integer,
     2427    idoc-id   as integer,
     2428    iattrcode as character,
     2429    iExValue  as character  ):
     2430      define buffer utd-attr for utd-attr.
     2431      find first utd-attr where utd-attr.db-num eq idb-num
     2432                            and utd-attr.doc-id eq idoc-id
     2433                            and utd-attr.attr-code eq iattrcode
     2434      no-lock no-error.
     2435      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2436   end.
     2437   function getattrUtd returns char
     2438   (idb-num   as integer,
     2439    idoc-id   as integer,
     2440    iattrcode as character ):
     2441     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2442   end.
     2443   function setattrUtd returns logical
     2444   (idb-num   as integer,
     2445    idoc-id   as integer,
     2446    iattrcode as character,
     2447    iattrval  as character ):
     2448      define buffer utd-attr for utd-attr.
     2449      find first utd-attr where utd-attr.db-num eq idb-num
     2450                            and utd-attr.doc-id eq idoc-id
     2451                            and utd-attr.attr-code eq iattrcode
     2452      no-lock no-error.
     2453      if not available utd-attr
     2454      then do:
     2455         create utd-attr.
     2456         assign
     2457            utd-attr.db-num    = idb-num
     2458            utd-attr.doc-id    = idoc-id
     2459            utd-attr.attr-code = iattrcode
     2460            utd-attr.attr-value = iattrval
     2461         .
     2462      end.
     2463      else do:
     2464         if utd-attr.attr-value ne iattrval
     2465         then do:
     2466            find current utd-attr exclusive-lock no-error.
     2467            if available utd-attr
     2468            then
     2469               utd-attr.attr-value = iattrval.
     2470         end.
     2471      end.
     2472      release utd-attr.
     2473   end.
     2474   function GetAttrUtdlinesEx returns char
     2475   (idb-num   as integer,
     2476    idoc-id   as integer,
     2477    ilinenum  as integer,
     2478    iattrcode as character,
     2479    iExValue  as character  ):
     2480      define buffer utd-lines-attr for utd-lines-attr.
     2481      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2482                                  and utd-lines-attr.doc-id    eq idoc-id
     2483                                  and utd-lines-attr.lineNum   eq ilineNum
     2484                                  and utd-lines-attr.attr-code eq iattrcode
     2485      no-lock no-error.
     2486      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2487   end.
     2488   function GetAttrUtdlines returns char
     2489   (idb-num   as integer,
     2490    idoc-id   as integer,
     2491    ilinenum  as integer,
     2492    iattrcode as character ):
     2493      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2494   end.
     2495   function setattrUtdlines returns logical
     2496   (idb-num   as integer,
     2497    idoc-id   as integer,
     2498    ilinenum  as integer,
     2499    iattrcode as character,
     2500    iattrval  as character ):
     2501      define buffer utd-lines-attr for utd-lines-attr.
     2502      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2503                                  and utd-lines-attr.doc-id    eq idoc-id
     2504                                  and utd-lines-attr.lineNum   eq ilineNum
     2505                                  and utd-lines-attr.attr-code eq iattrcode
     2506      no-lock no-error.
     2507      if not available utd-lines-attr
     2508      then do:
     2509         if iattrval ne ?
     2510            and iattrval ne ""
     2511         then do:
     2512            create utd-lines-attr.
     2513            assign
     2514               utd-lines-attr.db-num    = idb-num
     2515               utd-lines-attr.doc-id    = idoc-id
     2516               utd-lines-attr.lineNum   = ilineNum
     2517               utd-lines-attr.attr-code = iattrcode
     2518               utd-lines-attr.attr-value = iattrval
     2519            .
     2520         end.
     2521      end.
     2522      else do:
     2523         if utd-lines-attr.attr-value ne iattrval
     2524         then do:
     2525            find current utd-lines-attr exclusive-lock no-error.
     2526            if available utd-lines-attr
     2527            then do:
     2528               if    iattrval eq ?
     2529                  or iattrval eq ""
     2530               then do:
     2531                  delete utd-lines-attr.
     2532               end.
     2533               else do:
     2534                  utd-lines-attr.attr-value = iattrval.
     2535               end.
     2536            end.
     2537         end.
     2538      end.
     2539      release utd-lines-attr.
     2540   end.
     2541   function GetAttrUtdMarkingLinesEx returns char
     2542   (idb-num   as integer,
     2543    idoc-id   as integer,
     2544    ilinenum  as integer,
     2545    imark     as character,
     2546    iattrcode as character,
     2547    iExValue  as character  ):
     2548      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2549      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2550                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2551                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2552                                          and utd-marking-lines-attr.mark      eq imark
     2553                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2554      no-lock no-error.
     2555      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     2556   end.
     2557   function GetAttrUtdMarkingLines returns char
     2558   (idb-num   as integer,
     2559    idoc-id   as integer,
     2560    ilinenum  as integer,
     2561    imark     as character,
     2562    iattrcode as character ):
     2563      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     2564   end.
     2565   function setattrUtdMarkingLines returns logical
     2566   (idb-num   as integer,
     2567    idoc-id   as integer,
     2568    ilinenum  as integer,
     2569    imark     as character,
     2570    iattrcode as character,
     2571    iattrval  as character ):
     2572      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2573      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2574                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2575                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2576                                          and utd-marking-lines-attr.mark      eq imark
     2577                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2578      no-lock no-error.
     2579      if not available utd-marking-lines-attr
     2580      then do:
     2581         if iattrval ne ?
     2582            and iattrval ne ""
     2583         then do:
     2584            create utd-marking-lines-attr.
     2585            assign
     2586               utd-marking-lines-attr.db-num     = idb-num
     2587               utd-marking-lines-attr.doc-id     = idoc-id
     2588               utd-marking-lines-attr.lineNum    = ilineNum
     2589               utd-marking-lines-attr.mark       = imark
     2590               utd-marking-lines-attr.attr-code  = iattrcode
     2591               utd-marking-lines-attr.attr-value = iattrval
     2592            .
     2593         end.
     2594      end.
     2595      else do:
     2596         if utd-marking-lines-attr.attr-value ne iattrval
     2597         then do:
     2598            find current utd-marking-lines-attr exclusive-lock no-error.
     2599            if available utd-marking-lines-attr
     2600            then do:
     2601               if    iattrval eq ?
     2602                  or iattrval eq ""
     2603               then do:
     2604                  delete utd-marking-lines-attr.
     2605               end.
     2606               else do:
     2607                  utd-marking-lines-attr.attr-value = iattrval.
     2608               end.
     2609            end.
     2610         end.
     2611      end.
     2612      release utd-marking-lines-attr.
     2613   end.
     2614   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2615   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2617   procedure gen-key-rec :
     2618     define input  parameter p-tbl-name    as character no-undo.
     2619     define input  parameter p-bh_tbl-name as handle    no-undo.
     2620     define output parameter p-key-rec     as character no-undo.
     2621     do
     2622     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2623     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2624     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2625     :
     2626       define variable fh               as handle    no-undo .
     2627       define variable v-ok             as logical   no-undo .
     2628       define variable v-inform         as character no-undo .
     2629       define variable v-ind            as integer   no-undo .
     2630       define variable v-idx-field-qnty as integer   no-undo .
     2631       if p-tbl-name = ?
     2632         or p-tbl-name = "":U
     2633       then do:
     2634         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info15 ).
     2635       end.
     2636       if not p-bh_tbl-name:available then do:
     2637         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info15, p-tbl-name ).
     2638       end.
     2639       assign
     2640         p-key-rec = p-tbl-name
     2641         v-inform  = p-bh_tbl-name:index-information(1)
     2642         v-ind     = 2
     2643       .
     2644       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2645       on error undo, return error
     2646       :
     2647         assign
     2648           v-inform = p-bh_tbl-name:index-information( v-ind )
     2649           v-ind    = v-ind + 1
     2650         .
     2651       end.
     2652       if v-inform = ?
     2653         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2654         or entry( 3, v-inform, ",":U ) <> "1":U
     2655       then do:
     2656         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, p-tbl-name ).
     2657       end.
     2658       else do:
     2659         assign
     2660           v-idx-field-qnty = num-entries( v-inform ) - 4
     2661         .
     2662         if v-idx-field-qnty < 2 then do:
     2663           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, p-tbl-name ).
     2664         end.
     2665         do v-ind = 1 to v-idx-field-qnty by 2
     2666         on error undo, return error
     2667         :
     2668           assign
     2669             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2670             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2671           .
     2672         end.
     2673       end.
     2674       if p-key-rec = ? then do:
     2675         assign
     2676           p-key-rec = "":U
     2677         .
     2678         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info15, p-tbl-name ).
     2679       end.
     2680     end.
     2681     return.
     2682   end procedure.
     2683   procedure gen-where-keyr-tab :
     2684     define input  parameter i-tableSerach as character no-undo.
     2685     define input  parameter i-tablekey   as character  no-undo.
     2686     define input  parameter p-key-rec    as character  no-undo.
     2687     define input  parameter p-key-handle as handle     no-undo .
     2688     define input  parameter p-db-name    as character  no-undo .
     2689     define input  parameter p-tt-handle  as handle     no-undo .
     2690     define output parameter o-Where      as character  no-undo.
     2691     do
     2692     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2693     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2694     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2695     :
     2696       define variable v-full-tbl-name  as character no-undo .
     2697       define variable bh_tbl-name      as handle    no-undo .
     2698       define variable fh_key           as handle    no-undo .
     2699       define variable fh_search        as handle    no-undo .
     2700       define variable v-field-num      as integer   no-undo .
     2701       define variable v-count-fld      as integer   no-undo .
     2702       define variable v-inform         as character no-undo .
     2703       define variable v-ind            as integer   no-undo .
     2704       define variable v-idx-field-qnty as integer   no-undo .
     2705       define variable v-field-name     as character no-undo .
     2706       define variable v-field-val      as character no-undo .
     2707       define variable v-word-link      as character no-undo .
     2708       define variable vTable           as character no-undo.
     2709       define variable bh_tbl-key       as handle    no-undo .
     2710       assign
     2711         p-key-rec = trim( p-key-rec )
     2712       .
     2713       if p-key-handle <> ? then do:
     2714         if not valid-handle(p-key-handle)
     2715            or p-key-handle:type <> "buffer"
     2716         then do:
     2717           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info15 ).
     2718         end.
     2719         if num-entries( p-key-rec, chr(3) ) > 1
     2720           or p-key-rec = ?
     2721           or p-key-rec = "":U
     2722         then do:
     2723           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info15, p-key-rec ).
     2724         end.
     2725       end.
     2726       else do:
     2727         if p-key-rec = ?
     2728           or p-key-rec = "":U
     2729         then do:
     2730           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     2731         end.
     2732       end.
     2733       assign
     2734         vTable = entry( 1 , p-key-rec, chr(3) )
     2735       .
     2736       if p-tt-handle <> ?
     2737         and ( not valid-handle(p-tt-handle)
     2738               or p-tt-handle:type <> "buffer"
     2739             )
     2740       then do:
     2741         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info15, vTable, chr(10) ).
     2742       end.
     2743       if p-tt-handle = ? then do:
     2744         assign
     2745           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2746         .
     2747         create buffer bh_tbl-name for table v-full-tbl-name .
     2748       end.
     2749       else do:
     2750         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2751       end.
     2752       assign
     2753         v-inform = bh_tbl-name:index-information(1)
     2754         v-ind    = 2
     2755       .
     2756       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2757       on error undo, return error
     2758       :
     2759         assign
     2760           v-inform = bh_tbl-name:index-information( v-ind )
     2761           v-ind    = v-ind + 1
     2762         .
     2763       end.
     2764       if v-inform = ?
     2765         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2766         or entry( 3, v-inform, ",":U ) <> "1":U
     2767       then do:
     2768         delete object bh_tbl-name no-error.
     2769         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info15, vTable ).
     2770       end.
     2771       assign
     2772         v-idx-field-qnty = num-entries( v-inform ) - 4
     2773       .
     2774       if v-idx-field-qnty < 2 then do:
     2775         delete object bh_tbl-name no-error.
     2776         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, vTable ).
     2777       end.
     2778       assign
     2779         o-where     = "where":U
     2780         v-word-link = "":U
     2781         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2782         v-count-fld = 0
     2783       .
     2784       if i-tablekey ne "" and i-tablekey ne ?
     2785       then do:
     2786         assign
     2787           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2788         .
     2789         create buffer bh_tbl-key for table v-full-tbl-name .
     2790       end.
     2791       if i-tableSerach ne "" and i-tableSerach ne ?
     2792       then do:
     2793         delete object bh_tbl-name no-error.
     2794         assign
     2795           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2796         .
     2797         create buffer bh_tbl-name for table v-full-tbl-name .
     2798       end.
     2799       block_where:
     2800       do v-ind = 1 to v-idx-field-qnty by 2
     2801       on error undo, return error
     2802       :
     2803         assign
     2804           v-count-fld = v-count-fld + 1
     2805         .
     2806         if p-key-handle = ?
     2807           and v-count-fld > v-field-num
     2808         then do:
     2809           leave block_where.
     2810         end.
     2811         define variable VfieldKeyTable as handle no-undo.
     2812         assign
     2813           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2814           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2815         .
     2816         if     bh_tbl-key ne ?
     2817         then do:
     2818            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2819            if VfieldKeyTable eq ?
     2820            then next block_where.
     2821         end.
     2822         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2823         then
     2824            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2825         else
     2826            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2827         if p-key-handle = ? then do:
     2828           assign
     2829             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2830           .
     2831         end.
     2832         else do:
     2833           assign
     2834             fh_key = p-key-handle:buffer-field( v-field-name )
     2835           .
     2836           if fh_key = ?
     2837             or not valid-handle( fh_key )
     2838           then do:
     2839             delete object bh_tbl-name.
     2840             if     bh_tbl-key ne ?
     2841             then
     2842                delete object bh_tbl-key.
     2843             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info15, p-key-handle:name, v-field-name ).
     2844           end.
     2845           assign
     2846             v-field-val = fh_key:buffer-value
     2847           .
     2848         end.
     2849         if fh_search:data-type ="character":U then do:
     2850           assign
     2851             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2852             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2853             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2854             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2855             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2856             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2857             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2858             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2859             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2860             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2861             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2862             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2863             v-field-val = substitute( '"&1"', v-field-val )
     2864           .
     2865         end.
     2866         assign
     2867           o-where = substitute( "&1 &2", o-where, v-field-val )
     2868         .
     2869         if v-word-link = "":U then do:
     2870           assign
     2871             v-word-link = "and":U
     2872           .
     2873         end.
     2874       end.
     2875       delete object bh_tbl-name.
     2876       if     bh_tbl-key ne ?
     2877       then
     2878          delete object bh_tbl-key.
     2879       if p-key-handle = ?
     2880         and v-count-fld <> v-field-num
     2881       then do:
     2882         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info15, vTable ).
     2883       end.
     2884     end.
     2885   end procedure.
     2886   procedure gen-hn-keyr-tab :
     2887     define input  parameter i-tableSerach as character no-undo.
     2888     define input  parameter i-tablekey   as character no-undo.
     2889     define input  parameter p-key-rec    as character no-undo.
     2890     define input  parameter p-key-handle as handle    no-undo .
     2891     define input  parameter p-db-name    as character no-undo .
     2892     define input  parameter p-tt-handle  as handle    no-undo .
     2893     define input  parameter p-stts-lock  as integer   no-undo .
     2894     define output parameter o-hn         as handle    no-undo.
     2895     define variable v-full-tbl-name as character no-undo.
     2896     define variable v-where         as character no-undo.
     2897     define variable bh_tbl-name     as handle    no-undo.
     2898     define variable vTable          as character no-undo.
     2899     do
     2900     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2901     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2902     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2903         run gen-where-keyr-tab(i-tableSerach,
     2904                                i-tablekey,
     2905                                p-key-rec,
     2906                                p-key-handle,
     2907                                p-db-name,
     2908                                p-tt-handle,
     2909                                output v-where).
     2910         if i-tableSerach ne "" and i-tableSerach ne ?
     2911         then do:
     2912            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2913            create buffer bh_tbl-name for table v-full-tbl-name .
     2914         end.
     2915         else do:
     2916            if p-tt-handle = ? then do:
     2917               assign
     2918                  vTable = entry( 1 , p-key-rec, chr(3) )
     2919               .
     2920               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2921               create buffer bh_tbl-name for table v-full-tbl-name .
     2922            end.
     2923            else do:
     2924               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2925            end.
     2926         end.
     2927         if p-tt-handle = ? then do:
     2928            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2929         end.
     2930         else do:
     2931            bh_tbl-name:find-first( v-where ) no-error .
     2932         end.
     2933         o-hn = bh_tbl-name.
     2934      end.
     2935   end procedure.
     2936   procedure gen-hn-keyr :
     2937     define input  parameter p-key-rec    as character no-undo.
     2938     define input  parameter p-key-handle as handle    no-undo .
     2939     define input  parameter p-db-name    as character no-undo .
     2940     define input  parameter p-tt-handle  as handle    no-undo .
     2941     define input  parameter p-stts-lock  as integer   no-undo .
     2942     define output parameter o-hn         as handle    no-undo.
     2943     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2944   end.
     2945   procedure gen-row-keyr :
     2946     define input  parameter p-key-rec    as character no-undo.
     2947     define input  parameter p-key-handle as handle    no-undo .
     2948     define input  parameter p-db-name    as character no-undo .
     2949     define input  parameter p-tt-handle  as handle    no-undo .
     2950     define input  parameter p-stts-lock  as integer   no-undo .
     2951     define output parameter p-tbl-row    as rowid     no-undo.
     2952     define output parameter p-tbl-name   as character no-undo.
     2953     define variable vHn as handle no-undo.
     2954       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2955       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2956       p-tbl-name =  vHn:table.
     2957       delete object vHn no-error.
     2958     if p-tbl-row = ? then do:
     2959       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info15, p-tbl-name, p-key-rec ).
     2960     end.
     2961     else do:
     2962       return.
     2963     end.
     2964   end procedure.
     2965   procedure gen-key-fv :
     2966     define input  parameter p-key-rec    as character no-undo .
     2967     define output parameter p-field-list as character no-undo .
     2968     define output parameter p-value-list as character no-undo.
     2969     do
     2970     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2971     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2972     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2973     :
     2974       define variable v-full-tbl-name  as character no-undo .
     2975       define variable bh_tbl-name      as handle    no-undo .
     2976       define variable v-tbl-name       as character no-undo .
     2977       define variable v-field-num      as integer   no-undo .
     2978       define variable v-count-fld      as integer   no-undo .
     2979       define variable v-inform         as character no-undo .
     2980       define variable v-ind            as integer   no-undo .
     2981       define variable v-idx-field-qnty as integer   no-undo .
     2982       define variable v-delim-key      as character no-undo .
     2983       if p-key-rec = ?
     2984         or p-key-rec = "":U
     2985       then do:
     2986         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     2987       end.
     2988       assign
     2989         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2990         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2991       .
     2992       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2993       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info15 ).
     2994       assign
     2995         v-inform = bh_tbl-name:index-information(1)
     2996         v-ind    = 2
     2997       .
     2998       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2999       on error undo, return error
     3000       :
     3001         assign
     3002           v-inform = bh_tbl-name:index-information( v-ind )
     3003           v-ind    = v-ind + 1
     3004         .
     3005       end.
     3006       if v-inform = ?
     3007         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3008         or entry( 3, v-inform, ",":U ) <> "1":U
     3009       then do:
     3010         delete object bh_tbl-name no-error.
     3011         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     3012       end.
     3013       assign
     3014         v-idx-field-qnty = num-entries( v-inform ) - 4
     3015       .
     3016       if v-idx-field-qnty < 2 then do:
     3017         delete object bh_tbl-name no-error.
     3018         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     3019       end.
     3020       assign
     3021         p-field-list = "":U
     3022         p-value-list = "":U
     3023         v-delim-key  = "":U
     3024         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3025         v-count-fld  = 0
     3026       .
     3027       block_where:
     3028       do v-ind = 1 to v-idx-field-qnty by 2
     3029       on error undo, return error
     3030       :
     3031         assign
     3032           v-count-fld = v-count-fld + 1
     3033         .
     3034         if v-count-fld > v-field-num then do:
     3035           leave block_where.
     3036         end.
     3037         assign
     3038           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3039           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3040         .
     3041         if v-ind = 1 then do:
     3042           assign
     3043             v-delim-key = chr(3)
     3044           .
     3045         end.
     3046       end.
     3047       delete object bh_tbl-name.
     3048       if v-count-fld <> v-field-num then do:
     3049         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info15, v-tbl-name ).
     3050       end.
     3051     end.
     3052   end procedure.
     3053   procedure gen-key-field :
     3054     define input  parameter p-table      as character no-undo .
     3055     define output parameter p-field-list as character no-undo .
     3056     do
     3057     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3058     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3059     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3060     :
     3061       define variable v-full-tbl-name  as character no-undo .
     3062       define variable bh_tbl-name      as handle    no-undo .
     3063       define variable v-tbl-name       as character no-undo .
     3064       define variable v-field-num      as integer   no-undo .
     3065       define variable v-count-fld      as integer   no-undo .
     3066       define variable v-inform         as character no-undo .
     3067       define variable v-ind            as integer   no-undo .
     3068       define variable v-idx-field-qnty as integer   no-undo .
     3069       define variable v-delim-key      as character no-undo .
     3070       if p-table = ?
     3071         or p-table = "":U
     3072       then do:
     3073         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info15 ).
     3074       end.
     3075       assign
     3076         v-tbl-name      = p-table
     3077         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3078       .
     3079       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3080       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info15 ).
     3081       assign
     3082         v-inform = bh_tbl-name:index-information(1)
     3083         v-ind    = 2
     3084       .
     3085       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3086       on error undo, return error
     3087       :
     3088         assign
     3089           v-inform = bh_tbl-name:index-information( v-ind )
     3090           v-ind    = v-ind + 1
     3091         .
     3092       end.
     3093       if v-inform = ?
     3094         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3095         or entry( 3, v-inform, ",":U ) <> "1":U
     3096       then do:
     3097         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     3098       end.
     3099       assign
     3100         v-idx-field-qnty = num-entries( v-inform ) - 4
     3101       .
     3102       if v-idx-field-qnty < 2 then do:
     3103         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     3104       end.
     3105       assign
     3106         p-field-list = "":U
     3107         v-delim-key  = "":U
     3108         v-count-fld  = 0
     3109       .
     3110       block_where:
     3111       do v-ind = 1 to v-idx-field-qnty by 2
     3112       on error undo, return error
     3113       :
     3114         assign
     3115           v-count-fld = v-count-fld + 1
     3116         .
     3117         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3118         if v-ind = 1 then do:
     3119           assign
     3120             v-delim-key = chr(3)
     3121           .
     3122         end.
     3123       end.
     3124       delete object bh_tbl-name.
     3125     end.
     3126   end procedure.
     3127   function AddUtdErrForTab returns logical
     3128   (idb-num         as integer ,
     3129    idoc-id         as integer ,
     3130    iTab            as character,
     3131    iObj            as handle ,
     3132    iCheckType      as character,
     3133    iCodeErr        as character,
     3134    iCheckObj       as character ):
     3135      define buffer utd-err for utd-err.
     3136      define buffer utd for utd.
     3137      find first utd where utd.db-num     eq idb-num
     3138                       and utd.doc-id     eq idoc-id
     3139                       and utd.Direction  eq 'Outbound'
     3140      no-lock no-error.
     3141      if available utd
     3142      then
     3143         return no.
     3144      define variable vRecKey as character no-undo.
     3145            run gen-key-rec (input iTab,
     3146                             input  iObj,
     3147                             output vRecKey).
     3148      find first utd-err where utd-err.db-num     eq idb-num
     3149                           and utd-err.doc-id     eq idoc-id
     3150                           and utd-err.CheckType  eq iCheckType
     3151                           and utd-err.CodeErr    eq iCodeErr
     3152                           and utd-err.CheckObj   eq iCheckObj
     3153      exclusive-lock no-error.
     3154      if not available utd-err
     3155      then do:
     3156         create utd-err.
     3157         assign
     3158            utd-err.db-num         = idb-num
     3159            utd-err.doc-id         = idoc-id
     3160            utd-err.CheckType      = iCheckType
     3161            utd-err.CodeErr        = iCodeErr
     3162            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3163            utd-err.reckey         = vRecKey
     3164            utd-err.qnty           = 1
     3165         .
     3166      end.
     3167      else
     3168         utd-err.qnty = utd-err.qnty + 1.
     3169      return utd-err.qnty eq 1.
     3170   end.
     3171   function AddUtdErr returns logical
     3172   (idb-num         as integer ,
     3173    idoc-id         as integer ,
     3174    iObj            as handle ,
     3175    iCheckType      as character,
     3176    iCodeErr        as character,
     3177    iCheckObj       as character ):
     3178      AddUtdErrForTab
     3179         (idb-num,
     3180          idoc-id,
     3181          iObj:table,
     3182          iObj,
     3183          iCheckType,
     3184          iCodeErr,
     3185          iCheckObj).
     3186   end.
     3187   function ClearUtdErrTypeCode returns logical
     3188   (idb-num         as integer,
     3189    idoc-id         as integer ,
     3190    iCheckType      as character,
     3191    iCodeErr        as character
     3192    ):
     3193      define buffer utd-err for utd-err.
     3194      if    iCheckType eq "*"
     3195         or iCheckType eq ?
     3196      then do:
     3197         if     iCodeErr ne ?
     3198            and iCodeErr ne "*"
     3199         then
     3200            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3201            view-as alert-box.
     3202         else
     3203         for each utd-err where utd-err.db-num  eq idb-num
     3204                            and utd-err.doc-id  eq idoc-id
     3205         exclusive-lock:
     3206            delete utd-err.
     3207         end.
     3208      end.
     3209      else do:
     3210         if    iCodeErr eq ?
     3211            or iCodeErr eq "*"
     3212         then do:
     3213            for each utd-err where utd-err.db-num     eq idb-num
     3214                               and utd-err.doc-id     eq idoc-id
     3215                               and utd-err.CheckType  eq iCheckType
     3216            exclusive-lock:
     3217               delete utd-err.
     3218            end.
     3219         end.
     3220         else do:
     3221            for each utd-err where utd-err.db-num     eq idb-num
     3222                               and utd-err.doc-id     eq idoc-id
     3223                               and utd-err.CheckType  eq iCheckType
     3224                               and ub.utd-err.CodeErr eq iCodeErr
     3225            exclusive-lock:
     3226               delete utd-err.
     3227            end.
     3228         end.
     3229      end.
     3230   end.
     3231   function ClearUtdErr returns logical
     3232   (idb-num         as integer,
     3233    idoc-id         as integer ,
     3234    iCheckType      as character
     3235    ):
     3236      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3237   end.
     3238   function GetMesError returns character
     3239   (itxt as character,
     3240    iobj as character ):
     3241    define variable vi as integer no-undo.
     3242    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3243       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3244    end.
     3245    return itxt.
     3246   end.
     3247   function GetTextErrorType returns character
     3248   (iCheckType as character,
     3249    iCodeErr   as character,
     3250    iChechObj  as character,
     3251    iType      as character  ):
     3252      define buffer code    for code.
     3253      define variable vError as character no-undo.
     3254      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3255                        and code.code   eq iCodeErr
     3256      no-lock no-error.
     3257      if available code
     3258      then do:
     3259         define variable vType as integer no-undo.
     3260         if code.misc3 eq "error"
     3261         then
     3262            vType = 0.
     3263         else if code.misc3 eq "warning"
     3264         then
     3265            vType = 1.
     3266         else if code.misc3 eq "Hiden"
     3267         then
     3268            vType = 2.
     3269         else
     3270            vtype = int(code.misc3) no-error.
     3271         case itype:
     3272            when "error"
     3273            then do:
     3274               if vtype eq 0
     3275               then
     3276                  vError = GetMesError(Code.CodeValue,iChechObj).
     3277            end.
     3278            when "warning"
     3279            then do:
     3280               if vtype <= 1
     3281               then
     3282                  vError = GetMesError(Code.CodeValue,iChechObj).
     3283            end.
     3284            otherwise do:
     3285               vError = GetMesError(Code.CodeValue,iChechObj).
     3286            end.
     3287         end.
     3288      end.
     3289      else
     3290         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3291      return vError.
     3292   end.
     3293   function GetTypeError returns integer
     3294   (iCheckType as character,
     3295    iCodeErr   as character):
     3296      define buffer code    for code.
     3297      define variable vType as integer no-undo.
     3298      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3299                        and code.code   eq iCodeErr
     3300      no-lock no-error.
     3301      if     not available code
     3302         and code.misc3 eq "error"
     3303      then
     3304         vType = 0.
     3305      else if code.misc3 eq "warning"
     3306      then
     3307         vType = 1.
     3308      else if code.misc3 eq "Hiden"
     3309      then
     3310         vType = 2.
     3311      else
     3312         vtype = int(code.misc3) no-error.
     3313      return vtype.
     3314   end.
     3315   function GetTextError returns character
     3316   (iCheckType as character,
     3317    iCodeErr   as character,
     3318    iChechObj  as character ):
     3319      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3320   end.
     3321   function GetErrForUtdStr returns character
     3322   (idb-num     as integer ,
     3323    idoc-id     as integer ,
     3324    iCheckType  as character
     3325    ):
     3326      define buffer utd-err for utd-err.
     3327      define buffer code    for code.
     3328      define variable vHQry as handle no-undo.
     3329      define variable vError as longchar no-undo.
     3330      define variable vErrorOne as longchar  no-undo.
     3331      define variable oError as character no-undo.
     3332      create query vHQry.
     3333      vHQry:set-buffers(buffer utd-err:handle).
     3334      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3335                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3336                               + if    iCheckType eq "*"
     3337                                    or iCheckType eq ?
     3338                                 then       ""
     3339                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3340      vHQry:query-open().
     3341      vHQry:get-first().
     3342      QRY-BLOCK:
     3343      repeat while not vHQry:query-off-end:
     3344         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3345         if     vErrorOne ne ""
     3346            and vErrorOne ne ?
     3347         then
     3348            vError = vError + ", " + vErrorOne.
     3349         vHQry:get-next().
     3350      end.
     3351      oError = substring(vError,3,4002).
     3352      return oError.
     3353   end.
     3354   function GetErrJsonForUtd returns character
     3355   (idb-num         as integer ,
     3356    idoc-id         as integer ,
     3357    iCheckType      as character
     3358    ):
     3359      define buffer utd-err for utd-err.
     3360      define variable vHQry as handle no-undo.
     3361      define variable vError as longchar no-undo.
     3362      define variable oError as character no-undo.
     3363      create query vHQry.
     3364      define variable vi as integer no-undo.
     3365      vHQry:set-buffers(buffer utd-err:handle).
     3366      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3367                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3368                               + if    iCheckType eq "*"
     3369                                    or iCheckType eq ?
     3370                                 then       ""
     3371                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3372      vHQry:query-open().
     3373      vHQry:get-first().
     3374      QRY-BLOCK:
     3375      repeat while not vHQry:query-off-end:
     3376         define variable vErrorOne as character no-undo.
     3377         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3378         if     vErrorOne ne ?
     3379            and vErrorOne ne ""
     3380         then do:
     3381            vi = vi + 1.
     3382            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3383                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3384                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3385         end.
     3386         vHQry:get-next().
     3387      end.
     3388      for first utd where utd.db-num eq idb-num
     3389                      and utd.doc-id eq idoc-id
     3390                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3391      no-lock,
     3392         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3393                                  and utd-marking-lines.doc-id eq idoc-id
     3394                                  and utd-marking-lines.doc-level eq 1
     3395      no-lock,
     3396         first marking where marking.mark eq utd-marking-lines.mark
     3397                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3398      no-lock:
     3399         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3400         if     vErrorOne ne ?
     3401            and vErrorOne ne ""
     3402         then do:
     3403            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3404                            + '","ОбъектОш":"' + marking.mark
     3405                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3406         end.
     3407      end.
     3408      if vError ne ""
     3409      then
     3410         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3411      return oError.
     3412   end.
     3413   function GetErrJsonForUtdReturn returns character
     3414   (idb-num         as integer ,
     3415    idoc-id         as integer ,
     3416    iCheckType      as character
     3417    ):
     3418      define buffer utd-err for utd-err.
     3419      define variable vHQry as handle no-undo.
     3420      define variable vError as longchar no-undo.
     3421      define variable oError as character no-undo.
     3422      define variable vi as integer no-undo.
     3423      create query vHQry.
     3424      vHQry:set-buffers(buffer utd-err:handle).
     3425      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3426                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3427                               + if    iCheckType eq "*"
     3428                                    or iCheckType eq ?
     3429                                 then       ""
     3430                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3431      vHQry:query-open().
     3432      vHQry:get-first().
     3433      QRY-BLOCK:
     3434      repeat while not vHQry:query-off-end:
     3435         define variable vErrorOne as character no-undo.
     3436         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3437         if     vErrorOne ne ?
     3438            and vErrorOne ne ""
     3439         then do:
     3440            vi = vi + 1.
     3441            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3442                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3443                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3444         end.
     3445         vHQry:get-next().
     3446      end.
     3447      if vError ne ""
     3448      then
     3449         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3450      return oError.
     3451   end.
     3452   function GetCodeTextError returns character
     3453   (iCheckType as character,
     3454    iCodeErr   as character,
     3455    iChechObj  as character,
     3456    output oCode as character,
     3457    output ovalue as character ):
     3458      define buffer code    for code.
     3459      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3460                        and code.code   eq iCodeErr
     3461      no-lock no-error.
     3462      if     available code
     3463      then do:
     3464         define variable vi as integer no-undo init ?.
     3465         vi = int(Code.misc3) no-error.
     3466         if    code.misc3 ne "error"
     3467            and vi ne 0
     3468         then
     3469            oCode = ?.
     3470         else if     Code.misc1 ne ?
     3471                 and Code.misc1 ne ""
     3472         then
     3473            assign
     3474               oCode  = GetMesError(Code.misc1,iChechObj)
     3475               ovalue = GetMesError(Code.misc2,iChechObj)
     3476            .
     3477      end.
     3478      return if oCode eq ""
     3479             then ""
     3480             else (oCode + "_" + ovalue).
     3481   end.
     3482   define temp-table TT-err no-undo
     3483     field code_ as character
     3484     field text_ as character
     3485   index code_ code_.
     3486   function GetErrTxtForUtd returns character
     3487   (idb-num         as integer ,
     3488    idoc-id         as integer ,
     3489    iCheckType      as character
     3490    ):
     3491      define buffer utd-err for utd-err.
     3492      define variable vHQry as handle no-undo.
     3493      define variable oError as character no-undo.
     3494      create query vHQry.
     3495      define variable vi as integer no-undo.
     3496      for each tt-err :
     3497         delete tt-err.
     3498      end.
     3499      vHQry:set-buffers(buffer utd-err:handle).
     3500      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3501                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3502                               + if    iCheckType eq "*"
     3503                                    or iCheckType eq ?
     3504                                 then       ""
     3505                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3506      vHQry:query-open().
     3507      vHQry:get-first().
     3508      define variable vcode as character no-undo.
     3509      define variable vvalue as character no-undo.
     3510      QRY-BLOCK:
     3511      repeat while not vHQry:query-off-end:
     3512         vi = vi + 1.
     3513         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3514         if vcode ne ?
     3515         then do:
     3516            find first tt-err where tt-err.code eq vcode
     3517            no-error.
     3518            if not available tt-err
     3519            then do:
     3520               create tt-err.
     3521               assign
     3522                  tt-err.code_ = vcode
     3523                  tt-err.text_ = vvalue
     3524               .
     3525            end.
     3526            else
     3527               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3528         end.
     3529         vHQry:get-next().
     3530      end.
     3531     find first utd where utd.db-num eq idb-num
     3532                         and utd.doc-id eq idoc-id
     3533         no-lock.
     3534      define buffer cancel_utd-lines for utd-lines.
     3535      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3536                                  and cancel_utd-lines.doc-id eq idoc-id
     3537      no-lock:
     3538         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3539         then do:
     3540            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3541                                        and utd-marking-lines.doc-id eq idoc-id
     3542                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3543            no-lock,
     3544               first marking where marking.mark eq utd-marking-lines.mark
     3545                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3546            no-lock:
     3547               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3548               find first tt-err where tt-err.code eq vcode
     3549               no-error.
     3550               if not available tt-err
     3551               then do:
     3552                  create tt-err.
     3553                  assign
     3554                     tt-err.code_ = vcode
     3555                     tt-err.text_ = vvalue
     3556                  .
     3557               end.
     3558               else
     3559                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3560            end.
     3561         end.
     3562         else do:
     3563            define variable vqnty as decimal no-undo.
     3564            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3565            if vqnty eq ? then vqnty = 0.
     3566            if vqnty ne cancel_utd-lines.Quantity
     3567            then do:
     3568               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3569               find first tt-err where tt-err.code eq vcode
     3570               no-error.
     3571               if not available tt-err
     3572               then do:
     3573                  create tt-err.
     3574                  assign
     3575                     tt-err.code_ = vcode
     3576                     tt-err.text_ = vvalue
     3577                  .
     3578               end.
     3579               else
     3580                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3581            end.
     3582         end.
     3583      end.
     3584      for each tt-err:
     3585         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3586      end.
     3587      return oError.
     3588   end.
     3589   define variable mFormatErr as character no-undo init "text".
     3590   function GetErrForUtd returns character
     3591   (idb-num         as integer ,
     3592    idoc-id         as integer ,
     3593    iType           as character
     3594    ):
     3595      if mFormatErr eq "text"
     3596      then
     3597         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3598      else do:
     3599         if itype eq "return"
     3600         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3601         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3602      end.
     3603   end.
     3604   function GetErrComText returns longchar
     3605   (icomment as character,
     3606    itext    as longchar ):
     3607       define variable vText as longchar no-undo.
     3608      if mFormatErr eq "text"
     3609      then do:
     3610         if icomment ne ""
     3611         then
     3612            icomment = substitute("comment:|&1|",icomment).
     3613         vText = icomment + itext.
     3614      end.
     3615      else do:
     3616         icomment = if icomment begins  '"'
     3617                    then icomment
     3618                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3619         vText = icomment + "," + itext.
     3620         vText = "~{" + trim(vText,",") + "~}".
     3621      end.
     3622      return vText.
     3623   end.
     3624   function CheckTypeForMarkLineType returns logical
     3625   (iObj            as handle,
     3626    iCheckType      as character,
     3627    iCodeErr        as character ,
     3628    iTypeErr        as character ):
     3629      define variable vRecKey-markLine as character no-undo.
     3630      define variable vGoodMark        as logical no-undo.
     3631      define variable vdb-num          as integer no-undo.
     3632      define variable vdoc-id          as integer no-undo.
     3633      define variable vlinenum         as integer no-undo.
     3634      define variable vErrorOne as character no-undo.
     3635      define buffer buf_utd-err for utd-err.
     3636      run gen-key-rec (input "utd-marking-lines",
     3637                       input  iObj,
     3638                       output vRecKey-markLine).
     3639      vGoodMark = yes.
     3640      vdb-num = iObj::db-num.
     3641      vdoc-id = iObj::doc-id.
     3642      vlinenum = iObj::linenum.
     3643      block-mark-err:
     3644      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3645                               and buf_utd-err.db-num = vdb-num
     3646                               and buf_utd-err.reckey = vRecKey-markLine
     3647                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3648                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3649      no-lock:
     3650         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3651         if     vErrorOne ne ?
     3652            and vErrorOne ne ""
     3653         then do:
     3654            vGoodMark = no.
     3655            leave block-mark-err.
     3656         end.
     3657      end.
     3658      return not vGoodMark.
     3659   end.
     3660   function CheckErrForMarkLineType returns logical
     3661   (iObj            as handle,
     3662    iType           as character  ):
     3663      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3664   end.
     3665   function CheckErrForMarkLine returns logical
     3666   (iObj            as handle):
     3667      return CheckErrForMarkLineType(iObj,"*").
     3668   end.
     3669   function CheckErrForLineTypeCode returns logical
     3670   (iObj                 as handle,
     3671    iCheckType           as character,
     3672    iCodeErr             as character,
     3673    iTypeErr             as character,
     3674    iOneErr              as logical):
     3675      define variable vRecKey-line     as character no-undo.
     3676      define buffer buf_utd-err for utd-err.
     3677      define variable vUtdlineError as logical no-undo.
     3678      define variable vErrorOne as character no-undo.
     3679            run gen-key-rec (input "utd-lines",
     3680                             input  iObj,
     3681                             output vRecKey-line).
     3682         define variable vdb-num as integer no-undo.
     3683         define variable vdoc-id as integer no-undo.
     3684         define variable vlinenum as integer no-undo.
     3685         vdb-num = iObj::db-num.
     3686         vdoc-id = iObj::doc-id.
     3687         vlinenum = iObj::linenum.
     3688         block-err:
     3689         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3690                                  and buf_utd-err.db-num = vdb-num
     3691                                  and buf_utd-err.reckey = vRecKey-line
     3692                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3693                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3694         no-lock:
     3695            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3696            if     vErrorOne ne ?
     3697               and vErrorOne ne ""
     3698            then do:
     3699               vUtdlineError = yes.
     3700               leave block-err.
     3701            end.
     3702         end.
     3703         if  not vUtdlineError
     3704         then do:
     3705            define variable vGoodMark as logical no-undo.
     3706            vGoodMark = yes.
     3707            block-line-err:
     3708            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3709                                         and utd-marking-lines.doc-id  eq vdoc-id
     3710                                         and utd-marking-lines.LineNum eq vLineNum
     3711            no-lock:
     3712               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3713               if     vGoodMark
     3714                  and iOneErr eq no
     3715               then
     3716                  leave block-line-err.
     3717               if     iOneErr = yes
     3718                  and not vGoodMark
     3719               then
     3720                  leave block-line-err.
     3721            end.
     3722            vUtdlineError = not vGoodMark.
     3723         end.
     3724      return vUtdlineError.
     3725   end.
     3726   function getErrForLineType returns character
     3727   (iObj            as handle,
     3728    iType           as character  ):
     3729      define variable vRecKey-line     as character no-undo.
     3730      define buffer buf_utd-err for utd-err.
     3731      define variable vUtdlineError as logical no-undo.
     3732      define variable vErrorOne as character no-undo.
     3733      define variable oError as character no-undo.
     3734            run gen-key-rec (input "utd-lines",
     3735                             input  iObj,
     3736                             output vRecKey-line).
     3737         define variable vdb-num as integer no-undo.
     3738         define variable vdoc-id as integer no-undo.
     3739         define variable vlinenum as integer no-undo.
     3740         vdb-num = iObj::db-num.
     3741         vdoc-id = iObj::doc-id.
     3742         vlinenum = iObj::linenum.
     3743         block-err:
     3744         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3745                                  and buf_utd-err.db-num = vdb-num
     3746                                  and buf_utd-err.reckey = vRecKey-line
     3747                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3748         no-lock:
     3749            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3750            if     vErrorOne ne ?
     3751               and vErrorOne ne ""
     3752            then do:
     3753               oError = oError + vErrorOne + " ".
     3754            end.
     3755         end.
     3756      return oError.
     3757   end.
     3758   function CheckErrForLineType returns logical
     3759   (iObj            as handle,
     3760    iType           as character  ):
     3761       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3762   end.
     3763   function CheckErrForLine returns logical
     3764   (iObj            as handle):
     3765      return CheckErrForLineType(iobj,"*").
     3766   end.
     3767   function CheckErrForUtd returns logical
     3768   (idb-num         as integer ,
     3769    idoc-id         as integer ):
     3770      for each utd-lines where utd-lines.db-num eq idb-num
     3771                           and utd-lines.doc-id eq idoc-id
     3772      no-lock :
     3773         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3774         then
     3775            return no.
     3776      end.
     3777      return yes.
     3778   end.
     3779   function CheckMarkUtd-28rel return logical
     3780    (input idb-num as integer,
     3781    input idoc-id as integer):
     3782    define buffer utd                   for utd.
     3783    define buffer utd-lines             for utd-lines.
     3784    define buffer utd-marking-lines     for utd-marking-lines.
     3785    define variable v-par-type as character no-undo.
     3786    define variable vgdsNoMark as logical no-undo.
     3787    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3788      define variable v-par-val  as character no-undo.
     3789      find first utd where utd.db-num eq idb-num
     3790                       and utd.doc-id eq idoc-id
     3791      no-lock no-error.
     3792      if available utd
     3793      then do:
     3794         if     utd.obj-code ne ?
     3795            and utd.obj-type ne ?
     3796         then do:
     3797            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3798            Block-utd-lines:
     3799            for each utd-lines where utd-lines.db-num eq idb-num
     3800                                 and utd-lines.doc-id eq idoc-id
     3801            no-lock:
     3802               if     utd-lines.gds-code ne ?
     3803                  and utd-lines.gds-code ne 0
     3804               then do:
     3805                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3806                       ( utd-lines.gds-code,
     3807                         'mark-type':U,
     3808                          output v-par-val,
     3809                          output v-par-type
     3810                       ).
     3811                  if     EDOParSec:IsEdo
     3812                     and EDOParSec:GetIsEDOForType(v-par-val)
     3813                  then do:
     3814                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3815                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3816                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3817                                                    and length(utd-marking-lines.mark) > 13
     3818                     no-lock no-error.
     3819                     if     avail utd-marking-lines
     3820                        and not CheckErrForLine(buffer utd-lines:handle)
     3821                     then
     3822                        leave Block-utd-lines.
     3823                  end.
     3824                  else
     3825                     vgdsNoMark = yes.
     3826               end.
     3827            end.
     3828            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3829            if vgdsNoMark then return available utd-lines . else return yes .
     3830         end.
     3831      end.
     3832      return yes.
     3833   end.
     3834   function CheckMarkUtd return logical
     3835    (input idb-num  as integer,
     3836     input idoc-id  as integer):
     3837     define buffer utd-lines             for ub.utd-lines.
     3838     block-line:
     3839     for each utd-lines where utd-lines.db-num eq idb-num
     3840                          and utd-lines.doc-id eq idoc-id
     3841     no-lock:
     3842        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3843        then
     3844           leave block-line.
     3845     end.
     3846     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3847     return available utd-lines.
     3848   end.
     3849   function CheckNotMarkUtd return logical
     3850    (input idb-num  as integer,
     3851     input idoc-id  as integer):
     3852     define buffer utd-lines             for ub.utd-lines.
     3853     for each utd-lines where utd-lines.db-num eq idb-num
     3854                          and utd-lines.doc-id eq idoc-id
     3855     no-lock:
     3856        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3857        then
     3858           return yes.
     3859     end.
     3860     return no.
     3861   end.
     3862   function CheckMarkUtdLine return logical
     3863    (input idb-num  as integer,
     3864     input idoc-id  as integer,
     3865     input iLineNum as integer):
     3866    define buffer utd                   for utd.
     3867    define buffer utd-lines             for utd-lines.
     3868    define buffer utd-marking-lines     for utd-marking-lines.
     3869    define variable v-par-type as character no-undo.
     3870    define variable vMarking        as logical no-undo.
     3871    define variable vArtic          as logical no-undo.
     3872    define variable vTransitional   as logical no-undo.
     3873    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3874      define variable v-par-val  as character no-undo.
     3875      find first utd where utd.db-num eq idb-num
     3876                       and utd.doc-id eq idoc-id
     3877      no-lock no-error.
     3878      if available utd
     3879      then do:
     3880         if     utd.obj-code ne ?
     3881            and utd.obj-type ne ?
     3882         then do:
     3883            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3884            Block-utd-lines:
     3885            for each utd-lines where utd-lines.db-num   eq idb-num
     3886                                 and utd-lines.doc-id   eq idoc-id
     3887                                 and utd-lines.LineNum  eq iLineNum
     3888            no-lock:
     3889               if     utd-lines.gds-code ne ?
     3890                  and utd-lines.gds-code ne 0
     3891               then do:
     3892                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3893                       ( utd-lines.gds-code,
     3894                         'mark-type':U,
     3895                          output v-par-val,
     3896                          output v-par-type
     3897                       ).
     3898                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3899                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3900                  if vMarking
     3901                  then do:
     3902                     block-marking:
     3903                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3904                                                    and utd-marking-lines.doc-id   eq idoc-id
     3905                                                    and utd-marking-lines.LineNum  eq iLineNum
     3906                                                    and length(utd-marking-lines.mark) > 13
     3907                     no-lock:
     3908                        if isOAD(utd-marking-lines.mark)
     3909                        then do:
     3910                           assign
     3911                              vArtic   = yes
     3912                              vMarking = no
     3913                           .
     3914                           leave block-marking.
     3915                        end.
     3916                     end.
     3917                  end.
     3918                  if vArtic
     3919                  then do:
     3920                     block-artic:
     3921                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3922                                                    and utd-marking-lines.doc-id   eq idoc-id
     3923                                                    and utd-marking-lines.LineNum  eq iLineNum
     3924                                                    and length(utd-marking-lines.mark) > 13
     3925                     no-lock:
     3926                        if isMark(utd-marking-lines.mark)
     3927                        then do:
     3928                           assign
     3929                              vArtic   = no
     3930                              vMarking = yes
     3931                           .
     3932                           leave block-artic.
     3933                        end.
     3934                     end.
     3935                  end.
     3936                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3937                  if vTransitional
     3938                  then do:
     3939                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3940                                                    and utd-marking-lines.doc-id   eq idoc-id
     3941                                                    and utd-marking-lines.LineNum  eq iLineNum
     3942                                                    and length(utd-marking-lines.mark) > 13
     3943                     no-lock no-error.
     3944                     if not available utd-marking-lines
     3945                     then assign
     3946                        vMarking = no
     3947                        vArtic   = no
     3948                     .
     3949                  end.
     3950               end.
     3951               else
     3952                  assign
     3953                     vMarking      = yes
     3954                     vArtic        = no
     3955                     vTransitional = no
     3956                  .
     3957               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3958               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3959               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3960            end.
     3961         end.
     3962      end.
     3963      return vMarking or vArtic.
     3964   end.
     3965   function getMarkUtdLine return logical
     3966    (input  idb-num  as integer,
     3967     input  idoc-id  as integer,
     3968     input  iLineNum as integer,
     3969     output oMarking        as logical,
     3970     output oArtic          as logical,
     3971     output oTransitional   as logical):
     3972     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3973     oArtic        = not oMarking
     3974            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3975     oTransitional = (oMarking or oArtic)
     3976            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3977   end.
     3978   function CheckMarking return logical
     3979    (input idb-num as integer,
     3980    input idoc-id as integer,
     3981    input iTypeErr as character ):
     3982     define variable vMarkutd as logical no-undo.
     3983     define variable vCrErr   as logical no-undo.
     3984     define buffer utd-lines         for utd-lines.
     3985     define buffer utd-marking-lines for utd-marking-lines.
     3986     define buffer marking           for marking.
     3987     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3988      block-line:
     3989      for each utd-lines where utd-lines.db-num eq idb-num
     3990                           and utd-lines.doc-id eq idoc-id
     3991      no-lock:
     3992         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3993         then do:
     3994            for each utd-marking-lines
     3995                     where utd-marking-lines.db-num  = utd-lines.db-num
     3996                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3997                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3998            no-lock:
     3999               if isMark(utd-marking-lines.mark)
     4000               then do:
     4001                  find first marking where marking.mark eq utd-marking-lines.mark
     4002                  no-lock no-error.
     4003                  if not available marking
     4004                  then do:
     4005                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     4006                     vCrErr = yes.
     4007                     next block-line.
     4008                  end.
     4009               end.
     4010            end.
     4011         end.
     4012      end.
     4013      return vCrErr.
     4014   end.
     4015   function CheckMarkForType return logical
     4016    (input idb-num   as integer,
     4017     input idoc-id   as integer):
     4018      define variable vMarking        as logical no-undo.
     4019      define variable vArtic          as logical no-undo.
     4020      define variable vTransitional   as logical no-undo.
     4021      define buffer utd-lines         for utd-lines.
     4022      define buffer utd-marking-lines for utd-marking-lines.
     4023      block-line:
     4024      for each utd-lines where utd-lines.db-num eq idb-num
     4025                           and utd-lines.doc-id eq idoc-id
     4026      no-lock:
     4027         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     4028                          output vMarking         , output vArtic          , output vTransitional).
     4029         for each utd-marking-lines
     4030                     where utd-marking-lines.db-num  = utd-lines.db-num
     4031                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4032                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4033         no-lock:
     4034            if length(utd-marking-lines.mark) < 14
     4035            then do:
     4036               if (vMarking or vArtic) and not vTransitional
     4037               then
     4038                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4039            end.
     4040            else if not isMark(utd-marking-lines.mark)
     4041            then do:
     4042               if vMarking
     4043               then
     4044                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4045            end.
     4046            else do:
     4047            end.
     4048         end.
     4049      end.
     4050   end.
     4051   function WeighedProd return logical
     4052      ( input p-gds-code as integer) :
     4053      define variable v-par-val  as character no-undo.
     4054      define variable v-par-type as character no-undo.
     4055              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4056               ( p-gds-code,
     4057                 'weighed-gds':U,
     4058                  output v-par-val,
     4059                  output v-par-type
     4060               ).
     4061      return logical(v-par-val).
     4062   end.
     4063   function WghProdVariable return logical
     4064       (input p-obj-type as char,
     4065        input p-obj-code as integer,
     4066        input p-gds-code as integer) :
     4067      define variable v-wgh-val  as character no-undo.
     4068      define variable v-par-val  as character no-undo.
     4069      define variable v-par-type as character no-undo.
     4070      define variable vMarking        as logical no-undo.
     4071      define variable vArtic          as logical no-undo.
     4072      define variable vTransitional   as logical no-undo.
     4073      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4074         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4075           ( p-gds-code,
     4076             'weighed-gds':U,
     4077              output v-wgh-val,
     4078              output v-par-type
     4079           ).
     4080       if logical(v-wgh-val) = yes then do:
     4081           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4082               ( p-gds-code,
     4083                 'mark-type':U,
     4084                  output v-par-val,
     4085                  output v-par-type
     4086               ).
     4087           if v-par-val <> "" then do:
     4088               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     4089               assign
     4090                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     4091                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     4092                  .
     4093           end.
     4094      end.
     4095      if v-wgh-val > "" and (vMarking or vArtic)
     4096      then return yes.
     4097      else return no.
     4098   end.
     4099   function MarkWeight return decimal
     4100      ( input p-mark as character) :
     4101      define buffer  buf_marking-attr for  ub.marking-attr.
     4102      define variable vMarkWeight as decimal no-undo.
     4103      vMarkWeight = 0.
     4104      if p-mark <> "" and p-mark <> ?
     4105      then do:
     4106          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4107                                        and buf_marking-attr.attr-code eq "weight"
     4108             no-lock no-error.
     4109          if not available buf_marking-attr
     4110          then do :
     4111            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4112                                          and buf_marking-attr.attr-code eq "weight"
     4113               no-lock no-error.
     4114          end .
     4115          if avail buf_marking-attr
     4116          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4117      end.
     4118      return vMarkWeight.
     4119   end.
     4120   if valid-handle( g#lib-trn4 ) = yes and
     4121      g#lib-trn4 <> this-procedure :handle and
     4122      g#lib-trn4 :get-signature( 'lib-trn4_gdnorsrv':U ) <> "":U
     4123   then do:
     4124     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     4125             "Попытка повторной загрузки библиотеки для работы со складскими документами (4)" skip( 0 )
     4126             g#lib-trn4                      skip( 0 )
     4127             g#lib-trn4 :type                skip( 0 )
     4128             g#lib-trn4 :file-name           skip( 0 )
     4129             valid-handle( g#lib-trn4     )  skip( 0 )
     4130             this-procedure :handle          skip( 0 )
     4131             this-procedure :type            skip( 0 )
     4132             this-procedure :file-name       skip( 0 )
     4133             valid-handle( this-procedure )  skip( 1 )
     4134     view-as alert-box error .
     4135     undo, return error .
     4136   end.
     4137   else do:
     4138     assign
     4139       g#lib-trn4 = this-procedure :handle
     4140     .
     4141     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     4142     gbl-hndllibObj = new gbl-hndllib ().
     4143     gbl-hndllibObj:InitHndl("g#lib-trn4", g#lib-trn4).
     4144     delete object gbl-hndllibObj.
     4145   end.
     4146   on delete of this-procedure do:
     4147     assign
     4148       g#lib-trn4 = ?
     4149     .
     4150     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     4151     gbl-hndllibObj = new gbl-hndllib ().
     4152     gbl-hndllibObj:InitHndl("g#lib-trn4", g#lib-trn4).
     4153     delete object gbl-hndllibObj.
     4154   end.
     4155   define stream str-err .
     4156   define variable v-mess as character no-undo.
     4157   procedure lib-trn4_gdnorsrv :
     4158     define  input parameter p-artic     like ub.goods.artic      no-undo .
     4159     define  input parameter p-prod-type like ub.goods.prod-type  no-undo .
     4160     define  input parameter p-prod-code like ub.goods.prod-code  no-undo .
     4161     define  input parameter p-doc-code  like ub.trn-doc.doc-code no-undo .
     4162     define output parameter p-process   as   logical             no-undo initial no .
     4163     define variable is-petrol as logical no-undo .
     4164     define variable is-pieces as logical no-undo .
     4165     define variable is-hold   as logical no-undo .
     4166     define buffer bf_trn-doc for ub.trn-doc .
     4167     do
     4168     on error undo, return error return-value
     4169     :
     4170   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4171     (
     4172        input p-artic
     4173     ,  input p-prod-type
     4174     ,  input p-prod-code
     4175     , output is-petrol
     4176     , output is-pieces
     4177     ) no-error.
     4178       if error-status :error or
     4179          is-petrol = ?       or
     4180          is-pieces = ?
     4181       then do:
     4182         return error substitute( 'Не могу определить признак топлива для товара &1 &2 &3.&4&5&4&6'
     4183                                , p-artic
     4184                                , p-prod-type
     4185                                , p-prod-code
     4186                                , chr(10)
     4187                                , return-value
     4188                                , error-status :get-message( 1 )
     4189                                ) .
     4190       end.
     4191       if is-petrol <> yes or
     4192          is-pieces <> no
     4193       then do:
     4194         return .
     4195       end.
     4196       find bf_trn-doc no-lock where
     4197            bf_trn-doc.doc-code = p-doc-code no-error .
     4198       if not available bf_trn-doc
     4199       then do:
     4200         return error substitute( 'Не найден документ № "&1".'
     4201                                , p-doc-code
     4202                                ) .
     4203       end.
     4204       if lookup( bf_trn-doc.ext-doc-type, 'ie,ee,re':U ) > 0
     4205       then do:
     4206   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     4208     (input  bf_trn-doc.doc-code
     4209     ,output is-hold
     4210     ) no-error .
     4211         if error-status :error or
     4212           is-hold = ?
     4213         then do:
     4214           assign
     4215             is-hold = no
     4216           .
     4217           return error substitute( 'Не могу определить признак межфирменности для документа № "&1".&2&3&2&4'
     4218                                  , p-doc-code
     4219                                  , chr(10)
     4220                                  , return-value
     4221                                  , error-status :get-message( 1 )
     4222                                  ) .
     4223         end.
     4224         assign
     4225           p-process = is-hold
     4226         .
     4227       end.
     4228       else do:
     4229         assign
     4230           p-process = lookup( bf_trn-doc.ext-doc-type, 'iv,ev,eo,rv':U ) > 0
     4231         .
     4232       end.
     4233     end.
     4234   end procedure.
     4235   procedure lib-trn4_chk4rsrv :
     4236     define  input parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     4237     define  input parameter p-is-hold-doc  as   logical                 no-undo .
     4238     define output parameter p-can-process  as   logical                 no-undo initial no .
     4239     do
     4240     on error undo, return error return-value
     4241     :
     4242       if lookup( p-ext-doc-type, 'ie,ee,re':U ) > 0 or
     4243          lookup( p-ext-doc-type, 'iv,ev,io,eo,rv':U ) > 0 and
     4244          p-is-hold-doc = yes
     4245       then do:
     4246         assign
     4247           p-can-process = yes
     4248         .
     4249       end.
     4250     end.
     4251   end procedure.
     4252   define temp-table tt-ci_ret-doc        no-undo like lib-trn_ret-doc.
     4253   define temp-table tt-ci_ret-line       no-undo like lib-trn_ret-line.
     4254   define temp-table tt-ci_ret-line-attr  no-undo like lib-trn_ret-line-attr.
     4255   define temp-table tt-ci_ret-dtl        no-undo like lib-trn_ret-dtl.
     4256   define temp-table tt-ci_ret-parts      no-undo like lib-trn_ret-parts.
     4257   define temp-table tt-loc_ret-line      no-undo like lib-trn_ret-line.
     4258   define temp-table tt-loc_ret-line-attr no-undo like lib-trn_ret-line-attr.
     4259   define temp-table tt-loc_ret-dtl       no-undo like lib-trn_ret-dtl.
     4260   define temp-table tt-loc_ret-parts     no-undo like lib-trn_ret-parts.
     4261   procedure lib-trn4_copy-in :
     4262   define input parameter parparentproc    AS WIDGET-HANDLE           NO-UNDO.
     4263   define input parameter parrec-doc       as recid                   no-undo.
     4264   define input parameter table for tt-ci_ret-doc.
     4265   define input parameter table for tt-ci_ret-line.
     4266   define input parameter table for tt-ci_ret-line-attr.
     4267   define input parameter table for tt-ci_ret-dtl.
     4268   define input parameter table for tt-ci_ret-parts.
     4269   define input parameter parquestions       as logical                no-undo.
     4270   define input parameter parwait-on         as logical                no-undo.
     4271   define input parameter parrigid-rsrv      as logical                no-undo.
     4272   define input parameter parrsrv-fact-qnty  as logical                no-undo.
     4273   define input parameter parhandle-waitfram as handle                 no-undo.
     4274   define variable mode-create             as   logical               no-undo.
     4275   define variable rec-old                 as   recid                 no-undo.
     4276   define variable delta-line-vat          like ub.trn-doc.vat-base      no-undo.
     4277   define variable delta-line-slt          like ub.trn-doc.vat-base      no-undo.
     4278   define variable price-vat               like ub.trn-doc.vat-base      no-undo.
     4279   define variable line-rec                as   integer               no-undo.
     4280   define variable g-log                   as   logical               no-undo.
     4281   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
     4282   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
     4283   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
     4284   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
     4285   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
     4286   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
     4287   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
     4288   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
     4289   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
     4290   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
     4291   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
     4292   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
     4293   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
     4294   define variable varlns-cnt              as   integer               no-undo.
     4295   define buffer ci_trn-doc  for ub.trn-doc.
     4296   define buffer ci_doc-line for ub.doc-line.
     4297   define buffer ci_goods    for ub.goods.
     4298   c-i:
     4299   do transaction on error undo c-i, return error return-value :
     4300   find first ci_trn-doc where recid(ci_trn-doc) = parrec-doc.
     4301   find tt-ci_ret-doc.
     4302   if ci_trn-doc.exch-code <> tt-ci_ret-doc.exch-code then do:
     4303     if parquestions = no then do:
     4304       return error "Валюта документа - источника не совпадает с валютой заполняемого документа.".
     4305     end.
     4306     else do:
     4307       assign
     4308       g-log = no.
     4309       message "Валюта документа - источника не совпадает с валютой заполняемого документа !" skip
     4310               "Цены по ТТН в добавленых строках будут неправильными !!!  Продолжать ?"
     4311                view-as alert-box question buttons OK-Cancel update g-log.
     4312       if not g-log then return error.
     4313     end.
     4314   end.
     4315   if tt-ci_ret-doc.doc-type = 'при':U and
     4316      not tt-ci_ret-doc.internal then do:
     4317     if ci_trn-doc.inv-num = ? then ci_trn-doc.inv-num = tt-ci_ret-doc.inv-num.
     4318     if ci_trn-doc.ord-num = ? or
     4319        ci_trn-doc.ord-num = "" then do:
     4320       if ci_trn-doc.status_ = 'накл':U and
     4321          tt-ci_ret-doc.status_ = 'запрос':U then do:
     4322         ci_trn-doc.ord-num = tt-ci_ret-doc.doc-code.
     4323       end.
     4324       else do:
     4325         assign
     4326         ci_trn-doc.ord-num = tt-ci_ret-doc.ord-num.
     4327       end.
     4328     end.
     4329     if ci_trn-doc.ship-date  = ?  then ci_trn-doc.ship-date  = tt-ci_ret-doc.ship-date.
     4330     if ci_trn-doc.ship-num   = ?  then ci_trn-doc.ship-num   = tt-ci_ret-doc.ship-num.
     4331     if ci_trn-doc.exch-date  = ?  then ci_trn-doc.exch-date  = tt-ci_ret-doc.exch-date.
     4332     if ci_trn-doc.exch-rate  = ?  then ci_trn-doc.exch-rate  = tt-ci_ret-doc.exch-rate.
     4333     if ci_trn-doc.exch-scale = ?  then ci_trn-doc.exch-scale = tt-ci_ret-doc.exch-scale.
     4334   end.
     4335   if ci_trn-doc.agnt       = ? then ci_trn-doc.agnt       = tt-ci_ret-doc.agnt.
     4336   if ci_trn-doc.boss       = ? then ci_trn-doc.boss       = tt-ci_ret-doc.boss.
     4337   if ci_trn-doc.wrkr       = ? then ci_trn-doc.wrkr       = tt-ci_ret-doc.wrkr.
     4338   if ci_trn-doc.base-rate  = ? then ci_trn-doc.base-rate  = tt-ci_ret-doc.base-rate.
     4339   if ci_trn-doc.base-scale = ? then ci_trn-doc.base-scale = tt-ci_ret-doc.base-scale.
     4340   if ci_trn-doc.exch-code  = ? then ci_trn-doc.exch-code  = tt-ci_ret-doc.exch-code.
     4341   assign
     4342   varlns-cnt = 0.
     4343   if parwait-on then do:
     4344     run waitfram-show in parhandle-waitfram ("Добавление строк из документа - источника. ЖДИТЕ ...") no-error.
     4345   end.
     4346   for each tt-ci_ret-line use-index line-num on error undo, return error return-value :
     4347      find first ci_goods where ci_goods.artic     = tt-ci_ret-line.artic         and
     4348                                ci_goods.prod-type = tt-ci_ret-line.prod-type and
     4349                                ci_goods.prod-code = tt-ci_ret-line.prod-code no-lock.
     4350   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4351   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_goods-tr in g#lib-trn3
     4352   (input recid(ci_trn-doc)
     4353   ,input recid(ci_goods)
     4354   ) no-error
     4355   .
     4356      if error-status :error then do:
     4357        if parrigid-rsrv then do:
     4358          undo, return error substitute ("&1 &2", error-status :get-message(1), return-value).
     4359        end.
     4360        else do:
     4361          message
     4362          error-status :get-message(1) skip
     4363          return-value
     4364          view-as alert-box.
     4365          undo, next.
     4366        end.
     4367      end.
     4368      find first ci_doc-line where ci_doc-line.doc-code  = ci_trn-doc.doc-code     and
     4369                                   ci_doc-line.artic     = ci_goods.artic      and
     4370                                   ci_doc-line.prod-type = ci_goods.prod-type  and
     4371                                   ci_doc-line.prod-code = ci_goods.prod-code  no-error.
     4372      if available ci_doc-line then do:
     4373         assign
     4374         mode-create = no
     4375         varprice-cli-old       = ci_doc-line.price-cli
     4376         varprice-rubl-old      = ci_doc-line.price-rubl
     4377         varprice-base-old      = ci_doc-line.price-base
     4378         varcli-qnty-old        = ci_doc-line.cli-qnty
     4379         varcli-base-rate-old   = ci_doc-line.cli-base-rate
     4380         varfact-qnty-old       = ci_doc-line.fact-qnty
     4381         vardoc-qnty-old        = ci_doc-line.doc-qnty
     4382         varvat-pc-old          = ci_doc-line.vat-pc
     4383         varslt-pc-old          = ci_doc-line.slt-pc
     4384         varroad-tax-old        = ci_doc-line.road-tax
     4385         varexcise-old          = ci_doc-line.excise
     4386         vartransport-rubl-old  = ci_doc-line.transport-rubl
     4387         varother-rubl-old      = ci_doc-line.other-rubl.
     4388      end.
     4389      else mode-create = yes.
     4390      line-rec = ?.
     4391      for each tt-loc_ret-line on error undo, return error return-value :
     4392        delete tt-loc_ret-line.
     4393      end.
     4394      for each tt-loc_ret-line-attr on error undo, return error return-value :
     4395        delete tt-loc_ret-line-attr.
     4396      end.
     4397      for each tt-loc_ret-dtl on error undo, return error return-value :
     4398        delete tt-loc_ret-dtl.
     4399      end.
     4400      for each tt-loc_ret-parts on error undo, return error return-value :
     4401        delete tt-loc_ret-parts.
     4402      end.
     4403      create tt-loc_ret-line.
     4404      buffer-copy tt-ci_ret-line to tt-loc_ret-line.
     4405      for each tt-ci_ret-line-attr where tt-ci_ret-line-attr.doc-code  = tt-loc_ret-line.doc-code  and
     4406                                         tt-ci_ret-line-attr.gds-code  = ci_goods.gds-code on error undo, return error return-value     :
     4407         create tt-loc_ret-line-attr.
     4408         buffer-copy tt-ci_ret-line-attr to tt-loc_ret-line-attr.
     4409      end.
     4410      for each tt-ci_ret-dtl where tt-ci_ret-dtl.doc-code  = tt-loc_ret-line.doc-code  and
     4411                                   tt-ci_ret-dtl.artic     = tt-loc_ret-line.artic     and
     4412                                   tt-ci_ret-dtl.prod-type = tt-loc_ret-line.prod-type and
     4413                                   tt-ci_ret-dtl.prod-code = tt-loc_ret-line.prod-code on error undo, return error return-value :
     4414        create tt-loc_ret-dtl.
     4415        buffer-copy tt-ci_ret-dtl to tt-loc_ret-dtl.
     4416      end.
     4417      for each tt-ci_ret-parts where tt-ci_ret-parts.out-code  = tt-loc_ret-line.doc-code  and
     4418                                     tt-ci_ret-parts.obj-type  = tt-ci_ret-doc.obj-type    and
     4419                                     tt-ci_ret-parts.obj-code  = tt-ci_ret-doc.obj-code    and
     4420                                     tt-ci_ret-parts.artic     = tt-loc_ret-line.artic     and
     4421                                     tt-ci_ret-parts.prod-type = tt-loc_ret-line.prod-type and
     4422                                     tt-ci_ret-parts.prod-code = tt-loc_ret-line.prod-code on error undo, return error return-value :
     4423        create tt-loc_ret-parts.
     4424        buffer-copy tt-ci_ret-parts to tt-loc_ret-parts.
     4425      end.
     4426   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-inh in g#lib-trn
     4427   ( input parparentproc
     4428    ,input recid(ci_trn-doc)
     4429    ,input 'copy':U
     4430    ,input yes
     4431    ,input parrsrv-fact-qnty
     4432    ,input table tt-ci_ret-doc
     4433    ,input table tt-loc_ret-line
     4434    ,input table tt-loc_ret-line-attr
     4435    ,input table tt-loc_ret-dtl
     4436    ,input table tt-loc_ret-parts
     4437     ) no-error .
     4438      if error-status :error then do:
     4439         if parrigid-rsrv then do:
     4440           undo c-i, return error return-value.
     4441         end.
     4442         else do:
     4443           if parquestions then do:
     4444             assign g-log = no.
     4445             message "Ошибка при копировании в документ." skip
     4446                     return-value skip
     4447                     "Будем обрабатывать другие строки документа?"
     4448                     view-as alert-box question buttons yes-no update g-log.
     4449             if g-log = yes then do:
     4450               next.
     4451             end.
     4452             else do:
     4453               run waitfram-hide in parhandle-waitfram no-error.
     4454               undo, return error return-value .
     4455             end.
     4456           end.
     4457           else do:
     4458             next.
     4459           end.
     4460         end.
     4461      end.
     4462      find first ci_doc-line where ci_doc-line.doc-code  = ci_trn-doc.doc-code and
     4463                                   ci_doc-line.artic     = ci_goods.artic      and
     4464                                   ci_doc-line.prod-type = ci_goods.prod-type  and
     4465                                   ci_doc-line.prod-code = ci_goods.prod-code  no-error.
     4466     if available ci_doc-line then do:
     4467       if ci_doc-line.unit-cli = ? OR ci_doc-line.unit-cli = "" then do:
     4468           ci_doc-line.unit-cli = ci_goods.unit-cli.
     4469       end.
     4470       if mode-create then do:
     4471   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     4472     (
     4473      input parparentproc
     4474     ,input recid(ci_doc-line)
     4475     ,input ci_doc-line.doc-code
     4476     ,input ci_doc-line.artic
     4477     ,input ci_doc-line.prod-type
     4478     ,input ci_doc-line.prod-code
     4479     ,input 0
     4480     ,input 0
     4481     ,input 0
     4482     ,input 0
     4483     ,input 0
     4484     ,input 0
     4485     ,input 0
     4486     ,input 0
     4487     ,input 0
     4488     ,input 0
     4489     ,input 0
     4490     ,input 0
     4491     ,input 0
     4492     ,input 'create'
     4493     ,input ''
     4494     ) no-error.
     4495        if error-status :error then undo c-i, return error return-value.
     4496       end.
     4497       else do:
     4498   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     4499     (
     4500      input parparentproc
     4501     ,input recid(ci_doc-line)
     4502     ,input ci_doc-line.doc-code
     4503     ,input ci_doc-line.artic
     4504     ,input ci_doc-line.prod-type
     4505     ,input ci_doc-line.prod-code
     4506     ,input varprice-cli-old
     4507     ,input varprice-rubl-old
     4508     ,input varprice-base-old
     4509     ,input varcli-qnty-old
     4510     ,input varcli-base-rate-old
     4511     ,input varfact-qnty-old
     4512     ,input vardoc-qnty-old
     4513     ,input varvat-pc-old
     4514     ,input varslt-pc-old
     4515     ,input varroad-tax-old
     4516     ,input varexcise-old
     4517     ,input vartransport-rubl-old
     4518     ,input varother-rubl-old
     4519     ,input 'update'
     4520     ,input ''
     4521     ) no-error.
     4522         if error-status :error then undo c-i, return error return-value.
     4523       end.
     4524       run str/chk-prt.p (recid(ci_doc-line), no, buffer ci_trn-doc).
     4525     end.
     4526     varlns-cnt = varlns-cnt + 1.
     4527     if parwait-on then do:
     4528       run waitfram-show in parhandle-waitfram ("Добавление из документа - источника. Обработано : " + string (varlns-cnt)) no-error.
     4529     end.
     4530   end.
     4531   if parwait-on then do:
     4532     run waitfram-hide in parhandle-waitfram no-error.
     4533   end.
     4534   end.
     4535   end procedure.
     4536   procedure lib-trn4_int-clos :
     4537     define input  parameter parparentproc as widget-handle no-undo.
     4538     define input  parameter p-doc-code    as character no-undo .
     4539     define output parameter table for gds-list .
     4540     define variable varmode            as   character           no-undo.
     4541     define variable varstatus          like ub.trn-doc.status_  no-undo.
     4542     define variable varflag            like ub.trn-doc.flag_    no-undo.
     4543     define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     4544     define variable varcopyflag        like ub.trn-doc.flag_    no-undo.
     4545     define variable varpercent-expense as decimal   no-undo .
     4546     define variable varperc-expvalue   as character no-undo .
     4547     define variable varperc-exptype    as character no-undo .
     4548     define variable varchg-inv         as logical   no-undo .
