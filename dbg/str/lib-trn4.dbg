       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function usrfulnf returns character ( input p-user-id as character):
       80   define variable v-user-name as character no-undo .
       81   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
       83     (input  p-user-id
       84     ,output v-user-name
       85     ) no-error .
       86   if error-status:error
       87   or v-user-name = ""
       88   then do:
       89     return p-user-id.
       90   end.
       91   else do:
       92     return v-user-name.
       93   end.
       94   end function.
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define variable v-waitfram-action01         as character   no-undo .
       97   define variable v-waitfram-action02         as character   no-undo .
       98   define variable v-waitfram-action03         as character   no-undo .
       99   define variable mWaitFramTextBeg            as character   no-undo.
      100   define variable mWaitFramTextEnd            as character   no-undo.
      101   define variable mWaitFramView               as logical     no-undo.
      102   define variable mWaitProcEvent              as logical     no-undo init yes.
      103   define variable mWaitFramInterval           as integer     no-undo init 1 .
      104   define variable mWaitFramStop               as logical     no-undo.
      105   define variable mWaitFramStopUser           as logical     no-undo.
      106   define variable mWaitFramStopTimeOut        as logical     no-undo.
      107   define variable mWaitFramStartProc          as datetime-tz no-undo.
      108   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      109   define button B-WaitFramStop auto-end-key
      110        label "Стоп"
      111        size 10 by 1 tooltip "Остоновить процесс".
      112   define button B-viewProcInfo
      113        label "Информация"
      114        size 15 by 1 tooltip "Информация о процесс".
      115   define frame waitfram
      116     v-waitfram-action01 format "x(72)" no-label skip
      117     v-waitfram-action02 format "x(72)" no-label skip
      118     v-waitfram-action03 format "x(72)" no-label skip
      119     B-viewProcInfo
      120     B-WaitFramStop at row 4 col 30
      121     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      122     .
      123   define new global shared variable mBatchMode as logical no-undo init ?.
      124   define variable mFramBachModHandle as handle no-undo.
      125   mFramBachModHandle = frame waitfram:handle.
      126   define variable mFameOldVis as logical no-undo.
      127   define variable mVisCUrentVin as logical no-undo.
      128   if session:batch-mode
      129   then
      130      mBatchMode = yes.
      131   if mBatchMode = ? then do:
      132     mVisCUrentVin = current-window:visible.
      133     mFameOldVis = mFramBachModHandle:visible.
      134     mFramBachModHandle:visible  = yes.
      135     mBatchMode = mFramBachModHandle:visible ne yes.
      136     mFramBachModHandle:visible = mFameOldVis.
      137     current-window:visible = mVisCUrentVin.
      138   end.
      139    if  log-manager:logfile-name ne ?
      140     then DO:
      141         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      142         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      143         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      144     end.
      145   on choose of B-WaitFramStop in frame waitfram
      146   do:
      147     mWaitFramStop = yes.
      148     mWaitFramStopUser = yes.
      149   end.
      150   function waitfram-check-timeout returns logical():
      151      define variable vtime as int64 no-undo.
      152      if mWaitFramStopTimeOut
      153      then
      154         return yes.
      155      vtime = ( now - mWaitFramStartProc ) / 1000 .
      156      if     mWaitFramTimeOut ne ?
      157         and mWaitFramTimeOut ne 0
      158         and mWaitFramTimeOut lt vtime
      159      then do:
      160         mWaitFramStopTimeOut = yes.
      161      end.
      162      return mWaitFramStopTimeOut.
      163   end.
      164   procedure waitfram-hide :
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       pause 0 before-hide .
      170       if not mBatchMode then
      171         hide frame waitfram .
      172     if     not mWaitFramView
      173        and mWaitProcEvent
      174     then
      175       process events .
      176     end.
      177   end procedure.
      178   procedure waitfram-show :
      179     define input  parameter p-message as character no-undo .
      180     define variable v-left-margin as integer   no-undo .
      181     if not session:batch-mode
      182     then do
      183     on error undo, return error return-value
      184     :
      185       if length(p-message) <= 70 then do:
      186         assign
      187           v-left-margin = integer((70 - length(p-message)) / 2)
      188         .
      189         assign
      190           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      191         .
      192         assign
      193           v-waitfram-action01 = " "
      194           v-waitfram-action02 = " "
      195                                    + fill(" ", v-left-margin)
      196                                    + p-message
      197           v-waitfram-action03 = " "
      198         .
      199       end.
      200       else do:
      201         define variable vRindex1 as integer no-undo.
      202         define variable vRindex2 as integer no-undo.
      203         vRindex1 = r-index(p-message," ",70).
      204         if vRindex1 = 0
      205         then
      206            vRindex1 = 70.
      207         if length(p-message)  <= vRindex1 + 70 then do:
      208           assign
      209             v-waitfram-action01 = " "
      210             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      212           .
      213         end.
      214         else do:
      215           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      216           if vRindex2 <= vRindex1
      217           then
      218              vRindex2 = vRindex1 + 70.
      219           assign
      220             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      221             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      222             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      223           .
      224         end.
      225       end.
      226       B-viewProcInfo:visible   in frame waitfram = no.
      227       B-viewProcInfo:sensitive in frame waitfram = no.
      228       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      229       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      230       if  (   mWaitFramView
      231          or  mWaitProcEvent)
      232          and not mBatchMode
      233       then
      234          display
      235             v-waitfram-action01 skip
      236             v-waitfram-action02 skip
      237             v-waitfram-action03 skip
      238          with frame waitfram .
      239       if     mWaitFramView
      240          then do:
      241             if     mWaitFramInterval ne ?
      242                and not mBatchMode
      243             then
      244                wait-for go of frame waitfram pause mWaitFramInterval.
      245          end.
      246          else
      247             if     mWaitProcEvent
      248                and not mBatchMode
      249             then
      250                process events .
      251     end.
      252   end procedure.
      253      procedure waitfram-show-this:
      254         define input  parameter iInterval as int64 no-undo.
      255         define variable vtime as int64 no-undo.
      256         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      257         mWaitFramInterval = iInterval.
      258         run waitfram-show (substitute("&1&2 &3&4" ,
      259                                       mWaitFramTextBeg ,
      260                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      261                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      262                                       mWaitFramTextEnd
      263                                      )
      264                           ).
      265      end.
      266      procedure WaitFramRunPause:
      267         define input  parameter iInterval as dec no-undo.
      268         define variable vStart  as datetime-tz no-undo.
      269         define variable vend    as datetime-tz no-undo.
      270         define variable vint as int64 no-undo.
      271         define variable vOk as logical no-undo.
      272         vStart = now.
      273         vend   = vStart.
      274         publish "WaitFramPause" (iInterval,output vOk).
      275         vend   =  now.
      276         vint = vend - vStart.
      277         vint = iInterval - vint / 1000.
      278         if     not mWaitFramStop
      279            and (   vint > 0
      280                 or (    not vOk
      281                     and iInterval eq ?
      282                     )
      283                 )
      284         then
      285            run waitfram-show-this (iInterval).
      286         vend   =  now.
      287         vint = vend - vStart.
      288         vint = iInterval - vint / 1000.
      289         if     not mWaitFramStop
      290            and vint > 0
      291         then do:
      292            run gbl/pause.p (vint * 1000).
      293         end.
      294         if iInterval ne ?
      295         then
      296            publish "WaitFramStop".
      297         waitfram-check-timeout().
      298      end.
      299      procedure WaitFramWaitFor:
      300         define input  parameter iInterval as dec no-undo.
      301         assign
      302            mWaitFramStartProc   = now
      303            mWaitFramStopUser    = no
      304            mWaitFramStopTimeOut = no
      305         .
      306         block-wait:
      307         do while not mWaitFramStop:
      308            run WaitFramRunPause (iInterval).
      309            if  waitfram-check-timeout()
      310            then do:
      311               leave block-wait.
      312            end.
      313         end.
      314         run waitfram-hide.
      315      end.
      316   procedure waitfram-join :
      317     define input  parameter p-line-1  as character no-undo .
      318     define input  parameter p-line-2  as character no-undo .
      319     define input  parameter p-line-3  as character no-undo .
      320     define output parameter p-message as character no-undo .
      321     do
      322     on error undo, return error return-value
      323     :
      324       assign
      325         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      326                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      327                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      328       .
      329     end.
      330   end procedure.
      331   function waitfram-join-function returns character
      332     (input p-line-1 as character
      333     ,input p-line-2 as character
      334     ,input p-line-3 as character
      335     ).
      336     define variable v-message as character no-undo .
      337     run waitfram-join in this-procedure
      338       (input  p-line-1
      339       ,input  p-line-2
      340       ,input  p-line-3
      341       ,output v-message
      342       ) .
      343     return v-message .
      344   end function .
