     7275             "Ошибка при открытии документа " + buf_trn-doc.doc-code + chr(10) +
     7276             return-value + chr(10) +
     7277             trim( error-status :get-message( 1 ) ) +
     7278             trim( error-status :get-message( 2 ) ) +
     7279             trim( error-status :get-message( 3 ) ) +
     7280             trim( error-status :get-message( 4 ) ) +
     7281             trim( error-status :get-message( 5 ) ) + chr(10).
