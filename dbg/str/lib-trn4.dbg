        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-hndllib from propath.
        3   define variable vss-revision    as character no-undo initial "$Revision: f29df1d5f130, 3104, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: DRuban $":U .
