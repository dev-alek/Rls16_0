     1437                       then do:
     1438                           assign
     1439                               p-out-string = p-out-string + " ":U
     1440                           .
     1441                       end.
     1442                       when chr(7)
     1443                       then do:
     1444                           assign
     1445                               p-out-string = p-out-string + " ":U
     1446                           .
     1447                       end.
     1448                       when chr(8)
     1449                       then do:
     1450                           assign
     1451                               p-out-string = p-out-string + " ":U
     1452                           .
     1453                       end.
     1454                       when chr(9)
     1455                       then do:
     1456                           assign
     1457                               p-out-string = p-out-string + " ":U
     1458                           .
     1459                       end.
     1460                       when chr(29)
     1461                       then do:
