     7289   procedure lib-trn4_corrsprc :
     7290   define input  parameter p-action as character no-undo .
     7291   define input  parameter p-doc-code as character no-undo .
     7292   define output parameter p-mess as character no-undo .
     7293     do
     7294     on error undo, return error return-value
     7295     :
     7296   p-mess = "" .
     7297   if not ( p-action = "-" or p-action = "+" ) then return .
     7298   define buffer buf_trn-doc  for ub.trn-doc  .
     7299   define buffer buf_doc-line for ub.doc-line  .
     7300   define buffer buf_contract for ub.contract .
     7301   define buffer buf_contract-specif for ub.contract-specif .
     7302   define buffer buf_parts for ub.parts  .
     7303   find first buf_trn-doc no-lock where
     7304              buf_trn-doc.doc-code = p-doc-code and
     7305              buf_trn-doc.status_  = 'факт':U no-error .
     7306   if error-status :error then return .
     7307   if buf_trn-doc.ext-doc-type = 'ie':U then do:
     7308       find first buf_contract no-lock where
     7309                  buf_contract.host-code     = buf_trn-doc.host-code and
     7310                  buf_contract.contract-code = buf_trn-doc.contract-code no-error .
     7311                  if error-status :error then return .
     7312         for each buf_doc-line no-lock where
     7313                  buf_doc-line.doc-code = buf_trn-doc.doc-code :
     7314   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7315   ASSIGN
     7316      i-gl-Host-Code      = 0
     7317      i-gl-Contract-Code  = 0
     7318      i-gl-Extent3        = 0
     7319      .
     7320   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     7321       INPUT  buf_contract.host-code,
     7322       INPUT  buf_contract.contract-code,
     7323       OUTPUT i-gl-Extent3
     7324      ).
     7325   IF i-gl-Extent3[1] = 2 THEN DO:
     7326      ASSIGN
     7327         i-gl-Host-Code      = i-gl-Extent3[2]
     7328         i-gl-Contract-Code  = i-gl-Extent3[3]
     7329         .
     7330   END. ELSE DO:
     7331      ASSIGN
     7332         i-gl-Host-Code      = buf_contract.host-code
     7333         i-gl-Contract-Code  = buf_contract.contract-code
     7334         .
     7335   END.
     7336   FOR EACH
     7337       buf_contract-specif
     7338        EXCLUSIVE-LOCK
     7339        WHERE
     7340            buf_contract-specif.Host-code    = i-gl-Host-Code
     7341        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     7342               AND buf_contract-specif.artic        = buf_doc-line.artic
     7343               AND buf_contract-specif.prod-type    = buf_doc-line.prod-type
     7344               AND buf_contract-specif.prod-code    = buf_doc-line.prod-code :
     7345              if buf_contract-specif.qnty <> ? then do:
     7346                   if p-action = "+" then
     7347                   assign
     7348                     buf_contract-specif.income-qnty =
     7349                         ( if  buf_contract-specif.income-qnty = ? then 0 else  buf_contract-specif.income-qnty )
     7350                           + ( buf_doc-line.fact-qnty / buf_contract-specif.cli-base-rate )
     7351                   .
     7352                   else
     7353                   assign
     7354                     buf_contract-specif.income-qnty =
     7355                         (if  buf_contract-specif.income-qnty = ? then 0 else buf_contract-specif.income-qnty ) -
     7356                         ( buf_doc-line.fact-qnty / buf_contract-specif.cli-base-rate )
     7357                   .
     7358                if buf_contract-specif.income-qnty > buf_contract-specif.qnty
     7359                         then p-mess = p-mess +
     7360                             buf_contract-specif.artic + " "         + buf_contract-specif.prod-type +
     7361                             string(buf_contract-specif.prod-code)   + " Всего принято:" +
     7362                             string(buf_contract-specif.income-qnty) + " По спецификации:" +
     7363                             string(buf_contract-specif.qnty)        + chr(10) .
     7364              end.
     7365          end.
     7366         end.
     7367   end.
     7368   if buf_trn-doc.ext-doc-type = 'ep':U then do:
     7369     for each buf_parts no-lock where
     7370              buf_parts.out-code = buf_trn-doc.doc-code ,
     7371         first buf_contract no-lock where
     7372               buf_contract.host-code     = buf_trn-doc.host-code and
     7373               buf_contract.contract-code = buf_parts.contract-code :
     7374   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7375   ASSIGN
     7376      i-gl-Host-Code      = 0
     7377      i-gl-Contract-Code  = 0
     7378      i-gl-Extent3        = 0
     7379      .
     7380   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     7381       INPUT  buf_contract.host-code,
     7382       INPUT  buf_contract.contract-code,
     7383       OUTPUT i-gl-Extent3
     7384      ).
     7385   IF i-gl-Extent3[1] = 2 THEN DO:
     7386      ASSIGN
     7387         i-gl-Host-Code      = i-gl-Extent3[2]
     7388         i-gl-Contract-Code  = i-gl-Extent3[3]
     7389         .
     7390   END. ELSE DO:
     7391      ASSIGN
     7392         i-gl-Host-Code      = buf_contract.host-code
     7393         i-gl-Contract-Code  = buf_contract.contract-code
     7394         .
     7395   END.
     7396   FOR EACH
     7397       buf_contract-specif
     7398        EXCLUSIVE-LOCK
     7399        WHERE
     7400            buf_contract-specif.Host-code    = i-gl-Host-Code
     7401        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     7402               AND buf_contract-specif.artic        = buf_parts.artic
     7403               AND buf_contract-specif.prod-type    = buf_parts.prod-type
     7404               AND buf_contract-specif.prod-code    = buf_parts.prod-code :
     7405              if p-action = "+" then
     7406              assign
     7407                buf_contract-specif.income-qnty =
     7408                    (if  buf_contract-specif.income-qnty = ? then 0 else buf_contract-specif.income-qnty ) -
     7409                    ( buf_parts.qnty / buf_contract-specif.cli-base-rate )
     7410              .
     7411              else
     7412              assign
     7413                buf_contract-specif.income-qnty =
     7414                    (if  buf_contract-specif.income-qnty = ? then 0 else buf_contract-specif.income-qnty ) +
     7415                    ( buf_parts.qnty / buf_contract-specif.cli-base-rate )
     7416              .
     7417          end.
     7418     end.
     7419   end.
     7420   end.
     7421   end procedure.
     7422   procedure lib-trn4_linesprc :
     7423   define input  parameter p-recid-doc-line as recid no-undo .
     7424   define output parameter p-mess as character no-undo .
     7425     do
     7426     on error undo, return error return-value
     7427     :
     7428   p-mess = "" .
     7429   define buffer buf_trn-doc  for ub.trn-doc  .
     7430   define buffer buf_doc-line for ub.doc-line  .
     7431   define buffer buf_contract for ub.contract .
     7432   define buffer buf_goods    for ub.goods  .
     7433   define buffer buf_contract-specif for ub.contract-specif .
     7434   define variable v-income-qnty as decimal   no-undo .
     7435   find first buf_doc-line no-lock where recid(buf_doc-line) = p-recid-doc-line no-error .
     7436        if error-status :error then return .
     7437   find first buf_goods no-lock where
     7438              buf_goods.artic = buf_doc-line.artic and
     7439              buf_goods.prod-type = buf_doc-line.prod-type and
     7440              buf_goods.prod-code = buf_doc-line.prod-code no-error .
     7441   if error-status :error then do:
     7442     p-mess =  substitute("Не найден товар  &1 &2&3"  ,buf_doc-line.artic,buf_doc-line.prod-type,buf_doc-line.prod-code  ) .
     7443     return .
     7444   end.
     7445   if buf_goods.stts <> 0  then do:
     7446      p-mess = substitute("Товар удален : &1 &2&3 &4"  ,buf_doc-line.artic,buf_doc-line.prod-type,buf_doc-line.prod-code , buf_goods.gds-name  ) .
     7447   end.
     7448   find first buf_trn-doc no-lock where
     7449              buf_trn-doc.doc-code = buf_doc-line.doc-code
     7450              no-error .
     7451        if error-status :error then return .
     7452   define variable v-qnty-spec as logical   no-undo .
     7453   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7454   empty temp-table thbjattr_thbj-attr.
     7455   run adm/shattri.p (
     7456      input "get":U
     7457     ,input buf_trn-doc.obj-type
     7458     ,input buf_trn-doc.obj-code
     7459     ,input 'contr-in':U
     7460     ,input  ""
     7461     ,output v-value-character
     7462     ,output v-value-date
     7463     ,output v-value-decimal
     7464     ,output v-value-integer
     7465     ,output v-value-logical
     7466     ,output par-type
     7467     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7468     ) no-error .
     7469   for each thbjattr_thbj-attr :
     7470       if thbjattr_thbj-attr.prop-code = 'contr-qnty-spec':U then v-qnty-spec = thbjattr_thbj-attr.property-value-logical .
     7471   end.
     7472   if v-qnty-spec = false  then return .
     7473       find first buf_contract no-lock where
     7474                  buf_contract.host-code     = buf_trn-doc.host-code and
     7475                  buf_contract.contract-code = buf_trn-doc.contract-code no-error .
     7476                  if error-status :error then return .
     7477         if available buf_doc-line  then do :
     7478   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7479   ASSIGN
     7480      i-gl-Host-Code      = 0
     7481      i-gl-Contract-Code  = 0
     7482      i-gl-Extent3        = 0
     7483      .
     7484   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     7485       INPUT  buf_contract.host-code,
     7486       INPUT  buf_contract.contract-code,
     7487       OUTPUT i-gl-Extent3
     7488      ).
     7489   IF i-gl-Extent3[1] = 2 THEN DO:
     7490      ASSIGN
     7491         i-gl-Host-Code      = i-gl-Extent3[2]
     7492         i-gl-Contract-Code  = i-gl-Extent3[3]
     7493         .
     7494   END. ELSE DO:
     7495      ASSIGN
     7496         i-gl-Host-Code      = buf_contract.host-code
     7497         i-gl-Contract-Code  = buf_contract.contract-code
     7498         .
     7499   END.
     7500       FIND FIRST buf_contract-specif
     7501              NO-LOCK
     7502              WHERE
     7503                  buf_contract-specif.Host-code    = i-gl-Host-Code
     7504              AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     7505                 AND buf_contract-specif.artic        = buf_doc-line.artic
     7506                 AND buf_contract-specif.prod-type    = buf_doc-line.prod-type
     7507                 AND buf_contract-specif.prod-code    = buf_doc-line.prod-code
     7508              NO-ERROR.
     7509                   if not available buf_contract-specif then return .
     7510              if buf_contract-specif.qnty <> ?  and buf_contract-specif.qnty <> 0 then do:
     7511                   assign
     7512                   p-mess = "" .
     7513                    v-income-qnty =
     7514                       ( buf_doc-line.doc-qnty / buf_contract-specif.cli-base-rate )
     7515                       .
     7516                    if v-income-qnty > buf_contract-specif.qnty
     7517                         then do:
     7518                         p-mess =
     7519                             buf_contract-specif.artic + " " + buf_contract-specif.prod-type +
     7520                             string ( buf_contract-specif.prod-code ) +
     7521                             string ( buf_doc-line.doc-qnty ) + " (=" +  string(v-income-qnty) + ")" +
     7522                             " По спецификации:" +
     7523                             string ( if buf_contract-specif.qnty = ? then "неопределено" else string(buf_contract-specif.qnty)) + chr(10) .
     7524                         end.
     7525              end.
     7526          end.
     7527    end.
     7528   end procedure.
     7529   PROCEDURE userlogingerr :
     7530     define parameter buffer bf_trn-doc for ub.trn-doc .
     7531     define input parameter p-vid-action as integer no-undo.
     7532     define input parameter p-mess as character no-undo.
     7533     define input parameter p-db-num as integer no-undo.
     7534     define buffer bf_clients for ub.clients .
     7535     define variable v-vid-param       as character no-undo .
     7536     define variable v-action          as character no-undo .
     7537     define variable varshift-date as date      no-undo.
     7538     define variable varshift-num  as integer   no-undo.
     7539     define variable varshift-name as character no-undo.
     7540     find first bf_clients no-lock where bf_clients.obj-type = 'чел':U and  bf_clients.obj-code = bf_trn-doc.boss no-error.
     7541   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     7543     (input  c-trn-doc.obj-type
     7544     ,input  c-trn-doc.obj-code
     7545     ,output varshift-date
     7546     ,output varshift-num
     7547     ,output varshift-name
     7548     ) no-error .
     7549     if available (bf_trn-doc)
     7550     then do:
     7551       v-vid-param = "Initiator=" + "User" + chr(4) +
     7552                     "ResponsiblePerson=" + ( if available (bf_clients) then bf_clients.obj-name else "" ) + chr(4) +
     7553                     "SHOP_NUM=" + string(bf_trn-doc.obj-code) + chr(4) +
     7554                     "Contractor=" + bf_trn-doc.cli-name + chr(4) +
     7555                     "DocNum=" + string(bf_trn-doc.doc-code) + chr(4) +
     7556                     "FactDate=" + (if string(bf_trn-doc.fact-date) = ? then '' else string(bf_trn-doc.fact-date)) + chr(4) +
     7557                     "DocType=" + string(bf_trn-doc.doc-type) + chr(4) +
     7558                     "SHIFT_NUM_DOC=" + (if string(bf_trn-doc.shift-num) = ? then '' else string(bf_trn-doc.shift-num)) + (if string(bf_trn-doc.shift-date) = ? then '' else string(bf_trn-doc.shift-date, "99999999")) + chr(4) +
     7559                     "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
     7560                     "StatusOld=" + "" + chr(4) +
     7561                     "StatusNew=" + string(bf_trn-doc.status_) + (if bf_trn-doc.flag then "+" else "-" ) + chr(4) +
     7562                     "RESULT=" + string( 1 ) + chr(4) +
     7563                     "Description=" + p-mess no-error.
     7564     end.
     7565     run trg/userlog.p (
     7566           input 'update_err':U
     7567         , input 'trn-doc':U
     7568         , input buffer bf_trn-doc:handle
     7569         , input p-vid-action
     7570         , input v-vid-param
     7571     ) no-error.
     7572   end procedure.
     7573   procedure change_mark_sts_trn-doc:
     7574       define input parameter iDocCode like ub.trn-doc.doc-code no-undo.
     7575       define input parameter iObjType like ub.trn-doc.obj-type no-undo.
     7576       define input parameter iObjCode like ub.trn-doc.obj-code no-undo.
     7577       define input parameter iStatus  as   character           no-undo.
     7578       define variable vCount   as integer   no-undo.
     7579       define variable vElem    as character no-undo.
     7580       define buffer buf_doc-line      for ub.doc-line.
     7581       define buffer buf_goods         for ub.goods.
     7582       define buffer buf_marking-lines for ub.marking-lines.
     7583       define buffer buf_marking       for ub.marking.
     7584       if num-entries(iStatus,":") = 1 then iStatus = substitute("*:&1",iStatus).
     7585       for each buf_doc-line no-lock where buf_doc-line.doc-code = iDocCode:
     7586         find first buf_goods no-lock where
     7587                    buf_goods.artic     = buf_doc-line.artic
     7588                and buf_goods.prod-type = buf_doc-line.prod-type
     7589                and buf_goods.prod-code = buf_doc-line.prod-code.
     7590         for each buf_marking-lines exclusive-lock where
     7591                  buf_marking-lines.gds-code = buf_goods.gds-code
     7592              and buf_marking-lines.out-code = iDocCode
     7593              and buf_marking-lines.obj-type = iObjType
     7594              and buf_marking-lines.obj-code = iObjCode
     7595         :
     7596           for first buf_marking exclusive-lock where
     7597                    buf_marking.mark begins buf_marking-lines.mark:
     7598             CHNG:
     7599             do vCount = 1 to num-entries(iStatus):
     7600                 vElem = entry(vCount,iStatus).
     7601                 if can-do(entry(1,vElem,":"),string(buf_marking.sts)) then
     7602                 do:
     7603                     buf_marking.sts = integer(entry(2,vElem,":")).
     7604                     buf_marking-lines.sts = buf_marking.sts.
     7605                     validate buf_marking.
     7606                     leave CHNG.
     7607                 end.
     7608             end.
     7609           end.
     7610         end.
     7611       end.
     7612   end procedure.
