      399   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      401   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      402   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      403   ASSIGN
      404      v-S_CONTRACT                = "Contract":U
      405      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      406      v-DELIM_CHR_3               = ","
      407      .
      408   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      409   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      410   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      411   FUNCTION Can-Find-Spec RETURN LOGICAL (
      412      INPUT iHost-Code    AS INTEGER,
      413      INPUT iContract-Num AS INTEGER,
      414      INPUT iGds-Code     AS INTEGER ):
      415      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      416      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      417      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      418      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      419      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      420      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      421          INPUT  iHost-Code,
      422          INPUT  iContract-Num,
      423          OUTPUT iTmp-Extent3
      424          ).
      425      IF iTmp-Extent3[1] = 2 THEN DO:
      426         ASSIGN
      427            iTmp-Host-Code      = iTmp-Extent3[2]
      428            iTmp-Contract-Num   = iTmp-Extent3[3]
      429            .
      430      END. ELSE DO:
      431         ASSIGN
      432            iTmp-Host-Code      = iHost-Code
      433            iTmp-Contract-Num   = iContract-Num
      434            .
      435      END.
      436      IF iGds-Code = ? THEN DO:
      437         ASSIGN
      438            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      439                                  buf_Spec.Host-Code     = iTmp-Host-Code
      440                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      441                           ).
      442      END. ELSE DO:
      443            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      444                                  buf_Spec.Host-Code     = iTmp-Host-Code
      445                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      446                              AND buf_Spec.Gds-Code      = iGds-Code
      447                            ).
      448      END.
      449      RETURN (lRet).
      450   END FUNCTION.
      451   PROCEDURE MS-Contract-EXTENT-3:
      452      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      453      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      454      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      455      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      456      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      457      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      458      FIND FIRST buf_Cont-2 WHERE
      459                 buf_Cont-2.Host-Code      = i-Host-Code
      460             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      461           NO-LOCK NO-ERROR.
      462      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      463         RETURN.
      464      END.
      465      FOR FIRST buf_Ext-Classif WHERE
      466                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      467           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      468                                               STRING(i-Contract-code)
      469           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      470          NO-LOCK,
      471          EACH buf_Cont WHERE
      472               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      473           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      474          NO-LOCK:
      475          ASSIGN
      476             i-Ret[1] = 1
      477             i-Ret[2] = buf_Cont.Host-code
      478             i-Ret[3] = buf_Cont.Contract-code
      479             .
      480          LEAVE.
      481      END.
      482      IF i-Ret[1] <> 1 THEN DO:
      483         FOR FIRST buf_Ext-Classif WHERE
      484                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      485              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      486                                                  STRING(i-Contract-code)
      487              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      488             NO-LOCK,
      489             EACH buf_Cont WHERE
      490                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      491              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      492             NO-LOCK:
      493             ASSIGN
      494                i-Ret[1] = 2
      495                i-Ret[2] = buf_Cont.Host-code
      496                i-Ret[3] = buf_Cont.Contract-code
      497                .
      498             LEAVE.
      499         END.
      500      END.
      501      RETURN.
      502   END PROCEDURE.
      503   function is-mes returns logical
      504           (input doc-code as character):
      505   define variable result as logical no-undo init no.
      506   find first ub.inv-doc-attr no-lock where
      507   ub.inv-doc-attr.doc-code = doc-code and
      508   ub.inv-doc-attr.attr-code = "notMes" and
      509   ub.inv-doc-attr.attr-value = string(true) no-error .
      510   if available (ub.inv-doc-attr) then result = true.
      511   return result.
      512   end function.
      513   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   define new global shared variable g#trdcalib as handle no-undo.
      515   procedure placelib_write-attr:
      516   define input  parameter p-code     like ub.place-attr.attr-code .
      517   define input  parameter p-obj-code like ub.place-attr.obj-code .
      518   define input  parameter p-obj-type like ub.place-attr.obj-type .
      519   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      520   define input  parameter p-value    like ub.place-attr.attr-value .
      521   define output parameter p-ok       as logical.
      522   define buffer buf_place-attr for ub.place-attr .
      523     do on error undo, return error return-value :
      524        p-ok = false.
      525        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      526                                                   and buf_place-attr.obj-code    = p-obj-code
      527                                                   and buf_place-attr.obj-type    = p-obj-type
      528                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      529        if not available buf_place-attr then do :
      530           create buf_place-attr.
      531           assign
      532             buf_place-attr.attr-code   = p-code
      533             buf_place-attr.attr-value  = p-value
      534             buf_place-attr.obj-code    = p-obj-code
      535             buf_place-attr.obj-type    = p-obj-type
      536             buf_place-attr.pl-code     = p-pl-code
      537           .
      538           p-ok = true.
      539        end.
      540        else do:
      541           buf_place-attr.attr-value  = p-value .
      542           p-ok = true.
      543        end.
      544     end.
      545   end.
      546   procedure placelib_get-attr:
      547   define input  parameter  p-code     like ub.place-attr.attr-code .
      548   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      549   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      550   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      551   define output parameter  p-value    like ub.place-attr.attr-value .
      552   define output parameter  p-ok       as logical.
      553   define buffer buf_place-attr for ub.place-attr .
      554     do on error undo, return error return-value :
      555        p-ok = false.
      556        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      557                                                   and buf_place-attr.obj-code    = p-obj-code
      558                                                   and buf_place-attr.obj-type    = p-obj-type
      559                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      560        if available buf_place-attr then do :
      561          p-value = buf_place-attr.attr-value.
      562          p-ok = true.
      563        end.
      564        else do :
      565          p-ok = false.
      566        end.
      567     end.
      568   end.
      569   procedure placelib_del-attr:
      570   define input parameter  p-code     like ub.place-attr.attr-code .
      571   define input parameter  p-obj-code like ub.place-attr.obj-code .
      572   define input parameter  p-obj-type like ub.place-attr.obj-type .
      573   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      574   define input parameter  p-value    like ub.place-attr.attr-value .
      575   define output parameter p-ok       as logical.
      576   define buffer buf_place-attr for ub.place-attr .
      577     do on error undo, return error return-value :
      578        p-ok = false.
      579        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      580                                                   and buf_place-attr.obj-code    = p-obj-code
      581                                                   and buf_place-attr.obj-type    = p-obj-type
      582                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      583        if available buf_place-attr then do :
      584           delete buf_place-attr.
      585           p-ok = true.
      586        end.
      587     end.
      588   end.
      589   FUNCTION get-input-type RETURNS CHARACTER
      590     ( p-rec as recid ) :
      591     def    buffer loc-rvs-doc       for ub.rvs-doc  .
      592     define buffer loc-rvs-line      for ub.rvs-line .
      593     define buffer loc-rvs-line-attr for ub.rvs-line-attr .
      594     define variable v-doc-input-type  as character no-undo .
      595     define variable v-input-type-list as character no-undo .
      596     find first loc-rvs-doc no-lock where  recid ( loc-rvs-doc ) = p-rec no-error  .
      597     for each loc-rvs-line no-lock where loc-rvs-line.rvs-code = loc-rvs-doc.rvs-code :
      598       find first loc-rvs-line-attr no-lock
      599         where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
      600         and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
      601         and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
      602         and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
      603         and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
      604         and loc-rvs-line-attr.attr-code = 'input-type'
      605         no-error.
      606       if available loc-rvs-line-attr
      607         then
      608       do :
      609         v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
      610       end.
      611     end.
      612     if trim(v-input-type-list) = ""
      613       then
      614     do :
      615       for each loc-rvs-line no-lock where loc-rvs-line.rvs-code = loc-rvs-doc.rvs-code :
      616         find first loc-rvs-line-attr no-lock
      617           where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
      618           and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
      619           and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
      620           and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
      621           and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
      622           and loc-rvs-line-attr.attr-code = 'input-type-p'
      623           no-error.
      624         if available loc-rvs-line-attr
      625           then
      626         do :
      627           v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
      628         end.
      629         find first loc-rvs-line-attr no-lock
      630           where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
      631           and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
      632           and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
      633           and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
      634           and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
      635           and loc-rvs-line-attr.attr-code = 'input-type-t'
      636           no-error.
      637         if available loc-rvs-line-attr
      638           then
      639         do :
      640           v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
      641         end.
      642         find first loc-rvs-line-attr no-lock
      643           where loc-rvs-line-attr.obj-code  = loc-rvs-line.obj-code
      644           and loc-rvs-line-attr.obj-type  = loc-rvs-line.obj-type
      645           and loc-rvs-line-attr.gds-code  = loc-rvs-line.gds-code
      646           and loc-rvs-line-attr.pl-code   = loc-rvs-line.pl-code
      647           and loc-rvs-line-attr.rvs-code  = loc-rvs-line.rvs-code
      648           and loc-rvs-line-attr.attr-code = 'input-type-l'
      649           no-error.
      650         if available loc-rvs-line-attr
      651           then
      652         do :
      653           v-input-type-list = v-input-type-list + ',' + loc-rvs-line-attr.attr-value .
      654         end.
      655       end.
      656     end .
      657     if can-do(v-input-type-list, 'а')
      658       and not can-do(v-input-type-list, 'ф')
      659       and not can-do(v-input-type-list, 'ак')
      660       and not can-do(v-input-type-list, 'фк')
      661       and not can-do(v-input-type-list, 'п')
      662       then v-doc-input-type = 'а'.
      663     if can-do(v-input-type-list, 'ф')
      664       and not can-do(v-input-type-list, 'а')
      665       and not can-do(v-input-type-list, 'ак')
      666       and not can-do(v-input-type-list, 'фк')
      667       and not can-do(v-input-type-list, 'п')
      668       then v-doc-input-type = 'ф'.
      669     if  not can-do(v-input-type-list, 'ф')
      670       and can-do(v-input-type-list, 'ак')
      671       and not can-do(v-input-type-list, 'п')
      672       then v-doc-input-type = 'ак'.
      673     if ((can-do(v-input-type-list, 'ф')
      674       or can-do(v-input-type-list, 'п'))
      675       and can-do(v-input-type-list, 'а'))
      676       or can-do(v-input-type-list, 'фк')
      677       then v-doc-input-type = 'фк'.
      678     if can-do(v-input-type-list, 'р')
      679       and not can-do(v-input-type-list, 'а')
      680       and not can-do(v-input-type-list, 'ф')
      681       and not can-do(v-input-type-list, 'к')
      682       and not can-do(v-input-type-list, 'п')
      683       then v-doc-input-type = 'р'.
      684     if v-doc-input-type = 'а'
      685       and can-do(v-input-type-list, 'р')
      686       then v-doc-input-type = 'ак'.
      687     if v-doc-input-type = 'ф'
      688       and can-do(v-input-type-list, 'р')
      689       then v-doc-input-type = 'фк'.
      690     if v-doc-input-type = ? then v-doc-input-type = '' .
      691     return v-doc-input-type .
      692   END FUNCTION.
      693   FUNCTION getNunHoses RETURNS integer
      694     (p-doc-code as character) :
      695     define variable vGateValve as character no-undo.
      696     define variable vOk        as logical   no-undo.
      697     define variable vNumHoses  as integer   no-undo init 0.
      698     define buffer buf_doc-pl        for ub.doc-pl.
      699     define buffer buf_place         for ub.place.
      700     define buffer buf_doc-line      for ub.doc-line.
      701     define buffer buf_goods         for ub.goods.
      702     define buffer buf_doc-line-attr for ub.doc-line-attr.
      703     find first buf_doc-pl where
      704       buf_doc-pl.out-code = p-doc-code
      705       no-lock no-error.
      706     if avail buf_doc-pl then
      707       find first buf_place where
      708         buf_place.obj-type = buf_doc-pl.obj-type
      709         and buf_place.obj-code = buf_doc-pl.obj-code
      710         and buf_place.pl-code  = buf_doc-pl.pl-code
      711         no-lock no-error.
      712     if avail buf_place then
      713     do:
      714       run placelib_get-attr  (
      715         input "place-gate-valve"
      716         ,input buf_place.obj-code
      717         ,input buf_place.obj-type
      718         ,input buf_place.pl-code
      719         ,output vGateValve
      720         ,output vOk
      721         ) no-error.
      722       if not vOk or not logical(vGateValve) then
      723         vNumHoses = 1.
      724       else
      725       do:
      726         for first buf_doc-line where
      727           buf_doc-line.doc-code = p-doc-code
      728           no-lock,
      729           first buf_goods where
      730           buf_goods.artic     =  buf_doc-line.artic
      731           and buf_goods.prod-code =  buf_doc-line.prod-code
      732           and buf_goods.prod-type =  buf_doc-line.prod-type
      733           no-lock,
      734           first buf_doc-line-attr where
      735           buf_doc-line-attr.doc-code  = p-doc-code
      736           and buf_doc-line-attr.gds-code  = buf_goods.gds-code
      737           and buf_doc-line-attr.attr-code = "connect-hoses"
      738           no-lock:
      739           vNumHoses = if buf_doc-line-attr.attr-value = "yes" then 1 else 0.
      740         end.
      741       end.
      742     end.
      743     RETURN vNumHoses.
      744   END FUNCTION.
      745   function tempRas RETURNS decimal
      746     (doc-code as character,
      747     gds-code as integer):
      748     define variable v-temp as decimal   no-undo .
      749     define variable ii     as integer   no-undo .
      750     define variable is-rvd as character no-undo .
      751     define buffer buf_rvs-line for ub.rvs-line .
      752     define buffer buf_rvs-doc  for ub.rvs-doc .
      753     for each buf_rvs-doc no-lock where buf_rvs-doc.out-code = doc-code and
      754       buf_rvs-doc.rvs-type = 'после_док':U :
      755       is-rvd = get-input-type(recid(buf_rvs-doc)) .
      756       for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and
      757         buf_rvs-line.gds-code = gds-code:
      758         ii = ii + 1 .
      759         v-temp = v-temp + if is-rvd = 'а' then buf_rvs-line.temperature else buf_rvs-line.state-temperature .
      760       end.
      761       return v-temp / ii.
      762     end.
      763     return 0 .
      764   end function.
      765   function masRas RETURNS decimal
      766     (doc-code as character,
      767     gds-code as integer):
      768     define variable v-masDol as decimal no-undo .
      769     define buffer buf_doc-line-attr for ub.doc-line-attr .
      770     for first buf_doc-line-attr exclusive-lock where buf_doc-line-attr.doc-code = doc-code
      771       and buf_doc-line-attr.gds-code = gds-code
      772       and buf_doc-line-attr.attr-code = "propan-perc":
      773       v-masDol = decimal (buf_doc-line-attr.attr-value) .
      774     end.
      775     return v-masDol .
      776   end function.
      777   function autoAttr RETURNS character
      778     (doc-code as character,
      779     attr-code as character):
      780     define buffer buf_doc-attr       for ub.doc-attr .
      781     define buffer buf_auto-tank-attr for ub.auto-tank-attr .
      782     find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'car-num':U
      783       and buf_doc-attr.doc-code = doc-code no-error .
      784     if available (buf_doc-attr) then
      785     do:
      786       find first buf_auto-tank-attr no-lock where
      787         buf_auto-tank-attr.attr-code = attr-code and
      788         buf_auto-tank-attr.auto-num = buf_doc-attr.attr-value no-error .
      789       if available (buf_auto-tank-attr) then return buf_auto-tank-attr.attr-value .
      790     end.
      791     return "" .
      792   end function.
      793   function volumeGF RETURNS decimal
      794     (doc-code as character,
      795     gds-code as integer):
      796     define buffer buf_goods    for ub.goods .
      797     define buffer buf_rvs-doc  for ub.rvs-doc .
      798     define buffer buf_rvs-line for ub.rvs-line .
      799     define variable volue     as decimal no-undo .
      800     define variable beforeVol as decimal no-undo .
      801     define variable afterVol  as decimal no-undo .
      802     find first buf_goods no-lock where buf_goods.gds-code = gds-code no-error .
      803     if available (buf_goods) then
      804     do:
      805       find first buf_rvs-doc no-lock where buf_rvs-doc.out-code = doc-code and
      806         buf_rvs-doc.rvs-type = 'перед_док':U no-error .
      807       if available (buf_rvs-doc) then
      808       do:
      809         for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and
      810           buf_rvs-line.gds-code = buf_goods.gds-code:
      811           beforeVol = beforeVol + buf_rvs-line.state-measure-qnty .
      812         end.
      813       end.
      814       find first buf_rvs-doc no-lock where buf_rvs-doc.out-code = doc-code and
      815         buf_rvs-doc.rvs-type = 'после_док':U no-error .
      816       if available (buf_rvs-doc) then
      817       do:
      818         for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and
      819           buf_rvs-line.gds-code = buf_goods.gds-code :
      820           if buf_rvs-line.state-measure-qnty = ? then
      821           afterVol = afterVol + buf_rvs-line.state-brutto-qnty .
      822           else
      823           afterVol = afterVol + buf_rvs-line.state-measure-qnty .
      824         end.
      825       end.
      826     end.
      827     volue = (afterVol - beforeVol) / 1000 .
      828     return volue .
      829   end function.
      830   procedure tp-rtr:
      831     DEFINE INPUT  PARAMETER sug-temp  AS INTEGER NO-UNDO .
      832     DEFINE INPUT  PARAMETER mass-prop AS INTEGER NO-UNDO .
      833     DEFINE OUTPUT PARAMETER ktp       AS DECIMAL NO-UNDO .
      834     DO:
      835       if     sug-temp >  -40 and sug-temp <= -20
      836         and mass-prop >   0 and mass-prop <= 50
      837         then ktp = 0.040 .
      838       if     sug-temp >  -40 and sug-temp <= -20
      839         and mass-prop >  50 and mass-prop <= 60
      840         then ktp = 0.050  .
      841       if     sug-temp >  -40 and sug-temp <= -20
      842         and mass-prop >  60
      843         then ktp = 0.060  .
      844       if      sug-temp  > -20 and sug-temp  <=  0
      845         and mass-prop >   0 and mass-prop <= 50
      846         then ktp = 0.070  .
      847       if      sug-temp  > -20 and sug-temp  <=  0
      848         and mass-prop >  50 and mass-prop <= 60
      849         then ktp = 0.080 .
      850       if      sug-temp > -20 and sug-temp <=  0
      851         and mass-prop > 60
      852         then ktp = 0.110 .
      853       if      sug-temp >    0 and sug-temp <=  20
      854         and mass-prop >   0 and mass-prop <= 50
      855         then ktp = 0.130    .
      856       if      sug-temp >    0 and sug-temp <=  20
      857         and mass-prop >  50 and mass-prop <= 60
      858         then ktp = 0.150        .
      859       if      sug-temp >   0  and sug-temp <= 20
      860         and mass-prop > 60
      861         then ktp = 0.2 .
      862       if      sug-temp >   20
      863         and mass-prop >   0 and mass-prop <= 50
      864         then ktp = 0.210  .
      865       if      sug-temp >   20
      866         and mass-prop >  50 and mass-prop <= 60
      867         then ktp = 0.240   .
      868       if  sug-temp >      20
      869         and mass-prop > 60
      870         then ktp = 0.310  .
      871     END.
      872   END PROCEDURE.
      873   procedure tp-arm:
      874     DEFINE INPUT  PARAMETER  sug-temp  AS INTEGER NO-UNDO .
      875     DEFINE INPUT  PARAMETER  mass-prop AS INTEGER NO-UNDO .
      876     DEFINE OUTPUT PARAMETER  ktp       AS DECIMAL NO-UNDO .
      877     DO:
      878       if     sug-temp  >  -40 and sug-temp <= -20
      879         and mass-prop >   0 and mass-prop <= 50
      880         then ktp = 0.040   .
      881       if     sug-temp >  -40 and sug-temp <= -20
      882         and mass-prop >  50 and mass-prop <= 60
      883         then ktp = 0.040   .
      884       if     sug-temp >  -40 and sug-temp <= -20
      885         and mass-prop >  60
      886         then ktp = 0.050       .
      887       if      sug-temp  > -20 and sug-temp  <=  0
      888         and mass-prop >   0 and mass-prop <= 50
      889         then ktp = 0.070       .
      890       if      sug-temp  > -20 and sug-temp  <=  0
      891         and mass-prop >  50 and mass-prop <= 60
      892         then ktp = 0.070  .
      893       if      sug-temp > -20 and sug-temp <=  0
      894         and mass-prop > 60
      895         then ktp = 0.100  .
      896       if      sug-temp  >   0 and sug-temp <=  20
      897         and mass-prop >   0 and mass-prop <= 50
      898         then ktp = 0.120    .
      899       if      sug-temp >    0 and sug-temp <=  20
      900         and mass-prop >  50 and mass-prop <= 60
      901         then ktp = 0.190    .
      902       if      sug-temp >    0  and sug-temp <=  20
      903         and mass-prop >  60
      904         then ktp = 0.220   .
      905       if      sug-temp >   20 and mass-prop >   0
      906         and mass-prop <= 50
      907         then ktp = 0.210   .
      908       if      sug-temp >   20
      909         and mass-prop >  50 and mass-prop <= 60
      910         then ktp = 0.240   .
      911       if      sug-temp >   20 and mass-prop >  60
      912         then ktp = 0.280   .
      913     END.
      914   END PROCEDURE.
      915   procedure tp-emp:
      916     DEFINE INPUT  PARAMETER  sug-temp  AS INTEGER NO-UNDO .
      917     DEFINE INPUT  PARAMETER  mass-prop AS INTEGER NO-UNDO .
      918     DEFINE INPUT  PARAMETER  length    AS INTEGER NO-UNDO .
      919     DEFINE OUTPUT PARAMETER  ktp       AS DECIMAL NO-UNDO .
      920     DO:
      921       if     sug-temp  > -40 AND sug-temp  <= -20
      922         and mass-prop >   0 and mass-prop <=  50
      923         and length    >=   0 and length    <=   7
      924         then ktp = 7.081    .
      925       if     sug-temp  >  -40 AND sug-temp  <= -20
      926         and mass-prop >    0 and mass-prop <=  50
      927         and length    >    7
      928         then ktp = 9.441   .
      929       if     sug-temp  >  -40 AND sug-temp  <= -20
      930         and mass-prop >   50 and mass-prop <=  60
      931         and length    >=    0 and length    <=   7
      932         then ktp = 7.087   .
      933       if     sug-temp  >  -40 AND sug-temp  <= -20
      934         and mass-prop >   50 and mass-prop <=  60
      935         and length    >    7
      936         then ktp = 9.449  .
      937       if     sug-temp  >  -40 AND sug-temp  <= -20
      938         and mass-prop >   60
      939         and length    >=    0 and length    <=   7
      940         then ktp = 7.099          .
      941       if     sug-temp  >  -40 AND sug-temp  <= -20
      942         and mass-prop >   60
      943         and length    >    7
      944         then ktp = 9.466    .
      945       if     sug-temp  >  -20 AND sug-temp  <=   0
      946         and mass-prop >    0 and mass-prop <=  50
      947         and length    >=    0 and length    <=   7
      948         then ktp = 6.793   .
      949       if     sug-temp  >  -20 AND sug-temp  <=   0
      950         and mass-prop >    0 and mass-prop <=  50
      951         and length    >    7
      952         then ktp = 9.057  .
      953       if     sug-temp  >  -20 AND sug-temp  <=   0
      954         and mass-prop >   50 and mass-prop <=  60
      955         and length    >=    0 and length    <=   7
      956         then ktp = 6.801   .
      957       if     sug-temp  >  -20 AND sug-temp  <=   0
      958         and mass-prop >   50 and mass-prop <=  60
      959         and length    >    7
      960         then ktp = 9.068  .
      961       if     sug-temp  >  -20 AND sug-temp  <=   0
      962         and mass-prop >   60
      963         and length    >=    0 and length    <=   7
      964         then ktp = 6.822   .
      965       if     sug-temp  >  -20 AND sug-temp  <=   0
      966         and mass-prop >   60
      967         and length    >    7
      968         then ktp = 9.095    .
      969       if     sug-temp  >    0 AND sug-temp  <=  20
      970         and mass-prop >    0 and mass-prop <=  50
      971         and length    >=    0 and length    <=   7
      972         then ktp = 6.550    .
      973       if     sug-temp  >    0 AND sug-temp  <=  20
      974         and mass-prop >    0 and mass-prop <=  50
      975         and length    >    7
      976         then ktp = 8.734   .
      977       if     sug-temp  >   0 AND sug-temp  <=  20
      978         and mass-prop >   50 and mass-prop <=  60
      979         and length    >=    0 and length    <=   7
      980         then ktp = 6.566 .
      981       if     sug-temp  >    0 AND sug-temp  <=  20
      982         and mass-prop >   50 and mass-prop <=  60
      983         and length    >    7
      984         then ktp = 8.755  .
      985       if    sug-temp  >     0 AND sug-temp  <=  20
      986         and mass-prop >   60
      987         and length    >=    0 and length    <=   7
      988         then ktp = 6.605 .
      989       if    sug-temp   >    0 AND sug-temp  <=  20
      990         and mass-prop >   60
      991         and length    >    7
      992         then ktp = 8.807  .
      993       if    sug-temp   >   20
      994         and mass-prop >    0 and mass-prop <=  50
      995         and length    >=    0 and length    <=   7
      996         then ktp = 6.294  .
      997       if    sug-temp   >   20
      998         and mass-prop >   50 and mass-prop <=  60
      999         and length    >=    0 and length    <=   7
     1000         then ktp = 6.317  .
     1001       if    sug-temp   >   20
     1002         and mass-prop >   50 and mass-prop <=  60
     1003         and length    >    7
     1004         then ktp = 8.423   .
     1005       if    sug-temp   >   20
     1006         and mass-prop >   60
     1007         and length    >=    0 and length    <=   7
     1008         then ktp = 6.377    .
     1009       if    sug-temp   >   20
     1010         and mass-prop <=  60
     1011         and length    >=    0 and length    >    7
     1012         then ktp = 8.502   .
     1013     END.
     1014   END PROCEDURE.
     1015   procedure tp-ret:
     1016     DEFINE INPUT  PARAMETER  sug-temp  AS INTEGER NO-UNDO .
     1017     DEFINE OUTPUT PARAMETER  ktp       AS DECIMAL NO-UNDO .
     1018     DO:
     1019       if sug-temp > -40 and sug-temp <= -20 then ktp = 3.630 .
     1020       if sug-temp > -20 and sug-temp <=   0 then ktp = 3.350 .
     1021       if sug-temp >   0 and sug-temp <=  20 then ktp = 3.110 .
     1022       if sug-temp >  20                     then ktp = 2.910 .
     1023     END.
     1024   END PROCEDURE.
     1025   procedure tp-chklv:
     1026     DEFINE INPUT  PARAMETER  sug-temp  AS INTEGER NO-UNDO .
     1027     DEFINE INPUT  PARAMETER  mass-prop AS INTEGER NO-UNDO .
     1028     DEFINE OUTPUT PARAMETER  ktp       AS DECIMAL NO-UNDO .
     1029     DO:
     1030       if     sug-temp >  -40 and sug-temp <= -20
     1031         and mass-prop >   0 and mass-prop <= 50
     1032         then ktp = 0.940   .
     1033       if  sug-temp >  -40 and sug-temp <= -20
     1034         and mass-prop >  50 and mass-prop <= 60
     1035         then ktp = 1.050   .
     1036       if  sug-temp >  -40 and sug-temp <= -20
     1037         and mass-prop >  60
     1038         then ktp = 1.280   .
     1039       if  sug-temp >  -20 and sug-temp <=   0
     1040         and mass-prop >   0 and mass-prop <= 50
     1041         then ktp = 1.510         .
     1042       if  sug-temp >  -20 and sug-temp <=   0
     1043         and mass-prop >  50 and mass-prop <= 60
     1044         then ktp = 1.660   .
     1045       if  sug-temp >  -20 and sug-temp <=   0
     1046         and mass-prop >  60
     1047         then ktp = 2.040  .
     1048       if  sug-temp >   0 and sug-temp <=  20
     1049         and mass-prop >  0 and mass-prop <= 50
     1050         then ktp = 2.500    .
     1051       if  sug-temp >    0 and sug-temp <=  20
     1052         and mass-prop >  50 and mass-prop <= 60
     1053         then ktp = 2.780   .
     1054       if  sug-temp >    0 and sug-temp <=  20
     1055         and mass-prop >  60
     1056         then ktp = 3.450   .
     1057       if  sug-temp >   20
     1058         and mass-prop >   0 and mass-prop <= 50
     1059         then ktp = 3.760 .
     1060       if  sug-temp >   20
     1061         and mass-prop >  50 and mass-prop <= 60
     1062         then ktp = 4.160  .
     1063       if  sug-temp  > 20
     1064         and mass-prop > 60
     1065         then ktp = 5.160  .
     1066     END.
     1067   END PROCEDURE.
     1068   procedure doc-line-write:
     1069     define input parameter doc-code as character no-undo .
     1070     define input parameter attr-code as character no-undo .
     1071     define input parameter gds-code as integer no-undo .
     1072     define input parameter attr-value as character no-undo .
     1073     find first ub.doc-line-attr exclusive-lock where ub.doc-line-attr.attr-code = attr-code
     1074       and ub.doc-line-attr.doc-code = doc-code
     1075       and ub.doc-line-attr.gds-code = gds-code no-error .
     1076     if not available (ub.doc-line-attr) then
     1077     do:
     1078       create ub.doc-line-attr .
     1079       assign
     1080         ub.doc-line-attr.attr-code = attr-code
     1081         ub.doc-line-attr.doc-code  = doc-code
     1082         ub.doc-line-attr.gds-code  = gds-code
     1083         .
     1084     end.
     1085     ub.doc-line-attr.attr-value = attr-value .
     1086   end procedure .
     1087   procedure doc-line-value:
     1088     define input parameter doc-code as character no-undo .
     1089     define input parameter attr-code as character no-undo .
     1090     define input parameter gds-code as integer no-undo .
     1091     define output parameter attr-value as character no-undo .
     1092     find first ub.doc-line-attr exclusive-lock where ub.doc-line-attr.attr-code = attr-code
     1093       and ub.doc-line-attr.doc-code = doc-code
     1094       and ub.doc-line-attr.gds-code = gds-code no-error .
     1095     if available (ub.doc-line-attr) then
     1096     do:
     1097       if ub.doc-line-attr.attr-value <> ? then attr-value = ub.doc-line-attr.attr-value .
     1098     end.
     1099   end procedure .
     1100   procedure spr-sug:
     1101     define input parameter doc-code as character no-undo .
     1102     define input parameter reason-code as integer no-undo .
     1103     define buffer buf_doc-pl   for ub.doc-pl .
     1104     define buffer buf_doc-line for ub.doc-line .
     1105     define buffer buf_doc-attr for ub.doc-attr .
     1106     define buffer buf_trn-doc  for ub.trn-doc .
     1107     define buffer buf_clients-attr for ub.clients-attr .
     1108     define variable numHoses    as integer   no-undo .
     1109     define variable vBlowdown   as decimal   no-undo .
     1110     define variable vFittings   as decimal   no-undo .
     1111     define variable vEmptying   as decimal   no-undo .
     1112     define variable vRefund     as decimal   no-undo .
     1113     define variable vCtrlvalve  as decimal   no-undo .
     1114     define variable vTemp       as decimal   no-undo .
     1115     define variable vMasDol     as decimal   no-undo .
     1116     define variable vVolue      as decimal   no-undo .
     1117     define variable is-rvd      as logical   no-undo .
     1118     define variable lengthRukav as decimal   no-undo .
     1119     define variable ktp         as decimal   no-undo .
     1120     define variable valve       as logical   no-undo .
     1121     define variable clear-ac    as logical   no-undo .
     1122     define variable GNS         as character no-undo .
     1123     define variable own-supp    as logical   no-undo .
     1124     numHoses = getNunHoses(doc-code) .
     1125     lengthRukav = decimal (autoAttr(doc-code,"con-sleeve")) .
     1126     valve = if autoAttr(doc-code, "valve") = "" then false else logical(autoAttr(doc-code, "valve")) .
     1127     find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'clear-ac':U and
     1128       buf_doc-attr.doc-code = doc-code no-error .
     1129     if available (buf_doc-attr) then clear-ac = logical (buf_doc-attr.attr-value) .
     1130     find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'ptbobj':U and
     1131       buf_doc-attr.doc-code = doc-code no-error .
     1132     if available (buf_doc-attr) then GNS = buf_doc-attr.attr-value .
     1133     for each buf_doc-line no-lock where buf_doc-line.doc-code = doc-code:
     1134       find first ub.goods no-lock where ub.goods.artic = buf_doc-line.artic and
     1135         ub.goods.prod-code = buf_doc-line.prod-code and
     1136         ub.goods.prod-type = buf_doc-line.prod-type no-error .
     1137       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = doc-code no-error .
     1138       if available (buf_trn-doc) then
     1139       do:
     1140         find first buf_clients-attr where buf_clients-attr.obj-type = buf_trn-doc.cli-type
     1141           and buf_clients-attr.obj-code = buf_trn-doc.cli-code
     1142           and buf_clients-attr.attr-code = 'own-supp':U no-lock no-error .
     1143         if available (buf_clients-attr) then
     1144           own-supp = logical(buf_clients-attr.attr-value).
     1145         else own-supp = false .
     1146       end.
     1147       for first buf_doc-pl no-lock where buf_doc-pl.out-code = buf_doc-line.doc-code and
     1148         buf_doc-pl.gds-code = ub.goods.gds-code:
     1149         vTemp = tempRas(doc-code, ub.goods.gds-code) .
     1150         vMasDol = masRas(doc-code, ub.goods.gds-code) .
     1151         vVolue = volumeGF(doc-code, ub.goods.gds-code) .
     1152         run tp-rtr(vTemp, vMasDol, output ktp) .
     1153         vBlowdown = ktp * numHoses .
     1154         run tp-arm(vTemp, vMasDol, output ktp) .
     1155         vFittings = ktp * numHoses .
     1156         run tp-emp(vTemp, vMasDol, lengthRukav, output ktp) .
     1157         vEmptying = ktp * numHoses .
     1158         run tp-ret(vTemp, output ktp) .
     1159         vRefund = ktp * vVolue .
     1160         run tp-chklv(vTemp, vMasDol, output ktp) .
     1161         if reason-code = 99 and valve then vCtrlvalve = ktp .
     1162         else vCtrlvalve = 0 .
     1163         run doc-line-write(doc-code, "blowdown", ub.goods.gds-code, string (vBlowdown)) .
     1164         run doc-line-write(doc-code, "fittings", ub.goods.gds-code, string (vFittings)) .
     1165         run doc-line-write(doc-code, "emptying", ub.goods.gds-code, string (vEmptying)) .
     1166         run doc-line-write(doc-code, "refund", ub.goods.gds-code, string (vRefund)) .
     1167         run doc-line-write(doc-code, "ctrlvalve", ub.goods.gds-code, string (vCtrlvalve)) .
     1168       end.
     1169     end.
     1170   end procedure .
     1171   function check-RVD returns logical
     1172     (p-obj-code as integer,
     1173     p-obj-type as character,
     1174     p-pl-code as integer):
     1175     define buffer buf_place       for ub.place .
     1176     define buffer buf_place-attr  for ub.place-attr .
     1177     define buffer buf_place-attr2 for ub.place-attr .
     1178     find first buf_place-attr no-lock where buf_place-attr.obj-type = p-obj-type
     1179       and buf_place-attr.obj-code = p-obj-code
     1180       and buf_place-attr.attr-code = "place-need-RVD-rvs"
     1181       and buf_place-attr.pl-code = p-pl-code
     1182       and logical(buf_place-attr.attr-value) = yes
     1183       no-error .
     1184     if available buf_place-attr then return true .
     1185     for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = p-obj-type
     1186       and buf_place-attr2.obj-code = p-obj-code
     1187       and buf_place-attr2.pl-code  = p-pl-code
     1188       and buf_place-attr2.attr-code = "place-rvd-dnsty"
     1189       and logical(buf_place-attr2.attr-value) = yes
     1190       :
     1191       return true .
     1192     end .
     1193     for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = p-obj-type
     1194       and buf_place-attr2.obj-code = p-obj-code
     1195       and buf_place-attr2.pl-code  = p-pl-code
     1196       and buf_place-attr2.attr-code = "place-rvd-tmp"
     1197       and logical(buf_place-attr2.attr-value) = yes
     1198       :
     1199       return true .
     1200     end .
     1201     for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = p-obj-type
     1202       and buf_place-attr2.obj-code = p-obj-code
     1203       and buf_place-attr2.pl-code  = p-pl-code
     1204       and buf_place-attr2.attr-code = "place-rvd-lvl"
     1205       and logical(buf_place-attr2.attr-value) = yes
     1206       :
     1207       return true .
     1208     end .
     1209     return false .
     1210   end function .
     1211   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   define variable vss-include-info11 as character format "X(65)" no-undo
     1213   initial "@(#)$Workfile$ $Revision$".
     1214   procedure xmlchar-test :
     1215   define input parameter p-in-string          as character        no-undo.
     1216   define output parameter p-out-string-enc    as character        no-undo.
     1217   define output parameter p-out-string-dec    as character        no-undo.
     1218   do
     1219   on error undo, return error
     1220   :
     1221          run xmlchar-encode in this-procedure
     1222       (
     1223             input p-in-string
     1224           , output p-out-string-enc
     1225       ).
     1226          run xmlchar-decode in this-procedure
     1227       (
     1228             input p-out-string-enc
     1229           , output p-out-string-dec
     1230       ).
     1231   end.
     1232   end .
     1233   procedure xmlchar-encode :
     1234   define input parameter p-in-string      as character        no-undo.
     1235   define output parameter p-out-string    as character        no-undo.
     1236       define variable v-position      as integer      no-undo.
     1237       define variable v-current-char  as character    no-undo.
     1238   do
     1239   on error undo, return error
     1240   :
     1241       assign
     1242           p-out-string = "":U
     1243       .
     1244       case p-in-string
     1245       :
     1246           when ?
     1247           then do:
     1248               assign
     1249                   p-out-string = "?":U
     1250               .
     1251           end.
     1252           when "?":U
     1253           then do:
     1254               assign
     1255                   p-out-string = "&#63;":U
     1256               .
     1257           end.
     1258           otherwise do:
     1259               do v-position = 1 to length( p-in-string )
     1260               :
     1261                   assign
     1262                       v-current-char = substring( p-in-string, v-position, 1 )
     1263                   .
     1264                   case v-current-char
     1265                   :
     1266                       when "&":U
     1267                       then do:
     1268                           assign
     1269                               p-out-string = p-out-string + "&amp;":U
     1270                           .
     1271                       end.
     1272                       when ">":U
     1273                       then do:
     1274                           assign
     1275                               p-out-string = p-out-string + "&gt;":U
     1276                           .
     1277                       end.
     1278                       when "<":U
     1279                       then do:
     1280                           assign
     1281                               p-out-string = p-out-string + "&lt;":U
     1282                           .
     1283                       end.
     1284                       when "'":U
     1285                       then do:
     1286                           assign
     1287                               p-out-string = p-out-string + "&apos;":U
     1288                           .
     1289                       end.
     1290                       when '"':U
     1291                       then do:
     1292                           assign
     1293                               p-out-string = p-out-string + "&quot;":U
     1294                           .
     1295                       end.
     1296                       when chr(1)
     1297                       then do:
     1298                           assign
     1299                               p-out-string = p-out-string + "":U
     1300                           .
     1301                       end.
     1302                       when chr(2)
     1303                       then do:
     1304                           assign
     1305                               p-out-string = p-out-string + "":U
     1306                           .
     1307                       end.
     1308                       when chr(3)
     1309                       then do:
     1310                           assign
     1311                               p-out-string = p-out-string + "":U
     1312                           .
     1313                       end.
     1314                       when chr(4)
     1315                       then do:
     1316                           assign
     1317                               p-out-string = p-out-string + "":U
     1318                           .
     1319                       end.
     1320                       when chr(5)
     1321                       then do:
     1322                           assign
     1323                               p-out-string = p-out-string + "":U
     1324                           .
     1325                       end.
     1326                       when chr(6)
     1327                       then do:
     1328                           assign
     1329                               p-out-string = p-out-string + "":U
     1330                           .
     1331                       end.
     1332                       when chr(7)
     1333                       then do:
     1334                           assign
     1335                               p-out-string = p-out-string + "":U
     1336                           .
     1337                       end.
     1338                       when chr(8)
     1339                       then do:
     1340                           assign
     1341                               p-out-string = p-out-string + "":U
     1342                           .
     1343                       end.
     1344                       when chr(9)
     1345                       then do:
     1346                           assign
     1347                               p-out-string = p-out-string + "":U
     1348                           .
     1349                       end.
     1350                       when chr(29)
     1351                       then do:
     1352                           assign
     1353                               p-out-string = p-out-string + "":U
     1354                           .
     1355                       end.
     1356                       when chr(10)
     1357                       then do:
     1358                           assign
     1359                               p-out-string = p-out-string + "&#10;":U
     1360                           .
     1361                       end.
     1362                       when chr(13)
     1363                       then do:
     1364                           assign
     1365                               p-out-string = p-out-string + "&#13;":U
     1366                           .
     1367                       end.
     1368                       otherwise do:
     1369                           assign
     1370                               p-out-string = p-out-string + v-current-char
     1371                           .
     1372                       end.
     1373                   end case.
     1374               end.
     1375           end.
     1376       end case.
     1377   end.
     1378   end .
     1379   procedure xmlchar-encode-1c :
