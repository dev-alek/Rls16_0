     1419                       then do:
     1420                           assign
     1421                               p-out-string = p-out-string + " ":U
     1422                           .
     1423                       end.
     1424                       when chr(4)
     1425                       then do:
     1426                           assign
     1427                               p-out-string = p-out-string + " ":U
     1428                           .
     1429                       end.
     1430                       when chr(5)
     1431                       then do:
     1432                           assign
     1433                               p-out-string = p-out-string + " ":U
