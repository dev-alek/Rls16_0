     4557     define variable l_can-close_ee-ep  as logical   no-undo .
     4558     define variable l_is-hold-doc      as logical   no-undo .
     4559     define variable vardb-num          like ub.clients.db-num   no-undo.
     4560     define variable varfact-date       as date      no-undo .
     4561     define variable varshift-date      as date      no-undo .
     4562     define variable varshift-num       as integer   no-undo .
     4563     define variable varshift-name      as character no-undo .
     4564     define variable varlog             as logical   no-undo .
     4565     define variable varcheck-return    as logical   no-undo .
     4566     define variable v-error            as logical   no-undo .
     4567     define variable v-user-action      as character no-undo .
     4568     define variable v-printed          as logical   no-undo .
     4569     define variable v-event-code       as character no-undo .
     4570     define variable v-close-type       as integer   no-undo .
     4571     define variable v-not-eq-count     as int       no-undo .
     4572     define variable v-is-petrl         as logical   no-undo .
     4573     define variable v-is-pieces        as logical   no-undo .
     4574     define variable v-pay-agent-gd1    as integer no-undo .
     4575     define variable v-pay-agent-nm1    as character no-undo .
     4576     define variable v-pay-agent-ar1    as character no-undo .
     4577     define variable v-pay-agent-fl1    as logical no-undo .
     4578     define variable v-pay-agent-gd2    as integer no-undo .
     4579     define variable v-pay-agent-nm2    as character no-undo .
     4580     define variable v-pay-agent-ar2    as character no-undo .
     4581     define variable v-pay-agent-fl2    as logical no-undo .
     4582   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4583     define variable v-cntxt-db-num        as integer   no-undo .
     4584     define variable v-cntxt-userid        as character no-undo .
     4585     define variable v-cntxt-level         as character no-undo .
     4586     define variable v-cntxt-host-code-obj as integer   no-undo .
     4587     define variable v-cntxt-obj-type      as character no-undo .
     4588     define variable v-cntxt-obj-code      as integer   no-undo .
     4589     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4590     define variable v-cntxt-is-admin      as logical   no-undo .
     4591   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4592     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     4593     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     4594     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     4595     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     4596     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     4597     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     4598     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     4599     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     4600     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     4601     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     4602     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     4603     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     4604     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     4605     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     4606     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     4607     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     4608     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     4609     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     4610     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     4611     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     4612     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     4613     define variable v-cntxp-conf-par        as   character                no-undo.
     4614     define variable v-cntxp-par-type        as   character                no-undo.
     4615     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     4616     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     4617     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     4618     define variable v-cntxp-db-num          as integer   no-undo .
     4619     define variable v-cntxp-userid          as character no-undo .
     4620     define variable v-cntxp-level           as character no-undo .
     4621     define variable v-cntxp-db-num-obj      as integer   no-undo .
     4622     define variable v-cntxp-is-admin        as logical   no-undo .
     4623     define buffer bf-cntxp_store for ub.store.
     4624     define buffer bf-cntxp_shop  for ub.shop.
     4625     define buffer bf-cntxp_sysconf for ub.sysconf.
     4626   define buffer bf-db_clients for ub.clients.
     4627   define buffer buf_trn-doc   for ub.trn-doc .
     4628   define buffer exp_trn-doc   for ub.trn-doc .
     4629   define buffer buf_parts     for ub.parts  .
     4630   define buffer buf_doc-line for ub.doc-line .
     4631   define buffer buf_gds-dtl   for ub.gds-dtl .
     4632   define buffer buf_goods for ub.goods .
     4633   define buffer buf_marking-lines for ub.marking-lines .
     4634   define buffer buf_marking for ub.marking .
     4635   define variable var-ok-assort-pol   as logical   no-undo .
     4636   define variable var-mess-assort-pol as character no-undo .
     4637   define variable v-file-n as character no-undo .
     4638   define variable v-ischg-ext-type as logical no-undo .
     4639   define variable v-is-exemplar-goods as logical   no-undo .
     4640   define variable v-mark-weight as decimal   no-undo .
     4641   define variable v-isweighed as logical   no-undo .
     4642   define variable v-message           as character no-undo .
     4643   define variable v-scan-qnty as  integer   no-undo.
     4644   define variable v-GTIN     as character no-undo .
     4645   define variable v-codident as character no-undo.
     4646     do
     4647     on error undo, return error return-value
     4648     :
     4649       find first buf_trn-doc exclusive-lock
     4650         where buf_trn-doc.doc-code = p-doc-code
     4651         no-error .
     4652       if not available buf_trn-doc then do:
     4653         message
     4654           vss-workfile vss-revision vss-description skip
     4655           "Ошибка задания входных параметров" skip
     4656           "Не найден документ" skip
     4657           "Номер документа" p-doc-code skip
     4658           view-as alert-box error .
     4659         undo, return error return-value .
     4660       end.
     4661       if buf_trn-doc.ext-doc-type = 'iv':U
     4662       then do:
     4663         buf_trn-doc.ext-doc-type = 'ie':U.
     4664         buf_trn-doc.internal = false.
     4665         buf_trn-doc.discnt-type = "".
     4666         v-ischg-ext-type = true.
     4667         buf_trn-doc.tot-cli = buf_trn-doc.tot-calc.
     4668         buf_trn-doc.fact-date = today.
     4669         for first buf_parts no-lock where buf_parts.out-code = buf_trn-doc.doc-code :
     4670           buf_trn-doc.slt-type = buf_parts.slt-type .
     4671         end .
     4672       end.
     4673       v-file-n = replace( buf_trn-doc.doc-code, "*", "$" ) .
     4674       v-file-n = replace( v-file-n , ".", "$" ) .
     4675       v-file-n = replace( v-file-n , "/", "$" ) .
     4676       v-file-n = replace( v-file-n, "\", "$" ) .
     4677       v-file-n = replace( v-file-n, "=", "$" ) .
     4678   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4679     run mainmenu_getcntxt in parparentproc
     4680       (output v-cntxt-db-num
     4681       ,output v-cntxt-userid
     4682       ,output v-cntxt-level
     4683       ,output v-cntxt-host-code-obj
     4684       ,output v-cntxt-obj-type
     4685       ,output v-cntxt-obj-code
     4686       ,output v-cntxt-db-num-obj
     4687       ,output v-cntxt-is-admin
     4688       ) .
     4689   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4690     run mainmenu_getcntxt in parparentproc
     4691       (output v-cntxp-db-num
     4692       ,output v-cntxp-userid
     4693       ,output v-cntxp-level
     4694       ,output v-cntxp-curr-host-code
     4695       ,output v-cntxp-obj-type
     4696       ,output v-cntxp-obj-code
     4697       ,output v-cntxp-db-num-obj
     4698       ,output v-cntxp-is-admin
     4699       ) .
     4700     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     4701        v-cntxp-obj-code <> 0 then do:
     4702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4703     (input  'is-prt'
     4704     ,input  0
     4705     ,input  ''
     4706     ,input  0
     4707     ,input  ''
     4708     ,input  ''
     4709     ,input  ''
     4710     ,input  yes
     4711     ,output v-cntxp-conf-par
     4712     ,output v-cntxp-par-type
     4713     ) no-error .
     4714       case v-cntxp-obj-type :
     4715         when 'скл':U then do:
     4716           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     4717           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     4718           assign
     4719             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     4720             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     4721             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     4722             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     4723             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     4724             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     4725             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     4726             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     4727             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     4728             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     4729             v-cntxp-load-time       = bf-cntxp_store.load-time
     4730             v-cntxp-holidays        = bf-cntxp_store.holidays
     4731             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     4732             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     4733             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     4734             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     4735             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     4736             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     4737             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     4738             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     4739             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     4740             .
     4741         end.
     4742         when 'маг':U then do:
     4743           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
