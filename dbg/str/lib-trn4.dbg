      390   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      393   define variable par-type          as character no-undo.
      394   define variable v-value-character as character no-undo .
      395   define variable v-value-date      as date      no-undo .
      396   define variable v-value-decimal   as decimal   no-undo .
