        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo.
        4   define input parameter p-fbr-doc-recid  as recid            no-undo.
        5   define input parameter p-silent         as logical          no-undo .
        6   define input parameter p-goods-recid    as recid            no-undo.
        7   define input parameter p-autofbr        as logical          no-undo.
        8   define input parameter p-have-store     as logical          no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: 5baf537283c9, 2487, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       11   define variable vss-date        as character no-undo init "$Date: 2020/06/26 13:47:04 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: fbr-gds.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/fbr-gds.p $":U .
       14   define variable vss-description as character no-undo init "Резервирование одного товара в документе производства".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      315   procedure partslib-clear-temp-parts :
      316     define buffer buf_temp-parts for temp-parts .
      317     do
      318     on error undo, return error
      319     :
      320       for each buf_temp-parts
      321       on error undo, return error
      322       :
      323         delete buf_temp-parts .
      324       end.
      325     end.
      326   end procedure.
      327   procedure partslib-create-temp-parts :
      328     define parameter buffer buf_parts       for ub.parts .
      329     define parameter buffer buf_temp-parts  for temp-parts .
      330     define input  parameter p-goods-twounit as logical   no-undo .
      331     define variable v-base-part-code as character no-undo .
      332     do
      333     on error undo, return error
      334     :
      335       if p-goods-twounit = true
      336       then do:
      337         assign
      338           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      339         .
      340       end.
      341       else do:
      342         assign
      343           v-base-part-code = buf_parts.part-code
      344         .
      345       end.
      346       find first buf_temp-parts exclusive-lock
      347         where buf_temp-parts.obj-type  = buf_parts.obj-type
      348           and buf_temp-parts.obj-code  = buf_parts.obj-code
      349           and buf_temp-parts.artic     = buf_parts.artic
      350           and buf_temp-parts.prod-type = buf_parts.prod-type
      351           and buf_temp-parts.prod-code = buf_parts.prod-code
      352           and buf_temp-parts.in-code   = buf_parts.in-code
      353           and buf_temp-parts.out-code  = 'free-zone':U
      354           and buf_temp-parts.part-code = v-base-part-code
      355         no-error.
      356       if not available buf_temp-parts
      357       then do:
      358         create buf_temp-parts .
      359         buffer-copy buf_parts to buf_temp-parts
      360         assign
      361           buf_temp-parts.out-code  = 'free-zone':U
      362           buf_temp-parts.part-code = v-base-part-code
      363           buf_temp-parts.rsrv-free = yes
      364           buf_temp-parts.status_   = no
      365           buf_temp-parts.qnty      = 0
      366           buf_temp-parts.fact-qnty = 0
      367           buf_temp-parts.real-qnty = 0
      368           buf_temp-parts.cli-qnty  = 0
      369         .
      370       end.
      371     end.
      372   end procedure.
      373   procedure partslib-init-temp-parts :
      374     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      375     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      376     define input parameter p-artic           like ub.parts.artic     no-undo .
      377     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      378     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      379     define buffer buf_parts      for ub.parts .
      380     define buffer buf_temp-parts for temp-parts .
      381     define variable v-goods-twounit    as logical   no-undo .
      382     do
      383     on error undo, return error
      384     :
      385   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      387     (input  p-artic
      388     ,input  p-prod-type
      389     ,input  p-prod-code
      390     ,input  'twounit=request':u
      391     ,output v-goods-twounit
      392     ) no-error .
      393       if error-status :error
      394       then do:
      395         message
      396           vss-workfile vss-revision vss-description skip
      397           vss-include-info1 skip
      398           "Ошибка при определении атрибута товара" skip
      399           "Артикул" p-artic p-prod-type p-prod-code skip
      400           "twounit=request" skip
      401           error-status :get-message(1) skip
      402           return-value skip
      403           view-as alert-box error .
      404         undo, return error return-value .
      405       end.
      406       run partslib-clear-temp-parts in this-procedure .
      407       for each buf_parts
      408         where buf_parts.obj-type  = p-obj-type
      409           and buf_parts.obj-code  = p-obj-code
      410           and buf_parts.artic     = p-artic
      411           and buf_parts.prod-type = p-prod-type
      412           and buf_parts.prod-code = p-prod-code
      413           and buf_parts.rsrv-free = yes
      414           and buf_parts.status_   = no
      415           and buf_parts.in-code   <> buf_parts.out-code
      416       on error undo, return error
      417       :
      418         run partslib-create-temp-parts in this-procedure
      419           (buffer buf_parts
      420           ,buffer buf_temp-parts
      421           ,input  v-goods-twounit
      422           ) .
      423         define variable v-parts-qnty          as decimal   no-undo .
      424         define variable v-parts-cli-qnty      as decimal   no-undo .
      425         define variable v-parts-free-qnty     as decimal   no-undo .
      426         define variable v-parts-free-cli-qnty as decimal   no-undo .
      427         if buf_parts.out-code = 'free-zone':U
      428         then do:
      429           assign
      430             v-parts-qnty          = buf_parts.qnty
      431             v-parts-cli-qnty      = buf_parts.cli-qnty
      432             v-parts-free-qnty     = buf_parts.qnty
      433             v-parts-free-cli-qnty = buf_parts.cli-qnty
      434           .
      435         end.
      436         else do:
      437           assign
      438             v-parts-qnty          = abs(buf_parts.qnty)
      439             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      440             v-parts-free-qnty     = 0
      441             v-parts-free-cli-qnty = 0
      442           .
      443         end.
      444         assign
      445           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      446           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      447           buf_temp-parts.real-qnty     = 0
      448           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      449           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      450           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      451         .
      452       end.
      453     end.
      454   end procedure.
      455   procedure partslib-init-temp-parts-by-factord :
      456     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      457     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      458     define input parameter p-artic              like ub.parts.artic     no-undo .
      459     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      460     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      461     define input parameter p-fact-order         as decimal   no-undo .
      462     define input parameter p-include-fact-order as logical   no-undo .
      463     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      464     define buffer buf_gds-obj  for ub.gds-obj .
      465     do
      466     on error undo, return error
      467     :
      468       do transaction
      469       on error undo, return error
      470       :
      471   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      473     (input  p-obj-type
      474     ,input  p-obj-code
      475     ,input  p-artic
      476     ,input  p-prod-type
      477     ,input  p-prod-code
      478     ,buffer buf_gds-obj
      479     ) no-error .
      480         if error-status :error
      481         then do:
      482           message
      483             vss-workfile vss-revision vss-description skip
      484             vss-include-info1 skip
      485             "Невозможно найти товар на объекте" skip
      486             "Объект" p-obj-type p-obj-code skip
      487             "Артикул" p-artic p-prod-type p-prod-code skip
      488             error-status :get-message(1) skip
      489             return-value skip
      490             view-as alert-box error .
      491           undo, return error .
      492         end.
      493         find current buf_gds-obj exclusive-lock .
      494       end.
      495       run partslib-init-temp-parts in this-procedure
      496         (input p-obj-type
      497         ,input p-obj-code
      498         ,input p-artic
      499         ,input p-prod-type
      500         ,input p-prod-code
      501         ) no-error .
      502       if error-status :error
      503       then do:
      504         message
      505           vss-workfile vss-revision vss-description skip
      506           vss-include-info1 skip
      507           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      508           "Объект" p-obj-type p-obj-code skip
      509           "Артикул" p-artic p-prod-type p-prod-code skip
      510           "p-fact-order" p-fact-order skip
      511           view-as alert-box error .
      512         undo, return error .
      513       end.
      514       if p-include-fact-order = true
      515       then do:
      516         assign
      517           p-fact-order = p-fact-order - 0.0000000001
      518         .
      519       end.
      520       define variable v-max-fact-order as character no-undo .
      521       run factord-max-fact-order in this-procedure
      522         (output v-max-fact-order
      523         ) no-error .
      524       if error-status :error
      525       then do:
      526         message
      527           vss-workfile vss-revision vss-description skip
      528           vss-include-info1 skip
      529           "Ошибка при вызове процедуры factord-max-fact-order" skip
      530           "Объект" p-obj-type p-obj-code skip
      531           "Артикул" p-artic p-prod-type p-prod-code skip
      532           "p-fact-order" p-fact-order skip
      533           view-as alert-box error .
      534         undo, return error .
      535       end.
      536       run partslib-update-by-factord in this-procedure
      537         (input p-obj-type
      538         ,input p-obj-code
      539         ,input p-artic
      540         ,input p-prod-type
      541         ,input p-prod-code
      542         ,input p-fact-order
      543         ,input v-max-fact-order
      544         ,input false
      545         ) no-error .
      546       if error-status :error
      547       then do:
      548         message
      549           vss-workfile vss-revision vss-description skip
      550           vss-include-info1 skip
      551           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      552           "Объект" p-obj-type p-obj-code skip
      553           "Артикул" p-artic p-prod-type p-prod-code skip
      554           "p-fact-order" p-fact-order skip
      555           "v-max-fact-order" v-max-fact-order skip
      556           view-as alert-box error .
      557         undo, return error .
      558       end.
      559     end.
      560   end procedure.
      561   procedure partslib-update-by-factord :
      562     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      563     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      564     define input parameter p-artic              like ub.parts.artic     no-undo .
      565     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      566     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      567     define input parameter p-start-fact-order   as decimal   no-undo .
      568     define input parameter p-end-fact-order     as decimal   no-undo .
      569     define input parameter p-lock-gds-obj       as logical   no-undo .
      570     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      571     define buffer buf_gds-obj  for ub.gds-obj .
      572     define buffer buf_doc-line for ub.doc-line .
      573     define variable v-total-parts-qnty as decimal   no-undo .
      574     define variable v-goods-gds-goods  as logical   no-undo .
      575     define variable v-goods-twounit    as logical   no-undo .
      576     do
      577     on error undo, return error
      578     :
      579       if p-start-fact-order > p-end-fact-order
      580       then do:
      581         message
      582           vss-workfile vss-revision vss-description skip
      583           vss-include-info1 skip
      584           "Ошибка задания входных параметров" skip
      585           "Начало интервала превышает конец интервала" skip
      586           "Объект" p-obj-type p-obj-code skip
      587           "Артикул" p-artic p-prod-type p-prod-code skip
      588           "p-start-fact-order" p-start-fact-order skip
      589           "p-end-fact-order"   p-end-fact-order skip
      590           view-as alert-box error .
      591         undo, return error .
      592       end.
      593       if p-lock-gds-obj = true
      594       then do:
      595         do transaction
      596         on error undo, return error
      597         :
      598   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      600     (input  p-obj-type
      601     ,input  p-obj-code
      602     ,input  p-artic
      603     ,input  p-prod-type
      604     ,input  p-prod-code
      605     ,buffer buf_gds-obj
      606     ) no-error .
      607           if error-status :error
      608           then do:
      609             message
      610               vss-workfile vss-revision vss-description skip
      611               vss-include-info1 skip
      612               "Невозможно найти gds-obj" skip
      613               error-status :get-message(1) skip
      614               return-value skip
      615               view-as alert-box error .
      616             undo, return error .
      617           end.
      618           find current buf_gds-obj exclusive-lock .
      619         end.
      620       end.
      621   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      623     (input  p-artic
      624     ,input  p-prod-type
      625     ,input  p-prod-code
      626     ,input  'gds-goods=request':u
      627     ,output v-goods-gds-goods
      628     ) no-error .
      629       if error-status :error
      630       then do:
      631         message
      632           vss-workfile vss-revision vss-description skip
      633           vss-include-info1 skip
      634           "Ошибка при определении атрибута товара" skip
      635           "Артикул" p-artic p-prod-type p-prod-code skip
      636           "gds-goods=request" skip
      637           error-status :get-message(1) skip
      638           return-value skip
      639           view-as alert-box error .
      640         undo, return error return-value .
      641       end.
      642   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      644     (input  p-artic
      645     ,input  p-prod-type
      646     ,input  p-prod-code
      647     ,input  'twounit=request':u
      648     ,output v-goods-twounit
      649     ) no-error .
      650       if error-status :error
      651       then do:
      652         message
      653           vss-workfile vss-revision vss-description skip
      654           vss-include-info1 skip
      655           "Ошибка при определении атрибута товара" skip
      656           "Артикул" p-artic p-prod-type p-prod-code skip
      657           "twounit=request" skip
      658           error-status :get-message(1) skip
      659           return-value skip
      660           view-as alert-box error .
      661         undo, return error return-value .
      662       end.
      663       for each buf_doc-line no-lock
      664         where buf_doc-line.obj-type   = p-obj-type
      665           and buf_doc-line.obj-code   = p-obj-code
      666           and buf_doc-line.artic      = p-artic
      667           and buf_doc-line.prod-type  = p-prod-type
      668           and buf_doc-line.prod-code  = p-prod-code
      669           and buf_doc-line.status_    = 'факт':U
      670           and buf_doc-line.fact-order > p-start-fact-order
      671           and buf_doc-line.fact-order <= p-end-fact-order
      672       on error undo, return error
      673       :
      674         run partslib-process-document in this-procedure
      675           (input  buf_doc-line.doc-code
      676           ,input  p-obj-type
      677           ,input  p-obj-code
      678           ,input  p-artic
      679           ,input  p-prod-type
      680           ,input  p-prod-code
      681           ,input  v-goods-gds-goods
      682           ,input  v-goods-twounit
      683           ,output v-total-parts-qnty
      684           ) no-error .
      685         if error-status :error
      686         then do:
      687           message
      688             vss-workfile vss-revision vss-description skip
      689             vss-include-info1 skip
      690             "Ошибка при вызове процедуры partslib-process-document" skip
      691             "Документ" buf_doc-line.doc-code skip
      692             "Объект" p-obj-type p-obj-code skip
      693             "Артикул" p-artic p-prod-type p-prod-code skip
      694             "p-start-fact-order" p-start-fact-order skip
      695             "p-end-fact-order" p-end-fact-order skip
      696             error-status :get-message(1) skip
      697             return-value skip
      698             view-as alert-box error .
      699           undo, return error return-value .
      700         end.
      701       end.
      702     end.
      703   end procedure.
      704   procedure partslib-process-document :
      705     define input  parameter p-doc-code         as character no-undo .
      706     define input  parameter p-obj-type         as character no-undo .
      707     define input  parameter p-obj-code         as integer   no-undo .
      708     define input  parameter p-artic            as character no-undo .
      709     define input  parameter p-prod-type        as character no-undo .
      710     define input  parameter p-prod-code        as integer   no-undo .
      711     define input  parameter p-goods-gds-goods  as logical   no-undo .
      712     define input  parameter p-goods-twounit    as logical   no-undo .
      713     define output parameter p-total-parts-qnty as decimal   no-undo .
      714     define variable v-parts-sign as integer   no-undo .
      715     define buffer buf_trn-doc    for ub.trn-doc .
      716     define buffer buf_doc-line   for ub.doc-line .
      717     define buffer buf_parts      for ub.parts .
      718     define buffer buf_temp-parts for temp-parts .
      719     do
      720     on error undo, return error return-value
      721     :
      722       find first buf_trn-doc no-lock
      723         where buf_trn-doc.doc-code = p-doc-code
      724         no-error .
      725       if not available buf_trn-doc
      726       then do:
      727         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      728                                      ,p-doc-code
      729                                      ) .
      730       end.
      731       case buf_trn-doc.doc-type
      732       :
      733         when 'при':U or
      734         when 'возврат':U or
      735         when 'инв':U
      736         then do:
      737           assign
      738             v-parts-sign = -1
      739           .
      740         end.
      741         when 'рас':U or
      742         when 'спи':U
      743         then do:
      744           assign
      745             v-parts-sign = 1
      746           .
      747         end.
      748         otherwise do:
      749           undo, return error substitute("Неизвестный тип документа &1"
      750                                       ,buf_trn-doc.doc-type
      751                                       ) .
      752         end.
      753       end.
      754       find first buf_doc-line no-lock
      755         where buf_doc-line.doc-code  = p-doc-code
      756           and buf_doc-line.artic     = p-artic
      757           and buf_doc-line.prod-type = p-prod-type
      758           and buf_doc-line.prod-code = p-prod-code
      759         no-error .
      760       if not available buf_doc-line
      761       then do:
      762         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      763                                      ,p-doc-code
      764                                      ,artic
      765                                      ,prod-type
      766                                      ,prod-code
      767                                      ) .
      768       end.
      769       assign
      770         p-total-parts-qnty = 0
      771       .
      772       if p-goods-gds-goods = true
      773       then do:
      774         for each buf_parts no-lock
      775           where buf_parts.out-code  = p-doc-code
      776             and buf_parts.obj-type  = p-obj-type
      777             and buf_parts.obj-code  = p-obj-code
      778             and buf_parts.artic     = p-artic
      779             and buf_parts.prod-type = p-prod-type
      780             and buf_parts.prod-code = p-prod-code
      781         on error undo, return error
      782         :
      783           run partslib-create-temp-parts in this-procedure
      784             (buffer buf_parts
      785             ,buffer buf_temp-parts
      786             ,input  p-goods-twounit
      787             ) .
      788           assign
      789             p-total-parts-qnty        = p-total-parts-qnty
      790                                       + v-parts-sign * buf_parts.fact-qnty
      791             buf_temp-parts.qnty       = buf_temp-parts.qnty
      792                                       + v-parts-sign * buf_parts.fact-qnty
      793             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      794                                       + v-parts-sign * buf_parts.fact-qnty
      795             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      796                                       + v-parts-sign * buf_parts.cli-qnty
      797           .
      798           if buf_temp-parts.qnty = 0
      799           then do:
      800             delete buf_temp-parts .
      801           end.
      802         end.
      803       end.
      804       else do:
      805         assign
      806           p-total-parts-qnty = p-total-parts-qnty
      807                              + v-parts-sign * buf_doc-line.fact-qnty
      808         .
      809       end.
      810     end.
      811   end procedure.
      812   procedure partslib-init-temp-parts-by-date :
      813     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      814     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      815     define input parameter p-artic           like ub.parts.artic     no-undo .
      816     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      817     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      818     define input parameter p-fact-date       as date      no-undo .
      819     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      820     do
      821     on error undo, return error
      822     :
      823       define variable v-fact-order                as decimal   no-undo .
      824       define variable v-shift-end-fact-order      as decimal   no-undo .
      825       define variable v-day-end-fact-order        as decimal   no-undo .
      826       run factord in this-procedure
      827         (input  p-fact-date
      828         ,input  1
      829         ,input  1
      830         ,input  ?
      831         ,input  0
      832         ,input  false
      833         ,output v-fact-order
      834         ,output v-shift-end-fact-order
      835         ,output v-day-end-fact-order
      836         ) no-error .
      837       if error-status :error
      838       then do:
      839         message
      840           vss-workfile vss-revision vss-description skip
      841           vss-include-info1 skip
      842           "Ошибка при определении момента времени, на который требуется остаток" skip
      843           "Объект" p-obj-type p-obj-code skip
      844           "Артикул" p-artic p-prod-type p-prod-code skip
      845           "Дата" p-fact-date skip
      846           view-as alert-box error .
      847         undo, return error .
      848       end.
      849       run partslib-init-temp-parts-by-factord in this-procedure
      850         (input p-obj-type
      851         ,input p-obj-code
      852         ,input p-artic
      853         ,input p-prod-type
      854         ,input p-prod-code
      855         ,input v-day-end-fact-order
      856         ,input false
      857         ) no-error .
      858       if error-status :error
      859       then do:
      860         message
      861           vss-workfile vss-revision vss-description skip
      862           vss-include-info1 skip
      863           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      864           "Объект" p-obj-type p-obj-code skip
      865           "Артикул" p-artic p-prod-type p-prod-code skip
      866           "Дата" p-fact-date skip
      867           view-as alert-box error .
      868         undo, return error .
      869       end.
      870     end.
      871   end procedure.
      872   procedure partslib-calc-cost :
      873     define output parameter p-fact-qnty      as decimal   no-undo .
      874     define output parameter p-vat-pc         as decimal   no-undo .
      875     define output parameter p-slt-pc         as decimal   no-undo .
      876     define output parameter p-sum-base       as decimal   no-undo .
      877     define output parameter p-sum-rubl       as decimal   no-undo .
      878     define output parameter p-vat-base       as decimal   no-undo .
      879     define output parameter p-vat-rubl       as decimal   no-undo .
      880     define output parameter p-slt-base       as decimal   no-undo .
      881     define output parameter p-slt-rubl       as decimal   no-undo .
      882     define output parameter p-road-tax-base  as decimal   no-undo .
      883     define output parameter p-road-tax-rubl  as decimal   no-undo .
      884     define output parameter p-transport-base as decimal   no-undo .
      885     define output parameter p-transport-rubl as decimal   no-undo .
      886     define output parameter p-other-base     as decimal   no-undo .
      887     define output parameter p-other-rubl     as decimal   no-undo .
      888     define output parameter p-excise-base    as decimal   no-undo .
      889     define output parameter p-excise-rubl    as decimal   no-undo .
      890     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      891     do
      892     on error undo, return error return-value
      893     :
      894       define buffer buf_temp-parts for temp-parts .
      895       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      896       define buffer   in-vatp-parts    for ub.parts   .
      897       define buffer   in-vatp-doc      for ub.trn-doc .
      898       define buffer   in-vatp-goods    for ub.goods   .
      899       define buffer   in-vatp-sysconf  for ub.sysconf .
      900       define buffer   in-vatp_doc-attr for ub.doc-attr.
      901       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      902       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      903       define variable varinvprb                  as   character              no-undo.
      904       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      905       define variable cli-base-rate              as   decimal                no-undo.
      906       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      907       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      908       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      909       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      910       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      911       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      912       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      913       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      914       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      915       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      916       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      917       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      918       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      919       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      920       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      921       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      922       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      923       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      924       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      925       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      926       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      927       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      928       define variable varinvatp-envd             as   character              no-undo.
      929       define variable varinvatp-type             as   character              no-undo.
      930       for each buf_temp-parts
      931       on error undo, return error
      932       :
      933   assign
      934     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      935     price-base-with-tax-loc = buf_temp-parts.price-base
      936   .
      937   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      938   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      939     (output varinvprb
      940     )  .
      941     if buf_temp-parts.out-code = 'free-zone':U     or
      942        buf_temp-parts.out-code = 'out-zone':U   or
      943        buf_temp-parts.doc-type = 'акт':U then do:
      944       assign
      945         in-vatp-have-vat-slt = yes.
      946     end.
      947     else do:
      948       find first in-vatp_doc-attr no-lock
      949         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      950           and in-vatp_doc-attr.attr-code = 'envd':U
      951         no-error .
      952       if not available in-vatp_doc-attr then do:
      953         assign
      954           in-vatp-have-vat-slt = yes.
      955       end.
      956       else do:
      957            in-vatp-have-vat-slt = no.
      958       end.
      959     end.
      960     assign
      961      price-cli-with-tax-loc = buf_temp-parts.price-cli
      962      cli-base-rate          = buf_temp-parts.cli-base-rate.
      963     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      964              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      965     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      966             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      967             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      968             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      969             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      970             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      971             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      972       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      973     assign
      974       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      975     assign
      976       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      977       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      978       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      979       transport-cli-loc  = 0
      980       other-cli-loc      = 0
      981     .
      982   ASSIGN
      983             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      984       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      985   .
      986         assign
      987           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      988           p-vat-pc         = p-vat-pc         + vat-pc-loc
      989           p-slt-pc         = p-slt-pc         + slt-pc-loc
      990           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      991           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      992           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      993           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      994           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      995           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      996           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      997           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      998           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      999           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1000           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1001           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1002           p-excise-base    = p-excise-base    + 0
     1003           p-excise-rubl    = p-excise-rubl    + 0
     1004         .
     1005       end.
     1006       if p-fact-qnty      = ?
     1007       or p-sum-base       = ?
     1008       or p-sum-rubl       = ?
     1009       or p-vat-base       = ?
     1010       or p-vat-rubl       = ?
     1011       or p-slt-base       = ?
     1012       or p-slt-rubl       = ?
     1013       or p-road-tax-base  = ?
     1014       or p-road-tax-rubl  = ?
     1015       or p-transport-base = ?
     1016       or p-transport-rubl = ?
     1017       or p-other-base     = ?
     1018       or p-other-rubl     = ?
     1019       or p-excise-base    = ?
     1020       or p-excise-rubl    = ?
     1021       then do:
     1022         message
     1023           vss-workfile vss-revision vss-description skip
     1024           vss-include-info1 skip
     1025           "Программа in-vatp.i вернула неопределенные значения" skip
     1026           "p-fact-qnty"      p-fact-qnty      skip
     1027           "p-sum-base"       p-sum-base       skip
     1028           "p-sum-rubl"       p-sum-rubl       skip
     1029           "p-vat-base"       p-vat-base       skip
     1030           "p-vat-rubl"       p-vat-rubl       skip
     1031           "p-slt-base"       p-slt-base       skip
     1032           "p-slt-rubl"       p-slt-rubl       skip
     1033           "p-road-tax-base"  p-road-tax-base  skip
     1034           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1035           "p-transport-base" p-transport-base skip
     1036           "p-transport-rubl" p-transport-rubl skip
     1037           "p-other-base"     p-other-base     skip
     1038           "p-other-rubl"     p-other-rubl     skip
     1039           "p-excise-base"    p-excise-base    skip
     1040           "p-excise-rubl"    p-excise-rubl    skip
     1041           view-as alert-box error .
     1042         undo, return error .
     1043       end.
     1044     end.
     1045   end procedure.
     1046   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   function octal-to-char return character
     1048   ( p-string as character ) :
     1049     def var v-asc     as integer no-undo .
     1050     def var v-new-asc as integer no-undo .
     1051     def var ind       as integer no-undo .
     1052     if length(p-string) <> 3 then do:
     1053       return ? .
     1054     end.
     1055     assign
     1056       v-asc = 0
     1057     .
     1058     do ind = 1 to length(p-string)
     1059     :
     1060       assign
     1061         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1062       .
     1063       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1064         return ? .
     1065       end.
     1066       assign
     1067         v-asc = v-asc * 8 + v-new-asc
     1068       .
     1069     end.
     1070     return chr(v-asc) .
     1071   end function .
     1072   function char-to-octal return character
     1073   ( p-chr as character ) :
     1074     def var v-asc    as integer   no-undo .
     1075     def var ind      as integer   no-undo .
     1076     def var v-string as character no-undo .
     1077     if length(p-chr) <> 1 then do:
     1078       return ? .
     1079     end.
     1080     assign
     1081       v-asc    = asc(p-chr)
     1082       v-string = ""
     1083     .
     1084     do ind = 1 to 3
     1085     :
     1086       assign
     1087         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     1088       .
     1089       assign
     1090         v-asc = truncate(v-asc / 8, 0)
     1091       .
     1092     end.
     1093     return v-string .
     1094   end.
     1095   function str-encode return character
     1096   (   p-init-string       as character
     1097     , p-encode-char       as character
     1098     , p-special-char-list as character
     1099   ) :
     1100     def var p-encode-string as character no-undo .
     1101     def var ind                as integer no-undo .
     1102     def var v-num-special-char as integer no-undo .
     1103     def var v-special-char     as character no-undo .
     1104     if p-encode-char = ?
     1105     or p-encode-char = "" then do:
     1106       assign
     1107         p-encode-char = "~~"
     1108       .
     1109     end.
     1110     if p-init-string = ? then do:
     1111       return "?" .
     1112     end.
     1113     if p-init-string = "?" then do:
     1114       return p-encode-char + char-to-octal("?") .
     1115     end.
     1116     assign
     1117       v-num-special-char = length(p-special-char-list)
     1118       p-encode-string    = replace(p-init-string
     1119                                   ,p-encode-char
     1120                                   ,p-encode-char + char-to-octal(p-encode-char)
     1121                                   )
     1122     .
     1123     do ind = 1 to v-num-special-char
     1124     :
     1125       assign
     1126         v-special-char = substring(p-special-char-list, ind, 1)
     1127       .
     1128       if v-special-char <> p-encode-char then do:
     1129         assign
     1130           p-encode-string = replace (p-encode-string
     1131                                     ,v-special-char
     1132                                     ,p-encode-char + char-to-octal(v-special-char)
     1133                                     )
     1134         .
     1135       end.
     1136     end.
     1137     return p-encode-string .
     1138   end.
     1139   function str-decode returns character
     1140     (p-init-string   as character
     1141     ,p-encode-char   as character
     1142     ) :
     1143     def var p-decode-string as character no-undo .
     1144     def var ind                       as integer no-undo .
     1145     def var v-num-entries-init-string as integer no-undo .
     1146     def var v-sub-phrase              as character no-undo .
     1147     def var v-special-char            as character no-undo .
     1148     if p-encode-char = ?
     1149     or p-encode-char = "" then do:
     1150       assign
     1151         p-encode-char = "~~"
     1152       .
     1153     end.
     1154     if p-init-string = "?" then do:
     1155       return ? .
     1156     end.
     1157     assign
     1158       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     1159     .
     1160     if v-num-entries-init-string > 1 then do:
     1161       assign
     1162         p-decode-string = entry(1, p-init-string, p-encode-char)
     1163       .
     1164       do ind = 2 to v-num-entries-init-string
     1165       :
     1166         assign
     1167           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1168         .
     1169         assign
     1170           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1171         .
     1172         if v-special-char <> ? then do:
     1173           assign
     1174             p-decode-string = p-decode-string
     1175                             + v-special-char
     1176                             + substring(v-sub-phrase, 4)
     1177           .
     1178         end.
     1179         else do:
     1180           assign
     1181             p-decode-string = p-decode-string
     1182                             + p-encode-char
     1183                             + v-sub-phrase
     1184           .
     1185         end.
     1186       end.
     1187     end.
     1188     else do:
     1189       assign
     1190         p-decode-string = p-init-string
     1191       .
     1192     end.
     1193     return p-decode-string .
     1194   end.
     1195   define variable vss-include-info9 as character format "X(65)" no-undo
     1196   initial "@(#)$Workfile$ $Revision$".
     1197   procedure fbrrsrv-rsrv-goods :
     1198   define input parameter p-parent-proc            as handle                   no-undo.
     1199   define input parameter p-goods-recid            as recid                    no-undo.
     1200   define input parameter p-doc-line-recid         as recid                    no-undo.
     1201   define input parameter p-required-qnty          like doc-line.doc-qnty      no-undo.
     1202   define input parameter p-set-price              as logical                  no-undo.
     1203   define input parameter p-price                  as decimal                  no-undo.
     1204   define input parameter p-rsrv-by-parts          as logical                  no-undo.
     1205   define input parameter p-income-trn-doc-code    as character                no-undo.
     1206   define output parameter p-rsrv-qnty             like doc-line.doc-qnty      no-undo.
     1207       define variable v-parts-rsrv-qnty       as decimal      no-undo.
     1208       define variable v-sum-parts-rsrv-qnty   as decimal      no-undo.
     1209       define variable v-r-b-is-base           as logical      no-undo.
     1210       define variable v-cost-base             as decimal      no-undo.
     1211       define variable v-cost-rubl             as decimal      no-undo.
     1212       define variable v-parts-parameter       as character    no-undo.
     1213       define variable v-parts-found           as logical      no-undo.
     1214       define variable v-price-base            as decimal      no-undo.
     1215       define variable v-price-rubl            as decimal      no-undo.
     1216       define variable v-yesno                 as logical      no-undo.
     1217       define buffer buf_goods         for goods.
     1218       define buffer buf_gds-prt       for gds-prt.
     1219       define buffer buf_gds-dtl       for gds-dtl.
     1220       define buffer buf_trn-doc       for trn-doc.
     1221       define buffer buf_doc-line      for doc-line.
     1222       define buffer buf_parts         for parts.
     1223   do
     1224   for buf_goods
     1225     , buf_gds-prt
     1226     , buf_gds-dtl
     1227     , buf_trn-doc
     1228     , buf_doc-line
     1229     , buf_parts
     1230   on error undo, return error
     1231   :
     1232   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1234     (output v-r-b-is-base
     1235     )  .
     1236       find first buf_goods no-lock
     1237            where recid( buf_goods ) = p-goods-recid
     1238       .
     1239       find first buf_gds-prt no-lock
     1240            where buf_gds-prt.upper-code = buf_goods.prt-root
     1241       .
     1242       find first buf_doc-line no-lock
     1243            where recid( buf_doc-line ) = p-doc-line-recid
     1244       .
     1245       find first buf_trn-doc exclusive-lock
     1246            where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1247       .
     1248       assign
     1249           buf_trn-doc.print-rubl = ( if v-r-b-is-base = yes then no else yes )
     1250       .
     1251   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1252     ( input buf_trn-doc.obj-code
     1253      ,input buf_trn-doc.obj-type
     1254      ,input buf_trn-doc.doc-code
     1255      ,input buf_goods.artic
     1256      ,input buf_goods.prod-code
     1257      ,input buf_goods.prod-type
     1258      ,input buf_gds-prt.node-code
     1259      ,input yes
     1260     ) no-error .
     1261       if error-status:error
     1262       then do:
     1263           message
     1264               "Ошибка при создании признака."
     1265               skip return-value
     1266           view-as alert-box error.
     1267       end.
     1268       find first buf_gds-dtl exclusive-lock
     1269            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     1270              and buf_gds-dtl.artic     = buf_goods.artic
     1271              and buf_gds-dtl.prod-type = buf_goods.prod-type
     1272              and buf_gds-dtl.prod-code = buf_goods.prod-code
     1273              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     1274       .
     1275       if p-set-price = yes
     1276       then do:
     1277           if v-r-b-is-base = yes
     1278           then do:
     1279               assign
     1280                   buf_gds-dtl.price-base = p-price
     1281                   buf_gds-dtl.price-rubl = p-price * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     1282               .
     1283           end.
     1284           else do:
     1285               assign
     1286                   buf_gds-dtl.price-rubl = p-price
     1287                   buf_gds-dtl.price-base = p-price / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     1288               .
     1289           end.
     1290       end.
     1291       else do:
     1292   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1294     ( input recid(buf_gds-dtl)
     1295     , input no
     1296     , input ?
     1297     ) no-error.
     1298           if error-status:error
     1299           then do:
     1300               message
     1301                   "Ошибка при назначении цены признака."
     1302                   skip return-value
     1303               view-as alert-box error.
     1304           end.
     1305           if v-r-b-is-base = yes
     1306           then do:
     1307               assign
     1308                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-base * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     1309                   buf_gds-dtl.price-base = buf_gds-dtl.price-base
     1310               .
     1311           end.
     1312           else do:
     1313               assign
     1314                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-rubl
     1315                   buf_gds-dtl.price-base = buf_gds-dtl.price-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     1316               .
     1317           end.
     1318       end.
     1319       assign
     1320           buf_trn-doc.status_ = 'накл':U
     1321           buf_trn-doc.flag_   = no
     1322       .
     1323       assign
     1324           buf_gds-dtl.ov  = yes
     1325           v-cost-base     = buf_doc-line.price-base
     1326           v-cost-rubl     = buf_doc-line.price-rubl
     1327           p-rsrv-qnty     = round( p-required-qnty, 3 )
     1328       .
     1329       if p-rsrv-by-parts = yes
     1330       then do:
     1331           assign
     1332               v-parts-found           = no
     1333               v-sum-parts-rsrv-qnty   = 0
     1334           .
     1335           if p-income-trn-doc-code <> ""
     1336           then do:
     1337               for each buf_parts no-lock
     1338                  where buf_parts.obj-type  = buf_doc-line.obj-type
     1339                    and buf_parts.obj-code  = buf_doc-line.obj-code
     1340                    and buf_parts.prod-type = buf_doc-line.prod-type
     1341                    and buf_parts.prod-code = buf_doc-line.prod-code
     1342                    and buf_parts.artic     = buf_doc-line.artic
     1343                    and buf_parts.in-code   = p-income-trn-doc-code
     1344                    and buf_parts.out-code  = p-income-trn-doc-code
     1345               on error undo, return error return-value
     1346               :
     1347                   assign
     1348                       v-parts-found     = yes
     1349                       v-parts-parameter = 'reserv':U
     1350                                   + ",":U + 'no-message':U
     1351                                   + ",":U + 'rsrv-single-part':U
     1352                                   + ",":U + 'rsrv-in-code':U   + "=":U + str-encode ( buf_parts.in-code  ,  "", ",=":U )
     1353                                   + ",":U + 'rsrv-part-code':U + "=":U + str-encode ( buf_parts.part-code,  "", ",=":U )
     1354                   .
     1355                   assign
     1356                       v-parts-rsrv-qnty = ( if p-rsrv-qnty < buf_parts.fact-qnty then p-rsrv-qnty else buf_parts.fact-qnty )
     1357                   .
     1358                   run trg/rsrv-dtl.p (
     1359                         input p-parent-proc
     1360                       , input v-parts-parameter
     1361                       , buffer buf_gds-dtl
     1362                       , input-output v-parts-rsrv-qnty
     1363                       , input-output v-cost-base
     1364                       , input-output v-cost-rubl
     1365                       , input -1
     1366                       , input ""
     1367                   ) no-error.
     1368                   if error-status:error
     1369                   then do:
     1370                       undo, return error return-value.
     1371                   end.
     1372                   if v-cost-base <= 0
     1373                   or v-cost-rubl <= 0
     1374                   then do:
     1375                       undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     1376                                                     ,chr(10)
     1377                                                     ,"РУБЛИ:   "
     1378                                                     ,v-cost-rubl
     1379                                                     ,v-cost-base
     1380                                                     ,buf_doc-line.artic).
     1381                       .
     1382                   end.
     1383                   assign
     1384                       v-sum-parts-rsrv-qnty = v-sum-parts-rsrv-qnty + v-parts-rsrv-qnty
     1385                       p-rsrv-qnty           = p-rsrv-qnty           - v-parts-rsrv-qnty
     1386                   .
     1387               end.
     1388           end.
     1389           if p-rsrv-qnty > 0
     1390           then do:
     1391               run trg/rsrv-dtl.p (
     1392                     input p-parent-proc
     1393                   , input 'reserv':U
     1394                           + ",":U + 'no-message':U
     1395                           + ",":U + 'negative-check':U + '=':U + '1':U
     1396                   , buffer buf_gds-dtl
     1397                   , input-output p-rsrv-qnty
     1398                   , input-output v-cost-base
     1399                   , input-output v-cost-rubl
     1400                   , input -1
     1401                   , input ""
     1402               ) no-error.
     1403               if error-status:error
     1404               then do:
     1405                   undo, return error return-value.
     1406               end.
     1407               if v-cost-base <= 0
     1408               or v-cost-rubl <= 0
     1409               then do:
     1410                   undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     1411                                                 ,chr(10)
     1412                                                 ,"РУБЛИ:   "
     1413                                                 ,v-cost-rubl
     1414                                                 ,v-cost-base
     1415                                                 ,buf_doc-line.artic).
     1416               end.
     1417           end.
     1418           assign
     1419               p-rsrv-qnty = p-rsrv-qnty + v-sum-parts-rsrv-qnty
     1420           .
     1421       end.
     1422       else do:
     1423           run trg/rsrv-dtl.p (
     1424                 input p-parent-proc
     1425               , input 'reserv':U
     1426                       + ",":U + 'no-message':U
     1427                       + ",":U + 'negative-check':U + '=':U + '1':U
     1428               , buffer buf_gds-dtl
     1429               , input-output p-rsrv-qnty
     1430               , input-output v-cost-base
     1431               , input-output v-cost-rubl
     1432               , input -1
     1433               , input ""
     1434           ) no-error.
     1435           if error-status:error
     1436           then do:
     1437               undo, return error return-value.
     1438           end.
     1439           if v-cost-base <= 0
     1440           or v-cost-rubl <= 0
     1441           then do:
     1442             undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     1443                                           ,chr(10)
     1444                                           ,"РУБЛИ:   "
     1445                                           ,v-cost-rubl
     1446                                           ,v-cost-base
     1447                                           ,buf_doc-line.artic).
     1448           end.
     1449       end.
     1450   end.
     1451   end procedure.
     1452   define variable vss-include-info12 as character format "X(65)" no-undo
     1453   initial "@(#)$Workfile$ $Revision$".
     1454   define temp-table temp_fbrrep-goods no-undo
