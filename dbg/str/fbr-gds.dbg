     1495   define variable vss-include-info13 as character format "X(65)" no-undo
     1496   initial "@(#)$Workfile$ $Revision$".
     1497   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   procedure r-cost :
     1499     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1500     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1501     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1502     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1503     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1504     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1505     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1506     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1507     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1508     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1509     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1510     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1511     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1512     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1513     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1514     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1515     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1516     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1517     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1518     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1519     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1520     do
     1521     on error undo, return error
     1522     :
     1523       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1524       define buffer   in-vatp-parts    for ub.parts   .
     1525       define buffer   in-vatp-doc      for ub.trn-doc .
     1526       define buffer   in-vatp-goods    for ub.goods   .
     1527       define buffer   in-vatp-sysconf  for ub.sysconf .
     1528       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1529       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1530       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1531       define variable varinvprb                  as   character              no-undo.
     1532       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1533       define variable cli-base-rate              as   decimal                no-undo.
     1534       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1535       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1536       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1537       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1538       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1539       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1540       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1541       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1542       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1543       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1544       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1545       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1546       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1547       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1548       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1549       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1550       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1551       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1552       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1553       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1554       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1555       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1556       define variable varinvatp-envd             as   character              no-undo.
     1557       define variable varinvatp-type             as   character              no-undo.
     1558       def var v-parts-fact-qnty as decimal   no-undo .
     1559       define buffer buf_parts    for ub.parts    .
     1560       define buffer buf_goods    for ub.goods    .
     1561       define buffer buf_trn-doc  for ub.trn-doc  .
     1562       define buffer buf_doc-line for ub.doc-line .
     1563       find first buf_doc-line no-lock
     1564         where buf_doc-line.doc-code  = v-doc-code
     1565           and buf_doc-line.artic     = v-artic
     1566           and buf_doc-line.prod-type = v-prod-type
     1567           and buf_doc-line.prod-code = v-prod-code
     1568         no-error .
     1569       if not available buf_doc-line then do:
     1570         message
     1571           vss-workfile vss-revision vss-description skip
     1572           vss-include-info14 skip
     1573           "Ошибка задания входных параметров" skip
     1574           "Не найдена строка документа"  skip
     1575           "Документ" v-doc-code skip
     1576           "Артикул" v-artic v-prod-type v-prod-code skip
     1577           view-as alert-box error .
     1578         return error .
     1579       end.
     1580       find first buf_trn-doc no-lock
     1581         where buf_trn-doc.doc-code = v-doc-code
     1582         no-error .
     1583       if not available buf_trn-doc then do:
     1584         message
     1585           vss-workfile vss-revision vss-description skip
     1586           vss-include-info14 skip
     1587           "Ошибка задания входных параметров" skip
     1588           "Не найден документ" skip
     1589           "Документ" v-doc-code skip
     1590           "Артикул" v-artic v-prod-type v-prod-code skip
     1591           view-as alert-box error .
     1592         undo, return error .
     1593       end.
     1594       find first buf_goods no-lock
     1595         where buf_goods.artic     = buf_doc-line.artic
     1596           and buf_goods.prod-type = buf_doc-line.prod-type
     1597           and buf_goods.prod-code = buf_doc-line.prod-code
     1598         no-error .
     1599       if not available buf_goods then do:
     1600         message
     1601           vss-workfile vss-revision vss-description skip
     1602           vss-include-info14 skip
     1603           "Ошибка задания входных параметров" skip
     1604           "Не найден товар" skip
     1605           "Документ" v-doc-code skip
     1606           "Артикул" v-artic v-prod-type v-prod-code skip
     1607           view-as alert-box error .
     1608         undo, return error .
     1609       end.
     1610       if buf_goods.gds-type = 'т':U then do:
     1611             for each buf_parts no-lock
     1612               where buf_parts.out-code  = buf_trn-doc.doc-code
     1613                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1614                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1615                 and buf_parts.artic     = buf_doc-line.artic
     1616                 and buf_parts.prod-type = buf_doc-line.prod-type
     1617                 and buf_parts.prod-code = buf_doc-line.prod-code
     1618             on error undo, return error
     1619             :
     1620   assign
     1621     price-rubl-with-tax-loc = buf_parts.price-rubl
     1622     price-base-with-tax-loc = buf_parts.price-base
     1623   .
     1624   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1626     (output varinvprb
     1627     )  .
     1628     if buf_parts.out-code = 'free-zone':U     or
     1629        buf_parts.out-code = 'out-zone':U   or
     1630        buf_parts.doc-type = 'акт':U then do:
     1631       assign
     1632         in-vatp-have-vat-slt = yes.
     1633     end.
     1634     else do:
     1635       find first in-vatp_doc-attr no-lock
     1636         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1637           and in-vatp_doc-attr.attr-code = 'envd':U
     1638         no-error .
     1639       if not available in-vatp_doc-attr then do:
     1640         assign
     1641           in-vatp-have-vat-slt = yes.
     1642       end.
     1643       else do:
     1644            in-vatp-have-vat-slt = no.
     1645       end.
     1646     end.
     1647     assign
     1648      price-cli-with-tax-loc = buf_parts.price-cli
     1649      cli-base-rate          = buf_parts.cli-base-rate.
     1650     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1651              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1652     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1653             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1654             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1655             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1656             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1657             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1658             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1659       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1660     assign
     1661       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1662     assign
     1663       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1664       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1665       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1666       transport-cli-loc  = 0
     1667       other-cli-loc      = 0
     1668     .
     1669   ASSIGN
     1670             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1671       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1672   .
     1673               assign
     1674                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1675                                       or buf_trn-doc.doc-type = 'возврат':U
     1676                                       or buf_trn-doc.doc-type = 'инв':U
     1677                                       then buf_parts.fact-qnty
     1678                                       else - buf_parts.fact-qnty
     1679                                      )
     1680               .
     1681               assign
     1682                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1683                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1684                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1685                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1686                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1687                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1688                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1689                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1690                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1691                 v-excise-base         =   0
     1692                 v-excise-rubl         =   0
     1693                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1694                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1695                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1696                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1697               .
     1698           end.
     1699   assign
     1700     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1701     price-base-with-tax-loc = buf_doc-line.price-base
     1702   .
     1703   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1705     (output varinvprb
     1706     )  .
     1707      find first in-vatp_doc-attr no-lock
     1708       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1709         and in-vatp_doc-attr.attr-code = 'envd':U
     1710       no-error .
     1711       if available in-vatp_doc-attr
     1712          then do:
     1713          assign
     1714            in-vatp-have-vat-slt = no.
     1715      end.
     1716      else do:
     1717        assign
     1718          in-vatp-have-vat-slt = yes.
     1719      end.
     1720      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1721                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1722                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1723      if (not buf_trn-doc.internal and
     1724              buf_trn-doc.doc-type = 'при':U) or
     1725         in-vatp-goods.gds-type = 'у':U then do:
     1726         if varinvprb = "base":u then do:
     1727           assign
     1728             road-tax-base-loc = buf_doc-line.road-tax
     1729             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1730         end.
     1731         else do:
     1732           ASSIGN
     1733             road-tax-rubl-loc = buf_doc-line.road-tax
     1734             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
