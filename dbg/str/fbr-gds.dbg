     1895                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1896                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1897                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1898                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1899                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1900                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1901                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1902                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1903                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1904                         .
     1905         end.
     1906         ASSIGN
     1907           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1908           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1909           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1910           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1911           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1912           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1913                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1914           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1915                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1916           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1917           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1918           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1919         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1920         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1921         if transport-base-loc = ? then transport-base-loc = 0.
     1922         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1923         if other-base-loc     = ? then other-base-loc     = 0.
     1924         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1925         assign
     1926           transport-cli-loc      = 0
     1927           other-cli-loc          = 0
     1928           road-tax-cli-loc       = ?
     1929           vat-cli-loc            = ?
     1930           slt-cli-loc            = ?
     1931           price-cli-with-tax-loc = ?.
     1932      end.
     1933   ASSIGN
     1934             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1935       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1936   .
     1937             assign
     1938               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1939               v-vat-pc              = vat-pc-loc
     1940               v-slt-pc              = slt-pc-loc
     1941               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1942               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1943               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1944               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1945               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1946               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1947               v-road-tax-base       =  0
     1948               v-road-tax-rubl       =  0
     1949               v-excise-base         =  0
     1950               v-excise-rubl         =  0
     1951               v-transport-base      =  0
     1952               v-transport-rubl      =  0
     1953               v-other-base          =  0
     1954               v-other-rubl          =  0
     1955             .
     1956       end.
     1957     end.
     1958   end procedure.
     1959   procedure fbrrep-fill-qnty-and-prices :
     1960   do
     1961   on error undo, return error
     1962   :
     1963   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1964       define variable v-gds-code  as integer       no-undo.
     1965       define variable v-gds-name  as character     no-undo.
     1966       define variable v-sign      as decimal       no-undo.
     1967       define buffer buf_fbr-line          for ub.fbr-line.
     1968       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1969       for each buf_fbr-line no-lock
     1970          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1971       on error undo, return error
     1972       :
     1973           find first buf_temp_fbrrep-goods
     1974                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1975                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1976                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1977           use-index ar
     1978           no-error.
     1979           if not available buf_temp_fbrrep-goods
     1980           then do:
     1981               create buf_temp_fbrrep-goods.
     1982   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1984     (input  buf_fbr-line.artic
     1985     ,input  buf_fbr-line.prod-type
     1986     ,input  buf_fbr-line.prod-code
     1987     ,output v-gds-code
     1988     )  .
     1989   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1990   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1991     (input  buf_fbr-line.artic
     1992     ,input  buf_fbr-line.prod-type
     1993     ,input  buf_fbr-line.prod-code
     1994     ,output v-gds-name
     1995     )  .
     1996   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1998     (input  buf_fbr-line.artic
     1999     ,input  buf_fbr-line.prod-type
     2000     ,input  buf_fbr-line.prod-code
     2001     ,input  'gds-goods=request':u
     2002     ,output buf_temp_fbrrep-goods.is-not-office
     2003     )  .
     2004               assign
     2005                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     2006                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     2007                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     2008                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     2009                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     2010                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2011                   buf_temp_fbrrep-goods.fact-qnty            = 0
     2012                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2013                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     2014                   buf_temp_fbrrep-goods.income-qnty          = 0
     2015                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2016                   buf_temp_fbrrep-goods.cost-rubl            = 0
     2017                   buf_temp_fbrrep-goods.cost-base            = 0
     2018                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2019                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     2020                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2021                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     2022                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2023                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2024                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2025                   buf_temp_fbrrep-goods.deleted              = no
     2026               .
     2027   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2029     (input  v-gds-code
     2030     ,output buf_temp_fbrrep-goods.unit-base
     2031     )  .
     2032           end.
     2033           case buf_fbr-line.trn-type
     2034           :
     2035               when 'при':U
     2036               then do:
     2037                   assign
     2038                       v-sign                                  = 1
     2039                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     2040                   .
     2041                   if buf_fbr-line.rsrv-qnty <> ?
     2042                   then do:
     2043                       assign
     2044                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2045                       .
     2046                   end.
     2047               end.
     2048               when 'спи':U
     2049               then do:
     2050                   assign
     2051                       v-sign                                  = -1
     2052                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     2053                   .
     2054                   if buf_fbr-line.rsrv-qnty <> ?
     2055                   then do:
     2056                       assign
     2057                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2058                       .
     2059                   end.
     2060               end.
     2061           end case.
     2062           assign
     2063               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     2064               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     2065               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     2066               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     2067           .
     2068       end.
     2069       run test-temp-tables in this-procedure .
     2070   end.
     2071   end procedure.
     2072   procedure fbrrep-fill-for-fbr-actp :
     2073   do
     2074   on error undo, return error
     2075   :
     2076   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2077       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2078       define buffer buf_fbr-line          for ub.fbr-line.
     2079       run fbrrep-fill-qnty-and-prices in this-procedure (
     2080           input p-fbr-doc-doc-code
     2081       ).
     2082       for each buf_temp_fbrrep-goods
     2083       :
     2084           assign
     2085               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2086               buf_temp_fbrrep-goods.sum-cost-base     = 0
     2087               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2088               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2089               buf_temp_fbrrep-goods.cost-rubl     = 0
     2090               buf_temp_fbrrep-goods.cost-base     = 0
     2091               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2092               buf_temp_fbrrep-goods.vat-cost-base = 0
     2093           .
     2094           if buf_temp_fbrrep-goods.income-qnty = 0
     2095           or buf_temp_fbrrep-goods.write-off-qnty = 0
     2096           then do:
     2097               assign
     2098                   buf_temp_fbrrep-goods.deleted   = yes
     2099                   buf_temp_fbrrep-goods.fact-qnty = 0
     2100               .
     2101           end.
     2102           else do:
     2103               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     2104               then do:
     2105                   assign
     2106                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2107                   .
     2108                   for each buf_fbr-line no-lock
     2109                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2110                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2111                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2112                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2113                        and buf_fbr-line.trn-type  = 'при':U
     2114                   :
     2115                       assign
     2116                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2117                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2118                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2119                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2120                       .
     2121                   end.
     2122                   assign
     2123                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2124                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2125                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2126                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2127                   .
     2128               end.
     2129               else do:
     2130                   assign
     2131                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2132                   .
     2133                   for each buf_fbr-line no-lock
     2134                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2135                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2136                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2137                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2138                        and buf_fbr-line.trn-type  = 'спи':U
     2139                   :
     2140                       assign
     2141                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2142                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2143                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2144                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2145                       .
     2146                   end.
     2147                   assign
     2148                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2149                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2150                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2151                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2152                   .
     2153               end.
     2154           end.
     2155       end.
     2156       for each buf_temp_fbrrep-goods
     2157          where buf_temp_fbrrep-goods.deleted = yes
     2158       on error undo, return error
     2159       :
     2160           delete buf_temp_fbrrep-goods.
     2161       end.
     2162       run test-temp-tables in this-procedure .
     2163   end.
     2164   end procedure.
     2165   procedure fbrrep-fill-for-op-del :
     2166   do
     2167   on error undo, return error
     2168   :
     2169   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2170   define input parameter p-db-remote          as logical          no-undo.
     2171       define variable v-serv-code as character    no-undo.
     2172       define variable v-in-code   as character    no-undo.
     2173       define variable v-out-code  as character    no-undo.
     2174       define variable v-trn-qnty  as decimal       no-undo.
     2175       define variable v-sign      as decimal       no-undo.
     2176       define variable v-qnty      as decimal       no-undo.
     2177       define buffer buf_fbr-doc           for ub.fbr-doc.
     2178       define buffer buf_fbr-line          for ub.fbr-line.
     2179       define buffer buf_goods             for ub.goods .
     2180       define buffer buf_doc-line          for ub.doc-line .
     2181       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     2182       run fbrrep-fill-qnty-and-prices in this-procedure (
     2183           input p-fbr-doc-doc-code
     2184       ).
     2185       for each buf_temp_fbrrep-goods
     2186       on error undo, return error
     2187       :
     2188           if buf_temp_fbrrep-goods.income-qnty <> 0
     2189           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     2190           then do:
     2191               assign
     2192                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     2193               .
     2194               if v-qnty = 0
     2195               then do:
     2196                   find first buf_fbr-line no-lock
     2197                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2198                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     2199                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     2200                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     2201                          and buf_fbr-line.fact-qnty   <> 0
     2202                   no-error.
     2203                   if available buf_fbr-line
     2204                   then do:
     2205                       assign
     2206                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     2207                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     2208                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     2209                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     2210                       .
     2211                   end.
     2212                   else do:
     2213                       assign
     2214                           buf_temp_fbrrep-goods.cost-rubl     = 0
     2215                           buf_temp_fbrrep-goods.cost-base     = 0
     2216                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2217                           buf_temp_fbrrep-goods.vat-cost-base = 0
     2218                       .
     2219                   end.
     2220               end.
     2221               else do:
     2222                   assign
     2223                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     2224                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     2225                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     2226                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     2227                   .
     2228               end.
     2229           end.
     2230           else do:
     2231               assign
     2232                   buf_temp_fbrrep-goods.cost-rubl     = 0
     2233                   buf_temp_fbrrep-goods.cost-base     = 0
     2234                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2235                   buf_temp_fbrrep-goods.vat-cost-base = 0
     2236               .
     2237           end.
     2238       end.
     2239       for each buf_temp_fbrrep-goods
     2240       :
     2241           if buf_temp_fbrrep-goods.is-waste = yes
     2242           then do:
     2243               assign
     2244                   buf_temp_fbrrep-goods.deleted = yes
     2245               .
     2246           end.
     2247           else do:
     2248               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     2249               and buf_temp_fbrrep-goods.income-qnty <> 0
     2250               then do:
     2251                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     2252                   then do:
     2253                       assign
     2254                           buf_temp_fbrrep-goods.deleted = yes
     2255                       .
     2256                   end.
     2257                   else do:
     2258                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     2259                       then do:
     2260                           assign
     2261                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     2262                               buf_temp_fbrrep-goods.income-qnty       = 0
     2263                           .
     2264                       end.
     2265                       else do:
     2266                           assign
     2267                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     2268                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     2269                           .
     2270                       end.
     2271                   end.
     2272               end.
     2273           end.
     2274       end.
     2275       for each buf_temp_fbrrep-goods
     2276          where buf_temp_fbrrep-goods.deleted = yes
     2277       on error undo, return error
     2278       :
     2279           delete buf_temp_fbrrep-goods.
     2280       end.
     2281       run test-temp-tables in this-procedure .
     2282       find first buf_fbr-doc no-lock
     2283            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     2284       .
     2285       assign
     2286           v-out-code = p-fbr-doc-doc-code
     2287       .
     2288       run doc-code in this-procedure (
     2289             input  "pair"
     2290           , input  buf_fbr-doc.obj-type
     2291           , input  buf_fbr-doc.obj-code
     2292           , input  v-out-code
     2293           , output v-in-code
     2294       ) no-error.
     2295       if error-status:error
     2296       then do:
     2297           message
     2298                    vss-workfile vss-revision vss-description
     2299               skip "Ошибка вычисления номера приходной накладной."
     2300               skip return-value
     2301               skip trim(error-status :get-message(1))
     2302                    trim(error-status :get-message(2))
     2303                    trim(error-status :get-message(3))
     2304           view-as alert-box error.
     2305           undo, return error .
     2306       end.
     2307       run doc-code in this-procedure (
     2308             input  "trio"
     2309           , input  buf_fbr-doc.obj-type
     2310           , input  buf_fbr-doc.obj-code
     2311           , input  v-in-code
     2312           , output v-serv-code
     2313       ) no-error.
     2314       if error-status:error
     2315       then do:
     2316           message
     2317                    vss-workfile vss-revision vss-description
     2318               skip "Ошибка вычисления номера накладной расхода."
     2319               skip return-value
     2320               skip trim(error-status :get-message(1))
     2321                    trim(error-status :get-message(2))
     2322                    trim(error-status :get-message(3))
     2323           view-as alert-box error.
     2324           undo, return error .
     2325       end.
     2326       for each buf_temp_fbrrep-goods
     2327       on error undo, return error
     2328       :
     2329           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     2330           then do:
     2331               find first buf_doc-line no-lock
     2332                    where buf_doc-line.doc-code  = v-in-code
     2333                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2334                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2335                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2336               no-error.
     2337               if available buf_doc-line
     2338               then do:
     2339                   assign
     2340                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     2341                   .
     2342               end.
     2343               else do:
     2344                   assign
     2345                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2346                   .
     2347               end.
     2348           end.
     2349           else do:
     2350               if buf_temp_fbrrep-goods.is-not-office = no
     2351               then do:
     2352                   find first buf_doc-line no-lock
     2353                        where buf_doc-line.doc-code  = v-serv-code
     2354                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2355                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2356                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2357                   no-error.
     2358               end.
     2359               else do:
     2360                   find first buf_doc-line no-lock
     2361                        where buf_doc-line.doc-code  = v-out-code
     2362                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2363                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2364                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2365                   no-error.
     2366               end.
     2367               if available buf_doc-line
     2368               then do:
     2369                   assign
     2370                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     2371                   .
     2372               end.
     2373               else do:
     2374                   assign
     2375                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2376                   .
     2377               end.
     2378           end.
     2379           if available buf_doc-line
     2380           then do:
     2381               define variable v-void              as decimal       no-undo.
     2382               define variable v-fact-qnty         as decimal       no-undo.
     2383               define variable v-sum-base          as decimal       no-undo.
     2384               define variable v-sum-rubl          as decimal       no-undo.
     2385               define variable v-vat-base          as decimal       no-undo.
     2386               define variable v-vat-rubl          as decimal       no-undo.
     2387               define variable v-slt-base          as decimal       no-undo.
     2388               define variable v-slt-rubl          as decimal       no-undo.
     2389               define variable v-road-tax-base     as decimal       no-undo.
     2390               define variable v-road-tax-rubl     as decimal       no-undo.
     2391               define variable v-transport-base    as decimal       no-undo.
     2392               define variable v-transport-rubl    as decimal       no-undo.
     2393               define variable v-other-base        as decimal       no-undo.
     2394               define variable v-other-rubl        as decimal       no-undo.
     2395               define variable v-excise-base       as decimal       no-undo.
     2396               define variable v-excise-rubl       as decimal       no-undo.
     2397               run r-cost in this-procedure (
     2398                     input buf_doc-line.doc-code
     2399                   , input buf_doc-line.artic
     2400                   , input buf_doc-line.prod-type
     2401                   , input buf_doc-line.prod-code
     2402                   , output v-fact-qnty
     2403                   , output v-void
     2404                   , output v-void
     2405                   , output v-sum-base
     2406                   , output v-sum-rubl
     2407                   , output v-vat-base
     2408                   , output v-vat-rubl
     2409                   , output v-slt-base
     2410                   , output v-slt-rubl
     2411                   , output v-road-tax-base
     2412                   , output v-road-tax-rubl
     2413                   , output v-transport-base
     2414                   , output v-transport-rubl
     2415                   , output v-other-base
     2416                   , output v-other-rubl
     2417                   , output v-excise-base
     2418                   , output v-excise-rubl
     2419               ).
     2420               assign
     2421                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     2422               .
     2423               assign
     2424                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     2425                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     2426                   v-sum-rubl = v-sum-rubl   * v-sign
     2427                   v-sum-base = v-sum-base   * v-sign
     2428                   v-vat-rubl = v-vat-rubl   * v-sign
     2429                   v-vat-base = v-vat-base   * v-sign
     2430                   v-fact-qnty = v-fact-qnty * v-sign
     2431               .
     2432               output to "fbrrep.txt" append .
     2433               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     2434               output close.
     2435               assign
     2436                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     2437                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     2438                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     2439                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     2440               .
     2441               if buf_temp_fbrrep-goods.fact-qnty          = 0
     2442               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2443               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     2444               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2445               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2446               then do:
     2447                   assign
     2448                       buf_temp_fbrrep-goods.deleted = yes
     2449                   .
     2450               end.
     2451           end.
     2452       end.
     2453       for each buf_temp_fbrrep-goods
     2454          where buf_temp_fbrrep-goods.deleted = yes
     2455       on error undo, return error
     2456       :
     2457           delete buf_temp_fbrrep-goods.
     2458       end.
     2459       run test-temp-tables in this-procedure .
     2460   end.
     2461   end procedure.
     2462   procedure test-temp-tables :
     2463   do
     2464   on error undo, return error
     2465   :
     2466       define variable v-str   as character     no-undo.
     2467       assign
     2468           v-str = ""
     2469       .
     2470       for each temp_fbrrep-goods
     2471       :
     2472           assign
     2473               v-str = v-str
     2474                   + chr(10) + temp_fbrrep-goods.artic
     2475                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     2476                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     2477                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     2478                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     2479                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     2480                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     2481                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     2482           .
     2483       end.
     2484       output to "fbrrep.txt" append .
     2485       put unformatted skip(2) v-str.
     2486       output close.
     2487   end.
     2488   end procedure.
     2489   procedure fbrrep-test-fbrdoc-for-fact :
     2490   do
     2491   on error undo, return error
     2492   :
     2493   define output parameter p-have-error        as logical      no-undo.
     2494       define buffer buf_fbr-line          for ub.fbr-line.
     2495       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2496       for each buf_temp_fbrrep-goods
     2497       on error undo, return error
     2498       :
     2499       end.
     2500   end.
     2501   end procedure.
     2502   procedure fbrrep-fill-qnty-and-prices-gds :
     2503   do
     2504   on error undo, return error
     2505   :
     2506   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2507   define input parameter p-gds-code           as integer      no-undo.
     2508       define variable v-sign      as decimal       no-undo.
     2509       define buffer buf_fbr-line          for ub.fbr-line.
     2510       define buffer buf_goods             for ub.goods.
     2511       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2512       find first buf_goods no-lock
     2513            where buf_goods.gds-code = p-gds-code
     2514       .
     2515       find first buf_temp_fbrrep-goods
     2516            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2517              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2518              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2519       use-index ar
     2520       no-error.
     2521       if available buf_temp_fbrrep-goods
     2522       then do:
     2523           delete buf_temp_fbrrep-goods.
     2524       end.
     2525       create buf_temp_fbrrep-goods.
     2526   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2528     (input  buf_goods.artic
     2529     ,input  buf_goods.prod-type
     2530     ,input  buf_goods.prod-code
     2531     ,input  'gds-goods=request':u
     2532     ,output buf_temp_fbrrep-goods.is-not-office
     2533     )  .
     2534       assign
     2535           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     2536           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     2537           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     2538           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     2539           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     2540           buf_temp_fbrrep-goods.is-waste             = no
     2541           buf_temp_fbrrep-goods.fact-qnty            = 0
     2542           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2543           buf_temp_fbrrep-goods.write-off-qnty       = 0
     2544           buf_temp_fbrrep-goods.income-qnty          = 0
     2545           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2546           buf_temp_fbrrep-goods.cost-rubl            = 0
     2547           buf_temp_fbrrep-goods.cost-base            = 0
     2548           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2549           buf_temp_fbrrep-goods.sum-cost-base        = 0
     2550           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2551           buf_temp_fbrrep-goods.vat-cost-base        = 0
     2552           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2553           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2554           buf_temp_fbrrep-goods.price-sale           = 0
     2555           buf_temp_fbrrep-goods.deleted              = no
     2556       .
     2557   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2559     (input  p-gds-code
     2560     ,output buf_temp_fbrrep-goods.unit-base
     2561     )  .
     2562       for each buf_fbr-line no-lock
     2563          where buf_fbr-line.prod-type = buf_goods.prod-type
     2564            and buf_fbr-line.prod-code = buf_goods.prod-code
     2565            and buf_fbr-line.artic     = buf_goods.artic
     2566            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2567       on error undo, return error
     2568       :
     2569           case buf_fbr-line.trn-type
     2570           :
     2571               when 'при':U
     2572               then do:
     2573                   assign
     2574                       v-sign                                          = 1
     2575                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2576                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2577                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2578                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2579                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2580                   .
     2581                   if buf_fbr-line.rsrv-qnty <> ?
     2582                   then do:
     2583                       assign
     2584                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2585                       .
     2586                   end.
     2587               end.
     2588               when 'спи':U
     2589               then do:
     2590                   assign
     2591                       v-sign                                  = -1
     2592                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2593                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2594                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2595                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2596                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2597                   .
     2598                   if buf_fbr-line.rsrv-qnty <> ?
     2599                   then do:
     2600                       assign
     2601                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2602                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2603                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2604                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2605                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2606                       .
     2607                   end.
     2608               end.
     2609           end case.
     2610           assign
     2611               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2612               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2613               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2614               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2615               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2616               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2617               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2618               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2619               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2620               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2621           .
     2622       end.
     2623       run test-temp-tables in this-procedure .
     2624   end.
     2625   end procedure.
     2626   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2627       def var log-file-name as char no-undo.
     2628       if search('fbr.log') = ?
     2629       then do:
     2630           assign
     2631               log-file-name = ""
     2632           .
     2633       end.
     2634       else do:
     2635           assign
     2636               log-file-name = 'fbr.log'
     2637           .
     2638       end.
     2639       DEF STREAM stm-log.
     2640       PROCEDURE writelog:
     2641       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     2642       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     2643       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     2644       if p-file-name <> ""
     2645       then do:
     2646       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     2647           PUT STREAM stm-log UNFORMATTED chr(10).
     2648           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     2649                                           OR p-log-string = "&Line") THEN "" ELSE
     2650                                           cur-time-string-sec() + " ").
     2651           PUT STREAM stm-log UNFORMATTED
     2652                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     2653                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     2654                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     2655       OUTPUT STREAM stm-log CLOSE.
     2656       end.
     2657       END PROCEDURE.
     2658   define variable v-fbr-log-file-name as character no-undo init 'fbr-rsrv-errors.txt'.
     2659   define variable v-fbr-tt-log-file-name as character no-undo init 'fbr-rsrv-errors-tt.txt'.
     2660   define temp-table tt-rsrv-err no-undo
     2661     field artic like ub.goods.artic
     2662     field gds-name like ub.goods.gds-name
     2663     field rsrv-qnty like ub.gds-obj.fact-qnty
     2664     field req-qnty like ub.gds-obj.fact-qnty
     2665   .
     2666   define stream stm.
     2667   do
     2668   on error undo, return error
     2669   :
     2670       define variable v-required-qnty     like doc-line.doc-qnty  no-undo.
     2671       define variable v-reserved-qnty     like doc-line.doc-qnty  no-undo.
     2672       define variable v-store-qnty                 as decimal      no-undo.
     2673       define variable v-fbr-line-factor           as decimal      no-undo.
     2674       define variable v-is-rsrv                   as logical      no-undo.
     2675       define variable v-price-sale        like gds-dtl.price-rubl no-undo.
     2676       define variable v-trn-doc-doc-code          as character    no-undo.
     2677       define variable v-old-price-base            as decimal      no-undo.
     2678       define variable v-old-price-rubl            as decimal      no-undo.
     2679       define variable v-old-price-sum-base        as decimal      no-undo.
     2680       define variable v-old-price-sum-rubl        as decimal      no-undo.
     2681       define variable v-old-price-sum-vat-base    as decimal      no-undo.
     2682       define variable v-old-price-sum-vat-rubl    as decimal      no-undo.
     2683       define variable v-store-sum-base            as decimal      no-undo.
     2684       define variable v-store-sum-rubl            as decimal      no-undo.
     2685       define variable v-store-sum-vat-base        as decimal      no-undo.
     2686       define variable v-store-sum-vat-rubl        as decimal      no-undo.
     2687       define variable v-cost-price-rubl           as decimal        no-undo.
     2688       define variable v-cost-price-base           as decimal        no-undo.
     2689       define variable v-cost-price-vat-rubl       as decimal        no-undo.
     2690       define variable v-cost-price-vat-base       as decimal        no-undo.
     2691       define variable v-err-msg                   as character      no-undo.
     2692       define buffer buf_goods             for goods.
     2693       define buffer buf_fbr-line          for fbr-line.
     2694       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2695       run writelog in this-procedure (
     2696             input log-file-name
     2697           , input 0
     2698           , input "=====*** fbr-gds.p ***================================================"
     2699       ).
     2700       find first fbr-doc no-lock
     2701           where recid ( fbr-doc ) = p-fbr-doc-recid
     2702       .
     2703       find first buf_goods no-lock
     2704            where recid ( buf_goods )     = p-goods-recid
     2705       .
     2706       run writelog in this-procedure (
     2707             input log-file-name
     2708           , input 1
     2709           , input substitute( "Обработка товара &1 &2"
     2710                               , buf_goods.artic
     2711                               , buf_goods.gds-name  )
     2712       ).
     2713       run fbrrep-fill-qnty-and-prices-gds in this-procedure (
     2714             input fbr-doc.doc-code
     2715           , input buf_goods.gds-code
     2716       ).
     2717       find first buf_temp_fbrrep-goods
     2718            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2719              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2720              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2721       use-index ar
     2722       .
     2723       run writelog in this-procedure (
     2724             input log-file-name
     2725           , input 1
     2726           , input substitute( "Вычислены суммы: "
     2727               + chr(10) + "                       fact-qnty           : &1"
     2728               + chr(10) + "                       write-off-rsrv-qnty : &2"
     2729               + chr(10) + "                       write-off-qnty      : &3"
     2730               + chr(10) + "                       income-qnty         : &4"
     2731               + chr(10) + "                       income-rsrv-qnty    : &5"
     2732               + chr(10) + "                       cost-rubl           : &6"
     2733               + chr(10) + "                       cost-base           : &7"
     2734               + chr(10) + "                       sum-cost-rubl       : &8"
     2735               + chr(10) + "                       sum-cost-base       : &9"
     2736                           , buf_temp_fbrrep-goods.fact-qnty
     2737                           , buf_temp_fbrrep-goods.write-off-rsrv-qnty
     2738                           , buf_temp_fbrrep-goods.write-off-qnty
     2739                           , buf_temp_fbrrep-goods.income-qnty
     2740                           , buf_temp_fbrrep-goods.income-rsrv-qnty
     2741                           , buf_temp_fbrrep-goods.cost-rubl
     2742                           , buf_temp_fbrrep-goods.cost-base
     2743                           , buf_temp_fbrrep-goods.sum-cost-rubl
     2744                           , buf_temp_fbrrep-goods.sum-cost-base        )
     2745       ).
     2746       run writelog in this-procedure (
     2747             input log-file-name
     2748           , input 0
     2749           , input substitute(
     2750                               "                       vat-cost-rubl       : &1"
     2751               + chr(10) + "                       vat-cost-base       : &2"
     2752               + chr(10) + "                       sum-vat-cost-rubl   : &3"
     2753               + chr(10) + "                       sum-vat-cost-base   : &4"
     2754               + chr(10) + "                       price-sale          : &5"
     2755               + chr(10) + "                       deleted             : &6"
     2756                           , buf_temp_fbrrep-goods.vat-cost-rubl
     2757                           , buf_temp_fbrrep-goods.vat-cost-base
     2758                           , buf_temp_fbrrep-goods.sum-vat-cost-rubl
     2759                           , buf_temp_fbrrep-goods.sum-vat-cost-base
     2760                           , buf_temp_fbrrep-goods.price-sale
     2761                           , buf_temp_fbrrep-goods.deleted             )
     2762       ).
     2763       assign
     2764           v-is-rsrv        = no
     2765       .
     2766       assign
     2767           v-required-qnty  =    buf_temp_fbrrep-goods.write-off-qnty
     2768                               - buf_temp_fbrrep-goods.write-off-rsrv-qnty
     2769                               - buf_temp_fbrrep-goods.income-qnty
     2770           v-price-sale     = buf_temp_fbrrep-goods.price-sale
     2771       .
     2772       run writelog in this-procedure (
     2773             input log-file-name
     2774           , input 1
     2775           , input substitute( "Нужно зарезервировать количество: &1 с ценой: &2"
     2776                               , v-required-qnty
     2777                               , v-price-sale )
     2778       ).
     2779       if v-required-qnty > 0
     2780       then do:
     2781           run str/fbr-trn.p (
     2782                 input 'спи':U
     2783               , input fbr-doc.doc-code
     2784               , input buf_goods.gds-code
     2785               , output v-trn-doc-doc-code
     2786           ) no-error.
     2787           if error-status :error
     2788           then do:
     2789               undo, return error substitute("&1 &2 &3&4Ошибка резервирования товара &5.&4Количество &6 продажная цена &7:&4&8&4&9"
     2790                                             ,vss-workfile
     2791                                             ,vss-revision
     2792                                             ,vss-description
     2793                                             ,chr(10)
     2794                                             ,buf_goods.artic  + chr(32) + buf_goods.gds-name
     2795                                             ,v-required-qnty
     2796                                             ,v-price-sale
     2797                                             , error-status:get-message(1)
     2798                                             , return-value ).
     2799           end.
     2800           run fill-doc-line in this-procedure (
     2801                 input v-trn-doc-doc-code
     2802               , input p-fbr-doc-recid
     2803               , input p-goods-recid
     2804               , input v-price-sale
     2805               , input v-required-qnty
     2806               , output v-reserved-qnty
     2807               , output v-store-qnty
     2808               , output v-store-sum-base
     2809               , output v-store-sum-rubl
     2810               , output v-store-sum-vat-base
     2811               , output v-store-sum-vat-rubl
     2812           ) no-error.
     2813           if error-status :error
     2814           then do:
     2815               assign
     2816                   v-reserved-qnty = 0
     2817               .
     2818               if error-status :get-message(1) <> ""
     2819               or return-value <> "user-interrupt":U
     2820               then do:
     2821                 if p-silent then do:
     2822                   v-err-msg = substitute("&1 &2 &3&4Не удалось зарезервировать товар на складе.&4" +
     2823                                     "Товар: &5&4Требуемое количество: &6&4Зарезервировано количество:   &7&4&8&4&9"
     2824                                     ,vss-workfile
     2825                                     ,vss-revision
     2826                                     ,vss-description
     2827                                     ,chr(10)
     2828                                     ,buf_goods.artic + chr(32) + buf_goods.gds-name
     2829                                     ,v-required-qnty
     2830                                     ,v-reserved-qnty
     2831                                     , error-status:get-message(1)
     2832                                     , return-value ).
     2833                 end.
     2834                 else do:
     2835                   v-err-msg = trim(error-status :get-message(1)) + " " +  trim(error-status :get-message(2)) + " " + trim(error-status :get-message(3)).
     2836                 end.
     2837                 find first tt-rsrv-err where tt-rsrv-err.artic = buf_goods.artic no-lock no-error.
     2838                 if not available tt-rsrv-err
     2839                   then do:
     2840                     create tt-rsrv-err.
     2841                     assign
     2842                       tt-rsrv-err.artic = buf_goods.artic
     2843                       tt-rsrv-err.gds-name = buf_goods.gds-name
     2844                       .
     2845                   end.
     2846                 assign
     2847                   tt-rsrv-err.rsrv-qnty = tt-rsrv-err.rsrv-qnty + v-reserved-qnty
     2848                   tt-rsrv-err.req-qnty = tt-rsrv-err.req-qnty + v-required-qnty
     2849                 .
     2850                 output stream stm to value (v-fbr-tt-log-file-name) append.
     2851                 export stream stm tt-rsrv-err.
     2852                 output stream stm close.
     2853                 if p-silent then do:
     2854                   if p-autofbr then do:
     2855                     undo, return error "not-reserved":U.
     2856                   end.
     2857                   undo, return error v-err-msg.
     2858                 end.
     2859                 else do:
     2860                   message
     2861                           vss-workfile vss-revision vss-description
     2862                       skip "Не удалось зарезервировать товар на складе."
     2863                       skip "Товар: " buf_goods.artic buf_goods.gds-name
     2864                       skip (1)
     2865                       skip "Требуемое количество:         " v-required-qnty
     2866                       skip "Зарезервировано количество:   " v-reserved-qnty
     2867                       skip return-value
     2868                       skip v-err-msg
     2869                   view-as alert-box error.
     2870               end.
     2871               end.
     2872               undo, return error return-value.
     2873           end.
     2874           if v-required-qnty <> v-reserved-qnty
     2875           then do:
     2876              if not p-silent then do:
     2877               message
     2878                   skip "Не удалось зарезервировать товар на складе."
     2879                   skip "Товар: " buf_goods.artic buf_goods.gds-name
     2880                   skip (1)
     2881                   skip "Требуемое количество:         " v-required-qnty
     2882                   skip "Зарезервировано количество:   " v-reserved-qnty
     2883               view-as alert-box error.
     2884               end.
     2885           end.
     2886           assign
     2887               v-is-rsrv = yes
     2888           .
     2889           run writelog in this-procedure (
     2890                 input log-file-name
     2891               , input 1
     2892               , input substitute( "Зарезервировано:"
     2893                   + chr(10) + "                       v-reserved-qnty    : &1"
     2894                   + chr(10) + "                       v-store-qnty        : &2"
     2895                   + chr(10) + "                       v-store-sum-base    : &3"
     2896                   + chr(10) + "                       v-store-sum-rubl    : &4"
     2897                   + chr(10) + "                       v-store-sum-vat-base: &5"
     2898                   + chr(10) + "                       v-store-sum-vat-rubl: &6"
     2899                           , v-reserved-qnty
     2900                           , v-store-qnty
     2901                           , v-store-sum-base
     2902                           , v-store-sum-rubl
     2903                           , v-store-sum-vat-base
     2904                           , v-store-sum-vat-rubl           )
     2905           ).
     2906           assign
     2907               v-cost-price-rubl       = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl     + buf_temp_fbrrep-goods.sum-cost-income-rubl      + v-store-sum-rubl     ) / buf_temp_fbrrep-goods.write-off-qnty
     2908               v-cost-price-base       = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-base     + buf_temp_fbrrep-goods.sum-cost-income-base      + v-store-sum-base     ) / buf_temp_fbrrep-goods.write-off-qnty
     2909               v-cost-price-vat-rubl   = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl + buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  + v-store-sum-vat-rubl ) / buf_temp_fbrrep-goods.write-off-qnty
     2910               v-cost-price-vat-base   = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base + buf_temp_fbrrep-goods.sum-vat-cost-income-base  + v-store-sum-vat-base ) / buf_temp_fbrrep-goods.write-off-qnty
     2911           .
     2912       end.
     2913       else do:
     2914           assign
     2915               v-store-qnty            = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.write-off-rsrv-qnty
     2916               v-cost-price-rubl       = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl     + ( buf_temp_fbrrep-goods.cost-income-rubl     * v-store-qnty ) ) / buf_temp_fbrrep-goods.write-off-qnty
     2917               v-cost-price-base       = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-base     + ( buf_temp_fbrrep-goods.cost-income-base     * v-store-qnty ) ) / buf_temp_fbrrep-goods.write-off-qnty
     2918               v-cost-price-vat-rubl   = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl + ( buf_temp_fbrrep-goods.vat-cost-income-rubl * v-store-qnty ) ) / buf_temp_fbrrep-goods.write-off-qnty
     2919               v-cost-price-vat-base   = ( buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base + ( buf_temp_fbrrep-goods.vat-cost-income-base * v-store-qnty ) ) / buf_temp_fbrrep-goods.write-off-qnty
     2920           .
     2921           run writelog in this-procedure (
     2922                 input log-file-name
     2923               , input 1
     2924               , input "Произведено товара достаточно для того, чтобы не брать со склада."
     2925           ).
     2926       end.
     2927       run writelog in this-procedure (
     2928             input log-file-name
     2929           , input 1
     2930           , input substitute( "Вычислены цены списания:"
     2931               + chr(10) + "                       v-store-qnty          : &1"
     2932               + chr(10) + "                       v-cost-price-rubl     : &2"
     2933               + chr(10) + "                       v-cost-price-base     : &3"
     2934               + chr(10) + "                       v-cost-price-vat-rubl : &4"
     2935               + chr(10) + "                       v-cost-price-vat-base : &5"
     2936                       , v-store-qnty
     2937                       , v-cost-price-rubl
     2938                       , v-cost-price-base
     2939                       , v-cost-price-vat-rubl
     2940                       , v-cost-price-vat-base            )
     2941       ).
     2942       for each buf_fbr-line
     2943          where buf_fbr-line.doc-code  = fbr-doc.doc-code
     2944            and buf_fbr-line.trn-type  = 'спи':U
     2945            and buf_fbr-line.artic     = buf_goods.artic
     2946            and buf_fbr-line.prod-type = buf_goods.prod-type
     2947            and buf_fbr-line.prod-code = buf_goods.prod-code
     2948       on error undo, return error
     2949       :
     2950           assign
     2951               v-old-price-base            = buf_fbr-line.price-base
     2952               v-old-price-rubl            = buf_fbr-line.price-rubl
     2953               v-old-price-sum-base        = buf_fbr-line.price-sum-base
     2954               v-old-price-sum-rubl        = buf_fbr-line.price-sum-rubl
     2955               v-old-price-sum-vat-base    = buf_fbr-line.price-sum-vat-base
     2956               v-old-price-sum-vat-rubl    = buf_fbr-line.price-sum-vat-rubl
     2957           .
     2958           assign
     2959               buf_fbr-line.rsrv-qnty              = buf_fbr-line.fact-qnty
     2960               buf_fbr-line.price-rubl             = v-cost-price-rubl
     2961               buf_fbr-line.price-base             = v-cost-price-base
     2962               buf_fbr-line.price-sum-rubl         = v-cost-price-rubl     * buf_fbr-line.fact-qnty
     2963               buf_fbr-line.price-sum-base         = v-cost-price-base     * buf_fbr-line.fact-qnty
     2964               buf_fbr-line.price-sum-vat-rubl     = v-cost-price-vat-rubl * buf_fbr-line.fact-qnty
     2965               buf_fbr-line.price-sum-vat-base     = v-cost-price-vat-base * buf_fbr-line.fact-qnty
     2966           .
     2967           if (  ( v-old-price-base           <> buf_fbr-line.price-base         ) )
     2968           or (  ( v-old-price-rubl           <> buf_fbr-line.price-rubl         ) )
     2969           or (  ( v-old-price-sum-base       <> buf_fbr-line.price-sum-base     ) )
     2970           or (  ( v-old-price-sum-rubl       <> buf_fbr-line.price-sum-rubl     ) )
     2971           or (  ( v-old-price-sum-vat-base   <> buf_fbr-line.price-sum-vat-base ) )
     2972           or (  ( v-old-price-sum-vat-rubl   <> buf_fbr-line.price-sum-vat-rubl ) )
     2973           then do:
     2974               define buffer buf_fbr-recipe        for fbr-recipe.
     2975               if fbr-doc.is-free = yes
     2976               then do:
     2977                   run calc-income-fbr-line in this-procedure (
     2978                         input buf_fbr-line.doc-code
     2979                       , input buf_fbr-line.recipe-code
     2980                   ).
     2981               end.
     2982               else do:
     2983                   find first buf_fbr-recipe no-lock
     2984                        where buf_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
     2985                        and buf_fbr-recipe.doc-code      = ub.fbr-doc.doc-code
     2986                   .
     2987                   if buf_fbr-recipe.recipe-type <> 'разделка':U
     2988                   and ( buf_fbr-recipe.recipe-type <> 'комплектация':U
     2989                       or buf_fbr-line.trn-type  <> 'при':U )
     2990                   then do:
     2991                       run calc-income-fbr-line in this-procedure (
     2992                             input buf_fbr-line.doc-code
     2993                           , input buf_fbr-line.recipe-code
     2994                       ).
     2995                   end.
     2996                   else do:
     2997                       run calc-write-off-fbr-line in this-procedure (
     2998                             input buf_fbr-line.doc-code
     2999                           , input buf_fbr-line.recipe-code
     3000                       ).
     3001                   end.
     3002               end.
     3003           end.
     3004       end.
     3005   end.
     3006   procedure fill-doc-line :
     3007     define input  parameter p-trn-doc-doc-code  as character no-undo .
     3008     define input  parameter p-fbr-doc-recid     as recid     no-undo .
     3009     define input  parameter p-goods-recid       as recid     no-undo .
     3010     define input  parameter p-price-sale        as decimal   no-undo .
     3011     define input  parameter p-required-qnty     as decimal   no-undo .
     3012     define output parameter p-reserved-qnty     as decimal   no-undo .
     3013     define output parameter p-full-qnty         as decimal   no-undo .
     3014     define output parameter p-sum-base          as decimal   no-undo .
     3015     define output parameter p-sum-rubl          as decimal   no-undo .
     3016     define output parameter p-sum-vat-base      as decimal   no-undo .
     3017     define output parameter p-sum-vat-rubl      as decimal   no-undo .
     3018     do
     3019     on error undo, return error
     3020     :
     3021       define variable v-doc-line-recid    as recid        no-undo.
     3022       define variable v-out-price-base    as decimal      no-undo.
     3023       define variable v-out-price-rubl    as decimal      no-undo.
     3024       define variable v-sum-base          as decimal      no-undo.
     3025       define variable v-sum-rubl          as decimal      no-undo.
     3026       define variable v-vat-base          as decimal      no-undo.
     3027       define variable v-vat-rubl          as decimal      no-undo.
     3028       define variable v-vat-pc            as decimal      no-undo.
     3029       define variable v-host-code         as integer      no-undo.
     3030       define variable v-today             as date         no-undo.
     3031       define variable v-time              as integer      no-undo.
     3032       define variable v-void-decimal      as decimal      no-undo.
     3033       define buffer buf_fbr-doc       for fbr-doc.
     3034       define buffer buf_goods         for goods.
     3035       define buffer buf_gds-prt       for gds-prt.
     3036       define buffer buf_trn-doc       for trn-doc.
     3037       define buffer buf_doc-line      for doc-line.
     3038       define buffer buf_gds-dtl       for gds-dtl.
     3039       find first buf_fbr-doc no-lock
     3040            where recid( buf_fbr-doc ) = p-fbr-doc-recid
     3041       .
     3042       find first buf_goods no-lock
     3043            where recid( buf_goods ) = p-goods-recid
     3044       .
     3045       find first buf_gds-prt no-lock
     3046            where buf_gds-prt.upper-code = buf_goods.prt-root
     3047       .
     3048       find first buf_trn-doc exclusive-lock
     3049            where buf_trn-doc.doc-code = p-trn-doc-doc-code
     3050       .
     3051       find first buf_doc-line exclusive-lock
     3052            where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     3053              and buf_doc-line.artic     = buf_goods.artic
     3054              and buf_doc-line.prod-type = buf_goods.prod-type
     3055              and buf_doc-line.prod-code = buf_goods.prod-code
     3056       no-error.
     3057       if not available buf_doc-line
     3058       then do:
     3059           create buf_doc-line.
     3060           assign
     3061               buf_doc-line.artic         = buf_goods.artic
     3062               buf_doc-line.prod-type     = buf_goods.prod-type
     3063               buf_doc-line.prod-code     = buf_goods.prod-code
     3064               buf_doc-line.obj-type      = buf_trn-doc.obj-type
     3065               buf_doc-line.obj-code      = buf_trn-doc.obj-code
     3066               buf_doc-line.doc-code      = buf_trn-doc.doc-code
     3067               buf_doc-line.prt-ok        = yes
     3068               buf_doc-line.prt-root      = buf_goods.prt-root
     3069               buf_doc-line.status_       = buf_trn-doc.status_
     3070               buf_doc-line.doc-qnty      = 0
     3071               buf_doc-line.cli-base-rate = 1
     3072           .
     3073       end.
     3074       assign
     3075           v-doc-line-recid = recid( buf_doc-line )
     3076       .
     3077       run fbrrsrv-rsrv-goods in this-procedure (
     3078             input parparentproc
     3079           , input p-goods-recid
     3080           , input v-doc-line-recid
     3081           , input p-required-qnty
     3082           , input yes
     3083           , input p-price-sale
     3084           , input no
     3085           , input ""
     3086           , output p-reserved-qnty
     3087       ) no-error.
     3088       if error-status :error
     3089       then do:
     3090           if error-status :get-message(1) <> ""
     3091           or return-value <> "user-interrupt":U
     3092           then do:
     3093              if p-silent then do:
     3094                undo, return error substitute("&1 &2 &3&4Ошибка резервирования товара.&4 &5&4&6"
     3095                                              ,vss-workfile
     3096                                              ,vss-revision
     3097                                              ,vss-description
     3098                                              ,chr(10)
     3099                                              , error-status:get-message(1)
     3100                                              , return-value ).
     3101              end.
     3102              else do:
     3103               message
     3104               vss-workfile vss-revision vss-description
     3105               skip "Ошибка резервирования товара."
     3106               skip return-value
     3107               skip trim(error-status :get-message(1))
     3108                   trim(error-status :get-message(2))
     3109                   trim(error-status :get-message(3))
     3110               view-as alert-box error.
     3111           end.
     3112           end.
     3113           undo, return error return-value.
     3114       end.
     3115       if p-reserved-qnty <> round( p-required-qnty, 3 )
     3116       then do:
     3117           assign
     3118               p-reserved-qnty = 0
     3119               p-sum-base      = 0
     3120               p-sum-rubl      = 0
     3121               p-sum-vat-base  = 0
     3122               p-sum-vat-rubl  = 0
     3123           .
     3124           undo, return error.
     3125       end.
     3126       run str/fbrcost.p (
     3127             input recid( buf_doc-line )
     3128           , input -1
     3129           , input p-required-qnty
     3130           , output v-sum-base
     3131           , output v-sum-rubl
     3132           , output v-vat-base
     3133           , output v-vat-rubl
     3134           , output v-vat-pc
     3135         ) .
     3136       run cur-time in this-procedure (
     3137             output v-today
     3138           , output v-time
     3139       ).
     3140   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3142     (input  buf_fbr-doc.obj-type
     3143     ,input  buf_fbr-doc.obj-code
     3144     ,output v-host-code
     3145     )  .
     3146   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3148     (input  buf_goods.gds-code
     3149     ,input  '1':U
     3150     ,input  ?
     3151     ,input  v-host-code
     3152     ,input  buf_fbr-doc.obj-type
     3153     ,input  buf_fbr-doc.obj-code
     3154     ,output v-vat-pc
     3155     )  .
     3156       find first buf_gds-dtl exclusive-lock
     3157            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     3158              and buf_gds-dtl.artic     = buf_goods.artic
     3159              and buf_gds-dtl.prod-type = buf_goods.prod-type
     3160              and buf_gds-dtl.prod-code = buf_goods.prod-code
     3161              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     3162        .
     3163       assign
     3164           p-full-qnty             = buf_doc-line.doc-qnty + p-reserved-qnty
     3165           buf_doc-line.doc-qnty   = p-full-qnty
     3166           buf_doc-line.fact-qnty  = p-full-qnty
     3167           buf_gds-dtl.doc-qnty    = p-full-qnty
     3168           buf_gds-dtl.fact-qnty   = p-full-qnty
     3169           buf_trn-doc.status_     = 'прво':U
     3170           p-sum-base              = v-sum-base - v-vat-base
     3171           p-sum-rubl              = v-sum-rubl - v-vat-rubl
     3172           p-sum-vat-base          = v-vat-base
     3173           p-sum-vat-rubl          = v-vat-rubl
     3174       .
     3175       assign
     3176           buf_doc-line.price-cli  = v-sum-rubl / p-full-qnty
     3177           buf_doc-line.price-base = v-sum-base / p-full-qnty
     3178           buf_doc-line.price-rubl = v-sum-rubl / p-full-qnty
     3179           buf_doc-line.VAT-pc     = v-vat-pc
     3180       .
     3181   end.
     3182   end procedure.
     3183   procedure rsrv-good :
     3184   do
     3185   on error undo, return error
     3186   :
     3187   define input parameter p-goods-recid        as recid                    no-undo.
     3188   define input parameter p-trn-doc-doc-code   as character                no-undo.
     3189   define input parameter p-doc-line-recid     as recid                    no-undo.
     3190   define input parameter p-price-sale         like fbr-line.price-sale    no-undo.
     3191   define input parameter p-required-qnty      like doc-line.doc-qnty      no-undo.
     3192   define output parameter p-rsrv-qnty         like doc-line.doc-qnty      no-undo.
     3193       define variable v-r-b-is-base   as logical      no-undo.
     3194       define variable v-cost-base     as decimal      no-undo.
     3195       define variable v-cost-rubl     as decimal      no-undo.
     3196       define buffer buf_goods         for goods.
     3197       define buffer buf_gds-prt       for gds-prt.
     3198       define buffer buf_gds-dtl       for gds-dtl.
     3199       define buffer buf_trn-doc       for trn-doc.
     3200       define buffer buf_doc-line      for doc-line.
     3201   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3203     (output v-r-b-is-base
     3204     )  .
     3205       find first buf_goods no-lock
     3206            where recid( buf_goods ) = p-goods-recid
     3207       .
     3208       find first buf_gds-prt no-lock
     3209            where buf_gds-prt.upper-code = buf_goods.prt-root
     3210       .
     3211       find first buf_trn-doc exclusive-lock
     3212            where buf_trn-doc.doc-code = p-trn-doc-doc-code
     3213       .
     3214       find first buf_doc-line no-lock
     3215            where recid( buf_doc-line ) = p-doc-line-recid
     3216       .
     3217   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     3218     ( input buf_trn-doc.obj-code
     3219      ,input buf_trn-doc.obj-type
     3220      ,input buf_trn-doc.doc-code
     3221      ,input buf_goods.artic
     3222      ,input buf_goods.prod-code
     3223      ,input buf_goods.prod-type
     3224      ,input buf_gds-prt.node-code
     3225      ,input yes
     3226     ) no-error .
     3227       if error-status:error
     3228       then do:
     3229           message
     3230               "Ошибка при создании признака."
     3231               skip return-value
     3232           view-as alert-box error.
     3233       end.
     3234       find first buf_gds-dtl exclusive-lock
     3235            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     3236              and buf_gds-dtl.artic     = buf_goods.artic
     3237              and buf_gds-dtl.prod-type = buf_goods.prod-type
     3238              and buf_gds-dtl.prod-code = buf_goods.prod-code
     3239              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     3240       .
     3241       if v-r-b-is-base = yes
     3242       then do:
     3243           assign
     3244               buf_gds-dtl.price-rubl = buf_gds-dtl.price-base * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     3245               buf_gds-dtl.price-base = p-price-sale
     3246           .
     3247       end.
     3248       else do:
     3249           assign
     3250               buf_gds-dtl.price-rubl = p-price-sale
     3251               buf_gds-dtl.price-base = buf_gds-dtl.price-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     3252           .
     3253       end.
     3254       assign
     3255           buf_trn-doc.status_ = 'накл':U
     3256           buf_trn-doc.flag_   = no
     3257       .
     3258       assign
     3259           buf_gds-dtl.ov  = yes
     3260           v-cost-base     = buf_doc-line.price-base
     3261           v-cost-rubl     = buf_doc-line.price-rubl
     3262           p-rsrv-qnty     = round( p-required-qnty, 3 )
     3263       .
     3264       run trg/rsrv-dtl.p (
     3265             input parparentproc
     3266           , input 'reserv':U
     3267           , buffer buf_gds-dtl
     3268           , input-output p-rsrv-qnty
     3269           , input-output v-cost-base
     3270           , input-output v-cost-rubl
     3271           , input -1
     3272           , input ""
     3273       ) no-error.
     3274       if error-status:error
     3275       then do:
     3276           undo, return error return-value.
     3277       end.
     3278       if v-cost-base <= 0
     3279       or v-cost-rubl <= 0
     3280       then do:
     3281           message
     3282               "Неправильные цены резервирования:"
     3283               skip "РУБЛИ:   " v-cost-rubl
     3284               skip "БАЗ.ВАЛ.:" v-cost-base
     3285               skip "Артикул:" buf_doc-line.artic
     3286           view-as alert-box error.
     3287           undo, return error.
     3288       end.
     3289   end.
     3290   end procedure.
     3291   procedure calc-income-fbr-line :
     3292   do
     3293   on error undo, return error
     3294   :
     3295   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3296   define input parameter p-recipe-code        as character    no-undo.
     3297       define variable v-sum-price-rubl     as decimal       no-undo.
     3298       define variable v-sum-price-base     as decimal       no-undo.
     3299       define variable v-sum-vat-price-rubl as decimal       no-undo.
     3300       define variable v-sum-vat-price-base as decimal       no-undo.
     3301       define buffer buf_income_fbr-line     for fbr-line.
     3302       define buffer buf_write-off_fbr-line     for fbr-line.
     3303       for each buf_write-off_fbr-line no-lock
     3304          where buf_write-off_fbr-line.doc-code    = p-fbr-doc-doc-code
     3305            and buf_write-off_fbr-line.trn-type    = 'спи':U
     3306            and buf_write-off_fbr-line.recipe-code = p-recipe-code
     3307       on error undo, return error
     3308       :
     3309           assign
     3310               v-sum-price-rubl     = v-sum-price-rubl     + ( if buf_write-off_fbr-line.price-rubl <> ? then buf_write-off_fbr-line.fact-qnty * buf_write-off_fbr-line.price-rubl else 0 )
     3311               v-sum-price-base     = v-sum-price-base     + ( if buf_write-off_fbr-line.price-base <> ? then buf_write-off_fbr-line.fact-qnty * buf_write-off_fbr-line.price-base else 0 )
     3312               v-sum-vat-price-rubl = v-sum-vat-price-rubl + ( if buf_write-off_fbr-line.price-sum-vat-rubl <> ? then buf_write-off_fbr-line.price-sum-vat-rubl else 0 )
     3313               v-sum-vat-price-base = v-sum-vat-price-base + ( if buf_write-off_fbr-line.price-sum-vat-base <> ? then buf_write-off_fbr-line.price-sum-vat-base else 0 )
     3314           .
     3315       end.
     3316       find first buf_income_fbr-line exclusive-lock
     3317            where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     3318              and buf_income_fbr-line.trn-type    = 'при':U
     3319              and buf_income_fbr-line.recipe-code = p-recipe-code
     3320       .
     3321       assign
     3322           buf_income_fbr-line.price-sum-rubl        = v-sum-price-rubl
     3323           buf_income_fbr-line.price-sum-base        = v-sum-price-base
     3324           buf_income_fbr-line.price-sum-vat-rubl    = v-sum-vat-price-rubl
     3325           buf_income_fbr-line.price-sum-vat-base    = v-sum-vat-price-base
     3326           buf_income_fbr-line.price-rubl            = v-sum-price-rubl / buf_income_fbr-line.fact-qnty
     3327           buf_income_fbr-line.price-base            = v-sum-price-base / buf_income_fbr-line.fact-qnty
     3328       .
     3329   end.
     3330   end procedure.
     3331   procedure calc-write-off-fbr-line :
     3332   do
     3333   on error undo, return error
     3334   :
     3335   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3336   define input parameter p-recipe-code        as character    no-undo.
     3337       define variable v-sum-price-sale    as decimal       no-undo.
     3338       define variable v-cost-factor       as decimal       no-undo.
     3339       define buffer buf_income_fbr-line     for fbr-line.
     3340       define buffer buf_write-off_fbr-line     for fbr-line.
     3341       for each buf_income_fbr-line no-lock
     3342          where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     3343            and buf_income_fbr-line.trn-type    = 'при':U
     3344            and buf_income_fbr-line.recipe-code = p-recipe-code
     3345       on error undo, return error
     3346       :
     3347           assign
     3348               v-sum-price-sale = v-sum-price-sale + ( buf_income_fbr-line.price-sale * buf_income_fbr-line.fact-qnty )
     3349           .
     3350       end.
     3351     find first buf_write-off_fbr-line no-lock
     3352            where buf_write-off_fbr-line.doc-code    = p-fbr-doc-doc-code
     3353              and buf_write-off_fbr-line.trn-type    = 'спи':U
     3354              and buf_write-off_fbr-line.recipe-code = p-recipe-code
     3355       .
     3356       for each buf_income_fbr-line exclusive-lock
     3357          where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     3358            and buf_income_fbr-line.trn-type    = 'при':U
     3359            and buf_income_fbr-line.recipe-code = p-recipe-code
     3360       on error undo, return error
     3361       :
     3362           assign
     3363               v-cost-factor                            = buf_income_fbr-line.price-sale * buf_income_fbr-line.fact-qnty / v-sum-price-sale
     3364               buf_income_fbr-line.price-rubl           = buf_write-off_fbr-line.price-rubl * v-cost-factor
     3365               buf_income_fbr-line.price-base           = buf_write-off_fbr-line.price-base * v-cost-factor
     3366               buf_income_fbr-line.price-sum-rubl       = buf_income_fbr-line.price-sum-rubl * buf_income_fbr-line.fact-qnty
     3367               buf_income_fbr-line.price-sum-base       = buf_income_fbr-line.price-sum-base * buf_income_fbr-line.fact-qnty
     3368               buf_income_fbr-line.price-sum-vat-rubl   = buf_write-off_fbr-line.price-sum-vat-rubl * v-cost-factor
     3369               buf_income_fbr-line.price-sum-vat-base   = buf_write-off_fbr-line.price-sum-vat-base * v-cost-factor
     3370           .
     3371       end.
     3372   end.
     3373   end procedure.
