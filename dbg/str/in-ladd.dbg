     1278     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1279       define variable v-answ as logical no-undo .
     1280       if ( p-unit-base-cli-eq = true
     1281            and p-density = 1.0
     1282          )
     1283         or ( p-unit-base-cli-eq = false
     1284              and p-density <> ?
     1285              and p-density > 0.0
     1286              and p-density < 1.0
     1287            )
     1288       then do:
     1289         assign
     1290           v-answ = true
     1291         .
     1292       end.
     1293       else do:
     1294         assign
     1295           v-answ = false
     1296         .
     1297       end.
     1298       return v-answ.
     1299     end function.
