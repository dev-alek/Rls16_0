     1961               f-tank-density-pomi
     1962               f-tank-weight
     1963             with frame Dialog-Frame.
     1964           end.
     1965           else do:
     1966             message
     1967               substitute('Ошибка при рассчете приведенных значений плотности и объема: &1', return-value)
     1968             view-as alert-box error.
     1969             undo, return no-apply  .
     1970           end.
     1971         end.
     1972         else do:
     1973           message
     1974             substitute('Ошибка определения типа топлива &1 или не верный тип товлива &2', return-value, v-gds-attr-value)
     1975           view-as alert-box error.
     1976           undo, return no-apply  .
     1977         end.
     1978       end.
     1979     end case.
