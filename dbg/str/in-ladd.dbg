     1925                 put stream outstream
     1926                 "v-mm:Rcy" f-tank-density-pomi      skip
     1927                 "v-mm:Vcy" f-tank-vol-pomi          skip
     1928                 "v-mm:Mcy" f-tank-weight            skip
     1929                 "v-mm:v-mm:DeltaOtn_M" f-acc-weight skip .
     1930               output stream outstream close.
     1931               release object v-mm no-error.
     1932               v-mm = ?.
     1933             end.
     1934           end.
     1935         end.
     1936       end.
     1937       when "th" then do:
     1938         run gds-attr-value in this-procedure
     1939           (  input p-gds-code
     1940           ,  input 'fuel-type':U
     1941           , output v-gds-attr-value
     1942           , output v-gds-attr-type
     1943           ) no-error .
     1944         if not error-status:error and lookup (v-gds-attr-value, "petrol,diesel-sum,diesel-wint") > 0 then do:
     1945           assign
     1946             v-fuel-type = v-gds-attr-value.
     1947           run str/rdcdnst.p (input f-tank-density * 1000
     1948                         ,input f-dens-temp
     1949                         ,input f-tank-vol
     1950                         ,input f-tank-temp
     1951                         ,input v-fuel-type
     1952                         ,output f-tank-density-pomi
     1953                         ,output f-tank-vol-pomi)
     1954           no-error.
     1955           if not error-status:error then do:
     1956             assign
     1957               f-tank-weight     = f-tank-density-pomi * f-tank-vol-pomi
     1958             .
