     2331   do:
     2332   return no-apply.
     2333   end.
     2334   ON return OF f-num-passport IN FRAME Dialog-Frame
     2335   do:
     2336   return no-apply.
     2337   end.
     2338   ON return OF f-num-plotn IN FRAME Dialog-Frame
     2339   do:
     2340   return no-apply.
     2341   end.
     2342   ON return OF f-num-print-prob IN FRAME Dialog-Frame
     2343   do:
     2344         apply "entry" to f-kol-prob in frame Dialog-Frame.
     2345   return no-apply.
     2346   end.
     2347   ON leave OF f-place-si IN FRAME Dialog-Frame
     2348   do:
     2349   define variable v-node-code as integer no-undo.
     2350   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     2351     assign f-place-si.
     2352     if f-place-si <> 0 and v-node-code <> ? then do :
     2353       find first buf_sr-izmerenia where buf_sr-izmerenia.node-code = f-place-si no-error.
     2354       if not available (buf_sr-izmerenia) then do:
     2355         message "Не найдено средство измерения с кодом " f-place-si view-as alert-box.
     2356         f-place-si = 0.
     2357         f-place-si:screen-value = "0".
     2358         f-place-si-name:screen-value = "".
     2359         assign
     2360           f-num-plotn:screen-value = ""
     2361           f-date-pov-plotn:screen-value = ""
     2362           f-passport-plotn:screen-value = "".
     2363         assign
     2364           f-num-plotn
     2365           f-date-pov-plotn
     2366           f-passport-plotn
     2367         .
     2368         hide
     2369           f-num-plotn
     2370           f-date-pov-plotn
     2371           f-passport-plotn
     2372           b-choose-date-pov-plotn
     2373           in frame Dialog-Frame.
     2374         return.
     2375       end.
     2376       v-node-code = f-place-si.
     2377       f-place-si-name:screen-value = buf_sr-izmerenia.sr-model.
     2378       v-sr-type = buf_sr-izmerenia.sr-type-id.
     2379     end.
     2380     if v-sr-type = 2 or v-sr-type = 1 then do:
     2381         enable f-num-plotn
     2382                f-date-pov-plotn
     2383                b-choose-date-pov-plotn
     2384         with frame Dialog-Frame.
     2385         hide f-passport-plotn
     2386              in frame Dialog-Frame.
     2387         f-passport-plotn:screen-value = "".
     2388         assign f-passport-plotn.
     2389     end.
     2390     if v-sr-type = 3 or v-sr-type = 4 then do:
     2391         enable f-num-plotn
     2392                f-date-pov-plotn
     2393                f-passport-plotn
     2394                b-choose-date-pov-plotn
     2395         with frame Dialog-Frame.
     2396     end.
     2397   end.
     2398   ON return OF f-place-si IN FRAME Dialog-Frame
     2399   do:
     2400     return no-apply.
     2401   end.
     2402   ON leave OF f-sec-num IN FRAME Dialog-Frame
     2403   do:
     2404     if f-sec-num:screen-value = f-sec-num then return.
     2405     find first ub.auto-tank where ub.auto-tank.auto-num = infoSectionTotal:CarNum + "#" + f-sec-num:screen-value no-error.
     2406     if available (ub.auto-tank) and (f-size = "0" or f-size = ? or f-size = "" or not infoSectionTotal:FlagTrn )
     2407     then do:
     2408       assign
     2409         f-size:screen-value = entry(3, auto-tank.name, chr(4))
     2410         f-car-vol:screen-value = string (ub.auto-tank.brutto-qnty)
     2411         f-doc-qnty:screen-value = string (ub.auto-tank.brutto-qnty)
     2412         f-size = if entry (3, auto-tank.name, chr(4)) = "" or entry (3, auto-tank.name, chr(4)) = ? then "0" else entry (3, auto-tank.name, chr(4))
     2413         f-doc-qnty = ub.auto-tank.brutto-qnty
     2414         f-car-vol = ub.auto-tank.brutto-qnty.
     2415     end.
     2416     run save-page.
     2417     v-section-names = "".
     2418     do ii = 1 to infoSectionTotal:SectionNum:
     2419       v-section-names = v-section-names + "|" + "Секция - " + if infoSectionTotal:GetInfoSectionProp(ii):SectionName = "" then string (ii) else infoSectionTotal:GetInfoSectionProp(ii):SectionName.
     2420     end.
     2421     v-section-names = trim (v-section-names, "|") + (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then "|         +" else "") + if infoSectionTotal:FlagTrn then "|Сумма" else "".
     2422     run initialize-folder (v-section-names).
     2423     run show-current-page(input v-page-current).
     2424   end.
     2425   ON leave OF f-size IN FRAME Dialog-Frame
     2426   do:
     2427       decimal (f-size:screen-value) no-error.
     2428       run calc-weight-vol in this-procedure.
     2429   end.
     2430   ON leave OF f-tank-density IN FRAME Dialog-Frame
     2431   do:
     2432       run calc-weight-vol in this-procedure.
     2433   end.
     2434   ON return OF f-tank-density IN FRAME Dialog-Frame
     2435   do:
     2436         apply "entry" to f-tank-temp in frame Dialog-Frame.
     2437   return no-apply.
     2438   end.
     2439   ON value-changed OF f-tank-density IN FRAME Dialog-Frame
     2440   do:
     2441     assign
     2442       f-tank-density-pomi = ?
     2443     .
     2444     display
     2445       f-tank-density-pomi with frame Dialog-Frame
     2446     .
     2447     run calc-weight-vol in this-procedure.
     2448   end.
     2449   ON leave OF f-tank-density-pomi IN FRAME Dialog-Frame
     2450   do:
     2451       run calc-weight-vol in this-procedure.
     2452   end.
     2453   ON return OF f-tank-temp IN FRAME Dialog-Frame
     2454   do:
     2455     return no-apply.
     2456   end.
     2457   ON value-changed OF f-tank-temp IN FRAME Dialog-Frame
     2458   do:
     2459     assign
     2460       f-tank-vol-pomi = ?
     2461     .
     2462     display
     2463       f-tank-vol-pomi with frame Dialog-Frame
     2464     .
     2465   end.
     2466   ON return OF f-tank-vol IN FRAME Dialog-Frame
     2467   do:
     2468         apply "entry" to f-tank-water in frame Dialog-Frame.
     2469   return no-apply.
     2470   end.
     2471   ON leave OF f-tank-vol-pomi IN FRAME Dialog-Frame
     2472   do:
     2473       run calc-weight-vol in this-procedure.
     2474   end.
     2475   ON return OF f-tank-vol-pomi IN FRAME Dialog-Frame
     2476   do:
     2477         apply "entry" to f-tank-water in frame Dialog-Frame.
     2478   return no-apply.
     2479   end.
     2480   ON return OF f-tank-vol-total IN FRAME Dialog-Frame
     2481   do:
     2482         apply "entry" to f-tank-water in frame Dialog-Frame.
     2483   return no-apply.
     2484   end.
     2485   ON leave OF f-tank-water IN FRAME Dialog-Frame
     2486   do:
     2487     assign
     2488       f-tank-vol-pomi = ?
     2489     .
     2490     display
     2491       f-tank-vol-pomi with frame Dialog-Frame
     2492     .
     2493     run calc-weight-vol in this-procedure.
     2494   end.
     2495   ON return OF f-tank-water IN FRAME Dialog-Frame
     2496   do:
     2497         apply "entry" to f-tank-density in frame Dialog-Frame.
     2498   return no-apply.
     2499   end.
     2500   ON return OF f-tank-weight IN FRAME Dialog-Frame
     2501   do:
     2502         apply "entry" to b-save in frame Dialog-Frame.
     2503   return no-apply.
     2504   end.
     2505   ON leave OF f-tank-weight-total IN FRAME Dialog-Frame
     2506   do:
     2507       run calc-weight-vol in this-procedure.
     2508   end.
     2509   ON return OF f-tank-weight-total IN FRAME Dialog-Frame
     2510   do:
     2511     apply "entry" to f-tests in frame Dialog-Frame.
     2512     return no-apply.
     2513   end.
     2514   ON value-changed OF f-tank-weight-total IN FRAME Dialog-Frame
     2515   do:
     2516     assign
     2517       f-tank-vol-pomi = ?
     2518     .
     2519     display
     2520       f-tank-vol-pomi with frame Dialog-Frame
     2521     .
     2522   end.
     2523   ON return OF f-tests IN FRAME Dialog-Frame
     2524   do:
     2525     return no-apply.
     2526   end.
     2527   ON return OF f-ttn-temp IN FRAME Dialog-Frame
     2528   do:
     2529     return no-apply.
     2530   end.
     2531   ON return OF f-validity-certif IN FRAME Dialog-Frame
     2532   do:
     2533   return no-apply.
     2534   end.
     2535   ON CHOOSE OF r-list-tank IN FRAME Dialog-Frame
     2536   DO:
     2537     assign f-list-tank.
     2538     run str/place-list.w
     2539     ( input p-doc-code,
     2540       input p-gds-code,
     2541       input-output f-list-tank
     2542     ).
     2543     f-list-tank:screen-value = f-list-tank.
     2544   END.
     2545   ON choose OF r-sr-izm IN FRAME Dialog-Frame
     2546   do:
     2547     define variable v-node-code as integer no-undo.
     2548     define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     2549     v-node-code = 0 .
     2550     run ref/sr-izm.w (input parparentproc ,
     2551                       input ""            ,
     2552                       input 'ПРОСМОТР':U     ,
     2553                       input ""            ,
     2554                       input ""            ,
     2555                       input-output v-node-code,
     2556                       output v-sr-type) no-error.
     2557     if v-node-code <> 0 and v-node-code <> ? then do :
     2558       f-place-si = v-node-code.
     2559       f-place-si:screen-value = string(v-node-code).
     2560     find first buf_sr-izmerenia where buf_sr-izmerenia.node-code = v-node-code no-error.
     2561     if not available buf_sr-izmerenia then do:
     2562       message "Введено неизвестное стредство измерения" view-as alert-box.
     2563       return no-apply.
     2564     end.
     2565     f-place-si-name:screen-value = buf_sr-izmerenia.sr-model.
     2566     end.
     2567     apply "leave" to f-place-si.
     2568   end.
     2569   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     2570   then frame Dialog-Frame:PARENT = active-window.
     2571   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   on help of frame Dialog-Frame
     2573   do:
     2574     run gbl/app_help.p
     2575       (input this-procedure :file-name
     2576       ,input ''
     2577       ,input ?
     2578       ) no-error.
     2579     if error-status :error then do:
     2580       message
     2581         "Ошибка при вызове помощи"
     2582         error-status :get-message(1)
     2583         view-as alert-box .
     2584     end.
     2585   end.
     2586   run minbtn-set in this-procedure .
     2587   on choose of b-help in frame Dialog-Frame
     2588   do:
     2589     apply "help":u to frame Dialog-Frame .
     2590   end.
     2591   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2592   procedure minbtn-set :
     2593       do
     2594           on error undo, return error return-value
     2595           :
     2596           define variable ii              as integer       no-undo .
     2597           define variable fh              as widget-handle no-undo .
     2598           define variable hh              as widget-handle no-undo .
     2599           define variable v-h             as handle        extent 4 no-undo .
     2600           define variable v-name-button   as character     no-undo .
     2601           define variable v-help-old-x    as decimal       no-undo .
     2602           define variable v-help-old-y    as decimal       no-undo .
     2603           define variable v-help-old-size as decimal       no-undo .
     2604           define variable v-frame-width   as decimal       no-undo .
     2605           define variable jj              as integer       no-undo .
     2606           do
     2607               on error undo, return error
     2608               :
     2609               assign
     2610                   v-frame-width = frame Dialog-Frame:width - 0.3
     2611                   fh            = frame Dialog-Frame:first-child
     2612                   hh            = fh:first-child
     2613                   ii            = 1
     2614                   .
     2615               do while valid-handle(hh):
     2616                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2617                   do:
     2618                       case lc(hh:name) :
     2619                           when "b-help" then
     2620                               do:
     2621                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2622                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2623                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2624                                   hh:TOOLTIP = "Помощь" .
     2625                                   v-help-old-x = hh:column .
     2626                                   v-help-old-y = hh:row    .
     2627                                   v-help-old-size = hh:width .
     2628                                   hh:width-chars = 2.5 .
     2629                               end.
     2630                           when "b-print" then
     2631                               do:
     2632                                   hh:load-image("cmp/b-print.bmp":u) .
     2633                                   hh:TOOLTIP = "Печать" .
     2634                                   v-h[ii] = hh:handle .
     2635                                   ii = ii + 1 .
     2636                                   hh:width-chars = 3 .
     2637                               end.
     2638                           when "b-history" or
     2639                           when "b-hist" then
     2640                               do:
     2641                                   hh:load-image("cmp/b-hist.bmp":u) .
     2642                                   hh:TOOLTIP = "История" .
     2643                                   v-h[ii] = hh:handle .
     2644                                   ii = ii + 1 .
     2645                                   hh:width-chars = 3 .
     2646                               end.
     2647                           when "b-sch" then
     2648                               do:
     2649                                   hh:load-image("cmp/b-sch.bmp":u) .
     2650                                   hh:TOOLTIP = "Установка Фильтра" .
     2651                                   v-h[ii] = hh:handle .
     2652                                   ii = ii + 1 .
     2653                                   hh:width-chars = 3 .
     2654                               end.
     2655                           when "b-hist-user" then
     2656                               do:
     2657                                   hh:load-image("cmp/b-hist.bmp":u) .
     2658                                   hh:TOOLTIP = "История пользователя" .
     2659                                   ii = ii + 1 .
     2660                               end.
     2661                       end case.
     2662                   end.
     2663                   hh = hh:next-sibling.
     2664               end.
     2665               b-help:column = v-frame-width - b-help:width-chars.
     2666               jj = 0.
     2667               repeat ii = 4 to 1 by -1 :
     2668                   if valid-handle (v-h[ii] ) then
     2669                   do:
     2670                       jj  = jj + 1 .
     2671                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2672                       v-h[ii]:row    = v-help-old-y .
     2673                   end.
     2674               end.
     2675           end.
     2676       end.
     2677   end procedure.
     2678   MAIN-BLOCK:
     2679   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2680      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2681     run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
     2682     run gds-attr-value in this-procedure
     2683       (  input p-gds-code
     2684       ,  input 'fuel-type':U
     2685       , output v-gds-attr-value
     2686       , output v-gds-attr-type
     2687       ) no-error .
     2688     if error-status:error or lookup (v-gds-attr-value, "metan,propan") > 0 then
     2689     do:
     2690       rdc-dnstvalue = "not".
     2691     end.
     2692     infoSectionTotal:RdcDnstvalue = rdc-dnstvalue.
     2693     v-page-current = 1.
     2694     v-section-names = "".
     2695     if infoSectionTotal:SectionNum = 1 then do:
     2696       infoSectionTotal:GetInfoSectionProp(1):DocQnty = infoSectionTotal:DocQntyLine.
     2697       infoSectionTotal:GetInfoSectionProp(1):DocDensity = infoSectionTotal:DocDensLine.
     2698       infoSectionTotal:GetInfoSectionProp(1):CliQnty = infoSectionTotal:DocCliLine.
     2699     end.
     2700     do ii = 1 to infoSectionTotal:SectionNum:
     2701       v-section-names = v-section-names + "|" + 'Секция - ' + if infoSectionTotal:GetInfoSectionProp(ii):SectionName = "" then string (ii) else infoSectionTotal:GetInfoSectionProp(ii):SectionName.
     2702     end.
     2703     if infoSectionTotal:FlagTrn
     2704       then v-section-names = trim (v-section-names, "|") + (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then "|         +" else "") + "|Сумма".
     2705       else v-section-names = trim (v-section-names, "|") + (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then "|         +" else "").
     2706     run set-size(input frame Dialog-Frame:height-pixels - 73, input frame Dialog-Frame:width-pixels - 20).
     2707     run initialize-folder (v-section-names).
     2708     run show-current-page(input v-page-current).
     2709     find first buf_goods no-lock
     2710       where buf_goods.gds-code = p-gds-code
     2711       .
     2712     run enable_UI.
     2713     run initialize-section.
     2714     find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     2715   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   run get-ptrl-prop in this-procedure
     2717     ( input trn-doc.obj-type
     2718     , input trn-doc.obj-code
     2719     ) .
     2720     if not error-status :error then do:
     2721       if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     2722                                     else temp-for-pomi = 20 .
     2723     end.
     2724     assign
     2725       infoSectionTotal:IsRNAlgo = if ptrlprop-algoincome = 2 then true else false
     2726     .
     2727     if not infoSectionTotal:IsRnAlgo
     2728       then
     2729         hide
     2730           f-acc-weight
     2731         in frame Dialog-Frame .
     2732     wait-for go of frame Dialog-Frame focus f-sec-num.
     2733   end.
     2734   run disable_UI.
     2735   PROCEDURE calc-doc :
     2736   run save-page.
     2737     case false:
     2738       when infoSectionTotal:DocQntyInput then do:
     2739         infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty = infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty / infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity no-error.
     2740       end.
     2741       when infoSectionTotal:DensityInput then do:
     2742         infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity = infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty / infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty no-error.
     2743       end.
     2744       when infoSectionTotal:CliQntyInput then do:
     2745         infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty = infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty * infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity no-error.
     2746       end.
     2747     end.
     2748     do with frame Dialog-Frame:
     2749     assign
     2750       f-doc-qnty:screen-value = string (infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty)
     2751       f-doc-dens:screen-value = string (infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity)
     2752       f-cli-qnty:screen-value = string (infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty).
     2753     end.
     2754     assign frame Dialog-Frame
     2755       f-doc-qnty
     2756       f-doc-dens
     2757       f-cli-qnty
     2758     .
     2759   end procedure.
     2760   PROCEDURE calc-weight-vol :
     2761   define variable v-area as decimal no-undo.
     2762     if v-page-current > infoSectionTotal:SectionNum or not infoSectionTotal:FlagTrn
     2763       then return.
     2764     assign frame Dialog-Frame
     2765       f-mouth
     2766       f-a-b-tarir
     2767       f-size
     2768       f-tank-density
     2769       f-tank-weight
     2770       f-tank-vol
     2771       f-tank-vol-pomi
     2772       f-tank-density-pomi
     2773       f-car-vol
     2774       f-tank-water
     2775       .
     2776     assign
     2777       f-size              = string (decimal (f-size))
     2778       f-size:screen-value = string (decimal (f-size))
     2779       no-error.
     2780     if error-status:error then
     2781     do:
     2782       assign
     2783         v-area = decimal (entry (1,f-size, "/")) * decimal (entry (2,f-size, "/")) * 0.000001
     2784         no-error.
     2785       if error-status:error then
     2786       do:
     2787         message "Неверно указан размер горловины (либо значение диаметра, либо значение сторон для прямоугольной горловины в виде a/b). Берется по умолчанию 0" view-as alert-box.
     2788         f-size:screen-value in frame Dialog-Frame = "0".
     2789         v-area = 0.
     2790       end.
     2791     end.
     2792     else
     2793     do:
     2794       v-area = 3.14159 * decimal (f-size) * decimal (f-size) * 0.000001 / 4 no-error.
     2795     end.
     2796     f-mouth = round (f-a-b-tarir * v-area, 2) .
     2797     if f-mouth <> decimal (f-mouth:screen-value) then
     2798       apply "value-changed" to f-mouth in frame Dialog-Frame.
     2799     f-tank-vol = f-car-vol + f-mouth - f-tank-water.
     2800     if rdc-dnstvalue = "not" then
     2801     do:
     2802       display input frame Dialog-Frame f-tank-vol *
     2803         input frame Dialog-Frame f-tank-density @ f-tank-weight with frame Dialog-Frame.
     2804     end.
     2805     else
     2806     do:
     2807       if rdc-dnstvalue = "pomi-rn" or rdc-dnstvalue = "th" then do :
     2808         display input frame Dialog-Frame f-tank-weight /
     2809           input frame Dialog-Frame f-tank-vol-pomi @ f-tank-density-pomi with frame Dialog-Frame.
     2810         assign
     2811           f-tank-density-pomi = f-tank-weight / f-tank-vol-pomi.
     2812       end.
     2813       else do:
     2814       display input frame Dialog-Frame f-tank-vol-pomi *
     2815         input frame Dialog-Frame f-tank-density-pomi @ f-tank-weight with frame Dialog-Frame.
     2816       end.
     2817     end.
     2818     assign
     2819       f-tank-weight.
     2820     do with frame Dialog-Frame:
     2821       assign
     2822         f-mouth:screen-value in frame Dialog-Frame = string (f-mouth)
     2823         f-tank-vol:screen-value                     = string (f-tank-vol).
     2824       .
     2825     end.
     2826   end procedure.
     2827   PROCEDURE check-data :
     2828   define variable ii as integer no-undo.
     2829     define variable v-list-tank as character no-undo.
     2830     if p-mode = 'ПРОСМОТР':U or not infoSectionTotal:FlagTrn
     2831         then return.
     2832     infoSectionTotal:CalculateTotal().
     2833     case false:
     2834     when 0.01 > abs (infoSectionTotal:DocQntyTotal - infoSectionTotal:DocQntyLine) then
     2835     do:
     2836       message substitute ("Количество по документу - &1 не совпадает с суммой количества по документу - &2 по секциям", infoSectionTotal:DocQntyLine, infoSectionTotal:DocQntyTotal) view-as alert-box error.
     2837       return error.
     2838     end.
     2839     when 0.01 > abs (infoSectionTotal:DocDensityAvg - infoSectionTotal:DocDensLine) then
     2840     do:
     2841       message substitute ("Плотность по документу - &1 не совпадает со средней плотностью по документу - &2 по секциям", infoSectionTotal:DocDensLine, infoSectionTotal:DocDensityAvg) view-as alert-box error.
     2842       return error.
     2843     end.
     2844     when 0.01 > abs (infoSectionTotal:DocDensityAvg * infoSectionTotal:DocQntyTotal - infoSectionTotal:DocCliLine) then
     2845     do:
     2846       message substitute ("Масса по документу - &1 не совпадает с суммой масс по документу - &2 по секциям", infoSectionTotal:DocCliLine, infoSectionTotal:DocDensityAvg * infoSectionTotal:DocQntyTotal) view-as alert-box error.
     2847       return error.
     2848     end.
     2849     end case.
     2850     assign
     2851       f-list-tank = f-list-tank:screen-value in frame Dialog-Frame.
     2852     for each buf_doc-pl where buf_doc-pl.out-code = p-doc-code and buf_doc-pl.gds-code = p-gds-code:
     2853       find first ub.place no-lock where ub.place.pl-code = buf_doc-pl.pl-code no-error.
     2854       v-list-tank = v-list-tank + "," + ub.place.loc1.
     2855     end.
     2856     v-list-tank = left-trim (v-list-tank, ",").
     2857     do ii = 1 to num-entries (f-list-tank):
     2858       if lookup (entry (ii, f-list-tank), v-list-tank) = 0
     2859       then do:
     2860         message substitute ("Неверно указаны резервуары") view-as alert-box error.
     2861         return error.
     2862       end.
     2863     end.
     2864   end procedure.
     2865   PROCEDURE check-page :
     2866   define variable v-list-tank as character no-undo.
     2867     if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then return.
     2868     integer (replace (f-sec-num, ".", "-")) no-error.
     2869     if error-status:error or f-sec-num matches "*,*"
     2870       then
     2871     do:
     2872       message "Номер секции должен иметь числовое значение" view-as alert-box .
     2873       apply "entry" to f-sec-num in frame Dialog-Frame .
     2874       return error .
     2875     end.
     2876     do ii = 1 to infoSectionTotal:SectionNum:
     2877       if ii <> v-page-current and input frame Dialog-Frame f-sec-num = infoSectionTotal:GetInfoSectionProp(ii):SectionName and infoSectionTotal:SectionNum >= v-page-current
     2878       then do:
     2879         message "Такой номер секции уже был" view-as alert-box .
     2880         apply "entry" to f-sec-num in frame Dialog-Frame .
     2881         return error .
     2882       end.
     2883     end.
     2884     if not infoSectionTotal:FlagTrn then return.
     2885     define variable stfactplvalue as character no-undo initial ? .
     2886     define variable stfactpltype  as character no-undo initial ? .
     2887     define variable v-update      as logical   no-undo initial true .
     2888     define variable v-revision    as logical   no-undo initial false .
     2889     define variable v-percrev     as decimal   no-undo initial ? .
     2890     define variable v-auto-tank   as logical   no-undo initial false .
     2891     define variable v-percauto    as decimal   no-undo initial ? .
     2892     define variable v-inv         as logical   no-undo initial false .
     2893     define variable v-percinv     as decimal   no-undo initial ? .
     2894     define variable v-inv-set     as logical   no-undo initial false .
     2895   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2896     (input  'stfactpl'
     2897     ,input  ''
     2898     ,input  ''
     2899     ,input  0
     2900     ,input  ''
     2901     ,input  ''
     2902     ,input  ''
     2903     ,input  no
     2904     ,output stfactplvalue
     2905     ,output stfactpltype
     2906     ) no-error .
     2907     if error-status :error then do:
     2908     end.
     2909     if stfactplvalue <> "":U then do:
     2910   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
     2911     (  input stfactplvalue
     2912     , output v-update
     2913     , output v-revision
     2914     , output v-percrev
     2915     , output v-auto-tank
     2916     , output v-percauto
     2917     , output v-inv
     2918     , output v-percinv
     2919     , output v-inv-set
     2920     )  .
     2921     end.
     2922     if v-auto-tank = true
     2923       or v-inv = true
     2924     then do:
     2925       if input frame Dialog-Frame f-car-vol <= 0 or
     2926          input frame Dialog-Frame f-car-vol = ?
     2927       then do:
     2928         message "Объем по паспорту в литрах должен быть больше 0." view-as alert-box .
     2929         apply "entry" to f-car-vol in frame Dialog-Frame .
     2930         return error .
     2931       end.
     2932       if rdc-dnstvalue = "pomi-rn"  then do:
     2933           if f-place-si:screen-value <> "" and input frame Dialog-Frame f-place-si <> 0 then do:
     2934              if v-sr-type = 1 or v-sr-type = 2 then do:
     2935              end.
     2936           end.
     2937           if f-place-si:screen-value <> "" then do:
     2938              if v-sr-type = 3 or v-sr-type = 4 then do:
     2939             end.
     2940           end.
     2941       end.
     2942       if rdc-dnstvalue = "pomi-rn" then do:
     2943           if input frame Dialog-Frame f-tank-vol <= 0 or
     2944              input frame Dialog-Frame f-tank-vol  = ?
     2945           then do:
     2946             message "Объем топлива должен быть больше 0." view-as alert-box .
     2947             apply "entry" to f-tank-vol in frame Dialog-Frame .
     2948             return error .
     2949           end.
     2950           if input frame Dialog-Frame f-tank-weight <= 0 or
     2951              input frame Dialog-Frame f-tank-weight  = ?
     2952           then do:
     2953             message "Вес топлива должен быть больше 0." view-as alert-box .
     2954             apply "entry" to f-tank-weight in frame Dialog-Frame .
     2955             return error .
     2956           end.
     2957           if input frame Dialog-Frame f-tank-density = ?
     2958             or Valid-Density( input frame Dialog-Frame f-tank-density, (buf_goods.unit-base = buf_goods.unit-cli) ) <> yes
     2959           then do:
     2960             message "Плотность должна быть больше 0 и меньше 1." view-as alert-box .
     2961             apply "entry" to f-tank-density in frame Dialog-Frame .
     2962             return error .
     2963           end.
     2964           if input frame Dialog-Frame f-place-si = 0
     2965           then do:
     2966             message "Введите средство измерения." view-as alert-box .
     2967             apply "entry" to f-place-si in frame Dialog-Frame .
     2968             return error .
     2969           end.
     2970           end.
     2971     end.
     2972     if input frame Dialog-Frame f-hour-start <> ?
     2973       and input frame Dialog-Frame f-hour-start > 24
     2974     then do:
     2975        message "Неверно заведено поле <<час>>." view-as alert-box .
     2976        apply "entry" to f-hour-start in frame Dialog-Frame .
     2977        return error .
     2978     end.
     2979     if input frame Dialog-Frame f-hour-end > 24
     2980     then do:
     2981        message "Неверно заведено поле час." view-as alert-box .
     2982        apply "entry" to f-hour-end in frame Dialog-Frame .
     2983        return error .
     2984     end.
     2985     if input frame Dialog-Frame f-min-start > 60
     2986     then do:
     2987        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     2988        apply "entry" to f-min-start in frame Dialog-Frame .
     2989        return error .
     2990     end.
     2991     if input frame Dialog-Frame f-min-end > 60
     2992     then do:
     2993        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     2994        apply "entry" to f-min-end in frame Dialog-Frame .
     2995        return error .
     2996     end.
     2997     if input frame Dialog-Frame f-sec-num = ""
     2998     then do:
     2999        message "Не указан номер секции" view-as alert-box .
     3000        apply "entry" to f-sec-num in frame Dialog-Frame .
     3001        return error .
     3002     end.
     3003   if input frame Dialog-Frame f-hour-prob > 24
     3004     then do:
     3005        message "Неверно заведено поле час." view-as alert-box .
     3006        apply "entry" to f-hour-end in frame Dialog-Frame .
     3007        return error .
     3008     end.
     3009     if input frame Dialog-Frame f-min-start > 60
     3010     then do:
     3011        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     3012        apply "entry" to f-min-start in frame Dialog-Frame .
     3013        return error .
     3014     end.
     3015     assign
     3016       f-list-tank = f-list-tank:screen-value in frame Dialog-Frame.
     3017     for each buf_doc-pl where buf_doc-pl.out-code = p-doc-code and buf_doc-pl.gds-code = p-gds-code:
     3018       find first ub.place no-lock where ub.place.pl-code = buf_doc-pl.pl-code no-error.
     3019       v-list-tank = v-list-tank + "," + ub.place.loc1.
     3020     end.
     3021     v-list-tank = left-trim (v-list-tank, ",").
     3022     do ii = 1 to num-entries (f-list-tank):
     3023       if lookup (entry (ii, f-list-tank), v-list-tank) = 0
     3024       then do:
     3025         message substitute ("Неверно указаны резервуары") view-as alert-box.
     3026         apply "entry" to f-list-tank in frame Dialog-Frame .
     3027         return error.
     3028       end.
     3029     end.
     3030   end procedure.
     3031   PROCEDURE disable_UI :
     3032     HIDE FRAME Dialog-Frame.
     3033   END PROCEDURE.
     3034   PROCEDURE enable_UI :
     3035     DISPLAY f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-acc-ship f-cli-qnty
     3036             f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2
     3037             f-certif-fuel f-text3 f-validity-certif f-a-b-tarir f-mouth
     3038             f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp
     3039             f-EU-weight f-list-tank f-loss-norm f-place-si f-num-plotn
     3040             f-date-pov-plotn f-tank-weight f-tank-density-pomi f-acc-weight
     3041             f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end
     3042             f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob
     3043             f-min-prob f-date-prob f-place-si-name
     3044         WITH FRAME Dialog-Frame.
     3045     ENABLE Rect-Main Rect-Bottom Rect-Left Rect-Right Rect-Top RECT-3 RECT-1
     3046            RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 b-save b-quit b-del-sec b-help
     3047            f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol
     3048            f-num-passport f-norm-doc f-certif-fuel f-validity-certif f-a-b-tarir
     3049            f-mouth f-tank-water f-tank-temp f-tank-density f-dens-temp
     3050            f-list-tank r-list-tank f-acc-ship f-num-plotn
     3051            f-date-pov-plotn f-date-start f-hour-start f-min-start f-date-end
     3052            f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob
     3053            f-min-prob f-date-prob
     3054         WITH FRAME Dialog-Frame.
     3055     VIEW FRAME Dialog-Frame.
     3056   END PROCEDURE.
     3057   PROCEDURE hide-disp-page :
     3058   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     3059     if not infoSectionTotal:FlagTrn and (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) then do:
     3060       enable RECT-3 RECT-1 RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2 f-certif-fuel f-text3 f-validity-certif b-copy-pass f-a-b-tarir f-mouth f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp f-list-tank r-list-tank f-place-si r-sr-izm f-num-plotn f-date-pov-plotn b-copy-iz b-choose-date-pov-plotn f-passport-plotn f-tank-weight f-tank-density-pomi b-calc f-acc-weight f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob f-min-prob f-date-prob f-place-si-name f-EU-weight f-acc-ship f-loss-norm with frame Dialog-Frame.
     3061       hide RECT-3 RECT-1 RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2 f-certif-fuel f-text3 f-validity-certif b-copy-pass f-a-b-tarir f-mouth f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp f-list-tank r-list-tank f-place-si r-sr-izm f-num-plotn f-date-pov-plotn b-copy-iz b-choose-date-pov-plotn f-passport-plotn f-tank-weight f-tank-density-pomi b-calc f-acc-weight f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob f-min-prob f-date-prob f-place-si-name f-EU-weight f-acc-ship f-loss-norm in frame Dialog-Frame.
     3062       display f-doc-qnty f-acc-ship f-doc-dens f-cli-qnty f-sec-num f-ttn-temp with frame Dialog-Frame.
     3063       enable f-doc-qnty f-acc-ship f-doc-dens f-cli-qnty f-sec-num f-ttn-temp with frame Dialog-Frame.
     3064       if infoSectionTotal:CliQntyInput and (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U)
     3065         then enable f-cli-qnty with frame Dialog-Frame.
     3066       else disable f-cli-qnty with frame Dialog-Frame.
     3067       if infoSectionTotal:DocQntyInput and (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U)
     3068         then enable f-doc-qnty with frame Dialog-Frame.
     3069       else disable f-doc-qnty with frame Dialog-Frame.
     3070       if infoSectionTotal:DensityInput and (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U)
     3071         then enable f-doc-dens with frame Dialog-Frame.
     3072       else disable f-doc-dens with frame Dialog-Frame.
     3073       return.
     3074     end.
     3075     display RECT-3 RECT-1 RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2 f-certif-fuel f-text3 f-validity-certif b-copy-pass f-a-b-tarir f-mouth f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp f-list-tank r-list-tank f-place-si r-sr-izm f-num-plotn f-date-pov-plotn b-copy-iz b-choose-date-pov-plotn f-passport-plotn f-tank-weight f-tank-density-pomi b-calc f-acc-weight f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob f-min-prob f-date-prob f-place-si-name f-EU-weight f-acc-ship f-loss-norm with frame Dialog-Frame.
     3076     define variable IsKPPageCurrent as logical no-undo.
     3077     IsKPPageCurrent = infoSectionTotal:GetInfoSectionProp(v-page-current):IsKP.
     3078     iTemp = infoSectionTotal:GetInfoSectionProp(v-page-current):PlaceSi.
     3079     find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = iTemp no-error.
     3080     if available buf_sr-izmerenia then do:
     3081       assign
     3082         f-place-si-name:screen-value = buf_sr-izmerenia.sr-model
     3083         v-sr-type = buf_sr-izmerenia.sr-type-id.
     3084     end.
     3085     else
     3086       assign
     3087         f-place-si-name:screen-value = ""
     3088         v-sr-type = 0.
     3089     find first buf_goods no-lock
     3090       where buf_goods.gds-code = p-gds-code
     3091       .
     3092     if v-sr-type = 0 then
     3093     do:
     3094       hide
     3095         f-num-plotn
     3096         f-date-pov-plotn
     3097         b-choose-date-pov-plotn
     3098         f-passport-plotn
     3099         in frame Dialog-Frame.
     3100     end.
     3101     else
     3102     do:
     3103       if v-sr-type = 1 or v-sr-type = 2 then
     3104       do:
     3105         enable
     3106           f-num-plotn
     3107           f-date-pov-plotn
     3108           b-choose-date-pov-plotn
     3109           with frame Dialog-Frame.
     3110         hide
     3111           f-passport-plotn
     3112           in frame Dialog-Frame.
     3113       end.
     3114       if v-sr-type = 3 or v-sr-type = 4 then
     3115       do:
     3116         enable
     3117           f-num-plotn
     3118           f-date-pov-plotn
     3119           b-choose-date-pov-plotn
     3120           f-passport-plotn
     3121           with frame Dialog-Frame.
     3122       end.
     3123     end.
     3124     display
     3125       f-car-vol f-tests f-sec-num f-doc-qnty
     3126       f-date-start f-hour-start f-min-start
     3127       f-date-end f-hour-end f-min-end
     3128       f-tank-vol f-tank-temp f-tank-water f-tank-density
     3129       f-tank-weight
     3130       f-mouth
     3131       f-a-b-tarir
     3132       f-tank-vol-pomi f-dens-temp
     3133       f-certif-fuel f-norm-doc
     3134       f-num-passport f-validity-certif f-list-tank r-list-tank
     3135       f-kol-prob f-num-print-prob f-date-prob f-hour-prob f-min-prob f-ttn-temp f-size f-acc-ship f-EU-weight f-loss-norm
     3136       with frame Dialog-Frame.
     3137     if rdc-dnstvalue <> "not" and p-mode <> 'ПРОСМОТР':U  then
     3138     do :
     3139       disable
     3140         f-mouth
     3141         f-tank-density-pomi
     3142         with frame Dialog-Frame.
     3143       display
     3144         f-size
     3145         f-place-si
     3146         r-sr-izm
     3147         f-tank-density-pomi
     3148         b-calc
     3149         b-copy-iz
     3150         b-copy-pass
     3151         with frame Dialog-Frame.
     3152       enable
     3153         f-size
     3154         f-place-si
     3155         r-sr-izm
     3156         b-calc
     3157         b-copy-iz
     3158         b-copy-pass
     3159         with frame Dialog-Frame.
     3160     end.
     3161     if rdc-dnstvalue = "manual"
     3162       then
     3163     do:
     3164       disable
     3165         b-calc
     3166         with frame Dialog-Frame.
     3167       enable
     3168         f-tank-vol-pomi
     3169         f-tank-density-pomi
     3170         with frame Dialog-Frame.
     3171     end.
     3172     if rdc-dnstvalue = "" or rdc-dnstvalue = ? or rdc-dnstvalue = "not" then
     3173     do:
     3174       rdc-dnstvalue = "not".
     3175       disable
     3176         f-tank-vol
     3177         f-tank-temp
     3178         f-tank-water
     3179         f-tank-weight
     3180         with frame Dialog-Frame.
     3181       enable
     3182         f-mouth
     3183         f-a-b-tarir
     3184         f-dens-temp
     3185         f-tank-density
     3186         f-car-vol f-tests f-sec-num f-doc-qnty
     3187         f-date-start f-hour-start f-min-start
     3188         f-date-end f-hour-end f-min-end
     3189         f-kol-prob f-num-print-prob f-date-prob f-hour-prob f-min-prob f-ttn-temp f-acc-ship
     3190         with frame Dialog-Frame.
     3191       hide
     3192         f-tank-vol-pomi
     3193         f-tank-density-pomi
     3194         in frame Dialog-Frame.
     3195     end.
     3196     if rdc-dnstvalue <> "pomi-rn" then do:
     3197         HIDE
     3198           f-tests f-num-print-prob f-kol-prob f-hour-prob
     3199           f-min-prob f-date-prob f-acc-weight
     3200         in frame Dialog-Frame .
     3201     end.
     3202     if infoSectionTotal:CliQntyInput and p-mode = 'ИЗМЕНЕНИЕ':U
     3203       then
     3204         assign
     3205           f-cli-qnty:sensitive = true
     3206           f-cli-qnty:fgcolor = 12
     3207         .
     3208     else disable f-cli-qnty with frame Dialog-Frame.
     3209     if infoSectionTotal:DocQntyInput and p-mode = 'ИЗМЕНЕНИЕ':U
     3210       then
     3211         assign
     3212           f-doc-qnty:sensitive = true
     3213           f-doc-qnty:fgcolor = 12.
     3214     else disable f-doc-qnty with frame Dialog-Frame.
     3215     if infoSectionTotal:DensityInput and p-mode = 'ИЗМЕНЕНИЕ':U
     3216       then
     3217         assign
     3218           f-doc-dens:sensitive = true
     3219           f-doc-dens:fgcolor = 12.
     3220     else disable f-doc-dens with frame Dialog-Frame.
     3221     if p-mode <> 'ИЗМЕНЕНИЕ':U then
     3222     do:
     3223       disable
     3224         f-car-vol f-tests f-sec-num f-doc-qnty
     3225         f-tank-vol f-tank-temp f-tank-water f-tank-density
     3226         f-tank-weight
     3227         f-date-start f-hour-start f-min-start
     3228         f-date-end f-hour-end f-min-end
     3229         f-tank-vol-pomi f-dens-temp
     3230         f-tank-density-pomi
     3231         f-size
     3232         f-place-si
     3233         r-sr-izm
     3234         b-calc
     3235         b-copy-iz
     3236         b-copy-pass
     3237         b-save
     3238         b-del-sec
     3239         f-mouth
     3240         f-a-b-tarir
     3241         f-certif-fuel f-norm-doc f-num-passport f-validity-certif f-list-tank r-list-tank
     3242         f-date-pov-plotn b-choose-date-pov-plotn f-passport-plotn f-num-plotn
     3243         f-cli-qnty
     3244         f-doc-qnty
     3245         f-doc-dens
     3246         f-kol-prob
     3247         f-num-print-prob
     3248         f-date-prob
     3249         f-hour-prob
     3250         f-min-prob
     3251         f-ttn-temp
     3252         f-acc-ship
     3253         f-EU-weight
     3254         f-loss-norm
     3255         with frame Dialog-Frame.
     3256     end.
     3257     assign
     3258       f-size:fgcolor = 12 when f-size:sensitive
     3259       f-doc-dens:fgcolor = 12 when f-doc-dens:sensitive
     3260       f-tank-vol:fgcolor = 12 when f-tank-vol:sensitive
     3261       f-car-vol:fgcolor = 12 when f-car-vol:sensitive
     3262       f-tank-density:fgcolor = 12 when f-tank-density:sensitive
     3263       f-tank-weight:fgcolor = 12 when f-tank-weight:sensitive
     3264       f-sec-num:fgcolor = 12 when f-sec-num:sensitive
     3265       f-place-si:fgcolor = 12 when f-place-si:sensitive and rdc-dnstvalue = "pomi-rn"
     3266       f-tank-temp:fgcolor = 12 when f-tank-temp:sensitive and rdc-dnstvalue = "pomi-rn"
     3267       f-dens-temp:fgcolor = 12 when f-dens-temp:sensitive and rdc-dnstvalue = "pomi-rn"
     3268       f-tank-density-pomi:fgcolor = 12 when f-tank-density-pomi:sensitive
     3269       f-tank-vol-pomi:fgcolor = 12 when f-tank-vol-pomi:sensitive
     3270     .
     3271     assign
     3272       f-size:screen-value = "0" when f-size:screen-value = "".
     3273   end procedure.
     3274   PROCEDURE initialize-section :
     3275   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     3276   display RECT-3 RECT-1 RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2 f-certif-fuel f-text3 f-validity-certif b-copy-pass f-a-b-tarir f-mouth f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp f-list-tank r-list-tank f-place-si r-sr-izm f-num-plotn f-date-pov-plotn b-copy-iz b-choose-date-pov-plotn f-passport-plotn f-tank-weight f-tank-density-pomi b-calc f-acc-weight f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob f-min-prob f-date-prob f-place-si-name f-EU-weight f-acc-ship f-loss-norm with frame Dialog-Frame.
     3277     hide f-car-vol-total f-tank-weight-total f-tank-vol-total f-doc-qnty-total in frame Dialog-Frame.
     3278     if v-page-current  = infoSectionTotal:SectionNum + 1 and (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then do:
     3279       v-section-names = "".
     3280       infoSectionTotal:NewSection().
     3281       do ii = 1 to infoSectionTotal:SectionNum:
     3282         v-section-names = v-section-names + "|" + 'Секция - ' + if infoSectionTotal:GetInfoSectionProp(ii):SectionName = "" then string (ii) else infoSectionTotal:GetInfoSectionProp(ii):SectionName.
     3283       end.
     3284       if infoSectionTotal:FlagTrn
     3285         then v-section-names = trim (v-section-names, "|") + (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then "|         +" else "") + "|Сумма".
     3286         else v-section-names = trim (v-section-names, "|") + (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then "|         +" else "").
     3287       run initialize-folder (v-section-names).
     3288       run show-current-page(input infoSectionTotal:SectionNum).
     3289       run hide-disp-page.
     3290     end.
     3291     if v-page-current  = (infoSectionTotal:SectionNum + 2 - (if (p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ДОБАВЛЕНИЕ':U) and infoSectionTotal:SectionNum < maxSec then 0 else 1)) then do:
     3292       hide RECT-3 RECT-1 RECT-4 RECT-5 RECT-6 RECT-8 RECT-7 f-sec-num f-ttn-temp f-doc-qnty f-doc-dens f-cli-qnty f-size f-car-vol f-num-passport f-text1 f-norm-doc f-text2 f-certif-fuel f-text3 f-validity-certif b-copy-pass f-a-b-tarir f-mouth f-tank-water f-tank-vol f-tank-temp f-tank-density f-dens-temp f-list-tank r-list-tank f-place-si r-sr-izm f-num-plotn f-date-pov-plotn b-copy-iz b-choose-date-pov-plotn f-passport-plotn f-tank-weight f-tank-density-pomi b-calc f-acc-weight f-tank-vol-pomi f-date-start f-hour-start f-min-start f-date-end f-hour-end f-min-end f-tests f-num-print-prob f-kol-prob f-hour-prob f-min-prob f-date-prob f-place-si-name f-EU-weight f-acc-ship f-loss-norm in frame Dialog-Frame.
     3293       infoSectionTotal:CalculateTotal().
     3294       run check-data no-error.
     3295       assign
     3296         f-car-vol-total = infoSectionTotal:CarVolTotal
     3297         f-tank-vol-total = infoSectionTotal:TankVolTotal
     3298         f-tank-weight-total = infoSectionTotal:TankWeightTotal
     3299         f-doc-qnty-total = infoSectionTotal:DocQntyTotal.
     3300       display f-car-vol-total f-tank-weight-total f-tank-vol-total f-doc-qnty-total with frame Dialog-Frame.
     3301     end.
     3302     else do:
     3303       assign
     3304         f-tests = infoSectionTotal:GetInfoSectionProp(v-page-current):Tests
     3305         f-sec-num = infoSectionTotal:GetInfoSectionProp(v-page-current):SectionName
     3306         f-ttn-temp = infoSectionTotal:GetInfoSectionProp(v-page-current):TTNTemp
     3307         f-num-print-prob = infoSectionTotal:GetInfoSectionProp(v-page-current):NumPrintProb
     3308         f-kol-prob = infoSectionTotal:GetInfoSectionProp(v-page-current):KolProb
     3309         f-date-prob = infoSectionTotal:GetInfoSectionProp(v-page-current):DateProb
     3310         f-hour-prob = infoSectionTotal:GetInfoSectionProp(v-page-current):HourProb
     3311         f-min-prob = infoSectionTotal:GetInfoSectionProp(v-page-current):MinProb
     3312         f-EU-weight = infoSectionTotal:GetInfoSectionProp(v-page-current):NaturalLoss
     3313       .
     3314       assign
     3315         f-car-vol = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):CarVol) no-error
     3316       .
     3317       f-car-vol:screen-value = string (infoSectionTotal:GetInfoSectionProp(v-page-current):CarVol) no-error.
     3318       assign
     3319         f-certif-fuel = infoSectionTotal:GetInfoSectionProp(v-page-current):CertifFuel
     3320         f-norm-doc = infoSectionTotal:GetInfoSectionProp(v-page-current):NormDoc
     3321         f-num-passport = infoSectionTotal:GetInfoSectionProp(v-page-current):NumPassport
     3322         f-validity-certif = infoSectionTotal:GetInfoSectionProp(v-page-current):ValidityCertif
     3323         f-list-tank = infoSectionTotal:GetInfoSectionProp(v-page-current):ListTank
     3324         f-num-plotn = infoSectionTotal:GetInfoSectionProp(v-page-current):NumPlotn
     3325         f-date-pov-plotn = infoSectionTotal:GetInfoSectionProp(v-page-current):DatePovPlotn
     3326         f-passport-plotn = infoSectionTotal:GetInfoSectionProp(v-page-current):PassportPlotn
     3327         f-validity-certif = infoSectionTotal:GetInfoSectionProp(v-page-current):ValidityCertif
     3328         f-acc-ship = infoSectionTotal:GetInfoSectionProp(v-page-current):AccShip
     3329         f-loss-norm = infoSectionTotal:GetInfoSectionProp(v-page-current):TPNorm
     3330       .
     3331       if error-status:error then
     3332         message "Неверно задан объем автоцистерны по паспорту " infoSectionTotal:GetInfoSectionProp(v-page-current):CarVol " ."
     3333         view-as alert-box error.
     3334       assign
     3335       f-tank-vol  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankVol) no-error.
     3336       if error-status:error then
     3337         message "Неверно определен объем в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankVol " . "
     3338         view-as alert-box.
     3339       assign
     3340       f-tank-temp  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankTemp) no-error.
     3341       if error-status:error then
     3342         message "Неверно определена температура в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankTemp " . "
     3343         view-as alert-box.
     3344       assign
     3345       f-tank-water  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankWater) no-error.
     3346       if error-status:error then
     3347         message "Неверно определен объем воды в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankWater " . "
     3348         view-as alert-box.
     3349       assign
     3350       f-tank-density  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensity) no-error.
     3351       if error-status:error then
     3352         message "Неверно определена плотность в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensity " . "
     3353         view-as alert-box.
     3354       assign
     3355       f-tank-weight  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankWeight) no-error.
     3356       if error-status:error then
     3357         message "Неверно определен вес в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankWeight " . "
     3358         view-as alert-box.
     3359       if rdc-dnstvalue = "pomi-rn"
     3360       then do:
     3361         f-acc-weight  = round (decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):AccPomi), 3) no-error.
     3362         if error-status:error then
     3363           message "Неверно определена погрешнность измерения массы в библиотекие для работы с ПО МИ " infoSectionTotal:GetInfoSectionProp(v-page-current):AccPomi " . "
     3364           view-as alert-box.
     3365       end.
     3366       if infoSectionTotal:GetInfoSectionProp(v-page-current):DateStart = ? then f-date-start = infoSectionTotal:GetInfoSectionProp(1):DateStart .
     3367       else f-date-start = infoSectionTotal:GetInfoSectionProp(v-page-current):DateStart .
     3368       if infoSectionTotal:GetInfoSectionProp(v-page-current):DateEnd = ? then f-date-end = infoSectionTotal:GetInfoSectionProp(1):DateEnd .
     3369       else f-date-end = infoSectionTotal:GetInfoSectionProp(v-page-current):DateEnd .
     3370       if infoSectionTotal:GetInfoSectionProp(v-page-current):TimeStart = 0 then
     3371       do:
     3372           f-hour-start = integer( truncate( infoSectionTotal:GetInfoSectionProp(1):TimeStart / 3600 , 0 ) ).
     3373           f-min-start  = integer( ( infoSectionTotal:GetInfoSectionProp(1):TimeStart - f-hour-start * 3600 ) / 60 ).
     3374       end.
     3375       else
     3376       do:
     3377           f-hour-start = integer( truncate( infoSectionTotal:GetInfoSectionProp(1):TimeStart / 3600 , 0 ) ).
     3378           f-min-start  = integer( ( infoSectionTotal:GetInfoSectionProp(1):TimeStart - f-hour-start * 3600 ) / 60 ).
     3379       end.
     3380       if infoSectionTotal:GetInfoSectionProp(v-page-current):TimeEnd = 0 then
     3381       do:
     3382           f-hour-end   = integer( truncate( infoSectionTotal:GetInfoSectionProp(1):TimeEnd / 3600 , 0 ) ).
     3383           f-min-end    = integer( ( infoSectionTotal:GetInfoSectionProp(1):TimeEnd - f-hour-end * 3600 ) / 60).
     3384       end.
     3385       else
     3386       do:
     3387           f-hour-end   = integer( truncate( infoSectionTotal:GetInfoSectionProp(1):TimeEnd / 3600 , 0 ) ).
     3388           f-min-end    = integer( ( infoSectionTotal:GetInfoSectionProp(1):TimeEnd - f-hour-end * 3600 ) / 60).
     3389       end.
     3390       assign
     3391         f-mouth = decimal (infoSectionTotal:GetInfoSectionProp(v-page-current):Mouth) no-error.
     3392       if error-status:error then
     3393         message "Неверно определен объем топлива в горловине " infoSectionTotal:GetInfoSectionProp(v-page-current):Mouth " . "
     3394         view-as alert-box.
     3395       assign
     3396       f-a-b-tarir  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):ABTarir) no-error.
     3397       if error-status:error then
     3398         message "Неверно определен уровень цистерны относительно тарировочной планки " infoSectionTotal:GetInfoSectionProp(v-page-current):ABTarir " . "
     3399         view-as alert-box.
     3400       assign
     3401       f-size = infoSectionTotal:GetInfoSectionProp(v-page-current):Diameter no-error.
     3402       if error-status:error then
     3403         message "Неверно определен внутренний диаметр горловины" infoSectionTotal:GetInfoSectionProp(v-page-current):Diameter " . "
     3404         view-as alert-box.
     3405       f-size:screen-value = string (infoSectionTotal:GetInfoSectionProp(v-page-current):Diameter) no-error.
     3406       assign
     3407       f-place-si = integer(infoSectionTotal:GetInfoSectionProp(v-page-current):PlaceSi) no-error.
     3408       if error-status:error then
     3409         message "Неверно определено средство измерения" infoSectionTotal:GetInfoSectionProp(v-page-current):PlaceSi " . "
     3410         view-as alert-box.
     3411       f-tank-density-pomi = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensityPomi) no-error.
     3412       if error-status:error then
     3413         message "Неверно определена приведенная плотность" infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensityPomi " . "
     3414         view-as alert-box.
     3415       assign
     3416       f-tank-vol-pomi  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):TankVolPomi) no-error.
     3417       if error-status:error then
     3418         message "Неверно определен объем в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankVolPomi " . "
     3419         view-as alert-box.
     3420       assign
     3421       f-dens-temp  = decimal(infoSectionTotal:GetInfoSectionProp(v-page-current):DensTemp) no-error.
     3422       if error-status:error then
     3423         message "Неверно определена температура в цистерне " infoSectionTotal:GetInfoSectionProp(v-page-current):TankTemp " . "
     3424         view-as alert-box.
     3425       assign
     3426         f-doc-qnty = infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty
     3427         f-doc-dens = infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity
     3428         f-cli-qnty = infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty
     3429       no-error.
     3430       find first buf_sr-izmerenia where buf_sr-izmerenia.node-code = f-place-si no-error.
     3431       if available buf_sr-izmerenia then do:
     3432         assign
     3433           f-place-si-name:screen-value = buf_sr-izmerenia.sr-model
     3434           v-sr-type = buf_sr-izmerenia.sr-type-id.
     3435       end.
     3436       else
     3437         assign
     3438           f-place-si-name:screen-value = ""
     3439           v-sr-type = 0.
     3440       run hide-disp-page.
     3441     end.
     3442   end.
     3443   PROCEDURE initialize-folder :
     3444     define input parameter folder-labels as character no-undo.
     3445     define variable i             as integer   no-undo.
     3446     define variable temp-hdl      as handle    no-undo.
     3447     define variable del-hdl       as handle    no-undo.
     3448     define variable rebuild       as logical   no-undo init no.
     3449     define variable sts           as logical   no-undo.
     3450     assign
     3451       tab-type = 1 .
     3452     assign
     3453       number-of-pages = num-entries(folder-labels,'|':U).
     3454     if valid-handle(up-image) then
     3455     do:
     3456       temp-hdl = frame Dialog-Frame:HANDLE.
     3457       temp-hdl = temp-hdl:first-child.
     3458       temp-hdl = temp-hdl:first-child.
     3459       do while valid-handle(temp-hdl):
     3460         del-hdl = temp-hdl.
     3461         temp-hdl = temp-hdl:next-sibling.
     3462         if del-hdl:private-data = "Tab-Folder":U then delete widget del-hdl.
     3463       end.
     3464     end.
     3465     create image up-image
     3466       assign
     3467       frame             = frame Dialog-Frame:HANDLE
     3468       x                 = 0 + pos-x
     3469       y                 = 0 + pos-y
     3470       width-pixel       = width-tab-values[tab-type]
     3471       height-pixel      = 25 + 4
     3472       private-data      = "Tab-Folder":U
     3473       hidden            = no.
     3474     assign
     3475       sts = up-image:load-image("adeicon/ts-up":U +
     3476            STRING(width-tab-values[tab-type])).
     3477     do i = 1 to number-of-pages:
     3478       if entry(i,folder-labels,'|':U) ne "":U then
     3479         run create-folder-label (i, entry(i, folder-labels,'|':U)).
     3480     end.
     3481     view frame Dialog-Frame.
     3482     run change-folder-page.
     3483     return.
     3484   end procedure.
     3485   PROCEDURE change-folder-page :
     3486     define variable sts   as logical no-undo.
     3487     define variable page# as integer no-undo.
     3488     if page# > 0 and page# <= 20 and
     3489       VALID-HANDLE (page-label[page#]) then
     3490     do:
     3491       assign
     3492         up-image:x      = page-label[page#]:x -  9
     3493         up-image:y      = page-label[page#]:y -  4
     3494         up-image:hidden = no
     3495         sts             = up-image:move-to-top().
     3496     end.
     3497     return.
     3498   end procedure.
     3499   PROCEDURE create-folder-label :
     3500     define input parameter p-page#        as integer   no-undo.
     3501     define input parameter p-page-label   as character no-undo.
     3502     define variable sts as log no-undo.
     3503     create image image-hdl[p-page#]
     3504       assign
     3505       frame             = frame Dialog-Frame:HANDLE
     3506       x                 = (p-page# - 1) * width-tab-values[tab-type] + pos-x
     3507       y                 = 2 + pos-y
     3508       width-pixel       = width-tab-values[tab-type]
     3509       height-pixel      = 25
     3510       private-data      = "Tab-Folder":U
     3511       sensitive         = yes
     3512       triggers:
     3513         on mouse-select-click
     3514           persistent run label-trigger in THIS-PROCEDURE (p-page#).
     3515       end triggers.
     3516     create text page-label[p-page#]
     3517       assign
     3518       frame             = frame Dialog-Frame:HANDLE
     3519       y                 = image-hdl[p-page#]:y + 2
     3520       x                 = image-hdl[p-page#]:x + 9
     3521       width-pixel       = image-hdl[p-page#]:WIDTH-PIXEL - 18
     3522       height-pixel      = image-hdl[p-page#]:HEIGHT-PIXEL - 4
     3523       format            = "X(13)":U
     3524       sensitive         = yes
     3525       font              = if tab-type = 1 then ? else 4
     3526       bgcolor           = 8
     3527       screen-value      = p-page-label
     3528       private-data      = "Tab-Folder":U
     3529       triggers:
     3530         on mouse-select-click
     3531           persistent run label-trigger in THIS-PROCEDURE (p-page#).
     3532       end triggers.
     3533     assign
     3534       sts = image-hdl[p-page#]:load-image("adeicon/ts-dn":U +
     3535                   STRING(width-tab-values[tab-type])).
     3536     sts = image-hdl[p-page#]:move-to-top().
     3537     sts = page-label[p-page#]:move-to-top().
     3538     assign
     3539       page-enabled[p-page#]      = yes
     3540       image-hdl[p-page#]:hidden  = no
     3541       page-label[p-page#]:hidden = no.
     3542     return.
     3543   end procedure.
     3544   PROCEDURE create-folder-page :
     3545     define input parameter p-page#      as integer   no-undo.
     3546     define input parameter p-new-label  as character no-undo.
     3547     define variable i          as integer   no-undo.
     3548     define variable num-labels as integer   no-undo.
     3549     define variable labels     as character no-undo.
     3550     define variable new-labels as character no-undo init "".
     3551     run get-attribute ('FOLDER-LABELS':U).
     3552     assign
     3553       labels = return-value.
     3554     if labels = ? then labels = "".
     3555     num-labels = num-entries(labels,'|':U).
     3556     if p-page# <= num-labels then
     3557     do i = 1 to num-labels:
     3558       new-labels = new-labels +
     3559         if i = p-page# then p-new-label
     3560         else entry(i, labels, '|':U).
     3561       if i < num-labels then new-labels = new-labels + '|':U.
     3562     end.
     3563     else
     3564     do:
     3565       new-labels = labels.
     3566       do i = 1 to p-page# - num-labels - if num-labels = 0 then 1 else 0:
     3567         new-labels = new-labels + '|':U.
     3568       end.
     3569       new-labels = new-labels + p-new-label.
     3570     end.
     3571     run set-attribute-list in THIS-PROCEDURE
     3572       ('FOLDER-LABELS = ':U + new-labels).
     3573     run initialize-folder.
     3574     return.
     3575   end procedure.
     3576   PROCEDURE delete-folder-page :
     3577     define input parameter p-page#  as integer no-undo.
     3578     define variable i      as integer   no-undo.
     3579     define variable pos1   as integer   no-undo init 0.
     3580     define variable pos2   as integer   no-undo.
     3581     define variable labels as character no-undo.
     3582     run get-attribute ('FOLDER-LABELS':U).
     3583     assign
     3584       labels = return-value.
     3585     if valid-handle (page-label[p-page#]) then
     3586       delete widget page-label[p-page#].
     3587     if valid-handle (image-hdl[p-page#]) then
     3588       delete widget image-hdl[p-page#].
     3589     do i = 1 to p-page# - 1:
     3590       pos1 = index(labels,'|':U, pos1 + 1).
     3591     end.
     3592     pos2 = index(labels,'|':U, pos1 + 1).
     3593     labels = if pos2 ne 0 then SUBSTR(labels, 1, pos1, "CHARACTER":U) +
     3594       SUBSTR(labels, pos2, -1, "CHARACTER":U)
     3595       else SUBSTR(labels, 1, pos1 - 1, "CHARACTER":U).
     3596     run set-attribute-list in THIS-PROCEDURE
     3597       ('FOLDER-LABELS = ':U + labels).
     3598     return.
     3599   end procedure.
     3600   PROCEDURE disable-folder-page :
     3601     define input parameter p-page#  as integer no-undo.
     3602     assign
     3603       page-enabled[p-page#]       = no
     3604       page-label[p-page#]:fgcolor = 7.
     3605     return.
     3606   end procedure.
     3607   PROCEDURE enable-folder-page :
     3608     define input parameter p-page#  as integer no-undo.
     3609     assign
     3610       page-enabled[p-page#]       = yes
     3611       page-label[p-page#]:fgcolor = ?.
     3612     return.
     3613   end procedure.
     3614   PROCEDURE label-trigger :
     3615     define input parameter p-page# as integer no-undo.
     3616     v-page = p-page#.
     3617     run trg-folder in this-procedure no-error.
     3618     if error-status:error
     3619       then return.
     3620     run show-current-page(input p-page#).
     3621     return.
     3622   end procedure.
     3623   PROCEDURE local-initialize :
     3624     run initialize-folder.
     3625     run dispatch in THIS-PROCEDURE ('initialize':U).
     3626     return.
     3627   end procedure.
     3628   PROCEDURE set-size :
     3629     define input parameter p-height as decimal no-undo.
     3630     define input parameter p-width  as decimal no-undo.
     3631     define variable sts as logical.
     3632     if p-height < 1.35 then p-height = 1.35.
     3633     do with frame Dialog-Frame:
     3634       assign
     3635         Rect-Main:X               = 0 + pos-x
     3636         Rect-Main:Y               = 25 + pos-y
     3637         Rect-Main:WIDTH-PIXELS    = p-width
     3638         Rect-Main:HEIGHT-PIXELS   = p-height
     3639                                        - 25
     3640         Rect-Top:X                = 1 + pos-x
     3641         Rect-Top:Y                = 25 + 1 + pos-y
     3642         Rect-Top:WIDTH-PIXELS     = p-width
     3643                                        - 3
     3644         Rect-Top:HEIGHT-PIXELS    = 3
     3645         Rect-Bottom:X             = 1 + pos-x
     3646         Rect-Bottom:Y             = p-height - 4 + pos-y
     3647         Rect-Bottom:HEIGHT-PIXELS = 3
     3648         Rect-Bottom:WIDTH-PIXELS  = p-width
     3649                                        - 2
     3650         Rect-Left:X               = 1 + pos-x
     3651         Rect-Left:Y               = 25 + 1 + pos-y
     3652         Rect-Left:WIDTH-PIXELS    = 3
     3653         Rect-Left:HEIGHT-PIXELS   = p-height
     3654                                        - 25 - 2
     3655         Rect-Right:X              = p-width + pos-x
     3656                                        - 4
     3657         Rect-Right:Y              = 25 + 4 + pos-y
     3658         Rect-Right:WIDTH-PIXELS   = 3
     3659         Rect-Right:HEIGHT-PIXELS  = p-height
     3660                                        - 25 - 5
     3661         Rect-Main:HIDDEN          = no
     3662         Rect-Top:HIDDEN           = no
     3663         Rect-Bottom:HIDDEN        = no
     3664         Rect-Left:HIDDEN          = no
     3665         Rect-Right:HIDDEN         = no.
     3666     end.
     3667     return.
     3668   end procedure.
     3669   PROCEDURE show-current-page :
     3670     define input parameter page# as integer no-undo.
     3671     define variable sts as logical no-undo.
     3672     if page# > 0 and page# <= 20 and
     3673       VALID-HANDLE (page-label[page#])
     3674       then assign
     3675         up-image:x      = page-label[page#]:x -  9
     3676         up-image:y      = page-label[page#]:y -  4
     3677         up-image:hidden = no
     3678         sts             = up-image:move-to-top().
     3679     else if number-of-pages > 0 then
     3680         assign up-image:hidden = yes.
     3681   end procedure.
     3682   PROCEDURE state-changed :
     3683     define input parameter p-issuer-hdl as handle no-undo.
     3684     define input parameter p-state as character no-undo.
     3685   end procedure.
     3686   PROCEDURE trg-folder :
     3687   apply "leave" to f-sec-num in frame Dialog-Frame.
     3688     if v-page-current <= infoSectionTotal:SectionNum
     3689     then do:
     3690       run check-page no-error.
     3691       if error-status:error then do:
     3692         return error.
     3693       end.
     3694       run save-page.
     3695       apply "LEAVE":U to f-car-vol      in frame Dialog-Frame .
     3696       apply "LEAVE":U to f-tank-density in frame Dialog-Frame .
     3697       run calc-doc.
     3698     end.
     3699     v-page-current = v-page.
     3700     run initialize-section.
     3701   end.
     3702   procedure save-page:
     3703     if v-page-current > infoSectionTotal:SectionNum then return.
     3704     assign frame Dialog-Frame
     3705       f-sec-num f-tests f-doc-qnty f-doc-dens f-cli-qnty f-car-vol f-size
     3706       f-num-passport f-norm-doc f-certif-fuel f-validity-certif f-list-tank
     3707       f-a-b-tarir f-mouth f-tank-water f-tank-temp f-tank-density f-dens-temp
     3708       f-num-plotn f-date-pov-plotn f-date-start f-hour-start f-min-start
     3709       f-date-end f-hour-end f-min-end
     3710       f-doc-qnty f-doc-dens f-cli-qnty
     3711       f-passport-plotn f-num-plotn f-place-si
     3712       f-num-print-prob f-kol-prob f-date-prob f-hour-prob f-min-prob f-ttn-temp f-acc-ship f-EU-weight f-loss-norm
     3713     .
     3714     assign
     3715       infoSectionTotal:GetInfoSectionProp(v-page-current):CarVol = f-car-vol
     3716       infoSectionTotal:GetInfoSectionProp(v-page-current):Tests  = f-tests
     3717       infoSectionTotal:GetInfoSectionProp(v-page-current):SectionName  = f-sec-num
     3718       infoSectionTotal:GetInfoSectionProp(v-page-current):DocQnty  = f-doc-qnty
     3719       infoSectionTotal:GetInfoSectionProp(v-page-current):CliQnty  = f-cli-qnty
     3720       infoSectionTotal:GetInfoSectionProp(v-page-current):DocDensity  = f-doc-dens
     3721       infoSectionTotal:GetInfoSectionProp(v-page-current):TimeStart = f-hour-start * 3600 + f-min-start * 60
     3722       infoSectionTotal:GetInfoSectionProp(v-page-current):TimeEnd = f-hour-end   * 3600 + f-min-end   * 60
     3723       infoSectionTotal:GetInfoSectionProp(v-page-current):DateStart = f-date-start
     3724       infoSectionTotal:GetInfoSectionProp(v-page-current):DateEnd = f-date-end
     3725       infoSectionTotal:GetInfoSectionProp(v-page-current):Mouth =  f-mouth
     3726       infoSectionTotal:GetInfoSectionProp(v-page-current):TankVol = f-tank-vol
     3727       infoSectionTotal:GetInfoSectionProp(v-page-current):TankTemp = f-tank-temp
     3728       infoSectionTotal:GetInfoSectionProp(v-page-current):TankVolPomi = f-tank-vol-pomi
     3729       infoSectionTotal:GetInfoSectionProp(v-page-current):DensTemp =  f-dens-temp
     3730       infoSectionTotal:GetInfoSectionProp(v-page-current):TankWater = f-tank-water
     3731       infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensity = f-tank-density
     3732       infoSectionTotal:GetInfoSectionProp(v-page-current):TankWeight =  f-tank-weight
     3733       infoSectionTotal:GetInfoSectionProp(v-page-current):AccPomi =  f-acc-weight when rdc-dnstvalue = "pomi-rn"
     3734       infoSectionTotal:GetInfoSectionProp(v-page-current):ABTarir = f-a-b-tarir
     3735       infoSectionTotal:GetInfoSectionProp(v-page-current):AccShip = f-acc-ship
     3736       infoSectionTotal:GetInfoSectionProp(v-page-current):Diameter =  f-size
     3737       infoSectionTotal:GetInfoSectionProp(v-page-current):PlaceSi = f-place-si
     3738       infoSectionTotal:GetInfoSectionProp(v-page-current):TankDensityPomi = f-tank-density-pomi
     3739       infoSectionTotal:GetInfoSectionProp(v-page-current):CertifFuel = string (f-certif-fuel)
     3740       infoSectionTotal:GetInfoSectionProp(v-page-current):NormDoc = string (f-norm-doc)
     3741       infoSectionTotal:GetInfoSectionProp(v-page-current):NumPassport = string (f-num-passport)
     3742       infoSectionTotal:GetInfoSectionProp(v-page-current):ValidityCertif = string (f-validity-certif)
     3743       infoSectionTotal:GetInfoSectionProp(v-page-current):ListTank = string (f-list-tank)
     3744       infoSectionTotal:GetInfoSectionProp(v-page-current):PassportPlotn = f-passport-plotn
     3745       infoSectionTotal:GetInfoSectionProp(v-page-current):DatePovPlotn = f-date-pov-plotn
     3746       infoSectionTotal:GetInfoSectionProp(v-page-current):NumPlotn = f-num-plotn
     3747       infoSectionTotal:GetInfoSectionProp(v-page-current):NumPrintProb = f-num-print-prob
     3748       infoSectionTotal:GetInfoSectionProp(v-page-current):KolProb = f-kol-prob
     3749       infoSectionTotal:GetInfoSectionProp(v-page-current):DateProb = f-date-prob
     3750       infoSectionTotal:GetInfoSectionProp(v-page-current):HourProb = f-hour-prob
     3751       infoSectionTotal:GetInfoSectionProp(v-page-current):MinProb = f-min-prob
     3752       infoSectionTotal:GetInfoSectionProp(v-page-current):TTNTemp  = f-ttn-temp
     3753     no-error.
     3754     if infoSectionTotal:GetInfoSectionProp(v-page-current):PlaceSi <> 0 then do:
     3755       if v-sr-type = 1 or v-sr-type = 2 then do:
     3756         assign
     3757         infoSectionTotal:GetInfoSectionProp(v-page-current):NumPlotn = f-num-plotn
     3758         infoSectionTotal:GetInfoSectionProp(v-page-current):PassportPlotn = ""
     3759         infoSectionTotal:GetInfoSectionProp(v-page-current):DatePovPlotn = f-date-pov-plotn.
     3760       end.
     3761       if v-sr-type = 3 or v-sr-type = 4 then do:
     3762         assign
     3763         infoSectionTotal:GetInfoSectionProp(v-page-current):NumPlotn = f-num-plotn
     3764         infoSectionTotal:GetInfoSectionProp(v-page-current):PassportPlotn = f-passport-plotn
     3765         infoSectionTotal:GetInfoSectionProp(v-page-current):DatePovPlotn = f-date-pov-plotn.
     3766       end.
     3767     end.
     3768   end procedure.
