        1   using ibs.th.str.*.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экран просмотра дополнительной информации по приемке топлива".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define new global shared variable g#lib-calc as handle no-undo .
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      118   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      119   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      120   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      121   define variable ptrlprop-autopump      as logical   no-undo initial false .
      122   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      123   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      124   define variable ptrlprop-olddens       as logical   no-undo initial false .
      125   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      126   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      127   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      128   define variable ptrlprop-algoincome as integer no-undo init 0.
      129   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      130   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      131   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      132   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      133   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      134   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      135   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      136   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      137   define variable ptrlprop-block-nozzle as logical no-undo init false.
      138   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      139   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      140   procedure get-ptrl-prop :
      141     define input  parameter p-obj-type as character no-undo .
      142     define input  parameter p-obj-code as integer   no-undo .
      143     do
      144     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      145     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      146     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      147     :
      148       define variable par-type          as character no-undo.
      149       define variable v-value-character as character no-undo .
      150       define variable v-value-date      as date      no-undo .
      151       define variable v-value-decimal   as decimal   no-undo .
      152       define variable v-value-integer   as integer   no-undo .
      153       define variable v-value-logical   as logical   no-undo .
      154       for each thbjattr_thbj-attr
      155       :
      156         delete thbjattr_thbj-attr .
      157       end.
      158       run adm/shattri.p
      159         ( input "get":U
      160         , input p-obj-type
      161         , input p-obj-code
      162         , input 'petrol':U
      163         , input  ""
      164         , output v-value-character
      165         , output v-value-date
      166         , output v-value-decimal
      167         , output v-value-integer
      168         , output v-value-logical
      169         , output par-type
      170         , input-output table thbjattr_thbj-attr
      171         ) no-error .
      172       for each thbjattr_thbj-attr
      173       on error undo, return error return-value
      174       :
      175         case thbjattr_thbj-attr.prop-code :
      176           when 'denstclc':U then do:
      177             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      178               assign
      179                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      180               .
      181             end.
      182           end.
      183           when 'expptrl':U then do:
      184             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      185               and thbjattr_thbj-attr.prop-value-type = 'character':U
      186             then do:
      187               assign
      188                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      189               .
      190             end.
      191           end.
      192           when 'inpptrl':U then do:
      193             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      194               and thbjattr_thbj-attr.prop-value-type = 'character':U
      195             then do:
      196               assign
      197                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      198               .
      199             end.
      200           end.
      201           when 'autopump':U then do:
      202             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      203               assign
      204                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      205               .
      206             end.
      207           end.
      208           when 'rvsnmter':U then do:
      209             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      210               assign
      211                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      212               .
      213             end.
      214           end.
      215           when 'avtinvpm':U then do:
      216             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      217               assign
      218                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      219               .
      220             end.
      221           end.
      222           when 'invclipt':U then do:
      223             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      224               assign
      225                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      226               .
      227             end.
      228           end.
      229           when 'olddens':U then do:
      230             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      231               assign
      232                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      233               .
      234             end.
      235           end.
      236           when 'algrvspt':U then do:
      237             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      238               assign
      239                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      240               .
      241             end.
      242           end.
      243           when 'temp-for-pomi':U then do:
      244             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      245               assign
      246                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      247               .
      248             end.
      249           end.
      250           when 'algoincome':U then do:
      251             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      252               assign
      253                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      254               .
      255             end.
      256           end.
      257           when 'mand-choice-autocar':U then do:
      258             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      259               assign
      260                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      261               .
      262             end.
      263           end.
      264           when 'block-nozzle':U then do:
      265             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      266               assign
      267                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      268               .
      269             end.
      270           end.
      271           when 'timeout-block-nozzle':U then do:
      272             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      273               assign
      274                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      275               .
      276             end.
      277           end.
      278           when 'Delta-mass-horiz':U then do:
      279             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      280               assign
      281                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      282               .
      283             end.
      284           end.
      285           when 'Delta-mass-vert':U then do:
      286             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      287               assign
      288                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      289               .
      290             end.
      291           end.
      292           when 'calc-free-vol':U then do:
      293             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      294               assign
      295                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      296               .
      297             end.
      298           end.
      299           when 'calc-free-vol-sug':U then do:
      300             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      301               assign
      302                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      303               .
      304             end.
      305           end.
      306           when 'trn-reas-sug':U then do:
      307             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      308               assign
      309                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      310               .
      311             end.
      312           end.
      313                 when 'rvd-own-nb':U then do:
      314             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      315               assign
      316                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      317               .
      318             end.
      319           end.
      320           when 'qr-scan-time':U then do:
      321             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      322               assign
      323                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      324               .
      325             end.
      326           end.
      327           when 'autopump-skip-time':U then do:
      328             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      329               assign
      330                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      331               .
      332             end.
      333           end.
      334         end case.
      335         delete thbjattr_thbj-attr .
      336       end.
      337     end.
      338     return .
      339   end procedure.
      340   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   procedure cur-time :
      342      define output parameter p-today as date      no-undo .
      343      define output parameter p-time  as integer   no-undo .
      344     do
      345     on error undo, return error
      346     :
      347       define variable v-date1 as date      no-undo .
      348       define variable v-date2 as date      no-undo .
      349       define variable v-time  as integer   no-undo .
      350       assign
      351         v-date1 = today
      352         v-time  = time
      353         v-date2 = today
      354       .
      355       if v-date1 <> v-date2
      356       then do:
      357         assign
      358           v-date1 = today
      359           v-time  = v-time
      360         .
      361       end.
      362       assign
      363         p-today = v-date1
      364         p-time  = v-time
      365       .
      366     end.
      367   end.
      368   function cur-time-date returns character
      369   :
      370     return string(today, '99/99/9999':U) .
      371   end.
      372   function cur-time-mjd returns decimal
      373   :
      374     define variable v-date as date      no-undo .
      375     define variable v-time as integer   no-undo .
      376     run cur-time in this-procedure
      377       (output v-date
      378       ,output v-time
      379       ) .
      380     return integer(v-date) - 2400002 + (v-time / 86400) .
      381   end.
      382   function cur-time-get-ending-index returns integer
      383   (input p-number as integer
      384   )
      385   :
      386     if p-number < 0
      387     or p-number = ?
      388     then do:
      389       return 1 .
      390     end.
      391     define variable v-rest as integer   no-undo .
      392     assign
      393       p-number = p-number modulo 100
      394     .
      395     if p-number < 20
      396     then do:
      397       assign
      398         v-rest = p-number
      399       .
      400     end.
      401     else do:
      402       assign
      403         v-rest = p-number modulo 10
      404       .
      405     end.
      406     case v-rest :
      407       when 1
      408       then do:
      409         return 2 .
      410       end.
      411       when 2 or
      412       when 3 or
      413       when 4
      414       then do:
      415         return 3 .
      416       end.
      417       otherwise do:
      418         return 1 .
      419       end.
      420     end case .
      421   end.
      422   procedure cur-time-mjd-to-date :
      423      define input  parameter i-mjd-diff as decimal no-undo.
      424      define output parameter o-Date     as date    no-undo.
      425      define output parameter o-Time     as integer no-undo.
      426      define variable v-day-number as integer   no-undo .
      427      if    i-mjd-diff < 0
      428         or i-mjd-diff = ?
      429      then do:
      430         return "?" .
      431      end.
      432      assign
      433         v-day-number = truncate(i-mjd-diff,0).
      434         o-Date = date(v-day-number + 2400002).
      435         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      436     .
      437   end.
      438   function cur-time-mjd-to-string returns character
      439   (input p-mjd-diff as decimal
      440   )
      441   :
      442     define variable v-day-number as integer   no-undo .
      443     define variable v-seconds    as integer   no-undo .
      444     define variable v-hour       as integer   no-undo .
      445     define variable v-min        as integer   no-undo .
      446     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      447     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      448     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      449     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      450     if p-mjd-diff < 0
      451     or p-mjd-diff = ?
      452     then do:
      453       return "?" .
      454     end.
      455     assign
      456       v-day-number = integer(truncate(p-mjd-diff,0))
      457       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      458     .
      459     if v-seconds > 86400
      460     then do:
      461       assign
      462         v-seconds = 86400 - 1
      463       .
      464     end.
      465     if v-seconds < 0
      466     then do:
      467       assign
      468         v-seconds = 0
      469       .
      470     end.
      471     assign
      472       v-hour = truncate(v-seconds / 3600, 0)
      473     .
      474     assign
      475       v-seconds = v-seconds modulo 3600
      476     .
      477     assign
      478       v-min = truncate(v-seconds / 60, 0)
      479     .
      480     assign
      481       v-seconds = v-seconds modulo 60
      482     .
      483     return
      484         (if v-day-number <> 0
      485           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      486           else ""
      487         )
      488       + (if v-day-number <> 0 or v-hour <> 0
      489           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      490           else ""
      491         )
      492       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      493           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      494           else ""
      495         )
      496       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      497       .
      498   end.
      499   function cur-time-string returns character
      500   :
      501     define variable v-date as date      no-undo .
      502     define variable v-time as integer   no-undo .
      503     run cur-time in this-procedure
      504       (output v-date
      505       ,output v-time
      506       ) .
      507     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      508   end.
      509   function cur-time-string-sec returns character
      510   :
      511     define variable v-date as date      no-undo .
      512     define variable v-time as integer   no-undo .
      513     run cur-time in this-procedure
      514       (output v-date
      515       ,output v-time
      516       ) .
      517     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      518   end.
      519   function cur-time-custom  returns character
      520   (input p-prefix as character
      521   ,input p-date-format as character
      522   ,input p-delimiter as character
      523   ,input p-time-format as character
      524   ,input p-suffix as character
      525   )
      526   :
      527     define variable v-date as date      no-undo .
      528     define variable v-time as integer   no-undo .
      529     run cur-time in this-procedure
      530       (output v-date
      531       ,output v-time
      532       ) .
      533     return
      534       p-prefix
      535       + string(v-date, p-date-format)
      536       + p-delimiter
      537       + string(v-time, p-time-format)
      538       + p-suffix
      539       .
      540   end.
      541   function cur-time-print  returns character
      542   :
      543     define variable v-date as date      no-undo .
      544     define variable v-time as integer   no-undo .
      545     run cur-time in this-procedure
      546       (output v-date
      547       ,output v-time
      548       ) .
      549     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      550   end.
      551   function cur-time-datetime returns datetime
      552   :
      553     define variable v-char as character no-undo .
      554     define variable v-datetime as datetime no-undo .
      555     v-char = cur-time-string().
      556     v-datetime = datetime(v-char).
      557     return  v-datetime.
      558   end.
      559   function cur-time-string-msec returns character
      560   :
      561     define variable v-date as datetime  no-undo .
      562     v-date = now.
      563     return string(v-date) .
      564   end.
