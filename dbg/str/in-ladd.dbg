     1587        EDGE-PIXELS 0
     1588        SIZE 33.63 BY .17
     1589        BGCOLOR 15 .
     1590   DEFINE FRAME Dialog-Frame
     1591        b-save AT ROW 1 COL 2
     1592        b-quit AT ROW 1 COL 12
     1593        b-del-sec AT ROW 1 COL 21.88 WIDGET-ID 88
     1594        b-help AT ROW 1 COL 87.38
     1595        f-sec-num AT ROW 3.75 COL 16.25 COLON-ALIGNED WIDGET-ID 84
     1596        f-car-vol-total AT ROW 3.75 COL 31.13 COLON-ALIGNED WIDGET-ID 90
     1597        f-ttn-temp AT ROW 3.79 COL 53.5 COLON-ALIGNED WIDGET-ID 132
     1598        f-doc-qnty AT ROW 3.79 COL 80.5 COLON-ALIGNED WIDGET-ID 86
     1599        f-doc-dens AT ROW 4.96 COL 21.25 COLON-ALIGNED WIDGET-ID 106
     1600        f-tank-weight-total AT ROW 4.96 COL 31.13 COLON-ALIGNED WIDGET-ID 92
     1601        f-acc-ship AT ROW 4.96 COL 53.5 COLON-ALIGNED WIDGET-ID 140
     1602        f-cli-qnty AT ROW 4.96 COL 80.5 COLON-ALIGNED WIDGET-ID 108
     1603        f-size AT ROW 6.13 COL 80.5 COLON-ALIGNED WIDGET-ID 20
     1604        f-car-vol AT ROW 6.17 COL 30.25 COLON-ALIGNED
     1605        f-tank-vol-total AT ROW 6.17 COL 31.13 COLON-ALIGNED WIDGET-ID 94
     1606        f-doc-qnty-total AT ROW 7.29 COL 31.13 COLON-ALIGNED WIDGET-ID 98
     1607        f-num-passport AT ROW 7.38 COL 22 COLON-ALIGNED WIDGET-ID 36
     1608        f-text1 AT ROW 8.29 COL 1.88 COLON-ALIGNED NO-LABEL WIDGET-ID 100 DISABLE-AUTO-ZAP
     1609        f-norm-doc AT ROW 9.33 COL 4 WIDGET-ID 38
     1610        f-text2 AT ROW 10.38 COL 1.88 COLON-ALIGNED NO-LABEL WIDGET-ID 102 DISABLE-AUTO-ZAP
     1611        f-certif-fuel AT ROW 11.46 COL 3.88 NO-LABEL WIDGET-ID 44
     1612        f-text3 AT ROW 12.42 COL 1.88 COLON-ALIGNED NO-LABEL WIDGET-ID 104 DISABLE-AUTO-ZAP
     1613        f-validity-certif AT ROW 13.5 COL 4 WIDGET-ID 50
     1614        b-copy-pass AT ROW 13.5 COL 76.75 WIDGET-ID 130
     1615        f-a-b-tarir AT ROW 14.83 COL 80 COLON-ALIGNED WIDGET-ID 2
     1616        f-mouth AT ROW 15.92 COL 22 COLON-ALIGNED
     1617        f-tank-water AT ROW 15.92 COL 80 COLON-ALIGNED
     1618        f-tank-vol AT ROW 17 COL 22 COLON-ALIGNED
     1619        f-tank-temp AT ROW 17 COL 80 COLON-ALIGNED
     1620        f-tank-density AT ROW 18.08 COL 22 COLON-ALIGNED
     1621        f-dens-temp AT ROW 18.08 COL 80 COLON-ALIGNED WIDGET-ID 26
     1622        f-EU-weight AT ROW 19.17 COL 22 COLON-ALIGNED WIDGET-ID 136
     1623        f-list-tank AT ROW 19.21 COL 48.5 COLON-ALIGNED WIDGET-ID 124
     1624        r-list-tank AT ROW 19.21 COL 93.25 WIDGET-ID 126
     1625        f-loss-norm AT ROW 20.25 COL 29 COLON-ALIGNED WIDGET-ID 138
     1626        f-place-si AT ROW 21.92 COL 22 COLON-ALIGNED WIDGET-ID 16
     1627        r-sr-izm AT ROW 21.92 COL 28.5 WIDGET-ID 18
     1628        f-num-plotn AT ROW 23.04 COL 9 COLON-ALIGNED WIDGET-ID 76
     1629        f-date-pov-plotn AT ROW 24.13 COL 16.13 COLON-ALIGNED WIDGET-ID 64
     1630        b-copy-iz AT ROW 24.13 COL 86 WIDGET-ID 22
     1631        b-choose-date-pov-plotn AT ROW 24.17 COL 29.13 WIDGET-ID 72
     1632        f-passport-plotn AT ROW 24.17 COL 52.63 COLON-ALIGNED WIDGET-ID 68
     1633        f-tank-weight AT ROW 25.5 COL 63.25 COLON-ALIGNED
     1634        f-tank-density-pomi AT ROW 25.54 COL 29 COLON-ALIGNED WIDGET-ID 24
     1635        b-calc AT ROW 26.17 COL 81.63 WIDGET-ID 80
     1636        f-acc-weight AT ROW 26.71 COL 63.25 COLON-ALIGNED WIDGET-ID 134
     1637        f-tank-vol-pomi AT ROW 26.75 COL 30 COLON-ALIGNED WIDGET-ID 28
     1638        f-date-start AT ROW 28.21 COL 21 COLON-ALIGNED
     1639        f-hour-start AT ROW 28.21 COL 88 COLON-ALIGNED
     1640        f-min-start AT ROW 28.21 COL 91.63 COLON-ALIGNED NO-LABEL
     1641        f-date-end AT ROW 29.29 COL 21 COLON-ALIGNED
     1642        f-hour-end AT ROW 29.29 COL 88 COLON-ALIGNED
     1643        f-min-end AT ROW 29.29 COL 91.63 COLON-ALIGNED NO-LABEL
     1644        f-tests AT ROW 30.83 COL 20.88 COLON-ALIGNED WIDGET-ID 118
     1645       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1646            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1647            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
     1648   DEFINE FRAME Dialog-Frame
     1649        f-num-print-prob AT ROW 30.83 COL 80.5 COLON-ALIGNED WIDGET-ID 120
     1650        f-kol-prob AT ROW 31.83 COL 20.88 COLON-ALIGNED WIDGET-ID 122
     1651        f-hour-prob AT ROW 31.96 COL 87.75 COLON-ALIGNED WIDGET-ID 114
     1652        f-min-prob AT ROW 31.96 COL 91.38 COLON-ALIGNED NO-LABEL WIDGET-ID 116
     1653        f-date-prob AT ROW 32.83 COL 20.88 COLON-ALIGNED WIDGET-ID 112
     1654        f-place-si-name AT ROW 21.92 COL 30.13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1655        Rect-Main AT ROW 8.17 COL 5.75
     1656        Rect-Bottom AT ROW 8.08 COL 3.5
     1657        Rect-Left AT ROW 1.75 COL 1.25
     1658        Rect-Right AT ROW 1.88 COL 34.25
     1659        Rect-Top AT ROW 1.71 COL 1.25
     1660        RECT-3 AT ROW 21.75 COL 3.5
     1661        RECT-1 AT ROW 3.54 COL 3.5
     1662        RECT-4 AT ROW 14.67 COL 3.5 WIDGET-ID 30
     1663        RECT-5 AT ROW 28 COL 3.5 WIDGET-ID 32
     1664        RECT-6 AT ROW 7.25 COL 3.5 WIDGET-ID 34
     1665        RECT-8 AT ROW 25.38 COL 3.5 WIDGET-ID 82
     1666        RECT-7 AT ROW 30.58 COL 3.5 WIDGET-ID 110
     1667        SPACE(1.87) SKIP(0.58)
     1668       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1669            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1670            TITLE "Дополнительная информация по приемке топлива"
     1671            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
     1672   ASSIGN
     1673          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1674          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1675   ASSIGN
     1676          b-choose-date-pov-plotn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1677   ASSIGN
     1678          f-date-pov-plotn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1679   ASSIGN
     1680          f-passport-plotn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1681   ASSIGN
     1682          f-text1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1683   ASSIGN
     1684          f-text2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1685   ASSIGN
     1686          f-text3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1687   ON go OF FRAME Dialog-Frame
     1688   do:
     1689     assign frame Dialog-Frame
     1690       f-sec-num f-tests f-doc-qnty f-doc-dens f-cli-qnty f-car-vol f-size
     1691       f-num-passport f-norm-doc f-text2 f-certif-fuel f-validity-certif
     1692       f-a-b-tarir f-mouth f-tank-water f-tank-temp f-tank-density f-dens-temp
     1693       f-num-plotn f-date-pov-plotn f-date-start f-hour-start f-min-start
     1694       f-date-end f-hour-end f-min-end
     1695       f-doc-qnty f-doc-dens f-cli-qnty
     1696       f-num-print-prob f-kol-prob f-date-prob f-hour-prob f-min-prob f-list-tank f-ttn-temp f-acc-ship f-EU-weight
     1697     .
     1698     if v-page-current <= infoSectionTotal:SectionNum
     1699     then do:
     1700       run check-page no-error.
     1701       if error-status:error then do:
     1702         return no-apply.
     1703       end.
     1704       run save-page.
     1705     end.
     1706     if p-mode <> 'ДОБАВЛЕНИЕ':U then infoSectionTotal:SaveDB().
     1707     assign
     1708       p-was-setting = yes
     1709     .
     1710   end.
     1711   ON window-close OF FRAME Dialog-Frame
     1712   do:
     1713     apply "END-ERROR":U to self.
     1714   end.
     1715   ON choose OF b-calc IN FRAME Dialog-Frame
     1716   do:
     1717     define variable ToolType                as integer no-undo.
     1718     define variable DeltaAbs_R              as decimal no-undo.
     1719     define variable DeltaAbs_Tv             as decimal no-undo.
     1720     define variable DeltaAbs_Tr             as decimal no-undo.
     1721     define variable NeckType                as integer no-undo.
     1722     define variable Dgor                    as decimal no-undo.
     1723     define variable NeckWidth               as decimal no-undo.
     1724     define variable NeckHeight              as decimal no-undo.
     1725     define variable error-string            as character no-undo.
     1726     define variable v-mm as com-handle.
     1727     define variable v-proc as character no-undo.
     1728     define buffer buf_sr-izmerenia    for ub.sr-izmerenia .
     1729     run save-page.
     1730     assign
     1731     f-car-vol
     1732     f-tank-vol
     1733     f-a-b-tarir
     1734     f-size
     1735     f-tank-temp
     1736     f-tank-density
     1737     f-dens-temp
     1738     f-place-si
     1739     .
     1740     case rdc-dnstvalue:
     1741       when "pomi-rn" then do:
     1742         _trpomi :
     1743           do on error undo, return no-apply :
     1744           find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = f-place-si no-error.
     1745           if not available buf_sr-izmerenia then do :
     1746             message
     1747               substitute( 'Не найдено средство измерения с кодом &1', f-place-si ) skip
     1748             view-as alert-box error.
     1749             undo _trpomi, return no-apply  .
     1750           end.
     1751           else do :
     1752             assign
     1753               ToolType               = buf_sr-izmerenia.sr-type-id
     1754               DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     1755               DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     1756               DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     1757               .
     1758           end.
     1759           v-proc = "Rosneft.MethodOfMetering31" .
     1760           release object v-mm no-error.
     1761           v-mm = ?.
     1762           create value("Rosneft.MethodOfMetering31") v-mm no-error.
     1763           if error-status:error
     1764           or not VALID-HANDLE(v-mm)
     1765           then do:
     1766             release object v-mm no-error.
     1767             v-mm = ?.
     1768             message
     1769               substitute( 'Не удается подключиться к COM-серверу библиотеки для работы с ПО МИ ' ) skip
     1770             view-as alert-box error.
     1771             undo _trpomi, return no-apply .
     1772           end.
     1773           else do :
     1774             if f-car-vol = ? or f-car-vol = 0 then do :
     1775               message
     1776                 "Заполнены не все поля, необходимые " skip
     1777                 "для работы библиотеки ПО МИ"         skip
     1778                 "Введите Объем по паспорту в литрах"  skip
     1779               view-as alert-box error.
     1780               apply "entry" to f-car-vol in frame Dialog-Frame .
     1781               undo _trpomi, return no-apply  .
     1782             end.
     1783             if f-a-b-tarir = ? then do :
     1784               message
     1785                 "Заполнены не все поля, необходимые " skip
     1786                 "для работы библиотеки ПО МИ"         skip
     1787                 "Введите Уровень цистерны относительно тарировочной планки"  skip
     1788               view-as alert-box error.
     1789               apply "entry" to f-a-b-tarir in frame Dialog-Frame .
     1790               undo _trpomi, return no-apply  .
     1791             end.
     1792               assign
     1793               f-size              = string (decimal (f-size))
     1794               f-size:screen-value = string (decimal (f-size))
     1795               no-error.
     1796             if error-status:error then
     1797             do:
     1798               assign
     1799                 NeckType = 1
     1800                 NeckWidth = decimal (entry (1,f-size, "/"))
     1801                 NeckHeight = decimal (entry (2,f-size, "/"))
     1802                 Dgor = 0
     1803                 no-error.
     1804             end.
     1805             else do:
     1806             assign
     1807               NeckType = 0
     1808               Dgor = decimal (f-size).
     1809             end.
     1810             if f-size = ? or f-size = "0" then do :
     1811               message
     1812                 "Заполнены не все поля, необходимые " skip
     1813                 "для работы библиотеки ПО МИ"         skip
     1814                 "Введите Внутренний диаметр горловины"  skip
     1815               view-as alert-box error.
     1816               apply "entry" to f-size in frame Dialog-Frame .
     1817               undo _trpomi, return no-apply  .
     1818             end.
     1819             if f-tank-temp = ? then do :
     1820               message
     1821                 "Заполнены не все поля, необходимые " skip
     1822                 "для работы библиотеки ПО МИ"         skip
     1823                 "Введите Температуру"  skip
     1824               view-as alert-box error.
     1825               apply "entry" to f-tank-temp in frame Dialog-Frame .
     1826               undo _trpomi, return no-apply  .
     1827             end.
     1828             if f-tank-density = ? or f-tank-density = 0 then do :
     1829               message
     1830                 "Заполнены не все поля, необходимые " skip
     1831                 "для работы библиотеки ПО МИ"         skip
     1832                 "Введите Плотность топлива для ПО МИ"  skip
     1833               view-as alert-box error.
     1834               apply "entry" to f-tank-density in frame Dialog-Frame .
     1835               undo _trpomi, return no-apply  .
     1836             end.
     1837             assign
     1838               v-mm:V_real                 = f-car-vol
     1839               v-mm:DeltaH                 = f-a-b-tarir
     1840               v-mm:Dgor                   = Dgor
     1841               v-mm:NeckType               = NeckType
     1842               v-mm:NeckWidth              = NeckWidth
     1843               v-mm:NeckHeight             = NeckHeight
     1844               v-mm:Tv                     = f-tank-temp
     1845               v-mm:Tr                     = f-dens-temp
     1846               v-mm:R                      = ( f-tank-density * 1000 )
     1847               v-mm:Tcy                    = temp-for-pomi
     1848               v-mm:ToolType               = ToolType
     1849               v-mm:A_Reservoir            = 0.0000125
     1850               v-mm:DeltaOtn_V             = 0.4
     1851               v-mm:DeltaAbs_R             = DeltaAbs_R
     1852               v-mm:DeltaAbs_Tv            = DeltaAbs_Tv
     1853               v-mm:DeltaAbs_Tr            = DeltaAbs_Tr
     1854             .
     1855             v-mm:Exec() .
     1856             output stream outstream to value ("pomi.log") append.
     1857             put stream outstream
     1858               chr(10)
     1859               "-----------------------------------------------"
     1860               chr(10)
     1861                                          now                     skip
     1862               'Номер документа:'         p-doc-code              skip
     1863               'Секция:'                  v-section-names         skip
     1864               'Процедура'                v-proc                  skip
     1865               'V_real                 =' f-car-vol               skip
     1866               'DeltaH                 =' f-a-b-tarir             skip
     1867               'Dgor                   =' Dgor                    skip
     1868               'NeckType               =' NeckType                skip
     1869               'NeckWidth              =' NeckWidth               skip
     1870               'NeckHeight             =' NeckHeight              skip
     1871               'Tv                     =' f-tank-temp             skip
     1872               'Tr                     =' f-dens-temp             skip
     1873               'R                      =' ( f-tank-density * 1000 ) skip
     1874               'Tcy                    =' temp-for-pomi           skip
     1875               'ToolType               =' ToolType                skip
     1876               'A_Reservoir            =' string (0.0000125)      skip
     1877               'DeltaOtn_V             =' 0.4                     skip
     1878               'DeltaAbs_R             =' DeltaAbs_R              skip
     1879               'DeltaAbs_Tv            =' DeltaAbs_Tv             skip
     1880               'DeltaAbs_Tr            =' DeltaAbs_Tr             skip
     1881               'Vcy                    =' v-mm:Vcy               skip
     1882               'Rcy                    =' v-mm:Rcy               skip
     1883               'V                      =' v-mm:V                 skip
     1884               'CTL_base_alt           =' v-mm:CTL_base_alt      skip
     1885               'CPL_base_alt           =' v-mm:CPL_base_alt      skip
     1886               'CTPL_base_alt          =' v-mm:CTPL_base_alt     skip
     1887               'Fp_base_alt            =' v-mm:Fp_base_alt       skip
     1888               'CTL_obs_base           =' v-mm:CTL_obs_base      skip
     1889               'CPL_obs_base           =' v-mm:CPL_obs_base      skip
     1890               'CTPL_obs_base          =' v-mm:CTPL_obs_base     skip
     1891               'Fp_obs_base            =' v-mm:Fp_obs_base       skip
     1892               'Rv                     =' v-mm:Rv                skip
     1893               'DeltaOtn_Vcy           =' v-mm:DeltaOtn_Vcy      skip
     1894               'M                      =' v-mm:M                 skip
     1895               'Mcy                    =' v-mm:Mcy               skip
     1896               'DeltaOtn_M             =' v-mm:DeltaOtn_M        skip
     1897             .
     1898             output stream outstream close.
     1899             if v-mm:Result <> 0 then do :
     1900               error-string = v-mm:ResultDetail .
     1901               output stream outstream to value ("pomi.log") append.
     1902                 put stream outstream error-string format "x(1024)" skip.
     1903               output stream outstream close.
     1904               release object v-mm no-error.
     1905               v-mm = ?.
     1906               message
     1907                 substitute('Ошибка работы библиотеки ПО МИ &1',error-string) skip
     1908               view-as alert-box error.
     1909               undo _trpomi, return no-apply  .
     1910             end.
     1911             else do :
     1912               assign
     1913                 f-tank-density-pomi    = decimal(v-mm:Rcy) / 1000
     1914                 f-tank-vol-pomi        = v-mm:Vcy
     1915                 f-tank-weight     = v-mm:Mcy
     1916                 f-acc-weight = round (v-mm:DeltaOtn_M, 3)
     1917               .
     1918               display
     1919                 f-tank-density-pomi
     1920                 f-tank-vol-pomi
     1921                 f-tank-weight
     1922                 f-acc-weight
     1923               with frame Dialog-Frame.
