     1147   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   procedure godendo-date-to-offset :
     1149     define input  parameter p-today  as date      no-undo .
     1150     define input  parameter p-date   as date      no-undo .
     1151     define output parameter p-offset as integer   no-undo .
     1152     do
     1153     on error undo, return error return-value
     1154     :
     1155       if p-date  = ?
     1156       or p-today = ?
     1157       then do:
     1158         assign
     1159           p-offset = ?
     1160         .
     1161       end.
     1162       else do:
     1163         assign
     1164           p-offset = p-date - p-today + 1
     1165         .
     1166       end.
     1167     end.
     1168   end procedure.
     1169   procedure godendo-offset-to-date :
     1170     define input  parameter p-today  as date      no-undo .
     1171     define input  parameter p-offset as integer   no-undo .
     1172     define output parameter p-date   as date      no-undo .
     1173     do
     1174     on error undo, return error return-value
     1175     :
     1176       if p-today  = ?
     1177       or p-offset = ?
     1178       then do:
     1179         assign
     1180           p-date = ?
     1181         .
     1182       end.
     1183       else do:
     1184         assign
     1185           p-date = p-offset + p-today - 1
     1186         .
     1187       end.
     1188     end.
     1189   end procedure.
     1190   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   procedure sel-date :
     1192     define input  parameter p-date-handle as handle    no-undo .
     1193     define input  parameter p-description as character no-undo .
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197       if (can-query (p-date-handle, "sensitive")
     1198         and
     1199         p-date-handle :sensitive = true
     1200         )
     1201       or (can-query (p-date-handle, "read-only")
     1202         and
     1203         p-date-handle :read-only = false
     1204         )
     1205       then do:
     1206         if p-date-handle :handle <> focus :handle
     1207         then do:
     1208           apply "entry":u to p-date-handle .
     1209         end.
     1210         define variable v-ok            as logical no-undo .
     1211         define variable v-curr-sv-date as date no-undo .
     1212         assign
     1213           v-curr-sv-date = date(p-date-handle :screen-value) no-error
     1214         .
     1215         if v-curr-sv-date = ?
     1216         then do:
     1217           run gbl/getcurdt.p
     1218             (output v-curr-sv-date
     1219             ) .
     1220         end.
     1221         if v-curr-sv-date <> ?
     1222         then do:
     1223           run gbl/d-inpday.w
     1224             (input ?
     1225             ,input "Выбор даты"
     1226             ,input p-description
     1227             ,input ""
     1228             ,input-output v-curr-sv-date
     1229             ,output v-ok
     1230             ).
     1231           if v-ok = true
     1232           then do:
     1233             assign
     1234               p-date-handle :screen-value = string(v-curr-sv-date) .
     1235             .
     1236           end.
     1237         end.
     1238       end.
     1239     end.
     1240   end procedure.
