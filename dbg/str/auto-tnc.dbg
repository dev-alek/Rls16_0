        1   define input parameter parparentproc as widget-handle no-undo.
        2   define input parameter parmode as character no-undo.
        3   define input-output parameter parrecid as recid no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Данные по автотранспорту".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable ref-list         as character no-undo.
      114   define variable v-af-obj-code    like ub.clients.obj-code no-undo.
      115   define variable v-af-obj-type    like ub.clients.obj-type no-undo.
      116   define variable v-i              AS INTEGER   NO-UNDO.
      117   define variable varauto-tank-sec as CHARACTER no-undo.
      118   define variable v-auto-num       as character no-undo.
      119   DEFINE BUFFER buf_auto-tank        FOR ub.auto-tank.
      120   DEFINE BUFFER type_auto-tank-attr  FOR ub.auto-tank-attr.
      121   DEFINE BUFFER neck_auto-tank-attr  FOR ub.auto-tank-attr.
      122   DEFINE BUFFER sep_auto-tank-attr   FOR ub.auto-tank-attr.
      123   DEFINE BUFFER valve_auto-tank-attr  FOR ub.auto-tank-attr.
      124   DEFINE BUFFER con-sleeve_auto-tank-attr   FOR ub.auto-tank-attr.
      125   DEFINE BUFFER error_auto-tank-attr FOR ub.auto-tank-attr.
      126   DEFINE BUFFER temp_auto-tank-attr  FOR ub.auto-tank-attr.
      127   define buffer buf_auto-section     for ub.auto-section.
      128   DEFINE TEMP-TABLE tt_auto-tank-sec NO-UNDO
      129      FIELD sec-num     AS integer
      130      FIELD brutto-qnty AS DECIMAL
      131      field add-volume  as decimal
      132      .
      133   DEFINE BUTTON b-add-sec
      134      LABEL "Добавить"
      135      SIZE 10 BY 1.
      136   DEFINE BUTTON b-cancel AUTO-END-KEY
      137      LABEL "&Отмена"
      138      SIZE 10 BY 1
      139      BGCOLOR 8 .
      140   DEFINE BUTTON b-chg-sec
      141      LABEL "Изменить"
      142      SIZE 10 BY 1.
      143   DEFINE BUTTON b-choose-auto-firm
      144      IMAGE-UP FILE "btn-down-arrow":U
      145      IMAGE-DOWN FILE "btn-down-arrow":U
      146      IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      147      LABEL "b-choose-auto-firm"
      148      SIZE 3 BY 1.
      149   DEFINE BUTTON b-del-sec
      150      LABEL "Удалить"
      151      SIZE 10 BY 1.
      152   DEFINE BUTTON b-help
      153      LABEL "&Помощь"
      154      SIZE 10 BY 1
      155      BGCOLOR 8 .
      156   DEFINE BUTTON b-save AUTO-GO
      157      LABEL "&Ввод"
      158      SIZE 10 BY 1
      159      BGCOLOR 8 .
      160   DEFINE BUTTON b-view-sec
      161      LABEL "Просмотр"
      162      SIZE 10 BY 1.
      163   DEFINE VARIABLE c-AC-type    AS INTEGER   FORMAT "->,>>>,>>9":U INITIAL 0
      164      LABEL "Тип АЦ"
      165      VIEW-AS COMBO-BOX INNER-LINES 5
      166      LIST-ITEM-PAIRS "",0,
      167      "Бензовоз",1,
      168      "Газовоз",2
      169      DROP-DOWN-LIST
      170      SIZE 21.5 BY 1 NO-UNDO.
      171   DEFINE VARIABLE C-neck       AS INTEGER   FORMAT "->,>>>,>>9":U INITIAL 0
      172      LABEL "Горловина"
      173      VIEW-AS COMBO-BOX INNER-LINES 5
      174      LIST-ITEM-PAIRS "",4,
      175      "Эллиптическая",2,
      176      "Прямоугольная или квадратная",1,
      177      "Цилиндрическая",3,
      178      "Без горловины/нарушена геометрия",0
      179      DROP-DOWN-LIST
      180      SIZE 36.5 BY 1 NO-UNDO.
      181   DEFINE VARIABLE varPS        AS CHARACTER
      182      VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      183      SIZE 58 BY 2.88 DROP-TARGET NO-UNDO.
      184   DEFINE VARIABLE f-error      AS DECIMAL   FORMAT ">>,>>9.999":U INITIAL .4
      185      LABEL "Относительная погрешность определения объема  АЦ, %"
      186      VIEW-AS FILL-IN
      187      SIZE 14 BY 1 NO-UNDO.
      188   DEFINE VARIABLE f-temp       AS DECIMAL   FORMAT ">>,>>9.9999999999":U INITIAL .0000125
      189      LABEL "Темпер.коэф. линейного расширения материала стенки АЦ,°С"
      190      VIEW-AS FILL-IN
      191      SIZE 14 BY 1 NO-UNDO.
      192   DEFINE VARIABLE varauto-firm AS CHARACTER FORMAT "X(256)"
      193      LABEL "Автопредприятие"
      194      VIEW-AS FILL-IN
      195      SIZE 17 BY 1 NO-UNDO.
      196   DEFINE VARIABLE varauto-num  AS CHARACTER FORMAT "X(20)"
      197      LABEL "Гос. номер"
      198      VIEW-AS FILL-IN
      199      SIZE 21.5 BY 1 TOOLTIP "Государственный регистрационный номер автомобиля" NO-UNDO.
      200   DEFINE VARIABLE varname      AS CHARACTER FORMAT "X(40)"
      201      LABEL "Название (марка)"
      202      VIEW-AS FILL-IN
      203      SIZE 20.5 BY 1 NO-UNDO.
      204   DEFINE RECTANGLE RECT-1
      205      EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      206      SIZE 77.5 BY 11.38.
      207   DEFINE RECTANGLE RECT-2
      208      EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      209      SIZE 75.5 BY 3.5.
      210   DEFINE VARIABLE SEP AS LOGICAL INITIAL no
      211      LABEL "Наличие СЭП"
      212      VIEW-AS TOGGLE-BOX
      213      SIZE 15 BY .83 NO-UNDO.
      214   DEFINE VARIABLE valve AS LOGICAL INITIAL no
      215      LABEL "Контрольный вентиль"
      216      VIEW-AS TOGGLE-BOX
      217      SIZE 25 BY .83 NO-UNDO.
      218   DEFINE VARIABLE con-sleeve   AS decimal FORMAT ">>>>9.9<"
      219      LABEL "Длина соединительного рукава, м"
      220      VIEW-AS FILL-IN
      221      SIZE 10 BY 1 NO-UNDO.
      222   DEFINE QUERY brw-auto-num-sec FOR
      223      tt_auto-tank-sec SCROLLING.
      224   DEFINE BROWSE brw-auto-num-sec
      225      QUERY brw-auto-num-sec DISPLAY
      226      tt_auto-tank-sec.sec-num FORMAT ">>>>9":U COLUMN-LABEL "№ секции"
      227      tt_auto-tank-sec.brutto-qnty FORMAT "->>,>>>,>>9.<<<":U COLUMN-LABEL "Вместимость!секции (л)"
      228      tt_auto-tank-sec.add-volume  FORMAT "->>,>>>,>>9.<<<":U COLUMN-LABEL "Дополнительный объем трубопровода нижнего!налива(л)"
      229       WITH NO-ROW-MARKERS SEPARATORS SIZE 76 BY 9.13.
      230   DEFINE FRAME Dialog-Frame
      231      b-save AT ROW 1 COL 1
      232      b-cancel AT ROW 1 COL 11
      233      b-help AT ROW 1 COL 21
      234      SEP AT ROW 1.25 COL 56 WIDGET-ID 50
      235      varname AT ROW 2.5 COL 17.5 COLON-ALIGNED
      236      varauto-num AT ROW 2.5 COL 54 COLON-ALIGNED
      237      varauto-firm AT ROW 3.75 COL 17.5 COLON-ALIGNED WIDGET-ID 2
      238      c-AC-type AT ROW 3.75 COL 54 COLON-ALIGNED WIDGET-ID 36
      239      b-choose-auto-firm AT ROW 3.79 COL 36.88 WIDGET-ID 4
      240      C-neck AT ROW 5 COL 17.5 COLON-ALIGNED WIDGET-ID 38
      241      valve at row 5 col 3 WIDGET-ID 88
      242      con-sleeve at row 5 col 30 WIDGET-ID 98
      243      f-error AT ROW 7.25 COL 59.75 COLON-ALIGNED WIDGET-ID 46
      244      f-temp AT ROW 8.54 COL 3.75 WIDGET-ID 48
      245      varPS AT ROW 10.25 COL 19.5 NO-LABEL
      246      b-add-sec AT ROW 14.38 COL 2 WIDGET-ID 22
      247      b-chg-sec AT ROW 14.38 COL 12 WIDGET-ID 18
      248      b-del-sec AT ROW 14.38 COL 22 WIDGET-ID 32
      249      b-view-sec AT ROW 14.38 COL 32 WIDGET-ID 20
      250      brw-auto-num-sec AT ROW 15.63 COL 1.75 WIDGET-ID 100
      251      "Информация по секциям автотранспорта" VIEW-AS TEXT
      252      SIZE 36 BY .67 AT ROW 13.29 COL 21.75 WIDGET-ID 26
      253      FGCOLOR 4
      254      "Метрологические характеристики" VIEW-AS TEXT
      255      SIZE 30.75 BY .67 AT ROW 6.17 COL 23.13 WIDGET-ID 44
      256      FGCOLOR 4
      257      "Примечание:" VIEW-AS TEXT
      258      SIZE 11.88 BY .88 AT ROW 11.29 COL 3.25
      259      RECT-1 AT ROW 13.63 COL 1 WIDGET-ID 28
      260      RECT-2 AT ROW 6.5 COL 2 WIDGET-ID 40
      261      SPACE(1.37) SKIP(15.37)
      262      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      263      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      264      TITLE "Данные по автотранспорту"
      265      DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      266   ASSIGN
      267      FRAME Dialog-Frame:SCROLLABLE = FALSE
      268      FRAME Dialog-Frame:HIDDEN     = TRUE.
      269   ASSIGN
      270      varauto-firm:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      271   ASSIGN
      272      varPS:RETURN-INSERTED IN FRAME Dialog-Frame = TRUE
      273      varPS:READ-ONLY IN FRAME Dialog-Frame       = TRUE.
      274   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      275      DO:
      276         APPLY "END-ERROR":U TO SELF.
      277      END.
      278   ON CHOOSE OF b-add-sec IN FRAME Dialog-Frame
      279      DO:
      280         define variable unopen as logical no-undo init yes.
      281         if varauto-num:screen-value = ? or trim(varauto-num:screen-value) = "" then
      282         do :
      283            message "Введите номер автотранспорта!" view-as alert-box.
      284            return no-apply.
      285         end .
      286         if c-AC-type = 0 then
      287         do :
      288            message "Введите тип АЦ!" view-as alert-box.
      289            return no-apply.
      290         end .
      291         if c-AC-type = 1 and C-neck = 4 then
      292         do:
      293         end.
      294         if c-AC-type = 2 then
      295         do:
      296            FIND FIRST tt_auto-tank-sec NO-LOCK NO-ERROR.
      297            if available (tt_auto-tank-sec) then
      298            do:
      299               message "Для данного газовоза уже настроены параметры вместимости." skip
      300                  "Вы уверены, что хотите добавить секцию газовозу?"
      301                  view-as alert-box question buttons yes-no update unopen.
      302            end.
      303         end.
      304         ASSIGN
      305            varauto-num      = varauto-num:screen-value
      306            varauto-tank-sec = ?
      307            .
      308         if unopen then
      309         do:
      310            run str/auto-tncs.w
      311               ( input        'ДОБАВЛЕНИЕ':U
      312               ,input        varauto-num
      313               ,input        c-AC-type
      314               ,input        C-neck
      315               ,input-output varauto-tank-sec
      316               ) no-error.
      317            RUN init-proc.
      318            OPEN QUERY brw-auto-num-sec FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK.
      319            FIND FIRST tt_auto-tank-sec WHERE tt_auto-tank-sec.sec-num = integer(varauto-tank-sec) NO-LOCK NO-ERROR.
      320            IF AVAILABLE tt_auto-tank-sec THEN
      321            DO:
      322               REPOSITION brw-auto-num-sec TO RECID recid(tt_auto-tank-sec) NO-ERROR.
      323            END.
      324            for each tt_auto-tank-sec no-lock :
      325               disable varauto-num with frame Dialog-Frame.
      326            end.
      327            apply "value-changed" to brw-auto-num-sec in frame dialog-frame.
      328         end.
      329      END.
      330   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      331      DO:
      332         if not available ub.auto-tank then
      333            for each buf_auto-section exclusive-lock where buf_auto-section.auto-num = varauto-num :
      334               delete buf_auto-section .
      335            end.
      336      END.
      337   ON CHOOSE OF b-chg-sec IN FRAME Dialog-Frame
      338      DO:
      339         if available tt_auto-tank-sec then
      340         do:
      341            ASSIGN
      342               varauto-tank-sec = string(tt_auto-tank-sec.sec-num)
      343               .
      344            run str/auto-tncs.w
      345               ( input        'ИЗМЕНЕНИЕ':U
      346               ,input        varauto-num
      347               ,input        c-AC-type
      348               ,input        C-neck
      349               ,input-output varauto-tank-sec
      350               ) no-error.
      351            RUN init-proc.
      352            OPEN QUERY brw-auto-num-sec FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK.
      353            FIND FIRST tt_auto-tank-sec WHERE tt_auto-tank-sec.sec-num = integer(varauto-tank-sec) NO-LOCK NO-ERROR.
      354            IF AVAILABLE tt_auto-tank-sec THEN
      355            DO:
      356               REPOSITION brw-auto-num-sec TO RECID recid(tt_auto-tank-sec) NO-ERROR.
      357            END.
      358            apply "value-changed" to brw-auto-num-sec in frame dialog-frame.
      359         end.
      360         else
      361         do:
      362            message "Не выбрана секция." view-as alert-box error.
      363         end.
      364      END.
      365   ON CHOOSE OF b-choose-auto-firm IN FRAME Dialog-Frame
      366      DO:
      367         run ref/cli-all.w
      368            ( parparentproc
      369            , input  "b-sel"
      370            , ?
      371            , ?
      372            , ?
      373            , ?
      374            , ?
      375            , ?
      376            ,output ref-list
      377            ).
      378         If ref-list <> "" then
      379         do :
      380            find first ub.clients no-lock
      381               where recid(ub.clients) = integer(ref-list) no-error.
      382            if available ub.clients then
      383            do :
      384               varauto-firm = ub.clients.obj-type + " " + string(ub.clients.obj-code) .
      385            end.
      386         end.
      387         else
      388         do :
      389            varauto-firm = "".
      390         end.
      391         display varauto-firm WITH FRAME Dialog-Frame.
      392      END.
      393   ON CHOOSE OF b-del-sec IN FRAME Dialog-Frame
      394      DO:
      395         define variable varlog as log NO-UNDO.
      396         if available tt_auto-tank-sec then
      397         do:
      398            ASSIGN
      399               v-auto-num = varauto-num
      400               .
      401            MESSAGE "Удалить секцию?" view-as alert-box question
      402               buttons yes-no
      403               update varlog.
      404            if varlog = false then return no-apply.
      405            FIND FIRST buf_auto-section WHERE buf_auto-section.auto-num = v-auto-num
      406               and buf_auto-section.section-num = tt_auto-tank-sec.sec-num EXCLUSIVE-LOCK NO-ERROR.
      407            IF AVAILABLE buf_auto-section THEN
      408               DELETE buf_auto-tank.
      409            DELETE tt_auto-tank-sec.
      410            OPEN QUERY brw-auto-num-sec FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK.
      411         end.
      412         else
      413         do:
      414            message "Не выбрана секция." view-as alert-box error.
      415         end.
      416         for each tt_auto-tank-sec no-lock :
      417            disable varauto-num with frame Dialog-Frame.
      418         end.
      419         find first tt_auto-tank-sec no-lock no-error.
      420         if not available tt_auto-tank-sec then enable varauto-num with frame Dialog-Frame.
      421         apply "value-changed" to brw-auto-num-sec in frame dialog-frame.
      422      END.
      423   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      424      DO:
      425         if varauto-num:screen-value = ? or trim(varauto-num:screen-value) = ""
      426            or varname:screen-value = ? or trim(varname:screen-value) = ""
      427            then
      428         do :
      429            message "Заполните поля 'марка' и 'гос. номер'" view-as alert-box.
      430            return no-apply .
      431         end.
      432         if c-AC-type = 0 and not SEP then
      433         do:
      434            message "Выберите тип АЦ" view-as alert-box.
      435            return no-apply .
      436         end.
      437         if c-AC-type = 1 and C-neck = 4 then
      438         do:
      439            message "Выберите тип горловины" view-as alert-box.
      440            return no-apply .
      441         end.
      442         if varauto-firm = "" then
      443         do:
      444            message "Выберите автопредприятие" view-as alert-box.
      445            return no-apply .
      446         end.
      447         if parmode = 'ДОБАВЛЕНИЕ':U then
      448         do:
      449            if can-find (first ub.auto-tank where ub.auto-tank.auto-num = input frame Dialog-Frame varauto-num)
      450               then
      451            do:
      452               message "Уже существует автотранспорт с гос. номером: " input frame Dialog-Frame varauto-num view-as alert-box.
      453               return no-apply.
      454            end.
      455            create ub.auto-tank.
      456            assign
      457               parrecid             = recid(ub.auto-tank)
      458               ub.auto-tank.status_ = 'тек':U
      459               .
      460         end.
      461         assign
      462           valve
      463           con-sleeve
      464         .
      465         if parmode = 'ДОБАВЛЕНИЕ':U or
      466            parmode = 'ИЗМЕНЕНИЕ':U then
      467         do:
      468            assign
      469               ub.auto-tank.auto-num  = input frame Dialog-Frame varauto-num
      470               ub.auto-tank.name      = input frame Dialog-Frame varname
      471               ub.auto-tank.ps        = input frame Dialog-Frame varps
      472               ub.auto-tank.type-AC   = input frame Dialog-Frame c-AC-type
      473               ub.auto-tank.type-neck = input frame Dialog-Frame C-neck
      474               .
      475            if varauto-firm <> "" then
      476            do:
      477               assign
      478                  ub.auto-tank.firm-code = integer(entry(2,varauto-firm," "))
      479                  ub.auto-tank.firm-type = string(entry(1,varauto-firm," "))
      480                  .
      481            end.
      482         end.
      483         if parmode = 'ДОБАВЛЕНИЕ':U then
      484         do :
      485            if varauto-firm <> "" then
      486            do :
      487               create ub.auto-tank-attr.
      488               assign
      489                  ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      490                  ub.auto-tank-attr.attr-code  = "auto-firm"
      491                  ub.auto-tank-attr.attr-value = input frame Dialog-Frame varauto-firm
      492                  .
      493            end.
      494            create ub.auto-tank-attr.
      495            assign
      496               ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      497               ub.auto-tank-attr.attr-code  = "auto-sep"
      498               ub.auto-tank-attr.attr-value = string(SEP)
      499               .
      500            create ub.auto-tank-attr.
      501            assign
      502               ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      503               ub.auto-tank-attr.attr-code  = "autotype-AC"
      504               ub.auto-tank-attr.attr-value = string(c-AC-type)
      505               .
      506            if c-AC-type = 1 then
      507            do :
      508               create ub.auto-tank-attr.
      509               assign
      510                  ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      511                  ub.auto-tank-attr.attr-code  = "autotype-neck"
      512                  ub.auto-tank-attr.attr-value = string(C-neck)
      513                  .
      514               if f-error <> 0 or f-error <> ? then
      515               do:
      516                  create ub.auto-tank-attr.
      517                  assign
      518                     ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      519                     ub.auto-tank-attr.attr-code  = "auto-error"
      520                     ub.auto-tank-attr.attr-value = string(f-error)
      521                     .
      522               end.
      523               if f-temp <> 0 or f-temp <> ? then
      524               do:
      525                  create ub.auto-tank-attr.
      526                  assign
      527                     ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      528                     ub.auto-tank-attr.attr-code  = "auto-temp"
      529                     ub.auto-tank-attr.attr-value = string(f-temp)
      530                     .
      531               end.
      532            end.
      533            if c-AC-type = 2 then
      534            do :
      535               create ub.auto-tank-attr.
      536               assign
      537                  ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      538                  ub.auto-tank-attr.attr-code  = "valve"
      539                  ub.auto-tank-attr.attr-value = string(valve)
      540                  .
      541               if con-sleeve > 0 then
      542               do:
      543                  create ub.auto-tank-attr.
      544                  assign
      545                     ub.auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      546                     ub.auto-tank-attr.attr-code  = "con-sleeve"
      547                     ub.auto-tank-attr.attr-value = string(con-sleeve)
      548                     .
      549               end.
      550            end.
      551         end.
      552         if parmode = 'ИЗМЕНЕНИЕ':U then
      553         do:
      554            if varauto-firm <> "" then
      555            do :
      556               ub.auto-tank.firm-code   = integer(entry(2,varauto-firm," ")) .
      557               ub.auto-tank.firm-type   = string(entry(1,varauto-firm," ")) .
      558            end.
      559            else
      560            do :
      561               ub.auto-tank.firm-code   = 0 .
      562               ub.auto-tank.firm-type   = "" .
      563            end.
      564            if available sep_auto-tank-attr then sep_auto-tank-attr.attr-value = string(SEP) .
      565            else
      566            do :
      567               create sep_auto-tank-attr.
      568               assign
      569                   sep_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      570                   sep_auto-tank-attr.attr-code  = "auto-sep"
      571                   sep_auto-tank-attr.attr-value = string(SEP)
      572                   .
      573            end.
      574            if c-AC-type = 2 then
      575            do :
      576               if available valve_auto-tank-attr then valve_auto-tank-attr.attr-value = string(valve) .
      577               else
      578               do :
      579                   create valve_auto-tank-attr.
      580                   assign
      581                       valve_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      582                       valve_auto-tank-attr.attr-code  = "valve"
      583                       valve_auto-tank-attr.attr-value = string(valve)
      584                   .
      585               end .
      586               if con-sleeve > 0 then
      587               do:
      588                  if available con-sleeve_auto-tank-attr then con-sleeve_auto-tank-attr.attr-value = string(con-sleeve) .
      589                  else
      590                  do :
      591                       create con-sleeve_auto-tank-attr.
      592                       assign
      593                           con-sleeve_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      594                           con-sleeve_auto-tank-attr.attr-code  = "con-sleeve"
      595                           con-sleeve_auto-tank-attr.attr-value = string(con-sleeve)
      596                       .
      597                  end .
      598               end.
      599            end.
      600            if f-error <> 0 and f-error <> ? then
      601            do :
      602               if available error_auto-tank-attr then error_auto-tank-attr.attr-value = input frame Dialog-Frame f-error .
      603               else
      604               do :
      605                  create error_auto-tank-attr.
      606                  assign
      607                     error_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      608                     error_auto-tank-attr.attr-code  = "auto-error"
      609                     error_auto-tank-attr.attr-value = input frame Dialog-Frame f-error
      610                     .
      611               end.
      612            end.
      613            else
      614            do :
      615               if available error_auto-tank-attr then delete error_auto-tank-attr.
      616            end.
      617            if f-temp <> 0 and f-temp <> ? then
      618            do :
      619               if available temp_auto-tank-attr then temp_auto-tank-attr.attr-value = input frame Dialog-Frame f-temp .
      620               else
      621               do :
      622                  create temp_auto-tank-attr.
      623                  assign
      624                     temp_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      625                     temp_auto-tank-attr.attr-code  = "auto-temp"
      626                     temp_auto-tank-attr.attr-value = input frame Dialog-Frame f-temp
      627                     .
      628               end.
      629            end.
      630            else
      631            do :
      632               if available temp_auto-tank-attr then delete temp_auto-tank-attr.
      633            end.
      634            if c-AC-type <> 0 and c-AC-type <> ? then
      635            do :
      636               if available type_auto-tank-attr then type_auto-tank-attr.attr-value = input frame Dialog-Frame c-AC-type .
      637               else
      638               do :
      639                  create type_auto-tank-attr.
      640                  assign
      641                     type_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      642                     type_auto-tank-attr.attr-code  = "autotype-AC"
      643                     type_auto-tank-attr.attr-value = input frame Dialog-Frame c-AC-type
      644                     .
      645               end.
      646            end.
      647            else
      648            do :
      649               if available type_auto-tank-attr then delete type_auto-tank-attr.
      650            end.
      651            if C-neck <> 4 and C-neck <> ? and c-AC-type <> 2 then
      652            do :
      653               if available neck_auto-tank-attr then neck_auto-tank-attr.attr-value = input frame Dialog-Frame C-neck .
      654               else
      655               do :
      656                  create neck_auto-tank-attr.
      657                  assign
      658                     neck_auto-tank-attr.auto-num   = ub.auto-tank.auto-num
      659                     neck_auto-tank-attr.attr-code  = "autotype-neck"
      660                     neck_auto-tank-attr.attr-value = input frame Dialog-Frame C-neck
      661                     .
      662               end.
      663            end.
      664            else
      665            do :
      666               if available neck_auto-tank-attr then delete neck_auto-tank-attr.
      667            end.
      668         end.
      669         ub.auto-tank.brutto-qnty = 0 .
      670         for each ub.auto-section no-lock where ub.auto-section.auto-num = varauto-num:
      671           ub.auto-tank.brutto-qnty = ub.auto-tank.brutto-qnty + ub.auto-section.brutto-qnty.
      672         end.
      673      END.
      674   ON CHOOSE OF b-view-sec IN FRAME Dialog-Frame
      675      DO:
      676         if available tt_auto-tank-sec then
      677         do:
      678            ASSIGN
      679               varauto-num      = if available ub.auto-tank then ub.auto-tank.auto-num else varauto-num:screen-value
      680               varauto-tank-sec = string(tt_auto-tank-sec.sec-num)
      681               .
      682            run str/auto-tncs.w
      683               ( input        'ПРОСМОТР':U
      684               ,input        varauto-num
      685               ,input        c-AC-type
      686               ,input        C-neck
      687               ,input-output varauto-tank-sec
      688               ) no-error.
      689         end.
      690         else
      691         do:
      692            message "Не выбрана секция." view-as alert-box error.
      693         end.
      694      END.
      695   ON choose OF brw-auto-num-sec IN FRAME Dialog-Frame
      696      DO:
      697         find first tt_auto-tank-sec no-error .
      698      END.
      699   ON VALUE-CHANGED OF c-AC-type IN FRAME Dialog-Frame
      700      DO:
      701         assign c-AC-type .
      702         if c-AC-type = 1 then
      703         do:
      704            enable
      705               C-neck
      706               f-error
      707               f-temp
      708               with frame Dialog-Frame .
      709            display
      710               f-error
      711               f-temp
      712               with frame Dialog-Frame .
      713            hide
      714               valve
      715               con-sleeve
      716               in frame Dialog-Frame .
      717         end.
      718         else
      719         if c-AC-type = 2 then
      720         do:
      721            hide
      722               C-neck
      723               f-error
      724               f-temp
      725               in frame Dialog-Frame .
      726            display
      727               valve
      728               con-sleeve
      729               with frame Dialog-Frame .
      730            enable
      731               valve
      732               con-sleeve
      733               with frame Dialog-Frame .
      734         end.
      735      END.
      736   ON VALUE-CHANGED OF C-neck IN FRAME Dialog-Frame
      737      DO:
      738         assign C-neck .
      739      END.
      740   ON VALUE-CHANGED OF f-error IN FRAME Dialog-Frame
      741      DO:
      742         assign f-error .
      743      END.
      744   ON VALUE-CHANGED OF f-temp IN FRAME Dialog-Frame
      745      DO:
      746         assign f-temp .
      747      END.
      748   ON VALUE-CHANGED OF SEP IN FRAME Dialog-Frame
      749      DO:
      750         assign SEP .
      751      END.
      752   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      753      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      754   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   on help of frame Dialog-Frame
      756   do:
      757     run gbl/app_help.p
      758       (input this-procedure :file-name
      759       ,input ''
      760       ,input ?
      761       ) no-error.
      762     if error-status :error then do:
      763       message
      764         "Ошибка при вызове помощи"
      765         error-status :get-message(1)
      766         view-as alert-box .
      767     end.
      768   end.
      769   run minbtn-set in this-procedure .
      770   on choose of b-help in frame Dialog-Frame
      771   do:
      772     apply "help":u to frame Dialog-Frame .
      773   end.
      774   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      775   procedure minbtn-set :
      776       do
      777           on error undo, return error return-value
      778           :
      779           define variable ii              as integer       no-undo .
      780           define variable fh              as widget-handle no-undo .
      781           define variable hh              as widget-handle no-undo .
      782           define variable v-h             as handle        extent 4 no-undo .
      783           define variable v-name-button   as character     no-undo .
      784           define variable v-help-old-x    as decimal       no-undo .
      785           define variable v-help-old-y    as decimal       no-undo .
      786           define variable v-help-old-size as decimal       no-undo .
      787           define variable v-frame-width   as decimal       no-undo .
      788           define variable jj              as integer       no-undo .
      789           do
      790               on error undo, return error
      791               :
      792               assign
      793                   v-frame-width = frame Dialog-Frame:width - 0.3
      794                   fh            = frame Dialog-Frame:first-child
      795                   hh            = fh:first-child
      796                   ii            = 1
      797                   .
      798               do while valid-handle(hh):
      799                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      800                   do:
      801                       case lc(hh:name) :
      802                           when "b-help" then
      803                               do:
      804                                   hh:load-image-up("cmp/b-help.bmp":u) .
      805                                   hh:load-image-down("cmp/b-help.bmp":u) .
      806                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      807                                   hh:TOOLTIP = "Помощь" .
      808                                   v-help-old-x = hh:column .
      809                                   v-help-old-y = hh:row    .
      810                                   v-help-old-size = hh:width .
      811                                   hh:width-chars = 2.5 .
      812                               end.
      813                           when "b-print" then
      814                               do:
      815                                   hh:load-image("cmp/b-print.bmp":u) .
      816                                   hh:TOOLTIP = "Печать" .
      817                                   v-h[ii] = hh:handle .
      818                                   ii = ii + 1 .
      819                                   hh:width-chars = 3 .
      820                               end.
      821                           when "b-history" or
      822                           when "b-hist" then
      823                               do:
      824                                   hh:load-image("cmp/b-hist.bmp":u) .
      825                                   hh:TOOLTIP = "История" .
      826                                   v-h[ii] = hh:handle .
      827                                   ii = ii + 1 .
      828                                   hh:width-chars = 3 .
      829                               end.
      830                           when "b-sch" then
      831                               do:
      832                                   hh:load-image("cmp/b-sch.bmp":u) .
      833                                   hh:TOOLTIP = "Установка Фильтра" .
      834                                   v-h[ii] = hh:handle .
      835                                   ii = ii + 1 .
      836                                   hh:width-chars = 3 .
      837                               end.
      838                           when "b-hist-user" then
      839                               do:
      840                                   hh:load-image("cmp/b-hist.bmp":u) .
      841                                   hh:TOOLTIP = "История пользователя" .
      842                                   ii = ii + 1 .
      843                               end.
      844                       end case.
      845                   end.
      846                   hh = hh:next-sibling.
      847               end.
      848               b-help:column = v-frame-width - b-help:width-chars.
      849               jj = 0.
      850               repeat ii = 4 to 1 by -1 :
      851                   if valid-handle (v-h[ii] ) then
      852                   do:
      853                       jj  = jj + 1 .
      854                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      855                       v-h[ii]:row    = v-help-old-y .
      856                   end.
      857               end.
      858           end.
      859       end.
      860   end procedure.
      861   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      862   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      863   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      864   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      865   define variable v-diasize-current-frame-width  as decimal   no-undo .
      866   define variable v-diasize-current-frame-height as decimal   no-undo .
      867   define variable v-diasize-change-size          as logical   no-undo .
      868   define variable v-diasize-resize-button        as handle    no-undo .
      869   define variable v-diasize-wndmax               as logical   no-undo .
      870   define variable v-diasize-wndstore             as logical   no-undo .
      871   define variable v-diasize-proc-name            as character no-undo .
      872   define variable v-diasize-browse-handle        as handle    no-undo .
      873   define variable v-diasize-browse-number        as integer   no-undo .
      874   define variable v-diasize-need-full-display    as logical   no-undo init false .
      875   define temp-table temp-diasize-handle no-undo
      876     field handle-value  as handle
      877     field save-position as decimal
      878     index xpk is primary unique handle-value
      879     .
      880   define temp-table temp-browse-handle no-undo
      881     field browse-type   as character
      882     field browse-number as integer
      883     field browse-handle as handle
      884     field original-size as decimal
      885     index xpk is primary unique browse-type browse-number
      886     index xie browse-type browse-handle
      887   .
      888   procedure diasize_change-height :
      889     define input  parameter p-change-value  as decimal   no-undo .
      890     define input  parameter p-move-resize   as logical   no-undo .
      891     define variable v-field-group-handle    as handle    no-undo .
      892     define variable v-object-handle         as handle    no-undo .
      893     define variable v-frame-height          as decimal   no-undo .
      894     define variable v-frame-virtual-height  as decimal   no-undo .
      895     define variable v-browse-height         as decimal   no-undo .
      896     define variable v-window-height         as decimal   no-undo .
      897     define variable v-window-virtual-height as decimal   no-undo .
      898     define variable v-change-sign           as integer   no-undo .
      899     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      900     define buffer buf_temp-browse-handle  for temp-browse-handle .
      901     if p-change-value > 0
      902     then do:
      903       if frame Dialog-Frame :height + p-change-value
      904           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      905       then do:
      906         assign
      907           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      908                           - (frame Dialog-Frame :height-chars)
      909         .
      910         if p-change-value <= 0
      911         then do:
      912           run diasize_position-resize-button in this-procedure .
      913           return .
      914         end.
      915       end.
      916     end.
      917     if p-change-value < 0
      918     then do:
      919       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      920       then do:
      921         assign
      922           p-change-value = v-diasize-orig-frame-height
      923                          - (frame Dialog-Frame :height-chars)
      924         .
      925         if p-change-value >= 0
      926         then do:
      927           run diasize_position-resize-button in this-procedure .
      928           return .
      929         end.
      930       end.
      931     end.
      932     if p-change-value >= 0
      933     then do:
      934       assign
      935         v-change-sign = 1
      936       .
      937     end.
      938     else do:
      939       assign
      940         v-change-sign = -1
      941       .
      942     end.
      943     assign
      944       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      945     .
      946     if p-change-value = 0
      947     then do:
      948       run diasize_position-resize-button in this-procedure .
      949       return .
      950     end.
      951     move_block:
      952     do
      953     on error undo move_block, retry move_block
      954     :
      955       if retry
      956       then do:
      957         do
      958         on error undo move_block, leave move_block
      959         :
      960           if p-change-value > 0
      961           then do:
      962             for each buf_temp-diasize-handle
      963             on error undo, next
      964             :
      965               assign
      966                 v-object-handle = buf_temp-diasize-handle.handle-value
      967               .
      968               if v-object-handle <> v-diasize-resize-button
      969               then do:
      970                 assign
      971                   v-object-handle :row = buf_temp-diasize-handle.save-position
      972                 .
      973               end.
      974             end.
      975             assign
      976               v-diasize-browse-handle :height = v-browse-height
      977             .
      978             for each buf_temp-browse-handle
      979               where buf_temp-browse-handle.browse-type = 'height':u
      980             on error undo, next
      981             :
      982               assign
      983                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      984               .
      985             end.
      986             assign
      987               frame Dialog-Frame :height = v-frame-height
      988             .
      989             if frame Dialog-Frame :scrollable = true
      990             then do:
      991               assign
      992                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      993               .
      994             end.
      995             run diasize_position-resize-button in this-procedure .
      996           end.
      997           else do:
      998             if frame Dialog-Frame :scrollable = true
      999             then do:
     1000               assign
     1001                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1002               .
     1003             end.
     1004             assign
     1005               frame Dialog-Frame :height = v-frame-height
     1006             .
     1007             assign
     1008               v-diasize-browse-handle :height = v-browse-height
     1009             .
     1010             for each buf_temp-browse-handle
     1011               where buf_temp-browse-handle.browse-type = 'height':u
     1012             on error undo, next
     1013             :
     1014               assign
     1015                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1016               .
     1017             end.
     1018             for each buf_temp-diasize-handle
     1019             on error undo, next
     1020             :
     1021               assign
     1022                 v-object-handle = buf_temp-diasize-handle.handle-value
     1023               .
     1024               if v-object-handle <> v-diasize-resize-button
     1025               then do:
     1026                 assign
     1027                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1028                 .
     1029               end.
     1030             end.
     1031             run diasize_position-resize-button in this-procedure .
     1032           end.
     1033           assign
     1034             v-diasize-change-size = false
     1035           .
     1036           leave move_block .
     1037         end.
     1038       end.
     1039       assign
     1040         v-diasize-need-full-display = true
     1041       .
     1042       if v-diasize-change-size = false
     1043       then do:
     1044         assign
     1045           v-diasize-change-size = true
     1046         .
     1047       end.
     1048       else do:
     1049         return .
     1050       end.
     1051       assign
     1052         v-frame-height = frame Dialog-Frame :height
     1053         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1054         v-browse-height = v-diasize-browse-handle :height
     1055       .
     1056       for each buf_temp-browse-handle
     1057         where buf_temp-browse-handle.browse-type = 'height':u
     1058       :
     1059         assign
     1060           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1061         .
     1062       end.
     1063       for each buf_temp-diasize-handle
     1064       :
     1065         delete buf_temp-diasize-handle .
     1066       end.
     1067       assign
     1068         v-field-group-handle = frame Dialog-Frame :first-child
     1069       .
     1070       do while valid-handle(v-field-group-handle)
     1071       :
     1072         assign
     1073           v-object-handle = v-field-group-handle :first-child
     1074         .
     1075         do while valid-handle(v-object-handle)
     1076         :
     1077           if  v-object-handle <> v-diasize-browse-handle :handle
     1078           and can-query(v-object-handle, "row")
     1079           and can-query(v-object-handle, "height")
     1080           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1081           then do:
     1082             find first buf_temp-browse-handle
     1083               where buf_temp-browse-handle.browse-type   = 'height':u
     1084                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1085               no-error .
     1086             if available buf_temp-browse-handle
     1087             then do:
     1088             end.
     1089             else do:
     1090               create buf_temp-diasize-handle .
     1091               assign
     1092                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1093                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1094               .
     1095             end.
     1096           end.
     1097           assign
     1098             v-object-handle = v-object-handle :next-sibling
     1099           .
     1100         end.
     1101         assign
     1102           v-field-group-handle = v-field-group-handle :next-sibling
     1103         .
     1104       end.
     1105       do with frame Dialog-Frame
     1106       :
     1107         hide v-diasize-resize-button .
     1108         assign
     1109           v-diasize-resize-button :row    = 1
     1110           v-diasize-resize-button :column = 1
     1111         .
     1112       end.
     1113       if p-change-value > 0
     1114       then do:
     1115         if frame Dialog-Frame :scrollable = true
     1116         then do:
     1117           assign
     1118             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1119             no-error .
     1120           if error-status :error
     1121           or error-status :get-message(1) <> ""
     1122           then do:
     1123             undo move_block, retry move_block .
     1124           end.
     1125         end.
     1126         assign
     1127           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1128           no-error .
     1129         if error-status :error
     1130         or error-status :get-message(1) <> ""
     1131         then do:
     1132           undo move_block, retry move_block .
     1133         end.
     1134         assign
     1135           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1136           no-error .
     1137         if error-status :error
     1138         or error-status :get-message(1) <> ""
     1139         then do:
     1140           undo move_block, retry move_block .
     1141         end.
     1142         for each buf_temp-browse-handle
     1143           where buf_temp-browse-handle.browse-type = 'height':u
     1144         on error undo move_block, retry move_block
     1145         :
     1146           assign
     1147             buf_temp-browse-handle.browse-handle :height
     1148               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1149             no-error .
     1150           if error-status :error
     1151           or error-status :get-message(1) <> ""
     1152           then do:
     1153             undo move_block, retry move_block .
     1154           end.
     1155         end.
     1156         for each buf_temp-diasize-handle
     1157         on error undo move_block, retry move_block
     1158         :
     1159           assign
     1160             v-object-handle = buf_temp-diasize-handle.handle-value
     1161           .
     1162           if v-object-handle <> v-diasize-resize-button
     1163           then do:
     1164             assign
     1165               v-object-handle :row = v-object-handle :row + p-change-value
     1166               no-error .
     1167             if error-status :error
     1168             or error-status :get-message(1) <> ""
     1169             then do:
     1170               undo move_block, retry move_block .
     1171             end.
     1172           end.
     1173         end.
     1174       end.
     1175       else do:
     1176         for each buf_temp-diasize-handle
     1177         on error undo move_block, retry move_block
     1178         :
     1179           assign
     1180             v-object-handle = buf_temp-diasize-handle.handle-value
     1181           .
     1182           if v-object-handle <> v-diasize-resize-button
     1183           then do:
     1184             assign
     1185               v-object-handle :row = v-object-handle :row + p-change-value
     1186               no-error .
     1187             if error-status :error
     1188             or error-status :get-message(1) <> ""
     1189             then do:
     1190               undo move_block, retry move_block .
     1191             end.
     1192           end.
     1193         end.
     1194         assign
     1195           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1196           no-error .
     1197         if error-status :error
     1198         or error-status :get-message(1) <> ""
     1199         then do:
     1200           undo move_block, retry move_block .
     1201         end.
     1202         for each buf_temp-browse-handle
     1203           where buf_temp-browse-handle.browse-type = 'height':u
     1204         on error undo move_block, retry move_block
     1205         :
     1206           assign
     1207             buf_temp-browse-handle.browse-handle :height
     1208               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1209             no-error .
     1210           if error-status :error
     1211           or error-status :get-message(1) <> ""
     1212           then do:
     1213             undo move_block, retry move_block .
     1214           end.
     1215         end.
     1216         assign
     1217           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1218           no-error .
     1219         if error-status :error
     1220         or error-status :get-message(1) <> ""
     1221         then do:
     1222           undo move_block, retry move_block .
     1223         end.
     1224         if frame Dialog-Frame :scrollable = true
     1225         then do:
     1226           assign
     1227             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1228             no-error .
     1229           if error-status :error
     1230           or error-status :get-message(1) <> ""
     1231           then do:
     1232             undo move_block, retry move_block .
     1233           end.
     1234         end.
     1235       end.
     1236       if p-move-resize = true
     1237       then do:
     1238         run diasize_position-resize-button in this-procedure .
     1239       end.
     1240       if v-diasize-wndstore = true
     1241       then do:
     1242         if connected("ub") = true
     1243         then do:
     1244           define variable v-cntxt-db-num        as integer   no-undo .
     1245           define variable v-cntxt-userid        as character no-undo .
     1246           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1247                                             , OUTPUT v-cntxt-userid
     1248                                             ) .
     1249           run gbl/wndsizew.p
     1250             (input  v-cntxt-db-num
     1251             ,input  v-cntxt-userid
     1252             ,input  v-diasize-proc-name
     1253             ,input  'height':u
     1254             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1255             ) .
     1256         end.
     1257       end.
     1258     end.
     1259     assign
     1260       v-diasize-change-size = false
     1261     .
     1262   end procedure.
     1263   procedure diasize_set-height :
     1264     define input  parameter p-new-height  as decimal   no-undo .
     1265     define input  parameter p-move-resize as logical   no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       run diasize_change-height in this-procedure
     1270         (input  (p-new-height - frame Dialog-Frame :height)
     1271         ,input  p-move-resize
     1272         ) .
     1273     end.
     1274   end procedure.
     1275   procedure diasize_change-width :
     1276     define input  parameter p-change-value as decimal   no-undo .
     1277     define input  parameter p-move-resize  as logical   no-undo .
     1278     define variable v-field-group-handle   as handle    no-undo .
     1279     define variable v-object-handle        as handle    no-undo .
     1280     define variable v-frame-width          as decimal   no-undo .
     1281     define variable v-frame-virtual-width  as decimal   no-undo .
     1282     define variable v-browse-width         as decimal   no-undo .
     1283     define variable v-window-width         as decimal   no-undo .
     1284     define variable v-window-virtual-width as decimal   no-undo .
     1285     define variable v-change-sign          as integer   no-undo .
     1286     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1287     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1288     if p-change-value > 0
     1289     then do:
     1290       if frame Dialog-Frame :width + p-change-value >
     1291           session :width-chars
     1292       then do:
     1293         assign
     1294           p-change-value = session :width-chars - frame Dialog-Frame :width
     1295         .
     1296         if p-change-value <= 0
     1297         then do:
     1298           run diasize_position-resize-button in this-procedure .
     1299           return .
     1300         end.
     1301       end.
     1302     end.
     1303     if p-change-value < 0
     1304     then do:
     1305       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1306       then do:
     1307         assign
     1308           p-change-value = v-diasize-orig-frame-width
     1309                          - frame Dialog-Frame :width
     1310         .
     1311         if p-change-value >= 0
     1312         then do:
     1313           run diasize_position-resize-button in this-procedure .
     1314           return .
     1315         end.
     1316       end.
     1317     end.
     1318     if p-change-value >= 0
     1319     then do:
     1320       assign
     1321         v-change-sign = 1
     1322       .
     1323     end.
     1324     else do:
     1325       assign
     1326         v-change-sign = -1
     1327       .
     1328     end.
     1329     assign
     1330       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1331     .
     1332     if p-change-value = 0
     1333     then do:
     1334       run diasize_position-resize-button in this-procedure .
     1335       return .
     1336     end.
     1337     move_block:
     1338     do
     1339     on error undo move_block, leave move_block
     1340     :
     1341       if retry
     1342       then do:
     1343         do
     1344         on error undo move_block, leave move_block
     1345         :
     1346           if p-change-value > 0
     1347           then do:
     1348             for each buf_temp-diasize-handle
     1349             on error undo, next
     1350             :
     1351               assign
     1352                 v-object-handle = buf_temp-diasize-handle.handle-value
     1353               .
     1354               if v-object-handle <> v-diasize-resize-button
     1355               then do:
     1356                 assign
     1357                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1358                 .
     1359               end.
     1360             end.
     1361             assign
     1362               v-diasize-browse-handle :width = v-browse-width
     1363             .
     1364             for each buf_temp-browse-handle
     1365               where buf_temp-browse-handle.browse-type = 'width':u
     1366             on error undo, next
     1367             :
     1368               assign
     1369                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1370               .
     1371             end.
     1372             assign
     1373               frame Dialog-Frame :width = v-frame-width
     1374             .
     1375             if frame Dialog-Frame :scrollable = true
     1376             then do:
     1377               assign
     1378                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1379               .
     1380             end.
     1381             run diasize_position-resize-button in this-procedure .
     1382           end.
     1383           else do:
     1384             if frame Dialog-Frame :scrollable = true
     1385             then do:
     1386               assign
     1387                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1388               .
     1389             end.
     1390             assign
     1391               frame Dialog-Frame :width = v-frame-width
     1392             .
     1393             for each buf_temp-browse-handle
     1394               where buf_temp-browse-handle.browse-type = 'width':u
     1395             on error undo, next
     1396             :
     1397               assign
     1398                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1399               .
     1400             end.
     1401             assign
     1402               v-diasize-browse-handle :width = v-browse-width
     1403             .
     1404             for each buf_temp-diasize-handle
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 v-object-handle = buf_temp-diasize-handle.handle-value
     1409               .
     1410               if v-object-handle <> v-diasize-resize-button
     1411               then do:
     1412                 assign
     1413                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1414                 .
     1415               end.
     1416             end.
     1417             run diasize_position-resize-button in this-procedure .
     1418           end.
     1419           assign
     1420             v-diasize-change-size = false
     1421           .
     1422           leave move_block .
     1423         end.
     1424       end.
     1425       assign
     1426         v-diasize-need-full-display = true
     1427       .
     1428       if v-diasize-change-size = false
     1429       then do:
     1430         assign
     1431           v-diasize-change-size = true
     1432         .
     1433       end.
     1434       else do:
     1435         return .
     1436       end.
     1437       assign
     1438         v-frame-width = frame Dialog-Frame :width
     1439         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1440         v-browse-width = v-diasize-browse-handle :width
     1441       .
     1442       for each buf_temp-browse-handle
     1443         where buf_temp-browse-handle.browse-type = 'width':u
     1444       :
     1445         assign
     1446           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1447         .
     1448       end.
     1449       for each buf_temp-diasize-handle
     1450       :
     1451         delete buf_temp-diasize-handle .
     1452       end.
     1453       assign
     1454         v-field-group-handle = frame Dialog-Frame :first-child
     1455       .
     1456       do while valid-handle(v-field-group-handle)
     1457       :
     1458         assign
     1459           v-object-handle = v-field-group-handle :first-child
     1460         .
     1461         do while valid-handle(v-object-handle)
     1462         :
     1463           if  v-object-handle <> v-diasize-browse-handle :handle
     1464           and v-object-handle <> v-diasize-resize-button
     1465           and can-query(v-object-handle, "row")
     1466           and can-query(v-object-handle, "height")
     1467           and ( v-object-handle :col + v-object-handle :width
     1468                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1469               )
     1470           then do:
     1471             find first buf_temp-browse-handle
     1472               where buf_temp-browse-handle.browse-type   = 'width':u
     1473                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1474               no-error .
     1475             if available buf_temp-browse-handle
     1476             then do:
     1477             end.
     1478             else do:
     1479               create buf_temp-diasize-handle .
     1480               assign
     1481                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1482                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1483               .
     1484             end.
     1485           end.
     1486           assign
     1487             v-object-handle = v-object-handle :next-sibling
     1488           .
     1489         end.
     1490         assign
     1491           v-field-group-handle = v-field-group-handle :next-sibling
     1492         .
     1493       end.
     1494       do with frame Dialog-Frame
     1495       :
     1496         hide v-diasize-resize-button .
     1497         v-diasize-resize-button :row = 1.
     1498         v-diasize-resize-button :column = 1.
     1499       end.
     1500       if p-change-value > 0
     1501       then do:
     1502         if frame Dialog-Frame :scrollable = true
     1503         then do:
     1504           assign
     1505             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1506             no-error .
     1507           if error-status :error
     1508           or error-status :get-message(1) <> ""
     1509           then do:
     1510             undo move_block, retry move_block.
     1511           end.
     1512         end.
     1513         assign
     1514           frame Dialog-Frame :width = v-frame-width + p-change-value
     1515           no-error .
     1516         if error-status :error
     1517         or error-status :get-message(1) <> ""
     1518         then do:
     1519           undo move_block, retry move_block.
     1520         end.
     1521         assign
     1522           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1523         no-error .
     1524         if error-status :error
     1525         or error-status :get-message(1) <> ""
     1526         then do:
     1527           undo move_block, retry move_block.
     1528         end.
     1529         for each buf_temp-browse-handle
     1530           where buf_temp-browse-handle.browse-type = 'width':u
     1531         on error undo move_block, retry move_block
     1532         :
     1533           assign
     1534             buf_temp-browse-handle.browse-handle :width
     1535               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1536             no-error .
     1537           if error-status :error
     1538           or error-status :get-message(1) <> ""
     1539           then do:
     1540             undo move_block, retry move_block .
     1541           end.
     1542         end.
     1543         for each buf_temp-diasize-handle
     1544         on error undo move_block, retry move_block
     1545         :
     1546           assign
     1547             v-object-handle = buf_temp-diasize-handle.handle-value
     1548           .
     1549           if v-object-handle <> v-diasize-resize-button
     1550           then do:
     1551             assign
     1552               v-object-handle :col = v-object-handle :col + p-change-value
     1553               no-error .
     1554             if error-status :error
     1555             or error-status :get-message(1) <> ""
     1556             then do:
     1557               undo move_block, retry move_block .
     1558             end.
     1559           end.
     1560         end.
     1561       end.
     1562       else do:
     1563         for each buf_temp-diasize-handle
     1564         on error undo move_block, retry move_block
     1565         :
     1566           assign
     1567             v-object-handle = buf_temp-diasize-handle.handle-value
     1568           .
     1569           if v-object-handle <> v-diasize-resize-button
     1570           then do:
     1571             assign
     1572               v-object-handle :col = v-object-handle :col + p-change-value
     1573               no-error .
     1574             if error-status :error
     1575             or error-status :get-message(1) <> ""
     1576             then do:
     1577               undo move_block, retry move_block .
     1578             end.
     1579           end.
     1580         end.
     1581         for each buf_temp-browse-handle
     1582           where buf_temp-browse-handle.browse-type = 'width':u
     1583         on error undo move_block, retry move_block
     1584         :
     1585           assign
     1586             buf_temp-browse-handle.browse-handle :width
     1587               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1588             no-error .
     1589           if error-status :error
     1590           or error-status :get-message(1) <> ""
     1591           then do:
     1592             undo move_block, retry move_block .
     1593           end.
     1594         end.
     1595         assign
     1596           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1597           no-error .
     1598         if error-status :error
     1599         or error-status :get-message(1) <> ""
     1600         then do:
     1601           undo move_block, retry move_block.
     1602         end.
     1603         assign
     1604           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1605         no-error .
     1606         if error-status :error
     1607         or error-status :get-message(1) <> ""
     1608         then do:
     1609           undo move_block, retry move_block.
     1610         end.
     1611         if frame Dialog-Frame :scrollable = true
     1612         then do:
     1613           assign
     1614             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1615           no-error .
     1616           if error-status :error
     1617           or error-status :get-message(1) <> ""
     1618           then do:
     1619             undo move_block, retry move_block.
     1620           end.
     1621         end.
     1622       end.
     1623       if p-move-resize
     1624       then do:
     1625         run diasize_position-resize-button in this-procedure .
     1626       end.
     1627       if v-diasize-wndstore = true
     1628       then do:
     1629         if connected("ub") = true
     1630         then do:
     1631           define variable v-cntxt-db-num        as integer   no-undo .
     1632           define variable v-cntxt-userid        as character no-undo .
     1633           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1634                                             , OUTPUT v-cntxt-userid
     1635                                             ) .
     1636           run gbl/wndsizew.p
     1637             (input  v-cntxt-db-num
     1638             ,input  v-cntxt-userid
     1639             ,input  v-diasize-proc-name
     1640             ,input  'width':u
     1641             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1642             ) .
     1643         end.
     1644       end.
     1645     end.
     1646     assign
     1647       v-diasize-change-size = false
     1648     .
     1649   end procedure.
     1650   procedure diasize_set-width :
     1651     define input  parameter p-new-width  as decimal   no-undo .
     1652     define input  parameter p-move-resize as logical   no-undo .
     1653     do
     1654     on error undo, return error return-value
     1655     :
     1656       run diasize_change-width in this-procedure
     1657         (input  (p-new-width - frame Dialog-Frame :width)
     1658         ,input  p-move-resize
     1659         ) .
     1660     end.
     1661   end procedure.
     1662   procedure diasize_position-resize-button :
     1663     do with frame Dialog-Frame
     1664     :
     1665       hide v-diasize-resize-button .
     1666       assign
     1667         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1668                     - 1
     1669                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1670         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1671                     - 1
     1672                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1673       .
     1674       view v-diasize-resize-button .
     1675     end.
     1676   end procedure.
     1677   on alt-right anywhere
     1678   do:
     1679     run diasize_change-width in this-procedure
     1680       (input 1
     1681       ,input true
     1682       ) .
     1683     return no-apply .
     1684   end.
     1685   on alt-left anywhere
     1686   do:
     1687     run diasize_change-width in this-procedure
     1688       (input -1
     1689       ,input true
     1690       ) .
     1691     return no-apply .
     1692   end.
     1693   on alt-down anywhere
     1694   do:
     1695     run diasize_change-height in this-procedure
     1696       (input 1
     1697       ,input true
     1698       ) .
     1699     return no-apply .
     1700   end.
     1701   on alt-up anywhere
     1702   do:
     1703     run diasize_change-height in this-procedure
     1704       (input -1
     1705       ,input true
     1706       ) .
     1707     return no-apply .
     1708   end.
     1709   on alt-enter of frame Dialog-Frame
     1710   do:
     1711     run diasize_maximize in this-procedure
     1712       (input  ?
     1713       ).
     1714     return no-apply .
     1715   end.
     1716   procedure diasize_end-move :
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720       define variable v-row-delta as decimal   no-undo .
     1721       define variable v-col-delta as decimal   no-undo .
     1722       define variable v-new-row as decimal   no-undo .
     1723       define variable v-new-col as decimal   no-undo .
     1724       assign
     1725         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1726         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1727       .
     1728       assign
     1729         v-row-delta = v-new-row - frame Dialog-Frame :height
     1730         v-col-delta = v-new-col - frame Dialog-Frame :width
     1731       .
     1732       run diasize_change-height in this-procedure
     1733         (input v-row-delta
     1734         ,input true
     1735         ) .
     1736       run diasize_change-width in this-procedure
     1737         (input v-col-delta
     1738         ,input true
     1739         ) .
     1740     end.
     1741   end procedure.
     1742   procedure diasize_maximize :
     1743     define input  parameter p-action as logical   no-undo .
     1744     do
     1745     on error undo, return error return-value
     1746     :
     1747       if p-action = ?
     1748       then do:
     1749         if v-diasize-need-maximize = true
     1750         then do:
     1751           assign
     1752             p-action = true
     1753           .
     1754         end.
     1755         else do:
     1756           assign
     1757             p-action = false
     1758           .
     1759         end.
     1760       end.
     1761       if p-action = true
     1762       then do:
     1763         run diasize_change-height in this-procedure
     1764           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1765               - frame Dialog-Frame :height-chars
     1766           ,input true
     1767           ) .
     1768         run diasize_change-width in this-procedure
     1769           (input session :width-chars
     1770               - frame Dialog-Frame :width-chars
     1771           ,input true
     1772           ) .
     1773         assign
     1774           v-diasize-need-maximize = false
     1775         .
     1776       end.
     1777       else do:
     1778         run diasize_change-width in this-procedure
     1779           (input v-diasize-orig-frame-width
     1780               - frame Dialog-Frame :width-chars
     1781           ,input true
     1782           ) .
     1783         run diasize_change-height in this-procedure
     1784           (input v-diasize-orig-frame-height
     1785               - frame Dialog-Frame :height-chars
     1786           ,input true
     1787           ) .
     1788         assign
     1789           v-diasize-need-maximize = true
     1790         .
     1791       end.
     1792     end.
     1793   end procedure.
     1794   procedure diasize_restore-orig-size :
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       assign
     1799         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1800         v-diasize-current-frame-height = frame Dialog-Frame :height
     1801       .
     1802       run diasize_set-height in this-procedure
     1803         (input  v-diasize-orig-frame-height
     1804         ,input  true
     1805         ) .
     1806       run diasize_set-width in this-procedure
     1807         (input  v-diasize-orig-frame-width
     1808         ,input  true
     1809         ) .
     1810     end.
     1811   end procedure.
     1812   procedure diasize_restore-current-size :
     1813     do
     1814     on error undo, return error return-value
     1815     :
     1816       run diasize_set-height in this-procedure
     1817         (input  v-diasize-current-frame-height
     1818         ,input  true
     1819         ) .
     1820       run diasize_set-width in this-procedure
     1821         (input  v-diasize-current-frame-width
     1822         ,input  true
     1823         ) .
     1824     end.
     1825   end procedure.
     1826   procedure diasize_set-browse-handle :
     1827     define input  parameter p-browse-handle as handle   no-undo .
     1828     define buffer buf_temp-browse-handle for temp-browse-handle .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832       assign
     1833         v-diasize-browse-handle = p-browse-handle
     1834       .
     1835       for each buf_temp-browse-handle
     1836       on error undo, return error return-value
     1837       :
     1838         delete buf_temp-browse-handle .
     1839       end.
     1840     end.
     1841   end procedure.
     1842   procedure diasize_add_browse :
     1843     define input  parameter p-browse-type   as character no-undo .
     1844     define input  parameter p-browse-handle as handle    no-undo .
     1845     define buffer buf_temp-browse-handle for temp-browse-handle .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       assign
     1850         v-diasize-browse-number = v-diasize-browse-number + 1
     1851       .
     1852       create buf_temp-browse-handle .
     1853       assign
     1854         buf_temp-browse-handle.browse-type   = p-browse-type
     1855         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1856         buf_temp-browse-handle.browse-handle = p-browse-handle
     1857       .
     1858     end.
     1859   end procedure.
     1860   procedure diasize_init :
     1861     define variable v-default-value    as logical   no-undo .
     1862     define variable v-restore-saved    as logical   no-undo .
     1863     define variable v-resize-value-str as character no-undo .
     1864     do
     1865     on error undo, return error return-value
     1866     :
     1867       do with frame Dialog-Frame
     1868       :
     1869         assign
     1870           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1871           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1872           v-diasize-browse-handle     = browse brw-auto-num-sec :handle
     1873         .
     1874         create button v-diasize-resize-button
     1875         assign
     1876           parent        = frame Dialog-Frame :first-child
     1877           label         = "s"
     1878           height-pixels = 16
     1879           width-pixels  = 16
     1880           visible       = true
     1881           sensitive     = true
     1882           movable       = true
     1883           triggers:
     1884             on end-move persistent run diasize_end-move in this-procedure .
     1885           end triggers.
     1886         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1887         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1888         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1889         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1890         assign
     1891           v-diasize-wndmax = false
     1892         .
     1893         if connected("ub") = true
     1894         then do:
     1895           define variable v-cntxt-db-num        as integer   no-undo .
     1896           define variable v-cntxt-userid        as character no-undo .
     1897           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1898                                             , OUTPUT v-cntxt-userid
     1899                                             ) .
     1900           run gbl/wndpar_r.p
     1901             (input  v-cntxt-db-num
     1902             ,input  v-cntxt-userid
     1903             ,input  'wndmax':U
     1904             ,output v-diasize-wndmax
     1905             ,output v-default-value
     1906             ) .
     1907         end.
     1908         assign
     1909           v-diasize-wndstore = false
     1910         .
     1911         if connected("ub") = true
     1912         then do:
     1913           run gbl/wndpar_r.p
     1914             (input  v-cntxt-db-num
     1915             ,input  v-cntxt-userid
     1916             ,input  'wndstore':U
     1917             ,output v-diasize-wndstore
     1918             ,output v-default-value
     1919             ) .
     1920         end.
     1921         assign
     1922           v-diasize-proc-name = entry(1, program-name(2), '.')
     1923         .
     1924         if v-diasize-wndstore = true
     1925         then do:
     1926           assign
     1927             v-restore-saved = false
     1928           .
     1929           if connected("ub") = true
     1930           then do:
     1931             run gbl/wndsizer.p
     1932               (input  v-cntxt-db-num
     1933               ,input  v-cntxt-userid
     1934               ,input  v-diasize-proc-name
     1935               ,input  'height':u
     1936               ,output v-resize-value-str
     1937               ) .
     1938             if v-resize-value-str <> '':U
     1939             then do:
     1940               run diasize_change-height in this-procedure
     1941                 (input  integer(v-resize-value-str)
     1942                 ,input  true
     1943                 ) .
     1944               assign
     1945                 v-restore-saved = true
     1946               .
     1947             end.
     1948           end.
     1949           if connected("ub") = true
     1950           then do:
     1951             run gbl/wndsizer.p
     1952               (input  v-cntxt-db-num
     1953               ,input  v-cntxt-userid
     1954               ,input  v-diasize-proc-name
     1955               ,input  'width':u
     1956               ,output v-resize-value-str
     1957               ) .
     1958             if v-resize-value-str <> '':U
     1959             then do:
     1960               run diasize_change-width in this-procedure
     1961                 (input  integer(v-resize-value-str)
     1962                 ,input  true
     1963                 ) .
     1964               assign
     1965                 v-restore-saved = true
     1966               .
     1967             end.
     1968           end.
     1969           if v-restore-saved <> true
     1970           then do:
     1971             if v-diasize-wndmax = true
     1972             then do:
     1973               run diasize_maximize in this-procedure
     1974                 (input  true
     1975                 ) .
     1976             end.
     1977           end.
     1978         end.
     1979         else do:
     1980           if v-diasize-wndmax = true
     1981           then do:
     1982             run diasize_maximize in this-procedure
     1983               (input  true
     1984               ) .
     1985           end.
     1986         end.
     1987       end.
     1988     end.
     1989   end procedure.
     1990   procedure diasize_need-full-display :
     1991     define output parameter p-need-full-display as logical   no-undo .
     1992     do
     1993     on error undo, return error return-value
     1994     :
     1995       assign
     1996         p-need-full-display = v-diasize-need-full-display
     1997       .
     1998       assign
     1999         v-diasize-need-full-display = false
     2000       .
     2001     end.
     2002   end procedure.
     2003   procedure get-context :
     2004      define output parameter p-db-num as integer          no-undo.
     2005      define output parameter p-user-id as character        no-undo.
     2006      define variable v-login               as character    no-undo.
     2007      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2008      define buffer buf_user-login  for ub.user-login .
     2009      do
     2010      on error undo, return error
     2011      :
     2012            FIND FIRST buf_sys-ctrl no-lock.
     2013            ASSIGN
     2014               v-login = USERID("ub")
     2015               p-db-num = buf_sys-ctrl.db-num
     2016            .
     2017            FIND FIRST buf_user-login
     2018                 WHERE buf_user-login.db-num = p-db-num
     2019                   AND buf_user-login.user-login = v-login
     2020                 no-lock
     2021                 no-error
     2022                 .
     2023            IF AVAILABLE buf_user-login
     2024            THEN DO:
     2025               assign
     2026                  p-user-id = buf_user-login.user-id
     2027               .
     2028            END.
     2029      end.
     2030   end procedure.
     2031       run diasize_init in this-procedure .
     2032   MAIN-BLOCK:
     2033   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2034      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2035      if parmode = 'ПРОСМОТР':U then
     2036      do:
     2037         find first ub.auto-tank where recid(ub.auto-tank) = parrecid no-lock.
     2038         find first error_auto-tank-attr no-lock
     2039            where error_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2040            and error_auto-tank-attr.attr-code = "auto-error" no-error.
     2041         find first temp_auto-tank-attr no-lock
     2042            where temp_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2043            and temp_auto-tank-attr.attr-code = "auto-temp" no-error.
     2044         find first type_auto-tank-attr no-lock
     2045            where type_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2046            and type_auto-tank-attr.attr-code = "autotype-AC" no-error.
     2047         find first neck_auto-tank-attr no-lock
     2048            where neck_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2049            and neck_auto-tank-attr.attr-code = "autotype-neck" no-error.
     2050         find first sep_auto-tank-attr no-lock
     2051            where sep_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2052            and sep_auto-tank-attr.attr-code = "auto-sep" no-error.
     2053         find first valve_auto-tank-attr no-lock
     2054            where valve_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2055            and valve_auto-tank-attr.attr-code = "valve" no-error.
     2056         find first con-sleeve_auto-tank-attr no-lock
     2057            where con-sleeve_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2058            and con-sleeve_auto-tank-attr.attr-code = "con-sleeve" no-error.
     2059      end.
     2060      if parmode = 'ИЗМЕНЕНИЕ':U then
     2061      do:
     2062         do transaction:
     2063            find first ub.auto-tank where recid(ub.auto-tank) = parrecid exclusive-lock.
     2064            find first error_auto-tank-attr exclusive-lock
     2065               where error_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2066               and error_auto-tank-attr.attr-code = "auto-error" no-error.
     2067            find first temp_auto-tank-attr exclusive-lock
     2068               where temp_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2069               and temp_auto-tank-attr.attr-code = "auto-temp" no-error.
     2070            find first type_auto-tank-attr exclusive-lock
     2071               where type_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2072               and type_auto-tank-attr.attr-code = "autotype-AC" no-error.
     2073            find first neck_auto-tank-attr exclusive-lock
     2074               where neck_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2075               and neck_auto-tank-attr.attr-code = "autotype-neck" no-error.
     2076            find first sep_auto-tank-attr exclusive-lock
     2077               where sep_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2078               and sep_auto-tank-attr.attr-code = "auto-sep" no-error.
     2079            find first valve_auto-tank-attr exclusive-lock
     2080               where valve_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2081               and valve_auto-tank-attr.attr-code = "valve" no-error.
     2082            find first con-sleeve_auto-tank-attr exclusive-lock
     2083               where con-sleeve_auto-tank-attr.auto-num = ub.auto-tank.auto-num
     2084               and con-sleeve_auto-tank-attr.attr-code = "con-sleeve" no-error.
     2085         end.
     2086      end.
     2087      if parmode = 'ПРОСМОТР':U or
     2088         parmode = 'ИЗМЕНЕНИЕ':U then
     2089      do:
     2090         assign
     2091            varauto-num  = ub.auto-tank.auto-num
     2092            varname      = ub.auto-tank.NAME
     2093            varps        = ub.auto-tank.ps
     2094            varauto-firm = string (ub.auto-tank.firm-type) + " " + string (ub.auto-tank.firm-code)
     2095            c-AC-type    = ub.auto-tank.type-AC
     2096            C-neck       = ub.auto-tank.type-neck.
     2097         if available error_auto-tank-attr then f-error = decimal(error_auto-tank-attr.attr-value).
     2098         if available temp_auto-tank-attr then f-temp = decimal(temp_auto-tank-attr.attr-value) .
     2099         if available sep_auto-tank-attr then sep = logical (sep_auto-tank-attr.attr-value) .
     2100         if available valve_auto-tank-attr then valve = logical (valve_auto-tank-attr.attr-value) .
     2101         if available con-sleeve_auto-tank-attr then con-sleeve = decimal(con-sleeve_auto-tank-attr.attr-value) .
     2102         if varauto-firm = "" or varauto-firm = ? then
     2103         do:
     2104            FOR first auto-tank-attr no-lock where auto-tank-attr.attr-code = "auto-firm"
     2105               and auto-tank-attr.auto-num = ub.auto-tank.auto-num:
     2106               varauto-firm = auto-tank-attr.attr-value .
     2107            end.
     2108         end.
     2109      end.
     2110      run init-proc in this-procedure .
     2111      RUN local-enable_UI.
     2112      WAIT-FOR GO OF FRAME Dialog-Frame.
     2113   END.
     2114   RUN disable_UI.
     2115   PROCEDURE disable_UI :
     2116      HIDE FRAME Dialog-Frame.
     2117   END PROCEDURE.
     2118   PROCEDURE enable_UI :
     2119      DISPLAY SEP varname varauto-num varauto-firm c-AC-type C-neck f-error f-temp
     2120         varPS
     2121         WITH FRAME Dialog-Frame.
     2122      ENABLE b-cancel b-help RECT-1 RECT-2 SEP c-AC-type b-choose-auto-firm C-neck
     2123         f-error f-temp varPS b-view-sec brw-auto-num-sec
     2124         WITH FRAME Dialog-Frame.
     2125      VIEW FRAME Dialog-Frame.
     2126      OPEN QUERY brw-auto-num-sec FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK.
     2127   END PROCEDURE.
     2128   PROCEDURE init-proc :
     2129      define variable v-diam   as character no-undo .
     2130      define variable v-name   as decimal   no-undo .
     2131      define variable v-lenght as character no-undo .
     2132      define variable v-width  as character no-undo .
     2133      FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK:
     2134         DELETE tt_auto-tank-sec.
     2135      END.
     2136      v-auto-num = if available ub.auto-tank then ub.auto-tank.auto-num else varauto-num:screen-value in frame Dialog-Frame .
     2137      FOR EACH buf_auto-section WHERE buf_auto-section.auto-num = v-auto-num NO-LOCK:
     2138         CREATE tt_auto-tank-sec.
     2139         ASSIGN
     2140            tt_auto-tank-sec.sec-num     = buf_auto-section.section-num
     2141            tt_auto-tank-sec.brutto-qnty = buf_auto-section.brutto-qnty
     2142            tt_auto-tank-sec.add-volume  = buf_auto-section.add-volume
     2143         NO-ERROR.
     2144      END.
     2145      FIND FIRST tt_auto-tank-sec WHERE tt_auto-tank-sec.sec-num = 1 NO-LOCK NO-ERROR.
     2146      IF AVAILABLE tt_auto-tank-sec THEN
     2147      DO:
     2148         REPOSITION brw-auto-num-sec TO RECID recid(tt_auto-tank-sec) NO-ERROR.
     2149      END.
     2150      apply "value-changed" to brw-auto-num-sec in frame dialog-frame.
     2151   END PROCEDURE.
     2152   PROCEDURE local-enable_UI :
     2153      RUN enable_ui IN THIS-PROCEDURE.
     2154      if parmode = 'ДОБАВЛЕНИЕ':U or parmode = 'ИЗМЕНЕНИЕ':U then
     2155      do:
     2156         enable b-choose-auto-firm c-AC-type varPS varauto-num varname varauto-firm b-save b-add-sec b-chg-sec b-del-sec with frame Dialog-Frame.
     2157         assign
     2158            varps:read-only = no.
     2159         if c-AC-type = 1 then
     2160         do:
     2161            enable
     2162               C-neck
     2163               f-error
     2164               f-temp
     2165               sep
     2166               with frame Dialog-Frame .
     2167            display
     2168               f-error
     2169               f-temp
     2170               with frame Dialog-Frame .
     2171         end.
     2172         if sep then
     2173         do:
     2174            disable
     2175               C-neck
     2176               f-error
     2177               f-temp
     2178               with frame Dialog-Frame .
     2179         end.
     2180      end.
     2181      hide
     2182       valve
     2183       con-sleeve
     2184       in frame Dialog-Frame .
     2185      apply "value-changed" to c-ac-type in frame dialog-frame.
     2186      OPEN QUERY brw-auto-num-sec FOR EACH tt_auto-tank-sec EXCLUSIVE-LOCK.
     2187      if parmode = 'ПРОСМОТР':U
     2188      then do :
     2189        disable
     2190            b-choose-auto-firm c-AC-type varPS varauto-num varname varauto-firm sep
     2191            C-neck f-error f-temp valve con-sleeve
     2192            with frame Dialog-Frame .
     2193      end .
     2194   END PROCEDURE.
