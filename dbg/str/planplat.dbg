     4664     assign frame Dialog-Frame:title = "Планирование платежей.  Фирма: (" + string(v-cntxt-host-code-obj) + ")":U + chr(32) + clients.obj-name  .
     4665     if Sel-Contr = "all" and Sel-Client = "all"  then RUN OpenBr1AllContr( p-open-query, p-find-next, p-find-condition) .
     4666     else                                              RUN OpenBr1SelContr( p-open-query, p-find-next, p-find-condition) .
     4667     run proc-mark1 in this-procedure .
