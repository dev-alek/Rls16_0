      524   procedure uf-get :
      525     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      526     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      527     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      528     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      529     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      530     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      531     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      532     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      533     do
      534     on error undo, return error
      535     :
      536       define buffer buf_usr-flt for ubflt.usr-flt .
      537       define variable v-use-List_     as logical   no-undo .
      538       define variable v-type-List_     as character no-undo .
      539       define variable v-format-List_   as character no-undo .
      540       define variable v-use-Naim      as logical   no-undo .
      541       define variable v-type-Naim      as character no-undo .
      542       define variable v-format-Naim    as character no-undo .
      543       define variable v-use-print-graft as logical   no-undo .
      544       define variable v-use-sort-gr     as logical   no-undo .
      545       define variable v-use-type-price  as logical   no-undo .
      546       define variable v-use-type-val    as logical   no-undo .
      547       define variable v-label          as character no-undo .
      548       define variable v-tooltip        as character no-undo .
      549       define variable v-user-can-edit  as logical   no-undo .
      550       define variable v-output-display as logical   no-undo .
      551       define variable v-other          as character no-undo .
      552       run uf-name in this-procedure
      553          (input  entry(1, p-code, chr(4))
      554         ,output v-use-List_
      555         ,output v-type-List_
      556         ,output v-format-List_
      557         ,output v-use-Naim
      558         ,output v-type-Naim
      559         ,output v-format-Naim
      560         ,output v-use-print-graft
      561         ,output v-use-sort-gr
      562         ,output v-use-type-price
      563         ,output v-use-type-val
      564         ,output v-label
      565         ,output v-tooltip
      566         ,output v-user-can-edit
      567         ,output v-output-display
      568         ,output v-other
      569         ) no-error .
      570       if error-status :error then do:
      571         undo, return error return-value .
      572       end.
      573       find first buf_usr-flt no-lock where
      574                  buf_usr-flt.Call-point     = p-code AND
      575                  buf_usr-flt.user-name       = p-user-name
      576         no-error .
      577       if avail buf_usr-flt then do:
      578         assign
      579         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      580         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      581         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      582         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      583         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      584         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      585         .
      586       end.
      587       else do:
      588         assign
      589         p-List_        = (if v-use-List_       then "":U                    else ?)
      590         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      591         p-print-graft  = (if v-use-print-graft then no                      else ?)
      592         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      593         p-type-price   = (if v-use-type-price  then no                      else ?)
      594         p-type-val     = (if v-use-List_       then no                      else ?)
      595         .
      596       end.
      597     end.
      598   end procedure.
      599   procedure uf-set :
      600     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      601     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      602     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      603     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      604     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      605     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      606     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      607     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      608     do
      609     on error undo, return error
      610     :
      611       define buffer buf_usr-flt for ubflt.usr-flt .
      612       define variable v-use-List_     as logical   no-undo .
      613       define variable v-type-List_     as character no-undo .
      614       define variable v-format-List_   as character no-undo .
      615       define variable v-use-Naim      as logical   no-undo .
      616       define variable v-type-Naim      as character no-undo .
      617       define variable v-format-Naim    as character no-undo .
      618       define variable v-use-print-graft as logical   no-undo .
      619       define variable v-use-sort-gr   as logical   no-undo .
      620       define variable v-use-type-price as logical   no-undo .
      621       define variable v-use-type-val  as logical   no-undo .
      622       define variable v-tooltip        as character no-undo .
      623       define variable v-label          as character no-undo .
      624       define variable v-user-can-edit  as logical   no-undo .
      625       define variable v-output-display as logical   no-undo .
      626       define variable v-other          as character no-undo .
      627       run uf-name in this-procedure
      628         (input  entry(1, p-code, chr(4))
      629         ,output v-use-List_
      630         ,output v-type-List_
      631         ,output v-format-List_
      632         ,output v-use-Naim
      633         ,output v-type-Naim
      634         ,output v-format-Naim
      635         ,output v-use-print-graft
      636         ,output v-use-sort-gr
      637         ,output v-use-type-price
      638         ,output v-use-type-val
      639         ,output v-label
      640         ,output v-tooltip
      641         ,output v-user-can-edit
      642         ,output v-output-display
      643         ,output v-other
      644         ) no-error .
      645       if error-status :error then do:
      646         undo, return error return-value .
      647       end.
      648       find first buf_usr-flt where
      649                  buf_usr-flt.Call-point     = p-code AND
      650                  buf_usr-flt.user-name       = p-user-name
      651         no-error .
      652       if not avail buf_usr-flt then do:
      653           create buf_usr-flt .
      654           assign
      655           buf_usr-flt.call-point = p-code
      656           buf_usr-flt.user-name  = p-user-name
      657           .
      658       end.
      659       if avail buf_usr-flt then do:
      660        assign
      661        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      662        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      663        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      664        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      665        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      666        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      667       .
      668       release buf_usr-flt.
      669       end.
      670       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      671     end.
      672   end procedure.
      673   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674     define variable v-cntxt-db-num        as integer   no-undo .
      675     define variable v-cntxt-userid        as character no-undo .
      676     define variable v-cntxt-level         as character no-undo .
      677     define variable v-cntxt-host-code-obj as integer   no-undo .
      678     define variable v-cntxt-obj-type      as character no-undo .
      679     define variable v-cntxt-obj-code      as integer   no-undo .
      680     define variable v-cntxt-db-num-obj    as integer   no-undo .
      681     define variable v-cntxt-is-admin      as logical   no-undo .
      682   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683     run mainmenu_getcntxt in parparentproc
      684       (output v-cntxt-db-num
      685       ,output v-cntxt-userid
      686       ,output v-cntxt-level
      687       ,output v-cntxt-host-code-obj
      688       ,output v-cntxt-obj-type
