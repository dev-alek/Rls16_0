     4123           self :screen-value = string(v-new-sv-date) .
     4124         .
     4125       end.
     4126     end.
     4127     return no-apply .
     4128   end.
     4129   on ctrl-e of sch-date in frame Dialog-Frame
     4130   do:
     4131     if (can-query (self, "sensitive")
     4132        and
     4133        self :sensitive = true
     4134        )
     4135     or (can-query (self, "read-only")
     4136        and
     4137        self :read-only = false
     4138        )
     4139     then do:
     4140       if self :handle <> focus :handle
     4141       then do:
     4142         apply "entry":u to self .
     4143       end.
     4144       define variable v-curr-sv-date as date no-undo .
     4145       define variable v-new-sv-date  as date no-undo .
     4146       assign
     4147         v-curr-sv-date = date(self :screen-value) no-error
     4148       .
     4149       if v-curr-sv-date = ?
     4150       then do:
     4151         run gbl/getcurdt.p
     4152           (output v-curr-sv-date
     4153           ) .
     4154       end.
     4155       if v-curr-sv-date <> ?
     4156       then do:
     4157         run gbl/lastdate.p
     4158           (input  v-curr-sv-date
     4159           ,output v-new-sv-date
     4160           ).
     4161         assign
     4162           self :screen-value = string(v-new-sv-date) .
     4163         .
     4164       end.
     4165     end.
     4166     return no-apply .
     4167   end.
     4168   on ctrl-f of sch-date in frame Dialog-Frame
     4169   do:
     4170     if (can-query (self, "sensitive")
     4171        and
     4172        self :sensitive = true
     4173        )
     4174     or (can-query (self, "read-only")
     4175        and
     4176        self :read-only = false
     4177        )
     4178     then do:
     4179       if self :handle <> focus :handle
     4180       then do:
     4181         apply "entry":u to self .
     4182       end.
     4183       define variable v-ok            as logical   no-undo .
     4184       define variable v-curr-sv-date  as date      no-undo .
     4185       define variable v-description   as character no-undo .
     4186       assign
     4187         v-curr-sv-date = date(self :screen-value) no-error
     4188       .
     4189       if v-curr-sv-date = ?
     4190       then do:
     4191         run gbl/getcurdt.p
     4192           (output v-curr-sv-date
     4193           ) .
     4194       end.
     4195       if v-curr-sv-date <> ?
     4196       then do:
     4197         run gbl/d-inpday.w
     4198           (input ?
     4199           ,input "Выбор даты"
     4200           ,input v-description
     4201           ,input ""
     4202           ,input-output v-curr-sv-date
     4203           ,output v-ok
     4204           ).
     4205         if v-ok = true
     4206         then do:
     4207           assign
     4208             self :screen-value = string(v-curr-sv-date) .
     4209           .
     4210         end.
     4211       end.
     4212     end.
     4213     return no-apply .
     4214   end.
