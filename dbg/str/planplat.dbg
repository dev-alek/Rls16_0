      903     define variable v-order-col  as character no-undo .
      904     define variable v-order-col1 as character no-undo .
      905     define variable v-size-col1 as decimal   no-undo .
      906     define variable v-size-col2 as decimal   no-undo .
      907     define variable v-size-col3 as decimal   no-undo .
      908     define variable v-size-col4 as decimal   no-undo .
      909     define variable v-size-col5 as decimal   no-undo .
