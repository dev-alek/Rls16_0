     1118        SIZE 8 BY 1.82 NO-UNDO.
     1119   DEFINE VARIABLE Sel-Contr AS CHARACTER INITIAL "all"
     1120        VIEW-AS RADIO-SET VERTICAL
     1121        RADIO-BUTTONS
     1122             "Все", "all",
     1123   "Выбор", "sel"
     1124        SIZE 8 BY 1.82 NO-UNDO.
     1125   DEFINE VARIABLE Sel-Status AS CHARACTER INITIAL "new"
     1126        VIEW-AS RADIO-SET VERTICAL
     1127        RADIO-BUTTONS
     1128             "Все", "all",
     1129   "Не факт", "new",
     1130   "Факт", "fact"
     1131        SIZE 10 BY 1.74 NO-UNDO.
     1132   DEFINE RECTANGLE RECT-1
     1133        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1134        SIZE 132.75 BY 2.33.
     1135   DEFINE RECTANGLE RECT-status
     1136        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1137        SIZE 133 BY 2.22.
     1138   DEFINE QUERY Fin-Doc-List FOR
     1139         buf_fin-doc,
     1140         temp-contr1 SCROLLING.
     1141   DEFINE QUERY Fin-Ob-List FOR
     1142         buf_fin-ob,
     1143         temp-contr SCROLLING.
     1144   DEFINE BROWSE Fin-Doc-List
     1145     QUERY Fin-Doc-List DISPLAY
     1146        mark-string(recid(ub.buf_fin-doc), 1)    COLUMN-LABEL '*'  FORMAT "x(1)"
     1147        buf_fin-doc.fin-doc-type    COLUMN-LABEL 'Тип'  Format "x(3)"
     1148        buf_fin-doc.prn-doc-code    COLUMN-LABEL '№ док-та'  Format "x(9)"
     1149        buf_fin-doc.doc-date    COLUMN-LABEL 'Создан'  format "99/99/99"
     1150        buf_fin-doc.sum-doc   COLUMN-LABEL 'Сумма в валюте док-та'
     1151        (buf_fin-doc.payer-type + ' ' + string(buf_fin-doc.payer-code))    COLUMN-LABEL 'Код плател.'  Format "x(16)"
     1152        buf_fin-doc.payer-name   COLUMN-LABEL 'Плательщик' Format "x(50)"
     1153        (contract-id( buf_fin-doc.contract-code))  @ p-contr COLUMN-LABEL 'Договор' Format "x(16)"
     1154        buf_fin-doc.con-sum-contr   COLUMN-LABEL 'Сумма связи (в.д.)'  Format "->>>,>>>,>>>,>>>.99"
     1155        get-ostat(buf_fin-doc.sum-contr, buf_fin-doc.con-sum-contr)   COLUMN-LABEL 'Своб. остаток (в.д.)'  Format "->>>,>>>,>>>,>>>.99"
     1156        (get-currency(buf_fin-doc.curr-code)) @ l-curr  COLUMN-LABEL 'Вал' Format "x(3)"
     1157        buf_fin-doc.sum-doc   COLUMN-LABEL 'Сумма в валюте док-та'
     1158        (buf_fin-doc.receiver-type + ' ' + string(buf_fin-doc.receiver-code))    COLUMN-LABEL 'Код получ.'  Format "x(10)"
     1159        buf_fin-doc.receiver-name   COLUMN-LABEL 'Получатель' Format "x(50)"
     1160        buf_fin-doc.perm-date    COLUMN-LABEL 'Разр.'  format "99/99/99"
     1161        buf_fin-doc.pay-date    COLUMN-LABEL 'Платеж'  format "99/99/99"
     1162        buf_fin-doc.fact-date   COLUMN-LABEL 'Закрыт' format "99/99/99"
     1163        buf_fin-doc.status_    COLUMN-LABEL 'Статус'  Format "x(6)"
     1164        (get-currency(buf_fin-doc.curr-code)) @ l-curr  COLUMN-LABEL 'Вал' Format "x(3)"
     1165        get-curr-sum(s-curr-code, buf_fin-doc.curr-code, buf_fin-doc.contract-curr, buf_fin-doc.sum-contr, buf_fin-doc.sum-rubl, buf_fin-doc.sum-base, buf_fin-doc.sum-doc ) @ p-sum   COLUMN-LABEL 'Сумма в выбр.вал.'  Format "->>>,>>>,>>>,>>>.99"
     1166        buf_fin-doc.fin-ext-doc-type   COLUMN-LABEL 'Расш.тип' Format "x(3)"
     1167        buf_fin-doc.fin-doc-code   COLUMN-LABEL 'Вн.N'
     1168        (if buf_fin-doc.obj-code = 0 then '' else (buf_fin-doc.obj-type + ' ' + string(buf_fin-doc.obj-code)))   COLUMN-LABEL 'Объект'
     1169        enable buf_fin-doc.fin-doc-type
     1170       WITH NO-ROW-MARKERS SEPARATORS SIZE 74 BY 16.07 ROW-HEIGHT-CHARS .78.
     1171   DEFINE BROWSE Fin-Ob-List
     1172     QUERY Fin-Ob-List DISPLAY
     1173         mark-string(recid(ub.buf_fin-ob), 0)    COLUMN-LABEL '*'  FORMAT "x(1)"
     1174        buf_fin-ob.doc-date    COLUMN-LABEL 'Создан'  format "99/99/99"
     1175        buf_fin-ob.sum-doc   COLUMN-LABEL 'Сумма в вал. док-та'
     1176        (buf_fin-ob.payer-type + ' ' + string(buf_fin-ob.payer-code))    COLUMN-LABEL 'Код плател.'  Format "x(16)"
     1177        buf_fin-ob.payer-name   COLUMN-LABEL 'Плательщик'  Format "x(50)"
     1178        (contract-id( buf_fin-ob.contract-code )) @ p-contr   COLUMN-LABEL 'Договор' Format "x(16)"
     1179        buf_fin-ob.prn-doc-code    COLUMN-LABEL '№ док-та'  Format "x(9)"
     1180        buf_fin-ob.doc-type    COLUMN-LABEL 'Т'  Format "x(1)"
     1181        buf_fin-ob.pay-date    COLUMN-LABEL 'Платеж'  format "99/99/99"
     1182        buf_fin-ob.con-sum-contr   COLUMN-LABEL 'Сумма связи (в.д.)'  Format "->>>,>>>,>>>,>>>.99"
     1183        get-ostat(buf_fin-ob.sum-contr, buf_fin-ob.con-sum-contr)   COLUMN-LABEL 'Своб. остаток (в.д.)'  Format "->>>,>>>,>>>,>>>.99"
     1184        buf_fin-ob.fact-date    COLUMN-LABEL 'Закрыт'  format "99/99/99"
     1185        (buf_fin-ob.receiver-type + ' ' + string(buf_fin-ob.receiver-code))    COLUMN-LABEL 'Код получ.'  Format "x(10)"
     1186        buf_fin-ob.receiver-name   COLUMN-LABEL 'Получатель'  Format "x(50)"
     1187        (get-currency(buf_fin-ob.curr-code))  @ l-curr COLUMN-LABEL 'Вал' Format "x(3)"
     1188        get-curr-sum(s-curr-code, buf_fin-ob.curr-code, buf_fin-ob.contract-curr, buf_fin-ob.sum-contract, buf_fin-ob.sum-rubl, buf_fin-ob.sum-base, buf_fin-ob.sum-doc ) @ p-sum  COLUMN-LABEL 'Сумма в выбр.вал.' Format "->>>,>>>,>>>,>>>.99"
     1189        (if buf_fin-ob.obj-code = 0 then '' else (buf_fin-ob.obj-type + ' ' + string(buf_fin-ob.obj-code)))   COLUMN-LABEL 'Объект' Format "x(14)"
     1190        buf_fin-ob.doc-code   COLUMN-LABEL 'Вн.N' Format "x(10)"
     1191        (contract-gen( buf_fin-ob.contract-code))  @ p-gen  COLUMN-LABEL 'Условие генерации' Format "x(50)"
     1192        enable buf_fin-ob.doc-type
     1193       WITH NO-ROW-MARKERS SEPARATORS SIZE 74 BY 16.07 ROW-HEIGHT-CHARS .78.
     1194   DEFINE FRAME Dialog-Frame
     1195        b-quit AT ROW 1 COL 1
     1196        B-conn-add AT ROW 1 COL 11
     1197        B-conn-view AT ROW 1 COL 21
     1198        B-oplat-list AT ROW 1 COL 31
     1199        B-Help AT ROW 1 COL 121
     1200        B-conn-doc AT ROW 2.04 COL 11
     1201        B-view-doc AT ROW 2.04 COL 21
     1202        B-del-doc AT ROW 2.04 COL 31
     1203        B-conn-fo AT ROW 2.04 COL 111
     1204        B-view-fo AT ROW 2.04 COL 121
     1205        Fin-Ob-List AT ROW 3.07 COL 76
     1206        Fin-Doc-List AT ROW 3.11 COL 1.5
     1207        B-mark-2 AT ROW 19.41 COL 1.5
     1208        B-unmark-2 AT ROW 19.41 COL 9.5
     1209        B-allmark-2 AT ROW 19.41 COL 15
     1210        sum-fin-doc AT ROW 19.41 COL 31.5 COLON-ALIGNED
     1211        B-mark AT ROW 19.41 COL 77
     1212        B-unmark AT ROW 19.41 COL 85
     1213        B-allmark AT ROW 19.41 COL 90
     1214        B-oplat AT ROW 19.41 COL 95
     1215        sum-fin-ob AT ROW 19.41 COL 105 COLON-ALIGNED NO-LABEL
     1216        BUTTON-cli AT ROW 20.85 COL 97.88
     1217        sch-code AT ROW 20.93 COL 35.5 COLON-ALIGNED
     1218        RADIO-find-cli AT ROW 20.93 COL 64.5 NO-LABEL
     1219        cli-code AT ROW 20.93 COL 84.5 COLON-ALIGNED
     1220        cli-type AT ROW 20.93 COL 91 COLON-ALIGNED NO-LABEL
     1221        RADIO-find-doc AT ROW 20.96 COL 10.38 NO-LABEL
     1222        BUTTON-curr AT ROW 21.89 COL 120.88
     1223        s-curr-code AT ROW 21.93 COL 110 COLON-ALIGNED NO-LABEL
     1224        sch-date AT ROW 21.96 COL 35.5 COLON-ALIGNED
     1225        cli-name AT ROW 21.96 COL 84.5 COLON-ALIGNED
     1226        Curr-Types AT ROW 23.41 COL 11 NO-LABEL
     1227        Sel-Client AT ROW 23.41 COL 39.5 NO-LABEL
     1228        Sel-Contr AT ROW 23.41 COL 63 NO-LABEL
     1229        date-1 AT ROW 23.41 COL 94.25 COLON-ALIGNED
     1230        Sel-Status AT ROW 23.41 COL 121 NO-LABEL
     1231        B-date AT ROW 24.22 COL 81.5
     1232        date-2 AT ROW 24.3 COL 94.38 COLON-ALIGNED
     1233        mark-num-2 AT ROW 19.41 COL 4.5 NO-LABEL
     1234        mark-num AT ROW 19.41 COL 80 NO-LABEL
     1235        curr-name AT ROW 21.85 COL 115.63 NO-LABEL
     1236        "Договоры:" VIEW-AS TEXT
     1237             SIZE 9.5 BY 1 AT ROW 23.37 COL 51.5
     1238             FGCOLOR 4
     1239        "Валюта:" VIEW-AS TEXT
     1240             SIZE 7.5 BY .93 AT ROW 23.41 COL 1.5
     1241             FGCOLOR 4
     1242        "Платежи:" VIEW-AS TEXT
     1243             SIZE 8.88 BY .93 AT ROW 2.04 COL 2
     1244             FGCOLOR 4
     1245        "Показ в валюте:" VIEW-AS TEXT
     1246             SIZE 16.5 BY .67 AT ROW 20.96 COL 108.5
     1247             FGCOLOR 4
     1248        "Платеж:" VIEW-AS TEXT
     1249             SIZE 8.13 BY .93 AT ROW 23.33 COL 81.88
     1250             FGCOLOR 4
     1251        "Контрагенты:" VIEW-AS TEXT
     1252             SIZE 11 BY 1 AT ROW 23.41 COL 27
     1253             FGCOLOR 4
     1254        "Стат.пл.:" VIEW-AS TEXT
     1255             SIZE 9 BY 1 AT ROW 23.37 COL 110.5
     1256             FGCOLOR 4
     1257        "Фин. обязательства:" VIEW-AS TEXT
     1258             SIZE 22 BY .93 AT ROW 2.04 COL 76.5
     1259             FGCOLOR 4
     1260        "Поиск:" VIEW-AS TEXT
     1261             SIZE 7.38 BY .93 AT ROW 21 COL 1.88
     1262             FGCOLOR 4
     1263        RECT-status AT ROW 23.26 COL 1.25
     1264        RECT-1 AT ROW 20.82 COL 1.38 WIDGET-ID 2
     1265        SPACE(15.87) SKIP(2.77)
     1266       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1267            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1268            TITLE "Планирование платежей"
     1269            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
     1270   ASSIGN
     1271          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1272          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1273   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1274   DO:
     1275     APPLY "END-ERROR":U TO SELF.
     1276   END.
     1277   ON CHOOSE OF B-allmark IN FRAME Dialog-Frame
     1278   DO:
     1279     if num-fin-doc > 1 then do:
     1280       message "У вас выбрано более одного платежа, в этом случае можно выбрать только 1 фин. обязательство!" view-as alert-box ERROR.
     1281       return no-apply.
     1282     end.
     1283     for each temp-fin-ob: delete temp-fin-ob . end.
     1284     assign
     1285       sum-fin-ob = 0
     1286       num-fin-ob = 0
     1287       ind1 = 0
     1288     .
     1289     GET FIRST Fin-Ob-List NO-LOCK .
     1290     DO WHILE AVAILABLE(buf_fin-ob):
     1291       create temp-fin-ob .
     1292       assign
     1293         temp-fin-ob.ri = recid( buf_fin-ob )
     1294         temp-fin-ob.ind = ind1
     1295         ind1 = ind1 + 1
     1296         num-fin-ob = num-fin-ob + 1
     1297         temp-fin-ob.del = no
     1298       .
     1299       assign  sum-fin-ob = sum-fin-ob + get-free-sum(buffer buf_fin-ob) .
     1300       GET next Fin-Ob-List NO-LOCK .
     1301     end.
     1302     if num-fin-ob = 0 then hide mark-num in frame Dialog-Frame.
     1303     else                   display num-fin-ob @ mark-num  with frame Dialog-Frame.
     1304     display sum-fin-ob  with frame Dialog-Frame.
     1305     RUN OpenBr(yes, no, '':U) .
     1306   END.
     1307   ON CHOOSE OF B-allmark-2 IN FRAME Dialog-Frame
     1308   DO:
     1309     if num-fin-ob > 1 then do:
     1310       message "У вас выбрано более одного фин. обязательства, в этом случае можно выбрать только 1 платеж!" view-as alert-box ERROR.
     1311       return no-apply.
     1312     end.
     1313     for each temp-fin-doc: delete temp-fin-doc . end.
     1314     assign
     1315       sum-fin-doc = 0
     1316       num-fin-doc = 0
     1317       ind1 = 0
     1318     .
     1319     GET FIRST Fin-Doc-List NO-LOCK .
     1320     DO WHILE AVAILABLE(buf_fin-doc):
     1321       create temp-fin-doc .
     1322       assign
     1323         temp-fin-doc.ri = recid( buf_fin-doc )
     1324         temp-fin-doc.ind = ind1
     1325         ind1 = ind1 + 1
     1326         num-fin-doc = num-fin-doc + 1
     1327         temp-fin-doc.del = no
     1328       .
     1329       assign  sum-fin-doc = sum-fin-doc + get-free-sum1(buffer buf_fin-doc) .
     1330       GET next Fin-Doc-List NO-LOCK .
     1331     end.
     1332     if num-fin-doc = 0 then hide mark-num-2 in frame Dialog-Frame.
     1333     else                   display num-fin-doc @ mark-num-2  with frame Dialog-Frame.
     1334     display sum-fin-doc  with frame Dialog-Frame.
     1335     RUN OpenBr1(yes, no, '':U) .
     1336   END.
     1337   ON CHOOSE OF B-conn-add IN FRAME Dialog-Frame
     1338   DO:
     1339     if num-fin-ob > 0 and num-fin-doc > 0 then do:
     1340       run proc-check-contract no-error  .
     1341       if error-status:error then return no-apply.
     1342       assign v-list = "" .
     1343       if num-fin-ob = 1 and num-fin-doc > 1 then do:
     1344         find first temp-fin-ob .
     1345         for each temp-fin-doc :
     1346           if v-list = "" then  assign v-list = string(temp-fin-doc.ri) .
     1347           else  assign v-list = v-list + "," + string(temp-fin-doc.ri) .
     1348         end.
     1349         run str/fin-con2.w ( parParentProc, v-cntxt-host-code-obj, temp-fin-ob.ri, v-list, output v-end) .
     1350         if v-end then do:
     1351           for each temp-fin-doc :
     1352             find first fin-doc no-lock where recid (fin-doc) = temp-fin-doc.ri .
     1353             if fin-doc.con-stat = 2 then delete temp-fin-doc .
     1354           end.
     1355           RUN OpenBr(yes, no, '':U) .
     1356           RUN OpenBr1(yes, no, '':U) .
     1357         end.
     1358       end.
     1359       else do:
     1360         find first temp-fin-doc .
     1361         for each temp-fin-ob :
     1362           if v-list = "" then  assign v-list = string(temp-fin-ob.ri) .
     1363           else  assign v-list = v-list + "," + string(temp-fin-ob.ri) .
     1364         end.
     1365         run str/fin-con1.w ( parParentProc, v-cntxt-host-code-obj, temp-fin-doc.ri, v-list, output v-end) .
     1366         if v-end then do:
     1367           for each temp-fin-ob :
     1368             find first fin-ob no-lock where recid (fin-ob) = temp-fin-ob.ri .
     1369             if fin-ob.con-stat = 2 then delete temp-fin-ob .
     1370           end.
     1371           RUN OpenBr(yes, no, '':U) .
     1372           RUN OpenBr1(yes, no, '':U) .
     1373         end.
     1374       end.
     1375     end.
     1376     else do:
     1377       message "Нет выбранных фин. обязательств или платежей!" view-as alert-box error .
     1378     end.
     1379   END.
     1380   ON CHOOSE OF B-conn-doc IN FRAME Dialog-Frame
     1381   DO:
     1382     if available buf_fin-doc then do:
     1383       run str/finconn.w ( input parParentProc, input v-cntxt-host-code-obj, input p-doc-type, input "fin-doc", input string(buf_fin-doc.fin-doc-code)) .
     1384       RUN OpenBr(yes, no, '':U) .
     1385       RUN OpenBr1(yes, no, '':U) .
     1386     end.
     1387   END.
     1388   ON CHOOSE OF B-conn-fo IN FRAME Dialog-Frame
     1389   DO:
     1390     if available buf_fin-ob then do:
     1391       run str/finconn.w ( input parParentProc, input v-cntxt-host-code-obj, input p-doc-type, input "fin-ob", input buf_fin-ob.doc-code) .
     1392       RUN OpenBr(yes, no, '':U) .
     1393       RUN OpenBr1(yes, no, '':U) .
     1394     end.
     1395   END.
     1396   ON CHOOSE OF B-conn-view IN FRAME Dialog-Frame
     1397   DO:
     1398     define variable rr as integer initial 0  no-undo .
     1399     run str/finconn.w ( input parParentProc, input v-cntxt-host-code-obj, input p-doc-type, input "all", input "" ) .
     1400     RUN OpenBr(yes, no, '':U) .
     1401     RUN OpenBr1(yes, no, '':U) .
     1402   END.
     1403   ON CHOOSE OF B-date IN FRAME Dialog-Frame
     1404   DO:
     1405     assign date-1 date-2 .
     1406     if date-1 = ? and date-2 = ? then do:
     1407       assign sel-date = no .
     1408     end.
     1409     else do:
     1410       assign sel-date = yes .
     1411       if date-1 = ? then assign date-1 = 1/1/1900 .
     1412       if date-2 = ? then assign date-2 = 1/1/3000 .
     1413     end.
     1414     RUN OpenBr(yes, no, '':U) .
     1415   END.
     1416   ON CHOOSE OF B-del-doc IN FRAME Dialog-Frame
     1417   DO:
     1418     if not available buf_fin-doc then return.
     1419   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1420   do:
     1421     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1422       (input  v-cntxt-db-num
     1423       ,input  v-cntxt-userid
     1424       ,input  0
     1425       ,input  'actn_fin-doc_deletion':U
     1426       ,input  'firm':U
     1427       ,input  v-cntxt-host-code-obj
     1428       ,input  '':U
     1429       ,input  0
     1430       ,input  0
     1431       ,input  0
     1432       ,input  0
     1433       ,input  true
     1434       ,output g-log
     1435       )  .
     1436   end.
     1437     if not g-log then return.
     1438     find first fin-doc exclusive-lock where recid(fin-doc) = recid(buf_fin-doc) NO-ERROR.
     1439     if not avail fin-doc then return no-apply.
     1440     IF fin-doc.status_ <> 'новый':U  THEN DO:
     1441       MESSAGE "Платеж закрыт - удалять нельзя!"  VIEW-AS ALERT-BOX ERROR.
     1442       RETURN .
     1443     END.
     1444     g-log = no.
     1445     MESSAGE
     1446       "Вы уверены, что хотите удалить платеж N " fin-doc.prn-doc-code " от " string(fin-doc.doc-date,"99/99/9999") "?"
     1447     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE g-log.
     1448     IF g-log <> YES THEN RETURN .
     1449     do on error undo, return on stop undo, return no-apply :
     1450       run trg/findocdl.p ( input parParentProc
     1451                            ,input fin-doc.host-code
     1452                            ,input fin-doc.fin-doc-code
     1453                            ,input no
     1454                            ,input no) no-error.
     1455     end.
     1456     RUN OpenBr(yes, no, '':U) .
     1457     RUN OpenBr1(yes, no, '':U) .
     1458   END.
     1459   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1460   DO:
     1461     if available buf_fin-ob then   do:
     1462       find first temp-fin-ob where temp-fin-ob.ri = recid( buf_fin-ob ) no-error  .
     1463       if available temp-fin-ob then do:
     1464         delete temp-fin-ob .
     1465         assign
     1466           sum-fin-ob = sum-fin-ob - get-free-sum(buffer buf_fin-ob)
     1467           num-fin-ob = num-fin-ob - 1
     1468         .
     1469       end.
     1470       else do:
     1471         if num-fin-doc > 1 and num-fin-ob > 0 then do:
     1472           message "У вас выбрано более одного платежа, в этом случае можно выбрать только 1 фин. обязательство!" view-as alert-box ERROR.
     1473           return no-apply.
     1474         end.
     1475         create temp-fin-ob .
     1476         assign
     1477           temp-fin-ob.ri = recid( buf_fin-ob )
     1478           temp-fin-ob.ind = ind1
     1479           ind1 = ind1 + 1
     1480           num-fin-ob = num-fin-ob + 1
     1481         .
     1482         assign  sum-fin-ob = sum-fin-ob + get-free-sum(buffer buf_fin-ob) .
     1483       end.
     1484       g-log = Fin-Ob-List:refresh() .
     1485       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1486         g-log = Fin-Ob-List:select-next-row ().
     1487         apply "value-changed" to Fin-Ob-List in frame Dialog-Frame.
     1488       end.
     1489       if num-fin-ob = 0 then hide mark-num in frame Dialog-Frame.
     1490       else                   display num-fin-ob @ mark-num  with frame Dialog-Frame.
     1491       display sum-fin-ob  with frame Dialog-Frame.
     1492     end.
     1493     apply "entry" to Fin-Ob-List .
     1494   END.
     1495   ON CHOOSE OF B-mark-2 IN FRAME Dialog-Frame
     1496   DO:
     1497     if available buf_fin-doc then   do:
     1498       find first temp-fin-doc where temp-fin-doc.ri = recid( buf_fin-doc ) no-error  .
     1499       if available temp-fin-doc then do:
     1500         delete temp-fin-doc .
     1501         assign
     1502           sum-fin-doc = sum-fin-doc - get-free-sum1(buffer buf_fin-doc)
     1503           num-fin-doc = num-fin-doc - 1
     1504         .
     1505       end.
     1506       else do:
     1507         if num-fin-ob > 1 and num-fin-doc > 0 then do:
     1508           message "У вас выбрано более одного фин. обязательства, в этом случае можно выбрать только 1 платеж!" view-as alert-box ERROR.
     1509           return no-apply.
     1510         end.
     1511         create temp-fin-doc .
     1512         assign
     1513           temp-fin-doc.ri = recid( buf_fin-doc )
     1514           temp-fin-doc.ind = ind2
     1515           ind2 = ind2 + 1
     1516           num-fin-doc = num-fin-doc + 1
     1517         .
     1518         assign  sum-fin-doc = sum-fin-doc + get-free-sum1(buffer buf_fin-doc) .
     1519       end.
     1520       g-log = Fin-Doc-List:refresh() .
     1521       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1522         g-log = Fin-Doc-List:select-next-row ().
     1523         apply "value-changed" to Fin-Doc-List in frame Dialog-Frame.
     1524       end.
     1525       if num-fin-doc = 0 then hide mark-num-2 in frame Dialog-Frame.
     1526       else                   display num-fin-doc @ mark-num-2  with frame Dialog-Frame.
     1527       display sum-fin-doc  with frame Dialog-Frame.
     1528     end.
     1529     apply "entry" to Fin-Doc-List .
     1530   END.
     1531   ON CHOOSE OF B-oplat IN FRAME Dialog-Frame
     1532   DO:
     1533     if num-fin-ob < 1 then do:
     1534       message "Нет выбранных фин. обязательств!" view-as alert-box error .
     1535       return no-apply .
     1536     end.
     1537   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   do:
     1539     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1540       (input  v-cntxt-db-num
     1541       ,input  v-cntxt-userid
     1542       ,input  0
     1543       ,input  'actn_fin-doc_add-def':U
     1544       ,input  'firm':U
     1545       ,input  v-cntxt-host-code-obj
     1546       ,input  '':U
     1547       ,input  0
     1548       ,input  0
     1549       ,input  0
     1550       ,input  0
     1551       ,input  true
     1552       ,output g-log
     1553       )  .
     1554   end.
     1555     if not g-log then return no-apply.
     1556     define variable v-ri as recid initial ? no-undo .
     1557     run str/payfinob.w ( input parParentProc, input v-cntxt-host-code-obj, input table temp-fin-ob, output v-ri) no-error  .
     1558     if error-status:error then return no-apply.
     1559     assign v-list = "" .
     1560     if v-ri <> ? then do:
     1561       for each temp-fin-ob :
     1562         if v-list = "" then assign v-list = string(temp-fin-ob.ri) .
     1563         else assign v-list = v-list + "," + string(temp-fin-ob.ri) .
     1564       end.
     1565       assign v-conn-avt = "no" .
     1566       run gbl/conf-rd.p ( input "fincnavt"
     1567                           ,input v-cntxt-host-code-obj
     1568                           ,input ""
     1569                           ,input 0
     1570                           ,input ""
     1571                           ,input ""
     1572                           ,input ""
     1573                           ,input no
     1574                           ,output v-conn-avt
     1575                           ,output v-par-type) no-error.
     1576       if v-conn-avt = "no" then do:
     1577         run str/fin-con1.w ( parParentProc, v-cntxt-host-code-obj, v-ri, v-list, output v-end) .
     1578       end.
     1579       else do:
     1580         assign v-end = yes .
     1581         run conn-avt ( v-ri, v-list ) .
     1582       end.
     1583       if v-end then do:
     1584         for each temp-fin-ob :
     1585           find first fin-ob no-lock where recid (fin-ob) = temp-fin-ob.ri .
     1586           if fin-ob.con-stat = 2 then delete temp-fin-ob .
     1587         end.
     1588       end.
     1589       RUN OpenBr(yes, no, '':U) .
     1590       RUN OpenBr1(yes, no, '':U) .
     1591     END.
     1592   END.
     1593   ON CHOOSE OF B-oplat-list IN FRAME Dialog-Frame
     1594   DO:
     1595     run str/paypvavt.p (v-cntxt-host-code-obj) no-error  .
     1596     if error-status:error then return no-apply.
     1597     RUN OpenBr(yes, no, '':U) .
     1598     RUN OpenBr1(yes, no, '':U) .
     1599   END.
     1600   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1601   DO:
     1602     define variable cur-clmn-loc as integer   no-undo .
     1603     define variable column-handle as handle no-undo .
     1604     define variable v-list as character no-undo .
     1605     define variable v-i as integer   no-undo .
     1606     define variable v-pos as integer   no-undo .
     1607     define variable v-list-new as character no-undo .
     1608     define variable v-elem as character no-undo .
     1609     define variable v-list-str as character no-undo .
     1610     define variable v-list-str1 as character no-undo .
     1611     assign
     1612       cur-clmn-loc  = 1
     1613       column-handle = Fin-Ob-List:first-column
     1614       v-list        = column-handle:label + "#"
     1615       v-list-new = ""
     1616     .
     1617     do while valid-handle(column-handle) :
     1618       if cur-clmn-loc = Fin-Ob-List:num-columns then leave .
     1619       assign
     1620         column-handle = column-handle:NEXT-COLUMN
     1621         cur-clmn-loc  = cur-clmn-loc + 1
     1622         v-list        = v-list + column-handle:label + "#"
     1623       .
     1624     end.
     1625     v-list = trim(v-list, "#") .
     1626     repeat v-i = 1 to Fin-Ob-List:num-columns :
     1627       v-elem = entry( v-i, v-list , "#") .
     1628       v-pos = lookup( v-elem, '*' + '#' +  'Т' + '#' +  '№ док-та' + '#' +  'Платеж' + '#' +  'Сумма в вал. док-та' + '#' +  'Сумма связи (в.д.)' + '#' +  'Своб. остаток (в.д.)' + '#' +  'Закрыт' + '#' +  'Договор' + '#' +  'Код получ.' + '#' +  'Получатель' + '#' +  'Код плател.' + '#' +  'Плательщик' + '#' +  'Создан' + '#' +  'Вал' + '#' +  'Сумма в выбр.вал.' + '#' +  'Объект' + '#' +  'Вн.N' + '#' +  'Условие генерации' , "#") .
     1629     end.
     1630     v-list-str = "" .
     1631     repeat v-i = 1 to num-entries(v-list-new) :
     1632       v-elem = entry(v-i , v-list-new ) .
     1633       if int(v-elem) > 1 then  v-list-str  = v-list-str + v-elem + "," .
     1634     end.
     1635     assign
     1636       cur-clmn-loc  = 1
     1637       column-handle = Fin-Doc-List:first-column
     1638       v-list        = column-handle:label + "#"
     1639       v-list-new = ""
     1640     .
     1641     do while valid-handle(column-handle) :
     1642       if cur-clmn-loc = Fin-Doc-List:num-columns then leave .
     1643       assign
     1644         column-handle = column-handle:NEXT-COLUMN
     1645         cur-clmn-loc  = cur-clmn-loc + 1
     1646         v-list        = v-list + column-handle:label + "#"
     1647       .
     1648     end.
     1649     v-list = trim(v-list, "#") .
     1650     repeat v-i = 1 to Fin-Doc-List:num-columns :
     1651       v-elem = entry( v-i, v-list , "#") .
     1652       v-pos = lookup( v-elem, '*' + '#' +  'Тип' + '#' +  'Статус' + '#' +  '№ док-та' + '#' +  'Создан' + '#' +  'Сумма в валюте док-та' + '#' +  'Сумма связи (в.д.)' + '#' +  'Своб. остаток (в.д.)' + '#' +  'Договор' + '#' +  'Код получ.' + '#' +  'Получатель' + '#' +  'Код плател.' + '#' +  'Плательщик' + '#' +  'Разр.' + '#' +  'Платеж' + '#' +  'Закрыт' + '#' +  'Вал' + '#' +  'Сумма в выбр.вал.' + '#' +  'Расш.тип' + '#' +  'Вн.N' + '#' +  'Объект' , "#") .
     1653       v-list-new = v-list-new + string(v-pos) + "," .
     1654     end.
     1655     v-list-str1 = "" .
     1656     repeat v-i = 1 to num-entries(v-list-new) :
     1657       v-elem = entry(v-i , v-list-new ) .
     1658       if int(v-elem) > 1 then  v-list-str1  = v-list-str1 + v-elem + "," .
     1659     end.
     1660       v-list-new = "".
     1661     run uf-set in this-procedure(
     1662       input  'planplat-p':U
     1663       ,input v-cntxt-userid
     1664       ,input v-list-new
     1665       ,input v-uf-Naim
     1666       ,input v-uf-print-graft
     1667       ,input v-uf-sort-gr
     1668       ,input v-uf-type-price
     1669       ,input v-uf-type-val
     1670     ) no-error    .
     1671     if error-status :error then  message vss-workfile vss-revision vss-description skip error-status :get-message(1) skip return-value skip "uf-set" view-as alert-box error .
     1672   END.
     1673   ON CHOOSE OF B-unmark IN FRAME Dialog-Frame
     1674   DO:
     1675     GET FIRST Fin-Ob-List NO-LOCK .
     1676     if not available buf_fin-ob then return.
     1677     for each temp-fin-ob: delete temp-fin-ob . end.
     1678     assign
     1679       sum-fin-ob = 0
     1680       num-fin-ob = 0
     1681     .
     1682     g-log = Fin-Ob-List:refresh() .
     1683     if num-fin-ob = 0 then hide mark-num in frame Dialog-Frame.
     1684     else                   display num-fin-ob @ mark-num  with frame Dialog-Frame.
     1685     display sum-fin-ob  with frame Dialog-Frame.
     1686   END.
     1687   ON CHOOSE OF B-unmark-2 IN FRAME Dialog-Frame
     1688   DO:
     1689     GET FIRST Fin-Doc-List NO-LOCK .
     1690     if not available buf_fin-doc then return.
     1691     for each temp-fin-doc: delete temp-fin-doc . end.
     1692     assign
     1693       sum-fin-doc = 0
     1694       num-fin-doc = 0
     1695     .
     1696     g-log = Fin-Doc-List:refresh() .
     1697     if num-fin-doc = 0 then hide mark-num-2 in frame Dialog-Frame.
     1698     else                 display num-fin-doc @ mark-num-2  with frame Dialog-Frame.
     1699     display sum-fin-doc  with frame Dialog-Frame.
     1700   END.
     1701   ON CHOOSE OF B-view-doc IN FRAME Dialog-Frame
     1702   DO:
     1703     if not available buf_fin-doc then return.
     1704     run ref/showfind.p (
     1705                          input parParentProc
     1706                         ,input v-cntxt-host-code-obj
     1707                         ,input buf_fin-doc.host-code
     1708                         ,input buf_fin-doc.fin-doc-code
     1709                         ).
     1710   END.
     1711   ON CHOOSE OF B-view-fo IN FRAME Dialog-Frame
     1712   DO:
     1713   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   do:
     1715     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1716       (input  v-cntxt-db-num
     1717       ,input  v-cntxt-userid
     1718       ,input  0
     1719       ,input  'actn_fin-liability_lookup':U
     1720       ,input  'firm':U
     1721       ,input  v-cntxt-host-code-obj
     1722       ,input  '':U
     1723       ,input  0
     1724       ,input  0
     1725       ,input  0
     1726       ,input  0
     1727       ,input  true
     1728       ,output g-log
     1729       )  .
     1730   end.
     1731     if not g-log then  return .
     1732     define variable rr as recid no-undo .
     1733     if not available buf_fin-ob then return.
     1734     run str/sh-finob.p ( input parParentProc, input v-cntxt-host-code-obj, input recid(buf_fin-ob)).
     1735   END.
     1736   ON CHOOSE OF BUTTON-cli IN FRAME Dialog-Frame
     1737   DO:
     1738     define variable agnt-list as character no-undo .
     1739     run ref/cli-all.w (parParentProc, "b-sel", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
     1740     if agnt-list <> "" then do:
     1741       find first clients no-lock where RECID(clients) = int (agnt-list) no-error.
     1742       if clients.obj-type <> 'чел':U and clients.obj-type <> 'орг':U then do:
     1743         message "Контрагент может быть только " 'орг':U " или " 'чел':U view-as alert-box ERROR .
     1744         return no-apply.
     1745       end.
     1746       assign cli-name  = clients.obj-name  cli-code = clients.obj-code  cli-type = clients.obj-type.
     1747     end.
     1748     else assign cli-name = ""   cli-code = ?  cli-type  = ? .
     1749     display cli-name    cli-code     cli-type   with frame Dialog-Frame.
     1750     run proc-find-cli in this-procedure(no, input cli-code, input cli-type ) no-error.
     1751     if error-status:error then return no-apply.
     1752   END.
     1753   ON CHOOSE OF BUTTON-curr IN FRAME Dialog-Frame
     1754   DO:
     1755     define variable ri as recid init ? no-undo .
     1756     run ref/currency.w ( input parparentproc
     1757                         ,input "b-sel"
     1758                         ,input-output ri ).
     1759     if ri = ? then return no-apply.
     1760     find currency where recid ( currency ) = ri no-lock.
     1761     assign
     1762       s-curr-code = currency.curr-code
     1763       curr-name = currency.curr-abbr
     1764     .
     1765     display curr-name s-curr-code with frame Dialog-Frame.
     1766     RUN OpenBr(yes, no, '':U) .
     1767     RUN OpenBr1(yes, no, '':U) .
     1768   END.
     1769   ON CTRL-J OF cli-code IN FRAME Dialog-Frame
     1770   DO:
     1771     run proc-find-cli  in this-procedure(yes, input cli-code, input cli-type ) no-error.
     1772     if error-status:error then return no-apply.
     1773   END.
     1774   ON RETURN OF cli-code IN FRAME Dialog-Frame
     1775   DO:
     1776     assign cli-code.
     1777     run find-cli in this-procedure (input cli-type, input cli-code)  .
     1778   END.
     1779   ON CTRL-J OF cli-name IN FRAME Dialog-Frame
     1780   DO:
     1781     assign cli-name .
     1782     run proc-find-cli-name in this-procedure(yes, input frame Dialog-Frame cli-name ) no-error.
     1783     if error-status:error then return no-apply.
     1784   END.
     1785   ON RETURN OF cli-name IN FRAME Dialog-Frame
     1786   DO:
     1787     assign cli-name .
     1788     run proc-find-cli-name  in this-procedure(no, input frame Dialog-Frame cli-name ) no-error.
     1789     if error-status:error then return no-apply.
     1790   END.
     1791   ON LEAVE OF cli-type IN FRAME Dialog-Frame
     1792   DO:
     1793     if cli-code = int ( cli-code:screen-value ) then return.
     1794     assign cli-type.
     1795     run find-cli in this-procedure (input cli-type, input cli-code)  .
     1796   END.
     1797   ON RETURN OF cli-type IN FRAME Dialog-Frame
     1798   DO:
     1799     assign cli-type.
     1800     run find-cli in this-procedure (input cli-type, input cli-code)  .
     1801   END.
     1802   ON VALUE-CHANGED OF Curr-Types IN FRAME Dialog-Frame
     1803   DO:
     1804     assign Curr-Types .
     1805     define variable ref-rec as recid init ? no-undo .
     1806     if Curr-Types = "sel" then do:
     1807       run ref/currency.w ( input parparentproc
     1808                           ,input "b-sel"
     1809                           ,input-output ref-rec ).
     1810       if ref-rec = ? then do:
     1811         assign Curr-Types = "all" .
     1812         display Curr-Types with frame Dialog-Frame.
     1813       end.
     1814       else do:
     1815         find first  currency where recid ( currency ) = ref-rec no-lock.
     1816         assign curr-code = currency.curr-code .
     1817       end.
     1818     end.
     1819     RUN OpenBr(yes, no, '':U) .
     1820     RUN OpenBr1(yes, no, '':U) .
     1821   END.
     1822   ON RETURN OF Fin-Doc-List IN FRAME Dialog-Frame
     1823   or MOUSE-SELECT-DBLCLICK OF Fin-Doc-List IN FRAME Dialog-Frame
     1824   DO:
     1825       if b-mark-2:sensitive then apply "choose" to b-mark-2 in frame Dialog-Frame.
     1826   END.
     1827   ON VALUE-CHANGED OF Fin-Doc-List IN FRAME Dialog-Frame
     1828   DO:
     1829     v-payer-code = buf_fin-doc.payer-code.
     1830     v-payer-type = buf_fin-doc.payer-type.
     1831     OPEN QUERY Fin-Ob-List FOR EACH buf_fin-ob where buf_fin-ob.payer-code = v-payer-code and buf_fin-ob.status_ =  'факт':U and buf_fin-ob.con-stat <> 2 NO-LOCK,        first temp-contr.
     1832   END.
     1833   ON RETURN OF Fin-Ob-List IN FRAME Dialog-Frame
     1834   or MOUSE-SELECT-DBLCLICK OF Fin-Ob-List IN FRAME Dialog-Frame
     1835   DO:
     1836       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     1837   END.
     1838   ON VALUE-CHANGED OF RADIO-find-cli IN FRAME Dialog-Frame
     1839   DO:
     1840     assign RADIO-find-cli .
     1841     if cli-code <> ? and cli-code <> 0 then apply "return" to cli-code in frame Dialog-Frame.
     1842     else if cli-name <> "" then apply "return" to cli-name in frame Dialog-Frame.
     1843   END.
     1844   ON VALUE-CHANGED OF RADIO-find-doc IN FRAME Dialog-Frame
     1845   DO:
     1846     assign RADIO-find-doc .
     1847     if sch-code <> "" then apply "return" to sch-code in frame Dialog-Frame.
     1848     else do:
     1849       if sch-date <> ? and sch-date <> ? and sch-date:screen-value <> "  /  /" then apply "return" to sch-date in frame Dialog-Frame.
     1850       else do:
     1851         if cli-code <> ? and cli-code <> 0 then apply "return" to cli-code in frame Dialog-Frame.
     1852         else if cli-name <> "" then apply "return" to cli-name in frame Dialog-Frame.
     1853       end.
     1854     end.
     1855   END.
     1856   ON LEAVE OF s-curr-code IN FRAME Dialog-Frame
     1857   DO:
     1858     assign s-curr-code .
     1859     define variable ri as recid init ? no-undo .
     1860     find first currency where currency.curr-code = s-curr-code no-error.
     1861     if not available currency then do:
     1862       run ref/currency.w ( input parparentproc
     1863                           ,input "b-sel"
     1864                           ,input-output ri ).
     1865       if ri = ? then return no-apply.
     1866       find currency where recid ( currency ) = ri .
     1867     end.
     1868     assign
     1869       curr-name = currency.curr-abbr
     1870       s-curr-code = currency.curr-code
     1871     .
     1872     display s-curr-code curr-name with frame Dialog-Frame.
     1873     RUN OpenBr(yes, no, '':U) .
     1874     RUN OpenBr1(yes, no, '':U) .
     1875   END.
     1876   ON RETURN OF s-curr-code IN FRAME Dialog-Frame
     1877   DO:
     1878     assign s-curr-code .
     1879     define variable ri as recid init ? no-undo .
     1880     find first currency where currency.curr-code = s-curr-code no-error.
     1881     if not available currency then do:
     1882       run ref/currency.w ( input parparentproc
     1883                           ,input "b-sel"
     1884                           ,input-output ri ).
     1885       if ri = ? then return no-apply.
     1886       find currency where recid ( currency ) = ri .
     1887     end.
     1888     assign
     1889       curr-name = currency.curr-abbr
     1890       s-curr-code = currency.curr-code
     1891     .
     1892     display s-curr-code curr-name with frame Dialog-Frame.
     1893     RUN OpenBr(yes, no, '':U) .
     1894     RUN OpenBr1(yes, no, '':U) .
     1895   END.
     1896   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1897   DO:
     1898     run proc-find-code  in this-procedure(yes, input frame Dialog-Frame sch-code ) no-error.
     1899     if error-status:error then return no-apply.
     1900   END.
     1901   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1902   DO:
     1903     run proc-find-code  in this-procedure(no, input frame Dialog-Frame sch-code ) no-error.
     1904     if error-status:error then return no-apply.
     1905   END.
     1906   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1907   DO:
     1908     run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-date) no-error.
     1909     if error-status:error then return no-apply.
     1910   END.
     1911   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1912   DO:
     1913     assign sch-date .
     1914     run proc-find-date in this-procedure(no, input sch-date) no-error.
     1915     if error-status:error then return no-apply.
     1916   END.
     1917   ON VALUE-CHANGED OF Sel-Client IN FRAME Dialog-Frame
     1918   DO:
     1919     assign Sel-Client .
     1920     assign cli-list = "" .
     1921     if Sel-Client = "sel" then do:
     1922       run ref/cli-all.w (parParentProc, "b-sel,b-mark", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output cli-list ) .
     1923       if cli-list = "" then do:
     1924         assign Sel-Client = "all" .
     1925         disp Sel-Client with frame Dialog-Frame.
     1926       end.
     1927       else do:
     1928         assign Sel-Contr = "all" .
     1929         disp Sel-Contr with frame Dialog-Frame.
     1930         for each temp-contr  where temp-contr.id <> -1 : delete temp-contr . end.
     1931         for each temp-contr1 where temp-contr1.id <> -1 : delete temp-contr1 . end.
     1932         define variable ii as integer   no-undo .
     1933         do ii = 1 to num-entries (cli-list):
     1934           find first clients no-lock where recid(clients) = integer (entry (ii, cli-list)) .
     1935           for each contract no-lock
     1936             where contract.host-code = v-cntxt-host-code-obj
     1937               and contract.cli-type = clients.obj-type
     1938               and contract.cli-code = clients.obj-code
     1939           :
     1940             create temp-contr .
     1941             assign temp-contr.id = contract.contract-code .
     1942             create temp-contr1 .
     1943             assign temp-contr1.id = contract.contract-code .
     1944           end.
     1945         end.
     1946       end.
     1947     end .
     1948     RUN OpenBr(yes, no, '':U) .
     1949     RUN OpenBr1(yes, no, '':U) .
     1950   END.
     1951   ON VALUE-CHANGED OF Sel-Contr IN FRAME Dialog-Frame
     1952   DO:
     1953     assign Sel-Contr .
     1954     if Sel-Client = "all" then do:
     1955       for each temp-contr where temp-contr.id <> -1 : delete temp-contr . end.
     1956       for each temp-contr1 where temp-contr1.id <> -1 : delete temp-contr1 . end.
     1957     end.
     1958     assign cont-list = "" .
     1959     if Sel-Contr = "sel" then do:
     1960       if Sel-Client = "sel" then do:
     1961         find first clients no-lock where recid(clients) = integer (cli-list) .
     1962         run str/cont-all.w ( parParentProc, v-cntxt-host-code-obj, "b-add,b-mark,b-sel", 'фирма':U, clients.obj-type, clients.obj-code, ?, ?, "current":U, p-doc-type, input-output cont-list ) .
     1963       end.
     1964       else do:
     1965         run str/cont-all.w ( parParentProc, v-cntxt-host-code-obj, "b-add,b-mark,b-sel", 'фирма':U, ?, ?, ?, ?, "current":U, p-doc-type, input-output cont-list ) .
     1966       end.
     1967       if cont-list = "" then do:
     1968         assign Sel-Contr = "all" .
     1969         disp Sel-Contr with frame Dialog-Frame.
     1970       end.
     1971       else do:
     1972         for each temp-contr where temp-contr.id <> -1 : delete temp-contr . end.
     1973         for each temp-contr1 where temp-contr1.id <> -1 : delete temp-contr1 . end.
     1974         define variable ii as integer   no-undo .
     1975         do ii = 1 to num-entries (cont-list):
     1976           find first contract no-lock where recid(contract) = integer (entry (ii, cont-list)) .
     1977           create temp-contr .
     1978           assign temp-contr.id = contract.contract-code .
     1979           create temp-contr1 .
     1980           assign temp-contr1.id = contract.contract-code .
     1981         end.
     1982       end.
     1983     end .
     1984     else do:
     1985       if Sel-Client = "sel" then do:
     1986           find first clients no-lock where recid(clients) = integer (cli-list) .
     1987           for each contract no-lock
     1988             where contract.host-code = p-host-code
     1989               and contract.cli-type = clients.obj-type
     1990               and contract.cli-code = clients.obj-code
     1991           :
     1992             create temp-contr .
     1993             assign temp-contr.id = contract.contract-code .
     1994             create temp-contr1 .
     1995             assign temp-contr1.id = contract.contract-code .
     1996           end.
     1997       end.
     1998     end.
     1999     RUN OpenBr(yes, no, '':U) .
     2000     RUN OpenBr1(yes, no, '':U) .
     2001   END.
     2002   ON VALUE-CHANGED OF Sel-Status IN FRAME Dialog-Frame
     2003   DO:
     2004     assign Sel-Status .
     2005     if Sel-Status = "new" then assign p-status = 'новый':U .
     2006     else                       assign p-status = 'факт':U .
     2007     RUN OpenBr1(yes, no, '':U) .
     2008     apply "entry" to Fin-Doc-List .
     2009   END.
     2010   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2011   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2012   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2013   on help of frame Dialog-Frame
     2014   do:
     2015     run gbl/app_help.p
     2016       (input this-procedure :file-name
     2017       ,input ''
     2018       ,input ?
     2019       ) no-error.
     2020     if error-status :error then do:
     2021       message
     2022         "Ошибка при вызове помощи"
     2023         error-status :get-message(1)
     2024         view-as alert-box .
     2025     end.
     2026   end.
     2027   run minbtn-set in this-procedure .
     2028   on choose of b-help in frame Dialog-Frame
     2029   do:
     2030     apply "help":u to frame Dialog-Frame .
     2031   end.
     2032   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2033   procedure minbtn-set :
     2034       do
     2035           on error undo, return error return-value
     2036           :
     2037           define variable ii              as integer       no-undo .
     2038           define variable fh              as widget-handle no-undo .
     2039           define variable hh              as widget-handle no-undo .
     2040           define variable v-h             as handle        extent 4 no-undo .
     2041           define variable v-name-button   as character     no-undo .
     2042           define variable v-help-old-x    as decimal       no-undo .
     2043           define variable v-help-old-y    as decimal       no-undo .
     2044           define variable v-help-old-size as decimal       no-undo .
     2045           define variable v-frame-width   as decimal       no-undo .
     2046           define variable jj              as integer       no-undo .
     2047           do
     2048               on error undo, return error
     2049               :
     2050               assign
     2051                   v-frame-width = frame Dialog-Frame:width - 0.3
     2052                   fh            = frame Dialog-Frame:first-child
     2053                   hh            = fh:first-child
     2054                   ii            = 1
     2055                   .
     2056               do while valid-handle(hh):
     2057                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2058                   do:
     2059                       case lc(hh:name) :
     2060                           when "b-help" then
     2061                               do:
     2062                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2063                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2064                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2065                                   hh:TOOLTIP = "Помощь" .
     2066                                   v-help-old-x = hh:column .
     2067                                   v-help-old-y = hh:row    .
     2068                                   v-help-old-size = hh:width .
     2069                                   hh:width-chars = 2.5 .
     2070                               end.
     2071                           when "b-print" then
     2072                               do:
     2073                                   hh:load-image("cmp/b-print.bmp":u) .
     2074                                   hh:TOOLTIP = "Печать" .
     2075                                   v-h[ii] = hh:handle .
     2076                                   ii = ii + 1 .
     2077                                   hh:width-chars = 3 .
     2078                               end.
     2079                           when "b-history" or
     2080                           when "b-hist" then
     2081                               do:
     2082                                   hh:load-image("cmp/b-hist.bmp":u) .
     2083                                   hh:TOOLTIP = "История" .
     2084                                   v-h[ii] = hh:handle .
     2085                                   ii = ii + 1 .
     2086                                   hh:width-chars = 3 .
     2087                               end.
     2088                           when "b-sch" then
     2089                               do:
     2090                                   hh:load-image("cmp/b-sch.bmp":u) .
     2091                                   hh:TOOLTIP = "Установка Фильтра" .
     2092                                   v-h[ii] = hh:handle .
     2093                                   ii = ii + 1 .
     2094                                   hh:width-chars = 3 .
     2095                               end.
     2096                           when "b-hist-user" then
     2097                               do:
     2098                                   hh:load-image("cmp/b-hist.bmp":u) .
     2099                                   hh:TOOLTIP = "История пользователя" .
     2100                                   ii = ii + 1 .
     2101                               end.
     2102                       end case.
     2103                   end.
     2104                   hh = hh:next-sibling.
     2105               end.
     2106               b-help:column = v-frame-width - b-help:width-chars.
     2107               jj = 0.
     2108               repeat ii = 4 to 1 by -1 :
     2109                   if valid-handle (v-h[ii] ) then
     2110                   do:
     2111                       jj  = jj + 1 .
     2112                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2113                       v-h[ii]:row    = v-help-old-y .
     2114                   end.
     2115               end.
     2116           end.
     2117       end.
     2118   end procedure.
     2119   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2120   do:
     2121     Fin-Doc-List :SET-REPOSITIONED-ROW(15, "CONDITIONAL") .
     2122   end.
     2123   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2124   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2125   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2126   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2127   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2128   define variable v-diasize-current-frame-height as decimal   no-undo .
     2129   define variable v-diasize-change-size          as logical   no-undo .
     2130   define variable v-diasize-resize-button        as handle    no-undo .
     2131   define variable v-diasize-wndmax               as logical   no-undo .
     2132   define variable v-diasize-wndstore             as logical   no-undo .
     2133   define variable v-diasize-proc-name            as character no-undo .
     2134   define variable v-diasize-browse-handle        as handle    no-undo .
     2135   define variable v-diasize-browse-number        as integer   no-undo .
     2136   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2137   define temp-table temp-diasize-handle no-undo
     2138     field handle-value  as handle
     2139     field save-position as decimal
     2140     index xpk is primary unique handle-value
     2141     .
     2142   define temp-table temp-browse-handle no-undo
     2143     field browse-type   as character
     2144     field browse-number as integer
     2145     field browse-handle as handle
     2146     field original-size as decimal
     2147     index xpk is primary unique browse-type browse-number
     2148     index xie browse-type browse-handle
     2149   .
     2150   procedure diasize_change-height :
     2151     define input  parameter p-change-value  as decimal   no-undo .
     2152     define input  parameter p-move-resize   as logical   no-undo .
     2153     define variable v-field-group-handle    as handle    no-undo .
     2154     define variable v-object-handle         as handle    no-undo .
     2155     define variable v-frame-height          as decimal   no-undo .
     2156     define variable v-frame-virtual-height  as decimal   no-undo .
     2157     define variable v-browse-height         as decimal   no-undo .
     2158     define variable v-window-height         as decimal   no-undo .
     2159     define variable v-window-virtual-height as decimal   no-undo .
     2160     define variable v-change-sign           as integer   no-undo .
     2161     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2162     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2163     if p-change-value > 0
     2164     then do:
     2165       if frame Dialog-Frame :height + p-change-value
     2166           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2167       then do:
     2168         assign
     2169           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2170                           - (frame Dialog-Frame :height-chars)
     2171         .
     2172         if p-change-value <= 0
     2173         then do:
     2174           run diasize_position-resize-button in this-procedure .
     2175           return .
     2176         end.
     2177       end.
     2178     end.
     2179     if p-change-value < 0
     2180     then do:
     2181       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2182       then do:
     2183         assign
     2184           p-change-value = v-diasize-orig-frame-height
     2185                          - (frame Dialog-Frame :height-chars)
     2186         .
     2187         if p-change-value >= 0
     2188         then do:
     2189           run diasize_position-resize-button in this-procedure .
     2190           return .
     2191         end.
     2192       end.
     2193     end.
     2194     if p-change-value >= 0
     2195     then do:
     2196       assign
     2197         v-change-sign = 1
     2198       .
     2199     end.
     2200     else do:
     2201       assign
     2202         v-change-sign = -1
     2203       .
     2204     end.
     2205     assign
     2206       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2207     .
     2208     if p-change-value = 0
     2209     then do:
     2210       run diasize_position-resize-button in this-procedure .
     2211       return .
     2212     end.
     2213     move_block:
     2214     do
     2215     on error undo move_block, retry move_block
     2216     :
     2217       if retry
     2218       then do:
     2219         do
     2220         on error undo move_block, leave move_block
     2221         :
     2222           if p-change-value > 0
     2223           then do:
     2224             for each buf_temp-diasize-handle
     2225             on error undo, next
     2226             :
     2227               assign
     2228                 v-object-handle = buf_temp-diasize-handle.handle-value
     2229               .
     2230               if v-object-handle <> v-diasize-resize-button
     2231               then do:
     2232                 assign
     2233                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2234                 .
     2235               end.
     2236             end.
     2237             assign
     2238               v-diasize-browse-handle :height = v-browse-height
     2239             .
     2240             for each buf_temp-browse-handle
     2241               where buf_temp-browse-handle.browse-type = 'height':u
     2242             on error undo, next
     2243             :
     2244               assign
     2245                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2246               .
     2247             end.
     2248             assign
     2249               frame Dialog-Frame :height = v-frame-height
     2250             .
     2251             if frame Dialog-Frame :scrollable = true
     2252             then do:
     2253               assign
     2254                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2255               .
     2256             end.
     2257             run diasize_position-resize-button in this-procedure .
     2258           end.
     2259           else do:
     2260             if frame Dialog-Frame :scrollable = true
     2261             then do:
     2262               assign
     2263                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2264               .
     2265             end.
     2266             assign
     2267               frame Dialog-Frame :height = v-frame-height
     2268             .
     2269             assign
     2270               v-diasize-browse-handle :height = v-browse-height
     2271             .
     2272             for each buf_temp-browse-handle
     2273               where buf_temp-browse-handle.browse-type = 'height':u
     2274             on error undo, next
     2275             :
     2276               assign
     2277                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2278               .
     2279             end.
     2280             for each buf_temp-diasize-handle
     2281             on error undo, next
     2282             :
     2283               assign
     2284                 v-object-handle = buf_temp-diasize-handle.handle-value
     2285               .
     2286               if v-object-handle <> v-diasize-resize-button
     2287               then do:
     2288                 assign
     2289                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2290                 .
     2291               end.
     2292             end.
     2293             run diasize_position-resize-button in this-procedure .
     2294           end.
     2295           assign
     2296             v-diasize-change-size = false
     2297           .
     2298           leave move_block .
     2299         end.
     2300       end.
     2301       assign
     2302         v-diasize-need-full-display = true
     2303       .
     2304       if v-diasize-change-size = false
     2305       then do:
     2306         assign
     2307           v-diasize-change-size = true
     2308         .
     2309       end.
     2310       else do:
     2311         return .
     2312       end.
     2313       assign
     2314         v-frame-height = frame Dialog-Frame :height
     2315         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2316         v-browse-height = v-diasize-browse-handle :height
     2317       .
     2318       for each buf_temp-browse-handle
     2319         where buf_temp-browse-handle.browse-type = 'height':u
     2320       :
     2321         assign
     2322           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2323         .
     2324       end.
     2325       for each buf_temp-diasize-handle
     2326       :
     2327         delete buf_temp-diasize-handle .
     2328       end.
     2329       assign
     2330         v-field-group-handle = frame Dialog-Frame :first-child
     2331       .
     2332       do while valid-handle(v-field-group-handle)
     2333       :
     2334         assign
     2335           v-object-handle = v-field-group-handle :first-child
     2336         .
     2337         do while valid-handle(v-object-handle)
     2338         :
     2339           if  v-object-handle <> v-diasize-browse-handle :handle
     2340           and can-query(v-object-handle, "row")
     2341           and can-query(v-object-handle, "height")
     2342           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2343           then do:
     2344             find first buf_temp-browse-handle
     2345               where buf_temp-browse-handle.browse-type   = 'height':u
     2346                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2347               no-error .
     2348             if available buf_temp-browse-handle
     2349             then do:
     2350             end.
     2351             else do:
     2352               create buf_temp-diasize-handle .
     2353               assign
     2354                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2355                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2356               .
     2357             end.
     2358           end.
     2359           assign
     2360             v-object-handle = v-object-handle :next-sibling
     2361           .
     2362         end.
     2363         assign
     2364           v-field-group-handle = v-field-group-handle :next-sibling
     2365         .
     2366       end.
     2367       do with frame Dialog-Frame
     2368       :
     2369         hide v-diasize-resize-button .
     2370         assign
     2371           v-diasize-resize-button :row    = 1
     2372           v-diasize-resize-button :column = 1
     2373         .
     2374       end.
     2375       if p-change-value > 0
     2376       then do:
     2377         if frame Dialog-Frame :scrollable = true
     2378         then do:
     2379           assign
     2380             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2381             no-error .
     2382           if error-status :error
     2383           or error-status :get-message(1) <> ""
     2384           then do:
     2385             undo move_block, retry move_block .
     2386           end.
     2387         end.
     2388         assign
     2389           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2390           no-error .
     2391         if error-status :error
     2392         or error-status :get-message(1) <> ""
     2393         then do:
     2394           undo move_block, retry move_block .
     2395         end.
     2396         assign
     2397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2398           no-error .
     2399         if error-status :error
     2400         or error-status :get-message(1) <> ""
     2401         then do:
     2402           undo move_block, retry move_block .
     2403         end.
     2404         for each buf_temp-browse-handle
     2405           where buf_temp-browse-handle.browse-type = 'height':u
     2406         on error undo move_block, retry move_block
     2407         :
     2408           assign
     2409             buf_temp-browse-handle.browse-handle :height
     2410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2411             no-error .
     2412           if error-status :error
     2413           or error-status :get-message(1) <> ""
     2414           then do:
     2415             undo move_block, retry move_block .
     2416           end.
     2417         end.
     2418         for each buf_temp-diasize-handle
     2419         on error undo move_block, retry move_block
     2420         :
     2421           assign
     2422             v-object-handle = buf_temp-diasize-handle.handle-value
     2423           .
     2424           if v-object-handle <> v-diasize-resize-button
     2425           then do:
     2426             assign
     2427               v-object-handle :row = v-object-handle :row + p-change-value
     2428               no-error .
     2429             if error-status :error
     2430             or error-status :get-message(1) <> ""
     2431             then do:
     2432               undo move_block, retry move_block .
     2433             end.
     2434           end.
     2435         end.
     2436       end.
     2437       else do:
     2438         for each buf_temp-diasize-handle
     2439         on error undo move_block, retry move_block
     2440         :
     2441           assign
     2442             v-object-handle = buf_temp-diasize-handle.handle-value
     2443           .
     2444           if v-object-handle <> v-diasize-resize-button
     2445           then do:
     2446             assign
     2447               v-object-handle :row = v-object-handle :row + p-change-value
     2448               no-error .
     2449             if error-status :error
     2450             or error-status :get-message(1) <> ""
     2451             then do:
     2452               undo move_block, retry move_block .
     2453             end.
     2454           end.
     2455         end.
     2456         assign
     2457           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2458           no-error .
     2459         if error-status :error
     2460         or error-status :get-message(1) <> ""
     2461         then do:
     2462           undo move_block, retry move_block .
     2463         end.
     2464         for each buf_temp-browse-handle
     2465           where buf_temp-browse-handle.browse-type = 'height':u
     2466         on error undo move_block, retry move_block
     2467         :
     2468           assign
     2469             buf_temp-browse-handle.browse-handle :height
     2470               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2471             no-error .
     2472           if error-status :error
     2473           or error-status :get-message(1) <> ""
     2474           then do:
     2475             undo move_block, retry move_block .
     2476           end.
     2477         end.
     2478         assign
     2479           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2480           no-error .
     2481         if error-status :error
     2482         or error-status :get-message(1) <> ""
     2483         then do:
     2484           undo move_block, retry move_block .
     2485         end.
     2486         if frame Dialog-Frame :scrollable = true
     2487         then do:
     2488           assign
     2489             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2490             no-error .
     2491           if error-status :error
     2492           or error-status :get-message(1) <> ""
     2493           then do:
     2494             undo move_block, retry move_block .
     2495           end.
     2496         end.
     2497       end.
     2498       if p-move-resize = true
     2499       then do:
     2500         run diasize_position-resize-button in this-procedure .
     2501       end.
     2502       if v-diasize-wndstore = true
     2503       then do:
     2504         if connected("ub") = true
     2505         then do:
     2506           define variable v-cntxt-db-num        as integer   no-undo .
     2507           define variable v-cntxt-userid        as character no-undo .
     2508           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2509                                             , OUTPUT v-cntxt-userid
     2510                                             ) .
     2511           run gbl/wndsizew.p
     2512             (input  v-cntxt-db-num
     2513             ,input  v-cntxt-userid
     2514             ,input  v-diasize-proc-name
     2515             ,input  'height':u
     2516             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2517             ) .
     2518         end.
     2519       end.
     2520     end.
     2521     assign
     2522       v-diasize-change-size = false
     2523     .
     2524   end procedure.
     2525   procedure diasize_set-height :
     2526     define input  parameter p-new-height  as decimal   no-undo .
     2527     define input  parameter p-move-resize as logical   no-undo .
     2528     do
     2529     on error undo, return error return-value
     2530     :
     2531       run diasize_change-height in this-procedure
     2532         (input  (p-new-height - frame Dialog-Frame :height)
     2533         ,input  p-move-resize
     2534         ) .
     2535     end.
     2536   end procedure.
     2537   procedure diasize_change-width :
     2538     define input  parameter p-change-value as decimal   no-undo .
     2539     define input  parameter p-move-resize  as logical   no-undo .
     2540     define variable v-field-group-handle   as handle    no-undo .
     2541     define variable v-object-handle        as handle    no-undo .
     2542     define variable v-frame-width          as decimal   no-undo .
     2543     define variable v-frame-virtual-width  as decimal   no-undo .
     2544     define variable v-browse-width         as decimal   no-undo .
     2545     define variable v-window-width         as decimal   no-undo .
     2546     define variable v-window-virtual-width as decimal   no-undo .
     2547     define variable v-change-sign          as integer   no-undo .
     2548     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2549     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2550     if p-change-value > 0
     2551     then do:
     2552       if frame Dialog-Frame :width + p-change-value >
     2553           session :width-chars
     2554       then do:
     2555         assign
     2556           p-change-value = session :width-chars - frame Dialog-Frame :width
     2557         .
     2558         if p-change-value <= 0
     2559         then do:
     2560           run diasize_position-resize-button in this-procedure .
     2561           return .
     2562         end.
     2563       end.
     2564     end.
     2565     if p-change-value < 0
     2566     then do:
     2567       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2568       then do:
     2569         assign
     2570           p-change-value = v-diasize-orig-frame-width
     2571                          - frame Dialog-Frame :width
     2572         .
     2573         if p-change-value >= 0
     2574         then do:
     2575           run diasize_position-resize-button in this-procedure .
     2576           return .
     2577         end.
     2578       end.
     2579     end.
     2580     if p-change-value >= 0
     2581     then do:
     2582       assign
     2583         v-change-sign = 1
     2584       .
     2585     end.
     2586     else do:
     2587       assign
     2588         v-change-sign = -1
     2589       .
     2590     end.
     2591     assign
     2592       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2593     .
     2594     if p-change-value = 0
     2595     then do:
     2596       run diasize_position-resize-button in this-procedure .
     2597       return .
     2598     end.
     2599     move_block:
     2600     do
     2601     on error undo move_block, leave move_block
     2602     :
     2603       if retry
     2604       then do:
     2605         do
     2606         on error undo move_block, leave move_block
     2607         :
     2608           if p-change-value > 0
     2609           then do:
     2610             for each buf_temp-diasize-handle
     2611             on error undo, next
     2612             :
     2613               assign
     2614                 v-object-handle = buf_temp-diasize-handle.handle-value
     2615               .
     2616               if v-object-handle <> v-diasize-resize-button
     2617               then do:
     2618                 assign
     2619                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2620                 .
     2621               end.
     2622             end.
     2623             assign
     2624               v-diasize-browse-handle :width = v-browse-width
     2625             .
     2626             for each buf_temp-browse-handle
     2627               where buf_temp-browse-handle.browse-type = 'width':u
     2628             on error undo, next
     2629             :
     2630               assign
     2631                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2632               .
     2633             end.
     2634             assign
     2635               frame Dialog-Frame :width = v-frame-width
     2636             .
     2637             if frame Dialog-Frame :scrollable = true
     2638             then do:
     2639               assign
     2640                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2641               .
     2642             end.
     2643             run diasize_position-resize-button in this-procedure .
     2644           end.
     2645           else do:
     2646             if frame Dialog-Frame :scrollable = true
     2647             then do:
     2648               assign
     2649                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2650               .
     2651             end.
     2652             assign
     2653               frame Dialog-Frame :width = v-frame-width
     2654             .
     2655             for each buf_temp-browse-handle
     2656               where buf_temp-browse-handle.browse-type = 'width':u
     2657             on error undo, next
     2658             :
     2659               assign
     2660                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2661               .
     2662             end.
     2663             assign
     2664               v-diasize-browse-handle :width = v-browse-width
     2665             .
     2666             for each buf_temp-diasize-handle
     2667             on error undo, next
     2668             :
     2669               assign
     2670                 v-object-handle = buf_temp-diasize-handle.handle-value
     2671               .
     2672               if v-object-handle <> v-diasize-resize-button
     2673               then do:
     2674                 assign
     2675                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2676                 .
     2677               end.
     2678             end.
     2679             run diasize_position-resize-button in this-procedure .
     2680           end.
     2681           assign
     2682             v-diasize-change-size = false
     2683           .
     2684           leave move_block .
     2685         end.
     2686       end.
     2687       assign
     2688         v-diasize-need-full-display = true
     2689       .
     2690       if v-diasize-change-size = false
     2691       then do:
     2692         assign
     2693           v-diasize-change-size = true
     2694         .
     2695       end.
     2696       else do:
     2697         return .
     2698       end.
     2699       assign
     2700         v-frame-width = frame Dialog-Frame :width
     2701         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2702         v-browse-width = v-diasize-browse-handle :width
     2703       .
     2704       for each buf_temp-browse-handle
     2705         where buf_temp-browse-handle.browse-type = 'width':u
     2706       :
     2707         assign
     2708           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2709         .
     2710       end.
     2711       for each buf_temp-diasize-handle
     2712       :
     2713         delete buf_temp-diasize-handle .
     2714       end.
     2715       assign
     2716         v-field-group-handle = frame Dialog-Frame :first-child
     2717       .
     2718       do while valid-handle(v-field-group-handle)
     2719       :
     2720         assign
     2721           v-object-handle = v-field-group-handle :first-child
     2722         .
     2723         do while valid-handle(v-object-handle)
     2724         :
     2725           if  v-object-handle <> v-diasize-browse-handle :handle
     2726           and v-object-handle <> v-diasize-resize-button
     2727           and can-query(v-object-handle, "row")
     2728           and can-query(v-object-handle, "height")
     2729           and ( v-object-handle :col + v-object-handle :width
     2730                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2731               )
     2732           then do:
     2733             find first buf_temp-browse-handle
     2734               where buf_temp-browse-handle.browse-type   = 'width':u
     2735                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2736               no-error .
     2737             if available buf_temp-browse-handle
     2738             then do:
     2739             end.
     2740             else do:
     2741               create buf_temp-diasize-handle .
     2742               assign
     2743                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2744                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2745               .
     2746             end.
     2747           end.
     2748           assign
     2749             v-object-handle = v-object-handle :next-sibling
     2750           .
     2751         end.
     2752         assign
     2753           v-field-group-handle = v-field-group-handle :next-sibling
     2754         .
     2755       end.
     2756       do with frame Dialog-Frame
     2757       :
     2758         hide v-diasize-resize-button .
     2759         v-diasize-resize-button :row = 1.
     2760         v-diasize-resize-button :column = 1.
     2761       end.
     2762       if p-change-value > 0
     2763       then do:
     2764         if frame Dialog-Frame :scrollable = true
     2765         then do:
     2766           assign
     2767             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2768             no-error .
     2769           if error-status :error
     2770           or error-status :get-message(1) <> ""
     2771           then do:
     2772             undo move_block, retry move_block.
     2773           end.
     2774         end.
     2775         assign
     2776           frame Dialog-Frame :width = v-frame-width + p-change-value
     2777           no-error .
     2778         if error-status :error
     2779         or error-status :get-message(1) <> ""
     2780         then do:
     2781           undo move_block, retry move_block.
     2782         end.
     2783         assign
     2784           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2785         no-error .
     2786         if error-status :error
     2787         or error-status :get-message(1) <> ""
     2788         then do:
     2789           undo move_block, retry move_block.
     2790         end.
     2791         for each buf_temp-browse-handle
     2792           where buf_temp-browse-handle.browse-type = 'width':u
     2793         on error undo move_block, retry move_block
     2794         :
     2795           assign
     2796             buf_temp-browse-handle.browse-handle :width
     2797               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2798             no-error .
     2799           if error-status :error
     2800           or error-status :get-message(1) <> ""
     2801           then do:
     2802             undo move_block, retry move_block .
     2803           end.
     2804         end.
     2805         for each buf_temp-diasize-handle
     2806         on error undo move_block, retry move_block
     2807         :
     2808           assign
     2809             v-object-handle = buf_temp-diasize-handle.handle-value
     2810           .
     2811           if v-object-handle <> v-diasize-resize-button
     2812           then do:
     2813             assign
     2814               v-object-handle :col = v-object-handle :col + p-change-value
     2815               no-error .
     2816             if error-status :error
     2817             or error-status :get-message(1) <> ""
     2818             then do:
     2819               undo move_block, retry move_block .
     2820             end.
     2821           end.
     2822         end.
     2823       end.
     2824       else do:
     2825         for each buf_temp-diasize-handle
     2826         on error undo move_block, retry move_block
     2827         :
     2828           assign
     2829             v-object-handle = buf_temp-diasize-handle.handle-value
     2830           .
     2831           if v-object-handle <> v-diasize-resize-button
     2832           then do:
     2833             assign
     2834               v-object-handle :col = v-object-handle :col + p-change-value
     2835               no-error .
     2836             if error-status :error
     2837             or error-status :get-message(1) <> ""
     2838             then do:
     2839               undo move_block, retry move_block .
     2840             end.
     2841           end.
     2842         end.
     2843         for each buf_temp-browse-handle
     2844           where buf_temp-browse-handle.browse-type = 'width':u
     2845         on error undo move_block, retry move_block
     2846         :
     2847           assign
     2848             buf_temp-browse-handle.browse-handle :width
     2849               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2850             no-error .
     2851           if error-status :error
     2852           or error-status :get-message(1) <> ""
     2853           then do:
     2854             undo move_block, retry move_block .
     2855           end.
     2856         end.
     2857         assign
     2858           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2859           no-error .
     2860         if error-status :error
     2861         or error-status :get-message(1) <> ""
     2862         then do:
     2863           undo move_block, retry move_block.
     2864         end.
     2865         assign
     2866           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2867         no-error .
     2868         if error-status :error
     2869         or error-status :get-message(1) <> ""
     2870         then do:
     2871           undo move_block, retry move_block.
     2872         end.
     2873         if frame Dialog-Frame :scrollable = true
     2874         then do:
     2875           assign
     2876             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2877           no-error .
     2878           if error-status :error
     2879           or error-status :get-message(1) <> ""
     2880           then do:
     2881             undo move_block, retry move_block.
     2882           end.
     2883         end.
     2884       end.
     2885       if p-move-resize
     2886       then do:
     2887         run diasize_position-resize-button in this-procedure .
     2888       end.
     2889       if v-diasize-wndstore = true
     2890       then do:
     2891         if connected("ub") = true
     2892         then do:
     2893           define variable v-cntxt-db-num        as integer   no-undo .
     2894           define variable v-cntxt-userid        as character no-undo .
     2895           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2896                                             , OUTPUT v-cntxt-userid
     2897                                             ) .
     2898           run gbl/wndsizew.p
     2899             (input  v-cntxt-db-num
     2900             ,input  v-cntxt-userid
     2901             ,input  v-diasize-proc-name
     2902             ,input  'width':u
     2903             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2904             ) .
     2905         end.
     2906       end.
     2907     end.
     2908     assign
     2909       v-diasize-change-size = false
     2910     .
     2911   end procedure.
     2912   procedure diasize_set-width :
     2913     define input  parameter p-new-width  as decimal   no-undo .
     2914     define input  parameter p-move-resize as logical   no-undo .
     2915     do
     2916     on error undo, return error return-value
     2917     :
     2918       run diasize_change-width in this-procedure
     2919         (input  (p-new-width - frame Dialog-Frame :width)
     2920         ,input  p-move-resize
     2921         ) .
     2922     end.
     2923   end procedure.
     2924   procedure diasize_position-resize-button :
     2925     do with frame Dialog-Frame
     2926     :
     2927       hide v-diasize-resize-button .
     2928       assign
     2929         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2930                     - 1
     2931                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2932         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2933                     - 1
     2934                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2935       .
     2936       view v-diasize-resize-button .
     2937     end.
     2938   end procedure.
     2939   on alt-right anywhere
     2940   do:
     2941     run diasize_change-width in this-procedure
     2942       (input 1
     2943       ,input true
     2944       ) .
     2945     return no-apply .
     2946   end.
     2947   on alt-left anywhere
     2948   do:
     2949     run diasize_change-width in this-procedure
     2950       (input -1
     2951       ,input true
     2952       ) .
     2953     return no-apply .
     2954   end.
     2955   on alt-down anywhere
     2956   do:
     2957     run diasize_change-height in this-procedure
     2958       (input 1
     2959       ,input true
     2960       ) .
     2961     return no-apply .
     2962   end.
     2963   on alt-up anywhere
     2964   do:
     2965     run diasize_change-height in this-procedure
     2966       (input -1
     2967       ,input true
     2968       ) .
     2969     return no-apply .
     2970   end.
     2971   on alt-enter of frame Dialog-Frame
     2972   do:
     2973     run diasize_maximize in this-procedure
     2974       (input  ?
     2975       ).
     2976     return no-apply .
     2977   end.
     2978   procedure diasize_end-move :
     2979     do
     2980     on error undo, return error return-value
     2981     :
     2982       define variable v-row-delta as decimal   no-undo .
     2983       define variable v-col-delta as decimal   no-undo .
     2984       define variable v-new-row as decimal   no-undo .
     2985       define variable v-new-col as decimal   no-undo .
     2986       assign
     2987         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2988         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2989       .
     2990       assign
     2991         v-row-delta = v-new-row - frame Dialog-Frame :height
     2992         v-col-delta = v-new-col - frame Dialog-Frame :width
     2993       .
     2994       run diasize_change-height in this-procedure
     2995         (input v-row-delta
     2996         ,input true
     2997         ) .
     2998       run diasize_change-width in this-procedure
     2999         (input v-col-delta
     3000         ,input true
     3001         ) .
     3002     end.
     3003   end procedure.
     3004   procedure diasize_maximize :
     3005     define input  parameter p-action as logical   no-undo .
     3006     do
     3007     on error undo, return error return-value
     3008     :
     3009       if p-action = ?
     3010       then do:
     3011         if v-diasize-need-maximize = true
     3012         then do:
     3013           assign
     3014             p-action = true
     3015           .
     3016         end.
     3017         else do:
     3018           assign
     3019             p-action = false
     3020           .
     3021         end.
     3022       end.
     3023       if p-action = true
     3024       then do:
     3025         run diasize_change-height in this-procedure
     3026           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3027               - frame Dialog-Frame :height-chars
     3028           ,input true
     3029           ) .
     3030         run diasize_change-width in this-procedure
     3031           (input session :width-chars
     3032               - frame Dialog-Frame :width-chars
     3033           ,input true
     3034           ) .
     3035         assign
     3036           v-diasize-need-maximize = false
     3037         .
     3038       end.
     3039       else do:
     3040         run diasize_change-width in this-procedure
     3041           (input v-diasize-orig-frame-width
     3042               - frame Dialog-Frame :width-chars
     3043           ,input true
     3044           ) .
     3045         run diasize_change-height in this-procedure
     3046           (input v-diasize-orig-frame-height
     3047               - frame Dialog-Frame :height-chars
     3048           ,input true
     3049           ) .
     3050         assign
     3051           v-diasize-need-maximize = true
     3052         .
     3053       end.
     3054     end.
     3055   end procedure.
     3056   procedure diasize_restore-orig-size :
     3057     do
     3058     on error undo, return error return-value
     3059     :
     3060       assign
     3061         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3062         v-diasize-current-frame-height = frame Dialog-Frame :height
     3063       .
     3064       run diasize_set-height in this-procedure
     3065         (input  v-diasize-orig-frame-height
     3066         ,input  true
     3067         ) .
     3068       run diasize_set-width in this-procedure
     3069         (input  v-diasize-orig-frame-width
     3070         ,input  true
     3071         ) .
     3072     end.
     3073   end procedure.
     3074   procedure diasize_restore-current-size :
     3075     do
     3076     on error undo, return error return-value
     3077     :
     3078       run diasize_set-height in this-procedure
     3079         (input  v-diasize-current-frame-height
     3080         ,input  true
     3081         ) .
     3082       run diasize_set-width in this-procedure
     3083         (input  v-diasize-current-frame-width
     3084         ,input  true
     3085         ) .
     3086     end.
     3087   end procedure.
     3088   procedure diasize_set-browse-handle :
     3089     define input  parameter p-browse-handle as handle   no-undo .
     3090     define buffer buf_temp-browse-handle for temp-browse-handle .
     3091     do
     3092     on error undo, return error return-value
     3093     :
     3094       assign
     3095         v-diasize-browse-handle = p-browse-handle
     3096       .
     3097       for each buf_temp-browse-handle
     3098       on error undo, return error return-value
     3099       :
     3100         delete buf_temp-browse-handle .
     3101       end.
     3102     end.
     3103   end procedure.
     3104   procedure diasize_add_browse :
     3105     define input  parameter p-browse-type   as character no-undo .
     3106     define input  parameter p-browse-handle as handle    no-undo .
     3107     define buffer buf_temp-browse-handle for temp-browse-handle .
     3108     do
     3109     on error undo, return error return-value
     3110     :
     3111       assign
     3112         v-diasize-browse-number = v-diasize-browse-number + 1
     3113       .
     3114       create buf_temp-browse-handle .
     3115       assign
     3116         buf_temp-browse-handle.browse-type   = p-browse-type
     3117         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3118         buf_temp-browse-handle.browse-handle = p-browse-handle
     3119       .
     3120     end.
     3121   end procedure.
     3122   procedure diasize_init :
     3123     define variable v-default-value    as logical   no-undo .
     3124     define variable v-restore-saved    as logical   no-undo .
     3125     define variable v-resize-value-str as character no-undo .
     3126     do
     3127     on error undo, return error return-value
     3128     :
     3129       do with frame Dialog-Frame
     3130       :
     3131         assign
     3132           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3133           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3134           v-diasize-browse-handle     = browse fin-ob-list :handle
     3135         .
     3136         create button v-diasize-resize-button
     3137         assign
     3138           parent        = frame Dialog-Frame :first-child
     3139           label         = "s"
     3140           height-pixels = 16
     3141           width-pixels  = 16
     3142           visible       = true
     3143           sensitive     = true
     3144           movable       = true
     3145           triggers:
     3146             on end-move persistent run diasize_end-move in this-procedure .
     3147           end triggers.
     3148         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3149         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3150         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3151         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3152         assign
     3153           v-diasize-wndmax = false
     3154         .
     3155         if connected("ub") = true
     3156         then do:
     3157           define variable v-cntxt-db-num        as integer   no-undo .
     3158           define variable v-cntxt-userid        as character no-undo .
     3159           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3160                                             , OUTPUT v-cntxt-userid
     3161                                             ) .
     3162           run gbl/wndpar_r.p
     3163             (input  v-cntxt-db-num
     3164             ,input  v-cntxt-userid
     3165             ,input  'wndmax':U
     3166             ,output v-diasize-wndmax
     3167             ,output v-default-value
     3168             ) .
     3169         end.
     3170         assign
     3171           v-diasize-wndstore = false
     3172         .
     3173         if connected("ub") = true
     3174         then do:
     3175           run gbl/wndpar_r.p
     3176             (input  v-cntxt-db-num
     3177             ,input  v-cntxt-userid
     3178             ,input  'wndstore':U
     3179             ,output v-diasize-wndstore
     3180             ,output v-default-value
     3181             ) .
     3182         end.
     3183         assign
     3184           v-diasize-proc-name = entry(1, program-name(2), '.')
     3185         .
     3186         if v-diasize-wndstore = true
     3187         then do:
     3188           assign
     3189             v-restore-saved = false
     3190           .
     3191           if connected("ub") = true
     3192           then do:
     3193             run gbl/wndsizer.p
     3194               (input  v-cntxt-db-num
     3195               ,input  v-cntxt-userid
     3196               ,input  v-diasize-proc-name
     3197               ,input  'height':u
     3198               ,output v-resize-value-str
     3199               ) .
     3200             if v-resize-value-str <> '':U
     3201             then do:
     3202               run diasize_change-height in this-procedure
     3203                 (input  integer(v-resize-value-str)
     3204                 ,input  true
     3205                 ) .
     3206               assign
     3207                 v-restore-saved = true
     3208               .
     3209             end.
     3210           end.
     3211           if connected("ub") = true
     3212           then do:
     3213             run gbl/wndsizer.p
     3214               (input  v-cntxt-db-num
     3215               ,input  v-cntxt-userid
     3216               ,input  v-diasize-proc-name
     3217               ,input  'width':u
     3218               ,output v-resize-value-str
     3219               ) .
     3220             if v-resize-value-str <> '':U
     3221             then do:
     3222               run diasize_change-width in this-procedure
     3223                 (input  integer(v-resize-value-str)
     3224                 ,input  true
     3225                 ) .
     3226               assign
     3227                 v-restore-saved = true
     3228               .
     3229             end.
     3230           end.
     3231           if v-restore-saved <> true
     3232           then do:
     3233             if v-diasize-wndmax = true
     3234             then do:
     3235               run diasize_maximize in this-procedure
     3236                 (input  true
     3237                 ) .
     3238             end.
     3239           end.
     3240         end.
     3241         else do:
     3242           if v-diasize-wndmax = true
     3243           then do:
     3244             run diasize_maximize in this-procedure
     3245               (input  true
     3246               ) .
     3247           end.
     3248         end.
     3249       end.
     3250     end.
     3251   end procedure.
     3252   procedure diasize_need-full-display :
     3253     define output parameter p-need-full-display as logical   no-undo .
     3254     do
     3255     on error undo, return error return-value
     3256     :
     3257       assign
     3258         p-need-full-display = v-diasize-need-full-display
     3259       .
     3260       assign
     3261         v-diasize-need-full-display = false
     3262       .
     3263     end.
     3264   end procedure.
     3265   procedure get-context :
     3266      define output parameter p-db-num as integer          no-undo.
     3267      define output parameter p-user-id as character        no-undo.
     3268      define variable v-login               as character    no-undo.
     3269      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3270      define buffer buf_user-login  for ub.user-login .
     3271      do
     3272      on error undo, return error
     3273      :
     3274            FIND FIRST buf_sys-ctrl no-lock.
     3275            ASSIGN
     3276               v-login = USERID("ub")
     3277               p-db-num = buf_sys-ctrl.db-num
     3278            .
     3279            FIND FIRST buf_user-login
     3280                 WHERE buf_user-login.db-num = p-db-num
     3281                   AND buf_user-login.user-login = v-login
     3282                 no-lock
     3283                 no-error
     3284                 .
     3285            IF AVAILABLE buf_user-login
     3286            THEN DO:
     3287               assign
     3288                  p-user-id = buf_user-login.user-id
     3289               .
     3290            END.
     3291      end.
     3292   end procedure.
     3293   run diasize_add_browse in this-procedure
     3294     (input  'height':u
     3295     ,input  browse fin-doc-list :handle
     3296     ) .
     3297   run diasize_init in this-procedure .
     3298   b-quit:SELECTED = no .
     3299   def var sort-labelFin-Ob-List   as character no-undo .
     3300   def var sort-clmnFin-Ob-List    as handle    no-undo .
     3301   def var cur-clmnFin-Ob-List     as handle    no-undo .
     3302   def var cur-clmn-locFin-Ob-List as integer   no-undo .
     3303   def var re-queryFin-Ob-List     as logical   initial no no-undo .
     3304   on start-search, ctrl-o of Fin-Ob-List in frame Dialog-Frame do:
     3305      run sort-brFin-Ob-List
     3306        (input (if available buf_fin-ob
     3307                then recid(buf_fin-ob)
     3308                else ?
     3309               )
     3310        ).
     3311   end.
     3312   PROCEDURE sort-brFin-Ob-List :
     3313     define input parameter p-recid as recid no-undo .
     3314     if re-queryFin-Ob-List = no then do:
     3315       assign
     3316          cur-clmnFin-Ob-List = Fin-Ob-List:current-column in frame Dialog-Frame
     3317       .
     3318       if sort-clmnFin-Ob-List <> ? then sort-clmnFin-Ob-List:column-fgcolor = 0.
     3319       if cur-clmnFin-Ob-List = sort-clmnFin-Ob-List then do:
     3320         assign
     3321            sort-labelFin-Ob-List = ""
     3322            sort-clmnFin-Ob-List = ?
     3323         .
     3324        end.
     3325        else do:
     3326          assign
     3327            sort-labelFin-Ob-List = cur-clmnFin-Ob-List:label
     3328            sort-clmnFin-Ob-List  = cur-clmnFin-Ob-List
     3329            sort-clmnFin-Ob-List:column-fgcolor = 4
     3330          .
     3331        end.
     3332      end.
     3333     assign
     3334       cur-clmn-locFin-Ob-List = 1
     3335     .
     3336     def var column-handle as handle no-undo .
     3337     column-handle = Fin-Ob-List:first-column.
     3338     do while valid-handle(column-handle) :
     3339       if column-handle = cur-clmnFin-Ob-List then do:
     3340         leave .
     3341       end.
     3342       column-handle = column-handle:NEXT-COLUMN.
     3343       assign
     3344         cur-clmn-locFin-Ob-List = cur-clmn-locFin-Ob-List + 1
     3345       .
     3346     end.
     3347     case sort-labelFin-Ob-List:
     3348           when 'Т'  then DO:    assign       sort-column-name = "buf_fin-ob.doc-type"     .     run OpenBr(yes, no, '':U).   . END.
     3349           when '№ док-та'  then DO:    assign       sort-column-name = "buf_fin-ob.prn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3350           when 'Платеж'  then DO:    assign       sort-column-name = "buf_fin-ob.pay-date"     .     run OpenBr(yes, no, '':U).   . END.
     3351           when 'Сумма в выбр.вал.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-curr-sum&1,&2,&3,&4,&5,&6,&7,&8)', chr(34), s-curr-code, buf_fin-ob.curr-code, buf_fin-ob.contract-curr, buf_fin-ob.sum-contract, buf_fin-ob.sum-rubl, buf_fin-ob.sum-base, buf_fin-ob.sum-doc)     .     run OpenBr(yes, no, '':U).   . END.
     3352           when 'Сумма связи (в.д.)'  then DO:    assign       sort-column-name = "buf_fin-ob.con-sum-contr"     .     run OpenBr(yes, no, '':U).   . END.
     3353           when 'Своб. остаток (в.д.)'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-ostat&1,&2,&3)', chr(34), buf_fin-ob.sum-contr, buf_fin-ob.con-sum-contr)     .     run OpenBr(yes, no, '':U).   . END.
     3354           when 'Закрыт'  then DO:    assign       sort-column-name = "buf_fin-ob.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3355           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-id&1,&2)', chr(34), buf_fin-ob.contract-code)     .     run OpenBr(yes, no, '':U).   . END.
     3356           when 'Код получ.'  then DO:    assign       sort-column-name = "(buf_fin-ob.receiver-type + ' ' + string(buf_fin-ob.receiver-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3357           when 'Получатель'  then DO:    assign       sort-column-name = "buf_fin-ob.receiver-name"     .     run OpenBr(yes, no, '':U).   . END.
     3358           when 'Код плател.'  then DO:    assign       sort-column-name = "(buf_fin-ob.payer-type + ' ' + string(buf_fin-ob.payer-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3359           when 'Плательщик'  then DO:    assign       sort-column-name = "buf_fin-ob.payer-name"     .     run OpenBr(yes, no, '':U).   . END.
     3360           when 'Создан'  then DO:    assign       sort-column-name = "buf_fin-ob.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3361           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-currency&1,&2)', chr(34), buf_fin-ob.curr-code)     .     run OpenBr(yes, no, '':U).   . END.
     3362           when 'Сумма в вал. док-та'  then DO:    assign       sort-column-name = "buf_fin-ob.sum-doc"     .     run OpenBr(yes, no, '':U).   . END.
     3363           when 'Объект'  then DO:    assign       sort-column-name = "(if buf_fin-ob.obj-code = 0 then '' else (buf_fin-ob.obj-type + ' ' + string(buf_fin-ob.obj-code)))"     .     run OpenBr(yes, no, '':U).   . END.
     3364           when 'Вн.N'  then DO:    assign       sort-column-name = "buf_fin-ob.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3365           when 'Условие генерации'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-gen&1,&2)', chr(34), buf_fin-ob.contract-code)     .     run OpenBr(yes, no, '':U).   . END.
     3366       otherwise do:
     3367         assign
     3368           sort-column-name = ""
     3369         .
     3370         run OpenBr(yes, no, '':U).
     3371           if can-do( this-procedure:internal-entries, 'mv-brw-defaultFin-Ob-List') then do:
     3372             run mv-brw-defaultFin-Ob-List.
     3373           end.
     3374         if sort-labelFin-Ob-List <> "" then do:
     3375           assign
     3376             cur-clmnFin-Ob-List:column-fgcolor = 0
     3377           .
     3378         end.
     3379         assign
     3380           cur-clmn-locFin-Ob-List = ?
     3381         .
     3382       end.
     3383     end case.
     3384       if cur-clmn-locFin-Ob-List <> ? then do:
     3385         if can-do( this-procedure:internal-entries, 'ch-clmnFin-Ob-List') then do:
     3386           run ch-clmnFin-Ob-List in this-procedure (cur-clmn-locFin-Ob-List).
     3387         end.
     3388       end.
     3389     if p-recid <> ? then do:
     3390       reposition Fin-Ob-List to recid p-recid no-error.
     3391       apply "value-changed" to Fin-Ob-List in frame Dialog-Frame.
     3392     end.
     3393     apply "entry" to Fin-Ob-List in frame Dialog-Frame.
     3394   END PROCEDURE.
     3395   procedure re-open-query-srt-clmnFin-Ob-List:
     3396   if cur-clmnFin-Ob-List = ? then do:
     3397      run OpenBr(yes, no, '':U).
     3398   end.
     3399   else do:
     3400      assign re-queryFin-Ob-List = yes.
     3401      run sort-brFin-Ob-List
     3402        (input (if available buf_fin-ob
     3403                then recid(buf_fin-ob)
     3404                else ?
     3405               )
     3406        ).
     3407      assign re-queryFin-Ob-List = no.
     3408   end.
     3409   end.
     3410   def var sort-labelFin-Doc-List   as character no-undo .
     3411   def var sort-clmnFin-Doc-List    as handle    no-undo .
     3412   def var cur-clmnFin-Doc-List     as handle    no-undo .
     3413   def var cur-clmn-locFin-Doc-List as integer   no-undo .
     3414   def var re-queryFin-Doc-List     as logical   initial no no-undo .
     3415   on start-search, ctrl-o of Fin-Doc-List in frame Dialog-Frame do:
     3416      run sort-brFin-Doc-List
     3417        (input (if available buf_fin-doc
     3418                then recid(buf_fin-doc)
     3419                else ?
     3420               )
     3421        ).
     3422   end.
     3423   PROCEDURE sort-brFin-Doc-List :
     3424     define input parameter p-recid as recid no-undo .
     3425     if re-queryFin-Doc-List = no then do:
     3426       assign
     3427          cur-clmnFin-Doc-List = Fin-Doc-List:current-column in frame Dialog-Frame
     3428       .
     3429       if sort-clmnFin-Doc-List <> ? then sort-clmnFin-Doc-List:column-fgcolor = 0.
     3430       if cur-clmnFin-Doc-List = sort-clmnFin-Doc-List then do:
     3431         assign
     3432            sort-labelFin-Doc-List = ""
     3433            sort-clmnFin-Doc-List = ?
     3434         .
     3435        end.
     3436        else do:
     3437          assign
     3438            sort-labelFin-Doc-List = cur-clmnFin-Doc-List:label
     3439            sort-clmnFin-Doc-List  = cur-clmnFin-Doc-List
     3440            sort-clmnFin-Doc-List:column-fgcolor = 4
     3441          .
     3442        end.
     3443      end.
     3444     assign
     3445       cur-clmn-locFin-Doc-List = 1
     3446     .
     3447     def var column-handle as handle no-undo .
     3448     column-handle = Fin-Doc-List:first-column.
     3449     do while valid-handle(column-handle) :
     3450       if column-handle = cur-clmnFin-Doc-List then do:
     3451         leave .
     3452       end.
     3453       column-handle = column-handle:NEXT-COLUMN.
     3454       assign
     3455         cur-clmn-locFin-Doc-List = cur-clmn-locFin-Doc-List + 1
     3456       .
     3457     end.
     3458     case sort-labelFin-Doc-List:
     3459           when 'Тип'  then DO:    assign       sort-column-name1 = "buf_fin-doc.fin-doc-type"     .     run OpenBr1(yes, no, '':U).   . END.
     3460           when 'Статус'  then DO:    assign       sort-column-name1 = "buf_fin-doc.status_"     .     run OpenBr1(yes, no, '':U).   . END.
     3461           when '№ док-та'  then DO:    assign       sort-column-name1 = "buf_fin-doc.prn-doc-code"     .     run OpenBr1(yes, no, '':U).   . END.
     3462           when 'Создан'  then DO:    assign       sort-column-name1 = "buf_fin-doc.doc-date"     .     run OpenBr1(yes, no, '':U).   . END.
     3463           when 'Сумма в выбр.вал.'  then DO:   assign       sort-column-name1 = substitute('dynamic-function(&1get-curr-sum&1,&2,&3,&4,&5,&6,&7,&8)', chr(34), s-curr-code, buf_fin-doc.curr-code, buf_fin-doc.contract-curr, buf_fin-doc.sum-contr, buf_fin-doc.sum-rubl, buf_fin-doc.sum-base, buf_fin-doc.sum-doc)     .     run OpenBr1(yes, no, '':U).   . END.
     3464           when 'Сумма связи (в.д.)'  then DO:    assign       sort-column-name1 = "buf_fin-doc.con-sum-contr"     .     run OpenBr1(yes, no, '':U).   . END.
     3465           when 'Своб. остаток (в.д.)'  then DO:   assign       sort-column-name1 = substitute('dynamic-function(&1get-ostat&1,&2,&3)', chr(34), buf_fin-doc.sum-contr, buf_fin-doc.con-sum-contr)     .     run OpenBr1(yes, no, '':U).   . END.
     3466           when 'Договор'  then DO:   assign       sort-column-name1 = substitute('dynamic-function(&1contract-id&1,&2)', chr(34), buf_fin-doc.contract-code)     .     run OpenBr1(yes, no, '':U).   . END.
     3467           when 'Код получ.'  then DO:    assign       sort-column-name1 = "(buf_fin-doc.receiver-type + ' ' + string(buf_fin-doc.receiver-code))"     .     run OpenBr1(yes, no, '':U).   . END.
     3468           when 'Получатель'  then DO:    assign       sort-column-name1 = "buf_fin-doc.receiver-name"     .     run OpenBr1(yes, no, '':U).   . END.
     3469           when 'Код плател.'  then DO:    assign       sort-column-name1 = "(buf_fin-doc.payer-type + ' ' + string(buf_fin-doc.payer-code))"     .     run OpenBr1(yes, no, '':U).   . END.
     3470           when 'Плательщик'  then DO:    assign       sort-column-name1 = "buf_fin-doc.payer-name"     .     run OpenBr1(yes, no, '':U).   . END.
     3471           when 'Разр.'  then DO:    assign       sort-column-name1 = "buf_fin-doc.perm-date"     .     run OpenBr1(yes, no, '':U).   . END.
     3472           when 'Платеж'  then DO:    assign       sort-column-name1 = "buf_fin-doc.pay-date"     .     run OpenBr1(yes, no, '':U).   . END.
     3473           when 'Закрыт'  then DO:    assign       sort-column-name1 = "buf_fin-doc.fact-date"     .     run OpenBr1(yes, no, '':U).   . END.
     3474           when 'Вал'  then DO:   assign       sort-column-name1 = substitute('dynamic-function(&1get-currency&1,&2)', chr(34), buf_fin-doc.curr-code)     .     run OpenBr1(yes, no, '':U).   . END.
     3475           when 'Сумма в валюте док-та'  then DO:    assign       sort-column-name1 = "buf_fin-doc.sum-doc"     .     run OpenBr1(yes, no, '':U).   . END.
     3476           when 'Расш.тип'  then DO:    assign       sort-column-name1 = "buf_fin-doc.fin-ext-doc-type"     .     run OpenBr1(yes, no, '':U).   . END.
     3477           when 'Вн.N'  then DO:    assign       sort-column-name1 = "buf_fin-doc.fin-doc-code"     .     run OpenBr1(yes, no, '':U).   . END.
     3478           when 'Объект'  then DO:    assign       sort-column-name1 = "(if buf_fin-doc.obj-code = 0 then '' else (buf_fin-doc.obj-type + ' ' + string(buf_fin-doc.obj-code)))"     .     run OpenBr1(yes, no, '':U).   . END.
     3479       otherwise do:
     3480         assign
     3481           sort-column-name1 = ""
     3482         .
     3483         run OpenBr1(yes, no, '':U).
     3484           if can-do( this-procedure:internal-entries, 'mv-brw-defaultFin-Doc-List') then do:
     3485             run mv-brw-defaultFin-Doc-List.
     3486           end.
     3487         if sort-labelFin-Doc-List <> "" then do:
     3488           assign
     3489             cur-clmnFin-Doc-List:column-fgcolor = 0
     3490           .
     3491         end.
     3492         assign
     3493           cur-clmn-locFin-Doc-List = ?
     3494         .
     3495       end.
     3496     end case.
     3497       if cur-clmn-locFin-Doc-List <> ? then do:
     3498         if can-do( this-procedure:internal-entries, 'ch-clmnFin-Doc-List') then do:
     3499           run ch-clmnFin-Doc-List in this-procedure (cur-clmn-locFin-Doc-List).
     3500         end.
     3501       end.
     3502     if p-recid <> ? then do:
     3503       reposition Fin-Doc-List to recid p-recid no-error.
     3504       apply "value-changed" to Fin-Doc-List in frame Dialog-Frame.
     3505     end.
     3506     apply "entry" to Fin-Doc-List in frame Dialog-Frame.
     3507   END PROCEDURE.
     3508   procedure re-open-query-srt-clmnFin-Doc-List:
     3509   if cur-clmnFin-Doc-List = ? then do:
     3510      run OpenBr1(yes, no, '':U).
     3511   end.
     3512   else do:
     3513      assign re-queryFin-Doc-List = yes.
     3514      run sort-brFin-Doc-List
     3515        (input (if available buf_fin-doc
     3516                then recid(buf_fin-doc)
     3517                else ?
     3518               )
     3519        ).
     3520      assign re-queryFin-Doc-List = no.
     3521   end.
     3522   end.
     3523   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3524   on ' ' of date-1 in frame Dialog-Frame
