     4293   PROCEDURE start-mv-clmnFin-Ob-List:
     4294   def var old-session as logical no-undo.
     4295      old-session = SESSION:IMMEDIATE-DISPLAY.
     4296      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4297          IF  true = true   THEN DO:
     4298      DO jjFin-Ob-List = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     4299        RUN re-move-clmnFin-Ob-List ( cur-clmn-numFin-Ob-List[INTEGER(ENTRY (jjFin-Ob-List, v-order-col))] , 2).
     4300      END.
     4301          END.
     4302      SESSION:IMMEDIATE-DISPLAY = old-session.
     4303   END.
     4304   ON ctrl-cursor-right OF BROWSE Fin-Ob-List do:
     4305     RUN re-move-clmnFin-Ob-List ( 2, 19).
     4306   END.
     4307   ON ctrl-cursor-left OF BROWSE Fin-Ob-List do:
     4308     RUN re-move-clmnFin-Ob-List (19, 2).
     4309   END.
     4310   PROCEDURE re-move-clmnFin-Ob-List:
     4311     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4312     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4313     DO varmviFin-Ob-List = 1 TO EXTENT(cur-clmn-numFin-Ob-List):
     4314       if cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = source-column THEN cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = -1.
     4315     END.
     4316     if Fin-Ob-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4317     if source-column > target-column THEN
     4318     DO varmvjFin-Ob-List = source-column - 1 to target-column BY -1:
     4319       DO varmviFin-Ob-List = 1 TO EXTENT(cur-clmn-numFin-Ob-List):
     4320           if cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = varmvjFin-Ob-List THEN DO:
     4321             cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = cur-clmn-numFin-Ob-List[varmviFin-Ob-List] + 1.
     4322           END.
     4323       END.
     4324     END.
     4325     ELSE
     4326     DO varmvjFin-Ob-List = source-column + 1 to target-column:
     4327       DO varmviFin-Ob-List = 1 TO EXTENT(cur-clmn-numFin-Ob-List):
     4328         if cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = varmvjFin-Ob-List THEN DO:
     4329           cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = cur-clmn-numFin-Ob-List[varmviFin-Ob-List] - 1.
     4330         END.
     4331       END.
     4332     END.
     4333     DO varmviFin-Ob-List = 1 TO EXTENT(cur-clmn-numFin-Ob-List):
     4334       if cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = -1 THEN cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = target-column.
     4335     END.
     4336   END PROCEDURE.
     4337   PROCEDURE ch-clmnFin-Ob-List:
     4338     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4339     if cur-clmn-loc <= 2 then do:
     4340       return .
     4341     end.
     4342     DO varmviFin-Ob-List = 1 TO EXTENT(cur-clmn-numFin-Ob-List):
     4343       if cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = cur-clmn-loc THEN move-elementFin-Ob-List = varmviFin-Ob-List.
     4344     END.
     4345     RUN re-move-clmnFin-Ob-List (cur-clmn-loc, 2).
     4346   END PROCEDURE.
