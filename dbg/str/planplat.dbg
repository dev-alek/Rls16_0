      693   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      695   procedure fltopend_fltopend :
      696   define input parameter p-parent-handle as handle no-undo .
      697   define input parameter p-qh as handle no-undo .
      698   define input parameter p-flt-open-open-query  as character no-undo .
      699   define input parameter p-where-cond as character no-undo .
      700   define input parameter p-use-indFIRST-query-tail as character no-undo .
      701   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      702   define input parameter p-indexed-reposition as character no-undo .
      703     do
      704     on error undo, return error
      705     :
      706   define variable v-prepare-string as character no-undo .
      707   define variable glog as logical no-undo .
      708   assign
      709   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      710                      p-where-cond + chr(32)  +
      711                      p-use-indFIRST-query-tail + chr(32) +
      712                      p-use-ind-sort-clmn-by + chr(32) +
      713                      p-indexed-reposition
      714   .
      715   assign
      716   glog = p-qh:query-prepare(v-prepare-string) no-error .
      717   if not glog
      718   or error-status:error then do:
      719     message error-status:get-message(1) view-as alert-box .
      720     undo, return error .
      721   end.
      722   assign
      723   glog = p-qh:query-open no-error .
      724   if not glog
      725   or error-status:error then do:
      726     message error-status:get-message(1) view-as alert-box .
      727     undo, return error .
      728   end.
      729     end.
      730   end procedure.
      731   procedure fltopend_fltfindd :
      732   define input parameter p-parent-handle as handle no-undo .
      733   define input parameter p-qh as handle no-undo .
      734   define input parameter p-rowid as rowid no-undo .
      735   define input parameter p-next as logical no-undo .
      736   define input parameter p-lock as integer no-undo .
      737   define input parameter p-bh as handle no-undo .
      738   define input parameter p-where-cond as character no-undo .
      739   define input parameter p-use-index-phrase as character no-undo .
      740   define variable glog as logical no-undo .
      741   define variable v-qh as handle no-undo .
      742   define variable v-bh as handle no-undo .
      743   define variable v-recid as recid no-undo .
      744   define variable v-prepare-string as character no-undo .
      745   do
      746   on error undo, return error
      747   on stop undo, return error
      748   :
      749     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      750     create buffer v-bh for table p-bh buffer-name p-bh:name.
      751     create query v-qh.
      752     v-qh:set-buffers(v-bh).
      753     v-prepare-string = substitute("for each &1 &2 &3"
      754                                     ,v-bh:name
      755                                     ,p-where-cond
      756                                     ,p-use-index-phrase).
      757     glog = v-qh:query-prepare(v-prepare-string) no-error.
      758     if not glog then do:
      759       delete object v-qh.
      760       delete object v-bh.
      761       undo, return error .
      762     end.
      763     glog = v-qh:query-open no-error .
      764     if not glog then do:
      765       delete object v-qh.
      766       delete object v-bh.
      767       undo, return error .
      768     end.
      769     if p-next then do:
      770       v-qh:reposition-to-rowid(p-rowid) no-error .
      771       glog = v-qh:get-next( p-lock) no-error .
      772       glog = v-qh:get-next( p-lock) no-error .
      773       if not glog or v-qh:query-off-end = yes then do:
      774         glog = v-qh:get-first( p-lock) no-error .
      775       end.
      776     end.
      777     else do:
      778       glog = v-qh:get-first( p-lock) no-error .
      779     end.
      780     v-recid = v-bh:recid no-error .
      781     delete object v-qh.
      782     delete object v-bh.
      783     return string(v-recid) .
      784   end.
      785   end procedure.
      786   procedure fltopend_fltfindq :
      787   define input parameter p-parent-handle as handle no-undo .
      788   define input parameter p-qh as handle no-undo .
      789   define input parameter p-next as logical no-undo .
      790   define input parameter p-lock as integer no-undo .
      791   define input parameter p-flt-open-open-query  as character no-undo .
      792   define input parameter p-where-cond as character no-undo .
      793   define input parameter p-use-indFIRST-query-tail as character no-undo .
      794   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      795   define input parameter p-indexed-reposition as character no-undo .
      796   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      797   define variable glog as logical no-undo .
      798   define variable v-qh as handle no-undo .
      799   define variable v-bh as handle no-undo extent 18.
      800   define variable v-rowid as rowid no-undo extent 18.
      801   define variable v-ii as integer no-undo .
      802   define variable v-prepare-string as character no-undo .
      803   do
      804   on error undo, return error
      805   on stop undo, return error
      806   :
      807     create query v-qh.
      808     do v-ii = 1 to p-qh:num-buffers:
      809       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      810       assign
      811       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      812       no-error.
      813       v-qh:add-buffer(v-bh[v-ii]).
      814     end.
      815     assign
      816     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      817                       p-where-cond + chr(32)  +
      818                       p-use-indFIRST-query-tail + chr(32) +
      819                       p-use-ind-sort-clmn-by + chr(32) +
      820                       p-indexed-reposition
      821     .
      822     glog = v-qh:query-prepare( v-prepare-string) no-error .
      823     if not glog then do:
      824       delete object v-qh.
      825       do v-ii = 1 to p-qh:num-buffers:
      826         delete object v-bh[v-ii].
      827       end.
      828       undo, return error .
      829     end.
      830     glog = v-qh:query-open no-error .
      831     if not glog then do:
      832       delete object v-qh.
      833       do v-ii = 1 to p-qh:num-buffers:
      834         delete object v-bh[v-ii].
      835       end.
      836       undo, return error .
      837     end.
      838     if p-next then do:
      839       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      840       glog = v-qh:get-next( p-lock) no-error .
      841       glog = v-qh:get-next( p-lock) no-error .
      842       if not glog or v-qh:query-off-end = yes then do:
      843         glog = v-qh:get-first( p-lock) no-error .
      844       end.
      845     end.
      846     else do:
      847       glog = v-qh:get-first( p-lock) no-error .
      848     end.
      849     do v-ii = 1 to p-qh:num-buffers:
      850       assign
      851       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      852       no-error.
      853     end.
      854     delete object v-qh.
      855     do v-ii = 1 to p-qh:num-buffers:
      856       delete object v-bh[v-ii].
      857     end.
      858   end.
      859   end procedure.
      860   assign
