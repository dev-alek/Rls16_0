     4281   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4282   DEF VAR cur-clmn-numFin-Ob-List as INT EXTENT 19 no-undo.
     4283   DEF VAR varmviFin-Ob-List       as INT no-undo.
     4284   DEF VAR varmvjFin-Ob-List       as INT no-undo.
     4285   DEF VAR varmvkFin-Ob-List       as INT no-undo.
     4286   DEF VAR varmvlFin-Ob-List       as INT no-undo.
     4287   DEF VAR move-elementFin-Ob-List as INT no-undo.
     4288   def var jjFin-Ob-List           as int no-undo.
     4289   do varmviFin-Ob-List = 1 to EXTENT(cur-clmn-numFin-Ob-List):
     4290     ASSIGN cur-clmn-numFin-Ob-List[varmviFin-Ob-List] = varmviFin-Ob-List.
