     8387         .
     8388         assign
     8389           v-doc-rec = integer(return-value)
     8390           v-fltopend-rowid[1] = ?
     8391         .
     8392       end.
     8393       else do:
     8394         assign
     8395         parameter-2-65 = (if p-find-next then "true":u else "false":u )
     8396         parameter-3-65 =  "FOR EACH buf_fin-ob"
     8397         parameter-4-65 =
     8398           (
     8399             if (" buf_fin-ob.host-code = p-host-code and buf_fin-ob.doc-type = p-fo-type and buf_fin-ob.status_ = 'факт':U  and buf_fin-ob.con-stat <> 2 and buf_fin-ob.curr-code = curr-code  " + " " + where-phrase-65) <> ""
     8400             then  substitute(' buf_fin-ob.host-code = &1 and buf_fin-ob.doc-type = &5&2&5 and buf_fin-ob.status_ = &5&3&5 and buf_fin-ob.con-stat <> 2 and buf_fin-ob.curr-code = &4 ', p-host-code, p-fo-type, 'факт':U, curr-code , chr(34)) + " " + where-phrase-65
     8401             else "true"
     8402           )
     8403         parameter-5-65 = (" " + "" + " " + substitute(', first temp-contr where temp-contr.id = &1 ',buf_fin-ob.contract-code) + " " + p-find-condition)
     8404         parameter-6-65 = if sort-phrase-65 = ''
     8405                              then
     8406           (
     8407           " " + "  " +
     8408             " " + sort-column-phrase +
     8409           " " + " by buf_fin-ob.pay-date descending "
     8410           )
     8411                              else
     8412           (
     8413           " " + "  " +
     8414             " " + sort-column-phrase +
     8415           " " + sort-phrase-65
     8416           )
     8417         parameter-7-65 =
     8418           "   "
     8419       .
     8420         run fltopend_fltfindq in this-procedure  (
     8421                             input this-procedure:handle
     8422                             ,input query Fin-Ob-List:handle
     8423                             ,input logical(parameter-2-65)
     8424                             ,input no-lock
     8425                             ,input parameter-3-65
     8426                             ,input parameter-4-65
     8427                             ,input parameter-5-65
     8428                             ,input parameter-6-65
     8429                             ,input parameter-7-65
     8430                             ,output v-fltopend-rowid
     8431                             ) no-error.
     8432         .
     8433         v-doc-rec = ?.
     8434       end.
     8435       assign
     8436         l-query-was-opened = true
     8437       .
     8438     end.
     8439   end.
     8440     run waitfram-hide in this-procedure .
     8441       end.
     8442     end.
     8443     REPOSITION Fin-Ob-List to recid v-doc-rec No-ERROR.
     8444   END PROCEDURE.
     8445   PROCEDURE proc-check-contract :
     8446     define buffer b_fin-ob for fin-ob .
     8447     define buffer b_fin-doc for fin-doc .
     8448     define variable num-cont as integer   no-undo .
     8449     define variable is-del as logical   no-undo .
     8450     define variable obj-type as character no-undo .
     8451     define variable obj-code as integer no-undo .
     8452     assign num-cont = - 1 .
     8453     for each temp-fin-ob :
     8454       find first b_fin-ob no-lock where recid(b_fin-ob) = temp-fin-ob.ri .
     8455       if num-cont = - 1 then
     8456         assign
     8457           num-cont = b_fin-ob.contract-code
     8458           obj-type = b_fin-ob.obj-type
     8459           obj-code = b_fin-ob.obj-code
     8460         .
     8461       else do:
     8462         if obj-code <> 0 then do:
     8463           if obj-type <> b_fin-ob.obj-type or obj-code <> b_fin-ob.obj-code then assign obj-code = 0 .
     8464         end.
     8465         if num-cont <> b_fin-ob.contract-code then do:
     8466           message
     8467             "Фин. обязательство № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") относится к другому договору, чем предыдущие док-ты!"
     8468           view-as alert-box.
     8469           return error .
     8470         end.
     8471       end.
     8472       if b_fin-ob.con-stat = 2 then do:
     8473         message
     8474           "Фин. обязательство № " b_fin-ob.prn-doc-code " (дата платежа " b_fin-ob.pay-date ") уже полностью связано с платежем! Если хотите связать заново, то удалите сначала старую связь"
     8475         view-as alert-box.
     8476         return error .
     8477       end.
     8478     end.
     8479     for each temp-fin-doc :
     8480       find first b_fin-doc no-lock where recid(b_fin-doc) = temp-fin-doc.ri .
     8481       if num-cont = - 1 then
     8482         assign
     8483           num-cont = b_fin-doc.contract-code
     8484         .
     8485       else do:
     8486         if obj-code <> 0 then do:
     8487           if obj-type <> b_fin-doc.obj-type or obj-code <> b_fin-doc.obj-code then assign obj-code = 0 .
     8488         end.
     8489         if num-cont <> b_fin-doc.contract-code then do:
     8490           message
     8491             "Платеж № " b_fin-doc.prn-doc-code " от " b_fin-doc.doc-date " относится к другому договору, чем предыдущие док-ты!"
     8492           view-as alert-box.
     8493           return error .
     8494         end.
     8495       end.
     8496       if b_fin-ob.con-stat = 2  then do:
     8497         message
     8498           "Платеж № " b_fin-doc.prn-doc-code " от " b_fin-doc.doc-date " уже полностью связан с фин. обяз.! Если хотите связать заново, то удалите сначала старую связь"
     8499         view-as alert-box.
     8500         return error .
     8501       end.
     8502     end.
     8503     if sysconf.fin-calc = 1 and obj-code = 0 then do:
     8504       message
     8505         substitute ("По фирме &1 ведется раздельный учет по объектам с поставщиками. Нельзя связать платежи и ФО с разных объектов.",sysconf.host-code)
     8506       view-as alert-box.
     8507       return error .
     8508     end.
     8509   END PROCEDURE.
     8510   PROCEDURE proc-find-cli :
     8511     define input parameter p-next as logical no-undo.
     8512     define input parameter p-code as integer   no-undo .
     8513     define input parameter p-type as character no-undo .
     8514     display "  /  /":U @ sch-date "":U @ sch-code  with frame Dialog-Frame.
     8515     assign p-type = chr(34) + p-type + chr(34).
     8516     if RADIO-find-doc = 1 then do:
     8517       if RADIO-find-cli = 1 then run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.payer-code = &1 and buf_fin-ob.payer-type = &2 ", p-code, p-type)) .
     8518       else                       run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.receiver-code = &1 and buf_fin-ob.receiver-type = &2 ", p-code, p-type)) .
     8519     end.
     8520     else do:
     8521       if RADIO-find-cli = 1 then run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.payer-code = &1 and buf_fin-doc.payer-type = &2 ", p-code, p-type)) .
     8522       else                       run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.receiver-code = &1 and buf_fin-doc.receiver-type = &2 ", p-code, p-type)) .
     8523     end.
     8524     apply "entry":u to cli-code in frame Dialog-Frame .
     8525   END PROCEDURE.
     8526   PROCEDURE proc-find-cli-name :
     8527     define input parameter p-next as logical no-undo.
     8528     define input parameter p-code as character no-undo .
     8529     display "  /  /":U @ sch-date "":U @ sch-code 0 @ cli-code "":U @ cli-type with frame Dialog-Frame.
     8530     assign p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     8531     if RADIO-find-doc = 1 then do:
     8532       if RADIO-find-cli = 1 then run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.payer-name begins '&1' ", p-code)) .
     8533       else                       run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.receiver-name begins '&1' ", p-code)) .
     8534     end.
     8535     else do:
     8536       if RADIO-find-cli = 1 then run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.payer-name begins '&1' ", p-code)) .
     8537       else                       run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.receiver-name begins '&1' ", p-code)) .
     8538     end.
     8539     apply "entry":u to cli-name in frame Dialog-Frame .
     8540   END PROCEDURE.
     8541   PROCEDURE proc-find-code :
     8542     define input parameter p-next as logical no-undo.
     8543     define input parameter p-code as character no-undo .
     8544     display "  /  /":U @ sch-date 0 @ cli-code "":U @ cli-type "":U @ cli-name with frame Dialog-Frame.
     8545     assign p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     8546     if RADIO-find-doc = 1 then do:
     8547       if p-code = '""' then run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.prn-doc-code = '' " )).
     8548       else                  run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-ob.prn-doc-code begins '&1' ", p-code)).
     8549     end.
     8550     else do:
     8551       if p-code = '""' then run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.prn-doc-code = '' " )).
     8552       else                  run OpenBr1 in this-procedure (input false, input p-next, input substitute("and buf_fin-doc.prn-doc-code begins '&1' ", p-code)).
     8553     end.
     8554     apply "entry":u to sch-code in frame Dialog-Frame .
     8555   END PROCEDURE.
     8556   PROCEDURE proc-find-date :
     8557     define input parameter p-next as logical no-undo.
     8558     define input parameter par-date as date    no-undo .
     8559     display "":U @ sch-code 0 @ cli-code "":U @ cli-type "":U @ cli-name  with frame Dialog-Frame.
     8560     define variable var-datechr as character no-undo .
     8561     assign var-datechr = string(day(par-date)) + chr(47) + string(month(par-date)) + chr(47) + string(year(par-date)) .
     8562     if RADIO-find-doc = 1 then run OpenBr  in this-procedure (input false, input p-next,input substitute("and buf_fin-ob.pay-date = &1 ", var-datechr)) .
     8563     else                       run OpenBr1 in this-procedure (input false, input p-next,input substitute("and buf_fin-doc.doc-date = &1 ", var-datechr)) .
     8564     apply "entry":u to sch-date in frame Dialog-Frame .
     8565   END PROCEDURE.
     8566   PROCEDURE proc-mark :
     8567     assign
     8568       sum-fin-ob = 0
     8569       num-fin-ob = 0
     8570     .
     8571     GET FIRST Fin-Ob-List NO-LOCK .
     8572     DO WHILE AVAILABLE(buf_fin-ob):
     8573       find first temp-fin-ob where temp-fin-ob.ri = recid( buf_fin-ob ) no-error .
     8574       if available temp-fin-ob then do:
     8575         assign
     8576           num-fin-ob = num-fin-ob + 1
     8577           temp-fin-ob.del = no
     8578         .
     8579         assign
     8580           sum-fin-ob = sum-fin-ob + get-free-sum(buffer buf_fin-ob)
     8581         .
     8582       end.
     8583       GET next Fin-Ob-List NO-LOCK .
     8584     end.
     8585     for each temp-fin-ob where temp-fin-ob.del = yes : delete temp-fin-ob . end.
     8586     if num-fin-ob = 0 then hide mark-num in frame Dialog-Frame.
     8587     else                   display num-fin-ob @ mark-num  with frame Dialog-Frame.
     8588     display sum-fin-ob  with frame Dialog-Frame.
     8589   end.
     8590   PROCEDURE proc-mark1 :
     8591     assign
     8592       sum-fin-doc = 0
     8593       num-fin-doc = 0
     8594     .
     8595     GET FIRST Fin-Doc-List NO-LOCK .
     8596     DO WHILE AVAILABLE(buf_fin-doc):
     8597       find first temp-fin-doc where temp-fin-doc.ri = recid( buf_fin-doc ) no-error .
     8598       if available temp-fin-doc then do:
     8599         assign
     8600           num-fin-doc = num-fin-doc + 1
     8601           temp-fin-doc.del = no
     8602         .
     8603         assign
     8604           sum-fin-doc = sum-fin-doc + get-free-sum1(buffer buf_fin-doc)
     8605         .
     8606       end.
     8607       GET next Fin-Doc-List NO-LOCK .
     8608     end.
     8609     for each temp-fin-doc where temp-fin-doc.del = yes : delete temp-fin-doc . end.
     8610     if num-fin-doc = 0 then hide mark-num-2 in frame Dialog-Frame.
     8611     else                   display num-fin-doc @ mark-num-2  with frame Dialog-Frame.
     8612     display sum-fin-doc  with frame Dialog-Frame.
     8613   end.
     8614   FUNCTION contract-gen RETURNS CHARACTER
     8615     ( input p-contract-code as integer ) :
     8616     define variable rr as character no-undo .
     8617     define buffer buf_contract for contract.
     8618     find first buf_contract no-lock where  buf_contract.host-code      = p-host-code  and buf_contract.contract-code  = p-contract-code no-error.
     8619     if available buf_contract then   rr = buf_contract.usl-opl .
     8620     else rr = "".
     8621     RETURN rr.
     8622   END FUNCTION.
     8623   FUNCTION contract-id RETURNS CHARACTER
     8624     ( input p-contract-code as integer ) :
     8625     define variable rr as character no-undo .
     8626     define buffer buf_contract for contract.
     8627     find first buf_contract no-lock where  buf_contract.host-code      = p-host-code and buf_contract.contract-code  = p-contract-code  no-error.
     8628     if available buf_contract then   rr = buf_contract.contract-prn-code.
     8629     else rr = "".
     8630     RETURN rr.
     8631   END FUNCTION.
     8632   FUNCTION get-curr-sum RETURNS decimal
     8633     ( input p-cur as integer, input p-doc-curr as integer, input p-cur-contr as integer, input p-sum-contract as decimal, input p-sum-rubl as decimal, input p-sum-base as decimal, input p-sum-doc as decimal ) :
     8634     define variable sum as decimal   no-undo .
     8635     if p-cur = p-cur-contr then assign sum = p-sum-contract .
     8636     else do:
     8637       if p-cur = 1 then assign sum = p-sum-base .
     8638       else do:
     8639         if p-cur = p-doc-curr then assign sum = p-sum-doc .
     8640         else do:
     8641           if p-cur = 0 then assign sum = p-sum-rubl .
     8642           else assign sum = ? .
     8643         end.
     8644       end.
     8645     end.
     8646     RETURN sum .
     8647   END FUNCTION.
     8648   FUNCTION get-currency RETURNS CHARACTER
     8649     ( input curr-code as integer ) :
     8650   define variable var-curr-name as character no-undo.
     8651   define buffer buf_currency for currency.
     8652     find first buf_currency no-lock where buf_currency.curr-code = curr-code no-error .
     8653     if available buf_currency then assign var-curr-name = buf_currency.curr-abbr .
     8654   RETURN var-curr-name.
     8655   END FUNCTION.
     8656   FUNCTION get-free-sum RETURNS decimal
     8657     ( BUFFER loc-fin-ob FOR fin-ob ) :
     8658     define variable sum as decimal   no-undo .
     8659     if s-curr-code = loc-fin-ob.contract-curr then assign sum = loc-fin-ob.sum-contract - loc-fin-ob.con-sum-contr .
     8660     else do:
     8661       if s-curr-code = 1 then assign sum = loc-fin-ob.sum-base - loc-fin-ob.con-sum-base .
     8662       else do:
     8663         if s-curr-code = loc-fin-ob.curr-code then assign sum = loc-fin-ob.sum-doc - loc-fin-ob.con-sum-doc .
     8664         else do:
     8665           if s-curr-code = 0 then assign sum = loc-fin-ob.sum-rubl - loc-fin-ob.con-sum-rubl .
     8666           else assign sum = ? .
     8667         end.
     8668       end.
     8669     end.
     8670     RETURN sum .
     8671   END FUNCTION.
     8672   FUNCTION get-free-sum1 RETURNS decimal
     8673     ( BUFFER loc-fin-doc FOR fin-doc ) :
     8674     define variable sum as decimal   no-undo .
     8675     if s-curr-code = 0 then assign sum = loc-fin-doc.sum-rubl - loc-fin-doc.con-sum-rubl .
     8676     else do:
     8677       if s-curr-code = 1 then assign sum = loc-fin-doc.sum-base - loc-fin-doc.con-sum-base .
     8678       else do:
     8679         if s-curr-code = loc-fin-doc.curr-code then assign sum = loc-fin-doc.sum-doc - loc-fin-doc.con-sum-doc .
     8680         else do:
     8681           if s-curr-code = loc-fin-doc.contract-curr then assign sum = loc-fin-doc.sum-contr - loc-fin-doc.con-sum-contr .
     8682           else assign sum = ? .
     8683         end.
     8684       end.
     8685     end.
     8686     if p-doc-type = 'при':U then do:
     8687       if loc-fin-doc.fin-ext-doc-type = 'апп':U or
     8688          loc-fin-doc.fin-ext-doc-type = 'пко':U or
     8689          loc-fin-doc.fin-ext-doc-type = 'ппп':U then assign sum = - sum .
     8690     end.
     8691     else do:
     8692       if loc-fin-doc.fin-ext-doc-type = 'апр':U or
     8693          loc-fin-doc.fin-ext-doc-type = 'рко':U or
     8694          loc-fin-doc.fin-ext-doc-type = 'рпп':U then assign sum = - sum .
     8695     end.
     8696     RETURN sum .
     8697   END FUNCTION.
     8698   FUNCTION get-ostat RETURNS decimal
     8699     ( input p-sum1 as decimal, input p-sum2 as decimal ) :
     8700     RETURN p-sum1 - p-sum2 .
     8701   END FUNCTION.
     8702   FUNCTION mark-string RETURNS CHARACTER
     8703     ( input par-recid as recid, input typ as integer ) :
     8704     define variable ret as character no-undo .
     8705     assign ret = "" .
     8706     define buffer b_fin-ob for fin-ob.
     8707     define buffer b_fin-doc for fin-doc.
     8708     if typ = 0 then do:
     8709       find first temp-fin-ob where temp-fin-ob.ri = par-recid no-error .
     8710       if available temp-fin-ob then
     8711         assign
     8712           ret = "*"
     8713           temp-fin-ob.del = no
     8714         .
     8715     end.
     8716     else do:
     8717       find first temp-fin-doc where temp-fin-doc.ri = par-recid no-error .
     8718       if available temp-fin-doc then
     8719         assign
     8720           ret = "*"
     8721           temp-fin-doc.del = no
     8722         .
     8723     end.
     8724     RETURN ret .
     8725   END FUNCTION.
