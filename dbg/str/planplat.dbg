     4437   RUN disable_UI.
     4438   PROCEDURE conn-avt :
     4439   do on error undo, return error return-value :
     4440     define input  parameter p-ri as recid     no-undo .
     4441     define input  parameter p-list         as  character no-undo .
     4442     define variable csum as decimal   no-undo .
     4443     define variable is-plus as logical   no-undo .
     4444     define variable ii as integer   no-undo .
     4445     define variable p-sys-time  as character no-undo .
     4446     find first fin-doc no-lock where recid(fin-doc) = p-ri .
     4447     assign csum = fin-doc.sum-contr - fin-doc.con-sum-contr .
     4448     for each temp_fin-ob : delete temp_fin-ob . end.
     4449     if p-doc-type = 'при':U then do:
     4450       if   fin-doc.fin-doc-type = 'рпп':U
     4451         or fin-doc.fin-doc-type = 'рко':U
     4452         or fin-doc.fin-doc-type = 'апр':U then assign is-plus = yes .
     4453       else
     4454         assign
     4455           is-plus = no
     4456           csum = - csum
     4457         .
     4458     end.
     4459     else do:
     4460       if   fin-doc.fin-doc-type = 'ппп':U
     4461         or fin-doc.fin-doc-type = 'пко':U
     4462         or fin-doc.fin-doc-type = 'апп':U then assign is-plus = yes .
     4463       else
     4464         assign
     4465           is-plus = no
     4466           csum = - csum
     4467         .
     4468     end.
     4469     define variable p-new as character no-undo .
     4470     DO ii = 1 TO NUM-ENTRIES(p-list) :
     4471       find first fin-ob NO-LOCK WHERE RECID( fin-ob ) = INT ( ENTRY( ii, p-list) ) .
     4472       if is-plus = yes and fin-ob.sum-contr > 0 or is-plus = no and fin-ob.sum-contr < 0  then do:
     4473         if p-new = "" then  assign p-new = ENTRY( ii, p-list).
     4474         else  assign p-new = p-new + "," + ENTRY( ii, p-list) .
     4475       end.
     4476       else do:
     4477         CREATE temp_fin-ob .
     4478         BUFFER-COPY fin-ob TO temp_fin-ob .
     4479         assign temp_fin-ob.ri = RECID( fin-ob ) .
     4480         assign
     4481           temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     4482           csum = csum - temp_fin-ob.no-con-sum
     4483         .
     4484       end.
     4485     end.
     4486     assign p-list = p-new .
     4487     DO ii = 1 TO NUM-ENTRIES(p-list) :
     4488       find first fin-ob NO-LOCK WHERE RECID( fin-ob ) = INT ( ENTRY( ii, p-list) ) .
     4489       CREATE temp_fin-ob .
     4490       BUFFER-COPY fin-ob TO temp_fin-ob .
     4491       assign temp_fin-ob.ri = RECID( fin-ob ) .
     4492       if csum > 0 then do:
     4493         if csum > temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr then do:
     4494           assign
     4495             temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     4496             csum = csum - temp_fin-ob.no-con-sum
     4497           .
     4498         end.
     4499         else do:
     4500           assign
     4501             temp_fin-ob.no-con-sum = csum
     4502             csum = 0
     4503           .
     4504         end.
     4505       END.
     4506       else if csum < 0 then do:
     4507         if csum < temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr then do:
     4508           assign
     4509             temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     4510             csum = csum - temp_fin-ob.no-con-sum
     4511           .
     4512         end.
     4513         else do:
     4514           assign
     4515             temp_fin-ob.no-con-sum = csum
     4516             csum = 0
     4517           .
     4518         end.
     4519       END.
     4520     END.
     4521     define variable all-sum-contr as decimal   no-undo .
     4522     define variable all-sum-base as decimal   no-undo .
     4523     define variable all-sum-rubl as decimal   no-undo .
     4524     define variable all-sum-doc as decimal   no-undo .
     4525     for each temp_fin-ob :
     4526       if temp_fin-ob.no-con-sum = 0 then next.
     4527       create fin-connect .
     4528       assign
     4529         fin-connect.connect-code   = next-value( s-fin-connect, ub  )
     4530         fin-connect.host-code      = v-cntxt-host-code-obj
     4531         fin-connect.fin-doc-code   = fin-doc.fin-doc-code
     4532         fin-connect.fin-ob-code    = temp_fin-ob.doc-code
     4533         fin-connect.contract-code  = temp_fin-ob.contract-code
     4534         fin-connect.curr-code      = temp_fin-ob.curr-code
     4535         fin-connect.base-rate      = temp_fin-ob.base-rate
     4536         fin-connect.base-scale     = temp_fin-ob.base-scale
     4537         fin-connect.contract-curr  = temp_fin-ob.contract-curr
     4538         fin-connect.contract-rate  = temp_fin-ob.contract-rate
     4539         fin-connect.contract-scale = temp_fin-ob.contract-scale
     4540         fin-connect.exch-rate      = temp_fin-ob.exch-rate
     4541         fin-connect.exch-scale     = temp_fin-ob.exch-scale
     4542         fin-connect.status_        = 'тек':U
     4543         fin-connect.sum-contr      = temp_fin-ob.no-con-sum
     4544         fin-connect.sum-rubl       = round(fin-connect.sum-contr * fin-connect.contract-rate / fin-connect.contract-scale,2)
     4545         fin-connect.sum-base       = fin-connect.sum-rubl * fin-connect.base-scale / fin-connect.base-rate
     4546         fin-connect.sum-doc        = fin-connect.sum-rubl * fin-connect.exch-scale / fin-connect.exch-rate
     4547         fin-connect.sum-contr-ob   = fin-connect.sum-contr
     4548         fin-connect.sum-rubl-ob    = fin-connect.sum-rubl
     4549         fin-connect.sum-base-ob    = fin-connect.sum-base
     4550       .
     4551   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     4553     (output fin-connect.user-db-num
     4554     ,output fin-connect.user-name
     4555     ,output fin-connect.fact-date
     4556     ,output p-sys-time
     4557     ,output fin-connect.fact-time
     4558     )  .
     4559       find first fin-ob exclusive-lock where fin-ob.host-code = v-cntxt-host-code-obj and fin-ob.doc-code = temp_fin-ob.doc-code .
     4560       assign
     4561         fin-ob.con-sum-contr = fin-ob.con-sum-contr + fin-connect.sum-contr
     4562         fin-ob.con-sum-base  = fin-ob.con-sum-base  + fin-connect.sum-base
     4563         fin-ob.con-sum-rubl  = fin-ob.con-sum-rubl  + fin-connect.sum-rubl
     4564         fin-ob.con-sum-doc   = fin-ob.con-sum-doc   + fin-connect.sum-doc
     4565         all-sum-contr        = all-sum-contr + fin-connect.sum-contr
     4566         all-sum-base         = all-sum-base  + fin-connect.sum-base
     4567         all-sum-rubl         = all-sum-rubl  + fin-connect.sum-rubl
     4568         all-sum-doc          = all-sum-doc   + fin-connect.sum-doc
     4569       .
     4570       if fin-ob.sum-contr > 0 then do:
     4571         if fin-ob.sum-contr > fin-ob.con-sum-contr then assign fin-ob.con-stat = 1 .
     4572         else                                            assign fin-ob.con-stat = 2 .
     4573       end.
     4574       else do:
     4575         if fin-ob.sum-contr < fin-ob.con-sum-contr then assign fin-ob.con-stat = 1 .
     4576         else                                            assign fin-ob.con-stat = 2 .
     4577       end.
     4578     end.
     4579     if all-sum-contr <> 0 then do:
     4580       find current fin-doc exclusive-lock .
     4581       if is-plus then do:
     4582         assign
     4583           fin-doc.con-sum-contr = fin-doc.con-sum-contr + all-sum-contr
     4584           fin-doc.con-sum-base  = fin-doc.con-sum-base  + all-sum-base
     4585           fin-doc.con-sum-rubl  = fin-doc.con-sum-rubl  + all-sum-rubl
     4586           fin-doc.con-sum-doc   = fin-doc.con-sum-doc   + all-sum-doc
     4587         .
     4588         if fin-doc.sum-contr > fin-doc.con-sum-contr then assign fin-doc.con-stat = 1 .
     4589         else                                              assign fin-doc.con-stat = 2 .
     4590       end.
     4591       else do:
     4592         assign
     4593           fin-doc.con-sum-contr = fin-doc.con-sum-contr - all-sum-contr
     4594           fin-doc.con-sum-base  = fin-doc.con-sum-base  - all-sum-base
     4595           fin-doc.con-sum-rubl  = fin-doc.con-sum-rubl  - all-sum-rubl
     4596           fin-doc.con-sum-doc   = fin-doc.con-sum-doc   - all-sum-doc
     4597         .
     4598         if fin-doc.sum-contr > fin-doc.con-sum-contr then assign fin-doc.con-stat = 1 .
     4599         else                                              assign fin-doc.con-stat = 2 .
     4600       end.
     4601     end.
     4602     end.
     4603   end procedure.
     4604   PROCEDURE disable_UI :
     4605     HIDE FRAME Dialog-Frame.
     4606   END PROCEDURE.
     4607   PROCEDURE enable_UI :
     4608     DISPLAY sum-fin-doc sum-fin-ob sch-code RADIO-find-cli cli-code cli-type
     4609             RADIO-find-doc s-curr-code sch-date cli-name Curr-Types Sel-Client
     4610             Sel-Contr date-1 Sel-Status date-2 mark-num-2 mark-num curr-name
