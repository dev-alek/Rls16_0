     4613            B-conn-doc B-view-doc B-del-doc B-conn-fo B-view-fo Fin-Ob-List
     4614            Fin-Doc-List B-mark-2 B-unmark-2 B-allmark-2 sum-fin-doc B-mark
     4615            B-unmark B-allmark B-oplat sum-fin-ob BUTTON-cli sch-code
     4616            RADIO-find-cli cli-code cli-type RADIO-find-doc BUTTON-curr
     4617            s-curr-code sch-date cli-name Curr-Types Sel-Client Sel-Contr date-1
     4618            Sel-Status B-date date-2 mark-num-2 mark-num
     4619         WITH FRAME Dialog-Frame.
     4620     VIEW FRAME Dialog-Frame.
     4621   END PROCEDURE.
     4622   PROCEDURE find-cli :
     4623     define input  parameter p-obj-type as character no-undo .
     4624     define input  parameter p-obj-code as integer   no-undo .
     4625     define buffer buf_clients for clients .
     4626     if p-obj-type <> 'орг':U and p-obj-type <> 'чел':U then do:
     4627       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = p-obj-code no-error.
     4628       if not available buf_clients then do:
     4629         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = p-obj-code no-error.
     4630       end.
     4631     end.
     4632     else find first buf_clients no-lock where buf_clients.obj-type = p-obj-type and buf_clients.obj-code = p-obj-code no-error.
     4633     if not available buf_clients then do:
     4634       if p-obj-code = 0 then assign p-obj-code = ? .
     4635       if p-obj-code = ? then do:
     4636         assign  cli-name = ""  cli-code = ?  cli-type  = "" .
     4637         display cli-name       cli-code      cli-type   with frame Dialog-Frame.
     4638       end.
     4639       else do:
     4640           apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
     4641       end.
     4642       return.
     4643     end.
     4644     assign cli-name  = buf_clients.obj-name  cli-code  = p-obj-code  cli-type  = buf_clients.obj-type.
     4645     display cli-name    cli-code     cli-type   with frame Dialog-Frame.
     4646     run proc-find-cli in this-procedure(no, input cli-code, input cli-type ) no-error.
     4647     if error-status:error then return no-apply.
     4648   END PROCEDURE.
     4649   PROCEDURE OpenBr :
     4650     define input  parameter p-open-query     as logical   no-undo .
     4651     define input  parameter p-find-next      as logical   no-undo .
     4652     define input  parameter p-find-condition as character no-undo .
     4653     if available buf_fin-ob then assign v-doc-rec = recid (buf_fin-ob) .
     4654     assign frame Dialog-Frame:title = "Планирование платежей.  Фирма: (" + string(v-cntxt-host-code-obj) + ")":U + chr(32) + clients.obj-name  .
     4655     if Sel-Contr = "all" and Sel-Client = "all"  then RUN OpenBrAllContr( p-open-query, p-find-next, p-find-condition) .
     4656     else                                              RUN OpenBrSelContr( p-open-query, p-find-next, p-find-condition) .
     4657     run proc-mark in this-procedure .
     4658   END PROCEDURE.
     4659   PROCEDURE OpenBr1 :
     4660     define input  parameter p-open-query     as logical   no-undo .
     4661     define input  parameter p-find-next      as logical   no-undo .
     4662     define input  parameter p-find-condition as character no-undo .
