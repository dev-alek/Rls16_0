     5742                               if tree:LevelDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     5743                               do:
     5744                                   tree:StatusDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num, Marking:Checked_:KeyIntDB) .
     5745                                   for each X_marking-line exclusive-lock,
     5746                                       first bf_utd-marking-lines no-lock where
     5747                                             bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num
     5748                                         and bf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id
     5749                                         and bf_utd-marking-lines.mark   = X_marking-line.mark
     5750                                   :
     5751                                       X_marking-line.sts-utd = bf_utd-marking-lines.sts .
     5752                                       X_marking-line.stts-utd = StatusTHName(X_marking-line.sts-utd) .
     5753                                   end.
     5754                               end.
     5755                               else do:
     5756                                 assign
     5757                                   buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB
     5758                                 .
     5759                               end.
     5760                               for each X_marking-line exclusive-lock,
     5761                                   first bf_utd-marking-lines no-lock where
     5762                                         bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num
     5763                                     and bf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id
     5764                                     and bf_utd-marking-lines.mark   = X_marking-line.mark
     5765                               :
     5766                                 X_marking-line.sts-utd = bf_utd-marking-lines.sts .
     5767                                 X_marking-line.stts-utd = StatusTHName(X_marking-line.sts-utd) .
     5768                               end.
     5769                               if tree:checkedAllMarksOfUpakUTD(X_marking.mark, buf_utd-marking-lines.db-num, buf_utd-marking-lines.doc-id)
     5770                               then do:
     5771                                 assign
     5772                                   X_marking.sts-utd = Marking:Checked_:KeyIntDB .
     5773                                   X_marking.stts-utd = StatusTHName(Marking:Checked_:KeyIntDB)
     5774                                 .
     5775                               end.
     5776                               for first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.mark = buf_utd-marking-lines.mark and
     5777                                   bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num and
     5778                                   bf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id:
     5779                                   if bf_utd-marking-lines.doc-level = 1 then bf_utd-marking-lines.sts   = X_marking.sts-utd .
     5780                               end.
     5781                           end.
     5782                           v-mark:screen-value = "" .
     5783                           v-mark = "" .
     5784                       end.
     5785                   end.
     5786                   br-mark :refresh().
     5787                   reposition br-mark to recid recid_mark no-error .
     5788                   br-mark-item:refresh () no-error .
     5789               end.
     5790               else
     5791               do:
     5792                   find first X_marking-line exclusive-lock where X_marking-line.mark begins v-marking no-error .
     5793                   if available (X_marking-line) then
     5794                   do:
     5795                       recid_mark = recid (X_marking-line) .
     5796                       if X_marking-line.sts-utd = Marking:Checked_:KeyIntDB then
     5797                       do:
     5798                           F-text = "            Марка уже проверена, просканируйте следующую" .
     5799                           display F-text with frame d-mark.
     5800                           v-mark:screen-value = "" .
     5801                           v-mark = "" .
     5802                           return no-apply.
     5803                       end.
     5804                       else
     5805                       do:
     5806                           assign
     5807                               X_marking-line.sts-utd  = Marking:Checked_:KeyIntDB
     5808                               X_marking-line.stts-utd = StatusTHName(Marking:Checked_:KeyIntDB)
     5809                               .
     5810                           find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking-line.mark and buf_utd-marking-lines.db-num = X_marking-line.db-num and
     5811                               buf_utd-marking-lines.doc-id = X_marking-line.doc-id no-error .
     5812                           if available (buf_utd-marking-lines) then
     5813                           do:
     5814                               if buf_utd-marking-lines.doc-level > 1 then
     5815                               do:
     5816                                   if tree:LevelUpUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     5817                                   do:
     5818                                       message "Разгруппировать упаковки?"
     5819                                           view-as alert-box question buttons yes-no update ungroup.
     5820                                       if ungroup then
     5821                                       do:
     5822                                           if tree:UnGroupUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     5823                                           do:
     5824                                               message "Упаковка с маркой " + buf_utd-marking-lines.mark + " разгруппирована."
     5825                                                   view-as alert-box.
     5826                                           end.
     5827                                       end.
     5828                                   end.
     5829                               end.
     5830                               if tree:LevelDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     5831                               do:
     5832                                   tree:StatusDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num, Marking:Checked_:KeyIntDB) .
     5833                               end.
     5834                               for first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.mark = buf_utd-marking-lines.mark and bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num and
     5835                                   bf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id:
     5836                                   bf_utd-marking-lines.sts   = X_marking-line.sts-utd .
     5837                               end.
     5838                           end.
     5839                           v-mark:screen-value = "" .
     5840                           v-mark = "" .
     5841                       end.
     5842                       br-mark-item :refresh().
     5843                       reposition br-mark-item to recid recid_mark no-error .
     5844                       v-mark:screen-value = "" .
     5845                       v-mark = "" .
     5846                   end.
     5847                   else
     5848                   do:
     5849                       f-text = "              Марка не найдена в документе" .
     5850                       display F-text with frame d-mark.
     5851                       v-mark = "" .
     5852                       v-mark:screen-value = "" .
     5853                       return no-apply .
     5854                   end.
     5855               end.
     5856           end.
     5857       end.
     5858       else
     5859       do:
     5860           find first X_marking no-lock where X_marking.mark begins v-marking and X_marking.doc-level = 1 no-error .
     5861           if available (X_marking) then
     5862           do:
     5863               recid_mark = recid (X_marking) .
     5864               reposition br-mark to recid recid_mark no-error .
     5865           end.
     5866           else
     5867           do:
     5868               find first X_marking-line exclusive-lock where X_marking-line.mark begins v-marking no-error .
     5869               if available (X_marking-line) then
     5870               do:
     5871                   recid_mark1 = recid (X_marking-line) .
     5872                   reposition br-mark-item to recid recid_mark1 no-error .
     5873                   if error-status:error then
     5874                   do:
     5875                       f-text = "            Марка не отображена в браузере" .
     5876                       display F-text with frame d-mark.
     5877                   end.
     5878               end.
     5879               else
     5880               do:
     5881                   f-text = "              Марка не найдена в документе" .
     5882                   display F-text with frame d-mark.
     5883               end.
     5884           end.
     5885       end.
     5886       v-mark:screen-value = "" .
     5887       v-mark = "" .
     5888   end.
     5889   PROCEDURE scan-bar-code :
     5890       define variable v_list      as character no-undo .
     5891       define variable ii          as integer   no-undo .
     5892       define variable v-marking   as character no-undo .
     5893       define variable recid_mark1 as integer   no-undo .
     5894       define variable v-GTIN      as character no-undo .
     5895       define variable v-gds-code  as integer   no-undo .
     5896       define VARIABLE vRecKeyLine as character no-undo .
     5897       define buffer gray_marking                for ub.marking .
     5898       define buffer gray_unit-marking           for ub.marking .
     5899       define buffer gray_utd-marking-lines      for ub.utd-marking-lines .
     5900       define buffer gray_unit_utd-marking-lines for ub.utd-marking-lines .
     5901       define buffer buf_utd-lines               for ub.utd-lines .
     5902       define buffer buf_utd-marking-lines       for ub.utd-marking-lines .
     5903       define buffer X_utd-lines                 for tt-utd-lines .
     5904       define buffer buf_utd-err                 for ub.utd-err .
     5905       define buffer un_utd-marking-lines        for ub.utd-marking-lines .
     5906       f-text = "" .
     5907       f-text:screen-value in frame d-mark = "" .
     5908       ASSIGN
     5909           v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
     5910       do ii = 1 to length (v-mark):
     5911           if LOOKUP( SUBSTRING( v-mark, ii, 1 ), v_list )  > 1 then
     5912           do:
     5913               message "Не корректно считан штрих-код, перед считыванием переключите клавиатуру на английскую раскладку."
     5914                   view-as alert-box.
     5915               v-mark:screen-value = "" .
     5916               v-mark = "" .
     5917               return .
     5918           end.
     5919       end.
     5920          mMRCCode  = yes.
     5921      v-marking = GetCodeIdent(v-mark) .
     5922      mMRCCode = no.
     5923      if v-marking <> "" and v-marking <> ? then
     5924      do:
     5925         v-mark = v-marking .
     5926      end.
     5927           find first X_marking no-lock where X_marking.mark begins v-mark and X_marking.doc-level = 1 no-error .
     5928           if available (X_marking) then
     5929           do:
     5930               recid_mark = recid (X_marking) .
     5931               reposition br-bar-code to recid recid_mark no-error .
     5932           end.
     5933           v-mark:screen-value = "" .
     5934           v-mark = "" .
     5935   end.
     5936   PROCEDURE proc-any-key :
     5937       if not v-manual
     5938           then
     5939           if v-scan-str = ""
     5940               then etime(yes).
     5941           else
     5942               if etime > 700
     5943                   then v-scan-str = "".
     5944       v-scan-str = v-scan-str + last-event:label.
     5945   end.
     5946   PROCEDURE checkPriPerem :
     5947       define input  parameter iMark as character no-undo.
     5948       define output parameter oMsg  as character no-undo.
     5949       define buffer buf_trn-doc          for ub.trn-doc.
     5950       define buffer buf_marking          for ub.marking.
     5951       define buffer parent_marking       for ub.marking.
     5952       define buffer buf_marking-lines    for ub.marking-lines.
     5953       define buffer buf_tt-marking       for tt-marking-lines.
     5954       find first X_marking exclusive-lock where X_marking.mark begins iMark no-error .
     5955       if available (X_marking) then
     5956       do:
     5957           if X_marking.sts-utd = Marking:Checked_:KeyIntDB then
     5958           do:
     5959               if x_marking.unit-ext <> "UNIT" then
     5960               do:
     5961                   oMsg = "               Упаковка уже проверена полностью".
     5962                   return.
     5963               end.
     5964               else
     5965               do:
     5966                   oMsg = "            Марка уже проверена, просканируйте следующую".
     5967                   display F-text with frame d-mark.
     5968                   return.
     5969               end.
     5970           end.
     5971           find first buf_marking exclusive-lock where
     5972                      buf_marking.mark begins iMark
     5973                no-error.
     5974           if buf_marking.sts = Marking:Checked_:KeyIntDB or
     5975              buf_marking.sts = Marking:SaleLock:KeyIntDB or
     5976              buf_marking.sts = Marking:ReturnLock:KeyIntDB then
     5977           do:
     5978               oMsg = "Марка проверена ранее".
     5979               return.
     5980           end.
     5981           if buf_marking.sts = Marking:FreeZone:KeyIntDB then
     5982           do:
     5983             for each buf_marking-lines no-lock where
     5984                      buf_marking-lines.mark      = X_marking.mark
     5985                  and buf_marking-lines.obj-type  = X_marking.obj-type
     5986                  and buf_marking-lines.obj-code  = X_marking.obj-code
     5987                  and buf_marking-lines.gds-code  = X_marking.gds-code
     5988                  and buf_marking-lines.out-code  <> X_marking.out-code,
     5989                 first buf_trn-doc no-lock where
     5990                       buf_trn-doc.doc-code = buf_marking-lines.out-code
     5991                   and buf_trn-doc.ext-doc-type = 'iv':U:
     5992               oMsg = "Марка уже принята ранее по другому документу внутреннего прихода".
     5993               return.
     5994             end.
     5995           end.
     5996           find first buf_marking-lines exclusive-lock where
     5997                      buf_marking-lines.mark      = X_marking.mark
     5998                  and buf_marking-lines.obj-type  = X_marking.obj-type
     5999                  and buf_marking-lines.obj-code  = X_marking.obj-code
     6000                  and buf_marking-lines.gds-code  = X_marking.gds-code
     6001                  and buf_marking-lines.out-code  = X_marking.out-code no-error .
     6002           if buf_marking-lines.doc-level > 1 and
     6003              avail buf_marking
     6004           then do:
     6005             for first parent_marking no-lock where
     6006                       parent_marking.mark = buf_marking.mark-parent
     6007                   and parent_marking.sts <> Marking:GrayZone:KeyIntDB
     6008                   and parent_marking.sts <> Marking:Ungrouped:KeyIntDB
     6009             :
     6010               oMsg = "Марка входит в состав упаковки, просканируйте марку упаковки.".
     6011               return.
     6012             end.
     6013           end.
     6014           assign
     6015             buf_marking.sts       = Marking:Checked_:KeyIntDB
     6016             x_marking.sts         = buf_marking.sts
     6017             x_marking.sts-utd     = buf_marking.sts
     6018             buf_marking-lines.sts = buf_marking.sts
     6019             X_marking.stts-utd    = marking:GetLabel(buf_marking.sts)
     6020             X_marking.stts        = marking:GetLabel(buf_marking.sts)
     6021           .
     6022           run setStatusForChildMarks in this-procedure (buf_marking.mark, buf_marking.sts).
     6023       end.
     6024   END.
     6025   PROCEDURE ungroupTT:
     6026       define input parameter iMark as character no-undo.
     6027       define buffer buf_tt-marking-lines for tt-marking-lines.
     6028       for first buf_tt-marking-lines exclusive-lock where
     6029                 buf_tt-marking-lines.mark = iMark
     6030       :
     6031         buf_tt-marking-lines.stts = StatusTHName(Marking:Ungrouped:KeyIntDB) .
     6032         buf_tt-marking-lines.stts-utd = StatusTHName(Marking:Ungrouped:KeyIntDB) .
     6033         buf_tt-marking-lines.sts = Marking:Ungrouped:KeyIntDB .
     6034         buf_tt-marking-lines.sts-utd = Marking:Ungrouped:KeyIntDB .
     6035         run ungroupTT in this-procedure (buf_tt-marking-lines.mark-parent).
     6036       end.
     6037   end.
     6038   PROCEDURE setCheckedStatusForParentMarks:
     6039     define input parameter iMark  as character no-undo.
     6040     define input parameter iDbNum as integer no-undo.
     6041     define input parameter iDocId as integer no-undo.
     6042     define buffer parent_utd-marking-lines for ub.utd-marking-lines.
     6043     if iMark = "" then return.
     6044     find first parent_utd-marking-lines exclusive-lock where
     6045                parent_utd-marking-lines.db-num = iDbNum
     6046            and parent_utd-marking-lines.doc-id = iDocId
     6047            and parent_utd-marking-lines.mark = iMark no-error .
     6048     if available (parent_utd-marking-lines) then
     6049     do:
     6050       find first tt-marking-lines where
     6051                  parent_utd-marking-lines.mark begins tt-marking-lines.mark-parent
     6052              and tt-marking-lines.mark-parent <> ""
     6053              and tt-marking-lines.sts-utd = Marking:PendingVerification:KeyIntDB no-error .
     6054       if not available (tt-marking-lines) then
     6055       do:
     6056           if tree:checkedAllMarksOfUpakUTD(parent_utd-marking-lines.mark, iDbNum, iDocId)
     6057           then do:
     6058             parent_utd-marking-lines.sts = Marking:Checked_:KeyIntDB .
     6059             find first X_marking where X_marking.mark = parent_utd-marking-lines.mark no-error .
     6060             if available (X_marking) then
     6061             do:
     6062               X_marking.sts-utd = Marking:Checked_:KeyIntDB .
     6063               X_marking.stts-utd = StatusTHName(Marking:Checked_:KeyIntDB) .
     6064             end.
     6065             run setCheckedStatusForParentMarks(X_marking.mark-parent, iDbNum, iDocId).
     6066           end.
     6067       end.
     6068       else
     6069       do:
     6070           find first X_marking where X_marking.mark = parent_utd-marking-lines.mark no-error .
     6071           if available (X_marking) then recid_mark = recid(X_marking) .
     6072       end.
     6073     end.
     6074   end.
     6075   PROCEDURE setStatusForChildMarks:
     6076     define input parameter iMark  like ub.marking.mark no-undo.
     6077     define input parameter iSts   like ub.marking.sts  no-undo.
     6078     define buffer buf_marking-child    for ub.marking.
     6079     define buffer buf_marking-lines    for ub.marking-lines.
     6080     for each buf_marking-child where
     6081              buf_marking-child.mark-parent = iMark
     6082       exclusive-lock:
     6083       find first buf_marking-lines exclusive-lock where
     6084                  buf_marking-lines.mark      = buf_marking-child.mark
     6085              and buf_marking-lines.obj-type  = X_marking.obj-type
     6086              and buf_marking-lines.obj-code  = X_marking.obj-code
     6087              and buf_marking-lines.gds-code  = X_marking.gds-code
     6088              and buf_marking-lines.out-code  = X_marking.out-code no-error .
     6089       find first X_marking-line exclusive-lock where X_marking-line.mark begins buf_marking-child.mark no-error .
     6090       assign
     6091         X_marking-line.sts      = iSts
     6092         X_marking-line.sts-utd  = iSts
     6093         X_marking-line.stts-utd = marking:GetLabel(iSts)
     6094         X_marking-line.stts     = marking:GetLabel(iSts)
     6095         buf_marking-lines.sts   = iSts
     6096         buf_marking-child.sts   = iSts
     6097       .
     6098       run setStatusForChildMarks in this-procedure (buf_marking-child.mark, iSts).
     6099     end.
     6100   end.
