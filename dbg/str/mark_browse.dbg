     2966                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2967                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2968                                          and utd-marking-lines-attr.mark      eq imark
     2969                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2970      no-lock no-error.
