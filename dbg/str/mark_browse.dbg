      542   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   define  stream PrnLibStream.
      544   procedure prn-lib-prn-file :
      545     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      546     define input parameter p-DIsabledoptions as integer no-undo .
      547     define variable v-report-name as character no-undo .
      548     define variable v-user-action as character no-undo .
      549     define variable v-printed     as logical   no-undo .
      550     define variable v-exist       as logical   no-undo .
      551     do
      552       on error undo, return error
      553       :
      554       run prn-lib-get-report-name  in this-procedure (
      555         input parParentProc
      556         ,output v-report-name
      557         ).
      558   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      560     (input  v-report-name
      561     ,input  2
      562     ,output v-exist
      563     )  .
      564       if NOT v-exist then
      565       DO:
      566         Message
      567           "Нет заданий на печать ! "
      568           view-as alert-box .
      569         Return  .
      570       End.
      571       run gbl/prnfilen.w
      572         (input  ""
      573         ,input  p-DisabledOptions
      574         ,input  string(v-report-name )
      575         ,input  7
      576         ,output v-user-action
      577         ,output v-printed
      578         ) .
      579       if v-printed then
      580       do:
      581         return "YES" .
      582       end.
      583       else
      584       do:
      585         return "NO" .
      586       end.
      587     end.
      588   end procedure.
      589   procedure prn-lib-open-stream :
      590     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      591     define input parameter p-page-size    as integer no-undo .
      592     define input parameter p-is-stream    as logical no-undo .
      593     define input parameter p-append       as logical no-undo .
      594     define variable v-report-name as character no-undo .
      595     do
      596       on error undo, return error
      597       :
      598       run prn-lib-get-report-name  in this-procedure (
      599         input parParentProc
      600         ,output v-report-name
      601         ).
      602       if p-is-stream then
      603       do:
      604         if p-append then
      605         do:
      606           output stream PrnLibStream to value( v-report-name )
      607             page-size value(p-page-size) append .
      608         end.
      609         if not p-append then
      610         do:
      611           output stream PrnLibStream to value( v-report-name )
      612             page-size value(p-page-size) .
      613         end.
      614       end.
      615       if not p-is-stream then
      616       do:
      617         if p-append then
      618         do:
      619           output to value( v-report-name )
      620             page-size value(p-page-size) append .
      621         end.
      622         if not p-append then
      623         do:
      624           output to value( v-report-name )
      625             page-size value(p-page-size) .
      626         end.
      627       end.
      628     end.
      629   end procedure.
      630   procedure prn-lib-open-exp :
      631     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      632     define input parameter p-is-stream    as logical no-undo .
      633     define input parameter p-is-append    as logical no-undo .
      634     define output parameter p-ReportFileName as char init "report" no-undo.
      635     define output parameter p-process as logical no-undo .
      636     define variable glog as logical no-undo .
      637     do
      638       on error undo, return error
      639       :
      640       SYSTEM-DIALOG GET-FILE p-ReportFileName
      641         TITLE      "Укажите путь"
      642         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      643         ASK-OVERWRITE
      644         CREATE-TEST-FILE
      645         SAVE-AS
      646         USE-FILENAME
      647         DEFAULT-EXTENSION "txt"
      648         UPDATE glog
      649         .
      650       if not glog then  return.
      651       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      652       if p-is-stream then
      653       do:
      654         if p-is-append then
      655         do:
      656           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      657         end.
      658         else
      659         do:
      660           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      661         end.
      662       end.
      663       else
      664       do:
      665         if p-is-append then
      666         do:
      667           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      668         end.
      669         else
      670         do:
      671           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      672         end.
      673       end.
      674       p-process = yes.
      675     end.
      676   end procedure.
      677   procedure prn-lib-get-report-name :
      678     define input parameter parParentProc  as widget-handle no-undo.
      679     define output parameter p-report-name as character no-undo .
      680     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      681   end procedure.
      682   procedure prn-lib-reportviewer-report-name :
      683     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      684     define input parameter p-report-name-html as character no-undo .
      685     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      686   end procedure.
      687   procedure prn-lib-reportviewer :
      688     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      689     define input parameter p-report-name-html as character no-undo .
      690     define input parameter p-param        as character no-undo .
      691     define variable v-excel           as character no-undo init 'TRUE' .
      692     define variable v-value-character as character no-undo .
      693     define variable v-value-integer   as character no-undo .
      694     define variable v-value-date      as date      no-undo .
      695     define variable v-value-decimal   as decimal   no-undo .
      696     define variable rep-excel         as logical   no-undo .
      697     define variable excel-string      as character no-undo .
      698     define variable v-param-type      as character no-undo .
      699     define variable v-tth             as handle    no-undo .
      700     run adm/shattri.p (
      701       input "get":U
      702       ,input  ""
      703       ,input  0
      704       ,input  'report-glob':U
      705       ,input  'rep-excel':U
      706       ,output v-value-character
      707       ,output v-value-date
      708       ,output v-value-decimal
      709       ,output v-value-integer
      710       ,output rep-excel
      711       ,output v-param-type
      712       ,INPUT-OUTPUT table-handle v-tth
      713       )  .
      714     if rep-excel then v-excel = "TRUE" .
      715     else v-excel = "FALSE" .
      716     if p-param eq ""
      717     then
      718        p-param = "EXCEL:" + v-excel.
      719     else
      720        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      721     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      722   end procedure.
      723   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   define variable v-waitfram-action01         as character   no-undo .
      725   define variable v-waitfram-action02         as character   no-undo .
      726   define variable v-waitfram-action03         as character   no-undo .
      727   define variable mWaitFramTextBeg            as character   no-undo.
      728   define variable mWaitFramTextEnd            as character   no-undo.
      729   define variable mWaitFramView               as logical     no-undo.
      730   define variable mWaitProcEvent              as logical     no-undo init yes.
      731   define variable mWaitFramInterval           as integer     no-undo init 1 .
      732   define variable mWaitFramStop               as logical     no-undo.
      733   define variable mWaitFramStopUser           as logical     no-undo.
      734   define variable mWaitFramStopTimeOut        as logical     no-undo.
      735   define variable mWaitFramStartProc          as datetime-tz no-undo.
      736   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      737   define button B-WaitFramStop auto-end-key
      738        label "Стоп"
      739        size 10 by 1 tooltip "Остоновить процесс".
      740   define button B-viewProcInfo
      741        label "Информация"
      742        size 15 by 1 tooltip "Информация о процесс".
      743   define frame waitfram
      744     v-waitfram-action01 format "x(72)" no-label skip
      745     v-waitfram-action02 format "x(72)" no-label skip
      746     v-waitfram-action03 format "x(72)" no-label skip
      747     B-viewProcInfo
      748     B-WaitFramStop at row 4 col 30
      749     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      750     .
      751   define new global shared variable mBatchMode as logical no-undo init ?.
      752   define variable mFramBachModHandle as handle no-undo.
      753   mFramBachModHandle = frame waitfram:handle.
      754   define variable mFameOldVis as logical no-undo.
      755   define variable mVisCUrentVin as logical no-undo.
      756   if session:batch-mode
      757   then
      758      mBatchMode = yes.
      759   if mBatchMode = ? then do:
      760     mVisCUrentVin = current-window:visible.
      761     mFameOldVis = mFramBachModHandle:visible.
      762     mFramBachModHandle:visible  = yes.
      763     mBatchMode = mFramBachModHandle:visible ne yes.
      764     mFramBachModHandle:visible = mFameOldVis.
      765     current-window:visible = mVisCUrentVin.
      766   end.
      767    if  log-manager:logfile-name ne ?
      768     then DO:
      769         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      770         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      771         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      772     end.
      773   on choose of B-WaitFramStop in frame waitfram
      774   do:
      775     mWaitFramStop = yes.
      776     mWaitFramStopUser = yes.
      777   end.
      778   function waitfram-check-timeout returns logical():
      779      define variable vtime as int64 no-undo.
      780      if mWaitFramStopTimeOut
      781      then
      782         return yes.
      783      vtime = ( now - mWaitFramStartProc ) / 1000 .
      784      if     mWaitFramTimeOut ne ?
      785         and mWaitFramTimeOut ne 0
      786         and mWaitFramTimeOut lt vtime
      787      then do:
      788         mWaitFramStopTimeOut = yes.
      789      end.
      790      return mWaitFramStopTimeOut.
      791   end.
      792   procedure waitfram-hide :
      793     if not session:batch-mode
      794     then do
      795     on error undo, return error return-value
      796     :
      797       pause 0 before-hide .
      798       if not mBatchMode then
      799         hide frame waitfram .
      800     if     not mWaitFramView
      801        and mWaitProcEvent
      802     then
      803       process events .
      804     end.
      805   end procedure.
      806   procedure waitfram-show :
      807     define input  parameter p-message as character no-undo .
      808     define variable v-left-margin as integer   no-undo .
      809     if not session:batch-mode
      810     then do
      811     on error undo, return error return-value
      812     :
      813       if length(p-message) <= 70 then do:
      814         assign
      815           v-left-margin = integer((70 - length(p-message)) / 2)
      816         .
      817         assign
      818           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      819         .
      820         assign
      821           v-waitfram-action01 = " "
      822           v-waitfram-action02 = " "
      823                                    + fill(" ", v-left-margin)
      824                                    + p-message
      825           v-waitfram-action03 = " "
      826         .
      827       end.
      828       else do:
      829         define variable vRindex1 as integer no-undo.
      830         define variable vRindex2 as integer no-undo.
      831         vRindex1 = r-index(p-message," ",70).
      832         if vRindex1 = 0
      833         then
      834            vRindex1 = 70.
      835         if length(p-message)  <= vRindex1 + 70 then do:
      836           assign
      837             v-waitfram-action01 = " "
      838             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      839             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      840           .
      841         end.
      842         else do:
      843           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      844           if vRindex2 <= vRindex1
      845           then
      846              vRindex2 = vRindex1 + 70.
      847           assign
      848             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      849             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      850             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      851           .
      852         end.
      853       end.
      854       B-viewProcInfo:visible   in frame waitfram = no.
      855       B-viewProcInfo:sensitive in frame waitfram = no.
      856       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      857       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      858       if  (   mWaitFramView
      859          or  mWaitProcEvent)
      860          and not mBatchMode
      861       then
      862          display
      863             v-waitfram-action01 skip
      864             v-waitfram-action02 skip
      865             v-waitfram-action03 skip
      866          with frame waitfram .
      867       if     mWaitFramView
      868          then do:
      869             if     mWaitFramInterval ne ?
      870                and not mBatchMode
      871             then
      872                wait-for go of frame waitfram pause mWaitFramInterval.
      873          end.
      874          else
      875             if     mWaitProcEvent
      876                and not mBatchMode
      877             then
      878                process events .
      879     end.
      880   end procedure.
      881      procedure waitfram-show-this:
      882         define input  parameter iInterval as int64 no-undo.
      883         define variable vtime as int64 no-undo.
      884         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      885         mWaitFramInterval = iInterval.
      886         run waitfram-show (substitute("&1&2 &3&4" ,
      887                                       mWaitFramTextBeg ,
      888                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      889                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      890                                       mWaitFramTextEnd
      891                                      )
      892                           ).
      893      end.
      894      procedure WaitFramRunPause:
      895         define input  parameter iInterval as dec no-undo.
      896         define variable vStart  as datetime-tz no-undo.
      897         define variable vend    as datetime-tz no-undo.
      898         define variable vint as int64 no-undo.
      899         define variable vOk as logical no-undo.
      900         vStart = now.
      901         vend   = vStart.
      902         publish "WaitFramPause" (iInterval,output vOk).
      903         vend   =  now.
      904         vint = vend - vStart.
      905         vint = iInterval - vint / 1000.
      906         if     not mWaitFramStop
      907            and (   vint > 0
      908                 or (    not vOk
      909                     and iInterval eq ?
      910                     )
      911                 )
      912         then
      913            run waitfram-show-this (iInterval).
      914         vend   =  now.
      915         vint = vend - vStart.
      916         vint = iInterval - vint / 1000.
      917         if     not mWaitFramStop
      918            and vint > 0
      919         then do:
      920            run gbl/pause.p (vint * 1000).
      921         end.
      922         if iInterval ne ?
      923         then
      924            publish "WaitFramStop".
      925         waitfram-check-timeout().
      926      end.
      927      procedure WaitFramWaitFor:
      928         define input  parameter iInterval as dec no-undo.
      929         assign
      930            mWaitFramStartProc   = now
      931            mWaitFramStopUser    = no
      932            mWaitFramStopTimeOut = no
      933         .
      934         block-wait:
      935         do while not mWaitFramStop:
      936            run WaitFramRunPause (iInterval).
      937            if  waitfram-check-timeout()
      938            then do:
      939               leave block-wait.
      940            end.
      941         end.
      942         run waitfram-hide.
      943      end.
      944   procedure waitfram-join :
      945     define input  parameter p-line-1  as character no-undo .
      946     define input  parameter p-line-2  as character no-undo .
      947     define input  parameter p-line-3  as character no-undo .
      948     define output parameter p-message as character no-undo .
      949     do
      950     on error undo, return error return-value
      951     :
      952       assign
      953         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      954                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      955                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      956       .
      957     end.
      958   end procedure.
      959   function waitfram-join-function returns character
      960     (input p-line-1 as character
      961     ,input p-line-2 as character
      962     ,input p-line-3 as character
      963     ).
      964     define variable v-message as character no-undo .
      965     run waitfram-join in this-procedure
      966       (input  p-line-1
      967       ,input  p-line-2
      968       ,input  p-line-3
      969       ,output v-message
      970       ) .
      971     return v-message .
      972   end function .
