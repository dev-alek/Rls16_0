     2981   function setattrUtdMarkingLines returns logical
     2982   (idb-num   as integer,
     2983    idoc-id   as integer,
     2984    ilinenum  as integer,
     2985    imark     as character,
     2986    iattrcode as character,
     2987    iattrval  as character ):
     2988      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2989      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2990                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2991                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2992                                          and utd-marking-lines-attr.mark      eq imark
     2993                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2994      no-lock no-error.
     2995      if not available utd-marking-lines-attr
     2996      then do:
     2997         if iattrval ne ?
     2998            and iattrval ne ""
     2999         then do:
     3000            create utd-marking-lines-attr.
     3001            assign
     3002               utd-marking-lines-attr.db-num     = idb-num
     3003               utd-marking-lines-attr.doc-id     = idoc-id
     3004               utd-marking-lines-attr.lineNum    = ilineNum
     3005               utd-marking-lines-attr.mark       = imark
     3006               utd-marking-lines-attr.attr-code  = iattrcode
     3007               utd-marking-lines-attr.attr-value = iattrval
     3008            .
     3009         end.
     3010      end.
     3011      else do:
     3012         if utd-marking-lines-attr.attr-value ne iattrval
     3013         then do:
     3014            find current utd-marking-lines-attr exclusive-lock no-error.
     3015            if available utd-marking-lines-attr
     3016            then do:
     3017               if    iattrval eq ?
     3018                  or iattrval eq ""
     3019               then do:
     3020                  delete utd-marking-lines-attr.
     3021               end.
     3022               else do:
     3023                  utd-marking-lines-attr.attr-value = iattrval.
     3024               end.
     3025            end.
     3026         end.
     3027      end.
     3028      release utd-marking-lines-attr.
     3029   end.
     3030   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3031   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3033   function AddUtdErrForTab returns logical
     3034   (idb-num         as integer ,
     3035    idoc-id         as integer ,
     3036    iTab            as character,
     3037    iObj            as handle ,
     3038    iCheckType      as character,
     3039    iCodeErr        as character,
     3040    iCheckObj       as character ):
     3041      define buffer utd-err for utd-err.
     3042      define buffer utd for utd.
     3043      find first utd where utd.db-num     eq idb-num
     3044                       and utd.doc-id     eq idoc-id
     3045                       and utd.Direction  eq 'Outbound'
     3046      no-lock no-error.
     3047      if available utd
     3048      then
     3049         return no.
     3050      define variable vRecKey as character no-undo.
     3051            run gen-key-rec (input iTab,
     3052                             input  iObj,
     3053                             output vRecKey).
     3054      find first utd-err where utd-err.db-num     eq idb-num
     3055                           and utd-err.doc-id     eq idoc-id
     3056                           and utd-err.CheckType  eq iCheckType
     3057                           and utd-err.CodeErr    eq iCodeErr
     3058                           and utd-err.CheckObj   eq iCheckObj
     3059      exclusive-lock no-error.
     3060      if not available utd-err
     3061      then do:
     3062         create utd-err.
     3063         assign
     3064            utd-err.db-num         = idb-num
     3065            utd-err.doc-id         = idoc-id
     3066            utd-err.CheckType      = iCheckType
     3067            utd-err.CodeErr        = iCodeErr
     3068            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3069            utd-err.reckey         = vRecKey
     3070            utd-err.qnty           = 1
     3071         .
     3072      end.
     3073      else
     3074         utd-err.qnty = utd-err.qnty + 1.
     3075      return utd-err.qnty eq 1.
     3076   end.
     3077   function AddUtdErr returns logical
     3078   (idb-num         as integer ,
     3079    idoc-id         as integer ,
     3080    iObj            as handle ,
     3081    iCheckType      as character,
     3082    iCodeErr        as character,
     3083    iCheckObj       as character ):
     3084      AddUtdErrForTab
     3085         (idb-num,
     3086          idoc-id,
     3087          iObj:table,
     3088          iObj,
     3089          iCheckType,
     3090          iCodeErr,
     3091          iCheckObj).
     3092   end.
     3093   function ClearUtdErrTypeCode returns logical
     3094   (idb-num         as integer,
     3095    idoc-id         as integer ,
     3096    iCheckType      as character,
     3097    iCodeErr        as character
     3098    ):
     3099      define buffer utd-err for utd-err.
     3100      if    iCheckType eq "*"
     3101         or iCheckType eq ?
     3102      then do:
     3103         if     iCodeErr ne ?
     3104            and iCodeErr ne "*"
     3105         then
     3106            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3107            view-as alert-box.
     3108         else
     3109         for each utd-err where utd-err.db-num  eq idb-num
     3110                            and utd-err.doc-id  eq idoc-id
     3111         exclusive-lock:
     3112            delete utd-err.
     3113         end.
     3114      end.
     3115      else do:
     3116         if    iCodeErr eq ?
     3117            or iCodeErr eq "*"
     3118         then do:
     3119            for each utd-err where utd-err.db-num     eq idb-num
     3120                               and utd-err.doc-id     eq idoc-id
     3121                               and utd-err.CheckType  eq iCheckType
     3122            exclusive-lock:
     3123               delete utd-err.
     3124            end.
     3125         end.
     3126         else do:
     3127            for each utd-err where utd-err.db-num     eq idb-num
     3128                               and utd-err.doc-id     eq idoc-id
     3129                               and utd-err.CheckType  eq iCheckType
     3130                               and ub.utd-err.CodeErr eq iCodeErr
     3131            exclusive-lock:
     3132               delete utd-err.
     3133            end.
     3134         end.
     3135      end.
     3136   end.
     3137   function ClearUtdErr returns logical
     3138   (idb-num         as integer,
     3139    idoc-id         as integer ,
     3140    iCheckType      as character
     3141    ):
     3142      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3143   end.
     3144   function GetMesError returns character
     3145   (itxt as character,
     3146    iobj as character ):
     3147    define variable vi as integer no-undo.
     3148    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3149       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3150    end.
     3151    return itxt.
     3152   end.
     3153   function GetTextErrorType returns character
     3154   (iCheckType as character,
     3155    iCodeErr   as character,
     3156    iChechObj  as character,
     3157    iType      as character  ):
     3158      define buffer code    for code.
     3159      define variable vError as character no-undo.
     3160      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3161                        and code.code   eq iCodeErr
     3162      no-lock no-error.
     3163      if available code
     3164      then do:
     3165         define variable vType as integer no-undo.
     3166         if code.misc3 eq "error"
     3167         then
     3168            vType = 0.
     3169         else if code.misc3 eq "warning"
     3170         then
     3171            vType = 1.
     3172         else if code.misc3 eq "Hiden"
     3173         then
     3174            vType = 2.
     3175         else
     3176            vtype = int(code.misc3) no-error.
     3177         case itype:
     3178            when "error"
     3179            then do:
     3180               if vtype eq 0
     3181               then
     3182                  vError = GetMesError(Code.CodeValue,iChechObj).
     3183            end.
     3184            when "warning"
     3185            then do:
     3186               if vtype <= 1
     3187               then
     3188                  vError = GetMesError(Code.CodeValue,iChechObj).
     3189            end.
     3190            otherwise do:
     3191               vError = GetMesError(Code.CodeValue,iChechObj).
     3192            end.
     3193         end.
     3194      end.
     3195      else
     3196         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3197      return vError.
     3198   end.
     3199   function GetTypeError returns integer
     3200   (iCheckType as character,
     3201    iCodeErr   as character):
     3202      define buffer code    for code.
     3203      define variable vType as integer no-undo.
     3204      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3205                        and code.code   eq iCodeErr
     3206      no-lock no-error.
     3207      if     not available code
     3208         and code.misc3 eq "error"
     3209      then
     3210         vType = 0.
     3211      else if code.misc3 eq "warning"
     3212      then
     3213         vType = 1.
     3214      else if code.misc3 eq "Hiden"
     3215      then
     3216         vType = 2.
     3217      else
     3218         vtype = int(code.misc3) no-error.
     3219      return vtype.
     3220   end.
     3221   function GetTextError returns character
     3222   (iCheckType as character,
     3223    iCodeErr   as character,
     3224    iChechObj  as character ):
     3225      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3226   end.
     3227   function GetErrForUtdStr returns character
     3228   (idb-num     as integer ,
     3229    idoc-id     as integer ,
     3230    iCheckType  as character
     3231    ):
     3232      define buffer utd-err for utd-err.
     3233      define buffer code    for code.
     3234      define variable vHQry as handle no-undo.
     3235      define variable vError as longchar no-undo.
     3236      define variable vErrorOne as longchar  no-undo.
     3237      define variable oError as character no-undo.
     3238      create query vHQry.
     3239      vHQry:set-buffers(buffer utd-err:handle).
     3240      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3241                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3242                               + if    iCheckType eq "*"
     3243                                    or iCheckType eq ?
     3244                                 then       ""
     3245                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3246      vHQry:query-open().
     3247      vHQry:get-first().
     3248      QRY-BLOCK:
     3249      repeat while not vHQry:query-off-end:
     3250         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3251         if     vErrorOne ne ""
     3252            and vErrorOne ne ?
     3253         then
     3254            vError = vError + ", " + vErrorOne.
     3255         vHQry:get-next().
     3256      end.
     3257      oError = substring(vError,3,4002).
     3258      return oError.
     3259   end.
     3260   function GetErrJsonForUtd returns character
     3261   (idb-num         as integer ,
     3262    idoc-id         as integer ,
     3263    iCheckType      as character
     3264    ):
     3265      define buffer utd-err for utd-err.
     3266      define variable vHQry as handle no-undo.
     3267      define variable vError as longchar no-undo.
     3268      define variable oError as character no-undo.
     3269      create query vHQry.
     3270      define variable vi as integer no-undo.
     3271      vHQry:set-buffers(buffer utd-err:handle).
     3272      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3273                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3274                               + if    iCheckType eq "*"
     3275                                    or iCheckType eq ?
     3276                                 then       ""
     3277                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3278      vHQry:query-open().
     3279      vHQry:get-first().
     3280      QRY-BLOCK:
     3281      repeat while not vHQry:query-off-end:
     3282         define variable vErrorOne as character no-undo.
     3283         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3284         if     vErrorOne ne ?
     3285            and vErrorOne ne ""
     3286         then do:
     3287            vi = vi + 1.
     3288            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3289                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3290                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3291         end.
     3292         vHQry:get-next().
     3293      end.
     3294      for first utd where utd.db-num eq idb-num
     3295                      and utd.doc-id eq idoc-id
     3296                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3297      no-lock,
     3298         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3299                                  and utd-marking-lines.doc-id eq idoc-id
     3300                                  and utd-marking-lines.doc-level eq 1
     3301      no-lock,
     3302         first marking where marking.mark eq utd-marking-lines.mark
     3303                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3304      no-lock:
     3305         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3306         if     vErrorOne ne ?
     3307            and vErrorOne ne ""
     3308         then do:
     3309            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3310                            + '","ОбъектОш":"' + marking.mark
     3311                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3312         end.
     3313      end.
     3314      if vError ne ""
     3315      then
     3316         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3317      return oError.
     3318   end.
     3319   function GetErrJsonForUtdReturn returns character
     3320   (idb-num         as integer ,
     3321    idoc-id         as integer ,
     3322    iCheckType      as character
     3323    ):
     3324      define buffer utd-err for utd-err.
     3325      define variable vHQry as handle no-undo.
     3326      define variable vError as longchar no-undo.
     3327      define variable oError as character no-undo.
     3328      define variable vi as integer no-undo.
     3329      create query vHQry.
     3330      vHQry:set-buffers(buffer utd-err:handle).
     3331      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3332                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3333                               + if    iCheckType eq "*"
     3334                                    or iCheckType eq ?
     3335                                 then       ""
     3336                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3337      vHQry:query-open().
     3338      vHQry:get-first().
     3339      QRY-BLOCK:
     3340      repeat while not vHQry:query-off-end:
     3341         define variable vErrorOne as character no-undo.
     3342         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3343         if     vErrorOne ne ?
     3344            and vErrorOne ne ""
     3345         then do:
     3346            vi = vi + 1.
     3347            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3348                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3349                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3350         end.
     3351         vHQry:get-next().
     3352      end.
     3353      if vError ne ""
     3354      then
     3355         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3356      return oError.
     3357   end.
     3358   function GetCodeTextError returns character
     3359   (iCheckType as character,
     3360    iCodeErr   as character,
     3361    iChechObj  as character,
     3362    output oCode as character,
     3363    output ovalue as character ):
     3364      define buffer code    for code.
     3365      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3366                        and code.code   eq iCodeErr
     3367      no-lock no-error.
     3368      if     available code
     3369      then do:
     3370         define variable vi as integer no-undo init ?.
     3371         vi = int(Code.misc3) no-error.
     3372         if    code.misc3 ne "error"
     3373            and vi ne 0
     3374         then
     3375            oCode = ?.
     3376         else if     Code.misc1 ne ?
     3377                 and Code.misc1 ne ""
     3378         then
     3379            assign
     3380               oCode  = GetMesError(Code.misc1,iChechObj)
     3381               ovalue = GetMesError(Code.misc2,iChechObj)
     3382            .
     3383      end.
     3384      return if oCode eq ""
     3385             then ""
     3386             else (oCode + "_" + ovalue).
     3387   end.
     3388   define temp-table TT-err no-undo
     3389     field code_ as character
     3390     field text_ as character
     3391   index code_ code_.
     3392   function GetErrTxtForUtd returns character
     3393   (idb-num         as integer ,
     3394    idoc-id         as integer ,
     3395    iCheckType      as character
     3396    ):
     3397      define buffer utd-err for utd-err.
     3398      define variable vHQry as handle no-undo.
     3399      define variable oError as character no-undo.
     3400      create query vHQry.
     3401      define variable vi as integer no-undo.
     3402      for each tt-err :
     3403         delete tt-err.
     3404      end.
     3405      vHQry:set-buffers(buffer utd-err:handle).
     3406      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3407                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3408                               + if    iCheckType eq "*"
     3409                                    or iCheckType eq ?
     3410                                 then       ""
     3411                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3412      vHQry:query-open().
     3413      vHQry:get-first().
     3414      define variable vcode as character no-undo.
     3415      define variable vvalue as character no-undo.
     3416      QRY-BLOCK:
     3417      repeat while not vHQry:query-off-end:
     3418         vi = vi + 1.
     3419         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3420         if vcode ne ?
     3421         then do:
     3422            find first tt-err where tt-err.code eq vcode
     3423            no-error.
     3424            if not available tt-err
     3425            then do:
     3426               create tt-err.
     3427               assign
     3428                  tt-err.code_ = vcode
     3429                  tt-err.text_ = vvalue
     3430               .
     3431            end.
     3432            else
     3433               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3434         end.
     3435         vHQry:get-next().
     3436      end.
     3437     find first utd where utd.db-num eq idb-num
     3438                         and utd.doc-id eq idoc-id
     3439         no-lock.
     3440      define buffer cancel_utd-lines for utd-lines.
     3441      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3442                                  and cancel_utd-lines.doc-id eq idoc-id
     3443      no-lock:
     3444         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3445         then do:
     3446            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3447                                        and utd-marking-lines.doc-id eq idoc-id
     3448                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3449            no-lock,
     3450               first marking where marking.mark eq utd-marking-lines.mark
     3451                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3452            no-lock:
     3453               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3454               find first tt-err where tt-err.code eq vcode
     3455               no-error.
     3456               if not available tt-err
     3457               then do:
     3458                  create tt-err.
     3459                  assign
     3460                     tt-err.code_ = vcode
     3461                     tt-err.text_ = vvalue
     3462                  .
     3463               end.
     3464               else
     3465                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3466            end.
     3467         end.
     3468         else do:
     3469            define variable vqnty as decimal no-undo.
     3470            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3471            if vqnty eq ? then vqnty = 0.
     3472            if vqnty ne cancel_utd-lines.Quantity
     3473            then do:
     3474               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3475               find first tt-err where tt-err.code eq vcode
     3476               no-error.
     3477               if not available tt-err
     3478               then do:
     3479                  create tt-err.
     3480                  assign
     3481                     tt-err.code_ = vcode
     3482                     tt-err.text_ = vvalue
     3483                  .
     3484               end.
     3485               else
     3486                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3487            end.
     3488         end.
     3489      end.
     3490      for each tt-err:
     3491         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3492      end.
     3493      return oError.
     3494   end.
     3495   define variable mFormatErr as character no-undo init "text".
     3496   function GetErrForUtd returns character
     3497   (idb-num         as integer ,
     3498    idoc-id         as integer ,
     3499    iType           as character
     3500    ):
     3501      if mFormatErr eq "text"
     3502      then
     3503         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3504      else do:
     3505         if itype eq "return"
     3506         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3507         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3508      end.
     3509   end.
     3510   function GetErrComText returns longchar
     3511   (icomment as character,
     3512    itext    as longchar ):
     3513       define variable vText as longchar no-undo.
     3514      if mFormatErr eq "text"
     3515      then do:
     3516         if icomment ne ""
     3517         then
     3518            icomment = substitute("comment:|&1|",icomment).
     3519         vText = icomment + itext.
     3520      end.
     3521      else do:
     3522         icomment = if icomment begins  '"'
     3523                    then icomment
     3524                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3525         vText = icomment + "," + itext.
     3526         vText = "~{" + trim(vText,",") + "~}".
     3527      end.
     3528      return vText.
     3529   end.
     3530   function CheckTypeForMarkLineType returns logical
     3531   (iObj            as handle,
     3532    iCheckType      as character,
     3533    iCodeErr        as character ,
     3534    iTypeErr        as character ):
     3535      define variable vRecKey-markLine as character no-undo.
     3536      define variable vGoodMark        as logical no-undo.
     3537      define variable vdb-num          as integer no-undo.
     3538      define variable vdoc-id          as integer no-undo.
     3539      define variable vlinenum         as integer no-undo.
     3540      define variable vErrorOne as character no-undo.
     3541      define buffer buf_utd-err for utd-err.
     3542      run gen-key-rec (input "utd-marking-lines",
     3543                       input  iObj,
     3544                       output vRecKey-markLine).
     3545      vGoodMark = yes.
     3546      vdb-num = iObj::db-num.
     3547      vdoc-id = iObj::doc-id.
     3548      vlinenum = iObj::linenum.
     3549      block-mark-err:
     3550      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3551                               and buf_utd-err.db-num = vdb-num
     3552                               and buf_utd-err.reckey = vRecKey-markLine
     3553                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3554                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3555      no-lock:
     3556         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3557         if     vErrorOne ne ?
     3558            and vErrorOne ne ""
     3559         then do:
     3560            vGoodMark = no.
     3561            leave block-mark-err.
     3562         end.
     3563      end.
     3564      return not vGoodMark.
     3565   end.
     3566   function CheckErrForMarkLineType returns logical
     3567   (iObj            as handle,
     3568    iType           as character  ):
     3569      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3570   end.
     3571   function CheckErrForMarkLine returns logical
     3572   (iObj            as handle):
     3573      return CheckErrForMarkLineType(iObj,"*").
     3574   end.
     3575   function CheckErrForLineTypeCode returns logical
     3576   (iObj                 as handle,
     3577    iCheckType           as character,
     3578    iCodeErr             as character,
     3579    iTypeErr             as character,
     3580    iOneErr              as logical):
     3581      define variable vRecKey-line     as character no-undo.
     3582      define buffer buf_utd-err for utd-err.
     3583      define variable vUtdlineError as logical no-undo.
     3584      define variable vErrorOne as character no-undo.
     3585            run gen-key-rec (input "utd-lines",
     3586                             input  iObj,
     3587                             output vRecKey-line).
     3588         define variable vdb-num as integer no-undo.
     3589         define variable vdoc-id as integer no-undo.
     3590         define variable vlinenum as integer no-undo.
     3591         vdb-num = iObj::db-num.
     3592         vdoc-id = iObj::doc-id.
     3593         vlinenum = iObj::linenum.
     3594         block-err:
     3595         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3596                                  and buf_utd-err.db-num = vdb-num
     3597                                  and buf_utd-err.reckey = vRecKey-line
     3598                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3599                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3600         no-lock:
     3601            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3602            if     vErrorOne ne ?
     3603               and vErrorOne ne ""
     3604            then do:
     3605               vUtdlineError = yes.
     3606               leave block-err.
     3607            end.
     3608         end.
     3609         if  not vUtdlineError
     3610         then do:
     3611            define variable vGoodMark as logical no-undo.
     3612            vGoodMark = yes.
     3613            block-line-err:
     3614            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3615                                         and utd-marking-lines.doc-id  eq vdoc-id
     3616                                         and utd-marking-lines.LineNum eq vLineNum
     3617            no-lock:
     3618               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3619               if     vGoodMark
     3620                  and iOneErr eq no
     3621               then
     3622                  leave block-line-err.
     3623               if     iOneErr = yes
     3624                  and not vGoodMark
     3625               then
     3626                  leave block-line-err.
     3627            end.
     3628            vUtdlineError = not vGoodMark.
     3629         end.
     3630      return vUtdlineError.
     3631   end.
     3632   function getErrForLineType returns character
     3633   (iObj            as handle,
     3634    iType           as character  ):
     3635      define variable vRecKey-line     as character no-undo.
     3636      define buffer buf_utd-err for utd-err.
     3637      define variable vUtdlineError as logical no-undo.
     3638      define variable vErrorOne as character no-undo.
     3639      define variable oError as character no-undo.
     3640            run gen-key-rec (input "utd-lines",
     3641                             input  iObj,
     3642                             output vRecKey-line).
     3643         define variable vdb-num as integer no-undo.
     3644         define variable vdoc-id as integer no-undo.
     3645         define variable vlinenum as integer no-undo.
     3646         vdb-num = iObj::db-num.
     3647         vdoc-id = iObj::doc-id.
     3648         vlinenum = iObj::linenum.
     3649         block-err:
     3650         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3651                                  and buf_utd-err.db-num = vdb-num
     3652                                  and buf_utd-err.reckey = vRecKey-line
     3653                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3654         no-lock:
     3655            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3656            if     vErrorOne ne ?
     3657               and vErrorOne ne ""
     3658            then do:
     3659               oError = oError + vErrorOne + " ".
     3660            end.
     3661         end.
     3662      return oError.
     3663   end.
     3664   function CheckErrForLineType returns logical
     3665   (iObj            as handle,
     3666    iType           as character  ):
     3667       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3668   end.
     3669   function CheckErrForLine returns logical
     3670   (iObj            as handle):
     3671      return CheckErrForLineType(iobj,"*").
     3672   end.
     3673   function CheckErrForUtd returns logical
     3674   (idb-num         as integer ,
     3675    idoc-id         as integer ):
     3676      for each utd-lines where utd-lines.db-num eq idb-num
     3677                           and utd-lines.doc-id eq idoc-id
     3678      no-lock :
     3679         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3680         then
     3681            return no.
     3682      end.
     3683      return yes.
     3684   end.
     3685   function CheckMarkUtd-28rel return logical
     3686    (input idb-num as integer,
     3687    input idoc-id as integer):
     3688    define buffer utd                   for utd.
     3689    define buffer utd-lines             for utd-lines.
     3690    define buffer utd-marking-lines     for utd-marking-lines.
     3691    define variable v-par-type as character no-undo.
     3692    define variable vgdsNoMark as logical no-undo.
     3693    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3694      define variable v-par-val  as character no-undo.
     3695      find first utd where utd.db-num eq idb-num
     3696                       and utd.doc-id eq idoc-id
     3697      no-lock no-error.
     3698      if available utd
     3699      then do:
     3700         if     utd.obj-code ne ?
     3701            and utd.obj-type ne ?
     3702         then do:
     3703            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3704            Block-utd-lines:
     3705            for each utd-lines where utd-lines.db-num eq idb-num
     3706                                 and utd-lines.doc-id eq idoc-id
     3707            no-lock:
     3708               if     utd-lines.gds-code ne ?
     3709                  and utd-lines.gds-code ne 0
     3710               then do:
     3711                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3712                       ( utd-lines.gds-code,
     3713                         'mark-type':U,
     3714                          output v-par-val,
     3715                          output v-par-type
     3716                       ).
     3717                  if     EDOParSec:IsEdo
     3718                     and EDOParSec:GetIsEDOForType(v-par-val)
     3719                  then do:
     3720                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3721                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3722                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3723                                                    and length(utd-marking-lines.mark) > 13
     3724                     no-lock no-error.
     3725                     if     avail utd-marking-lines
     3726                        and not CheckErrForLine(buffer utd-lines:handle)
     3727                     then
     3728                        leave Block-utd-lines.
     3729                  end.
     3730                  else
     3731                     vgdsNoMark = yes.
     3732               end.
     3733            end.
     3734            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3735            if vgdsNoMark then return available utd-lines . else return yes .
     3736         end.
     3737      end.
     3738      return yes.
     3739   end.
     3740   function CheckMarkUtd return logical
     3741    (input idb-num  as integer,
     3742     input idoc-id  as integer):
     3743     define buffer utd-lines             for ub.utd-lines.
     3744     block-line:
     3745     for each utd-lines where utd-lines.db-num eq idb-num
     3746                          and utd-lines.doc-id eq idoc-id
     3747     no-lock:
     3748        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3749        then
     3750           leave block-line.
     3751     end.
     3752     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3753     return available utd-lines.
     3754   end.
     3755   function CheckNotMarkUtd return logical
     3756    (input idb-num  as integer,
     3757     input idoc-id  as integer):
     3758     define buffer utd-lines             for ub.utd-lines.
     3759     for each utd-lines where utd-lines.db-num eq idb-num
     3760                          and utd-lines.doc-id eq idoc-id
     3761     no-lock:
     3762        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3763        then
     3764           return yes.
     3765     end.
     3766     return no.
     3767   end.
     3768   function CheckMarkUtdLine return logical
     3769    (input idb-num  as integer,
     3770     input idoc-id  as integer,
     3771     input iLineNum as integer):
     3772    define buffer utd                   for utd.
     3773    define buffer utd-lines             for utd-lines.
     3774    define buffer utd-marking-lines     for utd-marking-lines.
     3775    define variable v-par-type as character no-undo.
     3776    define variable vMarking        as logical no-undo.
     3777    define variable vArtic          as logical no-undo.
     3778    define variable vTransitional   as logical no-undo.
     3779    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3780      define variable v-par-val  as character no-undo.
     3781      find first utd where utd.db-num eq idb-num
     3782                       and utd.doc-id eq idoc-id
     3783      no-lock no-error.
     3784      if available utd
     3785      then do:
     3786         if     utd.obj-code ne ?
     3787            and utd.obj-type ne ?
     3788         then do:
     3789            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3790            Block-utd-lines:
     3791            for each utd-lines where utd-lines.db-num   eq idb-num
     3792                                 and utd-lines.doc-id   eq idoc-id
     3793                                 and utd-lines.LineNum  eq iLineNum
     3794            no-lock:
     3795               if     utd-lines.gds-code ne ?
     3796                  and utd-lines.gds-code ne 0
     3797               then do:
     3798                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3799                       ( utd-lines.gds-code,
     3800                         'mark-type':U,
     3801                          output v-par-val,
     3802                          output v-par-type
     3803                       ).
     3804                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3805                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3806                  if vMarking
     3807                  then do:
     3808                     block-marking:
     3809                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3810                                                    and utd-marking-lines.doc-id   eq idoc-id
     3811                                                    and utd-marking-lines.LineNum  eq iLineNum
     3812                                                    and length(utd-marking-lines.mark) > 13
     3813                     no-lock:
     3814                        if isOAD(utd-marking-lines.mark)
     3815                        then do:
     3816                           assign
     3817                              vArtic   = yes
     3818                              vMarking = no
     3819                           .
     3820                           leave block-marking.
     3821                        end.
     3822                     end.
     3823                  end.
     3824                  if vArtic
     3825                  then do:
     3826                     block-artic:
     3827                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3828                                                    and utd-marking-lines.doc-id   eq idoc-id
     3829                                                    and utd-marking-lines.LineNum  eq iLineNum
     3830                                                    and length(utd-marking-lines.mark) > 13
     3831                     no-lock:
     3832                        if isMark(utd-marking-lines.mark)
     3833                        then do:
     3834                           assign
     3835                              vArtic   = no
     3836                              vMarking = yes
     3837                           .
     3838                           leave block-artic.
     3839                        end.
     3840                     end.
     3841                  end.
     3842                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3843                  if vTransitional
     3844                  then do:
     3845                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3846                                                    and utd-marking-lines.doc-id   eq idoc-id
     3847                                                    and utd-marking-lines.LineNum  eq iLineNum
     3848                                                    and length(utd-marking-lines.mark) > 13
     3849                     no-lock no-error.
     3850                     if not available utd-marking-lines
     3851                     then assign
     3852                        vMarking = no
     3853                        vArtic   = no
     3854                     .
     3855                  end.
     3856               end.
     3857               else
     3858                  assign
     3859                     vMarking      = yes
     3860                     vArtic        = no
     3861                     vTransitional = no
     3862                  .
     3863               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3864               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3865               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3866            end.
     3867         end.
     3868      end.
     3869      return vMarking or vArtic.
     3870   end.
     3871   function getMarkUtdLine return logical
     3872    (input  idb-num  as integer,
     3873     input  idoc-id  as integer,
     3874     input  iLineNum as integer,
     3875     output oMarking        as logical,
     3876     output oArtic          as logical,
     3877     output oTransitional   as logical):
     3878     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3879     oArtic        = not oMarking
     3880            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3881     oTransitional = (oMarking or oArtic)
     3882            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3883   end.
     3884   function CheckMarking return logical
     3885    (input idb-num as integer,
     3886    input idoc-id as integer,
     3887    input iTypeErr as character ):
     3888     define variable vMarkutd as logical no-undo.
     3889     define variable vCrErr   as logical no-undo.
     3890     define buffer utd-lines         for utd-lines.
     3891     define buffer utd-marking-lines for utd-marking-lines.
     3892     define buffer marking           for marking.
     3893     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3894      block-line:
     3895      for each utd-lines where utd-lines.db-num eq idb-num
     3896                           and utd-lines.doc-id eq idoc-id
     3897      no-lock:
     3898         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3899         then do:
     3900            for each utd-marking-lines
     3901                     where utd-marking-lines.db-num  = utd-lines.db-num
     3902                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3903                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3904            no-lock:
     3905               if isMark(utd-marking-lines.mark)
     3906               then do:
     3907                  find first marking where marking.mark eq utd-marking-lines.mark
     3908                  no-lock no-error.
     3909                  if not available marking
     3910                  then do:
     3911                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3912                     vCrErr = yes.
     3913                     next block-line.
     3914                  end.
     3915               end.
     3916            end.
     3917         end.
     3918      end.
     3919      return vCrErr.
     3920   end.
     3921   function CheckMarkForType return logical
     3922    (input idb-num   as integer,
     3923     input idoc-id   as integer):
     3924      define variable vMarking        as logical no-undo.
     3925      define variable vArtic          as logical no-undo.
     3926      define variable vTransitional   as logical no-undo.
     3927      define buffer utd-lines         for utd-lines.
     3928      define buffer utd-marking-lines for utd-marking-lines.
     3929      block-line:
     3930      for each utd-lines where utd-lines.db-num eq idb-num
     3931                           and utd-lines.doc-id eq idoc-id
     3932      no-lock:
     3933         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3934                          output vMarking         , output vArtic          , output vTransitional).
     3935         for each utd-marking-lines
     3936                     where utd-marking-lines.db-num  = utd-lines.db-num
     3937                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3938                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3939         no-lock:
     3940            if length(utd-marking-lines.mark) < 14
     3941            then do:
     3942               if (vMarking or vArtic) and not vTransitional
     3943               then
     3944                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3945            end.
     3946            else if not isMark(utd-marking-lines.mark)
     3947            then do:
     3948               if vMarking
     3949               then
     3950                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3951            end.
     3952            else do:
     3953            end.
     3954         end.
     3955      end.
     3956   end.
     3957   function WeighedProd return logical
     3958      ( input p-gds-code as integer) :
     3959      define variable v-par-val  as character no-undo.
     3960      define variable v-par-type as character no-undo.
     3961              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3962               ( p-gds-code,
     3963                 'weighed-gds':U,
     3964                  output v-par-val,
     3965                  output v-par-type
     3966               ).
     3967      return logical(v-par-val).
     3968   end.
     3969   function WghProdVariable return logical
     3970       (input p-obj-type as char,
     3971        input p-obj-code as integer,
     3972        input p-gds-code as integer) :
     3973      define variable v-wgh-val  as character no-undo.
     3974      define variable v-par-val  as character no-undo.
     3975      define variable v-par-type as character no-undo.
     3976      define variable vMarking        as logical no-undo.
     3977      define variable vArtic          as logical no-undo.
     3978      define variable vTransitional   as logical no-undo.
     3979      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3980         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3981           ( p-gds-code,
     3982             'weighed-gds':U,
     3983              output v-wgh-val,
     3984              output v-par-type
     3985           ).
     3986       if logical(v-wgh-val) = yes then do:
     3987           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3988               ( p-gds-code,
     3989                 'mark-type':U,
     3990                  output v-par-val,
     3991                  output v-par-type
     3992               ).
     3993           if v-par-val <> "" then do:
     3994               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3995               assign
     3996                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3997                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3998                  .
     3999           end.
     4000      end.
     4001      if v-wgh-val > "" and (vMarking or vArtic)
     4002      then return yes.
     4003      else return no.
     4004   end.
     4005   function MarkWeight return decimal
     4006      ( input p-mark as character) :
     4007      define buffer  buf_marking-attr for  ub.marking-attr.
     4008      define variable vMarkWeight as decimal no-undo.
     4009      vMarkWeight = 0.
     4010      if p-mark <> "" and p-mark <> ?
     4011      then do:
     4012          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4013                                        and buf_marking-attr.attr-code eq "weight"
     4014             no-lock no-error.
     4015          if not available buf_marking-attr
     4016          then do :
     4017            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4018                                          and buf_marking-attr.attr-code eq "weight"
     4019               no-lock no-error.
     4020          end .
     4021          if avail buf_marking-attr
     4022          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4023      end.
     4024      return vMarkWeight.
     4025   end.
