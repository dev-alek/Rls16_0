     4735   ON CHOOSE OF bt-not-sel-all IN FRAME d-mark
     4736       DO:
     4737           define variable loc#log as logical no-undo .
     4738           if available X_marking
     4739              and X_marking.isMark
     4740           then
     4741           do:
     4742               v-rid-list = "" .
     4743               for each X_marking where X_marking.doc-level = vLevel:
     4744                   X_marking.marking-string = "*" .
     4745                   loc#log = br-mark:refresh() no-error.
     4746               end.
     4747           end.
     4748           apply "entry" to br-mark in frame d-mark.
     4749       END.
     4750   ON CHOOSE OF bt-not-sel-all-2 IN FRAME d-mark
     4751       DO:
     4752           define variable loc#log as logical no-undo .
     4753           if available (X_marking) then
     4754           do:
     4755               v-rid-list2 = "" .
     4756               for each X_marking-line where X_marking.mark begins X_marking-line.mark-parent and X_marking-line.doc-level > 1:
     4757                   X_marking-line.marking-string = "*" .
     4758                   loc#log = br-mark-item:refresh() no-error.
     4759               end.
     4760           end.
     4761           apply "entry" to br-mark-item in frame d-mark.
     4762       END.
     4763   ON CHOOSE OF bt-not-sel-desel-all IN FRAME d-mark
     4764       DO:
     4765           define variable loc#log as logical no-undo .
     4766           v-rid-list = "" .
     4767           For each X_marking where X_marking.marking-string = "*":
     4768               X_marking.marking-string = "" .
     4769           end.
     4770           loc#log = br-mark:refresh() no-error.
     4771       END.
     4772   ON CHOOSE OF bt-not-sel-desel-all-2 IN FRAME d-mark
     4773       DO:
     4774           define variable loc#log as logical no-undo .
     4775           v-rid-list2 = "" .
     4776           For each X_marking-line where X_marking-line.marking-string = "*":
     4777               X_marking-line.marking-string = "" .
     4778           end.
     4779           loc#log = br-mark-item:refresh() .
     4780       END.
     4781   ON CHOOSE OF b_block IN FRAME d-mark
     4782       DO:
     4783           define buffer gray_marking                for ub.marking .
     4784           define buffer gray_unit-marking           for ub.marking .
     4785           define buffer gray_utd-marking-lines      for ub.utd-marking-lines .
     4786           define buffer gray_unit_utd-marking-lines for ub.utd-marking-lines .
     4787           for first gray_utd-marking-lines no-lock where gray_utd-marking-lines.db-num = X_marking.db-num and
     4788               gray_utd-marking-lines.doc-id = X_marking.doc-id and
     4789               gray_utd-marking-lines.LineNum = X_marking.LineNum and
     4790               gray_utd-marking-lines.mark = X_marking.mark:
     4791               for first gray_marking no-lock where gray_marking.mark = X_marking.mark :
     4792                   create tt-gray-marking-lines .
     4793                   assign
     4794                       tt-gray-marking-lines.gds-name    = GdsName(gray_utd-marking-lines.gds-code)
     4795                       tt-gray-marking-lines.stts-utd    = StatusTHName(gray_utd-marking-lines.sts)
     4796                       tt-gray-marking-lines.stts        = StatusTHName(gray_marking.sts)
     4797                       tt-gray-marking-lines.mark        = gray_marking.mark
     4798                       tt-gray-marking-lines.mark-parent = gray_marking.mark-parent
     4799                       tt-gray-marking-lines.gds-code    = gray_utd-marking-lines.gds-code
     4800                       tt-gray-marking-lines.sts         = gray_marking.sts
     4801                       tt-gray-marking-lines.sts-utd     = gray_utd-marking-lines.sts
     4802                       tt-gray-marking-lines.unit        = gray_marking.unit
     4803                       tt-gray-marking-lines.box-qnty    = gray_marking.box-qnty
     4804                       tt-gray-marking-lines.LineNum     = gray_utd-marking-lines.LineNum
     4805                       tt-gray-marking-lines.db-num      = gray_utd-marking-lines.db-num
     4806                       tt-gray-marking-lines.doc-id      = gray_utd-marking-lines.doc-id
     4807                       tt-gray-marking-lines.doc-level   = gray_utd-marking-lines.doc-level
     4808                       .
     4809               end.
     4810               for each gray_unit-marking no-lock where gray_unit-marking.mark-parent = gray_utd-marking-lines.mark:
     4811                   for first gray_unit_utd-marking-lines no-lock where gray_unit_utd-marking-lines.db-num = X_marking.db-num and gray_unit_utd-marking-lines.doc-id = X_marking.doc-id
     4812                       and gray_unit_utd-marking-lines.LineNum = X_marking.LineNum and gray_unit_utd-marking-lines.mark = gray_unit-marking.mark:
     4813                       create tt-gray-marking-lines .
     4814                       assign
     4815                           tt-gray-marking-lines.gds-name    = GdsName(gray_unit_utd-marking-lines.gds-code)
     4816                           tt-gray-marking-lines.stts-utd    = StatusTHName(gray_unit_utd-marking-lines.sts)
     4817                           tt-gray-marking-lines.stts        = StatusTHName(gray_unit-marking.sts)
     4818                           tt-gray-marking-lines.mark        = gray_unit-marking.mark
     4819                           tt-gray-marking-lines.mark-parent = gray_unit-marking.mark-parent
     4820                           tt-gray-marking-lines.gds-code    = gray_unit_utd-marking-lines.gds-code
     4821                           tt-gray-marking-lines.sts         = gray_unit-marking.sts
     4822                           tt-gray-marking-lines.sts-utd     = gray_unit_utd-marking-lines.sts
     4823                           tt-gray-marking-lines.unit        = gray_unit-marking.unit
     4824                           tt-gray-marking-lines.unit-ext    = gray_unit-marking.unit-ext
     4825                           tt-gray-marking-lines.box-qnty    = gray_unit-marking.box-qnty
     4826                           tt-gray-marking-lines.LineNum     = gray_unit_utd-marking-lines.LineNum
     4827                           tt-gray-marking-lines.db-num      = gray_unit_utd-marking-lines.db-num
     4828                           tt-gray-marking-lines.doc-id      = gray_unit_utd-marking-lines.doc-id
     4829                           tt-gray-marking-lines.doc-level   = gray_unit_utd-marking-lines.doc-level
     4830                           .
     4831                   end.
     4832               end.
     4833           end.
     4834           run str/mark_browse.w (input parparentproc,
     4835               input-output table tt-gray-marking-lines by-reference,
     4836               input p-mode,
     4837               input "Марки по товару " + string(X_marking.gds-code) + " " + GdsName(X_marking.gds-code) + " со статусом: " + StatusTHName(Marking:GrayZone:KeyIntDB),
     4838               input 6,
     4839               input ""
     4840               ) no-error .
     4841           for each tt-gray-marking-lines no-lock:
     4842               find first tt-marking-lines exclusive-lock where tt-marking-lines.mark = tt-gray-marking-lines.mark no-error .
     4843               if not available (tt-marking-lines) then
     4844               do:
     4845                   create tt-marking-lines .
     4846                   buffer-copy tt-gray-marking-lines to tt-marking-lines .
     4847                   v-qnty-mark = v-qnty-mark + 1 .
     4848                   f-qnty-unit = v-qnty-mark .
     4849               end.
     4850               else
     4851               do:
     4852                   assign
     4853                       tt-marking-lines.sts      = tt-gray-marking-lines.sts
     4854                       tt-marking-lines.stts     = tt-gray-marking-lines.stts
     4855                       tt-marking-lines.sts-utd  = tt-gray-marking-lines.sts-utd
     4856                       tt-marking-lines.stts-utd = tt-gray-marking-lines.stts-utd
     4857                       .
     4858               end.
     4859           end.
     4860           recid_mark = recid (X_marking) .
     4861           empty temp-table tt-gray-marking-lines .
     4862           browse br-mark :refresh().
     4863           reposition br-mark to recid recid_mark no-error .
     4864           browse br-mark-item:refresh () no-error .
     4865           if p-parent_mark eq "" then OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.doc-level = 1 and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION. else OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.mark-parent = p-parent_mark and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION.    OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     4866           apply "value-changed" to br-mark in frame d-mark.
     4867       END.
     4868   ON CHOOSE OF b_error IN FRAME d-mark
     4869       DO:
     4870           define variable v-ok as logical no-undo .
     4871           run ref/dialog-error.w (input X_marking.db-num, input X_marking.doc-id, input "utd-marking-lines") .
     4872           if  error-status:error then
     4873           do:
     4874               return return-value .
     4875           end.
     4876           run enable_UI in this-procedure .
     4877       END.
     4878   ON CHOOSE OF b-look IN FRAME d-mark
     4879       DO:
     4880           define variable v-ok as logical no-undo .
     4881           define buffer buf-mark for tt-marking-lines.
     4882           find first buf-mark where buf-mark.mark-parent eq X_marking.mark no-lock no-error.
     4883           if available buf-mark
     4884           then do:
     4885              run str/mark_browse.w (input parparentproc,
     4886                  input-output table tt-marking-lines by-reference,
     4887                  input p-mode,
     4888                  input substitute ("&1 по марке &2 уровень &3",p-doc, X_marking.mark ,X_marking.doc-level + 1) ,
     4889                  input p-type,
     4890                  input X_marking.mark
     4891                  ) no-error .
     4892              if  error-status:error then
     4893              do:
     4894                  return return-value .
     4895              end.
     4896              run enable_UI in this-procedure .
     4897          end.
     4898       END.
     4899   ON VALUE-CHANGED OF c-status IN FRAME d-mark
     4900       DO:
     4901           assign c-status .
     4902       END.
     4903   ON VALUE-CHANGED OF c-status-2 IN FRAME d-mark
     4904       DO:
     4905           assign c-status-2 .
     4906       END.
     4907   ON VALUE-CHANGED OF Status_ IN FRAME d-mark
     4908       DO:
     4909           assign status_ .
     4910           run init-temp in this-procedure .
     4911       END.
     4912   ON any-printable OF v-mark IN FRAME d-mark
     4913   do:
     4914           run proc-any-key.
     4915       end.
     4916   ON ENTRY OF v-mark IN FRAME d-mark
     4917   DO:
     4918           run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4919           run adm/shattri.p (
     4920                  input "get":U
     4921                  ,input  v-cntxt-obj-type
     4922                  ,input  v-cntxt-obj-code
     4923                  ,input  'marking':U
     4924                  ,input  'rus-key':U
     4925                  ,output p-value-character
     4926                  ,output p-value-date
     4927                  ,output p-value-decimal
     4928                  ,output p-value-integer
     4929                  ,output p-value-logical
     4930                  ,output p-param-type
     4931                  ,input-output table-handle v-tth
     4932                  ) no-error .
     4933           IF p-value-logical = yes THEN  iLang = 68748313.
     4934           run ActivateKeyboardLayout (input iLang, input 0).
     4935       END.
     4936   ON return OF v-mark IN FRAME d-mark
     4937   DO:
     4938      if v-mark:screen-value in frame d-mark = ""
     4939           then
     4940       do:
     4941           v-mark:screen-value in frame d-mark = v-scan-str.
     4942       end.
     4943       v-scan-str = "".
     4944       assign
     4945           v-mark = v-mark:screen-value .
     4946      if isMark(v-mark)
     4947      then
     4948      do:
     4949        run scan-mark .
     4950        br-mark:refresh() in frame d-mark.
     4951        OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     4952        if NUM-RESULTS("br-mark-item") > 0 then
     4953          br-mark-item:refresh() in frame d-mark.
     4954      end.
     4955      else
     4956         run scan-bar-code .
     4957   END.
     4958   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-mark:PARENT eq ?
     4959       THEN FRAME d-mark:PARENT = ACTIVE-WINDOW.
     4960   ON WINDOW-CLOSE OF FRAME d-mark
     4961       APPLY "END-ERROR":U TO SELF.
     4962   MAIN-BLOCK:
     4963   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4964       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4965   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4966     run mainmenu_getcntxt in parparentproc
     4967       (output v-cntxt-db-num
     4968       ,output v-cntxt-userid
     4969       ,output v-cntxt-level
     4970       ,output v-cntxt-host-code-obj
     4971       ,output v-cntxt-obj-type
     4972       ,output v-cntxt-obj-code
     4973       ,output v-cntxt-db-num-obj
     4974       ,output v-cntxt-is-admin
     4975       ) .
     4976       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code).
     4977       Marking = ObjSrv:Env:Marking:Sts:Mark .
     4978       tree = ObjSrv:Lib:MarkingTree .
     4979       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4980         run adm/shattri.p (
     4981                  input "get":U
     4982                  ,input  v-cntxt-obj-type
     4983                  ,input  v-cntxt-obj-code
     4984                  ,input  'marking':U
     4985                  ,input  'rus-key':U
     4986                  ,output p-value-character
     4987                  ,output p-value-date
     4988                  ,output p-value-decimal
     4989                  ,output p-value-integer
     4990                  ,output p-value-logical
     4991                  ,output p-param-type
     4992                  ,input-output table-handle v-tth
     4993                  ) no-error .
     4994         IF p-value-logical = yes THEN  iLang = 68748313.
     4995       run ActivateKeyboardLayout (input iLang, input 0).
     4996   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4997   do:
     4998     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4999       (input  v-cntxt-db-num
     5000       ,input  v-cntxt-userid
     5001       ,input  0
     5002       ,input  'actn_mark_stchange':U
     5003       ,input  'firm':U
     5004       ,input  v-cntxt-host-code-obj
     5005       ,input  '':U
     5006       ,input  0
     5007       ,input  0
     5008       ,input  0
     5009       ,input  0
     5010       ,input  false
     5011       ,output log-res
     5012       )  .
     5013   end.
     5014   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5015   do:
     5016     br-mark :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5017   end.
     5018   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5019   do:
     5020     br-mark-item :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5021   end.
     5022      find first utd no-lock where utd.doc-id = tt-marking-lines.doc-id and utd.db-num = tt-marking-lines.db-num no-error .
     5023      if available (utd) then do:
     5024         if utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB then v-edoc-type = yes .
     5025      end.
     5026      if num-entries(p-doc,chr(4)) > 1 then
     5027      do:
     5028   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trim(entry(2,entry(1,p-doc,chr(4)),':')) ,
     5029                           input 'is-return':U ,
     5030                          output varvalue ,
     5031                          output vartype ) no-error .
     5032        mIsRasVneshReturn = (varvalue = "yes").
     5033      end.
     5034       run init-temp in this-procedure .
     5035       run enable_UI in this-procedure .
     5036       apply "entry" to v-mark in FRAME d-mark.
     5037       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     5038           then v-manual = yes .
     5039       else
     5040       do:
     5041           v-manual = no .
     5042           v-mark:READ-ONLY IN FRAME d-mark        = TRUE .
     5043       end.
     5044       X_marking-line.mark:COLUMN-READ-ONLY IN BROWSE br-mark-item = YES.
     5045       X_marking.mark     :COLUMN-READ-ONLY IN BROWSE br-mark      = YES.
     5046       apply "value-changed" to br-mark in FRAME d-mark.
     5047       WAIT-FOR GO OF FRAME d-mark focus br-mark-item.
     5048   END.
     5049   run disable_UI in this-procedure .
     5050   PROCEDURE disable_UI :
     5051       HIDE FRAME d-mark.
     5052   END PROCEDURE.
     5053   PROCEDURE enable_UI :
     5054       frame d-mark:title = entry(1,p-doc,chr(4)) + " " + p-mode.
     5055       ENABLE
     5056           b-exit
     5057           b-hist
     5058           b-look
     5059           with frame d-mark .
     5060       enable
     5061       br-mark
     5062       br-mark-item
     5063       with frame d-mark .
     5064       display f-text with frame d-mark .
     5065       if p-mode <> 'ПРОСМОТР':U then
     5066       do:
     5067           if p-type = 5 then
     5068           do:
     5069               ENABLE
     5070                   b-del
     5071                   b-mark
     5072                   bt-not-sel-all
     5073                   bt-not-sel-desel-all
     5074                   with frame d-mark .
     5075           end.
     5076           ENABLE
     5077               v-mark
     5078               with frame d-mark .
     5079           if log-res then
     5080           do:
     5081               enable
     5082                   c-status
     5083                   b-change
     5084                   b-mark
     5085                   bt-not-sel-all
     5086                   bt-not-sel-desel-all
     5087                    WITH FRAME d-mark.
     5088           end.
     5089       end.
     5090       else
     5091       do:
     5092           display
     5093               b-del
     5094               b-mark
     5095               b-mark-2
     5096               bt-not-sel-all
     5097               bt-not-sel-all-2
     5098               bt-not-sel-desel-all
     5099               bt-not-sel-desel-all-2
     5100               c-status
     5101               c-status-2
     5102               b-change
     5103               b-change-2
     5104               c-status-2
     5105               WITH FRAME d-mark.
     5106       end.
     5107       if p-type = 1 then
     5108       do:
     5109           if p-mode <> 'ПРОСМОТР':U then
     5110           do:
     5111           ENABLE
     5112               Status_
     5113               v-mark
     5114               with frame d-mark .
     5115           end.
     5116       end.
     5117       else
     5118       do:
     5119           hide b_block in frame d-mark .
     5120       end.
     5121       if p-type = 0 then
     5122       do:
     5123           hide
     5124               Status_
     5125               v-mark
     5126               in frame d-mark .
     5127       end.
     5128       if p-type <> 2 then
     5129       do:
     5130           find first buf_utd-err no-lock where buf_utd-err.db-num = tt-marking-lines.db-num and buf_utd-err.doc-id = tt-marking-lines.doc-id and buf_utd-err.reckey begins "utd-marking-lines" no-error .
     5131           if available (buf_utd-err) then
     5132               enable b_error with frame d-mark .
     5133       end.
     5134       if p-type = 6 then
     5135       do:
     5136           display qnty-mark with frame d-mark .
     5137           display qnty-mark-2 with frame d-mark .
     5138           hide f-qnty-unit in frame d-mark .
     5139           hide f-qnty-bar-code  in frame d-mark .
     5140       end.
     5141       else
     5142       do:
     5143           display f-qnty-unit with frame d-mark .
     5144           display f-qnty-bar-code with frame d-mark .
     5145           hide qnty-mark   in frame d-mark .
     5146           hide qnty-mark-2 in frame d-mark .
     5147       end.
     5148   END PROCEDURE.
     5149   PROCEDURE save-mark :
     5150       define variable v-GTIN as character no-undo .
     5151       for each X_marking-line no-lock where X_marking-line.GrayZone = yes:
     5152           create buf_utd-marking-lines .
     5153           assign
     5154               buf_utd-marking-lines.db-num    = X_marking-line.db-num
     5155               buf_utd-marking-lines.doc-id    = X_marking-line.doc-id
     5156               buf_utd-marking-lines.doc-level = X_marking-line.doc-level
     5157               buf_utd-marking-lines.gds-code  = X_marking-line.gds-code
     5158               buf_utd-marking-lines.LineNum   = X_marking-line.LineNum
     5159               buf_utd-marking-lines.mark      = X_marking-line.mark
     5160               buf_utd-marking-lines.sts       = X_marking-line.sts-utd
     5161               .
     5162           find first ub.marking exclusive-lock where ub.marking.mark = X_marking-line.mark no-error .
     5163           if not available (ub.marking) then
     5164           do:
     5165               create ub.marking .
     5166               assign
     5167                   ub.marking.mark = X_marking-line.mark
     5168                   ub.marking.box-qnty    = ?
     5169               .
     5170           end.
     5171           v-GTIN = getGtinByDM(X_marking-line.mark) .
     5172           assign
     5173               ub.marking.gds-code    = X_marking-line.gds-code
     5174               ub.marking.sts         = X_marking-line.sts
     5175               ub.marking.gds-ext-id  = v-GTIN
     5176               ub.marking.obj-code    = X_marking-line.obj-code
     5177               ub.marking.obj-type    = X_marking-line.obj-type
     5178               ub.marking.mark-parent = mark-parent
     5179           .
     5180           if v-edoc-type then ub.marking.sts = Marking:Checked_:KeyIntDB .
     5181           ub.marking.unit-ext  = getLevelMotpByDM(X_marking-line.mark) .
     5182           ub.marking.box-qnty  = getQntyCodeByGtin(getGtinByDM(X_marking-line.mark)).
     5183       end.
     5184   END PROCEDURE.
     5185   PROCEDURE init-temp :
     5186       define variable ii       as integer   no-undo .
     5187       define variable Status_1 as character no-undo .
     5188       Status_1 = "" + chr(44) + '0':U .
     5189      define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     5190      define variable objType  as ibs.th.gbl.propmap no-undo.
     5191      define variable Types as ibs.th.str.marking.sts.mark no-undo.
     5192      Types = ObjSrv:Env:Marking:Sts:Mark.
     5193      MarkType = Types:mapType.
     5194       do ii = 1 to MarkType:GetItemByLab(ii):
     5195           objType = Types:CurrProp.
     5196           Status_1 = Status_1 + chr(44) + objType:Label_ + chr(44) + string(objType:KeyIntDB) .
     5197       end.
     5198       ASSIGN
     5199           c-status:LIST-ITEM-PAIRS  in frame d-mark = Status_1 .
     5200       ASSIGN
     5201           c-status-2:LIST-ITEM-PAIRS  in frame d-mark = Status_1 .
     5202       if p-parent_mark <> "" then
     5203       do:
     5204         for first tt-marking-lines no-lock where tt-marking-lines.mark-parent = p-parent_mark:
     5205           vLevel = tt-marking-lines.doc-level.
     5206         end.
     5207       end.
     5208       for each tt-marking-lines no-lock where tt-marking-lines.unit-ext = "UNIT":
     5209              v-qnty-mark = v-qnty-mark + 1 .
     5210              if tt-marking-lines.sts-utd = Marking:Checked_:KeyIntDB then
     5211                qnty-mark-2 = qnty-mark-2 + 1.
     5212       end.
     5213       f-qnty-unit = v-qnty-mark .
     5214       f-qnty-bar-code = v-qnty-mark .
     5215       if p-type = 6 then
     5216       do:
     5217           find first tt-marking-lines no-lock where tt-marking-lines.doc-level = 1 no-error .
     5218           if available (tt-marking-lines) then
     5219           do:
     5220               qnty-mark = tt-marking-lines.box-qnty .
     5221               mark-parent = tt-marking-lines.mark .
     5222           end.
     5223           f-text = "Упаковка с неполным составом марок/штрих-кодом, необходимо просканировать все марки упаковки" .
     5224       end.
     5225       if p-parent_mark eq "" then OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.doc-level = 1 and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION. else OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.mark-parent = p-parent_mark and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION.    OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     5226   END PROCEDURE.
     5227   FUNCTION GdsName RETURNS CHARACTER
     5228       ( input p-gds-code as integer ) :
     5229       define buffer buf_goods for ub.goods .
     5230       define variable v-gds-name as character no-undo .
     5231       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5232       if available (buf_goods) then v-gds-name = buf_goods.gds-name .
     5233       RETURN v-gds-name.
     5234   END FUNCTION.
     5235   FUNCTION getStatusName RETURNS CHARACTER
     5236       ( input p-mark as character,
     5237         input p-sts-glob as integer,
     5238         input p-sts-loc  as integer ):
     5239       define variable vExtDocType as character no-undo.
     5240       define buffer c-marking for ub.c-marking.
     5241       vExtDocType = if num-entries(p-doc,chr(4)) > 1 then entry(2,p-doc,chr(4)) else ?.
     5242       if p-sts-loc = marking:Reserved:KeyIntDB and
     5243          (vExtDocType = 'we':U or vExtDocType = 'ev':U or mIsRasVneshReturn) then
     5244       do:
     5245         find last c-marking no-lock where
     5246                   c-marking.mark = p-mark
     5247              use-index pi-2 no-error.
     5248         if not avail c-marking or
     5249            c-marking.sts = marking:Checked_:KeyIntDB or
     5250            c-marking.sts = marking:FreeZone:KeyIntDB then
     5251           return StatusTHName(p-sts-glob).
     5252         else
     5253           return substitute("&1_&2",StatusTHName(p-sts-loc),StatusTHName(c-marking.sts)).
     5254       end.
     5255       else
     5256         return if p-sts-loc = marking:Checked_:KeyIntDB    and
     5257                   p-sts-glob <> marking:Ungrouped:KeyIntDB and
     5258                   p-sts-glob <> marking:MarkError:KeyIntDB
     5259                then StatusTHName(p-sts-loc)
     5260                else StatusTHName(p-sts-glob).
     5261   END FUNCTION.
     5262   ON ENTRY OF v-mark IN FRAME d-mark
     5263       DO:
     5264           run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     5265           run adm/shattri.p (
     5266                  input "get":U
     5267                  ,input  v-cntxt-obj-type
     5268                  ,input  v-cntxt-obj-code
     5269                  ,input  'marking':U
     5270                  ,input  'rus-key':U
     5271                  ,output p-value-character
     5272                  ,output p-value-date
     5273                  ,output p-value-decimal
     5274                  ,output p-value-integer
     5275                  ,output p-value-logical
     5276                  ,output p-param-type
     5277                  ,input-output table-handle v-tth
     5278                  ) no-error .
     5279           IF p-value-logical = yes THEN  iLang = 68748313.
     5280           run ActivateKeyboardLayout (input iLang, input 0).
     5281       END.
     5282   procedure LoadKeyboardLayoutA external "user32" :
     5283       define input  parameter P1 as char.
     5284       define input  parameter P2 as LONG.
     5285       define return parameter pret as LONG.
     5286   end procedure.
     5287   procedure ActivateKeyboardLayout external "user32" :
     5288       define input parameter P1 as LONG.
     5289       define input parameter P2 as LONG.
     5290   END PROCEDURE.
     5291   PROCEDURE scan-mark :
     5292       define variable v_list      as character no-undo .
     5293       define variable ii          as integer   no-undo .
     5294       define variable v-marking   as character no-undo .
     5295       define variable recid_mark1 as integer   no-undo .
     5296       define variable v-GTIN      as character no-undo .
     5297       define variable v-gds-code  as integer   no-undo .
     5298       define VARIABLE vRecKeyLine as character no-undo .
     5299       define VARIABLE vMsg        as character no-undo .
     5300       define variable vFlag       as log       no-undo.
     5301       define buffer gray_marking                for ub.marking .
     5302       define buffer gray_unit-marking           for ub.marking .
     5303       define buffer gray_utd-marking-lines      for ub.utd-marking-lines .
     5304       define buffer gray_unit_utd-marking-lines for ub.utd-marking-lines .
     5305       define buffer buf_utd-lines               for ub.utd-lines .
     5306       define buffer buf_utd-marking-lines       for ub.utd-marking-lines .
     5307       define buffer X_utd-lines                 for tt-utd-lines .
     5308       define buffer buf_utd-err                 for ub.utd-err .
     5309       define buffer un_utd-marking-lines        for ub.utd-marking-lines .
     5310       if v-mark:screen-value in frame d-mark = ""
     5311           then
     5312       do:
     5313           v-mark:screen-value in frame d-mark = v-scan-str.
     5314       end.
     5315       v-scan-str = "".
     5316       assign
     5317           v-mark = v-mark:screen-value in frame d-mark.
     5318       v-marking = GetCodeIdent(v-mark) .
     5319       f-text = "" .
     5320       f-text:screen-value = "" .
     5321       ASSIGN
     5322           v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
     5323       do ii = 1 to length (v-mark):
     5324           if LOOKUP( SUBSTRING( v-mark, ii, 1 ), v_list )  > 1 then
     5325           do:
     5326               message "Не корректно считана акцизная марка, перед считыванием переключите клавиатуру на английскую раскладку."
     5327                   view-as alert-box.
     5328               v-mark:screen-value = "" .
     5329               v-mark = "" .
     5330               return .
     5331           end.
     5332       end.
     5333       v-marking = GetCodeIdent(v-mark) .
     5334       if v-marking = "" or v-marking = ? then
     5335       do:
     5336           F-text = "            Просканирован штрих код, необходимо просканировать марку" .
     5337           display F-text with frame d-mark.
     5338           v-mark:screen-value = "" .
     5339           v-mark = "" .
     5340           return no-apply.
     5341       end.
     5342       if p-mode <> 'ПРОСМОТР':U then
     5343       do:
     5344           if p-type = 6 then
     5345           do:
     5346               find first X_marking-line exclusive-lock where X_marking-line.mark begins v-marking no-error .
     5347               if available (X_marking-line) then
     5348               do:
     5349                   recid_mark = recid (X_marking-line) .
     5350                   if X_marking-line.sts-utd = Marking:Checked_:KeyIntDB then
     5351                   do:
     5352                       if qnty-mark = qnty-mark-2 then
     5353                       do:
     5354                           F-text = "               Упаковка просканирована полностью".
     5355                           display F-text with frame d-mark.
     5356                           v-mark:screen-value = "" .
