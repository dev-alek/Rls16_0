     4626                           X_marking.stts:fGCOLOR in browse br-mark = red_COLOR.
     4627                           typem:fGCOLOR in browse br-mark = red_COLOR.
     4628                       end.
     4629               end case.
     4630               if X_marking.sts = Marking:MarkError:KeyIntDB then
     4631               do:
     4632                   X_marking.gds-code:fGCOLOR in browse br-mark = red_COLOR.
     4633                   X_marking.gds-name:fGCOLOR in browse br-mark = red_COLOR.
     4634                   X_marking.mark:fGCOLOR in browse br-mark = red_COLOR.
     4635                   X_marking.box-qnty:fGCOLOR in browse br-mark = red_COLOR.
     4636                   X_marking.weight:fGCOLOR in browse br-mark = red_COLOR.
     4637                   X_marking.unit:fGCOLOR in browse br-mark = red_COLOR.
     4638                   X_marking.stts:fGCOLOR in browse br-mark = red_COLOR.
     4639                   typem:fGCOLOR in browse br-mark = red_COLOR.
     4640               end.
     4641           end.
