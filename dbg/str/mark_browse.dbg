     4169   DEFINE VARIABLE Status_ AS INTEGER
     4170        VIEW-AS RADIO-SET HORIZONTAL
     4171        RADIO-BUTTONS
     4172             "Все", 0,
     4173   "Ожидает проверку", 1,
     4174   "Проверен", 7
     4175        SIZE 41 BY 1 NO-UNDO.
     4176   FUNCTION StatusTHName RETURNS CHARACTER
     4177     (input p-stsTH as integer)  .
     4178     Return Marking:GetLabel(p-stsTH) .
     4179   END FUNCTION .
     4180   DEFINE QUERY br-bar-code FOR
     4181     X_marking SCROLLING.
     4182   DEFINE QUERY br-mark FOR
     4183     X_marking SCROLLING.
     4184   DEFINE QUERY br-mark-item FOR
     4185     X_marking-line SCROLLING.
     4186   DEFINE BROWSE br-mark
     4187     QUERY br-mark NO-LOCK DISPLAY
     4188     X_marking.marking-string column-label "*" format "X(1)":U
     4189     X_marking.gds-code COLUMN-LABEL "Код товара" FORMAT "999999999":U
     4190     X_marking.gds-name COLUMN-LABEL "Наименование" FORMAT "x(210)":U width 15
     4191     (if length(X_marking.mark) < 16 then "ШК"
     4192     else if ismark(X_marking.mark) then "КМ"
     4193     else "АОД") @ typem COLUMN-LABEL "Тип!кода" FORMAT "x(3)":U
     4194     X_marking.mark COLUMN-LABEL "Марка/Штрих-код" FORMAT "x(56)":U width 33
     4195     X_marking.box-qnty column-label "Кол-во" format "->>>>>>9.99":U
     4196     if ismark(X_marking.mark) and WeighedProd(X_marking.gds-code) then string(MarkWeight(X_marking.mark),">>>>>9.999") else "" @ X_marking.weight COLUMN-LABEL "Вес" FORMAT "x(10)":U width 10
     4197     if not ismark(X_marking.mark) then "" else getStatusName(X_marking.mark,X_marking.sts,X_marking.sts-utd) @ X_marking.stts COLUMN-LABEL "Текущий статус" FORMAT "X(50)":U width 20
     4198     X_marking.site COLUMN-LABEL "" FORMAT "X(1)":U
     4199     if X_marking.unit eq ? or X_marking.unit eq "" then getLevelUTDByLevelMotp( X_marking.unit-ext) else X_marking.unit @ X_marking.unit COLUMN-LABEL "Ед.изм." FORMAT "x(8)":U
     4200   Enable
     4201   X_marking.mark
     4202       WITH NO-ROW-MARKERS SEPARATORS SIZE 123.5 BY 11 FIT-LAST-COLUMN.
     4203   DEFINE BROWSE br-mark-item
     4204     QUERY br-mark-item NO-LOCK DISPLAY
     4205     X_marking-line.marking-string column-label "*" format "X(1)":U
     4206     X_marking-line.gds-code COLUMN-LABEL "Код товара" FORMAT "999999999":U
     4207     X_marking-line.gds-name COLUMN-LABEL "Наименование" FORMAT "x(210)":U width 15
     4208     if length(X_marking.mark) < 16 then "ШК"
     4209     else if ismark(X_marking.mark) then "КМ"
     4210     else "АОД" @ typem COLUMN-LABEL "Тип!кода" FORMAT "x(3)":U
     4211     X_marking-line.mark COLUMN-LABEL "Марка" FORMAT "x(56)":U width 33
     4212     X_marking-line.box-qnty column-label "Кол-во" format "->>>>>>9.99":U
     4213     if ismark(X_marking-line.mark) and WeighedProd(X_marking-line.gds-code) then string(MarkWeight(X_marking-line.mark),">>>>>9.999") else "" @ X_marking-line.weight COLUMN-LABEL "Вес" FORMAT "x(10)":U width 10
     4214     getStatusName(X_marking.mark,X_marking-line.sts,X_marking-line.sts-utd) @ X_marking-line.stts COLUMN-LABEL "Текущий статус" FORMAT "X(50)":U width 20
     4215     X_marking-line.unit COLUMN-LABEL "Ед.изм." FORMAT "x(8)":U
     4216   Enable
     4217   X_marking-line.mark
     4218       WITH NO-ROW-MARKERS SEPARATORS SIZE 123.5 BY 11.25 FIT-LAST-COLUMN.
     4219   DEFINE FRAME d-mark
     4220        b-exit AT ROW 1 COL 1
     4221        b_block AT ROW 1 COL 101.63 WIDGET-ID 290
     4222        b_error AT ROW 1 COL 111.5 WIDGET-ID 282
     4223        v-mark AT ROW 1.08 COL 38 COLON-ALIGNED WIDGET-ID 34
     4224        b-hist AT ROW 1.08 COL 121.88 WIDGET-ID 64
     4225        F-text AT ROW 2.33 COL 23 NO-LABEL WIDGET-ID 224
     4226        bt-not-sel-all AT ROW 3.75 COL 1.63 WIDGET-ID 10 NO-TAB-STOP
     4227        bt-not-sel-desel-all AT ROW 3.75 COL 4.63 WIDGET-ID 12 NO-TAB-STOP
     4228        b-mark AT ROW 3.75 COL 7.63 WIDGET-ID 4
     4229        b-del AT ROW 3.75 COL 10.88 WIDGET-ID 66
     4230        c-status AT ROW 3.75 COL 22 COLON-ALIGNED NO-LABEL WIDGET-ID 72
     4231        b-change AT ROW 3.75 COL 53.5 WIDGET-ID 68
     4232        b-look AT ROW 3.75 COL 63.5 WIDGET-ID 68
     4233        Status_ AT ROW 3.75 COL 84 NO-LABEL WIDGET-ID 24
     4234        br-mark AT ROW 4.75 COL 1.5 WIDGET-ID 200
     4235        bt-not-sel-all-2 AT ROW 16 COL 1.5 WIDGET-ID 80 NO-TAB-STOP
     4236        bt-not-sel-desel-all-2 AT ROW 16 COL 4.5 WIDGET-ID 82 NO-TAB-STOP
     4237        b-mark-2 AT ROW 16 COL 7.5 WIDGET-ID 78
     4238        c-status-2 AT ROW 16 COL 21.88 COLON-ALIGNED NO-LABEL WIDGET-ID 84
     4239        b-change-2 AT ROW 16 COL 53.38 WIDGET-ID 74
     4240        f-qnty-unit AT ROW 16 COL 123.75 RIGHT-ALIGNED WIDGET-ID 284
     4241        qnty-mark-2 AT ROW 16 COL 107.25 COLON-ALIGNED WIDGET-ID 288
     4242        f-qnty-bar-code AT ROW 16 COL 123.75 RIGHT-ALIGNED WIDGET-ID 294
     4243        qnty-mark AT ROW 16 COL 117.38 COLON-ALIGNED WIDGET-ID 286
     4244        br-mark-item AT ROW 17 COL 1.5 WIDGET-ID 300
     4245        SPACE(0.99) SKIP(0.28)
     4246       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4247       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4248       TITLE "Проверка кодов маркировки":L.
     4249   ASSIGN
     4250          br-mark:HIDDEN  IN FRAME d-mark                = TRUE
     4251          br-mark:COLUMN-RESIZABLE IN FRAME d-mark       = TRUE.
     4252   ASSIGN
     4253          br-mark-item:HIDDEN  IN FRAME d-mark                = TRUE
     4254          br-mark-item:COLUMN-RESIZABLE IN FRAME d-mark       = TRUE.
     4255   assign
     4256         v-mark:hidden in frame d-mark = true .
     4257         b-change-2:hidden in frame d-mark = true .
     4258         b-mark-2:hidden in frame d-mark = true .
     4259         b_block:hidden in frame d-mark = true .
     4260         bt-not-sel-all-2:hidden in frame d-mark = true .
     4261         bt-not-sel-desel-all-2:hidden in frame d-mark = true .
     4262         c-status-2:hidden in frame d-mark = true .
     4263         b_error:hidden in frame d-mark = true .
     4264   ON CTRL-S OF FRAME d-mark
     4265   anywhere DO:
     4266     define buffer b_utd-marking-lines for ub.utd-marking-lines.
     4267     define buffer b_marking for ub.marking.
     4268     if focus:parent:type = "browse" and
     4269        focus:name = "mark" and
     4270        focus:screen-value <> "" then
     4271     do:
     4272       message
     4273         "Марка     :" focus:screen-value skip
     4274         "Глобальный:" if focus:parent:name = "br-mark" then X_marking.stts else X_marking-line.stts skip
     4275         "Локальный :" if focus:parent:name = "br-mark" then X_marking.stts-utd else X_marking-line.stts-utd
     4276       view-as alert-box title "Статус марки".
     4277     end.
     4278   END.
     4279   ON CHOOSE OF b-change IN FRAME d-mark
     4280       DO:
     4281           define variable ii         as integer no-undo .
     4282           define variable recid_mark as integer no-undo .
     4283           find first tt-marking-lines where tt-marking-lines.marking-string = "*" no-error .
     4284           if available (tt-marking-lines) then
     4285           do:
     4286               for each X_marking where X_marking.marking-string = "*":
     4287                   find first buf_marking exclusive-lock where buf_marking.mark = X_marking.mark no-error .
     4288                   if available (buf_marking)
     4289                       then
     4290                   do:
     4291                       buf_marking.sts = c-status .
     4292                       validate buf_marking.
     4293                       X_marking.sts = buf_marking.sts .
     4294                       X_marking.stts =  StatusTHName(X_marking.sts).
     4295                   end.
     4296                   find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking.mark
     4297                                                                     and buf_utd-marking-lines.db-num = X_marking.db-num
     4298                                                                     and buf_utd-marking-lines.doc-id = X_marking.doc-id no-error .
     4299                   if available (buf_utd-marking-lines)
     4300                       then
     4301                   do:
     4302                       buf_utd-marking-lines.sts = c-status .
     4303                       validate buf_utd-marking-lines.
     4304                       X_marking.sts-utd = buf_utd-marking-lines.sts .
     4305                       X_marking.stts-utd =  StatusTHName(X_marking.sts-utd).
     4306                   end.
     4307                   X_marking.marking-string = "" .
     4308               end.
     4309           end.
     4310           else
     4311           do:
     4312               recid_mark = recid(X_marking) .
     4313               find first X_marking where recid (X_marking) = recid_mark no-error.
     4314               if available (X_marking) then
     4315               do:
     4316                   find first buf_marking exclusive-lock where buf_marking.mark = X_marking.mark no-error .
     4317                   if available (buf_marking)
     4318                       then
     4319                   do:
     4320                       buf_marking.sts = c-status .
     4321                       validate buf_marking.
     4322                       X_marking.sts = buf_marking.sts .
     4323                       X_marking.stts =  StatusTHName(X_marking.sts).
     4324                   end.
     4325                   find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking.mark and buf_utd-marking-lines.db-num = X_marking.db-num and
     4326                       buf_utd-marking-lines.doc-id = X_marking.doc-id no-error .
     4327                   if available (buf_utd-marking-lines)
     4328                       then
     4329                   do:
     4330                       buf_utd-marking-lines.sts = c-status .
     4331                       validate buf_utd-marking-lines.
     4332                       X_marking.sts-utd = buf_utd-marking-lines.sts .
     4333                       X_marking.stts-utd =  StatusTHName(X_marking.sts-utd).
     4334                   end.
     4335               end.
     4336           end.
     4337           if p-parent_mark eq "" then OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.doc-level = 1 and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION. else OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.mark-parent = p-parent_mark and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION.    OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     4338           apply "entry" to br-mark in frame d-mark.
     4339       END.
     4340   ON CHOOSE OF b-change-2 IN FRAME d-mark
     4341       DO:
     4342           define variable ii         as integer no-undo .
     4343           define variable recid_mark as integer no-undo .
     4344           find first tt-marking-lines where tt-marking-lines.marking-string = "*" and tt-marking-lines.doc-level > 1 no-error .
     4345           if available (tt-marking-lines) then
     4346           do:
     4347               for each X_marking-line where X_marking-line.marking-string = "*" and tt-marking-lines.doc-level > 1:
     4348                   X_marking-line.sts-utd = c-status-2 .
     4349                   X_marking-line.stts-utd =  StatusTHName(X_marking-line.sts-utd).
     4350                   X_marking-line.sts = c-status-2 .
     4351                   X_marking-line.stts =  StatusTHName(X_marking-line.sts).
     4352                   find first buf_marking exclusive-lock where buf_marking.mark = X_marking-line.mark no-error .
     4353                   if available (buf_marking) then buf_marking.sts = X_marking-line.sts .
     4354                   find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking-line.mark and buf_utd-marking-lines.db-num = X_marking-line.db-num and
     4355                       buf_utd-marking-lines.doc-id = X_marking-line.doc-id no-error .
     4356                   if available (buf_utd-marking-lines) then buf_utd-marking-lines.sts = X_marking-line.sts-utd .
     4357                   X_marking-line.marking-string = "" .
     4358               end.
     4359           end.
     4360           else
     4361           do:
     4362               recid_mark = recid(X_marking-line) .
     4363               find first X_marking-line where recid (X_marking-line) = recid_mark no-error.
     4364               if available (X_marking-line) then
     4365               do:
     4366                   X_marking-line.sts-utd = c-status-2 .
     4367                   X_marking-line.stts-utd =  StatusTHName(X_marking-line.sts-utd).
     4368                   X_marking-line.sts = c-status-2 .
     4369                   X_marking-line.stts =  StatusTHName(X_marking-line.sts).
     4370                   find first buf_marking exclusive-lock where buf_marking.mark = X_marking-line.mark no-error .
     4371                   if available (buf_marking) then buf_marking.sts = X_marking-line.sts .
     4372                   find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking-line.mark and buf_utd-marking-lines.db-num = X_marking-line.db-num and
     4373                       buf_utd-marking-lines.doc-id = X_marking-line.doc-id no-error .
     4374                   if available (buf_utd-marking-lines) then buf_utd-marking-lines.sts = X_marking-line.sts-utd .
     4375               end.
     4376           end.
     4377           if p-parent_mark eq "" then OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.doc-level = 1 and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION. else OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.mark-parent = p-parent_mark and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION.    OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     4378           apply "entry" to br-mark in frame d-mark.
     4379       END.
     4380   ON CHOOSE OF b-del IN FRAME d-mark
     4381       DO:
     4382           define variable ii         as integer no-undo .
     4383           define variable recid_mark as integer no-undo .
     4384           if v-rid-list <> "" then
     4385           do:
     4386               do ii = 1 to num-entries (v-rid-list):
     4387                   recid_mark = integer(entry(ii,v-rid-list)) .
     4388                   for first X_marking where recid (X_marking) = recid_mark:
     4389                       for first buf_marking exclusive-lock where buf_marking.mark = X_marking.mark:
     4390                           for first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking.mark:
     4391                               for first buf_utd-lines exclusive-lock where buf_utd-lines.LineNum = buf_utd-marking-lines.LineNum and buf_utd-lines.db-num = buf_utd-marking-lines.db-num
     4392                                   and buf_utd-lines.doc-id = buf_utd-marking-lines.doc-id:
     4393                                   buf_utd-lines.Quantity = buf_utd-lines.Quantity - buf_marking.box-qnty .
     4394                                   delete X_marking.
     4395                                   delete buf_utd-marking-lines .
     4396                                   v-qnty-mark = v-qnty-mark - buf_marking.box-qnty .
     4397                                   if buf_utd-lines.Quantity = 0 then
     4398                                   do:
     4399                                       delete buf_utd-lines .
     4400                                   end.
     4401                               end.
     4402                           end.
     4403                       end.
     4404                   end.
     4405               end.
     4406           end.
     4407           else
     4408           do:
     4409               recid_mark = recid(X_marking) .
     4410               for first X_marking where recid (X_marking) = recid_mark:
     4411                   for first buf_marking exclusive-lock where buf_marking.mark = X_marking.mark:
     4412                       for first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking.mark:
     4413                           for first buf_utd-lines exclusive-lock where buf_utd-lines.LineNum = buf_utd-marking-lines.LineNum and buf_utd-lines.db-num = buf_utd-marking-lines.db-num
     4414                               and buf_utd-lines.doc-id = buf_utd-marking-lines.doc-id:
     4415                               buf_utd-lines.Quantity = buf_utd-lines.Quantity - buf_marking.box-qnty .
     4416                               delete X_marking.
     4417                               delete buf_utd-marking-lines .
     4418                               v-qnty-mark = v-qnty-mark - buf_marking.box-qnty .
     4419                               if buf_utd-lines.Quantity = 0 then
     4420                               do:
     4421                                   delete buf_utd-lines .
     4422                               end.
     4423                           end.
     4424                       end.
     4425                   end.
     4426               end.
     4427           end.
     4428           if p-parent_mark eq "" then OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.doc-level = 1 and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION. else OPEN QUERY br-mark FOR EACH X_marking NO-LOCK where x_marking.mark-parent = p-parent_mark and if Status_ <> 0 then if Status_ = 7 then x_marking.sts-utd = Status_ else x_marking.sts-utd = 3 or X_marking.sts-utd = Status_ else x_marking.sts-utd <> 99 INDEXED-REPOSITION.    OPEN QUERY br-mark-item for each X_marking-line no-lock where X_marking-line.mark-parent = vMarkBrow2   and if Status_ <> 0 then if Status_ = 7 then x_marking-line.sts-utd = Status_ else x_marking-line.sts-utd = 3 or X_marking-line.sts-utd = Status_ else x_marking-line.sts <> 99 INDEXED-REPOSITION.
     4429           apply "entry" to br-mark in frame d-mark.
     4430           f-qnty-unit = v-qnty-mark .
     4431           f-qnty-bar-code = v-qnty-mark .
     4432           display f-qnty-unit with frame d-mark .
     4433           display f-qnty-bar-code with frame d-mark .
     4434       END.
     4435   ON choose OF b-exit IN FRAME d-mark
     4436   DO:
     4437       define buffer buf_marking for ub.marking .
     4438       define variable quest-ok as logical no-undo .
     4439       define variable quest-scan as logical no-undo .
     4440       define buffer buf_utd for ub.utd .
     4441       if  p-type = 6 then
     4442       do:
     4443         find first buf_utd no-lock where buf_utd.db-num = X_marking.db-num and buf_utd.doc-id = X_marking.doc-id no-error .
     4444         if X_marking.box-qnty = qnty-mark-2 then
     4445         do:
     4446           find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking.mark and buf_utd-marking-lines.db-num = X_marking.db-num and
     4447             buf_utd-marking-lines.doc-id = X_marking.doc-id no-error .
     4448           if available (buf_utd-marking-lines) then
     4449           do:
     4450             buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB .
     4451             buf_utd-marking-lines.doc-level = 1 .
     4452             X_marking.sts-utd = Marking:Checked_:KeyIntDB .
     4453             X_marking.stts-utd = StatusTHName(X_marking.sts-utd) .
     4454           end.
     4455           for first buf_marking exclusive-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     4456             buf_marking.sts = Marking:Ungrouped:KeyIntDB .
     4457             X_marking.sts = Marking:Ungrouped:KeyIntDB .
     4458             X_marking.stts = StatusTHName(X_marking.sts) .
     4459           end.
     4460           run save-mark .
     4461         end .
     4462         else
     4463         do:
     4464           message "Марки просканированы не полностью." skip
     4465             "Должны быть просканированы все марки." skip
     4466             "Продолжить сканирование?" skip
     4467             "Да – возврат к сканированию" skip
     4468             "Нет – сброс введенной информации"
     4469             view-as alert-box question buttons yes-no update quest-ok.
     4470           if not quest-ok then
     4471           do:
     4472               for each X_marking-line exclusive-lock where X_marking-line.doc-level > 1:
     4473                 find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = X_marking-line.mark and buf_utd-marking-lines.db-num = X_marking-line.db-num and
     4474                 buf_utd-marking-lines.doc-id = X_marking-line.doc-id no-error .
     4475                 if available (buf_utd-marking-lines) then do:
     4476                    if available (buf_utd) and buf_utd.EdocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     4477                       then
     4478                    do:
     4479                       buf_utd-marking-lines.sts = Marking:DeliveryControl:KeyIntDB .
     4480                       X_marking-line.sts-utd = Marking:DeliveryControl:KeyIntDB .
     4481                       X_marking-line.stts-utd = StatusTHName(X_marking-line.sts-utd) .
     4482                    end .
     4483                    else
     4484                    do:
     4485                       buf_utd-marking-lines.sts = Marking:PendingVerification:KeyIntDB .
     4486                       X_marking-line.sts-utd = Marking:PendingVerification:KeyIntDB .
     4487                       X_marking-line.stts-utd = StatusTHName(X_marking-line.sts-utd) .
     4488                    end.
     4489                 end.
     4490                 if X_marking-line.GrayZone = yes then
     4491                 do:
     4492                   delete X_marking-line .
     4493                 end.
     4494               end.
     4495           end.
     4496           else
     4497           do:
     4498             return no-apply .
     4499           end.
     4500         end.
     4501       end.
     4502      else if p-type = 7 then
     4503       do:
     4504         define variable vQnty as integer no-undo.
     4505         find first buf_utd no-lock where buf_utd.db-num = X_marking.db-num and buf_utd.doc-id = X_marking.doc-id no-error .
     4506         for each tt-gray-marking-lines where tt-gray-marking-lines.mark-parent eq X_marking.mark
     4507                                          and   tt-gray-marking-lines.sts-utd = Marking:Checked_:KeyIntDB
     4508                                             or tt-gray-marking-lines.sts-utd = Marking:MarkError:KeyIntDB
     4509         no-lock:
     4510            vQnty = vqnty + tt-gray-marking-lines.box-qnty.
     4511         end.
     4512         if X_marking.box-qnty ne vQnty then
     4513         do:
     4514            message "Марки просканированы не полностью." skip
     4515             "Не просканированные марки будут не приняты" skip
     4516             "Продолжить сканирование?" skip
     4517             "Да – возврат к сканированию" skip
     4518             "Нет"
     4519             view-as alert-box question buttons yes-no update quest-ok.
     4520           if not quest-ok then
     4521           do:
     4522              run save-mark .
     4523           end.
     4524         end .
     4525         else
     4526         do:
     4527            return no-apply .
     4528         end.
     4529       end.
     4530     END.
     4531   ON choose OF b-hist IN FRAME d-mark
     4532       DO:
     4533           if available (X_marking) then
     4534           do:
     4535               run str/mark_hist.w(input parparentproc,
     4536                   input X_marking.mark,
     4537                   input p-mode).
     4538           end.
     4539           else
     4540           do:
     4541               if available (X_marking-line) then
     4542               do:
     4543                   run str/mark_hist.w(input parparentproc,
     4544                       input X_marking-line.mark,
     4545                       input p-mode).
     4546               end.
     4547               else
     4548               do:
     4549                   message "Не выбрана марка"
     4550                       view-as alert-box.
     4551               end.
     4552           end.
     4553       END.
     4554   ON CHOOSE OF b-mark IN FRAME d-mark
     4555       DO:
     4556           define variable loc#log     as logical no-undo .
     4557           define variable row-marking as rowid   no-undo .
     4558           if available X_marking
     4559              and X_marking.isMark
     4560           then
     4561           do:
     4562               if X_marking.marking-string = "*" then X_marking.marking-string = "" .
     4563               else X_marking.marking-string = "*" .
     4564               row-marking = rowid(X_marking).
     4565               loc#log = br-mark:refresh() .
     4566               reposition br-mark to rowid row-marking.
     4567               loc#log = br-mark:refresh() .
     4568               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     4569               do:
     4570                   loc#log = br-mark:select-next-row () .
     4571                   apply "VALUE-CHANGED" to br-mark in frame d-mark .
     4572               end.
     4573               apply "entry" to br-mark in frame d-mark.
     4574            end.
     4575       END.
     4576   ON CHOOSE OF b-mark-2 IN FRAME d-mark
     4577       DO:
     4578           define variable loc#log     as logical no-undo .
     4579           define variable row-marking as rowid   no-undo .
     4580           apply "entry" to br-mark in frame d-mark.
     4581           if     available X_marking-line
     4582              and X_marking.isMark
     4583           then
     4584           do:
     4585               if X_marking-line.marking-string = "*" then X_marking-line.marking-string = "" .
     4586               else X_marking-line.marking-string = "*" .
     4587               row-marking = rowid(X_marking-line).
     4588               loc#log = br-mark-item:refresh() .
     4589               reposition br-mark-item to rowid row-marking.
     4590               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     4591               do:
     4592                   loc#log = br-mark-item:select-next-row () .
     4593                   apply "VALUE-CHANGED" to br-mark-item in frame d-mark.
     4594               end.
     4595           end.
     4596           apply "entry" to br-mark-item in frame d-mark.
     4597       END.
     4598   ON value-changed OF br-mark-item IN FRAME d-mark
     4599       DO:
     4600           br-mark-item:refresh () no-error .
     4601       END.
