      120   define temp-table userobjs_temp-user-obj no-undo
      121     field obj-type as character
      122     field obj-code as integer
      123     index xpk is primary unique obj-type obj-code
      124     .
      125   procedure userobjs_clear :
      126     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      127     do
      128     on error undo, return error return-value
      129     :
      130       for each buf_userobjs_temp-user-obj
      131       on error undo, return error return-value
      132       :
      133         delete buf_userobjs_temp-user-obj .
      134       end.
      135     end.
      136   end .
      137   procedure userobjs_object-count :
      138     define output parameter p-total-count as integer   no-undo .
      139     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      140     do
      141     on error undo, return error return-value
      142     :
      143       assign
      144         p-total-count = 0
      145       .
      146       for each buf_userobjs_temp-user-obj
      147       on error undo, return error return-value
      148       :
      149         assign
      150           p-total-count = p-total-count + 1
      151         .
      152       end.
      153     end.
      154   end.
      155   procedure userobjs_append :
      156      define input  parameter p-obj-type as character no-undo .
      157      define input  parameter p-obj-code as integer   no-undo .
      158     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      159     do
      160     on error undo, return error return-value
      161     :
      162       find first buf_userobjs_temp-user-obj
      163         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      164           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      165         no-error .
      166       if not available buf_userobjs_temp-user-obj
      167       then do:
      168         create buf_userobjs_temp-user-obj .
      169         assign
      170           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      171           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      172         .
      173       end.
      174     end.
      175   end.
      176   procedure userobjs_object-exist :
      177     define output parameter p-object-exist as logical   no-undo .
      178     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      179     do
      180     on error undo, return error return-value
      181     :
      182       find first buf_userobjs_temp-user-obj
      183         no-error .
      184       if not available buf_userobjs_temp-user-obj
      185       then do:
      186         assign
      187           p-object-exist = false
      188         .
      189       end.
      190       else do:
      191         assign
      192           p-object-exist = true
      193         .
      194       end.
      195     end.
      196   end.
      197   procedure userobjs_transfer :
      198     define input  parameter p-callback-handle as handle no-undo .
      199     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      200     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      201     do
      202     on error undo, return error return-value
      203     :
      204       if valid-handle(p-callback-handle) <> true
      205       then do:
      206         message
      207           vss-workfile vss-revision vss-description skip
      208           "Ошибка задания входных параметров" skip
      209           "Неизвестный указатель на процедуру" skip
      210           view-as alert-box error .
      211         undo, return error return-value .
      212       end.
      213       if p-callback-handle :get-signature("userobjs_append") = ""
      214       then do:
      215         message
      216           vss-workfile vss-revision vss-description skip
      217           "Ошибка задания входных параметров" skip
      218           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      219                     ,p-callback-handle :file-name
      220                     ) skip
      221           view-as alert-box error .
      222         undo, return error return-value .
      223       end.
      224       for each buf_userobjs_temp-user-obj
      225       on error undo, return error return-value
      226       :
      227         run userobjs_append in p-callback-handle
      228           (input  buf_userobjs_temp-user-obj.obj-type
      229           ,input  buf_userobjs_temp-user-obj.obj-code
      230           ) .
      231       end.
      232     end.
      233   end procedure.
      234   procedure userobjs_select-one :
