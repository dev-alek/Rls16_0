      290   procedure thobjs :
      291      define input        parameter parparentproc     as widget-handle no-undo .
      292      define input        parameter i-bttns           as character     no-undo .
      293      define input        parameter i-list-mode       as character     no-undo.
      294      define input        parameter i-obj-type        as character     no-undo.
      295      define input        parameter i-db-num          as integer       no-undo.
      296      define input        parameter i-host-code       as integer       no-undo.
      297      define input-output parameter p-rid-list        as character     no-undo .
