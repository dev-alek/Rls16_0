     5611                                               tt-gray-marking-lines.mark        = gray_unit-marking.mark
     5612                                               tt-gray-marking-lines.mark-parent = gray_unit-marking.mark-parent
     5613                                               tt-gray-marking-lines.gds-code    = gray_unit_utd-marking-lines.gds-code
