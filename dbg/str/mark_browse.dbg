     1116   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   procedure gen-key-rec :
     1118     define input  parameter p-tbl-name    as character no-undo.
     1119     define input  parameter p-bh_tbl-name as handle    no-undo.
     1120     define output parameter p-key-rec     as character no-undo.
     1121     do
     1122     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1123     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1124     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1125     :
     1126       define variable fh               as handle    no-undo .
     1127       define variable v-ok             as logical   no-undo .
     1128       define variable v-inform         as character no-undo .
     1129       define variable v-ind            as integer   no-undo .
     1130       define variable v-idx-field-qnty as integer   no-undo .
     1131       if p-tbl-name = ?
     1132         or p-tbl-name = "":U
     1133       then do:
     1134         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
     1135       end.
     1136       if not p-bh_tbl-name:available then do:
     1137         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
     1138       end.
     1139       assign
     1140         p-key-rec = p-tbl-name
     1141         v-inform  = p-bh_tbl-name:index-information(1)
     1142         v-ind     = 2
     1143       .
     1144       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1145       on error undo, return error
     1146       :
     1147         assign
     1148           v-inform = p-bh_tbl-name:index-information( v-ind )
     1149           v-ind    = v-ind + 1
     1150         .
     1151       end.
     1152       if v-inform = ?
     1153         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1154         or entry( 3, v-inform, ",":U ) <> "1":U
     1155       then do:
     1156         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
     1157       end.
     1158       else do:
     1159         assign
     1160           v-idx-field-qnty = num-entries( v-inform ) - 4
     1161         .
     1162         if v-idx-field-qnty < 2 then do:
     1163           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
     1164         end.
     1165         do v-ind = 1 to v-idx-field-qnty by 2
     1166         on error undo, return error
     1167         :
     1168           assign
     1169             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1170             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1171           .
     1172         end.
     1173       end.
     1174       if p-key-rec = ? then do:
     1175         assign
     1176           p-key-rec = "":U
     1177         .
     1178         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
     1179       end.
     1180     end.
     1181     return.
     1182   end procedure.
     1183   procedure gen-where-keyr-tab :
     1184     define input  parameter i-tableSerach as character no-undo.
     1185     define input  parameter i-tablekey   as character  no-undo.
     1186     define input  parameter p-key-rec    as character  no-undo.
     1187     define input  parameter p-key-handle as handle     no-undo .
     1188     define input  parameter p-db-name    as character  no-undo .
     1189     define input  parameter p-tt-handle  as handle     no-undo .
     1190     define output parameter o-Where      as character  no-undo.
     1191     do
     1192     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1193     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1194     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1195     :
     1196       define variable v-full-tbl-name  as character no-undo .
     1197       define variable bh_tbl-name      as handle    no-undo .
     1198       define variable fh_key           as handle    no-undo .
     1199       define variable fh_search        as handle    no-undo .
     1200       define variable v-field-num      as integer   no-undo .
     1201       define variable v-count-fld      as integer   no-undo .
     1202       define variable v-inform         as character no-undo .
     1203       define variable v-ind            as integer   no-undo .
     1204       define variable v-idx-field-qnty as integer   no-undo .
     1205       define variable v-field-name     as character no-undo .
     1206       define variable v-field-val      as character no-undo .
     1207       define variable v-word-link      as character no-undo .
     1208       define variable vTable           as character no-undo.
     1209       define variable bh_tbl-key       as handle    no-undo .
     1210       assign
     1211         p-key-rec = trim( p-key-rec )
     1212       .
     1213       if p-key-handle <> ? then do:
     1214         if not valid-handle(p-key-handle)
     1215            or p-key-handle:type <> "buffer"
     1216         then do:
     1217           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
     1218         end.
     1219         if num-entries( p-key-rec, chr(3) ) > 1
     1220           or p-key-rec = ?
     1221           or p-key-rec = "":U
     1222         then do:
     1223           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
     1224         end.
     1225       end.
     1226       else do:
     1227         if p-key-rec = ?
     1228           or p-key-rec = "":U
     1229         then do:
     1230           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1231         end.
     1232       end.
     1233       assign
     1234         vTable = entry( 1 , p-key-rec, chr(3) )
     1235       .
     1236       if p-tt-handle <> ?
     1237         and ( not valid-handle(p-tt-handle)
     1238               or p-tt-handle:type <> "buffer"
     1239             )
     1240       then do:
     1241         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
     1242       end.
     1243       if p-tt-handle = ? then do:
     1244         assign
     1245           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1246         .
     1247         create buffer bh_tbl-name for table v-full-tbl-name .
     1248       end.
     1249       else do:
     1250         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1251       end.
     1252       assign
     1253         v-inform = bh_tbl-name:index-information(1)
     1254         v-ind    = 2
     1255       .
     1256       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1257       on error undo, return error
     1258       :
     1259         assign
     1260           v-inform = bh_tbl-name:index-information( v-ind )
     1261           v-ind    = v-ind + 1
     1262         .
     1263       end.
     1264       if v-inform = ?
     1265         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1266         or entry( 3, v-inform, ",":U ) <> "1":U
     1267       then do:
     1268         delete object bh_tbl-name no-error.
     1269         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     1270       end.
     1271       assign
     1272         v-idx-field-qnty = num-entries( v-inform ) - 4
     1273       .
     1274       if v-idx-field-qnty < 2 then do:
     1275         delete object bh_tbl-name no-error.
     1276         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     1277       end.
     1278       assign
     1279         o-where     = "where":U
     1280         v-word-link = "":U
     1281         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1282         v-count-fld = 0
     1283       .
     1284       if i-tablekey ne "" and i-tablekey ne ?
     1285       then do:
     1286         assign
     1287           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1288         .
     1289         create buffer bh_tbl-key for table v-full-tbl-name .
     1290       end.
     1291       if i-tableSerach ne "" and i-tableSerach ne ?
     1292       then do:
     1293         delete object bh_tbl-name no-error.
     1294         assign
     1295           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1296         .
     1297         create buffer bh_tbl-name for table v-full-tbl-name .
     1298       end.
     1299       block_where:
     1300       do v-ind = 1 to v-idx-field-qnty by 2
     1301       on error undo, return error
     1302       :
     1303         assign
     1304           v-count-fld = v-count-fld + 1
     1305         .
     1306         if p-key-handle = ?
     1307           and v-count-fld > v-field-num
     1308         then do:
     1309           leave block_where.
     1310         end.
     1311         define variable VfieldKeyTable as handle no-undo.
     1312         assign
     1313           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1314           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1315         .
     1316         if     bh_tbl-key ne ?
     1317         then do:
     1318            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1319            if VfieldKeyTable eq ?
     1320            then next block_where.
     1321         end.
     1322         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1323         then
     1324            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1325         else
     1326            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1327         if p-key-handle = ? then do:
     1328           assign
     1329             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1330           .
     1331         end.
     1332         else do:
     1333           assign
     1334             fh_key = p-key-handle:buffer-field( v-field-name )
     1335           .
     1336           if fh_key = ?
     1337             or not valid-handle( fh_key )
     1338           then do:
     1339             delete object bh_tbl-name.
     1340             if     bh_tbl-key ne ?
     1341             then
     1342                delete object bh_tbl-key.
     1343             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     1344           end.
     1345           assign
     1346             v-field-val = fh_key:buffer-value
     1347           .
     1348         end.
     1349         if fh_search:data-type ="character":U then do:
     1350           assign
     1351             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1352             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1353             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1354             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1355             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1356             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1357             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1358             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1359             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1360             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1361             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1362             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1363             v-field-val = substitute( '"&1"', v-field-val )
     1364           .
     1365         end.
     1366         assign
     1367           o-where = substitute( "&1 &2", o-where, v-field-val )
     1368         .
     1369         if v-word-link = "":U then do:
     1370           assign
     1371             v-word-link = "and":U
     1372           .
     1373         end.
     1374       end.
     1375       delete object bh_tbl-name.
     1376       if     bh_tbl-key ne ?
     1377       then
     1378          delete object bh_tbl-key.
     1379       if p-key-handle = ?
     1380         and v-count-fld <> v-field-num
     1381       then do:
     1382         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     1383       end.
     1384     end.
     1385   end procedure.
     1386   procedure gen-hn-keyr-tab :
     1387     define input  parameter i-tableSerach as character no-undo.
     1388     define input  parameter i-tablekey   as character no-undo.
     1389     define input  parameter p-key-rec    as character no-undo.
     1390     define input  parameter p-key-handle as handle    no-undo .
     1391     define input  parameter p-db-name    as character no-undo .
     1392     define input  parameter p-tt-handle  as handle    no-undo .
     1393     define input  parameter p-stts-lock  as integer   no-undo .
     1394     define output parameter o-hn         as handle    no-undo.
     1395     define variable v-full-tbl-name as character no-undo.
     1396     define variable v-where         as character no-undo.
     1397     define variable bh_tbl-name     as handle    no-undo.
     1398     define variable vTable          as character no-undo.
     1399     do
     1400     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1401     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1402     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1403         run gen-where-keyr-tab(i-tableSerach,
     1404                                i-tablekey,
     1405                                p-key-rec,
     1406                                p-key-handle,
     1407                                p-db-name,
     1408                                p-tt-handle,
     1409                                output v-where).
     1410         if i-tableSerach ne "" and i-tableSerach ne ?
     1411         then do:
     1412            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1413            create buffer bh_tbl-name for table v-full-tbl-name .
     1414         end.
     1415         else do:
     1416            if p-tt-handle = ? then do:
     1417               assign
     1418                  vTable = entry( 1 , p-key-rec, chr(3) )
     1419               .
     1420               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1421               create buffer bh_tbl-name for table v-full-tbl-name .
     1422            end.
     1423            else do:
     1424               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1425            end.
     1426         end.
     1427         if p-tt-handle = ? then do:
     1428            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1429         end.
     1430         else do:
     1431            bh_tbl-name:find-first( v-where ) no-error .
     1432         end.
     1433         o-hn = bh_tbl-name.
     1434      end.
     1435   end procedure.
     1436   procedure gen-hn-keyr :
     1437     define input  parameter p-key-rec    as character no-undo.
     1438     define input  parameter p-key-handle as handle    no-undo .
     1439     define input  parameter p-db-name    as character no-undo .
     1440     define input  parameter p-tt-handle  as handle    no-undo .
     1441     define input  parameter p-stts-lock  as integer   no-undo .
     1442     define output parameter o-hn         as handle    no-undo.
     1443     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1444   end.
     1445   procedure gen-row-keyr :
     1446     define input  parameter p-key-rec    as character no-undo.
     1447     define input  parameter p-key-handle as handle    no-undo .
     1448     define input  parameter p-db-name    as character no-undo .
     1449     define input  parameter p-tt-handle  as handle    no-undo .
     1450     define input  parameter p-stts-lock  as integer   no-undo .
     1451     define output parameter p-tbl-row    as rowid     no-undo.
     1452     define output parameter p-tbl-name   as character no-undo.
     1453     define variable vHn as handle no-undo.
     1454       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1455       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1456       p-tbl-name =  vHn:table.
     1457       delete object vHn no-error.
     1458     if p-tbl-row = ? then do:
     1459       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1460     end.
     1461     else do:
     1462       return.
     1463     end.
     1464   end procedure.
     1465   procedure gen-key-fv :
     1466     define input  parameter p-key-rec    as character no-undo .
     1467     define output parameter p-field-list as character no-undo .
     1468     define output parameter p-value-list as character no-undo.
     1469     do
     1470     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1471     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1472     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1473     :
     1474       define variable v-full-tbl-name  as character no-undo .
     1475       define variable bh_tbl-name      as handle    no-undo .
     1476       define variable v-tbl-name       as character no-undo .
     1477       define variable v-field-num      as integer   no-undo .
     1478       define variable v-count-fld      as integer   no-undo .
     1479       define variable v-inform         as character no-undo .
     1480       define variable v-ind            as integer   no-undo .
     1481       define variable v-idx-field-qnty as integer   no-undo .
     1482       define variable v-delim-key      as character no-undo .
     1483       if p-key-rec = ?
     1484         or p-key-rec = "":U
     1485       then do:
     1486         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1487       end.
     1488       assign
     1489         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1490         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1491       .
     1492       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1493       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1494       assign
     1495         v-inform = bh_tbl-name:index-information(1)
     1496         v-ind    = 2
     1497       .
     1498       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1499       on error undo, return error
     1500       :
     1501         assign
     1502           v-inform = bh_tbl-name:index-information( v-ind )
     1503           v-ind    = v-ind + 1
     1504         .
     1505       end.
     1506       if v-inform = ?
     1507         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1508         or entry( 3, v-inform, ",":U ) <> "1":U
     1509       then do:
     1510         delete object bh_tbl-name no-error.
     1511         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1512       end.
     1513       assign
     1514         v-idx-field-qnty = num-entries( v-inform ) - 4
     1515       .
     1516       if v-idx-field-qnty < 2 then do:
     1517         delete object bh_tbl-name no-error.
     1518         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1519       end.
     1520       assign
     1521         p-field-list = "":U
     1522         p-value-list = "":U
     1523         v-delim-key  = "":U
     1524         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1525         v-count-fld  = 0
     1526       .
     1527       block_where:
     1528       do v-ind = 1 to v-idx-field-qnty by 2
     1529       on error undo, return error
     1530       :
     1531         assign
     1532           v-count-fld = v-count-fld + 1
     1533         .
     1534         if v-count-fld > v-field-num then do:
     1535           leave block_where.
     1536         end.
     1537         assign
     1538           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1539           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1540         .
     1541         if v-ind = 1 then do:
     1542           assign
     1543             v-delim-key = chr(3)
     1544           .
     1545         end.
     1546       end.
     1547       delete object bh_tbl-name.
     1548       if v-count-fld <> v-field-num then do:
     1549         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1550       end.
     1551     end.
     1552   end procedure.
     1553   procedure gen-key-field :
     1554     define input  parameter p-table      as character no-undo .
     1555     define output parameter p-field-list as character no-undo .
     1556     do
     1557     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1558     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1559     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1560     :
     1561       define variable v-full-tbl-name  as character no-undo .
     1562       define variable bh_tbl-name      as handle    no-undo .
     1563       define variable v-tbl-name       as character no-undo .
     1564       define variable v-field-num      as integer   no-undo .
     1565       define variable v-count-fld      as integer   no-undo .
     1566       define variable v-inform         as character no-undo .
     1567       define variable v-ind            as integer   no-undo .
     1568       define variable v-idx-field-qnty as integer   no-undo .
     1569       define variable v-delim-key      as character no-undo .
     1570       if p-table = ?
     1571         or p-table = "":U
     1572       then do:
     1573         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1574       end.
     1575       assign
     1576         v-tbl-name      = p-table
     1577         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1578       .
     1579       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1580       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1581       assign
     1582         v-inform = bh_tbl-name:index-information(1)
     1583         v-ind    = 2
     1584       .
     1585       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1586       on error undo, return error
     1587       :
     1588         assign
     1589           v-inform = bh_tbl-name:index-information( v-ind )
     1590           v-ind    = v-ind + 1
     1591         .
     1592       end.
     1593       if v-inform = ?
     1594         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1595         or entry( 3, v-inform, ",":U ) <> "1":U
     1596       then do:
     1597         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1598       end.
     1599       assign
     1600         v-idx-field-qnty = num-entries( v-inform ) - 4
     1601       .
     1602       if v-idx-field-qnty < 2 then do:
     1603         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1604       end.
     1605       assign
     1606         p-field-list = "":U
     1607         v-delim-key  = "":U
     1608         v-count-fld  = 0
     1609       .
     1610       block_where:
     1611       do v-ind = 1 to v-idx-field-qnty by 2
     1612       on error undo, return error
     1613       :
     1614         assign
     1615           v-count-fld = v-count-fld + 1
     1616         .
     1617         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1618         if v-ind = 1 then do:
     1619           assign
     1620             v-delim-key = chr(3)
     1621           .
     1622         end.
     1623       end.
     1624       delete object bh_tbl-name.
     1625     end.
     1626   end procedure.
     1627   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1628   define variable vss-include-info12 as character format "X(65)" no-undo
     1629   initial "@(#)$Workfile$ $Revision$".
     1630   procedure xmlchar-test :
     1631   define input parameter p-in-string          as character        no-undo.
     1632   define output parameter p-out-string-enc    as character        no-undo.
     1633   define output parameter p-out-string-dec    as character        no-undo.
     1634   do
     1635   on error undo, return error
     1636   :
     1637          run xmlchar-encode in this-procedure
     1638       (
     1639             input p-in-string
     1640           , output p-out-string-enc
     1641       ).
     1642          run xmlchar-decode in this-procedure
     1643       (
     1644             input p-out-string-enc
     1645           , output p-out-string-dec
     1646       ).
     1647   end.
     1648   end .
     1649   procedure xmlchar-encode :
     1650   define input parameter p-in-string      as character        no-undo.
     1651   define output parameter p-out-string    as character        no-undo.
     1652       define variable v-position      as integer      no-undo.
     1653       define variable v-current-char  as character    no-undo.
     1654   do
     1655   on error undo, return error
     1656   :
     1657       assign
     1658           p-out-string = "":U
     1659       .
     1660       case p-in-string
     1661       :
     1662           when ?
     1663           then do:
     1664               assign
     1665                   p-out-string = "?":U
     1666               .
     1667           end.
     1668           when "?":U
     1669           then do:
     1670               assign
     1671                   p-out-string = "&#63;":U
     1672               .
     1673           end.
     1674           otherwise do:
     1675               do v-position = 1 to length( p-in-string )
     1676               :
     1677                   assign
     1678                       v-current-char = substring( p-in-string, v-position, 1 )
     1679                   .
     1680                   case v-current-char
     1681                   :
     1682                       when "&":U
     1683                       then do:
     1684                           assign
     1685                               p-out-string = p-out-string + "&amp;":U
     1686                           .
     1687                       end.
     1688                       when ">":U
     1689                       then do:
     1690                           assign
     1691                               p-out-string = p-out-string + "&gt;":U
     1692                           .
     1693                       end.
     1694                       when "<":U
     1695                       then do:
     1696                           assign
     1697                               p-out-string = p-out-string + "&lt;":U
     1698                           .
     1699                       end.
     1700                       when "'":U
     1701                       then do:
     1702                           assign
     1703                               p-out-string = p-out-string + "&apos;":U
     1704                           .
     1705                       end.
     1706                       when '"':U
     1707                       then do:
     1708                           assign
     1709                               p-out-string = p-out-string + "&quot;":U
     1710                           .
     1711                       end.
     1712                       when chr(1)
     1713                       then do:
     1714                           assign
     1715                               p-out-string = p-out-string + "":U
     1716                           .
     1717                       end.
     1718                       when chr(2)
     1719                       then do:
     1720                           assign
     1721                               p-out-string = p-out-string + "":U
     1722                           .
     1723                       end.
     1724                       when chr(3)
     1725                       then do:
     1726                           assign
     1727                               p-out-string = p-out-string + "":U
     1728                           .
     1729                       end.
     1730                       when chr(4)
     1731                       then do:
     1732                           assign
     1733                               p-out-string = p-out-string + "":U
     1734                           .
     1735                       end.
     1736                       when chr(5)
     1737                       then do:
     1738                           assign
     1739                               p-out-string = p-out-string + "":U
     1740                           .
     1741                       end.
     1742                       when chr(6)
     1743                       then do:
     1744                           assign
     1745                               p-out-string = p-out-string + "":U
     1746                           .
     1747                       end.
     1748                       when chr(7)
     1749                       then do:
     1750                           assign
     1751                               p-out-string = p-out-string + "":U
     1752                           .
     1753                       end.
     1754                       when chr(8)
     1755                       then do:
     1756                           assign
     1757                               p-out-string = p-out-string + "":U
     1758                           .
     1759                       end.
     1760                       when chr(9)
     1761                       then do:
     1762                           assign
     1763                               p-out-string = p-out-string + "":U
     1764                           .
     1765                       end.
     1766                       when chr(29)
     1767                       then do:
     1768                           assign
     1769                               p-out-string = p-out-string + "":U
     1770                           .
     1771                       end.
     1772                       when chr(10)
     1773                       then do:
     1774                           assign
     1775                               p-out-string = p-out-string + "&#10;":U
     1776                           .
     1777                       end.
     1778                       when chr(13)
     1779                       then do:
     1780                           assign
     1781                               p-out-string = p-out-string + "&#13;":U
     1782                           .
     1783                       end.
     1784                       otherwise do:
     1785                           assign
     1786                               p-out-string = p-out-string + v-current-char
     1787                           .
     1788                       end.
     1789                   end case.
     1790               end.
     1791           end.
     1792       end case.
     1793   end.
     1794   end .
     1795   procedure xmlchar-encode-1c :
     1796   define input parameter p-in-string      as character        no-undo.
     1797   define output parameter p-out-string    as character        no-undo.
     1798       define variable v-position      as integer      no-undo.
     1799       define variable v-current-char  as character    no-undo.
     1800   do
     1801   on error undo, return error
     1802   :
     1803       assign
     1804           p-out-string = "":U
     1805       .
     1806       case p-in-string
     1807       :
     1808           when ?
     1809           then do:
     1810               assign
     1811                   p-out-string = "?":U
     1812               .
     1813           end.
     1814           otherwise do:
     1815               do v-position = 1 to length( p-in-string )
     1816               :
     1817                   assign
     1818                       v-current-char = substring( p-in-string, v-position, 1 )
     1819                   .
     1820                   case v-current-char
     1821                   :
     1822                       when chr(1)
     1823                       then do:
     1824                           assign
