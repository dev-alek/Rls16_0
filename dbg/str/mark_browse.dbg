     1826                           .
     1827                       end.
     1828                       when chr(2)
     1829                       then do:
     1830                           assign
     1831                               p-out-string = p-out-string + " ":U
     1832                           .
     1833                       end.
     1834                       when chr(3)
     1835                       then do:
     1836                           assign
     1837                               p-out-string = p-out-string + " ":U
     1838                           .
     1839                       end.
     1840                       when chr(4)
     1841                       then do:
     1842                           assign
     1843                               p-out-string = p-out-string + " ":U
     1844                           .
     1845                       end.
     1846                       when chr(5)
     1847                       then do:
     1848                           assign
     1849                               p-out-string = p-out-string + " ":U
     1850                           .
     1851                       end.
     1852                       when chr(6)
     1853                       then do:
     1854                           assign
     1855                               p-out-string = p-out-string + " ":U
     1856                           .
     1857                       end.
     1858                       when chr(7)
     1859                       then do:
     1860                           assign
     1861                               p-out-string = p-out-string + " ":U
     1862                           .
     1863                       end.
     1864                       when chr(8)
     1865                       then do:
     1866                           assign
     1867                               p-out-string = p-out-string + " ":U
     1868                           .
     1869                       end.
     1870                       when chr(9)
     1871                       then do:
     1872                           assign
     1873                               p-out-string = p-out-string + " ":U
     1874                           .
     1875                       end.
     1876                       when chr(29)
     1877                       then do:
     1878                           assign
     1879                               p-out-string = p-out-string + " ":U
     1880                           .
     1881                       end.
     1882                       when chr(10)
     1883                       then do:
     1884                           assign
     1885                               p-out-string = p-out-string + " ":U
     1886                           .
     1887                       end.
     1888                       when chr(13)
     1889                       then do:
     1890                           assign
     1891                               p-out-string = p-out-string + " ":U
     1892                           .
     1893                       end.
     1894                       otherwise do:
     1895                           assign
     1896                               p-out-string = p-out-string + v-current-char
     1897                           .
     1898                       end.
     1899                   end case.
     1900               end.
     1901           end.
     1902       end case.
     1903   end.
     1904   end .
     1905   procedure xmlchar-decode :
     1906   define input parameter p-in-string      as character        no-undo.
     1907   define output parameter p-out-string    as character        no-undo.
     1908       define variable v-position      as integer      no-undo.
     1909       define variable v-last-position as integer      no-undo.
     1910       define variable v-temp-integer  as integer      no-undo.
     1911       define variable v-current-char  as character    no-undo.
     1912       define variable v-next-char     as character    no-undo.
     1913       define variable v-success       as logical      no-undo.
     1914   do
     1915   on error undo, return error
     1916   :
     1917       assign
     1918           p-out-string = "":U
     1919           v-position   = 0
     1920       .
     1921       replace-cycle:
     1922       do while yes
     1923       on error undo, return error
     1924       :
     1925           assign
     1926               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1927           .
     1928           if v-last-position <= v-position
     1929           then do:
     1930               if v-position = 0
     1931               then do:
     1932                   assign
     1933                       p-out-string = p-in-string
     1934                   .
     1935               end.
     1936               else do:
     1937                   assign
     1938                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1939                   .
     1940               end.
     1941               leave replace-cycle.
     1942           end.
     1943           else do:
     1944               assign
     1945                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1946                   v-position      = v-last-position
     1947                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1948               .
     1949               if v-current-char = "#":U
     1950               then do:
     1951                   assign
     1952                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1953                   .
     1954                   if v-last-position > 0
     1955                   then do:
     1956                       run xmlchar-read-integer in this-procedure
     1957                        (
     1958                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1959                           , output v-temp-integer
     1960                           , output v-success
     1961                       ).
     1962                       if v-success = yes
     1963                       and v-temp-integer >= 1
     1964                       and v-temp-integer <= 255
     1965                       then do:
     1966                           assign
     1967                               p-out-string = p-out-string + chr( v-temp-integer )
     1968                               v-position   = v-last-position + 1
     1969                           .
     1970                       end.
     1971                       else do:
     1972                           assign
     1973                               p-out-string = p-out-string + "&":U
     1974                               v-position   = v-position   + 1
     1975                           .
     1976                       end.
     1977                   end.
     1978                   else do:
     1979                       assign
     1980                           p-out-string = p-out-string + "&":U
     1981                           v-position   = v-position   + 1
     1982                       .
     1983                   end.
     1984               end.
     1985               else do:
     1986                   case substring( p-in-string, v-position + 1, 3 )
     1987                   :
     1988                       when "lt;":U
     1989                       then do:
     1990                           assign
     1991                               p-out-string = p-out-string + "<":U
     1992                               v-position   = v-position   + 3
     1993                           .
     1994                       end.
     1995                       when "gt;":U
     1996                       then do:
     1997                           assign
     1998                               p-out-string = p-out-string + ">":U
     1999                               v-position   = v-position   + 3
     2000                           .
     2001                       end.
     2002                       otherwise do:
     2003                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2004                           then do:
     2005                               assign
     2006                                   p-out-string = p-out-string + "&":U
     2007                                   v-position   = v-position   + 4
     2008                               .
     2009                           end.
     2010                           else do:
     2011                               case substring( p-in-string, v-position + 1, 5 )
     2012                               :
     2013                                   when "quot;":U
     2014                                   then do:
     2015                                       assign
     2016                                           p-out-string = p-out-string + '"':U
     2017                                           v-position   = v-position   + 5
     2018                                       .
     2019                                   end.
     2020                                   when "apos;":U
     2021                                   then do:
     2022                                       assign
     2023                                           p-out-string = p-out-string + "'":U
     2024                                           v-position   = v-position   + 5
     2025                                       .
     2026                                   end.
     2027                                   otherwise do:
     2028                                       assign
     2029                                           p-out-string = p-out-string + "&":U
     2030                                       .
     2031                                   end.
     2032                               end case.
     2033                           end.
     2034                       end.
     2035                   end case.
     2036               end.
     2037           end.
     2038       end.
     2039   end.
     2040   end .
     2041   procedure xmlchar-read-integer :
     2042   define input parameter p-input-string      as character        no-undo.
     2043   define output parameter p-output-integer   as integer          no-undo.
     2044   define output parameter p-success       as logical          no-undo.
     2045   do
     2046   on error undo, return error
     2047   :
     2048       assign
     2049           p-output-integer = integer( p-input-string )
     2050       no-error.
     2051       if error-status :error
     2052       then do:
     2053           assign
     2054               p-success           = no
     2055               p-output-integer    = 0
     2056           .
     2057       end.
     2058       else do:
     2059           assign
     2060               p-success           = yes
     2061           .
     2062       end.
     2063   end.
     2064   end.
     2065   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2066   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2067   define new global shared variable g#attr-lib  as handle no-undo .
     2068   define variable v-attr-lib-variable as handle no-undo .
     2069   define variable mMRCCode  as logical    no-undo.
     2070   define variable mTypeMark as character  no-undo.
     2071   function IS-NeedMark returns logical
     2072   ( input ib-code as integer  ,
     2073     input ib-str as character ):
     2074      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2075      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2076                                    and buf_prod-bc-attr.b-str  eq ib-str
     2077                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2078        no-lock no-error.
     2079      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2080   end.
     2081   function repTegforDm return char
     2082   (iDM as char ):
     2083       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2084       define variable vteg as character no-undo.
     2085       define variable oDM as character no-undo.
     2086       define variable vi as integer no-undo.
     2087       oDM = iDm.
     2088       do vi = 1 to num-entries(vTeglist):
     2089          vTeg = entry(vi,vTeglist).
     2090          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2091       end.
     2092       return oDM.
     2093   end.
     2094   function repSpecSimbforDm return char
     2095   (iDM as char ):
     2096       define variable oDM as character no-undo.
     2097     run
     2098       xmlchar-decode(iDM, output oDM).
     2099     return repTegforDm (oDM).
     2100   end.
     2101   function CheckGtin return logical
     2102   (iGtin as char):
     2103      define variable bar_code as character no-undo.
     2104      define variable vGtin as logical no-undo init "yes".
     2105      if length(iGtin) eq 14
     2106      then do:
     2107         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2108         run str/chk-sum.p
     2109          (input-output bar_code ) no-error .
     2110         if iGtin ne  bar_code
     2111         then
     2112            vGtin = no.
     2113      end.
     2114      else
     2115         vGtin = no.
     2116      return vgtin.
     2117   end.
     2118   function repSpecSimbforXlm return char
     2119   (iDM as char ):
     2120       iDM = replace(iDM,chr(29),"").
     2121       return iDM.
     2122   end.
     2123   function getGtinByDM return char
     2124   (IDM as char):
     2125      define variable VTXT as char no-undo.
     2126      define variable vGtin as char no-undo.
     2127      vTXt = IdM.
     2128      vGtin = IDM.
     2129      if    length(vtxt) > 14
     2130      then do:
     2131         if   vtxt begins "(01)"
     2132                or vtxt begins "(02)"
     2133         then
     2134            vGtin = substring(vtxt,5,14).
     2135         else if   (vtxt begins "01"
     2136                or vtxt begins "02" )
     2137                and (   (    substring(iDm,17,2) eq "21"
     2138                         and length(vtxt) >= 21)
     2139                     or substring(iDm,17,2) eq "37"
     2140                     or substring(iDm,17,4) eq "(37)" )
     2141         then do:
     2142            vGtin = substring(vtxt,3,14).
     2143            if not checkGtin(vGtin)
     2144            then
     2145               vGtin = substring(vtxt,1,14).
     2146         end.
     2147         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2148             or length(vtxt) eq 14 + 7 + 4
     2149             or length(vtxt) eq 14 + 7
     2150         then
     2151            vGtin = substring(vtxt,1,14).
     2152      end.
     2153      if not checkGtin(vGtin)
     2154      then
     2155         vGtin = "".
     2156      return vgtin.
     2157   end.
     2158   function getGdsCodeByGtin return int
     2159   (iGtin as char):
     2160      define buffer prod-bc  for ub.prod-bc.
     2161      define buffer bar-code for ub.bar-code.
     2162      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2163      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2164      return if avail bar-code then bar-code.gds-code else ?.
     2165   end.
     2166   function getQntyCodeByGtin return decimal
     2167   (iGtin as char):
     2168      define buffer prod-bc  for ub.prod-bc.
     2169      define buffer bar-code for ub.bar-code.
     2170      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2171      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2172      return if avail bar-code then bar-code.cli-base-rate else ?.
     2173   end.
     2174   function getGdsCodeByDM return int
     2175   (iDm as char):
     2176      define variable vGtin as char no-undo.
     2177      define buffer prod-bc for ub.prod-bc.
     2178      vGtin  = getGtinByDM (IDM ).
     2179      return getGdsCodeByGtin (vGtin).
     2180   end.
     2181   function ChekTypeMarkByGds return logical
     2182   (iGds-code as integer ):
     2183      define buffer goods-attr for ub.goods-attr.
     2184      find first goods-attr where goods-attr.gds-code   = iGds-code
     2185                              and goods-attr.attr-code  = 'mark-type':U
     2186      no-lock no-error.
     2187      if available goods-attr
     2188      then do:
     2189         mTypeMark = goods-attr.attr-value.
     2190         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2191           .
     2192      end.
     2193      else
     2194         return no.
     2195   end.
     2196   function ChekTypeMarkByDm return logical
     2197   (iDM as char ):
     2198      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2199   end.
     2200   function ChekTypeMarkByGtin return logical
     2201   (iGtin as char ):
     2202      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2203   end.
     2204   function GetNextElement return character
     2205     (input iAllTeg        as logical
     2206     ,output oteg          as character
     2207     ,output otegval       as character
     2208     ,input-output pstr    as character
     2209      ):
     2210        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2211        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2212        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2213        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2214        define variable vTeg as character no-undo.
     2215        define variable vLength as integer no-undo.
     2216        define variable vi as integer no-undo.
     2217        define variable vj as integer no-undo.
     2218        define buffer code for ub.code.
     2219        find first code where Code.parent eq "MarkType"
     2220                          and Code.CodeValue   eq mTypeMark
     2221                          no-lock no-error.
     2222        if     available code
     2223           and Code.misc1 ne ""
     2224           and Code.misc1 ne ?
     2225        then do:
     2226           integer (Code.misc1) no-error.
     2227           if not error-status:error
     2228           then
     2229             entry (4,vlistleng) = Code.misc1.
     2230        end.
     2231        if iAllTeg
     2232        then
     2233           assign
     2234              vlistElem     = vlistElem    + vlistElemDop
     2235              vlistleng     = vlistleng    + vlistlengDop
     2236           .
     2237        else if mMRCCode
     2238        then
     2239           assign
     2240              vlistElem     = vlistElem    + ",(8005),8005"
     2241              vlistleng     = vlistleng    + ",000006,0006"
     2242           .
     2243       block-elem:
     2244       do vi = 1 to num-entries(vlistElem):
     2245          vTeg = entry(vi,vlistElem).
     2246          if pstr begins vTeg
     2247          then do:
     2248             if    vTeg eq "21"
     2249             then
     2250                vLength = index(pstr,chr(29)) - 2 no-error.
     2251             if vLength  <= 0
     2252             then
     2253                vLength = int(entry(vi,vlistleng)).
     2254             otegval = substring (pstr,length(vteg) + 1, vLength).
     2255             oteg = replace(replace(vteg,")",""),"(","").
     2256             vTeg = vteg + otegval.
     2257             otegval = replace(otegval,chr(29),"").
     2258             oteg = replace(replace(oteg,")",""),"(","").
     2259             pstr = substring (pstr,length(vTeg)+ 1).
     2260             vTeg = replace(vTeg,chr(29),"").
     2261             leave block-elem.
     2262          end.
     2263          else
     2264             vTeg = "".
     2265       end.
     2266       return vteg.
     2267   end.
     2268   function GetCodeIdent return character
     2269   (iDm as char):
     2270      define variable Velement   as character no-undo init "first".
     2271      define variable oCodeIdent as character no-undo.
     2272      define variable vteg as character no-undo.
     2273      define variable vtegval as character no-undo.
     2274      define variable vGtin as character no-undo.
     2275      define buffer marking for ub.marking.
     2276      for first marking no-lock where
     2277                marking.mark eq iDm
     2278            and marking.unit-ext = "LEVEL2"
     2279      :
     2280        return iDm.
     2281      end.
     2282      vGtin  = getGtinByDM (iDm ).
     2283      ChekTypeMarkByDm(idm).
     2284      if iDm begins 'tech_':U
     2285      then
     2286         oCodeIdent = iDm.
     2287      else if length(iDm) < 21
     2288      then do:
     2289         find first marking where marking.mark eq idm
     2290         no-lock no-error.
     2291         oCodeIdent = if available marking then marking.mark else  ?.
     2292      end.
     2293      else if     length(iDm) eq 29
     2294         and not iDm begins "01"
     2295         and not iDm begins "02"
     2296      then
     2297         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2298      else  if     length(iDm) >= 24
     2299               and (  iDm begins "01"
     2300                   or iDm begins "02")
     2301               and  substring(iDm,17,2) ne "21"
     2302      then do:
     2303         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2304                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2305         then
     2306            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2307         else
     2308            oCodeIdent = iDM.
     2309      end.
     2310      else  if     (   length(iDm) eq 25
     2311                    or length(iDm) eq 21)
     2312               and (not iDm begins "01"
     2313               and  not iDm begins "02")
     2314      then
     2315         oCodeIdent = substring(iDm,1,21).
     2316      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2317      then
     2318         oCodeIdent = substring(iDm,1,21).
     2319      else do while Velement ne "" and idm ne "":
     2320         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2321         oCodeIdent = oCodeIdent + Velement.
     2322      end.
     2323      return oCodeIdent.
     2324   end.
     2325   function GetTegCod return character
     2326   (icodeIdent as char, iTeg as char):
     2327      define variable Velement   as character no-undo init "first".
     2328      define variable oTeg as character no-undo init ?.
     2329      define variable vteg as character no-undo.
     2330      define variable vtegval as character no-undo.
     2331      if     ((length(icodeIdent) eq 21
     2332         and not icodeIdent begins "01"
     2333         and not icodeIdent begins "02")
     2334         or
     2335             ( length(icodeIdent) eq 25
     2336               and not icodeIdent begins "01"
     2337               and not icodeIdent begins "02"))
     2338      then do:
     2339         if iTeg eq "01" or iTeg eq "02"
     2340         then
     2341            oTeg = substring(icodeIdent,1,21).
     2342         else  if  iTeg eq "21"
     2343         then
     2344            oTeg = substring(icodeIdent,15,7).
     2345      end.
     2346      else do:
     2347         ChekTypeMarkByDm(icodeIdent).
     2348         block-teg:
     2349            do while Velement ne "" and icodeIdent ne "":
     2350            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2351            if    Velement begins iTeg
     2352               or Velement begins "(" + iTeg + ")"
     2353            then do:
     2354               oTeg = vtegval.
     2355               leave block-teg.
     2356            end.
     2357         end.
     2358      end.
     2359      return oTeg.
     2360   end.
     2361   function isOAD return logical
     2362   (icodeIdent as character):
     2363      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2364   end.
     2365   function isMark return logical
     2366   (icodeIdent as character):
     2367      define buffer buf_marking for ub.marking.
     2368      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2369             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2370   end.
     2371   function addBracketForCode return character
     2372   (icodeIdent as char):
     2373      define variable Velement   as character no-undo init "first".
     2374      define variable oTeg as character no-undo.
     2375      define variable vteg as character no-undo.
     2376      define variable vtegval as character no-undo.
     2377      define buffer marking for ub.marking.
     2378      find first marking no-lock where
     2379                 marking.mark begins icodeIdent no-error.
     2380      if    not ChekTypeMarkByDm(icodeIdent)
     2381         or length(icodeIdent) le 24
     2382         or (avail marking and marking.unit-ext = "LEVEL2")
     2383      then
     2384         oTeg = icodeIdent.
     2385      else do:
     2386         if (  icodeIdent begins "01"
     2387            or icodeIdent begins "02"
     2388            ) and CheckGtin(substring (icodeIdent,3,14))
     2389            and substring (icodeIdent,17,2) eq "21"
     2390         then do:
     2391            mMRCCode = yes.
     2392            ChekTypeMarkByDm(icodeIdent).
     2393            block-teg:
     2394            do while Velement ne "" and icodeIdent ne "":
     2395               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2396               if vteg ne ""
     2397               then
     2398                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2399            end.
     2400            mMRCCode = no.
     2401         end.
     2402         else do:
     2403            oTeg = icodeIdent.
     2404         end.
     2405      end.
     2406      return oTeg.
     2407   end.
     2408   function getlevelByCodId return int
     2409   (iCode as char):
     2410      define variable vLength as int no-undo.
     2411      define variable vLevel  as int no-undo.
     2412      if not ChekTypeMarkByDM (icode) then return ?.
     2413      vLength = length(iCode).
     2414      if    vLength eq 18
     2415         or vLength eq 20
     2416      then
     2417         Vlevel = 4.
     2418      else if vLength eq 21
     2419      then
     2420         Vlevel = 1.
     2421      else if vLength eq 25
     2422      then do:
     2423         if  iCode begins "01"
     2424         then
     2425            Vlevel = 3.
     2426         else
     2427            Vlevel = 1.
     2428      end.
     2429      else if     vLength >= 26
     2430              and vLength <= 46
     2431      then do:
     2432         if    substring(iCode,17,2) eq "11"
     2433            or substring(iCode,17,2) eq "13"
     2434            or (    substring(iCode,17,2) eq "21"
     2435                and vLength >= 33
     2436                and substring(iCode,26,4) ne "8005")
     2437         then
     2438            Vlevel = 4.
     2439         else if    vLength eq 31
     2440                 or vLength eq 38
     2441                 or vLength eq 39
     2442                 or vLength eq 45
     2443         then
     2444            Vlevel = 1.
     2445         else if    vLength eq 35
     2446                 or vLength eq 43
     2447         then
     2448            Vlevel = 3.
     2449         else
     2450            Vlevel = ?.
     2451      end.
     2452      else
     2453         Vlevel = ?.
     2454      return Vlevel.
     2455   end.
     2456   function getLevelMotpBycodid return character
     2457   (iDm as char):
     2458      define variable vLevel as integer no-undo.
     2459      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2460      vLevel = getlevelByCodId(iDm).
     2461      if    vLevel eq ?
     2462         or vLevel < 1
     2463         or vLevel > 6
     2464      then
     2465         return ?.
     2466      else
     2467         return entry(vlevel,vList).
     2468   end.
     2469   function getLevelUTDByLevelMotp return character
     2470   (iUnit as char):
     2471      define variable vLevel as integer no-undo.
     2472      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2473      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2474      vLevel = lookup(iUnit,vListMOTP).
     2475      if    vLevel eq ?
     2476         or vLevel < 1
     2477         or vLevel > 4
     2478      then
     2479         return ?.
     2480      else
     2481         return entry(vlevel,vListutd).
     2482   end.
     2483   function getLevelMotpByDM return character
     2484   (iDm as char):
     2485      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2486   end.
     2487   function getLevelUTDByCodId return character
     2488   (iDm as char):
     2489      define variable vLevel as integer no-undo.
     2490      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2491      vLevel = getlevelByCodId(iDm).
     2492      if    vLevel eq ?
     2493         or vLevel < 1
     2494         or vLevel > 4
     2495      then
     2496         return ?.
     2497      else
     2498         return entry(vlevel,vList).
     2499   end.
     2500   function getLevelUTDByDM return character
     2501   (iDm as char):
     2502      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2503   end.
     2504   define variable mNotMarkQnty as logical no-undo.
     2505   function getQntyUTDByCodId return decimal
     2506   (iDM as char):
     2507      define variable vLevel as integer no-undo.
     2508      define variable vList as character no-undo init "1,5,10,500".
     2509      define variable vGtin as character no-undo.
     2510      define variable vqnty as decimal no-undo init ?.
     2511      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2512      if vqnty eq ?
     2513      then do:
     2514         if not mNotMarkQnty
     2515         then do:
     2516            define buffer marking for ub.marking.
     2517            define variable vCodident as character no-undo.
     2518            vCodident = GetCodeIdent(idm).
     2519            find first marking where marking.mark begins vCodident no-lock no-error.
     2520            if     available marking
     2521               and marking.box-qnty ne ?
     2522            then
     2523               return marking.box-qnty.
     2524         end.
     2525         vGtin = getGtinByDm(iDM).
     2526         if ChekTypeMarkByGtin (vGtin)
     2527         then do:
     2528            vLevel = getlevelByCodId(iDM).
     2529            if     vLevel >= 1
     2530               and vLevel <= 4
     2531            then
     2532               vqnty = int(entry(vlevel,vList)).
     2533         end.
     2534         else
     2535            vqnty = getQntyCodeByGtin(vgtin).
     2536      end.
     2537      return vqnty.
     2538   end.
     2539   function getQntyUTDByDM return decimal
     2540   (iDm as char):
     2541      define variable vDM as character no-undo.
     2542      if     length (iDm) ne 25
     2543         and length (iDm) ne 29
     2544         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2545      then
     2546         vDM = substring (iDm,1,length (iDm) - 6 ).
     2547      else
     2548         vDM = substring (iDm,1,length (iDm) - 4 ).
     2549      return getQntyUTDByCodId(vDM).
     2550   end.
     2551   function getMRC4 return decimal
     2552   (iMRC as char):
     2553      define variable oMrc     as decimal no-undo init ?.
     2554      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2555      define variable vi       as integer no-undo.
     2556      define variable vfound   as integer no-undo.
     2557      define variable vposStart   as integer no-undo.
     2558      do:
     2559      OMRc = 0.
     2560      do vi = 1 to 4:
     2561         define variable vsimb as character no-undo.
     2562         vsimb = substring(iMRC,vi,1).
     2563         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2564         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2565         if vfound > 0
     2566         then
     2567            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2568         end.
     2569         OMRc = OMRc / 100.
     2570      end.
     2571      return OMRc.
     2572   end.
     2573   function getMRCByDM return decimal
     2574   (iDm as char):
     2575      define variable vMRC     as character no-undo.
     2576      define variable oMrc     as decimal no-undo init ?.
     2577      define variable Velement as character no-undo init "empty".
     2578      define variable vteg as character no-undo.
     2579      define variable vtegval as character no-undo.
     2580      if    length(idm) eq 14 + 7 + 4 + 4
     2581         or length(idm) eq 14 + 7 + 4
     2582      then do:
     2583         vMRC = substring(idm,22,4).
     2584         omrc = getMRC4(vMRC).
     2585      end.
     2586      else do:
     2587          ChekTypeMarkByDm(iDm).
     2588          block-mrc:
     2589          do while Velement ne "" and idm ne "":
     2590             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2591             if Velement begins "8005"
     2592             then do:
     2593                vMRC = substring(Velement,5,6).
     2594                leave block-mrc.
     2595             end.
     2596             else if Velement begins "(8005)"
     2597             then do:
     2598                vMRC = substring(Velement,7,6).
     2599                leave block-mrc.
     2600             end.
     2601          end.
     2602          if vMRC ne ""
     2603          then
     2604             OMRc = dec(vmrc) / 100 no-error.
     2605      end.
     2606      return OMRc.
     2607   end.
     2608   function MoveDate return Date
     2609   (idate as date,
     2610    iMonth as int64):
     2611      define variable vMonth   as int64 no-undo.
     2612      define variable vYear    as int64 no-undo.
     2613      define variable vDateNew as date  no-undo.
     2614       define variable vDay     as int64 no-undo.
     2615       vMonth = month(iDate) + iMonth.
     2616       vYear =  year(iDate).
     2617       if vMonth <= 0
     2618       then assign
     2619          vMonth = vMonth + 12
     2620           vYear  = vYear - 1
     2621       .
     2622       else if vMonth > 12
     2623       then assign
     2624          vMonth = vMonth - 12
     2625           vYear  = vYear + 1
     2626       .
     2627       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2628       do while error-status:error eq yes:
     2629          VDay = vDay + 1.
     2630          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2631       end.
     2632       if VDay > 0
     2633       then
     2634          vDateNew + 1.
     2635       return vDateNew.
     2636   end.
     2637   procedure checkEMRC:
     2638   define input  parameter iDm as character no-undo.
     2639   define output parameter vok as logical   no-undo init yes.
     2640      define variable v-value-emrc as character no-undo.
     2641      define variable v-type-emrc  as character no-undo.
     2642      define variable vDateIso     as character no-undo.
     2643      define variable vMRC         as decimal no-undo.
     2644      define variable vqnty        as decimal no-undo.
     2645      define variable vPrice       as decimal no-undo.
     2646      define variable vparent      as character no-undo.
     2647      define variable vgds-code    as integer no-undo.
     2648      define buffer code for ub.code.
     2649      vMRC = getMRCByDM(iDm).
     2650      if vMRC > 0
     2651      then do:
     2652         vgds-code = getGdsCodeByDM(iDm).
     2653         vqnty     = getQntyUTDByDM(iDm).
     2654               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2655            (
     2656             input   vgds-code
     2657            ,input   'emrc-type':U
     2658            ,output   v-value-emrc
     2659            ,output   v-type-emrc
     2660          ) no-error.
     2661          if     v-value-emrc ne ""
     2662             and v-value-emrc ne ?
     2663          then do:
     2664             vDateIso = iso-date(today).
     2665             vPrice = vMRC / vqnty.
     2666             vparent ="emc" + chr(4) + v-value-emrc.
     2667             find last code where Code.parent      eq vparent
     2668                              and Code.code        le vDateIso
     2669                              and code.status_  eq 0
     2670             no-lock no-error.
     2671             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2672             then
     2673                vOk = true .
     2674             else do:
     2675                 define variable vText      as character no-undo.
     2676                 define variable vDate      as date no-undo.
     2677                 define variable vDateLast  as character no-undo.
     2678                 define variable vDateFirst as character no-undo.
     2679                 define variable vDate3     as date no-undo.
     2680                 vdate = date(code.misc1).
     2681                 vDateLast = code.misc1.
     2682                 vDate3 = MoveDate(today, - 3 ).
     2683                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2684                                      string(vDate3  , "99/99/9999"),
     2685                                      string(vDate   , "99/99/9999")
     2686                                      ).
     2687                 vdateIso = iso-date(vdate3).
     2688                 find last code  where Code.parent      eq vparent
     2689                                   and Code.code        le vDateIso
     2690                                   and code.status_  eq 0 no-lock no-error.
     2691                 if available code
     2692                 then
     2693                    vDateIso = code.code.
     2694                 vDateFirst = vDateIso.
     2695                 vDateLast = iso-date(vdate).
     2696                 define variable vGood as logical no-undo.
     2697                 define variable vDateSale as date no-undo.
     2698                 define buffer bcode for code.
     2699                 for last code where Code.parent   eq vparent
     2700                                 and code.status_  eq 0
     2701                                 and code.code     < vDateLast
     2702                                 and code.code     >= vDateFirst
     2703                 no-lock:
     2704                    find first bcode where bCode.parent   eq vparent
     2705                                       and bcode.status_  eq 0
     2706                                       and bcode.code     > code.code no-lock no-error.
     2707                    if available bcode
     2708                    then do:
     2709                       if vPrice < dec(Code.CodeValue)
     2710                       then
     2711                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2712                                                     chr(10),
     2713                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2714                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2715                                                     ).
     2716                       else do:
     2717                          vGood = yes.
     2718                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2719                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2720                                                     chr(10),
     2721                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2722                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2723                                                     string(         vDateSale            ,"99/99/9999"),
     2724                                                     string(vDateSale - today)
     2725                                                     ).
     2726                       end.
     2727                    end.
     2728                 end.
     2729                 if vgood
     2730                 then do:
     2731                    define variable choice as integer no-undo .
     2732                    run gbl/d-askw.w (input "Уточнение"
     2733                           ,input  vText
     2734                           ,input "|"
     2735                           ,input "Принять|Вернуть"
     2736                           ,input "Принять данный товар|Вернуть товар постащику"
     2737                           ,input 1
     2738                           ,input 2
     2739                           ,output choice) no-error.
     2740                    vok = choice eq 1.
     2741                 end.
     2742                 else
     2743                    vok =false.
     2744             end.
     2745          end.
     2746      end.
     2747   end.
     2748   function addGs2Mark return character
     2749   (iMark as char):
     2750      define variable vDM   as character no-undo.
     2751      define variable vIdx  as integer   no-undo.
     2752      if index(iMark,chr(29),1) > 0
     2753      then return iMark.
     2754      if substring(iMark,26,4) = "8005" then
     2755      do:
     2756        vIdx = index(iMark,"93",26 + 4 + 5).
     2757        if vIdx > 1 then do:
     2758          vDM = substitute("&1&4&2&4&3",
     2759                           substring(iMark,1,25),
     2760                           substring(iMark,26,vIdx - 25 - 1),
     2761                           substring(iMark,vIdx),
     2762                           chr(29)) no-error.
     2763          vIdx = index(vDm,"240",vIdx + 4).
     2764          if vIdx > 0 then
     2765          do:
     2766            vDM = substitute("&1&3&2",
     2767                             substring(vDm,1,vIdx - 1),
     2768                             substring(vDm,vIdx),
     2769                             chr(29)) no-error.
     2770          end.
     2771        end.
     2772        else
     2773          vDM = substitute("&1&3&2",
     2774                           substring(iMark,1,25),
     2775                           substring(iMark,26),
     2776                           chr(29)) no-error.
     2777      end.
     2778      else if substring(iMark,32,2) = "91" then
     2779      do:
     2780        vIdx = index(iMark,"92",32).
     2781        if vIdx > 1 then
     2782          vDM = substitute("&1&4&2&4&3",
     2783                           substring(iMark,1,31),
     2784                           substring(iMark,32,vIdx - 31 - 1),
     2785                           substring(iMark,vIdx),
     2786                           chr(29)) no-error.
     2787        else
     2788          vDM = substitute("&1&3&2",
     2789                           substring(iMark,1,31),
     2790                           substring(iMark,32),
     2791                           chr(29)) no-error.
     2792      end.
     2793      else if substring(iMark,39,2) = "91" then
     2794      do:
     2795        vIdx = index(iMark,"92",38).
     2796        if vIdx > 1 then
     2797          vDM = substitute("&1&4&2&4&3",
     2798                           substring(iMark,1,38),
     2799                           substring(iMark,39,vIdx - 38 - 1),
     2800                           substring(iMark,vIdx),
     2801                           chr(29)) no-error.
     2802        else
     2803          vDM = substitute("&1&3&2",
     2804                           substring(iMark,1,38),
     2805                           substring(iMark,39),
     2806                           chr(29)) no-error.
     2807      end.
     2808      else if substring(iMark,25,2) = "93" then
     2809      do:
     2810        vIdx = index(iMark,"92",25).
     2811        if vIdx > 1 then
     2812          vDM = substitute("&1&4&2&4&3",
     2813                           substring(iMark,1,24),
     2814                           substring(iMark,25,vIdx - 24 - 1),
     2815                           substring(iMark,vIdx),
     2816                           chr(29)) no-error.
     2817        else
     2818          vIdx = index(iMark,"3103",25).
     2819          if vIdx > 0 then
     2820          vDM = substitute("&1&4&2&4&3",
     2821                           substring(iMark,1,24),
     2822                           substring(iMark,25,vIdx - 24 - 1),
     2823                           substring(iMark,vIdx),
     2824                           chr(29)) no-error.
     2825          else
     2826            vDM = substitute("&1&3&2",
     2827                             substring(iMark,1,24),
     2828                             substring(iMark,25),
     2829                             chr(29)) no-error.
     2830      end.
     2831      else if substring(iMark,32,2) = "93" then
     2832      do:
     2833        vDM = substitute("&1&3&2",
     2834              substring(iMark,1,31),
     2835              substring(iMark,32),
     2836              chr(29)) no-error.
     2837      end.
     2838      return if vDM <> "" then vDm else iMark.
     2839   end.
     2840   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2841   function getattrUtdex returns char
     2842   (idb-num   as integer,
     2843    idoc-id   as integer,
     2844    iattrcode as character,
     2845    iExValue  as character  ):
     2846      define buffer utd-attr for utd-attr.
     2847      find first utd-attr where utd-attr.db-num eq idb-num
     2848                            and utd-attr.doc-id eq idoc-id
     2849                            and utd-attr.attr-code eq iattrcode
     2850      no-lock no-error.
     2851      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2852   end.
     2853   function getattrUtd returns char
     2854   (idb-num   as integer,
     2855    idoc-id   as integer,
     2856    iattrcode as character ):
     2857     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2858   end.
     2859   function setattrUtd returns logical
     2860   (idb-num   as integer,
     2861    idoc-id   as integer,
     2862    iattrcode as character,
     2863    iattrval  as character ):
     2864      define buffer utd-attr for utd-attr.
     2865      find first utd-attr where utd-attr.db-num eq idb-num
     2866                            and utd-attr.doc-id eq idoc-id
     2867                            and utd-attr.attr-code eq iattrcode
     2868      no-lock no-error.
     2869      if not available utd-attr
     2870      then do:
     2871         create utd-attr.
     2872         assign
     2873            utd-attr.db-num    = idb-num
     2874            utd-attr.doc-id    = idoc-id
     2875            utd-attr.attr-code = iattrcode
     2876            utd-attr.attr-value = iattrval
     2877         .
     2878      end.
     2879      else do:
     2880         if utd-attr.attr-value ne iattrval
     2881         then do:
     2882            find current utd-attr exclusive-lock no-error.
     2883            if available utd-attr
     2884            then
     2885               utd-attr.attr-value = iattrval.
     2886         end.
     2887      end.
     2888      release utd-attr.
     2889   end.
     2890   function GetAttrUtdlinesEx returns char
     2891   (idb-num   as integer,
     2892    idoc-id   as integer,
     2893    ilinenum  as integer,
     2894    iattrcode as character,
     2895    iExValue  as character  ):
     2896      define buffer utd-lines-attr for utd-lines-attr.
     2897      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2898                                  and utd-lines-attr.doc-id    eq idoc-id
     2899                                  and utd-lines-attr.lineNum   eq ilineNum
     2900                                  and utd-lines-attr.attr-code eq iattrcode
     2901      no-lock no-error.
     2902      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2903   end.
     2904   function GetAttrUtdlines returns char
     2905   (idb-num   as integer,
     2906    idoc-id   as integer,
     2907    ilinenum  as integer,
     2908    iattrcode as character ):
     2909      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2910   end.
     2911   function setattrUtdlines returns logical
     2912   (idb-num   as integer,
     2913    idoc-id   as integer,
     2914    ilinenum  as integer,
     2915    iattrcode as character,
     2916    iattrval  as character ):
     2917      define buffer utd-lines-attr for utd-lines-attr.
     2918      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2919                                  and utd-lines-attr.doc-id    eq idoc-id
     2920                                  and utd-lines-attr.lineNum   eq ilineNum
     2921                                  and utd-lines-attr.attr-code eq iattrcode
     2922      no-lock no-error.
     2923      if not available utd-lines-attr
     2924      then do:
     2925         if iattrval ne ?
     2926            and iattrval ne ""
     2927         then do:
     2928            create utd-lines-attr.
     2929            assign
     2930               utd-lines-attr.db-num    = idb-num
     2931               utd-lines-attr.doc-id    = idoc-id
     2932               utd-lines-attr.lineNum   = ilineNum
     2933               utd-lines-attr.attr-code = iattrcode
     2934               utd-lines-attr.attr-value = iattrval
     2935            .
     2936         end.
     2937      end.
     2938      else do:
     2939         if utd-lines-attr.attr-value ne iattrval
     2940         then do:
     2941            find current utd-lines-attr exclusive-lock no-error.
     2942            if available utd-lines-attr
     2943            then do:
     2944               if    iattrval eq ?
     2945                  or iattrval eq ""
     2946               then do:
     2947                  delete utd-lines-attr.
     2948               end.
     2949               else do:
     2950                  utd-lines-attr.attr-value = iattrval.
     2951               end.
     2952            end.
     2953         end.
     2954      end.
     2955      release utd-lines-attr.
     2956   end.
     2957   function GetAttrUtdMarkingLinesEx returns char
     2958   (idb-num   as integer,
     2959    idoc-id   as integer,
     2960    ilinenum  as integer,
     2961    imark     as character,
