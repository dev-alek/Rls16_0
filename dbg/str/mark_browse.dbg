     4646                       do:
     4647                           X_marking.gds-code:fGCOLOR in browse br-mark = red_COLOR.
     4648                           X_marking.gds-name:fGCOLOR in browse br-mark = red_COLOR.
     4649                           X_marking.mark:fGCOLOR in browse br-mark = red_COLOR.
     4650                           X_marking.box-qnty:fGCOLOR in browse br-mark = red_COLOR.
     4651                           X_marking.weight:fGCOLOR in browse br-mark = red_COLOR.
     4652                           X_marking.unit:fGCOLOR in browse br-mark = red_COLOR.
     4653                           X_marking.stts:fGCOLOR in browse br-mark = red_COLOR.
     4654                           typem:fGCOLOR in browse br-mark = red_COLOR.
     4655                       end.
     4656               end case.
     4657           end.
     4658       END .
