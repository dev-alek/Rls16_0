        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения соответствия ТРК танку":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer bf_cli    for ub.clients.
      113   define buffer bf_place  for ub.place.
      114   define buffer bf_pl-gds for ub.pl-gds.
      115   define buffer bf_goods  for ub.goods.
      116   define buffer bf_pump   for ub.pump.
      117   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      118   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      119   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      120   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      121   define frame fr-D-pump-8
      122     ub.c-pl-pump.pl-code    at row  1.25 col 11.00 colon-aligned view-as fill-in size-chars 10.50 by 1.00    label "Танк"
      123     bf_place.pl-name    at row  1.25 col 24.00          view-as fill-in size-chars 61.50 by 1.00 no-label            fgcolor  4
      124     ub.c-pl-pump.pump-code  at row  2.50 col 11.00 colon-aligned view-as fill-in size-chars  3.50 by 1.00                     fgcolor  4
      125       bf_pump.status_   at row  2.50 col 24.00          view-as fill-in size-chars  9.50 by 1.00
      126     ub.c-pl-pump.obj-type   at row  3.75 col 11.00 colon-aligned view-as fill-in size-chars  4.50 by 1.00    label "Объект"
      127     ub.c-pl-pump.obj-code   at row  3.75 col 18.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      128       bf_cli.obj-name   at row  3.75 col 29.00          view-as fill-in size-chars 70.00 by 1.00 no-label            fgcolor  4
      129     ub.c-pl-pump.status_    at row  5.00 col 11.00 colon-aligned view-as fill-in size-chars  9.50 by 1.00
      130     ub.c-pl-pump.PS         at row  6.50 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars 98.25 by 3.50 format "x(512)":U                no-label            bgcolor 15
      131     bf_goods.gds-name   at row 10.50 col 11.00 colon-aligned view-as fill-in size-chars 49.50 by 1.00    label "Топливо"  fgcolor  4
      132     bf_pl-gds.status_   at row 10.50 col 63.00          view-as fill-in size-chars  9.50 by 1.00                     fgcolor  4
      133     bf_pl-gds.fact-qnty at row 12.00 col 11.00 colon-aligned view-as fill-in size-chars 16.50 by 1.00    label "Факт"     fgcolor 12
      134     bf_pl-gds.free-qnty at row 12.00 col 33.00          view-as fill-in size-chars 16.50 by 1.00    label "Свободно" fgcolor 12
      135     bf_pl-gds.tolerance at row 12.00 col 63.00          view-as fill-in size-chars 13.50 by 1.00                     fgcolor 12
      136     r-rect-0            at row 13.50 col  1.50
      137       Btn_Exit          at row 13.75 col  2.50
      138       Btn_OK            at row 13.75 col 78.00
      139     b-help         at row 13.75 col 88.75
      140   with view-as dialog-box side-labels no-underline three-d scrollable
      141        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      142   assign frame fr-D-pump-8 :scrollable = no.
      143   on choose of Btn_OK in frame fr-D-pump-8 do:
      144   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   if lookup(self :type
      146            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      147            ) = 0
      148   then do:
      149     message
      150       "$Workfile$"
      151       "Указанному интерфейсному элементу фокус не может быть передан" skip
      152       "Интерфейсный элемент" self :name  skip
      153       "Тип" self :type  skip
      154       "Процедура" this-procedure :file-name skip
      155       view-as alert-box .
      156   end.
      157   else do:
      158     apply "entry":u to self  .
      159     if focus :handle <> self :handle  then do:
      160       return no-apply .
      161     end.
      162   end.
      163     apply "GO":U to frame fr-D-pump-8.
      164   end.
      165   on choose of Btn_Exit in frame fr-D-pump-8 do:
      166   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   if lookup(self :type
      168            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      169            ) = 0
      170   then do:
      171     message
      172       "$Workfile$"
      173       "Указанному интерфейсному элементу фокус не может быть передан" skip
      174       "Интерфейсный элемент" self :name  skip
      175       "Тип" self :type  skip
      176       "Процедура" this-procedure :file-name skip
      177       view-as alert-box .
      178   end.
      179   else do:
      180     apply "entry":u to self  .
      181     if focus :handle <> self :handle  then do:
      182       return no-apply .
      183     end.
      184   end.
      185   end.
      186   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   on F1 of frame fr-D-pump-8 anywhere do:
      188     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      189     return no-apply.
      190   end.
      191   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      192   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      193   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      194   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   on help of frame fr-D-pump-8
      196   do:
      197     run gbl/app_help.p
      198       (input this-procedure :file-name
      199       ,input ''
      200       ,input ?
      201       ) no-error.
      202     if error-status :error then do:
      203       message
      204         "Ошибка при вызове помощи"
      205         error-status :get-message(1)
      206         view-as alert-box .
      207     end.
      208   end.
      209   run minbtn-set in this-procedure .
      210   on choose of b-help in frame fr-D-pump-8
      211   do:
      212     apply "help":u to frame fr-D-pump-8 .
      213   end.
      214   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   procedure minbtn-set :
      216       do
      217           on error undo, return error return-value
      218           :
      219           define variable ii              as integer       no-undo .
      220           define variable fh              as widget-handle no-undo .
      221           define variable hh              as widget-handle no-undo .
      222           define variable v-h             as handle        extent 4 no-undo .
      223           define variable v-name-button   as character     no-undo .
      224           define variable v-help-old-x    as decimal       no-undo .
      225           define variable v-help-old-y    as decimal       no-undo .
      226           define variable v-help-old-size as decimal       no-undo .
      227           define variable v-frame-width   as decimal       no-undo .
      228           define variable jj              as integer       no-undo .
      229           do
      230               on error undo, return error
      231               :
      232               assign
      233                   v-frame-width = frame fr-D-pump-8:width - 0.3
      234                   fh            = frame fr-D-pump-8:first-child
      235                   hh            = fh:first-child
      236                   ii            = 1
      237                   .
      238               do while valid-handle(hh):
      239                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      240                   do:
      241                       case lc(hh:name) :
      242                           when "b-help" then
      243                               do:
      244                                   hh:load-image-up("cmp/b-help.bmp":u) .
      245                                   hh:load-image-down("cmp/b-help.bmp":u) .
      246                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      247                                   hh:TOOLTIP = "Помощь" .
      248                                   v-help-old-x = hh:column .
      249                                   v-help-old-y = hh:row    .
      250                                   v-help-old-size = hh:width .
      251                                   hh:width-chars = 2.5 .
      252                               end.
      253                           when "b-print" then
      254                               do:
      255                                   hh:load-image("cmp/b-print.bmp":u) .
      256                                   hh:TOOLTIP = "Печать" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-history" or
      262                           when "b-hist" then
      263                               do:
      264                                   hh:load-image("cmp/b-hist.bmp":u) .
      265                                   hh:TOOLTIP = "История" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-sch" then
      271                               do:
      272                                   hh:load-image("cmp/b-sch.bmp":u) .
      273                                   hh:TOOLTIP = "Установка Фильтра" .
      274                                   v-h[ii] = hh:handle .
      275                                   ii = ii + 1 .
      276                                   hh:width-chars = 3 .
      277                               end.
      278                           when "b-hist-user" then
      279                               do:
      280                                   hh:load-image("cmp/b-hist.bmp":u) .
      281                                   hh:TOOLTIP = "История пользователя" .
      282                                   ii = ii + 1 .
      283                               end.
      284                       end case.
      285                   end.
      286                   hh = hh:next-sibling.
      287               end.
      288               b-help:column = v-frame-width - b-help:width-chars.
      289               jj = 0.
      290               repeat ii = 4 to 1 by -1 :
      291                   if valid-handle (v-h[ii] ) then
      292                   do:
      293                       jj  = jj + 1 .
      294                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      295                       v-h[ii]:row    = v-help-old-y .
      296                   end.
      297               end.
      298           end.
      299       end.
      300   end procedure.
      301   Main-Block:
      302   do on error   undo Main-Block, leave Main-Block
      303      on end-key undo Main-Block, leave Main-Block :
      304     if p-mode <> 'ПРОСМОТР':U then do:
      305       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      306               "Неверное значение параметра вызова p-mode:" p-mode
      307       view-as alert-box error.
      308       undo Main-Block, return error.
      309     end.
      310     find ub.c-pl-pump no-lock where recid( ub.c-pl-pump ) = p-rec-id no-error.
      311     if not available ub.c-pl-pump then do:
      312       message "Карточка истории соответствия ТРК танку не найдена!" view-as alert-box error.
      313       undo Main-Block, leave Main-Block.
      314     end.
      315     find bf_place no-lock where
      316          bf_place.obj-type = ub.c-pl-pump.obj-type and
      317          bf_place.obj-code = ub.c-pl-pump.obj-code and
      318          bf_place.pl-code  = ub.c-pl-pump.pl-code  no-error.
      319     find bf_cli   no-lock where
      320          bf_cli.obj-type   = ub.c-pl-pump.obj-type and
      321          bf_cli.obj-code   = ub.c-pl-pump.obj-code no-error.
      322     assign frame fr-D-pump-8 :title = substitute(
      323       'Карточка изменения соответствия ТРК &1 танку &2 (объект &3 &4 "&5") -- &6',
      324       ub.c-pl-pump.pump-code, ub.c-pl-pump.pl-code, ub.c-pl-pump.obj-type, ub.c-pl-pump.obj-code, bf_cli.obj-name, p-mode ).
      325     display ub.c-pl-pump.pl-code
      326             ub.c-pl-pump.pump-code
      327             ub.c-pl-pump.obj-type
      328             ub.c-pl-pump.obj-code
      329             ub.c-pl-pump.status_
      330             ub.c-pl-pump.PS
      331     with frame fr-D-pump-8.
      332     if available bf_cli   then do: display bf_cli.obj-name  with frame fr-D-pump-8. end.
      333     if available bf_place then do: display bf_place.pl-name with frame fr-D-pump-8. end.
      334     find first bf_pl-gds no-lock where
      335                bf_pl-gds.obj-type = ub.c-pl-pump.obj-type and
      336                bf_pl-gds.obj-code = ub.c-pl-pump.obj-code and
      337                bf_pl-gds.pl-code  = ub.c-pl-pump.pl-code  no-error.
      338     if available bf_pl-gds then do:
      339       display bf_pl-gds.status_
      340               bf_pl-gds.fact-qnty
      341               bf_pl-gds.free-qnty
      342               bf_pl-gds.tolerance
      343       with frame fr-D-pump-8.
      344       find first bf_goods no-lock where bf_goods.gds-code = bf_pl-gds.gds-code no-error.
      345       if available bf_goods then do:
      346         display bf_goods.gds-name with frame fr-D-pump-8.
      347       end.
      348       else do:
      349         hide bf_goods.gds-name in frame fr-D-pump-8.
      350       end.
      351     end.
      352     else do:
      353       hide bf_pl-gds.status_   in frame fr-D-pump-8
      354            bf_pl-gds.fact-qnty in frame fr-D-pump-8
      355            bf_pl-gds.free-qnty in frame fr-D-pump-8
      356            bf_pl-gds.tolerance in frame fr-D-pump-8
      357            bf_goods.gds-name   in frame fr-D-pump-8.
      358     end.
      359     find first bf_pump no-lock where
      360                bf_pump.obj-type  = ub.c-pl-pump.obj-type  and
      361                bf_pump.obj-code  = ub.c-pl-pump.obj-code  and
      362                bf_pump.pump-code = ub.c-pl-pump.pump-code no-error.
      363     if available bf_pump then do: display bf_pump.status_ with frame fr-D-pump-8. end.
      364     enable ub.c-pl-pump.PS Btn_Exit b-help with frame fr-D-pump-8.
      365     assign ub.c-pl-pump.PS :read-only in frame fr-D-pump-8 = yes.
      366     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      367     wait-for go of frame fr-D-pump-8.
      368   end.
      369   hide frame fr-D-pump-8 no-pause.
