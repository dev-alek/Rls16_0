     1949       and v-corr-user-db-num  <> g#db-num )
     1950       or
     1951       (g#news
     1952        and  g#db-num = 0
     1953        and v-corr-user-db-num <> g#news-source-db
     1954        )
     1955       then do:
     1956         return '':U.
     1957       end.
     1958       assign
