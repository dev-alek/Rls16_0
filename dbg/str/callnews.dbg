     3338         run nws/lob-e.p (
     3339           input p-tbl-handle
     3340           ,input '':U
     3341           ) no-error .
     3342       end.
     3343       else do:
     3344         if list-db-for-send <> '':U then do:
     3345           run nws/lob-e.p (
     3346             input p-tbl-handle
     3347           ,input list-db-for-send
     3348             ) no-error .
     3349         end.
     3350       end.
     3351     end.
     3352     else do:
     3353       if list-db-for-send <> "":U then do:
     3354         run nws/cr-route.p ( input 'send-tbl':U, input p-tbl-name, input p-tbl-handle, input list-db-for-send ) no-error.
     3355         if error-status :error then do:
     3356           return error return-value.
     3357         end.
     3358       end.
     3359     end.
