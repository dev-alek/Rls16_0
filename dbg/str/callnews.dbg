     2010             and buf_hist-nws-option.table-name = v-tbl-name-prim
     2011             and buf_hist-nws-option.get-hist-from-nws >= 0
     2012             and buf_hist-nws-option.charkey_one = '':U
     2013             and buf_hist-nws-option.key#_one = 0
     2014         on error  undo,  return  error :
     2015           assign list-remote-db-wsd = list-remote-db-wsd + chr(1) + string(buf_hist-nws-option.db-num).
     2016           if buf_hist-nws-option.db-num <> g#news-source-db then
     2017           do on error undo, return error return-value :
     2018             assign list-remote-db = list-remote-db + chr(1) + string(buf_hist-nws-option.db-num).
     2019           end.
     2020         end.
     2021       end.
     2022       else do:
     2023         for each buf_db where buf_db.db-num > 0 no-lock
     2024         on error  undo,  return  error :
     2025           assign list-remote-db-wsd = list-remote-db-wsd + chr(1) + string(buf_db.db-num).
     2026           if buf_db.db-num <> g#news-source-db then
     2027           do on error undo, return error return-value :
     2028             assign list-remote-db = list-remote-db + chr(1) + string(buf_db.db-num).
     2029             if buf_db.remote-stock = yes then
