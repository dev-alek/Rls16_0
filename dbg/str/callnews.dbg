     2048      v-obj-type = p-tbl-handle:buffer-field("obj-type"):buffer-value.
     2049      v-obj-code = p-tbl-handle:buffer-field("obj-code"):buffer-value.
     2050      if (v-obj-type = "" and v-obj-code = 0) or v-obj-type = 'регион':U then do:
     2051          assign list-db-for-send = list-remote-db-wsd.
     2052      end.
     2053      else do:
     2054          if v-obj-type = 'БД':U then do:
     2055              if v-obj-code > 0 then
     2056                  assign list-db-for-send = string(v-obj-code).
     2057              else
     2058                  assign list-db-for-send = "".
     2059          end.
     2060          else do:
     2061              find first buf_clients no-lock
     2062                  where buf_clients.obj-type = v-obj-type
     2063                    and buf_clients.obj-code = v-obj-code no-error.
     2064              if available buf_clients then do:
     2065                  assign list-db-for-send = string(buf_clients.db-num).
     2066                  if list-db-for-send = "0" then assign list-db-for-send = "".
     2067              end.
