     3317         "Ошибка задания входных параметров" skip
     3318         "Программа вызвана из" program-name(2)  skip
     3319         "" program-name(3)  skip
     3320         "" program-name(4)  skip
     3321         "Неизвестное имя таблицы" skip
     3322         "Имя таблицы" p-tbl-name  skip
     3323         "Код записи (rowid)" string(v-tbl-row)   skip
     3324         view-as alert-box error .
     3325       undo, return error .
     3326     end.
     3327     if v-found <> TRUE and not can-do(v-custom-except-list, v-tbl-name)
     3328     and (v-has-subject
     3329        and v-tbl-name-prim <> '') then do:
     3330       return ''.
     3331     end.
     3332     if v-routing-type = 'LOB':U
     3333     then do:
