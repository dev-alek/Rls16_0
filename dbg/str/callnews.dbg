     2040         .
     2041      end.
     2042   if p-tbl-name = 'db':U and g#db-num = 0 and not g#news then do:
     2043      assign list-db-for-send = string(p-tbl-handle:buffer-field("db-num"):buffer-value).
     2044      if list-db-for-send = "0" then assign list-db-for-send = "".
     2045      assign v-found = yes.
