     1127   ":U.
     1128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   define new global shared variable g#lib-nws as handle no-undo .
     1130   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   procedure gen-key-rec :
     1132     define input  parameter p-tbl-name    as character no-undo.
     1133     define input  parameter p-bh_tbl-name as handle    no-undo.
     1134     define output parameter p-key-rec     as character no-undo.
     1135     do
     1136     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1137     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1138     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1139     :
     1140       define variable fh               as handle    no-undo .
     1141       define variable v-ok             as logical   no-undo .
     1142       define variable v-inform         as character no-undo .
     1143       define variable v-ind            as integer   no-undo .
     1144       define variable v-idx-field-qnty as integer   no-undo .
     1145       if p-tbl-name = ?
     1146         or p-tbl-name = "":U
     1147       then do:
     1148         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
     1149       end.
     1150       if not p-bh_tbl-name:available then do:
     1151         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
     1152       end.
     1153       assign
     1154         p-key-rec = p-tbl-name
     1155         v-inform  = p-bh_tbl-name:index-information(1)
     1156         v-ind     = 2
     1157       .
     1158       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1159       on error undo, return error
     1160       :
     1161         assign
     1162           v-inform = p-bh_tbl-name:index-information( v-ind )
     1163           v-ind    = v-ind + 1
     1164         .
     1165       end.
     1166       if v-inform = ?
     1167         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1168         or entry( 3, v-inform, ",":U ) <> "1":U
     1169       then do:
     1170         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
     1171       end.
     1172       else do:
     1173         assign
     1174           v-idx-field-qnty = num-entries( v-inform ) - 4
     1175         .
     1176         if v-idx-field-qnty < 2 then do:
     1177           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
     1178         end.
     1179         do v-ind = 1 to v-idx-field-qnty by 2
     1180         on error undo, return error
     1181         :
     1182           assign
     1183             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1184             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1185           .
     1186         end.
     1187       end.
     1188       if p-key-rec = ? then do:
     1189         assign
     1190           p-key-rec = "":U
     1191         .
     1192         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
     1193       end.
     1194     end.
     1195     return.
     1196   end procedure.
     1197   procedure gen-where-keyr-tab :
     1198     define input  parameter i-tableSerach as character no-undo.
     1199     define input  parameter i-tablekey   as character  no-undo.
     1200     define input  parameter p-key-rec    as character  no-undo.
     1201     define input  parameter p-key-handle as handle     no-undo .
     1202     define input  parameter p-db-name    as character  no-undo .
     1203     define input  parameter p-tt-handle  as handle     no-undo .
     1204     define output parameter o-Where      as character  no-undo.
     1205     do
     1206     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1207     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1208     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1209     :
     1210       define variable v-full-tbl-name  as character no-undo .
     1211       define variable bh_tbl-name      as handle    no-undo .
     1212       define variable fh_key           as handle    no-undo .
     1213       define variable fh_search        as handle    no-undo .
     1214       define variable v-field-num      as integer   no-undo .
     1215       define variable v-count-fld      as integer   no-undo .
     1216       define variable v-inform         as character no-undo .
     1217       define variable v-ind            as integer   no-undo .
     1218       define variable v-idx-field-qnty as integer   no-undo .
     1219       define variable v-field-name     as character no-undo .
     1220       define variable v-field-val      as character no-undo .
     1221       define variable v-word-link      as character no-undo .
     1222       define variable vTable           as character no-undo.
     1223       define variable bh_tbl-key       as handle    no-undo .
     1224       assign
     1225         p-key-rec = trim( p-key-rec )
     1226       .
     1227       if p-key-handle <> ? then do:
     1228         if not valid-handle(p-key-handle)
     1229            or p-key-handle:type <> "buffer"
     1230         then do:
     1231           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
     1232         end.
     1233         if num-entries( p-key-rec, chr(3) ) > 1
     1234           or p-key-rec = ?
     1235           or p-key-rec = "":U
     1236         then do:
     1237           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
     1238         end.
     1239       end.
     1240       else do:
     1241         if p-key-rec = ?
     1242           or p-key-rec = "":U
     1243         then do:
     1244           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
     1245         end.
     1246       end.
     1247       assign
     1248         vTable = entry( 1 , p-key-rec, chr(3) )
     1249       .
     1250       if p-tt-handle <> ?
     1251         and ( not valid-handle(p-tt-handle)
     1252               or p-tt-handle:type <> "buffer"
     1253             )
     1254       then do:
     1255         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
     1256       end.
     1257       if p-tt-handle = ? then do:
     1258         assign
     1259           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1260         .
     1261         create buffer bh_tbl-name for table v-full-tbl-name .
     1262       end.
     1263       else do:
     1264         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1265       end.
     1266       assign
     1267         v-inform = bh_tbl-name:index-information(1)
     1268         v-ind    = 2
     1269       .
     1270       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1271       on error undo, return error
     1272       :
     1273         assign
     1274           v-inform = bh_tbl-name:index-information( v-ind )
     1275           v-ind    = v-ind + 1
     1276         .
     1277       end.
     1278       if v-inform = ?
     1279         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1280         or entry( 3, v-inform, ",":U ) <> "1":U
     1281       then do:
     1282         delete object bh_tbl-name no-error.
     1283         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
     1284       end.
     1285       assign
     1286         v-idx-field-qnty = num-entries( v-inform ) - 4
     1287       .
     1288       if v-idx-field-qnty < 2 then do:
     1289         delete object bh_tbl-name no-error.
     1290         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
     1291       end.
     1292       assign
     1293         o-where     = "where":U
     1294         v-word-link = "":U
     1295         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1296         v-count-fld = 0
     1297       .
     1298       if i-tablekey ne "" and i-tablekey ne ?
     1299       then do:
     1300         assign
     1301           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1302         .
     1303         create buffer bh_tbl-key for table v-full-tbl-name .
     1304       end.
     1305       if i-tableSerach ne "" and i-tableSerach ne ?
     1306       then do:
     1307         delete object bh_tbl-name no-error.
     1308         assign
     1309           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1310         .
     1311         create buffer bh_tbl-name for table v-full-tbl-name .
     1312       end.
     1313       block_where:
     1314       do v-ind = 1 to v-idx-field-qnty by 2
     1315       on error undo, return error
     1316       :
     1317         assign
     1318           v-count-fld = v-count-fld + 1
     1319         .
     1320         if p-key-handle = ?
     1321           and v-count-fld > v-field-num
     1322         then do:
     1323           leave block_where.
     1324         end.
     1325         define variable VfieldKeyTable as handle no-undo.
     1326         assign
     1327           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1328           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1329         .
     1330         if     bh_tbl-key ne ?
     1331         then do:
     1332            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1333            if VfieldKeyTable eq ?
     1334            then next block_where.
     1335         end.
     1336         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1337         then
     1338            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1339         else
     1340            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1341         if p-key-handle = ? then do:
     1342           assign
     1343             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1344           .
     1345         end.
     1346         else do:
     1347           assign
     1348             fh_key = p-key-handle:buffer-field( v-field-name )
     1349           .
     1350           if fh_key = ?
     1351             or not valid-handle( fh_key )
     1352           then do:
     1353             delete object bh_tbl-name.
     1354             if     bh_tbl-key ne ?
     1355             then
     1356                delete object bh_tbl-key.
     1357             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
     1358           end.
     1359           assign
     1360             v-field-val = fh_key:buffer-value
     1361           .
     1362         end.
     1363         if fh_search:data-type ="character":U then do:
     1364           assign
     1365             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1366             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1367             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1368             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1369             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1370             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1371             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1372             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1373             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1374             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1375             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1376             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1377             v-field-val = substitute( '"&1"', v-field-val )
     1378           .
     1379         end.
     1380         assign
     1381           o-where = substitute( "&1 &2", o-where, v-field-val )
     1382         .
     1383         if v-word-link = "":U then do:
     1384           assign
     1385             v-word-link = "and":U
     1386           .
     1387         end.
     1388       end.
     1389       delete object bh_tbl-name.
     1390       if     bh_tbl-key ne ?
     1391       then
     1392          delete object bh_tbl-key.
     1393       if p-key-handle = ?
     1394         and v-count-fld <> v-field-num
     1395       then do:
     1396         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
     1397       end.
     1398     end.
     1399   end procedure.
     1400   procedure gen-hn-keyr-tab :
     1401     define input  parameter i-tableSerach as character no-undo.
     1402     define input  parameter i-tablekey   as character no-undo.
     1403     define input  parameter p-key-rec    as character no-undo.
     1404     define input  parameter p-key-handle as handle    no-undo .
     1405     define input  parameter p-db-name    as character no-undo .
     1406     define input  parameter p-tt-handle  as handle    no-undo .
     1407     define input  parameter p-stts-lock  as integer   no-undo .
     1408     define output parameter o-hn         as handle    no-undo.
     1409     define variable v-full-tbl-name as character no-undo.
     1410     define variable v-where         as character no-undo.
     1411     define variable bh_tbl-name     as handle    no-undo.
     1412     define variable vTable          as character no-undo.
     1413     do
     1414     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1415     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1416     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1417         run gen-where-keyr-tab(i-tableSerach,
     1418                                i-tablekey,
     1419                                p-key-rec,
     1420                                p-key-handle,
     1421                                p-db-name,
     1422                                p-tt-handle,
     1423                                output v-where).
     1424         if i-tableSerach ne "" and i-tableSerach ne ?
     1425         then do:
     1426            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1427            create buffer bh_tbl-name for table v-full-tbl-name .
     1428         end.
     1429         else do:
     1430            if p-tt-handle = ? then do:
     1431               assign
     1432                  vTable = entry( 1 , p-key-rec, chr(3) )
     1433               .
     1434               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1435               create buffer bh_tbl-name for table v-full-tbl-name .
     1436            end.
     1437            else do:
     1438               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1439            end.
     1440         end.
     1441         if p-tt-handle = ? then do:
     1442            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1443         end.
     1444         else do:
     1445            bh_tbl-name:find-first( v-where ) no-error .
     1446         end.
     1447         o-hn = bh_tbl-name.
     1448      end.
     1449   end procedure.
     1450   procedure gen-hn-keyr :
     1451     define input  parameter p-key-rec    as character no-undo.
     1452     define input  parameter p-key-handle as handle    no-undo .
     1453     define input  parameter p-db-name    as character no-undo .
     1454     define input  parameter p-tt-handle  as handle    no-undo .
     1455     define input  parameter p-stts-lock  as integer   no-undo .
     1456     define output parameter o-hn         as handle    no-undo.
     1457     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1458   end.
     1459   procedure gen-row-keyr :
     1460     define input  parameter p-key-rec    as character no-undo.
     1461     define input  parameter p-key-handle as handle    no-undo .
     1462     define input  parameter p-db-name    as character no-undo .
     1463     define input  parameter p-tt-handle  as handle    no-undo .
     1464     define input  parameter p-stts-lock  as integer   no-undo .
     1465     define output parameter p-tbl-row    as rowid     no-undo.
     1466     define output parameter p-tbl-name   as character no-undo.
     1467     define variable vHn as handle no-undo.
     1468       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1469       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1470       p-tbl-name =  vHn:table.
     1471       delete object vHn no-error.
     1472     if p-tbl-row = ? then do:
     1473       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
     1474     end.
     1475     else do:
     1476       return.
     1477     end.
     1478   end procedure.
     1479   procedure gen-key-fv :
     1480     define input  parameter p-key-rec    as character no-undo .
     1481     define output parameter p-field-list as character no-undo .
     1482     define output parameter p-value-list as character no-undo.
     1483     do
     1484     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1485     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1486     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1487     :
     1488       define variable v-full-tbl-name  as character no-undo .
     1489       define variable bh_tbl-name      as handle    no-undo .
     1490       define variable v-tbl-name       as character no-undo .
     1491       define variable v-field-num      as integer   no-undo .
     1492       define variable v-count-fld      as integer   no-undo .
     1493       define variable v-inform         as character no-undo .
     1494       define variable v-ind            as integer   no-undo .
     1495       define variable v-idx-field-qnty as integer   no-undo .
     1496       define variable v-delim-key      as character no-undo .
     1497       if p-key-rec = ?
     1498         or p-key-rec = "":U
     1499       then do:
     1500         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
     1501       end.
     1502       assign
     1503         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1504         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1505       .
     1506       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1507       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
     1508       assign
     1509         v-inform = bh_tbl-name:index-information(1)
     1510         v-ind    = 2
     1511       .
     1512       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1513       on error undo, return error
     1514       :
     1515         assign
     1516           v-inform = bh_tbl-name:index-information( v-ind )
     1517           v-ind    = v-ind + 1
     1518         .
     1519       end.
     1520       if v-inform = ?
     1521         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1522         or entry( 3, v-inform, ",":U ) <> "1":U
     1523       then do:
     1524         delete object bh_tbl-name no-error.
     1525         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
     1526       end.
     1527       assign
     1528         v-idx-field-qnty = num-entries( v-inform ) - 4
     1529       .
     1530       if v-idx-field-qnty < 2 then do:
     1531         delete object bh_tbl-name no-error.
     1532         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
     1533       end.
     1534       assign
     1535         p-field-list = "":U
     1536         p-value-list = "":U
     1537         v-delim-key  = "":U
     1538         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1539         v-count-fld  = 0
     1540       .
     1541       block_where:
     1542       do v-ind = 1 to v-idx-field-qnty by 2
     1543       on error undo, return error
     1544       :
     1545         assign
     1546           v-count-fld = v-count-fld + 1
     1547         .
     1548         if v-count-fld > v-field-num then do:
     1549           leave block_where.
     1550         end.
     1551         assign
     1552           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1553           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1554         .
     1555         if v-ind = 1 then do:
     1556           assign
     1557             v-delim-key = chr(3)
     1558           .
     1559         end.
     1560       end.
     1561       delete object bh_tbl-name.
     1562       if v-count-fld <> v-field-num then do:
     1563         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
     1564       end.
     1565     end.
     1566   end procedure.
     1567   procedure gen-key-field :
     1568     define input  parameter p-table      as character no-undo .
     1569     define output parameter p-field-list as character no-undo .
     1570     do
     1571     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1572     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1573     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1574     :
     1575       define variable v-full-tbl-name  as character no-undo .
     1576       define variable bh_tbl-name      as handle    no-undo .
     1577       define variable v-tbl-name       as character no-undo .
     1578       define variable v-field-num      as integer   no-undo .
     1579       define variable v-count-fld      as integer   no-undo .
     1580       define variable v-inform         as character no-undo .
     1581       define variable v-ind            as integer   no-undo .
     1582       define variable v-idx-field-qnty as integer   no-undo .
     1583       define variable v-delim-key      as character no-undo .
     1584       if p-table = ?
     1585         or p-table = "":U
     1586       then do:
     1587         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
     1588       end.
     1589       assign
     1590         v-tbl-name      = p-table
     1591         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1592       .
     1593       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1594       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
     1595       assign
     1596         v-inform = bh_tbl-name:index-information(1)
     1597         v-ind    = 2
     1598       .
     1599       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1600       on error undo, return error
     1601       :
     1602         assign
     1603           v-inform = bh_tbl-name:index-information( v-ind )
     1604           v-ind    = v-ind + 1
     1605         .
     1606       end.
     1607       if v-inform = ?
     1608         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1609         or entry( 3, v-inform, ",":U ) <> "1":U
     1610       then do:
     1611         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
     1612       end.
     1613       assign
     1614         v-idx-field-qnty = num-entries( v-inform ) - 4
     1615       .
     1616       if v-idx-field-qnty < 2 then do:
     1617         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
     1618       end.
     1619       assign
     1620         p-field-list = "":U
     1621         v-delim-key  = "":U
     1622         v-count-fld  = 0
     1623       .
     1624       block_where:
     1625       do v-ind = 1 to v-idx-field-qnty by 2
     1626       on error undo, return error
     1627       :
     1628         assign
     1629           v-count-fld = v-count-fld + 1
     1630         .
     1631         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1632         if v-ind = 1 then do:
     1633           assign
     1634             v-delim-key = chr(3)
     1635           .
     1636         end.
     1637       end.
