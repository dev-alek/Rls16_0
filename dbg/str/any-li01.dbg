        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-proc-name     as character no-undo .
        5   define input parameter p-from-macro    as logical no-undo .
        6   define input parameter rs-list-method  as character no-undo .
        7   define input parameter rs-status       as character no-undo .
        8   define input parameter line-mode       as character no-undo .
        9   define input parameter p-id            as integer no-undo .
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   define    temp-table any-hist no-undo
       12   field list-table as character
       13   field id as integer
       14   field line as integer
       15   field hist-mode as character
       16   field des as character
       17   field num-recs as integer
       18   field option_ as character
       19   field item_ as character
       20   field status_ as character
       21   field num-add as integer
       22   field num-ignored as integer
       23   field done as logical
       24   field err_ as logical
       25   field err-mes as character
       26   index pi is primary
       27   id
       28   line
       29   index isdone
       30   done
       31   .
       32   define INPUT-OUTPUT parameter table for any-hist.
       33   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       34   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       35   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       36   define variable vss-workfile    as character no-undo init "$Workfile: any-li01.p $":U .
       37   define variable vss-archive     as character no-undo init "$Archive: str/any-li01.p $":U .
       38   define variable vss-description as character no-undo init "Обработка заполнения списка товаров - процедура 01".
       39   procedure vss-get-info :
       40     define output parameter p-vss-revision    like vss-revision    no-undo .
       41     define output parameter p-vss-author      like vss-author      no-undo .
       42     define output parameter p-vss-date        like vss-date        no-undo .
       43     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       44     define output parameter p-vss-archive     like vss-archive     no-undo .
       45     define output parameter p-vss-description like vss-description no-undo .
       46     assign
       47       p-vss-revision    = vss-revision
       48       p-vss-author      = vss-author
       49       p-vss-date        = vss-date
       50       p-vss-workfile    = vss-workfile
       51       p-vss-archive     = vss-archive
       52       p-vss-description = vss-description
       53     .
       54   end procedure.
       55   procedure vss-get-parameters :
       56     define output parameter p-vss-parameters as character no-undo .
       57   end procedure.
       58   define new global shared variable g#vssrevis-logger as handle    no-undo .
       59   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       60   define variable v-vssrevis-logger                   as handle    no-undo .
       61   procedure vss-logevent :
       62     define input  parameter p-extra-paramters as character no-undo .
       63     define variable v-vssrevis-parameters as character no-undo .
       64     do
       65     on error undo, return error return-value
       66     :
       67       if  valid-handle(v-vssrevis-logger)
       68       and v-vssrevis-logger :get-signature("logevent") <> ""
       69       then do:
       70         run vss-get-parameters in this-procedure
       71           (output v-vssrevis-parameters
       72           ).
       73         run logevent in v-vssrevis-logger
       74           (input vss-workfile
       75           ,input vss-revision
       76           ,input v-vssrevis-parameters
       77           ,input p-extra-paramters
       78           ).
       79       end.
       80     end.
       81   end procedure.
       82   assign
       83     v-vssrevis-logger = g#vssrevis-logger
       84   .
       85   if  valid-handle(v-vssrevis-logger)
       86   and v-vssrevis-logger :get-signature("logevent") <> ""
       87   then do:
       88     assign
       89       v-vssrevis-logevent = true
       90     .
       91     run vss-logevent in this-procedure (input vss-description) .
       92   end.
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   define new global shared variable g#library  as handle no-undo .
       98   define new global shared variable g#library2 as handle no-undo .
       99   define   shared variable g#auto as logical no-undo.
      100   define   shared variable g#news as logical no-undo.
      101   define   shared variable g#oxml as logical no-undo.
      102   define   shared variable g#esys as logical no-undo.
      103   define   shared variable g#news-source-db as integer no-undo.
      104   define   shared variable g#esys-source-esys as integer no-undo.
      105   define   shared variable g#db-num as integer   no-undo .
      106   define   shared variable g#userid as character no-undo .
      107   define   shared variable g#passwd as character no-undo .
      108   define variable v-rowid   as rowid no-undo .
      109   define variable v-tbl-name as character no-undo .
      110   define buffer buf_goods for ub.goods.
      111   define buffer buf_any-hist for any-hist.
      112   define buffer buf_user-obj for ub.user-obj.
      113   define variable v-obj-type as character no-undo .
      114   define variable v-obj-code as integer   no-undo .
      115   case p-proc-name :
      116     when "analysis-do":U then do:
      117       do
      118       on error undo, return error return-value:
      119         CASE rs-list-method:
      120           when "abc-analysis" then do:
      121             find first buf_any-hist where
      122                       buf_any-hist.id = p-id .
      123             run gen-row-keyr  in p-parent-handle  (  input buf_any-hist.item_                                                           ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
      124               find first ub.abc-analysis no-lock where
      125                         rowid(ub.abc-analysis) = v-rowid no-error.
      126               if avail ub.abc-analysis then do:
      127                 _abc:
      128                 for each buf_any-hist where
      129                         buf_any-hist.id = p-id
      130                     and  buf_any-hist.item_ <> '':U:
      131                   for each ub.abc-analysis-goods no-lock where
      132                           ub.abc-analysis-goods.abc-id  = ub.abc-analysis.abc-id
      133                       and ub.abc-analysis-goods.db-num   = ub.abc-analysis.db-num
      134                       and ub.abc-analysis-goods.abcg-abc = buf_any-hist.item_,
      135                     first buf_goods  no-lock where
      136                           buf_goods.gds-code = abc-analysis-goods.gds-code:
      137                     run ex-gds in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      138                   end.
      139                   run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      140                                                       ,input-output buf_any-hist.num-rec
      141                                                       ,input-output buf_any-hist.num-ignored
      142                                                       ,input line-mode).
      143                 end.
      144               end.
      145             end.
      146           end.
      147           when "xyz-analysis" then do:
      148             find first buf_any-hist where
      149                       buf_any-hist.id = p-id .
      150             run gen-row-keyr  in p-parent-handle  (  input buf_any-hist.item_                                                           ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
      151               find first ub.xyz-analysis no-lock where
      152                         rowid(ub.xyz-analysis) = v-rowid no-error.
      153               if avail ub.xyz-analysis then do:
      154                 _xyz:
      155                 for each buf_any-hist where
      156                         buf_any-hist.id = p-id
      157                     and  buf_any-hist.item_ <> '':U:
      158                   for each ub.xyz-analysis-goods no-lock where
      159                           ub.xyz-analysis-goods.xyz-id  = ub.xyz-analysis.xyz-id
      160                       and ub.xyz-analysis-goods.db-num   = ub.xyz-analysis.db-num
      161                       and ub.xyz-analysis-goods.xyzg-xyz = buf_any-hist.item_,
      162                     first buf_goods  no-lock where
      163                           buf_goods.gds-code = xyz-analysis-goods.gds-code:
      164                     run ex-gds in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      165                   end.
      166                   run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      167                                                       ,input-output buf_any-hist.num-rec
      168                                                       ,input-output buf_any-hist.num-ignored
      169                                                       ,input line-mode).
      170                 end.
      171               end.
      172             end.
      173           end.
      174           when "abcxyz" then do:
      175             find first buf_any-hist where
      176                       buf_any-hist.id = p-id .
      177             run gen-row-keyr  in p-parent-handle  (  input buf_any-hist.item_                                                           ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then do: end. else do:
      178               find first ub.abcxyz-analysis no-lock where
      179                         rowid(ub.abcxyz-analysis) = v-rowid no-error.
      180               if avail ub.abcxyz-analysis then do:
      181                   _abcxyz:
      182                   for each buf_any-hist where
      183                           buf_any-hist.id = p-id
      184                       and  buf_any-hist.item_ <> '':U:
      185                     for each ub.abcxyz-analysis-goods no-lock where
      186                             ub.abcxyz-analysis-goods.abcx-id  = ub.abcxyz-analysis.abcx-id
      187                         and ub.abcxyz-analysis-goods.db-num   = ub.abcxyz-analysis.db-num
      188                         and ub.abcxyz-analysis-goods.abcg-abc = substring(buf_any-hist.item_, 1, 1)
      189                         and ub.abcxyz-analysis-goods.xyzg-xyz = substring(buf_any-hist.item_, 2, 1),
      190                       first buf_goods  no-lock where
      191                             buf_goods.gds-code = abcxyz-analysis-goods.gds-code:
      192                       run ex-gds  in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      193                     end.
      194                     run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      195                                                         ,input-output buf_any-hist.num-rec
      196                                                         ,input-output buf_any-hist.num-ignored
      197                                                         ,input line-mode).
      198                   end.
      199                 end.
      200             end.
      201           end.
      202         END CASE.
      203       end.
      204     end.
      205     when "ass-matr":U then do:
      206       do
      207       on error undo, return error return-value:
      208         for each buf_any-hist where
      209                 buf_any-hist.id = p-id
      210             and  buf_any-hist.item_  <> '':U:
      211           run gen-row-keyr  in p-parent-handle  (  input buf_any-hist.item_                                                           ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
      212           find first ub.assortment-matrix no-lock where
      213                     rowid(ub.assortment-matrix) = v-rowid no-error.
      214           for each ub.assortment-matrix-goods no-lock where
      215                   ub.assortment-matrix-goods.asmt-id  = ub.assortment-matrix.asmt-id
      216               and ub.assortment-matrix-goods.db-num        = ub.assortment-matrix.db-num
      217               and ub.assortment-matrix-goods.asmg-status   = int('0':U),
      218               first buf_goods  no-lock where
      219                   buf_goods.gds-code = assortment-matrix-goods.gds-code:
      220             run ex-gds  in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      221           end.
      222           run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      223                                               ,input-output buf_any-hist.num-rec
      224                                               ,input-output buf_any-hist.num-ignored
      225                                               ,input line-mode).
      226         end.
      227       end.
      228     end.
      229     when "ass-min":U then do:
      230       do
      231       on error undo, return error return-value:
      232         for each buf_any-hist where
      233                 buf_any-hist.id = p-id
      234             and  buf_any-hist.item_  <> '':U:
      235           v-obj-type = entry(1,buf_any-hist.item_, chr(3)) no-error  .
      236           v-obj-code = integer(entry(2,buf_any-hist.item_, chr(3))) no-error .
      237           find first buf_user-obj no-lock where
      238                     buf_user-obj.obj-type = v-obj-type and
      239                     buf_user-obj.obj-code = v-obj-code
      240                     no-error.
      241           if avail buf_user-obj then do:
      242             for each ub.gds-obj-prop no-lock where
      243                     ub.gds-obj-prop.obj-type = buf_user-obj.obj-type
      244                 and ub.gds-obj-prop.obj-code  = buf_user-obj.obj-code
      245                 and ub.gds-obj-prop.gdop-assort-min  = true,
      246                 first buf_goods  no-lock where
      247                     buf_goods.gds-code = ub.gds-obj-prop.gds-code:
      248               run ex-gds in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      249             end.
      250           end.
      251           run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      252                                               ,input-output buf_any-hist.num-rec
      253                                               ,input-output buf_any-hist.num-ignored
      254                                               ,input line-mode).
      255         end.
      256       end.
      257     end.
      258     when "collection":U then do:
      259       do on error undo, return error return-value:
      260         for each buf_any-hist where
      261                  buf_any-hist.id = p-id
      262             and  buf_any-hist.item_  <> '':U:
      263           run gen-row-keyr  in p-parent-handle  (  input buf_any-hist.item_                                                           ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
      264           find first ub.season no-lock where
      265                rowid(ub.season) = v-rowid no-error.
      266           for each ub.gds-season no-lock where
      267                    ub.gds-season.sea-code  = ub.season.sea-code
      268                and ub.gds-season.db-num    = ub.season.db-num ,
      269               first buf_goods  no-lock where
      270                     buf_goods.gds-code = ub.gds-season.gds-code :
      271             run ex-gds  in p-parent-handle ( buffer buf_goods, input rs-list-method, input rs-status, input line-mode).
      272           end.
      273           run assign-nums in p-parent-handle ( input-output buf_any-hist.num-add
      274                                               ,input-output buf_any-hist.num-rec
      275                                               ,input-output buf_any-hist.num-ignored
      276                                               ,input line-mode).
      277         end.
      278        end.
      279     end.
      280   END CASE.
