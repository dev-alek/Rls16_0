     5579       if meas_pump-nozzle.is-meas <> yes then
     5580       do:
     5581         message "Пистолет " meas_pump-nozzle.nozzle-code " на ТРК " meas_pump-nozzle.pump-code " не измеряется приборами."
     5582           view-as alert-box error.
     5583         return error.
     5584       end.
     5585       run waitfram-show in this-procedure ( input "Просматриваем измеряемые ТРК" ).
     5586   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_measpmnz in g#lib-rvs ( input ub.rvs-line-pump.obj-type ,
     5587                         input ub.rvs-line-pump.obj-code ,
