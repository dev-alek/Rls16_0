     6286       ,input  r-doc.obj-type
     6287       ,input  r-doc.obj-code
     6288       ,input  0
     6289       ,input  0
     6290       ,input  0
     6291       ,input  true
     6292       ,output varlog
     6293       )  .
     6294   end.
     6295         end.
     6296       when 'смена':U
     6297       then
     6298         do:
     6299   define variable vss-include-info54 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6300   do:
     6301     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6302       (input  v-cntxt-db-num
