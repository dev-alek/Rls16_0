     5896   procedure proc_m-meas-3 :
     5897     define buffer meas-place            for ub.place.
     5898     define buffer olddens_rvs-line-attr for ub.rvs-line-attr .
     5899     define variable VErrorFlag as logical no-undo.
     5900     apply "entry" to br-line in frame d-rvs.
     5901     if available ub.rvs-line then
     5902     do:
     5903       assign
     5904         rvs-line-rec      = recid(ub.rvs-line)
     5905         rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     5906       find meas-place where meas-place.obj-type = ub.rvs-line.obj-type and
     5907         meas-place.obj-code = ub.rvs-line.obj-code and
     5908         meas-place.pl-code  = ub.rvs-line.pl-code  no-lock.
     5909       if meas-place.is-meas <> yes then
     5910       do:
     5911         message "Резервуар " meas-place.pl-code " не измеряется приборами. "
     5912           view-as alert-box error.
     5913         return error.
     5914       end.
     5915       if meas-place.loc1 = "" or meas-place.loc1 = ? then
     5916       do:
     5917         message "Не указан локальный код на складском месте " meas-place.pl-code
     5918           view-as alert-box error.
     5919         return error.
     5920       end.
     5921       for each tt-meas:
     5922         delete tt-meas.
     5923       end.
     5924       create tt-meas.
     5925       assign
     5926         tt-meas.obj-type = ub.rvs-line.obj-type
     5927         tt-meas.obj-code = ub.rvs-line.obj-code
     5928         tt-meas.pl-code  = ub.rvs-line.pl-code.
     5929       run waitfram-show in this-procedure ( input ("Делаем сверку по резервуару " + meas-place.loc1) ).
     5930       tr:
     5931       do transaction on error undo tr, retry tr :
     5932         if retry then
     5933         do:
     5934           VErrorFlag = yes.
     5935           leave tr.
     5936         end.
     5937         find first sys-ctrl no-lock.
     5938         run db-attr-value(sys-ctrl.db,"AsiIp",output v-asi-ip,output v-attr-type).
     5939         run db-attr-value(sys-ctrl.db,"AsiPort",output v-asi-port,output v-attr-type).
     5940         run db-attr-value(sys-ctrl.db,"AsiType",output v-asi-type,output v-attr-type).
     5941         if trim(v-asi-ip) <> ''
     5942           and trim(v-asi-port) <> ''
     5943           and trim(v-asi-type) <> ''
     5944           then
     5945         do :
     5946           case v-asi-type :
     5947             when "1"
     5948             then
     5949               do :
     5950                 varcur-rvs = 2 .
     5951               end.
     5952             when "2"
     5953             then
     5954               do :
     5955                 varcur-rvs = 3 .
     5956               end.
     5957           end case .
     5958         end.
     5959         else
     5960         do :
     5961           if ptoldfilvalue = "yes":u then
     5962           do:
     5963             run gbl/d-askw.w ( input "Выбор источника данных с информацией по резервуарам",
     5964               "Будем читать текущие данные с резервуаров или возьмем данные из файла?",
     5965               "|^",
     5966               "Текущие данные|Из файлов|Отмена",
     5967               "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем",
     5968               1,
     5969               3,
     5970               output varnum
     5971               ).
     5972             case varnum:
     5973               when 3 then
     5974                 do:
     5975                   undo tr, leave tr.
     5976                 end.
     5977               when 2 then
     5978                 do:
     5979                   assign
     5980                     varcur-rvs = 0.
     5981                 end.
     5982               when 1 then
     5983                 do:
     5984                   assign
     5985                     varcur-rvs = 1.
     5986                 end.
     5987             end case.
     5988           end.
     5989           else
     5990           do:
     5991             assign
     5992               varcur-rvs = 1.
     5993           end.
     5994         end.
     5995   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsplace in g#lib-rvs ( input              r-doc.obj-type ,
