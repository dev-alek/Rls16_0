     2228       run ui-on in this-procedure no-error.
     2229       if error-status :error then
     2230       do:
     2231         return no-apply.
     2232       end.
     2233       apply "entry" to b-add in frame d-rvs.
     2234       return no-apply.
     2235     end.
     2236   on choose of menu-item m-add-2 in menu m-add
