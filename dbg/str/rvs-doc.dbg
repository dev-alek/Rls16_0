     6330       ,input  r-doc.obj-type
     6331       ,input  r-doc.obj-code
     6332       ,input  0
     6333       ,input  0
     6334       ,input  0
     6335       ,input  true
     6336       ,output varlog
     6337       )  .
     6338   end.
     6339         end.
     6340       otherwise
