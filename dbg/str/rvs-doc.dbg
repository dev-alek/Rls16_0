     4308       find last prev_shift-obj where prev_shift-obj.obj-type = cur_shift-obj.obj-type and
     4309         prev_shift-obj.obj-code = cur_shift-obj.obj-code and
     4310         prev_shift-obj.status_  = 'зкр':U         and
     4311         (prev_shift-obj.shift-date < cur_shift-obj.shift-date or
     4312         prev_shift-obj.shift-date = cur_shift-obj.shift-date and
