     4957                     ,  input ?
     4958                     ,  input v-ref-rec
     4959                     ,  input ",,,,,,NO"
     4960                     ,  input "lock-cli-type"
     4961                     , output ref-list ) .
     4962       assign v-ref-rec34 = integer( ref-list ).
     4963       v-ref-rec = integer( ref-list ) .
     4964       find cli-buf where recid (cli-buf) =
     4965          v-ref-rec
     4966          no-lock no-error.
     4967       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     4968         find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     4969                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     4970     end.
     4971     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     4972       display cli-buf.obj-code @ r-doc.wrkr
     4973               cli-buf.obj-name @ wrkr-name with frame d-rvs.
     4974       assign frame d-rvs r-doc.wrkr.
     4975     end.
     4976     else display ? @ r-doc.wrkr
     4977                  ? @ wrkr-name with frame d-rvs.
     4978     apply "entry" to r-doc.agnt in frame d-rvs.
     4979   if available cli-buf then do:
     4980         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     4981     end.
     4982     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     4983         return no-apply.
     4984     end.
     4985     if parman = "wrkr" and paraction = "button" then
     4986     do:
     4987     define variable v-ref-rec35   as recid no-undo .
     4988     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     4989                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4990     assign v-ref-rec35 = ( if available cli-buf then recid( cli-buf ) else ? ).
     4991     v-ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     4992     release cli-buf.
     4993     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     4994       run ref/cli-all.w (  input parparentproc
     4995                     ,  input "b-sel"
     4996                     ,  input 'чел':U
     4997                     ,  input ?
     4998                     ,  input ?
     4999                     ,  input v-ref-rec
     5000                     ,  input ",,,,,,NO"
     5001                     ,  input "lock-cli-type"
     5002                     , output ref-list ) .
     5003       assign v-ref-rec35 = integer( ref-list ).
     5004       v-ref-rec = integer( ref-list ) .
     5005       find cli-buf where recid (cli-buf) =
     5006          v-ref-rec
     5007          no-lock no-error.
     5008       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     5009         find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     5010                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     5011     end.
     5012     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     5013       display cli-buf.obj-code @ r-doc.wrkr
     5014               cli-buf.obj-name @ wrkr-name with frame d-rvs.
     5015       assign frame d-rvs r-doc.wrkr.
     5016     end.
     5017     else display ? @ r-doc.wrkr
     5018                  ? @ wrkr-name with frame d-rvs.
     5019     apply "entry" to r-doc.agnt in frame d-rvs.
     5020   if available cli-buf then do:
     5021         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     5022     end.
     5023     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     5024         return no-apply.
     5025     end.
     5026     if parman = "wrkr" and paraction = "leave" then
     5027     do:
     5028     define variable v-ref-rec36   as recid no-undo .
     5029     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     5030                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     5031   if available cli-buf then do:
     5032         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     5033             assign frame d-rvs r-doc.wrkr.
     5034     end.
     5035     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     5036     end.
     5037   end procedure.
     5038   procedure plgdsfnd :
     5039     define input  parameter p-chk-and-chs    as logical               no-undo .
     5040     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     5041     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     5042     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     5043     define output parameter p-reserv-pl-code as   logical             no-undo .
     5044     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     5045     define buffer buf_goods         for ub.goods .
     5046     define buffer buf_pl-gds        for ub.pl-gds .
     5047     define buffer buf_second_pl-gds for ub.pl-gds .
     5048     find first buf_goods no-lock where
     5049                buf_goods.gds-code = p-gds-code no-error .
     5050     if not available buf_goods
     5051     then do:
     5052       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     5053     end.
     5054   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5055   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     5056     (input  p-obj-type
     5057     ,input  p-obj-code
     5058     ,input  buf_goods.artic
     5059     ,input  buf_goods.prod-type
     5060     ,input  buf_goods.prod-code
     5061     ,input  'place-rsrv=request'
     5062     ,output p-reserv-pl-code
     5063     ) no-error .
     5064     if error-status :error
     5065     then do:
     5066       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     5067     end.
     5068     if p-reserv-pl-code = no
     5069     then do:
     5070       return .
     5071     end.
     5072     if p-chk-and-chs <> yes
     5073     then do:
     5074       return .
     5075     end.
     5076     find first buf_pl-gds no-lock where
     5077                buf_pl-gds.obj-type = p-obj-type and
     5078                buf_pl-gds.obj-code = p-obj-code and
     5079                buf_pl-gds.gds-code = p-gds-code no-error .
     5080     if not available buf_pl-gds
     5081     then do:
     5082       return error "К товару не привязано ни одного места хранения" .
     5083     end.
     5084     find first buf_second_pl-gds no-lock where
     5085                buf_second_pl-gds.obj-type  = p-obj-type          and
     5086                buf_second_pl-gds.obj-code  = p-obj-code          and
     5087                buf_second_pl-gds.gds-code  = p-gds-code          and
     5088                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     5089     if not available buf_second_pl-gds
     5090     then do:
     5091       assign
     5092         p-pl-code = buf_pl-gds.pl-code
     5093       .
     5094     end.
     5095     else do:
     5096       run str/plgdssel.p
     5097         (
     5098            input parparentproc
     5099         ,  input p-obj-type
     5100         ,  input p-obj-code
     5101         ,  input p-gds-code
     5102         , output p-pl-code
     5103         ) no-error .
     5104       if error-status :error
     5105       then do:
     5106         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     5107                                , 'plgdssel.p':U
     5108                                , chr(10)
     5109                                , error-status :get-message( 1 )
     5110                                , return-value
     5111                                ) .
     5112       end.
     5113       if p-pl-code = ? or
     5114          p-pl-code = 0
     5115       then do:
     5116         return error "Не выбрано место хранения " + chr(10) .
     5117       end.
     5118     end.
     5119   end procedure.
     5120   procedure doc-plsh:
     5121     define buffer buf_trn-doc  for ub.trn-doc.
     5122     define buffer buf_doc-pl   for ub.doc-pl.
     5123     define buffer buf_rvs-line for ub.rvs-line.
     5124     for each buf_trn-doc no-lock
     5125       where buf_trn-doc.obj-type   = r-doc.obj-type
     5126       and buf_trn-doc.obj-code   = r-doc.obj-code
     5127       and buf_trn-doc.shift-date = r-doc.shift-date
     5128       and buf_trn-doc.shift-num  = r-doc.shift-num
     5129       on error undo, return error return-value
     5130       :
     5131       for each buf_doc-pl no-lock
     5132         where buf_doc-pl.out-code = buf_trn-doc.doc-code
     5133         on error undo, return error return-value
     5134         :
     5135         find first buf_rvs-line no-lock
     5136           where buf_rvs-line.rvs-code = r-doc.rvs-code
     5137           and buf_rvs-line.obj-type = r-doc.obj-type
     5138           and buf_rvs-line.obj-code = r-doc.obj-code
     5139           and buf_rvs-line.pl-code  = buf_doc-pl.pl-code
     5140           and buf_rvs-line.gds-code = buf_doc-pl.gds-code
     5141           no-error.
     5142         if not available buf_rvs-line then
     5143         do:
     5144           tr:
     5145           do transaction
     5146             on error undo tr, return error return-value
     5147             :
     5148   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input r-doc.obj-type ,
     5149                         input r-doc.obj-code ,
     5150                         input r-doc.rvs-code ,
     5151                         input r-doc.rvs-type ,
     5152                         input buf_doc-pl.pl-code ,
     5153                         input buf_doc-pl.gds-code ,
     5154                         input ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     5155                         input cur_shift-obj.shift-date ,
     5156                         input cur_shift-obj.shift-num ) no-error .
     5157             if error-status :error then
     5158             do:
     5159               message 'Ошибка при создании линии.' skip
     5160                 return-value
     5161                 error-status :get-message( 1 )
     5162                 view-as alert-box error.
     5163               undo tr, return error.
     5164             end.
     5165   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslnp in g#lib-rvs ( input  r-doc.obj-type ,
     5166                         input  r-doc.obj-code ,
     5167                         input  r-doc.rvs-code ,
     5168                         input  r-doc.rvs-type ,
     5169                         input  buf_doc-pl.pl-code ,
     5170                         input  buf_doc-pl.gds-code ,
     5171                         input  yes ,
     5172                         input  ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     5173                         input  cur_shift-obj.shift-date ,
     5174                         input cur_shift-obj.shift-num ,
     5175                         input ( if available prev_icnt-doc then prev_icnt-doc.doc-code else ? ) ,
     5176                         input yes ) no-error .
     5177             if error-status :error then
     5178             do:
     5179               message 'Ошибка при создании строки данных по ТРК.' skip
     5180                 return-value
     5181                 error-status :get-message(1)
     5182                 view-as alert-box.
     5183               undo tr, return error.
     5184             end.
     5185           end.
     5186         end.
     5187       end.
     5188     end.
     5189   end procedure.
     5190   procedure local-add :
     5191     assign
     5192       notes = "".
     5193     run str/chs-gds.w
     5194       ( input        parparentproc
