     1740   define variable del-list  as character no-undo.
     1741   function get-mark return character (buffer local-rvs-line for ub.rvs-line ).
     1742     if lookup (string (recid (local-rvs-line)), del-list) > 0 then return "*".
     1743     else return "".
     1744   end function.
     1745   function deviation-fact    return decimal (buffer local-rvs-line for ub.rvs-line ).
     1746     return (local-rvs-line.state-measure-qnty   + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1747   end function.
     1748   function deviation-measure return decimal (buffer local-rvs-line for ub.rvs-line ).
     1749     return (local-rvs-line.measure-qnty + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1750   end function.
     1751   define query br-line      for ub.rvs-line, ub.goods, ub.place scrolling.
     1752   define query br-pump for ub.rvs-line-pump                scrolling.
     1753   define browse br-line query br-line no-lock display
     1754     get-mark (buffer ub.rvs-line)  column-label '*'  format "x(1)"
     1755     ub.goods.artic  column-label 'Артикул'
     1756         ub.goods.gds-name  column-label 'Название'  format "x(15)"
     1757         ub.rvs-line.pl-code  column-label 'Скл.место'  FORMAT "99999999999":U
