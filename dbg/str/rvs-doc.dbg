     2285     end.
     2286   def var sort-labelbr-line   as character no-undo .
     2287   def var sort-clmnbr-line    as handle    no-undo .
     2288   def var cur-clmnbr-line     as handle    no-undo .
     2289   def var cur-clmn-locbr-line as integer   no-undo .
     2290   def var re-querybr-line     as logical   initial no no-undo .
     2291   on start-search, ctrl-o of br-line in frame d-rvs do:
     2292      run sort-brbr-line
     2293        (input (if available ub.rvs-line
     2294                then recid(ub.rvs-line)
     2295                else ?
     2296               )
     2297        ).
     2298   end.
     2299   PROCEDURE sort-brbr-line :
     2300     define input parameter p-recid as recid no-undo .
     2301     if re-querybr-line = no then do:
     2302       assign
     2303          cur-clmnbr-line = br-line:current-column in frame d-rvs
     2304       .
     2305       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     2306       if cur-clmnbr-line = sort-clmnbr-line then do:
     2307         assign
     2308            sort-labelbr-line = ""
     2309            sort-clmnbr-line = ?
     2310         .
     2311        end.
     2312        else do:
     2313          assign
     2314            sort-labelbr-line = cur-clmnbr-line:label
     2315            sort-clmnbr-line  = cur-clmnbr-line
     2316            sort-clmnbr-line:column-fgcolor = 4
     2317          .
     2318        end.
     2319      end.
     2320     assign
     2321       cur-clmn-locbr-line = 1
     2322     .
     2323     def var column-handle as handle no-undo .
     2324     column-handle = br-line:first-column.
     2325     do while valid-handle(column-handle) :
     2326       if column-handle = cur-clmnbr-line then do:
     2327         leave .
     2328       end.
     2329       column-handle = column-handle:NEXT-COLUMN.
     2330       assign
     2331         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     2332       .
     2333     end.
     2334     case sort-labelbr-line:
     2335           when '*'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by get-mark (buffer ub.rvs-line) .   . END.
     2336           when 'Артикул'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.goods.artic .   . END.
     2337           when 'Название'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.goods.gds-name .   . END.
     2338           when 'Скл.место'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.pl-code .   . END.
     2339           when 'Номер резервуара'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by place.loc1 .   . END.
     2340           when 'Факт остаток'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-measure-qnty .   . END.
     2341           when 'Измер. остаток'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.measure-qnty .   . END.
     2342           when 'Учет'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.system-qnty .   . END.
     2343           when 'Первонач.учет'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.orig-system-qnty .   . END.
     2344           when 'Факт в!трубопроводе'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-add-qnty .   . END.
     2345           when 'Отклонение(факт)'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by deviation-fact(buffer ub.rvs-line) .   . END.
     2346           when 'Отклонение(измер)'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by deviation-measure(buffer ub.rvs-line) .   . END.
     2347           when 'Допустимое!отклонение'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.tolerance .   . END.
     2348           when 'Факт брутто'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-brutto-qnty .   . END.
     2349           when ub.rvs-line.brutto-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.brutto-qnty .   . END.
     2350           when ub.rvs-line.state-density:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-density .   . END.
     2351           when ub.rvs-line.density:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.density .   . END.
     2352           when ub.rvs-line.state-measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-measure-cli-qnty .   . END.
     2353           when ub.rvs-line.measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.measure-cli-qnty .   . END.
     2354           when ub.rvs-line.system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.system-cli-qnty .   . END.
     2355           when ub.rvs-line.orig-system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.orig-system-cli-qnty .   . END.
     2356           when ub.rvs-line.state-brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-brutto-cli-qnty .   . END.
     2357           when ub.rvs-line.brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.brutto-cli-qnty .   . END.
     2358           when ub.rvs-line.state-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-mh-qnty .   . END.
     2359           when ub.rvs-line.meas-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-mh-qnty .   . END.
     2360           when ub.rvs-line.state-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-am-qnty .   . END.
     2361           when ub.rvs-line.meas-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-am-qnty .   . END.
     2362           when ub.rvs-line.state-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-cf-qnty .   . END.
     2363           when ub.rvs-line.meas-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-cf-qnty .   . END.
     2364           when ub.rvs-line.state-level-total:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-total .   . END.
     2365           when ub.rvs-line.level-total:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-total .   . END.
     2366           when ub.rvs-line.state-level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-petrol .   . END.
     2367           when ub.rvs-line.level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-petrol .   . END.
     2368           when ub.rvs-line.state-level-water:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-water .   . END.
     2369           when ub.rvs-line.level-water:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-water .   . END.
     2370           when ub.rvs-line.state-temperature:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-temperature .   . END.
     2371           when ub.rvs-line.temperature:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.temperature .   . END.
     2372       otherwise do:
     2373         open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     2374           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     2375             run mv-brw-defaultbr-line.
     2376           end.
     2377         if sort-labelbr-line <> "" then do:
     2378           assign
     2379             cur-clmnbr-line:column-fgcolor = 0
     2380           .
     2381         end.
     2382         assign
     2383           cur-clmn-locbr-line = ?
     2384         .
     2385       end.
     2386     end case.
     2387       if cur-clmn-locbr-line <> ? then do:
     2388         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     2389           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     2390         end.
     2391       end.
     2392     if p-recid <> ? then do:
     2393       reposition br-line to recid p-recid no-error.
     2394       apply "value-changed" to br-line in frame d-rvs.
     2395     end.
     2396     apply "entry" to br-line in frame d-rvs.
     2397   END PROCEDURE.
     2398   procedure re-open-query-srt-clmnbr-line:
     2399   if cur-clmnbr-line = ? then do:
     2400      open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     2401   end.
     2402   else do:
     2403      assign re-querybr-line = yes.
     2404      run sort-brbr-line
     2405        (input (if available ub.rvs-line
     2406                then recid(ub.rvs-line)
     2407                else ?
     2408               )
     2409        ).
     2410      assign re-querybr-line = no.
     2411   end.
     2412   end.
     2413   def var sort-labelbr-pump   as character no-undo .
     2414   def var sort-clmnbr-pump    as handle    no-undo .
     2415   def var cur-clmnbr-pump     as handle    no-undo .
     2416   def var cur-clmn-locbr-pump as integer   no-undo .
     2417   def var re-querybr-pump     as logical   initial no no-undo .
     2418   on start-search, ctrl-o of br-pump in frame d-rvs do:
     2419      run sort-brbr-pump
     2420        (input (if available ub.rvs-line-pump
     2421                then recid(ub.rvs-line-pump)
     2422                else ?
     2423               )
     2424        ).
     2425   end.
     2426   PROCEDURE sort-brbr-pump :
     2427     define input parameter p-recid as recid no-undo .
     2428     if re-querybr-pump = no then do:
     2429       assign
     2430          cur-clmnbr-pump = br-pump:current-column in frame d-rvs
     2431       .
     2432       if sort-clmnbr-pump <> ? then sort-clmnbr-pump:column-fgcolor = 0.
     2433       if cur-clmnbr-pump = sort-clmnbr-pump then do:
     2434         assign
     2435            sort-labelbr-pump = ""
     2436            sort-clmnbr-pump = ?
     2437         .
     2438        end.
     2439        else do:
     2440          assign
     2441            sort-labelbr-pump = cur-clmnbr-pump:label
     2442            sort-clmnbr-pump  = cur-clmnbr-pump
     2443            sort-clmnbr-pump:column-fgcolor = 4
     2444          .
     2445        end.
     2446      end.
     2447     assign
     2448       cur-clmn-locbr-pump = 1
     2449     .
     2450     def var column-handle as handle no-undo .
     2451     column-handle = br-pump:first-column.
     2452     do while valid-handle(column-handle) :
     2453       if column-handle = cur-clmnbr-pump then do:
     2454         leave .
     2455       end.
     2456       column-handle = column-handle:NEXT-COLUMN.
     2457       assign
     2458         cur-clmn-locbr-pump = cur-clmn-locbr-pump + 1
     2459       .
     2460     end.
     2461     case sort-labelbr-pump:
     2462           when 'ТРК'  then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.pump-code .   . END.
     2463           when 'П'  then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.nozzle-code .   . END.
     2464           when ub.rvs-line-pump.state-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-mh-qnty .   . END.
     2465           when ub.rvs-line-pump.meas-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-mh-qnty .   . END.
     2466           when ub.rvs-line-pump.state-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-am-qnty .   . END.
     2467           when ub.rvs-line-pump.meas-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-am-qnty .   . END.
     2468           when ub.rvs-line-pump.state-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-cf-qnty .   . END.
     2469           when ub.rvs-line-pump.meas-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-cf-qnty .   . END.
     2470           when ub.rvs-line-pump.state-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-mh-cnt .   . END.
     2471           when ub.rvs-line-pump.meas-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-mh-cnt .   . END.
     2472           when ub.rvs-line-pump.state-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-el-cnt .   . END.
     2473           when ub.rvs-line-pump.meas-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-el-cnt .   . END.
     2474           when ub.rvs-line-pump.state-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-am-cnt .   . END.
     2475           when ub.rvs-line-pump.meas-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-am-cnt .   . END.
     2476           when ub.rvs-line-pump.state-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-cf-cnt .   . END.
     2477           when ub.rvs-line-pump.meas-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-cf-cnt .   . END.
     2478           when ub.rvs-line-pump.icnt-code:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.icnt-code .   . END.
     2479           when ub.rvs-line-pump.rvs-prev-code:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.rvs-prev-code .   . END.
     2480       otherwise do:
     2481         open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     2482           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pump') then do:
     2483             run mv-brw-defaultbr-pump.
     2484           end.
     2485         if sort-labelbr-pump <> "" then do:
     2486           assign
     2487             cur-clmnbr-pump:column-fgcolor = 0
     2488           .
     2489         end.
     2490         assign
     2491           cur-clmn-locbr-pump = ?
     2492         .
     2493       end.
     2494     end case.
     2495       if cur-clmn-locbr-pump <> ? then do:
     2496         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pump') then do:
     2497           run ch-clmnbr-pump in this-procedure (cur-clmn-locbr-pump).
     2498         end.
     2499       end.
     2500     if p-recid <> ? then do:
     2501       reposition br-pump to recid p-recid no-error.
     2502       apply "value-changed" to br-pump in frame d-rvs.
     2503     end.
     2504     apply "entry" to br-pump in frame d-rvs.
     2505   END PROCEDURE.
     2506   procedure re-open-query-srt-clmnbr-pump:
     2507   if cur-clmnbr-pump = ? then do:
     2508      open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     2509   end.
     2510   else do:
     2511      assign re-querybr-pump = yes.
     2512      run sort-brbr-pump
     2513        (input (if available ub.rvs-line-pump
     2514                then recid(ub.rvs-line-pump)
     2515                else ?
     2516               )
     2517        ).
     2518      assign re-querybr-pump = no.
     2519   end.
     2520   end.
     2521   on value-changed of br-line in frame d-rvs
     2522     do:
     2523       if available ub.rvs-line then
     2524       do:
     2525         run re-open-query-srt-clmnbr-pump in this-procedure.
     2526       end.
     2527     end.
     2528   ON ROW-DISPLAY OF br-line IN FRAME d-rvs
     2529     DO:
     2530     define variable vChkColor as log no-undo.
     2531       if avail r-doc and
     2532          (r-doc.rvs-type  = 'перед_док':U or
     2533           r-doc.rvs-type  = 'после_док':U) then
     2534       do:
     2535          do ii = 1 to 37:
     2536             bcol[ii]:FGcolor  = 7.
     2537          end.
     2538       end.
     2539       else if available ub.rvs-line then
     2540       do:
     2541         find first buf_rvs-line-attr no-lock
     2542           where buf_rvs-line-attr.attr-code = "rvd-on"
     2543           and buf_rvs-line-attr.gds-code = ub.rvs-line.gds-code
     2544           and buf_rvs-line-attr.obj-code = ub.rvs-line.obj-code
     2545           and buf_rvs-line-attr.obj-type = ub.rvs-line.obj-type
     2546           and buf_rvs-line-attr.pl-code  = ub.rvs-line.pl-code
     2547           and buf_rvs-line-attr.rvs-code = ub.rvs-line.rvs-code
     2548           no-error .
     2549         if available buf_rvs-line-attr and
     2550           buf_rvs-line-attr.attr-value > ""
     2551           then
     2552         do:
     2553           do ii = 1 to 37:
     2554             bcol[ii]:FGcolor  = 7.
     2555           end.
     2556         end.
     2557         else if avail r-doc then
     2558         do:
     2559            if can-find(first buf_doc-attr no-lock where
     2560                        buf_doc-attr.doc-code = r-doc.rvs-code
     2561                    and buf_doc-attr.attr-code = "rvs-auto"
     2562                    and buf_doc-attr.attr-value = "Yes") then
     2563            do:
     2564               run CheckColorSkip in this-procedure
     2565                        (r-doc.obj-type,
     2566                         r-doc.obj-code,
     2567                         r-doc.shift-date,
     2568                         r-doc.shift-num,
     2569                         ub.rvs-line.pl-code,
     2570                         ub.rvs-line.gds-code,
     2571                         r-doc.sys-date,
     2572                         r-doc.sys-time-int,
     2573                         output vChkColor).
     2574                if vChkColor then
     2575                   do ii = 1 to 37:
     2576                      bcol[ii]:FGcolor  = 7.
     2577                   end.
     2578            end.
     2579         end.
     2580       end.
     2581     END.
     2582   if valid-handle(active-window) and frame d-rvs:parent eq ?
     2583     then frame d-rvs:parent = active-window.
     2584   on window-close of frame d-rvs
     2585     apply "end-error":u to self.
     2586   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587   on help of frame d-rvs
     2588   do:
     2589     run gbl/app_help.p
     2590       (input this-procedure :file-name
     2591       ,input ''
     2592       ,input ?
     2593       ) no-error.
     2594     if error-status :error then do:
     2595       message
     2596         "Ошибка при вызове помощи"
     2597         error-status :get-message(1)
     2598         view-as alert-box .
     2599     end.
     2600   end.
     2601   run minbtn-set in this-procedure .
     2602   on choose of b-help in frame d-rvs
     2603   do:
     2604     apply "help":u to frame d-rvs .
     2605   end.
     2606   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2607   procedure minbtn-set :
     2608       do
     2609           on error undo, return error return-value
     2610           :
     2611           define variable ii              as integer       no-undo .
     2612           define variable fh              as widget-handle no-undo .
     2613           define variable hh              as widget-handle no-undo .
     2614           define variable v-h             as handle        extent 4 no-undo .
     2615           define variable v-name-button   as character     no-undo .
     2616           define variable v-help-old-x    as decimal       no-undo .
     2617           define variable v-help-old-y    as decimal       no-undo .
     2618           define variable v-help-old-size as decimal       no-undo .
     2619           define variable v-frame-width   as decimal       no-undo .
     2620           define variable jj              as integer       no-undo .
     2621           do
     2622               on error undo, return error
     2623               :
     2624               assign
     2625                   v-frame-width = frame d-rvs:width - 0.3
     2626                   fh            = frame d-rvs:first-child
     2627                   hh            = fh:first-child
     2628                   ii            = 1
     2629                   .
     2630               do while valid-handle(hh):
     2631                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2632                   do:
     2633                       case lc(hh:name) :
     2634                           when "b-help" then
     2635                               do:
     2636                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2637                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2638                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2639                                   hh:TOOLTIP = "Помощь" .
     2640                                   v-help-old-x = hh:column .
     2641                                   v-help-old-y = hh:row    .
     2642                                   v-help-old-size = hh:width .
     2643                                   hh:width-chars = 2.5 .
     2644                               end.
     2645                           when "b-print" then
     2646                               do:
     2647                                   hh:load-image("cmp/b-print.bmp":u) .
     2648                                   hh:TOOLTIP = "Печать" .
     2649                                   v-h[ii] = hh:handle .
     2650                                   ii = ii + 1 .
     2651                                   hh:width-chars = 3 .
     2652                               end.
     2653                           when "b-history" or
     2654                           when "b-hist" then
     2655                               do:
     2656                                   hh:load-image("cmp/b-hist.bmp":u) .
     2657                                   hh:TOOLTIP = "История" .
     2658                                   v-h[ii] = hh:handle .
     2659                                   ii = ii + 1 .
     2660                                   hh:width-chars = 3 .
     2661                               end.
     2662                           when "b-sch" then
     2663                               do:
     2664                                   hh:load-image("cmp/b-sch.bmp":u) .
     2665                                   hh:TOOLTIP = "Установка Фильтра" .
     2666                                   v-h[ii] = hh:handle .
     2667                                   ii = ii + 1 .
     2668                                   hh:width-chars = 3 .
     2669                               end.
     2670                           when "b-hist-user" then
     2671                               do:
     2672                                   hh:load-image("cmp/b-hist.bmp":u) .
     2673                                   hh:TOOLTIP = "История пользователя" .
     2674                                   ii = ii + 1 .
     2675                               end.
     2676                       end case.
     2677                   end.
     2678                   hh = hh:next-sibling.
     2679               end.
     2680               b-help:column = v-frame-width - b-help:width-chars.
     2681               jj = 0.
     2682               repeat ii = 4 to 1 by -1 :
     2683                   if valid-handle (v-h[ii] ) then
     2684                   do:
     2685                       jj  = jj + 1 .
     2686                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2687                       v-h[ii]:row    = v-help-old-y .
     2688                   end.
     2689               end.
     2690           end.
     2691       end.
     2692   end procedure.
     2693   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2694   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2695   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2696   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2697   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2698   define variable v-diasize-current-frame-height as decimal   no-undo .
     2699   define variable v-diasize-change-size          as logical   no-undo .
     2700   define variable v-diasize-resize-button        as handle    no-undo .
     2701   define variable v-diasize-wndmax               as logical   no-undo .
     2702   define variable v-diasize-wndstore             as logical   no-undo .
     2703   define variable v-diasize-proc-name            as character no-undo .
     2704   define variable v-diasize-browse-handle        as handle    no-undo .
     2705   define variable v-diasize-browse-number        as integer   no-undo .
     2706   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2707   define temp-table temp-diasize-handle no-undo
     2708     field handle-value  as handle
     2709     field save-position as decimal
     2710     index xpk is primary unique handle-value
     2711     .
     2712   define temp-table temp-browse-handle no-undo
     2713     field browse-type   as character
     2714     field browse-number as integer
     2715     field browse-handle as handle
     2716     field original-size as decimal
     2717     index xpk is primary unique browse-type browse-number
     2718     index xie browse-type browse-handle
     2719   .
     2720   procedure diasize_change-height :
     2721     define input  parameter p-change-value  as decimal   no-undo .
     2722     define input  parameter p-move-resize   as logical   no-undo .
     2723     define variable v-field-group-handle    as handle    no-undo .
     2724     define variable v-object-handle         as handle    no-undo .
     2725     define variable v-frame-height          as decimal   no-undo .
     2726     define variable v-frame-virtual-height  as decimal   no-undo .
     2727     define variable v-browse-height         as decimal   no-undo .
     2728     define variable v-window-height         as decimal   no-undo .
     2729     define variable v-window-virtual-height as decimal   no-undo .
     2730     define variable v-change-sign           as integer   no-undo .
     2731     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2732     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2733     if p-change-value > 0
     2734     then do:
     2735       if frame d-rvs :height + p-change-value
     2736           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2737       then do:
     2738         assign
     2739           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2740                           - (frame d-rvs :height-chars)
     2741         .
     2742         if p-change-value <= 0
     2743         then do:
     2744           run diasize_position-resize-button in this-procedure .
     2745           return .
     2746         end.
     2747       end.
     2748     end.
     2749     if p-change-value < 0
     2750     then do:
     2751       if frame d-rvs :height + p-change-value < v-diasize-orig-frame-height
     2752       then do:
     2753         assign
     2754           p-change-value = v-diasize-orig-frame-height
     2755                          - (frame d-rvs :height-chars)
     2756         .
     2757         if p-change-value >= 0
     2758         then do:
     2759           run diasize_position-resize-button in this-procedure .
     2760           return .
     2761         end.
     2762       end.
     2763     end.
     2764     if p-change-value >= 0
     2765     then do:
     2766       assign
     2767         v-change-sign = 1
     2768       .
     2769     end.
     2770     else do:
     2771       assign
     2772         v-change-sign = -1
     2773       .
     2774     end.
     2775     assign
     2776       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2777     .
     2778     if p-change-value = 0
     2779     then do:
     2780       run diasize_position-resize-button in this-procedure .
     2781       return .
     2782     end.
     2783     move_block:
     2784     do
     2785     on error undo move_block, retry move_block
     2786     :
     2787       if retry
     2788       then do:
     2789         do
     2790         on error undo move_block, leave move_block
     2791         :
     2792           if p-change-value > 0
     2793           then do:
     2794             for each buf_temp-diasize-handle
     2795             on error undo, next
     2796             :
     2797               assign
     2798                 v-object-handle = buf_temp-diasize-handle.handle-value
     2799               .
     2800               if v-object-handle <> v-diasize-resize-button
     2801               then do:
     2802                 assign
     2803                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2804                 .
     2805               end.
     2806             end.
     2807             assign
     2808               v-diasize-browse-handle :height = v-browse-height
     2809             .
     2810             for each buf_temp-browse-handle
     2811               where buf_temp-browse-handle.browse-type = 'height':u
     2812             on error undo, next
     2813             :
     2814               assign
     2815                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2816               .
     2817             end.
     2818             assign
     2819               frame d-rvs :height = v-frame-height
     2820             .
     2821             if frame d-rvs :scrollable = true
     2822             then do:
     2823               assign
     2824                 frame d-rvs :virtual-height = v-frame-virtual-height
     2825               .
     2826             end.
     2827             run diasize_position-resize-button in this-procedure .
     2828           end.
     2829           else do:
     2830             if frame d-rvs :scrollable = true
     2831             then do:
     2832               assign
     2833                 frame d-rvs :virtual-height = v-frame-virtual-height
     2834               .
     2835             end.
     2836             assign
     2837               frame d-rvs :height = v-frame-height
     2838             .
     2839             assign
     2840               v-diasize-browse-handle :height = v-browse-height
     2841             .
     2842             for each buf_temp-browse-handle
     2843               where buf_temp-browse-handle.browse-type = 'height':u
     2844             on error undo, next
     2845             :
     2846               assign
     2847                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2848               .
     2849             end.
     2850             for each buf_temp-diasize-handle
     2851             on error undo, next
     2852             :
     2853               assign
     2854                 v-object-handle = buf_temp-diasize-handle.handle-value
     2855               .
     2856               if v-object-handle <> v-diasize-resize-button
     2857               then do:
     2858                 assign
     2859                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2860                 .
     2861               end.
     2862             end.
     2863             run diasize_position-resize-button in this-procedure .
     2864           end.
     2865           assign
     2866             v-diasize-change-size = false
     2867           .
     2868           leave move_block .
     2869         end.
     2870       end.
     2871       assign
     2872         v-diasize-need-full-display = true
     2873       .
     2874       if v-diasize-change-size = false
     2875       then do:
     2876         assign
     2877           v-diasize-change-size = true
     2878         .
     2879       end.
     2880       else do:
     2881         return .
     2882       end.
     2883       assign
     2884         v-frame-height = frame d-rvs :height
     2885         v-frame-virtual-height = frame d-rvs :virtual-height
     2886         v-browse-height = v-diasize-browse-handle :height
     2887       .
     2888       for each buf_temp-browse-handle
     2889         where buf_temp-browse-handle.browse-type = 'height':u
     2890       :
     2891         assign
     2892           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2893         .
     2894       end.
     2895       for each buf_temp-diasize-handle
     2896       :
     2897         delete buf_temp-diasize-handle .
     2898       end.
     2899       assign
     2900         v-field-group-handle = frame d-rvs :first-child
     2901       .
     2902       do while valid-handle(v-field-group-handle)
     2903       :
     2904         assign
     2905           v-object-handle = v-field-group-handle :first-child
     2906         .
     2907         do while valid-handle(v-object-handle)
     2908         :
     2909           if  v-object-handle <> v-diasize-browse-handle :handle
     2910           and can-query(v-object-handle, "row")
     2911           and can-query(v-object-handle, "height")
     2912           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2913           then do:
     2914             find first buf_temp-browse-handle
     2915               where buf_temp-browse-handle.browse-type   = 'height':u
     2916                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2917               no-error .
     2918             if available buf_temp-browse-handle
     2919             then do:
     2920             end.
     2921             else do:
     2922               create buf_temp-diasize-handle .
     2923               assign
     2924                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2925                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2926               .
     2927             end.
     2928           end.
     2929           assign
     2930             v-object-handle = v-object-handle :next-sibling
     2931           .
     2932         end.
     2933         assign
     2934           v-field-group-handle = v-field-group-handle :next-sibling
     2935         .
     2936       end.
     2937       do with frame d-rvs
     2938       :
     2939         hide v-diasize-resize-button .
     2940         assign
     2941           v-diasize-resize-button :row    = 1
     2942           v-diasize-resize-button :column = 1
     2943         .
     2944       end.
     2945       if p-change-value > 0
     2946       then do:
     2947         if frame d-rvs :scrollable = true
     2948         then do:
     2949           assign
     2950             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     2951             no-error .
     2952           if error-status :error
     2953           or error-status :get-message(1) <> ""
     2954           then do:
     2955             undo move_block, retry move_block .
     2956           end.
     2957         end.
     2958         assign
     2959           frame d-rvs :height = frame d-rvs :height + p-change-value
     2960           no-error .
     2961         if error-status :error
     2962         or error-status :get-message(1) <> ""
     2963         then do:
     2964           undo move_block, retry move_block .
     2965         end.
     2966         assign
     2967           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2968           no-error .
     2969         if error-status :error
     2970         or error-status :get-message(1) <> ""
     2971         then do:
     2972           undo move_block, retry move_block .
     2973         end.
     2974         for each buf_temp-browse-handle
     2975           where buf_temp-browse-handle.browse-type = 'height':u
     2976         on error undo move_block, retry move_block
     2977         :
     2978           assign
     2979             buf_temp-browse-handle.browse-handle :height
     2980               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2981             no-error .
     2982           if error-status :error
     2983           or error-status :get-message(1) <> ""
     2984           then do:
     2985             undo move_block, retry move_block .
     2986           end.
     2987         end.
     2988         for each buf_temp-diasize-handle
     2989         on error undo move_block, retry move_block
     2990         :
     2991           assign
     2992             v-object-handle = buf_temp-diasize-handle.handle-value
     2993           .
     2994           if v-object-handle <> v-diasize-resize-button
     2995           then do:
     2996             assign
     2997               v-object-handle :row = v-object-handle :row + p-change-value
     2998               no-error .
     2999             if error-status :error
     3000             or error-status :get-message(1) <> ""
     3001             then do:
     3002               undo move_block, retry move_block .
     3003             end.
     3004           end.
     3005         end.
     3006       end.
     3007       else do:
     3008         for each buf_temp-diasize-handle
     3009         on error undo move_block, retry move_block
     3010         :
     3011           assign
     3012             v-object-handle = buf_temp-diasize-handle.handle-value
     3013           .
     3014           if v-object-handle <> v-diasize-resize-button
     3015           then do:
     3016             assign
     3017               v-object-handle :row = v-object-handle :row + p-change-value
     3018               no-error .
     3019             if error-status :error
     3020             or error-status :get-message(1) <> ""
     3021             then do:
     3022               undo move_block, retry move_block .
     3023             end.
     3024           end.
     3025         end.
     3026         assign
     3027           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3028           no-error .
     3029         if error-status :error
     3030         or error-status :get-message(1) <> ""
     3031         then do:
     3032           undo move_block, retry move_block .
     3033         end.
     3034         for each buf_temp-browse-handle
     3035           where buf_temp-browse-handle.browse-type = 'height':u
     3036         on error undo move_block, retry move_block
     3037         :
     3038           assign
     3039             buf_temp-browse-handle.browse-handle :height
     3040               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3041             no-error .
     3042           if error-status :error
     3043           or error-status :get-message(1) <> ""
     3044           then do:
     3045             undo move_block, retry move_block .
     3046           end.
     3047         end.
     3048         assign
     3049           frame d-rvs :height = frame d-rvs :height + p-change-value
     3050           no-error .
     3051         if error-status :error
     3052         or error-status :get-message(1) <> ""
     3053         then do:
     3054           undo move_block, retry move_block .
     3055         end.
     3056         if frame d-rvs :scrollable = true
     3057         then do:
     3058           assign
     3059             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     3060             no-error .
     3061           if error-status :error
     3062           or error-status :get-message(1) <> ""
     3063           then do:
     3064             undo move_block, retry move_block .
     3065           end.
     3066         end.
     3067       end.
     3068       if p-move-resize = true
     3069       then do:
     3070         run diasize_position-resize-button in this-procedure .
     3071       end.
     3072       if v-diasize-wndstore = true
     3073       then do:
     3074         if connected("ub") = true
     3075         then do:
     3076           define variable v-cntxt-db-num        as integer   no-undo .
     3077           define variable v-cntxt-userid        as character no-undo .
     3078           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3079                                             , OUTPUT v-cntxt-userid
     3080                                             ) .
     3081           run gbl/wndsizew.p
     3082             (input  v-cntxt-db-num
     3083             ,input  v-cntxt-userid
     3084             ,input  v-diasize-proc-name
     3085             ,input  'height':u
     3086             ,input  string(frame d-rvs :height - v-diasize-orig-frame-height)
     3087             ) .
     3088         end.
     3089       end.
     3090     end.
     3091     assign
     3092       v-diasize-change-size = false
     3093     .
     3094   end procedure.
     3095   procedure diasize_set-height :
     3096     define input  parameter p-new-height  as decimal   no-undo .
     3097     define input  parameter p-move-resize as logical   no-undo .
     3098     do
     3099     on error undo, return error return-value
     3100     :
     3101       run diasize_change-height in this-procedure
     3102         (input  (p-new-height - frame d-rvs :height)
     3103         ,input  p-move-resize
     3104         ) .
     3105     end.
     3106   end procedure.
     3107   procedure diasize_change-width :
     3108     define input  parameter p-change-value as decimal   no-undo .
     3109     define input  parameter p-move-resize  as logical   no-undo .
     3110     define variable v-field-group-handle   as handle    no-undo .
     3111     define variable v-object-handle        as handle    no-undo .
     3112     define variable v-frame-width          as decimal   no-undo .
     3113     define variable v-frame-virtual-width  as decimal   no-undo .
     3114     define variable v-browse-width         as decimal   no-undo .
     3115     define variable v-window-width         as decimal   no-undo .
     3116     define variable v-window-virtual-width as decimal   no-undo .
     3117     define variable v-change-sign          as integer   no-undo .
     3118     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3119     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3120     if p-change-value > 0
     3121     then do:
     3122       if frame d-rvs :width + p-change-value >
     3123           session :width-chars
     3124       then do:
     3125         assign
     3126           p-change-value = session :width-chars - frame d-rvs :width
     3127         .
     3128         if p-change-value <= 0
     3129         then do:
     3130           run diasize_position-resize-button in this-procedure .
     3131           return .
     3132         end.
     3133       end.
     3134     end.
     3135     if p-change-value < 0
     3136     then do:
     3137       if frame d-rvs :width + p-change-value < v-diasize-orig-frame-width
     3138       then do:
     3139         assign
     3140           p-change-value = v-diasize-orig-frame-width
     3141                          - frame d-rvs :width
     3142         .
     3143         if p-change-value >= 0
     3144         then do:
     3145           run diasize_position-resize-button in this-procedure .
     3146           return .
     3147         end.
     3148       end.
     3149     end.
     3150     if p-change-value >= 0
     3151     then do:
     3152       assign
     3153         v-change-sign = 1
     3154       .
     3155     end.
     3156     else do:
     3157       assign
     3158         v-change-sign = -1
     3159       .
     3160     end.
     3161     assign
     3162       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3163     .
     3164     if p-change-value = 0
     3165     then do:
     3166       run diasize_position-resize-button in this-procedure .
     3167       return .
     3168     end.
     3169     move_block:
     3170     do
     3171     on error undo move_block, leave move_block
     3172     :
     3173       if retry
     3174       then do:
     3175         do
     3176         on error undo move_block, leave move_block
     3177         :
     3178           if p-change-value > 0
     3179           then do:
     3180             for each buf_temp-diasize-handle
     3181             on error undo, next
     3182             :
     3183               assign
     3184                 v-object-handle = buf_temp-diasize-handle.handle-value
     3185               .
     3186               if v-object-handle <> v-diasize-resize-button
     3187               then do:
     3188                 assign
     3189                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3190                 .
     3191               end.
     3192             end.
     3193             assign
     3194               v-diasize-browse-handle :width = v-browse-width
     3195             .
     3196             for each buf_temp-browse-handle
     3197               where buf_temp-browse-handle.browse-type = 'width':u
     3198             on error undo, next
     3199             :
     3200               assign
     3201                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3202               .
     3203             end.
     3204             assign
     3205               frame d-rvs :width = v-frame-width
     3206             .
     3207             if frame d-rvs :scrollable = true
     3208             then do:
     3209               assign
     3210                 frame d-rvs :virtual-width = v-frame-virtual-width
     3211               .
     3212             end.
     3213             run diasize_position-resize-button in this-procedure .
     3214           end.
     3215           else do:
     3216             if frame d-rvs :scrollable = true
     3217             then do:
     3218               assign
     3219                 frame d-rvs :virtual-width = v-frame-virtual-width
     3220               .
     3221             end.
     3222             assign
     3223               frame d-rvs :width = v-frame-width
     3224             .
     3225             for each buf_temp-browse-handle
     3226               where buf_temp-browse-handle.browse-type = 'width':u
     3227             on error undo, next
     3228             :
     3229               assign
     3230                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3231               .
     3232             end.
     3233             assign
     3234               v-diasize-browse-handle :width = v-browse-width
     3235             .
     3236             for each buf_temp-diasize-handle
     3237             on error undo, next
     3238             :
     3239               assign
     3240                 v-object-handle = buf_temp-diasize-handle.handle-value
     3241               .
     3242               if v-object-handle <> v-diasize-resize-button
     3243               then do:
     3244                 assign
     3245                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3246                 .
     3247               end.
     3248             end.
     3249             run diasize_position-resize-button in this-procedure .
     3250           end.
     3251           assign
     3252             v-diasize-change-size = false
     3253           .
     3254           leave move_block .
     3255         end.
     3256       end.
     3257       assign
     3258         v-diasize-need-full-display = true
     3259       .
     3260       if v-diasize-change-size = false
     3261       then do:
     3262         assign
     3263           v-diasize-change-size = true
     3264         .
     3265       end.
     3266       else do:
     3267         return .
     3268       end.
     3269       assign
     3270         v-frame-width = frame d-rvs :width
     3271         v-frame-virtual-width = frame d-rvs :virtual-width
     3272         v-browse-width = v-diasize-browse-handle :width
     3273       .
     3274       for each buf_temp-browse-handle
     3275         where buf_temp-browse-handle.browse-type = 'width':u
     3276       :
     3277         assign
     3278           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3279         .
     3280       end.
     3281       for each buf_temp-diasize-handle
     3282       :
     3283         delete buf_temp-diasize-handle .
     3284       end.
     3285       assign
     3286         v-field-group-handle = frame d-rvs :first-child
     3287       .
     3288       do while valid-handle(v-field-group-handle)
     3289       :
     3290         assign
     3291           v-object-handle = v-field-group-handle :first-child
     3292         .
     3293         do while valid-handle(v-object-handle)
     3294         :
     3295           if  v-object-handle <> v-diasize-browse-handle :handle
     3296           and v-object-handle <> v-diasize-resize-button
     3297           and can-query(v-object-handle, "row")
     3298           and can-query(v-object-handle, "height")
     3299           and ( v-object-handle :col + v-object-handle :width
     3300                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3301               )
     3302           then do:
     3303             find first buf_temp-browse-handle
     3304               where buf_temp-browse-handle.browse-type   = 'width':u
     3305                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3306               no-error .
     3307             if available buf_temp-browse-handle
     3308             then do:
     3309             end.
     3310             else do:
     3311               create buf_temp-diasize-handle .
     3312               assign
     3313                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3314                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3315               .
     3316             end.
     3317           end.
     3318           assign
     3319             v-object-handle = v-object-handle :next-sibling
     3320           .
     3321         end.
     3322         assign
     3323           v-field-group-handle = v-field-group-handle :next-sibling
     3324         .
     3325       end.
     3326       do with frame d-rvs
     3327       :
     3328         hide v-diasize-resize-button .
     3329         v-diasize-resize-button :row = 1.
     3330         v-diasize-resize-button :column = 1.
     3331       end.
     3332       if p-change-value > 0
     3333       then do:
     3334         if frame d-rvs :scrollable = true
     3335         then do:
     3336           assign
     3337             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     3338             no-error .
     3339           if error-status :error
     3340           or error-status :get-message(1) <> ""
     3341           then do:
     3342             undo move_block, retry move_block.
     3343           end.
     3344         end.
     3345         assign
     3346           frame d-rvs :width = v-frame-width + p-change-value
     3347           no-error .
     3348         if error-status :error
     3349         or error-status :get-message(1) <> ""
     3350         then do:
     3351           undo move_block, retry move_block.
     3352         end.
     3353         assign
     3354           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3355         no-error .
     3356         if error-status :error
     3357         or error-status :get-message(1) <> ""
     3358         then do:
     3359           undo move_block, retry move_block.
     3360         end.
     3361         for each buf_temp-browse-handle
     3362           where buf_temp-browse-handle.browse-type = 'width':u
     3363         on error undo move_block, retry move_block
     3364         :
     3365           assign
     3366             buf_temp-browse-handle.browse-handle :width
     3367               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3368             no-error .
     3369           if error-status :error
     3370           or error-status :get-message(1) <> ""
     3371           then do:
     3372             undo move_block, retry move_block .
     3373           end.
     3374         end.
     3375         for each buf_temp-diasize-handle
     3376         on error undo move_block, retry move_block
     3377         :
     3378           assign
     3379             v-object-handle = buf_temp-diasize-handle.handle-value
     3380           .
     3381           if v-object-handle <> v-diasize-resize-button
     3382           then do:
     3383             assign
     3384               v-object-handle :col = v-object-handle :col + p-change-value
     3385               no-error .
     3386             if error-status :error
     3387             or error-status :get-message(1) <> ""
     3388             then do:
     3389               undo move_block, retry move_block .
     3390             end.
     3391           end.
     3392         end.
     3393       end.
     3394       else do:
     3395         for each buf_temp-diasize-handle
     3396         on error undo move_block, retry move_block
     3397         :
     3398           assign
     3399             v-object-handle = buf_temp-diasize-handle.handle-value
     3400           .
     3401           if v-object-handle <> v-diasize-resize-button
     3402           then do:
     3403             assign
     3404               v-object-handle :col = v-object-handle :col + p-change-value
     3405               no-error .
     3406             if error-status :error
     3407             or error-status :get-message(1) <> ""
     3408             then do:
     3409               undo move_block, retry move_block .
     3410             end.
     3411           end.
     3412         end.
     3413         for each buf_temp-browse-handle
     3414           where buf_temp-browse-handle.browse-type = 'width':u
     3415         on error undo move_block, retry move_block
     3416         :
     3417           assign
     3418             buf_temp-browse-handle.browse-handle :width
     3419               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3420             no-error .
     3421           if error-status :error
     3422           or error-status :get-message(1) <> ""
     3423           then do:
     3424             undo move_block, retry move_block .
     3425           end.
     3426         end.
     3427         assign
     3428           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3429           no-error .
     3430         if error-status :error
     3431         or error-status :get-message(1) <> ""
     3432         then do:
     3433           undo move_block, retry move_block.
     3434         end.
     3435         assign
     3436           frame d-rvs :width = frame d-rvs :width + p-change-value
     3437         no-error .
     3438         if error-status :error
     3439         or error-status :get-message(1) <> ""
     3440         then do:
     3441           undo move_block, retry move_block.
     3442         end.
     3443         if frame d-rvs :scrollable = true
     3444         then do:
     3445           assign
     3446             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     3447           no-error .
     3448           if error-status :error
     3449           or error-status :get-message(1) <> ""
     3450           then do:
     3451             undo move_block, retry move_block.
     3452           end.
     3453         end.
     3454       end.
     3455       if p-move-resize
     3456       then do:
     3457         run diasize_position-resize-button in this-procedure .
     3458       end.
     3459       if v-diasize-wndstore = true
     3460       then do:
     3461         if connected("ub") = true
     3462         then do:
     3463           define variable v-cntxt-db-num        as integer   no-undo .
     3464           define variable v-cntxt-userid        as character no-undo .
     3465           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3466                                             , OUTPUT v-cntxt-userid
     3467                                             ) .
     3468           run gbl/wndsizew.p
     3469             (input  v-cntxt-db-num
     3470             ,input  v-cntxt-userid
     3471             ,input  v-diasize-proc-name
     3472             ,input  'width':u
     3473             ,input  string(frame d-rvs :width - v-diasize-orig-frame-width)
     3474             ) .
     3475         end.
     3476       end.
     3477     end.
     3478     assign
     3479       v-diasize-change-size = false
     3480     .
     3481   end procedure.
     3482   procedure diasize_set-width :
     3483     define input  parameter p-new-width  as decimal   no-undo .
     3484     define input  parameter p-move-resize as logical   no-undo .
     3485     do
     3486     on error undo, return error return-value
     3487     :
     3488       run diasize_change-width in this-procedure
     3489         (input  (p-new-width - frame d-rvs :width)
     3490         ,input  p-move-resize
     3491         ) .
     3492     end.
     3493   end procedure.
     3494   procedure diasize_position-resize-button :
     3495     do with frame d-rvs
     3496     :
     3497       hide v-diasize-resize-button .
     3498       assign
     3499         v-diasize-resize-button :row = frame d-rvs :height - v-diasize-resize-button :height
     3500                     - 1
     3501                     - (frame d-rvs :border-bottom-pixels / session :pixels-per-row)
     3502         v-diasize-resize-button :col = frame d-rvs :width - v-diasize-resize-button :width
     3503                     - 1
     3504                     - (frame d-rvs :border-right-pixels / session :pixels-per-column)
     3505       .
     3506       view v-diasize-resize-button .
     3507     end.
     3508   end procedure.
     3509   on alt-right anywhere
     3510   do:
     3511     run diasize_change-width in this-procedure
     3512       (input 1
     3513       ,input true
     3514       ) .
     3515     return no-apply .
     3516   end.
     3517   on alt-left anywhere
     3518   do:
     3519     run diasize_change-width in this-procedure
     3520       (input -1
     3521       ,input true
     3522       ) .
     3523     return no-apply .
     3524   end.
     3525   on alt-down anywhere
     3526   do:
     3527     run diasize_change-height in this-procedure
     3528       (input 1
     3529       ,input true
     3530       ) .
     3531     return no-apply .
     3532   end.
     3533   on alt-up anywhere
     3534   do:
     3535     run diasize_change-height in this-procedure
     3536       (input -1
     3537       ,input true
     3538       ) .
     3539     return no-apply .
     3540   end.
     3541   on alt-enter of frame d-rvs
     3542   do:
     3543     run diasize_maximize in this-procedure
     3544       (input  ?
     3545       ).
     3546     return no-apply .
     3547   end.
     3548   procedure diasize_end-move :
     3549     do
     3550     on error undo, return error return-value
     3551     :
     3552       define variable v-row-delta as decimal   no-undo .
     3553       define variable v-col-delta as decimal   no-undo .
     3554       define variable v-new-row as decimal   no-undo .
     3555       define variable v-new-col as decimal   no-undo .
     3556       assign
     3557         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3558         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3559       .
     3560       assign
     3561         v-row-delta = v-new-row - frame d-rvs :height
     3562         v-col-delta = v-new-col - frame d-rvs :width
     3563       .
     3564       run diasize_change-height in this-procedure
     3565         (input v-row-delta
     3566         ,input true
     3567         ) .
     3568       run diasize_change-width in this-procedure
     3569         (input v-col-delta
     3570         ,input true
     3571         ) .
     3572     end.
     3573   end procedure.
     3574   procedure diasize_maximize :
     3575     define input  parameter p-action as logical   no-undo .
     3576     do
     3577     on error undo, return error return-value
     3578     :
     3579       if p-action = ?
     3580       then do:
     3581         if v-diasize-need-maximize = true
     3582         then do:
     3583           assign
     3584             p-action = true
     3585           .
     3586         end.
     3587         else do:
     3588           assign
     3589             p-action = false
     3590           .
     3591         end.
     3592       end.
     3593       if p-action = true
     3594       then do:
     3595         run diasize_change-height in this-procedure
     3596           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3597               - frame d-rvs :height-chars
     3598           ,input true
     3599           ) .
     3600         run diasize_change-width in this-procedure
     3601           (input session :width-chars
     3602               - frame d-rvs :width-chars
     3603           ,input true
     3604           ) .
     3605         assign
     3606           v-diasize-need-maximize = false
     3607         .
     3608       end.
     3609       else do:
     3610         run diasize_change-width in this-procedure
     3611           (input v-diasize-orig-frame-width
     3612               - frame d-rvs :width-chars
     3613           ,input true
     3614           ) .
     3615         run diasize_change-height in this-procedure
     3616           (input v-diasize-orig-frame-height
     3617               - frame d-rvs :height-chars
     3618           ,input true
     3619           ) .
     3620         assign
     3621           v-diasize-need-maximize = true
     3622         .
     3623       end.
     3624     end.
     3625   end procedure.
     3626   procedure diasize_restore-orig-size :
     3627     do
     3628     on error undo, return error return-value
     3629     :
     3630       assign
     3631         v-diasize-current-frame-width  = frame d-rvs :width
     3632         v-diasize-current-frame-height = frame d-rvs :height
     3633       .
     3634       run diasize_set-height in this-procedure
     3635         (input  v-diasize-orig-frame-height
     3636         ,input  true
     3637         ) .
     3638       run diasize_set-width in this-procedure
     3639         (input  v-diasize-orig-frame-width
     3640         ,input  true
     3641         ) .
     3642     end.
     3643   end procedure.
     3644   procedure diasize_restore-current-size :
     3645     do
     3646     on error undo, return error return-value
     3647     :
     3648       run diasize_set-height in this-procedure
     3649         (input  v-diasize-current-frame-height
     3650         ,input  true
     3651         ) .
     3652       run diasize_set-width in this-procedure
     3653         (input  v-diasize-current-frame-width
     3654         ,input  true
     3655         ) .
     3656     end.
     3657   end procedure.
     3658   procedure diasize_set-browse-handle :
     3659     define input  parameter p-browse-handle as handle   no-undo .
     3660     define buffer buf_temp-browse-handle for temp-browse-handle .
     3661     do
     3662     on error undo, return error return-value
     3663     :
     3664       assign
     3665         v-diasize-browse-handle = p-browse-handle
     3666       .
     3667       for each buf_temp-browse-handle
     3668       on error undo, return error return-value
     3669       :
     3670         delete buf_temp-browse-handle .
     3671       end.
     3672     end.
     3673   end procedure.
     3674   procedure diasize_add_browse :
     3675     define input  parameter p-browse-type   as character no-undo .
     3676     define input  parameter p-browse-handle as handle    no-undo .
     3677     define buffer buf_temp-browse-handle for temp-browse-handle .
     3678     do
     3679     on error undo, return error return-value
     3680     :
     3681       assign
     3682         v-diasize-browse-number = v-diasize-browse-number + 1
     3683       .
     3684       create buf_temp-browse-handle .
     3685       assign
     3686         buf_temp-browse-handle.browse-type   = p-browse-type
     3687         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3688         buf_temp-browse-handle.browse-handle = p-browse-handle
     3689       .
     3690     end.
     3691   end procedure.
     3692   procedure diasize_init :
     3693     define variable v-default-value    as logical   no-undo .
     3694     define variable v-restore-saved    as logical   no-undo .
     3695     define variable v-resize-value-str as character no-undo .
     3696     do
     3697     on error undo, return error return-value
     3698     :
     3699       do with frame d-rvs
     3700       :
     3701         assign
     3702           v-diasize-orig-frame-height = frame d-rvs :height
     3703           v-diasize-orig-frame-width  = frame d-rvs :width
     3704           v-diasize-browse-handle     = browse br-line :handle
     3705         .
     3706         create button v-diasize-resize-button
     3707         assign
     3708           parent        = frame d-rvs :first-child
     3709           label         = "s"
     3710           height-pixels = 16
     3711           width-pixels  = 16
     3712           visible       = true
     3713           sensitive     = true
     3714           movable       = true
     3715           triggers:
     3716             on end-move persistent run diasize_end-move in this-procedure .
     3717           end triggers.
     3718         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3719         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3720         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3721         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3722         assign
     3723           v-diasize-wndmax = false
     3724         .
     3725         if connected("ub") = true
     3726         then do:
     3727           define variable v-cntxt-db-num        as integer   no-undo .
     3728           define variable v-cntxt-userid        as character no-undo .
     3729           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3730                                             , OUTPUT v-cntxt-userid
     3731                                             ) .
     3732           run gbl/wndpar_r.p
     3733             (input  v-cntxt-db-num
     3734             ,input  v-cntxt-userid
     3735             ,input  'wndmax':U
     3736             ,output v-diasize-wndmax
     3737             ,output v-default-value
     3738             ) .
     3739         end.
     3740         assign
     3741           v-diasize-wndstore = false
     3742         .
     3743         if connected("ub") = true
     3744         then do:
     3745           run gbl/wndpar_r.p
     3746             (input  v-cntxt-db-num
     3747             ,input  v-cntxt-userid
     3748             ,input  'wndstore':U
     3749             ,output v-diasize-wndstore
     3750             ,output v-default-value
     3751             ) .
     3752         end.
     3753         assign
     3754           v-diasize-proc-name = entry(1, program-name(2), '.')
     3755         .
     3756         if v-diasize-wndstore = true
     3757         then do:
     3758           assign
     3759             v-restore-saved = false
     3760           .
     3761           if connected("ub") = true
     3762           then do:
     3763             run gbl/wndsizer.p
     3764               (input  v-cntxt-db-num
     3765               ,input  v-cntxt-userid
     3766               ,input  v-diasize-proc-name
     3767               ,input  'height':u
     3768               ,output v-resize-value-str
     3769               ) .
     3770             if v-resize-value-str <> '':U
     3771             then do:
     3772               run diasize_change-height in this-procedure
     3773                 (input  integer(v-resize-value-str)
     3774                 ,input  true
     3775                 ) .
     3776               assign
     3777                 v-restore-saved = true
     3778               .
     3779             end.
     3780           end.
     3781           if connected("ub") = true
     3782           then do:
     3783             run gbl/wndsizer.p
     3784               (input  v-cntxt-db-num
     3785               ,input  v-cntxt-userid
     3786               ,input  v-diasize-proc-name
     3787               ,input  'width':u
     3788               ,output v-resize-value-str
     3789               ) .
     3790             if v-resize-value-str <> '':U
     3791             then do:
     3792               run diasize_change-width in this-procedure
     3793                 (input  integer(v-resize-value-str)
     3794                 ,input  true
     3795                 ) .
     3796               assign
     3797                 v-restore-saved = true
     3798               .
     3799             end.
     3800           end.
     3801           if v-restore-saved <> true
     3802           then do:
     3803             if v-diasize-wndmax = true
     3804             then do:
     3805               run diasize_maximize in this-procedure
     3806                 (input  true
     3807                 ) .
     3808             end.
     3809           end.
     3810         end.
     3811         else do:
     3812           if v-diasize-wndmax = true
     3813           then do:
     3814             run diasize_maximize in this-procedure
     3815               (input  true
     3816               ) .
     3817           end.
     3818         end.
     3819       end.
     3820     end.
     3821   end procedure.
     3822   procedure diasize_need-full-display :
     3823     define output parameter p-need-full-display as logical   no-undo .
     3824     do
     3825     on error undo, return error return-value
     3826     :
     3827       assign
     3828         p-need-full-display = v-diasize-need-full-display
     3829       .
     3830       assign
     3831         v-diasize-need-full-display = false
     3832       .
     3833     end.
     3834   end procedure.
     3835   procedure get-context :
     3836      define output parameter p-db-num as integer          no-undo.
     3837      define output parameter p-user-id as character        no-undo.
     3838      define variable v-login               as character    no-undo.
     3839      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3840      define buffer buf_user-login  for ub.user-login .
     3841      do
     3842      on error undo, return error
     3843      :
     3844            FIND FIRST buf_sys-ctrl no-lock.
     3845            ASSIGN
     3846               v-login = USERID("ub")
     3847               p-db-num = buf_sys-ctrl.db-num
     3848            .
     3849            FIND FIRST buf_user-login
     3850                 WHERE buf_user-login.db-num = p-db-num
     3851                   AND buf_user-login.user-login = v-login
     3852                 no-lock
     3853                 no-error
     3854                 .
     3855            IF AVAILABLE buf_user-login
     3856            THEN DO:
     3857               assign
     3858                  p-user-id = buf_user-login.user-id
     3859               .
     3860            END.
     3861      end.
     3862   end procedure.
     3863       run diasize_init in this-procedure .
     3864   main-block:
     3865   do on error   undo main-block, leave main-block
     3866     on end-key undo main-block, leave main-block
     3867     on stop    undo main-block, leave main-block:
     3868     do ii = 1 to 37:
     3869       bcol[ii] = br-line:get-browse-column(ii).
     3870     end.
     3871     run mode-on in this-procedure
     3872       no-error.
     3873     if error-status :error then
     3874     do:
     3875       return error return-value .
     3876     end.
     3877     if pardoc-mode <> 'ПРОСМОТР':U then
     3878     do:
     3879       assign
     3880         rvs-line-rec = ?
     3881         .
     3882     end.
     3883     run ui-on in this-procedure.
     3884     wait-for go of frame d-rvs focus b-add.
     3885   end.
     3886   run disable_ui in this-procedure.
     3887   procedure disable_ui :
     3888     hide frame d-rvs.
     3889   end procedure.
     3890   procedure ui-on :
     3891   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3892   run get-ptrl-prop in this-procedure
     3893     ( input r-doc.obj-type
     3894     , input r-doc.obj-code
     3895     ) .
     3896     if not error-status :error then do:
     3897       vTimeAutoSkip = if ptrlprop-autopump-skip-time <> ? then ptrlprop-autopump-skip-time else 0.
     3898     end.
     3899     del-list = "".
     3900     find first ub.clients where ub.clients.obj-type = r-doc.obj-type and
     3901       ub.clients.obj-code = r-doc.obj-code no-lock.
     3902     assign
     3903       frame d-rvs:title = "(" + substring (ub.clients.obj-name, 1, 35) +
     3904          ") :   ДОКУМЕНТ СВЕРКИ - " + r-doc.status_ + " № " + r-doc.rvs-code + "      - " + pardoc-mode.
     3905     disable all with frame d-rvs.
     3906     enable b-exit b-help b-lkp b-lkp-pump br-line br-pump b-history b-notes with frame d-rvs.
     3907     assign ub.rvs-line.temperature:read-only in browse br-line = yes
     3908          ub.rvs-line-pump.rvs-prev-code:read-only in browse br-pump = yes.
     3909     if r-doc.status_ = 'новый':U and
     3910       (pardoc-mode = 'ДОБАВЛЕНИЕ':U or
     3911       pardoc-mode = 'ИЗМЕНЕНИЕ':U        ) then
     3912     do:
     3913       enable r-doc.wrkr
     3914         r-doc.agnt
     3915         r-doc.boss
     3916         r-wrkr r-agnt r-boss
     3917         with frame d-rvs.
     3918       if r-doc.rvs-type <> 'смена':U and
     3919         not (r-doc.rvs-type = 'контроль':U and r-doc.is-full = yes) then
     3920         enable b-add b-del b-mark with frame d-rvs.
     3921       enable b-meas with frame d-rvs.
     3922     end.
     3923     if r-doc.status_ = 'разрешен':U and
     3924       pardoc-mode = 'ИЗМЕНЕНИЕ':U then
     3925     do:
     3926       enable b-chg b-chg-pump with frame d-rvs.
     3927     end.
     3928     if available ub.clients then disp ub.clients.obj-name with frame d-rvs.
     3929     else disp ? @ ub.clients.obj-name with frame d-rvs.
     3930     disp r-doc.obj-code
     3931       r-doc.obj-type
     3932       r-doc.doc-date
     3933       r-doc.state-measure-qnty
     3934       r-doc.measure-qnty
     3935       r-doc.system-qnty
     3936       r-doc.state-measure-cli-qnty
     3937       r-doc.measure-cli-qnty
     3938       r-doc.system-cli-qnty
     3939       r-doc.system-cli-avrg-qnty
     3940       r-doc.state-mh-qnty
     3941       r-doc.state-am-qnty
     3942       r-doc.state-cf-qnty
     3943       r-doc.out-code
     3944       with frame d-rvs.
     3945     for first ub.user-account-attr no-lock where ub.user-account-attr.user-id = v-cntxt-userid
     3946       and ub.user-account-attr.attr-code = "psn-code"
     3947       :
     3948       if ub.user-account-attr.attr-value <> ""
     3949         and ub.user-account-attr.attr-value <> ?
     3950         and ub.user-account-attr.attr-value <> "0"
     3951         and ub.user-account-attr.attr-value <> "?"
     3952         then
     3953       do:
     3954         if pardoc-mode = 'ДОБАВЛЕНИЕ':U
     3955           then
     3956         do :
     3957           r-doc.agnt:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     3958           r-doc.wrkr:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     3959           r-doc.boss:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     3960         end.
     3961         if pardoc-mode = 'ИЗМЕНЕНИЕ':U
     3962           then
     3963         do :
     3964           r-doc.agnt:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     3965         end.
     3966       end.
     3967     end .
     3968     define variable v-ref-rec21   as recid no-undo .
     3969     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     3970                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3971   if not available cli-buf then do:
     3972     display r-doc.wrkr with frame d-rvs.
     3973     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     3974                            and cli-buf.obj-type = 'чел':U no-error.
     3975   end.
     3976   if available cli-buf then do:
     3977         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     3978     end.
     3979     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     3980     define variable v-ref-rec22   as recid no-undo .
     3981     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3982                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3983   if not available cli-buf then do:
     3984     display r-doc.agnt with frame d-rvs.
     3985     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3986                            and cli-buf.obj-type = 'чел':U no-error.
     3987   end.
     3988   if available cli-buf then do:
     3989         display cli-buf.obj-code @ r-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3990     end.
     3991     else display ? @ r-doc.agnt ? @ agnt-name with frame d-rvs.
     3992     define variable v-ref-rec23   as recid no-undo .
     3993     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.boss
     3994                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3995   if not available cli-buf then do:
     3996     display r-doc.boss with frame d-rvs.
     3997     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.boss
     3998                            and cli-buf.obj-type = 'чел':U no-error.
     3999   end.
     4000   if available cli-buf then do:
     4001         display cli-buf.obj-code @ r-doc.boss cli-buf.obj-name @ boss-name with frame d-rvs.
     4002     end.
     4003     else display ? @ r-doc.boss ? @ boss-name with frame d-rvs.
     4004     open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     4005     if pardoc-mode = 'ПРОСМОТР':U then
     4006     do:
     4007       if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     4008     end.
     4009     if pardoc-mode = 'ИЗМЕНЕНИЕ':U then
     4010     do:
     4011       if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then
     4012         apply "entry" to b-add in frame d-rvs.
     4013       else
     4014       do:
     4015         if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     4016       end.
     4017     end.
     4018     open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     4019     if rvs-line-pump-rec <> ? then reposition br-pump to recid rvs-line-pump-rec no-error.
     4020     if num-results( "br-line" ) > 0 then
     4021     do:
     4022       if br-line:refresh() then.
     4023     end.
     4024   end procedure.
     4025   PROCEDURE local-mark:
     4026     if not available ub.rvs-line then
     4027     do:
     4028       message "Неправильный выбор строки.".
     4029       return no-apply.
     4030     end.
     4031   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4032   define variable v-str-recid25 as character no-undo .
     4033   define variable v-num-entry25 as integer   no-undo .
     4034   assign
     4035     v-str-recid25 = trim( string( recid( ub.rvs-line ) , "->>>>>>>>>>>9":U ) )
     4036     v-num-entry25 = lookup( v-str-recid25 , del-list )
     4037   .
     4038   if v-num-entry25 > 0 then do:
     4039     assign
     4040       entry( v-num-entry25, del-list ) = "":U
     4041       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4042     .
     4043   end.
     4044   else do:
     4045     assign
     4046       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid25
     4047     .
     4048   end.
     4049     br-line:refresh() in frame d-rvs .
     4050   END PROCEDURE.
     4051   procedure del-rvs-line:
     4052     if del-list = "" then
     4053     do:
     4054       if not available ub.rvs-line then
     4055       do:
     4056         message "Неправильный выбор строки.".
     4057         return error.
     4058       end.
     4059       varlog = no.
     4060       message "Удалить строку документа сверки ?   Вы уверены ?"
     4061         view-as alert-box question buttons ok-cancel update varlog.
     4062       if not varlog then return error.
     4063       rvs-line-rec = recid (ub.rvs-line).
     4064       del-list     = string (recid (ub.rvs-line)).
     4065       get next br-line.
     4066       if available ub.rvs-line then rep-rec = recid (ub.rvs-line).
     4067       else
     4068       do:
     4069         reposition br-line to recid rvs-line-rec no-error.
     4070         get prev br-line.
     4071         rep-rec = recid (ub.rvs-line).
     4072       end.
     4073     end.
     4074     else
     4075     do:
     4076       varlog = ?.
     4077       message "УДАЛЕНИЕ  ПО  ОТМЕТКАМ  строк документа ?" skip (2)
     4078         "yes - удалить все отмеченные строки" skip
     4079         "no - оставить только отмеченные строки и удалить все остальные" skip (2)
     4080         "cancel - ничего не удалять"
     4081         view-as alert-box question buttons yes-no-cancel update varlog.
     4082       if varlog = ? then return error.
     4083       rep-rec = ?.
     4084     end.
     4085     do transaction on error   undo, return error
     4086       on end-key undo, return error
     4087       on stop    undo, return error :
     4088       for each del-rvs-line where del-rvs-line.rvs-code = r-doc.rvs-code no-lock
     4089         :
     4090         if not varlog and     can-do (del-list, string (recid (del-rvs-line))) then next.
     4091         if     varlog and not can-do (del-list, string (recid (del-rvs-line))) then next.
     4092         assign
     4093           rvs-line-rec = recid(del-rvs-line).
     4094         find ub.rvs-line where recid (ub.rvs-line) = rvs-line-rec exclusive.
     4095         delete ub.rvs-line.
     4096       end.
     4097   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( r-doc ) ,
     4098                         input yes ) no-error .
     4099     end.
     4100   end procedure.
     4101   procedure cycle-add :
     4102     define buffer buf_rvs-line for ub.rvs-line.
     4103     define buffer buf_goods    for ub.goods.
     4104     define buffer buf_pl-gds   for ub.pl-gds.
     4105     define buffer buf_place    for ub.place .
     4106     define variable var-pl-code like ub.place.pl-code no-undo.
     4107     define variable v-value     as character no-undo.
     4108     define variable v-value2    as character no-undo.
     4109     define variable v-ok        as logical   no-undo.
     4110     define variable ii          as integer   no-undo .
     4111     assign
     4112       lns-cnt = 0.
     4113     do while lns-cnt < num-entries( notes ) :
     4114       assign
     4115         lns-cnt = lns-cnt + 1
     4116         gds-rec = integer( entry( lns-cnt, notes ) ).
     4117       find buf_goods no-lock where recid( buf_goods ) = gds-rec.
     4118       run plgdsfnd in this-procedure (  input yes,
     4119         input r-doc.obj-type,
     4120         input r-doc.obj-code,
     4121         input buf_goods.gds-code,
     4122         output varres,
     4123         output var-pl-code ) no-error.
     4124       if error-status :error then
     4125       do:
     4126         message "Ошибка при поиске складского места для товара: " skip
     4127           buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code skip
     4128           return-value
     4129           "."
     4130           view-as alert-box error.
     4131         next.
     4132       end.
     4133       if varres <> yes then
     4134       do:
     4135         message "Товар " buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code
     4136           " не резевируется по складским местам на объекте "
     4137           r-doc.obj-type r-doc.obj-code "."
     4138           view-as alert-box error.
     4139         next.
     4140       end.
     4141       find buf_pl-gds no-lock where
     4142         buf_pl-gds.obj-type = r-doc.obj-type and
     4143         buf_pl-gds.obj-code = r-doc.obj-code and
     4144         buf_pl-gds.pl-code  = var-pl-code            no-error.
     4145       if not available buf_pl-gds then
     4146       do:
     4147         message "Ошибка при выборке складского места для товара: "
     4148           buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code
     4149           view-as alert-box error.
     4150         next.
     4151       end.
     4152       find first buf_rvs-line no-lock where
     4153         buf_rvs-line.rvs-code = r-doc.rvs-code and
     4154         buf_rvs-line.gds-code = buf_goods.gds-code       and
     4155         buf_rvs-line.pl-code  = buf_pl-gds.pl-code       no-error.
     4156       if available buf_rvs-line then
     4157       do:
     4158         assign
     4159           varlog = no.
     4160         message "Данный товар: " buf_goods.artic buf_goods.gds-name skip
     4161           " и складское место " buf_pl-gds.pl-code
     4162           "уже имеется в данном документе сверки." skip
     4163           view-as alert-box.
     4164         next.
     4165       end.
     4166       run placelib_get-attr  ( input "place-com-tanks"
     4167         ,input buf_pl-gds.obj-code
     4168         ,input buf_pl-gds.obj-type
     4169         ,input buf_pl-gds.pl-code
     4170         ,output v-value
     4171         ,output v-ok      ) no-error.
     4172       if  v-ok
     4173       and v-value > ""
     4174       then do :
