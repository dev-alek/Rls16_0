     5589       if error-status :error then
     5590       do:
     5591         message "Ошибка при определении пистолетов ТРК для измерения."
     5592           return-value
     5593           view-as alert-box error.
     5594         run waitfram-hide in this-procedure.
     5595         return error.
     5596       end.
     5597       if can-find(first tt-pump-nozzle) then
     5598       do:
     5599         if ptoldfilvalue = "yes":u then
     5600         do:
     5601           run gbl/d-askw.w ( input "Выбор источника данных с информацией по ТРК",
     5602             "Будем читать текущие данные с ТРК или возьмем данные из файла?",
     5603             "|^",
     5604             "Текущие данные|Из файлов|Отмена",
     5605             "Запускается программа для обращения к датчикам ТРК|Берутся уже сохраненные данные из файла|Ничего не делаем",
     5606             1,
     5607             3,
     5608             output varnum
     5609             ).
     5610           case varnum:
     5611             when 3 then
     5612               do:
     5613                 rvs-line-rec = ?.
     5614                 rvs-line-pump-rec =?.
     5615               end.
     5616             when 2 then
     5617               do:
     5618                 assign
     5619                   varcur-pump = no.
     5620               end.
     5621             when 1 then
     5622               do:
     5623                 assign
     5624                   varcur-pump = yes.
     5625               end.
     5626           end case.
     5627         end.
     5628         else
     5629         do:
     5630           assign
     5631             varcur-pump = yes.
     5632         end.
     5633         if varnum ne 3
     5634           then
     5635         do:
     5636           run waitfram-show in this-procedure ( input "Делаем сверку по всем ТРК" ).
     5637           tr:
     5638           do transaction
     5639             on error undo tr, retry tr
     5640             :
     5641             if retry then
     5642             do:
     5643               VErrorFlag = yes.
     5644               leave tr.
     5645             end.
     5646   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parParentProc ,
