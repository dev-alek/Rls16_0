     6454   end procedure.
     6455   procedure proc_m-meas-1:
     6456     define buffer bf_place  for ub.place.
     6457     define buffer bf_r-line for ub.rvs-line.
     6458     define variable VErrorFlag as logical no-undo.
     6459     assign
     6460       rvs-line-rec      = (if available ub.rvs-line      then recid(ub.rvs-line)      else ?)
     6461       rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     6462     run waitfram-show in this-procedure ( input "Просматриваем измеряемые резервуары" ).
     6463   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_meas-plc in g#lib-rvs ( input r-doc.obj-type ,
     6464                         input r-doc.obj-code ,
     6465                         input-output table tt-meas ) no-error .
     6466     if error-status :error then
     6467     do:
     6468       message "Ошибка при определении резервуаров для измерения."
     6469         return-value
     6470         view-as alert-box error.
     6471       run waitfram-hide in this-procedure.
     6472       return error.
     6473     end.
     6474     if can-find( first tt-meas ) then
     6475     do:
     6476       run waitfram-show in this-procedure ( input "Делаем сверку по всем резервуарам" ).
     6477       tr:
     6478       do transaction on error undo tr, retry tr :
     6479         if retry then
     6480         do:
     6481           VErrorFlag = yes.
     6482           leave tr.
     6483         end.
     6484         find first sys-ctrl no-lock.
     6485         run db-attr-value(sys-ctrl.db,"AsiIp",output v-asi-ip,output v-attr-type).
     6486         run db-attr-value(sys-ctrl.db,"AsiPort",output v-asi-port,output v-attr-type).
     6487         run db-attr-value(sys-ctrl.db,"AsiType",output v-asi-type,output v-attr-type).
     6488         if trim(v-asi-ip) <> ''
     6489           and trim(v-asi-port) <> ''
     6490           and trim(v-asi-type) <> ''
     6491           then
     6492         do :
     6493           case v-asi-type :
     6494             when "1"
     6495             then
     6496               do :
     6497                 varcur-rvs = 2 .
     6498               end.
     6499             when "2"
     6500             then
     6501               do :
     6502                 varcur-rvs = 3 .
     6503               end.
     6504           end case .
     6505         end.
     6506         else
     6507         do :
     6508           if ptoldfilvalue = "yes":u then
     6509           do:
     6510             run gbl/d-askw.w ( input "Выбор источника данных с информацией по резервуарам",
     6511               "Будем читать текущие данные с резервуаров или возьмем данные из файла?",
     6512               "|^",
     6513               "Текущие данные|Из файлов|Отмена",
     6514               "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем",
     6515               1,
     6516               3,
     6517               output varnum
     6518               ).
     6519             case varnum:
     6520               when 3 then
     6521                 do:
     6522                   undo tr, leave tr.
     6523                 end.
     6524               when 2 then
     6525                 do:
     6526                   assign
     6527                     varcur-rvs = 0.
     6528                 end.
     6529               when 1 then
     6530                 do:
     6531                   assign
     6532                     varcur-rvs = 1.
     6533                 end.
     6534             end case.
     6535           end.
     6536           else
     6537           do:
     6538             assign
     6539               varcur-rvs = 1.
     6540           end.
     6541         end.
     6542   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsplace in g#lib-rvs ( input              r-doc.obj-type ,
     6543                         input              r-doc.obj-code ,
     6544                         input              no ,
     6545                         input              varcur-rvs ,
     6546                         input              yes ,
     6547                         input              no ,
     6548                         input-output table tt-meas-file ,
     6549                         input-output table tt-meas ) no-error .
     6550         if error-status :error then
     6551         do:
     6552           message "Ошибка при получении данных с приборов на резервуарах." skip
     6553             return-value
     6554             view-as alert-box error.
     6555           undo tr, retry tr.
     6556         end.
     6557   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fall-plc in g#lib-rvs
     6558     (
     6559       input r-doc.obj-type
     6560     , input r-doc.obj-code
     6561     , input r-doc.rvs-code
     6562     , input yes
     6563     )       no-error .
     6564         if error-status :error then
     6565         do:
     6566           message "Ошибка при заполнении данных с приборов на резервуарах." skip
     6567             return-value
     6568             view-as alert-box error.
     6569           undo tr, retry tr.
     6570         end.
     6571         for  each bf_r-line where
     6572           bf_r-line.rvs-code = r-doc.rvs-code and
     6573           bf_r-line.obj-type = r-doc.obj-type and
     6574           bf_r-line.obj-code = r-doc.obj-code
     6575           , first bf_place    where
     6576           bf_place.obj-type = bf_r-line.obj-type and
     6577           bf_place.obj-code = bf_r-line.obj-code and
     6578           bf_place.pl-code  = bf_r-line.pl-code and
     6579           bf_place.is-meas  = yes
     6580           :
     6581           find first rvs-line-attr exclusive-lock
     6582             where rvs-line-attr.obj-code  = bf_r-line.obj-code
     6583             and rvs-line-attr.obj-type  = bf_r-line.obj-type
     6584             and rvs-line-attr.gds-code  = bf_r-line.gds-code
     6585             and rvs-line-attr.pl-code   = bf_r-line.pl-code
     6586             and rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6587             and rvs-line-attr.attr-code = "input-type-p" no-error.
     6588           if not available rvs-line-attr then
     6589           do :
     6590             create rvs-line-attr.
     6591             assign
     6592               rvs-line-attr.obj-code  = bf_r-line.obj-code
     6593               rvs-line-attr.obj-type  = bf_r-line.obj-type
     6594               rvs-line-attr.gds-code  = bf_r-line.gds-code
     6595               rvs-line-attr.pl-code   = bf_r-line.pl-code
     6596               rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6597               rvs-line-attr.attr-code = "input-type-p"
     6598               .
     6599           end.
     6600           if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6601           else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6602           find first rvs-line-attr exclusive-lock
     6603             where rvs-line-attr.obj-code  = bf_r-line.obj-code
     6604             and rvs-line-attr.obj-type  = bf_r-line.obj-type
     6605             and rvs-line-attr.gds-code  = bf_r-line.gds-code
     6606             and rvs-line-attr.pl-code   = bf_r-line.pl-code
     6607             and rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6608             and rvs-line-attr.attr-code = "input-type-t" no-error.
     6609           if not available rvs-line-attr then
     6610           do :
     6611             create rvs-line-attr.
     6612             assign
     6613               rvs-line-attr.obj-code  = bf_r-line.obj-code
     6614               rvs-line-attr.obj-type  = bf_r-line.obj-type
     6615               rvs-line-attr.gds-code  = bf_r-line.gds-code
     6616               rvs-line-attr.pl-code   = bf_r-line.pl-code
     6617               rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6618               rvs-line-attr.attr-code = "input-type-t"
     6619               .
     6620           end.
     6621           if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6622           else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6623           find first rvs-line-attr exclusive-lock
     6624             where rvs-line-attr.obj-code  = bf_r-line.obj-code
     6625             and rvs-line-attr.obj-type  = bf_r-line.obj-type
     6626             and rvs-line-attr.gds-code  = bf_r-line.gds-code
     6627             and rvs-line-attr.pl-code   = bf_r-line.pl-code
     6628             and rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6629             and rvs-line-attr.attr-code = "input-type-l" no-error.
     6630           if not available rvs-line-attr then
     6631           do :
     6632             create rvs-line-attr.
     6633             assign
     6634               rvs-line-attr.obj-code  = bf_r-line.obj-code
     6635               rvs-line-attr.obj-type  = bf_r-line.obj-type
     6636               rvs-line-attr.gds-code  = bf_r-line.gds-code
     6637               rvs-line-attr.pl-code   = bf_r-line.pl-code
     6638               rvs-line-attr.rvs-code  = bf_r-line.rvs-code
     6639               rvs-line-attr.attr-code = "input-type-l"
     6640               .
     6641           end.
     6642           if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6643           else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6644         end.
     6645         release rvs-line-attr no-error .
     6646         run waitfram-show in this-procedure ( input "Пересчитывем шапку" ).
     6647   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( r-doc ) ,
     6648                         input no ) no-error .
     6649         if error-status :error then
     6650         do:
     6651           message "Ошибка при пересчете документа." skip
     6652             return-value
     6653             view-as alert-box error.
     6654           undo tr, retry tr.
     6655         end.
     6656       end.
     6657     end.
     6658     else
     6659     do:
     6660       message "Нет ни одного измеряемого резервуара." view-as alert-box.
     6661     end.
     6662     run waitfram-hide in this-procedure.
     6663     run ui-on in this-procedure .
     6664     if VErrorFlag
     6665       then
     6666       return error.
     6667   end procedure.
     6668   procedure proc_m-meas-2 :
     6669     define variable VErrorFlag as logical no-undo.
     6670     assign
     6671       rvs-line-rec      = (if available ub.rvs-line      then recid(ub.rvs-line)      else ?)
     6672       rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     6673     run waitfram-show in this-procedure ( input "Просматриваем измеряемые ТРК" ).
     6674   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_measpmnz in g#lib-rvs ( input ub.rvs-line-pump.obj-type ,
     6675                         input ub.rvs-line-pump.obj-code ,
     6676                         input-output table tt-pump-nozzle ) no-error .
     6677     if error-status :error then
     6678     do:
     6679       message "Ошибка при определении пистолетов ТРК для измерения."
     6680         return-value
     6681         view-as alert-box error.
     6682       run waitfram-hide in this-procedure.
     6683       return error.
     6684     end.
     6685     if can-find(first tt-pump-nozzle) then
     6686     do:
     6687       run waitfram-show in this-procedure ( input "Делаем сверку по всем ТРК" ).
     6688       tr:
     6689       do transaction on error undo tr, retry tr :
     6690         if retry then
     6691         do:
     6692           VErrorFlag = yes.
     6693           leave tr.
     6694         end.
     6695         if ptoldfilvalue = "yes":u then
     6696         do:
     6697           run gbl/d-askw.w ( input "Выбор источника данных с информацией по ТРК",
     6698             "Будем читать текущие данные с ТРК или возьмем данные из файла?",
     6699             "|^",
     6700             "Текущие данные|Из файлов|Отмена",
     6701             "Запускается программа для обращения к датчикам ТРК|Берутся уже сохраненные данные из файла|Ничего не делаем",
     6702             1,
     6703             3,
     6704             output varnum
     6705             ).
     6706           case varnum:
     6707             when 3 then
     6708               do:
     6709                 undo, leave tr.
     6710               end.
     6711             when 2 then
     6712               do:
     6713                 assign
     6714                   varcur-pump = no.
     6715               end.
     6716             when 1 then
     6717               do:
     6718                 assign
     6719                   varcur-pump = yes.
     6720               end.
     6721           end case.
     6722         end.
     6723         else
     6724         do:
     6725           assign
     6726             varcur-pump = yes.
     6727         end.
     6728   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvs-pump in g#lib-rvs ( input              parParentProc ,
     6729                         input              r-doc.obj-type ,
     6730                         input              r-doc.obj-code ,
     6731                         input              r-doc.rvs-code ,
     6732                         input              varcur-pump ,
     6733                         input-output table tt-pump-nozzle-file ,
     6734                         input-output table tt-pump-nozzle ) no-error .
     6735         if error-status :error then
     6736         do:
     6737           message "Ошибка при получении данных с приборов на ТРК и записи их в строки." skip
     6738             return-value
     6739             view-as alert-box error.
     6740           undo tr, retry tr.
     6741         end.
     6742         if return-value <> "":U then
     6743         do:
     6744           message return-value view-as alert-box information.
     6745         end.
     6746         run waitfram-show in this-procedure ( input "Пересчитывем строки и шапку" ).
     6747   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( r-doc ) ,
     6748                         input yes ) no-error .
     6749         if error-status :error then
     6750         do:
     6751           message "Ошибка при пересчете документа." skip
     6752             return-value
     6753             view-as alert-box error.
     6754           undo tr, retry tr.
     6755         end.
     6756       end.
     6757     end.
     6758     else
     6759     do:
     6760       message "Нет ни одного измеряемого счетчика ТРК." view-as alert-box information.
     6761     end.
     6762     run waitfram-hide in this-procedure.
     6763     run ui-on in this-procedure.
     6764     if VErrorFlag
     6765       then
     6766       return error.
     6767   end procedure.
     6768   procedure CheckColorSkip:
     6769      define input parameter p-obj-type as character no-undo.
     6770      define input parameter p-obj-code as integer no-undo.
     6771      define input parameter p-shift-date as date no-undo.
     6772      define input parameter p-shift-num as integer no-undo.
     6773      define input parameter p-pl-code as integer no-undo.
     6774      define input parameter p-gds-code as integer no-undo.
     6775      define input parameter p-sys-date     as date      no-undo.
     6776      define input parameter p-sys-time-int as integer   no-undo.
     6777      define output parameter vNeedSkip     as logical   no-undo.
     6778      define buffer buf_rvs-doc for ub.rvs-doc.
     6779      define buffer buf_rvs-line for ub.rvs-line.
     6780      define buffer buf_rvs-doc_end for ub.rvs-doc.
     6781      define buffer buf_doc-line-attr  for ub.doc-line-attr.
     6782      define buffer buf_doc-line-attr1 for ub.doc-line-attr.
     6783      define variable vBegTime as datetime no-undo.
     6784      define variable vEndTime as datetime no-undo.
     6785      vNeedSkip = no.
     6786      rvsdoc:
     6787      for each buf_rvs-doc no-lock
     6788           where buf_rvs-doc.obj-type   = p-obj-type
     6789             and buf_rvs-doc.obj-code   = p-obj-code
     6790             and buf_rvs-doc.shift-date = p-shift-date
     6791             and buf_rvs-doc.shift-num  = p-shift-num
     6792             and buf_rvs-doc.status_    = 'факт':U
     6793             and buf_rvs-doc.rvs-type  = 'перед_док':U
     6794           ,first buf_rvs-line no-lock
     6795           where buf_rvs-line.rvs-code   = buf_rvs-doc.rvs-code
     6796             and buf_rvs-line.obj-type   = buf_rvs-doc.obj-type
     6797             and buf_rvs-line.obj-code   = buf_rvs-doc.obj-code
     6798             and buf_rvs-line.pl-code    = p-pl-code
     6799             and buf_rvs-line.gds-code   = p-gds-code:
     6800         find first  buf_rvs-doc_end no-lock
     6801              where buf_rvs-doc_end.rvs-type = 'после_док':U
     6802             and buf_rvs-doc_end.out-code =  buf_rvs-doc.out-code
     6803             no-error.
     6804         if not avail buf_rvs-doc_end then next  rvsdoc.
     6805         find first buf_doc-line-attr no-lock where
     6806                    buf_doc-line-attr.doc-code = buf_rvs-doc.out-code
     6807                and buf_doc-line-attr.gds-code = buf_rvs-line.gds-code
     6808                and buf_doc-line-attr.attr-code begins "date-start"
     6809            no-error.
     6810         find first buf_doc-line-attr1 no-lock where
     6811                    buf_doc-line-attr1.doc-code = buf_rvs-doc.out-code
     6812                and buf_doc-line-attr1.gds-code = buf_rvs-line.gds-code
     6813                and buf_doc-line-attr1.attr-code begins "time-start"
     6814            no-error.
     6815         if available buf_doc-line-attr and
     6816            available buf_doc-line-attr1
     6817         then  vBegTime = datetime(date(buf_doc-line-attr.attr-value), (int(buf_doc-line-attr1.attr-value) * 1000 )).
     6818         else  vBegTime = datetime(buf_rvs-doc.sys-date, (buf_rvs-doc.sys-time-int * 1000 )).
     6819         find first buf_doc-line-attr no-lock where
     6820                    buf_doc-line-attr.doc-code = buf_rvs-doc.out-code
     6821                and buf_doc-line-attr.gds-code = buf_rvs-line.gds-code
     6822                and buf_doc-line-attr.attr-code begins "date-end"
     6823            no-error.
     6824         find first buf_doc-line-attr1 no-lock where
     6825                    buf_doc-line-attr1.doc-code = buf_rvs-doc.out-code
     6826                and buf_doc-line-attr1.gds-code = buf_rvs-line.gds-code
     6827                and buf_doc-line-attr1.attr-code begins "time-end"
     6828            no-error.
     6829         if available buf_doc-line-attr and
     6830            available buf_doc-line-attr1
     6831         then  vEndTime = datetime(date(buf_doc-line-attr.attr-value), ((int(buf_doc-line-attr1.attr-value) + vTimeAutoSkip * 60) * 1000 )).
     6832         else  vEndTime = datetime(buf_rvs-doc_end.sys-date, ((buf_rvs-doc_end.sys-time-int + vTimeAutoSkip * 60) * 1000 )).
     6833         if vBegTime <= datetime(p-sys-date, (p-sys-time-int * 1000 ))
     6834            and vEndTime >= datetime(p-sys-date, (p-sys-time-int * 1000 )) then
     6835         do:
     6836            vNeedSkip = yes.
     6837            leave rvsdoc.
     6838         end.
     6839      end.
     6840   end procedure.
