     6219         end.
     6220       otherwise
     6221       do:
     6222         message
     6223           vss-workfile vss-revision vss-description skip
     6224           "Неизвестный тип сверки" skip
     6225           "Тип сверки" r-doc.rvs-type skip
     6226           "Код сверки" r-doc.rvs-code skip
     6227           view-as alert-box error .
     6228         undo, return error return-value .
     6229       end.
     6230     end case .
     6231     if varlog <> yes then
     6232     do:
     6233       return error.
     6234     end.
     6235     find first buf_goods where buf_goods.gds-code = ub.rvs-line-pump.gds-code no-lock.
     6236     run str/rvs-lnp.w
     6237       (input  parparentproc
     6238       ,input  recid(ub.rvs-line-pump)
     6239       ,input  'ПРОСМОТР':U
     6240       ,input  " # "     + r-doc.rvs-code +
     6241       " товар " + buf_goods.artic     + " " +
     6242       buf_goods.prod-type + " " +
     6243       string(buf_goods.prod-code) +
     6244       " складское место " + string(ub.rvs-line-pump.pl-code) +
     6245       " ТРК " + string(ub.rvs-line-pump.pump-code) +
     6246       " пистолет " + string(ub.rvs-line-pump.nozzle-code)
     6247       ) no-error.
     6248     if error-status :error then
     6249     do:
     6250       message "Ошибка при просмотре данных по ТРК." skip
     6251         return-value skip
     6252         error-status:get-message(1)
     6253         view-as alert-box error.
     6254       return error.
     6255     end.
     6256       if pardoc-mode = 'ПРОСМОТР':U then
     6257           find r-doc where recid(r-doc) = parrvs-rec no-lock.
     6258       else find r-doc where recid(r-doc) = parrvs-rec .
     6259   end procedure.
     6260   procedure proc-lkp:
     6261     define buffer buf_goods for ub.goods.
     6262     if not available ub.rvs-line then
     6263     do:
     6264       message "Неправильный выбор строки.".
     6265       return error.
     6266     end.
     6267     assign
     6268       rvs-line-rec      = recid(ub.rvs-line)
     6269       rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     6270     case r-doc.rvs-type
     6271       :
     6272       when 'перед_док':U
     6273       or
     6274       when 'после_док':U
     6275       then
     6276         do:
     6277   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6278   do:
     6279     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6280       (input  v-cntxt-db-num
     6281       ,input  v-cntxt-userid
     6282       ,input  0
     6283       ,input  'actn_rvs-on-doc_lookup':U
