      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   procedure doc-code:
      152   define input  parameter parmode          as   character           no-undo.
      153   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      154   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      155   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      156   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      157   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      158   define variable vardb-remote     as   logical             no-undo.
      159   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      160   define variable v-delimiter as character no-undo .
      161   do
      162   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      163   :
      164   find first buf_sys-ctrl no-lock .
      165   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      166     CASE parmode:
      167       when "main":u then do:
      168         if vardb-remote then do:
      169           assign
      170             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      171         end.
      172         else do:
      173           assign
      174             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      175         end.
      176       end.
      177       when "trio" then do:
      178         assign
      179           pardoc-code = replace (parroot-doc-code, "=", "*").
      180       end.
      181       otherwise do:
      182         assign
      183         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      184         no-error
      185         .
      186         if error-status:error  then do:
      187           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      188                                         ,chr(10)
      189                                         ,parmode
      190                                         ).
      191         end.
      192         if num-entries(parmode) = 1
      193         and parmode <> "chip":U
      194         and parmode <> "chip_s":U
      195         then do:
      196           assign
      197           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      198         end.
      199         else if (lookup("chip":U, parmode) > 0
      200                  or
      201                  lookup("chip_s":U, parmode) > 0) then do:
      202           assign
      203             vartemp-doc-code = parroot-doc-code.
      204           do while true:
      205             if index (vartemp-doc-code , ".") = 0 then
      206               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      207             else
      208               vartemp-doc-code  =
      209               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      210               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      211               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      212             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      213           end.
      214           assign
      215             pardoc-code = vartemp-doc-code.
      216         end.
      217       end.
      218     end CASE.
      219     if pardoc-code = '':U
      220     or (parroot-doc-code <> '':U
      221     and pardoc-code = parroot-doc-code) then do:
      222       undo, return error substitute("Ошибка при генерации номера документа&1"
      223                                     ,chr(10)).
      224     end.
      225   end.
      226   end. // procedure/method
      227   function get-doc-code-int64 returns int64
      228     ( input p-doc-code as character ) :
      229     define variable v-ind              as integer   no-undo .
      230     define variable v-num-entries      as integer   no-undo .
      231     define variable v-doc-code-int64   as int64     no-undo .
      232     define variable v-canonic-doc-code as character no-undo .
      233     assign
      234       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      235       v-canonic-doc-code = p-doc-code
      236     .
      237     do v-ind = 1 to v-num-entries
      238     :
      239       assign
      240         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      241       .
      242     end.
      243     assign
      244       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      245     .
      246     return v-doc-code-int64 .
      247   end. // function/method
      248   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249     define variable v-cntxt-db-num        as integer   no-undo .
      250     define variable v-cntxt-userid        as character no-undo .
      251     define variable v-cntxt-level         as character no-undo .
      252     define variable v-cntxt-host-code-obj as integer   no-undo .
      253     define variable v-cntxt-obj-type      as character no-undo .
      254     define variable v-cntxt-obj-code      as integer   no-undo .
      255     define variable v-cntxt-db-num-obj    as integer   no-undo .
      256     define variable v-cntxt-is-admin      as logical   no-undo .
      257   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258     run mainmenu_getcntxt in parparentproc
      259       (output v-cntxt-db-num
      260       ,output v-cntxt-userid
      261       ,output v-cntxt-level
      262       ,output v-cntxt-host-code-obj
      263       ,output v-cntxt-obj-type
      264       ,output v-cntxt-obj-code
      265       ,output v-cntxt-db-num-obj
      266       ,output v-cntxt-is-admin
      267       ) .
      268     define new global shared variable g#lib-rvs as handle no-undo.
      269   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270   define variable v-waitfram-action01         as character   no-undo .
      271   define variable v-waitfram-action02         as character   no-undo .
      272   define variable v-waitfram-action03         as character   no-undo .
      273   define variable mWaitFramTextBeg            as character   no-undo.
      274   define variable mWaitFramTextEnd            as character   no-undo.
      275   define variable mWaitFramView               as logical     no-undo.
      276   define variable mWaitProcEvent              as logical     no-undo init yes.
      277   define variable mWaitFramInterval           as integer     no-undo init 1 .
      278   define variable mWaitFramStop               as logical     no-undo.
      279   define variable mWaitFramStopUser           as logical     no-undo.
      280   define variable mWaitFramStopTimeOut        as logical     no-undo.
      281   define variable mWaitFramStartProc          as datetime-tz no-undo.
      282   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      283   define button B-WaitFramStop auto-end-key
      284        label "Стоп"
      285        size 10 by 1 tooltip "Остоновить процесс".
      286   define button B-viewProcInfo
      287        label "Информация"
      288        size 15 by 1 tooltip "Информация о процесс".
      289   define frame waitfram
      290     v-waitfram-action01 format "x(72)" no-label skip
      291     v-waitfram-action02 format "x(72)" no-label skip
      292     v-waitfram-action03 format "x(72)" no-label skip
      293     B-viewProcInfo
      294     B-WaitFramStop at row 4 col 30
      295     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      296     .
      297   define new global shared variable mBatchMode as logical no-undo init ?.
      298   define variable mFramBachModHandle as handle no-undo.
      299   mFramBachModHandle = frame waitfram:handle.
      300   define variable mFameOldVis as logical no-undo.
      301   define variable mVisCUrentVin as logical no-undo.
      302   if session:batch-mode
      303   then
      304      mBatchMode = yes.
      305   if mBatchMode = ? then do:
      306     mVisCUrentVin = current-window:visible.
      307     mFameOldVis = mFramBachModHandle:visible.
      308     mFramBachModHandle:visible  = yes.
      309     mBatchMode = mFramBachModHandle:visible ne yes.
      310     mFramBachModHandle:visible = mFameOldVis.
      311     current-window:visible = mVisCUrentVin.
      312   end.
      313    if  log-manager:logfile-name ne ?
      314     then DO:
      315         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      316         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      317         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      318     end.
      319   on choose of B-WaitFramStop in frame waitfram
      320   do:
      321     mWaitFramStop = yes.
      322     mWaitFramStopUser = yes.
      323   end.
      324   function waitfram-check-timeout returns logical():
      325      define variable vtime as int64 no-undo.
      326      if mWaitFramStopTimeOut
      327      then
      328         return yes.
      329      vtime = ( now - mWaitFramStartProc ) / 1000 .
      330      if     mWaitFramTimeOut ne ?
      331         and mWaitFramTimeOut ne 0
      332         and mWaitFramTimeOut lt vtime
      333      then do:
      334         mWaitFramStopTimeOut = yes.
      335      end.
      336      return mWaitFramStopTimeOut.
      337   end.
      338   procedure waitfram-hide :
      339     if not session:batch-mode
      340     then do
      341     on error undo, return error return-value
      342     :
      343       pause 0 before-hide .
      344       if not mBatchMode then
      345         hide frame waitfram .
      346     if     not mWaitFramView
      347        and mWaitProcEvent
      348     then
      349       process events .
      350     end.
      351   end procedure.
      352   procedure waitfram-show :
      353     define input  parameter p-message as character no-undo .
      354     define variable v-left-margin as integer   no-undo .
      355     if not session:batch-mode
      356     then do
      357     on error undo, return error return-value
      358     :
      359       if length(p-message) <= 70 then do:
      360         assign
      361           v-left-margin = integer((70 - length(p-message)) / 2)
      362         .
      363         assign
      364           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      365         .
      366         assign
      367           v-waitfram-action01 = " "
      368           v-waitfram-action02 = " "
      369                                    + fill(" ", v-left-margin)
      370                                    + p-message
      371           v-waitfram-action03 = " "
      372         .
      373       end.
      374       else do:
      375         define variable vRindex1 as integer no-undo.
      376         define variable vRindex2 as integer no-undo.
      377         vRindex1 = r-index(p-message," ",70).
      378         if vRindex1 = 0
      379         then
      380            vRindex1 = 70.
      381         if length(p-message)  <= vRindex1 + 70 then do:
      382           assign
      383             v-waitfram-action01 = " "
      384             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      385             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      386           .
      387         end.
      388         else do:
      389           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      390           if vRindex2 <= vRindex1
      391           then
      392              vRindex2 = vRindex1 + 70.
      393           assign
      394             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      395             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      396             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      397           .
      398         end.
      399       end.
      400       B-viewProcInfo:visible   in frame waitfram = no.
      401       B-viewProcInfo:sensitive in frame waitfram = no.
      402       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      403       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      404       if  (   mWaitFramView
      405          or  mWaitProcEvent)
      406          and not mBatchMode
      407       then
      408          display
      409             v-waitfram-action01 skip
      410             v-waitfram-action02 skip
      411             v-waitfram-action03 skip
      412          with frame waitfram .
      413       if     mWaitFramView
      414          then do:
      415             if     mWaitFramInterval ne ?
      416                and not mBatchMode
      417             then
      418                wait-for go of frame waitfram pause mWaitFramInterval.
      419          end.
      420          else
      421             if     mWaitProcEvent
      422                and not mBatchMode
      423             then
      424                process events .
      425     end.
      426   end procedure.
      427      procedure waitfram-show-this:
      428         define input  parameter iInterval as int64 no-undo.
      429         define variable vtime as int64 no-undo.
      430         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      431         mWaitFramInterval = iInterval.
      432         run waitfram-show (substitute("&1&2 &3&4" ,
      433                                       mWaitFramTextBeg ,
      434                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      435                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      436                                       mWaitFramTextEnd
      437                                      )
      438                           ).
      439      end.
      440      procedure WaitFramRunPause:
      441         define input  parameter iInterval as dec no-undo.
      442         define variable vStart  as datetime-tz no-undo.
      443         define variable vend    as datetime-tz no-undo.
      444         define variable vint as int64 no-undo.
      445         define variable vOk as logical no-undo.
      446         vStart = now.
      447         vend   = vStart.
      448         publish "WaitFramPause" (iInterval,output vOk).
      449         vend   =  now.
      450         vint = vend - vStart.
      451         vint = iInterval - vint / 1000.
      452         if     not mWaitFramStop
      453            and (   vint > 0
      454                 or (    not vOk
      455                     and iInterval eq ?
      456                     )
      457                 )
      458         then
      459            run waitfram-show-this (iInterval).
      460         vend   =  now.
      461         vint = vend - vStart.
      462         vint = iInterval - vint / 1000.
      463         if     not mWaitFramStop
      464            and vint > 0
      465         then do:
      466            run gbl/pause.p (vint * 1000).
      467         end.
      468         if iInterval ne ?
      469         then
      470            publish "WaitFramStop".
      471         waitfram-check-timeout().
      472      end.
      473      procedure WaitFramWaitFor:
      474         define input  parameter iInterval as dec no-undo.
      475         assign
      476            mWaitFramStartProc   = now
      477            mWaitFramStopUser    = no
      478            mWaitFramStopTimeOut = no
      479         .
      480         block-wait:
      481         do while not mWaitFramStop:
      482            run WaitFramRunPause (iInterval).
      483            if  waitfram-check-timeout()
      484            then do:
      485               leave block-wait.
      486            end.
      487         end.
      488         run waitfram-hide.
      489      end.
      490   procedure waitfram-join :
      491     define input  parameter p-line-1  as character no-undo .
      492     define input  parameter p-line-2  as character no-undo .
      493     define input  parameter p-line-3  as character no-undo .
      494     define output parameter p-message as character no-undo .
      495     do
      496     on error undo, return error return-value
      497     :
      498       assign
      499         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      500                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      501                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      502       .
      503     end.
      504   end procedure.
      505   function waitfram-join-function returns character
      506     (input p-line-1 as character
      507     ,input p-line-2 as character
      508     ,input p-line-3 as character
      509     ).
      510     define variable v-message as character no-undo .
      511     run waitfram-join in this-procedure
      512       (input  p-line-1
      513       ,input  p-line-2
      514       ,input  p-line-3
      515       ,output v-message
      516       ) .
      517     return v-message .
      518   end function .
