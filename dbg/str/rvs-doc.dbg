     6024         find first rvs-line-attr exclusive-lock
     6025           where rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6026           and rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6027           and rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6028           and rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6029           and rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6030           and rvs-line-attr.attr-code = "input-type-p" no-error.
     6031         if not available rvs-line-attr then
     6032         do :
     6033           create rvs-line-attr.
     6034           assign
     6035             rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6036             rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6037             rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6038             rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6039             rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6040             rvs-line-attr.attr-code = "input-type-p"
     6041             .
     6042         end.
     6043         if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6044         else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6045         find first olddens_rvs-line-attr no-lock
     6046           where olddens_rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6047           and olddens_rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6048           and olddens_rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6049           and olddens_rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6050           and olddens_rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6051           and olddens_rvs-line-attr.attr-code = "is-olddens" no-error.
     6052         if available olddens_rvs-line-attr
     6053           and logical(olddens_rvs-line-attr.attr-value)
     6054           then
     6055         do :
     6056           if rvs-line-attr.attr-value = 'а'
     6057             or rvs-line-attr.attr-value = 'ф'
     6058             then rvs-line-attr.attr-value = 'п' .
     6059         end.
     6060         release rvs-line-attr no-error .
     6061         find first rvs-line-attr exclusive-lock
     6062           where rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6063           and rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6064           and rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6065           and rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6066           and rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6067           and rvs-line-attr.attr-code = "input-type-t" no-error.
     6068         if not available rvs-line-attr then
     6069         do :
     6070           create rvs-line-attr.
     6071           assign
     6072             rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6073             rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6074             rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6075             rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6076             rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6077             rvs-line-attr.attr-code = "input-type-t"
     6078             .
     6079         end.
     6080         if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6081         else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6082         if available olddens_rvs-line-attr
     6083           and logical(olddens_rvs-line-attr.attr-value)
     6084           then
     6085         do :
     6086           if rvs-line-attr.attr-value = 'а'
     6087             or rvs-line-attr.attr-value = 'ф'
     6088             then rvs-line-attr.attr-value = 'п' .
     6089         end.
     6090         release rvs-line-attr no-error .
     6091         find first rvs-line-attr exclusive-lock
     6092           where rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6093           and rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6094           and rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6095           and rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6096           and rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6097           and rvs-line-attr.attr-code = "input-type-l" no-error.
     6098         if not available rvs-line-attr then
     6099         do :
     6100           create rvs-line-attr.
     6101           assign
     6102             rvs-line-attr.obj-code  = ub.rvs-line.obj-code
     6103             rvs-line-attr.obj-type  = ub.rvs-line.obj-type
     6104             rvs-line-attr.gds-code  = ub.rvs-line.gds-code
     6105             rvs-line-attr.pl-code   = ub.rvs-line.pl-code
     6106             rvs-line-attr.rvs-code  = ub.rvs-line.rvs-code
     6107             rvs-line-attr.attr-code = "input-type-l"
     6108             .
     6109         end.
     6110         if varcur-rvs > 0 then rvs-line-attr.attr-value = 'а' .
     6111         else if ptoldfilvalue = "yes":u then rvs-line-attr.attr-value = 'ф' .
     6112         release rvs-line-attr no-error .
