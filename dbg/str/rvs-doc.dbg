     6346           "Код сверки" r-doc.rvs-code skip
     6347           view-as alert-box error .
     6348         undo, return error return-value .
     6349       end.
     6350     end case .
     6351     if varlog <> yes then
     6352     do:
     6353       return error.
     6354     end.
     6355     find first buf_goods where buf_goods.gds-code = ub.rvs-line.gds-code no-lock.
     6356     if not error-status :error
     6357       and is-gas(buf_goods.gds-code) then
     6358     do:
     6359       run str/rvs-lin-mask.w
     6360         (input  parparentproc
     6361         ,input  recid(ub.rvs-line)
     6362         ,input  'ПРОСМОТР':U
     6363         ,input  " # "     + r-doc.rvs-code +
     6364         " товар " + buf_goods.artic     + " " +
     6365         buf_goods.prod-type + " " +
     6366         string(buf_goods.prod-code) +
     6367         " складское место " + string(ub.rvs-line.pl-code)
     6368         ) no-error.
     6369     end.
     6370     else
     6371       if not error-status :error
     6372         and is-sug(buf_goods.gds-code) then
     6373       do:
     6374         run str/rvs-lin-sug.w
     6375           (input  parparentproc
     6376           ,input  recid(ub.rvs-line)
     6377           ,input  'ПРОСМОТР':U
     6378           ,input  " # "     + r-doc.rvs-code +
     6379           " товар " + buf_goods.artic     + " " +
     6380           buf_goods.prod-type + " " +
     6381           string(buf_goods.prod-code) +
     6382           " складское место " + string(ub.rvs-line.pl-code)
     6383           ) no-error.
     6384       end.
     6385       else
     6386       do:
     6387         run str/rvs-lin.w
     6388           (input  parparentproc
     6389           ,input  recid(ub.rvs-line)
     6390           ,input  'ПРОСМОТР':U
     6391           ,input  " # "     + r-doc.rvs-code +
     6392           " товар " + buf_goods.artic     + " " +
     6393           buf_goods.prod-type + " " +
     6394           string(buf_goods.prod-code) +
     6395           " складское место " + string(ub.rvs-line.pl-code)
     6396           ) no-error.
     6397       end.
     6398     if error-status :error then
     6399     do:
     6400       message "Ошибка при просмотре строки сверки." skip
     6401         return-value skip
     6402         error-status:get-message(1)
     6403         view-as alert-box error.
     6404       return error.
     6405     end.
     6406     if pardoc-mode = 'ПРОСМОТР':U then
     6407     find r-doc where recid(r-doc) = parrvs-rec no-lock.
     6408     else find r-doc where recid(r-doc) = parrvs-rec.
     6409     run ui-on in this-procedure .
     6410   end procedure.
     6411   procedure proc_m-add-2 :
     6412     run waitfram-show in this-procedure ( input "Создаем строки по резервуарам" ).
     6413     tr:
     6414     do transaction on error undo, return error
     6415       on stop  undo, return error
     6416       on quit  undo, return error :
     6417   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_place-sh in g#lib-rvs ( input r-doc.obj-type ,
     6418                         input r-doc.obj-code ,
     6419                         input r-doc.rvs-code ,
     6420                         input r-doc.rvs-type ,
     6421                         input ( if available prev_rvs-doc then prev_rvs-doc.rvs-code else ? ) ,
     6422                         input cur_shift-obj.shift-date ,
     6423                         input cur_shift-obj.shift-num ,
     6424                         input no ) no-error .
     6425       if error-status :error then
     6426       do:
     6427         message "Ошибка при создании линий документа сверки." skip
     6428           return-value
     6429           view-as alert-box error.
     6430         run waitfram-hide in this-procedure.
     6431         undo tr, return error.
     6432       end.
     6433       run waitfram-show in this-procedure ( input "Создаем строки по ТРК" ).
     6434   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_pump-sh in g#lib-rvs ( input  r-doc.obj-type ,
     6435                         input  r-doc.obj-code ,
     6436                         input  r-doc.rvs-code ,
     6437                         input  r-doc.rvs-type ,
     6438                         input  ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     6439                         input  ( if available prev_icnt-doc then prev_icnt-doc.doc-code else ? ) ,
     6440                         input  cur_shift-obj.shift-date ,
