     5851             end.
     5852           end.
     5853         end.
     5854       otherwise
     5855       do:
     5856         message
     5857           vss-workfile vss-revision vss-description skip
     5858           "Неизвестный тип сверки" skip
     5859           "Тип сверки" r-doc.rvs-type skip
     5860           "Код сверки" r-doc.rvs-code skip
     5861           view-as alert-box error .
     5862         undo, return error return-value .
     5863       end.
     5864     end case .
     5865     if varlog <> yes then
     5866     do:
     5867       return no-apply.
     5868     end.
     5869     find first buf_goods no-lock where
