     2205       if error-status :error then
     2206       do:
     2207         return no-apply.
     2208       end.
     2209       assign
     2210         rvs-line-rec = rep-rec.
     2211       run ui-on in this-procedure.
     2212     end.
     2213   on choose of b-lkp in frame d-rvs
     2214     do:
     2215       run proc-lkp in this-procedure no-error.
     2216       if error-status :error then
     2217       do:
