     1317     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     1318     define input parameter p-value     like ub.db-attr.attr-value no-undo .
     1319     do
     1320     on error undo, return error
     1321     :
     1322           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
     1323         (input p-db-num
     1324         ,input p-code
     1325         ,input p-value
     1326         ) no-error .
     1327       if error-status :error
     1328       then do:
     1329         undo, return error return-value .
     1330       end.
     1331     end.
     1332   end procedure.
