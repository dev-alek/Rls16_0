     1814   define frame d-rvs
     1815     b-exit              at row 1  col 1
     1816     b-notes             at row 1  col 11
     1817     b-history           at row 1  col 71
     1818     b-help              at row 1  col 81
     1819     "Объект:"                         at row 2 col 10
     1820     r-doc.obj-code                    at row 2 col 16   colon-aligned no-label       view-as text size 7    by 1
     1821     r-doc.obj-type                    at row 2 col 23   colon-aligned no-label       view-as text size 7.13 by 1
     1822     ub.clients.obj-name               at row 2 col 33   colon-aligned no-label       view-as text size 40 by 1 fgcolor 4
     1823     r-doc.out-code                    at row 3 col 20   colon-aligned label "На основе документа" view-as text
     1824     r-doc.doc-date                    at row 3 col 40   colon-aligned view-as text
     1825     r-doc.state-measure-qnty          at row 4 col 38   colon-aligned view-as text FORMAT "->>,>>>,>>9":U
     1826     r-doc.measure-qnty                at row 4 col 63   colon-aligned label "Измер" view-as text FORMAT "->>,>>>,>>9":U
     1827     r-doc.system-qnty                 at row 4 col 85.5 colon-aligned view-as text FORMAT "->>,>>>,>>9":U
     1828     r-doc.wrkr                        at row 5 col 4.5  colon-aligned format "999999999"  view-as fill-in size 10 by 1
     1829     wrkr-name                         at row 5 col 15   colon-aligned no-label fgcolor 4
     1830     r-wrkr                            at row 5 col 28   no-label
     1831     r-doc.state-measure-cli-qnty      at row 5 col 50   colon-aligned label "Масса"       view-as text FORMAT "->>,>>>,>>9.9":U
     1832     r-doc.measure-cli-qnty            at row 5 col 85.5 colon-aligned label "Измер.масса" view-as text FORMAT "->>,>>>,>>9.9":U
     1833     r-doc.agnt                        at row 6 col 4.5 colon-aligned format "999999999"  view-as fill-in size 10 by 1
     1834     agnt-name                         at row 6 col 15  colon-aligned no-label fgcolor 4
     1835     r-agnt                            at row 6 col 28  no-label
     1836     r-doc.system-cli-qnty         at row 6 col 50    colon-aligned label "Учет масса"         view-as text FORMAT "->>,>>>,>>9.9":U
     1837     r-doc.system-cli-avrg-qnty    at row 6 col 85.5  colon-aligned label "Масса по ср.пл-ти"  view-as text FORMAT "->>,>>>,>>9.9":U
     1838     r-doc.boss                    at row 7 col 4.5   colon-aligned format "999999999"       view-as fill-in size 10 by 1
     1839     boss-name                     at row 7 col 15    colon-aligned no-label                fgcolor 4
     1840     r-boss                        at row 7 col 28    no-label
     1841     r-doc.state-mh-qnty           at row 7 col 38    colon-aligned label "Оборот"           view-as text format "->,>>>,>>>,>>>.<<<"
     1842     r-doc.state-am-qnty           at row 7 col 63    colon-aligned label "Сумма"            view-as text format "->,>>>,>>>,>>>.<<<"
     1843     r-doc.state-cf-qnty           at row 7 col 87.5  colon-aligned label "Наливы"           view-as text
     1844     b-mark              at row 8  col 1
     1845     b-add               at row 8  col 4
     1846     b-del               at row 8  col 14
     1847     b-meas              at row 8  col 24
     1848     b-lkp               at row 8  col 34
     1849     b-chg               at row 8  col 44
     1850     br-line      at row 9  col 1
     1851     b-lkp-pump          at row 15 col 1
     1852     b-chg-pump          at row 15 col 11
     1853     br-pump at row 16 col 1
     1854     space(0) skip(0)
     1855     with view-as dialog-box side-labels three-d scrollable keep-tab-order.
     1856   assign
     1857     frame d-rvs:scrollable                                = false
     1858     br-line     :num-locked-columns in frame d-rvs = 5
     1859     br-pump:num-locked-columns in frame d-rvs = 2
     1860     b-add              :popup-menu in frame d-rvs         = menu m-add:handle
     1861     b-add              :menu-mouse                                = 1
     1862     b-meas             :popup-menu in frame d-rvs         = menu m-meas:handle
     1863     b-meas             :menu-mouse                                = 1.
     1864   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1865   DEF VAR cur-clmn-numbr-line as INT EXTENT 35 no-undo.
     1866   DEF VAR varmvibr-line       as INT no-undo.
     1867   DEF VAR varmvjbr-line       as INT no-undo.
     1868   DEF VAR varmvkbr-line       as INT no-undo.
     1869   DEF VAR varmvlbr-line       as INT no-undo.
     1870   DEF VAR move-elementbr-line as INT no-undo.
     1871   def var jjbr-line           as int no-undo.
     1872   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     1873     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     1874   END.
     1875   RUN start-mv-clmnbr-line.
     1876   PROCEDURE start-mv-clmnbr-line:
     1877   def var old-session as logical no-undo.
     1878      old-session = SESSION:IMMEDIATE-DISPLAY.
     1879      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1880      SESSION:IMMEDIATE-DISPLAY = old-session.
     1881   END.
     1882   ON ctrl-cursor-right OF BROWSE br-line do:
     1883     RUN re-move-clmnbr-line ( 6, 35).
     1884   END.
     1885   ON ctrl-cursor-left OF BROWSE br-line do:
     1886     RUN re-move-clmnbr-line (35, 6).
     1887   END.
     1888   PROCEDURE re-move-clmnbr-line:
     1889     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1890     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1891     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1892       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     1893     END.
     1894     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1895     if source-column > target-column THEN
     1896     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     1897       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1898           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1899             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     1900           END.
     1901       END.
     1902     END.
     1903     ELSE
     1904     DO varmvjbr-line = source-column + 1 to target-column:
     1905       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1906         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1907           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     1908         END.
     1909       END.
     1910     END.
     1911     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1912       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     1913     END.
     1914   END PROCEDURE.
     1915   PROCEDURE ch-clmnbr-line:
     1916     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1917     if cur-clmn-loc <= 6 then do:
     1918       return .
     1919     end.
     1920     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1921       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     1922     END.
     1923     RUN re-move-clmnbr-line (cur-clmn-loc, 6).
     1924   END PROCEDURE.
     1925   PROCEDURE mv-brw-defaultbr-line:
     1926   def var old-session as logical no-undo.
     1927     old-session = SESSION:IMMEDIATE-DISPLAY.
     1928     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1929     do varmvlbr-line = 6 to EXTENT(cur-clmn-numbr-line):
     1930       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     1931     END.
     1932     RUN start-mv-clmnbr-line.
     1933     SESSION:IMMEDIATE-DISPLAY = old-session.
     1934   END PROCEDURE.
     1935   .
     1936   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   DEF VAR cur-clmn-numbr-pump as INT EXTENT 18 no-undo.
     1938   DEF VAR varmvibr-pump       as INT no-undo.
     1939   DEF VAR varmvjbr-pump       as INT no-undo.
     1940   DEF VAR varmvkbr-pump       as INT no-undo.
     1941   DEF VAR varmvlbr-pump       as INT no-undo.
     1942   DEF VAR move-elementbr-pump as INT no-undo.
     1943   def var jjbr-pump           as int no-undo.
     1944   do varmvibr-pump = 1 to EXTENT(cur-clmn-numbr-pump):
     1945     ASSIGN cur-clmn-numbr-pump[varmvibr-pump] = varmvibr-pump.
     1946   END.
     1947   RUN start-mv-clmnbr-pump.
     1948   PROCEDURE start-mv-clmnbr-pump:
     1949   def var old-session as logical no-undo.
     1950      old-session = SESSION:IMMEDIATE-DISPLAY.
     1951      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1952      SESSION:IMMEDIATE-DISPLAY = old-session.
     1953   END.
     1954   ON ctrl-cursor-right OF BROWSE br-pump do:
     1955     RUN re-move-clmnbr-pump ( 3, 18).
     1956   END.
     1957   ON ctrl-cursor-left OF BROWSE br-pump do:
     1958     RUN re-move-clmnbr-pump (18, 3).
     1959   END.
     1960   PROCEDURE re-move-clmnbr-pump:
     1961     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1962     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1963     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1964       if cur-clmn-numbr-pump[varmvibr-pump] = source-column THEN cur-clmn-numbr-pump[varmvibr-pump] = -1.
     1965     END.
     1966     if br-pump:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1967     if source-column > target-column THEN
     1968     DO varmvjbr-pump = source-column - 1 to target-column BY -1:
     1969       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1970           if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1971             cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] + 1.
     1972           END.
     1973       END.
     1974     END.
     1975     ELSE
     1976     DO varmvjbr-pump = source-column + 1 to target-column:
     1977       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1978         if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1979           cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] - 1.
     1980         END.
     1981       END.
     1982     END.
     1983     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1984       if cur-clmn-numbr-pump[varmvibr-pump] = -1 THEN cur-clmn-numbr-pump[varmvibr-pump] = target-column.
     1985     END.
     1986   END PROCEDURE.
     1987   PROCEDURE ch-clmnbr-pump:
     1988     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1989     if cur-clmn-loc <= 3 then do:
     1990       return .
     1991     end.
     1992     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1993       if cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-loc THEN move-elementbr-pump = varmvibr-pump.
     1994     END.
     1995     RUN re-move-clmnbr-pump (cur-clmn-loc, 3).
     1996   END PROCEDURE.
     1997   PROCEDURE mv-brw-defaultbr-pump:
     1998   def var old-session as logical no-undo.
     1999     old-session = SESSION:IMMEDIATE-DISPLAY.
     2000     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2001     do varmvlbr-pump = 3 to EXTENT(cur-clmn-numbr-pump):
     2002       RUN re-move-clmnbr-pump (cur-clmn-numbr-pump[varmvlbr-pump], varmvlbr-pump).
     2003     END.
     2004     RUN start-mv-clmnbr-pump.
     2005     SESSION:IMMEDIATE-DISPLAY = old-session.
     2006   END PROCEDURE.
     2007   .
     2008   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   on F9 of frame d-rvs anywhere do:
     2010     if not available ub.goods then
     2011       return no-apply.
     2012     gds-rec = recid (ub.goods).
     2013     run ref/gds-form.w ( input parparentproc
     2014                         ,input 'ПРОСМОТР':U
     2015                         ,input ?
     2016                         ,input ?
     2017                         ,input ?
     2018                         ,input-output gds-rec).
     2019     apply "entry" to br-line in frame d-rvs.
     2020     return no-apply.
     2021   end.
     2022   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2023   on F3 of frame d-rvs anywhere do:
     2024     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-rvs. END.
     2025     return no-apply.
     2026   end.
     2027   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2028   on F4 of frame d-rvs anywhere do:
     2029     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-rvs. END.
     2030     return no-apply.
     2031   end.
     2032   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2033   on F8 of frame d-rvs anywhere do:
     2034     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-rvs. END.
     2035     return no-apply.
     2036   end.
     2037   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   on INS of frame d-rvs anywhere do:
     2039     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-rvs. END.
     2040     return no-apply.
     2041   end.
     2042   on end-error, stop of frame d-rvs
     2043     do:
     2044       apply "choose" to b-exit in frame d-rvs.
     2045       return no-apply.
     2046     end.
     2047   on choose of b-notes in frame d-rvs
     2048     do:
     2049       assign
     2050         notes = r-doc.ps.
     2051       run gbl/notes.w ( input pardoc-mode, input-output notes ).
     2052       if r-doc.ps <> notes then
     2053       do:
     2054         do on stop undo, return no-apply :
     2055           find r-doc exclusive-lock where recid (r-doc) = parrvs-rec.
     2056           assign
     2057             r-doc.ps = notes.
     2058         end.
     2059       end.
     2060     end.
     2061   on choose of b-history in frame d-rvs
     2062     do:
     2063       define variable v-list as character no-undo.
     2064       if available r-doc then
     2065       do:
     2066         run str/rvscdocs.w ( input        parparentproc,
     2067           input        "":U,
     2068           input        "one":U,
     2069           input        r-doc.rvs-code,
     2070           input-output v-list                  ).
     2071       end.
     2072     end.
     2073   on choose of b-exit in frame d-rvs
     2074     do:
     2075       if pardoc-mode = 'ИЗМЕНЕНИЕ':U  or
     2076         pardoc-mode = 'ДОБАВЛЕНИЕ':U then
     2077       do:
     2078         if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then
     2079         do:
     2080           varlog = yes.
     2081           message "В документе нет строк, поэтому он удаляется." view-as alert-box
     2082             question buttons ok-cancel update varlog.
     2083           if varlog then
     2084           do:
     2085             delete r-doc.
     2086             parrvs-rec = ?.
     2087             return.
     2088           end.
     2089           else return no-apply.
     2090         end.
     2091         assign r-doc.wrkr r-doc.agnt r-doc.boss.
     2092       end.
     2093     end.
     2094   on mouse-select-dblclick, return of r-doc.agnt in frame d-rvs
     2095     do:
     2096       run local-psn-chk in this-procedure ( input "agnt", input "ret-mouse" ).
     2097       apply "entry" to r-doc.boss in frame d-rvs.
     2098       return no-apply.
     2099     end.
     2100   on mouse-select-dblclick, return of r-doc.boss in frame d-rvs
     2101     do:
     2102       run local-psn-chk in this-procedure ( input "boss", input "ret-mouse" ).
     2103       apply "entry" to b-exit in frame d-rvs.
     2104       return no-apply.
     2105     end.
     2106   on mouse-select-dblclick, return of r-doc.wrkr in frame d-rvs
     2107     do:
     2108       run local-psn-chk in this-procedure ( input "wrkr", input "ret-mouse" ).
     2109       apply "entry" to r-doc.agnt in frame d-rvs.
     2110       return no-apply.
     2111     end.
     2112   on choose of r-agnt in frame d-rvs
     2113     do:
     2114       run local-psn-chk in this-procedure ( input "agnt", input "button" ).
     2115       apply "entry" to r-doc.boss in frame d-rvs.
     2116       return no-apply.
     2117     end.
     2118   on choose of r-boss in frame d-rvs
     2119     do:
     2120       run local-psn-chk in this-procedure ( input "boss", input "button" ).
     2121       apply "entry" to b-exit in frame d-rvs.
     2122       return no-apply.
     2123     end.
     2124   on choose of r-wrkr in frame d-rvs
     2125     do:
     2126       run local-psn-chk in this-procedure ( input "wrkr", input "button" ).
     2127       apply "entry" to r-doc.agnt in frame d-rvs.
     2128       return no-apply.
     2129     end.
     2130   on leave of r-doc.agnt in frame d-rvs
     2131     do:
     2132       run local-psn-chk in this-procedure ( input "agnt", input "leave" ).
     2133     end.
     2134   on leave of r-doc.boss in frame d-rvs
     2135     do:
     2136       run local-psn-chk in this-procedure ( input "boss", input "leave" ).
     2137     end.
     2138   on leave of r-doc.wrkr in frame d-rvs
     2139     do:
     2140       run local-psn-chk in this-procedure ( input "wrkr", input "leave" ).
     2141     end.
     2142   on return, mouse-select-dblclick of br-line in frame d-rvs
     2143     do:
     2144       if b-chg:sensitive then apply "choose" to b-chg in frame d-rvs.
     2145       else apply "choose" to b-lkp in frame d-rvs.
     2146     end.
     2147   on return, mouse-select-dblclick of br-pump in frame d-rvs
     2148     do:
     2149       if b-chg-pump :sensitive then
     2150       do:
     2151         apply "choose" to b-chg-pump in frame d-rvs.
     2152       end.
     2153       else
     2154       do:
     2155         apply "choose" to b-lkp-pump in frame d-rvs.
     2156       end.
     2157     end.
     2158   on choose of b-mark in frame d-rvs
     2159     do:
     2160       run local-mark in this-procedure.
     2161       varlog = br-line:select-next-row ().
     2162       apply "entry" to br-line in frame d-rvs.
     2163     end.
     2164   on choose of b-chg in frame d-rvs
     2165     do:
     2166       do on stop undo, return no-apply :
     2167         if not available ub.rvs-line then
     2168         do:
     2169           message "Неправильный выбор строки.".
     2170           return no-apply.
     2171         end.
     2172         run local-chg in this-procedure no-error.
     2173         if error-status :error then
     2174         do:
     2175           return no-apply.
     2176         end.
     2177         run ui-on in this-procedure .
     2178       end.
     2179     end.
     2180   on choose of b-chg-pump in frame d-rvs
     2181     do:
     2182       define buffer buf_goods for ub.goods.
     2183       if not available ub.rvs-line-pump then
     2184       do:
     2185         message "Неправильный выбор строки.".
     2186         return no-apply.
     2187       end.
     2188       run proc-chg-pump in this-procedure no-error.
