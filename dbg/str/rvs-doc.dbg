     5561   procedure proc_m-meas-4 :
     5562     define variable VErrorFlag as logical no-undo.
     5563     define buffer meas_pump-nozzle for ub.pump-nozzle.
     5564     apply "entry" to br-pump in frame d-rvs.
     5565     if available ub.rvs-line-pump then
     5566     do:
     5567       find first ub.rvs-line where ub.rvs-line.rvs-code = ub.rvs-line-pump.rvs-code and
     5568         ub.rvs-line.obj-type = ub.rvs-line-pump.obj-type and
     5569         ub.rvs-line.obj-code = ub.rvs-line-pump.obj-code and
     5570         ub.rvs-line.pl-code  = ub.rvs-line-pump.pl-code  and
     5571         ub.rvs-line.gds-code = ub.rvs-line-pump.gds-code no-error.
     5572       assign
     5573         rvs-line-rec      = (if available ub.rvs-line then recid(ub.rvs-line) else ?)
     5574         rvs-line-pump-rec = recid(ub.rvs-line-pump).
     5575       find first meas_pump-nozzle where meas_pump-nozzle.obj-type    = ub.rvs-line-pump.obj-type    and
     5576         meas_pump-nozzle.obj-code    = ub.rvs-line-pump.obj-code    and
     5577         meas_pump-nozzle.pump-code   = ub.rvs-line-pump.pump-code   and
