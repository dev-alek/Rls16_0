      128   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      130   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
