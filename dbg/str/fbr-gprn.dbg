     1334         (input  (p-new-height - frame Dialog-Frame :height)
     1335         ,input  p-move-resize
     1336         ) .
     1337     end.
     1338   end procedure.
     1339   procedure diasize_change-width :
     1340     define input  parameter p-change-value as decimal   no-undo .
     1341     define input  parameter p-move-resize  as logical   no-undo .
     1342     define variable v-field-group-handle   as handle    no-undo .
     1343     define variable v-object-handle        as handle    no-undo .
