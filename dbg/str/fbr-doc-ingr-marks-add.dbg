        1   using ibs.th.str.marking.handlers.*.
        2   using ibs.th.skt.*.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Сканирование акцизных марок".
        9   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       10   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   procedure lineattr-value :
      118     do
      119     on error undo, return error return-value
      120     :
      121       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      122       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      123       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      124       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      125       define output parameter p-type     as character no-undo .
      126       define buffer buf_doc-line-attr for ub.doc-line-attr .
      127       def var v-format         as character no-undo .
      128       def var v-fillin_width   as integer   no-undo .
      129       def var v-fillin_height  as integer   no-undo .
      130       def var v-label          as character no-undo .
      131       def var v-user-can-edit  as logical   no-undo .
      132       def var v-output-display as logical   no-undo .
      133       def var v-other          as character no-undo .
      134       run lineattr-code in this-procedure
      135         (input  p-code
      136         ,output p-type
      137         ,output v-format
      138         ,output v-fillin_width
      139         ,output v-fillin_height
      140         ,output v-label
      141         ,output v-user-can-edit
      142         ,output v-output-display
      143         ,output v-other
      144         ) no-error .
      145       if error-status :error then do:
      146         undo, return error return-value .
      147       end.
      148       find first buf_doc-line-attr no-lock
      149         where buf_doc-line-attr.doc-code  = p-doc-code
      150           and buf_doc-line-attr.gds-code  = p-gds-code
      151           and buf_doc-line-attr.attr-code = p-code
      152         no-error .
      153       if avail buf_doc-line-attr then do:
      154         assign
      155           p-value =  buf_doc-line-attr.attr-value
      156         .
      157       end.
      158       else do:
      159         assign
      160           p-value = if p-type = 'L':U then "no":U else ""
      161         .
      162       end.
      163     end.
      164   end procedure.
      165   procedure lineattr-write :
      166     do
      167     on error undo, return error return-value
      168     :
      169       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      170       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      171       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      172       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      173       define buffer buf_doc-line-attr for ub.doc-line-attr .
      174       def var v-type           as character no-undo .
      175       def var v-format         as character no-undo .
      176       def var v-fillin_width   as integer   no-undo .
      177       def var v-fillin_height  as integer   no-undo .
      178       def var v-label          as character no-undo .
      179       def var v-user-can-edit  as logical   no-undo .
      180       def var v-output-display as logical   no-undo .
      181       def var v-other          as character no-undo .
      182       run lineattr-code in this-procedure
      183         (input  p-code
      184         ,output v-type
      185         ,output v-format
      186         ,output v-fillin_width
      187         ,output v-fillin_height
      188         ,output v-label
      189         ,output v-user-can-edit
      190         ,output v-output-display
      191         ,output v-other
      192         ) no-error .
      193       if error-status :error then do:
      194         undo, return error return-value .
      195       end.
      196       find first buf_doc-line-attr exclusive-lock
      197         where buf_doc-line-attr.doc-code  = p-doc-code
      198           and buf_doc-line-attr.gds-code  = p-gds-code
      199           and buf_doc-line-attr.attr-code = p-code
      200         no-error .
      201       if not available buf_doc-line-attr then do:
      202         create buf_doc-line-attr .
      203         assign
      204           buf_doc-line-attr.doc-code  = p-doc-code
      205           buf_doc-line-attr.gds-code = p-gds-code
      206           buf_doc-line-attr.attr-code = p-code
      207         .
      208       end.
      209       assign
      210         buf_doc-line-attr.attr-value = p-value
      211       .
      212        release buf_doc-line-attr.
      213     end.
      214   end procedure.
      215   procedure lineattr-exist :
      216     do
      217     on error undo, return error return-value
      218     :
      219       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      220       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      221       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      222       define output parameter p-exist   as logical  no-undo .
      223       define buffer buf_doc-line-attr for ub.doc-line-attr .
      224       def var v-type           as character no-undo .
      225       def var v-format         as character no-undo .
      226       def var v-fillin_width   as integer   no-undo .
      227       def var v-fillin_height  as integer   no-undo .
      228       def var v-label          as character no-undo .
      229       def var v-user-can-edit  as logical   no-undo .
      230       def var v-output-display as logical   no-undo .
      231       def var v-other          as character no-undo .
      232       run lineattr-code in this-procedure
      233         (input  p-code
      234         ,output v-type
      235         ,output v-format
      236         ,output v-fillin_width
      237         ,output v-fillin_height
      238         ,output v-label
      239         ,output v-user-can-edit
      240         ,output v-output-display
      241         ,output v-other
      242         ) no-error .
      243       if error-status :error then do:
      244         undo, return error return-value .
      245       end.
      246       find first buf_doc-line-attr no-lock
      247         where buf_doc-line-attr.doc-code  = p-doc-code
      248           and buf_doc-line-attr.gds-code = p-gds-code
      249           and buf_doc-line-attr.attr-code = p-code
      250         no-error .
      251       if  available buf_doc-line-attr then do:
      252         p-exist = yes.
      253       end.
      254     end.
      255   end procedure.
      256   procedure lineattr-delete :
      257     do
      258     on error undo, return error return-value
      259     :
      260       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      261       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      262       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      263       define output parameter p-deleted  as logical no-undo.
      264       define buffer buf_doc-line-attr for ub.doc-line-attr .
      265       def var v-type           as character no-undo .
      266       def var v-format         as character no-undo .
      267       def var v-fillin_width   as integer   no-undo .
      268       def var v-fillin_height  as integer   no-undo .
      269       def var v-label          as character no-undo .
      270       def var v-user-can-edit  as logical   no-undo .
      271       def var v-output-display as logical   no-undo .
      272       def var v-other          as character no-undo .
      273       run lineattr-code in this-procedure
      274         (input  p-code
      275         ,output v-type
      276         ,output v-format
      277         ,output v-fillin_width
      278         ,output v-fillin_height
      279         ,output v-label
      280         ,output v-user-can-edit
      281         ,output v-output-display
      282         ,output v-other
      283         ) no-error .
      284       if error-status :error then do:
      285         undo, return error return-value .
      286       end.
      287       find first buf_doc-line-attr exclusive-lock
      288         where buf_doc-line-attr.doc-code  = p-doc-code
      289           and buf_doc-line-attr.gds-code  = p-gds-code
      290           and buf_doc-line-attr.attr-code = p-code
      291         no-error NO-WAIT.
      292       if not available buf_doc-line-attr then do:
      293         p-deleted = no.
      294       end.
      295       else do:
      296         delete buf_doc-line-attr.
      297         p-deleted = yes.
      298       end.
      299     end.
      300   end procedure.
      301   procedure lineattr-code :
      302     do on error undo, return error return-value
      303     :
      304       define input  parameter p-code           as character no-undo .
      305       define output parameter p-type           as character no-undo .
      306       define output parameter p-format         as character no-undo .
      307       define output parameter p-fillin_width   as integer   no-undo .
      308       define output parameter p-fillin_height  as integer   no-undo .
      309       define output parameter p-label          as character no-undo .
      310       define output parameter p-user-can-edit  as logical   no-undo .
      311       define output parameter p-output-display as logical   no-undo .
      312       define output parameter p-other          as character no-undo .
      313       case p-code :
      314               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      315               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      316               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      317               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      318               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      319               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      320               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      321               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      322               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      323               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      324               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      325         otherwise do:
      326           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      327         end.
      328       end.
      329     end.
      330   end procedure.
      331   procedure lineattr-value-flora-gds :
      332     do
      333     on error undo, return error return-value
      334     :
      335       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      336       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      337       define input  parameter p-prt-code    as integer   no-undo .
      338       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      339       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      340       define output parameter p-value       as    decimal   no-undo .
      341       define buffer buf_doc-line-attr for ub.doc-line-attr .
      342       find first buf_doc-line-attr no-lock
      343         where buf_doc-line-attr.doc-code  = p-doc-code
      344           and buf_doc-line-attr.gds-code  = p-gds-code
      345           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      346         no-error .
      347       if avail buf_doc-line-attr then do:
      348         assign
      349           p-value = decimal( buf_doc-line-attr.attr-value)
      350         .
      351       end.
      352       else do:
      353         assign
      354           p-value = 0
      355         .
      356       end.
      357     end.
      358   end procedure.
      359   procedure lineattr-write-flora-gds :
      360     do
      361     on error undo, return error return-value
      362     :
      363       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      364       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      365       define input parameter p-prt-code    as integer   no-undo .
      366       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      367       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      368       define input parameter p-value    as decimal   no-undo .
      369       define buffer buf_doc-line-attr for ub.doc-line-attr .
      370       find first buf_doc-line-attr exclusive-lock
      371         where buf_doc-line-attr.doc-code  = p-doc-code
      372           and buf_doc-line-attr.gds-code  = p-gds-code
      373           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      374         no-error .
      375       if not available buf_doc-line-attr then do:
      376         create buf_doc-line-attr .
      377         assign
      378           buf_doc-line-attr.doc-code  = p-doc-code
      379           buf_doc-line-attr.gds-code  = p-gds-code
      380           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      381         .
      382       end.
      383       assign
      384         buf_doc-line-attr.attr-value = string( p-value )
      385       .
      386     end.
      387   end procedure.
      388   procedure lineattr-delete-flora-gds :
      389     do
      390     on error undo, return error return-value
      391     :
      392       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      393       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      394       define input  parameter p-prt-code    as integer   no-undo .
      395       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      396       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      397       define output parameter p-deleted  as logical no-undo.
      398       define buffer buf_doc-line-attr for ub.doc-line-attr .
      399       find first buf_doc-line-attr exclusive-lock
      400         where buf_doc-line-attr.doc-code  = p-doc-code
      401           and buf_doc-line-attr.gds-code  = p-gds-code
      402           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      403         no-error NO-WAIT.
      404       if not available buf_doc-line-attr then do:
      405         p-deleted = no.
      406       end.
      407       else do:
      408         delete buf_doc-line-attr.
      409         p-deleted = yes.
      410       end.
      411     end.
      412   end procedure.
      413   procedure lineattr-delete-flora-all :
      414     do
      415     on error undo, return error return-value
      416     :
      417       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      418       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      419       define input  parameter p-prt-code    as integer   no-undo .
      420       define buffer buf_doc-line-attr for ub.doc-line-attr .
      421       for each buf_doc-line-attr exclusive-lock
      422         where buf_doc-line-attr.doc-code  = p-doc-code
      423           and buf_doc-line-attr.gds-code  = p-gds-code
      424           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      425        :
      426         delete buf_doc-line-attr.
      427       end.
      428    end.
      429   end procedure.
      430   procedure lineattr-exist-flora-gds :
      431     do
      432     on error undo, return error return-value
      433     :
      434       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      435       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      436       define input  parameter p-prt-code    as integer   no-undo .
      437       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      438       define output parameter p-exist as logical   no-undo .
      439       define buffer buf_doc-line-attr for ub.doc-line-attr .
      440       p-exist = false .
      441       find first buf_doc-line-attr no-lock
      442         where buf_doc-line-attr.doc-code  = p-doc-code
      443           and buf_doc-line-attr.gds-code  = p-gds-code
      444           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      445         no-error .
