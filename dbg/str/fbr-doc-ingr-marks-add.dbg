     2198      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2199                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2200                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2201                                          and utd-marking-lines-attr.mark      eq imark
     2202                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2203      no-lock no-error.
     2204      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     2205   end.
     2206   function GetAttrUtdMarkingLines returns char
     2207   (idb-num   as integer,
     2208    idoc-id   as integer,
     2209    ilinenum  as integer,
     2210    imark     as character,
     2211    iattrcode as character ):
     2212      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     2213   end.
     2214   function setattrUtdMarkingLines returns logical
     2215   (idb-num   as integer,
     2216    idoc-id   as integer,
     2217    ilinenum  as integer,
     2218    imark     as character,
     2219    iattrcode as character,
     2220    iattrval  as character ):
     2221      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2222      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2223                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2224                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2225                                          and utd-marking-lines-attr.mark      eq imark
     2226                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2227      no-lock no-error.
     2228      if not available utd-marking-lines-attr
     2229      then do:
     2230         if iattrval ne ?
     2231            and iattrval ne ""
     2232         then do:
     2233            create utd-marking-lines-attr.
     2234            assign
     2235               utd-marking-lines-attr.db-num     = idb-num
     2236               utd-marking-lines-attr.doc-id     = idoc-id
     2237               utd-marking-lines-attr.lineNum    = ilineNum
     2238               utd-marking-lines-attr.mark       = imark
     2239               utd-marking-lines-attr.attr-code  = iattrcode
     2240               utd-marking-lines-attr.attr-value = iattrval
     2241            .
     2242         end.
     2243      end.
     2244      else do:
     2245         if utd-marking-lines-attr.attr-value ne iattrval
     2246         then do:
     2247            find current utd-marking-lines-attr exclusive-lock no-error.
     2248            if available utd-marking-lines-attr
     2249            then do:
     2250               if    iattrval eq ?
     2251                  or iattrval eq ""
     2252               then do:
     2253                  delete utd-marking-lines-attr.
     2254               end.
     2255               else do:
     2256                  utd-marking-lines-attr.attr-value = iattrval.
     2257               end.
     2258            end.
     2259         end.
     2260      end.
     2261      release utd-marking-lines-attr.
     2262   end.
     2263   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2264   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2266   procedure gen-key-rec :
     2267     define input  parameter p-tbl-name    as character no-undo.
     2268     define input  parameter p-bh_tbl-name as handle    no-undo.
     2269     define output parameter p-key-rec     as character no-undo.
     2270     do
     2271     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2272     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2273     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2274     :
     2275       define variable fh               as handle    no-undo .
     2276       define variable v-ok             as logical   no-undo .
     2277       define variable v-inform         as character no-undo .
     2278       define variable v-ind            as integer   no-undo .
     2279       define variable v-idx-field-qnty as integer   no-undo .
     2280       if p-tbl-name = ?
     2281         or p-tbl-name = "":U
     2282       then do:
     2283         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     2284       end.
     2285       if not p-bh_tbl-name:available then do:
     2286         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     2287       end.
     2288       assign
     2289         p-key-rec = p-tbl-name
     2290         v-inform  = p-bh_tbl-name:index-information(1)
     2291         v-ind     = 2
     2292       .
     2293       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2294       on error undo, return error
     2295       :
     2296         assign
     2297           v-inform = p-bh_tbl-name:index-information( v-ind )
     2298           v-ind    = v-ind + 1
     2299         .
     2300       end.
     2301       if v-inform = ?
     2302         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2303         or entry( 3, v-inform, ",":U ) <> "1":U
     2304       then do:
     2305         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     2306       end.
     2307       else do:
     2308         assign
     2309           v-idx-field-qnty = num-entries( v-inform ) - 4
     2310         .
     2311         if v-idx-field-qnty < 2 then do:
     2312           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     2313         end.
     2314         do v-ind = 1 to v-idx-field-qnty by 2
     2315         on error undo, return error
     2316         :
     2317           assign
     2318             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2319             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2320           .
     2321         end.
     2322       end.
     2323       if p-key-rec = ? then do:
     2324         assign
     2325           p-key-rec = "":U
     2326         .
     2327         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     2328       end.
     2329     end.
     2330     return.
     2331   end procedure.
     2332   procedure gen-where-keyr-tab :
     2333     define input  parameter i-tableSerach as character no-undo.
     2334     define input  parameter i-tablekey   as character  no-undo.
     2335     define input  parameter p-key-rec    as character  no-undo.
     2336     define input  parameter p-key-handle as handle     no-undo .
     2337     define input  parameter p-db-name    as character  no-undo .
     2338     define input  parameter p-tt-handle  as handle     no-undo .
     2339     define output parameter o-Where      as character  no-undo.
     2340     do
     2341     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2342     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2343     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2344     :
     2345       define variable v-full-tbl-name  as character no-undo .
     2346       define variable bh_tbl-name      as handle    no-undo .
     2347       define variable fh_key           as handle    no-undo .
     2348       define variable fh_search        as handle    no-undo .
     2349       define variable v-field-num      as integer   no-undo .
     2350       define variable v-count-fld      as integer   no-undo .
     2351       define variable v-inform         as character no-undo .
     2352       define variable v-ind            as integer   no-undo .
     2353       define variable v-idx-field-qnty as integer   no-undo .
     2354       define variable v-field-name     as character no-undo .
     2355       define variable v-field-val      as character no-undo .
     2356       define variable v-word-link      as character no-undo .
     2357       define variable vTable           as character no-undo.
     2358       define variable bh_tbl-key       as handle    no-undo .
     2359       assign
     2360         p-key-rec = trim( p-key-rec )
     2361       .
     2362       if p-key-handle <> ? then do:
     2363         if not valid-handle(p-key-handle)
     2364            or p-key-handle:type <> "buffer"
     2365         then do:
     2366           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     2367         end.
     2368         if num-entries( p-key-rec, chr(3) ) > 1
     2369           or p-key-rec = ?
     2370           or p-key-rec = "":U
     2371         then do:
     2372           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     2373         end.
     2374       end.
     2375       else do:
     2376         if p-key-rec = ?
     2377           or p-key-rec = "":U
     2378         then do:
     2379           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     2380         end.
     2381       end.
     2382       assign
     2383         vTable = entry( 1 , p-key-rec, chr(3) )
     2384       .
     2385       if p-tt-handle <> ?
     2386         and ( not valid-handle(p-tt-handle)
     2387               or p-tt-handle:type <> "buffer"
     2388             )
     2389       then do:
     2390         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     2391       end.
     2392       if p-tt-handle = ? then do:
     2393         assign
     2394           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2395         .
     2396         create buffer bh_tbl-name for table v-full-tbl-name .
     2397       end.
     2398       else do:
     2399         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2400       end.
     2401       assign
     2402         v-inform = bh_tbl-name:index-information(1)
     2403         v-ind    = 2
     2404       .
     2405       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2406       on error undo, return error
     2407       :
     2408         assign
     2409           v-inform = bh_tbl-name:index-information( v-ind )
     2410           v-ind    = v-ind + 1
     2411         .
     2412       end.
     2413       if v-inform = ?
     2414         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2415         or entry( 3, v-inform, ",":U ) <> "1":U
     2416       then do:
     2417         delete object bh_tbl-name no-error.
     2418         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     2419       end.
     2420       assign
     2421         v-idx-field-qnty = num-entries( v-inform ) - 4
     2422       .
     2423       if v-idx-field-qnty < 2 then do:
     2424         delete object bh_tbl-name no-error.
     2425         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     2426       end.
     2427       assign
     2428         o-where     = "where":U
     2429         v-word-link = "":U
     2430         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2431         v-count-fld = 0
     2432       .
     2433       if i-tablekey ne "" and i-tablekey ne ?
     2434       then do:
     2435         assign
     2436           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2437         .
     2438         create buffer bh_tbl-key for table v-full-tbl-name .
     2439       end.
     2440       if i-tableSerach ne "" and i-tableSerach ne ?
     2441       then do:
     2442         delete object bh_tbl-name no-error.
     2443         assign
     2444           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2445         .
     2446         create buffer bh_tbl-name for table v-full-tbl-name .
     2447       end.
     2448       block_where:
     2449       do v-ind = 1 to v-idx-field-qnty by 2
     2450       on error undo, return error
     2451       :
     2452         assign
     2453           v-count-fld = v-count-fld + 1
     2454         .
     2455         if p-key-handle = ?
     2456           and v-count-fld > v-field-num
     2457         then do:
     2458           leave block_where.
     2459         end.
     2460         define variable VfieldKeyTable as handle no-undo.
     2461         assign
     2462           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2463           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2464         .
     2465         if     bh_tbl-key ne ?
     2466         then do:
     2467            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2468            if VfieldKeyTable eq ?
     2469            then next block_where.
     2470         end.
     2471         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2472         then
     2473            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2474         else
     2475            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2476         if p-key-handle = ? then do:
     2477           assign
     2478             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2479           .
     2480         end.
     2481         else do:
     2482           assign
     2483             fh_key = p-key-handle:buffer-field( v-field-name )
     2484           .
     2485           if fh_key = ?
     2486             or not valid-handle( fh_key )
     2487           then do:
     2488             delete object bh_tbl-name.
     2489             if     bh_tbl-key ne ?
     2490             then
     2491                delete object bh_tbl-key.
     2492             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     2493           end.
     2494           assign
     2495             v-field-val = fh_key:buffer-value
     2496           .
     2497         end.
     2498         if fh_search:data-type ="character":U then do:
     2499           assign
     2500             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2501             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2502             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2503             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2504             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2505             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2506             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2507             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2508             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2509             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2510             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2511             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2512             v-field-val = substitute( '"&1"', v-field-val )
     2513           .
     2514         end.
     2515         assign
     2516           o-where = substitute( "&1 &2", o-where, v-field-val )
     2517         .
     2518         if v-word-link = "":U then do:
     2519           assign
     2520             v-word-link = "and":U
     2521           .
     2522         end.
     2523       end.
     2524       delete object bh_tbl-name.
     2525       if     bh_tbl-key ne ?
     2526       then
     2527          delete object bh_tbl-key.
     2528       if p-key-handle = ?
     2529         and v-count-fld <> v-field-num
     2530       then do:
     2531         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     2532       end.
     2533     end.
     2534   end procedure.
     2535   procedure gen-hn-keyr-tab :
     2536     define input  parameter i-tableSerach as character no-undo.
     2537     define input  parameter i-tablekey   as character no-undo.
     2538     define input  parameter p-key-rec    as character no-undo.
     2539     define input  parameter p-key-handle as handle    no-undo .
     2540     define input  parameter p-db-name    as character no-undo .
     2541     define input  parameter p-tt-handle  as handle    no-undo .
     2542     define input  parameter p-stts-lock  as integer   no-undo .
     2543     define output parameter o-hn         as handle    no-undo.
     2544     define variable v-full-tbl-name as character no-undo.
     2545     define variable v-where         as character no-undo.
     2546     define variable bh_tbl-name     as handle    no-undo.
     2547     define variable vTable          as character no-undo.
     2548     do
     2549     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2550     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2551     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2552         run gen-where-keyr-tab(i-tableSerach,
     2553                                i-tablekey,
     2554                                p-key-rec,
     2555                                p-key-handle,
     2556                                p-db-name,
     2557                                p-tt-handle,
     2558                                output v-where).
     2559         if i-tableSerach ne "" and i-tableSerach ne ?
     2560         then do:
     2561            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2562            create buffer bh_tbl-name for table v-full-tbl-name .
     2563         end.
     2564         else do:
     2565            if p-tt-handle = ? then do:
     2566               assign
     2567                  vTable = entry( 1 , p-key-rec, chr(3) )
     2568               .
     2569               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2570               create buffer bh_tbl-name for table v-full-tbl-name .
     2571            end.
     2572            else do:
     2573               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2574            end.
     2575         end.
     2576         if p-tt-handle = ? then do:
     2577            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2578         end.
     2579         else do:
     2580            bh_tbl-name:find-first( v-where ) no-error .
     2581         end.
     2582         o-hn = bh_tbl-name.
     2583      end.
     2584   end procedure.
     2585   procedure gen-hn-keyr :
     2586     define input  parameter p-key-rec    as character no-undo.
     2587     define input  parameter p-key-handle as handle    no-undo .
     2588     define input  parameter p-db-name    as character no-undo .
     2589     define input  parameter p-tt-handle  as handle    no-undo .
     2590     define input  parameter p-stts-lock  as integer   no-undo .
     2591     define output parameter o-hn         as handle    no-undo.
     2592     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2593   end.
     2594   procedure gen-row-keyr :
     2595     define input  parameter p-key-rec    as character no-undo.
     2596     define input  parameter p-key-handle as handle    no-undo .
     2597     define input  parameter p-db-name    as character no-undo .
     2598     define input  parameter p-tt-handle  as handle    no-undo .
     2599     define input  parameter p-stts-lock  as integer   no-undo .
     2600     define output parameter p-tbl-row    as rowid     no-undo.
     2601     define output parameter p-tbl-name   as character no-undo.
     2602     define variable vHn as handle no-undo.
     2603       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2604       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2605       p-tbl-name =  vHn:table.
     2606       delete object vHn no-error.
     2607     if p-tbl-row = ? then do:
     2608       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     2609     end.
     2610     else do:
     2611       return.
     2612     end.
     2613   end procedure.
     2614   procedure gen-key-fv :
     2615     define input  parameter p-key-rec    as character no-undo .
     2616     define output parameter p-field-list as character no-undo .
     2617     define output parameter p-value-list as character no-undo.
     2618     do
     2619     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2620     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2621     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2622     :
     2623       define variable v-full-tbl-name  as character no-undo .
     2624       define variable bh_tbl-name      as handle    no-undo .
     2625       define variable v-tbl-name       as character no-undo .
     2626       define variable v-field-num      as integer   no-undo .
     2627       define variable v-count-fld      as integer   no-undo .
     2628       define variable v-inform         as character no-undo .
     2629       define variable v-ind            as integer   no-undo .
     2630       define variable v-idx-field-qnty as integer   no-undo .
     2631       define variable v-delim-key      as character no-undo .
     2632       if p-key-rec = ?
     2633         or p-key-rec = "":U
     2634       then do:
     2635         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     2636       end.
     2637       assign
     2638         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2639         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2640       .
     2641       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2642       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     2643       assign
     2644         v-inform = bh_tbl-name:index-information(1)
     2645         v-ind    = 2
     2646       .
     2647       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2648       on error undo, return error
     2649       :
     2650         assign
     2651           v-inform = bh_tbl-name:index-information( v-ind )
     2652           v-ind    = v-ind + 1
     2653         .
     2654       end.
     2655       if v-inform = ?
     2656         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2657         or entry( 3, v-inform, ",":U ) <> "1":U
     2658       then do:
     2659         delete object bh_tbl-name no-error.
     2660         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     2661       end.
     2662       assign
     2663         v-idx-field-qnty = num-entries( v-inform ) - 4
     2664       .
     2665       if v-idx-field-qnty < 2 then do:
     2666         delete object bh_tbl-name no-error.
     2667         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     2668       end.
     2669       assign
     2670         p-field-list = "":U
     2671         p-value-list = "":U
     2672         v-delim-key  = "":U
     2673         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2674         v-count-fld  = 0
     2675       .
     2676       block_where:
     2677       do v-ind = 1 to v-idx-field-qnty by 2
     2678       on error undo, return error
     2679       :
     2680         assign
     2681           v-count-fld = v-count-fld + 1
     2682         .
     2683         if v-count-fld > v-field-num then do:
     2684           leave block_where.
     2685         end.
     2686         assign
     2687           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2688           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2689         .
     2690         if v-ind = 1 then do:
     2691           assign
     2692             v-delim-key = chr(3)
     2693           .
     2694         end.
     2695       end.
     2696       delete object bh_tbl-name.
     2697       if v-count-fld <> v-field-num then do:
     2698         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     2699       end.
     2700     end.
     2701   end procedure.
     2702   procedure gen-key-field :
     2703     define input  parameter p-table      as character no-undo .
     2704     define output parameter p-field-list as character no-undo .
     2705     do
     2706     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2707     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2708     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2709     :
     2710       define variable v-full-tbl-name  as character no-undo .
     2711       define variable bh_tbl-name      as handle    no-undo .
     2712       define variable v-tbl-name       as character no-undo .
     2713       define variable v-field-num      as integer   no-undo .
     2714       define variable v-count-fld      as integer   no-undo .
     2715       define variable v-inform         as character no-undo .
     2716       define variable v-ind            as integer   no-undo .
     2717       define variable v-idx-field-qnty as integer   no-undo .
     2718       define variable v-delim-key      as character no-undo .
     2719       if p-table = ?
     2720         or p-table = "":U
     2721       then do:
     2722         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     2723       end.
     2724       assign
     2725         v-tbl-name      = p-table
     2726         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2727       .
     2728       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2729       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     2730       assign
     2731         v-inform = bh_tbl-name:index-information(1)
     2732         v-ind    = 2
     2733       .
     2734       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2735       on error undo, return error
     2736       :
     2737         assign
     2738           v-inform = bh_tbl-name:index-information( v-ind )
     2739           v-ind    = v-ind + 1
     2740         .
     2741       end.
     2742       if v-inform = ?
     2743         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2744         or entry( 3, v-inform, ",":U ) <> "1":U
     2745       then do:
     2746         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     2747       end.
     2748       assign
     2749         v-idx-field-qnty = num-entries( v-inform ) - 4
     2750       .
     2751       if v-idx-field-qnty < 2 then do:
     2752         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     2753       end.
     2754       assign
     2755         p-field-list = "":U
     2756         v-delim-key  = "":U
     2757         v-count-fld  = 0
     2758       .
     2759       block_where:
     2760       do v-ind = 1 to v-idx-field-qnty by 2
     2761       on error undo, return error
     2762       :
     2763         assign
     2764           v-count-fld = v-count-fld + 1
     2765         .
     2766         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2767         if v-ind = 1 then do:
     2768           assign
     2769             v-delim-key = chr(3)
     2770           .
     2771         end.
     2772       end.
     2773       delete object bh_tbl-name.
     2774     end.
     2775   end procedure.
     2776   function AddUtdErrForTab returns logical
     2777   (idb-num         as integer ,
     2778    idoc-id         as integer ,
     2779    iTab            as character,
     2780    iObj            as handle ,
     2781    iCheckType      as character,
     2782    iCodeErr        as character,
     2783    iCheckObj       as character ):
     2784      define buffer utd-err for utd-err.
     2785      define buffer utd for utd.
     2786      find first utd where utd.db-num     eq idb-num
     2787                       and utd.doc-id     eq idoc-id
     2788                       and utd.Direction  eq 'Outbound'
     2789      no-lock no-error.
     2790      if available utd
     2791      then
     2792         return no.
     2793      define variable vRecKey as character no-undo.
     2794            run gen-key-rec (input iTab,
     2795                             input  iObj,
     2796                             output vRecKey).
     2797      find first utd-err where utd-err.db-num     eq idb-num
     2798                           and utd-err.doc-id     eq idoc-id
     2799                           and utd-err.CheckType  eq iCheckType
     2800                           and utd-err.CodeErr    eq iCodeErr
     2801                           and utd-err.CheckObj   eq iCheckObj
     2802      exclusive-lock no-error.
     2803      if not available utd-err
     2804      then do:
     2805         create utd-err.
     2806         assign
     2807            utd-err.db-num         = idb-num
     2808            utd-err.doc-id         = idoc-id
     2809            utd-err.CheckType      = iCheckType
     2810            utd-err.CodeErr        = iCodeErr
     2811            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2812            utd-err.reckey         = vRecKey
     2813            utd-err.qnty           = 1
     2814         .
     2815      end.
     2816      else
     2817         utd-err.qnty = utd-err.qnty + 1.
     2818      return utd-err.qnty eq 1.
     2819   end.
     2820   function AddUtdErr returns logical
     2821   (idb-num         as integer ,
     2822    idoc-id         as integer ,
     2823    iObj            as handle ,
     2824    iCheckType      as character,
     2825    iCodeErr        as character,
     2826    iCheckObj       as character ):
     2827      AddUtdErrForTab
     2828         (idb-num,
     2829          idoc-id,
     2830          iObj:table,
     2831          iObj,
     2832          iCheckType,
     2833          iCodeErr,
     2834          iCheckObj).
     2835   end.
     2836   function ClearUtdErrTypeCode returns logical
     2837   (idb-num         as integer,
     2838    idoc-id         as integer ,
     2839    iCheckType      as character,
     2840    iCodeErr        as character
     2841    ):
     2842      define buffer utd-err for utd-err.
     2843      if    iCheckType eq "*"
     2844         or iCheckType eq ?
     2845      then do:
     2846         if     iCodeErr ne ?
     2847            and iCodeErr ne "*"
     2848         then
     2849            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2850            view-as alert-box.
     2851         else
     2852         for each utd-err where utd-err.db-num  eq idb-num
     2853                            and utd-err.doc-id  eq idoc-id
     2854         exclusive-lock:
     2855            delete utd-err.
     2856         end.
     2857      end.
     2858      else do:
     2859         if    iCodeErr eq ?
     2860            or iCodeErr eq "*"
     2861         then do:
     2862            for each utd-err where utd-err.db-num     eq idb-num
     2863                               and utd-err.doc-id     eq idoc-id
     2864                               and utd-err.CheckType  eq iCheckType
     2865            exclusive-lock:
     2866               delete utd-err.
     2867            end.
     2868         end.
     2869         else do:
     2870            for each utd-err where utd-err.db-num     eq idb-num
     2871                               and utd-err.doc-id     eq idoc-id
     2872                               and utd-err.CheckType  eq iCheckType
     2873                               and ub.utd-err.CodeErr eq iCodeErr
     2874            exclusive-lock:
     2875               delete utd-err.
     2876            end.
     2877         end.
     2878      end.
     2879   end.
     2880   function ClearUtdErr returns logical
     2881   (idb-num         as integer,
     2882    idoc-id         as integer ,
     2883    iCheckType      as character
     2884    ):
     2885      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2886   end.
     2887   function GetMesError returns character
     2888   (itxt as character,
     2889    iobj as character ):
     2890    define variable vi as integer no-undo.
     2891    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2892       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2893    end.
     2894    return itxt.
     2895   end.
     2896   function GetTextErrorType returns character
     2897   (iCheckType as character,
     2898    iCodeErr   as character,
     2899    iChechObj  as character,
     2900    iType      as character  ):
     2901      define buffer code    for code.
     2902      define variable vError as character no-undo.
     2903      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2904                        and code.code   eq iCodeErr
     2905      no-lock no-error.
     2906      if available code
     2907      then do:
     2908         define variable vType as integer no-undo.
     2909         if code.misc3 eq "error"
     2910         then
     2911            vType = 0.
     2912         else if code.misc3 eq "warning"
     2913         then
     2914            vType = 1.
     2915         else if code.misc3 eq "Hiden"
     2916         then
     2917            vType = 2.
     2918         else
     2919            vtype = int(code.misc3) no-error.
     2920         case itype:
     2921            when "error"
     2922            then do:
     2923               if vtype eq 0
     2924               then
     2925                  vError = GetMesError(Code.CodeValue,iChechObj).
     2926            end.
     2927            when "warning"
     2928            then do:
     2929               if vtype <= 1
     2930               then
     2931                  vError = GetMesError(Code.CodeValue,iChechObj).
     2932            end.
     2933            otherwise do:
     2934               vError = GetMesError(Code.CodeValue,iChechObj).
     2935            end.
     2936         end.
     2937      end.
     2938      else
     2939         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2940      return vError.
     2941   end.
     2942   function GetTypeError returns integer
     2943   (iCheckType as character,
     2944    iCodeErr   as character):
     2945      define buffer code    for code.
     2946      define variable vType as integer no-undo.
     2947      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2948                        and code.code   eq iCodeErr
     2949      no-lock no-error.
     2950      if     not available code
     2951         and code.misc3 eq "error"
     2952      then
     2953         vType = 0.
     2954      else if code.misc3 eq "warning"
     2955      then
     2956         vType = 1.
     2957      else if code.misc3 eq "Hiden"
     2958      then
     2959         vType = 2.
     2960      else
     2961         vtype = int(code.misc3) no-error.
     2962      return vtype.
     2963   end.
     2964   function GetTextError returns character
     2965   (iCheckType as character,
     2966    iCodeErr   as character,
     2967    iChechObj  as character ):
     2968      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2969   end.
     2970   function GetErrForUtdStr returns character
     2971   (idb-num     as integer ,
     2972    idoc-id     as integer ,
     2973    iCheckType  as character
     2974    ):
     2975      define buffer utd-err for utd-err.
     2976      define buffer code    for code.
     2977      define variable vHQry as handle no-undo.
     2978      define variable vError as longchar no-undo.
     2979      define variable vErrorOne as longchar  no-undo.
     2980      define variable oError as character no-undo.
     2981      create query vHQry.
     2982      vHQry:set-buffers(buffer utd-err:handle).
     2983      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2984                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2985                               + if    iCheckType eq "*"
     2986                                    or iCheckType eq ?
     2987                                 then       ""
     2988                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2989      vHQry:query-open().
     2990      vHQry:get-first().
     2991      QRY-BLOCK:
     2992      repeat while not vHQry:query-off-end:
     2993         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2994         if     vErrorOne ne ""
     2995            and vErrorOne ne ?
     2996         then
     2997            vError = vError + ", " + vErrorOne.
     2998         vHQry:get-next().
     2999      end.
     3000      oError = substring(vError,3,4002).
     3001      return oError.
     3002   end.
     3003   function GetErrJsonForUtd returns character
     3004   (idb-num         as integer ,
     3005    idoc-id         as integer ,
     3006    iCheckType      as character
     3007    ):
     3008      define buffer utd-err for utd-err.
     3009      define variable vHQry as handle no-undo.
     3010      define variable vError as longchar no-undo.
     3011      define variable oError as character no-undo.
     3012      create query vHQry.
     3013      define variable vi as integer no-undo.
     3014      vHQry:set-buffers(buffer utd-err:handle).
     3015      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3016                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3017                               + if    iCheckType eq "*"
     3018                                    or iCheckType eq ?
     3019                                 then       ""
     3020                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3021      vHQry:query-open().
     3022      vHQry:get-first().
     3023      QRY-BLOCK:
     3024      repeat while not vHQry:query-off-end:
     3025         define variable vErrorOne as character no-undo.
     3026         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3027         if     vErrorOne ne ?
     3028            and vErrorOne ne ""
     3029         then do:
     3030            vi = vi + 1.
     3031            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3032                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3033                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3034         end.
     3035         vHQry:get-next().
     3036      end.
     3037      for first utd where utd.db-num eq idb-num
     3038                      and utd.doc-id eq idoc-id
     3039                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3040      no-lock,
     3041         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3042                                  and utd-marking-lines.doc-id eq idoc-id
     3043                                  and utd-marking-lines.doc-level eq 1
     3044      no-lock,
     3045         first marking where marking.mark eq utd-marking-lines.mark
     3046                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3047      no-lock:
     3048         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3049         if     vErrorOne ne ?
     3050            and vErrorOne ne ""
     3051         then do:
     3052            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3053                            + '","ОбъектОш":"' + marking.mark
     3054                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3055         end.
     3056      end.
     3057      if vError ne ""
     3058      then
     3059         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3060      return oError.
     3061   end.
     3062   function GetErrJsonForUtdReturn returns character
     3063   (idb-num         as integer ,
     3064    idoc-id         as integer ,
     3065    iCheckType      as character
     3066    ):
     3067      define buffer utd-err for utd-err.
     3068      define variable vHQry as handle no-undo.
     3069      define variable vError as longchar no-undo.
     3070      define variable oError as character no-undo.
     3071      define variable vi as integer no-undo.
     3072      create query vHQry.
     3073      vHQry:set-buffers(buffer utd-err:handle).
     3074      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3075                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3076                               + if    iCheckType eq "*"
     3077                                    or iCheckType eq ?
     3078                                 then       ""
     3079                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3080      vHQry:query-open().
     3081      vHQry:get-first().
     3082      QRY-BLOCK:
     3083      repeat while not vHQry:query-off-end:
     3084         define variable vErrorOne as character no-undo.
     3085         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3086         if     vErrorOne ne ?
     3087            and vErrorOne ne ""
     3088         then do:
     3089            vi = vi + 1.
     3090            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3091                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3092                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3093         end.
     3094         vHQry:get-next().
     3095      end.
     3096      if vError ne ""
     3097      then
     3098         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3099      return oError.
     3100   end.
     3101   function GetCodeTextError returns character
     3102   (iCheckType as character,
     3103    iCodeErr   as character,
     3104    iChechObj  as character,
     3105    output oCode as character,
     3106    output ovalue as character ):
     3107      define buffer code    for code.
     3108      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3109                        and code.code   eq iCodeErr
     3110      no-lock no-error.
     3111      if     available code
     3112      then do:
     3113         define variable vi as integer no-undo init ?.
     3114         vi = int(Code.misc3) no-error.
     3115         if    code.misc3 ne "error"
     3116            and vi ne 0
     3117         then
     3118            oCode = ?.
     3119         else if     Code.misc1 ne ?
     3120                 and Code.misc1 ne ""
     3121         then
     3122            assign
     3123               oCode  = GetMesError(Code.misc1,iChechObj)
     3124               ovalue = GetMesError(Code.misc2,iChechObj)
     3125            .
     3126      end.
     3127      return if oCode eq ""
     3128             then ""
     3129             else (oCode + "_" + ovalue).
     3130   end.
     3131   define temp-table TT-err no-undo
     3132     field code_ as character
     3133     field text_ as character
     3134   index code_ code_.
     3135   function GetErrTxtForUtd returns character
     3136   (idb-num         as integer ,
     3137    idoc-id         as integer ,
     3138    iCheckType      as character
     3139    ):
     3140      define buffer utd-err for utd-err.
     3141      define variable vHQry as handle no-undo.
     3142      define variable oError as character no-undo.
     3143      create query vHQry.
     3144      define variable vi as integer no-undo.
     3145      for each tt-err :
     3146         delete tt-err.
     3147      end.
     3148      vHQry:set-buffers(buffer utd-err:handle).
     3149      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3150                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3151                               + if    iCheckType eq "*"
     3152                                    or iCheckType eq ?
     3153                                 then       ""
     3154                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3155      vHQry:query-open().
     3156      vHQry:get-first().
     3157      define variable vcode as character no-undo.
     3158      define variable vvalue as character no-undo.
     3159      QRY-BLOCK:
     3160      repeat while not vHQry:query-off-end:
     3161         vi = vi + 1.
     3162         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3163         if vcode ne ?
     3164         then do:
     3165            find first tt-err where tt-err.code eq vcode
     3166            no-error.
     3167            if not available tt-err
     3168            then do:
     3169               create tt-err.
     3170               assign
     3171                  tt-err.code_ = vcode
     3172                  tt-err.text_ = vvalue
     3173               .
     3174            end.
     3175            else
     3176               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3177         end.
     3178         vHQry:get-next().
     3179      end.
     3180     find first utd where utd.db-num eq idb-num
     3181                         and utd.doc-id eq idoc-id
     3182         no-lock.
     3183      define buffer cancel_utd-lines for utd-lines.
     3184      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3185                                  and cancel_utd-lines.doc-id eq idoc-id
     3186      no-lock:
     3187         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3188         then do:
     3189            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3190                                        and utd-marking-lines.doc-id eq idoc-id
     3191                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3192            no-lock,
     3193               first marking where marking.mark eq utd-marking-lines.mark
     3194                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3195            no-lock:
     3196               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3197               find first tt-err where tt-err.code eq vcode
     3198               no-error.
     3199               if not available tt-err
     3200               then do:
     3201                  create tt-err.
     3202                  assign
     3203                     tt-err.code_ = vcode
     3204                     tt-err.text_ = vvalue
     3205                  .
     3206               end.
     3207               else
     3208                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3209            end.
     3210         end.
     3211         else do:
     3212            define variable vqnty as decimal no-undo.
     3213            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3214            if vqnty eq ? then vqnty = 0.
     3215            if vqnty ne cancel_utd-lines.Quantity
     3216            then do:
     3217               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3218               find first tt-err where tt-err.code eq vcode
     3219               no-error.
     3220               if not available tt-err
     3221               then do:
     3222                  create tt-err.
     3223                  assign
     3224                     tt-err.code_ = vcode
     3225                     tt-err.text_ = vvalue
     3226                  .
     3227               end.
     3228               else
     3229                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3230            end.
     3231         end.
     3232      end.
     3233      for each tt-err:
     3234         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3235      end.
     3236      return oError.
     3237   end.
     3238   define variable mFormatErr as character no-undo init "text".
     3239   function GetErrForUtd returns character
     3240   (idb-num         as integer ,
     3241    idoc-id         as integer ,
     3242    iType           as character
     3243    ):
     3244      if mFormatErr eq "text"
     3245      then
     3246         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3247      else do:
     3248         if itype eq "return"
     3249         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3250         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3251      end.
     3252   end.
     3253   function GetErrComText returns longchar
     3254   (icomment as character,
     3255    itext    as longchar ):
     3256       define variable vText as longchar no-undo.
     3257      if mFormatErr eq "text"
     3258      then do:
     3259         if icomment ne ""
     3260         then
     3261            icomment = substitute("comment:|&1|",icomment).
     3262         vText = icomment + itext.
     3263      end.
     3264      else do:
     3265         icomment = if icomment begins  '"'
     3266                    then icomment
     3267                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3268         vText = icomment + "," + itext.
     3269         vText = "~{" + trim(vText,",") + "~}".
     3270      end.
     3271      return vText.
     3272   end.
     3273   function CheckTypeForMarkLineType returns logical
     3274   (iObj            as handle,
     3275    iCheckType      as character,
     3276    iCodeErr        as character ,
     3277    iTypeErr        as character ):
     3278      define variable vRecKey-markLine as character no-undo.
     3279      define variable vGoodMark        as logical no-undo.
     3280      define variable vdb-num          as integer no-undo.
     3281      define variable vdoc-id          as integer no-undo.
     3282      define variable vlinenum         as integer no-undo.
     3283      define variable vErrorOne as character no-undo.
     3284      define buffer buf_utd-err for utd-err.
     3285      run gen-key-rec (input "utd-marking-lines",
     3286                       input  iObj,
     3287                       output vRecKey-markLine).
     3288      vGoodMark = yes.
     3289      vdb-num = iObj::db-num.
     3290      vdoc-id = iObj::doc-id.
     3291      vlinenum = iObj::linenum.
     3292      block-mark-err:
     3293      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3294                               and buf_utd-err.db-num = vdb-num
     3295                               and buf_utd-err.reckey = vRecKey-markLine
     3296                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3297                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3298      no-lock:
     3299         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3300         if     vErrorOne ne ?
     3301            and vErrorOne ne ""
     3302         then do:
     3303            vGoodMark = no.
     3304            leave block-mark-err.
     3305         end.
     3306      end.
     3307      return not vGoodMark.
     3308   end.
     3309   function CheckErrForMarkLineType returns logical
     3310   (iObj            as handle,
     3311    iType           as character  ):
     3312      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3313   end.
     3314   function CheckErrForMarkLine returns logical
     3315   (iObj            as handle):
     3316      return CheckErrForMarkLineType(iObj,"*").
     3317   end.
     3318   function CheckErrForLineTypeCode returns logical
     3319   (iObj                 as handle,
     3320    iCheckType           as character,
     3321    iCodeErr             as character,
     3322    iTypeErr             as character,
     3323    iOneErr              as logical):
     3324      define variable vRecKey-line     as character no-undo.
     3325      define buffer buf_utd-err for utd-err.
     3326      define variable vUtdlineError as logical no-undo.
     3327      define variable vErrorOne as character no-undo.
     3328            run gen-key-rec (input "utd-lines",
     3329                             input  iObj,
     3330                             output vRecKey-line).
     3331         define variable vdb-num as integer no-undo.
     3332         define variable vdoc-id as integer no-undo.
     3333         define variable vlinenum as integer no-undo.
     3334         vdb-num = iObj::db-num.
     3335         vdoc-id = iObj::doc-id.
     3336         vlinenum = iObj::linenum.
     3337         block-err:
     3338         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3339                                  and buf_utd-err.db-num = vdb-num
     3340                                  and buf_utd-err.reckey = vRecKey-line
     3341                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3342                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3343         no-lock:
     3344            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3345            if     vErrorOne ne ?
     3346               and vErrorOne ne ""
     3347            then do:
     3348               vUtdlineError = yes.
     3349               leave block-err.
     3350            end.
     3351         end.
     3352         if  not vUtdlineError
     3353         then do:
     3354            define variable vGoodMark as logical no-undo.
     3355            vGoodMark = yes.
     3356            block-line-err:
     3357            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3358                                         and utd-marking-lines.doc-id  eq vdoc-id
     3359                                         and utd-marking-lines.LineNum eq vLineNum
     3360            no-lock:
     3361               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3362               if     vGoodMark
     3363                  and iOneErr eq no
     3364               then
     3365                  leave block-line-err.
     3366               if     iOneErr = yes
     3367                  and not vGoodMark
     3368               then
     3369                  leave block-line-err.
     3370            end.
     3371            vUtdlineError = not vGoodMark.
     3372         end.
     3373      return vUtdlineError.
     3374   end.
     3375   function getErrForLineType returns character
     3376   (iObj            as handle,
     3377    iType           as character  ):
     3378      define variable vRecKey-line     as character no-undo.
     3379      define buffer buf_utd-err for utd-err.
     3380      define variable vUtdlineError as logical no-undo.
     3381      define variable vErrorOne as character no-undo.
     3382      define variable oError as character no-undo.
     3383            run gen-key-rec (input "utd-lines",
     3384                             input  iObj,
     3385                             output vRecKey-line).
     3386         define variable vdb-num as integer no-undo.
     3387         define variable vdoc-id as integer no-undo.
     3388         define variable vlinenum as integer no-undo.
     3389         vdb-num = iObj::db-num.
     3390         vdoc-id = iObj::doc-id.
     3391         vlinenum = iObj::linenum.
     3392         block-err:
     3393         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3394                                  and buf_utd-err.db-num = vdb-num
     3395                                  and buf_utd-err.reckey = vRecKey-line
     3396                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3397         no-lock:
     3398            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3399            if     vErrorOne ne ?
     3400               and vErrorOne ne ""
     3401            then do:
     3402               oError = oError + vErrorOne + " ".
     3403            end.
     3404         end.
     3405      return oError.
     3406   end.
     3407   function CheckErrForLineType returns logical
     3408   (iObj            as handle,
     3409    iType           as character  ):
     3410       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3411   end.
     3412   function CheckErrForLine returns logical
     3413   (iObj            as handle):
     3414      return CheckErrForLineType(iobj,"*").
     3415   end.
     3416   function CheckErrForUtd returns logical
     3417   (idb-num         as integer ,
     3418    idoc-id         as integer ):
     3419      for each utd-lines where utd-lines.db-num eq idb-num
     3420                           and utd-lines.doc-id eq idoc-id
     3421      no-lock :
     3422         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3423         then
     3424            return no.
     3425      end.
     3426      return yes.
     3427   end.
     3428   function CheckMarkUtd-28rel return logical
     3429    (input idb-num as integer,
     3430    input idoc-id as integer):
     3431    define buffer utd                   for utd.
     3432    define buffer utd-lines             for utd-lines.
     3433    define buffer utd-marking-lines     for utd-marking-lines.
     3434    define variable v-par-type as character no-undo.
     3435    define variable vgdsNoMark as logical no-undo.
     3436    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3437      define variable v-par-val  as character no-undo.
     3438      find first utd where utd.db-num eq idb-num
     3439                       and utd.doc-id eq idoc-id
     3440      no-lock no-error.
     3441      if available utd
     3442      then do:
     3443         if     utd.obj-code ne ?
     3444            and utd.obj-type ne ?
     3445         then do:
     3446            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3447            Block-utd-lines:
     3448            for each utd-lines where utd-lines.db-num eq idb-num
     3449                                 and utd-lines.doc-id eq idoc-id
     3450            no-lock:
     3451               if     utd-lines.gds-code ne ?
     3452                  and utd-lines.gds-code ne 0
     3453               then do:
     3454                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3455                       ( utd-lines.gds-code,
     3456                         'mark-type':U,
     3457                          output v-par-val,
     3458                          output v-par-type
     3459                       ).
     3460                  if     EDOParSec:IsEdo
     3461                     and EDOParSec:GetIsEDOForType(v-par-val)
     3462                  then do:
     3463                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3464                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3465                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3466                                                    and length(utd-marking-lines.mark) > 13
     3467                     no-lock no-error.
     3468                     if     avail utd-marking-lines
     3469                        and not CheckErrForLine(buffer utd-lines:handle)
     3470                     then
     3471                        leave Block-utd-lines.
     3472                  end.
     3473                  else
     3474                     vgdsNoMark = yes.
     3475               end.
     3476            end.
     3477            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3478            if vgdsNoMark then return available utd-lines . else return yes .
     3479         end.
     3480      end.
     3481      return yes.
     3482   end.
     3483   function CheckMarkUtd return logical
     3484    (input idb-num  as integer,
     3485     input idoc-id  as integer):
     3486     define buffer utd-lines             for ub.utd-lines.
     3487     block-line:
     3488     for each utd-lines where utd-lines.db-num eq idb-num
     3489                          and utd-lines.doc-id eq idoc-id
     3490     no-lock:
     3491        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3492        then
     3493           leave block-line.
     3494     end.
     3495     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3496     return available utd-lines.
     3497   end.
     3498   function CheckNotMarkUtd return logical
     3499    (input idb-num  as integer,
     3500     input idoc-id  as integer):
     3501     define buffer utd-lines             for ub.utd-lines.
     3502     for each utd-lines where utd-lines.db-num eq idb-num
     3503                          and utd-lines.doc-id eq idoc-id
     3504     no-lock:
     3505        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3506        then
     3507           return yes.
     3508     end.
     3509     return no.
     3510   end.
     3511   function CheckMarkUtdLine return logical
     3512    (input idb-num  as integer,
     3513     input idoc-id  as integer,
     3514     input iLineNum as integer):
     3515    define buffer utd                   for utd.
     3516    define buffer utd-lines             for utd-lines.
     3517    define buffer utd-marking-lines     for utd-marking-lines.
     3518    define variable v-par-type as character no-undo.
     3519    define variable vMarking        as logical no-undo.
     3520    define variable vArtic          as logical no-undo.
     3521    define variable vTransitional   as logical no-undo.
     3522    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3523      define variable v-par-val  as character no-undo.
     3524      find first utd where utd.db-num eq idb-num
     3525                       and utd.doc-id eq idoc-id
     3526      no-lock no-error.
     3527      if available utd
     3528      then do:
     3529         if     utd.obj-code ne ?
     3530            and utd.obj-type ne ?
     3531         then do:
     3532            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3533            Block-utd-lines:
     3534            for each utd-lines where utd-lines.db-num   eq idb-num
     3535                                 and utd-lines.doc-id   eq idoc-id
     3536                                 and utd-lines.LineNum  eq iLineNum
     3537            no-lock:
     3538               if     utd-lines.gds-code ne ?
     3539                  and utd-lines.gds-code ne 0
     3540               then do:
     3541                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3542                       ( utd-lines.gds-code,
     3543                         'mark-type':U,
     3544                          output v-par-val,
     3545                          output v-par-type
     3546                       ).
     3547                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3548                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3549                  if vMarking
     3550                  then do:
     3551                     block-marking:
     3552                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3553                                                    and utd-marking-lines.doc-id   eq idoc-id
     3554                                                    and utd-marking-lines.LineNum  eq iLineNum
     3555                                                    and length(utd-marking-lines.mark) > 13
     3556                     no-lock:
     3557                        if isOAD(utd-marking-lines.mark)
     3558                        then do:
     3559                           assign
     3560                              vArtic   = yes
     3561                              vMarking = no
     3562                           .
     3563                           leave block-marking.
     3564                        end.
     3565                     end.
     3566                  end.
     3567                  if vArtic
     3568                  then do:
     3569                     block-artic:
     3570                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3571                                                    and utd-marking-lines.doc-id   eq idoc-id
     3572                                                    and utd-marking-lines.LineNum  eq iLineNum
     3573                                                    and length(utd-marking-lines.mark) > 13
     3574                     no-lock:
     3575                        if isMark(utd-marking-lines.mark)
     3576                        then do:
     3577                           assign
     3578                              vArtic   = no
     3579                              vMarking = yes
     3580                           .
     3581                           leave block-artic.
     3582                        end.
     3583                     end.
     3584                  end.
     3585                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3586                  if vTransitional
     3587                  then do:
     3588                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3589                                                    and utd-marking-lines.doc-id   eq idoc-id
     3590                                                    and utd-marking-lines.LineNum  eq iLineNum
     3591                                                    and length(utd-marking-lines.mark) > 13
     3592                     no-lock no-error.
     3593                     if not available utd-marking-lines
     3594                     then assign
     3595                        vMarking = no
     3596                        vArtic   = no
     3597                     .
     3598                  end.
     3599               end.
     3600               else
     3601                  assign
     3602                     vMarking      = yes
     3603                     vArtic        = no
     3604                     vTransitional = no
     3605                  .
     3606               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3607               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3608               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3609            end.
     3610         end.
     3611      end.
     3612      return vMarking or vArtic.
     3613   end.
     3614   function getMarkUtdLine return logical
     3615    (input  idb-num  as integer,
     3616     input  idoc-id  as integer,
     3617     input  iLineNum as integer,
     3618     output oMarking        as logical,
     3619     output oArtic          as logical,
     3620     output oTransitional   as logical):
     3621     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3622     oArtic        = not oMarking
     3623            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3624     oTransitional = (oMarking or oArtic)
     3625            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3626   end.
     3627   function CheckMarking return logical
     3628    (input idb-num as integer,
     3629    input idoc-id as integer,
     3630    input iTypeErr as character ):
     3631     define variable vMarkutd as logical no-undo.
     3632     define variable vCrErr   as logical no-undo.
     3633     define buffer utd-lines         for utd-lines.
     3634     define buffer utd-marking-lines for utd-marking-lines.
     3635     define buffer marking           for marking.
     3636     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3637      block-line:
     3638      for each utd-lines where utd-lines.db-num eq idb-num
     3639                           and utd-lines.doc-id eq idoc-id
     3640      no-lock:
     3641         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3642         then do:
     3643            for each utd-marking-lines
     3644                     where utd-marking-lines.db-num  = utd-lines.db-num
     3645                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3646                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3647            no-lock:
     3648               if isMark(utd-marking-lines.mark)
     3649               then do:
     3650                  find first marking where marking.mark eq utd-marking-lines.mark
     3651                  no-lock no-error.
     3652                  if not available marking
     3653                  then do:
     3654                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3655                     vCrErr = yes.
     3656                     next block-line.
     3657                  end.
     3658               end.
     3659            end.
     3660         end.
     3661      end.
     3662      return vCrErr.
     3663   end.
     3664   function CheckMarkForType return logical
     3665    (input idb-num   as integer,
     3666     input idoc-id   as integer):
     3667      define variable vMarking        as logical no-undo.
     3668      define variable vArtic          as logical no-undo.
     3669      define variable vTransitional   as logical no-undo.
     3670      define buffer utd-lines         for utd-lines.
     3671      define buffer utd-marking-lines for utd-marking-lines.
     3672      block-line:
     3673      for each utd-lines where utd-lines.db-num eq idb-num
     3674                           and utd-lines.doc-id eq idoc-id
     3675      no-lock:
     3676         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3677                          output vMarking         , output vArtic          , output vTransitional).
     3678         for each utd-marking-lines
     3679                     where utd-marking-lines.db-num  = utd-lines.db-num
     3680                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3681                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3682         no-lock:
     3683            if length(utd-marking-lines.mark) < 14
     3684            then do:
     3685               if (vMarking or vArtic) and not vTransitional
     3686               then
     3687                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3688            end.
     3689            else if not isMark(utd-marking-lines.mark)
     3690            then do:
     3691               if vMarking
     3692               then
     3693                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3694            end.
     3695            else do:
     3696            end.
     3697         end.
     3698      end.
     3699   end.
     3700   function WeighedProd return logical
     3701      ( input p-gds-code as integer) :
     3702      define variable v-par-val  as character no-undo.
     3703      define variable v-par-type as character no-undo.
     3704              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3705               ( p-gds-code,
     3706                 'weighed-gds':U,
     3707                  output v-par-val,
     3708                  output v-par-type
     3709               ).
     3710      return logical(v-par-val).
     3711   end.
     3712   function WghProdVariable return logical
     3713       (input p-obj-type as char,
     3714        input p-obj-code as integer,
     3715        input p-gds-code as integer) :
     3716      define variable v-wgh-val  as character no-undo.
     3717      define variable v-par-val  as character no-undo.
     3718      define variable v-par-type as character no-undo.
     3719      define variable vMarking        as logical no-undo.
     3720      define variable vArtic          as logical no-undo.
     3721      define variable vTransitional   as logical no-undo.
     3722      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3723         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3724           ( p-gds-code,
     3725             'weighed-gds':U,
     3726              output v-wgh-val,
     3727              output v-par-type
     3728           ).
     3729       if logical(v-wgh-val) = yes then do:
     3730           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3731               ( p-gds-code,
     3732                 'mark-type':U,
     3733                  output v-par-val,
     3734                  output v-par-type
     3735               ).
     3736           if v-par-val <> "" then do:
     3737               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3738               assign
     3739                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3740                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3741                  .
     3742           end.
     3743      end.
     3744      if v-wgh-val > "" and (vMarking or vArtic)
     3745      then return yes.
     3746      else return no.
     3747   end.
     3748   function MarkWeight return decimal
     3749      ( input p-mark as character) :
     3750      define buffer  buf_marking-attr for  ub.marking-attr.
     3751      define variable vMarkWeight as decimal no-undo.
     3752      vMarkWeight = 0.
     3753      if p-mark <> "" and p-mark <> ?
     3754      then do:
     3755          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3756                                        and buf_marking-attr.attr-code eq "weight"
     3757             no-lock no-error.
     3758          if not available buf_marking-attr
     3759          then do :
     3760            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3761                                          and buf_marking-attr.attr-code eq "weight"
     3762               no-lock no-error.
     3763          end .
     3764          if avail buf_marking-attr
     3765          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3766      end.
     3767      return vMarkWeight.
     3768   end.
     3769   define input parameter parparentproc as handle no-undo .
     3770   define input parameter p-fbr-line-recid as recid no-undo .
     3771   define variable iLang           as integer   no-undo.
     3772   define variable p-value-logical as logical no-undo.
     3773   define variable p-value-character  as character no-undo.
     3774   define variable p-value-date       as date no-undo.
     3775   define variable p-value-decimal    as decimal no-undo.
     3776   define variable p-value-integer    as integer no-undo.
     3777   define variable p-param-type       as character no-undo.
     3778   define variable v-tth as handle no-undo .
     3779   define variable v-alc-code      as character no-undo .
     3780   define variable v-proc-name-err as character no-undo initial 'impmark.txt'.
     3781   define variable l-error         as logical   no-undo.
     3782   define variable v-user-action   as character no-undo.
     3783   define variable v-printed       as logical   no-undo.
     3784   define variable v-mark-short     as character no-undo.
     3785   define buffer t_doc        for ub.fbr-doc .
     3786   define buffer buf_fbr-doc   for ub.fbr-doc .
     3787   define buffer buf_marking  for ub.marking .
     3788   define buffer buf_marking-lines  for ub.marking-lines .
     3789   define buffer buf_fbr-line  for ub.fbr-line.
     3790   define buffer buf_recipe   for ub.recipe .
     3791   define buffer buf_bar-code  for ub.bar-code.
     3792   define buffer buf_goods for ub.goods .
     3793   define buffer buf_gds-obj for ub.gds-obj .
     3794   define variable v-timedelay  as integer   no-undo.
     3795   define variable v-scan-str as character no-undo.
     3796   define variable v-num-str as integer no-undo .
     3797   define variable v-manual as logical no-undo .
     3798   define variable marking    as class ibs.th.skt.ControlledClients.marking.
     3799   define variable v-free-qnty as decimal no-undo .
     3800   define variable v-doc-qnty as decimal no-undo .
     3801   define variable v-scan-qnty as decimal no-undo .
     3802   define variable v-status-message as character no-undo .
     3803   define variable v-mark-weight as decimal no-undo .
     3804   define variable v-isweighed as logical no-undo .
     3805   define stream str-err .
     3806   define stream in-stream.
     3807   DEFINE BUTTON b-exit AUTO-GO
     3808        LABEL "&Выход"
     3809        SIZE 10 BY 1
     3810        BGCOLOR 8 .
     3811   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
     3812        VIEW-AS FILL-IN
     3813        SIZE 84 BY 1 NO-UNDO.
     3814   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     3815        LABEL "Марка"
     3816        VIEW-AS FILL-IN
     3817        SIZE 76 BY 1 NO-UNDO.
     3818   DEFINE FRAME Dialog-Frame
     3819        b-exit AT ROW 1 COL 2
     3820        v-mark AT ROW 2.38 COL 2.2
     3821        f-msg AT ROW 3.71 COL 2 NO-LABEL WIDGET-ID 92
     3822        SPACE(1.39) SKIP(0.57)
     3823       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3824            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3825            TITLE "Ввод марок для производства"
     3826            DEFAULT-BUTTON b-exit.
     3827   ASSIGN
     3828          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3829          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3830   ASSIGN
     3831          f-msg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3832   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3833   do:
     3834   end.
     3835   ON any-printable OF v-mark IN FRAME Dialog-Frame
     3836   do:
     3837     run proc-any-key.
     3838   end.
     3839   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     3840   DO:
     3841       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3842       run adm/shattri.p (
     3843                  input "get":U
     3844                  ,input  v-cntxt-obj-type
     3845                  ,input  v-cntxt-obj-code
     3846                  ,input  'marking':U
     3847                  ,input  'rus-key':U
     3848                  ,output p-value-character
     3849                  ,output p-value-date
     3850                  ,output p-value-decimal
     3851                  ,output p-value-integer
     3852                  ,output p-value-logical
     3853                  ,output p-param-type
     3854                  ,input-output table-handle v-tth
     3855                  ) no-error .
     3856       IF p-value-logical = yes THEN  iLang = 68748313.
     3857       run ActivateKeyboardLayout (input iLang, input 0).
     3858     END.
     3859   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     3860   DO:
     3861       assign frame Dialog-Frame v-mark .
     3862   END.
     3863   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     3864   DO:
     3865       run save_update .
     3866   END.
     3867   ON return OF v-mark IN FRAME Dialog-Frame
     3868   DO:
     3869       run save_update .
     3870   END.
     3871   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3872     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3873   MAIN-BLOCK:
     3874   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3875   :
     3876     define variable v-GTIN as character no-undo .
     3877     define variable v-GTIN-qnty as decimal no-undo .
     3878     define variable v-par-type as character no-undo.
     3879     define variable v-par-val  as character no-undo.
     3880   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3881     run mainmenu_getcntxt in parparentproc
     3882       (output v-cntxt-db-num
     3883       ,output v-cntxt-userid
     3884       ,output v-cntxt-level
     3885       ,output v-cntxt-host-code-obj
     3886       ,output v-cntxt-obj-type
     3887       ,output v-cntxt-obj-code
     3888       ,output v-cntxt-db-num-obj
     3889       ,output v-cntxt-is-admin
     3890       ) .
     3891     assign v-num-str = 0 .
     3892     marking = new ibs.th.skt.ControlledClients.marking() .
     3893     find first buf_fbr-line no-lock where recid(buf_fbr-line) = p-fbr-line-recid no-error .
     3894     if not available buf_fbr-line
     3895     then do :
     3896       message "Строка производства не выбрана!" view-as alert-box .
     3897       return error .
     3898     end .
     3899     assign v-doc-qnty = buf_fbr-line.fact-qnty .
     3900     find first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3901                                    and buf_goods.prod-type  = buf_fbr-line.prod-type
     3902                                    and buf_goods.prod-code  = buf_fbr-line.prod-code
     3903                                    .
     3904     v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
     3905     assign v-free-qnty = 0 .
     3906     find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     3907                                      and buf_gds-obj.obj-code  = v-cntxt-obj-code
     3908                                      and buf_gds-obj.artic     = buf_goods.artic
     3909                                      and buf_gds-obj.prod-type = buf_goods.prod-type
     3910                                      and buf_gds-obj.prod-code = buf_goods.prod-code
     3911                                      no-error .
     3912     if available buf_gds-obj
     3913     then do :
     3914       assign v-free-qnty = buf_gds-obj.free-qnty .
     3915     end .
     3916     assign v-scan-qnty = 0 .
     3917     for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3918                                          and buf_marking-lines.obj-type = v-cntxt-obj-type
     3919                                          and buf_marking-lines.obj-code = v-cntxt-obj-code
     3920                                          and buf_marking-lines.in-code  = "manufacturing"
     3921                                          and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3922                                          and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3923                                          and buf_marking-lines.prt-code = 0
     3924     :
     3925       if v-isweighed
     3926       then do :
     3927         for first buf_marking no-lock where buf_marking.mark begins buf_marking-lines.mark :
     3928           v-mark-weight = MarkWeight(buf_marking.mark) .
     3929           assign v-scan-qnty = v-scan-qnty + v-mark-weight .
     3930         end .
     3931       end .
     3932       else do :
     3933         v-GTIN = getGtinByDM(buf_marking-lines.mark) .
     3934         v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     3935         if v-GTIN-qnty = 1
     3936         then do :
     3937           v-scan-qnty = v-scan-qnty + v-GTIN-qnty .
     3938         end .
     3939       end .
     3940     end .
     3941     if v-doc-qnty = v-scan-qnty
     3942     then do :
     3943       message "Сканирование КМ не требуется" view-as alert-box .
     3944       return .
     3945     end .
     3946     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3947     run adm/shattri.p (
     3948              input "get":U
     3949              ,input  v-cntxt-obj-type
     3950              ,input  v-cntxt-obj-code
     3951              ,input  'marking':U
     3952              ,input  'rus-key':U
     3953              ,output p-value-character
     3954              ,output p-value-date
     3955              ,output p-value-decimal
     3956              ,output p-value-integer
     3957              ,output p-value-logical
     3958              ,output p-param-type
     3959              ,input-output table-handle v-tth
     3960              ) no-error .
     3961     IF p-value-logical = yes THEN  iLang = 68748313.
     3962     run ActivateKeyboardLayout (input iLang, input 0).
     3963     RUN enable_UI.
     3964     v-status-message = "Книжный остаток: " + string(v-free-qnty) +
     3965                "    Указано в документе: " + string(v-doc-qnty) +
     3966                "    Просканировано: " + string(v-scan-qnty) .
     3967     run dispmessage (v-status-message).
     3968     apply "entry" to v-mark in FRAME Dialog-Frame.
     3969     enable v-mark with frame Dialog-Frame.
     3970     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     3971     then v-manual = yes.
     3972     else do:
     3973       v-manual = no .
     3974       v-mark:READ-ONLY IN FRAME Dialog-Frame = TRUE .
     3975     end.
     3976     WAIT-FOR GO OF FRAME Dialog-Frame.
     3977   END.
     3978   RUN disable_UI.
     3979   PROCEDURE ActivateKeyboardLayout external "user32" :
     3980   define input parameter P1 as LONG.
     3981      define input parameter P2 as LONG.
     3982   END PROCEDURE.
     3983   PROCEDURE CrCheckMark :
     3984     define buffer buf_recipe for ub.recipe .
     3985     define buffer buf_recipe-gds for ub.recipe-gds .
     3986     define buffer buf_marking-child for ub.marking .
     3987     define buffer buf_marking-parent for ub.marking .
     3988     define buffer buf2_goods for ub.goods .
     3989     define variable v-par-type as character no-undo.
     3990     define variable v-par-val  as character no-undo.
     3991     define variable v-gds-code as integer no-undo .
     3992     define variable v-num-recipes as integer no-undo .
     3993     define variable v-GTIN as character no-undo .
     3994     define variable v-GTIN-qnty as decimal no-undo .
     3995     define variable v-mark-child-qnty as decimal no-undo .
     3996     define variable v-old-sts as integer no-undo .
     3997     define variable v-recipe-code like ub.recipe.recipe-code no-undo .
     3998     define variable v-ingr-gds-code as integer no-undo .
     3999     define variable v-exp-date-txt as character no-undo .
     4000     define variable v-GisMTcheckStatus as integer no-undo .
     4001     define variable v-is-off-line as logical no-undo .
     4002     assign
     4003       v-mark = v-mark:screen-value in frame Dialog-Frame.
     4004     if v-mark = ""
     4005       then return.
     4006     v-mark-short = GetCodeIdent(v-mark).
     4007     if v-mark-short = "" or v-mark-short = ?
     4008     then do:
     4009       message ("Неизвестный формат марки. Отсканируйте другую марку.")
     4010       view-as alert-box .
     4011       return.
     4012     end.
     4013     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     4014     if available buf_marking
     4015     then do :
     4016       v-GTIN = getGtinByDM(buf_marking.mark) .
     4017     end .
     4018     else do :
     4019       v-GTIN = getGtinByDM(v-mark) .
     4020     end .
     4021     v-gds-code = getGdsCodeByGtin(v-GTIN) .
     4022     v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     4023     if v-gds-code = ?
     4024     then do :
     4025       message ("Товар не найден. Отсканируйте другую марку.")
     4026       view-as alert-box .
     4027       return.
     4028     end .
     4029     find first buf2_goods no-lock where buf2_goods.gds-code = v-gds-code no-error .
     4030     if not available buf2_goods
     4031     then do :
     4032       message ("Товар не найден. Отсканируйте другую марку.")
     4033       view-as alert-box .
     4034       return.
     4035     end .
     4036     if buf_goods.gds-code <> buf2_goods.gds-code
     4037     then do :
     4038       message ("Марка принадлежит другому товару.")
     4039       view-as alert-box .
     4040       return.
     4041     end .
     4042     if v-GTIN-qnty = ?
     4043     or v-GTIN-qnty <= 0.0
     4044     then do :
     4045       message ("Не установлен коэффициент для упаковки.")
     4046       view-as alert-box .
     4047       return.
     4048     end .
     4049     find first buf_marking-lines no-lock where buf_marking-lines.out-code  = buf_fbr-line.doc-code
     4050                                            and v-mark begins buf_marking-lines.mark
     4051                                            no-error .
     4052     if available buf_marking-lines
     4053     then do :
     4054       message ("Марка добавлена в документ ранее.")
     4055       view-as alert-box .
     4056       return.
     4057     end .
     4058       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4059     ( buf_goods.gds-code,
     4060      'mark-type':U,
     4061      output v-par-val,
     4062      output v-par-type
     4063     ).
     4064     v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
     4065     if v-isweighed
     4066     then do :
     4067       if available buf_marking
     4068       then do :
     4069         v-mark-weight = MarkWeight(buf_marking.mark) .
     4070         if v-mark-weight = 0
     4071         or v-mark-weight = ?
     4072         then do :
     4073           message ("Марка не может быть добавлена, т.к. в БД отсутствует ее вес.")
     4074           view-as alert-box .
     4075           return.
     4076         end .
     4077       end .
     4078       else do :
     4079         message ("Марка не найдена в БД.")
     4080         view-as alert-box .
     4081         return.
     4082       end .
     4083     end .
     4084     if not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     4085     and not v-isweighed
     4086     then do :
     4087       message ("Сканирование марок данного товара для производства не требуется")
     4088       view-as alert-box .
     4089       return.
     4090     end .
     4091     run waitfram-show in this-procedure (input "Идет проверка марки, пожалуйста, подождите..." ).
     4092     if available buf_marking
     4093     then do :
     4094       v-exp-date-txt = marking:ChekExpirationDate(v-cntxt-obj-type, v-cntxt-obj-code, buffer buf_marking).
     4095       if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     4096       and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4097       then do :
     4098         run waitfram-hide in this-procedure .
     4099         message (substitute("Операция невозможна. Статус марки – <&1>. ", objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)) + v-exp-date-txt)
     4100         view-as alert-box .
     4101         return.
     4102       end .
     4103       if v-exp-date-txt > ""
     4104       then do :
     4105         run waitfram-hide in this-procedure .
     4106         message (v-exp-date-txt)
     4107         view-as alert-box .
     4108         return .
     4109       end .
     4110     end .
     4111     else do :
     4112       create buf_marking .
     4113       assign
     4114         buf_marking.mark = v-mark-short
     4115         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     4116         buf_marking.box-qnty = v-GTIN-qnty
     4117         buf_marking.obj-type = v-cntxt-obj-type
     4118         buf_marking.obj-code = v-cntxt-obj-code
     4119         buf_marking.gds-code = buf_goods.gds-code
     4120         buf_marking.unit     = buf_goods.unit-base
     4121         buf_marking.gds-ext-id = v-GTIN
     4122       .
     4123     end .
     4124     run waitfram-hide in this-procedure .
     4125     if integer(v-GTIN-qnty) <> 1
     4126     then do :
     4127       assign v-mark-child-qnty = 0 .
     4128       if available buf_marking
     4129       then do :
     4130         for each buf_marking-child no-lock where buf_marking-child.mark-parent = buf_marking.mark :
     4131           v-mark-child-qnty = v-mark-child-qnty + 1 .
     4132         end .
     4133       end .
     4134       if v-mark-child-qnty <> v-GTIN-qnty
     4135       then do :
     4136         message ("Состав групповой упаковки неизвестен, необходимо отсканировать потребительские упаковки")
     4137         view-as alert-box .
     4138         return.
     4139       end .
     4140       if (v-scan-qnty + v-GTIN-qnty) > v-doc-qnty
     4141       then do :
     4142         message "Марка групповой упаковки не может быть добавлена в документ, т.к. будет превышено количество товара по документу. Сканируйте потребительские упаковки"
     4143         view-as alert-box .
     4144         return.
     4145       end .
     4146     end .
     4147     find current buf_marking exclusive-lock no-error .
     4148     if locked buf_marking
     4149     then do :
     4150       run dispmessage ("Марка не может быть добавлена, т.к. с ней работает другой пользователь").
     4151       return.
     4152     end .
     4153     assign
     4154       v-old-sts = buf_marking.sts
     4155       buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4156     .
     4157     create buf_marking-lines .
     4158     assign
     4159       buf_marking-lines.mark      = buf_marking.mark
     4160       buf_marking-lines.obj-type  = v-cntxt-obj-type
     4161       buf_marking-lines.obj-code  = v-cntxt-obj-code
     4162       buf_marking-lines.gds-code  = buf_goods.gds-code
     4163       buf_marking-lines.in-code   = "manufacturing"
     4164       buf_marking-lines.out-code  = buf_fbr-line.doc-code
     4165       buf_marking-lines.part-code = buf_fbr-line.recipe-code
     4166       buf_marking-lines.prt-code  = 0
     4167       buf_marking-lines.doc-level = 1
     4168     .
     4169     for each buf_marking-child exclusive-lock where buf_marking-child.mark-parent = buf_marking.mark :
     4170       assign
     4171         v-old-sts = buf_marking-child.sts
     4172         buf_marking-child.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4173       .
     4174       create buf_marking-lines .
     4175       assign
     4176         buf_marking-lines.mark = buf_marking-child.mark
     4177         buf_marking-lines.obj-type  = v-cntxt-obj-type
     4178         buf_marking-lines.obj-code  = v-cntxt-obj-code
     4179         buf_marking-lines.gds-code  = buf_goods.gds-code
     4180         buf_marking-lines.in-code   = "manufacturing"
     4181         buf_marking-lines.out-code  = buf_fbr-line.doc-code
     4182         buf_marking-lines.part-code = buf_fbr-line.recipe-code
     4183         buf_marking-lines.prt-code  = 0
     4184         buf_marking-lines.doc-level = 2
     4185       .
     4186     end .
     4187     for first buf_marking-parent exclusive-lock where buf_marking-parent.mark = buf_marking.mark-parent
     4188                                                   and buf_marking.mark-parent > ""
     4189     :
     4190       assign buf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4191     end .
     4192     if v-isweighed
     4193     then do :
     4194       assign v-scan-qnty = v-scan-qnty + v-mark-weight .
     4195     end .
     4196     else do :
     4197       assign v-scan-qnty = v-scan-qnty + integer(v-GTIN-qnty) .
     4198     end .
     4199   end.
     4200   PROCEDURE disable_UI :
     4201     HIDE FRAME Dialog-Frame.
     4202   END PROCEDURE.
     4203   PROCEDURE dispmessage :
     4204   define input parameter p-str as character no-undo.
     4205     f-msg:fgcolor in frame Dialog-Frame = 12.
     4206     do:
     4207       display p-str @ f-msg with frame Dialog-Frame.
     4208     end.
     4209   END PROCEDURE.
     4210   PROCEDURE enable_UI :
     4211     DISPLAY v-mark f-msg
     4212         WITH FRAME Dialog-Frame.
     4213     ENABLE b-exit v-mark
     4214         WITH FRAME Dialog-Frame.
     4215     VIEW FRAME Dialog-Frame.
     4216   END PROCEDURE.
     4217   PROCEDURE LoadKeyboardLayoutA external "user32" :
     4218   define input  parameter P1 as char.
     4219     define input  parameter P2 as LONG.
     4220     define return parameter pret as LONG.
     4221   end procedure.
     4222   PROCEDURE proc-any-key :
     4223   if not v-manual
     4224       then
     4225       if v-scan-str = ""
     4226         then etime(yes).
     4227       else
     4228         if etime > 700
     4229           then v-scan-str = "".
     4230     v-scan-str = v-scan-str + last-event:label.
     4231   end.
     4232   PROCEDURE save_update :
     4233   define variable v-error      as logical   no-undo init no.
     4234     define variable l-error      as logical   no-undo init no.
     4235     define variable v-error-lang as logical   no-undo init no.
     4236     define variable ii           as integer   no-undo .
     4237     define variable chg-qnty     as integer   no-undo .
     4238     do trans:
     4239       f-msg:screen-value in frame Dialog-Frame = "" .
     4240       if v-mark:screen-value in frame Dialog-Frame = ""
     4241       then do:
     4242         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4243         v-scan-str = "".
     4244       end.
     4245       assign
     4246         v-mark = v-mark:screen-value in frame Dialog-Frame.
     4247       if v-mark = ""
     4248         then return.
     4249       run CrCheckMark.
     4250       v-mark = "".
     4251       v-mark:screen-value in frame Dialog-Frame = "".
     4252       v-mark-short = "".
     4253       v-status-message = "Книжный остаток: " + string(v-free-qnty) +
     4254                "    Указано в документе: " + string(v-doc-qnty) +
     4255                "    Просканировано: " + string(v-scan-qnty) .
     4256       run dispmessage (v-status-message).
     4257       if v-doc-qnty = v-scan-qnty
     4258       then do :
     4259         apply "CHOOSE" to b-exit in frame Dialog-Frame.
     4260       end .
     4261     end.
     4262   end procedure.
