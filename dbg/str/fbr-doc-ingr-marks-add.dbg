      451     end.
      452   end procedure.
      453   procedure lineattr-write-add-line-cli :
      454   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      455   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      456   define input  parameter p-cli-type      as character no-undo .
      457   define input  parameter p-cli-code      as integer   no-undo .
      458   define input  parameter p-contract-code as integer   no-undo .
      459   define input  parameter p-host-code     as integer   no-undo .
      460   define input  parameter p-exch-code     as integer   no-undo .
      461   define input  parameter p-exch-rate     as decimal   no-undo .
      462   define input  parameter p-exch-scale    as integer   no-undo .
      463   define input  parameter p-sum-cli       as decimal   no-undo .
      464   define input  parameter p-sum-vat       as decimal   no-undo .
      465   define buffer buf_doc-line-attr for ub.doc-line-attr .
      466     do
      467     on error undo, return error return-value
      468     :
      469       find first buf_doc-line-attr exclusive-lock
      470         where buf_doc-line-attr.doc-code  = p-doc-code
      471           and buf_doc-line-attr.gds-code  = p-gds-code
      472           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      473                                             chr(4) + p-cli-type +
      474                                             chr(4) + string(p-cli-code) +
      475                                             chr(4) + string(p-contract-code) +
      476                                             chr(4) + string(p-host-code)
      477         no-error .
      478       if not available buf_doc-line-attr then do:
      479         create buf_doc-line-attr .
      480         assign
      481           buf_doc-line-attr.doc-code  = p-doc-code
      482           buf_doc-line-attr.gds-code  = p-gds-code
      483           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      484                                         chr(4) + p-cli-type +
      485                                         chr(4) + string(p-cli-code) +
      486                                         chr(4) + string(p-contract-code) +
      487                                         chr(4) + string(p-host-code)
      488         .
      489       end.
      490       assign
      491         buf_doc-line-attr.attr-value =
      492         string(p-exch-code)  + chr(4) +
      493         string(p-exch-rate)  + chr(4) +
      494         string(p-exch-scale) + chr(4) +
      495         string(p-sum-cli)    + chr(4) +
      496         string(p-sum-vat)
      497         .
      498     end.
      499   end procedure.
      500   procedure lineattr-value-add-line-cli :
      501   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      502   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      503   define input   parameter p-cli-type      as character no-undo .
      504   define input   parameter p-cli-code      as integer   no-undo .
      505   define input   parameter p-contract-code as integer   no-undo .
      506   define input   parameter p-host-code     as integer   no-undo .
      507   define output  parameter p-exch-code     as integer   no-undo .
      508   define output  parameter p-exch-rate     as decimal   no-undo .
      509   define output  parameter p-exch-scale    as integer   no-undo .
      510   define output  parameter p-sum-cli       as decimal   no-undo .
      511   define output  parameter p-sum-vat       as decimal   no-undo .
      512   define buffer buf_doc-line-attr for ub.doc-line-attr .
      513     do
      514     on error undo, return error return-value
      515     :
      516       find first buf_doc-line-attr exclusive-lock
      517         where buf_doc-line-attr.doc-code  = p-doc-code
      518           and buf_doc-line-attr.gds-code  = p-gds-code
      519           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      520                                             chr(4) + p-cli-type +
      521                                             chr(4) + string(p-cli-code) +
      522                                             chr(4) + string(p-contract-code) +
      523                                             chr(4) + string(p-host-code)
      524         no-error .
      525       if available buf_doc-line-attr then do:
      526        assign
      527           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      528           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      529           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      530           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      531           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      532          .
      533        end.
      534     end.
