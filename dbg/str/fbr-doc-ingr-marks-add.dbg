      624   procedure xmlchar-test :
      625   define input parameter p-in-string          as character        no-undo.
      626   define output parameter p-out-string-enc    as character        no-undo.
      627   define output parameter p-out-string-dec    as character        no-undo.
      628   do
      629   on error undo, return error
      630   :
      631          run xmlchar-encode in this-procedure
      632       (
      633             input p-in-string
      634           , output p-out-string-enc
      635       ).
      636          run xmlchar-decode in this-procedure
      637       (
      638             input p-out-string-enc
      639           , output p-out-string-dec
      640       ).
      641   end.
      642   end .
      643   procedure xmlchar-encode :
      644   define input parameter p-in-string      as character        no-undo.
      645   define output parameter p-out-string    as character        no-undo.
      646       define variable v-position      as integer      no-undo.
      647       define variable v-current-char  as character    no-undo.
      648   do
      649   on error undo, return error
      650   :
      651       assign
      652           p-out-string = "":U
      653       .
      654       case p-in-string
      655       :
      656           when ?
      657           then do:
      658               assign
      659                   p-out-string = "?":U
      660               .
      661           end.
      662           when "?":U
      663           then do:
      664               assign
      665                   p-out-string = "&#63;":U
      666               .
      667           end.
      668           otherwise do:
      669               do v-position = 1 to length( p-in-string )
      670               :
      671                   assign
      672                       v-current-char = substring( p-in-string, v-position, 1 )
      673                   .
      674                   case v-current-char
      675                   :
      676                       when "&":U
      677                       then do:
      678                           assign
      679                               p-out-string = p-out-string + "&amp;":U
      680                           .
      681                       end.
      682                       when ">":U
      683                       then do:
      684                           assign
      685                               p-out-string = p-out-string + "&gt;":U
      686                           .
      687                       end.
      688                       when "<":U
      689                       then do:
      690                           assign
      691                               p-out-string = p-out-string + "&lt;":U
      692                           .
      693                       end.
      694                       when "'":U
      695                       then do:
      696                           assign
      697                               p-out-string = p-out-string + "&apos;":U
      698                           .
      699                       end.
      700                       when '"':U
      701                       then do:
      702                           assign
      703                               p-out-string = p-out-string + "&quot;":U
      704                           .
      705                       end.
      706                       when chr(1)
      707                       then do:
      708                           assign
      709                               p-out-string = p-out-string + "":U
      710                           .
      711                       end.
      712                       when chr(2)
      713                       then do:
      714                           assign
      715                               p-out-string = p-out-string + "":U
      716                           .
      717                       end.
      718                       when chr(3)
      719                       then do:
      720                           assign
      721                               p-out-string = p-out-string + "":U
      722                           .
      723                       end.
      724                       when chr(4)
      725                       then do:
      726                           assign
      727                               p-out-string = p-out-string + "":U
      728                           .
      729                       end.
      730                       when chr(5)
      731                       then do:
      732                           assign
      733                               p-out-string = p-out-string + "":U
      734                           .
      735                       end.
      736                       when chr(6)
      737                       then do:
      738                           assign
      739                               p-out-string = p-out-string + "":U
      740                           .
      741                       end.
      742                       when chr(7)
      743                       then do:
      744                           assign
      745                               p-out-string = p-out-string + "":U
      746                           .
      747                       end.
      748                       when chr(8)
      749                       then do:
      750                           assign
      751                               p-out-string = p-out-string + "":U
      752                           .
      753                       end.
      754                       when chr(9)
      755                       then do:
      756                           assign
      757                               p-out-string = p-out-string + "":U
      758                           .
      759                       end.
      760                       when chr(29)
      761                       then do:
      762                           assign
      763                               p-out-string = p-out-string + "":U
      764                           .
      765                       end.
      766                       when chr(10)
      767                       then do:
      768                           assign
      769                               p-out-string = p-out-string + "&#10;":U
      770                           .
      771                       end.
      772                       when chr(13)
      773                       then do:
      774                           assign
      775                               p-out-string = p-out-string + "&#13;":U
      776                           .
      777                       end.
      778                       otherwise do:
      779                           assign
      780                               p-out-string = p-out-string + v-current-char
      781                           .
      782                       end.
      783                   end case.
      784               end.
      785           end.
      786       end case.
      787   end.
      788   end .
      789   procedure xmlchar-encode-1c :
