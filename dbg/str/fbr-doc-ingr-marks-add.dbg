      536   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      537     define variable v-code as character no-undo .
      538     define variable v-type as character no-undo .
      539     define variable v-gds-code as integer   no-undo .
      540   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      542     (input  local-doc-line.artic
      543     ,input  local-doc-line.prod-type
      544     ,input  local-doc-line.prod-code
      545     ,output v-gds-code
      546     )  .
      547     run lineattr-value (
      548         input   local-doc-line.doc-code ,
      549         input   v-gds-code              ,
      550         input   'reason-code':U ,
      551         output  v-code                  ,
      552         output  v-type ) .
      553     find first ub.trn-reason no-lock where
      554                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      555     if not available ub.trn-reason then do:
      556        return "" .
      557     end.
      558     else do:
      559        return ub.trn-reason.reason-name .
      560     end.
      561   end function.
      562   procedure lineattr-value-parts :
      563     do
      564     on error undo, return error return-value
      565     :
      566       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      567       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      568       define input  parameter p-part-code   as character no-undo .
      569       define input  parameter p_in-code     as character no-undo .
      570       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      571       define output parameter p-value       as    decimal   no-undo .
      572       define buffer buf_doc-line-attr for ub.doc-line-attr .
      573       find first buf_doc-line-attr no-lock
      574         where buf_doc-line-attr.doc-code  = p-doc-code
      575           and buf_doc-line-attr.gds-code  = p-gds-code
      576           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      577         no-error .
      578       if avail buf_doc-line-attr then do:
      579         assign
      580           p-value = decimal( buf_doc-line-attr.attr-value)
      581         .
      582       end.
      583       else do:
      584         assign
      585           p-value = 0
      586         .
      587       end.
      588     end.
      589   end procedure.
      590   procedure lineattr-write-parts :
      591     do
      592     on error undo, return error return-value
      593     :
      594       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      595       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      596       define input parameter p-part-code  as character no-undo .
      597       define input parameter p_in-code    as character no-undo .
      598       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      599       define input parameter p-value      as decimal   no-undo .
      600       define buffer buf_doc-line-attr for ub.doc-line-attr .
      601       find first buf_doc-line-attr exclusive-lock
      602         where buf_doc-line-attr.doc-code  = p-doc-code
      603           and buf_doc-line-attr.gds-code  = p-gds-code
      604           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      605         no-error .
      606       if not available buf_doc-line-attr then do:
      607         create buf_doc-line-attr .
      608         assign
      609           buf_doc-line-attr.doc-code  = p-doc-code
      610           buf_doc-line-attr.gds-code  = p-gds-code
      611           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      612         .
      613       end.
      614       assign
      615         buf_doc-line-attr.attr-value = string( p-value )
      616       .
      617     end.
      618   end procedure.
