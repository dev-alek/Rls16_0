      899   procedure xmlchar-decode :
      900   define input parameter p-in-string      as character        no-undo.
      901   define output parameter p-out-string    as character        no-undo.
      902       define variable v-position      as integer      no-undo.
      903       define variable v-last-position as integer      no-undo.
      904       define variable v-temp-integer  as integer      no-undo.
      905       define variable v-current-char  as character    no-undo.
      906       define variable v-next-char     as character    no-undo.
      907       define variable v-success       as logical      no-undo.
      908   do
      909   on error undo, return error
      910   :
      911       assign
      912           p-out-string = "":U
      913           v-position   = 0
      914       .
      915       replace-cycle:
      916       do while yes
      917       on error undo, return error
      918       :
      919           assign
      920               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      921           .
      922           if v-last-position <= v-position
      923           then do:
      924               if v-position = 0
      925               then do:
      926                   assign
      927                       p-out-string = p-in-string
      928                   .
      929               end.
      930               else do:
      931                   assign
      932                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      933                   .
      934               end.
      935               leave replace-cycle.
      936           end.
      937           else do:
      938               assign
      939                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      940                   v-position      = v-last-position
      941                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      942               .
      943               if v-current-char = "#":U
      944               then do:
      945                   assign
      946                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      947                   .
      948                   if v-last-position > 0
      949                   then do:
      950                       run xmlchar-read-integer in this-procedure
      951                        (
      952                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      953                           , output v-temp-integer
      954                           , output v-success
      955                       ).
      956                       if v-success = yes
      957                       and v-temp-integer >= 1
      958                       and v-temp-integer <= 255
      959                       then do:
      960                           assign
      961                               p-out-string = p-out-string + chr( v-temp-integer )
      962                               v-position   = v-last-position + 1
      963                           .
      964                       end.
      965                       else do:
      966                           assign
      967                               p-out-string = p-out-string + "&":U
      968                               v-position   = v-position   + 1
      969                           .
      970                       end.
      971                   end.
      972                   else do:
      973                       assign
      974                           p-out-string = p-out-string + "&":U
      975                           v-position   = v-position   + 1
      976                       .
      977                   end.
      978               end.
      979               else do:
      980                   case substring( p-in-string, v-position + 1, 3 )
      981                   :
      982                       when "lt;":U
      983                       then do:
      984                           assign
      985                               p-out-string = p-out-string + "<":U
      986                               v-position   = v-position   + 3
      987                           .
      988                       end.
      989                       when "gt;":U
      990                       then do:
      991                           assign
      992                               p-out-string = p-out-string + ">":U
      993                               v-position   = v-position   + 3
      994                           .
      995                       end.
      996                       otherwise do:
      997                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      998                           then do:
      999                               assign
     1000                                   p-out-string = p-out-string + "&":U
     1001                                   v-position   = v-position   + 4
     1002                               .
     1003                           end.
     1004                           else do:
     1005                               case substring( p-in-string, v-position + 1, 5 )
     1006                               :
     1007                                   when "quot;":U
     1008                                   then do:
     1009                                       assign
     1010                                           p-out-string = p-out-string + '"':U
     1011                                           v-position   = v-position   + 5
     1012                                       .
     1013                                   end.
     1014                                   when "apos;":U
     1015                                   then do:
     1016                                       assign
     1017                                           p-out-string = p-out-string + "'":U
     1018                                           v-position   = v-position   + 5
     1019                                       .
     1020                                   end.
     1021                                   otherwise do:
     1022                                       assign
     1023                                           p-out-string = p-out-string + "&":U
     1024                                       .
     1025                                   end.
     1026                               end case.
     1027                           end.
     1028                       end.
     1029                   end case.
     1030               end.
     1031           end.
     1032       end.
     1033   end.
     1034   end .
     1035   procedure xmlchar-read-integer :
     1036   define input parameter p-input-string      as character        no-undo.
     1037   define output parameter p-output-integer   as integer          no-undo.
     1038   define output parameter p-success       as logical          no-undo.
     1039   do
     1040   on error undo, return error
     1041   :
     1042       assign
     1043           p-output-integer = integer( p-input-string )
     1044       no-error.
     1045       if error-status :error
     1046       then do:
     1047           assign
     1048               p-success           = no
     1049               p-output-integer    = 0
     1050           .
     1051       end.
     1052       else do:
     1053           assign
     1054               p-success           = yes
     1055           .
     1056       end.
     1057   end.
     1058   end.
     1059   define variable mMRCCode  as logical    no-undo.
     1060   define variable mTypeMark as character  no-undo.
     1061   function IS-NeedMark returns logical
     1062   ( input ib-code as integer  ,
     1063     input ib-str as character ):
     1064      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1065      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1066                                    and buf_prod-bc-attr.b-str  eq ib-str
     1067                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1068        no-lock no-error.
     1069      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1070   end.
     1071   function repTegforDm return char
     1072   (iDM as char ):
     1073       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1074       define variable vteg as character no-undo.
     1075       define variable oDM as character no-undo.
     1076       define variable vi as integer no-undo.
     1077       oDM = iDm.
     1078       do vi = 1 to num-entries(vTeglist):
     1079          vTeg = entry(vi,vTeglist).
     1080          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1081       end.
     1082       return oDM.
     1083   end.
     1084   function repSpecSimbforDm return char
     1085   (iDM as char ):
     1086       define variable oDM as character no-undo.
     1087     run
     1088       xmlchar-decode(iDM, output oDM).
     1089     return repTegforDm (oDM).
     1090   end.
     1091   function CheckGtin return logical
     1092   (iGtin as char):
     1093      define variable bar_code as character no-undo.
     1094      define variable vGtin as logical no-undo init "yes".
     1095      if length(iGtin) eq 14
     1096      then do:
     1097         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1098         run str/chk-sum.p
     1099          (input-output bar_code ) no-error .
     1100         if iGtin ne  bar_code
     1101         then
     1102            vGtin = no.
     1103      end.
     1104      else
     1105         vGtin = no.
     1106      return vgtin.
     1107   end.
     1108   function repSpecSimbforXlm return char
     1109   (iDM as char ):
     1110       iDM = replace(iDM,chr(29),"").
     1111       return iDM.
     1112   end.
     1113   function getGtinByDM return char
     1114   (IDM as char):
     1115      define variable VTXT as char no-undo.
     1116      define variable vGtin as char no-undo.
     1117      vTXt = IdM.
     1118      vGtin = IDM.
     1119      if    length(vtxt) > 14
     1120      then do:
     1121         if   vtxt begins "(01)"
     1122                or vtxt begins "(02)"
     1123         then
     1124            vGtin = substring(vtxt,5,14).
     1125         else if   (vtxt begins "01"
     1126                or vtxt begins "02" )
     1127                and (   (    substring(iDm,17,2) eq "21"
     1128                         and length(vtxt) >= 21)
     1129                     or substring(iDm,17,2) eq "37"
     1130                     or substring(iDm,17,4) eq "(37)" )
     1131         then do:
     1132            vGtin = substring(vtxt,3,14).
     1133            if not checkGtin(vGtin)
     1134            then
     1135               vGtin = substring(vtxt,1,14).
     1136         end.
     1137         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1138             or length(vtxt) eq 14 + 7 + 4
     1139             or length(vtxt) eq 14 + 7
     1140         then
     1141            vGtin = substring(vtxt,1,14).
     1142      end.
     1143      if not checkGtin(vGtin)
     1144      then
     1145         vGtin = "".
     1146      return vgtin.
     1147   end.
     1148   function getGdsCodeByGtin return int
     1149   (iGtin as char):
     1150      define buffer prod-bc  for ub.prod-bc.
     1151      define buffer bar-code for ub.bar-code.
     1152      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1153      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1154      return if avail bar-code then bar-code.gds-code else ?.
     1155   end.
     1156   function getQntyCodeByGtin return decimal
     1157   (iGtin as char):
     1158      define buffer prod-bc  for ub.prod-bc.
     1159      define buffer bar-code for ub.bar-code.
     1160      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1161      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1162      return if avail bar-code then bar-code.cli-base-rate else ?.
     1163   end.
     1164   function getGdsCodeByDM return int
     1165   (iDm as char):
     1166      define variable vGtin as char no-undo.
     1167      define buffer prod-bc for ub.prod-bc.
     1168      vGtin  = getGtinByDM (IDM ).
     1169      return getGdsCodeByGtin (vGtin).
     1170   end.
     1171   function ChekTypeMarkByGds return logical
     1172   (iGds-code as integer ):
     1173      define buffer goods-attr for ub.goods-attr.
     1174      find first goods-attr where goods-attr.gds-code   = iGds-code
     1175                              and goods-attr.attr-code  = 'mark-type':U
     1176      no-lock no-error.
     1177      if available goods-attr
     1178      then do:
     1179         mTypeMark = goods-attr.attr-value.
     1180         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1181           .
     1182      end.
     1183      else
     1184         return no.
     1185   end.
     1186   function ChekTypeMarkByDm return logical
     1187   (iDM as char ):
     1188      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1189   end.
     1190   function ChekTypeMarkByGtin return logical
     1191   (iGtin as char ):
     1192      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1193   end.
     1194   function GetNextElement return character
     1195     (input iAllTeg        as logical
     1196     ,output oteg          as character
     1197     ,output otegval       as character
     1198     ,input-output pstr    as character
     1199      ):
     1200        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1201        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1202        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1203        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1204        define variable vTeg as character no-undo.
     1205        define variable vLength as integer no-undo.
     1206        define variable vi as integer no-undo.
     1207        define variable vj as integer no-undo.
     1208        define buffer code for ub.code.
     1209        find first code where Code.parent eq "MarkType"
     1210                          and Code.CodeValue   eq mTypeMark
     1211                          no-lock no-error.
     1212        if     available code
     1213           and Code.misc1 ne ""
     1214           and Code.misc1 ne ?
     1215        then do:
     1216           integer (Code.misc1) no-error.
     1217           if not error-status:error
     1218           then
     1219             entry (4,vlistleng) = Code.misc1.
     1220        end.
     1221        if iAllTeg
     1222        then
     1223           assign
     1224              vlistElem     = vlistElem    + vlistElemDop
     1225              vlistleng     = vlistleng    + vlistlengDop
     1226           .
     1227        else if mMRCCode
     1228        then
     1229           assign
     1230              vlistElem     = vlistElem    + ",(8005),8005"
     1231              vlistleng     = vlistleng    + ",000006,0006"
     1232           .
     1233       block-elem:
     1234       do vi = 1 to num-entries(vlistElem):
     1235          vTeg = entry(vi,vlistElem).
     1236          if pstr begins vTeg
     1237          then do:
     1238             if    vTeg eq "21"
     1239             then
     1240                vLength = index(pstr,chr(29)) - 2 no-error.
     1241             if vLength  <= 0
     1242             then
     1243                vLength = int(entry(vi,vlistleng)).
     1244             otegval = substring (pstr,length(vteg) + 1, vLength).
     1245             oteg = replace(replace(vteg,")",""),"(","").
     1246             vTeg = vteg + otegval.
     1247             otegval = replace(otegval,chr(29),"").
     1248             oteg = replace(replace(oteg,")",""),"(","").
     1249             pstr = substring (pstr,length(vTeg)+ 1).
     1250             vTeg = replace(vTeg,chr(29),"").
     1251             leave block-elem.
     1252          end.
     1253          else
     1254             vTeg = "".
     1255       end.
     1256       return vteg.
     1257   end.
     1258   function GetCodeIdent return character
     1259   (iDm as char):
     1260      define variable Velement   as character no-undo init "first".
     1261      define variable oCodeIdent as character no-undo.
     1262      define variable vteg as character no-undo.
     1263      define variable vtegval as character no-undo.
     1264      define variable vGtin as character no-undo.
     1265      define buffer marking for ub.marking.
     1266      for first marking no-lock where
     1267                marking.mark eq iDm
     1268            and marking.unit-ext = "LEVEL2"
     1269      :
     1270        return iDm.
     1271      end.
     1272      vGtin  = getGtinByDM (iDm ).
     1273      ChekTypeMarkByDm(idm).
     1274      if iDm begins 'tech_':U
     1275      then
     1276         oCodeIdent = iDm.
     1277      else if length(iDm) < 21
     1278      then do:
     1279         find first marking where marking.mark eq idm
     1280         no-lock no-error.
     1281         oCodeIdent = if available marking then marking.mark else  ?.
     1282      end.
     1283      else if     length(iDm) eq 29
     1284         and not iDm begins "01"
     1285         and not iDm begins "02"
     1286      then
     1287         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1288      else  if     length(iDm) >= 24
     1289               and (  iDm begins "01"
     1290                   or iDm begins "02")
     1291               and  substring(iDm,17,2) ne "21"
     1292      then do:
     1293         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1294                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1295         then
     1296            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1297         else
     1298            oCodeIdent = iDM.
     1299      end.
     1300      else  if     (   length(iDm) eq 25
     1301                    or length(iDm) eq 21)
     1302               and (not iDm begins "01"
     1303               and  not iDm begins "02")
     1304      then
     1305         oCodeIdent = substring(iDm,1,21).
     1306      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1307      then
     1308         oCodeIdent = substring(iDm,1,21).
     1309      else do while Velement ne "" and idm ne "":
     1310         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1311         oCodeIdent = oCodeIdent + Velement.
     1312      end.
     1313      return oCodeIdent.
     1314   end.
     1315   function GetTegCod return character
     1316   (icodeIdent as char, iTeg as char):
     1317      define variable Velement   as character no-undo init "first".
     1318      define variable oTeg as character no-undo init ?.
     1319      define variable vteg as character no-undo.
     1320      define variable vtegval as character no-undo.
     1321      if     ((length(icodeIdent) eq 21
     1322         and not icodeIdent begins "01"
     1323         and not icodeIdent begins "02")
     1324         or
     1325             ( length(icodeIdent) eq 25
     1326               and not icodeIdent begins "01"
     1327               and not icodeIdent begins "02"))
     1328      then do:
     1329         if iTeg eq "01" or iTeg eq "02"
     1330         then
     1331            oTeg = substring(icodeIdent,1,21).
     1332         else  if  iTeg eq "21"
     1333         then
     1334            oTeg = substring(icodeIdent,15,7).
     1335      end.
     1336      else do:
     1337         ChekTypeMarkByDm(icodeIdent).
     1338         block-teg:
     1339            do while Velement ne "" and icodeIdent ne "":
     1340            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1341            if    Velement begins iTeg
     1342               or Velement begins "(" + iTeg + ")"
     1343            then do:
     1344               oTeg = vtegval.
     1345               leave block-teg.
     1346            end.
     1347         end.
     1348      end.
     1349      return oTeg.
     1350   end.
     1351   function isOAD return logical
     1352   (icodeIdent as character):
     1353      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1354   end.
     1355   function isMark return logical
     1356   (icodeIdent as character):
     1357      define buffer buf_marking for ub.marking.
     1358      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1359             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1360   end.
     1361   function addBracketForCode return character
     1362   (icodeIdent as char):
     1363      define variable Velement   as character no-undo init "first".
     1364      define variable oTeg as character no-undo.
     1365      define variable vteg as character no-undo.
     1366      define variable vtegval as character no-undo.
     1367      define buffer marking for ub.marking.
     1368      find first marking no-lock where
     1369                 marking.mark begins icodeIdent no-error.
     1370      if    not ChekTypeMarkByDm(icodeIdent)
     1371         or length(icodeIdent) le 24
     1372         or (avail marking and marking.unit-ext = "LEVEL2")
     1373      then
     1374         oTeg = icodeIdent.
     1375      else do:
     1376         if (  icodeIdent begins "01"
     1377            or icodeIdent begins "02"
     1378            ) and CheckGtin(substring (icodeIdent,3,14))
     1379            and substring (icodeIdent,17,2) eq "21"
     1380         then do:
     1381            mMRCCode = yes.
     1382            ChekTypeMarkByDm(icodeIdent).
     1383            block-teg:
     1384            do while Velement ne "" and icodeIdent ne "":
     1385               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1386               if vteg ne ""
     1387               then
     1388                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1389            end.
     1390            mMRCCode = no.
     1391         end.
     1392         else do:
     1393            oTeg = icodeIdent.
     1394         end.
     1395      end.
     1396      return oTeg.
     1397   end.
     1398   function getlevelByCodId return int
     1399   (iCode as char):
     1400      define variable vLength as int no-undo.
     1401      define variable vLevel  as int no-undo.
     1402      if not ChekTypeMarkByDM (icode) then return ?.
     1403      vLength = length(iCode).
     1404      if    vLength eq 18
     1405         or vLength eq 20
     1406      then
     1407         Vlevel = 4.
     1408      else if vLength eq 21
     1409      then
     1410         Vlevel = 1.
     1411      else if vLength eq 25
     1412      then do:
     1413         if  iCode begins "01"
     1414         then
     1415            Vlevel = 3.
     1416         else
     1417            Vlevel = 1.
     1418      end.
     1419      else if     vLength >= 26
     1420              and vLength <= 46
     1421      then do:
     1422         if    substring(iCode,17,2) eq "11"
     1423            or substring(iCode,17,2) eq "13"
     1424            or (    substring(iCode,17,2) eq "21"
     1425                and vLength >= 33
     1426                and substring(iCode,26,4) ne "8005")
     1427         then
     1428            Vlevel = 4.
     1429         else if    vLength eq 31
     1430                 or vLength eq 38
     1431                 or vLength eq 39
     1432                 or vLength eq 45
     1433         then
     1434            Vlevel = 1.
     1435         else if    vLength eq 35
     1436                 or vLength eq 43
     1437         then
     1438            Vlevel = 3.
     1439         else
     1440            Vlevel = ?.
     1441      end.
     1442      else
     1443         Vlevel = ?.
     1444      return Vlevel.
     1445   end.
     1446   function getLevelMotpBycodid return character
     1447   (iDm as char):
     1448      define variable vLevel as integer no-undo.
     1449      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1450      vLevel = getlevelByCodId(iDm).
     1451      if    vLevel eq ?
     1452         or vLevel < 1
     1453         or vLevel > 6
     1454      then
     1455         return ?.
     1456      else
     1457         return entry(vlevel,vList).
     1458   end.
     1459   function getLevelUTDByLevelMotp return character
     1460   (iUnit as char):
     1461      define variable vLevel as integer no-undo.
     1462      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1463      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1464      vLevel = lookup(iUnit,vListMOTP).
     1465      if    vLevel eq ?
     1466         or vLevel < 1
     1467         or vLevel > 4
     1468      then
     1469         return ?.
     1470      else
     1471         return entry(vlevel,vListutd).
     1472   end.
     1473   function getLevelMotpByDM return character
     1474   (iDm as char):
     1475      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1476   end.
     1477   function getLevelUTDByCodId return character
     1478   (iDm as char):
     1479      define variable vLevel as integer no-undo.
     1480      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1481      vLevel = getlevelByCodId(iDm).
     1482      if    vLevel eq ?
     1483         or vLevel < 1
     1484         or vLevel > 4
     1485      then
     1486         return ?.
     1487      else
     1488         return entry(vlevel,vList).
     1489   end.
     1490   function getLevelUTDByDM return character
     1491   (iDm as char):
     1492      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1493   end.
     1494   define variable mNotMarkQnty as logical no-undo.
     1495   function getQntyUTDByCodId return decimal
     1496   (iDM as char):
     1497      define variable vLevel as integer no-undo.
     1498      define variable vList as character no-undo init "1,5,10,500".
     1499      define variable vGtin as character no-undo.
     1500      define variable vqnty as decimal no-undo init ?.
     1501      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1502      if vqnty eq ?
     1503      then do:
     1504         if not mNotMarkQnty
     1505         then do:
     1506            define buffer marking for ub.marking.
     1507            define variable vCodident as character no-undo.
     1508            vCodident = GetCodeIdent(idm).
     1509            find first marking where marking.mark begins vCodident no-lock no-error.
     1510            if     available marking
     1511               and marking.box-qnty ne ?
     1512            then
     1513               return marking.box-qnty.
     1514         end.
     1515         vGtin = getGtinByDm(iDM).
     1516         if ChekTypeMarkByGtin (vGtin)
     1517         then do:
     1518            vLevel = getlevelByCodId(iDM).
     1519            if     vLevel >= 1
     1520               and vLevel <= 4
     1521            then
     1522               vqnty = int(entry(vlevel,vList)).
     1523         end.
     1524         else
     1525            vqnty = getQntyCodeByGtin(vgtin).
     1526      end.
     1527      return vqnty.
     1528   end.
     1529   function getQntyUTDByDM return decimal
     1530   (iDm as char):
     1531      define variable vDM as character no-undo.
     1532      if     length (iDm) ne 25
     1533         and length (iDm) ne 29
     1534         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1535      then
     1536         vDM = substring (iDm,1,length (iDm) - 6 ).
     1537      else
     1538         vDM = substring (iDm,1,length (iDm) - 4 ).
     1539      return getQntyUTDByCodId(vDM).
     1540   end.
     1541   function getMRC4 return decimal
     1542   (iMRC as char):
     1543      define variable oMrc     as decimal no-undo init ?.
     1544      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1545      define variable vi       as integer no-undo.
     1546      define variable vfound   as integer no-undo.
     1547      define variable vposStart   as integer no-undo.
     1548      do:
     1549      OMRc = 0.
     1550      do vi = 1 to 4:
     1551         define variable vsimb as character no-undo.
     1552         vsimb = substring(iMRC,vi,1).
     1553         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1554         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1555         if vfound > 0
     1556         then
     1557            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1558         end.
     1559         OMRc = OMRc / 100.
     1560      end.
     1561      return OMRc.
     1562   end.
     1563   function getMRCByDM return decimal
     1564   (iDm as char):
     1565      define variable vMRC     as character no-undo.
     1566      define variable oMrc     as decimal no-undo init ?.
     1567      define variable Velement as character no-undo init "empty".
     1568      define variable vteg as character no-undo.
     1569      define variable vtegval as character no-undo.
     1570      if    length(idm) eq 14 + 7 + 4 + 4
     1571         or length(idm) eq 14 + 7 + 4
     1572      then do:
     1573         vMRC = substring(idm,22,4).
     1574         omrc = getMRC4(vMRC).
     1575      end.
     1576      else do:
     1577          ChekTypeMarkByDm(iDm).
     1578          block-mrc:
     1579          do while Velement ne "" and idm ne "":
     1580             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1581             if Velement begins "8005"
     1582             then do:
     1583                vMRC = substring(Velement,5,6).
     1584                leave block-mrc.
     1585             end.
     1586             else if Velement begins "(8005)"
     1587             then do:
     1588                vMRC = substring(Velement,7,6).
     1589                leave block-mrc.
     1590             end.
     1591          end.
     1592          if vMRC ne ""
     1593          then
     1594             OMRc = dec(vmrc) / 100 no-error.
     1595      end.
     1596      return OMRc.
     1597   end.
     1598   function MoveDate return Date
     1599   (idate as date,
     1600    iMonth as int64):
     1601      define variable vMonth   as int64 no-undo.
     1602      define variable vYear    as int64 no-undo.
     1603      define variable vDateNew as date  no-undo.
     1604       define variable vDay     as int64 no-undo.
     1605       vMonth = month(iDate) + iMonth.
     1606       vYear =  year(iDate).
     1607       if vMonth <= 0
     1608       then assign
     1609          vMonth = vMonth + 12
     1610           vYear  = vYear - 1
     1611       .
     1612       else if vMonth > 12
     1613       then assign
     1614          vMonth = vMonth - 12
     1615           vYear  = vYear + 1
     1616       .
     1617       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1618       do while error-status:error eq yes:
     1619          VDay = vDay + 1.
     1620          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1621       end.
     1622       if VDay > 0
     1623       then
     1624          vDateNew + 1.
     1625       return vDateNew.
     1626   end.
     1627   procedure checkEMRC:
     1628   define input  parameter iDm as character no-undo.
     1629   define output parameter vok as logical   no-undo init yes.
     1630      define variable v-value-emrc as character no-undo.
     1631      define variable v-type-emrc  as character no-undo.
     1632      define variable vDateIso     as character no-undo.
     1633      define variable vMRC         as decimal no-undo.
     1634      define variable vqnty        as decimal no-undo.
     1635      define variable vPrice       as decimal no-undo.
     1636      define variable vparent      as character no-undo.
     1637      define variable vgds-code    as integer no-undo.
     1638      define buffer code for ub.code.
     1639      vMRC = getMRCByDM(iDm).
     1640      if vMRC > 0
     1641      then do:
     1642         vgds-code = getGdsCodeByDM(iDm).
     1643         vqnty     = getQntyUTDByDM(iDm).
     1644               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1645            (
     1646             input   vgds-code
     1647            ,input   'emrc-type':U
     1648            ,output   v-value-emrc
     1649            ,output   v-type-emrc
     1650          ) no-error.
     1651          if     v-value-emrc ne ""
     1652             and v-value-emrc ne ?
     1653          then do:
     1654             vDateIso = iso-date(today).
     1655             vPrice = vMRC / vqnty.
     1656             vparent ="emc" + chr(4) + v-value-emrc.
     1657             find last code where Code.parent      eq vparent
     1658                              and Code.code        le vDateIso
     1659                              and code.status_  eq 0
     1660             no-lock no-error.
     1661             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1662             then
     1663                vOk = true .
     1664             else do:
     1665                 define variable vText      as character no-undo.
     1666                 define variable vDate      as date no-undo.
     1667                 define variable vDateLast  as character no-undo.
     1668                 define variable vDateFirst as character no-undo.
     1669                 define variable vDate3     as date no-undo.
     1670                 vdate = date(code.misc1).
     1671                 vDateLast = code.misc1.
     1672                 vDate3 = MoveDate(today, - 3 ).
     1673                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1674                                      string(vDate3  , "99/99/9999"),
     1675                                      string(vDate   , "99/99/9999")
     1676                                      ).
     1677                 vdateIso = iso-date(vdate3).
     1678                 find last code  where Code.parent      eq vparent
     1679                                   and Code.code        le vDateIso
     1680                                   and code.status_  eq 0 no-lock no-error.
     1681                 if available code
     1682                 then
     1683                    vDateIso = code.code.
     1684                 vDateFirst = vDateIso.
     1685                 vDateLast = iso-date(vdate).
     1686                 define variable vGood as logical no-undo.
     1687                 define variable vDateSale as date no-undo.
     1688                 define buffer bcode for code.
     1689                 for last code where Code.parent   eq vparent
     1690                                 and code.status_  eq 0
     1691                                 and code.code     < vDateLast
     1692                                 and code.code     >= vDateFirst
     1693                 no-lock:
     1694                    find first bcode where bCode.parent   eq vparent
     1695                                       and bcode.status_  eq 0
     1696                                       and bcode.code     > code.code no-lock no-error.
     1697                    if available bcode
     1698                    then do:
     1699                       if vPrice < dec(Code.CodeValue)
     1700                       then
     1701                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1702                                                     chr(10),
     1703                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1704                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1705                                                     ).
     1706                       else do:
     1707                          vGood = yes.
     1708                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1709                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1710                                                     chr(10),
     1711                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1712                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1713                                                     string(         vDateSale            ,"99/99/9999"),
     1714                                                     string(vDateSale - today)
     1715                                                     ).
     1716                       end.
     1717                    end.
     1718                 end.
     1719                 if vgood
     1720                 then do:
     1721                    define variable choice as integer no-undo .
     1722                    run gbl/d-askw.w (input "Уточнение"
     1723                           ,input  vText
     1724                           ,input "|"
     1725                           ,input "Принять|Вернуть"
     1726                           ,input "Принять данный товар|Вернуть товар постащику"
     1727                           ,input 1
     1728                           ,input 2
     1729                           ,output choice) no-error.
     1730                    vok = choice eq 1.
     1731                 end.
     1732                 else
     1733                    vok =false.
     1734             end.
     1735          end.
     1736      end.
     1737   end.
     1738   function addGs2Mark return character
     1739   (iMark as char):
     1740      define variable vDM   as character no-undo.
     1741      define variable vIdx  as integer   no-undo.
     1742      if index(iMark,chr(29),1) > 0
     1743      then return iMark.
     1744      if substring(iMark,26,4) = "8005" then
     1745      do:
     1746        vIdx = index(iMark,"93",26 + 4 + 5).
     1747        if vIdx > 1 then do:
     1748          vDM = substitute("&1&4&2&4&3",
     1749                           substring(iMark,1,25),
     1750                           substring(iMark,26,vIdx - 25 - 1),
     1751                           substring(iMark,vIdx),
     1752                           chr(29)) no-error.
     1753          vIdx = index(vDm,"240",vIdx + 4).
     1754          if vIdx > 0 then
     1755          do:
     1756            vDM = substitute("&1&3&2",
     1757                             substring(vDm,1,vIdx - 1),
     1758                             substring(vDm,vIdx),
     1759                             chr(29)) no-error.
     1760          end.
     1761        end.
     1762        else
     1763          vDM = substitute("&1&3&2",
     1764                           substring(iMark,1,25),
     1765                           substring(iMark,26),
     1766                           chr(29)) no-error.
     1767      end.
     1768      else if substring(iMark,32,2) = "91" then
     1769      do:
     1770        vIdx = index(iMark,"92",32).
     1771        if vIdx > 1 then
     1772          vDM = substitute("&1&4&2&4&3",
     1773                           substring(iMark,1,31),
     1774                           substring(iMark,32,vIdx - 31 - 1),
     1775                           substring(iMark,vIdx),
     1776                           chr(29)) no-error.
     1777        else
     1778          vDM = substitute("&1&3&2",
     1779                           substring(iMark,1,31),
     1780                           substring(iMark,32),
     1781                           chr(29)) no-error.
     1782      end.
     1783      else if substring(iMark,39,2) = "91" then
     1784      do:
     1785        vIdx = index(iMark,"92",38).
     1786        if vIdx > 1 then
     1787          vDM = substitute("&1&4&2&4&3",
     1788                           substring(iMark,1,38),
     1789                           substring(iMark,39,vIdx - 38 - 1),
     1790                           substring(iMark,vIdx),
     1791                           chr(29)) no-error.
     1792        else
     1793          vDM = substitute("&1&3&2",
     1794                           substring(iMark,1,38),
     1795                           substring(iMark,39),
     1796                           chr(29)) no-error.
     1797      end.
     1798      else if substring(iMark,25,2) = "93" then
     1799      do:
     1800        vIdx = index(iMark,"92",25).
     1801        if vIdx > 1 then
     1802          vDM = substitute("&1&4&2&4&3",
     1803                           substring(iMark,1,24),
     1804                           substring(iMark,25,vIdx - 24 - 1),
     1805                           substring(iMark,vIdx),
     1806                           chr(29)) no-error.
     1807        else
     1808          vIdx = index(iMark,"3103",25).
     1809          if vIdx > 0 then
     1810          vDM = substitute("&1&4&2&4&3",
     1811                           substring(iMark,1,24),
     1812                           substring(iMark,25,vIdx - 24 - 1),
     1813                           substring(iMark,vIdx),
     1814                           chr(29)) no-error.
     1815          else
     1816            vDM = substitute("&1&3&2",
     1817                             substring(iMark,1,24),
     1818                             substring(iMark,25),
     1819                             chr(29)) no-error.
     1820      end.
     1821      else if substring(iMark,32,2) = "93" then
     1822      do:
     1823        vDM = substitute("&1&3&2",
     1824              substring(iMark,1,31),
     1825              substring(iMark,32),
     1826              chr(29)) no-error.
     1827      end.
     1828      return if vDM <> "" then vDm else iMark.
     1829   end.
     1830   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1831   define variable v-waitfram-action01         as character   no-undo .
     1832   define variable v-waitfram-action02         as character   no-undo .
     1833   define variable v-waitfram-action03         as character   no-undo .
     1834   define variable mWaitFramTextBeg            as character   no-undo.
     1835   define variable mWaitFramTextEnd            as character   no-undo.
     1836   define variable mWaitFramView               as logical     no-undo.
     1837   define variable mWaitProcEvent              as logical     no-undo init yes.
     1838   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1839   define variable mWaitFramStop               as logical     no-undo.
     1840   define variable mWaitFramStopUser           as logical     no-undo.
     1841   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1842   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1843   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1844   define button B-WaitFramStop auto-end-key
     1845        label "Стоп"
     1846        size 10 by 1 tooltip "Остоновить процесс".
     1847   define button B-viewProcInfo
     1848        label "Информация"
     1849        size 15 by 1 tooltip "Информация о процесс".
     1850   define frame waitfram
     1851     v-waitfram-action01 format "x(72)" no-label skip
     1852     v-waitfram-action02 format "x(72)" no-label skip
     1853     v-waitfram-action03 format "x(72)" no-label skip
     1854     B-viewProcInfo
     1855     B-WaitFramStop at row 4 col 30
     1856     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1857     .
     1858   define new global shared variable mBatchMode as logical no-undo init ?.
     1859   define variable mFramBachModHandle as handle no-undo.
     1860   mFramBachModHandle = frame waitfram:handle.
     1861   define variable mFameOldVis as logical no-undo.
     1862   define variable mVisCUrentVin as logical no-undo.
     1863   if session:batch-mode
     1864   then
     1865      mBatchMode = yes.
     1866   if mBatchMode = ? then do:
     1867     mVisCUrentVin = current-window:visible.
     1868     mFameOldVis = mFramBachModHandle:visible.
     1869     mFramBachModHandle:visible  = yes.
     1870     mBatchMode = mFramBachModHandle:visible ne yes.
     1871     mFramBachModHandle:visible = mFameOldVis.
     1872     current-window:visible = mVisCUrentVin.
     1873   end.
     1874    if  log-manager:logfile-name ne ?
     1875     then DO:
     1876         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1877         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1878         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1879     end.
     1880   on choose of B-WaitFramStop in frame waitfram
     1881   do:
     1882     mWaitFramStop = yes.
     1883     mWaitFramStopUser = yes.
     1884   end.
     1885   function waitfram-check-timeout returns logical():
     1886      define variable vtime as int64 no-undo.
     1887      if mWaitFramStopTimeOut
     1888      then
     1889         return yes.
     1890      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1891      if     mWaitFramTimeOut ne ?
     1892         and mWaitFramTimeOut ne 0
     1893         and mWaitFramTimeOut lt vtime
     1894      then do:
     1895         mWaitFramStopTimeOut = yes.
     1896      end.
     1897      return mWaitFramStopTimeOut.
     1898   end.
     1899   procedure waitfram-hide :
     1900     if not session:batch-mode
     1901     then do
     1902     on error undo, return error return-value
     1903     :
     1904       pause 0 before-hide .
     1905       if not mBatchMode then
     1906         hide frame waitfram .
     1907     end.
     1908   end procedure.
     1909   procedure waitfram-show :
     1910     define input  parameter p-message as character no-undo .
     1911     define variable v-left-margin as integer   no-undo .
     1912     if not session:batch-mode
     1913     then do
     1914     on error undo, return error return-value
     1915     :
     1916       if length(p-message) <= 70 then do:
     1917         assign
     1918           v-left-margin = integer((70 - length(p-message)) / 2)
     1919         .
     1920         assign
     1921           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1922         .
     1923         assign
     1924           v-waitfram-action01 = " "
     1925           v-waitfram-action02 = " "
     1926                                    + fill(" ", v-left-margin)
     1927                                    + p-message
     1928           v-waitfram-action03 = " "
     1929         .
     1930       end.
     1931       else do:
     1932         define variable vRindex1 as integer no-undo.
     1933         define variable vRindex2 as integer no-undo.
     1934         vRindex1 = r-index(p-message," ",70).
     1935         if vRindex1 = 0
     1936         then
     1937            vRindex1 = 70.
     1938         if length(p-message)  <= vRindex1 + 70 then do:
     1939           assign
     1940             v-waitfram-action01 = " "
     1941             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1942             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1943           .
     1944         end.
     1945         else do:
     1946           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1947           if vRindex2 <= vRindex1
     1948           then
     1949              vRindex2 = vRindex1 + 70.
     1950           assign
     1951             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1952             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1953             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1954           .
     1955         end.
     1956       end.
     1957       B-viewProcInfo:visible   in frame waitfram = no.
     1958       B-viewProcInfo:sensitive in frame waitfram = no.
     1959       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1960       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1961       if  (   mWaitFramView
     1962          or  mWaitProcEvent)
     1963          and not mBatchMode
     1964       then
     1965          display
     1966             v-waitfram-action01 skip
     1967             v-waitfram-action02 skip
     1968             v-waitfram-action03 skip
     1969          with frame waitfram .
     1970     end.
     1971   end procedure.
     1972      procedure waitfram-show-this:
     1973         define input  parameter iInterval as int64 no-undo.
     1974         define variable vtime as int64 no-undo.
     1975         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1976         mWaitFramInterval = iInterval.
     1977         run waitfram-show (substitute("&1&2 &3&4" ,
     1978                                       mWaitFramTextBeg ,
     1979                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1980                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1981                                       mWaitFramTextEnd
     1982                                      )
     1983                           ).
     1984      end.
     1985      procedure WaitFramRunPause:
     1986         define input  parameter iInterval as dec no-undo.
     1987         define variable vStart  as datetime-tz no-undo.
     1988         define variable vend    as datetime-tz no-undo.
     1989         define variable vint as int64 no-undo.
     1990         define variable vOk as logical no-undo.
     1991         vStart = now.
     1992         vend   = vStart.
     1993         publish "WaitFramPause" (iInterval,output vOk).
     1994         vend   =  now.
     1995         vint = vend - vStart.
     1996         vint = iInterval - vint / 1000.
     1997         if     not mWaitFramStop
     1998            and (   vint > 0
     1999                 or (    not vOk
     2000                     and iInterval eq ?
     2001                     )
     2002                 )
     2003         then
     2004            run waitfram-show-this (iInterval).
     2005         vend   =  now.
     2006         vint = vend - vStart.
     2007         vint = iInterval - vint / 1000.
     2008         if     not mWaitFramStop
     2009            and vint > 0
     2010         then do:
     2011            run gbl/pause.p (vint * 1000).
     2012         end.
     2013         if iInterval ne ?
     2014         then
     2015            publish "WaitFramStop".
     2016         waitfram-check-timeout().
     2017      end.
     2018      procedure WaitFramWaitFor:
     2019         define input  parameter iInterval as dec no-undo.
     2020         assign
     2021            mWaitFramStartProc   = now
     2022            mWaitFramStopUser    = no
     2023            mWaitFramStopTimeOut = no
     2024         .
     2025         block-wait:
     2026         do while not mWaitFramStop:
     2027            run WaitFramRunPause (iInterval).
     2028            if  waitfram-check-timeout()
     2029            then do:
     2030               leave block-wait.
     2031            end.
     2032         end.
     2033         run waitfram-hide.
     2034      end.
     2035   procedure waitfram-join :
     2036     define input  parameter p-line-1  as character no-undo .
     2037     define input  parameter p-line-2  as character no-undo .
     2038     define input  parameter p-line-3  as character no-undo .
     2039     define output parameter p-message as character no-undo .
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       assign
     2044         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2045                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2046                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2047       .
     2048     end.
     2049   end procedure.
     2050   function waitfram-join-function returns character
     2051     (input p-line-1 as character
     2052     ,input p-line-2 as character
     2053     ,input p-line-3 as character
     2054     ).
     2055     define variable v-message as character no-undo .
     2056     run waitfram-join in this-procedure
     2057       (input  p-line-1
     2058       ,input  p-line-2
     2059       ,input  p-line-3
     2060       ,output v-message
     2061       ) .
     2062     return v-message .
     2063   end function .
     2064   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2065     define variable v-cntxt-db-num        as integer   no-undo .
     2066     define variable v-cntxt-userid        as character no-undo .
     2067     define variable v-cntxt-level         as character no-undo .
     2068     define variable v-cntxt-host-code-obj as integer   no-undo .
     2069     define variable v-cntxt-obj-type      as character no-undo .
     2070     define variable v-cntxt-obj-code      as integer   no-undo .
     2071     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2072     define variable v-cntxt-is-admin      as logical   no-undo .
     2073   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2074   function getattrUtdex returns char
     2075   (idb-num   as integer,
     2076    idoc-id   as integer,
     2077    iattrcode as character,
     2078    iExValue  as character  ):
     2079      define buffer utd-attr for utd-attr.
     2080      find first utd-attr where utd-attr.db-num eq idb-num
     2081                            and utd-attr.doc-id eq idoc-id
     2082                            and utd-attr.attr-code eq iattrcode
     2083      no-lock no-error.
     2084      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2085   end.
     2086   function getattrUtd returns char
     2087   (idb-num   as integer,
     2088    idoc-id   as integer,
     2089    iattrcode as character ):
     2090     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2091   end.
     2092   function setattrUtd returns logical
     2093   (idb-num   as integer,
     2094    idoc-id   as integer,
     2095    iattrcode as character,
     2096    iattrval  as character ):
     2097      define buffer utd-attr for utd-attr.
     2098      find first utd-attr where utd-attr.db-num eq idb-num
     2099                            and utd-attr.doc-id eq idoc-id
     2100                            and utd-attr.attr-code eq iattrcode
     2101      no-lock no-error.
     2102      if not available utd-attr
     2103      then do:
     2104         create utd-attr.
     2105         assign
     2106            utd-attr.db-num    = idb-num
     2107            utd-attr.doc-id    = idoc-id
     2108            utd-attr.attr-code = iattrcode
     2109            utd-attr.attr-value = iattrval
     2110         .
     2111      end.
     2112      else do:
     2113         if utd-attr.attr-value ne iattrval
     2114         then do:
     2115            find current utd-attr exclusive-lock no-error.
     2116            if available utd-attr
     2117            then
     2118               utd-attr.attr-value = iattrval.
     2119         end.
     2120      end.
     2121      release utd-attr.
     2122   end.
     2123   function GetAttrUtdlinesEx returns char
     2124   (idb-num   as integer,
     2125    idoc-id   as integer,
     2126    ilinenum  as integer,
     2127    iattrcode as character,
     2128    iExValue  as character  ):
     2129      define buffer utd-lines-attr for utd-lines-attr.
     2130      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2131                                  and utd-lines-attr.doc-id    eq idoc-id
     2132                                  and utd-lines-attr.lineNum   eq ilineNum
     2133                                  and utd-lines-attr.attr-code eq iattrcode
     2134      no-lock no-error.
     2135      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2136   end.
     2137   function GetAttrUtdlines returns char
     2138   (idb-num   as integer,
     2139    idoc-id   as integer,
     2140    ilinenum  as integer,
     2141    iattrcode as character ):
     2142      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2143   end.
     2144   function setattrUtdlines returns logical
     2145   (idb-num   as integer,
     2146    idoc-id   as integer,
     2147    ilinenum  as integer,
     2148    iattrcode as character,
     2149    iattrval  as character ):
     2150      define buffer utd-lines-attr for utd-lines-attr.
     2151      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2152                                  and utd-lines-attr.doc-id    eq idoc-id
     2153                                  and utd-lines-attr.lineNum   eq ilineNum
     2154                                  and utd-lines-attr.attr-code eq iattrcode
     2155      no-lock no-error.
     2156      if not available utd-lines-attr
     2157      then do:
     2158         if iattrval ne ?
     2159            and iattrval ne ""
     2160         then do:
     2161            create utd-lines-attr.
     2162            assign
     2163               utd-lines-attr.db-num    = idb-num
     2164               utd-lines-attr.doc-id    = idoc-id
     2165               utd-lines-attr.lineNum   = ilineNum
     2166               utd-lines-attr.attr-code = iattrcode
     2167               utd-lines-attr.attr-value = iattrval
     2168            .
     2169         end.
     2170      end.
     2171      else do:
     2172         if utd-lines-attr.attr-value ne iattrval
     2173         then do:
     2174            find current utd-lines-attr exclusive-lock no-error.
     2175            if available utd-lines-attr
     2176            then do:
     2177               if    iattrval eq ?
     2178                  or iattrval eq ""
     2179               then do:
     2180                  delete utd-lines-attr.
     2181               end.
     2182               else do:
     2183                  utd-lines-attr.attr-value = iattrval.
     2184               end.
     2185            end.
     2186         end.
     2187      end.
     2188      release utd-lines-attr.
     2189   end.
     2190   function GetAttrUtdMarkingLinesEx returns char
     2191   (idb-num   as integer,
     2192    idoc-id   as integer,
     2193    ilinenum  as integer,
     2194    imark     as character,
     2195    iattrcode as character,
     2196    iExValue  as character  ):
