       91   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure cur-time :
       93      define output parameter p-today as date      no-undo .
       94      define output parameter p-time  as integer   no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       define variable v-date1 as date      no-undo .
       99       define variable v-date2 as date      no-undo .
      100       define variable v-time  as integer   no-undo .
      101       assign
      102         v-date1 = today
      103         v-time  = time
      104         v-date2 = today
      105       .
      106       if v-date1 <> v-date2
      107       then do:
      108         assign
      109           v-date1 = today
      110           v-time  = v-time
      111         .
      112       end.
      113       assign
      114         p-today = v-date1
      115         p-time  = v-time
      116       .
      117     end.
      118   end.
      119   function cur-time-date returns character
      120   :
      121     return string(today, '99/99/9999':U) .
      122   end.
      123   function cur-time-mjd returns decimal
      124   :
      125     define variable v-date as date      no-undo .
      126     define variable v-time as integer   no-undo .
      127     run cur-time in this-procedure
      128       (output v-date
      129       ,output v-time
      130       ) .
      131     return integer(v-date) - 2400002 + (v-time / 86400) .
      132   end.
      133   function cur-time-get-ending-index returns integer
      134   (input p-number as integer
      135   )
      136   :
      137     if p-number < 0
      138     or p-number = ?
      139     then do:
      140       return 1 .
      141     end.
      142     define variable v-rest as integer   no-undo .
      143     assign
      144       p-number = p-number modulo 100
      145     .
      146     if p-number < 20
      147     then do:
      148       assign
      149         v-rest = p-number
      150       .
      151     end.
      152     else do:
      153       assign
      154         v-rest = p-number modulo 10
      155       .
      156     end.
      157     case v-rest :
      158       when 1
      159       then do:
      160         return 2 .
      161       end.
      162       when 2 or
      163       when 3 or
      164       when 4
      165       then do:
      166         return 3 .
      167       end.
      168       otherwise do:
      169         return 1 .
      170       end.
      171     end case .
      172   end.
      173   procedure cur-time-mjd-to-date :
      174      define input  parameter i-mjd-diff as decimal no-undo.
      175      define output parameter o-Date     as date    no-undo.
      176      define output parameter o-Time     as integer no-undo.
      177      define variable v-day-number as integer   no-undo .
      178      if    i-mjd-diff < 0
      179         or i-mjd-diff = ?
      180      then do:
      181         return "?" .
      182      end.
      183      assign
      184         v-day-number = truncate(i-mjd-diff,0).
      185         o-Date = date(v-day-number + 2400002).
      186         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188   end.
      189   function cur-time-mjd-to-string returns character
      190   (input p-mjd-diff as decimal
      191   )
      192   :
      193     define variable v-day-number as integer   no-undo .
      194     define variable v-seconds    as integer   no-undo .
      195     define variable v-hour       as integer   no-undo .
      196     define variable v-min        as integer   no-undo .
      197     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      198     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      199     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      200     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      201     if p-mjd-diff < 0
      202     or p-mjd-diff = ?
      203     then do:
      204       return "?" .
      205     end.
      206     assign
      207       v-day-number = integer(truncate(p-mjd-diff,0))
      208       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210     if v-seconds > 86400
      211     then do:
      212       assign
      213         v-seconds = 86400 - 1
      214       .
      215     end.
      216     if v-seconds < 0
      217     then do:
      218       assign
      219         v-seconds = 0
      220       .
      221     end.
      222     assign
      223       v-hour = truncate(v-seconds / 3600, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 3600
      227     .
      228     assign
      229       v-min = truncate(v-seconds / 60, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 60
      233     .
      234     return
      235         (if v-day-number <> 0
      236           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0
      240           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      244           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      245           else ""
      246         )
      247       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      248       .
      249   end.
      250   function cur-time-string returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      259   end.
      260   function cur-time-string-sec returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      269   end.
      270   function cur-time-custom  returns character
      271   (input p-prefix as character
      272   ,input p-date-format as character
      273   ,input p-delimiter as character
      274   ,input p-time-format as character
      275   ,input p-suffix as character
      276   )
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return
      285       p-prefix
      286       + string(v-date, p-date-format)
      287       + p-delimiter
      288       + string(v-time, p-time-format)
      289       + p-suffix
      290       .
      291   end.
      292   function cur-time-print  returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-datetime returns datetime
      303   :
      304     define variable v-char as character no-undo .
      305     define variable v-datetime as datetime no-undo .
      306     v-char = cur-time-string().
      307     v-datetime = datetime(v-char).
      308     return  v-datetime.
      309   end.
      310   function cur-time-string-msec returns character
      311   :
      312     define variable v-date as datetime  no-undo .
      313     v-date = now.
      314     return string(v-date) .
      315   end.
      316   define variable vss-include-info2 as character format "X(65)" no-undo
      317   initial "@(#)$Workfile$ $Revision$".
      318   procedure xmlchar-test :
      319   define input parameter p-in-string          as character        no-undo.
      320   define output parameter p-out-string-enc    as character        no-undo.
      321   define output parameter p-out-string-dec    as character        no-undo.
      322   do
      323   on error undo, return error
      324   :
      325          run xmlchar-encode in this-procedure
      326       (
      327             input p-in-string
      328           , output p-out-string-enc
      329       ).
      330          run xmlchar-decode in this-procedure
      331       (
      332             input p-out-string-enc
      333           , output p-out-string-dec
      334       ).
      335   end.
      336   end .
      337   procedure xmlchar-encode :
      338   define input parameter p-in-string      as character        no-undo.
      339   define output parameter p-out-string    as character        no-undo.
      340       define variable v-position      as integer      no-undo.
      341       define variable v-current-char  as character    no-undo.
      342   do
      343   on error undo, return error
      344   :
      345       assign
      346           p-out-string = "":U
      347       .
      348       case p-in-string
      349       :
      350           when ?
      351           then do:
      352               assign
      353                   p-out-string = "?":U
      354               .
      355           end.
      356           when "?":U
      357           then do:
      358               assign
      359                   p-out-string = "&#63;":U
      360               .
      361           end.
      362           otherwise do:
      363               do v-position = 1 to length( p-in-string )
      364               :
      365                   assign
      366                       v-current-char = substring( p-in-string, v-position, 1 )
      367                   .
      368                   case v-current-char
      369                   :
      370                       when "&":U
      371                       then do:
      372                           assign
      373                               p-out-string = p-out-string + "&amp;":U
      374                           .
      375                       end.
      376                       when ">":U
      377                       then do:
      378                           assign
      379                               p-out-string = p-out-string + "&gt;":U
      380                           .
      381                       end.
      382                       when "<":U
      383                       then do:
      384                           assign
      385                               p-out-string = p-out-string + "&lt;":U
      386                           .
      387                       end.
      388                       when "'":U
      389                       then do:
      390                           assign
      391                               p-out-string = p-out-string + "&apos;":U
      392                           .
      393                       end.
      394                       when '"':U
      395                       then do:
      396                           assign
      397                               p-out-string = p-out-string + "&quot;":U
      398                           .
      399                       end.
      400                       when chr(1)
      401                       then do:
      402                           assign
      403                               p-out-string = p-out-string + "":U
      404                           .
      405                       end.
      406                       when chr(2)
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + "":U
      410                           .
      411                       end.
      412                       when chr(3)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + "":U
      416                           .
      417                       end.
      418                       when chr(4)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + "":U
      422                           .
      423                       end.
      424                       when chr(5)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + "":U
      428                           .
      429                       end.
      430                       when chr(6)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "":U
      434                           .
      435                       end.
      436                       when chr(7)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + "":U
      440                           .
      441                       end.
      442                       when chr(8)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + "":U
      446                           .
      447                       end.
      448                       when chr(9)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "":U
      452                           .
      453                       end.
      454                       when chr(29)
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "":U
      458                           .
      459                       end.
      460                       when chr(10)
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "&#10;":U
      464                           .
      465                       end.
      466                       when chr(13)
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "&#13;":U
      470                           .
      471                       end.
      472                       otherwise do:
      473                           assign
      474                               p-out-string = p-out-string + v-current-char
      475                           .
      476                       end.
      477                   end case.
      478               end.
      479           end.
      480       end case.
      481   end.
      482   end .
      483   procedure xmlchar-encode-1c :
      484   define input parameter p-in-string      as character        no-undo.
      485   define output parameter p-out-string    as character        no-undo.
