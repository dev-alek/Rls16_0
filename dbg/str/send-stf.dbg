      533                       end.
      534                       when chr(5)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + " ":U
      538                           .
      539                       end.
      540                       when chr(6)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + " ":U
      544                           .
      545                       end.
      546                       when chr(7)
      547                       then do:
      548                           assign
