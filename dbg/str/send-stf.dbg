     1446   procedure alienini-getkey :
     1447   define input parameter i-filename as char.
     1448   define input parameter i-section as char.
     1449   define input parameter i-key as char.
     1450   define output parameter o-value as char.
     1451   define variable EntryPointer as integer no-undo.
     1452   define variable mem1 as memptr no-undo.
     1453   define variable mem2 as memptr no-undo.
     1454   define variable mem1size as integer no-undo.
     1455   define variable mem2size as integer no-undo.
     1456   define variable ii       as integer    no-undo.
     1457   define variable cbReturnSize  as integer    no-undo.
     1458   assign
     1459   set-size(mem1)  = 4000
     1460   mem1size = 4000.
     1461   if i-key = "" then EntryPointer = 0.
     1462   else do:
     1463     assign
     1464     set-size(mem2) = 128
     1465     mem2size = 128
     1466     EntryPointer = get-pointer-value(mem2)
     1467     put-string(mem2, 1) = i-key.
     1468   end.
     1469   run getprivateprofilestringA
     1470                                 (i-section,
     1471                                  EntryPointer,
     1472                                  "",
     1473                                  get-pointer-value(mem1),
     1474                                  input mem1size,
     1475                                  i-filename,
     1476                                  output cbReturnSize).
     1477   do ii = 1 to cbReturnSize:
     1478     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1479                  then o-value + ","
     1480                  else o-value + chr(get-byte(mem1, ii)).
     1481   end.
     1482     set-size(mem1) = 0.
     1483     set-size(mem2) = 0.
     1484   end procedure.
     1485   procedure alienini-putkey :
     1486   define input parameter i-filename as char.
     1487   define input parameter i-section as char.
     1488   define input parameter i-key as char.
     1489   define input parameter i-value as char.
     1490   define variable cbReturnSize as integer.
     1491   run writeprivateprofilestringA
     1492                                  (i-section,
     1493                                   i-key,
     1494                                   i-value,
     1495                                   i-filename,
     1496                                   output cbReturnSize ).
     1497   end procedure.
     1498   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1499     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1500     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1501     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1502     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1503     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1504     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1505     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1506   END PROCEDURE.
     1507   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1508     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1509     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1510     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1511     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1512     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1513   END PROCEDURE.
