     1266   procedure xml-cd-write-header:
     1267   do
     1268   on error undo, return error
     1269   :
     1270   define input parameter p-xml-file-name       as character    no-undo.
     1271   define input parameter p-xml-file-name-path  as character    no-undo.
     1272   define input parameter p-doc-name            as character    no-undo.
     1273   define input parameter p-version             as character    no-undo.
     1274   define input parameter p-obj-list            as character    no-undo.
     1275   define input parameter p-correspondent       as character    no-undo .
     1276   define input parameter p-write-header        as logical      no-undo .
     1277   define variable OS-time as character no-undo .
     1278   define variable id as character no-undo .
     1279   define buffer buf_db for ub.db.
     1280   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1281   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1282   assign
     1283   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1284   .
     1285   run bgelib-tag-open in this-procedure (
     1286                                        1
     1287                                       ,p-doc-name
     1288                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1289                                         ).
     1290   if p-write-header then do:
     1291     run bgelib-tag-open(2, "Header","").
     1292     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1293     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1294     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1295     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1296     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1297     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1298     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1299     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1300     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1301     run bgelib-tag-close( 2, "Header" ).
     1302   end.
     1303   output stream stmXMLOut close.
     1304   end.
     1305   end procedure.
     1306   procedure xml-cd-write-footer:
     1307   do
     1308   on error undo, return error
     1309   :
     1310   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1311   define input parameter p-xml-file-name as character    no-undo.
     1312   define input parameter p-doc-name      as character    no-undo .
     1313   define variable v-error-num     as integer           no-undo.
     1314   define variable v-md5-signature as character no-undo .
     1315   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1316   run bgelib-tag-close( 0, p-doc-name ).
     1317   put stream stmXMLOut unformatted skip.
     1318   output stream stmXMLOut close.
     1319   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1320   if v-error-num > 0
     1321   then do:
     1322      return error.
     1323   end.
     1324   if opsys = "unix"
     1325   then do:
     1326       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1327   end.
     1328   end.
     1329   end procedure.
     1330   procedure xml-cd-filename :
     1331   do
     1332   on error undo, return error
     1333   :
     1334   define input parameter  p-out               as character no-undo .
     1335   define output parameter p-xml-file-name     as character    no-undo.
     1336   define output parameter p-xml-file-name-path   as character    no-undo.
     1337   define output parameter p-log-file-name     as character    no-undo.
     1338   define output parameter p-locked            as logical      no-undo.
     1339   define variable v-out as character     no-undo.
     1340   define variable loc#log as logical no-undo .
     1341   define variable BadFlag as logical no-undo .
     1342   define variable fq as integer no-undo .
     1343   define variable v-remote as character no-undo .
     1344   assign
     1345   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1346   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1347   p-log-file-name = p-out + "actions.log"
     1348   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1349   .
     1350   end.
     1351   end procedure.
     1352   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1353   define variable v-date-str as character no-undo .
     1354   assign
     1355   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1356                string(Month(p-date), "99":U) + "-":U +
     1357                string(DAY(p-date), "99":U).
     1358   return v-date-str.
     1359   END FUNCTION.
     1360   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1361   define variable v-date-str as character no-undo .
     1362   assign
     1363   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1364                string(Month(p-date), "99":U) + "-":U +
     1365                string(DAY(p-date), "99":U) + chr(32) +
     1366                string(p-time, "HH:MM:SS").
     1367   return v-date-str.
     1368   END FUNCTION.
     1369   function string-to-date returns date ( input p-string  as character):
     1370     define variable v-date as date no-undo .
     1371     assign
     1372     v-date = date(integer(substring(p-string, 4, 2))
     1373                   ,integer(substring(p-string, 1, 2))
     1374                   ,integer(substring(p-string, 7, 4))
     1375                  ) no-error .
     1376     if error-status:error then return ?.
     1377     return v-date.
     1378   END FUNCTION.
     1379   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1380   define variable v-time as integer no-undo init ?.
     1381   define variable v-dop1 as character no-undo .
     1382   define variable v-dop2 as character no-undo .
     1383   assign
     1384   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1385   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1386   no-error .
     1387   if error-status:error then return ?.
     1388   assign
     1389   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1390             integer(entry(2, v-dop2, ";":U)) * 60 +
     1391             integer(entry(3, v-dop2, ";":U)) no-error .
     1392   return v-time.
     1393   END FUNCTION.
