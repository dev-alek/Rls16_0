     1573   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1574   define variable v-is-closed-shift-journal as integer no-undo .
     1575   assign
     1576   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1577                               +
     1578                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1579                               +
     1580                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1581   .
     1582   return v-is-closed-shift-journal.
     1583   END FUNCTION.
     1584   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1585   define variable v-is-first-journal as logical no-undo .
     1586   assign
     1587   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1588                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1589                     or (p-journal-num =  integer(entry(1, '17':U)))
     1590                     or (p-journal-num = integer(entry(1, '16':U)))
     1591   .
     1592   return v-is-first-journal.
     1593   END FUNCTION.
     1594   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1595   define variable v-is-petrol-journal as logical no-undo .
     1596   assign
     1597   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1598   return v-is-petrol-journal.
     1599   END FUNCTION.
     1600   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1601   define variable v-max-record-num as integer no-undo .
     1602   assign
     1603   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1604                       then 1489
     1605                       else 2340).
     1606   return v-max-record-num.
     1607   END FUNCTION.
     1608   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1609   define variable v-max-record-num as integer no-undo .
     1610   assign
     1611   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1612                       then 1489 * num-entries('30,31,32,33':U)
     1613                       else 2340 * num-entries('17':U)).
     1614   return v-max-record-num.
     1615   END FUNCTION.
     1616   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1617                                           ,input p-rec-no as integer):
     1618   define variable v-num-recs as integer no-undo .
     1619   if tekka-is-petrol-journal (p-journal-num) then do:
     1620     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1621       assign
     1622       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1623       .
     1624     end.
     1625     else do:
     1626       assign
     1627       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1628       .
     1629     end.
     1630   end.
     1631   else do:
     1632     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1633       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1634         assign
     1635         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1636         .
     1637       end.
     1638       else do:
     1639         assign
     1640         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1641         .
     1642       end.
     1643     end.
     1644     else do:
     1645       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1646         assign
     1647         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1648         .
     1649       end.
     1650       else do:
     1651         assign
     1652         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1653         .
     1654       end.
     1655     end.
     1656   end.
     1657   return v-num-recs.
     1658   END FUNCTION.
     1659   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1660                                              ,input p-is-petrol as logical
     1661                                              ,input p-is-current as logical
     1662                                              ,output p-rec-no as decimal
     1663                                              ):
     1664   define variable v-obj-num0 as integer no-undo .
     1665   define variable v-obj-num as integer no-undo .
     1666   define variable v-obj-num2 as integer no-undo .
     1667   define variable p-num-recs2 as integer no-undo .
     1668   define variable p-rec-no2 as integer no-undo .
     1669   if p-is-petrol then do:
     1670     assign
     1671     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1672     .
     1673     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1674     then
     1675     assign
     1676     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1677     p-rec-no = p-num-recs modulo 1489
     1678     .
     1679     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1680     then
     1681     assign
     1682     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1683     p-rec-no = p-num-recs modulo 1489
     1684     .
     1685   end.
     1686   else do:
     1687     assign
     1688     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1689     p-num-recs = trunc(p-num-recs, 0)
     1690     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1691     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1692     .
     1693     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1694     then
     1695     assign
     1696     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1697     p-rec-no = p-num-recs modulo 2340
     1698     .
     1699     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1700     then
     1701     assign
     1702     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1703     p-rec-no = p-num-recs modulo 2340
     1704     .
     1705     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1706     then
     1707     assign
     1708     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1709     p-rec-no2 = p-num-recs2 modulo 2978
     1710     .
     1711     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1712     then
     1713     assign
     1714     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1715     p-rec-no2 = p-num-recs2 modulo 2978
     1716     .
     1717     assign
     1718     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1719     .
     1720   end.
     1721   if v-obj-num = 0 then v-obj-num = 100.
     1722   return v-obj-num.
     1723   END FUNCTION.
     1724   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1725   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1726   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1727      if p-is-ptrl then
     1728      return integer(entry(1, '26,27,28,29':U)).
     1729      if not p-is-ptrl then
     1730      return integer(entry(1, '16':U)).
     1731   end.
     1732   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1733   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1734   return 0.
     1735   END FUNCTION.
     1736   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1737   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1738   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1739     if p-is-ptrl then
     1740     return integer(entry(1, '26,27,28,29':U)).
     1741     if not p-is-ptrl then
     1742     return integer(entry(1, '16':U)).
     1743   end.
     1744   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1745   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1746   return 0.
     1747   END FUNCTION.
     1748   PROCEDURE maria-put:
     1749   define parameter buffer buf_cash-desk for ub.cash-desk.
     1750   define input parameter p-out    as character no-undo .
     1751   define input parameter p-fname as character no-undo .
     1752   define input parameter p-by-record as logical no-undo .
     1753   define input parameter p-shift-fields as integer no-undo .
     1754   define input parameter p-binary as logical no-undo .
     1755   define input parameter p-obj-num as integer no-undo .
     1756   define input parameter p-max-records as integer no-undo .
     1757   define input parameter p-plu as integer no-undo .
     1758   define input parameter p-value as character no-undo .
     1759   define variable v-file-name as character no-undo .
     1760   define variable v-create as logical no-undo .
     1761   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1762   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1763   output stream IBMSTREAM
     1764   to value(v-file-name) append .
     1765   Put  stream IBMSTREAM unformatted
     1766   p-plu
     1767   chr(3)
     1768   p-value
     1769   skip.
     1770   output stream IBMSTREAM
     1771   close.
     1772   if not p-by-record then do:
     1773     find first buf_temp-tekka-tsk where
     1774               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1775     if not available buf_temp-tekka-tsk then do:
     1776       v-create = yes.
     1777     end.
     1778   end.
     1779   else do:
     1780     find first buf_temp-tekka-tsk where
     1781               buf_temp-tekka-tsk.filename  = v-file-name
     1782           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1783     if not available buf_temp-tekka-tsk
     1784     then do:
     1785       find first buf_temp-tekka-tsk where
     1786                 buf_temp-tekka-tsk.filename  = v-file-name
     1787             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1788       if not available buf_temp-tekka-tsk
     1789       then do:
     1790         v-create = yes.
     1791       end.
     1792     end.
     1793   end.
     1794   if v-create then do:
     1795     create buf_temp-tekka-tsk.
     1796     assign
     1797     buf_temp-tekka-tsk.filename = v-file-name
     1798     buf_temp-tekka-tsk.range    = p-plu
     1799     buf_temp-tekka-tsk.obj-num = p-obj-num
     1800     buf_temp-tekka-tsk.obj-name = '':U
     1801     buf_temp-tekka-tsk.num-records = 0
     1802     buf_temp-tekka-tsk.max-records = p-max-records
     1803     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1804     buf_temp-tekka-tsk.task-num = p-fname
     1805     buf_temp-tekka-tsk.by-record = p-by-record
     1806     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1807     buf_temp-tekka-tsk.binary = p-binary
     1808     buf_temp-tekka-tsk.send-get = 'send'
     1809     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1810     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1811     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1812     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1813                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1814                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1815                                 then 'local'
     1816                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1817     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1818     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1819     buf_temp-tekka-tsk.waiting-sek = 30
     1820     buf_temp-tekka-tsk.min-plu     = p-plu
     1821     buf_temp-tekka-tsk.max-plu     = p-plu
     1822     .
     1823   end.
     1824   assign
     1825   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1826   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1827   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1828   .
     1829   END PROCEDURE.
     1830   PROCEDURE maria-get:
     1831   define parameter buffer buf_cash-desk for ub.cash-desk.
     1832   define input parameter p-out    as character no-undo .
     1833   define input parameter p-fname as character no-undo .
     1834   define input parameter p-by-record as logical no-undo .
     1835   define input parameter p-obj-num as integer no-undo .
     1836   define input parameter p-num-fields as integer no-undo .
     1837   define input parameter p-max-records as integer no-undo .
     1838   define input parameter p-min-plu as integer no-undo .
     1839   define input parameter p-max-plu as integer no-undo .
     1840   define input parameter p-other as character no-undo .
     1841   define input parameter p-order-num as integer no-undo .
     1842   define variable v-file-name as character no-undo .
     1843   define variable v-secondary-obj-num as character no-undo .
     1844   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1845   if p-by-record then do:
     1846     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1847   end.
     1848   else do:
     1849     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1850   end.
     1851   find first buf_temp-tekka-tsk where
     1852             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1853   if not available buf_temp-tekka-tsk then do:
     1854     create buf_temp-tekka-tsk.
     1855     assign
     1856     buf_temp-tekka-tsk.filename = v-file-name
     1857     buf_temp-tekka-tsk.obj-num = p-obj-num
     1858     buf_temp-tekka-tsk.obj-name = '':U
     1859     buf_temp-tekka-tsk.max-records = p-max-records
     1860     buf_temp-tekka-tsk.num-fields = p-num-fields
     1861     buf_temp-tekka-tsk.task-num = p-fname
     1862     buf_temp-tekka-tsk.by-record = p-by-record
     1863     buf_temp-tekka-tsk.send-get = 'get'
     1864     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1865     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1866     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1867     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1868                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1869                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1870                                   then 'local'
     1871                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1872     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1873     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1874     buf_temp-tekka-tsk.waiting-sek = 30
     1875     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1876     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1877     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1878                                       and p-max-plu <> ?
     1879                                       then p-max-plu - p-min-plu + 1
     1880                                       else 0)
     1881     buf_temp-tekka-tsk.other-info = p-other
     1882     buf_temp-tekka-tsk.order-num = p-order-num
     1883     .
     1884     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1885       assign
     1886       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1887       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1888       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1889       no-error
     1890       .
     1891       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1892     end.
     1893   end.
     1894   END PROCEDURE.
     1895   PROCEDURE maria-task:
     1896   define parameter buffer buf_cash-desk for ub.cash-desk.
     1897   define input parameter p-fname as character no-undo .
     1898   define input parameter p-obj-num-list as character no-undo .
     1899   define input parameter p-parameters as character no-undo .
     1900   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1901   find first buf_temp-tekka-tsk where
     1902             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1903   if not available buf_temp-tekka-tsk then do:
     1904     create buf_temp-tekka-tsk.
     1905     assign
     1906     buf_temp-tekka-tsk.filename = ''
     1907     buf_temp-tekka-tsk.range = 1
     1908     buf_temp-tekka-tsk.obj-num = 0
     1909     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1910     buf_temp-tekka-tsk.task-num = p-fname
     1911     buf_temp-tekka-tsk.by-record = no
     1912     buf_temp-tekka-tsk.send-get = 'task'
     1913     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1914     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1915     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1916     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1917                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1918                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1919                                   then 'local'
     1920                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1921     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1922     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1923     buf_temp-tekka-tsk.waiting-sek = 30
     1924     buf_temp-tekka-tsk.other-info = p-parameters
     1925     buf_temp-tekka-tsk.order-num = 0
     1926     .
     1927   end.
     1928   END PROCEDURE.
     1929   procedure tekkatsk-verify-schema :
     1930   define input parameter p-obj-list as character no-undo .
     1931   define input parameter p-dir-path as character no-undo .
     1932   define variable v-obj-num as integer no-undo .
     1933   define variable v-obj-name as character no-undo .
     1934   define variable v-num-records as integer no-undo .
     1935   define variable v-size_ as integer no-undo .
     1936   define variable v-value as character no-undo .
     1937   define variable ii as integer no-undo .
     1938   define variable jj as integer no-undo .
     1939   define variable ii-ibs as integer no-undo .
     1940   define variable ii-tekka as integer no-undo .
     1941   define variable v-result as character no-undo .
     1942   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1943   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1944     do
     1945     on error undo, return error
     1946     :
     1947        for each buf_temp-tekka-schema:
     1948          delete buf_temp-tekka-schema.
     1949        end.
     1950        input from value('tekkasch.d').
     1951        repeat :
     1952          create buf_temp-tekka-schema.
     1953          import buf_temp-tekka-schema.
     1954          assign
     1955          buf_temp-tekka-schema.host = 'IBS'
     1956          ii = ii + 1.
     1957          .
     1958        end.
     1959        input close.
     1960        ii-ibs = ii.
     1961         _ii:
     1962         do ii = 1 to 256:
     1963           if p-obj-list = "ALL"
     1964           or lookup(string(ii), p-obj-list) > 0 then do:
     1965             assign
     1966             v-obj-num = 0
     1967             v-obj-name = ''
     1968             v-num-records = 0
     1969             v-size_ = 0
     1970             .
     1971             run alienini-getkey in this-procedure (
     1972                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1973                                                     ,input ('obj' + string(ii, '999'))
     1974                                                     ,input 'oname'
     1975                                                     ,output v-value) no-error .
     1976             if v-value = ? then next _ii.
     1977             assign
     1978             v-obj-num = ii
     1979             v-obj-name = v-value
     1980             .
     1981             run alienini-getkey in this-procedure (
     1982                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1983                                                     ,input ('obj' + string(ii, '999'))
     1984                                                     ,input 'size'
     1985                                                     ,output v-value) no-error .
     1986             assign
     1987             v-num-records = integer(v-value) no-error  .
     1988             if error-status:error
     1989             or v-num-records = 0 then next _ii.
     1990             run alienini-getkey in this-procedure (
     1991                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1992                                                     ,input 'obj' + string(ii, '999')
     1993                                                     ,input 'f000'
     1994                                                     ,output v-value) no-error .
     1995             assign
     1996             v-size_ = integer(v-value) no-error  .
     1997             if error-status:error
     1998             or v-size_ = 0 then next _ii.
     1999             _jj:
     2000             do jj = 1 to 256:
     2001               run alienini-getkey in this-procedure (
     2002                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2003                                                       ,input 'obj' + string(ii, '999')
     2004                                                       ,input 'f' + string(jj, '999')
     2005                                                       ,output v-value) no-error .
     2006               if v-value = ? then next _ii.
     2007               create buf_temp-tekka-schema.
     2008               assign
     2009               buf_temp-tekka-schema.host = 'tekka'
     2010               buf_temp-tekka-schema.obj-num = v-obj-num
     2011               buf_temp-tekka-schema.obj-name = v-obj-name
     2012               buf_temp-tekka-schema.num-records = v-num-records
     2013               buf_temp-tekka-schema.size_ = v-size_
     2014               buf_temp-tekka-schema.field-num = jj
     2015               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2016               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2017                                                  then entry(2, entry(2, v-value, '#'), ':')
     2018                                                  else '':U)
     2019               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2020               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2021               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2022                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2023               no-error
     2024               .
     2025               if error-status:error then do:
     2026                 delete buf_temp-tekka-schema.
     2027                 next _jj.
     2028               end.
     2029               run alienini-getkey in this-procedure (
     2030                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2031                                                       ,input 'obj' + string(ii, '999') + 'name'
     2032                                                       ,input 'n' + string(jj, '999')
     2033                                                       ,output v-value) no-error .
     2034               if v-value <> ? then
     2035               buf_temp-tekka-schema.field-name = v-value.
     2036             end.
     2037           end.
     2038         end.
     2039         ii-tekka = ii - 1.
     2040        if p-obj-list <> 'ALL' then do:
     2041         if ii-tekka <> ii-ibs then do:
     2042           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2043                                   , ii-ibs
     2044                                   , ii-tekka).
     2045         end.
     2046        end.
     2047        for each buf_temp-tekka-schema where
     2048               buf_temp-tekka-schema.host = 'tekka':
     2049          find first buf2_temp-tekka-schema where
     2050                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2051                AND buf2_temp-tekka-schema.host = 'ibs'
     2052                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2053          if not available buf2_temp-tekka-schema then do:
     2054           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2055                                   , buf_temp-tekka-schema.field-num
     2056                                   , buf_temp-tekka-schema.obj-num).
     2057          end.
     2058          buffer-compare buf_temp-tekka-schema
     2059          to buf2_temp-tekka-schema
     2060          save result in v-result.
     2061          if v-result <> '':U then do:
     2062           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2063                                   , buf_temp-tekka-schema.field-num
     2064                                   , buf_temp-tekka-schema.obj-num).
     2065          end.
     2066        end.
     2067     end.
     2068   end procedure.
     2069   FUNCTION set-Sx returns character (input p-string as character):
     2070   return p-string.
     2071   END FUNCTION.
     2072   FUNCTION get-Sx returns character (input p-string  as character):
     2073   return p-string.
     2074   END FUNCTION.
     2075   FUNCTION set-B returns character (input p-string  as character):
     2076   return chr(integer(p-string)).
     2077   END FUNCTION.
     2078   FUNCTION get-B returns character (input p-string  as character):
     2079   return string(asc(p-string)).
     2080   END FUNCTION.
     2081   FUNCTION set-BF returns character (input p-string  as character):
     2082   define variable v-dopi as integer no-undo .
     2083   define variable ii as integer no-undo .
     2084   do ii = 1 to 8:
     2085     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2086   end.
     2087   return chr(v-dopi).
     2088   END FUNCTION.
     2089   FUNCTION get-BF returns character (input p-string  as character):
     2090   define variable v-dopi as integer no-undo .
     2091   define variable v-dops as character no-undo .
     2092   define variable ii as integer no-undo .
     2093   v-dopi = asc(p-string).
     2094   do ii = 8 to 1 BY -1:
     2095     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2096   end.
     2097   return v-dops.
     2098   END FUNCTION.
     2099   FUNCTION set-BN returns character (input p-string  as character
     2100                                     ,input p-bin-group as character):
     2101   define variable v-dopi as integer no-undo .
     2102   define variable ii as integer no-undo .
     2103   define variable jj as integer no-undo .
     2104   define variable v-grp-nums as integer no-undo .
     2105   define variable v-dopi2 as integer no-undo .
     2106   v-grp-nums = num-entries(p-bin-group).
     2107   do jj = 0 to v-grp-nums - 1:
     2108     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2109     do ii = 1 to 8:
     2110       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2111     end.
     2112   end.
     2113   return chr(v-dopi).
     2114   END FUNCTION.
     2115   FUNCTION get-BN returns character (input p-string  as character
     2116                                     ,input p-bin-group as character):
     2117   define variable v-dopi as integer no-undo .
     2118   define variable v-dops as character no-undo .
     2119   define variable v-grp-nums as integer no-undo .
     2120   define variable ii as integer no-undo .
     2121   define variable jj as integer no-undo .
     2122   v-dopi = asc(p-string).
     2123   v-grp-nums = num-entries(p-bin-group).
     2124   do jj = 1 to v-grp-nums:
     2125   do ii = 8 to 1 BY -1:
     2126     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2127   end.
     2128   end.
     2129   return v-dops.
     2130   END FUNCTION.
     2131   procedure fill-temp-cd :
     2132   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2133   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2134   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2135   define input parameter p-clear-table as logical no-undo .
     2136   define buffer buf_temp-cd for temp-cd.
     2137   define buffer buf_cash-desk for ub.cash-desk.
     2138     do
     2139     on error undo, return error
     2140     :
     2141        if p-clear-table  then do:
     2142          for each buf_temp-cd:
     2143            delete buf_temp-cd.
     2144          end.
     2145        end.
     2146        for each buf_cash-desk no-lock where
     2147               buf_cash-desk.db-num = p-db-num
     2148           AND buf_cash-desk.obj-code = p-obj-code
     2149           and buf_cash-desk.cash-on  = yes
     2150        BREAK by buf_cash-desk.pos-type:
     2151          if first-of(buf_cash-desk.pos-type) then do:
     2152            create buf_temp-cd.
     2153            buffer-copy buf_cash-desk to buf_temp-cd.
     2154          end.
     2155        end.
     2156     end.
     2157   end procedure.
     2158   define variable dops as character no-undo format "X(250)".
     2159   define variable dopst as character no-undo format "X(1)".
     2160   assign
     2161   p-obj-type = entry(1, p-parameter, chr(4))
     2162   p-obj-code = integer(entry(2, p-parameter, chr(4)))
     2163   action = entry(3, p-parameter, chr(4))
     2164   p-batch = (if entry(4, p-parameter, chr(4)) = "yes":U
     2165                    then yes
     2166                    else (if entry(4, p-parameter, chr(4)) = "no":U
     2167                          then no
     2168                          else ?)
     2169                    )
     2170   no-error
     2171   .
     2172   if error-status:error or p-batch = ? then return error.
     2173   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2174   PROCEDURE putc-staff.
     2175   define input parameter pos-type as char no-undo.
     2176   CASE pos-type:
     2177     when 'MAGIA-XML':U then do:
     2178       FOR EACH cash-cash NO-LOCK:
     2179         if cash-cash.psswd <> "":U
     2180         or cash-cash.s-psswd <> "":U
     2181         then do:
     2182           if cash-cash.cash-code > 9999
     2183           or cash-cash.slr-code > 9999 then do:
     2184           run write-log-and-file in p-log-handle (
     2185                 input 1
     2186               , input log-file-name
     2187               , input 1
     2188               , input substitute( ("Нельзя передать на кассы типа &1 персонал с кодом кассира или с кодом официанта(продавца) > 9999:" +
     2189                                    "&2Код клиента &3&4, код кассира &5, код продавца &6")
     2190                                    ,'MAGIA-XML':U
     2191                                    ,chr(10)
     2192                                    ,'чел':U
     2193                                    ,cash-cash.psn-code
     2194                                    ,cash-cash.cash-code
     2195                                    ,cash-cash.slr-code
     2196                                 )
     2197                                             ).
     2198           end.
     2199           else do:
     2200             if cash-cash.cash-code > 0 then do:
     2201               run bgelib-tag-open in this-procedure ( input 2, input "Staff", input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD', OS2-time, cash-cash.cash-code)).
     2202               run bgelib-tag-put in this-procedure ( input 3, input "StaffName"             , input cash-cash.cash-name, input 1 ).
     2203               run bgelib-tag-put in this-procedure ( input 3, input "StaffCashierPassword"  , input string(cash-cash.psswd, "9999":U), input 1 ).
     2204               run bgelib-tag-put in this-procedure ( input 3, input "StaffSuperviserFLag"   , input string(cash-cash.superviser), input 1 ).
     2205               run bgelib-tag-put in this-procedure ( input 3, input "StaffIdentType"        , input string(cash-cash.ident-type), input 1 ).
     2206               run bgelib-tag-put in this-procedure ( input 3, input "StaffLock"  ,
     2207                                                               input  string(if action = "U":U
     2208                                                                             and cash-cash.stts = integer('0':U)
     2209                                                                             then 0 else 1), input 1 ).
     2210               run bgelib-tag-close in this-procedure ( input 2, input "Staff").
     2211             end.
     2212             if cash-cash.slr-code > 0
     2213             then do:
     2214               run bgelib-tag-open in this-procedure ( input 2, input "Staff", input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD', OS2-time, cash-cash.slr-code + 10000)).
     2215               run bgelib-tag-put in this-procedure ( input 3, input "StaffName"             , input cash-cash.cash-name, input 1 ).
     2216               run bgelib-tag-put in this-procedure ( input 3, input "StaffCashierPassword"  , input string(cash-cash.s-psswd, "9999":U), input 1 ).
     2217               run bgelib-tag-put in this-procedure ( input 3, input "StaffSuperviserFLag"  , input string(cash-cash.superviser), input 1 ).
     2218               run bgelib-tag-put in this-procedure ( input 3, input "StaffIdentType"        , input string(cash-cash.ident-type), input 1 ).
     2219               run bgelib-tag-put in this-procedure ( input 3, input "StaffLock"  ,
     2220                                                               input  string(if action = "U":U
     2221                                                                             and cash-cash.stts = integer('0':U)
     2222                                                                             then 0
     2223                                                                             else 1), input 1 ).
     2224               run bgelib-tag-close in this-procedure ( input 2, input "Staff").
     2225             end.
     2226           end.
     2227         end.
     2228       END.
     2229     end.
     2230   END CASE .
     2231   END PROCEDURE .
     2232   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2233   PROCEDURE   for-cash-cycle:
     2234   define buffer for-cash-desk for ub.cash-desk.
     2235   define buffer buf_shop for ub.shop.
     2236   define variable v-first as logical no-undo .
     2237     FOR EACH for-cash-desk NO-LOCK WHERE
     2238             for-cash-desk.db-num = g#db-num
     2239         AND for-cash-desk.pos-type = ub.cash-desk.pos-type
     2240         AND for-cash-desk.cash-on  = yes
     2241       BREAK
     2242       BY for-cash-desk.db-num
     2243       BY for-cash-desk.pos-type
     2244       BY for-cash-desk.cash-on
     2245       :
     2246       if for-cash-desk.pos-type <> 'MAGIA-XML':U or
     2247       (LOOKUP(ub.cash-desk.pos-type,
     2248                 ('NCR-GM':U + chr(44) +
     2249                  'IBM-XML':U + chr(44) +
     2250                  'MAGIA-XML':U + chr(44) +
     2251                  'NCR-AS@R':U
     2252                   )) > 0
     2253        and for-cash-desk.autonomy = integer('1':U))
     2254        or v-first then next.
     2255       assign
     2256       v-first = yes
     2257       .
     2258       run write-log-and-file in p-log-handle (
     2259             input 1
     2260           , input log-file-name
     2261           , input 1
     2262           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2263                                                         ).
     2264   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   case for-cash-desk.pos-type:
     2266     when 'MAGIA-XML':U then do:
     2267   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2268   run xml-cd-filename in this-procedure (
     2269         input out
     2270       , output v-xml-file-name
     2271       , output v-xml-file-name-path
     2272       , output v-log-file-name
     2273       , output v-locked
     2274   ).
     2275   run write-log-and-file in p-log-handle (
     2276         input 1
     2277       , input log-file-name
     2278       , input 1
     2279       , input substitute( ("'Пересылка данных по персоналу'" + " &1")
     2280                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2281                         )
     2282                                         ).
     2283   run write-log-and-file in p-log-handle (
     2284         input 1
     2285       , input log-file-name
     2286       , input 1
     2287       , input substitute( "................с параметрами: ... БД: &1", g#db-num )
     2288                                         ).
     2289   assign
     2290   v-obj-list = "БД" + string(g#db-num)
     2291   .
     2292   run xml-cd-write-header in this-procedure (
     2293         input v-xml-file-name
     2294       , input v-xml-file-name-path
     2295       , input "data"
     2296       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2297       , input v-obj-list
     2298       , input (
     2299                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2300                   then (if for-cash-desk.autonomy = integer('0':U)
     2301                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2302                         else ("КМ"    )
     2303                         )
     2304                   else ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2305                   )
     2306               )
     2307       , input yes
     2308   ).
     2309   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2310   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2311     end.
     2312   END CASE.
     2313       RUN putc-staff( for-cash-desk.pos-type ).
     2314   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2315   case for-cash-desk.pos-type:
     2316     when 'MAGIA-XML':U then do:
     2317   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2318   output stream stmxmlout close.
     2319   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2320       , input 'data'
     2321   ).
     2322   run write-log-and-file in p-log-handle (
     2323         input 1
     2324       , input log-file-name
     2325       , input 1
     2326       , input substitute( "Данные выгружены в файл &1"
     2327                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2328                         )
     2329                                          ).
     2330   if (
     2331   not (g#news or g#auto or g#esys )
     2332   or
     2333   (
     2334   for-cash-desk.pos-type = 'MAGIA-XML':U
     2335   or
     2336     (for-cash-desk.pos-type = 'IBM-XML':U
     2337   or (for-cash-desk.pos-type = 'Autotank':U
     2338     and
     2339     for-cash-desk.autonomy = integer('2':U))
     2340     )))
     2341   then do:
     2342     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2343       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     2344                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     2345                   ( if action = 'U'
     2346                     then ('Ждите - ' + 'добавление данных по персоналу')
     2347                     else ('Ждите - ' + 'удаление данных по персоналу') ) +
     2348                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     2349                     ' Подождите 15 сек ',
     2350                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     2351                     'Подождите: касса обрабатывает запрос',
     2352                     15 ) no-error.
     2353       if error-status:error then do:
     2354         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     2355         run write-log-and-file in p-log-handle (
     2356               input 1
     2357             , input log-file-name
     2358             , input 1
     2359             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     2360                                   for-cash-desk.cash-num
     2361                               )
     2362                                               ).
     2363         assign
     2364         v-view-log = yes
     2365         .
     2366         return "error":U.
     2367       end.
     2368     end.
     2369     if (for-cash-desk.pos-type = 'IBM-XML':U
     2370     and for-cash-desk.autonomy = integer('0':U))
     2371     or (for-cash-desk.pos-type = 'Autotank':U
     2372     and for-cash-desk.autonomy = integer('2':U))
     2373     then do:
     2374       run str/post-xml.p
     2375         (
     2376          input parparentproc
     2377         ,input p-parent-handle
     2378         ,input p-log-handle
     2379         ,input g#news or g#esys
     2380         ,input g#auto
     2381         ,input 'send'
     2382         ,input log-file-name
     2383         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2384         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2385         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2386         ,input 30
     2387         ,input   ( if action = 'U'
     2388                     then ('Ждите - ' + 'добавление данных по персоналу')
     2389                     else ('Ждите - ' + 'удаление данных по персоналу') ) +
     2390                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2391         ) no-error .
     2392       if error-status:error
     2393       or return-value = "error" then do:
     2394         run write-log-and-file in p-log-handle (
     2395               input 1
     2396             , input log-file-name
     2397             , input 1
     2398             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2399                                   ,for-cash-desk.obj-code
     2400                                   ,for-cash-desk.cash-num
     2401                                   , chr(10)
     2402                                   , error-status:get-message(1)
     2403                                   , return-value
     2404                               )
     2405                                               ).
     2406         assign
     2407         v-view-log = yes
     2408         .
     2409       end.
     2410     end.
     2411     if not available ub.shop then do:
     2412       find first ub.shop no-lock where
     2413                 ub.shop.obj-code = for-cash-desk.obj-code.
     2414     end.
     2415     if
     2416     not (g#news or g#esys)
     2417     then do:
     2418       run str/getxibmf.p (
     2419                       input parparentproc
     2420                     ,input p-log-handle
     2421                     ,input 'маг':U
     2422                     ,input for-cash-desk.obj-code
     2423                     ,input ub.shop.host-code
     2424                     ,input in_
     2425                     ,input spl
     2426                     ,input (in_ + sav)
     2427                     ,input for-cash-desk.pos-type
     2428                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2429                             and for-cash-desk.autonomy = integer('0':U))
     2430                             or (for-cash-desk.pos-type = 'Autotank':U
     2431                             and for-cash-desk.autonomy = integer('2':U))
     2432                             then "utf-8":U
     2433                             else "windows-1251")
     2434                     ,input log-file-name
     2435                     ,input "data":U
     2436                     ,input v-xml-file-name
     2437                     ,input-output v-view-log
     2438                     ) no-error .
     2439       if error-status:error then do:
     2440         run write-log-and-file in p-log-handle (
     2441               input 1
     2442             , input log-file-name
     2443             , input 1
     2444             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2445                                   ,for-cash-desk.obj-code
     2446                                   ,for-cash-desk.cash-num
     2447                               )
     2448                                               ).
     2449         assign
     2450         v-view-log = yes
     2451         .
     2452       end.
     2453     end.
     2454   end.
     2455   if g#news
     2456   or g#auto
     2457   or g#esys
     2458   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2459   then do:
     2460   end.
     2461     end.
     2462   END CASE.
     2463     END .
     2464   END PROCEDURE.
     2465   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2466   PROCEDURE SENDING:
     2467   DEFINE VARIABLE fq as integer no-undo .
     2468   FOR EACH ub.cash-desk NO-LOCK WHERE
     2469           ub.cash-desk.db-num = g#db-num
     2470       AND ub.cash-desk.cash-on
     2471   BREAK
     2472   By ub.cash-desk.pos-type :
     2473     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2474   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2475   define variable dflt-cd16 as character no-undo .
     2476   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2477   define variable v-param-type17 as character no-undo .
     2478   define variable v-value-date17 as date no-undo .
     2479   define variable v-value-decimal17 as decimal no-undo .
     2480   define variable v-value-integer17 as INTEGER no-undo .
     2481   define variable v-value-logical17 AS LOGICAL no-undo .
     2482   define variable v-tth17 as handle no-undo .
     2483   run adm/shattri.p (
     2484       input "get":U
     2485       ,input  'маг':U
     2486       ,input  ub.cash-desk.obj-code
     2487       ,input  'cd-sending':U
     2488       ,input  'dflt-cd':U
     2489       ,output dflt-cd16
     2490       ,output v-value-date17
     2491       ,output v-value-decimal17
     2492       ,output v-value-integer17
     2493       ,output v-value-logical17
     2494       ,output v-param-type17
     2495       ,INPUT-OUTPUT table-handle v-tth17
     2496       ) no-error .
     2497   delete object v-tth17 no-error.
     2498   case ub.cash-desk.pos-type:
     2499       when 'MAGIA-XML':U
     2500     then do:
     2501   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2502   run str/get-inis.p (
     2503                   input 'маг':U
     2504                 , input ub.cash-desk.obj-code
     2505                 , input ub.cash-desk.pos-type
     2506                 , input cash-desk.remote
     2507                 , input "send":U
     2508                 , output out
     2509                 , output out2
     2510                 , output in_
     2511                 , output spl
     2512                 , output sav
     2513                 , output v-remote
     2514                 )  no-error .
     2515   if error-status:error then do:
     2516     run write-log-and-file in p-log-handle (
     2517           input 1
     2518         , input log-file-name
     2519         , input 1
     2520         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2521                             , ub.cash-desk.pos-type
     2522                             , ub.cash-desk.obj-code
     2523                             , chr(10)
     2524                             , error-status:get-message(1)
     2525                             , return-value )).
     2526     assign
     2527     v-view-log = yes.
     2528     return error.
     2529   end.
     2530   if ub.cash-desk.pos-type = 'IBM-XML':U
     2531   or ub.cash-desk.pos-type = 'Autotank':U
     2532   then do:
     2533     file-info:file-name = (out  + "undelivered").
     2534     if file-info:FULL-PATHNAME <> ? then do:
     2535       run str/rsndxibm.p ( input parparentproc
     2536                           ,input p-parent-handle
     2537                           ,input p-log-handle
     2538                           ,input out  + "undelivered" ) no-error.
     2539     end.
     2540   end.
     2541     end.
     2542   END CASE.
     2543       RUN for-cash-cycle no-error.
     2544     END.
     2545     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2546   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2547   case ub.cash-desk.pos-type:
     2548   END CASE.
     2549     END.
     2550   END.
     2551   END PROCEDURE.
     2552   RUN SENDING no-error.
     2553   if error-status:error then do:
     2554     run write-log-and-file in p-log-handle (
     2555           input 1
     2556         , input log-file-name
     2557         , input 1
     2558         , input substitute( "!!!Ошибки при отсылке информации по персоналу на кассы  &1&2"
     2559                            , p-obj-type
     2560                            , p-obj-code
     2561                           )
     2562                                           ).
     2563     assign
     2564     v-view-log = yes
     2565     .
     2566   end.
     2567   if p-batch then do:
     2568     if v-view-log then
     2569     run set-view-log in p-log-handle(yes).
     2570   end.
     2571   else do:
     2572     if v-view-log then
     2573     return error .
     2574   end.
