      593   procedure xmlchar-decode :
      594   define input parameter p-in-string      as character        no-undo.
      595   define output parameter p-out-string    as character        no-undo.
      596       define variable v-position      as integer      no-undo.
      597       define variable v-last-position as integer      no-undo.
      598       define variable v-temp-integer  as integer      no-undo.
      599       define variable v-current-char  as character    no-undo.
      600       define variable v-next-char     as character    no-undo.
      601       define variable v-success       as logical      no-undo.
      602   do
      603   on error undo, return error
      604   :
      605       assign
      606           p-out-string = "":U
      607           v-position   = 0
      608       .
      609       replace-cycle:
      610       do while yes
      611       on error undo, return error
      612       :
      613           assign
      614               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      615           .
      616           if v-last-position <= v-position
      617           then do:
      618               if v-position = 0
      619               then do:
      620                   assign
      621                       p-out-string = p-in-string
      622                   .
      623               end.
      624               else do:
      625                   assign
      626                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      627                   .
      628               end.
      629               leave replace-cycle.
      630           end.
      631           else do:
      632               assign
      633                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      634                   v-position      = v-last-position
      635                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      636               .
      637               if v-current-char = "#":U
      638               then do:
      639                   assign
      640                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      641                   .
      642                   if v-last-position > 0
      643                   then do:
      644                       run xmlchar-read-integer in this-procedure
      645                        (
      646                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      647                           , output v-temp-integer
      648                           , output v-success
      649                       ).
      650                       if v-success = yes
      651                       and v-temp-integer >= 1
      652                       and v-temp-integer <= 255
      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + chr( v-temp-integer )
      656                               v-position   = v-last-position + 1
      657                           .
      658                       end.
      659                       else do:
      660                           assign
      661                               p-out-string = p-out-string + "&":U
      662                               v-position   = v-position   + 1
      663                           .
      664                       end.
      665                   end.
      666                   else do:
      667                       assign
      668                           p-out-string = p-out-string + "&":U
      669                           v-position   = v-position   + 1
      670                       .
      671                   end.
      672               end.
      673               else do:
      674                   case substring( p-in-string, v-position + 1, 3 )
      675                   :
      676                       when "lt;":U
      677                       then do:
      678                           assign
      679                               p-out-string = p-out-string + "<":U
      680                               v-position   = v-position   + 3
      681                           .
      682                       end.
      683                       when "gt;":U
      684                       then do:
      685                           assign
      686                               p-out-string = p-out-string + ">":U
      687                               v-position   = v-position   + 3
      688                           .
      689                       end.
      690                       otherwise do:
      691                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      692                           then do:
      693                               assign
      694                                   p-out-string = p-out-string + "&":U
      695                                   v-position   = v-position   + 4
      696                               .
      697                           end.
      698                           else do:
      699                               case substring( p-in-string, v-position + 1, 5 )
      700                               :
      701                                   when "quot;":U
      702                                   then do:
      703                                       assign
      704                                           p-out-string = p-out-string + '"':U
      705                                           v-position   = v-position   + 5
      706                                       .
      707                                   end.
      708                                   when "apos;":U
      709                                   then do:
      710                                       assign
      711                                           p-out-string = p-out-string + "'":U
      712                                           v-position   = v-position   + 5
      713                                       .
      714                                   end.
      715                                   otherwise do:
      716                                       assign
      717                                           p-out-string = p-out-string + "&":U
      718                                       .
      719                                   end.
      720                               end case.
      721                           end.
      722                       end.
      723                   end case.
      724               end.
      725           end.
      726       end.
      727   end.
      728   end .
      729   procedure xmlchar-read-integer :
      730   define input parameter p-input-string      as character        no-undo.
      731   define output parameter p-output-integer   as integer          no-undo.
      732   define output parameter p-success       as logical          no-undo.
      733   do
      734   on error undo, return error
      735   :
      736       assign
      737           p-output-integer = integer( p-input-string )
      738       no-error.
      739       if error-status :error
      740       then do:
      741           assign
      742               p-success           = no
      743               p-output-integer    = 0
      744           .
      745       end.
      746       else do:
      747           assign
      748               p-success           = yes
      749           .
      750       end.
      751   end.
      752   end.
      753   define variable v-bgelib-bgeclall           as logical      no-undo.
      754   define variable v-bgelib-bgedict            as logical      no-undo.
      755   define temp-table temp_ext-doc-type no-undo
      756       field edt-key               as integer
      757       field ext-doc-type          as character
      758       field ext-doc-type-label    as character
      759       index pi is primary unique
      760           edt-key
      761   .
      762   define temp-table temp_bgelib_goods no-undo
      763       field gds-code as integer
      764       index pi is primary unique
      765           gds-code
      766   .
      767   define temp-table temp_bgelib_clients no-undo
      768       field obj-type as character
      769       field obj-code as integer
      770       index pi is primary unique
      771           obj-type
      772           obj-code
      773   .
      774   define temp-table temp_bgelib_dis-card no-undo
      775       field d-card as character
      776       index pi is primary unique
      777           d-card
      778   .
      779   define temp-table temp_bgelib_trn-doc no-undo
      780       field doc-code as integer
      781   .
      782   procedure bgelib-tag-open:
      783   do
      784   on error undo, return error
      785   :
      786   define input parameter v-tag-level  as integer      no-undo.
      787   define input parameter v-tag-name   as character    no-undo.
      788   define input parameter v-tag-value  as character    no-undo.
      789       put stream stmXMLOut unformatted
      790           chr(10)
      791           + fill(" ", 4 * v-tag-level)
      792           + "<" + v-tag-name
      793           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      794           + v-tag-value + ">"
      795       .
      796   end.
      797   end procedure.
      798   procedure bgelib-tag-put:
      799   do
      800   on error undo, return error
      801   :
      802   define input parameter v-tag-level      as integer      no-undo.
      803   define input parameter v-tag-name       as character    no-undo.
      804   define input parameter v-tag-value      as character    no-undo.
      805   define input parameter v-empty-mode     as integer      no-undo.
      806       v-tag-name = trim(v-tag-name).
      807       if  v-empty-mode = 1
      808       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      809       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      810       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      811       then do:
      812           run xmlchar-encode in this-procedure (
      813                 input v-tag-value
      814               , output v-tag-value
      815           ).
      816           put stream stmXMLOut unformatted
      817               chr(10) + fill(" ", 4 * v-tag-level)
      818                           + '<' + v-tag-name + '>'
      819                           + v-tag-value
      820                           + '</' + v-tag-name + '>'
      821           .
      822       end.
      823   end.
      824   end procedure.
      825   procedure bgelib-tag-close:
      826   do
      827   on error undo, return error
      828   :
      829   define input parameter v-tag-level as integer      no-undo.
      830   define input parameter v-tag-name  as character    no-undo.
      831       put stream stmXMLOut unformatted
      832           chr(10)
      833           + fill( " ", 4 * v-tag-level)
      834           + '</' + v-tag-name + '>'
      835       .
      836   end.
      837   end procedure.
      838   procedure bgelib-write-log:
      839   do
      840   on error undo, return error
      841   :
      842   define input parameter v-filename   as character    no-undo.
      843   define input parameter v-log-level  as integer      no-undo.
      844   define input parameter v-out-string as character    no-undo.
      845       output stream stmXMLLog to value( v-filename ) append.
      846       put stream stmXMLLog unformatted
      847           chr(10)
      848       .
      849       put stream stmXMLLog unformatted
      850           ( if v-log-level = 0
      851             or v-out-string = "&DLine"
      852             or v-out-string = "&Line"
      853             then ""
      854             else cur-time-string-sec() + " " )
      855       .
      856       put stream stmXMLLog unformatted
      857           ( if v-out-string = "&Line"
      858             then fill( "-", 80 )
      859             else if v-out-string = "&DLine"
      860                  then fill( "=", 80 )
      861                  else v-out-string )
      862       .
      863       output stream stmXMLLog close.
      864   end.
      865   end procedure.
      866   procedure bgelib-write-edt:
      867   do
      868   on error undo, return error
      869   :
      870   define input parameter v-editor-handle    as handle       no-undo.
      871   define input parameter v-log-level        as integer      no-undo.
      872   define input parameter v-out-string       as character    no-undo.
      873       if valid-handle ( v-editor-handle )
      874       then do:
      875           v-editor-handle :move-to-eof().
      876           v-editor-handle :insert-string( ( if v-log-level = 0
      877                                             or v-out-string = "&DLine"
      878                                             or v-out-string = "&Line"
      879                                             then ""
      880                                             else cur-time-string-sec() + " "
      881                                         ) ).
      882           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      883                                             then fill( "-", 80 )
      884                                             else if v-out-string = "&DLine" then fill("=", 80)
      885                                             else fill( " ", v-log-level) + v-out-string
      886                                         ) ).
      887           v-editor-handle :insert-string( chr(10) ).
      888       end.
      889       process events.
      890       output to 'bgescn.txt' append.
      891           put unformatted
      892               chr(10)
      893               string( ( if v-log-level = 0
      894                         or v-out-string = "&DLine"
      895                         or v-out-string = "&Line"
      896                         then ""
      897                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      898                     ) )
      899               string( ( if v-out-string = "&Line"
      900                         then fill( "-", 80 )
      901                         else if v-out-string = "&DLine"
      902                              then fill( "=", 80 )
      903                              else fill( " ", v-log-level ) + v-out-string
      904                     ) )
      905           .
      906       output close.
      907   end.
      908   end procedure.
      909   procedure bgelib-show-cnt:
      910   do
      911   on error undo, return error
      912   :
      913   define input parameter v-fillin-handle     as handle   no-undo.
      914       if valid-handle( v-fillin-handle )
      915       then do:
      916           assign
      917               v-fillin-handle :visible = true
      918           .
      919       end.
      920   end.
      921   end procedure.
      922   procedure bgelib-hide-cnt:
      923   do
      924   on error undo, return error
      925   :
      926   define input parameter v-fillin-handle     as handle   no-undo.
      927       if valid-handle( v-fillin-handle )
      928       then do:
      929           assign v-fillin-handle :visible = false.
      930       end.
      931   end.
      932   end procedure.
      933   procedure bgelib-write-cnt:
      934   do
      935   on error undo, return error
      936   :
      937   define input parameter v-fillin-handle    as handle       no-undo.
      938   define input parameter v-fillin-string    as character    no-undo.
      939       if valid-handle( v-fillin-handle )
      940       then do:
      941           assign
      942               v-fillin-handle :SCREEN-value = v-fillin-string
      943           .
      944       end.
      945   end.
      946   end procedure.
      947   procedure bgelib-write-header:
      948   do
      949   on error undo, return error
      950   :
      951   define input parameter p-first-file     as logical      no-undo.
      952   define input parameter p-xml-file-name  as character    no-undo.
      953   define input parameter p-list-file-name as character    no-undo.
      954   define input parameter p-file-number    as integer      no-undo.
      955   define input parameter p-have-prev      as logical      no-undo.
      956   define input parameter p-prev-filename  as character    no-undo.
      957   define input parameter p-obj-list       as character    no-undo.
      958   define input parameter p-doc-type-list  as character    no-undo.
      959   define input parameter p-parameter-list as character    no-undo.
      960       define variable v-counter    as integer        no-undo.
      961       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      962       put stream stmXMLOut unformatted
      963           "<?xml version='1.0' encoding='windows-1251'?>"
      964       .
      965       run bgelib-tag-open( input 0, input "root"  , input "" ).
      966       run bgelib-tag-open( input 0, input "header", input "" ).
      967       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      968       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      969       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      970       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      971       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      972       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      973       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      974       :
      975           run bgelib-tag-put(
      976                 input 1
      977               , input entry( 2 * v-counter, p-parameter-list )
      978               , input entry( 2 * v-counter + 1, p-parameter-list )
      979               , input 0
      980           ).
      981       end.
      982       run bgelib-tag-close( input 0, input "header" ).
      983       output stream stmXMLOut close.
      984       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      985       if p-first-file = yes
      986       then do:
      987           put stream stmXMLOut unformatted
      988               "<?xml version='1.0' encoding='windows-1251'?>"
      989           .
      990           run bgelib-tag-open( input 0, input "export", input "" ).
      991       end.
      992       run bgelib-tag-open( input 1, input "file", input "" ).
      993       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      994       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      995       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      996       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      997       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      998       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      999       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1000       :
     1001           run bgelib-tag-put(
     1002                 input 2
     1003               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1004               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1005               , input 0
     1006           ).
     1007       end.
     1008       run bgelib-tag-close( input 1, input "file" ).
     1009       output stream stmXMLOut close.
     1010   end.
     1011   end procedure.
     1012   procedure bgelib-write-footer:
     1013   do
     1014   on error undo, return error
     1015   :
     1016   define input parameter p-last-file      as logical      no-undo.
     1017   define input parameter p-xml-file-name  as character    no-undo.
     1018   define input parameter p-list-file-name as character    no-undo.
     1019   define input parameter p-have-next      as logical      no-undo.
     1020   define input parameter p-next-file-name as character    no-undo.
     1021       define variable v-error-num     as integer           no-undo.
     1022       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1023       if p-have-next = yes
     1024       then do:
     1025           run bgelib-tag-open( input 0, input "footer", "" ).
     1026           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1027           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1028           run bgelib-tag-close( input 0, input "footer" ).
     1029       end.
     1030       run bgelib-tag-close( input 0, input "root" ).
     1031       output stream stmXMLOut close.
     1032       run bge/os_copy.p (
     1033             input "M"
     1034           , input p-xml-file-name + "tmp"
     1035           , input p-xml-file-name + "xml"
     1036           , output v-error-num
     1037       ).
     1038       if p-last-file = yes
     1039       then do:
     1040           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1041               run bgelib-tag-close( input 0, input "export" ).
     1042           output stream stmXMLOut close.
     1043           run bge/os_copy.p (
     1044                 input "M"
     1045               , input p-list-file-name + "tmp"
     1046               , input p-list-file-name + "xml"
     1047               , output v-error-num
     1048           ).
     1049       end.
     1050   end.
     1051   end procedure.
     1052   procedure bgelib-filename :
     1053   do
     1054   on error undo, return error
     1055   :
     1056   define input parameter p-prefix             as character    no-undo.
     1057   define output parameter p-xml-file-name     as character    no-undo.
     1058   define output parameter p-log-file-name     as character    no-undo.
     1059   define output parameter p-list-file-name    as character    no-undo.
     1060       define variable v-home-dir  as character    no-undo.
     1061       define variable v-error-num as integer      no-undo.
     1062       get-key-value section "BGE" key "outdir" value v-home-dir.
     1063       if v-home-dir = ?
     1064       then do:
     1065           message
     1066             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1067             skip(1)
     1068             skip "Обратитесь к администратору."
     1069           view-as alert-box error.
     1070           undo, return error .
     1071       end.
     1072       run gbl/dir-cre.p (
     1073           input v-home-dir
     1074       ) no-error.
     1075       if error-status :error
     1076       then do:
     1077           message
     1078             skip "Неверно задан каталог экспорта."
     1079             skip(1)
     1080             skip "Обратитесь к администратору."
     1081           view-as alert-box error.
     1082           undo, return error .
     1083       end.
     1084       run bge/genfname.p (
     1085             input v-home-dir
     1086           , input p-prefix
     1087           , input ""
     1088           , input "xml"
     1089           , input "tmp"
     1090           , output p-xml-file-name
     1091       ).
     1092       assign
     1093           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1094           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1095           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1096       .
     1097   end.
     1098   end procedure.
     1099   procedure bgelib-read-config :
     1100   do
     1101   on error undo, return error
     1102   :
     1103   define variable v-par-type as character     no-undo.
     1104     define variable v-param-type      as character  no-undo .
     1105     define variable v-value-character as character  no-undo .
     1106     define variable v-value-date      as date       no-undo .
     1107     define variable v-value-decimal   as decimal    no-undo .
     1108     define variable v-value-integer   as integer    no-undo .
     1109     define variable v-value-logical   as logical    no-undo .
     1110     define variable v-tth             as handle     no-undo .
     1111       assign
     1112           v-bgelib-bgeclall = no
     1113           v-bgelib-bgedict  = no
     1114       .
     1115       run adm/shattri.p ( input "get":U
     1116                         , input  '':u
     1117                         , input  0
     1118                         , input  'bge-export':U
     1119                         , input  'bgeclall':U
     1120                         , output v-value-character
     1121                         , output v-value-date
     1122                         , output v-value-decimal
     1123                         , output v-value-integer
     1124                         , output v-value-logical
     1125                         , output v-param-type
     1126                         , input-output table-handle v-tth
     1127                         ) no-error .
     1128       if error-status :error
     1129       then do:
     1130         assign
     1131           v-bgelib-bgeclall = no
     1132         .
     1133       end.
     1134       else do:
     1135         assign
     1136           v-bgelib-bgeclall = v-value-logical
     1137         .
     1138       end.
     1139       delete object v-tth.
     1140       run adm/shattri.p ( input "get":U
     1141                         , input  '':u
     1142                         , input  0
     1143                         , input  'bge-export':U
     1144                         , input  'bgedict':U
     1145                         , output v-value-character
     1146                         , output v-value-date
     1147                         , output v-value-decimal
     1148                         , output v-value-integer
     1149                         , output v-value-logical
     1150                         , output v-param-type
     1151                         , input-output table-handle v-tth
     1152                         ) no-error .
     1153       if error-status :error
     1154       then do:
     1155         assign
     1156           v-bgelib-bgedict = no
     1157         .
     1158       end.
     1159       else do:
     1160         assign
     1161           v-bgelib-bgedict = v-value-logical
     1162         .
     1163       end.
     1164       delete object v-tth.
     1165       run adm/shattri.p ( input "get":U
     1166                         , input  '':u
     1167                         , input  0
     1168                         , input  'bge-export':U
     1169                         , input  'bgefmt':U
     1170                         , output v-value-character
     1171                         , output v-value-date
     1172                         , output v-value-decimal
     1173                         , output v-value-integer
     1174                         , output v-value-logical
     1175                         , output v-param-type
     1176                         , input-output table-handle v-tth
     1177                         ) no-error .
     1178       if error-status :error
     1179       then do:
     1180         assign
     1181           v-bgelib-bgefmt  = "xml":U
     1182         .
     1183       end.
     1184       else do:
     1185         assign
     1186           v-bgelib-bgefmt  = v-value-character
     1187         .
     1188       end.
     1189       delete object v-tth.
     1190       run adm/shattri.p ( input "get":U
     1191                         , input  '':u
     1192                         , input  0
     1193                         , input  'bge-export':U
     1194                         , input  'bgeflold':U
     1195                         , output v-value-character
     1196                         , output v-value-date
     1197                         , output v-value-decimal
     1198                         , output v-value-integer
     1199                         , output v-value-logical
     1200                         , output v-param-type
     1201                         , input-output table-handle v-tth
     1202                         ) no-error .
     1203       if error-status :error
     1204       then do:
     1205         assign
     1206           v-bgelib-bgeflold  = "old":U
     1207         .
     1208       end.
     1209       else do:
     1210         assign
     1211           v-bgelib-bgeflold  = v-value-character
     1212         .
     1213       end.
     1214       delete object v-tth.
     1215   end.
     1216   end procedure.
     1217   procedure bgelib-check-file-size :
     1218   do
     1219   on error undo, return error
     1220   :
     1221   define input parameter p-out-filename   as character    no-undo.
     1222   define output parameter p-is-big        as logical      no-undo.
     1223       define variable v-current-position    as integer        no-undo.
     1224       assign
     1225           v-current-position = seek( stmXMLOut )
     1226       .
     1227       if v-current-position / 1024 / 1024  >= 100
     1228       then do:
     1229           assign
     1230               p-is-big = yes
     1231           .
     1232       end.
     1233   end.
     1234   end procedure.
     1235   procedure bgelib-init-ext-doc-type :
     1236       define variable v-counter    as integer      no-undo.
     1237       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1238   do
     1239   for buf_temp_ext-doc-type
     1240   on error undo, return error
     1241   :
     1242       empty temp-table buf_temp_ext-doc-type.
     1243       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1244       :
     1245           create buf_temp_ext-doc-type.
     1246           assign
     1247               buf_temp_ext-doc-type.edt-key               = v-counter
     1248               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1249               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1250           .
     1251       end.
     1252   end.
     1253   end procedure.
