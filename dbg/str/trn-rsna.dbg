        1   DEFINE TEMP-TABLE tt_trn-reason NO-UNDO LIKE ub.trn-reason.
        2   define input        parameter parParentProc as widget-handle no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input-output parameter p-rid         as recid         no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision$":U.
        6   define variable vss-author      as character no-undo initial "$Author$":U.
        7   define variable vss-date        as character no-undo initial "$Date$":U.
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        9   define variable vss-archive     as character no-undo initial "$Archive$":U.
       10   define variable vss-description as character no-undo initial "Карточка основания (причины) создания документа":U.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-attr DEFAULT
      115        LABEL "&Атрибуты"
      116        SIZE 10 BY 1.
      117   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      118        LABEL "&Ввод "
      119        SIZE 10 BY 1.
      120   DEFINE BUTTON b-help DEFAULT
      121        LABEL "Помо&щь"
      122        SIZE 10 BY 1.
      123   DEFINE BUTTON b-history DEFAULT
      124        LABEL "Истори&я"
      125        SIZE 10 BY 1.
      126   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      127        LABEL "&Отмена"
      128        SIZE 10 BY 1.
      129   DEFINE QUERY trn-rsna FOR
      130         tt_trn-reason SCROLLING.
      131   DEFINE FRAME trn-rsna
      132        b-exit AT ROW 1 COL 1 WIDGET-ID 4
      133        b-quit AT ROW 1 COL 11 WIDGET-ID 10
      134        b-attr AT ROW 1 COL 21 WIDGET-ID 2
      135        b-history AT ROW 1 COL 80.5 WIDGET-ID 8
      136        b-help AT ROW 1 COL 90.75 WIDGET-ID 6
      137        tt_trn-reason.reason-code AT ROW 2.25 COL 21.5 COLON-ALIGNED WIDGET-ID 14
      138             LABEL "Код"
      139             VIEW-AS FILL-IN
      140             SIZE 15.5 BY 1
      141        tt_trn-reason.reason-name AT ROW 3.25 COL 2.5 WIDGET-ID 16
      142             LABEL "Основание (причина)"
      143             VIEW-AS FILL-IN
      144             SIZE 77.25 BY 1
      145        tt_trn-reason.PS AT ROW 4.25 COL 2.5 NO-LABEL WIDGET-ID 12
      146             VIEW-AS EDITOR
      147             SIZE 98.25 BY 3.42
      148             BGCOLOR 15 FGCOLOR 4
      149        SPACE(0.62) SKIP(0.20)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "<insert dialog title>" WIDGET-ID 100.
      153   ASSIGN
      154          FRAME trn-rsna:SCROLLABLE       = FALSE
      155          FRAME trn-rsna:HIDDEN           = TRUE.
      156   ASSIGN
      157          b-attr:HIDDEN IN FRAME trn-rsna           = TRUE.
      158   ON WINDOW-CLOSE OF FRAME trn-rsna
      159   DO:
      160     APPLY "END-ERROR":U TO SELF.
      161   END.
      162   ON CHOOSE OF b-attr IN FRAME trn-rsna
      163   DO:
      164   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if lookup(self :type
      166            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      167            ) = 0
      168   then do:
      169     message
      170       "$Workfile$"
      171       "Указанному интерфейсному элементу фокус не может быть передан" skip
      172       "Интерфейсный элемент" self :name  skip
      173       "Тип" self :type  skip
      174       "Процедура" this-procedure :file-name skip
      175       view-as alert-box .
      176   end.
      177   else do:
      178     apply "entry":u to self  .
      179     if focus :handle <> self :handle  then do:
      180       return no-apply .
      181     end.
      182   end.
      183     run str/trsnatrs.w ( input parParentProc, input p-mode, input tt_trn-reason.reason-code ).
      184   END.
      185   ON CHOOSE OF b-exit IN FRAME trn-rsna
      186   DO:
      187   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   if lookup(self :type
      189            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      190            ) = 0
      191   then do:
      192     message
      193       "$Workfile$"
      194       "Указанному интерфейсному элементу фокус не может быть передан" skip
      195       "Интерфейсный элемент" self :name  skip
      196       "Тип" self :type  skip
      197       "Процедура" this-procedure :file-name skip
      198       view-as alert-box .
      199   end.
      200   else do:
      201     apply "entry":u to self  .
      202     if focus :handle <> self :handle  then do:
      203       return no-apply .
      204     end.
      205   end.
      206     assign
      207       tt_trn-reason.reason-code
      208       tt_trn-reason.reason-name
      209       tt_trn-reason.PS
      210     .
      211     run ref/trn-rsn1.p
      212       ( input-output p-rid
      213       , input p-mode
      214       , input no
      215       , input tt_trn-reason.reason-code
      216       , input tt_trn-reason.reason-name
      217       , input tt_trn-reason.PS
      218       ) no-error.
      219     if error-status:error then do:
      220       if return-value = "":U then do:
      221         return no-apply.
      222       end.
      223       case return-value :
      224         when "reason-code":U then do:
      225           apply "entry" to tt_trn-reason.reason-code .
      226         end.
      227         when "reason-name":u then do:
      228           apply "entry" to tt_trn-reason.reason-name .
      229         end.
      230         when "ps":u then do:
      231           apply "entry" to tt_trn-reason.ps .
      232         end.
      233       end.
      234       return no-apply.
      235     end.
      236   END.
      237   ON CHOOSE OF b-history IN FRAME trn-rsna
      238   DO:
      239     define variable v-list as character no-undo.
      240   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   if lookup(self :type
      242            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      243            ) = 0
      244   then do:
      245     message
      246       "$Workfile$"
      247       "Указанному интерфейсному элементу фокус не может быть передан" skip
      248       "Интерфейсный элемент" self :name  skip
      249       "Тип" self :type  skip
      250       "Процедура" this-procedure :file-name skip
      251       view-as alert-box .
      252   end.
      253   else do:
      254     apply "entry":u to self  .
      255     if focus :handle <> self :handle  then do:
      256       return no-apply .
      257     end.
      258   end.
      259     run str/trncrsns.w ( input parParentProc, input "":U, input "one":U, input tt_trn-reason.reason-code, input-output v-list ).
      260   END.
      261   ON CHOOSE OF b-quit IN FRAME trn-rsna
      262   DO:
      263   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   if lookup(self :type
      265            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      266            ) = 0
      267   then do:
      268     message
      269       "$Workfile$"
      270       "Указанному интерфейсному элементу фокус не может быть передан" skip
      271       "Интерфейсный элемент" self :name  skip
      272       "Тип" self :type  skip
      273       "Процедура" this-procedure :file-name skip
      274       view-as alert-box .
      275   end.
      276   else do:
      277     apply "entry":u to self  .
      278     if focus :handle <> self :handle  then do:
      279       return no-apply .
      280     end.
      281   end.
      282   END.
      283   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME trn-rsna:PARENT eq ?
      284   THEN FRAME trn-rsna:PARENT = ACTIVE-WINDOW.
      285   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   on help of frame trn-rsna
      287   do:
      288     run gbl/app_help.p
      289       (input this-procedure :file-name
      290       ,input ''
      291       ,input ?
      292       ) no-error.
      293     if error-status :error then do:
      294       message
      295         "Ошибка при вызове помощи"
      296         error-status :get-message(1)
      297         view-as alert-box .
      298     end.
      299   end.
      300   run minbtn-set in this-procedure .
      301   on choose of b-help in frame trn-rsna
      302   do:
      303     apply "help":u to frame trn-rsna .
      304   end.
      305   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   procedure minbtn-set :
      307       do
      308           on error undo, return error return-value
      309           :
      310           define variable ii              as integer       no-undo .
      311           define variable fh              as widget-handle no-undo .
      312           define variable hh              as widget-handle no-undo .
      313           define variable v-h             as handle        extent 4 no-undo .
      314           define variable v-name-button   as character     no-undo .
      315           define variable v-help-old-x    as decimal       no-undo .
      316           define variable v-help-old-y    as decimal       no-undo .
      317           define variable v-help-old-size as decimal       no-undo .
      318           define variable v-frame-width   as decimal       no-undo .
      319           define variable jj              as integer       no-undo .
      320           do
      321               on error undo, return error
      322               :
      323               assign
      324                   v-frame-width = frame trn-rsna:width - 0.3
      325                   fh            = frame trn-rsna:first-child
      326                   hh            = fh:first-child
      327                   ii            = 1
      328                   .
      329               do while valid-handle(hh):
      330                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      331                   do:
      332                       case lc(hh:name) :
      333                           when "b-help" then
      334                               do:
      335                                   hh:load-image-up("cmp/b-help.bmp":u) .
      336                                   hh:load-image-down("cmp/b-help.bmp":u) .
      337                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      338                                   hh:TOOLTIP = "Помощь" .
      339                                   v-help-old-x = hh:column .
      340                                   v-help-old-y = hh:row    .
      341                                   v-help-old-size = hh:width .
      342                                   hh:width-chars = 2.5 .
      343                               end.
      344                           when "b-print" then
      345                               do:
      346                                   hh:load-image("cmp/b-print.bmp":u) .
      347                                   hh:TOOLTIP = "Печать" .
      348                                   v-h[ii] = hh:handle .
      349                                   ii = ii + 1 .
      350                                   hh:width-chars = 3 .
      351                               end.
      352                           when "b-history" or
      353                           when "b-hist" then
      354                               do:
      355                                   hh:load-image("cmp/b-hist.bmp":u) .
      356                                   hh:TOOLTIP = "История" .
      357                                   v-h[ii] = hh:handle .
      358                                   ii = ii + 1 .
      359                                   hh:width-chars = 3 .
      360                               end.
      361                           when "b-sch" then
      362                               do:
      363                                   hh:load-image("cmp/b-sch.bmp":u) .
      364                                   hh:TOOLTIP = "Установка Фильтра" .
      365                                   v-h[ii] = hh:handle .
      366                                   ii = ii + 1 .
      367                                   hh:width-chars = 3 .
      368                               end.
      369                           when "b-hist-user" then
      370                               do:
      371                                   hh:load-image("cmp/b-hist.bmp":u) .
      372                                   hh:TOOLTIP = "История пользователя" .
      373                                   ii = ii + 1 .
      374                               end.
      375                       end case.
      376                   end.
      377                   hh = hh:next-sibling.
      378               end.
      379               b-help:column = v-frame-width - b-help:width-chars.
      380               jj = 0.
      381               repeat ii = 4 to 1 by -1 :
      382                   if valid-handle (v-h[ii] ) then
      383                   do:
      384                       jj  = jj + 1 .
      385                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      386                       v-h[ii]:row    = v-help-old-y .
      387                   end.
      388               end.
      389           end.
      390       end.
      391   end procedure.
      392   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   on F1 of frame trn-rsna anywhere do:
      394     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame trn-rsna. END.
      395     return no-apply.
      396   end.
      397   MAIN-BLOCK:
      398   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      399      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      400     define buffer buf_trn-reason for ub.trn-reason .
      401     assign
      402       frame trn-rsna :title = "Карточка основания (причины) создания документа  -- " + p-mode
      403       .
      404     create tt_trn-reason .
      405     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      406       assign
      407         tt_trn-reason.reason-code = dynamic-next-value( "s-trn-reason":U, "ub":U )
      408       .
      409     end.
      410     else do:
      411       case p-mode :
      412         when 'ИЗМЕНЕНИЕ':U then do:
      413           find first buf_trn-reason exclusive-lock
      414             where recid( buf_trn-reason ) = p-rid
      415             no-error .
      416         end.
      417         when 'ПРОСМОТР':U then do:
      418           find first buf_trn-reason no-lock
      419             where recid( buf_trn-reason ) = p-rid
      420             no-error.
      421         end.
      422       end case.
      423       if not available buf_trn-reason then do:
      424         message
      425           "Карточка основания (причины) создания документа не найдена!"
      426           view-as alert-box error.
      427         undo Main-Block, leave Main-Block.
      428       end.
      429       else do:
      430         buffer-copy buf_trn-reason to tt_trn-reason .
      431       end.
      432     end.
      433     RUN enable_UI.
      434     case p-mode :
      435       when 'ДОБАВЛЕНИЕ':U then do:
      436         enable
      437           tt_trn-reason.reason-code
      438           with frame trn-rsna.
      439       end.
      440       when 'ПРОСМОТР':U then do:
      441         disable
      442           all
      443           with frame trn-rsna.
      444         enable
      445           b-quit
      446           b-history
      447           with frame trn-rsna.
      448       end.
      449     end case.
      450     WAIT-FOR GO OF FRAME trn-rsna.
      451   END.
      452   for each tt_trn-reason
      453   :
      454     delete tt_trn-reason.
      455   end.
      456   RUN disable_UI.
      457   PROCEDURE disable_UI :
      458     HIDE FRAME trn-rsna.
      459   END PROCEDURE.
      460   PROCEDURE enable_UI :
      461     IF AVAILABLE tt_trn-reason THEN
      462       DISPLAY tt_trn-reason.reason-code tt_trn-reason.reason-name tt_trn-reason.PS
      463         WITH FRAME trn-rsna.
      464     ENABLE b-exit b-quit b-history b-help tt_trn-reason.reason-name
      465            tt_trn-reason.PS
      466         WITH FRAME trn-rsna.
      467     VIEW FRAME trn-rsna.
      468   END PROCEDURE.
