        1   define input  parameter p-doc-line-recid as recid no-undo.
        2   define input  parameter p-single-db      as logical no-undo.
        3   define input  parameter p-alcohol-prod   as logical no-undo.
        4   define output parameter p-par-type       as integer no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Выбор редактируемого параметра для утилиты изменения параметров прихода".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   DEFINE BUTTON b-cansel AUTO-END-KEY
      111        LABEL "Отмена"
      112        SIZE 10 BY 1
      113        BGCOLOR 8 .
      114   DEFINE BUTTON b-help
      115        LABEL "Помощь"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-ok AUTO-GO
      119        LABEL "Выбор"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE VARIABLE fi-artic AS CHARACTER FORMAT "X(256)":U INITIAL "1511947 орг 1313"
      123        LABEL "Артикул"
      124         VIEW-AS TEXT
      125        SIZE 29 BY .67
      126        FGCOLOR 4  NO-UNDO.
      127   DEFINE VARIABLE fi-doc-name AS CHARACTER FORMAT "X(256)":U INITIAL "491153-"
      128        LABEL "Документ"
      129         VIEW-AS TEXT
      130        SIZE 24 BY .67
      131        FGCOLOR 4  NO-UNDO.
      132   DEFINE VARIABLE rs-par-type AS INTEGER
      133        VIEW-AS RADIO-SET VERTICAL
      134        RADIO-BUTTONS
      135             "НДС поставщика", 1,
      136   "ГТД партии", 2,
      137   "Срок годности", 3,
      138   "Атрибуты алкогольной продукции", 4
      139        SIZE 45.5 BY 4.27 NO-UNDO.
      140   DEFINE FRAME Dialog-Frame
      141        rs-par-type AT ROW 4.47 COL 4 NO-LABEL
      142        b-ok AT ROW 10.87 COL 4.5
      143        b-cansel AT ROW 10.87 COL 15.5
      144        b-help AT ROW 10.87 COL 50.5
      145        fi-doc-name AT ROW 1.27 COL 10 COLON-ALIGNED
      146        fi-artic AT ROW 2.07 COL 10 COLON-ALIGNED
      147        " Доступные для изменения параметры" VIEW-AS TEXT
      148             SIZE 61.5 BY .67 AT ROW 3.67 COL 1.5
      149             BGCOLOR 3 FGCOLOR 15
      150        SPACE(0.99) SKIP(8.18)
      151       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      152            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      153            TITLE "Изменение параметров прихода"
      154            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cansel.
      155   ASSIGN
      156          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      157          FRAME Dialog-Frame:HIDDEN           = TRUE.
      158   ASSIGN
      159          rs-par-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      160   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      161   DO:
      162     APPLY "END-ERROR":U TO SELF.
      163   END.
      164   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      165   DO:
      166     assign frame Dialog-Frame rs-par-type.
      167     p-par-type = rs-par-type.
      168   END.
      169   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      170   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      171   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   on help of frame Dialog-Frame
      173   do:
      174     run gbl/app_help.p
      175       (input this-procedure :file-name
      176       ,input ''
      177       ,input ?
      178       ) no-error.
      179     if error-status :error then do:
      180       message
      181         "Ошибка при вызове помощи"
      182         error-status :get-message(1)
      183         view-as alert-box .
      184     end.
      185   end.
      186   run minbtn-set in this-procedure .
      187   on choose of b-help in frame Dialog-Frame
      188   do:
      189     apply "help":u to frame Dialog-Frame .
      190   end.
      191   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   procedure minbtn-set :
      193       do
      194           on error undo, return error return-value
      195           :
      196           define variable ii              as integer       no-undo .
      197           define variable fh              as widget-handle no-undo .
      198           define variable hh              as widget-handle no-undo .
      199           define variable v-h             as handle        extent 4 no-undo .
      200           define variable v-name-button   as character     no-undo .
      201           define variable v-help-old-x    as decimal       no-undo .
      202           define variable v-help-old-y    as decimal       no-undo .
      203           define variable v-help-old-size as decimal       no-undo .
      204           define variable v-frame-width   as decimal       no-undo .
      205           define variable jj              as integer       no-undo .
      206           do
      207               on error undo, return error
      208               :
      209               assign
      210                   v-frame-width = frame Dialog-Frame:width - 0.3
      211                   fh            = frame Dialog-Frame:first-child
      212                   hh            = fh:first-child
      213                   ii            = 1
      214                   .
      215               do while valid-handle(hh):
      216                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      217                   do:
      218                       case lc(hh:name) :
      219                           when "b-help" then
      220                               do:
      221                                   hh:load-image-up("cmp/b-help.bmp":u) .
      222                                   hh:load-image-down("cmp/b-help.bmp":u) .
      223                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      224                                   hh:TOOLTIP = "Помощь" .
      225                                   v-help-old-x = hh:column .
      226                                   v-help-old-y = hh:row    .
      227                                   v-help-old-size = hh:width .
      228                                   hh:width-chars = 2.5 .
      229                               end.
      230                           when "b-print" then
      231                               do:
      232                                   hh:load-image("cmp/b-print.bmp":u) .
      233                                   hh:TOOLTIP = "Печать" .
      234                                   v-h[ii] = hh:handle .
      235                                   ii = ii + 1 .
      236                                   hh:width-chars = 3 .
      237                               end.
      238                           when "b-history" or
      239                           when "b-hist" then
      240                               do:
      241                                   hh:load-image("cmp/b-hist.bmp":u) .
      242                                   hh:TOOLTIP = "История" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-sch" then
      248                               do:
      249                                   hh:load-image("cmp/b-sch.bmp":u) .
      250                                   hh:TOOLTIP = "Установка Фильтра" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-hist-user" then
      256                               do:
      257                                   hh:load-image("cmp/b-hist.bmp":u) .
      258                                   hh:TOOLTIP = "История пользователя" .
      259                                   ii = ii + 1 .
      260                               end.
      261                       end case.
      262                   end.
      263                   hh = hh:next-sibling.
      264               end.
      265               b-help:column = v-frame-width - b-help:width-chars.
      266               jj = 0.
      267               repeat ii = 4 to 1 by -1 :
      268                   if valid-handle (v-h[ii] ) then
      269                   do:
      270                       jj  = jj + 1 .
      271                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      272                       v-h[ii]:row    = v-help-old-y .
      273                   end.
      274               end.
      275           end.
      276       end.
      277   end procedure.
      278   MAIN-BLOCK:
      279   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      280      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      281     run MyEnable.
      282     WAIT-FOR GO OF FRAME Dialog-Frame.
      283   END.
      284   RUN disable_UI.
      285   PROCEDURE disable_UI :
      286     HIDE FRAME Dialog-Frame.
      287   END PROCEDURE.
      288   PROCEDURE enable_UI :
      289     DISPLAY rs-par-type fi-doc-name fi-artic
      290         WITH FRAME Dialog-Frame.
      291     ENABLE rs-par-type b-ok b-cansel b-help
      292         WITH FRAME Dialog-Frame.
      293     VIEW FRAME Dialog-Frame.
      294   END PROCEDURE.
      295   PROCEDURE MyEnable :
      296     define variable v-radio-buttons as character no-undo.
      297     define variable v-num-buttons   as integer   no-undo.
      298     define buffer buf_doc-line for ub.doc-line.
      299     find buf_doc-line no-lock where recid (buf_doc-line) = p-doc-line-recid no-error.
      300     if available buf_doc-line then do:
      301       assign
      302         fi-doc-name = buf_doc-line.doc-code
      303         fi-artic    = buf_doc-line.artic + " "
      304                     + buf_doc-line.prod-type + " "
      305                     + string(buf_doc-line.prod-code)
      306       .
      307     end.
      308     assign
      309       v-radio-buttons = (if p-single-db
      310                            then substitute ("&1,1":u, "НДС поставщика") + ","
      311                            else "")
      312                       + substitute ("&1,2":u, "ГТД партии") + ","
      313                       + substitute ("&1,3":u, "Срок годности")
      314                       + (if p-alcohol-prod
      315                            then "," + substitute ("&1,4":u, "Атрибуты алкогольной продукции")
      316                            else "")
      317       rs-par-type :radio-buttons in frame Dialog-Frame = v-radio-buttons
      318       v-num-buttons = rs-par-type :num-buttons in frame Dialog-Frame
      319       rs-par-type :height-chars  in frame Dialog-Frame = 1.07 * v-num-buttons
      320       .
      321     display fi-doc-name fi-artic rs-par-type
      322         with frame Dialog-Frame.
      323     enable rs-par-type b-ok b-cansel b-help
      324         with frame Dialog-Frame.
      325     view frame Dialog-Frame.
      326   END PROCEDURE.
