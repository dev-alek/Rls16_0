        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendpdfr.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/sendpdfr.p $":U .
       11   define variable vss-description as character no-undo init "".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define temp-table x_obj-group no-undo like ub.clients  .
       83   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       84   procedure metod-gop-obj :
       85     do
       86     on error undo, return error return-value
       87     :
       88   define input  parameter p-cntxt-db-num as integer   no-undo .
       89   define input  parameter p-gop-id       as integer   no-undo .
       90   define input  parameter p-gop-db-num   as integer   no-undo .
       91   define buffer buf1_clients for ub.clients  .
       92   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       93   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       94   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
       95   for each  x_obj-group : delete x_obj-group. end.
       96   if p-gop-id = 0 or p-gop-id = ?  then do:
       97      if p-cntxt-db-num = 0  then do:
       98           for each buf1_clients no-lock where
       99                   (buf1_clients.obj-type = 'маг':U  or
      100                    buf1_clients.obj-type = 'скл':U  )
      101                   and
      102                   buf1_clients.db-num >= 0  and
      103                   buf1_clients.stts = 0
      104                   :
      105             create x_obj-group .
      106             assign
      107               x_obj-group.obj-code   = buf1_clients.obj-code
      108               x_obj-group.obj-type   = buf1_clients.obj-type
      109               x_obj-group.obj-name   = buf1_clients.obj-name
      110               x_obj-group.db-num     = buf1_clients.db-num
      111             .
      112           end.
      113      end.
      114      else do:
      115           for each buf1_clients no-lock where
      116                   (buf1_clients.obj-type = 'маг':U  or
      117                    buf1_clients.obj-type = 'скл':U  ) and
      118                    buf1_clients.db-num = p-cntxt-db-num  and
      119                    buf1_clients.stts = 0
      120                   :
      121             create x_obj-group .
      122             assign
      123               x_obj-group.obj-code   = buf1_clients.obj-code
      124               x_obj-group.obj-type   = buf1_clients.obj-type
      125               x_obj-group.obj-name   = buf1_clients.obj-name
      126               x_obj-group.db-num     = buf1_clients.db-num
      127             .
      128           end.
      129      end.
      130   end.
      131   else do:
      132         for each buf_db-grp-obj-price  where
      133                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      134                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      135                 buf_db-grp-obj-price.stts = 0  no-lock :
      136           for each buf1_clients no-lock where
      137                  (buf1_clients.obj-type = 'маг':U  or
      138                   buf1_clients.obj-type = 'скл':U  ) and
      139                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      140                   buf1_clients.stts = 0
      141                   :
      142             create x_obj-group .
      143             assign
      144               x_obj-group.obj-code   = buf1_clients.obj-code
      145               x_obj-group.obj-type   = buf1_clients.obj-type
      146               x_obj-group.obj-name   = buf1_clients.obj-name
      147               x_obj-group.db-num     = buf1_clients.db-num
      148             .
      149           end.
      150         end.
      151       for each buf_host-grp-obj-price where
      152               buf_host-grp-obj-price.gop-id     = p-gop-id and
      153               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      154               buf_host-grp-obj-price.stts = 0
      155               no-lock :
      156         for each buf1_clients no-lock where
      157                (buf1_clients.obj-type = 'маг':U  or
      158                 buf1_clients.obj-type = 'скл':U  ) and
      159                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      160                 buf1_clients.stts = 0
      161                 :
      162             find first x_obj-group no-lock  where
      163                       x_obj-group.obj-code   = buf1_clients.obj-code and
      164                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      165             if not available  x_obj-group then   create x_obj-group .
      166             assign
      167               x_obj-group.obj-code   = buf1_clients.obj-code
      168               x_obj-group.obj-type   = buf1_clients.obj-type
      169               x_obj-group.obj-name   = buf1_clients.obj-name
      170               x_obj-group.db-num     = buf1_clients.db-num
      171             .
      172         end.
      173       end.
      174       for each buf_obj-grp-obj-price where
      175               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      176               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      177               buf_obj-grp-obj-price.stts = 0
      178               no-lock :
      179         for each buf1_clients no-lock where
      180                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      181                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      182                   buf1_clients.stts     = 0
      183                   :
      184             find first  x_obj-group no-lock  where
      185                         x_obj-group.obj-code   = buf1_clients.obj-code and
      186                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      187             if not available  x_obj-group then   create x_obj-group .
      188             assign
      189               x_obj-group.obj-code   = buf1_clients.obj-code
      190               x_obj-group.obj-type   = buf1_clients.obj-type
      191               x_obj-group.obj-name   = buf1_clients.obj-name
      192               x_obj-group.db-num     = buf1_clients.db-num
      193             .
      194         end.
      195       end.
      196   end.
      197   end.
      198   end procedure.
      199   procedure metod-obj-in-gop :
      200   define input  parameter p-curr-db-num as integer   no-undo .
      201   define input  parameter p-obj-type as character no-undo .
      202   define input  parameter p-obj-code as integer   no-undo .
      203   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      204     do
      205     on error undo, return error return-value
      206     :
      207       empty temp-table x_grp-obj-price.
      208       for each buf_grp-obj-price where
      209                buf_grp-obj-price.stts = 0
      210                no-lock :
      211                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      212                  for each x_obj-group where
      213                           x_obj-group.obj-type = p-obj-type and
      214                           x_obj-group.obj-code = p-obj-code :
      215                       create  x_grp-obj-price.
      216                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      217                  end.
      218       end.
      219     end.
      220   end procedure.
      221   procedure metod-delobj-usr :
      222   define input  parameter p-pdf-id  as integer   no-undo .
      223   define input  parameter p-pdf-db  as integer   no-undo .
      224   define input  parameter p-plt-id  as integer   no-undo .
      225   define input  parameter p-plt-db-num as integer   no-undo .
      226   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      227     do
      228     on error undo, return error return-value
      229     :
      230   for each buf_price-doc-forming-attr no-lock  where
      231            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      232            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      233            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      234            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      235            buf_price-doc-forming-attr.attr-code begins "obj" :
      236      for each x_obj-group  where
      237               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      238               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      239        delete x_obj-group.
      240      end.
      241   end.
      242     if not can-find (first x_obj-group) then do:
      243        return "nullobj" .
      244     end.
      245   end.
      246   end procedure.
      247   procedure metod-obj-pdf :
      248   define input  parameter p-cntxt-db-num as integer   no-undo .
      249   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      250   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      251   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      252   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      253   define buffer buf_price-list-type for ub.price-list-type  .
      254   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      255     do
      256     on error undo, return error return-value
      257     :
      258    for each  x_obj-group : delete x_obj-group. end.
      259    find first buf_price-list-type no-lock where
      260               buf_price-list-type.plt-id = p-plt-id and
      261               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      262   if error-status :error then return error return-value .
      263    find first buf_price-doc-forming no-lock where
      264               buf_price-doc-forming.plt-id     = p-plt-id and
      265               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      266               buf_price-doc-forming.pdf-id     = p-pdf-id and
      267               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      268               no-error .
      269   if error-status :error then return error return-value .
      270     run metod-gop-obj in this-procedure (
      271         p-cntxt-db-num,
      272         buf_price-list-type.gop-id ,
      273         buf_price-list-type.gop-db-num
      274         ) no-error .
      275     run metod-delobj-usr in this-procedure (
      276       buf_price-doc-forming.pdf-id ,
      277       buf_price-doc-forming.pdf-db ,
      278       buf_price-doc-forming.plt-id ,
      279       buf_price-doc-forming.plt-db-num
      280       ) no-error .
      281     end.
      282   end procedure.
      283   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   define  temp-table pdf-list no-undo like ub.price-doc-forming
      285   field to-del     as logical
      286   field order-num  as integer
      287   index pi  is primary unique plt-id plt-db-num pdf-id pdf-db
      288   index oi order-num
      289   .
      290   define variable pdf-action as character no-undo.
      291   define variable p-pdf-id like ub.price-doc-forming.pdf-id no-undo .
      292   define variable p-pdf-db like ub.price-doc-forming.pdf-db no-undo .
      293   define variable p-plt-id like ub.price-doc-forming.plt-id no-undo .
      294   define variable p-plt-db-num like ub.price-doc-forming.plt-db-num no-undo .
      295   define variable v-pdf-id like ub.price-doc-forming.pdf-id no-undo .
      296   define variable v-pdf-db like ub.price-doc-forming.pdf-db no-undo .
      297   define variable v-plt-id like ub.price-doc-forming.plt-id no-undo .
      298   define variable v-plt-db-num like ub.price-doc-forming.plt-db-num no-undo .
      299   define variable v-ii as integer no-undo .
      300   define variable v-del as logical no-undo .
      301   define buffer buf_price-doc-forming for ub.price-doc-forming.
      302   define buffer buf_cash-desk for ub.cash-desk.
      303   assign
      304   pdf-action = entry(1, p-parameter, chr(4))
      305   .
      306   case pdf-action :
      307     when "N" then do:
      308       do while p-pdf-id <> 0
      309       or v-ii = 0:
      310         v-pdf-id = 0.
      311         run sendnall_get-pdf in p-parent-handle (  input-output v-ii
      312                                          ,output v-plt-id
      313                                          ,output v-plt-db-num
      314                                          ,output v-pdf-id
      315                                          ,output v-pdf-db
      316                                          ,output v-del
      317                                          ) no-error.
      318         if not error-status:error then do:
      319           run fill-pdf in this-procedure (
      320                                      input v-plt-id
      321                                     ,input v-plt-db-num
      322                                     ,input v-pdf-id
      323                                     ,input v-pdf-db
      324                                     ,input (pdf-action = "D")
      325                                     ).
      326         end.
      327         else leave.
      328       end.
      329     end.
      330     when "U"
      331     or when "D"
      332     then do:
      333       assign
      334       p-plt-id = integer(entry(2, p-parameter, chr(4)))
      335       p-plt-db-num = integer(entry(3, p-parameter, chr(4)))
      336       p-pdf-id = integer(entry(4, p-parameter, chr(4)))
      337       p-pdf-db = integer(entry(5, p-parameter, chr(4)))
      338       no-error
      339       .
      340       if  error-status:error then return error substitute("Неверные значения параметров").
      341       find first buf_price-doc-forming no-lock where
      342               buf_price-doc-forming.plt-id = p-plt-id
      343           and buf_price-doc-forming.plt-db-num = p-plt-db-num
      344           and buf_price-doc-forming.pdf-id = p-pdf-id
      345           and buf_price-doc-forming.pdf-db = p-pdf-db
      346               no-error .
      347       if not available buf_price-doc-forming then return error substitute("Не найден ДНЦ &1 по БД &2 (ТПЛ &3 от БД &4)"
      348                                                           ,p-pdf-id
      349                                                           ,p-pdf-db
      350                                                           ,p-plt-id
      351                                                           ,p-plt-db-num).
      352       run fill-pdf in this-procedure (
      353                                  input p-plt-id
      354                                 ,input p-plt-db-num
      355                                 ,input p-pdf-id
      356                                 ,input p-pdf-db
      357                                 ,input (pdf-action = "D")
      358                                 ).
      359     end.
      360     otherwise do:
      361       return error substitute("Неизвестное значение параметра pdf-action=&1", pdf-action).
      362     end.
      363   end.
      364   for each pdf-list :
      365     empty temp-table X_obj-group.
      366     run metod-obj-pdf in this-procedure ( input g#db-num
      367                                         ,input pdf-list.pdf-id
      368                                         ,input pdf-list.pdf-db
      369                                         ,input pdf-list.plt-id
      370                                         ,input pdf-list.plt-db-num
      371                                         ) no-error.
      372     for each X_obj-group no-lock where
      373             X_obj-group.obj-type = 'маг':U
      374         and X_obj-group.db-num = g#db-num,
      375           first buf_cash-desk no-lock where
      376               buf_cash-desk.db-num = g#db-num
      377           AND buf_cash-desk.obj-code = X_obj-group.obj-code
      378           AND buf_cash-desk.cash-on = yes:
      379         run set-title in p-log-handle ( input substitute('Отсылка ДНЦ &1 на кассу', pdf-list.pdf-id)).
      380         run str/send-pdf.p (
      381                       input parparentproc
      382                       ,input p-parent-handle
      383                       ,input p-log-handle
      384                       ,input ("U":U + chr(4) +
      385                             string(pdf-list.plt-id) + chr(4)  +
      386                             string(pdf-list.plt-db-num) + chr(4) +
      387                             string(pdf-list.pdf-id) + chr(4)  +
      388                             string(pdf-list.pdf-db) + chr(4) +
      389                             string(X_obj-group.obj-code))
      390                         ) no-error .
      391         if error-status:error then
      392         return error substitute( "ошибка при отправке ДНЦ на кассу по магазину &1&2&3&2&4"
      393                                 , X_obj-group.obj-code
      394                                 , chr(10)
      395                                 , error-status:get-message(1)
      396                                 , return-value
      397                                 ).
      398     end.
      399   end.
      400   procedure fill-pdf :
      401   define input parameter p-plt-id as integer no-undo .
      402   define input parameter p-plt-db-num as integer no-undo .
      403   define input parameter p-pdf-id as integer no-undo .
      404   define input parameter p-pdf-db-num as integer no-undo .
      405   define input parameter p-del as logical no-undo .
      406   define buffer buf_pdf-list for pdf-list.
      407   do
      408   on error undo, return error
      409   :
      410     find first pdf-list where
      411              pdf-list.plt-id = p-plt-id
      412          and pdf-list.plt-db-num = p-plt-db-num
      413          and pdf-list.pdf-id = p-pdf-id
      414          and pdf-list.pdf-db = p-pdf-db-num no-error.
      415     if not available pdf-list then do:
      416       find last buf_pdf-list use-index oi no-error.
      417       create pdf-list.
      418       assign
      419       pdf-list.plt-id = p-plt-id
      420       pdf-list.plt-db-num = p-plt-db-num
      421       pdf-list.pdf-id = p-pdf-id
      422       pdf-list.pdf-db = p-pdf-db-num
      423       pdf-list.to-del = p-del
      424       pdf-list.order-num = (if available buf_pdf-list then buf_pdf-list.order-num + 1 else 1)
      425       .
      426       release pdf-list.
      427     end.
      428   end.
      429   end procedure.
