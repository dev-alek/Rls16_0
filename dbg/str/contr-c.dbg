      950   Filter-Block:
      951     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
      952        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
      953        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
      954       run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
      955       RUN OpenBr(yes, no, '':U).
      956     end.
      957   END.
      958   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      959   DO:
      960     if ( available X_c-contract ) AND ( p-rid-list = "" ) then  p-rid-list = string( recid( X_c-contract ) ) .
      961   END.
      962   ON RETURN OF brc-contract IN FRAME Dialog-Frame
      963   or MOUSE-SELECT-DBLCLICK OF brc-contract IN FRAME Dialog-Frame
      964   DO:
      965     if b-sel:sensitive in frame Dialog-Frame then
      966       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
      967       else                     apply "choose" to b-sel in frame Dialog-Frame.
      968     else if b-lookup:sensitive then apply "choose" to b-lookup in frame Dialog-Frame.
      969   END.
      970   ON VALUE-CHANGED OF brc-contract IN FRAME Dialog-Frame
      971   DO:
      972     run proc-view-changes in this-procedure no-error.
      973   END.
      974   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      975   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      976   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   on help of frame Dialog-Frame
      978   do:
      979     run gbl/app_help.p
      980       (input this-procedure :file-name
      981       ,input ''
      982       ,input ?
      983       ) no-error.
      984     if error-status :error then do:
      985       message
      986         "Ошибка при вызове помощи"
      987         error-status :get-message(1)
      988         view-as alert-box .
      989     end.
      990   end.
      991   run minbtn-set in this-procedure .
      992   on choose of b-help in frame Dialog-Frame
      993   do:
      994     apply "help":u to frame Dialog-Frame .
      995   end.
      996   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   procedure minbtn-set :
      998       do
      999           on error undo, return error return-value
     1000           :
     1001           define variable ii              as integer       no-undo .
     1002           define variable fh              as widget-handle no-undo .
     1003           define variable hh              as widget-handle no-undo .
     1004           define variable v-h             as handle        extent 4 no-undo .
     1005           define variable v-name-button   as character     no-undo .
     1006           define variable v-help-old-x    as decimal       no-undo .
     1007           define variable v-help-old-y    as decimal       no-undo .
     1008           define variable v-help-old-size as decimal       no-undo .
     1009           define variable v-frame-width   as decimal       no-undo .
     1010           define variable jj              as integer       no-undo .
     1011           do
     1012               on error undo, return error
     1013               :
     1014               assign
     1015                   v-frame-width = frame Dialog-Frame:width - 0.3
     1016                   fh            = frame Dialog-Frame:first-child
     1017                   hh            = fh:first-child
     1018                   ii            = 1
     1019                   .
     1020               do while valid-handle(hh):
     1021                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1022                   do:
     1023                       case lc(hh:name) :
     1024                           when "b-help" then
     1025                               do:
     1026                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1027                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1028                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1029                                   hh:TOOLTIP = "Помощь" .
     1030                                   v-help-old-x = hh:column .
     1031                                   v-help-old-y = hh:row    .
     1032                                   v-help-old-size = hh:width .
     1033                                   hh:width-chars = 2.5 .
     1034                               end.
     1035                           when "b-print" then
     1036                               do:
     1037                                   hh:load-image("cmp/b-print.bmp":u) .
     1038                                   hh:TOOLTIP = "Печать" .
     1039                                   v-h[ii] = hh:handle .
     1040                                   ii = ii + 1 .
     1041                                   hh:width-chars = 3 .
     1042                               end.
     1043                           when "b-history" or
     1044                           when "b-hist" then
     1045                               do:
     1046                                   hh:load-image("cmp/b-hist.bmp":u) .
     1047                                   hh:TOOLTIP = "История" .
     1048                                   v-h[ii] = hh:handle .
     1049                                   ii = ii + 1 .
     1050                                   hh:width-chars = 3 .
     1051                               end.
     1052                           when "b-sch" then
     1053                               do:
     1054                                   hh:load-image("cmp/b-sch.bmp":u) .
     1055                                   hh:TOOLTIP = "Установка Фильтра" .
     1056                                   v-h[ii] = hh:handle .
     1057                                   ii = ii + 1 .
     1058                                   hh:width-chars = 3 .
     1059                               end.
     1060                           when "b-hist-user" then
     1061                               do:
     1062                                   hh:load-image("cmp/b-hist.bmp":u) .
     1063                                   hh:TOOLTIP = "История пользователя" .
     1064                                   ii = ii + 1 .
     1065                               end.
     1066                       end case.
     1067                   end.
     1068                   hh = hh:next-sibling.
     1069               end.
     1070               b-help:column = v-frame-width - b-help:width-chars.
     1071               jj = 0.
     1072               repeat ii = 4 to 1 by -1 :
     1073                   if valid-handle (v-h[ii] ) then
     1074                   do:
     1075                       jj  = jj + 1 .
     1076                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1077                       v-h[ii]:row    = v-help-old-y .
     1078                   end.
     1079               end.
     1080           end.
     1081       end.
     1082   end procedure.
     1083   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1084   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1085   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1086   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1087   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1088   define variable v-diasize-current-frame-height as decimal   no-undo .
     1089   define variable v-diasize-change-size          as logical   no-undo .
     1090   define variable v-diasize-resize-button        as handle    no-undo .
     1091   define variable v-diasize-wndmax               as logical   no-undo .
     1092   define variable v-diasize-wndstore             as logical   no-undo .
     1093   define variable v-diasize-proc-name            as character no-undo .
     1094   define variable v-diasize-browse-handle        as handle    no-undo .
     1095   define variable v-diasize-browse-number        as integer   no-undo .
     1096   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1097   define temp-table temp-diasize-handle no-undo
     1098     field handle-value  as handle
     1099     field save-position as decimal
     1100     index xpk is primary unique handle-value
     1101     .
     1102   define temp-table temp-browse-handle no-undo
     1103     field browse-type   as character
     1104     field browse-number as integer
     1105     field browse-handle as handle
     1106     field original-size as decimal
     1107     index xpk is primary unique browse-type browse-number
     1108     index xie browse-type browse-handle
     1109   .
     1110   procedure diasize_change-height :
     1111     define input  parameter p-change-value  as decimal   no-undo .
     1112     define input  parameter p-move-resize   as logical   no-undo .
     1113     define variable v-field-group-handle    as handle    no-undo .
     1114     define variable v-object-handle         as handle    no-undo .
     1115     define variable v-frame-height          as decimal   no-undo .
     1116     define variable v-frame-virtual-height  as decimal   no-undo .
     1117     define variable v-browse-height         as decimal   no-undo .
     1118     define variable v-window-height         as decimal   no-undo .
     1119     define variable v-window-virtual-height as decimal   no-undo .
     1120     define variable v-change-sign           as integer   no-undo .
     1121     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1122     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1123     if p-change-value > 0
     1124     then do:
     1125       if frame Dialog-Frame :height + p-change-value
     1126           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1127       then do:
     1128         assign
     1129           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1130                           - (frame Dialog-Frame :height-chars)
     1131         .
     1132         if p-change-value <= 0
     1133         then do:
     1134           run diasize_position-resize-button in this-procedure .
     1135           return .
     1136         end.
     1137       end.
     1138     end.
     1139     if p-change-value < 0
     1140     then do:
     1141       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1142       then do:
     1143         assign
     1144           p-change-value = v-diasize-orig-frame-height
     1145                          - (frame Dialog-Frame :height-chars)
     1146         .
     1147         if p-change-value >= 0
     1148         then do:
     1149           run diasize_position-resize-button in this-procedure .
     1150           return .
     1151         end.
     1152       end.
     1153     end.
     1154     if p-change-value >= 0
     1155     then do:
     1156       assign
     1157         v-change-sign = 1
     1158       .
     1159     end.
     1160     else do:
     1161       assign
     1162         v-change-sign = -1
     1163       .
     1164     end.
     1165     assign
     1166       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1167     .
     1168     if p-change-value = 0
     1169     then do:
     1170       run diasize_position-resize-button in this-procedure .
     1171       return .
     1172     end.
     1173     move_block:
     1174     do
     1175     on error undo move_block, retry move_block
     1176     :
     1177       if retry
     1178       then do:
     1179         do
     1180         on error undo move_block, leave move_block
     1181         :
     1182           if p-change-value > 0
     1183           then do:
     1184             for each buf_temp-diasize-handle
     1185             on error undo, next
     1186             :
     1187               assign
     1188                 v-object-handle = buf_temp-diasize-handle.handle-value
     1189               .
     1190               if v-object-handle <> v-diasize-resize-button
     1191               then do:
     1192                 assign
     1193                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1194                 .
     1195               end.
     1196             end.
     1197             assign
     1198               v-diasize-browse-handle :height = v-browse-height
     1199             .
     1200             for each buf_temp-browse-handle
     1201               where buf_temp-browse-handle.browse-type = 'height':u
     1202             on error undo, next
     1203             :
     1204               assign
     1205                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1206               .
     1207             end.
     1208             assign
     1209               frame Dialog-Frame :height = v-frame-height
     1210             .
     1211             if frame Dialog-Frame :scrollable = true
     1212             then do:
     1213               assign
     1214                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1215               .
     1216             end.
     1217             run diasize_position-resize-button in this-procedure .
     1218           end.
     1219           else do:
     1220             if frame Dialog-Frame :scrollable = true
     1221             then do:
     1222               assign
     1223                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1224               .
     1225             end.
     1226             assign
     1227               frame Dialog-Frame :height = v-frame-height
     1228             .
     1229             assign
     1230               v-diasize-browse-handle :height = v-browse-height
     1231             .
     1232             for each buf_temp-browse-handle
     1233               where buf_temp-browse-handle.browse-type = 'height':u
     1234             on error undo, next
     1235             :
     1236               assign
     1237                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1238               .
     1239             end.
     1240             for each buf_temp-diasize-handle
     1241             on error undo, next
     1242             :
     1243               assign
     1244                 v-object-handle = buf_temp-diasize-handle.handle-value
     1245               .
     1246               if v-object-handle <> v-diasize-resize-button
     1247               then do:
     1248                 assign
     1249                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1250                 .
     1251               end.
     1252             end.
     1253             run diasize_position-resize-button in this-procedure .
     1254           end.
     1255           assign
     1256             v-diasize-change-size = false
     1257           .
     1258           leave move_block .
     1259         end.
     1260       end.
     1261       assign
     1262         v-diasize-need-full-display = true
     1263       .
     1264       if v-diasize-change-size = false
     1265       then do:
     1266         assign
     1267           v-diasize-change-size = true
     1268         .
     1269       end.
     1270       else do:
     1271         return .
     1272       end.
     1273       assign
     1274         v-frame-height = frame Dialog-Frame :height
     1275         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1276         v-browse-height = v-diasize-browse-handle :height
     1277       .
     1278       for each buf_temp-browse-handle
     1279         where buf_temp-browse-handle.browse-type = 'height':u
     1280       :
     1281         assign
     1282           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1283         .
     1284       end.
     1285       for each buf_temp-diasize-handle
     1286       :
     1287         delete buf_temp-diasize-handle .
     1288       end.
     1289       assign
     1290         v-field-group-handle = frame Dialog-Frame :first-child
     1291       .
     1292       do while valid-handle(v-field-group-handle)
     1293       :
     1294         assign
     1295           v-object-handle = v-field-group-handle :first-child
     1296         .
     1297         do while valid-handle(v-object-handle)
     1298         :
     1299           if  v-object-handle <> v-diasize-browse-handle :handle
     1300           and can-query(v-object-handle, "row")
     1301           and can-query(v-object-handle, "height")
     1302           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1303           then do:
     1304             find first buf_temp-browse-handle
     1305               where buf_temp-browse-handle.browse-type   = 'height':u
     1306                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1307               no-error .
     1308             if available buf_temp-browse-handle
     1309             then do:
     1310             end.
     1311             else do:
     1312               create buf_temp-diasize-handle .
     1313               assign
     1314                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1315                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1316               .
     1317             end.
     1318           end.
     1319           assign
     1320             v-object-handle = v-object-handle :next-sibling
     1321           .
     1322         end.
     1323         assign
     1324           v-field-group-handle = v-field-group-handle :next-sibling
     1325         .
     1326       end.
     1327       do with frame Dialog-Frame
     1328       :
     1329         hide v-diasize-resize-button .
     1330         assign
     1331           v-diasize-resize-button :row    = 1
     1332           v-diasize-resize-button :column = 1
     1333         .
     1334       end.
     1335       if p-change-value > 0
     1336       then do:
     1337         if frame Dialog-Frame :scrollable = true
     1338         then do:
     1339           assign
     1340             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1341             no-error .
     1342           if error-status :error
     1343           or error-status :get-message(1) <> ""
     1344           then do:
     1345             undo move_block, retry move_block .
     1346           end.
     1347         end.
     1348         assign
     1349           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1350           no-error .
     1351         if error-status :error
     1352         or error-status :get-message(1) <> ""
     1353         then do:
     1354           undo move_block, retry move_block .
     1355         end.
     1356         assign
     1357           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1358           no-error .
     1359         if error-status :error
     1360         or error-status :get-message(1) <> ""
     1361         then do:
     1362           undo move_block, retry move_block .
     1363         end.
     1364         for each buf_temp-browse-handle
     1365           where buf_temp-browse-handle.browse-type = 'height':u
     1366         on error undo move_block, retry move_block
     1367         :
     1368           assign
     1369             buf_temp-browse-handle.browse-handle :height
     1370               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1371             no-error .
     1372           if error-status :error
     1373           or error-status :get-message(1) <> ""
     1374           then do:
     1375             undo move_block, retry move_block .
     1376           end.
     1377         end.
     1378         for each buf_temp-diasize-handle
     1379         on error undo move_block, retry move_block
     1380         :
     1381           assign
     1382             v-object-handle = buf_temp-diasize-handle.handle-value
     1383           .
     1384           if v-object-handle <> v-diasize-resize-button
     1385           then do:
     1386             assign
     1387               v-object-handle :row = v-object-handle :row + p-change-value
     1388               no-error .
     1389             if error-status :error
     1390             or error-status :get-message(1) <> ""
     1391             then do:
     1392               undo move_block, retry move_block .
     1393             end.
     1394           end.
     1395         end.
     1396       end.
     1397       else do:
     1398         for each buf_temp-diasize-handle
     1399         on error undo move_block, retry move_block
     1400         :
     1401           assign
     1402             v-object-handle = buf_temp-diasize-handle.handle-value
     1403           .
     1404           if v-object-handle <> v-diasize-resize-button
     1405           then do:
     1406             assign
     1407               v-object-handle :row = v-object-handle :row + p-change-value
     1408               no-error .
     1409             if error-status :error
     1410             or error-status :get-message(1) <> ""
     1411             then do:
     1412               undo move_block, retry move_block .
     1413             end.
     1414           end.
     1415         end.
     1416         assign
     1417           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1418           no-error .
     1419         if error-status :error
     1420         or error-status :get-message(1) <> ""
     1421         then do:
     1422           undo move_block, retry move_block .
     1423         end.
     1424         for each buf_temp-browse-handle
     1425           where buf_temp-browse-handle.browse-type = 'height':u
     1426         on error undo move_block, retry move_block
     1427         :
     1428           assign
     1429             buf_temp-browse-handle.browse-handle :height
     1430               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1431             no-error .
     1432           if error-status :error
     1433           or error-status :get-message(1) <> ""
     1434           then do:
     1435             undo move_block, retry move_block .
     1436           end.
     1437         end.
     1438         assign
     1439           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1440           no-error .
     1441         if error-status :error
     1442         or error-status :get-message(1) <> ""
     1443         then do:
     1444           undo move_block, retry move_block .
     1445         end.
     1446         if frame Dialog-Frame :scrollable = true
     1447         then do:
     1448           assign
     1449             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1450             no-error .
     1451           if error-status :error
     1452           or error-status :get-message(1) <> ""
     1453           then do:
     1454             undo move_block, retry move_block .
     1455           end.
     1456         end.
     1457       end.
     1458       if p-move-resize = true
     1459       then do:
     1460         run diasize_position-resize-button in this-procedure .
     1461       end.
     1462       if v-diasize-wndstore = true
     1463       then do:
     1464         if connected("ub") = true
     1465         then do:
     1466           define variable v-cntxt-db-num        as integer   no-undo .
     1467           define variable v-cntxt-userid        as character no-undo .
     1468           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1469                                             , OUTPUT v-cntxt-userid
     1470                                             ) .
     1471           run gbl/wndsizew.p
     1472             (input  v-cntxt-db-num
     1473             ,input  v-cntxt-userid
     1474             ,input  v-diasize-proc-name
     1475             ,input  'height':u
     1476             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1477             ) .
     1478         end.
     1479       end.
     1480     end.
     1481     assign
     1482       v-diasize-change-size = false
     1483     .
     1484   end procedure.
     1485   procedure diasize_set-height :
     1486     define input  parameter p-new-height  as decimal   no-undo .
     1487     define input  parameter p-move-resize as logical   no-undo .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       run diasize_change-height in this-procedure
     1492         (input  (p-new-height - frame Dialog-Frame :height)
     1493         ,input  p-move-resize
     1494         ) .
     1495     end.
     1496   end procedure.
     1497   procedure diasize_change-width :
     1498     define input  parameter p-change-value as decimal   no-undo .
     1499     define input  parameter p-move-resize  as logical   no-undo .
     1500     define variable v-field-group-handle   as handle    no-undo .
     1501     define variable v-object-handle        as handle    no-undo .
     1502     define variable v-frame-width          as decimal   no-undo .
     1503     define variable v-frame-virtual-width  as decimal   no-undo .
     1504     define variable v-browse-width         as decimal   no-undo .
     1505     define variable v-window-width         as decimal   no-undo .
     1506     define variable v-window-virtual-width as decimal   no-undo .
     1507     define variable v-change-sign          as integer   no-undo .
     1508     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1509     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1510     if p-change-value > 0
     1511     then do:
     1512       if frame Dialog-Frame :width + p-change-value >
     1513           session :width-chars
     1514       then do:
     1515         assign
     1516           p-change-value = session :width-chars - frame Dialog-Frame :width
     1517         .
     1518         if p-change-value <= 0
     1519         then do:
     1520           run diasize_position-resize-button in this-procedure .
     1521           return .
     1522         end.
     1523       end.
     1524     end.
     1525     if p-change-value < 0
     1526     then do:
     1527       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1528       then do:
     1529         assign
     1530           p-change-value = v-diasize-orig-frame-width
     1531                          - frame Dialog-Frame :width
     1532         .
     1533         if p-change-value >= 0
     1534         then do:
     1535           run diasize_position-resize-button in this-procedure .
     1536           return .
     1537         end.
     1538       end.
     1539     end.
     1540     if p-change-value >= 0
     1541     then do:
     1542       assign
     1543         v-change-sign = 1
     1544       .
     1545     end.
     1546     else do:
     1547       assign
     1548         v-change-sign = -1
     1549       .
     1550     end.
     1551     assign
     1552       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1553     .
     1554     if p-change-value = 0
     1555     then do:
     1556       run diasize_position-resize-button in this-procedure .
     1557       return .
     1558     end.
     1559     move_block:
     1560     do
     1561     on error undo move_block, leave move_block
     1562     :
     1563       if retry
     1564       then do:
     1565         do
     1566         on error undo move_block, leave move_block
     1567         :
     1568           if p-change-value > 0
     1569           then do:
     1570             for each buf_temp-diasize-handle
     1571             on error undo, next
     1572             :
     1573               assign
     1574                 v-object-handle = buf_temp-diasize-handle.handle-value
     1575               .
     1576               if v-object-handle <> v-diasize-resize-button
     1577               then do:
     1578                 assign
     1579                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1580                 .
     1581               end.
     1582             end.
     1583             assign
     1584               v-diasize-browse-handle :width = v-browse-width
     1585             .
     1586             for each buf_temp-browse-handle
     1587               where buf_temp-browse-handle.browse-type = 'width':u
     1588             on error undo, next
     1589             :
     1590               assign
     1591                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1592               .
     1593             end.
     1594             assign
     1595               frame Dialog-Frame :width = v-frame-width
     1596             .
     1597             if frame Dialog-Frame :scrollable = true
     1598             then do:
     1599               assign
     1600                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1601               .
     1602             end.
     1603             run diasize_position-resize-button in this-procedure .
     1604           end.
     1605           else do:
     1606             if frame Dialog-Frame :scrollable = true
     1607             then do:
     1608               assign
     1609                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1610               .
     1611             end.
     1612             assign
     1613               frame Dialog-Frame :width = v-frame-width
     1614             .
     1615             for each buf_temp-browse-handle
     1616               where buf_temp-browse-handle.browse-type = 'width':u
     1617             on error undo, next
     1618             :
     1619               assign
     1620                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1621               .
     1622             end.
     1623             assign
     1624               v-diasize-browse-handle :width = v-browse-width
     1625             .
     1626             for each buf_temp-diasize-handle
     1627             on error undo, next
     1628             :
     1629               assign
     1630                 v-object-handle = buf_temp-diasize-handle.handle-value
     1631               .
     1632               if v-object-handle <> v-diasize-resize-button
     1633               then do:
     1634                 assign
     1635                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1636                 .
     1637               end.
     1638             end.
     1639             run diasize_position-resize-button in this-procedure .
     1640           end.
     1641           assign
     1642             v-diasize-change-size = false
     1643           .
     1644           leave move_block .
     1645         end.
     1646       end.
     1647       assign
     1648         v-diasize-need-full-display = true
     1649       .
     1650       if v-diasize-change-size = false
     1651       then do:
     1652         assign
     1653           v-diasize-change-size = true
     1654         .
     1655       end.
     1656       else do:
     1657         return .
     1658       end.
     1659       assign
     1660         v-frame-width = frame Dialog-Frame :width
     1661         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1662         v-browse-width = v-diasize-browse-handle :width
     1663       .
     1664       for each buf_temp-browse-handle
     1665         where buf_temp-browse-handle.browse-type = 'width':u
     1666       :
     1667         assign
     1668           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1669         .
     1670       end.
     1671       for each buf_temp-diasize-handle
     1672       :
     1673         delete buf_temp-diasize-handle .
     1674       end.
     1675       assign
     1676         v-field-group-handle = frame Dialog-Frame :first-child
     1677       .
     1678       do while valid-handle(v-field-group-handle)
     1679       :
     1680         assign
     1681           v-object-handle = v-field-group-handle :first-child
     1682         .
     1683         do while valid-handle(v-object-handle)
     1684         :
     1685           if  v-object-handle <> v-diasize-browse-handle :handle
     1686           and v-object-handle <> v-diasize-resize-button
     1687           and can-query(v-object-handle, "row")
     1688           and can-query(v-object-handle, "height")
     1689           and ( v-object-handle :col + v-object-handle :width
     1690                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1691               )
     1692           then do:
     1693             find first buf_temp-browse-handle
     1694               where buf_temp-browse-handle.browse-type   = 'width':u
     1695                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1696               no-error .
     1697             if available buf_temp-browse-handle
     1698             then do:
     1699             end.
     1700             else do:
     1701               create buf_temp-diasize-handle .
     1702               assign
     1703                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1704                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1705               .
     1706             end.
     1707           end.
     1708           assign
     1709             v-object-handle = v-object-handle :next-sibling
     1710           .
     1711         end.
     1712         assign
     1713           v-field-group-handle = v-field-group-handle :next-sibling
     1714         .
     1715       end.
     1716       do with frame Dialog-Frame
     1717       :
     1718         hide v-diasize-resize-button .
     1719         v-diasize-resize-button :row = 1.
     1720         v-diasize-resize-button :column = 1.
     1721       end.
     1722       if p-change-value > 0
     1723       then do:
     1724         if frame Dialog-Frame :scrollable = true
     1725         then do:
     1726           assign
     1727             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1728             no-error .
     1729           if error-status :error
     1730           or error-status :get-message(1) <> ""
     1731           then do:
     1732             undo move_block, retry move_block.
     1733           end.
     1734         end.
     1735         assign
     1736           frame Dialog-Frame :width = v-frame-width + p-change-value
     1737           no-error .
     1738         if error-status :error
     1739         or error-status :get-message(1) <> ""
     1740         then do:
     1741           undo move_block, retry move_block.
     1742         end.
     1743         assign
     1744           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1745         no-error .
     1746         if error-status :error
     1747         or error-status :get-message(1) <> ""
     1748         then do:
     1749           undo move_block, retry move_block.
     1750         end.
     1751         for each buf_temp-browse-handle
     1752           where buf_temp-browse-handle.browse-type = 'width':u
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             buf_temp-browse-handle.browse-handle :width
     1757               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1758             no-error .
     1759           if error-status :error
     1760           or error-status :get-message(1) <> ""
     1761           then do:
     1762             undo move_block, retry move_block .
     1763           end.
     1764         end.
     1765         for each buf_temp-diasize-handle
     1766         on error undo move_block, retry move_block
     1767         :
     1768           assign
     1769             v-object-handle = buf_temp-diasize-handle.handle-value
     1770           .
     1771           if v-object-handle <> v-diasize-resize-button
     1772           then do:
     1773             assign
     1774               v-object-handle :col = v-object-handle :col + p-change-value
     1775               no-error .
     1776             if error-status :error
     1777             or error-status :get-message(1) <> ""
     1778             then do:
     1779               undo move_block, retry move_block .
     1780             end.
     1781           end.
     1782         end.
     1783       end.
     1784       else do:
     1785         for each buf_temp-diasize-handle
     1786         on error undo move_block, retry move_block
     1787         :
     1788           assign
     1789             v-object-handle = buf_temp-diasize-handle.handle-value
     1790           .
     1791           if v-object-handle <> v-diasize-resize-button
     1792           then do:
     1793             assign
     1794               v-object-handle :col = v-object-handle :col + p-change-value
     1795               no-error .
     1796             if error-status :error
     1797             or error-status :get-message(1) <> ""
     1798             then do:
     1799               undo move_block, retry move_block .
     1800             end.
     1801           end.
     1802         end.
     1803         for each buf_temp-browse-handle
     1804           where buf_temp-browse-handle.browse-type = 'width':u
     1805         on error undo move_block, retry move_block
     1806         :
     1807           assign
     1808             buf_temp-browse-handle.browse-handle :width
     1809               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1810             no-error .
     1811           if error-status :error
     1812           or error-status :get-message(1) <> ""
     1813           then do:
     1814             undo move_block, retry move_block .
     1815           end.
     1816         end.
     1817         assign
     1818           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1819           no-error .
     1820         if error-status :error
     1821         or error-status :get-message(1) <> ""
     1822         then do:
     1823           undo move_block, retry move_block.
     1824         end.
     1825         assign
     1826           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1827         no-error .
     1828         if error-status :error
     1829         or error-status :get-message(1) <> ""
     1830         then do:
     1831           undo move_block, retry move_block.
     1832         end.
     1833         if frame Dialog-Frame :scrollable = true
     1834         then do:
     1835           assign
     1836             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1837           no-error .
     1838           if error-status :error
     1839           or error-status :get-message(1) <> ""
     1840           then do:
     1841             undo move_block, retry move_block.
     1842           end.
     1843         end.
     1844       end.
     1845       if p-move-resize
     1846       then do:
     1847         run diasize_position-resize-button in this-procedure .
     1848       end.
     1849       if v-diasize-wndstore = true
     1850       then do:
     1851         if connected("ub") = true
     1852         then do:
     1853           define variable v-cntxt-db-num        as integer   no-undo .
     1854           define variable v-cntxt-userid        as character no-undo .
     1855           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1856                                             , OUTPUT v-cntxt-userid
     1857                                             ) .
     1858           run gbl/wndsizew.p
     1859             (input  v-cntxt-db-num
     1860             ,input  v-cntxt-userid
     1861             ,input  v-diasize-proc-name
     1862             ,input  'width':u
     1863             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1864             ) .
     1865         end.
     1866       end.
     1867     end.
     1868     assign
     1869       v-diasize-change-size = false
     1870     .
     1871   end procedure.
     1872   procedure diasize_set-width :
     1873     define input  parameter p-new-width  as decimal   no-undo .
     1874     define input  parameter p-move-resize as logical   no-undo .
     1875     do
     1876     on error undo, return error return-value
     1877     :
     1878       run diasize_change-width in this-procedure
     1879         (input  (p-new-width - frame Dialog-Frame :width)
     1880         ,input  p-move-resize
     1881         ) .
     1882     end.
     1883   end procedure.
     1884   procedure diasize_position-resize-button :
     1885     do with frame Dialog-Frame
     1886     :
     1887       hide v-diasize-resize-button .
     1888       assign
     1889         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1890                     - 1
     1891                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1892         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1893                     - 1
     1894                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1895       .
     1896       view v-diasize-resize-button .
     1897     end.
     1898   end procedure.
     1899   on alt-right anywhere
     1900   do:
     1901     run diasize_change-width in this-procedure
     1902       (input 1
     1903       ,input true
     1904       ) .
     1905     return no-apply .
     1906   end.
     1907   on alt-left anywhere
     1908   do:
     1909     run diasize_change-width in this-procedure
     1910       (input -1
     1911       ,input true
     1912       ) .
     1913     return no-apply .
     1914   end.
     1915   on alt-down anywhere
     1916   do:
     1917     run diasize_change-height in this-procedure
     1918       (input 1
     1919       ,input true
     1920       ) .
     1921     return no-apply .
     1922   end.
     1923   on alt-up anywhere
     1924   do:
     1925     run diasize_change-height in this-procedure
     1926       (input -1
     1927       ,input true
     1928       ) .
     1929     return no-apply .
     1930   end.
     1931   on alt-enter of frame Dialog-Frame
     1932   do:
     1933     run diasize_maximize in this-procedure
     1934       (input  ?
     1935       ).
     1936     return no-apply .
     1937   end.
     1938   procedure diasize_end-move :
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       define variable v-row-delta as decimal   no-undo .
     1943       define variable v-col-delta as decimal   no-undo .
     1944       define variable v-new-row as decimal   no-undo .
     1945       define variable v-new-col as decimal   no-undo .
     1946       assign
     1947         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1948         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1949       .
     1950       assign
     1951         v-row-delta = v-new-row - frame Dialog-Frame :height
     1952         v-col-delta = v-new-col - frame Dialog-Frame :width
     1953       .
     1954       run diasize_change-height in this-procedure
     1955         (input v-row-delta
     1956         ,input true
     1957         ) .
     1958       run diasize_change-width in this-procedure
     1959         (input v-col-delta
     1960         ,input true
     1961         ) .
     1962     end.
     1963   end procedure.
     1964   procedure diasize_maximize :
     1965     define input  parameter p-action as logical   no-undo .
     1966     do
     1967     on error undo, return error return-value
     1968     :
     1969       if p-action = ?
     1970       then do:
     1971         if v-diasize-need-maximize = true
     1972         then do:
     1973           assign
     1974             p-action = true
     1975           .
     1976         end.
     1977         else do:
     1978           assign
     1979             p-action = false
     1980           .
     1981         end.
     1982       end.
     1983       if p-action = true
     1984       then do:
     1985         run diasize_change-height in this-procedure
     1986           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1987               - frame Dialog-Frame :height-chars
     1988           ,input true
     1989           ) .
     1990         run diasize_change-width in this-procedure
     1991           (input session :width-chars
     1992               - frame Dialog-Frame :width-chars
     1993           ,input true
     1994           ) .
     1995         assign
     1996           v-diasize-need-maximize = false
     1997         .
     1998       end.
     1999       else do:
     2000         run diasize_change-width in this-procedure
     2001           (input v-diasize-orig-frame-width
     2002               - frame Dialog-Frame :width-chars
     2003           ,input true
     2004           ) .
     2005         run diasize_change-height in this-procedure
     2006           (input v-diasize-orig-frame-height
     2007               - frame Dialog-Frame :height-chars
     2008           ,input true
     2009           ) .
     2010         assign
     2011           v-diasize-need-maximize = true
     2012         .
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure diasize_restore-orig-size :
     2017     do
     2018     on error undo, return error return-value
     2019     :
     2020       assign
     2021         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2022         v-diasize-current-frame-height = frame Dialog-Frame :height
     2023       .
     2024       run diasize_set-height in this-procedure
     2025         (input  v-diasize-orig-frame-height
     2026         ,input  true
     2027         ) .
     2028       run diasize_set-width in this-procedure
     2029         (input  v-diasize-orig-frame-width
     2030         ,input  true
     2031         ) .
     2032     end.
     2033   end procedure.
     2034   procedure diasize_restore-current-size :
     2035     do
     2036     on error undo, return error return-value
     2037     :
     2038       run diasize_set-height in this-procedure
     2039         (input  v-diasize-current-frame-height
     2040         ,input  true
     2041         ) .
     2042       run diasize_set-width in this-procedure
     2043         (input  v-diasize-current-frame-width
     2044         ,input  true
     2045         ) .
     2046     end.
     2047   end procedure.
     2048   procedure diasize_set-browse-handle :
     2049     define input  parameter p-browse-handle as handle   no-undo .
     2050     define buffer buf_temp-browse-handle for temp-browse-handle .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       assign
     2055         v-diasize-browse-handle = p-browse-handle
     2056       .
     2057       for each buf_temp-browse-handle
     2058       on error undo, return error return-value
     2059       :
     2060         delete buf_temp-browse-handle .
     2061       end.
     2062     end.
     2063   end procedure.
     2064   procedure diasize_add_browse :
     2065     define input  parameter p-browse-type   as character no-undo .
     2066     define input  parameter p-browse-handle as handle    no-undo .
     2067     define buffer buf_temp-browse-handle for temp-browse-handle .
     2068     do
     2069     on error undo, return error return-value
     2070     :
     2071       assign
     2072         v-diasize-browse-number = v-diasize-browse-number + 1
     2073       .
     2074       create buf_temp-browse-handle .
     2075       assign
     2076         buf_temp-browse-handle.browse-type   = p-browse-type
     2077         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2078         buf_temp-browse-handle.browse-handle = p-browse-handle
     2079       .
     2080     end.
     2081   end procedure.
     2082   procedure diasize_init :
     2083     define variable v-default-value    as logical   no-undo .
     2084     define variable v-restore-saved    as logical   no-undo .
     2085     define variable v-resize-value-str as character no-undo .
     2086     do
     2087     on error undo, return error return-value
     2088     :
     2089       do with frame Dialog-Frame
     2090       :
     2091         assign
     2092           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2093           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2094           v-diasize-browse-handle     = browse brc-contract :handle
     2095         .
     2096         create button v-diasize-resize-button
     2097         assign
     2098           parent        = frame Dialog-Frame :first-child
     2099           label         = "s"
     2100           height-pixels = 16
     2101           width-pixels  = 16
     2102           visible       = true
     2103           sensitive     = true
     2104           movable       = true
     2105           triggers:
     2106             on end-move persistent run diasize_end-move in this-procedure .
     2107           end triggers.
     2108         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2109         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2110         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2111         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2112         assign
     2113           v-diasize-wndmax = false
     2114         .
     2115         if connected("ub") = true
     2116         then do:
     2117           define variable v-cntxt-db-num        as integer   no-undo .
     2118           define variable v-cntxt-userid        as character no-undo .
     2119           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2120                                             , OUTPUT v-cntxt-userid
     2121                                             ) .
     2122           run gbl/wndpar_r.p
     2123             (input  v-cntxt-db-num
     2124             ,input  v-cntxt-userid
     2125             ,input  'wndmax':U
     2126             ,output v-diasize-wndmax
     2127             ,output v-default-value
     2128             ) .
     2129         end.
     2130         assign
     2131           v-diasize-wndstore = false
     2132         .
     2133         if connected("ub") = true
     2134         then do:
     2135           run gbl/wndpar_r.p
     2136             (input  v-cntxt-db-num
     2137             ,input  v-cntxt-userid
     2138             ,input  'wndstore':U
     2139             ,output v-diasize-wndstore
     2140             ,output v-default-value
     2141             ) .
     2142         end.
     2143         assign
     2144           v-diasize-proc-name = entry(1, program-name(2), '.')
     2145         .
     2146         if v-diasize-wndstore = true
     2147         then do:
     2148           assign
     2149             v-restore-saved = false
     2150           .
     2151           if connected("ub") = true
     2152           then do:
     2153             run gbl/wndsizer.p
     2154               (input  v-cntxt-db-num
     2155               ,input  v-cntxt-userid
     2156               ,input  v-diasize-proc-name
     2157               ,input  'height':u
     2158               ,output v-resize-value-str
     2159               ) .
     2160             if v-resize-value-str <> '':U
     2161             then do:
     2162               run diasize_change-height in this-procedure
     2163                 (input  integer(v-resize-value-str)
     2164                 ,input  true
     2165                 ) .
     2166               assign
     2167                 v-restore-saved = true
     2168               .
     2169             end.
     2170           end.
     2171           if connected("ub") = true
     2172           then do:
     2173             run gbl/wndsizer.p
     2174               (input  v-cntxt-db-num
     2175               ,input  v-cntxt-userid
     2176               ,input  v-diasize-proc-name
     2177               ,input  'width':u
     2178               ,output v-resize-value-str
     2179               ) .
     2180             if v-resize-value-str <> '':U
     2181             then do:
     2182               run diasize_change-width in this-procedure
     2183                 (input  integer(v-resize-value-str)
     2184                 ,input  true
     2185                 ) .
     2186               assign
     2187                 v-restore-saved = true
     2188               .
     2189             end.
     2190           end.
     2191           if v-restore-saved <> true
     2192           then do:
     2193             if v-diasize-wndmax = true
     2194             then do:
     2195               run diasize_maximize in this-procedure
     2196                 (input  true
     2197                 ) .
     2198             end.
     2199           end.
     2200         end.
     2201         else do:
     2202           if v-diasize-wndmax = true
     2203           then do:
     2204             run diasize_maximize in this-procedure
     2205               (input  true
     2206               ) .
     2207           end.
     2208         end.
     2209       end.
     2210     end.
     2211   end procedure.
     2212   procedure diasize_need-full-display :
     2213     define output parameter p-need-full-display as logical   no-undo .
     2214     do
     2215     on error undo, return error return-value
     2216     :
     2217       assign
     2218         p-need-full-display = v-diasize-need-full-display
     2219       .
     2220       assign
     2221         v-diasize-need-full-display = false
     2222       .
     2223     end.
     2224   end procedure.
     2225   procedure get-context :
     2226      define output parameter p-db-num as integer          no-undo.
     2227      define output parameter p-user-id as character        no-undo.
     2228      define variable v-login               as character    no-undo.
     2229      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2230      define buffer buf_user-login  for ub.user-login .
     2231      do
     2232      on error undo, return error
     2233      :
     2234            FIND FIRST buf_sys-ctrl no-lock.
     2235            ASSIGN
     2236               v-login = USERID("ub")
     2237               p-db-num = buf_sys-ctrl.db-num
     2238            .
     2239            FIND FIRST buf_user-login
     2240                 WHERE buf_user-login.db-num = p-db-num
     2241                   AND buf_user-login.user-login = v-login
     2242                 no-lock
     2243                 no-error
     2244                 .
     2245            IF AVAILABLE buf_user-login
     2246            THEN DO:
     2247               assign
     2248                  p-user-id = buf_user-login.user-id
     2249               .
     2250            END.
     2251      end.
     2252   end procedure.
     2253       run diasize_init in this-procedure .
     2254   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2255   procedure set-filter-name :
     2256   define input parameter p-filter-name as character no-undo .
     2257     do with frame Dialog-Frame:
     2258       if p-filter-name > "" then do:
     2259         assign
     2260           frame Dialog-Frame:title
     2261             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2262         .
     2263         assign
     2264           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2265         .
     2266       end.
     2267       else do:
     2268         assign
     2269           b-sch :tooltip = ""
     2270         .
     2271       end.
     2272     end.
     2273   end procedure.
     2274   def var sort-labelbrc-contract   as character no-undo .
     2275   def var sort-clmnbrc-contract    as handle    no-undo .
     2276   def var cur-clmnbrc-contract     as handle    no-undo .
     2277   def var cur-clmn-locbrc-contract as integer   no-undo .
     2278   def var re-querybrc-contract     as logical   initial no no-undo .
     2279   on start-search, ctrl-o of brc-contract in frame Dialog-Frame do:
     2280      run sort-brbrc-contract
     2281        (input (if available X_c-contract
     2282                then recid(X_c-contract)
     2283                else ?
     2284               )
     2285        ).
     2286   end.
     2287   PROCEDURE sort-brbrc-contract :
     2288     define input parameter p-recid as recid no-undo .
     2289     if re-querybrc-contract = no then do:
     2290       assign
     2291          cur-clmnbrc-contract = brc-contract:current-column in frame Dialog-Frame
     2292       .
     2293       if sort-clmnbrc-contract <> ? then sort-clmnbrc-contract:column-fgcolor = 0.
     2294       if cur-clmnbrc-contract = sort-clmnbrc-contract then do:
     2295         assign
     2296            sort-labelbrc-contract = ""
     2297            sort-clmnbrc-contract = ?
     2298         .
     2299        end.
     2300        else do:
     2301          assign
     2302            sort-labelbrc-contract = cur-clmnbrc-contract:label
     2303            sort-clmnbrc-contract  = cur-clmnbrc-contract
     2304            sort-clmnbrc-contract:column-fgcolor = 4
     2305          .
     2306        end.
     2307      end.
     2308     assign
     2309       cur-clmn-locbrc-contract = 1
     2310     .
     2311     def var column-handle as handle no-undo .
     2312     column-handle = brc-contract:first-column.
     2313     do while valid-handle(column-handle) :
     2314       if column-handle = cur-clmnbrc-contract then do:
     2315         leave .
     2316       end.
     2317       column-handle = column-handle:NEXT-COLUMN.
     2318       assign
     2319         cur-clmn-locbrc-contract = cur-clmn-locbrc-contract + 1
     2320       .
     2321     end.
     2322     case sort-labelbrc-contract:
     2323           when X_c-contract.contract-prn-code:label in browse brc-contract then DO:    assign       sort-column-name = "X_c-contract.contract-prn-code"     .     run OpenBr(yes, no, no).   . END.
     2324       otherwise do:
     2325         assign
     2326           sort-column-name = ""
     2327         .
     2328         run OpenBr(yes, no, no).
     2329         if sort-labelbrc-contract <> "" then do:
     2330           assign
     2331             cur-clmnbrc-contract:column-fgcolor = 0
     2332           .
     2333         end.
     2334         assign
     2335           cur-clmn-locbrc-contract = ?
     2336         .
     2337       end.
     2338     end case.
     2339     if p-recid <> ? then do:
     2340       reposition brc-contract to recid p-recid no-error.
     2341       apply "value-changed" to brc-contract in frame Dialog-Frame.
     2342     end.
     2343     apply "entry" to brc-contract in frame Dialog-Frame.
     2344   END PROCEDURE.
     2345   procedure re-open-query-srt-clmnbrc-contract:
     2346   if cur-clmnbrc-contract = ? then do:
     2347      run OpenBr(yes, no, no).
     2348   end.
     2349   else do:
     2350      assign re-querybrc-contract = yes.
     2351      run sort-brbrc-contract
     2352        (input (if available X_c-contract
     2353                then recid(X_c-contract)
     2354                else ?
     2355               )
     2356        ).
     2357      assign re-querybrc-contract = no.
     2358   end.
     2359   end.
     2360   MAIN-BLOCK:
     2361   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2362      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2363   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2364     run mainmenu_getcntxt in parparentproc
     2365       (output v-cntxt-db-num
     2366       ,output v-cntxt-userid
     2367       ,output v-cntxt-level
     2368       ,output v-cntxt-host-code-obj
     2369       ,output v-cntxt-obj-type
     2370       ,output v-cntxt-obj-code
     2371       ,output v-cntxt-db-num-obj
     2372       ,output v-cntxt-is-admin
     2373       ) .
     2374     find first X_contract no-lock  where X_contract.host-code = p-host-code and X_contract.contract-code = p-contract-code no-error .
     2375     if not available X_contract then do:
     2376       message
     2377         vss-workfile vss-revision vss-description skip
     2378         "Неверное значение параметра вызова p-host-code и/или p-contract-code"  p-host-code p-contract-code
     2379       view-as alert-box ERROR.
     2380       return.
     2381     end.
     2382     assign
     2383       brc-contract:num-locked-columns = 1
     2384       X_c-contract.contract-prn-code:read-only in browse brc-contract = yes
     2385     .
     2386     find first ub.clients no-lock where ub.clients.obj-code = p-host-code and ub.clients.obj-type = 'орг':U .
     2387     title0 = "Список истории договоров" + chr(32)  + substitute(" Фирма: (&1) &2 Договор : &3 от &4", p-host-code, ub.clients.obj-name,  X_contract.contract-prn-code, string(X_contract.contract-date,"99/99/9999")) .
     2388     RUN MyEnable.
     2389     DISABLE
     2390       b-sel   when  NOT can-do( bttns, "b-sel" )
     2391       b-mark  when  NOT can-do( bttns, "b-mark")
     2392     WITH FRAME Dialog-Frame.
     2393     RUn OpenBR(yes, no, '':U).
     2394     HIDE mark-num in frame Dialog-Frame .
     2395     if p-rid-list <> "":U then assign v-doc-rec = integer(entry(1, p-rid-list)) .
     2396     WAIT-FOR GO OF FRAME Dialog-Frame.
     2397   END.
     2398   RUN disable_UI.
     2399   PROCEDURE disable_UI :
     2400     HIDE FRAME Dialog-Frame.
     2401   END PROCEDURE.
     2402   PROCEDURE enable_UI :
     2403     DISPLAY mark-num      WITH FRAME Dialog-Frame.
     2404     ENABLE b-quit b-sel B-lookup B-sch B-Help brc-contract BR-changes mark-num    WITH FRAME Dialog-Frame.
     2405     VIEW FRAME Dialog-Frame.
     2406   END PROCEDURE.
     2407   PROCEDURE MyEnable :
     2408     DISPLAY mark-num WITH FRAME Dialog-Frame.
     2409     ENABLE  b-quit  B-lookup  b-sel  B-mark  B-sch  B-Help  mark-num  brc-contract  BR-changes WITH FRAME Dialog-Frame.
     2410     VIEW FRAME Dialog-Frame.
     2411   END PROCEDURE.
     2412   PROCEDURE OpenBr :
     2413     define input  parameter p-open-query     as logical   no-undo .
     2414     define input  parameter p-find-next      as logical   no-undo .
     2415     define input  parameter p-find-condition as character no-undo .
     2416     def var l-query-was-opened as logical no-undo .
     2417     def var sort-column-phrase as character no-undo .
     2418     case sort-column-name :
     2419       when "" then assign sort-column-phrase = ""  .
     2420       otherwise    assign sort-column-phrase = "by " + sort-column-name  .
     2421     end case.
     2422     define variable l-open-query as logical   no-undo .
     2423     filter-point = filter-point0 .
     2424     ASSIGN frame Dialog-Frame:TITLE = title0 .
     2425   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2426   define variable  l-disable-where-15  as logical   no-undo .
     2427   define variable  l-filter-open-15    as logical   .
     2428   define variable  flt-rec-15       as recid     no-undo .
     2429   define variable  filter-name-15      as character no-undo .
     2430   define variable  where-phrase-15     as character no-undo .
     2431   define variable  sort-phrase-15      as character no-undo .
     2432   define variable  where-phrase-rus-15 as character no-undo .
     2433   define variable  sort-phrase-rus-15  as character no-undo .
     2434   run gbl/flt-get.p
     2435     (input filter-point
     2436     ,output flt-rec-15
     2437     ,output filter-name-15
     2438     ,output where-phrase-15
     2439     ,output sort-phrase-15
     2440     ,output where-phrase-rus-15
     2441     ,output sort-phrase-rus-15
     2442     ).
     2443   if p-open-query then do:
     2444       run set-filter-name in this-procedure
     2445         (INPUT filter-name-15
     2446         ) no-error .
     2447     assign
     2448       l-filter-open-15 = false
     2449     .
     2450     if flt-rec-15 <> ?
     2451       or sort-column-phrase > ""
     2452     then do:
     2453       define variable  parameter-2-15 as character no-undo .
     2454       define variable  parameter-3-15 as character no-undo .
     2455       define variable  parameter-4-15 as character no-undo .
     2456       define variable  parameter-5-15 as character no-undo .
     2457       define variable  parameter-6-15 as character no-undo .
     2458       define variable  parameter-7-15 as character no-undo .
     2459         assign
     2460         parameter-3-15 =
     2461                                 "FOR EACH X_c-contract"
     2462         parameter-4-15 =
     2463           (
     2464             if (" X_c-contract.host-code = p-host-code AND X_c-contract.contract-code  = p-contract-code " + " " + where-phrase-15) <> ""
     2465             then  substitute(' X_c-contract.host-code = &1 and X_c-contract.contract-code = &2', p-host-code, p-contract-code) + " " + where-phrase-15
     2466             else "true"
     2467           )
     2468         parameter-5-15 = (" " + "" + " " + "")
     2469         parameter-6-15 = if sort-phrase-15 = ''
     2470                              then
     2471           (
     2472           " " + "  " +
     2473             " " + sort-column-phrase +
     2474           " " + "  "
     2475           )
     2476                              else
     2477           (
     2478           " " + "  " +
     2479             " " + sort-column-phrase +
     2480           " " + sort-phrase-15
     2481           )
     2482         parameter-7-15 =
     2483           " indexed-reposition  "
     2484       .
     2485       do
     2486       on stop undo, leave
     2487       on error undo, leave
     2488       :
     2489         assign
     2490           l-disable-where-15 =
     2491             (" X_c-contract.host-code = p-host-code AND X_c-contract.contract-code  = p-contract-code " + " " + where-phrase-15 = "")
     2492         .
     2493         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2494                             ,input query brc-contract:handle
     2495                             ,input parameter-3-15
     2496                             ,input parameter-4-15
     2497                             ,input parameter-5-15
     2498                             ,input parameter-6-15
     2499                             ,input parameter-7-15
     2500                             )
     2501         .
     2502         assign
     2503           l-filter-open-15 = true
     2504         .
     2505       end.
     2506       if l-filter-open-15 = false then do:
     2507         message
     2508           "Ошибка при фильтрации / сортировке" skip
     2509           "Будут показаны записи без учета фильтра" skip
     2510           view-as alert-box .
     2511       end.
     2512       else do:
     2513           assign
     2514             l-query-was-opened = true
     2515           .
     2516       end.
     2517     end.
     2518     if l-filter-open-15 = false then do:
     2519       OPEN QUERY brc-contract FOR EACH X_c-contract
     2520         where  X_c-contract.host-code = p-host-code AND X_c-contract.contract-code  = p-contract-code
     2521         indexed-reposition
     2522     .
     2523         assign
     2524           l-query-was-opened = true
     2525         .
     2526     end.
     2527   end.
     2528   else do:
     2529     assign
     2530       v-doc-rec = recid( X_c-contract )
     2531     .
     2532     do
     2533     on stop undo, leave
     2534     on error undo, leave
     2535     :
     2536       if query brc-contract:handle:get-buffer-handle(1) = (buffer X_c-contract:handle) then do:
     2537         assign
     2538         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2539         parameter-4-15 =
     2540           "where ":u +  substitute(' X_c-contract.host-code = &1 and X_c-contract.contract-code = &2', p-host-code, p-contract-code) + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2541         parameter-5-15 = "  "
     2542       .
     2543         run fltopend_fltfindd in this-procedure  (
     2544                             input this-procedure:handle
     2545                             ,input query brc-contract:handle
     2546                             ,input rowid(X_c-contract)
     2547                             ,input logical(parameter-2-15)
     2548                             ,input no-lock
     2549                             ,input (buffer X_c-contract:handle)
     2550                             ,input parameter-4-15
     2551                             ,input parameter-5-15
     2552                             ) no-error.
     2553         .
     2554         assign
     2555           v-doc-rec = integer(return-value)
     2556           v-fltopend-rowid[1] = ?
     2557         .
     2558       end.
     2559       else do:
     2560         assign
     2561         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2562         parameter-3-15 =  "FOR EACH X_c-contract"
     2563         parameter-4-15 =
     2564           (
     2565             if (" X_c-contract.host-code = p-host-code AND X_c-contract.contract-code  = p-contract-code " + " " + where-phrase-15) <> ""
     2566             then  substitute(' X_c-contract.host-code = &1 and X_c-contract.contract-code = &2', p-host-code, p-contract-code) + " " + where-phrase-15
     2567             else "true"
     2568           )
     2569         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     2570         parameter-6-15 = if sort-phrase-15 = ''
     2571                              then
     2572           (
     2573           " " + "  " +
     2574             " " + sort-column-phrase +
     2575           " " + "  "
     2576           )
     2577                              else
     2578           (
     2579           " " + "  " +
     2580             " " + sort-column-phrase +
     2581           " " + sort-phrase-15
     2582           )
     2583         parameter-7-15 =
     2584           " indexed-reposition  "
     2585       .
     2586         run fltopend_fltfindq in this-procedure  (
     2587                             input this-procedure:handle
     2588                             ,input query brc-contract:handle
     2589                             ,input logical(parameter-2-15)
     2590                             ,input no-lock
     2591                             ,input parameter-3-15
     2592                             ,input parameter-4-15
     2593                             ,input parameter-5-15
     2594                             ,input parameter-6-15
     2595                             ,input parameter-7-15
     2596                             ,output v-fltopend-rowid
     2597                             ) no-error.
     2598         .
     2599         v-doc-rec = ?.
     2600       end.
     2601       assign
     2602         l-query-was-opened = true
     2603       .
     2604     end.
     2605   end.
     2606     REPOSITION brc-contract to recid v-doc-rec No-ERROR.
     2607     if error-status:error then REPOSITION brc-contract to row 1 No-ERROR.
     2608     else  REPOSITION brc-contract to row 7 No-ERROR.
     2609     run proc-view-changes in this-procedure no-error.
     2610   END PROCEDURE.
     2611   PROCEDURE proc-view-changes :
     2612     define buffer new_c-contract for ub.c-contract.
     2613     define buffer current_contract for ub.contract.
     2614     define variable v-chg-fields as character no-undo.
     2615     define variable v-old-fields as character no-undo.
     2616     define variable v-new-fields as character no-undo.
     2617     define variable ii as integer no-undo.
     2618     for each temp-changes:  delete temp-changes.  END.
     2619     find first new_c-contract no-lock
     2620       where new_c-contract.host-code     = X_c-contract.host-code
     2621         and new_c-contract.contract-code = X_c-contract.contract-code
     2622         and new_c-contract.chip-num      > X_c-contract.chip-num
     2623       no-error.
     2624     if not available new_c-contract then do:
     2625       find first current_contract no-lock
     2626         where current_contract.host-code = X_c-contract.host-code
     2627          and current_contract.contract-code = X_c-contract.contract-code
     2628       no-error.
     2629       if not available current_contract then return error.
     2630       buffer-compare current_contract to X_c-contract save result in v-chg-fields.
     2631     end.
     2632     else do:
     2633       buffer-compare new_c-contract except chip-num corr-date corr-time corr-doc-code corr-user-name corr-user-db-num to X_c-contract save result in v-chg-fields.
     2634     end.
     2635       do ii = 1 to num-entries(v-chg-fields):
     2636       CASE entry(ii, v-chg-fields):
     2637                     when "contract-prn-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "contract-prn-code":U     temp-changes.l_name = "Номер"     temp-changes.v_old = string(X_c-contract.contract-prn-code)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.contract-prn-code)                               else string(current_contract.contract-prn-code))     .     end.
     2638                     when "contract-date":U then do:     create temp-changes.     assign     temp-changes.f_name = "contract-date":U     temp-changes.l_name = "Дата договора"     temp-changes.v_old = string(X_c-contract.contract-date)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.contract-date)                               else string(current_contract.contract-date))     .     end.
     2639                     when "contract-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "contract-type":U     temp-changes.l_name = "Тип договора"     temp-changes.v_old = string(X_c-contract.contract-type)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.contract-type)                               else string(current_contract.contract-type))     .     end.
     2640                     when "str-uslov-oplat":U then do:     create temp-changes.     assign     temp-changes.f_name = "str-uslov-oplat":U     temp-changes.l_name = "Условия оплаты"     temp-changes.v_old = string(X_c-contract.str-uslov-oplat)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.str-uslov-oplat)                               else string(current_contract.str-uslov-oplat))     .     end.
     2641                     when "usl-opl":U then do:     create temp-changes.     assign     temp-changes.f_name = "usl-opl":U     temp-changes.l_name = "Условия генерации"     temp-changes.v_old = string(X_c-contract.usl-opl)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.usl-opl)                               else string(current_contract.usl-opl))     .     end.
     2642                     when "auto-pay":U then do:     create temp-changes.     assign     temp-changes.f_name = "auto-pay":U     temp-changes.l_name = "Статус генерации"     temp-changes.v_old = string(X_c-contract.auto-pay)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.auto-pay)                               else string(current_contract.auto-pay))     .     end.
     2643                     when "srok-opl":U then do:     create temp-changes.     assign     temp-changes.f_name = "srok-opl":U     temp-changes.l_name = "Срок оплаты"     temp-changes.v_old = string(X_c-contract.srok-opl)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.srok-opl)                               else string(current_contract.srok-opl))     .     end.
     2644                     when "status_":U then do:     create temp-changes.     assign     temp-changes.f_name = "status_":U     temp-changes.l_name = "Статус"     temp-changes.v_old = string(X_c-contract.status_)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.status_)                               else string(current_contract.status_))     .     end.
     2645                     when "contract-name":U then do:     create temp-changes.     assign     temp-changes.f_name = "contract-name":U     temp-changes.l_name = "Наименование договора"     temp-changes.v_old = string(X_c-contract.contract-name)     temp-changes.v_new = (if available new_c-contract                               then string(new_c-contract.contract-name)                               else string(current_contract.contract-name))     .     end.
