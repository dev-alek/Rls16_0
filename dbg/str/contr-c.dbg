     2738   END PROCEDURE.
     2739   FUNCTION get-agent RETURNS CHARACTER
     2740     ( input agnt-type as character , input agnt-code as integer ) :
     2741   define variable var-cli-name as character no-undo.
     2742   define buffer buf_clients for ub.clients.
     2743     find first buf_clients no-lock where buf_clients.obj-type = agnt-type and buf_clients.obj-code = agnt-code no-error .
     2744     if available buf_clients then assign var-cli-name = STRING (agnt-code) + "   " + TRIM (buf_clients.obj-name) .
     2745     RETURN var-cli-name.
     2746   END FUNCTION.
     2747   FUNCTION get-currency RETURNS CHARACTER
     2748     ( input curr-code as integer ) :
     2749   define variable var-curr-name as character no-undo.
     2750   define buffer buf_currency for ub.currency.
     2751     find first buf_currency no-lock where buf_currency.curr-code = curr-code no-error .
     2752     if available buf_currency then assign var-curr-name = buf_currency.curr-abbr .
     2753   RETURN var-curr-name.
     2754   END FUNCTION.
     2755   FUNCTION mark-string RETURNS CHARACTER
     2756     ( input par-recid as recid, input mark-list as character) :
     2757   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2758   END FUNCTION.
