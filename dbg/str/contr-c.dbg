        1   DEFINE BUFFER X_c-contract FOR ub.c-contract.
        2   DEFINE BUFFER X_contract FOR ub.contract.
        3   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-host-code    as integer   no-undo .
        5   define input parameter p-contract-code as integer   no-undo .
        6   define input parameter bttns  as char   no-undo .
        7   define input-output param p-rid-list    as  char no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Список истории договоров".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable c-point  as character no-undo .
      121   define variable tbl      as character no-undo .
      122   define variable join-tbl as character no-undo .
      123   define variable fld      as character no-undo .
      124   define variable lab      as character no-undo .
      125   define variable spr      as character no-undo .
      126   define variable dim      as character no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure fltfield-clear :
      379     define output parameter loc-fld as character no-undo.
      380     define output parameter loc-lab as character no-undo .
      381     define output parameter loc-spr as character no-undo .
      382     define output parameter loc-dim as character no-undo .
      383     assign
      384       loc-fld = ""
      385       loc-lab = ""
      386       loc-spr = ""
      387       loc-dim = "0"
      388     .
      389   end procedure .
      390   procedure fltfield-add :
      391     define input        parameter par-fld as character no-undo.
      392     define input        parameter par-lab as character no-undo .
      393     define input        parameter par-spr as character no-undo .
      394     define input-output parameter loc-fld as character no-undo.
      395     define input-output parameter loc-lab as character no-undo .
      396     define input-output parameter loc-spr as character no-undo .
      397     define input-output parameter loc-dim as character no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       assign
      402       loc-fld = if loc-dim = '0'
      403                 then par-fld
      404                 else (loc-fld + chr(44) + par-fld)
      405       loc-lab = if loc-dim = '0'
      406                 then par-lab
      407                 else (loc-lab + chr(44) + par-lab)
      408       loc-spr = if loc-dim = '0'
      409                 then par-spr
      410                 else (loc-spr + chr(44) + par-spr)
      411       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      412                 string(integer(if num-entries(loc-dim) > 1
      413                               then entry(2, loc-dim)
      414                               else entry(1, loc-dim)
      415                               ) + 1)
      416       no-error
      417       .
      418     end.
      419   end procedure.
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421     define variable v-cntxt-db-num        as integer   no-undo .
      422     define variable v-cntxt-userid        as character no-undo .
      423     define variable v-cntxt-level         as character no-undo .
      424     define variable v-cntxt-host-code-obj as integer   no-undo .
      425     define variable v-cntxt-obj-type      as character no-undo .
      426     define variable v-cntxt-obj-code      as integer   no-undo .
      427     define variable v-cntxt-db-num-obj    as integer   no-undo .
      428     define variable v-cntxt-is-admin      as logical   no-undo .
      429   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      430   function usrfulnf returns character ( input p-user-id as character):
      431   define variable v-user-name as character no-undo .
      432   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      434     (input  p-user-id
      435     ,output v-user-name
      436     ) no-error .
      437   if error-status:error
      438   or v-user-name = ""
      439   then do:
      440     return p-user-id.
      441   end.
      442   else do:
      443     return v-user-name.
      444   end.
      445   end function.
      446   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      448   procedure fltopend_fltopend :
      449   define input parameter p-parent-handle as handle no-undo .
      450   define input parameter p-qh as handle no-undo .
      451   define input parameter p-flt-open-open-query  as character no-undo .
      452   define input parameter p-where-cond as character no-undo .
      453   define input parameter p-use-indFIRST-query-tail as character no-undo .
      454   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      455   define input parameter p-indexed-reposition as character no-undo .
      456     do
      457     on error undo, return error
      458     :
      459   define variable v-prepare-string as character no-undo .
      460   define variable glog as logical no-undo .
      461   assign
      462   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      463                      p-where-cond + chr(32)  +
      464                      p-use-indFIRST-query-tail + chr(32) +
      465                      p-use-ind-sort-clmn-by + chr(32) +
      466                      p-indexed-reposition
      467   .
      468   assign
      469   glog = p-qh:query-prepare(v-prepare-string) no-error .
      470   if not glog
      471   or error-status:error then do:
      472     message error-status:get-message(1) view-as alert-box .
      473     undo, return error .
      474   end.
      475   assign
      476   glog = p-qh:query-open no-error .
      477   if not glog
      478   or error-status:error then do:
      479     message error-status:get-message(1) view-as alert-box .
      480     undo, return error .
      481   end.
      482     end.
      483   end procedure.
      484   procedure fltopend_fltfindd :
      485   define input parameter p-parent-handle as handle no-undo .
      486   define input parameter p-qh as handle no-undo .
      487   define input parameter p-rowid as rowid no-undo .
      488   define input parameter p-next as logical no-undo .
      489   define input parameter p-lock as integer no-undo .
      490   define input parameter p-bh as handle no-undo .
      491   define input parameter p-where-cond as character no-undo .
      492   define input parameter p-use-index-phrase as character no-undo .
      493   define variable glog as logical no-undo .
      494   define variable v-qh as handle no-undo .
      495   define variable v-bh as handle no-undo .
      496   define variable v-recid as recid no-undo .
      497   define variable v-prepare-string as character no-undo .
      498   do
      499   on error undo, return error
      500   on stop undo, return error
      501   :
      502     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      503     create buffer v-bh for table p-bh buffer-name p-bh:name.
      504     create query v-qh.
      505     v-qh:set-buffers(v-bh).
      506     v-prepare-string = substitute("for each &1 &2 &3"
      507                                     ,v-bh:name
      508                                     ,p-where-cond
      509                                     ,p-use-index-phrase).
      510     glog = v-qh:query-prepare(v-prepare-string) no-error.
      511     if not glog then do:
      512       delete object v-qh.
      513       delete object v-bh.
      514       undo, return error .
      515     end.
      516     glog = v-qh:query-open no-error .
      517     if not glog then do:
      518       delete object v-qh.
      519       delete object v-bh.
      520       undo, return error .
      521     end.
      522     if p-next then do:
      523       v-qh:reposition-to-rowid(p-rowid) no-error .
      524       glog = v-qh:get-next( p-lock) no-error .
      525       glog = v-qh:get-next( p-lock) no-error .
      526       if not glog or v-qh:query-off-end = yes then do:
      527         glog = v-qh:get-first( p-lock) no-error .
      528       end.
      529     end.
      530     else do:
      531       glog = v-qh:get-first( p-lock) no-error .
      532     end.
      533     v-recid = v-bh:recid no-error .
      534     delete object v-qh.
      535     delete object v-bh.
      536     return string(v-recid) .
      537   end.
      538   end procedure.
      539   procedure fltopend_fltfindq :
      540   define input parameter p-parent-handle as handle no-undo .
      541   define input parameter p-qh as handle no-undo .
      542   define input parameter p-next as logical no-undo .
      543   define input parameter p-lock as integer no-undo .
      544   define input parameter p-flt-open-open-query  as character no-undo .
      545   define input parameter p-where-cond as character no-undo .
      546   define input parameter p-use-indFIRST-query-tail as character no-undo .
      547   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      548   define input parameter p-indexed-reposition as character no-undo .
      549   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      550   define variable glog as logical no-undo .
      551   define variable v-qh as handle no-undo .
      552   define variable v-bh as handle no-undo extent 18.
      553   define variable v-rowid as rowid no-undo extent 18.
      554   define variable v-ii as integer no-undo .
      555   define variable v-prepare-string as character no-undo .
      556   do
      557   on error undo, return error
      558   on stop undo, return error
      559   :
      560     create query v-qh.
      561     do v-ii = 1 to p-qh:num-buffers:
      562       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      563       assign
      564       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      565       no-error.
      566       v-qh:add-buffer(v-bh[v-ii]).
      567     end.
      568     assign
      569     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      570                       p-where-cond + chr(32)  +
      571                       p-use-indFIRST-query-tail + chr(32) +
      572                       p-use-ind-sort-clmn-by + chr(32) +
      573                       p-indexed-reposition
      574     .
      575     glog = v-qh:query-prepare( v-prepare-string) no-error .
      576     if not glog then do:
      577       delete object v-qh.
      578       do v-ii = 1 to p-qh:num-buffers:
      579         delete object v-bh[v-ii].
      580       end.
      581       undo, return error .
      582     end.
      583     glog = v-qh:query-open no-error .
      584     if not glog then do:
      585       delete object v-qh.
      586       do v-ii = 1 to p-qh:num-buffers:
      587         delete object v-bh[v-ii].
      588       end.
      589       undo, return error .
      590     end.
      591     if p-next then do:
      592       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      593       glog = v-qh:get-next( p-lock) no-error .
      594       glog = v-qh:get-next( p-lock) no-error .
      595       if not glog or v-qh:query-off-end = yes then do:
      596         glog = v-qh:get-first( p-lock) no-error .
      597       end.
      598     end.
      599     else do:
      600       glog = v-qh:get-first( p-lock) no-error .
      601     end.
      602     do v-ii = 1 to p-qh:num-buffers:
      603       assign
      604       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      605       no-error.
      606     end.
      607     delete object v-qh.
      608     do v-ii = 1 to p-qh:num-buffers:
      609       delete object v-bh[v-ii].
      610     end.
      611   end.
      612   end procedure.
      613   define variable filter-point as character no-undo init "Список истории договоров" .
      614   define variable filter-point0 as character no-undo init "Список истории договоров" .
      615   define variable sort-column-name as character no-undo .
      616   define variable v-doc-rec as recid no-undo .
      617   define variable title0 as character no-undo.
      618   define temp-table temp-changes no-undo
      619     field f_name as character
      620     field l_name as character
      621     field v_old as character
      622     field v_new as character
      623   index pi is unique primary f_name.
      624   FUNCTION get-agent RETURNS CHARACTER
      625     ( input agnt-type as character , input agnt-code as integer )  FORWARD.
      626   FUNCTION get-currency RETURNS CHARACTER
      627     ( input curr-code as integer )  FORWARD.
      628   FUNCTION mark-string RETURNS CHARACTER
      629     ( input par-recid as recid, input mark-list as character)  FORWARD.
      630   DEFINE BUTTON B-Help
      631        LABEL "Помо&щь"
      632        SIZE 10 BY 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON B-lookup
      635        LABEL "&Просмотр"
      636        SIZE 10 BY 1.
      637   DEFINE BUTTON B-mark
      638        LABEL "&*"
      639        SIZE 3 BY 1.
      640   DEFINE BUTTON b-quit AUTO-GO
      641        LABEL "&Выход"
      642        SIZE 10 BY 1
      643        BGCOLOR 8 .
      644   DEFINE BUTTON B-sch
      645        LABEL "&Фильтр"
      646        SIZE 10 BY 1.
      647   DEFINE BUTTON b-sel AUTO-GO
      648        LABEL "Вы&бор"
      649        SIZE 10 BY 1
      650        BGCOLOR 8 .
      651   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      652         VIEW-AS TEXT
      653        SIZE 6 BY 1
      654        FGCOLOR 4  NO-UNDO.
      655   DEFINE  QUERY brc-contract FOR X_c-contract SCROLLING.
      656   DEFINE QUERY BR-changes FOR
      657         temp-changes SCROLLING.
      658   DEFINE BROWSE brc-contract
      659     QUERY brc-contract DISPLAY
      660         (mark-string(recid(X_c-contract), p-rid-list)) COLUMN-LABEL "*" FORMAT "x(1)"
      661         X_c-contract.corr-date                    COLUMN-LABEL "Дата!изменения"  FORMAT "99/99/99"
      662         string(X_c-contract.corr-time,"HH:MM")    COLUMN-LABEL "Время!изменения" FORMAT "X(5)"
      663         usrfulnf(X_c-contract.corr-user-name)               COLUMN-LABEL "Оператор"        FORMAT "X(18)"
      664         X_c-contract.status_                      COLUMN-LABEL "Статус"          FORMAT "X(4)"
      665         X_c-contract.contract-prn-code            COLUMN-LABEL "Номер"           FORMAT "X(16)"
      666         X_c-contract.contract-date                COLUMN-LABEL "Дата!договора"  FORMAT "99/99/99"
      667         X_c-contract.contract-name                COLUMN-LABEL "Заголовок"       FORMAT "X(22)"
      668         if X_c-contract.cli-type = "" then "" else TRIM (X_c-contract.cli-type + " " + STRING (X_c-contract.cli-code)) COLUMN-LABEL "Тип/код!контрагента" FORMAT "x(10)"
      669         X_c-contract.cli-name                     COLUMN-LABEL "Контрагент"      FORMAT "x(40)"
      670         X_c-contract.contract-type                COLUMN-LABEL "Тип договора"    FORMAT "X(23)"
      671         X_c-contract.usl-opl                      COLUMN-LABEL "Условия!оплаты"  FORMAT "X(32)"
      672         if X_c-contract.srok-opl > 0 then string(X_c-contract.srok-opl) else ""    COLUMN-LABEL "Отс-!роч."    FORMAT "X(4)"
      673         X_c-contract.contract-city                COLUMN-LABEL "Город"  FORMAT "X(20)"
      674         X_c-contract.contract-date-beg            COLUMN-LABEL "Начало!действия"     FORMAT "99/99/99"
      675         X_c-contract.contract-date-end            COLUMN-LABEL "Окончание!действия"      FORMAT "99/99/99"
      676         (get-currency(X_c-contract.curr-code))    COLUMN-LABEL "вал" FORMAT "x(3)"
      677         if X_c-contract.posr-type = "" then "" else TRIM (X_c-contract.posr-type + " " + STRING (X_c-contract.posr-code)) COLUMN-LABEL "Тип/код!посредника" FORMAT "x(10)"
      678         X_c-contract.posr-name                    COLUMN-LABEL "Посредник"       FORMAT "x(40)"
      679         if X_c-contract.agnt-type = "" then "" else TRIM (X_c-contract.agnt-type + " " + STRING (X_c-contract.agnt-code)) COLUMN-LABEL "Тип/код!агента" FORMAT "x(10)"
      680         X_c-contract.agnt-name                    COLUMN-LABEL "Агент"           FORMAT "x(40)"
      681         (get-agent( 'чел':U ,X_c-contract.mngr-code))  COLUMN-LABEL "Исполнитель" FORMAT "x(50)"
      682         X_c-contract.doc-type
      683       ENABLE
      684         X_c-contract.contract-prn-code
      685       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 13.71.
      686   DEFINE BROWSE BR-changes
      687     QUERY BR-changes DISPLAY
      688         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(35)"
      689   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
      690   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
      691       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.88 BY 5.83.
      692   DEFINE FRAME Dialog-Frame
      693        b-quit AT ROW 1 COL 1
      694        B-mark AT ROW 1 COL 11
      695        b-sel AT ROW 1 COL 21
      696        B-lookup AT ROW 1 COL 31
      697        B-sch AT ROW 1 COL 41
      698        B-Help AT ROW 1 COL 86.25
      699        brc-contract AT ROW 2 COL 1.38
      700        BR-changes AT ROW 16.04 COL 1.38
      701        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      702        SPACE(77.49) SKIP(20.03)
      703       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      704            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      705            TITLE "Список договоров"
      706            CANCEL-BUTTON b-quit.
      707   ASSIGN
      708          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      709          FRAME Dialog-Frame:HIDDEN           = TRUE.
      710   ASSIGN
      711          brc-contract:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
      712   ON ENDKEY OF FRAME Dialog-Frame
      713   DO:
      714       run gbl/markqwa.p ( input b-mark:sensitive, input p-rid-list) no-error.
      715       if error-status:error then return no-apply.
      716   END.
      717   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      718   DO:
      719     if not available X_c-contract then return no-apply.
      720     define variable g-log  as logical   no-undo .
      721   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   do:
      723     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      724       (input  v-cntxt-db-num
      725       ,input  v-cntxt-userid
      726       ,input  0
      727       ,input  'actn_fin-contract_lookup':U
      728       ,input  'firm':U
      729       ,input  p-host-code
      730       ,input  '':U
      731       ,input  0
      732       ,input  0
      733       ,input  0
      734       ,input  0
      735       ,input  true
      736       ,output g-log
      737       )  .
      738   end.
      739     if not g-log then  return .
      740     define variable ri as recid no-undo .
      741     ri = recid( X_c-contract ).
      742     run str/contr.w ( input parParentProc,input p-host-code, input "history", input X_c-contract.doc-type, input-output ri) no-error.
      743     if error-status:error then return no-apply.
      744   END.
      745   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      746   DO:
      747   define variable loc#log as logical no-undo .
      748     if available X_c-contract then do:
      749         if can-do( p-rid-list, string( recid( X_c-contract ) ) ) then do:
      750             p-rid-list = replace( p-rid-list, chr(44) + string( recid( X_c-contract ) ), "") .
      751             p-rid-list = replace( p-rid-list, string( recid( X_c-contract ) ) + chr(44), "") .
      752             p-rid-list = replace( p-rid-list, string( recid( X_c-contract ) ), "") .
      753         end.
      754         else
      755         p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( X_c-contract ) ) .
      756         loc#log = brc-contract:refresh() .
      757         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      758             loc#log = brc-contract:select-next-row ().
      759             apply "VALUE-CHANGED" to brc-contract in frame Dialog-Frame.
      760         end.
      761         if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
      762         else disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      763     end.
      764     apply "entry" to brc-contract in frame Dialog-Frame.
      765   END.
