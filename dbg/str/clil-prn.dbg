     1767   sheetf.Excel-Column-Lable =  ""
     1768   sheetf.sizes = "".
     1769   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1770   l-col-pos = 1.
     1771   Assign l-col-type="CHARACTER" l-col-len=3 l-col-format= "X(3)"     l-col-lable="Тип".
