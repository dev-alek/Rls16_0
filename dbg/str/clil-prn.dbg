     2971   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2972   VIEW stream PRnLibStream FRAME NBottomFrame .
     2973   PUT stream PRnLibStream UNFORMATTED
     2974   SPACE(10)
     2975   Reportname chr(10)
     2976   SKIP(1).
     2977   display STREAM PRnLibStream with frame top-Frame .
     2978   run rep/extitle.p ( input 1).
     2979   run waitfram-show in this-procedure ( input "Ждите...").
     2980   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2981   FOR EACH cli-list No-LOCK
     2982       BREAK
     2983       BY cli-list.obj-type
     2984       BY cli-list.obj-code:
     2985     assign
     2986     accum-count = accum-count + 1
     2987     .
     2988     for-stts = if cli-list.stts > 0 then 'удален' else ''.
     2989     FIND  ub.dis-card No-LOCK WHERE
     2990           ub.dis-card.cli-type = cli-list.obj-type AND
     2991           ub.dis-card.cli-type = cli-list.obj-type No-ERROR.
     2992     if avail ub.dis-card then do:
     2993       if AMBIGUOUS dis-card then  for-dis-card = "...".
     2994       else for-dis-card = ub.dis-card.d-card .
     2995     end.
     2996     else for-dis-card = "".
     2997     if cli-list.obj-type = 'чел':U then do:
     2998       find first ub.person no-lock where
     2999           ub.person.psn-code = cli-list.obj-code No-ERROR.
     3000       if avail person then do:
     3001         assign
