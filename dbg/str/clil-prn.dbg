     1773     define variable l-1 as handle no-undo.
     1774     define variable ll-1 as handle no-undo.
     1775     define variable c-for-obj-type as widget-handle no-undo.
     1776      if l-col-pos > 320 then l-col-pos = 320 .
     1777     if use-column[1] = true then DO:
     1778           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1779             ASSIGN
     1780               FRAME = FRAME top-Frame:HANDLE
     1781               ROW = 1
     1782               COLUMN = l-col-pos
     1783               screen-value = Fill("-", l-col-len)
     1784               WIDTH-CHARS = l-col-len
     1785               HEIGHT-CHARS = 3
     1786           .
