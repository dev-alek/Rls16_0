      373   procedure create_obj-list :
      374      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      375      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      376      do
      377      on error undo, return error return-value
      378      :
      379         define buffer cli-obj for ub.clients .
      380         define variable p-var as integer no-undo .
      381         define buffer buf_obj-list for obj-list .
      382         find last buf_obj-list  use-index pi no-error .
      383         if available buf_obj-list
      384         then
      385            p-var = buf_obj-list.obj-id + 1.
      386         else
      387            p-var = 1.
      388         find first cli-obj where
      389                   cli-obj.obj-type = p-obj-type
      390               and cli-obj.obj-code = p-obj-code
      391         no-lock no-error.
      392         if available cli-obj
      393         then do:
      394            create buf_obj-list.
      395            assign
      396               buf_obj-list.obj-id   = p-var
      397               buf_obj-list.obj-code = cli-obj.obj-code
      398               buf_obj-list.obj-type = cli-obj.obj-type
      399               buf_obj-list.obj-name = cli-obj.obj-name
      400               buf_obj-list.db-num   = cli-obj.db-num
      401            .
      402         end.
      403      end.
      404   end.
