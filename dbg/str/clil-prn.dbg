     1809               FORMAT = "X(":U + string(l-col-len) + ")":U
     1810               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1811               ROW = 1
     1812               COLUMN = l-col-pos
     1813           .
     1814        assign
     1815        l-col-pos =  l-col-pos + l-col-len + 1
     1816        v-r-col-num = v-r-col-num + 1
     1817        .
     1818     end.
     1819   if use-column[1] then
     1820   assign
     1821   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1822                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1823                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1824                                )
     1825   sheetf.sizes =  (if sheetf.sizes = ""
     1826                    then (sheetf.sizes + string(l-col-len))
     1827                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1828                   )
     1829   last-col-num = 1
     1830   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1831                                              (if l-col-type = "DATE"
     1832                                               then (
     1833                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1834                                                      then ";":U
     1835                                                      else "":U) +
     1836                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1837                                                     )
     1838                                               else (if l-col-type = "CHARACTER"
     1839                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1840                                                           then ";":U
     1841                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1842                                                     else "":U)
     1843                                               )
     1844   .
