     3298      else '':U)
     3299     CHR(9)
     3300     (if cli-list-hist.item_ <> '':U
     3301      then cli-list-hist.hist-mode
     3302      else '':U)  CHR(9)
     3303      (if cli-list-hist.item_ <> '':U
     3304      then string(cli-list-hist.num-add, "->>>>>>>>9")
     3305      else '':U)  CHR(9)
