     1788             ASSIGN
     1789               FRAME = FRAME top-Frame:HANDLE
     1790               ROW = 2
     1791               COLUMN = l-col-pos
     1792               screen-value = l-col-lable
     1793               WIDTH-CHARS = l-col-len
     1794               HEIGHT-CHARS = 3
     1795           .
