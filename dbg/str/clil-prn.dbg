     1011   define variable l-col-type         as character no-undo .
     1012   define variable l-col-pos          as integer no-undo .
     1013   define variable l-col-len          as integer no-undo .
     1014   define variable l-col-format       as character no-undo .
     1015   define variable l-col-lable        as character no-undo .
     1016   define variable v-dec-sep          as character no-undo init ? .
     1017   define variable v-th-sep           as character no-undo init ? .
     1018   define variable v-r-col-num        as integer no-undo .
     1019   define variable v-reg-replace      as logical no-undo .
     1020   define variable v-date-col-format  as character no-undo .
     1021   DEFINE VARIABLE last-col-num as integer no-undo.
     1022   run gbl/getlocal.p (
     1023                     output v-dec-sep
     1024                    ,output v-th-sep
     1025                    ,output v-sdate
     1026                    ,output v-shortdate
     1027                    ) no-error .
     1028   assign
     1029   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1030                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1031   .
     1032     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1033                                               INPUT p-dec-sep AS CHARACTER  ) :
     1034       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1035       IF TRIM( p-string ) = "0"                    OR
     1036          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1037          TRIM( p-string ) =       p-dec-sep + "00" OR
     1038          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1039          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1040                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1041       RETURN ( TRIM( v-string ) ).
     1042     END FUNCTION.
     1043   FUNCTION reg-output returns character( input p-string as character
     1044                                         ,input p-private-data as character
     1045                                         ,input p-replace as logical
     1046                                         ,input p-supress as logical
     1047                                         ,input p-dec-sep as character
     1048                                         ,input p-th-sep as character
     1049                                         ):
     1050   DEFINE VARIABLE v-reg-output as character no-undo .
     1051   DEFINE VARIABLE v-data-type as character no-undo .
     1052   DEFINE VARIABLE v-progress-format as character no-undo .
     1053   assign
     1054   v-progress-format = entry(1, p-private-data, chr(4))
     1055   v-data-type = entry(2, p-private-data, chr(4))
     1056   .
     1057   if p-string = ? then return chr(63).
     1058   if (v-data-type = "INTEGER"
     1059       OR v-data-type = "DECIMAL" ) THEN DO:
     1060     IF p-replace THEN DO:
     1061       assign
     1062         v-reg-output = replace( p-string
     1063                                         ,chr(44)
     1064                                         ,"":U
     1065                                       )
     1066         v-reg-output = trim(v-reg-output)
     1067       .
     1068     END.
     1069     else do:
     1070       v-reg-output = p-string.
     1071     end.
     1072     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1073     return v-reg-output.
     1074   end.
     1075     return p-string.
     1076   END FUNCTION.
     1077   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   define variable v-waitfram-action01         as character   no-undo .
     1079   define variable v-waitfram-action02         as character   no-undo .
     1080   define variable v-waitfram-action03         as character   no-undo .
     1081   define variable mWaitFramTextBeg            as character   no-undo.
     1082   define variable mWaitFramTextEnd            as character   no-undo.
     1083   define variable mWaitFramView               as logical     no-undo.
     1084   define variable mWaitProcEvent              as logical     no-undo init yes.
     1085   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1086   define variable mWaitFramStop               as logical     no-undo.
     1087   define variable mWaitFramStopUser           as logical     no-undo.
     1088   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1089   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1090   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1091   define button B-WaitFramStop auto-end-key
     1092        label "Стоп"
     1093        size 10 by 1 tooltip "Остоновить процесс".
     1094   define button B-viewProcInfo
     1095        label "Информация"
     1096        size 15 by 1 tooltip "Информация о процесс".
     1097   define frame waitfram
     1098     v-waitfram-action01 format "x(72)" no-label skip
     1099     v-waitfram-action02 format "x(72)" no-label skip
     1100     v-waitfram-action03 format "x(72)" no-label skip
     1101     B-viewProcInfo
     1102     B-WaitFramStop at row 4 col 30
     1103     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1104     .
     1105   define new global shared variable mBatchMode as logical no-undo init ?.
     1106   define variable mFramBachModHandle as handle no-undo.
     1107   mFramBachModHandle = frame waitfram:handle.
     1108   define variable mFameOldVis as logical no-undo.
     1109   define variable mVisCUrentVin as logical no-undo.
     1110   if session:batch-mode
     1111   then
     1112      mBatchMode = yes.
     1113   if mBatchMode = ? then do:
     1114     mVisCUrentVin = current-window:visible.
     1115     mFameOldVis = mFramBachModHandle:visible.
     1116     mFramBachModHandle:visible  = yes.
     1117     mBatchMode = mFramBachModHandle:visible ne yes.
     1118     mFramBachModHandle:visible = mFameOldVis.
     1119     current-window:visible = mVisCUrentVin.
     1120   end.
     1121    if  log-manager:logfile-name ne ?
     1122     then DO:
     1123         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1124         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1125         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1126     end.
     1127   on choose of B-WaitFramStop in frame waitfram
     1128   do:
     1129     mWaitFramStop = yes.
     1130     mWaitFramStopUser = yes.
     1131   end.
     1132   function waitfram-check-timeout returns logical():
     1133      define variable vtime as int64 no-undo.
     1134      if mWaitFramStopTimeOut
     1135      then
     1136         return yes.
     1137      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1138      if     mWaitFramTimeOut ne ?
     1139         and mWaitFramTimeOut ne 0
     1140         and mWaitFramTimeOut lt vtime
     1141      then do:
     1142         mWaitFramStopTimeOut = yes.
     1143      end.
     1144      return mWaitFramStopTimeOut.
     1145   end.
     1146   procedure waitfram-hide :
     1147     if not session:batch-mode
     1148     then do
     1149     on error undo, return error return-value
     1150     :
     1151       pause 0 before-hide .
     1152       if not mBatchMode then
     1153         hide frame waitfram .
     1154     if     not mWaitFramView
     1155        and mWaitProcEvent
     1156     then
     1157       process events .
     1158     end.
     1159   end procedure.
     1160   procedure waitfram-show :
     1161     define input  parameter p-message as character no-undo .
     1162     define variable v-left-margin as integer   no-undo .
     1163     if not session:batch-mode
     1164     then do
     1165     on error undo, return error return-value
     1166     :
     1167       if length(p-message) <= 70 then do:
     1168         assign
     1169           v-left-margin = integer((70 - length(p-message)) / 2)
     1170         .
     1171         assign
     1172           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1173         .
     1174         assign
     1175           v-waitfram-action01 = " "
     1176           v-waitfram-action02 = " "
     1177                                    + fill(" ", v-left-margin)
     1178                                    + p-message
     1179           v-waitfram-action03 = " "
     1180         .
     1181       end.
     1182       else do:
     1183         define variable vRindex1 as integer no-undo.
     1184         define variable vRindex2 as integer no-undo.
     1185         vRindex1 = r-index(p-message," ",70).
     1186         if vRindex1 = 0
     1187         then
     1188            vRindex1 = 70.
     1189         if length(p-message)  <= vRindex1 + 70 then do:
     1190           assign
     1191             v-waitfram-action01 = " "
     1192             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1193             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1194           .
     1195         end.
     1196         else do:
     1197           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1198           if vRindex2 <= vRindex1
     1199           then
     1200              vRindex2 = vRindex1 + 70.
     1201           assign
     1202             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1203             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1204             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1205           .
     1206         end.
     1207       end.
     1208       B-viewProcInfo:visible   in frame waitfram = no.
     1209       B-viewProcInfo:sensitive in frame waitfram = no.
     1210       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1211       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1212       if  (   mWaitFramView
     1213          or  mWaitProcEvent)
     1214          and not mBatchMode
     1215       then
     1216          display
     1217             v-waitfram-action01 skip
     1218             v-waitfram-action02 skip
     1219             v-waitfram-action03 skip
     1220          with frame waitfram .
     1221       if     mWaitFramView
     1222          then do:
     1223             if     mWaitFramInterval ne ?
     1224                and not mBatchMode
     1225             then
     1226                wait-for go of frame waitfram pause mWaitFramInterval.
     1227          end.
     1228          else
     1229             if     mWaitProcEvent
     1230                and not mBatchMode
     1231             then
     1232                process events .
     1233     end.
     1234   end procedure.
     1235      procedure waitfram-show-this:
     1236         define input  parameter iInterval as int64 no-undo.
     1237         define variable vtime as int64 no-undo.
     1238         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1239         mWaitFramInterval = iInterval.
     1240         run waitfram-show (substitute("&1&2 &3&4" ,
     1241                                       mWaitFramTextBeg ,
     1242                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1243                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1244                                       mWaitFramTextEnd
     1245                                      )
     1246                           ).
     1247      end.
     1248      procedure WaitFramRunPause:
     1249         define input  parameter iInterval as dec no-undo.
     1250         define variable vStart  as datetime-tz no-undo.
     1251         define variable vend    as datetime-tz no-undo.
     1252         define variable vint as int64 no-undo.
     1253         define variable vOk as logical no-undo.
     1254         vStart = now.
     1255         vend   = vStart.
     1256         publish "WaitFramPause" (iInterval,output vOk).
     1257         vend   =  now.
     1258         vint = vend - vStart.
     1259         vint = iInterval - vint / 1000.
     1260         if     not mWaitFramStop
     1261            and (   vint > 0
     1262                 or (    not vOk
     1263                     and iInterval eq ?
     1264                     )
     1265                 )
     1266         then
     1267            run waitfram-show-this (iInterval).
     1268         vend   =  now.
     1269         vint = vend - vStart.
     1270         vint = iInterval - vint / 1000.
     1271         if     not mWaitFramStop
     1272            and vint > 0
     1273         then do:
     1274            run gbl/pause.p (vint * 1000).
     1275         end.
     1276         if iInterval ne ?
     1277         then
     1278            publish "WaitFramStop".
     1279         waitfram-check-timeout().
     1280      end.
     1281      procedure WaitFramWaitFor:
     1282         define input  parameter iInterval as dec no-undo.
     1283         assign
     1284            mWaitFramStartProc   = now
     1285            mWaitFramStopUser    = no
     1286            mWaitFramStopTimeOut = no
     1287         .
     1288         block-wait:
     1289         do while not mWaitFramStop:
     1290            run WaitFramRunPause (iInterval).
     1291            if  waitfram-check-timeout()
     1292            then do:
     1293               leave block-wait.
     1294            end.
     1295         end.
     1296         run waitfram-hide.
     1297      end.
     1298   procedure waitfram-join :
     1299     define input  parameter p-line-1  as character no-undo .
     1300     define input  parameter p-line-2  as character no-undo .
     1301     define input  parameter p-line-3  as character no-undo .
     1302     define output parameter p-message as character no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       assign
     1307         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1308                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1309                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1310       .
     1311     end.
     1312   end procedure.
     1313   function waitfram-join-function returns character
     1314     (input p-line-1 as character
     1315     ,input p-line-2 as character
     1316     ,input p-line-3 as character
     1317     ).
     1318     define variable v-message as character no-undo .
     1319     run waitfram-join in this-procedure
     1320       (input  p-line-1
     1321       ,input  p-line-2
     1322       ,input  p-line-3
     1323       ,output v-message
     1324       ) .
     1325     return v-message .
     1326   end function .
     1327   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1328   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     1329                                                       ,input p-range-type as character
     1330                                                       ,input p-code as integer):
     1331   define variable v-seq-val as integer no-undo .
     1332   define buffer buf_code-range for ub.code-range.
     1333   find first buf_code-range no-lock where
     1334             buf_code-range.db-num = p-db-num
     1335       and  buf_code-range.range-type = p-range-type
     1336       and  buf_code-range.stts = 'u'
     1337       and buf_code-range.first-code <= p-code
     1338       and buf_code-range.last-code >= p-code no-error .
     1339   if available buf_code-range then return yes.
     1340   CASE p-range-type:
     1341     when 'pngb':U then do:
     1342       v-seq-val = current-value(s-pngb-code, ub).
     1343     end.
     1344     when 'fmgb':U then do:
     1345       v-seq-val = current-value(s-fmgb-code, ub).
     1346     end.
     1347   END CASE.
     1348   if p-code <= v-seq-val then do:
     1349     find first buf_code-range no-lock where
     1350               buf_code-range.db-num = p-db-num
     1351         and  buf_code-range.range-type = p-range-type
     1352         and  buf_code-range.stts = 'a'
     1353         and buf_code-range.first-code <= p-code
     1354         no-error .
     1355    if available buf_code-range then return yes.
     1356   end.
     1357   find first buf_code-range no-lock where
     1358             buf_code-range.db-num = p-db-num
     1359       and  buf_code-range.range-type = p-range-type
     1360       and  buf_code-range.stts = 'f'
     1361       and buf_code-range.first-code <= p-code
     1362       and buf_code-range.last-code >= p-code
     1363       no-error .
     1364   if available buf_code-range then return yes.
     1365   return no.
     1366   END FUNCTION.
     1367   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     1368                                                       ,input p-range-type as character
     1369                                                       ,input p-code as integer):
     1370   define variable v-seq-val as integer no-undo .
     1371   define buffer buf_code-range for ub.code-range.
     1372   CASE p-range-type:
     1373     when 'pngb':U then do:
     1374       v-seq-val = current-value(s-pngb-code, ub).
     1375     end.
     1376     when 'fmgb':U then do:
     1377       v-seq-val = current-value(s-fmgb-code, ub).
     1378     end.
     1379   END CASE.
     1380   if p-code <= v-seq-val then do:
     1381     find first buf_code-range no-lock where
     1382               buf_code-range.db-num = p-db-num
     1383         and  buf_code-range.range-type = p-range-type
     1384         and buf_code-range.first-code <= p-code
     1385         and buf_code-range.last-code >= p-code no-error .
     1386     if available buf_code-range then return yes.
     1387   end.
     1388   return no.
     1389   END FUNCTION.
     1390   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     1391                                                       ,input p-db-num as integer
     1392                                                       ,input p-staff-code as integer
     1393                                                       ,input p-date as date
     1394                                                        ):
     1395   define buffer buf_staff for ub.staff.
     1396   if p-date = ? then do:
     1397     p-date = today .
     1398   end.
     1399   find first buf_staff no-lock where
     1400             buf_staff.role = p-role
     1401         and buf_staff.role-level = 'db':U
     1402         and buf_staff.db-num = p-db-num
     1403         and buf_staff.staff-code = p-staff-code
     1404         and buf_staff.date-end >= p-date use-index pi  no-error .
     1405   if available buf_staff then do:
     1406     return buf_staff.psn-code.
     1407   end.
     1408   return 0.
     1409   end FUNCTION.
     1410   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     1411                                                             ,input p-db-num as integer
     1412                                                             ,input p-date as date
     1413                                                                 ):
     1414   define buffer buf_staff for ub.staff.
     1415   define buffer buf2_staff for ub.staff.
     1416   if p-date = ? then do:
     1417     p-date = today .
     1418   end.
     1419   for each  buf_staff no-lock where
     1420             buf_staff.role = p-role
     1421         and buf_staff.db-num = p-db-num,
     1422   first buf2_staff no-lock where
     1423         buf2_staff.role = p-role
     1424     and buf2_staff.role-level = 'db':U
     1425     and buf2_staff.staff-code = buf_staff.staff-code
     1426     and buf2_staff.date-start <= p-date
     1427     and buf2_staff.date-end >= p-date
     1428   by buf_staff.staff-code
     1429   by date-start descending:
     1430     return buf_staff.staff-code.
     1431   end.
     1432   end FUNCTION.
     1433   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     1434                                                  ,input p-db-num as integer
     1435                                                  ,input p-psn-code as integer
     1436                                                  ,input p-date as date
     1437                                                  ,output p-c-password as character
     1438                                                        ):
     1439   define buffer buf_staff for ub.staff.
     1440   if p-date = ? then do:
     1441     p-date = today .
     1442   end.
     1443   find first buf_staff no-lock where
     1444             buf_staff.role = p-role
     1445         and buf_staff.role-level = 'db':U
     1446         and buf_staff.db-num = p-db-num
     1447        and buf_staff.date-end >= p-date
     1448        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     1449   if available buf_staff
     1450   then do:
     1451     assign
     1452     p-c-password = buf_staff.password.
     1453     return buf_staff.staff-code.
     1454   end.
     1455   p-c-password = ''.
     1456   return 0.
     1457   end FUNCTION.
     1458   FUNCTION gbclcode-is-psn-role returns integer (
     1459                                                 input p-role as character
     1460                                                 ,input p-psn-code as integer
     1461                                                 ,input p-date as date
     1462                                                     ):
     1463   define buffer buf_staff for ub.staff.
     1464   if p-date = ? then do:
     1465     p-date = today .
     1466   end.
     1467   for each buf_staff no-lock where
     1468             buf_staff.psn-code = p-psn-code
     1469        and  buf_staff.role = p-role
     1470   by buf_staff.role-level
     1471   by buf_staff.date-start
     1472        :
     1473     if  buf_staff.date-start <= p-date and
     1474     buf_staff.date-end >= p-date  then do:
     1475       return buf_staff.staff-code.
     1476     end.
     1477   end.
     1478   return 0.
     1479   end FUNCTION.
     1480   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     1481   define variable v-role-name as character no-undo .
     1482   assign
     1483   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1484   no-error .
     1485   return v-role-name.
     1486   END.
     1487   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1488   FUNCTION gbclcode-get-position returns character ( input p-role as character
     1489                                                     ,input p-role-level as character
     1490                                                     ,input p-work-place as character
     1491                                                     ,input p-staff-code as integer
     1492                                                                ):
     1493   define variable v-role-name as character no-undo .
     1494   define variable v-role-level as character no-undo .
     1495   define variable v-staff-code as integer no-undo .
     1496   assign
     1497   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1498   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     1499   v-staff-code = p-staff-code
     1500   no-error .
     1501   return substitute("&1, &2, Код &3"
     1502                   ,v-role-name
     1503                   ,v-role-level
     1504                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     1505   END.
     1506   FUNCTION gbclcode-get-work-place returns character (
     1507                                                   input p-role as character
     1508                                                  ,input p-role-level as character
     1509                                                  ,input p-db-num as integer
     1510                                                  ,input p-host-code as integer
     1511                                                  ,input p-obj-type as character
     1512                                                  ,input p-obj-code as integer
     1513                                                  ) :
     1514   define variable v-work-place as character no-undo .
     1515   define variable v-obj-type as character no-undo .
     1516     case p-role-level:
     1517       when 'db':U then do:
     1518         v-work-place = string(p-db-num, "99999").
     1519       end.
     1520       when 'firm':U then do:
     1521         v-work-place = string(p-host-code, "99999").
     1522       end.
     1523       when 'object':U then do:
     1524         assign
     1525         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     1526         .
     1527       end.
     1528     END CASE.
     1529     return v-work-place.
     1530   END FUNCTION.
     1531   FUNCTION gbclcode-get-level-last-code returns integer (
     1532                                                           input p-role as character
     1533                                                         , input p-role-level as character
     1534                                                         , input p-work-place as character
     1535                                                         , input p-date-start as date
     1536                                                         ):
     1537   DEFINE VARIABLE v-today as date no-undo .
     1538   define buffer buf_staff for ub.staff.
     1539   if p-work-place = chr(63) then return ?.
     1540   if p-date-start = ? then do:
     1541     v-today = today .
     1542   end.
     1543   else do:
     1544     v-today = p-date-start.
     1545   end.
     1546   find last buf_staff no-lock where
     1547             buf_staff.role = p-role
     1548        and  buf_staff.role-level = p-role-level
     1549        and  buf_staff.work-place = p-work-place
     1550        and  buf_staff.date-start <= v-today + 1
     1551        and  buf_staff.date-end >= v-today + 1
     1552        use-index pi  no-error .
     1553   if available buf_staff
     1554   then return buf_staff.staff-code.
     1555   return 0.
     1556   end FUNCTION.
     1557   define variable g#report-num as integer no-undo .
     1558   if not valid-handle(my-handle) then do:
     1559     assign
     1560     my-handle = parparentproc.
     1561   end.
     1562   run get-report-num in parparentproc ( output g#report-num).
     1563   procedure OpenForExcel :
     1564      define variable v-ch#ExcelApplication as com-handle no-undo .
     1565      define variable v-ch#Workbook         as com-handle no-undo .
     1566      define variable v-ch#Worksheet        as com-handle no-undo .
     1567      os-delete value( string( session:temp-directory ) +
     1568                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1569      os-delete value( string( session:temp-directory ) +
     1570                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1571      os-delete value( string( session:temp-directory ) +
     1572                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1573      if Make-Excel
     1574      then do:
     1575         output stream ForExcel to value( string( session:temp-directory +
     1576                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1577         assign
     1578            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1579            number-list = 1
     1580         .
     1581         if make-excel-com
     1582         then do:
     1583   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1584   if valid-handle(ch#WorkSheet) then
     1585   RELEASE OBJECT ch#WorkSheet no-error.
     1586   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   if valid-handle(ch#Workbook) then
     1588   RELEASE OBJECT ch#Workbook no-error.
     1589   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1590   if valid-handle(ch#ExcelApplication) then
     1591   RELEASE OBJECT ch#ExcelApplication no-error.
     1592            create "Excel.Application" ch#excelApplication connect no-error.
     1593            if error-status:error
     1594            then do :
     1595           create "Excel.Application" ch#excelApplication no-error.
     1596       if error-status :error then do:
     1597           message
     1598           "Ошибка при запуске Excel" skip
     1599           error-status :get-message(1) skip
     1600           view-as alert-box error .
     1601           undo, return error .
     1602       end.
     1603            end.
     1604            assign
     1605               num#str#  = 0.
     1606               v-ch#excelApplication  = ch#excelApplication.
     1607               v-ch#excelApplication:Interactive = false.
     1608               v-ch#excelApplication:ScreenUpdating = false.
     1609               v-ch#excelApplication:Visible = false.
     1610               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1611               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1612               v-ch#Worksheet = ch#WorkSheet.
     1613               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1614               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1615               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1616               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1617            no-error .
     1618            if error-status:error
     1619            then do:
     1620               Make-Excel-com = false .
     1621               Make-Excel = false .
     1622               output Stream  ForExcel close.
     1623               os-delete value( string( session:temp-directory ) +
     1624                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1625               os-delete value( string( session:temp-directory ) +
     1626                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1627               return.
     1628            end.
     1629         end.
     1630      end.
     1631   end.
     1632   procedure CloseForExcel :
     1633      define variable ii as integer no-undo .
     1634      define variable vsheet-num as integer no-undo.
     1635      if Make-Excel
     1636      then  do:
     1637         output Stream  ForExcel close.
     1638         os-delete value( string( session:temp-directory ) +
     1639                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1640         os-delete value( string( session:temp-directory ) +
     1641                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1642         define buffer buf_sheetf for sheetf.
     1643         find last buf_sheetf no-error .
     1644         if available buf_sheetf
     1645         then
     1646            vsheet-num = buf_sheetf.sheet-num.
     1647         if vsheet-num > 1
     1648         then do:
     1649            do ii = 2 to vsheet-num:
     1650               os-delete value( string( session:temp-directory ) +
     1651                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1652            end.
     1653         end.
     1654   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1655   if valid-handle(ch#WorkSheet) then
     1656   RELEASE OBJECT ch#WorkSheet no-error.
     1657   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1658   if valid-handle(ch#Workbook) then
     1659   RELEASE OBJECT ch#Workbook no-error.
     1660   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   if valid-handle(ch#ExcelApplication) then
     1662   RELEASE OBJECT ch#ExcelApplication no-error.
     1663      end.
     1664   end.
     1665   DEFINE VARIABLE LINE as character no-undo.
     1666   DEFINE VARIABLE FOR-OBJ-type like ub.clients.obj-type NO-UNDO.
     1667   DEFINE VARIABLE FOR-OBJ-code like ub.clients.obj-code NO-UNDO.
     1668   DEFINE VARIABLE FOR-OBJ-name like ub.clients.obj-name NO-UNDO.
     1669   DEFINE VARIABLE FOR-grp-name like ub.clients.grp-name NO-UNDO.
     1670   DEFINE VARIABLE FOR-db-num   as character no-undo .
     1671   DEFINE VARIABLE FOR-stts as character NO-UNDO.
     1672   DEFINE VARIABLE FOR-is-prod like ub.clients.is-prod NO-UNDO.
     1673   DEFINE VARIABLE FOR-sup-gds like ub.clients.sup-gds NO-UNDO.
     1674   DEFINE VARIABLE FOR-sup-cons like ub.clients.sup-cons NO-UNDO.
     1675   DEFINE VARIABLE FOR-sup-serv like ub.clients.sup-serv NO-UNDO.
     1676   DEFINE VARIABLE FOR-buy-gds like ub.clients.buy-gds NO-UNDO.
     1677   DEFINE VARIABLE FOR-buy-cons like ub.clients.buy-cons NO-UNDO.
     1678   DEFINE VARIABLE FOR-buy-serv like ub.clients.buy-serv NO-UNDO.
     1679   DEFINE VARIABLE for-cashier like ub.staff.staff-code no-undo.
     1680   DEFINE VARIABLE for-seller like ub.staff.staff-code no-undo.
     1681   DEFINE VARIABLE for-dis-card like ub.dis-card.d-card no-undo.
     1682   DEFINE VARIABLE FOR-PS like ub.clients.PS NO-UNDO.
     1683   DEFINE VARIABLE fill3 as character no-undo.
     1684   DEFINE VARIABLE fill5 as character no-undo.
     1685   DEFINE VARIABLE fill6 as character no-undo.
     1686   DEFINE VARIABLE fill9 as character no-undo.
     1687   DEFINE VARIABLE fill16 as character no-undo.
     1688   DEFINE VARIABLE fill40 as character no-undo.
     1689   DEFINE VARIABLE fill80 as character no-undo.
     1690   DEFINE VARIABLE accum-count as integer no-undo.
     1691   DEFINE VARIABLE ii as integer no-undo.
     1692   DEFINE VARIABLE v-codes as character no-undo .
     1693   DEFINE VARIABLE v-labels as character no-undo .
     1694   DEFINE VARIABLE v-options as character no-undo .
     1695   define variable v-today as date no-undo .
     1696   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1697        VIEW-AS EDITOR
     1698        SIZE 1 BY 4 NO-UNDO.
     1699   DEFINE FRAME top-frame
     1700       t-1       AT ROW 1 COL 1 no-label
     1701       HEADER
     1702       cur-time-print() AT 5 format "X(35)"
     1703       string( "Страница" ) AT 45 PAGE-NUMBER( PRnLibStream ) AT 55 FORMAT ">>9" SKIP
     1704       with width 232 down stream-io use-text NO-BOX.
     1705    DEFINE FRAME Cli
     1706      with width 232 down stream-io use-text NO-BOX.
     1707   v-today = today .
     1708   CASE pReportOption:
     1709     when "excel":U then do:
     1710       Make-excel = yes.
     1711     end.
     1712     when "main":U then do:
     1713       do ii = 4 to 17:
     1714         use-column[ii] = no.
     1715       end.
     1716     end.
     1717     when "extended":U then do:
     1718       assign
     1719       Make-excel = yes
     1720       v-codes =  "grp-name,db-num,stts,is-prod,sup-gds,sup-cons,buy-gds,buy-cons,buy-serv,cashier,seller,is-d-card,PS":U
     1721       v-labels = "Группа клиентов" + chr(44) +
     1722                  "Номер БД" + chr(44) +
     1723                  "Статус" + chr(44) +
     1724                  "Производитель" + chr(44) +
     1725                  "Поставщик товаров" + chr(44) +
     1726                  "Консигнант" + chr(44) +
     1727                  "Покупатель товаров" + chr(44) +
     1728                  "Покупатель консигнационных товаров" + chr(44) +
     1729                  "Покупатель услуг" + chr(44) +
     1730                  "Код кассира" + chr(44) +
     1731                  "Код продавца" + chr(44) +
     1732                  "N дисконтной карты" + chr(44) +
     1733                  "Примечание"
     1734       .
     1735       run gbl/d-list.w (
     1736                    input "b-sel,b-mark":U
     1737                   ,input "Выберите дополнительные поля для печати"
     1738                   ,input v-codes
     1739                   ,input v-labels
     1740                   ,input chr(44)
     1741                   ,input "":U
     1742                   ,output v-options).
     1743       do ii = 1 to num-entries(v-codes):
     1744         use-column[ii + 3] = lookup(entry(ii, v-codes), v-options) > 0.
     1745       end.
     1746     end.
     1747   end.
     1748   assign
     1749   use-column[1] = yes
     1750   use-column[2] = yes
     1751   use-column[3] = yes
     1752   fill3 = fill("-", 3)
     1753   fill5 = fill("-", 5)
     1754   fill6 = fill("-", 6)
     1755   fill9 = fill("-", 9)
     1756   fill16 = fill("-", 16)
     1757   fill40 = fill("-", 40)
     1758   fill80 = fill("-", 80)
     1759   .
     1760   FOR EACH sheetf where sheetf.sheet-num > 1:
     1761     delete sheetf.
     1762   end.
