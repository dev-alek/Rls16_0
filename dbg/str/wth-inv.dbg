     2671       ,input (
     2672                "Код объекта" + ",,," +
     2673                "Тип объекта" +  ",,,Формирование автоматических документов МЦ"
     2674              )
     2675       ,input true
     2676       ,buffer auto-wth-doc-lock_batchprocess
     2677       ) no-error .
     2678     if error-status :error then do:
     2679       message
     2680         vss-workfile vss-revision vss-description skip
     2681         "В данный момент уже производится формирование автоматических документов МЦ" skip
     2682         view-as alert-box error .
     2683       undo, return error .
     2684     end.
     2685   end.
