     3056       if input frame Dialog-Frame tt-wth-doc.inv-prs5 <> ""
     3057          and input frame Dialog-Frame tt-wth-doc.inv-prs5 <> ? then
     3058         message "Из справочника клиентов Вы должны выбрать человека.".
     3059       run ref/cli-all.w (  input parparentproc
     3060                     ,  input "b-sel"
     3061                     ,  input 'чел':U
     3062                     ,  input ?
     3063                     ,  input ?
     3064                     ,  input ref-rec
     3065                     ,  input ",,,,,,NO"
     3066                     ,  input "lock-cli-type"
     3067                     , output ref-list ) .
     3068       assign v-ref-rec32 = integer( ref-list ).
     3069       ref-rec = integer( ref-list ) .
     3070       find cli-buf where recid (cli-buf) =
     3071          ref-rec
     3072          no-lock no-error.
     3073       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3074         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3075                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3076     end.
     3077     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3078       display cli-buf.obj-code @ tt-wth-doc.inv-prs5
     3079               cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3080       assign frame Dialog-Frame tt-wth-doc.inv-prs5.
     3081     end.
     3082     else display ? @ tt-wth-doc.inv-prs5
     3083                  ? @ inv-prs5-name with frame Dialog-Frame.
     3084     apply "entry" to  b-exit in frame Dialog-Frame.
     3085   if available cli-buf then do:
     3086         display cli-buf.obj-code @ tt-wth-doc.inv-prs5 cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3087     end.
     3088     else display ? @ tt-wth-doc.inv-prs5 ? @ inv-prs5-name with frame Dialog-Frame.
     3089         return no-apply.
     3090   end.
     3091   if p-man = "inv-prs5" and p-action = "button" then do:
     3092     define variable v-ref-rec33   as recid no-undo .
     3093     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3094                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3095     assign v-ref-rec33 = ( if available cli-buf then recid( cli-buf ) else ? ).
     3096     ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     3097     release cli-buf.
     3098     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3099       run ref/cli-all.w (  input parparentproc
     3100                     ,  input "b-sel"
     3101                     ,  input 'чел':U
     3102                     ,  input ?
     3103                     ,  input ?
     3104                     ,  input ref-rec
     3105                     ,  input ",,,,,,NO"
     3106                     ,  input "lock-cli-type"
     3107                     , output ref-list ) .
     3108       assign v-ref-rec33 = integer( ref-list ).
     3109       ref-rec = integer( ref-list ) .
     3110       find cli-buf where recid (cli-buf) =
     3111          ref-rec
     3112          no-lock no-error.
     3113       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3114         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3115                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3116     end.
     3117     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3118       display cli-buf.obj-code @ tt-wth-doc.inv-prs5
     3119               cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3120       assign frame Dialog-Frame tt-wth-doc.inv-prs5.
     3121     end.
     3122     else display ? @ tt-wth-doc.inv-prs5
     3123                  ? @ inv-prs5-name with frame Dialog-Frame.
     3124     apply "entry" to  b-exit in frame Dialog-Frame.
     3125   if available cli-buf then do:
     3126         display cli-buf.obj-code @ tt-wth-doc.inv-prs5 cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3127     end.
     3128     else display ? @ tt-wth-doc.inv-prs5 ? @ inv-prs5-name with frame Dialog-Frame.
     3129         return no-apply.
     3130   end.
     3131   if p-man = "inv-prs5" and p-action = "leave" then do:
     3132     define variable v-ref-rec34   as recid no-undo .
     3133     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3134                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3135   if available cli-buf then do:
     3136         display cli-buf.obj-code @ tt-wth-doc.inv-prs5 cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3137             assign frame Dialog-Frame tt-wth-doc.inv-prs5.
     3138     end.
     3139     else display ? @ tt-wth-doc.inv-prs5 ? @ inv-prs5-name with frame Dialog-Frame.
     3140   end.
     3141   END PROCEDURE.
     3142   PROCEDURE lock-peresort :
     3143   DEFINE INPUT PARAMETER par-peresort as logical no-undo.
     3144   CASE par-peresort :
     3145       when yes then do:
     3146           HIDE
     3147           tt-wth-doc.aft-sum in frame Dialog-Frame
     3148           tt-wth-doc.bef-sum in frame Dialog-Frame.
     3149           DISPLAY tt-wth-doc.fact-sum
     3150           with frame Dialog-Frame.
     3151       end.
     3152       when no then do:
     3153           DISPLAY
     3154           tt-wth-doc.bef-sum
     3155           tt-wth-doc.aft-sum when NOT tt-wth-doc.status_ = 'накл':U
     3156           with frame Dialog-Frame.
     3157           if tt-wth-doc.status_ = 'накл':U then
     3158           HIDE
     3159           tt-wth-doc.fact-sum
     3160           in frame Dialog-Frame.
     3161       end.
     3162   END CASE.
     3163   END PROCEDURE.
     3164   PROCEDURE MyEnable :
     3165   buf_wth-line.fact-sum:READ-ONLY IN BROWSE BR-lines = YES.
     3166     define variable v-ref-rec35   as recid no-undo .
     3167     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.operator
     3168                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3169   if not available cli-buf then do:
     3170     display tt-wth-doc.operator with frame Dialog-Frame.
     3171     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.operator
     3172                            and cli-buf.obj-type = 'чел':U no-error.
     3173   end.
     3174   if available cli-buf then do:
     3175         display cli-buf.obj-code @ tt-wth-doc.operator cli-buf.obj-name @ operator-name with frame Dialog-Frame.
     3176     end.
     3177     else display ? @ tt-wth-doc.operator ? @ operator-name with frame Dialog-Frame.
     3178     define variable v-ref-rec36   as recid no-undo .
     3179     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.deliver
     3180                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3181   if not available cli-buf then do:
     3182     display tt-wth-doc.deliver with frame Dialog-Frame.
     3183     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.deliver
     3184                            and cli-buf.obj-type = 'чел':U no-error.
     3185   end.
     3186   if available cli-buf then do:
     3187         display cli-buf.obj-code @ tt-wth-doc.deliver cli-buf.obj-name @ deliver-name with frame Dialog-Frame.
     3188     end.
     3189     else display ? @ tt-wth-doc.deliver ? @ deliver-name with frame Dialog-Frame.
     3190     define variable v-ref-rec37   as recid no-undo .
     3191     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.receiver
     3192                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3193   if not available cli-buf then do:
     3194     display tt-wth-doc.receiver with frame Dialog-Frame.
     3195     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.receiver
     3196                            and cli-buf.obj-type = 'чел':U no-error.
     3197   end.
     3198   if available cli-buf then do:
     3199         display cli-buf.obj-code @ tt-wth-doc.receiver cli-buf.obj-name @ receiver-name with frame Dialog-Frame.
     3200     end.
     3201     else display ? @ tt-wth-doc.receiver ? @ receiver-name with frame Dialog-Frame.
     3202     define variable v-ref-rec38   as recid no-undo .
     3203     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs4
     3204                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3205   if not available cli-buf then do:
     3206     display tt-wth-doc.inv-prs4 with frame Dialog-Frame.
     3207     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs4
     3208                            and cli-buf.obj-type = 'чел':U no-error.
     3209   end.
     3210   if available cli-buf then do:
     3211         display cli-buf.obj-code @ tt-wth-doc.inv-prs4 cli-buf.obj-name @ inv-prs4-name with frame Dialog-Frame.
     3212     end.
     3213     else display ? @ tt-wth-doc.inv-prs4 ? @ inv-prs4-name with frame Dialog-Frame.
     3214     define variable v-ref-rec39   as recid no-undo .
     3215     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3216                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3217   if not available cli-buf then do:
     3218     display tt-wth-doc.inv-prs5 with frame Dialog-Frame.
     3219     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.inv-prs5
     3220                            and cli-buf.obj-type = 'чел':U no-error.
     3221   end.
     3222   if available cli-buf then do:
     3223         display cli-buf.obj-code @ tt-wth-doc.inv-prs5 cli-buf.obj-name @ inv-prs5-name with frame Dialog-Frame.
     3224     end.
     3225     else display ? @ tt-wth-doc.inv-prs5 ? @ inv-prs5-name with frame Dialog-Frame.
     3226     IF AVAILABLE buf_obj THEN
     3227       DISPLAY buf_obj.obj-name @ for-object
     3228         WITH FRAME Dialog-Frame.
     3229     IF AVAILABLE tt-wth-doc THEN
     3230       DISPLAY
     3231       tt-wth-doc.fact-date
     3232       tt-wth-doc.doc-code
     3233       tt-wth-doc.doc-date
     3234       tt-wth-doc.shift-num
     3235       tt-wth-doc.shift-name
     3236       tt-wth-doc.shift-date
     3237       tt-wth-doc.obj-code
     3238       tt-wth-doc.obj-type
     3239       tt-wth-doc.bef-sum
     3240       tt-wth-doc.aft-sum
     3241       tt-wth-doc.fact-sum
     3242       tt-wth-doc.operator
     3243       tt-wth-doc.deliver
     3244       tt-wth-doc.receiver
     3245       tt-wth-doc.inv-prs4
     3246       tt-wth-doc.inv-prs5
     3247       WITH FRAME Dialog-Frame.
     3248       IF par-mode = 'ДОБАВЛЕНИЕ':U OR
     3249           par-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3250         IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     3251           ENABLE
     3252           tt-wth-doc.doc-date
     3253           b-add
     3254           b-del
     3255           b-chg when Not tt-wth-doc.auto-fill
     3256           b-quit
     3257           WITH FRAME Dialog-Frame.
     3258           HIDE
     3259           tt-wth-doc.fact-date IN FRAME Dialog-Frame
     3260           tt-wth-doc.aft-sum  IN FRAME Dialog-Frame
     3261           tt-wth-doc.fact-sum  IN FRAME Dialog-Frame
     3262           .
     3263         END.
     3264         ELSE DO:
     3265              b-exit:label = "&Выход".
     3266           IF tt-wth-doc.status_ = 'накл':U      THEN DO:
     3267               ENABLE
     3268               tt-wth-doc.doc-date
     3269               b-add
     3270               b-del
     3271               b-chg when Not tt-wth-doc.auto-fill
     3272               WITH FRAME Dialog-Frame.
     3273               HIDE
     3274               b-quit
     3275               tt-wth-doc.fact-date IN FRAME Dialog-Frame
     3276               tt-wth-doc.fact-sum  IN FRAME Dialog-Frame
     3277                           tt-wth-doc.aft-sum  IN FRAME Dialog-Frame
     3278               .
     3279           END.
     3280           ELSE IF tt-wth-doc.status_ = 'разрешен':U THEN DO:
     3281             HIDE
     3282             tt-wth-doc.fact-date
     3283             IN FRAME Dialog-Frame.
     3284             ENABLE
     3285             tt-wth-doc.aft-sum
     3286             b-chg when Not tt-wth-doc.auto-fill
     3287             WITH FRAME Dialog-Frame.
     3288           END.
     3289         END.
     3290         ENABLE
     3291         tt-wth-doc.operator
     3292         tt-wth-doc.deliver
     3293         tt-wth-doc.receiver
     3294         tt-wth-doc.inv-prs4
     3295         tt-wth-doc.inv-prs5
     3296         b-person1
     3297         b-person2
     3298         b-person3
     3299         b-person4
     3300         b-person5
     3301         B-exit
     3302         b-lookup
     3303         WITH FRAME Dialog-Frame.
     3304         HIDE
     3305         b-prev IN FRAME Dialog-Frame
     3306         B-Next IN FRAME Dialog-Frame
     3307         .
     3308       END.
     3309       ELSE IF par-mode = 'ПРОСМОТР':U  THEN DO:
     3310         assign
     3311         b-quit:label = "&Выход"
     3312         b-quit:col = 1
     3313         .
     3314         ENABLE
     3315         B-Prev
     3316         B-Next
     3317         b-quit
     3318         WITH FRAME Dialog-Frame.
     3319         HIDE
     3320         b-exit
     3321         B-person1 IN FRAME Dialog-Frame
     3322         B-person2  IN FRAME Dialog-Frame
     3323         B-person3 IN FRAME Dialog-Frame
     3324         B-person4 IN FRAME Dialog-Frame
     3325         B-person5 IN FRAME Dialog-Frame
     3326         tt-wth-doc.fact-date IN FRAME Dialog-Frame
     3327         .
     3328       END.
     3329       ENABLE
     3330       b-help
     3331       br-lines
     3332       b-lookup
     3333       b-hist when par-mode <> 'ДОБАВЛЕНИЕ':U
     3334       b-chk when tt-wth-doc.auto-fill
     3335       WITH FRAME Dialog-Frame.
     3336       run control-peresort(output var-peresort) no-error.
     3337       run lock-peresort(input var-peresort) no-error.
     3338       OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK,              EACH buf_wth-place WHERE buf_wth-place.obj-type = buf_wth-line.obj-type AND buf_wth-place.obj-code = buf_wth-line.obj-code AND buf_wth-place.w-p-code = buf_wth-line.w-p-code  NO-LOCK.
     3339       REPOSITION br-lines TO ROW 1 NO-ERROR.
     3340       APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     3341       APPLY "VALUE-CHANGED":U TO br-lines IN FRAME Dialog-Frame.
     3342       parext-doc-name = ENTRY(LOOKUP(parext-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) no-error.
     3343       assign
     3344       FRAME Dialog-Frame :TITLE = SUBSTITUTE("Инвентаризационная ведомость движения материальных ценностей № &1  - &2"
     3345                                                ,tt-wth-doc.doc-code
     3346                                                ,CAPS( parext-doc-name )).
     3347       VIEW FRAME Dialog-Frame.
     3348   END PROCEDURE.
     3349   PROCEDURE proc-b-add :
     3350   DEFINE VARIABLE loc-ref-list as character no-undo .
     3351   DEFINE VARIABLE valid-chk-type-list as character no-undo .
     3352   DEFINE VARIABLE valid-w-p-code like ub.wth-place.w-p-code .
     3353   DEFINE VARIABLE ii as integer no-undo .
     3354   DEFINE VARIABLE ii-ok as integer no-undo .
     3355   define variable v-doc-rec as recid no-undo .
     3356   define variable v-line-rec as recid no-undo .
     3357   define buffer what_chk-doc  for ub.chk-doc .
     3358   define buffer buf_chk-doc  for ub.chk-doc .
     3359   define buffer cash_wth-place for ub.wth-place.
     3360   run proc-save-doc(no) No-ERROR.
     3361   if error-status:error
     3362   or return-value = 'error'
     3363   then return error.
     3364   CASE tt-wth-doc.auto-fill:
     3365     when no then do:
     3366       assign
     3367       v-doc-rec = recid(bf_wth-doc)
     3368       v-line-rec = ?
     3369       .
     3370       run str/wth-inva.w (input parparentproc,
     3371                       INPUT 'ДОБАВЛЕНИЕ':U,
     3372                       input v-doc-rec,
     3373                       input-output v-LINE-REC
     3374                       ) no-error.
     3375       if error-status:error then do:
     3376         return 'error'.
     3377       end.
     3378    end.
     3379    when yes then do:
     3380       FIND FIRST what_chk-doc No-LOCK WHERE
     3381                  what_chk-doc.out-code = tt-wth-doc.doc-code No-ERROR.
     3382       if available what_chk-doc then do:
     3383         assign
     3384         valid-chk-type-list = string(what_chk-doc.chk-type).
     3385         FIND FIRST cash_wth-place No-LOCK WHERE
     3386                    cash_Wth-place.obj-type = parobj-type AND
     3387                    cash_Wth-place.obj-code = parobj-code AND
     3388                    cash_wth-place.cash-desk = what_chk-doc.pay-desk No-ERROR.
     3389         if not avail cash_wth-place then do:
     3390           message
     3391           "Не найдено МХ, соответствующее кассе, пробившей чеки, включенные в документ"
     3392           view-as alert-box error .
     3393           return 'error'.
     3394         end.
     3395         valid-w-p-code = cash_wth-place.w-p-code.
     3396         run str/chk-docs.w (
     3397                         input parparentproc
     3398                        ,input 'b-sel,b-mark':U
     3399                        ,input 'free':U
     3400                        ,input ?
     3401                        ,input parobj-type
     3402                        ,input parobj-code
     3403                        ,input '':U
     3404                        ,input '':U
     3405                        ,input 0
     3406                        ,input ?
     3407                        ,input ?
     3408                        ,input what_chk-doc.chk-type
     3409                        ,output loc-ref-list) no-error.
     3410         if error-status:error then return 'error'.
     3411       end.
     3412       else do:
     3413         assign
     3414         valid-w-p-code = 0
     3415         valid-chk-type-list = '7':U + chr(44) + '4':U.
     3416         run str/chk-docs.w (
     3417                        input parparentproc
     3418                       ,input 'b-sel,b-mark':U
     3419                       ,input 'free':U
     3420                       ,input ?
     3421                       ,input parobj-type
     3422                       ,input parobj-code
     3423                       ,input '':U
     3424                       ,input '':U
     3425                       ,input 0
     3426                       ,input ?
     3427                       ,input ?
     3428                       ,input 0
     3429                        ,output loc-ref-list) no-error.
     3430         if error-status:error then return 'error'.
     3431       end.
     3432       if loc-ref-list = "":U then return.
     3433     _ii:
     3434     DO ii = 1 to num-entries(loc-ref-list):
     3435     find first buf_chk-doc exclusive-lock where
     3436                     recid(buf_chk-doc) = integer(entry(ii, loc-ref-list)) No-ERROR.
     3437         if not avail buf_chk-doc or
     3438           LOOKUP(string(buf_chk-doc.chk-type), valid-chk-type-list) = 0 then NEXT _ii.
     3439         if tt-wth-doc.shift-date = ? then do:
     3440           if buf_chk-doc.shift-date <> tt-wth-doc.doc-date then NEXT _ii.
     3441         end.
     3442         else do:
     3443           if NOT (buf_chk-doc.shift-date = tt-wth-doc.shift-date AND
     3444                   buf_chk-doc.shift-num = tt-wth-doc.shift-num) then NEXT _ii.
     3445         end.
     3446         if avail(what_chk-doc) and buf_chk-doc.pay-desk <> what_chk-doc.pay-desk then NEXT _ii.
     3447         run str/inc-wth1.p (
     3448          buffer buf_chk-doc
     3449         ,input 1
     3450         ,input tt-wth-doc.doc-code
     3451         ,input valid-w-p-code
     3452         ,input 0
     3453         ,input tt-wth-doc.ext-doc-type
     3454         ,input buf_chk-doc.chk-type
     3455         ,input no
     3456         ) no-error .
     3457         if error-status:error then NEXT _ii.
     3458         ii-ok = ii-ok + 1.
     3459     END.
     3460     if ii - 1 <> ii-ok then do:
     3461       message
     3462       "Из выбранных Вами " (ii - 1) "чеков"
     3463       "удалось включить в документ" ii-ok
     3464       view-as alert-box WARNING.
     3465     end.
     3466     end.
     3467   END CASE.
     3468   FIND current bf_wth-doc EXCLUSIVE-LOCK.
     3469   run MyEnable in this-Procedure.
     3470   OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK,              EACH buf_wth-place WHERE buf_wth-place.obj-type = buf_wth-line.obj-type AND buf_wth-place.obj-code = buf_wth-line.obj-code AND buf_wth-place.w-p-code = buf_wth-line.w-p-code  NO-LOCK.
     3471   reposition br-lines to recid v-line-rec no-error.
     3472   apply "entry" to br-lines in frame Dialog-Frame.
     3473   END PROCEDURE.
     3474   PROCEDURE proc-b-del :
     3475   DEFINE VARIABLE loc-ref-list as character no-undo .
     3476   DEFINE VARIABLE ii as integer no-undo.
     3477   DEFINE VARIABLE ii-ok as integer no-undo.
     3478   define variable v-line-rec as recid no-undo .
     3479   DEFINE buffer buf_chk-doc for ub.chk-doc .
     3480   if not avail buf_wth-line then return no-apply.
     3481     IF tt-wth-doc.status_ <> 'накл':U THEN DO:
     3482       MESSAGE "Документ закрыт - удалять матценности нельзя!"
     3483       VIEW-AS ALERT-BOX ERROR.
     3484       RETURN NO-APPLY.
     3485   END.
     3486   CASE tt-wth-doc.auto-fill:
     3487     when no then do:
     3488       MESSAGE
     3489       "Вы уверены, что хотите удалить строку?"
     3490       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3491       IF glog <> YES THEN DO:
     3492         RETURN NO-APPLY.
     3493       END.
     3494       ASSIGN v-line-rec = RECID( buf_wth-line).
     3495       Erase-Block:
     3496       DO ON ERROR UNDO Erase-Block, LEAVE Erase-Block
     3497         ON STOP  UNDO Erase-Block, LEAVE Erase-Block :
     3498         FIND FIRST buf_wth-line EXCLUSIVE-LOCK WHERE
     3499                           RECID( buf_wth-line ) = v-line-rec.
     3500         run str/wth-lnv1.p (
     3501                          input-output v-line-rec
     3502                         ,input  'удаление':U
     3503                         ,input buf_wth-line.doc-code
     3504                         ,input buf_wth-line.wth-code
     3505                         ,input buf_wth-line.w-p-code
     3506                         ,input (- buf_wth-line.bef-sum)
     3507                         ,input (- buf_wth-line.aft-sum)
     3508                         ,input table tt-par-dtl
     3509                         ,input glog
     3510                         ) .
     3511         DELETE buf_wth-line.
     3512       END.
     3513     end.
     3514     when yes then do:
     3515       run str/chk-docs.w (
     3516                      input parparentproc
     3517                     ,input 'b-sel,b-mark':U
     3518                     ,input 'out-code':U
     3519                     ,input ?
     3520                     ,input parobj-type
     3521                     ,input parobj-code
     3522                     ,input tt-wth-doc.doc-code
     3523                     ,input ''
     3524                     ,input 0
     3525                     ,input ?
     3526                     ,input ?
     3527                     ,input 0
     3528                     ,output loc-ref-list) no-error.
     3529       if error-status:error then return error.
     3530       if loc-ref-list = '':U then return.
     3531        _ii:
     3532     DO ii = 1 to num-entries(loc-ref-list):
     3533     find first buf_chk-doc exclusive-lock where
     3534                     recid(buf_chk-doc) = integer(entry(ii, loc-ref-list)) No-ERROR.
     3535         if not avail buf_chk-doc or
     3536           buf_chk-doc.out-code <> tt-wth-doc.doc-code then NEXT _ii.
     3537         run str/inc-wth1.p (
     3538           buffer buf_chk-doc
     3539         ,input - 1
     3540         ,input tt-wth-doc.doc-code
     3541         ,input 0
     3542         ,input 0
     3543         ,input tt-wth-doc.ext-doc-type
     3544         ,input buf_chk-doc.chk-type
     3545         ,input no
     3546         ) no-error .
     3547         if error-status:error then NEXT _ii.
     3548         ii-ok = ii-ok + 1.
     3549     END.
     3550     if ii - 1 <> ii-ok then do:
     3551       message
     3552       "Из выбранных Вами " (ii - 1) "чеков"
     3553       "удалось удалить из документа" ii-ok
     3554       view-as alert-box WARNING.
     3555     end.
     3556     end.
     3557   END CASE.
     3558   assign
     3559   tt-wth-doc.doc-sum = bf_wth-doc.doc-sum
     3560   tt-wth-doc.fact-sum = bf_wth-doc.fact-sum
     3561   tt-wth-doc.bef-sum = bf_wth-doc.bef-sum
     3562   tt-wth-doc.aft-sum = bf_wth-doc.aft-sum
     3563   .
     3564   RUN Myenable in this-procedure .
     3565   END PROCEDURE.
     3566   PROCEDURE proc-save-doc :
     3567    define input parameter parlines-exist as logical no-undo .
     3568    define variable v-doc-rec as recid no-undo .
     3569    define variable varcli-name as character no-undo .
     3570    IF par-mode = 'ПРОСМОТР':U THEN DO:
     3571       RETURN NO-APPLY.
     3572    END.
     3573    assign
     3574    tt-wth-doc.doc-date frame Dialog-Frame
     3575    tt-wth-doc.operator
     3576    tt-wth-doc.deliver
     3577    tt-wth-doc.receiver
     3578    tt-wth-doc.inv-prs4
     3579    tt-wth-doc.inv-prs5
     3580    .
     3581   run trg/wth-inv2.p (
     3582                    input no
     3583                   ,input tt-wth-doc.doc-code
     3584                   ,input tt-wth-doc.host-code
     3585                   ,input tt-wth-doc.obj-type
     3586                   ,input tt-wth-doc.obj-code
     3587                   ,input tt-wth-doc.operator
     3588                   ,input tt-wth-doc.deliver
     3589                   ,input tt-wth-doc.receiver
     3590                   ,input tt-wth-doc.inv-prs4
     3591                   ,input tt-wth-doc.inv-prs5
     3592                   ,input tt-wth-doc.auto-fill
     3593                   ,input parlines-exist
     3594                   ,input no
     3595                   ,output varcli-name) no-error.
     3596   if error-status:error then do:
     3597   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3598   define variable fh as widget-handle no-undo .
     3599   define variable hh as widget-handle no-undo .
     3600   define variable rv as character no-undo .
     3601   assign
     3602   rv = entry(1, return-value , chr(4)).
     3603   if rv <> "":U then do:
     3604     assign
     3605     fh = frame Dialog-Frame:first-child
     3606     hh = fh:first-child
     3607     .
     3608     do while valid-handle(hh):
     3609       if hh:name = rv then do:
     3610         APPLY "ENTRY" to hh.
     3611         return 'error'.
     3612       end.
     3613       hh = hh:next-sibling.
     3614     end.
     3615   end.
     3616   end.
     3617    v-doc-rec = recid(bf_wth-doc).
     3618     run str/wth-inv1.p (
     3619                     input no
     3620                    ,input-output v-doc-rec
     3621                    ,input        'ИЗМЕНЕНИЕ':U
     3622                    ,input tt-wth-doc.doc-code
     3623                    ,input tt-wth-doc.host-code
     3624                    ,input tt-wth-doc.obj-type
     3625                    ,input tt-wth-doc.obj-code
     3626                    ,input tt-wth-doc.doc-date
     3627                    ,input tt-wth-doc.fact-date
     3628                    ,input tt-wth-doc.shift-date
     3629                    ,input tt-wth-doc.shift-num
     3630                    ,input tt-wth-doc.shift-name
     3631                    ,input tt-wth-doc.operator
     3632                    ,input tt-wth-doc.deliver
     3633                    ,input tt-wth-doc.receiver
     3634                    ,input tt-wth-doc.inv-prs4
     3635                    ,input tt-wth-doc.inv-prs5
     3636                    ,input tt-wth-doc.auto-fill
     3637                    ,input tt-wth-doc.bef-sum
     3638                    ,input tt-wth-doc.aft-sum
     3639                    ,input tt-wth-doc.PS
     3640                    ,input tt-wth-doc.status_
     3641                    ,input parlines-exist
     3642                    ) no-error .
     3643       IF ERROR-STATUS:ERROR THEN DO:
     3644       if return-value <> '':U then do:
     3645         CASE return-value:
     3646           when "operator":U then do:
     3647             APPLY "ENTRY":U TO tt-wth-doc.operator IN FRAME Dialog-Frame.
     3648           end.
     3649           when "aft-sum":U then do:
     3650             APPLY "ENTRY":U TO tt-wth-doc.aft-sum IN FRAME Dialog-Frame.
     3651           end.
     3652           when "deliver":U then do:
     3653             APPLY "ENTRY":U TO tt-wth-doc.deliver IN FRAME Dialog-Frame.
     3654           end.
     3655           when "receiver":U then do:
     3656             APPLY "ENTRY":U TO tt-wth-doc.receiver IN FRAME Dialog-Frame.
     3657           end.
     3658           when "inv-prs4":U then do:
     3659             APPLY "ENTRY":U TO tt-wth-doc.inv-prs4 IN FRAME Dialog-Frame.
     3660           end.
     3661           when "inv-prs5":U then do:
     3662             APPLY "ENTRY":U TO tt-wth-doc.inv-prs5 IN FRAME Dialog-Frame.
     3663           end.
     3664           when "b-add":U then do:
     3665             APPLY "ENTRY":U TO b-add IN FRAME Dialog-Frame.
     3666           end.
     3667         END CASE.
     3668       end.
     3669       RETURN error.
     3670     END.
     3671   END PROCEDURE.
     3672   PROCEDURE reposition-wth-doc :
     3673   define input parameter p-direction as character no-undo .
     3674   define variable v-new-wth-doc-recid as recid no-undo .
     3675   do
     3676   on error undo, return error
     3677   :
     3678     if valid-handle(p-call-prog)
     3679     then do:
     3680       run reposition-wth-doc in p-call-prog
     3681         (input  p-direction
     3682         ,output v-new-wth-doc-recid
     3683         ).
     3684       if v-new-wth-doc-recid <> ?
     3685       then do:
     3686         define buffer buf_wth-doc for ub.wth-doc .
     3687         find first buf_wth-doc no-lock
     3688           where recid(buf_wth-doc) = v-new-wth-doc-recid
     3689           no-error .
     3690         assign
     3691         p-doc-rec = v-new-wth-doc-recid
     3692         p-next-prev = '':U
     3693         .
     3694       end.
     3695     end.
     3696     else do:
     3697       message "Список документов МЦ не определен." view-as alert-box INFORMATION .
     3698       return no-apply.
     3699     end.
     3700     END.
     3701   END PROCEDURE.
