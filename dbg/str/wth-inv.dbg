     1033           define variable ii              as integer       no-undo .
     1034           define variable fh              as widget-handle no-undo .
     1035           define variable hh              as widget-handle no-undo .
     1036           define variable v-h             as handle        extent 4 no-undo .
     1037           define variable v-name-button   as character     no-undo .
     1038           define variable v-help-old-x    as decimal       no-undo .
     1039           define variable v-help-old-y    as decimal       no-undo .
     1040           define variable v-help-old-size as decimal       no-undo .
     1041           define variable v-frame-width   as decimal       no-undo .
     1042           define variable jj              as integer       no-undo .
     1043           do
     1044               on error undo, return error
     1045               :
     1046               assign
     1047                   v-frame-width = frame Dialog-Frame:width - 0.3
     1048                   fh            = frame Dialog-Frame:first-child
     1049                   hh            = fh:first-child
     1050                   ii            = 1
     1051                   .
     1052               do while valid-handle(hh):
     1053                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1054                   do:
     1055                       case lc(hh:name) :
     1056                           when "b-help" then
     1057                               do:
     1058                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1059                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1060                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1061                                   hh:TOOLTIP = "Помощь" .
     1062                                   v-help-old-x = hh:column .
     1063                                   v-help-old-y = hh:row    .
     1064                                   v-help-old-size = hh:width .
     1065                                   hh:width-chars = 2.5 .
     1066                               end.
     1067                           when "b-print" then
     1068                               do:
     1069                                   hh:load-image("cmp/b-print.bmp":u) .
     1070                                   hh:TOOLTIP = "Печать" .
     1071                                   v-h[ii] = hh:handle .
     1072                                   ii = ii + 1 .
     1073                                   hh:width-chars = 3 .
     1074                               end.
     1075                           when "b-history" or
     1076                           when "b-hist" then
     1077                               do:
     1078                                   hh:load-image("cmp/b-hist.bmp":u) .
     1079                                   hh:TOOLTIP = "История" .
     1080                                   v-h[ii] = hh:handle .
     1081                                   ii = ii + 1 .
     1082                                   hh:width-chars = 3 .
     1083                               end.
     1084                           when "b-sch" then
     1085                               do:
     1086                                   hh:load-image("cmp/b-sch.bmp":u) .
     1087                                   hh:TOOLTIP = "Установка Фильтра" .
     1088                                   v-h[ii] = hh:handle .
     1089                                   ii = ii + 1 .
     1090                                   hh:width-chars = 3 .
     1091                               end.
     1092                           when "b-hist-user" then
     1093                               do:
     1094                                   hh:load-image("cmp/b-hist.bmp":u) .
     1095                                   hh:TOOLTIP = "История пользователя" .
     1096                                   ii = ii + 1 .
     1097                               end.
     1098                       end case.
     1099                   end.
     1100                   hh = hh:next-sibling.
     1101               end.
     1102               b-help:column = v-frame-width - b-help:width-chars.
     1103               jj = 0.
     1104               repeat ii = 4 to 1 by -1 :
     1105                   if valid-handle (v-h[ii] ) then
     1106                   do:
     1107                       jj  = jj + 1 .
     1108                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1109                       v-h[ii]:row    = v-help-old-y .
     1110                   end.
     1111               end.
     1112           end.
     1113       end.
     1114   end procedure.
     1115   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1116   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1117   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1118   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1119   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1120   define variable v-diasize-current-frame-height as decimal   no-undo .
     1121   define variable v-diasize-change-size          as logical   no-undo .
     1122   define variable v-diasize-resize-button        as handle    no-undo .
     1123   define variable v-diasize-wndmax               as logical   no-undo .
     1124   define variable v-diasize-wndstore             as logical   no-undo .
     1125   define variable v-diasize-proc-name            as character no-undo .
     1126   define variable v-diasize-browse-handle        as handle    no-undo .
     1127   define variable v-diasize-browse-number        as integer   no-undo .
     1128   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1129   define temp-table temp-diasize-handle no-undo
     1130     field handle-value  as handle
     1131     field save-position as decimal
     1132     index xpk is primary unique handle-value
     1133     .
     1134   define temp-table temp-browse-handle no-undo
     1135     field browse-type   as character
     1136     field browse-number as integer
     1137     field browse-handle as handle
     1138     field original-size as decimal
     1139     index xpk is primary unique browse-type browse-number
     1140     index xie browse-type browse-handle
     1141   .
     1142   procedure diasize_change-height :
     1143     define input  parameter p-change-value  as decimal   no-undo .
     1144     define input  parameter p-move-resize   as logical   no-undo .
     1145     define variable v-field-group-handle    as handle    no-undo .
     1146     define variable v-object-handle         as handle    no-undo .
     1147     define variable v-frame-height          as decimal   no-undo .
     1148     define variable v-frame-virtual-height  as decimal   no-undo .
     1149     define variable v-browse-height         as decimal   no-undo .
     1150     define variable v-window-height         as decimal   no-undo .
     1151     define variable v-window-virtual-height as decimal   no-undo .
     1152     define variable v-change-sign           as integer   no-undo .
     1153     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1154     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1155     if p-change-value > 0
     1156     then do:
     1157       if frame Dialog-Frame :height + p-change-value
     1158           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1159       then do:
     1160         assign
     1161           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1162                           - (frame Dialog-Frame :height-chars)
     1163         .
     1164         if p-change-value <= 0
     1165         then do:
     1166           run diasize_position-resize-button in this-procedure .
     1167           return .
     1168         end.
     1169       end.
     1170     end.
     1171     if p-change-value < 0
     1172     then do:
     1173       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1174       then do:
     1175         assign
     1176           p-change-value = v-diasize-orig-frame-height
     1177                          - (frame Dialog-Frame :height-chars)
     1178         .
     1179         if p-change-value >= 0
     1180         then do:
     1181           run diasize_position-resize-button in this-procedure .
     1182           return .
     1183         end.
     1184       end.
     1185     end.
     1186     if p-change-value >= 0
     1187     then do:
     1188       assign
     1189         v-change-sign = 1
     1190       .
     1191     end.
     1192     else do:
     1193       assign
     1194         v-change-sign = -1
     1195       .
     1196     end.
     1197     assign
     1198       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1199     .
     1200     if p-change-value = 0
     1201     then do:
     1202       run diasize_position-resize-button in this-procedure .
     1203       return .
     1204     end.
     1205     move_block:
     1206     do
     1207     on error undo move_block, retry move_block
     1208     :
     1209       if retry
     1210       then do:
     1211         do
     1212         on error undo move_block, leave move_block
     1213         :
     1214           if p-change-value > 0
     1215           then do:
     1216             for each buf_temp-diasize-handle
     1217             on error undo, next
     1218             :
     1219               assign
     1220                 v-object-handle = buf_temp-diasize-handle.handle-value
     1221               .
     1222               if v-object-handle <> v-diasize-resize-button
     1223               then do:
     1224                 assign
     1225                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1226                 .
     1227               end.
     1228             end.
     1229             assign
     1230               v-diasize-browse-handle :height = v-browse-height
     1231             .
     1232             for each buf_temp-browse-handle
     1233               where buf_temp-browse-handle.browse-type = 'height':u
     1234             on error undo, next
     1235             :
     1236               assign
     1237                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1238               .
     1239             end.
     1240             assign
     1241               frame Dialog-Frame :height = v-frame-height
     1242             .
     1243             if frame Dialog-Frame :scrollable = true
     1244             then do:
     1245               assign
     1246                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1247               .
     1248             end.
     1249             run diasize_position-resize-button in this-procedure .
     1250           end.
     1251           else do:
     1252             if frame Dialog-Frame :scrollable = true
     1253             then do:
     1254               assign
     1255                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1256               .
     1257             end.
     1258             assign
     1259               frame Dialog-Frame :height = v-frame-height
     1260             .
     1261             assign
     1262               v-diasize-browse-handle :height = v-browse-height
     1263             .
     1264             for each buf_temp-browse-handle
     1265               where buf_temp-browse-handle.browse-type = 'height':u
     1266             on error undo, next
     1267             :
     1268               assign
     1269                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1270               .
     1271             end.
     1272             for each buf_temp-diasize-handle
     1273             on error undo, next
     1274             :
     1275               assign
     1276                 v-object-handle = buf_temp-diasize-handle.handle-value
     1277               .
     1278               if v-object-handle <> v-diasize-resize-button
     1279               then do:
     1280                 assign
     1281                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1282                 .
     1283               end.
     1284             end.
     1285             run diasize_position-resize-button in this-procedure .
     1286           end.
     1287           assign
     1288             v-diasize-change-size = false
     1289           .
     1290           leave move_block .
     1291         end.
     1292       end.
     1293       assign
     1294         v-diasize-need-full-display = true
     1295       .
     1296       if v-diasize-change-size = false
     1297       then do:
     1298         assign
     1299           v-diasize-change-size = true
     1300         .
     1301       end.
     1302       else do:
     1303         return .
     1304       end.
     1305       assign
     1306         v-frame-height = frame Dialog-Frame :height
     1307         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1308         v-browse-height = v-diasize-browse-handle :height
     1309       .
     1310       for each buf_temp-browse-handle
     1311         where buf_temp-browse-handle.browse-type = 'height':u
     1312       :
     1313         assign
     1314           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1315         .
     1316       end.
     1317       for each buf_temp-diasize-handle
     1318       :
     1319         delete buf_temp-diasize-handle .
     1320       end.
     1321       assign
     1322         v-field-group-handle = frame Dialog-Frame :first-child
     1323       .
     1324       do while valid-handle(v-field-group-handle)
     1325       :
     1326         assign
     1327           v-object-handle = v-field-group-handle :first-child
     1328         .
     1329         do while valid-handle(v-object-handle)
     1330         :
     1331           if  v-object-handle <> v-diasize-browse-handle :handle
     1332           and can-query(v-object-handle, "row")
     1333           and can-query(v-object-handle, "height")
     1334           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1335           then do:
     1336             find first buf_temp-browse-handle
     1337               where buf_temp-browse-handle.browse-type   = 'height':u
     1338                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1339               no-error .
     1340             if available buf_temp-browse-handle
     1341             then do:
     1342             end.
     1343             else do:
     1344               create buf_temp-diasize-handle .
     1345               assign
     1346                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1347                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1348               .
     1349             end.
     1350           end.
     1351           assign
     1352             v-object-handle = v-object-handle :next-sibling
     1353           .
     1354         end.
     1355         assign
     1356           v-field-group-handle = v-field-group-handle :next-sibling
     1357         .
     1358       end.
     1359       do with frame Dialog-Frame
     1360       :
     1361         hide v-diasize-resize-button .
     1362         assign
     1363           v-diasize-resize-button :row    = 1
     1364           v-diasize-resize-button :column = 1
     1365         .
     1366       end.
     1367       if p-change-value > 0
     1368       then do:
     1369         if frame Dialog-Frame :scrollable = true
     1370         then do:
     1371           assign
     1372             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1373             no-error .
     1374           if error-status :error
     1375           or error-status :get-message(1) <> ""
     1376           then do:
     1377             undo move_block, retry move_block .
     1378           end.
     1379         end.
     1380         assign
     1381           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1382           no-error .
     1383         if error-status :error
     1384         or error-status :get-message(1) <> ""
     1385         then do:
     1386           undo move_block, retry move_block .
     1387         end.
     1388         assign
     1389           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1390           no-error .
     1391         if error-status :error
     1392         or error-status :get-message(1) <> ""
     1393         then do:
     1394           undo move_block, retry move_block .
     1395         end.
     1396         for each buf_temp-browse-handle
     1397           where buf_temp-browse-handle.browse-type = 'height':u
     1398         on error undo move_block, retry move_block
     1399         :
     1400           assign
     1401             buf_temp-browse-handle.browse-handle :height
     1402               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1403             no-error .
     1404           if error-status :error
     1405           or error-status :get-message(1) <> ""
     1406           then do:
     1407             undo move_block, retry move_block .
     1408           end.
     1409         end.
     1410         for each buf_temp-diasize-handle
     1411         on error undo move_block, retry move_block
     1412         :
     1413           assign
     1414             v-object-handle = buf_temp-diasize-handle.handle-value
     1415           .
     1416           if v-object-handle <> v-diasize-resize-button
     1417           then do:
     1418             assign
     1419               v-object-handle :row = v-object-handle :row + p-change-value
     1420               no-error .
     1421             if error-status :error
     1422             or error-status :get-message(1) <> ""
     1423             then do:
     1424               undo move_block, retry move_block .
     1425             end.
     1426           end.
     1427         end.
     1428       end.
     1429       else do:
     1430         for each buf_temp-diasize-handle
     1431         on error undo move_block, retry move_block
     1432         :
     1433           assign
     1434             v-object-handle = buf_temp-diasize-handle.handle-value
     1435           .
     1436           if v-object-handle <> v-diasize-resize-button
     1437           then do:
     1438             assign
     1439               v-object-handle :row = v-object-handle :row + p-change-value
     1440               no-error .
     1441             if error-status :error
     1442             or error-status :get-message(1) <> ""
     1443             then do:
     1444               undo move_block, retry move_block .
     1445             end.
     1446           end.
     1447         end.
     1448         assign
     1449           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1450           no-error .
     1451         if error-status :error
     1452         or error-status :get-message(1) <> ""
     1453         then do:
     1454           undo move_block, retry move_block .
     1455         end.
     1456         for each buf_temp-browse-handle
     1457           where buf_temp-browse-handle.browse-type = 'height':u
     1458         on error undo move_block, retry move_block
     1459         :
     1460           assign
     1461             buf_temp-browse-handle.browse-handle :height
     1462               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1463             no-error .
     1464           if error-status :error
     1465           or error-status :get-message(1) <> ""
     1466           then do:
     1467             undo move_block, retry move_block .
     1468           end.
     1469         end.
     1470         assign
     1471           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1472           no-error .
     1473         if error-status :error
     1474         or error-status :get-message(1) <> ""
     1475         then do:
     1476           undo move_block, retry move_block .
     1477         end.
     1478         if frame Dialog-Frame :scrollable = true
     1479         then do:
     1480           assign
     1481             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1482             no-error .
     1483           if error-status :error
     1484           or error-status :get-message(1) <> ""
     1485           then do:
     1486             undo move_block, retry move_block .
     1487           end.
     1488         end.
     1489       end.
     1490       if p-move-resize = true
     1491       then do:
     1492         run diasize_position-resize-button in this-procedure .
     1493       end.
     1494       if v-diasize-wndstore = true
     1495       then do:
     1496         if connected("ub") = true
     1497         then do:
     1498           define variable v-cntxt-db-num        as integer   no-undo .
     1499           define variable v-cntxt-userid        as character no-undo .
     1500           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1501                                             , OUTPUT v-cntxt-userid
     1502                                             ) .
     1503           run gbl/wndsizew.p
     1504             (input  v-cntxt-db-num
     1505             ,input  v-cntxt-userid
     1506             ,input  v-diasize-proc-name
     1507             ,input  'height':u
     1508             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1509             ) .
     1510         end.
     1511       end.
     1512     end.
     1513     assign
     1514       v-diasize-change-size = false
     1515     .
     1516   end procedure.
     1517   procedure diasize_set-height :
     1518     define input  parameter p-new-height  as decimal   no-undo .
     1519     define input  parameter p-move-resize as logical   no-undo .
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523       run diasize_change-height in this-procedure
     1524         (input  (p-new-height - frame Dialog-Frame :height)
     1525         ,input  p-move-resize
     1526         ) .
     1527     end.
     1528   end procedure.
     1529   procedure diasize_change-width :
     1530     define input  parameter p-change-value as decimal   no-undo .
     1531     define input  parameter p-move-resize  as logical   no-undo .
     1532     define variable v-field-group-handle   as handle    no-undo .
     1533     define variable v-object-handle        as handle    no-undo .
     1534     define variable v-frame-width          as decimal   no-undo .
     1535     define variable v-frame-virtual-width  as decimal   no-undo .
     1536     define variable v-browse-width         as decimal   no-undo .
     1537     define variable v-window-width         as decimal   no-undo .
     1538     define variable v-window-virtual-width as decimal   no-undo .
     1539     define variable v-change-sign          as integer   no-undo .
     1540     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1541     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1542     if p-change-value > 0
     1543     then do:
     1544       if frame Dialog-Frame :width + p-change-value >
     1545           session :width-chars
     1546       then do:
     1547         assign
     1548           p-change-value = session :width-chars - frame Dialog-Frame :width
     1549         .
     1550         if p-change-value <= 0
     1551         then do:
     1552           run diasize_position-resize-button in this-procedure .
     1553           return .
     1554         end.
     1555       end.
     1556     end.
     1557     if p-change-value < 0
     1558     then do:
     1559       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1560       then do:
     1561         assign
     1562           p-change-value = v-diasize-orig-frame-width
     1563                          - frame Dialog-Frame :width
     1564         .
     1565         if p-change-value >= 0
     1566         then do:
     1567           run diasize_position-resize-button in this-procedure .
     1568           return .
     1569         end.
     1570       end.
     1571     end.
     1572     if p-change-value >= 0
     1573     then do:
     1574       assign
     1575         v-change-sign = 1
     1576       .
     1577     end.
     1578     else do:
     1579       assign
     1580         v-change-sign = -1
     1581       .
     1582     end.
     1583     assign
     1584       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1585     .
     1586     if p-change-value = 0
     1587     then do:
     1588       run diasize_position-resize-button in this-procedure .
     1589       return .
     1590     end.
     1591     move_block:
     1592     do
     1593     on error undo move_block, leave move_block
     1594     :
     1595       if retry
     1596       then do:
     1597         do
     1598         on error undo move_block, leave move_block
     1599         :
     1600           if p-change-value > 0
     1601           then do:
     1602             for each buf_temp-diasize-handle
     1603             on error undo, next
     1604             :
     1605               assign
     1606                 v-object-handle = buf_temp-diasize-handle.handle-value
     1607               .
     1608               if v-object-handle <> v-diasize-resize-button
     1609               then do:
     1610                 assign
     1611                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1612                 .
     1613               end.
     1614             end.
     1615             assign
     1616               v-diasize-browse-handle :width = v-browse-width
     1617             .
     1618             for each buf_temp-browse-handle
     1619               where buf_temp-browse-handle.browse-type = 'width':u
     1620             on error undo, next
     1621             :
     1622               assign
     1623                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1624               .
     1625             end.
     1626             assign
     1627               frame Dialog-Frame :width = v-frame-width
     1628             .
     1629             if frame Dialog-Frame :scrollable = true
     1630             then do:
     1631               assign
     1632                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1633               .
     1634             end.
     1635             run diasize_position-resize-button in this-procedure .
     1636           end.
     1637           else do:
     1638             if frame Dialog-Frame :scrollable = true
     1639             then do:
     1640               assign
     1641                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1642               .
     1643             end.
     1644             assign
     1645               frame Dialog-Frame :width = v-frame-width
     1646             .
     1647             for each buf_temp-browse-handle
     1648               where buf_temp-browse-handle.browse-type = 'width':u
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1653               .
     1654             end.
     1655             assign
     1656               v-diasize-browse-handle :width = v-browse-width
     1657             .
     1658             for each buf_temp-diasize-handle
     1659             on error undo, next
     1660             :
     1661               assign
     1662                 v-object-handle = buf_temp-diasize-handle.handle-value
     1663               .
     1664               if v-object-handle <> v-diasize-resize-button
     1665               then do:
     1666                 assign
     1667                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1668                 .
     1669               end.
     1670             end.
     1671             run diasize_position-resize-button in this-procedure .
     1672           end.
     1673           assign
     1674             v-diasize-change-size = false
     1675           .
     1676           leave move_block .
     1677         end.
     1678       end.
     1679       assign
     1680         v-diasize-need-full-display = true
     1681       .
     1682       if v-diasize-change-size = false
     1683       then do:
     1684         assign
     1685           v-diasize-change-size = true
     1686         .
     1687       end.
     1688       else do:
     1689         return .
     1690       end.
     1691       assign
     1692         v-frame-width = frame Dialog-Frame :width
     1693         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1694         v-browse-width = v-diasize-browse-handle :width
     1695       .
     1696       for each buf_temp-browse-handle
     1697         where buf_temp-browse-handle.browse-type = 'width':u
     1698       :
     1699         assign
     1700           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1701         .
     1702       end.
     1703       for each buf_temp-diasize-handle
     1704       :
     1705         delete buf_temp-diasize-handle .
     1706       end.
     1707       assign
     1708         v-field-group-handle = frame Dialog-Frame :first-child
     1709       .
     1710       do while valid-handle(v-field-group-handle)
     1711       :
     1712         assign
     1713           v-object-handle = v-field-group-handle :first-child
     1714         .
     1715         do while valid-handle(v-object-handle)
     1716         :
     1717           if  v-object-handle <> v-diasize-browse-handle :handle
     1718           and v-object-handle <> v-diasize-resize-button
     1719           and can-query(v-object-handle, "row")
     1720           and can-query(v-object-handle, "height")
     1721           and ( v-object-handle :col + v-object-handle :width
     1722                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1723               )
     1724           then do:
     1725             find first buf_temp-browse-handle
     1726               where buf_temp-browse-handle.browse-type   = 'width':u
     1727                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1728               no-error .
     1729             if available buf_temp-browse-handle
     1730             then do:
     1731             end.
     1732             else do:
     1733               create buf_temp-diasize-handle .
     1734               assign
     1735                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1736                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1737               .
     1738             end.
     1739           end.
     1740           assign
     1741             v-object-handle = v-object-handle :next-sibling
     1742           .
     1743         end.
     1744         assign
     1745           v-field-group-handle = v-field-group-handle :next-sibling
     1746         .
     1747       end.
     1748       do with frame Dialog-Frame
     1749       :
     1750         hide v-diasize-resize-button .
     1751         v-diasize-resize-button :row = 1.
     1752         v-diasize-resize-button :column = 1.
     1753       end.
     1754       if p-change-value > 0
     1755       then do:
     1756         if frame Dialog-Frame :scrollable = true
     1757         then do:
     1758           assign
     1759             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1760             no-error .
     1761           if error-status :error
     1762           or error-status :get-message(1) <> ""
     1763           then do:
     1764             undo move_block, retry move_block.
     1765           end.
     1766         end.
     1767         assign
     1768           frame Dialog-Frame :width = v-frame-width + p-change-value
     1769           no-error .
     1770         if error-status :error
     1771         or error-status :get-message(1) <> ""
     1772         then do:
     1773           undo move_block, retry move_block.
     1774         end.
     1775         assign
     1776           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1777         no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block.
     1782         end.
     1783         for each buf_temp-browse-handle
     1784           where buf_temp-browse-handle.browse-type = 'width':u
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             buf_temp-browse-handle.browse-handle :width
     1789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1790             no-error .
     1791           if error-status :error
     1792           or error-status :get-message(1) <> ""
     1793           then do:
     1794             undo move_block, retry move_block .
     1795           end.
     1796         end.
     1797         for each buf_temp-diasize-handle
     1798         on error undo move_block, retry move_block
     1799         :
     1800           assign
     1801             v-object-handle = buf_temp-diasize-handle.handle-value
     1802           .
     1803           if v-object-handle <> v-diasize-resize-button
     1804           then do:
     1805             assign
     1806               v-object-handle :col = v-object-handle :col + p-change-value
     1807               no-error .
     1808             if error-status :error
     1809             or error-status :get-message(1) <> ""
     1810             then do:
     1811               undo move_block, retry move_block .
     1812             end.
     1813           end.
     1814         end.
     1815       end.
     1816       else do:
     1817         for each buf_temp-diasize-handle
     1818         on error undo move_block, retry move_block
     1819         :
     1820           assign
     1821             v-object-handle = buf_temp-diasize-handle.handle-value
     1822           .
     1823           if v-object-handle <> v-diasize-resize-button
     1824           then do:
     1825             assign
     1826               v-object-handle :col = v-object-handle :col + p-change-value
     1827               no-error .
     1828             if error-status :error
     1829             or error-status :get-message(1) <> ""
     1830             then do:
     1831               undo move_block, retry move_block .
     1832             end.
     1833           end.
     1834         end.
     1835         for each buf_temp-browse-handle
     1836           where buf_temp-browse-handle.browse-type = 'width':u
     1837         on error undo move_block, retry move_block
     1838         :
     1839           assign
     1840             buf_temp-browse-handle.browse-handle :width
     1841               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1842             no-error .
     1843           if error-status :error
     1844           or error-status :get-message(1) <> ""
     1845           then do:
     1846             undo move_block, retry move_block .
     1847           end.
     1848         end.
     1849         assign
     1850           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1851           no-error .
     1852         if error-status :error
     1853         or error-status :get-message(1) <> ""
     1854         then do:
     1855           undo move_block, retry move_block.
     1856         end.
     1857         assign
     1858           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1859         no-error .
     1860         if error-status :error
     1861         or error-status :get-message(1) <> ""
     1862         then do:
     1863           undo move_block, retry move_block.
     1864         end.
     1865         if frame Dialog-Frame :scrollable = true
     1866         then do:
     1867           assign
     1868             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1869           no-error .
     1870           if error-status :error
     1871           or error-status :get-message(1) <> ""
     1872           then do:
     1873             undo move_block, retry move_block.
     1874           end.
     1875         end.
     1876       end.
     1877       if p-move-resize
     1878       then do:
     1879         run diasize_position-resize-button in this-procedure .
     1880       end.
     1881       if v-diasize-wndstore = true
     1882       then do:
     1883         if connected("ub") = true
     1884         then do:
     1885           define variable v-cntxt-db-num        as integer   no-undo .
     1886           define variable v-cntxt-userid        as character no-undo .
     1887           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1888                                             , OUTPUT v-cntxt-userid
     1889                                             ) .
     1890           run gbl/wndsizew.p
     1891             (input  v-cntxt-db-num
     1892             ,input  v-cntxt-userid
     1893             ,input  v-diasize-proc-name
     1894             ,input  'width':u
     1895             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1896             ) .
     1897         end.
     1898       end.
     1899     end.
     1900     assign
     1901       v-diasize-change-size = false
     1902     .
     1903   end procedure.
     1904   procedure diasize_set-width :
     1905     define input  parameter p-new-width  as decimal   no-undo .
     1906     define input  parameter p-move-resize as logical   no-undo .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       run diasize_change-width in this-procedure
     1911         (input  (p-new-width - frame Dialog-Frame :width)
     1912         ,input  p-move-resize
     1913         ) .
     1914     end.
     1915   end procedure.
     1916   procedure diasize_position-resize-button :
     1917     do with frame Dialog-Frame
     1918     :
     1919       hide v-diasize-resize-button .
     1920       assign
     1921         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1922                     - 1
     1923                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1924         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1925                     - 1
     1926                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1927       .
     1928       view v-diasize-resize-button .
     1929     end.
     1930   end procedure.
     1931   on alt-right anywhere
     1932   do:
     1933     run diasize_change-width in this-procedure
     1934       (input 1
     1935       ,input true
     1936       ) .
     1937     return no-apply .
     1938   end.
     1939   on alt-left anywhere
     1940   do:
     1941     run diasize_change-width in this-procedure
     1942       (input -1
     1943       ,input true
     1944       ) .
     1945     return no-apply .
     1946   end.
     1947   on alt-down anywhere
     1948   do:
     1949     run diasize_change-height in this-procedure
     1950       (input 1
     1951       ,input true
     1952       ) .
     1953     return no-apply .
     1954   end.
     1955   on alt-up anywhere
     1956   do:
     1957     run diasize_change-height in this-procedure
     1958       (input -1
     1959       ,input true
     1960       ) .
     1961     return no-apply .
     1962   end.
     1963   on alt-enter of frame Dialog-Frame
     1964   do:
     1965     run diasize_maximize in this-procedure
     1966       (input  ?
     1967       ).
     1968     return no-apply .
     1969   end.
     1970   procedure diasize_end-move :
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       define variable v-row-delta as decimal   no-undo .
     1975       define variable v-col-delta as decimal   no-undo .
     1976       define variable v-new-row as decimal   no-undo .
     1977       define variable v-new-col as decimal   no-undo .
     1978       assign
     1979         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1980         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1981       .
     1982       assign
     1983         v-row-delta = v-new-row - frame Dialog-Frame :height
     1984         v-col-delta = v-new-col - frame Dialog-Frame :width
     1985       .
     1986       run diasize_change-height in this-procedure
     1987         (input v-row-delta
     1988         ,input true
     1989         ) .
     1990       run diasize_change-width in this-procedure
     1991         (input v-col-delta
     1992         ,input true
     1993         ) .
     1994     end.
     1995   end procedure.
     1996   procedure diasize_maximize :
     1997     define input  parameter p-action as logical   no-undo .
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       if p-action = ?
     2002       then do:
     2003         if v-diasize-need-maximize = true
     2004         then do:
     2005           assign
     2006             p-action = true
     2007           .
     2008         end.
     2009         else do:
     2010           assign
     2011             p-action = false
     2012           .
     2013         end.
     2014       end.
     2015       if p-action = true
     2016       then do:
     2017         run diasize_change-height in this-procedure
     2018           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2019               - frame Dialog-Frame :height-chars
     2020           ,input true
     2021           ) .
     2022         run diasize_change-width in this-procedure
     2023           (input session :width-chars
     2024               - frame Dialog-Frame :width-chars
     2025           ,input true
     2026           ) .
     2027         assign
     2028           v-diasize-need-maximize = false
     2029         .
     2030       end.
     2031       else do:
     2032         run diasize_change-width in this-procedure
     2033           (input v-diasize-orig-frame-width
     2034               - frame Dialog-Frame :width-chars
     2035           ,input true
     2036           ) .
     2037         run diasize_change-height in this-procedure
     2038           (input v-diasize-orig-frame-height
     2039               - frame Dialog-Frame :height-chars
     2040           ,input true
     2041           ) .
     2042         assign
     2043           v-diasize-need-maximize = true
     2044         .
     2045       end.
     2046     end.
     2047   end procedure.
     2048   procedure diasize_restore-orig-size :
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       assign
     2053         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2054         v-diasize-current-frame-height = frame Dialog-Frame :height
     2055       .
     2056       run diasize_set-height in this-procedure
     2057         (input  v-diasize-orig-frame-height
     2058         ,input  true
     2059         ) .
     2060       run diasize_set-width in this-procedure
     2061         (input  v-diasize-orig-frame-width
     2062         ,input  true
     2063         ) .
     2064     end.
     2065   end procedure.
     2066   procedure diasize_restore-current-size :
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       run diasize_set-height in this-procedure
     2071         (input  v-diasize-current-frame-height
     2072         ,input  true
     2073         ) .
     2074       run diasize_set-width in this-procedure
     2075         (input  v-diasize-current-frame-width
     2076         ,input  true
     2077         ) .
     2078     end.
     2079   end procedure.
     2080   procedure diasize_set-browse-handle :
     2081     define input  parameter p-browse-handle as handle   no-undo .
     2082     define buffer buf_temp-browse-handle for temp-browse-handle .
     2083     do
     2084     on error undo, return error return-value
     2085     :
     2086       assign
     2087         v-diasize-browse-handle = p-browse-handle
     2088       .
     2089       for each buf_temp-browse-handle
     2090       on error undo, return error return-value
     2091       :
     2092         delete buf_temp-browse-handle .
     2093       end.
     2094     end.
     2095   end procedure.
     2096   procedure diasize_add_browse :
     2097     define input  parameter p-browse-type   as character no-undo .
     2098     define input  parameter p-browse-handle as handle    no-undo .
     2099     define buffer buf_temp-browse-handle for temp-browse-handle .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       assign
     2104         v-diasize-browse-number = v-diasize-browse-number + 1
     2105       .
     2106       create buf_temp-browse-handle .
     2107       assign
     2108         buf_temp-browse-handle.browse-type   = p-browse-type
     2109         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2110         buf_temp-browse-handle.browse-handle = p-browse-handle
     2111       .
     2112     end.
     2113   end procedure.
     2114   procedure diasize_init :
     2115     define variable v-default-value    as logical   no-undo .
     2116     define variable v-restore-saved    as logical   no-undo .
     2117     define variable v-resize-value-str as character no-undo .
     2118     do
     2119     on error undo, return error return-value
     2120     :
     2121       do with frame Dialog-Frame
     2122       :
     2123         assign
     2124           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2125           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2126           v-diasize-browse-handle     = browse BR-lines :handle
     2127         .
     2128         create button v-diasize-resize-button
     2129         assign
     2130           parent        = frame Dialog-Frame :first-child
     2131           label         = "s"
     2132           height-pixels = 16
     2133           width-pixels  = 16
     2134           visible       = true
     2135           sensitive     = true
     2136           movable       = true
     2137           triggers:
     2138             on end-move persistent run diasize_end-move in this-procedure .
     2139           end triggers.
     2140         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2141         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2142         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2143         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2144         assign
     2145           v-diasize-wndmax = false
     2146         .
     2147         if connected("ub") = true
     2148         then do:
     2149           define variable v-cntxt-db-num        as integer   no-undo .
     2150           define variable v-cntxt-userid        as character no-undo .
     2151           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2152                                             , OUTPUT v-cntxt-userid
     2153                                             ) .
     2154           run gbl/wndpar_r.p
     2155             (input  v-cntxt-db-num
     2156             ,input  v-cntxt-userid
     2157             ,input  'wndmax':U
     2158             ,output v-diasize-wndmax
     2159             ,output v-default-value
     2160             ) .
     2161         end.
     2162         assign
     2163           v-diasize-wndstore = false
     2164         .
     2165         if connected("ub") = true
     2166         then do:
     2167           run gbl/wndpar_r.p
     2168             (input  v-cntxt-db-num
     2169             ,input  v-cntxt-userid
     2170             ,input  'wndstore':U
     2171             ,output v-diasize-wndstore
     2172             ,output v-default-value
     2173             ) .
     2174         end.
     2175         assign
     2176           v-diasize-proc-name = entry(1, program-name(2), '.')
     2177         .
     2178         if v-diasize-wndstore = true
     2179         then do:
     2180           assign
     2181             v-restore-saved = false
     2182           .
     2183           if connected("ub") = true
     2184           then do:
     2185             run gbl/wndsizer.p
     2186               (input  v-cntxt-db-num
     2187               ,input  v-cntxt-userid
     2188               ,input  v-diasize-proc-name
     2189               ,input  'height':u
     2190               ,output v-resize-value-str
     2191               ) .
     2192             if v-resize-value-str <> '':U
     2193             then do:
     2194               run diasize_change-height in this-procedure
     2195                 (input  integer(v-resize-value-str)
     2196                 ,input  true
     2197                 ) .
     2198               assign
     2199                 v-restore-saved = true
     2200               .
     2201             end.
     2202           end.
     2203           if connected("ub") = true
     2204           then do:
     2205             run gbl/wndsizer.p
     2206               (input  v-cntxt-db-num
     2207               ,input  v-cntxt-userid
     2208               ,input  v-diasize-proc-name
     2209               ,input  'width':u
     2210               ,output v-resize-value-str
     2211               ) .
     2212             if v-resize-value-str <> '':U
     2213             then do:
     2214               run diasize_change-width in this-procedure
     2215                 (input  integer(v-resize-value-str)
     2216                 ,input  true
     2217                 ) .
     2218               assign
     2219                 v-restore-saved = true
     2220               .
     2221             end.
     2222           end.
     2223           if v-restore-saved <> true
     2224           then do:
     2225             if v-diasize-wndmax = true
     2226             then do:
     2227               run diasize_maximize in this-procedure
     2228                 (input  true
     2229                 ) .
     2230             end.
     2231           end.
     2232         end.
     2233         else do:
     2234           if v-diasize-wndmax = true
     2235           then do:
     2236             run diasize_maximize in this-procedure
     2237               (input  true
     2238               ) .
     2239           end.
     2240         end.
     2241       end.
     2242     end.
     2243   end procedure.
     2244   procedure diasize_need-full-display :
     2245     define output parameter p-need-full-display as logical   no-undo .
     2246     do
     2247     on error undo, return error return-value
     2248     :
     2249       assign
     2250         p-need-full-display = v-diasize-need-full-display
     2251       .
     2252       assign
     2253         v-diasize-need-full-display = false
     2254       .
     2255     end.
     2256   end procedure.
     2257   procedure get-context :
     2258      define output parameter p-db-num as integer          no-undo.
     2259      define output parameter p-user-id as character        no-undo.
     2260      define variable v-login               as character    no-undo.
     2261      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2262      define buffer buf_user-login  for ub.user-login .
     2263      do
     2264      on error undo, return error
     2265      :
     2266            FIND FIRST buf_sys-ctrl no-lock.
     2267            ASSIGN
     2268               v-login = USERID("ub")
     2269               p-db-num = buf_sys-ctrl.db-num
     2270            .
     2271            FIND FIRST buf_user-login
     2272                 WHERE buf_user-login.db-num = p-db-num
     2273                   AND buf_user-login.user-login = v-login
     2274                 no-lock
     2275                 no-error
     2276                 .
     2277            IF AVAILABLE buf_user-login
     2278            THEN DO:
     2279               assign
     2280                  p-user-id = buf_user-login.user-id
     2281               .
     2282            END.
     2283      end.
     2284   end procedure.
     2285       run diasize_init in this-procedure .
     2286   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2287     run mainmenu_getcntxt in parparentproc
     2288       (output v-cntxt-db-num
     2289       ,output v-cntxt-userid
     2290       ,output v-cntxt-level
     2291       ,output v-cntxt-host-code-obj
     2292       ,output v-cntxt-obj-type
     2293       ,output v-cntxt-obj-code
     2294       ,output v-cntxt-db-num-obj
     2295       ,output v-cntxt-is-admin
     2296       ) .
     2297   p-next-prev = "".
     2298   n-p: do while p-next-prev = "":U:
     2299   MAIN-BLOCK:
     2300   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2301      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2302       if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     2303           message vss-workfile vss-revision vss-description skip
     2304                       "Неверный параметр вызова par-mode"
     2305           view-as alert-box ERROR.
     2306           return error.
     2307       end.
     2308       if not par-mode = 'ПРОСМОТР':U then
     2309       p-next-prev = "QUIT".
     2310       find first ub.sysconf No-LOCK WHERE
     2311                        ub.sysconf.host-code = parhost-code No-ERROR.
     2312       if not avail ub.sysconf then do:
     2313           message vss-workfile vss-revision vss-description skip
     2314                           "Неверный параметр вызова parhost-code"
     2315               view-as alert-box ERROR.
     2316               return error.
     2317       end.
     2318       find first ub.clients No-LOCK WHERE
     2319                   ub.clients.obj-type = parobj-type AND
     2320                   ub.clients.obj-code = parobj-code No-ERROR.
     2321       if not avail ub.clients then do:
     2322         message vss-workfile vss-revision vss-description skip
     2323                 "Неверный параметр вызова parobj-type/parobj-code"
     2324         view-as alert-box ERROR.
     2325         return error.
     2326       end.
     2327       if parcli-type <> '':U or parcli-code <> 0 then do:
     2328         find first ub.clients No-LOCK WHERE
     2329                     ub.clients.obj-type = parcli-type AND
     2330                     ub.clients.obj-code = parcli-code No-ERROR.
     2331         if not avail ub.clients then do:
     2332           message vss-workfile vss-revision vss-description skip
     2333                   "Неверный параметр вызова parcli-type/parcli-code"
     2334           view-as alert-box ERROR.
     2335           return error.
     2336         end.
     2337       end.
     2338       tt-wth-doc.obj-type:list-items = 'орг':U + chr(44) +
     2339                                       'чел':U + chr(44) +
     2340                                       'маг':U + chr(44) +
     2341                                       'скл':U + chr(44).
     2342     Run fill-tables no-error.
     2343     if error-status:error then return error.
     2344     RUN Myenable in this-procedure .
     2345   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2346   DEF VAR cur-clmn-numbr-lines as INT EXTENT 18 no-undo.
     2347   DEF VAR varmvibr-lines       as INT no-undo.
     2348   DEF VAR varmvjbr-lines       as INT no-undo.
     2349   DEF VAR varmvkbr-lines       as INT no-undo.
     2350   DEF VAR varmvlbr-lines       as INT no-undo.
     2351   DEF VAR move-elementbr-lines as INT no-undo.
     2352   def var jjbr-lines           as int no-undo.
     2353   do varmvibr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     2354     ASSIGN cur-clmn-numbr-lines[varmvibr-lines] = varmvibr-lines.
     2355   END.
     2356   RUN start-mv-clmnbr-lines.
     2357   PROCEDURE start-mv-clmnbr-lines:
     2358   def var old-session as logical no-undo.
     2359      old-session = SESSION:IMMEDIATE-DISPLAY.
     2360      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2361          IF  var-peresort = no  THEN DO:
     2362      DO jjbr-lines = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2363        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,4,5,6'))] , 1).
     2364      END.
     2365          END.
     2366          IF  var-peresort = yes  THEN DO:
     2367      DO jjbr-lines = NUM-ENTRIES('1,2,3,6,4,5') TO 1 BY -1:
     2368        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,6,4,5'))] , 1).
     2369      END.
     2370          END.
     2371      SESSION:IMMEDIATE-DISPLAY = old-session.
     2372   END.
     2373   ON ctrl-cursor-right OF BROWSE br-lines do:
     2374     RUN re-move-clmnbr-lines ( 1, 18).
     2375   END.
     2376   ON ctrl-cursor-left OF BROWSE br-lines do:
     2377     RUN re-move-clmnbr-lines (18, 1).
     2378   END.
     2379   PROCEDURE re-move-clmnbr-lines:
     2380     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2381     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2382     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2383       if cur-clmn-numbr-lines[varmvibr-lines] = source-column THEN cur-clmn-numbr-lines[varmvibr-lines] = -1.
     2384     END.
     2385     if br-lines:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2386     if source-column > target-column THEN
     2387     DO varmvjbr-lines = source-column - 1 to target-column BY -1:
     2388       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2389           if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     2390             cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] + 1.
     2391           END.
     2392       END.
     2393     END.
     2394     ELSE
     2395     DO varmvjbr-lines = source-column + 1 to target-column:
     2396       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2397         if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     2398           cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] - 1.
     2399         END.
     2400       END.
     2401     END.
     2402     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2403       if cur-clmn-numbr-lines[varmvibr-lines] = -1 THEN cur-clmn-numbr-lines[varmvibr-lines] = target-column.
     2404     END.
     2405   END PROCEDURE.
     2406   PROCEDURE ch-clmnbr-lines:
     2407     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2408     if cur-clmn-loc <= 1 then do:
     2409       return .
     2410     end.
     2411     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2412       if cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-loc THEN move-elementbr-lines = varmvibr-lines.
     2413     END.
     2414     RUN re-move-clmnbr-lines (cur-clmn-loc, 1).
     2415   END PROCEDURE.
     2416   PROCEDURE mv-brw-defaultbr-lines:
     2417   def var old-session as logical no-undo.
     2418     old-session = SESSION:IMMEDIATE-DISPLAY.
     2419     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2420     do varmvlbr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     2421       RUN re-move-clmnbr-lines (cur-clmn-numbr-lines[varmvlbr-lines], varmvlbr-lines).
     2422     END.
     2423     RUN start-mv-clmnbr-lines.
     2424     SESSION:IMMEDIATE-DISPLAY = old-session.
     2425   END PROCEDURE.
     2426   .
     2427     WAIT-FOR GO OF FRAME Dialog-Frame.
     2428   END.
     2429   end.
     2430   RUN disable_UI.
     2431   PROCEDURE control-peresort :
     2432   DEFINE OUTPUT parameter par-peresort as logical no-undo.
     2433   if tt-wth-doc.auto-fill = yes and
     2434   can-find(first ub.chk-doc No-LOCK WHERE
     2435                      ub.chk-doc.obj-type = tt-wth-doc.obj-type AND
     2436                       ub.chk-doc.obj-code = tt-wth-doc.obj-code AND
     2437                       ub.chk-doc.out-code = tt-wth-doc.doc-code AND
     2438                       ub.chk-doc.chk-type = integer('4':U)) then do:
     2439                       par-peresort = yes.
     2440   end.
     2441   else par-peresort = no.
     2442   END PROCEDURE.
     2443   PROCEDURE disable_UI :
     2444     HIDE FRAME Dialog-Frame.
     2445   END PROCEDURE.
     2446   PROCEDURE enable_UI :
     2447     OPEN QUERY Dialog-Frame FOR EACH tt-wth-doc SHARE-LOCK.
     2448     GET FIRST Dialog-Frame.
     2449     DISPLAY for-object operator-name deliver-name receiver-name inv-prs4-name
     2450             inv-prs5-name
     2451         WITH FRAME Dialog-Frame.
     2452     IF AVAILABLE tt-wth-doc THEN
     2453       DISPLAY tt-wth-doc.doc-code tt-wth-doc.doc-date tt-wth-doc.fact-date
     2454             tt-wth-doc.shift-date tt-wth-doc.shift-name tt-wth-doc.shift-num
     2455             tt-wth-doc.obj-type tt-wth-doc.obj-code tt-wth-doc.bef-sum
     2456             tt-wth-doc.aft-sum tt-wth-doc.fact-sum tt-wth-doc.operator
     2457             tt-wth-doc.deliver tt-wth-doc.receiver tt-wth-doc.inv-prs4
     2458             tt-wth-doc.inv-prs5
     2459         WITH FRAME Dialog-Frame.
     2460     ENABLE b-quit B-exit B-prev B-next B-Help tt-wth-doc.doc-date
     2461            tt-wth-doc.fact-date tt-wth-doc.shift-date tt-wth-doc.shift-name
     2462            tt-wth-doc.shift-num tt-wth-doc.obj-code tt-wth-doc.bef-sum
     2463            tt-wth-doc.aft-sum tt-wth-doc.fact-sum BR-lines B-add B-lookup B-chg
     2464            B-del B-chk B-hist tt-wth-doc.operator B-person1 tt-wth-doc.deliver
     2465            B-person2 tt-wth-doc.receiver B-person3 B-person4 tt-wth-doc.inv-prs4
     2466            tt-wth-doc.inv-prs5 B-person5 for-object operator-name deliver-name
     2467            receiver-name inv-prs4-name inv-prs5-name
     2468         WITH FRAME Dialog-Frame.
     2469     VIEW FRAME Dialog-Frame.
     2470   END PROCEDURE.
     2471   PROCEDURE fill-tables :
     2472   for each tt-wth-doc:
     2473       delete tt-wth-doc.
     2474   end.
     2475   IF par-mode = 'ДОБАВЛЕНИЕ':U then do:
     2476      run gbl/factdate.p (
     2477                       INPUT        parobj-type,
     2478                       INPUT        parobj-code,
     2479                       INPUT-OUTPUT f-date,
     2480                       INPUT-OUTPUT f-time,
     2481                       INPUT-OUTPUT s-date,
     2482                       INPUT-OUTPUT s-num,
     2483                       INPUT-OUTPUT s-name,
     2484                       INPUT        YES
     2485                     ) NO-ERROR.
     2486       IF ERROR-STATUS:ERROR THEN DO:
     2487         return error.
     2488       END.
     2489       DO TRANSACTION ON ERROR UNDO, RETURN ERROR:
     2490   define variable l-in-ov17 as logical no-undo .
     2491   define variable v-date17 as date no-undo .
     2492   define variable v-time17 as integer no-undo .
     2493   run cur-time in this-procedure(output v-date17, output v-time17).
     2494   CREATE tt-wth-doc.
     2495   ASSIGN
     2496     tt-wth-doc.host-code = parhost-code
     2497     tt-wth-doc.doc-code  = TRIM( STRING( NEXT-VALUE( s-wth-doc, ub), ">>>>>>>>>9":U ) ) + "-" + TRIM( STRING( parobj-code, ">>>>>>>>9":U ) ) +                   SUBSTR( parobj-type, ( IF g#language = "RUS" THEN 1 ELSE 2 ), 1 )
     2498      tt-wth-doc.doc-type  = 'инв':U
     2499     tt-wth-doc.ext-doc-type  = 'iy':U
     2500     tt-wth-doc.inter_    = if  lookup(tt-wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
     2501     tt-wth-doc.exter_    = if  lookup(tt-wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
     2502     tt-wth-doc.status_   = 'накл':U
     2503     tt-wth-doc.obj-type  = parobj-type
     2504     tt-wth-doc.obj-code  = parobj-code
     2505     tt-wth-doc.creid     = v-cntxt-userid
     2506     tt-wth-doc.credate   = v-date17
     2507   .
     2508   if tt-wth-doc.doc-type = 'инв':U or lookup(tt-wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
     2509      or tt-wth-doc.doc-type = 'декл':U then do:
     2510     assign
     2511       tt-wth-doc.cli-type  = 'орг':U
     2512       tt-wth-doc.cli-code  = parhost-code
     2513       .
     2514   end.
     2515   else if tt-wth-doc.ext-doc-type = 'ps':U then do:
     2516     assign
     2517     tt-wth-doc.cli-type  = parobj-type
     2518     tt-wth-doc.cli-code  = parobj-code
     2519     .
     2520   end.
     2521   else if tt-wth-doc.inter_  = yes
     2522   then do:
     2523     assign
     2524     tt-wth-doc.cli-type  = parobj-type
     2525     tt-wth-doc.cli-code  = parobj-code
     2526     .
     2527   end.
     2528   else if tt-wth-doc.exter_  = yes
     2529   then do:
     2530     assign
     2531     tt-wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
     2532     tt-wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
     2533     .
     2534   end.
     2535   else assign
     2536       tt-wth-doc.cli-type  = parobj-type
     2537       tt-wth-doc.cli-code  = 0
     2538   .
     2539         ASSIGN
     2540         tt-wth-doc.shift-date = s-date
     2541         tt-wth-doc.shift-num  = s-num
     2542         tt-wth-doc.shift-name = s-name
     2543         tt-wth-doc.doc-date   = f-date
     2544         tt-wth-doc.operator   = 0
     2545         tt-wth-doc.receiver   = 0
     2546         tt-wth-doc.deliver    = 0
     2547         tt-wth-doc.inv-prs4   = 0
     2548         tt-wth-doc.inv-prs5   = 0
     2549         tt-wth-doc.auto-fill  = parauto-fill
     2550         .
     2551   define variable l-in-ov18 as logical no-undo .
     2552   define variable v-date18 as date no-undo .
     2553   define variable v-time18 as integer no-undo .
     2554   run cur-time in this-procedure(output v-date18, output v-time18).
     2555   CREATE bf_wth-doc.
     2556   ASSIGN
     2557     bf_wth-doc.host-code = parhost-code
     2558     bf_wth-doc.doc-code  = tt-wth-doc.doc-code
     2559      bf_wth-doc.doc-type  = 'инв':U
     2560     bf_wth-doc.ext-doc-type  = 'iy':U
     2561     bf_wth-doc.inter_    = if  lookup(bf_wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
     2562     bf_wth-doc.exter_    = if  lookup(bf_wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
     2563     bf_wth-doc.status_   = 'накл':U
     2564     bf_wth-doc.obj-type  = parobj-type
     2565     bf_wth-doc.obj-code  = parobj-code
     2566     bf_wth-doc.creid     = v-cntxt-userid
     2567     bf_wth-doc.credate   = v-date18
     2568   .
     2569   if bf_wth-doc.doc-type = 'инв':U or lookup(bf_wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
     2570      or bf_wth-doc.doc-type = 'декл':U then do:
     2571     assign
     2572       bf_wth-doc.cli-type  = 'орг':U
     2573       bf_wth-doc.cli-code  = parhost-code
     2574       .
     2575   end.
     2576   else if bf_wth-doc.ext-doc-type = 'ps':U then do:
     2577     assign
     2578     bf_wth-doc.cli-type  = parobj-type
     2579     bf_wth-doc.cli-code  = parobj-code
     2580     .
     2581   end.
     2582   else if bf_wth-doc.inter_  = yes
     2583   then do:
     2584     assign
     2585     bf_wth-doc.cli-type  = parobj-type
     2586     bf_wth-doc.cli-code  = parobj-code
     2587     .
     2588   end.
     2589   else if bf_wth-doc.exter_  = yes
     2590   then do:
     2591     assign
     2592     bf_wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
     2593     bf_wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
     2594     .
     2595   end.
     2596   else assign
     2597       bf_wth-doc.cli-type  = parobj-type
     2598       bf_wth-doc.cli-code  = 0
     2599   .
     2600         ASSIGN
     2601         bf_wth-doc.shift-date = s-date
     2602         bf_wth-doc.shift-num  = s-num
     2603         bf_wth-doc.shift-name = s-name
     2604         bf_wth-doc.doc-date   = f-date
     2605         bf_wth-doc.operator   = 0
     2606         bf_wth-doc.receiver   = 0
     2607         bf_wth-doc.deliver    = 0
     2608         bf_wth-doc.inv-prs4    = 0
     2609         bf_wth-doc.inv-prs5    = 0
     2610         bf_wth-doc.auto-fill = parauto-fill
     2611         v-doc-rec = recid(bf_wth-doc)
     2612         .
     2613       END.
     2614       FIND FIRST buf_obj No-LOCK WHERe
     2615                   buf_obj.obj-type = parobj-type AND
     2616                   buf_obj.obj-code = parobj-code No-ERROR.
     2617   end.
     2618   else do:
     2619     if par-mode = 'ПРОСМОТР':U then do:
     2620       FIND FIRST bf_wth-doc NO-LOCK WHERE
     2621                   recid(bf_wth-doc) = p-doc-rec.
     2622     end.
     2623     ELSE do:
     2624       DO TRANSACTION
     2625         ON ERROR UNDO, RETURN ERROR:
     2626         FIND FIRST bf_wth-doc EXCLUSIVE-LOCK WHERE
     2627                    recid(bf_wth-doc) = p-doc-rec.
     2628       END.
     2629     END.
     2630     IF NOT AVAIL bf_wth-doc then
     2631     return error.
     2632     v-doc-rec = p-doc-rec.
     2633     if bf_wth-doc.status_ = 'факт':U and par-mode <> 'ПРОСМОТР':U then do:
     2634        message "Документ движения МЦ с N" bf_wth-doc.doc-code  "имеет статус" bf_wth-doc.status_ SKIP
     2635                "Изменения не допускаются"
     2636        view-as alert-box error.
     2637        return error.
     2638       end.
     2639     create tt-wth-doc.
     2640     buffer-copy bf_wth-doc to tt-wth-doc.
     2641       FIND FIRST buf_obj No-LOCK WHERe
     2642                   buf_obj.obj-type = tt-wth-doc.obj-type AND
     2643                   buf_obj.obj-code = tt-wth-doc.obj-code No-ERROR.
     2644       if not avail buf_obj then do:
     2645         message "Документ движения МЦ N" bf_wth-doc.doc-code  skip
     2646                 "Неверный объект" bf_wth-doc.obj-type bf_wth-doc.obj-code
     2647         view-as alert-box ERROR.
     2648         return error.
     2649       end.
     2650       FIND FIRST buf_clients No-LOCK WHERe
     2651                   buf_clients.obj-type = tt-wth-doc.cli-type AND
     2652                   buf_clients.obj-code = tt-wth-doc.cli-code No-ERROR.
     2653      if not avail buf_clients
     2654         or NOT (buf_clients.obj-type = 'орг':U AND buf_clients.obj-code = parhost-code) then do:
     2655         message "Документ движения МЦ N" bf_wth-doc.doc-code  skip
     2656                 "Неверный контрагент" bf_wth-doc.cli-type bf_wth-doc.cli-code
     2657         view-as alert-box ERROR.
     2658         return error.
     2659      end.
     2660   end.
     2661   if tt-wth-doc.auto-fill = yes then do:
     2662   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2663   run gbl/lock-prc.p
     2664       (input 'awth':U
     2665       ,input parobj-code
     2666       ,input 0
     2667       ,input 0
     2668       ,input parobj-type
     2669       ,input ""
