     1753                AND buf_temp-tank.pl-code = buf_doc-pl.pl-code
     1754                AND buf_temp-tank.doc-seq  = v-seq
     1755       on error undo _main, return error return-value :
     1756         find first in_doc-pl where
     1757                    in_doc-pl.gds-code = buf_doc-pl.gds-code
     1758                and in_doc-pl.pl-code  = buf_doc-pl.pl-code
