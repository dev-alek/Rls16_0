      856   procedure placelib_write-attr:
      857   define input  parameter p-code     like ub.place-attr.attr-code .
      858   define input  parameter p-obj-code like ub.place-attr.obj-code .
      859   define input  parameter p-obj-type like ub.place-attr.obj-type .
      860   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      861   define input  parameter p-value    like ub.place-attr.attr-value .
      862   define output parameter p-ok       as logical.
      863   define buffer buf_place-attr for ub.place-attr .
      864     do on error undo, return error return-value :
      865        p-ok = false.
      866        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      867                                                   and buf_place-attr.obj-code    = p-obj-code
      868                                                   and buf_place-attr.obj-type    = p-obj-type
      869                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      870        if not available buf_place-attr then do :
      871           create buf_place-attr.
      872           assign
      873             buf_place-attr.attr-code   = p-code
      874             buf_place-attr.attr-value  = p-value
      875             buf_place-attr.obj-code    = p-obj-code
      876             buf_place-attr.obj-type    = p-obj-type
      877             buf_place-attr.pl-code     = p-pl-code
      878           .
      879           p-ok = true.
      880        end.
      881        else do:
      882           buf_place-attr.attr-value  = p-value .
      883           p-ok = true.
      884        end.
      885     end.
      886   end.
      887   procedure placelib_get-attr:
      888   define input  parameter  p-code     like ub.place-attr.attr-code .
      889   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      890   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      891   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      892   define output parameter  p-value    like ub.place-attr.attr-value .
      893   define output parameter  p-ok       as logical.
      894   define buffer buf_place-attr for ub.place-attr .
      895     do on error undo, return error return-value :
      896        p-ok = false.
      897        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      898                                                   and buf_place-attr.obj-code    = p-obj-code
      899                                                   and buf_place-attr.obj-type    = p-obj-type
      900                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      901        if available buf_place-attr then do :
      902          p-value = buf_place-attr.attr-value.
      903          p-ok = true.
      904        end.
      905        else do :
      906          p-ok = false.
      907        end.
      908     end.
      909   end.
      910   procedure placelib_del-attr:
      911   define input parameter  p-code     like ub.place-attr.attr-code .
      912   define input parameter  p-obj-code like ub.place-attr.obj-code .
      913   define input parameter  p-obj-type like ub.place-attr.obj-type .
      914   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      915   define input parameter  p-value    like ub.place-attr.attr-value .
      916   define output parameter p-ok       as logical.
      917   define buffer buf_place-attr for ub.place-attr .
      918     do on error undo, return error return-value :
      919        p-ok = false.
      920        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      921                                                   and buf_place-attr.obj-code    = p-obj-code
      922                                                   and buf_place-attr.obj-type    = p-obj-type
      923                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      924        if available buf_place-attr then do :
      925           delete buf_place-attr.
      926           p-ok = true.
      927        end.
      928     end.
      929   end.
      930   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   define new global shared variable g#trdcalib as handle no-undo.
      932   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      934   define variable v-ps as character no-undo .
      935   if available buf_sale-doc then
      936   assign
      937   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      938                       , chr(4)
      939                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
      940                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      941                       , buf_sale-doc.chk-amount
      942                       , buf_sale-doc.gds-amount
      943                       , buf_sale-doc.tot-lines
      944                       , buf_sale-doc.tot-dtl
      945                       ).
      946   else  do:
      947   assign
      948   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      949                       , chr(4)
      950                       , '':U
      951                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      952                       , 0
      953                       , 0
      954                       , 0
      955                       , 0
      956                       ).
      957   end.
      958   return v-ps.
      959   END FUNCTION.
      960   FUNCTION get-sale-doc-kind returns character (
      961                                                input p-doc-kind as character
      962                                              , input p-ext-doc-type as character
      963                                              , output p-order as integer
      964                                              , output p-msign as integer
      965                                              , output p-main as logical
      966                                              , output p-in-inkas as logical
      967                                              , output p-dir_ as integer
      968                                              ):
      969   define variable v-doc-kind as character no-undo.
      970   define variable v-type as character no-undo .
      971   define variable v-value as character no-undo .
      972   CASE p-doc-kind:
      973     when 'es':U then do:
      974       assign
      975       p-order = 100
      976       p-msign = 1
      977       p-main = yes
      978       p-in-inkas = yes
      979       p-dir_ = 1
      980       .
      981       return p-ext-doc-type.
      982     end.
      983     when  'rs':U then do:
      984       assign
      985       p-order = 200
      986       p-msign = - 1
      987       p-main = no
      988       p-in-inkas = yes
      989       p-dir_ = - 1
      990       .
      991       return p-ext-doc-type.
      992     end.
      993     when 'rwo':U then do:
      994       assign
      995       p-msign = - 1
      996       p-main = no
      997       p-in-inkas = no
      998       p-order = 300
      999       p-dir_ = 1
     1000       .
     1001       return 'rwo':U.
     1002     end.
     1003     when 'trf':U then do:
     1004       assign
     1005       p-msign = 1
     1006       p-main = no
     1007       p-in-inkas = no
     1008       p-order = 400
     1009       p-dir_ = 1
     1010       .
     1011       return 'trf':U.
     1012     end.
     1013     when 'swo':U then do:
     1014      assign
     1015      p-msign = 1
     1016      p-main = no
     1017      p-in-inkas = no
     1018      p-order =  500
     1019      p-dir_ = 1
     1020      .
     1021      return 'swo':U.
     1022    end.
     1023    when 'vir':U then do:
     1024      assign
     1025      p-msign = 1
     1026      p-main = no
     1027      p-in-inkas = no
     1028      p-order = 600
     1029      p-dir_ = 1
     1030      .
     1031      return 'vir':U.
     1032    end.
     1033    when 'itr':U then do:
     1034      assign
     1035      p-msign = 1
     1036      p-main = no
     1037      p-in-inkas = no
     1038      p-order = -1
     1039      p-dir_ = -1
     1040      .
     1041     return 'itr':U.
     1042    end.
     1043    when 'ngs':U then do:
     1044      assign
     1045      p-msign = 1
     1046      p-main = no
     1047      p-in-inkas = no
     1048      p-order = 700
     1049      p-dir_ = 1
     1050      .
     1051      return 'ngs':U.
     1052    end.
     1053    when 'rgs':U then do:
     1054      assign
     1055      p-msign = -1
     1056      p-main = no
     1057      p-in-inkas = no
     1058      p-order = 701
     1059      p-dir_ = -1
     1060      .
     1061      return 'rgs':U.
     1062    end.
     1063    otherwise do:
     1064       assign
     1065       p-msign = 1
     1066       p-main = no
     1067       p-in-inkas = no
     1068       p-order = -1.
     1069       return p-ext-doc-type.
     1070     end.
     1071   END CASE.
     1072   END FUNCTION.
     1073   procedure saledoc-create :
     1074   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1075   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1076   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1077   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1078   define input parameter p-doc-kind as character no-undo .
     1079   define input parameter p-office as character no-undo .
     1080   define input parameter p-tpsidoc as logical no-undo .
     1081   define input parameter p-alias-type-price as character no-undo .
     1082   define input parameter p-price-obj-type as character no-undo .
     1083   define input parameter p-price-obj-code as integer no-undo .
     1084   define parameter buffer buf_trn-doc for ub.trn-doc.
     1085   define variable v-order as integer no-undo.
     1086   define variable v-main as logical no-undo .
     1087   define variable v-in-inkas as logical no-undo .
     1088   define variable v-msign as integer no-undo .
     1089   define variable v-dir_ as integer no-undo .
     1090   define variable v-trn-doc-code as character no-undo .
     1091   define buffer buf_sale-doc for ub.sale-doc.
     1092   main-block:
     1093   do
     1094   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1095   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1096   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1097   :
     1098      if available buf_trn-doc then do:
     1099        v-trn-doc-code = buf_trn-doc.doc-code.
     1100      end.
     1101      find first buf_sale-doc where
     1102               buf_sale-doc.inkas-code = p-inkas-code
     1103           and buf_sale-doc.doc-kind = p-doc-kind
     1104           and buf_sale-doc.chr-office = p-office
     1105           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1106           no-error .
     1107      if not available buf_sale-doc  then do:
     1108         create buf_sale-doc.
     1109         assign
     1110         buf_sale-doc.inkas-code = p-inkas-code
     1111         buf_sale-doc.storage =  'trn-doc':U
     1112         buf_sale-doc.host-code = p-host-code
     1113         buf_sale-doc.obj-type = p-obj-type
     1114         buf_sale-doc.obj-code = p-obj-code
     1115         buf_sale-doc.doc-kind  = p-doc-kind
     1116         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1117         buf_sale-doc.chr-office = p-office
     1118         buf_sale-doc.doc-code = v-trn-doc-code
     1119         .
     1120      end.
     1121      if available buf_trn-doc then
     1122      buffer-copy buf_trn-doc
     1123      to buf_sale-doc
     1124      .
     1125     assign
     1126     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1127                                                input p-doc-kind
     1128                                               ,input buf_sale-doc.ext-doc-type
     1129                                               ,output v-order
     1130                                               ,output v-msign
     1131                                               ,output v-main
     1132                                               ,output v-in-inkas
     1133                                               ,output v-dir_).
     1134     assign
     1135     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1136     buf_sale-doc.main-doc = v-main
     1137     buf_sale-doc.in-inkas = v-in-inkas
     1138     buf_sale-doc.msign = v-msign
     1139     buf_sale-doc.dir = v-dir_
     1140     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1141     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1142     buf_sale-doc.poss-wro-codes = '':U
     1143     buf_sale-doc.chr-office = p-office
     1144     buf_sale-doc.tpsidoc = p-tpsidoc
     1145     buf_sale-doc.alias-type-price = p-alias-type-price
     1146     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1147                                    then p-price-obj-type
     1148                                    else '':U)
     1149     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1150                                    then p-price-obj-code
     1151                                    else 0)
     1152     .
     1153     assign
     1154     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1155     no-error.
     1156   end.
     1157   END.
     1158   procedure fbr-saledoc-create :
     1159   define input parameter p-inkas-code as character no-undo .
     1160   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1161   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1162   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1163   define buffer buf_fbr-doc for ub.fbr-doc.
     1164   define buffer buf_trn-doc for ub.trn-doc.
     1165   define buffer buf_sale-doc for ub.sale-doc.
     1166   define buffer buf2_sale-doc for ub.sale-doc.
     1167   define buffer buf2_trn-doc for ub.trn-doc.
     1168   define buffer buf_doc-line for ub.doc-line.
     1169   define buffer buf_gds-dtl for ub.gds-dtl.
     1170   define buffer buf_chk-gds for ub.chk-gds.
     1171   define buffer buf_chk-doc for ub.chk-doc.
     1172   do
     1173   on error undo, return error
     1174   :
     1175     for each buf_fbr-doc no-lock where
     1176           buf_fbr-doc.out-code = p-inkas-code:
     1177       for each buf_trn-doc no-lock where
     1178             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1179       by buf_trn-doc.fact-order
     1180       on error undo, return error:
     1181         if buf_trn-doc.ext-doc-type = 'em':U
     1182         or buf_trn-doc.ext-doc-type = 'im':U
     1183         or buf_trn-doc.ext-doc-type = 'wm':U
     1184         or buf_trn-doc.ext-doc-type = 'ev':U
     1185         or buf_trn-doc.ext-doc-type = 'iv':U
     1186         then do:
     1187           find first buf_sale-doc where
     1188                   buf_sale-doc.inkas-code = p-inkas-code
     1189               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1190               AND buf_sale-doc.storage  = 'trn-doc':U
     1191                   no-error .
     1192           if not available buf_sale-doc then do:
     1193           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     1194           end.
     1195           if buf_trn-doc.ext-doc-type = 'im':U then do:
     1196             assign
     1197             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     1198             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     1199             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     1200             .
     1201           end.
     1202           for each buf2_trn-doc no-lock where
     1203                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     1204             find first buf2_sale-doc where
     1205                     buf2_sale-doc.inkas-code = p-inkas-code
     1206                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     1207                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     1208             if not available buf2_sale-doc then do:
     1209               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     1210             end.
     1211           end.
     1212         end.
     1213       end.
     1214       find first buf_sale-doc where
     1215                 buf_sale-doc.inkas-code = p-inkas-code
     1216             AND buf_sale-doc.storage = 'fbr-doc':U
     1217             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     1218       if not available buf_sale-doc then do:
     1219         create buf_sale-doc.
     1220         assign
     1221         buf_sale-doc.storage       =  'fbr-doc':U
     1222         buf_sale-doc.doc-type      = 'производство':U
     1223         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     1224         buf_sale-doc.ext-doc-type  = 'производство':U
     1225         buf_sale-doc.doc-kind      = 'производство':U
     1226         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     1227         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     1228         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     1229         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     1230         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     1231         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     1232         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     1233         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     1234         buf_sale-doc.fbrsale       = yes
     1235         buf_sale-doc.inkas-code    = p-inkas-code
     1236         .
     1237       end.
     1238     end.
     1239   end.
     1240   end procedure.
     1241   define variable v-mes as character no-undo .
     1242   define variable v-out-pay         as integer   no-undo .
     1243   define variable v-out-pay-str     as character no-undo .
     1244   define variable v-out-pay-type    as character no-undo .
     1245   define variable v-doc-code        like ub.trn-doc.doc-code no-undo .
     1246   define variable v-doc-code-chip   like ub.trn-doc.doc-code no-undo .
     1247   define variable v-prev-doc-code   like ub.trn-doc.doc-code no-undo .
     1248   define variable v-seq             as integer no-undo .
     1249   define variable v-seq-max         as integer no-undo .
     1250   define variable v-sum-rubl        as decimal no-undo .
     1251   define variable v-sum-base        as decimal no-undo .
     1252   define variable v-qnty            as decimal no-undo .
     1253   define variable v-insalepr        as logical initial ? no-undo.
     1254   define variable v-attr-type       as character no-undo .
     1255   define variable v-exist           as logical   no-undo .
     1256   define variable v-pl-code         as integer no-undo.
     1257   define variable v-value           as character no-undo.
     1258   define variable v-ok              as logical no-undo.
     1259   define variable v-gds-list-diff-place as character no-undo .
     1260   define buffer buf_doc-line      for ub.doc-line.
     1261   define buffer buf_doc-line-attr for ub.doc-line-attr.
     1262   define buffer buf_gds-dtl       for ub.gds-dtl.
     1263   define buffer buf_parts         for ub.parts.
     1264   define buffer buf_inv-line      for ub.inv-line.
     1265   define buffer buf_doc-pl        for ub.doc-pl.
     1266   define buffer buf_goods         for ub.goods.
     1267   define buffer buf_units         for ub.units.
     1268   define buffer in_doc-pl         for ub.doc-pl.
     1269   define buffer in_inv-line       for ub.inv-line.
     1270   define buffer in_doc-line       for ub.doc-line.
     1271   define buffer in_gds-dtl        for ub.gds-dtl.
     1272   define buffer buf_sale-doc      for ub.sale-doc.
     1273   define buffer buf_pl-gds        for ub.pl-gds.
     1274   define temp-table tt-in_trn-doc       no-undo like lib-trn_ret-doc.
     1275   define temp-table tt-in_doc-line      no-undo like lib-trn_ret-line.
     1276   define temp-table tt-in_doc-line-attr no-undo like lib-trn_ret-line-attr.
     1277   define temp-table tt-in_gds-dtl       no-undo like lib-trn_ret-dtl.
     1278   define temp-table tt-in_parts         no-undo like lib-trn_ret-parts.
     1279   define temp-table temp-tank           no-undo like ub.doc-pl
     1280   field doc-seq       as integer
     1281   field artic         like ub.goods.artic
     1282   field prod-type     like ub.goods.prod-type
     1283   field prod-code     like ub.goods.prod-code
     1284   field price-base    like ub.doc-line.price-base
     1285   field price-rubl    like ub.doc-line.price-rubl
     1286   field price-cli     like ub.doc-line.price-cli
     1287   field cli-base-rate like ub.doc-line.cli-base-rate
     1288   field unit-type     like ub.units.type
     1289   index pi is unique primary
     1290   doc-seq gds-code
     1291   index
     1292   iart
     1293   artic prod-type prod-code.
     1294   define buffer buf_temp-tank  for temp-tank.
     1295   define buffer buf2_temp-tank for temp-tank.
     1296   _main:
     1297   do
     1298   on error undo, return error return-value :
     1299     if not available buf_trn-doc then do:
     1300           undo _main, return error substitute("&1 &2 &3&4Отсутствует документ списания техпролива"
     1301                                               ,vss-workfile
     1302                                               ,vss-revision
     1303                                               ,vss-description
     1304                                               ,chr(10)).
     1305     end.
     1306     if (buf_trn-doc.ext-doc-type <> 'we':U and buf_trn-doc.ext-doc-type <> 'ee':U)
     1307     or buf_trn-doc.internal <> no
     1308     or buf_trn-doc.status_ <> 'факт':U then do:
     1309       undo _main, return error substitute("&1 &2 &3&4Документ списания техпролива, используемый для создания прихода по техпроливу&4" +
     1310                                             "имеет неправильный расширенный тип &5 или internal &6 или статус &7"
     1311                                             ,vss-workfile
     1312                                             ,vss-revision
     1313                                             ,vss-description
     1314                                             ,chr(10)
     1315                                             , buf_trn-doc.ext-doc-type
     1316                                             , buf_trn-doc.internal
     1317                                             , buf_trn-doc.status_
     1318                                             ).
     1319     end.
     1320     find first buf_sale-doc where buf_sale-doc.inkas-code = buf_trn-doc.out-code no-lock no-error.
     1321     for each buf_temp-tank:
     1322       delete buf_temp-tank.
     1323     end.
     1324     v-gds-list-diff-place = "" .
     1325     for each buf_doc-pl no-lock where
     1326             buf_doc-pl.out-code = buf_trn-doc.doc-code
     1327     break
     1328     by buf_doc-pl.gds-code:
     1329       if first-of(buf_doc-pl.gds-code) then do:
     1330         assign
     1331         v-seq = 0.
     1332       end.
     1333       create buf_temp-tank.
     1334       buffer-copy buf_doc-pl
     1335       to buf_temp-tank
     1336       assign
