      483   function cross-list returns logical (
      484     input parfirst-stream  as character,
      485     input parsecond-stream as character,
      486     input pardelim         as character).
      487     if pardelim = ""
      488     or pardelim = ?
      489     then do:
      490       assign
      491         pardelim = ","
      492       .
      493     end.
      494     define variable vari            as integer no-undo .
      495     define variable varresult-cross as logical no-undo .
      496     assign
      497       varresult-cross = no
      498     .
      499     def var v-num-parfirst-stream as integer no-undo .
      500     assign
      501       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      502     .
      503     do vari = 1 to v-num-parfirst-stream
      504     :
      505       if lookup(entry(vari, parfirst-stream, pardelim)
      506                ,parsecond-stream
      507                ,pardelim
      508                ) > 0 then do:
      509         assign
      510           varresult-cross = yes
      511         .
      512         leave.
      513       end.
      514     end.
      515     return varresult-cross .
      516   end function.
