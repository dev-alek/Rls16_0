     1719   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1721     (input  in_doc-line.obj-type
     1722     ,input  in_doc-line.obj-code
     1723     ,input  in_doc-line.artic
     1724     ,input  in_doc-line.prod-type
     1725     ,input  in_doc-line.prod-code
     1726     ,input  'insalepr=request':U
     1727     ,output v-insalepr
     1728     )  .
     1729           if v-insalepr = false
     1730           or (can-do(v-gds-list-diff-place, string(buf_temp-tank.gds-code)) and in_doc-line.fact-qnty = buf_temp-tank.fact-qnty)
     1731           then do:
     1732             assign
     1733               in_doc-line.price-base = buf_temp-tank.price-base
     1734               in_doc-line.price-rubl = buf_temp-tank.price-rubl
     1735             .
     1736           end.
     1737           if in_doc-line.price-rubl = buf_temp-tank.price-rubl
     1738           then do :
     1739             assign
     1740               in_doc-line.cli-qnty = buf_temp-tank.cli-qnty
     1741               in_doc-line.doc-density = in_doc-line.cli-qnty / in_doc-line.fact-qnty
     1742               in_doc-line.fact-density = in_doc-line.doc-density
     1743               in_doc-line.cli-base-rate = 1 / in_doc-line.doc-density
     1744               in_doc-line.price-cli = buf_temp-tank.price-cli
     1745             .
     1746           end .
     1747         end.
     1748       end.
     1749       for each buf_doc-pl no-lock where
