        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-log-handle     as handle no-undo .
        4   define input parameter log-file-name    as character no-undo .
        5   define input parameter p-auto           as integer no-undo .
        6   define input parameter v-curr-r-b       as character no-undo .
        7   define input parameter p-close-in-rfsl  as integer no-undo .
        8   define input parameter p-doc-kind       as character no-undo .
        9   define parameter buffer buf_trn-doc for ub.trn-doc.
       10   define parameter buffer buf-new_trn-doc for ub.trn-doc.
       11   define variable vss-revision    as character no-undo init "$Revision: 315b966a6a9b, 3487, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: BelovaMM $":U .
       13   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:36 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: techrfsl.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: str/techrfsl.p $":U .
       16   define variable vss-description as character no-undo init "Создание приходного документа техпролива по документу Техпролива, относящемуся к продаже".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
