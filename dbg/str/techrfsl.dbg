     1766             in_doc-pl.cli-fact-qnty = in_doc-pl.cli-qnty
     1767           .
     1768         end .
     1769       end .
     1770       for each buf_inv-line no-lock where
     1771               buf_inv-line.doc-code = buf_trn-doc.doc-code,
     1772          first  buf_temp-tank where
     1773                    buf_temp-tank.artic = buf_inv-line.artic
     1774                AND buf_temp-tank.prod-type = buf_inv-line.prod-type
     1775                AND buf_temp-tank.prod-code = buf_inv-line.prod-code
     1776                AND buf_temp-tank.doc-seq  = v-seq
     1777       on error undo _main, return error return-value :
     1778         find first in_inv-line where
     1779                   in_inv-line.artic = buf_inv-line.artic
     1780             AND in_inv-line.prod-type = buf_inv-line.prod-type
     1781             AND in_inv-line.prod-code = buf_inv-line.prod-code
     1782             AND in_inv-line.doc-code = v-doc-code-chip no-error .
     1783         if available in_inv-line then do:
     1784           assign
     1785             in_inv-line.wast-cli-qnty = buf_temp-tank.cli-qnty
     1786             in_inv-line.after-cli-qnty = in_inv-line.before-cli-qnty + in_inv-line.wast-cli-qnty
     1787             in_inv-line.wast-rubl = buf_temp-tank.price-cli
     1788             in_inv-line.wast-base = buf_temp-tank.price-cli / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     1789             in_inv-line.unus-wast-rubl = in_inv-line.wast-rubl
     1790             in_inv-line.unus-wast-base = in_inv-line.wast-base
     1791           .
     1792         end .
     1793       end .
     1794       for each buf_gds-dtl no-lock where
     1795               buf_gds-dtl.doc-code = buf_trn-doc.doc-code,
     1796           first buf_temp-tank where
     1797                 buf_temp-tank.artic = buf_gds-dtl.artic
     1798             AND buf_temp-tank.prod-type = buf_gds-dtl.prod-type
     1799             AND buf_temp-tank.prod-code = buf_gds-dtl.prod-code
     1800             AND  buf_temp-tank.doc-seq   = v-seq
     1801       on error undo _main, return error return-value :
     1802         find first in_GDS-DTL where
     1803                   in_GDS-DTL.artic = buf_gds-dtl.artic
     1804             AND in_GDS-DTL.prod-type = buf_gds-dtl.prod-type
     1805             AND in_gds-dtl.prod-code = buf_gds-dtl.prod-code
     1806             AND in_gds-dtl.prt-code = buf_gds-dtl.prt-code
     1807             AND in_gds-dtl.doc-code = v-doc-code-chip no-error .
     1808         if not available in_gds-dtl then do:
     1809   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1810     ( input buf_gds-dtl.obj-code
     1811      ,input buf_gds-dtl.obj-type
     1812      ,input v-doc-code-chip
     1813      ,input buf_gds-dtl.artic
     1814      ,input buf_gds-dtl.prod-code
     1815      ,input buf_gds-dtl.prod-type
     1816      ,input buf_gds-dtl.prt-code
     1817      ,input no
     1818     )  .
     1819           find first in_gds-dtl where
     1820                     in_gds-dtl.artic = buf_gds-dtl.artic
     1821               AND in_gds-dtl.prod-type = buf_gds-dtl.prod-type
     1822               AND in_gds-dtl.prod-code = buf_gds-dtl.prod-code
     1823               AND in_gds-dtl.prt-code = buf_gds-dtl.prt-code
     1824               AND in_gds-dtl.doc-code = v-doc-code-chip .
     1825           find first in_doc-line where
     1826                     in_doc-line.artic = buf_gds-dtl.artic
     1827               AND in_doc-line.prod-type = buf_gds-dtl.prod-type
     1828               AND in_doc-line.prod-code = buf_gds-dtl.prod-code
     1829               AND in_doc-line.doc-code = v-doc-code-chip .
     1830           assign
     1831           in_gds-dtl.doc-qnty = buf_temp-tank.doc-qnty
     1832           in_gds-dtl.fact-qnty = buf_temp-tank.fact-qnty
