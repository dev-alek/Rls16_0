     1839     ,input  in_gds-dtl.artic
     1840     ,input  in_gds-dtl.prod-type
     1841     ,input  in_gds-dtl.prod-code
     1842     ,input  'insalepr=request':U
     1843     ,output v-insalepr
     1844     )  .
     1845         assign
     1846         in_gds-dtl.price-base = if v-insalepr = false
     1847                                 then (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1848                                 else in_doc-line.price-base
     1849         in_gds-dtl.price-rubl = if v-insalepr = false
     1850                                 then (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1851                                 else in_doc-line.price-rubl
     1852         in_gds-dtl.discnt-pc = 0
     1853         in_gds-dtl.discnt-base = 0
     1854         in_gds-dtl.discnt-rubl = 0
