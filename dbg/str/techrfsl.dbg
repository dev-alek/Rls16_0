     1857       if v-seq-max > 1
     1858       and v-seq < v-seq-max then
     1859       run write-log-and-file in p-log-handle (
     1860             input 1
     1861           , input log-file-name
     1862           , input 1
     1863           , input substitute("Создана приходная накладная по Техпроливу &1 в статусе &2..."
     1864                              ,v-doc-code-chip
     1865                              ,buf-new_trn-doc.status_
     1866                             )).
     1867       if p-close-in-rfsl = 1 then do:
     1868         run write-log-and-file in p-log-handle (
     1869               input 1
     1870             , input log-file-name
     1871             , input 1
     1872             , input substitute("Согласно настройкам приходная накладная по Техпроливу &1 в статусе &2 закрывается на факт..."
     1873                               ,v-doc-code-chip
     1874                               ,buf-new_trn-doc.status_
     1875                               )).
     1876        run close-trn in this-procedure (
     1877                                         buffer buf-new_trn-doc
     1878                                       ) no-error.
     1879        if error-status:error then do:
     1880          undo _main, return error return-value .
     1881        end.
     1882       end.
     1883     end.
     1884   end.
     1885   procedure close-trn :
     1886   define parameter buffer buf_trn-doc for ub.trn-doc.
     1887   define variable varmode            as   character           no-undo.
     1888   define variable varstatus          like ub.trn-doc.status_  no-undo.
     1889   define variable varflag            like ub.trn-doc.flag     no-undo.
     1890   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     1891   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     1892   define variable varcheck-return    as   logical             no-undo.
     1893   define variable varchg-inv         as   logical             no-undo.
     1894   main-block:
     1895   do
     1896   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1897   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1898   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1899   :
     1900     assign
     1901     varmode         = '<закрытие документа на факт>':U
     1902     varcheck-return = true
     1903     varchg-inv      = true
     1904     .
     1905     run gbl/calc-trn.p ( input parparentproc
     1906                     ,input  recid(buf_trn-doc)).
     1907   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1908     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1909     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1910     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     1911     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     1912     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     1913     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     1914     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1915     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1916     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1917     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1918     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1919     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1920     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1921     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1922     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1923     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1924     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1925     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1926     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1927     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1928     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1929     define variable v-cntxp-conf-par        as   character                no-undo.
     1930     define variable v-cntxp-par-type        as   character                no-undo.
     1931     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1932     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1933     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     1934     define variable v-cntxp-db-num          as integer   no-undo .
     1935     define variable v-cntxp-userid          as character no-undo .
     1936     define variable v-cntxp-level           as character no-undo .
     1937     define variable v-cntxp-db-num-obj      as integer   no-undo .
     1938     define variable v-cntxp-is-admin        as logical   no-undo .
     1939     define buffer bf-cntxp_store for ub.store.
     1940     define buffer bf-cntxp_shop  for ub.shop.
     1941     define buffer bf-cntxp_sysconf for ub.sysconf.
     1942   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1943     define variable v-cntxt-db-num        as integer   no-undo .
     1944     define variable v-cntxt-userid        as character no-undo .
     1945     define variable v-cntxt-level         as character no-undo .
     1946     define variable v-cntxt-host-code-obj as integer   no-undo .
     1947     define variable v-cntxt-obj-type      as character no-undo .
     1948     define variable v-cntxt-obj-code      as integer   no-undo .
     1949     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1950     define variable v-cntxt-is-admin      as logical   no-undo .
     1951   assign
     1952   v-cntxt-obj-type = buf_trn-doc.obj-type
     1953   v-cntxt-obj-code = buf_trn-doc.obj-code
     1954   v-cntxt-host-code-obj = buf_trn-doc.host-code
     1955   v-cntxt-db-num-obj = g#db-num
     1956   v-cntxt-db-num = g#db-num
     1957   v-cntxt-userid = g#userid
     1958   .
     1959   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1960     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     1961        v-cntxp-obj-code <> 0 then do:
     1962   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1963     (input  'is-prt'
     1964     ,input  0
     1965     ,input  ''
     1966     ,input  0
     1967     ,input  ''
     1968     ,input  ''
     1969     ,input  ''
     1970     ,input  yes
     1971     ,output v-cntxp-conf-par
     1972     ,output v-cntxp-par-type
     1973     ) no-error .
     1974       case v-cntxp-obj-type :
     1975         when 'скл':U then do:
     1976           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     1977           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     1978           assign
     1979             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     1980             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     1981             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     1982             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     1983             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     1984             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     1985             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     1986             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     1987             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     1988             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     1989             v-cntxp-load-time       = bf-cntxp_store.load-time
     1990             v-cntxp-holidays        = bf-cntxp_store.holidays
     1991             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     1992             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1993             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1994             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1995             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1996             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1997             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1998             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1999             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2000             .
     2001         end.
     2002         when 'маг':U then do:
     2003           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     2004           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     2005           assign
     2006             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     2007             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     2008             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     2009             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     2010             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     2011             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     2012             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     2013             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     2014             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     2015             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     2016             v-cntxp-load-time       = bf-cntxp_shop.load-time
     2017             v-cntxp-holidays        = bf-cntxp_shop.holidays
     2018             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     2019             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     2020             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     2021             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     2022             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     2023             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     2024             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     2025             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     2026             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2027             .
     2028         end.
     2029       end case.
     2030     end.
     2031   buf_trn-doc.tot-cli = buf_trn-doc.tot-calc.
     2032   run str/trn-stat.p (
     2033        input  parparentproc
     2034       ,input  this-procedure:handle
     2035       ,input  varmode
     2036       ,input  buf_trn-doc.doc-code
     2037       ,input  varcheck-return
     2038       ,input  g#db-num
     2039       ,input  v-cntxp-in-ov
     2040       ,input  v-cntxp-rsrv-time
     2041       ,input  v-cntxp-load-time
     2042       ,input  v-cntxp-holidays
     2043       ,input  NO
     2044       ,output varchg-inv
     2045       ,output table gds-list)    no-error.
     2046   if error-status:error then do:
     2047     undo main-block, return error substitute("Ошибка при принудительном закрытии документа прихода по техпроливу по списанию по техпроливу по продаже &1&2" +
     2048                                         "&3&2&4&2"
     2049                                         , buf_trn-doc.doc-code
     2050                                         , chr(10)
     2051                                         , error-status:get-message(1)
     2052                                         , return-value ).
     2053     end.
     2054   end.
     2055   end procedure.
