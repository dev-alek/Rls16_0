       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure doc-code:
       88   define input  parameter parmode          as   character           no-undo.
       89   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       90   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       91   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       92   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       93   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       94   define variable vardb-remote     as   logical             no-undo.
       95   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       96   define variable v-delimiter as character no-undo .
       97   do
       98   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       99   :
      100   find first buf_sys-ctrl no-lock .
      101   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      102     CASE parmode:
      103       when "main":u then do:
      104         if vardb-remote then do:
      105           assign
      106             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      107         end.
      108         else do:
      109           assign
      110             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      111         end.
      112       end.
      113       when "trio" then do:
      114         assign
      115           pardoc-code = replace (parroot-doc-code, "=", "*").
      116       end.
      117       otherwise do:
      118         assign
      119         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      120         no-error
      121         .
      122         if error-status:error  then do:
      123           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      124                                         ,chr(10)
      125                                         ,parmode
      126                                         ).
      127         end.
      128         if num-entries(parmode) = 1
      129         and parmode <> "chip":U
      130         and parmode <> "chip_s":U
      131         then do:
      132           assign
      133           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      134         end.
      135         else if (lookup("chip":U, parmode) > 0
      136                  or
      137                  lookup("chip_s":U, parmode) > 0) then do:
      138           assign
      139             vartemp-doc-code = parroot-doc-code.
      140           do while true:
      141             if index (vartemp-doc-code , ".") = 0 then
      142               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      143             else
      144               vartemp-doc-code  =
      145               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      146               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      147               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      148             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      149           end.
      150           assign
      151             pardoc-code = vartemp-doc-code.
      152         end.
      153       end.
      154     end CASE.
      155     if pardoc-code = '':U
      156     or (parroot-doc-code <> '':U
      157     and pardoc-code = parroot-doc-code) then do:
      158       undo, return error substitute("Ошибка при генерации номера документа&1"
      159                                     ,chr(10)).
      160     end.
      161   end.
      162   end. // procedure/method
      163   function get-doc-code-int64 returns int64
      164     ( input p-doc-code as character ) :
      165     define variable v-ind              as integer   no-undo .
      166     define variable v-num-entries      as integer   no-undo .
      167     define variable v-doc-code-int64   as int64     no-undo .
      168     define variable v-canonic-doc-code as character no-undo .
      169     assign
      170       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      171       v-canonic-doc-code = p-doc-code
      172     .
      173     do v-ind = 1 to v-num-entries
      174     :
      175       assign
      176         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      177       .
      178     end.
      179     assign
      180       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      181     .
      182     return v-doc-code-int64 .
      183   end. // function/method
      184   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   define variable v-waitfram-action01         as character   no-undo .
      186   define variable v-waitfram-action02         as character   no-undo .
      187   define variable v-waitfram-action03         as character   no-undo .
      188   define variable mWaitFramTextBeg            as character   no-undo.
      189   define variable mWaitFramTextEnd            as character   no-undo.
      190   define variable mWaitFramView               as logical     no-undo.
      191   define variable mWaitProcEvent              as logical     no-undo init yes.
      192   define variable mWaitFramInterval           as integer     no-undo init 1 .
      193   define variable mWaitFramStop               as logical     no-undo.
      194   define variable mWaitFramStopUser           as logical     no-undo.
      195   define variable mWaitFramStopTimeOut        as logical     no-undo.
      196   define variable mWaitFramStartProc          as datetime-tz no-undo.
      197   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      198   define button B-WaitFramStop auto-end-key
      199        label "Стоп"
      200        size 10 by 1 tooltip "Остоновить процесс".
      201   define button B-viewProcInfo
      202        label "Информация"
      203        size 15 by 1 tooltip "Информация о процесс".
      204   define frame waitfram
      205     v-waitfram-action01 format "x(72)" no-label skip
      206     v-waitfram-action02 format "x(72)" no-label skip
      207     v-waitfram-action03 format "x(72)" no-label skip
      208     B-viewProcInfo
      209     B-WaitFramStop at row 4 col 30
      210     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      211     .
      212   define new global shared variable mBatchMode as logical no-undo init ?.
      213   define variable mFramBachModHandle as handle no-undo.
      214   mFramBachModHandle = frame waitfram:handle.
      215   define variable mFameOldVis as logical no-undo.
      216   define variable mVisCUrentVin as logical no-undo.
      217   if session:batch-mode
      218   then
      219      mBatchMode = yes.
      220   if mBatchMode = ? then do:
      221     mVisCUrentVin = current-window:visible.
      222     mFameOldVis = mFramBachModHandle:visible.
      223     mFramBachModHandle:visible  = yes.
      224     mBatchMode = mFramBachModHandle:visible ne yes.
      225     mFramBachModHandle:visible = mFameOldVis.
      226     current-window:visible = mVisCUrentVin.
      227   end.
      228    if  log-manager:logfile-name ne ?
      229     then DO:
      230         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      231         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      232         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      233     end.
      234   on choose of B-WaitFramStop in frame waitfram
      235   do:
      236     mWaitFramStop = yes.
      237     mWaitFramStopUser = yes.
      238   end.
      239   function waitfram-check-timeout returns logical():
      240      define variable vtime as int64 no-undo.
      241      if mWaitFramStopTimeOut
      242      then
      243         return yes.
      244      vtime = ( now - mWaitFramStartProc ) / 1000 .
      245      if     mWaitFramTimeOut ne ?
      246         and mWaitFramTimeOut ne 0
      247         and mWaitFramTimeOut lt vtime
      248      then do:
      249         mWaitFramStopTimeOut = yes.
      250      end.
      251      return mWaitFramStopTimeOut.
      252   end.
      253   procedure waitfram-hide :
      254     if not session:batch-mode
      255     then do
      256     on error undo, return error return-value
      257     :
      258       pause 0 before-hide .
      259       if not mBatchMode then
      260         hide frame waitfram .
      261     if     not mWaitFramView
      262        and mWaitProcEvent
      263     then
      264       process events .
      265     end.
      266   end procedure.
      267   procedure waitfram-show :
      268     define input  parameter p-message as character no-undo .
      269     define variable v-left-margin as integer   no-undo .
      270     if not session:batch-mode
      271     then do
      272     on error undo, return error return-value
      273     :
      274       if length(p-message) <= 70 then do:
      275         assign
      276           v-left-margin = integer((70 - length(p-message)) / 2)
      277         .
      278         assign
      279           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      280         .
      281         assign
      282           v-waitfram-action01 = " "
      283           v-waitfram-action02 = " "
      284                                    + fill(" ", v-left-margin)
      285                                    + p-message
      286           v-waitfram-action03 = " "
      287         .
      288       end.
      289       else do:
      290         define variable vRindex1 as integer no-undo.
      291         define variable vRindex2 as integer no-undo.
      292         vRindex1 = r-index(p-message," ",70).
      293         if vRindex1 = 0
      294         then
      295            vRindex1 = 70.
      296         if length(p-message)  <= vRindex1 + 70 then do:
      297           assign
      298             v-waitfram-action01 = " "
      299             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      300             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      301           .
      302         end.
      303         else do:
      304           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      305           if vRindex2 <= vRindex1
      306           then
      307              vRindex2 = vRindex1 + 70.
      308           assign
      309             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      310             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      311             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      312           .
      313         end.
      314       end.
      315       B-viewProcInfo:visible   in frame waitfram = no.
      316       B-viewProcInfo:sensitive in frame waitfram = no.
      317       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      318       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      319       if  (   mWaitFramView
      320          or  mWaitProcEvent)
      321          and not mBatchMode
      322       then
      323          display
      324             v-waitfram-action01 skip
      325             v-waitfram-action02 skip
      326             v-waitfram-action03 skip
      327          with frame waitfram .
      328       if     mWaitFramView
      329          then do:
      330             if     mWaitFramInterval ne ?
      331                and not mBatchMode
      332             then
      333                wait-for go of frame waitfram pause mWaitFramInterval.
      334          end.
      335          else
      336             if     mWaitProcEvent
      337                and not mBatchMode
      338             then
      339                process events .
      340     end.
      341   end procedure.
      342      procedure waitfram-show-this:
      343         define input  parameter iInterval as int64 no-undo.
      344         define variable vtime as int64 no-undo.
      345         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      346         mWaitFramInterval = iInterval.
      347         run waitfram-show (substitute("&1&2 &3&4" ,
      348                                       mWaitFramTextBeg ,
      349                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      350                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      351                                       mWaitFramTextEnd
      352                                      )
      353                           ).
      354      end.
      355      procedure WaitFramRunPause:
      356         define input  parameter iInterval as dec no-undo.
      357         define variable vStart  as datetime-tz no-undo.
      358         define variable vend    as datetime-tz no-undo.
      359         define variable vint as int64 no-undo.
      360         define variable vOk as logical no-undo.
      361         vStart = now.
      362         vend   = vStart.
      363         publish "WaitFramPause" (iInterval,output vOk).
      364         vend   =  now.
      365         vint = vend - vStart.
      366         vint = iInterval - vint / 1000.
      367         if     not mWaitFramStop
      368            and (   vint > 0
      369                 or (    not vOk
      370                     and iInterval eq ?
      371                     )
      372                 )
      373         then
      374            run waitfram-show-this (iInterval).
      375         vend   =  now.
      376         vint = vend - vStart.
      377         vint = iInterval - vint / 1000.
      378         if     not mWaitFramStop
      379            and vint > 0
      380         then do:
      381            run gbl/pause.p (vint * 1000).
      382         end.
      383         if iInterval ne ?
      384         then
      385            publish "WaitFramStop".
      386         waitfram-check-timeout().
      387      end.
      388      procedure WaitFramWaitFor:
      389         define input  parameter iInterval as dec no-undo.
      390         assign
      391            mWaitFramStartProc   = now
      392            mWaitFramStopUser    = no
      393            mWaitFramStopTimeOut = no
      394         .
      395         block-wait:
      396         do while not mWaitFramStop:
      397            run WaitFramRunPause (iInterval).
      398            if  waitfram-check-timeout()
      399            then do:
      400               leave block-wait.
      401            end.
      402         end.
      403         run waitfram-hide.
      404      end.
      405   procedure waitfram-join :
      406     define input  parameter p-line-1  as character no-undo .
      407     define input  parameter p-line-2  as character no-undo .
      408     define input  parameter p-line-3  as character no-undo .
      409     define output parameter p-message as character no-undo .
      410     do
      411     on error undo, return error return-value
      412     :
      413       assign
      414         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      415                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      416                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      417       .
      418     end.
      419   end procedure.
      420   function waitfram-join-function returns character
      421     (input p-line-1 as character
      422     ,input p-line-2 as character
      423     ,input p-line-3 as character
      424     ).
      425     define variable v-message as character no-undo .
      426     run waitfram-join in this-procedure
      427       (input  p-line-1
      428       ,input  p-line-2
      429       ,input  p-line-3
      430       ,output v-message
      431       ) .
      432     return v-message .
      433   end function .
