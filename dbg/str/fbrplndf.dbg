        1   define input parameter parparentproc        as widget-handle    no-undo.
        2   define input parameter p-fbr-pln-doc-code   as character        no-undo.
        3   define input parameter p-fbr-pln-obj-type   as character        no-undo.
        4   define input parameter p-fbr-pln-obj-code   as integer          no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "План-меню: список документов производства.".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "X(65)" no-undo
       72   initial "@(#)$Workfile$ $Revision$".
       73   procedure fbrpln-create-line :
       74   define input parameter p-doc-code       as character    no-undo.
       75   define input parameter p-gds-code       as integer      no-undo.
       76   define input parameter p-recipe-code    as character    no-undo.
       77   define input parameter p-fbr-obj-type   as character    no-undo.
       78   define input parameter p-fbr-obj-code   as integer      no-undo.
       79   define input parameter p-silence        as logical      no-undo.
       80   define input parameter p-qnty           as decimal      no-undo.
       81       define buffer buf_fbr-pln       for fbr-pln.
       82       define buffer buf_fbr-pln-line  for fbr-pln-line.
       83       define buffer buf_goods         for goods.
       84   do
       85   for buf_fbr-pln
       86     , buf_fbr-pln-line
       87     , buf_goods
       88   on error undo, return error
       89   :
       90       find first buf_fbr-pln no-lock
       91            where buf_fbr-pln.doc-code = p-doc-code
       92       .
       93       if buf_fbr-pln.status_ <> 'новый':U
       94       then do:
       95           if p-silence = no
       96           then do:
       97               message
       98                   skip "Добавить строки можно только"
       99                   skip "в документ в статусе 'новый'"
      100               view-as alert-box error.
      101           end.
      102           undo, return error .
      103       end.
      104       find first buf_goods no-lock
      105            where buf_goods.gds-code = p-gds-code
      106       .
      107       if p-recipe-code <> ""
      108       and p-fbr-obj-type = ""
      109       and p-fbr-obj-code = 0
      110       then do:
      111           if p-silence = no
      112           then do:
      113               message
      114                   skip "Не задан объект для производства товара с рецептом."
      115                   skip "Товар: " buf_goods.artic buf_goods.gds-name
      116                   skip(1)
      117                   skip "Товар не может быть включен в план-меню."
      118               view-as alert-box error.
      119           end.
      120           undo, return error .
      121       end.
      122       do transaction
      123       on error undo, return error
      124       :
      125           create buf_fbr-pln-line.
      126           assign
      127               buf_fbr-pln-line.doc-code       = p-doc-code
      128               buf_fbr-pln-line.gds-code       = p-gds-code
      129               buf_fbr-pln-line.recipe-code    = p-recipe-code
      130               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
      131               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
      132               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
      133               buf_fbr-pln-line.fact-qnty      = p-qnty
      134               buf_fbr-pln-line.artic          = buf_goods.artic
      135               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
      136               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
      137               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
      138               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
      139               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
      140           .
      141       end.
      142   end.
      143   end procedure.
      144   procedure fbrpln-create-doc :
      145   define input parameter p-obj-type   as character    no-undo.
      146   define input parameter p-obj-code   as integer      no-undo.
      147   define input parameter p-doc-type   as character    no-undo.
      148   define input parameter p-db-remote  as logical          no-undo.
      149   define input parameter p-userid     as character        no-undo.
      150   define output parameter p-doc-code  as character    no-undo.
      151       define variable v-today     as date           no-undo.
      152       define variable v-time      as integer        no-undo.
      153       define variable v-host-code as integer        no-undo.
      154       define variable v-doc-code  as character      no-undo.
      155       define buffer buf_fbr-pln       for fbr-pln.
      156   do
      157   for buf_fbr-pln
      158   on error undo, return error
      159   :
      160       run cur-time in this-procedure (
      161             output v-today
      162           , output v-time
      163       ).
      164   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      166     (input  p-obj-type
      167     ,input  p-obj-code
      168     ,output v-host-code
      169     )  .
      170       run fbrpln-doc-code (
      171             input p-obj-type
      172           , input p-obj-code
      173           , input p-db-remote
      174           , output v-doc-code
      175       ).
      176       create buf_fbr-pln.
      177       assign
      178           buf_fbr-pln.doc-code        = v-doc-code
      179           buf_fbr-pln.doc-type        = p-doc-type
      180           buf_fbr-pln.obj-type        = p-obj-type
      181           buf_fbr-pln.obj-code        = p-obj-code
      182           buf_fbr-pln.doc-date        = v-today
      183           buf_fbr-pln.creid           = p-userid
      184           buf_fbr-pln.PS              = ""
      185           buf_fbr-pln.fact-date       = ?
      186           buf_fbr-pln.fact-time       = ?
      187           buf_fbr-pln.fact-num        = 0
      188           buf_fbr-pln.fact-order      = 0
      189           buf_fbr-pln.host-code       = v-host-code
      190           buf_fbr-pln.status_         = 'новый':U
      191           buf_fbr-pln.sys-date        = v-today
      192           buf_fbr-pln.sys-time-int    = v-time
      193           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
      194           buf_fbr-pln.user-name       = p-userid
      195       .
      196       assign
      197           p-doc-code = buf_fbr-pln.doc-code
      198       .
      199   end.
      200   end procedure.
      201   procedure fbrpln-create-fbr-doc :
      202   define input parameter p-obj-type       as character        no-undo.
      203   define input parameter p-obj-code       as integer          no-undo.
      204   define input parameter p-pln-doc-code   as character        no-undo.
      205   define input parameter p-db-remote      as logical          no-undo.
      206   define input parameter p-userid         as character        no-undo.
      207   define output parameter p-doc-code      as character        no-undo.
      208       define variable v-today         as date             no-undo.
      209       define variable v-host-code     as integer          no-undo.
      210       define variable v-base-code     as integer          no-undo.
      211       define buffer buf_curr-accnt    for curr-accnt.
      212       define buffer buf_fbr-doc       for fbr-doc.
      213       define buffer buf_fbr-pln       for fbr-pln.
      214   do
      215   for buf_curr-accnt
      216     , buf_fbr-doc
      217     , buf_fbr-pln
      218   on error undo, return error
      219   :
      220   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      222     (input  p-obj-type
      223     ,input  p-obj-code
      224     ,output v-today
      225     )  .
      226   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      228     (input  p-obj-type
      229     ,input  p-obj-code
      230     ,output v-host-code
      231     )  .
      232   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      234     (input  v-host-code
      235     ,output v-base-code
      236     )  .
      237       find last buf_curr-accnt no-lock
      238           where buf_curr-accnt.curr-code = v-base-code
      239             and buf_curr-accnt.exch-date <= v-today
      240       use-index pi
      241       no-error.
      242       if not available buf_curr-accnt
      243       then do:
      244           message
      245               "На дату" v-today "неизвестен курс базовой валюты."
      246           view-as alert-box error.
      247           undo, return error.
      248       end.
      249       run doc-code in this-procedure (
      250             input  "main"
      251           , input  p-obj-type
      252           , input  p-obj-code
      253           , input  ?
      254           , output p-doc-code
      255       ) no-error.
      256       if error-status:error
      257       then do:
      258           message
      259               "Ошибка при генерации номера документа производства."
      260               skip return-value
      261               skip trim(error-status :get-message(1))
      262                       trim(error-status :get-message(2))
      263                       trim(error-status :get-message(3))
      264           view-as alert-box error.
      265           return error.
      266       end.
      267       run trg/chkdocnm.p (
      268             input p-doc-code
      269           , input "fbr-doc"
      270           , input "?"
      271       ) no-error.
      272       if error-status:error
      273       then do:
      274           message
      275                       vss-workfile vss-revision vss-description
      276               skip "Ошибка при проверке номера для нового документа."
      277               skip return-value
      278               skip trim(error-status :get-message(1))
      279                       trim(error-status :get-message(2))
      280                       trim(error-status :get-message(3))
      281           view-as alert-box error.
      282           undo, return error .
      283       end.
      284       create buf_fbr-doc.
      285       assign
      286           buf_fbr-doc.doc-code  = p-doc-code
      287           buf_fbr-doc.creid     = p-userid
      288           buf_fbr-doc.doc-date  = v-today
      289           buf_fbr-doc.doc-type  = 'производство':U
      290           buf_fbr-doc.host-code = v-host-code
      291           buf_fbr-doc.obj-type  = p-obj-type
      292           buf_fbr-doc.obj-code  = p-obj-code
      293           buf_fbr-doc.PS        = "@"
      294           buf_fbr-doc.status_   = 'новый':U
      295           buf_fbr-doc.out-code  = p-pln-doc-code
      296       .
      297   end.
      298   end procedure.
      299   procedure fbrpln-doc-code :
      300   define input parameter p-obj-type   as character    no-undo.
      301   define input parameter p-obj-code   as integer      no-undo.
      302   define input parameter p-db-remote  as logical      no-undo.
      303   define output parameter p-doc-code  as character    no-undo.
      304   do
      305   on error undo, return error
      306   :
      307       if p-db-remote = yes
      308       then do:
      309           assign
      310               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
      311                           + "-"
      312                           + trim( string( p-obj-code, ">>>>9" ) )
      313                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      314           .
      315       end.
      316       else do:
      317           assign
      318               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
      319           .
      320       end.
      321   end.
      322   end procedure.
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369     define variable v-cntxt-db-num        as integer   no-undo .
      370     define variable v-cntxt-userid        as character no-undo .
      371     define variable v-cntxt-level         as character no-undo .
      372     define variable v-cntxt-host-code-obj as integer   no-undo .
      373     define variable v-cntxt-obj-type      as character no-undo .
      374     define variable v-cntxt-obj-code      as integer   no-undo .
      375     define variable v-cntxt-db-num-obj    as integer   no-undo .
      376     define variable v-cntxt-is-admin      as logical   no-undo .
      377   define new shared variable br-handle as handle no-undo.
      378   define new shared buffer f-doc      for fbr-doc.
      379   define new shared query br-docs     for f-doc scrolling.
      380   define temp-table temp_kitchen-object no-undo
      381       field obj-type  as character
      382       field obj-code  as integer
      383   .
      384   define temp-table temp_fbr-doc no-undo
      385       field doc-code  as character
      386       field status_   as character
      387       field doc-date  as date
      388       field obj-type  as character
      389       field obj-code  as integer
      390       field PS        as character
      391   .
      392   DEFINE BUTTON b-exit AUTO-GO
      393        LABEL "В&ыход"
      394        SIZE 10 BY 1
      395        BGCOLOR 8 .
      396   DEFINE BUTTON b-help
      397        LABEL "Помо&щь"
      398        SIZE 10 BY 1
      399        BGCOLOR 8 .
      400   DEFINE BUTTON b-lkp
      401        LABEL "Просмотр"
      402        SIZE 10 BY 1.
      403   DEFINE QUERY br-table FOR
      404         temp_fbr-doc SCROLLING.
      405   DEFINE BROWSE br-table
      406     QUERY br-table NO-LOCK DISPLAY
      407         temp_fbr-doc.doc-code format "X(10)"  column-label "Номер"
      408   temp_fbr-doc.status_  format "X(4)"         column-label "Статус"
      409   temp_fbr-doc.doc-date format "99.99.99"     column-label "Дата"
      410   temp_fbr-doc.obj-type format "X(3)"         column-label "Тип"
      411   temp_fbr-doc.obj-code format "99999"        column-label "Код объекта"
      412   temp_fbr-doc.PS       format "X(40)"        column-label "Примечание"
      413       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 21 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      414   DEFINE FRAME Dialog-Frame
      415        b-exit AT ROW 1 COL 1
      416        b-lkp AT ROW 1 COL 11
      417        b-help AT ROW 1 COL 89.5
      418        br-table AT ROW 2.25 COL 1.5
      419        SPACE(0.37) SKIP(0.24)
      420       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      421            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      422            TITLE "Список документов производства"
      423            DEFAULT-BUTTON b-exit.
      424   ASSIGN
      425          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      426          FRAME Dialog-Frame:HIDDEN           = TRUE.
      427   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      428   DO:
      429     APPLY "END-ERROR":U TO SELF.
      430   END.
      431   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      432   DO:
      433   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   if lookup(self :type
      435            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      436            ) = 0
      437   then do:
      438     message
      439       "$Workfile$"
      440       "Указанному интерфейсному элементу фокус не может быть передан" skip
      441       "Интерфейсный элемент" self :name  skip
      442       "Тип" self :type  skip
      443       "Процедура" this-procedure :file-name skip
      444       view-as alert-box .
      445   end.
      446   else do:
      447     apply "entry":u to self  .
      448     if focus :handle <> self :handle  then do:
      449       return no-apply .
      450     end.
      451   end.
      452   END.
      453   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      454   DO:
      455   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   if lookup(self :type
      457            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      458            ) = 0
      459   then do:
      460     message
      461       "$Workfile$"
      462       "Указанному интерфейсному элементу фокус не может быть передан" skip
      463       "Интерфейсный элемент" self :name  skip
      464       "Тип" self :type  skip
      465       "Процедура" this-procedure :file-name skip
      466       view-as alert-box .
      467   end.
      468   else do:
      469     apply "entry":u to self  .
      470     if focus :handle <> self :handle  then do:
      471       return no-apply .
      472     end.
      473   end.
      474       define variable v-allow-lookup          as logical      no-undo.
      475       define variable v-fbr-doc-next-prev     as logical      no-undo.
      476       define variable v-fbr-doc-recid         as recid        no-undo.
      477       find first f-doc
      478            where f-doc.doc-code = temp_fbr-doc.doc-code
      479       no-error.
      480   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   do:
      482     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      483       (input  v-cntxt-db-num
      484       ,input  v-cntxt-userid
      485       ,input  0
      486       ,input  'actn_manufacturing_lookup':U
      487       ,input  'object':U
      488       ,input  f-doc.host-code
      489       ,input  f-doc.obj-type
      490       ,input  f-doc.obj-code
      491       ,input  0
      492       ,input  0
      493       ,input  0
      494       ,input  true
      495       ,output v-allow-lookup
      496       )  .
      497   end.
      498       if v-allow-lookup = no
      499       then do:
      500           undo, return no-apply.
      501       end.
      502       assign
      503           v-fbr-doc-next-prev = yes
      504           br-handle           = br-table :handle
      505       .
      506       do while v-fbr-doc-next-prev <> ?
      507       :
      508           if not available f-doc
      509           then do:
      510               message
      511                   "Неправильный выбор документа."
      512               view-as alert-box error.
      513               return no-apply.
      514           end.
      515           run str/fbr-doc.w (
      516               input parparentproc
      517             , input this-procedure
      518             , input 'ПРОСМОТР':U
      519             , input recid( f-doc )
      520             , output v-fbr-doc-recid
      521             , input-output v-fbr-doc-next-prev
      522           ).
      523       end.
      524       if br-handle = ?
      525       then do:
      526           find first f-doc no-lock
      527                where recid( f-doc ) = v-fbr-doc-recid
      528           no-error.
      529           find first temp_fbr-doc
      530                where temp_fbr-doc.doc-code = f-doc.doc-code
      531           no-error.
      532           reposition br-table to recid recid( temp_fbr-doc ) no-error.
      533       end.
      534       apply "entry" to br-table in frame Dialog-Frame.
      535   END.
      536   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   on help of frame Dialog-Frame
      538   do:
      539     run gbl/app_help.p
      540       (input this-procedure :file-name
      541       ,input ''
      542       ,input ?
      543       ) no-error.
      544     if error-status :error then do:
      545       message
      546         "Ошибка при вызове помощи"
      547         error-status :get-message(1)
      548         view-as alert-box .
      549     end.
      550   end.
      551   run minbtn-set in this-procedure .
      552   on choose of b-help in frame Dialog-Frame
      553   do:
      554     apply "help":u to frame Dialog-Frame .
      555   end.
      556   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure minbtn-set :
      558       do
      559           on error undo, return error return-value
      560           :
      561           define variable ii              as integer       no-undo .
      562           define variable fh              as widget-handle no-undo .
      563           define variable hh              as widget-handle no-undo .
      564           define variable v-h             as handle        extent 4 no-undo .
      565           define variable v-name-button   as character     no-undo .
      566           define variable v-help-old-x    as decimal       no-undo .
      567           define variable v-help-old-y    as decimal       no-undo .
      568           define variable v-help-old-size as decimal       no-undo .
      569           define variable v-frame-width   as decimal       no-undo .
      570           define variable jj              as integer       no-undo .
      571           do
      572               on error undo, return error
      573               :
      574               assign
      575                   v-frame-width = frame Dialog-Frame:width - 0.3
      576                   fh            = frame Dialog-Frame:first-child
      577                   hh            = fh:first-child
      578                   ii            = 1
      579                   .
      580               do while valid-handle(hh):
      581                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      582                   do:
      583                       case lc(hh:name) :
      584                           when "b-help" then
      585                               do:
      586                                   hh:load-image-up("cmp/b-help.bmp":u) .
      587                                   hh:load-image-down("cmp/b-help.bmp":u) .
      588                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      589                                   hh:TOOLTIP = "Помощь" .
      590                                   v-help-old-x = hh:column .
      591                                   v-help-old-y = hh:row    .
      592                                   v-help-old-size = hh:width .
      593                                   hh:width-chars = 2.5 .
      594                               end.
      595                           when "b-print" then
      596                               do:
      597                                   hh:load-image("cmp/b-print.bmp":u) .
      598                                   hh:TOOLTIP = "Печать" .
      599                                   v-h[ii] = hh:handle .
      600                                   ii = ii + 1 .
      601                                   hh:width-chars = 3 .
      602                               end.
      603                           when "b-history" or
      604                           when "b-hist" then
      605                               do:
      606                                   hh:load-image("cmp/b-hist.bmp":u) .
      607                                   hh:TOOLTIP = "История" .
      608                                   v-h[ii] = hh:handle .
      609                                   ii = ii + 1 .
      610                                   hh:width-chars = 3 .
      611                               end.
      612                           when "b-sch" then
      613                               do:
      614                                   hh:load-image("cmp/b-sch.bmp":u) .
      615                                   hh:TOOLTIP = "Установка Фильтра" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-hist-user" then
      621                               do:
      622                                   hh:load-image("cmp/b-hist.bmp":u) .
      623                                   hh:TOOLTIP = "История пользователя" .
      624                                   ii = ii + 1 .
      625                               end.
      626                       end case.
      627                   end.
      628                   hh = hh:next-sibling.
      629               end.
      630               b-help:column = v-frame-width - b-help:width-chars.
      631               jj = 0.
      632               repeat ii = 4 to 1 by -1 :
      633                   if valid-handle (v-h[ii] ) then
      634                   do:
      635                       jj  = jj + 1 .
      636                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      637                       v-h[ii]:row    = v-help-old-y .
      638                   end.
      639               end.
      640           end.
      641       end.
      642   end procedure.
      643   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      644   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      645   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      646   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      647   define variable v-diasize-current-frame-width  as decimal   no-undo .
      648   define variable v-diasize-current-frame-height as decimal   no-undo .
      649   define variable v-diasize-change-size          as logical   no-undo .
      650   define variable v-diasize-resize-button        as handle    no-undo .
      651   define variable v-diasize-wndmax               as logical   no-undo .
      652   define variable v-diasize-wndstore             as logical   no-undo .
      653   define variable v-diasize-proc-name            as character no-undo .
      654   define variable v-diasize-browse-handle        as handle    no-undo .
      655   define variable v-diasize-browse-number        as integer   no-undo .
      656   define variable v-diasize-need-full-display    as logical   no-undo init false .
      657   define temp-table temp-diasize-handle no-undo
      658     field handle-value  as handle
      659     field save-position as decimal
      660     index xpk is primary unique handle-value
      661     .
      662   define temp-table temp-browse-handle no-undo
      663     field browse-type   as character
      664     field browse-number as integer
      665     field browse-handle as handle
      666     field original-size as decimal
      667     index xpk is primary unique browse-type browse-number
      668     index xie browse-type browse-handle
      669   .
      670   procedure diasize_change-height :
      671     define input  parameter p-change-value  as decimal   no-undo .
      672     define input  parameter p-move-resize   as logical   no-undo .
      673     define variable v-field-group-handle    as handle    no-undo .
      674     define variable v-object-handle         as handle    no-undo .
      675     define variable v-frame-height          as decimal   no-undo .
      676     define variable v-frame-virtual-height  as decimal   no-undo .
      677     define variable v-browse-height         as decimal   no-undo .
      678     define variable v-window-height         as decimal   no-undo .
      679     define variable v-window-virtual-height as decimal   no-undo .
      680     define variable v-change-sign           as integer   no-undo .
      681     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      682     define buffer buf_temp-browse-handle  for temp-browse-handle .
      683     if p-change-value > 0
      684     then do:
      685       if frame Dialog-Frame :height + p-change-value
      686           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      687       then do:
      688         assign
      689           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      690                           - (frame Dialog-Frame :height-chars)
      691         .
      692         if p-change-value <= 0
      693         then do:
      694           run diasize_position-resize-button in this-procedure .
      695           return .
      696         end.
      697       end.
      698     end.
      699     if p-change-value < 0
      700     then do:
      701       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      702       then do:
      703         assign
      704           p-change-value = v-diasize-orig-frame-height
      705                          - (frame Dialog-Frame :height-chars)
      706         .
      707         if p-change-value >= 0
      708         then do:
      709           run diasize_position-resize-button in this-procedure .
      710           return .
      711         end.
      712       end.
      713     end.
      714     if p-change-value >= 0
      715     then do:
      716       assign
      717         v-change-sign = 1
      718       .
      719     end.
      720     else do:
      721       assign
      722         v-change-sign = -1
      723       .
      724     end.
      725     assign
      726       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      727     .
      728     if p-change-value = 0
      729     then do:
      730       run diasize_position-resize-button in this-procedure .
      731       return .
      732     end.
      733     move_block:
      734     do
      735     on error undo move_block, retry move_block
      736     :
      737       if retry
      738       then do:
      739         do
      740         on error undo move_block, leave move_block
      741         :
      742           if p-change-value > 0
      743           then do:
      744             for each buf_temp-diasize-handle
      745             on error undo, next
      746             :
      747               assign
      748                 v-object-handle = buf_temp-diasize-handle.handle-value
      749               .
      750               if v-object-handle <> v-diasize-resize-button
      751               then do:
      752                 assign
      753                   v-object-handle :row = buf_temp-diasize-handle.save-position
      754                 .
      755               end.
      756             end.
      757             assign
      758               v-diasize-browse-handle :height = v-browse-height
      759             .
      760             for each buf_temp-browse-handle
      761               where buf_temp-browse-handle.browse-type = 'height':u
      762             on error undo, next
      763             :
      764               assign
      765                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      766               .
      767             end.
      768             assign
      769               frame Dialog-Frame :height = v-frame-height
      770             .
      771             if frame Dialog-Frame :scrollable = true
      772             then do:
      773               assign
      774                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      775               .
      776             end.
      777             run diasize_position-resize-button in this-procedure .
      778           end.
      779           else do:
      780             if frame Dialog-Frame :scrollable = true
      781             then do:
      782               assign
      783                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      784               .
      785             end.
      786             assign
      787               frame Dialog-Frame :height = v-frame-height
      788             .
      789             assign
      790               v-diasize-browse-handle :height = v-browse-height
      791             .
      792             for each buf_temp-browse-handle
      793               where buf_temp-browse-handle.browse-type = 'height':u
      794             on error undo, next
      795             :
      796               assign
      797                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      798               .
      799             end.
      800             for each buf_temp-diasize-handle
      801             on error undo, next
      802             :
      803               assign
      804                 v-object-handle = buf_temp-diasize-handle.handle-value
      805               .
      806               if v-object-handle <> v-diasize-resize-button
      807               then do:
      808                 assign
      809                   v-object-handle :row = buf_temp-diasize-handle.save-position
      810                 .
      811               end.
      812             end.
      813             run diasize_position-resize-button in this-procedure .
      814           end.
      815           assign
      816             v-diasize-change-size = false
      817           .
      818           leave move_block .
      819         end.
      820       end.
      821       assign
      822         v-diasize-need-full-display = true
      823       .
      824       if v-diasize-change-size = false
      825       then do:
      826         assign
      827           v-diasize-change-size = true
      828         .
      829       end.
      830       else do:
      831         return .
      832       end.
      833       assign
      834         v-frame-height = frame Dialog-Frame :height
      835         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      836         v-browse-height = v-diasize-browse-handle :height
      837       .
      838       for each buf_temp-browse-handle
      839         where buf_temp-browse-handle.browse-type = 'height':u
      840       :
      841         assign
      842           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      843         .
      844       end.
      845       for each buf_temp-diasize-handle
      846       :
      847         delete buf_temp-diasize-handle .
      848       end.
      849       assign
      850         v-field-group-handle = frame Dialog-Frame :first-child
      851       .
      852       do while valid-handle(v-field-group-handle)
      853       :
      854         assign
      855           v-object-handle = v-field-group-handle :first-child
      856         .
      857         do while valid-handle(v-object-handle)
      858         :
      859           if  v-object-handle <> v-diasize-browse-handle :handle
      860           and can-query(v-object-handle, "row")
      861           and can-query(v-object-handle, "height")
      862           and ( v-object-handle :row > v-diasize-browse-handle :row )
      863           then do:
      864             find first buf_temp-browse-handle
      865               where buf_temp-browse-handle.browse-type   = 'height':u
      866                 and buf_temp-browse-handle.browse-handle = v-object-handle
      867               no-error .
      868             if available buf_temp-browse-handle
      869             then do:
      870             end.
      871             else do:
      872               create buf_temp-diasize-handle .
      873               assign
      874                 buf_temp-diasize-handle.handle-value  = v-object-handle
      875                 buf_temp-diasize-handle.save-position = v-object-handle :row
      876               .
      877             end.
      878           end.
      879           assign
      880             v-object-handle = v-object-handle :next-sibling
      881           .
      882         end.
      883         assign
      884           v-field-group-handle = v-field-group-handle :next-sibling
      885         .
      886       end.
      887       do with frame Dialog-Frame
      888       :
      889         hide v-diasize-resize-button .
      890         assign
      891           v-diasize-resize-button :row    = 1
      892           v-diasize-resize-button :column = 1
      893         .
      894       end.
      895       if p-change-value > 0
      896       then do:
      897         if frame Dialog-Frame :scrollable = true
      898         then do:
      899           assign
      900             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      901             no-error .
      902           if error-status :error
      903           or error-status :get-message(1) <> ""
      904           then do:
      905             undo move_block, retry move_block .
      906           end.
      907         end.
      908         assign
      909           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      910           no-error .
      911         if error-status :error
      912         or error-status :get-message(1) <> ""
      913         then do:
      914           undo move_block, retry move_block .
      915         end.
      916         assign
      917           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      918           no-error .
      919         if error-status :error
      920         or error-status :get-message(1) <> ""
      921         then do:
      922           undo move_block, retry move_block .
      923         end.
      924         for each buf_temp-browse-handle
      925           where buf_temp-browse-handle.browse-type = 'height':u
      926         on error undo move_block, retry move_block
      927         :
      928           assign
      929             buf_temp-browse-handle.browse-handle :height
      930               = buf_temp-browse-handle.browse-handle :height + p-change-value
      931             no-error .
      932           if error-status :error
      933           or error-status :get-message(1) <> ""
      934           then do:
      935             undo move_block, retry move_block .
      936           end.
      937         end.
      938         for each buf_temp-diasize-handle
      939         on error undo move_block, retry move_block
      940         :
      941           assign
      942             v-object-handle = buf_temp-diasize-handle.handle-value
      943           .
      944           if v-object-handle <> v-diasize-resize-button
      945           then do:
      946             assign
      947               v-object-handle :row = v-object-handle :row + p-change-value
      948               no-error .
      949             if error-status :error
      950             or error-status :get-message(1) <> ""
      951             then do:
      952               undo move_block, retry move_block .
      953             end.
      954           end.
      955         end.
      956       end.
      957       else do:
      958         for each buf_temp-diasize-handle
      959         on error undo move_block, retry move_block
      960         :
      961           assign
      962             v-object-handle = buf_temp-diasize-handle.handle-value
      963           .
      964           if v-object-handle <> v-diasize-resize-button
      965           then do:
      966             assign
      967               v-object-handle :row = v-object-handle :row + p-change-value
      968               no-error .
      969             if error-status :error
      970             or error-status :get-message(1) <> ""
      971             then do:
      972               undo move_block, retry move_block .
      973             end.
      974           end.
      975         end.
      976         assign
      977           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      978           no-error .
      979         if error-status :error
      980         or error-status :get-message(1) <> ""
      981         then do:
      982           undo move_block, retry move_block .
      983         end.
      984         for each buf_temp-browse-handle
      985           where buf_temp-browse-handle.browse-type = 'height':u
      986         on error undo move_block, retry move_block
      987         :
      988           assign
      989             buf_temp-browse-handle.browse-handle :height
      990               = buf_temp-browse-handle.browse-handle :height + p-change-value
      991             no-error .
      992           if error-status :error
      993           or error-status :get-message(1) <> ""
      994           then do:
      995             undo move_block, retry move_block .
      996           end.
      997         end.
      998         assign
      999           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1000           no-error .
     1001         if error-status :error
     1002         or error-status :get-message(1) <> ""
     1003         then do:
     1004           undo move_block, retry move_block .
     1005         end.
     1006         if frame Dialog-Frame :scrollable = true
     1007         then do:
     1008           assign
     1009             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1010             no-error .
     1011           if error-status :error
     1012           or error-status :get-message(1) <> ""
     1013           then do:
     1014             undo move_block, retry move_block .
     1015           end.
     1016         end.
     1017       end.
     1018       if p-move-resize = true
     1019       then do:
     1020         run diasize_position-resize-button in this-procedure .
     1021       end.
     1022       if v-diasize-wndstore = true
     1023       then do:
     1024         if connected("ub") = true
     1025         then do:
     1026           define variable v-cntxt-db-num        as integer   no-undo .
     1027           define variable v-cntxt-userid        as character no-undo .
     1028           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1029                                             , OUTPUT v-cntxt-userid
     1030                                             ) .
     1031           run gbl/wndsizew.p
     1032             (input  v-cntxt-db-num
     1033             ,input  v-cntxt-userid
     1034             ,input  v-diasize-proc-name
     1035             ,input  'height':u
     1036             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1037             ) .
     1038         end.
     1039       end.
     1040     end.
     1041     assign
     1042       v-diasize-change-size = false
     1043     .
     1044   end procedure.
     1045   procedure diasize_set-height :
     1046     define input  parameter p-new-height  as decimal   no-undo .
     1047     define input  parameter p-move-resize as logical   no-undo .
     1048     do
     1049     on error undo, return error return-value
     1050     :
     1051       run diasize_change-height in this-procedure
     1052         (input  (p-new-height - frame Dialog-Frame :height)
     1053         ,input  p-move-resize
     1054         ) .
     1055     end.
     1056   end procedure.
     1057   procedure diasize_change-width :
     1058     define input  parameter p-change-value as decimal   no-undo .
     1059     define input  parameter p-move-resize  as logical   no-undo .
     1060     define variable v-field-group-handle   as handle    no-undo .
     1061     define variable v-object-handle        as handle    no-undo .
     1062     define variable v-frame-width          as decimal   no-undo .
     1063     define variable v-frame-virtual-width  as decimal   no-undo .
     1064     define variable v-browse-width         as decimal   no-undo .
     1065     define variable v-window-width         as decimal   no-undo .
     1066     define variable v-window-virtual-width as decimal   no-undo .
     1067     define variable v-change-sign          as integer   no-undo .
     1068     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1069     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1070     if p-change-value > 0
     1071     then do:
     1072       if frame Dialog-Frame :width + p-change-value >
     1073           session :width-chars
     1074       then do:
     1075         assign
     1076           p-change-value = session :width-chars - frame Dialog-Frame :width
     1077         .
     1078         if p-change-value <= 0
     1079         then do:
     1080           run diasize_position-resize-button in this-procedure .
     1081           return .
     1082         end.
     1083       end.
     1084     end.
     1085     if p-change-value < 0
     1086     then do:
     1087       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1088       then do:
     1089         assign
     1090           p-change-value = v-diasize-orig-frame-width
     1091                          - frame Dialog-Frame :width
     1092         .
     1093         if p-change-value >= 0
     1094         then do:
     1095           run diasize_position-resize-button in this-procedure .
     1096           return .
     1097         end.
     1098       end.
     1099     end.
     1100     if p-change-value >= 0
     1101     then do:
     1102       assign
     1103         v-change-sign = 1
     1104       .
     1105     end.
     1106     else do:
     1107       assign
     1108         v-change-sign = -1
     1109       .
     1110     end.
     1111     assign
     1112       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1113     .
     1114     if p-change-value = 0
     1115     then do:
     1116       run diasize_position-resize-button in this-procedure .
     1117       return .
     1118     end.
     1119     move_block:
     1120     do
     1121     on error undo move_block, leave move_block
     1122     :
     1123       if retry
     1124       then do:
     1125         do
     1126         on error undo move_block, leave move_block
     1127         :
     1128           if p-change-value > 0
     1129           then do:
     1130             for each buf_temp-diasize-handle
     1131             on error undo, next
     1132             :
     1133               assign
     1134                 v-object-handle = buf_temp-diasize-handle.handle-value
     1135               .
     1136               if v-object-handle <> v-diasize-resize-button
     1137               then do:
     1138                 assign
     1139                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1140                 .
     1141               end.
     1142             end.
     1143             assign
     1144               v-diasize-browse-handle :width = v-browse-width
     1145             .
     1146             for each buf_temp-browse-handle
     1147               where buf_temp-browse-handle.browse-type = 'width':u
     1148             on error undo, next
     1149             :
     1150               assign
     1151                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1152               .
     1153             end.
     1154             assign
     1155               frame Dialog-Frame :width = v-frame-width
     1156             .
     1157             if frame Dialog-Frame :scrollable = true
     1158             then do:
     1159               assign
     1160                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1161               .
     1162             end.
     1163             run diasize_position-resize-button in this-procedure .
     1164           end.
     1165           else do:
     1166             if frame Dialog-Frame :scrollable = true
     1167             then do:
     1168               assign
     1169                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1170               .
     1171             end.
     1172             assign
     1173               frame Dialog-Frame :width = v-frame-width
     1174             .
     1175             for each buf_temp-browse-handle
     1176               where buf_temp-browse-handle.browse-type = 'width':u
     1177             on error undo, next
     1178             :
     1179               assign
     1180                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1181               .
     1182             end.
     1183             assign
     1184               v-diasize-browse-handle :width = v-browse-width
     1185             .
     1186             for each buf_temp-diasize-handle
     1187             on error undo, next
     1188             :
     1189               assign
     1190                 v-object-handle = buf_temp-diasize-handle.handle-value
     1191               .
     1192               if v-object-handle <> v-diasize-resize-button
     1193               then do:
     1194                 assign
     1195                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1196                 .
     1197               end.
     1198             end.
     1199             run diasize_position-resize-button in this-procedure .
     1200           end.
     1201           assign
     1202             v-diasize-change-size = false
     1203           .
     1204           leave move_block .
     1205         end.
     1206       end.
     1207       assign
     1208         v-diasize-need-full-display = true
     1209       .
     1210       if v-diasize-change-size = false
     1211       then do:
     1212         assign
     1213           v-diasize-change-size = true
     1214         .
     1215       end.
     1216       else do:
     1217         return .
     1218       end.
     1219       assign
     1220         v-frame-width = frame Dialog-Frame :width
     1221         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1222         v-browse-width = v-diasize-browse-handle :width
     1223       .
     1224       for each buf_temp-browse-handle
     1225         where buf_temp-browse-handle.browse-type = 'width':u
     1226       :
     1227         assign
     1228           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1229         .
     1230       end.
     1231       for each buf_temp-diasize-handle
     1232       :
     1233         delete buf_temp-diasize-handle .
     1234       end.
     1235       assign
     1236         v-field-group-handle = frame Dialog-Frame :first-child
     1237       .
     1238       do while valid-handle(v-field-group-handle)
     1239       :
     1240         assign
     1241           v-object-handle = v-field-group-handle :first-child
     1242         .
     1243         do while valid-handle(v-object-handle)
     1244         :
     1245           if  v-object-handle <> v-diasize-browse-handle :handle
     1246           and v-object-handle <> v-diasize-resize-button
     1247           and can-query(v-object-handle, "row")
     1248           and can-query(v-object-handle, "height")
     1249           and ( v-object-handle :col + v-object-handle :width
     1250                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1251               )
     1252           then do:
     1253             find first buf_temp-browse-handle
     1254               where buf_temp-browse-handle.browse-type   = 'width':u
     1255                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1256               no-error .
     1257             if available buf_temp-browse-handle
     1258             then do:
     1259             end.
     1260             else do:
     1261               create buf_temp-diasize-handle .
     1262               assign
     1263                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1264                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1265               .
     1266             end.
     1267           end.
     1268           assign
     1269             v-object-handle = v-object-handle :next-sibling
     1270           .
     1271         end.
     1272         assign
     1273           v-field-group-handle = v-field-group-handle :next-sibling
     1274         .
     1275       end.
     1276       do with frame Dialog-Frame
     1277       :
     1278         hide v-diasize-resize-button .
     1279         v-diasize-resize-button :row = 1.
     1280         v-diasize-resize-button :column = 1.
     1281       end.
     1282       if p-change-value > 0
     1283       then do:
     1284         if frame Dialog-Frame :scrollable = true
     1285         then do:
     1286           assign
     1287             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1288             no-error .
     1289           if error-status :error
     1290           or error-status :get-message(1) <> ""
     1291           then do:
     1292             undo move_block, retry move_block.
     1293           end.
     1294         end.
     1295         assign
     1296           frame Dialog-Frame :width = v-frame-width + p-change-value
     1297           no-error .
     1298         if error-status :error
     1299         or error-status :get-message(1) <> ""
     1300         then do:
     1301           undo move_block, retry move_block.
     1302         end.
     1303         assign
     1304           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1305         no-error .
     1306         if error-status :error
     1307         or error-status :get-message(1) <> ""
     1308         then do:
     1309           undo move_block, retry move_block.
     1310         end.
     1311         for each buf_temp-browse-handle
     1312           where buf_temp-browse-handle.browse-type = 'width':u
     1313         on error undo move_block, retry move_block
     1314         :
     1315           assign
     1316             buf_temp-browse-handle.browse-handle :width
     1317               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1318             no-error .
     1319           if error-status :error
     1320           or error-status :get-message(1) <> ""
     1321           then do:
     1322             undo move_block, retry move_block .
     1323           end.
     1324         end.
     1325         for each buf_temp-diasize-handle
     1326         on error undo move_block, retry move_block
     1327         :
     1328           assign
     1329             v-object-handle = buf_temp-diasize-handle.handle-value
     1330           .
     1331           if v-object-handle <> v-diasize-resize-button
     1332           then do:
     1333             assign
     1334               v-object-handle :col = v-object-handle :col + p-change-value
     1335               no-error .
     1336             if error-status :error
     1337             or error-status :get-message(1) <> ""
     1338             then do:
     1339               undo move_block, retry move_block .
     1340             end.
     1341           end.
     1342         end.
     1343       end.
     1344       else do:
     1345         for each buf_temp-diasize-handle
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             v-object-handle = buf_temp-diasize-handle.handle-value
     1350           .
     1351           if v-object-handle <> v-diasize-resize-button
     1352           then do:
     1353             assign
     1354               v-object-handle :col = v-object-handle :col + p-change-value
     1355               no-error .
     1356             if error-status :error
     1357             or error-status :get-message(1) <> ""
     1358             then do:
     1359               undo move_block, retry move_block .
     1360             end.
     1361           end.
     1362         end.
     1363         for each buf_temp-browse-handle
     1364           where buf_temp-browse-handle.browse-type = 'width':u
     1365         on error undo move_block, retry move_block
     1366         :
     1367           assign
     1368             buf_temp-browse-handle.browse-handle :width
     1369               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1370             no-error .
     1371           if error-status :error
     1372           or error-status :get-message(1) <> ""
     1373           then do:
     1374             undo move_block, retry move_block .
     1375           end.
     1376         end.
     1377         assign
     1378           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1379           no-error .
     1380         if error-status :error
     1381         or error-status :get-message(1) <> ""
     1382         then do:
     1383           undo move_block, retry move_block.
     1384         end.
     1385         assign
     1386           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1387         no-error .
     1388         if error-status :error
     1389         or error-status :get-message(1) <> ""
     1390         then do:
     1391           undo move_block, retry move_block.
     1392         end.
     1393         if frame Dialog-Frame :scrollable = true
     1394         then do:
     1395           assign
     1396             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1397           no-error .
     1398           if error-status :error
     1399           or error-status :get-message(1) <> ""
     1400           then do:
     1401             undo move_block, retry move_block.
     1402           end.
     1403         end.
     1404       end.
     1405       if p-move-resize
     1406       then do:
     1407         run diasize_position-resize-button in this-procedure .
     1408       end.
     1409       if v-diasize-wndstore = true
     1410       then do:
     1411         if connected("ub") = true
     1412         then do:
     1413           define variable v-cntxt-db-num        as integer   no-undo .
     1414           define variable v-cntxt-userid        as character no-undo .
     1415           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1416                                             , OUTPUT v-cntxt-userid
     1417                                             ) .
     1418           run gbl/wndsizew.p
     1419             (input  v-cntxt-db-num
     1420             ,input  v-cntxt-userid
     1421             ,input  v-diasize-proc-name
     1422             ,input  'width':u
     1423             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1424             ) .
     1425         end.
     1426       end.
     1427     end.
     1428     assign
     1429       v-diasize-change-size = false
     1430     .
     1431   end procedure.
     1432   procedure diasize_set-width :
     1433     define input  parameter p-new-width  as decimal   no-undo .
     1434     define input  parameter p-move-resize as logical   no-undo .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       run diasize_change-width in this-procedure
     1439         (input  (p-new-width - frame Dialog-Frame :width)
     1440         ,input  p-move-resize
     1441         ) .
     1442     end.
     1443   end procedure.
     1444   procedure diasize_position-resize-button :
     1445     do with frame Dialog-Frame
     1446     :
     1447       hide v-diasize-resize-button .
     1448       assign
     1449         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1450                     - 1
     1451                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1452         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1453                     - 1
     1454                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1455       .
     1456       view v-diasize-resize-button .
     1457     end.
     1458   end procedure.
     1459   on alt-right anywhere
     1460   do:
     1461     run diasize_change-width in this-procedure
     1462       (input 1
     1463       ,input true
     1464       ) .
     1465     return no-apply .
     1466   end.
     1467   on alt-left anywhere
     1468   do:
     1469     run diasize_change-width in this-procedure
     1470       (input -1
     1471       ,input true
     1472       ) .
     1473     return no-apply .
     1474   end.
     1475   on alt-down anywhere
     1476   do:
     1477     run diasize_change-height in this-procedure
     1478       (input 1
     1479       ,input true
     1480       ) .
     1481     return no-apply .
     1482   end.
     1483   on alt-up anywhere
     1484   do:
     1485     run diasize_change-height in this-procedure
     1486       (input -1
     1487       ,input true
     1488       ) .
     1489     return no-apply .
     1490   end.
     1491   on alt-enter of frame Dialog-Frame
     1492   do:
     1493     run diasize_maximize in this-procedure
     1494       (input  ?
     1495       ).
     1496     return no-apply .
     1497   end.
     1498   procedure diasize_end-move :
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502       define variable v-row-delta as decimal   no-undo .
     1503       define variable v-col-delta as decimal   no-undo .
     1504       define variable v-new-row as decimal   no-undo .
     1505       define variable v-new-col as decimal   no-undo .
     1506       assign
     1507         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1508         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1509       .
     1510       assign
     1511         v-row-delta = v-new-row - frame Dialog-Frame :height
     1512         v-col-delta = v-new-col - frame Dialog-Frame :width
     1513       .
     1514       run diasize_change-height in this-procedure
     1515         (input v-row-delta
     1516         ,input true
     1517         ) .
     1518       run diasize_change-width in this-procedure
     1519         (input v-col-delta
     1520         ,input true
     1521         ) .
     1522     end.
     1523   end procedure.
     1524   procedure diasize_maximize :
     1525     define input  parameter p-action as logical   no-undo .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       if p-action = ?
     1530       then do:
     1531         if v-diasize-need-maximize = true
     1532         then do:
     1533           assign
     1534             p-action = true
     1535           .
     1536         end.
     1537         else do:
     1538           assign
     1539             p-action = false
     1540           .
     1541         end.
     1542       end.
     1543       if p-action = true
     1544       then do:
     1545         run diasize_change-height in this-procedure
     1546           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1547               - frame Dialog-Frame :height-chars
     1548           ,input true
     1549           ) .
     1550         run diasize_change-width in this-procedure
     1551           (input session :width-chars
     1552               - frame Dialog-Frame :width-chars
     1553           ,input true
     1554           ) .
     1555         assign
     1556           v-diasize-need-maximize = false
     1557         .
     1558       end.
     1559       else do:
     1560         run diasize_change-width in this-procedure
     1561           (input v-diasize-orig-frame-width
     1562               - frame Dialog-Frame :width-chars
     1563           ,input true
     1564           ) .
     1565         run diasize_change-height in this-procedure
     1566           (input v-diasize-orig-frame-height
     1567               - frame Dialog-Frame :height-chars
     1568           ,input true
     1569           ) .
     1570         assign
     1571           v-diasize-need-maximize = true
     1572         .
     1573       end.
     1574     end.
     1575   end procedure.
     1576   procedure diasize_restore-orig-size :
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       assign
     1581         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1582         v-diasize-current-frame-height = frame Dialog-Frame :height
     1583       .
     1584       run diasize_set-height in this-procedure
     1585         (input  v-diasize-orig-frame-height
     1586         ,input  true
     1587         ) .
     1588       run diasize_set-width in this-procedure
     1589         (input  v-diasize-orig-frame-width
     1590         ,input  true
     1591         ) .
     1592     end.
     1593   end procedure.
     1594   procedure diasize_restore-current-size :
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       run diasize_set-height in this-procedure
     1599         (input  v-diasize-current-frame-height
     1600         ,input  true
     1601         ) .
     1602       run diasize_set-width in this-procedure
     1603         (input  v-diasize-current-frame-width
     1604         ,input  true
     1605         ) .
     1606     end.
     1607   end procedure.
     1608   procedure diasize_set-browse-handle :
     1609     define input  parameter p-browse-handle as handle   no-undo .
     1610     define buffer buf_temp-browse-handle for temp-browse-handle .
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614       assign
     1615         v-diasize-browse-handle = p-browse-handle
     1616       .
     1617       for each buf_temp-browse-handle
     1618       on error undo, return error return-value
     1619       :
     1620         delete buf_temp-browse-handle .
     1621       end.
     1622     end.
     1623   end procedure.
     1624   procedure diasize_add_browse :
     1625     define input  parameter p-browse-type   as character no-undo .
     1626     define input  parameter p-browse-handle as handle    no-undo .
     1627     define buffer buf_temp-browse-handle for temp-browse-handle .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       assign
     1632         v-diasize-browse-number = v-diasize-browse-number + 1
     1633       .
     1634       create buf_temp-browse-handle .
     1635       assign
     1636         buf_temp-browse-handle.browse-type   = p-browse-type
     1637         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1638         buf_temp-browse-handle.browse-handle = p-browse-handle
     1639       .
     1640     end.
     1641   end procedure.
     1642   procedure diasize_init :
     1643     define variable v-default-value    as logical   no-undo .
     1644     define variable v-restore-saved    as logical   no-undo .
     1645     define variable v-resize-value-str as character no-undo .
     1646     do
     1647     on error undo, return error return-value
     1648     :
     1649       do with frame Dialog-Frame
     1650       :
     1651         assign
     1652           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1653           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1654           v-diasize-browse-handle     = browse br-table :handle
     1655         .
     1656         create button v-diasize-resize-button
     1657         assign
     1658           parent        = frame Dialog-Frame :first-child
     1659           label         = "s"
     1660           height-pixels = 16
     1661           width-pixels  = 16
     1662           visible       = true
     1663           sensitive     = true
     1664           movable       = true
     1665           triggers:
     1666             on end-move persistent run diasize_end-move in this-procedure .
     1667           end triggers.
     1668         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1669         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1670         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1671         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1672         assign
     1673           v-diasize-wndmax = false
     1674         .
     1675         if connected("ub") = true
     1676         then do:
     1677           define variable v-cntxt-db-num        as integer   no-undo .
     1678           define variable v-cntxt-userid        as character no-undo .
     1679           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1680                                             , OUTPUT v-cntxt-userid
     1681                                             ) .
     1682           run gbl/wndpar_r.p
     1683             (input  v-cntxt-db-num
     1684             ,input  v-cntxt-userid
     1685             ,input  'wndmax':U
     1686             ,output v-diasize-wndmax
     1687             ,output v-default-value
     1688             ) .
     1689         end.
     1690         assign
     1691           v-diasize-wndstore = false
     1692         .
     1693         if connected("ub") = true
     1694         then do:
     1695           run gbl/wndpar_r.p
     1696             (input  v-cntxt-db-num
     1697             ,input  v-cntxt-userid
     1698             ,input  'wndstore':U
     1699             ,output v-diasize-wndstore
     1700             ,output v-default-value
     1701             ) .
     1702         end.
     1703         assign
     1704           v-diasize-proc-name = entry(1, program-name(2), '.')
     1705         .
     1706         if v-diasize-wndstore = true
     1707         then do:
     1708           assign
     1709             v-restore-saved = false
     1710           .
     1711           if connected("ub") = true
     1712           then do:
     1713             run gbl/wndsizer.p
     1714               (input  v-cntxt-db-num
     1715               ,input  v-cntxt-userid
     1716               ,input  v-diasize-proc-name
     1717               ,input  'height':u
     1718               ,output v-resize-value-str
     1719               ) .
     1720             if v-resize-value-str <> '':U
     1721             then do:
     1722               run diasize_change-height in this-procedure
     1723                 (input  integer(v-resize-value-str)
     1724                 ,input  true
     1725                 ) .
     1726               assign
     1727                 v-restore-saved = true
     1728               .
     1729             end.
     1730           end.
     1731           if connected("ub") = true
     1732           then do:
     1733             run gbl/wndsizer.p
     1734               (input  v-cntxt-db-num
     1735               ,input  v-cntxt-userid
     1736               ,input  v-diasize-proc-name
     1737               ,input  'width':u
     1738               ,output v-resize-value-str
     1739               ) .
     1740             if v-resize-value-str <> '':U
     1741             then do:
     1742               run diasize_change-width in this-procedure
     1743                 (input  integer(v-resize-value-str)
     1744                 ,input  true
     1745                 ) .
     1746               assign
     1747                 v-restore-saved = true
     1748               .
     1749             end.
     1750           end.
     1751           if v-restore-saved <> true
     1752           then do:
     1753             if v-diasize-wndmax = true
     1754             then do:
     1755               run diasize_maximize in this-procedure
     1756                 (input  true
     1757                 ) .
     1758             end.
     1759           end.
     1760         end.
     1761         else do:
     1762           if v-diasize-wndmax = true
     1763           then do:
     1764             run diasize_maximize in this-procedure
     1765               (input  true
     1766               ) .
     1767           end.
     1768         end.
     1769       end.
     1770     end.
     1771   end procedure.
     1772   procedure diasize_need-full-display :
     1773     define output parameter p-need-full-display as logical   no-undo .
     1774     do
     1775     on error undo, return error return-value
     1776     :
     1777       assign
     1778         p-need-full-display = v-diasize-need-full-display
     1779       .
     1780       assign
     1781         v-diasize-need-full-display = false
     1782       .
     1783     end.
     1784   end procedure.
     1785   procedure get-context :
     1786      define output parameter p-db-num as integer          no-undo.
     1787      define output parameter p-user-id as character        no-undo.
     1788      define variable v-login               as character    no-undo.
     1789      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1790      define buffer buf_user-login  for ub.user-login .
     1791      do
     1792      on error undo, return error
     1793      :
     1794            FIND FIRST buf_sys-ctrl no-lock.
     1795            ASSIGN
     1796               v-login = USERID("ub")
     1797               p-db-num = buf_sys-ctrl.db-num
     1798            .
     1799            FIND FIRST buf_user-login
     1800                 WHERE buf_user-login.db-num = p-db-num
     1801                   AND buf_user-login.user-login = v-login
     1802                 no-lock
     1803                 no-error
     1804                 .
     1805            IF AVAILABLE buf_user-login
     1806            THEN DO:
     1807               assign
     1808                  p-user-id = buf_user-login.user-id
     1809               .
     1810            END.
     1811      end.
     1812   end procedure.
     1813       run diasize_init in this-procedure .
     1814   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   on F3 of frame Dialog-Frame anywhere do:
     1816     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1817     return no-apply.
     1818   end.
     1819   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1820   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1821   MAIN-BLOCK:
     1822   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1823      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1824   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825     run mainmenu_getcntxt in parparentproc
     1826       (output v-cntxt-db-num
     1827       ,output v-cntxt-userid
     1828       ,output v-cntxt-level
     1829       ,output v-cntxt-host-code-obj
     1830       ,output v-cntxt-obj-type
     1831       ,output v-cntxt-obj-code
     1832       ,output v-cntxt-db-num-obj
     1833       ,output v-cntxt-is-admin
     1834       ) .
     1835       run fill-temp_kitchen-object in this-procedure (
     1836           input p-fbr-pln-doc-code
     1837       ).
     1838       run fill-temp_fbr-doc in this-procedure (
     1839           input p-fbr-pln-doc-code
     1840       ).
     1841       RUN enable_UI.
     1842       WAIT-FOR GO OF FRAME Dialog-Frame.
     1843   END.
     1844   RUN disable_UI.
     1845   PROCEDURE disable_UI :
     1846     HIDE FRAME Dialog-Frame.
     1847   END PROCEDURE.
     1848   PROCEDURE enable_UI :
     1849     ENABLE b-exit b-lkp b-help br-table
     1850         WITH FRAME Dialog-Frame.
     1851     VIEW FRAME Dialog-Frame.
     1852     OPEN QUERY br-table FOR EACH temp_fbr-doc NO-LOCK INDEXED-REPOSITION.
     1853   END PROCEDURE.
     1854   PROCEDURE fill-temp_fbr-doc :
     1855   define input parameter p-fbr-pln-doc-code   as character        no-undo.
     1856       define buffer buf_fbr-doc       for fbr-doc.
     1857       define buffer buf_temp_fbr-doc  for temp_fbr-doc.
     1858   do
     1859   on error undo, return error
     1860   :
     1861       for each buf_fbr-doc no-lock
     1862          where buf_fbr-doc.out-code = p-fbr-pln-doc-code
     1863       on error undo, return error
     1864       :
     1865           create buf_temp_fbr-doc.
     1866           assign
     1867               buf_temp_fbr-doc.doc-code = buf_fbr-doc.doc-code
     1868               buf_temp_fbr-doc.status_  = buf_fbr-doc.status_
     1869               buf_temp_fbr-doc.doc-date = buf_fbr-doc.doc-date
     1870               buf_temp_fbr-doc.obj-type = buf_fbr-doc.obj-type
     1871               buf_temp_fbr-doc.obj-code = buf_fbr-doc.obj-code
     1872               buf_temp_fbr-doc.PS       = buf_fbr-doc.PS
     1873           .
     1874       end.
     1875   end.
     1876   END PROCEDURE.
     1877   PROCEDURE fill-temp_kitchen-object :
     1878   define input parameter p-fbr-pln-doc-code   as character        no-undo.
     1879       define buffer buf_fbr-pln-line          for fbr-pln-line.
     1880       define buffer buf_temp_kitchen-object   for temp_kitchen-object.
     1881   do
     1882   on error undo, return error
     1883   :
     1884       for each buf_fbr-pln-line no-lock
     1885          where buf_fbr-pln-line.doc-code = p-fbr-pln-doc-code
     1886       on error undo, return error
     1887       :
     1888           find first buf_temp_kitchen-object
     1889                where buf_temp_kitchen-object.obj-type = buf_fbr-pln-line.fbr-obj-type
     1890                  and buf_temp_kitchen-object.obj-code = buf_fbr-pln-line.fbr-obj-code
     1891           no-error.
     1892           if not available buf_temp_kitchen-object
     1893           then do:
     1894               create buf_temp_kitchen-object.
     1895               assign
     1896                   buf_temp_kitchen-object.obj-type = buf_fbr-pln-line.fbr-obj-type
     1897                   buf_temp_kitchen-object.obj-code = buf_fbr-pln-line.fbr-obj-code
     1898               .
     1899           end.
     1900       end.
     1901   end.
     1902   END PROCEDURE.
