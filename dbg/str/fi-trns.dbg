      936               frame Dialog-Frame :height = v-frame-height
      937             .
      938             if frame Dialog-Frame :scrollable = true
      939             then do:
      940               assign
      941                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      942               .
      943             end.
      944             run diasize_position-resize-button in this-procedure .
      945           end.
      946           else do:
      947             if frame Dialog-Frame :scrollable = true
      948             then do:
