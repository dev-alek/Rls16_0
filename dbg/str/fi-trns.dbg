     2126   PROCEDURE enable_UI :
     2127     DISPLAY var-ps FILL-IN-1 v-U-full FILL-IN_prn-doc-code FILL-IN_status_
     2128             FILL-IN_user-name-doc FILL-IN_fin-doc-type FILL-IN_user-name-fact
     2129             FILL-IN_doc-date FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code
     2130             FILL-IN_sum-doc FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code
     2131             FILL-IN_doc-type FILL-IN_contract-type FILL-IN_usl-opl FILL-IN-sr-op
     2132             FILL-IN_srok-opl
     2133         WITH FRAME Dialog-Frame.
     2134     ENABLE B-exit B-lkp B-lkp-2 B-lkp-3 B-Help BROWSE-1 var-ps FILL-IN-1 v-U-full
     2135            FILL-IN_prn-doc-code FILL-IN_status_ FILL-IN_user-name-doc
     2136            FILL-IN_fin-doc-type FILL-IN_user-name-fact FILL-IN_doc-date
     2137            FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code FILL-IN_sum-doc
     2138            FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code FILL-IN_doc-type
     2139            FILL-IN_contract-type FILL-IN_usl-opl FILL-IN-sr-op FILL-IN_srok-opl
     2140         WITH FRAME Dialog-Frame.
     2141     VIEW FRAME Dialog-Frame.
     2142     OPEN QUERY BROWSE-1 FOR EACH fin-ob-trn WHERE                                  fin-ob-trn.doc-code = p-fin-ob-doc-code  NO-LOCK,              EACH trn-doc WHERE            trn-doc.doc-code = fin-ob-trn.trn-doc-code AND            fin-ob-trn.doc-type  = ""  OUTER-JOIN NO-LOCK,              EACH c-trn-doc WHERE            c-trn-doc.doc-code = fin-ob-trn.trn-doc-code and            c-trn-doc.is-del = yes AND            fin-ob-trn.doc-type  = "" OUTER-JOIN NO-LOCK,              FIRST ord-doc WHERE             ord-doc.doc-code = fin-ob-trn.trn-doc-code AND             fin-ob-trn.doc-type  = "order" OUTER-JOIN NO-LOCK,              FIRST add-doc WHERE             add-doc.doc-code = fin-ob-trn.trn-doc-code AND             fin-ob-trn.doc-type  = "add" OUTER-JOIN NO-LOCK,               FIRST ord-doc-rcv WHERE             ord-doc-rcv.rcv-code = fin-ob-trn.trn-doc-code AND             fin-ob-trn.doc-type  = "rcv" OUTER-JOIN NO-LOCK.
     2143   END PROCEDURE.
     2144   FUNCTION sel-abbr RETURNS CHARACTER
     2145    ( p-curr-code as int ) :
     2146     define variable rr as character no-undo .
     2147     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
     2148     rr = currency.curr-abbr .
     2149     RETURN rr.
     2150   END FUNCTION.
