     1212   procedure diasize_set-height :
     1213     define input  parameter p-new-height  as decimal   no-undo .
     1214     define input  parameter p-move-resize as logical   no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       run diasize_change-height in this-procedure
     1219         (input  (p-new-height - frame Dialog-Frame :height)
     1220         ,input  p-move-resize
     1221         ) .
     1222     end.
     1223   end procedure.
     1224   procedure diasize_change-width :
     1225     define input  parameter p-change-value as decimal   no-undo .
     1226     define input  parameter p-move-resize  as logical   no-undo .
     1227     define variable v-field-group-handle   as handle    no-undo .
     1228     define variable v-object-handle        as handle    no-undo .
     1229     define variable v-frame-width          as decimal   no-undo .
     1230     define variable v-frame-virtual-width  as decimal   no-undo .
     1231     define variable v-browse-width         as decimal   no-undo .
     1232     define variable v-window-width         as decimal   no-undo .
     1233     define variable v-window-virtual-width as decimal   no-undo .
     1234     define variable v-change-sign          as integer   no-undo .
     1235     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1236     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1237     if p-change-value > 0
     1238     then do:
     1239       if frame Dialog-Frame :width + p-change-value >
     1240           session :width-chars
     1241       then do:
     1242         assign
     1243           p-change-value = session :width-chars - frame Dialog-Frame :width
     1244         .
     1245         if p-change-value <= 0
     1246         then do:
     1247           run diasize_position-resize-button in this-procedure .
     1248           return .
     1249         end.
     1250       end.
     1251     end.
     1252     if p-change-value < 0
     1253     then do:
     1254       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1255       then do:
     1256         assign
     1257           p-change-value = v-diasize-orig-frame-width
     1258                          - frame Dialog-Frame :width
     1259         .
     1260         if p-change-value >= 0
     1261         then do:
     1262           run diasize_position-resize-button in this-procedure .
     1263           return .
     1264         end.
     1265       end.
     1266     end.
     1267     if p-change-value >= 0
     1268     then do:
     1269       assign
     1270         v-change-sign = 1
     1271       .
     1272     end.
     1273     else do:
     1274       assign
     1275         v-change-sign = -1
     1276       .
     1277     end.
     1278     assign
     1279       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1280     .
     1281     if p-change-value = 0
     1282     then do:
     1283       run diasize_position-resize-button in this-procedure .
     1284       return .
     1285     end.
