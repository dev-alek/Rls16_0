      892     assign
      893       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      894     .
      895     if p-change-value = 0
      896     then do:
      897       run diasize_position-resize-button in this-procedure .
      898       return .
      899     end.
      900     move_block:
      901     do
      902     on error undo move_block, retry move_block
      903     :
      904       if retry
      905       then do:
      906         do
      907         on error undo move_block, leave move_block
      908         :
      909           if p-change-value > 0
      910           then do:
      911             for each buf_temp-diasize-handle
      912             on error undo, next
      913             :
