       76   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   function func-get-name-from-ext-type   returns char
       78     ( p-ext-type as character   ,
       79       p-caps     as logical ).
       80   define variable v-ext-name as character no-undo .
       81   run get-name-from-ext-type in this-procedure (
       82       input p-ext-type  ,
       83       input p-caps  ,
       84       output v-ext-name )
       85       no-error .
       86       if error-status :error then do:
       87          assign
       88            v-ext-name = p-ext-type
       89          .
       90       end.
       91    return (v-ext-name) .
       92   end.
       93   procedure get-name-from-ext-type :
       94    do
       95    on error undo, return error return-value
       96    :
       97   define input  parameter p-ext-type as character no-undo .
       98   define input  parameter p-caps     as logical no-undo   .
       99   define output parameter p-ext-name as character no-undo .
      100   define variable v-num as integer no-undo .
      101     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      102       message
      103         vss-include-info0 skip
      104         "Неправильно задано значение входящего параметра! "
      105         "Нет такого типа документов " p-ext-type
      106         view-as alert-box error .
      107         undo, return error .
      108     end.
      109     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      110     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      111     if p-caps  = true then do :
      112        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      113     end .
      114     end.
      115   end procedure.
      116   procedure proc-alt-shift-f2:
      117     if not ibs.th.gbl.gbl-var:rcode
      118   then
      119     run gbl\inidebug.p .
      120   end.
      121   procedure proc-alt-shift-f3:
      122     run gbl/prvssinf.p
      123       ( input this-procedure
      124       ) .
      125   end.
      126   define variable v-inform-launched as logical no-undo initial false .
      127   procedure proc-alt-shift-f4:
      128     define variable v-action as character no-undo .
      129     if v-inform-launched = false then do:
      130       assign
      131         v-inform-launched = true
      132       .
      133       run gbl/d-inform.w
      134         (  input self
      135         ,  input this-procedure
      136         , output v-action
      137         ) no-error .
      138       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      139       assign
      140         v-inform-launched = false
      141       .
      142     end.
      143   end.
      144   procedure proc-alt-f1:
      145     run gbl/corrhelp.p
      146       (input this-procedure
      147       ) .
      148   end .
      149   on alt-shift-f2 anywhere do:
      150     run proc-alt-shift-f2.
      151   end.
      152   on alt-shift-f3 anywhere do:
      153     run proc-alt-shift-f3 in this-procedure .
      154   end.
      155   on alt-shift-f4 anywhere do:
      156     run proc-alt-shift-f4 in this-procedure.
      157   end.
      158   on alt-f1 anywhere do:
      159     run proc-alt-f1 in this-procedure .
      160   end.
