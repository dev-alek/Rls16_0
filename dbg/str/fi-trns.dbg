      222         VIEW-AS TEXT
      223        SIZE 11.88 BY .67 NO-UNDO.
      224   DEFINE VARIABLE FILL-IN_contract-prn-code AS CHARACTER FORMAT "X(16)"
      225        LABEL "№ договора"
      226         VIEW-AS TEXT
      227        SIZE 17 BY .67.
