      204   DEFINE BUTTON B-lkp-2
      205        LABEL "&Фин.Обяз."
      206        SIZE 10 BY 1 TOOLTIP "Просмотр ФО или ПФО".
      207   DEFINE BUTTON B-lkp-3
      208        LABEL "&Договор"
      209        SIZE 10 BY 1 TOOLTIP "Просмотр Договора".
      210   DEFINE VARIABLE var-ps AS CHARACTER
      211        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      212        SIZE 56.5 BY 2.5 NO-UNDO.
