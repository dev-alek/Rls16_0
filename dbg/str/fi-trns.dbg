      237        LABEL "Дата ФО"
      238         VIEW-AS TEXT
      239        SIZE 11 BY .67.
      240   DEFINE VARIABLE FILL-IN_doc-type AS CHARACTER FORMAT "X(4)"
      241        LABEL "Вид"
      242         VIEW-AS TEXT
      243        SIZE 5 BY .67.
      244   DEFINE VARIABLE FILL-IN_fact-date AS DATE FORMAT "99/99/9999"
      245        LABEL "Факт"
      246         VIEW-AS TEXT
      247        SIZE 11 BY .67.
      248   DEFINE VARIABLE FILL-IN_fin-doc-type AS CHARACTER FORMAT "X(14)"
      249        LABEL "Тип"
      250         VIEW-AS TEXT
      251        SIZE 37.38 BY .67.
      252   DEFINE VARIABLE FILL-IN_pay-date AS DATE FORMAT "99/99/9999"
      253        LABEL "Платеж"
      254         VIEW-AS TEXT
      255        SIZE 11 BY .67.
      256   DEFINE VARIABLE FILL-IN_prn-doc-code AS CHARACTER FORMAT "X(16)"
      257        LABEL "№"
      258         VIEW-AS TEXT
      259        SIZE 17 BY .67.
      260   DEFINE VARIABLE FILL-IN_srok-opl AS INTEGER FORMAT "->,>>>" INITIAL 0
      261         VIEW-AS TEXT
      262        SIZE 3.75 BY .67.
      263   DEFINE VARIABLE FILL-IN_status_ AS CHARACTER FORMAT "X(8)"
      264        LABEL "Статус ФО"
      265         VIEW-AS TEXT
      266        SIZE 9 BY .67.
      267   DEFINE VARIABLE FILL-IN_sum-doc AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      268        LABEL "Сумма"
      269         VIEW-AS TEXT
      270        SIZE 22 BY .67 TOOLTIP "Сумма в ценах документа".
      271   DEFINE VARIABLE FILL-IN_sum-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL 0
      272        LABEL "Сумма "
      273         VIEW-AS TEXT
      274        SIZE 22 BY .67.
      275   DEFINE VARIABLE FILL-IN_user-name-doc AS CHARACTER FORMAT "X(8)"
      276        LABEL "Создал"
      277         VIEW-AS TEXT
      278        SIZE 9 BY .67.
      279   DEFINE VARIABLE FILL-IN_user-name-fact AS CHARACTER FORMAT "X(8)"
