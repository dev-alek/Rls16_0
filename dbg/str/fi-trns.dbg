      281         VIEW-AS TEXT
      282        SIZE 9 BY .67.
      283   DEFINE VARIABLE FILL-IN_usl-opl AS CHARACTER FORMAT "X(40)"
      284        LABEL "Условия"
      285         VIEW-AS TEXT
      286        SIZE 40.63 BY .67.
      287   DEFINE VARIABLE v-U-full AS CHARACTER FORMAT "X(256)":U
      288         VIEW-AS TEXT
      289        SIZE 48 BY .67
      290        FGCOLOR 12  NO-UNDO.
      291   DEFINE QUERY BROWSE-1 FOR
      292       fin-ob-trn,
      293       trn-doc,
      294       c-trn-doc,
      295       ord-doc,
      296       add-doc,
      297       ord-doc-rcv
      298       SCROLLING.
      299   DEFINE BROWSE BROWSE-1
      300     QUERY BROWSE-1 NO-LOCK DISPLAY
      301         v-U @ v-U COLUMN-LABEL "У" FORMAT "x(1)":U
      302         fin-ob-trn.trn-doc-code COLUMN-LABEL "№ документа" FORMAT "X(14)":U
      303         fin-ob-trn.doc-code FORMAT "X(16)":U
      304         fin-ob-trn.sum-rubl COLUMN-LABEL "Сумма ФО" FORMAT "->,>>>,>>>,>>>,>>9.99":U
      305         WIDTH 12
      306         v-ext-doc-type @ v-ext-doc-type COLUMN-LABEL "Тип!документа" FORMAT "x(15)":U
      307         v-doc-date @ v-doc-date COLUMN-LABEL "Дата!документа" FORMAT "99/99/99":U
      308         v-fact-date @ v-fact-date COLUMN-LABEL "Факт" FORMAT "99/99/99":U
      309         v-cli-name @ v-cli-name COLUMN-LABEL "Контрагент" FORMAT "X(40)":U
      310               WIDTH 30
      311         v-fact-rubl @ v-fact-rubl COLUMN-LABEL "Сумма докум." FORMAT "->,>>>,>>>,>>>,>>9.99":U
      312         v-creid @ v-creid COLUMN-LABEL "Создал!документ" FORMAT "X(8)":U
      313         v-fact-time @ v-fact-time COLUMN-LABEL "Время" FORMAT "x(5)":U
      314       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.5 BY 12.5.
      315   DEFINE FRAME Dialog-Frame
      316        B-exit AT ROW 1 COL 1
      317        B-lkp AT ROW 1 COL 11
      318        B-lkp-2 AT ROW 1 COL 21
      319        B-lkp-3 AT ROW 1 COL 31
      320        B-Help AT ROW 1.04 COL 85.75
      321        BROWSE-1 AT ROW 2.25 COL 1
      322        var-ps AT ROW 18.5 COL 38.5 NO-LABEL
      323        FILL-IN-1 AT ROW 14.96 COL 1.38 NO-LABEL
      324        v-U-full AT ROW 15 COL 45 COLON-ALIGNED NO-LABEL
      325        FILL-IN_prn-doc-code AT ROW 15.71 COL 13.25 COLON-ALIGNED
      326        FILL-IN_status_ AT ROW 15.71 COL 42 COLON-ALIGNED
      327        FILL-IN_user-name-doc AT ROW 15.71 COL 65.5 COLON-ALIGNED
      328        FILL-IN_fin-doc-type AT ROW 16.63 COL 13.5 COLON-ALIGNED
      329        FILL-IN_user-name-fact AT ROW 16.63 COL 65.5 COLON-ALIGNED
      330        FILL-IN_doc-date AT ROW 17.54 COL 13.25 COLON-ALIGNED
      331        FILL-IN_fact-date AT ROW 17.54 COL 32.63 COLON-ALIGNED
      332        FILL-IN_pay-date AT ROW 18.38 COL 13.25 COLON-ALIGNED
      333        FILL-IN_curr-code AT ROW 19.25 COL 2.25 NO-LABEL
      334        FILL-IN_sum-doc AT ROW 19.29 COL 13.13 COLON-ALIGNED
      335        FILL-IN_sum-rubl AT ROW 20.17 COL 13.13 COLON-ALIGNED
      336        FILL-IN-2 AT ROW 20.88 COL 1.25 NO-LABEL
      337        FILL-IN_contract-prn-code AT ROW 21.58 COL 12.25 COLON-ALIGNED
      338        FILL-IN_doc-type AT ROW 21.58 COL 35.25 COLON-ALIGNED
      339        FILL-IN_contract-type AT ROW 22.46 COL 5.38 COLON-ALIGNED
      340        FILL-IN_usl-opl AT ROW 22.46 COL 36 COLON-ALIGNED
      341        FILL-IN-sr-op AT ROW 22.46 COL 77 COLON-ALIGNED NO-LABEL
      342        FILL-IN_srok-opl AT ROW 22.46 COL 89.13 COLON-ALIGNED NO-LABEL
      343        SPACE(0.87) SKIP(0.15)
      344       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      345            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      346            TITLE "Накладные по фин.обязательству".
      347   ASSIGN
      348          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      349          FRAME Dialog-Frame:HIDDEN           = TRUE.
      350   ASSIGN
      351          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      352   ASSIGN
      353          var-ps:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      354   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      355   DO:
      356     APPLY "END-ERROR":U TO SELF.
      357   END.
      358   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
      359   DO:
      360   define variable v-r as recid no-undo .
      361   if not available fin-ob-trn then return no-apply .
      362       case  fin-ob-trn.doc-type :
      363       when "" then do:
      364         find  first trn-doc  where trn-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = ""  no-lock no-error .
      365         IF AVAILABLE trn-doc THEN
      366         run str/fishdoc.p (  parparentproc,
      367                       par-host-code ,
      368                       trn-doc.obj-type,
      369                       trn-doc.obj-code,
      370                       trn-doc.doc-code , ? ) .
      371         else do:
      372         find first c-trn-doc WHERE
      373                    c-trn-doc.is-del = yes and
      374                    c-trn-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "" no-lock no-error .
      375         if available c-trn-doc then do:
      376           run str/c-doc.w ( input parparentproc, input c-trn-doc.doc-code, input c-trn-doc.chip-num ).
      377         end.
      378                   end.
      379       end.
      380       when "order" then do:
      381         find first ord-doc WHERE ord-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "order"    NO-LOCK no-error .
      382         if available ord-doc then do:
      383             run cus/show-ord.p ( input parParentProc, input recid(ord-doc) ).
      384         end.
      385       end.
      386       when "rcv" then do:
      387         find first ord-doc-rcv WHERE ord-doc-rcv.rcv-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "rcv" no-lock no-error .
      388         if available ord-doc-rcv then do:
      389             v-r = recid(ord-doc-rcv) .
      390             run cus/lkp-rcv.w (
      391                 input parParentProc,
      392                 input-output v-r
      393                 ).
      394         end.
      395       end.
      396       when "add" then do:
      397           find first add-doc no-lock where add-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "add" no-error .
      398           if available add-doc then do:
      399             v-r = recid(add-doc) .
      400             run str/add-docu.w ( input parparentproc  ,
      401                                  input-output v-r ,
      402                                  input 'ПРОСМОТР':U  ,
      403                                  input ?
      404                                  ).
      405           end.
      406       end.
      407       end case.
      408   END.
      409   ON CHOOSE OF B-lkp-2 IN FRAME Dialog-Frame
      410   DO:
      411      if not available  fin-ob-trn then return .
      412   define variable p-doc-type   as character no-undo .
      413   define variable  p-status_   as character no-undo .
      414   define buffer buf_fin-ob   for fin-ob .
      415   define buffer buf_fin-ob-before   for fin-ob-before  .
      416   define variable g-log as logical no-undo .
      417   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   do:
      419     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      420       (input  v-cntxt-db-num
      421       ,input  v-cntxt-userid
      422       ,input  0
      423       ,input  'actn_fin-liability_lookup':U
      424       ,input  'firm':U
      425       ,input  par-host-code
      426       ,input  '':U
      427       ,input  0
      428       ,input  0
      429       ,input  0
      430       ,input  0
      431       ,input  true
      432       ,output g-log
      433       )  .
      434   end.
      435   if not g-log then  return .
      436   define variable rr as recid no-undo .
      437   find first buf_fin-ob no-lock where buf_fin-ob.doc-code = fin-ob-trn.doc-code no-error .
      438       if available buf_fin-ob then do:
      439           rr = recid( buf_fin-ob ).
      440           p-doc-type = buf_fin-ob.doc-type .
      441           p-status_  = buf_fin-ob.status_  .
      442           br-handle = ? .
      443           next-prev = ? .
      444           find first buf_fin-liab no-lock where recid(buf_fin-liab) = rr no-error .
      445           run str/fi-liabi.w ( parParentProc, 'ПРОСМОТР':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
      446        end.
      447      else do:
      448         find first buf_fin-ob-before no-lock where buf_fin-ob-before.before-code = fin-ob-trn.doc-code no-error .
      449         if not available  buf_fin-ob-before  then return.
      450           rr = recid( buf_fin-ob-before ).
      451           p-doc-type = buf_fin-ob-before.doc-type .
      452           p-status_  = buf_fin-ob-before.status_  .
      453           br-handle = ? .
      454           next-prev = ? .
      455           find first buf_fin-liab-before no-lock where recid(buf_fin-liab-before) = rr no-error .
      456           run str/fi-liabb.w ( parParentProc, 'ПРОСМОТР':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
      457           if br-handle = ? then reposition BROWSE-1 to recid rr no-error.
      458      end.
      459   END.
      460   ON CHOOSE OF B-lkp-3 IN FRAME Dialog-Frame
      461   DO:
      462   define buffer buf_fin-ob   for fin-ob .
      463   define buffer buf_fin-ob-before   for fin-ob-before  .
      464   define buffer b_contract for contract .
      465   define variable loc_contract-code as integer no-undo .
      466   if not available fin-ob-trn then return .
      467   find first buf_fin-ob no-lock where buf_fin-ob.doc-code = fin-ob-trn.doc-code no-error .
      468   if available buf_fin-ob then do:
      469         loc_contract-code = buf_fin-ob.contract-code .
      470   end.
      471   else do:
      472         find first buf_fin-ob-before no-lock where buf_fin-ob-before.before-code = fin-ob-trn.doc-code no-error .
      473         if not available  buf_fin-ob-before  then return.
      474         loc_contract-code = buf_fin-ob-before.contract-code .
      475   end.
      476   define variable ri as recid no-undo .
      477   find first b_contract no-lock  where b_contract.contract-code = loc_contract-code and
      478                                        b_contract.host-code     = par-host-code
      479                                        no-error .
      480   if error-status :error then return no-apply.
      481   ri = recid (b_contract) .
      482   run str/sh-contr.p (
      483     input   parParentProc ,
      484     input  ri      )
      485     .
      486   END.
      487   ON ROW-DISPLAY OF BROWSE-1 IN FRAME Dialog-Frame
      488   DO:
      489   define buffer buf1_fin-ob for ub.fin-ob  .
      490   case  fin-ob-trn.doc-type :
      491   when "" then do:
      492        find  first trn-doc  WHERE trn-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = ""  no-lock no-error .
      493         IF AVAILABLE trn-doc THEN
      494             ASSIGN
      495             v-U = " "
      496             v-ext-doc-type = func-get-name-from-ext-type(trn-doc.ext-doc-type,no)
      497             v-doc-date  = trn-doc.doc-date
      498             v-fact-date = trn-doc.fact-date
      499             v-cli-name  = trn-doc.cli-name
      500             v-fact-qnty = trn-doc.doc-qnty
      501             v-fact-rubl = trn-doc.tot-fact
      502             v-creid     = trn-doc.creid
      503             v-fact-time =  string(trn-doc.fact-time,"hh:mm")
      504             .
      505     ELSE DO:
      506        find first c-trn-doc WHERE c-trn-doc.is-del = yes and c-trn-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "" no-lock no-error .
      507           IF AVAILABLE c-trn-doc THEN DO:
      508               ASSIGN
      509               v-U = "+"
      510               v-ext-doc-type = func-get-name-from-ext-type(c-trn-doc.ext-doc-type,no)
      511               v-doc-date  = c-trn-doc.doc-date
      512               v-fact-date = c-trn-doc.fact-date
      513               v-cli-name  = c-trn-doc.cli-name
      514               v-fact-qnty = c-trn-doc.doc-qnty
      515               v-fact-rubl = c-trn-doc.tot-fact
      516               v-creid     = c-trn-doc.creid
      517               v-fact-time =  string(c-trn-doc.fact-time,"hh:mm")
      518               .
      519           END.
      520       END.
      521   end.
      522   when "order" then do:
      523      find first ord-doc WHERE ord-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "order"    NO-LOCK no-error .
      524      if available ord-doc then
      525         ASSIGN
      526         v-U = " "
      527         v-ext-doc-type = 'заказ':U
      528         v-doc-date  = ord-doc.doc-date
      529         v-fact-date = ord-doc.fact-date
      530         v-cli-name  = ord-doc.cli-name
      531         v-fact-qnty = ord-doc.qnty
      532         v-fact-rubl = ord-doc.sum-rubl
      533         v-creid     = ord-doc.creid
      534         v-fact-time =  string(ord-doc.fact-time,"hh:mm")
      535         .
      536   end.
      537   when "rcv" then do:
      538      find    first ord-doc-rcv WHERE ord-doc-rcv.rcv-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "rcv" no-lock no-error .
      539         if available ord-doc-rcv then
      540         ASSIGN
      541         v-U = " "
      542         v-ext-doc-type = 'поставка':U
      543         v-doc-date  = ord-doc-rcv.doc-date
      544         v-fact-date = ord-doc-rcv.fact-date
      545         v-creid     = ord-doc-rcv.creid
      546         v-fact-time =  string(ord-doc-rcv.fact-time,"hh:mm")      .
      547         define buffer buf_clients for ub.clients  .
      548         define buffer buf_ord-line-rcv for ub.ord-line-rcv  .
      549         find first buf_clients no-lock where buf_clients.obj-code =   ord-doc-rcv.cli-code and
      550                                              buf_clients.obj-type =   ord-doc-rcv.cli-type no-error .
      551         if available buf_clients then v-cli-name = buf_clients.obj-name .
      552                                  else v-cli-name = "".
      553         v-fact-qnty = 0 .
      554         v-fact-rubl = 0 .
      555          for each buf_ord-line-rcv no-lock where buf_ord-line-rcv.rcv-code = ord-doc-rcv.rcv-code and
      556                                                  buf_ord-line-rcv.doc-code = ord-doc-rcv.doc-code :
      557                 v-fact-qnty = v-fact-qnty +  buf_ord-line-rcv.qnty .
      558                 v-fact-rubl = v-fact-rubl +  buf_ord-line-rcv.sum-rubl .
      559          end.
      560   end.
      561   when "add" then do:
      562      find first add-doc no-lock where
      563                 add-doc.doc-code    =  fin-ob-trn.trn-doc-code and
      564                 fin-ob-trn.doc-type =  "add"
      565                 no-error .
      566      find first buf1_fin-ob no-lock where
      567                 buf1_fin-ob.doc-code    =  fin-ob-trn.doc-code and
      568                 fin-ob-trn.doc-type =  "add"
      569                 no-error .
      570      if not available buf1_fin-ob then do:
      571         message
      572           error-status :get-message(1) skip
      573           return-value skip
      574           "Не найдено ФО"
      575           view-as alert-box error
      576         .
      577      end.
      578      if available add-doc then do:
      579         assign
      580           v-u = " "
      581           v-ext-doc-type = 'ДопРасход'
      582           v-doc-date  = add-doc.doc-date
      583           v-fact-date = add-doc.fact-date
      584           v-cli-name  = buf1_fin-ob.receiver-name
      585           v-fact-qnty = ?
      586           v-fact-rubl = add-doc.sum-rubl
      587           v-creid     = add-doc.creid
      588           v-fact-time =  string(add-doc.fact-time,"hh:mm")
      589           .
      590       end.
      591       else do:
      592         find first c-add-doc WHERE c-add-doc.doc-code = fin-ob-trn.trn-doc-code and fin-ob-trn.doc-type = "add" and c-add-doc.is-del = true    NO-LOCK no-error .
      593         if available c-add-doc then do:
      594         assign
      595           v-doc-date  = c-add-doc.doc-date
      596           v-fact-date = c-add-doc.fact-date
      597           v-fact-rubl = c-add-doc.sum-rubl
      598           v-creid     = c-add-doc.creid
      599           v-fact-time =  string(c-add-doc.fact-time,"hh:mm")
      600           .
      601          end.
      602          Assign
      603           v-U = " "
      604           v-ext-doc-type = 'ДопРасх-УДАЛЕН'
      605           v-cli-name  = '---'
      606           v-fact-qnty = 0
      607           .
      608       end.
      609   end.
      610   end case.
      611   END.
      612   ON VALUE-CHANGED OF BROWSE-1 IN FRAME Dialog-Frame
      613   DO:
      614   if not available fin-ob-trn  then return.
      615   define buffer buf_fin-ob   for fin-ob .
      616   define buffer buf_fin-ob-before   for fin-ob-before  .
      617   define buffer buf_contract for contract .
      618   define variable v-contract as integer no-undo .
      619   find first buf_fin-ob no-lock where buf_fin-ob.doc-code = fin-ob-trn.doc-code no-error .
      620   if available buf_fin-ob then do:
      621         v-contract = buf_fin-ob.contract-code .
      622         assign
      623           FILL-IN_curr-code      = sel-abbr(buf_fin-ob.curr-code)
      624           FILL-IN_doc-date       = buf_fin-ob.doc-date
      625           FILL-IN_fact-date      = buf_fin-ob.fact-date
      626           FILL-IN_fin-doc-type   = if buf_fin-ob.doc-type = 'при':U then "с покупателем" else "с поставщиком"
      627           FILL-IN_pay-date       = buf_fin-ob.pay-date
      628           FILL-IN_prn-doc-code   = buf_fin-ob.prn-doc-code
      629           FILL-IN_status_        = buf_fin-ob.status_
      630           FILL-IN_sum-rubl       = buf_fin-ob.sum-rubl
      631           FILL-IN_user-name-doc  = buf_fin-ob.user-name-doc
      632           FILL-IN_user-name-fact = buf_fin-ob.user-name-fact
      633           FILL-IN_sum-doc        = buf_fin-ob.sum-doc
      634           var-ps =                 buf_fin-ob.PS
      635         .
      636      end.
      637      else do:
      638         find first buf_fin-ob-before no-lock where buf_fin-ob-before.before-code = fin-ob-trn.doc-code no-error .
      639         if not available  buf_fin-ob-before  then return.
      640         v-contract = buf_fin-ob-before.contract-code .
      641         assign
      642           FILL-IN_curr-code      = sel-abbr(buf_fin-ob-before.curr-code)
      643           FILL-IN_doc-date       = buf_fin-ob-before.doc-date
      644           FILL-IN_fact-date      = buf_fin-ob-before.fact-date
      645           FILL-IN_fin-doc-type   = "ПФО"
      646           FILL-IN_pay-date       = buf_fin-ob-before.pay-date
      647           FILL-IN_prn-doc-code   = buf_fin-ob-before.prn-doc-code
      648           FILL-IN_status_        = buf_fin-ob-before.status_
      649           FILL-IN_sum-rubl       = buf_fin-ob-before.sum-rubl
      650           FILL-IN_user-name-doc  = buf_fin-ob-before.user-name-doc
      651           FILL-IN_user-name-fact = buf_fin-ob-before.user-name-fact
      652           FILL-IN_sum-doc        = buf_fin-ob-before.sum-doc
      653           var-ps =                 buf_fin-ob-before.PS
      654         .
      655      end.
      656   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      658     (input  FILL-IN_user-name-doc
      659     ,output FILL-IN_user-name-doc
      660     )  .
      661   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      663     (input  FILL-IN_user-name-fact
      664     ,output FILL-IN_user-name-fact
      665     )  .
      666     find first buf_contract no-lock where  buf_contract.contract-code  =  v-contract  no-error .
      667       if not available buf_contract then return .
      668     assign
      669       FILL-IN_contract-prn-code  = buf_contract.contract-prn-code
      670       FILL-IN_contract-type      = buf_contract.contract-type
      671       FILL-IN_usl-opl            = buf_contract.usl-opl
      672       FILL-IN_srok-opl           = buf_contract.srok-opl
      673       FILL-IN_doc-type           = buf_contract.doc-type
      674     .
      675    if  buf_contract.usl-opl  = 'По реализации части приход. накладной':U or
      676        buf_contract.usl-opl  = 'Предоплата(%)':U
      677        then do:
      678        FILL-IN-sr-op = "        % :".
      679    end.
      680    else do:
      681       FILL-IN-sr-op = "Срок оплаты:".
      682    end.
      683    display
      684     FILL-IN_contract-prn-code FILL-IN_contract-type FILL-IN_curr-code FILL-IN_doc-date FILL-IN_doc-type FILL-IN_fact-date FILL-IN_fin-doc-type FILL-IN_pay-date FILL-IN_prn-doc-code FILL-IN_srok-opl FILL-IN_status_ FILL-IN_sum-rubl FILL-IN_user-name-doc FILL-IN_user-name-fact FILL-IN_usl-opl
      685     FILL-IN_sum-doc  FILL-IN-sr-op var-ps
      686     with frame Dialog-Frame.
      687    if fin-ob-trn.doc-type = "" then do:
      688       IF AVAILABLE c-trn-doc THEN DO:
      689           ASSIGN
      690             v-U-full = "Накладная УДАЛЕНА !!!"
      691           .
      692       END.
      693       ELSE DO:
      694           ASSIGN
      695             v-U-full = ""
      696           .
      697       END.
      698       DISPLAY v-U-full WITH FRAME Dialog-Frame.
      699     end.
      700   END.
      701   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      702   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      703   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   on help of frame Dialog-Frame
      705   do:
      706     run gbl/app_help.p
      707       (input this-procedure :file-name
      708       ,input ''
      709       ,input ?
      710       ) no-error.
      711     if error-status :error then do:
      712       message
      713         "Ошибка при вызове помощи"
      714         error-status :get-message(1)
      715         view-as alert-box .
      716     end.
      717   end.
      718   run minbtn-set in this-procedure .
      719   on choose of b-help in frame Dialog-Frame
      720   do:
      721     apply "help":u to frame Dialog-Frame .
      722   end.
      723   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   procedure minbtn-set :
      725       do
      726           on error undo, return error return-value
      727           :
      728           define variable ii              as integer       no-undo .
      729           define variable fh              as widget-handle no-undo .
      730           define variable hh              as widget-handle no-undo .
      731           define variable v-h             as handle        extent 4 no-undo .
      732           define variable v-name-button   as character     no-undo .
      733           define variable v-help-old-x    as decimal       no-undo .
      734           define variable v-help-old-y    as decimal       no-undo .
      735           define variable v-help-old-size as decimal       no-undo .
      736           define variable v-frame-width   as decimal       no-undo .
      737           define variable jj              as integer       no-undo .
      738           do
      739               on error undo, return error
      740               :
      741               assign
      742                   v-frame-width = frame Dialog-Frame:width - 0.3
      743                   fh            = frame Dialog-Frame:first-child
      744                   hh            = fh:first-child
      745                   ii            = 1
      746                   .
      747               do while valid-handle(hh):
      748                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      749                   do:
      750                       case lc(hh:name) :
      751                           when "b-help" then
      752                               do:
      753                                   hh:load-image-up("cmp/b-help.bmp":u) .
      754                                   hh:load-image-down("cmp/b-help.bmp":u) .
      755                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      756                                   hh:TOOLTIP = "Помощь" .
      757                                   v-help-old-x = hh:column .
      758                                   v-help-old-y = hh:row    .
      759                                   v-help-old-size = hh:width .
      760                                   hh:width-chars = 2.5 .
      761                               end.
      762                           when "b-print" then
      763                               do:
      764                                   hh:load-image("cmp/b-print.bmp":u) .
      765                                   hh:TOOLTIP = "Печать" .
      766                                   v-h[ii] = hh:handle .
      767                                   ii = ii + 1 .
      768                                   hh:width-chars = 3 .
      769                               end.
      770                           when "b-history" or
      771                           when "b-hist" then
      772                               do:
      773                                   hh:load-image("cmp/b-hist.bmp":u) .
      774                                   hh:TOOLTIP = "История" .
      775                                   v-h[ii] = hh:handle .
      776                                   ii = ii + 1 .
      777                                   hh:width-chars = 3 .
      778                               end.
      779                           when "b-sch" then
      780                               do:
      781                                   hh:load-image("cmp/b-sch.bmp":u) .
      782                                   hh:TOOLTIP = "Установка Фильтра" .
      783                                   v-h[ii] = hh:handle .
      784                                   ii = ii + 1 .
      785                                   hh:width-chars = 3 .
      786                               end.
      787                           when "b-hist-user" then
      788                               do:
      789                                   hh:load-image("cmp/b-hist.bmp":u) .
      790                                   hh:TOOLTIP = "История пользователя" .
      791                                   ii = ii + 1 .
      792                               end.
      793                       end case.
      794                   end.
      795                   hh = hh:next-sibling.
      796               end.
      797               b-help:column = v-frame-width - b-help:width-chars.
      798               jj = 0.
      799               repeat ii = 4 to 1 by -1 :
      800                   if valid-handle (v-h[ii] ) then
      801                   do:
      802                       jj  = jj + 1 .
      803                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      804                       v-h[ii]:row    = v-help-old-y .
      805                   end.
      806               end.
      807           end.
      808       end.
      809   end procedure.
      810   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      811   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      812   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      813   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      814   define variable v-diasize-current-frame-width  as decimal   no-undo .
      815   define variable v-diasize-current-frame-height as decimal   no-undo .
      816   define variable v-diasize-change-size          as logical   no-undo .
      817   define variable v-diasize-resize-button        as handle    no-undo .
      818   define variable v-diasize-wndmax               as logical   no-undo .
      819   define variable v-diasize-wndstore             as logical   no-undo .
      820   define variable v-diasize-proc-name            as character no-undo .
      821   define variable v-diasize-browse-handle        as handle    no-undo .
      822   define variable v-diasize-browse-number        as integer   no-undo .
      823   define variable v-diasize-need-full-display    as logical   no-undo init false .
      824   define temp-table temp-diasize-handle no-undo
      825     field handle-value  as handle
      826     field save-position as decimal
      827     index xpk is primary unique handle-value
      828     .
      829   define temp-table temp-browse-handle no-undo
      830     field browse-type   as character
      831     field browse-number as integer
      832     field browse-handle as handle
      833     field original-size as decimal
      834     index xpk is primary unique browse-type browse-number
      835     index xie browse-type browse-handle
      836   .
      837   procedure diasize_change-height :
      838     define input  parameter p-change-value  as decimal   no-undo .
      839     define input  parameter p-move-resize   as logical   no-undo .
      840     define variable v-field-group-handle    as handle    no-undo .
      841     define variable v-object-handle         as handle    no-undo .
      842     define variable v-frame-height          as decimal   no-undo .
      843     define variable v-frame-virtual-height  as decimal   no-undo .
      844     define variable v-browse-height         as decimal   no-undo .
      845     define variable v-window-height         as decimal   no-undo .
      846     define variable v-window-virtual-height as decimal   no-undo .
      847     define variable v-change-sign           as integer   no-undo .
      848     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      849     define buffer buf_temp-browse-handle  for temp-browse-handle .
      850     if p-change-value > 0
      851     then do:
      852       if frame Dialog-Frame :height + p-change-value
      853           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      854       then do:
      855         assign
      856           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      857                           - (frame Dialog-Frame :height-chars)
      858         .
      859         if p-change-value <= 0
      860         then do:
      861           run diasize_position-resize-button in this-procedure .
      862           return .
      863         end.
      864       end.
      865     end.
      866     if p-change-value < 0
      867     then do:
      868       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      869       then do:
      870         assign
      871           p-change-value = v-diasize-orig-frame-height
      872                          - (frame Dialog-Frame :height-chars)
      873         .
      874         if p-change-value >= 0
      875         then do:
      876           run diasize_position-resize-button in this-procedure .
      877           return .
      878         end.
      879       end.
      880     end.
      881     if p-change-value >= 0
      882     then do:
      883       assign
      884         v-change-sign = 1
      885       .
      886     end.
      887     else do:
      888       assign
      889         v-change-sign = -1
      890       .
