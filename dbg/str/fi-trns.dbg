     1506               undo move_block, retry move_block .
     1507             end.
     1508           end.
     1509         end.
     1510       end.
     1511       else do:
     1512         for each buf_temp-diasize-handle
     1513         on error undo move_block, retry move_block
     1514         :
     1515           assign
     1516             v-object-handle = buf_temp-diasize-handle.handle-value
     1517           .
     1518           if v-object-handle <> v-diasize-resize-button
     1519           then do:
     1520             assign
     1521               v-object-handle :col = v-object-handle :col + p-change-value
     1522               no-error .
     1523             if error-status :error
     1524             or error-status :get-message(1) <> ""
     1525             then do:
     1526               undo move_block, retry move_block .
     1527             end.
     1528           end.
     1529         end.
     1530         for each buf_temp-browse-handle
     1531           where buf_temp-browse-handle.browse-type = 'width':u
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             buf_temp-browse-handle.browse-handle :width
     1536               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1537             no-error .
     1538           if error-status :error
     1539           or error-status :get-message(1) <> ""
     1540           then do:
     1541             undo move_block, retry move_block .
     1542           end.
     1543         end.
     1544         assign
     1545           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1546           no-error .
     1547         if error-status :error
     1548         or error-status :get-message(1) <> ""
     1549         then do:
     1550           undo move_block, retry move_block.
     1551         end.
     1552         assign
     1553           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1554         no-error .
     1555         if error-status :error
     1556         or error-status :get-message(1) <> ""
     1557         then do:
     1558           undo move_block, retry move_block.
     1559         end.
     1560         if frame Dialog-Frame :scrollable = true
     1561         then do:
     1562           assign
     1563             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1564           no-error .
     1565           if error-status :error
     1566           or error-status :get-message(1) <> ""
     1567           then do:
     1568             undo move_block, retry move_block.
     1569           end.
     1570         end.
     1571       end.
     1572       if p-move-resize
     1573       then do:
     1574         run diasize_position-resize-button in this-procedure .
     1575       end.
     1576       if v-diasize-wndstore = true
     1577       then do:
     1578         if connected("ub") = true
     1579         then do:
     1580           define variable v-cntxt-db-num        as integer   no-undo .
     1581           define variable v-cntxt-userid        as character no-undo .
     1582           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1583                                             , OUTPUT v-cntxt-userid
     1584                                             ) .
     1585           run gbl/wndsizew.p
     1586             (input  v-cntxt-db-num
     1587             ,input  v-cntxt-userid
     1588             ,input  v-diasize-proc-name
     1589             ,input  'width':u
     1590             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1591             ) .
     1592         end.
     1593       end.
     1594     end.
     1595     assign
     1596       v-diasize-change-size = false
     1597     .
     1598   end procedure.
     1599   procedure diasize_set-width :
     1600     define input  parameter p-new-width  as decimal   no-undo .
     1601     define input  parameter p-move-resize as logical   no-undo .
     1602     do
     1603     on error undo, return error return-value
     1604     :
     1605       run diasize_change-width in this-procedure
     1606         (input  (p-new-width - frame Dialog-Frame :width)
     1607         ,input  p-move-resize
     1608         ) .
     1609     end.
     1610   end procedure.
     1611   procedure diasize_position-resize-button :
     1612     do with frame Dialog-Frame
     1613     :
     1614       hide v-diasize-resize-button .
     1615       assign
     1616         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1617                     - 1
     1618                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1619         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1620                     - 1
     1621                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1622       .
     1623       view v-diasize-resize-button .
     1624     end.
     1625   end procedure.
     1626   on alt-right anywhere
     1627   do:
     1628     run diasize_change-width in this-procedure
     1629       (input 1
     1630       ,input true
     1631       ) .
     1632     return no-apply .
     1633   end.
     1634   on alt-left anywhere
     1635   do:
     1636     run diasize_change-width in this-procedure
     1637       (input -1
     1638       ,input true
     1639       ) .
     1640     return no-apply .
     1641   end.
     1642   on alt-down anywhere
     1643   do:
     1644     run diasize_change-height in this-procedure
     1645       (input 1
     1646       ,input true
     1647       ) .
     1648     return no-apply .
     1649   end.
     1650   on alt-up anywhere
     1651   do:
     1652     run diasize_change-height in this-procedure
     1653       (input -1
     1654       ,input true
     1655       ) .
     1656     return no-apply .
     1657   end.
     1658   on alt-enter of frame Dialog-Frame
     1659   do:
     1660     run diasize_maximize in this-procedure
     1661       (input  ?
     1662       ).
     1663     return no-apply .
     1664   end.
     1665   procedure diasize_end-move :
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       define variable v-row-delta as decimal   no-undo .
     1670       define variable v-col-delta as decimal   no-undo .
     1671       define variable v-new-row as decimal   no-undo .
     1672       define variable v-new-col as decimal   no-undo .
     1673       assign
     1674         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1675         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1676       .
     1677       assign
     1678         v-row-delta = v-new-row - frame Dialog-Frame :height
     1679         v-col-delta = v-new-col - frame Dialog-Frame :width
     1680       .
     1681       run diasize_change-height in this-procedure
     1682         (input v-row-delta
     1683         ,input true
     1684         ) .
     1685       run diasize_change-width in this-procedure
     1686         (input v-col-delta
     1687         ,input true
     1688         ) .
     1689     end.
     1690   end procedure.
     1691   procedure diasize_maximize :
     1692     define input  parameter p-action as logical   no-undo .
     1693     do
     1694     on error undo, return error return-value
     1695     :
     1696       if p-action = ?
     1697       then do:
     1698         if v-diasize-need-maximize = true
     1699         then do:
     1700           assign
     1701             p-action = true
     1702           .
     1703         end.
     1704         else do:
     1705           assign
     1706             p-action = false
     1707           .
     1708         end.
     1709       end.
     1710       if p-action = true
     1711       then do:
     1712         run diasize_change-height in this-procedure
     1713           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1714               - frame Dialog-Frame :height-chars
     1715           ,input true
     1716           ) .
     1717         run diasize_change-width in this-procedure
     1718           (input session :width-chars
     1719               - frame Dialog-Frame :width-chars
     1720           ,input true
     1721           ) .
     1722         assign
     1723           v-diasize-need-maximize = false
     1724         .
     1725       end.
     1726       else do:
     1727         run diasize_change-width in this-procedure
     1728           (input v-diasize-orig-frame-width
     1729               - frame Dialog-Frame :width-chars
     1730           ,input true
     1731           ) .
     1732         run diasize_change-height in this-procedure
     1733           (input v-diasize-orig-frame-height
     1734               - frame Dialog-Frame :height-chars
     1735           ,input true
     1736           ) .
     1737         assign
     1738           v-diasize-need-maximize = true
     1739         .
     1740       end.
     1741     end.
     1742   end procedure.
     1743   procedure diasize_restore-orig-size :
     1744     do
     1745     on error undo, return error return-value
     1746     :
     1747       assign
     1748         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1749         v-diasize-current-frame-height = frame Dialog-Frame :height
     1750       .
     1751       run diasize_set-height in this-procedure
     1752         (input  v-diasize-orig-frame-height
     1753         ,input  true
     1754         ) .
     1755       run diasize_set-width in this-procedure
     1756         (input  v-diasize-orig-frame-width
     1757         ,input  true
     1758         ) .
     1759     end.
     1760   end procedure.
     1761   procedure diasize_restore-current-size :
     1762     do
     1763     on error undo, return error return-value
     1764     :
     1765       run diasize_set-height in this-procedure
     1766         (input  v-diasize-current-frame-height
     1767         ,input  true
     1768         ) .
     1769       run diasize_set-width in this-procedure
     1770         (input  v-diasize-current-frame-width
     1771         ,input  true
     1772         ) .
     1773     end.
     1774   end procedure.
     1775   procedure diasize_set-browse-handle :
     1776     define input  parameter p-browse-handle as handle   no-undo .
     1777     define buffer buf_temp-browse-handle for temp-browse-handle .
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       assign
     1782         v-diasize-browse-handle = p-browse-handle
     1783       .
     1784       for each buf_temp-browse-handle
     1785       on error undo, return error return-value
     1786       :
     1787         delete buf_temp-browse-handle .
     1788       end.
     1789     end.
     1790   end procedure.
     1791   procedure diasize_add_browse :
     1792     define input  parameter p-browse-type   as character no-undo .
     1793     define input  parameter p-browse-handle as handle    no-undo .
     1794     define buffer buf_temp-browse-handle for temp-browse-handle .
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       assign
     1799         v-diasize-browse-number = v-diasize-browse-number + 1
     1800       .
     1801       create buf_temp-browse-handle .
     1802       assign
     1803         buf_temp-browse-handle.browse-type   = p-browse-type
     1804         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1805         buf_temp-browse-handle.browse-handle = p-browse-handle
     1806       .
     1807     end.
     1808   end procedure.
     1809   procedure diasize_init :
     1810     define variable v-default-value    as logical   no-undo .
     1811     define variable v-restore-saved    as logical   no-undo .
     1812     define variable v-resize-value-str as character no-undo .
     1813     do
     1814     on error undo, return error return-value
     1815     :
     1816       do with frame Dialog-Frame
     1817       :
     1818         assign
     1819           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1820           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1821           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1822         .
     1823         create button v-diasize-resize-button
     1824         assign
     1825           parent        = frame Dialog-Frame :first-child
     1826           label         = "s"
     1827           height-pixels = 16
     1828           width-pixels  = 16
     1829           visible       = true
     1830           sensitive     = true
     1831           movable       = true
     1832           triggers:
     1833             on end-move persistent run diasize_end-move in this-procedure .
     1834           end triggers.
     1835         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1836         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1837         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1838         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1839         assign
     1840           v-diasize-wndmax = false
     1841         .
     1842         if connected("ub") = true
     1843         then do:
     1844           define variable v-cntxt-db-num        as integer   no-undo .
     1845           define variable v-cntxt-userid        as character no-undo .
     1846           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1847                                             , OUTPUT v-cntxt-userid
     1848                                             ) .
     1849           run gbl/wndpar_r.p
     1850             (input  v-cntxt-db-num
     1851             ,input  v-cntxt-userid
     1852             ,input  'wndmax':U
     1853             ,output v-diasize-wndmax
     1854             ,output v-default-value
     1855             ) .
     1856         end.
     1857         assign
     1858           v-diasize-wndstore = false
     1859         .
     1860         if connected("ub") = true
     1861         then do:
     1862           run gbl/wndpar_r.p
     1863             (input  v-cntxt-db-num
     1864             ,input  v-cntxt-userid
     1865             ,input  'wndstore':U
     1866             ,output v-diasize-wndstore
     1867             ,output v-default-value
     1868             ) .
     1869         end.
     1870         assign
     1871           v-diasize-proc-name = entry(1, program-name(2), '.')
     1872         .
     1873         if v-diasize-wndstore = true
     1874         then do:
     1875           assign
     1876             v-restore-saved = false
     1877           .
     1878           if connected("ub") = true
     1879           then do:
     1880             run gbl/wndsizer.p
     1881               (input  v-cntxt-db-num
     1882               ,input  v-cntxt-userid
     1883               ,input  v-diasize-proc-name
     1884               ,input  'height':u
     1885               ,output v-resize-value-str
     1886               ) .
     1887             if v-resize-value-str <> '':U
     1888             then do:
     1889               run diasize_change-height in this-procedure
     1890                 (input  integer(v-resize-value-str)
     1891                 ,input  true
     1892                 ) .
     1893               assign
     1894                 v-restore-saved = true
     1895               .
     1896             end.
     1897           end.
     1898           if connected("ub") = true
     1899           then do:
     1900             run gbl/wndsizer.p
     1901               (input  v-cntxt-db-num
     1902               ,input  v-cntxt-userid
     1903               ,input  v-diasize-proc-name
     1904               ,input  'width':u
     1905               ,output v-resize-value-str
     1906               ) .
     1907             if v-resize-value-str <> '':U
     1908             then do:
     1909               run diasize_change-width in this-procedure
     1910                 (input  integer(v-resize-value-str)
     1911                 ,input  true
     1912                 ) .
     1913               assign
     1914                 v-restore-saved = true
     1915               .
     1916             end.
     1917           end.
     1918           if v-restore-saved <> true
     1919           then do:
     1920             if v-diasize-wndmax = true
     1921             then do:
     1922               run diasize_maximize in this-procedure
     1923                 (input  true
     1924                 ) .
     1925             end.
     1926           end.
     1927         end.
     1928         else do:
     1929           if v-diasize-wndmax = true
     1930           then do:
     1931             run diasize_maximize in this-procedure
     1932               (input  true
     1933               ) .
     1934           end.
     1935         end.
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure diasize_need-full-display :
     1940     define output parameter p-need-full-display as logical   no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944       assign
     1945         p-need-full-display = v-diasize-need-full-display
     1946       .
     1947       assign
     1948         v-diasize-need-full-display = false
     1949       .
     1950     end.
     1951   end procedure.
     1952   procedure get-context :
     1953      define output parameter p-db-num as integer          no-undo.
     1954      define output parameter p-user-id as character        no-undo.
     1955      define variable v-login               as character    no-undo.
     1956      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1957      define buffer buf_user-login  for ub.user-login .
     1958      do
     1959      on error undo, return error
     1960      :
     1961            FIND FIRST buf_sys-ctrl no-lock.
     1962            ASSIGN
     1963               v-login = USERID("ub")
     1964               p-db-num = buf_sys-ctrl.db-num
     1965            .
     1966            FIND FIRST buf_user-login
     1967                 WHERE buf_user-login.db-num = p-db-num
     1968                   AND buf_user-login.user-login = v-login
     1969                 no-lock
     1970                 no-error
     1971                 .
     1972            IF AVAILABLE buf_user-login
     1973            THEN DO:
     1974               assign
     1975                  p-user-id = buf_user-login.user-id
     1976               .
     1977            END.
     1978      end.
     1979   end procedure.
     1980       run diasize_init in this-procedure .
     1981   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1982     run mainmenu_getcntxt in parparentproc
     1983       (output v-cntxt-db-num
     1984       ,output v-cntxt-userid
     1985       ,output v-cntxt-level
     1986       ,output v-cntxt-host-code-obj
     1987       ,output v-cntxt-obj-type
     1988       ,output v-cntxt-obj-code
     1989       ,output v-cntxt-db-num-obj
     1990       ,output v-cntxt-is-admin
     1991       ) .
     1992   MAIN-BLOCK:
     1993   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1994      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1995     FILL-IN_sum-rubl:label = "Сумма (руб)" .
     1996     case p-mode :
     1997       when "all":U then do:
     1998         message "НЕ РЕАЛИЗОВАНО".
     1999         return .
     2000       end.
     2001       when "fin-ob":U then do:
     2002          RUN enable_UI.
     2003       end.
     2004       when "trn-doc":U then do:
     2005          RUN enable-my.
     2006       end.
     2007       when "order":U then do:
     2008          RUN enable-my-order.
     2009       end.
     2010       when "rcv":U then do:
     2011          RUN enable-my-rcv.
     2012       end.
     2013       when "add":U then do:
     2014          RUN enable-my-add.
     2015       end.
     2016     end case.
     2017     apply "VALUE-CHANGED" TO BROWSE-1 IN FRAME  Dialog-Frame.
     2018     WAIT-FOR GO OF FRAME Dialog-Frame.
     2019   END.
     2020   RUN disable_UI.
     2021   PROCEDURE disable_UI :
     2022     HIDE FRAME Dialog-Frame.
     2023   END PROCEDURE.
     2024   PROCEDURE enable-my :
     2025    do
     2026    on error undo, return error return-value
     2027    :
     2028     DISPLAY FILL-IN-1 FILL-IN_prn-doc-code FILL-IN_status_ FILL-IN_user-name-doc
     2029             FILL-IN_fin-doc-type FILL-IN_user-name-fact FILL-IN_doc-date
     2030             FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code FILL-IN_sum-doc
     2031             FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code FILL-IN_doc-type
     2032             FILL-IN_contract-type FILL-IN_usl-opl FILL-IN_srok-opl FILL-IN-sr-op
     2033         WITH FRAME Dialog-Frame.
     2034     ENABLE B-exit B-lkp B-lkp-2 B-lkp-3 B-Help BROWSE-1 FILL-IN-1
     2035            FILL-IN_prn-doc-code FILL-IN_status_ FILL-IN_user-name-doc
     2036            FILL-IN_fin-doc-type FILL-IN_user-name-fact FILL-IN_doc-date
     2037            FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code FILL-IN_sum-doc
     2038            FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code FILL-IN_doc-type
     2039            FILL-IN_contract-type FILL-IN_usl-opl FILL-IN_srok-opl FILL-IN-sr-op
     2040         WITH FRAME Dialog-Frame.
     2041     VIEW FRAME Dialog-Frame.
     2042    ASSIGN
     2043    frame Dialog-Frame:TITLE = "Фин. обязательства по накладной: " +  p-fin-ob-trn-doc
     2044    .
     2045    OPEN QUERY BROWSE-1 FOR EACH fin-ob-trn
     2046         WHERE fin-ob-trn.trn-doc-code = p-fin-ob-trn-doc   AND ub.fin-ob-trn.doc-type  = ""  NO-LOCK,
     2047         EACH trn-doc WHERE trn-doc.doc-code = fin-ob-trn.trn-doc-code   OUTER-JOIN NO-LOCK,
     2048         EACH c-trn-doc WHERE c-trn-doc.is-del = yes and  c-trn-doc.doc-code = fin-ob-trn.trn-doc-code  OUTER-JOIN NO-LOCK,
     2049         first ord-doc OUTER-JOIN no-lock ,
     2050         first add-doc OUTER-JOIN no-lock ,
     2051         first ord-doc-rcv OUTER-JOIN no-lock .
     2052     end.
     2053   END PROCEDURE.
     2054   PROCEDURE enable-my-order :
     2055    do
     2056    on error undo, return error return-value
     2057    :
     2058     DISPLAY FILL-IN-1 FILL-IN_prn-doc-code FILL-IN_status_ FILL-IN_user-name-doc
     2059             FILL-IN_fin-doc-type FILL-IN_user-name-fact FILL-IN_doc-date
     2060             FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code FILL-IN_sum-doc
     2061             FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code FILL-IN_doc-type
     2062             FILL-IN_contract-type FILL-IN_usl-opl FILL-IN_srok-opl FILL-IN-sr-op
     2063         WITH FRAME Dialog-Frame.
     2064     ENABLE B-exit B-lkp B-lkp-2 B-lkp-3 B-Help BROWSE-1 FILL-IN-1
     2065            FILL-IN_prn-doc-code FILL-IN_status_ FILL-IN_user-name-doc
     2066            FILL-IN_fin-doc-type FILL-IN_user-name-fact FILL-IN_doc-date
     2067            FILL-IN_fact-date FILL-IN_pay-date FILL-IN_curr-code FILL-IN_sum-doc
     2068            FILL-IN_sum-rubl FILL-IN-2 FILL-IN_contract-prn-code FILL-IN_doc-type
     2069            FILL-IN_contract-type FILL-IN_usl-opl FILL-IN_srok-opl FILL-IN-sr-op
     2070         WITH FRAME Dialog-Frame.
     2071     VIEW FRAME Dialog-Frame.
     2072    ASSIGN
     2073    frame Dialog-Frame:TITLE = "Фин. обязательства по заказу: " +  p-fin-ob-trn-doc
