        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-parent-handle as handle no-undo .
        4   define input  parameter p-log-handle  as handle no-undo .
        5   define input  parameter p-process    as character no-undo .
        6   define input  parameter p-profile-id as integer   no-undo .
        7   define input  parameter p-codex-id as integer   no-undo .
        8   define input  parameter p-ruleset-id as integer   no-undo .
        9   define input  parameter p-db-num like ub.db.db-num no-undo .
       10   define input  parameter p-uniq-key-rec as character no-undo .
       11   define input  parameter p-doc-code as character no-undo .
       12   define input  parameter p-plt-id as integer no-undo .
       13   define input  parameter p-plt-db-num as integer no-undo .
       14   define input  parameter p-pdf-id as integer no-undo .
       15   define input  parameter p-pdf-db-num as integer no-undo .
       16   define input  parameter p-save        as logical no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":u .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
       20   define variable vss-workfile    as character no-undo init "$Workfile: pdfrum.p $":u .
       21   define variable vss-archive     as character no-undo init "$Archive: str/pdfrum.p $":u .
       22   define variable vss-description as character no-undo init "Вызов процедур RUM для обработки операций по ДНЦ и переоценкам" .
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41       assign
       42         p-vss-parameters = substitute('&1|&2|&3':u
       43                                 ,p-process
       44                                 ,p-db-num
       45                                 ,p-plt-id
       46                                 ,p-plt-db-num
       47                                 ,p-pdf-id
       48                                 ,p-pdf-db-num
       49                                 )
       50       .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   define new global shared variable g#library  as handle no-undo .
       92   define new global shared variable g#library2 as handle no-undo .
       93   define   shared variable g#auto as logical no-undo.
       94   define   shared variable g#news as logical no-undo.
       95   define   shared variable g#oxml as logical no-undo.
       96   define   shared variable g#esys as logical no-undo.
       97   define   shared variable g#news-source-db as integer no-undo.
       98   define   shared variable g#esys-source-esys as integer no-undo.
       99   define   shared variable g#db-num as integer   no-undo .
      100   define   shared variable g#userid as character no-undo .
      101   define   shared variable g#passwd as character no-undo .
      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103     define variable v-cntxt-db-num        as integer   no-undo .
      104     define variable v-cntxt-userid        as character no-undo .
      105     define variable v-cntxt-level         as character no-undo .
      106     define variable v-cntxt-host-code-obj as integer   no-undo .
      107     define variable v-cntxt-obj-type      as character no-undo .
      108     define variable v-cntxt-obj-code      as integer   no-undo .
      109     define variable v-cntxt-db-num-obj    as integer   no-undo .
      110     define variable v-cntxt-is-admin      as logical   no-undo .
      111   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define   temp-table temp-pers-proc no-undo
      113   field proc-name as character
      114   field vproc-handle as handle
      115   field vparent-handle as handle
      116   field user-name as character
      117   field id as integer
      118   field vpar as character
      119   field rank-to-delete as integer
      120   index pi is unique primary
      121   proc-name
      122   id
      123   index puser
      124   proc-name
      125   user-name
      126   index ppar
      127   proc-name
      128   vpar
      129   index iparent
      130   vparent-handle
      131   proc-name
      132   index iid
      133   id
      134   index ird
      135   rank-to-delete
      136   .
      137   define variable v-per-proc-num as integer no-undo .
      138   procedure perproc-create-proc :
      139   define input  parameter p-parent-handle as handle no-undo .
      140   define input  parameter p-proc-name as character no-undo .
      141   define input  parameter p-proc-handle  as handle no-undo .
      142   define input  parameter p-run        as logical no-undo .
      143   define input  parameter p-parameter as character no-undo .
      144   define input  parameter p-userid as character no-undo .
      145   define input  parameter p-rank-to-delete as integer no-undo .
      146   define output parameter p-id as integer   no-undo .
      147   define variable ii as integer   no-undo .
      148   define variable v-proc-handle as handle no-undo .
      149   define buffer buf_temp-pers-proc for temp-pers-proc.
      150   define buffer buf0_temp-pers-proc for temp-pers-proc.
      151     do
      152     on error undo, return error return-value
      153     :
      154       if v-per-proc-num > 100 then return error '>'.
      155       find first buf0_temp-pers-proc no-lock where
      156                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
      157       if not available buf0_temp-pers-proc then do:
      158         if p-run then do:
      159           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
      160           if error-status :error then undo, return error return-value .
      161         end.
      162         else v-proc-handle = p-proc-handle.
      163         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
      164         create buf_temp-pers-proc.
      165         assign
      166         buf_temp-pers-proc.proc-name = p-proc-name
      167         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
      168                                   then  0
      169                                   else buf0_temp-pers-proc.id + 1)
      170         buf_temp-pers-proc.user-name = p-userid
      171         buf_temp-pers-proc.vpar      = p-parameter
      172         buf_temp-pers-proc.vparent-handle = p-parent-handle
      173         buf_temp-pers-proc.vproc-handle = v-proc-handle
      174         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
      175         p-id = buf_temp-pers-proc.id
      176         v-per-proc-num = v-per-proc-num + 1
      177         .
      178       end.
      179       else p-id = buf0_temp-pers-proc.id.
      180     end.
      181   end procedure.
      182   procedure perproc-delete-proc-user :
      183   define input  parameter p-proc-name as character no-undo .
      184   define input  parameter p-user-name as character no-undo .
      185   define buffer buf_temp-pers-proc for temp-pers-proc.
      186     do
      187     on error undo, return error return-value
      188     :
      189        for each buf_temp-pers-proc where
      190               buf_temp-pers-proc.proc-name = p-proc-name
      191          AND  buf_temp-pers-proc.user-name = p-user-name:
      192           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      193           delete procedure buf_temp-pers-proc.vproc-handle.
      194           delete buf_temp-pers-proc.
      195           v-per-proc-num = v-per-proc-num - 1.
      196        end.
      197     end.
      198   end procedure.
      199   procedure perproc-delete-proc-id :
      200   define input  parameter p-id        as integer   no-undo .
      201   define buffer buf_temp-pers-proc for temp-pers-proc.
      202     do
      203     on error undo, return error return-value
      204     :
      205        for each buf_temp-pers-proc where
      206           buf_temp-pers-proc.id        = p-id:
      207           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      208           delete procedure buf_temp-pers-proc.vproc-handle.
      209           delete buf_temp-pers-proc.
      210           v-per-proc-num = v-per-proc-num - 1.
      211        end.
      212     end.
      213   end procedure.
      214   procedure perproc-delete-by-rank :
      215   define buffer buf_temp-pers-proc for temp-pers-proc.
      216     do
      217     on error undo, return error return-value
      218     :
      219       for each buf_temp-pers-proc where
      220       by buf_temp-pers-proc.rank-to-delete:
      221         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      222         delete procedure buf_temp-pers-proc.vproc-handle.
      223         delete buf_temp-pers-proc.
      224         v-per-proc-num = v-per-proc-num - 1.
      225       end.
      226     end.
      227   end procedure.
      228   procedure perproc-delete-proc-name-id :
      229   define input  parameter p-proc-name as character no-undo .
      230   define input  parameter p-id        as integer   no-undo .
      231   define buffer buf_temp-pers-proc for temp-pers-proc.
      232     do
      233     on error undo, return error return-value
      234     :
      235        for each buf_temp-pers-proc where
      236               buf_temp-pers-proc.proc-name = p-proc-name
      237          AND  buf_temp-pers-proc.id        = p-id:
      238           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      239           delete procedure buf_temp-pers-proc.vproc-handle.
      240           delete buf_temp-pers-proc.
      241           v-per-proc-num = v-per-proc-num - 1.
      242        end.
      243     end.
      244   end procedure.
      245   procedure perproc-delete-par :
      246   define input  parameter p-proc-name as character no-undo .
      247   define input  parameter p-parameter as character no-undo .
      248   define buffer buf_temp-pers-proc for temp-pers-proc.
      249     do
      250     on error undo, return error return-value
      251     :
      252        for each buf_temp-pers-proc where
      253               buf_temp-pers-proc.proc-name = p-proc-name
      254          AND  buf_temp-pers-proc.vpar      = p-parameter:
      255           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      256           delete procedure buf_temp-pers-proc.vproc-handle.
      257           delete buf_temp-pers-proc.
      258           v-per-proc-num = v-per-proc-num - 1.
      259        end.
      260     end.
      261   end procedure.
      262   procedure perproc-delete-from-parent :
      263   define input  parameter p-parent-handle as handle no-undo .
      264   define input  parameter p-proc-name as character no-undo .
      265   define buffer buf_temp-pers-proc for temp-pers-proc.
      266     do
      267     on error undo, return error return-value
      268     :
      269        if p-proc-name = "":u then do:
      270         for each buf_temp-pers-proc where
      271            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      272             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      273             delete procedure buf_temp-pers-proc.vproc-handle.
      274             delete buf_temp-pers-proc.
      275             v-per-proc-num = v-per-proc-num - 1.
      276         end.
      277        end.
      278        else do:
      279         for each buf_temp-pers-proc where
      280                 buf_temp-pers-proc.proc-name = p-proc-name
      281           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      282             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      283             delete procedure buf_temp-pers-proc.vproc-handle.
      284             delete buf_temp-pers-proc.
      285             v-per-proc-num = v-per-proc-num - 1.
      286         end.
      287       end.
      288     end.
      289   end procedure.
      290   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   define new global shared variable g#lib-nws as handle no-undo .
      292   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293   procedure gen-key-rec :
      294     define input  parameter p-tbl-name    as character no-undo.
      295     define input  parameter p-bh_tbl-name as handle    no-undo.
      296     define output parameter p-key-rec     as character no-undo.
      297     do
      298     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      299     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      300     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      301     :
      302       define variable fh               as handle    no-undo .
      303       define variable v-ok             as logical   no-undo .
      304       define variable v-inform         as character no-undo .
      305       define variable v-ind            as integer   no-undo .
      306       define variable v-idx-field-qnty as integer   no-undo .
      307       if p-tbl-name = ?
      308         or p-tbl-name = "":U
      309       then do:
      310         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      311       end.
      312       if not p-bh_tbl-name:available then do:
      313         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      314       end.
      315       assign
      316         p-key-rec = p-tbl-name
      317         v-inform  = p-bh_tbl-name:index-information(1)
      318         v-ind     = 2
      319       .
      320       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      321       on error undo, return error
      322       :
      323         assign
      324           v-inform = p-bh_tbl-name:index-information( v-ind )
      325           v-ind    = v-ind + 1
      326         .
      327       end.
      328       if v-inform = ?
      329         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      330         or entry( 3, v-inform, ",":U ) <> "1":U
      331       then do:
      332         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      333       end.
      334       else do:
      335         assign
      336           v-idx-field-qnty = num-entries( v-inform ) - 4
      337         .
      338         if v-idx-field-qnty < 2 then do:
      339           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      340         end.
      341         do v-ind = 1 to v-idx-field-qnty by 2
      342         on error undo, return error
      343         :
      344           assign
      345             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      346             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      347           .
      348         end.
      349       end.
      350       if p-key-rec = ? then do:
      351         assign
      352           p-key-rec = "":U
      353         .
      354         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      355       end.
      356     end.
      357     return.
      358   end procedure.
      359   procedure gen-where-keyr-tab :
      360     define input  parameter i-tableSerach as character no-undo.
      361     define input  parameter i-tablekey   as character  no-undo.
      362     define input  parameter p-key-rec    as character  no-undo.
      363     define input  parameter p-key-handle as handle     no-undo .
      364     define input  parameter p-db-name    as character  no-undo .
      365     define input  parameter p-tt-handle  as handle     no-undo .
      366     define output parameter o-Where      as character  no-undo.
      367     do
      368     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      369     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      370     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      371     :
      372       define variable v-full-tbl-name  as character no-undo .
      373       define variable bh_tbl-name      as handle    no-undo .
      374       define variable fh_key           as handle    no-undo .
      375       define variable fh_search        as handle    no-undo .
      376       define variable v-field-num      as integer   no-undo .
      377       define variable v-count-fld      as integer   no-undo .
      378       define variable v-inform         as character no-undo .
      379       define variable v-ind            as integer   no-undo .
      380       define variable v-idx-field-qnty as integer   no-undo .
      381       define variable v-field-name     as character no-undo .
      382       define variable v-field-val      as character no-undo .
      383       define variable v-word-link      as character no-undo .
      384       define variable vTable           as character no-undo.
      385       define variable bh_tbl-key       as handle    no-undo .
      386       assign
      387         p-key-rec = trim( p-key-rec )
      388       .
      389       if p-key-handle <> ? then do:
      390         if not valid-handle(p-key-handle)
      391            or p-key-handle:type <> "buffer"
      392         then do:
      393           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      394         end.
      395         if num-entries( p-key-rec, chr(3) ) > 1
      396           or p-key-rec = ?
      397           or p-key-rec = "":U
      398         then do:
      399           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      400         end.
      401       end.
      402       else do:
      403         if p-key-rec = ?
      404           or p-key-rec = "":U
      405         then do:
      406           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      407         end.
      408       end.
      409       assign
      410         vTable = entry( 1 , p-key-rec, chr(3) )
      411       .
      412       if p-tt-handle <> ?
      413         and ( not valid-handle(p-tt-handle)
      414               or p-tt-handle:type <> "buffer"
      415             )
      416       then do:
      417         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      418       end.
      419       if p-tt-handle = ? then do:
      420         assign
      421           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      422         .
      423         create buffer bh_tbl-name for table v-full-tbl-name .
      424       end.
      425       else do:
      426         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      427       end.
      428       assign
      429         v-inform = bh_tbl-name:index-information(1)
      430         v-ind    = 2
      431       .
      432       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      433       on error undo, return error
      434       :
      435         assign
      436           v-inform = bh_tbl-name:index-information( v-ind )
      437           v-ind    = v-ind + 1
      438         .
      439       end.
      440       if v-inform = ?
      441         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      442         or entry( 3, v-inform, ",":U ) <> "1":U
      443       then do:
      444         delete object bh_tbl-name no-error.
      445         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      446       end.
      447       assign
      448         v-idx-field-qnty = num-entries( v-inform ) - 4
      449       .
      450       if v-idx-field-qnty < 2 then do:
      451         delete object bh_tbl-name no-error.
      452         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      453       end.
      454       assign
      455         o-where     = "where":U
      456         v-word-link = "":U
      457         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      458         v-count-fld = 0
      459       .
      460       if i-tablekey ne "" and i-tablekey ne ?
      461       then do:
      462         assign
      463           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      464         .
      465         create buffer bh_tbl-key for table v-full-tbl-name .
      466       end.
      467       if i-tableSerach ne "" and i-tableSerach ne ?
      468       then do:
      469         delete object bh_tbl-name no-error.
      470         assign
      471           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      472         .
      473         create buffer bh_tbl-name for table v-full-tbl-name .
      474       end.
      475       block_where:
      476       do v-ind = 1 to v-idx-field-qnty by 2
      477       on error undo, return error
      478       :
      479         assign
      480           v-count-fld = v-count-fld + 1
      481         .
      482         if p-key-handle = ?
      483           and v-count-fld > v-field-num
      484         then do:
      485           leave block_where.
      486         end.
      487         define variable VfieldKeyTable as handle no-undo.
      488         assign
      489           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      490           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      491         .
      492         if     bh_tbl-key ne ?
      493         then do:
      494            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      495            if VfieldKeyTable eq ?
      496            then next block_where.
      497         end.
      498         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      499         then
      500            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      501         else
      502            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      503         if p-key-handle = ? then do:
      504           assign
      505             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      506           .
      507         end.
      508         else do:
      509           assign
      510             fh_key = p-key-handle:buffer-field( v-field-name )
      511           .
      512           if fh_key = ?
      513             or not valid-handle( fh_key )
      514           then do:
      515             delete object bh_tbl-name.
      516             if     bh_tbl-key ne ?
      517             then
      518                delete object bh_tbl-key.
      519             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      520           end.
      521           assign
      522             v-field-val = fh_key:buffer-value
      523           .
      524         end.
      525         if fh_search:data-type ="character":U then do:
      526           assign
      527             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      528             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      529             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      530             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      531             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      532             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      533             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      534             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      535             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      536             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      537             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      538             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      539             v-field-val = substitute( '"&1"', v-field-val )
      540           .
      541         end.
      542         assign
      543           o-where = substitute( "&1 &2", o-where, v-field-val )
      544         .
      545         if v-word-link = "":U then do:
      546           assign
      547             v-word-link = "and":U
      548           .
      549         end.
      550       end.
      551       delete object bh_tbl-name.
      552       if     bh_tbl-key ne ?
      553       then
      554          delete object bh_tbl-key.
      555       if p-key-handle = ?
      556         and v-count-fld <> v-field-num
      557       then do:
      558         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      559       end.
      560     end.
      561   end procedure.
      562   procedure gen-hn-keyr-tab :
      563     define input  parameter i-tableSerach as character no-undo.
      564     define input  parameter i-tablekey   as character no-undo.
      565     define input  parameter p-key-rec    as character no-undo.
      566     define input  parameter p-key-handle as handle    no-undo .
      567     define input  parameter p-db-name    as character no-undo .
      568     define input  parameter p-tt-handle  as handle    no-undo .
      569     define input  parameter p-stts-lock  as integer   no-undo .
      570     define output parameter o-hn         as handle    no-undo.
      571     define variable v-full-tbl-name as character no-undo.
      572     define variable v-where         as character no-undo.
      573     define variable bh_tbl-name     as handle    no-undo.
      574     define variable vTable          as character no-undo.
      575     do
      576     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      577     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      578     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      579         run gen-where-keyr-tab(i-tableSerach,
      580                                i-tablekey,
      581                                p-key-rec,
      582                                p-key-handle,
      583                                p-db-name,
      584                                p-tt-handle,
      585                                output v-where).
      586         if i-tableSerach ne "" and i-tableSerach ne ?
      587         then do:
      588            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      589            create buffer bh_tbl-name for table v-full-tbl-name .
      590         end.
      591         else do:
      592            if p-tt-handle = ? then do:
      593               assign
      594                  vTable = entry( 1 , p-key-rec, chr(3) )
      595               .
      596               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      597               create buffer bh_tbl-name for table v-full-tbl-name .
      598            end.
      599            else do:
      600               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      601            end.
      602         end.
      603         if p-tt-handle = ? then do:
      604            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      605         end.
      606         else do:
      607            bh_tbl-name:find-first( v-where ) no-error .
      608         end.
      609         o-hn = bh_tbl-name.
      610      end.
      611   end procedure.
      612   procedure gen-hn-keyr :
      613     define input  parameter p-key-rec    as character no-undo.
      614     define input  parameter p-key-handle as handle    no-undo .
      615     define input  parameter p-db-name    as character no-undo .
      616     define input  parameter p-tt-handle  as handle    no-undo .
      617     define input  parameter p-stts-lock  as integer   no-undo .
      618     define output parameter o-hn         as handle    no-undo.
      619     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      620   end.
      621   procedure gen-row-keyr :
      622     define input  parameter p-key-rec    as character no-undo.
      623     define input  parameter p-key-handle as handle    no-undo .
      624     define input  parameter p-db-name    as character no-undo .
      625     define input  parameter p-tt-handle  as handle    no-undo .
      626     define input  parameter p-stts-lock  as integer   no-undo .
      627     define output parameter p-tbl-row    as rowid     no-undo.
      628     define output parameter p-tbl-name   as character no-undo.
      629     define variable vHn as handle no-undo.
      630       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      631       p-tbl-row = if vHn:available then vHn:rowid else ?.
      632       p-tbl-name =  vHn:table.
      633       delete object vHn no-error.
      634     if p-tbl-row = ? then do:
      635       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      636     end.
      637     else do:
      638       return.
      639     end.
      640   end procedure.
      641   procedure gen-key-fv :
      642     define input  parameter p-key-rec    as character no-undo .
      643     define output parameter p-field-list as character no-undo .
      644     define output parameter p-value-list as character no-undo.
      645     do
      646     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      647     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      648     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      649     :
      650       define variable v-full-tbl-name  as character no-undo .
      651       define variable bh_tbl-name      as handle    no-undo .
      652       define variable v-tbl-name       as character no-undo .
      653       define variable v-field-num      as integer   no-undo .
      654       define variable v-count-fld      as integer   no-undo .
      655       define variable v-inform         as character no-undo .
      656       define variable v-ind            as integer   no-undo .
      657       define variable v-idx-field-qnty as integer   no-undo .
      658       define variable v-delim-key      as character no-undo .
      659       if p-key-rec = ?
      660         or p-key-rec = "":U
      661       then do:
      662         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      663       end.
      664       assign
      665         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      666         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      667       .
      668       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      669       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      670       assign
      671         v-inform = bh_tbl-name:index-information(1)
      672         v-ind    = 2
      673       .
      674       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      675       on error undo, return error
      676       :
      677         assign
      678           v-inform = bh_tbl-name:index-information( v-ind )
      679           v-ind    = v-ind + 1
      680         .
      681       end.
      682       if v-inform = ?
      683         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      684         or entry( 3, v-inform, ",":U ) <> "1":U
      685       then do:
      686         delete object bh_tbl-name no-error.
      687         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      688       end.
      689       assign
      690         v-idx-field-qnty = num-entries( v-inform ) - 4
      691       .
      692       if v-idx-field-qnty < 2 then do:
      693         delete object bh_tbl-name no-error.
      694         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      695       end.
      696       assign
      697         p-field-list = "":U
      698         p-value-list = "":U
      699         v-delim-key  = "":U
      700         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      701         v-count-fld  = 0
      702       .
      703       block_where:
      704       do v-ind = 1 to v-idx-field-qnty by 2
      705       on error undo, return error
      706       :
      707         assign
      708           v-count-fld = v-count-fld + 1
      709         .
      710         if v-count-fld > v-field-num then do:
      711           leave block_where.
      712         end.
      713         assign
      714           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      715           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      716         .
      717         if v-ind = 1 then do:
      718           assign
      719             v-delim-key = chr(3)
      720           .
      721         end.
      722       end.
      723       delete object bh_tbl-name.
      724       if v-count-fld <> v-field-num then do:
      725         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      726       end.
      727     end.
      728   end procedure.
      729   procedure gen-key-field :
      730     define input  parameter p-table      as character no-undo .
      731     define output parameter p-field-list as character no-undo .
      732     do
      733     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      734     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      735     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      736     :
      737       define variable v-full-tbl-name  as character no-undo .
      738       define variable bh_tbl-name      as handle    no-undo .
      739       define variable v-tbl-name       as character no-undo .
      740       define variable v-field-num      as integer   no-undo .
      741       define variable v-count-fld      as integer   no-undo .
      742       define variable v-inform         as character no-undo .
      743       define variable v-ind            as integer   no-undo .
      744       define variable v-idx-field-qnty as integer   no-undo .
      745       define variable v-delim-key      as character no-undo .
      746       if p-table = ?
      747         or p-table = "":U
      748       then do:
      749         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      750       end.
      751       assign
      752         v-tbl-name      = p-table
      753         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      754       .
      755       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      756       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      757       assign
      758         v-inform = bh_tbl-name:index-information(1)
      759         v-ind    = 2
      760       .
      761       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      762       on error undo, return error
      763       :
      764         assign
      765           v-inform = bh_tbl-name:index-information( v-ind )
      766           v-ind    = v-ind + 1
      767         .
      768       end.
      769       if v-inform = ?
      770         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      771         or entry( 3, v-inform, ",":U ) <> "1":U
      772       then do:
      773         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      774       end.
      775       assign
      776         v-idx-field-qnty = num-entries( v-inform ) - 4
      777       .
      778       if v-idx-field-qnty < 2 then do:
      779         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      780       end.
      781       assign
      782         p-field-list = "":U
      783         v-delim-key  = "":U
      784         v-count-fld  = 0
      785       .
      786       block_where:
      787       do v-ind = 1 to v-idx-field-qnty by 2
      788       on error undo, return error
      789       :
      790         assign
      791           v-count-fld = v-count-fld + 1
      792         .
      793         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      794         if v-ind = 1 then do:
      795           assign
      796             v-delim-key = chr(3)
      797           .
      798         end.
      799       end.
      800       delete object bh_tbl-name.
      801     end.
      802   end procedure.
      803   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   procedure cur-time :
      805      define output parameter p-today as date      no-undo .
      806      define output parameter p-time  as integer   no-undo .
      807     do
      808     on error undo, return error
      809     :
      810       define variable v-date1 as date      no-undo .
      811       define variable v-date2 as date      no-undo .
      812       define variable v-time  as integer   no-undo .
      813       assign
      814         v-date1 = today
      815         v-time  = time
      816         v-date2 = today
      817       .
      818       if v-date1 <> v-date2
      819       then do:
      820         assign
      821           v-date1 = today
      822           v-time  = v-time
      823         .
      824       end.
      825       assign
      826         p-today = v-date1
      827         p-time  = v-time
      828       .
      829     end.
      830   end.
      831   function cur-time-date returns character
      832   :
      833     return string(today, '99/99/9999':U) .
      834   end.
      835   function cur-time-mjd returns decimal
      836   :
      837     define variable v-date as date      no-undo .
      838     define variable v-time as integer   no-undo .
      839     run cur-time in this-procedure
      840       (output v-date
      841       ,output v-time
      842       ) .
      843     return integer(v-date) - 2400002 + (v-time / 86400) .
      844   end.
      845   function cur-time-get-ending-index returns integer
      846   (input p-number as integer
      847   )
      848   :
      849     if p-number < 0
      850     or p-number = ?
      851     then do:
      852       return 1 .
      853     end.
      854     define variable v-rest as integer   no-undo .
      855     assign
      856       p-number = p-number modulo 100
      857     .
      858     if p-number < 20
      859     then do:
      860       assign
      861         v-rest = p-number
      862       .
      863     end.
      864     else do:
      865       assign
      866         v-rest = p-number modulo 10
      867       .
      868     end.
      869     case v-rest :
      870       when 1
      871       then do:
      872         return 2 .
      873       end.
      874       when 2 or
      875       when 3 or
      876       when 4
      877       then do:
      878         return 3 .
      879       end.
      880       otherwise do:
      881         return 1 .
      882       end.
      883     end case .
      884   end.
      885   procedure cur-time-mjd-to-date :
      886      define input  parameter i-mjd-diff as decimal no-undo.
      887      define output parameter o-Date     as date    no-undo.
      888      define output parameter o-Time     as integer no-undo.
      889      define variable v-day-number as integer   no-undo .
      890      if    i-mjd-diff < 0
      891         or i-mjd-diff = ?
      892      then do:
      893         return "?" .
      894      end.
      895      assign
      896         v-day-number = truncate(i-mjd-diff,0).
      897         o-Date = date(v-day-number + 2400002).
      898         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      899     .
      900   end.
      901   function cur-time-mjd-to-string returns character
      902   (input p-mjd-diff as decimal
      903   )
      904   :
      905     define variable v-day-number as integer   no-undo .
      906     define variable v-seconds    as integer   no-undo .
      907     define variable v-hour       as integer   no-undo .
      908     define variable v-min        as integer   no-undo .
      909     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      910     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      911     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      912     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      913     if p-mjd-diff < 0
      914     or p-mjd-diff = ?
      915     then do:
      916       return "?" .
      917     end.
      918     assign
      919       v-day-number = integer(truncate(p-mjd-diff,0))
      920       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      921     .
      922     if v-seconds > 86400
      923     then do:
      924       assign
      925         v-seconds = 86400 - 1
      926       .
      927     end.
      928     if v-seconds < 0
      929     then do:
      930       assign
      931         v-seconds = 0
      932       .
      933     end.
      934     assign
      935       v-hour = truncate(v-seconds / 3600, 0)
      936     .
      937     assign
      938       v-seconds = v-seconds modulo 3600
      939     .
      940     assign
      941       v-min = truncate(v-seconds / 60, 0)
      942     .
      943     assign
      944       v-seconds = v-seconds modulo 60
      945     .
      946     return
      947         (if v-day-number <> 0
      948           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      949           else ""
      950         )
      951       + (if v-day-number <> 0 or v-hour <> 0
      952           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      953           else ""
      954         )
      955       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      956           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      957           else ""
      958         )
      959       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      960       .
      961   end.
      962   function cur-time-string returns character
      963   :
      964     define variable v-date as date      no-undo .
      965     define variable v-time as integer   no-undo .
      966     run cur-time in this-procedure
      967       (output v-date
      968       ,output v-time
      969       ) .
      970     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      971   end.
      972   function cur-time-string-sec returns character
      973   :
      974     define variable v-date as date      no-undo .
      975     define variable v-time as integer   no-undo .
      976     run cur-time in this-procedure
      977       (output v-date
      978       ,output v-time
      979       ) .
      980     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      981   end.
      982   function cur-time-custom  returns character
      983   (input p-prefix as character
      984   ,input p-date-format as character
      985   ,input p-delimiter as character
      986   ,input p-time-format as character
      987   ,input p-suffix as character
      988   )
      989   :
      990     define variable v-date as date      no-undo .
      991     define variable v-time as integer   no-undo .
      992     run cur-time in this-procedure
      993       (output v-date
      994       ,output v-time
      995       ) .
      996     return
      997       p-prefix
      998       + string(v-date, p-date-format)
      999       + p-delimiter
     1000       + string(v-time, p-time-format)
     1001       + p-suffix
     1002       .
     1003   end.
     1004   function cur-time-print  returns character
     1005   :
     1006     define variable v-date as date      no-undo .
     1007     define variable v-time as integer   no-undo .
     1008     run cur-time in this-procedure
     1009       (output v-date
     1010       ,output v-time
     1011       ) .
     1012     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1013   end.
     1014   function cur-time-datetime returns datetime
     1015   :
     1016     define variable v-char as character no-undo .
     1017     define variable v-datetime as datetime no-undo .
     1018     v-char = cur-time-string().
     1019     v-datetime = datetime(v-char).
     1020     return  v-datetime.
     1021   end.
     1022   function cur-time-string-msec returns character
     1023   :
     1024     define variable v-date as datetime  no-undo .
     1025     v-date = now.
     1026     return string(v-date) .
     1027   end.
     1028   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   define new shared temp-table temp-hist-nws-option no-undo
     1030   like ub.hist-nws-option
     1031   .
     1032   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1034   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035   FUNCTION get-region RETURNS CHARACTER
     1036     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1037     define variable par-region as character no-undo.
     1038     if parhost-code = 0 and
     1039          parobj-type = "":U and
     1040          parobj-code = 0 then do:
     1041          par-region = "Глобально".
     1042          return par-region.
     1043       end.
     1044       if parobj-type = 'орг':U then do:
     1045          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1046          return par-region.
     1047       end.
     1048       if parobj-type = 'регион':U
     1049       then do:
     1050          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1051          return par-region.
     1052       end.
     1053       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1054       return par-region.
     1055   END FUNCTION.
     1056   FUNCTION get-objregion RETURNS CHARACTER
     1057     (  input parobj-type as character, input parobj-code as integer ) :
     1058     define variable par-region as character no-undo.
     1059     if  parobj-type = "":U and
     1060         parobj-code = 0
     1061     then do:
     1062        par-region = "Глобально".
     1063     end.
     1064     else if parobj-type = 'орг':U
     1065     then do:
     1066        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1067     end.
     1068     else if parobj-type = 'регион':U
     1069     then do:
     1070        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1071     end.
     1072     else
     1073        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1074     return par-region.
     1075   END FUNCTION.
     1076   FUNCTION calldscr returns character ( input p-call-id as character):
     1077   define variable v-descr as character no-undo .
     1078   define variable v-field-list as character no-undo .
     1079   define variable v-value-list as character no-undo.
     1080   define variable v-prop-label as character no-undo .
     1081   define variable v-node-label as character no-undo .
     1082   define variable v-dt-code as integer no-undo .
     1083   define variable v-host-code as integer no-undo .
     1084   define variable v-obj-type as character no-undo .
     1085   define variable v-obj-code as integer no-undo .
     1086   define variable v-label as character no-undo .
     1087   define variable v-node-code as integer no-undo .
     1088   define buffer buf_prop-head for ub.prop-head.
     1089   define buffer buf_prop-ref for ub.prop-ref.
     1090   define buffer buf_prop-map for ub.prop-map.
     1091   run gen-key-fv in this-procedure ( input p-call-id
     1092                                     ,output v-field-list
     1093                                     ,output v-value-list) no-error .
     1094   if error-status:error then return p-call-id.
     1095   CASE entry(1, p-call-id, chr(3)):
     1096     when 'dis-card-type':U then do:
     1097       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1098                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1099                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1100                            ).
     1101     end.
     1102     when 'dis-card':U then do:
     1103       v-descr = substitute("ДК: № &1"
     1104                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1105                            ).
     1106     end.
     1107     when 'dis-card-property':U then do:
     1108       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1109       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1110       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1111       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1112       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1113       find first buf_prop-ref no-lock where
     1114                 buf_prop-ref.dt-code = v-dt-code no-error .
     1115       if available buf_prop-ref then do:
     1116         find first buf_prop-head no-lock where
     1117                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1118         v-prop-label = buf_prop-head.prop-label.
     1119         find first buf_prop-map no-lock where
     1120                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1121               and buf_prop-map.node-code = v-node-code no-error .
     1122         if available buf_prop-map then do:
     1123           v-label = buf_prop-map.node-label.
     1124         end.
     1125       end.
     1126       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1127                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1128                            ,v-prop-label
     1129                            ,v-label
     1130                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1131                            ).
     1132     end.
     1133     when 'clients':U then do:
     1134       v-descr = substitute("&1&2"
     1135                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1136                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1137                            ).
     1138     end.
     1139     when 'ext-system':U then do:
     1140       v-descr = substitute("Внешняя система &1"
     1141                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1142                            ).
     1143     end.
     1144     WHEN 'thbj-attr':U then do:
     1145       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1146       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1147       then do:
     1148         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1149           v-descr = "Операции с товарами".
     1150         end.
     1151         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1152           v-descr = "Операции с клиентами".
     1153         end.
     1154         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1155           v-descr = "Операции с группами товаров".
     1156         end.
     1157         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1158           v-descr = "Операции с группами клиентов".
     1159         end.
     1160         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1161           v-descr = "Операции с чеками на POS IBS-TH".
     1162         end.
     1163         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1164           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1165         end.
     1166         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1167           v-descr = "Операции в системе электронного документооборота".
     1168         end.
     1169         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1170           v-descr = "Операции со справочниками".
     1171         end.
     1172         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1173           v-descr = "Операции с ДНЦ и переоценками".
     1174         end.
     1175         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1176           v-descr = "Отчеты".
     1177         end.
     1178         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1179           v-descr = "Операции с заказами".
     1180         end.
     1181       end.
     1182     end.
     1183     when 'cash-desk':U then do:
     1184       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1185                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1186                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1187                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1188                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1189                            ).
     1190     end.
     1191     when 'ext-file':U then do:
     1192       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1193                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1194                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1195                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1196                            ).
     1197     end.
     1198   end case.
     1199   return v-descr.
     1200   end function.
     1201   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   define new shared temp-table temp-param-name no-undo
     1203   field profile_id as integer
     1204   field profile-type as character
     1205   field schema-name as character
     1206   field esys-id as integer
     1207   field call_id as character
     1208   field once-more as integer
     1209   field codex_id as integer
     1210   field ruleset_id as integer
     1211   field order_id as integer
     1212   field param-name as character
     1213   field param-type as character
     1214   field pack-process-uniq-key-rec as character
     1215   index pi is primary unique
     1216   esys-id
     1217   schema-name
     1218   profile_id
     1219   call_id
     1220   .
     1221   procedure xmlischn_fill :
     1222   define input  parameter p-codex-id  as integer   no-undo .
     1223   define input  parameter p-ruleset-id as integer   no-undo .
     1224   define buffer buf_rule-call-param  for ub.rule-call-param.
     1225   define buffer buf2_rule-call-param for ub.rule-call-param.
     1226   define buffer buf_temp-param-name for temp-param-name.
     1227   define variable v-esys-id-list as character no-undo .
     1228   define variable v-ii as integer no-undo .
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232       for each buf_rule-call-param where
     1233               buf_rule-call-param.codex_id = p-codex-id
     1234           and buf_rule-call-param.ruleset_id = p-ruleset-id
     1235       break
     1236       by buf_rule-call-param.call_id
     1237       by buf_rule-call-param.profile_id
     1238       by buf_rule-call-param.once-more
     1239       :
     1240         if first-of(buf_rule-call-param.once-more) then do:
     1241           v-esys-id-list = ''.
     1242           for each buf2_rule-call-param no-lock
     1243              where buf2_rule-call-param.call_id    = buf_rule-call-param.call_id
     1244                and buf2_rule-call-param.codex_id   = buf_rule-call-param.codex_id
     1245                and buf2_rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     1246                and buf2_rule-call-param.profile_id = buf_rule-call-param.profile_id
     1247                and buf2_rule-call-param.once-more  = buf_rule-call-param.once-more
     1248                and buf2_rule-call-param.param-2-data-type = 'ext-system':U :
     1249             if buf2_rule-call-param.param-name = "p-esys-id"
     1250                  or
     1251                  (buf2_rule-call-param.param-name = "p-esys-id-list"
     1252                  and
     1253                  buf2_rule-call-param.p-index > 0)
     1254             then do:
     1255               assign
     1256               v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(44)) +
     1257                               string( buf2_rule-call-param.param-value-integer)
     1258               .
     1259             end.
     1260           end.
     1261         end.
     1262         if v-esys-id-list = "" then v-esys-id-list = "-1".
     1263         if buf_rule-call-param.param-2-data-type = "xsd" then do:
     1264           find first buf_temp-param-name where
     1265                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1266             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1267             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1268             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1269             no-error.
     1270           if not available buf_temp-param-name then do:
     1271             do v-ii = 1 to num-entries(v-esys-id-list):
     1272               find first buf_temp-param-name where
     1273                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1274                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1275                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1276                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1277                 no-error.
     1278               if not available buf_temp-param-name then do:
     1279             create buf_temp-param-name.
     1280             assign
     1281             buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1282             buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1283             buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1284             buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1285             buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1286             buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1287             buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1288             buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1289             buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1290               buf_temp-param-name.param-type = "xsd"
     1291               buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1292               buf_temp-param-name.pack-process-uniq-key-rec =
     1293               substitute("&2&1&3&1&4&1&5"
     1294                                                                         , chr(4)
     1295                                                                         , buf_rule-call-param.call_id
     1296                                                                         , buf_rule-call-param.codex_id
     1297                                                                         , buf_rule-call-param.ruleset_id
     1298                                                                         , buf_rule-call-param.order_id)
     1299               .
     1300               end.
     1301             end.
     1302           end.
     1303         end.
     1304         if buf_rule-call-param.param-2-data-type = "sub-type" then do:
     1305           find first buf_temp-param-name where
     1306                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1307             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1308             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1309             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1310             no-error.
     1311           if not available buf_temp-param-name then do:
     1312             do v-ii = 1 to num-entries(v-esys-id-list):
     1313               find first buf_temp-param-name where
     1314                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1315                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1316                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1317                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1318                 no-error.
     1319               if not available buf_temp-param-name then do:
     1320               create buf_temp-param-name.
     1321               assign
     1322               buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1323               buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1324               buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1325               buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1326               buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1327               buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1328               buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1329               buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1330               buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1331               buf_temp-param-name.param-type = "no-xsd"
     1332             buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1333             buf_temp-param-name.pack-process-uniq-key-rec =
     1334             substitute("&2&1&3&1&4&1&5"
     1335                                                                        , chr(4)
     1336                                                                        , buf_rule-call-param.call_id
     1337                                                                        , buf_rule-call-param.codex_id
     1338                                                                        , buf_rule-call-param.ruleset_id
     1339                                                                        , buf_rule-call-param.order_id)
     1340             .
     1341           end.
     1342         end.
     1343       end.
     1344       end.
     1345       end.
     1346     end.
     1347   end procedure.
     1348   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1349   define new shared temp-table pdf-list no-undo like ub.price-doc-forming
     1350   field to-del     as logical
