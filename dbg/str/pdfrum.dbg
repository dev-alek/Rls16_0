     1372   define variable v-codex-in-db as integer no-undo .
     1373   define variable v-ii as integer no-undo .
     1374   define variable v-jj as integer no-undo .
     1375   define variable sign as integer no-undo .
     1376   define variable v-codex-id-list as character no-undo .
     1377   DEFINE VARIABLE v-today as date no-undo .
     1378   DEFINE VARIABLE v-time as integer no-undo .
     1379   define variable v-calc-chr as character no-undo .
     1380   define variable v-can-run as logical no-undo .
