     1359   define variable v-obj-type as character no-undo .
     1360   define variable v-obj-code as integer no-undo .
     1361   define variable v-host-code as integer   no-undo .
     1362   define variable v-base-code as integer   no-undo .
     1363   define variable v-doc-date as date no-undo .
     1364   define variable v-fact-date as date no-undo .
     1365   define variable v-curr-r-b as character no-undo .
     1366   define variable v-id as integer no-undo .
     1367   define variable v-proc-handle as handle no-undo .
     1368   define variable v-proc-name as character no-undo .
     1369   define variable v-ruleset-id as integer no-undo .
     1370   define variable v-ruleset-id-list as character no-undo extent 3.
