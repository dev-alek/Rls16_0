     1385   define variable v-pdf-id as integer no-undo .
     1386   define variable v-pdf-db-num as integer no-undo .
     1387   define variable v-process-file-name as character no-undo .
     1388   define variable v-profile-id as integer no-undo .
     1389   define variable log-file-name as character no-undo init "process-pdf-list.txt".
     1390   define variable v-save-int as integer no-undo .
     1391   define variable v-charkey_one as character no-undo .
     1392   define variable v-charkey_one-2 as character no-undo .
     1393   define variable v-num-dc as integer no-undo .
     1394   define variable v-is-empty as logical no-undo .
     1395   define variable v-rec-ord_ as integer no-undo .
     1396   define variable v-param-name as character no-undo .
     1397   define variable v-xsd-file as character no-undo .
     1398   define variable v-cont-handle as handle no-undo .
     1399   define buffer buf_rule-by-call for ub.rule-by-call.
     1400   define buffer buf_rule-call-param for ub.rule-call-param.
     1401   define buffer buf_temp-pers-proc  for temp-pers-proc.
     1402   define buffer buf_db for ub.db.
     1403   define buffer buf_sysconf for ub.sysconf.
     1404   define buffer buf_price-doc for ub.price-doc.
     1405   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1406   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1408   define NEW SHARED temp-table temp-cmd no-undo
     1409   field cmd-code as integer
     1410   field db-list as character
     1411   index pi is unique primary
     1412   db-list
     1413   index icmd
     1414   cmd-code
     1415   .
     1416   define NEW SHARED temp-table temp-smart-route no-undo
     1417   field key-field as character
     1418   field db-num as integer
     1419   index pi is unique primary
     1420   key-field
     1421   db-num
     1422   .
     1423   define NEW SHARED temp-table temp-no-route no-undo
     1424   field rec-ord as integer
     1425   field db-num as integer
     1426   index pi is unique primary
     1427   db-num
     1428   rec-ord
     1429   index iro
     1430   rec-ord
     1431   .
     1432   define NEW SHARED temp-table temp-smart-link no-undo
     1433   field uniq-key-rec as character
     1434   field key-field as character
     1435   field rec-ord as integer
     1436   field is-smart as logical
     1437   index pi is unique primary
     1438   key-field
     1439   uniq-key-rec
     1440   rec-ord
     1441   index iu
     1442   uniq-key-rec
     1443   index iro
     1444   rec-ord
     1445   .
     1446   define NEW SHARED temp-table temp-nws-outline no-undo
     1447   like ub.nws-outline.
     1448   procedure create-smart-route :
     1449   define input parameter p-key-field as character no-undo .
     1450   define input parameter p-db-num as integer no-undo .
     1451   define buffer buf_temp-smart-route for temp-smart-route.
     1452     do
     1453     on error undo, return error
     1454     :
     1455       find first buf_temp-smart-route where
     1456                 buf_temp-smart-route.key-field = p-key-field
     1457             and buf_temp-smart-route.db-num = p-db-num no-error.
     1458       if not available buf_temp-smart-route then do:
     1459         create buf_temp-smart-route.
     1460         assign
     1461         buf_temp-smart-route.key-field = p-key-field
     1462         buf_temp-smart-route.db-num = p-db-num
     1463         .
     1464       end.
     1465     end.
     1466   end procedure.
     1467   procedure create-smart-route-link :
     1468   define input parameter p-tbl-name as character no-undo .
     1469   define input parameter p-bh_tbl-name as handle no-undo .
     1470   define input parameter p-key-field as character no-undo .
     1471   define input parameter p-rec-ord as integer no-undo .
     1472   define input parameter p-is-smart as logical no-undo .
     1473   define variable v-key-rec as character no-undo .
     1474   define buffer buf_temp-smart-link for temp-smart-link.
     1475     do
     1476     on error undo, return error
     1477     :
     1478       run gen-key-rec in this-procedure ( input p-tbl-name
     1479                                          ,input p-bh_tbl-name
     1480                                          ,output v-key-rec     ).
     1481      find first buf_temp-smart-link where
     1482                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1483              and buf_temp-smart-link.key-field = p-key-field
     1484              and buf_temp-smart-link.rec-ord = p-rec-ord
     1485              no-error .
     1486      if not available buf_temp-smart-link then do:
     1487        create buf_temp-smart-link.
     1488        assign
     1489        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1490        buf_temp-smart-link.key-field = p-key-field
     1491        buf_temp-smart-link.rec-ord = p-rec-ord
     1492        buf_temp-smart-link.is-smart = p-is-smart
     1493        .
     1494      end.
     1495     end.
     1496   end procedure.
     1497   procedure create-nws-outline :
     1498   define input parameter p-cmd-proc-handle as handle no-undo .
     1499   define input parameter p-cmd-code as integer no-undo .
     1500   define input parameter p-outline-type as character no-undo .
     1501   define input parameter p-charkey_one as character no-undo .
     1502   define input parameter p-charkey_two as character no-undo .
     1503   define input parameter p-charkey_three as character no-undo .
     1504   define input parameter p-key#_one as integer no-undo .
     1505   define input parameter p-key#_two as integer no-undo .
     1506   define input parameter p-key#_three as integer no-undo .
     1507   define variable v-no-id as integer no-undo .
     1508   define variable v-rec-ord as integer no-undo .
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       find last temp-nws-outline use-index pi no-error .
     1513       v-no-id = (if available temp-nws-outline
     1514                  then (temp-nws-outline.no-id  + 1)
     1515                  else 1).
     1516       create temp-nws-outline.
     1517       assign
     1518       temp-nws-outline.charkeY_one = p-charkey_one
     1519       temp-nws-outline.charkeY_two = p-charkey_two
     1520       temp-nws-outline.charkeY_three = p-charkey_three
     1521       temp-nws-outline.key#_one = p-key#_one
     1522       temp-nws-outline.key#_two = p-key#_two
     1523       temp-nws-outline.key#_three = p-key#_three
     1524       temp-nws-outline.no-id = v-no-id
     1525       temp-nws-outline.outline-type = p-outline-type
     1526       .
     1527                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1528       run  create-smart-route in this-procedure (
     1529                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1530                                                  ,input -1).
     1531       run create-smart-route-link in this-procedure (
     1532                                                      input 'nws-outline':U
     1533                                                     ,input (buffer temp-nws-outline:handle)
     1534                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1535                                                     ,input v-rec-ord
     1536                                                     ,input no
     1537                                                     ).
     1538     end.
     1539   end procedure.
     1540   procedure create-no-route :
     1541   define input parameter p-rec-ord as integer no-undo .
     1542   define input parameter p-db-num as integer no-undo .
     1543   define buffer buf_temp-no-route for temp-no-route.
     1544   do
     1545   on error undo, return error
     1546   :
     1547      find first buf_temp-no-route where
     1548                 buf_temp-no-route.rec-ord = p-rec-ord
     1549              and buf_temp-no-route.db-num = p-db-num no-error .
     1550      if not available buf_temp-no-route then do:
     1551        create buf_temp-no-route.
     1552        assign
     1553        buf_temp-no-route.rec-ord = p-rec-ord
     1554        buf_temp-no-route.db-num = p-db-num
     1555        .
     1556      end.
     1557   end.
     1558   end procedure.
     1559   procedure clear-from-rec-ord :
     1560   define input parameter p-rec-ord as integer no-undo .
     1561   define buffer buf_temp-no-route for temp-no-route.
     1562   define buffer buf_temp-smart-link for temp-smart-link.
     1563   do
     1564   on error undo, return error
     1565   :
     1566   for each buf_temp-no-route where
     1567           buf_temp-no-route.rec-ord > p-rec-ord:
     1568     delete buf_temp-no-route.
     1569   end.
     1570   for each buf_temp-smart-link where
     1571           buf_temp-smart-link.rec-ord > p-rec-ord:
     1572      delete buf_temp-smart-link.
     1573   end.
     1574   end.
     1575   end procedure.
     1576   define buffer buf_temp-cmd  for temp-cmd.
     1577   define buffer buf1_temp-cmd  for temp-cmd.
     1578   define buffer buf_temp-smart-route  for temp-smart-route.
     1579   define buffer buf_temp-smart-link  for temp-smart-link.
     1580   define buffer buf_temp-nws-outline for temp-nws-outline.
     1581   define buffer buf_temp-no-route for temp-no-route.
     1582   _main:
     1583   do
     1584   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1585   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1586   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1587   :
     1588   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1590     (output v-curr-r-b
     1591     )  .
     1592     if not p-save
     1593           then do:
     1594       message
     1595       substitute("Неверное значение параметра p-save = &1,&2" +
     1596                  "в ситуации когда p-process = &3"
     1597                  , p-save
     1598                  , chr(10)
     1599                  , p-process)
     1600       view-as alert-box error .
     1601       undo _main, return error .
     1602     end.
     1603     v-save-int = (if p-save
     1604                   then 0
     1605                   else -1).
     1606     CASE p-process:
     1607       when 'pdf-main-doc-close':U
     1608       then do:
     1609         if not g#auto then do:
     1610   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611     run mainmenu_getcntxt in parparentproc
     1612       (output v-cntxt-db-num
     1613       ,output v-cntxt-userid
     1614       ,output v-cntxt-level
     1615       ,output v-cntxt-host-code-obj
     1616       ,output v-cntxt-obj-type
     1617       ,output v-cntxt-obj-code
     1618       ,output v-cntxt-db-num-obj
     1619       ,output v-cntxt-is-admin
     1620       ) .
     1621         end.
     1622         run cur-time in this-procedure ( output v-today, output v-time).
     1623         assign
     1624         v-obj-type = v-cntxt-obj-type
     1625         v-obj-code = v-cntxt-obj-code
     1626         v-host-code = v-cntxt-host-code-obj
     1627         v-doc-date = v-today
     1628         v-fact-date = v-today
     1629         v-plt-id = p-plt-id
     1630         v-plt-db-num = p-plt-db-num
     1631         v-pdf-id = p-pdf-id
     1632         v-pdf-db-num = p-pdf-db-num
     1633         v-profile-id = p-profile-id
     1634         v-codex-id-list = "21"
     1635         v-ruleset-id-list[1] = "1"
     1636         v-ruleset-id-list[2] = ""
     1637         .
     1638         if v-plt-id <> 0
     1639         and v-pdf-id <> 0
     1640         then do:
     1641           find first buf_price-doc-forming exclusive-lock where
     1642                     buf_price-doc-forming.plt-id = v-plt-id
     1643                 and buf_price-doc-forming.plt-db-num = v-plt-db-num
     1644                 and buf_price-doc-forming.pdf-id = v-pdf-id
     1645                 and buf_price-doc-forming.pdf-db = v-pdf-db-num.
     1646           create pdf-list.
     1647           buffer-copy buf_price-doc-forming to pdf-list
     1648           .
     1649           release pdf-list.
     1650         end.
     1651       end.
     1652       otherwise do:
     1653         undo _main, return error substitute("&1 &2 &3&4Ошибка входных параметров процедуры pdfrum.p&4Невернoе значение p-process = &5"
     1654                                             ,vss-workfile
     1655                                             ,vss-revision
     1656                                             ,vss-description
     1657                                             ,chr(10)
     1658                                             ,p-process
     1659                                              ).
     1660       end.
     1661     END CASE.
     1662     _codex:
     1663     do v-jj = 1 to num-entries(v-codex-id-list):
     1664       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     1665       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     1666       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     1667           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     1668           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     1669         _rule-by-call:
     1670         for each buf_rule-by-call no-lock where
     1671                   buf_rule-by-call.call_id = p-uniq-key-rec
     1672             and buf_rule-by-call.can-calc = yes
     1673             and buf_rule-by-call.codex_id = v-codex-id
     1674             and buf_rule-by-call.ruleset_id = v-ruleset-id
     1675         by buf_rule-by-call.call_Id
     1676         by buf_rule-by-call.codex_id
     1677         by buf_rule-by-call.ruleset_id
     1678         by buf_rule-by-call.order_id
     1679         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1680         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1681         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     1682           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     1683           run value(v-proc-name)  (
     1684                                                                 input parparentproc
     1685                                                               ,input this-procedure:handle
     1686                                                               ,input p-log-handle
     1687                                                               ,input v-cont-handle
     1688                                                               ,input v-codex-id
     1689                                                               ,input v-ruleset-id
     1690                                                               ,input buf_rule-by-call.call_id
     1691                                                               ,input buf_rule-by-call.order_id
     1692                                                               ,input buf_rule-by-call.rule_id
     1693                                                               ,input buf_rule-by-call.profile
     1694                                                               ,input buf_rule-by-call.is_dynamic
     1695                                                               ,input v-doc-type
     1696                                                               ,input v-host-code
     1697                                                               ,input v-obj-type
     1698                                                               ,input v-obj-code
     1699                                                               ,input v-doc-code
     1700                                                               ,input v-plt-id
     1701                                                               ,input v-plt-db-num
     1702                                                               ,input v-pdf-id
     1703                                                               ,input v-pdf-db-num
     1704                                                               ,input v-process-file-name
     1705                                                               ,input v-save-int
     1706                                                               ,input v-curr-r-b
     1707                                                               ,input v-cmd-proc-handle
     1708                                                               ,input 0
     1709                                                               ) no-error .
     1710           if error-status:error
     1711           then do:
     1712             undo _main, return error substitute("&1&2Ошибка при обработке ДНЦ и/или переоценок&2" +
     1713                                                 "&3&2&4"
     1714                                                 ,vss-workfile
     1715                                                 ,chr(10)
     1716                                                 , error-status:get-message(1)
     1717                                                 , return-value
     1718                                                   ).
     1719           end.
     1720           if v-stop-leave-status > '' then do:
     1721             undo _main, return error substitute("&1&2Ошибка при обработке ДНЦ и/или переоценок&2" +
     1722                                                 "&3&2&4"
     1723                                                 ,vss-workfile
     1724                                                 ,chr(10)
     1725                                                 , error-status:get-message(1)
     1726                                                 , return-value
     1727                                                   ).
     1728           end.
     1729         end.
     1730       end.
     1731     end.
     1732   end.
     1733   procedure set-num-rec :
     1734   define input parameter p-num-rec as integer no-undo .
     1735   define input parameter p-num-rec-calc-err as integer no-undo .
     1736   define input parameter p-num-rec-value-err as integer no-undo .
     1737   define input parameter p-num-rec-ok as integer no-undo .
     1738   define input parameter p-display as logical no-undo .
     1739   define variable v-ok as logical no-undo .
     1740   do
     1741   on error undo, return error
     1742   :
     1743     if not (p-process = 'batch-card-recalc':U) then do:
     1744       return.
     1745     end.
     1746     run set-num-rec in p-parent-handle ( input p-num-rec
     1747                                         ,input p-num-rec-calc-err
     1748                                         ,input p-num-rec-value-err
     1749                                         ,input p-num-rec-ok
     1750                                         ,buffer buf_rule-by-call
     1751                                         ,input p-display
     1752                                         ).
     1753   end.
     1754   end procedure.
     1755   procedure set-stop-leave-status :
     1756   define input parameter p-stop-leave-status as character no-undo .
     1757   do
     1758   on error undo, return error
     1759   :
     1760     assign
     1761     v-stop-leave-status = p-stop-leave-status.
     1762   end.
     1763   end procedure.
