        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter  b-c       as char no-undo.
        6   define output parameter parb-code like bar-code.b-code initial ? no-undo.
        7   define new global shared variable g#language as character no-undo .
        8   if g#language <> '' and g#language <> 'rus':U then do:
        9     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       10   end.
       11   define new global shared variable g#library  as handle no-undo .
       12   define new global shared variable g#library2 as handle no-undo .
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   DEFINE TEMP-TABLE in-bc NO-UNDO
       15        FIELD nm        as INTEGER
       16        FIELD bar-str   AS CHARACTER
       17        FIELD bar-code  as CHARACTER
       18        FIELD rez       as CHARACTER
       19        FIELD err-msg   as CHARACTER
       20        FIELD des       as CHARACTER
       21        INDEX pi IS PRIMARY nm.
       22   DEFINE new SHARED TEMP-TABLE un-bc NO-UNDO
       23        FIELD nm             as INTEGER
       24        FIELD bar-code       as CHARACTER
       25        FIELD entity         as character
       26        FIELD b-c            as INTEGER
       27        FIELD rate           as DECIMAL
       28        FIELD TYPE-bc        as CHARACTER
       29        FIELD wt             as DECIMAL
       30        FIELD file-qnty      as decimal
       31        FIELD scn-qnty       as DECIMAL
       32        FIELD scn-pl         as CHARACTER
       33        FIELD artic          LIKE ub.goods.artic
       34        FIELD prod-type      LIKE ub.goods.prod-type
       35        FIELD prod-code      LIKE ub.goods.prod-code
       36        FIELD gds-name       LIKE ub.goods.gds-name
       37        FIELD prod-name      LIKE ub.clients.obj-name
       38        FIELD unit-base      LIKE ub.goods.unit-base
       39        FIELD units-type     LIKE ub.units.type
       40        FIELD f-name         LIKE ub.gds-prt.f-name
       41        FIELD in-code        LIKE ub.parts.in-code
       42        FIELD fact-date      LIKE ub.parts.fact-date
       43        FIELD part-code      LIKE ub.parts.part-code
       44        FIELD rez            as CHARACTER
       45        FIELD err-msg        as CHARACTER
       46        FIELD des            as CHARACTER
       47        FIELD pl-name        AS CHARACTER
       48        FIELD loc1           AS CHARACTER
       49        FIELD loc2           AS CHARACTER
       50        FIELD loc3           AS CHARACTER
       51        FIELD loc4           AS CHARACTER
       52        FIELD unit-name      LIKE ub.units.unit-name
       53        FIELD long-name      LIKE ub.units.long-name
       54        FIELD b-c-base       LIKE ub.bar-code.b-code
       55        FIELD unit-name-base LIKE ub.units.unit-name
       56        FIELD long-name-base LIKE ub.units.long-name
       57        INDEX pi IS PRIMARY  nm
       58        INDEX bar-code bar-code
       59        INDEX b-c b-c
       60        INDEX file-qnty file-qnty.
       61   DEFINE new SHARED TEMP-TABLE anlz-bc NO-UNDO
       62        FIELD nm       as INTEGER
       63        FIELD b-c      as integer
       64        FIELD scn-qnty as DECIMAL
       65        FIELD scn-pl   as CHARACTER
       66        FIELD rez      as CHARACTER
       67        FIELD err-msg  as CHARACTER
       68        FIELD des      as CHARACTER
       69        FIELD upd-line as logical initial no
       70        INDEX pi IS PRIMARY nm
       71        INDEX b-c b-c.
       72   DEFINE new SHARED TEMP-TABLE main-bc NO-UNDO
       73        FIELD nm       as INTEGER
       74        FIELD b-c      as integer
       75        FIELD scn-qnty as DECIMAL
       76        FIELD scn-pl   as CHARACTER
       77        FIELD rez      as CHARACTER
       78        FIELD des      as CHARACTER
       79        INDEX pi IS PRIMARY nm
       80        INDEX b-c b-c.
       81   def var rate LIKE doc-line.cli-base-rate NO-UNDO.
       82   DEF var ret-mode AS CHAR                 NO-UNDO.
       83   DEF var add-scan AS LOG INITIAL NO       NO-UNDO.
       84   def var bar-str  LIKE prod-bc.b-str      NO-UNDO.
       85   def var is-err   as log                  no-undo.
       86   if b-c = ? then do:
       87     REPEAT:
       88       run str/chs-bc.w (input parparentproc,
       89                     "Анализ бар-кода", ?, ?, NO,
       90                     output b-c,
       91                     output rate,
       92                     output ret-mode,
       93                     input-output add-scan,
       94                     input-output bar-str) no-error.
       95       if error-status :error then do:
       96         message "Неверный выбор бар-кода."
       97                 view-as alert-box.
       98         return error.
       99       end.
      100       if b-c = ? THEN
      101         LEAVE.
      102       run analize-one no-error.
      103     END.
      104   end.
      105   else do:
      106     run analize-one no-error.
      107     if error-status:error then
      108     message "Ошибка при поиске бар-кода."
      109     view-as alert-box error.
      110   end.
      111   procedure analize-one:
      112     FOR EACH un-bc:
      113       DELETE un-bc.
      114     END.
      115     run str/bc-anlz.p (parparentproc, "code-add", b-c, yes, output is-err, output table in-bc) no-error.
      116     if error-status:error then do:
      117       message "Неверный анализ бар-кода."
      118               view-as alert-box error.
      119       return error.
      120     end.
      121     FIND LAST un-bc NO-ERROR.
      122     IF AVAILABLE un-bc then do:
      123        ASSIGN parb-code = un-bc.b-c.
      124        run str/bc-inf.w (
      125                       input parparentproc
      126                      ,input p-curr-obj-type
      127                      ,input p-curr-obj-code
      128                      ,recid (un-bc)
      129                      ,output table in-bc) no-error.
      130     end.
      131     else return error.
      132   end.
