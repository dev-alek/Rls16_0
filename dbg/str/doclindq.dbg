        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo.
        3   define parameter buffer t-doc for ub.trn-doc .
        4   define parameter buffer buf_doc-line for ub.doc-line .
        5   define input  parameter p-doc-qnty   as decimal   no-undo .
        6   define output parameter p-edit-ok     as logical   no-undo .
        7   define output parameter p-err-message as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: doclindq.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/doclindq.p $":U .
       13   define variable vss-description as character no-undo init "Редактирование документарного количества в расходной накладной".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define new global shared variable g#lib-trn  as handle no-undo .
       75   define new global shared variable g#lib-trn2 as handle no-undo .
       76   define new global shared variable g#lib-trn3 as handle no-undo .
       77   define new global shared variable g#lib-trn4 as handle no-undo .
       78   define variable is-petrolium as logical no-undo .
       79   define variable is-pieces    as logical no-undo .
       80   define variable line-rec     as recid   no-undo .
       81   define variable v-hold-doc as logical   no-undo .
       82   define buffer buf_gds-dtl for ub.gds-dtl  .
       83   define buffer buf_goods for ub.goods  .
       84   do
       85   on error undo, return error return-value
       86   :
       87     update_block:
       88     do transaction
       89     on error undo update_block, return error
       90     :
       91       if not available t-doc
       92       then do:
       93         undo, return error "Не задан документ" .
       94       end.
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
       97     (input  t-doc.doc-code
       98     ,output v-hold-doc
       99     )  .
      100       if not available buf_doc-line
      101       then do:
      102         undo, return error "Не задана строка документа" .
      103       end.
      104       define variable v-gds-code as integer   no-undo .
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      107     (input  buf_doc-line.artic
      108     ,input  buf_doc-line.prod-type
      109     ,input  buf_doc-line.prod-code
      110     ,output v-gds-code
      111     )  .
      112       find first buf_goods no-lock where
      113                  buf_goods.gds-code  = v-gds-code .
      114         find first buf_gds-dtl no-lock where
      115                    buf_gds-dtl.artic     = buf_doc-line.artic          and
      116                    buf_gds-dtl.prod-type = buf_doc-line.prod-type  and
      117                    buf_gds-dtl.prod-code = buf_doc-line.prod-code  and
      118                    buf_gds-dtl.doc-code  = buf_doc-line.doc-code   no-error .
      119       if not available buf_gds-dtl then do:
      120         undo update_block, return error substitute("Нет строки признака &2 для документа &1" , buf_doc-line.doc-code, buf_goods.gds-name ) .
      121       end.
      122       if p-doc-qnty <> buf_doc-line.doc-qnty
      123       then do:
      124         if  p-doc-qnty = ?
      125         and t-doc.flag_ = true
      126         then do:
      127           assign
      128             p-edit-ok     = false
      129             p-err-message = "Не указано количество"
      130           .
      131           undo update_block, return .
      132         end.
      133        if p-doc-qnty = 0 then do:
      134           run str/out-add.p
      135             ( parparentproc,
      136               recid(t-doc),
      137               recid(buf_doc-line),
      138               recid(buf_gds-dtl),
      139               recid(buf_goods),
      140               "delete",
      141               ? )  no-error.
      142             if error-status :error
      143             then do:
      144               undo update_block, return error substitute("Ошибка >> &1 &2", return-value , error-status :get-message(1)  ).
      145             end.
      146        end.
      147        else do:
      148         define variable v-goods-serial as logical   no-undo .
      149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
      150     (input  v-gds-code
      151     ,input  'serial=request':u
      152     ,output v-goods-serial
      153     ) no-error .
      154         if error-status :error
      155         then do:
      156           undo update_block, return error "Ошибка при определении свойства товара 'serial=request':u" .
      157         end.
      158         if v-goods-serial = true
      159         then do:
      160         end.
      161       run str/out-add.p
      162         ( parparentproc,
      163           recid(t-doc),
      164           recid(buf_doc-line),
      165           recid(buf_gds-dtl),
      166           recid(buf_goods),
      167           "ch-doc-qnty",
      168           p-doc-qnty )  no-error.
      169         if error-status :error
      170         then do:
      171           undo update_block, return error substitute("Ошибка >> &1 &2", return-value , error-status :get-message(1)  ).
      172         end.
      173         .
      174       end.
      175     end.
      176     end.
      177     assign
      178       p-edit-ok     = true
      179       p-err-message = ''
      180     .
      181   end.
