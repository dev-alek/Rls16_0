     1378   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379   define variable v-waitfram-action01         as character   no-undo .
     1380   define variable v-waitfram-action02         as character   no-undo .
     1381   define variable v-waitfram-action03         as character   no-undo .
     1382   define variable mWaitFramTextBeg            as character   no-undo.
     1383   define variable mWaitFramTextEnd            as character   no-undo.
     1384   define variable mWaitFramView               as logical     no-undo.
     1385   define variable mWaitProcEvent              as logical     no-undo init yes.
     1386   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1387   define variable mWaitFramStop               as logical     no-undo.
     1388   define variable mWaitFramStopUser           as logical     no-undo.
     1389   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1390   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1391   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1392   define button B-WaitFramStop auto-end-key
     1393        label "Стоп"
     1394        size 10 by 1 tooltip "Остоновить процесс".
     1395   define button B-viewProcInfo
     1396        label "Информация"
     1397        size 15 by 1 tooltip "Информация о процесс".
     1398   define frame waitfram
     1399     v-waitfram-action01 format "x(72)" no-label skip
     1400     v-waitfram-action02 format "x(72)" no-label skip
     1401     v-waitfram-action03 format "x(72)" no-label skip
     1402     B-viewProcInfo
     1403     B-WaitFramStop at row 4 col 30
     1404     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1405     .
     1406   define new global shared variable mBatchMode as logical no-undo init ?.
     1407   define variable mFramBachModHandle as handle no-undo.
     1408   mFramBachModHandle = frame waitfram:handle.
     1409   define variable mFameOldVis as logical no-undo.
     1410   define variable mVisCUrentVin as logical no-undo.
     1411   if session:batch-mode
     1412   then
     1413      mBatchMode = yes.
     1414   if mBatchMode = ? then do:
     1415     mVisCUrentVin = current-window:visible.
     1416     mFameOldVis = mFramBachModHandle:visible.
     1417     mFramBachModHandle:visible  = yes.
     1418     mBatchMode = mFramBachModHandle:visible ne yes.
     1419     mFramBachModHandle:visible = mFameOldVis.
     1420     current-window:visible = mVisCUrentVin.
     1421   end.
     1422    if  log-manager:logfile-name ne ?
     1423     then DO:
     1424         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1425         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1426         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1427     end.
     1428   on choose of B-WaitFramStop in frame waitfram
     1429   do:
     1430     mWaitFramStop = yes.
     1431     mWaitFramStopUser = yes.
     1432   end.
     1433   function waitfram-check-timeout returns logical():
     1434      define variable vtime as int64 no-undo.
     1435      if mWaitFramStopTimeOut
     1436      then
     1437         return yes.
     1438      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1439      if     mWaitFramTimeOut ne ?
     1440         and mWaitFramTimeOut ne 0
     1441         and mWaitFramTimeOut lt vtime
     1442      then do:
     1443         mWaitFramStopTimeOut = yes.
     1444      end.
     1445      return mWaitFramStopTimeOut.
     1446   end.
     1447   procedure waitfram-hide :
     1448     if not session:batch-mode
     1449     then do
     1450     on error undo, return error return-value
     1451     :
     1452       pause 0 before-hide .
     1453       if not mBatchMode then
     1454         hide frame waitfram .
     1455     if     not mWaitFramView
     1456        and mWaitProcEvent
     1457     then
     1458       process events .
     1459     end.
     1460   end procedure.
     1461   procedure waitfram-show :
     1462     define input  parameter p-message as character no-undo .
     1463     define variable v-left-margin as integer   no-undo .
     1464     if not session:batch-mode
     1465     then do
     1466     on error undo, return error return-value
     1467     :
     1468       if length(p-message) <= 70 then do:
     1469         assign
     1470           v-left-margin = integer((70 - length(p-message)) / 2)
     1471         .
     1472         assign
     1473           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1474         .
     1475         assign
     1476           v-waitfram-action01 = " "
     1477           v-waitfram-action02 = " "
     1478                                    + fill(" ", v-left-margin)
     1479                                    + p-message
     1480           v-waitfram-action03 = " "
     1481         .
     1482       end.
     1483       else do:
     1484         define variable vRindex1 as integer no-undo.
     1485         define variable vRindex2 as integer no-undo.
     1486         vRindex1 = r-index(p-message," ",70).
     1487         if vRindex1 = 0
     1488         then
     1489            vRindex1 = 70.
     1490         if length(p-message)  <= vRindex1 + 70 then do:
     1491           assign
     1492             v-waitfram-action01 = " "
     1493             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1494             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1495           .
     1496         end.
     1497         else do:
     1498           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1499           if vRindex2 <= vRindex1
     1500           then
     1501              vRindex2 = vRindex1 + 70.
     1502           assign
     1503             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1504             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1505             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1506           .
     1507         end.
     1508       end.
     1509       B-viewProcInfo:visible   in frame waitfram = no.
     1510       B-viewProcInfo:sensitive in frame waitfram = no.
     1511       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1512       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1513       if  (   mWaitFramView
     1514          or  mWaitProcEvent)
     1515          and not mBatchMode
     1516       then
     1517          display
     1518             v-waitfram-action01 skip
     1519             v-waitfram-action02 skip
     1520             v-waitfram-action03 skip
     1521          with frame waitfram .
     1522       if     mWaitFramView
     1523          then do:
     1524             if     mWaitFramInterval ne ?
     1525                and not mBatchMode
     1526             then
     1527                wait-for go of frame waitfram pause mWaitFramInterval.
     1528          end.
     1529          else
     1530             if     mWaitProcEvent
     1531                and not mBatchMode
     1532             then
     1533                process events .
     1534     end.
     1535   end procedure.
     1536      procedure waitfram-show-this:
     1537         define input  parameter iInterval as int64 no-undo.
     1538         define variable vtime as int64 no-undo.
     1539         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1540         mWaitFramInterval = iInterval.
     1541         run waitfram-show (substitute("&1&2 &3&4" ,
     1542                                       mWaitFramTextBeg ,
     1543                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1544                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1545                                       mWaitFramTextEnd
     1546                                      )
     1547                           ).
     1548      end.
     1549      procedure WaitFramRunPause:
     1550         define input  parameter iInterval as dec no-undo.
     1551         define variable vStart  as datetime-tz no-undo.
     1552         define variable vend    as datetime-tz no-undo.
     1553         define variable vint as int64 no-undo.
     1554         define variable vOk as logical no-undo.
     1555         vStart = now.
     1556         vend   = vStart.
     1557         publish "WaitFramPause" (iInterval,output vOk).
     1558         vend   =  now.
     1559         vint = vend - vStart.
     1560         vint = iInterval - vint / 1000.
     1561         if     not mWaitFramStop
     1562            and (   vint > 0
     1563                 or (    not vOk
     1564                     and iInterval eq ?
     1565                     )
     1566                 )
     1567         then
     1568            run waitfram-show-this (iInterval).
     1569         vend   =  now.
     1570         vint = vend - vStart.
     1571         vint = iInterval - vint / 1000.
     1572         if     not mWaitFramStop
     1573            and vint > 0
     1574         then do:
     1575            run gbl/pause.p (vint * 1000).
     1576         end.
     1577         if iInterval ne ?
     1578         then
     1579            publish "WaitFramStop".
     1580         waitfram-check-timeout().
     1581      end.
     1582      procedure WaitFramWaitFor:
     1583         define input  parameter iInterval as dec no-undo.
     1584         assign
     1585            mWaitFramStartProc   = now
     1586            mWaitFramStopUser    = no
     1587            mWaitFramStopTimeOut = no
     1588         .
     1589         block-wait:
     1590         do while not mWaitFramStop:
     1591            run WaitFramRunPause (iInterval).
     1592            if  waitfram-check-timeout()
     1593            then do:
     1594               leave block-wait.
     1595            end.
     1596         end.
     1597         run waitfram-hide.
     1598      end.
     1599   procedure waitfram-join :
     1600     define input  parameter p-line-1  as character no-undo .
     1601     define input  parameter p-line-2  as character no-undo .
     1602     define input  parameter p-line-3  as character no-undo .
     1603     define output parameter p-message as character no-undo .
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       assign
     1608         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1609                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1610                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1611       .
     1612     end.
     1613   end procedure.
     1614   function waitfram-join-function returns character
     1615     (input p-line-1 as character
     1616     ,input p-line-2 as character
     1617     ,input p-line-3 as character
     1618     ).
     1619     define variable v-message as character no-undo .
     1620     run waitfram-join in this-procedure
     1621       (input  p-line-1
     1622       ,input  p-line-2
     1623       ,input  p-line-3
     1624       ,output v-message
     1625       ) .
     1626     return v-message .
     1627   end function .
     1628   define variable mHSocket       as handle      no-undo.
     1629   define variable mWebRespHead   as longchar    no-undo.
     1630   define variable mWebResp       as longchar    no-undo.
     1631   define variable mWebRespMptr   as memptr      no-undo.
     1632   define variable OerrMsg        as character   no-undo.
     1633   define variable mFileLogSocet  as character   no-undo.
     1634   define variable mReturnHttp    as logical     no-undo.
     1635   define variable mAddTimeOut    as logical     no-undo init yes.
     1636   define variable mSocetBegTime  as datetime-tz no-undo.
     1637   define variable mSocetEndTime  as dec         no-undo.
     1638   define variable mWriteRespFile as character   no-undo.
     1639   define variable mTypeResponse  as character   no-undo init "POST".
     1640   publish "getSocetLog" (output mFileLogSocet).
     1641   if
     1642      (   mFileLogSocet eq ""
     1643       or mFileLogSocet eq ?)
     1644      and session:debug-alert
     1645   then
     1646      mFileLogSocet = "socet.log".
     1647   procedure ConectSocet:
     1648      define input  parameter iHost       as character no-undo.
     1649      define input  parameter iPort       as character no-undo.
     1650      define input  parameter iUrl        as character no-undo.
     1651      define input  parameter iPostData   as longchar  no-undo.
     1652      define input  parameter iReturnType as character no-undo.
     1653      define input  parameter iTimeOut    as decimal   no-undo.
     1654      define input  parameter iSilent     as logical   no-undo.
     1655      define input  parameter iTextWait   as character no-undo.
     1656      mWaitFramTextBeg = iTextWait.
     1657      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     1658      if OerrMsg eq ""
     1659      then
     1660         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     1661      mSocetEndTime = (now - mSocetBegTime) / 1000.
     1662   end.
     1663   procedure SendReqSocet:
     1664      define input  parameter iHost            as character no-undo.
     1665      define input  parameter iPort            as character no-undo.
     1666      define input  parameter iUrl             as character no-undo.
     1667      define input  parameter iPostData        as longchar  no-undo.
     1668      define input  parameter iReturnType      as character no-undo.
     1669      define input  parameter iProcGetResponse as character no-undo.
     1670      mSocetBegTime = now.
     1671      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1672      assign
     1673         mWebResp         = ""
     1674         mWebResphead     = ""
     1675         OerrMsg          = ""
     1676         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     1677         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     1678      .
     1679      define variable vPostData as longchar                       no-undo.
     1680      if    iHost eq ""
     1681         or iHost eq ?
     1682      then do:
     1683         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     1684         run writeLogSocet in this-procedure (oErrMsg).
     1685         return oErrMsg.
     1686      end.
     1687      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1688      create socket mHSocket.
     1689      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     1690      if mHSocket:connected() = false
     1691      then do:
     1692         run waitfram-hide .
     1693         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     1694         run writeLogSocet in this-procedure (oErrMsg).
     1695         delete object mHSocket.
     1696         return oErrMsg.
     1697      end.
     1698      run waitfram-show ("Отправка данных").
     1699      mHSocket:set-read-response-procedure(iProcGetResponse).
     1700      run PostRequest (
     1701       input iUrl,
     1702       input iHost + ":" + iPort,
     1703       input iPostData
     1704       ).
     1705       run waitfram-hide .
     1706   end.
     1707   procedure WaitRespSocet:
     1708      define input  parameter iTimeOut   as decimal   no-undo.
     1709      define input  parameter iSilent    as logical   no-undo.
     1710      define input  parameter iTextWait  as character no-undo.
     1711      if    not valid-handle (mHSocket )
     1712      then do:
     1713         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     1714         return "End connected".
     1715      end.
     1716      if mHSocket:connected() = false
     1717      then do:
     1718         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     1719         oErrMsg = "Not connected".
     1720         return oErrMsg.
     1721      end.
     1722      mWaitFramView = if iSilent ne yes then yes else no.
     1723      mWaitFramTextBeg = iTextWait.
     1724      mWaitFramTimeOut = iTimeOut.
     1725      mWaitFramTextEnd = "".
     1726      mWaitFramStop = no.
     1727      if mAddTimeOut
     1728      then do:
     1729         mWaitFramTimeOut = 300.
     1730         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     1731      end.
     1732      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     1733      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     1734      run WaitFramWaitFor(1).
     1735      unsubscribe "WaitFramStop".
     1736      if mWaitFramStopUser
     1737      then do:
     1738         OerrMsg = substitute("Операция прервана пользователем." ).
     1739         run writeLogSocet in this-procedure (OerrMsg).
     1740      end.
     1741      else if mWaitFramStopTimeOut
     1742      then do:
     1743         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     1744         run writeLogSocet in this-procedure (OerrMsg).
     1745      end.
     1746      run waitfram-hide .
     1747      mHSocket:disconnect() no-error.
     1748      delete object mHSocket.
     1749   end.
     1750   procedure WaitRespTestStop:
     1751      if mWaitFramStopTimeOut
     1752      then
     1753         return.
     1754      if     (mWebResp ne ""
     1755          and mWebResp ne ?)
     1756      then do:
     1757         mWaitFramStop = yes.
     1758         return.
     1759      end.
     1760      else if mHSocket:connected() = false
     1761      then do:
     1762         mWaitFramStop = yes.
     1763         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     1764         oErrMsg = "Not connected".
     1765         return oErrMsg.
     1766      end.
     1767      wait-for read-response of mHSocket pause 0.001.
     1768   end.
     1769   procedure PostRequest:
     1770      define input parameter iPostUrl  as char.
     1771      define input parameter iPostHost as char.
     1772      define input parameter iPostData as longchar.
     1773      define variable vCRequest      as longchar.
     1774      define variable vMRequest       as memptr.
     1775      if iPostUrl ne ?
     1776      then do:
     1777         vCRequest =substitute(
     1778         '&5 /&2 HTTP/1.1&1'                                   +
     1779         'Host: &4&1'                                           +
     1780         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     1781         'Accept: */*&1' +
     1782         'Content-Type: text/xml&1'               +
     1783         'Content-Length: &3&1'                                  +
     1784         '&1'
     1785         ,
     1786         chr(13) + chr(10),
     1787         iPostUrl,
     1788         length(iPostData),
     1789         iPostHost,
     1790         mTypeResponse) + iPostData.
     1791      end.
     1792      else
     1793         vCRequest = iPostData.
     1794      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     1795      run writeLogSocet in this-procedure (vCRequest).
     1796      SET-SIZE(vMRequest)            = 0.
     1797      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     1798      SET-BYTE-ORDER(vMRequest)      = big-endian.
     1799      PUT-STRING(vMRequest,1)        = vCRequest .
     1800      if mHSocket:connected() = false then
     1801      do:
     1802         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     1803         oErrMsg = "Not connected".
     1804         delete object mHSocket no-error.
     1805         return oErrMsg.
     1806      end.
     1807      mHSocket:write(vMRequest, 1, length(vCRequest)).
     1808      run writeLogSocet in this-procedure ("Запрос отправлен.").
     1809   end procedure.
     1810   function hex-to-int returns integer (
     1811     input p-hex-code  as character  ).
     1812     define variable v-int-code as integer   no-undo .
     1813     define variable v-ind      as integer   no-undo .
     1814     define variable v-digit    as integer   no-undo .
     1815     define variable v-letter   as character no-undo .
     1816     do v-ind = 1 to length(p-hex-code)
     1817     :
     1818       assign
     1819         v-letter = caps(substring(p-hex-code, v-ind, 1))
     1820       .
     1821       assign
     1822         v-digit = index('123456789ABCDEF':u, v-letter)
     1823       .
     1824       assign
     1825         v-int-code = v-int-code * 16 + v-digit
     1826       .
     1827     end.
     1828     return v-int-code .
     1829   end function .
     1830   procedure getResponse:
     1831      define variable vFlagTag     as logical          no-undo init no.
     1832      define variable vResponse    as memptr           no-undo.
     1833      define variable vCnt         as int64            no-undo.
     1834      define variable vMessage     as longchar         no-undo.
     1835      define variable v-cont-length as int64 no-undo.
     1836      define variable vi           as integer no-undo.
     1837      define variable v-hd-line    as character no-undo.
     1838      define variable level        as integer no-undo initial 2.
     1839      repeat while program-name(level) <> ?:
     1840        if program-name(level) = program-name(1) then do:
     1841          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     1842          return "".
     1843        end.
     1844        level = level + 1.
     1845      end.
     1846      if mHSocket:connected() = false then
     1847      do:
     1848         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     1849         oErrMsg = "Not connected".
     1850         return oErrMsg.
     1851      end.
     1852      if mAddTimeOut
     1853      then do:
     1854         mWaitFramTimeOut = 1000.
     1855         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     1856      end.
     1857      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     1858      mWaitFramTextEnd = "Получаем ответ".
     1859      define variable vWaitProcEvent as logical no-undo.
     1860      vWaitProcEvent = mWaitProcEvent.
     1861      mWaitProcEvent = no.
     1862      run WaitFramRunPause (?).
     1863      define variable vByte as int64 no-undo.
     1864      define variable vNextMese as int64 no-undo init 100000.
     1865      define variable VFlag as logical no-undo init ? .
     1866      mWaitFramStop = no.
     1867      mWaitFramStopTimeOut = no.
     1868      block-wait:
     1869      do while mHSocket:get-bytes-available() > 0:
     1870         VFlag = no.
     1871         define variable vNumByte as integer no-undo.
     1872         vNumByte =   mHSocket:get-bytes-available().
     1873         if vNumByte > 30000 then vNumByte = 30000.
     1874         SET-SIZE(vResponse) = vNumByte + 1.
     1875         SET-BYTE-ORDER(vResponse) = big-endian.
     1876         mHSocket:read(vResponse,1,vNumByte).
     1877         vMessage = vMessage + GET-STRING(vResponse,1).
     1878         if  mReturnHTTp
     1879         then do:
     1880            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     1881            if vCnt > 0
     1882            then do:
     1883               mReturnHttp = no.
     1884               mWebResphead = substring (vMessage,1,vCnt).
     1885               vMessage     = substring (vMessage,vCnt + 4).
     1886               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     1887               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     1888                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     1889                  if  v-hd-line  begins "Content-Length"  then  do:
     1890                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     1891                  end.
     1892                  else if v-hd-line  begins "Transfer-Encoding"
     1893                  then do :
     1894                     define variable vChunked as logical no-undo.
     1895                     vchunked = index(v-hd-line,"chunked",19) > 0.
     1896                  end.
     1897               end.
     1898            end.
     1899         end.
     1900         vByte = vByte + vNumByte.
     1901         SET-SIZE(vResponse) = 0.
     1902         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     1903         then
     1904            leave block-wait.
     1905         if not mHSocket:get-bytes-available() > 0
     1906         then do:
     1907            VFlag = yes.
     1908            run WaitFramRunPause (?).
     1909            run gbl/pause.p (1000) .
     1910         end.
     1911         else if vByte > vNextMese
     1912         then do:
     1913            vNextMese = vNextMese + 100000.
     1914            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     1915            run WaitFramRunPause (?).
     1916         end.
     1917         if mWaitFramStopTimeOut
     1918         then do:
     1919            mWebResp = "".
     1920            leave block-wait.
     1921         end.
     1922      end.
     1923      if VFlag ne false
     1924      then
     1925         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     1926      mWaitFramStop = yes.
     1927      run writeLogSocet         in this-procedure ("Получен ответ").
     1928      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     1929      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     1930      run writeLogSocetOnlyText in this-procedure (vMessage).
     1931      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     1932      mHSocket:disconnect() no-error.
     1933      if v-cont-length > 0
     1934      then
     1935         mWebResp = substring (vMessage,1,v-cont-length).
     1936      else if vChunked
     1937      then do:
     1938         define variable vByteCopy as int64 no-undo init 1.
     1939         Block-Copy:
     1940         do while length(vMessage) > 0:
     1941            vByteCopy = 1.
     1942            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     1943            vByteCopy = vByteCopy +  vCnt + 2.
     1944            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     1945            if v-cont-length eq 0
     1946            then
     1947               leave Block-copy.
     1948            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     1949            vByteCopy = vByteCopy + v-cont-length + 2.
     1950            vMessage = substring  (vMessage,vByteCopy).
     1951         end.
     1952         run writeLogSocet         in this-procedure ("Заголовок").
     1953         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     1954         run writeLogSocet         in this-procedure ("Тело ответа").
     1955         run writeLogSocetOnlyText in this-procedure (mWebResp).
     1956        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     1957      end.
     1958      else
     1959         mWebResp = vMessage.
     1960      mWaitProcEvent = vWaitProcEvent.
     1961      mSocetEndTime = (now - mSocetBegTime) / 1000.
     1962      copy-lob mWebResp to mWebRespMptr.
     1963      if     mWriteRespFile ne ""
     1964         and mWriteRespFile ne ?
     1965      then
     1966           run gbl/fileapnd.p
     1967                ( mWriteRespFile
     1968                , mWebResp + chr(13) + chr(10)
     1969                ,input 10
     1970                ) no-error .
     1971   end procedure.
     1972   procedure writeLogSocet:
     1973      define input  parameter itext as longchar no-undo.
     1974      if mFileLogSocet eq "Async"
     1975      then
     1976         run PutMesAsunc(itext).
     1977      else if     mFileLogSocet ne ?
     1978              and mFileLogSocet ne ""
     1979      then do:
     1980         run gbl/fileapnd.p
     1981             ( mFileLogSocet
     1982             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     1983             ,input 10
     1984             ) no-error .
     1985         run writeLogSocetOnlyText(itext).
     1986         run gbl/fileapnd.p
     1987             ( mFileLogSocet
     1988             , substitute(" &1&2", chr(13) , chr(10))
     1989             ,input 10
     1990             ) no-error .
     1991      end.
     1992   end.
     1993   procedure writeLogSocetOnlyText:
     1994      define input  parameter itext as longchar no-undo.
     1995      if mFileLogSocet eq "Async"
     1996      then
     1997         run PutMesAsunc(itext).
     1998      else if     mFileLogSocet ne ?
     1999              and mFileLogSocet ne ""
     2000      then do:
     2001         if length(itext) > 32000
     2002         then
     2003            copy-lob
     2004      from object itext
     2005      to file mFileLogSocet append
     2006      no-error
     2007      .
     2008         else
     2009         run gbl/fileapnd.p
     2010             ( mFileLogSocet
     2011             , string(itext)
     2012             ,input 10
     2013             ) no-error .
     2014      end.
     2015   end.
     2016   procedure Disconect:
     2017      mHSocket:disconnect() no-error.
     2018      delete object mHSocket no-error.
     2019   end.
     2020   define variable Mreq as longchar no-undo.
     2021   define variable m-time          as character no-undo.
     2022   function fConvetDate returns datetime
     2023       (input iTStamp as character):
     2024       define variable vDateTime as datetime no-undo.
     2025       define variable vDate     as date     no-undo.
     2026       define variable vDays     as int64    no-undo.
     2027       define variable vSec      as integer  no-undo.
     2028       vDays = truncate(int64(iTStamp) / 3600 / 24, 0).
     2029       vDate = date("01/01/1970") + vDays.
     2030       return vDate.
     2031   end function.
     2032   function fConvetDateTime returns datetime
     2033       (input iTStamp as character):
     2034       define variable vDateTime as datetime no-undo.
     2035       define variable vDate     as date     no-undo.
     2036       define variable vDays     as int64    no-undo.
     2037       define variable vSec      as integer  no-undo.
     2038       vDays = truncate(int64(iTStamp) / 3600 / 24, 0).
     2039       vDate = date("01/01/1970") + vDays.
     2040       vSec = (int64(iTStamp) - vDays * 3600 * 24).
     2041       vDateTime = datetime(string(vDate) + " " + string(vSec, "HH:MM:SS")).
     2042       return vDateTime.
     2043   end function.
     2044   define temp-table tt-chk-report-head no-undo like chk-slip-head .
     2045   define temp-table tt-one-chk-report-head no-undo like chk-slip-head .
     2046   define temp-table tt-chk-report-string no-undo like chk-slip-string .
     2047   define variable v-tth                as handle    no-undo.
     2048   define variable v-Param-Type         as character no-undo.
     2049   define variable out                  as character no-undo.
     2050   define variable in_                  as character no-undo.
     2051   define variable glog                 as logical   no-undo.
     2052   define variable v-value-character    as character no-undo.
     2053   define variable v-value-date         as date      no-undo.
     2054   define variable v-value-decimal      as decimal   no-undo.
     2055   define variable v-value-integer      as integer   no-undo.
     2056   define variable v-value-logical      as logical   no-undo.
     2057   define variable v-no-get-chk         as logical   no-undo.
     2058   define variable m-obj-code           as integer   no-undo.
     2059   define variable m-cash-num           as integer   no-undo.
     2060   define variable m-pos-type           as character no-undo.
     2061   define variable m-post-file-name     as character no-undo.
     2062   define variable m-response-file-name as character no-undo.
     2063   define variable m-xml-file-name      as character no-undo.
     2064   define variable m-obj-list           as character no-undo.
     2065   define variable m-correspondent      as character no-undo.
     2066   define variable m-timestamp          as character no-undo.
     2067   define variable Check-ctrl           as character no-undo.
     2068   define variable ErrorMessage         as character no-undo.
     2069   define variable mElement             as character no-undo.
     2070   define variable mCount               as int64     no-undo.
     2071   define variable m-err-msg            as character no-undo.
     2072   define variable m-textCheq           as longchar  no-undo.
     2073   define variable m-ParamJson          as longchar  no-undo.
     2074   run adm/shattri.p (
     2075       input "get":U
     2076       ,input  p-obj-type
     2077       ,input  p-obj-code
     2078       ,input  'get-chk':U
     2079       ,input  'no-get-chk':U
     2080       ,output v-value-character
     2081       ,output v-value-date
     2082       ,output v-value-decimal
     2083       ,output v-value-integer
     2084       ,output v-value-logical
     2085       ,output v-param-type
     2086       ,INPUT-OUTPUT table-handle v-tth
     2087       ) no-error .
     2088   v-no-get-chk = v-value-logical.
     2089   if v-no-get-chk then
     2090   do:
     2091       m-err-msg = substitute( "Согласно настроечным параметрам НЕТ приема отчетов в &1&2!!!&3"
     2092           ,p-obj-type
     2093           ,p-obj-code
     2094           ,chr(10)
     2095           ).
     2096       return error m-err-msg.
     2097   end.
     2098   run verify-ini-entry("in":U,
     2099       substitute("kassa-&1":U, 'IBM-XML':U),
     2100       substitute ("отсутствует путь к подкаталогу out" + chr(10) + "для отсылки информации на POS &1", 'IBM-XML':U),
     2101       yes,
     2102       output in_) no-error.
     2103   if error-status:error or in_ = ? then return error return-value .
     2104   RUN verify-file in this-procedure
     2105       ( in_
     2106       , substitute("Не найден каталог &1 параметр in, секция [kassa-&2] ini-файла", in_, 'IBM-XML':U)
     2107       ,yes
     2108       ,output glog) no-error.
     2109   if error-status:error or not glog then return error return-value .
     2110   run verify-ini-entry("out":U,
     2111       substitute("kassa-&1":U, 'IBM-XML':U),
     2112       substitute ("отсутствует путь к подкаталогу out" + chr(10) + "для отсылки информации на POS &1", 'IBM-XML':U),
     2113       yes,
     2114       output out) no-error.
     2115   if error-status:error or out = ? then return error return-value .
     2116   run verify-file in this-procedure
     2117       ( out
     2118       , substitute("Не найден каталог &1 параметр out, секция [kassa-&2] ini-файла", out, 'IBM-XML':U)
     2119       , yes
     2120       ,output glog) no-error.
     2121   if error-status:error or not glog then return error return-value .
     2122   run gbl/dir-cre.p ( input in_ + 'Report\') no-error .
     2123   if error-status:error then
     2124   do:
     2125       return error substitute(
     2126           "!!!Каталог &1 не найден&2" +
     2127           "и/или попытка его создания не удалась:&2&3 &4"
     2128           , in_ + 'Report\'
     2129           , chr(10)
     2130           , error-status:get-message(1)
     2131           , return-value
     2132           ).
     2133   end.
     2134   run gbl/dir-cre.p ( input out + 'Report\') no-error .
     2135   if error-status:error then
     2136   do:
     2137       return error substitute(
     2138           "!!!Каталог &1 не найден&2" +
     2139           "и/или попытка его создания не удалась:&2&3 &4"
     2140           , out + 'Report\'
     2141           , chr(10)
     2142           , error-status:get-message(1)
     2143           , return-value
     2144           ).
     2145   end.
     2146   run MainProc no-error.
     2147   if error-status:error then
     2148   do:
     2149       return error return-value.
     2150   end.
     2151   procedure MainProc:
     2152       define buffer cash-desk for cash-desk.
     2153       define variable vMsg as character no-undo.
     2154       _cash-desk:
     2155       FOR EACH cash-desk WHERE
     2156           cash-desk.db-num   = g#db-num
     2157           and cash-desk.obj-code = p-obj-code
     2158           and cash-desk.pos-type = 'IBM-XML':U
     2159           and cash-desk.cash-on  = yes
     2160           no-lock:
     2161           empty temp-table tt-chk-report-head.
     2162           empty temp-table tt-chk-report-string.
     2163           assign
     2164               m-xml-file-name      = substring(string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2165               m-obj-list           = 'маг':U + "_" + string(cash-desk.obj-code)
     2166               m-correspondent      = ("касса_" + string(cash-desk.cash-num) + "_" + m-obj-list)
     2167               m-post-file-name     = replace(out + "Report/" + m-xml-file-name, "/", "\" ) + ".xml":U
     2168               m-response-file-name = replace(in_ + "Report/" + m-xml-file-name, "/", "\" ) + ".xml":U
     2169               m-obj-code           = cash-desk.obj-code
     2170               m-pos-type           = cash-desk.pos-type
     2171               m-cash-num           = cash-desk.cash-num
     2172               mCount               = 0
     2173               .
     2174           run pGetLastTStamp(m-obj-code,
     2175               m-pos-type,
     2176               m-cash-num,
     2177               output m-timestamp).
     2178           m-time = m-timestamp .
     2179           run write-log-and-file in p-log-handle (
     2180               input 1
     2181               , input p-log-file-name
     2182               , input 1
     2183               , input substitute('Получаем данные кассовых отчетов с кассы &1://&2'
     2184               ,entry(1, cash-desk.addr-path, chr(4))
     2185               ,entry(2, cash-desk.addr-path, chr(4))
     2186               )
     2187               ).
     2188           run SaxWriter no-error.
     2189           if error-status:error then
     2190           do:
     2191               return error return-value.
     2192           end.
     2193           mWriteRespFile = m-response-file-name + "sckt".
     2194           run ConectSocet (entry(1,entry(2, cash-desk.addr-path, chr(4)),":"),
     2195               entry(2,entry(2, cash-desk.addr-path, chr(4)),":"),
     2196               "",
     2197               Mreq,
     2198               "xml",
     2199               300,
     2200               no,
     2201               substitute ("Чтение данных кассовых отчетов с кассы &1. ",entry(2, cash-desk.addr-path, chr(4)))
     2202               ).
     2203           if    mWebResp eq ""
     2204               or OerrMsg  ne ""
     2205               then
     2206           do:
     2207               run write-log-and-file in p-log-handle (
     2208                   input 1
     2209                   , input p-log-file-name
     2210                   , input 1
     2211                   , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     2212                   ,cash-desk.cash-num
     2213                   ,cash-desk.obj-code
     2214                   , chr(10)
     2215                   , OerrMsg
     2216                   )
     2217                   ).
     2218               nEXT _cash-desk.
     2219           end.
     2220           else
     2221           do:
     2222               run write-log-and-file in p-log-handle (
     2223                   input 1
     2224                   , input p-log-file-name
     2225                   , input 1
     2226                   , input substitute('Время ожидания выполнения задания на кассе - &1 c',
     2227                   mSocetEndTime
     2228                   )
     2229                   ).
     2230           end.
     2231           run SaxReader no-error.
     2232           if ErrorMessage <> "" or error-status:error then
     2233           do:
     2234               return error ErrorMessage + " " + return-value.
     2235           end.
     2236           do transaction:
     2237               for each tt-chk-report-head where
     2238                   tt-chk-report-head.cash-num = m-cash-num:
     2239                   find first chk-slip-head where
     2240                       chk-slip-head.db-num       = tt-chk-report-head.db-num
     2241                       and chk-slip-head.ID       = tt-chk-report-head.ID
     2242                       and chk-slip-head.CheckID  = tt-chk-report-head.CheckID
     2243                       and chk-slip-head.RRN      = tt-chk-report-head.RRN
     2244                       no-lock no-error.
     2245                   if not avail chk-slip-head then
     2246                   do:
     2247                       create chk-slip-head .
     2248                       buffer-copy tt-chk-report-head to chk-slip-head .
     2249                       for each tt-chk-report-string no-lock where
     2250                           tt-chk-report-string.db-num  = tt-chk-report-head.db-num
     2251                           and tt-chk-report-string.ID      = tt-chk-report-head.ID
     2252                           and tt-chk-report-string.CheckID = tt-chk-report-head.CheckID
     2253                           and tt-chk-report-string.RRN     = tt-chk-report-head.RRN
     2254                           :
     2255                           find first chk-slip-string where
     2256                               chk-slip-string.db-num    = tt-chk-report-string.db-num
     2257                               and chk-slip-string.ID        = tt-chk-report-string.ID
     2258                               and chk-slip-string.CheckID   = tt-chk-report-string.CheckID
     2259                               and chk-slip-string.RRN       = tt-chk-report-string.RRN
     2260                               and chk-slip-string.str-num   = tt-chk-report-string.str-num
     2261                               no-lock no-error.
     2262                           if not avail chk-slip-string then
     2263                           do:
     2264                               create chk-slip-string .
     2265                               buffer-copy tt-chk-report-string to chk-slip-string .
     2266                           end .
     2267                       end .
     2268                       mCount = mCount + 1.
     2269                   end.
     2270               end.
     2271               vMsg = "Загружено ФО: " + string(mCount).
     2272               run write-log-and-file in p-log-handle (
     2273                   input 1
     2274                   , input p-log-file-name
     2275                   , input 1
     2276                   , input vMsg).
     2277               p-ok = true.
     2278               find last chk-slip-head no-lock where chk-slip-head.cash-num = cash-desk.cash-num and
     2279                   chk-slip-head.obj-code = cash-desk.obj-code and
     2280                   chk-slip-head.db-num = cash-desk.db-num and
     2281                   chk-slip-head.is-report = 1 no-error .
     2282               define variable v-value as character no-undo .
     2283               define variable v-time1 as character no-undo .
     2284               define variable v-time  as character no-undo .
     2285               v-time1 = entry(2,string(chk-slip-head.slip-dt)," ") .
     2286               v-time =  entry(1,v-time1,".") .
     2287               v-value = string(YEAR(date(chk-slip-head.slip-dt)), "9999":U) + "-":U +
     2288                   string(Month(date(chk-slip-head.slip-dt)), "99":U) + "-":U +
     2289                   string(DAY(date(chk-slip-head.slip-dt)), "99":U) .
     2290     run cd-attr-write in this-procedure (
     2291                                            input cash-desk.db-num
     2292                                           ,input cash-desk.obj-code
     2293                                           ,input cash-desk.pos-type
     2294                                           ,input cash-desk.cash-num
     2295                                           ,input (if cash-desk.pos-type = 'IBM-XML':U
     2296                                                   then 'IBM-XML_operative':U
     2297                                                   else if cash-desk.pos-type = 'Autotank':U
     2298                                                   then 'AUTOTANK_operative':U else "")
     2299                                           ,input (if cash-desk.pos-type = 'IBM-XML':U
     2300                                                   then 'last-report-params':U
     2301                                                   else if cash-desk.pos-type = 'Autotank':U
     2302                                                   then 'last-report-params':U
     2303                                                   else "")
     2304                                           ,input (v-value + chr(32) + v-time
     2305                                                +  (if cash-desk.pos-type = 'IBM-XML':U
     2306                                                    or cash-desk.pos-type = 'Autotank':U
     2307                                                  then (chr(32) + string(chk-slip-head.CashShiftNum) )
     2308                                                  else  "":U)
     2309                                                  )
     2310                                           ,input ?
     2311                                           ,input 0.0
     2312                                           ,input 0
     2313                                           ,input no
     2314                                           ) no-error.
     2315   end.
     2316   end.
     2317     define variable slip-dt as character no-undo .
     2318     define buffer buf_chk-slip-head for ub.chk-slip-head .
     2319     if m-time = "0" then slip-dt = string(01/01/1900) . else slip-dt = string(fConvetDateTime(m-time)) .
     2320             find first buf_chk-slip-head no-lock where buf_chk-slip-head.db-num = g#db-num and
     2321             buf_chk-slip-head.obj-code = p-obj-code and
     2322             buf_chk-slip-head.is-report = 1 and
     2323             buf_chk-slip-head.slip-dt > datetime(slip-dt) no-error .
     2324             if available (buf_chk-slip-head) then do:
     2325             run bge\send1cerp.p (parparentproc,
     2326               this-procedure,
     2327               this-procedure,
     2328               "chkSlipHead",
     2329               (buffer buf_chk-slip-head:handle),
     2330               ?,
     2331               ?) no-error.
     2332           if  error-status:error then
     2333           do:
     2334               message return-value
     2335                   view-as alert-box.
     2336               return .
     2337           end.
     2338           end.
     2339   end procedure.
     2340   procedure pGetLastTStamp:
     2341       define input  parameter p-obj-code as integer   no-undo.
     2342       define input  parameter p-pos-type as character no-undo.
     2343       define input  parameter p-cash-num as integer   no-undo.
     2344       define output parameter oTStamp    as character no-undo.
     2345       define buffer chk-slip-head for chk-slip-head.
     2346       define variable v-last-date      as date    no-undo .
     2347       define variable v-last-time      as integer no-undo .
     2348       define variable v-last-shift-num as integer no-undo .
     2349       define variable v-last-z-count   as integer no-undo .
     2350       define variable v-last-chk-num   as integer no-undo .
     2351       run get-last-report-params in this-procedure ( input g#db-num
     2352           ,input p-obj-code
     2353           ,input p-pos-type
     2354           ,input p-cash-num
     2355           ,output v-last-date
     2356           ,output v-last-time
     2357           ,output v-last-shift-num
     2358           ) no-error.
     2359       if v-last-date <> ? then
     2360           oTStamp = string( ( v-last-date - date( "01/01/1970" ) ) * 24 * 3600 + v-last-time - Timezone * 60 - 1 * 60 * 60, ">>>>>>>>>9" ).
     2361       else
     2362           oTStamp = "0".
     2363   end procedure.
     2364   procedure SaxWriter:
     2365       define variable hSAXWriter as handle no-undo.
     2366       create sax-writer hSAXWriter.
     2367       hSAXWriter:set-output-destination("longchar", Mreq) no-error.
     2368       hSAXWriter:formatted = true.
     2369       hSAXWriter:encoding = "windows-1251".
     2370       hSAXWriter:start-document() no-error.
     2371       hSAXWriter:start-element("reports") no-error.
     2372       hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
     2373       hSAXWriter:insert-attribute("id",     m-xml-file-name) no-error.
     2374       hSAXWriter:insert-attribute("from",   m-obj-list)      no-error.
     2375       hSAXWriter:insert-attribute("to",     m-correspondent) no-error.
     2376       hSAXWriter:insert-attribute("tstamp", m-timestamp)     no-error.
     2377       hSAXWriter:end-element("reports") no-error.
     2378       hSAXWriter:end-document() no-error.
     2379       if hSAXWriter:write-status = 7 then
     2380       do:
     2381           delete object hSAXWriter no-error.
     2382           return error.
     2383       end.
     2384       delete object hSAXWriter no-error.
     2385   end.
     2386   procedure SaxReader:
     2387       define variable hParser as handle no-undo.
     2388       create sax-reader hParser.
     2389       define variable vmemptr as memptr no-undo.
     2390       copy-lob mWebResp to vmemptr.
     2391       hParser:set-input-source("memptr", vmemptr).
     2392       hParser:sax-parse () no-error.
     2393       if error-status:error then
     2394       do:
     2395           if error-status:num-messages > 0 then
     2396               return error error-status:get-message(1).
     2397           else
     2398               return error return-value.
     2399       end.
     2400       delete object hParser.
     2401   end.
     2402   PROCEDURE StartDocument:
     2403   END PROCEDURE.
     2404   PROCEDURE StartElement:
     2405       DEFINE INPUT PARAMETER namespaceURI AS CHARACTER.
     2406       DEFINE INPUT PARAMETER localName AS CHARACTER.
     2407       DEFINE INPUT PARAMETER qname AS CHARACTER.
     2408       DEFINE INPUT PARAMETER attributes AS HANDLE.
     2409       mElement = qname.
     2410       if mElement = "report" then
     2411       do:
     2412           if attributes:GET-VALUE-BY-QNAME("code") <> ? then
     2413           do:
     2414               empty temp-table tt-one-chk-report-head.
     2415               create tt-one-chk-report-head.
     2416               assign
     2417                   tt-one-chk-report-head.db-num    = g#db-num
     2418                   tt-one-chk-report-head.obj-code  = m-obj-code
     2419                   tt-one-chk-report-head.ID        = attributes:GET-VALUE-BY-QNAME("code")
     2420                   tt-one-chk-report-head.is-report = 1
     2421                   .
     2422           end.
     2423       end.
     2424       if mElement = "STextCheq" then
     2425       do:
     2426           m-textCheq = "" .
     2427       end .
     2428       if mElement = "SParamJSON" then
     2429       do:
     2430           m-ParamJSON = "" .
     2431       end .
     2432   END PROCEDURE.
     2433   PROCEDURE Characters:
     2434       DEFINE INPUT PARAMETER charData AS MEMPTR.
     2435       DEFINE INPUT PARAMETER numChars AS INTEGER.
     2436       define variable vCurrContent  as longchar no-undo.
     2437       define variable vLengthMemptr as int64    no-undo.
     2438       define variable vReadByte     as int64    no-undo.
     2439       define variable vRead         as integer  no-undo.
     2440       vLengthMemptr = numChars.
     2441       do while vLengthMemptr - vReadByte > 0 :
     2442           vRead = min(vLengthMemptr - vReadByte,30000).
     2443           vCurrContent = vCurrContent + GET-STRING(charData,vReadByte + 1,vRead).
     2444           vReadByte = vReadByte + vRead.
     2445       end.
     2446       if trim(vCurrContent) = "" then return.
     2447       case mElement:
     2448           when "SUuidCheq" then
     2449               tt-one-chk-report-head.CheckID = vCurrContent .
     2450           when "SRRN" then
     2451               tt-one-chk-report-head.RRN = vCurrContent .
     2452           when "SDate" then
     2453               tt-one-chk-report-head.slip-dt = fConvetDateTime(string(vCurrContent)) no-error.
     2454           when "ShiftDate" then
     2455               tt-one-chk-report-head.CashShiftDate = fConvetDate(string(vCurrContent)) no-error.
     2456           when "ShiftNum" then
     2457               tt-one-chk-report-head.CashShiftNum = integer(vCurrContent) no-error.
     2458           when "SProc" then
     2459               tt-one-chk-report-head.proc-type = integer(vCurrContent) no-error.
     2460           when "RSrc" then
     2461               tt-one-chk-report-head.src_ = integer(vCurrContent) no-error.
     2462           when "RType" then
     2463               tt-one-chk-report-head.kind = integer(vCurrContent) no-error.
     2464           when "Report" then
     2465               tt-one-chk-report-head.is-report = integer(vCurrContent) no-error.
     2466           when "KassaNumber" then
     2467               tt-one-chk-report-head.cash-num = integer(vCurrContent) no-error.
     2468           when "SParamJSON" then
     2469               do :
     2470                   m-ParamJson = m-ParamJson + vCurrContent .
     2471               end .
     2472           when "ErrorMessage" then
     2473               ErrorMessage = vCurrContent.
     2474           when "STextCheq"
     2475           then
     2476               do :
     2477                   m-textCheq = m-textCheq + vCurrContent .
     2478               end .
     2479       end case.
     2480   END PROCEDURE.
     2481   PROCEDURE EndElement:
     2482       DEFINE INPUT PARAMETER name_ AS CHARACTER.
     2483       DEFINE INPUT PARAMETER localName AS CHARACTER.
     2484       DEFINE INPUT PARAMETER qName AS CHARACTER.
     2485       define variable ii as integer no-undo .
     2486       if qname = "ErrorMessage" then
     2487       do:
     2488           self:stop-parsing ().
     2489       end.
     2490       else
     2491           if qName = "report" then
     2492           do:
     2493               if tt-one-chk-report-head.ID > "" and tt-one-chk-report-head.cash-num > 0
     2494                   then
     2495               do :
     2496                   find first tt-chk-report-head where tt-chk-report-head.db-num    = tt-one-chk-report-head.db-num
     2497                       and tt-chk-report-head.ID        = tt-one-chk-report-head.ID
     2498                       no-error .
     2499                   if not available tt-chk-report-head
     2500                       then
     2501                   do :
     2502                       create tt-chk-report-head .
     2503                       buffer-copy tt-one-chk-report-head to tt-chk-report-head .
     2504                   end .
     2505               end .
     2506           end.
     2507       if qName = "STextCheq" then
     2508       do:
     2509           if tt-one-chk-report-head.ID > ""
     2510               then
     2511           do :
     2512               do ii = 1 to num-entries(m-textCheq, chr(10)) :
     2513                   create tt-chk-report-string.
     2514                   assign
     2515                       tt-chk-report-string.db-num    = tt-one-chk-report-head.db-num
     2516                       tt-chk-report-string.ID        = tt-one-chk-report-head.ID
     2517                       tt-chk-report-string.CheckID   = tt-one-chk-report-head.CheckID
     2518                       tt-chk-report-string.RRN       = tt-one-chk-report-head.RRN
     2519                       tt-chk-report-string.str-num   = ii
     2520                       tt-chk-report-string.str-value = entry(ii, m-textCheq, chr(10))
     2521                       .
     2522               end .
     2523           end .
     2524       end.
     2525       if qName = "SParamJSON" then
     2526       do:
     2527           if tt-one-chk-report-head.ID > ""
     2528               then
     2529           do :
     2530               do ii = 10001 to num-entries(m-ParamJson, chr(10)) :
     2531                   create tt-chk-report-string.
     2532                   assign
     2533                       tt-chk-report-string.db-num    = tt-one-chk-report-head.db-num
     2534                       tt-chk-report-string.ID        = tt-one-chk-report-head.ID
     2535                       tt-chk-report-string.CheckID   = tt-one-chk-report-head.CheckID
     2536                       tt-chk-report-string.RRN       = tt-one-chk-report-head.RRN
     2537                       tt-chk-report-string.str-num   = ii
     2538                       tt-chk-report-string.str-value = entry(ii, m-ParamJson, chr(10))
     2539                       .
     2540               end .
     2541           end .
     2542       end .
     2543   END PROCEDURE.
     2544   PROCEDURE EndDocument:
     2545       p-ok = true.
     2546   END PROCEDURE.
     2547   PROCEDURE Warning:
     2548       DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2549       MESSAGE "The following WARNING was generated:~n" + ErrMessage
     2550           VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2551   END PROCEDURE.
     2552   PROCEDURE Error:
     2553       DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2554       p-ok = false.
     2555       MESSAGE "The following NONFATAL ERROR was generated:~n" + ErrMessage
     2556           VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2557   END PROCEDURE.
     2558   PROCEDURE FatalError:
     2559       DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2560       p-ok = false.
     2561       RETURN ERROR "The following FATAL ERROR was generated:~n" + ErrMessage.
     2562   END PROCEDURE.
