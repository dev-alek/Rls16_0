     1255   procedure gdsoattr-copy :
     1256     define input  parameter p-code as character no-undo .
     1257     define output parameter p-copy as logical   no-undo .
     1258     do
     1259     on error undo, return error
     1260     :
     1261           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-copy in g#attr-lib
     1262         (input  p-code
     1263         ,output p-copy
     1264         ) no-error .
     1265       if error-status :error
     1266       then do:
     1267         undo, return error return-value .
     1268       end.
     1269     end.
     1270   end.
     1271   procedure gds-attr_check-code-dt-seasons :
     1272     define input  parameter p-code     like ub.goods.gds-code   no-undo .
     1273     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     1274     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
     1275     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
     1276     define output parameter p-dt-code  as   integer             no-undo .
     1277     do
     1278     on error undo, return error
     1279     :
     1280           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
     1281         (input p-code
     1282         ,input p-obj-type
     1283         ,input p-obj-code
     1284         ,output p-gds-code
     1285         ,output p-dt-code
     1286         ) no-error .
     1287       if error-status :error
     1288       then do:
     1289         undo, return error return-value .
     1290       end.
     1291     end.
     1292   end.
     1293   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   PROCEDURE verify-ini-entry:
     1295   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1296   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1297   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1298   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1299   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1300   define variable v-mess as character no-undo .
     1301   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1302   if ini-entry-value = ? and ini-key-name begins "spl"
     1303   then
     1304   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1305   if ini-entry-value = ? and ini-key-name begins "sav"
     1306   then
     1307   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1308   if ini-entry-value = ? then do:
     1309     assign
     1310     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1311                       , chr(10)
     1312                       , ini-section-name
     1313                       , ini-key-name
     1314                       , error-msg-text).
     1315       if not silence then do:
     1316         message
     1317         v-mess
     1318         view-as alert-box ERROR  .
     1319         return error.
     1320       end.
     1321       else do:
     1322         return error v-mess.
     1323       end.
     1324   end.
     1325   END PROCEDURE.
     1326   PROCEDURE verify-file:
     1327   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1328   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1329   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1330   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1331   file-info:file-name = filename.
     1332   found = NOT (file-info:full-pathname = ?).
     1333   if NOT found  then do:
     1334     if not silence then do:
     1335       message error-msg-text
     1336       view-as alert-box ERROR.
     1337       return error.
     1338     end.
     1339     else return error error-msg-text.
     1340   end.
     1341   END PROCEDURE.
     1342   define variable vss-revision5    as character no-undo init "$Revision:$":U .
     1343   define variable vss-author5      as character no-undo init "$Author:$":U .
     1344   define variable vss-date5        as character no-undo init "$Date:$":U .
     1345   define variable vss-workfile5    as character no-undo init "$Workfile:$":U .
     1346   define variable vss-archive5     as character no-undo init "$Archive:$":U .
     1347   define variable vss-description5 as character no-undo init "Работа С сокетом".
     1348   procedure PutMesAsunc:
     1349       define input  parameter Itext as character no-undo.
     1350       define variable vflag as logical no-undo.
     1351       Publish "WriteLogAsunc" (Itext, yes)  .
