      616   procedure get-last-check-date-time :
      617       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      618       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      619       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      620       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      621       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      622       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      623       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      624       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      625       define variable v-character as character no-undo .
      626       define variable v-date      as date      no-undo .
      627       define variable v-decimal   as decimal   no-undo .
      628       define variable v-integer   as integer   no-undo .
      629       define variable v-logical   as logical   no-undo .
      630       define variable v-attr-type as character no-undo .
      631       define buffer buf_chk-doc     for ub.chk-doc.
      632       define buffer buf_c-cash-desk for ub.c-cash-desk.
      633       do
      634           on error undo, return error
      635           :
      636           run cd-attr-value in this-procedure (
      637               input g#db-num
      638               ,input p-obj-code
      639               ,input p-pos-type
      640               ,input p-cash-num
      641               ,input 'MAGIA-XML_operative':U
      642               ,input 'last-check-date-time':U
      643               ,output v-character
      644               ,output v-date
      645               ,output v-decimal
      646               ,output v-integer
      647               ,output v-logical
      648               ,output v-attr-type     ) no-error.
      649           if v-character = "":U
      650               or v-character = ?
      651               then
      652           do:
      653               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      654                   buf_c-cash-desk.db-num = g#db-num
      655                   AND buf_c-cash-desk.pos-type = p-pos-type
      656                   AND buf_c-cash-desk.cash-num = p-cash-num
      657                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      658                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      659               if available buf_c-cash-desk then
      660               do:
      661                   assign
      662                       p-date = buf_c-cash-desk.corr-date
      663                       p-time = buf_c-cash-desk.corr-time
      664                       .
      665               end.
      666               else
      667               do:
      668                   find first buf_chk-doc no-lock where
      669                       buf_chk-doc.obj-type = 'маг':U
      670                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      671                   if not available buf_chk-doc then
      672                   do:
      673                       return error.
      674                   end.
      675                   assign
      676                       p-date = buf_chk-doc.chk-date - 1
      677                       p-time = buf_chk-doc.chk-time
      678                       .
      679               end.
      680           end.
      681           else
      682           do:
      683               assign
      684                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      685           no-error .
      686               if error-status:error then return error .
      687           end.
      688       end.
      689   end procedure.
      690   procedure get-last-check-params :
      691       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      692       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      693       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      694       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      695       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      696       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      697       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      698       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      699       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      700       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      701       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      702       define variable v-character as character no-undo .
      703       define variable v-date      as date      no-undo .
      704       define variable v-decimal   as decimal   no-undo .
      705       define variable v-integer   as integer   no-undo .
      706       define variable v-logical   as logical   no-undo .
      707       define variable v-attr-type as character no-undo .
      708       define buffer buf_chk-doc     for ub.chk-doc.
      709       define buffer buf_c-cash-desk for ub.c-cash-desk.
      710       do
      711           on error undo, return error
      712           :
      713           run cd-attr-value in this-procedure (
      714               input g#db-num
      715               ,input p-obj-code
      716               ,input p-pos-type
      717               ,input p-cash-num
      718               ,input if p-pos-type eq 'IBM-XML':U
      719               then 'IBM-XML_operative':U
      720               else 'AUTOTANK_operative':U
      721               ,input if p-pos-type = 'IBM-XML':U
      722               then 'last-check-params':U
      723               else 'last-check-params':U
      724               ,output v-character
      725               ,output v-date
      726               ,output v-decimal
      727               ,output v-integer
      728               ,output v-logical
      729               ,output v-attr-type     ) no-error.
      730           if v-character = "":U
      731               or v-character = ?
      732               then
      733           do:
      734               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      735                   buf_c-cash-desk.db-num = g#db-num
      736                   AND buf_c-cash-desk.pos-type = p-pos-type
      737                   AND buf_c-cash-desk.cash-num = p-cash-num
      738                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      739                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      740               if available buf_c-cash-desk then
      741               do:
      742                   assign
      743                       p-date = buf_c-cash-desk.corr-date
      744                       p-time = buf_c-cash-desk.corr-time
      745                       .
      746               end.
      747               else
      748               do:
      749                   find first buf_chk-doc no-lock where
      750                       buf_chk-doc.obj-type = 'маг':U
      751                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      752                   if not available buf_chk-doc then
      753                   do:
      754                       return error.
      755                   end.
      756                   assign
      757                       p-date      = buf_chk-doc.chk-date - 1
      758                       p-time      = buf_chk-doc.chk-time
      759                       p-shift-num = buf_chk-doc.shift-num
      760                       p-z-count   = buf_chk-doc.z-number
      761                       p-chk-num   = buf_chk-doc.chk-num
      762                       .
      763               end.
      764           end.
      765           else
      766           do:
      767               assign
      768                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      769                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      770                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      771                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      772                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      773                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      774           no-error .
      775               if error-status:error then return error .
      776           end.
      777       end.
      778   end procedure.
      779   procedure get-last-report-params :
      780       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      781       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      782       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      783       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      784       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      785       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      786       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      787       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      788       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      789       define variable v-character as character no-undo .
      790       define variable v-date      as date      no-undo .
      791       define variable v-decimal   as decimal   no-undo .
      792       define variable v-integer   as integer   no-undo .
      793       define variable v-logical   as logical   no-undo .
      794       define variable v-date1     as character no-undo .
      795       define variable v-date2     as character no-undo .
      796       define variable v-attr-type as character no-undo .
      797       define buffer buf_chk-slip-head for ub.chk-slip-head.
      798       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      799       do
      800           on error undo, return error
      801           :
      802           run cd-attr-value in this-procedure (
      803               input g#db-num
      804               ,input p-obj-code
      805               ,input p-pos-type
      806               ,input p-cash-num
      807               ,input if p-pos-type eq 'IBM-XML':U
      808               then 'IBM-XML_operative':U
      809               else 'AUTOTANK_operative':U
      810               ,input if p-pos-type = 'IBM-XML':U
      811               then 'last-report-params':U
      812               else 'last-report-params':U
      813               ,output v-character
      814               ,output v-date
      815               ,output v-decimal
      816               ,output v-integer
      817               ,output v-logical
      818               ,output v-attr-type     ) no-error.
      819           if v-character = "":U
      820               or v-character = ?
      821               then
      822           do:
      823               find last buf_chk-slip-head no-lock where
      824                   buf_chk-slip-head.obj-code = p-obj-code
      825                   and buf_chk-slip-head.cash-num = p-cash-num
      826                   and buf_chk-slip-head.db-num = p-db-num
      827                   and buf_chk-slip-head.is-report = 1 no-error.
      828               if not available buf_chk-slip-head then
      829               do:
      830                   return error.
      831               end.
      832               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      833               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      834                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      835                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      836                   + " " + entry(1,v-date2,".") .
      837               assign
      838                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      839                   p-shift-num = buf_chk-slip-head.CashShiftNum
      840                   .
      841           end.
      842           else
      843           do:
      844               assign
      845                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      846                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      847                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      848           no-error .
      849               if error-status:error then return error .
      850           end.
      851       end.
      852   end procedure.
      853   procedure get-last-check-maria :
      854       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      855       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      856       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      857       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      858       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      859       define output parameter p-num-recs as integer no-undo .
      860       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      861       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      862       define output parameter p-p-num-recs as integer no-undo .
      863       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      864       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      865       define variable v-character as character no-undo .
      866       define variable v-date      as date      no-undo .
      867       define variable v-decimal   as decimal   no-undo .
      868       define variable v-integer   as integer   no-undo .
      869       define variable v-logical   as logical   no-undo .
      870       define variable v-attr-type as character no-undo .
      871       define buffer buf_chk-doc     for ub.chk-doc.
      872       define buffer buf_c-cash-desk for ub.c-cash-desk.
      873       do
      874           on error undo, return error
      875           :
      876           run cd-attr-value in this-procedure (
      877               input p-db-num
      878               ,input p-obj-code
      879               ,input 'MARIA':U
      880               ,input p-cash-num
      881               ,input 'MARIA_operative':U
      882               ,input 'last-check-maria':U
      883               ,output v-character
      884               ,output v-date
      885               ,output v-decimal
      886               ,output v-integer
      887               ,output v-logical
      888               ,output v-attr-type     ) no-error.
      889           if v-character = "":U
      890               or v-character = ?
      891               then
      892           do:
      893               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      894                   buf_c-cash-desk.db-num = p-db-num
      895                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      896                   AND buf_c-cash-desk.cash-num = p-cash-num
      897                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      898                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      899               if available buf_c-cash-desk then
      900               do:
      901                   assign
      902                       p-date   = buf_c-cash-desk.corr-date
      903                       p-p-date = buf_c-cash-desk.corr-date
      904                       .
      905               end.
      906               else
      907               do:
      908                   find first buf_chk-doc no-lock where
      909                       buf_chk-doc.obj-type = 'маг':U
      910                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      911                   if not available buf_chk-doc then
      912                   do:
      913                       assign
      914                           p-date       = 01/01/1990
      915                           p-z-count    = 1
      916                           p-num-recs   = 0
      917                           p-p-date     = 01/01/1990
      918                           p-p-z-count  = 1
      919                           p-p-num-recs = 0
      920                           .
      921                   end.
      922                   assign
      923                       p-date       = buf_chk-doc.chk-date - 1
      924                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      925                       p-num-recs   = 0
      926                       p-p-date     = buf_chk-doc.chk-date - 1
      927                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      928                       p-p-num-recs = 0
      929                       .
      930               end.
      931           end.
      932           else
      933           do:
      934               assign
      935                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      936                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      937                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      938                         )
      939                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      940                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      941                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      942                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      943                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      944                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      945                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      946                         )
      947                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
      948                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
      949                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
      950                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
      951           no-error .
      952               if error-status:error then return error .
      953           end.
      954       end.
      955   end procedure.
      956   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
