     2189     run fltfield-add in this-procedure('str-uslov-oplat', 'Условия оплаты', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2190     run fltfield-add in this-procedure('srok-opl', 'Отсрочка', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2191     run fltfield-add in this-procedure('contract-name', 'Заголовок', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2192     run fltfield-add in this-procedure('contract-city', 'Город', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2193     run fltfield-add in this-procedure('contract-date-beg', 'Дата начала договора', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2194     run fltfield-add in this-procedure('contract-date-end', 'Дата конца договора', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2195     run fltfield-add in this-procedure('curr-code', 'Валюта', 'curr',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2196     run fltfield-add in this-procedure('user-name', 'Имя оператора', 'usr',                input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2197     run fltfield-add in this-procedure('cli-type*cli-code'  , 'Контрагент' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2198     run fltfield-add in this-procedure('posr-type*posr-code'  , 'Посредник' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2199     run fltfield-add in this-procedure('agnt-type*agnt-code'  , 'Агент' , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2200   Filter-Block:
     2201   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2202       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2203       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2204     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2205     RUN OpenBr(yes, no, '':U).
     2206   END.
     2207   END.
     2208   ON CHOOSE OF b-SlaveContract IN FRAME Dialog-Frame
     2209   DO:
     2210     DEFINE VARIABLE v-cError AS CHARACTER NO-UNDO INITIAL "".
     2211     DEFINE VARIABLE iTmp     AS INTEGER   NO-UNDO INITIAL 0.
     2212     IF AVAILABLE buf_Contract THEN DO:
     2213     ASSIGN
     2214        iTmp = Is-MS-Contract-Int (BUFFER buf_Contract).
     2215        IF iTmp = 2 THEN DO:
     2216           MESSAGE
     2217               "Текущий договор является подчиненным !" SKIP
     2218               "Нельзя привязывать к подчиненному договору другие договора !" SKIP
     2219               VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2220           RETURN NO-APPLY.
     2221        END.
     2222        IF iTmp = 0 AND buf_contract.status_ = 'зкр':U THEN DO:
     2223           MESSAGE
     2224               "Договор уже закрыт !"
     2225               VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2226           RETURN NO-APPLY.
     2227        END.
     2228        RUN str/cont-slave.w  (
     2229            input  parparentproc,
     2230            "",
     2231            ""  ,
     2232            input  p-host-code,
     2233            BUFFER buf_Contract,
     2234            OUTPUT v-cError
     2235            ) NO-ERROR.
     2236        IF ERROR-STATUS:ERROR THEN DO:
     2237           MESSAGE ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE VIEW-AS ALERT-BOX.
     2238        END.
     2239        IF v-cError <> "" THEN DO:
     2240           MESSAGE v-cError VIEW-AS ALERT-BOX.
     2241        END.
     2242        Contr-list:REFRESH().
     2243     END.
     2244   END.
     2245   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2246   DO:
     2247     if b-mark:sensitive = no or p-rid-list = "" then do:
     2248       if available buf_contract then p-rid-list = string( recid( buf_contract ) ) .
     2249     end.
     2250   END.
     2251   ON VALUE-CHANGED OF Cli-Status IN FRAME Dialog-Frame
     2252   DO:
     2253     assign Cli-Status .
     2254     case Cli-Status :
     2255       when "all"     then assign p-status = ? .
     2256       when "current" then assign p-status = 'тек':U .
     2257       when "deleted" then assign p-status = 'зкр':U .
     2258     end.
     2259     RUN OpenBr(yes, no, '':U).
     2260     apply "entry" to Contr-List .
     2261   END.
     2262   ON VALUE-CHANGED OF Cli-Types IN FRAME Dialog-Frame
     2263   DO:
     2264     assign Cli-Types .
     2265     if Cli-Types = "sel" then do:
     2266       run ref/cli-all.w (parParentProc, "b-sel", 'орг':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output org-list ) .
     2267       if org-list = "" then do:
     2268         assign Cli-Types = "all" .
     2269         disp Cli-Types with frame Dialog-Frame.
     2270       end.
     2271       else do:
     2272         find first ub.clients no-lock where recid(ub.clients) = int(org-list) no-error .
     2273         assign
     2274           p-cli-type = ub.clients.obj-type
     2275           p-cli-code = ub.clients.obj-code
     2276         .
     2277       end.
     2278     end .
     2279     RUN OpenBr(yes, no, '':U).
     2280   END.
     2281   ON value-changed OF Contr-List IN FRAME Dialog-Frame
     2282   DO:
     2283     if available buf_contract then do:
     2284       assign
     2285         user-name = usrfulnf(buf_contract.user-name)
     2286       .
     2287       disp user-name with frame Dialog-Frame.
     2288     end.
     2289   END.
     2290   ON RETURN OF Contr-List IN FRAME Dialog-Frame
     2291   or MOUSE-SELECT-DBLCLICK OF Contr-List IN FRAME Dialog-Frame
     2292   DO:
     2293     if b-sel:sensitive in frame Dialog-Frame then do:
     2294       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     2295       else                     apply "choose" to b-sel in frame Dialog-Frame.
     2296     end.
     2297     else if B-lkp:sensitive then apply "choose" to B-lkp in frame Dialog-Frame.
     2298   END.
     2299   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2300   DO:
     2301     run proc-find-code  in this-procedure(yes, input frame Dialog-Frame sch-code ) no-error.
     2302     if error-status:error then return no-apply.
     2303   END.
     2304   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2305   DO:
     2306     run proc-find-code  in this-procedure(no, input frame Dialog-Frame sch-code ) no-error.
     2307     if error-status:error then return no-apply.
     2308   END.
     2309   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     2310   DO:
     2311     run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-date) no-error.
     2312     if error-status:error then return no-apply.
     2313   END.
     2314   ON RETURN OF sch-date IN FRAME Dialog-Frame
     2315   DO:
     2316     run proc-find-date in this-procedure(no, input frame Dialog-Frame sch-date) no-error.
     2317     if error-status:error then return no-apply.
     2318   END.
     2319   b-gen:menu-mouse = 1.
     2320   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   on INS of frame Dialog-Frame anywhere do:
     2322     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2323     return no-apply.
