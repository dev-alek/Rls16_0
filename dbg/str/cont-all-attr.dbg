      964      .
      965   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      966   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      967   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      968   FUNCTION Can-Find-Spec RETURN LOGICAL (
      969      INPUT iHost-Code    AS INTEGER,
      970      INPUT iContract-Num AS INTEGER,
      971      INPUT iGds-Code     AS INTEGER ):
      972      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      973      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      974      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      975      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      976      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      977      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      978          INPUT  iHost-Code,
      979          INPUT  iContract-Num,
      980          OUTPUT iTmp-Extent3
      981          ).
      982      IF iTmp-Extent3[1] = 2 THEN DO:
      983         ASSIGN
      984            iTmp-Host-Code      = iTmp-Extent3[2]
      985            iTmp-Contract-Num   = iTmp-Extent3[3]
      986            .
      987      END. ELSE DO:
      988         ASSIGN
      989            iTmp-Host-Code      = iHost-Code
      990            iTmp-Contract-Num   = iContract-Num
      991            .
      992      END.
      993      IF iGds-Code = ? THEN DO:
      994         ASSIGN
      995            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      996                                  buf_Spec.Host-Code     = iTmp-Host-Code
      997                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      998                           ).
      999      END. ELSE DO:
     1000            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1001                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1002                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1003                              AND buf_Spec.Gds-Code      = iGds-Code
     1004                            ).
     1005      END.
     1006      RETURN (lRet).
     1007   END FUNCTION.
     1008   PROCEDURE MS-Contract-EXTENT-3:
     1009      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1010      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1011      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1012      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1013      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1014      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1015      FIND FIRST buf_Cont-2 WHERE
     1016                 buf_Cont-2.Host-Code      = i-Host-Code
     1017             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1018           NO-LOCK NO-ERROR.
     1019      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1020         RETURN.
     1021      END.
     1022      FOR FIRST buf_Ext-Classif WHERE
     1023                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1024           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1025                                               STRING(i-Contract-code)
     1026           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1027          NO-LOCK,
     1028          EACH buf_Cont WHERE
     1029               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1030           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1031          NO-LOCK:
     1032          ASSIGN
     1033             i-Ret[1] = 1
     1034             i-Ret[2] = buf_Cont.Host-code
     1035             i-Ret[3] = buf_Cont.Contract-code
     1036             .
     1037          LEAVE.
     1038      END.
     1039      IF i-Ret[1] <> 1 THEN DO:
     1040         FOR FIRST buf_Ext-Classif WHERE
     1041                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1042              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1043                                                  STRING(i-Contract-code)
     1044              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1045             NO-LOCK,
     1046             EACH buf_Cont WHERE
     1047                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1048              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1049             NO-LOCK:
     1050             ASSIGN
     1051                i-Ret[1] = 2
     1052                i-Ret[2] = buf_Cont.Host-code
     1053                i-Ret[3] = buf_Cont.Contract-code
     1054                .
     1055             LEAVE.
     1056         END.
     1057      END.
     1058      RETURN.
     1059   END PROCEDURE.
     1060   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     1062   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     1063            INPUT iHost-Code AS INTEGER,
     1064            INPUT iContract-Code  AS INTEGER,
     1065            INPUT cAttr-code      AS CHARACTER):
     1066      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     1067      FIND FIRST buf_Contract-Attr WHERE
     1068                 buf_Contract-Attr.Host-code     = iHost-Code
     1069             AND buf_Contract-Attr.Contract-code = iContract-Code
     1070             AND buf_Contract-Attr.Attr-code     = cAttr-code
     1071           NO-LOCK NO-ERROR.
     1072      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     1073   END FUNCTION.
     1074   PROCEDURE Modify-Contract-Attr:
     1075      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1076      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1077      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1078      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1079      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1080      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1081      Tran:
     1082      DO TRANSACTION
     1083         ON ENDKEY UNDO Tran, RETRY Tran
     1084         ON ERROR  UNDO Tran, RETRY Tran
     1085         ON QUIT   UNDO Tran, RETRY Tran
     1086         ON STOP   UNDO Tran, RETRY Tran:
     1087         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1088         FIND FIRST buf_Contract-Attr WHERE
     1089                    buf_Contract-Attr.Host-Code      = iHost-Code
     1090                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     1091                AND buf_Contract-Attr.Attr-code      = cAttr-code
     1092              NO-LOCK NO-ERROR.
     1093         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     1094            CREATE buf_Contract-Attr NO-ERROR.
     1095            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1096         END. ELSE DO:
     1097            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     1098            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1099         END.
     1100         ASSIGN
     1101            buf_Contract-Attr.Host-Code      = iHost-Code
     1102            buf_Contract-Attr.Contract-Code  = iContract-Code
     1103            buf_Contract-Attr.Attr-code      = cAttr-code
     1104            buf_Contract-Attr.Attr-value     = cAttr-value
     1105            NO-ERROR.
     1106         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1107         RELEASE buf_Contract-Attr NO-ERROR.
     1108         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1109      END.
     1110      RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE Create-Contract-Attr:
     1113      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1114      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1115      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1116      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1117      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1118      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1119      Tran:
     1120      DO TRANSACTION
     1121         ON ENDKEY UNDO Tran, RETRY Tran
     1122         ON ERROR  UNDO Tran, RETRY Tran
     1123         ON QUIT   UNDO Tran, RETRY Tran
     1124         ON STOP   UNDO Tran, RETRY Tran:
     1125         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1126         CREATE buf_Contract-Attr NO-ERROR.
     1127         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1128         ASSIGN
     1129            buf_Contract-Attr.Host-Code      = iHost-Code
     1130            buf_Contract-Attr.Contract-Code  = iContract-Code
     1131            buf_Contract-Attr.Attr-code      = cAttr-code
     1132            buf_Contract-Attr.Attr-value     = cAttr-value
     1133            NO-ERROR.
     1134         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1135         RELEASE buf_Contract-Attr NO-ERROR.
     1136         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1137      END.
     1138      RETURN.
     1139   END PROCEDURE.
     1140   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     1141   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1142   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1143   PROCEDURE Delete-Contract-Specif:
     1144      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     1145      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1146      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     1147      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     1148      Tran:
     1149      DO TRANSACTION
     1150         ON ENDKEY UNDO Tran, RETRY Tran
     1151         ON ERROR  UNDO Tran, RETRY Tran
     1152         ON QUIT   UNDO Tran, RETRY Tran
     1153         ON STOP   UNDO Tran, RETRY Tran:
     1154         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1155         FOR EACH buf_Specif-Attr WHERE
     1156                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     1157              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     1158             EXCLUSIVE-LOCK:
     1159             DELETE buf_Specif-Attr NO-ERROR.
     1160             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1161         END.
     1162         FOR EACH buf_Specif WHERE
     1163                  buf_Specif.Host-code     = buf_Contract.Host-code
     1164              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     1165             EXCLUSIVE-LOCK:
     1166             DELETE buf_Specif NO-ERROR.
     1167            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1168         END.
     1169      END.
     1170      RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE Modify-Slave-Contract:
     1173      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1174      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1175      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1176      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1177      Tran:
     1178      DO TRANSACTION
     1179         ON ENDKEY UNDO Tran, RETRY Tran
     1180         ON ERROR  UNDO Tran, RETRY Tran
     1181         ON QUIT   UNDO Tran, RETRY Tran
     1182         ON STOP   UNDO Tran, RETRY Tran:
     1183         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1184         FOR EACH buf_Ext-Classif WHERE
     1185                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1186              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1187              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1188             NO-LOCK,
     1189             FIRST buf_Slave WHERE
     1190                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1191               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1192             EXCLUSIVE-LOCK:
     1193             BUFFER-COPY
     1194               buf_Master
     1195             EXCEPT
     1196               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     1197             TO buf_Slave
     1198             NO-ERROR.
     1199             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1200             RELEASE buf_Slave NO-ERROR.
     1201             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1202         END.
     1203      END.
     1204      RETURN.
     1205   END PROCEDURE.
     1206   PROCEDURE Change-Stat-Slave-Contract:
     1207      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1208      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     1209      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1210      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1211      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1212      Tran:
     1213      DO TRANSACTION
     1214         ON ENDKEY UNDO Tran, RETRY Tran
     1215         ON ERROR  UNDO Tran, RETRY Tran
     1216         ON QUIT   UNDO Tran, RETRY Tran
     1217         ON STOP   UNDO Tran, RETRY Tran:
     1218         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1219         FOR EACH buf_Ext-Classif WHERE
     1220                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1221              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1222              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1223             NO-LOCK,
     1224             FIRST buf_Slave WHERE
     1225                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1226               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1227             EXCLUSIVE-LOCK:
     1228             ASSIGN
     1229                buf_Slave.Status_ = cStatus
     1230                NO-ERROR.
     1231             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1232             RELEASE buf_Slave NO-ERROR.
     1233             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1234         END.
     1235      END.
     1236      RETURN.
     1237   END PROCEDURE.
     1238   PROCEDURE Delete-Ref-Master-Slave:
     1239      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1240      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1241      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1242      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1243      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1244         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     1245         RETURN.
     1246      END.
     1247      Tran:
     1248      FOR FIRST buf_Ext-Classif WHERE
     1249                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1250            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1251            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1252            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1253          EXCLUSIVE-LOCK
     1254          TRANSACTION
     1255          ON ENDKEY UNDO Tran, RETRY Tran
     1256          ON ERROR  UNDO Tran, RETRY Tran
     1257          ON QUIT   UNDO Tran, RETRY Tran
     1258          ON STOP   UNDO Tran, RETRY Tran:
     1259          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1260          DELETE buf_Ext-Classif NO-ERROR.
     1261          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1262      END.
     1263      RETURN.
     1264   END PROCEDURE.
     1265   PROCEDURE Create-Ref-Master-Slave:
     1266      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1267      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1268      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1269      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1270      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     1271      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1272         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     1273         RETURN.
     1274      END.
     1275      RUN gen-key-rec IN THIS-PROCEDURE(
     1276          INPUT  v-S_CONTRACT,
     1277          INPUT  BUFFER buf_Master:HANDLE,
     1278          OUTPUT cKeyRec
     1279          ) NO-ERROR.
     1280      IF ERROR-STATUS:ERROR THEN DO:
     1281         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     1282         RETURN.
     1283      END.
     1284      Tran:
     1285      DO TRANSACTION
     1286         ON ENDKEY UNDO Tran, RETRY Tran
     1287         ON ERROR  UNDO Tran, RETRY Tran
     1288         ON QUIT   UNDO Tran, RETRY Tran
     1289         ON STOP   UNDO Tran, RETRY Tran:
     1290         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1291         CREATE buf_Ext-Classif NO-ERROR.
     1292         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1293         ASSIGN
     1294            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     1295            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     1296            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1297            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1298            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     1299            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     1300            NO-ERROR.
     1301         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1302         RELEASE buf_Ext-Classif NO-ERROR.
     1303         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1304      END.
     1305      RETURN.
     1306   END PROCEDURE.
     1307   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     1308                                 i-Host-Code AS INTEGER,
     1309                                 i-Contract-Code AS INTEGER):
     1310      DEFINE BUFFER buf_Contract FOR ub.Contract.
     1311      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1312      FIND FIRST buf_Contract WHERE
     1313                 buf_Contract.Host-Code      = i-Host-Code
     1314             AND buf_Contract.Contract-code  = i-Contract-Code
     1315           NO-LOCK NO-ERROR.
     1316      IF AVAILABLE buf_Contract THEN DO:
     1317         ASSIGN
     1318            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     1319      END.
     1320      RETURN (iRet).
     1321   END FUNCTION.
     1322   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     1323      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1324      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1325      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1326      FOR FIRST buf_Ext-Classif WHERE
     1327                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1328           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1329                                               STRING(buf_Contract.contract-code)
     1330           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1331          NO-LOCK,
     1332          EACH buf_Cont WHERE
     1333               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1334           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1335          NO-LOCK:
     1336          ASSIGN
     1337             iRet = 1.
     1338          LEAVE.
     1339      END.
     1340      IF iRet <> 1 THEN DO:
     1341         FOR FIRST buf_Ext-Classif WHERE
     1342                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1343              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1344                                                  STRING(buf_Contract.contract-code)
     1345              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1346             NO-LOCK,
     1347             EACH buf_Cont WHERE
     1348                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1349              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1350             NO-LOCK:
     1351             ASSIGN
     1352                iRet = 2.
     1353             LEAVE.
     1354         END.
     1355      END.
     1356      RETURN (iRet).
     1357   END FUNCTION.
     1358   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     1359      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1360      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1361      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1362      FOR FIRST buf_Ext-Classif WHERE
     1363                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1364           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1365                                               STRING(buf_Contract.contract-code)
     1366           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1367          NO-LOCK,
     1368          EACH buf_Cont WHERE
     1369               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1370           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1371          NO-LOCK:
     1372          ASSIGN
     1373             cRet = "+".
     1374          LEAVE.
     1375      END.
     1376      IF cRet = "" THEN DO:
     1377         FOR FIRST buf_Ext-Classif WHERE
     1378                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1379              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1380                                                  STRING(buf_Contract.contract-code)
     1381              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1382             NO-LOCK,
     1383             EACH buf_Cont WHERE
     1384                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1385              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1386             NO-LOCK:
     1387             ASSIGN
     1388                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     1389             LEAVE.
     1390         END.
     1391      END.
     1392      RETURN (cRet).
     1393   END FUNCTION.
     1394   FUNCTION Is-MS-Contract RETURN LOGICAL(
     1395            BUFFER buf_Master FOR ub.Contract,
     1396            BUFFER buf_Slave  FOR ub.Contract):
     1397      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1398      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     1399                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1400                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1401                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1402                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1403                    NO-LOCK).
     1404   END FUNCTION.
     1405   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     1406            BUFFER buf_Master FOR ub.Contract,
     1407            INPUT iSlave-Host-Code AS INTEGER
     1408            ):
     1409      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1410      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1411      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1412      FIND FIRST buf_Ext-Classif WHERE
     1413                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1414             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1415             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     1416             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1417           NO-LOCK NO-ERROR.
     1418      IF AVAILABLE buf_Ext-Classif THEN DO:
     1419         IF CAN-FIND (FIRST buf_Contract WHERE
     1420                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1421                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1422                       NO-LOCK) THEN DO:
     1423            ASSIGN
     1424               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     1425         END. ELSE DO:
     1426            ASSIGN
     1427               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     1428                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     1429                      "c Host-code=" + STRING(iSlave-Host-Code).
     1430         END.
     1431      END.
     1432      RETURN (cRet).
     1433   END FUNCTION.
     1434   define NEW SHARED  buffer buf_contract for ub.contract.
     1435   define NEW shared  buffer buf_contract-attr for ub.contract-attr .
     1436   define new shared variable br-handle as handle  no-undo .
     1437   define new shared variable next-prev as logical no-undo .
     1438   define variable p-contr-type as character no-undo .
     1439   function fo return character ( input p-cr-fo as logical, input p-fo-date as date, input p-need-fo as integer ) .
     1440    if p-cr-fo = yes then do:
     1441      return string (p-fo-date, "99/99/99").
     1442    end.
     1443    else do:
     1444      if p-need-fo = 0 then return "--------".
     1445      if p-need-fo = 1 then return "".
     1446      if p-need-fo = 2 then return "не опред".
     1447    end.
     1448   end function.
