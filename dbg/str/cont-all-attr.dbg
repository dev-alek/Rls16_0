     4018       find first ub.clients no-lock where ub.clients.obj-type = p-mngr-type and ub.clients.obj-code = p-mngr-code no-error .
     4019       if available ub.clients then assign Agnt-Types  = "sel" .
     4020       else do:
     4021         message
     4022           vss-workfile vss-revision vss-description skip
     4023           "Неверное значение параметров вызова p-mngr-type " p-mngr-type " и p-mngr-code" p-mngr-code
     4024         view-as alert-box ERROR.
     4025         return.
     4026       end.
     4027     end.
     4028     case p-doc-type :
     4029       when "all" or when 'при':U or when 'рас':U  then .
     4030       OTHERWISE do:
     4031         message
     4032           vss-workfile vss-revision vss-description skip
     4033           "Неверное значение параметра вызова p-doc-type"  p-doc-type
     4034         view-as alert-box ERROR.
     4035         return.
     4036       end.
     4037     end.
     4038     assign
     4039       Contr-List:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200
     4040       Contr-List:num-locked-columns = 4
     4041       buf_contract.contract-type:read-only in browse Contr-List = yes
     4042     .
     4043     assign Cli-Status = p-status .
