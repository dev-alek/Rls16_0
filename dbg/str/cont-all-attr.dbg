     2328     return no-apply.
     2329   end.
     2330   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2331   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2332     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2333     return no-apply.
