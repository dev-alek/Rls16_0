     4050          vss-workfile vss-revision vss-description skip
     4051          "Неверное значение параметра вызова p-status"  p-status
     4052         view-as alert-box ERROR.
     4053         return.
     4054       end.
     4055     end.
     4056   define variable v-right-supp as logical no-undo .
     4057   define variable v-right-buyer as logical   no-undo .
     4058     v-right-supp = true .
     4059     v-right-buyer = true .
     4060     if p-doc-type = "all"  or p-doc-type =  'при':U then do:
     4061   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4062   do:
     4063     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4064       (input  v-cntxt-db-num
     4065       ,input  v-cntxt-userid
     4066       ,input  0
     4067       ,input  'actn_fin-supp':U
     4068       ,input  'firm':U
     4069       ,input  p-host-code
     4070       ,input  ''
     4071       ,input  0
     4072       ,input  0
     4073       ,input  0
     4074       ,input  0
     4075       ,input  true
     4076       ,output v-right-supp
     4077       ) no-error .
     4078   end.
     4079      if error-status :error then v-right-supp = false .
     4080     end.
     4081     if p-doc-type = "all"  or p-doc-type =  'рас':U then do:
     4082   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4083   do:
     4084     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4085       (input  v-cntxt-db-num
     4086       ,input  v-cntxt-userid
     4087       ,input  0
     4088       ,input  'actn_fin-buyer':U
     4089       ,input  'firm':U
     4090       ,input  p-host-code
     4091       ,input  ''
     4092       ,input  0
     4093       ,input  0
     4094       ,input  0
     4095       ,input  0
     4096       ,input  true
     4097       ,output v-right-buyer
     4098       ) no-error .
     4099   end.
     4100     if error-status :error then v-right-buyer = false .
     4101     end.
     4102     if v-right-supp = false or v-right-buyer = false  then return .
     4103     RUN enable_UI in this-procedure .
     4104     RUN StartProc in this-procedure.
     4105     apply "entry" to Contr-List .
     4106   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4107   DEF VAR cur-clmn-numContr-List as INT EXTENT 20 no-undo.
     4108   DEF VAR varmviContr-List       as INT no-undo.
     4109   DEF VAR varmvjContr-List       as INT no-undo.
     4110   DEF VAR varmvkContr-List       as INT no-undo.
     4111   DEF VAR varmvlContr-List       as INT no-undo.
     4112   DEF VAR move-elementContr-List as INT no-undo.
     4113   def var jjContr-List           as int no-undo.
     4114   do varmviContr-List = 1 to EXTENT(cur-clmn-numContr-List):
     4115     ASSIGN cur-clmn-numContr-List[varmviContr-List] = varmviContr-List.
     4116   END.
     4117   RUN start-mv-clmnContr-List.
     4118   PROCEDURE start-mv-clmnContr-List:
     4119   def var old-session as logical no-undo.
     4120      old-session = SESSION:IMMEDIATE-DISPLAY.
     4121      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4122      SESSION:IMMEDIATE-DISPLAY = old-session.
     4123   END.
     4124   ON ctrl-cursor-right OF BROWSE Contr-List do:
     4125     RUN re-move-clmnContr-List ( 5, 20).
     4126   END.
     4127   ON ctrl-cursor-left OF BROWSE Contr-List do:
     4128     RUN re-move-clmnContr-List (20, 5).
     4129   END.
     4130   PROCEDURE re-move-clmnContr-List:
     4131     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4132     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4133     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4134       if cur-clmn-numContr-List[varmviContr-List] = source-column THEN cur-clmn-numContr-List[varmviContr-List] = -1.
     4135     END.
     4136     if Contr-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4137     if source-column > target-column THEN
     4138     DO varmvjContr-List = source-column - 1 to target-column BY -1:
     4139       DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4140           if cur-clmn-numContr-List[varmviContr-List] = varmvjContr-List THEN DO:
     4141             cur-clmn-numContr-List[varmviContr-List] = cur-clmn-numContr-List[varmviContr-List] + 1.
     4142           END.
     4143       END.
     4144     END.
     4145     ELSE
     4146     DO varmvjContr-List = source-column + 1 to target-column:
     4147       DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4148         if cur-clmn-numContr-List[varmviContr-List] = varmvjContr-List THEN DO:
     4149           cur-clmn-numContr-List[varmviContr-List] = cur-clmn-numContr-List[varmviContr-List] - 1.
     4150         END.
     4151       END.
     4152     END.
     4153     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4154       if cur-clmn-numContr-List[varmviContr-List] = -1 THEN cur-clmn-numContr-List[varmviContr-List] = target-column.
     4155     END.
     4156   END PROCEDURE.
     4157   PROCEDURE ch-clmnContr-List:
     4158     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4159     if cur-clmn-loc <= 5 then do:
     4160       return .
     4161     end.
     4162     DO varmviContr-List = 1 TO EXTENT(cur-clmn-numContr-List):
     4163       if cur-clmn-numContr-List[varmviContr-List] = cur-clmn-loc THEN move-elementContr-List = varmviContr-List.
     4164     END.
     4165     RUN re-move-clmnContr-List (cur-clmn-loc, 5).
     4166   END PROCEDURE.
     4167   PROCEDURE mv-brw-defaultContr-List:
     4168   def var old-session as logical no-undo.
     4169     old-session = SESSION:IMMEDIATE-DISPLAY.
     4170     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4171     do varmvlContr-List = 5 to EXTENT(cur-clmn-numContr-List):
     4172       RUN re-move-clmnContr-List (cur-clmn-numContr-List[varmvlContr-List], varmvlContr-List).
     4173     END.
     4174     RUN start-mv-clmnContr-List.
     4175     SESSION:IMMEDIATE-DISPLAY = old-session.
     4176   END PROCEDURE.
     4177   .
     4178     WAIT-FOR GO OF FRAME Dialog-Frame.
     4179   END.
     4180   RUN disable_UI in this-procedure .
     4181   PROCEDURE disable_UI :
     4182     HIDE FRAME Dialog-Frame.
     4183   END PROCEDURE.
     4184   PROCEDURE enable_UI :
     4185     DISPLAY sch-code sch-date Cli-Types Agnt-Types Cli-Status mark-num
     4186         WITH FRAME Dialog-Frame.
     4187     ENABLE b-quit RECT-status B-mark B-sel b-gen b-sch b-SlaveContract b-spec b-specgrp B-Help B-lkp b-chg b-del
     4188            b-open b-trn-doc B-fin-ob B-fin-doc b-hist b-exp b-imp B-add Contr-List sch-code sch-date
     4189            Cli-Types Agnt-Types Cli-Status mark-num b-order
     4190         WITH FRAME Dialog-Frame.
     4191     VIEW FRAME Dialog-Frame.
     4192   END PROCEDURE.
     4193   PROCEDURE OpenBr :
     4194     define input  parameter p-open-query     as logical   no-undo .
     4195     define input  parameter p-find-next      as logical   no-undo .
     4196     define input  parameter p-find-condition as character no-undo .
     4197     run OpenBr2 ( p-open-query, p-find-next, p-find-condition) .
     4198   END PROCEDURE.
     4199   PROCEDURE OpenBr2 :
     4200     define input  parameter p-open-query     as logical   no-undo .
     4201     define input  parameter p-find-next      as logical   no-undo .
     4202     define input  parameter p-find-condition as character no-undo .
     4203     define variable l-query-was-opened as logical no-undo .
     4204     define variable title0 as character no-undo.
     4205     title0 = "Список договоров" + chr(32).
     4206     if p-contr-type <> chr(1) then title0 = title0 + p-contr-type  + chr(32).
     4207     define variable sort-column-phrase as character no-undo .
     4208     case sort-column-name :
     4209       when "" then assign  sort-column-phrase = ""  .
     4210       otherwise    assign  sort-column-phrase = "by " + sort-column-name .
     4211     end case.
     4212     define variable l-open-query as logical   no-undo .
     4213     filter-point = filter-point0 + p-mode.
     4214     find first ub.clients no-lock where ub.clients.obj-type = 'орг':U and ub.clients.obj-code = p-host-code .
     4215     if p-doc-type = 'при':U then ASSIGN title0  = title0 + "с поставщиками." + chr(32) .
     4216     else                           ASSIGN title0  = title0 + "с покупателями." + chr(32) .
     4217     ASSIGN title0  = title0 + " Фирма: (" + string(p-host-code) + ")":U + chr(32) + ub.clients.obj-name .
     4218         if Agnt-Types = "all" and Cli-Types = "sel" then do:
     4219           find first ub.clients no-lock where ub.clients.obj-type = p-cli-type and ub.clients.obj-code = p-cli-code .
     4220           ASSIGN  frame Dialog-Frame:TITLE = title0 + " Контрагент: (" + p-cli-type + " " + string(p-cli-code) + ")":U + chr(32) + ub.clients.obj-name .
     4221             OPEN QUERY Contr-List
     4222                 FOR EACH buf_contract no-lock
     4223                 where buf_contract.host-code  = p-host-code and buf_contract.doc-type = p-doc-type and buf_contract.status_ = p-status  and buf_contract.cli-type = p-cli-type
     4224                 and buf_contract.cli-code = p-cli-code and ( p-contr-type = chr(1) or buf_contract.contract-type = p-contr-type)
     4225                 and (buf_contract.contract-date-end >= today or buf_contract.contract-date-end = ?)
     4226                 and buf_contract.contract-date-beg <= today
     4227                 , first buf_contract-attr no-lock where buf_contract-attr.contract-code = buf_contract.contract-code and buf_contract-attr.attr-code = p-attr-code and
     4228                 buf_contract-attr.host-code = buf_contract.host-code and buf_contract-attr.attr-value = string(true)
     4229               .
     4230         end.
     4231     if v-doc-rec = ? then do:
     4232   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4233   do:
     4234     Contr-List :SET-REPOSITIONED-ROW(9, "CONDITIONAL") .
     4235   end.
     4236     end.
     4237     else do:
     4238       REPOSITION Contr-List to recid v-doc-rec No-ERROR.
     4239       if error-status:error then do:
     4240   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4241   do:
     4242     Contr-List :SET-REPOSITIONED-ROW(9, "CONDITIONAL") .
     4243   end.
     4244       end.
     4245     end.
     4246   END PROCEDURE.
     4247   PROCEDURE proc-find-code :
     4248     define input parameter p-next as logical no-undo.
     4249     define input parameter p-code as character no-undo .
     4250     display "  /  /":U @ sch-date with frame Dialog-Frame.
     4251     assign p-code = chr(34) + p-code + chr(34).
     4252     if p-code = '""' then do:
     4253       run OpenBr in this-procedure
     4254         (input false
     4255         ,input p-next
     4256         ,input substitute("and buf_contract.contract-prn-code = '' " )
     4257       ).
     4258     end.
     4259     else do:
     4260       run OpenBr in this-procedure
     4261         (input false
     4262         ,input p-next
     4263         ,input substitute("and buf_contract.contract-prn-code  begins &1 "
     4264         , p-code)
     4265         ).
     4266     end.
     4267     apply "entry":u to sch-code in frame Dialog-Frame .
     4268   END PROCEDURE.
     4269   PROCEDURE proc-find-date :
     4270     define input parameter p-next as logical no-undo.
     4271     define input parameter par-date as date    no-undo .
     4272     display "":U @ sch-code with frame Dialog-Frame.
     4273     define variable var-datechr as character no-undo .
     4274     assign var-datechr = string(day(par-date)) + chr(47) + string(month(par-date)) + chr(47) + string(year(par-date)) .
     4275     run OpenBr in this-procedure (input false ,input p-next ,input substitute("and buf_contract.contract-date = &1 ", var-datechr)).
     4276     apply "entry":u to sch-date in frame Dialog-Frame .
     4277   END PROCEDURE.
     4278   PROCEDURE StartProc :
     4279     DEFINE VARIABLE v-hdl AS HANDLE NO-UNDO .
     4280     DISABLE
     4281       b-sel   when  NOT can-do( bttns, "b-sel" )
     4282       b-mark  when  NOT can-do( bttns, "b-mark")
     4283       b-add   when (NOT can-do( bttns, "b-add" ) or p-doc-type = "all")
     4284       b-chg   when  NOT can-do( bttns, "b-chg" )
     4285       b-del   when  NOT can-do( bttns, "b-del" )
     4286       b-open  when  NOT can-do( bttns, "b-open")
     4287       b-SlaveContract when v-MS-Can-Do-List = "1"
     4288     WITH FRAME Dialog-Frame.
     4289     if p-doc-type <> 'при':U then DISABLE b-gen WITH FRAME Dialog-Frame.
     4290     define variable v-db-num  as integer no-undo .
     4291     define variable v-ret as logical no-undo .
     4292   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4294     (output v-db-num
     4295     )  .
     4296     run ver-db (input p-host-code,  input v-db-num, input false, output v-ret ) no-error .
     4297     if error-status :error or v-ret = false then do:
     4298        disable   B-fin-ob    B-fin-doc  b-specgrp   with frame Dialog-Frame.
     4299     end.
     4300     if mark-num = 0 then hide mark-num in frame Dialog-Frame.
     4301     if p-rid-list <> "":U then assign v-doc-rec = integer(entry(1, p-rid-list)) .
     4302     p-contr-type = chr(1) .
     4303     if num-entries(p-mode,"=") = 2 then do:
     4304        if entry(1,p-mode,"=") = "contract-type" then do:
     4305           p-contr-type = entry(2,p-mode,"=") .
     4306        end.
     4307     end.
     4308     IF v-iMcMode = 0 THEN DO:
     4309        v-hdl = Contr-list:FIRST-COLUMN .
     4310        DO WHILE VALID-HANDLE(v-hdl):
     4311            IF v-hdl:LABEL = 'Мастер!Договор':U THEN v-hdl:VISIBLE = NO.
     4312               v-hdl = v-hdl:NEXT-COLUMN .
     4313        END.
     4314        ASSIGN
     4315           b-SlaveContract:HIDDEN = TRUE.
     4316     END.
     4317     Run OpenBR in this-procedure (yes, no, '':U) no-error  .
     4318   END PROCEDURE.
     4319   PROCEDURE run-contr :
     4320   define input parameter p-stat as character no-undo .
     4321   define input parameter p-fict as logical   no-undo .
     4322     define variable v-doc-tp as character no-undo .
     4323     define variable ri as recid no-undo .
     4324     if p-stat <> 'ДОБАВЛЕНИЕ':U then do:
     4325       assign
     4326         ri = recid( buf_contract )
     4327         v-doc-tp = buf_contract.doc-type
     4328       .
     4329     end.
     4330     else assign v-doc-tp = p-doc-type .
     4331     if p-stat = 'ПРОСМОТР':U then do:
     4332       br-handle = Contr-List:handle in frame Dialog-Frame .
     4333       next-prev = no.
     4334       do while next-prev <> ?:
     4335         if not available buf_contract then do:
     4336           message "Неправильный выбор документа.".
     4337           return.
     4338         end.
     4339         run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input v-doc-tp, input-output ri) no-error.
     4340         if error-status:error then return no-apply.
     4341         if br-handle = ? then reposition Contr-List to recid ri no-error.
     4342       end.
     4343     end.
     4344     else do:
     4345       if p-contr-type = chr(1) then
     4346          run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input v-doc-tp, input-output ri) no-error.
     4347       else
     4348          run str/contr.w ( input parParentProc,input p-host-code, input p-stat, input "contract-type=" + p-contr-type, input-output ri) no-error.
     4349       if error-status:error then return no-apply.
     4350     end.
     4351     v-doc-rec = ri .
     4352     run openbr in this-procedure (yes, no, '':u).
     4353   END PROCEDURE.
     4354   procedure proc-del :
