     1995   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1996   DO:
     1997     if available buf_contract then   do:
     1998       if can-do( p-rid-list, string( recid( buf_contract ) ) ) then  do:
     1999               p-rid-list = replace( p-rid-list, chr(44) + string( recid( buf_contract ) ), "") .
     2000               p-rid-list = replace( p-rid-list, string( recid( buf_contract ) ) + chr(44), "") .
     2001               p-rid-list = replace( p-rid-list, string( recid( buf_contract ) ), "") .
     2002       end.
     2003       else  p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( buf_contract ) ) .
     2004       g-log = Contr-List:refresh() .
     2005       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     2006         g-log = Contr-List:select-next-row ().
     2007         apply "value-changed" to Contr-List in frame Dialog-Frame.
     2008       end.
     2009       if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
     2010       else   display num-entries( p-rid-list ) @ mark-num  with frame Dialog-Frame.
     2011     end.
     2012     apply "entry" to Contr-List .
     2013   END.
