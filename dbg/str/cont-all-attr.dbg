      721   :
      722       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      723       (input  p-upper-code
      724       ,input  p-code
      725       ,output p-label
      726       ,output p-user-can-edit
      727       ,output p-output-display
      728       ,output p-other
      729       ,output p-prop-list
      730       ,output p-prop-type-list
      731       ,output p-prop-label-list
      732       ,output p-global
      733       ,output p-host
      734       ,output p-shop
      735       ,output p-store
      736       ,output p-db
      737       ,output p-region
      738       ) no-error .
      739     if error-status :error
      740     then do:
      741       undo, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1)).
      742     end.
      743   end.
      744   end procedure.
