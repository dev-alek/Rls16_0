     4601   PROCEDURE proc-b-exp :
     4602     define variable v-file-name as character no-undo .
     4603     if not available buf_contract then return no-apply.
     4604     define variable v-sys-key   as character         no-undo.
     4605   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     4606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     4607     (output v-sys-key
     4608     ) no-error .
     4609     assign  v-file-name =  ? .
     4610     run str/xmlcontr.p (input buf_contract.host-code, buf_contract.contract-code, input-output v-file-name, yes, yes) no-error .
     4611     if error-status:error then do:
     4612       message   "Ошибка при выгрузке платежа в XML-формате"  view-as alert-box .
     4613       return error .
     4614     end.
     4615     if search ("exmldoc.bat") <> ? then do:
     4616       os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     4617     end.
     4618     else do:
     4619       if search (v-file-name ) <> ? then message "Документ(-ы) выгружен(-ы) в файл " v-file-name view-as alert-box.
     4620     end.
     4621   END PROCEDURE.
     4622   PROCEDURE proc-b-imp :
     4623   define variable mFileName         as character        no-undo.
     4624   define variable vFileName         as character no-undo.
     4625   define variable v-log-file-name   as character no-undo .
     4626   define variable v-last-slash-pos  as integer no-undo .
     4627   define variable varlog            as logical   no-undo.
     4628   define variable mExcelApplication as component-handle no-undo.
     4629   define variable mWorkBook         as component-handle no-undo.
     4630   define variable mWorkSheet        as component-handle no-undo.
     4631   define variable mRange            as component-handle no-undo .
     4632     system-dialog get-file mFileName title "Выберите файл с ценами поставки"
     4633       filters "MS Excel (*.xls,*.xlsx)" "*.xls,*.xlsx",
     4634               "Все файлы" "*.*"
     4635       initial-filter 1
     4636       must-exist
     4637       update varlog.
     4638     if not varlog then return error "Отказ от импорта" .
     4639     ASSIGN
     4640       FILE-INFO:FILE-NAME = mFileName
     4641       vFilename           = FILE-INFO:FULL-PATHNAME
     4642     .
     4643     IF LENGTH(vFileName) > 0 THEN .
     4644     ELSE RETURN ERROR SUBSTITUTE("Не найден файл &1", mFileName).
     4645     v-last-slash-pos = max (
     4646       r-index(vFilename, "/"),
     4647       r-index(vFilename, "\")
     4648                            ) .
     4649     v-log-file-name  = substitute("&1&2.log"
     4650       , ibs.th.gbl.gbl-inipar:logDir
     4651       , entry(1, substring(vFileName, v-last-slash-pos + 1), ".")
     4652                                   ) .
     4653     empty temp-table t-imp-price .
     4654     create "Excel.Application":U mExcelApplication no-error.
     4655       if error-status :error then do:
     4656           message
     4657           "Ошибка при запуске Excel" skip
     4658           error-status :get-message(1) skip
     4659           view-as alert-box error .
     4660           undo, return error .
     4661       end.
     4662     assign
     4663       mExcelApplication:DisplayAlerts = no
     4664       mWorkbook                       = mExcelApplication:WorkBooks:Add(vFileName)
     4665       mWorkSheet                      = mWorkbook:Sheets:Item(1)
     4666     .
     4667     define variable vLine   as integer   no-undo.
     4668     define variable vsContractCode as character no-undo .
     4669     define variable vContractCode  as integer no-undo .
     4670     define variable vsFirmCode     as character no-undo .
     4671     define variable vFirmCode      as integer no-undo .
     4672     define variable vsGdsCode      as character no-undo .
     4673     define variable vGdsCode       as integer no-undo .
     4674     define variable vsPriceRubl    as character no-undo .
     4675     define variable vPriceRubl     as decimal no-undo .
     4676     define variable vsVatPc        as character no-undo .
     4677     define variable vVatPc         as decimal no-undo .
     4678     define variable vsPrcUp        as character no-undo .
     4679     define variable vPrcUp         as decimal no-undo .
     4680     define variable vsPrcDn        as character no-undo .
     4681     define variable vPrcDn         as decimal no-undo .
     4682     define variable vsGdsName      as character no-undo .
     4683     define variable vsFirmName     as character no-undo .
     4684     loopbl:
     4685     do vLine = 2 to 1000000:
     4686       mRange = mWorkSheet:Range(  substitute("A&1":U, vLine)  ) .
     4687       vsContractCode = mRange:formula .
     4688       mRange = mWorkSheet:Range(  substitute("B&1":U, vLine)  ) .
     4689       vsFirmCode     = mRange:formula .
     4690       mRange = mWorkSheet:Range(  substitute("C&1":U, vLine)  ) .
     4691       vsGdsCode      = mRange:formula .
     4692       assign
     4693         vContractCode = integer (vsContractCode)
     4694         vFirmCode     = integer (vsFirmCode)
     4695         vGdsCode      = integer (vsGdsCode)
     4696       no-error .
     4697       if (not error-status:error) and (vContractCode > 0) and (vFirmCode > 0) and (vGdsCode > 0) then .
     4698       else leave loopbl.
     4699       mRange = mWorkSheet:Range(  substitute("D&1":U, vLine)  ) .
     4700       vPriceRubl     = mRange:value no-error .
     4701       if vPriceRubl = ? then assign
     4702         vsPriceRubl = mRange:formula
     4703         vPriceRubl  = func-char-to-dec( vsPriceRubl )
     4704       .
     4705       mRange = mWorkSheet:Range(  substitute("E&1":U, vLine)  ) .
     4706       vVatPc         = mRange:value no-error .
     4707       if vVatPc = ? then assign
     4708         vsVatPc = mRange:formula
     4709         vVatPc  = func-char-to-dec( vsVatPc )
     4710       .
     4711       mRange = mWorkSheet:Range(  substitute("F&1":U, vLine)  ) .
     4712       vPrcUp         = mRange:value no-error .
     4713       if vPrcUp = ? then assign
     4714         vsPrcUp = mRange:formula
     4715         vPrcUp  = func-char-to-dec( vsPrcUp )
     4716       .
     4717       mRange = mWorkSheet:Range(  substitute("G&1":U, vLine)  ) .
     4718       vPrcDn         = mRange:value no-error .
     4719       if vPrcDn = ? then assign
     4720         vsPrcDn = mRange:formula
     4721         vPrcDn  = func-char-to-dec( vsPrcDn )
     4722       .
     4723       mRange = mWorkSheet:Range(  substitute("H&1":U, vLine)  ) .
     4724       vsGdsName = mRange:formula .
     4725       mRange = mWorkSheet:Range(  substitute("I&1":U, vLine)  ) .
     4726       vsFirmName = mRange:formula .
     4727       create t-imp-price .
     4728       assign
     4729         t-imp-price.contract-code = vContractCode
     4730         t-imp-price.firm-code     = vFirmCode
     4731         t-imp-price.gds-code      = vGdsCode
     4732         t-imp-price.price-rubl    = (if vPriceRubl > 0.00000000005 then vPriceRubl else 0)
     4733         t-imp-price.vat-pc        = (if vVatPc     > 0.00000000005 then vVatPc     else 0)
     4734         t-imp-price.prc-up        = (if vPrcUp     > 0.00000000005 then vPrcUp     else 0)
     4735         t-imp-price.prc-dn        = (if vPrcDn     > 0.00000000005 then vPrcDn     else 0)
     4736         t-imp-price.gds-name      = vsGdsName
     4737         t-imp-price.firm-name     = vsFirmName
     4738         t-imp-price.line-num      = vLine
     4739       no-error .
     4740       if error-status:error then leave loopbl.
     4741     end.
     4742     mWorkbook:Close(true) no-error.
     4743     release object mWorkSheet no-error.
     4744     release object mWorkbook no-error.
     4745     mExcelApplication:QUIT() no-error.
     4746     release object mExcelApplication no-error.
     4747   define variable v-today      as date no-undo .
     4748   define variable v-i-retry    as integer no-undo .
     4749   define variable v-prc-min    as decimal no-undo .
     4750   define variable v-num-passed as integer no-undo .
     4751   define variable v-num-count  as integer no-undo .
     4752   define variable v-has-errors as logical no-undo .
     4753   define variable v-is-firm    as logical no-undo .
     4754   define variable v-host-code  as integer no-undo .
     4755   define variable v-contract-code as integer no-undo .
     4756   define buffer imp_buf_contract             for ub.contract .
     4757   define buffer imp_buf_contract-specif      for ub.contract-specif .
     4758   define buffer imp_buf_contract-specif-attr for ub.contract-specif-attr .
     4759   define buffer imp_buf_goods                for ub.goods .
     4760     assign
     4761       v-today      = today
     4762       v-num-passed = 0
     4763       v-num-count  = 0
     4764       v-has-errors = false
     4765     .
     4766     output stream f-log-imp to value (v-log-file-name) .
     4767     for each t-imp-price by t-imp-price.line-num :
     4768       v-num-count = v-num-count + 1 .
     4769       if t-imp-price.price-rubl > 0 then . else do :
     4770         put stream f-log-imp unformatted
     4771            substitute("Ошибка в строке №&1. Не указана/ Равна нулю цена товара с НДС",
     4772                        t-imp-price.line-num)
     4773           skip
     4774         .
     4775         v-has-errors = true .
     4776         next .
     4777       end .
     4778       if not can-find (first imp_buf_goods where imp_buf_goods.gds-code = t-imp-price.gds-code) then do :
     4779         put stream f-log-imp unformatted
     4780            substitute("Ошибка в строке №&1. В Системе отсутствует товар с кодом &2",
     4781                      t-imp-price.line-num, t-imp-price.gds-code)
     4782           skip
     4783         .
     4784         v-has-errors = true .
     4785         next .
     4786       end .
     4787       find first imp_buf_contract no-lock
     4788            where imp_buf_contract.host-code     = p-host-code
     4789              and imp_buf_contract.contract-code = t-imp-price.contract-code no-error .
     4790       if not available imp_buf_contract then do :
     4791         put stream f-log-imp unformatted
     4792            substitute("Ошибка в строке №&1. В Системе не найдено текущего договора с № &2",
     4793                      t-imp-price.line-num, t-imp-price.contract-code)
     4794           skip
     4795         .
     4796         v-has-errors = true .
     4797         next .
     4798       end .
     4799       else do :
     4800         v-host-code     = imp_buf_contract.host-code .
     4801         v-contract-code = imp_buf_contract.contract-code .
     4802       end .
     4803       if not can-find (first clients where clients.obj-code = t-imp-price.firm-code) then do :
     4804         put stream f-log-imp unformatted
     4805            substitute("Ошибка в строке №&1. В Системе отсутствует контрагент с кодом &2",
     4806                      t-imp-price.line-num, t-imp-price.firm-code)
     4807           skip
     4808         .
     4809         v-has-errors = true .
     4810         next .
     4811       end .
     4812       if imp_buf_contract.cli-code <> t-imp-price.firm-code then do :
     4813         put stream f-log-imp unformatted
     4814            substitute("Ошибка в строке №&1. Для договора &2 указан некорректный контрагент &3",
     4815                      t-imp-price.line-num, t-imp-price.contract-code, t-imp-price.firm-code)
     4816           skip
     4817         .
     4818         v-has-errors = true .
     4819         next .
     4820       end .
     4821       if imp_buf_contract.status_ <> 'тек':U then do :
     4822         put stream f-log-imp unformatted
     4823            substitute("Ошибка в строке №&1. Договор &2 закрыт и не подлежит изменению.",
     4824                      t-imp-price.line-num, t-imp-price.contract-code)
     4825           skip
     4826         .
     4827         v-has-errors = true .
     4828         next .
     4829       end .
     4830       if imp_buf_contract.contract-date-end < v-today then do :
     4831         put stream f-log-imp unformatted
     4832            substitute("Ошибка в строке №&1. У договора &2 истёк срок действия &3.",
     4833                      t-imp-price.line-num, t-imp-price.contract-code, imp_buf_contract.contract-date-end)
     4834           skip
     4835         .
     4836         v-has-errors = true .
     4837         next .
     4838       end .
     4839       v-i-retry = 0 .
     4840   do transaction :
     4841       repeat :
     4842         find first imp_buf_contract-specif exclusive-lock
     4843              where imp_buf_contract-specif.host-code    = v-host-code
     4844                and imp_buf_contract-specif.contract-num = v-contract-code
     4845                and imp_buf_contract-specif.gds-code     = t-imp-price.gds-code no-error no-wait .
     4846         if available imp_buf_contract-specif then do :
     4847           if (t-imp-price.prc-dn > 0) then do :
     4848             find first imp_buf_contract-specif-attr exclusive-lock
     4849                  where imp_buf_contract-specif-attr.host-code    = v-host-code
     4850                    and imp_buf_contract-specif-attr.contract-num = v-contract-code
     4851                    and imp_buf_contract-specif-attr.gds-code     = t-imp-price.gds-code
     4852                    and imp_buf_contract-specif-attr.attr-code    = 'prc-min':U no-error .
     4853             if locked imp_buf_contract-specif-attr then do :
     4854               v-i-retry = v-i-retry + 1 .
     4855               if v-i-retry > 5 then leave .
     4856               pause 1 no-message .
     4857               next .
     4858             end .
     4859           end .
     4860           if (t-imp-price.prc-up > 0) and (t-imp-price.prc-dn > 0) then . else do :
     4861             put stream f-log-imp unformatted
     4862                substitute("Ошибка в строке №&1. Допустимый % отклонения равен нулю и остается прежним в Системе.",
     4863                          t-imp-price.line-num)
     4864               skip
     4865             .
     4866             v-has-errors = true .
     4867           end .
     4868           if imp_buf_contract-specif.price-cli <> t-imp-price.price-rubl then assign
     4869              imp_buf_contract-specif.price-cli  = t-imp-price.price-rubl
     4870              imp_buf_contract-specif.sum-cli    = imp_buf_contract-specif.price-cli * imp_buf_contract-specif.qnty
     4871           .
     4872           assign
     4873             imp_buf_contract-specif.VAT-pc      = t-imp-price.vat-pc
     4874       when (imp_buf_contract-specif.VAT-pc     <> t-imp-price.vat-pc)
     4875             imp_buf_contract-specif.prc         = t-imp-price.prc-up
     4876       when (
     4877            (t-imp-price.prc-up > 0) and
     4878            (imp_buf_contract-specif.prc        <> t-imp-price.prc-up)
     4879            )
     4880             v-num-passed = v-num-passed + 1
     4881           .
     4882           if (t-imp-price.prc-dn > 0) and (available imp_buf_contract-specif-attr) then do :
     4883             v-prc-min = decimal (imp_buf_contract-specif-attr.attr-value) no-error .
     4884             assign
     4885               imp_buf_contract-specif-attr.attr-value = string(t-imp-price.prc-dn)
     4886                 when ( v-prc-min <> t-imp-price.prc-dn )
     4887             .
     4888           end .
     4889           leave .
     4890         end .
     4891         else if locked imp_buf_contract-specif then do :
     4892           v-i-retry = v-i-retry + 1 .
     4893           if v-i-retry > 5 then leave .
     4894           pause 1 no-message .
     4895           next .
     4896         end .
     4897         else do :
     4898           put stream f-log-imp unformatted
     4899              substitute("Ошибка в строке №&1. Товар &2 не привязан к договору &3",
     4900                        t-imp-price.line-num, t-imp-price.gds-code, t-imp-price.contract-code)
     4901             skip
     4902           .
     4903           v-has-errors = true .
     4904           leave .
     4905         end .
     4906       end .
     4907   end .
     4908     end .
     4909     output stream f-log-imp close .
     4910   define variable v-user-action as character no-undo .
     4911   define variable v-printed     as logical no-undo .
     4912   define variable r-var1        as character no-undo initial "прочитайте" .
     4913   define variable r-var2        as character no-undo initial "!!!" .
     4914   define variable v-global-panic as character no-undo initial "" .
     4915   if (v-num-passed < v-num-count) or v-has-errors then do :
     4916       case r-var1 :
     4917         when "прочитайте" then do :
     4918       v-global-panic = "При проверке информации произошли ошибки" + r-var2 + chr(10) +
     4919               r-var2 + "Внимательно " + r-var1 + " Log-file" + r-var2 .
     4920         end .
     4921         when "съешьте" then do :
     4922       v-global-panic = "При проверке информации произошли ошибки" + r-var2 + chr(10) +
     4923               r-var2 + "Аккуратно " + r-var1 + " Log-file" + r-var2 .
     4924         end .
     4925         otherwise do :
     4926         end .
     4927       end case .
     4928   end .
     4929   message
     4930    "Статус загрузки - завершена." skip
     4931    substitute ("Обработанно &1 строк из файла импорта, загруженно в систему &2 строк.",
     4932                v-num-count, v-num-passed) skip(1)
     4933    v-global-panic
     4934   view-as alert-box .
     4935   if (v-num-passed < v-num-count) or v-has-errors then do :
     4936       run gbl/prnfilen.w (
     4937             input "Ошибки, возникшие при проверке импортируемого файла":U
     4938           , input 7
     4939           , input v-log-file-name
     4940           , input 7
     4941           , output v-user-action
     4942           , output v-printed
     4943       ).
     4944   end .
     4945   END PROCEDURE.
     4946   FUNCTION get-agent RETURNS CHARACTER
     4947     ( input agnt-code as integer ) :
     4948   define variable var-cli-name as character no-undo.
     4949   define buffer buf_clients for ub.clients.
     4950     find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = agnt-code no-error .
     4951     if available buf_clients then assign var-cli-name = STRING (agnt-code) + "   " + TRIM (buf_clients.obj-name) .
     4952   RETURN var-cli-name.
     4953   END FUNCTION.
     4954   FUNCTION func-char-to-dec RETURNS DECIMAL (iCh AS CHARACTER):
     4955       DEFINE VARIABLE vI       AS INTEGER   NO-UNDO.
     4956       DEFINE VARIABLE vCh      AS CHARACTER NO-UNDO.
     4957       DEFINE VARIABLE vNumeric AS CHARACTER NO-UNDO.
     4958       DEFINE VARIABLE vResult  AS DECIMAL   NO-UNDO.
     4959       IF LENGTH(iCh) > 0 THEN
     4960       DO:
     4961           DO vI = 1 TO LENGTH(iCh):
     4962               vCh = SUBSTRING(iCh, vI, 1).
     4963               IF INDEX("-+0123456789,.":U, vCh) > 0 THEN
     4964                   vNumeric = vNumeric + vCh.
     4965           END.
     4966           ASSIGN
     4967               vNumeric = REPLACE(vNumeric,
     4968                                   SESSION:NUMERIC-SEPARATOR,
     4969                                   SESSION:NUMERIC-DECIMAL-POINT)
     4970               vResult  = DECIMAL(vNumeric)
     4971               NO-ERROR.
     4972       END.
     4973       ELSE vResult = 0.
     4974       RETURN vResult.
     4975   END FUNCTION.
     4976   FUNCTION get-currency RETURNS CHARACTER
     4977     ( input curr-code as integer ) :
     4978   define variable var-curr-name as character no-undo.
     4979   define buffer buf_currency for ub.currency.
     4980     find first buf_currency no-lock where buf_currency.curr-code = curr-code no-error .
     4981     if available buf_currency then assign var-curr-name = buf_currency.curr-abbr .
     4982   RETURN var-curr-name.
     4983   END FUNCTION.
     4984   FUNCTION mark-string RETURNS CHARACTER
     4985     ( input par-recid as recid, input mark-list as character ) :
     4986   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     4987   END FUNCTION.
