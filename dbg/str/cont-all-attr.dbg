     1706   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1707   DO:
     1708   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1709   do:
     1710     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1711       (input  v-cntxt-db-num
     1712       ,input  v-cntxt-userid
     1713       ,input  0
     1714       ,input  'actn_fin-contract_add-def':U
     1715       ,input  'firm':U
     1716       ,input  p-host-code
     1717       ,input  '':U
     1718       ,input  0
     1719       ,input  0
     1720       ,input  0
     1721       ,input  0
     1722       ,input  true
     1723       ,output g-log
     1724       )  .
     1725   end.
     1726     if not g-log then return no-apply .
     1727     run run-contr in this-procedure ('ДОБАВЛЕНИЕ':U, no) .
     1728   END.
     1729   ON CHOOSE OF B-order IN FRAME Dialog-Frame
     1730   DO:
     1731   define variable v-list as character no-undo .
     1732   if not avail buf_contract then return no-apply.
     1733     run cus/zakz-rcv.w (
     1734      input   parparentproc
     1735     ,input   "all":U
     1736     ,input   "all":U
     1737     ,input   "contract":U
     1738     ,input   recid( buf_contract )
     1739     ,input   "b-lkp,nob-exec,nob-copy"
     1740     ,input   ""
     1741     ,output  v-list )
     1742     .
     1743   END.
     1744   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1745   DO:
     1746     if not avail buf_contract then return no-apply.
     1747   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1748   do:
     1749     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1750       (input  v-cntxt-db-num
     1751       ,input  v-cntxt-userid
     1752       ,input  0
     1753       ,input  'actn_fin-contract_update':U
     1754       ,input  'firm':U
     1755       ,input  p-host-code
     1756       ,input  '':U
     1757       ,input  0
     1758       ,input  0
     1759       ,input  0
     1760       ,input  0
     1761       ,input  true
     1762       ,output g-log
     1763       )  .
     1764   end.
     1765     if not g-log then return no-apply .
     1766     ASSIGN
     1767        iTmp = Is-MS-Contract-Int (BUFFER buf_Contract).
