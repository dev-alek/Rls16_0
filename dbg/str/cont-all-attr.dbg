     2049   PROCEDURE proc-m_gen-1 :
     2050     do on error undo, return error return-value :
     2051       if p-rid-list = "" then do:
     2052         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2053         else do:
     2054           return error "Не выделено ни одного договора для генерации ФО !". .
     2055         end.
     2056       end.
     2057       define buffer bf_contract for ub.contract.
     2058       g-log = yes.
     2059       message "Выбрано " + string( num-entries( p-rid-list)  ) + " договоров . Провести генерацию ФО ?" skip
     2060       view-as alert-box question buttons OK-Cancel update g-log.
     2061       if not g-log then return no-apply.
     2062       define variable res as character no-undo .
     2063       run str/gen-flsp.p ( INPUT parParentProc, input p-host-code, input ?, input 0, input p-rid-list, input-output res) no-error .
     2064       if error-status:error then  message "Ошибка создания ФО " view-as alert-box.
     2065       if  res <> "" then message res view-as alert-box information .
     2066       assign p-rid-list = "" .
     2067       RUN OpenBr(yes, no, '':U) .
     2068     end.
     2069   end procedure.
     2070   PROCEDURE proc-m_gen-2 :
     2071   define buffer bf_contract for ub.contract.
     2072   do on error undo, return error return-value
     2073   :
     2074       if p-rid-list = "" then do:
     2075         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2076       end.
     2077   vari-cycle:
     2078     do vari = 1 to num-entries (p-rid-list):
     2079       find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2080       if bf_contract.status_ <> 'тек':U then do:
     2081         message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем." view-as alert-box.
     2082         next vari-cycle.
     2083       end.
     2084       if bf_contract.cr-fo = yes then do:
     2085         message "По договору " bf_contract.contract-prn-code " уже создавалось ФО от " bf_contract.fo-date " числа." view-as alert-box.
     2086         next vari-cycle.
     2087       end.
     2088       else do:
     2089         if bf_contract.need-fo = 1 or bf_contract.need-fo = 2 then assign  bf_contract.need-fo = 0.
     2090         else do:
     2091           message "Данный договор не нуждался в генерации ФО." view-as alert-box.
     2092           next vari-cycle.
     2093         end.
     2094         reposition Contr-List to recid recid(bf_contract) no-error.
     2095         if not error-status:error then do:
     2096         end.
     2097       end.
     2098     end.
     2099     assign p-rid-list = "".
     2100   end.
     2101   end procedure.
     2102   PROCEDURE proc-m_gen-3 :
     2103   define buffer bf_contract for ub.contract.
     2104   define buffer buf_fin-ob-trn for ub.fin-ob-trn.
     2105   do on error undo, return error return-value
     2106   :
     2107     if p-rid-list = "" then do:
     2108       if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2109     end.
     2110   vari-cycle:
     2111     do vari = 1 to num-entries (p-rid-list):
     2112       find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2113       if bf_contract.status_ <> 'тек':U then do:
     2114         message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем." view-as alert-box.
     2115         next vari-cycle.
     2116       end.
     2117       find first buf_fin-ob-trn no-lock
     2118         where buf_fin-ob-trn.host-code      = p-host-code
     2119           and buf_fin-ob-trn.doc-type       = "spc"
     2120           and buf_fin-ob-trn.trn-doc-code   = string(bf_contract.contract-code)
     2121       no-error .
     2122       if bf_contract.cr-fo = yes or available buf_fin-ob-trn then do:
     2123         assign g-log = no.
     2124         message "По договору " bf_contract.contract-prn-code " было создано ФО от " bf_contract.fo-date " . Для правильной работы удалите его или создайте корректирующее ФО!" skip
     2125                   "Вы действительно хотите снять признак, что по этому договору было ФО?"
     2126         view-as alert-box question buttons yes-no update g-log.
     2127         if g-log <> yes then  next vari-cycle.
     2128         assign
     2129           bf_contract.cr-fo   = no
     2130           bf_contract.fo-date = 01/01/1990
     2131         .
     2132         reposition Contr-List to recid recid(bf_contract) no-error.
     2133       end.
     2134       else do:
     2135         message "По договору " bf_contract.contract-prn-code " не было генерации."
     2136         view-as alert-box.
     2137      end.
     2138    end.
     2139    assign p-rid-list = "".
     2140   end.
     2141   end procedure.
     2142   PROCEDURE proc-m_gen-4 :
     2143     do on error undo, return error return-value :
     2144       if p-rid-list = "" then do:
     2145         if available buf_contract then assign p-rid-list = string(recid(buf_contract)).
     2146       end.
     2147       define buffer bf_contract for ub.contract.
     2148   vari-cycle:
     2149       do vari = 1 to num-entries (p-rid-list):
     2150         find first bf_contract where recid(bf_contract) = integer(entry (vari, p-rid-list)) exclusive-lock.
     2151         if bf_contract.status_ <> 'тек':U then do:
     2152           message "Договор " bf_contract.contract-prn-code " не в статусе " 'тек':U " . Пропускаем."  view-as alert-box.
     2153           next.
     2154         end.
     2155         if bf_contract.need-fo = 2  then do:
     2156           assign bf_contract.need-fo = 1  .
     2157           reposition Contr-List to recid recid(bf_contract) no-error.
     2158         end.
     2159         else do:
     2160           message "Договор " bf_contract.contract-prn-code "не имеет признака 'не опред' генерация ФО."
     2161           view-as alert-box.
     2162           next vari-cycle.
     2163         end.
     2164       end.
     2165       assign p-rid-list = "" .
     2166     end.
     2167   end procedure.
