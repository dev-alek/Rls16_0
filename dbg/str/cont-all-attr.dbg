     2350   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2351   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2352   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2353   on help of frame Dialog-Frame
     2354   do:
     2355     run gbl/app_help.p
     2356       (input this-procedure :file-name
     2357       ,input ''
     2358       ,input ?
     2359       ) no-error.
     2360     if error-status :error then do:
     2361       message
     2362         "Ошибка при вызове помощи"
     2363         error-status :get-message(1)
     2364         view-as alert-box .
     2365     end.
     2366   end.
     2367   run minbtn-set in this-procedure .
     2368   on choose of b-help in frame Dialog-Frame
     2369   do:
     2370     apply "help":u to frame Dialog-Frame .
     2371   end.
     2372   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2373   procedure minbtn-set :
     2374       do
     2375           on error undo, return error return-value
     2376           :
     2377           define variable ii              as integer       no-undo .
     2378           define variable fh              as widget-handle no-undo .
     2379           define variable hh              as widget-handle no-undo .
     2380           define variable v-h             as handle        extent 4 no-undo .
     2381           define variable v-name-button   as character     no-undo .
     2382           define variable v-help-old-x    as decimal       no-undo .
     2383           define variable v-help-old-y    as decimal       no-undo .
     2384           define variable v-help-old-size as decimal       no-undo .
     2385           define variable v-frame-width   as decimal       no-undo .
     2386           define variable jj              as integer       no-undo .
     2387           do
     2388               on error undo, return error
     2389               :
     2390               assign
     2391                   v-frame-width = frame Dialog-Frame:width - 0.3
     2392                   fh            = frame Dialog-Frame:first-child
     2393                   hh            = fh:first-child
     2394                   ii            = 1
     2395                   .
     2396               do while valid-handle(hh):
     2397                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2398                   do:
     2399                       case lc(hh:name) :
     2400                           when "b-help" then
     2401                               do:
     2402                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2403                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2404                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2405                                   hh:TOOLTIP = "Помощь" .
     2406                                   v-help-old-x = hh:column .
     2407                                   v-help-old-y = hh:row    .
     2408                                   v-help-old-size = hh:width .
     2409                                   hh:width-chars = 2.5 .
     2410                               end.
     2411                           when "b-print" then
     2412                               do:
     2413                                   hh:load-image("cmp/b-print.bmp":u) .
     2414                                   hh:TOOLTIP = "Печать" .
     2415                                   v-h[ii] = hh:handle .
     2416                                   ii = ii + 1 .
     2417                                   hh:width-chars = 3 .
     2418                               end.
     2419                           when "b-history" or
     2420                           when "b-hist" then
     2421                               do:
     2422                                   hh:load-image("cmp/b-hist.bmp":u) .
     2423                                   hh:TOOLTIP = "История" .
     2424                                   v-h[ii] = hh:handle .
     2425                                   ii = ii + 1 .
     2426                                   hh:width-chars = 3 .
     2427                               end.
     2428                           when "b-sch" then
     2429                               do:
     2430                                   hh:load-image("cmp/b-sch.bmp":u) .
     2431                                   hh:TOOLTIP = "Установка Фильтра" .
     2432                                   v-h[ii] = hh:handle .
     2433                                   ii = ii + 1 .
     2434                                   hh:width-chars = 3 .
     2435                               end.
     2436                           when "b-hist-user" then
     2437                               do:
     2438                                   hh:load-image("cmp/b-hist.bmp":u) .
     2439                                   hh:TOOLTIP = "История пользователя" .
     2440                                   ii = ii + 1 .
     2441                               end.
     2442                       end case.
     2443                   end.
     2444                   hh = hh:next-sibling.
     2445               end.
     2446               b-help:column = v-frame-width - b-help:width-chars.
     2447               jj = 0.
     2448               repeat ii = 4 to 1 by -1 :
     2449                   if valid-handle (v-h[ii] ) then
     2450                   do:
     2451                       jj  = jj + 1 .
     2452                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2453                       v-h[ii]:row    = v-help-old-y .
     2454                   end.
     2455               end.
     2456           end.
     2457       end.
     2458   end procedure.
     2459   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2460   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2461   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2462   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2463   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2464   define variable v-diasize-current-frame-height as decimal   no-undo .
     2465   define variable v-diasize-change-size          as logical   no-undo .
     2466   define variable v-diasize-resize-button        as handle    no-undo .
     2467   define variable v-diasize-wndmax               as logical   no-undo .
     2468   define variable v-diasize-wndstore             as logical   no-undo .
     2469   define variable v-diasize-proc-name            as character no-undo .
     2470   define variable v-diasize-browse-handle        as handle    no-undo .
     2471   define variable v-diasize-browse-number        as integer   no-undo .
     2472   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2473   define temp-table temp-diasize-handle no-undo
     2474     field handle-value  as handle
     2475     field save-position as decimal
     2476     index xpk is primary unique handle-value
     2477     .
     2478   define temp-table temp-browse-handle no-undo
     2479     field browse-type   as character
     2480     field browse-number as integer
     2481     field browse-handle as handle
     2482     field original-size as decimal
     2483     index xpk is primary unique browse-type browse-number
     2484     index xie browse-type browse-handle
     2485   .
     2486   procedure diasize_change-height :
     2487     define input  parameter p-change-value  as decimal   no-undo .
     2488     define input  parameter p-move-resize   as logical   no-undo .
     2489     define variable v-field-group-handle    as handle    no-undo .
     2490     define variable v-object-handle         as handle    no-undo .
     2491     define variable v-frame-height          as decimal   no-undo .
     2492     define variable v-frame-virtual-height  as decimal   no-undo .
     2493     define variable v-browse-height         as decimal   no-undo .
     2494     define variable v-window-height         as decimal   no-undo .
     2495     define variable v-window-virtual-height as decimal   no-undo .
     2496     define variable v-change-sign           as integer   no-undo .
     2497     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2498     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2499     if p-change-value > 0
     2500     then do:
     2501       if frame Dialog-Frame :height + p-change-value
     2502           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2503       then do:
     2504         assign
     2505           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2506                           - (frame Dialog-Frame :height-chars)
     2507         .
     2508         if p-change-value <= 0
     2509         then do:
     2510           run diasize_position-resize-button in this-procedure .
     2511           return .
     2512         end.
     2513       end.
     2514     end.
     2515     if p-change-value < 0
     2516     then do:
     2517       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2518       then do:
     2519         assign
     2520           p-change-value = v-diasize-orig-frame-height
     2521                          - (frame Dialog-Frame :height-chars)
     2522         .
     2523         if p-change-value >= 0
     2524         then do:
     2525           run diasize_position-resize-button in this-procedure .
     2526           return .
     2527         end.
     2528       end.
     2529     end.
     2530     if p-change-value >= 0
     2531     then do:
     2532       assign
     2533         v-change-sign = 1
     2534       .
     2535     end.
     2536     else do:
     2537       assign
     2538         v-change-sign = -1
     2539       .
     2540     end.
     2541     assign
     2542       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2543     .
     2544     if p-change-value = 0
     2545     then do:
     2546       run diasize_position-resize-button in this-procedure .
     2547       return .
     2548     end.
     2549     move_block:
     2550     do
     2551     on error undo move_block, retry move_block
     2552     :
     2553       if retry
     2554       then do:
     2555         do
     2556         on error undo move_block, leave move_block
     2557         :
     2558           if p-change-value > 0
     2559           then do:
     2560             for each buf_temp-diasize-handle
     2561             on error undo, next
     2562             :
     2563               assign
     2564                 v-object-handle = buf_temp-diasize-handle.handle-value
     2565               .
     2566               if v-object-handle <> v-diasize-resize-button
     2567               then do:
     2568                 assign
     2569                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2570                 .
     2571               end.
     2572             end.
     2573             assign
     2574               v-diasize-browse-handle :height = v-browse-height
     2575             .
     2576             for each buf_temp-browse-handle
     2577               where buf_temp-browse-handle.browse-type = 'height':u
     2578             on error undo, next
     2579             :
     2580               assign
     2581                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2582               .
     2583             end.
     2584             assign
     2585               frame Dialog-Frame :height = v-frame-height
     2586             .
     2587             if frame Dialog-Frame :scrollable = true
     2588             then do:
     2589               assign
     2590                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2591               .
     2592             end.
     2593             run diasize_position-resize-button in this-procedure .
     2594           end.
     2595           else do:
     2596             if frame Dialog-Frame :scrollable = true
     2597             then do:
     2598               assign
     2599                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2600               .
     2601             end.
     2602             assign
     2603               frame Dialog-Frame :height = v-frame-height
     2604             .
     2605             assign
     2606               v-diasize-browse-handle :height = v-browse-height
     2607             .
     2608             for each buf_temp-browse-handle
     2609               where buf_temp-browse-handle.browse-type = 'height':u
     2610             on error undo, next
     2611             :
     2612               assign
     2613                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2614               .
     2615             end.
     2616             for each buf_temp-diasize-handle
     2617             on error undo, next
     2618             :
     2619               assign
     2620                 v-object-handle = buf_temp-diasize-handle.handle-value
     2621               .
     2622               if v-object-handle <> v-diasize-resize-button
     2623               then do:
     2624                 assign
     2625                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2626                 .
     2627               end.
     2628             end.
     2629             run diasize_position-resize-button in this-procedure .
     2630           end.
     2631           assign
     2632             v-diasize-change-size = false
     2633           .
     2634           leave move_block .
     2635         end.
     2636       end.
     2637       assign
     2638         v-diasize-need-full-display = true
     2639       .
     2640       if v-diasize-change-size = false
     2641       then do:
     2642         assign
     2643           v-diasize-change-size = true
     2644         .
     2645       end.
     2646       else do:
     2647         return .
     2648       end.
     2649       assign
     2650         v-frame-height = frame Dialog-Frame :height
     2651         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2652         v-browse-height = v-diasize-browse-handle :height
     2653       .
     2654       for each buf_temp-browse-handle
     2655         where buf_temp-browse-handle.browse-type = 'height':u
     2656       :
     2657         assign
     2658           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2659         .
     2660       end.
     2661       for each buf_temp-diasize-handle
     2662       :
     2663         delete buf_temp-diasize-handle .
     2664       end.
     2665       assign
     2666         v-field-group-handle = frame Dialog-Frame :first-child
     2667       .
     2668       do while valid-handle(v-field-group-handle)
     2669       :
     2670         assign
     2671           v-object-handle = v-field-group-handle :first-child
     2672         .
     2673         do while valid-handle(v-object-handle)
     2674         :
     2675           if  v-object-handle <> v-diasize-browse-handle :handle
     2676           and can-query(v-object-handle, "row")
     2677           and can-query(v-object-handle, "height")
     2678           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2679           then do:
     2680             find first buf_temp-browse-handle
     2681               where buf_temp-browse-handle.browse-type   = 'height':u
     2682                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2683               no-error .
     2684             if available buf_temp-browse-handle
     2685             then do:
     2686             end.
     2687             else do:
     2688               create buf_temp-diasize-handle .
     2689               assign
     2690                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2691                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2692               .
     2693             end.
     2694           end.
     2695           assign
     2696             v-object-handle = v-object-handle :next-sibling
     2697           .
     2698         end.
     2699         assign
     2700           v-field-group-handle = v-field-group-handle :next-sibling
     2701         .
     2702       end.
     2703       do with frame Dialog-Frame
     2704       :
     2705         hide v-diasize-resize-button .
     2706         assign
     2707           v-diasize-resize-button :row    = 1
     2708           v-diasize-resize-button :column = 1
     2709         .
     2710       end.
     2711       if p-change-value > 0
     2712       then do:
     2713         if frame Dialog-Frame :scrollable = true
     2714         then do:
     2715           assign
     2716             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2717             no-error .
     2718           if error-status :error
     2719           or error-status :get-message(1) <> ""
     2720           then do:
     2721             undo move_block, retry move_block .
     2722           end.
     2723         end.
     2724         assign
     2725           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2726           no-error .
     2727         if error-status :error
     2728         or error-status :get-message(1) <> ""
     2729         then do:
     2730           undo move_block, retry move_block .
     2731         end.
     2732         assign
     2733           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2734           no-error .
     2735         if error-status :error
     2736         or error-status :get-message(1) <> ""
     2737         then do:
     2738           undo move_block, retry move_block .
     2739         end.
     2740         for each buf_temp-browse-handle
     2741           where buf_temp-browse-handle.browse-type = 'height':u
     2742         on error undo move_block, retry move_block
     2743         :
     2744           assign
     2745             buf_temp-browse-handle.browse-handle :height
     2746               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2747             no-error .
     2748           if error-status :error
     2749           or error-status :get-message(1) <> ""
     2750           then do:
     2751             undo move_block, retry move_block .
     2752           end.
     2753         end.
     2754         for each buf_temp-diasize-handle
     2755         on error undo move_block, retry move_block
     2756         :
     2757           assign
     2758             v-object-handle = buf_temp-diasize-handle.handle-value
     2759           .
     2760           if v-object-handle <> v-diasize-resize-button
     2761           then do:
     2762             assign
     2763               v-object-handle :row = v-object-handle :row + p-change-value
     2764               no-error .
     2765             if error-status :error
     2766             or error-status :get-message(1) <> ""
     2767             then do:
     2768               undo move_block, retry move_block .
     2769             end.
     2770           end.
     2771         end.
     2772       end.
     2773       else do:
     2774         for each buf_temp-diasize-handle
     2775         on error undo move_block, retry move_block
     2776         :
     2777           assign
     2778             v-object-handle = buf_temp-diasize-handle.handle-value
     2779           .
     2780           if v-object-handle <> v-diasize-resize-button
     2781           then do:
     2782             assign
     2783               v-object-handle :row = v-object-handle :row + p-change-value
     2784               no-error .
     2785             if error-status :error
     2786             or error-status :get-message(1) <> ""
     2787             then do:
     2788               undo move_block, retry move_block .
     2789             end.
     2790           end.
     2791         end.
     2792         assign
     2793           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2794           no-error .
     2795         if error-status :error
     2796         or error-status :get-message(1) <> ""
     2797         then do:
     2798           undo move_block, retry move_block .
     2799         end.
     2800         for each buf_temp-browse-handle
     2801           where buf_temp-browse-handle.browse-type = 'height':u
     2802         on error undo move_block, retry move_block
     2803         :
     2804           assign
     2805             buf_temp-browse-handle.browse-handle :height
     2806               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2807             no-error .
     2808           if error-status :error
     2809           or error-status :get-message(1) <> ""
     2810           then do:
     2811             undo move_block, retry move_block .
     2812           end.
     2813         end.
     2814         assign
     2815           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2816           no-error .
     2817         if error-status :error
     2818         or error-status :get-message(1) <> ""
     2819         then do:
     2820           undo move_block, retry move_block .
     2821         end.
     2822         if frame Dialog-Frame :scrollable = true
     2823         then do:
     2824           assign
     2825             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2826             no-error .
     2827           if error-status :error
     2828           or error-status :get-message(1) <> ""
     2829           then do:
     2830             undo move_block, retry move_block .
     2831           end.
     2832         end.
     2833       end.
     2834       if p-move-resize = true
     2835       then do:
     2836         run diasize_position-resize-button in this-procedure .
     2837       end.
     2838       if v-diasize-wndstore = true
     2839       then do:
     2840         if connected("ub") = true
     2841         then do:
     2842           define variable v-cntxt-db-num        as integer   no-undo .
     2843           define variable v-cntxt-userid        as character no-undo .
     2844           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2845                                             , OUTPUT v-cntxt-userid
     2846                                             ) .
