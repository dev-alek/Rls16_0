     3997         .
     3998       end.
     3999       else do:
     4000         assign
     4001           b-sch :tooltip = ""
     4002         .
     4003       end.
     4004     end.
     4005   end procedure.
     4006     if p-cli-code <> ? and p-cli-type <> ? then do:
     4007       find first ub.clients no-lock where ub.clients.obj-type = p-cli-type and ub.clients.obj-code = p-cli-code no-error .
     4008       if available ub.clients then assign Cli-Types  = "sel" .
     4009       else do:
     4010         message
     4011           vss-workfile vss-revision vss-description skip
     4012           "Неверное значение параметров вызова p-cli-type " p-cli-type " и p-cli-code" p-cli-code
     4013         view-as alert-box ERROR.
     4014         return.
     4015       end.
