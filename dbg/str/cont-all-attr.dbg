     2848             (input  v-cntxt-db-num
     2849             ,input  v-cntxt-userid
     2850             ,input  v-diasize-proc-name
     2851             ,input  'height':u
     2852             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2853             ) .
     2854         end.
     2855       end.
     2856     end.
     2857     assign
     2858       v-diasize-change-size = false
     2859     .
     2860   end procedure.
     2861   procedure diasize_set-height :
     2862     define input  parameter p-new-height  as decimal   no-undo .
     2863     define input  parameter p-move-resize as logical   no-undo .
     2864     do
     2865     on error undo, return error return-value
     2866     :
     2867       run diasize_change-height in this-procedure
     2868         (input  (p-new-height - frame Dialog-Frame :height)
     2869         ,input  p-move-resize
     2870         ) .
     2871     end.
     2872   end procedure.
     2873   procedure diasize_change-width :
     2874     define input  parameter p-change-value as decimal   no-undo .
     2875     define input  parameter p-move-resize  as logical   no-undo .
     2876     define variable v-field-group-handle   as handle    no-undo .
     2877     define variable v-object-handle        as handle    no-undo .
     2878     define variable v-frame-width          as decimal   no-undo .
     2879     define variable v-frame-virtual-width  as decimal   no-undo .
     2880     define variable v-browse-width         as decimal   no-undo .
     2881     define variable v-window-width         as decimal   no-undo .
     2882     define variable v-window-virtual-width as decimal   no-undo .
     2883     define variable v-change-sign          as integer   no-undo .
     2884     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2885     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2886     if p-change-value > 0
     2887     then do:
     2888       if frame Dialog-Frame :width + p-change-value >
     2889           session :width-chars
     2890       then do:
     2891         assign
     2892           p-change-value = session :width-chars - frame Dialog-Frame :width
     2893         .
     2894         if p-change-value <= 0
     2895         then do:
     2896           run diasize_position-resize-button in this-procedure .
     2897           return .
     2898         end.
     2899       end.
     2900     end.
     2901     if p-change-value < 0
     2902     then do:
     2903       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2904       then do:
     2905         assign
     2906           p-change-value = v-diasize-orig-frame-width
     2907                          - frame Dialog-Frame :width
     2908         .
     2909         if p-change-value >= 0
     2910         then do:
     2911           run diasize_position-resize-button in this-procedure .
     2912           return .
     2913         end.
     2914       end.
     2915     end.
     2916     if p-change-value >= 0
     2917     then do:
     2918       assign
     2919         v-change-sign = 1
     2920       .
     2921     end.
     2922     else do:
     2923       assign
     2924         v-change-sign = -1
     2925       .
     2926     end.
     2927     assign
     2928       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2929     .
     2930     if p-change-value = 0
     2931     then do:
     2932       run diasize_position-resize-button in this-procedure .
     2933       return .
     2934     end.
     2935     move_block:
     2936     do
     2937     on error undo move_block, leave move_block
     2938     :
     2939       if retry
     2940       then do:
     2941         do
     2942         on error undo move_block, leave move_block
     2943         :
     2944           if p-change-value > 0
     2945           then do:
     2946             for each buf_temp-diasize-handle
     2947             on error undo, next
     2948             :
     2949               assign
     2950                 v-object-handle = buf_temp-diasize-handle.handle-value
     2951               .
     2952               if v-object-handle <> v-diasize-resize-button
     2953               then do:
     2954                 assign
     2955                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2956                 .
     2957               end.
     2958             end.
     2959             assign
     2960               v-diasize-browse-handle :width = v-browse-width
     2961             .
     2962             for each buf_temp-browse-handle
     2963               where buf_temp-browse-handle.browse-type = 'width':u
     2964             on error undo, next
     2965             :
     2966               assign
     2967                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2968               .
     2969             end.
     2970             assign
     2971               frame Dialog-Frame :width = v-frame-width
     2972             .
     2973             if frame Dialog-Frame :scrollable = true
     2974             then do:
     2975               assign
     2976                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2977               .
     2978             end.
     2979             run diasize_position-resize-button in this-procedure .
     2980           end.
     2981           else do:
     2982             if frame Dialog-Frame :scrollable = true
     2983             then do:
     2984               assign
     2985                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2986               .
     2987             end.
     2988             assign
     2989               frame Dialog-Frame :width = v-frame-width
     2990             .
     2991             for each buf_temp-browse-handle
     2992               where buf_temp-browse-handle.browse-type = 'width':u
     2993             on error undo, next
     2994             :
     2995               assign
     2996                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2997               .
     2998             end.
     2999             assign
     3000               v-diasize-browse-handle :width = v-browse-width
     3001             .
     3002             for each buf_temp-diasize-handle
     3003             on error undo, next
     3004             :
     3005               assign
     3006                 v-object-handle = buf_temp-diasize-handle.handle-value
     3007               .
     3008               if v-object-handle <> v-diasize-resize-button
     3009               then do:
     3010                 assign
     3011                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3012                 .
     3013               end.
     3014             end.
     3015             run diasize_position-resize-button in this-procedure .
     3016           end.
     3017           assign
     3018             v-diasize-change-size = false
     3019           .
     3020           leave move_block .
     3021         end.
     3022       end.
     3023       assign
     3024         v-diasize-need-full-display = true
     3025       .
     3026       if v-diasize-change-size = false
     3027       then do:
     3028         assign
     3029           v-diasize-change-size = true
     3030         .
     3031       end.
     3032       else do:
     3033         return .
     3034       end.
     3035       assign
     3036         v-frame-width = frame Dialog-Frame :width
     3037         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3038         v-browse-width = v-diasize-browse-handle :width
     3039       .
     3040       for each buf_temp-browse-handle
     3041         where buf_temp-browse-handle.browse-type = 'width':u
     3042       :
     3043         assign
     3044           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3045         .
     3046       end.
     3047       for each buf_temp-diasize-handle
     3048       :
     3049         delete buf_temp-diasize-handle .
     3050       end.
     3051       assign
     3052         v-field-group-handle = frame Dialog-Frame :first-child
     3053       .
     3054       do while valid-handle(v-field-group-handle)
     3055       :
     3056         assign
     3057           v-object-handle = v-field-group-handle :first-child
     3058         .
     3059         do while valid-handle(v-object-handle)
     3060         :
     3061           if  v-object-handle <> v-diasize-browse-handle :handle
     3062           and v-object-handle <> v-diasize-resize-button
     3063           and can-query(v-object-handle, "row")
     3064           and can-query(v-object-handle, "height")
     3065           and ( v-object-handle :col + v-object-handle :width
     3066                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3067               )
     3068           then do:
     3069             find first buf_temp-browse-handle
     3070               where buf_temp-browse-handle.browse-type   = 'width':u
     3071                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3072               no-error .
     3073             if available buf_temp-browse-handle
     3074             then do:
     3075             end.
     3076             else do:
     3077               create buf_temp-diasize-handle .
     3078               assign
     3079                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3080                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3081               .
     3082             end.
     3083           end.
     3084           assign
     3085             v-object-handle = v-object-handle :next-sibling
     3086           .
     3087         end.
     3088         assign
     3089           v-field-group-handle = v-field-group-handle :next-sibling
     3090         .
     3091       end.
     3092       do with frame Dialog-Frame
     3093       :
     3094         hide v-diasize-resize-button .
     3095         v-diasize-resize-button :row = 1.
     3096         v-diasize-resize-button :column = 1.
     3097       end.
     3098       if p-change-value > 0
     3099       then do:
     3100         if frame Dialog-Frame :scrollable = true
     3101         then do:
     3102           assign
     3103             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3104             no-error .
     3105           if error-status :error
     3106           or error-status :get-message(1) <> ""
     3107           then do:
     3108             undo move_block, retry move_block.
     3109           end.
     3110         end.
     3111         assign
     3112           frame Dialog-Frame :width = v-frame-width + p-change-value
     3113           no-error .
     3114         if error-status :error
     3115         or error-status :get-message(1) <> ""
     3116         then do:
     3117           undo move_block, retry move_block.
     3118         end.
     3119         assign
     3120           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3121         no-error .
     3122         if error-status :error
     3123         or error-status :get-message(1) <> ""
     3124         then do:
     3125           undo move_block, retry move_block.
     3126         end.
     3127         for each buf_temp-browse-handle
     3128           where buf_temp-browse-handle.browse-type = 'width':u
     3129         on error undo move_block, retry move_block
     3130         :
     3131           assign
     3132             buf_temp-browse-handle.browse-handle :width
     3133               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3134             no-error .
     3135           if error-status :error
     3136           or error-status :get-message(1) <> ""
     3137           then do:
     3138             undo move_block, retry move_block .
     3139           end.
     3140         end.
     3141         for each buf_temp-diasize-handle
     3142         on error undo move_block, retry move_block
     3143         :
     3144           assign
     3145             v-object-handle = buf_temp-diasize-handle.handle-value
     3146           .
     3147           if v-object-handle <> v-diasize-resize-button
     3148           then do:
     3149             assign
     3150               v-object-handle :col = v-object-handle :col + p-change-value
     3151               no-error .
     3152             if error-status :error
     3153             or error-status :get-message(1) <> ""
     3154             then do:
     3155               undo move_block, retry move_block .
     3156             end.
     3157           end.
     3158         end.
     3159       end.
     3160       else do:
     3161         for each buf_temp-diasize-handle
     3162         on error undo move_block, retry move_block
     3163         :
     3164           assign
     3165             v-object-handle = buf_temp-diasize-handle.handle-value
     3166           .
     3167           if v-object-handle <> v-diasize-resize-button
     3168           then do:
     3169             assign
     3170               v-object-handle :col = v-object-handle :col + p-change-value
     3171               no-error .
     3172             if error-status :error
     3173             or error-status :get-message(1) <> ""
     3174             then do:
     3175               undo move_block, retry move_block .
     3176             end.
     3177           end.
     3178         end.
     3179         for each buf_temp-browse-handle
     3180           where buf_temp-browse-handle.browse-type = 'width':u
     3181         on error undo move_block, retry move_block
     3182         :
     3183           assign
     3184             buf_temp-browse-handle.browse-handle :width
     3185               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3186             no-error .
     3187           if error-status :error
     3188           or error-status :get-message(1) <> ""
     3189           then do:
     3190             undo move_block, retry move_block .
     3191           end.
     3192         end.
     3193         assign
     3194           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3195           no-error .
     3196         if error-status :error
     3197         or error-status :get-message(1) <> ""
     3198         then do:
     3199           undo move_block, retry move_block.
     3200         end.
     3201         assign
     3202           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3203         no-error .
     3204         if error-status :error
     3205         or error-status :get-message(1) <> ""
     3206         then do:
     3207           undo move_block, retry move_block.
     3208         end.
     3209         if frame Dialog-Frame :scrollable = true
     3210         then do:
     3211           assign
     3212             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3213           no-error .
     3214           if error-status :error
     3215           or error-status :get-message(1) <> ""
     3216           then do:
     3217             undo move_block, retry move_block.
     3218           end.
     3219         end.
     3220       end.
     3221       if p-move-resize
     3222       then do:
     3223         run diasize_position-resize-button in this-procedure .
     3224       end.
     3225       if v-diasize-wndstore = true
     3226       then do:
     3227         if connected("ub") = true
     3228         then do:
     3229           define variable v-cntxt-db-num        as integer   no-undo .
     3230           define variable v-cntxt-userid        as character no-undo .
     3231           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3232                                             , OUTPUT v-cntxt-userid
     3233                                             ) .
     3234           run gbl/wndsizew.p
     3235             (input  v-cntxt-db-num
     3236             ,input  v-cntxt-userid
     3237             ,input  v-diasize-proc-name
     3238             ,input  'width':u
     3239             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3240             ) .
     3241         end.
     3242       end.
     3243     end.
     3244     assign
     3245       v-diasize-change-size = false
     3246     .
     3247   end procedure.
     3248   procedure diasize_set-width :
     3249     define input  parameter p-new-width  as decimal   no-undo .
     3250     define input  parameter p-move-resize as logical   no-undo .
     3251     do
     3252     on error undo, return error return-value
     3253     :
     3254       run diasize_change-width in this-procedure
     3255         (input  (p-new-width - frame Dialog-Frame :width)
     3256         ,input  p-move-resize
     3257         ) .
     3258     end.
     3259   end procedure.
     3260   procedure diasize_position-resize-button :
     3261     do with frame Dialog-Frame
     3262     :
     3263       hide v-diasize-resize-button .
     3264       assign
     3265         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3266                     - 1
     3267                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3268         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3269                     - 1
     3270                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3271       .
     3272       view v-diasize-resize-button .
     3273     end.
     3274   end procedure.
     3275   on alt-right anywhere
     3276   do:
     3277     run diasize_change-width in this-procedure
     3278       (input 1
     3279       ,input true
     3280       ) .
     3281     return no-apply .
     3282   end.
     3283   on alt-left anywhere
     3284   do:
     3285     run diasize_change-width in this-procedure
     3286       (input -1
     3287       ,input true
     3288       ) .
     3289     return no-apply .
     3290   end.
     3291   on alt-down anywhere
     3292   do:
     3293     run diasize_change-height in this-procedure
     3294       (input 1
     3295       ,input true
     3296       ) .
     3297     return no-apply .
     3298   end.
     3299   on alt-up anywhere
     3300   do:
     3301     run diasize_change-height in this-procedure
     3302       (input -1
     3303       ,input true
     3304       ) .
     3305     return no-apply .
     3306   end.
     3307   on alt-enter of frame Dialog-Frame
     3308   do:
     3309     run diasize_maximize in this-procedure
     3310       (input  ?
     3311       ).
     3312     return no-apply .
     3313   end.
     3314   procedure diasize_end-move :
     3315     do
     3316     on error undo, return error return-value
     3317     :
     3318       define variable v-row-delta as decimal   no-undo .
     3319       define variable v-col-delta as decimal   no-undo .
     3320       define variable v-new-row as decimal   no-undo .
     3321       define variable v-new-col as decimal   no-undo .
     3322       assign
     3323         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3324         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3325       .
     3326       assign
     3327         v-row-delta = v-new-row - frame Dialog-Frame :height
     3328         v-col-delta = v-new-col - frame Dialog-Frame :width
     3329       .
     3330       run diasize_change-height in this-procedure
     3331         (input v-row-delta
     3332         ,input true
     3333         ) .
     3334       run diasize_change-width in this-procedure
     3335         (input v-col-delta
     3336         ,input true
     3337         ) .
     3338     end.
     3339   end procedure.
     3340   procedure diasize_maximize :
     3341     define input  parameter p-action as logical   no-undo .
     3342     do
     3343     on error undo, return error return-value
     3344     :
     3345       if p-action = ?
     3346       then do:
     3347         if v-diasize-need-maximize = true
     3348         then do:
     3349           assign
     3350             p-action = true
     3351           .
     3352         end.
     3353         else do:
     3354           assign
     3355             p-action = false
     3356           .
     3357         end.
     3358       end.
     3359       if p-action = true
     3360       then do:
     3361         run diasize_change-height in this-procedure
     3362           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3363               - frame Dialog-Frame :height-chars
     3364           ,input true
     3365           ) .
     3366         run diasize_change-width in this-procedure
     3367           (input session :width-chars
     3368               - frame Dialog-Frame :width-chars
     3369           ,input true
     3370           ) .
     3371         assign
     3372           v-diasize-need-maximize = false
     3373         .
     3374       end.
     3375       else do:
     3376         run diasize_change-width in this-procedure
     3377           (input v-diasize-orig-frame-width
     3378               - frame Dialog-Frame :width-chars
     3379           ,input true
     3380           ) .
     3381         run diasize_change-height in this-procedure
     3382           (input v-diasize-orig-frame-height
     3383               - frame Dialog-Frame :height-chars
     3384           ,input true
     3385           ) .
     3386         assign
     3387           v-diasize-need-maximize = true
     3388         .
     3389       end.
     3390     end.
     3391   end procedure.
     3392   procedure diasize_restore-orig-size :
     3393     do
     3394     on error undo, return error return-value
     3395     :
     3396       assign
     3397         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3398         v-diasize-current-frame-height = frame Dialog-Frame :height
     3399       .
     3400       run diasize_set-height in this-procedure
     3401         (input  v-diasize-orig-frame-height
     3402         ,input  true
     3403         ) .
     3404       run diasize_set-width in this-procedure
     3405         (input  v-diasize-orig-frame-width
     3406         ,input  true
     3407         ) .
     3408     end.
     3409   end procedure.
     3410   procedure diasize_restore-current-size :
     3411     do
     3412     on error undo, return error return-value
     3413     :
     3414       run diasize_set-height in this-procedure
     3415         (input  v-diasize-current-frame-height
     3416         ,input  true
     3417         ) .
     3418       run diasize_set-width in this-procedure
     3419         (input  v-diasize-current-frame-width
     3420         ,input  true
     3421         ) .
     3422     end.
     3423   end procedure.
     3424   procedure diasize_set-browse-handle :
     3425     define input  parameter p-browse-handle as handle   no-undo .
     3426     define buffer buf_temp-browse-handle for temp-browse-handle .
     3427     do
     3428     on error undo, return error return-value
     3429     :
     3430       assign
     3431         v-diasize-browse-handle = p-browse-handle
     3432       .
     3433       for each buf_temp-browse-handle
     3434       on error undo, return error return-value
     3435       :
     3436         delete buf_temp-browse-handle .
     3437       end.
     3438     end.
     3439   end procedure.
     3440   procedure diasize_add_browse :
     3441     define input  parameter p-browse-type   as character no-undo .
     3442     define input  parameter p-browse-handle as handle    no-undo .
     3443     define buffer buf_temp-browse-handle for temp-browse-handle .
     3444     do
     3445     on error undo, return error return-value
     3446     :
     3447       assign
     3448         v-diasize-browse-number = v-diasize-browse-number + 1
     3449       .
     3450       create buf_temp-browse-handle .
     3451       assign
     3452         buf_temp-browse-handle.browse-type   = p-browse-type
     3453         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3454         buf_temp-browse-handle.browse-handle = p-browse-handle
     3455       .
     3456     end.
     3457   end procedure.
     3458   procedure diasize_init :
     3459     define variable v-default-value    as logical   no-undo .
     3460     define variable v-restore-saved    as logical   no-undo .
     3461     define variable v-resize-value-str as character no-undo .
     3462     do
     3463     on error undo, return error return-value
     3464     :
     3465       do with frame Dialog-Frame
     3466       :
     3467         assign
     3468           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3469           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3470           v-diasize-browse-handle     = browse Contr-List :handle
     3471         .
     3472         create button v-diasize-resize-button
     3473         assign
     3474           parent        = frame Dialog-Frame :first-child
     3475           label         = "s"
     3476           height-pixels = 16
     3477           width-pixels  = 16
     3478           visible       = true
     3479           sensitive     = true
     3480           movable       = true
     3481           triggers:
     3482             on end-move persistent run diasize_end-move in this-procedure .
     3483           end triggers.
     3484         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3485         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3486         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3487         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3488         assign
     3489           v-diasize-wndmax = false
     3490         .
     3491         if connected("ub") = true
     3492         then do:
     3493           define variable v-cntxt-db-num        as integer   no-undo .
     3494           define variable v-cntxt-userid        as character no-undo .
     3495           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3496                                             , OUTPUT v-cntxt-userid
     3497                                             ) .
     3498           run gbl/wndpar_r.p
     3499             (input  v-cntxt-db-num
     3500             ,input  v-cntxt-userid
     3501             ,input  'wndmax':U
     3502             ,output v-diasize-wndmax
     3503             ,output v-default-value
     3504             ) .
     3505         end.
     3506         assign
     3507           v-diasize-wndstore = false
     3508         .
     3509         if connected("ub") = true
     3510         then do:
     3511           run gbl/wndpar_r.p
     3512             (input  v-cntxt-db-num
     3513             ,input  v-cntxt-userid
     3514             ,input  'wndstore':U
     3515             ,output v-diasize-wndstore
     3516             ,output v-default-value
     3517             ) .
     3518         end.
     3519         assign
     3520           v-diasize-proc-name = entry(1, program-name(2), '.')
     3521         .
     3522         if v-diasize-wndstore = true
     3523         then do:
     3524           assign
     3525             v-restore-saved = false
     3526           .
     3527           if connected("ub") = true
     3528           then do:
     3529             run gbl/wndsizer.p
     3530               (input  v-cntxt-db-num
     3531               ,input  v-cntxt-userid
     3532               ,input  v-diasize-proc-name
     3533               ,input  'height':u
     3534               ,output v-resize-value-str
     3535               ) .
     3536             if v-resize-value-str <> '':U
     3537             then do:
     3538               run diasize_change-height in this-procedure
     3539                 (input  integer(v-resize-value-str)
     3540                 ,input  true
     3541                 ) .
     3542               assign
     3543                 v-restore-saved = true
     3544               .
     3545             end.
     3546           end.
     3547           if connected("ub") = true
     3548           then do:
     3549             run gbl/wndsizer.p
     3550               (input  v-cntxt-db-num
     3551               ,input  v-cntxt-userid
     3552               ,input  v-diasize-proc-name
     3553               ,input  'width':u
     3554               ,output v-resize-value-str
     3555               ) .
     3556             if v-resize-value-str <> '':U
     3557             then do:
     3558               run diasize_change-width in this-procedure
     3559                 (input  integer(v-resize-value-str)
     3560                 ,input  true
     3561                 ) .
     3562               assign
     3563                 v-restore-saved = true
     3564               .
     3565             end.
     3566           end.
     3567           if v-restore-saved <> true
     3568           then do:
     3569             if v-diasize-wndmax = true
     3570             then do:
     3571               run diasize_maximize in this-procedure
     3572                 (input  true
     3573                 ) .
     3574             end.
     3575           end.
     3576         end.
     3577         else do:
     3578           if v-diasize-wndmax = true
     3579           then do:
     3580             run diasize_maximize in this-procedure
     3581               (input  true
     3582               ) .
     3583           end.
     3584         end.
     3585       end.
     3586     end.
     3587   end procedure.
     3588   procedure diasize_need-full-display :
     3589     define output parameter p-need-full-display as logical   no-undo .
     3590     do
     3591     on error undo, return error return-value
     3592     :
     3593       assign
     3594         p-need-full-display = v-diasize-need-full-display
     3595       .
     3596       assign
     3597         v-diasize-need-full-display = false
     3598       .
     3599     end.
     3600   end procedure.
     3601   procedure get-context :
     3602      define output parameter p-db-num as integer          no-undo.
     3603      define output parameter p-user-id as character        no-undo.
     3604      define variable v-login               as character    no-undo.
     3605      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3606      define buffer buf_user-login  for ub.user-login .
     3607      do
     3608      on error undo, return error
     3609      :
     3610            FIND FIRST buf_sys-ctrl no-lock.
     3611            ASSIGN
     3612               v-login = USERID("ub")
     3613               p-db-num = buf_sys-ctrl.db-num
     3614            .
     3615            FIND FIRST buf_user-login
     3616                 WHERE buf_user-login.db-num = p-db-num
     3617                   AND buf_user-login.user-login = v-login
     3618                 no-lock
     3619                 no-error
     3620                 .
     3621            IF AVAILABLE buf_user-login
     3622            THEN DO:
     3623               assign
     3624                  p-user-id = buf_user-login.user-id
     3625               .
     3626            END.
     3627      end.
     3628   end procedure.
     3629       run diasize_init in this-procedure .
     3630   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3631   do:
     3632     Contr-List :SET-REPOSITIONED-ROW(15, "CONDITIONAL") .
     3633   end.
     3634   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3635   on ' ' of sch-date in frame Dialog-Frame
     3636   do:
     3637     if (can-query (self, "sensitive")
     3638        and
     3639        self :sensitive = true
     3640        )
     3641     or (can-query (self, "read-only")
     3642        and
     3643        self :read-only = false
     3644        )
     3645     then do:
     3646       assign
     3647         self :screen-value = ?
     3648       .
     3649     end.
     3650     return no-apply.
     3651   end.
     3652   on delete-character of sch-date in frame Dialog-Frame
     3653   do:
     3654     if (can-query (self, "sensitive")
     3655        and
     3656        self :sensitive = true
     3657        )
     3658     or (can-query (self, "read-only")
     3659        and
     3660        self :read-only = false
     3661        )
     3662     then do:
     3663       assign
     3664         self :screen-value = ?
     3665       .
     3666     end.
     3667     return no-apply.
     3668   end.
     3669   on ctrl-d of sch-date in frame Dialog-Frame
     3670   do:
     3671     define variable v-curr-sv-date as date no-undo .
     3672     if (can-query (self, "sensitive")
     3673        and
     3674        self :sensitive = true
     3675        )
     3676     or (can-query (self, "read-only")
     3677        and
     3678        self :read-only = false
     3679        )
     3680     then do:
     3681       if self :handle <> focus :handle
     3682       then do:
     3683         apply "entry":u to self .
     3684       end.
     3685       run gbl/getcurdt.p
     3686         (output v-curr-sv-date
     3687         ) .
     3688       assign
     3689         self :screen-value = string(v-curr-sv-date) .
     3690       .
     3691     end.
     3692     return no-apply.
     3693   end.
     3694   on ctrl-b of sch-date in frame Dialog-Frame
     3695   do:
     3696     if (can-query (self, "sensitive")
     3697        and
     3698        self :sensitive = true
     3699        )
     3700     or (can-query (self, "read-only")
     3701        and
     3702        self :read-only = false
     3703        )
     3704     then do:
     3705       if self :handle <> focus :handle
     3706       then do:
     3707         apply "entry":u to self .
     3708       end.
     3709       define variable v-curr-sv-date as date no-undo .
     3710       define variable v-new-sv-date  as date no-undo .
     3711       assign
     3712         v-curr-sv-date = date(self :screen-value) no-error
     3713       .
     3714       if v-curr-sv-date = ?
     3715       then do:
     3716         run gbl/getcurdt.p
     3717           (output v-curr-sv-date
     3718           ) .
     3719       end.
     3720       if v-curr-sv-date <> ?
     3721       then do:
     3722         assign
     3723           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3724         .
     3725         assign
     3726           self :screen-value = string(v-new-sv-date) .
     3727         .
     3728       end.
     3729     end.
     3730     return no-apply .
     3731   end.
     3732   on ctrl-e of sch-date in frame Dialog-Frame
     3733   do:
     3734     if (can-query (self, "sensitive")
     3735        and
     3736        self :sensitive = true
     3737        )
     3738     or (can-query (self, "read-only")
     3739        and
     3740        self :read-only = false
     3741        )
     3742     then do:
     3743       if self :handle <> focus :handle
     3744       then do:
     3745         apply "entry":u to self .
     3746       end.
     3747       define variable v-curr-sv-date as date no-undo .
     3748       define variable v-new-sv-date  as date no-undo .
     3749       assign
     3750         v-curr-sv-date = date(self :screen-value) no-error
     3751       .
     3752       if v-curr-sv-date = ?
     3753       then do:
     3754         run gbl/getcurdt.p
     3755           (output v-curr-sv-date
     3756           ) .
     3757       end.
     3758       if v-curr-sv-date <> ?
     3759       then do:
     3760         run gbl/lastdate.p
     3761           (input  v-curr-sv-date
     3762           ,output v-new-sv-date
     3763           ).
     3764         assign
     3765           self :screen-value = string(v-new-sv-date) .
     3766         .
     3767       end.
     3768     end.
     3769     return no-apply .
     3770   end.
     3771   on ctrl-f of sch-date in frame Dialog-Frame
     3772   do:
     3773     if (can-query (self, "sensitive")
     3774        and
     3775        self :sensitive = true
     3776        )
     3777     or (can-query (self, "read-only")
     3778        and
     3779        self :read-only = false
     3780        )
     3781     then do:
     3782       if self :handle <> focus :handle
     3783       then do:
     3784         apply "entry":u to self .
     3785       end.
     3786       define variable v-ok            as logical   no-undo .
     3787       define variable v-curr-sv-date  as date      no-undo .
     3788       define variable v-description   as character no-undo .
     3789       assign
     3790         v-curr-sv-date = date(self :screen-value) no-error
     3791       .
     3792       if v-curr-sv-date = ?
     3793       then do:
     3794         run gbl/getcurdt.p
     3795           (output v-curr-sv-date
     3796           ) .
     3797       end.
     3798       if v-curr-sv-date <> ?
     3799       then do:
     3800         run gbl/d-inpday.w
     3801           (input ?
     3802           ,input "Выбор даты"
     3803           ,input v-description
     3804           ,input ""
     3805           ,input-output v-curr-sv-date
     3806           ,output v-ok
     3807           ).
     3808         if v-ok = true
     3809         then do:
     3810           assign
     3811             self :screen-value = string(v-curr-sv-date) .
     3812           .
     3813         end.
     3814       end.
     3815     end.
     3816     return no-apply .
     3817   end.
     3818     define MENU m-ed-date30
     3819       MENU-ITEM m-ed-date30-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3820       MENU-ITEM m-ed-date30-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3821       MENU-ITEM m-ed-date30-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3822       MENU-ITEM m-ed-date30-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3823       .
     3824     if sch-date :POPUP-MENU in frame Dialog-Frame = ?
     3825     then do:
     3826       ASSIGN
     3827         sch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date30 :HANDLE
     3828         sch-date :MENU-MOUSE in frame Dialog-Frame = 3
     3829       .
     3830     end.
     3831     define variable v-label-handle30 as handle no-undo .
     3832     assign
     3833       v-label-handle30 = sch-date :side-label-handle in frame Dialog-Frame
     3834     .
     3835     if valid-handle (v-label-handle30)
     3836     then do:
     3837       if v-label-handle30 :tooltip = ""
     3838       or v-label-handle30 :tooltip = ?
     3839       then do:
     3840         assign
     3841           v-label-handle30 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3842         .
     3843       end.
     3844     end.
     3845     ON CHOOSE OF MENU-ITEM m-ed-date30-1 in menu m-ed-date30 DO:
     3846       apply "ctrl-b":U to sch-date in frame Dialog-Frame .
     3847     END.
     3848     ON CHOOSE OF MENU-ITEM m-ed-date30-2 in menu m-ed-date30 DO:
     3849       apply "ctrl-d":U to sch-date in frame Dialog-Frame .
     3850     END.
     3851     ON CHOOSE OF MENU-ITEM m-ed-date30-3 in menu m-ed-date30 DO:
     3852       apply "ctrl-e":U to sch-date in frame Dialog-Frame .
     3853     END.
     3854     ON CHOOSE OF MENU-ITEM m-ed-date30-4 in menu m-ed-date30 DO:
     3855       apply "ctrl-f":U to sch-date in frame Dialog-Frame .
     3856     END.
     3857   def var sort-labelContr-List   as character no-undo .
     3858   def var sort-clmnContr-List    as handle    no-undo .
     3859   def var cur-clmnContr-List     as handle    no-undo .
     3860   def var cur-clmn-locContr-List as integer   no-undo .
     3861   def var re-queryContr-List     as logical   initial no no-undo .
     3862   on start-search, ctrl-o of Contr-List in frame Dialog-Frame do:
     3863      run sort-brContr-List
     3864        (input (if available buf_contract
     3865                then recid(buf_contract)
     3866                else ?
     3867               )
     3868        ).
     3869   end.
     3870   PROCEDURE sort-brContr-List :
     3871     define input parameter p-recid as recid no-undo .
     3872     if re-queryContr-List = no then do:
     3873       assign
     3874          cur-clmnContr-List = Contr-List:current-column in frame Dialog-Frame
     3875       .
     3876       if sort-clmnContr-List <> ? then sort-clmnContr-List:column-fgcolor = 0.
     3877       if cur-clmnContr-List = sort-clmnContr-List then do:
     3878         assign
     3879            sort-labelContr-List = ""
     3880            sort-clmnContr-List = ?
     3881         .
     3882        end.
     3883        else do:
     3884          assign
     3885            sort-labelContr-List = cur-clmnContr-List:label
     3886            sort-clmnContr-List  = cur-clmnContr-List
     3887            sort-clmnContr-List:column-fgcolor = 4
     3888          .
     3889        end.
     3890      end.
     3891     assign
     3892       cur-clmn-locContr-List = 1
     3893     .
     3894     def var column-handle as handle no-undo .
     3895     column-handle = Contr-List:first-column.
     3896     do while valid-handle(column-handle) :
     3897       if column-handle = cur-clmnContr-List then do:
     3898         leave .
     3899       end.
     3900       column-handle = column-handle:NEXT-COLUMN.
     3901       assign
     3902         cur-clmn-locContr-List = cur-clmn-locContr-List + 1
     3903       .
     3904     end.
     3905     case sort-labelContr-List:
     3906           when 'Ста!тус'  then DO:    assign       sort-column-name = "buf_contract.status_"     .     run OpenBr(yes, no, no).   . END.
     3907           when 'Номер'  then DO:    assign       sort-column-name = "buf_contract.contract-prn-code"     .     run OpenBr(yes, no, no).   . END.
     3908           when 'Дата!договора'  then DO:    assign       sort-column-name = "buf_contract.contract-date"     .     run OpenBr(yes, no, no).   . END.
     3909           when 'Заголовок'  then DO:    assign       sort-column-name = "buf_contract.contract-name"     .     run OpenBr(yes, no, no).   . END.
     3910           when 'Тип/код!контрагента'  then DO:    assign       sort-column-name = "(if buf_contract.cli-type = '' then '' else TRIM (buf_contract.cli-type + ' ' + STRING (buf_contract.cli-code) ))"     .     run OpenBr(yes, no, no).   . END.
     3911           when 'Контрагент'  then DO:    assign       sort-column-name = "buf_contract.cli-name"     .     run OpenBr(yes, no, no).   . END.
     3912           when 'Тип договора'  then DO:    assign       sort-column-name = "buf_contract.contract-type"     .     run OpenBr(yes, no, no).   . END.
     3913           when 'Условия!оплаты'  then DO:    assign       sort-column-name = "buf_contract.usl-opl"     .     run OpenBr(yes, no, no).   . END.
     3914           when 'Отс-!роч.'  then DO:    assign       sort-column-name = "(if buf_contract.srok-opl > 0 then string(buf_contract.srok-opl) else '')"     .     run OpenBr(yes, no, no).   . END.
     3915           when 'Город'  then DO:    assign       sort-column-name = "buf_contract.contract-city"     .     run OpenBr(yes, no, no).   . END.
     3916           when 'Начало!действия'  then DO:    assign       sort-column-name = "buf_contract.contract-date-beg"     .     run OpenBr(yes, no, no).   . END.
     3917           when 'Окончание!действия'  then DO:    assign       sort-column-name = "buf_contract.contract-date-end"     .     run OpenBr(yes, no, no).   . END.
     3918           when 'Тип/код!посредника'  then DO:    assign       sort-column-name = "(if buf_contract.posr-type = '' then '' else TRIM (buf_contract.posr-type + ' ' + STRING (buf_contract.posr-code)))"     .     run OpenBr(yes, no, no).   . END.
     3919           when 'Посредник'  then DO:    assign       sort-column-name = "buf_contract.posr-name"     .     run OpenBr(yes, no, no).   . END.
     3920           when 'Тип/код!агента'  then DO:    assign       sort-column-name = "(if buf_contract.agnt-type = '' then '' else TRIM (buf_contract.agnt-type + ' ' + STRING (buf_contract.agnt-code)))"     .     run OpenBr(yes, no, no).   . END.
     3921           when 'Агент'  then DO:    assign       sort-column-name = "buf_contract.agnt-name"     .     run OpenBr(yes, no, no).   . END.
     3922           when 'Вид'  then DO:    assign       sort-column-name = "buf_contract.doc-type"     .     run OpenBr(yes, no, no).   . END.
     3923           when 'Вн.н.'  then DO:    assign       sort-column-name = "buf_contract.contract-code"     .     run OpenBr(yes, no, no).   . END.
     3924           when 'БД'  then DO:    assign       sort-column-name = "buf_contract.db-num"     .     run OpenBr(yes, no, no).   . END.
     3925           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-currency&1, &1&2&1)', chr(34), buf_contract.curr-code)     .     run OpenBr(yes, no, no).   . END.
     3926           when 'Исполнитель'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-agent&1, &1&2&1)', chr(34), buf_contract.mngr-code)     .     run OpenBr(yes, no, no).   . END.
     3927           when 'Фин.об.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), buf_contract.cr-fo, buf_contract.fo-date, buf_contract.need-fo)     .     run OpenBr(yes, no, no).   . END.
     3928       otherwise do:
     3929         assign
     3930           sort-column-name = ""
     3931         .
     3932         run OpenBr(yes, no, no).
     3933           if can-do( this-procedure:internal-entries, 'mv-brw-defaultContr-List') then do:
     3934             run mv-brw-defaultContr-List.
     3935           end.
     3936         if sort-labelContr-List <> "" then do:
     3937           assign
     3938             cur-clmnContr-List:column-fgcolor = 0
     3939           .
     3940         end.
     3941         assign
     3942           cur-clmn-locContr-List = ?
     3943         .
     3944       end.
     3945     end case.
     3946       if cur-clmn-locContr-List <> ? then do:
     3947         if can-do( this-procedure:internal-entries, 'ch-clmnContr-List') then do:
     3948           run ch-clmnContr-List in this-procedure (cur-clmn-locContr-List).
     3949         end.
     3950       end.
     3951     if p-recid <> ? then do:
     3952       reposition Contr-List to recid p-recid no-error.
     3953       apply "value-changed" to Contr-List in frame Dialog-Frame.
     3954     end.
     3955     apply "entry" to Contr-List in frame Dialog-Frame.
     3956   END PROCEDURE.
     3957   procedure re-open-query-srt-clmnContr-List:
     3958   if cur-clmnContr-List = ? then do:
     3959      run OpenBr(yes, no, no).
     3960   end.
     3961   else do:
     3962      assign re-queryContr-List = yes.
     3963      run sort-brContr-List
     3964        (input (if available buf_contract
     3965                then recid(buf_contract)
     3966                else ?
     3967               )
     3968        ).
     3969      assign re-queryContr-List = no.
     3970   end.
     3971   end.
     3972   MAIN-BLOCK:
