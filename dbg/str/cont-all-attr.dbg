     2031           buf_contract.status_:bgcolor  in browse Contr-List =  8.
     2032           buf_contract.contract-prn-code:bgcolor  in browse Contr-List =  8.
     2033           buf_contract.contract-date:bgcolor  in browse Contr-List =  8.
     2034           v-type:bgcolor  in browse Contr-List =  8.
     2035           buf_contract.contract-name:bgcolor  in browse Contr-List =  8.
     2036           buf_contract.cli-name:bgcolor  in browse Contr-List =  8.
     2037        end.
     2038        else do:
     2039           buf_contract.contract-date-end:bgcolor  in browse Contr-List =  ?.
     2040           buf_contract.status_:bgcolor  in browse Contr-List =  ?.
     2041           buf_contract.contract-prn-code:bgcolor  in browse Contr-List =  ?.
     2042           buf_contract.contract-date:bgcolor  in browse Contr-List =  ?.
     2043           buf_contract.contract-name:bgcolor  in browse Contr-List =  ?.
     2044           buf_contract.cli-name:bgcolor  in browse Contr-List =  ?.
