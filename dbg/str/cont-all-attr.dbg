        1   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter p-host-code    as integer   no-undo .
        3   define input  parameter bttns          as character no-undo .
        4   define input  parameter p-mode         as character no-undo .
        5   define input  parameter p-cli-type     as character no-undo .
        6   define input  parameter p-cli-code     as integer   no-undo .
        7   define input  parameter p-mngr-type    as character no-undo .
        8   define input  parameter p-mngr-code    as integer   no-undo .
        9   define input  parameter p-status       as character no-undo .
       10   define input  parameter p-doc-type     as character no-undo .
       11   define input  parameter p-attr-code    as character no-undo .
       12   define input-output param p-rid-list   as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":u .
       14   define variable vss-author      as character no-undo init "$Author$":u .
       15   define variable vss-date        as character no-undo init "$Date$":u .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       17   define variable vss-archive     as character no-undo init "$Archive$":u .
       18   define variable vss-description as character no-undo init "Список договоров" .
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure fltfield-clear :
      134     define output parameter loc-fld as character no-undo.
      135     define output parameter loc-lab as character no-undo .
      136     define output parameter loc-spr as character no-undo .
      137     define output parameter loc-dim as character no-undo .
      138     assign
      139       loc-fld = ""
      140       loc-lab = ""
      141       loc-spr = ""
      142       loc-dim = "0"
      143     .
      144   end procedure .
      145   procedure fltfield-add :
      146     define input        parameter par-fld as character no-undo.
      147     define input        parameter par-lab as character no-undo .
      148     define input        parameter par-spr as character no-undo .
      149     define input-output parameter loc-fld as character no-undo.
      150     define input-output parameter loc-lab as character no-undo .
      151     define input-output parameter loc-spr as character no-undo .
      152     define input-output parameter loc-dim as character no-undo .
      153     do
      154     on error undo, return error
      155     :
      156       assign
      157       loc-fld = if loc-dim = '0'
      158                 then par-fld
      159                 else (loc-fld + chr(44) + par-fld)
      160       loc-lab = if loc-dim = '0'
      161                 then par-lab
      162                 else (loc-lab + chr(44) + par-lab)
      163       loc-spr = if loc-dim = '0'
      164                 then par-spr
      165                 else (loc-spr + chr(44) + par-spr)
      166       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      167                 string(integer(if num-entries(loc-dim) > 1
      168                               then entry(2, loc-dim)
      169                               else entry(1, loc-dim)
      170                               ) + 1)
      171       no-error
      172       .
      173     end.
      174   end procedure.
      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   define variable v-waitfram-action01         as character   no-undo .
      177   define variable v-waitfram-action02         as character   no-undo .
      178   define variable v-waitfram-action03         as character   no-undo .
      179   define variable mWaitFramTextBeg            as character   no-undo.
      180   define variable mWaitFramTextEnd            as character   no-undo.
      181   define variable mWaitFramView               as logical     no-undo.
      182   define variable mWaitProcEvent              as logical     no-undo init yes.
      183   define variable mWaitFramInterval           as integer     no-undo init 1 .
      184   define variable mWaitFramStop               as logical     no-undo.
      185   define variable mWaitFramStopUser           as logical     no-undo.
      186   define variable mWaitFramStopTimeOut        as logical     no-undo.
      187   define variable mWaitFramStartProc          as datetime-tz no-undo.
      188   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      189   define button B-WaitFramStop auto-end-key
      190        label "Стоп"
      191        size 10 by 1 tooltip "Остоновить процесс".
      192   define button B-viewProcInfo
      193        label "Информация"
      194        size 15 by 1 tooltip "Информация о процесс".
      195   define frame waitfram
      196     v-waitfram-action01 format "x(72)" no-label skip
      197     v-waitfram-action02 format "x(72)" no-label skip
      198     v-waitfram-action03 format "x(72)" no-label skip
      199     B-viewProcInfo
      200     B-WaitFramStop at row 4 col 30
      201     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      202     .
      203   define new global shared variable mBatchMode as logical no-undo init ?.
      204   define variable mFramBachModHandle as handle no-undo.
      205   mFramBachModHandle = frame waitfram:handle.
      206   define variable mFameOldVis as logical no-undo.
      207   define variable mVisCUrentVin as logical no-undo.
      208   if session:batch-mode
      209   then
      210      mBatchMode = yes.
      211   if mBatchMode = ? then do:
      212     mVisCUrentVin = current-window:visible.
      213     mFameOldVis = mFramBachModHandle:visible.
      214     mFramBachModHandle:visible  = yes.
      215     mBatchMode = mFramBachModHandle:visible ne yes.
      216     mFramBachModHandle:visible = mFameOldVis.
      217     current-window:visible = mVisCUrentVin.
      218   end.
      219    if  log-manager:logfile-name ne ?
      220     then DO:
      221         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      222         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      223         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      224     end.
      225   on choose of B-WaitFramStop in frame waitfram
      226   do:
      227     mWaitFramStop = yes.
      228     mWaitFramStopUser = yes.
      229   end.
      230   function waitfram-check-timeout returns logical():
      231      define variable vtime as int64 no-undo.
      232      if mWaitFramStopTimeOut
      233      then
      234         return yes.
      235      vtime = ( now - mWaitFramStartProc ) / 1000 .
      236      if     mWaitFramTimeOut ne ?
      237         and mWaitFramTimeOut ne 0
      238         and mWaitFramTimeOut lt vtime
      239      then do:
      240         mWaitFramStopTimeOut = yes.
      241      end.
      242      return mWaitFramStopTimeOut.
      243   end.
      244   procedure waitfram-hide :
      245     if not session:batch-mode
      246     then do
      247     on error undo, return error return-value
      248     :
      249       pause 0 before-hide .
      250       if not mBatchMode then
      251         hide frame waitfram .
      252     if     not mWaitFramView
      253        and mWaitProcEvent
      254     then
      255       process events .
      256     end.
      257   end procedure.
      258   procedure waitfram-show :
      259     define input  parameter p-message as character no-undo .
      260     define variable v-left-margin as integer   no-undo .
      261     if not session:batch-mode
      262     then do
      263     on error undo, return error return-value
      264     :
      265       if length(p-message) <= 70 then do:
      266         assign
      267           v-left-margin = integer((70 - length(p-message)) / 2)
      268         .
      269         assign
      270           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      271         .
      272         assign
      273           v-waitfram-action01 = " "
      274           v-waitfram-action02 = " "
      275                                    + fill(" ", v-left-margin)
      276                                    + p-message
      277           v-waitfram-action03 = " "
      278         .
      279       end.
      280       else do:
      281         define variable vRindex1 as integer no-undo.
      282         define variable vRindex2 as integer no-undo.
      283         vRindex1 = r-index(p-message," ",70).
      284         if vRindex1 = 0
      285         then
      286            vRindex1 = 70.
      287         if length(p-message)  <= vRindex1 + 70 then do:
      288           assign
      289             v-waitfram-action01 = " "
      290             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      291             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      292           .
      293         end.
      294         else do:
      295           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      296           if vRindex2 <= vRindex1
      297           then
      298              vRindex2 = vRindex1 + 70.
      299           assign
      300             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      301             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      302             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      303           .
      304         end.
      305       end.
      306       B-viewProcInfo:visible   in frame waitfram = no.
      307       B-viewProcInfo:sensitive in frame waitfram = no.
      308       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      309       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      310       if  (   mWaitFramView
      311          or  mWaitProcEvent)
      312          and not mBatchMode
      313       then
      314          display
      315             v-waitfram-action01 skip
      316             v-waitfram-action02 skip
      317             v-waitfram-action03 skip
      318          with frame waitfram .
      319       if     mWaitFramView
      320          then do:
      321             if     mWaitFramInterval ne ?
      322                and not mBatchMode
      323             then
      324                wait-for go of frame waitfram pause mWaitFramInterval.
      325          end.
      326          else
      327             if     mWaitProcEvent
      328                and not mBatchMode
      329             then
      330                process events .
      331     end.
      332   end procedure.
      333      procedure waitfram-show-this:
      334         define input  parameter iInterval as int64 no-undo.
      335         define variable vtime as int64 no-undo.
      336         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      337         mWaitFramInterval = iInterval.
      338         run waitfram-show (substitute("&1&2 &3&4" ,
      339                                       mWaitFramTextBeg ,
      340                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      341                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      342                                       mWaitFramTextEnd
      343                                      )
      344                           ).
      345      end.
      346      procedure WaitFramRunPause:
      347         define input  parameter iInterval as dec no-undo.
      348         define variable vStart  as datetime-tz no-undo.
      349         define variable vend    as datetime-tz no-undo.
      350         define variable vint as int64 no-undo.
      351         define variable vOk as logical no-undo.
      352         vStart = now.
      353         vend   = vStart.
      354         publish "WaitFramPause" (iInterval,output vOk).
      355         vend   =  now.
      356         vint = vend - vStart.
      357         vint = iInterval - vint / 1000.
      358         if     not mWaitFramStop
      359            and (   vint > 0
      360                 or (    not vOk
      361                     and iInterval eq ?
      362                     )
      363                 )
      364         then
      365            run waitfram-show-this (iInterval).
      366         vend   =  now.
      367         vint = vend - vStart.
      368         vint = iInterval - vint / 1000.
      369         if     not mWaitFramStop
      370            and vint > 0
      371         then do:
      372            run gbl/pause.p (vint * 1000).
      373         end.
      374         if iInterval ne ?
      375         then
      376            publish "WaitFramStop".
      377         waitfram-check-timeout().
      378      end.
      379      procedure WaitFramWaitFor:
      380         define input  parameter iInterval as dec no-undo.
      381         assign
      382            mWaitFramStartProc   = now
      383            mWaitFramStopUser    = no
      384            mWaitFramStopTimeOut = no
      385         .
      386         block-wait:
      387         do while not mWaitFramStop:
      388            run WaitFramRunPause (iInterval).
      389            if  waitfram-check-timeout()
      390            then do:
      391               leave block-wait.
      392            end.
      393         end.
      394         run waitfram-hide.
      395      end.
      396   procedure waitfram-join :
      397     define input  parameter p-line-1  as character no-undo .
      398     define input  parameter p-line-2  as character no-undo .
      399     define input  parameter p-line-3  as character no-undo .
      400     define output parameter p-message as character no-undo .
      401     do
      402     on error undo, return error return-value
      403     :
      404       assign
      405         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      406                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      407                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      408       .
      409     end.
      410   end procedure.
      411   function waitfram-join-function returns character
      412     (input p-line-1 as character
      413     ,input p-line-2 as character
      414     ,input p-line-3 as character
      415     ).
      416     define variable v-message as character no-undo .
      417     run waitfram-join in this-procedure
      418       (input  p-line-1
      419       ,input  p-line-2
      420       ,input  p-line-3
      421       ,output v-message
      422       ) .
      423     return v-message .
      424   end function .
      425   procedure current-db :
      426    do
      427    on error undo, return error return-value
      428    :
      429   define input parameter  p-host-code as integer no-undo .
      430   define input parameter  c-host-code as integer no-undo .
      431   define output parameter ret         as logical no-undo .
      432   define buffer current_sysconf for ub.sysconf.
      433   define variable v-current-db as integer no-undo .
      434   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      435   if error-status :error then return error .
      436      v-current-db = current_sysconf.firm-db-num .
      437      ret = true .
      438   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      439   if not( ub.sysconf.firm-db-num = v-current-db or
      440           ub.sysconf.firm-db-num = 0 )
      441     then do:
      442     ret = false .
      443     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      444     return .
      445   end.
      446    end.
      447   end procedure.
      448   procedure ver-db :
      449    do
      450    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      451    :
      452   define input parameter  c-host-code as integer no-undo .
      453   define input parameter  par-ver-db  as integer no-undo .
      454   define input parameter  p-mess as logical no-undo .
      455   define output parameter ret         as logical no-undo .
      456   define buffer current_sysconf for ub.sysconf.
      457   define variable v-current-db as integer no-undo .
      458   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      459   if error-status :error then return error .
      460      v-current-db = current_sysconf.firm-db-num .
      461      ret = true .
      462   if not( par-ver-db = v-current-db or
      463           par-ver-db = 0 )
      464     then do:
      465     ret = false .
      466     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      467     return .
      468   end.
      469    end.
      470   end procedure.
      471   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472     define variable v-cntxt-db-num        as integer   no-undo .
      473     define variable v-cntxt-userid        as character no-undo .
      474     define variable v-cntxt-level         as character no-undo .
      475     define variable v-cntxt-host-code-obj as integer   no-undo .
      476     define variable v-cntxt-obj-type      as character no-undo .
      477     define variable v-cntxt-obj-code      as integer   no-undo .
      478     define variable v-cntxt-db-num-obj    as integer   no-undo .
      479     define variable v-cntxt-is-admin      as logical   no-undo .
      480   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   function usrfulnf returns character ( input p-user-id as character):
      482   define variable v-user-name as character no-undo .
      483   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      485     (input  p-user-id
      486     ,output v-user-name
      487     ) no-error .
      488   if error-status:error
      489   or v-user-name = ""
      490   then do:
      491     return p-user-id.
      492   end.
      493   else do:
      494     return v-user-name.
      495   end.
      496   end function.
      497   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      499   procedure fltopend_fltopend :
      500   define input parameter p-parent-handle as handle no-undo .
      501   define input parameter p-qh as handle no-undo .
      502   define input parameter p-flt-open-open-query  as character no-undo .
      503   define input parameter p-where-cond as character no-undo .
      504   define input parameter p-use-indFIRST-query-tail as character no-undo .
      505   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      506   define input parameter p-indexed-reposition as character no-undo .
      507     do
      508     on error undo, return error
      509     :
      510   define variable v-prepare-string as character no-undo .
      511   define variable glog as logical no-undo .
      512   assign
      513   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      514                      p-where-cond + chr(32)  +
      515                      p-use-indFIRST-query-tail + chr(32) +
      516                      p-use-ind-sort-clmn-by + chr(32) +
      517                      p-indexed-reposition
      518   .
      519   assign
      520   glog = p-qh:query-prepare(v-prepare-string) no-error .
      521   if not glog
      522   or error-status:error then do:
      523     message error-status:get-message(1) view-as alert-box .
      524     undo, return error .
      525   end.
      526   assign
      527   glog = p-qh:query-open no-error .
      528   if not glog
      529   or error-status:error then do:
      530     message error-status:get-message(1) view-as alert-box .
      531     undo, return error .
      532   end.
      533     end.
      534   end procedure.
      535   procedure fltopend_fltfindd :
      536   define input parameter p-parent-handle as handle no-undo .
      537   define input parameter p-qh as handle no-undo .
      538   define input parameter p-rowid as rowid no-undo .
      539   define input parameter p-next as logical no-undo .
      540   define input parameter p-lock as integer no-undo .
      541   define input parameter p-bh as handle no-undo .
      542   define input parameter p-where-cond as character no-undo .
      543   define input parameter p-use-index-phrase as character no-undo .
      544   define variable glog as logical no-undo .
      545   define variable v-qh as handle no-undo .
      546   define variable v-bh as handle no-undo .
      547   define variable v-recid as recid no-undo .
      548   define variable v-prepare-string as character no-undo .
      549   do
      550   on error undo, return error
      551   on stop undo, return error
      552   :
      553     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      554     create buffer v-bh for table p-bh buffer-name p-bh:name.
      555     create query v-qh.
      556     v-qh:set-buffers(v-bh).
      557     v-prepare-string = substitute("for each &1 &2 &3"
      558                                     ,v-bh:name
      559                                     ,p-where-cond
      560                                     ,p-use-index-phrase).
      561     glog = v-qh:query-prepare(v-prepare-string) no-error.
      562     if not glog then do:
      563       delete object v-qh.
      564       delete object v-bh.
      565       undo, return error .
      566     end.
      567     glog = v-qh:query-open no-error .
      568     if not glog then do:
      569       delete object v-qh.
      570       delete object v-bh.
      571       undo, return error .
      572     end.
      573     if p-next then do:
      574       v-qh:reposition-to-rowid(p-rowid) no-error .
      575       glog = v-qh:get-next( p-lock) no-error .
      576       glog = v-qh:get-next( p-lock) no-error .
      577       if not glog or v-qh:query-off-end = yes then do:
      578         glog = v-qh:get-first( p-lock) no-error .
      579       end.
      580     end.
      581     else do:
      582       glog = v-qh:get-first( p-lock) no-error .
      583     end.
      584     v-recid = v-bh:recid no-error .
      585     delete object v-qh.
      586     delete object v-bh.
      587     return string(v-recid) .
      588   end.
      589   end procedure.
      590   procedure fltopend_fltfindq :
      591   define input parameter p-parent-handle as handle no-undo .
      592   define input parameter p-qh as handle no-undo .
      593   define input parameter p-next as logical no-undo .
      594   define input parameter p-lock as integer no-undo .
      595   define input parameter p-flt-open-open-query  as character no-undo .
      596   define input parameter p-where-cond as character no-undo .
      597   define input parameter p-use-indFIRST-query-tail as character no-undo .
      598   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      599   define input parameter p-indexed-reposition as character no-undo .
      600   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      601   define variable glog as logical no-undo .
      602   define variable v-qh as handle no-undo .
      603   define variable v-bh as handle no-undo extent 18.
      604   define variable v-rowid as rowid no-undo extent 18.
      605   define variable v-ii as integer no-undo .
      606   define variable v-prepare-string as character no-undo .
      607   do
      608   on error undo, return error
      609   on stop undo, return error
      610   :
      611     create query v-qh.
      612     do v-ii = 1 to p-qh:num-buffers:
      613       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      614       assign
      615       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      616       no-error.
      617       v-qh:add-buffer(v-bh[v-ii]).
      618     end.
      619     assign
      620     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      621                       p-where-cond + chr(32)  +
      622                       p-use-indFIRST-query-tail + chr(32) +
      623                       p-use-ind-sort-clmn-by + chr(32) +
      624                       p-indexed-reposition
      625     .
      626     glog = v-qh:query-prepare( v-prepare-string) no-error .
      627     if not glog then do:
      628       delete object v-qh.
      629       do v-ii = 1 to p-qh:num-buffers:
      630         delete object v-bh[v-ii].
      631       end.
      632       undo, return error .
      633     end.
      634     glog = v-qh:query-open no-error .
      635     if not glog then do:
      636       delete object v-qh.
      637       do v-ii = 1 to p-qh:num-buffers:
      638         delete object v-bh[v-ii].
      639       end.
      640       undo, return error .
      641     end.
      642     if p-next then do:
      643       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      644       glog = v-qh:get-next( p-lock) no-error .
      645       glog = v-qh:get-next( p-lock) no-error .
      646       if not glog or v-qh:query-off-end = yes then do:
      647         glog = v-qh:get-first( p-lock) no-error .
      648       end.
      649     end.
      650     else do:
      651       glog = v-qh:get-first( p-lock) no-error .
      652     end.
      653     do v-ii = 1 to p-qh:num-buffers:
      654       assign
      655       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      656       no-error.
      657     end.
      658     delete object v-qh.
      659     do v-ii = 1 to p-qh:num-buffers:
      660       delete object v-bh[v-ii].
      661     end.
      662   end.
      663   end procedure.
