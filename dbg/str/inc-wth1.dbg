        1   block-level on error undo, throw.
        2   define parameter buffer loc-chk-doc for ub.chk-doc.
        3   define input parameter par-koeff as integer no-undo .
        4   define input parameter pardoc-code like ub.wth-doc.doc-code no-undo .
        5   define input parameter parcurrent-w-p-code like ub.wth-line.w-p-code no-undo .
        6   define input parameter parout-w-p-code like ub.wth-line.out-code no-undo .
        7   define input parameter parext-doc-type like ub.wth-doc.ext-doc-type no-undo .
        8   define input parameter parchk-type like ub.chk-doc.chk-type no-undo .
        9   define input parameter p-silent as logical no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: inc-wth1.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: str/inc-wth1.p $":U .
       15   define variable vss-description as character no-undo init "Добавление/удаление чека МЦ в документ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define temp-table tt-par-dtl  no-undo like ub.wth-par
       86   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
       87   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
       88   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
       89   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
       90   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
       91   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
       92   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
       93   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       94   FIELD w-p-code     like ub.wth-dtl.w-p-code
       95   FIELD doc-code     like ub.wth-dtl.doc-code
       96   FIELD gds-code     like ub.wth-gds.gds-code
       97   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       98   INDEX tt-i1                        par-feat par-unit par-val
       99   INDEX tt-i2                        doc-sum  q-ty-doc
      100   .
      101   define temp-table tt-par-dtl-inv  no-undo like ub.wth-par
      102   FIELD q-ty-bef     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во план"
      103   FIELD q-ty-aft     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во факт"
      104   FIELD sum-bef  like ub.wth-line.bef-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма план"
      105   FIELD sum-aft  like ub.wth-line.aft-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма факт"
      106   FIELD sum-fact  like ub.wth-line.fact-sum FORM "->,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Расхождение"
      107   INDEX tt-pi    IS   PRIMARY UNIQUE par-code
      108   INDEX tt-i1                        par-feat par-unit par-val
      109   INDEX tt-i2                        sum-bef  q-ty-bef
      110   .
      111   DEFINE VARIABLE varline-rec as recid no-undo .
      112   define buffer buf_chk-pay for ub.chk-pay .
      113   define buffer buf2_chk-pay for ub.chk-pay .
      114   define buffer buf_c-chk-doc for ub.c-chk-doc .
      115   define buffer buf_c-chk-pay for ub.c-chk-pay .
      116   define buffer buf_wth-place for ub.wth-place.
      117   define buffer buf_wealth for ub.wealth.
      118   define buffer buf_cash-pay for ub.cash-pay .
      119   define buffer bufdoc_wth-place for ub.wth-place.
      120   define buffer buf_wth-par for ub.wth-par.
      121   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
      122   DEFINE VARIABLE varkoef as integer no-undo .
      123   DEFINE VARIABLE var-sum like ub.chk-pay.tot-sum no-undo .
      124   def var cur-wth like    ub.wealth.wth-code no-undo.
      125   if NOT ABS(par-koeff) = 1 then do:
      126     message
      127     vss-workfile vss-revision vss-description skip
      128     "Неверный параметр вызова par-koeff" par-koeff
      129     view-as alert-box error .
      130     return error.
      131   end.
      132   FIND FIRST buf_wth-place No-LOCK WHERE
      133             buf_wth-place.obj-type = loc-chk-doc.obj-type AND
      134             buf_wth-place.obj-code = loc-chk-doc.obj-code AND
      135             buf_wth-place.cash-desk = loc-chk-doc.pay-desk NO-ERROR.
      136   if not available buf_wth-place then do:
      137     message
      138     "Не определено МХ МЦ для кассы N" loc-chk-doc.pay-desk SKIP
      139     "объект" loc-chk-doc.obj-type loc-chk-doc.obj-code
      140     view-as alert-box error .
      141     return error .
      142   end.
      143   if parcurrent-w-p-code <> 0 and par-koeff = 1 then do:
      144     FIND FIRST bufdoc_wth-place No-LOCK WHERE
      145               bufdoc_wth-place.obj-type = loc-chk-doc.obj-type AND
      146               bufdoc_wth-place.obj-code = loc-chk-doc.obj-code AND
      147               bufdoc_wth-place.w-p-code = parcurrent-w-p-code No-ERROR.
      148     if not available bufdoc_wth-place or bufdoc_wth-place.cash-desk = 0 then dO:
      149       message
      150       "Не определено МХ МЦ в документе" pardoc-code " определено неверно" SKIP
      151       "объект" loc-chk-doc.obj-type loc-chk-doc.obj-code
      152       view-as alert-box error .
      153       return error .
      154     end.
      155     if buf_wth-place.w-p-code <> parcurrent-w-p-code then do:
      156       message
      157       "Документ МЦ" pardoc-code "сформирован для чеков кассы N" bufdoc_wth-place.cash-desk
      158       "а чек " loc-chk-doc.doc-code "пробит на кассе" loc-chk-doc.pay-desk SKIP
      159       "объект" loc-chk-doc.obj-type loc-chk-doc.obj-code
      160       view-as alert-box error .
      161       return error .
      162     end.
      163   end.
      164   main-block:
      165   do
      166   on error undo, return error
      167   :
      168   _chk-pay:
      169   FOR EACH buf_chk-pay where
      170             buf_chk-pay.doc-code = loc-chk-doc.doc-code
      171   BREAK
      172   By buf_chk-pay.pay-code
      173   BY buf_chk-pay.curr-code
      174   ON ERROR UNDO _chk-pay, return error
      175             :
      176     if first-of(buf_chk-pay.curr-code)or first-of(buf_chk-pay.pay-code) then do:
      177       FIND FIRST buf_cash-pay No-LOCK where
      178                   buf_cash-pay.cdpay-code = buf_chk-pay.pay-code AND
      179                   buf_cash-pay.curr-code = buf_chk-pay.curr-code No-ERROR.
      180       IF NOT AVAILABLE buf_cash-pay then do:
      181         message
      182         "Не найден тип кассового платежа" skip
      183         "код платежа" buf_chk-pay.pay-code
      184         "код валюты" buf_chk-pay.curr-code
      185         view-as alert-box error .
      186         undo main-block, return error.
      187       end.
      188       FIND FIRST buf_wealth No-LOCK WHERE
      189                   buf_wealth.wth-code = buf_cash-pay.wth-code No-ERROR.
      190       if NOT AVAILABLE buf_wealth then do:
      191         if buf_cash-pay.wth-code = 0 and
      192           buf_cash-pay.is-cash = no AND
      193           string(loc-chk-doc.chk-type) = '4':U then do:
      194         error-status:error = no.
      195         end.
      196         else do:
      197           undo _chk-pay, return error substitute("Не найдена МЦ с кодом &1&2Чек МЦ &3"
      198                                                   , buf_cash-pay.wth-code
      199                                                   ,chr(10)
      200                                                   , loc-chk-doc.doc-code).
      201         end.
      202       end.
      203       assign
      204       var-sum = 0
      205       cur-wth = buf_wealth.wth-code.
      206       for each buf2_chk-pay no-lock where
      207               buf2_chk-pay.doc-code = loc-chk-doc.doc-code
      208            and buf2_chk-pay.pay-code = buf_chk-pay.pay-code
      209            and buf2_chk-pay.curr-code = buf_chk-pay.curr-code
      210            and buf2_chk-pay.par-code > 0
      211        ON ERROR UNDO _chk-pay, return error:
      212         find first buf_wth-par no-lock where
      213                   buf_wth-par.wth-code = buf2_chk-pay.wth-code
      214               and buf_wth-par.par-code = buf2_chk-pay.par-code no-error.
      215         if not available buf_wth-par then do:
      216           undo _chk-pay, return error substitute("Не найден номинал МЦ &1 для МЦ &2&2Чек МЦ &4"
      217                                                   , buf2_chk-pay.wth-code
      218                                                   , buf2_chk-pay.par-code
      219                                                   ,chr(10)
      220                                                   , loc-chk-doc.doc-code).
      221         end.
      222         find first tt-par-dtl where tt-par-dtl.par-code = buf2_chk-pay.par-code no-error.
      223         if not available tt-par-dtl then do:
      224           create tt-par-dtl.
      225           assign
      226           tt-par-dtl.wth-code = buf2_chk-pay.wth-code
      227           tt-par-dtl.doc-sum  = buf2_chk-pay.tot-sum
      228           tt-par-dtl.fact-sum  = 0.0
      229           tt-par-dtl.q-ty-doc  = buf2_chk-pay.doc-qnty
      230           tt-par-dtl.q-ty-fact  = 0.0
      231           tt-par-dtl.par-code = buf2_chk-pay.par-code
      232           tt-par-dtl.par-rate = buf_wth-par.par-rate
      233           tt-par-dtl.par-feat = buf_wth-par.par-feat
      234           tt-par-dtl.par-unit = buf_wth-par.par-unit
      235           tt-par-dtl.par-val = buf2_chk-pay.par-val
      236           .
      237         end.
      238         else do:
      239           assign
      240           tt-par-dtl.doc-sum  = tt-par-dtl.doc-sum  + buf2_chk-pay.tot-sum
      241           tt-par-dtl.q-ty-doc  = tt-par-dtl.q-ty-doc + buf2_chk-pay.doc-qnty
      242           .
      243         end.
      244         release tt-par-dtl.
      245       end.
      246         if loc-chk-doc.chk-type <> integer('7':U) then do:
      247           find first buf_inkas-pay-wth where
      248                     buf_inkas-pay-wth.inkas-code = pardoc-code
      249                 and buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
      250                 and buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
      251                 and buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
      252                 and buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
      253                 and buf_inkas-pay-wth.pay-desk = loc-chk-doc.pay-desk
      254                 and buf_inkas-pay-wth.cashier = loc-chk-doc.cashier
      255                 and buf_inkas-pay-wth.chk-type = loc-chk-doc.chk-type no-error.
      256           if not available  buf_inkas-pay-wth then do:
      257             create buf_inkas-pay-wth.
      258             assign
      259             buf_inkas-pay-wth.inkas-code = pardoc-code
      260             buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
      261             buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
      262             buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
      263             buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
      264             buf_inkas-pay-wth.pay-desk = loc-chk-doc.pay-desk
      265             buf_inkas-pay-wth.cashier = loc-chk-doc.cashier
      266             buf_inkas-pay-wth.chk-type = loc-chk-doc.chk-type
      267             buf_inkas-pay-wth.par-val = buf_chk-pay.par-val
      268             .
      269           end.
      270           assign
      271           buf_inkas-pay-wth.tot-sum = buf_inkas-pay-wth.tot-sum + buf_chk-pay.tot-sum
      272           buf_inkas-pay-wth.tot-base = buf_inkas-pay-wth.tot-base + buf_chk-pay.tot-base
      273           buf_inkas-pay-wth.tot-rubl = buf_inkas-pay-wth.tot-rubl + buf_chk-pay.tot-rubl
      274           buf_inkas-pay-wth.doc-qnty = buf_inkas-pay-wth.doc-qnty + buf_chk-pay.doc-qnty
      275           buf_inkas-pay-wth.tot-lines = buf_inkas-pay-wth.tot-lines + 1
      276           .
      277         end.
      278     end.
      279     assign
      280     var-sum = var-sum + buf_chk-pay.tot-sum
      281     .
      282     if last-of(buf_chk-pay.curr-code) and var-sum <> 0 then do:
      283       if parext-doc-type = 'iy':U then do:
      284         if string(parchk-type) = '4':U then dO:
      285           if buf_cash-pay.wth-code = 0 and
      286             buf_cash-pay.is-cash = no AND
      287             string(loc-chk-doc.chk-type) = '4':U then do:
      288           end.
      289           else do:
      290             run str/wth-lni1.p (
      291                           input-output varline-rec
      292                           ,input  'ДОБАВЛЕНИЕ':U
      293                           ,input  pardoc-code
      294                           ,input  cur-wth
      295                           ,input  buf_wth-place.w-p-code
      296                           ,input  par-koeff * buf_chk-pay.tot-sum
      297                           ,input  yes
      298                           ) no-error .
      299           end.
      300         END.
      301         else do:
      302           run str/wth-lnv1.p (
      303                          input-output varline-rec
      304                         ,input  'ДОБАВЛЕНИЕ':U
      305                         ,input  pardoc-code
      306                         ,input  cur-wth
      307                         ,input  buf_wth-place.w-p-code
      308                         ,input  ?
      309                         ,input  par-koeff * buf_chk-pay.tot-sum
      310                         ,input  table tt-par-dtl-inv
      311                         ,input  yes
      312                         ) no-error .
      313         end.
      314       end.
      315       else do:
      316         run str/wth-lnc1.p (
      317                        input-output varline-rec
      318                       ,input  'ДОБАВЛЕНИЕ':U
      319                       ,input p-silent
      320                       ,input pardoc-code
      321                       ,input cur-wth
      322                       ,input buf_wth-place.w-p-code
      323                       ,input parout-w-p-code
      324                       ,input par-koeff * abs(var-sum)
      325                       ,input (if loc-chk-doc.chk-type = integer('7':U)
      326                               then 0.0
      327                               else par-koeff * abs(var-sum))
      328                       ,input table tt-par-dtl
      329                       ,input yes
      330                       ,input parext-doc-type
      331                       ,input 0
      332                       ,input 0
      333                       ) no-error .
      334       end.
      335       if error-status:error then do:
      336         define variable v-mess as character no-undo .
      337         v-mess = substitute("Не удалось создать (изменить, удалить) строку автоматического документа МЦ&1"  +
      338                             "код МЦ &2&1"  +
      339                             "МХ &3&1" +
      340                             "МХ назначения &4&1&5&1&6"
      341                             , chr(10)
      342                             , cur-wth
      343                             , buf_wth-place.w-p-code
      344                             , parout-w-p-code
      345                             , error-status:get-message(1)
      346                             , return-value).
      347         if not p-silent then do:
      348           message
      349           v-mess
      350           view-as alert-box error .
      351         end.
      352         undo _chk-pay, return error (if p-silent then v-mess else '').
      353       end.
      354     end.
      355     assign
      356     buf_chk-pay.out-code = (if par-koeff = 1 then pardoc-code else '':U)
      357     .
      358   END.
      359   for each buf_c-chk-doc where
      360           buf_c-chk-doc.doc-code = loc-chk-doc.doc-code  :
      361       assign
      362       buf_c-chk-doc.out-code = (if par-koeff = 1 then pardoc-code else '':U)
      363       .
      364   end.
      365   for each buf_c-chk-pay where
      366           buf_c-chk-pay.doc-code = loc-chk-doc.doc-code     :
      367       assign
      368       buf_c-chk-pay.out-code = (if par-koeff = 1 then pardoc-code else '':U)
      369       .
      370   end.
      371   assign
      372   loc-chk-doc.out-code = (if par-koeff = 1 then pardoc-code else '':U).
      373   end.
