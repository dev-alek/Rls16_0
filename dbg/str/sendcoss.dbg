     3197       .
     3198   end.
     3199     finally :
     3200       run write-log-and-file in p-log-handle (
     3201           input 1
     3202         , input log-file-name
     3203         , input 1
     3204         , input substitute("&1", chr(10))
     3205       ).
     3206       define variable v-save-file-name as character no-undo .
     3207       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     3208       OS-APPEND value(log-file-name) value(v-save-file-name).
     3209       OS-DELETE value(log-file-name).
