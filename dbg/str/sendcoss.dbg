     2201     do
     2202     on error undo, return error
     2203     :
     2204     pSubs = trim(pSubs,chr(6)) .
     2205     if pSubs = "" then do:
     2206           if action <> 'D' then do:
     2207         for each buf_OperServ where buf_OperServ.Status_ = 0:
     2208             v-sum = buf_OperServ.CommPerc + buf_OperServ.CommSumm .
     2209             run bgelib-tag-open in this-procedure ( input 2, input "OperServ", input substitute("ctrl='&2' tms='&3' code='&1'", string (buf_OperServ.id), "ADD":u, OS2-time)).
     2210             run bgelib-tag-put in this-procedure ( input 3, input "OSCode":U, input string (buf_OperServ.id), input 1 ).
     2211             run bgelib-tag-put in this-procedure ( input 3, input "OSName":U, input string(buf_OperServ.OSname), input 1 ).
     2212             run bgelib-tag-put in this-procedure ( input 3, input "OSQuantMin":U, input string(buf_OperServ.QuantMin), input 1 ).
     2213             run bgelib-tag-put in this-procedure ( input 3, input "OSQuantMax":U, input string(buf_OperServ.QuantMax), input 1 ).
     2214             run bgelib-tag-put in this-procedure ( input 3, input "OSSumMin":U, input string(buf_OperServ.SummMin), input 1 ).
     2215             run bgelib-tag-put in this-procedure ( input 3, input "OSSumMax":U, input string(buf_OperServ.SummMax), input 1 ).
     2216             run bgelib-tag-put in this-procedure ( input 3, input "OSSumAtent":U, input string(buf_OperServ.SummAtent), input 1 ).
     2217             run bgelib-tag-put in this-procedure ( input 3, input "OSComType":U, input string(if v-sum > 0 then string(buf_OperServ.CommType) else "0"), input 1 ).
     2218             run bgelib-tag-put in this-procedure ( input 3, input "OSComPerc":U, input string(buf_OperServ.CommPerc), input 1 ).
