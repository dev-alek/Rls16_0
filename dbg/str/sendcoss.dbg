     3041   RUN SENDING no-error.
     3042   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3043   PROCEDURE SENDING:
     3044   _cash-desk:
     3045   FOR EACH ub.cash-desk NO-LOCK WHERE
     3046            ub.cash-desk.db-num = g#db-num AND
     3047            ub.cash-desk.obj-code = i-obj-code AND
     3048           ub.cash-desk.cash-on
     3049   BREAK
     3050   By ub.cash-desk.pos-type :
     3051     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     3052   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3053   define variable dflt-cd25 as character no-undo .
     3054   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3055   define variable v-param-type26 as character no-undo .
     3056   define variable v-value-date26 as date no-undo .
     3057   define variable v-value-decimal26 as decimal no-undo .
     3058   define variable v-value-integer26 as INTEGER no-undo .
     3059   define variable v-value-logical26 AS LOGICAL no-undo .
     3060   define variable v-tth26 as handle no-undo .
     3061   run adm/shattri.p (
     3062       input "get":U
     3063       ,input  'маг':U
     3064       ,input  ub.cash-desk.obj-code
     3065       ,input  'cd-sending':U
     3066       ,input  'dflt-cd':U
     3067       ,output dflt-cd25
     3068       ,output v-value-date26
     3069       ,output v-value-decimal26
     3070       ,output v-value-integer26
     3071       ,output v-value-logical26
     3072       ,output v-param-type26
     3073       ,INPUT-OUTPUT table-handle v-tth26
     3074       ) no-error .
     3075   delete object v-tth26 no-error.
     3076   case ub.cash-desk.pos-type:
     3077       when 'IBM-XML':U or when 'Autotank':U
     3078     then do:
     3079   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3080   run str/get-inis.p (
     3081                   input 'маг':U
     3082                 , input ub.cash-desk.obj-code
     3083                 , input ub.cash-desk.pos-type
     3084                 , input cash-desk.remote
     3085                 , input "send":U
     3086                 , output out
     3087                 , output out2
     3088                 , output in_
     3089                 , output spl
     3090                 , output sav
     3091                 , output v-remote
     3092                 )  no-error .
     3093   if error-status:error then do:
     3094     run write-log-and-file in p-log-handle (
     3095           input 1
     3096         , input log-file-name
     3097         , input 1
     3098         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3099                             , ub.cash-desk.pos-type
     3100                             , ub.cash-desk.obj-code
     3101                             , chr(10)
     3102                             , error-status:get-message(1)
     3103                             , return-value )).
     3104     assign
     3105     v-view-log = yes.
     3106     return error.
     3107   end.
     3108   if ub.cash-desk.pos-type = 'IBM-XML':U
     3109   or ub.cash-desk.pos-type = 'Autotank':U
     3110   then do:
     3111     file-info:file-name = (out  + "undelivered").
     3112     if file-info:FULL-PATHNAME <> ? then do:
     3113       run str/rsndxibm.p ( input parparentproc
     3114                           ,input p-parent-handle
     3115                           ,input p-log-handle
     3116                           ,input out  + "undelivered" ) no-error.
     3117     end.
     3118   end.
     3119     end.
     3120     when 'IBM':U
     3121     then do:
     3122   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123   run str/get-inis.p (
     3124                   input 'маг':U
     3125                 , input ub.cash-desk.obj-code
     3126                 , input ub.cash-desk.pos-type
     3127                 , input cash-desk.remote
     3128                 , input "send":U
     3129                 , output out
     3130                 , output out2
     3131                 , output in_
     3132                 , output spl
     3133                 , output sav
     3134                 , output v-remote
     3135                 )  no-error .
