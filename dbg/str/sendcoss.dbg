     2235             run bgelib-tag-put in this-procedure ( input 3, input "OSObtainOperPhn":U, input string(if buf_OperServ.OperTel <> ? then buf_OperServ.OperTel else ""), input 1 ).
     2236             case buf_OperServ.OsType:
     2237               when 0 then do:
     2238                 v-OsType = "".
     2239               end.
     2240               when 1 then do:
     2241                 v-OsType = "mobile".
     2242               end.
     2243               when 2 then do:
     2244                 v-OsType = "autohelp".
     2245               end.
     2246               when 3 then do:
     2247                 v-OsType = "remittance".
     2248               end.
     2249               when 5 then do:
     2250                 v-OsType = "cashingout" .
     2251               end.
     2252             end.
     2253             run bgelib-tag-put in this-procedure ( input 3, input "OSExtHndl":U, input string(v-OsType), input 1 ).
     2254             run bgelib-tag-put in this-procedure ( input 3, input "OSItemCode":U, input string(if buf_OperServ.gds-code <> ? then buf_OperServ.gds-code else 0), input 1 ).
     2255           run bgelib-tag-close in this-procedure ( input 2, input "OperServ").
     2256         end.
     2257         end.
     2258       else do:
     2259         run bgelib-tag-open in this-procedure ( input 2, input "OperServ", input substitute("ctrl='&2' code='&1'", "*", "DEL":u)).
     2260         run bgelib-tag-close in this-procedure ( input 2, input "OperServ").
     2261       end.
     2262       end.
     2263       else do:
     2264         do ii = 1 to num-entries (pSubs,chr(6)):
     2265               for each buf_OperServ where buf_OperServ.Status_ = 0 and buf_OperServ.id = integer(entry(ii,pSubs,chr(6))):
     2266           if action <> 'D' then do:
     2267             v-sum = buf_OperServ.CommPerc + buf_OperServ.CommSumm .
     2268             run bgelib-tag-open in this-procedure ( input 2, input "OperServ", input substitute("ctrl='&2' tms='&3' code='&1'", string (buf_OperServ.id), "ADD":u, OS2-time)).
     2269             run bgelib-tag-put in this-procedure ( input 3, input "OSCode":U, input string (buf_OperServ.id), input 1 ).
     2270             run bgelib-tag-put in this-procedure ( input 3, input "OSName":U, input string(buf_OperServ.OSname), input 1 ).
     2271             run bgelib-tag-put in this-procedure ( input 3, input "OSQuantMin":U, input string(buf_OperServ.QuantMin), input 1 ).
     2272             run bgelib-tag-put in this-procedure ( input 3, input "OSQuantMax":U, input string(buf_OperServ.QuantMax), input 1 ).
     2273             run bgelib-tag-put in this-procedure ( input 3, input "OSSumMin":U, input string(buf_OperServ.SummMin), input 1 ).
     2274             run bgelib-tag-put in this-procedure ( input 3, input "OSSumMax":U, input string(buf_OperServ.SummMax), input 1 ).
     2275             run bgelib-tag-put in this-procedure ( input 3, input "OSSumAtent":U, input string(buf_OperServ.SummAtent), input 1 ).
     2276             run bgelib-tag-put in this-procedure ( input 3, input "OSComType":U, input string(if v-sum > 0 then string(buf_OperServ.CommType) else "0"), input 1 ).
     2277             run bgelib-tag-put in this-procedure ( input 3, input "OSComPerc":U, input string(buf_OperServ.CommPerc), input 1 ).
     2278             run bgelib-tag-put in this-procedure ( input 3, input "OSComSum":U, input string(buf_OperServ.CommSumm), input 1 ).
     2279             run bgelib-tag-put in this-procedure ( input 3, input "OSPreAvt":U, input string(if buf_OperServ.PreAAvt = true then "1" else "0"), input 1 ).
     2280             run bgelib-tag-put in this-procedure ( input 3, input "OSPreSlip":U, input string(if buf_OperServ.PreSlip = true then "1" else "0"), input 1 ).
     2281             run bgelib-tag-put in this-procedure ( input 3, input "OSSlipName":U, input string(buf_OperServ.SlipName), input 1 ).
     2282             run bgelib-tag-put in this-procedure ( input 3, input "OSOperType":U, input string(buf_OperServ.CalcType), input 1 ).
     2283             run bgelib-tag-put in this-procedure ( input 3, input "OSAgntSign":U, input string(buf_OperServ.AgentFlag), input 1 ).
     2284             run bgelib-tag-put in this-procedure ( input 3, input "OSPayAgntPhn":U, input string(buf_OperServ.AgentTel), input 1 ).
     2285             run bgelib-tag-put in this-procedure ( input 3, input "OSPayAgntSgn":U, input string(buf_OperServ.AgentFlagRasch), input 1 ).
     2286             run bgelib-tag-put in this-procedure ( input 3, input "OSPayAgntTrnsct":U, input string(buf_OperServ.AgentOpere), input 1 ).
     2287             run bgelib-tag-put in this-procedure ( input 3, input "OSTrnsfOperName":U, input string(buf_OperServ.OperName), input 1 ).
     2288             run bgelib-tag-put in this-procedure ( input 3, input "OSTrnsfOperAddr":U, input string(buf_OperServ.OperAddr), input 1 ).
     2289             run bgelib-tag-put in this-procedure ( input 3, input "OSTrnsfOperINN":U, input string(buf_OperServ.OperInn), input 1 ).
     2290                     run bgelib-tag-put in this-procedure ( input 3, input "OSTrnsfOperPhn":U, input string(if buf_OperServ.OperTelTran <> ? then buf_OperServ.OperTelTran else ""), input 1 ).
     2291             run bgelib-tag-put in this-procedure ( input 3, input "OSProvidName":U, input string(buf_OperServ.SuppName), input 1 ).
     2292             run bgelib-tag-put in this-procedure ( input 3, input "OSProvidPhn":U, input string(if buf_OperServ.SuppTel <> ? then buf_OperServ.SuppTel else ""), input 1 ).
     2293             run bgelib-tag-put in this-procedure ( input 3, input "OSProvidINN":U, input string(buf_OperServ.InnSupp), input 1 ).
     2294             run bgelib-tag-put in this-procedure ( input 3, input "OSObtainOperPhn":U, input string(if buf_OperServ.OperTel <> ? then buf_OperServ.OperTel else ""), input 1 ).
     2295             case buf_OperServ.OsType:
     2296               when 0 then do:
     2297                 v-OsType = "".
     2298               end.
