      133   procedure alienini-getkey :
      134   define input parameter i-filename as char.
      135   define input parameter i-section as char.
      136   define input parameter i-key as char.
      137   define output parameter o-value as char.
      138   define variable EntryPointer as integer no-undo.
      139   define variable mem1 as memptr no-undo.
      140   define variable mem2 as memptr no-undo.
      141   define variable mem1size as integer no-undo.
      142   define variable mem2size as integer no-undo.
      143   define variable ii       as integer    no-undo.
      144   define variable cbReturnSize  as integer    no-undo.
      145   assign
      146   set-size(mem1)  = 4000
      147   mem1size = 4000.
      148   if i-key = "" then EntryPointer = 0.
      149   else do:
      150     assign
      151     set-size(mem2) = 128
      152     mem2size = 128
      153     EntryPointer = get-pointer-value(mem2)
      154     put-string(mem2, 1) = i-key.
      155   end.
      156   run getprivateprofilestringA
      157                                 (i-section,
      158                                  EntryPointer,
      159                                  "",
      160                                  get-pointer-value(mem1),
      161                                  input mem1size,
      162                                  i-filename,
      163                                  output cbReturnSize).
      164   do ii = 1 to cbReturnSize:
      165     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      166                  then o-value + ","
      167                  else o-value + chr(get-byte(mem1, ii)).
      168   end.
      169     set-size(mem1) = 0.
      170     set-size(mem2) = 0.
      171   end procedure.
      172   procedure alienini-putkey :
      173   define input parameter i-filename as char.
      174   define input parameter i-section as char.
      175   define input parameter i-key as char.
      176   define input parameter i-value as char.
      177   define variable cbReturnSize as integer.
      178   run writeprivateprofilestringA
      179                                  (i-section,
      180                                   i-key,
      181                                   i-value,
      182                                   i-filename,
      183                                   output cbReturnSize ).
      184   end procedure.
      185   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      186     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      187     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      188     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      189     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      190     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      191     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      192     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      193   END PROCEDURE.
      194   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      195     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      196     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      197     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      198     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      199     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      200   END PROCEDURE.
      201   define   temp-table temp-tekka-tsk no-undo
      202   field filename      as character
      203   field obj-num       as integer
      204   field obj-name      as character
      205   field num-records   as integer
      206   field max-records   as integer
      207   field min-plu       as integer
      208   field max-plu       as integer
      209   field num-fields    as integer
      210   field task-num      as character
      211   field by-record     as logical
      212   field send-get      as character
      213   field cash-num      as integer
      214   field cash-num-char as character
      215   field port-num      as character
      216   field way           as character
      217   field is-script     as logical
      218   field pswd          as character
      219   field waiting-sek   as integer
      220   field other-info    as character
      221   field order-num     as integer
      222   field secondary     as integer
      223   field shift-fields  as integer
      224   field binary        as logical
      225   field range         as integer
      226   index pi is unique primary
      227   filename
      228   range
      229   index lpi
      230   filename
      231   min-plu
      232   index gpi
      233   filename
      234   max-plu
      235   index iorder
      236   order-num
      237   .
      238   define   temp-table temp-tekka-schema no-undo
      239   field obj-num as integer
      240   field obj-name as character
      241   field field-num as integer
      242   field field-name as character
      243   field num-records as integer
      244   field size_ as integer
      245   field host as character
      246   field progress-type as character
      247   field custom-type as character
      248   field start-pos as integer
      249   field end-pos as integer
      250   field bin-group as character
      251   index pi is unique primary
      252   host obj-num field-num
      253   .
      254   define temp-table temp-tekka-record no-undo
      255   field obj-num as integer
      256   field plu as integer
      257   field body as character
      258   field shift as integer
      259   index pi is unique primary obj-num plu.
      260   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      261   define variable v-is-closed-shift-journal as integer no-undo .
      262   assign
      263   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      264                               +
      265                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      266                               +
      267                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      268   .
      269   return v-is-closed-shift-journal.
      270   END FUNCTION.
      271   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      272   define variable v-is-first-journal as logical no-undo .
      273   assign
      274   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      275                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      276                     or (p-journal-num =  integer(entry(1, '17':U)))
      277                     or (p-journal-num = integer(entry(1, '16':U)))
      278   .
      279   return v-is-first-journal.
      280   END FUNCTION.
      281   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      282   define variable v-is-petrol-journal as logical no-undo .
      283   assign
      284   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      285   return v-is-petrol-journal.
      286   END FUNCTION.
      287   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      288   define variable v-max-record-num as integer no-undo .
      289   assign
      290   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      291                       then 1489
      292                       else 2340).
      293   return v-max-record-num.
      294   END FUNCTION.
      295   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      296   define variable v-max-record-num as integer no-undo .
      297   assign
      298   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      299                       then 1489 * num-entries('30,31,32,33':U)
      300                       else 2340 * num-entries('17':U)).
      301   return v-max-record-num.
      302   END FUNCTION.
      303   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      304                                           ,input p-rec-no as integer):
      305   define variable v-num-recs as integer no-undo .
      306   if tekka-is-petrol-journal (p-journal-num) then do:
      307     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      308       assign
      309       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      310       .
      311     end.
      312     else do:
      313       assign
      314       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      315       .
      316     end.
      317   end.
      318   else do:
      319     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      320       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      321         assign
      322         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      323         .
      324       end.
      325       else do:
      326         assign
      327         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      328         .
      329       end.
      330     end.
      331     else do:
      332       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      333         assign
      334         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      335         .
      336       end.
      337       else do:
      338         assign
      339         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      340         .
      341       end.
      342     end.
      343   end.
      344   return v-num-recs.
      345   END FUNCTION.
      346   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      347                                              ,input p-is-petrol as logical
      348                                              ,input p-is-current as logical
      349                                              ,output p-rec-no as decimal
      350                                              ):
      351   define variable v-obj-num0 as integer no-undo .
      352   define variable v-obj-num as integer no-undo .
      353   define variable v-obj-num2 as integer no-undo .
      354   define variable p-num-recs2 as integer no-undo .
      355   define variable p-rec-no2 as integer no-undo .
      356   if p-is-petrol then do:
      357     assign
      358     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      359     .
      360     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      361     then
      362     assign
      363     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      364     p-rec-no = p-num-recs modulo 1489
      365     .
      366     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      367     then
      368     assign
      369     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      370     p-rec-no = p-num-recs modulo 1489
      371     .
      372   end.
      373   else do:
      374     assign
      375     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      376     p-num-recs = trunc(p-num-recs, 0)
      377     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      378     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      379     .
      380     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      381     then
      382     assign
      383     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      384     p-rec-no = p-num-recs modulo 2340
      385     .
      386     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      387     then
      388     assign
      389     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      390     p-rec-no = p-num-recs modulo 2340
      391     .
      392     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      393     then
      394     assign
      395     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      396     p-rec-no2 = p-num-recs2 modulo 2978
      397     .
      398     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      399     then
      400     assign
      401     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      402     p-rec-no2 = p-num-recs2 modulo 2978
      403     .
      404     assign
      405     p-rec-no = p-rec-no + p-rec-no2 / 10000
      406     .
      407   end.
      408   if v-obj-num = 0 then v-obj-num = 100.
      409   return v-obj-num.
      410   END FUNCTION.
      411   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      412   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      413   if lookup (string(p-obj-num), '17':U) > 0 then do:
      414      if p-is-ptrl then
      415      return integer(entry(1, '26,27,28,29':U)).
      416      if not p-is-ptrl then
      417      return integer(entry(1, '16':U)).
      418   end.
      419   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      420   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      421   return 0.
      422   END FUNCTION.
      423   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      424   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      425   if lookup (string(p-obj-num), '17':U) > 0 then do:
      426     if p-is-ptrl then
      427     return integer(entry(1, '26,27,28,29':U)).
      428     if not p-is-ptrl then
      429     return integer(entry(1, '16':U)).
      430   end.
      431   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      432   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      433   return 0.
      434   END FUNCTION.
      435   PROCEDURE maria-put:
      436   define parameter buffer buf_cash-desk for ub.cash-desk.
      437   define input parameter p-out    as character no-undo .
      438   define input parameter p-fname as character no-undo .
      439   define input parameter p-by-record as logical no-undo .
      440   define input parameter p-shift-fields as integer no-undo .
      441   define input parameter p-binary as logical no-undo .
      442   define input parameter p-obj-num as integer no-undo .
      443   define input parameter p-max-records as integer no-undo .
      444   define input parameter p-plu as integer no-undo .
      445   define input parameter p-value as character no-undo .
      446   define variable v-file-name as character no-undo .
      447   define variable v-create as logical no-undo .
      448   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      449   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      450   output stream IBMSTREAM
      451   to value(v-file-name) append .
      452   Put  stream IBMSTREAM unformatted
      453   p-plu
      454   chr(3)
      455   p-value
      456   skip.
      457   output stream IBMSTREAM
      458   close.
      459   if not p-by-record then do:
      460     find first buf_temp-tekka-tsk where
      461               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      462     if not available buf_temp-tekka-tsk then do:
      463       v-create = yes.
      464     end.
      465   end.
      466   else do:
      467     find first buf_temp-tekka-tsk where
      468               buf_temp-tekka-tsk.filename  = v-file-name
      469           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      470     if not available buf_temp-tekka-tsk
      471     then do:
      472       find first buf_temp-tekka-tsk where
      473                 buf_temp-tekka-tsk.filename  = v-file-name
      474             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      475       if not available buf_temp-tekka-tsk
      476       then do:
      477         v-create = yes.
      478       end.
      479     end.
      480   end.
      481   if v-create then do:
      482     create buf_temp-tekka-tsk.
      483     assign
      484     buf_temp-tekka-tsk.filename = v-file-name
      485     buf_temp-tekka-tsk.range    = p-plu
      486     buf_temp-tekka-tsk.obj-num = p-obj-num
      487     buf_temp-tekka-tsk.obj-name = '':U
      488     buf_temp-tekka-tsk.num-records = 0
      489     buf_temp-tekka-tsk.max-records = p-max-records
      490     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      491     buf_temp-tekka-tsk.task-num = p-fname
      492     buf_temp-tekka-tsk.by-record = p-by-record
      493     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      494     buf_temp-tekka-tsk.binary = p-binary
      495     buf_temp-tekka-tsk.send-get = 'send'
      496     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      497     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      498     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      499     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      500                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      501                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      502                                 then 'local'
      503                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      504     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      505     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      506     buf_temp-tekka-tsk.waiting-sek = 30
      507     buf_temp-tekka-tsk.min-plu     = p-plu
      508     buf_temp-tekka-tsk.max-plu     = p-plu
      509     .
      510   end.
      511   assign
      512   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      513   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      514   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      515   .
      516   END PROCEDURE.
      517   PROCEDURE maria-get:
      518   define parameter buffer buf_cash-desk for ub.cash-desk.
      519   define input parameter p-out    as character no-undo .
      520   define input parameter p-fname as character no-undo .
      521   define input parameter p-by-record as logical no-undo .
      522   define input parameter p-obj-num as integer no-undo .
      523   define input parameter p-num-fields as integer no-undo .
      524   define input parameter p-max-records as integer no-undo .
      525   define input parameter p-min-plu as integer no-undo .
      526   define input parameter p-max-plu as integer no-undo .
      527   define input parameter p-other as character no-undo .
      528   define input parameter p-order-num as integer no-undo .
      529   define variable v-file-name as character no-undo .
      530   define variable v-secondary-obj-num as character no-undo .
      531   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      532   if p-by-record then do:
      533     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      534   end.
      535   else do:
      536     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      537   end.
      538   find first buf_temp-tekka-tsk where
      539             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      540   if not available buf_temp-tekka-tsk then do:
      541     create buf_temp-tekka-tsk.
      542     assign
      543     buf_temp-tekka-tsk.filename = v-file-name
      544     buf_temp-tekka-tsk.obj-num = p-obj-num
      545     buf_temp-tekka-tsk.obj-name = '':U
      546     buf_temp-tekka-tsk.max-records = p-max-records
      547     buf_temp-tekka-tsk.num-fields = p-num-fields
      548     buf_temp-tekka-tsk.task-num = p-fname
      549     buf_temp-tekka-tsk.by-record = p-by-record
      550     buf_temp-tekka-tsk.send-get = 'get'
      551     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      552     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      553     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      554     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      555                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      556                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      557                                   then 'local'
      558                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      559     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      560     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      561     buf_temp-tekka-tsk.waiting-sek = 30
      562     buf_temp-tekka-tsk.min-plu     = p-min-plu
      563     buf_temp-tekka-tsk.max-plu     = p-max-plu
      564     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      565                                       and p-max-plu <> ?
      566                                       then p-max-plu - p-min-plu + 1
      567                                       else 0)
      568     buf_temp-tekka-tsk.other-info = p-other
      569     buf_temp-tekka-tsk.order-num = p-order-num
      570     .
      571     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      572       assign
      573       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      574       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      575       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      576       no-error
      577       .
      578       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      579     end.
      580   end.
      581   END PROCEDURE.
      582   PROCEDURE maria-task:
      583   define parameter buffer buf_cash-desk for ub.cash-desk.
      584   define input parameter p-fname as character no-undo .
      585   define input parameter p-obj-num-list as character no-undo .
      586   define input parameter p-parameters as character no-undo .
      587   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      588   find first buf_temp-tekka-tsk where
      589             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      590   if not available buf_temp-tekka-tsk then do:
      591     create buf_temp-tekka-tsk.
      592     assign
      593     buf_temp-tekka-tsk.filename = ''
      594     buf_temp-tekka-tsk.range = 1
      595     buf_temp-tekka-tsk.obj-num = 0
      596     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      597     buf_temp-tekka-tsk.task-num = p-fname
      598     buf_temp-tekka-tsk.by-record = no
      599     buf_temp-tekka-tsk.send-get = 'task'
      600     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      601     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      602     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      603     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      604                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      605                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      606                                   then 'local'
      607                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      608     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      609     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      610     buf_temp-tekka-tsk.waiting-sek = 30
      611     buf_temp-tekka-tsk.other-info = p-parameters
      612     buf_temp-tekka-tsk.order-num = 0
      613     .
      614   end.
      615   END PROCEDURE.
      616   procedure tekkatsk-verify-schema :
      617   define input parameter p-obj-list as character no-undo .
      618   define input parameter p-dir-path as character no-undo .
      619   define variable v-obj-num as integer no-undo .
      620   define variable v-obj-name as character no-undo .
      621   define variable v-num-records as integer no-undo .
      622   define variable v-size_ as integer no-undo .
      623   define variable v-value as character no-undo .
      624   define variable ii as integer no-undo .
      625   define variable jj as integer no-undo .
      626   define variable ii-ibs as integer no-undo .
      627   define variable ii-tekka as integer no-undo .
      628   define variable v-result as character no-undo .
      629   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      630   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      631     do
      632     on error undo, return error
      633     :
      634        for each buf_temp-tekka-schema:
      635          delete buf_temp-tekka-schema.
      636        end.
      637        input from value('tekkasch.d').
      638        repeat :
      639          create buf_temp-tekka-schema.
      640          import buf_temp-tekka-schema.
      641          assign
      642          buf_temp-tekka-schema.host = 'IBS'
      643          ii = ii + 1.
      644          .
      645        end.
      646        input close.
      647        ii-ibs = ii.
      648         _ii:
      649         do ii = 1 to 256:
      650           if p-obj-list = "ALL"
      651           or lookup(string(ii), p-obj-list) > 0 then do:
      652             assign
      653             v-obj-num = 0
      654             v-obj-name = ''
      655             v-num-records = 0
      656             v-size_ = 0
      657             .
      658             run alienini-getkey in this-procedure (
      659                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      660                                                     ,input ('obj' + string(ii, '999'))
      661                                                     ,input 'oname'
      662                                                     ,output v-value) no-error .
      663             if v-value = ? then next _ii.
      664             assign
      665             v-obj-num = ii
      666             v-obj-name = v-value
      667             .
      668             run alienini-getkey in this-procedure (
      669                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      670                                                     ,input ('obj' + string(ii, '999'))
      671                                                     ,input 'size'
      672                                                     ,output v-value) no-error .
      673             assign
      674             v-num-records = integer(v-value) no-error  .
      675             if error-status:error
      676             or v-num-records = 0 then next _ii.
      677             run alienini-getkey in this-procedure (
      678                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      679                                                     ,input 'obj' + string(ii, '999')
      680                                                     ,input 'f000'
      681                                                     ,output v-value) no-error .
      682             assign
      683             v-size_ = integer(v-value) no-error  .
      684             if error-status:error
      685             or v-size_ = 0 then next _ii.
      686             _jj:
      687             do jj = 1 to 256:
      688               run alienini-getkey in this-procedure (
      689                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      690                                                       ,input 'obj' + string(ii, '999')
      691                                                       ,input 'f' + string(jj, '999')
      692                                                       ,output v-value) no-error .
      693               if v-value = ? then next _ii.
      694               create buf_temp-tekka-schema.
      695               assign
      696               buf_temp-tekka-schema.host = 'tekka'
      697               buf_temp-tekka-schema.obj-num = v-obj-num
      698               buf_temp-tekka-schema.obj-name = v-obj-name
      699               buf_temp-tekka-schema.num-records = v-num-records
      700               buf_temp-tekka-schema.size_ = v-size_
      701               buf_temp-tekka-schema.field-num = jj
      702               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      703               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      704                                                  then entry(2, entry(2, v-value, '#'), ':')
      705                                                  else '':U)
      706               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      707               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      708               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      709                                                           , 'C,I,I,I,D,D,D,D,D':U)
      710               no-error
      711               .
      712               if error-status:error then do:
      713                 delete buf_temp-tekka-schema.
      714                 next _jj.
      715               end.
      716               run alienini-getkey in this-procedure (
      717                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      718                                                       ,input 'obj' + string(ii, '999') + 'name'
      719                                                       ,input 'n' + string(jj, '999')
      720                                                       ,output v-value) no-error .
      721               if v-value <> ? then
      722               buf_temp-tekka-schema.field-name = v-value.
      723             end.
      724           end.
      725         end.
      726         ii-tekka = ii - 1.
      727        if p-obj-list <> 'ALL' then do:
      728         if ii-tekka <> ii-ibs then do:
      729           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      730                                   , ii-ibs
      731                                   , ii-tekka).
      732         end.
      733        end.
      734        for each buf_temp-tekka-schema where
      735               buf_temp-tekka-schema.host = 'tekka':
      736          find first buf2_temp-tekka-schema where
      737                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      738                AND buf2_temp-tekka-schema.host = 'ibs'
      739                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      740          if not available buf2_temp-tekka-schema then do:
      741           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      742                                   , buf_temp-tekka-schema.field-num
      743                                   , buf_temp-tekka-schema.obj-num).
      744          end.
      745          buffer-compare buf_temp-tekka-schema
      746          to buf2_temp-tekka-schema
      747          save result in v-result.
      748          if v-result <> '':U then do:
      749           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      750                                   , buf_temp-tekka-schema.field-num
      751                                   , buf_temp-tekka-schema.obj-num).
      752          end.
      753        end.
      754     end.
      755   end procedure.
      756   FUNCTION set-Sx returns character (input p-string as character):
      757   return p-string.
      758   END FUNCTION.
      759   FUNCTION get-Sx returns character (input p-string  as character):
      760   return p-string.
      761   END FUNCTION.
      762   FUNCTION set-B returns character (input p-string  as character):
      763   return chr(integer(p-string)).
      764   END FUNCTION.
      765   FUNCTION get-B returns character (input p-string  as character):
      766   return string(asc(p-string)).
      767   END FUNCTION.
      768   FUNCTION set-BF returns character (input p-string  as character):
      769   define variable v-dopi as integer no-undo .
      770   define variable ii as integer no-undo .
      771   do ii = 1 to 8:
      772     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      773   end.
      774   return chr(v-dopi).
      775   END FUNCTION.
      776   FUNCTION get-BF returns character (input p-string  as character):
      777   define variable v-dopi as integer no-undo .
      778   define variable v-dops as character no-undo .
      779   define variable ii as integer no-undo .
      780   v-dopi = asc(p-string).
      781   do ii = 8 to 1 BY -1:
      782     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      783   end.
      784   return v-dops.
      785   END FUNCTION.
      786   FUNCTION set-BN returns character (input p-string  as character
      787                                     ,input p-bin-group as character):
      788   define variable v-dopi as integer no-undo .
      789   define variable ii as integer no-undo .
      790   define variable jj as integer no-undo .
      791   define variable v-grp-nums as integer no-undo .
      792   define variable v-dopi2 as integer no-undo .
      793   v-grp-nums = num-entries(p-bin-group).
      794   do jj = 0 to v-grp-nums - 1:
      795     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      796     do ii = 1 to 8:
      797       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      798     end.
      799   end.
      800   return chr(v-dopi).
      801   END FUNCTION.
      802   FUNCTION get-BN returns character (input p-string  as character
      803                                     ,input p-bin-group as character):
      804   define variable v-dopi as integer no-undo .
      805   define variable v-dops as character no-undo .
      806   define variable v-grp-nums as integer no-undo .
      807   define variable ii as integer no-undo .
      808   define variable jj as integer no-undo .
      809   v-dopi = asc(p-string).
      810   v-grp-nums = num-entries(p-bin-group).
      811   do jj = 1 to v-grp-nums:
      812   do ii = 8 to 1 BY -1:
      813     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      814   end.
      815   end.
      816   return v-dops.
      817   END FUNCTION.
      818   procedure fill-temp-cd :
      819   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      820   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      821   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      822   define input parameter p-clear-table as logical no-undo .
      823   define buffer buf_temp-cd for temp-cd.
      824   define buffer buf_cash-desk for ub.cash-desk.
      825     do
      826     on error undo, return error
      827     :
      828        if p-clear-table  then do:
      829          for each buf_temp-cd:
      830            delete buf_temp-cd.
      831          end.
      832        end.
      833        for each buf_cash-desk no-lock where
      834               buf_cash-desk.db-num = p-db-num
      835           AND buf_cash-desk.obj-code = p-obj-code
      836           and buf_cash-desk.cash-on  = yes
      837        BREAK by buf_cash-desk.pos-type:
      838          if first-of(buf_cash-desk.pos-type) then do:
      839            create buf_temp-cd.
      840            buffer-copy buf_cash-desk to buf_temp-cd.
      841          end.
      842        end.
      843     end.
      844   end procedure.
      845   define variable vss-include-info5 as character format "X(65)" no-undo
      846   initial "@(#)$Workfile$ $Revision$".
      847   define variable v-bgelib-bgefmt        as character         no-undo.
      848   define variable v-bgelib-bgeflold      as character         no-undo.
      849   define stream stmXMLOut.
      850   define stream stmXMLLog.
      851   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   procedure cur-time :
      853      define output parameter p-today as date      no-undo .
      854      define output parameter p-time  as integer   no-undo .
      855     do
      856     on error undo, return error
      857     :
      858       define variable v-date1 as date      no-undo .
      859       define variable v-date2 as date      no-undo .
      860       define variable v-time  as integer   no-undo .
      861       assign
      862         v-date1 = today
      863         v-time  = time
      864         v-date2 = today
      865       .
      866       if v-date1 <> v-date2
      867       then do:
      868         assign
      869           v-date1 = today
      870           v-time  = v-time
      871         .
      872       end.
      873       assign
      874         p-today = v-date1
      875         p-time  = v-time
      876       .
      877     end.
      878   end.
      879   function cur-time-date returns character
      880   :
      881     return string(today, '99/99/9999':U) .
      882   end.
      883   function cur-time-mjd returns decimal
      884   :
      885     define variable v-date as date      no-undo .
      886     define variable v-time as integer   no-undo .
      887     run cur-time in this-procedure
      888       (output v-date
      889       ,output v-time
      890       ) .
      891     return integer(v-date) - 2400002 + (v-time / 86400) .
      892   end.
      893   function cur-time-get-ending-index returns integer
      894   (input p-number as integer
      895   )
      896   :
      897     if p-number < 0
      898     or p-number = ?
      899     then do:
      900       return 1 .
      901     end.
      902     define variable v-rest as integer   no-undo .
      903     assign
      904       p-number = p-number modulo 100
      905     .
      906     if p-number < 20
      907     then do:
      908       assign
      909         v-rest = p-number
      910       .
      911     end.
      912     else do:
      913       assign
      914         v-rest = p-number modulo 10
      915       .
      916     end.
      917     case v-rest :
      918       when 1
      919       then do:
      920         return 2 .
      921       end.
      922       when 2 or
      923       when 3 or
      924       when 4
      925       then do:
      926         return 3 .
      927       end.
      928       otherwise do:
      929         return 1 .
      930       end.
      931     end case .
      932   end.
      933   procedure cur-time-mjd-to-date :
      934      define input  parameter i-mjd-diff as decimal no-undo.
      935      define output parameter o-Date     as date    no-undo.
      936      define output parameter o-Time     as integer no-undo.
      937      define variable v-day-number as integer   no-undo .
      938      if    i-mjd-diff < 0
      939         or i-mjd-diff = ?
      940      then do:
      941         return "?" .
      942      end.
      943      assign
      944         v-day-number = truncate(i-mjd-diff,0).
      945         o-Date = date(v-day-number + 2400002).
      946         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      947     .
      948   end.
      949   function cur-time-mjd-to-string returns character
      950   (input p-mjd-diff as decimal
      951   )
      952   :
      953     define variable v-day-number as integer   no-undo .
      954     define variable v-seconds    as integer   no-undo .
      955     define variable v-hour       as integer   no-undo .
      956     define variable v-min        as integer   no-undo .
      957     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      958     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      959     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      960     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      961     if p-mjd-diff < 0
      962     or p-mjd-diff = ?
      963     then do:
      964       return "?" .
      965     end.
      966     assign
      967       v-day-number = integer(truncate(p-mjd-diff,0))
      968       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      969     .
      970     if v-seconds > 86400
      971     then do:
      972       assign
      973         v-seconds = 86400 - 1
      974       .
      975     end.
      976     if v-seconds < 0
      977     then do:
      978       assign
      979         v-seconds = 0
      980       .
      981     end.
      982     assign
      983       v-hour = truncate(v-seconds / 3600, 0)
      984     .
      985     assign
      986       v-seconds = v-seconds modulo 3600
      987     .
      988     assign
      989       v-min = truncate(v-seconds / 60, 0)
      990     .
      991     assign
      992       v-seconds = v-seconds modulo 60
      993     .
      994     return
      995         (if v-day-number <> 0
      996           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      997           else ""
      998         )
      999       + (if v-day-number <> 0 or v-hour <> 0
     1000           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1001           else ""
     1002         )
     1003       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1004           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1005           else ""
     1006         )
     1007       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1008       .
     1009   end.
     1010   function cur-time-string returns character
     1011   :
     1012     define variable v-date as date      no-undo .
     1013     define variable v-time as integer   no-undo .
     1014     run cur-time in this-procedure
     1015       (output v-date
     1016       ,output v-time
     1017       ) .
     1018     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1019   end.
     1020   function cur-time-string-sec returns character
     1021   :
     1022     define variable v-date as date      no-undo .
     1023     define variable v-time as integer   no-undo .
     1024     run cur-time in this-procedure
     1025       (output v-date
     1026       ,output v-time
     1027       ) .
     1028     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1029   end.
     1030   function cur-time-custom  returns character
     1031   (input p-prefix as character
     1032   ,input p-date-format as character
     1033   ,input p-delimiter as character
     1034   ,input p-time-format as character
     1035   ,input p-suffix as character
     1036   )
     1037   :
     1038     define variable v-date as date      no-undo .
     1039     define variable v-time as integer   no-undo .
     1040     run cur-time in this-procedure
     1041       (output v-date
     1042       ,output v-time
     1043       ) .
     1044     return
     1045       p-prefix
     1046       + string(v-date, p-date-format)
     1047       + p-delimiter
     1048       + string(v-time, p-time-format)
     1049       + p-suffix
     1050       .
     1051   end.
     1052   function cur-time-print  returns character
     1053   :
     1054     define variable v-date as date      no-undo .
     1055     define variable v-time as integer   no-undo .
     1056     run cur-time in this-procedure
     1057       (output v-date
     1058       ,output v-time
     1059       ) .
     1060     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1061   end.
     1062   function cur-time-datetime returns datetime
     1063   :
     1064     define variable v-char as character no-undo .
     1065     define variable v-datetime as datetime no-undo .
     1066     v-char = cur-time-string().
     1067     v-datetime = datetime(v-char).
     1068     return  v-datetime.
     1069   end.
     1070   function cur-time-string-msec returns character
     1071   :
     1072     define variable v-date as datetime  no-undo .
     1073     v-date = now.
     1074     return string(v-date) .
     1075   end.
     1076   define variable vss-include-info7 as character format "X(65)" no-undo
     1077   initial "@(#)$Workfile$ $Revision$".
     1078   procedure xmlchar-test :
     1079   define input parameter p-in-string          as character        no-undo.
     1080   define output parameter p-out-string-enc    as character        no-undo.
     1081   define output parameter p-out-string-dec    as character        no-undo.
     1082   do
     1083   on error undo, return error
     1084   :
     1085          run xmlchar-encode in this-procedure
     1086       (
     1087             input p-in-string
     1088           , output p-out-string-enc
     1089       ).
     1090          run xmlchar-decode in this-procedure
     1091       (
     1092             input p-out-string-enc
     1093           , output p-out-string-dec
     1094       ).
     1095   end.
     1096   end .
     1097   procedure xmlchar-encode :
     1098   define input parameter p-in-string      as character        no-undo.
     1099   define output parameter p-out-string    as character        no-undo.
     1100       define variable v-position      as integer      no-undo.
     1101       define variable v-current-char  as character    no-undo.
     1102   do
     1103   on error undo, return error
     1104   :
     1105       assign
     1106           p-out-string = "":U
     1107       .
     1108       case p-in-string
     1109       :
     1110           when ?
     1111           then do:
     1112               assign
     1113                   p-out-string = "?":U
     1114               .
     1115           end.
     1116           when "?":U
     1117           then do:
     1118               assign
     1119                   p-out-string = "&#63;":U
     1120               .
     1121           end.
     1122           otherwise do:
     1123               do v-position = 1 to length( p-in-string )
     1124               :
     1125                   assign
     1126                       v-current-char = substring( p-in-string, v-position, 1 )
     1127                   .
     1128                   case v-current-char
     1129                   :
     1130                       when "&":U
     1131                       then do:
     1132                           assign
     1133                               p-out-string = p-out-string + "&amp;":U
     1134                           .
     1135                       end.
     1136                       when ">":U
     1137                       then do:
     1138                           assign
     1139                               p-out-string = p-out-string + "&gt;":U
     1140                           .
     1141                       end.
     1142                       when "<":U
     1143                       then do:
     1144                           assign
     1145                               p-out-string = p-out-string + "&lt;":U
     1146                           .
     1147                       end.
     1148                       when "'":U
     1149                       then do:
     1150                           assign
     1151                               p-out-string = p-out-string + "&apos;":U
     1152                           .
     1153                       end.
     1154                       when '"':U
     1155                       then do:
     1156                           assign
     1157                               p-out-string = p-out-string + "&quot;":U
     1158                           .
     1159                       end.
     1160                       when chr(1)
     1161                       then do:
     1162                           assign
     1163                               p-out-string = p-out-string + "":U
     1164                           .
     1165                       end.
     1166                       when chr(2)
     1167                       then do:
     1168                           assign
     1169                               p-out-string = p-out-string + "":U
     1170                           .
     1171                       end.
     1172                       when chr(3)
     1173                       then do:
     1174                           assign
     1175                               p-out-string = p-out-string + "":U
     1176                           .
     1177                       end.
     1178                       when chr(4)
     1179                       then do:
     1180                           assign
     1181                               p-out-string = p-out-string + "":U
     1182                           .
     1183                       end.
     1184                       when chr(5)
     1185                       then do:
     1186                           assign
     1187                               p-out-string = p-out-string + "":U
     1188                           .
     1189                       end.
     1190                       when chr(6)
     1191                       then do:
     1192                           assign
     1193                               p-out-string = p-out-string + "":U
     1194                           .
     1195                       end.
     1196                       when chr(7)
     1197                       then do:
     1198                           assign
     1199                               p-out-string = p-out-string + "":U
     1200                           .
     1201                       end.
     1202                       when chr(8)
     1203                       then do:
     1204                           assign
     1205                               p-out-string = p-out-string + "":U
     1206                           .
     1207                       end.
     1208                       when chr(9)
     1209                       then do:
     1210                           assign
     1211                               p-out-string = p-out-string + "":U
     1212                           .
     1213                       end.
     1214                       when chr(29)
     1215                       then do:
     1216                           assign
     1217                               p-out-string = p-out-string + "":U
     1218                           .
     1219                       end.
     1220                       when chr(10)
     1221                       then do:
     1222                           assign
     1223                               p-out-string = p-out-string + "&#10;":U
     1224                           .
     1225                       end.
     1226                       when chr(13)
     1227                       then do:
     1228                           assign
     1229                               p-out-string = p-out-string + "&#13;":U
     1230                           .
     1231                       end.
     1232                       otherwise do:
     1233                           assign
     1234                               p-out-string = p-out-string + v-current-char
     1235                           .
     1236                       end.
     1237                   end case.
     1238               end.
     1239           end.
     1240       end case.
     1241   end.
     1242   end .
     1243   procedure xmlchar-encode-1c :
     1244   define input parameter p-in-string      as character        no-undo.
     1245   define output parameter p-out-string    as character        no-undo.
     1246       define variable v-position      as integer      no-undo.
     1247       define variable v-current-char  as character    no-undo.
     1248   do
     1249   on error undo, return error
     1250   :
     1251       assign
     1252           p-out-string = "":U
     1253       .
     1254       case p-in-string
     1255       :
     1256           when ?
     1257           then do:
     1258               assign
     1259                   p-out-string = "?":U
     1260               .
     1261           end.
     1262           otherwise do:
     1263               do v-position = 1 to length( p-in-string )
     1264               :
     1265                   assign
     1266                       v-current-char = substring( p-in-string, v-position, 1 )
     1267                   .
     1268                   case v-current-char
     1269                   :
     1270                       when chr(1)
     1271                       then do:
     1272                           assign
     1273                               p-out-string = p-out-string + " ":U
     1274                           .
     1275                       end.
     1276                       when chr(2)
     1277                       then do:
     1278                           assign
     1279                               p-out-string = p-out-string + " ":U
     1280                           .
     1281                       end.
     1282                       when chr(3)
     1283                       then do:
     1284                           assign
     1285                               p-out-string = p-out-string + " ":U
     1286                           .
     1287                       end.
     1288                       when chr(4)
     1289                       then do:
     1290                           assign
     1291                               p-out-string = p-out-string + " ":U
     1292                           .
     1293                       end.
     1294                       when chr(5)
     1295                       then do:
     1296                           assign
     1297                               p-out-string = p-out-string + " ":U
     1298                           .
     1299                       end.
     1300                       when chr(6)
     1301                       then do:
     1302                           assign
     1303                               p-out-string = p-out-string + " ":U
     1304                           .
     1305                       end.
     1306                       when chr(7)
     1307                       then do:
     1308                           assign
     1309                               p-out-string = p-out-string + " ":U
     1310                           .
     1311                       end.
     1312                       when chr(8)
     1313                       then do:
     1314                           assign
     1315                               p-out-string = p-out-string + " ":U
     1316                           .
     1317                       end.
     1318                       when chr(9)
     1319                       then do:
     1320                           assign
     1321                               p-out-string = p-out-string + " ":U
     1322                           .
     1323                       end.
     1324                       when chr(29)
     1325                       then do:
     1326                           assign
     1327                               p-out-string = p-out-string + " ":U
     1328                           .
     1329                       end.
     1330                       when chr(10)
     1331                       then do:
     1332                           assign
     1333                               p-out-string = p-out-string + " ":U
     1334                           .
     1335                       end.
     1336                       when chr(13)
     1337                       then do:
     1338                           assign
     1339                               p-out-string = p-out-string + " ":U
     1340                           .
     1341                       end.
     1342                       otherwise do:
     1343                           assign
     1344                               p-out-string = p-out-string + v-current-char
     1345                           .
     1346                       end.
     1347                   end case.
     1348               end.
     1349           end.
     1350       end case.
     1351   end.
     1352   end .
     1353   procedure xmlchar-decode :
     1354   define input parameter p-in-string      as character        no-undo.
     1355   define output parameter p-out-string    as character        no-undo.
     1356       define variable v-position      as integer      no-undo.
     1357       define variable v-last-position as integer      no-undo.
     1358       define variable v-temp-integer  as integer      no-undo.
     1359       define variable v-current-char  as character    no-undo.
     1360       define variable v-next-char     as character    no-undo.
     1361       define variable v-success       as logical      no-undo.
     1362   do
     1363   on error undo, return error
     1364   :
     1365       assign
     1366           p-out-string = "":U
     1367           v-position   = 0
     1368       .
     1369       replace-cycle:
     1370       do while yes
     1371       on error undo, return error
     1372       :
     1373           assign
     1374               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1375           .
     1376           if v-last-position <= v-position
     1377           then do:
     1378               if v-position = 0
     1379               then do:
     1380                   assign
     1381                       p-out-string = p-in-string
     1382                   .
     1383               end.
     1384               else do:
     1385                   assign
     1386                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1387                   .
     1388               end.
     1389               leave replace-cycle.
     1390           end.
     1391           else do:
     1392               assign
     1393                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1394                   v-position      = v-last-position
     1395                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1396               .
     1397               if v-current-char = "#":U
     1398               then do:
     1399                   assign
     1400                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1401                   .
     1402                   if v-last-position > 0
     1403                   then do:
     1404                       run xmlchar-read-integer in this-procedure
     1405                        (
     1406                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1407                           , output v-temp-integer
     1408                           , output v-success
     1409                       ).
     1410                       if v-success = yes
     1411                       and v-temp-integer >= 1
     1412                       and v-temp-integer <= 255
     1413                       then do:
     1414                           assign
     1415                               p-out-string = p-out-string + chr( v-temp-integer )
     1416                               v-position   = v-last-position + 1
     1417                           .
     1418                       end.
     1419                       else do:
     1420                           assign
     1421                               p-out-string = p-out-string + "&":U
     1422                               v-position   = v-position   + 1
     1423                           .
     1424                       end.
     1425                   end.
     1426                   else do:
     1427                       assign
     1428                           p-out-string = p-out-string + "&":U
     1429                           v-position   = v-position   + 1
     1430                       .
     1431                   end.
     1432               end.
     1433               else do:
     1434                   case substring( p-in-string, v-position + 1, 3 )
     1435                   :
     1436                       when "lt;":U
     1437                       then do:
     1438                           assign
     1439                               p-out-string = p-out-string + "<":U
     1440                               v-position   = v-position   + 3
     1441                           .
     1442                       end.
     1443                       when "gt;":U
     1444                       then do:
     1445                           assign
     1446                               p-out-string = p-out-string + ">":U
     1447                               v-position   = v-position   + 3
     1448                           .
     1449                       end.
     1450                       otherwise do:
     1451                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1452                           then do:
     1453                               assign
     1454                                   p-out-string = p-out-string + "&":U
     1455                                   v-position   = v-position   + 4
     1456                               .
     1457                           end.
     1458                           else do:
     1459                               case substring( p-in-string, v-position + 1, 5 )
     1460                               :
     1461                                   when "quot;":U
     1462                                   then do:
     1463                                       assign
     1464                                           p-out-string = p-out-string + '"':U
     1465                                           v-position   = v-position   + 5
     1466                                       .
     1467                                   end.
     1468                                   when "apos;":U
     1469                                   then do:
     1470                                       assign
     1471                                           p-out-string = p-out-string + "'":U
     1472                                           v-position   = v-position   + 5
     1473                                       .
     1474                                   end.
     1475                                   otherwise do:
     1476                                       assign
     1477                                           p-out-string = p-out-string + "&":U
     1478                                       .
     1479                                   end.
     1480                               end case.
     1481                           end.
     1482                       end.
     1483                   end case.
     1484               end.
     1485           end.
     1486       end.
     1487   end.
     1488   end .
     1489   procedure xmlchar-read-integer :
     1490   define input parameter p-input-string      as character        no-undo.
     1491   define output parameter p-output-integer   as integer          no-undo.
     1492   define output parameter p-success       as logical          no-undo.
     1493   do
     1494   on error undo, return error
     1495   :
     1496       assign
     1497           p-output-integer = integer( p-input-string )
     1498       no-error.
     1499       if error-status :error
     1500       then do:
     1501           assign
     1502               p-success           = no
     1503               p-output-integer    = 0
     1504           .
     1505       end.
     1506       else do:
     1507           assign
     1508               p-success           = yes
     1509           .
     1510       end.
     1511   end.
     1512   end.
     1513   define variable v-bgelib-bgeclall           as logical      no-undo.
     1514   define variable v-bgelib-bgedict            as logical      no-undo.
     1515   define temp-table temp_ext-doc-type no-undo
     1516       field edt-key               as integer
     1517       field ext-doc-type          as character
     1518       field ext-doc-type-label    as character
     1519       index pi is primary unique
     1520           edt-key
     1521   .
     1522   define temp-table temp_bgelib_goods no-undo
     1523       field gds-code as integer
     1524       index pi is primary unique
     1525           gds-code
     1526   .
     1527   define temp-table temp_bgelib_clients no-undo
     1528       field obj-type as character
     1529       field obj-code as integer
     1530       index pi is primary unique
     1531           obj-type
     1532           obj-code
     1533   .
     1534   define temp-table temp_bgelib_dis-card no-undo
     1535       field d-card as character
     1536       index pi is primary unique
     1537           d-card
     1538   .
     1539   define temp-table temp_bgelib_trn-doc no-undo
     1540       field doc-code as integer
     1541   .
     1542   procedure bgelib-tag-open:
     1543   do
     1544   on error undo, return error
     1545   :
     1546   define input parameter v-tag-level  as integer      no-undo.
     1547   define input parameter v-tag-name   as character    no-undo.
     1548   define input parameter v-tag-value  as character    no-undo.
     1549       put stream stmXMLOut unformatted
     1550           chr(10)
     1551           + fill(" ", 4 * v-tag-level)
     1552           + "<" + v-tag-name
     1553           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1554           + v-tag-value + ">"
     1555       .
     1556   end.
     1557   end procedure.
     1558   procedure bgelib-tag-put:
     1559   do
     1560   on error undo, return error
     1561   :
     1562   define input parameter v-tag-level      as integer      no-undo.
     1563   define input parameter v-tag-name       as character    no-undo.
     1564   define input parameter v-tag-value      as character    no-undo.
     1565   define input parameter v-empty-mode     as integer      no-undo.
     1566       v-tag-name = trim(v-tag-name).
     1567       if  v-empty-mode = 1
     1568       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1569       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1570       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1571       then do:
     1572           run xmlchar-encode in this-procedure (
     1573                 input v-tag-value
     1574               , output v-tag-value
     1575           ).
     1576           put stream stmXMLOut unformatted
     1577               chr(10) + fill(" ", 4 * v-tag-level)
     1578                           + '<' + v-tag-name + '>'
     1579                           + v-tag-value
     1580                           + '</' + v-tag-name + '>'
     1581           .
     1582       end.
     1583   end.
     1584   end procedure.
     1585   procedure bgelib-tag-close:
     1586   do
     1587   on error undo, return error
     1588   :
     1589   define input parameter v-tag-level as integer      no-undo.
     1590   define input parameter v-tag-name  as character    no-undo.
     1591       put stream stmXMLOut unformatted
     1592           chr(10)
     1593           + fill( " ", 4 * v-tag-level)
     1594           + '</' + v-tag-name + '>'
     1595       .
     1596   end.
     1597   end procedure.
     1598   procedure bgelib-write-log:
     1599   do
     1600   on error undo, return error
     1601   :
     1602   define input parameter v-filename   as character    no-undo.
     1603   define input parameter v-log-level  as integer      no-undo.
     1604   define input parameter v-out-string as character    no-undo.
     1605       output stream stmXMLLog to value( v-filename ) append.
     1606       put stream stmXMLLog unformatted
     1607           chr(10)
     1608       .
     1609       put stream stmXMLLog unformatted
     1610           ( if v-log-level = 0
     1611             or v-out-string = "&DLine"
     1612             or v-out-string = "&Line"
     1613             then ""
     1614             else cur-time-string-sec() + " " )
     1615       .
     1616       put stream stmXMLLog unformatted
     1617           ( if v-out-string = "&Line"
     1618             then fill( "-", 80 )
     1619             else if v-out-string = "&DLine"
     1620                  then fill( "=", 80 )
     1621                  else v-out-string )
     1622       .
     1623       output stream stmXMLLog close.
     1624   end.
     1625   end procedure.
     1626   procedure bgelib-write-edt:
     1627   do
     1628   on error undo, return error
     1629   :
     1630   define input parameter v-editor-handle    as handle       no-undo.
     1631   define input parameter v-log-level        as integer      no-undo.
     1632   define input parameter v-out-string       as character    no-undo.
     1633       if valid-handle ( v-editor-handle )
     1634       then do:
     1635           v-editor-handle :move-to-eof().
     1636           v-editor-handle :insert-string( ( if v-log-level = 0
     1637                                             or v-out-string = "&DLine"
     1638                                             or v-out-string = "&Line"
     1639                                             then ""
     1640                                             else cur-time-string-sec() + " "
     1641                                         ) ).
     1642           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1643                                             then fill( "-", 80 )
     1644                                             else if v-out-string = "&DLine" then fill("=", 80)
     1645                                             else fill( " ", v-log-level) + v-out-string
     1646                                         ) ).
     1647           v-editor-handle :insert-string( chr(10) ).
     1648       end.
     1649       process events.
     1650       output to 'bgescn.txt' append.
     1651           put unformatted
     1652               chr(10)
     1653               string( ( if v-log-level = 0
     1654                         or v-out-string = "&DLine"
     1655                         or v-out-string = "&Line"
     1656                         then ""
     1657                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1658                     ) )
     1659               string( ( if v-out-string = "&Line"
     1660                         then fill( "-", 80 )
     1661                         else if v-out-string = "&DLine"
     1662                              then fill( "=", 80 )
     1663                              else fill( " ", v-log-level ) + v-out-string
     1664                     ) )
     1665           .
     1666       output close.
     1667   end.
     1668   end procedure.
     1669   procedure bgelib-show-cnt:
     1670   do
     1671   on error undo, return error
     1672   :
     1673   define input parameter v-fillin-handle     as handle   no-undo.
     1674       if valid-handle( v-fillin-handle )
     1675       then do:
     1676           assign
     1677               v-fillin-handle :visible = true
     1678           .
     1679       end.
     1680   end.
     1681   end procedure.
     1682   procedure bgelib-hide-cnt:
     1683   do
     1684   on error undo, return error
     1685   :
     1686   define input parameter v-fillin-handle     as handle   no-undo.
     1687       if valid-handle( v-fillin-handle )
     1688       then do:
     1689           assign v-fillin-handle :visible = false.
     1690       end.
     1691   end.
     1692   end procedure.
     1693   procedure bgelib-write-cnt:
     1694   do
     1695   on error undo, return error
     1696   :
     1697   define input parameter v-fillin-handle    as handle       no-undo.
     1698   define input parameter v-fillin-string    as character    no-undo.
     1699       if valid-handle( v-fillin-handle )
     1700       then do:
     1701           assign
     1702               v-fillin-handle :SCREEN-value = v-fillin-string
     1703           .
     1704       end.
     1705   end.
     1706   end procedure.
     1707   procedure bgelib-write-header:
     1708   do
     1709   on error undo, return error
     1710   :
     1711   define input parameter p-first-file     as logical      no-undo.
     1712   define input parameter p-xml-file-name  as character    no-undo.
     1713   define input parameter p-list-file-name as character    no-undo.
     1714   define input parameter p-file-number    as integer      no-undo.
     1715   define input parameter p-have-prev      as logical      no-undo.
     1716   define input parameter p-prev-filename  as character    no-undo.
     1717   define input parameter p-obj-list       as character    no-undo.
     1718   define input parameter p-doc-type-list  as character    no-undo.
     1719   define input parameter p-parameter-list as character    no-undo.
     1720       define variable v-counter    as integer        no-undo.
     1721       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1722       put stream stmXMLOut unformatted
     1723           "<?xml version='1.0' encoding='windows-1251'?>"
     1724       .
     1725       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1726       run bgelib-tag-open( input 0, input "header", input "" ).
     1727       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1728       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1729       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1730       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1731       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1732       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1733       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1734       :
     1735           run bgelib-tag-put(
     1736                 input 1
     1737               , input entry( 2 * v-counter, p-parameter-list )
     1738               , input entry( 2 * v-counter + 1, p-parameter-list )
     1739               , input 0
     1740           ).
     1741       end.
     1742       run bgelib-tag-close( input 0, input "header" ).
     1743       output stream stmXMLOut close.
     1744       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1745       if p-first-file = yes
     1746       then do:
     1747           put stream stmXMLOut unformatted
     1748               "<?xml version='1.0' encoding='windows-1251'?>"
     1749           .
     1750           run bgelib-tag-open( input 0, input "export", input "" ).
     1751       end.
     1752       run bgelib-tag-open( input 1, input "file", input "" ).
     1753       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1754       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1755       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1756       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1757       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1758       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1759       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1760       :
     1761           run bgelib-tag-put(
     1762                 input 2
     1763               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1764               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1765               , input 0
     1766           ).
     1767       end.
     1768       run bgelib-tag-close( input 1, input "file" ).
     1769       output stream stmXMLOut close.
     1770   end.
     1771   end procedure.
     1772   procedure bgelib-write-footer:
     1773   do
     1774   on error undo, return error
     1775   :
     1776   define input parameter p-last-file      as logical      no-undo.
     1777   define input parameter p-xml-file-name  as character    no-undo.
     1778   define input parameter p-list-file-name as character    no-undo.
     1779   define input parameter p-have-next      as logical      no-undo.
     1780   define input parameter p-next-file-name as character    no-undo.
     1781       define variable v-error-num     as integer           no-undo.
     1782       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1783       if p-have-next = yes
     1784       then do:
     1785           run bgelib-tag-open( input 0, input "footer", "" ).
     1786           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1787           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1788           run bgelib-tag-close( input 0, input "footer" ).
     1789       end.
     1790       run bgelib-tag-close( input 0, input "root" ).
     1791       output stream stmXMLOut close.
     1792       run bge/os_copy.p (
     1793             input "M"
     1794           , input p-xml-file-name + "tmp"
     1795           , input p-xml-file-name + "xml"
     1796           , output v-error-num
     1797       ).
     1798       if p-last-file = yes
     1799       then do:
     1800           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1801               run bgelib-tag-close( input 0, input "export" ).
     1802           output stream stmXMLOut close.
     1803           run bge/os_copy.p (
     1804                 input "M"
     1805               , input p-list-file-name + "tmp"
     1806               , input p-list-file-name + "xml"
     1807               , output v-error-num
     1808           ).
     1809       end.
     1810   end.
     1811   end procedure.
     1812   procedure bgelib-filename :
     1813   do
     1814   on error undo, return error
     1815   :
     1816   define input parameter p-prefix             as character    no-undo.
     1817   define output parameter p-xml-file-name     as character    no-undo.
     1818   define output parameter p-log-file-name     as character    no-undo.
     1819   define output parameter p-list-file-name    as character    no-undo.
     1820       define variable v-home-dir  as character    no-undo.
     1821       define variable v-error-num as integer      no-undo.
     1822       get-key-value section "BGE" key "outdir" value v-home-dir.
     1823       if v-home-dir = ?
     1824       then do:
     1825           message
     1826             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1827             skip(1)
     1828             skip "Обратитесь к администратору."
     1829           view-as alert-box error.
     1830           undo, return error .
     1831       end.
     1832       run gbl/dir-cre.p (
     1833           input v-home-dir
     1834       ) no-error.
     1835       if error-status :error
     1836       then do:
     1837           message
     1838             skip "Неверно задан каталог экспорта."
     1839             skip(1)
     1840             skip "Обратитесь к администратору."
     1841           view-as alert-box error.
     1842           undo, return error .
     1843       end.
     1844       run bge/genfname.p (
     1845             input v-home-dir
     1846           , input p-prefix
     1847           , input ""
     1848           , input "xml"
     1849           , input "tmp"
     1850           , output p-xml-file-name
     1851       ).
     1852       assign
     1853           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1854           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1855           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1856       .
     1857   end.
     1858   end procedure.
     1859   procedure bgelib-read-config :
     1860   do
     1861   on error undo, return error
     1862   :
     1863   define variable v-par-type as character     no-undo.
     1864     define variable v-param-type      as character  no-undo .
     1865     define variable v-value-character as character  no-undo .
     1866     define variable v-value-date      as date       no-undo .
     1867     define variable v-value-decimal   as decimal    no-undo .
     1868     define variable v-value-integer   as integer    no-undo .
     1869     define variable v-value-logical   as logical    no-undo .
     1870     define variable v-tth             as handle     no-undo .
     1871       assign
     1872           v-bgelib-bgeclall = no
     1873           v-bgelib-bgedict  = no
     1874       .
     1875       run adm/shattri.p ( input "get":U
     1876                         , input  '':u
     1877                         , input  0
     1878                         , input  'bge-export':U
     1879                         , input  'bgeclall':U
     1880                         , output v-value-character
     1881                         , output v-value-date
     1882                         , output v-value-decimal
     1883                         , output v-value-integer
     1884                         , output v-value-logical
     1885                         , output v-param-type
     1886                         , input-output table-handle v-tth
     1887                         ) no-error .
     1888       if error-status :error
     1889       then do:
     1890         assign
     1891           v-bgelib-bgeclall = no
     1892         .
     1893       end.
     1894       else do:
     1895         assign
     1896           v-bgelib-bgeclall = v-value-logical
     1897         .
     1898       end.
     1899       delete object v-tth.
     1900       run adm/shattri.p ( input "get":U
     1901                         , input  '':u
     1902                         , input  0
     1903                         , input  'bge-export':U
     1904                         , input  'bgedict':U
     1905                         , output v-value-character
     1906                         , output v-value-date
     1907                         , output v-value-decimal
     1908                         , output v-value-integer
     1909                         , output v-value-logical
     1910                         , output v-param-type
     1911                         , input-output table-handle v-tth
     1912                         ) no-error .
     1913       if error-status :error
     1914       then do:
     1915         assign
     1916           v-bgelib-bgedict = no
     1917         .
     1918       end.
     1919       else do:
     1920         assign
     1921           v-bgelib-bgedict = v-value-logical
     1922         .
     1923       end.
     1924       delete object v-tth.
     1925       run adm/shattri.p ( input "get":U
     1926                         , input  '':u
     1927                         , input  0
     1928                         , input  'bge-export':U
     1929                         , input  'bgefmt':U
     1930                         , output v-value-character
     1931                         , output v-value-date
     1932                         , output v-value-decimal
     1933                         , output v-value-integer
     1934                         , output v-value-logical
     1935                         , output v-param-type
     1936                         , input-output table-handle v-tth
     1937                         ) no-error .
     1938       if error-status :error
     1939       then do:
     1940         assign
     1941           v-bgelib-bgefmt  = "xml":U
     1942         .
     1943       end.
     1944       else do:
     1945         assign
     1946           v-bgelib-bgefmt  = v-value-character
     1947         .
     1948       end.
     1949       delete object v-tth.
     1950       run adm/shattri.p ( input "get":U
     1951                         , input  '':u
     1952                         , input  0
     1953                         , input  'bge-export':U
     1954                         , input  'bgeflold':U
     1955                         , output v-value-character
     1956                         , output v-value-date
     1957                         , output v-value-decimal
     1958                         , output v-value-integer
     1959                         , output v-value-logical
     1960                         , output v-param-type
     1961                         , input-output table-handle v-tth
     1962                         ) no-error .
     1963       if error-status :error
     1964       then do:
     1965         assign
     1966           v-bgelib-bgeflold  = "old":U
     1967         .
     1968       end.
     1969       else do:
     1970         assign
     1971           v-bgelib-bgeflold  = v-value-character
     1972         .
     1973       end.
     1974       delete object v-tth.
     1975   end.
     1976   end procedure.
     1977   procedure bgelib-check-file-size :
     1978   do
     1979   on error undo, return error
     1980   :
     1981   define input parameter p-out-filename   as character    no-undo.
     1982   define output parameter p-is-big        as logical      no-undo.
     1983       define variable v-current-position    as integer        no-undo.
     1984       assign
     1985           v-current-position = seek( stmXMLOut )
     1986       .
     1987       if v-current-position / 1024 / 1024  >= 100
     1988       then do:
     1989           assign
     1990               p-is-big = yes
     1991           .
     1992       end.
     1993   end.
     1994   end procedure.
     1995   procedure bgelib-init-ext-doc-type :
     1996       define variable v-counter    as integer      no-undo.
     1997       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1998   do
     1999   for buf_temp_ext-doc-type
     2000   on error undo, return error
     2001   :
     2002       empty temp-table buf_temp_ext-doc-type.
     2003       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2004       :
     2005           create buf_temp_ext-doc-type.
     2006           assign
     2007               buf_temp_ext-doc-type.edt-key               = v-counter
     2008               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2009               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2010           .
     2011       end.
     2012   end.
     2013   end procedure.
     2014   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   define variable v-xml-file-name     as character            no-undo.
     2016   define variable v-xml-file-name-path as character            no-undo.
     2017   define variable v-log-file-name     as character            no-undo.
     2018   define variable v-locked            as logical              no-undo.
     2019   define variable v-log-string        as character            no-undo.
     2020   define variable v-oper-num          as integer              no-undo.
     2021   define variable v-obj-list          as character            no-undo.
     2022   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2023   DEF VAR intRep      AS INT NO-UNDO.
     2024   define variable hEDT             AS HANDLE NO-UNDO.
     2025   define variable hCNT             AS HANDLE NO-UNDO.
     2026   procedure xml-cd-write-header:
     2027   do
     2028   on error undo, return error
     2029   :
     2030   define input parameter p-xml-file-name       as character    no-undo.
     2031   define input parameter p-xml-file-name-path  as character    no-undo.
     2032   define input parameter p-doc-name            as character    no-undo.
     2033   define input parameter p-version             as character    no-undo.
     2034   define input parameter p-obj-list            as character    no-undo.
     2035   define input parameter p-correspondent       as character    no-undo .
     2036   define input parameter p-write-header        as logical      no-undo .
     2037   define variable OS-time as character no-undo .
     2038   define variable id as character no-undo .
     2039   define buffer buf_db for ub.db.
     2040   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2041   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2042   assign
     2043   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2044   .
     2045   run bgelib-tag-open in this-procedure (
     2046                                        1
     2047                                       ,p-doc-name
     2048                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2049                                         ).
     2050   if p-write-header then do:
     2051     run bgelib-tag-open(2, "Header","").
     2052     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2053     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2054     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2055     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2056     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2057     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2058     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2059     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2060     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2061     run bgelib-tag-close( 2, "Header" ).
     2062   end.
     2063   output stream stmXMLOut close.
     2064   end.
     2065   end procedure.
     2066   procedure xml-cd-write-footer:
     2067   do
     2068   on error undo, return error
     2069   :
     2070   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2071   define input parameter p-xml-file-name as character    no-undo.
     2072   define input parameter p-doc-name      as character    no-undo .
     2073   define variable v-error-num     as integer           no-undo.
     2074   define variable v-md5-signature as character no-undo .
     2075   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2076   run bgelib-tag-close( 0, p-doc-name ).
     2077   put stream stmXMLOut unformatted skip.
     2078   output stream stmXMLOut close.
     2079   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2080   if v-error-num > 0
     2081   then do:
     2082      return error.
     2083   end.
     2084   if opsys = "unix"
     2085   then do:
     2086       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2087   end.
     2088   end.
     2089   end procedure.
     2090   procedure xml-cd-filename :
     2091   do
     2092   on error undo, return error
     2093   :
     2094   define input parameter  p-out               as character no-undo .
     2095   define output parameter p-xml-file-name     as character    no-undo.
     2096   define output parameter p-xml-file-name-path   as character    no-undo.
     2097   define output parameter p-log-file-name     as character    no-undo.
     2098   define output parameter p-locked            as logical      no-undo.
     2099   define variable v-out as character     no-undo.
     2100   define variable loc#log as logical no-undo .
     2101   define variable BadFlag as logical no-undo .
     2102   define variable fq as integer no-undo .
     2103   define variable v-remote as character no-undo .
     2104   assign
     2105   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2106   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2107   p-log-file-name = p-out + "actions.log"
     2108   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2109   .
     2110   end.
     2111   end procedure.
     2112   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2113   define variable v-date-str as character no-undo .
     2114   assign
     2115   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2116                string(Month(p-date), "99":U) + "-":U +
     2117                string(DAY(p-date), "99":U).
     2118   return v-date-str.
     2119   END FUNCTION.
     2120   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2121   define variable v-date-str as character no-undo .
     2122   assign
     2123   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2124                string(Month(p-date), "99":U) + "-":U +
     2125                string(DAY(p-date), "99":U) + chr(32) +
     2126                string(p-time, "HH:MM:SS").
     2127   return v-date-str.
     2128   END FUNCTION.
     2129   function string-to-date returns date ( input p-string  as character):
     2130     define variable v-date as date no-undo .
     2131     assign
     2132     v-date = date(integer(substring(p-string, 4, 2))
     2133                   ,integer(substring(p-string, 1, 2))
     2134                   ,integer(substring(p-string, 7, 4))
     2135                  ) no-error .
     2136     if error-status:error then return ?.
     2137     return v-date.
     2138   END FUNCTION.
     2139   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2140   define variable v-time as integer no-undo init ?.
     2141   define variable v-dop1 as character no-undo .
     2142   define variable v-dop2 as character no-undo .
     2143   assign
     2144   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2145   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2146   no-error .
     2147   if error-status:error then return ?.
     2148   assign
     2149   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2150             integer(entry(2, v-dop2, ";":U)) * 60 +
     2151             integer(entry(3, v-dop2, ";":U)) no-error .
     2152   return v-time.
     2153   END FUNCTION.
     2154   define variable v-host-code          like ub.sysconf.host-code no-undo .
     2155   define variable v-cp-is-use          as logical   no-undo .
     2156   FIND FIRST ub.cash-desk NO-LOCK WHERE
     2157              ub.cash-desk.db-num = g#db-num AND
     2158              (ub.cash-desk.pos-type = 'IBM':U
     2159               AND
     2160               ub.cash-desk.obj-code = i-obj-code)
     2161              OR
     2162              (ub.cash-desk.pos-type = 'IBM-XML':U
     2163              AND
     2164              ub.cash-desk.obj-code = i-obj-code)
     2165               No-error.
     2166   IF not avail(cash-desk) then do:
     2167     run write-log-and-file in p-log-handle (
     2168           input 1
     2169         , input log-file-name
     2170         , input 1
     2171         , input substitute( "!!!&1 справочника ОСС реализуется только для касс &2 &3 "
     2172                             , (if action begins "U" then "Передача" else "Удаление")
     2173                             , 'IBM':U
     2174                             , 'IBM-XML':U
     2175                           )
     2176                                           ).
     2177     return.
     2178   end.
     2179   if action = "D" then
     2180   do:
     2181     message
     2182       "Вы действительно хотите удалить с кассы записи справочника платежных агентов/операторов?"
     2183       view-as alert-box QUESTION buttons YES-NO update glog.
     2184     if not glog then return.
     2185   end.
     2186   if action = "DD" then action = "D" .
     2187   if action = "UU" then action = "U" .
     2188   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2189   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2190   procedure putc-oss :
     2191   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
