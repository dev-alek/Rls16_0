     2482                               ,v-dir-remote
     2483                               ,for-cash-desk.cash-num
     2484                               ,chr(10)
     2485                               )
     2486                                               ).
     2487         NEXT.
     2488       end.
     2489   end.
     2490   output stream IBMStream
     2491   to value( (if for-cash-desk.remote = 1
     2492               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2493               else out) + fname + '.dat' ) convert target "ibm866".
     2494   OS2-time =       ( if Cash-OS2 then
     2495                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2496                         else "" )
     2497   .
     2498     end.
     2499   END CASE.
     2500     RUN putc-oss in this-procedure
