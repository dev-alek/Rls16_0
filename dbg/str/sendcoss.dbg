     2806                               ,chr(10)
     2807                               )
     2808                                               ).
     2809         NEXT.
     2810       end.
     2811   end.
     2812   output stream IBMStream
     2813   to value( (if for-cash-desk.remote = 1
     2814               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2815               else out) + fname + '.dat' ) convert target "ibm866".
     2816   OS2-time =       ( if Cash-OS2 then
