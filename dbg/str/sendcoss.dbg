        1   block-level on error undo, throw.
        2   using ibs.th.ref.bpa.*.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle  as widget-handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter i-obj-code like ub.shop.obj-code no-undo.
        7   DEFINE INPUT PARAMETER action as char no-undo.
        8   DEFINE INPUT PARAMETER selective as integer no-undo.
        9   define input parameter pSubs as character no-undo .
       10   define input parameter p-log-file-name as character no-undo .
       11   define input-output parameter p-view-log as logical no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: 848c16a0bcdd, 3040, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       14   define variable vss-date        as character no-undo init "$Date: Чт май 12 16:29:48 2022 +0300 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: sendcoss.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: str/sendcoss.p $":U .
