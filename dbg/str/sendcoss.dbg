     2325   if pSubs = "" then do:
     2326   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2327   PROCEDURE   for-cash-cycle:
     2328   DEFINE VARIABLE fname-list as character no-undo .
     2329   DEFINE VARIABLE out-list as character no-undo .
     2330   DEFINE VARIABLE var-file-num as integer no-undo .
     2331   DEFINE VARIABLE v-dir-remote as character no-undo .
     2332   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2333   define variable v-plu as character no-undo .
     2334   define variable ss  as character no-undo .
     2335   define variable ss0  as character no-undo .
     2336   define variable v-temp-kat-file as character no-undo .
     2337   define variable v-kat-file as character no-undo .
     2338   define variable v-kat-file-save as character no-undo .
     2339   define variable v-updated-subject-dis-kat as logical no-undo .
     2340   define variable v-next as logical no-undo .
     2341   define variable v-cd-subject-code as character no-undo .
     2342   define variable v-cd-disc-string as character no-undo .
     2343   define variable v-versiond as decimal no-undo .
     2344   define buffer for-cash-desk for ub.cash-desk.
     2345   _for:
     2346   FOR EACH for-cash-desk NO-LOCK WHERE
     2347           for-cash-desk.db-num = g#db-num AND
     2348           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2349           for-cash-desk.obj-code = i-obj-code AND
     2350           for-cash-desk.cash-on  = yes
     2351       BREAK
     2352       BY for-cash-desk.db-num
     2353       BY for-cash-desk.obj-code
     2354       BY for-cash-desk.pos-type
     2355       BY for-cash-desk.cash-on
     2356       :
     2357     if LOOKUP(ub.cash-desk.pos-type,
     2358               ('NCR-GM':U + chr(44) +
     2359                'IBM-XML':U + chr(44) +
     2360                'MAGIA-XML':U + chr(44) +
     2361                'NCR-AS@R':U + chr(44)
     2362                  )) > 0
     2363     and for-cash-desk.autonomy = integer('1':U) then NEXT.
     2364     assign
     2365     v-versiond = decimal(for-cash-desk.version)
     2366     no-error .
     2367     if error-status:error
     2368     or v-versiond < 1.11
     2369     or for-cash-desk.pos-type <> 'IBM-XML':U
     2370     then do:
     2371       run write-log-and-file in p-log-handle (
     2372             input 1
     2373           , input log-file-name
     2374           , input 1
     2375           , input substitute( "Невозможно передать на кассу &1 &2&3&4" +
     2376                               "Данный функционал доступен только для POS &5 с версии ПО кассы 1.11 или POS &6"
     2377                             ,  for-cash-desk.cash-num
     2378                             , 'маг':U
     2379                             , for-cash-desk.obj-code
     2380                             , chr(10)
     2381                             , 'IBM':U
     2382                             , 'IBM-XML':U
     2383                             )
     2384                                             ).
     2385        next _for.
     2386     end.
     2387     run write-log-and-file in p-log-handle (
     2388           input 1
     2389         , input log-file-name
     2390         , input 1
     2391         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2392                           )
     2393                                           ).
     2394     if pSubs = "" or action = 'D' then do:
     2395   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396   case for-cash-desk.pos-type:
     2397       when 'IBM-XML':U or when 'Autotank':U
     2398     then do:
     2399   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400   run xml-cd-filename in this-procedure (
     2401         input out
     2402       , output v-xml-file-name
     2403       , output v-xml-file-name-path
     2404       , output v-log-file-name
     2405       , output v-locked
     2406   ).
     2407   run write-log-and-file in p-log-handle (
     2408         input 1
     2409       , input log-file-name
     2410       , input 1
     2411       , input substitute( ("'Удаление справочника ОСС '" + " &1")
     2412                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2413                         )
     2414                                         ).
     2415   run write-log-and-file in p-log-handle (
     2416         input 1
     2417       , input log-file-name
     2418       , input 1
     2419       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2420                                         ).
     2421   assign
     2422   v-obj-list = 'маг':U + string(i-obj-code)
     2423   .
     2424   run xml-cd-write-header in this-procedure (
     2425         input v-xml-file-name
     2426       , input v-xml-file-name-path
     2427       , input 'data'
     2428       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2429       , input v-obj-list
     2430       , input (
     2431                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2432                   then (if for-cash-desk.autonomy = integer('0':U)
     2433                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2434                         else ("КМ"   )
     2435                         )
     2436                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2437                   )
     2438               )
     2439       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2440   ).
     2441   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2442   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2443     end.
     2444     when 'IBM':U
     2445     then do:
     2446   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   if for-cash-desk.cash-os = ""
     2448   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2449   then NEXT.
     2450   assign
     2451   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     2452               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2453   Cash-DOS = NOT CASH-OS2
     2454   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     2455   v-dir-remote-tmp = v-remote + "tmp":U
     2456   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     2457   .
     2458   if for-cash-desk.remote = 1 then do:
     2459     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     2460       if error-status:error then do:
     2461         run write-log-and-file in p-log-handle (
     2462               input 1
     2463             , input log-file-name
     2464             , input 1
     2465             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2466                               "и/или попытка его создания не удалась"
     2467                               ,v-dir-remote-tmp
     2468                               ,for-cash-desk.cash-num
     2469                               ,chr(10)
     2470                               )
     2471                                               ).
     2472         NEXT.
     2473     end.
     2474     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     2475       if error-status:error then do:
     2476         run write-log-and-file in p-log-handle (
     2477               input 1
