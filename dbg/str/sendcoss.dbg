     2638               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2639               else out) + fname + '.ad0' ) convert target "ibm866".
     2640   put stream IBMStream ' ' skip(1).
     2641    put stream IBMStream unformatted '  ' for-cash-desk.addr-path ' plu' skip.
     2642   output stream IBMStream close.
     2643   OS-RENAME
     2644   VALUE((if for-cash-desk.remote = 1
     2645           then (v-dir-remote-tmp + chr(47) + "fl":U)
     2646           else out) + fname + '.ad0')
     2647   VALUE((if for-cash-desk.remote = 1
     2648           then (v-dir-remote + chr(47) + "fl":U)
     2649           else out) + fname + '.adr').
     2650   os-er = OS-ERROR.
     2651   run write-log-and-file in p-log-handle (
     2652         input 1
     2653       , input log-file-name
     2654       , input 1
     2655       , input substitute( "Данные выгружены в файл &1, файл адреса &2"
     2656                           , ((if for-cash-desk.remote = 1
