     2543     then do:
     2544       run str/post-xml.p
     2545         (
     2546          input parparentproc
     2547         ,input p-parent-handle
     2548         ,input p-log-handle
     2549         ,input g#news or g#esys
     2550         ,input g#auto
     2551         ,input 'send'
     2552         ,input log-file-name
     2553         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2554         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2555         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2556         ,input 30
     2557         ,input   ( if action = 'U'
     2558                     then ('Ждите - ' + 'добавление/изменение справочника ОСС ')
     2559                     else ('Ждите - ' + 'удаление справочника ОСС ') ) +
     2560                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2561         ) no-error .
     2562       if error-status:error
     2563       or return-value = "error" then do:
     2564         run write-log-and-file in p-log-handle (
     2565               input 1
     2566             , input log-file-name
     2567             , input 1
     2568             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2569                                   ,for-cash-desk.obj-code
     2570                                   ,for-cash-desk.cash-num
     2571                                   , chr(10)
     2572                                   , error-status:get-message(1)
     2573                                   , return-value
     2574                               )
     2575                                               ).
     2576         assign
     2577         v-view-log = yes
     2578         .
     2579       end.
     2580     end.
     2581     if not available ub.shop then do:
     2582       find first ub.shop no-lock where
     2583                 ub.shop.obj-code = for-cash-desk.obj-code.
     2584     end.
     2585     if
     2586     not (g#news or g#esys)
     2587     then do:
     2588       run str/getxibmf.p (
     2589                       input parparentproc
     2590                     ,input p-log-handle
