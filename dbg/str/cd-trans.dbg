     2950   MAIN-BLOCK:
     2951   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2952      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2953   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2954     run mainmenu_getcntxt in parparentproc
     2955       (output v-cntxt-db-num
     2956       ,output v-cntxt-userid
     2957       ,output v-cntxt-level
     2958       ,output v-cntxt-host-code-obj
