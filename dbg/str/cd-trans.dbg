     3709   PROCEDURE proc-b-sch :
     3710   assign
     3711     tbl = 'cd-trans'
     3712     join-tbl = 'X_cd-trans'
     3713     fld = ""
     3714     lab = ""
     3715     spr = ""
     3716     dim = '0'
     3717     .
     3718   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     3719   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3720   run fltfield-add in this-procedure('chk-date', '', '',
     3721   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3722   run fltfield-add in this-procedure('chk-time', '', 'time',
     3723   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3724   run fltfield-add in this-procedure('pay-desk', '', '',
     3725   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3726   run fltfield-add in this-procedure('trans-id-chr', 'Код транзакции', '',
     3727   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3728   run fltfield-add in this-procedure('out-code', 'Номер продажи', '',
     3729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3730   Filter-Block:
     3731   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3732       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3733       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3734     run gbl/filter.w ( input parparentproc
     3735                      , INPUT filter-point
     3736                      , INPUT tbl
     3737                      , INPUT join-tbl
     3738                      , INPUT fld
     3739                      , INPUT lab
     3740                      , INPUT spr
     3741                      , INPUT dim ).
     3742     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3743   END.
     3744   END PROCEDURE.
     3745   PROCEDURE proc-find-code :
     3746   define input parameter par-next as logical no-undo.
     3747   define input parameter p-trans-id-chr like ub.cd-trans.trans-id-chr no-undo.
     3748   assign
     3749   sch-date = ?
     3750   .
     3751   display
     3752   sch-date
     3753   with frame Dialog-Frame.
     3754   assign
     3755   p-trans-id-chr = chr(34) + p-trans-id-chr + chr(34).
     3756   run OpenBr in this-procedure (
     3757        input false
     3758       ,input par-next
     3759       ,input substitute("and X_cd-trans.trans-id-chr  begins &1 "
     3760         , p-trans-id-chr)
     3761       ).
     3762   apply "entry":u to sch-code in frame Dialog-Frame .
     3763   END PROCEDURE.
     3764   PROCEDURE proc-find-date :
     3765   define input parameter par-next as logical no-undo.
     3766   define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
     3767   define variable varchk-datechr as character no-undo.
     3768   display
     3769   '':U @ sch-code
     3770   with frame Dialog-Frame.
     3771   assign
     3772   varchk-datechr = string(day(parchk-date)) + chr(47) +
     3773                    string(MONTH(parchk-date)) + chr(47) +
     3774                    string(year(parchk-date)).
     3775   run OpenBr in this-procedure (
     3776      input false
     3777     ,input true
     3778     ,input substitute("and X_cd-trans.chk-date = &1 "
     3779       , varchk-datechr)
     3780     ).
     3781   apply "entry":u to sch-date in frame Dialog-Frame.
     3782   END PROCEDURE.
     3783   PROCEDURE reposition-chk-doc :
     3784   define input  parameter p-direction   as character no-undo .
     3785   define output parameter p-chk-doc-recid as recid no-undo .
     3786   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     3787     case p-direction :
     3788       when "first":U
     3789       then do:
     3790         get first br-trans.
     3791       end.
     3792       when "last":U
     3793       then do:
     3794         get last br-trans.
     3795       end.
     3796       when "prev":U
     3797       then do:
     3798         get prev br-trans.
     3799         if not available X_cd-trans then do:
     3800           message
     3801           "Это первая запись списка"
     3802           view-as alert-box.
     3803         end.
     3804       end.
     3805       when "next":U
     3806       then do:
     3807         get next br-trans.
     3808         if not available X_cd-trans then do:
     3809           message
     3810           "Это последняя запись списка"
     3811           view-as alert-box.
     3812         end.
     3813       end.
     3814     end case .
     3815     FIND FIRST buf_chk-doc NO-LOCK WHERE
     3816               buf_chk-doc.doc-code = X_cd-trans.doc-code no-error .
     3817     assign
     3818     p-chk-doc-recid = (if available buf_chk-doc
     3819                        then recid(buf_chk-doc)
     3820                        else ?)
     3821     v-cd-trans-recid = RECID(X_cd-trans)
     3822     .
     3823     run reposition-query in this-procedure
     3824       (input v-cd-trans-recid
     3825       ).
     3826   END PROCEDURE.
     3827   PROCEDURE reposition-query :
     3828   define input parameter p-recid as recid no-undo .
     3829     if p-recid <> ?
     3830     then do:
     3831       reposition br-trans to recid p-recid no-error.
     3832     end.
     3833     do with frame Dialog-Frame:
     3834       apply "entry":u to browse br-trans .
     3835       apply "VALUE-CHANGED":u to browse br-trans .
     3836     end.
     3837   END PROCEDURE.
