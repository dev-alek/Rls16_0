      877   END FUNCTION.
      878   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879     define variable v-cntxt-db-num        as integer   no-undo .
      880     define variable v-cntxt-userid        as character no-undo .
      881     define variable v-cntxt-level         as character no-undo .
      882     define variable v-cntxt-host-code-obj as integer   no-undo .
      883     define variable v-cntxt-obj-type      as character no-undo .
      884     define variable v-cntxt-obj-code      as integer   no-undo .
      885     define variable v-cntxt-db-num-obj    as integer   no-undo .
      886     define variable v-cntxt-is-admin      as logical   no-undo .
      887   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      888   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      889   procedure fltopend_fltopend :
      890   define input parameter p-parent-handle as handle no-undo .
      891   define input parameter p-qh as handle no-undo .
      892   define input parameter p-flt-open-open-query  as character no-undo .
      893   define input parameter p-where-cond as character no-undo .
      894   define input parameter p-use-indFIRST-query-tail as character no-undo .
      895   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      896   define input parameter p-indexed-reposition as character no-undo .
      897     do
      898     on error undo, return error
      899     :
      900   define variable v-prepare-string as character no-undo .
      901   define variable glog as logical no-undo .
      902   assign
      903   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      904                      p-where-cond + chr(32)  +
      905                      p-use-indFIRST-query-tail + chr(32) +
      906                      p-use-ind-sort-clmn-by + chr(32) +
      907                      p-indexed-reposition
      908   .
      909   assign
      910   glog = p-qh:query-prepare(v-prepare-string) no-error .
      911   if not glog
      912   or error-status:error then do:
      913     message error-status:get-message(1) view-as alert-box .
      914     undo, return error .
      915   end.
      916   assign
      917   glog = p-qh:query-open no-error .
      918   if not glog
      919   or error-status:error then do:
      920     message error-status:get-message(1) view-as alert-box .
      921     undo, return error .
      922   end.
      923     end.
      924   end procedure.
      925   procedure fltopend_fltfindd :
      926   define input parameter p-parent-handle as handle no-undo .
      927   define input parameter p-qh as handle no-undo .
      928   define input parameter p-rowid as rowid no-undo .
      929   define input parameter p-next as logical no-undo .
      930   define input parameter p-lock as integer no-undo .
      931   define input parameter p-bh as handle no-undo .
      932   define input parameter p-where-cond as character no-undo .
      933   define input parameter p-use-index-phrase as character no-undo .
      934   define variable glog as logical no-undo .
      935   define variable v-qh as handle no-undo .
      936   define variable v-bh as handle no-undo .
      937   define variable v-recid as recid no-undo .
      938   define variable v-prepare-string as character no-undo .
      939   do
      940   on error undo, return error
      941   on stop undo, return error
      942   :
      943     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      944     create buffer v-bh for table p-bh buffer-name p-bh:name.
      945     create query v-qh.
      946     v-qh:set-buffers(v-bh).
      947     v-prepare-string = substitute("for each &1 &2 &3"
      948                                     ,v-bh:name
      949                                     ,p-where-cond
      950                                     ,p-use-index-phrase).
      951     glog = v-qh:query-prepare(v-prepare-string) no-error.
      952     if not glog then do:
      953       delete object v-qh.
      954       delete object v-bh.
      955       undo, return error .
      956     end.
      957     glog = v-qh:query-open no-error .
      958     if not glog then do:
      959       delete object v-qh.
      960       delete object v-bh.
      961       undo, return error .
      962     end.
      963     if p-next then do:
      964       v-qh:reposition-to-rowid(p-rowid) no-error .
      965       glog = v-qh:get-next( p-lock) no-error .
      966       glog = v-qh:get-next( p-lock) no-error .
      967       if not glog or v-qh:query-off-end = yes then do:
      968         glog = v-qh:get-first( p-lock) no-error .
      969       end.
      970     end.
      971     else do:
      972       glog = v-qh:get-first( p-lock) no-error .
      973     end.
      974     v-recid = v-bh:recid no-error .
      975     delete object v-qh.
      976     delete object v-bh.
      977     return string(v-recid) .
      978   end.
      979   end procedure.
      980   procedure fltopend_fltfindq :
      981   define input parameter p-parent-handle as handle no-undo .
      982   define input parameter p-qh as handle no-undo .
      983   define input parameter p-next as logical no-undo .
      984   define input parameter p-lock as integer no-undo .
      985   define input parameter p-flt-open-open-query  as character no-undo .
      986   define input parameter p-where-cond as character no-undo .
      987   define input parameter p-use-indFIRST-query-tail as character no-undo .
      988   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      989   define input parameter p-indexed-reposition as character no-undo .
      990   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      991   define variable glog as logical no-undo .
      992   define variable v-qh as handle no-undo .
      993   define variable v-bh as handle no-undo extent 18.
      994   define variable v-rowid as rowid no-undo extent 18.
      995   define variable v-ii as integer no-undo .
      996   define variable v-prepare-string as character no-undo .
      997   do
      998   on error undo, return error
      999   on stop undo, return error
     1000   :
     1001     create query v-qh.
     1002     do v-ii = 1 to p-qh:num-buffers:
     1003       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1004       assign
     1005       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1006       no-error.
     1007       v-qh:add-buffer(v-bh[v-ii]).
     1008     end.
     1009     assign
     1010     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1011                       p-where-cond + chr(32)  +
     1012                       p-use-indFIRST-query-tail + chr(32) +
     1013                       p-use-ind-sort-clmn-by + chr(32) +
     1014                       p-indexed-reposition
     1015     .
     1016     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1017     if not glog then do:
     1018       delete object v-qh.
     1019       do v-ii = 1 to p-qh:num-buffers:
     1020         delete object v-bh[v-ii].
     1021       end.
     1022       undo, return error .
     1023     end.
     1024     glog = v-qh:query-open no-error .
     1025     if not glog then do:
     1026       delete object v-qh.
     1027       do v-ii = 1 to p-qh:num-buffers:
     1028         delete object v-bh[v-ii].
     1029       end.
     1030       undo, return error .
     1031     end.
     1032     if p-next then do:
     1033       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1034       glog = v-qh:get-next( p-lock) no-error .
     1035       glog = v-qh:get-next( p-lock) no-error .
     1036       if not glog or v-qh:query-off-end = yes then do:
     1037         glog = v-qh:get-first( p-lock) no-error .
     1038       end.
     1039     end.
     1040     else do:
     1041       glog = v-qh:get-first( p-lock) no-error .
     1042     end.
     1043     do v-ii = 1 to p-qh:num-buffers:
     1044       assign
     1045       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1046       no-error.
     1047     end.
     1048     delete object v-qh.
     1049     do v-ii = 1 to p-qh:num-buffers:
     1050       delete object v-bh[v-ii].
     1051     end.
     1052   end.
     1053   end procedure.
     1054   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1055   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1056   procedure paramls-clear :
     1057     define buffer buf_temp-param for temp-param .
     1058     do
     1059     on error undo, return error return-value
     1060     :
     1061       for each buf_temp-param
     1062       on error undo, return error
     1063       :
     1064         delete buf_temp-param .
     1065       end.
     1066     end.
     1067   end procedure.
     1068   procedure paramls-write :
     1069     define input  parameter p-code     as character no-undo .
     1070     define input  parameter p-sub-code as character no-undo .
     1071     define input  parameter p-value    as character no-undo .
     1072     define buffer buf_temp-param for temp-param .
     1073     do
     1074     on error undo, return error return-value
     1075     :
     1076       find first buf_temp-param
     1077         where buf_temp-param.param-code     = p-code
     1078           and buf_temp-param.param-sub-code = p-sub-code
     1079         no-error .
     1080       if not available buf_temp-param then do:
     1081         create buf_temp-param .
     1082         assign
     1083           buf_temp-param.param-code     = p-code
     1084           buf_temp-param.param-sub-code = p-sub-code
     1085         .
     1086       end.
     1087       assign
     1088         buf_temp-param.param-value = p-value
     1089       .
     1090     end.
     1091   end procedure.
     1092   procedure paramls-read :
     1093     define input  parameter p-code          as character no-undo .
     1094     define input  parameter p-sub-code      as character no-undo .
     1095     define input  parameter p-default-value as character no-undo .
     1096     define output parameter p-value         as character no-undo .
     1097     define buffer buf_temp-param for temp-param .
     1098     do
     1099     on error undo, return error return-value
     1100     :
     1101       find first buf_temp-param
     1102         where buf_temp-param.param-code     = p-code
     1103           and buf_temp-param.param-sub-code = p-sub-code
     1104         no-error .
     1105       if available buf_temp-param then do:
     1106         assign
     1107           p-value = buf_temp-param.param-value
     1108         .
     1109       end.
     1110       else do:
     1111         assign
     1112           p-value = p-default-value
     1113         .
     1114       end.
     1115     end.
     1116   end procedure.
     1117   procedure paramls-append :
     1118     define input  parameter p-code     as character no-undo .
     1119     define input  parameter p-sub-code as character no-undo .
     1120     define input  parameter p-value    as character no-undo .
     1121     define buffer buf_temp-param for temp-param .
     1122     do
     1123     on error undo, return error return-value
     1124     :
     1125       find first buf_temp-param
     1126            where buf_temp-param.param-code     = p-code
     1127              and buf_temp-param.param-sub-code = p-sub-code
     1128         no-error .
     1129       if not available buf_temp-param then do:
     1130         create buf_temp-param .
     1131         assign
     1132           buf_temp-param.param-code     = p-code
     1133           buf_temp-param.param-sub-code = p-sub-code
     1134           buf_temp-param.param-value    = p-value
     1135         .
     1136       end.
     1137       else do:
     1138           assign
     1139               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1140           .
     1141       end.
     1142     end.
     1143   end procedure.
     1144   DEFINE MENU MENU-b-lnk
     1145          MENU-ITEM m_41           LABEL "Данные МБ о расходах"
     1146          MENU-ITEM m_42           LABEL "Данные МБ по истории заправок".
     1147   DEFINE BUTTON b-chk-doc
     1148        LABEL "Чек"
     1149        SIZE 10 BY 1.
     1150   DEFINE BUTTON B-Help
     1151        LABEL "Помо&щь"
     1152        SIZE 3 BY 1
     1153        BGCOLOR 8 .
     1154   DEFINE BUTTON b-lnk
     1155        LABEL "Связи"
     1156        SIZE 10 BY 1.
     1157   DEFINE BUTTON b-mark
     1158        LABEL "&*"
     1159        SIZE 3 BY 1.
     1160   DEFINE BUTTON b-quit AUTO-END-KEY
     1161        LABEL "&Выход"
     1162        SIZE 10 BY 1
     1163        BGCOLOR 8 .
     1164   DEFINE BUTTON b-sch
     1165        LABEL "&Фильтр"
     1166        SIZE 3 BY 1.
     1167   DEFINE BUTTON b-sel AUTO-GO
     1168        LABEL "&Выбор"
     1169        SIZE 10 BY 1.
     1170   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U INITIAL "0"
     1171         VIEW-AS TEXT
     1172        SIZE 10 BY .67 NO-UNDO.
     1173   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(20)":U
     1174        LABEL "коду транз."
     1175        VIEW-AS FILL-IN
     1176        SIZE 21 BY 1 NO-UNDO.
     1177   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1178        LABEL "Дата"
     1179        VIEW-AS FILL-IN
     1180        SIZE 13 BY 1 NO-UNDO.
     1181   DEFINE QUERY br-trans FOR
     1182         X_cd-trans SCROLLING.
     1183   DEFINE BROWSE br-trans
     1184     QUERY br-trans NO-LOCK DISPLAY
     1185         mark-string(recid(X_cd-trans), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1186   X_cd-trans.chk-date COLUMN-LABEL "Дата" FORMAT "99/99/9999":U
     1187   string(X_cd-trans.chk-time, "HH:MM") COLUMN-LABEL "Время" FORMAT "X(5)"
     1188   X_cd-trans.doc-code COLUMN-LABEL "Номер чека" FORMAT "X(20)":U
     1189   X_cd-trans.obj-type COLUMN-LABEL "Тип!Объ" FORMAT "X(3)":U
     1190   X_cd-trans.obj-code COLUMN-LABEL "Код!обЪ" FORMAT ">>>>9":U
     1191   X_cd-trans.pay-desk COLUMN-LABEL "Касса" FORMAT ">>>9":U
     1192   X_cd-trans.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1193   X_cd-trans.charkey_one COLuMN-LABEL "" FORMAT "X(255)":U WIDTH 20
     1194   X_cd-trans.charkey_two COLuMN-LABEL "" FORMAT "X(255)":U WIDTH 20
     1195   X_cd-trans.charkey_three COLuMN-LABEL "" FORMAT "X(255)":U WIDTH 20
     1196   X_cd-trans.key#_one COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1197   X_cd-trans.key#_two COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1198   X_cd-trans.key#_three COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1199   X_cd-trans.key#_four COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1200   X_cd-trans.key#_five COLuMN-LABEL "" FORMAT "->>>>>>>>9":U
     1201   X_cd-trans.deckey_one COLuMN-LABEL "" FORMAT "->>>>>>>>9.99":U
     1202   X_cd-trans.deckey_two COLuMN-LABEL "" FORMAT "->>>>>>>>9.99":U
     1203   X_cd-trans.deckey_three COLuMN-LABEL "" FORMAT "->>>>>>>>9.99":U
     1204   X_cd-trans.trans-type COLUMN-LABEL "Тип!транзакции"
     1205   X_cd-trans.trans-id-chr COLUMN-LABEL "ID транзакц" FORMAT "X(54)"
     1206       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 20 FIT-LAST-COLUMN.
     1207   DEFINE FRAME Dialog-Frame
     1208        b-quit AT ROW 1 COL 1
     1209        b-mark AT ROW 1 COL 21 WIDGET-ID 52
     1210        b-sel AT ROW 1 COL 24 WIDGET-ID 54
     1211        b-chk-doc AT ROW 1 COL 41 WIDGET-ID 50
     1212        b-lnk AT ROW 1 COL 51 WIDGET-ID 66
     1213        b-sch AT ROW 1 COL 92 WIDGET-ID 60
     1214        B-Help AT ROW 1 COL 95
     1215        br-trans AT ROW 2 COL 1 WIDGET-ID 100
     1216        sch-code AT ROW 22.27 COL 19 COLON-ALIGNED WIDGET-ID 64
     1217        sch-date AT ROW 22.27 COL 46.5 COLON-ALIGNED WIDGET-ID 56
     1218        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 62
     1219        "Поиск по:" VIEW-AS TEXT
     1220             SIZE 11 BY 1.27 AT ROW 22 COL 1 WIDGET-ID 58
     1221             FGCOLOR 4
     1222        SPACE(87.80) SKIP(0.00)
     1223       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1224            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1225            TITLE ""
     1226            CANCEL-BUTTON b-quit.
     1227   ASSIGN
     1228          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1229          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1230   ASSIGN
     1231          b-lnk:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-lnk:HANDLE.
     1232   ON GO OF FRAME Dialog-Frame
     1233   DO:
     1234     p-rid-list = v-rid-list.
     1235   END.
     1236   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1237   DO:
     1238     APPLY "END-ERROR":U TO SELF.
     1239   END.
     1240   ON CHOOSE OF b-chk-doc IN FRAME Dialog-Frame
     1241   DO:
     1242   define variable next-prev as character no-undo .
     1243   define variable v-doc-rec as recid no-undo .
     1244   define variable v-chk-doc-rec as recid no-undo .
     1245   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     1246   assign
     1247   next-prev = '':U
     1248   v-cd-trans-recid = (if available X_cd-trans then recid(X_cd-trans) else ?)
     1249   .
     1250   DO WHILE next-prev = '':U:
     1251       if NOT available X_cd-trans then do:
     1252               message "Неправильно выбрана транзакция." view-as alert-box ERROR.
     1253               return no-apply.
     1254       end.
     1255       IF X_cd-trans.chk-id = "" THEN DO:
     1256         MESSAGE
     1257         "Нет ссылки на чек для этой транзакции"
     1258         VIEW-AS ALERT-BOX.
     1259         undo, return no-apply.
     1260       END.
     1261       FIND FIRST buf_chk-doc NO-LOCK WHERE
     1262                  buf_chk-doc.chk-id = X_cd-trans.chk-id
     1263              and buf_chk-doc.obj-type = X_cd-trans.obj-type
     1264              and buf_chk-doc.obj-code = X_cd-trans.obj-code no-error .
     1265       if not available buf_chk-doc then do:
     1266         message
     1267         substitute("Неверная ссылка на чек для этой транзакции&1id=&2"
     1268                   ,chr(10)
     1269                   ,X_cd-trans.chk-id)
     1270         view-as alert-box error .
     1271         undo, return no-apply.
     1272       end.
     1273       v-chk-doc-rec = recid(buf_chk-doc).
     1274       run str/superchk.w
     1275                     (
     1276                        input parparentproc
     1277                       ,input 'ПРОСМОТР':U
     1278                       ,input buf_chk-doc.obj-type
     1279                       ,input buf_chk-doc.obj-code
     1280                       ,input-output v-chk-doc-rec
     1281                       ,input this-procedure:handle
     1282                       ,input-output next-prev
     1283                                   )
     1284       .
     1285   END .
     1286   reposition br-trans to recid v-cd-trans-recid no-error.
     1287   apply "entry" to br-trans in frame Dialog-Frame.
     1288   apply "value-changed" to br-trans in frame Dialog-Frame.
     1289   END.
     1290   ON CHOOSE OF b-lnk IN FRAME Dialog-Frame
     1291   DO:
     1292    DEFINE VARIABLE varrid-list as character no-undo .
     1293   IF NOT AVAILABLE X_cd-trans THEN RETURN NO-APPLY.
     1294   IF lnk-OPTION = '':u THEN DO:
     1295     run gbl/pop-up.p ( input self:handle, input no) no-error.
     1296   END.
     1297   IF lnk-OPTION = '':u THEN RETURN NO-APPLY.
     1298   CASE lnk-OPTION:
     1299     WHEN '42':U THEN DO:
     1300         run str/cd-trans.w (
     1301                             input parparentproc
     1302                            ,input ""
     1303                            ,input "trans-id-chr"
     1304                            ,input integer('42':U)
     1305                            ,input p-obj-type
     1306                            ,input p-obj-code
     1307                            ,input 01/01/2008
     1308                            ,input 12/31/9999
     1309                            ,input ""
     1310                            ,input X_cd-trans.trans-id-chr
     1311                            ,output varrid-list    ) no-error.
     1312     end.
     1313     when '41':U then do:
     1314       run str/cd-trans.w (
     1315                           input parparentproc
     1316                          ,input ""
     1317                          ,input "trans-id-chr"
     1318                          ,input integer('41':U)
     1319                          ,input p-obj-type
     1320                          ,input p-obj-code
     1321                          ,input 01/01/2008
     1322                          ,input 12/31/9999
     1323                          ,input ""
     1324                          ,input X_cd-trans.trans-id-chr
     1325                          ,output varrid-list    ) no-error.
     1326     end.
     1327   end case.
     1328   lnk-option = "".
     1329   apply "entry" to br-trans.
     1330   END.
     1331   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1332   DO:
     1333     define variable glog as logical no-undo .
     1334     if available X_cd-trans then do:
     1335   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   define variable v-str-recid15 as character no-undo .
     1337   define variable v-num-entry15 as integer   no-undo .
     1338   assign
     1339     v-str-recid15 = trim( string( recid( X_cd-trans ) , "->>>>>>>>>>>9":U ) )
     1340     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1341   .
     1342   if v-num-entry15 > 0 then do:
     1343     assign
     1344       entry( v-num-entry15, v-rid-list ) = "":U
     1345       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1346     .
     1347   end.
     1348   else do:
     1349     assign
     1350       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1351     .
     1352   end.
     1353       glog = br-trans:refresh() .
     1354       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1355           glog = br-trans:select-next-row ().
     1356           apply "VALUE-CHANGED" to br-trans in frame Dialog-Frame.
     1357       end.
     1358       if num-entries( v-rid-list ) = 0
     1359       then
     1360           hide mark-num in frame Dialog-Frame.
     1361       else
     1362           display
     1363           num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1364     end.
     1365     apply "entry" to br-trans in frame Dialog-Frame.
     1366   END.
     1367   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1368   DO:
     1369       run proc-b-sch in this-procedure no-error.
     1370     if error-status:error then return no-apply.
     1371   END.
     1372   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1373   DO:
     1374       if ( available X_cd-trans ) AND ( v-rid-list = "" ) then
     1375       v-rid-list = string( recid( X_cd-trans ) ) .
     1376   END.
     1377   ON CHOOSE OF MENU-ITEM m_41
     1378   DO:
     1379     ASSIGN lnk-OPTION = '42':U.
     1380     apply "CHOOSE" to b-lnk in frame Dialog-Frame.
     1381   END.
     1382   ON CHOOSE OF MENU-ITEM m_42
     1383   DO:
     1384     ASSIGN lnk-OPTION = '41':U.
     1385     apply "CHOOSE" to b-lnk in frame Dialog-Frame.
     1386   END.
     1387   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1388   DO:
     1389       run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1390     if error-status:error then return no-apply.
     1391   END.
     1392   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1393   DO:
     1394       run proc-find-code in this-procedure ( input NO, input frame Dialog-Frame sch-code) no-error.
     1395     if error-status:error then return no-apply.
     1396   END.
     1397   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1398   DO:
     1399       run proc-find-date in this-procedure ( input YES, input frame Dialog-Frame sch-date) no-error.
     1400     if error-status:error then return no-apply.
     1401   END.
     1402   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1403   DO:
     1404     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date) no-error.
     1405     if error-status:error then return no-apply.
     1406   END.
     1407   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1408   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1409   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1410   on help of frame Dialog-Frame
     1411   do:
     1412     run gbl/app_help.p
     1413       (input this-procedure :file-name
     1414       ,input ''
     1415       ,input ?
     1416       ) no-error.
     1417     if error-status :error then do:
     1418       message
     1419         "Ошибка при вызове помощи"
     1420         error-status :get-message(1)
     1421         view-as alert-box .
     1422     end.
     1423   end.
     1424   run minbtn-set in this-procedure .
     1425   on choose of b-help in frame Dialog-Frame
     1426   do:
     1427     apply "help":u to frame Dialog-Frame .
     1428   end.
     1429   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1430   procedure minbtn-set :
     1431       do
     1432           on error undo, return error return-value
     1433           :
     1434           define variable ii              as integer       no-undo .
     1435           define variable fh              as widget-handle no-undo .
     1436           define variable hh              as widget-handle no-undo .
     1437           define variable v-h             as handle        extent 4 no-undo .
     1438           define variable v-name-button   as character     no-undo .
     1439           define variable v-help-old-x    as decimal       no-undo .
     1440           define variable v-help-old-y    as decimal       no-undo .
     1441           define variable v-help-old-size as decimal       no-undo .
     1442           define variable v-frame-width   as decimal       no-undo .
     1443           define variable jj              as integer       no-undo .
     1444           do
     1445               on error undo, return error
     1446               :
     1447               assign
     1448                   v-frame-width = frame Dialog-Frame:width - 0.3
     1449                   fh            = frame Dialog-Frame:first-child
     1450                   hh            = fh:first-child
     1451                   ii            = 1
     1452                   .
     1453               do while valid-handle(hh):
     1454                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1455                   do:
     1456                       case lc(hh:name) :
     1457                           when "b-help" then
     1458                               do:
     1459                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1460                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1461                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1462                                   hh:TOOLTIP = "Помощь" .
     1463                                   v-help-old-x = hh:column .
     1464                                   v-help-old-y = hh:row    .
     1465                                   v-help-old-size = hh:width .
     1466                                   hh:width-chars = 2.5 .
     1467                               end.
     1468                           when "b-print" then
     1469                               do:
     1470                                   hh:load-image("cmp/b-print.bmp":u) .
     1471                                   hh:TOOLTIP = "Печать" .
     1472                                   v-h[ii] = hh:handle .
     1473                                   ii = ii + 1 .
     1474                                   hh:width-chars = 3 .
     1475                               end.
     1476                           when "b-history" or
     1477                           when "b-hist" then
     1478                               do:
     1479                                   hh:load-image("cmp/b-hist.bmp":u) .
     1480                                   hh:TOOLTIP = "История" .
     1481                                   v-h[ii] = hh:handle .
     1482                                   ii = ii + 1 .
     1483                                   hh:width-chars = 3 .
     1484                               end.
     1485                           when "b-sch" then
     1486                               do:
     1487                                   hh:load-image("cmp/b-sch.bmp":u) .
     1488                                   hh:TOOLTIP = "Установка Фильтра" .
     1489                                   v-h[ii] = hh:handle .
     1490                                   ii = ii + 1 .
     1491                                   hh:width-chars = 3 .
     1492                               end.
     1493                           when "b-hist-user" then
     1494                               do:
     1495                                   hh:load-image("cmp/b-hist.bmp":u) .
     1496                                   hh:TOOLTIP = "История пользователя" .
     1497                                   ii = ii + 1 .
     1498                               end.
     1499                       end case.
     1500                   end.
     1501                   hh = hh:next-sibling.
     1502               end.
     1503               b-help:column = v-frame-width - b-help:width-chars.
     1504               jj = 0.
     1505               repeat ii = 4 to 1 by -1 :
     1506                   if valid-handle (v-h[ii] ) then
     1507                   do:
     1508                       jj  = jj + 1 .
     1509                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1510                       v-h[ii]:row    = v-help-old-y .
     1511                   end.
     1512               end.
     1513           end.
     1514       end.
     1515   end procedure.
     1516   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1517   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1518   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1519   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1520   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1521   define variable v-diasize-current-frame-height as decimal   no-undo .
     1522   define variable v-diasize-change-size          as logical   no-undo .
     1523   define variable v-diasize-resize-button        as handle    no-undo .
     1524   define variable v-diasize-wndmax               as logical   no-undo .
     1525   define variable v-diasize-wndstore             as logical   no-undo .
     1526   define variable v-diasize-proc-name            as character no-undo .
     1527   define variable v-diasize-browse-handle        as handle    no-undo .
     1528   define variable v-diasize-browse-number        as integer   no-undo .
     1529   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1530   define temp-table temp-diasize-handle no-undo
     1531     field handle-value  as handle
     1532     field save-position as decimal
     1533     index xpk is primary unique handle-value
     1534     .
     1535   define temp-table temp-browse-handle no-undo
     1536     field browse-type   as character
     1537     field browse-number as integer
     1538     field browse-handle as handle
     1539     field original-size as decimal
     1540     index xpk is primary unique browse-type browse-number
     1541     index xie browse-type browse-handle
     1542   .
     1543   procedure diasize_change-height :
     1544     define input  parameter p-change-value  as decimal   no-undo .
     1545     define input  parameter p-move-resize   as logical   no-undo .
     1546     define variable v-field-group-handle    as handle    no-undo .
     1547     define variable v-object-handle         as handle    no-undo .
     1548     define variable v-frame-height          as decimal   no-undo .
     1549     define variable v-frame-virtual-height  as decimal   no-undo .
     1550     define variable v-browse-height         as decimal   no-undo .
     1551     define variable v-window-height         as decimal   no-undo .
     1552     define variable v-window-virtual-height as decimal   no-undo .
     1553     define variable v-change-sign           as integer   no-undo .
     1554     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1555     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1556     if p-change-value > 0
     1557     then do:
     1558       if frame Dialog-Frame :height + p-change-value
     1559           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1560       then do:
     1561         assign
     1562           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1563                           - (frame Dialog-Frame :height-chars)
     1564         .
     1565         if p-change-value <= 0
     1566         then do:
     1567           run diasize_position-resize-button in this-procedure .
