     3026   PROCEDURE MyEnable :
     3027   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     3028   DEFINE BUFFER buf_custom-labels FOR ub.custom-labels.
     3029   ASSIGN
     3030   v-h = br-trans:FIRST-COLUMN IN FRAME Dialog-Frame
     3031   b-lnk:menu-mouse  = 1
     3032   .
     3033   DO while valid-handle(v-h) :
     3034    IF p-trans-type > 0  THEN DO:
     3035       FIND FIRST buf_custom-labels NO-LOCK WHERE
     3036               buf_custom-labels.CALL-TYPE = "cd-trans"
     3037         AND buf_custom-labels.call-point = string(p-trans-type)
     3038         AND buf_custom-labels.tbl-name = 'cd-trans':U
     3039         AND buf_custom-labels.fld-name = v-h:NAME NO-ERROR.
     3040       IF NOT AVAILABLE buf_custom-labels THEN DO:
     3041          v-h:VISIBLE = NO.
     3042       END.
     3043       ELSE DO:
     3044         ASSIGN
     3045         v-h:visible = YES
     3046         v-h:LABEL = buf_custom-labels.custom-label
     3047         v-h:width = max(buf_custom-labels.widget-width, length(buf_custom-labels.custom-label))
     3048         v-h:RESIZABLE = (v-h:DATA-TYPE = 'character':U)
     3049         .
     3050         if v-h:name = "charkey_one" then do:
     3051           assign
     3052           v-charkey-one-label = buf_custom-labels.custom-label
     3053           .
     3054         end.
     3055       END.
     3056     END.
     3057     v-h = v-h:NEXT-COLUMN.
     3058   END.
     3059   assign
     3060   menu-item m_41:sensitive in menu menu-b-lnk  = no
     3061   menu-item m_42:sensitive in menu menu-b-lnk  = no
     3062   menu-item m_41:sensitive in menu menu-b-lnk  = (p-trans-type = integer('40':U))
     3063   menu-item m_42:sensitive in menu menu-b-lnk  = (p-trans-type = integer('40':U))
     3064   .
