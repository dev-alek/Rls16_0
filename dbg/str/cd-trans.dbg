     1586     end.
     1587     if p-change-value >= 0
     1588     then do:
     1589       assign
     1590         v-change-sign = 1
     1591       .
     1592     end.
     1593     else do:
     1594       assign
     1595         v-change-sign = -1
     1596       .
     1597     end.
     1598     assign
     1599       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1600     .
