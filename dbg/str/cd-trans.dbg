     2980         return.
     2981       end.
     2982     end.
     2983     IF p-list-mode = "chk-date":U then do:
     2984         if p-start-date > p-end-date
     2985         or p-start-date = ?
     2986         or p-end-date = ?
     2987         then do:
     2988             message vss-workfile vss-revision vss-description skip
     2989             "Неверное значение параметров p-start-date p-end-date" p-start-date p-end-date
     2990             view-as alert-box ERROR.
     2991             return.
     2992       end.
     2993     END.
     2994     if this-procedure:instantiating-procedure:get-signature("cd-trans_cb")  <> "" then do:
     2995       run cd-trans_cb in (this-procedure:INSTANTIATING-PROCEDURE) ( input ( buffer temp-param:handle)) no-error.
     2996       if error-status:error then do:
     2997          message
     2998          substitute("Ошибка при инициализации параметров &1 в &2"
     2999                     , this-procedure:file-name
     3000                     , this-procedure:INSTANTIATING-PROCEDURE:file-name)
