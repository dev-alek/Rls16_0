     2184         for each buf_temp-browse-handle
     2185           where buf_temp-browse-handle.browse-type = 'width':u
     2186         on error undo move_block, retry move_block
     2187         :
     2188           assign
     2189             buf_temp-browse-handle.browse-handle :width
     2190               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2191             no-error .
     2192           if error-status :error
     2193           or error-status :get-message(1) <> ""
     2194           then do:
     2195             undo move_block, retry move_block .
     2196           end.
     2197         end.
     2198         for each buf_temp-diasize-handle
     2199         on error undo move_block, retry move_block
     2200         :
     2201           assign
     2202             v-object-handle = buf_temp-diasize-handle.handle-value
     2203           .
     2204           if v-object-handle <> v-diasize-resize-button
     2205           then do:
     2206             assign
     2207               v-object-handle :col = v-object-handle :col + p-change-value
     2208               no-error .
     2209             if error-status :error
     2210             or error-status :get-message(1) <> ""
     2211             then do:
     2212               undo move_block, retry move_block .
     2213             end.
     2214           end.
     2215         end.
     2216       end.
     2217       else do:
     2218         for each buf_temp-diasize-handle
     2219         on error undo move_block, retry move_block
     2220         :
     2221           assign
     2222             v-object-handle = buf_temp-diasize-handle.handle-value
     2223           .
     2224           if v-object-handle <> v-diasize-resize-button
     2225           then do:
     2226             assign
     2227               v-object-handle :col = v-object-handle :col + p-change-value
     2228               no-error .
     2229             if error-status :error
     2230             or error-status :get-message(1) <> ""
     2231             then do:
     2232               undo move_block, retry move_block .
     2233             end.
     2234           end.
     2235         end.
     2236         for each buf_temp-browse-handle
     2237           where buf_temp-browse-handle.browse-type = 'width':u
     2238         on error undo move_block, retry move_block
     2239         :
     2240           assign
     2241             buf_temp-browse-handle.browse-handle :width
     2242               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2243             no-error .
     2244           if error-status :error
     2245           or error-status :get-message(1) <> ""
     2246           then do:
     2247             undo move_block, retry move_block .
     2248           end.
     2249         end.
     2250         assign
     2251           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2252           no-error .
     2253         if error-status :error
     2254         or error-status :get-message(1) <> ""
     2255         then do:
     2256           undo move_block, retry move_block.
     2257         end.
     2258         assign
     2259           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2260         no-error .
     2261         if error-status :error
     2262         or error-status :get-message(1) <> ""
     2263         then do:
     2264           undo move_block, retry move_block.
     2265         end.
     2266         if frame Dialog-Frame :scrollable = true
     2267         then do:
     2268           assign
     2269             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2270           no-error .
     2271           if error-status :error
     2272           or error-status :get-message(1) <> ""
     2273           then do:
     2274             undo move_block, retry move_block.
     2275           end.
     2276         end.
     2277       end.
     2278       if p-move-resize
     2279       then do:
     2280         run diasize_position-resize-button in this-procedure .
     2281       end.
     2282       if v-diasize-wndstore = true
     2283       then do:
     2284         if connected("ub") = true
     2285         then do:
     2286           define variable v-cntxt-db-num        as integer   no-undo .
     2287           define variable v-cntxt-userid        as character no-undo .
     2288           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2289                                             , OUTPUT v-cntxt-userid
     2290                                             ) .
     2291           run gbl/wndsizew.p
     2292             (input  v-cntxt-db-num
     2293             ,input  v-cntxt-userid
     2294             ,input  v-diasize-proc-name
     2295             ,input  'width':u
     2296             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2297             ) .
     2298         end.
     2299       end.
     2300     end.
     2301     assign
     2302       v-diasize-change-size = false
     2303     .
     2304   end procedure.
     2305   procedure diasize_set-width :
     2306     define input  parameter p-new-width  as decimal   no-undo .
     2307     define input  parameter p-move-resize as logical   no-undo .
     2308     do
     2309     on error undo, return error return-value
     2310     :
     2311       run diasize_change-width in this-procedure
     2312         (input  (p-new-width - frame Dialog-Frame :width)
     2313         ,input  p-move-resize
     2314         ) .
     2315     end.
     2316   end procedure.
     2317   procedure diasize_position-resize-button :
     2318     do with frame Dialog-Frame
     2319     :
     2320       hide v-diasize-resize-button .
     2321       assign
     2322         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2323                     - 1
     2324                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2325         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2326                     - 1
     2327                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2328       .
     2329       view v-diasize-resize-button .
     2330     end.
     2331   end procedure.
     2332   on alt-right anywhere
     2333   do:
     2334     run diasize_change-width in this-procedure
     2335       (input 1
     2336       ,input true
     2337       ) .
     2338     return no-apply .
     2339   end.
     2340   on alt-left anywhere
     2341   do:
     2342     run diasize_change-width in this-procedure
     2343       (input -1
     2344       ,input true
     2345       ) .
     2346     return no-apply .
     2347   end.
     2348   on alt-down anywhere
     2349   do:
     2350     run diasize_change-height in this-procedure
     2351       (input 1
     2352       ,input true
     2353       ) .
     2354     return no-apply .
     2355   end.
     2356   on alt-up anywhere
     2357   do:
     2358     run diasize_change-height in this-procedure
     2359       (input -1
     2360       ,input true
     2361       ) .
     2362     return no-apply .
     2363   end.
     2364   on alt-enter of frame Dialog-Frame
     2365   do:
     2366     run diasize_maximize in this-procedure
     2367       (input  ?
     2368       ).
     2369     return no-apply .
     2370   end.
     2371   procedure diasize_end-move :
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       define variable v-row-delta as decimal   no-undo .
     2376       define variable v-col-delta as decimal   no-undo .
     2377       define variable v-new-row as decimal   no-undo .
     2378       define variable v-new-col as decimal   no-undo .
     2379       assign
     2380         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2381         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2382       .
     2383       assign
     2384         v-row-delta = v-new-row - frame Dialog-Frame :height
     2385         v-col-delta = v-new-col - frame Dialog-Frame :width
     2386       .
     2387       run diasize_change-height in this-procedure
     2388         (input v-row-delta
     2389         ,input true
     2390         ) .
     2391       run diasize_change-width in this-procedure
     2392         (input v-col-delta
     2393         ,input true
     2394         ) .
     2395     end.
     2396   end procedure.
     2397   procedure diasize_maximize :
     2398     define input  parameter p-action as logical   no-undo .
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       if p-action = ?
     2403       then do:
     2404         if v-diasize-need-maximize = true
     2405         then do:
     2406           assign
     2407             p-action = true
     2408           .
     2409         end.
     2410         else do:
     2411           assign
     2412             p-action = false
     2413           .
     2414         end.
     2415       end.
     2416       if p-action = true
     2417       then do:
     2418         run diasize_change-height in this-procedure
     2419           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2420               - frame Dialog-Frame :height-chars
     2421           ,input true
     2422           ) .
     2423         run diasize_change-width in this-procedure
     2424           (input session :width-chars
     2425               - frame Dialog-Frame :width-chars
     2426           ,input true
     2427           ) .
     2428         assign
     2429           v-diasize-need-maximize = false
     2430         .
     2431       end.
     2432       else do:
     2433         run diasize_change-width in this-procedure
     2434           (input v-diasize-orig-frame-width
     2435               - frame Dialog-Frame :width-chars
     2436           ,input true
     2437           ) .
     2438         run diasize_change-height in this-procedure
     2439           (input v-diasize-orig-frame-height
     2440               - frame Dialog-Frame :height-chars
     2441           ,input true
     2442           ) .
     2443         assign
     2444           v-diasize-need-maximize = true
     2445         .
     2446       end.
     2447     end.
     2448   end procedure.
     2449   procedure diasize_restore-orig-size :
     2450     do
     2451     on error undo, return error return-value
     2452     :
     2453       assign
     2454         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2455         v-diasize-current-frame-height = frame Dialog-Frame :height
     2456       .
     2457       run diasize_set-height in this-procedure
     2458         (input  v-diasize-orig-frame-height
     2459         ,input  true
     2460         ) .
     2461       run diasize_set-width in this-procedure
     2462         (input  v-diasize-orig-frame-width
     2463         ,input  true
     2464         ) .
     2465     end.
     2466   end procedure.
     2467   procedure diasize_restore-current-size :
     2468     do
     2469     on error undo, return error return-value
     2470     :
     2471       run diasize_set-height in this-procedure
     2472         (input  v-diasize-current-frame-height
     2473         ,input  true
     2474         ) .
     2475       run diasize_set-width in this-procedure
     2476         (input  v-diasize-current-frame-width
     2477         ,input  true
     2478         ) .
     2479     end.
     2480   end procedure.
     2481   procedure diasize_set-browse-handle :
     2482     define input  parameter p-browse-handle as handle   no-undo .
     2483     define buffer buf_temp-browse-handle for temp-browse-handle .
     2484     do
     2485     on error undo, return error return-value
     2486     :
     2487       assign
     2488         v-diasize-browse-handle = p-browse-handle
     2489       .
     2490       for each buf_temp-browse-handle
     2491       on error undo, return error return-value
     2492       :
     2493         delete buf_temp-browse-handle .
     2494       end.
     2495     end.
     2496   end procedure.
     2497   procedure diasize_add_browse :
     2498     define input  parameter p-browse-type   as character no-undo .
     2499     define input  parameter p-browse-handle as handle    no-undo .
     2500     define buffer buf_temp-browse-handle for temp-browse-handle .
     2501     do
     2502     on error undo, return error return-value
     2503     :
     2504       assign
     2505         v-diasize-browse-number = v-diasize-browse-number + 1
     2506       .
     2507       create buf_temp-browse-handle .
     2508       assign
     2509         buf_temp-browse-handle.browse-type   = p-browse-type
     2510         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2511         buf_temp-browse-handle.browse-handle = p-browse-handle
     2512       .
     2513     end.
     2514   end procedure.
     2515   procedure diasize_init :
     2516     define variable v-default-value    as logical   no-undo .
     2517     define variable v-restore-saved    as logical   no-undo .
     2518     define variable v-resize-value-str as character no-undo .
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522       do with frame Dialog-Frame
     2523       :
     2524         assign
     2525           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2526           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2527           v-diasize-browse-handle     = browse br-trans :handle
     2528         .
     2529         create button v-diasize-resize-button
     2530         assign
     2531           parent        = frame Dialog-Frame :first-child
     2532           label         = "s"
     2533           height-pixels = 16
     2534           width-pixels  = 16
     2535           visible       = true
     2536           sensitive     = true
     2537           movable       = true
     2538           triggers:
     2539             on end-move persistent run diasize_end-move in this-procedure .
     2540           end triggers.
     2541         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2542         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2543         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2544         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2545         assign
     2546           v-diasize-wndmax = false
     2547         .
     2548         if connected("ub") = true
     2549         then do:
     2550           define variable v-cntxt-db-num        as integer   no-undo .
     2551           define variable v-cntxt-userid        as character no-undo .
     2552           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2553                                             , OUTPUT v-cntxt-userid
     2554                                             ) .
     2555           run gbl/wndpar_r.p
     2556             (input  v-cntxt-db-num
     2557             ,input  v-cntxt-userid
     2558             ,input  'wndmax':U
     2559             ,output v-diasize-wndmax
     2560             ,output v-default-value
     2561             ) .
     2562         end.
     2563         assign
     2564           v-diasize-wndstore = false
     2565         .
     2566         if connected("ub") = true
     2567         then do:
     2568           run gbl/wndpar_r.p
     2569             (input  v-cntxt-db-num
     2570             ,input  v-cntxt-userid
     2571             ,input  'wndstore':U
     2572             ,output v-diasize-wndstore
     2573             ,output v-default-value
     2574             ) .
     2575         end.
     2576         assign
     2577           v-diasize-proc-name = entry(1, program-name(2), '.')
     2578         .
     2579         if v-diasize-wndstore = true
     2580         then do:
     2581           assign
     2582             v-restore-saved = false
     2583           .
     2584           if connected("ub") = true
     2585           then do:
     2586             run gbl/wndsizer.p
     2587               (input  v-cntxt-db-num
     2588               ,input  v-cntxt-userid
     2589               ,input  v-diasize-proc-name
     2590               ,input  'height':u
     2591               ,output v-resize-value-str
     2592               ) .
     2593             if v-resize-value-str <> '':U
     2594             then do:
     2595               run diasize_change-height in this-procedure
     2596                 (input  integer(v-resize-value-str)
     2597                 ,input  true
     2598                 ) .
     2599               assign
     2600                 v-restore-saved = true
     2601               .
     2602             end.
     2603           end.
     2604           if connected("ub") = true
     2605           then do:
     2606             run gbl/wndsizer.p
     2607               (input  v-cntxt-db-num
     2608               ,input  v-cntxt-userid
     2609               ,input  v-diasize-proc-name
     2610               ,input  'width':u
     2611               ,output v-resize-value-str
     2612               ) .
     2613             if v-resize-value-str <> '':U
     2614             then do:
     2615               run diasize_change-width in this-procedure
     2616                 (input  integer(v-resize-value-str)
     2617                 ,input  true
     2618                 ) .
     2619               assign
     2620                 v-restore-saved = true
     2621               .
     2622             end.
     2623           end.
     2624           if v-restore-saved <> true
     2625           then do:
     2626             if v-diasize-wndmax = true
     2627             then do:
     2628               run diasize_maximize in this-procedure
     2629                 (input  true
     2630                 ) .
     2631             end.
     2632           end.
     2633         end.
     2634         else do:
     2635           if v-diasize-wndmax = true
     2636           then do:
     2637             run diasize_maximize in this-procedure
     2638               (input  true
     2639               ) .
     2640           end.
     2641         end.
     2642       end.
     2643     end.
     2644   end procedure.
     2645   procedure diasize_need-full-display :
     2646     define output parameter p-need-full-display as logical   no-undo .
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       assign
     2651         p-need-full-display = v-diasize-need-full-display
     2652       .
     2653       assign
     2654         v-diasize-need-full-display = false
     2655       .
     2656     end.
     2657   end procedure.
     2658   procedure get-context :
     2659      define output parameter p-db-num as integer          no-undo.
     2660      define output parameter p-user-id as character        no-undo.
     2661      define variable v-login               as character    no-undo.
     2662      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2663      define buffer buf_user-login  for ub.user-login .
     2664      do
     2665      on error undo, return error
     2666      :
     2667            FIND FIRST buf_sys-ctrl no-lock.
     2668            ASSIGN
     2669               v-login = USERID("ub")
     2670               p-db-num = buf_sys-ctrl.db-num
     2671            .
     2672            FIND FIRST buf_user-login
     2673                 WHERE buf_user-login.db-num = p-db-num
     2674                   AND buf_user-login.user-login = v-login
     2675                 no-lock
     2676                 no-error
     2677                 .
     2678            IF AVAILABLE buf_user-login
     2679            THEN DO:
     2680               assign
     2681                  p-user-id = buf_user-login.user-id
     2682               .
     2683            END.
     2684      end.
     2685   end procedure.
     2686       run diasize_init in this-procedure .
     2687   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   on INS of frame Dialog-Frame anywhere do:
     2689     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2690     return no-apply.
     2691   end.
     2692   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2693   on F2 of frame Dialog-Frame anywhere do:
     2694     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2695     return no-apply.
     2696   end.
     2697   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   procedure set-filter-name :
     2699   define input parameter p-filter-name as character no-undo .
     2700     do with frame Dialog-Frame:
     2701       if p-filter-name > "" then do:
     2702         assign
     2703           frame Dialog-Frame:title
     2704             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2705         .
     2706         assign
     2707           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2708         .
     2709       end.
     2710       else do:
     2711         assign
     2712           b-sch :tooltip = ""
     2713         .
     2714       end.
     2715     end.
     2716   end procedure.
     2717   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2718   on ' ' of sch-date in frame Dialog-Frame
     2719   do:
     2720     if (can-query (self, "sensitive")
     2721        and
     2722        self :sensitive = true
     2723        )
     2724     or (can-query (self, "read-only")
     2725        and
     2726        self :read-only = false
     2727        )
     2728     then do:
     2729       assign
     2730         self :screen-value = ?
     2731       .
     2732     end.
     2733     return no-apply.
     2734   end.
     2735   on delete-character of sch-date in frame Dialog-Frame
     2736   do:
     2737     if (can-query (self, "sensitive")
     2738        and
     2739        self :sensitive = true
     2740        )
     2741     or (can-query (self, "read-only")
     2742        and
     2743        self :read-only = false
     2744        )
     2745     then do:
     2746       assign
     2747         self :screen-value = ?
     2748       .
     2749     end.
     2750     return no-apply.
     2751   end.
     2752   on ctrl-d of sch-date in frame Dialog-Frame
     2753   do:
     2754     define variable v-curr-sv-date as date no-undo .
     2755     if (can-query (self, "sensitive")
     2756        and
     2757        self :sensitive = true
     2758        )
     2759     or (can-query (self, "read-only")
     2760        and
     2761        self :read-only = false
     2762        )
     2763     then do:
     2764       if self :handle <> focus :handle
     2765       then do:
     2766         apply "entry":u to self .
     2767       end.
     2768       run gbl/getcurdt.p
     2769         (output v-curr-sv-date
     2770         ) .
     2771       assign
     2772         self :screen-value = string(v-curr-sv-date) .
     2773       .
     2774     end.
     2775     return no-apply.
     2776   end.
     2777   on ctrl-b of sch-date in frame Dialog-Frame
     2778   do:
     2779     if (can-query (self, "sensitive")
     2780        and
     2781        self :sensitive = true
     2782        )
     2783     or (can-query (self, "read-only")
     2784        and
     2785        self :read-only = false
     2786        )
     2787     then do:
     2788       if self :handle <> focus :handle
     2789       then do:
     2790         apply "entry":u to self .
     2791       end.
     2792       define variable v-curr-sv-date as date no-undo .
     2793       define variable v-new-sv-date  as date no-undo .
     2794       assign
     2795         v-curr-sv-date = date(self :screen-value) no-error
     2796       .
     2797       if v-curr-sv-date = ?
     2798       then do:
     2799         run gbl/getcurdt.p
     2800           (output v-curr-sv-date
     2801           ) .
     2802       end.
     2803       if v-curr-sv-date <> ?
     2804       then do:
     2805         assign
     2806           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2807         .
     2808         assign
     2809           self :screen-value = string(v-new-sv-date) .
     2810         .
     2811       end.
     2812     end.
     2813     return no-apply .
     2814   end.
     2815   on ctrl-e of sch-date in frame Dialog-Frame
     2816   do:
     2817     if (can-query (self, "sensitive")
     2818        and
     2819        self :sensitive = true
     2820        )
     2821     or (can-query (self, "read-only")
     2822        and
     2823        self :read-only = false
     2824        )
     2825     then do:
     2826       if self :handle <> focus :handle
     2827       then do:
     2828         apply "entry":u to self .
     2829       end.
     2830       define variable v-curr-sv-date as date no-undo .
     2831       define variable v-new-sv-date  as date no-undo .
     2832       assign
     2833         v-curr-sv-date = date(self :screen-value) no-error
     2834       .
     2835       if v-curr-sv-date = ?
     2836       then do:
     2837         run gbl/getcurdt.p
     2838           (output v-curr-sv-date
     2839           ) .
     2840       end.
     2841       if v-curr-sv-date <> ?
     2842       then do:
     2843         run gbl/lastdate.p
     2844           (input  v-curr-sv-date
     2845           ,output v-new-sv-date
     2846           ).
     2847         assign
     2848           self :screen-value = string(v-new-sv-date) .
     2849         .
     2850       end.
     2851     end.
     2852     return no-apply .
     2853   end.
     2854   on ctrl-f of sch-date in frame Dialog-Frame
     2855   do:
     2856     if (can-query (self, "sensitive")
     2857        and
     2858        self :sensitive = true
     2859        )
     2860     or (can-query (self, "read-only")
     2861        and
     2862        self :read-only = false
     2863        )
     2864     then do:
     2865       if self :handle <> focus :handle
     2866       then do:
     2867         apply "entry":u to self .
     2868       end.
     2869       define variable v-ok            as logical   no-undo .
     2870       define variable v-curr-sv-date  as date      no-undo .
     2871       define variable v-description   as character no-undo .
     2872       assign
     2873         v-curr-sv-date = date(self :screen-value) no-error
     2874       .
     2875       if v-curr-sv-date = ?
     2876       then do:
     2877         run gbl/getcurdt.p
     2878           (output v-curr-sv-date
     2879           ) .
     2880       end.
     2881       if v-curr-sv-date <> ?
     2882       then do:
     2883         run gbl/d-inpday.w
     2884           (input ?
     2885           ,input "Выбор даты"
     2886           ,input v-description
     2887           ,input ""
     2888           ,input-output v-curr-sv-date
     2889           ,output v-ok
     2890           ).
     2891         if v-ok = true
     2892         then do:
     2893           assign
     2894             self :screen-value = string(v-curr-sv-date) .
     2895           .
     2896         end.
     2897       end.
     2898     end.
     2899     return no-apply .
     2900   end.
     2901     define MENU m-ed-date23
     2902       MENU-ITEM m-ed-date23-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
