     2960       ,output v-cntxt-obj-code
     2961       ,output v-cntxt-db-num-obj
     2962       ,output v-cntxt-is-admin
     2963       ) .
     2964     if lookup(p-list-mode, 'объект':U + chr(44) + "charkey_one" + chr(44) + "trans-id-chr") = 0 THEN DO:
     2965       message vss-workfile vss-revision vss-description skip
     2966       "Неверный вызов - p-list-mode=" p-list-mode
