      401   define  stream PrnLibStream.
      402   procedure prn-lib-prn-file :
      403     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      404     define input parameter p-DIsabledoptions as integer no-undo .
      405     define variable v-report-name as character no-undo .
      406     define variable v-user-action as character no-undo .
      407     define variable v-printed     as logical   no-undo .
      408     define variable v-exist       as logical   no-undo .
      409     do
      410       on error undo, return error
      411       :
      412       run prn-lib-get-report-name  in this-procedure (
      413         input parParentProc
      414         ,output v-report-name
      415         ).
      416   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      418     (input  v-report-name
      419     ,input  2
      420     ,output v-exist
      421     )  .
      422       if NOT v-exist then
      423       DO:
      424         Message
      425           "Нет заданий на печать ! "
      426           view-as alert-box .
      427         Return  .
      428       End.
      429       run gbl/prnfilen.w
      430         (input  ""
      431         ,input  p-DisabledOptions
      432         ,input  string(v-report-name )
      433         ,input  7
      434         ,output v-user-action
      435         ,output v-printed
      436         ) .
      437       if v-printed then
      438       do:
      439         return "YES" .
      440       end.
      441       else
      442       do:
      443         return "NO" .
      444       end.
      445     end.
      446   end procedure.
      447   procedure prn-lib-open-stream :
      448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      449     define input parameter p-page-size    as integer no-undo .
      450     define input parameter p-is-stream    as logical no-undo .
      451     define input parameter p-append       as logical no-undo .
      452     define variable v-report-name as character no-undo .
      453     do
      454       on error undo, return error
      455       :
      456       run prn-lib-get-report-name  in this-procedure (
      457         input parParentProc
      458         ,output v-report-name
      459         ).
      460       if p-is-stream then
      461       do:
      462         if p-append then
      463         do:
      464           output stream PrnLibStream to value( v-report-name )
      465             page-size value(p-page-size) append .
      466         end.
      467         if not p-append then
      468         do:
      469           output stream PrnLibStream to value( v-report-name )
      470             page-size value(p-page-size) .
      471         end.
      472       end.
      473       if not p-is-stream then
      474       do:
      475         if p-append then
      476         do:
      477           output to value( v-report-name )
      478             page-size value(p-page-size) append .
      479         end.
      480         if not p-append then
      481         do:
      482           output to value( v-report-name )
      483             page-size value(p-page-size) .
      484         end.
      485       end.
      486     end.
      487   end procedure.
      488   procedure prn-lib-open-exp :
      489     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      490     define input parameter p-is-stream    as logical no-undo .
      491     define input parameter p-is-append    as logical no-undo .
      492     define output parameter p-ReportFileName as char init "report" no-undo.
      493     define output parameter p-process as logical no-undo .
      494     define variable glog as logical no-undo .
      495     do
      496       on error undo, return error
      497       :
      498       SYSTEM-DIALOG GET-FILE p-ReportFileName
      499         TITLE      "Укажите путь"
      500         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      501         ASK-OVERWRITE
      502         CREATE-TEST-FILE
      503         SAVE-AS
      504         USE-FILENAME
      505         DEFAULT-EXTENSION "txt"
      506         UPDATE glog
      507         .
      508       if not glog then  return.
      509       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      510       if p-is-stream then
      511       do:
      512         if p-is-append then
      513         do:
      514           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      515         end.
      516         else
      517         do:
      518           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      519         end.
      520       end.
      521       else
      522       do:
      523         if p-is-append then
      524         do:
      525           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      526         end.
      527         else
      528         do:
      529           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      530         end.
      531       end.
      532       p-process = yes.
      533     end.
      534   end procedure.
      535   procedure prn-lib-get-report-name :
      536     define input parameter parParentProc  as widget-handle no-undo.
      537     define output parameter p-report-name as character no-undo .
      538     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      539   end procedure.
      540   procedure prn-lib-reportviewer-report-name :
      541     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      542     define input parameter p-report-name-html as character no-undo .
      543     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      544   end procedure.
      545   procedure prn-lib-reportviewer :
      546     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      547     define input parameter p-report-name-html as character no-undo .
      548     define input parameter p-param        as character no-undo .
      549     define variable v-excel           as character no-undo init 'TRUE' .
      550     define variable v-value-character as character no-undo .
      551     define variable v-value-integer   as character no-undo .
      552     define variable v-value-date      as date      no-undo .
      553     define variable v-value-decimal   as decimal   no-undo .
      554     define variable rep-excel         as logical   no-undo .
      555     define variable excel-string      as character no-undo .
      556     define variable v-param-type      as character no-undo .
      557     define variable v-tth             as handle    no-undo .
      558     run adm/shattri.p (
      559       input "get":U
      560       ,input  ""
      561       ,input  0
      562       ,input  'report-glob':U
      563       ,input  'rep-excel':U
      564       ,output v-value-character
      565       ,output v-value-date
      566       ,output v-value-decimal
      567       ,output v-value-integer
      568       ,output rep-excel
      569       ,output v-param-type
      570       ,INPUT-OUTPUT table-handle v-tth
      571       )  .
      572     if rep-excel then v-excel = "TRUE" .
      573     else v-excel = "FALSE" .
      574     if p-param eq ""
      575     then
      576        p-param = "EXCEL:" + v-excel.
      577     else
      578        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      579     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      580   end procedure.
      581   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   procedure fltfield-clear :
      583     define output parameter loc-fld as character no-undo.
      584     define output parameter loc-lab as character no-undo .
      585     define output parameter loc-spr as character no-undo .
      586     define output parameter loc-dim as character no-undo .
      587     assign
      588       loc-fld = ""
      589       loc-lab = ""
      590       loc-spr = ""
      591       loc-dim = "0"
      592     .
      593   end procedure .
      594   procedure fltfield-add :
      595     define input        parameter par-fld as character no-undo.
      596     define input        parameter par-lab as character no-undo .
      597     define input        parameter par-spr as character no-undo .
      598     define input-output parameter loc-fld as character no-undo.
      599     define input-output parameter loc-lab as character no-undo .
      600     define input-output parameter loc-spr as character no-undo .
      601     define input-output parameter loc-dim as character no-undo .
      602     do
      603     on error undo, return error
      604     :
      605       assign
      606       loc-fld = if loc-dim = '0'
      607                 then par-fld
      608                 else (loc-fld + chr(44) + par-fld)
      609       loc-lab = if loc-dim = '0'
      610                 then par-lab
      611                 else (loc-lab + chr(44) + par-lab)
      612       loc-spr = if loc-dim = '0'
      613                 then par-spr
      614                 else (loc-spr + chr(44) + par-spr)
      615       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      616                 string(integer(if num-entries(loc-dim) > 1
      617                               then entry(2, loc-dim)
      618                               else entry(1, loc-dim)
      619                               ) + 1)
      620       no-error
      621       .
      622     end.
      623   end procedure.
      624   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   procedure cur-time :
      626      define output parameter p-today as date      no-undo .
      627      define output parameter p-time  as integer   no-undo .
      628     do
      629     on error undo, return error
      630     :
      631       define variable v-date1 as date      no-undo .
      632       define variable v-date2 as date      no-undo .
      633       define variable v-time  as integer   no-undo .
      634       assign
      635         v-date1 = today
      636         v-time  = time
      637         v-date2 = today
      638       .
      639       if v-date1 <> v-date2
      640       then do:
      641         assign
      642           v-date1 = today
      643           v-time  = v-time
      644         .
      645       end.
      646       assign
      647         p-today = v-date1
      648         p-time  = v-time
      649       .
      650     end.
      651   end.
      652   function cur-time-date returns character
      653   :
      654     return string(today, '99/99/9999':U) .
      655   end.
      656   function cur-time-mjd returns decimal
      657   :
      658     define variable v-date as date      no-undo .
      659     define variable v-time as integer   no-undo .
      660     run cur-time in this-procedure
      661       (output v-date
      662       ,output v-time
      663       ) .
      664     return integer(v-date) - 2400002 + (v-time / 86400) .
      665   end.
      666   function cur-time-get-ending-index returns integer
      667   (input p-number as integer
      668   )
      669   :
      670     if p-number < 0
      671     or p-number = ?
      672     then do:
      673       return 1 .
      674     end.
      675     define variable v-rest as integer   no-undo .
      676     assign
      677       p-number = p-number modulo 100
      678     .
      679     if p-number < 20
      680     then do:
      681       assign
      682         v-rest = p-number
      683       .
      684     end.
      685     else do:
      686       assign
      687         v-rest = p-number modulo 10
      688       .
      689     end.
      690     case v-rest :
      691       when 1
      692       then do:
      693         return 2 .
      694       end.
      695       when 2 or
      696       when 3 or
      697       when 4
      698       then do:
      699         return 3 .
      700       end.
      701       otherwise do:
      702         return 1 .
      703       end.
      704     end case .
      705   end.
      706   procedure cur-time-mjd-to-date :
      707      define input  parameter i-mjd-diff as decimal no-undo.
      708      define output parameter o-Date     as date    no-undo.
      709      define output parameter o-Time     as integer no-undo.
      710      define variable v-day-number as integer   no-undo .
      711      if    i-mjd-diff < 0
      712         or i-mjd-diff = ?
      713      then do:
      714         return "?" .
      715      end.
      716      assign
      717         v-day-number = truncate(i-mjd-diff,0).
      718         o-Date = date(v-day-number + 2400002).
      719         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      720     .
      721   end.
      722   function cur-time-mjd-to-string returns character
      723   (input p-mjd-diff as decimal
      724   )
      725   :
      726     define variable v-day-number as integer   no-undo .
      727     define variable v-seconds    as integer   no-undo .
      728     define variable v-hour       as integer   no-undo .
      729     define variable v-min        as integer   no-undo .
      730     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      731     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      732     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      733     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      734     if p-mjd-diff < 0
      735     or p-mjd-diff = ?
      736     then do:
      737       return "?" .
      738     end.
      739     assign
      740       v-day-number = integer(truncate(p-mjd-diff,0))
      741       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      742     .
      743     if v-seconds > 86400
      744     then do:
      745       assign
      746         v-seconds = 86400 - 1
      747       .
      748     end.
      749     if v-seconds < 0
      750     then do:
      751       assign
      752         v-seconds = 0
      753       .
      754     end.
      755     assign
      756       v-hour = truncate(v-seconds / 3600, 0)
      757     .
      758     assign
      759       v-seconds = v-seconds modulo 3600
      760     .
      761     assign
      762       v-min = truncate(v-seconds / 60, 0)
      763     .
      764     assign
      765       v-seconds = v-seconds modulo 60
      766     .
      767     return
      768         (if v-day-number <> 0
      769           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      770           else ""
      771         )
      772       + (if v-day-number <> 0 or v-hour <> 0
      773           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      774           else ""
      775         )
      776       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      777           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      778           else ""
      779         )
      780       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      781       .
      782   end.
      783   function cur-time-string returns character
      784   :
      785     define variable v-date as date      no-undo .
      786     define variable v-time as integer   no-undo .
      787     run cur-time in this-procedure
      788       (output v-date
      789       ,output v-time
      790       ) .
      791     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      792   end.
      793   function cur-time-string-sec returns character
      794   :
      795     define variable v-date as date      no-undo .
      796     define variable v-time as integer   no-undo .
      797     run cur-time in this-procedure
      798       (output v-date
      799       ,output v-time
      800       ) .
      801     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      802   end.
      803   function cur-time-custom  returns character
      804   (input p-prefix as character
      805   ,input p-date-format as character
      806   ,input p-delimiter as character
      807   ,input p-time-format as character
      808   ,input p-suffix as character
      809   )
      810   :
      811     define variable v-date as date      no-undo .
      812     define variable v-time as integer   no-undo .
      813     run cur-time in this-procedure
      814       (output v-date
      815       ,output v-time
      816       ) .
      817     return
      818       p-prefix
      819       + string(v-date, p-date-format)
      820       + p-delimiter
      821       + string(v-time, p-time-format)
      822       + p-suffix
      823       .
      824   end.
      825   function cur-time-print  returns character
      826   :
      827     define variable v-date as date      no-undo .
      828     define variable v-time as integer   no-undo .
      829     run cur-time in this-procedure
      830       (output v-date
      831       ,output v-time
      832       ) .
      833     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      834   end.
      835   function cur-time-datetime returns datetime
      836   :
      837     define variable v-char as character no-undo .
      838     define variable v-datetime as datetime no-undo .
      839     v-char = cur-time-string().
      840     v-datetime = datetime(v-char).
      841     return  v-datetime.
      842   end.
      843   function cur-time-string-msec returns character
      844   :
      845     define variable v-date as datetime  no-undo .
      846     v-date = now.
      847     return string(v-date) .
      848   end.
