        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as handle           no-undo.
        3   define input parameter p-fbr-doc-recid as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: fbr-lkp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/fbr-lkp.p $":U .
        9   define variable vss-description as character no-undo init "Просмотр документа производства".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   do
       80   on error undo, return error return-value
       81   :
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83     run mainmenu_getcntxt in parparentproc
       84       (output v-cntxt-db-num
       85       ,output v-cntxt-userid
       86       ,output v-cntxt-level
       87       ,output v-cntxt-host-code-obj
       88       ,output v-cntxt-obj-type
       89       ,output v-cntxt-obj-code
       90       ,output v-cntxt-db-num-obj
       91       ,output v-cntxt-is-admin
       92       ) .
       93       define variable v-new-fbr-doc-recid    as rowid        no-undo.
       94       define variable v-next-prev            as logical      no-undo.
       95       define variable v-ok as logical   no-undo .
       96       define buffer buf_fbr-doc for ub.fbr-doc .
       97       find buf_fbr-doc no-lock
       98           where recid(buf_fbr-doc) = p-fbr-doc-recid
       99           no-error.
      100       if available buf_fbr-doc
      101       then do:
      102   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   do:
      104     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      105       (input  v-cntxt-db-num
      106       ,input  v-cntxt-userid
      107       ,input  0
      108       ,input  'actn_manufacturing_lookup':U
      109       ,input  'object':U
      110       ,input  buf_fbr-doc.host-code
      111       ,input  buf_fbr-doc.obj-type
      112       ,input  buf_fbr-doc.obj-code
      113       ,input  0
      114       ,input  0
      115       ,input  0
      116       ,input  true
      117       ,output v-ok
      118       )  .
      119   end.
      120         if v-ok <> true
      121         then do:
      122                 return .
      123         end.
      124           define new shared variable br-handle as handle no-undo .
      125           define new shared buffer   f-doc     for fbr-doc .
      126           define new shared query    br-docs   for f-doc scrolling .
      127           open query br-docs for each f-doc no-lock
      128           where recid(f-doc) = recid(buf_fbr-doc).
      129           get first br-docs .
      130           run str/fbr-doc.w (
      131                 input parparentproc
      132               , input ?
      133               , input 'ПРОСМОТР':U
      134               , input p-fbr-doc-recid
      135               , output v-new-fbr-doc-recid
      136               , input-output v-next-prev
      137           ).
      138       end.
      139       else do:
      140           message
      141           vss-workfile vss-revision vss-description skip
      142           "Ошибка задания входных параметров" skip
      143           view-as alert-box error .
      144           undo, return error return-value .
      145       end.
      146   end.
