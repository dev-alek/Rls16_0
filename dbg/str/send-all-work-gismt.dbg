      613   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   DEFINE shared TEMP-TABLE thbjattr-list no-undo like ub.thbj-attr .
      615    define variable gismt-AdressPort   as character no-undo.
      616    define variable gismt-DopParam     as character no-undo.
      617    define variable gismt-GisAdress    as character no-undo.
      618    define variable gismt-ProxyLogin   as character no-undo.
      619    define variable gismt-ProxyPswd    as character no-undo.
      620    define variable gismt-MaxTime      as integer   no-undo.
      621    define variable gismt-RegKey       as character no-undo.
      622    define variable gismt-TimeFalStart as integer   no-undo.
      623    define variable gismt-WaitTime     as decimal   no-undo.
      624    define variable gismt-WaitTimePlus as decimal   no-undo.
      625    define variable gismt-CrashSituat  as logical   no-undo.
      626    define variable gismt-BanDate      as integer   no-undo.
      627    define variable gismt-cdnTurnOn    as logical   no-undo.
      628    define variable gismt-cdnAdress    as character no-undo.
      629    define variable gismt-cdnRepeat    as logical   no-undo.
      630    define variable gismt-cdnChange    as logical   no-undo.
      631    define variable gismt-cdnTimeUpd   as integer   no-undo.
      632    define variable gismt-UpdateRequest as logical   no-undo.
      633    define variable gismt-OflineAdress  as character no-undo.
      634    define variable gismt-OflineAutoriz as character no-undo.
      635    define variable gismt-OflineLogin   as character no-undo.
      636    define variable gismt-OflinePswd    as character no-undo.
      637    define variable gismt-OflineDate    as date      no-undo.
      638   function ConvBase64 return character
      639   (input iString as char):
      640     define variable vSize       as integer   no-undo.
      641     define variable vDataDc1    as memptr    no-undo.
      642     define variable vDataDc2    as memptr    no-undo.
      643     define variable vEnCode     as character no-undo.
      644     define variable vBase64Str  as character no-undo.
      645     do
      646     on error undo, return error return-value
      647     :
      648       if iString = ?
      649       then return "".
      650       vSize  = length(iString).
      651       SET-SIZE(vDataDc1 ) = vSize + 1.
      652       SET-SIZE(vDataDc2 ) = vSize.
      653       put-string(vDataDc1, 1, vSize) = iString.
      654       copy-lob from vDataDc1 starting at 1 for vSize to vDataDc2 no-convert.
      655       vEnCode =  base64-encode (vDataDc2).
      656       vBase64Str = substring(vEnCode,1).
      657       SET-SIZE(vDataDc1)  = 0 no-error.
      658       SET-SIZE(vDataDc2)  = 0 no-error.
      659     end.
      660     return vBase64Str.
      661   end.
      662   function get-thbj-attr-prop return character
      663   (input p-obj-type as char,
      664    input p-obj-code as int,
      665    input p-upper-prop-code as char,
      666    input p-prop-code as char
      667    ):
      668       define buffer buf_thbj-attr for ub.thbj-attr.
      669       define variable v-reg-code as integer no-undo.
      670       find first buf_thbj-attr no-lock where
      671                  buf_thbj-attr.obj-type = p-obj-type
      672              and buf_thbj-attr.obj-code = p-obj-code
      673              and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      674              and buf_thbj-attr.prop-code = p-prop-code
      675       no-error.
      676       if not available buf_thbj-attr and p-obj-type = 'БД':U then
      677       do:
      678   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   run regcode in ibs.th.gbl.gbl-hndllib:g#library
      680     (input  p-obj-type
      681     ,input  p-obj-code
      682     ,output v-reg-code
      683     )  .
      684          if v-reg-code <> ? and v-reg-code <> 0 then do:
      685              find first buf_thbj-attr no-lock where
      686                         buf_thbj-attr.obj-type = 'регион':U
      687                     and buf_thbj-attr.obj-code = v-reg-code
      688                     and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      689                     and buf_thbj-attr.prop-code = p-prop-code
      690              no-error.
      691          end.
      692       end.
      693       if not available buf_thbj-attr and p-obj-type <> ""
      694       then do:
      695          find first buf_thbj-attr no-lock where
      696                     buf_thbj-attr.obj-type = ""
      697                 and buf_thbj-attr.obj-code = 0
      698                 and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      699                 and buf_thbj-attr.prop-code = p-prop-code
      700          no-error.
      701       end.
      702       if avail buf_thbj-attr then do:
      703           case buf_thbj-attr.prop-value-type:
      704               when "character"
      705                  then return buf_thbj-attr.property-value-character.
      706               when "integer"
      707                  then return string(buf_thbj-attr.property-value-integer).
      708               when "decimal"
      709                  then return string(buf_thbj-attr.property-value-decimal).
      710               when "logical"
      711                  then return string(buf_thbj-attr.property-value-logical).
      712           end case.
      713       end.
      714       return "".
      715   end.
      716   function get-gismt-prop return character
      717   (input p-obj-type as char,
      718    input p-obj-code as int):
      719       define buffer buf_code for ub.code.
      720       define buffer buf_thbj-attr for ub.thbj-attr.
      721       assign
      722          gismt-AdressPort = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'adressPort':U)
      723          gismt-DopParam   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'dopParam':U)
      724          gismt-GisAdress  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'gisAdress':U)
      725          gismt-ProxyLogin = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'proxyLogin':U)
      726          gismt-ProxyPswd  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'proxyPswd':U)
      727          gismt-MaxTime    = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'maxTime':U))
      728          gismt-RegKey     = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'regKey':U)
      729          gismt-TimeFalStart = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'timeFalStart':U))
      730          gismt-WaitTime    = decimal(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'waitTime':U))
      731          gismt-CrashSituat = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'crashSituat':U))
      732          gismt-BanDate     = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'banDate':U))
      733          gismt-cdnTurnOn   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnTurnOn':U))
      734          gismt-cdnAdress   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnAdress':U)
      735          gismt-cdnRepeat   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnRepeat':U))
      736          gismt-cdnChange   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnChange':U))
      737          gismt-cdnTimeUpd  = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnTimeUpdate':U))
      738          gismt-UpdateRequest = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'UpdateRequest':U))
      739          gismt-OflineAdress  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflineAdress':U)
      740          gismt-OflineLogin   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflineLogin':U)
      741          gismt-OflinePswd    = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflinePswd':U)
      742          .
      743       if gismt-OflineLogin <> "" and gismt-OflinePswd <> ""
      744       then gismt-OflineAutoriz = ConvBase64(gismt-OflineLogin + ":" + gismt-OflinePswd).
      745       find first buf_code no-lock where
      746                  buf_code.parent eq "GisMtOffline"
      747              and buf_code.code   eq string(p-obj-code)
      748          no-error.
      749       if not avail buf_code then
      750       find first buf_code no-lock where
      751                  buf_code.parent eq "GisMtOffline"
      752              and buf_code.code   eq "0"
      753          no-error.
      754       if avail buf_code then  gismt-OflineDate = date(buf_code.CodeValue) no-error.
      755       else gismt-OflineDate = today.
      756     return "".
      757   end.
      758   function get-code-typemark return character
      759       (p-typemark as character):
      760           def buffer buf_code for ub.code.
      761      find first buf_code where
      762               buf_code.parent = "MarkType"
      763           and buf_code.CodeValue = p-typemark
      764          no-lock no-error.
      765      if avail buf_code then return buf_code.code.
      766      else return "".
      767   end.
      768   function get-list-code-typemark return character
      769       (p-list-typemark as character):
      770      def var vCount as int no-undo.
      771      def var vListCode as char no-undo.
      772      def var vCode as char no-undo.
      773      do vCount = 1 to num-entries(p-list-typemark):
      774         vCode = get-code-typemark(entry(vCount,p-list-typemark)).
      775         if vCode <> "" then vListCode = substitute("&1,&2",vListCode,int(vCode)).
      776      end.
      777      vListCode = substring(vListCode,2).
      778      return vListCode.
      779   end.
      780   procedure putc :
      781      define input parameter iSAXWriter as handle no-undo .
      782      define input parameter i-action   as character  no-undo .
      783      define input parameter p-value    as character  no-undo .
      784      define output parameter oSend      as logical    no-undo.
      785      define variable vTypesForKass as character no-undo.
      786      define variable vTimeDate as character no-undo.
      787      define buffer buf_code for ub.code.
      788      define buffer buf_thbj-attr for ub.thbj-attr.
      789      DEFINE BUFFER buf_sys-ctrl FOR ub.sys-ctrl .
      790      DEFINE VARIABLE vRetProp AS CHARACTER NO-UNDO.
      791      DEFINE VARIABLE vCdnAdr AS CHARACTER NO-UNDO.
      792      define variable vCount        as integer   no-undo.
      793      define variable vAll as logical no-undo.
      794      define variable vCheckBlock    as character no-undo.
      795      define variable vCheckDate     as character no-undo.
      796      define variable vCheckMRC      as character no-undo.
      797      define variable vCheckOwner    as character no-undo.
      798      define variable vCheckStatusKM as character no-undo.
      799      define variable vCheckTracking as character no-undo.
      800      define variable vMACC_Timeout  as decimal   no-undo.
      801      define variable vResp_TH_requiredr as integer no-undo.
      802      define variable vMACC_IP        as character no-undo.
      803      define variable vLmCHzPort      as character no-undo.
      804      define variable vTH_IP          as character no-undo.
      805      define variable vTH_Port        as character no-undo.
      806      define variable vAddTimeoutPIoT as decimal   no-undo.
      807      define variable vMaxApiToken    as character no-undo.
      808      define variable vAgeConfirm     as integer   no-undo.
      809      define variable v-reg-code      as integer   no-undo.
      810      assign
      811         vAll = yes
      812         vMACC_IP = ""
      813         vTH_IP = ""
      814         vTH_Port = ""
      815         vLmCHzPort = ""
      816         vMaxApiToken = ""
      817         mSend = no.
      818      .
      819   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   run regcode in ibs.th.gbl.gbl-hndllib:g#library
      821     (input  'БД':U
      822     ,input  mdb-num
      823     ,output v-reg-code
      824     )  .
      825      thlist:
      826      for each thbjattr-list :
      827        if vAll = yes then vAll = no.
      828          if    thbjattr-list.obj-type = 'регион':U
      829            and (thbjattr-list.obj-code <> v-reg-code
      830                 or can-find(first buf_thbj-attr no-lock where
      831                                   buf_thbj-attr.obj-type = 'БД':U
      832                               and buf_thbj-attr.obj-code = mdb-num
      833                               and buf_thbj-attr.upper-prop-code = thbjattr-list.upper-prop-code
      834                               and buf_thbj-attr.prop-code = thbjattr-list.prop-code)  )
      835             then next thlist.
      836          if thbjattr-list.upper-prop-code = 'gisMT':U
      837             and thbjattr-list.obj-type = ""
      838             and can-find(first buf_thbj-attr no-lock where
      839                                buf_thbj-attr.obj-type = 'регион':U
      840                            and buf_thbj-attr.obj-code = v-reg-code
      841                            and buf_thbj-attr.upper-prop-code = thbjattr-list.upper-prop-code
      842                            and buf_thbj-attr.prop-code = thbjattr-list.prop-code)
      843             then next thlist.
      844        find first buf_thbj-attr no-lock where
      845                  buf_thbj-attr.obj-type = thbjattr-list.obj-type
      846              and buf_thbj-attr.obj-code = thbjattr-list.obj-code
      847              and buf_thbj-attr.upper-prop-code = thbjattr-list.upper-prop-code
      848              and buf_thbj-attr.prop-code = thbjattr-list.prop-code
      849              no-error.
      850        if not avail buf_thbj-attr then next thlist.
      851        case buf_thbj-attr.prop-code:
      852           when 'checkBlock':U then do:
      853              run put-xml-data(iSAXWriter,"GS1","checkBlock",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки блокировок контролирующих органов").
      854           end.
      855           when 'checkDate':U then do:
      856              run put-xml-data(iSAXWriter,"GS1","checkDate",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки срока годности").
      857           end.
      858           when 'checkMRC':U then do:
      859              run put-xml-data(iSAXWriter,"GS1","checkMRC",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки МРЦ").
      860           end.
      861           when 'checkOwner':U then do:
      862              run put-xml-data(iSAXWriter,"GS1","checkOwner",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки владельца").
      863           end.
      864           when 'checkStatusKM':U then do:
      865              run put-xml-data(iSAXWriter,"GS1","checkStatusKM",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки статуса КМ").
      866           end.
      867           when 'checkTracking':U then do:
      868              run put-xml-data(iSAXWriter,"GS1","checkTracking",get-list-code-typemark(buf_thbj-attr.property-value-character),"Типы маркированной продукции для проверки флага прослеживаемости").
      869           end.
      870           when 'maxTime':U then do:
      871              run put-xml-data(iSAXWriter,"GS1","Max_allowed_time",string(buf_thbj-attr.property-value-integer),"Макс. допустимое время разрешения продажи при сбое онлайн проверки (часы)").
      872           end.
      873           when 'timeFalStart':U then do:
      874              run put-xml-data(iSAXWriter,"GS1","Failure_time",string(buf_thbj-attr.property-value-integer),"Время с момента сбоя до начала уведомления персонала (часы)").
      875           end.
      876           when 'crashSituat':U then do:
      877              run put-xml-data(iSAXWriter,"GS1","emergencyMode",(if buf_thbj-attr.property-value-logical then "1" else "0"),"Признак аварийной ситуации в ГИС МТ").
      878           end.
      879           when 'banDate':U then do:
      880              run put-xml-data(iSAXWriter,"GS1","Before_Expiration",string(buf_thbj-attr.property-value-integer),"Опережение срабатывания запрета по сроку годности в минутах").
      881           end.
      882           when 'adressPort':U then do:
      883               run put-xml-data(iSAXWriter,"GS1","Proxy_IP",buf_thbj-attr.property-value-character,"Адрес и порт прокси").
      884           end.
      885           when 'proxyLogin':U then do:
      886              run put-xml-data(iSAXWriter,"GS1","Proxy_Login",buf_thbj-attr.property-value-character,"Логин для подключения к прокси-серверу").
      887           end.
      888           when 'proxyPswd':U then do:
      889               run put-xml-data(iSAXWriter,"GS1","Proxy_Pass",buf_thbj-attr.property-value-character,"Пароль для подключения к прокси-серверу").
      890           end.
      891           when 'waitTime':U then do:
      892               run put-xml-data(iSAXWriter,"GS1","MACC_TimeoutGISMT",string(buf_thbj-attr.property-value-decimal),"Длительность ожидания ответа ТС ПИоТ").
      893           end.
      894           when 'MACC_Timeout':U then do:
      895              if buf_thbj-attr.property-value-decimal <> 0 then
      896                 run put-xml-data(iSAXWriter,"GS1","MACC_Timeout",string(buf_thbj-attr.property-value-decimal),"Длительность ожидания ответа ТН").
      897           end.
      898           when 'OflineLogin':U then do:
      899               run put-xml-data(iSAXWriter,"GS1","LmCHzLogin",buf_thbj-attr.property-value-character,"Логин для доступа ЛМ ЧЗ").
      900            END.
      901           when 'OflinePswd':U then do:
      902               run put-xml-data(iSAXWriter,"GS1","LmCHzPass",buf_thbj-attr.property-value-character,"Пароль для доступа ЛМ ЧЗ").
      903           end.
      904           when 'Resp_TH_required':U then do:
      905               run put-xml-data(iSAXWriter,"GS1","Resp_TH_required",string(buf_thbj-attr.property-value-integer),"Обязательность получения результатов проверки КМ в ТН").
      906           end.
      907           when 'TH_IP':U then vTH_IP = buf_thbj-attr.property-value-character.
      908           when 'TH_Port':U then vTH_Port = buf_thbj-attr.property-value-character.
      909           when 'LmCHzPort':U then vLmCHzPort = buf_thbj-attr.property-value-character.
      910           when 'AddTimeoutPIoT':U then do:
      911                run put-xml-data(iSAXWriter,"GS1","MACC_additionalTimeoutPIoT",string(buf_thbj-attr.property-value-decimal),"Длительность обработки ответа ГИС МТ в ТС ПИоТ").
      912           end.
      913           when 'MaxApiToken':U then do:
      914              run put-xml-data(iSAXWriter,"GS1","MaxApiToken",buf_thbj-attr.property-value-character,"Токен авторизации MAX").
      915           end.
      916           when 'AgeConfirm':U then do:
      917               run put-xml-data(iSAXWriter,"UiSettings","NeedUserSimpleAgeConfirm",buf_thbj-attr.property-value-integer,"Проверка возраста при продаже НП").
      918           end.
      919        end case.
      920      end.
      921      if not vAll then do:
      922          if vTH_IP = ? then vTH_IP = "".
      923          if vTH_Port = ? then vTH_Port = "".
      924          if vTH_IP = "" and vTH_Port <> "" then vTH_IP = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_IP':U).
      925          if vTH_IP <> "" and vTH_Port = "" then vTH_Port = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_Port':U).
      926          if vTH_IP <> "" and vTH_Port <> "" then vMACC_IP = substitute("&1:&2",vTH_IP,vTH_Port).
      927          if vMACC_IP <> "" then
      928            run put-xml-data(iSAXWriter,"GS1","MACC_IP",vMACC_IP,"Адрес и порт для отправки запроса проверки марки в ТН").
      929          IF vTH_IP = "" and vTH_Port = "" and vLmCHzPort <> ""
      930          then do:
      931              vTH_IP = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_IP':U).
      932              vTH_Port = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_Port':U).
      933              if vTH_IP <> "" and vTH_Port <> "" then vMACC_IP = substitute("&1:&2",vTH_IP,vTH_Port).
      934          end.
      935          if vMACC_IP <> "" and vLmCHzPort <> "" then
      936            run put-xml-data(iSAXWriter,"GS1","LmCHzPort",vLmCHzPort,"Порт для отправки запроса проверки марки в ЛМ ЧЗ ").
      937      end.
      938      else do:
      939         assign
      940           vCheckBlock     = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkBlock':U))
      941           vCheckDate      = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkDate':U))
      942           vCheckMRC       = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkMRC':U))
      943           vCheckOwner     = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkOwner':U))
      944           vCheckStatusKM  = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkStatusKM':U))
      945           vCheckTracking  = get-list-code-typemark(get-thbj-attr-prop(mObjType,mObjCode,'marking':U,'checkTracking':U))
      946           .
      947         vRetProp = get-gismt-prop ('БД':U, mdb-num) NO-ERROR.
      948         assign
      949           vMACC_TimeOut   = DEC(get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'MACC_Timeout':U))
      950           vResp_TH_requiredr = INT(get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'Resp_TH_required':U))
      951           vTH_IP = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_IP':U)
      952           vTH_Port = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'TH_Port':U)
      953           vLmCHzPort = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'LmCHzPort':U)
      954           vAddTimeoutPIoT = DEC(get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'AddTimeoutPIoT':U))
      955           vMaxApiToken = get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'MaxApiToken':U)
      956           vAgeConfirm = INT(get-thbj-attr-prop('БД':U,mdb-num,'gisMT':U,'AgeConfirm':U))
      957           no-error.
      958         if vTH_IP = ? then vTH_IP = "".
      959         if vTH_Port = ? then vTH_Port = "".
      960         if vLmCHzPort = ? then vLmCHzPort = "".
      961         if vMaxApiToken = ? then vMaxApiToken = "".
      962         if vTH_IP <> "" and vTH_Port <> "" then vMACC_IP = substitute("&1:&2",vTH_IP,vTH_Port).
      963         if vCheckBlock <> ? then
      964         run put-xml-data(iSAXWriter,"GS1","checkBlock",vCheckBlock,"Типы маркированной продукции для проверки блокировок контролирующих органов").
      965         if vCheckDate <> ? then
      966         run put-xml-data(iSAXWriter,"GS1","checkDate",vCheckDate,"Типы маркированной продукции для проверки срока годности").
      967         if vCheckMRC <> ? then
      968         run put-xml-data(iSAXWriter,"GS1","checkMRC",vCheckMRC,"Типы маркированной продукции для проверки МРЦ").
      969         if vCheckOwner <> ? then
      970         run put-xml-data(iSAXWriter,"GS1","checkOwner",vCheckOwner,"Типы маркированной продукции для проверки владельца").
      971         if vCheckStatusKM <> ? then
      972         run put-xml-data(iSAXWriter,"GS1","checkStatusKM",vCheckStatusKM,"Типы маркированной продукции для проверки статуса КМ").
      973         if vCheckTracking <> ? then
      974         run put-xml-data(iSAXWriter,"GS1","checkTracking",vCheckTracking,"Типы маркированной продукции для проверки флага прослеживаемости").
      975         if vMACC_IP <> "" and vMACC_IP <> ? then
      976            run put-xml-data(iSAXWriter,"GS1","MACC_IP",vMACC_IP,"Адрес и порт для отправки запроса проверки марки в ТН").
      977         if gismt-OflineLogin <> ? then
      978         run put-xml-data(iSAXWriter,"GS1","LmCHzLogin",gismt-OflineLogin,"Логин для доступа ЛМ ЧЗ").
      979         if gismt-OflinePswd <> ? then
      980         run put-xml-data(iSAXWriter,"GS1","LmCHzPass",gismt-OflinePswd,"Пароль для доступа ЛМ ЧЗ").
      981         if gismt-AdressPort <> ? then
      982         run put-xml-data(iSAXWriter,"GS1","Proxy_IP",gismt-AdressPort,"Адрес и порт прокси").
      983         if gismt-ProxyLogin <> ? then
      984         run put-xml-data(iSAXWriter,"GS1","Proxy_Login",gismt-ProxyLogin,"Логин для подключения к прокси-серверу").
      985         if gismt-ProxyPswd <> ? then
      986         run put-xml-data(iSAXWriter,"GS1","Proxy_Pass",gismt-ProxyPswd,"Пароль для подключения к прокси-серверу").
      987         if vMACC_IP <> "" and vLmCHzPort <> ""
      988            and vMACC_IP <> ? and vLmCHzPort <> ? then
      989            run put-xml-data(iSAXWriter,"GS1","LmCHzPort",vLmCHzPort,"Порт для отправки запроса проверки марки в ЛМ ЧЗ ").
      990         if gismt-WaitTime <> ? then
      991         run put-xml-data(iSAXWriter,"GS1","MACC_TimeoutGISMT",string(gismt-WaitTime),"Длительность ожидания на стороне ТС ПИоТ ответа от ГИС МТ").
      992         if vAddTimeoutPIoT <> ? then
      993         run put-xml-data(iSAXWriter,"GS1","MACC_additionalTimeoutPIoT",string(vAddTimeoutPIoT),"Длительность обработки ответа ГИС МТ в ТС ПИоТ").
      994         if gismt-BanDate <> ? then
      995         run put-xml-data(iSAXWriter,"GS1","Before_Expiration",string(gismt-BanDate),"Опережение срабатывания запрета по сроку годности в минутах").
      996         if gismt-MaxTime <> ? then
      997         run put-xml-data(iSAXWriter,"GS1","Max_allowed_time",string(gismt-MaxTime),"Макс. допустимое время разрешения продажи при сбое онлайн проверки (часы)").
      998         if gismt-TimeFalStart <> ? then
      999         run put-xml-data(iSAXWriter,"GS1","Failure_time",string(gismt-TimeFalStart),"Время с момента сбоя до начала уведомления персонала (часы)").
     1000         if gismt-CrashSituat <> ? then
     1001         run put-xml-data(iSAXWriter,"GS1","emergencyMode",(if gismt-CrashSituat then "1" else "0"),"Признак аварийной ситуации в ГИС МТ").
     1002         if vMACC_Timeout <> 0 and vMACC_Timeout <> ? then
     1003            run put-xml-data(iSAXWriter,"GS1","MACC_Timeout",string(vMACC_Timeout),"Длительность ожидания ответа ТН").
     1004         if vResp_TH_requiredr <> ? then
     1005         run put-xml-data(iSAXWriter,"GS1","Resp_TH_required",string(vResp_TH_requiredr),"Обязательность получения результатов проверки КМ в ТН").
     1006         run put-xml-data(iSAXWriter,"GS1","MaxApiToken",vMaxApiToken,"Токен авторизации MAX").
     1007         if vAgeConfirm <> ? then
     1008         run put-xml-data(iSAXWriter,"UiSettings","NeedUserSimpleAgeConfirm",string(vAgeConfirm),"Проверка возраста при продаже НП").
     1009      end.
     1010      for each thbjattr-list:
     1011          delete thbjattr-list.
     1012      end.
     1013      oSend = mSend.
     1014   end procedure.
     1015   procedure put-xml-data:
     1016       define input parameter iSAXWriter  as handle    no-undo .
     1017       define input parameter p-group     as character no-undo.
     1018       define input parameter p-prop-code as character no-undo.
     1019       define input parameter p-value     as character no-undo.
     1020       define input parameter p-discr     as character no-undo.
     1021       define buffer buf_code for ub.code.
     1022       find first buf_code no-lock where
     1023                  buf_code.parent = substitute("cash-param&1&2&1&3&1&4",chr(4),mDeviceKind,"1",p-group)
     1024              and buf_code.code  = p-prop-code
     1025         no-error.
     1026       if available buf_code
     1027       then do:
     1028           iSAXWriter:start-element("Param") .
     1029           iSAXWriter:insert-attribute("ctrl", "ADD").
     1030           iSAXWriter:insert-attribute("group", p-group).
     1031           iSAXWriter:insert-attribute("key", p-prop-code).
     1032           iSAXWriter:write-data-element("ParamValue" , p-value ) .
     1033           iSAXWriter:write-data-element("ParamDesc" , p-discr).
     1034           iSAXWriter:end-element("Param" ).
     1035           mSend = yes.
     1036       end.
     1037   end procedure.
     1038   procedure set-cash-info:
     1039      define input         parameter iDB-num        as integer     no-undo.
     1040      define input         parameter iObjType       as character   no-undo.
     1041      define input         parameter iObjCode       as integer     no-undo.
     1042      define input         parameter iPostType      as character   no-undo.
     1043      define input         parameter iCashNum       as integer     no-undo.
     1044      define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     1045      assign
     1046         mDB-num       = iDB-num
     1047         mObjType      = iObjType
     1048         mObjCode      = iObjCode
     1049         mPostType     = iPostType
     1050         mCashNum      = iCashNum
     1051      .
     1052      find first buf_cash-desk-attr no-lock
     1053          where buf_cash-desk-attr.db-num   = mDB-num
     1054            and buf_cash-desk-attr.obj-code = mObjCode
     1055            and buf_cash-desk-attr.pos-type = mPostType
     1056            and buf_cash-desk-attr.cash-num = mCashNum
     1057            and buf_cash-desk-attr.upper-attr-code = mPostType + "_operative":U
     1058            and buf_cash-desk-attr.attr-code       = "device-kind":U no-error .
     1059      if available buf_cash-desk-attr then
     1060          mDeviceKind = buf_cash-desk-attr.attr-value-integer .
     1061      else
     1062         mDeviceKind = 0 .
     1063   end.
     1064   procedure get-cash-types:
     1065      define output parameter otypes as character no-undo init "IBM-XML".
     1066   end.
     1067   procedure get-root-teg:
     1068      define output parameter otypes as character no-undo init "config".
     1069   end.
     1070   procedure get-xml-encoding:
     1071      define output parameter oEncoding as character no-undo init "UTF-8".
     1072   end.
     1073   procedure get-tag-from:
     1074      define output parameter oValue as character no-undo init "empty".
     1075   end.
     1076   procedure get-tag-to:
     1077      define output parameter oValue as character no-undo init "*".
     1078   end.
     1079   procedure Warning:
     1080     define input parameter ErrMessage as character no-undo.
     1081     message "The following WARNING was generated:~n" + ErrMessage
     1082          view-as alert-box info buttons ok.
     1083   end procedure.
     1084   procedure Error:
     1085     define input parameter ErrMessage as character no-undo.
     1086     message "The following NONFATAL ERROR was generated:~n" + ErrMessage
     1087          view-as alert-box info buttons ok.
     1088   end procedure.
     1089   procedure FatalError:
     1090     define input parameter ErrMessage as character no-undo.
     1091     return error "The following FATAL ERROR was generated:~n" + ErrMessage.
     1092   end procedure.
