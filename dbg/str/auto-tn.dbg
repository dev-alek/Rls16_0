        1   define input  parameter parparentproc as widget-handle no-undo.
        2   define input  parameter parbuttons  as character no-undo.
        3   define input  parameter par-obj-type as character no-undo.
        4   define input  parameter par-obj-code as integer no-undo.
        5   define output parameter parrec-tank as recid     no-undo.
        6   define output parameter parrec-meas as recid     no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Справочник автотранспорта".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#language as character no-undo .
      113   if g#language <> '' and g#language <> 'rus':U then do:
      114     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable c-point  as character no-undo .
      118   define variable tbl      as character no-undo .
      119   define variable join-tbl as character no-undo .
      120   define variable fld      as character no-undo .
      121   define variable lab      as character no-undo .
      122   define variable spr      as character no-undo .
      123   define variable dim      as character no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   procedure fltfield-clear :
      376     define output parameter loc-fld as character no-undo.
      377     define output parameter loc-lab as character no-undo .
      378     define output parameter loc-spr as character no-undo .
      379     define output parameter loc-dim as character no-undo .
      380     assign
      381       loc-fld = ""
      382       loc-lab = ""
      383       loc-spr = ""
      384       loc-dim = "0"
      385     .
      386   end procedure .
      387   procedure fltfield-add :
      388     define input        parameter par-fld as character no-undo.
      389     define input        parameter par-lab as character no-undo .
      390     define input        parameter par-spr as character no-undo .
      391     define input-output parameter loc-fld as character no-undo.
      392     define input-output parameter loc-lab as character no-undo .
      393     define input-output parameter loc-spr as character no-undo .
      394     define input-output parameter loc-dim as character no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       assign
      399       loc-fld = if loc-dim = '0'
      400                 then par-fld
      401                 else (loc-fld + chr(44) + par-fld)
      402       loc-lab = if loc-dim = '0'
      403                 then par-lab
      404                 else (loc-lab + chr(44) + par-lab)
      405       loc-spr = if loc-dim = '0'
      406                 then par-spr
      407                 else (loc-spr + chr(44) + par-spr)
      408       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      409                 string(integer(if num-entries(loc-dim) > 1
      410                               then entry(2, loc-dim)
      411                               else entry(1, loc-dim)
      412                               ) + 1)
      413       no-error
      414       .
      415     end.
      416   end procedure.
      417   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      419   procedure fltopend_fltopend :
      420   define input parameter p-parent-handle as handle no-undo .
      421   define input parameter p-qh as handle no-undo .
      422   define input parameter p-flt-open-open-query  as character no-undo .
      423   define input parameter p-where-cond as character no-undo .
      424   define input parameter p-use-indFIRST-query-tail as character no-undo .
      425   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      426   define input parameter p-indexed-reposition as character no-undo .
      427     do
      428     on error undo, return error
      429     :
      430   define variable v-prepare-string as character no-undo .
      431   define variable glog as logical no-undo .
      432   assign
      433   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      434                      p-where-cond + chr(32)  +
      435                      p-use-indFIRST-query-tail + chr(32) +
      436                      p-use-ind-sort-clmn-by + chr(32) +
      437                      p-indexed-reposition
      438   .
      439   assign
      440   glog = p-qh:query-prepare(v-prepare-string) no-error .
      441   if not glog
      442   or error-status:error then do:
      443     message error-status:get-message(1) view-as alert-box .
      444     undo, return error .
      445   end.
      446   assign
      447   glog = p-qh:query-open no-error .
      448   if not glog
      449   or error-status:error then do:
      450     message error-status:get-message(1) view-as alert-box .
      451     undo, return error .
      452   end.
      453     end.
      454   end procedure.
      455   procedure fltopend_fltfindd :
      456   define input parameter p-parent-handle as handle no-undo .
      457   define input parameter p-qh as handle no-undo .
      458   define input parameter p-rowid as rowid no-undo .
      459   define input parameter p-next as logical no-undo .
      460   define input parameter p-lock as integer no-undo .
      461   define input parameter p-bh as handle no-undo .
      462   define input parameter p-where-cond as character no-undo .
      463   define input parameter p-use-index-phrase as character no-undo .
      464   define variable glog as logical no-undo .
      465   define variable v-qh as handle no-undo .
      466   define variable v-bh as handle no-undo .
      467   define variable v-recid as recid no-undo .
      468   define variable v-prepare-string as character no-undo .
      469   do
      470   on error undo, return error
      471   on stop undo, return error
      472   :
      473     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      474     create buffer v-bh for table p-bh buffer-name p-bh:name.
      475     create query v-qh.
      476     v-qh:set-buffers(v-bh).
      477     v-prepare-string = substitute("for each &1 &2 &3"
      478                                     ,v-bh:name
      479                                     ,p-where-cond
      480                                     ,p-use-index-phrase).
      481     glog = v-qh:query-prepare(v-prepare-string) no-error.
      482     if not glog then do:
      483       delete object v-qh.
      484       delete object v-bh.
      485       undo, return error .
      486     end.
      487     glog = v-qh:query-open no-error .
      488     if not glog then do:
      489       delete object v-qh.
      490       delete object v-bh.
      491       undo, return error .
      492     end.
      493     if p-next then do:
      494       v-qh:reposition-to-rowid(p-rowid) no-error .
      495       glog = v-qh:get-next( p-lock) no-error .
      496       glog = v-qh:get-next( p-lock) no-error .
      497       if not glog or v-qh:query-off-end = yes then do:
      498         glog = v-qh:get-first( p-lock) no-error .
      499       end.
      500     end.
      501     else do:
      502       glog = v-qh:get-first( p-lock) no-error .
      503     end.
      504     v-recid = v-bh:recid no-error .
      505     delete object v-qh.
      506     delete object v-bh.
      507     return string(v-recid) .
      508   end.
      509   end procedure.
      510   procedure fltopend_fltfindq :
      511   define input parameter p-parent-handle as handle no-undo .
      512   define input parameter p-qh as handle no-undo .
      513   define input parameter p-next as logical no-undo .
      514   define input parameter p-lock as integer no-undo .
      515   define input parameter p-flt-open-open-query  as character no-undo .
      516   define input parameter p-where-cond as character no-undo .
      517   define input parameter p-use-indFIRST-query-tail as character no-undo .
      518   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      519   define input parameter p-indexed-reposition as character no-undo .
      520   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      521   define variable glog as logical no-undo .
      522   define variable v-qh as handle no-undo .
      523   define variable v-bh as handle no-undo extent 18.
      524   define variable v-rowid as rowid no-undo extent 18.
      525   define variable v-ii as integer no-undo .
      526   define variable v-prepare-string as character no-undo .
      527   do
      528   on error undo, return error
      529   on stop undo, return error
      530   :
      531     create query v-qh.
      532     do v-ii = 1 to p-qh:num-buffers:
      533       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      534       assign
      535       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      536       no-error.
      537       v-qh:add-buffer(v-bh[v-ii]).
      538     end.
      539     assign
      540     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      541                       p-where-cond + chr(32)  +
      542                       p-use-indFIRST-query-tail + chr(32) +
      543                       p-use-ind-sort-clmn-by + chr(32) +
      544                       p-indexed-reposition
      545     .
      546     glog = v-qh:query-prepare( v-prepare-string) no-error .
      547     if not glog then do:
      548       delete object v-qh.
      549       do v-ii = 1 to p-qh:num-buffers:
      550         delete object v-bh[v-ii].
      551       end.
      552       undo, return error .
      553     end.
      554     glog = v-qh:query-open no-error .
      555     if not glog then do:
      556       delete object v-qh.
      557       do v-ii = 1 to p-qh:num-buffers:
      558         delete object v-bh[v-ii].
      559       end.
      560       undo, return error .
      561     end.
      562     if p-next then do:
      563       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      564       glog = v-qh:get-next( p-lock) no-error .
      565       glog = v-qh:get-next( p-lock) no-error .
      566       if not glog or v-qh:query-off-end = yes then do:
      567         glog = v-qh:get-first( p-lock) no-error .
      568       end.
      569     end.
      570     else do:
      571       glog = v-qh:get-first( p-lock) no-error .
      572     end.
      573     do v-ii = 1 to p-qh:num-buffers:
      574       assign
      575       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      576       no-error.
      577     end.
      578     delete object v-qh.
      579     do v-ii = 1 to p-qh:num-buffers:
      580       delete object v-bh[v-ii].
      581     end.
      582   end.
      583   end procedure.
      584   define variable v-auto-firm as character no-undo format "x(14)":U.
      585   define variable varauto-tank-rec as recid no-undo.
      586   define variable tt-varauto-tank-rec as recid no-undo.
      587   define variable v-log as logical no-undo .
      588   define variable v-status_ like ub.auto-tank.status_ no-undo .
      589   define temp-table tt-auto-tank like ub.auto-tank .
      590   define buffer auto-tank-sec for ub.auto-tank .
      591   assign parrec-tank      = ?
      592          varauto-tank-rec = ?.
      593   FUNCTION get-auto-firm RETURNS CHARACTER
      594     ( BUFFER buf_auto-tank FOR tt-auto-tank )  FORWARD.
      595   DEFINE BUTTON b-add
      596        LABEL "&Добавить"
      597        SIZE 10 BY 1.
      598   DEFINE BUTTON b-chg
      599        LABEL "&Изменить"
      600        SIZE 10 BY 1.
      601   DEFINE BUTTON b-exit AUTO-END-KEY
      602        LABEL "&Выход"
      603        SIZE 10 BY 1
      604        BGCOLOR 8 .
      605   DEFINE BUTTON b-help
      606        LABEL "&Помощь"
      607        SIZE 10 BY 1
      608        BGCOLOR 8 .
      609   DEFINE BUTTON b-sel AUTO-GO
      610        LABEL "&Выбор"
      611        SIZE 10 BY 1.
      612   DEFINE BUTTON b-view
      613        LABEL "&Просмотр"
      614        SIZE 10 BY 1.
      615   DEFINE BUTTON b-del
      616        LABEL "&Удалить"
      617        SIZE 10 BY 1.
      618   DEFINE VARIABLE varps AS CHARACTER
      619        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      620        SIZE 87 BY 2.25
      621        BGCOLOR 8  DROP-TARGET NO-UNDO.
      622   DEFINE VARIABLE RS-status_ AS CHARACTER
      623        VIEW-AS RADIO-SET HORIZONTAL
      624        RADIO-BUTTONS
      625           "Item 1", "1",
      626           "Item 2", "2",
      627           "Item 3", "3"
      628        SIZE 33.5 BY 1 NO-UNDO.
      629   DEFINE VARIABLE f-search AS CHARACTER FORMAT "X(256)":U
      630        LABEL "Гос. номер"
      631        VIEW-AS FILL-IN
      632        SIZE 26 BY 1 NO-UNDO.
      633   DEFINE QUERY brw-auto-tank FOR
      634         tt-auto-tank SCROLLING.
      635   DEFINE BROWSE brw-auto-tank
      636     QUERY brw-auto-tank DISPLAY
      637         tt-auto-tank.auto-num FORMAT "X(20)":U Column-label "Гос.номер "
      638         tt-auto-tank.name FORMAT "X(40)":U Column-label "Марка"
      639         tt-auto-tank.brutto-qnty FORMAT "->>,>>>,>>9.<<<":U
      640         tt-auto-tank.status_ FORMAT "X(10)":U
      641       WITH NO-ROW-MARKERS SEPARATORS SIZE 87 BY 13.75.
      642   DEFINE FRAME Dialog-Frame
      643        b-exit AT ROW 1 COL 2
      644        b-sel AT ROW 1 COL 12
      645        b-add AT ROW 1 COL 22
      646        b-chg AT ROW 1 COL 32
      647        b-view AT ROW 1 COL 42
      648        b-del AT ROW 1 COL 52
      649        b-help AT ROW 1 COL 68
      650        RS-status_ AT ROW 2 COL 2 NO-LABEL
      651        f-search AT ROW 2 COL 51
      652        brw-auto-tank AT ROW 3.1 COL 2
      653        varps AT ROW 17 COL 2 NO-LABEL
      654        SPACE(0.87) SKIP(0.44)
      655       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      656            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      657            TITLE "Справочник автотранспорта"
      658            CANCEL-BUTTON b-exit.
      659   ASSIGN
      660          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      661          FRAME Dialog-Frame:HIDDEN           = TRUE.
      662   ASSIGN
      663          varps:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      664   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      665   DO:
      666     APPLY "END-ERROR":U TO SELF.
      667   END.
      668   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      669   DO:
      670     assign
      671       varauto-tank-rec = ?
      672     .
      673     run str/auto-tnc.w
      674       ( input parparentproc
      675        ,input 'ДОБАВЛЕНИЕ':U
      676        ,input-output varauto-tank-rec
      677       ) no-error.
      678     run local-enable_ui.
      679   END.
      680   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      681   DO:
      682     if available tt-auto-tank then do:
      683        for first ub.auto-tank no-lock where ub.auto-tank.auto-num = tt-auto-tank.auto-num :
      684       assign
      685         varauto-tank-rec = recid(ub.auto-tank).
      686        end.
      687       run str/auto-tnc.w
      688         (input parparentproc
      689          ,input 'ИЗМЕНЕНИЕ':U
      690          ,input-output varauto-tank-rec
      691         ) no-error.
      692       find first ub.auto-tank exclusive-lock where recid(ub.auto-tank) = varauto-tank-rec.
      693       run local-enable_ui.
      694     end.
      695     else do:
      696       message "Не выбран автотранспорт." view-as alert-box error.
      697     end.
      698   END.
      699   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      700   DO:
      701     if available tt-auto-tank then do:
      702        for first ub.auto-tank no-lock where ub.auto-tank.auto-num = tt-auto-tank.auto-num :
      703       assign
      704         parrec-tank = recid(ub.auto-tank).
      705        end.
      706     end.
      707   END.
      708   ON CHOOSE OF b-view IN FRAME Dialog-Frame
      709   DO:
      710     if available tt-auto-tank then do:
      711        for first ub.auto-tank no-lock where ub.auto-tank.auto-num = tt-auto-tank.auto-num :
      712       assign
      713         varauto-tank-rec = recid(ub.auto-tank).
      714        end.
      715       run str/auto-tnc.w (input parparentproc,input 'ПРОСМОТР':U, input-output varauto-tank-rec) no-error.
      716     end.
      717     else do:
      718       message "Не выбрана автотранспорт." view-as alert-box error.
      719     end.
      720   END.
      721   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      722   DO:
      723     if available tt-auto-tank then do:
      724       find current tt-auto-tank exclusive-lock.
      725       if tt-auto-tank.status_ = 'тек':U then do :
      726           message "Вы действительно хотите удалить автотранспорт?" view-as alert-box question buttons yes-no update v-log.
      727           if v-log then tt-auto-tank.status_ = 'удал':U .
      728           find first ub.auto-tank exclusive-lock where ub.auto-tank.auto-num = tt-auto-tank.auto-num no-error .
      729           if available (ub.auto-tank) then do:
      730           ub.auto-tank.status_ = 'удал':U .
      731           end.
      732       end.
      733       else do :
      734           message "Восстановить автотранспорт?" view-as alert-box question buttons yes-no update v-log.
      735           if v-log then tt-auto-tank.status_ = 'тек':U .
      736           find first ub.auto-tank exclusive-lock where ub.auto-tank.auto-num = tt-auto-tank.auto-num no-error .
      737           if available (ub.auto-tank) then do:
      738           ub.auto-tank.status_ = 'тек':U .
      739           end.
      740       end.
      741       run local-enable_ui.
      742     end.
      743     else do:
      744       message "Не выбрана автотранспорта." view-as alert-box error.
      745     end.
      746   END.
      747   ON VALUE-CHANGED OF RS-status_ IN FRAME Dialog-Frame
      748   DO:
      749     ASSIGN
      750     rs-status_
      751     v-status_ = rs-status_
      752     .
      753     run local-enable_UI .
      754     RUN openbr IN THIS-PROCEDURE NO-ERROR.
      755     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      756   END.
      757   ON return of f-search IN FRAME Dialog-Frame
      758   DO:
      759     assign f-search .
      760     RUN openbr IN THIS-PROCEDURE NO-ERROR.
      761     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      762   END.
      763   ON VALUE-CHANGED OF brw-auto-tank IN FRAME Dialog-Frame
      764   DO:
      765     if available tt-auto-tank then do:
      766       assign
      767         varps = tt-auto-tank.ps
      768       .
      769     end.
      770     else do:
      771       assign
      772         varps = "":U
      773       .
      774     end.
      775     display
      776       varps
      777       with frame Dialog-Frame
      778     .
      779   END.
      780   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      781   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   on help of frame Dialog-Frame
      784   do:
      785     run gbl/app_help.p
      786       (input this-procedure :file-name
      787       ,input ''
      788       ,input ?
      789       ) no-error.
      790     if error-status :error then do:
      791       message
      792         "Ошибка при вызове помощи"
      793         error-status :get-message(1)
      794         view-as alert-box .
      795     end.
      796   end.
      797   run minbtn-set in this-procedure .
      798   on choose of b-help in frame Dialog-Frame
      799   do:
      800     apply "help":u to frame Dialog-Frame .
      801   end.
      802   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   procedure minbtn-set :
      804       do
      805           on error undo, return error return-value
      806           :
      807           define variable ii              as integer       no-undo .
      808           define variable fh              as widget-handle no-undo .
      809           define variable hh              as widget-handle no-undo .
      810           define variable v-h             as handle        extent 4 no-undo .
      811           define variable v-name-button   as character     no-undo .
      812           define variable v-help-old-x    as decimal       no-undo .
      813           define variable v-help-old-y    as decimal       no-undo .
      814           define variable v-help-old-size as decimal       no-undo .
      815           define variable v-frame-width   as decimal       no-undo .
      816           define variable jj              as integer       no-undo .
      817           do
      818               on error undo, return error
      819               :
      820               assign
      821                   v-frame-width = frame Dialog-Frame:width - 0.3
      822                   fh            = frame Dialog-Frame:first-child
      823                   hh            = fh:first-child
      824                   ii            = 1
      825                   .
      826               do while valid-handle(hh):
      827                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      828                   do:
      829                       case lc(hh:name) :
      830                           when "b-help" then
      831                               do:
      832                                   hh:load-image-up("cmp/b-help.bmp":u) .
      833                                   hh:load-image-down("cmp/b-help.bmp":u) .
      834                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      835                                   hh:TOOLTIP = "Помощь" .
      836                                   v-help-old-x = hh:column .
      837                                   v-help-old-y = hh:row    .
      838                                   v-help-old-size = hh:width .
      839                                   hh:width-chars = 2.5 .
      840                               end.
      841                           when "b-print" then
      842                               do:
      843                                   hh:load-image("cmp/b-print.bmp":u) .
      844                                   hh:TOOLTIP = "Печать" .
      845                                   v-h[ii] = hh:handle .
      846                                   ii = ii + 1 .
      847                                   hh:width-chars = 3 .
      848                               end.
      849                           when "b-history" or
      850                           when "b-hist" then
      851                               do:
      852                                   hh:load-image("cmp/b-hist.bmp":u) .
      853                                   hh:TOOLTIP = "История" .
      854                                   v-h[ii] = hh:handle .
      855                                   ii = ii + 1 .
      856                                   hh:width-chars = 3 .
      857                               end.
      858                           when "b-sch" then
      859                               do:
      860                                   hh:load-image("cmp/b-sch.bmp":u) .
      861                                   hh:TOOLTIP = "Установка Фильтра" .
      862                                   v-h[ii] = hh:handle .
      863                                   ii = ii + 1 .
      864                                   hh:width-chars = 3 .
      865                               end.
      866                           when "b-hist-user" then
      867                               do:
      868                                   hh:load-image("cmp/b-hist.bmp":u) .
      869                                   hh:TOOLTIP = "История пользователя" .
      870                                   ii = ii + 1 .
      871                               end.
      872                       end case.
      873                   end.
      874                   hh = hh:next-sibling.
      875               end.
      876               b-help:column = v-frame-width - b-help:width-chars.
      877               jj = 0.
      878               repeat ii = 4 to 1 by -1 :
      879                   if valid-handle (v-h[ii] ) then
      880                   do:
      881                       jj  = jj + 1 .
      882                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      883                       v-h[ii]:row    = v-help-old-y .
      884                   end.
      885               end.
      886           end.
      887       end.
      888   end procedure.
      889   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      890   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      891   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      892   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      893   define variable v-diasize-current-frame-width  as decimal   no-undo .
      894   define variable v-diasize-current-frame-height as decimal   no-undo .
      895   define variable v-diasize-change-size          as logical   no-undo .
      896   define variable v-diasize-resize-button        as handle    no-undo .
      897   define variable v-diasize-wndmax               as logical   no-undo .
      898   define variable v-diasize-wndstore             as logical   no-undo .
      899   define variable v-diasize-proc-name            as character no-undo .
      900   define variable v-diasize-browse-handle        as handle    no-undo .
      901   define variable v-diasize-browse-number        as integer   no-undo .
      902   define variable v-diasize-need-full-display    as logical   no-undo init false .
      903   define temp-table temp-diasize-handle no-undo
      904     field handle-value  as handle
      905     field save-position as decimal
      906     index xpk is primary unique handle-value
      907     .
      908   define temp-table temp-browse-handle no-undo
      909     field browse-type   as character
      910     field browse-number as integer
      911     field browse-handle as handle
      912     field original-size as decimal
      913     index xpk is primary unique browse-type browse-number
      914     index xie browse-type browse-handle
      915   .
      916   procedure diasize_change-height :
      917     define input  parameter p-change-value  as decimal   no-undo .
      918     define input  parameter p-move-resize   as logical   no-undo .
      919     define variable v-field-group-handle    as handle    no-undo .
      920     define variable v-object-handle         as handle    no-undo .
      921     define variable v-frame-height          as decimal   no-undo .
      922     define variable v-frame-virtual-height  as decimal   no-undo .
      923     define variable v-browse-height         as decimal   no-undo .
      924     define variable v-window-height         as decimal   no-undo .
      925     define variable v-window-virtual-height as decimal   no-undo .
      926     define variable v-change-sign           as integer   no-undo .
      927     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      928     define buffer buf_temp-browse-handle  for temp-browse-handle .
      929     if p-change-value > 0
      930     then do:
      931       if frame Dialog-Frame :height + p-change-value
      932           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      933       then do:
      934         assign
      935           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      936                           - (frame Dialog-Frame :height-chars)
      937         .
      938         if p-change-value <= 0
      939         then do:
      940           run diasize_position-resize-button in this-procedure .
      941           return .
      942         end.
      943       end.
      944     end.
      945     if p-change-value < 0
      946     then do:
      947       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      948       then do:
      949         assign
      950           p-change-value = v-diasize-orig-frame-height
      951                          - (frame Dialog-Frame :height-chars)
      952         .
      953         if p-change-value >= 0
      954         then do:
      955           run diasize_position-resize-button in this-procedure .
      956           return .
      957         end.
      958       end.
      959     end.
      960     if p-change-value >= 0
      961     then do:
      962       assign
      963         v-change-sign = 1
      964       .
      965     end.
      966     else do:
      967       assign
      968         v-change-sign = -1
      969       .
      970     end.
      971     assign
      972       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      973     .
      974     if p-change-value = 0
      975     then do:
      976       run diasize_position-resize-button in this-procedure .
      977       return .
      978     end.
      979     move_block:
      980     do
      981     on error undo move_block, retry move_block
      982     :
      983       if retry
      984       then do:
      985         do
      986         on error undo move_block, leave move_block
      987         :
      988           if p-change-value > 0
      989           then do:
      990             for each buf_temp-diasize-handle
      991             on error undo, next
      992             :
      993               assign
      994                 v-object-handle = buf_temp-diasize-handle.handle-value
      995               .
      996               if v-object-handle <> v-diasize-resize-button
      997               then do:
      998                 assign
      999                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1000                 .
     1001               end.
     1002             end.
     1003             assign
     1004               v-diasize-browse-handle :height = v-browse-height
     1005             .
     1006             for each buf_temp-browse-handle
     1007               where buf_temp-browse-handle.browse-type = 'height':u
     1008             on error undo, next
     1009             :
     1010               assign
     1011                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1012               .
     1013             end.
     1014             assign
     1015               frame Dialog-Frame :height = v-frame-height
     1016             .
     1017             if frame Dialog-Frame :scrollable = true
     1018             then do:
     1019               assign
     1020                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1021               .
     1022             end.
     1023             run diasize_position-resize-button in this-procedure .
     1024           end.
     1025           else do:
     1026             if frame Dialog-Frame :scrollable = true
     1027             then do:
     1028               assign
     1029                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1030               .
     1031             end.
     1032             assign
     1033               frame Dialog-Frame :height = v-frame-height
     1034             .
     1035             assign
     1036               v-diasize-browse-handle :height = v-browse-height
     1037             .
     1038             for each buf_temp-browse-handle
     1039               where buf_temp-browse-handle.browse-type = 'height':u
     1040             on error undo, next
     1041             :
     1042               assign
     1043                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1044               .
     1045             end.
     1046             for each buf_temp-diasize-handle
     1047             on error undo, next
     1048             :
     1049               assign
     1050                 v-object-handle = buf_temp-diasize-handle.handle-value
     1051               .
     1052               if v-object-handle <> v-diasize-resize-button
     1053               then do:
     1054                 assign
     1055                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1056                 .
     1057               end.
     1058             end.
     1059             run diasize_position-resize-button in this-procedure .
     1060           end.
     1061           assign
     1062             v-diasize-change-size = false
     1063           .
     1064           leave move_block .
     1065         end.
     1066       end.
     1067       assign
     1068         v-diasize-need-full-display = true
     1069       .
     1070       if v-diasize-change-size = false
     1071       then do:
     1072         assign
     1073           v-diasize-change-size = true
     1074         .
     1075       end.
     1076       else do:
     1077         return .
     1078       end.
     1079       assign
     1080         v-frame-height = frame Dialog-Frame :height
     1081         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1082         v-browse-height = v-diasize-browse-handle :height
     1083       .
     1084       for each buf_temp-browse-handle
     1085         where buf_temp-browse-handle.browse-type = 'height':u
     1086       :
     1087         assign
     1088           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1089         .
     1090       end.
     1091       for each buf_temp-diasize-handle
     1092       :
     1093         delete buf_temp-diasize-handle .
     1094       end.
     1095       assign
     1096         v-field-group-handle = frame Dialog-Frame :first-child
     1097       .
     1098       do while valid-handle(v-field-group-handle)
     1099       :
     1100         assign
     1101           v-object-handle = v-field-group-handle :first-child
     1102         .
     1103         do while valid-handle(v-object-handle)
     1104         :
     1105           if  v-object-handle <> v-diasize-browse-handle :handle
     1106           and can-query(v-object-handle, "row")
     1107           and can-query(v-object-handle, "height")
     1108           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1109           then do:
     1110             find first buf_temp-browse-handle
     1111               where buf_temp-browse-handle.browse-type   = 'height':u
     1112                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1113               no-error .
     1114             if available buf_temp-browse-handle
     1115             then do:
     1116             end.
     1117             else do:
     1118               create buf_temp-diasize-handle .
     1119               assign
     1120                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1121                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1122               .
     1123             end.
     1124           end.
     1125           assign
     1126             v-object-handle = v-object-handle :next-sibling
     1127           .
     1128         end.
     1129         assign
     1130           v-field-group-handle = v-field-group-handle :next-sibling
     1131         .
     1132       end.
     1133       do with frame Dialog-Frame
     1134       :
     1135         hide v-diasize-resize-button .
     1136         assign
     1137           v-diasize-resize-button :row    = 1
     1138           v-diasize-resize-button :column = 1
     1139         .
     1140       end.
     1141       if p-change-value > 0
     1142       then do:
     1143         if frame Dialog-Frame :scrollable = true
     1144         then do:
     1145           assign
     1146             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1147             no-error .
     1148           if error-status :error
     1149           or error-status :get-message(1) <> ""
     1150           then do:
     1151             undo move_block, retry move_block .
     1152           end.
     1153         end.
     1154         assign
     1155           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1156           no-error .
     1157         if error-status :error
     1158         or error-status :get-message(1) <> ""
     1159         then do:
     1160           undo move_block, retry move_block .
     1161         end.
     1162         assign
     1163           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1164           no-error .
     1165         if error-status :error
     1166         or error-status :get-message(1) <> ""
     1167         then do:
     1168           undo move_block, retry move_block .
     1169         end.
     1170         for each buf_temp-browse-handle
     1171           where buf_temp-browse-handle.browse-type = 'height':u
     1172         on error undo move_block, retry move_block
     1173         :
     1174           assign
     1175             buf_temp-browse-handle.browse-handle :height
     1176               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1177             no-error .
     1178           if error-status :error
     1179           or error-status :get-message(1) <> ""
     1180           then do:
     1181             undo move_block, retry move_block .
     1182           end.
     1183         end.
     1184         for each buf_temp-diasize-handle
     1185         on error undo move_block, retry move_block
     1186         :
     1187           assign
     1188             v-object-handle = buf_temp-diasize-handle.handle-value
     1189           .
     1190           if v-object-handle <> v-diasize-resize-button
     1191           then do:
     1192             assign
     1193               v-object-handle :row = v-object-handle :row + p-change-value
     1194               no-error .
     1195             if error-status :error
     1196             or error-status :get-message(1) <> ""
     1197             then do:
     1198               undo move_block, retry move_block .
     1199             end.
     1200           end.
     1201         end.
     1202       end.
     1203       else do:
     1204         for each buf_temp-diasize-handle
     1205         on error undo move_block, retry move_block
     1206         :
     1207           assign
     1208             v-object-handle = buf_temp-diasize-handle.handle-value
     1209           .
     1210           if v-object-handle <> v-diasize-resize-button
     1211           then do:
     1212             assign
     1213               v-object-handle :row = v-object-handle :row + p-change-value
     1214               no-error .
     1215             if error-status :error
     1216             or error-status :get-message(1) <> ""
     1217             then do:
     1218               undo move_block, retry move_block .
     1219             end.
     1220           end.
     1221         end.
     1222         assign
     1223           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1224           no-error .
     1225         if error-status :error
     1226         or error-status :get-message(1) <> ""
     1227         then do:
     1228           undo move_block, retry move_block .
     1229         end.
     1230         for each buf_temp-browse-handle
     1231           where buf_temp-browse-handle.browse-type = 'height':u
     1232         on error undo move_block, retry move_block
     1233         :
     1234           assign
     1235             buf_temp-browse-handle.browse-handle :height
     1236               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1237             no-error .
     1238           if error-status :error
     1239           or error-status :get-message(1) <> ""
     1240           then do:
     1241             undo move_block, retry move_block .
     1242           end.
     1243         end.
     1244         assign
     1245           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1246           no-error .
     1247         if error-status :error
     1248         or error-status :get-message(1) <> ""
     1249         then do:
     1250           undo move_block, retry move_block .
     1251         end.
     1252         if frame Dialog-Frame :scrollable = true
     1253         then do:
     1254           assign
     1255             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1256             no-error .
     1257           if error-status :error
     1258           or error-status :get-message(1) <> ""
     1259           then do:
     1260             undo move_block, retry move_block .
     1261           end.
     1262         end.
     1263       end.
     1264       if p-move-resize = true
     1265       then do:
     1266         run diasize_position-resize-button in this-procedure .
     1267       end.
     1268       if v-diasize-wndstore = true
     1269       then do:
     1270         if connected("ub") = true
     1271         then do:
     1272           define variable v-cntxt-db-num        as integer   no-undo .
     1273           define variable v-cntxt-userid        as character no-undo .
     1274           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1275                                             , OUTPUT v-cntxt-userid
     1276                                             ) .
     1277           run gbl/wndsizew.p
     1278             (input  v-cntxt-db-num
     1279             ,input  v-cntxt-userid
     1280             ,input  v-diasize-proc-name
     1281             ,input  'height':u
     1282             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1283             ) .
     1284         end.
     1285       end.
     1286     end.
     1287     assign
     1288       v-diasize-change-size = false
     1289     .
     1290   end procedure.
     1291   procedure diasize_set-height :
     1292     define input  parameter p-new-height  as decimal   no-undo .
     1293     define input  parameter p-move-resize as logical   no-undo .
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       run diasize_change-height in this-procedure
     1298         (input  (p-new-height - frame Dialog-Frame :height)
     1299         ,input  p-move-resize
     1300         ) .
     1301     end.
     1302   end procedure.
     1303   procedure diasize_change-width :
     1304     define input  parameter p-change-value as decimal   no-undo .
     1305     define input  parameter p-move-resize  as logical   no-undo .
     1306     define variable v-field-group-handle   as handle    no-undo .
     1307     define variable v-object-handle        as handle    no-undo .
     1308     define variable v-frame-width          as decimal   no-undo .
     1309     define variable v-frame-virtual-width  as decimal   no-undo .
     1310     define variable v-browse-width         as decimal   no-undo .
     1311     define variable v-window-width         as decimal   no-undo .
     1312     define variable v-window-virtual-width as decimal   no-undo .
     1313     define variable v-change-sign          as integer   no-undo .
     1314     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1315     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1316     if p-change-value > 0
     1317     then do:
     1318       if frame Dialog-Frame :width + p-change-value >
     1319           session :width-chars
     1320       then do:
     1321         assign
     1322           p-change-value = session :width-chars - frame Dialog-Frame :width
     1323         .
     1324         if p-change-value <= 0
     1325         then do:
     1326           run diasize_position-resize-button in this-procedure .
     1327           return .
     1328         end.
     1329       end.
     1330     end.
     1331     if p-change-value < 0
     1332     then do:
     1333       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1334       then do:
     1335         assign
     1336           p-change-value = v-diasize-orig-frame-width
     1337                          - frame Dialog-Frame :width
     1338         .
     1339         if p-change-value >= 0
     1340         then do:
     1341           run diasize_position-resize-button in this-procedure .
     1342           return .
     1343         end.
     1344       end.
     1345     end.
     1346     if p-change-value >= 0
     1347     then do:
     1348       assign
     1349         v-change-sign = 1
     1350       .
     1351     end.
     1352     else do:
     1353       assign
     1354         v-change-sign = -1
     1355       .
     1356     end.
     1357     assign
     1358       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1359     .
     1360     if p-change-value = 0
     1361     then do:
     1362       run diasize_position-resize-button in this-procedure .
     1363       return .
     1364     end.
     1365     move_block:
     1366     do
     1367     on error undo move_block, leave move_block
     1368     :
     1369       if retry
     1370       then do:
     1371         do
     1372         on error undo move_block, leave move_block
     1373         :
     1374           if p-change-value > 0
     1375           then do:
     1376             for each buf_temp-diasize-handle
     1377             on error undo, next
     1378             :
     1379               assign
     1380                 v-object-handle = buf_temp-diasize-handle.handle-value
     1381               .
     1382               if v-object-handle <> v-diasize-resize-button
     1383               then do:
     1384                 assign
     1385                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1386                 .
     1387               end.
     1388             end.
     1389             assign
     1390               v-diasize-browse-handle :width = v-browse-width
     1391             .
     1392             for each buf_temp-browse-handle
     1393               where buf_temp-browse-handle.browse-type = 'width':u
     1394             on error undo, next
     1395             :
     1396               assign
     1397                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1398               .
     1399             end.
     1400             assign
     1401               frame Dialog-Frame :width = v-frame-width
     1402             .
     1403             if frame Dialog-Frame :scrollable = true
     1404             then do:
     1405               assign
     1406                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1407               .
     1408             end.
     1409             run diasize_position-resize-button in this-procedure .
     1410           end.
     1411           else do:
     1412             if frame Dialog-Frame :scrollable = true
     1413             then do:
     1414               assign
     1415                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1416               .
     1417             end.
     1418             assign
     1419               frame Dialog-Frame :width = v-frame-width
     1420             .
     1421             for each buf_temp-browse-handle
     1422               where buf_temp-browse-handle.browse-type = 'width':u
     1423             on error undo, next
     1424             :
     1425               assign
     1426                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1427               .
     1428             end.
     1429             assign
     1430               v-diasize-browse-handle :width = v-browse-width
     1431             .
     1432             for each buf_temp-diasize-handle
     1433             on error undo, next
     1434             :
     1435               assign
     1436                 v-object-handle = buf_temp-diasize-handle.handle-value
     1437               .
     1438               if v-object-handle <> v-diasize-resize-button
     1439               then do:
     1440                 assign
     1441                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1442                 .
     1443               end.
     1444             end.
     1445             run diasize_position-resize-button in this-procedure .
     1446           end.
     1447           assign
     1448             v-diasize-change-size = false
     1449           .
     1450           leave move_block .
     1451         end.
     1452       end.
     1453       assign
     1454         v-diasize-need-full-display = true
     1455       .
     1456       if v-diasize-change-size = false
     1457       then do:
     1458         assign
     1459           v-diasize-change-size = true
     1460         .
     1461       end.
     1462       else do:
     1463         return .
     1464       end.
     1465       assign
     1466         v-frame-width = frame Dialog-Frame :width
     1467         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1468         v-browse-width = v-diasize-browse-handle :width
     1469       .
     1470       for each buf_temp-browse-handle
     1471         where buf_temp-browse-handle.browse-type = 'width':u
     1472       :
     1473         assign
     1474           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1475         .
     1476       end.
     1477       for each buf_temp-diasize-handle
     1478       :
     1479         delete buf_temp-diasize-handle .
     1480       end.
     1481       assign
     1482         v-field-group-handle = frame Dialog-Frame :first-child
     1483       .
     1484       do while valid-handle(v-field-group-handle)
     1485       :
     1486         assign
     1487           v-object-handle = v-field-group-handle :first-child
     1488         .
     1489         do while valid-handle(v-object-handle)
     1490         :
     1491           if  v-object-handle <> v-diasize-browse-handle :handle
     1492           and v-object-handle <> v-diasize-resize-button
     1493           and can-query(v-object-handle, "row")
     1494           and can-query(v-object-handle, "height")
     1495           and ( v-object-handle :col + v-object-handle :width
     1496                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1497               )
     1498           then do:
     1499             find first buf_temp-browse-handle
     1500               where buf_temp-browse-handle.browse-type   = 'width':u
     1501                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1502               no-error .
     1503             if available buf_temp-browse-handle
     1504             then do:
     1505             end.
     1506             else do:
     1507               create buf_temp-diasize-handle .
     1508               assign
     1509                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1510                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1511               .
     1512             end.
     1513           end.
     1514           assign
     1515             v-object-handle = v-object-handle :next-sibling
     1516           .
     1517         end.
     1518         assign
     1519           v-field-group-handle = v-field-group-handle :next-sibling
     1520         .
     1521       end.
     1522       do with frame Dialog-Frame
     1523       :
     1524         hide v-diasize-resize-button .
     1525         v-diasize-resize-button :row = 1.
     1526         v-diasize-resize-button :column = 1.
     1527       end.
     1528       if p-change-value > 0
     1529       then do:
     1530         if frame Dialog-Frame :scrollable = true
     1531         then do:
     1532           assign
     1533             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1534             no-error .
     1535           if error-status :error
     1536           or error-status :get-message(1) <> ""
     1537           then do:
     1538             undo move_block, retry move_block.
     1539           end.
     1540         end.
     1541         assign
     1542           frame Dialog-Frame :width = v-frame-width + p-change-value
     1543           no-error .
     1544         if error-status :error
     1545         or error-status :get-message(1) <> ""
     1546         then do:
     1547           undo move_block, retry move_block.
     1548         end.
     1549         assign
     1550           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1551         no-error .
     1552         if error-status :error
     1553         or error-status :get-message(1) <> ""
     1554         then do:
     1555           undo move_block, retry move_block.
     1556         end.
     1557         for each buf_temp-browse-handle
     1558           where buf_temp-browse-handle.browse-type = 'width':u
     1559         on error undo move_block, retry move_block
     1560         :
     1561           assign
     1562             buf_temp-browse-handle.browse-handle :width
     1563               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1564             no-error .
     1565           if error-status :error
     1566           or error-status :get-message(1) <> ""
     1567           then do:
     1568             undo move_block, retry move_block .
     1569           end.
     1570         end.
     1571         for each buf_temp-diasize-handle
     1572         on error undo move_block, retry move_block
     1573         :
     1574           assign
     1575             v-object-handle = buf_temp-diasize-handle.handle-value
     1576           .
     1577           if v-object-handle <> v-diasize-resize-button
     1578           then do:
     1579             assign
     1580               v-object-handle :col = v-object-handle :col + p-change-value
     1581               no-error .
     1582             if error-status :error
     1583             or error-status :get-message(1) <> ""
     1584             then do:
     1585               undo move_block, retry move_block .
     1586             end.
     1587           end.
     1588         end.
     1589       end.
     1590       else do:
     1591         for each buf_temp-diasize-handle
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             v-object-handle = buf_temp-diasize-handle.handle-value
     1596           .
     1597           if v-object-handle <> v-diasize-resize-button
     1598           then do:
     1599             assign
     1600               v-object-handle :col = v-object-handle :col + p-change-value
     1601               no-error .
     1602             if error-status :error
     1603             or error-status :get-message(1) <> ""
     1604             then do:
     1605               undo move_block, retry move_block .
     1606             end.
     1607           end.
     1608         end.
     1609         for each buf_temp-browse-handle
     1610           where buf_temp-browse-handle.browse-type = 'width':u
     1611         on error undo move_block, retry move_block
     1612         :
     1613           assign
     1614             buf_temp-browse-handle.browse-handle :width
     1615               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1616             no-error .
     1617           if error-status :error
     1618           or error-status :get-message(1) <> ""
     1619           then do:
     1620             undo move_block, retry move_block .
     1621           end.
     1622         end.
     1623         assign
     1624           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1625           no-error .
     1626         if error-status :error
     1627         or error-status :get-message(1) <> ""
     1628         then do:
     1629           undo move_block, retry move_block.
     1630         end.
     1631         assign
     1632           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1633         no-error .
     1634         if error-status :error
     1635         or error-status :get-message(1) <> ""
     1636         then do:
     1637           undo move_block, retry move_block.
     1638         end.
     1639         if frame Dialog-Frame :scrollable = true
     1640         then do:
     1641           assign
     1642             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1643           no-error .
     1644           if error-status :error
     1645           or error-status :get-message(1) <> ""
     1646           then do:
     1647             undo move_block, retry move_block.
     1648           end.
     1649         end.
     1650       end.
     1651       if p-move-resize
     1652       then do:
     1653         run diasize_position-resize-button in this-procedure .
     1654       end.
     1655       if v-diasize-wndstore = true
     1656       then do:
     1657         if connected("ub") = true
     1658         then do:
     1659           define variable v-cntxt-db-num        as integer   no-undo .
     1660           define variable v-cntxt-userid        as character no-undo .
     1661           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1662                                             , OUTPUT v-cntxt-userid
     1663                                             ) .
     1664           run gbl/wndsizew.p
     1665             (input  v-cntxt-db-num
     1666             ,input  v-cntxt-userid
     1667             ,input  v-diasize-proc-name
     1668             ,input  'width':u
     1669             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1670             ) .
     1671         end.
     1672       end.
     1673     end.
     1674     assign
     1675       v-diasize-change-size = false
     1676     .
     1677   end procedure.
     1678   procedure diasize_set-width :
     1679     define input  parameter p-new-width  as decimal   no-undo .
     1680     define input  parameter p-move-resize as logical   no-undo .
     1681     do
     1682     on error undo, return error return-value
     1683     :
     1684       run diasize_change-width in this-procedure
     1685         (input  (p-new-width - frame Dialog-Frame :width)
     1686         ,input  p-move-resize
     1687         ) .
     1688     end.
     1689   end procedure.
     1690   procedure diasize_position-resize-button :
     1691     do with frame Dialog-Frame
     1692     :
     1693       hide v-diasize-resize-button .
     1694       assign
     1695         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1696                     - 1
     1697                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1698         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1699                     - 1
     1700                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1701       .
     1702       view v-diasize-resize-button .
     1703     end.
     1704   end procedure.
     1705   on alt-right anywhere
     1706   do:
     1707     run diasize_change-width in this-procedure
     1708       (input 1
     1709       ,input true
     1710       ) .
     1711     return no-apply .
     1712   end.
     1713   on alt-left anywhere
     1714   do:
     1715     run diasize_change-width in this-procedure
     1716       (input -1
     1717       ,input true
     1718       ) .
     1719     return no-apply .
     1720   end.
     1721   on alt-down anywhere
     1722   do:
     1723     run diasize_change-height in this-procedure
     1724       (input 1
     1725       ,input true
     1726       ) .
     1727     return no-apply .
     1728   end.
     1729   on alt-up anywhere
     1730   do:
     1731     run diasize_change-height in this-procedure
     1732       (input -1
     1733       ,input true
     1734       ) .
     1735     return no-apply .
     1736   end.
     1737   on alt-enter of frame Dialog-Frame
     1738   do:
     1739     run diasize_maximize in this-procedure
     1740       (input  ?
     1741       ).
     1742     return no-apply .
     1743   end.
     1744   procedure diasize_end-move :
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       define variable v-row-delta as decimal   no-undo .
     1749       define variable v-col-delta as decimal   no-undo .
     1750       define variable v-new-row as decimal   no-undo .
     1751       define variable v-new-col as decimal   no-undo .
     1752       assign
     1753         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1754         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1755       .
     1756       assign
     1757         v-row-delta = v-new-row - frame Dialog-Frame :height
     1758         v-col-delta = v-new-col - frame Dialog-Frame :width
     1759       .
     1760       run diasize_change-height in this-procedure
     1761         (input v-row-delta
     1762         ,input true
     1763         ) .
     1764       run diasize_change-width in this-procedure
     1765         (input v-col-delta
     1766         ,input true
     1767         ) .
     1768     end.
     1769   end procedure.
     1770   procedure diasize_maximize :
     1771     define input  parameter p-action as logical   no-undo .
     1772     do
     1773     on error undo, return error return-value
     1774     :
     1775       if p-action = ?
     1776       then do:
     1777         if v-diasize-need-maximize = true
     1778         then do:
     1779           assign
     1780             p-action = true
     1781           .
     1782         end.
     1783         else do:
     1784           assign
     1785             p-action = false
     1786           .
     1787         end.
     1788       end.
     1789       if p-action = true
     1790       then do:
     1791         run diasize_change-height in this-procedure
     1792           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1793               - frame Dialog-Frame :height-chars
     1794           ,input true
     1795           ) .
     1796         run diasize_change-width in this-procedure
     1797           (input session :width-chars
     1798               - frame Dialog-Frame :width-chars
     1799           ,input true
     1800           ) .
     1801         assign
     1802           v-diasize-need-maximize = false
     1803         .
     1804       end.
     1805       else do:
     1806         run diasize_change-width in this-procedure
     1807           (input v-diasize-orig-frame-width
     1808               - frame Dialog-Frame :width-chars
     1809           ,input true
     1810           ) .
     1811         run diasize_change-height in this-procedure
     1812           (input v-diasize-orig-frame-height
     1813               - frame Dialog-Frame :height-chars
     1814           ,input true
     1815           ) .
     1816         assign
     1817           v-diasize-need-maximize = true
     1818         .
     1819       end.
     1820     end.
     1821   end procedure.
     1822   procedure diasize_restore-orig-size :
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       assign
     1827         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1828         v-diasize-current-frame-height = frame Dialog-Frame :height
     1829       .
     1830       run diasize_set-height in this-procedure
     1831         (input  v-diasize-orig-frame-height
     1832         ,input  true
     1833         ) .
     1834       run diasize_set-width in this-procedure
     1835         (input  v-diasize-orig-frame-width
     1836         ,input  true
     1837         ) .
     1838     end.
     1839   end procedure.
     1840   procedure diasize_restore-current-size :
     1841     do
     1842     on error undo, return error return-value
     1843     :
     1844       run diasize_set-height in this-procedure
     1845         (input  v-diasize-current-frame-height
     1846         ,input  true
     1847         ) .
     1848       run diasize_set-width in this-procedure
     1849         (input  v-diasize-current-frame-width
     1850         ,input  true
     1851         ) .
     1852     end.
     1853   end procedure.
     1854   procedure diasize_set-browse-handle :
     1855     define input  parameter p-browse-handle as handle   no-undo .
     1856     define buffer buf_temp-browse-handle for temp-browse-handle .
     1857     do
     1858     on error undo, return error return-value
     1859     :
     1860       assign
     1861         v-diasize-browse-handle = p-browse-handle
     1862       .
     1863       for each buf_temp-browse-handle
     1864       on error undo, return error return-value
     1865       :
     1866         delete buf_temp-browse-handle .
     1867       end.
     1868     end.
     1869   end procedure.
     1870   procedure diasize_add_browse :
     1871     define input  parameter p-browse-type   as character no-undo .
     1872     define input  parameter p-browse-handle as handle    no-undo .
     1873     define buffer buf_temp-browse-handle for temp-browse-handle .
     1874     do
     1875     on error undo, return error return-value
     1876     :
     1877       assign
     1878         v-diasize-browse-number = v-diasize-browse-number + 1
     1879       .
     1880       create buf_temp-browse-handle .
     1881       assign
     1882         buf_temp-browse-handle.browse-type   = p-browse-type
     1883         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1884         buf_temp-browse-handle.browse-handle = p-browse-handle
     1885       .
     1886     end.
     1887   end procedure.
     1888   procedure diasize_init :
     1889     define variable v-default-value    as logical   no-undo .
     1890     define variable v-restore-saved    as logical   no-undo .
     1891     define variable v-resize-value-str as character no-undo .
     1892     do
     1893     on error undo, return error return-value
     1894     :
     1895       do with frame Dialog-Frame
     1896       :
     1897         assign
     1898           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1899           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1900           v-diasize-browse-handle     = browse brw-auto-tank :handle
     1901         .
     1902         create button v-diasize-resize-button
     1903         assign
     1904           parent        = frame Dialog-Frame :first-child
     1905           label         = "s"
     1906           height-pixels = 16
     1907           width-pixels  = 16
     1908           visible       = true
     1909           sensitive     = true
     1910           movable       = true
     1911           triggers:
     1912             on end-move persistent run diasize_end-move in this-procedure .
     1913           end triggers.
     1914         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1915         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1916         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1917         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1918         assign
     1919           v-diasize-wndmax = false
     1920         .
     1921         if connected("ub") = true
     1922         then do:
     1923           define variable v-cntxt-db-num        as integer   no-undo .
     1924           define variable v-cntxt-userid        as character no-undo .
     1925           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1926                                             , OUTPUT v-cntxt-userid
     1927                                             ) .
     1928           run gbl/wndpar_r.p
     1929             (input  v-cntxt-db-num
     1930             ,input  v-cntxt-userid
     1931             ,input  'wndmax':U
     1932             ,output v-diasize-wndmax
     1933             ,output v-default-value
     1934             ) .
     1935         end.
     1936         assign
     1937           v-diasize-wndstore = false
     1938         .
     1939         if connected("ub") = true
     1940         then do:
     1941           run gbl/wndpar_r.p
     1942             (input  v-cntxt-db-num
     1943             ,input  v-cntxt-userid
     1944             ,input  'wndstore':U
     1945             ,output v-diasize-wndstore
     1946             ,output v-default-value
     1947             ) .
     1948         end.
     1949         assign
     1950           v-diasize-proc-name = entry(1, program-name(2), '.')
     1951         .
     1952         if v-diasize-wndstore = true
     1953         then do:
     1954           assign
     1955             v-restore-saved = false
     1956           .
     1957           if connected("ub") = true
     1958           then do:
     1959             run gbl/wndsizer.p
     1960               (input  v-cntxt-db-num
     1961               ,input  v-cntxt-userid
     1962               ,input  v-diasize-proc-name
     1963               ,input  'height':u
     1964               ,output v-resize-value-str
     1965               ) .
     1966             if v-resize-value-str <> '':U
     1967             then do:
     1968               run diasize_change-height in this-procedure
     1969                 (input  integer(v-resize-value-str)
     1970                 ,input  true
     1971                 ) .
     1972               assign
     1973                 v-restore-saved = true
     1974               .
     1975             end.
     1976           end.
     1977           if connected("ub") = true
     1978           then do:
     1979             run gbl/wndsizer.p
     1980               (input  v-cntxt-db-num
     1981               ,input  v-cntxt-userid
     1982               ,input  v-diasize-proc-name
     1983               ,input  'width':u
     1984               ,output v-resize-value-str
     1985               ) .
     1986             if v-resize-value-str <> '':U
     1987             then do:
     1988               run diasize_change-width in this-procedure
     1989                 (input  integer(v-resize-value-str)
     1990                 ,input  true
     1991                 ) .
     1992               assign
     1993                 v-restore-saved = true
     1994               .
     1995             end.
     1996           end.
     1997           if v-restore-saved <> true
     1998           then do:
     1999             if v-diasize-wndmax = true
     2000             then do:
     2001               run diasize_maximize in this-procedure
     2002                 (input  true
     2003                 ) .
     2004             end.
     2005           end.
     2006         end.
     2007         else do:
     2008           if v-diasize-wndmax = true
     2009           then do:
     2010             run diasize_maximize in this-procedure
     2011               (input  true
     2012               ) .
     2013           end.
     2014         end.
     2015       end.
     2016     end.
     2017   end procedure.
     2018   procedure diasize_need-full-display :
     2019     define output parameter p-need-full-display as logical   no-undo .
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       assign
     2024         p-need-full-display = v-diasize-need-full-display
     2025       .
     2026       assign
     2027         v-diasize-need-full-display = false
     2028       .
     2029     end.
     2030   end procedure.
     2031   procedure get-context :
     2032      define output parameter p-db-num as integer          no-undo.
     2033      define output parameter p-user-id as character        no-undo.
     2034      define variable v-login               as character    no-undo.
     2035      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2036      define buffer buf_user-login  for ub.user-login .
     2037      do
     2038      on error undo, return error
     2039      :
     2040            FIND FIRST buf_sys-ctrl no-lock.
     2041            ASSIGN
     2042               v-login = USERID("ub")
     2043               p-db-num = buf_sys-ctrl.db-num
     2044            .
     2045            FIND FIRST buf_user-login
     2046                 WHERE buf_user-login.db-num = p-db-num
     2047                   AND buf_user-login.user-login = v-login
     2048                 no-lock
     2049                 no-error
     2050                 .
     2051            IF AVAILABLE buf_user-login
     2052            THEN DO:
     2053               assign
     2054                  p-user-id = buf_user-login.user-id
     2055               .
     2056            END.
     2057      end.
     2058   end procedure.
     2059       run diasize_init in this-procedure .
     2060   MAIN-BLOCK:
     2061   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2062      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2063     ASSIGN
     2064       rs-status_:RADIO-BUTTONS IN FRAME Dialog-Frame
     2065                              = "Текущие&+" + chr(44) +  'тек':U + chr(44) +
     2066                              "Все&!" + chr(44) + 'все':U + chr(44) +
     2067                               "Удаленные&-" + chr(44) + 'удал':U
     2068       rs-status_ = 'тек':U
     2069     .
     2070     RUN local-enable_UI.
     2071     WAIT-FOR GO OF FRAME Dialog-Frame.
     2072   END.
     2073   RUN disable_UI.
     2074   PROCEDURE disable_UI :
     2075     HIDE FRAME Dialog-Frame.
     2076   END PROCEDURE.
     2077   PROCEDURE enable_UI :
     2078     DISPLAY varps
     2079         WITH FRAME Dialog-Frame.
     2080     ENABLE b-exit b-view b-help brw-auto-tank varps RS-status_ f-search
     2081         WITH FRAME Dialog-Frame.
     2082     VIEW FRAME Dialog-Frame.
     2083     OPEN QUERY brw-auto-tank FOR EACH tt-auto-tank       where index(tt-auto-tank.auto-num, "#") = 0 EXCLUSIVE-LOCK.
     2084   END PROCEDURE.
     2085   PROCEDURE local-enable_UI :
     2086     RUN enable_ui IN THIS-PROCEDURE.
     2087     if lookup ("b-sel", parbuttons) > 0 then do:
     2088       enable b-sel with frame Dialog-Frame.
     2089     end.
     2090     if lookup ("b-add", parbuttons) > 0 then do:
     2091       enable b-add with frame Dialog-Frame.
     2092     end.
     2093     if lookup ("b-chg", parbuttons) > 0 then do:
     2094       enable b-chg with frame Dialog-Frame.
     2095     end.
     2096     if lookup ("b-del", parbuttons) > 0 then do:
     2097       enable b-del with frame Dialog-Frame.
     2098     end.
     2099     apply "value-changed" to brw-auto-tank in frame dialog-frame.
     2100     display brw-auto-tank WITH FRAME Dialog-Frame.
     2101       brw-auto-tank:visible = true .
     2102       enable brw-auto-tank WITH FRAME Dialog-Frame.
     2103       empty temp-table tt-auto-tank .
     2104     if par-obj-type <> "" and par-obj-code <> 0 then do :
     2105        disable rs-status_ WITH FRAME Dialog-Frame.
     2106        case RS-status_:
     2107           when 'все':U then
     2108              do:
     2109                 FOR EACH ub.auto-tank no-lock where ub.auto-tank.firm-type = par-obj-type
     2110                                                 and ub.auto-tank.firm-code = par-obj-code
     2111                                                 :
     2112                    create tt-auto-tank .
     2113                    buffer-copy ub.auto-tank to tt-auto-tank .
     2114                 end.
     2115              end.
     2116           otherwise
     2117           do:
     2118              FOR EACH ub.auto-tank no-lock where ub.auto-tank.status_ = RS-status_
     2119                                              and ub.auto-tank.firm-type = par-obj-type
     2120                                              and ub.auto-tank.firm-code = par-obj-code:
     2121                 create tt-auto-tank .
     2122                 buffer-copy ub.auto-tank to tt-auto-tank .
     2123              end.
     2124              FOR EACH ub.auto-tank no-lock where ub.auto-tank.status_ = RS-status_
     2125                                              and ub.auto-tank.firm-type = ""
     2126                                              and ub.auto-tank.firm-code = ?:
     2127                 FOR first auto-tank-attr no-lock where auto-tank-attr.attr-code = "auto-firm"
     2128                                                    and auto-tank-attr.auto-num = ub.auto-tank.auto-num:
     2129                    if auto-tank-attr.attr-value begins par-obj-type and integer(replace(auto-tank-attr.attr-value, "орг", "")) = par-obj-code then do:
     2130                 create tt-auto-tank .
     2131                 buffer-copy ub.auto-tank to tt-auto-tank .
     2132                    end.
     2133                 end.
     2134              end.
     2135           end.
     2136        end case.
     2137     end.
     2138     else do:
     2139        enable rs-status_ WITH FRAME Dialog-Frame.
     2140        case RS-status_:
     2141           when 'все':U then
     2142              do:
     2143                 FOR EACH ub.auto-tank NO-LOCK:
     2144                    create tt-auto-tank .
     2145                    buffer-copy ub.auto-tank to tt-auto-tank .
     2146                 end.
     2147              end.
     2148           otherwise
     2149           do:
     2150              FOR EACH ub.auto-tank no-lock where ub.auto-tank.status_ = RS-status_ :
     2151                 create tt-auto-tank .
     2152                 buffer-copy ub.auto-tank to tt-auto-tank .
     2153              end.
     2154           end.
     2155        end case .
     2156     end.
     2157       OPEN QUERY brw-auto-tank FOR EACH tt-auto-tank .
     2158         for first ub.auto-tank no-lock where recid (ub.auto-tank) = varauto-tank-rec:
     2159            for first tt-auto-tank where tt-auto-tank.auto-num = ub.auto-tank.auto-num:
     2160               tt-varauto-tank-rec = recid (tt-auto-tank) .
     2161               reposition brw-auto-tank to recid tt-varauto-tank-rec no-error.
     2162            end.
     2163         end.
     2164     ASSIGN
     2165       v-status_ = rs-status_
     2166     .
     2167     RUN openbr IN THIS-PROCEDURE NO-ERROR.
     2168     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2169     if varauto-tank-rec <> ? then do:
     2170       reposition brw-auto-tank to recid tt-varauto-tank-rec no-error.
     2171     end.
     2172   END PROCEDURE.
     2173   FUNCTION get-auto-firm RETURNS CHARACTER
     2174     ( BUFFER buf_auto-tank FOR tt-auto-tank ) :
     2175     define variable v-return-value as character no-undo .
     2176     find first ub.auto-tank-attr no-lock where ub.auto-tank-attr.attr-code = "auto-firm"
     2177                                            and ub.auto-tank-attr.auto-num = tt-auto-tank.auto-num  no-error.
     2178     if available ub.auto-tank-attr then do :
     2179       v-return-value = ub.auto-tank-attr.attr-value.
     2180     end.
     2181     else do :
     2182       v-return-value = "".
     2183     end.
     2184     return v-return-value .
     2185   END FUNCTION.
     2186   PROCEDURE OpenBr :
     2187   define variable l-query-was-opened as logical no-undo .
     2188   run waitfram-show in this-procedure ("Ждите...").
     2189   define variable sort-column-phrase as character no-undo .
     2190   define variable l-open-query as logical   no-undo .
     2191   define variable v-num as character no-undo initial "#" .
     2192    IF v-status_ = 'все':U THEN DO:
     2193   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2194   define variable  l-disable-where-9  as logical   no-undo .
     2195   define variable  l-filter-open-9    as logical   .
     2196   define variable  flt-rec-9       as recid     no-undo .
     2197   define variable  filter-name-9      as character no-undo .
     2198   define variable  where-phrase-9     as character no-undo .
     2199   define variable  sort-phrase-9      as character no-undo .
     2200   define variable  where-phrase-rus-9 as character no-undo .
     2201   define variable  sort-phrase-rus-9  as character no-undo .
     2202     run waitfram-show in this-procedure
     2203       (input "ЖДИТЕ ..."
     2204       ).
     2205   run gbl/flt-get.p
     2206     (input "Список автотранспорта"
     2207     ,output flt-rec-9
     2208     ,output filter-name-9
     2209     ,output where-phrase-9
     2210     ,output sort-phrase-9
     2211     ,output where-phrase-rus-9
     2212     ,output sort-phrase-rus-9
     2213     ).
     2214   if yes then do:
     2215       run set-filter-name in this-procedure
     2216         (INPUT filter-name-9
     2217         ) no-error .
     2218     assign
     2219       l-filter-open-9 = false
     2220     .
     2221     if flt-rec-9 <> ?
     2222       or sort-column-phrase > ""
     2223     then do:
     2224       define variable  parameter-2-9 as character no-undo .
     2225       define variable  parameter-3-9 as character no-undo .
     2226       define variable  parameter-4-9 as character no-undo .
     2227       define variable  parameter-5-9 as character no-undo .
     2228       define variable  parameter-6-9 as character no-undo .
     2229       define variable  parameter-7-9 as character no-undo .
     2230         assign
     2231         parameter-3-9 =
     2232                                 "FOR EACH tt-auto-tank"
     2233         parameter-4-9 =
     2234           (
     2235             if (" tt-auto-tank.auto-num begins f-search and index(tt-auto-tank.auto-num, v-num) = 0 " + " " + where-phrase-9) <> ""
     2236             then " tt-auto-tank.auto-num begins f-search and index(tt-auto-tank.auto-num, v-num) = 0 " + " " + where-phrase-9
     2237             else "true"
     2238           )
     2239         parameter-5-9 = (" " + "" + " " + "")
     2240         parameter-6-9 = if sort-phrase-9 = ''
     2241                              then
     2242           (
     2243           " " + "  " +
     2244             " " + sort-column-phrase +
     2245           " " + "  "
     2246           )
     2247                              else
     2248           (
     2249           " " + "  " +
     2250             " " + sort-column-phrase +
     2251           " " + sort-phrase-9
     2252           )
     2253         parameter-7-9 =
     2254           " indexed-reposition  "
     2255       .
     2256       do
     2257       on stop undo, leave
     2258       on error undo, leave
     2259       :
     2260         assign
     2261           l-disable-where-9 =
     2262             (" tt-auto-tank.auto-num begins f-search and index(tt-auto-tank.auto-num, v-num) = 0 " + " " + where-phrase-9 = "")
     2263         .
     2264         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2265                             ,input QUERY brw-auto-tank:handle
     2266                             ,input parameter-3-9
     2267                             ,input parameter-4-9
     2268                             ,input parameter-5-9
     2269                             ,input parameter-6-9
     2270                             ,input parameter-7-9
     2271                             )
     2272         .
     2273         assign
     2274           l-filter-open-9 = true
     2275         .
     2276       end.
     2277       if l-filter-open-9 = false then do:
     2278         message
