     2048       end.
     2049       if varcur-slt-pc = ?
     2050       then do:
     2051         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2052       end.
     2053       v-calcbypart = no.
     2054       if bf_doc-line.whole-send-news = integer('1':U)   then
     2055       v-calcbypart = yes.
     2056       else do:
     2057       for each bf_gds-dtl no-lock
     2058         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2059           and bf_gds-dtl.artic     = bf_doc-line.artic
     2060           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
