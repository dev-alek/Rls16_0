     2071     (input  bf_trn-doc.obj-type
     2072     ,input  bf_trn-doc.obj-code
     2073     ,input  varb-code
     2074     ,input  0
     2075     ,input  bf_trn-doc.fact-order
     2076     ,output vardoc-num
     2077     ,output varprice-sale
     2078     ,output varroad-tax
     2079     ,output varexcise
     2080     )  .
     2081             if varprice-sale = ?
     2082             then do:
     2083               assign
     2084                 varprice-sale = 0
     2085                 varroad-tax   = 0
     2086                 varexcise     = 0
     2087               .
     2088             end.
     2089             assign
     2090               varlastcur-base     = varprice-sale
     2091               varlastcur-road-tax = varroad-tax
     2092               varlastcur-excise   = varexcise
     2093               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2094               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2095               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2096               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2097             .
     2098         end.
     2099       end.
     2100       if varcur-fact-qnty = 0 then do:
     2101         assign
     2102           varcur-base      = varlastcur-base
     2103           varcur-road-tax  = varlastcur-road-tax
     2104           varcur-excise    = varlastcur-excise
     2105         .
     2106       end.
     2107       else do:
     2108         assign
     2109           varcur-base      = varcur-base      / varcur-fact-qnty
     2110           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2111           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2112         .
     2113       end.
     2114       if varcur-vat-pc = ?
     2115       then do:
     2116         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2117       end.
     2118       if varcur-slt-pc = ?
     2119       then do:
     2120         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2121       end.
     2122       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2123       assign
     2124         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2125       if varcur-cons-vat-pc = ? then do:
     2126         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2127       end.
     2128       define buffer buf_tt-clcparts for tt-clcparts .
     2129       for each buf_tt-clcparts
     2130       on error undo, return error return-value
     2131       :
     2132         delete buf_tt-clcparts.
     2133       end.
     2134       for each bf_parts no-lock
     2135         where bf_parts.out-code  = bf_doc-line.doc-code
     2136           and bf_parts.obj-type  = bf_doc-line.obj-type
     2137           and bf_parts.obj-code  = bf_doc-line.obj-code
     2138           and bf_parts.artic     = bf_doc-line.artic
     2139           and bf_parts.prod-type = bf_doc-line.prod-type
     2140           and bf_parts.prod-code = bf_doc-line.prod-code
     2141       on error undo, return error return-value
     2142       :
     2143         create buf_tt-clcparts .
     2144         buffer-copy bf_parts to buf_tt-clcparts .
     2145         if v-calcbypart = yes   then do:
     2146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2147     (buffer bf_parts
     2148     ,output v-b-pcode
     2149     ) no-error .
     2150   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2152     (input  bf_parts.obj-type
     2153     ,input  bf_parts.obj-code
     2154     ,input  v-b-pcode
     2155     ,input  0
     2156     ,input  bf_trn-doc.fact-order
     2157     ,output vardoc-num
     2158     ,output varprice-salef
     2159     ,output varroad-tax
     2160     ,output varexcise
     2161     ) no-error .
     2162             if varprice-sale = ?
     2163             then do:
     2164               assign
     2165                 varprice-salef = 0
     2166                 varroad-tax   = 0
     2167                 varexcise     = 0
     2168               .
     2169             end.
     2170             assign
     2171             part-cur-base  = varprice-salef
     2172             part-cur-road-tax  = varroad-tax
     2173             part-cur-excise = varexcise.
     2174         end.
     2175       end.
     2176       run clcprtsl_calc-ttable in this-procedure
     2177         (input yes,
     2178          input yes,
     2179          input bf_doc-line.road-tax,
     2180          input bf_doc-line.excise,
     2181          input bf_doc-line.vat-pc,
     2182          input bf_doc-line.cons-vat-pc,
     2183          input bf_doc-line.slt-pc,
     2184          input bf_trn-doc.base-rate,
     2185          input bf_trn-doc.base-scale,
     2186          input varr-b,
     2187          input varcur-base,
     2188          input varcur-road-tax,
     2189          input varcur-excise,
     2190          input varcur-vat-pc,
     2191          input varcur-cons-vat-pc,
     2192          input varcur-slt-pc
     2193          ) no-error.
     2194       if error-status:error then do:
     2195         message
     2196           vss-workfile vss-revision vss-description skip
     2197           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2198           return-value skip
     2199           trim(error-status :get-message(1))
     2200           trim(error-status :get-message(2))
     2201           trim(error-status :get-message(3))
     2202           trim(error-status :get-message(4))
     2203           trim(error-status :get-message(5)) skip
     2204           view-as alert-box error.
     2205         undo, return error .
     2206       end.
     2207     end.
     2208   end.
     2209   end.
     2210   procedure clcprtsl_calc-ttable :
     2211   define input parameter paris-doc           as   logical                 no-undo.
     2212   define input parameter paris-cur           as   logical                 no-undo.
     2213   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2214   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2215   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2216   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2217   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2218   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2219   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2220   define input parameter parr-b              as   character               no-undo.
     2221   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2222   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2223   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2224   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2225   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2226   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2227   define buffer bf_tt-allsum      for tt-allsum.
     2228   define buffer bf_tt-clcparts    for tt-clcparts.
     2229   define buffer bf_tt-allsum-line for tt-allsum-line.
     2230   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
