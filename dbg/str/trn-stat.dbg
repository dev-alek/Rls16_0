     2740       end.
     2741       run partslib-init-temp-parts in this-procedure
     2742         (input p-obj-type
     2743         ,input p-obj-code
     2744         ,input p-artic
     2745         ,input p-prod-type
     2746         ,input p-prod-code
     2747         ) no-error .
     2748       if error-status :error
     2749       then do:
     2750         message
     2751           vss-workfile vss-revision vss-description skip
     2752           vss-include-info21 skip
     2753           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     2754           "Объект" p-obj-type p-obj-code skip
