     2232   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2233   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2234   define variable varexcise          like ub.price-list.excise     no-undo.
     2235   do on error undo, return error return-value :
     2236   for each bf_tt-allsum-line
     2237   on error undo, return error return-value
     2238    :
     2239     delete bf_tt-allsum-line.
     2240   end.
     2241   for each bf_tt-allsum
     2242   on error undo, return error return-value
     2243   :
     2244     delete bf_tt-allsum.
     2245   end.
     2246   for each bf_tt-clcparts
     2247   on error undo, return error return-value
     2248   :
     2249   if v-calcbypart then do:
     2250             assign
     2251             parcur-base =   bf_tt-clcparts.part-cur-base
     2252             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2253             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2254             .
     2255   end.
     2256      run clcprtsl_calc-parts in this-procedure (
     2257        input recid(bf_tt-clcparts),
     2258        input paris-doc,
     2259        input paris-cur,
     2260        input parroad-tax,
     2261        input parexcise,
     2262        input parvat-pc,
     2263        input parcons-vat-pc,
     2264        input parslt-pc,
     2265        input parbase-rate,
     2266        input parbase-scale,
     2267        input parr-b,
     2268        input parcur-base,
     2269        input parcur-road-tax,
     2270        input parcur-excise,
     2271        input parcur-vat-pc,
     2272        input parcurcons-vat-pc,
     2273        input parcurslt-pc
     2274        ) no-error.
     2275     if error-status:error then do:
     2276       message
     2277         vss-workfile vss-revision vss-description skip
     2278         vss-include-info2 skip
     2279         "Ошибка при обсчете партии" skip
     2280         "Документ партии " bf_tt-clcparts.out-code skip
     2281         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2282         return-value skip
     2283         error-status:get-message(1) skip
     2284         error-status:get-message(2) skip
     2285         error-status:get-message(3) skip
     2286         view-as alert-box error .
     2287       undo, return error .
     2288     end.
     2289     for each bf_tt-allsum on error undo, return error return-value :
     2290       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2291       if not available bf_tt-allsum-line then do:
     2292         create bf_tt-allsum-line.
     2293         assign
     2294           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2295       end.
     2296       assign
     2297         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2298         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2299         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2300         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2301         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2302         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2303         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2304         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2305         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2306         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2307         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2308         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2309         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2310         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2311         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2312         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2313         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2314         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2315         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2316         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2317         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2318         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2319         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2320         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2321         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2322         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2323         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2324         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2325         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2326         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2327         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2328         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2329         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2330         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2331         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2332         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2333         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2334         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2335         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2336         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2337         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2338         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2339         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2340         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2341         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2342         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2343         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2344         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2345         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2346         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2347         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2348         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2349         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2350         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2351         .
     2352     end.
     2353   end.
     2354   end.
     2355   end procedure.
     2356   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2357   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2358   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2359   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2360   define variable gp-excise     like ub.price-list.excise     no-undo.
     2361   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2362   define variable gp-fact-order as decimal   no-undo .
     2363   define variable gp-price-sale-parts as decimal   no-undo .
     2364   procedure plgdsfnd :
     2365     define input  parameter p-chk-and-chs    as logical               no-undo .
     2366     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     2367     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     2368     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     2369     define output parameter p-reserv-pl-code as   logical             no-undo .
     2370     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     2371     define buffer buf_goods         for ub.goods .
     2372     define buffer buf_pl-gds        for ub.pl-gds .
     2373     define buffer buf_second_pl-gds for ub.pl-gds .
     2374     find first buf_goods no-lock where
     2375                buf_goods.gds-code = p-gds-code no-error .
     2376     if not available buf_goods
     2377     then do:
     2378       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     2379     end.
     2380   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2382     (input  p-obj-type
     2383     ,input  p-obj-code
     2384     ,input  buf_goods.artic
     2385     ,input  buf_goods.prod-type
     2386     ,input  buf_goods.prod-code
     2387     ,input  'place-rsrv=request'
     2388     ,output p-reserv-pl-code
     2389     ) no-error .
     2390     if error-status :error
     2391     then do:
     2392       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     2393     end.
     2394     if p-reserv-pl-code = no
     2395     then do:
     2396       return .
     2397     end.
     2398     if p-chk-and-chs <> yes
     2399     then do:
     2400       return .
     2401     end.
     2402     find first buf_pl-gds no-lock where
     2403                buf_pl-gds.obj-type = p-obj-type and
     2404                buf_pl-gds.obj-code = p-obj-code and
     2405                buf_pl-gds.gds-code = p-gds-code no-error .
     2406     if not available buf_pl-gds
     2407     then do:
     2408       return error "К товару не привязано ни одного места хранения" .
     2409     end.
     2410     find first buf_second_pl-gds no-lock where
     2411                buf_second_pl-gds.obj-type  = p-obj-type          and
     2412                buf_second_pl-gds.obj-code  = p-obj-code          and
     2413                buf_second_pl-gds.gds-code  = p-gds-code          and
     2414                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     2415     if not available buf_second_pl-gds
     2416     then do:
     2417       assign
     2418         p-pl-code = buf_pl-gds.pl-code
     2419       .
     2420     end.
     2421     else do:
     2422       if not valid-handle( parparentproc )
     2423       then do:
     2424         return error "Не выбрано место хранения " + chr(10) .
     2425       end.
     2426       run str/plgdssel.p
     2427         (
     2428            input parparentproc
     2429         ,  input p-obj-type
     2430         ,  input p-obj-code
     2431         ,  input p-gds-code
     2432         , output p-pl-code
     2433         ) no-error .
     2434       if error-status :error
     2435       then do:
     2436         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     2437                                , 'plgdssel.p':U
     2438                                , chr(10)
     2439                                , error-status :get-message( 1 )
     2440                                , return-value
     2441                                ) .
     2442       end.
     2443       if p-pl-code = ? or
     2444          p-pl-code = 0
     2445       then do:
     2446         return error "Не выбрано место хранения " + chr(10) .
     2447       end.
     2448     end.
     2449   end procedure.
     2450   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2451   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     2452   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     2453     field cst-code                like ub.trn-doc.cst-code
     2454     field part-code               like ub.parts.part-code
     2455     .
     2456   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     2457   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     2458   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     2459   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   define new global shared variable g#lib-calc as handle no-undo .
     2461   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2462   procedure doc-code:
     2463   define input  parameter parmode          as   character           no-undo.
     2464   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2465   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2466   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2467   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2468   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2469   define variable vardb-remote     as   logical             no-undo.
     2470   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2471   define variable v-delimiter as character no-undo .
     2472   do
     2473   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2474   :
     2475   find first buf_sys-ctrl no-lock .
     2476   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2477     CASE parmode:
     2478       when "main":u then do:
     2479         if vardb-remote then do:
     2480           assign
     2481             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2482         end.
     2483         else do:
     2484           assign
     2485             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2486         end.
     2487       end.
     2488       when "trio" then do:
     2489         assign
     2490           pardoc-code = replace (parroot-doc-code, "=", "*").
     2491       end.
     2492       otherwise do:
     2493         assign
     2494         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2495         no-error
     2496         .
     2497         if error-status:error  then do:
     2498           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2499                                         ,chr(10)
     2500                                         ,parmode
     2501                                         ).
     2502         end.
     2503         if num-entries(parmode) = 1
     2504         and parmode <> "chip":U
     2505         and parmode <> "chip_s":U
     2506         then do:
     2507           assign
     2508           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2509         end.
     2510         else if (lookup("chip":U, parmode) > 0
     2511                  or
     2512                  lookup("chip_s":U, parmode) > 0) then do:
     2513           assign
     2514             vartemp-doc-code = parroot-doc-code.
     2515           do while true:
     2516             if index (vartemp-doc-code , ".") = 0 then
     2517               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2518             else
     2519               vartemp-doc-code  =
     2520               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2521               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2522               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2523             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2524           end.
     2525           assign
     2526             pardoc-code = vartemp-doc-code.
     2527         end.
     2528       end.
     2529     end CASE.
     2530     if pardoc-code = '':U
     2531     or (parroot-doc-code <> '':U
     2532     and pardoc-code = parroot-doc-code) then do:
     2533       undo, return error substitute("Ошибка при генерации номера документа&1"
     2534                                     ,chr(10)).
     2535     end.
     2536   end.
     2537   end. // procedure/method
     2538   function get-doc-code-int64 returns int64
     2539     ( input p-doc-code as character ) :
     2540     define variable v-ind              as integer   no-undo .
     2541     define variable v-num-entries      as integer   no-undo .
     2542     define variable v-doc-code-int64   as int64     no-undo .
     2543     define variable v-canonic-doc-code as character no-undo .
     2544     assign
     2545       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2546       v-canonic-doc-code = p-doc-code
     2547     .
     2548     do v-ind = 1 to v-num-entries
     2549     :
     2550       assign
     2551         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2552       .
     2553     end.
     2554     assign
     2555       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2556     .
     2557     return v-doc-code-int64 .
     2558   end. // function/method
     2559   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2560   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2561   procedure partslib-clear-temp-parts :
     2562     define buffer buf_temp-parts for temp-parts .
     2563     do
     2564     on error undo, return error
     2565     :
     2566       for each buf_temp-parts
     2567       on error undo, return error
     2568       :
     2569         delete buf_temp-parts .
     2570       end.
     2571     end.
     2572   end procedure.
     2573   procedure partslib-create-temp-parts :
     2574     define parameter buffer buf_parts       for ub.parts .
     2575     define parameter buffer buf_temp-parts  for temp-parts .
     2576     define input  parameter p-goods-twounit as logical   no-undo .
     2577     define variable v-base-part-code as character no-undo .
     2578     do
     2579     on error undo, return error
     2580     :
     2581       if p-goods-twounit = true
     2582       then do:
     2583         assign
     2584           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2585         .
     2586       end.
     2587       else do:
     2588         assign
     2589           v-base-part-code = buf_parts.part-code
     2590         .
     2591       end.
     2592       find first buf_temp-parts exclusive-lock
     2593         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2594           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2595           and buf_temp-parts.artic     = buf_parts.artic
     2596           and buf_temp-parts.prod-type = buf_parts.prod-type
     2597           and buf_temp-parts.prod-code = buf_parts.prod-code
     2598           and buf_temp-parts.in-code   = buf_parts.in-code
     2599           and buf_temp-parts.out-code  = 'free-zone':U
     2600           and buf_temp-parts.part-code = v-base-part-code
     2601         no-error.
     2602       if not available buf_temp-parts
     2603       then do:
     2604         create buf_temp-parts .
     2605         buffer-copy buf_parts to buf_temp-parts
     2606         assign
     2607           buf_temp-parts.out-code  = 'free-zone':U
     2608           buf_temp-parts.part-code = v-base-part-code
     2609           buf_temp-parts.rsrv-free = yes
     2610           buf_temp-parts.status_   = no
     2611           buf_temp-parts.qnty      = 0
     2612           buf_temp-parts.fact-qnty = 0
     2613           buf_temp-parts.real-qnty = 0
     2614           buf_temp-parts.cli-qnty  = 0
     2615         .
     2616       end.
     2617     end.
     2618   end procedure.
     2619   procedure partslib-init-temp-parts :
     2620     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2621     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2622     define input parameter p-artic           like ub.parts.artic     no-undo .
     2623     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2624     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2625     define buffer buf_parts      for ub.parts .
     2626     define buffer buf_temp-parts for temp-parts .
     2627     define variable v-goods-twounit    as logical   no-undo .
     2628     do
     2629     on error undo, return error
     2630     :
     2631   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2633     (input  p-artic
     2634     ,input  p-prod-type
     2635     ,input  p-prod-code
     2636     ,input  'twounit=request':u
     2637     ,output v-goods-twounit
     2638     ) no-error .
     2639       if error-status :error
     2640       then do:
     2641         message
     2642           vss-workfile vss-revision vss-description skip
     2643           vss-include-info21 skip
     2644           "Ошибка при определении атрибута товара" skip
     2645           "Артикул" p-artic p-prod-type p-prod-code skip
     2646           "twounit=request" skip
     2647           error-status :get-message(1) skip
     2648           return-value skip
     2649           view-as alert-box error .
     2650         undo, return error return-value .
     2651       end.
     2652       run partslib-clear-temp-parts in this-procedure .
     2653       for each buf_parts
     2654         where buf_parts.obj-type  = p-obj-type
     2655           and buf_parts.obj-code  = p-obj-code
     2656           and buf_parts.artic     = p-artic
     2657           and buf_parts.prod-type = p-prod-type
     2658           and buf_parts.prod-code = p-prod-code
     2659           and buf_parts.rsrv-free = yes
     2660           and buf_parts.status_   = no
     2661           and buf_parts.in-code   <> buf_parts.out-code
     2662       on error undo, return error
     2663       :
     2664         run partslib-create-temp-parts in this-procedure
     2665           (buffer buf_parts
     2666           ,buffer buf_temp-parts
     2667           ,input  v-goods-twounit
     2668           ) .
     2669         define variable v-parts-qnty          as decimal   no-undo .
     2670         define variable v-parts-cli-qnty      as decimal   no-undo .
     2671         define variable v-parts-free-qnty     as decimal   no-undo .
     2672         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2673         if buf_parts.out-code = 'free-zone':U
     2674         then do:
     2675           assign
     2676             v-parts-qnty          = buf_parts.qnty
     2677             v-parts-cli-qnty      = buf_parts.cli-qnty
     2678             v-parts-free-qnty     = buf_parts.qnty
     2679             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2680           .
     2681         end.
     2682         else do:
     2683           assign
     2684             v-parts-qnty          = abs(buf_parts.qnty)
     2685             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2686             v-parts-free-qnty     = 0
     2687             v-parts-free-cli-qnty = 0
     2688           .
     2689         end.
     2690         assign
     2691           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2692           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2693           buf_temp-parts.real-qnty     = 0
     2694           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2695           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2696           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2697         .
     2698       end.
     2699     end.
     2700   end procedure.
     2701   procedure partslib-init-temp-parts-by-factord :
     2702     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
