     3764     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     3765       define variable v-answ as logical no-undo .
     3766       if ( p-unit-base-cli-eq = true
     3767            and p-density = 1.0
     3768          )
     3769         or ( p-unit-base-cli-eq = false
     3770              and p-density <> ?
     3771              and p-density > 0.0
     3772              and p-density < 1.0
     3773            )
     3774       then do:
     3775         assign
     3776           v-answ = true
     3777         .
     3778       end.
     3779       else do:
     3780         assign
     3781           v-answ = false
     3782         .
     3783       end.
     3784       return v-answ.
     3785     end function.
