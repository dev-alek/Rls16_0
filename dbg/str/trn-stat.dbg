     7991   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7992   function CheckMarkUtd return logical
     7993    (input idb-num  as integer,
     7994     input idoc-id  as integer):
     7995     define buffer utd-lines             for ub.utd-lines.
     7996     block-line:
     7997     for each utd-lines where utd-lines.db-num eq idb-num
     7998                          and utd-lines.doc-id eq idoc-id
     7999     no-lock:
     8000        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     8001        then
     8002           leave block-line.
     8003     end.
     8004     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     8005     return available utd-lines.
     8006   end.
     8007   function CheckNotMarkUtd return logical
     8008    (input idb-num  as integer,
     8009     input idoc-id  as integer):
     8010     define buffer utd-lines             for ub.utd-lines.
     8011     for each utd-lines where utd-lines.db-num eq idb-num
     8012                          and utd-lines.doc-id eq idoc-id
     8013     no-lock:
     8014        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     8015        then
     8016           return yes.
     8017     end.
     8018     return no.
     8019   end.
     8020   function CheckMarkUtdLine return logical
     8021    (input idb-num  as integer,
     8022     input idoc-id  as integer,
     8023     input iLineNum as integer):
     8024    define buffer utd                   for utd.
     8025    define buffer utd-lines             for utd-lines.
     8026    define buffer utd-marking-lines     for utd-marking-lines.
     8027    define variable v-par-type as character no-undo.
     8028    define variable vMarking        as logical no-undo.
     8029    define variable vArtic          as logical no-undo.
     8030    define variable vTransitional   as logical no-undo.
     8031    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     8032      define variable v-par-val  as character no-undo.
     8033      find first utd where utd.db-num eq idb-num
     8034                       and utd.doc-id eq idoc-id
     8035      no-lock no-error.
     8036      if available utd
     8037      then do:
     8038         if     utd.obj-code ne ?
     8039            and utd.obj-type ne ?
     8040         then do:
     8041            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     8042            Block-utd-lines:
     8043            for each utd-lines where utd-lines.db-num   eq idb-num
     8044                                 and utd-lines.doc-id   eq idoc-id
     8045                                 and utd-lines.LineNum  eq iLineNum
     8046            no-lock:
     8047               if     utd-lines.gds-code ne ?
     8048                  and utd-lines.gds-code ne 0
     8049               then do:
     8050                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     8051                       ( utd-lines.gds-code,
     8052                         'mark-type':U,
     8053                          output v-par-val,
     8054                          output v-par-type
     8055                       ).
     8056                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     8057                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     8058                  if vMarking
     8059                  then do:
     8060                     block-marking:
     8061                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     8062                                                    and utd-marking-lines.doc-id   eq idoc-id
     8063                                                    and utd-marking-lines.LineNum  eq iLineNum
     8064                                                    and length(utd-marking-lines.mark) > 13
     8065                     no-lock:
     8066                        if isOAD(utd-marking-lines.mark)
     8067                        then do:
     8068                           assign
     8069                              vArtic   = yes
     8070                              vMarking = no
     8071                           .
     8072                           leave block-marking.
     8073                        end.
     8074                     end.
     8075                  end.
     8076                  if vArtic
     8077                  then do:
     8078                     block-artic:
     8079                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     8080                                                    and utd-marking-lines.doc-id   eq idoc-id
     8081                                                    and utd-marking-lines.LineNum  eq iLineNum
     8082                                                    and length(utd-marking-lines.mark) > 13
     8083                     no-lock:
     8084                        if isMark(utd-marking-lines.mark)
     8085                        then do:
     8086                           assign
     8087                              vArtic   = no
     8088                              vMarking = yes
     8089                           .
     8090                           leave block-artic.
     8091                        end.
     8092                     end.
     8093                  end.
     8094                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     8095                  if vTransitional
     8096                  then do:
     8097                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     8098                                                    and utd-marking-lines.doc-id   eq idoc-id
     8099                                                    and utd-marking-lines.LineNum  eq iLineNum
     8100                                                    and length(utd-marking-lines.mark) > 13
     8101                     no-lock no-error.
     8102                     if not available utd-marking-lines
     8103                     then assign
     8104                        vMarking = no
     8105                        vArtic   = no
     8106                     .
     8107                  end.
     8108               end.
     8109               else
     8110                  assign
     8111                     vMarking      = yes
     8112                     vArtic        = no
     8113                     vTransitional = no
     8114                  .
     8115               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     8116               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     8117               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     8118            end.
     8119         end.
     8120      end.
     8121      return vMarking or vArtic.
     8122   end.
     8123   function getMarkUtdLine return logical
     8124    (input  idb-num  as integer,
     8125     input  idoc-id  as integer,
     8126     input  iLineNum as integer,
     8127     output oMarking        as logical,
     8128     output oArtic          as logical,
     8129     output oTransitional   as logical):
     8130     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     8131     oArtic        = not oMarking
     8132            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     8133     oTransitional = (oMarking or oArtic)
     8134            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     8135   end.
     8136   function CheckMarking return logical
     8137    (input idb-num as integer,
     8138    input idoc-id as integer,
     8139    input iTypeErr as character ):
     8140     define variable vMarkutd as logical no-undo.
     8141     define variable vCrErr   as logical no-undo.
     8142     define buffer utd-lines         for utd-lines.
     8143     define buffer utd-marking-lines for utd-marking-lines.
     8144     define buffer marking           for marking.
     8145     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     8146      block-line:
     8147      for each utd-lines where utd-lines.db-num eq idb-num
     8148                           and utd-lines.doc-id eq idoc-id
     8149      no-lock:
     8150         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     8151         then do:
     8152            for each utd-marking-lines
     8153                     where utd-marking-lines.db-num  = utd-lines.db-num
     8154                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     8155                       and utd-marking-lines.LineNum = utd-lines.LineNum
     8156            no-lock:
     8157               if isMark(utd-marking-lines.mark)
     8158               then do:
     8159                  find first marking where marking.mark eq utd-marking-lines.mark
     8160                  no-lock no-error.
     8161                  if not available marking
     8162                  then do:
     8163                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     8164                     vCrErr = yes.
     8165                     next block-line.
     8166                  end.
     8167               end.
     8168            end.
     8169         end.
     8170      end.
     8171      return vCrErr.
     8172   end.
     8173   function CheckMarkForType return logical
     8174    (input idb-num   as integer,
     8175     input idoc-id   as integer):
     8176      define variable vMarking        as logical no-undo.
     8177      define variable vArtic          as logical no-undo.
     8178      define variable vTransitional   as logical no-undo.
     8179      define buffer utd-lines         for utd-lines.
     8180      define buffer utd-marking-lines for utd-marking-lines.
     8181      block-line:
     8182      for each utd-lines where utd-lines.db-num eq idb-num
     8183                           and utd-lines.doc-id eq idoc-id
     8184      no-lock:
     8185         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     8186                          output vMarking         , output vArtic          , output vTransitional).
     8187         for each utd-marking-lines
     8188                     where utd-marking-lines.db-num  = utd-lines.db-num
     8189                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     8190                       and utd-marking-lines.LineNum = utd-lines.LineNum
     8191         no-lock:
     8192            if length(utd-marking-lines.mark) < 14
     8193            then do:
     8194               if (vMarking or vArtic) and not vTransitional
     8195               then
     8196                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     8197            end.
     8198            else if not isMark(utd-marking-lines.mark)
     8199            then do:
     8200               if vMarking
     8201               then
     8202                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     8203            end.
     8204            else do:
     8205            end.
     8206         end.
     8207      end.
     8208   end.
     8209   function WeighedProd return logical
     8210      ( input p-gds-code as integer) :
     8211      define variable v-par-val  as character no-undo.
     8212      define variable v-par-type as character no-undo.
     8213              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     8214               ( p-gds-code,
     8215                 'weighed-gds':U,
     8216                  output v-par-val,
     8217                  output v-par-type
     8218               ).
     8219      return logical(v-par-val).
     8220   end.
     8221   function WghProdVariable return logical
     8222       (input p-obj-type as char,
     8223        input p-obj-code as integer,
     8224        input p-gds-code as integer) :
     8225      define variable v-wgh-val  as character no-undo.
     8226      define variable v-par-val  as character no-undo.
     8227      define variable v-par-type as character no-undo.
     8228      define variable vMarking        as logical no-undo.
     8229      define variable vArtic          as logical no-undo.
     8230      define variable vTransitional   as logical no-undo.
     8231      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     8232         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     8233           ( p-gds-code,
     8234             'weighed-gds':U,
     8235              output v-wgh-val,
     8236              output v-par-type
     8237           ).
     8238       if logical(v-wgh-val) = yes then do:
     8239           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     8240               ( p-gds-code,
     8241                 'mark-type':U,
     8242                  output v-par-val,
     8243                  output v-par-type
     8244               ).
     8245           if v-par-val <> "" then do:
     8246               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     8247               assign
     8248                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     8249                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     8250                  .
     8251           end.
     8252      end.
     8253      if v-wgh-val > "" and (vMarking or vArtic)
     8254      then return yes.
     8255      else return no.
     8256   end.
     8257   function MarkWeight return decimal
     8258      ( input p-mark as character) :
     8259      define buffer  buf_marking-attr for  ub.marking-attr.
     8260      define variable vMarkWeight as decimal no-undo.
     8261      vMarkWeight = 0.
     8262      if p-mark <> "" and p-mark <> ?
     8263      then do:
     8264          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     8265                                        and buf_marking-attr.attr-code eq "weight"
     8266             no-lock no-error.
     8267          if not available buf_marking-attr
     8268          then do :
     8269            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     8270                                          and buf_marking-attr.attr-code eq "weight"
     8271               no-lock no-error.
     8272          end .
     8273          if avail buf_marking-attr
     8274          then vMarkWeight = dec(buf_marking-attr.attr-value).
     8275      end.
     8276      return vMarkWeight.
     8277   end.
