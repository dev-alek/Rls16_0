     5361   procedure xmlchar-test :
     5362   define input parameter p-in-string          as character        no-undo.
     5363   define output parameter p-out-string-enc    as character        no-undo.
     5364   define output parameter p-out-string-dec    as character        no-undo.
     5365   do
     5366   on error undo, return error
     5367   :
     5368          run xmlchar-encode in this-procedure
     5369       (
     5370             input p-in-string
     5371           , output p-out-string-enc
     5372       ).
     5373          run xmlchar-decode in this-procedure
     5374       (
     5375             input p-out-string-enc
     5376           , output p-out-string-dec
     5377       ).
     5378   end.
     5379   end .
     5380   procedure xmlchar-encode :
     5381   define input parameter p-in-string      as character        no-undo.
     5382   define output parameter p-out-string    as character        no-undo.
     5383       define variable v-position      as integer      no-undo.
     5384       define variable v-current-char  as character    no-undo.
     5385   do
     5386   on error undo, return error
     5387   :
     5388       assign
     5389           p-out-string = "":U
     5390       .
     5391       case p-in-string
     5392       :
     5393           when ?
     5394           then do:
     5395               assign
     5396                   p-out-string = "?":U
     5397               .
     5398           end.
     5399           when "?":U
     5400           then do:
     5401               assign
     5402                   p-out-string = "&#63;":U
     5403               .
     5404           end.
     5405           otherwise do:
     5406               do v-position = 1 to length( p-in-string )
     5407               :
     5408                   assign
     5409                       v-current-char = substring( p-in-string, v-position, 1 )
     5410                   .
     5411                   case v-current-char
     5412                   :
     5413                       when "&":U
     5414                       then do:
     5415                           assign
     5416                               p-out-string = p-out-string + "&amp;":U
     5417                           .
     5418                       end.
     5419                       when ">":U
     5420                       then do:
     5421                           assign
     5422                               p-out-string = p-out-string + "&gt;":U
     5423                           .
     5424                       end.
     5425                       when "<":U
     5426                       then do:
     5427                           assign
     5428                               p-out-string = p-out-string + "&lt;":U
     5429                           .
     5430                       end.
     5431                       when "'":U
     5432                       then do:
     5433                           assign
     5434                               p-out-string = p-out-string + "&apos;":U
     5435                           .
     5436                       end.
     5437                       when '"':U
     5438                       then do:
     5439                           assign
     5440                               p-out-string = p-out-string + "&quot;":U
     5441                           .
     5442                       end.
     5443                       when chr(1)
     5444                       then do:
     5445                           assign
     5446                               p-out-string = p-out-string + "":U
     5447                           .
     5448                       end.
     5449                       when chr(2)
     5450                       then do:
     5451                           assign
     5452                               p-out-string = p-out-string + "":U
     5453                           .
     5454                       end.
     5455                       when chr(3)
     5456                       then do:
     5457                           assign
     5458                               p-out-string = p-out-string + "":U
     5459                           .
     5460                       end.
     5461                       when chr(4)
     5462                       then do:
     5463                           assign
     5464                               p-out-string = p-out-string + "":U
     5465                           .
     5466                       end.
     5467                       when chr(5)
     5468                       then do:
     5469                           assign
     5470                               p-out-string = p-out-string + "":U
     5471                           .
     5472                       end.
     5473                       when chr(6)
     5474                       then do:
     5475                           assign
     5476                               p-out-string = p-out-string + "":U
     5477                           .
     5478                       end.
     5479                       when chr(7)
     5480                       then do:
     5481                           assign
     5482                               p-out-string = p-out-string + "":U
     5483                           .
     5484                       end.
     5485                       when chr(8)
     5486                       then do:
     5487                           assign
     5488                               p-out-string = p-out-string + "":U
     5489                           .
     5490                       end.
     5491                       when chr(9)
     5492                       then do:
     5493                           assign
     5494                               p-out-string = p-out-string + "":U
     5495                           .
     5496                       end.
     5497                       when chr(29)
     5498                       then do:
     5499                           assign
     5500                               p-out-string = p-out-string + "":U
     5501                           .
     5502                       end.
     5503                       when chr(10)
     5504                       then do:
     5505                           assign
     5506                               p-out-string = p-out-string + "&#10;":U
     5507                           .
     5508                       end.
     5509                       when chr(13)
     5510                       then do:
     5511                           assign
     5512                               p-out-string = p-out-string + "&#13;":U
     5513                           .
     5514                       end.
     5515                       otherwise do:
     5516                           assign
     5517                               p-out-string = p-out-string + v-current-char
     5518                           .
     5519                       end.
     5520                   end case.
     5521               end.
     5522           end.
     5523       end case.
     5524   end.
     5525   end .
     5526   procedure xmlchar-encode-1c :
     5527   define input parameter p-in-string      as character        no-undo.
     5528   define output parameter p-out-string    as character        no-undo.
     5529       define variable v-position      as integer      no-undo.
     5530       define variable v-current-char  as character    no-undo.
     5531   do
     5532   on error undo, return error
     5533   :
     5534       assign
     5535           p-out-string = "":U
     5536       .
     5537       case p-in-string
     5538       :
     5539           when ?
     5540           then do:
     5541               assign
     5542                   p-out-string = "?":U
     5543               .
     5544           end.
     5545           otherwise do:
     5546               do v-position = 1 to length( p-in-string )
     5547               :
     5548                   assign
     5549                       v-current-char = substring( p-in-string, v-position, 1 )
     5550                   .
     5551                   case v-current-char
     5552                   :
     5553                       when chr(1)
     5554                       then do:
