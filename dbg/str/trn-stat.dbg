      457   define variable v-calcbypart as log no-undo.
      458   procedure clcprtsl_calc-parts :
      459   define input parameter parrec-parts        as   recid                   no-undo.
      460   define input parameter paris-doc           as   logical                 no-undo.
      461   define input parameter paris-cur           as   logical                 no-undo.
      462   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
      463   define input parameter parexcise           like ub.doc-line.excise      no-undo.
      464   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
      465   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
      466   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
      467   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
      468   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
