        1   block-level on error undo, throw.
        2   using ibs.th.str.*.
        3   using ibs.th.str.mercury.*.
        4   using ibs.th.gbl.storage.*.
        5   using ibs.th.gbl.*.
        6   define input  parameter parparentproc   as   widget-handle       no-undo.
        7   define input  parameter parparenthandle as   handle              no-undo.
        8   define input  parameter parmode         as   character           no-undo.
        9   define input  parameter pardoc-code     like ub.trn-doc.doc-code no-undo.
       10   define input  parameter parcheck-return as   logical             no-undo.
       11   define input  parameter pardb-num       like ub.db.db-num        no-undo.
       12   define input  parameter parin-ov        as   logical             no-undo.
       13   define input  parameter parrsrv-time    as   integer             no-undo.
       14   define input  parameter parload-time    as   integer             no-undo.
       15   define input  parameter parholidays     as   character           no-undo.
       16   define input  parameter parmessage      as   logical             no-undo.
       17   define output parameter parchg-inv      as   logical             no-undo.
       18   define variable vss-revision    as character no-undo initial "$Revision$":U .
       19   define variable vss-author      as character no-undo initial "$Author$":U .
       20   define variable vss-date        as character no-undo initial "$Date$":U .
       21   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       22   define variable vss-archive     as character no-undo initial "$Archive$":U .
       23   define variable vss-description as character no-undo initial "Изменение статуса складского документа":U .
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42       assign
       43         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5':u,parparentproc,parmode,pardoc-code,parcheck-return,pardb-num),substitute('&1|&2|&3|&4|&5':u,parin-ov,parrsrv-time,parload-time,parholidays,parmessage) )
       44       .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define variable v-waitfram-action01         as character   no-undo .
       98   define variable v-waitfram-action02         as character   no-undo .
       99   define variable v-waitfram-action03         as character   no-undo .
      100   define variable mWaitFramTextBeg            as character   no-undo.
      101   define variable mWaitFramTextEnd            as character   no-undo.
      102   define variable mWaitFramView               as logical     no-undo.
      103   define variable mWaitProcEvent              as logical     no-undo init yes.
      104   define variable mWaitFramInterval           as integer     no-undo init 1 .
      105   define variable mWaitFramStop               as logical     no-undo.
      106   define variable mWaitFramStopUser           as logical     no-undo.
      107   define variable mWaitFramStopTimeOut        as logical     no-undo.
      108   define variable mWaitFramStartProc          as datetime-tz no-undo.
      109   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      110   define button B-WaitFramStop auto-end-key
      111        label "Стоп"
      112        size 10 by 1 tooltip "Остоновить процесс".
      113   define button B-viewProcInfo
      114        label "Информация"
      115        size 15 by 1 tooltip "Информация о процесс".
      116   define frame waitfram
      117     v-waitfram-action01 format "x(72)" no-label skip
      118     v-waitfram-action02 format "x(72)" no-label skip
      119     v-waitfram-action03 format "x(72)" no-label skip
      120     B-viewProcInfo
      121     B-WaitFramStop at row 4 col 30
      122     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      123     .
      124   define new global shared variable mBatchMode as logical no-undo init ?.
      125   define variable mFramBachModHandle as handle no-undo.
      126   mFramBachModHandle = frame waitfram:handle.
      127   define variable mFameOldVis as logical no-undo.
      128   define variable mVisCUrentVin as logical no-undo.
      129   if session:batch-mode
      130   then
      131      mBatchMode = yes.
      132   if mBatchMode = ? then do:
      133     mVisCUrentVin = current-window:visible.
      134     mFameOldVis = mFramBachModHandle:visible.
      135     mFramBachModHandle:visible  = yes.
      136     mBatchMode = mFramBachModHandle:visible ne yes.
      137     mFramBachModHandle:visible = mFameOldVis.
      138     current-window:visible = mVisCUrentVin.
      139   end.
      140    if  log-manager:logfile-name ne ?
      141     then DO:
      142         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      143         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      144         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      145     end.
      146   on choose of B-WaitFramStop in frame waitfram
      147   do:
      148     mWaitFramStop = yes.
      149     mWaitFramStopUser = yes.
      150   end.
      151   function waitfram-check-timeout returns logical():
      152      define variable vtime as int64 no-undo.
      153      if mWaitFramStopTimeOut
      154      then
      155         return yes.
      156      vtime = ( now - mWaitFramStartProc ) / 1000 .
      157      if     mWaitFramTimeOut ne ?
      158         and mWaitFramTimeOut ne 0
      159         and mWaitFramTimeOut lt vtime
      160      then do:
      161         mWaitFramStopTimeOut = yes.
      162      end.
      163      return mWaitFramStopTimeOut.
      164   end.
      165   procedure waitfram-hide :
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       pause 0 before-hide .
      171       if not mBatchMode then
      172         hide frame waitfram .
      173     end.
      174   end procedure.
      175   procedure waitfram-show :
      176     define input  parameter p-message as character no-undo .
      177     define variable v-left-margin as integer   no-undo .
      178     if not session:batch-mode
      179     then do
      180     on error undo, return error return-value
      181     :
      182       if length(p-message) <= 70 then do:
      183         assign
      184           v-left-margin = integer((70 - length(p-message)) / 2)
      185         .
      186         assign
      187           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      188         .
      189         assign
      190           v-waitfram-action01 = " "
      191           v-waitfram-action02 = " "
      192                                    + fill(" ", v-left-margin)
      193                                    + p-message
      194           v-waitfram-action03 = " "
      195         .
      196       end.
      197       else do:
      198         define variable vRindex1 as integer no-undo.
      199         define variable vRindex2 as integer no-undo.
      200         vRindex1 = r-index(p-message," ",70).
      201         if vRindex1 = 0
      202         then
      203            vRindex1 = 70.
      204         if length(p-message)  <= vRindex1 + 70 then do:
      205           assign
      206             v-waitfram-action01 = " "
      207             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      209           .
      210         end.
      211         else do:
      212           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      213           if vRindex2 <= vRindex1
      214           then
      215              vRindex2 = vRindex1 + 70.
      216           assign
      217             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      218             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      219             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      220           .
      221         end.
      222       end.
      223       B-viewProcInfo:visible   in frame waitfram = no.
      224       B-viewProcInfo:sensitive in frame waitfram = no.
      225       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      226       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      227       if  (   mWaitFramView
      228          or  mWaitProcEvent)
      229          and not mBatchMode
      230       then
      231          display
      232             v-waitfram-action01 skip
      233             v-waitfram-action02 skip
      234             v-waitfram-action03 skip
      235          with frame waitfram .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
