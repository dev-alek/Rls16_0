    13019     ) .
    13020          if var-ok-assort-pol = false then do:
    13021               varerr = true .
    13022               output stream str-err to value( replace( bf_trn-doc.doc-code, "*", "$" ) + ".err" ) append.
    13023               put    stream str-err unformatted var-mess-assort-pol skip.
    13024               output stream str-err close.
