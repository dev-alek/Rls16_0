    12524       undo, return error return-value.
    12525     end.
    12526     run waitfram-show in this-procedure (substitute( "Пересчет сумм документа по закрытию на факт. Время: &1", string( time - vartime, "hh:mm:ss":U ) ) ) no-error.
    12527   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_rcallfct in g#lib-rwds ( input              if_trn-doc.doc-code ,
    12528                          input              parwtvalue = 'no' ,
    12529                          input              parasvalue = 'no' ,
    12530                          input              this-procedure :handle ,
    12531                          input-output table tt-wast-line ,
    12532                          input-output table tt-allsum-line ,
    12533                          input-output table tt-doc-line-sum ,
    12534                          input-output table tt-clcparts ,
    12535                          input-output table temp-parts ) no-error .
    12536     if error-status :error
    12537     then do:
    12538       run waitfram-hide in this-procedure no-error.
    12539       undo, return error substitute( "Ошибка при вызове lib-rwds_rcallfct: &1.", return-value ).
    12540     end.
    12541     assign
    12542       varcount = 0.
    12543     for each if_doc-line
    12544       where if_doc-line.doc-code = if_trn-doc.doc-code
    12545     on error undo, return error return-value
    12546     :
    12547       run waitfram-show in this-procedure (substitute( "Обрабатываем строки при закрытии. Обработано строк: &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss") ) ) no-error.
    12548       assign
    12549         varcount = varcount + 1.
    12550       find first if_goods no-lock
    12551         where if_goods.artic     = if_doc-line.artic
    12552           and if_goods.prod-type = if_doc-line.prod-type
    12553           and if_goods.prod-code = if_doc-line.prod-code  .
    12554       if if_doc-line.fact-qnty <> 0
    12555       or if_doc-line.prt-ok
    12556       then do:
    12557         par-if-flag-out = no.
    12558         accumulate if_doc-line.prt-ok (count).
    12559       end.
    12560       assign
    12561         if_cnt-lns = if_cnt-lns + 1.
    12562       if if_cnt-lns modulo 10 = 0
    12563       then do:
    12564         run waitfram-show in this-procedure ("Обработано строк : " + string (if_cnt-lns) ).
    12565       end.
    12566     end.
    12567     if substr (if_trn-doc.PS, 1, 1) = "@"
    12568     then do:
    12569       assign
    12570         if_trn-doc.PS = if_trn-doc.PS + " Всего строк по инвентаризации : " + string (if_cnt-lns, ">>>>>>9") +
    12571                          chr (10) + "Из них закрыто с коррекцией : " + string ( (accum count if_doc-line.prt-ok), ">>>>>>9")
    12572       .
    12573     end.
    12574     run waitfram-show in this-procedure (substitute( "Пересчет шапки документа. Время: &1", string( time - vartime, "hh:mm:ss":U ) ) ) no-error.
    12575   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-inv in g#lib-trn
    12576   (
    12577   input recid(if_trn-doc),
    12578   input this-procedure
    12579   )
    12580   no-error.
    12581     if error-status :error
    12582     then do:
    12583       run waitfram-hide in this-procedure no-error.
    12584       undo, return error return-value.
    12585     end.
    12586     run ie-date in this-procedure.
    12587   end.
    12588   end procedure.
    12589   procedure corr-date:
    12590   define input parameter parobj-type    like ub.trn-doc.obj-type   no-undo.
    12591   define input parameter parobj-code    like ub.trn-doc.obj-code   no-undo.
    12592   define input parameter parfact-date   like ub.trn-doc.fact-date  no-undo.
    12593   define input parameter parshift-date  like ub.trn-doc.shift-date no-undo.
    12594   define input parameter parshift-num   like ub.trn-doc.shift-num  no-undo.
    12595   define input parameter parshift-name  like ub.trn-doc.shift-name no-undo.
    12596   define variable l-shift-on as logical no-undo .
    12597   define buffer bf_shift-obj for ub.shift-obj.
    12598   do on error undo, return error return-value :
    12599   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
    12601     (input  parobj-type
    12602     ,input  parobj-code
    12603     ,input  'shift-on=request'
    12604     ,output l-shift-on
    12605     )  .
    12606   if l-shift-on = yes
    12607   then do:
    12608     find first bf_shift-obj where bf_shift-obj.obj-type   = parobj-type   and
    12609                                   bf_shift-obj.obj-code   = parobj-code   and
    12610                                   bf_shift-obj.shift-date = parshift-date and
    12611                                   bf_shift-obj.shift-num  = parshift-num  no-lock no-error.
    12612     if not available bf_shift-obj
    12613     then do:
    12614       run waitfram-hide in this-procedure no-error.
    12615       undo, return error substitute( "Нет смены &1 &2 на объекте &3 &4.", parshift-date, parshift-name + string(parshift-num), parobj-type, parobj-code).
    12616     end.
    12617     if bf_shift-obj.status_ <> 'зкр':U  and
    12618        bf_shift-obj.status_ <> 'тек':U
    12619     then do:
    12620       run waitfram-hide in this-procedure no-error.
    12621       undo, return error substitute( "Смена &1 &2 на объекте &3 &4 имеет статус &5. Оформлять документы можно только в смене со статусом &6 или &7.",
    12622                                 bf_shift-obj.shift-date,
    12623                                 bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
    12624                                 bf_shift-obj.obj-type,
    12625                                 bf_shift-obj.obj-code,
    12626                                 bf_shift-obj.status_,
    12627                                 'зкр':U,
    12628                                 'тек':U).
    12629     end.
    12630     if parfact-date < bf_shift-obj.open-date
    12631     then do:
    12632       run waitfram-hide in this-procedure no-error.
    12633       undo, return error substitute( "Фактическая дата документа должна быть больше либо равна дате открытия смены. Фактическая дата: &1. Дата открытия смены &2 &3 на объекте &4 &5: &6.",
    12634                                parfact-date,
    12635                                bf_shift-obj.shift-date,
    12636                                bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
    12637                                bf_shift-obj.obj-type,
    12638                                bf_shift-obj.obj-code,
    12639                                bf_shift-obj.open-date).
    12640     end.
    12641     if bf_shift-obj.status_ = 'зкр':U
    12642     then do:
    12643       if parfact-date > bf_shift-obj.close-date
    12644       then do:
    12645         run waitfram-hide in this-procedure no-error.
    12646         undo, return error substitute( "Фактическая дата документа должна быть меньше либо равна дате закрытия смены. Фактическая дата: &1. Дата закрытия смены &2 &3 на объекте &4 &5: &6.",
    12647                                  parfact-date,
    12648                                  bf_shift-obj.shift-date,
    12649                                  bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
    12650                                  bf_shift-obj.obj-type,
    12651                                  bf_shift-obj.obj-code,
    12652                                  bf_shift-obj.close-date).
    12653       end.
    12654     end.
    12655   end.
    12656   end.
    12657   end procedure.
    12658   procedure fill-tt :
    12659   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    12660   define buffer bf_trn-doc       for ub.trn-doc.
    12661   define buffer bf_doc-line      for ub.doc-line.
    12662   define buffer bf_doc-line-attr for ub.doc-line-attr.
    12663   define buffer bf_gds-dtl       for ub.gds-dtl.
    12664   define buffer bf_parts         for ub.parts.
    12665   do on error undo, return error return-value :
    12666   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
    12667   for each lib-trn_ret-doc on error undo, return error return-value :
    12668     delete lib-trn_ret-doc.
    12669   end.
    12670   create lib-trn_ret-doc.
    12671   buffer-copy bf_trn-doc to lib-trn_ret-doc.
    12672   for each lib-trn_ret-line on error undo, return error return-value :
    12673     delete lib-trn_ret-line.
    12674   end.
    12675   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock on error undo, return error return-value :
    12676     create lib-trn_ret-line.
    12677     buffer-copy bf_doc-line to lib-trn_ret-line.
    12678     assign
    12679       lib-trn_ret-line.cst-code = bf_trn-doc.cst-code.
    12680   end.
    12681   for each lib-trn_ret-line-attr on error undo, return error return-value :
    12682     delete lib-trn_ret-line-attr.
    12683   end.
    12684   for each bf_doc-line-attr where bf_doc-line-attr.doc-code = bf_trn-doc.doc-code no-lock
    12685     on error undo, return error return-value :
    12686     create lib-trn_ret-line-attr.
    12687     buffer-copy bf_doc-line-attr to lib-trn_ret-line-attr.
    12688   end.
    12689   for each lib-trn_ret-dtl on error undo, return error return-value :
    12690     delete lib-trn_ret-dtl.
    12691   end.
    12692   for each bf_gds-dtl where bf_gds-dtl.doc-code = bf_trn-doc.doc-code on error undo, return error return-value :
    12693     create lib-trn_ret-dtl.
    12694     buffer-copy bf_gds-dtl to lib-trn_ret-dtl.
    12695   end.
    12696   for each lib-trn_ret-parts on error undo, return error return-value :
    12697     delete lib-trn_ret-parts.
    12698   end.
    12699   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code on error undo, return error return-value :
    12700     create lib-trn_ret-parts.
    12701     buffer-copy bf_parts to lib-trn_ret-parts.
    12702   end.
    12703   end.
    12704   end procedure.
    12705   procedure ie-date:
    12706     do
    12707     on error undo, return error substitute("&1 &2" , return-value , error-status :get-message(1) )
    12708     :
    12709       if bf_trn-doc.fact-date  <> ?
    12710         or bf_trn-doc.shift-date <> ?
    12711       then do:
    12712        if bf_trn-doc.fact-time = 0 or bf_trn-doc.fact-time = ? then
    12713           bf_trn-doc.fact-time = time.
    12714         if bf_trn-doc.fact-date = ?
    12715         and (bf_trn-doc.ext-doc-type = 'eo':U
    12716           or bf_trn-doc.ext-doc-type = 'ie':U
    12717           or bf_trn-doc.ext-doc-type = 'iv':U)
    12718         then do :
    12719   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    12721     (input  bf_trn-doc.obj-type
    12722     ,input  bf_trn-doc.obj-code
    12723     ,output bf_trn-doc.fact-date
    12724     )  .
    12725         end.
    12726         if g#esys and bf_trn-doc.fact-date = ?
    12727           then do:
    12728             bf_trn-doc.fact-date = now.
    12729             return.
    12730           end.
    12731         run gbl/chk-date.p
    12732             ( input bf_trn-doc.obj-type
    12733             , input bf_trn-doc.obj-code
    12734             , input bf_trn-doc.fact-date
    12735             , input bf_trn-doc.fact-time
    12736             , input bf_trn-doc.shift-date
    12737             , input bf_trn-doc.shift-num
    12738             , yes).
    12739         run corr-date in this-procedure
    12740             ( input bf_trn-doc.obj-type
    12741             , input bf_trn-doc.obj-code
    12742             , input bf_trn-doc.fact-date
    12743             , input bf_trn-doc.shift-date
    12744             , input bf_trn-doc.shift-num
    12745             , input bf_trn-doc.shift-name
    12746             ).
    12747         if bf_trn-doc.fact-date < v-today then do:
    12748           assign
    12749             bf_trn-doc.is-back-date = yes
    12750           .
    12751         end.
    12752         else do:
    12753           if bf_trn-doc.shift-date <> ? then do:
    12754   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
    12756     (input  bf_trn-doc.obj-type
    12757     ,input  bf_trn-doc.obj-code
    12758     ,output varobj-shift-date
    12759     ,output varobj-shift-num
    12760     ,output varobj-shift-name
    12761     )  .
    12762             if not ( bf_trn-doc.shift-date = varobj-shift-date
    12763                      and bf_trn-doc.shift-num  = varobj-shift-num
    12764                    )
    12765             then do:
    12766               assign
    12767                 bf_trn-doc.is-back-date = yes
    12768               .
    12769             end.
    12770           end.
    12771         end.
    12772       end.
    12773       else do:
    12774         run gbl/factdate.p
    12775           ( input        bf_trn-doc.obj-type
    12776            ,input        bf_trn-doc.obj-code
    12777            ,input-output bf_trn-doc.fact-date
    12778            ,input-output bf_trn-doc.fact-time
    12779            ,input-output bf_trn-doc.shift-date
    12780            ,input-output bf_trn-doc.shift-num
    12781            ,input-output bf_trn-doc.shift-name
    12782            ,input        NOT(g#auto OR g#oxml OR g#esys OR g#news)
    12783           ).
    12784           run str/chk-back.p
    12785             (input bf_trn-doc.doc-code
    12786             ,input bf_trn-doc.fact-date
    12787             ) no-error .
    12788             if error-status :error then do:
    12789             message
    12790               vss-workfile vss-revision vss-description skip
    12791               error-status :get-message(1) skip
    12792               return-value skip
    12793               ""
    12794               view-as alert-box error
    12795             .
    12796             return error return-value .
    12797             end.
    12798       end.
    12799     end.
    12800   end procedure.
    12801   procedure inv-nakl-reserv :
    12802     do on error undo, return error return-value :
    12803       run waitfram-show in this-procedure ( input substitute( "Заполнение документа инвентаризации. Время: &1"
    12804                                                             , string( time - vartime, "hh:mm:ss":U ) ) ) no-error.
    12805   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_filinvon in g#lib-trn2
    12806   (input  bf_trn-doc.doc-code,
    12807    input  bf_trn-doc.status_,
    12808    input  bf_trn-doc.flag_,
    12809    input  yes,
    12810    input  this-procedure,
    12811    output parchg-inv,
    12812    output table gds-list
    12813   )
    12814   .
    12815   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-inv in g#lib-trn
    12816   (
    12817   input recid(bf_trn-doc),
    12818   input this-procedure
    12819   )
    12820   .
    12821       run str/clcsumga.p (input bf_trn-doc.doc-code).
    12822       assign
    12823         bf_trn-doc.flag_   = varflag
    12824         bf_trn-doc.status_ = varstatus.
    12825     end.
    12826   end procedure.
    12827   procedure hold-check:
    12828   define buffer bf-src_doc-line for ub.doc-line.
    12829   define buffer bf-src_goods    for ub.goods.
    12830   define buffer bf-src_units    for ub.units.
    12831   define buffer bf-src_gds-dtl  for ub.gds-dtl.
    12832   define buffer bf-src_parts    for ub.parts.
    12833   do on error undo, return error return-value :
    12834     for each bf-src_doc-line where bf-src_doc-line.doc-code = bf_trn-doc.doc-code on error undo, return error return-value :
    12835       find first bf-src_goods where bf-src_goods.artic     = bf-src_doc-line.artic     and
    12836                                     bf-src_goods.prod-type = bf-src_doc-line.prod-type and
    12837                                     bf-src_goods.prod-code = bf-src_doc-line.prod-code no-lock.
    12838       find first bf-src_units where bf-src_units.unit-name = bf-src_goods.unit-base no-lock.
    12839       if lookup('2ед':U, bf-src_units.type) <> 0
    12840       then do:
    12841         undo, return error substitute( "В документе межфирменного перемещения не допускается товар с двумя единицами измерения. Товар: &1 &2 &3", bf-src_goods.artic, bf-src_goods.prod-type, bf-src_goods.prod-code).
    12842       end.
    12843       if lookup('сер':U, bf-src_units.type) <> 0
    12844       then do:
    12845         undo, return error substitute( "В документе межфирменного перемещения не допускается серийный товар. Товар: &1 &2 &3",bf-src_goods.artic, bf-src_goods.prod-type, bf-src_goods.prod-code).
    12846       end.
    12847       if bf-src_doc-line.fact-qnty > bf-src_doc-line.doc-qnty
    12848       then do:
    12849         undo, return error substitute( "Фактическое количество по строке &1 не может быть больше документарного &2. Товар: &3 &4 &5", bf-src_doc-line.fact-qnty, bf-src_doc-line.doc-qnty, bf-src_goods.artic, bf-src_goods.prod-type, bf-src_goods.prod-code).
    12850       end.
    12851     end.
    12852     for each bf-src_gds-dtl where bf-src_gds-dtl.doc-code = bf_trn-doc.doc-code on error undo, return error return-value:
    12853       find first bf_gds-dtl where bf_gds-dtl.doc-code  = bf-src_gds-dtl.doc-code  and
    12854                                   bf_gds-dtl.artic     = bf-src_gds-dtl.artic     and
    12855                                   bf_gds-dtl.prod-type = bf-src_gds-dtl.prod-type and
    12856                                   bf_gds-dtl.prod-code = bf-src_gds-dtl.prod-code and
    12857                                   recid(bf_gds-dtl)    <> recid(bf-src_gds-dtl)   no-error.
    12858       if available bf_gds-dtl
    12859       then do:
    12860         undo, return error substitute( "В документе межфирменного перемещения не допускается чтобы в одном документе товар шел по нескольким признакам. Товар: &1 &2 &3", bf_gds-dtl.artic, bf_gds-dtl.prod-type, bf_gds-dtl.prod-code).
    12861       end.
    12862       if bf-src_gds-dtl.fact-qnty > bf-src_gds-dtl.doc-qnty
    12863       then do:
    12864         undo, return error substitute( "Фактическое количество по признаку &1 не может быть больше документарного &2. Товар: &3 &4 &5", bf-src_gds-dtl.fact-qnty, bf-src_gds-dtl.doc-qnty, bf-src_goods.artic, bf-src_goods.prod-type, bf-src_goods.prod-code).
    12865       end.
    12866     end.
    12867     for each bf-src_parts where bf-src_parts.out-code = bf_trn-doc.doc-code on error undo, return error return-value:
    12868       if bf-src_parts.fact-qnty > bf-src_parts.qnty
    12869       then do:
    12870         undo, return error substitute( "Фактическое количество по партии &1 не может быть больше документарного &2. Товар: &3 &4 &5", bf-src_parts.fact-qnty, bf-src_parts.qnty, bf-src_goods.artic, bf-src_goods.prod-type, bf-src_goods.prod-code).
    12871       end.
    12872     end.
    12873   end.
    12874   end procedure.
    12875   procedure close-rvs :
    12876     define input  parameter p-trn-doc-code like ub.trn-doc.doc-code   no-undo.
    12877     define input  parameter p-rvs-type     like ub.rvs-doc.rvs-type   no-undo.
    12878     define input  parameter p-fact-date    like ub.trn-doc.fact-date  no-undo.
    12879     define input  parameter p-fact-time    like ub.trn-doc.fact-time  no-undo.
    12880     define input  parameter p-shift-date   like ub.trn-doc.shift-date no-undo.
    12881     define input  parameter p-shift-num    like ub.trn-doc.shift-num  no-undo.
    12882     define input  parameter p-shift-name   like ub.trn-doc.shift-name no-undo.
    12883     do
    12884     on error  undo, return error substitute( "&1 (close-rvs). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12885     on stop   undo, return error substitute( "&1 (close-rvs). stop", vss-workfile )
    12886     on endkey undo, return error substitute( "&1 (close-rvs). endkey", vss-workfile )
    12887     :
    12888       define buffer buf_rvs-doc for ub.rvs-doc .
    12889       for each buf_rvs-doc
    12890         where buf_rvs-doc.rvs-type = p-rvs-type
    12891           and buf_rvs-doc.out-code = p-trn-doc-code
    12892       :
    12893         run str/rvs-stat.p
    12894           ( input parparentproc
    12895            ,input recid(buf_rvs-doc)
    12896            ,input "unfroze":U
    12897           ) no-error.
    12898         if error-status :error then do:
    12899           undo, return error substitute( "Ошибка при изменении статуса &1.", return-value ).
    12900         end.
    12901         assign
    12902           buf_rvs-doc.fact-date  = p-fact-date
    12903           buf_rvs-doc.fact-time  = p-fact-time
    12904           buf_rvs-doc.shift-date = p-shift-date
    12905           buf_rvs-doc.shift-num  = p-shift-num
    12906           buf_rvs-doc.shift-name = p-shift-name
    12907         .
    12908   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
    12909                         input recid(buf_rvs-doc) ,
    12910                         input no ) no-error .
    12911         if error-status :error then do:
    12912           undo, return error  substitute( "Ошибка при закрытии документа сверки: &1 &2.", buf_rvs-doc.rvs-code, return-value ).
    12913         end.
    12914         release buf_rvs-doc no-error .
    12915         if error-status :error then do:
    12916           undo, return error  substitute( "Ошибка при закрытии документа сверки: &1 &2.", buf_rvs-doc.rvs-code, return-value ).
    12917         end.
    12918       end.
    12919     end.
    12920   end procedure.
    12921   procedure verify-assort-pol :
    12922   define input  parameter p-artic     as character no-undo .
    12923   define input  parameter p-prod-type as character no-undo .
    12924   define input  parameter p-prod-code as integer   no-undo .
    12925   define variable v-min-ass-exist  as logical   no-undo init false .
    12926   define variable var-ok-assort-pol as logical   no-undo .
    12927   define variable var-mess-assort-pol as character no-undo .
    12928   define buffer buf_goods for ub.goods  .
    12929     do
    12930     on error undo, return error return-value
    12931     :
