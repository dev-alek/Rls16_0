     4646   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4647   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4648   define variable par-type          as character no-undo.
     4649   define variable v-value-character as character no-undo .
     4650   define variable v-value-date      as date      no-undo .
     4651   define variable v-value-decimal   as decimal   no-undo .
     4652   define variable v-value-integer   as integer   no-undo .
     4653   define variable v-value-logical   as logical   no-undo .
     4654   def var vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4655   procedure gen-key-rec :
     4656     define input  parameter p-tbl-name    as character no-undo.
     4657     define input  parameter p-bh_tbl-name as handle    no-undo.
     4658     define output parameter p-key-rec     as character no-undo.
     4659     do
     4660     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4661     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     4662     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     4663     :
     4664       define variable fh               as handle    no-undo .
     4665       define variable v-ok             as logical   no-undo .
     4666       define variable v-inform         as character no-undo .
     4667       define variable v-ind            as integer   no-undo .
     4668       define variable v-idx-field-qnty as integer   no-undo .
     4669       if p-tbl-name = ?
     4670         or p-tbl-name = "":U
     4671       then do:
     4672         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info36 ).
     4673       end.
     4674       if not p-bh_tbl-name:available then do:
     4675         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info36, p-tbl-name ).
     4676       end.
     4677       assign
     4678         p-key-rec = p-tbl-name
     4679         v-inform  = p-bh_tbl-name:index-information(1)
     4680         v-ind     = 2
     4681       .
     4682       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4683       on error undo, return error
     4684       :
     4685         assign
     4686           v-inform = p-bh_tbl-name:index-information( v-ind )
     4687           v-ind    = v-ind + 1
     4688         .
     4689       end.
     4690       if v-inform = ?
     4691         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4692         or entry( 3, v-inform, ",":U ) <> "1":U
     4693       then do:
     4694         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info36, p-tbl-name ).
     4695       end.
     4696       else do:
     4697         assign
     4698           v-idx-field-qnty = num-entries( v-inform ) - 4
     4699         .
     4700         if v-idx-field-qnty < 2 then do:
     4701           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info36, v-inform, p-tbl-name ).
     4702         end.
     4703         do v-ind = 1 to v-idx-field-qnty by 2
     4704         on error undo, return error
     4705         :
     4706           assign
     4707             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     4708             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     4709           .
     4710         end.
     4711       end.
     4712       if p-key-rec = ? then do:
     4713         assign
     4714           p-key-rec = "":U
     4715         .
     4716         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info36, p-tbl-name ).
     4717       end.
     4718     end.
     4719     return.
     4720   end procedure.
     4721   procedure gen-where-keyr-tab :
     4722     define input  parameter i-tableSerach as character no-undo.
     4723     define input  parameter i-tablekey   as character  no-undo.
     4724     define input  parameter p-key-rec    as character  no-undo.
     4725     define input  parameter p-key-handle as handle     no-undo .
     4726     define input  parameter p-db-name    as character  no-undo .
     4727     define input  parameter p-tt-handle  as handle     no-undo .
     4728     define output parameter o-Where      as character  no-undo.
     4729     do
     4730     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4731     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4732     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     4733     :
     4734       define variable v-full-tbl-name  as character no-undo .
     4735       define variable bh_tbl-name      as handle    no-undo .
     4736       define variable fh_key           as handle    no-undo .
     4737       define variable fh_search        as handle    no-undo .
     4738       define variable v-field-num      as integer   no-undo .
     4739       define variable v-count-fld      as integer   no-undo .
     4740       define variable v-inform         as character no-undo .
     4741       define variable v-ind            as integer   no-undo .
     4742       define variable v-idx-field-qnty as integer   no-undo .
     4743       define variable v-field-name     as character no-undo .
     4744       define variable v-field-val      as character no-undo .
     4745       define variable v-word-link      as character no-undo .
     4746       define variable vTable           as character no-undo.
     4747       define variable bh_tbl-key       as handle    no-undo .
     4748       assign
     4749         p-key-rec = trim( p-key-rec )
     4750       .
     4751       if p-key-handle <> ? then do:
     4752         if not valid-handle(p-key-handle)
     4753            or p-key-handle:type <> "buffer"
     4754         then do:
     4755           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info36 ).
     4756         end.
     4757         if num-entries( p-key-rec, chr(3) ) > 1
     4758           or p-key-rec = ?
     4759           or p-key-rec = "":U
     4760         then do:
     4761           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info36, p-key-rec ).
     4762         end.
     4763       end.
     4764       else do:
     4765         if p-key-rec = ?
     4766           or p-key-rec = "":U
     4767         then do:
     4768           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info36 ).
     4769         end.
     4770       end.
     4771       assign
     4772         vTable = entry( 1 , p-key-rec, chr(3) )
     4773       .
     4774       if p-tt-handle <> ?
     4775         and ( not valid-handle(p-tt-handle)
     4776               or p-tt-handle:type <> "buffer"
     4777             )
     4778       then do:
     4779         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info36, vTable, chr(10) ).
     4780       end.
     4781       if p-tt-handle = ? then do:
     4782         assign
     4783           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     4784         .
     4785         create buffer bh_tbl-name for table v-full-tbl-name .
     4786       end.
     4787       else do:
     4788         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4789       end.
     4790       assign
     4791         v-inform = bh_tbl-name:index-information(1)
     4792         v-ind    = 2
     4793       .
     4794       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4795       on error undo, return error
     4796       :
     4797         assign
     4798           v-inform = bh_tbl-name:index-information( v-ind )
     4799           v-ind    = v-ind + 1
     4800         .
     4801       end.
     4802       if v-inform = ?
     4803         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4804         or entry( 3, v-inform, ",":U ) <> "1":U
     4805       then do:
     4806         delete object bh_tbl-name no-error.
     4807         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info36, vTable ).
     4808       end.
     4809       assign
     4810         v-idx-field-qnty = num-entries( v-inform ) - 4
     4811       .
     4812       if v-idx-field-qnty < 2 then do:
     4813         delete object bh_tbl-name no-error.
     4814         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info36, v-inform, vTable ).
     4815       end.
     4816       assign
     4817         o-where     = "where":U
     4818         v-word-link = "":U
     4819         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     4820         v-count-fld = 0
     4821       .
     4822       if i-tablekey ne "" and i-tablekey ne ?
     4823       then do:
     4824         assign
     4825           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     4826         .
     4827         create buffer bh_tbl-key for table v-full-tbl-name .
     4828       end.
     4829       if i-tableSerach ne "" and i-tableSerach ne ?
     4830       then do:
     4831         delete object bh_tbl-name no-error.
     4832         assign
     4833           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     4834         .
     4835         create buffer bh_tbl-name for table v-full-tbl-name .
     4836       end.
     4837       block_where:
     4838       do v-ind = 1 to v-idx-field-qnty by 2
     4839       on error undo, return error
     4840       :
     4841         assign
     4842           v-count-fld = v-count-fld + 1
     4843         .
     4844         if p-key-handle = ?
     4845           and v-count-fld > v-field-num
     4846         then do:
     4847           leave block_where.
     4848         end.
     4849         define variable VfieldKeyTable as handle no-undo.
     4850         assign
     4851           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     4852           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     4853         .
     4854         if     bh_tbl-key ne ?
     4855         then do:
     4856            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     4857            if VfieldKeyTable eq ?
     4858            then next block_where.
     4859         end.
     4860         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     4861         then
     4862            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     4863         else
     4864            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     4865         if p-key-handle = ? then do:
     4866           assign
     4867             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     4868           .
     4869         end.
     4870         else do:
     4871           assign
     4872             fh_key = p-key-handle:buffer-field( v-field-name )
     4873           .
     4874           if fh_key = ?
     4875             or not valid-handle( fh_key )
     4876           then do:
     4877             delete object bh_tbl-name.
     4878             if     bh_tbl-key ne ?
     4879             then
     4880                delete object bh_tbl-key.
     4881             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info36, p-key-handle:name, v-field-name ).
     4882           end.
     4883           assign
     4884             v-field-val = fh_key:buffer-value
     4885           .
     4886         end.
     4887         if fh_search:data-type ="character":U then do:
     4888           assign
     4889             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     4890             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     4891             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     4892             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     4893             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     4894             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     4895             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     4896             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     4897             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     4898             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     4899             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     4900             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     4901             v-field-val = substitute( '"&1"', v-field-val )
     4902           .
     4903         end.
     4904         assign
     4905           o-where = substitute( "&1 &2", o-where, v-field-val )
     4906         .
     4907         if v-word-link = "":U then do:
     4908           assign
     4909             v-word-link = "and":U
     4910           .
     4911         end.
     4912       end.
     4913       delete object bh_tbl-name.
     4914       if     bh_tbl-key ne ?
     4915       then
     4916          delete object bh_tbl-key.
     4917       if p-key-handle = ?
     4918         and v-count-fld <> v-field-num
     4919       then do:
     4920         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info36, vTable ).
     4921       end.
     4922     end.
     4923   end procedure.
     4924   procedure gen-hn-keyr-tab :
     4925     define input  parameter i-tableSerach as character no-undo.
     4926     define input  parameter i-tablekey   as character no-undo.
     4927     define input  parameter p-key-rec    as character no-undo.
     4928     define input  parameter p-key-handle as handle    no-undo .
     4929     define input  parameter p-db-name    as character no-undo .
     4930     define input  parameter p-tt-handle  as handle    no-undo .
     4931     define input  parameter p-stts-lock  as integer   no-undo .
     4932     define output parameter o-hn         as handle    no-undo.
     4933     define variable v-full-tbl-name as character no-undo.
     4934     define variable v-where         as character no-undo.
     4935     define variable bh_tbl-name     as handle    no-undo.
     4936     define variable vTable          as character no-undo.
     4937     do
     4938     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4939     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4940     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     4941         run gen-where-keyr-tab(i-tableSerach,
     4942                                i-tablekey,
     4943                                p-key-rec,
     4944                                p-key-handle,
     4945                                p-db-name,
     4946                                p-tt-handle,
     4947                                output v-where).
     4948         if i-tableSerach ne "" and i-tableSerach ne ?
     4949         then do:
     4950            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     4951            create buffer bh_tbl-name for table v-full-tbl-name .
     4952         end.
     4953         else do:
     4954            if p-tt-handle = ? then do:
     4955               assign
     4956                  vTable = entry( 1 , p-key-rec, chr(3) )
     4957               .
     4958               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     4959               create buffer bh_tbl-name for table v-full-tbl-name .
     4960            end.
     4961            else do:
     4962               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4963            end.
     4964         end.
     4965         if p-tt-handle = ? then do:
     4966            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     4967         end.
     4968         else do:
     4969            bh_tbl-name:find-first( v-where ) no-error .
     4970         end.
     4971         o-hn = bh_tbl-name.
     4972      end.
     4973   end procedure.
     4974   procedure gen-hn-keyr :
     4975     define input  parameter p-key-rec    as character no-undo.
     4976     define input  parameter p-key-handle as handle    no-undo .
     4977     define input  parameter p-db-name    as character no-undo .
     4978     define input  parameter p-tt-handle  as handle    no-undo .
     4979     define input  parameter p-stts-lock  as integer   no-undo .
     4980     define output parameter o-hn         as handle    no-undo.
     4981     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     4982   end.
     4983   procedure gen-row-keyr :
     4984     define input  parameter p-key-rec    as character no-undo.
     4985     define input  parameter p-key-handle as handle    no-undo .
     4986     define input  parameter p-db-name    as character no-undo .
     4987     define input  parameter p-tt-handle  as handle    no-undo .
     4988     define input  parameter p-stts-lock  as integer   no-undo .
     4989     define output parameter p-tbl-row    as rowid     no-undo.
     4990     define output parameter p-tbl-name   as character no-undo.
     4991     define variable vHn as handle no-undo.
     4992       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     4993       p-tbl-row = if vHn:available then vHn:rowid else ?.
     4994       p-tbl-name =  vHn:table.
     4995       delete object vHn no-error.
     4996     if p-tbl-row = ? then do:
     4997       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info36, p-tbl-name, p-key-rec ).
     4998     end.
     4999     else do:
     5000       return.
     5001     end.
     5002   end procedure.
     5003   procedure gen-key-fv :
     5004     define input  parameter p-key-rec    as character no-undo .
     5005     define output parameter p-field-list as character no-undo .
     5006     define output parameter p-value-list as character no-undo.
     5007     do
     5008     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5009     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5010     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5011     :
     5012       define variable v-full-tbl-name  as character no-undo .
     5013       define variable bh_tbl-name      as handle    no-undo .
     5014       define variable v-tbl-name       as character no-undo .
     5015       define variable v-field-num      as integer   no-undo .
     5016       define variable v-count-fld      as integer   no-undo .
     5017       define variable v-inform         as character no-undo .
     5018       define variable v-ind            as integer   no-undo .
     5019       define variable v-idx-field-qnty as integer   no-undo .
     5020       define variable v-delim-key      as character no-undo .
     5021       if p-key-rec = ?
     5022         or p-key-rec = "":U
     5023       then do:
     5024         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info36 ).
     5025       end.
     5026       assign
     5027         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5028         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5029       .
     5030       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5031       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info36 ).
     5032       assign
     5033         v-inform = bh_tbl-name:index-information(1)
     5034         v-ind    = 2
     5035       .
     5036       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5037       on error undo, return error
     5038       :
     5039         assign
     5040           v-inform = bh_tbl-name:index-information( v-ind )
     5041           v-ind    = v-ind + 1
     5042         .
     5043       end.
     5044       if v-inform = ?
     5045         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5046         or entry( 3, v-inform, ",":U ) <> "1":U
     5047       then do:
     5048         delete object bh_tbl-name no-error.
     5049         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info36, v-tbl-name ).
     5050       end.
     5051       assign
     5052         v-idx-field-qnty = num-entries( v-inform ) - 4
     5053       .
     5054       if v-idx-field-qnty < 2 then do:
     5055         delete object bh_tbl-name no-error.
     5056         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info36, v-inform, v-tbl-name ).
     5057       end.
     5058       assign
     5059         p-field-list = "":U
     5060         p-value-list = "":U
     5061         v-delim-key  = "":U
     5062         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5063         v-count-fld  = 0
     5064       .
     5065       block_where:
     5066       do v-ind = 1 to v-idx-field-qnty by 2
     5067       on error undo, return error
     5068       :
     5069         assign
     5070           v-count-fld = v-count-fld + 1
     5071         .
     5072         if v-count-fld > v-field-num then do:
     5073           leave block_where.
     5074         end.
     5075         assign
     5076           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5077           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5078         .
     5079         if v-ind = 1 then do:
     5080           assign
     5081             v-delim-key = chr(3)
     5082           .
     5083         end.
     5084       end.
     5085       delete object bh_tbl-name.
     5086       if v-count-fld <> v-field-num then do:
     5087         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info36, v-tbl-name ).
     5088       end.
     5089     end.
     5090   end procedure.
     5091   procedure gen-key-field :
     5092     define input  parameter p-table      as character no-undo .
     5093     define output parameter p-field-list as character no-undo .
     5094     do
     5095     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5096     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5097     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5098     :
     5099       define variable v-full-tbl-name  as character no-undo .
     5100       define variable bh_tbl-name      as handle    no-undo .
     5101       define variable v-tbl-name       as character no-undo .
     5102       define variable v-field-num      as integer   no-undo .
     5103       define variable v-count-fld      as integer   no-undo .
     5104       define variable v-inform         as character no-undo .
     5105       define variable v-ind            as integer   no-undo .
     5106       define variable v-idx-field-qnty as integer   no-undo .
     5107       define variable v-delim-key      as character no-undo .
     5108       if p-table = ?
     5109         or p-table = "":U
     5110       then do:
     5111         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info36 ).
     5112       end.
     5113       assign
     5114         v-tbl-name      = p-table
     5115         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5116       .
     5117       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5118       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info36 ).
     5119       assign
     5120         v-inform = bh_tbl-name:index-information(1)
     5121         v-ind    = 2
     5122       .
     5123       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5124       on error undo, return error
     5125       :
     5126         assign
     5127           v-inform = bh_tbl-name:index-information( v-ind )
     5128           v-ind    = v-ind + 1
     5129         .
     5130       end.
     5131       if v-inform = ?
     5132         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5133         or entry( 3, v-inform, ",":U ) <> "1":U
     5134       then do:
     5135         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info36, v-tbl-name ).
     5136       end.
     5137       assign
     5138         v-idx-field-qnty = num-entries( v-inform ) - 4
     5139       .
     5140       if v-idx-field-qnty < 2 then do:
     5141         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info36, v-inform, v-tbl-name ).
     5142       end.
     5143       assign
     5144         p-field-list = "":U
     5145         v-delim-key  = "":U
     5146         v-count-fld  = 0
     5147       .
     5148       block_where:
     5149       do v-ind = 1 to v-idx-field-qnty by 2
     5150       on error undo, return error
     5151       :
     5152         assign
     5153           v-count-fld = v-count-fld + 1
     5154         .
     5155         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     5156         if v-ind = 1 then do:
     5157           assign
     5158             v-delim-key = chr(3)
     5159           .
     5160         end.
     5161       end.
     5162       delete object bh_tbl-name.
     5163     end.
     5164   end procedure.
     5165   def var vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5166   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     5167   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     5168   def var vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5169   function getattrUtdex returns char
     5170   (idb-num   as integer,
     5171    idoc-id   as integer,
     5172    iattrcode as character,
     5173    iExValue  as character  ):
     5174      define buffer utd-attr for utd-attr.
     5175      find first utd-attr where utd-attr.db-num eq idb-num
     5176                            and utd-attr.doc-id eq idoc-id
     5177                            and utd-attr.attr-code eq iattrcode
     5178      no-lock no-error.
     5179      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     5180   end.
     5181   function getattrUtd returns char
     5182   (idb-num   as integer,
     5183    idoc-id   as integer,
     5184    iattrcode as character ):
     5185     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     5186   end.
     5187   function setattrUtd returns logical
     5188   (idb-num   as integer,
     5189    idoc-id   as integer,
     5190    iattrcode as character,
     5191    iattrval  as character ):
     5192      define buffer utd-attr for utd-attr.
     5193      find first utd-attr where utd-attr.db-num eq idb-num
     5194                            and utd-attr.doc-id eq idoc-id
     5195                            and utd-attr.attr-code eq iattrcode
     5196      no-lock no-error.
     5197      if not available utd-attr
     5198      then do:
     5199         create utd-attr.
     5200         assign
     5201            utd-attr.db-num    = idb-num
     5202            utd-attr.doc-id    = idoc-id
     5203            utd-attr.attr-code = iattrcode
     5204            utd-attr.attr-value = iattrval
     5205         .
     5206      end.
     5207      else do:
     5208         if utd-attr.attr-value ne iattrval
     5209         then do:
     5210            find current utd-attr exclusive-lock no-error.
     5211            if available utd-attr
     5212            then
     5213               utd-attr.attr-value = iattrval.
     5214         end.
     5215      end.
     5216      release utd-attr.
     5217   end.
     5218   function GetAttrUtdlinesEx returns char
     5219   (idb-num   as integer,
     5220    idoc-id   as integer,
     5221    ilinenum  as integer,
     5222    iattrcode as character,
     5223    iExValue  as character  ):
     5224      define buffer utd-lines-attr for utd-lines-attr.
     5225      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     5226                                  and utd-lines-attr.doc-id    eq idoc-id
     5227                                  and utd-lines-attr.lineNum   eq ilineNum
     5228                                  and utd-lines-attr.attr-code eq iattrcode
     5229      no-lock no-error.
     5230      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     5231   end.
     5232   function GetAttrUtdlines returns char
     5233   (idb-num   as integer,
     5234    idoc-id   as integer,
     5235    ilinenum  as integer,
     5236    iattrcode as character ):
     5237      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     5238   end.
     5239   function setattrUtdlines returns logical
     5240   (idb-num   as integer,
     5241    idoc-id   as integer,
     5242    ilinenum  as integer,
     5243    iattrcode as character,
     5244    iattrval  as character ):
     5245      define buffer utd-lines-attr for utd-lines-attr.
     5246      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     5247                                  and utd-lines-attr.doc-id    eq idoc-id
     5248                                  and utd-lines-attr.lineNum   eq ilineNum
     5249                                  and utd-lines-attr.attr-code eq iattrcode
     5250      no-lock no-error.
     5251      if not available utd-lines-attr
     5252      then do:
     5253         if iattrval ne ?
     5254            and iattrval ne ""
     5255         then do:
     5256            create utd-lines-attr.
     5257            assign
     5258               utd-lines-attr.db-num    = idb-num
     5259               utd-lines-attr.doc-id    = idoc-id
     5260               utd-lines-attr.lineNum   = ilineNum
     5261               utd-lines-attr.attr-code = iattrcode
     5262               utd-lines-attr.attr-value = iattrval
     5263            .
     5264         end.
     5265      end.
     5266      else do:
     5267         if utd-lines-attr.attr-value ne iattrval
     5268         then do:
     5269            find current utd-lines-attr exclusive-lock no-error.
     5270            if available utd-lines-attr
     5271            then do:
     5272               if    iattrval eq ?
     5273                  or iattrval eq ""
     5274               then do:
     5275                  delete utd-lines-attr.
     5276               end.
     5277               else do:
     5278                  utd-lines-attr.attr-value = iattrval.
     5279               end.
     5280            end.
     5281         end.
     5282      end.
     5283      release utd-lines-attr.
     5284   end.
