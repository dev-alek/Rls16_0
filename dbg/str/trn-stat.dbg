     5560                       then do:
     5561                           assign
     5562                               p-out-string = p-out-string + " ":U
     5563                           .
     5564                       end.
     5565                       when chr(3)
     5566                       then do:
     5567                           assign
     5568                               p-out-string = p-out-string + " ":U
     5569                           .
     5570                       end.
     5571                       when chr(4)
     5572                       then do:
     5573                           assign
     5574                               p-out-string = p-out-string + " ":U
     5575                           .
     5576                       end.
     5577                       when chr(5)
     5578                       then do:
     5579                           assign
     5580                               p-out-string = p-out-string + " ":U
     5581                           .
     5582                       end.
     5583                       when chr(6)
     5584                       then do:
     5585                           assign
     5586                               p-out-string = p-out-string + " ":U
     5587                           .
     5588                       end.
     5589                       when chr(7)
     5590                       then do:
     5591                           assign
     5592                               p-out-string = p-out-string + " ":U
     5593                           .
     5594                       end.
     5595                       when chr(8)
     5596                       then do:
     5597                           assign
     5598                               p-out-string = p-out-string + " ":U
     5599                           .
     5600                       end.
     5601                       when chr(9)
     5602                       then do:
     5603                           assign
     5604                               p-out-string = p-out-string + " ":U
     5605                           .
     5606                       end.
     5607                       when chr(29)
     5608                       then do:
     5609                           assign
     5610                               p-out-string = p-out-string + " ":U
     5611                           .
     5612                       end.
     5613                       when chr(10)
     5614                       then do:
     5615                           assign
     5616                               p-out-string = p-out-string + " ":U
     5617                           .
     5618                       end.
     5619                       when chr(13)
     5620                       then do:
     5621                           assign
     5622                               p-out-string = p-out-string + " ":U
     5623                           .
     5624                       end.
     5625                       otherwise do:
     5626                           assign
     5627                               p-out-string = p-out-string + v-current-char
     5628                           .
     5629                       end.
     5630                   end case.
     5631               end.
     5632           end.
     5633       end case.
     5634   end.
     5635   end .
     5636   procedure xmlchar-decode :
     5637   define input parameter p-in-string      as character        no-undo.
     5638   define output parameter p-out-string    as character        no-undo.
     5639       define variable v-position      as integer      no-undo.
     5640       define variable v-last-position as integer      no-undo.
     5641       define variable v-temp-integer  as integer      no-undo.
     5642       define variable v-current-char  as character    no-undo.
     5643       define variable v-next-char     as character    no-undo.
     5644       define variable v-success       as logical      no-undo.
     5645   do
     5646   on error undo, return error
     5647   :
     5648       assign
     5649           p-out-string = "":U
     5650           v-position   = 0
     5651       .
     5652       replace-cycle:
     5653       do while yes
     5654       on error undo, return error
     5655       :
     5656           assign
     5657               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     5658           .
     5659           if v-last-position <= v-position
     5660           then do:
     5661               if v-position = 0
     5662               then do:
     5663                   assign
     5664                       p-out-string = p-in-string
     5665                   .
     5666               end.
     5667               else do:
     5668                   assign
     5669                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     5670                   .
     5671               end.
     5672               leave replace-cycle.
     5673           end.
     5674           else do:
     5675               assign
     5676                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     5677                   v-position      = v-last-position
     5678                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     5679               .
     5680               if v-current-char = "#":U
     5681               then do:
     5682                   assign
     5683                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     5684                   .
     5685                   if v-last-position > 0
     5686                   then do:
     5687                       run xmlchar-read-integer in this-procedure
     5688                        (
     5689                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     5690                           , output v-temp-integer
     5691                           , output v-success
     5692                       ).
     5693                       if v-success = yes
     5694                       and v-temp-integer >= 1
     5695                       and v-temp-integer <= 255
     5696                       then do:
     5697                           assign
     5698                               p-out-string = p-out-string + chr( v-temp-integer )
     5699                               v-position   = v-last-position + 1
     5700                           .
     5701                       end.
     5702                       else do:
     5703                           assign
     5704                               p-out-string = p-out-string + "&":U
     5705                               v-position   = v-position   + 1
     5706                           .
     5707                       end.
     5708                   end.
     5709                   else do:
     5710                       assign
     5711                           p-out-string = p-out-string + "&":U
     5712                           v-position   = v-position   + 1
     5713                       .
     5714                   end.
     5715               end.
     5716               else do:
     5717                   case substring( p-in-string, v-position + 1, 3 )
     5718                   :
     5719                       when "lt;":U
     5720                       then do:
     5721                           assign
     5722                               p-out-string = p-out-string + "<":U
     5723                               v-position   = v-position   + 3
     5724                           .
     5725                       end.
     5726                       when "gt;":U
     5727                       then do:
     5728                           assign
     5729                               p-out-string = p-out-string + ">":U
     5730                               v-position   = v-position   + 3
     5731                           .
     5732                       end.
     5733                       otherwise do:
     5734                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     5735                           then do:
     5736                               assign
     5737                                   p-out-string = p-out-string + "&":U
     5738                                   v-position   = v-position   + 4
     5739                               .
     5740                           end.
     5741                           else do:
     5742                               case substring( p-in-string, v-position + 1, 5 )
     5743                               :
     5744                                   when "quot;":U
     5745                                   then do:
     5746                                       assign
     5747                                           p-out-string = p-out-string + '"':U
     5748                                           v-position   = v-position   + 5
     5749                                       .
     5750                                   end.
     5751                                   when "apos;":U
     5752                                   then do:
     5753                                       assign
     5754                                           p-out-string = p-out-string + "'":U
     5755                                           v-position   = v-position   + 5
     5756                                       .
     5757                                   end.
     5758                                   otherwise do:
     5759                                       assign
     5760                                           p-out-string = p-out-string + "&":U
     5761                                       .
     5762                                   end.
     5763                               end case.
     5764                           end.
     5765                       end.
     5766                   end case.
     5767               end.
     5768           end.
     5769       end.
     5770   end.
     5771   end .
     5772   procedure xmlchar-read-integer :
     5773   define input parameter p-input-string      as character        no-undo.
     5774   define output parameter p-output-integer   as integer          no-undo.
     5775   define output parameter p-success       as logical          no-undo.
     5776   do
     5777   on error undo, return error
     5778   :
     5779       assign
     5780           p-output-integer = integer( p-input-string )
     5781       no-error.
     5782       if error-status :error
     5783       then do:
     5784           assign
     5785               p-success           = no
     5786               p-output-integer    = 0
     5787           .
     5788       end.
     5789       else do:
     5790           assign
     5791               p-success           = yes
     5792           .
     5793       end.
     5794   end.
     5795   end.
     5796   define variable mMRCCode  as logical    no-undo.
     5797   define variable mTypeMark as character  no-undo.
     5798   function IS-NeedMark returns logical
     5799   ( input ib-code as integer  ,
     5800     input ib-str as character ):
     5801      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     5802      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     5803                                    and buf_prod-bc-attr.b-str  eq ib-str
     5804                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     5805        no-lock no-error.
     5806      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     5807   end.
     5808   function repTegforDm return char
     5809   (iDM as char ):
     5810       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     5811       define variable vteg as character no-undo.
     5812       define variable oDM as character no-undo.
     5813       define variable vi as integer no-undo.
     5814       oDM = iDm.
     5815       do vi = 1 to num-entries(vTeglist):
     5816          vTeg = entry(vi,vTeglist).
     5817          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     5818       end.
     5819       return oDM.
     5820   end.
     5821   function repSpecSimbforDm return char
     5822   (iDM as char ):
     5823       define variable oDM as character no-undo.
     5824     run
     5825       xmlchar-decode(iDM, output oDM).
     5826     return repTegforDm (oDM).
     5827   end.
     5828   function CheckGtin return logical
     5829   (iGtin as char):
     5830      define variable bar_code as character no-undo.
     5831      define variable vGtin as logical no-undo init "yes".
     5832      if length(iGtin) eq 14
     5833      then do:
     5834         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     5835         run str/chk-sum.p
     5836          (input-output bar_code ) no-error .
     5837         if iGtin ne  bar_code
     5838         then
     5839            vGtin = no.
     5840      end.
     5841      else
     5842         vGtin = no.
     5843      return vgtin.
     5844   end.
     5845   function repSpecSimbforXlm return char
     5846   (iDM as char ):
     5847       iDM = replace(iDM,chr(29),"").
     5848       return iDM.
     5849   end.
     5850   function getGtinByDM return char
     5851   (IDM as char):
     5852      define variable VTXT as char no-undo.
     5853      define variable vGtin as char no-undo.
     5854      vTXt = IdM.
     5855      vGtin = IDM.
     5856      if    length(vtxt) > 14
     5857      then do:
     5858         if   vtxt begins "(01)"
     5859                or vtxt begins "(02)"
     5860         then
     5861            vGtin = substring(vtxt,5,14).
     5862         else if   (vtxt begins "01"
     5863                or vtxt begins "02" )
     5864                and (   (    substring(iDm,17,2) eq "21"
     5865                         and length(vtxt) >= 21)
     5866                     or substring(iDm,17,2) eq "37"
     5867                     or substring(iDm,17,4) eq "(37)" )
     5868         then do:
     5869            vGtin = substring(vtxt,3,14).
     5870            if not checkGtin(vGtin)
     5871            then
     5872               vGtin = substring(vtxt,1,14).
     5873         end.
     5874         else if     length(vtxt) eq 14 + 7 + 4 + 4
     5875             or length(vtxt) eq 14 + 7 + 4
     5876             or length(vtxt) eq 14 + 7
     5877         then
     5878            vGtin = substring(vtxt,1,14).
     5879      end.
     5880      if not checkGtin(vGtin)
     5881      then
     5882         vGtin = "".
     5883      return vgtin.
     5884   end.
     5885   function getGdsCodeByGtin return int
     5886   (iGtin as char):
     5887      define buffer prod-bc  for ub.prod-bc.
     5888      define buffer bar-code for ub.bar-code.
     5889      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     5890      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5891      return if avail bar-code then bar-code.gds-code else ?.
     5892   end.
     5893   function getQntyCodeByGtin return decimal
     5894   (iGtin as char):
     5895      define buffer prod-bc  for ub.prod-bc.
     5896      define buffer bar-code for ub.bar-code.
     5897      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     5898      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5899      return if avail bar-code then bar-code.cli-base-rate else ?.
     5900   end.
     5901   function getGdsCodeByDM return int
     5902   (iDm as char):
     5903      define variable vGtin as char no-undo.
     5904      define buffer prod-bc for ub.prod-bc.
     5905      vGtin  = getGtinByDM (IDM ).
     5906      return getGdsCodeByGtin (vGtin).
     5907   end.
     5908   function ChekTypeMarkByGds return logical
     5909   (iGds-code as integer ):
     5910      define buffer goods-attr for ub.goods-attr.
     5911      find first goods-attr where goods-attr.gds-code   = iGds-code
     5912                              and goods-attr.attr-code  = 'mark-type':U
     5913      no-lock no-error.
     5914      if available goods-attr
     5915      then do:
     5916         mTypeMark = goods-attr.attr-value.
     5917         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     5918           .
     5919      end.
     5920      else
     5921         return no.
     5922   end.
     5923   function ChekTypeMarkByDm return logical
     5924   (iDM as char ):
     5925      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     5926   end.
     5927   function ChekTypeMarkByGtin return logical
     5928   (iGtin as char ):
     5929      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     5930   end.
     5931   function GetNextElement return character
     5932     (input iAllTeg        as logical
     5933     ,output oteg          as character
     5934     ,output otegval       as character
     5935     ,input-output pstr    as character
     5936      ):
     5937        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     5938        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     5939        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     5940        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     5941        define variable vTeg as character no-undo.
     5942        define variable vLength as integer no-undo.
     5943        define variable vi as integer no-undo.
     5944        define variable vj as integer no-undo.
     5945        define buffer code for ub.code.
     5946        find first code where Code.parent eq "MarkType"
     5947                          and Code.CodeValue   eq mTypeMark
     5948                          no-lock no-error.
     5949        if     available code
     5950           and Code.misc1 ne ""
     5951           and Code.misc1 ne ?
     5952        then do:
     5953           integer (Code.misc1) no-error.
     5954           if not error-status:error
     5955           then
     5956             entry (4,vlistleng) = Code.misc1.
     5957        end.
     5958        if iAllTeg
     5959        then
     5960           assign
     5961              vlistElem     = vlistElem    + vlistElemDop
     5962              vlistleng     = vlistleng    + vlistlengDop
     5963           .
     5964        else if mMRCCode
     5965        then
     5966           assign
     5967              vlistElem     = vlistElem    + ",(8005),8005"
     5968              vlistleng     = vlistleng    + ",000006,0006"
     5969           .
     5970       block-elem:
     5971       do vi = 1 to num-entries(vlistElem):
     5972          vTeg = entry(vi,vlistElem).
     5973          if pstr begins vTeg
     5974          then do:
     5975             if    vTeg eq "21"
     5976             then
     5977                vLength = index(pstr,chr(29)) - 2 no-error.
     5978             if vLength  <= 0
     5979             then
     5980                vLength = int(entry(vi,vlistleng)).
     5981             otegval = substring (pstr,length(vteg) + 1, vLength).
     5982             oteg = replace(replace(vteg,")",""),"(","").
     5983             vTeg = vteg + otegval.
     5984             otegval = replace(otegval,chr(29),"").
     5985             oteg = replace(replace(oteg,")",""),"(","").
     5986             pstr = substring (pstr,length(vTeg)+ 1).
     5987             vTeg = replace(vTeg,chr(29),"").
     5988             leave block-elem.
     5989          end.
     5990          else
     5991             vTeg = "".
     5992       end.
     5993       return vteg.
     5994   end.
     5995   function GetCodeIdent return character
     5996   (iDm as char):
     5997      define variable Velement   as character no-undo init "first".
     5998      define variable oCodeIdent as character no-undo.
     5999      define variable vteg as character no-undo.
     6000      define variable vtegval as character no-undo.
     6001      define variable vGtin as character no-undo.
     6002      define buffer marking for ub.marking.
     6003      for first marking no-lock where
     6004                marking.mark eq iDm
     6005            and marking.unit-ext = "LEVEL2"
     6006      :
     6007        return iDm.
     6008      end.
     6009      vGtin  = getGtinByDM (iDm ).
     6010      ChekTypeMarkByDm(idm).
     6011      if iDm begins 'tech_':U
     6012      then
     6013         oCodeIdent = iDm.
     6014      else if length(iDm) < 21
     6015      then do:
     6016         find first marking where marking.mark eq idm
     6017         no-lock no-error.
     6018         oCodeIdent = if available marking then marking.mark else  ?.
     6019      end.
     6020      else if     length(iDm) eq 29
     6021         and not iDm begins "01"
     6022         and not iDm begins "02"
     6023      then
     6024         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     6025      else  if     length(iDm) >= 24
     6026               and (  iDm begins "01"
     6027                   or iDm begins "02")
     6028               and  substring(iDm,17,2) ne "21"
     6029      then do:
     6030         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     6031                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     6032         then
     6033            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     6034         else
     6035            oCodeIdent = iDM.
     6036      end.
     6037      else  if     (   length(iDm) eq 25
     6038                    or length(iDm) eq 21)
     6039               and (not iDm begins "01"
     6040               and  not iDm begins "02")
     6041      then
     6042         oCodeIdent = substring(iDm,1,21).
     6043      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     6044      then
     6045         oCodeIdent = substring(iDm,1,21).
     6046      else do while Velement ne "" and idm ne "":
     6047         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     6048         oCodeIdent = oCodeIdent + Velement.
     6049      end.
     6050      return oCodeIdent.
     6051   end.
     6052   function GetTegCod return character
     6053   (icodeIdent as char, iTeg as char):
     6054      define variable Velement   as character no-undo init "first".
     6055      define variable oTeg as character no-undo init ?.
     6056      define variable vteg as character no-undo.
     6057      define variable vtegval as character no-undo.
     6058      if     ((length(icodeIdent) eq 21
     6059         and not icodeIdent begins "01"
     6060         and not icodeIdent begins "02")
     6061         or
     6062             ( length(icodeIdent) eq 25
     6063               and not icodeIdent begins "01"
     6064               and not icodeIdent begins "02"))
     6065      then do:
     6066         if iTeg eq "01" or iTeg eq "02"
     6067         then
     6068            oTeg = substring(icodeIdent,1,21).
     6069         else  if  iTeg eq "21"
     6070         then
     6071            oTeg = substring(icodeIdent,15,7).
     6072      end.
     6073      else do:
     6074         ChekTypeMarkByDm(icodeIdent).
     6075         block-teg:
     6076            do while Velement ne "" and icodeIdent ne "":
     6077            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     6078            if    Velement begins iTeg
     6079               or Velement begins "(" + iTeg + ")"
     6080            then do:
     6081               oTeg = vtegval.
     6082               leave block-teg.
     6083            end.
     6084         end.
     6085      end.
     6086      return oTeg.
     6087   end.
     6088   function isOAD return logical
     6089   (icodeIdent as character):
     6090      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     6091   end.
     6092   function isMark return logical
     6093   (icodeIdent as character):
     6094      define buffer buf_marking for ub.marking.
     6095      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     6096             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     6097   end.
     6098   function addBracketForCode return character
     6099   (icodeIdent as char):
     6100      define variable Velement   as character no-undo init "first".
     6101      define variable oTeg as character no-undo.
     6102      define variable vteg as character no-undo.
     6103      define variable vtegval as character no-undo.
     6104      define buffer marking for ub.marking.
     6105      find first marking no-lock where
     6106                 marking.mark begins icodeIdent no-error.
     6107      if    not ChekTypeMarkByDm(icodeIdent)
     6108         or length(icodeIdent) le 24
     6109         or (avail marking and marking.unit-ext = "LEVEL2")
     6110      then
     6111         oTeg = icodeIdent.
     6112      else do:
     6113         if (  icodeIdent begins "01"
     6114            or icodeIdent begins "02"
     6115            ) and CheckGtin(substring (icodeIdent,3,14))
     6116            and substring (icodeIdent,17,2) eq "21"
     6117         then do:
     6118            mMRCCode = yes.
     6119            ChekTypeMarkByDm(icodeIdent).
     6120            block-teg:
     6121            do while Velement ne "" and icodeIdent ne "":
     6122               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     6123               if vteg ne ""
     6124               then
     6125                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     6126            end.
     6127            mMRCCode = no.
     6128         end.
     6129         else do:
     6130            oTeg = icodeIdent.
     6131         end.
     6132      end.
     6133      return oTeg.
     6134   end.
     6135   function getlevelByCodId return int
     6136   (iCode as char):
     6137      define variable vLength as int no-undo.
     6138      define variable vLevel  as int no-undo.
     6139      if not ChekTypeMarkByDM (icode) then return ?.
     6140      vLength = length(iCode).
     6141      if    vLength eq 18
     6142         or vLength eq 20
     6143      then
     6144         Vlevel = 4.
     6145      else if vLength eq 21
     6146      then
     6147         Vlevel = 1.
     6148      else if vLength eq 25
     6149      then do:
     6150         if  iCode begins "01"
     6151         then
     6152            Vlevel = 3.
     6153         else
     6154            Vlevel = 1.
     6155      end.
     6156      else if     vLength >= 26
     6157              and vLength <= 46
     6158      then do:
     6159         if    substring(iCode,17,2) eq "11"
     6160            or substring(iCode,17,2) eq "13"
     6161            or (    substring(iCode,17,2) eq "21"
     6162                and vLength >= 33
     6163                and substring(iCode,26,4) ne "8005")
     6164         then
     6165            Vlevel = 4.
     6166         else if    vLength eq 31
     6167                 or vLength eq 38
     6168                 or vLength eq 39
     6169                 or vLength eq 45
     6170         then
     6171            Vlevel = 1.
     6172         else if    vLength eq 35
     6173                 or vLength eq 43
     6174         then
     6175            Vlevel = 3.
     6176         else
     6177            Vlevel = ?.
     6178      end.
     6179      else
     6180         Vlevel = ?.
     6181      return Vlevel.
     6182   end.
     6183   function getLevelMotpBycodid return character
     6184   (iDm as char):
     6185      define variable vLevel as integer no-undo.
     6186      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6187      vLevel = getlevelByCodId(iDm).
     6188      if    vLevel eq ?
     6189         or vLevel < 1
     6190         or vLevel > 6
     6191      then
     6192         return ?.
     6193      else
     6194         return entry(vlevel,vList).
     6195   end.
     6196   function getLevelUTDByLevelMotp return character
     6197   (iUnit as char):
     6198      define variable vLevel as integer no-undo.
     6199      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6200      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6201      vLevel = lookup(iUnit,vListMOTP).
     6202      if    vLevel eq ?
     6203         or vLevel < 1
     6204         or vLevel > 4
     6205      then
     6206         return ?.
     6207      else
     6208         return entry(vlevel,vListutd).
     6209   end.
     6210   function getLevelMotpByDM return character
     6211   (iDm as char):
     6212      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     6213   end.
     6214   function getLevelUTDByCodId return character
     6215   (iDm as char):
     6216      define variable vLevel as integer no-undo.
     6217      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6218      vLevel = getlevelByCodId(iDm).
     6219      if    vLevel eq ?
     6220         or vLevel < 1
     6221         or vLevel > 4
     6222      then
     6223         return ?.
     6224      else
     6225         return entry(vlevel,vList).
     6226   end.
     6227   function getLevelUTDByDM return character
     6228   (iDm as char):
     6229      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     6230   end.
     6231   define variable mNotMarkQnty as logical no-undo.
     6232   function getQntyUTDByCodId return decimal
     6233   (iDM as char):
     6234      define variable vLevel as integer no-undo.
     6235      define variable vList as character no-undo init "1,5,10,500".
     6236      define variable vGtin as character no-undo.
     6237      define variable vqnty as decimal no-undo init ?.
     6238      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     6239      if vqnty eq ?
     6240      then do:
     6241         if not mNotMarkQnty
     6242         then do:
     6243            define buffer marking for ub.marking.
     6244            define variable vCodident as character no-undo.
     6245            vCodident = GetCodeIdent(idm).
     6246            find first marking where marking.mark begins vCodident no-lock no-error.
     6247            if     available marking
     6248               and marking.box-qnty ne ?
     6249            then
     6250               return marking.box-qnty.
     6251         end.
     6252         vGtin = getGtinByDm(iDM).
     6253         if ChekTypeMarkByGtin (vGtin)
     6254         then do:
     6255            vLevel = getlevelByCodId(iDM).
     6256            if     vLevel >= 1
     6257               and vLevel <= 4
     6258            then
     6259               vqnty = int(entry(vlevel,vList)).
     6260         end.
     6261         else
     6262            vqnty = getQntyCodeByGtin(vgtin).
     6263      end.
     6264      return vqnty.
     6265   end.
     6266   function getQntyUTDByDM return decimal
     6267   (iDm as char):
     6268      define variable vDM as character no-undo.
     6269      if     length (iDm) ne 25
     6270         and length (iDm) ne 29
     6271         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     6272      then
     6273         vDM = substring (iDm,1,length (iDm) - 6 ).
     6274      else
     6275         vDM = substring (iDm,1,length (iDm) - 4 ).
     6276      return getQntyUTDByCodId(vDM).
     6277   end.
     6278   function getMRC4 return decimal
     6279   (iMRC as char):
     6280      define variable oMrc     as decimal no-undo init ?.
     6281      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     6282      define variable vi       as integer no-undo.
     6283      define variable vfound   as integer no-undo.
     6284      define variable vposStart   as integer no-undo.
     6285      do:
     6286      OMRc = 0.
     6287      do vi = 1 to 4:
     6288         define variable vsimb as character no-undo.
     6289         vsimb = substring(iMRC,vi,1).
     6290         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     6291         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     6292         if vfound > 0
     6293         then
     6294            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     6295         end.
     6296         OMRc = OMRc / 100.
     6297      end.
     6298      return OMRc.
     6299   end.
     6300   function getMRCByDM return decimal
     6301   (iDm as char):
     6302      define variable vMRC     as character no-undo.
     6303      define variable oMrc     as decimal no-undo init ?.
     6304      define variable Velement as character no-undo init "empty".
     6305      define variable vteg as character no-undo.
     6306      define variable vtegval as character no-undo.
     6307      if    length(idm) eq 14 + 7 + 4 + 4
     6308         or length(idm) eq 14 + 7 + 4
     6309      then do:
     6310         vMRC = substring(idm,22,4).
     6311         omrc = getMRC4(vMRC).
     6312      end.
     6313      else do:
     6314          ChekTypeMarkByDm(iDm).
     6315          block-mrc:
     6316          do while Velement ne "" and idm ne "":
     6317             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     6318             if Velement begins "8005"
     6319             then do:
     6320                vMRC = substring(Velement,5,6).
     6321                leave block-mrc.
     6322             end.
     6323             else if Velement begins "(8005)"
     6324             then do:
     6325                vMRC = substring(Velement,7,6).
     6326                leave block-mrc.
     6327             end.
     6328          end.
     6329          if vMRC ne ""
     6330          then
     6331             OMRc = dec(vmrc) / 100 no-error.
     6332      end.
     6333      return OMRc.
     6334   end.
     6335   function MoveDate return Date
     6336   (idate as date,
     6337    iMonth as int64):
     6338      define variable vMonth   as int64 no-undo.
     6339      define variable vYear    as int64 no-undo.
     6340      define variable vDateNew as date  no-undo.
     6341       define variable vDay     as int64 no-undo.
     6342       vMonth = month(iDate) + iMonth.
     6343       vYear =  year(iDate).
     6344       if vMonth <= 0
     6345       then assign
     6346          vMonth = vMonth + 12
     6347           vYear  = vYear - 1
     6348       .
     6349       else if vMonth > 12
     6350       then assign
     6351          vMonth = vMonth - 12
     6352           vYear  = vYear + 1
     6353       .
     6354       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     6355       do while error-status:error eq yes:
     6356          VDay = vDay + 1.
     6357          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     6358       end.
     6359       if VDay > 0
     6360       then
     6361          vDateNew + 1.
     6362       return vDateNew.
     6363   end.
     6364   procedure checkEMRC:
     6365   define input  parameter iDm as character no-undo.
     6366   define output parameter vok as logical   no-undo init yes.
     6367      define variable v-value-emrc as character no-undo.
     6368      define variable v-type-emrc  as character no-undo.
     6369      define variable vDateIso     as character no-undo.
     6370      define variable vMRC         as decimal no-undo.
     6371      define variable vqnty        as decimal no-undo.
     6372      define variable vPrice       as decimal no-undo.
     6373      define variable vparent      as character no-undo.
     6374      define variable vgds-code    as integer no-undo.
     6375      define buffer code for ub.code.
     6376      vMRC = getMRCByDM(iDm).
     6377      if vMRC > 0
     6378      then do:
     6379         vgds-code = getGdsCodeByDM(iDm).
     6380         vqnty     = getQntyUTDByDM(iDm).
     6381               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6382            (
     6383             input   vgds-code
     6384            ,input   'emrc-type':U
     6385            ,output   v-value-emrc
     6386            ,output   v-type-emrc
     6387          ) no-error.
     6388          if     v-value-emrc ne ""
     6389             and v-value-emrc ne ?
     6390          then do:
     6391             vDateIso = iso-date(today).
     6392             vPrice = vMRC / vqnty.
     6393             vparent ="emc" + chr(4) + v-value-emrc.
     6394             find last code where Code.parent      eq vparent
     6395                              and Code.code        le vDateIso
     6396                              and code.status_  eq 0
     6397             no-lock no-error.
     6398             if not available code or ( vPrice  >= dec(Code.CodeValue))
     6399             then
     6400                vOk = true .
     6401             else do:
     6402                 define variable vText      as character no-undo.
     6403                 define variable vDate      as date no-undo.
     6404                 define variable vDateLast  as character no-undo.
     6405                 define variable vDateFirst as character no-undo.
     6406                 define variable vDate3     as date no-undo.
     6407                 vdate = date(code.misc1).
     6408                 vDateLast = code.misc1.
     6409                 vDate3 = MoveDate(today, - 3 ).
     6410                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     6411                                      string(vDate3  , "99/99/9999"),
     6412                                      string(vDate   , "99/99/9999")
     6413                                      ).
     6414                 vdateIso = iso-date(vdate3).
     6415                 find last code  where Code.parent      eq vparent
     6416                                   and Code.code        le vDateIso
     6417                                   and code.status_  eq 0 no-lock no-error.
     6418                 if available code
     6419                 then
     6420                    vDateIso = code.code.
     6421                 vDateFirst = vDateIso.
     6422                 vDateLast = iso-date(vdate).
     6423                 define variable vGood as logical no-undo.
     6424                 define variable vDateSale as date no-undo.
     6425                 define buffer bcode for code.
     6426                 for last code where Code.parent   eq vparent
     6427                                 and code.status_  eq 0
     6428                                 and code.code     < vDateLast
     6429                                 and code.code     >= vDateFirst
     6430                 no-lock:
     6431                    find first bcode where bCode.parent   eq vparent
     6432                                       and bcode.status_  eq 0
     6433                                       and bcode.code     > code.code no-lock no-error.
     6434                    if available bcode
     6435                    then do:
     6436                       if vPrice < dec(Code.CodeValue)
     6437                       then
     6438                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     6439                                                     chr(10),
     6440                                                     string(    date( code.misc1)       ,"99/99/9999"),
     6441                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     6442                                                     ).
     6443                       else do:
     6444                          vGood = yes.
     6445                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     6446                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     6447                                                     chr(10),
     6448                                                     string(    date( code.misc1)         ,"99/99/9999"),
     6449                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     6450                                                     string(         vDateSale            ,"99/99/9999"),
     6451                                                     string(vDateSale - today)
     6452                                                     ).
     6453                       end.
     6454                    end.
     6455                 end.
     6456                 if vgood
     6457                 then do:
     6458                    define variable choice as integer no-undo .
     6459                    run gbl/d-askw.w (input "Уточнение"
     6460                           ,input  vText
     6461                           ,input "|"
     6462                           ,input "Принять|Вернуть"
     6463                           ,input "Принять данный товар|Вернуть товар постащику"
     6464                           ,input 1
     6465                           ,input 2
     6466                           ,output choice) no-error.
     6467                    vok = choice eq 1.
     6468                 end.
     6469                 else
     6470                    vok =false.
     6471             end.
     6472          end.
     6473      end.
     6474   end.
     6475   function addGs2Mark return character
     6476   (iMark as char):
     6477      define variable vDM   as character no-undo.
     6478      define variable vIdx  as integer   no-undo.
     6479      if index(iMark,chr(29),1) > 0
     6480      then return iMark.
     6481      if substring(iMark,26,4) = "8005" then
     6482      do:
     6483        vIdx = index(iMark,"93",26 + 4 + 5).
     6484        if vIdx > 1 then do:
     6485          vDM = substitute("&1&4&2&4&3",
     6486                           substring(iMark,1,25),
     6487                           substring(iMark,26,vIdx - 25 - 1),
     6488                           substring(iMark,vIdx),
     6489                           chr(29)) no-error.
     6490          vIdx = index(vDm,"240",vIdx + 4).
     6491          if vIdx > 0 then
     6492          do:
     6493            vDM = substitute("&1&3&2",
     6494                             substring(vDm,1,vIdx - 1),
     6495                             substring(vDm,vIdx),
     6496                             chr(29)) no-error.
     6497          end.
     6498        end.
     6499        else
     6500          vDM = substitute("&1&3&2",
     6501                           substring(iMark,1,25),
     6502                           substring(iMark,26),
     6503                           chr(29)) no-error.
     6504      end.
     6505      else if substring(iMark,32,2) = "91" then
     6506      do:
     6507        vIdx = index(iMark,"92",32).
     6508        if vIdx > 1 then
     6509          vDM = substitute("&1&4&2&4&3",
     6510                           substring(iMark,1,31),
     6511                           substring(iMark,32,vIdx - 31 - 1),
     6512                           substring(iMark,vIdx),
     6513                           chr(29)) no-error.
     6514        else
     6515          vDM = substitute("&1&3&2",
     6516                           substring(iMark,1,31),
     6517                           substring(iMark,32),
     6518                           chr(29)) no-error.
     6519      end.
     6520      else if substring(iMark,39,2) = "91" then
     6521      do:
     6522        vIdx = index(iMark,"92",38).
     6523        if vIdx > 1 then
     6524          vDM = substitute("&1&4&2&4&3",
     6525                           substring(iMark,1,38),
     6526                           substring(iMark,39,vIdx - 38 - 1),
     6527                           substring(iMark,vIdx),
     6528                           chr(29)) no-error.
     6529        else
     6530          vDM = substitute("&1&3&2",
     6531                           substring(iMark,1,38),
     6532                           substring(iMark,39),
     6533                           chr(29)) no-error.
     6534      end.
     6535      else if substring(iMark,25,2) = "93" then
     6536      do:
     6537        vIdx = index(iMark,"92",25).
     6538        if vIdx > 1 then
     6539          vDM = substitute("&1&4&2&4&3",
     6540                           substring(iMark,1,24),
     6541                           substring(iMark,25,vIdx - 24 - 1),
     6542                           substring(iMark,vIdx),
     6543                           chr(29)) no-error.
     6544        else
     6545          vIdx = index(iMark,"3103",25).
     6546          if vIdx > 0 then
     6547          vDM = substitute("&1&4&2&4&3",
     6548                           substring(iMark,1,24),
     6549                           substring(iMark,25,vIdx - 24 - 1),
     6550                           substring(iMark,vIdx),
     6551                           chr(29)) no-error.
     6552          else
     6553            vDM = substitute("&1&3&2",
     6554                             substring(iMark,1,24),
     6555                             substring(iMark,25),
     6556                             chr(29)) no-error.
     6557      end.
     6558      else if substring(iMark,32,2) = "93" then
     6559      do:
     6560        vDM = substitute("&1&3&2",
     6561              substring(iMark,1,31),
     6562              substring(iMark,32),
     6563              chr(29)) no-error.
     6564      end.
     6565      return if vDM <> "" then vDm else iMark.
     6566   end.
     6567   def var vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6568   function AddUtdErrForTab returns logical
     6569   (idb-num         as integer ,
     6570    idoc-id         as integer ,
     6571    iTab            as character,
     6572    iObj            as handle ,
     6573    iCheckType      as character,
     6574    iCodeErr        as character,
     6575    iCheckObj       as character ):
     6576      define buffer utd-err for utd-err.
     6577      define buffer utd for utd.
     6578      find first utd where utd.db-num     eq idb-num
     6579                       and utd.doc-id     eq idoc-id
     6580                       and utd.Direction  eq 'Outbound'
     6581      no-lock no-error.
     6582      if available utd
     6583      then
     6584         return no.
     6585      define variable vRecKey as character no-undo.
     6586            run gen-key-rec (input iTab,
     6587                             input  iObj,
     6588                             output vRecKey).
     6589      find first utd-err where utd-err.db-num     eq idb-num
     6590                           and utd-err.doc-id     eq idoc-id
     6591                           and utd-err.CheckType  eq iCheckType
     6592                           and utd-err.CodeErr    eq iCodeErr
     6593                           and utd-err.CheckObj   eq iCheckObj
     6594      exclusive-lock no-error.
     6595      if not available utd-err
     6596      then do:
     6597         create utd-err.
     6598         assign
     6599            utd-err.db-num         = idb-num
     6600            utd-err.doc-id         = idoc-id
     6601            utd-err.CheckType      = iCheckType
     6602            utd-err.CodeErr        = iCodeErr
     6603            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6604            utd-err.reckey         = vRecKey
     6605            utd-err.qnty           = 1
     6606         .
     6607      end.
     6608      else
     6609         utd-err.qnty = utd-err.qnty + 1.
     6610      return utd-err.qnty eq 1.
     6611   end.
     6612   function AddUtdErr returns logical
     6613   (idb-num         as integer ,
     6614    idoc-id         as integer ,
     6615    iObj            as handle ,
     6616    iCheckType      as character,
     6617    iCodeErr        as character,
     6618    iCheckObj       as character ):
     6619      AddUtdErrForTab
     6620         (idb-num,
     6621          idoc-id,
     6622          iObj:table,
     6623          iObj,
     6624          iCheckType,
     6625          iCodeErr,
     6626          iCheckObj).
     6627   end.
     6628   function ClearUtdErrTypeCode returns logical
     6629   (idb-num         as integer,
     6630    idoc-id         as integer ,
     6631    iCheckType      as character,
     6632    iCodeErr        as character
     6633    ):
     6634      define buffer utd-err for utd-err.
     6635      if    iCheckType eq "*"
     6636         or iCheckType eq ?
     6637      then do:
     6638         if     iCodeErr ne ?
     6639            and iCodeErr ne "*"
     6640         then
     6641            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6642            view-as alert-box.
     6643         else
     6644         for each utd-err where utd-err.db-num  eq idb-num
     6645                            and utd-err.doc-id  eq idoc-id
     6646         exclusive-lock:
     6647            delete utd-err.
     6648         end.
     6649      end.
     6650      else do:
     6651         if    iCodeErr eq ?
     6652            or iCodeErr eq "*"
     6653         then do:
     6654            for each utd-err where utd-err.db-num     eq idb-num
     6655                               and utd-err.doc-id     eq idoc-id
     6656                               and utd-err.CheckType  eq iCheckType
     6657            exclusive-lock:
     6658               delete utd-err.
     6659            end.
     6660         end.
     6661         else do:
     6662            for each utd-err where utd-err.db-num     eq idb-num
     6663                               and utd-err.doc-id     eq idoc-id
     6664                               and utd-err.CheckType  eq iCheckType
     6665                               and ub.utd-err.CodeErr eq iCodeErr
     6666            exclusive-lock:
     6667               delete utd-err.
     6668            end.
     6669         end.
     6670      end.
     6671   end.
     6672   function ClearUtdErr returns logical
     6673   (idb-num         as integer,
     6674    idoc-id         as integer ,
     6675    iCheckType      as character
     6676    ):
     6677      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6678   end.
     6679   function GetMesError returns character
     6680   (itxt as character,
     6681    iobj as character ):
     6682    define variable vi as integer no-undo.
     6683    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6684       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6685    end.
     6686    return itxt.
     6687   end.
     6688   function GetTextErrorType returns character
     6689   (iCheckType as character,
     6690    iCodeErr   as character,
     6691    iChechObj  as character,
     6692    iType      as character  ):
     6693      define buffer code    for code.
     6694      define variable vError as character no-undo.
     6695      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6696                        and code.code   eq iCodeErr
     6697      no-lock no-error.
     6698      if available code
     6699      then do:
     6700         define variable vType as integer no-undo.
     6701         if code.misc3 eq "error"
     6702         then
     6703            vType = 0.
     6704         else if code.misc3 eq "warning"
     6705         then
     6706            vType = 1.
     6707         else if code.misc3 eq "Hiden"
     6708         then
     6709            vType = 2.
     6710         else
     6711            vtype = int(code.misc3) no-error.
     6712         case itype:
     6713            when "error"
     6714            then do:
     6715               if vtype eq 0
     6716               then
     6717                  vError = GetMesError(Code.CodeValue,iChechObj).
     6718            end.
     6719            when "warning"
     6720            then do:
     6721               if vtype <= 1
     6722               then
     6723                  vError = GetMesError(Code.CodeValue,iChechObj).
     6724            end.
     6725            otherwise do:
     6726               vError = GetMesError(Code.CodeValue,iChechObj).
     6727            end.
     6728         end.
     6729      end.
     6730      else
     6731         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6732      return vError.
     6733   end.
     6734   function GetTypeError returns integer
     6735   (iCheckType as character,
     6736    iCodeErr   as character):
     6737      define buffer code    for code.
     6738      define variable vType as integer no-undo.
     6739      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6740                        and code.code   eq iCodeErr
     6741      no-lock no-error.
     6742      if     not available code
     6743         and code.misc3 eq "error"
     6744      then
     6745         vType = 0.
     6746      else if code.misc3 eq "warning"
     6747      then
     6748         vType = 1.
     6749      else if code.misc3 eq "Hiden"
     6750      then
     6751         vType = 2.
     6752      else
     6753         vtype = int(code.misc3) no-error.
     6754      return vtype.
     6755   end.
     6756   function GetTextError returns character
     6757   (iCheckType as character,
     6758    iCodeErr   as character,
     6759    iChechObj  as character ):
     6760      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6761   end.
     6762   function GetErrForUtdStr returns character
     6763   (idb-num     as integer ,
     6764    idoc-id     as integer ,
     6765    iCheckType  as character
     6766    ):
     6767      define buffer utd-err for utd-err.
     6768      define buffer code    for code.
     6769      define variable vHQry as handle no-undo.
     6770      define variable vError as longchar no-undo.
     6771      define variable vErrorOne as longchar  no-undo.
     6772      define variable oError as character no-undo.
     6773      create query vHQry.
     6774      vHQry:set-buffers(buffer utd-err:handle).
     6775      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6776                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6777                               + if    iCheckType eq "*"
     6778                                    or iCheckType eq ?
     6779                                 then       ""
     6780                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6781      vHQry:query-open().
     6782      vHQry:get-first().
     6783      QRY-BLOCK:
     6784      repeat while not vHQry:query-off-end:
     6785         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6786         if     vErrorOne ne ""
     6787            and vErrorOne ne ?
     6788         then
     6789            vError = vError + ", " + vErrorOne.
     6790         vHQry:get-next().
     6791      end.
     6792      oError = substring(vError,3,4002).
     6793      return oError.
     6794   end.
     6795   function GetErrJsonForUtd returns character
     6796   (idb-num         as integer ,
     6797    idoc-id         as integer ,
     6798    iCheckType      as character
     6799    ):
     6800      define buffer utd-err for utd-err.
     6801      define variable vHQry as handle no-undo.
     6802      define variable vError as longchar no-undo.
     6803      define variable oError as character no-undo.
     6804      create query vHQry.
     6805      define variable vi as integer no-undo.
     6806      vHQry:set-buffers(buffer utd-err:handle).
     6807      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6808                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6809                               + if    iCheckType eq "*"
     6810                                    or iCheckType eq ?
     6811                                 then       ""
     6812                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6813      vHQry:query-open().
     6814      vHQry:get-first().
     6815      QRY-BLOCK:
     6816      repeat while not vHQry:query-off-end:
     6817         define variable vErrorOne as character no-undo.
     6818         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6819         if     vErrorOne ne ?
     6820            and vErrorOne ne ""
     6821         then do:
     6822            vi = vi + 1.
     6823            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6824                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6825                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6826         end.
     6827         vHQry:get-next().
     6828      end.
     6829      for first utd where utd.db-num eq idb-num
     6830                      and utd.doc-id eq idoc-id
     6831                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6832      no-lock,
     6833         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6834                                  and utd-marking-lines.doc-id eq idoc-id
     6835                                  and utd-marking-lines.doc-level eq 1
     6836      no-lock,
     6837         first marking where marking.mark eq utd-marking-lines.mark
     6838                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6839      no-lock:
     6840         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6841         if     vErrorOne ne ?
     6842            and vErrorOne ne ""
     6843         then do:
     6844            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6845                            + '","ОбъектОш":"' + marking.mark
     6846                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6847         end.
     6848      end.
     6849      if vError ne ""
     6850      then
     6851         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6852      return oError.
     6853   end.
     6854   function GetErrJsonForUtdReturn returns character
     6855   (idb-num         as integer ,
     6856    idoc-id         as integer ,
     6857    iCheckType      as character
     6858    ):
     6859      define buffer utd-err for utd-err.
     6860      define variable vHQry as handle no-undo.
     6861      define variable vError as longchar no-undo.
     6862      define variable oError as character no-undo.
     6863      define variable vi as integer no-undo.
     6864      create query vHQry.
     6865      vHQry:set-buffers(buffer utd-err:handle).
     6866      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6867                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6868                               + if    iCheckType eq "*"
     6869                                    or iCheckType eq ?
     6870                                 then       ""
     6871                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6872      vHQry:query-open().
     6873      vHQry:get-first().
     6874      QRY-BLOCK:
     6875      repeat while not vHQry:query-off-end:
     6876         define variable vErrorOne as character no-undo.
     6877         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6878         if     vErrorOne ne ?
     6879            and vErrorOne ne ""
     6880         then do:
     6881            vi = vi + 1.
     6882            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6883                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6884                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6885         end.
     6886         vHQry:get-next().
     6887      end.
     6888      if vError ne ""
     6889      then
     6890         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6891      return oError.
     6892   end.
     6893   function GetCodeTextError returns character
     6894   (iCheckType as character,
     6895    iCodeErr   as character,
     6896    iChechObj  as character,
     6897    output oCode as character,
     6898    output ovalue as character ):
     6899      define buffer code    for code.
     6900      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6901                        and code.code   eq iCodeErr
     6902      no-lock no-error.
     6903      if     available code
     6904      then do:
     6905         define variable vi as integer no-undo init ?.
     6906         vi = int(Code.misc3) no-error.
     6907         if    code.misc3 ne "error"
     6908            and vi ne 0
     6909         then
     6910            oCode = ?.
     6911         else if     Code.misc1 ne ?
     6912                 and Code.misc1 ne ""
     6913         then
     6914            assign
     6915               oCode  = GetMesError(Code.misc1,iChechObj)
     6916               ovalue = GetMesError(Code.misc2,iChechObj)
     6917            .
     6918      end.
     6919      return if oCode eq ""
     6920             then ""
     6921             else (oCode + "_" + ovalue).
     6922   end.
     6923   define temp-table TT-err no-undo
     6924     field code_ as character
     6925     field text_ as character
     6926   index code_ code_.
     6927   function GetErrTxtForUtd returns character
     6928   (idb-num         as integer ,
     6929    idoc-id         as integer ,
     6930    iCheckType      as character
     6931    ):
     6932      define buffer utd-err for utd-err.
     6933      define variable vHQry as handle no-undo.
     6934      define variable oError as character no-undo.
     6935      create query vHQry.
     6936      define variable vi as integer no-undo.
     6937      for each tt-err :
     6938         delete tt-err.
     6939      end.
     6940      vHQry:set-buffers(buffer utd-err:handle).
     6941      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6942                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6943                               + if    iCheckType eq "*"
     6944                                    or iCheckType eq ?
     6945                                 then       ""
     6946                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6947      vHQry:query-open().
     6948      vHQry:get-first().
     6949      define variable vcode as character no-undo.
     6950      define variable vvalue as character no-undo.
     6951      QRY-BLOCK:
     6952      repeat while not vHQry:query-off-end:
     6953         vi = vi + 1.
     6954         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6955         if vcode ne ?
     6956         then do:
     6957            find first tt-err where tt-err.code eq vcode
     6958            no-error.
     6959            if not available tt-err
     6960            then do:
     6961               create tt-err.
     6962               assign
     6963                  tt-err.code_ = vcode
     6964                  tt-err.text_ = vvalue
     6965               .
     6966            end.
     6967            else
     6968               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6969         end.
     6970         vHQry:get-next().
     6971      end.
     6972     find first utd where utd.db-num eq idb-num
     6973                         and utd.doc-id eq idoc-id
     6974         no-lock.
     6975      define buffer cancel_utd-lines for utd-lines.
     6976      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6977                                  and cancel_utd-lines.doc-id eq idoc-id
     6978      no-lock:
     6979         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6980         then do:
     6981            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6982                                        and utd-marking-lines.doc-id eq idoc-id
     6983                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6984            no-lock,
     6985               first marking where marking.mark eq utd-marking-lines.mark
     6986                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6987            no-lock:
     6988               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6989               find first tt-err where tt-err.code eq vcode
     6990               no-error.
     6991               if not available tt-err
     6992               then do:
     6993                  create tt-err.
     6994                  assign
     6995                     tt-err.code_ = vcode
     6996                     tt-err.text_ = vvalue
     6997                  .
     6998               end.
     6999               else
     7000                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     7001            end.
     7002         end.
     7003         else do:
     7004            define variable vqnty as decimal no-undo.
     7005            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     7006            if vqnty eq ? then vqnty = 0.
     7007            if vqnty ne cancel_utd-lines.Quantity
     7008            then do:
     7009               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     7010               find first tt-err where tt-err.code eq vcode
     7011               no-error.
     7012               if not available tt-err
     7013               then do:
     7014                  create tt-err.
     7015                  assign
     7016                     tt-err.code_ = vcode
     7017                     tt-err.text_ = vvalue
     7018                  .
     7019               end.
     7020               else
     7021                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     7022            end.
     7023         end.
     7024      end.
     7025      for each tt-err:
     7026         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     7027      end.
     7028      return oError.
     7029   end.
     7030   define variable mFormatErr as character no-undo init "text".
     7031   function GetErrForUtd returns character
     7032   (idb-num         as integer ,
     7033    idoc-id         as integer ,
     7034    iType           as character
     7035    ):
     7036      if mFormatErr eq "text"
     7037      then
     7038         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     7039      else do:
     7040         if itype eq "return"
     7041         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     7042         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     7043      end.
     7044   end.
     7045   function GetErrComText returns longchar
     7046   (icomment as character,
     7047    itext    as longchar ):
     7048       define variable vText as longchar no-undo.
     7049      if mFormatErr eq "text"
     7050      then do:
     7051         if icomment ne ""
     7052         then
     7053            icomment = substitute("comment:|&1|",icomment).
     7054         vText = icomment + itext.
     7055      end.
     7056      else do:
     7057         icomment = if icomment begins  '"'
     7058                    then icomment
     7059                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     7060         vText = icomment + "," + itext.
     7061         vText = "~{" + trim(vText,",") + "~}".
     7062      end.
     7063      return vText.
     7064   end.
     7065   function CheckTypeForMarkLineType returns logical
     7066   (iObj            as handle,
     7067    iCheckType      as character,
     7068    iCodeErr        as character ,
     7069    iTypeErr        as character ):
     7070      define variable vRecKey-markLine as character no-undo.
     7071      define variable vGoodMark        as logical no-undo.
     7072      define variable vdb-num          as integer no-undo.
     7073      define variable vdoc-id          as integer no-undo.
     7074      define variable vlinenum         as integer no-undo.
     7075      define variable vErrorOne as character no-undo.
     7076      define buffer buf_utd-err for utd-err.
     7077      run gen-key-rec (input "utd-marking-lines",
     7078                       input  iObj,
     7079                       output vRecKey-markLine).
     7080      vGoodMark = yes.
     7081      vdb-num = iObj::db-num.
     7082      vdoc-id = iObj::doc-id.
     7083      vlinenum = iObj::linenum.
     7084      block-mark-err:
     7085      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7086                               and buf_utd-err.db-num = vdb-num
     7087                               and buf_utd-err.reckey = vRecKey-markLine
     7088                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     7089                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     7090      no-lock:
     7091         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     7092         if     vErrorOne ne ?
     7093            and vErrorOne ne ""
     7094         then do:
     7095            vGoodMark = no.
     7096            leave block-mark-err.
     7097         end.
     7098      end.
     7099      return not vGoodMark.
     7100   end.
     7101   function CheckErrForMarkLineType returns logical
     7102   (iObj            as handle,
     7103    iType           as character  ):
     7104      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     7105   end.
     7106   function CheckErrForMarkLine returns logical
     7107   (iObj            as handle):
     7108      return CheckErrForMarkLineType(iObj,"*").
     7109   end.
     7110   function CheckErrForLineTypeCode returns logical
     7111   (iObj                 as handle,
     7112    iCheckType           as character,
     7113    iCodeErr             as character,
     7114    iTypeErr             as character,
     7115    iOneErr              as logical):
     7116      define variable vRecKey-line     as character no-undo.
     7117      define buffer buf_utd-err for utd-err.
     7118      define variable vUtdlineError as logical no-undo.
     7119      define variable vErrorOne as character no-undo.
     7120            run gen-key-rec (input "utd-lines",
     7121                             input  iObj,
     7122                             output vRecKey-line).
     7123         define variable vdb-num as integer no-undo.
     7124         define variable vdoc-id as integer no-undo.
     7125         define variable vlinenum as integer no-undo.
     7126         vdb-num = iObj::db-num.
     7127         vdoc-id = iObj::doc-id.
     7128         vlinenum = iObj::linenum.
     7129         block-err:
     7130         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7131                                  and buf_utd-err.db-num = vdb-num
     7132                                  and buf_utd-err.reckey = vRecKey-line
     7133                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     7134                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     7135         no-lock:
     7136            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     7137            if     vErrorOne ne ?
     7138               and vErrorOne ne ""
     7139            then do:
     7140               vUtdlineError = yes.
     7141               leave block-err.
     7142            end.
     7143         end.
     7144         if  not vUtdlineError
     7145         then do:
     7146            define variable vGoodMark as logical no-undo.
     7147            vGoodMark = yes.
     7148            block-line-err:
     7149            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     7150                                         and utd-marking-lines.doc-id  eq vdoc-id
     7151                                         and utd-marking-lines.LineNum eq vLineNum
     7152            no-lock:
     7153               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     7154               if     vGoodMark
     7155                  and iOneErr eq no
     7156               then
     7157                  leave block-line-err.
     7158               if     iOneErr = yes
     7159                  and not vGoodMark
     7160               then
     7161                  leave block-line-err.
     7162            end.
     7163            vUtdlineError = not vGoodMark.
     7164         end.
     7165      return vUtdlineError.
     7166   end.
     7167   function getErrForLineType returns character
     7168   (iObj            as handle,
     7169    iType           as character  ):
     7170      define variable vRecKey-line     as character no-undo.
     7171      define buffer buf_utd-err for utd-err.
     7172      define variable vUtdlineError as logical no-undo.
     7173      define variable vErrorOne as character no-undo.
     7174      define variable oError as character no-undo.
     7175            run gen-key-rec (input "utd-lines",
     7176                             input  iObj,
     7177                             output vRecKey-line).
     7178         define variable vdb-num as integer no-undo.
     7179         define variable vdoc-id as integer no-undo.
     7180         define variable vlinenum as integer no-undo.
     7181         vdb-num = iObj::db-num.
     7182         vdoc-id = iObj::doc-id.
     7183         vlinenum = iObj::linenum.
     7184         block-err:
     7185         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     7186                                  and buf_utd-err.db-num = vdb-num
     7187                                  and buf_utd-err.reckey = vRecKey-line
     7188                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     7189         no-lock:
     7190            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     7191            if     vErrorOne ne ?
     7192               and vErrorOne ne ""
     7193            then do:
     7194               oError = oError + vErrorOne + " ".
     7195            end.
     7196         end.
     7197      return oError.
     7198   end.
     7199   function CheckErrForLineType returns logical
     7200   (iObj            as handle,
     7201    iType           as character  ):
     7202       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     7203   end.
     7204   function CheckErrForLine returns logical
     7205   (iObj            as handle):
     7206      return CheckErrForLineType(iobj,"*").
     7207   end.
     7208   function CheckErrForUtd returns logical
     7209   (idb-num         as integer ,
     7210    idoc-id         as integer ):
     7211      for each utd-lines where utd-lines.db-num eq idb-num
     7212                           and utd-lines.doc-id eq idoc-id
     7213      no-lock :
     7214         if not CheckErrForLine (buffer ub.utd-lines:handle)
     7215         then
     7216            return no.
     7217      end.
     7218      return yes.
     7219   end.
     7220   function CheckMarkUtd-28rel return logical
     7221    (input idb-num as integer,
     7222    input idoc-id as integer):
     7223    define buffer utd                   for utd.
     7224    define buffer utd-lines             for utd-lines.
     7225    define buffer utd-marking-lines     for utd-marking-lines.
     7226    define variable v-par-type as character no-undo.
     7227    define variable vgdsNoMark as logical no-undo.
     7228    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7229      define variable v-par-val  as character no-undo.
     7230      find first utd where utd.db-num eq idb-num
     7231                       and utd.doc-id eq idoc-id
     7232      no-lock no-error.
     7233      if available utd
     7234      then do:
     7235         if     utd.obj-code ne ?
     7236            and utd.obj-type ne ?
     7237         then do:
     7238            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     7239            Block-utd-lines:
     7240            for each utd-lines where utd-lines.db-num eq idb-num
     7241                                 and utd-lines.doc-id eq idoc-id
     7242            no-lock:
     7243               if     utd-lines.gds-code ne ?
     7244                  and utd-lines.gds-code ne 0
     7245               then do:
     7246                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7247                       ( utd-lines.gds-code,
     7248                         'mark-type':U,
     7249                          output v-par-val,
     7250                          output v-par-type
     7251                       ).
     7252                  if     EDOParSec:IsEdo
     7253                     and EDOParSec:GetIsEDOForType(v-par-val)
     7254                  then do:
     7255                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     7256                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     7257                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     7258                                                    and length(utd-marking-lines.mark) > 13
     7259                     no-lock no-error.
     7260                     if     avail utd-marking-lines
     7261                        and not CheckErrForLine(buffer utd-lines:handle)
     7262                     then
     7263                        leave Block-utd-lines.
     7264                  end.
     7265                  else
     7266                     vgdsNoMark = yes.
     7267               end.
     7268            end.
     7269            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     7270            if vgdsNoMark then return available utd-lines . else return yes .
     7271         end.
     7272      end.
     7273      return yes.
     7274   end.
     7275   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7276   define temp-table tt-return
     7277     field db-num as integer
     7278     field doc-id as integer
     7279     field mark like marking.mark
     7280   index docid db-num doc-id.
     7281   define temp-table tt-prts
     7282     field rec-id-line as recid
     7283     field rec-id as recid
     7284     field doc-code as character
     7285   index docid doc-code rec-id.
     7286   function  canUtdReturn returns logical
     7287   (input idoc-code as character ):
     7288      define variable Vflag as logical no-undo.
     7289      find first trn-doc where trn-doc.doc-code     eq idoc-code
     7290                           and trn-doc.ext-doc-type eq 'ee':U
     7291      no-lock no-error.
     7292      find first utd where utd.doc-code eq trn-doc.doc-code
     7293                       and utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB no-lock no-error.
     7294      if         available trn-doc
     7295         and not available utd
     7296      then
     7297         Vflag = yes.
     7298      return Vflag.
     7299   end.
     7300   define variable mySeqUtd as int64 no-undo init ?.
     7301   procedure MySeqForUtd:
     7302      define input  parameter iTable       as character no-undo.
     7303      define input  parameter iseqnamehist as character no-undo.
     7304      define input  parameter idb-name     as character no-undo.
     7305      define output parameter Oseq         as int64 no-undo.
     7306      if iTable begins "utd"
     7307      then do:
     7308         if myseqUtd eq ?
     7309         then
     7310            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     7311         Oseq = myseqUtd.
     7312      end.
     7313      else
     7314         Oseq = ?.
     7315      return.
     7316   end.
     7317   function  crUtdReturn returns logical
     7318   (input idoc-code as character ):
     7319      define buffer trn-doc               for ub.trn-doc.
     7320      define buffer doc-line              for ub.doc-line.
     7321      define buffer parts                 for ub.parts.
     7322      define buffer buf_parts             for ub.parts.
     7323      define buffer goods                 for ub.goods.
     7324      define buffer marking-lines         for ub.marking-lines.
     7325      define buffer marking               for ub.marking.
     7326      define buffer utd                   for ub.utd.
     7327      define buffer Buf_utd               for ub.utd.
     7328      define buffer utd-lines             for ub.utd-lines.
     7329      define buffer Buf_utd-lines         for ub.utd-lines.
     7330      define buffer utd-marking-lines     for ub.utd-marking-lines.
     7331      define buffer Buf_utd-marking-lines for ub.utd-marking-lines.
     7332      define variable vi as integer no-undo.
     7333      define variable vFlag as logical no-undo.
     7334      define variable vdb-num as integer no-undo.
     7335      define variable vdoc-id as integer no-undo.
     7336      define variable vvalue  as character no-undo.
     7337      define variable vType   as character no-undo.
     7338      define variable vUTDReturn as logical no-undo.
     7339      for each  tt-prts:
     7340         delete  tt-prts.
     7341      end.
     7342      find first trn-doc where trn-doc.doc-code     eq idoc-code
     7343                           and trn-doc.ext-doc-type eq 'ee':U
     7344      no-lock no-error.
     7345   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
     7346                           input 'edo-return':U ,
     7347                          output vvalue ,
     7348                          output vType ) no-error .
     7349      vUTDReturn = logical(vvalue) no-error.
     7350      if not vUTDReturn
     7351      then
     7352         return no.
     7353      find first utd where utd.doc-code eq trn-doc.doc-code
     7354                       and utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB no-lock no-error.
     7355      if         available trn-doc
     7356         and not available utd
     7357      then do:
     7358         for each doc-line where doc-line.doc-code eq trn-doc.doc-code no-lock,
     7359            each parts where parts.out-code  = doc-line.doc-code
     7360                          and parts.obj-type  = doc-line.obj-type
     7361                          and parts.obj-code  = doc-line.obj-code
     7362                          and parts.artic     = doc-line.artic
     7363                          and parts.prod-type = doc-line.prod-type
     7364                          and parts.prod-code = doc-line.prod-code
     7365         no-lock:
     7366            define variable v-rowid    as rowid no-undo.
     7367            define variable v-tbl-name as character no-undo.
     7368            find first gen-attr where gen-attr.table-name = 'parts':U
     7369                                  and gen-attr.p-key      =  "parts"                + chr(3) +
     7370    parts.obj-type           + chr(3) +
     7371    string(parts.obj-code)   + chr(3) +
     7372    parts.artic              + chr(3) +
     7373    parts.prod-type          + chr(3) +
     7374    string(parts.prod-code)  + chr(3) +
     7375    parts.In-code            + chr(3) +
     7376    parts.Out-code           + chr(3) +
     7377    parts.part-Code          + chr(3) +
     7378    string(parts.prt-code)
     7379                                  and gen-attr.attr-code  = "in-part-key"
     7380            no-lock no-error.
     7381            if available gen-attr
     7382            then do:
     7383               run gen-row-keyr in this-procedure (
     7384                                              input  gen-attr.attr-value
     7385                                              ,input ?
     7386                                              ,input  "ub"
     7387                                              ,input  ?
     7388                                              ,input  no-lock
     7389                                              ,output v-rowid
     7390                                              ,output v-tbl-name ) .
     7391               find first buf_parts where rowid(buf_parts) eq v-rowid no-lock no-error.
     7392            end.
     7393            create tt-prts.
     7394            assign
     7395               tt-prts.rec-id-line = recid(doc-line)
     7396               tt-prts.rec-id   = recid(parts)
     7397               tt-prts.doc-code = if available  buf_parts then buf_parts.in-code  else ""
     7398            .
     7399            release  buf_parts.
     7400         end.
     7401         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7402         do trans:
     7403            block-part:
     7404            for each tt-prts,
     7405               first doc-line where recid(doc-line) eq tt-prts.rec-id-line no-lock,
     7406               first parts where recid(parts) eq tt-prts.rec-id no-lock
     7407            break by  tt-prts.doc-code by tt-prts.rec-id-line:
     7408               find first goods where goods.artic eq parts.artic
     7409                                  and goods.prod-type eq parts.prod-type
     7410                                  and goods.prod-code eq parts.prod-code
     7411               no-lock no-error.
     7412               if not available goods
     7413               then do:
     7414                  message "Не найден товар по поcтавщику " parts.prod-type  parts.prod-code " с аркиклом "  parts.artic
     7415                     view-as alert-box.
     7416                  next block-part.
     7417               end.
     7418               else do:
     7419                  if first-of(tt-prts.doc-code)
     7420                  then do:
     7421                     if    not  available buf_utd
     7422                           or trn-doc.reason-code ne 23
     7423                     then do:
     7424                        if tt-prts.doc-code <> "" then
     7425                        find first utd where utd.doc-code eq tt-prts.doc-code no-lock no-error.
     7426                        if tt-prts.doc-code <> ""
     7427                           and available utd
     7428                        then do:
     7429                           MySeqUtd = ?.
     7430                           vFlag = yes.
     7431                           create buf_utd.
     7432                           buffer-copy utd  except Timestamp
     7433                                                   RevocationStatus
     7434                                                   RecipientResponseStatus
     7435                                                   ReceiptStatus
     7436                                                   ModifyTime
     7437                                                   ModifyDate
     7438                                                   LoadTime
     7439                                                   LoadDate
     7440                                                   EDocType
     7441                                                   DocumentExt
     7442                                                   db-num
     7443                                                   doc-id
     7444                                                   AdditInfo
     7445                                                   doc-code
     7446                                                   sts
     7447                           to buf_utd
     7448                           assign
     7449                              buf_utd.parentDocumentExt     = utd.DocumentExt
     7450                              buf_utd.parentOrganizationExt = utd.OrganizationExt
     7451                              buf_utd.doc-code              = trn-doc.doc-code
     7452                              buf_utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7453                              buf_utd.DocumentDate    = today
     7454                              buf_utd.DocumentNumber  = "Возврат № " + trn-doc.doc-code + (if trn-doc.reason-code ne 23 then " по УПД № " + utd.DocumentNumber + " за " + string(utd.DocumentDate,"99/99/9999") else "")
     7455                              buf_utd.Direction       = "Inbound"
     7456                           .
     7457                           validate buf_utd.
     7458                           define variable mTypeUtd as character no-undo.
     7459                           if   trn-doc.reason-code eq 23
     7460                           then assign
     7461                             buf_utd.PackageId = ""
     7462                             mTypeUtd = "СЧФДОП"
     7463                           .
     7464                           else if trn-doc.reason-code eq 25
     7465                           then
     7466                              mTypeUtd = "ДОП".
     7467                           else
     7468                              mTypeUtd = "".
     7469                           if   mTypeUtd ne ""
     7470                           then
     7471                              setattrutd (buf_utd.db-num,buf_utd.doc-id,"TypeUTD",mTypeUtd).
     7472                           buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:newstatus:KeyIntDB.
     7473                           Buf_utd.sts-edi               = if utd.AmendmentRequested
     7474                                                           then ObjSrv:Env:Utd:Sts:edi:AvailAdjustment:KeyIntDB
     7475                                                           else ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB.
     7476                           assign
     7477                              vdb-num = Buf_utd.db-num
     7478                              vdoc-id = Buf_utd.doc-id
     7479                              vi      = 0
     7480                           .
     7481                        end.
     7482                        else do:
     7483                           MySeqUtd = ?.
     7484                           vFlag = yes.
     7485                           create buf_utd.
     7486                           assign
     7487                              buf_utd.contract-code   = parts.contract-code
     7488                              buf_utd.doc-code        = trn-doc.doc-code
     7489                              buf_utd.DocumentDate    = today
     7490                              buf_utd.DocumentNumber  = "Возврат № " + trn-doc.doc-code + " по накладной " + parts.in-code
     7491                              buf_utd.EDocType        = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7492                              buf_utd.host-code       = parts.host-code
     7493                              buf_utd.obj-type        = parts.obj-type
     7494                              buf_utd.obj-code        = parts.obj-code
     7495                              buf_utd.cli-type        = trn-doc.cli-type
     7496                              buf_utd.cli-code        = trn-doc.cli-code
     7497                           .
     7498                           validate buf_utd.
     7499                           if   trn-doc.reason-code eq 23
     7500                           then assign
     7501                              buf_utd.PackageId = ""
     7502                              mTypeUtd = "СЧФДОП"
     7503                           .
     7504                           else if trn-doc.reason-code eq 25
     7505                           then
     7506                              mTypeUtd = "ДОП".
     7507                           else
     7508                              mTypeUtd = "".
     7509                           if   mTypeUtd ne ""
     7510                           then
     7511                              setattrutd (buf_utd.db-num,buf_utd.doc-id,"TypeUTD",mTypeUtd).
     7512                           buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:newstatus:KeyIntDB.
     7513                           Buf_utd.sts-edi         = ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB.
     7514                           assign
     7515                              vdb-num = Buf_utd.db-num
     7516                              vdoc-id = Buf_utd.doc-id
     7517                              vi      = 0
     7518                           .
     7519                        end.
     7520                     end.
     7521                  end.
     7522                  if first-of(tt-prts.rec-id-line)
     7523                  then do:
     7524                     find first gds-dtl where gds-dtl.doc-code  = doc-line.doc-code
     7525                                          and gds-dtl.artic     = doc-line.artic
     7526                                          and gds-dtl.prod-code = doc-line.prod-code
     7527                                          and gds-dtl.prod-type = doc-line.prod-type
     7528                     no-lock no-error.
     7529                     create buf_utd-lines.
     7530                     assign
     7531                        vi                      = vi + 1
     7532                        buf_utd-lines.Article   = parts.artic
     7533                        buf_utd-lines.db-num    = buf_utd.db-num
     7534                        buf_utd-lines.doc-id    = buf_utd.doc-id
     7535                        buf_utd-lines.LineNum   = vi
     7536                        buf_utd-lines.gds-code     = goods.gds-code
     7537                        buf_utd-lines.ProductCode  = goods.gds-name
     7538                        buf_utd-lines.Quantity     = if available gds-dtl then gds-dtl.fact-qnty  else doc-line.fact-qnty
     7539                        buf_utd-lines.TaxRate      = doc-line.VAT-pc
     7540                        buf_utd-lines.Total        = (if available gds-dtl then gds-dtl.price-rubl else doc-line.price-rubl) * buf_utd-lines.Quantity
     7541                        buf_utd-lines.UnitCode     = goods.unit-base
     7542                        buf_utd-lines.Vat          = buf_utd-lines.Total * buf_utd-lines.TaxRate / (100 + buf_utd-lines.TaxRate)
     7543                        buf_utd-lines.TotalWithVatExcluded = buf_utd-lines.Total  - buf_utd-lines.Vat
     7544                        buf_utd-lines.Price                = buf_utd-lines.TotalWithVatExcluded / buf_utd-lines.Quantity
     7545                     .
     7546                  end.
     7547                  else do:
     7548                     find first buf_utd-lines where buf_utd-lines.db-num    = buf_utd.db-num
     7549                                                and buf_utd-lines.doc-id    = buf_utd.doc-id
     7550                                                and buf_utd-lines.LineNum   = vi
     7551                     no-lock.
     7552                  end.
     7553                  for each marking-lines where marking-lines.gds-code   = goods.gds-code
     7554                                           and marking-lines.obj-type   = parts.obj-type
     7555                                           and marking-lines.obj-code   = parts.obj-code
     7556                                           and marking-lines.in-code    = parts.in-code
     7557                                           and marking-lines.out-code   = parts.out-code
     7558                                           and marking-lines.part-code  = parts.part-code
     7559                                           and marking-lines.doc-level  = 1
     7560                  no-lock:
     7561                     create buf_utd-marking-lines.
     7562                     assign
     7563                        buf_utd-marking-lines.db-num     = buf_utd.db-num
     7564                        buf_utd-marking-lines.doc-id     = buf_utd.doc-id
     7565                        buf_utd-marking-lines.site       = "-"
     7566                        buf_utd-marking-lines.doc-level  = marking-lines.doc-level
     7567                        buf_utd-marking-lines.gds-code   = goods.gds-code
     7568                        buf_utd-marking-lines.LineNum    = buf_utd-lines.LineNum
     7569                        buf_utd-marking-lines.mark       = marking-lines.mark
     7570                        buf_utd-marking-lines.sts        = marking-lines.sts
     7571                     .
     7572                     if buf_utd-marking-lines.doc-level eq 1
     7573                     then
     7574                        AddUtdErr(buf_utd.db-num,buf_utd.doc-id,buffer buf_utd-marking-lines:handle,"return","Mark",marking-lines.mark + chr(4) + buf_utd-lines.ProductCode).
     7575                     release buf_utd-marking-lines.
     7576                  end.
     7577                  if last-of(tt-prts.rec-id-line)
     7578                  then do:
     7579                     release buf_utd-lines.
     7580                  end.
     7581                  if last-of(tt-prts.doc-code)
     7582                  then do:
     7583                     buf_utd.Total = 0.
     7584                     buf_utd.Vat   = 0.
     7585                     for each buf_utd-lines where buf_utd-lines.db-num eq buf_utd.db-num
     7586                                           and buf_utd-lines.doc-id eq buf_utd.doc-id
     7587                     no-lock:
     7588                        buf_utd.Total = buf_utd.Total + buf_utd-lines.Total.
     7589                        buf_utd.Vat   = buf_utd.Vat   + buf_utd-lines.Vat.
     7590                     end.
     7591                     if trn-doc.reason-code ne 23
     7592                     then
     7593                        release buf_utd.
     7594                  end.
     7595               end.
     7596            end.
     7597         end.
     7598         release buf_utd.
     7599         unsubscribe "getNextseq".
     7600         for each buf_utd where buf_utd.doc-code eq trn-doc.doc-code
     7601                            and buf_utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7602         exclusive-lock:
     7603            if    buf_utd.CounteragentId  eq ?
     7604               or buf_utd.CounteragentId  eq ""
     7605               or buf_utd.OrganizationExt eq ?
     7606               or buf_utd.OrganizationExt eq ""
     7607            then
     7608               buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:RequireFilling:KeyIntDB.
     7609            else
     7610               buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:SignatureRequired:KeyIntDB.
     7611         end.
     7612      end.
     7613      for each  tt-prts:
     7614         delete  tt-prts.
     7615      end.
     7616      return vFlag.
     7617   end.
     7618   define variable vss-include-info43 as character format "X(65)" no-undo
     7619   initial "@(#)$Workfile$ $Revision$".
     7620   define temp-table temp_fbr-history no-undo like ub.fbr-history .
     7621   define variable v-fbrhist-history-level     as integer      no-undo.
     7622   define variable v-fbrhist-upper-obj-type    as character    no-undo.
     7623   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
     7624   define variable v-fbrhist-upper-code        as integer      no-undo.
     7625   define variable v-fbrhist-current-obj-type  as character    no-undo.
     7626   define variable v-fbrhist-current-obj-code  as integer      no-undo.
     7627   define variable v-fbrhist-current-code      as integer      no-undo.
     7628   define variable v-fbrhist-saved-obj-type    as character    no-undo.
     7629   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
     7630   define variable v-fbrhist-saved-code        as integer      no-undo.
     7631   procedure fbrhist-write :
     7632   define input parameter p-userid                 as character        no-undo.
     7633   define input parameter p-obj-type               as character        no-undo.
     7634   define input parameter p-obj-code               as integer          no-undo.
     7635   define input parameter p-hst-type               as character        no-undo.
     7636   define input parameter p-hst-level              as integer          no-undo.
     7637   define input parameter p-procedure-name         as character        no-undo.
     7638   define input parameter p-procedure-parameters   as character        no-undo.
     7639   define input parameter p-doc-code               as character        no-undo.
     7640   define input parameter p-doc-type               as character        no-undo.
     7641   define input parameter p-status_                as character        no-undo.
     7642   define input parameter p-is-free                as logical          no-undo.
     7643   define input parameter p-recipe-code            as character        no-undo.
     7644   define input parameter p-recipe-type            as character        no-undo.
     7645   define input parameter p-gds-code               as integer          no-undo.
     7646   define input parameter p-trn-type               as character        no-undo.
     7647   define input parameter p-qnty                   as decimal          no-undo.
     7648   define input parameter p-PS                     as character        no-undo.
     7649   define input parameter p-is-error               as logical          no-undo.
     7650       define variable v-today                         as date         no-undo.
     7651       define variable v-obj-date                      as date         no-undo.
     7652       define variable v-time                          as integer      no-undo.
     7653       define variable v-host-code                     as integer      no-undo.
     7654       define variable v-db-num                        as integer      no-undo.
     7655       define buffer buf_temp_fbr-history       for temp_fbr-history.
     7656       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
     7657   do
     7658   for buf_temp_fbr-history
     7659     , buf_upper_temp_fbr-history
     7660   on error undo, return error
     7661   :
     7662       if v-fbrhist-history-level = 0
     7663       or v-fbrhist-history-level < p-hst-level
     7664       then do:
     7665           undo, return .
     7666       end.
     7667       if v-fbrhist-upper-code <> 0
     7668       then do:
     7669           find first buf_upper_temp_fbr-history no-lock
     7670                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
     7671                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
     7672                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
     7673           no-error.
     7674       end.
     7675   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     7677     (input  p-obj-type
     7678     ,input  p-obj-code
     7679     ,output v-obj-date
     7680     )  .
     7681       run cur-time in this-procedure (
     7682             output v-today
     7683           , output v-time
     7684       ).
     7685   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7687     (input  p-obj-type
     7688     ,input  p-obj-code
     7689     ,output v-host-code
     7690     )  .
     7691   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7693     (output v-db-num
     7694     )  .
     7695       create buf_temp_fbr-history.
     7696       assign
     7697           buf_temp_fbr-history.obj-type                = p-obj-type
     7698           buf_temp_fbr-history.obj-code                = p-obj-code
     7699           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
     7700           buf_temp_fbr-history.hst-type                = p-hst-type
     7701           buf_temp_fbr-history.hst-level               = p-hst-level
     7702           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
     7703           buf_temp_fbr-history.procedure-name          = p-procedure-name
     7704           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
     7705           buf_temp_fbr-history.doc-code                = p-doc-code
     7706           buf_temp_fbr-history.doc-type                = p-doc-type
     7707           buf_temp_fbr-history.status_                 = p-status_
     7708           buf_temp_fbr-history.is-free                 = p-is-free
     7709           buf_temp_fbr-history.recipe-code             = p-recipe-code
     7710           buf_temp_fbr-history.recipe-type             = p-recipe-type
     7711           buf_temp_fbr-history.gds-code                = p-gds-code
     7712           buf_temp_fbr-history.trn-type                = p-trn-type
     7713           buf_temp_fbr-history.qnty                    = p-qnty
     7714           buf_temp_fbr-history.PS                      = p-ps
     7715           buf_temp_fbr-history.is-error                = p-is-error
     7716           buf_temp_fbr-history.db-num                  = v-db-num
     7717           buf_temp_fbr-history.user-name               = p-userid
     7718           buf_temp_fbr-history.sys-date                = v-today
     7719           buf_temp_fbr-history.sys-time-int            = v-time
     7720           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
     7721           buf_temp_fbr-history.obj-date                = v-obj-date
     7722           buf_temp_fbr-history.host-code               = v-host-code
     7723       .
     7724       assign
     7725           v-fbrhist-current-obj-type                   = p-obj-type
     7726           v-fbrhist-current-obj-code                   = p-obj-code
     7727           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
     7728       .
     7729       if available buf_upper_temp_fbr-history
     7730       then do:
     7731           assign
     7732               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
     7733                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
     7734                                               + "-":U + string( buf_temp_fbr-history.obj-code )
     7735                                               + "-":U + string( buf_temp_fbr-history.hst-code )
     7736           .
     7737       end.
     7738       else do:
     7739           assign
     7740               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
     7741                                  + "-":U + string( buf_temp_fbr-history.obj-code )
     7742                                  + "-":U + string( buf_temp_fbr-history.hst-code )
     7743           .
     7744       end.
     7745   end.
     7746   end procedure.
     7747   procedure fbrhist-read-conf :
     7748   do
     7749   on error undo, return error
     7750   :
     7751      define variable v-value-character as character  no-undo .
     7752      define variable v-value-date      as date       no-undo .
     7753      define variable v-value-decimal   as decimal    no-undo .
     7754      define variable v-value-logical   as logical    no-undo .
     7755      define variable v-tth             as handle     no-undo .
     7756      define variable v-param-type            as character no-undo .
     7757      run adm/shattri.p ( input "get":U
     7758                        , input  '':u
     7759                        , input  0
     7760                        , input  'fbrattr':U
     7761                        , input  'fbrhstlv':U
     7762                        , output v-value-character
     7763                        , output v-value-date
     7764                        , output v-value-decimal
     7765                        , output v-fbrhist-history-level
     7766                        , output v-value-logical
     7767                        , output v-param-type
     7768                        , input-output table-handle v-tth
     7769                        ) no-error .
     7770      if error-status :error then do:
     7771         assign
     7772            v-fbrhist-history-level = 0
     7773         .
     7774      end.
     7775   end.
     7776   end procedure.
     7777   procedure fbrhist-table-to-base :
     7778       define buffer buf_fbr-history       for ub.fbr-history.
     7779       define buffer buf_temp_fbr-history  for temp_fbr-history.
     7780   do
     7781   for buf_fbr-history
     7782     , buf_temp_fbr-history
     7783   on error undo, return error
     7784   :
     7785       for each buf_temp_fbr-history
     7786       on error undo, return error
     7787       :
     7788           create buf_fbr-history.
     7789           buffer-copy buf_temp_fbr-history to buf_fbr-history.
     7790       end.
     7791   end.
     7792   end procedure.
     7793   procedure fbrhist-init :
     7794       define buffer buf_temp_fbr-history      for temp_fbr-history.
     7795   do
     7796   for buf_temp_fbr-history
     7797   on error undo, return error
     7798   :
     7799       for each buf_temp_fbr-history
     7800       :
     7801           delete buf_temp_fbr-history.
     7802       end.
     7803       assign
     7804           v-fbrhist-upper-obj-type    = ""
     7805           v-fbrhist-upper-obj-code    = 0
     7806           v-fbrhist-upper-code        = 0
     7807           v-fbrhist-current-obj-type  = ""
     7808           v-fbrhist-current-obj-code  = 0
     7809           v-fbrhist-current-code      = 0
     7810           v-fbrhist-saved-obj-type    = ""
     7811           v-fbrhist-saved-obj-code    = 0
     7812           v-fbrhist-saved-code        = 0
     7813       .
     7814   end.
     7815   end procedure.
     7816   procedure fbrhist-set-upper-code :
     7817   do
     7818   on error undo, return error
     7819   :
     7820       assign
     7821           v-fbrhist-upper-obj-type    = v-fbrhist-current-obj-type
     7822           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
     7823           v-fbrhist-upper-code        = v-fbrhist-current-code
     7824       .
     7825   end.
