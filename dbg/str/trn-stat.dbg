     1233           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     1234       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * 1) .
     1235   end.
     1236   else do:
     1237     assign
     1238           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * parcurbase-rate / parcurbase-scale)
     1239       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * parcurbase-rate / parcurbase-scale) .
