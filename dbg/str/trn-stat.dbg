     1216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1217     (output varoutvprbcur
     1218     )  .
     1219   if varoutvprbcur = "base":u then do:
     1220     assign
     1221           road-tax-base-salecur    =  (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     1222       excise-base-salecur      =  (if parcurexcise   = ? then 0 else parcurexcise   * 1)
     1223     .
