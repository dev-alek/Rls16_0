     2812     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2813     define input parameter p-start-fact-order   as decimal   no-undo .
     2814     define input parameter p-end-fact-order     as decimal   no-undo .
     2815     define input parameter p-lock-gds-obj       as logical   no-undo .
