    12298           define variable v-sum like ub.fin-ob-trn.sum-rubl no-undo .
    12299           if bf_trn-doc.ext-doc-type = 'ee':U or bf_trn-doc.ext-doc-type = 're':U and bf_trn-doc.contract-code <> 0 and bf_trn-doc.contract-code <> ? then do:
    12300                   p-cons = 0.
    12301               find first bf_contract no-lock where bf_contract.contract-code = bf_trn-doc.contract-code no-error .
    12302                 if available bf_contract then do:
    12303                   if  bf_contract.usl-opl <> 'Не определено' then do:
    12304                   define variable v-fo-gen as integer no-undo.
    12305   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12306   empty temp-table thbjattr_thbj-attr.
    12307   run adm/shattri.p (
    12308      input "get":U
    12309     ,input ''
    12310     ,input 0
    12311     ,input 'fin-global':U
    12312     ,input  ""
    12313     ,output v-value-character
    12314     ,output v-value-date
    12315     ,output v-value-decimal
    12316     ,output v-value-integer
    12317     ,output v-value-logical
    12318     ,output par-type
    12319     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    12320     ) no-error .
    12321                       for each thbjattr_thbj-attr exclusive-lock:
    12322                           if thbjattr_thbj-attr.prop-code = 'fo-gen':U  then v-fo-gen = thbjattr_thbj-attr.property-value-integer .
    12323                       end.
    12324                       if ((varstatus = 'накл':U and bf_trn-doc.flag_ = yes and (v-fo-gen = 3 or v-fo-gen = 2 )) or (varstatus = 'разрешен':U and (v-fo-gen = 4 or v-fo-gen = 5) ) or (varstatus = 'факт':U and v-fo-gen > 1 )) or ((bf_contract.usl-opl = 'Предоплата' or bf_contract.usl-opl = 'Предоплата(%)') and varstatus = 'разрешен':U) then do:
    12325                                     for each bf_fin-ob-trn where bf_fin-ob-trn.trn-doc-code = bf_trn-doc.doc-code exclusive-lock:
    12326                                       v-sum = v-sum + bf_fin-ob-trn.sum-rubl .
    12327                                     end.
    12328                                     if (abs (v-sum) <> bf_trn-doc.tot-fact and abs (v-sum) <> (bf_trn-doc.tot-sale - bf_trn-doc.discnt-rubl)) or (bf_contract.usl-opl = 'Предоплата' or bf_contract.usl-opl = 'Предоплата(%)') and (varstatus = 'разрешен':U or (varstatus = 'факт':U and v-fo-gen > 1 )) then do:
    12329                           if bf_contract.usl-opl = 'Предоплата' or bf_contract.usl-opl = 'Предоплата(%)' then p-cons = 1.
    12330                           if bf_contract.usl-opl = 'По факту поставки покупателю'  then p-cons = 2.
    12331                           if bf_contract.usl-opl = 'Отсрочка платежа по поставке'  then p-cons = 3.
    12332                           if bf_trn-doc.ext-doc-type = 'ee':U then do:
    12333                            if bf_contract.usl-opl <> 'Предоплата' and bf_contract.usl-opl <> 'Предоплата(%)' then do:
    12334                                find first bf_fin-ob-trn where bf_fin-ob-trn.trn-doc-code = bf_trn-doc.doc-code and v-sum > (bf_trn-doc.tot-fact - bf_trn-doc.discnt-rubl) no-error.
    12335                                   if not available bf_fin-ob-trn then do:
    12336                                       run str/limcontr.p ( input bf_trn-doc.host-code, input bf_trn-doc.contract-code, input 0, input bf_trn-doc.tot-sale - bf_trn-doc.discnt-rubl - v-sum, input bf_trn-doc.tot-fact - bf_trn-doc.discnt-rubl - v-sum ) no-error .
    12337                                       if error-status :error then return error return-value .
    12338                                   end.
    12339                             end.
    12340                            if (bf_contract.usl-opl = 'Предоплата' or bf_contract.usl-opl = 'Предоплата(%)') and varstatus = 'разрешен':U then do:
    12341                                       run str/limcontr.p ( input bf_trn-doc.host-code, input bf_trn-doc.contract-code, input 0, input 0, input  bf_trn-doc.tot-fact - bf_trn-doc.discnt-rubl ) no-error .
    12342                                       if error-status :error then return error return-value .
    12343                            end.
    12344                            if (bf_contract.usl-opl = 'Предоплата' or bf_contract.usl-opl = 'Предоплата(%)') and (varstatus = 'факт':U and v-fo-gen > 1 ) then do:
    12345                              if abs (v-sum) <> bf_trn-doc.tot-fact and abs (v-sum) <> (bf_trn-doc.tot-sale - bf_trn-doc.discnt-rubl) then do:
