     3477   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3478   procedure thbjattr_code :
     3479      define input  parameter p-upper-code     as character no-undo .
     3480      define input  parameter p-code           as character no-undo .
     3481      define output parameter p-label          as character no-undo .
     3482      define output parameter p-user-can-edit  as logical   no-undo .
     3483      define output parameter p-output-display as logical   no-undo .
     3484      define output parameter p-other          as character no-undo .
     3485      define output parameter p-prop-list      as character no-undo .
     3486      define output parameter p-prop-type-list as character no-undo .
     3487      define output parameter p-prop-label-list as character no-undo .
     3488      define output parameter p-global          as logical no-undo .
     3489      define output parameter p-host           as logical no-undo .
     3490      define output parameter p-shop           as logical no-undo .
     3491      define output parameter p-store          as logical no-undo .
     3492      define output parameter p-db             as logical no-undo .
     3493      define variable p-region as logical no-undo.
     3494      run thbjattr_code_reg in this-procedure (
     3495                                               p-upper-code,
     3496                                               p-code,
     3497                                               output p-label,
     3498                                               output p-user-can-edit,
     3499                                               output p-output-display,
     3500                                               output p-other,
     3501                                               output p-prop-list,
     3502                                               output p-prop-type-list,
     3503                                               output p-prop-label-list,
     3504                                               output p-global,
     3505                                               output p-host,
     3506                                               output p-shop,
     3507                                               output p-store,
     3508                                               output p-db,
     3509                                               output p-region
     3510                                               ).
     3511   end procedure.
     3512   procedure thbjattr_code_reg :
     3513   define input  parameter p-upper-code     as character no-undo .
     3514   define input  parameter p-code           as character no-undo .
     3515   define output parameter p-label          as character no-undo .
     3516   define output parameter p-user-can-edit  as logical   no-undo .
     3517   define output parameter p-output-display as logical   no-undo .
     3518   define output parameter p-other          as character no-undo .
     3519   define output parameter p-prop-list      as character no-undo .
     3520   define output parameter p-prop-type-list as character no-undo .
     3521   define output parameter p-prop-label-list as character no-undo .
     3522   define output parameter p-global          as logical no-undo .
     3523   define output parameter p-host           as logical no-undo .
     3524   define output parameter p-shop           as logical no-undo .
     3525   define output parameter p-store          as logical no-undo .
     3526   define output parameter p-db             as logical no-undo .
     3527   define output parameter p-region         as logical no-undo .
     3528   do
     3529   on error undo, return error return-value
     3530   :
     3531       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     3532       (input  p-upper-code
     3533       ,input  p-code
     3534       ,output p-label
     3535       ,output p-user-can-edit
     3536       ,output p-output-display
     3537       ,output p-other
     3538       ,output p-prop-list
     3539       ,output p-prop-type-list
     3540       ,output p-prop-label-list
     3541       ,output p-global
     3542       ,output p-host
     3543       ,output p-shop
     3544       ,output p-store
     3545       ,output p-db
     3546       ,output p-region
     3547       ) no-error .
     3548     if error-status :error
     3549     then do:
     3550       undo, return error substitute( "&1. &2&3&4", vss-include-info30, return-value, chr(10), error-status :get-message (1)).
     3551     end.
     3552   end.
     3553   end procedure.
     3554   procedure thbjattr_tooltip :
     3555   define input  parameter p-upper-code  as character no-undo .
     3556   define input  parameter p-code      as character no-undo .
     3557   define output parameter p-tooltip   as character no-undo .
     3558   define output parameter p-label     as character no-undo .
     3559   define output parameter p-tooltip-code as character no-undo .
     3560   do
     3561   on error undo, return error return-value
     3562   :
     3563       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_tooltip in g#attr-lib
     3564       (input  p-upper-code
     3565       ,input  p-code
     3566       ,output p-tooltip
     3567       ,output p-label
     3568       ,output p-tooltip-code
     3569       ) no-error .
     3570     if error-status :error
     3571     then do:
     3572       undo, return error return-value .
     3573     end.
     3574   end.
     3575   end procedure.
