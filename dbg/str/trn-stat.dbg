     1783   procedure clcprtsl_calc-line :
     1784   define input  parameter parrec-line as recid no-undo.
     1785   define variable v-tax-date         as   date                     no-undo.
     1786   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1787   define variable varr-b             as   character                no-undo.
     1788   define variable varr-btype         as   character                no-undo.
     1789   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1790   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1791   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1792   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1793   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1794   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1795   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1796   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1797   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1798   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1799   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1800   define variable varexcise          like ub.price-list.excise     no-undo.
     1801   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1802   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1803   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1804   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1805   define variable v-varsum           as decimal                  no-undo.
     1806   define variable varprice-salef as decimal   no-undo .
     1807   define buffer bf_trn-doc             for ub.trn-doc.
     1808   define buffer bf_doc-line            for ub.doc-line.
     1809   define buffer bf_gds-dtl             for ub.gds-dtl.
     1810   define buffer bf_goods               for ub.goods.
     1811   define buffer bf_parts               for ub.parts.
     1812   define buffer bf_sysconf             for ub.sysconf.
     1813   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1814   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1815   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1816   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1817   define buffer buf_parts        for ub.parts.
     1818   v-calcbypart = no.
     1819   do on error undo, return error return-value :
     1820   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1822     (output varr-b
     1823     )  .
     1824     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1825     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1826     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1827                               bf_goods.prod-type = bf_doc-line.prod-type and
     1828                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1829     if bf_trn-doc.fact-date <> ?        then do:
     1830       assign v-tax-date = bf_trn-doc.fact-date.
     1831     end.
     1832     else do:
     1833       assign v-tax-date = ?.
     1834     end.
     1835   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1837     (input  bf_goods.gds-code
     1838     ,input  '1':U
     1839     ,input  v-tax-date
     1840     ,input  bf_trn-doc.host-code
     1841     ,input  bf_trn-doc.obj-type
     1842     ,input  bf_trn-doc.obj-code
     1843     ,output v-vat-pc
     1844     ) no-error .
     1845     if error-status :error
     1846     or v-vat-pc = ? then do:
     1847        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1848     end.
     1849     if bf_goods.gds-type = 'у':U or
     1850        bf_trn-doc.status_ = 'запрос':U then do:
     1851       for each bf_tt-allsum-line
     1852       on error undo, return error return-value
     1853        :
     1854         delete bf_tt-allsum-line.
     1855       end.
     1856       create bf_tt-allsum-line.
     1857       assign
     1858        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1859       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1860                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1861                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1862                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1863         assign
     1864           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1865           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1866           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1867           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1868           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1869           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1870           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1871           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1872           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1873           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1874           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1875           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1876           bf_tt-allsum-line.vat-cli-acc          =  ?
     1877           .
     1878       end.
     1879       assign
     1880         bf_tt-allsum-line.cli-qnty             =  ?
     1881         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1882         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1883         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1884         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1885         bf_tt-allsum-line.road-tax-base-doc    =  0
     1886         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1887         bf_tt-allsum-line.excise-base-doc      =  0
     1888         bf_tt-allsum-line.excise-rubl-doc      =  0
     1889         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1890         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1891         bf_tt-allsum-line.dsc-base-cur         =  0
     1892         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1893         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1894         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1895         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1896         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1897         bf_tt-allsum-line.road-tax-base-cur    =  0
     1898         bf_tt-allsum-line.road-tax-rubl-cur    =  0
