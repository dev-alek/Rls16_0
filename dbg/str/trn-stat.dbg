     2833           "Артикул" p-artic p-prod-type p-prod-code skip
     2834           "p-start-fact-order" p-start-fact-order skip
     2835           "p-end-fact-order"   p-end-fact-order skip
     2836           view-as alert-box error .
     2837         undo, return error .
     2838       end.
     2839       if p-lock-gds-obj = true
     2840       then do:
     2841         do transaction
     2842         on error undo, return error
     2843         :
     2844   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2846     (input  p-obj-type
