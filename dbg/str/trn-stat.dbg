    12936       if lookup (bf_trn-doc.ext-doc-type,
    12937                 'ee':U + "," +
    12938                 'ev':U ) <> 0  and
    12939                 ((bf_trn-doc.status_ = 'накл':U and bf_trn-doc.flag_ = false  ) )
    12940         then do:
    12941         var-ok-assort-pol = true .
    12942         if not (bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'чел':U) then do:
    12943            v-event-code = substitute("cli_&1-" , bf_trn-doc.ext-doc-type ) .
    12944   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12945   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
    12946     (input  v-event-code
    12947     ,input  buf_goods.gds-code
    12948     ,input  bf_trn-doc.cli-type
    12949     ,input  bf_trn-doc.cli-code
    12950     ,input  false
    12951     ,output var-ok-assort-pol
    12952     ,output var-mess-assort-pol
    12953     ) .
    12954           end.
    12955           else do:
    12956   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    12958     (input  bf_trn-doc.doc-code
    12959     ,output v-is-hold
    12960     )  .
    12961            if v-is-hold then do:
    12962               v-event-code = substitute("cli_mf_&1-" ,bf_trn-doc.ext-doc-type ) .
    12963   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12964   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
    12965     (input  v-event-code
    12966     ,input  buf_goods.gds-code
    12967     ,input  bf_trn-doc.hold-obj-type
    12968     ,input  bf_trn-doc.hold-obj-code
    12969     ,input  false
    12970     ,output var-ok-assort-pol
    12971     ,output var-mess-assort-pol
    12972     ) .
    12973            end.
    12974            end.
    12975          if var-ok-assort-pol = false then do:
    12976               varerr = true .
    12977               output stream str-err to value( replace( bf_trn-doc.doc-code, "*", "$" ) + ".err" ) append.
    12978               put    stream str-err unformatted var-mess-assort-pol skip.
    12979               output stream str-err close.
    12980          end.
    12981       end.
    12982       if lookup (bf_trn-doc.ext-doc-type,
    12983                 'vt':U + "," +
    12984                 'vp':U + "," +
    12985                 'we':U + "," +
    12986                 'wm':U + ","  +
    12987                 'es':U + ","+
    12988                 're':U + "," +
    12989                 'ep':U + ","  +
    12990                 'pc':U + ","  +
    12991                 'mp':U + ","  +
    12992                 'ap':U   + "," +
    12993                 'rv':U  + "," +
    12994                 'eo':U  + "," +
    12995                 'io':U ) = 0  and
    12996                 ((bf_trn-doc.status_ = 'накл':U    and bf_trn-doc.flag_ = false  ))
    12997       then do:
    12998         var-ok-assort-pol = true .
    12999   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    13001     (input  bf_trn-doc.doc-code
    13002     ,output v-is-hold
    13003     )  .
    13004            if v-is-hold then do:
    13005               v-event-code = substitute("mf_&1-" ,bf_trn-doc.ext-doc-type ) .
    13006            end.
    13007            else do:
    13008               v-event-code = substitute("&1-" ,bf_trn-doc.ext-doc-type ) .
    13009            end.
