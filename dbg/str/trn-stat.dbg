    13029   procedure ver-inv-date-close :
    13030   define input  parameter p-doc-code as character no-undo .
    13031   define input  parameter p-date as date          no-undo .
    13032   define variable v-date as date      no-undo .
    13033     do
    13034     on error undo, return error return-value
    13035     :
    13036     find first ub.doc-attr exclusive-lock where
    13037                ub.doc-attr.doc-code = p-doc-code and
    13038                ub.doc-attr.attr-code = 'dateinv':U no-error .
    13039      if available ub.doc-attr then do:
    13040         v-date =  date (ub.doc-attr.attr-value) .
    13041         if  v-date <  p-date then do:
    13042             return error substitute("Предполагаемая дата закрытия инвентаризации &1 уже просрочена ! Инвентаризацию &2 закрыть нельзя." , string(v-date , "99/99/9999") , p-doc-code ) .
    13043         end.
    13044         if  v-date >  p-date then do:
    13045             return error substitute("Предполагаемая дата закрытия инвентаризации &1 еще не настала ! Инвентаризацию &2 закрыть нельзя." , string(v-date , "99/99/9999") , p-doc-code ) .
    13046         end.
    13047      end.
    13048     end.
    13049   end procedure.
    13050   procedure fill-mol:
    13051     find first ub.user-account no-lock where ub.user-account.user-id = v-curr-userid.
    13052     if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
    13053       then
    13054     do:
    13055       if bf_trn-doc.agnt = ? then do:
    13056         bf_trn-doc.agnt = ub.user-account.psn-code.
    13057       end.
    13058       if bf_trn-doc.wrkr = ?
    13059       then do:
    13060         bf_trn-doc.wrkr = ub.user-account.psn-code.
    13061       end.
    13062       bf_trn-doc.boss = ub.user-account.psn-code.
    13063     end.
    13064     release ub.user-account.
    13065   end procedure.
    13066   procedure need-ver-spec :
    13067   define output parameter v-is-nover as logical   no-undo .
    13068   define variable v-uh as handle no-undo .
    13069     do
    13070     on error undo, return error return-value
    13071     :
    13072     assign
    13073     v-uh = this-procedure:instantiating-procedure
    13074     v-is-nover = false
    13075     .
    13076     if v-uh:persistent then return .
    13077     do while valid-handle(v-uh):
    13078       if v-uh:persistent then return .
    13079       if lookup("cb_close-without-verify", v-uh:internal-entries) > 0 then do:
    13080         run cb_close-without-verify in v-uh ( output v-is-nover ) no-error.
    13081         leave.
    13082       end.
    13083       v-uh = v-uh:instantiating-procedure.
    13084     end.
    13085     end.
    13086   end procedure.
