     2851     ,buffer buf_gds-obj
     2852     ) no-error .
     2853           if error-status :error
     2854           then do:
     2855             message
     2856               vss-workfile vss-revision vss-description skip
     2857               vss-include-info21 skip
     2858               "Невозможно найти gds-obj" skip
     2859               error-status :get-message(1) skip
     2860               return-value skip
     2861               view-as alert-box error .
     2862             undo, return error .
     2863           end.
     2864           find current buf_gds-obj exclusive-lock .
