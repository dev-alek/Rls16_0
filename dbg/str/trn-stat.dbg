    12350                                         if error-status :error then return error return-value .
    12351                                   end.
    12352                                end.
    12353                              end.
    12354                            end.
    12355                           end.
    12356                           if abs (v-sum) <> (bf_trn-doc.tot-fact - bf_trn-doc.discnt-rubl) and abs (v-sum) <> (bf_trn-doc.tot-sale - bf_trn-doc.discnt-rubl) then do:
