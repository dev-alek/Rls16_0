     2867   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2869     (input  p-artic
     2870     ,input  p-prod-type
     2871     ,input  p-prod-code
     2872     ,input  'gds-goods=request':u
     2873     ,output v-goods-gds-goods
     2874     ) no-error .
     2875       if error-status :error
     2876       then do:
     2877         message
     2878           vss-workfile vss-revision vss-description skip
     2879           vss-include-info21 skip
     2880           "Ошибка при определении атрибута товара" skip
     2881           "Артикул" p-artic p-prod-type p-prod-code skip
     2882           "gds-goods=request" skip
     2883           error-status :get-message(1) skip
     2884           return-value skip
     2885           view-as alert-box error .
     2886         undo, return error return-value .
     2887       end.
     2888   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2890     (input  p-artic
     2891     ,input  p-prod-type
     2892     ,input  p-prod-code
     2893     ,input  'twounit=request':u
     2894     ,output v-goods-twounit
     2895     ) no-error .
     2896       if error-status :error
     2897       then do:
     2898         message
     2899           vss-workfile vss-revision vss-description skip
     2900           vss-include-info21 skip
     2901           "Ошибка при определении атрибута товара" skip
     2902           "Артикул" p-artic p-prod-type p-prod-code skip
     2903           "twounit=request" skip
     2904           error-status :get-message(1) skip
     2905           return-value skip
     2906           view-as alert-box error .
     2907         undo, return error return-value .
     2908       end.
     2909       for each buf_doc-line no-lock
     2910         where buf_doc-line.obj-type   = p-obj-type
     2911           and buf_doc-line.obj-code   = p-obj-code
     2912           and buf_doc-line.artic      = p-artic
     2913           and buf_doc-line.prod-type  = p-prod-type
     2914           and buf_doc-line.prod-code  = p-prod-code
     2915           and buf_doc-line.status_    = 'факт':U
     2916           and buf_doc-line.fact-order > p-start-fact-order
     2917           and buf_doc-line.fact-order <= p-end-fact-order
     2918       on error undo, return error
     2919       :
     2920         run partslib-process-document in this-procedure
     2921           (input  buf_doc-line.doc-code
     2922           ,input  p-obj-type
     2923           ,input  p-obj-code
     2924           ,input  p-artic
     2925           ,input  p-prod-type
     2926           ,input  p-prod-code
     2927           ,input  v-goods-gds-goods
     2928           ,input  v-goods-twounit
     2929           ,output v-total-parts-qnty
     2930           ) no-error .
     2931         if error-status :error
     2932         then do:
     2933           message
     2934             vss-workfile vss-revision vss-description skip
     2935             vss-include-info21 skip
     2936             "Ошибка при вызове процедуры partslib-process-document" skip
     2937             "Документ" buf_doc-line.doc-code skip
     2938             "Объект" p-obj-type p-obj-code skip
     2939             "Артикул" p-artic p-prod-type p-prod-code skip
     2940             "p-start-fact-order" p-start-fact-order skip
     2941             "p-end-fact-order" p-end-fact-order skip
     2942             error-status :get-message(1) skip
     2943             return-value skip
     2944             view-as alert-box error .
     2945           undo, return error return-value .
     2946         end.
     2947       end.
     2948     end.
     2949   end procedure.
     2950   procedure partslib-process-document :
     2951     define input  parameter p-doc-code         as character no-undo .
     2952     define input  parameter p-obj-type         as character no-undo .
     2953     define input  parameter p-obj-code         as integer   no-undo .
     2954     define input  parameter p-artic            as character no-undo .
     2955     define input  parameter p-prod-type        as character no-undo .
     2956     define input  parameter p-prod-code        as integer   no-undo .
     2957     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2958     define input  parameter p-goods-twounit    as logical   no-undo .
     2959     define output parameter p-total-parts-qnty as decimal   no-undo .
     2960     define variable v-parts-sign as integer   no-undo .
     2961     define buffer buf_trn-doc    for ub.trn-doc .
     2962     define buffer buf_doc-line   for ub.doc-line .
     2963     define buffer buf_parts      for ub.parts .
     2964     define buffer buf_temp-parts for temp-parts .
     2965     do
     2966     on error undo, return error return-value
     2967     :
     2968       find first buf_trn-doc no-lock
     2969         where buf_trn-doc.doc-code = p-doc-code
     2970         no-error .
     2971       if not available buf_trn-doc
     2972       then do:
     2973         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2974                                      ,p-doc-code
     2975                                      ) .
     2976       end.
     2977       case buf_trn-doc.doc-type
     2978       :
     2979         when 'при':U or
     2980         when 'возврат':U or
     2981         when 'инв':U
     2982         then do:
     2983           assign
     2984             v-parts-sign = -1
     2985           .
     2986         end.
     2987         when 'рас':U or
     2988         when 'спи':U
     2989         then do:
     2990           assign
     2991             v-parts-sign = 1
     2992           .
     2993         end.
     2994         otherwise do:
     2995           undo, return error substitute("Неизвестный тип документа &1"
     2996                                       ,buf_trn-doc.doc-type
     2997                                       ) .
     2998         end.
     2999       end.
     3000       find first buf_doc-line no-lock
     3001         where buf_doc-line.doc-code  = p-doc-code
     3002           and buf_doc-line.artic     = p-artic
     3003           and buf_doc-line.prod-type = p-prod-type
     3004           and buf_doc-line.prod-code = p-prod-code
     3005         no-error .
     3006       if not available buf_doc-line
     3007       then do:
     3008         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     3009                                      ,p-doc-code
     3010                                      ,artic
     3011                                      ,prod-type
     3012                                      ,prod-code
     3013                                      ) .
     3014       end.
     3015       assign
     3016         p-total-parts-qnty = 0
     3017       .
     3018       if p-goods-gds-goods = true
     3019       then do:
     3020         for each buf_parts no-lock
     3021           where buf_parts.out-code  = p-doc-code
     3022             and buf_parts.obj-type  = p-obj-type
     3023             and buf_parts.obj-code  = p-obj-code
     3024             and buf_parts.artic     = p-artic
     3025             and buf_parts.prod-type = p-prod-type
     3026             and buf_parts.prod-code = p-prod-code
     3027         on error undo, return error
     3028         :
     3029           run partslib-create-temp-parts in this-procedure
     3030             (buffer buf_parts
     3031             ,buffer buf_temp-parts
     3032             ,input  p-goods-twounit
     3033             ) .
     3034           assign
     3035             p-total-parts-qnty        = p-total-parts-qnty
     3036                                       + v-parts-sign * buf_parts.fact-qnty
     3037             buf_temp-parts.qnty       = buf_temp-parts.qnty
     3038                                       + v-parts-sign * buf_parts.fact-qnty
     3039             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     3040                                       + v-parts-sign * buf_parts.fact-qnty
     3041             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     3042                                       + v-parts-sign * buf_parts.cli-qnty
     3043           .
     3044           if buf_temp-parts.qnty = 0
     3045           then do:
     3046             delete buf_temp-parts .
     3047           end.
     3048         end.
     3049       end.
     3050       else do:
     3051         assign
     3052           p-total-parts-qnty = p-total-parts-qnty
     3053                              + v-parts-sign * buf_doc-line.fact-qnty
     3054         .
     3055       end.
     3056     end.
     3057   end procedure.
     3058   procedure partslib-init-temp-parts-by-date :
     3059     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     3060     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     3061     define input parameter p-artic           like ub.parts.artic     no-undo .
     3062     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     3063     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     3064     define input parameter p-fact-date       as date      no-undo .
     3065     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     3066     do
     3067     on error undo, return error
     3068     :
     3069       define variable v-fact-order                as decimal   no-undo .
     3070       define variable v-shift-end-fact-order      as decimal   no-undo .
     3071       define variable v-day-end-fact-order        as decimal   no-undo .
     3072       run factord in this-procedure
     3073         (input  p-fact-date
     3074         ,input  1
     3075         ,input  1
     3076         ,input  ?
     3077         ,input  0
     3078         ,input  false
     3079         ,output v-fact-order
     3080         ,output v-shift-end-fact-order
     3081         ,output v-day-end-fact-order
     3082         ) no-error .
     3083       if error-status :error
     3084       then do:
     3085         message
     3086           vss-workfile vss-revision vss-description skip
     3087           vss-include-info21 skip
     3088           "Ошибка при определении момента времени, на который требуется остаток" skip
     3089           "Объект" p-obj-type p-obj-code skip
     3090           "Артикул" p-artic p-prod-type p-prod-code skip
     3091           "Дата" p-fact-date skip
     3092           view-as alert-box error .
     3093         undo, return error .
     3094       end.
     3095       run partslib-init-temp-parts-by-factord in this-procedure
     3096         (input p-obj-type
     3097         ,input p-obj-code
     3098         ,input p-artic
     3099         ,input p-prod-type
     3100         ,input p-prod-code
     3101         ,input v-day-end-fact-order
     3102         ,input false
     3103         ) no-error .
     3104       if error-status :error
     3105       then do:
     3106         message
     3107           vss-workfile vss-revision vss-description skip
     3108           vss-include-info21 skip
     3109           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     3110           "Объект" p-obj-type p-obj-code skip
     3111           "Артикул" p-artic p-prod-type p-prod-code skip
     3112           "Дата" p-fact-date skip
     3113           view-as alert-box error .
     3114         undo, return error .
     3115       end.
     3116     end.
     3117   end procedure.
     3118   procedure partslib-calc-cost :
     3119     define output parameter p-fact-qnty      as decimal   no-undo .
     3120     define output parameter p-vat-pc         as decimal   no-undo .
     3121     define output parameter p-slt-pc         as decimal   no-undo .
     3122     define output parameter p-sum-base       as decimal   no-undo .
     3123     define output parameter p-sum-rubl       as decimal   no-undo .
     3124     define output parameter p-vat-base       as decimal   no-undo .
     3125     define output parameter p-vat-rubl       as decimal   no-undo .
     3126     define output parameter p-slt-base       as decimal   no-undo .
     3127     define output parameter p-slt-rubl       as decimal   no-undo .
     3128     define output parameter p-road-tax-base  as decimal   no-undo .
     3129     define output parameter p-road-tax-rubl  as decimal   no-undo .
     3130     define output parameter p-transport-base as decimal   no-undo .
     3131     define output parameter p-transport-rubl as decimal   no-undo .
     3132     define output parameter p-other-base     as decimal   no-undo .
     3133     define output parameter p-other-rubl     as decimal   no-undo .
     3134     define output parameter p-excise-base    as decimal   no-undo .
     3135     define output parameter p-excise-rubl    as decimal   no-undo .
     3136     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     3137     do
     3138     on error undo, return error return-value
     3139     :
     3140       define buffer buf_temp-parts for temp-parts .
     3141       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3142       define buffer   in-vatp-parts    for ub.parts   .
     3143       define buffer   in-vatp-doc      for ub.trn-doc .
     3144       define buffer   in-vatp-goods    for ub.goods   .
     3145       define buffer   in-vatp-sysconf  for ub.sysconf .
     3146       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3147       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3148       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3149       define variable varinvprb                  as   character              no-undo.
     3150       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3151       define variable cli-base-rate              as   decimal                no-undo.
     3152       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3153       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3154       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3155       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3156       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3157       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3158       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3159       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3160       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3161       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3162       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3163       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3164       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3165       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3166       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3167       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3168       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3169       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3170       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3171       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3172       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3173       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3174       define variable varinvatp-envd             as   character              no-undo.
     3175       define variable varinvatp-type             as   character              no-undo.
     3176       for each buf_temp-parts
     3177       on error undo, return error
     3178       :
     3179   assign
     3180     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     3181     price-base-with-tax-loc = buf_temp-parts.price-base
     3182   .
     3183   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3185     (output varinvprb
     3186     )  .
     3187     if buf_temp-parts.out-code = 'free-zone':U     or
     3188        buf_temp-parts.out-code = 'out-zone':U   or
     3189        buf_temp-parts.doc-type = 'акт':U then do:
     3190       assign
     3191         in-vatp-have-vat-slt = yes.
     3192     end.
     3193     else do:
     3194       find first in-vatp_doc-attr no-lock
     3195         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     3196           and in-vatp_doc-attr.attr-code = 'envd':U
     3197         no-error .
     3198       if not available in-vatp_doc-attr then do:
     3199         assign
     3200           in-vatp-have-vat-slt = yes.
     3201       end.
     3202       else do:
     3203            in-vatp-have-vat-slt = no.
     3204       end.
     3205     end.
     3206     assign
     3207      price-cli-with-tax-loc = buf_temp-parts.price-cli
     3208      cli-base-rate          = buf_temp-parts.cli-base-rate.
     3209     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     3210              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     3211     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     3212             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     3213             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     3214             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     3215             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     3216             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     3217             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3218       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3219     assign
     3220       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     3221     assign
     3222       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3223       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3224       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3225       transport-cli-loc  = 0
     3226       other-cli-loc      = 0
     3227     .
     3228   ASSIGN
     3229             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3230       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3231   .
     3232         assign
     3233           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     3234           p-vat-pc         = p-vat-pc         + vat-pc-loc
     3235           p-slt-pc         = p-slt-pc         + slt-pc-loc
     3236           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     3237           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     3238           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     3239           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     3240           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     3241           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     3242           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     3243           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     3244           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     3245           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     3246           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     3247           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     3248           p-excise-base    = p-excise-base    + 0
     3249           p-excise-rubl    = p-excise-rubl    + 0
     3250         .
     3251       end.
     3252       if p-fact-qnty      = ?
     3253       or p-sum-base       = ?
     3254       or p-sum-rubl       = ?
     3255       or p-vat-base       = ?
     3256       or p-vat-rubl       = ?
     3257       or p-slt-base       = ?
     3258       or p-slt-rubl       = ?
     3259       or p-road-tax-base  = ?
     3260       or p-road-tax-rubl  = ?
     3261       or p-transport-base = ?
     3262       or p-transport-rubl = ?
     3263       or p-other-base     = ?
     3264       or p-other-rubl     = ?
     3265       or p-excise-base    = ?
     3266       or p-excise-rubl    = ?
     3267       then do:
     3268         message
     3269           vss-workfile vss-revision vss-description skip
     3270           vss-include-info21 skip
     3271           "Программа in-vatp.i вернула неопределенные значения" skip
     3272           "p-fact-qnty"      p-fact-qnty      skip
     3273           "p-sum-base"       p-sum-base       skip
     3274           "p-sum-rubl"       p-sum-rubl       skip
     3275           "p-vat-base"       p-vat-base       skip
     3276           "p-vat-rubl"       p-vat-rubl       skip
     3277           "p-slt-base"       p-slt-base       skip
     3278           "p-slt-rubl"       p-slt-rubl       skip
     3279           "p-road-tax-base"  p-road-tax-base  skip
     3280           "p-road-tax-rubl"  p-road-tax-rubl  skip
     3281           "p-transport-base" p-transport-base skip
     3282           "p-transport-rubl" p-transport-rubl skip
     3283           "p-other-base"     p-other-base     skip
     3284           "p-other-rubl"     p-other-rubl     skip
     3285           "p-excise-base"    p-excise-base    skip
     3286           "p-excise-rubl"    p-excise-rubl    skip
     3287           view-as alert-box error .
     3288         undo, return error .
     3289       end.
     3290     end.
     3291   end procedure.
