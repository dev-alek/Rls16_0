     5294                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     5295                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     5296                                          and utd-marking-lines-attr.mark      eq imark
     5297                                          and utd-marking-lines-attr.attr-code eq iattrcode
     5298      no-lock no-error.
