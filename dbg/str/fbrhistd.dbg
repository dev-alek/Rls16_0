        1   define output parameter p-date  as date         no-undo.
        2   define output parameter p-level as integer      no-undo.
        3   define output parameter p-ok    as logical      no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Ввод даты и уровня детализации для очистки истории".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   procedure proc-alt-shift-f2:
      305     if not ibs.th.gbl.gbl-var:rcode
      306   then
      307     run gbl\inidebug.p .
      308   end.
      309   procedure proc-alt-shift-f3:
      310     run gbl/prvssinf.p
      311       ( input this-procedure
      312       ) .
      313   end.
      314   define variable v-inform-launched as logical no-undo initial false .
      315   procedure proc-alt-shift-f4:
      316     define variable v-action as character no-undo .
      317     if v-inform-launched = false then do:
      318       assign
      319         v-inform-launched = true
      320       .
      321       run gbl/d-inform.w
      322         (  input self
      323         ,  input this-procedure
      324         , output v-action
      325         ) no-error .
      326       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      327       assign
      328         v-inform-launched = false
      329       .
      330     end.
      331   end.
      332   procedure proc-alt-f1:
      333     run gbl/corrhelp.p
      334       (input this-procedure
      335       ) .
      336   end .
      337   on alt-shift-f2 anywhere do:
      338     run proc-alt-shift-f2.
      339   end.
      340   on alt-shift-f3 anywhere do:
      341     run proc-alt-shift-f3 in this-procedure .
      342   end.
      343   on alt-shift-f4 anywhere do:
      344     run proc-alt-shift-f4 in this-procedure.
      345   end.
      346   on alt-f1 anywhere do:
      347     run proc-alt-f1 in this-procedure .
      348   end.
      349   DEFINE BUTTON b-cancel AUTO-END-KEY
      350        LABEL "&Отмена"
      351        SIZE 10 BY 1
      352        BGCOLOR 8 .
      353   DEFINE BUTTON b-exit AUTO-GO
      354        LABEL "В&вод"
      355        SIZE 10 BY 1
      356        BGCOLOR 8 .
      357   DEFINE BUTTON b-help
      358        LABEL "Помо&щь"
      359        SIZE 10 BY 1
      360        BGCOLOR 8 .
      361   DEFINE VARIABLE fi-date AS DATE FORMAT "99.99.9999":U
      362        LABEL "Дата"
      363        VIEW-AS FILL-IN
      364        SIZE 14 BY 1 NO-UNDO.
      365   DEFINE VARIABLE fi-level AS INTEGER FORMAT ">>9":U INITIAL 0
      366        LABEL "Детализация"
      367        VIEW-AS FILL-IN
      368        SIZE 4.5 BY 1 NO-UNDO.
      369   DEFINE FRAME Dialog-Frame
      370        b-exit AT ROW 1.25 COL 1.5
      371        b-cancel AT ROW 1.25 COL 11.5
      372        b-help AT ROW 1.25 COL 29.5
      373        fi-date AT ROW 3 COL 12 COLON-ALIGNED
      374        fi-level AT ROW 4.25 COL 21.5 COLON-ALIGNED
      375        SPACE(13.24) SKIP(1.03)
      376       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      377            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      378            TITLE "Очистка истории производства"
      379            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      380   ASSIGN
      381          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      382          FRAME Dialog-Frame:HIDDEN           = TRUE.
      383   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      384   DO:
      385     APPLY "END-ERROR":U TO SELF.
      386   END.
      387   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      388   DO:
      389       assign
      390           fi-date
      391           fi-level
      392       .
      393       assign
      394           p-ok    = yes
      395           p-date  = fi-date
      396           p-level = fi-level
      397       .
      398   END.
      399   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      400   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      401   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   on help of frame Dialog-Frame
      403   do:
      404     run gbl/app_help.p
      405       (input this-procedure :file-name
      406       ,input ''
      407       ,input ?
      408       ) no-error.
      409     if error-status :error then do:
      410       message
      411         "Ошибка при вызове помощи"
      412         error-status :get-message(1)
      413         view-as alert-box .
      414     end.
      415   end.
      416   run minbtn-set in this-procedure .
      417   on choose of b-help in frame Dialog-Frame
      418   do:
      419     apply "help":u to frame Dialog-Frame .
      420   end.
      421   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   procedure minbtn-set :
      423       do
      424           on error undo, return error return-value
      425           :
      426           define variable ii              as integer       no-undo .
      427           define variable fh              as widget-handle no-undo .
      428           define variable hh              as widget-handle no-undo .
      429           define variable v-h             as handle        extent 4 no-undo .
      430           define variable v-name-button   as character     no-undo .
      431           define variable v-help-old-x    as decimal       no-undo .
      432           define variable v-help-old-y    as decimal       no-undo .
      433           define variable v-help-old-size as decimal       no-undo .
      434           define variable v-frame-width   as decimal       no-undo .
      435           define variable jj              as integer       no-undo .
      436           do
      437               on error undo, return error
      438               :
      439               assign
      440                   v-frame-width = frame Dialog-Frame:width - 0.3
      441                   fh            = frame Dialog-Frame:first-child
      442                   hh            = fh:first-child
      443                   ii            = 1
      444                   .
      445               do while valid-handle(hh):
      446                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      447                   do:
      448                       case lc(hh:name) :
      449                           when "b-help" then
      450                               do:
      451                                   hh:load-image-up("cmp/b-help.bmp":u) .
      452                                   hh:load-image-down("cmp/b-help.bmp":u) .
      453                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      454                                   hh:TOOLTIP = "Помощь" .
      455                                   v-help-old-x = hh:column .
      456                                   v-help-old-y = hh:row    .
      457                                   v-help-old-size = hh:width .
      458                                   hh:width-chars = 2.5 .
      459                               end.
      460                           when "b-print" then
      461                               do:
      462                                   hh:load-image("cmp/b-print.bmp":u) .
      463                                   hh:TOOLTIP = "Печать" .
      464                                   v-h[ii] = hh:handle .
      465                                   ii = ii + 1 .
      466                                   hh:width-chars = 3 .
      467                               end.
      468                           when "b-history" or
      469                           when "b-hist" then
      470                               do:
      471                                   hh:load-image("cmp/b-hist.bmp":u) .
      472                                   hh:TOOLTIP = "История" .
      473                                   v-h[ii] = hh:handle .
      474                                   ii = ii + 1 .
      475                                   hh:width-chars = 3 .
      476                               end.
      477                           when "b-sch" then
      478                               do:
      479                                   hh:load-image("cmp/b-sch.bmp":u) .
      480                                   hh:TOOLTIP = "Установка Фильтра" .
      481                                   v-h[ii] = hh:handle .
      482                                   ii = ii + 1 .
      483                                   hh:width-chars = 3 .
      484                               end.
      485                           when "b-hist-user" then
      486                               do:
      487                                   hh:load-image("cmp/b-hist.bmp":u) .
      488                                   hh:TOOLTIP = "История пользователя" .
      489                                   ii = ii + 1 .
      490                               end.
      491                       end case.
      492                   end.
      493                   hh = hh:next-sibling.
      494               end.
      495               b-help:column = v-frame-width - b-help:width-chars.
      496               jj = 0.
      497               repeat ii = 4 to 1 by -1 :
      498                   if valid-handle (v-h[ii] ) then
      499                   do:
      500                       jj  = jj + 1 .
      501                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      502                       v-h[ii]:row    = v-help-old-y .
      503                   end.
      504               end.
      505           end.
      506       end.
      507   end procedure.
      508   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   on ' ' of fi-date in frame Dialog-Frame
      510   do:
      511     if (can-query (self, "sensitive")
      512        and
      513        self :sensitive = true
      514        )
      515     or (can-query (self, "read-only")
      516        and
      517        self :read-only = false
      518        )
      519     then do:
      520       assign
      521         self :screen-value = ?
      522       .
      523     end.
      524     return no-apply.
      525   end.
      526   on delete-character of fi-date in frame Dialog-Frame
      527   do:
      528     if (can-query (self, "sensitive")
      529        and
      530        self :sensitive = true
      531        )
      532     or (can-query (self, "read-only")
      533        and
      534        self :read-only = false
      535        )
      536     then do:
      537       assign
      538         self :screen-value = ?
      539       .
      540     end.
      541     return no-apply.
      542   end.
      543   on ctrl-d of fi-date in frame Dialog-Frame
      544   do:
      545     define variable v-curr-sv-date as date no-undo .
      546     if (can-query (self, "sensitive")
      547        and
      548        self :sensitive = true
      549        )
      550     or (can-query (self, "read-only")
      551        and
      552        self :read-only = false
      553        )
      554     then do:
      555       if self :handle <> focus :handle
      556       then do:
      557         apply "entry":u to self .
      558       end.
      559       run gbl/getcurdt.p
      560         (output v-curr-sv-date
      561         ) .
      562       assign
      563         self :screen-value = string(v-curr-sv-date) .
      564       .
      565     end.
      566     return no-apply.
      567   end.
      568   on ctrl-b of fi-date in frame Dialog-Frame
      569   do:
      570     if (can-query (self, "sensitive")
      571        and
      572        self :sensitive = true
      573        )
      574     or (can-query (self, "read-only")
      575        and
      576        self :read-only = false
      577        )
      578     then do:
      579       if self :handle <> focus :handle
      580       then do:
      581         apply "entry":u to self .
      582       end.
      583       define variable v-curr-sv-date as date no-undo .
      584       define variable v-new-sv-date  as date no-undo .
      585       assign
      586         v-curr-sv-date = date(self :screen-value) no-error
      587       .
      588       if v-curr-sv-date = ?
      589       then do:
      590         run gbl/getcurdt.p
      591           (output v-curr-sv-date
      592           ) .
      593       end.
      594       if v-curr-sv-date <> ?
      595       then do:
      596         assign
      597           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      598         .
      599         assign
      600           self :screen-value = string(v-new-sv-date) .
      601         .
      602       end.
      603     end.
      604     return no-apply .
      605   end.
      606   on ctrl-e of fi-date in frame Dialog-Frame
      607   do:
      608     if (can-query (self, "sensitive")
      609        and
      610        self :sensitive = true
      611        )
      612     or (can-query (self, "read-only")
      613        and
      614        self :read-only = false
      615        )
      616     then do:
      617       if self :handle <> focus :handle
      618       then do:
      619         apply "entry":u to self .
      620       end.
      621       define variable v-curr-sv-date as date no-undo .
      622       define variable v-new-sv-date  as date no-undo .
      623       assign
      624         v-curr-sv-date = date(self :screen-value) no-error
      625       .
      626       if v-curr-sv-date = ?
      627       then do:
      628         run gbl/getcurdt.p
      629           (output v-curr-sv-date
      630           ) .
      631       end.
      632       if v-curr-sv-date <> ?
      633       then do:
      634         run gbl/lastdate.p
      635           (input  v-curr-sv-date
      636           ,output v-new-sv-date
      637           ).
      638         assign
      639           self :screen-value = string(v-new-sv-date) .
      640         .
      641       end.
      642     end.
      643     return no-apply .
      644   end.
      645   on ctrl-f of fi-date in frame Dialog-Frame
      646   do:
      647     if (can-query (self, "sensitive")
      648        and
      649        self :sensitive = true
      650        )
      651     or (can-query (self, "read-only")
      652        and
      653        self :read-only = false
      654        )
      655     then do:
      656       if self :handle <> focus :handle
      657       then do:
      658         apply "entry":u to self .
      659       end.
      660       define variable v-ok            as logical   no-undo .
      661       define variable v-curr-sv-date  as date      no-undo .
      662       define variable v-description   as character no-undo .
      663       assign
      664         v-curr-sv-date = date(self :screen-value) no-error
      665       .
      666       if v-curr-sv-date = ?
      667       then do:
      668         run gbl/getcurdt.p
      669           (output v-curr-sv-date
      670           ) .
      671       end.
      672       if v-curr-sv-date <> ?
      673       then do:
      674         run gbl/d-inpday.w
      675           (input ?
      676           ,input "Выбор даты"
      677           ,input v-description
      678           ,input ""
      679           ,input-output v-curr-sv-date
      680           ,output v-ok
      681           ).
      682         if v-ok = true
      683         then do:
      684           assign
      685             self :screen-value = string(v-curr-sv-date) .
      686           .
      687         end.
      688       end.
      689     end.
      690     return no-apply .
      691   end.
      692     define MENU m-ed-date4
      693       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      694       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      695       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      696       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      697       .
      698     if fi-date :POPUP-MENU in frame Dialog-Frame = ?
      699     then do:
      700       ASSIGN
      701         fi-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      702         fi-date :MENU-MOUSE in frame Dialog-Frame = 3
      703       .
      704     end.
      705     define variable v-label-handle4 as handle no-undo .
      706     assign
      707       v-label-handle4 = fi-date :side-label-handle in frame Dialog-Frame
      708     .
      709     if valid-handle (v-label-handle4)
      710     then do:
      711       if v-label-handle4 :tooltip = ""
      712       or v-label-handle4 :tooltip = ?
      713       then do:
      714         assign
      715           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      716         .
      717       end.
      718     end.
      719     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      720       apply "ctrl-b":U to fi-date in frame Dialog-Frame .
      721     END.
      722     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      723       apply "ctrl-d":U to fi-date in frame Dialog-Frame .
      724     END.
      725     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      726       apply "ctrl-e":U to fi-date in frame Dialog-Frame .
      727     END.
      728     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      729       apply "ctrl-f":U to fi-date in frame Dialog-Frame .
      730     END.
      731   MAIN-BLOCK:
      732   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      733      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      734       run init-fields in this-procedure.
      735       RUN enable_UI.
      736       apply "entry" to fi-date.
      737       WAIT-FOR GO OF FRAME Dialog-Frame.
      738   END.
      739   RUN disable_UI.
      740   PROCEDURE disable_UI :
      741     HIDE FRAME Dialog-Frame.
      742   END PROCEDURE.
      743   PROCEDURE enable_UI :
      744     DISPLAY fi-date fi-level
      745         WITH FRAME Dialog-Frame.
      746     ENABLE b-exit b-cancel b-help fi-date fi-level
      747         WITH FRAME Dialog-Frame.
      748     VIEW FRAME Dialog-Frame.
      749   END PROCEDURE.
      750   PROCEDURE init-fields :
      751       define variable v-today as date      no-undo.
      752       define variable v-time  as integer   no-undo.
      753   do
      754   on error undo, return error
      755   :
      756       run cur-time in this-procedure (
      757             output v-today
      758           , output v-time
      759       ).
      760       assign
      761           fi-date  = v-today
      762           fi-level = 10
      763           p-ok     = no
      764       .
      765   end.
      766   END PROCEDURE.
