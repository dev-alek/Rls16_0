    12946   .
    12947   run xml-cd-write-header in this-procedure (
    12948         input v-xml-file-name
    12949       , input v-xml-file-name-path
    12950       , input 'data'
    12951       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    12952       , input v-obj-list
    12953       , input (
    12954                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    12955                   then (if for-cash-desk.autonomy = integer('0':U)
    12956                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    12957                         else ("КМ"   )
    12958                         )
    12959                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    12960                   )
    12961               )
    12962       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    12963   ).
    12964   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    12965   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    12966     end.
    12967     when 'MAGIA-XML':U then do:
    12968   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12969   run xml-cd-filename in this-procedure (
