     3661   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3662   define variable v-is-closed-shift-journal as integer no-undo .
     3663   assign
     3664   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3665                               +
     3666                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3667                               +
     3668                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3669   .
     3670   return v-is-closed-shift-journal.
     3671   END FUNCTION.
     3672   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3673   define variable v-is-first-journal as logical no-undo .
     3674   assign
     3675   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3676                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3677                     or (p-journal-num =  integer(entry(1, '17':U)))
     3678                     or (p-journal-num = integer(entry(1, '16':U)))
     3679   .
     3680   return v-is-first-journal.
     3681   END FUNCTION.
     3682   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3683   define variable v-is-petrol-journal as logical no-undo .
     3684   assign
     3685   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3686   return v-is-petrol-journal.
     3687   END FUNCTION.
     3688   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3689   define variable v-max-record-num as integer no-undo .
     3690   assign
     3691   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3692                       then 1489
     3693                       else 2340).
     3694   return v-max-record-num.
     3695   END FUNCTION.
     3696   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3697   define variable v-max-record-num as integer no-undo .
     3698   assign
     3699   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3700                       then 1489 * num-entries('30,31,32,33':U)
     3701                       else 2340 * num-entries('17':U)).
     3702   return v-max-record-num.
     3703   END FUNCTION.
     3704   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3705                                           ,input p-rec-no as integer):
     3706   define variable v-num-recs as integer no-undo .
     3707   if tekka-is-petrol-journal (p-journal-num) then do:
     3708     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3709       assign
     3710       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3711       .
     3712     end.
     3713     else do:
     3714       assign
     3715       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3716       .
     3717     end.
     3718   end.
     3719   else do:
     3720     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3721       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3722         assign
     3723         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3724         .
     3725       end.
     3726       else do:
     3727         assign
     3728         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3729         .
     3730       end.
     3731     end.
     3732     else do:
     3733       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3734         assign
     3735         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3736         .
     3737       end.
     3738       else do:
     3739         assign
     3740         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3741         .
     3742       end.
     3743     end.
     3744   end.
     3745   return v-num-recs.
     3746   END FUNCTION.
     3747   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3748                                              ,input p-is-petrol as logical
     3749                                              ,input p-is-current as logical
     3750                                              ,output p-rec-no as decimal
     3751                                              ):
     3752   define variable v-obj-num0 as integer no-undo .
     3753   define variable v-obj-num as integer no-undo .
     3754   define variable v-obj-num2 as integer no-undo .
     3755   define variable p-num-recs2 as integer no-undo .
     3756   define variable p-rec-no2 as integer no-undo .
     3757   if p-is-petrol then do:
     3758     assign
     3759     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3760     .
     3761     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3762     then
     3763     assign
     3764     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3765     p-rec-no = p-num-recs modulo 1489
     3766     .
     3767     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3768     then
     3769     assign
     3770     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3771     p-rec-no = p-num-recs modulo 1489
     3772     .
     3773   end.
     3774   else do:
     3775     assign
     3776     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3777     p-num-recs = trunc(p-num-recs, 0)
     3778     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3779     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3780     .
     3781     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3782     then
     3783     assign
     3784     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3785     p-rec-no = p-num-recs modulo 2340
     3786     .
     3787     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3788     then
     3789     assign
     3790     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3791     p-rec-no = p-num-recs modulo 2340
     3792     .
     3793     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3794     then
     3795     assign
     3796     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3797     p-rec-no2 = p-num-recs2 modulo 2978
     3798     .
     3799     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3800     then
     3801     assign
     3802     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3803     p-rec-no2 = p-num-recs2 modulo 2978
     3804     .
     3805     assign
     3806     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3807     .
     3808   end.
     3809   if v-obj-num = 0 then v-obj-num = 100.
     3810   return v-obj-num.
     3811   END FUNCTION.
     3812   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3813   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3814   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3815      if p-is-ptrl then
     3816      return integer(entry(1, '26,27,28,29':U)).
     3817      if not p-is-ptrl then
     3818      return integer(entry(1, '16':U)).
     3819   end.
     3820   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3821   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3822   return 0.
     3823   END FUNCTION.
     3824   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3825   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3826   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3827     if p-is-ptrl then
     3828     return integer(entry(1, '26,27,28,29':U)).
     3829     if not p-is-ptrl then
     3830     return integer(entry(1, '16':U)).
     3831   end.
     3832   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3833   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3834   return 0.
     3835   END FUNCTION.
     3836   PROCEDURE maria-put:
     3837   define parameter buffer buf_cash-desk for ub.cash-desk.
     3838   define input parameter p-out    as character no-undo .
     3839   define input parameter p-fname as character no-undo .
     3840   define input parameter p-by-record as logical no-undo .
     3841   define input parameter p-shift-fields as integer no-undo .
     3842   define input parameter p-binary as logical no-undo .
     3843   define input parameter p-obj-num as integer no-undo .
     3844   define input parameter p-max-records as integer no-undo .
     3845   define input parameter p-plu as integer no-undo .
     3846   define input parameter p-value as character no-undo .
     3847   define variable v-file-name as character no-undo .
     3848   define variable v-create as logical no-undo .
     3849   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3850   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3851   output stream IBMSTREAM
     3852   to value(v-file-name) append .
     3853   Put  stream IBMSTREAM unformatted
     3854   p-plu
     3855   chr(3)
     3856   p-value
     3857   skip.
     3858   output stream IBMSTREAM
     3859   close.
     3860   if not p-by-record then do:
     3861     find first buf_temp-tekka-tsk where
     3862               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3863     if not available buf_temp-tekka-tsk then do:
     3864       v-create = yes.
     3865     end.
     3866   end.
     3867   else do:
     3868     find first buf_temp-tekka-tsk where
     3869               buf_temp-tekka-tsk.filename  = v-file-name
     3870           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3871     if not available buf_temp-tekka-tsk
     3872     then do:
     3873       find first buf_temp-tekka-tsk where
     3874                 buf_temp-tekka-tsk.filename  = v-file-name
     3875             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3876       if not available buf_temp-tekka-tsk
     3877       then do:
     3878         v-create = yes.
     3879       end.
     3880     end.
     3881   end.
     3882   if v-create then do:
     3883     create buf_temp-tekka-tsk.
     3884     assign
     3885     buf_temp-tekka-tsk.filename = v-file-name
     3886     buf_temp-tekka-tsk.range    = p-plu
     3887     buf_temp-tekka-tsk.obj-num = p-obj-num
     3888     buf_temp-tekka-tsk.obj-name = '':U
     3889     buf_temp-tekka-tsk.num-records = 0
     3890     buf_temp-tekka-tsk.max-records = p-max-records
     3891     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3892     buf_temp-tekka-tsk.task-num = p-fname
     3893     buf_temp-tekka-tsk.by-record = p-by-record
     3894     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3895     buf_temp-tekka-tsk.binary = p-binary
     3896     buf_temp-tekka-tsk.send-get = 'send'
     3897     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3898     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3899     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3900     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3901                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3902                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3903                                 then 'local'
     3904                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3905     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3906     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3907     buf_temp-tekka-tsk.waiting-sek = 30
     3908     buf_temp-tekka-tsk.min-plu     = p-plu
     3909     buf_temp-tekka-tsk.max-plu     = p-plu
     3910     .
     3911   end.
     3912   assign
     3913   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3914   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3915   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3916   .
     3917   END PROCEDURE.
     3918   PROCEDURE maria-get:
     3919   define parameter buffer buf_cash-desk for ub.cash-desk.
     3920   define input parameter p-out    as character no-undo .
     3921   define input parameter p-fname as character no-undo .
     3922   define input parameter p-by-record as logical no-undo .
     3923   define input parameter p-obj-num as integer no-undo .
     3924   define input parameter p-num-fields as integer no-undo .
     3925   define input parameter p-max-records as integer no-undo .
     3926   define input parameter p-min-plu as integer no-undo .
     3927   define input parameter p-max-plu as integer no-undo .
     3928   define input parameter p-other as character no-undo .
     3929   define input parameter p-order-num as integer no-undo .
     3930   define variable v-file-name as character no-undo .
     3931   define variable v-secondary-obj-num as character no-undo .
     3932   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3933   if p-by-record then do:
     3934     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3935   end.
     3936   else do:
     3937     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3938   end.
     3939   find first buf_temp-tekka-tsk where
     3940             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3941   if not available buf_temp-tekka-tsk then do:
     3942     create buf_temp-tekka-tsk.
     3943     assign
     3944     buf_temp-tekka-tsk.filename = v-file-name
     3945     buf_temp-tekka-tsk.obj-num = p-obj-num
     3946     buf_temp-tekka-tsk.obj-name = '':U
     3947     buf_temp-tekka-tsk.max-records = p-max-records
     3948     buf_temp-tekka-tsk.num-fields = p-num-fields
     3949     buf_temp-tekka-tsk.task-num = p-fname
     3950     buf_temp-tekka-tsk.by-record = p-by-record
     3951     buf_temp-tekka-tsk.send-get = 'get'
     3952     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3953     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3954     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3955     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3956                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3957                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3958                                   then 'local'
     3959                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3960     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3961     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3962     buf_temp-tekka-tsk.waiting-sek = 30
     3963     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3964     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3965     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3966                                       and p-max-plu <> ?
     3967                                       then p-max-plu - p-min-plu + 1
     3968                                       else 0)
     3969     buf_temp-tekka-tsk.other-info = p-other
     3970     buf_temp-tekka-tsk.order-num = p-order-num
     3971     .
     3972     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3973       assign
     3974       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3975       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3976       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3977       no-error
     3978       .
     3979       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3980     end.
     3981   end.
     3982   END PROCEDURE.
     3983   PROCEDURE maria-task:
     3984   define parameter buffer buf_cash-desk for ub.cash-desk.
     3985   define input parameter p-fname as character no-undo .
     3986   define input parameter p-obj-num-list as character no-undo .
     3987   define input parameter p-parameters as character no-undo .
     3988   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3989   find first buf_temp-tekka-tsk where
     3990             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3991   if not available buf_temp-tekka-tsk then do:
     3992     create buf_temp-tekka-tsk.
     3993     assign
     3994     buf_temp-tekka-tsk.filename = ''
     3995     buf_temp-tekka-tsk.range = 1
     3996     buf_temp-tekka-tsk.obj-num = 0
     3997     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3998     buf_temp-tekka-tsk.task-num = p-fname
     3999     buf_temp-tekka-tsk.by-record = no
     4000     buf_temp-tekka-tsk.send-get = 'task'
     4001     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     4002     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     4003     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     4004     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     4005                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     4006                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     4007                                   then 'local'
     4008                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     4009     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     4010     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     4011     buf_temp-tekka-tsk.waiting-sek = 30
     4012     buf_temp-tekka-tsk.other-info = p-parameters
     4013     buf_temp-tekka-tsk.order-num = 0
     4014     .
     4015   end.
     4016   END PROCEDURE.
     4017   procedure tekkatsk-verify-schema :
     4018   define input parameter p-obj-list as character no-undo .
     4019   define input parameter p-dir-path as character no-undo .
     4020   define variable v-obj-num as integer no-undo .
     4021   define variable v-obj-name as character no-undo .
     4022   define variable v-num-records as integer no-undo .
     4023   define variable v-size_ as integer no-undo .
     4024   define variable v-value as character no-undo .
     4025   define variable ii as integer no-undo .
     4026   define variable jj as integer no-undo .
     4027   define variable ii-ibs as integer no-undo .
     4028   define variable ii-tekka as integer no-undo .
     4029   define variable v-result as character no-undo .
     4030   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     4031   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     4032     do
     4033     on error undo, return error
     4034     :
     4035        for each buf_temp-tekka-schema:
     4036          delete buf_temp-tekka-schema.
     4037        end.
     4038        input from value('tekkasch.d').
     4039        repeat :
     4040          create buf_temp-tekka-schema.
     4041          import buf_temp-tekka-schema.
     4042          assign
     4043          buf_temp-tekka-schema.host = 'IBS'
     4044          ii = ii + 1.
     4045          .
     4046        end.
     4047        input close.
     4048        ii-ibs = ii.
     4049         _ii:
     4050         do ii = 1 to 256:
     4051           if p-obj-list = "ALL"
     4052           or lookup(string(ii), p-obj-list) > 0 then do:
     4053             assign
     4054             v-obj-num = 0
     4055             v-obj-name = ''
     4056             v-num-records = 0
     4057             v-size_ = 0
     4058             .
     4059             run alienini-getkey in this-procedure (
     4060                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4061                                                     ,input ('obj' + string(ii, '999'))
     4062                                                     ,input 'oname'
     4063                                                     ,output v-value) no-error .
     4064             if v-value = ? then next _ii.
     4065             assign
     4066             v-obj-num = ii
     4067             v-obj-name = v-value
     4068             .
     4069             run alienini-getkey in this-procedure (
     4070                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4071                                                     ,input ('obj' + string(ii, '999'))
     4072                                                     ,input 'size'
     4073                                                     ,output v-value) no-error .
     4074             assign
     4075             v-num-records = integer(v-value) no-error  .
     4076             if error-status:error
     4077             or v-num-records = 0 then next _ii.
     4078             run alienini-getkey in this-procedure (
     4079                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4080                                                     ,input 'obj' + string(ii, '999')
     4081                                                     ,input 'f000'
     4082                                                     ,output v-value) no-error .
     4083             assign
     4084             v-size_ = integer(v-value) no-error  .
     4085             if error-status:error
     4086             or v-size_ = 0 then next _ii.
     4087             _jj:
     4088             do jj = 1 to 256:
     4089               run alienini-getkey in this-procedure (
     4090                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4091                                                       ,input 'obj' + string(ii, '999')
     4092                                                       ,input 'f' + string(jj, '999')
     4093                                                       ,output v-value) no-error .
     4094               if v-value = ? then next _ii.
     4095               create buf_temp-tekka-schema.
     4096               assign
     4097               buf_temp-tekka-schema.host = 'tekka'
     4098               buf_temp-tekka-schema.obj-num = v-obj-num
     4099               buf_temp-tekka-schema.obj-name = v-obj-name
     4100               buf_temp-tekka-schema.num-records = v-num-records
     4101               buf_temp-tekka-schema.size_ = v-size_
     4102               buf_temp-tekka-schema.field-num = jj
     4103               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     4104               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     4105                                                  then entry(2, entry(2, v-value, '#'), ':')
     4106                                                  else '':U)
     4107               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     4108               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     4109               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     4110                                                           , 'C,I,I,I,D,D,D,D,D':U)
     4111               no-error
     4112               .
     4113               if error-status:error then do:
     4114                 delete buf_temp-tekka-schema.
     4115                 next _jj.
     4116               end.
     4117               run alienini-getkey in this-procedure (
     4118                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4119                                                       ,input 'obj' + string(ii, '999') + 'name'
     4120                                                       ,input 'n' + string(jj, '999')
     4121                                                       ,output v-value) no-error .
     4122               if v-value <> ? then
     4123               buf_temp-tekka-schema.field-name = v-value.
     4124             end.
     4125           end.
     4126         end.
     4127         ii-tekka = ii - 1.
     4128        if p-obj-list <> 'ALL' then do:
     4129         if ii-tekka <> ii-ibs then do:
     4130           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     4131                                   , ii-ibs
     4132                                   , ii-tekka).
     4133         end.
     4134        end.
     4135        for each buf_temp-tekka-schema where
     4136               buf_temp-tekka-schema.host = 'tekka':
     4137          find first buf2_temp-tekka-schema where
     4138                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     4139                AND buf2_temp-tekka-schema.host = 'ibs'
     4140                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     4141          if not available buf2_temp-tekka-schema then do:
     4142           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     4143                                   , buf_temp-tekka-schema.field-num
     4144                                   , buf_temp-tekka-schema.obj-num).
     4145          end.
     4146          buffer-compare buf_temp-tekka-schema
     4147          to buf2_temp-tekka-schema
     4148          save result in v-result.
     4149          if v-result <> '':U then do:
     4150           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     4151                                   , buf_temp-tekka-schema.field-num
     4152                                   , buf_temp-tekka-schema.obj-num).
     4153          end.
     4154        end.
     4155     end.
     4156   end procedure.
     4157   FUNCTION set-Sx returns character (input p-string as character):
     4158   return p-string.
     4159   END FUNCTION.
     4160   FUNCTION get-Sx returns character (input p-string  as character):
     4161   return p-string.
     4162   END FUNCTION.
     4163   FUNCTION set-B returns character (input p-string  as character):
     4164   return chr(integer(p-string)).
     4165   END FUNCTION.
     4166   FUNCTION get-B returns character (input p-string  as character):
     4167   return string(asc(p-string)).
     4168   END FUNCTION.
     4169   FUNCTION set-BF returns character (input p-string  as character):
     4170   define variable v-dopi as integer no-undo .
     4171   define variable ii as integer no-undo .
     4172   do ii = 1 to 8:
     4173     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     4174   end.
     4175   return chr(v-dopi).
     4176   END FUNCTION.
     4177   FUNCTION get-BF returns character (input p-string  as character):
     4178   define variable v-dopi as integer no-undo .
     4179   define variable v-dops as character no-undo .
     4180   define variable ii as integer no-undo .
     4181   v-dopi = asc(p-string).
     4182   do ii = 8 to 1 BY -1:
     4183     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     4184   end.
     4185   return v-dops.
     4186   END FUNCTION.
     4187   FUNCTION set-BN returns character (input p-string  as character
     4188                                     ,input p-bin-group as character):
     4189   define variable v-dopi as integer no-undo .
     4190   define variable ii as integer no-undo .
     4191   define variable jj as integer no-undo .
     4192   define variable v-grp-nums as integer no-undo .
     4193   define variable v-dopi2 as integer no-undo .
     4194   v-grp-nums = num-entries(p-bin-group).
     4195   do jj = 0 to v-grp-nums - 1:
     4196     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     4197     do ii = 1 to 8:
     4198       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     4199     end.
     4200   end.
     4201   return chr(v-dopi).
     4202   END FUNCTION.
     4203   FUNCTION get-BN returns character (input p-string  as character
     4204                                     ,input p-bin-group as character):
     4205   define variable v-dopi as integer no-undo .
     4206   define variable v-dops as character no-undo .
     4207   define variable v-grp-nums as integer no-undo .
     4208   define variable ii as integer no-undo .
     4209   define variable jj as integer no-undo .
     4210   v-dopi = asc(p-string).
     4211   v-grp-nums = num-entries(p-bin-group).
     4212   do jj = 1 to v-grp-nums:
     4213   do ii = 8 to 1 BY -1:
     4214     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     4215   end.
     4216   end.
     4217   return v-dops.
     4218   END FUNCTION.
     4219   procedure fill-temp-cd :
     4220   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     4221   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     4222   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     4223   define input parameter p-clear-table as logical no-undo .
     4224   define buffer buf_temp-cd for temp-cd.
     4225   define buffer buf_cash-desk for ub.cash-desk.
     4226     do
     4227     on error undo, return error
     4228     :
     4229        if p-clear-table  then do:
     4230          for each buf_temp-cd:
     4231            delete buf_temp-cd.
     4232          end.
     4233        end.
     4234        for each buf_cash-desk no-lock where
     4235               buf_cash-desk.db-num = p-db-num
     4236           AND buf_cash-desk.obj-code = p-obj-code
     4237           and buf_cash-desk.cash-on  = yes
     4238        BREAK by buf_cash-desk.pos-type:
     4239          if first-of(buf_cash-desk.pos-type) then do:
     4240            create buf_temp-cd.
     4241            buffer-copy buf_cash-desk to buf_temp-cd.
     4242          end.
     4243        end.
     4244     end.
     4245   end procedure.
     4246   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4247   FUNCTION name-2cdf returns character
     4248                      (  input p-name-2cd as character
     4249                       , input p-mode as logical
     4250                       , input p-cod-pcod as logical
     4251                       , input p-b-code  as integer
     4252                       , input p-gds-code as integer
     4253                       , input p-artic   as character
     4254                       , input p-engl-name  as character
     4255                       , input p-in-code as character
     4256                       , input p-part-code as character
     4257                       , input p-obj-type as character
     4258                       , input p-obj-code as integer
     4259                       , input p-alpha1 as character
     4260                       , output p-gtd as character
     4261                       ) :
     4262   define variable v-name-2cd as character no-undo .
     4263   define variable v-dop-alt-name as character no-undo.
     4264   define variable v-type as character no-undo.
     4265   define buffer buf_parts for ub.parts.
     4266   define buffer buf_code for ub.code.
     4267   if not p-mode and p-name-2cd = "PLU":U then do:
     4268     return "PLU кассы":U.
     4269   end.
     4270   if not p-mode then do:
     4271     if p-name-2cd <> "GTD":U
     4272     and  p-name-2cd <> "alpha1|gtd":U
     4273     then do:
     4274     assign
     4275     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4276   end.
     4277   end.
     4278   if p-part-code = "":U or p-cod-pcod = no then do:
     4279     run gdsoattr-value in this-procedure (
     4280       'dt-seasons':U,
     4281       p-gds-code,
     4282       p-obj-type,
     4283       p-obj-code,
     4284       output v-dop-alt-name,
     4285       output v-type
     4286     ) no-error.
     4287     if v-dop-alt-name <> "" then do:
     4288       find first buf_code where
     4289                  buf_code.parent = "DTSeasons"
     4290              and buf_code.code   = v-dop-alt-name
     4291            no-lock no-error.
     4292       if available buf_code then
     4293         assign
     4294           p-engl-name = ""
     4295           v-dop-alt-name =  buf_code.misc1
     4296         .
     4297     end.
     4298     else do:
     4299       run gdsoattr-value in this-procedure
     4300                           ( input  'dop-alt-name-o':U
     4301                            ,input  p-gds-code
     4302                            ,input  p-obj-type
     4303                            ,input  p-obj-code
     4304                            ,output v-dop-alt-name
     4305                            ,output v-type
     4306                           ) no-error .
     4307     end.
     4308     CASE p-name-2cd:
     4309       when "name" then do:
     4310         if p-mode then return p-engl-name + v-dop-alt-name.
     4311         return "Англ. название".
     4312       end.
     4313       when "code":U then do:
     4314         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4315         return "Лок. код товара"  .
     4316       end.
     4317       when "GTD":U
     4318       or
     4319       when "name-GTD":U
     4320       or
     4321       when "code-GTD":U
     4322       or
     4323       when "alpha1|gtd":U
     4324       or
     4325       when "name-alpha1|gtd":U
     4326       or
     4327       when "code-alpha1|gtd":U
     4328       then do:
     4329         if p-mode then do:
     4330           run gdcstcod_cst-code  in this-procedure (
     4331                                                       input  p-obj-type
     4332                                                       ,input  p-obj-code
     4333                                                       ,input  p-gds-code
     4334                                                       ,input  p-in-code
     4335                                                       ,input  p-part-code
     4336                                                       ,output p-gtd
     4337                                                       ) no-error .
     4338         end.
     4339         if p-name-2cd = "name-gtd":U then do:
     4340           if p-mode then return p-engl-name  + v-dop-alt-name.
     4341           return "Англ. название".
     4342         end.
     4343         if p-name-2cd = "name-alpha1|gtd":U then do:
     4344           if p-mode then return p-engl-name  + v-dop-alt-name.
     4345           return "Англ. название".
     4346         end.
     4347         if p-name-2cd = "code-GTD":U then do:
     4348           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4349           return "Лок. код товара"  .
     4350         end.
     4351         if p-name-2cd = "code-alpha1|gtd":U then do:
     4352           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4353           return "Лок. код товара"  .
     4354         end.
     4355         if p-mode then do:
     4356           if p-name-2cd = "GTD" then  return p-gtd.
     4357           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4358         end.
     4359         if p-name-2cd = "GTD" then  return "Код ГТД".
     4360         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4361       end.
     4362     END CASE.
     4363   end.
     4364   else do:
     4365     if p-name-2cd = "name-gtd":U
     4366     or p-name-2cd = "code-GTD":U
     4367     or p-name-2cd = "name-alpha1|GTD":U
     4368     or p-name-2cd = "code-alpha1|GTD":U
     4369     or p-name-2cd = "alpha1|GTD":U
     4370     then do:
     4371       if p-mode then do:
     4372         run gdcstcod_cst-code  in this-procedure (
     4373                                                      input  p-obj-type
     4374                                                     ,input  p-obj-code
     4375                                                     ,input  p-gds-code
     4376                                                     ,input  p-in-code
     4377                                                     ,input  p-part-code
     4378                                                     ,output p-gtd
     4379                                                     ) no-error .
     4380       end.
     4381       else do:
     4382         if p-name-2cd = "gtd":U then
     4383         p-gtd = "Код ГТД".
     4384         if p-name-2cd = "alpha1|Gtd":U then
     4385         p-gtd = "Страна|Код ГТД".
     4386       end.
     4387     end.
     4388     if p-mode then  return p-part-code.
     4389     return "Код партии".
     4390   end.
     4391   END FUNCTION.
     4392   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4393                                            ,input p-nam-2str as logical
     4394                                            ,input p-nam-artc as logical
     4395                                            ,input p-unit-cli-type as character
     4396                                            ,input p-unit-base as character
     4397                                            ,input p-unit-cli as character
     4398                                            ,input p-cli-base-rate as decimal
     4399                                            ,input p-artic as character
     4400                                            ,input p-f-name as character
     4401                                            ,input p-gds-name as character
     4402                                            ,input p-gds-name1 as character
     4403                                            ,output p-second-name as character):
     4404   define variable v-length as integer no-undo .
     4405   define variable nam-2str-shift as integer no-undo .
     4406   define variable chk_name as character no-undo .
     4407   assign
     4408   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4409   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4410   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4411               then 5
     4412               else v-length)
     4413   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4414   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4415   .
     4416   if p-nam-artc then do:
     4417     assign
     4418     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4419       .
     4420   end.
     4421   else  do:
     4422     assign
     4423     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4424     .
     4425   end.
     4426   if p-unit-base <> p-unit-cli then do:
     4427     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4428     assign
     4429     chk_name = string(substr(chk_name
     4430                               ,1
     4431                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4432                       "*":U +
     4433                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4434   end.
     4435   else do:
     4436     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4437   end.
     4438   if p-nam-2str then do:
     4439     assign
     4440     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4441     chk_name = substr(chk_name, 1, v-length)
     4442     .
     4443   end.
     4444   else do:
     4445     assign
     4446     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4447     p-second-name =   (chr(34) +
     4448                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4449                       + chr(34) )
     4450     .
     4451   end.
     4452   return chk_name.
     4453   end function.
