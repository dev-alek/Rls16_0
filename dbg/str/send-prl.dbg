    11554     end.
    11555   run bgelib-tag-close in this-procedure ( input 2, input "Item").
    11556     if v-attr-egais = 1 then do:
    11557           run bgelib-tag-open in this-procedure ( input 2, input "ItemMarkCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    11558                                             ,"ADD":U, OS2-time,cash-gds.b-code)).
    11559           find first buf_alc-type-gds where buf_alc-type-gds.gds-code = cash-gds.gds-code no-lock no-error.
    11560           find first buf_alc-type where buf_alc-type.alc-type-inner-code = buf_alc-type-gds.alc-type-inner-code no-lock no-error.
    11561           if available buf_alc-type then do:
