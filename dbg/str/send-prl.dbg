     1888   end function.
     1889   procedure disgdsru-write :
     1890     do
     1891     on error undo, return error
     1892     :
     1893       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1894       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1895       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1896       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1897       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1898       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1899       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1900       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1901       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1902       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1903       define buffer buf_dis-rule for ub.dis-rule.
     1904       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1905       define variable v-label          as character no-undo .
     1906       define variable v-discnt-role as character no-undo .
     1907       run discfgru-check in this-procedure (
     1908                                             input 'dis-gds-rule':U
     1909                                            ,input p-templ-rl-root
     1910                                            ,input p-time-templ-rl-root
     1911                                            ,input p-pos-type
     1912                                            ,output v-discnt-role
     1913                                             ) no-error .
     1914       if error-status :error then do:
     1915         undo, return error return-value .
     1916       end.
     1917       if p-discnt-role = ? then do:
     1918         p-discnt-role = v-discnt-role.
     1919       end.
     1920       if p-discnt-role <> v-discnt-role then do:
     1921         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1922                                 ,p-gds-code
     1923                                 ,p-obj-type
     1924                                 ,p-obj-code
     1925                                 ,p-pos-type
     1926                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1927                                 ,chr(10)
     1928                                 ,p-templ-rl-root
     1929                                 ,p-rule-num).
     1930       end.
     1931       if p-pos-type = ? then do:
     1932   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1933   define variable v-param-type23 as character no-undo .
     1934   define variable v-value-date23 as date no-undo .
     1935   define variable v-value-decimal23 as decimal no-undo .
     1936   define variable v-value-integer23 as INTEGER no-undo .
