    14910     CASE vdr-26:
    14911       when 1 then do:
    14912         assign
    14913         vc-obj-code = ub.shop.obj-code
    14914         vc-obj-type = 'маг':U
    14915         vc-host-code = ub.shop.host-code
    14916         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    14917         .
    14918       end.
    14919       when 2 then do:
    14920         assign
    14921         vc-obj-code = 0
    14922         vc-obj-type = '':U
    14923         vc-host-code = ub.shop.host-code
    14924         vc-region    = substitute("Фирма &1&2", vc-host-code)
    14925         .
    14926       end.
    14927       when 3 then do:
    14928         assign
    14929         vc-obj-code = 0
    14930         vc-obj-type = '':U
    14931         vc-host-code = 0
    14932         vc-region    = "Глобально"
    14933         .
    14934       end.
    14935     END CASE.
    14936     find ub.dis-rule no-lock where
    14937                   ub.dis-rule.upper-rule-num = 26
    14938               and ub.dis-rule.host-code = vc-host-code
    14939               AND ub.dis-rule.obj-type = vc-obj-type
    14940               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    14941     if available ub.dis-rule then LEAVE _do26.
    14942   end.
    14943   if available ub.dis-rule then do:
    14944     for each buf_dis-rule no-lock where
    14945             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    14946       assign
    14947       ncrgmdsc = ncrgmdsc + (if ncrgmdsc = "":U then "":U else ";") +
    14948                   string(buf_dis-rule.dis-kat) + "=":U +
    14949                   string(buf_dis-rule.discnt-value).
    14950     end.
    14951   end.
