     6545   procedure mpl-autoprice :
     6546   define input  parameter p-only-b-code as logical   no-undo .
     6547   define input  parameter p-cli-type    as character no-undo .
     6548   define input  parameter p-cli-code    as integer   no-undo .
     6549   define input  parameter p-main-b-code as integer   no-undo .
     6550   define input  parameter p-b-code      as integer   no-undo .
