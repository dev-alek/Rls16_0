     5018   end procedure.
     5019   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5020   PROCEDURE cd-mrkt_plu-marketer :
     5021   define input parameter p-silence as logical no-undo .
     5022   define parameter buffer buf_cash-desk for ub.cash-desk.
     5023   define input parameter p-id as character no-undo .
     5024   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     5025   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     5026   define input parameter p-loc-ean as logical no-undo .
     5027   define input parameter p-is-petrolium as logical no-undo .
     5028   define input parameter p-extra as character no-undo .
     5029   define variable v-tot-gds as integer no-undo .
     5030   define variable v-max-gds as integer no-undo .
     5031   define variable v-petrol-start as integer no-undo .
     5032   define variable v-petrol-range as integer no-undo .
     5033   DEFINE VARIABLE v-today as date no-undo .
     5034   DEFINE VARIABLE v-time as integer no-undo .
     5035   define variable v-plu-type as character no-undo .
     5036   define variable v-int as integer no-undo .
     5037   define buffer  buf_cd-plu for ub.cd-plu.
     5038   define buffer  loc_cd-plu for ub.cd-plu.
     5039   define variable  ii as integer no-undo.
     5040   define variable v-mes as character no-undo .
     5041   _main:
     5042   DO ON ERROR undo, leave on stop undo, leave:
     5043     if buf_cash-desk.pos-type <> 'MARIA':U
     5044     or buf_cash-desk.cash-num <> 0 then do:
     5045       assign
     5046       v-mes =
     5047       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5048                 , buf_cash-desk.pos-type).
     5049       if not p-silence then
     5050       message
     5051       v-mes
     5052       view-as alert-box error .
     5053       return error v-mes.
     5054     end.
     5055     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     5056                                     ,input 'MARIA_operative':U
     5057                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5058                                           and p-is-petrolium
     5059                                           then 'tot-petrol':U
     5060                                           else 'tot-gds':U)
     5061                                     , output v-mes).
     5062     if v-tot-gds = ? then undo _main, return error v-mes.
     5063     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     5064                                     ,input 'MARIA_general':U
     5065                                     ,input 'max-gds':U
     5066                                     ,output v-mes).
     5067     if v-max-gds = ? then undo _main, return error v-mes.
     5068     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     5069                                          ,input 'petrolium-range':U
     5070                                          ,input 'petrolium-range':U
     5071                                          ,output v-mes).
     5072     if v-petrol-range = ? then undo _main, return error v-mes.
     5073     if buf_cash-desk.pos-type = 'MARIA':U then do:
     5074       assign
     5075       v-petrol-start = 1
     5076       v-max-gds = (if p-is-petrolium
     5077                    then v-petrol-range
     5078                    else v-max-gds)
     5079       v-plu-type = (if p-is-petrolium
     5080                  then 'топ':U
     5081                  else '':U)
     5082       .
     5083       if p-is-petrolium then do:
     5084         if p-id = '':U then do:
     5085           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     5086                               "Невозможно привязать к кассе типа &3"
     5087                               , p-b-str
     5088                               , chr(10)
     5089                               , 'MARIA':U).
     5090           if not p-silence then
     5091           message
     5092           v-mes
     5093           view-as alert-box error .
     5094           return error v-mes.
     5095         end.
     5096         assign
     5097         v-int = integer(p-id)
     5098         no-error
     5099         .
     5100         if error-status:error
     5101         or v-int > v-petrol-range then do:
     5102           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     5103                               "в диапазоны номеров резервуаров для кассы типа &4"
     5104                               , p-id
     5105                               , p-b-str
     5106                               , chr(10)
     5107                               , 'MARIA':U).
     5108           if not p-silence then
     5109           message
     5110           v-mes
     5111           view-as alert-box error .
     5112           return error v-mes.
     5113         end.
     5114       end.
     5115     end.
     5116     if buf_cash-desk.pos-type = 'MARIA':U
     5117     and p-is-petrolium then do:
     5118       find first loc_cd-plu where
     5119                loc_cd-plu.obj-type = 'маг':U
     5120            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     5121            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     5122            and loc_cd-plu.plu-type = 'топ':U
     5123      no-error .
     5124      if available loc_cd-plu then do:
     5125        if loc_cd-plu.b-code = p-b-code
     5126        and loc_cd-plu.b-str = p-b-str then do:
     5127           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     5128                               , p-id
     5129                               , p-b-str
     5130                               , chr(10)
     5131                               ).
     5132           if not p-silence then
     5133           message
     5134           v-mes
     5135           view-as alert-box WARNING .
     5136           return v-mes.
     5137        end.
     5138        else do:
     5139           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     5140                               "нельзя его привязать к топливу &2&3"
     5141                               , p-id
     5142                               , loc_cd-plu.b-str
     5143                               , chr(10)
     5144                               , p-b-str).
     5145           if not p-silence then
     5146           message
     5147           v-mes
     5148           view-as alert-box error .
     5149           return error v-mes.
     5150        end.
     5151      end.
     5152      ii = v-int.
     5153     end.
     5154     else do:
     5155       DO ii = (if p-is-petrolium
     5156               then v-petrol-start
     5157               else (if buf_cash-desk.pos-type = 'MARIA':U
     5158                    then 1
     5159                    else (if v-petrol-start = 1
     5160                           then (v-petrol-range + 1)
     5161                           else 1)
     5162                   )
     5163               )
     5164         to v-max-gds :
     5165         if not can-find (loc_cd-plu where
     5166                         loc_cd-plu.obj-type = 'маг':U
     5167                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     5168                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     5169                      and loc_cd-plu.plu-type = v-plu-type
     5170                      and loc_cd-plu.plu-code = ii
     5171                       )
     5172         then LEAVE .
     5173       END .
     5174     end.
     5175     if ii > v-max-gds then do:
     5176         if not p-silence then
     5177         message
     5178         substitute("Превышено максимально допустимое количество &5 &1" +
     5179                   "для касс &2 &3&4"
     5180                   , chr(10)
     5181                   , v-max-gds
     5182                   , 'маг':U
     5183                   , buf_cash-desk.obj-code
     5184                   , (if p-is-petrolium then "топлив" else "товаров")
     5185                   )
     5186         view-as alert-box ERROR .
     5187         undo, return error "max-gds":U.
     5188     end.
     5189     DO ii = (if p-is-petrolium
     5190              then v-petrol-start
     5191              else (if v-petrol-start = 1
     5192                    then (v-petrol-range + 1)
     5193                    else 1)
     5194              )
     5195        to v-max-gds :
     5196       if not can-find (loc_cd-plu where
     5197                         loc_cd-plu.obj-type = 'маг':U
     5198                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     5199                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     5200                      and loc_cd-plu.plu-type = v-plu-type
     5201                      and loc_cd-plu.plu-code = ii
     5202                      )
     5203       then LEAVE .
     5204     END .
     5205     if ii > v-max-gds then do:
     5206         if not p-silence then
     5207         message
     5208         substitute("Превышено максимально допустимое количество &5 &1" +
     5209                   "для касс &2 &3&4"
     5210                   , chr(10)
     5211                   , v-max-gds
     5212                   , 'маг':U
     5213                   , buf_cash-desk.obj-code
     5214                   , (if p-is-petrolium then "топлив" else "товаров")
     5215                   )
     5216         view-as alert-box ERROR .
     5217         undo, return error "max-gds":U.
     5218     end.
     5219     run cur-time in this-procedure ( output v-today, output v-time).
     5220     create buf_cd-plu.
     5221     assign
     5222     buf_cd-plu.b-code = p-b-code
     5223     buf_cd-plu.b-str = p-b-str
     5224     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5225                                         then buf_cash-desk.addr-path
     5226                                         else "U":U)
     5227     buf_cd-plu.to-send = yes
     5228     buf_cd-plu.charkey_one = "":U
     5229     buf_cd-plu.to-del = no
     5230     buf_cd-plu.plu-code = ii
     5231     buf_cd-plu.obj-type = 'маг':U
     5232     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     5233     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     5234     buf_cd-plu.plu-type = v-plu-type
     5235     buf_cd-plu.logkey_one = p-loc-ean
     5236     buf_cd-plu.key#_one = integer(p-extra)
     5237     .
     5238     run cd-attr-write  in this-procedure (
     5239                                           input   buf_cash-desk.db-num
     5240                                           ,input  buf_cash-desk.obj-code
     5241                                           ,input  buf_cash-desk.pos-type
     5242                                           ,input  buf_cash-desk.cash-num
     5243                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     5244                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5245                                                 and p-is-petrolium
     5246                                                 then 'tot-petrol':U
     5247                                                 else 'tot-gds':U)
     5248                                           ,input ''
     5249                                           ,input ?
     5250                                           ,input 0.0
     5251                                           ,input  (v-tot-gds + 1)
     5252                                           ,input no
     5253                                          ) no-error .
     5254     if error-status:error then do:
     5255       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     5256                          ,buf_cash-desk.cash-num
     5257                          , 'маг':U
     5258                          ,buf_cash-desk.obj-code
     5259                          , chr(10)
     5260                          , error-status:get-message(1)
     5261                          , return-value
     5262                          ).
     5263       if not p-silence then
     5264       message
     5265       v-mes
     5266       view-as alert-box error .
     5267       undo _main, return error v-mes.
     5268     end.
     5269     run cd-attr-write  in this-procedure (
     5270                                           input   buf_cash-desk.db-num
     5271                                           ,input  buf_cash-desk.obj-code
     5272                                           ,input  buf_cash-desk.pos-type
     5273                                           ,input  buf_cash-desk.cash-num
     5274                                           ,input  'MARIA_operative':U
     5275                                           ,input  'to-send':U
     5276                                           ,input ''
     5277                                           ,input ?
     5278                                           ,input 0.0
     5279                                           ,input 0
     5280                                           ,input yes
     5281                                          ) no-error .
     5282     if error-status:error then do:
     5283       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5284                          ,buf_cash-desk.cash-num
     5285                          , 'маг':U
     5286                          ,buf_cash-desk.obj-code
     5287                          , chr(10)
     5288                          , error-status:get-message(1)
     5289                          , return-value
     5290                          ).
     5291       if not p-silence then
     5292       message
     5293       v-mes
     5294       view-as alert-box error .
     5295       undo _main, return error v-mes.
     5296     end.
     5297     return "":U.
     5298   end.
     5299   END PROCEDURE.
     5300   procedure cd-mrkt_update-marketer :
     5301   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5302   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5303   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5304   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5305   define input parameter p-is-petrolium as logical no-undo .
     5306   define variable v-to-send as logical no-undo .
     5307   define variable v-tot-gds as integer no-undo .
     5308   define variable v-max-plu as integer no-undo .
     5309   define buffer buf_cd-plu for ub.cd-plu.
     5310   define variable v-plu-type as character no-undo .
     5311     do
     5312     on error undo, return error
     5313     :
     5314       v-to-send = no.
     5315       v-tot-gds = 0.
     5316       assign
     5317       v-plu-type = (if p-is-petrolium
     5318                     then  'топ':U
     5319                     else '':U
     5320                 )
     5321       .
     5322       FOR EACH buf_cd-plu WHERE
     5323              buf_cd-plu.obj-type = 'маг':U
     5324         and  buf_cd-plu.obj-code = p-obj-code
     5325         and  buf_cd-plu.pos-type = p-pos-type
     5326         and  buf_cd-plu.plu-type = v-plu-type
     5327             :
     5328         if  buf_cd-plu.to-del
     5329         or  buf_cd-plu.to-send then do:
     5330           assign
     5331           v-to-send = yes.
     5332         end.
     5333         assign
     5334         v-tot-gds = v-tot-gds + 1.
     5335       end.
     5336       run cd-attr-write  in this-procedure (
     5337                                               input   p-db-num
     5338                                               ,input  p-obj-code
     5339                                               ,input  p-pos-type
     5340                                               ,input  p-cash-num
     5341                                               ,input  'MARIA_operative':U
     5342                                               ,input  (if p-pos-type = 'MARIA':U
     5343                                                        and p-is-petrolium
     5344                                                        then  'tot-petrol':U
     5345                                                        else 'tot-gds':U)
     5346                                               ,input ''
     5347                                               ,input ?
     5348                                               ,input 0.0
     5349                                               ,input v-tot-gds
     5350                                               ,input no
     5351                                                                                           ) no-error .
     5352       if error-status:error then do:
     5353           UNDO, RETURN ERROR RETURN-VALUE.
     5354       END.
     5355       run cd-attr-write  in this-procedure (
     5356                                               input   p-db-num
     5357                                               ,input  p-obj-code
     5358                                               ,input  p-pos-type
     5359                                               ,input  p-cash-num
     5360                                               ,input  'MARIA_operative':U
     5361                                               ,input  (if p-pos-type = 'MARIA':U
     5362                                                        and p-is-petrolium
     5363                                                        then  'petrol-to-send':U
     5364                                                        else 'to-send':U)
     5365                                               ,input ''
     5366                                               ,input ?
     5367                                               ,input 0.0
     5368                                               ,input 0
     5369                                               ,input v-to-send
     5370                                               ) no-error .
     5371       if error-status:error then do:
     5372           UNDO, RETURN ERROR RETURN-VALUE.
     5373       END.
     5374       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5375                buf_cd-plu.obj-type = 'маг':U
     5376            and buf_cd-plu.obj-code = p-obj-code
     5377            and buf_cd-plu.pos-type = p-pos-type
     5378            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5379       if available buf_cd-plu then do:
     5380         if v-max-plu < buf_cd-plu.plu-code
     5381         then
     5382         v-max-plu = buf_cd-plu.plu-code .
     5383       end.
     5384       else do:
     5385         v-max-plu = 0.
     5386       end.
     5387       run cd-attr-write  in this-procedure (
     5388                                             input   p-db-num
     5389                                             ,input  p-obj-code
     5390                                             ,input  p-pos-type
     5391                                             ,input  p-cash-num
     5392                                             ,input  'MARIA_operative':U
     5393                                             ,input  (if p-pos-type = 'MARIA':U
     5394                                                     and p-is-petrolium
     5395                                                     then 'max-petrol-plu':U
     5396                                                     else 'max-plu':U)
     5397                                               ,input ''
     5398                                               ,input ?
     5399                                               ,input 0.0
     5400                                               ,input v-max-plu
     5401                                               ,input no
     5402                                             ) no-error .
     5403       if error-status:error then do:
     5404           UNDO, RETURN ERROR RETURN-VALUE.
     5405       END.
     5406     end.
     5407   end procedure.
     5408   PROCEDURE cd-mrkt_clu-marketer :
     5409   define input parameter p-silence as logical no-undo .
     5410   define parameter buffer buf_cash-desk for ub.cash-desk.
     5411   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5412   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5413   define variable v-tot-cli as integer no-undo .
     5414   define variable v-max-cli as integer no-undo .
     5415   DEFINE VARIABLE v-today as date no-undo .
     5416   DEFINE VARIABLE v-time as integer no-undo .
     5417   define buffer  buf_cd-clu for ub.cd-clu.
     5418   define buffer  loc_cd-clu for ub.cd-clu.
     5419   define variable  ii as integer no-undo.
     5420   define variable v-mes as character no-undo .
     5421   _main:
     5422   DO ON ERROR undo, leave on stop undo, leave:
     5423     if buf_cash-desk.pos-type <> 'MARIA':U
     5424     or buf_cash-desk.cash-num <> 0 then do:
     5425       assign
     5426       v-mes =
     5427       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5428                 , buf_cash-desk.pos-type).
     5429       if not p-silence then
     5430       message
     5431       v-mes
     5432       view-as alert-box error .
     5433       return error v-mes.
     5434     end.
     5435     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5436                                     ,input 'MARIA_operative':U
     5437                                     ,input 'tot-cli':U
     5438                                     ,output v-mes).
     5439     if v-tot-cli = ? then undo _main, return error v-mes.
     5440     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5441                                     ,input 'MARIA_general':U
     5442                                     ,input 'max-cli':U
     5443                                     , output v-mes).
     5444     if v-max-cli = ? then undo _main, return error v-mes.
     5445     DO ii = 1
     5446        to v-max-cli :
     5447       if not can-find (loc_cd-clu where
     5448                       loc_cd-clu.obj-type = 'маг':U
     5449                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5450                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5451                   and loc_cd-clu.clu-type = '':U
     5452                   and loc_cd-clu.clu-code = ii
     5453                      )
     5454       then LEAVE .
     5455     END .
     5456     if ii > v-max-cli then do:
     5457         if not p-silence then
     5458         message
     5459         substitute("Превышено максимально допустимое количество клиентов &1" +
     5460                   "для касс &2 &3&4"
     5461                   , chr(10)
     5462                   , v-max-cli
     5463                   , 'маг':U
     5464                   , buf_cash-desk.obj-code
     5465                   )
     5466         view-as alert-box ERROR .
     5467         undo, return error "max-cli":U.
     5468     end.
     5469     run cur-time in this-procedure ( output v-today, output v-time).
     5470     create buf_cd-clu.
     5471     assign
     5472     buf_cd-clu.cli-code = p-obj-code
     5473     buf_cd-clu.cli-type = p-obj-type
     5474     buf_cd-clu.obj-type = 'маг':U
     5475     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5476     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5477     buf_cd-clu.clu-type = '':U
     5478     buf_cd-clu.to-send = yes
     5479     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5480                               then buf_cash-desk.addr-path
     5481                               else "U":U)
     5482     buf_cd-clu.clu-code = ii
     5483     .
     5484     run cd-attr-write  in this-procedure (
     5485                                           input   buf_cash-desk.db-num
     5486                                           ,input  buf_cash-desk.obj-code
     5487                                           ,input  buf_cash-desk.pos-type
     5488                                           ,input  buf_cash-desk.cash-num
     5489                                           ,input  'MARIA_operative':U
     5490                                           ,input  'tot-cli':U
     5491                                           ,input ''
     5492                                           ,input ?
     5493                                           ,input 0.0
     5494                                           ,input  (v-tot-cli + 1)
     5495                                           ,input no
     5496                                          ) no-error .
     5497     if error-status:error then do:
     5498       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5499                          ,buf_cash-desk.cash-num
     5500                          , 'маг':U
     5501                          ,buf_cash-desk.obj-code
     5502                          , chr(10)
     5503                          , error-status:get-message(1)
     5504                          , return-value
     5505                          ).
     5506       if not p-silence then
     5507       message
     5508       v-mes
     5509       view-as alert-box error .
     5510       undo _main, return error v-mes.
     5511     end.
     5512     run cd-attr-write  in this-procedure (
     5513                                           input   buf_cash-desk.db-num
     5514                                           ,input  buf_cash-desk.obj-code
     5515                                           ,input  buf_cash-desk.pos-type
     5516                                           ,input  buf_cash-desk.cash-num
     5517                                           ,input  'MARIA_operative':U
     5518                                           ,input  'cli-to-send':U
     5519                                           ,input ''
     5520                                           ,input ?
     5521                                           ,input 0.0
     5522                                           ,input 0
     5523                                           ,input yes
     5524                                          ) no-error .
     5525     if error-status:error then do:
     5526       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5527                          ,buf_cash-desk.cash-num
     5528                          , 'маг':U
     5529                          ,buf_cash-desk.obj-code
     5530                          , chr(10)
     5531                          , error-status:get-message(1)
     5532                          , return-value
     5533                          ).
     5534       if not p-silence then
     5535       message
     5536       v-mes
     5537       view-as alert-box error .
     5538       undo _main, return error v-mes.
     5539     end.
     5540     return "":U.
     5541   end.
     5542   END PROCEDURE.
     5543   procedure cd-mrkt_update-marketer-cli :
     5544   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5545   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5546   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5547   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5548   define variable v-cli-to-send as logical no-undo .
     5549   define variable v-tot-cli as integer no-undo .
     5550   define variable v-max-clu as integer no-undo .
     5551   define buffer buf_cd-clu for ub.cd-clu.
     5552   do
     5553   on error undo, return error return-value
     5554   :
     5555     v-cli-to-send = no.
     5556     v-tot-cli = 0.
     5557     FOR EACH buf_cd-clu WHERE
     5558           buf_cd-clu.obj-type = 'маг':U
     5559       and buf_cd-clu.obj-code =  p-obj-code
     5560       and buf_cd-clu.pos-type =  p-pos-type
     5561       and buf_cd-clu.clu-type =  '':U
     5562       :
     5563       if buf_cd-clu.to-del = yes then do:
     5564         assign
     5565         v-cli-to-send = yes.
     5566       end.
     5567       assign
     5568       v-tot-cli = v-tot-cli + 1.
     5569     end.
     5570     run cd-attr-write  in this-procedure (
     5571                                             input   p-db-num
     5572                                             ,input  p-obj-code
     5573                                             ,input  p-pos-type
     5574                                             ,input  p-cash-num
     5575                                             ,input  'MARIA_operative':U
     5576                                             ,input  'tot-cli':U
     5577                                             ,input ''
     5578                                             ,input ?
     5579                                             ,input 0.0
     5580                                             ,input v-tot-cli
     5581                                             ,input no
     5582                                             ) no-error .
     5583     if error-status:error then do:
     5584         UNDO, RETURN ERROR RETURN-VALUE.
     5585     END.
     5586     run cd-attr-write  in this-procedure (
     5587                                             input   p-db-num
     5588                                             ,input  p-obj-code
     5589                                             ,input  p-pos-type
     5590                                             ,input  p-cash-num
     5591                                             ,input  'MARIA_operative':U
     5592                                             ,input  'cli-to-send':U
     5593                                             ,input ''
     5594                                             ,input ?
     5595                                             ,input 0.0
     5596                                             ,input 0
     5597                                             ,input v-cli-to-send
     5598                                             ) no-error .
     5599     if error-status:error then do:
     5600         UNDO, RETURN ERROR RETURN-VALUE.
     5601     END.
     5602     FIND LAST buf_cd-clu WHERE
     5603             buf_cd-clu.obj-type = 'маг':U
     5604         and buf_cd-clu.obj-code = p-obj-code
     5605         and buf_cd-clu.pos-type = p-pos-type
     5606         and buf_cd-clu.clu-type = '':U
     5607         NO-LOCK use-index pi no-error .
     5608     if available buf_cd-clu then do:
     5609       if v-max-clu < buf_cd-clu.clu-code
     5610       then
     5611       v-max-clu = buf_cd-clu.clu-code.
     5612     end.
     5613     else do:
     5614       v-max-clu = 0.
     5615     end.
     5616     run cd-attr-write  in this-procedure (
     5617                                           input   p-db-num
     5618                                           ,input  p-obj-code
     5619                                           ,input  p-pos-type
     5620                                           ,input  p-cash-num
     5621                                           ,input  'MARIA_operative':U
     5622                                           ,input  'max-clu':U
     5623                                           ,input ''
     5624                                           ,input ?
     5625                                           ,input 0.0
     5626                                           ,input v-max-clu
     5627                                           ,input no
     5628                                           ) no-error .
     5629     if error-status:error then do:
     5630         UNDO, RETURN ERROR RETURN-VALUE.
     5631     END.
     5632   end.
     5633   end procedure.
