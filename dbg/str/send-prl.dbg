    11589          end.
    11590          else do:
    11591          find first buf_prod-bc-attr no-lock where buf_prod-bc-attr.b-code = buf_cash-gds.b-code
    11592                                 and buf_prod-bc-attr.b-str = buf_cash-gds.b-str
    11593                                 and buf_prod-bc-attr.attr-code = 'mark':U
    11594                                 no-error .
    11595          if available (buf_prod-bc-attr) and buf_prod-bc-attr.attr-value = "yes" then
    11596            v-IBCType = 1 .
    11597        end.
    11598      end.
    11599     if v-mark and buf_cash-gds.b-str = "" then v-IBCType = 1 .
