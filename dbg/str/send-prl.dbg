     4970     on error undo, return error return-value
     4971     :
     4972           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-manual-edit in g#attr-lib
     4973         (input  p-ucode
     4974         ,input  p-code
     4975         ,output p-section-num
     4976         ) no-error .
     4977       if error-status :error
     4978       then do:
     4979         undo, return error return-value .
     4980       end.
