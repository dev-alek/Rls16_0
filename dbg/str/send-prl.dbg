     6671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6672     (input  v-host-code
     6673     ,input  to-day
     6674     ,output v-base-rate0
     6675     ,output v-base-scale0
     6676     )  .
     6677     v-cli-oborot-ALL  = 0 .
     6678     for each buf_turnover-buyer-main no-lock  where
     6679              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6680              buf_turnover-buyer-main.cli-code = p-cli-code
     6681              :
     6682              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6683     end.
     6684   for each buf_price-all no-lock where
     6685            buf_price-all.obj-type = p-obj-type and
     6686            buf_price-all.obj-code = p-obj-code and
     6687            buf_price-all.gds-code = buf_goods.gds-code and
     6688            buf_price-all.status_  = 'акт':U  and
     6689          ( p-only-b-code = false   or
     6690          ( buf_price-all.b-code = p-main-b-code or
     6691            buf_price-all.b-code = p-b-code))    and
     6692           ( p-only-b-code = true  or
     6693             buf_price-all.b-code = p-b-code)
     6694             and
     6695             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6696           ( buf_price-all.fact-order-sys-to = ? or
     6697             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6698           :
     6699            v-interv   = "" .
     6700            v-grp-name = "" .
     6701            v-pay-name = "" .
     6702            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6703            if buf_price-all.bgr-id > 0 then do:
     6704               find first buf_buyer-group no-lock where
     6705                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6706                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6707               if available buf_buyer-group then do:
     6708                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6709                  find first buf_buyer-in-buyer-group no-lock where
     6710                             buf_buyer-in-buyer-group.stts         = 0 and
     6711                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6712                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6713                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6714                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6715                             no-error .
     6716                             if not available buf_buyer-in-buyer-group then do:
     6717                                v-grp-name = "".
     6718                                next.
     6719                             end.
     6720                             v-grp-name = buf_buyer-group.name .
     6721                  end.
     6722               end.
     6723               else do:
     6724                    v-grp-name = "".
     6725                    next.
     6726               end.
     6727            end.
     6728            if buf_price-all.tog-id > 0 then do:
     6729               find first buf_turnover-group no-lock where
     6730                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6731                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6732               if available buf_turnover-group then do:
     6733                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6734                     v-cli-oborot = v-cli-oborot-all  .
     6735                     find first buf1_tnv-in-turnover-group no-lock where
     6736                                buf1_tnv-in-turnover-group.stts       =  0     and
     6737                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6738                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6739                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6740                     find first buf2_tnv-in-turnover-group no-lock where
     6741                                buf2_tnv-in-turnover-group.stts       =  0     and
     6742                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6743                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6744                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6745                     if not (available buf1_tnv-in-turnover-group and
     6746                             available buf2_tnv-in-turnover-group ) then do:
     6747                             v-grp-name = "".
     6748                             next .
     6749                     end.
     6750                     v-grp-name = buf_turnover-group.name.
     6751                  end.
     6752               end.
     6753               else do:
     6754                    v-grp-name = "".
     6755                    next.
     6756               end.
     6757            end.
     6758            if buf_price-all.plt-fix-cource-crc-base = true then
     6759               assign
     6760                 v-base-rate  = buf_price-all.pdf-base-rate
     6761                 v-base-scale = buf_price-all.pdf-base-scale
     6762               .
     6763               else
     6764               assign
     6765                 v-base-rate  = v-base-rate0
     6766                 v-base-scale = v-base-scale0
     6767               .
     6768            if buf_price-all.plt-fix-cource-crc-doc = true then
     6769               assign
     6770                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6771                 v-exch-scale = buf_price-all.pdf-exch-scale
     6772               .
     6773               else do:
     6774   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6775   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6776     (input  buf_price-all.curr-code
     6777     ,input  to-day
     6778     ,output v-exch-rate0
     6779     ,output v-exch-scale0
     6780     ,output v-curr-abbr
     6781     )  .
     6782               assign
     6783                 v-exch-rate  = v-exch-rate0
     6784                 v-exch-scale = v-exch-scale0
     6785                 .
     6786              end.
     6787              v-date-1 = date ( "" )  .
     6788              if buf_price-all.fact-order-sys-from > 0 then do:
     6789                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6790                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6791                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6792              end.
     6793              v-date-2 =  date ( "" )  .
     6794              if buf_price-all.fact-order-sys-to > 0 then do:
     6795                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6796                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6797                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6798              end.
     6799              if buf_price-all.qnty-from <> ? then do :
     6800                 if not (
     6801                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6802                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6803                 ) then do:
     6804                        v-interv = "".
     6805                        next.
     6806                 end.
     6807                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6808              end.
     6809              if buf_price-all.sum-from <> ? then do :
     6810                 if not (
     6811                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6812                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6813                 ) then do:
     6814                    v-interv = "".
     6815                    next.
     6816                 end.
     6817                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6818              end.
     6819              if buf_price-all.turnover-from <> ? then do :
     6820                 if not (
     6821                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6822                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6823                 ) then do:
     6824                    v-interv = "".
     6825                    next.
     6826                 end.
     6827                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6828              end.
     6829              if buf_price-all.use-pay-type = 1 then do :
     6830                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6831                    v-pay-name = "" .
     6832                    next.
     6833                  end.
     6834                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6835              end.
     6836              if buf_price-all.use-cash-pay = 1 then do :
     6837                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6838                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6839                   v-pay-name = "" .
     6840                   next.
     6841                 end.
     6842                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6843              end.
     6844             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6845             create tt_price-all .
     6846             buffer-copy buf_price-all to tt_price-all
     6847             assign
     6848               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6849               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6850               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6851               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6852               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6853               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6854               tt_price-all.price-sale     = buf_price-all.price-sale
     6855               tt_price-all.road-tax       = buf_price-all.road-tax
     6856               tt_price-all.excise         = buf_price-all.excise
     6857               tt_price-all.pdf-exch-rate   = v-exch-rate
     6858               tt_price-all.pdf-exch-scale  = v-exch-scale
     6859               tt_price-all.pdf-base-rate   = v-base-rate
     6860               tt_price-all.pdf-base-scale  = v-base-scale
     6861               tt_price-all.grp-name        = v-grp-name
     6862               tt_price-all.date-1          = v-date-1
     6863               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6864               tt_price-all.time-1          = buf_price-all.start-sys-time
     6865               tt_price-all.date-2          = v-date-2
     6866               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6867               tt_price-all.time-2          = buf_price-all.end-sys-time
     6868               tt_price-all.interv-name     = v-interv
     6869               tt_price-all.pay-name        = v-pay-name
     6870               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6871             .
     6872   end.
     6873   define variable vt-plt-id as integer   no-undo .
     6874   define variable vt-plt-db as integer   no-undo .
     6875   define variable vt-pdf-id as integer   no-undo .
     6876   define variable vt-pdf-db as integer   no-undo .
     6877   define buffer neos_price-all for tt_price-all  .
     6878   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6879       if available tt_price-all then do:
     6880        assign
     6881          vt-plt-id = tt_price-all.plt-id
     6882          vt-plt-db = tt_price-all.plt-db-num
     6883          vt-pdf-id = tt_price-all.pdf-id
     6884          vt-pdf-db = tt_price-all.pdf-db
     6885        .
     6886        if tt_price-all.b-code = p-b-code then do:
     6887             assign
     6888               p-plt-id           = tt_price-all.plt-id
     6889               p-plt-db-num       = tt_price-all.plt-db-num
     6890               p-pdf-id           = tt_price-all.pdf-id
     6891               p-pdf-db-num       = tt_price-all.pdf-db
     6892               p-sale-price-base  = tt_price-all.price-sale-base
     6893               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6894               p-road-tax-base    = tt_price-all.road-tax-base
     6895               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6896               p-excise-base      = tt_price-all.excise-base
     6897               p-excise-rubl      = tt_price-all.excise-rubl
     6898               .
     6899        end.
     6900        else do:
     6901          find first neos_price-all where
     6902                     neos_price-all.b-code     = p-b-code  and
     6903                     neos_price-all.plt-id     = vt-plt-id and
     6904                     neos_price-all.plt-db-num = vt-plt-db and
     6905                     neos_price-all.pdf-id     = vt-pdf-id and
     6906                     neos_price-all.pdf-db     = vt-pdf-db
     6907                     use-index pi no-error .
     6908            if available neos_price-all then do:
     6909             assign
     6910               p-plt-id           = tt_price-all.plt-id
     6911               p-plt-db-num       = tt_price-all.plt-db-num
     6912               p-pdf-id           = tt_price-all.pdf-id
     6913               p-pdf-db-num       = tt_price-all.pdf-db
     6914               p-sale-price-base  = neos_price-all.price-sale-base
     6915               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6916               p-road-tax-base    = neos_price-all.road-tax-base
     6917               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6918               p-excise-base      = neos_price-all.excise-base
     6919               p-excise-rubl      = neos_price-all.excise-rubl
     6920               .
     6921            end.
     6922            else do:
     6923                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6924                 if error-status :error    then do:
     6925                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6926                   return error return-value .
     6927                 end.
     6928             assign
     6929               p-plt-id           = tt_price-all.plt-id
     6930               p-plt-db-num       = tt_price-all.plt-db-num
     6931               p-pdf-id           = tt_price-all.pdf-id
     6932               p-pdf-db-num       = tt_price-all.pdf-db
     6933               p-sale-price-base  = tt_price-all.price-sale-base
     6934               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6935               p-road-tax-base    = tt_price-all.road-tax-base
     6936               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6937               p-excise-base      = tt_price-all.excise-base
     6938               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6939               .
     6940            end.
     6941        end.
     6942     end.
     6943   end.
     6944   end procedure.
     6945   procedure mpl-tpl-auto :
     6946   define input  parameter p-b-code     as integer   no-undo .
     6947   define input  parameter p-obj-type   as character no-undo .
     6948   define input  parameter p-obj-code   as integer   no-undo .
     6949   define input  parameter p-plt-id     as integer   no-undo .
     6950   define input  parameter p-plt-db-num as integer   no-undo .
     6951   define input  parameter p-fact-order as decimal   no-undo .
     6952   define output parameter p-sale-price as decimal   no-undo .
     6953   define output parameter p-pdf-id     as integer   no-undo .
     6954   define output parameter p-pdf-db-num as integer   no-undo .
     6955     do
     6956     on error undo, return error return-value
     6957     :
     6958   if p-fact-order = ? then do:
     6959     run fact-order-mpl (
     6960         input   today       ,
     6961         input   p-obj-type  ,
     6962         input   p-obj-code  ,
     6963         output  p-fact-order ) .
     6964   end.
     6965   assign
     6966     p-pdf-id      = ?
     6967     p-pdf-db-num  = ?
     6968     p-sale-price  = ?
     6969   .
     6970   define buffer buf_bar-code for ub.bar-code  .
     6971   define buffer buf_goods for ub.goods  .
     6972   find first buf_bar-code no-lock where
     6973              buf_bar-code.b-code = p-b-code
     6974              no-error .
     6975   if error-status :error then return error return-value .
     6976   find first buf_goods no-lock where
     6977              buf_goods.gds-code = buf_bar-code.gds-code
     6978              no-error .
     6979   if error-status :error then return error return-value .
     6980   define variable v-main-b-code as integer   no-undo .
     6981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6982     (input  buf_goods.gds-code
     6983     ,input  ?
     6984     ,output v-main-b-code
     6985     )  .
     6986   define buffer buf_price-all for ub.price-all  .
     6987   for each tt_price-all : delete tt_price-all. end.
     6988       for each buf_price-all no-lock where
     6989               buf_price-all.plt-id     = p-plt-id                 and
     6990               buf_price-all.plt-db-num = p-plt-db-num             and
     6991               buf_price-all.obj-type   = p-obj-type               and
     6992               buf_price-all.obj-code   = p-obj-code               and
     6993               buf_price-all.gds-code   = buf_goods.gds-code       and
     6994             ( buf_price-all.b-code = v-main-b-code or
     6995               buf_price-all.b-code = p-b-code)    and
     6996               buf_price-all.status_    = 'акт':U         and
     6997               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6998             ( buf_price-all.fact-order-sys-to = ? or
     6999               buf_price-all.fact-order-sys-to >=  p-fact-order)
     7000               :
     7001                 create tt_price-all .
     7002                 buffer-copy buf_price-all to tt_price-all
     7003                 assign
     7004                   tt_price-all.price-sale  = buf_price-all.price-sale
     7005                 .
     7006       end.
     7007   define variable vt-plt-id as integer   no-undo .
     7008   define variable vt-plt-db as integer   no-undo .
     7009   define variable vt-pdf-id as integer   no-undo .
     7010   define variable vt-pdf-db as integer   no-undo .
     7011   define buffer neos_price-all for tt_price-all  .
     7012   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     7013       if available tt_price-all then do:
     7014        assign
     7015          vt-plt-id = tt_price-all.plt-id
     7016          vt-plt-db = tt_price-all.plt-db-num
     7017          vt-pdf-id = tt_price-all.pdf-id
     7018          vt-pdf-db = tt_price-all.pdf-db
     7019        .
     7020        if tt_price-all.b-code = p-b-code then do:
     7021             assign
     7022               p-plt-id           = tt_price-all.plt-id
     7023               p-plt-db-num       = tt_price-all.plt-db-num
     7024               p-pdf-id           = tt_price-all.pdf-id
     7025               p-pdf-db-num       = tt_price-all.pdf-db
     7026               p-sale-price       = tt_price-all.price-sale
     7027               .
     7028        end.
     7029        else do:
     7030          find first neos_price-all where
     7031                     neos_price-all.b-code     = p-b-code  and
     7032                     neos_price-all.plt-id     = vt-plt-id and
     7033                     neos_price-all.plt-db-num = vt-plt-db and
     7034                     neos_price-all.pdf-id     = vt-pdf-id and
     7035                     neos_price-all.pdf-db     = vt-pdf-db
     7036                     use-index pi no-error .
     7037            if available neos_price-all then do:
     7038             assign
     7039               p-plt-id           = tt_price-all.plt-id
     7040               p-plt-db-num       = tt_price-all.plt-db-num
     7041               p-pdf-id           = tt_price-all.pdf-id
     7042               p-pdf-db-num       = tt_price-all.pdf-db
     7043               p-sale-price       = neos_price-all.price-sale
     7044               .
     7045            end.
     7046            else do:
     7047           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     7048           if error-status :error    then do:
     7049              message "Не найден бар-код" p-b-code view-as alert-box error .
     7050              return error return-value .
     7051           end.
     7052             assign
     7053               p-plt-id           = tt_price-all.plt-id
     7054               p-plt-db-num       = tt_price-all.plt-db-num
     7055               p-pdf-id           = tt_price-all.pdf-id
     7056               p-pdf-db-num       = tt_price-all.pdf-db
     7057               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     7058               .
     7059            end.
     7060        end.
     7061     end.
     7062     end.
     7063   end procedure.
     7064   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7065   procedure ggoattr-code :
     7066     define input  parameter p-code           as character no-undo .
     7067     define output parameter p-type           as character no-undo .
     7068     define output parameter p-format         as character no-undo .
     7069     define output parameter p-label          as character no-undo .
     7070     define output parameter p-user-can-edit  as logical   no-undo .
     7071     define output parameter p-output-display as logical   no-undo .
     7072     define output parameter p-other          as character no-undo .
     7073     do
