     1365                             " объект: " + parobj-type + " " + string(parobj-code) + chr(10).
     1366             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1367           end.
     1368           assign
     1369           buf_tt-tax.rate-value  = varrate-value
     1370           .
     1371         end.
     1372         else do:
     1373           if not avail buf_gds-prt then
     1374           FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1375   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1376     (
     1377        input buf_goods.artic
     1378     ,  input buf_goods.prod-type
     1379     ,  input buf_goods.prod-code
     1380     , output is-petrolium
     1381     , output is-pieces
     1382     ) no-error.
     1383           if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U then do:
     1384             find FIRST buf_prod-bc where
     1385                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1386                         buf_prod-bc.bc-on = yes no-lock no-error.
     1387             if not available buf_prod-bc then do:
     1388               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1389                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1390               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1391             end.
     1392           end.
     1393           else do:
     1394             find buf_bar-code where
     1395                   buf_bar-code.gds-code  = vargds-code     and
     1396                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1397                   buf_bar-code.part-code = ""           and
     1398                   buf_bar-code.in-code   = ""           and
     1399                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1400             if not available buf_bar-code then do:
     1401               assign varmes = "Не найден бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1402                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1403               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1404             end.
     1405           end.
     1406           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1407             ASSIGN
     1408             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1409                                   then integer(buf_prod-bc.b-str)
     1410                                   else buf_bar-code.b-code
     1411             buf_tt-tax.rate-value  = parroad-tax
     1412             buf_tt-tax.tax-rate-gds-rc  = ?
     1413             NO-ERROR.
     1414           end.
     1415           if buf_tt-tax.tax-code = exctaxcdvalue then do:
     1416             ASSIGN
     1417             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1418                                   then integer(buf_prod-bc.b-str)
     1419                                   else buf_bar-code.b-code
     1420             buf_tt-tax.rate-value  = parexcise
     1421             buf_tt-tax.tax-rate-gds-rc  = ?
     1422             NO-ERROR.
     1423           end.
     1424         end.
     1425       end.
     1426     end.
     1427   end procedure.
