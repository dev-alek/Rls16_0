    11523                                   ,output v-attr-emrc
    11524                                   ,output v-attr-type) no-error.
    11525   run bgelib-tag-put in this-procedure ( input 3, input "Item_EMRC"  , input v-attr-emrc , input 1 ).
    11526   vGdsTabak = if vaction = "D" then yes else no.
    11527   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
    11528                 and buf_goods-attr.attr-code  = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" no-error .
    11529       if available (buf_goods-attr)
