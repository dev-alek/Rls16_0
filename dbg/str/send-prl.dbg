     3300   procedure xml-cd-write-header:
     3301   do
     3302   on error undo, return error
     3303   :
     3304   define input parameter p-xml-file-name       as character    no-undo.
     3305   define input parameter p-xml-file-name-path  as character    no-undo.
     3306   define input parameter p-doc-name            as character    no-undo.
     3307   define input parameter p-version             as character    no-undo.
     3308   define input parameter p-obj-list            as character    no-undo.
     3309   define input parameter p-correspondent       as character    no-undo .
     3310   define input parameter p-write-header        as logical      no-undo .
     3311   define variable OS-time as character no-undo .
     3312   define variable id as character no-undo .
     3313   define buffer buf_db for ub.db.
     3314   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3315   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3316   assign
     3317   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3318   .
     3319   run bgelib-tag-open in this-procedure (
     3320                                        1
     3321                                       ,p-doc-name
     3322                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3323                                         ).
     3324   if p-write-header then do:
     3325     run bgelib-tag-open(2, "Header","").
     3326     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3327     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3328     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3329     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3330     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3331     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3332     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3333     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3334     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3335     run bgelib-tag-close( 2, "Header" ).
     3336   end.
     3337   output stream stmXMLOut close.
     3338   end.
     3339   end procedure.
     3340   procedure xml-cd-write-footer:
     3341   do
     3342   on error undo, return error
     3343   :
     3344   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3345   define input parameter p-xml-file-name as character    no-undo.
     3346   define input parameter p-doc-name      as character    no-undo .
     3347   define variable v-error-num     as integer           no-undo.
     3348   define variable v-md5-signature as character no-undo .
     3349   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3350   run bgelib-tag-close( 0, p-doc-name ).
     3351   put stream stmXMLOut unformatted skip.
     3352   output stream stmXMLOut close.
     3353   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3354   if v-error-num > 0
     3355   then do:
     3356      return error.
     3357   end.
     3358   if opsys = "unix"
     3359   then do:
     3360       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3361   end.
     3362   end.
     3363   end procedure.
     3364   procedure xml-cd-filename :
     3365   do
     3366   on error undo, return error
     3367   :
     3368   define input parameter  p-out               as character no-undo .
     3369   define output parameter p-xml-file-name     as character    no-undo.
     3370   define output parameter p-xml-file-name-path   as character    no-undo.
     3371   define output parameter p-log-file-name     as character    no-undo.
     3372   define output parameter p-locked            as logical      no-undo.
     3373   define variable v-out as character     no-undo.
     3374   define variable loc#log as logical no-undo .
     3375   define variable BadFlag as logical no-undo .
     3376   define variable fq as integer no-undo .
     3377   define variable v-remote as character no-undo .
     3378   assign
     3379   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3380   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3381   p-log-file-name = p-out + "actions.log"
     3382   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3383   .
     3384   end.
     3385   end procedure.
     3386   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3387   define variable v-date-str as character no-undo .
     3388   assign
     3389   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3390                string(Month(p-date), "99":U) + "-":U +
     3391                string(DAY(p-date), "99":U).
     3392   return v-date-str.
     3393   END FUNCTION.
     3394   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3395   define variable v-date-str as character no-undo .
     3396   assign
     3397   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3398                string(Month(p-date), "99":U) + "-":U +
     3399                string(DAY(p-date), "99":U) + chr(32) +
     3400                string(p-time, "HH:MM:SS").
     3401   return v-date-str.
     3402   END FUNCTION.
     3403   function string-to-date returns date ( input p-string  as character):
     3404     define variable v-date as date no-undo .
     3405     assign
     3406     v-date = date(integer(substring(p-string, 4, 2))
     3407                   ,integer(substring(p-string, 1, 2))
     3408                   ,integer(substring(p-string, 7, 4))
     3409                  ) no-error .
     3410     if error-status:error then return ?.
     3411     return v-date.
     3412   END FUNCTION.
     3413   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3414   define variable v-time as integer no-undo init ?.
     3415   define variable v-dop1 as character no-undo .
     3416   define variable v-dop2 as character no-undo .
     3417   assign
     3418   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3419   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3420   no-error .
     3421   if error-status:error then return ?.
     3422   assign
     3423   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3424             integer(entry(2, v-dop2, ";":U)) * 60 +
     3425             integer(entry(3, v-dop2, ";":U)) no-error .
     3426   return v-time.
     3427   END FUNCTION.
     3428   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3429   procedure gdcstcod_cst-code :
     3430     define input  parameter p-obj-type  as character no-undo .
     3431     define input  parameter p-obj-code  as integer   no-undo .
     3432     define input  parameter p-gds-code  as integer   no-undo .
     3433     define input  parameter p-in-code   as character no-undo .
     3434     define input  parameter p-part-code as character no-undo .
     3435     define output parameter p-cst-code  as character no-undo .
     3436     define buffer buf_goods for ub.goods .
     3437     define buffer buf_parts for ub.parts .
     3438     do
     3439     on error undo, return error return-value
     3440     :
     3441       assign
     3442         p-cst-code = ''
     3443       .
     3444       find first buf_goods no-lock
     3445         where buf_goods.gds-code = p-gds-code
     3446         no-error .
     3447       if not available buf_goods
     3448       then do:
     3449         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3450       end.
     3451       if p-in-code = ?
     3452       then do:
     3453         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3454       end.
     3455       if p-part-code = ?
     3456       then do:
     3457         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3458       end.
     3459       if p-in-code = '':u
     3460       then do:
     3461         find first buf_parts no-lock
     3462           where buf_parts.obj-type  = p-obj-type
     3463             and buf_parts.obj-code  = p-obj-code
     3464             and buf_parts.artic     = buf_goods.artic
     3465             and buf_parts.prod-type = buf_goods.prod-type
     3466             and buf_parts.prod-code = buf_goods.prod-code
     3467             and buf_parts.out-code  = 'free-zone':U
     3468             and buf_parts.status_   = false
     3469           no-error .
     3470         if available buf_parts
     3471         then do:
     3472           assign
     3473             p-cst-code = buf_parts.cst-code
     3474           .
     3475         end.
     3476       end.
     3477       else do:
     3478         find first buf_parts no-lock
     3479           where buf_parts.obj-type  = p-obj-type
     3480             and buf_parts.obj-code  = p-obj-code
     3481             and buf_parts.artic     = buf_goods.artic
     3482             and buf_parts.prod-type = buf_goods.prod-type
     3483             and buf_parts.prod-code = buf_goods.prod-code
     3484             and buf_parts.out-code  = 'free-zone':U
     3485             and buf_parts.in-code   = p-in-code
     3486             and buf_parts.part-code = p-part-code
     3487           no-error .
     3488         if available buf_parts
     3489         then do:
     3490           assign
     3491             p-cst-code = buf_parts.cst-code
     3492           .
     3493         end.
     3494       end.
     3495     end.
     3496   end procedure.
