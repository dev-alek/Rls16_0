     4460   find first buf_temp-drt-prop where
     4461             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4462         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4463         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4464   if not available buf_temp-drt-prop then do:
     4465     find first buf_drt-prop where
     4466               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4467           and buf_drt-prop.upper-prop-code = "InputForm"
     4468           and buf_drt-prop.prop-code = "FormName" no-error.
     4469     if available buf_drt-prop then do:
     4470       p-form-name = buf_drt-prop.property-value.
     4471     end.
     4472     else do:
     4473       p-form-name = "ref/dis-ruli.w".
     4474     end.
     4475   end.
     4476   else do:
     4477     p-form-name = buf_temp-drt-prop.property-value.
     4478   end.
     4479   end procedure.
