    11352                     cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num:
    11353           if buf_cash-dis-rule.is-term
    11354           and buf_cash-dis-rule.root then do:
    11355           end.
    11356           else do:
    11357             case buf_cash-dis-rule.value-type:
    11358               when integer('1':U) then do:
    11359                 assign
    11360                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
    11361                 .
    11362               end.
    11363               when integer('11':U) then do:
    11364                 find first cash-gds-discnt where
    11365                           cash-gds-discnt.b-code = cash-gds.b-code
    11366                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    11367                       and cash-gds-discnt.obj-type = 'маг':U
    11368                       and cash-gds-discnt.obj-code = i-obj-code
    11369                       no-error.
    11370                 if available cash-gds-discnt then do:
    11371                   assign
    11372                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
    11373                   .
    11374                 end.
    11375                 else do:
    11376                   assign
    11377                   temp-disc-dec = 0.
    11378                 end.
    11379               end.
    11380               otherwise do:
    11381                 temp-disc-dec = 0.
    11382               end.
    11383             end case.
    11384           end.
    11385           assign
    11386           temp-disc-reason = 0
    11387           temp-disc-weekday = 0
    11388           no-error
    11389           .
    11390           assign
    11391           temp-disc-start = cash-dis-time-rule.date-from
    11392           temp-disc-end   = cash-dis-time-rule.date-to
    11393           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
    11394           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
    11395           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
    11396                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
    11397                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
    11398                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
    11399                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
    11400                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
    11401                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
    11402           .
    11403           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
    11404           assign
