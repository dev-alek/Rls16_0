     8887                   if AVAILABLE ub.tax-rate-attr then do:
     8888                       tax-string = tax-string + " " + (if tt-tax.individual
     8889                                                 then (if tt-tax.rate-value <> 0
     8890                                                           then string(ub.tax-rate-attr.rate-code + txfixnum)
     8891                                                           else "")
     8892                                                 else string(ub.tax-rate-attr.rate-code)).
     8893                   end.
     8894                   else do:
     8895                       tax-string = tax-string + " " + (if tt-tax.individual
