     6552   define input  parameter p-obj-code    as integer   no-undo .
     6553   define input  parameter p-qnty-doc    as decimal   no-undo .
     6554   define input  parameter p-sum-doc     as decimal   no-undo .
     6555   define input  parameter p-vid-pay        as character no-undo .
     6556   define input  parameter p-cash-pay-type  as character no-undo .
     6557   define input  parameter p-fact-order  as decimal   no-undo .
