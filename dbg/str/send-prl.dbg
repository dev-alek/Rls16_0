    10862               .
    10863             end.
    10864             else do:
    10865              assign
    10866               temp-disc-dec = 0.
    10867             end.
    10868           end.
    10869           otherwise do:
    10870             temp-disc-dec = 0.
    10871           end.
    10872         end case.
    10873       end.
    10874     end.
