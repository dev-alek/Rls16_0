    10778         std-disc-reason = 0
    10779         .
    10780         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10781         assign
    10782         std-disc-dec = 0
    10783         std-disc-reason = 0
