     6559   define output parameter p-plt-db-num      as integer   no-undo .
     6560   define output parameter p-pdf-id          as integer   no-undo .
     6561   define output parameter p-pdf-db-num      as integer   no-undo .
     6562   define output parameter p-sale-price-base as decimal   no-undo .
     6563   define output parameter p-sale-price-rubl as decimal   no-undo .
     6564   define output parameter p-road-tax-base as decimal   no-undo .
     6565   define output parameter p-road-tax-rubl as decimal   no-undo .
     6566   define output parameter p-excise-base   as decimal   no-undo .
     6567   define output parameter p-excise-rubl   as decimal   no-undo .
     6568   define variable v-cli-oborot-ALL as decimal   no-undo .
     6569   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6570   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6571   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6572   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6573   define buffer buf_price-all              for ub.price-all  .
     6574   define buffer buf_goods                  for ub.goods      .
     6575   define buffer buf_global-state           for ub.global-state  .
     6576   define buffer buf_buyer-group            for ub.buyer-group  .
     6577   define buffer buf_turnover-group         for ub.turnover-group  .
     6578   define buffer buf_main-code              for ub.bar-code  .
     6579   define buffer buf_bar-code               for ub.bar-code  .
     6580   define buffer buf_pay-type               for ub.pay-type  .
     6581   define buffer buf_cash-pay               for ub.cash-pay  .
     6582   define variable to-day          as date      no-undo .
     6583   define variable v-base-rate0    as decimal   no-undo .
     6584   define variable v-base-scale0   as decimal   no-undo .
     6585   define variable v-exch-rate0    as decimal   no-undo .
     6586   define variable v-exch-scale0   as decimal   no-undo .
     6587   define variable v-base-rate     as decimal   no-undo .
     6588   define variable v-base-scale    as decimal   no-undo .
     6589   define variable v-exch-rate     as decimal   no-undo .
     6590   define variable v-exch-scale    as decimal   no-undo .
     6591   define variable v-host-code     as integer   no-undo .
     6592   define variable v-curr-abbr     as character no-undo .
     6593   define variable v-grp-name      as character no-undo .
     6594   define variable v-date-1        as date      no-undo .
     6595   define variable v-date-2        as date      no-undo .
     6596   define variable v-interv        as character no-undo .
     6597   define variable v-pay-name      as character no-undo .
     6598   define variable v-cli-oborot    as decimal   no-undo .
     6599   define variable v-trn-pay-code  as integer   no-undo .
     6600   define variable v-cash-pay-curr as integer   no-undo .
     6601   define variable v-cash-pay-code as integer   no-undo .
     6602   do
     6603   on error undo, return error return-value
     6604   :
     6605   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6606   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6607   if p-fact-order = ? then do:
     6608     run fact-order-mpl (
     6609         input   today       ,
     6610         input   p-obj-type  ,
     6611         input   p-obj-code  ,
     6612         output  p-fact-order ).
     6613   end.
     6614   if p-vid-pay <> "" then do:
     6615      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6616      if available buf_pay-type
     6617         then v-trn-pay-code = buf_pay-type.obj-code.
     6618         else v-trn-pay-code =  0.
     6619   end.
     6620   else v-trn-pay-code = 0 .
     6621   if p-cash-pay-type <> "" then do:
     6622      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6623      if available buf_pay-type
     6624         then
     6625           assign
     6626             v-cash-pay-curr = buf_cash-pay.curr-code
     6627             v-cash-pay-code = buf_cash-pay.cdpay-code
     6628           .
     6629         else
     6630           assign
     6631             v-cash-pay-curr = 0
     6632             v-cash-pay-code = 0
     6633             .
     6634   end.
     6635   else
     6636     assign
     6637       v-cash-pay-curr = 0
     6638       v-cash-pay-code = 0
     6639       .
     6640   for each tt_price-all  : delete tt_price-all . end.
     6641   assign
     6642     p-plt-id             = ?
     6643     p-plt-db-num         = ?
     6644     p-pdf-id             = ?
     6645     p-pdf-db-num         = ?
     6646     p-sale-price-base    = ?
     6647     p-sale-price-rubl    = ?
     6648     v-cli-oborot         = 0
     6649   .
     6650   find first buf_global-state no-lock no-error .
     6651   if not available buf_global-state then do:
     6652      message
     6653        "Не заданы параметры ценообразования!"
     6654        view-as alert-box error
     6655      .
     6656      return error return-value .
     6657   end.
