     7255   procedure grp-obj-notcorr-value :
     7256   do
     7257   on error undo, return error
     7258   :
     7259   define input parameter p-node-code             as integer      no-undo.
     7260   define input parameter p-obj-type              as character    no-undo.
     7261   define input parameter p-obj-code              as integer      no-undo.
     7262   define output parameter p-notcorr              as character    no-undo init ?.
     7263   define output parameter p-range-notcorr     as integer      no-undo.
     7264   define output parameter p-exists-notcorr    as logical      no-undo.
     7265   define variable v-host-code as integer      no-undo.
     7266   DEFINE VARIABLE v-found as logical no-undo .
     7267   DEFINE VARIABLE v-exists as logical no-undo .
     7268   DEFINE VARIABLE v-range as integer no-undo .
     7269   DEFINE VARIABLE jj as integer no-undo .
     7270   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7271   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7272   define buffer buf_gds-grp for ub.gds-grp.
     7273   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7274   find first buf_gds-grp no-lock where
     7275              buf_gds-grp.node-code = p-node-code no-error .
     7276   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7277     message
     7278       vss-workfile vss-revision vss-description
     7279       skip "Не удалось найти группу товаров с кодом" p-node-code
     7280       view-as alert-box error .
     7281     undo, return error .
     7282   end.
     7283   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7285     (input  p-obj-type
     7286     ,input  p-obj-code
     7287     ,output v-host-code
     7288     ) no-error .
     7289   if error-status :error
     7290   then do:
     7291       message
     7292         vss-workfile vss-revision vss-description
     7293         skip "Не удалось найти фирму объекта"
     7294         skip p-obj-type p-obj-code
     7295         skip return-value
     7296         skip trim(error-status :get-message(1))
     7297       view-as alert-box error.
     7298       undo, return error .
     7299   end.
     7300   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7301   do while v-found = no and jj < 2:
     7302     if v-range <> 3 then do:
     7303       find first buf_gds-grp-obj no-lock
     7304           where buf_gds-grp-obj.node-code = p-node-code
     7305             and buf_gds-grp-obj.host-code = v-host-code
     7306             and buf_gds-grp-obj.obj-type  = p-obj-type
     7307             and buf_gds-grp-obj.obj-code  = p-obj-code
     7308       no-error .
     7309     end.
     7310     if v-range = 3 or not available buf_gds-grp-obj
     7311     then do:
     7312        if v-range <> 2 then do:
     7313           find first buf_gds-grp-obj no-lock
     7314               where buf_gds-grp-obj.node-code = p-node-code
     7315                 and buf_gds-grp-obj.host-code = v-host-code
     7316                 and buf_gds-grp-obj.obj-type  = ""
     7317                 and buf_gds-grp-obj.obj-code  = 0
     7318           no-error .
     7319         end.
     7320         if v-range = 2 or not available buf_gds-grp-obj
     7321         then do:
     7322             if v-range <> 1 then do:
     7323               find first buf_gds-grp-obj no-lock
     7324                   where buf_gds-grp-obj.node-code = p-node-code
     7325                   and buf_gds-grp-obj.host-code = 0
     7326                   and buf_gds-grp-obj.obj-type  = ""
     7327                   and buf_gds-grp-obj.obj-code  = 0
     7328               no-error .
     7329             end.
     7330             if v-range = 1 or not available buf_gds-grp-obj
     7331             then do:
     7332                 assign
     7333                     v-exists = no
     7334                 .
     7335             end.
     7336             else do:
     7337                 assign
     7338                     v-exists = yes
     7339                     v-range = 1
     7340                 .
     7341             end.
     7342         end.
     7343         else do:
     7344             assign
     7345                 v-exists = yes
     7346                 v-range  = 2
     7347             .
     7348         end.
     7349     end.
     7350     else do:
     7351         assign
     7352             v-exists = yes
     7353             v-range  = 3
     7354         .
     7355     end.
     7356     if available buf_gds-grp-obj
     7357     then do:
     7358       find first buf_gds-grp-obj-attr no-lock
     7359         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7360           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7361           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7362           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7363           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7364         no-error .
     7365       if available buf_gds-grp-obj-attr then do:
     7366         assign
     7367           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7368         .
     7369       end.
     7370       else do:
     7371         assign
     7372           v-notcorr-value = ?
     7373         .
     7374       end.
     7375       assign
     7376       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7377                           then yes
     7378                           else p-exists-notcorr)
     7379       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7380                         then v-range
     7381                         else p-range-notcorr
     7382       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7383                         then v-notcorr-value
     7384                         else p-notcorr
     7385       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7386       jj = jj + 1
     7387       .
     7388     end.
     7389     else do:
     7390       assign
     7391       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7392       jj = jj + 1
     7393       .
     7394     end.
     7395   end.
     7396   end.
     7397   end procedure.
