     7923   define variable attrType  as character no-undo.
     7924   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7925   define buffer buf_price-list for ub.price-list.
     7926   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7927   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
