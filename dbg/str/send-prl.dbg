     6387   procedure fact-order-mpl :
     6388     do
     6389     on error undo, return error return-value
     6390     :
     6391   define input  parameter p-doc-date as date     no-undo .
     6392   define input  parameter p-obj-type as character no-undo .
     6393   define input  parameter p-obj-code as integer   no-undo .
     6394   define output parameter p-fact-order as decimal   no-undo .
     6395   define variable v-fact-date            as date    no-undo .
     6396   define variable v-fact-time            as integer no-undo .
     6397   define variable v-fact-order           as decimal no-undo .
     6398   define variable v-shift-end-fact-order as decimal no-undo .
     6399   define variable v-day-end-fact-order   as decimal no-undo .
     6400   define variable l-shift-on as logical no-undo .
     6401   define variable l-date as date      no-undo .
     6402   define variable l-time as integer   no-undo .
     6403   define variable shift-date as date      no-undo .
     6404   define variable shift-num  as integer   no-undo .
     6405   define variable shift-name as character no-undo .
     6406   define variable max-fact-order as decimal   no-undo .
     6407   define buffer buf_global-state for ub.global-state  .
     6408   find first buf_global-state no-lock no-error .
     6409   if not available buf_global-state then do:
     6410      message
     6411        "Не заданы параметры ценообразования!"
     6412        view-as alert-box error
     6413      .
     6414      return error return-value .
     6415   end.
     6416     run cur-time in this-procedure
     6417     ( output v-fact-date ,
     6418       output v-fact-time  ).
     6419   if p-doc-date = ? then do:
     6420   if buf_global-state.pl-use-sys-date-time  = true then do:
     6421         run factord in this-procedure
     6422           (input  v-fact-date
     6423           ,input  v-fact-time
     6424           ,input  v-fact-time
     6425           ,input  ?
     6426           ,input  ?
     6427           ,input  false
     6428           ,output v-fact-order
     6429           ,output v-shift-end-fact-order
     6430           ,output v-day-end-fact-order
     6431           ) no-error .
     6432         if error-status :error
     6433         or v-fact-order = ?
     6434         or v-fact-order = 0 then do:
     6435           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6436         end.
     6437         p-fact-order = v-fact-order .
     6438   end.
     6439   else do:
     6440   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6442     (input  p-obj-type
     6443     ,input  p-obj-code
     6444     ,input  'shift-on=request'
     6445     ,output l-shift-on
     6446     ) no-error .
     6447         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6448         if p-doc-date <> ? then do:
     6449         end.
     6450          run gbl/factdate.p
     6451          ( input        p-obj-type  ,
     6452            input        p-obj-code  ,
     6453            input-output v-fact-date ,
     6454            input-output v-fact-time ,
     6455            input-output shift-date      ,
     6456            input-output shift-num       ,
     6457            input-output shift-name      ,
     6458            input        yes
     6459            ) no-error .
     6460         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6461         run factord in this-procedure
     6462           (input  v-fact-date
     6463           ,input  v-fact-time
     6464           ,input  v-fact-time
     6465           ,input  shift-date
     6466           ,input  shift-num
     6467           ,input  l-shift-on
     6468           ,output v-fact-order
     6469           ,output v-shift-end-fact-order
     6470           ,output v-day-end-fact-order
     6471           ) no-error .
     6472         if error-status :error
     6473         or v-fact-order = ?
     6474         or v-fact-order = 0 then do:
     6475           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6476         end.
     6477         p-fact-order = v-fact-order .
     6478   end.
     6479   end.
     6480   else do:
     6481          run gbl/factdate.p
     6482          ( input        p-obj-type  ,
     6483            input        p-obj-code  ,
     6484            input-output v-fact-date ,
     6485            input-output v-fact-time ,
     6486            input-output shift-date      ,
     6487            input-output shift-num       ,
     6488            input-output shift-name      ,
     6489            input        yes
     6490            ) no-error .
     6491         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6492         v-fact-date = p-doc-date .
     6493         run factord in this-procedure
     6494           (input  v-fact-date
     6495           ,input  v-fact-time
     6496           ,input  v-fact-time
     6497           ,input  shift-date
     6498           ,input  shift-num
     6499           ,input  l-shift-on
     6500           ,output v-fact-order
     6501           ,output v-shift-end-fact-order
     6502           ,output v-day-end-fact-order
     6503           ) no-error .
     6504         if error-status :error
     6505         or v-fact-order = ?
     6506         or v-fact-order = 0 then do:
     6507           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6508         end.
     6509         p-fact-order = v-fact-order .
     6510   end.
     6511     end.
     6512   end procedure.
     6513   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
