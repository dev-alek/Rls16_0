     8912                       and cash-txr.host-code = ub.shop.host-code
     8913                       and cash-txr.obj-type = 'маг':U
     8914                       and cash-txr.obj-code = ub.shop.obj-code
     8915                       and cash-txr.status_  = 'тек':U
     8916                       and cash-txr.rc = recid(ub.goods) no-error.
     8917                 if not available cash-txr then do:
     8918                   FIND FIRST cash-txr where cash-txr.crf = (cr-txr + 1) No-ERROR.
     8919                   start-paket-txr = no.
     8920                   if not avail cash-txr then
     8921                   create cash-txr.
     8922                   cash-txr.crf = cr-txr + 1.
     8923                   cr-txr = cr-txr + 1.
     8924                   BUFFER-COPY tt-tax USING tax-code rate-code tax-type rate-value
     8925                                       TO  cash-txr
     8926                                       ASSIGN
     8927                                       cash-txr.rc = recid(ub.goods)
     8928                                       cash-txr.host-code = ub.shop.host-code
     8929                                       cash-txr.obj-type = 'маг':U
     8930                                       cash-txr.obj-code = i-obj-code
     8931                                       cash-txr.status_ = 'тек':U
     8932                                       .
     8933                   cash-txr.rate-code = cash-txr.rate-code + txfixnum.
     8934                 end.
     8935               end.
     8936             END.
