     1183           no-error .
     1184         if not available buf_units then do:
     1185           assign
     1186             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
     1187           .
     1188           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1189         end.
     1190         assign
     1191           parunits-type = buf_units.type
     1192         .
     1193       end.
     1194       if parhost-code = ?
     1195       or parhost-code = 0
     1196       then do:
     1197   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1199     (input  parobj-type
     1200     ,input  abs(parobj-code)
     1201     ,output parhost-code
     1202     ) no-error .
     1203         if error-status :error then do:
     1204           assign
     1205             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
     1206               ,string(parobj-type)
     1207               ,string(parobj-code)
     1208               ) + chr(10)
     1209           .
     1210           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1211         end.
     1212       end.
     1213       assign
     1214         vargds-code = buf_goods.gds-code
     1215       .
     1216       for each buf_tax-units no-lock
     1217         where LOOKUP(buf_tax-units.type, parunits-type) > 0
     1218       ,first buf_tax no-lock
     1219         where buf_tax.tax-code = buf_tax-units.tax-code
     1220       :
     1221         find first buf_tt-tax where
     1222                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
     1223         if not available buf_tt-tax then do:
     1224           create buf_tt-tax .
     1225         end.
     1226         assign
     1227           buf_tt-tax.tax-code = buf_tax.tax-code
     1228         .
     1229         if buf_tax.individual = false then do:
     1230           assign
     1231             currate-gds-rc = ?
     1232           .
     1233           _tax-rate-gds:
     1234           for each buf_tax-rate-gds no-lock where
     1235                   buf_tax-rate-gds.gds-code = pargds-code and
     1236                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
     1237           first buf_tax-rate where
     1238                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
     1239                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
     1240           by buf_tax-rate-gds.host-code
     1241           by buf_tax-rate-gds.obj-type
     1242           by buf_tax-rate-gds.obj-code
     1243           by buf_tax-rate-gds.fact-order
     1244           :
     1245             if buf_tax-rate-gds.fact-order > var-fact-order then do:
     1246               next _tax-rate-gds.
     1247             end.
     1248             if buf_tax-rate-gds.host-code = 0 or
     1249               ((buf_tax-rate-gds.host-code = parhost-code) or
     1250               (buf_tax-rate-gds.obj-type = parobj-type AND
     1251               buf_tax-rate-gds.obj-code = parobj-code))
     1252             then do:
     1253               assign
     1254               currate-code = buf_tax-rate.rate-code
     1255               currate-name = buf_tax-rate.rate-name
     1256               currate-gds-rc = recid(buf_tax-rate)
     1257               .
     1258             end.
     1259             else do:
     1260               next _tax-rate-gds.
     1261             end.
     1262           end.
     1263           if currate-gds-rc = ? then do:
     1264             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
     1265                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1266                             chr(10).
     1267             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1268           end.
     1269         end.
     1270         assign
     1271           buf_tt-tax.rate-code   = currate-code
     1272           buf_tt-tax.individual  = buf_tax.individual
     1273           buf_tt-tax.tax-name    = buf_tax.tax-name
     1274           buf_tt-tax.rate-name   = currate-name
     1275           buf_tt-tax.tax-type    = buf_tax.tax-type
     1276           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
     1277           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
     1278         .
     1279       end.
     1280       if parprice-sale = ?
     1281       or parexcise     = ?
     1282       or parroad-tax   = ?
     1283       then do:
     1284         if parnode-code = ? then do:
     1285             FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1286             parnode-code = buf_gds-prt.node-code.
     1287         end.
     1288   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   gp-fact-order = 0 .
