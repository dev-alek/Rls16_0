     1103     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
     1104     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
     1105     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
     1106     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
     1107     define output parameter       parerr-mes    as character               no-undo.
     1108     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
     1109     do
     1110     on error undo, return error return-value
     1111     :
     1112   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1114   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1115   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1116   define variable gp-excise     like ub.price-list.excise     no-undo.
     1117   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1118   define variable gp-fact-order as decimal   no-undo .
     1119   define variable gp-price-sale-parts as decimal   no-undo .
     1120       define buffer buf_tax          for ub.tax .
     1121       define buffer buf_tax-rate     for ub.tax-rate .
     1122       define buffer buf_tax-units    for ub.tax-units .
     1123       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
     1124       define buffer buf_goods        for ub.goods .
     1125       define buffer buf_bar-code     for ub.bar-code .
     1126       define buffer buf_prod-bc      for ub.prod-bc .
     1127       define buffer buf_units        for ub.units .
     1128       define buffer buf_shop         for ub.shop .
     1129       define buffer buf_store        for ub.store .
     1130       define buffer buf_gds-prt      for ub.gds-prt .
