    11339     end.
    11340         run bgelib-tag-close in this-procedure ( input 3, input "ItemStatus").
    11341     end.
    11342     if cash-gds.temp-discnt-rule <> 0 then do:
    11343       find first cash-dis-rule no-lock where
    11344                 cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
    11345       if available cash-dis-rule then do:
    11346         for each buf_cash-dis-rule no-lock where
    11347                 (cash-dis-rule.is-term = yes
    11348                 and buf_cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
    11349               or
    11350               buf_cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule,
