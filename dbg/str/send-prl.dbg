    11473               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(1), input 1 ).
    11474               run bgelib-tag-put in this-procedure ( input 4, input "IDCPercent", input string(- cash-dis-rule.discnt-value),  input 1 ).
    11475             end.
    11476             when integer('3':U) then do:
    11477               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
    11478               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(cash-dis-rule.discnt-value),  input 1 ).
    11479             end.
    11480             when integer('12':U) then do:
    11481               find first cash-gds-discnt where
    11482                         cash-gds-discnt.b-code = cash-gds.b-code
    11483                     and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    11484                   and cash-gds-discnt.obj-type = 'маг':U
    11485                   and cash-gds-discnt.obj-code = i-obj-code
    11486                     no-error.
    11487               if available cash-gds-discnt then do:
    11488                 assign
    11489                 v-kat-discnt = cash-gds-discnt.discnt-value
    11490                 .
    11491               end.
    11492               else do:
    11493                 v-kat-discnt = cash-gds.price-sale.
    11494               end.
    11495               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
    11496               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(v-kat-discnt),  input 1 ).
    11497             end.
    11498           end case.
    11499         end.
    11500         run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
    11501       end.
    11502     end.
    11503     else do:
    11504       run bgelib-tag-open in this-procedure ( input 3, input "ItemDisCat", input "" ).
    11505       run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
    11506     end.
    11507   if pos-type <> 'InfoKiosk':U then do:
    11508         if tax-cass
    11509         AND vaction = "U" then do:
    11510           do i-entry = 1 to num-entries(cash-gds.tax-string, chr(32)):
