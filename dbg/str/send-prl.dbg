     1765   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1766   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1767   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1768   procedure disrules-fill-properties:
     1769   define input  parameter p-templ-rl-root as integer   no-undo .
     1770   define buffer buf_drt-prop for ub.drt-prop.
     1771   define buffer buf_temp-drt-prop for temp-drt-prop.
     1772   do
     1773   on error undo, return error return-value
     1774   :
     1775     for each buf_temp-drt-prop:
     1776       delete buf_temp-drt-prop.
     1777     end.
     1778     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1779       create buf_temp-drt-prop.
     1780       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1781     end.
     1782   end.
     1783   end procedure.
     1784   ~
     1785   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1786   procedure discfgru-check :
     1787   define input parameter p-table-name as character no-undo .
     1788   define input parameter p-templ-rl-root as integer no-undo .
     1789   define input parameter p-time-templ-rl-root as integer no-undo .
     1790   define input parameter p-pos-type as character no-undo .
     1791   define output parameter p-disnct-role as character no-undo .
     1792   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       find first buf_dis-cfg-rule no-lock where
     1797               buf_dis-cfg-rule.table-name = p-table-name
     1798           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1799           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1800           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1801       if not available buf_dis-cfg-rule
     1802       or p-pos-type = "":U
     1803       then do:
     1804          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1805                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1806                                  , p-templ-rl-root
     1807                                  , (if p-time-templ-rl-root = ?
     1808                                     then '':U
     1809                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1810                                     )
     1811                                  ).
     1812       end.
     1813       assign
     1814       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1815       .
     1816     end.
     1817   end procedure.
     1818   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   FUNCTION get-region RETURNS CHARACTER
     1820     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1821     define variable par-region as character no-undo.
     1822     if parhost-code = 0 and
     1823          parobj-type = "":U and
     1824          parobj-code = 0 then do:
     1825          par-region = "Глобально".
     1826          return par-region.
     1827       end.
     1828       if parobj-type = 'орг':U then do:
     1829          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1830          return par-region.
     1831       end.
     1832       if parobj-type = 'регион':U
     1833       then do:
     1834          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1835          return par-region.
     1836       end.
     1837       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1838       return par-region.
     1839   END FUNCTION.
     1840   FUNCTION get-objregion RETURNS CHARACTER
     1841     (  input parobj-type as character, input parobj-code as integer ) :
     1842     define variable par-region as character no-undo.
     1843     if  parobj-type = "":U and
     1844         parobj-code = 0
     1845     then do:
     1846        par-region = "Глобально".
     1847     end.
     1848     else if parobj-type = 'орг':U
     1849     then do:
     1850        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1851     end.
     1852     else if parobj-type = 'регион':U
     1853     then do:
     1854        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1855     end.
     1856     else
     1857        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1858     return par-region.
     1859   END FUNCTION.
     1860   procedure disgdsru-name :
     1861   define buffer buf_dis-rule for ub.dis-rule.
     1862   do
     1863     on error undo, return error
     1864     :
     1865     define input  parameter p-templ-rl-root  as integer no-undo .
     1866     define output parameter p-label          as character no-undo .
     1867     find first buf_dis-rule no-lock where
     1868               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1869     if available buf_dis-rule
     1870     then do:
     1871       if buf_dis-rule.rule-num > 0 then
     1872       p-label = buf_dis-rule.des.
     1873     end.
     1874     else do:
     1875       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1876     end.
     1877   end.
     1878   end procedure.
     1879   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
