     7477   DEFINE VARIABLE unq-artc                     as logical           no-undo init no .
     7478   DEFINE VARIABLE nam-2str                     as logical           no-undo init no .
     7479   DEFINE VARIABLE nam-artc                     as logical           no-undo init no .
     7480   DEFINE VARIABLE name-2cd                     as character       no-undo .
     7481   DEFINE VARIABLE cod-pcod                     as logical           no-undo .
     7482   DEFINE VARIABLE tax-cass                     as logical           no-undo init no .
     7483   DEFINE VARIABLE ipcsc-pfx                    as integer           no-undo init 23 .
     7484   DEFINE VARIABLE ipcpg-pfx                    as integer           no-undo init 24 .
     7485   DEFINE VARIABLE ncrgmdsc                     as character         no-undo .
     7486   DEFINE VARIABLE ncrdsc                       as character         no-undo .
     7487   DEFINE VARIABLE ncrdrank                     as character         no-undo  init "TX":U.
     7488   DEFINE VARIABLE ncrsc-pfx                    as character         no-undo init "23":U .
     7489   DEFINE VARIABLE ncrsc-frmt                   as character         no-undo init "EAN13" .
     7490   DEFINE VARIABLE ncrpg-pfx                    as character         no-undo init "24":U .
     7491   DEFINE VARIABLE ncrpg-frmt                   as character         no-undo init "EAN13" .
     7492   define variable ncr-save-param               as character         no-undo init 'no'.
     7493   DEFINE VARIABLE txfixnum                     as INTEGER           no-undo .
     7494   DEFINE VARIABLE rnd-znak                     as integer           no-undo init 2 .
     7495   DEFINE VARIABLE amntdisc                     as integer           no-undo .
     7496   DEFINE VARIABLE how-temp-disc                as character         no-undo .
     7497   DEFINE VARIABLE how-pcnt-kat                 as character         no-undo .
     7498   DEFINE VARIABLE discnt-to-send               as character         no-undo .
     7499   define variable v-is-restaurant              as logical no-undo .
     7500   define variable cd-vat                       as integer           no-undo .
     7501   define variable cdtaxlst                     as character         no-undo .
     7502   define variable v-20-part1 as integer no-undo init 2621.
     7503   define variable v-record as character no-undo .
     7504   define variable dr-list as character no-undo .
     7505   define variable drgdsrank as character no-undo .
     7506   define buffer buf_currency for ub.currency.
     7507   define buffer buf_producer for ub.clients.
     7508   define buffer buf_dis-rule for ub.dis-rule.
     7509   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     7510   def var vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7511   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7512   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7513   procedure create-dis-rule :
     7514   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7515   define input parameter p-tree as logical no-undo .
     7516   define buffer buf_dis-rule for ub.dis-rule.
     7517   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7518   define buffer term_dis-rule for ub.dis-rule.
     7519   define buffer term_dis-time-rule for ub.dis-time-rule.
     7520   define buffer root_cash-dis-rule for cash-dis-rule.
     7521   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7522   define buffer term_cash-dis-rule for cash-dis-rule.
     7523   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7524     do
     7525     on error undo, return error
     7526     :
     7527       find first root_cash-dis-rule no-lock where                                                         ~
     7528                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7529       if not available root_cash-dis-rule then do:
     7530         find first buf_dis-rule no-lock where
     7531                   buf_dis-rule.rule-num = p-rule-num no-error.
     7532         if available buf_dis-rule then do:
     7533           if buf_dis-rule.time-rule-num <> 0 then do:
     7534             find first buf_dis-time-rule no-lock where
     7535                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7536           end.
     7537           create root_cash-dis-rule.
     7538           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7539           if available buf_dis-time-rule then do:
     7540             find first root_cash-dis-time-rule no-lock where
     7541                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7542             if not available root_cash-dis-time-rule then do:
     7543               create root_cash-dis-time-rule.
     7544               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7545             end.
     7546           end.
     7547           else do:
     7548             assign
     7549             root_cash-dis-rule.time-rule-num = 0.
     7550           end.
     7551           if buf_dis-rule.uniq-field <> "":U then do:
     7552             for each term_dis-rule no-lock where
     7553                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7554               if term_dis-rule.time-rule-num <> 0 then do:
     7555                 find first term_dis-time-rule no-lock where
     7556                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7557               end.
     7558               create term_cash-dis-rule.
     7559               buffer-copy term_dis-rule to term_cash-dis-rule.
     7560               if term_dis-rule.time-rule-num = 0
     7561               or available term_dis-time-rule
     7562               or root_cash-dis-rule.time-rule-num = 0
     7563               then do:
     7564                 if available term_dis-time-rule then do:
     7565                   find first term_cash-dis-time-rule no-lock where
     7566                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7567                   if not available term_cash-dis-time-rule then do:
     7568                     create term_cash-dis-time-rule.
     7569                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7570                   end.
     7571                 end.
     7572               end.
     7573             end.
     7574           end.
     7575         end.
     7576       end.
     7577     end.
     7578   end procedure.
     7579   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7580   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7581   function ncr-amnt-disc returns character (
     7582     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7583   define variable v-result as character no-undo .
     7584   define variable ii as integer no-undo .
     7585   define variable v-entry as character no-undo extent 3.
     7586   for each cash-dis-rule  no-lock where
     7587         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7588     assign
     7589     ii = ii + 1
     7590     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7591                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7592     .
     7593   end.
     7594   if v-entry[2] = "":U then
     7595   assign
     7596   v-entry[2] = v-entry[1]
     7597   .
     7598   if v-entry[3] = "":U then
     7599   assign
     7600   v-entry[3] = v-entry[2]
     7601   .
     7602   assign
     7603   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7604   .
     7605   return v-result.
     7606   END FUNCTION.
     7607   function ncr-date-disc returns character (
     7608     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7609   define variable v-result as character no-undo .
     7610   define variable ii as integer no-undo .
     7611   define variable v-entry as character no-undo extent 3.
     7612   for each cash-dis-rule  no-lock where
     7613         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7614       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7615     assign
     7616     ii = ii + 1
     7617     v-entry[ii] =
     7618                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7619                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7620                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7621                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7622                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7623                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7624                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7625   end.
     7626   if v-entry[2] = "":U then
     7627   assign
     7628   v-entry[2] = v-entry[1]
     7629   .
     7630   if v-entry[3] = "":U then
     7631   assign
     7632   v-entry[3] = v-entry[2]
     7633   .
     7634   assign
     7635   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7636   .
     7637   return v-result.
     7638   END FUNCTION.
     7639   function ncr-temp-disc returns character (
     7640     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7641   define variable v-result as character no-undo .
     7642   define variable ii as integer no-undo .
     7643   define variable v-entry as character no-undo extent 3.
     7644   define variable v-dec as decimal no-undo .
     7645   define variable v-disc-price-sale as decimal no-undo .
     7646   define variable v-pdf-id as integer no-undo .
     7647   define variable v-pdf-db-num as integer no-undo .
     7648   define buffer buf_cash-dis-rule for cash-dis-rule.
     7649   find first buf_cash-dis-rule where
     7650            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7651   if not available buf_cash-dis-rule then return "":U.
     7652   if buf_cash-dis-rule.templ-rl-root <> 29
     7653   and buf_cash-dis-rule.templ-rl-root <> 86
     7654   then do:
     7655     assign
     7656     v-entry[1] =
     7657     "000"                                                   +
     7658     "0"                                                     +
     7659     "0000"                                                  +
     7660     "2359"                                                     +
     7661      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7662      .
     7663   end.
     7664   else do:
     7665     for each cash-dis-rule  no-lock where
     7666           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7667         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7668       case cash-dis-rule.value-type:
     7669         when integer('1':U) then do:
     7670           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7671         end.
     7672         when integer('12':U) then do:
     7673           find first cash-gds-discnt where
     7674                     cash-gds-discnt.b-code = cash-gds.b-code
     7675                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7676                 and cash-gds-discnt.obj-type = 'маг':U
     7677                 and cash-gds-discnt.obj-code = i-obj-code
     7678                 no-error.
     7679           if not available cash-gds-discnt then do:
     7680             v-dec = cash-gds.price-sale.
     7681           end.
     7682           else do:
     7683             assign
     7684             v-dec = cash-gds-discnt.discnt-value
     7685             .
     7686           end.
     7687         end.
     7688         otherwise do:
     7689           v-dec = cash-gds.price-sale.
     7690         end.
     7691       end case.
     7692       assign
     7693       ii = ii + 1
     7694       v-entry[ii] =
     7695                     "000"                                                   +
     7696                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7697                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7698                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7699                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7700                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7701                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7702                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7703                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7704                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7705                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7706                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7707       .
     7708   if ii = 3 then leave.
     7709     end.
     7710   end.
     7711   if v-entry[2] = "":U then
     7712   assign
     7713   v-entry[2] = v-entry[1]
     7714   .
     7715   if v-entry[3] = "":U then
     7716   assign
     7717   v-entry[3] = v-entry[2]
     7718   .
     7719   assign
     7720   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7721   .
     7722   return v-result.
     7723   END FUNCTION.
     7724   function ncr-d-rank returns character (
     7725     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7726   define variable v-result as character no-undo .
     7727   define variable ii as integer no-undo .
     7728   do ii = 1 to length(p-d-rank):
     7729     CASE substr(p-d-rank, ii, 1):
     7730       when "X":U then do:
     7731         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7732       end.
     7733       when "T":U then do:
     7734         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7735       end.
     7736       when "D":U then do:
     7737         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7738       end.
     7739     END CASE.
     7740     if v-result <> "":U then LEAVE.
     7741   end.
     7742   if v-result = "":U then v-result = chr(32).
     7743   return v-result.
     7744   END FUNCTION.
     7745   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7746       define variable v-upper-code as int no-undo.
     7747       define variable v-value as character no-undo.
     7748       define variable v-type as character no-undo.
     7749       define buffer lc_gds-grp for ub.gds-grp.
     7750       define buffer lc_goods for ub.goods.
     7751      if p-gds-code <> 0 then do:
     7752       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7753       v-upper-code = lc_goods.grp-code.
     7754       do while v-upper-code > 0 :
     7755           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7756           run ggoattr-value(
     7757             input lc_gds-grp.node-code,
     7758             input 0,
     7759             input "",
     7760             input 0,
     7761             input 'ban-sales-via-cd':U,
     7762             output v-value,
     7763             output v-type
     7764           ).
     7765          if v-value = "yes" then
     7766             return true.
     7767          else
     7768          do:
     7769             run ggoattr-value(
     7770                input lc_gds-grp.node-code,
     7771                input shop.host-code,
     7772                input "",
     7773                input 0,
     7774                input 'ban-sales-via-cd':U,
     7775                output v-value,
     7776                output v-type
     7777                ).
     7778             if v-value = "yes" then
     7779                return true.
     7780             else
     7781             do:
     7782                run ggoattr-value(
     7783                   input lc_gds-grp.node-code,
     7784                   input shop.host-code,
     7785                   input 'маг':U,
     7786                   input i-obj-code,
     7787                   input 'ban-sales-via-cd':U,
     7788                   output v-value,
     7789                   output v-type
     7790                   ).
     7791                if v-value = "yes" then
     7792                   return true.
     7793                else v-upper-code = lc_gds-grp.upper-code.
     7794             end .
     7795          end.
     7796         end.
     7797       end.
     7798   end.
     7799   FUNCTION convert-tax-code returns integer
     7800                                             ( input p-rate-code as integer
     7801                                              ,input p-cdtaxlst  as character
     7802                                             ) :
     7803   define variable jj as integer no-undo .
     7804     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7805       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7806         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7807       end.
     7808     end.
     7809   END FUNCTION.
     7810   FUNCTION convert-maria-tax-code returns character
     7811                                             ( input p-vat-rate-code as integer
     7812                                              ,input p-slt-rate-code as integer
     7813                                              ,input p-cdtaxlst  as character
     7814                                             ) :
     7815   define variable jj as integer no-undo .
     7816   define variable aa as character no-undo extent 8.
     7817   define variable v-return-value as character no-undo .
     7818     do jj = 1 to 8:
     7819       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7820         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7821           aa[jj] = '1'.
     7822         end.
     7823         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7824           aa[jj] = '1'.
     7825         end.
     7826       end.
     7827       if aa[jj] = '':U then aa[jj] = '0'.
     7828       v-return-value = aa[jj] + v-return-value.
     7829     end.
     7830   return v-return-value.
     7831   END FUNCTION.
     7832   FUNCTION convert-maria-tax-code-2 returns integer
     7833                                             ( input p-rate-code as integer
     7834                                              ,input p-cdtaxlst  as character
     7835                                             ) :
     7836   define variable jj as integer no-undo .
     7837   define variable v-return-value as integer no-undo .
     7838     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7839       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7840         return jj.
     7841       end.
     7842     end.
     7843   return 0.
     7844   END FUNCTION.
