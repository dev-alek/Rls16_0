    11603     define variable vBarCode2 as int no-undo.
    11604     if available (ub.prod-bc) then do:
    11605       if cash-gds.cli-base-rate eq 1
    11606       then do:
    11607          v-i-cli-qnty = 999999999.
    11608          for each buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11609                                     and buf_bar-code_cl.cli-base-rate ne cash-gds.cli-base-rate
    11610          no-lock:
    11611            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    11612            if v-i-cli-qnty =  buf_bar-code_cl.cli-base-rate
    11613            then
    11614               vBarCode1 = buf_bar-code_cl.b-code.
    11615          end.
    11616          if vaction = "D" and
    11617             v-i-cli-qnty = 999999999
    11618          then do:
    11619             assign
    11620                v-i-cli-qnty = cash-gds.cli-base-rate
    11621                vBarCode1 = cash-gds.main-prt-b-code
    11622                .
    11623          end.
    11624       end.
    11625       else do:
    11626          v-i-cli-qnty = 999999999.
    11627          for first buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11628                                     and buf_bar-code_cl.cli-base-rate eq 1
    11629          no-lock:
    11630            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    11631            vBarCode2 = buf_bar-code_cl.b-code.
    11632          end.
    11633          if vaction = "D" and
    11634             v-i-cli-qnty = 999999999
    11635          then do:
    11636             assign
    11637                v-i-cli-qnty = cash-gds.cli-base-rate
    11638                vBarCode2 = cash-gds.main-prt-b-code
    11639                .
    11640          end.
    11641       end.
    11642       if vGdsTabak then do:
    11643          block-cli:
    11644          do v-i-cli = 1 to 2:
    11645            if (      v-i-cli-qnty eq 999999999
    11646                  and v-i-cli eq 2
    11647                  and cash-gds.cli-base-rate eq 1  )
    11648               or (   v-i-cli-qnty eq 999999999
    11649                  and v-i-cli eq 1
    11650                  and cash-gds.cli-base-rate ne 1  )
