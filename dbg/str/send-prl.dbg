    11563           end.
    11564           find first bb_goods where bb_goods.gds-code = cash-gds.gds-code no-lock no-error .
    11565           run bgelib-tag-put in this-procedure ( input 3, input "IMarkVolume" , input string(bb_goods.ms-base), input 1 ).
    11566           run bgelib-tag-put in this-procedure ( input 3, input "IMarkQnty" , input string(cash-gds.cli-base-rate), input 1 ).
    11567           run bgelib-tag-put in this-procedure ( input 3, input "IMarkAlc" ,    input string(bb_goods.proof), input 1 ).
    11568           run bgelib-tag-close in this-procedure ( input 2, input "ItemMarkCode").
    11569       end.
    11570     if vaction = "U":U then do:
    11571       run bgelib-tag-open in this-procedure ( input 2, input "Item", input substitute("ctrl='&1' tms='&2' code='&3'", 'FREE':u, OS2-time, cash-gds.main-prt-b-code)).
    11572       run bgelib-tag-put in this-procedure ( input 3, input "ItemLock"  , input string(0), input 1 ).
    11573       run bgelib-tag-close in this-procedure ( input 2, input "Item").
    11574     end.
    11575     if vaction = "D":U then return.
    11576   for each buf_cash-gds no-lock where
    11577             buf_cash-gds.main-prt-b-code = cash-gds.main-prt-b-code
    11578         AND buf_cash-gds.obj-type = 'маг':U
    11579         AND buf_cash-gds.obj-code = abs(i-obj-code)
    11580             :
    11581      if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0 and buf_cash-gds.b-str = "" and ub.shop.cd-sc-base  then NEXT.
    11582      if (ub.shop.cd-loc-base = no and buf_cash-gds.is-main-code = yes) then next.
    11583      v-IBCType = 0 .
