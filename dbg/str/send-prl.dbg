    10239   _price-list:
    10240   FOR EACH ub.price-list NO-LOCK WHERE
    10241            ub.price-list.doc-num = p-doc.doc-num use-index doc-gds :
    10242       if NOT ub.price-list.main-price then NEXT _Price-list.
    10243       assign
    10244         v-count = v-count + 1
    10245       .
    10246       FIND FIRST ub.goods WHERE
    10247                  ub.goods.prod-type = ub.price-list.prod-type AND
    10248                  ub.goods.prod-code = ub.price-list.prod-code AND
    10249                  ub.goods.artic     = ub.price-list.artic NO-LOCK .
    10250       if check-ban-sales-via-cd(ub.goods.gds-code) then next.
    10251       if v-count modulo 10 = 0 then do:
    10252         run show-counter in p-log-handle .
    10253         run write-counter in p-log-handle (substitute("Обработано: &1. Подготовка данных - товар &2 &3&4"
    10254                                             , v-count
    10255                                             , goods.artic
    10256                                             , goods.prod-type
    10257                                             , goods.prod-code)) no-error.
