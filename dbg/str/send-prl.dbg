     7930   define buffer b-code for code.
     7931   if action = "U" then do:
     7932     if loc-bar-code.stts = Integer('79':U) then return.
     7933       for-price = ?.
     7934       assign
     7935       for-price = ub.price-list.price-sale no-error.
     7936   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7937   def var plist-unit-cli  like ub.bar-code.unit-cli.
     7938   do while true:
     7939     find first buf_price-list no-lock where
     7940                buf_price-list.doc-num    = ub.price-list.doc-num AND
     7941                buf_price-list.b-code     = LOC-BAR-CODE.B-CODE AND
     7942                buf_price-list.price-type = "" no-error.
     7943     if available buf_price-list then do:
     7944       assign
     7945       FOR-PRICE = buf_price-list.PRICE-SALE
     7946       plist-unit-cli = loc-bar-code.unit-cli
     7947       .
     7948       LEAVE.
     7949     end.
     7950     if LOC-bar-code.unit-cli <> LOC-GOODS.UNIT-BASE then do:
     7951       find first buf_BAR-CODE no-lock WHERE
     7952                 buf_BAR-CODE.GDS-CODE    = loc-bar-code.gds-code AND
     7953                 buf_BAR-CODE.node-code   = LOC-BAR-CODE.node-code AND
     7954                 buf_bar-code.part-code   = loc-bar-code.part-code AND
     7955                 buf_bar-code.in-code = loc-bar-code.in-code AND
     7956                 buf_bar-code.unit-cli = loc-goods.unit-base No-ERROR.
     7957       IF AVAIL buf_bar-code then do:
     7958         find first buf_price-list no-lock where                             buf_price-list.doc-num    = ub.price-list.doc-num AND                             buf_price-list.b-code     = buf_bar-code.B-CODE AND                             buf_price-list.price-type = ""  no-error.                             if avail buf_price-list then do:                               assign                               FOR-PRICE = buf_price-list.PRICE-SALE                               plist-unit-cli = buf_bar-code.unit-cli.                               LEAVE.                             end.
     7959       end.
     7960     END.
     7961     IF loc-bar-code.in-code <> "" then do:
     7962       find first buf_BAR-CODE no-lock where
     7963                   buf_BAR-CODE.GDS-CODE    = loc-bar-code.gds-code AND
     7964                   buf_BAR-CODE.node-code   = LOC-BAR-CODE.node-code AND
     7965                   buf_bar-code.part-code   = "" AND
     7966                   buf_bar-code.in-code = "" AND
     7967                   buf_bar-code.unit-cli = loc-goods.unit-base No-ERROR.
     7968         IF AVAIL buf_bar-code then do:
     7969           find first buf_price-list no-lock where                             buf_price-list.doc-num    = ub.price-list.doc-num AND                             buf_price-list.b-code     = buf_bar-code.B-CODE AND                             buf_price-list.price-type = ""  no-error.                             if avail buf_price-list then do:                               assign                               FOR-PRICE = buf_price-list.PRICE-SALE                               plist-unit-cli = buf_bar-code.unit-cli.                               LEAVE.                             end.
     7970         END.
     7971     END.
     7972     if NOT avail buf_price-list then LEAVE.
     7973   END.
     7974   error-status:error = no.
     7975       if error-status:error then do:
     7976           return error.
     7977       end.
     7978       if return-value = "error" then do:
     7979           if for-price = ? then do:
     7980             return.
     7981           end.
     7982           if not g#news
     7983           and not g#auto
     7984           and not g#esys
     7985           then
     7986           message prichina view-as alert-box ERROR.
     7987           return error.
     7988       end.
     7989       else if (for-price = ? or for-price = 0) then do:
     7990         if v-is-restaurant and v-is-null-price  then do:
     7991           assign
     7992           for-price = 0.
     7993         end.
     7994         else do:
     7995           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7996                                                  ,input 'null-price':U
     7997                                                  ,output v-gds-null-price
     7998                                                  ,output v-type) no-error.
     7999           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     8000           return "NEXT".
     8001         end.
     8002       end.
     8003     end.
     8004     else do:
     8005           for-price = 0.
     8006     end.
     8007   for-price =  (if loc-bar-code.unit-cli = plist-unit-cli
     8008                 then
     8009                 for-price
     8010                 else
     8011                 round-m( loc-bar-code.cli-base-rate * for-price, rnd-znak)
     8012                 ).
     8013   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     8014   start-paket = no.
     8015   if not avail cash-gds then do:
     8016   create cash-gds.
