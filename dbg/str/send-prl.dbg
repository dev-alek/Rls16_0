     8316                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8317                                             ,input ?
     8318                                             ,output v-disc-price-sale
     8319                                             ,output v-pdf-id
     8320                                             ,output v-pdf-db-num ) no-error.
     8321         if error-status:error
     8322         or v-disc-price-sale = 0
     8323         or v-disc-price-sale = ?
     8324         then do:
     8325         end.
     8326         else do:
     8327           find first  cash-gds-discnt where
     8328                     cash-gds-discnt.b-code = cash-gds.b-code
     8329                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8330                   and cash-gds-discnt.obj-type = parobj-type
     8331                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8332           if not available cash-gds-discnt then do:
     8333             find first  cash-gds-discnt where
