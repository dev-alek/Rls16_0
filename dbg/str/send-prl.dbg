     8362                                             ,input 'маг':U
     8363                                             ,input i-obj-code
     8364                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8365                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8366                                             ,input ?
     8367                                             ,output v-disc-price-sale
     8368                                             ,output v-pdf-id
     8369                                             ,output v-pdf-db-num ) no-error.
     8370         if error-status:error
     8371         or v-disc-price-sale = 0
     8372         or v-disc-price-sale = ?
     8373         then do:
     8374         end.
     8375         else do:
     8376           find first  cash-gds-discnt where
     8377                     cash-gds-discnt.b-code = cash-gds.b-code
     8378                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8379                   and cash-gds-discnt.obj-type = parobj-type
     8380                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8381           if not available cash-gds-discnt then do:
     8382             find first  cash-gds-discnt where
     8383                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8384             if not available cash-gds-discnt then do:
     8385               create cash-gds-discnt.
     8386               assign
     8387               cash-gds-discnt.crf = crgd + 1.
     8388             end.
     8389             crgd = crgd + 1.
     8390             assign
     8391             cash-gds-discnt.b-code = cash-gds.b-code
     8392             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8393             cash-gds-discnt.obj-type = parobj-type
     8394             cash-gds-discnt.obj-code = parobj-code
     8395             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8396             release cash-gds-discnt.
     8397           end.
     8398         end.
     8399       end.
     8400     end.
     8401   end.
     8402   END PROCEDURE.
