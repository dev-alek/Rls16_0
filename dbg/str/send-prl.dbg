    11662                                                                  then vBarCode2
    11663                                                                  else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
    11664                                                                  then vBarCode1
    11665                                                                  else cash-gds.main-prt-b-code )
    11666                                                 , input 1 ).
