    10307   procedure ibm-gdsc :
    10308   define input  parameter p-zeros         as logical no-undo .
    10309   define output parameter IBM-good-code as character no-undo .
    10310   define output parameter IBM-good-code-2 as character no-undo .
    10311   define output parameter IBM2-short      as character no-undo .
    10312   define variable v-delim as character no-undo .
    10313   define variable v-format-str-16 as character no-undo .
    10314     do
    10315     on error undo, return error
    10316     :
    10317       if p-zeros then do:
    10318         assign
    10319         v-delim = '0'
    10320         v-format-str-16 =  "9999999999999999"
    10321         .
    10322       end.
    10323       else do:
    10324         assign
    10325         v-delim = chr(32)
    10326         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10327         .
    10328       end.
    10329       if cash-gds.b-str = "" then do:
    10330         assign
    10331         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10332         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10333         or cash-gds.unit-base <> cash-gds.unit-cli
    10334         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10335         then
    10336         do:
    10337           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10338               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10339             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10340             iBM2-short = bar_code.
    10341             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10342           END.
    10343           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10344               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10345             IBM-good-code-2 = b_code.
    10346           end.
    10347         end.
    10348       end.
    10349       else do:
    10350         IBm-good-code =
    10351         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10352           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10353            or
    10354            cash-gds.bc-on-type = 'pglc':U)
    10355         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10356         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10357       end.
    10358     end.
    10359   end procedure.
    10360   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10361   procedure ncr-gdsc :
