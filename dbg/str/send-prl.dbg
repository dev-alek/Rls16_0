     4455   procedure disrules-get-interface-form :
     4456   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4457   define output parameter p-form-name as character no-undo .
     4458   define buffer buf_temp-drt-prop for temp-drt-prop.
