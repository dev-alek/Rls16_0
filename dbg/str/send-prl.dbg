     3534   procedure alienini-getkey :
     3535   define input parameter i-filename as char.
     3536   define input parameter i-section as char.
     3537   define input parameter i-key as char.
     3538   define output parameter o-value as char.
     3539   define variable EntryPointer as integer no-undo.
     3540   define variable mem1 as memptr no-undo.
     3541   define variable mem2 as memptr no-undo.
     3542   define variable mem1size as integer no-undo.
     3543   define variable mem2size as integer no-undo.
     3544   define variable ii       as integer    no-undo.
     3545   define variable cbReturnSize  as integer    no-undo.
     3546   assign
     3547   set-size(mem1)  = 4000
     3548   mem1size = 4000.
     3549   if i-key = "" then EntryPointer = 0.
     3550   else do:
     3551     assign
     3552     set-size(mem2) = 128
     3553     mem2size = 128
     3554     EntryPointer = get-pointer-value(mem2)
     3555     put-string(mem2, 1) = i-key.
     3556   end.
     3557   run getprivateprofilestringA
     3558                                 (i-section,
     3559                                  EntryPointer,
     3560                                  "",
     3561                                  get-pointer-value(mem1),
     3562                                  input mem1size,
     3563                                  i-filename,
     3564                                  output cbReturnSize).
     3565   do ii = 1 to cbReturnSize:
     3566     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3567                  then o-value + ","
     3568                  else o-value + chr(get-byte(mem1, ii)).
     3569   end.
     3570     set-size(mem1) = 0.
     3571     set-size(mem2) = 0.
     3572   end procedure.
     3573   procedure alienini-putkey :
     3574   define input parameter i-filename as char.
     3575   define input parameter i-section as char.
     3576   define input parameter i-key as char.
     3577   define input parameter i-value as char.
     3578   define variable cbReturnSize as integer.
     3579   run writeprivateprofilestringA
     3580                                  (i-section,
     3581                                   i-key,
     3582                                   i-value,
     3583                                   i-filename,
     3584                                   output cbReturnSize ).
     3585   end procedure.
     3586   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3587     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3588     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3589     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3590     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3591     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3592     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3593     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3594   END PROCEDURE.
     3595   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3596     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3597     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3598     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3599     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3600     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3601   END PROCEDURE.
