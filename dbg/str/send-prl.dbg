     1743   procedure gds-attr_check-code-dt-seasons :
     1744     define input  parameter p-code     like ub.goods.gds-code   no-undo .
     1745     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     1746     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
