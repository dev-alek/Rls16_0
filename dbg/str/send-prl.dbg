    11688              run bgelib-tag-put in this-procedure ( input 3, input "IBC_EMRC"
    11689                                             , input  v-attr-emrc, input 1 ).
    11690              run bgelib-tag-put in this-procedure ( input 3, input "IBCUnitFactor"
    11691                                             , input  string(if v-i-cli eq 1 and cash-gds.cli-base-rate ne 1
    11692                                                             then 1
    11693                                                             else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
    11694                                                             then v-i-cli-qnty
    11695                                                             else cash-gds.cli-base-rate), input 1 ).
    11696            end.
    11697            run bgelib-tag-close in this-procedure ( input 2, input "ItemBarCode") .
    11698          end.
    11699       end.
    11700       else do:
    11701         v-cli-base = if cash-gds.cli-base-rate = 1 then "01" else "02".
    11702         run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    11703                                             , (if vaction = "U"
    11704                                                then (if buf_cash-gds.bc-on eq yes then "ADD":U else "DEL":U)
