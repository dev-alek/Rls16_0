    11680                                                   , input string( if v-i-cli eq 1 and cash-gds.cli-base-rate ne 1
    11681                                                       then cash-gds.price-sale / cash-gds.cli-base-rate
    11682                                                       else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
