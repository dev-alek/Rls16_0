    10822              (
    10823               (cash-dis-time-rule.date-from < today)
    10824               or
    10825               (cash-dis-time-rule.date-from = 12/31/1989)
    10826              )
    10827             and
    10828             (
    10829              (cash-dis-time-rule.date-to >= today)
    10830              or
    10831              (cash-dis-time-rule.date-to = 12/31/1989)
    10832             )
    10833            ) then do:
    10834            temp-disc-dec = ?.
    10835         end.
    10836         else do:
    10837           assign
    10838           temp-disc-dec = 0
    10839           .
    10840         end.
    10841       end.
    10842       else do:
    10843         temp-disc-dec = ?.
    10844       end.
    10845       if temp-disc-dec = ? then do:
