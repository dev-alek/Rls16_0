    12971       , output v-xml-file-name
    12972       , output v-xml-file-name-path
    12973       , output v-log-file-name
    12974       , output v-locked
    12975   ).
    12976   run write-log-and-file in p-log-handle (
    12977         input 1
    12978       , input log-file-name
    12979       , input 1
    12980       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    12981                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    12982                         )
    12983                                         ).
    12984   run write-log-and-file in p-log-handle (
    12985         input 1
    12986       , input log-file-name
    12987       , input 1
    12988       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
    12989                                         ).
    12990   assign
    12991   v-obj-list = 'маг':U + string(i-obj-code)
    12992   .
    12993   run xml-cd-write-header in this-procedure (
    12994         input v-xml-file-name
    12995       , input v-xml-file-name-path
    12996       , input 'data'
    12997       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    12998       , input v-obj-list
    12999       , input (
    13000                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    13001                   then (if for-cash-desk.autonomy = integer('0':U)
    13002                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    13003                         else ("КМ"   )
    13004                         )
    13005                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    13006                   )
    13007               )
    13008       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    13009   ).
    13010   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    13011   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    13012     end.
    13013     when 'IBM':U
    13014     then do:
    13015   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13016   if for-cash-desk.cash-os = ""
    13017   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    13018   then NEXT.
    13019   assign
    13020   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
    13021               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    13022   Cash-DOS = NOT CASH-OS2
    13023   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
    13024   v-dir-remote-tmp = v-remote + "tmp":U
    13025   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
    13026   .
    13027   if for-cash-desk.remote = 1 then do:
    13028     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
    13029       if error-status:error then do:
    13030         run write-log-and-file in p-log-handle (
    13031               input 1
    13032             , input log-file-name
    13033             , input 1
    13034             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    13035                               "и/или попытка его создания не удалась"
    13036                               ,v-dir-remote-tmp
    13037                               ,for-cash-desk.cash-num
    13038                               ,chr(10)
    13039                               )
    13040                                               ).
    13041         NEXT.
    13042     end.
    13043     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
    13044       if error-status:error then do:
    13045         run write-log-and-file in p-log-handle (
    13046               input 1
    13047             , input log-file-name
    13048             , input 1
    13049             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    13050                               "и/или попытка его создания не удалась"
    13051                               ,v-dir-remote
    13052                               ,for-cash-desk.cash-num
    13053                               ,chr(10)
    13054                               )
    13055                                               ).
    13056         NEXT.
    13057       end.
    13058   end.
    13059   output stream IBMStream
    13060   to value( (if for-cash-desk.remote = 1
    13061               then (v-dir-remote-tmp + chr(47) + "fl":U)
    13062               else out) + fname + '.dat' ) convert target "ibm866".
    13063   OS2-time =       ( if Cash-OS2 then
    13064                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
    13065                         else "" )
    13066   .
    13067     end.
    13068     when 'OMRON-NEW':U then do:
    13069   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13070   assign
    13071   v-versiond = decimal(for-cash-desk.version)
    13072   no-error .
    13073   if error-status:error
    13074   or v-versiond < 0 then do:
    13075     run write-log-and-file in p-log-handle (
    13076           input 1
    13077         , input log-file-name
    13078         , input 1
    13079         , input  substitute("Неверное значение поля <ВЕРСИЯ> &1 для кассы типа &2 № &3 в справочнике касс&4" +
    13080                 "Значение версии может быть только десятичным числом > 0"
    13081                 ,for-cash-desk.version
    13082                 ,for-cash-desk.pos-type
    13083                 ,for-cash-desk.cash-num
    13084                 ,chr(10)
    13085                 ) ).
    13086     return error .
    13087   end.
    13088     assign
    13089     out = (for-cash-desk.addr-path + "out\" )
    13090     fname = 'plu'.
    13091     output to value( out + fname + '.dat' ) convert target "ibm866".
    13092     end.
    13093     when 'IPC-Servis+':U then do:
    13094   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13095     assign
    13096     out = for-cash-desk.addr-path + "in\"
    13097     fname = string(year(today) modulo 10) + string(month(today),"99") +
    13098                   string(day(today),"99") + string(next-value(s-file-num, ub),"999") .
    13099     output stream plucash to value(
    13100     string( session:temp-directory + "plu" + string( var-report-num ) ) + '.plu'
    13101                                                       )
    13102     convert target "ibm866".
    13103     output stream bar to value(
    13104     string( session:temp-directory + "bar" + string( var-report-num ) ) + '.bar'
    13105                                                       )
    13106     convert target "ibm866".
    13107     end.
    13108     when 'pricecheck-Servis+':U then do:
    13109     output stream plucash to value(
    13110     string( session:temp-directory + "plu" + string( var-report-num ) ) + '.plu')  convert target "1251".
    13111     output stream bar to value(
    13112     string( session:temp-directory + "bar" + string( var-report-num ) ) + '.bar' )  convert target "1251".
    13113     end.
    13114     when 'NCR-GM':U then do:
    13115   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13116     fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
    13117     output stream IBMStream
    13118     to value( out + fname + '.dat' ) convert target "ibm866".
    13119     .
    13120     end.
    13121     when 'NCR-AS@R':U then do:
    13122   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13123     fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
    13124     output stream IBMStream
    13125     to value( out + fname + '.dat' ) convert target "ibm866".
    13126     .
    13127     end.
    13128     when 'MARIA':U then do:
    13129   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13130   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
    13131       v-record = fill( chr(63) + chr(4), 7).
    13132     end.
    13133   END CASE.
    13134     FOR EACH cash-gds WHERE cash-gds.crf <= cr No-LOCK :
    13135         RUN putc-gds( buffer for-cash-desk, input for-cash-desk.pos-type, input for-cash-desk.version, input for-cash-desk.cash-os ).
    13136     END .
    13137   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13138   case for-cash-desk.pos-type:
    13139       when 'IBM-XML':U or when 'Autotank':U
    13140         or
    13141        when 'InfoKiosk':U
    13142         or
    13143        when 'Autotank':U
    13144     then do:
    13145   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13146   output stream stmxmlout close.
    13147   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
    13148       , input 'data'
    13149   ).
    13150   run write-log-and-file in p-log-handle (
    13151         input 1
    13152       , input log-file-name
    13153       , input 1
    13154       , input substitute( "Данные выгружены в файл &1"
    13155                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
    13156                         )
    13157                                          ).
    13158   if (
    13159   not (g#news or g#auto or g#esys )
    13160   or
    13161   (
    13162   for-cash-desk.pos-type = 'MAGIA-XML':U
    13163   or
    13164     (for-cash-desk.pos-type = 'IBM-XML':U
    13165   or (for-cash-desk.pos-type = 'Autotank':U
    13166     and
    13167     for-cash-desk.autonomy = integer('2':U))
    13168     )))
    13169   then do:
    13170     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
    13171       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
    13172                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
    13173                   ( if action = 'U'
    13174                     then ('Ждите - ' + 'добавление товаров')
    13175                     else ('Ждите - ' + 'удаление товаров') ) +
    13176                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
    13177                     ' Подождите 15 сек ',
    13178                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
    13179                     'Подождите: касса обрабатывает запрос',
    13180                     15 ) no-error.
    13181       if error-status:error then do:
