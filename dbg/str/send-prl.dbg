     1087     index tax-code is unique primary tax-code
     1088     .
     1089   procedure tax-val :
     1090     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
     1091     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
     1092     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
     1093     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
     1094     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
     1095     define input  parameter       parunits-type like ub.units.type         no-undo.
     1096     define input  parameter       parrec-id     as recid                   no-undo.
     1097     define input  parameter       paris-log     as logical                 no-undo.
     1098     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
     1099     define input  parameter       vattaxcdvalue as integer                 no-undo.
     1100     define input  parameter       exctaxcdvalue as integer                 no-undo.
