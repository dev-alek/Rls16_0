    11462           run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(5), input 1 ).
    11463           run bgelib-tag-put in this-procedure ( input 4, input "IDCLimit", input string(- cash-dis-rule.discnt-value),  input 1 ).
    11464           run bgelib-tag-put in this-procedure ( input 4, input "IDCFactor", input string(cash-dis-rule.tot-sum),  input 1 ).
    11465         end.
    11466         else do:
    11467           case cash-dis-rule.value-type:
    11468             when integer('2':U) then do:
    11469               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(2), input 1 ).
    11470               run bgelib-tag-put in this-procedure ( input 4, input "IDCValue", input string(- cash-dis-rule.discnt-value * cash-gds.cli-base-rate),  input 1 ).
    11471             end.
