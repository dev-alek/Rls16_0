      372   define variable action as character no-undo .
      373   define variable p-doc-num like ub.price-doc.doc-num no-undo .
      374   define variable i-obj-code like ub.clients.obj-code no-undo.
      375   define buffer p-doc for ub.price-doc .
      376   assign
      377   action = entry(1, p-parameter, chr(4))
      378   p-doc-num = entry(2, p-parameter, chr(4))
      379   i-obj-code = integer(entry(3, p-parameter, chr(4)))
      380   no-error
      381   .
      382   if error-status:error then return error .
      383   find first p-doc no-lock where
      384            p-doc.doc-num = p-doc-num no-error .
      385   if not available p-doc then return error.
      386   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387     run mainmenu_getcntxt in parparentproc
      388       (output v-cntxt-db-num
      389       ,output v-cntxt-userid
      390       ,output v-cntxt-level
      391       ,output v-cntxt-host-code-obj
      392       ,output v-cntxt-obj-type
      393       ,output v-cntxt-obj-code
      394       ,output v-cntxt-db-num-obj
      395       ,output v-cntxt-is-admin
      396       ) .
      397   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   def new shared var bc-frmt as character no-undo .
      399   def new shared var bc-pfx  as character no-undo .
      400   def var bc-par-type as character no-undo .
      401       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      402       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      403           do:
      404               message "Не задан или не верно задан ТИП собственного бар-кода!"
      405                   view-as alert-box ERROR TITLE "".
      406               return error.
      407           end.
      408       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      409       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      410           do:
      411               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      412                   view-as alert-box ERROR TITLE "".
      413               return error.
      414           end.
      415   PROCEDURE gen-bc:
      416     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      417     def output parameter full-b-code     as character init ""    no-undo .
      418   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419     define variable tmp-str4  as character no-undo.
      420     define variable tmp-num4  as character no-undo.
      421     define variable i4        as integer   no-undo.
      422     define variable sum4      as integer   no-undo.
      423     define variable len-code4 as integer   no-undo.
      424     define variable varcont4  as logical   initial yes no-undo.
      425     CASE bc-frmt :
      426       WHEN "EAN13" THEN do:
      427         assign
      428           tmp-str4 = string( internal-b-code, "999999999999" )
      429         .
      430       end.
      431       WHEN "EAN8" THEN do:
      432         assign
      433           tmp-str4 = string( internal-b-code, "9999999" )
      434         .
      435       end.
      436       OTHERWISE DO:
      437           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      438           view-as alert-box error.
      439           return error.
      440       END.
      441     END CASE.
      442     if varcont4 = yes then do:
      443       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      444       then do:
      445         message
      446           "Невозможно сформировать бар-код" SKIP
      447           "для товара с кодом: " internal-b-code
      448           view-as alert-box error title "подрезание кода".
      449         return error.
      450       end.
      451       else do:
      452         assign
      453           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      454           len-code4    = length( full-b-code )
      455         .
      456         define variable v-sum-char4 as character no-undo .
      457         assign
      458           sum4 = 0
      459         .
      460         do i4 = 1 to len-code4 by 2
      461         :
      462           assign
      463             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      464           .
      465           if v-sum-char4 < "0"
      466           or v-sum-char4 > "9"
      467           then do:
      468             message
      469               "Невозможно сформировать бар-код" skip
      470               "для товара с кодом: " internal-b-code skip
      471               view-as alert-box error title "подсчет контрольной суммы".
      472             return error.
      473           end.
      474           assign
      475             sum4 = sum4 + integer(v-sum-char4)
      476           .
      477         end.
      478         if varcont4 = yes then do:
      479           assign
      480             sum4 = sum4 * 3
      481           .
      482           do i4 = 2 to len-code4 by 2
      483           :
      484             assign
      485               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      486             .
      487             if v-sum-char4 < "0"
      488             or v-sum-char4 > "9"
      489             then do:
      490               message
      491                 "Невозможно сформировать бар-код" skip
      492                 "для товара с кодом: " internal-b-code skip
      493                 view-as alert-box error title "подсчет контрольной суммы".
      494               return error.
      495             end.
      496             assign
      497               sum4 = sum4 + integer(v-sum-char4)
      498             .
      499           end.
      500           if varcont4 = yes then do:
      501              if sum4 mod 10 = 0 then do:
      502                assign
      503                  full-b-code = full-b-code + '0'
      504                .
      505              end.
      506              else do:
      507                assign
      508                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      509                .
      510              end.
      511           end.
      512         end.
      513       end.
      514     end.
      515   END PROCEDURE.
      516   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
