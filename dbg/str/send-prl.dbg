     1133       define variable pr-list-recid    as recid     initial ? no-undo.
     1134       define variable varmes           as character no-undo.
     1135       define variable varfactorrtvalue as char      initial ? no-undo.
     1136       define variable varfactorrttype  as char      initial ? no-undo.
     1137       define variable is-petrolium     as logical no-undo.
     1138       define variable is-pieces        as logical no-undo.
     1139       define variable vargds-code      like ub.goods.gds-code no-undo.
     1140       define variable pargds-code      like ub.goods.gds-code no-undo.
     1141       define variable var-fact-order   as decimal no-undo .
     1142       define variable currate-code     like buf_tax-rate.rate-code no-undo .
     1143       define variable currate-name     like buf_tax-rate.rate-name no-undo .
     1144       define variable currate-gds-rc   as recid no-undo .
     1145       define variable v-today          as date no-undo .
     1146       define variable v-time           as integer no-undo .
     1147       for each buf_tt-tax:
     1148         delete buf_tt-tax.
     1149       end.
     1150       run cur-time in this-procedure(output v-today, output v-time).
     1151       run factord-end-day in this-procedure (input v-today, output var-fact-order).
     1152       if parartic     = ?
     1153       or parprod-type = ?
     1154       or parprod-code = ?
     1155       or parunit-base = ?
     1156       then do:
     1157         find first buf_goods no-lock
     1158           where recid(buf_goods) = parrec-id
     1159           no-error .
     1160       end.
     1161       else do:
     1162         find first buf_goods no-lock
     1163           where buf_goods.artic = parartic
     1164             and buf_goods.prod-type = parprod-type
     1165             and buf_goods.prod-code = parprod-code
     1166           no-error .
     1167       end.
     1168       if not available buf_goods then do:
     1169         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
     1170         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1171       end.
     1172       assign
     1173         parartic     = buf_goods.artic
     1174         parprod-type = buf_goods.prod-type
     1175         parprod-code = buf_goods.prod-code
     1176         parunit-base = buf_goods.unit-base
     1177         pargds-code  = buf_goods.gds-code
     1178       .
     1179       if parunits-type = ?
