     8180   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     8181   cash-gds.DepartID = v-fbr-obj-code
     8182   cash-gds.zp = (if v-is-null-price then 1 else 0)
     8183   cash-gds.node-code = loc-bar-code.node-code
     8184   cash-gds.taracode = for-taracode
