    12719         wd-option = 0
    12720         then   ncrdsc
    12721         else '0':U)
    12722        (if cash-gds.vat-code = ? or
    12723        cash-gds.vat-code > 7 then
    12724        "0"
    12725        else string(cash-gds.vat-code, "9"))
    12726       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12727       or (is-sc
    12728       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12729       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    12730       and  (cash-gds.taracode  <> '':u
    12731            or taracode-bc <> '')
    12732       then (if taracode-bc <> ''
    12733             then taracode-bc
    12734             else cash-gds.taracode)
    12735       else '00'
    12736       )
    12737       (if cash-gds.unit-cli begins "№"
    12738        then substring(cash-gds.unit-cli, 2, 2)
    12739        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    12740       "0010":U
    12741       "0000":U
    12742       chk_name
    12743       fill(chr(32), 4)
    12744       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12745       fill(chr(32), 8)
    12746       conf-par
    12747       replace(string( cash-gds.price-sale, "999999.99")
    12748              , ".":U, "":U
    12749              )
    12750       chr(10)
    12751       .
    12752       if pos-type = 'NCR-AS@R':U
    12753       and ncrdsc <> '0':U
    12754       and wd-option > 0
    12755       and cash-gds.std-discnt-rule > 0
    12756       then do:
    12757         run create-ncr-kat-discnt in this-procedure (
    12758                                                     input string(cash-gds.gds-code)
    12759                                                     ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12760                                                     ,input chk_name
    12761                                                     ,input (if action = 'D':U then 0 else cash-gds.std-discnt-rule)
    12762                                                     ,input ?
    12763                                                     ,input 'time-rule-num':U
    12764                                                     ,input ?
    12765                                                     ) no-error .
    12766       end.
    12767       ncr-disc-string = '':U.
    12768       if conf-par = "T":U then do:
    12769         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12770         if ncr-disc-string <> '':U then
    12771         PUT stream IBMstream unformatted
    12772         chr(32)
    12773         "T":U
    12774         chr(32)
    12775         IBM-good-code
    12776         chr(32)
    12777         chr(32)
    12778         ncr-disc-string
    12779         chr(10)
    12780         .
    12781       end.
    12782       if conf-par = "D":U then do:
    12783         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12784         if ncr-disc-string <> '':U then
    12785         PUT stream IBMstream unformatted
    12786         chr(32)
    12787         "D":U
    12788         chr(32)
    12789         IBM-good-code
    12790         chr(32)
    12791         chr(32)
    12792         ncr-disc-string
    12793         chr(10)
    12794         .
    12795       end.
    12796       if conf-par = "X":U then do:
    12797         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12798         if ncr-disc-string <> '':U then
    12799         PUT stream IBMstream unformatted
    12800         chr(32)
    12801         "X":U
    12802         chr(32)
    12803         IBm-good-code
    12804         chr(32)
    12805         chr(32)
    12806         ncr-disc-string
    12807         chr(10)
    12808         .
    12809       end.
    12810     end.
    12811     if pos-type = 'NCR-AS@R':U
    12812     and cash-gds.kat-discnt-rule <> 0
    12813     then do:
    12814       case how-pcnt-kat :
    12815         when 'pcnt-kat-pdf':U then do:
    12816             v-kat-discnt = cash-gds.price-sale.
    12817           end.
    12818         otherwise do:
    12819           v-kat-discnt = ?.
    12820         end.
    12821       end case.
    12822       run create-ncr-kat-discnt in this-procedure (
    12823                                                    input string(cash-gds.gds-code)
    12824                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12825                                                   ,input chk_name
    12826                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12827                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12828                                                   ,input 'time-rule-num':U
    12829                                                   ,input v-kat-discnt
    12830                                                   ) no-error .
    12831       if error-status:error then do:
    12832       end.
    12833     end.
    12834     if IBM-good-code = IBM-good-code-2 then leave do2.
    12835     assign
    12836     IBM-good-code = IBM-good-code-2
    12837     .
    12838   end.
    12839       end.
    12840     END CASE .
    12841   END PROCEDURE .
    12842   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12843   PROCEDURE   for-cash-cycle:
    12844   DEFINE VARIABLE fname-list as character no-undo .
    12845   DEFINE VARIABLE out-list as character no-undo .
    12846   DEFINE VARIABLE var-file-num as integer no-undo .
    12847   DEFINE VARIABLE v-dir-remote as character no-undo .
    12848   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
    12849   define variable v-plu as character no-undo .
    12850   define variable v-pl-code as integer no-undo .
    12851   define variable ss  as character no-undo .
    12852   define variable ss0  as character no-undo .
    12853   define variable v-temp-kat-file as character no-undo .
    12854   define variable v-kat-file as character no-undo .
    12855   define variable v-kat-file-save as character no-undo .
    12856   define variable v-updated-subject-dis-kat as logical no-undo .
    12857   define variable v-next as logical no-undo .
    12858   define variable v-cd-subject-code as character no-undo .
    12859   define variable v-cd-disc-string as character no-undo .
    12860   define variable v-versiond as decimal no-undo .
    12861   define variable v-maria-discnt-value as character no-undo .
    12862   define variable v-ii as integer no-undo .
    12863   define variable v-dop as character no-undo .
    12864   define variable v-gds-rule-num as integer no-undo .
    12865   define variable v-maria-rule-num as integer no-undo .
    12866   define buffer for-cash-desk for ub.cash-desk.
    12867   define buffer buf_cd-plu for ub.cd-plu.
    12868   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    12869   define buffer buf_cash-gds for cash-gds.
    12870   define buffer buf_dis-rule for ub.dis-rule.
    12871   define buffer buf_place for ub.place.
    12872   define buffer buf_pl-gds for ub.pl-gds.
    12873   FOR EACH for-cash-desk NO-LOCK WHERE
    12874           for-cash-desk.db-num = g#db-num AND
    12875           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12876           for-cash-desk.obj-code = i-obj-code AND
    12877    for-cash-desk.cash-on  = yes
    12878       BREAK
    12879       BY for-cash-desk.db-num
    12880       BY for-cash-desk.obj-code
    12881       BY for-cash-desk.pos-type
    12882       BY for-cash-desk.cash-on
    12883       BY for-cash-desk.cash-num
    12884       :
    12885     if LOOKUP(ub.cash-desk.pos-type,
    12886               ('NCR-GM':U + chr(44) +
    12887                'IBM-XML':U + chr(44) +
    12888                'MAGIA-XML':U + chr(44) +
    12889                'NCR-AS@R':U  + chr(44) +
    12890                'Autotank':U
    12891                  )) > 0
    12892     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    12893     if LOOKUP(ub.cash-desk.pos-type,
    12894               'MARIA':U
    12895                  ) > 0 then do:
    12896       if for-cash-desk.autonomy = integer('2':U) then do:
    12897         assign
    12898         v-cd-list-update = for-cash-desk.addr-path
    12899         v-cd-list-delete = for-cash-desk.addr-path
    12900         .
    12901         NEXT.
    12902       end.
    12903       else do:
    12904         if v-cd-list-update = '':U then nExt.
    12905       end.
    12906     end.
    12907     run write-log-and-file in p-log-handle (
    12908           input 1
    12909         , input log-file-name
    12910         , input 1
    12911         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
    12912                           )
    12913                                           ).
    12914   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12915   case for-cash-desk.pos-type:
    12916       when 'IBM-XML':U or when 'Autotank':U
    12917         or
    12918       when 'InfoKiosk':U
    12919         or
    12920       when 'Autotank':U
    12921     then do:
    12922   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12923   run xml-cd-filename in this-procedure (
    12924         input out
    12925       , output v-xml-file-name
    12926       , output v-xml-file-name-path
    12927       , output v-log-file-name
    12928       , output v-locked
    12929   ).
    12930   run write-log-and-file in p-log-handle (
    12931         input 1
    12932       , input log-file-name
    12933       , input 1
    12934       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    12935                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    12936                         )
    12937                                         ).
