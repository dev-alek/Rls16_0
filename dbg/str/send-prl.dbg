     2621                   end case.
     2622               end.
     2623           end.
     2624       end case.
     2625   end.
     2626   end .
     2627   procedure xmlchar-decode :
     2628   define input parameter p-in-string      as character        no-undo.
     2629   define output parameter p-out-string    as character        no-undo.
     2630       define variable v-position      as integer      no-undo.
     2631       define variable v-last-position as integer      no-undo.
     2632       define variable v-temp-integer  as integer      no-undo.
     2633       define variable v-current-char  as character    no-undo.
     2634       define variable v-next-char     as character    no-undo.
     2635       define variable v-success       as logical      no-undo.
     2636   do
     2637   on error undo, return error
     2638   :
     2639       assign
     2640           p-out-string = "":U
     2641           v-position   = 0
     2642       .
     2643       replace-cycle:
     2644       do while yes
     2645       on error undo, return error
     2646       :
     2647           assign
     2648               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2649           .
     2650           if v-last-position <= v-position
     2651           then do:
     2652               if v-position = 0
     2653               then do:
     2654                   assign
     2655                       p-out-string = p-in-string
     2656                   .
     2657               end.
     2658               else do:
     2659                   assign
     2660                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2661                   .
     2662               end.
     2663               leave replace-cycle.
     2664           end.
     2665           else do:
     2666               assign
     2667                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2668                   v-position      = v-last-position
     2669                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2670               .
     2671               if v-current-char = "#":U
     2672               then do:
     2673                   assign
     2674                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2675                   .
     2676                   if v-last-position > 0
     2677                   then do:
     2678                       run xmlchar-read-integer in this-procedure
     2679                        (
     2680                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2681                           , output v-temp-integer
     2682                           , output v-success
     2683                       ).
     2684                       if v-success = yes
     2685                       and v-temp-integer >= 1
     2686                       and v-temp-integer <= 255
     2687                       then do:
     2688                           assign
     2689                               p-out-string = p-out-string + chr( v-temp-integer )
     2690                               v-position   = v-last-position + 1
     2691                           .
     2692                       end.
     2693                       else do:
     2694                           assign
     2695                               p-out-string = p-out-string + "&":U
     2696                               v-position   = v-position   + 1
     2697                           .
     2698                       end.
     2699                   end.
     2700                   else do:
     2701                       assign
     2702                           p-out-string = p-out-string + "&":U
     2703                           v-position   = v-position   + 1
     2704                       .
     2705                   end.
     2706               end.
     2707               else do:
     2708                   case substring( p-in-string, v-position + 1, 3 )
     2709                   :
     2710                       when "lt;":U
     2711                       then do:
     2712                           assign
     2713                               p-out-string = p-out-string + "<":U
     2714                               v-position   = v-position   + 3
     2715                           .
     2716                       end.
     2717                       when "gt;":U
     2718                       then do:
     2719                           assign
     2720                               p-out-string = p-out-string + ">":U
     2721                               v-position   = v-position   + 3
     2722                           .
     2723                       end.
     2724                       otherwise do:
     2725                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2726                           then do:
     2727                               assign
     2728                                   p-out-string = p-out-string + "&":U
     2729                                   v-position   = v-position   + 4
     2730                               .
     2731                           end.
     2732                           else do:
     2733                               case substring( p-in-string, v-position + 1, 5 )
     2734                               :
     2735                                   when "quot;":U
     2736                                   then do:
     2737                                       assign
     2738                                           p-out-string = p-out-string + '"':U
     2739                                           v-position   = v-position   + 5
     2740                                       .
     2741                                   end.
     2742                                   when "apos;":U
     2743                                   then do:
     2744                                       assign
     2745                                           p-out-string = p-out-string + "'":U
     2746                                           v-position   = v-position   + 5
     2747                                       .
     2748                                   end.
     2749                                   otherwise do:
     2750                                       assign
     2751                                           p-out-string = p-out-string + "&":U
     2752                                       .
     2753                                   end.
     2754                               end case.
     2755                           end.
     2756                       end.
     2757                   end case.
     2758               end.
     2759           end.
     2760       end.
     2761   end.
     2762   end .
     2763   procedure xmlchar-read-integer :
     2764   define input parameter p-input-string      as character        no-undo.
     2765   define output parameter p-output-integer   as integer          no-undo.
     2766   define output parameter p-success       as logical          no-undo.
     2767   do
     2768   on error undo, return error
     2769   :
     2770       assign
     2771           p-output-integer = integer( p-input-string )
     2772       no-error.
     2773       if error-status :error
     2774       then do:
     2775           assign
     2776               p-success           = no
     2777               p-output-integer    = 0
     2778           .
     2779       end.
     2780       else do:
     2781           assign
     2782               p-success           = yes
     2783           .
     2784       end.
     2785   end.
     2786   end.
     2787   define variable v-bgelib-bgeclall           as logical      no-undo.
     2788   define variable v-bgelib-bgedict            as logical      no-undo.
     2789   define temp-table temp_ext-doc-type no-undo
     2790       field edt-key               as integer
     2791       field ext-doc-type          as character
     2792       field ext-doc-type-label    as character
     2793       index pi is primary unique
     2794           edt-key
     2795   .
     2796   define temp-table temp_bgelib_goods no-undo
     2797       field gds-code as integer
     2798       index pi is primary unique
     2799           gds-code
     2800   .
     2801   define temp-table temp_bgelib_clients no-undo
     2802       field obj-type as character
     2803       field obj-code as integer
     2804       index pi is primary unique
     2805           obj-type
     2806           obj-code
     2807   .
     2808   define temp-table temp_bgelib_dis-card no-undo
     2809       field d-card as character
     2810       index pi is primary unique
     2811           d-card
     2812   .
     2813   define temp-table temp_bgelib_trn-doc no-undo
     2814       field doc-code as integer
     2815   .
     2816   procedure bgelib-tag-open:
     2817   do
     2818   on error undo, return error
     2819   :
     2820   define input parameter v-tag-level  as integer      no-undo.
     2821   define input parameter v-tag-name   as character    no-undo.
     2822   define input parameter v-tag-value  as character    no-undo.
     2823       put stream stmXMLOut unformatted
     2824           chr(10)
     2825           + fill(" ", 4 * v-tag-level)
     2826           + "<" + v-tag-name
     2827           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2828           + v-tag-value + ">"
     2829       .
     2830   end.
     2831   end procedure.
     2832   procedure bgelib-tag-put:
     2833   do
     2834   on error undo, return error
     2835   :
     2836   define input parameter v-tag-level      as integer      no-undo.
     2837   define input parameter v-tag-name       as character    no-undo.
     2838   define input parameter v-tag-value      as character    no-undo.
     2839   define input parameter v-empty-mode     as integer      no-undo.
     2840       v-tag-name = trim(v-tag-name).
     2841       if  v-empty-mode = 1
     2842       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2843       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2844       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2845       then do:
     2846           run xmlchar-encode in this-procedure (
     2847                 input v-tag-value
     2848               , output v-tag-value
     2849           ).
     2850           put stream stmXMLOut unformatted
     2851               chr(10) + fill(" ", 4 * v-tag-level)
     2852                           + '<' + v-tag-name + '>'
     2853                           + v-tag-value
     2854                           + '</' + v-tag-name + '>'
     2855           .
     2856       end.
     2857   end.
     2858   end procedure.
     2859   procedure bgelib-tag-close:
     2860   do
     2861   on error undo, return error
     2862   :
     2863   define input parameter v-tag-level as integer      no-undo.
     2864   define input parameter v-tag-name  as character    no-undo.
     2865       put stream stmXMLOut unformatted
     2866           chr(10)
     2867           + fill( " ", 4 * v-tag-level)
     2868           + '</' + v-tag-name + '>'
     2869       .
     2870   end.
     2871   end procedure.
     2872   procedure bgelib-write-log:
     2873   do
     2874   on error undo, return error
     2875   :
     2876   define input parameter v-filename   as character    no-undo.
     2877   define input parameter v-log-level  as integer      no-undo.
     2878   define input parameter v-out-string as character    no-undo.
     2879       output stream stmXMLLog to value( v-filename ) append.
     2880       put stream stmXMLLog unformatted
     2881           chr(10)
     2882       .
     2883       put stream stmXMLLog unformatted
     2884           ( if v-log-level = 0
     2885             or v-out-string = "&DLine"
     2886             or v-out-string = "&Line"
     2887             then ""
     2888             else cur-time-string-sec() + " " )
     2889       .
     2890       put stream stmXMLLog unformatted
     2891           ( if v-out-string = "&Line"
     2892             then fill( "-", 80 )
     2893             else if v-out-string = "&DLine"
     2894                  then fill( "=", 80 )
     2895                  else v-out-string )
     2896       .
     2897       output stream stmXMLLog close.
     2898   end.
     2899   end procedure.
     2900   procedure bgelib-write-edt:
     2901   do
     2902   on error undo, return error
     2903   :
     2904   define input parameter v-editor-handle    as handle       no-undo.
     2905   define input parameter v-log-level        as integer      no-undo.
     2906   define input parameter v-out-string       as character    no-undo.
     2907       if valid-handle ( v-editor-handle )
     2908       then do:
     2909           v-editor-handle :move-to-eof().
     2910           v-editor-handle :insert-string( ( if v-log-level = 0
     2911                                             or v-out-string = "&DLine"
     2912                                             or v-out-string = "&Line"
     2913                                             then ""
     2914                                             else cur-time-string-sec() + " "
     2915                                         ) ).
     2916           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2917                                             then fill( "-", 80 )
     2918                                             else if v-out-string = "&DLine" then fill("=", 80)
     2919                                             else fill( " ", v-log-level) + v-out-string
     2920                                         ) ).
     2921           v-editor-handle :insert-string( chr(10) ).
     2922       end.
     2923       process events.
     2924       output to 'bgescn.txt' append.
     2925           put unformatted
     2926               chr(10)
     2927               string( ( if v-log-level = 0
     2928                         or v-out-string = "&DLine"
     2929                         or v-out-string = "&Line"
     2930                         then ""
     2931                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2932                     ) )
     2933               string( ( if v-out-string = "&Line"
     2934                         then fill( "-", 80 )
     2935                         else if v-out-string = "&DLine"
     2936                              then fill( "=", 80 )
     2937                              else fill( " ", v-log-level ) + v-out-string
     2938                     ) )
     2939           .
     2940       output close.
     2941   end.
     2942   end procedure.
     2943   procedure bgelib-show-cnt:
     2944   do
     2945   on error undo, return error
     2946   :
     2947   define input parameter v-fillin-handle     as handle   no-undo.
     2948       if valid-handle( v-fillin-handle )
     2949       then do:
     2950           assign
     2951               v-fillin-handle :visible = true
     2952           .
     2953       end.
     2954   end.
     2955   end procedure.
     2956   procedure bgelib-hide-cnt:
     2957   do
     2958   on error undo, return error
     2959   :
     2960   define input parameter v-fillin-handle     as handle   no-undo.
     2961       if valid-handle( v-fillin-handle )
     2962       then do:
     2963           assign v-fillin-handle :visible = false.
     2964       end.
     2965   end.
     2966   end procedure.
     2967   procedure bgelib-write-cnt:
     2968   do
     2969   on error undo, return error
     2970   :
     2971   define input parameter v-fillin-handle    as handle       no-undo.
     2972   define input parameter v-fillin-string    as character    no-undo.
     2973       if valid-handle( v-fillin-handle )
     2974       then do:
     2975           assign
     2976               v-fillin-handle :SCREEN-value = v-fillin-string
     2977           .
     2978       end.
     2979   end.
     2980   end procedure.
     2981   procedure bgelib-write-header:
     2982   do
     2983   on error undo, return error
     2984   :
     2985   define input parameter p-first-file     as logical      no-undo.
     2986   define input parameter p-xml-file-name  as character    no-undo.
     2987   define input parameter p-list-file-name as character    no-undo.
     2988   define input parameter p-file-number    as integer      no-undo.
     2989   define input parameter p-have-prev      as logical      no-undo.
     2990   define input parameter p-prev-filename  as character    no-undo.
     2991   define input parameter p-obj-list       as character    no-undo.
     2992   define input parameter p-doc-type-list  as character    no-undo.
     2993   define input parameter p-parameter-list as character    no-undo.
     2994       define variable v-counter    as integer        no-undo.
     2995       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2996       put stream stmXMLOut unformatted
     2997           "<?xml version='1.0' encoding='windows-1251'?>"
     2998       .
     2999       run bgelib-tag-open( input 0, input "root"  , input "" ).
     3000       run bgelib-tag-open( input 0, input "header", input "" ).
     3001       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     3002       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     3003       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     3004       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     3005       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     3006       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     3007       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3008       :
     3009           run bgelib-tag-put(
     3010                 input 1
     3011               , input entry( 2 * v-counter, p-parameter-list )
     3012               , input entry( 2 * v-counter + 1, p-parameter-list )
     3013               , input 0
     3014           ).
     3015       end.
     3016       run bgelib-tag-close( input 0, input "header" ).
     3017       output stream stmXMLOut close.
     3018       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3019       if p-first-file = yes
     3020       then do:
     3021           put stream stmXMLOut unformatted
     3022               "<?xml version='1.0' encoding='windows-1251'?>"
     3023           .
     3024           run bgelib-tag-open( input 0, input "export", input "" ).
     3025       end.
     3026       run bgelib-tag-open( input 1, input "file", input "" ).
     3027       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     3028       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     3029       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     3030       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     3031       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     3032       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     3033       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3034       :
     3035           run bgelib-tag-put(
     3036                 input 2
     3037               , input trim(entry( 2 * v-counter, p-parameter-list ))
     3038               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     3039               , input 0
     3040           ).
     3041       end.
     3042       run bgelib-tag-close( input 1, input "file" ).
     3043       output stream stmXMLOut close.
     3044   end.
     3045   end procedure.
     3046   procedure bgelib-write-footer:
     3047   do
     3048   on error undo, return error
     3049   :
     3050   define input parameter p-last-file      as logical      no-undo.
     3051   define input parameter p-xml-file-name  as character    no-undo.
     3052   define input parameter p-list-file-name as character    no-undo.
     3053   define input parameter p-have-next      as logical      no-undo.
     3054   define input parameter p-next-file-name as character    no-undo.
     3055       define variable v-error-num     as integer           no-undo.
     3056       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3057       if p-have-next = yes
     3058       then do:
     3059           run bgelib-tag-open( input 0, input "footer", "" ).
     3060           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     3061           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     3062           run bgelib-tag-close( input 0, input "footer" ).
     3063       end.
     3064       run bgelib-tag-close( input 0, input "root" ).
     3065       output stream stmXMLOut close.
     3066       run bge/os_copy.p (
     3067             input "M"
     3068           , input p-xml-file-name + "tmp"
     3069           , input p-xml-file-name + "xml"
     3070           , output v-error-num
     3071       ).
     3072       if p-last-file = yes
     3073       then do:
     3074           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3075               run bgelib-tag-close( input 0, input "export" ).
     3076           output stream stmXMLOut close.
     3077           run bge/os_copy.p (
     3078                 input "M"
     3079               , input p-list-file-name + "tmp"
     3080               , input p-list-file-name + "xml"
     3081               , output v-error-num
     3082           ).
     3083       end.
     3084   end.
     3085   end procedure.
     3086   procedure bgelib-filename :
     3087   do
     3088   on error undo, return error
     3089   :
     3090   define input parameter p-prefix             as character    no-undo.
     3091   define output parameter p-xml-file-name     as character    no-undo.
     3092   define output parameter p-log-file-name     as character    no-undo.
     3093   define output parameter p-list-file-name    as character    no-undo.
     3094       define variable v-home-dir  as character    no-undo.
     3095       define variable v-error-num as integer      no-undo.
     3096       get-key-value section "BGE" key "outdir" value v-home-dir.
     3097       if v-home-dir = ?
     3098       then do:
     3099           message
     3100             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3101             skip(1)
     3102             skip "Обратитесь к администратору."
     3103           view-as alert-box error.
     3104           undo, return error .
     3105       end.
     3106       run gbl/dir-cre.p (
     3107           input v-home-dir
     3108       ) no-error.
     3109       if error-status :error
     3110       then do:
     3111           message
     3112             skip "Неверно задан каталог экспорта."
     3113             skip(1)
     3114             skip "Обратитесь к администратору."
     3115           view-as alert-box error.
     3116           undo, return error .
     3117       end.
     3118       run bge/genfname.p (
     3119             input v-home-dir
     3120           , input p-prefix
     3121           , input ""
     3122           , input "xml"
     3123           , input "tmp"
     3124           , output p-xml-file-name
     3125       ).
     3126       assign
     3127           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     3128           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     3129           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     3130       .
     3131   end.
     3132   end procedure.
     3133   procedure bgelib-read-config :
     3134   do
     3135   on error undo, return error
     3136   :
     3137   define variable v-par-type as character     no-undo.
     3138     define variable v-param-type      as character  no-undo .
     3139     define variable v-value-character as character  no-undo .
     3140     define variable v-value-date      as date       no-undo .
     3141     define variable v-value-decimal   as decimal    no-undo .
     3142     define variable v-value-integer   as integer    no-undo .
     3143     define variable v-value-logical   as logical    no-undo .
     3144     define variable v-tth             as handle     no-undo .
     3145       assign
     3146           v-bgelib-bgeclall = no
     3147           v-bgelib-bgedict  = no
     3148       .
     3149       run adm/shattri.p ( input "get":U
     3150                         , input  '':u
     3151                         , input  0
     3152                         , input  'bge-export':U
     3153                         , input  'bgeclall':U
     3154                         , output v-value-character
     3155                         , output v-value-date
     3156                         , output v-value-decimal
     3157                         , output v-value-integer
     3158                         , output v-value-logical
     3159                         , output v-param-type
     3160                         , input-output table-handle v-tth
     3161                         ) no-error .
     3162       if error-status :error
     3163       then do:
     3164         assign
     3165           v-bgelib-bgeclall = no
     3166         .
     3167       end.
     3168       else do:
     3169         assign
     3170           v-bgelib-bgeclall = v-value-logical
     3171         .
     3172       end.
     3173       delete object v-tth.
     3174       run adm/shattri.p ( input "get":U
     3175                         , input  '':u
     3176                         , input  0
     3177                         , input  'bge-export':U
     3178                         , input  'bgedict':U
     3179                         , output v-value-character
     3180                         , output v-value-date
     3181                         , output v-value-decimal
     3182                         , output v-value-integer
     3183                         , output v-value-logical
     3184                         , output v-param-type
     3185                         , input-output table-handle v-tth
     3186                         ) no-error .
     3187       if error-status :error
     3188       then do:
     3189         assign
     3190           v-bgelib-bgedict = no
     3191         .
     3192       end.
     3193       else do:
     3194         assign
     3195           v-bgelib-bgedict = v-value-logical
     3196         .
     3197       end.
     3198       delete object v-tth.
     3199       run adm/shattri.p ( input "get":U
     3200                         , input  '':u
     3201                         , input  0
     3202                         , input  'bge-export':U
     3203                         , input  'bgefmt':U
     3204                         , output v-value-character
     3205                         , output v-value-date
     3206                         , output v-value-decimal
     3207                         , output v-value-integer
     3208                         , output v-value-logical
     3209                         , output v-param-type
     3210                         , input-output table-handle v-tth
     3211                         ) no-error .
     3212       if error-status :error
     3213       then do:
     3214         assign
     3215           v-bgelib-bgefmt  = "xml":U
     3216         .
     3217       end.
     3218       else do:
     3219         assign
     3220           v-bgelib-bgefmt  = v-value-character
     3221         .
     3222       end.
     3223       delete object v-tth.
     3224       run adm/shattri.p ( input "get":U
     3225                         , input  '':u
     3226                         , input  0
     3227                         , input  'bge-export':U
     3228                         , input  'bgeflold':U
     3229                         , output v-value-character
     3230                         , output v-value-date
     3231                         , output v-value-decimal
     3232                         , output v-value-integer
     3233                         , output v-value-logical
     3234                         , output v-param-type
     3235                         , input-output table-handle v-tth
     3236                         ) no-error .
     3237       if error-status :error
     3238       then do:
     3239         assign
     3240           v-bgelib-bgeflold  = "old":U
     3241         .
     3242       end.
     3243       else do:
     3244         assign
     3245           v-bgelib-bgeflold  = v-value-character
     3246         .
     3247       end.
     3248       delete object v-tth.
     3249   end.
     3250   end procedure.
     3251   procedure bgelib-check-file-size :
     3252   do
     3253   on error undo, return error
     3254   :
     3255   define input parameter p-out-filename   as character    no-undo.
     3256   define output parameter p-is-big        as logical      no-undo.
     3257       define variable v-current-position    as integer        no-undo.
     3258       assign
     3259           v-current-position = seek( stmXMLOut )
     3260       .
     3261       if v-current-position / 1024 / 1024  >= 100
     3262       then do:
     3263           assign
     3264               p-is-big = yes
     3265           .
     3266       end.
     3267   end.
     3268   end procedure.
     3269   procedure bgelib-init-ext-doc-type :
     3270       define variable v-counter    as integer      no-undo.
     3271       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3272   do
     3273   for buf_temp_ext-doc-type
     3274   on error undo, return error
     3275   :
     3276       empty temp-table buf_temp_ext-doc-type.
     3277       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3278       :
     3279           create buf_temp_ext-doc-type.
     3280           assign
     3281               buf_temp_ext-doc-type.edt-key               = v-counter
     3282               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3283               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3284           .
     3285       end.
     3286   end.
     3287   end procedure.
     3288   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   define variable v-xml-file-name     as character            no-undo.
     3290   define variable v-xml-file-name-path as character            no-undo.
     3291   define variable v-log-file-name     as character            no-undo.
     3292   define variable v-locked            as logical              no-undo.
     3293   define variable v-log-string        as character            no-undo.
     3294   define variable v-oper-num          as integer              no-undo.
     3295   define variable v-obj-list          as character            no-undo.
     3296   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
