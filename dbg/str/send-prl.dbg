     7883   end.
     7884   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7885   PROCEDURE asc-gds.
     7886   DEFINE parameter buffer loc-goods for ub.goods.
     7887   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7888   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7889   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7890   DEFINE parameter buffer loc-price-list for ub.price-list.
     7891   DEFINE parameter buffer loc-units for ub.units.
     7892   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7893   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7894   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7895   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7896   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7897   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7898   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7899   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7900   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7901   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7902   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7903   define variable v-disc-price-sale as decimal no-undo .
     7904   define variable v-pdf-id as integer no-undo .
     7905   define variable v-pdf-db-num as integer no-undo .
     7906   define variable v-oss as character no-undo.
     7907   define variable v-gtd as character no-undo .
     7908   define variable v-is-gas as character no-undo .
     7909   define variable v-ban-bonus as character no-undo .
     7910   define variable v-ptrl-as-good as character no-undo .
     7911   define variable v-type as character no-undo .
     7912   define variable disc-b-code as integer no-undo .
     7913   define variable v-main-prt-b-code as integer no-undo .
     7914   define variable IBM-good-code as character no-undo .
     7915   define variable IBM-good-code-2 as character no-undo .
     7916   define variable IBM2-short      as character no-undo .
     7917   define variable v-gds-null-price as character no-undo .
     7918   define variable iii as integer no-undo .
