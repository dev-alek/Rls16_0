      657   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      659                                                                     input  orders as integer):
      660   define variable  round-m-sum as decimal no-undo.
      661   if orders >= 0 then
      662   round-m-sum = round(mysum,orders).
      663   else
      664   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      665   return round-m-sum.
      666   END FUNCTION.
      667   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   procedure factord :
      669     define input  parameter p-fact-date            as date    no-undo .
      670     define input  parameter p-fact-time            as integer no-undo .
      671     define input  parameter p-fact-num             as integer no-undo .
      672     define input  parameter p-shift-date           as date    no-undo .
      673     define input  parameter p-shift-num            as integer no-undo .
      674     define input  parameter p-shift-on             as logical no-undo .
      675     define output parameter p-fact-order           as decimal no-undo .
      676     define output parameter p-shift-end-fact-order as decimal no-undo .
      677     define output parameter p-day-end-fact-order   as decimal no-undo .
      678     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      679     if p-fact-date = ?
      680     then do:
      681       return error "Не указана фактическая дата" .
      682     end.
      683     define variable v-fact-date-num as integer no-undo .
      684     assign
      685       v-fact-date-num = integer(p-fact-date)
      686     .
      687     if p-fact-num = ?
      688     or p-fact-num = 0
      689     then do:
      690       return error "Не задан p-fact-num " + string(p-fact-num) .
      691     end.
      692     if p-fact-num < 0
      693     then do:
      694       return error "Отрицательный fact-num " + string(p-fact-num) .
      695     end.
      696     if p-fact-num >= 100000000
      697     then do:
      698       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      699     end.
      700     if p-shift-on = true
      701     then do:
      702       if p-shift-date = ?
      703       then do:
      704         return error "Не задана дата смены" .
      705       end.
      706       if p-shift-num = ?
      707       or p-shift-num = 0
      708       then do:
      709         return error "Не задан номер смены" .
      710       end.
      711     end.
      712     else do:
      713       assign
      714         p-shift-date = p-fact-date
      715         p-shift-num  = 24
      716       .
      717     end.
      718     define variable v-shift-offset as integer no-undo .
      719     if p-shift-date = p-fact-date
      720     then do:
      721       assign
      722         v-shift-offset = 1
      723       .
      724     end.
      725     if p-shift-date < p-fact-date
      726     then do:
      727       assign
      728         v-shift-offset = 0
      729       .
      730     end.
      731     if p-shift-date > p-fact-date
      732     then do:
      733       message
      734         vss-workfile vss-revision vss-description skip
      735         "Неправильная дата закрытия смены" skip
      736         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      737         view-as alert-box error .
      738       undo, return error
      739         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      740           ,string(p-fact-date, '99/99/9999':U)
      741           ,string(p-shift-date, '99/99/9999':U)
      742           )
      743       .
      744     end.
      745     if p-shift-num < 1
      746     or p-shift-num > 24
      747     then do:
      748       message
      749         vss-workfile vss-revision vss-description skip
      750         "Неправильный номер смены" skip
      751         "p-shift-num" p-shift-num skip
      752         view-as alert-box error .
      753       undo, return error return-value .
      754     end.
      755     assign
      756       p-fact-order           = v-fact-date-num
      757                              + v-shift-offset * 0.5
      758                              + p-shift-num    * 0.02 - 0.01
      759                              + p-fact-num     * 0.0000000001
      760       p-shift-end-fact-order = v-fact-date-num
      761                              + v-shift-offset * 0.5
      762                              + p-shift-num    * 0.02
      763       p-day-end-fact-order   = v-fact-date-num
      764                              + 0.99
      765     .
      766     if p-fact-order           <= v-fact-date-num
      767     or p-shift-end-fact-order <= v-fact-date-num
      768     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      769     or p-shift-end-fact-order >= p-day-end-fact-order
      770     then do:
      771       message
      772         vss-workfile vss-revision vss-description skip
      773         "Внутренняя ошибка при генерации фактического номера" skip
      774         "p-fact-date"            p-fact-date            skip
      775         "p-fact-time"            p-fact-time            skip
      776         "p-fact-num"             p-fact-num             skip
      777         "p-shift-date"           p-shift-date           skip
      778         "p-shift-num"            p-shift-num            skip
      779         "p-shift-on"             p-shift-on             skip
      780         "p-shift-end-fact-order" p-shift-end-fact-order skip
      781         "p-day-end-fact-order"   p-day-end-fact-order   skip
      782         "v-fact-date-num"        v-fact-date-num        skip
      783         view-as alert-box error .
      784       undo, return error return-value .
      785     end.
      786   end procedure.
      787   procedure day-begin-fact-order :
      788     define input  parameter p-fact-date            as date    no-undo .
      789     define output parameter p-day-begin-fact-order as decimal no-undo .
      790     do
      791     on error undo, return error return-value
      792     :
      793       if p-fact-date = ?
      794       then do:
      795         assign
      796           p-day-begin-fact-order = 0
      797         .
      798       end.
      799       else do:
      800         assign
      801           p-day-begin-fact-order = integer(p-fact-date)
      802         .
      803       end.
      804     end.
      805   end procedure.
      806   procedure factord-max-fact-order :
      807     define output parameter p-max-fact-order as decimal   no-undo .
      808     do
      809     on error undo, return error return-value
      810     :
      811       run day-begin-fact-order in this-procedure
      812         (input  date(1, 1, 5000)
      813         ,output p-max-fact-order
      814         ) .
      815     end.
      816   end procedure.
      817   procedure factord-cut-archive :
      818     define input  parameter p-obj-type             as character no-undo .
      819     define input  parameter p-obj-code             as integer   no-undo .
      820     define input  parameter p-fact-date            as date      no-undo .
      821     define output parameter p-shift-on             as logical   no-undo .
      822     define output parameter p-shift-date           as date      no-undo .
      823     define output parameter p-shift-num            as integer   no-undo .
      824     define output parameter p-day-end-fact-order   as decimal   no-undo .
      825     define output parameter p-shift-end-fact-order as decimal   no-undo .
      826     define variable v-fact-order as decimal   no-undo .
      827     define buffer buf_shift-obj for ub.shift-obj .
      828     do
      829     on error undo, return error return-value
      830     :
      831   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      833     (input  p-obj-type
      834     ,input  p-obj-code
      835     ,input  'shift-on=request'
      836     ,output p-shift-on
      837     ) no-error .
      838       if error-status :error
      839       then do:
      840         message
      841           vss-workfile vss-revision vss-description skip
      842           "Ошибка при определении атрибута объекта" skip
      843           "Объект" p-obj-type p-obj-code skip
      844           error-status :get-message(1) skip
      845           return-value skip
      846           view-as alert-box error .
      847         undo, return error return-value .
      848       end.
      849       if p-shift-on = false
      850       then do:
      851         assign
      852           p-shift-date               = ?
      853           p-shift-num                = 0
      854         .
      855       end.
      856       else do:
      857         find first buf_shift-obj share-lock
      858           where buf_shift-obj.obj-type   = p-obj-type
      859             and buf_shift-obj.obj-code   = p-obj-code
      860             and buf_shift-obj.shift-date > p-fact-date
      861           use-index pi
      862           no-error .
      863         if not available buf_shift-obj
      864         or buf_shift-obj.status_ <> 'зкр':U
      865         then do:
      866           message
      867             vss-workfile vss-revision vss-description skip
      868             "Невозможно вычислить последнюю смену" skip
      869             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      870             "Объект" p-obj-type p-obj-code skip
      871             "Дата" p-fact-date skip
      872             view-as alert-box error .
      873           undo, return error return-value .
      874         end.
      875         find last buf_shift-obj share-lock
      876           where buf_shift-obj.obj-type = p-obj-type
      877             and buf_shift-obj.obj-code = p-obj-code
      878             and buf_shift-obj.shift-date <= p-fact-date
      879           use-index pi
      880           no-error .
      881         if available buf_shift-obj
      882         then do:
      883           if  buf_shift-obj.status_ = 'зкр':U
      884           then do:
      885             assign
      886               p-shift-date = buf_shift-obj.shift-date
      887               p-shift-num  = buf_shift-obj.shift-num
      888             .
      889           end.
      890           else do:
      891             message
      892               vss-workfile vss-revision vss-description skip
      893               "Невозможно вычислить последнюю смену" skip
      894               "Статус смены отличен от статуса" 'зкр':U skip
      895               "Объект" p-obj-type p-obj-code skip
      896               "Дата" p-fact-date skip
      897               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      898               view-as alert-box error .
      899             undo, return error return-value .
      900           end.
      901         end.
      902         else do:
      903           assign
      904             p-shift-date = p-fact-date - 1
      905             p-shift-num  = 1
      906           .
      907         end.
      908       end.
      909       run factord in this-procedure
      910         (input  p-fact-date
      911         ,input  1
      912         ,input  1
      913         ,input  p-shift-date
      914         ,input  p-shift-num
      915         ,input  p-shift-on
      916         ,output v-fact-order
      917         ,output p-shift-end-fact-order
      918         ,output p-day-end-fact-order
      919         ) no-error .
      920       if error-status :error
      921       then do:
      922         message
      923           vss-workfile vss-revision vss-description skip
      924           "Ошибка при вызове процедуры factord"
      925           error-status :get-message(1) skip
      926           return-value skip
      927           view-as alert-box error .
      928         undo, return error return-value .
      929       end.
      930     end.
      931   end procedure.
      932   procedure factord-lock-shift :
      933     define input  parameter p-obj-type  as character no-undo .
      934     define input  parameter p-obj-code  as integer   no-undo .
      935     define input  parameter p-fact-date as date      no-undo .
      936     define parameter buffer buf_shift-obj for ub.shift-obj .
      937     define variable v-shift-on      as logical   no-undo .
      938     define variable v-extra-message as character no-undo .
      939     define variable v-error as character no-undo .
      940     do
      941     on error undo, return error return-value
      942     :
      943   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      945     (input  p-obj-type
      946     ,input  p-obj-code
      947     ,input  'shift-on=request'
      948     ,output v-shift-on
      949     ) no-error .
      950       if error-status :error
      951       then do:
      952         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      953         undo, return error v-error .
      954       end.
      955       if v-shift-on = true
      956       then do:
      957         find first buf_shift-obj share-lock
      958           where buf_shift-obj.obj-type   = p-obj-type
      959             and buf_shift-obj.obj-code   = p-obj-code
      960             and buf_shift-obj.shift-date > p-fact-date
      961           use-index pi
      962           no-error .
      963         if not available buf_shift-obj
      964         or buf_shift-obj.status_ <> 'зкр':U
      965         then do:
      966           find last buf_shift-obj
      967             where buf_shift-obj.obj-type = p-obj-type
      968               and buf_shift-obj.obj-code = p-obj-code
      969               and buf_shift-obj.status_  = 'зкр':U
      970             use-index stts
      971             no-error .
      972           if available buf_shift-obj
      973           then do:
      974             assign
      975               v-extra-message =
      976                     substitute("Дата начала последеней закрытой смены на объекте &1"
      977                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      978                               )
      979             .
      980           end.
      981           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      982           undo, return error v-error .
      983         end.
      984       end.
      985     end.
      986   end procedure.
      987   procedure factord-end-day :
      988     define input  parameter p-fact-date            as date    no-undo .
      989     define output parameter p-day-end-fact-order   as decimal no-undo .
      990     do
      991     on error undo, return error return-value
      992     :
      993       if p-fact-date = ?
      994       then do:
      995         return error "Не указана фактическая дата" .
      996       end.
      997       assign
      998         p-day-end-fact-order = integer(p-fact-date) + 0.99
      999       .
     1000     end.
     1001   end procedure.
     1002   procedure factord-to-date :
     1003     define input  parameter p-fact-order as decimal no-undo .
     1004     define output parameter p-fact-date  as date    no-undo .
     1005     define variable v-ref-date  as date      no-undo .
     1006     define variable v-ref-delta as integer   no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       if p-fact-order = ?
     1011       or p-fact-order = 0
     1012       then do:
     1013         return error "Не указан fact-order" .
     1014       end.
     1015       assign
     1016         v-ref-date  = date(1, 1, 2000)
     1017       .
     1018       assign
     1019         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1020       .
     1021       assign
     1022         p-fact-date = v-ref-date + v-ref-delta
     1023       .
     1024     end.
     1025   end procedure.
     1026   procedure factord-to-fact-num :
     1027     define input  parameter p-fact-order as decimal no-undo .
     1028     define output parameter p-fact-num   as integer no-undo .
     1029     define variable v-fact-order-trunc as decimal no-undo .
     1030     do
     1031     on error undo, return error return-value
     1032     :
     1033       if p-fact-order = ?
     1034       or p-fact-order = 0
     1035       then do:
     1036         return error "Не указан fact-order" .
     1037       end.
     1038       assign
     1039        v-fact-order-trunc = truncate(p-fact-order, 2)
     1040       .
     1041       assign
     1042         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1043       .
     1044     end.
     1045   end procedure.
     1046   procedure factord-to-shift-num :
     1047     define input  parameter p-fact-order as decimal no-undo .
     1048     define output parameter p-shift-num   as integer no-undo .
     1049     define variable  p-shift-numd  as decimal   no-undo .
     1050     define variable v-fact-order-trunc as decimal no-undo .
     1051     do
     1052     on error undo, return error return-value
     1053     :
     1054       if p-fact-order = ?
     1055       or p-fact-order = 0
     1056       then do:
     1057         return error "Не указан fact-order" .
     1058       end.
     1059       assign
     1060        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1061       .
     1062       if v-fact-order-trunc < 0.5 then do:
     1063         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1064       end.
     1065       assign
     1066         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1067         .
     1068        assign
     1069         p-shift-num = truncate (p-shift-numd , 0)
     1070       .
     1071     end.
     1072   end procedure.
     1073   define new global shared variable g#lib-trn  as handle no-undo .
     1074   define new global shared variable g#lib-trn2 as handle no-undo .
     1075   define new global shared variable g#lib-trn3 as handle no-undo .
     1076   define new global shared variable g#lib-trn4 as handle no-undo .
     1077   define temp-table  tt-tax no-undo
     1078     field tax-code    like ub.tax.tax-code
     1079     field individual  like ub.tax.individual
     1080     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
     1081     field rate-code   like ub.tax-rate.rate-code
     1082     field rate-name   like ub.tax-rate.rate-name format "x(12)"
     1083     field tax-type    like ub.tax.tax-type
     1084     field rate-value  like ub.tax-rate-value.rate-value
     1085     field tax-rate-gds-rc  as recid
