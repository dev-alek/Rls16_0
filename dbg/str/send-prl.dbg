     1938   define variable v-tth23 as handle no-undo .
     1939   run adm/shattri.p (
     1940       input "get":U
     1941       ,input  p-obj-type
     1942       ,input  p-obj-code
     1943       ,input  'cd-sending':U
     1944       ,input  'dflt-cd':U
     1945       ,output p-pos-type
     1946       ,output v-value-date23
     1947       ,output v-value-decimal23
     1948       ,output v-value-integer23
     1949       ,output v-value-logical23
     1950       ,output v-param-type23
     1951       ,INPUT-OUTPUT table-handle v-tth23
     1952       )  .
     1953   delete object v-tth23 no-error.
     1954       end.
     1955       find first buf_dis-rule no-lock where
     1956                 buf_dis-rule.rule-num = p-rule-num no-error.
     1957       if not available buf_Dis-rule then do:
     1958         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1959                                 ,p-gds-code
     1960                                 ,p-obj-type
     1961                                 ,p-obj-code
     1962                                 ,p-pos-type
     1963                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1964                                 ,chr(10)
     1965                                 ,p-rule-num).
     1966       end.
     1967       if buf_dis-rule.root <> yes then do:
     1968         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1969                                 ,p-gds-code
     1970                                 ,p-obj-type
     1971                                 ,p-obj-code
     1972                                 ,p-pos-type
     1973                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1974                                 ,chr(10)
     1975                                 ,p-rule-num).
     1976       end.
     1977       if not (p-obj-type = buf_dis-rule.obj-type
     1978           and p-obj-code = buf_dis-rule.obj-code)
     1979       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1980                and
     1981                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1982        then do:
     1983         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1984                                 ,p-gds-code
     1985                                 ,p-obj-type
     1986                                 ,p-obj-code
     1987                                 ,p-pos-type
     1988                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1989                                 ,chr(10)
     1990                                 ) +
     1991                             substitute("Правило скидки &1 определено для &2&3" +
     1992                                        "а привязка к товару для &4"
     1993                                        ,buf_dis-rule.rule-num
     1994                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1995                                        ,chr(10)
     1996                                        ,get-objregion( p-obj-type, p-obj-code)
     1997                                        ))
     1998                                 .
     1999       end.
     2000       find first buf_dis-gds-rule exclusive-lock where
     2001                  buf_dis-gds-rule.gds-code  = p-gds-code
     2002              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     2003              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     2004              AND buf_dis-gds-rule.pos-type  = p-pos-type
     2005              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     2006              and buf_dis-gds-rule.nonunique = p-nonunique
     2007              no-error .
     2008       if not available buf_dis-gds-rule then do:
     2009         find first buf_dis-gds-rule exclusive-lock where
     2010                   buf_dis-gds-rule.gds-code  = p-gds-code
     2011               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     2012               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     2013               AND buf_dis-gds-rule.pos-type  = p-pos-type
     2014               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     2015               no-error .
     2016         if available buf_Dis-gds-rule then do:
     2017           if p-nonunique = ''
     2018           and available buf_dis-gds-rule
     2019           then do:
     2020             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     2021                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2022                                      , p-gds-code
     2023                                      , buf_Dis-rule.obj-type
     2024                                      , buf_Dis-rule.obj-code
     2025                                      , p-nonunique
     2026                                     ).
     2027           end.
     2028           if available buf_dis-gds-rule
     2029           and buf_dis-gds-rule.nonunique = ''
     2030           and p-nonunique <> ''then do:
     2031             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     2032                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2033                                      , p-gds-code
     2034                                      , buf_Dis-rule.obj-type
     2035                                      , buf_Dis-rule.obj-code
     2036                                     ).
     2037           end.
     2038         end.
     2039         create buf_dis-gds-rule .
     2040         assign
     2041         buf_dis-gds-rule.gds-code  = p-gds-code
     2042         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     2043         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     2044         buf_dis-gds-rule.pos-type = p-pos-type
     2045         buf_dis-gds-rule.discnt-role = v-discnt-role
     2046         buf_dis-gds-rule.rule-num = p-rule-num
     2047         buf_dis-gds-rule.nonunique = p-nonunique
     2048         no-error
     2049         .
     2050       end.
     2051       ASSIGN
     2052       buf_dis-gds-rule.rule-num = p-rule-num
     2053       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     2054       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     2055       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     2056       buf_dis-gds-rule.nonunique = p-nonunique
     2057       no-error.
     2058     end.
     2059   end procedure.
     2060   PROCEDURE cmp-disgdsru-write :
     2061   do
     2062   on error undo, return error
     2063   :
     2064     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     2065     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     2066     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     2067     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     2068     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     2069     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     2070     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     2071     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     2072     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     2073     define variable v-rule-label          as character no-undo .
     2074     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     2075     define buffer buf_dis-rule     for ub.dis-rule.
     2076     run disgdsru-name in this-procedure (
     2077                                         input  p-templ-rl-root
     2078                                         ,output v-rule-label
     2079                                         ) no-error .
     2080     if error-status :error then do:
     2081       undo, return error return-value .
     2082     end.
     2083     find first buf_tt0-dis-gds-rule exclusive-lock where
     2084                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2085             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2086             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2087             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2088             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2089             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2090             no-error .
     2091     if not available buf_tt0-dis-gds-rule then do:
     2092       create buf_tt0-dis-gds-rule .
     2093       assign
     2094       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2095       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2096       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2097       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2098       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2099       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2100       no-error
     2101       .
     2102     end.
     2103     find first buf_dis-rule no-lock where
     2104               buf_dis-rule.rule-num = p-rule-num.
     2105     ASSIGN
     2106     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2107     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     2108     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     2109     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2110     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2111     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     2112     no-error.
     2113     release buf_tt0-dis-gds-rule no-error .
     2114     if error-status:error then do:
     2115       undo, return error return-value .
     2116     end.
     2117   end.
     2118   END PROCEDURE.
     2119   define variable vss-include-info24 as character format "X(65)" no-undo
     2120   initial "@(#)$Workfile$ $Revision$".
     2121   define variable v-bgelib-bgefmt        as character         no-undo.
     2122   define variable v-bgelib-bgeflold      as character         no-undo.
     2123   define stream stmXMLOut.
     2124   define stream stmXMLLog.
     2125   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2126   procedure cur-time :
     2127      define output parameter p-today as date      no-undo .
     2128      define output parameter p-time  as integer   no-undo .
     2129     do
     2130     on error undo, return error
     2131     :
     2132       define variable v-date1 as date      no-undo .
     2133       define variable v-date2 as date      no-undo .
     2134       define variable v-time  as integer   no-undo .
     2135       assign
     2136         v-date1 = today
     2137         v-time  = time
     2138         v-date2 = today
     2139       .
     2140       if v-date1 <> v-date2
     2141       then do:
     2142         assign
     2143           v-date1 = today
     2144           v-time  = v-time
     2145         .
     2146       end.
     2147       assign
     2148         p-today = v-date1
     2149         p-time  = v-time
     2150       .
     2151     end.
     2152   end.
     2153   function cur-time-date returns character
     2154   :
     2155     return string(today, '99/99/9999':U) .
     2156   end.
     2157   function cur-time-mjd returns decimal
     2158   :
     2159     define variable v-date as date      no-undo .
     2160     define variable v-time as integer   no-undo .
     2161     run cur-time in this-procedure
     2162       (output v-date
     2163       ,output v-time
     2164       ) .
     2165     return integer(v-date) - 2400002 + (v-time / 86400) .
     2166   end.
     2167   function cur-time-get-ending-index returns integer
     2168   (input p-number as integer
     2169   )
     2170   :
     2171     if p-number < 0
     2172     or p-number = ?
     2173     then do:
     2174       return 1 .
     2175     end.
     2176     define variable v-rest as integer   no-undo .
     2177     assign
     2178       p-number = p-number modulo 100
     2179     .
     2180     if p-number < 20
     2181     then do:
     2182       assign
     2183         v-rest = p-number
     2184       .
     2185     end.
     2186     else do:
     2187       assign
     2188         v-rest = p-number modulo 10
     2189       .
     2190     end.
     2191     case v-rest :
     2192       when 1
     2193       then do:
     2194         return 2 .
     2195       end.
     2196       when 2 or
     2197       when 3 or
     2198       when 4
     2199       then do:
     2200         return 3 .
     2201       end.
     2202       otherwise do:
     2203         return 1 .
     2204       end.
     2205     end case .
     2206   end.
     2207   procedure cur-time-mjd-to-date :
     2208      define input  parameter i-mjd-diff as decimal no-undo.
     2209      define output parameter o-Date     as date    no-undo.
     2210      define output parameter o-Time     as integer no-undo.
     2211      define variable v-day-number as integer   no-undo .
     2212      if    i-mjd-diff < 0
     2213         or i-mjd-diff = ?
     2214      then do:
     2215         return "?" .
     2216      end.
     2217      assign
     2218         v-day-number = truncate(i-mjd-diff,0).
     2219         o-Date = date(v-day-number + 2400002).
     2220         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2221     .
     2222   end.
     2223   function cur-time-mjd-to-string returns character
     2224   (input p-mjd-diff as decimal
     2225   )
     2226   :
     2227     define variable v-day-number as integer   no-undo .
     2228     define variable v-seconds    as integer   no-undo .
     2229     define variable v-hour       as integer   no-undo .
     2230     define variable v-min        as integer   no-undo .
     2231     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2232     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2233     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2234     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2235     if p-mjd-diff < 0
     2236     or p-mjd-diff = ?
     2237     then do:
     2238       return "?" .
     2239     end.
     2240     assign
     2241       v-day-number = integer(truncate(p-mjd-diff,0))
     2242       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2243     .
     2244     if v-seconds > 86400
     2245     then do:
     2246       assign
     2247         v-seconds = 86400 - 1
     2248       .
     2249     end.
     2250     if v-seconds < 0
     2251     then do:
     2252       assign
     2253         v-seconds = 0
     2254       .
     2255     end.
     2256     assign
     2257       v-hour = truncate(v-seconds / 3600, 0)
     2258     .
     2259     assign
     2260       v-seconds = v-seconds modulo 3600
     2261     .
     2262     assign
     2263       v-min = truncate(v-seconds / 60, 0)
     2264     .
     2265     assign
     2266       v-seconds = v-seconds modulo 60
     2267     .
     2268     return
     2269         (if v-day-number <> 0
     2270           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2271           else ""
     2272         )
     2273       + (if v-day-number <> 0 or v-hour <> 0
     2274           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2275           else ""
     2276         )
     2277       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2278           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2279           else ""
     2280         )
     2281       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2282       .
     2283   end.
     2284   function cur-time-string returns character
     2285   :
     2286     define variable v-date as date      no-undo .
     2287     define variable v-time as integer   no-undo .
     2288     run cur-time in this-procedure
     2289       (output v-date
     2290       ,output v-time
     2291       ) .
     2292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2293   end.
     2294   function cur-time-string-sec returns character
     2295   :
     2296     define variable v-date as date      no-undo .
     2297     define variable v-time as integer   no-undo .
     2298     run cur-time in this-procedure
     2299       (output v-date
     2300       ,output v-time
     2301       ) .
     2302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2303   end.
     2304   function cur-time-custom  returns character
     2305   (input p-prefix as character
     2306   ,input p-date-format as character
     2307   ,input p-delimiter as character
     2308   ,input p-time-format as character
     2309   ,input p-suffix as character
     2310   )
     2311   :
     2312     define variable v-date as date      no-undo .
     2313     define variable v-time as integer   no-undo .
     2314     run cur-time in this-procedure
     2315       (output v-date
     2316       ,output v-time
     2317       ) .
     2318     return
     2319       p-prefix
     2320       + string(v-date, p-date-format)
     2321       + p-delimiter
     2322       + string(v-time, p-time-format)
     2323       + p-suffix
     2324       .
     2325   end.
     2326   function cur-time-print  returns character
     2327   :
     2328     define variable v-date as date      no-undo .
     2329     define variable v-time as integer   no-undo .
     2330     run cur-time in this-procedure
     2331       (output v-date
     2332       ,output v-time
     2333       ) .
     2334     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2335   end.
     2336   function cur-time-datetime returns datetime
     2337   :
     2338     define variable v-char as character no-undo .
     2339     define variable v-datetime as datetime no-undo .
     2340     v-char = cur-time-string().
     2341     v-datetime = datetime(v-char).
     2342     return  v-datetime.
     2343   end.
     2344   function cur-time-string-msec returns character
     2345   :
     2346     define variable v-date as datetime  no-undo .
     2347     v-date = now.
     2348     return string(v-date) .
     2349   end.
     2350   define variable vss-include-info26 as character format "X(65)" no-undo
     2351   initial "@(#)$Workfile$ $Revision$".
     2352   procedure xmlchar-test :
     2353   define input parameter p-in-string          as character        no-undo.
     2354   define output parameter p-out-string-enc    as character        no-undo.
     2355   define output parameter p-out-string-dec    as character        no-undo.
     2356   do
     2357   on error undo, return error
     2358   :
     2359          run xmlchar-encode in this-procedure
     2360       (
     2361             input p-in-string
     2362           , output p-out-string-enc
     2363       ).
     2364          run xmlchar-decode in this-procedure
     2365       (
     2366             input p-out-string-enc
     2367           , output p-out-string-dec
     2368       ).
     2369   end.
     2370   end .
     2371   procedure xmlchar-encode :
     2372   define input parameter p-in-string      as character        no-undo.
     2373   define output parameter p-out-string    as character        no-undo.
     2374       define variable v-position      as integer      no-undo.
     2375       define variable v-current-char  as character    no-undo.
     2376   do
     2377   on error undo, return error
     2378   :
     2379       assign
     2380           p-out-string = "":U
     2381       .
     2382       case p-in-string
     2383       :
     2384           when ?
     2385           then do:
     2386               assign
     2387                   p-out-string = "?":U
     2388               .
     2389           end.
     2390           when "?":U
     2391           then do:
     2392               assign
     2393                   p-out-string = "&#63;":U
     2394               .
     2395           end.
     2396           otherwise do:
     2397               do v-position = 1 to length( p-in-string )
     2398               :
     2399                   assign
     2400                       v-current-char = substring( p-in-string, v-position, 1 )
     2401                   .
     2402                   case v-current-char
     2403                   :
     2404                       when "&":U
     2405                       then do:
     2406                           assign
     2407                               p-out-string = p-out-string + "&amp;":U
     2408                           .
     2409                       end.
     2410                       when ">":U
     2411                       then do:
     2412                           assign
     2413                               p-out-string = p-out-string + "&gt;":U
     2414                           .
     2415                       end.
     2416                       when "<":U
     2417                       then do:
     2418                           assign
     2419                               p-out-string = p-out-string + "&lt;":U
     2420                           .
     2421                       end.
     2422                       when "'":U
     2423                       then do:
     2424                           assign
     2425                               p-out-string = p-out-string + "&apos;":U
     2426                           .
     2427                       end.
     2428                       when '"':U
     2429                       then do:
     2430                           assign
     2431                               p-out-string = p-out-string + "&quot;":U
     2432                           .
     2433                       end.
     2434                       when chr(1)
     2435                       then do:
     2436                           assign
     2437                               p-out-string = p-out-string + "":U
     2438                           .
     2439                       end.
     2440                       when chr(2)
     2441                       then do:
     2442                           assign
     2443                               p-out-string = p-out-string + "":U
     2444                           .
     2445                       end.
     2446                       when chr(3)
     2447                       then do:
     2448                           assign
     2449                               p-out-string = p-out-string + "":U
     2450                           .
     2451                       end.
     2452                       when chr(4)
     2453                       then do:
     2454                           assign
     2455                               p-out-string = p-out-string + "":U
     2456                           .
     2457                       end.
     2458                       when chr(5)
     2459                       then do:
     2460                           assign
     2461                               p-out-string = p-out-string + "":U
     2462                           .
     2463                       end.
     2464                       when chr(6)
     2465                       then do:
     2466                           assign
     2467                               p-out-string = p-out-string + "":U
     2468                           .
     2469                       end.
     2470                       when chr(7)
     2471                       then do:
     2472                           assign
     2473                               p-out-string = p-out-string + "":U
     2474                           .
     2475                       end.
     2476                       when chr(8)
     2477                       then do:
     2478                           assign
     2479                               p-out-string = p-out-string + "":U
     2480                           .
     2481                       end.
     2482                       when chr(9)
     2483                       then do:
     2484                           assign
     2485                               p-out-string = p-out-string + "":U
     2486                           .
     2487                       end.
     2488                       when chr(29)
     2489                       then do:
     2490                           assign
     2491                               p-out-string = p-out-string + "":U
     2492                           .
     2493                       end.
     2494                       when chr(10)
     2495                       then do:
     2496                           assign
     2497                               p-out-string = p-out-string + "&#10;":U
     2498                           .
     2499                       end.
     2500                       when chr(13)
     2501                       then do:
     2502                           assign
     2503                               p-out-string = p-out-string + "&#13;":U
     2504                           .
     2505                       end.
     2506                       otherwise do:
     2507                           assign
     2508                               p-out-string = p-out-string + v-current-char
     2509                           .
     2510                       end.
     2511                   end case.
     2512               end.
     2513           end.
     2514       end case.
     2515   end.
     2516   end .
     2517   procedure xmlchar-encode-1c :
     2518   define input parameter p-in-string      as character        no-undo.
     2519   define output parameter p-out-string    as character        no-undo.
     2520       define variable v-position      as integer      no-undo.
     2521       define variable v-current-char  as character    no-undo.
