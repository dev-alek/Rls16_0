        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: calc-bal.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/calc-bal.p $":U .
        7   define variable vss-description as character no-undo init "пересчет текущего баланса по договору".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input  parameter p-type          as character no-undo .
       67   define input  parameter p-znak          as logical   no-undo .
       68   define input  parameter p-doc-type      as character no-undo .
       69   define input  parameter p-host-code     as integer   no-undo .
       70   define input  parameter p-contract-code as integer   no-undo .
       71   define input  parameter p-sum           as decimal   no-undo .
       72   define input  parameter p-sum-rubl      as decimal   no-undo .
       73   define input  parameter p-sum-base      as decimal   no-undo .
       74   define buffer buf_contract for ub.contract.
       75   find first buf_contract exclusive-lock
       76     where buf_contract.host-code     = p-host-code
       77       and buf_contract.contract-code = p-contract-code
       78   no-error .
       79   if available buf_contract then do:
       80     if p-type = "finob" then do:
       81       if p-znak then
       82         assign
       83           buf_contract.balance-fo      = buf_contract.balance-fo      + p-sum
       84           buf_contract.balance-fo-rubl = buf_contract.balance-fo-rubl + p-sum-rubl
       85           buf_contract.balance-fo-base = buf_contract.balance-fo-base + p-sum-base
       86         .
       87       else
       88         assign
       89           buf_contract.balance-fo      = buf_contract.balance-fo      - p-sum
       90           buf_contract.balance-fo-rubl = buf_contract.balance-fo-rubl - p-sum-rubl
       91           buf_contract.balance-fo-base = buf_contract.balance-fo-base - p-sum-base
       92         .
       93     end.
       94     else do:
       95       if p-doc-type = 'рпп':U or p-doc-type = 'рко':U or p-doc-type = 'апр':U  then assign p-znak = not p-znak .
       96       if p-znak then
       97         assign
       98           buf_contract.balance-plat      = buf_contract.balance-plat      + p-sum
       99           buf_contract.balance-plat-rubl = buf_contract.balance-plat-rubl + p-sum-rubl
      100           buf_contract.balance-plat-base = buf_contract.balance-plat-base + p-sum-base
      101         .
      102       else
      103         assign
      104           buf_contract.balance-plat      = buf_contract.balance-plat      - p-sum
      105           buf_contract.balance-plat-rubl = buf_contract.balance-plat-rubl - p-sum-rubl
      106           buf_contract.balance-plat-base = buf_contract.balance-plat-base - p-sum-base
      107         .
      108     end.
      109   end.
