     1039       end.
     1040   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1042     (input  p-artic
     1043     ,input  p-prod-type
     1044     ,input  p-prod-code
     1045     ,input  'twounit=request':u
     1046     ,output v-goods-twounit
     1047     ) no-error .
     1048       if error-status :error
     1049       then do:
     1050         message
     1051           vss-workfile vss-revision vss-description skip
     1052           vss-include-info4 skip
     1053           "Ошибка при определении атрибута товара" skip
     1054           "Артикул" p-artic p-prod-type p-prod-code skip
     1055           "twounit=request" skip
     1056           error-status :get-message(1) skip
     1057           return-value skip
     1058           view-as alert-box error .
     1059         undo, return error return-value .
     1060       end.
     1061       for each buf_doc-line no-lock
     1062         where buf_doc-line.obj-type   = p-obj-type
     1063           and buf_doc-line.obj-code   = p-obj-code
     1064           and buf_doc-line.artic      = p-artic
     1065           and buf_doc-line.prod-type  = p-prod-type
     1066           and buf_doc-line.prod-code  = p-prod-code
     1067           and buf_doc-line.status_    = 'факт':U
     1068           and buf_doc-line.fact-order > p-start-fact-order
     1069           and buf_doc-line.fact-order <= p-end-fact-order
     1070       on error undo, return error
     1071       :
     1072         run partslib-process-document in this-procedure
     1073           (input  buf_doc-line.doc-code
     1074           ,input  p-obj-type
     1075           ,input  p-obj-code
     1076           ,input  p-artic
     1077           ,input  p-prod-type
     1078           ,input  p-prod-code
     1079           ,input  v-goods-gds-goods
     1080           ,input  v-goods-twounit
     1081           ,output v-total-parts-qnty
     1082           ) no-error .
     1083         if error-status :error
     1084         then do:
     1085           message
     1086             vss-workfile vss-revision vss-description skip
     1087             vss-include-info4 skip
     1088             "Ошибка при вызове процедуры partslib-process-document" skip
     1089             "Документ" buf_doc-line.doc-code skip
     1090             "Объект" p-obj-type p-obj-code skip
     1091             "Артикул" p-artic p-prod-type p-prod-code skip
     1092             "p-start-fact-order" p-start-fact-order skip
     1093             "p-end-fact-order" p-end-fact-order skip
     1094             error-status :get-message(1) skip
     1095             return-value skip
     1096             view-as alert-box error .
     1097           undo, return error return-value .
     1098         end.
     1099       end.
     1100     end.
     1101   end procedure.
     1102   procedure partslib-process-document :
     1103     define input  parameter p-doc-code         as character no-undo .
     1104     define input  parameter p-obj-type         as character no-undo .
     1105     define input  parameter p-obj-code         as integer   no-undo .
     1106     define input  parameter p-artic            as character no-undo .
     1107     define input  parameter p-prod-type        as character no-undo .
     1108     define input  parameter p-prod-code        as integer   no-undo .
     1109     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1110     define input  parameter p-goods-twounit    as logical   no-undo .
     1111     define output parameter p-total-parts-qnty as decimal   no-undo .
     1112     define variable v-parts-sign as integer   no-undo .
     1113     define buffer buf_trn-doc    for ub.trn-doc .
     1114     define buffer buf_doc-line   for ub.doc-line .
     1115     define buffer buf_parts      for ub.parts .
     1116     define buffer buf_temp-parts for temp-parts .
     1117     do
     1118     on error undo, return error return-value
     1119     :
     1120       find first buf_trn-doc no-lock
     1121         where buf_trn-doc.doc-code = p-doc-code
     1122         no-error .
     1123       if not available buf_trn-doc
     1124       then do:
     1125         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1126                                      ,p-doc-code
     1127                                      ) .
     1128       end.
     1129       case buf_trn-doc.doc-type
     1130       :
     1131         when 'при':U or
     1132         when 'возврат':U or
     1133         when 'инв':U
     1134         then do:
     1135           assign
     1136             v-parts-sign = -1
     1137           .
     1138         end.
     1139         when 'рас':U or
     1140         when 'спи':U
     1141         then do:
     1142           assign
     1143             v-parts-sign = 1
     1144           .
     1145         end.
     1146         otherwise do:
     1147           undo, return error substitute("Неизвестный тип документа &1"
     1148                                       ,buf_trn-doc.doc-type
     1149                                       ) .
     1150         end.
     1151       end.
     1152       find first buf_doc-line no-lock
     1153         where buf_doc-line.doc-code  = p-doc-code
     1154           and buf_doc-line.artic     = p-artic
     1155           and buf_doc-line.prod-type = p-prod-type
     1156           and buf_doc-line.prod-code = p-prod-code
     1157         no-error .
     1158       if not available buf_doc-line
     1159       then do:
     1160         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1161                                      ,p-doc-code
     1162                                      ,artic
     1163                                      ,prod-type
     1164                                      ,prod-code
     1165                                      ) .
     1166       end.
     1167       assign
     1168         p-total-parts-qnty = 0
     1169       .
     1170       if p-goods-gds-goods = true
     1171       then do:
     1172         for each buf_parts no-lock
     1173           where buf_parts.out-code  = p-doc-code
     1174             and buf_parts.obj-type  = p-obj-type
     1175             and buf_parts.obj-code  = p-obj-code
     1176             and buf_parts.artic     = p-artic
     1177             and buf_parts.prod-type = p-prod-type
     1178             and buf_parts.prod-code = p-prod-code
     1179         on error undo, return error
     1180         :
     1181           run partslib-create-temp-parts in this-procedure
     1182             (buffer buf_parts
     1183             ,buffer buf_temp-parts
     1184             ,input  p-goods-twounit
     1185             ) .
     1186           assign
     1187             p-total-parts-qnty        = p-total-parts-qnty
     1188                                       + v-parts-sign * buf_parts.fact-qnty
     1189             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1190                                       + v-parts-sign * buf_parts.fact-qnty
     1191             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1192                                       + v-parts-sign * buf_parts.fact-qnty
     1193             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1194                                       + v-parts-sign * buf_parts.cli-qnty
     1195           .
     1196           if buf_temp-parts.qnty = 0
     1197           then do:
     1198             delete buf_temp-parts .
     1199           end.
     1200         end.
     1201       end.
     1202       else do:
     1203         assign
     1204           p-total-parts-qnty = p-total-parts-qnty
     1205                              + v-parts-sign * buf_doc-line.fact-qnty
     1206         .
     1207       end.
     1208     end.
     1209   end procedure.
     1210   procedure partslib-init-temp-parts-by-date :
     1211     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1212     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1213     define input parameter p-artic           like ub.parts.artic     no-undo .
     1214     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1215     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1216     define input parameter p-fact-date       as date      no-undo .
     1217     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1218     do
     1219     on error undo, return error
     1220     :
     1221       define variable v-fact-order                as decimal   no-undo .
     1222       define variable v-shift-end-fact-order      as decimal   no-undo .
     1223       define variable v-day-end-fact-order        as decimal   no-undo .
     1224       run factord in this-procedure
     1225         (input  p-fact-date
     1226         ,input  1
     1227         ,input  1
     1228         ,input  ?
     1229         ,input  0
     1230         ,input  false
     1231         ,output v-fact-order
     1232         ,output v-shift-end-fact-order
     1233         ,output v-day-end-fact-order
     1234         ) no-error .
     1235       if error-status :error
     1236       then do:
     1237         message
     1238           vss-workfile vss-revision vss-description skip
     1239           vss-include-info4 skip
     1240           "Ошибка при определении момента времени, на который требуется остаток" skip
     1241           "Объект" p-obj-type p-obj-code skip
     1242           "Артикул" p-artic p-prod-type p-prod-code skip
     1243           "Дата" p-fact-date skip
     1244           view-as alert-box error .
     1245         undo, return error .
     1246       end.
     1247       run partslib-init-temp-parts-by-factord in this-procedure
     1248         (input p-obj-type
     1249         ,input p-obj-code
     1250         ,input p-artic
     1251         ,input p-prod-type
     1252         ,input p-prod-code
     1253         ,input v-day-end-fact-order
     1254         ,input false
     1255         ) no-error .
     1256       if error-status :error
     1257       then do:
     1258         message
     1259           vss-workfile vss-revision vss-description skip
     1260           vss-include-info4 skip
     1261           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1262           "Объект" p-obj-type p-obj-code skip
     1263           "Артикул" p-artic p-prod-type p-prod-code skip
     1264           "Дата" p-fact-date skip
     1265           view-as alert-box error .
     1266         undo, return error .
     1267       end.
     1268     end.
     1269   end procedure.
     1270   procedure partslib-calc-cost :
     1271     define output parameter p-fact-qnty      as decimal   no-undo .
     1272     define output parameter p-vat-pc         as decimal   no-undo .
     1273     define output parameter p-slt-pc         as decimal   no-undo .
     1274     define output parameter p-sum-base       as decimal   no-undo .
     1275     define output parameter p-sum-rubl       as decimal   no-undo .
     1276     define output parameter p-vat-base       as decimal   no-undo .
     1277     define output parameter p-vat-rubl       as decimal   no-undo .
     1278     define output parameter p-slt-base       as decimal   no-undo .
     1279     define output parameter p-slt-rubl       as decimal   no-undo .
     1280     define output parameter p-road-tax-base  as decimal   no-undo .
     1281     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1282     define output parameter p-transport-base as decimal   no-undo .
     1283     define output parameter p-transport-rubl as decimal   no-undo .
     1284     define output parameter p-other-base     as decimal   no-undo .
     1285     define output parameter p-other-rubl     as decimal   no-undo .
     1286     define output parameter p-excise-base    as decimal   no-undo .
     1287     define output parameter p-excise-rubl    as decimal   no-undo .
     1288     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1289     do
     1290     on error undo, return error return-value
     1291     :
     1292       define buffer buf_temp-parts for temp-parts .
     1293       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1294       define buffer   in-vatp-parts    for ub.parts   .
     1295       define buffer   in-vatp-doc      for ub.trn-doc .
     1296       define buffer   in-vatp-goods    for ub.goods   .
     1297       define buffer   in-vatp-sysconf  for ub.sysconf .
     1298       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1299       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1300       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1301       define variable varinvprb                  as   character              no-undo.
     1302       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1303       define variable cli-base-rate              as   decimal                no-undo.
     1304       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1305       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1306       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1307       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1308       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1309       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1310       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1311       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1312       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1313       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1314       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1315       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1316       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1317       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1318       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1319       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1320       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1321       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1322       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1323       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1324       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1325       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1326       define variable varinvatp-envd             as   character              no-undo.
     1327       define variable varinvatp-type             as   character              no-undo.
     1328       for each buf_temp-parts
     1329       on error undo, return error
     1330       :
     1331   assign
     1332     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1333     price-base-with-tax-loc = buf_temp-parts.price-base
     1334   .
     1335   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1337     (output varinvprb
     1338     )  .
     1339     if buf_temp-parts.out-code = 'free-zone':U     or
     1340        buf_temp-parts.out-code = 'out-zone':U   or
     1341        buf_temp-parts.doc-type = 'акт':U then do:
     1342       assign
     1343         in-vatp-have-vat-slt = yes.
     1344     end.
     1345     else do:
     1346       find first in-vatp_doc-attr no-lock
     1347         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1348           and in-vatp_doc-attr.attr-code = 'envd':U
     1349         no-error .
     1350       if not available in-vatp_doc-attr then do:
     1351         assign
     1352           in-vatp-have-vat-slt = yes.
     1353       end.
     1354       else do:
     1355            in-vatp-have-vat-slt = no.
     1356       end.
     1357     end.
     1358     assign
     1359      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1360      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1361     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1362              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1363     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1364             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1365             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1366             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1367             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1368             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1369             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1370       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1371     assign
     1372       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1373     assign
     1374       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1375       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1376       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1377       transport-cli-loc  = 0
     1378       other-cli-loc      = 0
     1379     .
     1380   ASSIGN
     1381             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1382       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1383   .
     1384         assign
     1385           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1386           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1387           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1388           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1389           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1390           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1391           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1392           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1393           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1394           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1395           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1396           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1397           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1398           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1399           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1400           p-excise-base    = p-excise-base    + 0
     1401           p-excise-rubl    = p-excise-rubl    + 0
     1402         .
     1403       end.
     1404       if p-fact-qnty      = ?
     1405       or p-sum-base       = ?
     1406       or p-sum-rubl       = ?
     1407       or p-vat-base       = ?
     1408       or p-vat-rubl       = ?
     1409       or p-slt-base       = ?
     1410       or p-slt-rubl       = ?
     1411       or p-road-tax-base  = ?
     1412       or p-road-tax-rubl  = ?
     1413       or p-transport-base = ?
     1414       or p-transport-rubl = ?
     1415       or p-other-base     = ?
     1416       or p-other-rubl     = ?
     1417       or p-excise-base    = ?
     1418       or p-excise-rubl    = ?
     1419       then do:
     1420         message
     1421           vss-workfile vss-revision vss-description skip
     1422           vss-include-info4 skip
     1423           "Программа in-vatp.i вернула неопределенные значения" skip
     1424           "p-fact-qnty"      p-fact-qnty      skip
     1425           "p-sum-base"       p-sum-base       skip
     1426           "p-sum-rubl"       p-sum-rubl       skip
     1427           "p-vat-base"       p-vat-base       skip
     1428           "p-vat-rubl"       p-vat-rubl       skip
     1429           "p-slt-base"       p-slt-base       skip
     1430           "p-slt-rubl"       p-slt-rubl       skip
     1431           "p-road-tax-base"  p-road-tax-base  skip
     1432           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1433           "p-transport-base" p-transport-base skip
     1434           "p-transport-rubl" p-transport-rubl skip
     1435           "p-other-base"     p-other-base     skip
     1436           "p-other-rubl"     p-other-rubl     skip
     1437           "p-excise-base"    p-excise-base    skip
     1438           "p-excise-rubl"    p-excise-rubl    skip
     1439           view-as alert-box error .
     1440         undo, return error .
     1441       end.
     1442     end.
     1443   end procedure.
     1444   define variable num_rec        as integer   no-undo .
     1445   define variable start-time     as integer   no-undo .
     1446   define variable current-time   as character no-undo .
     1447   define variable current-action as character no-undo .
     1448   define variable v-description-ord-type as character no-undo .
     1449   define variable v-today as date      no-undo.
     1450   define variable v-time  as integer   no-undo.
     1451   define variable parobj-date   like c-price-doc.corr-date         no-undo .
     1452   define variable parshift-date like c-price-doc.corr-shift-date   no-undo .
     1453   define variable parshift-num  like c-price-doc.corr-shift-num    no-undo .
     1454   define variable parshift-name as character no-undo.
     1455   define frame a
     1456     ub.price-doc.doc-num                       label "Переоценка" skip
     1457     ub.price-doc.status_                       label "Статус" skip
     1458     current-action         format "x(40)"      no-label skip
     1459     num_rec                format ">>>>>>>9"   label "Обработано артикулов" skip
     1460     ub.price-list.artic                        label "Текущий артикул" skip
     1461     current-time           format "x(8)"       label "Время" skip
     1462     with view-as dialog-box side-labels three-d
     1463     title "Пересчет переоценки"
     1464     .
     1465   main-block :
     1466   do transaction
     1467   on error undo main-block, return error
     1468   :
     1469     find first ub.price-doc where ub.price-doc.doc-num = p-doc-num  no-lock no-error .
     1470     if not available ub.price-doc then do:
     1471       message
     1472         vss-workfile vss-revision vss-description skip
     1473         "Ошибка задания входных параметров" skip
     1474         "Номер переоценки " p-doc-num skip
     1475         error-status :get-message(1)
     1476         view-as alert-box error .
     1477       undo, return error.
     1478     end.
     1479     view frame a.
     1480       display
     1481       ub.price-doc.doc-num
     1482       ub.price-doc.status_
     1483       with frame a.
     1484     assign
     1485       current-action = "Копирование  шапки."
     1486     .
     1487     run show-action in this-procedure (current-action) .
     1488   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1490     (input  ub.price-doc.obj-type
     1491     ,input  ub.price-doc.obj-code
     1492     ,output parobj-date
     1493     ) no-error .
     1494       if error-status :error then do:
     1495         message
     1496           vss-workfile vss-revision vss-description skip
     1497           "Ошибка при определении дат на объекте" skip
     1498           "ПЕРЕОЦЕНКА" ub.price-doc.doc-num skip
     1499           error-status :get-message(1) skip
     1500           return-value skip
     1501           view-as alert-box error .
     1502   if session :set-wait-state( "" ) then.
     1503         undo main-block, return error .
     1504       end.
     1505   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     1507     (input  ub.price-doc.obj-type
     1508     ,input  ub.price-doc.obj-code
     1509     ,output parshift-date
     1510     ,output parshift-num
     1511     ,output parshift-name
     1512     ) no-error .
     1513       if error-status :error then do:
     1514           assign
     1515             parshift-date = ?
     1516             parshift-num = 0 .
     1517           .
     1518       end.
     1519     create c-price-doc.
     1520     BUFFER-COPY ub.price-doc to c-price-doc
     1521       assign
     1522       c-price-doc.chip-num        = next-value (s-corr-chip, ub)
     1523       c-price-doc.corr-man        = g#userid
     1524       c-price-doc.corr-date       = parobj-date
     1525       c-price-doc.corr-time       = v-time
     1526       c-price-doc.corr-user-db-num = g#db-num
     1527       c-price-doc.corr-shift-date = parshift-date
     1528       c-price-doc.corr-shift-num  = parshift-num
     1529       c-price-doc.corr-shift-name = parshift-name
     1530       c-price-doc.ps              = c-price-doc.PS + ": Копирование в архив"
     1531       c-price-doc.is-corr         = true
     1532       p-chip-num = c-price-doc.chip-num
     1533       no-error .
     1534       if error-status :error then do:
     1535         message
     1536           vss-workfile vss-revision vss-description skip
     1537           "Ошибка при копировании шапки переоценки" skip
     1538           "ПЕРЕОЦЕНКА" ub.price-doc.doc-num skip
     1539           error-status :get-message(1) skip
     1540           return-value skip
     1541           view-as alert-box error .
     1542   if session :set-wait-state( "" ) then.
     1543         undo main-block, return error .
     1544       end.
     1545     assign
     1546       current-action = "Копирование строк."
     1547     .
     1548     run show-action (current-action) .
     1549     for each  ub.price-list exclusive-lock
     1550         where ub.price-list.doc-num    = ub.price-doc.doc-num and
     1551               ub.price-list.main-price = true
     1552     on error undo main-block, return error
     1553     on end-key undo main-block, return error
     1554     :
     1555       run process-line in this-procedure no-error .
     1556       if error-status :error then do:
     1557         message
     1558           vss-workfile vss-revision vss-description skip
     1559           "Ошибка при копировании строки переоценки" skip
     1560           "ПЕРЕОЦЕНКА" ub.price-doc.doc-num skip
     1561           "Артикул" ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
     1562           error-status :get-message(1) skip
     1563           return-value skip
     1564           view-as alert-box error .
     1565   if session :set-wait-state( "" ) then.
     1566         undo main-block, return error .
     1567       end.
     1568     end.
     1569   end.
     1570   procedure show-action :
     1571     do
     1572     on error undo, return error
     1573     :
     1574       define input parameter p-action as character no-undo .
     1575       define variable v-today as date      no-undo.
     1576       define variable v-time  as integer   no-undo.
     1577       run cur-time in this-procedure ( output v-today
     1578                                      , output v-time
     1579                                      ).
     1580       assign
     1581         current-time = string(v-time - start-time, "HH:MM:SS")
     1582         current-action = p-action
     1583       .
     1584       display
     1585         current-time current-action
     1586         with frame a.
     1587     end.
     1588   end procedure.
     1589   procedure process-line :
     1590   do
     1591   on error undo, return error
     1592   :
     1593   define variable v-today as date      no-undo.
     1594   define variable v-time  as integer   no-undo.
     1595       assign
     1596         num_rec   = num_rec + 1
     1597       .
     1598       if num_rec mod 10 = 0 then do:
     1599         run cur-time in this-procedure ( output v-today
     1600                                        , output v-time ).
     1601         assign
     1602           current-time = string(v-time - start-time, "HH:MM:SS")
     1603         .
     1604         create c-price-list.
     1605         BUFFER-COPY ub.price-list to c-price-list
     1606         assign
     1607           c-price-list.chip-num           = c-price-doc.chip-num
     1608           c-price-list.corr-user-name     = g#userid
     1609           c-price-list.corr-date          = parobj-date
     1610           c-price-list.corr-time          = v-time
     1611           c-price-list.corr-user-db-num   = g#db-num
     1612         no-error .
     1613         if error-status :error then do:
     1614           message
     1615           vss-workfile vss-revision vss-description skip
     1616           "Ошибка при копировании строки переоценки BC" skip
     1617           "ПЕРЕОЦЕНКА" ub.price-doc.doc-num skip
     1618           "Артикул" ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
     1619           error-status :get-message(1) skip
     1620           return-value skip
     1621           view-as alert-box error .
     1622   if session :set-wait-state( "" ) then.
     1623         undo, return error .
     1624             end.
     1625         display
     1626           num_rec ub.price-list.artic  current-time current-action
     1627           with frame a.
     1628       end.
     1629     end.
     1630   end procedure .
