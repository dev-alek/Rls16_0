        1   block-level on error undo, throw.
        2   define input  parameter p-doc-num  like ub.price-doc.doc-num no-undo .
        3   define output parameter p-chip-num like ub.c-price-doc.chip-num no-undo .
        4   define variable p-corr-doc-code like ub.price-doc.doc-num no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: c-pr-crt.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/c-pr-crt.p $":U .
       10   define variable vss-description as character no-undo init "Копирование переоценки ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   procedure factord :
      307     define input  parameter p-fact-date            as date    no-undo .
      308     define input  parameter p-fact-time            as integer no-undo .
      309     define input  parameter p-fact-num             as integer no-undo .
      310     define input  parameter p-shift-date           as date    no-undo .
      311     define input  parameter p-shift-num            as integer no-undo .
      312     define input  parameter p-shift-on             as logical no-undo .
      313     define output parameter p-fact-order           as decimal no-undo .
      314     define output parameter p-shift-end-fact-order as decimal no-undo .
      315     define output parameter p-day-end-fact-order   as decimal no-undo .
      316     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      317     if p-fact-date = ?
      318     then do:
      319       return error "Не указана фактическая дата" .
      320     end.
      321     define variable v-fact-date-num as integer no-undo .
      322     assign
      323       v-fact-date-num = integer(p-fact-date)
      324     .
      325     if p-fact-num = ?
      326     or p-fact-num = 0
      327     then do:
      328       return error "Не задан p-fact-num " + string(p-fact-num) .
      329     end.
      330     if p-fact-num < 0
      331     then do:
      332       return error "Отрицательный fact-num " + string(p-fact-num) .
      333     end.
      334     if p-fact-num >= 100000000
      335     then do:
      336       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      337     end.
      338     if p-shift-on = true
      339     then do:
      340       if p-shift-date = ?
      341       then do:
      342         return error "Не задана дата смены" .
      343       end.
      344       if p-shift-num = ?
      345       or p-shift-num = 0
      346       then do:
      347         return error "Не задан номер смены" .
      348       end.
      349     end.
      350     else do:
      351       assign
      352         p-shift-date = p-fact-date
      353         p-shift-num  = 24
      354       .
      355     end.
      356     define variable v-shift-offset as integer no-undo .
      357     if p-shift-date = p-fact-date
      358     then do:
      359       assign
      360         v-shift-offset = 1
      361       .
      362     end.
      363     if p-shift-date < p-fact-date
      364     then do:
      365       assign
      366         v-shift-offset = 0
      367       .
      368     end.
      369     if p-shift-date > p-fact-date
      370     then do:
      371       message
      372         vss-workfile vss-revision vss-description skip
      373         "Неправильная дата закрытия смены" skip
      374         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      375         view-as alert-box error .
      376       undo, return error
      377         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      378           ,string(p-fact-date, '99/99/9999':U)
      379           ,string(p-shift-date, '99/99/9999':U)
      380           )
      381       .
      382     end.
      383     if p-shift-num < 1
      384     or p-shift-num > 24
      385     then do:
      386       message
      387         vss-workfile vss-revision vss-description skip
      388         "Неправильный номер смены" skip
      389         "p-shift-num" p-shift-num skip
      390         view-as alert-box error .
      391       undo, return error return-value .
      392     end.
      393     assign
      394       p-fact-order           = v-fact-date-num
      395                              + v-shift-offset * 0.5
      396                              + p-shift-num    * 0.02 - 0.01
      397                              + p-fact-num     * 0.0000000001
      398       p-shift-end-fact-order = v-fact-date-num
      399                              + v-shift-offset * 0.5
      400                              + p-shift-num    * 0.02
      401       p-day-end-fact-order   = v-fact-date-num
      402                              + 0.99
      403     .
      404     if p-fact-order           <= v-fact-date-num
      405     or p-shift-end-fact-order <= v-fact-date-num
      406     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      407     or p-shift-end-fact-order >= p-day-end-fact-order
      408     then do:
      409       message
      410         vss-workfile vss-revision vss-description skip
      411         "Внутренняя ошибка при генерации фактического номера" skip
      412         "p-fact-date"            p-fact-date            skip
      413         "p-fact-time"            p-fact-time            skip
      414         "p-fact-num"             p-fact-num             skip
      415         "p-shift-date"           p-shift-date           skip
      416         "p-shift-num"            p-shift-num            skip
      417         "p-shift-on"             p-shift-on             skip
      418         "p-shift-end-fact-order" p-shift-end-fact-order skip
      419         "p-day-end-fact-order"   p-day-end-fact-order   skip
      420         "v-fact-date-num"        v-fact-date-num        skip
      421         view-as alert-box error .
      422       undo, return error return-value .
      423     end.
      424   end procedure.
      425   procedure day-begin-fact-order :
      426     define input  parameter p-fact-date            as date    no-undo .
      427     define output parameter p-day-begin-fact-order as decimal no-undo .
      428     do
      429     on error undo, return error return-value
      430     :
      431       if p-fact-date = ?
      432       then do:
      433         assign
      434           p-day-begin-fact-order = 0
      435         .
      436       end.
      437       else do:
      438         assign
      439           p-day-begin-fact-order = integer(p-fact-date)
      440         .
      441       end.
      442     end.
      443   end procedure.
      444   procedure factord-max-fact-order :
      445     define output parameter p-max-fact-order as decimal   no-undo .
      446     do
      447     on error undo, return error return-value
      448     :
      449       run day-begin-fact-order in this-procedure
      450         (input  date(1, 1, 5000)
      451         ,output p-max-fact-order
      452         ) .
      453     end.
      454   end procedure.
      455   procedure factord-cut-archive :
      456     define input  parameter p-obj-type             as character no-undo .
      457     define input  parameter p-obj-code             as integer   no-undo .
      458     define input  parameter p-fact-date            as date      no-undo .
      459     define output parameter p-shift-on             as logical   no-undo .
      460     define output parameter p-shift-date           as date      no-undo .
      461     define output parameter p-shift-num            as integer   no-undo .
      462     define output parameter p-day-end-fact-order   as decimal   no-undo .
      463     define output parameter p-shift-end-fact-order as decimal   no-undo .
      464     define variable v-fact-order as decimal   no-undo .
      465     define buffer buf_shift-obj for ub.shift-obj .
      466     do
      467     on error undo, return error return-value
      468     :
      469   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      471     (input  p-obj-type
      472     ,input  p-obj-code
      473     ,input  'shift-on=request'
      474     ,output p-shift-on
      475     ) no-error .
      476       if error-status :error
      477       then do:
      478         message
      479           vss-workfile vss-revision vss-description skip
      480           "Ошибка при определении атрибута объекта" skip
      481           "Объект" p-obj-type p-obj-code skip
      482           error-status :get-message(1) skip
      483           return-value skip
      484           view-as alert-box error .
      485         undo, return error return-value .
      486       end.
      487       if p-shift-on = false
      488       then do:
      489         assign
      490           p-shift-date               = ?
      491           p-shift-num                = 0
      492         .
      493       end.
      494       else do:
      495         find first buf_shift-obj share-lock
      496           where buf_shift-obj.obj-type   = p-obj-type
      497             and buf_shift-obj.obj-code   = p-obj-code
      498             and buf_shift-obj.shift-date > p-fact-date
      499           use-index pi
      500           no-error .
      501         if not available buf_shift-obj
      502         or buf_shift-obj.status_ <> 'зкр':U
      503         then do:
      504           message
      505             vss-workfile vss-revision vss-description skip
      506             "Невозможно вычислить последнюю смену" skip
      507             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      508             "Объект" p-obj-type p-obj-code skip
      509             "Дата" p-fact-date skip
      510             view-as alert-box error .
      511           undo, return error return-value .
      512         end.
      513         find last buf_shift-obj share-lock
      514           where buf_shift-obj.obj-type = p-obj-type
      515             and buf_shift-obj.obj-code = p-obj-code
      516             and buf_shift-obj.shift-date <= p-fact-date
      517           use-index pi
      518           no-error .
      519         if available buf_shift-obj
      520         then do:
      521           if  buf_shift-obj.status_ = 'зкр':U
      522           then do:
      523             assign
      524               p-shift-date = buf_shift-obj.shift-date
      525               p-shift-num  = buf_shift-obj.shift-num
      526             .
      527           end.
      528           else do:
      529             message
      530               vss-workfile vss-revision vss-description skip
      531               "Невозможно вычислить последнюю смену" skip
      532               "Статус смены отличен от статуса" 'зкр':U skip
      533               "Объект" p-obj-type p-obj-code skip
      534               "Дата" p-fact-date skip
      535               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      536               view-as alert-box error .
      537             undo, return error return-value .
      538           end.
      539         end.
      540         else do:
      541           assign
      542             p-shift-date = p-fact-date - 1
      543             p-shift-num  = 1
      544           .
      545         end.
      546       end.
      547       run factord in this-procedure
      548         (input  p-fact-date
      549         ,input  1
      550         ,input  1
      551         ,input  p-shift-date
      552         ,input  p-shift-num
      553         ,input  p-shift-on
      554         ,output v-fact-order
      555         ,output p-shift-end-fact-order
      556         ,output p-day-end-fact-order
      557         ) no-error .
      558       if error-status :error
      559       then do:
      560         message
      561           vss-workfile vss-revision vss-description skip
      562           "Ошибка при вызове процедуры factord"
      563           error-status :get-message(1) skip
      564           return-value skip
      565           view-as alert-box error .
      566         undo, return error return-value .
      567       end.
      568     end.
      569   end procedure.
      570   procedure factord-lock-shift :
      571     define input  parameter p-obj-type  as character no-undo .
      572     define input  parameter p-obj-code  as integer   no-undo .
      573     define input  parameter p-fact-date as date      no-undo .
      574     define parameter buffer buf_shift-obj for ub.shift-obj .
      575     define variable v-shift-on      as logical   no-undo .
      576     define variable v-extra-message as character no-undo .
      577     define variable v-error as character no-undo .
      578     do
      579     on error undo, return error return-value
      580     :
      581   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      583     (input  p-obj-type
      584     ,input  p-obj-code
      585     ,input  'shift-on=request'
      586     ,output v-shift-on
      587     ) no-error .
      588       if error-status :error
      589       then do:
      590         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      591         undo, return error v-error .
      592       end.
      593       if v-shift-on = true
      594       then do:
      595         find first buf_shift-obj share-lock
      596           where buf_shift-obj.obj-type   = p-obj-type
      597             and buf_shift-obj.obj-code   = p-obj-code
      598             and buf_shift-obj.shift-date > p-fact-date
      599           use-index pi
      600           no-error .
      601         if not available buf_shift-obj
      602         or buf_shift-obj.status_ <> 'зкр':U
      603         then do:
      604           find last buf_shift-obj
      605             where buf_shift-obj.obj-type = p-obj-type
      606               and buf_shift-obj.obj-code = p-obj-code
      607               and buf_shift-obj.status_  = 'зкр':U
      608             use-index stts
      609             no-error .
      610           if available buf_shift-obj
      611           then do:
      612             assign
      613               v-extra-message =
      614                     substitute("Дата начала последеней закрытой смены на объекте &1"
      615                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      616                               )
      617             .
      618           end.
      619           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      620           undo, return error v-error .
      621         end.
      622       end.
      623     end.
      624   end procedure.
      625   procedure factord-end-day :
      626     define input  parameter p-fact-date            as date    no-undo .
      627     define output parameter p-day-end-fact-order   as decimal no-undo .
      628     do
      629     on error undo, return error return-value
      630     :
      631       if p-fact-date = ?
      632       then do:
      633         return error "Не указана фактическая дата" .
      634       end.
      635       assign
      636         p-day-end-fact-order = integer(p-fact-date) + 0.99
      637       .
      638     end.
      639   end procedure.
      640   procedure factord-to-date :
      641     define input  parameter p-fact-order as decimal no-undo .
      642     define output parameter p-fact-date  as date    no-undo .
      643     define variable v-ref-date  as date      no-undo .
      644     define variable v-ref-delta as integer   no-undo .
      645     do
      646     on error undo, return error return-value
      647     :
      648       if p-fact-order = ?
      649       or p-fact-order = 0
      650       then do:
      651         return error "Не указан fact-order" .
      652       end.
      653       assign
      654         v-ref-date  = date(1, 1, 2000)
      655       .
      656       assign
      657         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      658       .
      659       assign
      660         p-fact-date = v-ref-date + v-ref-delta
      661       .
      662     end.
      663   end procedure.
      664   procedure factord-to-fact-num :
      665     define input  parameter p-fact-order as decimal no-undo .
      666     define output parameter p-fact-num   as integer no-undo .
      667     define variable v-fact-order-trunc as decimal no-undo .
      668     do
      669     on error undo, return error return-value
      670     :
      671       if p-fact-order = ?
      672       or p-fact-order = 0
      673       then do:
      674         return error "Не указан fact-order" .
      675       end.
      676       assign
      677        v-fact-order-trunc = truncate(p-fact-order, 2)
      678       .
      679       assign
      680         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      681       .
      682     end.
      683   end procedure.
      684   procedure factord-to-shift-num :
      685     define input  parameter p-fact-order as decimal no-undo .
      686     define output parameter p-shift-num   as integer no-undo .
      687     define variable  p-shift-numd  as decimal   no-undo .
      688     define variable v-fact-order-trunc as decimal no-undo .
      689     do
      690     on error undo, return error return-value
      691     :
      692       if p-fact-order = ?
      693       or p-fact-order = 0
      694       then do:
      695         return error "Не указан fact-order" .
      696       end.
      697       assign
      698        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      699       .
      700       if v-fact-order-trunc < 0.5 then do:
      701         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      702       end.
      703       assign
      704         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      705         .
      706        assign
      707         p-shift-num = truncate (p-shift-numd , 0)
      708       .
      709     end.
      710   end procedure.
      711   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      713   procedure partslib-clear-temp-parts :
      714     define buffer buf_temp-parts for temp-parts .
      715     do
      716     on error undo, return error
      717     :
      718       for each buf_temp-parts
      719       on error undo, return error
      720       :
      721         delete buf_temp-parts .
      722       end.
      723     end.
      724   end procedure.
      725   procedure partslib-create-temp-parts :
      726     define parameter buffer buf_parts       for ub.parts .
      727     define parameter buffer buf_temp-parts  for temp-parts .
      728     define input  parameter p-goods-twounit as logical   no-undo .
      729     define variable v-base-part-code as character no-undo .
      730     do
      731     on error undo, return error
      732     :
      733       if p-goods-twounit = true
      734       then do:
      735         assign
      736           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      737         .
      738       end.
      739       else do:
      740         assign
      741           v-base-part-code = buf_parts.part-code
      742         .
      743       end.
      744       find first buf_temp-parts exclusive-lock
      745         where buf_temp-parts.obj-type  = buf_parts.obj-type
      746           and buf_temp-parts.obj-code  = buf_parts.obj-code
      747           and buf_temp-parts.artic     = buf_parts.artic
      748           and buf_temp-parts.prod-type = buf_parts.prod-type
      749           and buf_temp-parts.prod-code = buf_parts.prod-code
      750           and buf_temp-parts.in-code   = buf_parts.in-code
      751           and buf_temp-parts.out-code  = 'free-zone':U
      752           and buf_temp-parts.part-code = v-base-part-code
      753         no-error.
      754       if not available buf_temp-parts
      755       then do:
      756         create buf_temp-parts .
      757         buffer-copy buf_parts to buf_temp-parts
      758         assign
      759           buf_temp-parts.out-code  = 'free-zone':U
      760           buf_temp-parts.part-code = v-base-part-code
      761           buf_temp-parts.rsrv-free = yes
      762           buf_temp-parts.status_   = no
      763           buf_temp-parts.qnty      = 0
      764           buf_temp-parts.fact-qnty = 0
      765           buf_temp-parts.real-qnty = 0
      766           buf_temp-parts.cli-qnty  = 0
      767         .
      768       end.
      769     end.
      770   end procedure.
      771   procedure partslib-init-temp-parts :
      772     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      773     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      774     define input parameter p-artic           like ub.parts.artic     no-undo .
      775     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      776     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      777     define buffer buf_parts      for ub.parts .
      778     define buffer buf_temp-parts for temp-parts .
      779     define variable v-goods-twounit    as logical   no-undo .
      780     do
      781     on error undo, return error
      782     :
      783   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      785     (input  p-artic
      786     ,input  p-prod-type
      787     ,input  p-prod-code
      788     ,input  'twounit=request':u
      789     ,output v-goods-twounit
      790     ) no-error .
      791       if error-status :error
      792       then do:
      793         message
      794           vss-workfile vss-revision vss-description skip
      795           vss-include-info4 skip
      796           "Ошибка при определении атрибута товара" skip
      797           "Артикул" p-artic p-prod-type p-prod-code skip
      798           "twounit=request" skip
      799           error-status :get-message(1) skip
      800           return-value skip
      801           view-as alert-box error .
      802         undo, return error return-value .
      803       end.
      804       run partslib-clear-temp-parts in this-procedure .
      805       for each buf_parts
      806         where buf_parts.obj-type  = p-obj-type
      807           and buf_parts.obj-code  = p-obj-code
      808           and buf_parts.artic     = p-artic
      809           and buf_parts.prod-type = p-prod-type
      810           and buf_parts.prod-code = p-prod-code
      811           and buf_parts.rsrv-free = yes
      812           and buf_parts.status_   = no
      813           and buf_parts.in-code   <> buf_parts.out-code
      814       on error undo, return error
      815       :
      816         run partslib-create-temp-parts in this-procedure
      817           (buffer buf_parts
      818           ,buffer buf_temp-parts
      819           ,input  v-goods-twounit
      820           ) .
      821         define variable v-parts-qnty          as decimal   no-undo .
      822         define variable v-parts-cli-qnty      as decimal   no-undo .
      823         define variable v-parts-free-qnty     as decimal   no-undo .
      824         define variable v-parts-free-cli-qnty as decimal   no-undo .
      825         if buf_parts.out-code = 'free-zone':U
      826         then do:
      827           assign
      828             v-parts-qnty          = buf_parts.qnty
      829             v-parts-cli-qnty      = buf_parts.cli-qnty
      830             v-parts-free-qnty     = buf_parts.qnty
      831             v-parts-free-cli-qnty = buf_parts.cli-qnty
      832           .
      833         end.
      834         else do:
      835           assign
      836             v-parts-qnty          = abs(buf_parts.qnty)
      837             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      838             v-parts-free-qnty     = 0
      839             v-parts-free-cli-qnty = 0
      840           .
      841         end.
      842         assign
      843           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      844           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      845           buf_temp-parts.real-qnty     = 0
      846           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      847           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      848           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      849         .
      850       end.
      851     end.
      852   end procedure.
      853   procedure partslib-init-temp-parts-by-factord :
      854     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      855     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      856     define input parameter p-artic              like ub.parts.artic     no-undo .
      857     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      858     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      859     define input parameter p-fact-order         as decimal   no-undo .
      860     define input parameter p-include-fact-order as logical   no-undo .
      861     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      862     define buffer buf_gds-obj  for ub.gds-obj .
      863     do
      864     on error undo, return error
      865     :
      866       do transaction
      867       on error undo, return error
      868       :
      869   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      871     (input  p-obj-type
      872     ,input  p-obj-code
      873     ,input  p-artic
      874     ,input  p-prod-type
      875     ,input  p-prod-code
      876     ,buffer buf_gds-obj
      877     ) no-error .
      878         if error-status :error
      879         then do:
      880           message
      881             vss-workfile vss-revision vss-description skip
      882             vss-include-info4 skip
      883             "Невозможно найти товар на объекте" skip
      884             "Объект" p-obj-type p-obj-code skip
      885             "Артикул" p-artic p-prod-type p-prod-code skip
      886             error-status :get-message(1) skip
      887             return-value skip
      888             view-as alert-box error .
      889           undo, return error .
      890         end.
      891         find current buf_gds-obj exclusive-lock .
      892       end.
      893       run partslib-init-temp-parts in this-procedure
      894         (input p-obj-type
      895         ,input p-obj-code
      896         ,input p-artic
      897         ,input p-prod-type
      898         ,input p-prod-code
      899         ) no-error .
      900       if error-status :error
      901       then do:
      902         message
      903           vss-workfile vss-revision vss-description skip
      904           vss-include-info4 skip
      905           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      906           "Объект" p-obj-type p-obj-code skip
      907           "Артикул" p-artic p-prod-type p-prod-code skip
      908           "p-fact-order" p-fact-order skip
      909           view-as alert-box error .
      910         undo, return error .
      911       end.
      912       if p-include-fact-order = true
      913       then do:
      914         assign
      915           p-fact-order = p-fact-order - 0.0000000001
      916         .
      917       end.
      918       define variable v-max-fact-order as character no-undo .
      919       run factord-max-fact-order in this-procedure
      920         (output v-max-fact-order
      921         ) no-error .
      922       if error-status :error
      923       then do:
      924         message
      925           vss-workfile vss-revision vss-description skip
      926           vss-include-info4 skip
      927           "Ошибка при вызове процедуры factord-max-fact-order" skip
      928           "Объект" p-obj-type p-obj-code skip
      929           "Артикул" p-artic p-prod-type p-prod-code skip
      930           "p-fact-order" p-fact-order skip
      931           view-as alert-box error .
      932         undo, return error .
      933       end.
      934       run partslib-update-by-factord in this-procedure
      935         (input p-obj-type
      936         ,input p-obj-code
      937         ,input p-artic
      938         ,input p-prod-type
      939         ,input p-prod-code
      940         ,input p-fact-order
      941         ,input v-max-fact-order
      942         ,input false
      943         ) no-error .
      944       if error-status :error
      945       then do:
      946         message
      947           vss-workfile vss-revision vss-description skip
      948           vss-include-info4 skip
      949           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      950           "Объект" p-obj-type p-obj-code skip
      951           "Артикул" p-artic p-prod-type p-prod-code skip
      952           "p-fact-order" p-fact-order skip
      953           "v-max-fact-order" v-max-fact-order skip
      954           view-as alert-box error .
      955         undo, return error .
      956       end.
      957     end.
      958   end procedure.
      959   procedure partslib-update-by-factord :
      960     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      961     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      962     define input parameter p-artic              like ub.parts.artic     no-undo .
      963     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      964     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      965     define input parameter p-start-fact-order   as decimal   no-undo .
      966     define input parameter p-end-fact-order     as decimal   no-undo .
      967     define input parameter p-lock-gds-obj       as logical   no-undo .
      968     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      969     define buffer buf_gds-obj  for ub.gds-obj .
      970     define buffer buf_doc-line for ub.doc-line .
      971     define variable v-total-parts-qnty as decimal   no-undo .
      972     define variable v-goods-gds-goods  as logical   no-undo .
      973     define variable v-goods-twounit    as logical   no-undo .
      974     do
      975     on error undo, return error
      976     :
      977       if p-start-fact-order > p-end-fact-order
      978       then do:
      979         message
      980           vss-workfile vss-revision vss-description skip
      981           vss-include-info4 skip
      982           "Ошибка задания входных параметров" skip
      983           "Начало интервала превышает конец интервала" skip
      984           "Объект" p-obj-type p-obj-code skip
      985           "Артикул" p-artic p-prod-type p-prod-code skip
      986           "p-start-fact-order" p-start-fact-order skip
      987           "p-end-fact-order"   p-end-fact-order skip
      988           view-as alert-box error .
      989         undo, return error .
      990       end.
      991       if p-lock-gds-obj = true
      992       then do:
      993         do transaction
      994         on error undo, return error
      995         :
      996   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      998     (input  p-obj-type
      999     ,input  p-obj-code
     1000     ,input  p-artic
     1001     ,input  p-prod-type
     1002     ,input  p-prod-code
     1003     ,buffer buf_gds-obj
     1004     ) no-error .
     1005           if error-status :error
     1006           then do:
     1007             message
     1008               vss-workfile vss-revision vss-description skip
     1009               vss-include-info4 skip
     1010               "Невозможно найти gds-obj" skip
     1011               error-status :get-message(1) skip
     1012               return-value skip
     1013               view-as alert-box error .
     1014             undo, return error .
     1015           end.
     1016           find current buf_gds-obj exclusive-lock .
     1017         end.
     1018       end.
     1019   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1021     (input  p-artic
     1022     ,input  p-prod-type
     1023     ,input  p-prod-code
     1024     ,input  'gds-goods=request':u
     1025     ,output v-goods-gds-goods
     1026     ) no-error .
     1027       if error-status :error
     1028       then do:
     1029         message
     1030           vss-workfile vss-revision vss-description skip
     1031           vss-include-info4 skip
     1032           "Ошибка при определении атрибута товара" skip
     1033           "Артикул" p-artic p-prod-type p-prod-code skip
     1034           "gds-goods=request" skip
     1035           error-status :get-message(1) skip
