      402                                   , chr(10)
      403                                   , vss-workfile
      404                                   , return-value
      405                                   , error-status :get-message ( 1 ) ).
      406           end.
      407       end.
      408     end.
      409   end.
      410   else do:
      411     undo-current:
      412     do transaction on error undo undo-current, return on stop undo undo-current, return:
      413       buf_shift-obj.status_ = 'ожд':U.
      414     end.
      415   end.
      416   run mainmenu-disp-mutable in parparentproc (
      417       output v-cur-date-error-code
      418   ).
      419   message
      420     "Смена отменена." skip
      421     "Дата начала смены:" s-date skip
      422     "Номер смены:" s-name skip
      423     "Порядок смены:" s-num
      424     view-as alert-box.
      425   procedure check-opened-docs :
      426   define input parameter p-db-num     as integer          no-undo.
      427   define input parameter p-obj-type   as character        no-undo.
      428   define input parameter p-obj-code   as integer          no-undo.
      429   define input parameter p-shift-date as date             no-undo.
      430   define input parameter p-shift-num  as integer          no-undo.
      431   define output parameter p-have-docs as logical          no-undo.
      432   define output parameter p-doc-type  as character        no-undo.
      433   define output parameter p-doc-code  as character        no-undo.
      434   define output parameter p-comment   as character        no-undo.
      435       define variable v-host-code    as integer      no-undo.
      436       define buffer buf_inkas         for ub.inkas.
      437       define buffer buf_rvs-doc       for ub.rvs-doc.
      438       define buffer buf_trn-doc       for ub.trn-doc.
      439       define buffer buf_price-doc     for ub.price-doc.
      440       define buffer buf_fbr-doc       for ub.fbr-doc.
      441       define buffer buf_chk-doc       for ub.chk-doc.
      442       define buffer buf_icnt-doc      for ub.icnt-doc.
      443       define buffer buf_wth-doc       for ub.wth-doc.
      444       define buffer buf_ord-doc-rcv   for ub.ord-doc-rcv.
      445       define buffer buf_cash-desk     for ub.cash-desk.
      446       define buffer buf_ord-doc       for ub.ord-doc.
      447   do
      448   for buf_inkas
      449     , buf_rvs-doc
      450     , buf_trn-doc
      451     , buf_price-doc
      452     , buf_fbr-doc
      453     , buf_chk-doc
      454     , buf_icnt-doc
      455     , buf_wth-doc
      456     , buf_ord-doc-rcv
      457     , buf_cash-desk
      458     , buf_ord-doc
      459   on error undo, return error
      460   :
      461       assign
      462           p-have-docs = no
      463           p-doc-type = "":U
      464           p-doc-code = "":U
      465       .
      466   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      468     (input  p-obj-type
      469     ,input  p-obj-code
      470     ,output v-host-code
      471     )  .
      472       find first buf_rvs-doc no-lock
      473            where buf_rvs-doc.obj-type   = p-obj-type
      474              and buf_rvs-doc.obj-code   = p-obj-code
      475              and buf_rvs-doc.shift-date = p-shift-date
      476              and buf_rvs-doc.shift-num  = p-shift-num
      477              and buf_rvs-doc.status_    = 'факт':U
      478       no-error.
      479       if available buf_rvs-doc
      480       then do:
      481           assign
      482               p-have-docs = yes
      483               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "закрытая сверка"
      484               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_rvs-doc.rvs-code
      485           .
      486       end.
      487       find first buf_inkas no-lock
      488            where buf_inkas.host-code  = v-host-code
      489              and buf_inkas.obj-type   = p-obj-type
      490              and buf_inkas.obj-code   = p-obj-code
      491              and buf_inkas.shift-date = p-shift-date
      492              and buf_inkas.shift-num  = p-shift-num
      493       no-error.
      494       if available buf_inkas
      495       then do:
      496           assign
      497               p-have-docs = yes
      498               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "продажа"
      499               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_inkas.inkas-code
      500           .
      501       end.
      502       find first buf_trn-doc no-lock
      503            where buf_trn-doc.obj-type   = p-obj-type
      504              and buf_trn-doc.obj-code   = p-obj-code
      505              and buf_trn-doc.shift-date = p-shift-date
      506              and buf_trn-doc.shift-num  = p-shift-num
      507       no-error.
      508       if available buf_trn-doc
      509       then do:
      510           assign
      511               p-have-docs = yes
      512               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "складской"
      513               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_trn-doc.doc-code
      514           .
      515       end.
      516       find first buf_price-doc no-lock
      517            where buf_price-doc.obj-type   = p-obj-type
      518              and buf_price-doc.obj-code   = p-obj-code
      519              and buf_price-doc.shift-date = p-shift-date
      520              and buf_price-doc.shift-num  = p-shift-num
      521       no-error.
      522       if available buf_price-doc
      523       then do:
      524           assign
      525               p-have-docs = yes
      526               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "переоценка"
      527               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_price-doc.doc-num
      528           .
      529       end.
      530       find first buf_fbr-doc no-lock
      531            where buf_fbr-doc.obj-type   = p-obj-type
      532              and buf_fbr-doc.obj-code   = p-obj-code
      533              and buf_fbr-doc.shift-date = p-shift-date
      534              and buf_fbr-doc.shift-num  = p-shift-num
      535       no-error.
      536       if available buf_fbr-doc
      537       then do:
      538           assign
      539               p-have-docs = yes
      540               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "производство"
      541               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_fbr-doc.doc-code
      542           .
      543       end.
      544       find first buf_chk-doc no-lock
      545            where buf_chk-doc.obj-type   = p-obj-type
      546              and buf_chk-doc.obj-code   = p-obj-code
      547              and buf_chk-doc.shift-date = p-shift-date
      548              and buf_chk-doc.shift-num  = p-shift-num
      549       no-error.
      550       if available buf_chk-doc
      551       then do:
      552           assign
      553               p-have-docs = yes
      554               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "чек"
      555               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_chk-doc.doc-code
      556           .
      557       end.
      558       find first buf_icnt-doc no-lock
      559            where buf_icnt-doc.obj-type   = p-obj-type
      560              and buf_icnt-doc.obj-code   = p-obj-code
      561              and buf_icnt-doc.shift-date = p-shift-date
      562              and buf_icnt-doc.shift-num  = p-shift-num
      563       no-error.
      564       if available buf_icnt-doc
      565       then do:
      566           assign
      567               p-have-docs = yes
      568               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "инв.счетчик ТРК"
      569               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_icnt-doc.doc-code
      570           .
      571       end.
      572       find first buf_wth-doc no-lock
      573            where buf_wth-doc.obj-type   = p-obj-type
      574              and buf_wth-doc.obj-code   = p-obj-code
      575              and buf_wth-doc.shift-date = p-shift-date
      576              and buf_wth-doc.shift-num  = p-shift-num
      577       no-error.
      578       if available buf_wth-doc
      579       then do:
      580           assign
      581               p-have-docs = yes
      582               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "перем.матценн."
      583               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_wth-doc.doc-code
      584           .
      585       end.
      586       find first buf_ord-doc-rcv no-lock
      587            where buf_ord-doc-rcv.obj-type   = p-obj-type
      588              and buf_ord-doc-rcv.obj-code   = p-obj-code
      589              and buf_ord-doc-rcv.shift-date = p-shift-date
      590              and buf_ord-doc-rcv.shift-num  = p-shift-num
      591       no-error.
      592       if available buf_ord-doc-rcv
      593       then do:
      594           assign
      595               p-have-docs = yes
      596               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "Поставка по заказам"
      597               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_ord-doc-rcv.doc-code
      598           .
      599       end.
      600       find first buf_ord-doc no-lock
      601            where buf_ord-doc.obj-type   = p-obj-type
      602              and buf_ord-doc.obj-code   = p-obj-code
      603              and buf_ord-doc.shift-date = p-shift-date
      604              and buf_ord-doc.shift-num  = p-shift-num
      605       no-error.
      606       if available buf_ord-doc
      607       then do:
      608           assign
      609               p-have-docs = yes
      610               p-doc-type  = ( if p-doc-type = "":U then "":U else ",":U ) + "заказ"
      611               p-doc-code  = ( if p-doc-code = "":U then "":U else ",":U ) + buf_ord-doc.doc-code
      612           .
      613       end.
      614   end.
      615   end procedure.
