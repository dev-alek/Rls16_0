      230   find first buf_shift-obj where
      231              buf_shift-obj.obj-type = p-curr-obj-type and
      232              buf_shift-obj.obj-code = p-curr-obj-code and
      233              buf_shift-obj.status_ = 'тек':U
      234              use-index pi no-error.
      235   if available buf_shift-obj then
      236     is-closed = no.
      237   else do:
      238     find last buf_shift-obj where
      239               buf_shift-obj.obj-type = p-curr-obj-type and
      240               buf_shift-obj.obj-code = p-curr-obj-code and
      241               buf_shift-obj.status_ = 'зкр':U
      242               use-index pi no-error.
      243     if available buf_shift-obj then
      244       is-closed = yes.
      245     else do:
      246       message
      247         "На текущем объекте не найдено ни одной смены." skip
      248         "Нечего отменять."
      249         view-as alert-box.
      250       return.
      251     end.
      252   end.
      253   assign
      254     s-date = buf_shift-obj.shift-date
      255     s-num  = buf_shift-obj.shift-num
      256     s-name = buf_shift-obj.shift-name
      257   .
      258   If not is-closed then do:
      259       run check-opened-docs in this-procedure (
      260             input v-cntxt-db-num
      261           , input buf_shift-obj.obj-type
      262           , input buf_shift-obj.obj-code
      263           , input buf_shift-obj.shift-date
      264           , input buf_shift-obj.shift-num
      265           , output v-have-docs
      266           , output v-doc-type
      267           , output v-doc-code
      268           , output v-comment
      269       ).
      270       if v-have-docs = yes
      271       then do:
      272           for each ub.shift-staff no-lock where ub.shift-staff.obj-type = buf_shift-obj.obj-type
      273                                             and ub.shift-staff.obj-code = buf_shift-obj.obj-code
      274                                             and ub.shift-staff.shift-num = buf_shift-obj.shift-num
      275                                             and ub.shift-staff.shift-date = buf_shift-obj.shift-date
      276                                             and ub.shift-staff.next-shift = no :
      277               if ub.shift-staff.staff-role
      278               then
      279               assign
      280                   v-shift-manager = ub.shift-staff.name
      281               .
      282               else
      283               assign
      284                   v-shift-staff-list = v-shift-staff-list + (if v-shift-staff-list = "" then "" else ", ") + ub.shift-staff.name
      285               .
      286           end.
      287           v-vid-action = 53 .
      288           v-vid-param = "SHOP_NUM=" + string(buf_shift-obj.obj-code) + chr(4) +
      289                         "SHIFT_NUM=" + string(buf_shift-obj.shift-num) + string(buf_shift-obj.shift-date, "99999999") + chr(4) +
      290                         "ShiftManager=" + v-shift-manager + chr(4) +
      291                         "ShiftStaff=" + v-shift-staff-list + chr(4) +
      292                         "RESULT=1" + chr(4) +
      293                         "Description=Нельзя отменить смену. На объекте есть  документы.".
      294           run trg/userlog.p (
      295                 input 'update_err':U
      296               , input 'shift-obj':U
      297               , input ( buffer buf_shift-obj :handle )
      298               , input v-vid-action
      299               , input v-vid-param
      300           ) no-error.
      301           if error-status :error
      302           then do:
      303               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      304                                   , chr(10)
      305                                   , vss-workfile
      306                                   , return-value
      307                                   , error-status :get-message ( 1 ) ).
      308           end.
      309           message
      310               "Нельзя отменить смену. На объекте есть  документы."
      311               skip (1)
      312               skip "Объект:" p-curr-obj-type p-curr-obj-code
      313               skip "Тип документов:   " v-doc-type
      314               skip "Номера документов:" v-doc-code
      315               skip v-comment
      316               skip 'Смена ' buf_shift-obj.shift-num 'от' buf_shift-obj.shift-date
      317           view-as alert-box error
      318           title "Отмена текущей смены".
      319           return.
      320   end.
      321   end.
      322   glog = no.
      323   message
      324     "Отменить смену по" p-curr-obj-type p-curr-obj-code skip
      325     "Дата начала смены:" s-date skip
      326     "Номер смены:" s-name skip
      327     "Порядок смены:" s-num  "?"
      328     view-as alert-box question buttons OK-Cancel update glog.
      329   if not glog then
      330     return.
      331   if is-closed then do:
      332     undo-closed:
      333     do transaction on error undo undo-closed, return on stop undo undo-closed, return:
      334       find first buf_rvs-doc exclusive-lock
      335            where buf_rvs-doc.obj-type   = buf_shift-obj.obj-type
      336              and buf_rvs-doc.obj-code   = buf_shift-obj.obj-code
      337              and buf_rvs-doc.shift-date = buf_shift-obj.shift-date
      338              and buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
      339              and buf_rvs-doc.status_    = 'факт':U
      340              and buf_rvs-doc.rvs-type   = 'смена':U
      341       no-error.
      342       if available buf_rvs-doc then do:
      343           assign
      344           buf_rvs-doc.rvs-type   = 'контроль':U
      345           buf_rvs-doc.is-full = yes
      346           .
      347           release buf_rvs-doc.
      348       end.
      349       else if locked(buf_rvs-doc) then do:
      350           message "Сменная сверка заблокирована!" view-as alert-box.
      351           return.
      352       end.
      353       buf_shift-obj.status_ = 'тек':U.
      354       for each ub.shift-staff no-lock where ub.shift-staff.obj-type = buf_shift-obj.obj-type
      355                                         and ub.shift-staff.obj-code = buf_shift-obj.obj-code
      356                                         and ub.shift-staff.shift-num = buf_shift-obj.shift-num
      357                                         and ub.shift-staff.shift-date = buf_shift-obj.shift-date
      358                                         and ub.shift-staff.next-shift = no :
      359           if ub.shift-staff.staff-role
      360           then
      361           assign
      362               v-shift-manager = ub.shift-staff.name
      363           .
      364           else
      365           assign
      366               v-shift-staff-list = v-shift-staff-list + (if v-shift-staff-list = "" then "" else ", ") + ub.shift-staff.name
      367           .
      368       end.
      369       for each buf_shift-period exclusive-lock where buf_shift-period.obj-type = buf_shift-obj.obj-type
      370                                                  and buf_shift-period.obj-code = buf_shift-obj.obj-code
      371                                                  and buf_shift-period.shift-num = buf_shift-obj.shift-num
      372                                                  and buf_shift-period.shift-date = buf_shift-obj.shift-date
      373       :
      374         delete buf_shift-period .
      375       end .
      376         define buffer buf_reportShift for ub.reportShift .
      377         for each buf_reportShift exclusive-lock where buf_reportShift.shift-date = buf_shift-obj.shift-date and
      378             buf_reportShift.shift-num = buf_shift-obj.shift-num and buf_reportShift.obj-code = buf_shift-obj.obj-code and
      379             buf_reportShift.obj-type = buf_shift-obj.obj-type:
      380             delete buf_reportShift .
      381         end.
      382       release buf_shift-obj no-error.
      383       if error-status:error
      384       then do :
      385           v-vid-action = 53 .
      386           v-vid-param = "SHOP_NUM=" + string(buf_shift-obj.obj-code) + chr(4) +
      387                         "SHIFT_NUM=" + string(buf_shift-obj.shift-num) + string(buf_shift-obj.shift-date, "99999999") + chr(4) +
      388                         "ShiftManager=" + v-shift-manager + chr(4) +
      389                         "ShiftStaff=" + v-shift-staff-list + chr(4) +
      390                         "RESULT=1" + chr(4) +
      391                         "Description=" + error-status :get-message(1) .
      392           run trg/userlog.p (
      393                 input 'update_err':U
      394               , input 'shift-obj':U
      395               , input ( buffer buf_shift-obj :handle )
      396               , input v-vid-action
      397               , input v-vid-param
      398           ) no-error.
