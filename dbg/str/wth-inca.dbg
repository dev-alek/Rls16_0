      524          FL-gds-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      525   ASSIGN
      526          fl-prod-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      527   ASSIGN
      528          fl-ProdCode:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      529   ASSIGN
      530          fl-prodType:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      531   ASSIGN
      532          tt-wth-line.sum-gds-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      533   ASSIGN
      534          tt-wth-line.sum-gds-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      535   ASSIGN
      536          TEXT-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      537   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      538   DO:
      539     APPLY "END-ERROR":U TO SELF.
      540   END.
      541   ON CHOOSE OF B-dtl IN FRAME Dialog-Frame
      542   DO:
      543   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   if lookup(self :type
      545            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      546            ) = 0
      547   then do:
      548     message
      549       "$Workfile$"
      550       "Указанному интерфейсному элементу фокус не может быть передан" skip
      551       "Интерфейсный элемент" self :name  skip
      552       "Тип" self :type  skip
      553       "Процедура" this-procedure :file-name skip
      554       view-as alert-box .
      555   end.
      556   else do:
      557     apply "entry":u to self  .
      558     if focus :handle <> self :handle  then do:
      559       return no-apply .
      560     end.
      561   end.
      562     assign
      563     tt-wth-line.doc-sum
      564     tt-wth-line.fact-sum
      565     tt-wth-line.wth-code
      566     .
      567     if ub.wth-doc.ext-doc-type = 'xc':U then do:
      568       run str/wth-dtle.w (
      569                      input parparentproc
      570                     ,INPUT p-curr-host-code
      571                     ,INPUT p-curr-obj-type
      572                     ,INPUT p-curr-obj-code
      573                     ,INPUT par-mode
      574                     ,INPUT parline-rec
      575                     ,INPUT tt-wth-line.doc-code
      576                     ,INPUT tt-wth-line.wth-code
      577                     ,INPUT tt-wth-line.w-p-code
      578                     ,INPUT tt-wth-line.doc-sum
      579                     ,INPUT tt-wth-line.fact-sum
      580                     ,INPUT tt-wth-line.bef-sum
      581                     ,INPUT tt-wth-line.aft-sum
      582                     ,INPUT ub.wth-doc.doc-type
      583                     ,INPUT ub.wth-doc.ext-doc-type
      584                     ,input-output table tt-par-dtl ) .
      585     end.
      586     else do:
      587     run str/wth-dtlc.w (
      588                      input parparentproc
      589                     ,INPUT p-curr-host-code
      590                     ,INPUT p-curr-obj-type
      591                     ,INPUT p-curr-obj-code
      592                     ,INPUT par-mode
      593                     ,INPUT parline-rec
      594                     ,INPUT tt-wth-line.doc-code
      595                     ,INPUT tt-wth-line.wth-code
      596                     ,INPUT tt-wth-line.w-p-code
      597                     ,INPUT tt-wth-line.doc-sum
      598                     ,INPUT tt-wth-line.fact-sum
      599                     ,INPUT tt-wth-line.bef-sum
      600                     ,INPUT tt-wth-line.aft-sum
      601                     ,INPUT ub.wth-doc.doc-type
      602                     ,INPUT ub.wth-doc.ext-doc-type
      603                     ,input-output table tt-par-dtl ) .
      604      end.
      605    if buf_wealth.is-ser = 1 and par-mode <> 'ПРОСМОТР':U then do:
      606   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   assign
      608   tt-wth-line.doc-sum   = 0
      609   tt-wth-line.fact-sum  = 0
      610   tt-wth-line.sum-gds-rubl = 0
      611   tt-wth-line.sum-gds-base = 0
      612   tt-wth-line.price-rubl   = 0
      613   tt-wth-line.price-base   = 0.
      614   for each tt-par-dtl no-lock where tt-par-dtl.w-p-code = tt-wth-line.w-p-code
      615                          and tt-par-dtl.wth-code = tt-wth-line.wth-code
      616                          and tt-par-dtl.doc-code = tt-wth-line.doc-code
      617                          :
      618     assign
      619     tt-wth-line.doc-sum      =  tt-wth-line.doc-sum  + tt-par-dtl.doc-sum
      620     tt-wth-line.fact-sum     =  tt-wth-line.fact-sum + tt-par-dtl.fact-sum
      621     tt-wth-line.sum-gds-rubl =  tt-wth-line.sum-gds-rubl + tt-par-dtl.sum-gds-rubl
      622     tt-wth-line.sum-gds-base =  tt-wth-line.sum-gds-base + tt-par-dtl.sum-gds-base
      623     .
      624   end.
      625   assign
      626     tt-wth-line.price-rubl  =  tt-wth-line.sum-gds-rubl / tt-wth-line.fact-sum
      627     tt-wth-line.price-base  =  tt-wth-line.sum-gds-base / tt-wth-line.fact-sum
      628     .
      629     display
      630      tt-wth-line.doc-sum
      631      tt-wth-line.fact-sum
      632      tt-wth-line.sum-gds-rubl
      633      tt-wth-line.sum-gds-base
      634     with frame Dialog-Frame.
      635    end.
      636     run control-dtl in this-procedure(output lock-line).
      637     run lock-proc in this-procedure(input lock-line).
      638   END.
      639   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      640   DO:
      641   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   if lookup(self :type
      643            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      644            ) = 0
      645   then do:
      646     message
      647       "$Workfile$"
      648       "Указанному интерфейсному элементу фокус не может быть передан" skip
      649       "Интерфейсный элемент" self :name  skip
      650       "Тип" self :type  skip
      651       "Процедура" this-procedure :file-name skip
      652       view-as alert-box .
      653   end.
      654   else do:
      655     apply "entry":u to self  .
      656     if focus :handle <> self :handle  then do:
      657       return no-apply .
      658     end.
      659   end.
      660     run proc-save-line in this-procedure ( input no, input-output par-mode) No-ERROR.
      661     if error-status:error then return no-apply.
      662     APPLY "GO":U TO FRAME Dialog-Frame.
      663   END.
      664   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      665   DO:
      666     run proc-b-move in this-procedure ( input self:name) no-error.
      667     if error-status:error then return no-apply.
      668   END.
      669   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      670   DO:
      671     run proc-b-move in this-procedure ( input self:name) no-error.
      672     if error-status:error then return no-apply.
      673   END.
      674   ON CHOOSE OF B-wealth IN FRAME Dialog-Frame
      675   DO:
      676     define variable v_rid-list AS CHAR NO-UNDO.
      677     run ref/wth-ref.w (
      678                    input parparentproc
      679                   ,input "b-sel":U
      680                   ,input ub.wth-doc.host-code
      681                   ,input ub.wth-doc.obj-type
      682                   ,input ub.wth-doc.obj-code
      683                   ,input (if lookup(ub.wth-doc.ext-doc-type,'ii,fj,jj,pj,oj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,xc':U) > 0 then "wth-ser":U  else if lookup(ub.wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) > 0 then "wth-nser":U else 'все':U)
      684                   ,input-OUTPUT v_rid-list ).
      685     if v_rid-list = "":u then return no-apply.
      686     FIND FIRSt buf_wealth NO-LOCK WHERE
      687                RECID( buf_wealth ) = INT( ENTRY( NUM-ENTRIES( v_rid-list ), v_rid-list ) ) NO-ERROR.
      688     IF AVAIL buf_wealth THEN DO:
      689       DISPLAY
      690       buf_wealth.wth-code @ tt-wth-line.wth-code
      691       buf_wealth.wth-name @ ub.wealth.wth-name
      692       WITH FRAME Dialog-Frame.
      693       for each tt-par-dtl:
      694         delete tt-par-dtl.
      695       end.
      696     END.
      697   RUN DISP-fl IN THIS-PROCEDURE.
      698   END.
      699   ON LEAVE OF tt-wth-line.doc-sum IN FRAME Dialog-Frame
      700   DO:
      701     tt-wth-line.fact-sum:SCREEN-VALUE = SELF:SCREEN-VALUE.
      702   END.
      703   ON LEAVE OF tt-wth-line.wth-code IN FRAME Dialog-Frame
      704   DO:
      705     RUN disp-fl IN THIS-PROCEDURE.
      706   END.
      707   ON LEAVE OF wealth.wth-name IN FRAME Dialog-Frame
      708   DO:
      709     RUN disp-fl IN THIS-PROCEDURE.
      710   END.
      711   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      712   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      713   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   on help of frame Dialog-Frame
      715   do:
      716     run gbl/app_help.p
      717       (input this-procedure :file-name
      718       ,input ''
      719       ,input ?
      720       ) no-error.
      721     if error-status :error then do:
      722       message
      723         "Ошибка при вызове помощи"
      724         error-status :get-message(1)
      725         view-as alert-box .
      726     end.
      727   end.
      728   run minbtn-set in this-procedure .
      729   on choose of b-help in frame Dialog-Frame
      730   do:
      731     apply "help":u to frame Dialog-Frame .
      732   end.
      733   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   procedure minbtn-set :
      735       do
      736           on error undo, return error return-value
      737           :
      738           define variable ii              as integer       no-undo .
      739           define variable fh              as widget-handle no-undo .
      740           define variable hh              as widget-handle no-undo .
      741           define variable v-h             as handle        extent 4 no-undo .
      742           define variable v-name-button   as character     no-undo .
      743           define variable v-help-old-x    as decimal       no-undo .
      744           define variable v-help-old-y    as decimal       no-undo .
      745           define variable v-help-old-size as decimal       no-undo .
      746           define variable v-frame-width   as decimal       no-undo .
      747           define variable jj              as integer       no-undo .
      748           do
      749               on error undo, return error
      750               :
      751               assign
      752                   v-frame-width = frame Dialog-Frame:width - 0.3
      753                   fh            = frame Dialog-Frame:first-child
      754                   hh            = fh:first-child
      755                   ii            = 1
      756                   .
      757               do while valid-handle(hh):
      758                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      759                   do:
      760                       case lc(hh:name) :
      761                           when "b-help" then
      762                               do:
      763                                   hh:load-image-up("cmp/b-help.bmp":u) .
      764                                   hh:load-image-down("cmp/b-help.bmp":u) .
      765                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      766                                   hh:TOOLTIP = "Помощь" .
      767                                   v-help-old-x = hh:column .
      768                                   v-help-old-y = hh:row    .
      769                                   v-help-old-size = hh:width .
      770                                   hh:width-chars = 2.5 .
      771                               end.
      772                           when "b-print" then
      773                               do:
      774                                   hh:load-image("cmp/b-print.bmp":u) .
      775                                   hh:TOOLTIP = "Печать" .
      776                                   v-h[ii] = hh:handle .
      777                                   ii = ii + 1 .
      778                                   hh:width-chars = 3 .
      779                               end.
      780                           when "b-history" or
      781                           when "b-hist" then
      782                               do:
      783                                   hh:load-image("cmp/b-hist.bmp":u) .
      784                                   hh:TOOLTIP = "История" .
      785                                   v-h[ii] = hh:handle .
      786                                   ii = ii + 1 .
      787                                   hh:width-chars = 3 .
      788                               end.
      789                           when "b-sch" then
      790                               do:
      791                                   hh:load-image("cmp/b-sch.bmp":u) .
      792                                   hh:TOOLTIP = "Установка Фильтра" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-hist-user" then
      798                               do:
      799                                   hh:load-image("cmp/b-hist.bmp":u) .
      800                                   hh:TOOLTIP = "История пользователя" .
      801                                   ii = ii + 1 .
      802                               end.
      803                       end case.
      804                   end.
      805                   hh = hh:next-sibling.
      806               end.
      807               b-help:column = v-frame-width - b-help:width-chars.
      808               jj = 0.
      809               repeat ii = 4 to 1 by -1 :
      810                   if valid-handle (v-h[ii] ) then
      811                   do:
      812                       jj  = jj + 1 .
      813                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      814                       v-h[ii]:row    = v-help-old-y .
      815                   end.
      816               end.
      817           end.
      818       end.
      819   end procedure.
      820   MAIN-BLOCK:
      821   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      822      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      823     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
      824         message vss-workfile vss-revision vss-description skip
      825                     "Неверный параметр вызова par-mode"
      826         view-as alert-box ERROR.
      827         return error.
      828     end.
      829     if par-mode = 'ПРОСМОТР':U then do:
      830       FIND FIRST ub.wth-doc No-LOCK WHERE
      831                  recid(ub.wth-doc) = pardoc-rec No-ERROR.
      832     end.
      833     else do:
      834       FIND FIRST ub.wth-doc EXCLUSIVE-LOCK WHERE
      835                  recid(ub.wth-doc) = pardoc-rec No-ERROR.
      836     end.
      837     IF NOT avail ub.wth-doc then do:
      838       message
      839       vss-workfile vss-revision vss-description skip
      840       "Не найден документ движения МЦ"
      841       view-as alert-box.
      842       return error.
      843     end.
      844     vardoc-code = ub.wth-doc.doc-code.
      845     OPEN QUERY QUERY-lines
      846     FOR EACH buf_wth-line WHERE
      847              buf_wth-line.doc-code = vardoc-code NO-LOCK INDEXED-REPOSITION.
      848     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      849       if par-mode = 'ПРОСМОТР':U then do:
      850         get first QUERY-lines.
      851         repeat while parline-rec <> recid(buf_wth-line):
      852           get next QUERY-lines.
      853         end.
      854       end.
      855       else do:
      856         get first QUERY-lines exclusive-lock.
      857         repeat while parline-rec <> recid(buf_wth-line):
      858           get next QUERY-lines exclusive-lock.
      859         end.
      860       end.
      861       IF error-status:error then do:
      862         message
      863         vss-workfile vss-revision vss-description skip
      864         "Не найдена строка по документу движения МЦ"
      865         view-as alert-box.
      866         return error.
      867       end.
      868     end.
      869     run fill-tables in this-procedure.
      870     RUN Myenable in this-procedure.
      871     RUN disp-fl IN THIS-PROCEDURE.
      872     WAIT-FOR GO OF FRAME Dialog-Frame.
      873   END.
      874   RUN disable_UI.
      875   PROCEDURE control-dtl :
      876   define output parameter lock-line as logical no-undo.
      877   if not avail tt-wth-line then return error.
      878   if par-mode = 'ДОБАВЛЕНИЕ':U or can-find(first tt-par-dtl) then dO:
      879     if not available buf_wealth then  t-dtl:screen-value in frame Dialog-Frame =  "no".
      880     else if buf_wealth.is-ser = 0 then do:
      881       find first tt-par-dtl NO-LOCK  where tt-par-dtl.doc-sum > 0  No-ERROR .
      882       t-dtl:screen-value in frame Dialog-Frame = (if available tt-par-dtl then "yes" else "no").
      883     end.
      884     else do:
      885       t-dtl:screen-value in frame Dialog-Frame = if can-find(first buf_wth-parts
      886                                                               where buf_wth-parts.wth-code = tt-wth-line.wth-code and
      887                                                                     buf_wth-parts.w-p-code = tt-wth-line.w-p-code  and
      888                                                                     buf_wth-parts.out-code = tt-wth-line.doc-code
      889                                                                ) then   "yes" else "no".
      890     end.
      891   end.
      892   else do:
      893          find first ub.wth-dtl No-LOCK  where
      894                       ub.wth-dtl.doc-code = tt-wth-line.doc-code AND
      895                       ub.wth-dtl.wth-code = tt-wth-line.wth-code AND
      896                       ub.wth-dtl.w-p-code = tt-wth-line.w-p-code No-ERROR .
      897        t-dtl:screen-value in frame Dialog-Frame = (if available wth-dtl then "yes" else "no").
      898   end.
      899   if t-dtl:screen-value in frame Dialog-Frame = "yes" or par-mode = 'ПРОСМОТР':U
      900   then lock-line = yes.
      901   END PROCEDURE.
      902   PROCEDURE disable_UI :
      903     HIDE FRAME Dialog-Frame.
      904   END PROCEDURE.
      905   PROCEDURE disp-fl :
      906   DEF VAR v-doc-host-code like ub.sysconf.host-code no-undo .
      907   define buffer buf_currency for ub.currency  .
      908   define buffer buf_clients for ub.clients .
      909   ASSIGN FRAME   Dialog-Frame tt-wth-line.wth-code.
      910   IF NOT( AVAILABLE buf_wealth AND buf_wealth.wth-code =  tt-wth-line.wth-code)
      911   THEN DO:
      912       FIND FIRST buf_wealth NO-LOCK WHERE
      913            buf_wealth.wth-code =  tt-wth-line.wth-code NO-ERROR.
      914   END.
      915   IF NOT AVAILABLE buf_wealth  OR (AVAILABLE buf_wealth AND buf_wealth.is-ser = 0) THEN DO:
      916       HIDE
      917           tt-wth-line.sum-gds-rubl tt-wth-line.sum-gds-base fl-gds FL-gds-code fl-artic fl-prodType fl-ProdCode fl-prod-name TEXT-1 fl-curr-abbr
      918       IN FRAME Dialog-Frame.
      919       enable tt-wth-line.doc-sum  when   AVAILABLE buf_wealth  and par-mode <> 'ПРОСМОТР':U
      920       with frame Dialog-Frame.
      921       if ub.wth-doc.doc-type = 'при':U and ub.wth-doc.exter_ = no and par-mode <> 'ПРОСМОТР':U and  AVAILABLE buf_wealth   then do:
      922         enable tt-wth-line.fact-sum
      923         with frame Dialog-Frame.
      924         disable tt-wth-line.doc-sum
      925         with frame Dialog-Frame.
      926       end.
      927       RETURN.
      928   END.
      929   DO WITH FRAME  Dialog-Frame:
      930   FIND FIRST buf_clients NO-LOCK WHERE
      931       buf_clients.obj-type = tt-wth-line.obj-type AND
      932       buf_clients.obj-code = tt-wth-line.obj-code .
      933      v-doc-host-code =  buf_clients.host-code.
      934   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      935   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      936     (input  v-doc-host-code
      937     ,output base-code
      938     )  .
      939      find first Buf_currency where Buf_currency.curr-code = base-code no-lock no-error.
      940      if available Buf_currency then DO :
      941          fl-curr-abbr:SCREEN-VALUE = Buf_currency.curr-abbr .
      942      END.
      943   view tt-wth-line.sum-gds-rubl tt-wth-line.sum-gds-base fl-gds FL-gds-code fl-artic fl-prodType fl-ProdCode fl-prod-name TEXT-1 fl-curr-abbr.
      944   disable tt-wth-line.doc-sum
      945       with frame Dialog-Frame.
      946   DISPLAY
      947       tt-wth-line.sum-gds-rubl
      948       tt-wth-line.sum-gds-base
      949   .
      950         find first ub.wth-gds no-lock where
      951                 ub.wth-gds.wth-code = tt-wth-line.wth-code no-error .
      952         if available ub.wth-gds  then DO :
      953             FIND FIRST b-goods WHERE b-goods.gds-code = ub.wth-gds.gds-code NO-LOCK NO-ERROR.
      954             IF AVAILABLE b-goods THEN DO WITH FRAME Dialog-Frame:
      955                    fl-artic:SCREEN-VALUE = b-goods.artic.
      956                    fl-prodType:SCREEN-VALUE = string(b-goods.prod-type).
      957                    fl-prodCode:SCREEN-VALUE = string(b-goods.prod-code).
      958                    fl-gds:SCREEN-VALUE = b-goods.gds-name.
      959                    fl-gds-code:SCREEN-VALUE = string(b-goods.gds-code).
      960              END.
      961              ELSE DO:  ASSIGN fl-artic:SCREEN-VALUE = '?':U
      962                    fl-prodType:SCREEN-VALUE = '?':U
      963                    fl-prodCode:SCREEN-VALUE = '?':U
      964                    fl-gds:SCREEN-VALUE = '?':U
      965                    fl-gds-code:SCREEN-VALUE = '?':U
      966                    fl-prod-name:SCREEN-VALUE = '?':U.
      967              END.
      968             FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = b-goods.prod-type and ub.clients.obj-code = b-goods.prod-code NO-ERROR.
      969             IF AVAILABLE ub.clients THEN DO WITH FRAME Dialog-Frame:
      970                 fl-prod-name:SCREEN-VALUE = ub.clients.obj-name.
      971             END.
      972             ELSE do:
      973                ASSIGN fl-prod-name:SCREEN-VALUE = '?':U.
      974             END.
      975         END.
      976         ELSE DO:  ASSIGN fl-artic:SCREEN-VALUE = '?':U
      977                fl-prodType:SCREEN-VALUE = '?':U
      978                fl-prodCode:SCREEN-VALUE = '?':U
      979                fl-gds:SCREEN-VALUE = '?':U
      980                fl-gds-code:SCREEN-VALUE = '?':U
      981                fl-prod-name:SCREEN-VALUE = '?':U.
      982         END.
      983    END.
      984         END PROCEDURE.
      985   PROCEDURE enable_UI :
      986     DISPLAY T-dtl FL-gds-code fl-ProdCode TEXT-1
      987         WITH FRAME Dialog-Frame.
      988     IF AVAILABLE tt-wth-line THEN
      989       DISPLAY tt-wth-line.wth-code tt-wth-line.doc-sum tt-wth-line.fact-sum
      990             tt-wth-line.sum-gds-rubl tt-wth-line.sum-gds-base
      991         WITH FRAME Dialog-Frame.
      992     IF AVAILABLE ub.wealth THEN
      993       DISPLAY ub.wealth.wth-name
      994         WITH FRAME Dialog-Frame.
      995     ENABLE B-exit RECT-1 RECT-2 b-quit B-prev B-next B-Help tt-wth-line.wth-code
      996            B-wealth tt-wth-line.fact-sum T-dtl ub.wealth.wth-name
      997         WITH FRAME Dialog-Frame.
      998     VIEW FRAME Dialog-Frame.
      999   END PROCEDURE.
     1000   PROCEDURE fill-tables :
     1001   DEFINE VARIABLE v-today as date no-undo .
     1002   DEFINE VARIABLE v-time as integer no-undo .
     1003   for each tt-wth-line:
     1004     delete tt-wth-line.
     1005   end.
     1006   for each tt-par-dtl:
     1007       delete tt-par-dtl.
     1008   end.
     1009   release buf_wealth.
     1010     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     1011       run cur-time in this-procedure ( output v-today, output v-time).
     1012   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   CREATE tt-wth-line.
     1014   ASSIGN
     1015     tt-wth-line.doc-code     = ub.wth-doc.doc-code
     1016     tt-wth-line.w-p-code     = par-current-w-p-code
     1017     tt-wth-line.out-code     = par-out-w-p-code
     1018     tt-wth-line.obj-type     = ub.wth-doc.obj-type
     1019     tt-wth-line.obj-code     = ub.wth-doc.obj-code
     1020     tt-wth-line.shift-date   = ub.wth-doc.shift-date
     1021     tt-wth-line.shift-num    = ub.wth-doc.shift-num
     1022     tt-wth-line.shift-name   = ub.wth-doc.shift-name
     1023     tt-wth-line.creid        = g#userid
     1024     tt-wth-line.credate      = v-today
     1025   .
     1026     end.
     1027     else do:
     1028       create tt-wth-line.
     1029       buffer-copy buf_wth-line to tt-wth-line.
     1030       FIND FIRST buf_wealth No-LOCK WHERE
     1031                  buf_wealth.wth-code = tt-wth-line.wth-code No-error.
     1032       find first ub.wth-dtl No-LOCK WHERE
     1033                     ub.wth-dtl.wth-code = tt-wth-line.wth-code AND
     1034                     ub.wth-dtl.doc-code = tt-wth-line.doc-code AND
     1035                     ub.wth-dtl.w-p-code = tt-wth-line.w-p-code  No-ERROR.
     1036     end.
     1037   END PROCEDURE.
     1038   PROCEDURE lock-proc :
     1039   DEFINE INPUT PARAMETER lock-line as logical no-undo.
     1040     if lock-line then
     1041     DISABLE
     1042     b-wealth
     1043     tt-wth-line.wth-code
     1044     with frame Dialog-Frame
     1045     .
     1046     ELSE
     1047     ENABLE
     1048     b-wealth when locked-wth = no
     1049     tt-wth-line.wth-code when locked-wth = no
     1050     with frame Dialog-Frame
     1051     .
     1052   END PROCEDURE.
     1053   PROCEDURE MyEnable :
     1054      TEXT-1 = "РУБ" .
     1055      display TEXT-1 with frame Dialog-Frame .
     1056   IF AVAILABLE tt-wth-line THEN
     1057       DISPLAY
     1058       tt-wth-line.wth-code
     1059       tt-wth-line.doc-sum
     1060       tt-wth-line.fact-sum
     1061     WITH FRAME Dialog-Frame.
     1062   IF AVAILABLE buf_wealth THEN
     1063       DISPLAY
     1064       buf_wealth.wth-name @ ub.wealth.wth-name
     1065      WITH FRAME Dialog-Frame.
     1066     ELSE
     1067     DISPLAY
     1068     '':u @ WEALTH.WTH-NAME
     1069     WITH FRAME Dialog-Frame.
     1070   CASE par-mode:
     1071     when 'ДОБАВЛЕНИЕ':U THEN DO:
     1072       ENABLE
     1073       tt-wth-line.wth-code
     1074       B-Wealth
     1075       B-exit
     1076       b-quit
     1077       b-dtl
     1078       WITH FRAME Dialog-Frame.
     1079       HIDE
     1080       tt-wth-line.fact-sum
     1081       IN FRAME Dialog-Frame
     1082       B-Next IN FRAME Dialog-Frame
     1083       B-Prev IN FRAME Dialog-Frame
     1084       .
     1085       locked-wth = no.
     1086     END.
     1087     when 'ИЗМЕНЕНИЕ':U  THEN DO:
     1088         IF ub.wth-doc.status_ = 'накл':U THEN DO:
     1089           ENABLE
     1090           tt-wth-line.wth-code
     1091           B-Wealth
     1092           B-exit
     1093           b-quit
     1094           b-dtl
     1095           WITH FRAME Dialog-Frame.
     1096           HIDE
     1097           tt-wth-line.fact-sum IN FRAME Dialog-Frame
     1098           B-Next        IN FRAME Dialog-Frame
     1099           B-Prev        IN FRAME Dialog-Frame
     1100           .
     1101           locked-wth = no.
     1102         END.
     1103       ELSE IF wth-doc.status_ = 'разрешен':U THEN DO:
     1104           DISPLAY
     1105           tt-wth-line.fact-sum
     1106           WITH FRAME Dialog-Frame.
     1107           ENABLE
     1108           tt-wth-line.fact-sum
     1109           B-exit
     1110           b-quit
     1111           b-dtl when avail ub.wth-dtl
     1112           WITH FRAME Dialog-Frame.
     1113           HIDE
     1114           B-Next IN FRAME Dialog-Frame
     1115           B-Prev IN FRAME Dialog-Frame
     1116           .
     1117           locked-wth = yes.
     1118         END.
     1119       END.
     1120       when 'ПРОСМОТР':U  THEN DO:
     1121         IF wth-doc.status_ <> 'накл':U THEN DO:
     1122           DISPLAY
     1123           tt-wth-line.fact-sum WITH FRAME Dialog-Frame.
     1124         END.
     1125         ENABLE
     1126         B-Next
     1127         B-Prev
     1128         b-quit
     1129         b-dtl when avail ub.wth-dtl
     1130         WITH FRAME Dialog-Frame.
     1131         HIDE
     1132         B-Wealth IN FRAME Dialog-Frame
     1133         .
     1134         locked-wth = yes.
     1135         b-quit:label = 'Выход'.
     1136       END.
     1137     END CASE.
     1138     if wth-doc.doc-type = 'декл':U then do:
     1139       hide
     1140       tt-wth-line.fact-sum
     1141       in frame Dialog-Frame .
     1142     end.
     1143     run control-dtl in this-procedure ( output lock-line).
     1144     run lock-proc in this-procedure ( input lock-line).
     1145     ENABLE
     1146     b-help
     1147     WITH FRAME Dialog-Frame.
     1148        parext-doc-name = ENTRY(LOOKUP(parext-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) no-error.
     1149     FRAME Dialog-Frame:TITLE =
     1150         "Документ № " + wth-doc.doc-code + " " + CAPS(parext-doc-name) + "  - " + CAPS( par-mode ) + " матценности".
     1151     VIEW FRAME Dialog-Frame .
     1152   END PROCEDURE.
     1153   PROCEDURE proc-b-move :
     1154   DEFINE INPUT PARAMETER par-action as character No-UNDO.
     1155   define variable is-updated as logical no-undo.
     1156   define variable loc#log as logical no-undo.
     1157   define variable v-line-rec as recid no-undo .
     1158     ASSIGN v-line-rec = RECID( buf_wth-line ).
     1159     CASE par-action:
     1160       when "b-next":U then do:
     1161           GET NEXT QUERY-lines NO-LOCK.
     1162       end.
     1163       when "b-prev":U then do:
     1164           GET PREV QUERY-lines NO-LOCK.
     1165       end.
     1166     END CASE.
     1167     IF AVAIL buf_wth-line THEN DO:
     1168       ASSIGN v-line-rec = RECID( buf_wth-line ).
     1169       run fill-tables in this-procedure.
     1170       run MyEnable in this-procedure.
     1171       RUN disp-fl IN THIS-PROCEDURE.
     1172     END.
     1173     ELSE DO:
     1174       CASE par-action:
     1175           when "b-next":U then do:
     1176               GET PREV QUERY-lines NO-LOCK.
     1177           end.
     1178           when "b-prev":U then do:
     1179               GET NEXT QUERY-lines NO-LOCK.
     1180           end.
     1181       END CASE.
     1182       FIND FIRST buf_wth-line NO-LOCK WHERE
     1183                       RECID( buf_wth-line ) = v-line-rec NO-ERROR.
     1184       MESSAGE
     1185         "Это" ( IF par-action = "B-Next":U THEN "последняя" ELSE "первая" )
     1186         "строка в документе!"
     1187       VIEW-AS ALERT-BOX INFORMATION.
     1188       RETURN NO-APPLY.
     1189     END.
     1190   END PROCEDURE.
     1191   PROCEDURE proc-save-line :
     1192   DEFINE INPUT PARAMETER par-log as logical no-undo .
     1193   define input-output parameter loc-mode as character no-undo.
     1194   DEFINE VARIABLE var-entry as character no-undo .
     1195   IF loc-mode = 'ПРОСМОТР':U THEN DO:
     1196      RETURN NO-APPLY.
     1197   END.
     1198   parline-rec = if loc-mode = 'ДОБАВЛЕНИЕ':U then ? else parline-rec.
     1199   assign
     1200   frame Dialog-Frame tt-wth-line.wth-code
     1201   frame Dialog-Frame tt-wth-line.doc-sum
     1202   frame Dialog-Frame tt-wth-line.fact-sum
     1203   .
     1204    run str/wth-lnc1.p (
     1205                         input-output parline-rec
     1206                         ,input  loc-mode
     1207                         ,input no
     1208                         ,input vardoc-code
     1209                         ,input tt-wth-line.wth-code
     1210                         ,input tt-wth-line.w-p-code
     1211                         ,input tt-wth-line.out-code
     1212                         ,input tt-wth-line.doc-sum
     1213                         ,input tt-wth-line.fact-sum
     1214                         ,input table tt-par-dtl
     1215                         ,input par-log
     1216                         ,input parext-type
     1217                         ,input tt-wth-line.sum-gds-rubl
     1218                         ,input tt-wth-line.sum-gds-base
     1219                         ) no-error.
     1220     IF ERROR-STATUS:ERROR THEN DO:
     1221       if var-entry <> '':U then do:
     1222         CASE entry(1, var-entry, chr(4)):
     1223           when "wth-code":U then do:
     1224               APPLY "ENTRY":U TO tt-wth-line.wth-code IN FRAME Dialog-Frame.
     1225           end.
     1226           when "doc-sum":U then do:
     1227               APPLY "ENTRY":U TO tt-wth-line.doc-sum IN FRAME Dialog-Frame.
     1228           end.
     1229           when "fact-sum":U then do:
     1230               APPLY "ENTRY":U TO tt-wth-line.fact-sum IN FRAME Dialog-Frame.
     1231           end.
     1232           when "wth-dtl":U then do:
     1233               APPLY "ENTRY":U TO b-dtl IN FRAME Dialog-Frame.
     1234          end.
     1235         END CASE.
     1236        end.
     1237       RETURN error.
     1238     END.
     1239     loc-mode = 'ИЗМЕНЕНИЕ':U.
     1240   END PROCEDURE.
