       31   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       32   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       33   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       34   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       35   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       36   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр строки документа МЦ (не инвентаризация)":U.
       37   define variable parext-doc-name as character no-undo.
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define new global shared variable g#language as character no-undo .
       93   if g#language <> '' and g#language <> 'rus':U then do:
       94     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       95   end.
       96   define new global shared variable g#library  as handle no-undo .
       97   define new global shared variable g#library2 as handle no-undo .
       98   define   shared variable g#auto as logical no-undo.
       99   define   shared variable g#news as logical no-undo.
      100   define   shared variable g#oxml as logical no-undo.
      101   define   shared variable g#esys as logical no-undo.
      102   define   shared variable g#news-source-db as integer no-undo.
      103   define   shared variable g#esys-source-esys as integer no-undo.
      104   define   shared variable g#db-num as integer   no-undo .
      105   define   shared variable g#userid as character no-undo .
      106   define   shared variable g#passwd as character no-undo .
      107   procedure proc-alt-shift-f2:
      108     if not ibs.th.gbl.gbl-var:rcode
      109   then
      110     run gbl\inidebug.p .
      111   end.
      112   procedure proc-alt-shift-f3:
      113     run gbl/prvssinf.p
      114       ( input this-procedure
      115       ) .
      116   end.
      117   define variable v-inform-launched as logical no-undo initial false .
      118   procedure proc-alt-shift-f4:
      119     define variable v-action as character no-undo .
      120     if v-inform-launched = false then do:
      121       assign
      122         v-inform-launched = true
      123       .
      124       run gbl/d-inform.w
      125         (  input self
      126         ,  input this-procedure
      127         , output v-action
      128         ) no-error .
      129       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      130       assign
      131         v-inform-launched = false
      132       .
      133     end.
      134   end.
      135   procedure proc-alt-f1:
      136     run gbl/corrhelp.p
      137       (input this-procedure
      138       ) .
      139   end .
      140   on alt-shift-f2 anywhere do:
      141     run proc-alt-shift-f2.
      142   end.
      143   on alt-shift-f3 anywhere do:
      144     run proc-alt-shift-f3 in this-procedure .
      145   end.
      146   on alt-shift-f4 anywhere do:
      147     run proc-alt-shift-f4 in this-procedure.
      148   end.
      149   on alt-f1 anywhere do:
      150     run proc-alt-f1 in this-procedure .
      151   end.
      152   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure cur-time :
      154      define output parameter p-today as date      no-undo .
      155      define output parameter p-time  as integer   no-undo .
      156     do
      157     on error undo, return error
      158     :
      159       define variable v-date1 as date      no-undo .
      160       define variable v-date2 as date      no-undo .
      161       define variable v-time  as integer   no-undo .
      162       assign
      163         v-date1 = today
      164         v-time  = time
      165         v-date2 = today
      166       .
      167       if v-date1 <> v-date2
      168       then do:
      169         assign
      170           v-date1 = today
      171           v-time  = v-time
      172         .
      173       end.
      174       assign
      175         p-today = v-date1
      176         p-time  = v-time
      177       .
      178     end.
      179   end.
      180   function cur-time-date returns character
      181   :
      182     return string(today, '99/99/9999':U) .
      183   end.
      184   function cur-time-mjd returns decimal
      185   :
      186     define variable v-date as date      no-undo .
      187     define variable v-time as integer   no-undo .
      188     run cur-time in this-procedure
      189       (output v-date
      190       ,output v-time
      191       ) .
      192     return integer(v-date) - 2400002 + (v-time / 86400) .
      193   end.
      194   function cur-time-get-ending-index returns integer
      195   (input p-number as integer
      196   )
      197   :
      198     if p-number < 0
      199     or p-number = ?
      200     then do:
      201       return 1 .
      202     end.
      203     define variable v-rest as integer   no-undo .
      204     assign
      205       p-number = p-number modulo 100
      206     .
      207     if p-number < 20
      208     then do:
      209       assign
      210         v-rest = p-number
      211       .
      212     end.
      213     else do:
      214       assign
      215         v-rest = p-number modulo 10
      216       .
      217     end.
      218     case v-rest :
      219       when 1
      220       then do:
      221         return 2 .
      222       end.
      223       when 2 or
      224       when 3 or
      225       when 4
      226       then do:
      227         return 3 .
      228       end.
      229       otherwise do:
      230         return 1 .
      231       end.
      232     end case .
      233   end.
      234   procedure cur-time-mjd-to-date :
      235      define input  parameter i-mjd-diff as decimal no-undo.
      236      define output parameter o-Date     as date    no-undo.
      237      define output parameter o-Time     as integer no-undo.
      238      define variable v-day-number as integer   no-undo .
      239      if    i-mjd-diff < 0
      240         or i-mjd-diff = ?
      241      then do:
      242         return "?" .
      243      end.
      244      assign
      245         v-day-number = truncate(i-mjd-diff,0).
      246         o-Date = date(v-day-number + 2400002).
      247         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249   end.
      250   function cur-time-mjd-to-string returns character
      251   (input p-mjd-diff as decimal
      252   )
      253   :
      254     define variable v-day-number as integer   no-undo .
      255     define variable v-seconds    as integer   no-undo .
      256     define variable v-hour       as integer   no-undo .
      257     define variable v-min        as integer   no-undo .
      258     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      259     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      260     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      261     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      262     if p-mjd-diff < 0
      263     or p-mjd-diff = ?
      264     then do:
      265       return "?" .
      266     end.
      267     assign
      268       v-day-number = integer(truncate(p-mjd-diff,0))
      269       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      270     .
      271     if v-seconds > 86400
      272     then do:
      273       assign
      274         v-seconds = 86400 - 1
      275       .
      276     end.
      277     if v-seconds < 0
      278     then do:
      279       assign
      280         v-seconds = 0
      281       .
      282     end.
      283     assign
      284       v-hour = truncate(v-seconds / 3600, 0)
      285     .
      286     assign
      287       v-seconds = v-seconds modulo 3600
      288     .
      289     assign
      290       v-min = truncate(v-seconds / 60, 0)
      291     .
      292     assign
      293       v-seconds = v-seconds modulo 60
      294     .
      295     return
      296         (if v-day-number <> 0
      297           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0
      301           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      302           else ""
      303         )
      304       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      305           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      306           else ""
      307         )
      308       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      309       .
      310   end.
      311   function cur-time-string returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-string-sec returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      330   end.
      331   function cur-time-custom  returns character
      332   (input p-prefix as character
      333   ,input p-date-format as character
      334   ,input p-delimiter as character
      335   ,input p-time-format as character
      336   ,input p-suffix as character
      337   )
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return
      346       p-prefix
      347       + string(v-date, p-date-format)
      348       + p-delimiter
      349       + string(v-time, p-time-format)
      350       + p-suffix
      351       .
      352   end.
      353   function cur-time-print  returns character
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      362   end.
      363   function cur-time-datetime returns datetime
      364   :
      365     define variable v-char as character no-undo .
      366     define variable v-datetime as datetime no-undo .
      367     v-char = cur-time-string().
      368     v-datetime = datetime(v-char).
      369     return  v-datetime.
      370   end.
      371   function cur-time-string-msec returns character
      372   :
      373     define variable v-date as datetime  no-undo .
      374     v-date = now.
      375     return string(v-date) .
      376   end.
