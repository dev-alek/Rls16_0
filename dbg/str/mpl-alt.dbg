     7275     if doc-mode = 'ИЗМЕНЕНИЕ':U then do:
     7276       calc-price = fnc-base-price-doc (buf_bar-code.b-code, recid (buf_price-doc-forming)) *
     7277                   buf_bar-code.cli-base-rate *
     7278                   (1 - buf_price-doc-forming-gds.d-pcnt / 100)
     7279                   .
     7280   case input frame d-pr-alt round-method :
     7281     when '9-окончание':U then do:
     7282       if calc-price < 29 then do:
     7283         if (calc-price - truncate (calc-price, 0)) <> 0 then do:
     7284           assign
     7285             calc-price = truncate (calc-price, 0) + 1
     7286           .
     7287         end.
     7288       end.
     7289       else do:
     7290         if (calc-price modulo 10) < 3 then do:
     7291           assign
     7292             calc-price = (calc-price - (calc-price modulo 100))
     7293                 + ( truncate (((calc-price modulo 100) / 10), 0)
     7294                   - 1 ) * 10
     7295                 + 9
     7296           .
     7297         end.
     7298         else do:
     7299           assign
     7300             calc-price = (calc-price - (calc-price modulo 100))
     7301                 + ( truncate (((calc-price modulo 100) / 10), 0)
     7302                   ) * 10
     7303                 + 9
     7304           .
     7305         end.
     7306         assign
     7307           calc-price = round (calc-price, 0)
     7308         .
     7309       end.
     7310     end.
     7311     when '9-99окончание':U then do:
     7312       if calc-price < input frame d-pr-alt round-base then do:
     7313         assign
     7314           calc-price = truncate (calc-price, 0) + 0.99
     7315         .
     7316       end.
     7317       else do:
     7318         assign
     7319           calc-price = truncate (calc-price / 10 , 0) * 10 + 9.99
     7320         .
     7321       end.
     7322     end.
     7323     when 'Без-дробных':U then do:
     7324       assign
     7325         calc-price = round (calc-price, 0)
     7326       .
     7327     end.
     7328     when 'Произвольно':U then do:
     7329       if input frame d-pr-alt round-base <> 0 then do:
     7330         assign
     7331           calc-price = round (calc-price / input frame d-pr-alt round-base, 0) * input frame d-pr-alt round-base
     7332         .
     7333         if calc-price = 0 then do:
     7334           assign
     7335             calc-price = input frame d-pr-alt round-base
     7336           .
     7337         end.
     7338       end.
     7339     end.
     7340     when 'Вверх':U then do:
     7341       if input frame d-pr-alt round-base <> 0 then do:
     7342         if truncate ( calc-price / input frame d-pr-alt round-base, 0 ) <> (calc-price / input frame d-pr-alt round-base) then do:
     7343           assign
     7344             calc-price = truncate (calc-price / input frame d-pr-alt round-base, 0) * input frame d-pr-alt round-base + input frame d-pr-alt round-base
     7345           .
     7346         end.
     7347       end.
     7348       if calc-price = 0 then do:
     7349         assign
     7350           calc-price = input frame d-pr-alt round-base
     7351         .
     7352       end.
     7353     end.
     7354     when 'Коэффициент':U then do:
     7355       if input frame d-pr-alt round-base <> 0 then do:
     7356         assign
     7357           calc-price = calc-price * input frame d-pr-alt round-base
     7358         .
     7359       end.
     7360     end.
     7361     when 'Отключено':U then do:
     7362     end.
     7363     otherwise do:
     7364       message
     7365         vss-workfile vss-revision vss-description skip
     7366         "Неизвестный метод округления продажной цены" skip
     7367         "round-method" input frame d-pr-alt round-method skip
