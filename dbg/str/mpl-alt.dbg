     1251   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1252   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1253   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1254   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1255   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1256   ASSIGN
     1257      v-S_CONTRACT                = "Contract":U
     1258      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1259      v-DELIM_CHR_3               = ","
     1260      .
     1261   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1262   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1263   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1264   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1265      INPUT iHost-Code    AS INTEGER,
     1266      INPUT iContract-Num AS INTEGER,
     1267      INPUT iGds-Code     AS INTEGER ):
     1268      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1269      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1270      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1271      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1272      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1273      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1274          INPUT  iHost-Code,
     1275          INPUT  iContract-Num,
     1276          OUTPUT iTmp-Extent3
     1277          ).
     1278      IF iTmp-Extent3[1] = 2 THEN DO:
     1279         ASSIGN
     1280            iTmp-Host-Code      = iTmp-Extent3[2]
     1281            iTmp-Contract-Num   = iTmp-Extent3[3]
     1282            .
     1283      END. ELSE DO:
     1284         ASSIGN
     1285            iTmp-Host-Code      = iHost-Code
     1286            iTmp-Contract-Num   = iContract-Num
     1287            .
     1288      END.
     1289      IF iGds-Code = ? THEN DO:
     1290         ASSIGN
     1291            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1292                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1293                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1294                           ).
     1295      END. ELSE DO:
     1296            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1297                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1298                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1299                              AND buf_Spec.Gds-Code      = iGds-Code
     1300                            ).
     1301      END.
     1302      RETURN (lRet).
     1303   END FUNCTION.
     1304   PROCEDURE MS-Contract-EXTENT-3:
     1305      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1306      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1307      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1308      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1309      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1310      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1311      FIND FIRST buf_Cont-2 WHERE
     1312                 buf_Cont-2.Host-Code      = i-Host-Code
     1313             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1314           NO-LOCK NO-ERROR.
     1315      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1316         RETURN.
     1317      END.
     1318      FOR FIRST buf_Ext-Classif WHERE
     1319                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1320           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1321                                               STRING(i-Contract-code)
     1322           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1323          NO-LOCK,
     1324          EACH buf_Cont WHERE
     1325               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1326           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1327          NO-LOCK:
     1328          ASSIGN
     1329             i-Ret[1] = 1
     1330             i-Ret[2] = buf_Cont.Host-code
     1331             i-Ret[3] = buf_Cont.Contract-code
     1332             .
     1333          LEAVE.
     1334      END.
     1335      IF i-Ret[1] <> 1 THEN DO:
     1336         FOR FIRST buf_Ext-Classif WHERE
     1337                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1338              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1339                                                  STRING(i-Contract-code)
     1340              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1341             NO-LOCK,
     1342             EACH buf_Cont WHERE
     1343                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1344              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1345             NO-LOCK:
     1346             ASSIGN
     1347                i-Ret[1] = 2
     1348                i-Ret[2] = buf_Cont.Host-code
     1349                i-Ret[3] = buf_Cont.Contract-code
     1350                .
     1351             LEAVE.
     1352         END.
     1353      END.
     1354      RETURN.
     1355   END PROCEDURE.
