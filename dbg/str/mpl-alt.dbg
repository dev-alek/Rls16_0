     5945   procedure re-define :
     5946   define input-output parameter p-calc-method      as character no-undo .
     5947   define input        parameter p-gds-code         as integer   no-undo .
     5948     do
     5949     on error undo, return error return-value
     5950     :
     5951   define buffer buf_goods for ub.goods  .
     5952   define buffer buf_gds-grp for ub.gds-grp  .
     5953       case p-calc-method :
     5954         when 'Товар':U then do:
     5955              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5956                   case buf_goods.calc-method:
     5957                     when 'Группа':U then do:
     5958                       find first buf_gds-grp no-lock where
     5959                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5960                       p-calc-method  = buf_gds-grp.calc-method.
     5961                     end.
     5962                   otherwise do:
     5963                       p-calc-method  =  buf_goods.calc-method .
     5964                   end.
     5965                   end case.
     5966              run  re-define in this-procedure (
     5967                         input-output  p-calc-method ,
     5968                         input p-gds-code )  .
     5969         end.
     5970         when 'Группа':U then do:
     5971              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5972              find first buf_gds-grp no-lock where
     5973                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5974              run re-define in this-procedure (
     5975                         input-output buf_gds-grp.calc-method ,
     5976                         input p-gds-code )  .
     5977         end.
     5978         when 'Учетная':U or
     5979         when 'Учет-объект':U then do:
     5980              p-calc-method = 'УчетнаяS':U .
     5981         end.
     5982         when 'Учет-резерв':U then do:
     5983              p-calc-method = 'Учет-рзрвS':U.
     5984         end.
     5985         when 'Приходная':U or
     5986         when 'Прих-объект':U then do:
     5987              p-calc-method = 'ПриходнаяS':U.
     5988         end.
     5989         when 'Учет-безНДС':U then do:
     5990              p-calc-method = 'Учет-НДСS':U .
     5991         end.
     5992       end case.
     5993     end.
     5994   end procedure.
     5995   procedure create-line-pdf-mpl-lib :
     5996   define input  parameter  p-plt-db-num as integer   no-undo .
     5997   define input  parameter  p-plt-id     as integer   no-undo .
     5998   define input  parameter  p-pdf-db     as integer   no-undo .
