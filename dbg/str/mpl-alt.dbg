      252             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      253             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      254             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      255             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      256             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      257             v-cntxp-load-time       = bf-cntxp_shop.load-time
      258             v-cntxp-holidays        = bf-cntxp_shop.holidays
      259             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
