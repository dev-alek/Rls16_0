     4022                  ) no-error  .
     4023                 if error-status :error then message
     4024                   vss-workfile vss-revision vss-description skip
     4025                   error-status :get-message(1) skip
     4026                   "gdsoattr-value"
     4027                   view-as alert-box error .
     4028             case NUM-ENTRIES (loc-rez," ") :
     4029                 when 0 then do:
     4030                 end.
     4031                 when 1 then do:
     4032                   p-round-method = loc-rez .
     4033                   p-round-base   = 0 .
     4034                 end.
     4035                 when 2 then do:
     4036                   p-round-method = entry(1 , loc-rez, " " ).
     4037                   p-round-base   = decimal(entry(2 , loc-rez, " " )) .
     4038                 end.
     4039                 otherwise do:
     4040                   p-round-method = entry(1 , loc-rez, " " ).
     4041                   p-round-base   = decimal(entry(NUM-ENTRIES (loc-rez," ") , loc-rez, " " )) .
     4042                 end.
     4043             end case.
     4044         end.
     4045       end.
     4046     end case.
