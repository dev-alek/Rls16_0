      905     :
      906   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      908     (output v-base
      909     )  .
      910   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      912     (input  p-obj-type
      913     ,input  p-obj-code
      914     ,output v-host-code
      915     )  .
      916   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      918     (input  v-host-code
      919     ,input  today
      920     ,output v-base-rate
      921     ,output v-base-scale
      922     )  .
      923   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
      925     (input  ?
      926     ,input  p-obj-type
      927     ,input  p-obj-code
      928     ,input  yes
      929     ,output p-plt-id
      930     ,output p-plt-db-num
      931     )  .
      932      create ub.price-doc-forming.
      933      assign
      934         ub.price-doc-forming.plt-id       = p-plt-id
      935         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      936         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      937         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      938         ub.price-doc-forming.base-rate    = v-base-rate
      939         ub.price-doc-forming.base-scale   = v-base-scale
      940         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      941         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      942         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      943         ub.price-doc-forming.stts         = 0
      944         ub.price-doc-forming.sys-date     = today
      945         ub.price-doc-forming.sys-time     = time
      946         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      947         ub.price-doc-forming.who          = v-cntxt-userid
      948         ub.price-doc-forming.name         = "автосоздание"
      949      .
      950      assign
      951       p-pdf-db-num  = ub.price-doc-forming.pdf-db
