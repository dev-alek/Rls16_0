      290   define new global shared variable g#libbcrcn as handle no-undo .
      291   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   procedure tax-name:
      293   define input  parameter pardef-tax  as character           no-undo.
      294   define output parameter parname-tax as character initial ? no-undo.
      295   define buffer bf_tax for ub.tax.
      296   do on error undo, return error :
      297      case pardef-tax:
      298         when 'vat':U then do:
      299                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      300         end.
      301         when 'slt':U then do:
      302                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      303         end.
      304         when 'rdt':U then do:
      305                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      306         end.
      307         when 'exc':U then do:
      308                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      309         end.
      310         otherwise do:
      311            return error "Задан неверный параметр " + pardef-tax + " .".
      312         end.
      313      end case.
      314   end.
      315   end procedure.
      316   function hvrdtax return logical (input parrecid as recid):
      317   define variable varresult as logical no-undo.
      318   run hvrdtax-proc (input parrecid, output varresult).
      319   return varresult.
      320   end function.
      321   procedure hvrdtax-proc:
      322   define input  parameter parrecid  as recid   no-undo.
      323   define output parameter parresult as logical no-undo.
      324   define buffer bf_goods for ub.goods.
      325   define buffer bf_units for ub.units.
      326   define buffer rt_tax   for ub.tax.
      327   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      328   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      329   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      330   if available rt_tax and
      331       can-find(first ub.tax-units No-LOCK WHERE
      332                      ub.tax-units.tax-code = rt_tax.tax-code AND
      333                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      334                                                       else assign parresult = no.
      335   end procedure.
      336   define new global shared variable g#lib-trn  as handle no-undo .
      337   define new global shared variable g#lib-trn2 as handle no-undo .
      338   define new global shared variable g#lib-trn3 as handle no-undo .
      339   define new global shared variable g#lib-trn4 as handle no-undo .
      340   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   define temp-table x_obj-group no-undo like ub.clients  .
      342   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      343   procedure metod-gop-obj :
      344     do
      345     on error undo, return error return-value
      346     :
      347   define input  parameter p-cntxt-db-num as integer   no-undo .
      348   define input  parameter p-gop-id       as integer   no-undo .
      349   define input  parameter p-gop-db-num   as integer   no-undo .
      350   define buffer buf1_clients for ub.clients  .
      351   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      352   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      353   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      354   for each  x_obj-group : delete x_obj-group. end.
      355   if p-gop-id = 0 or p-gop-id = ?  then do:
      356      if p-cntxt-db-num = 0  then do:
      357           for each buf1_clients no-lock where
      358                   (buf1_clients.obj-type = 'маг':U  or
      359                    buf1_clients.obj-type = 'скл':U  )
      360                   and
      361                   buf1_clients.db-num >= 0  and
      362                   buf1_clients.stts = 0
      363                   :
      364             create x_obj-group .
      365             assign
      366               x_obj-group.obj-code   = buf1_clients.obj-code
      367               x_obj-group.obj-type   = buf1_clients.obj-type
      368               x_obj-group.obj-name   = buf1_clients.obj-name
      369               x_obj-group.db-num     = buf1_clients.db-num
      370             .
      371           end.
      372      end.
      373      else do:
      374           for each buf1_clients no-lock where
      375                   (buf1_clients.obj-type = 'маг':U  or
      376                    buf1_clients.obj-type = 'скл':U  ) and
      377                    buf1_clients.db-num = p-cntxt-db-num  and
      378                    buf1_clients.stts = 0
      379                   :
      380             create x_obj-group .
      381             assign
      382               x_obj-group.obj-code   = buf1_clients.obj-code
      383               x_obj-group.obj-type   = buf1_clients.obj-type
      384               x_obj-group.obj-name   = buf1_clients.obj-name
      385               x_obj-group.db-num     = buf1_clients.db-num
      386             .
      387           end.
      388      end.
      389   end.
      390   else do:
      391         for each buf_db-grp-obj-price  where
      392                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      393                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      394                 buf_db-grp-obj-price.stts = 0  no-lock :
      395           for each buf1_clients no-lock where
      396                  (buf1_clients.obj-type = 'маг':U  or
      397                   buf1_clients.obj-type = 'скл':U  ) and
      398                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      399                   buf1_clients.stts = 0
      400                   :
      401             create x_obj-group .
      402             assign
      403               x_obj-group.obj-code   = buf1_clients.obj-code
      404               x_obj-group.obj-type   = buf1_clients.obj-type
      405               x_obj-group.obj-name   = buf1_clients.obj-name
      406               x_obj-group.db-num     = buf1_clients.db-num
      407             .
      408           end.
      409         end.
      410       for each buf_host-grp-obj-price where
      411               buf_host-grp-obj-price.gop-id     = p-gop-id and
      412               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      413               buf_host-grp-obj-price.stts = 0
      414               no-lock :
      415         for each buf1_clients no-lock where
      416                (buf1_clients.obj-type = 'маг':U  or
      417                 buf1_clients.obj-type = 'скл':U  ) and
      418                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      419                 buf1_clients.stts = 0
      420                 :
      421             find first x_obj-group no-lock  where
      422                       x_obj-group.obj-code   = buf1_clients.obj-code and
      423                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      424             if not available  x_obj-group then   create x_obj-group .
      425             assign
      426               x_obj-group.obj-code   = buf1_clients.obj-code
      427               x_obj-group.obj-type   = buf1_clients.obj-type
      428               x_obj-group.obj-name   = buf1_clients.obj-name
      429               x_obj-group.db-num     = buf1_clients.db-num
      430             .
      431         end.
      432       end.
      433       for each buf_obj-grp-obj-price where
      434               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      435               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      436               buf_obj-grp-obj-price.stts = 0
      437               no-lock :
      438         for each buf1_clients no-lock where
      439                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      440                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      441                   buf1_clients.stts     = 0
      442                   :
      443             find first  x_obj-group no-lock  where
      444                         x_obj-group.obj-code   = buf1_clients.obj-code and
      445                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      446             if not available  x_obj-group then   create x_obj-group .
      447             assign
      448               x_obj-group.obj-code   = buf1_clients.obj-code
      449               x_obj-group.obj-type   = buf1_clients.obj-type
      450               x_obj-group.obj-name   = buf1_clients.obj-name
      451               x_obj-group.db-num     = buf1_clients.db-num
      452             .
      453         end.
      454       end.
      455   end.
      456   end.
      457   end procedure.
      458   procedure metod-obj-in-gop :
      459   define input  parameter p-curr-db-num as integer   no-undo .
      460   define input  parameter p-obj-type as character no-undo .
      461   define input  parameter p-obj-code as integer   no-undo .
      462   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      463     do
      464     on error undo, return error return-value
      465     :
      466       empty temp-table x_grp-obj-price.
      467       for each buf_grp-obj-price where
      468                buf_grp-obj-price.stts = 0
      469                no-lock :
      470                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      471                  for each x_obj-group where
      472                           x_obj-group.obj-type = p-obj-type and
      473                           x_obj-group.obj-code = p-obj-code :
      474                       create  x_grp-obj-price.
      475                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      476                  end.
      477       end.
      478     end.
      479   end procedure.
      480   procedure metod-delobj-usr :
      481   define input  parameter p-pdf-id  as integer   no-undo .
      482   define input  parameter p-pdf-db  as integer   no-undo .
      483   define input  parameter p-plt-id  as integer   no-undo .
      484   define input  parameter p-plt-db-num as integer   no-undo .
      485   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      486     do
      487     on error undo, return error return-value
      488     :
      489   for each buf_price-doc-forming-attr no-lock  where
      490            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      491            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      492            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      493            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      494            buf_price-doc-forming-attr.attr-code begins "obj" :
      495      for each x_obj-group  where
      496               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      497               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      498        delete x_obj-group.
      499      end.
      500   end.
      501     if not can-find (first x_obj-group) then do:
      502        return "nullobj" .
      503     end.
      504   end.
      505   end procedure.
      506   procedure metod-obj-pdf :
      507   define input  parameter p-cntxt-db-num as integer   no-undo .
      508   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      509   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      510   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      511   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      512   define buffer buf_price-list-type for ub.price-list-type  .
      513   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      514     do
      515     on error undo, return error return-value
      516     :
      517    for each  x_obj-group : delete x_obj-group. end.
      518    find first buf_price-list-type no-lock where
      519               buf_price-list-type.plt-id = p-plt-id and
      520               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      521   if error-status :error then return error return-value .
      522    find first buf_price-doc-forming no-lock where
      523               buf_price-doc-forming.plt-id     = p-plt-id and
      524               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      525               buf_price-doc-forming.pdf-id     = p-pdf-id and
      526               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      527               no-error .
      528   if error-status :error then return error return-value .
      529     run metod-gop-obj in this-procedure (
      530         p-cntxt-db-num,
      531         buf_price-list-type.gop-id ,
      532         buf_price-list-type.gop-db-num
      533         ) no-error .
      534     run metod-delobj-usr in this-procedure (
      535       buf_price-doc-forming.pdf-id ,
      536       buf_price-doc-forming.pdf-db ,
      537       buf_price-doc-forming.plt-id ,
      538       buf_price-doc-forming.plt-db-num
      539       ) no-error .
      540     end.
      541   end procedure.
      542   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      544                                           local-doc-num as char).
      545   define buffer base-price        for ub.price-list.
      546   define variable local-main-code like ub.bar-code.b-code no-undo.
      547   define variable local-base-code like ub.bar-code.b-code no-undo.
      548     run prc-base-code (input local-bc, output local-base-code).
      549     find base-price no-lock where
      550          base-price.doc-num = local-doc-num and
      551          base-price.b-code  = local-base-code and
      552          base-price.price-type = "" no-error.
      553     if not available base-price then do:
      554       run prc-main-code (input local-bc, output local-main-code).
      555       find  base-price no-lock where
      556             base-price.doc-num = local-doc-num and
      557             base-price.b-code  = local-main-code and
      558             base-price.price-type = "" no-error.
      559     end.
      560     if available base-price then
      561       return (base-price.price-sale).
      562     else
      563       return (?).
      564   END FUNCTION.
      565   procedure prc-main-code:
      566   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      567   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      568   define buffer local-bar-code        for ub.bar-code.
      569   define buffer local-goods           for ub.goods.
      570   define buffer main-code             for ub.bar-code.
      571   define buffer main-prt              for ub.gds-prt.
      572     local-main-code = ?.
      573     find local-bar-code no-lock where
      574          local-bar-code.b-code = local-bc no-error.
      575     if not available local-bar-code then
      576       return.
      577     find local-goods no-lock where
      578          local-goods.gds-code = local-bar-code.gds-code.
      579     find first  main-prt no-lock where
      580                 main-prt.upper-code = local-goods.prt-root.
      581     find  main-code no-lock where
      582           main-code.gds-code  = local-bar-code.gds-code and
      583           main-code.in-code   = "" and
      584           main-code.part-code = "" and
      585           main-code.unit-cli  = local-goods.unit-base and
      586           main-code.node-code = main-prt.node-code.
      587     local-main-code = main-code.b-code.
      588   end procedure.
      589   procedure prc-base-code:
      590   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      591   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      592   define buffer local-bar-code for ub.bar-code.
      593   define buffer local-goods    for ub.goods.
      594   define buffer base-code      for ub.bar-code.
      595     local-base-code = ?.
      596     find local-bar-code no-lock where
      597          local-bar-code.b-code = local-bc no-error.
      598     if not available local-bar-code then
      599       return.
      600     find local-goods no-lock where
      601          local-goods.gds-code = local-bar-code.gds-code.
      602     find base-code no-lock where
      603          base-code.gds-code  = local-bar-code.gds-code and
      604          base-code.node-code = local-bar-code.node-code and
      605          base-code.in-code   = local-bar-code.in-code and
      606          base-code.part-code = local-bar-code.part-code and
      607          base-code.unit-cli  = local-goods.unit-base.
      608     local-base-code = base-code.b-code.
      609   end procedure.
      610   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   procedure ver-modificator-price-is-null :
      612    do
      613    on error undo, return error return-value
      614    :
      615   define input parameter p-artic     like ub.goods.artic no-undo.
      616   define input parameter p-prod-type like ub.goods.prod-type no-undo.
      617   define input parameter p-prod-code like ub.goods.prod-code no-undo.
      618   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
      619   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
      620   define output parameter p-ret as logical no-undo .
      621   define variable v-gds-code  like ub.goods.gds-code no-undo .
      622   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
      623   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      625     (input  p-artic
      626     ,input  p-prod-type
      627     ,input  p-prod-code
      628     ,output v-gds-code
      629     )  .
      630   p-ret = true .
      631   find first buf_fbr-gds-obj no-lock where
      632               buf_fbr-gds-obj.gds-code = v-gds-code and
      633               buf_fbr-gds-obj.obj-code = p-obj-code and
      634               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
      635    if available buf_fbr-gds-obj then
      636                 if buf_fbr-gds-obj.is-modificator = true and
      637                    buf_fbr-gds-obj.is-null-price = true
      638                    then  p-ret = false .
      639    end.
      640   end procedure.
      641   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   procedure prcreate-new-price-doc :
      644   do
      645   on error undo, return error return-value
      646   :
      647   define input  parameter p-curr-db-num  as integer   no-undo .
      648   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      649   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      650   define input  parameter p-plt-id       as integer   no-undo .
      651   define input  parameter p-plt-db-num   as integer   no-undo .
      652   define input  parameter p-pdf-id       as integer   no-undo .
      653   define input  parameter p-pdf-db-num   as integer   no-undo .
      654   define output parameter p-price-doc-recid  as recid                no-undo.
      655   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      656   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      657   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      658   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      659   define buffer buf_price-doc-forming for ub.price-doc-forming.
      660   define buffer buf_price-doc         for ub.price-doc.
      661   find first buf_price-doc-forming no-lock where
      662              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      663              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      664              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      665              buf_price-doc-forming.plt-id     = p-plt-id
      666              no-error .
      667   if not available buf_price-doc-forming and p-plt-id = ? then do:
      668      run create_new_price-doc-forming
      669           ( input p-obj-type ,
      670             input p-obj-code ,
      671             output p-pdf-db-num ,
      672             output p-pdf-id ,
      673             output p-plt-db-num ,
      674             output p-plt-id
      675             ).
      676       find first buf_price-doc-forming no-lock where
      677                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      678                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      679                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      680                 buf_price-doc-forming.plt-id     = p-plt-id
      681                 no-error .
      682   end.
      683       create buf_price-doc .
      684       run doc-code in this-procedure
      685       (input  "main",
      686        input  p-obj-type  ,
      687        input  p-obj-code  ,
      688        input  ?,
      689        output buf_price-doc.doc-num) no-error.
      690       if error-status:error then do:
      691         message vss-workfile vss-revision vss-description skip
      692                error-status :get-message(1)
      693               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      694         return error.
      695       end.
      696   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      698     (input  p-obj-type
      699     ,input  p-obj-code
      700     ,output v-host-code
      701     )  .
      702       v-obj-current-date  = today .
      703       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      704           v-base-rate   =  buf_price-doc-forming.base-rate  .
      705           v-base-scale  =  buf_price-doc-forming.base-scale .
      706       end.
      707       else do:
      708   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      710     (input  v-host-code
      711     ,input  v-obj-current-date
      712     ,output v-base-rate
      713     ,output v-base-scale
      714     )  .
      715       end.
      716      assign
      717       buf_price-doc.base-rate      = v-base-rate
      718       buf_price-doc.base-scale     = v-base-scale
      719       buf_price-doc.cr-db-num      = p-curr-db-num
      720       buf_price-doc.doc-date       = v-obj-current-date
      721       buf_price-doc.fact-num       = 0
      722       buf_price-doc.host-code      = v-host-code
      723       buf_price-doc.is-corr        = false
      724       buf_price-doc.is-del         = false
      725       buf_price-doc.obj-code       = p-obj-code
      726       buf_price-doc.obj-type       = p-obj-type
      727       buf_price-doc.out-code       = ""
      728       buf_price-doc.pdf-db         = p-pdf-db-num
      729       buf_price-doc.pdf-id         = p-pdf-id
      730       buf_price-doc.plt-db-num     = p-plt-db-num
      731       buf_price-doc.plt-id         = p-plt-id
      732       buf_price-doc.PS             = "@ "
      733       buf_price-doc.rest-base      = 0
      734       buf_price-doc.rest-last      = 0
      735       buf_price-doc.rest-qnty      = 0
      736       buf_price-doc.rest-sale      = 0
      737       buf_price-doc.sale-base      = 0
      738       buf_price-doc.status_        = 'новый':U
      739       .
      740       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      741       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      742       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      743       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      744       assign
      745           p-price-doc-recid = recid ( buf_price-doc )
      746       .
      747   end.
      748   end procedure.
      749   procedure prcreate-new-price-list :
      750   do
      751   on error undo, return error return-value
      752   :
      753   define input parameter p-price-doc-recid   as recid                    no-undo.
      754   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      755   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      756   define output parameter p-update           as logical                  no-undo.
      757   define variable kk as integer no-undo .
      758   define var v-b-code    like ub.bar-code.b-code     no-undo.
      759   define variable p-hostcode as int no-undo .
      760   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      761   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      762   define buffer buf_price-doc        for ub.price-doc.
      763   define buffer buf_price-list       for ub.price-list.
      764   define buffer buf_bar-code         for ub.bar-code.
      765   define buffer buf_goods            for ub.goods.
      766   define buffer buf_root_gds-prt     for ub.gds-prt.
      767   define buffer buf_gds-prt          for ub.gds-prt.
      768   find first buf_price-doc no-lock
      769        where recid( buf_price-doc ) = p-price-doc-recid
      770   .
      771   find first buf_goods no-lock
      772        where buf_goods.gds-code = p-gds-code
      773   .
      774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      775     (input  p-gds-code
      776     ,input  ?
      777     ,output v-b-code
      778     ) no-error .
      779   if error-status :error
      780   then do:
      781       message
      782           "Не найден основной бар-код"
      783           skip "для товара "
      784           skip string(buf_goods.artic)
      785           skip buf_goods.gds-name
      786       view-as alert-box
      787       title "Ошибка при выполнении prcreate.i".
      788       undo, return error .
      789   end.
      790   find first buf_bar-code no-lock
      791        where buf_bar-code.b-code = v-b-code
      792   no-error.
      793   if error-status :error
      794   then do:
      795       message
      796           "Не найдена запись bar-code"
      797           skip "для товара "
      798           skip string(buf_goods.artic)
      799           skip buf_goods.gds-name
      800           skip "С основным бар-кодом"
      801           skip string(v-b-code)
      802       view-as alert-box
      803       title "Ошибка при выполнении prcreate.i".
      804       undo, return error .
      805   end.
      806   find first buf_root_gds-prt no-lock
      807        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      808   .
      809   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      810     and buf_bar-code.in-code <> ""
      811   then do:
      812       message
      813           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      814           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      815           view-as alert-box error.
      816       undo, return error.
      817   end.
      818   find first buf_gds-prt no-lock
      819        where buf_gds-prt.node-code = buf_bar-code.node-code
      820   .
      821   find first buf_price-list
      822        where buf_price-list.doc-num = buf_price-doc.doc-num
      823          and buf_price-list.b-code  = v-b-code
      824   no-error.
      825   if available buf_price-list
      826   then do:
      827       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      828          skip "  Цена:   " buf_price-list.price-sale
      829          skip "Цена будет изменена"
      830       view-as alert-box warning.
      831       assign
      832           p-update = yes
      833       .
      834   end.
      835   else do:
      836   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      838     (input  buf_price-doc.obj-type
