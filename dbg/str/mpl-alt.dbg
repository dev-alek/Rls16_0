     1549   procedure grp-obj-notcorr-value :
     1550   do
     1551   on error undo, return error
     1552   :
     1553   define input parameter p-node-code             as integer      no-undo.
     1554   define input parameter p-obj-type              as character    no-undo.
     1555   define input parameter p-obj-code              as integer      no-undo.
     1556   define output parameter p-notcorr              as character    no-undo init ?.
     1557   define output parameter p-range-notcorr     as integer      no-undo.
     1558   define output parameter p-exists-notcorr    as logical      no-undo.
     1559   define variable v-host-code as integer      no-undo.
     1560   DEFINE VARIABLE v-found as logical no-undo .
     1561   DEFINE VARIABLE v-exists as logical no-undo .
     1562   DEFINE VARIABLE v-range as integer no-undo .
     1563   DEFINE VARIABLE jj as integer no-undo .
     1564   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1565   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1566   define buffer buf_gds-grp for ub.gds-grp.
     1567   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1568   find first buf_gds-grp no-lock where
     1569              buf_gds-grp.node-code = p-node-code no-error .
     1570   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1571     message
     1572       vss-workfile vss-revision vss-description
     1573       skip "Не удалось найти группу товаров с кодом" p-node-code
     1574       view-as alert-box error .
     1575     undo, return error .
     1576   end.
     1577   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1579     (input  p-obj-type
     1580     ,input  p-obj-code
     1581     ,output v-host-code
     1582     ) no-error .
     1583   if error-status :error
     1584   then do:
     1585       message
     1586         vss-workfile vss-revision vss-description
     1587         skip "Не удалось найти фирму объекта"
     1588         skip p-obj-type p-obj-code
     1589         skip return-value
     1590         skip trim(error-status :get-message(1))
     1591       view-as alert-box error.
     1592       undo, return error .
     1593   end.
     1594   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1595   do while v-found = no and jj < 2:
     1596     if v-range <> 3 then do:
     1597       find first buf_gds-grp-obj no-lock
     1598           where buf_gds-grp-obj.node-code = p-node-code
     1599             and buf_gds-grp-obj.host-code = v-host-code
     1600             and buf_gds-grp-obj.obj-type  = p-obj-type
     1601             and buf_gds-grp-obj.obj-code  = p-obj-code
     1602       no-error .
     1603     end.
     1604     if v-range = 3 or not available buf_gds-grp-obj
     1605     then do:
     1606        if v-range <> 2 then do:
     1607           find first buf_gds-grp-obj no-lock
     1608               where buf_gds-grp-obj.node-code = p-node-code
     1609                 and buf_gds-grp-obj.host-code = v-host-code
     1610                 and buf_gds-grp-obj.obj-type  = ""
     1611                 and buf_gds-grp-obj.obj-code  = 0
     1612           no-error .
     1613         end.
     1614         if v-range = 2 or not available buf_gds-grp-obj
     1615         then do:
     1616             if v-range <> 1 then do:
     1617               find first buf_gds-grp-obj no-lock
     1618                   where buf_gds-grp-obj.node-code = p-node-code
     1619                   and buf_gds-grp-obj.host-code = 0
     1620                   and buf_gds-grp-obj.obj-type  = ""
     1621                   and buf_gds-grp-obj.obj-code  = 0
     1622               no-error .
     1623             end.
     1624             if v-range = 1 or not available buf_gds-grp-obj
     1625             then do:
     1626                 assign
     1627                     v-exists = no
     1628                 .
     1629             end.
     1630             else do:
     1631                 assign
     1632                     v-exists = yes
     1633                     v-range = 1
     1634                 .
     1635             end.
     1636         end.
     1637         else do:
     1638             assign
     1639                 v-exists = yes
     1640                 v-range  = 2
     1641             .
     1642         end.
     1643     end.
     1644     else do:
     1645         assign
     1646             v-exists = yes
     1647             v-range  = 3
     1648         .
     1649     end.
     1650     if available buf_gds-grp-obj
     1651     then do:
     1652       find first buf_gds-grp-obj-attr no-lock
     1653         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1654           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1655           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1656           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1657           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1658         no-error .
     1659       if available buf_gds-grp-obj-attr then do:
     1660         assign
     1661           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1662         .
     1663       end.
     1664       else do:
     1665         assign
     1666           v-notcorr-value = ?
     1667         .
     1668       end.
     1669       assign
     1670       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1671                           then yes
     1672                           else p-exists-notcorr)
     1673       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1674                         then v-range
     1675                         else p-range-notcorr
     1676       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1677                         then v-notcorr-value
     1678                         else p-notcorr
     1679       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1680       jj = jj + 1
     1681       .
     1682     end.
     1683     else do:
     1684       assign
     1685       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1686       jj = jj + 1
     1687       .
     1688     end.
     1689   end.
     1690   end.
     1691   end procedure.
     1692   define variable vss-include-info27 as character format "X(65)" no-undo
     1693   initial "@(#)$Workfile$ $Revision$".
     1694   procedure grplib-get-full-name :
     1695      define input parameter p-node-code  as integer      no-undo.
     1696      define output parameter p-full-name as character    no-undo.
     1697      do
     1698   on error undo, return error
     1699   :
     1700       define variable v-upper-code    as integer           no-undo.
     1701       define buffer buf_gds-grp       for ub.gds-grp.
     1702       define buffer buf_upper_gds-grp for ub.gds-grp.
     1703       find first buf_gds-grp no-lock
     1704            where buf_gds-grp.node-code = p-node-code
     1705       no-error.
     1706       if not available buf_gds-grp
     1707       then do:
     1708           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1709       end.
     1710       assign
     1711           p-full-name  = ""
     1712           v-upper-code = 1
     1713       .
     1714       do while buf_gds-grp.upper-code <> 0
     1715       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1716       :
     1717           assign
     1718               p-full-name  = buf_gds-grp.node-name
     1719                            + (if p-full-name <> "" then chr(47) else "")
     1720                            + p-full-name
     1721               v-upper-code = buf_gds-grp.upper-code
     1722           .
     1723           find first buf_gds-grp no-lock
     1724                where buf_gds-grp.node-code = v-upper-code
     1725           no-error.
     1726           if not available buf_gds-grp
     1727           then do:
     1728               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1729                                   + string( v-upper-code )
     1730                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1731           end.
     1732       end.
     1733       assign
     1734       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1735       .
     1736   end.
     1737   end .
     1738   procedure grplib-get-node-from-full-name :
     1739   define input parameter p-full-name as character no-undo .
     1740   define output parameter p-node-code as integer no-undo .
     1741   define variable v-ii as integer no-undo .
     1742   define variable v-upper-code as integer no-undo .
     1743   define variable v-root-code as integer no-undo .
     1744   define variable v-entry as character no-undo .
     1745   define buffer buf_gds-grp       for ub.gds-grp.
     1746   do
     1747   on error undo, return error
     1748   :
     1749     find first buf_gds-grp no-lock
     1750         where buf_gds-grp.upper-code = 0
     1751     no-error .
     1752     if not available buf_gds-grp
     1753     then do:
     1754         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1755     end.
     1756     else do:
     1757       assign
     1758       v-root-code = buf_gds-grp.node-code
     1759       .
     1760     end.
     1761     v-upper-code = v-root-code.
     1762     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1763       assign
     1764       v-entry = entry(v-ii, p-full-name, chr(47)).
     1765       if v-entry = '' then leave.
     1766       find first buf_gds-grp no-lock where
     1767                 buf_gds-grp.node-name = v-entry
     1768             and buf_gds-grp.upper-code = v-upper-code
     1769             no-error.
     1770       if not available buf_gds-grp then do:
     1771         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1772       end.
     1773       else do:
     1774         p-node-code = buf_gds-grp.node-code.
     1775         v-upper-code = buf_gds-grp.node-code.
     1776       end.
     1777     end.
     1778   end.
     1779   end .
     1780   procedure  chec-par :
     1781   define output parameter l-par as logical no-undo .
