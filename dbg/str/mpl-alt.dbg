     4136   Объект,
     4137   Накладная,
     4138   Накл-безНДС,
     4139   Учет-безНДС,
     4140   Стар-безНДС,
     4141   Переоценка,
     4142   ДокФормЦены,
     4143   Отсутствует,
     4144   Признак,
     4145   Специальная,
     4146   Не-считать,
     4147   Основная,
     4148   Единая,
     4149   Учет+накл,
     4150   Уч+накл-НДС,
     4151   НсП,
     4152   НсП+накл,
     4153   УчетнаяS,
     4154   Учет-рзрвS,
     4155   ПриходнаяS,
     4156   Учет-НДСS,
     4157   Откат_цен,
     4158   Спецификация
     4159   "
     4160     .
     4161   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     4162       p-calc-method = entry (1,p-calc-method, " ") no-error .
     4163       if error-status :error then message p-calc-method.
     4164   end.
     4165   define variable v-i as integer   no-undo init 0.
     4166     for each  x_obj-group :
     4167         v-i = v-i + 1.
     4168         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     4169             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     4170             skip
     4171             "код     :" p-gds-code  skip
     4172             "бар-код :" p-b-code    skip
     4173             "артикул :" p-artic     skip
     4174             "производитель :" p-prod-type        p-prod-code
     4175             view-as alert-box information .
     4176             leave.
     4177         end.
     4178         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     4179             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     4180             skip
     4181             "код     :" p-gds-code  skip
     4182             "бар-код :" p-b-code    skip
     4183             "артикул :" p-artic     skip
     4184             "производитель :" p-prod-type        p-prod-code
     4185             view-as alert-box information .
     4186             leave.
     4187         end.
     4188         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     4189             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     4190             skip
     4191             "код     :" p-gds-code   skip
     4192             "бар-код :" p-b-code    skip
     4193             "артикул :" p-artic             skip
     4194             "производитель :" p-prod-type        p-prod-code
     4195             view-as alert-box information .
     4196             leave.
     4197         end.
     4198     end.
     4199   p-vat-pc  = local_vat-pc .
     4200   p-slt-pc  = local_slt-pc .
     4201     if available buf_price-doc-forming then do:
     4202        find first buf_price-list-type no-lock where
     4203                   buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id    and
     4204                   buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num
     4205                   no-error .
     4206        if error-status :error then return error return-value .
     4207     end.
     4208     else do:
     4209   find first buf_price-list-type no-lock where
     4210              buf_price-list-type.plt-id     = v-plt-id    and
     4211              buf_price-list-type.plt-db-num = v-plt-db-num
     4212              no-error .
     4213      if error-status :error then return error return-value .
     4214     end.
     4215   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4216   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-mpl in g#library2
     4217     (input  buf_price-list-type.gop-id
     4218     ,input  buf_price-list-type.gop-db-num
     4219     ,input  p-b-code
     4220     ,input  0
     4221     ,input  0
     4222     ,output v1-recid
     4223     ,output p-price-prev-doc
     4224     ,output v1-cur-rt
     4225     ,output v1-cur-ex
     4226     ) no-error .
     4227       if error-status :error then
     4228       message
     4229         vss-workfile vss-revision vss-description skip
     4230         error-status :get-message(1) skip
     4231         return-value skip
     4232         "bc-mpl"
     4233         view-as alert-box error
     4234       .
     4235   define buffer old1_price-doc-forming     for ub.price-doc-forming  .
     4236   define buffer old1_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4237   find first old1_price-doc-forming no-lock where
     4238              recid(old1_price-doc-forming) = v1-recid no-error .
     4239   find first old1_price-doc-forming-gds no-lock where
     4240              old1_price-doc-forming-gds.pdf-db      = old1_price-doc-forming.pdf-db      and
     4241              old1_price-doc-forming-gds.pdf-id      = old1_price-doc-forming.pdf-id      and
     4242              old1_price-doc-forming-gds.plt-db-num  = old1_price-doc-forming.plt-db-num  and
     4243              old1_price-doc-forming-gds.plt-id      = old1_price-doc-forming.plt-id      and
     4244              old1_price-doc-forming-gds.b-code      = p-b-code
     4245              no-error .
     4246   if available old1_price-doc-forming-gds then do:
     4247      p-d-pcnt = old1_price-doc-forming-gds.d-pcnt .
     4248   end.
     4249   else do:
     4250     p-d-pcnt = 0 .
     4251   end.
     4252   case p-calc-method :
     4253      when 'Новая':U or
     4254      when 'Не-считать':U then do:
     4255       assign
     4256         p-new-calc-method = p-calc-method
     4257         cost-rubl = ?
     4258         cost-base = ?
     4259       .
     4260         if available buf_price-doc-forming then do:
     4261           assign
     4262             v-pdf-id      = buf_price-doc-forming.pdf-id
     4263             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     4264             v-plt-id2     = buf_price-doc-forming.plt-id
     4265             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     4266           .
     4267           find first buf_buf_price-doc-forming-gds no-lock where
     4268                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     4269                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     4270                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     4271                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     4272                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     4273                 no-error .
     4274               if available buf_buf_price-doc-forming-gds then do:
     4275                   assign
     4276                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     4277                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     4278                   .
     4279               end.
     4280         end.
     4281      end.
     4282      when 'УчетнаяS':U  or
     4283      when 'Учет-рзрвS':U  or
     4284      when 'ПриходнаяS':U
     4285      then do:
     4286         run str/sgdsavrg.p
     4287         (   input  p-calc-method    ,
     4288             input  table x_obj-group ,
     4289             input  p-b-code    ,
     4290             input  p-artic     ,
     4291             input  p-prod-type ,
     4292             input  p-prod-code ,
     4293             output cost-base   ,
     4294             output cost-rubl   ,
     4295             output cur-rt-base ,
     4296             output cur-rt-rubl
     4297             ).
     4298      end.
     4299      when 'Учет-НДСS':U or
     4300      when 'Накл-безНДС':U or
     4301      when 'Стар-безНДС':U or
     4302      when 'Старая':U or
     4303      when 'Учет+накл':U or
     4304      when 'Уч+накл-НДС':U or
     4305      when 'Откат_цен':U then do:
     4306         run str/mplnovat.p
     4307           ( input  p-calc-method    ,
     4308             input  table x_obj-group ,
     4309             input  p-b-code    ,
     4310             input  p-artic     ,
     4311             input  p-prod-type ,
     4312             input  p-prod-code ,
     4313             input  0 ,
     4314             input  v-doc-code ,
     4315             input  p-vat-pc      ,
     4316             input  p-slt-pc      ,
     4317             output vd  ,
     4318             output vd  ,
     4319             output cost-base   ,
     4320             output cost-rubl   ,
     4321             output cur-rt-base ,
     4322             output cur-rt-rubl
     4323             ).
     4324      end.
     4325      when 'Накладная':U then do:
     4326           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     4327           find first buf_doc-line  no-lock where
     4328                     buf_doc-line.doc-code = v-doc-code      and
     4329                     buf_doc-line.artic    = p-artic         and
     4330                     buf_doc-line.prod-type   = p-prod-type  and
     4331                     buf_doc-line.prod-code   = p-prod-code no-error .
     4332           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4333           find first buf_gds-dtl no-lock where
     4334                      buf_gds-dtl.doc-code  = v-doc-code   and
     4335                      buf_gds-dtl.artic     = p-artic      and
     4336                      buf_gds-dtl.prod-type = p-prod-type  and
     4337                      buf_gds-dtl.prod-code = p-prod-code  and
     4338                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4339           assign
     4340             v1 = recid (buf_trn-doc)
     4341             v2 = recid (buf_doc-line)
     4342             v3 = recid (buf_gds-dtl)
     4343             v4  = buf_gds-dtl.prt-code
     4344             no-error .
     4345             if not v-base then do:
     4346               run str/pr-wbil.p
     4347               ( input ""            ,
     4348                 input 'Накладная':U ,
     4349                 input v1               ,
     4350                 input v2               ,
     4351                 input v3               ,
     4352                 input v-doc-code       ,
     4353                 input ""               ,
     4354                 input p-gds-code       ,
     4355                 input p-artic          ,
     4356                 input p-prod-type      ,
     4357                 input p-prod-code      ,
     4358                 input v4               ,
     4359                 input 0                ,
     4360                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4361                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4362                 output cost-rubl       ,
     4363                 output v4
     4364                 ) no-error .
     4365             end.
     4366             else do:
     4367               run str/pr-wbil.p
     4368               ( input ""            ,
     4369                 input 'Накладная':U ,
     4370                 input v1               ,
     4371                 input v2               ,
     4372                 input v3               ,
     4373                 input v-doc-code       ,
     4374                 input ""               ,
     4375                 input p-gds-code       ,
     4376                 input p-artic          ,
     4377                 input p-prod-type      ,
     4378                 input p-prod-code      ,
     4379                 input v4               ,
     4380                 input 0                ,
     4381                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4382                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4383                 output cost-base       ,
     4384                 output v4
     4385                 ) no-error .
     4386             end.
     4387             if not error-status :error then
     4388                 assign
     4389                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4390                .
     4391       end.
     4392       when 'Переоценка':U then do:
     4393         find prev-list where
     4394              prev-list.b-code     = p-b-code and
     4395              prev-list.price-type = "" and
     4396              prev-list.doc-num    = v-doc-code no-lock no-error.
     4397         if available prev-list then
     4398           assign
     4399             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4400             cur-rt-base = prev-list.road-tax
     4401             cur-rt-rubl = prev-list.road-tax
     4402             cost-rubl = prev-list.price-sale
     4403             cost-base = prev-list.price-sale
     4404             .
     4405         else
     4406           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4407                   "- расчет невозможен."
     4408                   view-as alert-box information .
     4409       end.
     4410       when 'ДокФормЦены':U then do:
     4411       find first b_price-doc-forming no-lock where
     4412                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     4413                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4414                  no-error .
     4415         find b_price-doc-forming-gds no-lock where
     4416              b_price-doc-forming-gds.b-code     = p-b-code and
     4417              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4418              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4419              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4420              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4421              no-error.
     4422         if available b_price-doc-forming-gds then
     4423           assign
     4424             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4425             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4426             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4427             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4428             cost-base   = b_price-doc-forming-gds.price-sale-base
     4429             .
     4430         else
     4431           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     4432                   "для товара :" skip
     4433                    "Бар-код" p-b-code     skip
     4434                    "Артикул" p-artic      skip
     4435                     p-prod-type  skip
     4436                     p-prod-code  skip
     4437                   "- расчет невозможен."
     4438                   view-as alert-box information .
     4439       end.
     4440       when 'Единая':U then do:
     4441           assign
     4442             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4443             cost-rubl = common-price
     4444             cost-base = common-price
     4445             .
     4446       end.
     4447       when 'Объект':U then do:
     4448       find first buf_gds-obj no-lock where
     4449                  buf_gds-obj.gds-code = p-gds-code and
     4450                  buf_gds-obj.obj-type = v-copy-type and
     4451                  buf_gds-obj.obj-code = v-copy-code no-error .
     4452           if available buf_gds-obj then do:
     4453           assign
     4454             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     4455             cost-rubl = buf_gds-obj.price-sale
     4456             cost-base = buf_gds-obj.price-sale
     4457             .
     4458           end.
     4459           else do:
     4460               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     4461                       "для товара :" p-artic  "- расчет невозможен."
     4462                       view-as alert-box information .
     4463           end.
     4464       end.
     4465      when 'Отсутствует':U or
     4466      when "" then do:
     4467         run str/mplnovat.p
     4468           ( input  'Отсутствует':U    ,
     4469             input  table x_obj-group ,
     4470             input  p-b-code    ,
     4471             input  p-artic     ,
     4472             input  p-prod-type ,
     4473             input  p-prod-code ,
     4474             input  0 ,
     4475             input  v-doc-code ,
     4476             input  p-vat-pc      ,
     4477             input  p-slt-pc      ,
     4478             output vd  ,
     4479             output vd  ,
     4480             output cost-base   ,
     4481             output cost-rubl   ,
     4482             output cur-rt-base ,
     4483             output cur-rt-rubl
     4484             ).
     4485             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4486             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4487             p-new-calc-method = 'Отсутствует':U .
     4488      end.
     4489      when 'Основная':U then do:
     4490      end.
     4491       when 'ПорогПр-НДС':U then do:
     4492         find first x_obj-group.
     4493             run calc-price-levelprod (
     4494               input 2          ,
     4495               input var-pr-r-b ,
     4496               input p-b-code   ,
     4497               input x_obj-group.obj-type ,
     4498               input x_obj-group.obj-code ,
     4499               output vd,
     4500               output v-descript
     4501             ) no-error.
     4502         if vd = 0 or vd = ?  then do:
     4503           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4504                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4505                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4506                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     4507         end.
     4508         else do:
     4509             cost-rubl = vd .
     4510             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4511             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4512         end.
     4513       end.
     4514       when 'ПорогПр+НДС':U then do:
     4515         find first x_obj-group.
     4516             run calc-price-levelprod (
     4517               input 1          ,
     4518               input var-pr-r-b ,
     4519               input p-b-code   ,
     4520               input x_obj-group.obj-type ,
     4521               input x_obj-group.obj-code ,
     4522               output vd ,
     4523               output v-descript
     4524             ) no-error.
     4525         if vd = 0 or vd = ?  then do:
     4526           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4527                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4528                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4529                   view-as alert-box information .
     4530         end.
     4531         else do:
     4532             cost-rubl = vd .
     4533             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4534             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4535         end.
     4536       end.
     4537       when 'Производит':U
     4538       then do:
     4539         find first x_obj-group.
