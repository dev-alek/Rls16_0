      190   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191     run mainmenu_getcntxt in parparentproc
      192       (output v-cntxp-db-num
      193       ,output v-cntxp-userid
      194       ,output v-cntxp-level
      195       ,output v-cntxp-curr-host-code
      196       ,output v-cntxp-obj-type
      197       ,output v-cntxp-obj-code
      198       ,output v-cntxp-db-num-obj
      199       ,output v-cntxp-is-admin
      200       ) .
      201     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      202        v-cntxp-obj-code <> 0 then do:
      203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      204     (input  'is-prt'
      205     ,input  0
      206     ,input  ''
      207     ,input  0
      208     ,input  ''
      209     ,input  ''
      210     ,input  ''
      211     ,input  yes
      212     ,output v-cntxp-conf-par
      213     ,output v-cntxp-par-type
      214     ) no-error .
      215       case v-cntxp-obj-type :
      216         when 'скл':U then do:
      217           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
