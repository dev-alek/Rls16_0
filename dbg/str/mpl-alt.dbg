     7588   ON CHOOSE OF MENU-ITEM m-cur-add DO:
     7589   define variable vss-include-info81 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7590   if lookup(b-add :type in frame d-pr-alt
     7591            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     7592            ) = 0
