     6266       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6267       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6268       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6269       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6270       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6271       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6272       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6273       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
