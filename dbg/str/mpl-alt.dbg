     8602   if code-rec <> ? then
     8603     reposition br-alt to recid code-rec no-error.
     8604   apply "entry" to br-alt in frame d-pr-alt.
     8605   apply "value-changed" to br-alt in frame d-pr-alt.
     8606   END PROCEDURE.
     8607   PROCEDURE add-alt :
     8608   define input parameter add-list as character no-undo.
     8609   define variable d-pcnt as decimal   no-undo .
     8610   define variable rec-list as character  no-undo.
     8611   define variable num-rec  as integer    no-undo.
     8612   define variable v-price-calc-base as decimal   no-undo .
     8613   define variable v-price-calc-doc  as decimal   no-undo .
     8614   define variable v-price-calc-rubl as decimal   no-undo .
     8615   define variable v-price-prev-base as decimal   no-undo .
     8616   define variable v-price-prev-doc  as decimal   no-undo .
     8617   define variable v-price-prev-rubl as decimal   no-undo .
     8618   define variable v-price-sale-base as decimal   no-undo .
     8619   define variable v-price-sale-doc  as decimal   no-undo .
     8620   define variable v-price-sale-rubl as decimal   no-undo .
     8621   define variable v-road-tax-base   as decimal   no-undo .
     8622   define variable v-road-tax-doc    as decimal   no-undo .
     8623   define variable v-road-tax-rubl   as decimal   no-undo .
     8624   define variable v-excise-base     as decimal   no-undo .
     8625   define variable v-excise-doc      as decimal   no-undo .
     8626   define variable v-excise-rubl     as decimal   no-undo .
     8627   define variable v-vat-pc          as decimal   no-undo .
     8628   define variable v-slt-pc          as decimal   no-undo .
     8629   define buffer bb_bar-code for ub.bar-code  .
     8630   run ref/alt-cds.w
     8631       ( parParentProc
     8632       ,input p-obj-type
     8633       ,input p-obj-code
     8634       ,input (mode + "-" + add-list)
     8635       ,input buf_base_goods.gds-code
     8636       ,input p-b-code
     8637       ,output rec-list).
     8638   apply "entry" to br-alt in frame d-pr-alt.
     8639   if rec-list = '' then
     8640     return no-apply.
     8641   code-rec = ?.
     8642   run last-num ( input recid(buf_price-doc-forming) , output v-line-num ) .
     8643   define variable v-nn as integer   no-undo .
     8644   v-nn = num-entries (rec-list) .
     8645   do num-rec = 1 to v-nn :
     8646     ref-rec = integer (entry (num-rec, rec-list)).
     8647     find first bb_bar-code no-lock where recid (bb_bar-code) = ref-rec .
     8648   define variable v-cur-dn as character no-undo .
     8649   define variable v-cur-pr as decimal no-undo .
     8650   define variable v-cur-rt as decimal no-undo .
     8651   define variable v-cur-ex as decimal no-undo .
     8652   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8654     (input  p-obj-type
     8655     ,input  p-obj-code
     8656     ,input  bb_bar-code.b-code
     8657     ,input  0
     8658     ,input  0
     8659     ,output v-cur-dn
     8660     ,output v-cur-pr
     8661     ,output v-cur-rt
     8662     ,output v-cur-ex
     8663     )  .
     8664   define buffer old1_price-list    for ub.price-list  .
     8665   find first old1_price-list no-lock where
     8666              old1_price-list.doc-num     = v-cur-dn      and
     8667              old1_price-list.price-type  = ""            and
     8668              old1_price-list.b-code      = bb_bar-code.b-code
     8669              no-error .
     8670   if available old1_price-list then do:
     8671      d-pcnt = old1_price-list.d-pcnt .
     8672   end.
     8673   else do:
     8674     d-pcnt = 0 .
     8675   end.
     8676       run calc-price-alt in this-procedure
     8677         ( input  bb_bar-code.b-code
     8678         , input recid(buf_price-doc-forming)
     8679         , input  d-pcnt
     8680         , input  round-method
     8681         , input  round-base
     8682         , output v-price-sale-base
     8683         , output v-price-sale-doc
     8684         , output v-price-sale-rubl
     8685           ).
     8686       v-line-num = v-line-num + 1 .
     8687       define buffer bb_price-doc-forming-gds for ub.price-doc-forming-gds  .
     8688       find first bb_price-doc-forming-gds no-lock where
     8689                  bb_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
     8690                  bb_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id     and
     8691                  bb_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db     and
     8692                  bb_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id     and
     8693                  bb_price-doc-forming-gds.artic      = buf_base_goods.artic             and
     8694                  bb_price-doc-forming-gds.prod-type  = buf_base_goods.prod-type         and
     8695                  bb_price-doc-forming-gds.prod-code  = buf_base_goods.prod-code         no-error .
     8696       if available bb_price-doc-forming-gds then
     8697       assign
     8698         v-vat-pc = bb_price-doc-forming-gds.vat-pc
     8699         v-slt-pc = bb_price-doc-forming-gds.slt-pc
     8700         .
     8701       else
     8702       assign
     8703         v-vat-pc = 0
     8704         v-slt-pc = 0
     8705         .
     8706       run create-line  in this-procedure (
     8707          buf_price-doc-forming.plt-db-num
     8708         ,buf_price-doc-forming.plt-id
     8709         ,buf_price-doc-forming.pdf-db
     8710         ,buf_price-doc-forming.pdf-id
     8711         ,v-line-num
     8712         ,bb_bar-code.b-code
     8713         ,buf_base_goods.artic
     8714         ,buf_base_goods.prod-type
     8715         ,buf_base_goods.prod-code
     8716         ,'Основная':U
     8717         ,d-pcnt
     8718         ,buf_price-doc-forming.have-start-period
     8719         ,buf_price-doc-forming.start-date
     8720         ,buf_price-doc-forming.start-shift-date
     8721         ,buf_price-doc-forming.start-shift-name
     8722         ,buf_price-doc-forming.start-shift-num
     8723         ,buf_price-doc-forming.start-sys-date
     8724         ,buf_price-doc-forming.start-sys-time
     8725         ,buf_price-doc-forming.have-end-period
     8726         ,buf_price-doc-forming.end-date
     8727         ,buf_price-doc-forming.end-shift-date
     8728         ,buf_price-doc-forming.end-shift-name
     8729         ,buf_price-doc-forming.end-shift-num
     8730         ,buf_price-doc-forming.end-sys-date
     8731         ,buf_price-doc-forming.end-sys-time
     8732         ,v-price-calc-base
     8733         ,v-price-calc-doc
     8734         ,v-price-calc-rubl
     8735         ,v-price-prev-base
     8736         ,v-price-prev-doc
     8737         ,v-price-prev-rubl
     8738         ,v-price-sale-base
     8739         ,v-price-sale-doc
     8740         ,v-price-sale-rubl
     8741         ,v-road-tax-base
     8742         ,v-road-tax-doc
     8743         ,v-road-tax-rubl
     8744         ,v-excise-base
     8745         ,v-excise-doc
     8746         ,v-excise-rubl
     8747         ,v-vat-pc
     8748         ,v-slt-pc
     8749         ,""
     8750         ,0
     8751         ,input-output v-sec
     8752         ) .
     8753   end.
     8754   run open-br.
     8755   END PROCEDURE.
     8756   procedure upd-br-field:
     8757     find current buf_price-doc-forming-gds share-lock.
     8758     if decimal  (buf_price-doc-forming-gds.price-sale-doc :screen-value in browse br-alt) <> buf_price-doc-forming-gds.price-sale-doc then do:
     8759       assign
     8760         buf_price-doc-forming-gds.calc-method = 'Отсутствует':U
     8761         buf_price-doc-forming-gds.price-calc-doc  = buf_price-doc-forming-gds.price-sale-doc
     8762         buf_price-doc-forming-gds.price-sale-doc  = decimal  (buf_price-doc-forming-gds.price-sale-doc :screen-value in browse br-alt)
     8763         buf_price-doc-forming-gds.price-sale-rubl = buf_price-doc-forming-gds.price-sale-doc * buf_price-doc-forming.exch-rate / buf_price-doc-forming.exch-scale .
     8764         buf_price-doc-forming-gds.price-sale-base = buf_price-doc-forming-gds.price-sale-rubl / buf_price-doc-forming.base-rate * buf_price-doc-forming.base-scale .
     8765         .
     8766       if buf_price-doc-forming-gds.d-pcnt = ? then do:
     8767       end.
     8768     end.
     8769     else do:
     8770       if decimal  (buf_price-doc-forming-gds.d-pcnt     :screen-value in browse br-alt) <> buf_price-doc-forming-gds.d-pcnt then do:
     8771         buf_price-doc-forming-gds.d-pcnt     = decimal  (buf_price-doc-forming-gds.d-pcnt     :screen-value in browse br-alt).
     8772         if buf_price-doc-forming-gds.d-pcnt <> ? then do:
     8773           run calc-price-alt in this-procedure
     8774               (input  buf_price-doc-forming-gds.b-code
     8775               ,input recid(buf_price-doc-forming)
     8776               ,input  buf_price-doc-forming-gds.d-pcnt
     8777               ,input  round-method
     8778               ,input  round-base
     8779               ,output buf_price-doc-forming-gds.price-sale-base
     8780               ,output buf_price-doc-forming-gds.price-sale-doc
     8781               ,output buf_price-doc-forming-gds.price-sale-rubl
     8782               ) no-error .
     8783                 if error-status:error then
     8784                    return error.
     8785         end.
     8786       end.
     8787       else
     8788         assign
     8789           buf_price-doc-forming-gds.road-tax-doc   = decimal  (buf_price-doc-forming-gds.road-tax-doc   :screen-value in browse br-alt)
     8790           buf_price-doc-forming-gds.excise-doc     = decimal  (buf_price-doc-forming-gds.excise-doc     :screen-value in browse br-alt)
     8791           .
     8792     end.
     8793   end procedure.
