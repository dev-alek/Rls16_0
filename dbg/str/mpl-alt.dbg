     7047   ASSIGN
     7048     FRAME d-pr-alt:SCROLLABLE = FALSE
     7049     br-alt   :NUM-LOCKED-COLUMNS IN FRAME d-pr-alt = 1
     7050     b-add     :POPUP-MENU IN FRAME d-pr-alt         = MENU m-add  :HANDLE
     7051     b-add     :MENU-MOUSE                                = 1
     7052     .
     7053   def var sort-labelbr-alt   as character no-undo .
     7054   def var sort-clmnbr-alt    as handle    no-undo .
     7055   def var cur-clmnbr-alt     as handle    no-undo .
     7056   def var cur-clmn-locbr-alt as integer   no-undo .
     7057   def var re-querybr-alt     as logical   initial no no-undo .
     7058   on start-search, ctrl-o of br-alt in frame d-pr-alt do:
     7059      run sort-brbr-alt
     7060        (input (if available buf_price-doc-forming-gds
     7061                then recid(buf_price-doc-forming-gds)
     7062                else ?
     7063               )
     7064        ).
     7065   end.
     7066   PROCEDURE sort-brbr-alt :
     7067     define input parameter p-recid as recid no-undo .
     7068     if re-querybr-alt = no then do:
     7069       assign
     7070          cur-clmnbr-alt = br-alt:current-column in frame d-pr-alt
     7071       .
     7072       if sort-clmnbr-alt <> ? then sort-clmnbr-alt:column-fgcolor = 0.
     7073       if cur-clmnbr-alt = sort-clmnbr-alt then do:
     7074         assign
     7075            sort-labelbr-alt = ""
     7076            sort-clmnbr-alt = ?
     7077         .
     7078        end.
     7079        else do:
     7080          assign
     7081            sort-labelbr-alt = cur-clmnbr-alt:label
     7082            sort-clmnbr-alt  = cur-clmnbr-alt
     7083            sort-clmnbr-alt:column-fgcolor = 4
     7084          .
     7085        end.
     7086      end.
     7087     assign
     7088       cur-clmn-locbr-alt = 1
     7089     .
     7090     def var column-handle as handle no-undo .
     7091     column-handle = br-alt:first-column.
     7092     do while valid-handle(column-handle) :
     7093       if column-handle = cur-clmnbr-alt then do:
     7094         leave .
     7095       end.
     7096       column-handle = column-handle:NEXT-COLUMN.
     7097       assign
     7098         cur-clmn-locbr-alt = cur-clmn-locbr-alt + 1
     7099       .
     7100     end.
     7101     case sort-labelbr-alt:
     7102           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-mark&1,  Buf_price-doc-forming-gds.b-code )' , chr(34))     .     run open-br.   . END.
     7103           when 'Тип'  then DO:    assign       sort-column-name = "if buf_gds-prt.upper-code = buf_goods.prt-root then         if buf_bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U"     .     run open-br.   . END.
     7104           when 'Глав. код'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-main-code&1,  Buf_price-doc-forming-gds.b-code )' , chr(34))     .     run open-br.   . END.
     7105           when 'Осн. код'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-base-code&1, Buf_price-doc-forming-gds.b-code )' , chr(34))     .     run open-br.   . END.
     7106           when 'Код'  then DO:    assign       sort-column-name = "buf_bar-code.b-code"     .     run open-br.   . END.
     7107           when 'Осн. цена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-base-price-doc&1, ( Buf_price-doc-forming-gds.b-code ), (&1&2&1)) ' , chr(34),  recid(buf_price-doc-forming) )     .     run open-br.   . END.
     7108           when 'Изм'  then DO:    assign       sort-column-name = "buf_goods.unit-base"     .     run open-br.   . END.
     7109           when 'Коэф'  then DO:    assign       sort-column-name = "buf_bar-code.cli-base-rate"     .     run open-br.   . END.
     7110           when 'Скидка'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.d-pcnt"     .     run open-br.   . END.
     7111           when 'Цена'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-sale-doc"     .     run open-br.   . END.
     7112           when 'Изм'  then DO:    assign       sort-column-name = "buf_bar-code.unit-cli"     .     run open-br.   . END.
     7113           when dor-nal  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.road-tax-doc"     .     run open-br.   . END.
     7114           when 'Акциз'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.excise-doc"     .     run open-br.   . END.
     7115       otherwise do:
     7116         assign
     7117           sort-column-name = ""
     7118         .
     7119         run open-br.
     7120         if sort-labelbr-alt <> "" then do:
     7121           assign
     7122             cur-clmnbr-alt:column-fgcolor = 0
     7123           .
     7124         end.
     7125         assign
     7126           cur-clmn-locbr-alt = ?
     7127         .
     7128       end.
     7129     end case.
     7130     if p-recid <> ? then do:
     7131       reposition br-alt to recid p-recid no-error.
     7132       apply "value-changed" to br-alt in frame d-pr-alt.
     7133     end.
     7134     apply "entry" to br-alt in frame d-pr-alt.
     7135   END PROCEDURE.
     7136   procedure re-open-query-srt-clmnbr-alt:
     7137   if cur-clmnbr-alt = ? then do:
     7138      run open-br.
     7139   end.
     7140   else do:
     7141      assign re-querybr-alt = yes.
     7142      run sort-brbr-alt
     7143        (input (if available buf_price-doc-forming-gds
     7144                then recid(buf_price-doc-forming-gds)
     7145                else ?
     7146               )
     7147        ).
     7148      assign re-querybr-alt = no.
     7149   end.
     7150   end.
     7151   define variable vss-include-info69 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7152   on CTRL-N, CTRL-Т of frame d-pr-alt anywhere do:
     7153     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-pr-alt. END.
     7154     return no-apply.
     7155   end.
     7156   define variable vss-include-info70 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7157   on INS of frame d-pr-alt anywhere do:
     7158     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-pr-alt. END.
     7159     return no-apply.
     7160   end.
     7161   define variable vss-include-info71 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7162   on F4 of frame d-pr-alt anywhere do:
     7163     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-pr-alt. END.
     7164     return no-apply.
     7165   end.
     7166   define variable vss-include-info72 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7167   on F8 of frame d-pr-alt anywhere do:
     7168     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-pr-alt. END.
     7169     return no-apply.
     7170   end.
     7171   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7172   on F9 of frame d-pr-alt anywhere do:
     7173     if not available ub.goods then
     7174       return no-apply.
     7175     gds-rec = recid (ub.goods).
     7176     run ref/gds-form.w ( input parParentProc
     7177                         ,input 'ПРОСМОТР':U
     7178                         ,input ?
     7179                         ,input ?
     7180                         ,input ?
     7181                         ,input-output gds-rec).
     7182     apply "entry" to br-alt in frame d-pr-alt.
     7183     return no-apply.
     7184   end.
     7185   on SHIFT-F9 of frame d-pr-alt anywhere do:
     7186     if not available goods then
     7187       return no-apply.
     7188     gds-rec = recid (goods).
     7189     run ref/gds-form.w ( input parParentProc
     7190                         ,input 'ПРОСМОТР':U
     7191                         ,input ?
     7192                         ,input ?
     7193                         ,input ?
     7194                         ,input-output gds-rec).
     7195     apply "entry" to br-alt in frame d-pr-alt.
     7196     return no-apply.
     7197   end.
     7198   on end-error of buf_price-doc-forming-gds.price-sale-doc, buf_price-doc-forming-gds.road-tax-doc, buf_price-doc-forming-gds.excise-doc in browse br-alt do:
     7199     display  fnc-mark (Buf_price-doc-forming-gds.b-code)   @ mark                 COLUMN-LABEL '*'  FORMAT "x(1)" if buf_gds-prt.upper-code = buf_goods.prt-root then         if buf_bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U   @ calc-dtl             COLUMN-LABEL 'Тип'  FORMAT "x(3)" fnc-main-code (Buf_price-doc-forming-gds.b-code)   @ main-bc-br           COLUMN-LABEL 'Глав. код'  fnc-base-code (Buf_price-doc-forming-gds.b-code)   @ v-base-b-code        COLUMN-LABEL 'Осн. код'  buf_bar-code.b-code                          COLUMN-LABEL 'Код'  fnc-base-price-doc (Buf_price-doc-forming-gds.b-code, recid(buf_price-doc-forming) )   @ arg-base             COLUMN-LABEL 'Осн. цена'  buf_goods.unit-base                          COLUMN-LABEL 'Изм'  FORMAT "x(3)"  buf_bar-code.cli-base-rate                          COLUMN-LABEL 'Коэф'  buf_price-doc-forming-gds.d-pcnt                          COLUMN-LABEL 'Скидка'  buf_price-doc-forming-gds.price-sale-doc                         COLUMN-LABEL 'Цена'  buf_bar-code.unit-cli                         COLUMN-LABEL 'Изм' FORMAT "x(3)"  buf_price-doc-forming-gds.road-tax-doc                          buf_price-doc-forming-gds.excise-doc                         COLUMN-LABEL 'Акциз' buf_price-doc-forming-gds.price-sale-rubl  buf_price-doc-forming-gds.price-sale-base with browse br-alt.
     7200     return no-apply.
     7201   end.
     7202   ON MOUSE-SELECT-DBLCLICK, return OF br-alt IN FRAME d-pr-alt DO:
     7203   apply "choose" to b-mark in frame d-pr-alt.
     7204   END.
     7205   ON CHOOSE OF b-mark IN FRAME d-pr-alt
     7206   DO:
     7207   define variable vss-include-info74 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7208   if lookup(self :type
     7209            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     7210            ) = 0
     7211   then do:
     7212     message
     7213       "$Workfile$"
     7214       "Указанному интерфейсному элементу фокус не может быть передан" skip
     7215       "Интерфейсный элемент" self :name  skip
     7216       "Тип" self :type  skip
     7217       "Процедура" this-procedure :file-name skip
     7218       view-as alert-box .
     7219   end.
     7220   else do:
     7221     apply "entry":u to self  .
     7222     if focus :handle <> self :handle  then do:
     7223       return no-apply .
     7224     end.
     7225   end.
     7226   if not available buf_price-doc-forming-gds then
     7227     return no-apply.
