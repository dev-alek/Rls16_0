      958   procedure prcreate-new-price-doc-forming-gds :
      959   define input  parameter p-price-doc-forming-recid as recid  no-undo.
      960   define input  parameter p-obj-type   as character no-undo .
      961   define input  parameter p-obj-code   as integer   no-undo .
      962   define input  parameter par-pr-notls as character no-undo .
      963   define input  parameter par-pr-altex as character no-undo .
      964   define input  parameter par-pr-sclex as character no-undo .
      965   define input  parameter p-line-num    as integer   no-undo .
      966   define input  parameter p-gds-code    as integer   no-undo .
      967   define input  parameter p-price-sale  as decimal   no-undo .
      968   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      969   define buffer buf_goods for ub.goods  .
      970   define buffer buf_bar-code for ub.bar-code  .
      971   define buffer main_bar-code for ub.bar-code  .
      972   define variable main-b-code as integer   no-undo .
      973   define variable v-sec as integer   no-undo .
      974     do
      975     on error undo, return error return-value
      976     :
      977   define variable v-cur-dn as character no-undo .
      978   define variable v-cur-pr as decimal   no-undo .
      979   define variable v-cur-rt as decimal   no-undo .
      980   define variable v-cur-ex as decimal   no-undo .
      981   find first buf_price-doc-forming no-lock where
      982              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      983              if error-status :error then return error .
      984   find first buf_goods no-lock where
      985              buf_goods.gds-code  = p-gds-code no-error .
      986              if error-status :error then return error .
      987   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      988     (input  buf_goods.gds-code
      989     ,input  ?
      990     ,output main-b-code
      991     ) no-error .
      992   run check-use-bar-code (main-b-code) no-error .
      993   if error-status :error then return .
      994   run create-line-pdf-mpl-lib (
      995        input buf_price-doc-forming.plt-db-num
      996       ,input buf_price-doc-forming.plt-id
      997       ,input buf_price-doc-forming.pdf-db
      998       ,input buf_price-doc-forming.pdf-id
      999       ,input p-line-num
     1000       ,input main-b-code
     1001       ,input buf_goods.artic
     1002       ,input buf_goods.prod-type
     1003       ,input buf_goods.prod-code
     1004       ,input ""
     1005       ,input 0
     1006       ,input p-price-sale
     1007       ,input ""
     1008       ,input 0
     1009      ,input-output v-sec ) no-error .
     1010      if error-status :error  then do:
     1011        message
     1012          vss-workfile vss-revision vss-description skip
     1013          error-status :get-message(1) skip
     1014          return-value skip
     1015          "2"
     1016          view-as alert-box error
     1017        .
     1018      end.
     1019   define buffer old_price-list for ub.price-list  .
     1020   if par-pr-notls = "yes" then do:
     1021   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1023     (input  p-obj-type
     1024     ,input  p-obj-code
     1025     ,input  main-b-code
     1026     ,input  0
     1027     ,input  0
     1028     ,output v-cur-dn
     1029     ,output v-cur-pr
     1030     ,output v-cur-rt
     1031     ,output v-cur-ex
     1032     )  .
     1033   end.
     1034   if par-pr-altex = "yes" and
     1035      par-pr-notls = "yes" then do:
     1036       if v-cur-dn <> "" then do:
     1037           for each old_price-list no-lock where
     1038                    old_price-list.doc-num = v-cur-dn and
     1039                    old_price-list.artic      = buf_goods.artic and
     1040                    old_price-list.prod-type  = buf_goods.prod-type and
     1041                    old_price-list.prod-code  = buf_goods.prod-code and
     1042                    old_price-list.main-price = no,
     1043                   first buf_bar-code no-lock where
     1044                         buf_bar-code.b-code   = old_price-list.b-code and
     1045                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1046                         :
     1047                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1048                          if error-status :error then next.
     1049                    run create-line-pdf-mpl-lib (
     1050                          input buf_price-doc-forming.plt-db-num
     1051                         ,input buf_price-doc-forming.plt-id
     1052                         ,input buf_price-doc-forming.pdf-db
     1053                         ,input buf_price-doc-forming.pdf-id
     1054                         ,input p-line-num
     1055                         ,input old_price-list.b-code
     1056                         ,input buf_goods.artic
     1057                         ,input buf_goods.prod-type
     1058                         ,input buf_goods.prod-code
     1059                         ,input ""
     1060                         ,input 0
     1061                         ,input old_price-list.price-sale
     1062                         ,input ""
     1063                         ,input 0
     1064                        ,input-output v-sec ) no-error .
     1065           end.
     1066       end.
     1067   end.
     1068   if par-pr-sclex = "yes" and
     1069      par-pr-notls = "yes" then do:
     1070       if v-cur-dn <> "" then do:
     1071           for each old_price-list no-lock where
     1072                    old_price-list.doc-num    = v-cur-dn and
     1073                    old_price-list.artic      = buf_goods.artic and
     1074                    old_price-list.prod-type  = buf_goods.prod-type and
     1075                    old_price-list.prod-code  = buf_goods.prod-code and
     1076                    old_price-list.main-price = no,
     1077                   first buf_bar-code no-lock where
     1078                         buf_bar-code.b-code   = old_price-list.b-code and
     1079                         buf_bar-code.in-code  = "" and
     1080                         buf_bar-code.unit-cli = buf_goods.unit-base
     1081                         :
     1082                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1083                          if error-status :error then next.
     1084                    run create-line-pdf-mpl-lib (
     1085                          input buf_price-doc-forming.plt-db-num
     1086                         ,input buf_price-doc-forming.plt-id
     1087                         ,input buf_price-doc-forming.pdf-db
     1088                         ,input buf_price-doc-forming.pdf-id
     1089                         ,input p-line-num
     1090                         ,input old_price-list.b-code
     1091                         ,input buf_goods.artic
     1092                         ,input buf_goods.prod-type
     1093                         ,input buf_goods.prod-code
     1094                         ,input ""
     1095                         ,input 0
     1096                         ,input old_price-list.price-sale
     1097                         ,input ""
     1098                         ,input 0
     1099                       ,input-output v-sec ) no-error .
     1100           end.
     1101       end.
     1102   end.
     1103   end.
     1104   end procedure.
     1105   procedure copy_new_price-doc-forming :
     1106   define input  parameter       p-recid      as recid no-undo .
     1107   define input-output parameter p-plt-db-num as integer   no-undo .
     1108   define input-output parameter p-plt-id     as integer   no-undo .
     1109   define output parameter       p-pdf-db-num as integer   no-undo .
     1110   define output parameter       p-pdf-id     as integer   no-undo .
     1111   define buffer buf_price-list-type        for ub.price-list-type  .
     1112   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1113   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1114   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1115   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1116   define variable v-host-code  as integer   no-undo .
     1117   define variable v-base-rate  as decimal   no-undo .
     1118   define variable v-base-scale as integer   no-undo .
     1119   define variable v-exch-rate  as decimal   no-undo .
     1120   define variable v-exch-scale as integer   no-undo .
     1121   define variable v-base as logical   no-undo .
     1122   define variable v-name as character no-undo .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1128     (output v-base
     1129     )  .
     1130   find first buf_price-list-type no-lock where
     1131              buf_price-list-type.plt-db-num = p-plt-db-num and
     1132              buf_price-list-type.plt-id     = p-plt-id no-error .
     1133   if error-status :error then return error "Не найден ТПЛ".
     1134   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1135   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1136       if available buf_price-doc-forming then do :
     1137           assign
     1138             v-base-rate  = buf_price-doc-forming.base-rate
     1139             v-base-scale = buf_price-doc-forming.base-scale
     1140             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1141           .
     1142       end.
     1143       else do:
     1144           assign
     1145             v-base-rate  = 1
     1146             v-base-scale = 1
     1147             v-name       = "Автосоздание"
     1148           .
     1149       end.
     1150      create ub.price-doc-forming.
     1151      assign
     1152         ub.price-doc-forming.plt-id       = p-plt-id
     1153         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1154         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1155         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1156         ub.price-doc-forming.base-rate    = v-base-rate
     1157         ub.price-doc-forming.base-scale   = v-base-scale
     1158         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1159         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1160         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1161         ub.price-doc-forming.stts         = 0
     1162         ub.price-doc-forming.sys-date     = today
     1163         ub.price-doc-forming.sys-time     = time
     1164         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1165         ub.price-doc-forming.who          = v-cntxt-userid
     1166         ub.price-doc-forming.name         = v-name
     1167      .
     1168      assign
     1169       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1170       p-pdf-id      = ub.price-doc-forming.pdf-id
     1171       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1172       p-plt-id      = ub.price-doc-forming.plt-id
     1173      .
     1174     end.
     1175     if not available buf_price-doc-forming then return .
     1176   for each buf_price-doc-forming-attr no-lock where
     1177            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1178            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1179            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1180            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1181       create ub.price-doc-forming-attr.
     1182       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1183       assign
     1184         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1185         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1186         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1187         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1188         .
     1189   end.
     1190   for each buf_price-doc-forming-gds no-lock where
     1191            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1192            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1193            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1194            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1195       create ub.price-doc-forming-gds.
     1196       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1197       assign
     1198         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1199         ub.price-doc-forming-gds.plt-id      = p-plt-id
