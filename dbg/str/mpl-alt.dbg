     6275       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6276       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6277       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6278       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6279       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6280       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6281       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6282       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6283       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6284       define variable varinvatp-envd             as   character              no-undo.
     6285       define variable varinvatp-type             as   character              no-undo.
