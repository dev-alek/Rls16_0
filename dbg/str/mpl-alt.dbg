     6524                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6525           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6526                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6527           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6528           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6529           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6530         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6531         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6532         if transport-base-loc = ? then transport-base-loc = 0.
     6533         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6534         if other-base-loc     = ? then other-base-loc     = 0.
     6535         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6536         assign
     6537           transport-cli-loc      = 0
     6538           other-cli-loc          = 0
     6539           road-tax-cli-loc       = ?
     6540           vat-cli-loc            = ?
     6541           slt-cli-loc            = ?
     6542           price-cli-with-tax-loc = ?.
     6543      end.
     6544   ASSIGN
     6545             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6546       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6547   .
     6548                 assign
     6549                   p-road-tax-rubl =  road-tax-rubl-loc
     6550                   p-road-tax-base =  road-tax-base-loc
     6551                   .
     6552               end.
     6553         end.
     6554     end.
     6555   end procedure.
     6556   procedure calc-sigma :
     6557    do
     6558    on error undo, return error return-value
     6559    :
     6560   define input parameter l-bcode like ub.price-list.b-code no-undo .
     6561   define input-output parameter new-price as decimal no-undo .
     6562   define input parameter l-host as integer no-undo .
     6563   define input parameter l-code as integer no-undo .
     6564   define input parameter l-type as character no-undo .
     6565   define output parameter p-ret as logical no-undo .
     6566   define variable conf-par     as character no-undo.
     6567   define variable par-type     as character no-undo.
     6568   define variable i-sigma as decimal no-undo .
     6569   define variable cur-pr like ub.price-list.price-sale no-undo.
     6570   define variable cur-rt like ub.price-list.road-tax   no-undo.
     6571   define variable cur-ex like ub.price-list.excise     no-undo.
     6572   define variable cur-dn like ub.price-list.doc-num    no-undo.
     6573   define variable old-price as decimal no-undo .
     6574   p-ret = true  .
     6575   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     6576   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6578     (input  l-type
     6579     ,input  l-code
     6580     ,input  l-bcode
     6581     ,input  0
     6582     ,input  0
     6583     ,output cur-dn
     6584     ,output cur-pr
     6585     ,output cur-rt
     6586     ,output cur-ex
     6587     )  .
     6588   old-price = cur-pr .
     6589   if old-price =  new-price then do:
     6590      p-ret = true .
     6591      return.
     6592   end.
     6593      i-sigma = decimal(par-pr-sigma) .
     6594      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     6595          p-ret = false .
     6596          new-price = old-price.
     6597          end.
     6598      else p-ret = true .
     6599   end.
     6600    end.
     6601   end procedure.
     6602   def var vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6603   procedure check-use-bar-code :
     6604     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     6605     do
     6606     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info65, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6607     on stop   undo, return error substitute( "&1. stop", vss-include-info65 )
     6608     on endkey undo, return error substitute( "&1. endkey", vss-include-info65 )
     6609     :
     6610       define buffer buf_bar-code for ub.bar-code .
     6611       find first buf_bar-code no-lock
     6612         where buf_bar-code.b-code     = p-b-code
     6613         no-error .
     6614       if not available buf_bar-code then do:
     6615         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info65, p-b-code ) .
     6616       end.
     6617       if buf_bar-code.stts = integer('99':U) then do:
     6618         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     6619                                 + "Выполняется удаление бар-кода"
     6620                                 ,vss-include-info65
     6621                                 ,p-b-code
     6622                                 ,chr(10)
     6623                               ) .
     6624       end.
     6625       if buf_bar-code.stts = integer('79':U) then do:
     6626         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     6627                                 + "Бар-код выключен"
     6628                                 ,vss-include-info65
     6629                                 ,p-b-code
     6630                                 ,chr(10)
     6631                               ) .
     6632       end.
     6633       return .
     6634     end.
     6635   end procedure.
     6636   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6637   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     6638   procedure fltopend_fltopend :
     6639   define input parameter p-parent-handle as handle no-undo .
     6640   define input parameter p-qh as handle no-undo .
     6641   define input parameter p-flt-open-open-query  as character no-undo .
     6642   define input parameter p-where-cond as character no-undo .
     6643   define input parameter p-use-indFIRST-query-tail as character no-undo .
     6644   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     6645   define input parameter p-indexed-reposition as character no-undo .
     6646     do
     6647     on error undo, return error
     6648     :
     6649   define variable v-prepare-string as character no-undo .
     6650   define variable glog as logical no-undo .
     6651   assign
     6652   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     6653                      p-where-cond + chr(32)  +
     6654                      p-use-indFIRST-query-tail + chr(32) +
     6655                      p-use-ind-sort-clmn-by + chr(32) +
     6656                      p-indexed-reposition
     6657   .
     6658   assign
     6659   glog = p-qh:query-prepare(v-prepare-string) no-error .
     6660   if not glog
     6661   or error-status:error then do:
     6662     message error-status:get-message(1) view-as alert-box .
     6663     undo, return error .
     6664   end.
     6665   assign
     6666   glog = p-qh:query-open no-error .
     6667   if not glog
     6668   or error-status:error then do:
     6669     message error-status:get-message(1) view-as alert-box .
     6670     undo, return error .
     6671   end.
     6672     end.
     6673   end procedure.
     6674   procedure fltopend_fltfindd :
     6675   define input parameter p-parent-handle as handle no-undo .
     6676   define input parameter p-qh as handle no-undo .
     6677   define input parameter p-rowid as rowid no-undo .
     6678   define input parameter p-next as logical no-undo .
     6679   define input parameter p-lock as integer no-undo .
     6680   define input parameter p-bh as handle no-undo .
     6681   define input parameter p-where-cond as character no-undo .
     6682   define input parameter p-use-index-phrase as character no-undo .
     6683   define variable glog as logical no-undo .
     6684   define variable v-qh as handle no-undo .
     6685   define variable v-bh as handle no-undo .
     6686   define variable v-recid as recid no-undo .
     6687   define variable v-prepare-string as character no-undo .
     6688   do
     6689   on error undo, return error
     6690   on stop undo, return error
     6691   :
     6692     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     6693     create buffer v-bh for table p-bh buffer-name p-bh:name.
     6694     create query v-qh.
     6695     v-qh:set-buffers(v-bh).
     6696     v-prepare-string = substitute("for each &1 &2 &3"
     6697                                     ,v-bh:name
     6698                                     ,p-where-cond
     6699                                     ,p-use-index-phrase).
     6700     glog = v-qh:query-prepare(v-prepare-string) no-error.
     6701     if not glog then do:
     6702       delete object v-qh.
     6703       delete object v-bh.
     6704       undo, return error .
     6705     end.
     6706     glog = v-qh:query-open no-error .
     6707     if not glog then do:
     6708       delete object v-qh.
     6709       delete object v-bh.
     6710       undo, return error .
     6711     end.
     6712     if p-next then do:
     6713       v-qh:reposition-to-rowid(p-rowid) no-error .
     6714       glog = v-qh:get-next( p-lock) no-error .
     6715       glog = v-qh:get-next( p-lock) no-error .
     6716       if not glog or v-qh:query-off-end = yes then do:
     6717         glog = v-qh:get-first( p-lock) no-error .
     6718       end.
     6719     end.
     6720     else do:
     6721       glog = v-qh:get-first( p-lock) no-error .
     6722     end.
     6723     v-recid = v-bh:recid no-error .
     6724     delete object v-qh.
     6725     delete object v-bh.
     6726     return string(v-recid) .
     6727   end.
     6728   end procedure.
     6729   procedure fltopend_fltfindq :
     6730   define input parameter p-parent-handle as handle no-undo .
     6731   define input parameter p-qh as handle no-undo .
     6732   define input parameter p-next as logical no-undo .
     6733   define input parameter p-lock as integer no-undo .
     6734   define input parameter p-flt-open-open-query  as character no-undo .
     6735   define input parameter p-where-cond as character no-undo .
     6736   define input parameter p-use-indFIRST-query-tail as character no-undo .
     6737   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     6738   define input parameter p-indexed-reposition as character no-undo .
     6739   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     6740   define variable glog as logical no-undo .
     6741   define variable v-qh as handle no-undo .
     6742   define variable v-bh as handle no-undo extent 18.
     6743   define variable v-rowid as rowid no-undo extent 18.
     6744   define variable v-ii as integer no-undo .
     6745   define variable v-prepare-string as character no-undo .
     6746   do
     6747   on error undo, return error
     6748   on stop undo, return error
     6749   :
     6750     create query v-qh.
     6751     do v-ii = 1 to p-qh:num-buffers:
     6752       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     6753       assign
     6754       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     6755       no-error.
     6756       v-qh:add-buffer(v-bh[v-ii]).
     6757     end.
     6758     assign
     6759     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     6760                       p-where-cond + chr(32)  +
     6761                       p-use-indFIRST-query-tail + chr(32) +
     6762                       p-use-ind-sort-clmn-by + chr(32) +
     6763                       p-indexed-reposition
     6764     .
     6765     glog = v-qh:query-prepare( v-prepare-string) no-error .
     6766     if not glog then do:
     6767       delete object v-qh.
     6768       do v-ii = 1 to p-qh:num-buffers:
     6769         delete object v-bh[v-ii].
     6770       end.
     6771       undo, return error .
     6772     end.
     6773     glog = v-qh:query-open no-error .
     6774     if not glog then do:
     6775       delete object v-qh.
     6776       do v-ii = 1 to p-qh:num-buffers:
     6777         delete object v-bh[v-ii].
     6778       end.
     6779       undo, return error .
     6780     end.
     6781     if p-next then do:
     6782       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     6783       glog = v-qh:get-next( p-lock) no-error .
     6784       glog = v-qh:get-next( p-lock) no-error .
     6785       if not glog or v-qh:query-off-end = yes then do:
     6786         glog = v-qh:get-first( p-lock) no-error .
     6787       end.
     6788     end.
     6789     else do:
     6790       glog = v-qh:get-first( p-lock) no-error .
     6791     end.
     6792     do v-ii = 1 to p-qh:num-buffers:
     6793       assign
     6794       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     6795       no-error.
     6796     end.
     6797     delete object v-qh.
     6798     do v-ii = 1 to p-qh:num-buffers:
     6799       delete object v-bh[v-ii].
     6800     end.
     6801   end.
     6802   end procedure.
     6803   define buffer l-price-doc-forming-gds for ub.price-doc-forming-gds.
     6804   define variable   rdtaxcdvalue  as character initial ? no-undo.
     6805   define variable   rdtaxcdtype   as character initial ? no-undo.
     6806   define buffer     rt_tax            for ub.tax.
     6807   define variable dor-nal as character no-undo .
     6808   define variable g#log as logical   no-undo .
     6809   define variable gds-rec as recid no-undo .
     6810   define variable rep-rec as recid no-undo .
     6811   define variable ref-rec as recid no-undo .
     6812   define new shared buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     6813   define new shared buffer buf_bar-code   for ub.bar-code.
     6814   define new shared buffer buf_goods      for ub.goods.
     6815   define new shared buffer buf_gds-prt    for ub.gds-prt.
     6816   define new shared QUERY br-alt for buf_price-doc-forming-gds except, buf_bar-code, buf_goods, buf_gds-prt SCROLLING.
     6817   define variable sort-column-name as character no-undo .
     6818   FUNCTION fnc-mark RETURN character (local-bc as integer).
     6819   define buffer local-price-doc-forming-gds for ub.price-doc-forming-gds.
     6820     find first local-price-doc-forming-gds no-lock where
     6821                local-price-doc-forming-gds.b-code     = local-bc and
     6822                local-price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
     6823                local-price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
     6824                local-price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
     6825                local-price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
     6826                no-error.
     6827     if not available local-price-doc-forming-gds then  return (?).
     6828     if lookup (string (recid (local-price-doc-forming-gds)), mark-list) > 0 then
     6829       return "*".
     6830     else
     6831       return "".
     6832   END FUNCTION.
     6833   FUNCTION fnc-main-code RETURN integer (local-bc as integer).
     6834   define variable local-main-code like ub.bar-code.b-code no-undo.
     6835      run prc-main-code (input local-bc, output local-main-code).
     6836   return (local-main-code).
     6837   END FUNCTION.
     6838   FUNCTION fnc-base-code RETURN integer (local-bc as integer).
     6839   define variable local-base-code like ub.bar-code.b-code no-undo.
     6840   run prc-base-code (input local-bc, output local-base-code).
     6841   return (local-base-code).
     6842   END FUNCTION.
     6843   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6844   procedure doc-code:
     6845   define input  parameter parmode          as   character           no-undo.
     6846   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     6847   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     6848   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     6849   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     6850   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     6851   define variable vardb-remote     as   logical             no-undo.
     6852   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     6853   define variable v-delimiter as character no-undo .
     6854   do
     6855   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     6856   :
     6857   find first buf_sys-ctrl no-lock .
     6858   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     6859     CASE parmode:
     6860       when "main":u then do:
     6861         if vardb-remote then do:
     6862           assign
     6863             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     6864         end.
     6865         else do:
     6866           assign
     6867             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     6868         end.
     6869       end.
     6870       when "trio" then do:
     6871         assign
     6872           pardoc-code = replace (parroot-doc-code, "=", "*").
     6873       end.
     6874       otherwise do:
     6875         assign
     6876         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     6877         no-error
     6878         .
     6879         if error-status:error  then do:
     6880           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     6881                                         ,chr(10)
     6882                                         ,parmode
     6883                                         ).
     6884         end.
     6885         if num-entries(parmode) = 1
     6886         and parmode <> "chip":U
     6887         and parmode <> "chip_s":U
     6888         then do:
     6889           assign
     6890           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     6891         end.
     6892         else if (lookup("chip":U, parmode) > 0
     6893                  or
     6894                  lookup("chip_s":U, parmode) > 0) then do:
     6895           assign
     6896             vartemp-doc-code = parroot-doc-code.
     6897           do while true:
     6898             if index (vartemp-doc-code , ".") = 0 then
     6899               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     6900             else
     6901               vartemp-doc-code  =
     6902               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     6903               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     6904               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     6905             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     6906           end.
     6907           assign
     6908             pardoc-code = vartemp-doc-code.
     6909         end.
     6910       end.
     6911     end CASE.
     6912     if pardoc-code = '':U
     6913     or (parroot-doc-code <> '':U
     6914     and pardoc-code = parroot-doc-code) then do:
     6915       undo, return error substitute("Ошибка при генерации номера документа&1"
     6916                                     ,chr(10)).
     6917     end.
     6918   end.
     6919   end. // procedure/method
     6920   function get-doc-code-int64 returns int64
     6921     ( input p-doc-code as character ) :
     6922     define variable v-ind              as integer   no-undo .
     6923     define variable v-num-entries      as integer   no-undo .
     6924     define variable v-doc-code-int64   as int64     no-undo .
     6925     define variable v-canonic-doc-code as character no-undo .
     6926     assign
     6927       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     6928       v-canonic-doc-code = p-doc-code
     6929     .
     6930     do v-ind = 1 to v-num-entries
     6931     :
     6932       assign
     6933         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     6934       .
     6935     end.
     6936     assign
     6937       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     6938     .
     6939     return v-doc-code-int64 .
     6940   end. // function/method
