     4574   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4576   (  input  p-b-code
     4577    , input  x_obj-group.obj-type
     4578    , input  x_obj-group.obj-code
     4579    , output vd
     4580    , output v-PriceWithVat
     4581    , output v-prod-vat
     4582    , output v-str1
     4583    , output v-str1
     4584           ) no-error .
     4585         if error-status :error then
     4586         message
     4587           vss-workfile vss-revision vss-description skip
     4588           error-status :get-message(1) skip
     4589           return-value skip
     4590           "proprice.i"
     4591           view-as alert-box error
     4592         .
     4593         if vd = 0 or vd = ?  then do:
     4594           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4595                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4596                   "- расчет по производителю от последней приходной накладной невозможен."
     4597                   view-as alert-box  .
     4598         end.
     4599         else do:
     4600             cost-rubl = vd .
     4601             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4602             p-new-calc-method = p-calc-method .
     4603         end.
     4604       end.
     4605      when 'Спецификация':U
     4606      then do:
     4607         find first x_obj-group.
     4608         assign
     4609           v-num-specif    = 0
     4610           v-contract-code = 0
     4611         .
     4612         for each buf_contract no-lock
     4613         where buf_contract.host-code = v-cntxt-host-code-obj
     4614         :
     4615   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4616   ASSIGN
     4617      i-gl-Host-Code      = 0
     4618      i-gl-Contract-Code  = 0
     4619      i-gl-Extent3        = 0
     4620      .
     4621   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4622       INPUT  v-cntxt-host-code-obj,
     4623       INPUT  buf_contract.contract-code,
     4624       OUTPUT i-gl-Extent3
     4625      ).
     4626   IF i-gl-Extent3[1] = 2 THEN DO:
     4627      ASSIGN
     4628         i-gl-Host-Code      = i-gl-Extent3[2]
     4629         i-gl-Contract-Code  = i-gl-Extent3[3]
     4630         .
     4631   END. ELSE DO:
     4632      ASSIGN
     4633         i-gl-Host-Code      = v-cntxt-host-code-obj
     4634         i-gl-Contract-Code  = buf_contract.contract-code
     4635         .
     4636   END.
     4637   FOR EACH
     4638       buf_contract-specif
     4639        NO-LOCK
     4640        WHERE
     4641            buf_contract-specif.Host-code    = i-gl-Host-Code
     4642        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4643              :
     4644               if buf_contract-specif.gds-code = p-gds-code then do:
     4645                 assign
     4646                   v-num-specif = v-num-specif + 1
     4647                   v-contract-code = buf_contract.contract-code
     4648                 .
     4649               end.
     4650           end.
     4651         end.
     4652         if v-num-specif > 1 then do:
     4653            run str/gds-cnts.w
     4654               (input parparentproc
     4655               ,input p-gds-code
     4656               , "b-sel":U
     4657               ,output v-spis
     4658             ) no-error.
     4659           find first buf_contract-specif no-lock
     4660           where recid(buf_contract-specif) = integer(v-spis)
     4661             no-error.
     4662             if available buf_contract-specif then do:
     4663                 run read-bonus (
     4664                     input  buf_contract-specif.contract-num  ,
     4665                     input  buf_contract-specif.host-code     ,
     4666                     input  buf_contract-specif.gds-code      ,
     4667                     output v-bonus  ) .
     4668                 assign
     4669                   cost-rubl = buf_contract-specif.price-cli
     4670                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4671                   p-new-calc-method = 'Спецификация':U
     4672                 .
     4673                 if v-bonus <> ? and v-bonus <> 0 then do:
     4674                    assign
     4675                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4676                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4677                    .
     4678                 end.
     4679             end.
     4680             else do:
     4681               message "Не найдена спецификация с recid " v-spis skip
     4682                       "для товара с артикулом " p-artic skip
     4683                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4684                       view-as alert-box information .
     4685             end.
     4686         end.
     4687         if v-num-specif = 0 then do:
     4688             message "Не найдена ни одна спецификация" skip
     4689                     "для товара с артикулом " p-artic skip
     4690                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4691                     view-as alert-box information .
     4692         end.
     4693         if v-num-specif = 1 then do:
     4694   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4695   ASSIGN
     4696      i-gl-Host-Code      = 0
     4697      i-gl-Contract-Code  = 0
     4698      i-gl-Extent3        = 0
     4699      .
     4700   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4701       INPUT  v-cntxt-host-code-obj,
     4702       INPUT  v-contract-code,
     4703       OUTPUT i-gl-Extent3
     4704      ).
     4705   IF i-gl-Extent3[1] = 2 THEN DO:
     4706      ASSIGN
     4707         i-gl-Host-Code      = i-gl-Extent3[2]
     4708         i-gl-Contract-Code  = i-gl-Extent3[3]
     4709         .
     4710   END. ELSE DO:
     4711      ASSIGN
     4712         i-gl-Host-Code      = v-cntxt-host-code-obj
     4713         i-gl-Contract-Code  = v-contract-code
     4714         .
     4715   END.
     4716   FOR EACH
     4717       buf_contract-specif
     4718        NO-LOCK
     4719        WHERE
     4720            buf_contract-specif.Host-code    = i-gl-Host-Code
     4721        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4722               :
     4723               if buf_contract-specif.gds-code = p-gds-code then do:
     4724                 run read-bonus (
     4725                     input  buf_contract-specif.contract-num  ,
     4726                     input  buf_contract-specif.host-code     ,
     4727                     input  buf_contract-specif.gds-code      ,
     4728                     output v-bonus  ) .
     4729                 assign
     4730                   cost-rubl = buf_contract-specif.price-cli
     4731                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4732                   p-new-calc-method = 'Спецификация':U
     4733                 .
     4734                 if v-bonus <> ? and v-bonus <> 0 then do:
     4735                    assign
     4736                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4737                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4738                    .
     4739                 end.
     4740               end.
     4741             end.
     4742         end.
     4743      end.
     4744      otherwise do:
     4745        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     4746                  p-new-calc-method  skip
     4747                 "p-price-prev-doc " p-price-prev-doc  skip
     4748                 "mpl-lib ERR !!! " skip
     4749                 'артикул ' p-artic skip
     4750                 view-as alert-box information .
     4751      end.
     4752    end case.
     4753   run main-road-taxs in this-procedure
     4754     ( input p-artic     ,
     4755       input p-prod-type ,
     4756       input p-prod-code ,
     4757       input-output cur-rt-base ,
     4758       input-output cur-rt-rubl )
     4759       .
     4760     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     4761       return error "Не определен курс валюты документа" .
     4762     end.
     4763     if p-base-scale = 0  or  p-base-scale = ?  then do:
     4764        return error "Не определен курс базовой валюты " .
     4765     end.
     4766   if v-base = false then var-pr-r-b = "rubl":U .
     4767                     else var-pr-r-b =  "base":U .
     4768       if var-pr-r-b = "rubl":U then do:
     4769            case p-calc-method :
     4770            when 'ПорогПр-НДС':U then do:
     4771               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     4772            end.
     4773            when 'ПорогПр+НДС':U then do:
     4774               p-price-sale-rubl  =  cost-rubl .
     4775            end.
     4776            when  'Производит':U then do:
     4777               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     4778            end.
     4779            when  'Произв-НДС':U then do:
     4780               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     4781            end.
     4782            otherwise do:
     4783               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     4784            end.
     4785           end case.
     4786           assign
     4787             p-price-calc-rubl  =  cost-rubl
     4788             p-road-tax-rubl    =  cur-rt-rubl
     4789             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4790             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4791             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4792           .
     4793       end.
     4794       else do:
     4795            case p-calc-method:
     4796               when 'ПорогПр-НДС':U then do:
     4797                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     4798               end.
     4799               when 'ПорогПр+НДС':U then do:
     4800                   p-price-sale-base  =  cost-base .
     4801               end.
     4802               when 'Производит':U then do:
     4803                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     4804               end.
     4805               when 'Произв-НДС':U then do:
     4806                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     4807               end.
     4808               otherwise do:
     4809                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4810               end.
     4811            end case.
     4812           assign
     4813             p-price-calc-base  =  cost-base
     4814             p-road-tax-base    =  cur-rt-base
     4815             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4816             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4817             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4818             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4819             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4820             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4821           .
     4822       end.
     4823      if p-price-sale-doc <> 0 then do:
     4824   case p-round-method :
     4825     when '9-окончание':U then do:
     4826       if p-price-sale-doc < 29 then do:
     4827         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4828           assign
     4829             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4830           .
     4831         end.
     4832       end.
     4833       else do:
     4834         if (p-price-sale-doc modulo 10) < 3 then do:
     4835           assign
     4836             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4837                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4838                   - 1 ) * 10
     4839                 + 9
     4840           .
     4841         end.
     4842         else do:
     4843           assign
     4844             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4845                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4846                   ) * 10
     4847                 + 9
     4848           .
     4849         end.
     4850         assign
     4851           p-price-sale-doc = round (p-price-sale-doc, 0)
     4852         .
     4853       end.
     4854     end.
     4855     when '9-99окончание':U then do:
     4856       if p-price-sale-doc < p-round-base then do:
     4857         assign
     4858           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4859         .
     4860       end.
     4861       else do:
     4862         assign
     4863           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4864         .
     4865       end.
     4866     end.
     4867     when 'Без-дробных':U then do:
     4868       assign
     4869         p-price-sale-doc = round (p-price-sale-doc, 0)
     4870       .
     4871     end.
     4872     when 'Произвольно':U then do:
     4873       if p-round-base <> 0 then do:
     4874         assign
     4875           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4876         .
     4877         if p-price-sale-doc = 0 then do:
     4878           assign
     4879             p-price-sale-doc = p-round-base
     4880           .
     4881         end.
     4882       end.
     4883     end.
     4884     when 'Вверх':U then do:
     4885       if p-round-base <> 0 then do:
     4886         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4887           assign
     4888             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4889           .
     4890         end.
     4891       end.
     4892       if p-price-sale-doc = 0 then do:
     4893         assign
     4894           p-price-sale-doc = p-round-base
     4895         .
     4896       end.
     4897     end.
     4898     when 'Коэффициент':U then do:
     4899       if p-round-base <> 0 then do:
     4900         assign
     4901           p-price-sale-doc = p-price-sale-doc * p-round-base
     4902         .
     4903       end.
     4904     end.
     4905     when 'Отключено':U then do:
     4906     end.
     4907     otherwise do:
     4908       message
     4909         vss-workfile vss-revision vss-description skip
     4910         "Неизвестный метод округления продажной цены" skip
     4911         "round-method" p-round-method skip
     4912         "round-base"   p-round-base   skip
     4913         "price"        p-price-sale-doc             skip
     4914         view-as alert-box error .
     4915     end.
     4916   end.
     4917     end.
     4918     assign
     4919       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     4920       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     4921       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     4922       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     4923      .
     4924     assign
     4925       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     4926       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     4927       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     4928       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     4929     .
     4930     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4931     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4932     p-prev-doc-code = if available bufold_price-doc-forming
     4933                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4934                          else "" .
     4935   END PROCEDURE.
     4936   PROCEDURE create-line :
     4937   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     4938   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     4939   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     4940   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     4941   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     4942   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     4943   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     4944   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     4945   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     4946   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     4947   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     4948   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     4949   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     4950   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     4951   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     4952   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     4953   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     4954   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     4955   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     4956   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     4957   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     4958   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     4959   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     4960   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     4961   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     4962   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     4963   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     4964   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     4965   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     4966   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     4967   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     4968   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     4969   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     4970   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     4971   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     4972   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     4973   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     4974   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     4975   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     4976   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     4977   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     4978   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     4979   define input  parameter p-prev-doc-code     as character no-undo .
     4980   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     4981   define input-output parameter  v-sec        as integer   no-undo .
     4982     run check-use-bar-code ( p-b-code ) no-error .
     4983     if error-status :error then do:
     4984       message
     4985         return-value skip
     4986         "Ошибка !"
     4987         view-as alert-box error
     4988       .
     4989       undo, return error return-value.
     4990     end.
     4991   find first ub.price-doc-forming-gds exclusive-lock where
     4992              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     4993              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     4994              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     4995              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     4996              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     4997       if not available ub.price-doc-forming-gds then
     4998       do:
     4999         create ub.price-doc-forming-gds .
     5000          assign
     5001           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     5002           ub.price-doc-forming-gds.plt-id     = p-plt-id
     5003           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     5004           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     5005           ub.price-doc-forming-gds.b-code     = p-b-code
     5006           ub.price-doc-forming-gds.line-num   = p-line-num
     5007          .
     5008       end.
     5009     assign
     5010       ub.price-doc-forming-gds.artic            = p-artic
     5011       ub.price-doc-forming-gds.prod-type        = p-prod-type
     5012       ub.price-doc-forming-gds.prod-code        = p-prod-code
     5013       ub.price-doc-forming-gds.calc-method      = p-calc-method
     5014       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     5015       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     5016       ub.price-doc-forming-gds.start-date       = p-start-date
     5017       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     5018       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     5019       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     5020       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     5021       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     5022       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     5023       ub.price-doc-forming-gds.end-date         = p-end-date
     5024       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     5025       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     5026       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     5027       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     5028       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     5029       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     5030       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     5031       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     5032       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     5033       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     5034       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     5035       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     5036       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     5037       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     5038       ub.price-doc-forming-gds.excise-base      = p-excise-base
     5039       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     5040       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     5041       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     5042       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     5043       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     5044       ub.price-doc-forming-gds.stts             = p-stts
     5045       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     5046       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     5047       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     5048       .
     5049     run ref/h-pdfgds.p
     5050       ( buffer ub.price-doc-forming-gds ,
     5051         input p-price-sale-doc ,
     5052         input-output v-sec
     5053         ) .
     5054   END PROCEDURE.
     5055   PROCEDURE last-num :
     5056   define input  parameter p-recid as recid no-undo .
     5057   define output parameter p-last-id as integer   no-undo .
     5058   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     5059   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5060   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     5061         if error-status :error then do:
     5062           p-last-id = ? .
     5063           return .
     5064         end.
     5065       for each buf2_price-doc-forming-gds no-lock  where
     5066               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     5067               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     5068               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     5069               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     5070               by buf2_price-doc-forming-gds.line-num
     5071               :
     5072               p-last-id = buf2_price-doc-forming-gds.line-num .
     5073       end.
     5074   END PROCEDURE.
     5075   PROCEDURE calc-price-alt :
     5076   define input parameter bc         like ub.bar-code.b-code   no-undo.
     5077   define input parameter p-recid as recid no-undo .
     5078   define input parameter d-pcnt as decimal   no-undo .
     5079   define input parameter r-method   as character no-undo .
     5080   define input parameter r-base     as decimal   no-undo .
     5081   define output parameter pa-price-sale-base  as decimal   no-undo .
     5082   define output parameter pa-price-sale-doc   as decimal   no-undo .
     5083   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     5084   pr-alt:
     5085   do on error undo pr-alt, return error:
     5086     if r-method = ? or
     5087        r-base = ? then do:
     5088       message
     5089         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     5090         "Код:" bc skip
     5091         view-as alert-box error.
     5092       undo pr-alt, return error.
     5093     end.
     5094   define buffer buf_bar-code for ub.bar-code  .
     5095   define buffer buf_main_bar-code for ub.bar-code  .
     5096   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     5097   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5098   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     5099   if error-status :error then
     5100   message
     5101     vss-workfile vss-revision vss-description skip
     5102     error-status :get-message(1) skip
     5103     return-value skip
     5104     "Ошибка "
     5105     view-as alert-box error
     5106   .
     5107   find first buf_bar-code no-lock where
     5108              buf_bar-code.b-code = bc no-error .
     5109   if error-status :error then
     5110   message
     5111     vss-workfile vss-revision vss-description skip
     5112     error-status :get-message(1) skip
     5113     return-value skip
     5114     "3"
     5115     view-as alert-box error
     5116   .
     5117         assign
     5118           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     5119                               buf_bar-code.cli-base-rate *
     5120                               (1 - d-pcnt / 100)
     5121                                 .
     5122     if pa-price-sale-doc <> 0 then do:
     5123   case r-method :
     5124     when '9-окончание':U then do:
     5125       if pa-price-sale-doc < 29 then do:
     5126         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     5127           assign
     5128             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     5129           .
     5130         end.
     5131       end.
     5132       else do:
     5133         if (pa-price-sale-doc modulo 10) < 3 then do:
     5134           assign
     5135             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5136                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5137                   - 1 ) * 10
     5138                 + 9
     5139           .
     5140         end.
     5141         else do:
     5142           assign
     5143             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5144                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5145                   ) * 10
     5146                 + 9
     5147           .
     5148         end.
     5149         assign
     5150           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5151         .
     5152       end.
     5153     end.
     5154     when '9-99окончание':U then do:
     5155       if pa-price-sale-doc < r-base then do:
     5156         assign
     5157           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     5158         .
     5159       end.
     5160       else do:
     5161         assign
     5162           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     5163         .
     5164       end.
     5165     end.
     5166     when 'Без-дробных':U then do:
     5167       assign
     5168         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5169       .
     5170     end.
     5171     when 'Произвольно':U then do:
     5172       if r-base <> 0 then do:
     5173         assign
     5174           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     5175         .
     5176         if pa-price-sale-doc = 0 then do:
     5177           assign
     5178             pa-price-sale-doc = r-base
     5179           .
     5180         end.
     5181       end.
     5182     end.
     5183     when 'Вверх':U then do:
     5184       if r-base <> 0 then do:
     5185         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5186           assign
     5187             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5188           .
     5189         end.
     5190       end.
     5191       if pa-price-sale-doc = 0 then do:
     5192         assign
     5193           pa-price-sale-doc = r-base
     5194         .
     5195       end.
     5196     end.
     5197     when 'Коэффициент':U then do:
     5198       if r-base <> 0 then do:
     5199         assign
     5200           pa-price-sale-doc = pa-price-sale-doc * r-base
     5201         .
     5202       end.
     5203     end.
     5204     when 'Отключено':U then do:
     5205     end.
     5206     otherwise do:
     5207       message
     5208         vss-workfile vss-revision vss-description skip
     5209         "Неизвестный метод округления продажной цены" skip
     5210         "round-method" r-method skip
     5211         "round-base"   r-base   skip
     5212         "price"        pa-price-sale-doc             skip
     5213         view-as alert-box error .
     5214     end.
     5215   end.
     5216     end.
     5217     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5218     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5219   end.
     5220   END PROCEDURE.
     5221   procedure calc-price-discnt :
     5222     do
     5223     on error undo, return error return-value
     5224     :
     5225   define input parameter p-recid as recid no-undo .
     5226   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5227   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5228   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5229   define buffer buf-bar-code                      for ub.bar-code.
     5230   define buffer buf-goods                         for ub.goods.
     5231   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5232   define variable pr-rec   as   recid                     no-undo.
     5233   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5234   pr-discnt:
     5235   do on error undo pr-discnt, return error:
     5236     find  buf-price-doc-forming no-lock where
     5237           recid(buf-price-doc-forming) = p-recid .
     5238     find  buf-bar-code no-lock where
     5239           buf-bar-code.b-code = bc.
     5240     find  buf-goods no-lock where
     5241           buf-goods.gds-code = buf-bar-code.gds-code.
     5242     find  buf-price-doc-forming-gds exclusive-lock where
     5243           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5244           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5245           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5246           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5247           buf-price-doc-forming-gds.b-code  = bc.
     5248      if available buf-price-doc-forming-gds then do:
     5249         buf-price-doc-forming-gds.d-pcnt =
     5250         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5251               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5252               buf-bar-code.cli-base-rate) * 100 .
     5253      end.
     5254   end.
     5255     end.
     5256   end procedure.
     5257   procedure calc-price-sub :
     5258   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5259   define  input  parameter p-recid      as recid no-undo .
     5260   define  input  parameter calc-method  as character         no-undo.
     5261   define  input  parameter increase-pc  as decimal           no-undo.
     5262   define  input  parameter round-method as character         no-undo.
     5263   define  input  parameter round-base   as decimal           no-undo.
     5264   define  input  parameter doc-code     as character no-undo .
     5265   define  input  parameter common-price as decimal   no-undo .
     5266   define  input  parameter copy-type    as character no-undo .
     5267   define  input  parameter copy-code    as integer   no-undo .
     5268   define  output parameter calc-rec     as recid             no-undo.
     5269   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5270   define  buffer buf-bar-code              for ub.bar-code.
     5271   define  buffer buf-goods                 for ub.goods.
     5272   define  buffer buf-gds-prt               for ub.gds-prt.
     5273   define  buffer buf-gds-grp               for ub.gds-grp.
     5274   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5275   calc-sub:
     5276   do on error undo calc-sub, return error:
     5277     find  buf-price-doc-forming no-lock where
     5278           recid (buf-price-doc-forming) =  p-recid .
     5279     find  buf-bar-code no-lock where
     5280           buf-bar-code.b-code = bc.
     5281     find  buf-goods no-lock where
     5282           buf-goods.gds-code = buf-bar-code.gds-code.
     5283     find  buf-gds-prt no-lock where
     5284           buf-gds-prt.node-code = buf-bar-code.node-code.
     5285     find  buf-price-doc-forming-gds where
     5286           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5287           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5288           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5289           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5290           buf-price-doc-forming-gds.b-code      = bc no-error .
     5291     calc-rec = recid (buf-price-doc-forming-gds).
     5292     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5293       for each  buf-price-doc-forming-gds exclusive-lock where
     5294                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5295                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5296                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5297                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5298                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5299                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5300                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5301           first buf-bar-code no-lock where
     5302                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5303                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5304           first buf-gds-prt no-lock where
     5305                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5306                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5307           on error undo calc-sub, return error:
     5308             run calc-price-line  in this-procedure
     5309               ( input  calc-method
     5310               , input  increase-pc
     5311               , input  round-method
     5312               , input  round-base
     5313               , input  buf-bar-code.b-code
     5314               , input  buf-goods.gds-code
     5315               , input  buf-goods.artic
     5316               , input  buf-goods.prod-type
     5317               , input  buf-goods.prod-code
     5318               , input  buf-price-doc-forming.base-rate
     5319               , input  buf-price-doc-forming.base-scale
     5320               , input  buf-price-doc-forming.exch-scale
     5321               , input  buf-price-doc-forming.exch-rate
     5322               , input  doc-code
     5323               , input  common-price
     5324               , input  copy-type
     5325               , input  copy-code
     5326               , output buf-price-doc-forming-gds.calc-method
     5327               , output buf-price-doc-forming-gds.price-calc-base
     5328               , output buf-price-doc-forming-gds.price-calc-doc
     5329               , output buf-price-doc-forming-gds.price-calc-rubl
     5330               , output buf-price-doc-forming-gds.price-prev-base
     5331               , output buf-price-doc-forming-gds.price-prev-doc
     5332               , output buf-price-doc-forming-gds.price-prev-rubl
     5333               , output buf-price-doc-forming-gds.price-sale-base
     5334               , output buf-price-doc-forming-gds.price-sale-doc
     5335               , output buf-price-doc-forming-gds.price-sale-rubl
     5336               , output buf-price-doc-forming-gds.road-tax-base
     5337               , output buf-price-doc-forming-gds.road-tax-doc
     5338               , output buf-price-doc-forming-gds.road-tax-rubl
     5339               , output buf-price-doc-forming-gds.excise-base
     5340               , output buf-price-doc-forming-gds.excise-doc
     5341               , output buf-price-doc-forming-gds.excise-rubl
     5342               , output buf-price-doc-forming-gds.vat-pc
     5343               , output buf-price-doc-forming-gds.slt-pc
     5344               , output buf-price-doc-forming-gds.prev-doc-code
     5345               , output buf-price-doc-forming-gds.d-pcnt
     5346               ) no-error .
     5347             if error-status :error then do :
     5348               message
     5349                 vss-workfile vss-revision vss-description skip
     5350                 error-status :get-message(1) skip
     5351                 return-value skip
     5352                 "calc-price-line"
     5353                 view-as alert-box error
     5354               .
     5355               undo calc-sub, return error.
     5356               end.
     5357         calc-rec = recid (buf-price-doc-forming-gds).
     5358       end.
     5359       for each  buf-price-doc-forming-gds exclusive-lock where
     5360                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5361                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5362                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5363                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5364                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5365                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5366                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5367           first buf-bar-code no-lock where
     5368                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     5369                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     5370           first buf-gds-prt no-lock where
     5371                 buf-gds-prt.node-code = buf-bar-code.node-code
     5372           on error undo calc-sub, return error:
     5373       end.
     5374     end.
     5375     else do:
     5376     end.
     5377   end.
     5378   end procedure.
     5379   procedure calc-base-update :
     5380   define input parameter bc           like ub.bar-code.b-code   no-undo.
     5381   define input parameter p-recid      as recid no-undo .
     5382   define input parameter round-method as character    no-undo.
     5383   define input parameter round-base   as decimal      no-undo.
     5384   define buffer alt-bar-code              for ub.bar-code.
     5385   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     5386   define buffer buf-bar-code              for ub.bar-code.
     5387   define buffer buf-goods                 for ub.goods.
     5388   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     5389   calc-base:
     5390   do on error undo calc-base, return error :
     5391     find  buf-price-doc-forming no-lock where
     5392           recid (buf-price-doc-forming) =  p-recid .
     5393     find  buf-bar-code no-lock where
     5394           buf-bar-code.b-code = bc.
     5395     find  buf-goods no-lock where
     5396           buf-goods.gds-code = buf-bar-code.gds-code.
     5397     for each  alt-bar-code no-lock where
     5398               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     5399               alt-bar-code.node-code = buf-bar-code.node-code and
     5400               alt-bar-code.part-code = buf-bar-code.part-code and
     5401               alt-bar-code.in-code   = buf-bar-code.in-code and
     5402               alt-bar-code.unit-cli <> buf-goods.unit-base,
     5403         each  alt-price-doc-forming-gds exclusive-lock where
     5404               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     5405               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     5406               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     5407               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5408               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     5409         on error undo calc-base, return error:
     5410     run calc-price-alt in this-procedure
     5411         ( input  alt-price-doc-forming-gds.b-code
     5412         , input  p-recid
     5413         , input  alt-price-doc-forming-gds.d-pcnt
     5414         , input  round-method
     5415         , input  round-base
     5416         , output alt-price-doc-forming-gds.price-sale-base
     5417         , output alt-price-doc-forming-gds.price-sale-doc
     5418         , output alt-price-doc-forming-gds.price-sale-rubl
     5419         ) no-error .
     5420       if error-status:error then do:
     5421       message
     5422         vss-workfile vss-revision vss-description skip
     5423         error-status :get-message(1) skip
     5424         return-value skip
     5425         "calc-price-alt"
     5426         view-as alert-box error
     5427       .
     5428         undo calc-base, return error.
     5429       end.
     5430     end.
     5431   end.
     5432   end procedure.
     5433   define temp-table temp-exp-partbc no-undo
     5434   field b-code  as integer
     5435   index pi b-code
     5436   .
     5437   procedure expose-prt :
     5438   define input  parameter p-calc-method  as character no-undo .
     5439   define input  parameter p-increase-pc as decimal   no-undo .
     5440   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     5441   define input  parameter old-recid      as recid no-undo .
     5442   define input  parameter new-recid      as recid no-undo .
     5443   define input  parameter p-round-method as character no-undo .
     5444   define input  parameter p-round-base   as decimal   no-undo .
     5445   define input  parameter v-doc-code     as character no-undo .
     5446   define input  parameter v-common-price as decimal   no-undo .
     5447   define input  parameter v-copy-type    as character no-undo .
     5448   define input  parameter v-copy-code    as integer   no-undo .
     5449   define input-output parameter v-line-num as integer   no-undo .
     5450   define input-output parameter v-sec      as integer   no-undo .
     5451   define output parameter new-rec-str      as recid   no-undo.
     5452   define buffer buf-bar-code              for ub.bar-code.
     5453   define buffer buf-goods                 for ub.goods.
     5454   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5455   define buffer buf-price-list            for ub.price-doc-forming-gds.
     5456   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     5457   define buffer new-price-doc-forming     for ub.price-doc-forming.
     5458   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     5459   define buffer buf-gds-prt               for ub.gds-prt  .
     5460   define buffer buf_parts for ub.parts  .
     5461   define buffer buf_goods for ub.goods  .
     5462     do
     5463     on error undo, return error return-value
     5464     :
     5465     find  buf-price-doc-forming no-lock where
     5466           recid(buf-price-doc-forming) = old-recid .
     5467     find  new-price-doc-forming no-lock where
     5468           recid(new-price-doc-forming) = new-recid .
     5469     find  buf-bar-code no-lock where
     5470           buf-bar-code.b-code = p-main-code.
     5471     find  buf-goods no-lock where
     5472           buf-goods.gds-code = buf-bar-code.gds-code.
     5473     find  buf-price-doc-forming-gds no-lock  where
     5474           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5475           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5476           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5477           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5478           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     5479     if error-status :error then return .
     5480     find  buf-gds-prt no-lock where
     5481           buf-gds-prt.node-code = buf-bar-code.node-code.
     5482   if par-pr-altex = "yes" and
     5483      par-pr-notls = "yes" then do:
     5484   for each  buf-price-list where
     5485             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5486             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5487             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5488             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5489             buf-price-list.b-code     <> p-main-code and
     5490             buf-price-list.artic       = buf-goods.artic  and
     5491             buf-price-list.prod-type   = buf-goods.prod-type and
     5492             buf-price-list.prod-code   = buf-goods.prod-code
     5493             ,
     5494       first buf-bar-code no-lock where
     5495             buf-bar-code.b-code   = buf-price-list.b-code and
     5496             buf-bar-code.unit-cli <> buf-goods.unit-base:
     5497      run create-calc-bc in this-procedure
     5498          ( input  recid( new-price-doc-forming )
     5499           ,input  p-calc-method
     5500           ,input  p-increase-pc
     5501           ,input  p-round-method
     5502           ,input  p-round-base
     5503           ,input  buf-bar-code.b-code
     5504           ,input  buf-goods.gds-code
     5505           ,input  buf-goods.artic
     5506           ,input  buf-goods.prod-type
     5507           ,input  buf-goods.prod-code
     5508           ,input  new-price-doc-forming.base-rate
     5509           ,input  new-price-doc-forming.base-scale
     5510           ,input  new-price-doc-forming.exch-scale
     5511           ,input  new-price-doc-forming.exch-rate
     5512           ,input  v-doc-code
     5513           ,input  v-common-price
     5514           ,input  v-copy-type
     5515           ,input  v-copy-code
     5516           ,input-output v-line-num
     5517           ,input-output v-sec
     5518         ) no-error .
     5519     if error-status:error then do:
     5520       message
     5521         "Ошибка cre-pr-list."                skip
     5522         "Код:" buf-bar-code.b-code           skip
     5523         error-status :get-message(1)         skip
     5524         return-value                         skip
     5525          "pdf" new-price-doc-forming.pdf-id  skip
     5526         view-as alert-box.
     5527       next.
     5528     end.
     5529   end.
     5530   end.
     5531   if par-pr-sclex = "yes" and
     5532      par-pr-notls = "yes" then do:
     5533   for each  buf-price-list where
     5534             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5535             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5536             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5537             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5538             buf-price-list.b-code     <> p-main-code and
     5539             buf-price-list.artic       = buf-goods.artic  and
     5540             buf-price-list.prod-type   = buf-goods.prod-type and
     5541             buf-price-list.prod-code   = buf-goods.prod-code  ,
     5542       first buf-bar-code no-lock where
     5543             buf-bar-code.b-code   = buf-price-list.b-code and
     5544             buf-bar-code.unit-cli = buf-goods.unit-base and
     5545             buf-bar-code.in-code = ""
     5546             :
     5547      run create-calc-bc in this-procedure
     5548          ( input  recid( new-price-doc-forming )
     5549           ,input  p-calc-method
     5550           ,input  p-increase-pc
     5551           ,input  p-round-method
     5552           ,input  p-round-base
     5553           ,input  buf-bar-code.b-code
     5554           ,input  buf-goods.gds-code
     5555           ,input  buf-goods.artic
     5556           ,input  buf-goods.prod-type
     5557           ,input  buf-goods.prod-code
     5558           ,input  new-price-doc-forming.base-rate
     5559           ,input  new-price-doc-forming.base-scale
     5560           ,input  new-price-doc-forming.exch-scale
     5561           ,input  new-price-doc-forming.exch-rate
     5562           ,input v-doc-code
     5563           ,input v-common-price
     5564           ,input v-copy-type
     5565           ,input v-copy-code
     5566           ,input-output v-line-num
     5567           ,input-output v-sec
     5568         ) no-error .
     5569         if error-status:error then do:
     5570           message
     5571             "Ошибка cre-pr-list.2" skip
     5572             "Код:" buf-bar-code.b-code
     5573             view-as alert-box.
     5574           next.
     5575         end.
     5576       end.
     5577   end.
     5578   if par-pr-parex = "yes" and
     5579      par-pr-notls = "yes" then do:
     5580   define buffer bt_trn-doc  for ub.trn-doc  .
     5581   define buffer bf_parts    for ub.parts  .
     5582   define buffer free_parts  for ub.parts  .
     5583   define buffer buf_gds-obj for ub.gds-obj  .
     5584   find first buf_gds-obj no-lock where
     5585              buf_gds-obj.gds-code = buf-goods.gds-code and
     5586              buf_gds-obj.obj-type = v-cntxt-obj-type   and
     5587              buf_gds-obj.obj-code = v-cntxt-obj-code   and
     5588              buf_gds-obj.cash-parts = true
     5589              no-error .
     5590   if not available buf_gds-obj then return .
     5591    find first bt_trn-doc no-lock where
     5592               bt_trn-doc.doc-code = v-doc-code no-error .
     5593    if v-doc-code <> "" and available bt_trn-doc then do:
     5594    for each temp-exp-partbc :
     5595        delete temp-exp-partbc.
     5596    end.
     5597    for each bf_parts no-lock where
     5598             bf_parts.out-code   = bt_trn-doc.doc-code and
     5599             bf_parts.obj-type   = bt_trn-doc.obj-type and
     5600             bf_parts.obj-code   = bt_trn-doc.obj-code and
     5601             bf_parts.artic      = buf-goods.artic     and
     5602             bf_parts.prod-type  = buf-goods.prod-type and
     5603             bf_parts.prod-code  = buf-goods.prod-code  ,
     5604           first free_parts no-lock where
     5605                 free_parts.in-code   = bf_parts.in-code   and
     5606                 free_parts.part-code = bf_parts.part-code and
     5607                 free_parts.out-code  = 'free-zone':U       and
     5608                 free_parts.rsrv-free = true               and
     5609                 free_parts.status_   = false              and
     5610                 free_parts.obj-type  = bf_parts.obj-type  and
     5611                 free_parts.obj-code  = bf_parts.obj-code  and
     5612                 free_parts.artic     = bf_parts.artic     and
     5613                 free_parts.prod-type = bf_parts.prod-type and
     5614                 free_parts.prod-code = bf_parts.prod-code ,
     5615           first buf-bar-code no-lock where
     5616                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5617                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5618                 buf-bar-code.in-code   = bf_parts.in-code and
     5619                 buf-bar-code.part-code = bf_parts.part-code
     5620                 :
     5621      run create-calc-bc in this-procedure
     5622          ( input  recid( new-price-doc-forming )
     5623           ,input  p-calc-method
     5624           ,input  p-increase-pc
     5625           ,input  p-round-method
     5626           ,input  p-round-base
     5627           ,input  buf-bar-code.b-code
     5628           ,input  buf-goods.gds-code
     5629           ,input  buf-goods.artic
     5630           ,input  buf-goods.prod-type
     5631           ,input  buf-goods.prod-code
     5632           ,input  new-price-doc-forming.base-rate
     5633           ,input  new-price-doc-forming.base-scale
     5634           ,input  new-price-doc-forming.exch-scale
     5635           ,input  new-price-doc-forming.exch-rate
     5636           ,input v-doc-code
     5637           ,input v-common-price
     5638           ,input v-copy-type
     5639           ,input v-copy-code
     5640           ,input-output v-line-num
     5641           ,input-output v-sec
     5642         ) no-error .
     5643         if error-status:error then do:
     5644           message
     5645             "Ошибка cre-pr-list.3-" skip
     5646             "Код:" buf-bar-code.b-code
     5647             view-as alert-box.
     5648           next.
     5649         end.
     5650         create temp-exp-partbc.
     5651         assign
     5652            temp-exp-partbc.b-code = buf-bar-code.b-code
     5653         .
     5654    end.
     5655   end.
     5656   for each  buf-price-list where
     5657             buf-price-list.pdf-id     = buf-price-doc-forming.pdf-id and
     5658             buf-price-list.plt-id     = buf-price-doc-forming.plt-id and
     5659             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5660             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5661             buf-price-list.b-code     <> p-main-code         and
     5662             buf-price-list.artic       = buf-goods.artic     and
     5663             buf-price-list.prod-type   = buf-goods.prod-type and
     5664             buf-price-list.prod-code   = buf-goods.prod-code ,
     5665       first buf-bar-code no-lock where
     5666             buf-bar-code.b-code   = buf-price-list.b-code and
     5667             buf-bar-code.unit-cli = buf-goods.unit-base and
     5668             buf-bar-code.in-code <> "" ,
     5669       first buf_parts no-lock where
     5670             buf_parts.out-code    = 'free-zone':U and
     5671             buf_parts.rsrv-free   = true  and
     5672             buf_parts.status_     = false and
     5673             buf_parts.artic       = buf-goods.artic and
     5674             buf_parts.prod-type   = buf-goods.prod-type and
     5675             buf_parts.prod-code   = buf-goods.prod-code and
     5676             buf_parts.obj-type   = v-cntxt-obj-type and
     5677             buf_parts.obj-code   = v-cntxt-obj-code and
     5678             buf_parts.part-code   = buf-bar-code.part-code and
     5679             buf_parts.in-code     = buf-bar-code.in-code
     5680             :
     5681             find first temp-exp-partbc where
     5682                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5683           if available temp-exp-partbc then next.
     5684      run create-calc-bc in this-procedure
     5685          ( input  recid( new-price-doc-forming )
     5686           ,input  'Старая':U
     5687           ,input  0
     5688           ,input  'Отключено':U
     5689           ,input  0
     5690           ,input  buf-bar-code.b-code
     5691           ,input  buf-goods.gds-code
     5692           ,input  buf-goods.artic
     5693           ,input  buf-goods.prod-type
     5694           ,input  buf-goods.prod-code
     5695           ,input  new-price-doc-forming.base-rate
     5696           ,input  new-price-doc-forming.base-scale
     5697           ,input  new-price-doc-forming.exch-scale
     5698           ,input  new-price-doc-forming.exch-rate
     5699           ,input v-doc-code
     5700           ,input v-common-price
     5701           ,input v-copy-type
     5702           ,input v-copy-code
     5703           ,input-output v-line-num
     5704           ,input-output v-sec
     5705         ) no-error .
     5706         if error-status:error then do:
     5707           message
     5708             "Ошибка cre-pr-list.3" skip
     5709             "Код:" buf-bar-code.b-code
     5710             view-as alert-box.
     5711           next.
     5712         end.
     5713       end.
     5714     for each buf_parts no-lock where
     5715             buf_parts.out-code    = 'free-zone':U and
     5716             buf_parts.rsrv-free   = true  and
     5717             buf_parts.status_     = false and
     5718             buf_parts.artic       = buf-goods.artic and
     5719             buf_parts.prod-type   = buf-goods.prod-type and
     5720             buf_parts.prod-code   = buf-goods.prod-code and
     5721             buf_parts.obj-type    = v-cntxt-obj-type and
     5722             buf_parts.obj-code    = v-cntxt-obj-code and
     5723             buf_parts.part-code   = buf-bar-code.part-code and
     5724             buf_parts.in-code     = buf-bar-code.in-code,
     5725           first buf-bar-code no-lock where
     5726                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5727                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5728                 buf-bar-code.in-code   = buf_parts.in-code and
     5729                 buf-bar-code.part-code = buf_parts.part-code
     5730             :
     5731             find first temp-exp-partbc where
     5732                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5733           if available temp-exp-partbc then next.
     5734             find first new-price-doc-forming-gds where
     5735                        new-price-doc-forming-gds.pdf-id     = new-price-doc-forming.pdf-id and
     5736                        new-price-doc-forming-gds.pdf-db     = new-price-doc-forming.pdf-db and
     5737                        new-price-doc-forming-gds.plt-id     = new-price-doc-forming.plt-id and
     5738                        new-price-doc-forming-gds.plt-db-num = new-price-doc-forming.plt-db-num  and
     5739                        new-price-doc-forming-gds.b-code = buf-bar-code.b-code
     5740                        no-error .
     5741           if available new-price-doc-forming-gds then next.
     5742      run create-calc-bc in this-procedure
     5743          ( input recid( new-price-doc-forming )
     5744           ,input 'Старая':U
     5745           ,input 0
     5746           ,input 'Отключено':U
     5747           ,input 0
     5748           ,input buf-bar-code.b-code
     5749           ,input buf-goods.gds-code
     5750           ,input buf-goods.artic
     5751           ,input buf-goods.prod-type
     5752           ,input buf-goods.prod-code
     5753           ,input new-price-doc-forming.base-rate
     5754           ,input new-price-doc-forming.base-scale
     5755           ,input new-price-doc-forming.exch-scale
     5756           ,input new-price-doc-forming.exch-rate
     5757           ,input v-doc-code
     5758           ,input v-common-price
     5759           ,input v-copy-type
     5760           ,input v-copy-code
     5761           ,input-output v-line-num
     5762           ,input-output v-sec
     5763         ) no-error .
     5764         if error-status:error then do:
     5765           message
     5766             "Ошибка cre-pr-list.4" skip
     5767             "Код:" buf-bar-code.b-code
     5768             view-as alert-box.
     5769           next.
     5770         end.
     5771       end.
     5772   end.
     5773     end.
     5774   end procedure.
     5775   procedure create-calc-bc :
     5776   define input parameter  v-new-recid as recid no-undo .
     5777   define input parameter  p-calc-method  as character no-undo .
     5778   define input parameter  p-increase-pc  as decimal   no-undo .
     5779   define input parameter  round-method as character no-undo .
     5780   define input parameter  round-base   as decimal   no-undo .
     5781   define input parameter  p-b-code     as integer   no-undo .
     5782   define input parameter  p-gds-code   as integer   no-undo .
     5783   define input parameter  p-artic      as character no-undo .
     5784   define input parameter  p-prod-type  as character no-undo .
     5785   define input parameter  p-prod-code  as integer   no-undo .
     5786   define input parameter  v-base-rate  as decimal   no-undo .
     5787   define input parameter  v-base-scale as decimal   no-undo .
     5788   define input parameter  v-exch-scale as decimal   no-undo .
     5789   define input parameter  v-exch-rate  as decimal   no-undo .
     5790   define input parameter  v-doc-code   as character no-undo .
     5791   define input parameter  v-common-price as decimal   no-undo .
     5792   define input parameter  v-copy-type as character no-undo .
     5793   define input parameter  v-copy-code as integer   no-undo .
     5794   define input-output parameter v-line-num as integer   no-undo .
     5795   define input-output parameter v-sec     as integer   no-undo .
     5796   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     5797   define variable v-price-calc-base as decimal   no-undo .
     5798   define variable v-price-calc-doc  as decimal   no-undo .
     5799   define variable v-price-calc-rubl as decimal   no-undo .
     5800   define variable v-price-prev-base as decimal   no-undo .
     5801   define variable v-price-prev-doc  as decimal   no-undo .
     5802   define variable v-price-prev-rubl as decimal   no-undo .
     5803   define variable v-price-sale-base as decimal   no-undo .
     5804   define variable v-price-sale-doc  as decimal   no-undo .
     5805   define variable v-price-sale-rubl as decimal   no-undo .
     5806   define variable v-road-tax-base   as decimal   no-undo .
     5807   define variable v-road-tax-doc    as decimal   no-undo .
     5808   define variable v-road-tax-rubl   as decimal   no-undo .
     5809   define variable v-excise-base     as decimal   no-undo .
     5810   define variable v-excise-doc      as decimal   no-undo .
     5811   define variable v-excise-rubl     as decimal   no-undo .
     5812   define variable v-vat-pc          as decimal   no-undo .
     5813   define variable v-slt-pc          as decimal   no-undo .
     5814   define variable v-prev-doc-code   as character no-undo .
     5815   define variable v-d-pcnt as decimal   no-undo .
     5816     do
     5817     on error undo, return error return-value
     5818     :
     5819     find  buf_price-doc-forming no-lock where
     5820           recid(buf_price-doc-forming) = v-new-recid no-error .
     5821      if error-status :error then return error error-status :get-message(1) .
     5822      v-line-num = v-line-num + 1.
     5823      run calc-price-line  in this-procedure (
     5824        input  p-calc-method
     5825      , input  p-increase-pc
     5826      , input  round-method
     5827      , input  round-base
     5828      , input  p-b-code
     5829      , input  p-gds-code
     5830      , input  p-artic
     5831      , input  p-prod-type
     5832      , input  p-prod-code
     5833      , input  v-base-rate
     5834      , input  v-base-scale
     5835      , input  v-exch-scale
     5836      , input  v-exch-rate
     5837      , input  v-doc-code
     5838      , input  v-common-price
     5839      , input  v-copy-type
     5840      , input  v-copy-code
     5841      , output p-calc-method
     5842      , output v-price-calc-base
     5843      , output v-price-calc-doc
     5844      , output v-price-calc-rubl
     5845      , output v-price-prev-base
     5846      , output v-price-prev-doc
     5847      , output v-price-prev-rubl
     5848      , output v-price-sale-base
