     8594       ,         each buf_bar-code no-lock where              buf_bar-code.b-code    = buf_price-doc-forming-gds.b-code         ,         each buf_goods no-lock where              buf_goods.gds-code = buf_bar-code.gds-code and              buf_goods.unit-base <> buf_bar-code.unit-cli ,         each buf_gds-prt no-lock where              buf_gds-prt.node-code = buf_bar-code.node-code
     8595     .
