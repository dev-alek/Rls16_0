      224             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      225             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      226             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      227             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      228             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      229             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      230             v-cntxp-load-time       = bf-cntxp_store.load-time
      231             v-cntxp-holidays        = bf-cntxp_store.holidays
      232             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      233             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      234             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      235             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      236             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      237             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      238             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      239             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      240             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      241             .
      242         end.
      243         when 'маг':U then do:
      244           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      245           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      246           assign
