     7620       "Тип" self :type  skip
     7621       "Процедура" this-procedure :file-name skip
     7622       view-as alert-box .
     7623   end.
     7624   else do:
     7625     apply "entry":u to self  .
     7626     if focus :handle <> self :handle  then do:
     7627       return no-apply .
     7628     end.
     7629   end.
     7630   if not available buf_price-doc-forming-gds then do:
     7631     message "Неправильно выбрана строка."
     7632             view-as alert-box error.
     7633     return no-apply.
     7634   end.
     7635   assign
     7636     code-rec = recid (buf_price-doc-forming-gds)
     7637     g#log = no
     7638     .
     7639   message "Удалить строку документа?   Вы уверены?"
     7640           view-as alert-box question buttons OK-Cancel update g#log.
     7641   if not g#log then
     7642     return no-apply.
     7643   get next br-alt.
     7644   if available buf_price-doc-forming-gds then
     7645     rep-rec = recid (buf_price-doc-forming-gds).
     7646   else do:
     7647     reposition br-alt to recid code-rec no-error.
     7648     get prev br-alt.
     7649     if available buf_price-doc-forming-gds then
     7650       rep-rec = recid (buf_price-doc-forming-gds).
     7651   end.
     7652   reposition br-alt to recid code-rec no-error.
     7653   find first buf_price-doc-forming-gds exclusive-lock where recid (buf_price-doc-forming-gds) = code-rec .
     7654   delete buf_price-doc-forming-gds.
     7655   code-rec = rep-rec.
     7656   doc-mode = 'ИЗМЕНЕНИЕ':U.
     7657   run open-br.
     7658   END.
     7659   ON value-changed OF round-method IN FRAME d-pr-alt DO:
     7660   assign
     7661     round-method.
     7662   run UI-on.
     7663   END.
     7664   ON LEAVE OF round-base IN FRAME d-pr-alt DO:
     7665   if input frame d-pr-alt round-base = 0 then do:
     7666     if input frame d-pr-alt round-method = 'Произвольно':U then
     7667       message "Такое округление невозможно - деление на 0."
     7668               view-as alert-box error.
     7669     else
     7670       message "Пересчет по нулевому коэффициенту невозможен - получится 0."
     7671               view-as alert-box error.
     7672   end.
     7673   else
     7674     assign
     7675       round-base.
     7676   display  round-base with frame d-pr-alt.
     7677   END.
     7678   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pr-alt:PARENT eq ? THEN
     7679     FRAME d-pr-alt:PARENT = ACTIVE-WINDOW.
     7680   ON WINDOW-CLOSE OF FRAME d-pr-alt APPLY "END-ERROR":U TO SELF.
     7681   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7682   on help of frame d-pr-alt
     7683   do:
     7684     run gbl/app_help.p
     7685       (input this-procedure :file-name
     7686       ,input ''
     7687       ,input ?
     7688       ) no-error.
     7689     if error-status :error then do:
     7690       message
     7691         "Ошибка при вызове помощи"
     7692         error-status :get-message(1)
     7693         view-as alert-box .
     7694     end.
     7695   end.
     7696   run minbtn-set in this-procedure .
     7697   on choose of b-help in frame d-pr-alt
     7698   do:
     7699     apply "help":u to frame d-pr-alt .
     7700   end.
     7701   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7702   procedure minbtn-set :
     7703       do
     7704           on error undo, return error return-value
     7705           :
     7706           define variable ii              as integer       no-undo .
     7707           define variable fh              as widget-handle no-undo .
     7708           define variable hh              as widget-handle no-undo .
     7709           define variable v-h             as handle        extent 4 no-undo .
     7710           define variable v-name-button   as character     no-undo .
     7711           define variable v-help-old-x    as decimal       no-undo .
     7712           define variable v-help-old-y    as decimal       no-undo .
     7713           define variable v-help-old-size as decimal       no-undo .
     7714           define variable v-frame-width   as decimal       no-undo .
     7715           define variable jj              as integer       no-undo .
     7716           do
     7717               on error undo, return error
     7718               :
     7719               assign
     7720                   v-frame-width = frame d-pr-alt:width - 0.3
     7721                   fh            = frame d-pr-alt:first-child
     7722                   hh            = fh:first-child
     7723                   ii            = 1
     7724                   .
     7725               do while valid-handle(hh):
     7726                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7727                   do:
     7728                       case lc(hh:name) :
     7729                           when "b-help" then
     7730                               do:
     7731                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7732                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7733                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7734                                   hh:TOOLTIP = "Помощь" .
     7735                                   v-help-old-x = hh:column .
     7736                                   v-help-old-y = hh:row    .
     7737                                   v-help-old-size = hh:width .
     7738                                   hh:width-chars = 2.5 .
     7739                               end.
     7740                           when "b-print" then
     7741                               do:
     7742                                   hh:load-image("cmp/b-print.bmp":u) .
     7743                                   hh:TOOLTIP = "Печать" .
     7744                                   v-h[ii] = hh:handle .
     7745                                   ii = ii + 1 .
     7746                                   hh:width-chars = 3 .
     7747                               end.
     7748                           when "b-history" or
     7749                           when "b-hist" then
     7750                               do:
     7751                                   hh:load-image("cmp/b-hist.bmp":u) .
     7752                                   hh:TOOLTIP = "История" .
     7753                                   v-h[ii] = hh:handle .
     7754                                   ii = ii + 1 .
     7755                                   hh:width-chars = 3 .
     7756                               end.
     7757                           when "b-sch" then
     7758                               do:
     7759                                   hh:load-image("cmp/b-sch.bmp":u) .
     7760                                   hh:TOOLTIP = "Установка Фильтра" .
     7761                                   v-h[ii] = hh:handle .
     7762                                   ii = ii + 1 .
     7763                                   hh:width-chars = 3 .
     7764                               end.
     7765                           when "b-hist-user" then
     7766                               do:
     7767                                   hh:load-image("cmp/b-hist.bmp":u) .
     7768                                   hh:TOOLTIP = "История пользователя" .
     7769                                   ii = ii + 1 .
     7770                               end.
     7771                       end case.
     7772                   end.
     7773                   hh = hh:next-sibling.
     7774               end.
     7775               b-help:column = v-frame-width - b-help:width-chars.
     7776               jj = 0.
     7777               repeat ii = 4 to 1 by -1 :
     7778                   if valid-handle (v-h[ii] ) then
     7779                   do:
     7780                       jj  = jj + 1 .
     7781                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7782                       v-h[ii]:row    = v-help-old-y .
     7783                   end.
     7784               end.
     7785           end.
     7786       end.
     7787   end procedure.
     7788   MAIN-BLOCK:
     7789   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7790      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     7791     define variable l-par as logical   no-undo .
     7792       run chec-par in this-procedure (
     7793             output l-par
     7794             ,input  v-cntxt-host-code-obj
     7795             ,input  v-cntxt-obj-type
     7796             ,input  v-cntxt-obj-code
     7797           ) no-error .
     7798      run tax-name( input 'rdt':U, output  dor-nal) .
     7799      assign buf_price-doc-forming-gds.road-tax-doc :label  = dor-nal.
     7800     if doc-mode <> 'ПРОСМОТР':U then
     7801       code-rec = ?.
     7802     find first buf_price-doc-forming no-lock where
     7803           recid (buf_price-doc-forming) = p-doc-rec.
     7804     find first buf_base_bar-code no-lock where
     7805                buf_base_bar-code.b-code = p-b-code no-error.
     7806     if available buf_base_bar-code then
     7807       find first buf_base_goods no-lock where
     7808                  buf_base_goods.gds-code = buf_base_bar-code.gds-code.
     7809     case mode:
     7810       when "code" then do:
     7811       end.
     7812       when "scl-gds" then do:
     7813       end.
     7814       when "par-gds" then do:
     7815       end.
     7816       when "scl-doc" then do:
     7817       end.
     7818       when "par-doc" then do:
     7819       end.
     7820       when "doc" then do:
     7821       end.
     7822     end case.
     7823     run UI-on.
     7824     run open-br.
     7825     WAIT-FOR GO OF FRAME d-pr-alt focus br-alt.
     7826   END.
     7827   RUN disable_UI.
     7828   PROCEDURE disable_UI :
     7829     HIDE FRAME d-pr-alt.
     7830   END PROCEDURE.
     7831   PROCEDURE UI-on :
     7832   disable all with frame d-pr-alt.
     7833   hide loc-art loc-name loc-code in frame d-pr-alt.
     7834   loc-art = "".
     7835   enable a-n-c b-exit b-help br-alt with frame d-pr-alt.
     7836   frame d-pr-alt:title = "Список неосновных цен ДНЦ № " + string(buf_price-doc-forming.pdf-id).
     7837   case mode:
     7838     when "code"    then
     7839       frame d-pr-alt:title = frame d-pr-alt:title +
     7840                                   "      Код: " + string (p-b-code, ">>>>>>>>9").
     7841     when "scl-gds" then
     7842       frame d-pr-alt:title = frame d-pr-alt:title +
     7843                                   "      Товар: " + buf_base_goods.artic + "  " + buf_base_goods.gds-name +
     7844                                   "      ПРИЗНАКИ".
     7845     when "par-gds" then
     7846       frame d-pr-alt:title = frame d-pr-alt:title +
     7847                                   "      Товар: " + buf_base_goods.artic + "  " + buf_base_goods.gds-name +
     7848                                   "      ПАРТИИ".
     7849     when "scl-doc" then
     7850       frame d-pr-alt:title = frame d-pr-alt:title +
     7851                                   "      ПРИЗНАКИ по ДНЦ".
     7852     when "par-doc" then
     7853       frame d-pr-alt:title = frame d-pr-alt:title +
     7854                                   "      ПАРТИИ по ДНЦ".
     7855     when "doc"     then
     7856       frame d-pr-alt:title = frame d-pr-alt:title +
     7857                                   "      Все по ДНЦ".
     7858   end.
     7859   frame d-pr-alt:title = frame d-pr-alt:title + "              " +
     7860                               doc-mode.
     7861   if doc-mode = 'ПРОСМОТР':U then do:
     7862     assign
     7863       buf_price-doc-forming-gds.d-pcnt :read-only in browse br-alt = yes buf_price-doc-forming-gds.price-sale-doc :read-only in browse br-alt = yes buf_price-doc-forming-gds.road-tax-doc :read-only in browse br-alt = yes buf_price-doc-forming-gds.excise-doc :read-only in browse br-alt = yes
     7864       .
     7865     hide round-method in frame d-pr-alt.
     7866   end.
     7867   else do:
     7868     assign
     7869       buf_price-doc-forming-gds.d-pcnt :read-only in browse br-alt = no buf_price-doc-forming-gds.price-sale-doc :read-only in browse br-alt = no buf_price-doc-forming-gds.road-tax-doc :read-only in browse br-alt = no buf_price-doc-forming-gds.excise-doc :read-only in browse br-alt = no
     7870       .
     7871     display  round-method round-base with frame d-pr-alt.
     7872     if lookup (mode, "code,scl-gds,par-gds") > 0 then
     7873       enable b-add with frame d-pr-alt.
     7874     enable b-mark b-discnt b-chg b-del round-method with frame d-pr-alt.
     7875     if lookup( input frame d-pr-alt round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
     7876       enable round-base with frame d-pr-alt.
     7877       display  round-base with frame d-pr-alt.
     7878     end.
     7879     else
     7880       hide round-base in frame d-pr-alt.
     7881   end.
     7882   apply "entry" to br-alt in frame d-pr-alt.
     7883   END PROCEDURE.
     7884   PROCEDURE open-br :
     7885   define variable l-query-was-opened as logical no-undo .
     7886   define variable sort-column-phrase as character    no-undo .
     7887   define variable d-num like ub.price-doc-forming.pdf-id  no-undo.
     7888   define variable d-db  like ub.price-doc-forming.pdf-db  no-undo.
     7889   assign
     7890     l-query-was-opened = false
     7891     d-num = buf_price-doc-forming.pdf-id
     7892     d-db = buf_price-doc-forming.pdf-db
     7893     .
     7894   if sort-column-name = "" then
     7895     sort-column-phrase = "".
     7896   else
     7897     sort-column-phrase = "by " + sort-column-name.
     7898   if available buf_price-doc-forming-gds then
     7899     code-rec = recid (buf_price-doc-forming-gds).
     7900   case mode:
     7901     when 'code-old'    then do:
     7902   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7903   define variable  l-disable-where-86  as logical   no-undo .
     7904   define variable  l-filter-open-86    as logical   .
     7905   define variable  flt-rec-86       as recid     no-undo .
     7906   define variable  filter-name-86      as character no-undo .
     7907   define variable  where-phrase-86     as character no-undo .
     7908   define variable  sort-phrase-86      as character no-undo .
     7909   define variable  where-phrase-rus-86 as character no-undo .
     7910   define variable  sort-phrase-rus-86  as character no-undo .
     7911   run gbl/flt-get.p
     7912     (input filter-point
     7913     ,output flt-rec-86
     7914     ,output filter-name-86
     7915     ,output where-phrase-86
     7916     ,output sort-phrase-86
     7917     ,output where-phrase-rus-86
     7918     ,output sort-phrase-rus-86
     7919     ).
     7920     assign
     7921       l-filter-open-86 = false
     7922     .
     7923     if flt-rec-86 <> ?
     7924       or sort-column-phrase > ""
     7925     then do:
     7926       define variable  parameter-2-86 as character no-undo .
     7927       define variable  parameter-3-86 as character no-undo .
     7928       define variable  parameter-4-86 as character no-undo .
     7929       define variable  parameter-5-86 as character no-undo .
     7930       define variable  parameter-6-86 as character no-undo .
     7931       define variable  parameter-7-86 as character no-undo .
     7932         assign
     7933         parameter-3-86 =
     7934                                 "FOR EACH BUF_PRICE-DOC-FORMING-GDS"
     7935         parameter-4-86 =
     7936           (
     7937             if (" buf_price-doc-forming-gds.pdf-id = d-num  and buf_price-doc-forming-gds.pdf-db = d-db  " + " " + where-phrase-86) <> ""
     7938             then  substitute(' buf_price-doc-forming-gds.pdf-id =  &1 and buf_price-doc-forming-gds.pdf-db =  &2 ' , d-num , d-db)  + " " + where-phrase-86
     7939             else "true"
     7940           )
     7941         parameter-5-86 = (" " + "" + " " + substitute(' , each buf_bar-code no-lock where buf_bar-code.b-code = buf_price-doc-forming-gds.b-code                buf_bar-code.gds-code  = &2 and               buf_bar-code.node-code = &3 and               buf_bar-code.in-code   = &1&4&1 and               buf_bar-code.part-code = &1&5&1 ,  ,  each buf_goods no-lock where          buf_goods.gds-code = buf_bar-code.gds-code and          buf_goods.unit-base <> buf_bar-code.unit-cli ,     each buf_gds-prt no-lock where          buf_gds-prt.node-code = buf_bar-code.node-code ', chr(34) ,          buf_base_bar-code.gds-code ,          buf_base_bar-code.node-code ,          buf_base_bar-code.in-code ,           buf_base_bar-code.part-code  ))
     7942         parameter-6-86 = if sort-phrase-86 = ''
     7943                              then
     7944           (
     7945           " " + " " +
     7946             " " + sort-column-phrase +
     7947           " " + " "
     7948           )
     7949                              else
     7950           (
     7951           " " + " " +
     7952             " " + sort-column-phrase +
     7953           " " + sort-phrase-86
     7954           )
     7955         parameter-7-86 =
     7956           "   "
     7957       .
     7958       do
     7959       on stop undo, leave
     7960       on error undo, leave
     7961       :
     7962         assign
     7963           l-disable-where-86 =
     7964             (" buf_price-doc-forming-gds.pdf-id = d-num  and buf_price-doc-forming-gds.pdf-db = d-db  " + " " + where-phrase-86 = "")
     7965         .
     7966         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7967                             ,input query br-alt:handle
     7968                             ,input parameter-3-86
     7969                             ,input parameter-4-86
     7970                             ,input parameter-5-86
     7971                             ,input parameter-6-86
     7972                             ,input parameter-7-86
     7973                             )
     7974         .
     7975         assign
     7976           l-filter-open-86 = true
     7977         .
     7978       end.
     7979       if l-filter-open-86 = false then do:
     7980         message
     7981           "Ошибка при фильтрации / сортировке" skip
     7982           "Будут показаны записи без учета фильтра" skip
     7983           view-as alert-box .
     7984       end.
     7985       else do:
     7986           assign
     7987             l-query-was-opened = true
     7988           .
     7989       end.
     7990     end.
     7991     if l-filter-open-86 = false then do:
     7992       open query br-alt  for each buf_price-doc-forming-gds no-lock
     7993         where  buf_price-doc-forming-gds.pdf-id = d-num  and buf_price-doc-forming-gds.pdf-db = d-db
     7994       ,         each buf_bar-code no-lock  where               buf_bar-code.b-code    = buf_price-doc-forming-gds.b-code  and               buf_bar-code.gds-code  = buf_base_bar-code.gds-code  and               buf_bar-code.node-code = buf_base_bar-code.node-code and               buf_bar-code.in-code   = buf_base_bar-code.in-code   and               buf_bar-code.part-code = buf_base_bar-code.part-code ,         each buf_goods no-lock where              buf_goods.gds-code = buf_bar-code.gds-code and              buf_goods.unit-base <> buf_bar-code.unit-cli ,         each buf_gds-prt no-lock where              buf_gds-prt.node-code = buf_bar-code.node-code
     7995     .
     7996         assign
     7997           l-query-was-opened = true
     7998         .
     7999     end.
     8000     end.
     8001     when 'code'    then do:
     8002   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8003   define variable  l-disable-where-88  as logical   no-undo .
     8004   define variable  l-filter-open-88    as logical   .
     8005   define variable  flt-rec-88       as recid     no-undo .
     8006   define variable  filter-name-88      as character no-undo .
     8007   define variable  where-phrase-88     as character no-undo .
     8008   define variable  sort-phrase-88      as character no-undo .
     8009   define variable  where-phrase-rus-88 as character no-undo .
     8010   define variable  sort-phrase-rus-88  as character no-undo .
     8011   run gbl/flt-get.p
     8012     (input filter-point
