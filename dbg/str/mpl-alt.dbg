      840     ,output p-hostcode
      841     ) no-error .
      842   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      844     (input  buf_goods.gds-code
      845     ,input  '1':U
      846     ,input  ?
      847     ,input  p-hostcode
      848     ,input  buf_price-doc.obj-type
      849     ,input  buf_price-doc.obj-code
      850     ,output local_vat-pc
      851     ) no-error .
      852   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      854     (input  buf_goods.gds-code
      855     ,input  '2':U
      856     ,input  ?
      857     ,input  p-hostcode
      858     ,input  buf_price-doc.obj-type
      859     ,input  buf_price-doc.obj-code
      860     ,output local_slt-pc
      861     ) no-error .
      862       kk = kk + 1.
      863   define variable v-main-bar-code as integer   no-undo .
      864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      865     (input  buf_goods.gds-code
      866     ,input  ?
      867     ,output v-main-bar-code
      868     )  .
      869       create buf_price-list.
      870       assign
      871           buf_price-list.line-num    = kk
      872           buf_price-list.doc-num     = buf_price-doc.doc-num
      873           buf_price-list.b-code      = buf_bar-code.b-code
      874           buf_price-list.artic       = buf_goods.artic
      875           buf_price-list.prod-type   = buf_goods.prod-type
      876           buf_price-list.prod-code   = buf_goods.prod-code
      877           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      878           buf_price-list.calc-method = 'Отсутствует':U
      879           buf_price-list.obj-type    = buf_price-doc.obj-type
      880           buf_price-list.obj-code    = buf_price-doc.obj-code
      881           buf_price-list.price-sale  = p-price-sale
      882           buf_price-list.vat-pc      = local_vat-pc
