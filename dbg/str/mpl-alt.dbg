     4004                  buf-gds-grp.node-code = buf-goods.grp-code.
     4005              p-increase-pc  = loc-grp-increase-pc .
     4006              p-round-method = loc-grp-round-method .
     4007              p-round-base   = loc-grp-round-base .
     4008              g-g = true  .
     4009           end.
     4010           otherwise do:
