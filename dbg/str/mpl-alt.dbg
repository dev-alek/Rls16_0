     1861   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1862   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1863     (input  ?
     1864     ,input  l-type
     1865     ,input  l-code
     1866     ,output par-pr-nakl-ie
     1867     ,output par-pr-nakl-iv
     1868     ,output par-pr-nakl-im
     1869     ) no-error .
     1870      define variable ii as integer   no-undo .
     1871      define variable nn as integer   no-undo .
     1872      define variable v-fullname as character no-undo .
     1873      nn = num-entries ( par-pr-nogds ).
     1874      par-pr-nogds-long = "".
     1875      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1876         repeat ii = 1 to nn :
     1877           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1878           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1879         end.
     1880         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1881      end.
     1882   l-par = true .
     1883   end procedure.
     1884   PROCEDURE cre-pr-list:
     1885   define input  parameter bc      like ub.price-list.b-code no-undo.
     1886   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1887   define output parameter new-rec as recid             no-undo.
     1888   define buffer buf-price-list for ub.price-list.
     1889   define buffer buf-price-doc  for ub.price-doc.
     1890   define buffer buf-bar-code   for ub.bar-code.
     1891   define buffer buf-goods      for ub.goods.
     1892   define buffer buf-gds-prt    for ub.gds-prt.
     1893   define buffer root-gds-prt   for ub.gds-prt.
     1894   define variable cur-pr like ub.price-list.price-sale no-undo.
     1895   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1896   define variable cur-ex like ub.price-list.excise     no-undo.
     1897   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1898   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1899   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1900   define variable cur-rt-base as decimal no-undo .
     1901   define variable cur-rt-rubl as decimal no-undo .
     1902   define variable p-hostcode as int no-undo .
     1903   define variable v-line-num as integer no-undo .
     1904   define variable v-skip-del-gds as logical no-undo initial no .
     1905   cre-pr:
     1906   do on error undo cre-pr, return error:
     1907     find  buf-bar-code no-lock where
     1908           buf-bar-code.b-code = bc.
     1909     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1910     if error-status :error then do:
     1911       message
     1912         return-value skip
     1913         "Ошибка !"
     1914         view-as alert-box error
     1915       .
     1916       undo cre-pr, return.
     1917     end.
     1918     find  buf-goods no-lock where
     1919           buf-goods.gds-code = buf-bar-code.gds-code.
     1920     find first root-gds-prt no-lock where
     1921               root-gds-prt.upper-code = buf-goods.prt-root.
     1922     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1923       buf-bar-code.in-code <> "" then do:
     1924       message
     1925         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1926         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1927         view-as alert-box error.
     1928       undo cre-pr, return.
     1929     end.
     1930     find  buf-gds-prt no-lock where
     1931           buf-gds-prt.node-code = buf-bar-code.node-code.
     1932     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1933       message
     1934         "Не допускается создавать цены на удаленные товары!" skip (2)
     1935         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1936         view-as alert-box error.
     1937       undo cre-pr, return.
     1938     end.
     1939     find  buf-price-doc where
     1940           buf-price-doc.doc-num = new-num.
     1941   define variable v-ret as logical no-undo .
     1942      run ver-modificator-price-is-null (
     1943             input    buf-goods.artic        ,
     1944             input    buf-goods.prod-type    ,
     1945             input    buf-goods.prod-code    ,
     1946             input    buf-price-doc.obj-type   ,
     1947             input    buf-price-doc.obj-code   ,
     1948             output   v-ret ).
     1949         if v-ret = false then dO:
     1950             message
     1951               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1952               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1953               view-as alert-box error.
     1954             undo cre-pr, return.
     1955           end.
