     1984     (input  buf-price-doc.obj-type
     1985     ,input  buf-price-doc.obj-code
     1986     ,input  bc
     1987     ,input  0
     1988     ,input  0
     1989     ,output cur-dn
     1990     ,output cur-pr
     1991     ,output cur-rt
     1992     ,output cur-ex
     1993     ) no-error .
     1994     find first buf-price-list where
     1995               buf-price-list.b-code  = buf-bar-code.b-code and
     1996               buf-price-list.doc-num = new-num  and
     1997               buf-price-list.price-type = ""    no-error .
     1998     if not available buf-price-list then do:
     1999       run calc-price-line-num (input  new-num , output v-line-num) .
     2000       create buf-price-list.
     2001       assign
     2002         buf-price-list.line-num  = v-line-num
     2003         buf-price-list.b-code    = buf-bar-code.b-code
     2004         buf-price-list.doc-num   = buf-price-doc.doc-num
     2005         buf-price-list.prod-type = buf-goods.prod-type
     2006         buf-price-list.prod-code = buf-goods.prod-code
     2007         buf-price-list.artic     = buf-goods.artic
     2008         buf-price-list.obj-type  = buf-price-doc.obj-type
     2009         buf-price-list.obj-code  = buf-price-doc.obj-code
     2010         buf-price-list.vat-pc    = local_vat-pc
     2011         buf-price-list.slt-pc    = local_slt-pc
     2012         buf-price-list.price-prev = cur-pr
     2013         .
     2014       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2015           buf-bar-code.in-code   = "" and
     2016           buf-bar-code.part-code = "" and
     2017           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2018         buf-price-list.main-price = yes.
     2019         if cur-pr <> ? then do:
     2020           run exp-prt (input buf-goods.gds-code,
     2021                       input cur-dn,
     2022                       input new-num,
     2023                       output new-rec) no-error.
     2024           if error-status :error then do:
     2025             message
     2026               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2027               view-as alert-box error.
     2028             undo cre-pr, return error.
     2029           end.
     2030         end.
     2031       end.
     2032       else do:
     2033         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2034           buf-price-list.d-pcnt = ?.
     2035         end.
     2036         buf-price-list.main-price = no.
     2037       end.
     2038     end.
     2039   end.
     2040   new-rec = recid (buf-price-list).
     2041   END PROCEDURE.
     2042   procedure calc-price-line-num :
     2043    do
     2044    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2045    :
     2046   define input parameter p-doc-num as character no-undo .
     2047   define output parameter p-num  as integer no-undo .
     2048   define variable v-fact as integer no-undo .
     2049   define buffer buf_1_price-list for ub.price-list .
     2050   p-num = 1 .
     2051   find last  buf_1_price-list no-lock where
     2052              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2053              if available buf_1_price-list then
     2054                   assign
     2055                     v-fact = buf_1_price-list.line-num
     2056                   .
     2057   v-fact = v-fact + 1.
     2058   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2059    end.
     2060   end procedure.
     2061   PROCEDURE del-pr-list:
     2062   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2063   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2064   define input parameter round-method as character         no-undo.
     2065   define input parameter round-base   as decimal      no-undo.
     2066   define buffer buf-price-list for ub.price-list.
     2067   define buffer buf-bar-code   for ub.bar-code.
     2068   define buffer buf-goods      for ub.goods.
     2069   define variable l-ov-on as logical no-undo .
     2070   del-pr:
     2071   do on error undo del-pr, return error:
     2072     find first  buf-price-list no-lock where
     2073                 buf-price-list.doc-num    = d-num and
     2074                 buf-price-list.b-code     = bc and
     2075                 buf-price-list.price-type = "" no-error.
     2076     if not available buf-price-list then
     2077       undo del-pr, return error.
     2078     find  buf-goods no-lock where
     2079           buf-goods.prod-type = buf-price-list.prod-type and
     2080           buf-goods.prod-code = buf-price-list.prod-code and
     2081           buf-goods.artic     = buf-price-list.artic.
     2082     if buf-price-list.main-price then do:
     2083       for each  buf-price-list exclusive-lock where
     2084                 buf-price-list.doc-num   = d-num and
     2085                 buf-price-list.artic     = buf-goods.artic and
     2086                 buf-price-list.prod-type = buf-goods.prod-type and
     2087                 buf-price-list.prod-code = buf-goods.prod-code,
     2088           first buf-bar-code no-lock where
     2089                 buf-bar-code.b-code = buf-price-list.b-code
     2090       on error undo del-pr, return error:
     2091   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2092   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2093     (input  ub.buf-price-list.obj-type
     2094     ,input  ub.buf-price-list.obj-code
     2095     ,input  ub.buf-price-list.artic
     2096     ,input  ub.buf-price-list.prod-type
     2097     ,input  ub.buf-price-list.prod-code
     2098     ,input  'ov-on=request:exclusive'
     2099     ,output l-ov-on
     2100     ) no-error .
     2101         if error-status:error then do:
     2102           message
     2103             vss-workfile vss-revision vss-description skip
     2104             "Ошибка получения признака товара на объекте" skip
     2105             error-status :get-message(1) skip
     2106             return-value skip
     2107             view-as alert-box error .
     2108         end.
     2109         if l-ov-on then do:
     2110   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2111   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2112     (input  ub.buf-price-list.obj-type
     2113     ,input  ub.buf-price-list.obj-code
     2114     ,input  ub.buf-price-list.artic
     2115     ,input  ub.buf-price-list.prod-type
     2116     ,input  ub.buf-price-list.prod-code
     2117     ,input  'ov-on=false'
     2118     ,output l-ov-on
     2119     ) no-error .
     2120           if error-status :error then do:
     2121           end.
     2122          end.
     2123         delete buf-price-list.
     2124       end.
     2125     end.
     2126     else do:
     2127       find  buf-bar-code no-lock where
     2128             buf-bar-code.b-code = buf-price-list.b-code.
     2129       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2130         message
     2131           "Нельзя удалить неосновную цену." skip
     2132           "Неосновная цена (скидка) не может быть неопределенной." skip
     2133           "Код:" bc skip
     2134           "Переоценка:" d-num
     2135           view-as alert-box error.
     2136         undo del-pr, return error.
     2137       end.
     2138       find current buf-price-list exclusive-lock no-error .
     2139       delete buf-price-list.
     2140       run calc-base-upd (input buf-bar-code.b-code,
     2141                         input d-num,
     2142                         input round-method,
     2143                         input round-base) no-error.
     2144       if error-status :error then
     2145         undo del-pr, return error.
     2146     end.
     2147   end.
     2148   END PROCEDURE.
     2149   PROCEDURE calc-base-upd:
     2150   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2151   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2152   define input parameter round-method as character         no-undo.
     2153   define input parameter round-base   as decimal      no-undo.
     2154   define buffer alt-bar-code   for ub.bar-code.
     2155   define buffer alt-price-list for ub.price-list.
     2156   define buffer buf-bar-code   for ub.bar-code.
     2157   define buffer buf-goods      for ub.goods.
     2158   calc-base:
     2159   do on error undo calc-base, return error:
     2160     find  buf-bar-code no-lock where
     2161           buf-bar-code.b-code = bc.
     2162     find  buf-goods no-lock where
     2163           buf-goods.gds-code = buf-bar-code.gds-code.
     2164     for each  alt-bar-code no-lock where
     2165               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2166               alt-bar-code.node-code = buf-bar-code.node-code and
     2167               alt-bar-code.part-code = buf-bar-code.part-code and
     2168               alt-bar-code.in-code   = buf-bar-code.in-code and
     2169               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2170         each  alt-price-list where
     2171               alt-price-list.doc-num    = d-num and
     2172               alt-price-list.b-code     = alt-bar-code.b-code and
     2173               alt-price-list.price-type = ""
     2174         on error undo calc-base, return error:
     2175       run calc-pr-alt (input d-num,
     2176                       input alt-bar-code.b-code,
     2177                       input round-method,
     2178                       input round-base) no-error.
     2179       if error-status:error then
     2180         undo calc-base, return error.
     2181     end.
     2182   end.
     2183   END PROCEDURE.
     2184   PROCEDURE calc-pr-alt:
     2185   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2186   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2187   define input parameter r-method as character             no-undo.
     2188   define input parameter r-base   as decimal              no-undo.
     2189   define buffer buf-price-doc  for ub.price-doc.
     2190   define buffer buf-price-list for ub.price-list.
     2191   define buffer buf-bar-code   for ub.bar-code.
     2192   define buffer buf-goods      for ub.goods.
     2193   define buffer old-price-list for ub.price-list.
     2194   define variable pr-rec   as   recid                  no-undo.
     2195   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2196   pr-alt:
     2197   do on error undo pr-alt, return error:
     2198     if r-method = ? or
     2199        r-base = ? then do:
     2200       message
     2201         "Нельзя удалить основную цену." skip
     2202         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2203         "Код:" bc skip
     2204         "Переоценка:" d-num
     2205         view-as alert-box error.
     2206       undo pr-alt, return error.
     2207     end.
     2208     find  buf-price-doc where
     2209           buf-price-doc.doc-num = d-num.
     2210     find  buf-bar-code no-lock where
     2211           buf-bar-code.b-code = bc.
     2212     find  buf-goods no-lock where
     2213           buf-goods.gds-code = buf-bar-code.gds-code.
     2214     find  buf-price-list where
     2215           buf-price-list.doc-num = buf-price-doc.doc-num and
     2216           buf-price-list.b-code  = bc.
     2217     if buf-price-list.d-pcnt = ? then do:
     2218   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2220     (input  buf-price-doc.obj-type
     2221     ,input  buf-price-doc.obj-code
     2222     ,input  bc
     2223     ,input  0
     2224     ,input  0
     2225     ,output pr-rec
     2226     ,output pr-c-b-r
     2227     )  .
     2228       find old-price-list no-lock where
     2229           recid (old-price-list) = pr-rec no-error.
     2230       if available old-price-list and
     2231         old-price-list.b-code = bc then
     2232         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2233       else
     2234         buf-price-list.d-pcnt = 0.
     2235     end.
     2236      if buf-price-list.d-pcnt = ? then do:
     2237         assign
     2238           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2239           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2240           .
     2241     end.
     2242     else do:
     2243         assign
     2244           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2245                                         buf-bar-code.cli-base-rate *
     2246                                         (1 - buf-price-list.d-pcnt / 100)
     2247           buf-price-list.calc-method =  'Основная':U
     2248           .
     2249   case r-method :
     2250     when '9-окончание':U then do:
     2251       if buf-price-list.price-sale < 29 then do:
     2252         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2253           assign
     2254             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2255           .
     2256         end.
     2257       end.
     2258       else do:
     2259         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2260           assign
     2261             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2262                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2263                   - 1 ) * 10
     2264                 + 9
     2265           .
     2266         end.
     2267         else do:
     2268           assign
     2269             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2270                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2271                   ) * 10
     2272                 + 9
     2273           .
     2274         end.
     2275         assign
     2276           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2277         .
     2278       end.
     2279     end.
     2280     when '9-99окончание':U then do:
     2281       if buf-price-list.price-sale < r-base then do:
     2282         assign
     2283           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2284         .
     2285       end.
     2286       else do:
     2287         assign
     2288           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2289         .
     2290       end.
     2291     end.
     2292     when 'Без-дробных':U then do:
     2293       assign
     2294         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2295       .
     2296     end.
     2297     when 'Произвольно':U then do:
     2298       if r-base <> 0 then do:
     2299         assign
     2300           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2301         .
     2302         if buf-price-list.price-sale = 0 then do:
     2303           assign
     2304             buf-price-list.price-sale = r-base
     2305           .
     2306         end.
     2307       end.
     2308     end.
     2309     when 'Вверх':U then do:
     2310       if r-base <> 0 then do:
     2311         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2312           assign
     2313             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2314           .
     2315         end.
     2316       end.
     2317       if buf-price-list.price-sale = 0 then do:
     2318         assign
     2319           buf-price-list.price-sale = r-base
     2320         .
     2321       end.
     2322     end.
     2323     when 'Коэффициент':U then do:
     2324       if r-base <> 0 then do:
     2325         assign
     2326           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2327         .
     2328       end.
     2329     end.
     2330     when 'Отключено':U then do:
     2331     end.
     2332     otherwise do:
     2333       message
     2334         vss-workfile vss-revision vss-description skip
     2335         "Неизвестный метод округления продажной цены" skip
     2336         "round-method" r-method skip
     2337         "round-base"   r-base   skip
     2338         "price"        buf-price-list.price-sale             skip
     2339         view-as alert-box error .
     2340     end.
     2341   end.
     2342     end.
     2343   end.
     2344   END PROCEDURE.
     2345   PROCEDURE calc-pr-discnt:
     2346   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2347   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2348   define buffer buf-price-doc  for ub.price-doc.
     2349   define buffer buf-price-list for ub.price-list.
     2350   define buffer buf-bar-code   for ub.bar-code.
     2351   define buffer buf-goods      for ub.goods.
     2352   define buffer old-price-list for ub.price-list.
     2353   define variable pr-rec   as   recid                  no-undo.
     2354   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2355   pr-discnt:
     2356   do on error undo pr-discnt, return error:
     2357     find  buf-price-doc where
     2358           buf-price-doc.doc-num = d-num.
     2359     find  buf-bar-code no-lock where
     2360           buf-bar-code.b-code = bc.
     2361     find  buf-goods no-lock where
     2362           buf-goods.gds-code = buf-bar-code.gds-code.
     2363     find  buf-price-list where
     2364           buf-price-list.doc-num = buf-price-doc.doc-num and
     2365           buf-price-list.b-code  = bc.
     2366     buf-price-list.d-pcnt = (1 -
     2367                              buf-price-list.price-sale /
     2368                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2369                              buf-bar-code.cli-base-rate) *
     2370                              100
     2371                              .
     2372   end.
     2373   END PROCEDURE.
     2374   PROCEDURE calc-pr-sub :
     2375   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2376   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2377   define  input  parameter calc-method  as character    no-undo.
     2378   define  input  parameter increase-pc  as decimal      no-undo.
     2379   define  input  parameter round-method as character    no-undo.
     2380   define  input  parameter round-base   as decimal      no-undo.
     2381   define  output parameter calc-rec     as recid        no-undo.
     2382   define  buffer buf-price-list for ub.price-list.
     2383   define  buffer buf-bar-code   for ub.bar-code.
     2384   define  buffer buf-goods      for ub.goods.
     2385   define  buffer buf-gds-prt    for ub.gds-prt.
     2386   define  buffer buf-gds-grp    for ub.gds-grp.
     2387   define  buffer buf-price-doc  for ub.price-doc.
     2388   calc-sub:
     2389   do on error undo calc-sub, return error:
     2390     find  buf-bar-code no-lock where
     2391           buf-bar-code.b-code = bc.
     2392     find  buf-goods no-lock where
     2393           buf-goods.gds-code = buf-bar-code.gds-code.
     2394     find  buf-gds-prt no-lock where
     2395           buf-gds-prt.node-code = buf-bar-code.node-code.
     2396     find  buf-price-list where
     2397           buf-price-list.doc-num    = d-num and
     2398           buf-price-list.b-code     = bc and
     2399           buf-price-list.price-type = "".
     2400     find  buf-price-doc where
     2401           buf-price-doc.doc-num = d-num.
     2402     calc-rec = recid (buf-price-list).
     2403     if buf-price-list.main-price then do:
     2404       for each  buf-price-list where
     2405                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2406                 buf-price-list.main-price = no and
     2407                 buf-price-list.artic      = buf-goods.artic and
     2408                 buf-price-list.prod-type  = buf-goods.prod-type and
     2409                 buf-price-list.prod-code  = buf-goods.prod-code,
     2410           first buf-bar-code no-lock where
     2411                 buf-bar-code.b-code   = buf-price-list.b-code and
     2412                 buf-bar-code.unit-cli = buf-goods.unit-base
     2413           on error undo calc-sub, return error:
     2414         run calc-pr-list (input  buf-bar-code.b-code,
     2415                           input  buf-price-list.doc-num,
     2416                           input  calc-method,
     2417                           input  increase-pc,
     2418                           input  round-method,
     2419                           input  round-base,
     2420                           input ? ,
     2421                           input ? ,
     2422                           input ? ,
     2423                           input ? ,
     2424                           output calc-rec) no-error.
     2425         if error-status :error then
     2426           undo calc-sub, return error.
     2427         calc-rec = recid (buf-price-list).
     2428       end.
     2429       for each  buf-price-list where
     2430                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2431                 buf-price-list.main-price = no and
     2432                 buf-price-list.artic      = buf-goods.artic and
     2433                 buf-price-list.prod-type  = buf-goods.prod-type and
     2434                 buf-price-list.prod-code  = buf-goods.prod-code,
     2435           first buf-bar-code no-lock where
     2436                 buf-bar-code.b-code    = buf-price-list.b-code and
     2437                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2438           on error undo calc-sub, return error:
     2439         run calc-pr-alt (input buf-price-doc.doc-num,
     2440                         input buf-bar-code.b-code,
     2441                         input round-method,
     2442                         input round-base) no-error.
     2443         if error-status :error then
     2444           undo calc-sub, return error.
     2445       end.
     2446     end.
     2447     else do:
     2448       run calc-base-upd (input buf-bar-code.b-code,
     2449                         input buf-price-doc.doc-num,
     2450                         input round-method,
     2451                         input round-base) no-error.
     2452       if error-status :error then
     2453         undo calc-sub, return error.
     2454     end.
     2455   end.
     2456   END PROCEDURE.
     2457   procedure ver-pr-nogds :
     2458   define input  parameter p-gds-code      as integer   no-undo .
     2459   define input  parameter p-par-pr-nogds  as character no-undo .
     2460   define output parameter p-not           as logical   no-undo .
     2461   define output parameter p-str           as character no-undo .
     2462   define buffer buf_goods for ub.goods  .
     2463   define variable nn as integer   no-undo .
     2464   define variable ii as integer   no-undo .
     2465   define variable v-namegrp as character no-undo .
     2466     do
     2467     on error undo, return error return-value
     2468     :
     2469     if p-par-pr-nogds = "1" then do:
     2470        assign
     2471         p-not = true
     2472         p-str = ""
     2473        .
     2474        return .
     2475     end.
     2476     assign
     2477       p-not = false
     2478       p-str = ""
     2479     .
     2480     find first buf_goods no-lock where
     2481                buf_goods.gds-code = p-gds-code no-error .
     2482     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2483     repeat ii = 1 to nn:
     2484        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2485        if buf_goods.grp-name  begins v-namegrp  then do:
     2486           assign
     2487             p-not = true
     2488             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2489           .
     2490           leave .
     2491        end.
     2492     end.
     2493     end.
     2494   end procedure.
     2495   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2496   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2497   define temp-table tt-level-dis-attr no-undo
     2498         field attr-code   like global-state-attr.attr-code
     2499         field attr-value  like global-state-attr.attr-value
     2500         index pi   attr-value descending
     2501         index pi1 is unique attr-value
     2502               attr-code .
     2503   procedure lvldsc-byattr :
     2504   define input  parameter p-attr-code  as character no-undo .
     2505   define input  parameter p-attr-value as character no-undo .
     2506   define output parameter p-val1       as decimal   no-undo .
     2507   define output parameter p-val2       as decimal   no-undo .
     2508   define output parameter p-prc        as decimal   no-undo .
     2509     do
     2510     on error undo, return error return-value
     2511     :
     2512     define variable v-str1 as character no-undo .
     2513     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2514     v-str1 = trim ( v-str1 , chr(4) ) .
     2515    run lvldsc-bytt (
     2516         input   v-str1
     2517       , input   p-attr-value
     2518       , output  p-val1
     2519       , output  p-val2
     2520       , output  p-prc )
     2521         no-error .
     2522     end.
     2523   end procedure.
     2524   procedure lvldsc-bytt :
     2525   define input  parameter p-attr-code as character no-undo .
     2526   define input  parameter p-attr-value as character no-undo .
     2527   define output parameter p-val1 as decimal   no-undo .
     2528   define output parameter p-val2 as decimal   no-undo .
     2529   define output parameter p-prc  as decimal   no-undo .
     2530   define variable v-str1 as character no-undo .
     2531     do
     2532     on error undo, return error return-value
     2533     :
     2534     assign
     2535        v-str1 = trim ( p-attr-code , "[]()" )
     2536        p-val1 = decimal(entry(1,v-str1, ";"))
     2537        p-val2 = decimal(entry(2,v-str1, ";"))
     2538        p-prc  = decimal(p-attr-value)
     2539        no-error
     2540     .
     2541     end.
     2542   end procedure.
     2543   procedure level-dis-value :
     2544   define input  parameter p-price-prod as decimal   no-undo .
     2545   define input  parameter p-b-code     as integer   no-undo .
     2546   define input  parameter p-obj-type   as character no-undo .
     2547   define input  parameter p-obj-code   as integer   no-undo .
     2548   define output parameter p-prc as decimal   no-undo .
     2549   define variable v-level-dis-attr as character no-undo .
     2550   define variable v-type as character no-undo .
     2551   define variable v-val1 as decimal   no-undo .
     2552   define variable v-val2 as decimal   no-undo .
     2553   define variable v-prc  as decimal   no-undo .
     2554   define variable ix     as integer   no-undo .
     2555   do
     2556    on error undo, return error return-value
     2557    :
     2558   define buffer buf_goods for ub.goods  .
     2559   define buffer buf_bar-code for ub.bar-code  .
     2560   find first buf_bar-code no-lock where
     2561              buf_bar-code.b-code = p-b-code
     2562              no-error .
     2563   find first buf_goods no-lock where
     2564              buf_goods.gds-code = buf_bar-code.gds-code
     2565              no-error .
     2566   run ggoattr-value (
     2567      input   buf_goods.grp-code
     2568     ,input   v-cntxt-host-code-obj
     2569     ,input   p-obj-type
     2570     ,input   p-obj-code
     2571     ,input   'level-dis':U
     2572     ,output  v-level-dis-attr
     2573     ,output  v-type ) no-error .
     2574   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     2575     create
     2576       tt-level-dis-attr
     2577     .
     2578     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2579     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2580   end.
     2581   p-prc = 0 .
     2582     if p-price-prod = 0 then do:
     2583         for each tt-level-dis-attr no-lock
     2584                 :
     2585               run lvldsc-bytt (
     2586                 input   tt-level-dis-attr.attr-code
     2587               , input   tt-level-dis-attr.attr-value
     2588               , output  v-val1
     2589               , output  v-val2
     2590               , output  v-prc  )
     2591               .
     2592               if v-val1  = 0  then do:
     2593                  p-prc = v-prc .
     2594                 leave.
     2595               end.
     2596         end.
     2597     end.
     2598     else do:
     2599         for each tt-level-dis-attr no-lock
     2600                 :
     2601               run lvldsc-bytt (
     2602                 input   tt-level-dis-attr.attr-code
     2603               , input   tt-level-dis-attr.attr-value
     2604               , output  v-val1
     2605               , output  v-val2
     2606               , output  v-prc  )
     2607               .
     2608               if p-price-prod   > v-val1 and
     2609                  p-price-prod  <= v-val2 then do:
     2610                  p-prc = v-prc .
     2611                 leave.
     2612               end.
     2613         end.
     2614     end.
     2615   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     2616    end.
     2617   end procedure.
     2618   procedure calc-price-levelprod :
     2619   define input  parameter p-mode     as integer   no-undo .
     2620   define input  parameter p-rb       as character no-undo .
     2621   define input  parameter p-b-code   as integer   no-undo .
     2622   define input  parameter p-obj-type as character no-undo .
     2623   define input  parameter p-obj-code as integer   no-undo .
     2624   define output parameter p-price-sale as decimal   no-undo .
     2625   define output parameter p-descript-calc as character no-undo .
     2626   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     2627   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     2628   define variable  v-prod-vat        as decimal   no-undo init 0.
     2629   define variable  v-discnt          as decimal   no-undo init 0.
     2630   define buffer buf_goods for ub.goods  .
     2631   define buffer buf_bar-code for ub.bar-code  .
     2632   define buffer buf_parts for ub.parts  .
     2633   define variable v-part-code as character no-undo .
     2634   define variable v-in-code   as character no-undo .
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2639   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2640   (  input  p-b-code
     2641    , input  p-obj-type
     2642    , input  p-obj-code
     2643    , output v-PriceWithoutVat
     2644    , output v-PriceWithVat
     2645    , output v-prod-vat
     2646    , output v-part-code
     2647    , output v-in-code
     2648           ) no-error .
     2649         if error-status :error then do:
     2650           return error "Нет цены производителя!".
     2651         end.
     2652   find first buf_bar-code no-lock where
     2653              buf_bar-code.b-code = p-b-code
     2654              no-error .
     2655   find first buf_goods no-lock where
     2656              buf_goods.gds-code = buf_bar-code.gds-code
     2657              no-error .
     2658   find first buf_parts no-lock where
     2659              buf_parts.artic      = buf_goods.artic        and
     2660              buf_parts.prod-type  = buf_goods.prod-type    and
     2661              buf_parts.prod-code  = buf_goods.prod-code    and
     2662              buf_parts.in-code    = buf_bar-code.in-code   and
     2663              buf_parts.out-code   = buf_bar-code.in-code   and
     2664              buf_parts.part-code  = buf_bar-code.part-code
     2665              no-error .
     2666               if error-status :error then do:
     2667                   find first buf_parts no-lock where
     2668                             buf_parts.artic      = buf_goods.artic        and
     2669                             buf_parts.prod-type  = buf_goods.prod-type    and
     2670                             buf_parts.prod-code  = buf_goods.prod-code    and
     2671                             buf_parts.in-code    = v-in-code              and
     2672                             buf_parts.out-code   = v-in-code              and
     2673                             buf_parts.part-code  = v-part-code
     2674                             no-error .
     2675                   if error-status :error then do:
     2676                      message
     2677                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     2678                                   v-in-code,
     2679                                   v-part-code ,
     2680                                   buf_goods.artic   ,
     2681                                   buf_goods.prod-type,
     2682                                   buf_goods.prod-code ) .
     2683                      return error "Нет цены производителя !!!".
     2684                   end.
     2685               end.
     2686   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     2687   define variable v-postWithoutVat-rubl as decimal   no-undo .
     2688   define variable v-postWithoutVat-base as decimal   no-undo .
     2689      case p-mode :
     2690       when 1 then do:
     2691          if p-rb = "rubl" then do:
     2692             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     2693          end.
     2694          else do:
     2695             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     2696          end.
     2697       end.
     2698       when 2 then do:
     2699         if p-rb = "rubl" then do:
     2700           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     2701           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     2702         end.
     2703         else do:
     2704           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     2705           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     2706         end.
     2707       end.
     2708      end case.
     2709   p-descript-calc =
     2710     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     2711     buf_goods.gds-name                  +  chr(10) +
     2712     buf_goods.artic +
     2713     buf_goods.prod-type +
     2714     string(buf_goods.prod-code)         + chr(10) +
     2715     "бар-код " +  string(p-b-code)      + chr(10)  +
     2716     'ПН    ' + v-in-code  +
     2717     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     2718     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     2719     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     2720     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     2721     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     2722     chr(10) +
     2723     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     2724     chr(10) +
     2725     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     2726     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     2727     chr(10) +
     2728     string(p-price-sale)                                                               +  chr(10) +
     2729     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     2730     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     2731   .
     2732     end.
     2733   end procedure.
     2734   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2735   PROCEDURE write-bonus :
     2736   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2737   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2738   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2739   define input  parameter v-bonus as decimal   no-undo .
     2740     do
     2741     on error undo, return error return-value
     2742     :
     2743       find first ub.contract-specif-attr exclusive-lock  where
     2744                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2745                  ub.contract-specif-attr.host-code    = p-host-code     and
     2746                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2747                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2748                 no-error .
     2749         if not available ub.contract-specif-attr then do:
     2750            create ub.contract-specif-attr .
     2751            assign
     2752                 ub.contract-specif-attr.contract-num = p-contract-num
     2753                 ub.contract-specif-attr.host-code    = p-host-code
     2754                 ub.contract-specif-attr.gds-code     = p-gds-code
     2755                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2756            .
     2757         end.
     2758         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2759   end.
     2760   END PROCEDURE.
     2761   PROCEDURE read-bonus :
     2762   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2763   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2764   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2765   define output parameter v-bonus as decimal   no-undo .
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769   find first ub.contract-specif-attr no-lock  where
     2770              ub.contract-specif-attr.contract-num = p-contract-num  and
     2771              ub.contract-specif-attr.host-code    = p-host-code     and
     2772              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2773              ub.contract-specif-attr.attr-code    = 'bonus':U
     2774              no-error .
     2775      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2776                                           else  v-bonus = 0 .
     2777   end.
     2778   END PROCEDURE.
     2779   PROCEDURE write-prc-min :
     2780   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2781   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2782   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2783   define input  parameter v-prc-min        as decimal   no-undo .
     2784     do
     2785     on error undo, return error return-value
     2786     :
     2787       find first ub.contract-specif-attr exclusive-lock  where
     2788                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2789                 ub.contract-specif-attr.host-code    = p-host-code     and
     2790                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2791                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2792                 no-error .
     2793         if not available ub.contract-specif-attr then do:
     2794            create ub.contract-specif-attr .
     2795            assign
     2796                 ub.contract-specif-attr.contract-num = p-contract-num
     2797                 ub.contract-specif-attr.host-code    = p-host-code
     2798                 ub.contract-specif-attr.gds-code     = p-gds-code
     2799                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2800                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2801            .
     2802         end.
     2803         else do:
     2804            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2805         end.
     2806       find first ub.contract-specif exclusive-lock where
     2807           ub.contract-specif.contract-num = p-contract-num and
     2808           ub.contract-specif.host-code    = p-host-code    and
     2809           ub.contract-specif.gds-code     = p-gds-code.
     2810           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2811   end.
     2812   END PROCEDURE.
     2813   PROCEDURE read-prc-min :
     2814   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2815   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2816   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2817   define output parameter v-prc-min as decimal   no-undo .
     2818     do
     2819     on error undo, return error return-value
     2820     :
     2821   find first ub.contract-specif-attr no-lock  where
     2822              ub.contract-specif-attr.contract-num = p-contract-num  and
     2823              ub.contract-specif-attr.host-code    = p-host-code     and
     2824              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2825              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2826              no-error .
     2827      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2828                                           else  v-prc-min = 0 .
     2829   end.
     2830   END PROCEDURE.
     2831   PROCEDURE write-retro-bonus :
     2832   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2833   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2834   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2835   define input  parameter v-retro-bonus as character   no-undo .
     2836     do
     2837     on error undo, return error return-value
     2838     :
     2839       find first ub.contract-specif-attr exclusive-lock  where
     2840                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2841                 ub.contract-specif-attr.host-code    = p-host-code     and
     2842                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2843                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2844                 no-error .
     2845         if not available ub.contract-specif-attr then do:
     2846            create ub.contract-specif-attr .
     2847            assign
     2848                 ub.contract-specif-attr.contract-num = p-contract-num
     2849                 ub.contract-specif-attr.host-code    = p-host-code
     2850                 ub.contract-specif-attr.gds-code     = p-gds-code
     2851                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2852            .
     2853            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2854            if error-status:error then
     2855               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2856         end.
     2857         else do:
     2858            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2859            if error-status:error then
     2860               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2861         end.
     2862       find first ub.contract-specif exclusive-lock where
     2863           ub.contract-specif.contract-num = p-contract-num and
     2864           ub.contract-specif.host-code    = p-host-code    and
     2865           ub.contract-specif.gds-code     = p-gds-code.
     2866           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2867   end.
     2868   END PROCEDURE.
     2869   PROCEDURE read-retro-bonus :
     2870   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2871   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2872   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2873   define output parameter v-retro-bonus as character   no-undo .
     2874     do
     2875     on error undo, return error return-value
     2876     :
     2877   find first ub.contract-specif-attr no-lock  where
     2878              ub.contract-specif-attr.contract-num = p-contract-num  and
     2879              ub.contract-specif-attr.host-code    = p-host-code     and
     2880              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2881              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2882              no-error .
     2883      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2884                                           else  v-retro-bonus = "" .
     2885   end.
     2886   END PROCEDURE.
     2887   define variable v-str1 as character no-undo .
     2888   FUNCTION fnc-base-price-doc RETURN decimal
     2889     ( local-bc as integer, p-recid as recid ).
     2890   define buffer   base-price       for ub.price-doc-forming-gds .
     2891   define variable local-main-code like ub.bar-code.b-code no-undo.
     2892   define variable local-base-code like ub.bar-code.b-code no-undo.
     2893   define buffer   buf_main-pdf     for ub.price-doc-forming .
     2894   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     2895     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     2896     find base-price no-lock where
     2897          base-price.pdf-id = buf_main-pdf.pdf-id and
     2898          base-price.pdf-db = buf_main-pdf.pdf-db and
     2899          base-price.plt-id = buf_main-pdf.plt-id and
     2900          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2901          base-price.b-code  = local-base-code
     2902          no-error.
     2903     if not available base-price then do:
     2904       run prc-main-code in this-procedure
     2905          ( input local-bc, output local-main-code ).
     2906       find  base-price no-lock where
     2907             base-price.pdf-id = buf_main-pdf.pdf-id and
     2908             base-price.pdf-db = buf_main-pdf.pdf-db and
     2909             base-price.plt-id = buf_main-pdf.plt-id and
     2910             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2911             base-price.b-code  = local-main-code
     2912             no-error.
     2913     end.
     2914     if available base-price then
     2915       return (base-price.price-sale-doc).
     2916     else
     2917       return (?).
     2918   END FUNCTION.
