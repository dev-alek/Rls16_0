     3673               message 3.
     3674            end.
     3675            when 'ПорогПр+НДС':U then do:
     3676                message 4.
     3677            end.
     3678            when 'Производит':U then do:
     3679               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     3680            end.
     3681            when 'Произв-НДС':U then do:
     3682               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     3683            end.
     3684            otherwise do:
     3685               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     3686            end.
     3687           end case.
     3688           assign
     3689             p-price-calc-rubl  =  cost-rubl
     3690             p-road-tax-rubl    =  cur-rt-rubl
     3691             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3692             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3693             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3694           .
     3695       end.
     3696       else dO:
     3697            case p-calc-method :
     3698            when 'ПорогПр-НДС':U then do:
     3699               message 5.
     3700            end.
     3701            when 'ПорогПр+НДС':U then do:
     3702                message 6.
     3703            end.
     3704            when 'Производит':U then do:
     3705               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3706            end.
     3707            when 'Произв-НДС':U then do:
     3708               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     3709            end.
     3710            otherwise do:
     3711               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3712            end.
     3713            end case.
     3714           assign
     3715             p-price-calc-base  =  cost-base
     3716             p-road-tax-base    =  cur-rt-base
     3717             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     3718             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     3719             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     3720             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3721             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3722             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3723           .
     3724       end.
     3725   case p-round-method :
     3726     when '9-окончание':U then do:
     3727       if p-price-sale-doc < 29 then do:
     3728         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     3729           assign
     3730             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     3731           .
     3732         end.
     3733       end.
     3734       else do:
     3735         if (p-price-sale-doc modulo 10) < 3 then do:
     3736           assign
     3737             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3738                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3739                   - 1 ) * 10
     3740                 + 9
     3741           .
     3742         end.
     3743         else do:
     3744           assign
     3745             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3746                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3747                   ) * 10
     3748                 + 9
     3749           .
     3750         end.
     3751         assign
     3752           p-price-sale-doc = round (p-price-sale-doc, 0)
     3753         .
     3754       end.
     3755     end.
     3756     when '9-99окончание':U then do:
     3757       if p-price-sale-doc < p-round-base then do:
     3758         assign
     3759           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     3760         .
     3761       end.
     3762       else do:
     3763         assign
     3764           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     3765         .
     3766       end.
     3767     end.
     3768     when 'Без-дробных':U then do:
     3769       assign
     3770         p-price-sale-doc = round (p-price-sale-doc, 0)
     3771       .
     3772     end.
     3773     when 'Произвольно':U then do:
     3774       if p-round-base <> 0 then do:
     3775         assign
     3776           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     3777         .
     3778         if p-price-sale-doc = 0 then do:
     3779           assign
     3780             p-price-sale-doc = p-round-base
     3781           .
     3782         end.
     3783       end.
     3784     end.
     3785     when 'Вверх':U then do:
     3786       if p-round-base <> 0 then do:
     3787         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     3788           assign
     3789             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     3790           .
     3791         end.
     3792       end.
     3793       if p-price-sale-doc = 0 then do:
     3794         assign
     3795           p-price-sale-doc = p-round-base
     3796         .
     3797       end.
     3798     end.
     3799     when 'Коэффициент':U then do:
     3800       if p-round-base <> 0 then do:
     3801         assign
     3802           p-price-sale-doc = p-price-sale-doc * p-round-base
     3803         .
     3804       end.
     3805     end.
     3806     when 'Отключено':U then do:
     3807     end.
     3808     otherwise do:
     3809       message
     3810         vss-workfile vss-revision vss-description skip
     3811         "Неизвестный метод округления продажной цены" skip
     3812         "round-method" p-round-method skip
     3813         "round-base"   p-round-base   skip
     3814         "price"        p-price-sale-doc             skip
     3815         view-as alert-box error .
     3816     end.
     3817   end.
     3818       if error-status :error then do:
     3819       message
     3820         error-status :get-message(1) skip
     3821         return-value skip
     3822         "pr-99"
     3823         view-as alert-box error
     3824       .
     3825       end.
     3826     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     3827     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     3828     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     3829     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     3830     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     3831     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     3832     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     3833     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     3834     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     3835     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     3836     p-prev-doc-code = if available bufold_price-doc-forming
     3837                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     3838                          else "" .
     3839     end.
     3840   end procedure.
