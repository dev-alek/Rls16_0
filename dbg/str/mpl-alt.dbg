     4553           vss-workfile vss-revision vss-description skip
     4554           error-status :get-message(1) skip
     4555           return-value skip
     4556           "proprice.i"
     4557           view-as alert-box error
     4558         .
     4559         if vd = 0 or vd = ?  then do:
     4560           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4561                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4562                   "- расчет по производителю от последней приходной накладной невозможен."
     4563                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     4564         end.
     4565         else do:
