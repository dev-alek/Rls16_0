      782     run fltfield-add in this-procedure('in-doc-code', 'Номер док-та прих.', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      783     run fltfield-add in this-procedure('in-doc-date', 'Дата док-та прих.', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      784     run fltfield-add in this-procedure('obj-code', '', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      785     run fltfield-add in this-procedure('obj-type', '', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
