      701       if error-status:error then return no-apply.
      702   END.
      703   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      704   DO:
      705     define variable g-log  as logical   no-undo .
      706     if not available X_c-schet-fact-doc then return no-apply.
      707   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   do:
      709     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      710       (input  v-cntxt-db-num
      711       ,input  v-cntxt-userid
      712       ,input  0
      713       ,input  'actn_schet-fact-doc_update':U
      714       ,input  'firm':U
      715       ,input  p-host-code
      716       ,input  '':U
      717       ,input  0
      718       ,input  0
      719       ,input  0
      720       ,input  0
      721       ,input  true
      722       ,output g-log
      723       )  .
      724   end.
      725     if not g-log then  return .
      726     run str/s-f-doc.w (input parparentproc,input p-host-code, input X_c-schet-fact-doc.db-num, 'ПРОСМОТР':U, input X_c-schet-fact-doc.doc-code, input X_c-schet-fact-doc.chip-num) .
      727   END.
      728   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      729   DO:
      730   define variable loc#log as logical no-undo .
      731     if available X_c-schet-fact-doc then do:
      732         if can-do( p-rid-list, string( recid( X_c-schet-fact-doc ) ) ) then do:
      733             p-rid-list = replace( p-rid-list, chr(44) + string( recid( X_c-schet-fact-doc ) ), "") .
      734             p-rid-list = replace( p-rid-list, string( recid( X_c-schet-fact-doc ) ) + chr(44), "") .
      735             p-rid-list = replace( p-rid-list, string( recid( X_c-schet-fact-doc ) ), "") .
      736         end.
      737         else
      738         p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( X_c-schet-fact-doc ) ) .
      739         loc#log = br-c-schet-fact-doc:refresh() .
      740         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      741             loc#log = br-c-schet-fact-doc:select-next-row ().
      742             apply "VALUE-CHANGED" to br-c-schet-fact-doc in frame Dialog-Frame.
      743         end.
      744         if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
      745         else disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      746     end.
      747     apply "entry" to br-c-schet-fact-doc in frame Dialog-Frame.
      748   END.
