      765     run fltfield-add in this-procedure('base-scale', '', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      766     run fltfield-add in this-procedure('PS',         '', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      767     run fltfield-add in this-procedure('book-code', 'Номер в книге', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      768     run fltfield-add in this-procedure('own-address', '', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      769     run fltfield-add in this-procedure('own-inn', '', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
