      771     run fltfield-add in this-procedure('cli-address', 'Адрес поставщика', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      772     run fltfield-add in this-procedure('cli-inn', 'ИНН  поставщика', '',  input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      773     run fltfield-add in this-procedure('cli-type', 'Тип  поставщика', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      774     run fltfield-add in this-procedure('cli-code', 'Код  поставщика', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      775     run fltfield-add in this-procedure('cli-name', 'Имя  поставщика', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      776     run fltfield-add in this-procedure('Gruz-otprav', '', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      777     run fltfield-add in this-procedure('Gruz-poluch', '', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
