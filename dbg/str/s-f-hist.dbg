     2540   FUNCTION mark-string RETURNS CHARACTER
     2541     ( input par-recid as recid, input mark-list as character) :
     2542   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2543   END FUNCTION.
