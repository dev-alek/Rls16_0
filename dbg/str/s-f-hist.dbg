      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable c-point  as character no-undo .
      119   define variable tbl      as character no-undo .
      120   define variable join-tbl as character no-undo .
      121   define variable fld      as character no-undo .
      122   define variable lab      as character no-undo .
      123   define variable spr      as character no-undo .
      124   define variable dim      as character no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure fltfield-clear :
      377     define output parameter loc-fld as character no-undo.
      378     define output parameter loc-lab as character no-undo .
      379     define output parameter loc-spr as character no-undo .
      380     define output parameter loc-dim as character no-undo .
      381     assign
      382       loc-fld = ""
      383       loc-lab = ""
      384       loc-spr = ""
      385       loc-dim = "0"
      386     .
      387   end procedure .
      388   procedure fltfield-add :
      389     define input        parameter par-fld as character no-undo.
      390     define input        parameter par-lab as character no-undo .
      391     define input        parameter par-spr as character no-undo .
      392     define input-output parameter loc-fld as character no-undo.
      393     define input-output parameter loc-lab as character no-undo .
      394     define input-output parameter loc-spr as character no-undo .
      395     define input-output parameter loc-dim as character no-undo .
      396     do
      397     on error undo, return error
      398     :
      399       assign
      400       loc-fld = if loc-dim = '0'
      401                 then par-fld
      402                 else (loc-fld + chr(44) + par-fld)
      403       loc-lab = if loc-dim = '0'
      404                 then par-lab
      405                 else (loc-lab + chr(44) + par-lab)
      406       loc-spr = if loc-dim = '0'
      407                 then par-spr
      408                 else (loc-spr + chr(44) + par-spr)
      409       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      410                 string(integer(if num-entries(loc-dim) > 1
      411                               then entry(2, loc-dim)
      412                               else entry(1, loc-dim)
      413                               ) + 1)
      414       no-error
      415       .
      416     end.
      417   end procedure.
      418   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419     define variable v-cntxt-db-num        as integer   no-undo .
      420     define variable v-cntxt-userid        as character no-undo .
      421     define variable v-cntxt-level         as character no-undo .
      422     define variable v-cntxt-host-code-obj as integer   no-undo .
      423     define variable v-cntxt-obj-type      as character no-undo .
      424     define variable v-cntxt-obj-code      as integer   no-undo .
      425     define variable v-cntxt-db-num-obj    as integer   no-undo .
      426     define variable v-cntxt-is-admin      as logical   no-undo .
      427   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   function usrfulnf returns character ( input p-user-id as character):
      429   define variable v-user-name as character no-undo .
      430   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      432     (input  p-user-id
      433     ,output v-user-name
      434     ) no-error .
      435   if error-status:error
      436   or v-user-name = ""
      437   then do:
      438     return p-user-id.
      439   end.
      440   else do:
      441     return v-user-name.
      442   end.
      443   end function.
      444   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      446   procedure fltopend_fltopend :
      447   define input parameter p-parent-handle as handle no-undo .
      448   define input parameter p-qh as handle no-undo .
      449   define input parameter p-flt-open-open-query  as character no-undo .
      450   define input parameter p-where-cond as character no-undo .
      451   define input parameter p-use-indFIRST-query-tail as character no-undo .
      452   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      453   define input parameter p-indexed-reposition as character no-undo .
      454     do
      455     on error undo, return error
      456     :
      457   define variable v-prepare-string as character no-undo .
      458   define variable glog as logical no-undo .
      459   assign
      460   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      461                      p-where-cond + chr(32)  +
      462                      p-use-indFIRST-query-tail + chr(32) +
      463                      p-use-ind-sort-clmn-by + chr(32) +
      464                      p-indexed-reposition
      465   .
      466   assign
      467   glog = p-qh:query-prepare(v-prepare-string) no-error .
      468   if not glog
      469   or error-status:error then do:
      470     message error-status:get-message(1) view-as alert-box .
      471     undo, return error .
      472   end.
      473   assign
      474   glog = p-qh:query-open no-error .
      475   if not glog
      476   or error-status:error then do:
      477     message error-status:get-message(1) view-as alert-box .
      478     undo, return error .
      479   end.
      480     end.
      481   end procedure.
      482   procedure fltopend_fltfindd :
      483   define input parameter p-parent-handle as handle no-undo .
      484   define input parameter p-qh as handle no-undo .
      485   define input parameter p-rowid as rowid no-undo .
      486   define input parameter p-next as logical no-undo .
      487   define input parameter p-lock as integer no-undo .
      488   define input parameter p-bh as handle no-undo .
      489   define input parameter p-where-cond as character no-undo .
      490   define input parameter p-use-index-phrase as character no-undo .
      491   define variable glog as logical no-undo .
      492   define variable v-qh as handle no-undo .
      493   define variable v-bh as handle no-undo .
      494   define variable v-recid as recid no-undo .
      495   define variable v-prepare-string as character no-undo .
      496   do
      497   on error undo, return error
      498   on stop undo, return error
      499   :
      500     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      501     create buffer v-bh for table p-bh buffer-name p-bh:name.
      502     create query v-qh.
      503     v-qh:set-buffers(v-bh).
      504     v-prepare-string = substitute("for each &1 &2 &3"
      505                                     ,v-bh:name
      506                                     ,p-where-cond
      507                                     ,p-use-index-phrase).
      508     glog = v-qh:query-prepare(v-prepare-string) no-error.
      509     if not glog then do:
      510       delete object v-qh.
      511       delete object v-bh.
      512       undo, return error .
      513     end.
      514     glog = v-qh:query-open no-error .
      515     if not glog then do:
      516       delete object v-qh.
      517       delete object v-bh.
      518       undo, return error .
      519     end.
      520     if p-next then do:
      521       v-qh:reposition-to-rowid(p-rowid) no-error .
      522       glog = v-qh:get-next( p-lock) no-error .
      523       glog = v-qh:get-next( p-lock) no-error .
      524       if not glog or v-qh:query-off-end = yes then do:
      525         glog = v-qh:get-first( p-lock) no-error .
      526       end.
      527     end.
      528     else do:
      529       glog = v-qh:get-first( p-lock) no-error .
      530     end.
      531     v-recid = v-bh:recid no-error .
      532     delete object v-qh.
      533     delete object v-bh.
      534     return string(v-recid) .
      535   end.
      536   end procedure.
      537   procedure fltopend_fltfindq :
      538   define input parameter p-parent-handle as handle no-undo .
      539   define input parameter p-qh as handle no-undo .
      540   define input parameter p-next as logical no-undo .
      541   define input parameter p-lock as integer no-undo .
      542   define input parameter p-flt-open-open-query  as character no-undo .
      543   define input parameter p-where-cond as character no-undo .
      544   define input parameter p-use-indFIRST-query-tail as character no-undo .
      545   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      546   define input parameter p-indexed-reposition as character no-undo .
      547   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      548   define variable glog as logical no-undo .
      549   define variable v-qh as handle no-undo .
      550   define variable v-bh as handle no-undo extent 18.
      551   define variable v-rowid as rowid no-undo extent 18.
      552   define variable v-ii as integer no-undo .
      553   define variable v-prepare-string as character no-undo .
      554   do
      555   on error undo, return error
      556   on stop undo, return error
      557   :
      558     create query v-qh.
      559     do v-ii = 1 to p-qh:num-buffers:
      560       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      561       assign
      562       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      563       no-error.
      564       v-qh:add-buffer(v-bh[v-ii]).
      565     end.
      566     assign
      567     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      568                       p-where-cond + chr(32)  +
      569                       p-use-indFIRST-query-tail + chr(32) +
      570                       p-use-ind-sort-clmn-by + chr(32) +
      571                       p-indexed-reposition
      572     .
      573     glog = v-qh:query-prepare( v-prepare-string) no-error .
      574     if not glog then do:
      575       delete object v-qh.
      576       do v-ii = 1 to p-qh:num-buffers:
      577         delete object v-bh[v-ii].
      578       end.
      579       undo, return error .
      580     end.
      581     glog = v-qh:query-open no-error .
      582     if not glog then do:
      583       delete object v-qh.
      584       do v-ii = 1 to p-qh:num-buffers:
      585         delete object v-bh[v-ii].
      586       end.
      587       undo, return error .
      588     end.
      589     if p-next then do:
      590       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      591       glog = v-qh:get-next( p-lock) no-error .
      592       glog = v-qh:get-next( p-lock) no-error .
      593       if not glog or v-qh:query-off-end = yes then do:
      594         glog = v-qh:get-first( p-lock) no-error .
      595       end.
      596     end.
      597     else do:
      598       glog = v-qh:get-first( p-lock) no-error .
      599     end.
      600     do v-ii = 1 to p-qh:num-buffers:
      601       assign
      602       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      603       no-error.
      604     end.
      605     delete object v-qh.
      606     do v-ii = 1 to p-qh:num-buffers:
      607       delete object v-bh[v-ii].
      608     end.
      609   end.
      610   end procedure.
      611   define variable  p-rid-list    as  character no-undo .
      612   define variable  bttns  as character   no-undo .
      613   define variable filter-point as character no-undo initial "Список истории счетов-фактур" .
      614   define variable filter-point0 as character no-undo initial "Список истории счетов-фактур" .
      615   define variable sort-column-name as character no-undo .
      616   define variable v-doc-rec as recid no-undo .
      617   define variable title0 as character no-undo.
      618   define temp-table temp-changes no-undo
      619     field f_name as character
      620     field l_name as character
      621     field v_old as character
      622     field v_new as character
      623   index pi is unique primary f_name.
      624   FUNCTION mark-string RETURNS CHARACTER
      625     ( input par-recid as recid, input mark-list as character)  FORWARD.
      626   DEFINE BUTTON B-Help
      627        LABEL "Помо&щь"
      628        SIZE 10 BY 1
      629        BGCOLOR 8 .
      630   DEFINE BUTTON B-lookup
      631        LABEL "&Просмотр"
      632        SIZE 10 BY 1.
      633   DEFINE BUTTON B-mark
      634        LABEL "&*"
      635        SIZE 3 BY 1.
      636   DEFINE BUTTON b-quit AUTO-GO
      637        LABEL "&Выход"
      638        SIZE 10 BY 1
      639        BGCOLOR 8 .
      640   DEFINE BUTTON B-sch
      641        LABEL "&Фильтр"
      642        SIZE 10 BY 1.
      643   DEFINE BUTTON b-sel AUTO-GO
      644        LABEL "Вы&бор"
      645        SIZE 10 BY 1
      646        BGCOLOR 8 .
      647   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      648         VIEW-AS TEXT
      649        SIZE 6 BY 1
      650        FGCOLOR 4  NO-UNDO.
      651   DEFINE QUERY br-c-schet-fact-doc FOR X_c-schet-fact-doc SCROLLING.
      652   DEFINE QUERY BR-changes FOR
      653         temp-changes SCROLLING.
      654   DEFINE BROWSE br-c-schet-fact-doc
      655     QUERY br-c-schet-fact-doc DISPLAY
      656         (mark-string(recid(X_c-schet-fact-doc), p-rid-list)) COLUMN-LABEL "*" FORMAT "x(1)"
      657         X_c-schet-fact-doc.corr-date                    COLUMN-LABEL "Дата!изменения"  FORMAT "99/99/99"
      658         string(X_c-schet-fact-doc.corr-time,"HH:MM")    COLUMN-LABEL "Время!изменения" FORMAT "X(5)"
      659         usrfulnf(X_c-schet-fact-doc.corr-user-name)     COLUMN-LABEL "Оператор"        FORMAT "X(18)"
      660         X_c-schet-fact-doc.doc-code                     COLUMN-LABEL "Номер"           FORMAT "X(16)"
      661         X_c-schet-fact-doc.doc-date                     COLUMN-LABEL "Дата"  FORMAT "99/99/99"
      662         X_c-schet-fact-doc.status_                      COLUMN-LABEL "Статус"          FORMAT "X(4)"
      663         string( X_c-schet-fact-doc.cli-type + ' ' + string(X_c-schet-fact-doc.cli-code)) COLUMN-LABEL "Тип/код!контрагента" FORMAT "x(10)"
      664         X_c-schet-fact-doc.cli-name                     COLUMN-LABEL "Контрагент"      FORMAT "x(40)"
      665         X_c-schet-fact-doc.sum-rubl                     COLUMN-LABEL "Сумма"           FORMAT ">>>,>>>,>>>,>>>,>>>.<<"
      666         X_c-schet-fact-doc.ext-doc-type                 COLUMN-LABEL "Тип"    FORMAT "X(3)"
      667         X_c-schet-fact-doc.in-doc-code                  COLUMN-LABEL "По док-ту"  FORMAT "X(12)"
      668         X_c-schet-fact-doc.contract-code                COLUMN-LABEL "Вн.№ договора"  FORMAT ">>>>>>>>>>9"
      669       ENABLE
      670         X_c-schet-fact-doc.doc-code
      671       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 13.71.
      672   DEFINE BROWSE BR-changes
      673     QUERY BR-changes DISPLAY
      674         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(35)"
      675   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
      676   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
      677       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.88 BY 5.83.
      678   DEFINE FRAME Dialog-Frame
      679        b-quit AT ROW 1 COL 1
      680        B-mark AT ROW 1 COL 11
      681        b-sel AT ROW 1 COL 21
      682        B-lookup AT ROW 1 COL 31
      683        B-sch AT ROW 1 COL 41
      684        B-Help AT ROW 1 COL 86.25
      685        br-c-schet-fact-doc AT ROW 2 COL 1.38
      686        BR-changes AT ROW 16.04 COL 1.38
      687        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      688        SPACE(77.49) SKIP(20.03)
      689       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      690            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      691            TITLE "Список договоров"
      692            CANCEL-BUTTON b-quit.
      693   ASSIGN
      694          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      695          FRAME Dialog-Frame:HIDDEN           = TRUE.
      696   ASSIGN
      697          br-c-schet-fact-doc:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
      698   ON ENDKEY OF FRAME Dialog-Frame
      699   DO:
