      822   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      823   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      824   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   on help of frame Dialog-Frame
      826   do:
      827     run gbl/app_help.p
      828       (input this-procedure :file-name
      829       ,input ''
      830       ,input ?
      831       ) no-error.
      832     if error-status :error then do:
      833       message
      834         "Ошибка при вызове помощи"
      835         error-status :get-message(1)
      836         view-as alert-box .
      837     end.
      838   end.
      839   run minbtn-set in this-procedure .
      840   on choose of b-help in frame Dialog-Frame
      841   do:
      842     apply "help":u to frame Dialog-Frame .
      843   end.
      844   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   procedure minbtn-set :
      846       do
      847           on error undo, return error return-value
      848           :
      849           define variable ii              as integer       no-undo .
      850           define variable fh              as widget-handle no-undo .
      851           define variable hh              as widget-handle no-undo .
      852           define variable v-h             as handle        extent 4 no-undo .
      853           define variable v-name-button   as character     no-undo .
      854           define variable v-help-old-x    as decimal       no-undo .
      855           define variable v-help-old-y    as decimal       no-undo .
      856           define variable v-help-old-size as decimal       no-undo .
      857           define variable v-frame-width   as decimal       no-undo .
      858           define variable jj              as integer       no-undo .
      859           do
      860               on error undo, return error
      861               :
      862               assign
      863                   v-frame-width = frame Dialog-Frame:width - 0.3
      864                   fh            = frame Dialog-Frame:first-child
      865                   hh            = fh:first-child
      866                   ii            = 1
      867                   .
      868               do while valid-handle(hh):
      869                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      870                   do:
      871                       case lc(hh:name) :
      872                           when "b-help" then
      873                               do:
      874                                   hh:load-image-up("cmp/b-help.bmp":u) .
      875                                   hh:load-image-down("cmp/b-help.bmp":u) .
      876                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      877                                   hh:TOOLTIP = "Помощь" .
      878                                   v-help-old-x = hh:column .
      879                                   v-help-old-y = hh:row    .
      880                                   v-help-old-size = hh:width .
      881                                   hh:width-chars = 2.5 .
      882                               end.
      883                           when "b-print" then
      884                               do:
      885                                   hh:load-image("cmp/b-print.bmp":u) .
      886                                   hh:TOOLTIP = "Печать" .
      887                                   v-h[ii] = hh:handle .
      888                                   ii = ii + 1 .
      889                                   hh:width-chars = 3 .
      890                               end.
      891                           when "b-history" or
      892                           when "b-hist" then
      893                               do:
      894                                   hh:load-image("cmp/b-hist.bmp":u) .
      895                                   hh:TOOLTIP = "История" .
      896                                   v-h[ii] = hh:handle .
      897                                   ii = ii + 1 .
      898                                   hh:width-chars = 3 .
      899                               end.
      900                           when "b-sch" then
      901                               do:
      902                                   hh:load-image("cmp/b-sch.bmp":u) .
      903                                   hh:TOOLTIP = "Установка Фильтра" .
      904                                   v-h[ii] = hh:handle .
      905                                   ii = ii + 1 .
      906                                   hh:width-chars = 3 .
      907                               end.
      908                           when "b-hist-user" then
      909                               do:
      910                                   hh:load-image("cmp/b-hist.bmp":u) .
      911                                   hh:TOOLTIP = "История пользователя" .
      912                                   ii = ii + 1 .
      913                               end.
      914                       end case.
      915                   end.
      916                   hh = hh:next-sibling.
      917               end.
      918               b-help:column = v-frame-width - b-help:width-chars.
      919               jj = 0.
      920               repeat ii = 4 to 1 by -1 :
      921                   if valid-handle (v-h[ii] ) then
      922                   do:
      923                       jj  = jj + 1 .
      924                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      925                       v-h[ii]:row    = v-help-old-y .
      926                   end.
      927               end.
      928           end.
      929       end.
      930   end procedure.
      931   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      932   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      933   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      934   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      935   define variable v-diasize-current-frame-width  as decimal   no-undo .
      936   define variable v-diasize-current-frame-height as decimal   no-undo .
      937   define variable v-diasize-change-size          as logical   no-undo .
      938   define variable v-diasize-resize-button        as handle    no-undo .
      939   define variable v-diasize-wndmax               as logical   no-undo .
      940   define variable v-diasize-wndstore             as logical   no-undo .
      941   define variable v-diasize-proc-name            as character no-undo .
      942   define variable v-diasize-browse-handle        as handle    no-undo .
      943   define variable v-diasize-browse-number        as integer   no-undo .
      944   define variable v-diasize-need-full-display    as logical   no-undo init false .
      945   define temp-table temp-diasize-handle no-undo
      946     field handle-value  as handle
      947     field save-position as decimal
      948     index xpk is primary unique handle-value
      949     .
      950   define temp-table temp-browse-handle no-undo
      951     field browse-type   as character
      952     field browse-number as integer
      953     field browse-handle as handle
      954     field original-size as decimal
      955     index xpk is primary unique browse-type browse-number
      956     index xie browse-type browse-handle
      957   .
      958   procedure diasize_change-height :
      959     define input  parameter p-change-value  as decimal   no-undo .
      960     define input  parameter p-move-resize   as logical   no-undo .
      961     define variable v-field-group-handle    as handle    no-undo .
      962     define variable v-object-handle         as handle    no-undo .
      963     define variable v-frame-height          as decimal   no-undo .
      964     define variable v-frame-virtual-height  as decimal   no-undo .
      965     define variable v-browse-height         as decimal   no-undo .
      966     define variable v-window-height         as decimal   no-undo .
      967     define variable v-window-virtual-height as decimal   no-undo .
      968     define variable v-change-sign           as integer   no-undo .
      969     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      970     define buffer buf_temp-browse-handle  for temp-browse-handle .
      971     if p-change-value > 0
      972     then do:
      973       if frame Dialog-Frame :height + p-change-value
      974           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      975       then do:
      976         assign
      977           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      978                           - (frame Dialog-Frame :height-chars)
      979         .
      980         if p-change-value <= 0
      981         then do:
      982           run diasize_position-resize-button in this-procedure .
      983           return .
      984         end.
      985       end.
      986     end.
      987     if p-change-value < 0
      988     then do:
      989       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      990       then do:
      991         assign
      992           p-change-value = v-diasize-orig-frame-height
      993                          - (frame Dialog-Frame :height-chars)
      994         .
      995         if p-change-value >= 0
      996         then do:
      997           run diasize_position-resize-button in this-procedure .
      998           return .
      999         end.
     1000       end.
     1001     end.
     1002     if p-change-value >= 0
     1003     then do:
     1004       assign
     1005         v-change-sign = 1
     1006       .
     1007     end.
     1008     else do:
     1009       assign
     1010         v-change-sign = -1
     1011       .
     1012     end.
     1013     assign
     1014       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1015     .
     1016     if p-change-value = 0
     1017     then do:
     1018       run diasize_position-resize-button in this-procedure .
     1019       return .
     1020     end.
     1021     move_block:
     1022     do
     1023     on error undo move_block, retry move_block
     1024     :
     1025       if retry
     1026       then do:
     1027         do
     1028         on error undo move_block, leave move_block
     1029         :
     1030           if p-change-value > 0
     1031           then do:
     1032             for each buf_temp-diasize-handle
     1033             on error undo, next
     1034             :
     1035               assign
     1036                 v-object-handle = buf_temp-diasize-handle.handle-value
     1037               .
     1038               if v-object-handle <> v-diasize-resize-button
     1039               then do:
     1040                 assign
     1041                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1042                 .
     1043               end.
     1044             end.
     1045             assign
     1046               v-diasize-browse-handle :height = v-browse-height
     1047             .
     1048             for each buf_temp-browse-handle
     1049               where buf_temp-browse-handle.browse-type = 'height':u
     1050             on error undo, next
     1051             :
     1052               assign
     1053                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1054               .
     1055             end.
     1056             assign
     1057               frame Dialog-Frame :height = v-frame-height
     1058             .
     1059             if frame Dialog-Frame :scrollable = true
     1060             then do:
     1061               assign
     1062                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1063               .
     1064             end.
     1065             run diasize_position-resize-button in this-procedure .
     1066           end.
     1067           else do:
     1068             if frame Dialog-Frame :scrollable = true
     1069             then do:
     1070               assign
     1071                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1072               .
     1073             end.
     1074             assign
     1075               frame Dialog-Frame :height = v-frame-height
     1076             .
     1077             assign
     1078               v-diasize-browse-handle :height = v-browse-height
     1079             .
     1080             for each buf_temp-browse-handle
     1081               where buf_temp-browse-handle.browse-type = 'height':u
     1082             on error undo, next
     1083             :
     1084               assign
     1085                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1086               .
     1087             end.
     1088             for each buf_temp-diasize-handle
     1089             on error undo, next
     1090             :
     1091               assign
     1092                 v-object-handle = buf_temp-diasize-handle.handle-value
     1093               .
     1094               if v-object-handle <> v-diasize-resize-button
     1095               then do:
     1096                 assign
     1097                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1098                 .
     1099               end.
     1100             end.
     1101             run diasize_position-resize-button in this-procedure .
     1102           end.
     1103           assign
     1104             v-diasize-change-size = false
     1105           .
     1106           leave move_block .
     1107         end.
     1108       end.
     1109       assign
     1110         v-diasize-need-full-display = true
     1111       .
     1112       if v-diasize-change-size = false
     1113       then do:
     1114         assign
     1115           v-diasize-change-size = true
     1116         .
     1117       end.
     1118       else do:
     1119         return .
     1120       end.
     1121       assign
     1122         v-frame-height = frame Dialog-Frame :height
     1123         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1124         v-browse-height = v-diasize-browse-handle :height
     1125       .
     1126       for each buf_temp-browse-handle
     1127         where buf_temp-browse-handle.browse-type = 'height':u
     1128       :
     1129         assign
     1130           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1131         .
     1132       end.
     1133       for each buf_temp-diasize-handle
     1134       :
     1135         delete buf_temp-diasize-handle .
     1136       end.
     1137       assign
     1138         v-field-group-handle = frame Dialog-Frame :first-child
     1139       .
     1140       do while valid-handle(v-field-group-handle)
     1141       :
     1142         assign
     1143           v-object-handle = v-field-group-handle :first-child
     1144         .
     1145         do while valid-handle(v-object-handle)
     1146         :
     1147           if  v-object-handle <> v-diasize-browse-handle :handle
     1148           and can-query(v-object-handle, "row")
     1149           and can-query(v-object-handle, "height")
     1150           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1151           then do:
     1152             find first buf_temp-browse-handle
     1153               where buf_temp-browse-handle.browse-type   = 'height':u
     1154                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1155               no-error .
     1156             if available buf_temp-browse-handle
     1157             then do:
     1158             end.
     1159             else do:
     1160               create buf_temp-diasize-handle .
     1161               assign
     1162                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1163                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1164               .
     1165             end.
     1166           end.
     1167           assign
     1168             v-object-handle = v-object-handle :next-sibling
     1169           .
     1170         end.
     1171         assign
     1172           v-field-group-handle = v-field-group-handle :next-sibling
     1173         .
     1174       end.
     1175       do with frame Dialog-Frame
     1176       :
     1177         hide v-diasize-resize-button .
     1178         assign
     1179           v-diasize-resize-button :row    = 1
     1180           v-diasize-resize-button :column = 1
     1181         .
     1182       end.
     1183       if p-change-value > 0
     1184       then do:
     1185         if frame Dialog-Frame :scrollable = true
     1186         then do:
     1187           assign
     1188             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1189             no-error .
     1190           if error-status :error
     1191           or error-status :get-message(1) <> ""
     1192           then do:
     1193             undo move_block, retry move_block .
     1194           end.
     1195         end.
     1196         assign
     1197           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1198           no-error .
     1199         if error-status :error
     1200         or error-status :get-message(1) <> ""
     1201         then do:
     1202           undo move_block, retry move_block .
     1203         end.
     1204         assign
     1205           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1206           no-error .
     1207         if error-status :error
     1208         or error-status :get-message(1) <> ""
     1209         then do:
     1210           undo move_block, retry move_block .
     1211         end.
     1212         for each buf_temp-browse-handle
     1213           where buf_temp-browse-handle.browse-type = 'height':u
     1214         on error undo move_block, retry move_block
     1215         :
     1216           assign
     1217             buf_temp-browse-handle.browse-handle :height
     1218               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1219             no-error .
     1220           if error-status :error
     1221           or error-status :get-message(1) <> ""
     1222           then do:
     1223             undo move_block, retry move_block .
     1224           end.
     1225         end.
     1226         for each buf_temp-diasize-handle
     1227         on error undo move_block, retry move_block
     1228         :
     1229           assign
     1230             v-object-handle = buf_temp-diasize-handle.handle-value
     1231           .
     1232           if v-object-handle <> v-diasize-resize-button
     1233           then do:
     1234             assign
     1235               v-object-handle :row = v-object-handle :row + p-change-value
     1236               no-error .
     1237             if error-status :error
     1238             or error-status :get-message(1) <> ""
     1239             then do:
     1240               undo move_block, retry move_block .
     1241             end.
     1242           end.
     1243         end.
     1244       end.
     1245       else do:
     1246         for each buf_temp-diasize-handle
     1247         on error undo move_block, retry move_block
     1248         :
     1249           assign
     1250             v-object-handle = buf_temp-diasize-handle.handle-value
     1251           .
     1252           if v-object-handle <> v-diasize-resize-button
     1253           then do:
     1254             assign
     1255               v-object-handle :row = v-object-handle :row + p-change-value
     1256               no-error .
     1257             if error-status :error
     1258             or error-status :get-message(1) <> ""
     1259             then do:
     1260               undo move_block, retry move_block .
     1261             end.
     1262           end.
     1263         end.
     1264         assign
     1265           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1266           no-error .
     1267         if error-status :error
     1268         or error-status :get-message(1) <> ""
     1269         then do:
     1270           undo move_block, retry move_block .
     1271         end.
     1272         for each buf_temp-browse-handle
     1273           where buf_temp-browse-handle.browse-type = 'height':u
     1274         on error undo move_block, retry move_block
     1275         :
     1276           assign
     1277             buf_temp-browse-handle.browse-handle :height
     1278               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1279             no-error .
     1280           if error-status :error
     1281           or error-status :get-message(1) <> ""
     1282           then do:
     1283             undo move_block, retry move_block .
     1284           end.
     1285         end.
     1286         assign
     1287           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1288           no-error .
     1289         if error-status :error
     1290         or error-status :get-message(1) <> ""
     1291         then do:
     1292           undo move_block, retry move_block .
     1293         end.
     1294         if frame Dialog-Frame :scrollable = true
     1295         then do:
     1296           assign
     1297             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1298             no-error .
     1299           if error-status :error
     1300           or error-status :get-message(1) <> ""
     1301           then do:
     1302             undo move_block, retry move_block .
     1303           end.
     1304         end.
     1305       end.
     1306       if p-move-resize = true
     1307       then do:
     1308         run diasize_position-resize-button in this-procedure .
     1309       end.
     1310       if v-diasize-wndstore = true
     1311       then do:
     1312         if connected("ub") = true
     1313         then do:
     1314           define variable v-cntxt-db-num        as integer   no-undo .
     1315           define variable v-cntxt-userid        as character no-undo .
     1316           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1317                                             , OUTPUT v-cntxt-userid
     1318                                             ) .
     1319           run gbl/wndsizew.p
     1320             (input  v-cntxt-db-num
     1321             ,input  v-cntxt-userid
     1322             ,input  v-diasize-proc-name
     1323             ,input  'height':u
     1324             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1325             ) .
     1326         end.
     1327       end.
     1328     end.
     1329     assign
     1330       v-diasize-change-size = false
     1331     .
     1332   end procedure.
     1333   procedure diasize_set-height :
     1334     define input  parameter p-new-height  as decimal   no-undo .
     1335     define input  parameter p-move-resize as logical   no-undo .
     1336     do
     1337     on error undo, return error return-value
     1338     :
     1339       run diasize_change-height in this-procedure
     1340         (input  (p-new-height - frame Dialog-Frame :height)
     1341         ,input  p-move-resize
     1342         ) .
     1343     end.
     1344   end procedure.
     1345   procedure diasize_change-width :
     1346     define input  parameter p-change-value as decimal   no-undo .
     1347     define input  parameter p-move-resize  as logical   no-undo .
     1348     define variable v-field-group-handle   as handle    no-undo .
     1349     define variable v-object-handle        as handle    no-undo .
     1350     define variable v-frame-width          as decimal   no-undo .
     1351     define variable v-frame-virtual-width  as decimal   no-undo .
     1352     define variable v-browse-width         as decimal   no-undo .
     1353     define variable v-window-width         as decimal   no-undo .
     1354     define variable v-window-virtual-width as decimal   no-undo .
     1355     define variable v-change-sign          as integer   no-undo .
     1356     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1357     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1358     if p-change-value > 0
     1359     then do:
     1360       if frame Dialog-Frame :width + p-change-value >
     1361           session :width-chars
     1362       then do:
     1363         assign
     1364           p-change-value = session :width-chars - frame Dialog-Frame :width
     1365         .
     1366         if p-change-value <= 0
     1367         then do:
     1368           run diasize_position-resize-button in this-procedure .
     1369           return .
     1370         end.
     1371       end.
     1372     end.
     1373     if p-change-value < 0
     1374     then do:
     1375       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1376       then do:
     1377         assign
     1378           p-change-value = v-diasize-orig-frame-width
     1379                          - frame Dialog-Frame :width
     1380         .
     1381         if p-change-value >= 0
     1382         then do:
     1383           run diasize_position-resize-button in this-procedure .
     1384           return .
     1385         end.
     1386       end.
     1387     end.
     1388     if p-change-value >= 0
     1389     then do:
     1390       assign
     1391         v-change-sign = 1
     1392       .
     1393     end.
     1394     else do:
     1395       assign
     1396         v-change-sign = -1
     1397       .
     1398     end.
     1399     assign
     1400       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1401     .
     1402     if p-change-value = 0
     1403     then do:
     1404       run diasize_position-resize-button in this-procedure .
     1405       return .
     1406     end.
     1407     move_block:
     1408     do
     1409     on error undo move_block, leave move_block
     1410     :
     1411       if retry
     1412       then do:
     1413         do
     1414         on error undo move_block, leave move_block
     1415         :
     1416           if p-change-value > 0
     1417           then do:
     1418             for each buf_temp-diasize-handle
     1419             on error undo, next
     1420             :
     1421               assign
     1422                 v-object-handle = buf_temp-diasize-handle.handle-value
     1423               .
     1424               if v-object-handle <> v-diasize-resize-button
     1425               then do:
     1426                 assign
     1427                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1428                 .
     1429               end.
     1430             end.
     1431             assign
     1432               v-diasize-browse-handle :width = v-browse-width
     1433             .
     1434             for each buf_temp-browse-handle
     1435               where buf_temp-browse-handle.browse-type = 'width':u
     1436             on error undo, next
     1437             :
     1438               assign
     1439                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1440               .
     1441             end.
     1442             assign
     1443               frame Dialog-Frame :width = v-frame-width
     1444             .
     1445             if frame Dialog-Frame :scrollable = true
     1446             then do:
     1447               assign
     1448                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1449               .
     1450             end.
     1451             run diasize_position-resize-button in this-procedure .
     1452           end.
     1453           else do:
     1454             if frame Dialog-Frame :scrollable = true
     1455             then do:
     1456               assign
     1457                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1458               .
     1459             end.
     1460             assign
     1461               frame Dialog-Frame :width = v-frame-width
     1462             .
     1463             for each buf_temp-browse-handle
     1464               where buf_temp-browse-handle.browse-type = 'width':u
     1465             on error undo, next
     1466             :
     1467               assign
     1468                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1469               .
     1470             end.
     1471             assign
     1472               v-diasize-browse-handle :width = v-browse-width
     1473             .
     1474             for each buf_temp-diasize-handle
     1475             on error undo, next
     1476             :
     1477               assign
     1478                 v-object-handle = buf_temp-diasize-handle.handle-value
     1479               .
     1480               if v-object-handle <> v-diasize-resize-button
     1481               then do:
     1482                 assign
     1483                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1484                 .
     1485               end.
     1486             end.
     1487             run diasize_position-resize-button in this-procedure .
     1488           end.
     1489           assign
     1490             v-diasize-change-size = false
     1491           .
     1492           leave move_block .
     1493         end.
     1494       end.
     1495       assign
     1496         v-diasize-need-full-display = true
     1497       .
     1498       if v-diasize-change-size = false
     1499       then do:
     1500         assign
     1501           v-diasize-change-size = true
     1502         .
     1503       end.
     1504       else do:
     1505         return .
     1506       end.
     1507       assign
     1508         v-frame-width = frame Dialog-Frame :width
     1509         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1510         v-browse-width = v-diasize-browse-handle :width
     1511       .
     1512       for each buf_temp-browse-handle
     1513         where buf_temp-browse-handle.browse-type = 'width':u
     1514       :
     1515         assign
     1516           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1517         .
     1518       end.
     1519       for each buf_temp-diasize-handle
     1520       :
     1521         delete buf_temp-diasize-handle .
     1522       end.
     1523       assign
     1524         v-field-group-handle = frame Dialog-Frame :first-child
     1525       .
     1526       do while valid-handle(v-field-group-handle)
     1527       :
     1528         assign
     1529           v-object-handle = v-field-group-handle :first-child
     1530         .
     1531         do while valid-handle(v-object-handle)
     1532         :
     1533           if  v-object-handle <> v-diasize-browse-handle :handle
     1534           and v-object-handle <> v-diasize-resize-button
     1535           and can-query(v-object-handle, "row")
     1536           and can-query(v-object-handle, "height")
     1537           and ( v-object-handle :col + v-object-handle :width
     1538                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1539               )
     1540           then do:
     1541             find first buf_temp-browse-handle
     1542               where buf_temp-browse-handle.browse-type   = 'width':u
     1543                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1544               no-error .
     1545             if available buf_temp-browse-handle
     1546             then do:
     1547             end.
     1548             else do:
     1549               create buf_temp-diasize-handle .
     1550               assign
     1551                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1552                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1553               .
     1554             end.
     1555           end.
     1556           assign
     1557             v-object-handle = v-object-handle :next-sibling
     1558           .
     1559         end.
     1560         assign
     1561           v-field-group-handle = v-field-group-handle :next-sibling
     1562         .
     1563       end.
     1564       do with frame Dialog-Frame
     1565       :
     1566         hide v-diasize-resize-button .
     1567         v-diasize-resize-button :row = 1.
     1568         v-diasize-resize-button :column = 1.
     1569       end.
     1570       if p-change-value > 0
     1571       then do:
     1572         if frame Dialog-Frame :scrollable = true
     1573         then do:
     1574           assign
     1575             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1576             no-error .
     1577           if error-status :error
     1578           or error-status :get-message(1) <> ""
     1579           then do:
     1580             undo move_block, retry move_block.
     1581           end.
     1582         end.
     1583         assign
     1584           frame Dialog-Frame :width = v-frame-width + p-change-value
     1585           no-error .
     1586         if error-status :error
     1587         or error-status :get-message(1) <> ""
     1588         then do:
     1589           undo move_block, retry move_block.
     1590         end.
     1591         assign
     1592           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1593         no-error .
     1594         if error-status :error
     1595         or error-status :get-message(1) <> ""
     1596         then do:
     1597           undo move_block, retry move_block.
     1598         end.
     1599         for each buf_temp-browse-handle
     1600           where buf_temp-browse-handle.browse-type = 'width':u
     1601         on error undo move_block, retry move_block
     1602         :
     1603           assign
     1604             buf_temp-browse-handle.browse-handle :width
     1605               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1606             no-error .
     1607           if error-status :error
     1608           or error-status :get-message(1) <> ""
     1609           then do:
     1610             undo move_block, retry move_block .
     1611           end.
     1612         end.
     1613         for each buf_temp-diasize-handle
     1614         on error undo move_block, retry move_block
     1615         :
     1616           assign
     1617             v-object-handle = buf_temp-diasize-handle.handle-value
     1618           .
     1619           if v-object-handle <> v-diasize-resize-button
     1620           then do:
     1621             assign
     1622               v-object-handle :col = v-object-handle :col + p-change-value
     1623               no-error .
     1624             if error-status :error
     1625             or error-status :get-message(1) <> ""
     1626             then do:
     1627               undo move_block, retry move_block .
     1628             end.
     1629           end.
     1630         end.
     1631       end.
     1632       else do:
     1633         for each buf_temp-diasize-handle
     1634         on error undo move_block, retry move_block
     1635         :
     1636           assign
     1637             v-object-handle = buf_temp-diasize-handle.handle-value
     1638           .
     1639           if v-object-handle <> v-diasize-resize-button
     1640           then do:
     1641             assign
     1642               v-object-handle :col = v-object-handle :col + p-change-value
     1643               no-error .
     1644             if error-status :error
     1645             or error-status :get-message(1) <> ""
     1646             then do:
     1647               undo move_block, retry move_block .
     1648             end.
     1649           end.
     1650         end.
     1651         for each buf_temp-browse-handle
     1652           where buf_temp-browse-handle.browse-type = 'width':u
     1653         on error undo move_block, retry move_block
     1654         :
     1655           assign
     1656             buf_temp-browse-handle.browse-handle :width
     1657               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1658             no-error .
     1659           if error-status :error
     1660           or error-status :get-message(1) <> ""
     1661           then do:
     1662             undo move_block, retry move_block .
     1663           end.
     1664         end.
     1665         assign
     1666           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1667           no-error .
     1668         if error-status :error
     1669         or error-status :get-message(1) <> ""
     1670         then do:
     1671           undo move_block, retry move_block.
     1672         end.
     1673         assign
     1674           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1675         no-error .
     1676         if error-status :error
     1677         or error-status :get-message(1) <> ""
     1678         then do:
     1679           undo move_block, retry move_block.
     1680         end.
     1681         if frame Dialog-Frame :scrollable = true
     1682         then do:
     1683           assign
     1684             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1685           no-error .
     1686           if error-status :error
     1687           or error-status :get-message(1) <> ""
     1688           then do:
     1689             undo move_block, retry move_block.
     1690           end.
     1691         end.
     1692       end.
     1693       if p-move-resize
     1694       then do:
     1695         run diasize_position-resize-button in this-procedure .
     1696       end.
     1697       if v-diasize-wndstore = true
     1698       then do:
     1699         if connected("ub") = true
     1700         then do:
     1701           define variable v-cntxt-db-num        as integer   no-undo .
     1702           define variable v-cntxt-userid        as character no-undo .
     1703           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1704                                             , OUTPUT v-cntxt-userid
     1705                                             ) .
     1706           run gbl/wndsizew.p
     1707             (input  v-cntxt-db-num
     1708             ,input  v-cntxt-userid
     1709             ,input  v-diasize-proc-name
     1710             ,input  'width':u
     1711             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1712             ) .
     1713         end.
     1714       end.
     1715     end.
     1716     assign
     1717       v-diasize-change-size = false
     1718     .
     1719   end procedure.
     1720   procedure diasize_set-width :
     1721     define input  parameter p-new-width  as decimal   no-undo .
     1722     define input  parameter p-move-resize as logical   no-undo .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       run diasize_change-width in this-procedure
     1727         (input  (p-new-width - frame Dialog-Frame :width)
     1728         ,input  p-move-resize
     1729         ) .
     1730     end.
     1731   end procedure.
     1732   procedure diasize_position-resize-button :
     1733     do with frame Dialog-Frame
     1734     :
     1735       hide v-diasize-resize-button .
     1736       assign
     1737         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1738                     - 1
     1739                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1740         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1741                     - 1
     1742                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1743       .
     1744       view v-diasize-resize-button .
     1745     end.
     1746   end procedure.
     1747   on alt-right anywhere
     1748   do:
     1749     run diasize_change-width in this-procedure
     1750       (input 1
     1751       ,input true
     1752       ) .
     1753     return no-apply .
     1754   end.
     1755   on alt-left anywhere
     1756   do:
     1757     run diasize_change-width in this-procedure
     1758       (input -1
     1759       ,input true
     1760       ) .
     1761     return no-apply .
     1762   end.
     1763   on alt-down anywhere
     1764   do:
     1765     run diasize_change-height in this-procedure
     1766       (input 1
     1767       ,input true
     1768       ) .
     1769     return no-apply .
     1770   end.
     1771   on alt-up anywhere
     1772   do:
     1773     run diasize_change-height in this-procedure
     1774       (input -1
     1775       ,input true
     1776       ) .
     1777     return no-apply .
     1778   end.
     1779   on alt-enter of frame Dialog-Frame
     1780   do:
     1781     run diasize_maximize in this-procedure
     1782       (input  ?
     1783       ).
     1784     return no-apply .
     1785   end.
     1786   procedure diasize_end-move :
     1787     do
     1788     on error undo, return error return-value
     1789     :
     1790       define variable v-row-delta as decimal   no-undo .
     1791       define variable v-col-delta as decimal   no-undo .
     1792       define variable v-new-row as decimal   no-undo .
     1793       define variable v-new-col as decimal   no-undo .
     1794       assign
     1795         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1796         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1797       .
     1798       assign
     1799         v-row-delta = v-new-row - frame Dialog-Frame :height
     1800         v-col-delta = v-new-col - frame Dialog-Frame :width
     1801       .
     1802       run diasize_change-height in this-procedure
     1803         (input v-row-delta
     1804         ,input true
     1805         ) .
     1806       run diasize_change-width in this-procedure
     1807         (input v-col-delta
     1808         ,input true
     1809         ) .
     1810     end.
     1811   end procedure.
     1812   procedure diasize_maximize :
     1813     define input  parameter p-action as logical   no-undo .
     1814     do
     1815     on error undo, return error return-value
     1816     :
     1817       if p-action = ?
     1818       then do:
     1819         if v-diasize-need-maximize = true
     1820         then do:
     1821           assign
     1822             p-action = true
     1823           .
     1824         end.
     1825         else do:
     1826           assign
     1827             p-action = false
     1828           .
     1829         end.
     1830       end.
     1831       if p-action = true
     1832       then do:
     1833         run diasize_change-height in this-procedure
     1834           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1835               - frame Dialog-Frame :height-chars
     1836           ,input true
     1837           ) .
     1838         run diasize_change-width in this-procedure
     1839           (input session :width-chars
     1840               - frame Dialog-Frame :width-chars
     1841           ,input true
     1842           ) .
     1843         assign
     1844           v-diasize-need-maximize = false
     1845         .
     1846       end.
     1847       else do:
     1848         run diasize_change-width in this-procedure
     1849           (input v-diasize-orig-frame-width
     1850               - frame Dialog-Frame :width-chars
     1851           ,input true
     1852           ) .
     1853         run diasize_change-height in this-procedure
     1854           (input v-diasize-orig-frame-height
     1855               - frame Dialog-Frame :height-chars
     1856           ,input true
     1857           ) .
     1858         assign
     1859           v-diasize-need-maximize = true
     1860         .
     1861       end.
     1862     end.
     1863   end procedure.
     1864   procedure diasize_restore-orig-size :
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       assign
     1869         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1870         v-diasize-current-frame-height = frame Dialog-Frame :height
     1871       .
     1872       run diasize_set-height in this-procedure
     1873         (input  v-diasize-orig-frame-height
     1874         ,input  true
     1875         ) .
     1876       run diasize_set-width in this-procedure
     1877         (input  v-diasize-orig-frame-width
     1878         ,input  true
     1879         ) .
     1880     end.
     1881   end procedure.
     1882   procedure diasize_restore-current-size :
     1883     do
     1884     on error undo, return error return-value
     1885     :
     1886       run diasize_set-height in this-procedure
     1887         (input  v-diasize-current-frame-height
     1888         ,input  true
     1889         ) .
     1890       run diasize_set-width in this-procedure
     1891         (input  v-diasize-current-frame-width
     1892         ,input  true
     1893         ) .
     1894     end.
     1895   end procedure.
     1896   procedure diasize_set-browse-handle :
     1897     define input  parameter p-browse-handle as handle   no-undo .
     1898     define buffer buf_temp-browse-handle for temp-browse-handle .
     1899     do
     1900     on error undo, return error return-value
     1901     :
     1902       assign
     1903         v-diasize-browse-handle = p-browse-handle
     1904       .
     1905       for each buf_temp-browse-handle
     1906       on error undo, return error return-value
     1907       :
     1908         delete buf_temp-browse-handle .
     1909       end.
     1910     end.
     1911   end procedure.
     1912   procedure diasize_add_browse :
     1913     define input  parameter p-browse-type   as character no-undo .
     1914     define input  parameter p-browse-handle as handle    no-undo .
     1915     define buffer buf_temp-browse-handle for temp-browse-handle .
     1916     do
     1917     on error undo, return error return-value
     1918     :
     1919       assign
     1920         v-diasize-browse-number = v-diasize-browse-number + 1
     1921       .
     1922       create buf_temp-browse-handle .
     1923       assign
     1924         buf_temp-browse-handle.browse-type   = p-browse-type
     1925         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1926         buf_temp-browse-handle.browse-handle = p-browse-handle
     1927       .
     1928     end.
     1929   end procedure.
     1930   procedure diasize_init :
     1931     define variable v-default-value    as logical   no-undo .
     1932     define variable v-restore-saved    as logical   no-undo .
     1933     define variable v-resize-value-str as character no-undo .
     1934     do
     1935     on error undo, return error return-value
     1936     :
     1937       do with frame Dialog-Frame
     1938       :
     1939         assign
     1940           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1941           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1942           v-diasize-browse-handle     = browse br-c-schet-fact-doc :handle
     1943         .
     1944         create button v-diasize-resize-button
     1945         assign
     1946           parent        = frame Dialog-Frame :first-child
     1947           label         = "s"
     1948           height-pixels = 16
     1949           width-pixels  = 16
     1950           visible       = true
     1951           sensitive     = true
     1952           movable       = true
     1953           triggers:
     1954             on end-move persistent run diasize_end-move in this-procedure .
     1955           end triggers.
     1956         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1957         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1958         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1959         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1960         assign
     1961           v-diasize-wndmax = false
     1962         .
     1963         if connected("ub") = true
     1964         then do:
     1965           define variable v-cntxt-db-num        as integer   no-undo .
     1966           define variable v-cntxt-userid        as character no-undo .
     1967           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1968                                             , OUTPUT v-cntxt-userid
     1969                                             ) .
     1970           run gbl/wndpar_r.p
     1971             (input  v-cntxt-db-num
     1972             ,input  v-cntxt-userid
     1973             ,input  'wndmax':U
     1974             ,output v-diasize-wndmax
     1975             ,output v-default-value
     1976             ) .
     1977         end.
     1978         assign
     1979           v-diasize-wndstore = false
     1980         .
     1981         if connected("ub") = true
     1982         then do:
     1983           run gbl/wndpar_r.p
     1984             (input  v-cntxt-db-num
     1985             ,input  v-cntxt-userid
     1986             ,input  'wndstore':U
     1987             ,output v-diasize-wndstore
     1988             ,output v-default-value
     1989             ) .
     1990         end.
     1991         assign
     1992           v-diasize-proc-name = entry(1, program-name(2), '.')
     1993         .
     1994         if v-diasize-wndstore = true
     1995         then do:
     1996           assign
     1997             v-restore-saved = false
     1998           .
     1999           if connected("ub") = true
     2000           then do:
     2001             run gbl/wndsizer.p
     2002               (input  v-cntxt-db-num
     2003               ,input  v-cntxt-userid
     2004               ,input  v-diasize-proc-name
     2005               ,input  'height':u
     2006               ,output v-resize-value-str
     2007               ) .
     2008             if v-resize-value-str <> '':U
     2009             then do:
     2010               run diasize_change-height in this-procedure
     2011                 (input  integer(v-resize-value-str)
     2012                 ,input  true
     2013                 ) .
     2014               assign
     2015                 v-restore-saved = true
     2016               .
     2017             end.
     2018           end.
     2019           if connected("ub") = true
     2020           then do:
     2021             run gbl/wndsizer.p
     2022               (input  v-cntxt-db-num
     2023               ,input  v-cntxt-userid
     2024               ,input  v-diasize-proc-name
     2025               ,input  'width':u
     2026               ,output v-resize-value-str
     2027               ) .
     2028             if v-resize-value-str <> '':U
     2029             then do:
     2030               run diasize_change-width in this-procedure
     2031                 (input  integer(v-resize-value-str)
     2032                 ,input  true
     2033                 ) .
     2034               assign
     2035                 v-restore-saved = true
     2036               .
     2037             end.
     2038           end.
     2039           if v-restore-saved <> true
     2040           then do:
     2041             if v-diasize-wndmax = true
     2042             then do:
     2043               run diasize_maximize in this-procedure
     2044                 (input  true
     2045                 ) .
     2046             end.
     2047           end.
     2048         end.
     2049         else do:
     2050           if v-diasize-wndmax = true
     2051           then do:
     2052             run diasize_maximize in this-procedure
     2053               (input  true
     2054               ) .
     2055           end.
     2056         end.
     2057       end.
     2058     end.
     2059   end procedure.
     2060   procedure diasize_need-full-display :
     2061     define output parameter p-need-full-display as logical   no-undo .
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       assign
     2066         p-need-full-display = v-diasize-need-full-display
     2067       .
     2068       assign
     2069         v-diasize-need-full-display = false
     2070       .
     2071     end.
     2072   end procedure.
     2073   procedure get-context :
     2074      define output parameter p-db-num as integer          no-undo.
     2075      define output parameter p-user-id as character        no-undo.
     2076      define variable v-login               as character    no-undo.
     2077      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2078      define buffer buf_user-login  for ub.user-login .
     2079      do
     2080      on error undo, return error
     2081      :
     2082            FIND FIRST buf_sys-ctrl no-lock.
     2083            ASSIGN
     2084               v-login = USERID("ub")
     2085               p-db-num = buf_sys-ctrl.db-num
     2086            .
     2087            FIND FIRST buf_user-login
     2088                 WHERE buf_user-login.db-num = p-db-num
     2089                   AND buf_user-login.user-login = v-login
     2090                 no-lock
     2091                 no-error
     2092                 .
     2093            IF AVAILABLE buf_user-login
     2094            THEN DO:
     2095               assign
     2096                  p-user-id = buf_user-login.user-id
     2097               .
     2098            END.
     2099      end.
     2100   end procedure.
     2101       run diasize_init in this-procedure .
     2102   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2103   procedure set-filter-name :
     2104   define input parameter p-filter-name as character no-undo .
     2105     do with frame Dialog-Frame:
     2106       if p-filter-name > "" then do:
     2107         assign
     2108           frame Dialog-Frame:title
     2109             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2110         .
     2111         assign
     2112           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2113         .
     2114       end.
     2115       else do:
     2116         assign
     2117           b-sch :tooltip = ""
     2118         .
     2119       end.
     2120     end.
     2121   end procedure.
     2122   def var sort-labelbr-c-schet-fact-doc   as character no-undo .
     2123   def var sort-clmnbr-c-schet-fact-doc    as handle    no-undo .
     2124   def var cur-clmnbr-c-schet-fact-doc     as handle    no-undo .
     2125   def var cur-clmn-locbr-c-schet-fact-doc as integer   no-undo .
     2126   def var re-querybr-c-schet-fact-doc     as logical   initial no no-undo .
     2127   on start-search, ctrl-o of br-c-schet-fact-doc in frame Dialog-Frame do:
     2128      run sort-brbr-c-schet-fact-doc
     2129        (input (if available X_c-schet-fact-doc
     2130                then recid(X_c-schet-fact-doc)
     2131                else ?
     2132               )
     2133        ).
     2134   end.
     2135   PROCEDURE sort-brbr-c-schet-fact-doc :
     2136     define input parameter p-recid as recid no-undo .
     2137     if re-querybr-c-schet-fact-doc = no then do:
     2138       assign
     2139          cur-clmnbr-c-schet-fact-doc = br-c-schet-fact-doc:current-column in frame Dialog-Frame
     2140       .
     2141       if sort-clmnbr-c-schet-fact-doc <> ? then sort-clmnbr-c-schet-fact-doc:column-fgcolor = 0.
     2142       if cur-clmnbr-c-schet-fact-doc = sort-clmnbr-c-schet-fact-doc then do:
     2143         assign
     2144            sort-labelbr-c-schet-fact-doc = ""
     2145            sort-clmnbr-c-schet-fact-doc = ?
     2146         .
     2147        end.
     2148        else do:
     2149          assign
     2150            sort-labelbr-c-schet-fact-doc = cur-clmnbr-c-schet-fact-doc:label
     2151            sort-clmnbr-c-schet-fact-doc  = cur-clmnbr-c-schet-fact-doc
     2152            sort-clmnbr-c-schet-fact-doc:column-fgcolor = 4
     2153          .
     2154        end.
     2155      end.
     2156     assign
     2157       cur-clmn-locbr-c-schet-fact-doc = 1
     2158     .
     2159     def var column-handle as handle no-undo .
     2160     column-handle = br-c-schet-fact-doc:first-column.
     2161     do while valid-handle(column-handle) :
     2162       if column-handle = cur-clmnbr-c-schet-fact-doc then do:
     2163         leave .
     2164       end.
     2165       column-handle = column-handle:NEXT-COLUMN.
     2166       assign
     2167         cur-clmn-locbr-c-schet-fact-doc = cur-clmn-locbr-c-schet-fact-doc + 1
     2168       .
     2169     end.
     2170     case sort-labelbr-c-schet-fact-doc:
     2171           when X_c-schet-fact-doc.doc-code:label in browse br-c-schet-fact-doc then DO:    assign       sort-column-name = "X_c-schet-fact-doc.doc-code"     .     run OpenBr(yes, no, no).   . END.
     2172       otherwise do:
     2173         assign
     2174           sort-column-name = ""
     2175         .
     2176         run OpenBr(yes, no, no).
     2177         if sort-labelbr-c-schet-fact-doc <> "" then do:
     2178           assign
     2179             cur-clmnbr-c-schet-fact-doc:column-fgcolor = 0
     2180           .
     2181         end.
     2182         assign
     2183           cur-clmn-locbr-c-schet-fact-doc = ?
     2184         .
     2185       end.
     2186     end case.
     2187     if p-recid <> ? then do:
     2188       reposition br-c-schet-fact-doc to recid p-recid no-error.
     2189       apply "value-changed" to br-c-schet-fact-doc in frame Dialog-Frame.
     2190     end.
     2191     apply "entry" to br-c-schet-fact-doc in frame Dialog-Frame.
     2192   END PROCEDURE.
     2193   procedure re-open-query-srt-clmnbr-c-schet-fact-doc:
     2194   if cur-clmnbr-c-schet-fact-doc = ? then do:
     2195      run OpenBr(yes, no, no).
     2196   end.
     2197   else do:
     2198      assign re-querybr-c-schet-fact-doc = yes.
     2199      run sort-brbr-c-schet-fact-doc
     2200        (input (if available X_c-schet-fact-doc
     2201                then recid(X_c-schet-fact-doc)
     2202                else ?
     2203               )
     2204        ).
     2205      assign re-querybr-c-schet-fact-doc = no.
     2206   end.
     2207   end.
     2208   MAIN-BLOCK:
     2209   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2210      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2211   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2212     run mainmenu_getcntxt in parparentproc
     2213       (output v-cntxt-db-num
     2214       ,output v-cntxt-userid
     2215       ,output v-cntxt-level
     2216       ,output v-cntxt-host-code-obj
     2217       ,output v-cntxt-obj-type
     2218       ,output v-cntxt-obj-code
     2219       ,output v-cntxt-db-num-obj
     2220       ,output v-cntxt-is-admin
     2221       ) .
     2222     find first X_schet-fact-doc no-lock  where X_schet-fact-doc.host-code = p-host-code and X_schet-fact-doc.doc-code = p-doc-code no-error .
     2223     if not available X_schet-fact-doc then do:
     2224       message
     2225         vss-workfile vss-revision vss-description skip
     2226         "Неверное значение параметра вызова p-host-code и/или p-doc-code"  p-host-code p-doc-code
     2227       view-as alert-box ERROR.
     2228       return.
     2229     end.
     2230     assign
     2231       br-c-schet-fact-doc:num-locked-columns = 1
     2232       X_c-schet-fact-doc.doc-code:read-only in browse br-c-schet-fact-doc = yes
     2233     .
     2234     find first ub.clients no-lock where ub.clients.obj-code = p-host-code and ub.clients.obj-type = 'орг':U .
     2235     title0 = "Список истории счетов-фактур" + chr(32)  + substitute(" Фирма: (&1) &2 Cчет-фактура : &3 от &4", p-host-code, ub.clients.obj-name,  X_schet-fact-doc.doc-code, string(X_schet-fact-doc.doc-date,"99/99/9999")) .
     2236     RUN MyEnable.
     2237     DISABLE
     2238       b-sel   when  NOT can-do( bttns, "b-sel" )
     2239       b-mark  when  NOT can-do( bttns, "b-mark")
     2240     WITH FRAME Dialog-Frame.
     2241     RUn OpenBR(yes, no, '':U).
     2242     HIDE mark-num in frame Dialog-Frame .
     2243     if p-rid-list <> "":U then assign v-doc-rec = integer(entry(1, p-rid-list)) .
     2244     WAIT-FOR GO OF FRAME Dialog-Frame.
     2245   END.
     2246   RUN disable_UI.
     2247   PROCEDURE disable_UI :
     2248     HIDE FRAME Dialog-Frame.
     2249   END PROCEDURE.
     2250   PROCEDURE enable_UI :
     2251     DISPLAY mark-num      WITH FRAME Dialog-Frame.
     2252     ENABLE b-quit b-sel B-lookup B-sch B-Help br-c-schet-fact-doc BR-changes mark-num    WITH FRAME Dialog-Frame.
     2253     VIEW FRAME Dialog-Frame.
     2254   END PROCEDURE.
     2255   PROCEDURE MyEnable :
     2256     DISPLAY mark-num WITH FRAME Dialog-Frame.
     2257     ENABLE  b-quit  B-lookup  b-sel  B-mark  B-sch  B-Help  mark-num  br-c-schet-fact-doc  BR-changes WITH FRAME Dialog-Frame.
     2258     VIEW FRAME Dialog-Frame.
     2259   END PROCEDURE.
     2260   PROCEDURE OpenBr :
     2261     define input  parameter p-open-query     as logical   no-undo .
     2262     define input  parameter p-find-next      as logical   no-undo .
     2263     define input  parameter p-find-condition as character no-undo .
     2264     define variable l-query-was-opened as logical no-undo .
     2265     define variable sort-column-phrase as character no-undo .
     2266     case sort-column-name :
     2267       when "" then assign sort-column-phrase = ""  .
     2268       otherwise    assign sort-column-phrase = "by " + sort-column-name  .
     2269     end case.
     2270     define variable l-open-query as logical   no-undo .
     2271     filter-point = filter-point0 .
     2272     ASSIGN frame Dialog-Frame:TITLE = title0 .
     2273   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2274   define variable  l-disable-where-15  as logical   no-undo .
     2275   define variable  l-filter-open-15    as logical   .
     2276   define variable  flt-rec-15       as recid     no-undo .
     2277   define variable  filter-name-15      as character no-undo .
     2278   define variable  where-phrase-15     as character no-undo .
     2279   define variable  sort-phrase-15      as character no-undo .
     2280   define variable  where-phrase-rus-15 as character no-undo .
     2281   define variable  sort-phrase-rus-15  as character no-undo .
     2282   run gbl/flt-get.p
     2283     (input filter-point
     2284     ,output flt-rec-15
     2285     ,output filter-name-15
     2286     ,output where-phrase-15
     2287     ,output sort-phrase-15
     2288     ,output where-phrase-rus-15
     2289     ,output sort-phrase-rus-15
     2290     ).
     2291   if p-open-query then do:
     2292       run set-filter-name in this-procedure
     2293         (INPUT filter-name-15
     2294         ) no-error .
     2295     assign
     2296       l-filter-open-15 = false
     2297     .
     2298     if flt-rec-15 <> ?
     2299       or sort-column-phrase > ""
     2300     then do:
     2301       define variable  parameter-2-15 as character no-undo .
     2302       define variable  parameter-3-15 as character no-undo .
     2303       define variable  parameter-4-15 as character no-undo .
     2304       define variable  parameter-5-15 as character no-undo .
     2305       define variable  parameter-6-15 as character no-undo .
     2306       define variable  parameter-7-15 as character no-undo .
     2307         assign
     2308         parameter-3-15 =
     2309                                 "FOR EACH X_c-schet-fact-doc"
     2310         parameter-4-15 =
     2311           (
     2312             if (" X_c-schet-fact-doc.host-code = p-host-code AND X_c-schet-fact-doc.doc-code  = p-doc-code " + " " + where-phrase-15) <> ""
     2313             then  substitute(' X_c-schet-fact-doc.host-code = &1 AND X_c-schet-fact-doc.doc-code = &3&2&3 ', p-host-code, p-doc-code, chr(34))  + " " + where-phrase-15
     2314             else "true"
     2315           )
     2316         parameter-5-15 = (" " + "" + " " + "")
     2317         parameter-6-15 = if sort-phrase-15 = ''
     2318                              then
     2319           (
     2320           " " + "  " +
     2321             " " + sort-column-phrase +
     2322           " " + "  "
     2323           )
     2324                              else
     2325           (
     2326           " " + "  " +
     2327             " " + sort-column-phrase +
     2328           " " + sort-phrase-15
     2329           )
     2330         parameter-7-15 =
     2331           " indexed-reposition  "
     2332       .
     2333       do
     2334       on stop undo, leave
     2335       on error undo, leave
     2336       :
     2337         assign
     2338           l-disable-where-15 =
     2339             (" X_c-schet-fact-doc.host-code = p-host-code AND X_c-schet-fact-doc.doc-code  = p-doc-code " + " " + where-phrase-15 = "")
     2340         .
     2341         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2342                             ,input query br-c-schet-fact-doc:handle
     2343                             ,input parameter-3-15
     2344                             ,input parameter-4-15
     2345                             ,input parameter-5-15
     2346                             ,input parameter-6-15
     2347                             ,input parameter-7-15
     2348                             )
     2349         .
     2350         assign
     2351           l-filter-open-15 = true
     2352         .
     2353       end.
     2354       if l-filter-open-15 = false then do:
     2355         message
     2356           "Ошибка при фильтрации / сортировке" skip
     2357           "Будут показаны записи без учета фильтра" skip
     2358           view-as alert-box .
     2359       end.
     2360       else do:
     2361           assign
     2362             l-query-was-opened = true
     2363           .
     2364       end.
     2365     end.
     2366     if l-filter-open-15 = false then do:
     2367       OPEN QUERY br-c-schet-fact-doc FOR EACH X_c-schet-fact-doc
     2368         where  X_c-schet-fact-doc.host-code = p-host-code AND X_c-schet-fact-doc.doc-code  = p-doc-code
     2369         indexed-reposition
     2370     .
     2371         assign
     2372           l-query-was-opened = true
     2373         .
     2374     end.
     2375   end.
     2376   else do:
     2377     assign
     2378       v-doc-rec = recid( X_c-schet-fact-doc )
     2379     .
     2380     do
     2381     on stop undo, leave
     2382     on error undo, leave
     2383     :
     2384       if query br-c-schet-fact-doc:handle:get-buffer-handle(1) = (buffer X_c-schet-fact-doc:handle) then do:
     2385         assign
     2386         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2387         parameter-4-15 =
     2388           "where ":u +  substitute(' X_c-schet-fact-doc.host-code = &1 AND X_c-schet-fact-doc.doc-code = &3&2&3 ', p-host-code, p-doc-code, chr(34))  + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2389         parameter-5-15 = "  "
     2390       .
     2391         run fltopend_fltfindd in this-procedure  (
     2392                             input this-procedure:handle
     2393                             ,input query br-c-schet-fact-doc:handle
     2394                             ,input rowid(X_c-schet-fact-doc)
     2395                             ,input logical(parameter-2-15)
     2396                             ,input no-lock
     2397                             ,input (buffer X_c-schet-fact-doc:handle)
     2398                             ,input parameter-4-15
     2399                             ,input parameter-5-15
     2400                             ) no-error.
     2401         .
     2402         assign
     2403           v-doc-rec = integer(return-value)
     2404           v-fltopend-rowid[1] = ?
     2405         .
     2406       end.
     2407       else do:
     2408         assign
     2409         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2410         parameter-3-15 =  "FOR EACH X_c-schet-fact-doc"
     2411         parameter-4-15 =
     2412           (
     2413             if (" X_c-schet-fact-doc.host-code = p-host-code AND X_c-schet-fact-doc.doc-code  = p-doc-code " + " " + where-phrase-15) <> ""
     2414             then  substitute(' X_c-schet-fact-doc.host-code = &1 AND X_c-schet-fact-doc.doc-code = &3&2&3 ', p-host-code, p-doc-code, chr(34))  + " " + where-phrase-15
     2415             else "true"
     2416           )
     2417         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     2418         parameter-6-15 = if sort-phrase-15 = ''
     2419                              then
     2420           (
     2421           " " + "  " +
     2422             " " + sort-column-phrase +
     2423           " " + "  "
     2424           )
     2425                              else
     2426           (
     2427           " " + "  " +
     2428             " " + sort-column-phrase +
     2429           " " + sort-phrase-15
     2430           )
     2431         parameter-7-15 =
     2432           " indexed-reposition  "
     2433       .
     2434         run fltopend_fltfindq in this-procedure  (
     2435                             input this-procedure:handle
     2436                             ,input query br-c-schet-fact-doc:handle
     2437                             ,input logical(parameter-2-15)
     2438                             ,input no-lock
     2439                             ,input parameter-3-15
     2440                             ,input parameter-4-15
     2441                             ,input parameter-5-15
     2442                             ,input parameter-6-15
     2443                             ,input parameter-7-15
     2444                             ,output v-fltopend-rowid
     2445                             ) no-error.
     2446         .
     2447         v-doc-rec = ?.
     2448       end.
     2449       assign
     2450         l-query-was-opened = true
     2451       .
     2452     end.
     2453   end.
     2454     REPOSITION br-c-schet-fact-doc to recid v-doc-rec No-ERROR.
     2455     if error-status:error then REPOSITION br-c-schet-fact-doc to row 1 No-ERROR.
     2456     else  REPOSITION br-c-schet-fact-doc to row 7 No-ERROR.
     2457     run proc-view-changes in this-procedure no-error.
     2458   END PROCEDURE.
     2459   PROCEDURE proc-view-changes :
     2460     define buffer new_c-schet-fact-doc for ub.c-schet-fact-doc.
     2461     define buffer current_schet-fact-doc for ub.schet-fact-doc.
     2462     define variable v-chg-fields as character no-undo.
     2463     define variable v-old-fields as character no-undo.
     2464     define variable v-new-fields as character no-undo.
     2465     define variable ii as integer no-undo.
     2466     for each temp-changes:  delete temp-changes.  END.
     2467     find first new_c-schet-fact-doc no-lock
     2468       where new_c-schet-fact-doc.host-code     = X_c-schet-fact-doc.host-code
     2469         and new_c-schet-fact-doc.doc-code = X_c-schet-fact-doc.doc-code
     2470         and new_c-schet-fact-doc.chip-num      > X_c-schet-fact-doc.chip-num
     2471       no-error.
     2472     if not available new_c-schet-fact-doc then do:
     2473       find first current_schet-fact-doc no-lock
     2474         where current_schet-fact-doc.host-code = X_c-schet-fact-doc.host-code
     2475          and current_schet-fact-doc.doc-code = x_c-schet-fact-doc.doc-code
     2476       no-error.
     2477       if not available current_schet-fact-doc then return error.
     2478       buffer-compare current_schet-fact-doc to X_c-schet-fact-doc save result in v-chg-fields.
     2479     end.
     2480     else do:
     2481       buffer-compare new_c-schet-fact-doc except chip-num corr-date corr-time corr-user-name corr-user-db-num to X_c-schet-fact-doc save result in v-chg-fields.
     2482     end.
     2483       do ii = 1 to num-entries(v-chg-fields):
     2484       CASE entry(ii, v-chg-fields):
     2485                     when "doc-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "doc-code":U     temp-changes.l_name = "Номер"     temp-changes.v_old = string(X_c-schet-fact-doc.doc-code)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.doc-code)                               else string(current_schet-fact-doc.doc-code))     .     end.
     2486                     when "contract-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "contract-code":U     temp-changes.l_name = "Код договора"     temp-changes.v_old = string(X_c-schet-fact-doc.contract-code)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.contract-code)                               else string(current_schet-fact-doc.contract-code))     .     end.
     2487                     when "doc-date":U then do:     create temp-changes.     assign     temp-changes.f_name = "doc-date":U     temp-changes.l_name = "Дата"     temp-changes.v_old = string(X_c-schet-fact-doc.doc-date)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.doc-date)                               else string(current_schet-fact-doc.doc-date))     .     end.
     2488                     when "ext-doc-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "ext-doc-type":U     temp-changes.l_name = "Тип"     temp-changes.v_old = string(X_c-schet-fact-doc.ext-doc-type)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.ext-doc-type)                               else string(current_schet-fact-doc.ext-doc-type))     .     end.
     2489                     when "status_":U then do:     create temp-changes.     assign     temp-changes.f_name = "status_":U     temp-changes.l_name = "Статус"     temp-changes.v_old = string(X_c-schet-fact-doc.status_)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.status_)                               else string(current_schet-fact-doc.status_))     .     end.
     2490                     when "curr-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "curr-code":U     temp-changes.l_name = "Код валюты"     temp-changes.v_old = string(X_c-schet-fact-doc.curr-code)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.curr-code)                               else string(current_schet-fact-doc.curr-code))     .     end.
     2491                     when "own-name":U then do:     create temp-changes.     assign     temp-changes.f_name = "own-name":U     temp-changes.l_name = "Фирма"     temp-changes.v_old = string(X_c-schet-fact-doc.own-name)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.own-name)                               else string(current_schet-fact-doc.own-name))     .     end.
     2492                     when "own-address":U then do:     create temp-changes.     assign     temp-changes.f_name = "own-address":U     temp-changes.l_name = "Фирма - Адрес"     temp-changes.v_old = string(X_c-schet-fact-doc.own-address)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.own-address)                               else string(current_schet-fact-doc.own-address))     .     end.
     2493                     when "own-inn":U then do:     create temp-changes.     assign     temp-changes.f_name = "own-inn":U     temp-changes.l_name = "Фирма - ИНН"     temp-changes.v_old = string(X_c-schet-fact-doc.own-inn)     temp-changes.v_new = (if available new_c-schet-fact-doc                               then string(new_c-schet-fact-doc.own-inn)                               else string(current_schet-fact-doc.own-inn))     .     end.
