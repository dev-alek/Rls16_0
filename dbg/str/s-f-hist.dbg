      788     run fltfield-add in this-procedure('user-db-num', '', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      789     run fltfield-add in this-procedure('user-name', '', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      790     run fltfield-add in this-procedure('sys-date', 'Сист. дата', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      791     run fltfield-add in this-procedure('sys-time', 'Сист. время', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      792     run fltfield-add in this-procedure('fact-date', '', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      793     run fltfield-add in this-procedure('fact-time', '', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      794     run fltfield-add in this-procedure('fact-user-db-num', 'Польз. база факт', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      795     run fltfield-add in this-procedure('fact-user-name', 'Польз. факт', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      796     run fltfield-add in this-procedure('sum-rubl', 'сумма руб', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      797     run fltfield-add in this-procedure('sum-base', 'сумма б.в.', '',   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      798   Filter-Block:
      799     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
      800        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
      801        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
