     3345         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3346                     - 1
     3347                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3348       .
     3349       view v-diasize-resize-button .
     3350     end.
     3351   end procedure.
     3352   on alt-right anywhere
     3353   do:
     3354     run diasize_change-width in this-procedure
     3355       (input 1
     3356       ,input true
     3357       ) .
     3358     return no-apply .
     3359   end.
     3360   on alt-left anywhere
     3361   do:
     3362     run diasize_change-width in this-procedure
     3363       (input -1
     3364       ,input true
     3365       ) .
     3366     return no-apply .
     3367   end.
     3368   on alt-down anywhere
     3369   do:
     3370     run diasize_change-height in this-procedure
     3371       (input 1
     3372       ,input true
     3373       ) .
     3374     return no-apply .
     3375   end.
     3376   on alt-up anywhere
     3377   do:
     3378     run diasize_change-height in this-procedure
     3379       (input -1
     3380       ,input true
     3381       ) .
     3382     return no-apply .
     3383   end.
     3384   on alt-enter of frame Dialog-Frame
     3385   do:
     3386     run diasize_maximize in this-procedure
     3387       (input  ?
     3388       ).
     3389     return no-apply .
     3390   end.
     3391   procedure diasize_end-move :
     3392     do
     3393     on error undo, return error return-value
     3394     :
     3395       define variable v-row-delta as decimal   no-undo .
     3396       define variable v-col-delta as decimal   no-undo .
     3397       define variable v-new-row as decimal   no-undo .
     3398       define variable v-new-col as decimal   no-undo .
     3399       assign
     3400         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3401         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3402       .
     3403       assign
     3404         v-row-delta = v-new-row - frame Dialog-Frame :height
     3405         v-col-delta = v-new-col - frame Dialog-Frame :width
     3406       .
     3407       run diasize_change-height in this-procedure
     3408         (input v-row-delta
     3409         ,input true
     3410         ) .
     3411       run diasize_change-width in this-procedure
     3412         (input v-col-delta
     3413         ,input true
     3414         ) .
     3415     end.
     3416   end procedure.
     3417   procedure diasize_maximize :
     3418     define input  parameter p-action as logical   no-undo .
     3419     do
     3420     on error undo, return error return-value
     3421     :
     3422       if p-action = ?
     3423       then do:
     3424         if v-diasize-need-maximize = true
     3425         then do:
     3426           assign
     3427             p-action = true
     3428           .
     3429         end.
     3430         else do:
     3431           assign
     3432             p-action = false
     3433           .
     3434         end.
     3435       end.
     3436       if p-action = true
     3437       then do:
     3438         run diasize_change-height in this-procedure
     3439           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3440               - frame Dialog-Frame :height-chars
     3441           ,input true
     3442           ) .
     3443         run diasize_change-width in this-procedure
     3444           (input session :width-chars
     3445               - frame Dialog-Frame :width-chars
     3446           ,input true
     3447           ) .
     3448         assign
     3449           v-diasize-need-maximize = false
     3450         .
     3451       end.
     3452       else do:
     3453         run diasize_change-width in this-procedure
     3454           (input v-diasize-orig-frame-width
     3455               - frame Dialog-Frame :width-chars
     3456           ,input true
     3457           ) .
     3458         run diasize_change-height in this-procedure
     3459           (input v-diasize-orig-frame-height
     3460               - frame Dialog-Frame :height-chars
     3461           ,input true
     3462           ) .
     3463         assign
     3464           v-diasize-need-maximize = true
     3465         .
     3466       end.
     3467     end.
     3468   end procedure.
     3469   procedure diasize_restore-orig-size :
     3470     do
     3471     on error undo, return error return-value
     3472     :
     3473       assign
     3474         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3475         v-diasize-current-frame-height = frame Dialog-Frame :height
     3476       .
     3477       run diasize_set-height in this-procedure
     3478         (input  v-diasize-orig-frame-height
     3479         ,input  true
     3480         ) .
     3481       run diasize_set-width in this-procedure
     3482         (input  v-diasize-orig-frame-width
     3483         ,input  true
     3484         ) .
     3485     end.
     3486   end procedure.
     3487   procedure diasize_restore-current-size :
     3488     do
     3489     on error undo, return error return-value
     3490     :
     3491       run diasize_set-height in this-procedure
     3492         (input  v-diasize-current-frame-height
     3493         ,input  true
     3494         ) .
     3495       run diasize_set-width in this-procedure
     3496         (input  v-diasize-current-frame-width
     3497         ,input  true
     3498         ) .
     3499     end.
     3500   end procedure.
     3501   procedure diasize_set-browse-handle :
     3502     define input  parameter p-browse-handle as handle   no-undo .
     3503     define buffer buf_temp-browse-handle for temp-browse-handle .
     3504     do
     3505     on error undo, return error return-value
     3506     :
     3507       assign
     3508         v-diasize-browse-handle = p-browse-handle
     3509       .
     3510       for each buf_temp-browse-handle
     3511       on error undo, return error return-value
     3512       :
     3513         delete buf_temp-browse-handle .
     3514       end.
     3515     end.
     3516   end procedure.
     3517   procedure diasize_add_browse :
     3518     define input  parameter p-browse-type   as character no-undo .
     3519     define input  parameter p-browse-handle as handle    no-undo .
     3520     define buffer buf_temp-browse-handle for temp-browse-handle .
     3521     do
     3522     on error undo, return error return-value
     3523     :
     3524       assign
     3525         v-diasize-browse-number = v-diasize-browse-number + 1
     3526       .
     3527       create buf_temp-browse-handle .
     3528       assign
     3529         buf_temp-browse-handle.browse-type   = p-browse-type
     3530         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3531         buf_temp-browse-handle.browse-handle = p-browse-handle
     3532       .
     3533     end.
     3534   end procedure.
     3535   procedure diasize_init :
     3536     define variable v-default-value    as logical   no-undo .
     3537     define variable v-restore-saved    as logical   no-undo .
     3538     define variable v-resize-value-str as character no-undo .
     3539     do
     3540     on error undo, return error return-value
     3541     :
     3542       do with frame Dialog-Frame
     3543       :
     3544         assign
     3545           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3546           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3547           v-diasize-browse-handle     = browse BROWSE-1 :handle
     3548         .
     3549         create button v-diasize-resize-button
     3550         assign
     3551           parent        = frame Dialog-Frame :first-child
     3552           label         = "s"
     3553           height-pixels = 16
     3554           width-pixels  = 16
     3555           visible       = true
     3556           sensitive     = true
     3557           movable       = true
     3558           triggers:
     3559             on end-move persistent run diasize_end-move in this-procedure .
     3560           end triggers.
     3561         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3562         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3563         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3564         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3565         assign
     3566           v-diasize-wndmax = false
     3567         .
     3568         if connected("ub") = true
     3569         then do:
     3570           define variable v-cntxt-db-num        as integer   no-undo .
     3571           define variable v-cntxt-userid        as character no-undo .
     3572           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3573                                             , OUTPUT v-cntxt-userid
     3574                                             ) .
     3575           run gbl/wndpar_r.p
     3576             (input  v-cntxt-db-num
     3577             ,input  v-cntxt-userid
     3578             ,input  'wndmax':U
     3579             ,output v-diasize-wndmax
     3580             ,output v-default-value
     3581             ) .
     3582         end.
     3583         assign
     3584           v-diasize-wndstore = false
     3585         .
     3586         if connected("ub") = true
     3587         then do:
     3588           run gbl/wndpar_r.p
     3589             (input  v-cntxt-db-num
     3590             ,input  v-cntxt-userid
     3591             ,input  'wndstore':U
     3592             ,output v-diasize-wndstore
     3593             ,output v-default-value
     3594             ) .
     3595         end.
     3596         assign
     3597           v-diasize-proc-name = entry(1, program-name(2), '.')
     3598         .
     3599         if v-diasize-wndstore = true
     3600         then do:
     3601           assign
     3602             v-restore-saved = false
     3603           .
     3604           if connected("ub") = true
     3605           then do:
     3606             run gbl/wndsizer.p
     3607               (input  v-cntxt-db-num
     3608               ,input  v-cntxt-userid
     3609               ,input  v-diasize-proc-name
     3610               ,input  'height':u
     3611               ,output v-resize-value-str
     3612               ) .
     3613             if v-resize-value-str <> '':U
     3614             then do:
     3615               run diasize_change-height in this-procedure
     3616                 (input  integer(v-resize-value-str)
     3617                 ,input  true
     3618                 ) .
     3619               assign
     3620                 v-restore-saved = true
     3621               .
     3622             end.
     3623           end.
     3624           if connected("ub") = true
     3625           then do:
     3626             run gbl/wndsizer.p
     3627               (input  v-cntxt-db-num
     3628               ,input  v-cntxt-userid
     3629               ,input  v-diasize-proc-name
     3630               ,input  'width':u
     3631               ,output v-resize-value-str
     3632               ) .
     3633             if v-resize-value-str <> '':U
     3634             then do:
     3635               run diasize_change-width in this-procedure
     3636                 (input  integer(v-resize-value-str)
     3637                 ,input  true
     3638                 ) .
     3639               assign
     3640                 v-restore-saved = true
     3641               .
     3642             end.
     3643           end.
     3644           if v-restore-saved <> true
     3645           then do:
     3646             if v-diasize-wndmax = true
     3647             then do:
     3648               run diasize_maximize in this-procedure
     3649                 (input  true
     3650                 ) .
     3651             end.
     3652           end.
     3653         end.
     3654         else do:
     3655           if v-diasize-wndmax = true
     3656           then do:
     3657             run diasize_maximize in this-procedure
     3658               (input  true
     3659               ) .
     3660           end.
     3661         end.
     3662       end.
     3663     end.
     3664   end procedure.
     3665   procedure diasize_need-full-display :
     3666     define output parameter p-need-full-display as logical   no-undo .
     3667     do
     3668     on error undo, return error return-value
     3669     :
     3670       assign
     3671         p-need-full-display = v-diasize-need-full-display
     3672       .
     3673       assign
     3674         v-diasize-need-full-display = false
     3675       .
     3676     end.
     3677   end procedure.
     3678   procedure get-context :
     3679      define output parameter p-db-num as integer          no-undo.
     3680      define output parameter p-user-id as character        no-undo.
     3681      define variable v-login               as character    no-undo.
     3682      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3683      define buffer buf_user-login  for ub.user-login .
     3684      do
     3685      on error undo, return error
     3686      :
     3687            FIND FIRST buf_sys-ctrl no-lock.
     3688            ASSIGN
     3689               v-login = USERID("ub")
     3690               p-db-num = buf_sys-ctrl.db-num
     3691            .
     3692            FIND FIRST buf_user-login
     3693                 WHERE buf_user-login.db-num = p-db-num
     3694                   AND buf_user-login.user-login = v-login
     3695                 no-lock
     3696                 no-error
     3697                 .
     3698            IF AVAILABLE buf_user-login
     3699            THEN DO:
     3700               assign
     3701                  p-user-id = buf_user-login.user-id
     3702               .
     3703            END.
     3704      end.
     3705   end procedure.
     3706       run diasize_init in this-procedure .
     3707   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3708   on ' ' of loc_pay-date in frame Dialog-Frame
     3709   do:
     3710     if (can-query (self, "sensitive")
     3711        and
     3712        self :sensitive = true
     3713        )
     3714     or (can-query (self, "read-only")
     3715        and
     3716        self :read-only = false
     3717        )
     3718     then do:
     3719       assign
     3720         self :screen-value = ?
     3721       .
     3722     end.
     3723     return no-apply.
     3724   end.
     3725   on delete-character of loc_pay-date in frame Dialog-Frame
     3726   do:
     3727     if (can-query (self, "sensitive")
     3728        and
     3729        self :sensitive = true
     3730        )
     3731     or (can-query (self, "read-only")
     3732        and
     3733        self :read-only = false
     3734        )
     3735     then do:
     3736       assign
     3737         self :screen-value = ?
     3738       .
     3739     end.
     3740     return no-apply.
     3741   end.
     3742   on ctrl-d of loc_pay-date in frame Dialog-Frame
     3743   do:
     3744     define variable v-curr-sv-date as date no-undo .
     3745     if (can-query (self, "sensitive")
     3746        and
     3747        self :sensitive = true
     3748        )
     3749     or (can-query (self, "read-only")
     3750        and
     3751        self :read-only = false
     3752        )
     3753     then do:
     3754       if self :handle <> focus :handle
     3755       then do:
     3756         apply "entry":u to self .
     3757       end.
     3758       run gbl/getcurdt.p
     3759         (output v-curr-sv-date
     3760         ) .
     3761       assign
     3762         self :screen-value = string(v-curr-sv-date) .
     3763       .
     3764     end.
     3765     return no-apply.
     3766   end.
     3767   on ctrl-b of loc_pay-date in frame Dialog-Frame
     3768   do:
     3769     if (can-query (self, "sensitive")
     3770        and
     3771        self :sensitive = true
     3772        )
     3773     or (can-query (self, "read-only")
     3774        and
     3775        self :read-only = false
     3776        )
     3777     then do:
     3778       if self :handle <> focus :handle
     3779       then do:
     3780         apply "entry":u to self .
     3781       end.
     3782       define variable v-curr-sv-date as date no-undo .
     3783       define variable v-new-sv-date  as date no-undo .
     3784       assign
     3785         v-curr-sv-date = date(self :screen-value) no-error
     3786       .
     3787       if v-curr-sv-date = ?
     3788       then do:
     3789         run gbl/getcurdt.p
     3790           (output v-curr-sv-date
     3791           ) .
     3792       end.
     3793       if v-curr-sv-date <> ?
     3794       then do:
     3795         assign
     3796           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3797         .
     3798         assign
     3799           self :screen-value = string(v-new-sv-date) .
     3800         .
     3801       end.
     3802     end.
     3803     return no-apply .
     3804   end.
     3805   on ctrl-e of loc_pay-date in frame Dialog-Frame
     3806   do:
     3807     if (can-query (self, "sensitive")
     3808        and
     3809        self :sensitive = true
     3810        )
     3811     or (can-query (self, "read-only")
     3812        and
     3813        self :read-only = false
     3814        )
     3815     then do:
     3816       if self :handle <> focus :handle
     3817       then do:
     3818         apply "entry":u to self .
     3819       end.
     3820       define variable v-curr-sv-date as date no-undo .
     3821       define variable v-new-sv-date  as date no-undo .
     3822       assign
     3823         v-curr-sv-date = date(self :screen-value) no-error
     3824       .
     3825       if v-curr-sv-date = ?
     3826       then do:
     3827         run gbl/getcurdt.p
     3828           (output v-curr-sv-date
     3829           ) .
     3830       end.
     3831       if v-curr-sv-date <> ?
     3832       then do:
     3833         run gbl/lastdate.p
     3834           (input  v-curr-sv-date
     3835           ,output v-new-sv-date
     3836           ).
     3837         assign
     3838           self :screen-value = string(v-new-sv-date) .
     3839         .
     3840       end.
     3841     end.
     3842     return no-apply .
     3843   end.
     3844   on ctrl-f of loc_pay-date in frame Dialog-Frame
     3845   do:
     3846     if (can-query (self, "sensitive")
     3847        and
     3848        self :sensitive = true
     3849        )
     3850     or (can-query (self, "read-only")
     3851        and
     3852        self :read-only = false
     3853        )
     3854     then do:
     3855       if self :handle <> focus :handle
     3856       then do:
     3857         apply "entry":u to self .
     3858       end.
     3859       define variable v-ok            as logical   no-undo .
     3860       define variable v-curr-sv-date  as date      no-undo .
     3861       define variable v-description   as character no-undo .
     3862       assign
     3863         v-curr-sv-date = date(self :screen-value) no-error
     3864       .
     3865       if v-curr-sv-date = ?
     3866       then do:
     3867         run gbl/getcurdt.p
     3868           (output v-curr-sv-date
     3869           ) .
     3870       end.
     3871       if v-curr-sv-date <> ?
     3872       then do:
     3873         run gbl/d-inpday.w
     3874           (input ?
     3875           ,input "Выбор даты"
     3876           ,input v-description
     3877           ,input ""
     3878           ,input-output v-curr-sv-date
     3879           ,output v-ok
     3880           ).
     3881         if v-ok = true
     3882         then do:
     3883           assign
     3884             self :screen-value = string(v-curr-sv-date) .
     3885           .
     3886         end.
     3887       end.
     3888     end.
     3889     return no-apply .
     3890   end.
     3891     define MENU m-ed-date12
     3892       MENU-ITEM m-ed-date12-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3893       MENU-ITEM m-ed-date12-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3894       MENU-ITEM m-ed-date12-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3895       MENU-ITEM m-ed-date12-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3896       .
     3897     if loc_pay-date :POPUP-MENU in frame Dialog-Frame = ?
     3898     then do:
     3899       ASSIGN
     3900         loc_pay-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date12 :HANDLE
     3901         loc_pay-date :MENU-MOUSE in frame Dialog-Frame = 3
     3902       .
     3903     end.
     3904     define variable v-label-handle12 as handle no-undo .
     3905     assign
     3906       v-label-handle12 = loc_pay-date :side-label-handle in frame Dialog-Frame
     3907     .
     3908     if valid-handle (v-label-handle12)
     3909     then do:
     3910       if v-label-handle12 :tooltip = ""
     3911       or v-label-handle12 :tooltip = ?
     3912       then do:
     3913         assign
     3914           v-label-handle12 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3915         .
     3916       end.
     3917     end.
     3918     ON CHOOSE OF MENU-ITEM m-ed-date12-1 in menu m-ed-date12 DO:
     3919       apply "ctrl-b":U to loc_pay-date in frame Dialog-Frame .
     3920     END.
     3921     ON CHOOSE OF MENU-ITEM m-ed-date12-2 in menu m-ed-date12 DO:
     3922       apply "ctrl-d":U to loc_pay-date in frame Dialog-Frame .
     3923     END.
     3924     ON CHOOSE OF MENU-ITEM m-ed-date12-3 in menu m-ed-date12 DO:
     3925       apply "ctrl-e":U to loc_pay-date in frame Dialog-Frame .
     3926     END.
     3927     ON CHOOSE OF MENU-ITEM m-ed-date12-4 in menu m-ed-date12 DO:
     3928       apply "ctrl-f":U to loc_pay-date in frame Dialog-Frame .
     3929     END.
     3930   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3931   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3932   next-prev = yes.
     3933   n-p: do while next-prev :
     3934   MAIN-BLOCK:
     3935   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3936      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3937   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3938     run mainmenu_getcntxt in parparentproc
     3939       (output v-cntxt-db-num
     3940       ,output v-cntxt-userid
     3941       ,output v-cntxt-level
     3942       ,output v-cntxt-host-code-obj
     3943       ,output v-cntxt-obj-type
     3944       ,output v-cntxt-obj-code
     3945       ,output v-cntxt-db-num-obj
     3946       ,output v-cntxt-is-admin
     3947       ) .
     3948      run init-p in this-procedure .
     3949        if ref-mode = 'ПРОСМОТР':U then do:
     3950           run myenable_lkp in this-procedure .
     3951           run hide-curr in this-procedure ( input "lookup":u ) .
     3952           wait-for go of frame Dialog-Frame focus b-exit.
     3953        end.
     3954        else do:
     3955           run myenable_chg.
     3956           if ref-mode = 'ДОБАВЛЕНИЕ':U
     3957               then do:
     3958                    run hide-curr ( input "init":u ) .
     3959                    wait-for go of frame Dialog-Frame focus loc_prn-doc-code .
     3960               end.
     3961               else do:
     3962                    run hide-curr ( input "pay":u ) .
     3963                    wait-for go of frame Dialog-Frame focus loc_contract-code .
     3964               end.
     3965      end.
     3966   END.
     3967   end.
     3968   RUN disable_UI.
     3969   PROCEDURE attr-bank :
     3970    do
     3971    on error undo, return error return-value
     3972    :
     3973   define input parameter p-cli-type as character no-undo .
     3974   define input parameter p-cli-code as integer no-undo .
     3975   define input parameter p-curr-code as integer no-undo .
     3976   define output parameter   p-bank-name   like ub.fin-bank.bank-name   no-undo .
     3977   define output parameter   p-bik         like ub.fin-bank.bik         no-undo .
     3978   define output parameter   p-c-schet     like ub.fin-schet.c-schet    no-undo .
     3979   define output parameter   p-r-schet     like ub.fin-schet.r-schet    no-undo .
     3980   define output parameter   p-code-schet  like ub.fin-schet.code-schet no-undo .
     3981   define variable v-rid-list as character no-undo.
     3982   define variable ref-rec as recid no-undo.
     3983   define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     3984   define buffer buf_fin-schet for ub.fin-schet .
     3985   define buffer buf_fin-bank for fin-bank.
     3986   run ref/finschts.w (
     3987                 INPUT parParentProc
     3988                 ,par-host-code
     3989                 ,input "b-sel":U
     3990                 ,input "cmp-host":U
     3991                 ,input p-cli-type
     3992                 ,input p-cli-code
     3993                 ,input p-curr-code
     3994                 ,input par-host-code
     3995                 ,input 0
     3996                 ,input-output v-status_
     3997                 ,input-output v-rid-list
     3998   ) no-error.
     3999   if v-rid-list = "" then   do:
     4000     return .
     4001   end.
     4002    ref-rec = integer( v-rid-list ).
     4003   FIND FIRST buf_fin-schet no-lock  WHERE
     4004         recid (buf_fin-schet) = ref-rec no-error .
     4005         if error-status :error then return.
     4006   if buf_fin-schet.curr-code <> p-curr-code then do:
     4007     message
     4008     "Валюта выбранного Вами счета"  "не совпадает с валютой платежа"
     4009     view-as alert-box information  .
     4010   end.
     4011   if buf_fin-schet.status_ <> 'тек':U then do:
     4012     message
     4013     "Статус выбранного Вами счета"  buf_fin-schet.status_ " - нельзя работать с таким счетом"
     4014     view-as alert-box error .
     4015     return error.
     4016   end.
     4017   find first buf_fin-bank no-lock where
     4018             buf_fin-bank.host-code = par-host-code
     4019         AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     4020     if available buf_fin-bank and available buf_fin-schet then
     4021     assign
     4022       p-bank-name =  buf_fin-bank.bank-name
     4023       p-bik       =  buf_fin-bank.bik
     4024       p-c-schet   =  buf_fin-schet.c-schet
     4025       p-r-schet   =  buf_fin-schet.r-schet
     4026       p-code-schet = buf_fin-schet.code-schet
     4027     .
     4028     end.
     4029   END PROCEDURE.
     4030   PROCEDURE attr-bank-code-schet :
     4031   do
     4032    on error undo, return error return-value
     4033    :
     4034   define input-output parameter par-code-schet as integer no-undo .
     4035   define input parameter par-code-schet-start as integer no-undo .
     4036   define output parameter par-bank-name as character no-undo .
     4037   define output parameter par-bik        like   fin-bank.bik       no-undo .
     4038   define output parameter par-c-schet    like   fin-schet.c-schet  no-undo .
     4039   define output parameter par-r-schet    like   fin-schet.r-schet  no-undo .
     4040   define buffer buf_fin-schet for fin-schet.
     4041   define buffer buf_fin-bank  for fin-bank.
     4042   FIND FIRST buf_fin-schet no-lock  WHERE
     4043         buf_fin-schet.code-schet = par-code-schet and
     4044         buf_fin-schet.host-code  = par-host-code  no-error .
     4045   if not available buf_fin-schet then do:
     4046       FIND FIRST buf_fin-schet no-lock  WHERE
     4047             buf_fin-schet.code-schet = par-code-schet-start and
     4048             buf_fin-schet.host-code  = par-host-code  no-error .
     4049     if error-status :error then return.
     4050   end.
     4051    par-code-schet = buf_fin-schet.code-schet .
     4052   find first buf_fin-bank no-lock where
     4053             buf_fin-bank.host-code = par-host-code
     4054         AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     4055     if available buf_fin-bank and available buf_fin-schet then
     4056     assign
     4057       par-bank-name =  buf_fin-bank.bank-name
     4058       par-bik       =  buf_fin-bank.bik
     4059       par-c-schet   =  buf_fin-schet.c-schet
     4060       par-r-schet   =  buf_fin-schet.r-schet
     4061       par-code-schet = buf_fin-schet.code-schet
     4062     .
     4063     end.
     4064   END PROCEDURE.
     4065   PROCEDURE attr-firm :
     4066   define input parameter p-cli-type as character no-undo .
     4067   define input parameter p-cli-code as integer no-undo .
     4068   define output parameter p-inn  like ub.firm.inn no-undo .
     4069   define output parameter p-kpp  like ub.firm.kpp no-undo .
     4070   define output parameter p-okpo like ub.firm.okpo no-undo .
     4071   define buffer buf_firm   for firm .
     4072   define buffer buf_person for person .
     4073    do
     4074    on error undo, return error return-value
     4075    :
     4076    assign
     4077      p-inn  = ""
     4078      p-kpp  = ""
     4079      p-okpo = ""
     4080    .
     4081    if p-cli-type = 'орг':U then do:
     4082     find first buf_firm no-lock where buf_firm.firm-code = p-cli-code no-error .
     4083     if available buf_firm then
     4084         assign
     4085           p-inn  = buf_firm.inn
     4086           p-kpp  = buf_firm.kpp
     4087           p-okpo = buf_firm.okpo
     4088         .
     4089    end.
     4090    if p-cli-type = 'чел':U then do:
     4091     find first buf_person no-lock where buf_person.psn-code = p-cli-code no-error .
     4092     if available buf_person then
     4093         assign
     4094           p-inn  = buf_person.inn
     4095           p-kpp  = buf_person.kpp
     4096           p-okpo = buf_person.okpo
     4097         .
     4098    end.
     4099     end.
     4100   END PROCEDURE.
     4101   PROCEDURE calc-tax :
     4102    do
     4103    on error undo, return error return-value
     4104    :
     4105   define variable v-nalog  as decimal no-undo .
     4106     v-nalog = 0 .
     4107     for each  tt_fin-ob-tax-before :
     4108        v-nalog = v-nalog + ( tt_fin-ob-tax-before.sum-vat-line-doc + tt_fin-ob-tax-before.sum-slt-line-doc ) .
     4109     end.
     4110     loc_sum-tax-doc       = v-nalog .
     4111     loc_sum-tax-rubl      = (  loc_exch-rate       / loc_exch-scale   ) * loc_sum-tax-doc  .
     4112     loc_sum-tax-base      = (  loc_base-scale      / loc_base-rate    ) * loc_sum-tax-rubl .
     4113     loc_sum-tax-contract  = (  loc_contract-scale  / loc_contract-rate) * loc_sum-tax-rubl .
     4114     display
     4115       loc_sum-tax-doc      when loc_sum-tax-doc:visible
     4116       loc_sum-tax-base     when loc_sum-tax-base     :visible
     4117       loc_sum-tax-rubl     when loc_sum-tax-rubl     :visible
     4118       loc_sum-tax-contract when loc_sum-tax-contract :visible
     4119       with frame Dialog-Frame
     4120       .
     4121     end.
     4122   END PROCEDURE.
     4123   PROCEDURE chg-radio-mode :
     4124    do
     4125    on error undo, return error return-value
     4126    :
     4127     end.
     4128   END PROCEDURE.
     4129   PROCEDURE create-tax :
     4130   define input parameter  v-sum-doc    as decimal no-undo .
     4131   define input parameter  v-sum-rubl   as decimal no-undo .
     4132   define input parameter  v-sum-base   as decimal no-undo .
     4133   define input parameter  v-sum-contr  as decimal no-undo .
     4134   define input parameter  v-type as character no-undo .
     4135   define output parameter v-tax  as decimal no-undo .
     4136   define variable v-1 as decimal no-undo .
     4137   define variable  v-col as integer init 0  no-undo .
     4138   define variable v-ok as logical init true no-undo .
     4139   define variable v-vat-pc-init as decimal init ? no-undo .
     4140   define variable v-slt-pc-init as decimal init ? no-undo .
     4141   for each tt_fin-ob-tax-before :
     4142       v-col = v-col + 1 .
     4143       v-vat-pc-init = tt_fin-ob-tax-before.vat-pc .
     4144       v-slt-pc-init = tt_fin-ob-tax-before.slt-pc .
     4145   end.
     4146   if v-vat-pc-init = ? then v-vat-pc-init = glob-vat-pc .
     4147   if v-slt-pc-init = ? then v-slt-pc-init = glob-slt-pc .
     4148       if v-col > 1 then do:
     4149           message "Вы уже ввели больше одной строки по налогам ! "  skip
     4150                   "Удалить и создать автоматически новую строку ?" skip "" skip
     4151                   "(Иначе Вам придется вручную пересчитать налоги !) "
     4152                   view-as alert-box question
     4153                   buttons yes-no
     4154                   update v-ok .
     4155       end.
     4156       if not v-ok then return .
     4157   if v-col = 1 then do:
     4158      find first  tt_fin-ob-tax-before no-error .
     4159   end.
     4160   if v-col > 1  or v-col = 0 then do:
     4161     for each tt_fin-ob-tax-before : delete tt_fin-ob-tax-before. end.
     4162     v-vat-pc-init = glob-vat-pc .
     4163     v-slt-pc-init = glob-slt-pc .
     4164     create tt_fin-ob-tax-before.
     4165   end.
     4166   assign
     4167       tt_fin-ob-tax-before.before-code                =  p-doc-code
     4168       tt_fin-ob-tax-before.host-code               =  par-host-code
     4169       tt_fin-ob-tax-before.line-num                =  1
     4170       tt_fin-ob-tax-before.sum-line-doc            = v-sum-doc
     4171       tt_fin-ob-tax-before.sum-line-base           = v-sum-base
     4172       tt_fin-ob-tax-before.sum-line-contr          = v-sum-contr
     4173       tt_fin-ob-tax-before.sum-line-rubl           = v-sum-rubl
     4174       tt_fin-ob-tax-before.with-slt                = true
     4175       tt_fin-ob-tax-before.slt-pc                  = v-slt-pc-init
     4176       tt_fin-ob-tax-before.sum-slt-line-doc        = tt_fin-ob-tax-before.slt-PC *  tt_fin-ob-tax-before.sum-line-doc   / ( 100 + tt_fin-ob-tax-before.slt-PC )
     4177       tt_fin-ob-tax-before.sum-slt-line-base       = tt_fin-ob-tax-before.slt-PC *  tt_fin-ob-tax-before.sum-line-base  / ( 100 + tt_fin-ob-tax-before.slt-PC )
     4178       tt_fin-ob-tax-before.sum-slt-line-contr      = tt_fin-ob-tax-before.slt-PC *  tt_fin-ob-tax-before.sum-line-contr / ( 100 + tt_fin-ob-tax-before.slt-PC )
     4179       tt_fin-ob-tax-before.sum-slt-line-rubl       = tt_fin-ob-tax-before.slt-PC *  tt_fin-ob-tax-before.sum-line-rubl  / ( 100 + tt_fin-ob-tax-before.slt-PC )
     4180       tt_fin-ob-tax-before.with-vat                = true
     4181       tt_fin-ob-tax-before.vat-pc                  = v-vat-pc-init
     4182       tt_fin-ob-tax-before.sum-vat-line-doc        = tt_fin-ob-tax-before.vat-PC * (( tt_fin-ob-tax-before.sum-line-doc   - tt_fin-ob-tax-before.sum-slt-line-doc   ) / ( 100  + tt_fin-ob-tax-before.vat-PC))
     4183       tt_fin-ob-tax-before.sum-vat-line-base       = tt_fin-ob-tax-before.vat-PC * (( tt_fin-ob-tax-before.sum-line-base  - tt_fin-ob-tax-before.sum-slt-line-base  ) / ( 100  + tt_fin-ob-tax-before.vat-PC))
     4184       tt_fin-ob-tax-before.sum-vat-line-contr      = tt_fin-ob-tax-before.vat-PC * (( tt_fin-ob-tax-before.sum-line-contr - tt_fin-ob-tax-before.sum-slt-line-contr ) / ( 100  + tt_fin-ob-tax-before.vat-PC))
     4185       tt_fin-ob-tax-before.sum-vat-line-rubl       = tt_fin-ob-tax-before.vat-PC * (( tt_fin-ob-tax-before.sum-line-rubl  - tt_fin-ob-tax-before.sum-slt-line-rubl  ) / ( 100  + tt_fin-ob-tax-before.vat-PC))
     4186   .
     4187   case v-type :
     4188   when "doc":U then do:
     4189         v-tax = tt_fin-ob-tax-before.sum-slt-line-doc + tt_fin-ob-tax-before.sum-vat-line-doc.
     4190   end.
     4191   when "rubl":U then do:
     4192         v-tax = tt_fin-ob-tax-before.sum-slt-line-rubl + tt_fin-ob-tax-before.sum-vat-line-rubl.
     4193   end.
     4194   when "base":U then do:
     4195         v-tax = tt_fin-ob-tax-before.sum-slt-line-base + tt_fin-ob-tax-before.sum-vat-line-base.
     4196   end.
     4197   when "contract":U then do:
     4198         v-tax = tt_fin-ob-tax-before.sum-slt-line-contr + tt_fin-ob-tax-before.sum-vat-line-contr.
     4199   end.
     4200   end case.
     4201   OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     4202   END PROCEDURE.
     4203   PROCEDURE disable_UI :
     4204     HIDE FRAME Dialog-Frame.
     4205   END PROCEDURE.
     4206   PROCEDURE enable_UI :
     4207     DISPLAY loc_prn-doc-code loc_contract-code loc_receiver-code loc_payer-code
     4208             loc_exch-rate loc_exch-scale loc_sum-doc loc_sum-tax-doc T-doc
     4209             loc_sum-tax-rubl T-rubl loc_sum-rubl loc_base-rate loc_base-scale
     4210             loc_sum-tax-base T-base loc_sum-base loc_contract-rate
     4211             loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract
     4212             loc_PS loc_doc-date loc_receiver-type loc_receiver-name f-receiver
     4213             loc_fact-date loc_payer-type loc_payer-name f-payer loc_trn-doc-code
     4214             p-doc-code FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7 loc_curr-code
     4215             loc_abbr-doc loc_abbr-rubl loc_abbr-base loc_contract-curr
     4216             loc_abbr-contract f-contract-curr
     4217         WITH FRAME Dialog-Frame.
     4218     ENABLE b-exit b-quit B-contract B-receiver B-payer B-help RECT-1 RECT-2
     4219            RECT-3 RECT-4 RECT-5 loc_prn-doc-code loc_contract-code r-con
     4220            loc_receiver-code r-cli loc_payer-code r-obj r-cur loc_exch-rate
     4221            loc_exch-scale loc_sum-doc T-doc T-rubl loc_base-rate loc_base-scale
     4222            T-base loc_contract-rate loc_contract-scale loc_sum-contract
     4223            T-contract r-cur-contr BROWSE-1 loc_PS B-ins B-chg B-del loc_doc-date
     4224            loc_receiver-type loc_receiver-name f-receiver loc_fact-date
     4225            loc_payer-type loc_payer-name f-payer loc_trn-doc-code FILL-IN-4
     4226            FILL-IN-5 FILL-IN-6 FILL-IN-7 loc_curr-code loc_abbr-doc loc_abbr-rubl
     4227            loc_abbr-base loc_contract-curr loc_abbr-contract f-contract-curr
     4228         WITH FRAME Dialog-Frame.
     4229     VIEW FRAME Dialog-Frame.
     4230     OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     4231   END PROCEDURE.
     4232   PROCEDURE from-contract :
     4233    do
     4234    on error undo, return error return-value
     4235    :
     4236   define input parameter p-code like contract.contract-code no-undo .
     4237   define input parameter p-host-code like contract.host-code no-undo .
     4238   define buffer buf_contract for contract.
     4239   define variable loc_payer-code-schet-start    as integer no-undo .
     4240   define variable loc_receiver-code-schet-start as integer no-undo .
     4241   if loc_contract-code:MODIFIED in frame Dialog-Frame = false then return  .
     4242     find first buf_contract no-lock where buf_contract.contract-code = p-code
     4243                                           and buf_contract.host-code     = p-host-code
     4244                                           no-error .
     4245   if error-status :error then do:
     4246      message error-status :get-message(1) "from-contract".
     4247      return error .
     4248      end.
     4249   define variable v-num as integer no-undo .
     4250   define variable v-buttons as character no-undo .
     4251   define variable v-desc as character no-undo .
     4252   define variable v-t as character no-undo .
     4253   if p-doc-type = 'при':U then assign
     4254     v-t = "Плательщика"
     4255   .
     4256   else assign
     4257     v-t = "Получателя"
     4258   .
     4259   v-num = 1.
     4260   if not( buf_contract.posr-name = "" and
     4261           buf_contract.agnt-name = "" ) then do:
     4262       v-buttons  = "Контрагент" + "|" +
     4263                   (if buf_contract.posr-name <> "" then "Посредник" else "Посредник^disable") + "|" +
     4264                   (if buf_contract.agnt-name <> "" then "Агент"     else "Агент^disable" )    + "|" +
     4265                   "Отмена"
     4266       .
     4267       v-desc     = buf_contract.cli-name + "|" +
     4268                   buf_contract.posr-name + "|" +
     4269                   buf_contract.agnt-name + "|" +
     4270                   "Не выбираем ни кого"
     4271         .
     4272       run gbl/d-askw.w
     4273         (input "Внимание!"
     4274         ,input "Выберите " + v-t + " по фин.обязательству."
     4275         ,input "|^"
     4276         ,input v-buttons
     4277         ,input v-desc
     4278         ,input 1
     4279         ,input 4
     4280         ,output v-num
     4281         ).
     4282   end.
     4283   if v-num = 4 then do:
     4284      return error .
     4285   end.
     4286     case p-doc-type :
     4287     when 'при':U then do:
     4288      case v-num :
     4289        when 1 then do:
     4290         assign
     4291           loc_payer-code       =  buf_contract.cli-code
     4292           loc_payer-type       =  buf_contract.cli-type
     4293           loc_payer-name       =  buf_contract.cli-name
     4294           .
     4295        end.
     4296        when 2 then do:
     4297         assign
     4298           loc_payer-code       =  buf_contract.posr-code
     4299           loc_payer-type       =  buf_contract.posr-type
     4300           loc_payer-name       =  buf_contract.posr-name
     4301           .
     4302        end.
     4303        when 3 then do:
     4304         assign
     4305           loc_payer-code       =  buf_contract.agnt-code
     4306           loc_payer-type       =  buf_contract.agnt-type
     4307           loc_payer-name       =  buf_contract.agnt-name
     4308           .
     4309        end.
     4310        end case.
     4311          assign
     4312           loc_receiver-code       =  par-host-code
     4313           loc_receiver-type       =  'орг':U
     4314           loc_receiver-name       =  buf_contract.own-name
     4315         .
     4316     end.
     4317     when 'рас':U then do:
     4318        case v-num :
     4319        when 1 then do:
     4320             assign
     4321                 loc_receiver-code       =  buf_contract.cli-code
     4322                 loc_receiver-type       =  buf_contract.cli-type
     4323                 loc_receiver-name       =  buf_contract.cli-name
     4324                 .
     4325        end.
     4326        when 2 then do:
     4327             assign
     4328                 loc_receiver-code       =  buf_contract.posr-code
     4329                 loc_receiver-type       =  buf_contract.posr-type
     4330                 loc_receiver-name       =  buf_contract.posr-name
     4331                 .
     4332        end.
     4333        when 3 then do:
     4334             assign
     4335                 loc_receiver-code       =  buf_contract.agnt-code
     4336                 loc_receiver-type       =  buf_contract.agnt-type
     4337                 loc_receiver-name       =  buf_contract.agnt-name
     4338                 .
     4339        end.
     4340        end case.
     4341           assign
     4342           loc_payer-code       =  par-host-code
     4343           loc_payer-type       =  'орг':U
     4344           loc_payer-name       =  buf_contract.own-name
     4345                 .
     4346     end.
     4347     end case.
     4348     assign
     4349       loc_contract-code-id   =  buf_contract.contract-code
     4350       loc_contract-curr      =  buf_contract.curr-code
     4351       .
     4352   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4354     (input  loc_contract-curr
     4355     ,input  loc_doc-date
     4356     ,output loc_contract-rate
     4357     ,output loc_contract-scale
     4358     ,output loc_abbr-contract
     4359     )  .
     4360       display
     4361         loc_receiver-code
     4362         loc_receiver-name
     4363         loc_receiver-type
     4364         loc_abbr-contract
     4365         loc_payer-code
     4366         loc_payer-name
     4367         loc_payer-type
     4368         loc_contract-curr
     4369         loc_contract-rate
     4370         loc_contract-scale
     4371       with frame Dialog-Frame .
     4372    apply "LEAVE" to loc_sum-contract in frame Dialog-Frame .
     4373    run hide-curr ( input "contract":U ) .
     4374     end.
     4375   END PROCEDURE.
     4376   PROCEDURE hide-curr :
     4377    define input parameter p-mode as character no-undo .
     4378    do
     4379    on error undo, return error return-value
     4380    with frame Dialog-Frame :
     4381   if loc_curr-code = 0 then do:
     4382     disable loc_exch-rate  loc_exch-scale  .
     4383   end.
     4384   else do:
     4385     if  p-mode <> "lookup" then
     4386         enable  loc_exch-rate  loc_exch-scale  .
     4387   end.
     4388    case p-mode :
     4389    when "init" then do:
     4390         if loc_curr-code = 0 then do:
     4391           hide loc_sum-tax-rubl T-rubl loc_sum-rubl loc_abbr-rubl in frame Dialog-Frame .
     4392         end.
     4393         if p-basecode = 0 then do:
     4394           hide loc_base-rate loc_base-scale loc_sum-tax-base T-base loc_sum-base loc_abbr-base in frame Dialog-Frame .
     4395         end.
     4396         if loc_contract-curr = 0  or
     4397             loc_contract-curr = p-basecode  then do:
     4398             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr in frame Dialog-Frame .
     4399         end.
     4400    end.
     4401    when "contract" then do:
     4402         if  loc_contract-curr = 0  or
     4403             loc_contract-curr = p-basecode or
     4404             loc_contract-curr = loc_curr-code  then do:
     4405             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr in frame Dialog-Frame .
     4406         end.
     4407         else do:
     4408            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr .
     4409            enable   T-contract r-cur-contr .
     4410         end.
     4411    end.
     4412    when "pay" then do:
     4413         if loc_curr-code <> 0 then do:
     4414           display loc_sum-tax-rubl T-rubl loc_sum-rubl loc_abbr-rubl  .
     4415           enable t-rubl .
     4416         end.
     4417         else do:
     4418             hide loc_sum-tax-rubl T-rubl loc_sum-rubl loc_abbr-rubl .
     4419         end.
     4420         if p-basecode = loc_curr-code or
     4421            p-basecode = 0   then do:
     4422           hide loc_base-rate loc_base-scale loc_sum-tax-base T-base loc_sum-base loc_abbr-base in frame Dialog-Frame .
     4423         end.
     4424         else do:
     4425            display  loc_base-rate loc_base-scale loc_sum-tax-base T-base loc_sum-base loc_abbr-base .
     4426            enable   T-base .
     4427         end.
     4428         if  loc_contract-curr = 0  or
     4429             loc_contract-curr = p-basecode or
     4430             loc_contract-curr = loc_curr-code  then do:
     4431             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr in frame Dialog-Frame .
     4432         end.
     4433         else do:
     4434            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr .
     4435            enable   T-contract r-cur-contr .
     4436         end.
     4437    end.
     4438    when "lookup" then do:
     4439         if loc_curr-code <> 0 then do:
     4440           display loc_sum-tax-rubl T-rubl loc_sum-rubl loc_abbr-rubl  .
     4441         end.
     4442         else do:
     4443             hide loc_sum-tax-rubl T-rubl loc_sum-rubl loc_abbr-rubl .
     4444         end.
     4445         if p-basecode = loc_curr-code or
     4446            p-basecode = 0   then do:
     4447           hide loc_base-rate loc_base-scale loc_sum-tax-base T-base loc_sum-base loc_abbr-base in frame Dialog-Frame .
     4448         end.
     4449         else do:
     4450            display  loc_base-rate loc_base-scale loc_sum-tax-base T-base loc_sum-base loc_abbr-base .
     4451         end.
     4452         if  loc_contract-curr = 0  or
     4453             loc_contract-curr = p-basecode or
     4454             loc_contract-curr = loc_curr-code  then do:
     4455             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr in frame Dialog-Frame .
     4456         end.
     4457         else do:
     4458            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract T-contract r-cur-contr loc_contract-curr loc_abbr-contract f-contract-curr .
     4459         end.
     4460         hide b-quit in frame Dialog-Frame .
     4461    end.
     4462   end case .
     4463     end.
     4464   END PROCEDURE.
     4465   PROCEDURE init-p :
     4466    do
     4467    on error undo, return error return-value
     4468    :
     4469   define buffer buff_contract for contract.
     4470   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4472     (input  par-host-code
     4473     ,output p-basecode
     4474     )  .
     4475       find first sysconf no-lock where sysconf.host-code = par-host-code no-error .
     4476       glob-vat-pc = sysconf.fin-vat-pc.
     4477       glob-slt-pc = sysconf.fin-slt-pc.
     4478       define variable g-log as logical no-undo.
     4479       define variable v-view as character no-undo .
     4480       run uf-get in this-procedure(
     4481           input  ('fin-obi':U )
     4482           ,input  g#userid
     4483           ,output v-uf-List_
     4484           ,output v-uf-Naim
     4485           ,output v-uf-print-graft
     4486           ,output v-uf-sort-gr
     4487           ,output v-uf-type-price
     4488           ,output v-uf-type-val
     4489       )  no-error.
     4490       if not error-status:error
     4491       and not v-uf-LIst_ = "":U
     4492       then do:
     4493           assign
     4494           v-view =  entry(1, v-uf-List_, chr(4))
     4495           .
     4496       end.
     4497       if ref-mode =  'ДОБАВЛЕНИЕ':U
     4498           then  do:
     4499               ri = ?.
     4500               run fin-ob-code (input g#db-num , output p-doc-code) .
     4501               assign
     4502                     p-prn-doc-code     = p-doc-code
     4503                     p-host-code        = par-host-code
     4504                     p-doc-date         = today
     4505                     p-status_          = 'новый':U
     4506                     p-payer-name       = ""
     4507                     p-receiver-name    = ""
     4508                     p-payer-code       = 0
     4509                     p-receiver-code    = 0
     4510                     p-payer-type       = 'орг':U
     4511                     p-receiver-type    = 'орг':U
     4512                     p-in-type          = 0
     4513                     p-sum-doc          = 0
     4514                     p-user-db-num-doc  = g#db-num
     4515                     p-user-name-doc    = g#userid
     4516               .
     4517                     define buffer b#clients for clients.
     4518                     find first b#clients WHERE
     4519                           b#clients.obj-code = par-host-code and
     4520                           b#clients.obj-type = 'орг':U
     4521                           No-LOCK No-ERROR.
     4522                     if p-doc-type <> 'при':U then do:
     4523                         if avail b#clients then
     4524                             Assign
     4525                                 p-payer-code = b#clients.obj-code
     4526                                 p-payer-type = b#clients.obj-type
     4527                                 p-payer-name = b#clients.obj-name .
     4528                     end.
     4529                     else do:
     4530                         if avail b#clients then
     4531                             Assign
     4532                                 p-receiver-code = b#clients.obj-code
     4533                                 p-receiver-type = b#clients.obj-type
     4534                                 p-receiver-name = b#clients.obj-name .
     4535                     end.
     4536   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4538     (input  par-host-code
     4539     ,input  today
     4540     ,output p-base-rate
     4541     ,output p-base-scale
     4542     )  .
     4543                 p-curr-code  = 0.
     4544                 p-exch-rate  = 1.
     4545                 p-exch-scale = 1.
     4546                 p-contract-curr  = p-basecode  .
     4547                 p-contract-rate  = p-base-rate .
     4548                 p-contract-scale = p-base-scale.
     4549               assign
     4550                 loc_base-rate          =  p-base-rate
     4551                 loc_base-scale         =  p-base-scale
     4552                 loc_receiver-code      =  p-receiver-code
     4553                 loc_receiver-name      =  p-receiver-name
     4554                 loc_receiver-type      =  p-receiver-type
     4555                 loc_contract-code-id   =  p-contract-code
     4556                 loc_curr-code          =  p-curr-code
     4557                 loc_doc-date           =  p-doc-date
     4558                 loc_exch-rate          =  p-exch-rate
     4559                 loc_exch-scale         =  p-exch-scale
     4560                 loc_fact-date          =  p-fact-date
     4561                 loc_payer-code         =  p-payer-code
     4562                 loc_payer-name         =  p-payer-name
     4563                 loc_payer-type         =  p-payer-type
     4564                 loc_pay-date           =  p-pay-date
     4565                 loc_prn-doc-code       =  p-prn-doc-code
     4566                 loc_sum-base           =  p-sum-base
     4567                 loc_sum-doc            =  p-sum-doc
     4568                 loc_sum-rubl           =  p-sum-rubl
     4569                 loc_trn-doc-code       =  p-trn-doc-code
     4570                 loc_doc-type           =  p-doc-type
     4571                 loc_status_            =  p-status_
     4572                 loc_in-type            =  p-in-type
     4573                 loc_sum-tax-rubl       =  p-sum-tax-rubl
     4574                 loc_sum-tax-base       =  p-sum-tax-base
     4575                 loc_sum-tax-doc        =  p-sum-tax-doc
     4576                 loc_contract-curr     = p-contract-curr
     4577                 loc_contract-rate     = p-contract-rate
     4578                 loc_contract-scale    = p-contract-scale
     4579                 loc_sum-contract      = p-sum-contract
     4580                 loc_sum-tax-contract  = p-sum-tax-contract
     4581                 loc_contract-code   = ""
     4582                 loc_abbr-contract   = ""
     4583                 .
     4584       end.
     4585       else dO:
     4586          find fin-ob-before where recid( fin-ob-before ) = ri no-error .
     4587          if error-status :error then return  error .
     4588               assign
     4589                 p-doc-code             =  fin-ob-before.before-code
     4590                 loc_base-rate          =  fin-ob-before.base-rate
     4591                 loc_base-scale         =  fin-ob-before.base-scale
     4592                 loc_receiver-code      =  fin-ob-before.receiver-code
     4593                 loc_receiver-name      =  fin-ob-before.receiver-name
     4594                 loc_receiver-type      =  fin-ob-before.receiver-type
     4595                 loc_contract-code-id   =  fin-ob-before.contract-code
     4596                 loc_curr-code          =  fin-ob-before.curr-code
     4597                 loc_doc-date           =  fin-ob-before.doc-date
     4598                 loc_exch-rate          =  fin-ob-before.exch-rate
     4599                 loc_exch-scale         =  fin-ob-before.exch-scale
     4600                 loc_fact-date          =  fin-ob-before.fact-date
     4601                 loc_payer-code         =  fin-ob-before.payer-code
     4602                 loc_payer-name         =  fin-ob-before.payer-name
     4603                 loc_payer-type         =  fin-ob-before.payer-type
     4604                 loc_pay-date           =  fin-ob-before.pay-date
     4605                 loc_prn-doc-code       =  fin-ob-before.prn-doc-code
     4606                 loc_sum-base           =  fin-ob-before.sum-base
     4607                 loc_sum-doc            =  fin-ob-before.sum-doc
     4608                 loc_sum-rubl           =  fin-ob-before.sum-rubl
     4609                 loc_trn-doc-code       =  fin-ob-before.trn-doc-code
     4610                 loc_doc-type           =  fin-ob-before.doc-type
     4611                 loc_status_            =  fin-ob-before.status_
     4612                 loc_in-type            =  fin-ob-before.in-type
     4613                 loc_sum-tax-rubl       =  fin-ob-before.sum-tax-rubl
     4614                 loc_sum-tax-base       =  fin-ob-before.sum-tax-base
     4615                 loc_sum-tax-doc        =  fin-ob-before.sum-tax-doc
     4616                 loc_contract-curr      =  fin-ob-before.contract-curr
     4617                 loc_contract-rate      =  fin-ob-before.contract-rate
     4618                 loc_contract-scale     =  fin-ob-before.contract-scale
     4619                 loc_sum-contract       =  fin-ob-before.sum-contract
     4620                 loc_sum-tax-contract   =  fin-ob-before.sum-tax-contract
     4621                 loc_ps                   =  fin-ob-before.ps
     4622                 .
     4623       find first buff_contract no-lock where buff_contract.host-code = fin-ob-before.host-code and
     4624                                              buff_contract.contract-code = fin-ob-before.contract-code no-error .
     4625       if available buff_contract then
     4626          loc_contract-code        =  buff_contract.contract-prn-code .
     4627          else loc_contract-code   = "".
     4628       loc_abbr-contract  = sel-abbr(loc_contract-curr) .
     4629   end.
     4630       loc_abbr-base = "Баз.вал "  + sel-abbr(p-basecode) .
     4631       loc_abbr-doc  = sel-abbr(loc_curr-code) .
     4632       case loc_in-type :
     4633         when 0 then do:
     4634           t-doc = yes.
     4635         end.
     4636         when 1 then do:
     4637           t-base = yes.
     4638         end.
     4639         when 2 then do:
     4640           t-rubl = yes.
     4641         end.
     4642         when 3 then do:
     4643           t-contract = yes.
     4644         end.
     4645       end case.
     4646      define buffer buf_fin-ob-tax-before for fin-ob-tax-before.
     4647      for each tt_fin-ob-tax-before : delete tt_fin-ob-tax-before. end.
     4648      for each buf_fin-ob-tax-before no-lock where
     4649               buf_fin-ob-tax-before.host-code = par-host-code and
     4650               buf_fin-ob-tax-before.before-code  = p-doc-code
     4651      :
     4652         create tt_fin-ob-tax-before.
     4653         BUFFER-COPY buf_fin-ob-tax-before to tt_fin-ob-tax-before .
     4654      end.
     4655      OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     4656      ASSIGN frame Dialog-Frame:TITLE = "ПредФинОбязательство  "  + " № " + loc_prn-doc-code
     4657      + " Тип: " +    loc_doc-type
     4658      + " Статус: "  +  loc_status_
     4659      + " - " + caps(ref-mode).
     4660     end.
     4661   END PROCEDURE.
     4662   PROCEDURE lookup-cli :
     4663   do
     4664   on error undo, return error return-value
     4665   :
     4666   define input parameter loc_cli-code as integer no-undo .
     4667   define input parameter loc_cli-type as character no-undo .
     4668     run ref/showcli.p (
     4669       input parParentProc
     4670       ,input loc_cli-type
     4671       ,input loc_cli-code
     4672       ).
     4673   end.
     4674   END PROCEDURE.
     4675   PROCEDURE myenable_chg :
     4676    do
     4677    on error undo, return error return-value
     4678    :
     4679     DISPLAY loc_prn-doc-code  loc_payer-code loc_payer-type
     4680             loc_contract-code loc_receiver-code loc_receiver-type  loc_sum-doc
     4681             T-doc
     4682             T-contract
     4683             loc_contract-rate loc_contract-scale
     4684             loc_exch-rate loc_exch-scale
     4685             loc_base-rate loc_sum-rubl
     4686             loc_sum-base
     4687             T-rubl
     4688             T-base
     4689             loc_base-scale loc_doc-date
     4690             loc_fact-date
     4691             loc_payer-name loc_receiver-name loc_trn-doc-code
     4692             loc_curr-code loc_abbr-doc loc_abbr-base
     4693             p-doc-code
     4694             loc_contract-code
     4695             loc_sum-tax-doc
     4696             loc_sum-tax-rubl
     4697             loc_sum-tax-base
     4698             loc_sum-tax-contract
     4699             loc_sum-contract
     4700             loc_contract-curr
     4701             loc_abbr-contract
     4702              b-prev b-next loc_abbr-rubl
     4703             FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7
     4704             loc_PS
     4705             f-payer
     4706             f-receiver
     4707             B-contract
     4708             B-payer
     4709             B-receiver
     4710             f-contract-curr
     4711         WITH FRAME Dialog-Frame.
     4712     ENABLE b-exit b-help b-quit
     4713            loc_prn-doc-code
     4714            r-obj
     4715            r-con
     4716            r-cli
     4717            r-cur
     4718            r-cur-contr
     4719            loc_payer-code
     4720            loc_payer-type
     4721            loc_receiver-code
     4722            loc_receiver-type
     4723            T-doc T-rubl T-base t-contract
     4724            loc_exch-rate
     4725            loc_exch-scale
     4726            loc_contract-rate
     4727            loc_contract-scale
     4728            loc_base-rate
     4729            loc_base-scale
     4730            BROWSE-1
     4731            B-ins B-chg B-del
     4732            loc_doc-date
     4733            loc_fact-date
     4734            loc_curr-code
     4735            loc_abbr-doc
     4736            loc_abbr-base
     4737           loc_sum-doc       when t-doc      = yes
     4738           loc_sum-rubl      when t-rubl     = yes
     4739           loc_sum-base      when t-base     = yes
     4740           loc_sum-contract  when t-contract = yes
     4741           loc_contract-code
     4742           B-contract
     4743           B-payer
     4744           B-receiver
     4745         WITH FRAME Dialog-Frame.
     4746         run chg-radio-mode.
     4747         b-exit:label in frame Dialog-Frame  = "&Ввод" .
     4748     VIEW FRAME Dialog-Frame.
     4749     OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     4750     end.
     4751   END PROCEDURE.
     4752   PROCEDURE myenable_lkp :
     4753     IF AVAILABLE fin-ob-before THEN
     4754       DISPLAY
     4755       loc_base-rate
     4756       loc_base-scale
     4757       loc_receiver-code
     4758       loc_receiver-name
     4759       loc_receiver-type
     4760       loc_contract-code
     4761       loc_contract-rate
     4762       loc_contract-scale
     4763       loc_curr-code
     4764       loc_doc-date loc_exch-rate loc_exch-scale loc_fact-date loc_payer-code loc_payer-name loc_payer-type
     4765       loc_prn-doc-code
     4766       loc_sum-base
     4767       loc_sum-doc
     4768       loc_sum-rubl
     4769       loc_trn-doc-code
     4770       loc_abbr-base
     4771       loc_abbr-doc
     4772       p-doc-code
     4773       loc_sum-tax-doc
     4774       loc_sum-tax-rubl
     4775       loc_sum-tax-base
     4776       b-prev
     4777       b-next
     4778       T-base T-contract T-doc T-rubl
     4779       loc_sum-contract
     4780       loc_sum-tax-contract
     4781       loc_contract-curr
     4782       loc_abbr-contract
     4783           loc_abbr-rubl
     4784       FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7
     4785             loc_PS
     4786             f-payer
     4787             f-receiver
     4788             B-contract
     4789             B-payer
     4790             B-receiver
     4791             f-contract-curr
     4792             loc_ps
     4793         WITH FRAME Dialog-Frame.
     4794      enable b-exit b-help BROWSE-1 b-next  b-prev
     4795             B-contract
     4796             B-payer
     4797             B-receiver
     4798         WITH FRAME Dialog-Frame.
     4799         disable  WITH FRAME Dialog-Frame.
     4800     VIEW FRAME Dialog-Frame.
