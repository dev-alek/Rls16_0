     4802   END PROCEDURE.
     4803   PROCEDURE next-focus :
     4804    do
     4805    on error undo, return error return-value
     4806    :
     4807     define input parameter p-widget-handle as handle no-undo .
     4808     define variable l-apply-entry as logical no-undo .
     4809     assign
     4810       l-apply-entry =   true
     4811     .
     4812     do with frame Dialog-Frame :
     4813       if  loc_prn-doc-code   :handle = p-widget-handle then do:  if loc_payer-code    :sensitive then do: apply "entry":u to loc_contract-code .  return . end. end.
     4814       if  loc_contract-code  :handle = p-widget-handle then do:  if loc_pay-date      :sensitive then do: apply "entry":u to loc_pay-date      .  return . end. end.
     4815       if  loc_pay-date       :handle = p-widget-handle then do:  if loc_receiver-code :sensitive then do: apply "entry":u to loc_receiver-code .  return . end. end.
     4816       if  loc_receiver-code  :handle = p-widget-handle then do:  if loc_payer-code    :sensitive then do: apply "entry":u to loc_payer-code    .  return . end. end.
     4817       if  loc_payer-code     :handle = p-widget-handle then do:
     4818           if loc_sum-doc      :sensitive then do: apply "entry":u to loc_sum-doc      .  return . end.
     4819           if loc_sum-base     :sensitive then do: apply "entry":u to loc_sum-base     .  return . end.
     4820           if loc_sum-rubl     :sensitive then do: apply "entry":u to loc_sum-rubl     .  return . end.
     4821           if loc_sum-contract :sensitive then do: apply "entry":u to loc_sum-contract .  return . end.
     4822       end.
     4823       if  loc_sum-doc        :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     4824       if  loc_sum-base       :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     4825       if  loc_sum-rubl       :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     4826       if  loc_sum-contract   :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     4827       if  b-chg              :handle = p-widget-handle then do:  if B-exit    :sensitive then do:       apply "entry":u to B-exit    .        return . end. end.
     4828       end.
     4829     end.
     4830   END PROCEDURE.
     4831   PROCEDURE save-p :
     4832   do
     4833    on error undo, return error return-value
     4834    :
     4835   if ref-mode <> 'ПРОСМОТР':U then do:
     4836           if loc_sum-doc  = 0 or loc_sum-doc  = ?  or
     4837             loc_sum-base = 0 or loc_sum-base = ?  or
     4838             loc_sum-rubl = 0 or loc_sum-rubl = ?  then do:
     4839             message "Не задана сумма финансового обязательства !" view-as alert-box information  title "Ошибка при вводе".
     4840             return error.
     4841         end.
     4842         if loc_receiver-code = 0 or loc_receiver-code = ? then do:
     4843           message "Не задан код получателя !"  view-as alert-box information  title "Ошибка при вводе".
     4844           return error .
     4845         end.
     4846         if loc_payer-code = 0 or loc_payer-code = ? then do:
     4847           message "Не задан код плательщика !"  view-as alert-box information  title "Ошибка при вводе".
     4848           return error .
     4849         end.
     4850         if loc_receiver-code = loc_payer-code  and
     4851            loc_receiver-type = loc_payer-type then do:
     4852           message "Код получателя равен коду плательщика !"  view-as alert-box information  title "Ошибка при вводе".
     4853           return error .
     4854         end.
     4855         if not can-find (first clients where clients.obj-code = loc_receiver-code
     4856                                         and clients.obj-type = loc_receiver-type no-lock )
     4857           then do:
     4858           message "Не верно выбран получатель !"  view-as alert-box information  title "Ошибка при вводе".
     4859           return error .
     4860         end.
     4861         if not can-find (first clients where clients.obj-code = loc_payer-code
     4862                                         and clients.obj-type = loc_payer-type no-lock )
     4863           then do:
     4864           message "Не верно выбран плательшик !"  view-as alert-box information  title "Ошибка при вводе".
     4865           return error .
     4866         end.
     4867         define variable v-sum1 as decimal no-undo .
     4868         v-sum1 = 0 .
     4869         for each tt_fin-ob-tax-before :
     4870             v-sum1  = v-sum1 + tt_fin-ob-tax-before.sum-line-doc .
     4871         end.
     4872         if  v-sum1 = 0  then do:
     4873           message
     4874            "Не введены налоги !!! "
     4875           view-as alert-box information  title "Ошибка при вводе налогов".
     4876           return error .
     4877         end.
     4878         if loc_sum-doc <> v-sum1      then do:
     4879           message
     4880           substitute ( "Общая сумма документа &1, а сумма всех компонент , по которым исчислялся налог = &2", loc_sum-doc, v-sum1 )
     4881           view-as alert-box information  title "Ошибка при вводе налогов".
     4882           return error .
     4883         end.
     4884   define buffer buf_contract for contract.
     4885     find first buf_contract where buf_contract.contract-prn-code = loc_contract-code
     4886                               and buf_contract.host-code         = par-host-code
     4887                           no-lock no-error .
     4888     if not available buf_contract then do:
     4889        message "Не верно введен Номер договора!!! " view-as alert-box error  .
     4890        return error .
     4891     end.
     4892     define variable v-ok as logical no-undo .
     4893     case p-doc-type :
     4894     when 'при':U then do:
     4895       if not ((
     4896           ( loc_payer-code       =  buf_contract.cli-code  and loc_payer-type       =  buf_contract.cli-type  ) or
     4897           ( loc_payer-code       =  buf_contract.posr-code and loc_payer-type       =  buf_contract.posr-type ) or
     4898           ( loc_payer-code       =  buf_contract.agnt-code and loc_payer-type       =  buf_contract.agnt-type ))
     4899           and
     4900           ( loc_receiver-code       =  par-host-code       and loc_receiver-type       =  'орг':U))
     4901           then do:
     4902            message
     4903            "Внимание !!!"  skip
     4904            "Данные по ПЛАТЕЛЬЩИКУ или ПОЛУЧАТЕЛЮ взяты не из договора ! "  skip
     4905            "Сохраняем фин.обязательство  ? "          skip
     4906            view-as alert-box question
     4907            buttons yes-no
     4908            update v-ok
     4909             .
     4910            if v-ok = false then return error .
     4911           end.
     4912     end.
     4913     when 'рас':U then do:
     4914       if not ((
     4915           ( loc_receiver-code       =  buf_contract.cli-code  and loc_receiver-type       =  buf_contract.cli-type  ) or
     4916           ( loc_receiver-code       =  buf_contract.posr-code and loc_receiver-type       =  buf_contract.posr-type ) or
     4917           ( loc_receiver-code       =  buf_contract.agnt-code and loc_receiver-type       =  buf_contract.agnt-type ))
     4918           and
     4919           ( loc_payer-code       =  par-host-code       and loc_payer-type       =  'орг':U))
     4920           then do:
     4921            message
     4922            "Внимание !!!"  skip
     4923            "Данные по ПЛАТЕЛЬЩИКУ или ПОЛУЧАТЕЛЮ взяты не из договора ! "  skip
     4924            "Сохраняем фин.обязательство  ? "          skip
     4925            view-as alert-box question
     4926            buttons yes-no
     4927            update v-ok
     4928             .
     4929            if v-ok = false then return error .
     4930           end.
     4931     end.
     4932     end case.
     4933   if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     4934          run create-fin-ob-before (
     4935                   input no ,
     4936           input  p-doc-code            ,
     4937           input  0                     ,
     4938           input  p-doc-date            ,
     4939           input  p-doc-type            ,
     4940           input  p-payer-name          ,
     4941           input  p-receiver-name       ,
     4942           input  p-curr-code           ,
     4943           input  p-sum-doc             ,
     4944           input  p-user-db-num-doc     ,
     4945           input  p-user-name-doc       ,
     4946           input  p-base-rate           ,
     4947           input  p-base-scale          ,
     4948           input  p-receiver-code       ,
     4949           input  p-receiver-type       ,
     4950           input  p-contract-code       ,
     4951           input  p-exch-rate           ,
     4952           input  p-exch-scale          ,
     4953           input  p-contract-curr       ,
     4954           input  p-contract-rate       ,
     4955           input  p-contract-scale      ,
     4956           input  p-fact-date           ,
     4957           input  p-fact-order          ,
     4958           input  p-host-code           ,
     4959           input  p-payer-code          ,
     4960           input  p-payer-type          ,
     4961           input  p-pay-date            ,
     4962           input  p-prn-doc-code        ,
     4963           input  p-status_             ,
     4964           input  p-sum-base-orig       ,
     4965           input  p-sum-base            ,
     4966           input  p-sum-doc-orig        ,
     4967           input  p-sum-rubl-orig       ,
     4968           input  p-sum-rubl            ,
     4969           input  p-sum-contract        ,
     4970           input  p-trn-doc-code        ,
     4971           input  p-trn-doc-code        ,
     4972           input  p-user-db-num-fact    ,
     4973           input  p-user-db-num-pay        ,
     4974           input  p-user-name-fact         ,
     4975           input  p-user-name-pay          ,
     4976           input  p-in-type                ,
     4977           input  p-sum-tax-base           ,
     4978           input  p-sum-tax-doc            ,
     4979           input  p-sum-tax-rubl           ,
     4980           input  p-sum-tax-contract       ,
     4981           input  ""                       ,
     4982           output ri ).
     4983   end.
     4984       find current fin-ob-before  exclusive-lock   no-error.
     4985       if available fin-ob-before then do:
     4986         assign
     4987           fin-ob-before.contract-code        = loc_contract-code-id
     4988           fin-ob-before.receiver-code        = loc_receiver-code
     4989           fin-ob-before.receiver-name        = loc_receiver-name
     4990           fin-ob-before.receiver-type        = loc_receiver-type
     4991           fin-ob-before.doc-date             = loc_doc-date
     4992           fin-ob-before.trn-doc-code         = loc_trn-doc-code
     4993           fin-ob-before.base-rate            = loc_base-rate
     4994           fin-ob-before.base-scale           = loc_base-scale
     4995           fin-ob-before.curr-code            = loc_curr-code
     4996           fin-ob-before.exch-rate            = loc_exch-rate
     4997           fin-ob-before.exch-scale           = loc_exch-scale
     4998           fin-ob-before.fact-date            = loc_fact-date
     4999           fin-ob-before.payer-code           = loc_payer-code
     5000           fin-ob-before.payer-name           = loc_payer-name
     5001           fin-ob-before.payer-type           = loc_payer-type
     5002           fin-ob-before.pay-date             = loc_pay-date
     5003           fin-ob-before.prn-doc-code         = loc_prn-doc-code
     5004           fin-ob-before.sum-base             = loc_sum-base
     5005           fin-ob-before.sum-doc              = loc_sum-doc
     5006           fin-ob-before.sum-rubl             = loc_sum-rubl
     5007           fin-ob-before.sum-contract         = loc_sum-contract
     5008           fin-ob-before.sum-tax-base             = loc_sum-tax-base
     5009           fin-ob-before.sum-tax-doc              = loc_sum-tax-doc
     5010           fin-ob-before.sum-tax-rubl             = loc_sum-tax-rubl
     5011           fin-ob-before.sum-tax-contract         = loc_sum-tax-contract
     5012           fin-ob-before.contract-curr        = loc_contract-curr
     5013           fin-ob-before.contract-rate        = loc_contract-rate
     5014           fin-ob-before.contract-scale       = loc_contract-scale
     5015          fin-ob-before.ps                   =  loc_ps
     5016         .
     5017         if t-doc      then fin-ob-before.in-type  = 0 .
     5018         if t-base     then fin-ob-before.in-type  = 1 .
     5019         if t-rubl     then fin-ob-before.in-type  = 2 .
     5020         if t-contract then fin-ob-before.in-type  = 3 .
     5021             for each fin-ob-tax-before  exclusive-lock  where  fin-ob-tax-before.host-code = fin-ob-before.host-code and
     5022                                                                fin-ob-tax-before.before-code  = fin-ob-before.before-code :
     5023                 delete fin-ob-tax-before .
     5024             end .
     5025             for each tt_fin-ob-tax-before :
     5026                 create fin-ob-tax-before .
     5027                 BUFFER-COPY tt_fin-ob-tax-before to fin-ob-tax-before
     5028                 assign
     5029                   fin-ob-tax-before.host-code = fin-ob-before.host-code
     5030                   fin-ob-tax-before.before-code  = fin-ob-before.before-code
     5031               .
     5032             end.
     5033   end.
     5034   else do:
     5035    message "Ошибка при сохранении данных "  skip vss-workfile vss-revision vss-description skip
     5036            error-status :get-message(1) .
     5037    return no-apply.
     5038   end.
     5039   end.
     5040     end.
     5041   END PROCEDURE.
     5042   PROCEDURE step-next :
     5043    do
     5044    on error undo, return error return-value
     5045    :
     5046   if valid-handle (br-handle) then do:
     5047     g#log = br-handle:select-next-row() no-error .
     5048     if error-status :error then do:
     5049        message "Это режим просмотра одного документа." .
     5050        g#log = false .
     5051        end.
     5052     if not g#log then message "Это последний документ списка.".
     5053   end.
     5054       ri = recid ( buf_fin-liab-before ).
     5055       next-prev = yes.
     5056     end.
     5057   END PROCEDURE.
     5058   PROCEDURE step-prev :
     5059    do
     5060    on error undo, return error return-value
     5061    :
     5062   if valid-handle (br-handle) then do:
     5063     g#log = br-handle:select-prev-row() no-error .
     5064     if error-status :error then do:
     5065        message "Это режим просмотра одного документа." .
     5066        g#log = false .
     5067     end.
     5068     if not g#log then do: message "Это первый документ списка.".   end.
     5069   end.
     5070   ri = recid (buf_fin-liab-before).
     5071   next-prev = yes .
     5072     end.
     5073   END PROCEDURE.
     5074   FUNCTION sel-abbr RETURNS CHARACTER
     5075     ( p-curr-code as int ) :
     5076     define variable rr as character no-undo .
     5077     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
     5078     rr = currency.curr-abbr .
     5079     RETURN rr.
     5080   END FUNCTION.
