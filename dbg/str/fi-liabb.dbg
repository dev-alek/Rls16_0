     3337   procedure diasize_position-resize-button :
     3338     do with frame Dialog-Frame
     3339     :
     3340       hide v-diasize-resize-button .
     3341       assign
     3342         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
