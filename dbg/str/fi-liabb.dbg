      458   procedure uf-get :
      459     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      460     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      461     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      462     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      463     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      464     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      465     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      466     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      467     do
      468     on error undo, return error
      469     :
      470       define buffer buf_usr-flt for ubflt.usr-flt .
      471       define variable v-use-List_     as logical   no-undo .
      472       define variable v-type-List_     as character no-undo .
      473       define variable v-format-List_   as character no-undo .
      474       define variable v-use-Naim      as logical   no-undo .
      475       define variable v-type-Naim      as character no-undo .
      476       define variable v-format-Naim    as character no-undo .
      477       define variable v-use-print-graft as logical   no-undo .
      478       define variable v-use-sort-gr     as logical   no-undo .
      479       define variable v-use-type-price  as logical   no-undo .
      480       define variable v-use-type-val    as logical   no-undo .
      481       define variable v-label          as character no-undo .
      482       define variable v-tooltip        as character no-undo .
      483       define variable v-user-can-edit  as logical   no-undo .
      484       define variable v-output-display as logical   no-undo .
      485       define variable v-other          as character no-undo .
      486       run uf-name in this-procedure
      487          (input  entry(1, p-code, chr(4))
      488         ,output v-use-List_
      489         ,output v-type-List_
      490         ,output v-format-List_
      491         ,output v-use-Naim
      492         ,output v-type-Naim
      493         ,output v-format-Naim
      494         ,output v-use-print-graft
      495         ,output v-use-sort-gr
      496         ,output v-use-type-price
      497         ,output v-use-type-val
      498         ,output v-label
      499         ,output v-tooltip
      500         ,output v-user-can-edit
      501         ,output v-output-display
      502         ,output v-other
      503         ) no-error .
      504       if error-status :error then do:
      505         undo, return error return-value .
      506       end.
      507       find first buf_usr-flt no-lock where
      508                  buf_usr-flt.Call-point     = p-code AND
      509                  buf_usr-flt.user-name       = p-user-name
      510         no-error .
      511       if avail buf_usr-flt then do:
      512         assign
      513         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      514         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      515         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      516         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      517         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      518         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      519         .
      520       end.
      521       else do:
      522         assign
      523         p-List_        = (if v-use-List_       then "":U                    else ?)
      524         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      525         p-print-graft  = (if v-use-print-graft then no                      else ?)
      526         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      527         p-type-price   = (if v-use-type-price  then no                      else ?)
      528         p-type-val     = (if v-use-List_       then no                      else ?)
      529         .
      530       end.
      531     end.
      532   end procedure.
      533   procedure uf-set :
      534     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      535     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      536     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      537     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      538     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      539     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      540     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      541     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      542     do
      543     on error undo, return error
      544     :
      545       define buffer buf_usr-flt for ubflt.usr-flt .
      546       define variable v-use-List_     as logical   no-undo .
      547       define variable v-type-List_     as character no-undo .
      548       define variable v-format-List_   as character no-undo .
      549       define variable v-use-Naim      as logical   no-undo .
      550       define variable v-type-Naim      as character no-undo .
      551       define variable v-format-Naim    as character no-undo .
      552       define variable v-use-print-graft as logical   no-undo .
      553       define variable v-use-sort-gr   as logical   no-undo .
      554       define variable v-use-type-price as logical   no-undo .
      555       define variable v-use-type-val  as logical   no-undo .
      556       define variable v-tooltip        as character no-undo .
      557       define variable v-label          as character no-undo .
      558       define variable v-user-can-edit  as logical   no-undo .
      559       define variable v-output-display as logical   no-undo .
      560       define variable v-other          as character no-undo .
      561       run uf-name in this-procedure
      562         (input  entry(1, p-code, chr(4))
      563         ,output v-use-List_
      564         ,output v-type-List_
      565         ,output v-format-List_
      566         ,output v-use-Naim
      567         ,output v-type-Naim
      568         ,output v-format-Naim
      569         ,output v-use-print-graft
      570         ,output v-use-sort-gr
      571         ,output v-use-type-price
      572         ,output v-use-type-val
      573         ,output v-label
      574         ,output v-tooltip
      575         ,output v-user-can-edit
      576         ,output v-output-display
      577         ,output v-other
      578         ) no-error .
      579       if error-status :error then do:
      580         undo, return error return-value .
      581       end.
      582       find first buf_usr-flt where
      583                  buf_usr-flt.Call-point     = p-code AND
      584                  buf_usr-flt.user-name       = p-user-name
      585         no-error .
      586       if not avail buf_usr-flt then do:
      587           create buf_usr-flt .
      588           assign
      589           buf_usr-flt.call-point = p-code
      590           buf_usr-flt.user-name  = p-user-name
      591           .
      592       end.
      593       if avail buf_usr-flt then do:
      594        assign
      595        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      596        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      597        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      598        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      599        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      600        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      601       .
      602       release buf_usr-flt.
      603       end.
      604       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      605     end.
      606   end procedure.
      607   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608     define variable v-cntxt-db-num        as integer   no-undo .
