      998   ASSIGN
      999          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1000          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1001   ASSIGN
     1002          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1003   ASSIGN
     1004          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1005   ASSIGN
     1006          loc_pay-date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1007   ON GO OF FRAME Dialog-Frame
     1008   DO:
     1009     if input loc_prn-doc-code = ""
     1010           or loc_prn-doc-code = ?
     1011     then do:
     1012         message "Номер документа  не может быть не задан" view-as alert-box.
     1013         apply "ENTRY":U to loc_prn-doc-code.
     1014         return no-apply.
     1015     end.
     1016     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
     1017     end.
     1018     if ref-mode <> 'ПРОСМОТР':U then do:
     1019         assign
     1020         loc_prn-doc-code loc_contract-code loc_pay-date loc_receiver-code loc_payer-code loc_exch-rate loc_exch-scale loc_sum-doc T-doc T-rubl loc_base-rate loc_base-scale T-base loc_contract-rate loc_contract-scale T-contract loc_PS loc_receiver-type loc_payer-type loc_curr-code loc_contract-curr
     1021         .
     1022     end.
     1023    run save-p in this-procedure  no-error .
     1024    if error-status :error then return no-apply.
     1025   END.
     1026   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1027   DO:
     1028     APPLY "END-ERROR":U TO SELF.
     1029   END.
     1030   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1031   DO:
     1032   define variable p-recid            as  recid   no-undo .
     1033   define variable p-res              as  logical no-undo .
     1034   define variable v-slt-pc           like fin-ob-tax-before.slt-pc           no-undo.
     1035   define variable v-loc_sum-doc      like fin-ob-tax-before.sum-line-doc     no-undo.
     1036   define variable v-sum-vat-line-doc like fin-ob-tax-before.sum-vat-line-doc no-undo.
     1037   define variable v-sum-slt-line-doc like fin-ob-tax-before.sum-slt-line-doc no-undo.
     1038   define variable v-vat-pc           like fin-ob-tax-before.vat-pc           no-undo.
     1039   define variable v-with-slt         like fin-ob-tax-before.with-slt         no-undo.
     1040   define variable v-with-vat         like fin-ob-tax-before.with-vat         no-undo.
     1041     find current tt_fin-ob-tax-before no-error .
     1042     if not available tt_fin-ob-tax-before then find first tt_fin-ob-tax-before.
     1043       if not available tt_fin-ob-tax-before then return no-apply.
     1044       assign
     1045         p-recid            = recid(tt_fin-ob-tax-before)
     1046         v-slt-pc           = tt_fin-ob-tax-before.slt-pc
     1047         v-loc_sum-doc      = tt_fin-ob-tax-before.sum-line-doc
     1048         v-sum-vat-line-doc = tt_fin-ob-tax-before.sum-vat-line-doc
     1049         v-sum-slt-line-doc = tt_fin-ob-tax-before.sum-slt-line-doc
     1050         v-vat-pc           = tt_fin-ob-tax-before.vat-pc
     1051         v-with-slt         = tt_fin-ob-tax-before.with-slt
     1052         v-with-vat         = tt_fin-ob-tax-before.with-vat
     1053       .
     1054   run str/fi-txli.w (
     1055    input  parParentProc ,
     1056    input  par-host-code   ,
     1057    input  'ИЗМЕНЕНИЕ':U             ,
     1058    input  par-host-code         ,
     1059    input  p-doc-code            ,
     1060    input  'рас':U           ,
     1061    input  loc_sum-doc           ,
     1062    input  loc_curr-code ,
     1063    input  loc_base-rate ,
     1064    input  loc_base-scale,
     1065    input  loc_exch-rate ,
     1066    input  loc_exch-scale,
     1067    input-output v-slt-pc          ,
     1068    input-output v-loc_sum-doc     ,
     1069    input-output v-sum-vat-line-doc,
     1070    input-output v-sum-slt-line-doc,
     1071    input-output v-vat-pc          ,
     1072    input-output v-with-slt        ,
     1073    input-output v-with-vat        ,
     1074    input table tt_fin-ob-tax-before      ,
     1075    input recid (tt_fin-ob-tax-before)     ,
     1076    input ?      ,
     1077    output p-res
     1078     ) no-error .
     1079   if p-res = true then do:
     1080       assign
     1081         tt_fin-ob-tax-before.slt-pc           = v-slt-pc
     1082         tt_fin-ob-tax-before.sum-line-doc     = v-loc_sum-doc
     1083         tt_fin-ob-tax-before.sum-vat-line-doc = v-sum-vat-line-doc
     1084         tt_fin-ob-tax-before.sum-slt-line-doc = v-sum-slt-line-doc
     1085         tt_fin-ob-tax-before.vat-pc           = v-vat-pc
     1086         tt_fin-ob-tax-before.with-slt         = v-with-slt
     1087         tt_fin-ob-tax-before.with-vat         = v-with-vat
     1088       .
     1089       OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     1090       reposition BROWSE-1 TO RECID p-recid NO-ERROR .
     1091       run calc-tax in this-procedure  .
     1092   end.
     1093   END.
     1094   ON return OF B-chg IN FRAME Dialog-Frame
     1095   DO:
     1096     run next-focus in this-procedure  (input  B-chg:handle ) .
     1097     return no-apply .
     1098   END.
     1099   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
     1100   DO:
     1101   assign
     1102      loc_contract-code
     1103   .
     1104   define variable ri as recid no-undo .
     1105   define buffer b_contract for contract.
     1106   find first b_contract no-lock  where b_contract.contract-prn-code = loc_contract-code and
     1107                                        b_contract.host-code         = par-host-code
     1108                                        no-error .
     1109   if error-status :error then return no-apply.
     1110   ri = recid (b_contract) .
     1111   run str/sh-contr.p (
     1112     input   parParentProc ,
     1113     input  ri      )
     1114     .
     1115   END.
     1116   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1117   DO:
     1118   find current tt_fin-ob-tax-before   no-error .
     1119   if not available tt_fin-ob-tax-before  then return .
     1120   define variable g-log as log no-undo.
     1121   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1122   do:
     1123     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1124       (input  v-cntxt-db-num
     1125       ,input  v-cntxt-userid
     1126       ,input  0
     1127       ,input  'actn_fin-liability_deletion':U
     1128       ,input  'firm':U
     1129       ,input  par-host-code
     1130       ,input  '':U
     1131       ,input  0
     1132       ,input  0
     1133       ,input  0
     1134       ,input  0
     1135       ,input  true
     1136       ,output g-log
     1137       )  .
     1138   end.
     1139   if not g-log then  return .
     1140     else do:
     1141         message "Удалить запись ?"
     1142         view-as alert-box question
     1143         buttons yes-no
     1144         update g-log.
     1145         if g-log = false then return no-apply.
     1146     end.
     1147     define variable v-code as integer no-undo .
     1148     delete tt_fin-ob-tax-before .
     1149     run calc-tax in this-procedure .
     1150     OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     1151   END.
     1152   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1153   DO:
     1154       next-prev = ?.
     1155   END.
     1156   ON CHOOSE OF B-ins IN FRAME Dialog-Frame
     1157   DO:
     1158   define variable p-recid            as  recid   no-undo .
     1159   define variable p-res              as  logical no-undo .
     1160   define variable v-slt-pc           like fin-ob-tax-before.slt-pc           no-undo.
     1161   define variable v-loc_sum-doc      like fin-ob-tax-before.sum-line-doc      no-undo.
     1162   define variable v-sum-vat-line-doc like fin-ob-tax-before.sum-vat-line-doc no-undo.
     1163   define variable v-sum-slt-line-doc like fin-ob-tax-before.sum-slt-line-doc no-undo.
     1164   define variable v-vat-pc           like fin-ob-tax-before.vat-pc           no-undo.
     1165   define variable v-with-slt         like fin-ob-tax-before.with-slt         no-undo.
     1166   define variable v-with-vat         like fin-ob-tax-before.with-vat         no-undo.
     1167   run str/fi-txli.w (
     1168    INPUT  parParentProc ,
     1169    input  par-host-code   ,
     1170    input  'ДОБАВЛЕНИЕ':U            ,
     1171    input  par-host-code         ,
     1172    input  p-doc-code            ,
     1173    input 'рас':U             ,
     1174    input  loc_sum-doc           ,
     1175    input  loc_curr-code ,
     1176    input  loc_base-rate ,
     1177    input  loc_base-scale,
     1178    input  loc_exch-rate ,
     1179    input  loc_exch-scale,
     1180    input-output v-slt-pc          ,
     1181    input-output v-loc_sum-doc     ,
     1182    input-output v-sum-vat-line-doc,
     1183    input-output v-sum-slt-line-doc,
     1184    input-output v-vat-pc          ,
     1185    input-output v-with-slt        ,
     1186    input-output v-with-vat        ,
     1187    INPUT TABLE tt_fin-ob-tax-before ,
     1188    input ?      ,
     1189    input ?      ,
     1190    output p-res
     1191     ).
     1192   define variable l-num as integer no-undo .
     1193   l-num = 0.
     1194   if p-res = true then do:
     1195     find last tt_fin-ob-tax-before use-index pi no-error .
     1196        if not available tt_fin-ob-tax-before
     1197               then l-num = 0.
     1198               else l-num = tt_fin-ob-tax-before.line-num.
     1199       l-num = l-num + 1.
     1200       create tt_fin-ob-tax-before.
     1201       assign
     1202         tt_fin-ob-tax-before.before-code      = p-doc-code
     1203         tt_fin-ob-tax-before.host-code        = par-host-code
     1204         tt_fin-ob-tax-before.line-num         = l-num
     1205         tt_fin-ob-tax-before.slt-pc           = v-slt-pc
     1206         tt_fin-ob-tax-before.sum-line-doc     = v-loc_sum-doc
     1207         tt_fin-ob-tax-before.sum-vat-line-doc = v-sum-vat-line-doc
     1208         tt_fin-ob-tax-before.sum-slt-line-doc = v-sum-slt-line-doc
     1209         tt_fin-ob-tax-before.vat-pc           = v-vat-pc
     1210         tt_fin-ob-tax-before.with-slt         = v-with-slt
     1211         tt_fin-ob-tax-before.with-vat         = v-with-vat
     1212       .
     1213   end.
     1214   run calc-tax in this-procedure .
     1215   OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax-before NO-LOCK.
     1216   reposition BROWSE-1 TO RECID p-recid NO-ERROR .
     1217   END.
     1218   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     1219   DO:
     1220   run step-next in this-procedure .
     1221   END.
     1222   ON CHOOSE OF B-payer IN FRAME Dialog-Frame
     1223   DO:
     1224   assign loc_payer-code loc_payer-type .
     1225   run lookup-cli in this-procedure (loc_payer-code , loc_payer-type) no-error .
     1226       if error-status :error then return no-apply.
     1227   END.
     1228   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     1229   DO:
     1230      run step-prev in this-procedure .
     1231   END.
     1232   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1233   DO:
     1234       next-prev = ?.
     1235       message "Выходим без сохранения изменений ?" view-as alert-box question
     1236               buttons yes-no
     1237               update ll as log
     1238               .
     1239       if ll = no then return no-apply.
     1240   END.
     1241   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     1242   DO:
     1243      assign loc_receiver-code loc_receiver-type .
     1244      run lookup-cli in this-procedure  (loc_receiver-code , loc_receiver-type) no-error .
     1245          if error-status :error then return no-apply.
     1246   END.
     1247   ON LEAVE OF loc_base-rate IN FRAME Dialog-Frame
     1248   OR "LEAVE" Of loc_base-scale
     1249   OR "LEAVE" Of loc_exch-rate
     1250   OR "LEAVE" Of loc_exch-scale
     1251   OR "LEAVE" Of loc_contract-rate
     1252   OR "LEAVE" Of loc_contract-scale
     1253   DO:
     1254     assign loc_base-rate loc_base-scale loc_exch-rate loc_exch-scale
     1255     loc_contract-rate
     1256     loc_contract-scale
     1257     .
     1258      if T-doc  then apply "leave" to loc_sum-doc  in frame Dialog-Frame .
     1259      if T-rubl then apply "leave" to loc_sum-rubl in frame Dialog-Frame .
     1260      if T-base then apply "leave" to loc_sum-base in frame Dialog-Frame .
     1261      if T-contract then apply "leave" to loc_sum-contract in frame Dialog-Frame .
     1262   END.
     1263   ON return OF loc_base-rate IN FRAME Dialog-Frame
     1264   DO:
     1265       run next-focus in this-procedure  (input  loc_base-rate:handle ) .
     1266     return no-apply .
     1267   END.
     1268   ON return OF loc_base-scale IN FRAME Dialog-Frame
     1269   DO:
     1270       run next-focus in this-procedure  (input  loc_base-scale:handle ) .
     1271     return no-apply .
     1272   END.
     1273   ON LEAVE OF loc_contract-code IN FRAME Dialog-Frame
     1274   DO:
     1275    define variable old-p  like loc_contract-code no-undo.
     1276    define variable p-quest as logical no-undo .
     1277    define variable v-mess as logical no-undo init false .
     1278    define buffer buf_contract for contract.
     1279    old-p = input frame Dialog-Frame loc_contract-code .
     1280    if (old-p  <> loc_contract-code or pp-modif = true)  then do:
     1281       v-mess = true .
     1282    end.
     1283     assign
     1284       loc_contract-code
     1285       pp-modif = false
     1286     .
     1287     find first buf_contract where buf_contract.contract-prn-code = loc_contract-code
     1288                               and buf_contract.host-code         = par-host-code
     1289                           no-lock no-error .
     1290     if not available buf_contract then do:
     1291        message "Не верно введен Номер договора!!! " view-as alert-box .
     1292        return no-apply.
     1293     end.
     1294     p-quest = true .
     1295     if   v-mess = true  then do :
     1296      message "Изменился договор! Изменить все значения финобязательства по договору "  loc_contract-code " ? " skip
     1297         view-as alert-box question
     1298         buttons YES-NO
     1299         update p-quest .
     1300      end.
     1301         case p-quest :
     1302         when true  then do:
     1303            run from-contract in this-procedure (
     1304                 input buf_contract.contract-code ,
     1305                 input buf_contract.host-code                 ) no-error .
     1306            if error-status :error then return no-apply.
     1307         end.
     1308         when false   then do:
     1309         end.
     1310         otherwise do:
     1311           loc_contract-code = old-p.
     1312           display loc_contract-code with frame Dialog-Frame .
     1313         end.
     1314         end case.
     1315   END.
     1316   ON return OF loc_contract-code IN FRAME Dialog-Frame
     1317   DO:
     1318     run next-focus in this-procedure  (input  loc_contract-code:handle ) .
     1319     return no-apply .
     1320   END.
     1321   ON return OF loc_contract-curr IN FRAME Dialog-Frame
     1322   DO:
     1323         run next-focus in this-procedure  (input  loc_contract-curr:handle ) .
     1324     return no-apply .
     1325   END.
     1326   ON return OF loc_contract-rate IN FRAME Dialog-Frame
     1327   DO:
     1328       run next-focus in this-procedure  (input  loc_contract-rate:handle ) .
     1329     return no-apply .
     1330   END.
     1331   ON return OF loc_contract-scale IN FRAME Dialog-Frame
     1332   DO:
     1333       run next-focus in this-procedure  (input  loc_contract-scale:handle ) .
     1334     return no-apply .
     1335   END.
     1336   ON return OF loc_curr-code IN FRAME Dialog-Frame
     1337   DO:
     1338         run next-focus in this-procedure  (input  loc_curr-code:handle ) .
     1339     return no-apply .
     1340   END.
     1341   ON return OF loc_exch-rate IN FRAME Dialog-Frame
     1342   DO:
     1343       run next-focus in this-procedure  (input  loc_exch-rate:handle ) .
     1344     return no-apply .
     1345   END.
     1346   ON return OF loc_exch-scale IN FRAME Dialog-Frame
     1347   DO:
     1348       run next-focus in this-procedure  (input  loc_exch-scale:handle ) .
     1349     return no-apply .
     1350   END.
     1351   ON return OF loc_pay-date IN FRAME Dialog-Frame
     1352   DO:
     1353         run next-focus in this-procedure  (input  loc_pay-date:handle ) .
     1354     return no-apply .
     1355   END.
     1356   ON LEAVE OF loc_payer-code IN FRAME Dialog-Frame
     1357   DO:
     1358   assign loc_payer-code loc_payer-type.
     1359   define buffer b#clients for clients.
     1360    find first b#clients WHERE
     1361       b#clients.obj-code = loc_payer-code  and
     1362       b#clients.obj-type = loc_payer-type
     1363        No-LOCK No-ERROR.
     1364       if not available b#clients then dO:
     1365          message "Не верно введен код !!!"  view-as alert-box information .
     1366       end.
     1367       if avail b#clients then dO:
     1368           Assign
     1369               loc_payer-code = b#clients.obj-code
     1370               loc_payer-type = b#clients.obj-type
     1371               loc_payer-name = b#clients.obj-name .
     1372       Display  loc_payer-code loc_payer-name loc_payer-type
     1373       with frame Dialog-Frame .
     1374       Enable  loc_payer-code  loc_payer-type
     1375       with frame Dialog-Frame .
     1376       end.
     1377       else
     1378         apply "CHOOSE" to r-obj IN FRAME Dialog-Frame        .
     1379   END.
     1380   ON RETURN OF loc_payer-code IN FRAME Dialog-Frame
     1381   DO:
     1382       run next-focus in this-procedure  (input  loc_payer-code:handle ) .
     1383     return no-apply .
     1384   END.
     1385   ON return OF loc_prn-doc-code IN FRAME Dialog-Frame
     1386   DO:
     1387       run next-focus in this-procedure  (input  loc_prn-doc-code:handle ) .
     1388     return no-apply .
     1389   END.
     1390   ON LEAVE OF loc_receiver-code IN FRAME Dialog-Frame
     1391   DO:
     1392       assign loc_receiver-code loc_receiver-type.
     1393   define buffer b#clients for clients.
     1394    find first b#clients WHERE
     1395       loc_receiver-code = b#clients.obj-code and
     1396       loc_receiver-type = b#clients.obj-type
     1397        No-LOCK No-ERROR.
     1398       if not available b#clients then dO:
     1399          message "Не верно введен код !!!"  view-as alert-box information .
     1400       end.
     1401       if avail b#clients then do:
     1402           Assign
     1403               loc_receiver-code = b#clients.obj-code
     1404               loc_receiver-type = b#clients.obj-type
     1405               loc_receiver-name = b#clients.obj-name
     1406               .
     1407       Display  loc_receiver-code loc_receiver-name loc_receiver-type
     1408       with frame Dialog-Frame .
     1409       Enable  loc_receiver-code  loc_receiver-type
     1410       with frame Dialog-Frame .
     1411   end.
     1412   else   apply "CHOOSE" to r-cli IN FRAME Dialog-Frame        .
     1413   END.
     1414   ON return OF loc_receiver-code IN FRAME Dialog-Frame
     1415   DO:
     1416         run next-focus in this-procedure  (input  loc_receiver-code:handle ) .
     1417     return no-apply .
     1418   END.
     1419   ON LEAVE OF loc_sum-base IN FRAME Dialog-Frame
     1420   DO:
     1421   define variable v-mod as logical no-undo .
     1422    v-mod = loc_sum-base:MODIFIED.
     1423   assign loc_sum-base loc_sum-tax-base
     1424    loc_base-rate loc_base-scale
     1425    loc_exch-rate loc_exch-scale
     1426    loc_contract-rate loc_contract-scale
     1427    .
     1428     loc_sum-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-base .
     1429     loc_sum-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-rubl .
     1430     loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
     1431     if v-mod  then
     1432        run create-tax in this-procedure (
     1433             input loc_sum-doc ,
     1434             input loc_sum-rubl  ,
     1435             input loc_sum-base   ,
     1436             input loc_sum-contract ,
     1437             input "base":U ,
     1438             output loc_sum-tax-base) .
     1439     loc_sum-tax-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-tax-base .
     1440     loc_sum-tax-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-tax-rubl .
     1441     loc_sum-tax-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-tax-rubl .
     1442     display
     1443       loc_sum-doc          when loc_sum-doc          :visible
     1444       loc_sum-base         when loc_sum-base         :visible
     1445       loc_sum-rubl         when loc_sum-rubl         :visible
     1446       loc_sum-contract     when loc_sum-contract     :visible
     1447       loc_sum-tax-doc      when loc_sum-tax-doc      :visible
     1448       loc_sum-tax-rubl     when loc_sum-tax-rubl     :visible
     1449       loc_sum-tax-contract when loc_sum-tax-contract :visible
     1450       loc_sum-tax-base     when loc_sum-tax-base     :visible
     1451       with frame Dialog-Frame.
     1452   END.
     1453   ON return OF loc_sum-base IN FRAME Dialog-Frame
     1454   DO:
     1455       run next-focus in this-procedure  (input  loc_sum-base:handle ) .
     1456     return no-apply .
     1457   END.
     1458   ON LEAVE OF loc_sum-contract IN FRAME Dialog-Frame
     1459   DO:
     1460   define variable v-mod as logical no-undo .
     1461    v-mod = loc_sum-contract:MODIFIED.
     1462    assign loc_sum-contract loc_sum-tax-contract
     1463    loc_base-rate loc_base-scale
     1464    loc_exch-rate loc_exch-scale
     1465    loc_contract-rate loc_contract-scale
     1466    .
     1467     loc_sum-rubl  =  ( loc_contract-rate  / loc_contract-scale) * loc_sum-contract .
     1468     loc_sum-base   = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl .
     1469     loc_sum-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-rubl .
     1470     if v-mod  then
     1471        run create-tax in this-procedure (
     1472             input loc_sum-doc   ,
     1473             input loc_sum-rubl  ,
     1474             input loc_sum-base  ,
     1475             input loc_sum-contract ,
     1476             input "contract":U ,
     1477             output loc_sum-tax-contract) .
     1478     loc_sum-tax-rubl  =  ( loc_contract-rate  / loc_contract-scale) * loc_sum-tax-contract .
     1479     loc_sum-tax-base   = (  loc_base-scale   / loc_base-rate) * loc_sum-tax-rubl .
     1480     loc_sum-tax-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-tax-rubl .
     1481     display
     1482     loc_sum-base           when loc_sum-base         :visible
     1483     loc_sum-rubl           when loc_sum-rubl         :visible
     1484     loc_sum-tax-base       when loc_sum-tax-base     :visible
     1485     loc_sum-tax-rubl       when loc_sum-tax-rubl     :visible
     1486     loc_sum-contract       when loc_sum-contract     :visible
     1487     loc_sum-tax-contract   when loc_sum-tax-contract :visible
     1488     loc_sum-doc            when loc_sum-doc          :visible
     1489     loc_sum-tax-doc        when loc_sum-tax-doc      :visible
     1490     loc_sum-tax-contract   when loc_sum-tax-contract :visible
     1491     with frame Dialog-Frame.
     1492    END.
     1493   ON return OF loc_sum-contract IN FRAME Dialog-Frame
     1494   DO:
     1495         run next-focus in this-procedure  (input  loc_sum-contract:handle ) .
     1496     return no-apply .
     1497   END.
     1498   ON LEAVE OF loc_sum-doc IN FRAME Dialog-Frame
     1499   DO:
     1500   define variable v-mod as logical no-undo .
     1501    v-mod = loc_sum-doc:MODIFIED.
     1502    assign loc_sum-doc loc_sum-tax-doc
     1503    loc_base-rate loc_base-scale
     1504    loc_exch-rate loc_exch-scale
     1505    loc_contract-rate loc_contract-scale
     1506    .
     1507     loc_sum-rubl    =  ( loc_exch-rate  / loc_exch-scale) * loc_sum-doc .
     1508     loc_sum-base    = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl .
     1509     loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
     1510     if v-mod  then
     1511        run create-tax in this-procedure (
     1512             input loc_sum-doc ,
     1513             input loc_sum-rubl  ,
     1514             input loc_sum-base   ,
     1515             input loc_sum-contract ,
     1516             input "doc":U ,
     1517             output loc_sum-tax-doc) .
     1518     loc_sum-tax-rubl       = ( loc_exch-rate        / loc_exch-scale)    * loc_sum-tax-doc .
     1519     loc_sum-tax-base       = (  loc_base-scale      / loc_base-rate)     * loc_sum-tax-rubl .
     1520     loc_sum-tax-contract   = (  loc_contract-scale  / loc_contract-rate) * loc_sum-tax-rubl .
     1521     display
     1522         loc_sum-base          when loc_sum-base         :visible
     1523         loc_sum-rubl          when loc_sum-rubl         :visible
     1524         loc_sum-contract      when loc_sum-contract     :visible
     1525         loc_sum-tax-base      when loc_sum-tax-base     :visible
     1526         loc_sum-tax-rubl      when loc_sum-tax-rubl     :visible
     1527         loc_sum-tax-contract  when loc_sum-tax-contract :visible
     1528         loc_sum-tax-doc       when loc_sum-tax-doc      :visible
     1529         with frame Dialog-Frame
     1530         .
     1531    END.
     1532   ON return OF loc_sum-doc IN FRAME Dialog-Frame
     1533   DO:
     1534         run next-focus in this-procedure  (input  loc_sum-doc:handle ) .
     1535     return no-apply .
     1536   END.
     1537   ON LEAVE OF loc_sum-rubl IN FRAME Dialog-Frame
     1538   DO:
     1539   define variable v-mod as logical no-undo .
     1540    v-mod = loc_sum-rubl:MODIFIED.
     1541   assign loc_sum-rubl loc_sum-tax-rubl
     1542    loc_base-rate loc_base-scale
     1543    loc_exch-rate loc_exch-scale
     1544    loc_contract-rate loc_contract-scale
     1545    .
     1546     loc_sum-base    = ( loc_base-scale  / loc_base-rate) * loc_sum-rubl .
     1547     loc_sum-doc      = (  loc_exch-scale    / loc_exch-rate) * loc_sum-rubl .
     1548     loc_sum-contract      = (  loc_contract-scale    / loc_contract-rate) * loc_sum-rubl .
     1549     if v-mod  then
     1550        run create-tax in this-procedure (
     1551             input loc_sum-doc   ,
     1552             input loc_sum-rubl  ,
     1553             input loc_sum-base  ,
     1554             input loc_sum-contract ,
     1555             input "rubl":U ,
     1556             output loc_sum-tax-rubl) .
     1557     loc_sum-tax-base     = ( loc_base-scale  / loc_base-rate) * loc_sum-tax-rubl .
     1558     loc_sum-tax-doc      = (  loc_exch-scale    / loc_exch-rate) * loc_sum-tax-rubl .
     1559     loc_sum-tax-contract = (  loc_contract-scale    / loc_contract-rate) * loc_sum-tax-rubl .
     1560     display
     1561     loc_sum-base            when loc_sum-base         :visible
     1562     loc_sum-doc             when loc_sum-doc          :visible
     1563     loc_sum-tax-base        when loc_sum-tax-base     :visible
     1564     loc_sum-tax-doc         when loc_sum-tax-doc      :visible
     1565     loc_sum-contract        when loc_sum-contract     :visible
     1566     loc_sum-tax-contract    when loc_sum-tax-contract :visible
     1567     loc_sum-tax-rubl        when loc_sum-tax-rubl     :visible
     1568     with frame Dialog-Frame.
     1569   END.
     1570   ON return OF loc_sum-rubl IN FRAME Dialog-Frame
     1571   DO:
     1572       run next-focus in this-procedure  (input  loc_sum-rubl:handle ) .
     1573     return no-apply .
     1574   END.
     1575   ON return OF p-doc-code IN FRAME Dialog-Frame
     1576   DO:
     1577       run next-focus in this-procedure  (input  p-doc-code:handle ) .
     1578     return no-apply .
     1579   END.
     1580   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
     1581   DO:
     1582     define variable rid-list    as  char no-undo .
     1583     define variable rep-rec2 as recid no-undo .
     1584     define buffer b#clients for clients.
     1585       run ref/cli-all.w ( parParentProc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     1586       Assign rep-rec2 = integer(rid-list) no-error.
     1587       find first b#clients WHERE recid(b#clients) = rep-rec2 No-LOCK No-ERROR.
     1588       if avail b#clients then do:
     1589           Assign
     1590               loc_receiver-code = b#clients.obj-code
     1591               loc_receiver-type = b#clients.obj-type
     1592               loc_receiver-name = b#clients.obj-name .
     1593       end.
     1594       Display  loc_receiver-code loc_receiver-name loc_receiver-type
     1595       with frame Dialog-Frame .
     1596       Enable  loc_receiver-code  loc_receiver-type
     1597       with frame Dialog-Frame .
     1598   END.
     1599   ON CHOOSE OF r-con IN FRAME Dialog-Frame
     1600   DO:
     1601   define variable   p-rid-list   as character no-undo .
     1602   define buffer buf_contract for contract.
     1603    pp-modif = false .
     1604     run str/cont-all.w (
     1605         input   parParentProc   ,
     1606         input   par-host-code   ,
     1607         input   "b-sel"         ,
     1608         input   'фирма':U      ,
     1609         input   ?               ,
     1610         input   ?               ,
     1611         input   ?               ,
     1612         input   ?               ,
     1613         input   "current"       ,
     1614         input   'при':U       ,
     1615         input-output p-rid-list )
     1616         .
     1617   find first buf_contract no-lock where recid(buf_contract) = integer(p-rid-list) no-error .
     1618   if available buf_contract then do:
     1619      if loc_contract-code <> buf_contract.contract-prn-code then pp-modif = true .
     1620      if loc_contract-code = "" then pp-modif = false .
     1621      loc_contract-code = buf_contract.contract-prn-code.
     1622      display loc_contract-code with frame Dialog-Frame.
     1623            run from-contract in this-procedure (
     1624                 input buf_contract.contract-code ,
     1625                 input buf_contract.host-code
     1626                 ) no-error .
     1627       if error-status :error then do:
     1628           if error-status :get-message(1) <> "" then
     1629           message
     1630             vss-workfile vss-revision vss-description skip
     1631             error-status :get-message(1) skip
     1632             return-value skip
     1633             "Ошибка при проверке договора"
     1634             view-as alert-box error
     1635           .
     1636           return no-apply.
     1637       end.
     1638       run next-focus in this-procedure  (input loc_contract-code:handle ) .
     1639   end.
     1640   END.
     1641   ON CHOOSE OF r-cur IN FRAME Dialog-Frame
     1642   DO:
     1643   define variable ref-rec as recid no-undo.
     1644   run ref/currency.w (input parparentproc, "b-sel", input-output ref-rec ).
     1645   if ref-rec = ? then return no-apply.
     1646   find currency where recid ( currency ) = ref-rec no-lock.
     1647   loc_curr-code  = currency.curr-code .
     1648   loc_abbr-doc   = currency.curr-abbr .
     1649   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1651     (input  loc_curr-code
     1652     ,input  loc_doc-date
     1653     ,output loc_exch-rate
     1654     ,output loc_exch-scale
     1655     ,output loc_abbr-doc
     1656     )  .
     1657   display
     1658     loc_curr-code
     1659     loc_abbr-doc
     1660     loc_exch-rate
     1661     loc_exch-scale
     1662     with frame Dialog-Frame .
     1663    apply "LEAVE" to loc_exch-rate  in frame Dialog-Frame .
     1664    run hide-curr in this-procedure ( input "pay":U ) .
     1665   END.
     1666   ON CHOOSE OF r-cur-contr IN FRAME Dialog-Frame
     1667   DO:
     1668   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1670     (input  loc_contract-curr
     1671     ,input  loc_doc-date
     1672     ,output loc_contract-rate
     1673     ,output loc_contract-scale
     1674     ,output loc_abbr-contract
     1675     )  .
     1676   display
     1677     loc_contract-curr
     1678     loc_abbr-contract
     1679     loc_contract-rate
     1680     loc_contract-scale
     1681     with frame Dialog-Frame .
     1682    apply "LEAVE" to loc_contract-rate  in frame Dialog-Frame .
     1683   END.
     1684   ON CHOOSE OF r-obj IN FRAME Dialog-Frame
     1685   DO:
     1686   define variable rid-list    as  char no-undo .
     1687   define variable rep-rec2 as recid no-undo .
     1688   define buffer b#clients for clients.
     1689       run ref/cli-all.w ( parParentProc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     1690       Assign rep-rec2 = integer(rid-list) no-error.
     1691       find first b#clients WHERE recid(b#clients) = rep-rec2 No-LOCK No-ERROR.
     1692       if avail b#clients then do:
     1693           Assign
     1694               loc_payer-code = b#clients.obj-code
     1695               loc_payer-type = b#clients.obj-type
     1696               loc_payer-name = b#clients.obj-name .
     1697       end.
     1698       Display  loc_payer-code loc_payer-name loc_payer-type
     1699       with frame Dialog-Frame .
     1700       Enable  loc_payer-code  loc_payer-type with frame Dialog-Frame .
     1701   END.
     1702   ON VALUE-CHANGED OF T-base IN FRAME Dialog-Frame
     1703   DO:
     1704    assign t-base.
     1705     if t-base = yes then do:
     1706         enable
     1707           loc_sum-base
     1708           with frame Dialog-Frame.
     1709         disable
     1710           loc_sum-rubl     loc_sum-doc      loc_sum-contract
     1711           with frame Dialog-Frame.
     1712         t-rubl = no.
     1713         t-doc = no.
     1714         t-contract = no.
     1715         display
     1716             t-rubl      when t-rubl:visible
     1717             t-doc
     1718             t-contract  when t-contract:visible
     1719             with frame  Dialog-Frame.
     1720       end.
     1721           else do:
     1722            t-base = yes.
     1723            display t-base with frame  Dialog-Frame.
     1724            end.
     1725   loc_in-type            = 1.
     1726   END.
     1727   ON VALUE-CHANGED OF T-contract IN FRAME Dialog-Frame
     1728   DO:
     1729     assign t-contract.
     1730     if t-contract = yes then do:
     1731         enable
     1732            loc_sum-contract
     1733            with frame Dialog-Frame.
     1734         disable
     1735            loc_sum-rubl     loc_sum-base     loc_sum-doc
     1736            with frame Dialog-Frame.
     1737         t-rubl = no.
     1738         t-base = no.
     1739         t-doc = no.
     1740         display
     1741            t-rubl   when t-rubl:visible
     1742            t-base   when t-base:visible
     1743            t-doc
     1744            with frame  Dialog-Frame.
     1745       end.
     1746       else do:
     1747            t-contract = yes.
     1748            display t-contract with frame  Dialog-Frame.
     1749            end.
     1750     loc_in-type = 3.
     1751   END.
     1752   ON VALUE-CHANGED OF T-doc IN FRAME Dialog-Frame
     1753   DO:
     1754     assign t-doc.
     1755     if t-doc = yes then do:
     1756         enable
     1757            loc_sum-doc
     1758            with frame Dialog-Frame.
     1759         disable
     1760            loc_sum-rubl     loc_sum-base     loc_sum-contract
     1761            with frame Dialog-Frame.
     1762         t-rubl = no.
     1763         t-base = no.
     1764         t-contract = no.
     1765         display
     1766            t-rubl  when t-rubl:visible
     1767            t-base  when t-base:visible
     1768            t-contract  when t-contract:visible
     1769            with frame  Dialog-Frame.
     1770       end.
     1771       else do:
     1772            t-doc = yes.
     1773            display t-doc with frame  Dialog-Frame.
     1774            end.
     1775     loc_in-type = 0.
     1776   END.
     1777   ON VALUE-CHANGED OF T-rubl IN FRAME Dialog-Frame
     1778   DO:
     1779     assign t-rubl.
     1780     if t-rubl = yes then do:
     1781         enable
     1782            loc_sum-rubl
     1783            with frame Dialog-Frame.
     1784         disable
     1785           loc_sum-doc     loc_sum-base     loc_sum-contract
     1786           with frame Dialog-Frame.
     1787         t-doc = no.
     1788         t-base = no.
     1789         t-contract = no.
     1790         display
     1791         t-doc
     1792         t-base      when t-base:visible
     1793         t-contract  when t-contract:visible
     1794         with frame  Dialog-Frame.
     1795       end.
     1796       else do:
     1797            t-rubl = yes.
     1798            display t-rubl with frame  Dialog-Frame.
     1799            end.
     1800     loc_in-type            = 2.
     1801   END.
     1802   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1803   define buffer buf_file for ub.fin-ob .
     1804   procedure current-db :
     1805    do
     1806    on error undo, return error return-value
     1807    :
     1808   define input parameter  p-host-code as integer no-undo .
     1809   define input parameter  c-host-code as integer no-undo .
     1810   define output parameter ret         as logical no-undo .
     1811   define buffer current_sysconf for ub.sysconf.
     1812   define variable v-current-db as integer no-undo .
     1813   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1814   if error-status :error then return error .
     1815      v-current-db = current_sysconf.firm-db-num .
     1816      ret = true .
     1817   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     1818   if not( ub.sysconf.firm-db-num = v-current-db or
     1819           ub.sysconf.firm-db-num = 0 )
     1820     then do:
     1821     ret = false .
     1822     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     1823     return .
     1824   end.
     1825    end.
     1826   end procedure.
     1827   procedure ver-db :
     1828    do
     1829    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1830    :
     1831   define input parameter  c-host-code as integer no-undo .
     1832   define input parameter  par-ver-db  as integer no-undo .
     1833   define input parameter  p-mess as logical no-undo .
     1834   define output parameter ret         as logical no-undo .
     1835   define buffer current_sysconf for ub.sysconf.
     1836   define variable v-current-db as integer no-undo .
     1837   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1838   if error-status :error then return error .
     1839      v-current-db = current_sysconf.firm-db-num .
     1840      ret = true .
     1841   if not( par-ver-db = v-current-db or
     1842           par-ver-db = 0 )
     1843     then do:
     1844     ret = false .
     1845     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     1846     return .
     1847   end.
     1848    end.
     1849   end procedure.
     1850   procedure fin-ob-code :
     1851    do
     1852    on error undo, return error return-value
     1853    :
     1854     define input  parameter p-db-num as integer no-undo .
     1855     define output parameter p-fin-ob-code  as character no-undo .
     1856     if p-db-num = 0 then
     1857         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
     1858         else
     1859         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
     1860    end.
     1861   end procedure.
     1862   procedure create-fin-liab :
     1863    do
     1864    on error undo, return error return-value
     1865    :
     1866   define input parameter p-ver as logical no-undo .
     1867   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     1868   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     1869   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     1870   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     1871   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     1872   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     1873   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     1874   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     1875   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     1876   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     1877   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     1878   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     1879   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     1880   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     1881   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     1882   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     1883   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     1884   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     1885   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     1886   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     1887   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     1888   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     1889   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     1890   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     1891   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     1892   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     1893   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     1894   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     1895   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     1896   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     1897   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     1898   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     1899   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     1900   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     1901   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     1902   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     1903   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     1904   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     1905   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     1906   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     1907   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     1908   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     1909   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     1910   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     1911   define output parameter p-rec-id as recid no-undo .
     1912   if p-ver then do:
     1913       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1914                                           buf_file.doc-code  = p-doc-code no-error .
     1915       if available buf_file then return error .
     1916   end.
     1917   define variable p-ret as logical no-undo .
     1918   run current-db in this-procedure (
     1919       input p-host-code,
     1920       input p-host-code,
     1921       output p-ret ) .
     1922    if p-ret = no then return.
     1923   p-rec-id = ? .
     1924    create ub.fin-ob.
     1925    assign
     1926      ub.fin-ob.host-code     =     p-host-code
     1927      ub.fin-ob.doc-code      =     p-doc-code
     1928      ub.fin-ob.status_       =     p-status_
     1929      ub.fin-ob.doc-date      =     p-doc-date
     1930      ub.fin-ob.doc-type      =     p-doc-type
     1931      ub.fin-ob.payer-name    =     p-payer-name
     1932      ub.fin-ob.receiver-name =     p-receiver-name
     1933      ub.fin-ob.curr-code     =     p-curr-code
     1934      ub.fin-ob.user-db-num-doc =   p-user-db-num-doc
     1935      ub.fin-ob.user-name-doc   =   p-user-name-doc
     1936      ub.fin-ob.base-rate     =     p-base-rate
     1937      ub.fin-ob.base-scale    =     p-base-scale
     1938      ub.fin-ob.receiver-code =     p-receiver-code
     1939      ub.fin-ob.receiver-type =     p-receiver-type
     1940      ub.fin-ob.contract-code =     p-contract-code
     1941      ub.fin-ob.exch-rate     =     p-exch-rate
     1942      ub.fin-ob.exch-scale    =     p-exch-scale
     1943      ub.fin-ob.contract-curr =     p-contract-curr
     1944      ub.fin-ob.contract-rate =     p-contract-rate
     1945      ub.fin-ob.contract-scale =    p-contract-scale
     1946      ub.fin-ob.fact-date     =     p-fact-date
     1947      ub.fin-ob.fact-order    =     p-fact-order
     1948      ub.fin-ob.host-code     =     p-host-code
     1949      ub.fin-ob.payer-code    =     p-payer-code
     1950      ub.fin-ob.payer-type    =     p-payer-type
     1951      ub.fin-ob.pay-date      =     p-pay-date
     1952      ub.fin-ob.prn-doc-code  =     p-prn-doc-code
     1953      ub.fin-ob.status_       =     p-status_
     1954      ub.fin-ob.sum-doc       =     p-sum-doc
     1955      ub.fin-ob.sum-base      =     p-sum-base
     1956      ub.fin-ob.sum-contract  =     p-sum-contract
     1957      ub.fin-ob.sum-rubl      =     p-sum-rubl
     1958      ub.fin-ob.sum-tax-doc   =     p-sum-tax-doc
     1959      ub.fin-ob.sum-tax-base  =     p-sum-tax-base
     1960      ub.fin-ob.sum-tax-contract =  p-sum-tax-contract
     1961      ub.fin-ob.sum-tax-rubl  =     p-sum-tax-rubl
     1962      ub.fin-ob.sum-doc-orig  =     p-sum-doc-orig
     1963      ub.fin-ob.sum-rubl-orig =     p-sum-rubl-orig
     1964      ub.fin-ob.sum-base-orig =     p-sum-base-orig
     1965      ub.fin-ob.trn-doc-code  =     p-trn-doc-code
     1966      ub.fin-ob.user-db-num-fact =  p-user-db-num-fact
     1967      ub.fin-ob.user-db-num-pay  =  p-user-db-num-pay
     1968      ub.fin-ob.user-name-fact   =  p-user-name-fact
     1969      ub.fin-ob.user-name-pay    =  p-user-name-pay
     1970      ub.fin-ob.in-type          =  p-in-type
     1971      ub.fin-ob.ps               =  p-PS
     1972     no-error .
     1973     if error-status :error then do:
     1974         message vss-include-info6 skip
     1975                 error-status :get-message(1)
     1976                 view-as alert-box error .
     1977         return error .
     1978     end.
     1979     if ub.fin-ob.status_ = 'факт':U then
     1980       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
     1981     p-rec-id = recid(fin-ob) .
     1982    end.
     1983   end procedure.
     1984   procedure create-fin-ob-before :
     1985    do
     1986    on error undo, return error return-value
     1987    :
     1988   define input parameter p-ver as logical no-undo .
     1989   define input parameter p-doc-id              like ub.fin-ob-before.before-code             no-undo .
     1990   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     1991   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     1992   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     1993   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     1994   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     1995   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     1996   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     1997   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     1998   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     1999   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     2000   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     2001   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     2002   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     2003   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     2004   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     2005   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     2006   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     2007   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     2008   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     2009   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     2010   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     2011   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     2012   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     2013   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     2014   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     2015   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     2016   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     2017   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     2018   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     2019   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     2020   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     2021   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     2022   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     2023   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     2024   define input parameter p-trn-doc-code-orig   like ub.fin-ob.trn-doc-code         no-undo .
     2025   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     2026   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     2027   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     2028   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     2029   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     2030   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     2031   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     2032   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     2033   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     2034   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     2035   define output parameter p-rec-id as recid no-undo .
     2036   define buffer buf_file for ub.fin-ob-before .
     2037   if p-ver then do:
     2038       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     2039                                           buf_file.doc-code  = p-doc-code  and
     2040                                           buf_file.before-code =  p-doc-id
     2041                                           no-error .
     2042       if available buf_file then return error .
     2043   end.
     2044   define variable p-ret as logical no-undo .
     2045   run current-db in this-procedure  (
     2046       input p-host-code,
     2047       input p-host-code,
     2048       output p-ret ) .
     2049    if p-ret = no then return.
     2050   p-rec-id = ? .
     2051    create ub.fin-ob-before.
     2052    assign
     2053      ub.fin-ob-before.before-code   =  p-doc-id
     2054      ub.fin-ob-before.host-code     =     p-host-code
     2055      ub.fin-ob-before.doc-code      =     p-doc-code
     2056      ub.fin-ob-before.status_       =     p-status_
     2057      ub.fin-ob-before.doc-date      =     p-doc-date
     2058      ub.fin-ob-before.doc-type      =     p-doc-type
     2059      ub.fin-ob-before.payer-name    =     p-payer-name
     2060      ub.fin-ob-before.receiver-name =     p-receiver-name
     2061      ub.fin-ob-before.curr-code     =     p-curr-code
     2062      ub.fin-ob-before.user-db-num-doc =   p-user-db-num-doc
     2063      ub.fin-ob-before.user-name-doc   =   p-user-name-doc
     2064      ub.fin-ob-before.base-rate     =     p-base-rate
     2065      ub.fin-ob-before.base-scale    =     p-base-scale
     2066      ub.fin-ob-before.receiver-code =     p-receiver-code
     2067      ub.fin-ob-before.receiver-type =     p-receiver-type
     2068      ub.fin-ob-before.contract-code =     p-contract-code
     2069      ub.fin-ob-before.exch-rate     =     p-exch-rate
     2070      ub.fin-ob-before.exch-scale    =     p-exch-scale
     2071      ub.fin-ob-before.contract-curr =     p-contract-curr
     2072      ub.fin-ob-before.contract-rate =     p-contract-rate
     2073      ub.fin-ob-before.contract-scale =    p-contract-scale
     2074      ub.fin-ob-before.fact-date     =     p-fact-date
     2075      ub.fin-ob-before.fact-order    =     p-fact-order
     2076      ub.fin-ob-before.host-code     =     p-host-code
     2077      ub.fin-ob-before.payer-code    =     p-payer-code
     2078      ub.fin-ob-before.payer-type    =     p-payer-type
     2079      ub.fin-ob-before.pay-date      =     p-pay-date
     2080      ub.fin-ob-before.prn-doc-code  =     p-prn-doc-code
     2081      ub.fin-ob-before.status_       =     p-status_
     2082      ub.fin-ob-before.sum-doc       =     p-sum-doc
     2083      ub.fin-ob-before.sum-base      =     p-sum-base
     2084      ub.fin-ob-before.sum-contract  =     p-sum-contract
     2085      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
     2086      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
     2087      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
     2088      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
     2089      ub.fin-ob-before.sum-tax-rubl  =     p-sum-tax-rubl
     2090      ub.fin-ob-before.sum-doc-orig  =     p-sum-doc-orig
     2091      ub.fin-ob-before.sum-rubl-orig =     p-sum-rubl-orig
     2092      ub.fin-ob-before.sum-base-orig =     p-sum-base-orig
     2093      ub.fin-ob-before.trn-doc-code  =     p-trn-doc-code
     2094      ub.fin-ob-before.trn-doc-code-orig  =     p-trn-doc-code-orig
     2095      ub.fin-ob-before.user-db-num-fact =  p-user-db-num-fact
     2096      ub.fin-ob-before.user-db-num-pay  =  p-user-db-num-pay
     2097      ub.fin-ob-before.user-name-fact   =  p-user-name-fact
     2098      ub.fin-ob-before.user-name-pay    =  p-user-name-pay
     2099      ub.fin-ob-before.in-type          =  p-in-type
     2100      ub.fin-ob-before.ps               =  p-ps
     2101     no-error .
     2102     if error-status :error then do:
     2103         message vss-include-info6 skip
     2104                 error-status :get-message(1)
     2105                 view-as alert-box error .
     2106         return error .
     2107     end.
     2108     p-rec-id = recid(fin-ob-before) .
     2109    end.
     2110   end procedure.
     2111   procedure make-tax :
     2112    do
     2113    on error undo, return error return-value
     2114    :
     2115   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     2116   define input parameter p-host-code as integer no-undo .
     2117   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2118   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     2119   define buffer buf_fin-ob       for  ub.fin-ob     .
     2120   define variable v-line              as integer no-undo .
     2121   define variable v-sum               as decimal no-undo .
     2122   define variable v-sum-rubl          as decimal no-undo .
     2123   define variable v-sum-base          as decimal no-undo .
     2124   define variable v-sum-contract      as decimal no-undo .
     2125   define variable v-sum-slt           as decimal no-undo .
     2126   define variable v-sum-rubl-slt      as decimal no-undo .
     2127   define variable v-sum-base-slt      as decimal no-undo .
     2128   define variable v-sum-contract-slt  as decimal no-undo .
     2129   define variable v-sum-vat           as decimal no-undo .
     2130   define variable v-sum-rubl-vat      as decimal no-undo .
     2131   define variable v-sum-base-vat      as decimal no-undo .
     2132   define variable v-sum-contract-vat  as decimal no-undo .
     2133   define variable v-tax-sum           as decimal no-undo .
     2134   define variable v-tax-sum-rubl      as decimal no-undo .
     2135   define variable v-tax-sum-base      as decimal no-undo .
     2136   define variable v-tax-sum-contr     as decimal no-undo .
     2137   define variable v-tax-sum-doc       as decimal no-undo .
     2138   define variable var-doc             as decimal no-undo .
     2139   define variable var-doc-slt         as decimal no-undo .
     2140   define variable var-doc-vat         as decimal no-undo .
     2141   define variable v-basecode as integer no-undo .
     2142   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2144     (input  p-host-code
     2145     ,output v-basecode
     2146     )  .
     2147   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2148                                               buf_fin-ob.doc-code  = p-doc-code
     2149                                               on error undo, return error :
     2150      assign
     2151       v-tax-sum-rubl  = 0
     2152       v-tax-sum-base  = 0
     2153       v-tax-sum-contr = 0
     2154       v-tax-sum-doc   = 0
     2155       v-sum           = 0
     2156       v-sum-rubl      = 0
     2157       v-sum-base      = 0
     2158       v-sum-contract  = 0
     2159       v-sum-vat       = 0
     2160       v-sum-rubl-vat  = 0
     2161       v-sum-base-vat  = 0
     2162       v-sum-contract-vat  = 0
     2163       v-sum-slt           = 0
     2164       v-sum-rubl-slt      = 0
     2165       v-sum-base-slt      = 0
     2166       v-sum-contract-slt  = 0
     2167       v-line = 0
     2168       .
     2169       for each buf_fin-gds-part no-lock where
     2170                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2171                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2172                break  by buf_fin-gds-part.SLT-pc
     2173                       by buf_fin-gds-part.vat-pc
     2174                on error undo, return error :
     2175                 case buf_fin-ob.curr-code:
     2176                   when 0 then do :
     2177                   assign
     2178                   var-doc      =  buf_fin-gds-part.sum-rubl
     2179                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
     2180                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
     2181                   .
     2182                   end.
     2183                   when v-basecode then do :
     2184                   assign
     2185                   var-doc      =  buf_fin-gds-part.sum-base
     2186                   var-doc-slt  =  buf_fin-gds-part.slt-base
     2187                   var-doc-vat  =  buf_fin-gds-part.vat-base
     2188                   .
     2189                   end.
     2190                   when buf_fin-ob.contract-curr then do :
     2191                   assign
     2192                   var-doc      =  buf_fin-gds-part.sum-contract
     2193                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     2194                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     2195                   .
     2196                   end.
     2197                 end case.
     2198                assign
     2199                  v-sum           = v-sum          + var-doc
     2200                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     2201                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     2202                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     2203                  v-sum-slt           = v-sum-slt          + var-doc-slt
     2204                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     2205                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     2206                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     2207                  v-sum-vat           = v-sum-vat          + var-doc-vat
     2208                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     2209                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     2210                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     2211                .
     2212                if last-of(buf_fin-gds-part.vat-pc) then do:
     2213                   v-line = v-line + 1.
     2214                   create buf_fin-ob-tax.
     2215                   assign
     2216                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     2217                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     2218                       buf_fin-ob-tax.line-num           = v-line
     2219                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     2220                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     2221                       buf_fin-ob-tax.with-slt           = true
     2222                       buf_fin-ob-tax.with-vat           = true
     2223                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     2224                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     2225                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     2226                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     2227                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     2228                       buf_fin-ob-tax.sum-line-doc        = v-sum
     2229                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     2230                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     2231                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     2232                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     2233                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     2234                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     2235                       .
     2236                       assign
     2237                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     2238                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     2239                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     2240                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     2241                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     2242                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     2243                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     2244                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     2245                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     2246                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     2247                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     2248                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     2249                       .
     2250                       assign
     2251                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     2252                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     2253                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     2254                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     2255                       .
     2256                       assign
     2257                       v-sum  = 0
     2258                       v-sum-rubl      = 0
     2259                       v-sum-base      = 0
     2260                       v-sum-contract  = 0
     2261                       v-sum-slt           =0
     2262                       v-sum-rubl-slt      =0
     2263                       v-sum-base-slt      =0
     2264                       v-sum-contract-slt  =0
     2265                       v-sum-vat           =0
     2266                       v-sum-rubl-vat      =0
     2267                       v-sum-base-vat      =0
     2268                       v-sum-contract-vat  =0
     2269                       .
     2270                 end.
     2271       end.
     2272       assign
     2273         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     2274         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     2275         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     2276         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     2277         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     2278         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     2279         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     2280         buf_fin-ob.base-scale       = 1
     2281         buf_fin-ob.exch-scale       = 1
     2282         buf_fin-ob.contract-scale   = 1
     2283       .
     2284       assign
     2285       v-tax-sum-rubl  = 0
     2286       v-tax-sum-base  = 0
     2287       v-tax-sum-contr = 0
     2288       v-tax-sum-doc   = 0
     2289       v-sum-vat          = 0
     2290       v-sum-rubl-vat     = 0
     2291       v-sum-base-vat     = 0
     2292       v-sum-contract-vat    = 0
     2293       v-sum-slt          = 0
     2294       v-sum-rubl-slt     = 0
     2295       v-sum-base-slt     = 0
     2296       v-sum-contract-slt    = 0
     2297       .
     2298   end.
     2299    end.
     2300   end procedure.
     2301   procedure update-fin-ob_obj :
     2302    do
     2303    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2304    :
     2305   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     2306   define input parameter p-host-code as integer no-undo .
     2307   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2308   define buffer buf_fin-ob       for  ub.fin-ob     .
     2309   define variable v-obj-code as integer no-undo init 0 .
     2310   define variable v-obj-type as character no-undo init "" .
     2311   define variable var-fin-calc as integer no-undo .
     2312   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     2313   var-fin-calc = ub.sysconf.fin-calc   .
     2314   if var-fin-calc = 0 then return.
     2315   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2316                                               buf_fin-ob.doc-code = p-doc-code
     2317                                               on error undo, return error :
     2318       for each buf_fin-gds-part no-lock where
     2319                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2320                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2321                on error undo, return error :
     2322             assign
     2323                v-obj-code  =  buf_fin-gds-part.obj-code
     2324                v-obj-type  =  buf_fin-gds-part.obj-type
     2325                .
     2326              leave.
     2327       end.
     2328       assign
     2329         buf_fin-ob.obj-code  =   v-obj-code
     2330         buf_fin-ob.obj-type  =   v-obj-type
     2331       .
     2332   end.
     2333    end.
     2334   end procedure.
     2335   procedure make-tax-rubl :
     2336    do
     2337    on error undo, return error return-value
     2338    :
     2339   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     2340   define input parameter p-host-code as integer no-undo .
     2341   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2342   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     2343   define buffer buf_fin-ob       for  ub.fin-ob     .
     2344   define variable v-line    as integer no-undo .
     2345   define variable v-sum         as decimal no-undo .
     2346   define variable v-tax-sum       as decimal no-undo .
     2347   define variable v-tax-sum-rubl  as decimal no-undo .
     2348   define variable v-tax-sum-base  as decimal no-undo .
     2349   define variable v-tax-sum-contr as decimal no-undo .
     2350   define variable v-tax-sum-doc   as decimal no-undo .
     2351   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2352                                               buf_fin-ob.doc-code = p-doc-code
     2353                                               on error undo, return error :
     2354      assign
     2355       v-tax-sum-rubl = 0
     2356       v-tax-sum-base = 0
     2357       v-tax-sum-contr = 0
     2358       v-tax-sum-doc  = 0
     2359       v-sum          = 0
     2360       v-line = 0
     2361       .
     2362       for each buf_fin-gds-part no-lock where
     2363                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2364                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2365                break  by buf_fin-gds-part.SLT-pc
     2366                       by buf_fin-gds-part.vat-pc
     2367                on error undo, return error :
     2368                assign
     2369                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     2370                .
     2371                if last-of(buf_fin-gds-part.vat-pc) then do:
     2372                   v-line = v-line + 1.
     2373                   create buf_fin-ob-tax.
     2374                   assign
     2375                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     2376                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     2377                       buf_fin-ob-tax.line-num           = v-line
     2378                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     2379                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     2380                       buf_fin-ob-tax.with-slt           = true
     2381                       buf_fin-ob-tax.with-vat           = true
     2382                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     2383                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     2384                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     2385                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     2386                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     2387                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     2388                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     2389                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     2390                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     2391                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     2392                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     2393                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     2394                       .
     2395                       assign
     2396                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     2397                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     2398                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     2399                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     2400                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     2401                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     2402                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     2403                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     2404                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     2405                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     2406                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     2407                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     2408                       .
     2409                       assign
     2410                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     2411                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     2412                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     2413                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     2414                       .
     2415                       v-sum  = 0 .
     2416                 end.
     2417       end.
     2418       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     2419       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     2420       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     2421       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     2422       v-tax-sum-rubl  = 0 .
     2423       v-tax-sum-base  = 0 .
     2424       v-tax-sum-contr = 0 .
     2425       v-tax-sum-doc   = 0 .
     2426   end.
     2427    end.
     2428   end procedure.
     2429   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430   on help of frame Dialog-Frame
     2431   do:
     2432     run gbl/app_help.p
     2433       (input this-procedure :file-name
     2434       ,input ''
     2435       ,input ?
     2436       ) no-error.
     2437     if error-status :error then do:
     2438       message
     2439         "Ошибка при вызове помощи"
     2440         error-status :get-message(1)
     2441         view-as alert-box .
     2442     end.
     2443   end.
     2444   run minbtn-set in this-procedure .
     2445   on choose of b-help in frame Dialog-Frame
     2446   do:
     2447     apply "help":u to frame Dialog-Frame .
     2448   end.
     2449   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2450   procedure minbtn-set :
     2451       do
     2452           on error undo, return error return-value
     2453           :
     2454           define variable ii              as integer       no-undo .
     2455           define variable fh              as widget-handle no-undo .
     2456           define variable hh              as widget-handle no-undo .
     2457           define variable v-h             as handle        extent 4 no-undo .
     2458           define variable v-name-button   as character     no-undo .
     2459           define variable v-help-old-x    as decimal       no-undo .
     2460           define variable v-help-old-y    as decimal       no-undo .
     2461           define variable v-help-old-size as decimal       no-undo .
     2462           define variable v-frame-width   as decimal       no-undo .
     2463           define variable jj              as integer       no-undo .
     2464           do
     2465               on error undo, return error
     2466               :
     2467               assign
     2468                   v-frame-width = frame Dialog-Frame:width - 0.3
     2469                   fh            = frame Dialog-Frame:first-child
     2470                   hh            = fh:first-child
     2471                   ii            = 1
     2472                   .
     2473               do while valid-handle(hh):
     2474                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2475                   do:
     2476                       case lc(hh:name) :
     2477                           when "b-help" then
     2478                               do:
     2479                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2480                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2481                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2482                                   hh:TOOLTIP = "Помощь" .
     2483                                   v-help-old-x = hh:column .
     2484                                   v-help-old-y = hh:row    .
     2485                                   v-help-old-size = hh:width .
     2486                                   hh:width-chars = 2.5 .
     2487                               end.
     2488                           when "b-print" then
     2489                               do:
     2490                                   hh:load-image("cmp/b-print.bmp":u) .
     2491                                   hh:TOOLTIP = "Печать" .
     2492                                   v-h[ii] = hh:handle .
     2493                                   ii = ii + 1 .
     2494                                   hh:width-chars = 3 .
     2495                               end.
     2496                           when "b-history" or
     2497                           when "b-hist" then
     2498                               do:
     2499                                   hh:load-image("cmp/b-hist.bmp":u) .
     2500                                   hh:TOOLTIP = "История" .
     2501                                   v-h[ii] = hh:handle .
     2502                                   ii = ii + 1 .
     2503                                   hh:width-chars = 3 .
     2504                               end.
     2505                           when "b-sch" then
     2506                               do:
     2507                                   hh:load-image("cmp/b-sch.bmp":u) .
     2508                                   hh:TOOLTIP = "Установка Фильтра" .
     2509                                   v-h[ii] = hh:handle .
     2510                                   ii = ii + 1 .
     2511                                   hh:width-chars = 3 .
     2512                               end.
     2513                           when "b-hist-user" then
     2514                               do:
     2515                                   hh:load-image("cmp/b-hist.bmp":u) .
     2516                                   hh:TOOLTIP = "История пользователя" .
     2517                                   ii = ii + 1 .
     2518                               end.
     2519                       end case.
     2520                   end.
     2521                   hh = hh:next-sibling.
     2522               end.
     2523               b-help:column = v-frame-width - b-help:width-chars.
     2524               jj = 0.
     2525               repeat ii = 4 to 1 by -1 :
     2526                   if valid-handle (v-h[ii] ) then
     2527                   do:
     2528                       jj  = jj + 1 .
     2529                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2530                       v-h[ii]:row    = v-help-old-y .
     2531                   end.
     2532               end.
     2533           end.
     2534       end.
     2535   end procedure.
     2536   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2537   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2538   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2539   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2540   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2541   define variable v-diasize-current-frame-height as decimal   no-undo .
     2542   define variable v-diasize-change-size          as logical   no-undo .
     2543   define variable v-diasize-resize-button        as handle    no-undo .
     2544   define variable v-diasize-wndmax               as logical   no-undo .
     2545   define variable v-diasize-wndstore             as logical   no-undo .
     2546   define variable v-diasize-proc-name            as character no-undo .
     2547   define variable v-diasize-browse-handle        as handle    no-undo .
     2548   define variable v-diasize-browse-number        as integer   no-undo .
     2549   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2550   define temp-table temp-diasize-handle no-undo
     2551     field handle-value  as handle
     2552     field save-position as decimal
     2553     index xpk is primary unique handle-value
     2554     .
     2555   define temp-table temp-browse-handle no-undo
     2556     field browse-type   as character
     2557     field browse-number as integer
     2558     field browse-handle as handle
     2559     field original-size as decimal
     2560     index xpk is primary unique browse-type browse-number
     2561     index xie browse-type browse-handle
     2562   .
     2563   procedure diasize_change-height :
     2564     define input  parameter p-change-value  as decimal   no-undo .
     2565     define input  parameter p-move-resize   as logical   no-undo .
     2566     define variable v-field-group-handle    as handle    no-undo .
     2567     define variable v-object-handle         as handle    no-undo .
     2568     define variable v-frame-height          as decimal   no-undo .
     2569     define variable v-frame-virtual-height  as decimal   no-undo .
     2570     define variable v-browse-height         as decimal   no-undo .
     2571     define variable v-window-height         as decimal   no-undo .
     2572     define variable v-window-virtual-height as decimal   no-undo .
     2573     define variable v-change-sign           as integer   no-undo .
     2574     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2575     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2576     if p-change-value > 0
     2577     then do:
     2578       if frame Dialog-Frame :height + p-change-value
     2579           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2580       then do:
     2581         assign
     2582           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2583                           - (frame Dialog-Frame :height-chars)
     2584         .
     2585         if p-change-value <= 0
     2586         then do:
     2587           run diasize_position-resize-button in this-procedure .
     2588           return .
     2589         end.
     2590       end.
     2591     end.
     2592     if p-change-value < 0
     2593     then do:
     2594       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2595       then do:
     2596         assign
     2597           p-change-value = v-diasize-orig-frame-height
     2598                          - (frame Dialog-Frame :height-chars)
     2599         .
     2600         if p-change-value >= 0
     2601         then do:
     2602           run diasize_position-resize-button in this-procedure .
     2603           return .
     2604         end.
     2605       end.
     2606     end.
     2607     if p-change-value >= 0
     2608     then do:
     2609       assign
     2610         v-change-sign = 1
     2611       .
     2612     end.
     2613     else do:
     2614       assign
     2615         v-change-sign = -1
     2616       .
     2617     end.
     2618     assign
     2619       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2620     .
     2621     if p-change-value = 0
     2622     then do:
     2623       run diasize_position-resize-button in this-procedure .
     2624       return .
     2625     end.
     2626     move_block:
     2627     do
     2628     on error undo move_block, retry move_block
     2629     :
     2630       if retry
     2631       then do:
     2632         do
     2633         on error undo move_block, leave move_block
     2634         :
     2635           if p-change-value > 0
     2636           then do:
     2637             for each buf_temp-diasize-handle
     2638             on error undo, next
     2639             :
     2640               assign
     2641                 v-object-handle = buf_temp-diasize-handle.handle-value
     2642               .
     2643               if v-object-handle <> v-diasize-resize-button
     2644               then do:
     2645                 assign
     2646                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2647                 .
     2648               end.
     2649             end.
     2650             assign
     2651               v-diasize-browse-handle :height = v-browse-height
     2652             .
     2653             for each buf_temp-browse-handle
     2654               where buf_temp-browse-handle.browse-type = 'height':u
     2655             on error undo, next
     2656             :
     2657               assign
     2658                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2659               .
     2660             end.
     2661             assign
     2662               frame Dialog-Frame :height = v-frame-height
     2663             .
     2664             if frame Dialog-Frame :scrollable = true
     2665             then do:
     2666               assign
     2667                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2668               .
     2669             end.
     2670             run diasize_position-resize-button in this-procedure .
     2671           end.
     2672           else do:
     2673             if frame Dialog-Frame :scrollable = true
     2674             then do:
     2675               assign
     2676                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2677               .
     2678             end.
     2679             assign
     2680               frame Dialog-Frame :height = v-frame-height
     2681             .
     2682             assign
     2683               v-diasize-browse-handle :height = v-browse-height
     2684             .
     2685             for each buf_temp-browse-handle
     2686               where buf_temp-browse-handle.browse-type = 'height':u
     2687             on error undo, next
     2688             :
     2689               assign
     2690                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2691               .
     2692             end.
     2693             for each buf_temp-diasize-handle
     2694             on error undo, next
     2695             :
     2696               assign
     2697                 v-object-handle = buf_temp-diasize-handle.handle-value
     2698               .
     2699               if v-object-handle <> v-diasize-resize-button
     2700               then do:
     2701                 assign
     2702                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2703                 .
     2704               end.
     2705             end.
     2706             run diasize_position-resize-button in this-procedure .
     2707           end.
     2708           assign
     2709             v-diasize-change-size = false
     2710           .
     2711           leave move_block .
     2712         end.
     2713       end.
     2714       assign
     2715         v-diasize-need-full-display = true
     2716       .
     2717       if v-diasize-change-size = false
     2718       then do:
     2719         assign
     2720           v-diasize-change-size = true
     2721         .
     2722       end.
     2723       else do:
     2724         return .
     2725       end.
     2726       assign
     2727         v-frame-height = frame Dialog-Frame :height
     2728         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2729         v-browse-height = v-diasize-browse-handle :height
     2730       .
     2731       for each buf_temp-browse-handle
     2732         where buf_temp-browse-handle.browse-type = 'height':u
     2733       :
     2734         assign
     2735           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2736         .
     2737       end.
     2738       for each buf_temp-diasize-handle
     2739       :
     2740         delete buf_temp-diasize-handle .
     2741       end.
     2742       assign
     2743         v-field-group-handle = frame Dialog-Frame :first-child
     2744       .
