      614     define variable v-cntxt-db-num-obj    as integer   no-undo .
      615     define variable v-cntxt-is-admin      as logical   no-undo .
      616   define variable tcode as character no-undo .
      617   define variable loc_contract-code-id  like fin-ob-before.contract-code        no-undo .
