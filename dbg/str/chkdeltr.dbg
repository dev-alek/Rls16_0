        1   block-level on error undo, throw.
        2   define input  parameter p-db-num        as integer   no-undo .
        3   define input  parameter p-user-id       as character no-undo .
        4   define input  parameter p-doc-code      as character no-undo .
        5   define input  parameter p-phdoc-code    as character no-undo .
        6   define input  parameter p-file-name-err as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: 120a810dadd3, 63, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        9   define variable vss-date        as character no-undo init "$Date: Thu Aug 28 16:27:54 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: chkdeltr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/chkdeltr.p $":U .
       12   define variable vss-description as character no-undo init "Проверка возможности удаления документа, закрытого до статуса ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define variable v-waitfram-action01         as character   no-undo .
      309   define variable v-waitfram-action02         as character   no-undo .
      310   define variable v-waitfram-action03         as character   no-undo .
      311   define variable mWaitFramTextBeg            as character   no-undo.
      312   define variable mWaitFramTextEnd            as character   no-undo.
      313   define variable mWaitFramView               as logical     no-undo.
      314   define variable mWaitProcEvent              as logical     no-undo init yes.
      315   define variable mWaitFramInterval           as integer     no-undo init 1 .
      316   define variable mWaitFramStop               as logical     no-undo.
      317   define variable mWaitFramStopUser           as logical     no-undo.
      318   define variable mWaitFramStopTimeOut        as logical     no-undo.
      319   define variable mWaitFramStartProc          as datetime-tz no-undo.
      320   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      321   define button B-WaitFramStop auto-end-key
      322        label "Стоп"
      323        size 10 by 1 tooltip "Остоновить процесс".
      324   define button B-viewProcInfo
      325        label "Информация"
      326        size 15 by 1 tooltip "Информация о процесс".
      327   define frame waitfram
      328     v-waitfram-action01 format "x(72)" no-label skip
      329     v-waitfram-action02 format "x(72)" no-label skip
      330     v-waitfram-action03 format "x(72)" no-label skip
      331     B-viewProcInfo
      332     B-WaitFramStop at row 4 col 30
      333     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      334     .
      335   define new global shared variable mBatchMode as logical no-undo init ?.
      336   define variable mFramBachModHandle as handle no-undo.
      337   mFramBachModHandle = frame waitfram:handle.
      338   define variable mFameOldVis as logical no-undo.
      339   define variable mVisCUrentVin as logical no-undo.
      340   if session:batch-mode
      341   then
      342      mBatchMode = yes.
      343   if mBatchMode = ? then do:
      344     mVisCUrentVin = current-window:visible.
      345     mFameOldVis = mFramBachModHandle:visible.
      346     mFramBachModHandle:visible  = yes.
      347     mBatchMode = mFramBachModHandle:visible ne yes.
      348     mFramBachModHandle:visible = mFameOldVis.
      349     current-window:visible = mVisCUrentVin.
      350   end.
      351    if  log-manager:logfile-name ne ?
      352     then DO:
      353         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      354         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      355         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      356     end.
      357   on choose of B-WaitFramStop in frame waitfram
      358   do:
      359     mWaitFramStop = yes.
      360     mWaitFramStopUser = yes.
      361   end.
      362   function waitfram-check-timeout returns logical():
      363      define variable vtime as int64 no-undo.
      364      if mWaitFramStopTimeOut
      365      then
      366         return yes.
      367      vtime = ( now - mWaitFramStartProc ) / 1000 .
      368      if     mWaitFramTimeOut ne ?
      369         and mWaitFramTimeOut ne 0
      370         and mWaitFramTimeOut lt vtime
      371      then do:
      372         mWaitFramStopTimeOut = yes.
      373      end.
      374      return mWaitFramStopTimeOut.
      375   end.
      376   procedure waitfram-hide :
      377     if not session:batch-mode
      378     then do
      379     on error undo, return error return-value
      380     :
      381       pause 0 before-hide .
      382       if not mBatchMode then
      383         hide frame waitfram .
      384     if     not mWaitFramView
      385        and mWaitProcEvent
      386     then
      387       process events .
      388     end.
      389   end procedure.
      390   procedure waitfram-show :
      391     define input  parameter p-message as character no-undo .
      392     define variable v-left-margin as integer   no-undo .
      393     if not session:batch-mode
      394     then do
      395     on error undo, return error return-value
      396     :
      397       if length(p-message) <= 70 then do:
      398         assign
      399           v-left-margin = integer((70 - length(p-message)) / 2)
      400         .
      401         assign
      402           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      403         .
      404         assign
      405           v-waitfram-action01 = " "
      406           v-waitfram-action02 = " "
      407                                    + fill(" ", v-left-margin)
      408                                    + p-message
      409           v-waitfram-action03 = " "
      410         .
      411       end.
      412       else do:
      413         define variable vRindex1 as integer no-undo.
      414         define variable vRindex2 as integer no-undo.
      415         vRindex1 = r-index(p-message," ",70).
      416         if vRindex1 = 0
      417         then
      418            vRindex1 = 70.
      419         if length(p-message)  <= vRindex1 + 70 then do:
      420           assign
      421             v-waitfram-action01 = " "
      422             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      423             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      424           .
      425         end.
      426         else do:
      427           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      428           if vRindex2 <= vRindex1
      429           then
      430              vRindex2 = vRindex1 + 70.
      431           assign
      432             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      433             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      434             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      435           .
      436         end.
      437       end.
      438       B-viewProcInfo:visible   in frame waitfram = no.
      439       B-viewProcInfo:sensitive in frame waitfram = no.
      440       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      441       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      442       if  (   mWaitFramView
      443          or  mWaitProcEvent)
      444          and not mBatchMode
      445       then
      446          display
      447             v-waitfram-action01 skip
      448             v-waitfram-action02 skip
      449             v-waitfram-action03 skip
      450          with frame waitfram .
      451       if     mWaitFramView
      452          then do:
      453             if     mWaitFramInterval ne ?
      454                and not mBatchMode
      455             then
      456                wait-for go of frame waitfram pause mWaitFramInterval.
      457          end.
      458          else
      459             if     mWaitProcEvent
      460                and not mBatchMode
      461             then
      462                process events .
      463     end.
      464   end procedure.
      465      procedure waitfram-show-this:
      466         define input  parameter iInterval as int64 no-undo.
      467         define variable vtime as int64 no-undo.
      468         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      469         mWaitFramInterval = iInterval.
      470         run waitfram-show (substitute("&1&2 &3&4" ,
      471                                       mWaitFramTextBeg ,
      472                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      473                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      474                                       mWaitFramTextEnd
      475                                      )
      476                           ).
      477      end.
      478      procedure WaitFramRunPause:
      479         define input  parameter iInterval as dec no-undo.
      480         define variable vStart  as datetime-tz no-undo.
      481         define variable vend    as datetime-tz no-undo.
      482         define variable vint as int64 no-undo.
      483         define variable vOk as logical no-undo.
      484         vStart = now.
      485         vend   = vStart.
      486         publish "WaitFramPause" (iInterval,output vOk).
      487         vend   =  now.
      488         vint = vend - vStart.
      489         vint = iInterval - vint / 1000.
      490         if     not mWaitFramStop
      491            and (   vint > 0
      492                 or (    not vOk
      493                     and iInterval eq ?
      494                     )
      495                 )
      496         then
      497            run waitfram-show-this (iInterval).
      498         vend   =  now.
      499         vint = vend - vStart.
      500         vint = iInterval - vint / 1000.
      501         if     not mWaitFramStop
      502            and vint > 0
      503         then do:
      504            run gbl/pause.p (vint * 1000).
      505         end.
      506         if iInterval ne ?
      507         then
      508            publish "WaitFramStop".
      509         waitfram-check-timeout().
      510      end.
      511      procedure WaitFramWaitFor:
      512         define input  parameter iInterval as dec no-undo.
      513         assign
      514            mWaitFramStartProc   = now
      515            mWaitFramStopUser    = no
      516            mWaitFramStopTimeOut = no
      517         .
      518         block-wait:
      519         do while not mWaitFramStop:
      520            run WaitFramRunPause (iInterval).
      521            if  waitfram-check-timeout()
      522            then do:
      523               leave block-wait.
      524            end.
      525         end.
      526         run waitfram-hide.
      527      end.
      528   procedure waitfram-join :
      529     define input  parameter p-line-1  as character no-undo .
      530     define input  parameter p-line-2  as character no-undo .
      531     define input  parameter p-line-3  as character no-undo .
      532     define output parameter p-message as character no-undo .
      533     do
      534     on error undo, return error return-value
      535     :
      536       assign
      537         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      538                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      539                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      540       .
      541     end.
      542   end procedure.
      543   function waitfram-join-function returns character
      544     (input p-line-1 as character
      545     ,input p-line-2 as character
      546     ,input p-line-3 as character
      547     ).
      548     define variable v-message as character no-undo .
      549     run waitfram-join in this-procedure
      550       (input  p-line-1
      551       ,input  p-line-2
      552       ,input  p-line-3
      553       ,output v-message
      554       ) .
      555     return v-message .
      556   end function .
      557   define variable v-message      as character no-undo .
      558   define variable v-flag-doc-err as logical   no-undo .
      559   define variable v-line-count   as integer   no-undo .
      560   define variable v-start-mjd    as decimal   no-undo .
      561   define variable v-curr-mjd     as decimal   no-undo .
      562   define variable v-diff-mjd     as decimal   no-undo .
      563   define variable l-inv-on       as logical   no-undo .
      564   define buffer del_trn-doc  for ub.trn-doc .
      565   define buffer del_doc-line for ub.doc-line .
      566   do
      567   on error undo, return error return-value
      568   :
      569     assign
      570       v-start-mjd = cur-time-mjd()
      571     .
      572     find first del_trn-doc exclusive-lock
      573       where del_trn-doc.doc-code = p-doc-code
      574       no-error .
      575     if error-status :error
      576     then do:
      577       message
      578         vss-workfile vss-revision vss-description skip
      579         "Ошибка задания входных параметров" skip
      580         "Не найден документ" skip
      581         "Документ" p-doc-code skip
      582         view-as alert-box error .
      583       undo, return error return-value .
      584     end.
      585     if del_trn-doc.status_ <> 'факт':U
      586     then do:
      587       message
      588         vss-workfile vss-revision vss-description skip
      589         "Ошибка задания входных параметров" skip
      590         "Статус документа отличен от статуса" 'факт':U skip
      591         "Документ" p-doc-code skip
      592         view-as alert-box error .
      593       undo, return error return-value .
      594     end.
      595     run waitfram-show in this-procedure
      596       (input  substitute ("Удаление документа &1. Блокирование товаров.", p-doc-code)
      597       ) .
      598     run trg/lock-gds.p
      599       (input  del_trn-doc.doc-code
      600       ,input  true
      601       ,input  true
      602       ,input (if del_trn-doc.is-back-date = yes
      603               then 0
      604               else del_trn-doc.fact-order)
      605       ,input  0
      606       ,input  true
      607       ,input  false
      608       ) no-error .
      609     if error-status :error
      610     then do:
      611       undo, return error return-value .
      612     end.
      613     assign
      614       v-flag-doc-err = no
      615     .
      616     if search(p-file-name-err) <> ?
      617     then do:
      618       os-delete value(p-file-name-err).
      619     end.
      620     assign
      621       v-line-count = 0
      622     .
      623     for each del_doc-line
      624       where del_doc-line.doc-code = del_trn-doc.doc-code
      625     on error undo, return error return-value
      626     :
      627       assign
      628         v-line-count = v-line-count + 1
      629         v-curr-mjd   = cur-time-mjd()
      630         v-diff-mjd   = v-curr-mjd - v-start-mjd
      631       .
      632       if v-line-count modulo 10 = 0
      633       then do:
      634         run waitfram-join in this-procedure
      635           (input substitute ("Проверка на возможность удаления строк документа &1.", p-doc-code)
      636           ,input substitute ("Обработано строк: &1.", v-line-count)
      637                + substitute ("Артикул: &1 &2 &3. ", del_doc-line.artic, del_doc-line.prod-type, del_doc-line.prod-code)
      638           ,input substitute ("Время выполнения: &1.", cur-time-mjd-to-string(v-diff-mjd))
      639           ,output v-message
      640           ) .
      641       end.
      642       run waitfram-show in this-procedure
      643         (input v-message
      644         ) .
      645       run str/chkdelln.p
      646         (input  p-db-num
      647         ,input  p-user-id
      648         ,input  del_doc-line.obj-type
      649         ,input  del_doc-line.obj-code
      650         ,input  del_doc-line.artic
      651         ,input  del_doc-line.prod-type
      652         ,input  del_doc-line.prod-code
      653         ,input  del_doc-line.doc-code
      654         ,input  p-phdoc-code
      655         ,input  del_trn-doc.fact-order
      656         ,input  del_trn-doc.doc-type
      657         ,input  del_trn-doc.ext-doc-type
      658         ,input  del_trn-doc.shift-date
      659         ,input  del_trn-doc.shift-num
      660         ,input  del_doc-line.fact-qnty
      661         ,input  p-file-name-err
      662         ) no-error.
      663       if error-status :error
      664       then do:
      665         if return-value = "CRITICAL"
      666         then do:
      667           undo, return error return-value.
      668         end.
      669         assign
      670           v-flag-doc-err = yes
      671         .
      672       end.
      673       if del_trn-doc.ext-doc-type = 'ap':U
      674       then do:
      675   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      677     (input  del_doc-line.obj-type
      678     ,input  del_doc-line.obj-code
      679     ,input  del_doc-line.artic
      680     ,input  del_doc-line.prod-type
      681     ,input  del_doc-line.prod-code
      682     ,input  'inv-on=false'
      683     ,output l-inv-on
      684     ) no-error .
      685         if error-status :error
      686         then do:
      687           undo, return error substitute ("Ошибка установки атрибута товара на объекте. Документ: &1 Объект: &2 &3 Артикул: &4 &5 &6 l-inv-on: &7"
      688                       , del_doc-line.doc-code
      689                       , del_doc-line.obj-type
      690                       , del_doc-line.obj-code
      691                       , del_doc-line.artic
      692                       , del_doc-line.prod-type
      693                       , del_doc-line.prod-code
      694                       , l-inv-on ).
      695         end.
      696       end.
      697     end.
      698     run waitfram-hide in this-procedure .
      699     if v-flag-doc-err
      700     then do:
      701       undo, return error return-value .
      702     end.
      703   end.
