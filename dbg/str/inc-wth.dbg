      663   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      664   DO:
      665     define variable v-parameter as character no-undo .
      666   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if lookup(self :type
      668            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      669            ) = 0
      670   then do:
      671     message
      672       "$Workfile$"
      673       "Указанному интерфейсному элементу фокус не может быть передан" skip
      674       "Интерфейсный элемент" self :name  skip
      675       "Тип" self :type  skip
      676       "Процедура" this-procedure :file-name skip
      677       view-as alert-box .
      678   end.
      679   else do:
      680     apply "entry":u to self  .
      681     if focus :handle <> self :handle  then do:
      682       return no-apply .
      683     end.
      684   end.
      685     run assign-fields in this-procedure no-error.
      686     if error-status:error then return no-apply.
      687     run check-fields in this-procedure no-error.
      688     if error-status:error then return no-apply.
      689     assign
      690     v-parameter = string(parhost-code) + chr(4) +
      691                    parobj-type + chr(4) +
      692                    string(parobj-code) + chr(4) +
      693                    string(0)
      694     .
      695     run str/diallog.w (
      696           input parParentProc
      697         , input this-procedure
      698         , input ("str/inc-wthr.p":U + chr(4) +
      699                 "1":U  + chr(4) +
      700                 "1":U + chr(4) +
      701                 "1":U)
      702         , input v-parameter
      703         , input no
      704         , input "":U
      705         , input substitute("Формирование и обработка документов МЦ &2&3", parobj-type, parobj-code)
      706     ) no-error.
      707     if error-status:error
      708     and return-value <> "error"
      709     then do:
      710       message
      711       substitute("&1 &2"
      712                 , error-status:get-message(1)
      713                 , return-value )
      714       view-as alert-box error .
      715       return no-apply. .
      716     end.
      717     if return-value = "error":U then do:
      718       return no-apply. .
      719     end.
      720   END.
      721   ON CHOOSE OF B-place-02 IN FRAME Dialog-Frame
      722   DO:
      723      define variable was_found  AS LOG  NO-UNDO.
      724      define variable v_rid as character no-undo.
      725      define variable v-ref-rec as recid no-undo .
      726     IF cli-type-02 = 'маг':U THEN DO:
      727       IF CAN-FIND( ub.clients NO-LOCK WHERE
      728            ub.clients.obj-type = INPUT FRAME Dialog-Frame cli-type-02   AND
      729            ub.clients.obj-code = INPUT FRAME Dialog-Frame cli-code-02 )
      730       THEN DO:
      731             FIND FIRST ub.shop  NO-LOCK WHERE
      732                               ub.shop.host-code = parhost-code  AND
      733                               ub.shop.obj-code  = INPUT FRAME Dialog-Frame cli-code-02  NO-ERROR.
      734             ASSIGN was_found = ( AVAIL ub.shop ).
      735       END.
      736     END.
      737     FIND buf02_wth-place NO-LOCK WHERE
      738                       buf02_wth-place.host-code = parhost-code               AND
      739                       buf02_wth-place.obj-type    = cli-type-02  AND
      740                       buf02_wth-place.obj-code    = cli-code-02  AND
      741                       buf02_wth-place.w-p-code    = INPUT FRAME Dialog-Frame w-p-code-02 NO-ERROR.
      742     IF AVAIL buf02_wth-place THEN DO:
      743           ASSIGN
      744           v_rid = string(RECID( buf02_wth-place ))
      745           .
      746     END.
      747     ASSIGN .
      748     run ref/wthplref.w (
      749                        input parparentproc
      750                       ,INPUT "b-sel":U
      751                       ,INPUT parhost-code
      752                       ,INPUT cli-type-02
      753                       ,INPUT cli-code-02
      754                       ,input 'объект':U
      755                       ,input-OUTPUT v_rid ).
      756     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      757       ASSIGN v-ref-rec = INT( v_rid ) NO-ERROR.
      758       IF ERROR-STATUS:ERROR THEN DO:
      759           RETURN NO-APPLY.
      760       END.
      761       FIND buf02_wth-place NO-LOCK WHERE
      762               RECID( buf02_wth-place ) = v-ref-rec NO-ERROR.
      763       IF AVAIL buf02_wth-place THEN DO:
      764         DISPLAY
      765         buf02_wth-place.w-p-code @ w-p-code-02
      766         buf02_wth-place.w-p-name @ w-p-name-02
      767         WITH FRAME Dialog-Frame.
      768       END.
      769       ELSE DO:
      770           RETURN NO-APPLY.
      771       END.
      772     END.
      773     ELSE DO:
      774       RETURN NO-APPLY.
      775     END.
      776   END.
