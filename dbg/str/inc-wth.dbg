     1780           cli-code-05 = parobj-code
     1781           .
     1782           display
     1783           cli-type-05
     1784           cli-code-05
     1785           with frame Dialog-Frame.
     1786           disable
     1787           cli-type-05
     1788           cli-code-05
     1789           b-cli-05
     1790           with frame Dialog-Frame.
     1791           enable
     1792           b-place-05
     1793           w-p-code-05
     1794           with frame Dialog-Frame.
     1795           APPLY "VALUE-CHANGED" to cli-type-05.
     1796               APPLY "LEAVE" to w-p-code-02 in frame Dialog-Frame.
     1797       end.
     1798       when 1 then do:
     1799               cli-type-05:list-items in frame Dialog-Frame = 'орг':U + chr(44) +
     1800                                       'чел':U + chr(44)  .
     1801           assign
     1802           cli-type-05 = 'орг':U
     1803           cli-code-05 = 0
     1804           .
     1805           display
     1806           cli-type-05
     1807           cli-code-05
     1808           '':U @ cli-name-05
     1809           with frame Dialog-Frame.
     1810           ENABLE
     1811           cli-type-05
     1812           cli-code-05
     1813           b-cli-05
     1814           with frame Dialog-Frame.
     1815           hide
     1816           w-p-code-05
     1817           b-place-05
     1818           w-p-name-05
     1819           in frame Dialog-Frame.
     1820       end.
     1821       END CASE.
     1822   END PROCEDURE.
     1823   PROCEDURE proc-w-p-code-02 :
     1824   IF INPUT FRAME Dialog-Frame T-02 = YES  THEN DO:
     1825     FIND FIRST buf02_wth-place NO-LOCK WHERE
     1826               buf02_wth-place.obj-type = buf02_clients.obj-type      AND
     1827               buf02_wth-place.obj-code = buf02_clients.obj-code      AND
     1828               buf02_wth-place.w-p-code = INPUT FRAME Dialog-Frame w-p-code-02 NO-ERROR.
     1829     IF AVAIL buf02_wth-place THEN DO:
     1830       DISPLAY
     1831       buf02_wth-place.w-p-name @ w-p-name-02
     1832       WITH FRAME Dialog-Frame.
     1833     END.
     1834     else return error.
     1835   end.
     1836   END PROCEDURE.
     1837   PROCEDURE proc-w-p-code-05 :
     1838   IF INPUT FRAME Dialog-Frame T-05 = YES  THEN DO:
     1839     FIND FIRST buf05_wth-place NO-LOCK WHERE
     1840               buf05_wth-place.obj-type = buf05_clients.obj-type      AND
     1841               buf05_wth-place.obj-code = buf05_clients.obj-code      AND
     1842               buf05_wth-place.w-p-code = INPUT FRAME Dialog-Frame w-p-code-05 NO-ERROR.
     1843     IF AVAIL buf05_wth-place THEN DO:
     1844       DISPLAY
     1845       buf05_wth-place.w-p-name @ w-p-name-05
     1846       WITH FRAME Dialog-Frame.
     1847     END.
     1848     else return error.
     1849   end.
     1850   END PROCEDURE.
     1851   PROCEDURE proc-w-p-code-07 :
     1852   IF INPUT FRAME Dialog-Frame T-07 = YES  THEN DO:
     1853     FIND FIRST buf07_wth-place NO-LOCK WHERE
     1854               buf07_wth-place.obj-type = buf07_clients.obj-type      AND
     1855               buf07_wth-place.obj-code = buf07_clients.obj-code      AND
     1856               buf07_wth-place.w-p-code = INPUT FRAME Dialog-Frame w-p-code-07 NO-ERROR.
     1857     IF AVAIL buf07_wth-place THEN DO:
     1858       DISPLAY
     1859       buf07_wth-place.w-p-name @ w-p-name-07
     1860       WITH FRAME Dialog-Frame.
     1861     END.
