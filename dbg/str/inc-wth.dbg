      883   ON CHOOSE OF B-shift IN FRAME Dialog-Frame
      884   DO:
      885   define variable v-rid-list as character no-undo .
      886   define buffer buf_shift-obj for ub.shift-obj.
      887   run str/sht-all.w (
      888               input parparentproc
      889             , INPUT parobj-type
      890             , input parobj-code
      891             , input 'b-sel'
      892             , input 'obj'
      893             , INPUT parobj-type
      894             , input parobj-code
      895             , input '':u
      896             , input-output v-rid-list) no-error.
      897   if v-rid-list = '':U then do:
      898     return no-apply.
      899   end.
      900   find first buf_shift-obj no-lock where
      901           recid(buf_shift-obj) = integer(v-rid-list) .
      902   if not (buf_shift-obj.obj-type = parobj-type
      903           and
      904           buf_shift-obj.obj-code = parobj-code
      905           )
      906   or not (buf_shift-obj.status_ = 'зкр':U
      907          or
      908          buf_shift-obj.status_ = 'тек':U) then do:
      909     message
      910     substitute("Вы должны Выбрать ЗАКРЫТУЮ или ТЕКУЩУЮ смену по &1&2"
      911               , parobj-type
      912               , parobj-code)
      913     view-as alert-box error .
      914     return no-apply.
      915   end.
      916   assign
      917   varshift-name = buf_shift-obj.shift-name
      918   varshift-num = buf_shift-obj.shift-num
      919   varshift-date = buf_shift-obj.shift-date
      920   .
      921   display
      922   varshift-name
      923   varshift-num
      924   varshift-date
      925   with frame Dialog-Frame .
      926   END.
