      991       "Процедура" this-procedure :file-name skip
      992       view-as alert-box .
      993   end.
      994   else do:
      995     apply "entry":u to self  .
      996     if focus :handle <> self :handle  then do:
      997       return no-apply .
      998     end.
      999   end.
     1000      run proc-w-p-code-02 in this-procedure no-error.
     1001      if error-status:error then return no-apply.
     1002   END.
     1003   ON RETURN OF w-p-code-02 IN FRAME Dialog-Frame
     1004   DO:
     1005      run proc-w-p-code-02 in this-procedure no-error.
     1006      if error-status:error then return no-apply.
     1007   END.
     1008   ON LEAVE OF w-p-code-05 IN FRAME Dialog-Frame
     1009   DO:
     1010   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   if lookup(self :type
     1012            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1013            ) = 0
     1014   then do:
     1015     message
     1016       "$Workfile$"
     1017       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1018       "Интерфейсный элемент" self :name  skip
     1019       "Тип" self :type  skip
     1020       "Процедура" this-procedure :file-name skip
     1021       view-as alert-box .
     1022   end.
     1023   else do:
     1024     apply "entry":u to self  .
     1025     if focus :handle <> self :handle  then do:
     1026       return no-apply .
     1027     end.
     1028   end.
     1029      run proc-w-p-code-05 in this-procedure no-error.
     1030      if error-status:error then return no-apply.
     1031   END.
     1032   ON RETURN OF w-p-code-05 IN FRAME Dialog-Frame
     1033   DO:
     1034      run proc-w-p-code-05 in this-procedure no-error.
     1035      if error-status:error then return no-apply.
     1036   END.
     1037   ON LEAVE OF w-p-code-07 IN FRAME Dialog-Frame
     1038   DO:
     1039       run proc-w-p-code-07 in this-procedure no-error.
     1040     if error-status:error then return no-apply.
     1041   END.
     1042   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1043   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1044   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045   on help of frame Dialog-Frame
     1046   do:
     1047     run gbl/app_help.p
     1048       (input this-procedure :file-name
     1049       ,input ''
     1050       ,input ?
     1051       ) no-error.
     1052     if error-status :error then do:
     1053       message
     1054         "Ошибка при вызове помощи"
     1055         error-status :get-message(1)
     1056         view-as alert-box .
     1057     end.
     1058   end.
     1059   run minbtn-set in this-procedure .
     1060   on choose of b-help in frame Dialog-Frame
     1061   do:
     1062     apply "help":u to frame Dialog-Frame .
     1063   end.
     1064   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   procedure minbtn-set :
     1066       do
     1067           on error undo, return error return-value
     1068           :
     1069           define variable ii              as integer       no-undo .
     1070           define variable fh              as widget-handle no-undo .
     1071           define variable hh              as widget-handle no-undo .
     1072           define variable v-h             as handle        extent 4 no-undo .
     1073           define variable v-name-button   as character     no-undo .
     1074           define variable v-help-old-x    as decimal       no-undo .
     1075           define variable v-help-old-y    as decimal       no-undo .
     1076           define variable v-help-old-size as decimal       no-undo .
     1077           define variable v-frame-width   as decimal       no-undo .
     1078           define variable jj              as integer       no-undo .
     1079           do
     1080               on error undo, return error
     1081               :
     1082               assign
     1083                   v-frame-width = frame Dialog-Frame:width - 0.3
     1084                   fh            = frame Dialog-Frame:first-child
     1085                   hh            = fh:first-child
     1086                   ii            = 1
     1087                   .
     1088               do while valid-handle(hh):
     1089                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1090                   do:
     1091                       case lc(hh:name) :
     1092                           when "b-help" then
     1093                               do:
     1094                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1095                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1096                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1097                                   hh:TOOLTIP = "Помощь" .
     1098                                   v-help-old-x = hh:column .
     1099                                   v-help-old-y = hh:row    .
     1100                                   v-help-old-size = hh:width .
     1101                                   hh:width-chars = 2.5 .
     1102                               end.
     1103                           when "b-print" then
     1104                               do:
     1105                                   hh:load-image("cmp/b-print.bmp":u) .
     1106                                   hh:TOOLTIP = "Печать" .
     1107                                   v-h[ii] = hh:handle .
     1108                                   ii = ii + 1 .
     1109                                   hh:width-chars = 3 .
     1110                               end.
     1111                           when "b-history" or
     1112                           when "b-hist" then
     1113                               do:
     1114                                   hh:load-image("cmp/b-hist.bmp":u) .
     1115                                   hh:TOOLTIP = "История" .
     1116                                   v-h[ii] = hh:handle .
     1117                                   ii = ii + 1 .
     1118                                   hh:width-chars = 3 .
     1119                               end.
     1120                           when "b-sch" then
     1121                               do:
     1122                                   hh:load-image("cmp/b-sch.bmp":u) .
     1123                                   hh:TOOLTIP = "Установка Фильтра" .
     1124                                   v-h[ii] = hh:handle .
     1125                                   ii = ii + 1 .
     1126                                   hh:width-chars = 3 .
     1127                               end.
     1128                           when "b-hist-user" then
     1129                               do:
     1130                                   hh:load-image("cmp/b-hist.bmp":u) .
     1131                                   hh:TOOLTIP = "История пользователя" .
     1132                                   ii = ii + 1 .
     1133                               end.
     1134                       end case.
     1135                   end.
     1136                   hh = hh:next-sibling.
     1137               end.
     1138               b-help:column = v-frame-width - b-help:width-chars.
     1139               jj = 0.
     1140               repeat ii = 4 to 1 by -1 :
     1141                   if valid-handle (v-h[ii] ) then
     1142                   do:
     1143                       jj  = jj + 1 .
     1144                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1145                       v-h[ii]:row    = v-help-old-y .
     1146                   end.
     1147               end.
     1148           end.
     1149       end.
     1150   end procedure.
     1151   MAIN-BLOCK:
     1152   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1153      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1154   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155     run mainmenu_getcntxt in parparentproc
     1156       (output v-cntxt-db-num
     1157       ,output v-cntxt-userid
     1158       ,output v-cntxt-level
     1159       ,output v-cntxt-host-code-obj
     1160       ,output v-cntxt-obj-type
     1161       ,output v-cntxt-obj-code
     1162       ,output v-cntxt-db-num-obj
     1163       ,output v-cntxt-is-admin
     1164       ) .
     1165     if parobj-type  <> 'маг':U then do:
     1166       message
     1167       vss-workfile vss-revision vss-description skip
     1168       "Неверный параметр вызова parobj-type" parobj-type
     1169       view-as alert-box.
     1170       return error.
     1171       end.
     1172       find first ub.sysconf No-LOCK WHERE
     1173                   ub.sysconf.host-code = parhost-code No-error.
     1174     if not available ub.sysconf then do:
     1175       message
     1176       vss-workfile vss-revision vss-description skip
     1177       "Неверный параметр вызова parhost-code" parhost-code
     1178       view-as alert-box.
     1179       return error.
     1180     end.
     1181     find first ub.shop No-LOCK WHERE
     1182                    ub.shop.obj-code = parobj-code No-ERROR.
     1183     if not available ub.shop then do:
     1184       message
     1185       vss-workfile vss-revision vss-description skip
     1186       "Неверный параметр вызова parobj-code" parobj-code
     1187       view-as alert-box.
     1188       return error.
     1189     end.
     1190   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1192     (input  'маг':U
     1193     ,input  ub.shop.obj-code
     1194     ,output v-obj-db-num
     1195     )  .
     1196     if v-obj-db-num <> v-cntxt-db-num then do:
     1197       message
     1198       substitute("Нельзя вызывать Формирование автоматических документов МЦ на основе МЦ чеков на чужой БД&1"  +
     1199                  "БД объекта &2, текущая БД &3"
     1200                  , chr(10)
     1201                  , v-obj-db-num
     1202                  , v-cntxt-db-num)
     1203       view-as alert-box .
     1204     end.
     1205     Run fill-tables in this-procedure no-error.
     1206     if error-status:error then return error.
     1207     RUN Myenable.
     1208     WAIT-FOR GO OF FRAME Dialog-Frame.
     1209   END.
     1210   RUN disable_UI.
     1211   PROCEDURE assign-fields :
     1212   assign
     1213   varshift-date
     1214   varshift-num
     1215   varshift-name
     1216   frame Dialog-Frame T-02
     1217   frame Dialog-Frame T-03
     1218   frame Dialog-Frame T-04
     1219   frame Dialog-Frame T-05
     1220   frame Dialog-Frame T-07
     1221   exter-inter-02
     1222   exter-inter-03
     1223   exter-inter-04
     1224   exter-inter-05
     1225   exter-inter-07
     1226   cli-code-02 cli-code-03 cli-code-04 cli-code-05 cli-code-07
     1227   cli-type-02 cli-type-03 cli-type-04 cli-type-05 cli-code-07
     1228   w-p-code-02 w-p-code-03 w-p-code-04 w-p-code-05 w-p-code-07
     1229   .
     1230   for each temp-cre-doc:
     1231       delete temp-cre-doc.
     1232   end.
     1233   if t-02 then do:
     1234       create temp-cre-doc.
     1235       assign
     1236       temp-cre-doc.chk-type = 2
     1237       temp-cre-doc.inter_ = (exter-inter-02 = 2)
     1238       temp-cre-doc.exter_ = (exter-inter-02 = 1)
     1239       temp-cre-doc.doc-type = doc-type-02
     1240       temp-cre-doc.ext-doc-type = if  temp-cre-doc.inter_ then 'ej':U else 'ee':U
     1241       temp-cre-doc.cli-type = cli-type-02
     1242       temp-cre-doc.cli-code= cli-code-02
     1243       temp-cre-doc.out-w-p-code = (if temp-cre-doc.inter_ then w-p-code-02 else 0)
     1244       temp-cre-doc.doc-date = varshift-date
     1245       temp-cre-doc.shift-date = if l-shift-on then varshift-date else ?
     1246       temp-cre-doc.shift-num  = varshift-num
     1247       temp-cre-doc.shift-name = varshift-name
     1248       .
     1249   end.
     1250   if t-03 then do:
     1251       create temp-cre-doc.
     1252       assign
     1253       temp-cre-doc.chk-type = 3
     1254       temp-cre-doc.inter_ = (exter-inter-03 = 2)
     1255       temp-cre-doc.exter_ = (exter-inter-03 = 1)
     1256       temp-cre-doc.doc-type = doc-type-03
     1257       temp-cre-doc.cli-type = cli-type-03
     1258       temp-cre-doc.cli-code= cli-code-03
     1259       temp-cre-doc.out-w-p-code = w-p-code-03
     1260       temp-cre-doc.doc-date = varshift-date
     1261       temp-cre-doc.shift-date = if l-shift-on then varshift-date else ?
     1262       temp-cre-doc.shift-num = varshift-num
     1263       temp-cre-doc.shift-name = varshift-name
     1264       temp-cre-doc.ext-doc-type = 'ij':U.
     1265   end.
     1266   if t-04 then do:
     1267       create temp-cre-doc.
     1268       assign
     1269       temp-cre-doc.chk-type = 4
     1270       temp-cre-doc.inter_ = (exter-inter-04 = 2)
     1271       temp-cre-doc.exter_ = (exter-inter-04 = 1)
     1272       temp-cre-doc.doc-type = doc-type-04
     1273       temp-cre-doc.cli-type = cli-type-04
     1274       temp-cre-doc.cli-code= cli-code-04
     1275       temp-cre-doc.out-w-p-code = w-p-code-04
     1276       temp-cre-doc.doc-date = varshift-date
     1277       temp-cre-doc.shift-date = if l-shift-on then varshift-date else ?
     1278       temp-cre-doc.shift-num = varshift-num
     1279       temp-cre-doc.shift-name = varshift-name
     1280       temp-cre-doc.ext-doc-type = 'iy':U
     1281        .
     1282   end.
     1283   if t-05 then do:
     1284       create temp-cre-doc.
     1285       assign
     1286       temp-cre-doc.chk-type = 5
     1287       temp-cre-doc.inter_ = (exter-inter-05 = 2)
     1288       temp-cre-doc.exter_ = (exter-inter-05 = 1)
     1289       temp-cre-doc.doc-type = doc-type-05
     1290       temp-cre-doc.cli-type = cli-type-05
     1291       temp-cre-doc.cli-code= cli-code-05
     1292       temp-cre-doc.out-w-p-code = (if temp-cre-doc.inter_ then w-p-code-05 else 0)
     1293       temp-cre-doc.doc-date = varshift-date
     1294       temp-cre-doc.shift-date = if l-shift-on then varshift-date else ?
     1295       temp-cre-doc.shift-num = varshift-num
     1296       temp-cre-doc.shift-name = varshift-name
     1297       temp-cre-doc.ext-doc-type =  if  temp-cre-doc.inter_ then 'ej':U else 'ee':U
     1298       .
     1299   end.
     1300   if t-07 then do:
     1301       create temp-cre-doc.
     1302       assign
     1303       temp-cre-doc.chk-type = 7
     1304       temp-cre-doc.inter_ = (exter-inter-07 = 2)
     1305       temp-cre-doc.exter_ = (exter-inter-07 = 1)
     1306       temp-cre-doc.doc-type = doc-type-07
     1307       temp-cre-doc.cli-type = cli-type-07
     1308       temp-cre-doc.cli-code= cli-code-07
     1309       temp-cre-doc.out-w-p-code = w-p-code-07
     1310       temp-cre-doc.doc-date = varshift-date
     1311       temp-cre-doc.shift-date = if l-shift-on then varshift-date else ?
     1312       temp-cre-doc.shift-num = varshift-num
     1313       temp-cre-doc.ext-doc-type = 'de':U
     1314       .
     1315   end.
     1316   END PROCEDURE.
     1317   PROCEDURE check-fields :
     1318   define variable dops as character no-undo.
     1319   define buffer check_clients for ub.clients.
     1320   define buffer check_wth-place for ub.wth-place.
     1321   run gbl/chk-date.p (
     1322                     INPUT parobj-type
     1323                    ,INPUT parobj-code
     1324                    ,INPUT varshift-date
     1325                    ,INPUT time
     1326                    ,INPUT varshift-date
     1327                    ,INPUT varshift-num,
     1328                    yes
     1329                      ) NO-ERROR.
     1330    IF ERROR-STATUS:ERROR THEN DO:
     1331      return error.
     1332    END.
     1333   for each temp-cre-doc:
     1334       dops = '':U.
     1335       assign dops = entry (lookup (trim(string(temp-cre-doc.chk-type)),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U) no-error.
     1336       find first check_clients No-LOCK WHERE
     1337                    check_clients.obj-type = temp-cre-doc.cli-type AND
     1338                    check_clients.obj-code = temp-cre-doc.cli-code No-ERROR.
     1339       if not avail check_clients or
     1340          (temp-cre-doc.inter_ = yes and
     1341            NOT(temp-cre-doc.cli-type = parobj-type AND
     1342                    temp-cre-doc.cli-code = parobj-code)
     1343          ) or
     1344          (
     1345           temp-cre-doc.exter_ = yes and
     1346            (temp-cre-doc.cli-type = 'маг':U or temp-cre-doc.cli-type = 'скл':U)
     1347          )
     1348          or (temp-cre-doc.doc-type = 'инв':U AND
     1349              NOT ( temp-cre-doc.cli-type = 'орг':U and
     1350                   temp-cre-doc.cli-code = parhost-code)
     1351             )
     1352          then do:
     1353          message
     1354          "Неверный контрагент для автоматических документов по чекам  МЦ" dops
     1355          view-as alert-box ERROR.
     1356          return error.
     1357       end.
     1358       if temp-cre-doc.inter_ = temp-cre-doc.exter_ then do:
     1359         message
     1360          "Неверный тип документа для автоматических документов по чекам  МЦ" dops
     1361          view-as alert-box ERROR.
     1362          return error.
     1363       end.
     1364       if temp-cre-doc.inter_ then do:
     1365           FIND FIRST check_wth-place No-LOCK WHERE
     1366                             check_wth-place.obj-type = parobj-type AND
     1367                             check_wth-place.obj-code = parobj-code AND
     1368                             check_wth-place.w-p-code = temp-cre-doc.out-w-p-code No-ERROR.
     1369           if not available check_wth-place then do:
     1370         message
     1371          "Неверный код МХ МЦ назначения для автоматических документов по чекам  МЦ" dops
     1372          view-as alert-box ERROR.
     1373          return error.
     1374           end.
     1375       end.
     1376   end.
     1377   END PROCEDURE.
     1378   PROCEDURE disable_UI :
     1379     HIDE FRAME Dialog-Frame.
     1380   END PROCEDURE.
     1381   PROCEDURE enable_UI :
     1382     DISPLAY varshift-name varshift-num varshift-date T-02 exter-inter-02
     1383             cli-type-02 cli-code-02 w-p-code-02 T-03 exter-inter-03 cli-type-03
     1384             cli-code-03 w-p-code-03 T-04 exter-inter-04 cli-type-04 cli-code-04
     1385             w-p-code-04 exter-inter-05 T-05 cli-type-05 cli-code-05 w-p-code-05
     1386             cli-type-07 cli-code-07 w-p-code-07 doc-type-02 cli-name-02 move-02
     1387             w-p-name-02 doc-type-03 cli-name-03 move-03 w-p-name-03 doc-type-04
     1388             cli-name-04 move-04 w-p-name-04 doc-type-05 cli-name-05 move-05
     1389             w-p-name-05 cli-name-07 w-p-name-07
     1390         WITH FRAME Dialog-Frame.
     1391     ENABLE RECT-07 RECT-03 RECT-02 RECT-05 B-exit RECT-04 b-quit varshift-name
     1392            varshift-num B-shift B-Help varshift-date T-02 exter-inter-02
     1393            cli-type-02 cli-code-02 B-cli-02 w-p-code-02 B-place-02 T-03
     1394            exter-inter-03 cli-type-03 cli-code-03 B-cli-03 w-p-code-03 B-place-03
     1395            T-04 exter-inter-04 cli-type-04 cli-code-04 w-p-code-04 B-place-04
     1396            exter-inter-05 T-05 cli-type-05 cli-code-05 B-cli-05 w-p-code-05
     1397            B-place-05 exter-inter-07 T-07 cli-code-07 w-p-code-07 doc-type-02
     1398            cli-name-02 move-02 w-p-name-02 doc-type-03 cli-name-03 move-03
     1399            w-p-name-03 doc-type-04 cli-name-04 move-04 w-p-name-04 doc-type-05
     1400            cli-name-05 move-05 w-p-name-05 doc-type-07 cli-name-07 move-07
     1401         WITH FRAME Dialog-Frame.
     1402     VIEW FRAME Dialog-Frame.
     1403   END PROCEDURE.
     1404   PROCEDURE fill-tables :
     1405   DEFINE VARIABLE v-host-code AS INTEGER NO-UNDO.
     1406   DEFINE VARIABLE glog AS logical NO-UNDO.
     1407   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1408   define variable v-param-type9 as character no-undo .
     1409   define variable v-value-character9 as character no-undo .
     1410   define variable v-value-date9 as date no-undo .
     1411   define variable v-value-decimal9 as decimal no-undo .
     1412   define variable v-value-integer9 as INTEGER no-undo .
     1413   define variable v-tth9 as handle no-undo .
     1414   run adm/shattri.p (
     1415       input "get":U
     1416       ,input  parobj-type
     1417       ,input  parobj-code
     1418       ,input  'get-chk':U
     1419       ,input  'cas-shft':U
     1420       ,output v-value-character9
     1421       ,output v-value-date9
     1422       ,output v-value-decimal9
     1423       ,output v-value-integer9
     1424       ,output cas-shft
     1425       ,output v-param-type9
     1426       ,INPUT-OUTPUT table-handle v-tth9
     1427       )  .
     1428   delete object v-tth9.
     1429   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1431     (input  parobj-type
     1432     ,input  parobj-code
     1433     ,input  'shift-on=request'
     1434     ,output l-shift-on
     1435     )  .
     1436   if l-shift-on and not cas-shft then do:
     1437     message
     1438     "Внимание! На текущем объекте требуется использование смен" skip
     1439     "а настройка СМЕНЫ НА КАССЕ ( cas-shft ) выключена - это недопустимо." skip (2)
     1440     view-as alert-box ERROR.
     1441     return ERROR.
     1442   end.
     1443   if l-shift-on then do:
     1444   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1446     (input  parobj-type
     1447     ,input  parobj-code
     1448     ,output v-host-code
     1449     )  .
     1450   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1451   do:
     1452     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1453       (input  v-cntxt-db-num
     1454       ,input  v-cntxt-userid
     1455       ,input  0
     1456       ,input  'actn_wth-doc_create-back-shift':U
     1457       ,input  'object':U
     1458       ,input  v-host-code
     1459       ,input  parobj-type
     1460       ,input  parobj-code
     1461       ,input  0
     1462       ,input  0
     1463       ,input  0
     1464       ,input  false
     1465       ,output v-can-back-shift
     1466       )  .
     1467   end.
     1468   end.
     1469   run gbl/factdate.p (
     1470                    INPUT        parobj-type,
     1471                    INPUT        parobj-code,
     1472                    INPUT-OUTPUT f-date,
     1473                    INPUT-OUTPUT f-time,
     1474                    INPUT-OUTPUT s-date,
     1475                    INPUT-OUTPUT s-num,
     1476                    INPUT-OUTPUT s-name,
     1477                    INPUT        YES
     1478                      ) NO-ERROR.
     1479    IF ERROR-STATUS:ERROR
     1480    and not v-can-back-shift THEN DO:
     1481      return error.
     1482    END.
     1483   FIND FIRST buf02_clients No-LOCK WHERE
     1484                    buf02_clients.obj-type = parobj-type and
     1485                    buf02_clients.obj-code = parobj-code No-ERROR.
     1486   FIND FIRST buf03_clients No-LOCK WHERE
     1487                    buf03_clients.obj-type = parobj-type and
     1488                    buf03_clients.obj-code = parobj-code No-ERROR.
     1489   FIND FIRST buf04_clients No-LOCK WHERE
     1490                    buf04_clients.obj-type = 'орг':U and
     1491                    buf04_clients.obj-code = parhost-code No-ERROR.
     1492   FIND FIRST buf05_clients No-LOCK WHERE
     1493                    buf05_clients.obj-type = parobj-type and
     1494                    buf05_clients.obj-code = parobj-code No-ERROR.
     1495   FIND FIRST buf07_clients No-LOCK WHERE
     1496                    buf07_clients.obj-type = 'орг':U and
     1497                    buf07_clients.obj-code = parhost-code No-ERROR.
     1498   FIND FIRST buf02_wth-place No-LOCK WHERE
     1499                     buf02_wth-place.obj-type = parobj-type AND
     1500                     buf02_wth-place.obj-code = parobj-code AND
     1501                     buf02_wth-place.main-cash-desk = yes No-ERROR.
     1502   FIND FIRST buf03_wth-place No-LOCK WHERE
     1503                     buf03_wth-place.obj-type = parobj-type AND
     1504                     buf03_wth-place.obj-code = parobj-code AND
     1505                     buf03_wth-place.main-cash-desk = yes No-ERROR.
     1506   FIND FIRST buf05_wth-place No-LOCK WHERE
     1507                     buf05_wth-place.obj-type = parobj-type AND
     1508                     buf05_wth-place.obj-code = parobj-code AND
     1509                     buf05_wth-place.main-cash-desk = yes No-ERROR.
     1510   END PROCEDURE.
     1511   PROCEDURE MyEnable :
     1512   assign
     1513   exter-inter-02 = 2
     1514   exter-inter-03 = 2
     1515   exter-inter-04 = 1
     1516   exter-inter-05 = 2
     1517   exter-inter-07 = 1
     1518   doc-type-02 = 'рас':U
     1519   doc-type-03 = 'при':U
     1520   doc-type-04 = 'инв':U
     1521   doc-type-05 = 'рас':U
     1522   doc-type-07 = 'декл':U
     1523   cli-type-02:list-items in frame Dialog-Frame = 'орг':U + chr(44) +
     1524                                       'чел':U + chr(44)  +
     1525                                                                           'маг':U + chr(44)
     1526   cli-type-03:list-items =  'маг':U + chr(44)
     1527   cli-type-04:list-items = 'орг':U + chr(44)
     1528   cli-type-05:list-items = 'орг':U + chr(44) +
     1529                                       'чел':U + chr(44)   +
     1530                                                                           'маг':U + chr(44)
     1531   cli-type-07:list-items = 'орг':U + chr(44)
     1532   .
     1533   assign
     1534   varshift-date = (if s-date = ? then f-date else s-date)
     1535   varshift-num = s-num
     1536   varshift-name = s-name
     1537   .
     1538   if available buf02_clients then
     1539   assign
     1540   cli-type-02 = buf02_clients.obj-type
     1541   cli-code-02 = buf02_clients.obj-code
     1542   cli-name-02 = buf02_clients.obj-name
     1543   .
     1544   if available buf03_clients then
     1545   assign
     1546   cli-type-03 = buf03_clients.obj-type
     1547   cli-code-03 = buf03_clients.obj-code
     1548   cli-name-03 = buf03_clients.obj-name
     1549   .
     1550   if available buf04_clients then
     1551   assign
     1552   cli-type-04 = buf04_clients.obj-type
     1553   cli-code-04 = buf04_clients.obj-code
     1554   cli-name-04 = buf04_clients.obj-name
     1555   .
     1556   if available buf05_clients then
     1557   assign
     1558   cli-type-05 = buf05_clients.obj-type
     1559   cli-code-05 = buf05_clients.obj-code
     1560   cli-name-05 = buf05_clients.obj-name
     1561   .
     1562   if available buf07_clients then
     1563   assign
     1564   cli-type-07 = buf07_clients.obj-type
     1565   cli-code-07 = buf07_clients.obj-code
     1566   cli-name-07 = buf07_clients.obj-name
     1567   .
     1568   if available buf02_wth-place then
     1569   assign
     1570   w-p-code-02 = buf02_wth-place.w-p-code
     1571   w-p-name-02 = buf02_wth-place.w-p-name
     1572   .
     1573   if available buf03_wth-place then
     1574   assign
     1575   w-p-code-03 = buf03_wth-place.w-p-code
     1576   w-p-name-03 = buf03_wth-place.w-p-name
     1577   .
     1578   if available buf04_wth-place then
     1579   assign
     1580   w-p-code-04 = buf04_wth-place.w-p-code
     1581   w-p-name-04 = buf04_wth-place.w-p-name
     1582   .
     1583   if available buf05_wth-place then
     1584   assign
     1585   w-p-code-05 = buf05_wth-place.w-p-code
     1586   w-p-name-05 = buf05_wth-place.w-p-name
     1587   .
     1588   if available buf07_wth-place then
     1589   assign
     1590   w-p-code-07 = buf07_wth-place.w-p-code
     1591   w-p-name-07 = buf07_wth-place.w-p-name
     1592   .
     1593   DISPLAY
     1594   varshift-date
     1595   varshift-num
     1596   T-02 exter-inter-02 cli-type-02 cli-code-02 cli-name-02 w-p-code-02 doc-type-02 w-p-name-02 move-02
     1597   T-03 exter-inter-03  cli-type-03  cli-code-03 cli-name-03 w-p-code-03 doc-type-03 w-p-name-03 move-03
     1598   T-04 exter-inter-04  cli-type-04  cli-code-04 cli-name-04  doc-type-04  move-04
     1599   T-05 exter-inter-05  cli-type-05  cli-code-05 cli-name-05 w-p-code-05 doc-type-05 w-p-name-05 move-05
     1600   T-07 exter-inter-07  cli-type-07  cli-code-07 cli-name-07 doc-type-07 move-07
     1601   WITH FRAME Dialog-Frame.
     1602   ENABLE
     1603   B-exit
     1604   b-quit
     1605   B-Help
     1606   varshift-date when not l-shift-on
     1607   varshift-num when cas-shft
     1608   T-02 exter-inter-02 cli-type-02 cli-code-02 B-cli-02 w-p-code-02 B-place-02 doc-type-02
     1609   T-03 exter-inter-03                 w-p-code-03     B-place-03                 doc-type-03
     1610   T-04 exter-inter-04                                         doc-type-04
     1611   T-05 exter-inter-05  cli-type-05 cli-code-05 b-cli-05 w-p-code-05 B-place-05 doc-type-05
     1612   T-07 exter-inter-07  doc-type-07
     1613   b-shift WHEN (l-shift-on AND v-can-back-shift)
     1614   WITH FRAME Dialog-Frame .
     1615   IF NOT (l-shift-on AND v-can-back-shift) THEN DO:
     1616     HIDE
     1617     b-shift IN FRAME Dialog-Frame.
     1618   END.
     1619   HIDE
     1620   b-cli-03
     1621   b-cli-04
     1622   b-cli-07
     1623   b-place-04
     1624   b-place-07
     1625   in frame Dialog-Frame.
     1626   VIEW FRAME Dialog-Frame.
     1627   APPLY "VALUE-CHANGED" to exter-inter-02 in frame Dialog-Frame.
     1628   APPLY "VALUE-CHANGED" to exter-inter-05 in frame Dialog-Frame.
     1629   END PROCEDURE.
     1630   PROCEDURE proc-cli-code-02 :
     1631         FIND FIRST buf02_clients NO-LOCK WHERE
     1632                   buf02_clients.obj-type = INPUT FRAME Dialog-Frame cli-type-02 AND
     1633                   buf02_clients.obj-code = INPUT FRAME Dialog-Frame cli-code-02 NO-ERROR.
     1634     IF AVAIL buf02_clients THEN DO:
     1635       CASE buf02_clients.obj-type:
     1636         when 'маг':U then dO:
     1637           find first ub.shop No-LOCK WHERE
     1638                      ub.shop.obj-code = buf02_clients.obj-code No-ERROR.
     1639           if ub.shop.host-code <> parhost-code then do:
     1640             message "Нельзя выбрать магазин другой фирмы!"
     1641             view-as alert-box error .
     1642             APPLY "ENTRY" to cli-code-02 in frame Dialog-Frame.
     1643             return error.
     1644           end.
     1645         end.
     1646         when 'скл':U then do:
     1647           find first ub.store No-LOCK WHERE
     1648                      ub.store.obj-code = buf02_clients.obj-code No-ERROR.
     1649           if ub.store.host-code <> parhost-code then do:
     1650             message "Нельзя выбрать склад другой фирмы!"
     1651             view-as alert-box error .
     1652             APPLY "ENTRY" to cli-code-02 in frame Dialog-Frame.
     1653             return error.
     1654           end.
     1655         end.
     1656       end CASE.
     1657       DISPLAY
     1658       buf02_clients.obj-name @ cli-name-02 WITH FRAME Dialog-Frame.
     1659     END.
     1660   END PROCEDURE.
     1661   PROCEDURE proc-cli-code-05 :
     1662         FIND FIRST buf05_clients NO-LOCK WHERE
     1663                   buf05_clients.obj-type = INPUT FRAME Dialog-Frame cli-type-05 AND
     1664                   buf05_clients.obj-code = INPUT FRAME Dialog-Frame cli-code-05 NO-ERROR.
     1665     IF AVAIL buf05_clients THEN DO:
     1666       CASE buf05_clients.obj-type:
     1667         when 'маг':U then dO:
     1668           find first ub.shop No-LOCK WHERE
     1669                      ub.shop.obj-code = buf05_clients.obj-code No-ERROR.
     1670           if ub.shop.host-code <> parhost-code then do:
     1671             message "Нельзя выбрать магазин другой фирмы!"
     1672             view-as alert-box error .
     1673             APPLY "ENTRY" to cli-code-05 in frame Dialog-Frame.
     1674             return error.
     1675           end.
     1676         end.
     1677         when 'скл':U then do:
     1678           find first ub.store No-LOCK WHERE
     1679                      ub.store.obj-code = buf05_clients.obj-code No-ERROR.
     1680           if ub.store.host-code <> parhost-code then do:
     1681             message "Нельзя выбрать склад другой фирмы!"
     1682             view-as alert-box error .
     1683             APPLY "ENTRY" to cli-code-05 in frame Dialog-Frame.
     1684             return error.
     1685           end.
     1686         end.
     1687       end CASE.
     1688       DISPLAY
     1689       buf05_clients.obj-name @ cli-name-05 WITH FRAME Dialog-Frame.
     1690     END.
     1691   END PROCEDURE.
     1692   PROCEDURE proc-cli-code-07 :
     1693         FIND FIRST buf07_clients NO-LOCK WHERE
     1694                   buf07_clients.obj-type = INPUT FRAME Dialog-Frame cli-type-07 AND
     1695                   buf07_clients.obj-code = INPUT FRAME Dialog-Frame cli-code-07 NO-ERROR.
     1696     IF AVAIL buf07_clients THEN DO:
     1697       CASE buf07_clients.obj-type:
     1698         when 'маг':U then dO:
     1699           find first ub.shop No-LOCK WHERE
     1700                      ub.shop.obj-code = buf07_clients.obj-code No-ERROR.
     1701           if ub.shop.host-code <> parhost-code then do:
     1702             message "Нельзя выбрать магазин другой фирмы!"
     1703             view-as alert-box error .
     1704             APPLY "ENTRY" to cli-code-07 in frame Dialog-Frame.
     1705             return error.
     1706           end.
     1707         end.
     1708         when 'скл':U then do:
     1709           find first ub.store No-LOCK WHERE
     1710                      ub.store.obj-code = buf07_clients.obj-code No-ERROR.
     1711           if ub.store.host-code <> parhost-code then do:
     1712             message "Нельзя выбрать склад другой фирмы!"
     1713             view-as alert-box error .
     1714             APPLY "ENTRY" to cli-code-07 in frame Dialog-Frame.
     1715             return error.
     1716           end.
     1717         end.
     1718       end CASE.
     1719       DISPLAY
     1720       buf07_clients.obj-name @ cli-name-07 WITH FRAME Dialog-Frame.
     1721     END.
     1722   END PROCEDURE.
     1723   PROCEDURE proc-inter-02 :
     1724   define input parameter loc-inter as integer no-undo.
     1725   CASE loc-inter :
     1726       when 2 then do:
     1727           cli-type-02:list-items in frame Dialog-Frame = 'маг':U + chr(44).
     1728           assign
     1729           cli-type-02 = parobj-type
     1730           cli-code-02 = parobj-code
     1731           .
     1732           display
     1733           cli-type-02
     1734           cli-code-02
     1735           with frame Dialog-Frame.
     1736           disable
     1737           cli-type-02
     1738           cli-code-02
     1739           b-cli-02
     1740           with frame Dialog-Frame.
     1741           enable
     1742           b-place-02
     1743           w-p-code-02
     1744           with frame Dialog-Frame.
     1745           APPLY "VALUE-CHANGED" to cli-type-02.
     1746           APPLY "LEAVE" to w-p-code-02 in frame Dialog-Frame.
     1747       end.
     1748       when 1 then do:
     1749           cli-type-02:list-items in frame Dialog-Frame = 'орг':U + chr(44) +
     1750                                       'чел':U + chr(44)  .
     1751           assign
     1752           cli-type-02 = 'орг':U
     1753           cli-code-02 = 0
     1754           .
     1755           display
     1756           cli-type-02
     1757           cli-code-02
     1758           '':U @ cli-name-02
     1759           with frame Dialog-Frame.
     1760           ENABLE
     1761           cli-type-02
     1762           cli-code-02
     1763           b-cli-02
     1764           with frame Dialog-Frame.
     1765           hide
     1766           w-p-code-02
     1767           b-place-02
     1768           w-p-name-02
     1769           in frame Dialog-Frame.
     1770       end.
     1771       END CASE.
     1772   END PROCEDURE.
     1773   PROCEDURE proc-inter-05 :
     1774   define input parameter loc-inter as integer no-undo.
     1775   CASE loc-inter :
     1776       when 2 then do:
     1777               cli-type-05:list-items in frame Dialog-Frame = 'маг':U + chr(44).
     1778           assign
