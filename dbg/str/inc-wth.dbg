      477        cli-name-03 AT ROW 8.27 COL 43 COLON-ALIGNED NO-LABEL
      478        move-03 AT ROW 8.27 COL 66.8 COLON-ALIGNED NO-LABEL
      479        w-p-name-03 AT ROW 8.27 COL 76.5 COLON-ALIGNED NO-LABEL
      480        doc-type-04 AT ROW 12 COL 33.5 COLON-ALIGNED NO-LABEL
      481        cli-name-04 AT ROW 12 COL 43 COLON-ALIGNED NO-LABEL
      482        move-04 AT ROW 12 COL 66.8 COLON-ALIGNED NO-LABEL
      483        w-p-name-04 AT ROW 12 COL 76.5 COLON-ALIGNED NO-LABEL
      484        doc-type-05 AT ROW 15.7 COL 33.5 COLON-ALIGNED NO-LABEL
      485        cli-name-05 AT ROW 15.7 COL 43 COLON-ALIGNED NO-LABEL
      486        move-05 AT ROW 15.7 COL 66.8 COLON-ALIGNED NO-LABEL
      487        w-p-name-05 AT ROW 15.7 COL 76.5 COLON-ALIGNED NO-LABEL
      488        doc-type-07 AT ROW 19.27 COL 33.5 COLON-ALIGNED NO-LABEL
      489        cli-name-07 AT ROW 19.3 COL 43 COLON-ALIGNED NO-LABEL
      490        move-07 AT ROW 19.33 COL 66.8 COLON-ALIGNED NO-LABEL
      491        w-p-name-07 AT ROW 19.33 COL 76.5 COLON-ALIGNED NO-LABEL
      492        "Контрагент" VIEW-AS TEXT
      493             SIZE 17.5 BY 1 AT ROW 2.33 COL 46.6
      494             FGCOLOR 4
      495       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      496            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      497            CANCEL-BUTTON b-quit.
      498   DEFINE FRAME Dialog-Frame
      499        "Тип документа МЦ" VIEW-AS TEXT
      500             SIZE 17.5 BY 1 AT ROW 2.43 COL 22.5
      501             FGCOLOR 4
      502        "Направление перемещения" VIEW-AS TEXT
      503             SIZE 26.5 BY 1 AT ROW 2.27 COL 70.5
      504             FGCOLOR 4
      505        "Типы чеков" VIEW-AS TEXT
      506             SIZE 17.5 BY 1 AT ROW 2.47 COL 1.8
      507             FGCOLOR 4
      508        RECT-07 AT ROW 18.5 COL 1.5
      509        RECT-03 AT ROW 7.47 COL 1.6
      510        RECT-02 AT ROW 3.7 COL 1.6
      511        RECT-05 AT ROW 14.97 COL 1.6
      512        RECT-04 AT ROW 11.2 COL 1.6
      513        SPACE(0.03) SKIP(7.58)
      514       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      515            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      516            TITLE "Формирование автоматических документов по чекам МЦ"
      517            CANCEL-BUTTON b-quit.
      518   ASSIGN
      519          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      520          FRAME Dialog-Frame:HIDDEN           = TRUE.
      521   ASSIGN
      522          B-cli-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      523   ASSIGN
      524          B-place-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      525   ASSIGN
      526          cli-type-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      527   ASSIGN
      528          doc-type-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      529   ASSIGN
      530          exter-inter-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      531   ASSIGN
      532          move-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      533   ASSIGN
      534          T-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      535   ASSIGN
      536          w-p-name-07:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      537   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      538   DO:
      539     APPLY "END-ERROR":U TO SELF.
      540   END.
      541   ON CHOOSE OF B-cli-02 IN FRAME Dialog-Frame
      542   DO:
      543    define variable v_rid as character no-undo.
      544    define variable v-ref-rec as recid no-undo .
      545      FIND FIRST buf02_clients NO-LOCK WHERE
      546               buf02_clients.obj-type = INPUT FRAME Dialog-Frame cli-type-02 AND
      547               buf02_clients.obj-code = INPUT FRAME Dialog-Frame cli-code-02  NO-ERROR.
      548      IF available(buf02_clients) then do:
      549       run ref/cli-all.w ( INPUT parparentproc
      550                     , INPUT "b-sel":U
      551                     , (INPUT FRAME Dialog-Frame cli-type-02)
      552                     , 'все':U
      553                     , 'все':U
      554                     , RECID( buf02_clients )
      555                     , ",,,,,,NO"
      556                     , ?
      557                     , OUTPUT v_rid ).
      558     END.
      559     ELSE DO:
      560       run ref/cli-all.w ( parparentproc
      561                     ,  INPUT "b-sel":U
      562                     , 'орг':U
      563                     , 'все':U
      564                     , 'текущие':U
      565                     , ?
      566                     , ",,,,,,NO"
      567                     , ?
      568                     , OUTPUT v_rid ).
      569     end.
      570     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      571       ASSIGN v-ref-rec = INT( v_rid ) NO-ERROR.
      572       IF ERROR-STATUS:ERROR THEN DO:
      573           RETURN NO-APPLY.
      574       END.
      575       FIND FIRST buf02_clients NO-LOCK WHERE
      576                  RECID( buf02_clients ) = v-ref-rec NO-ERROR.
      577       IF AVAIL buf02_clients THEN DO:
      578         if buf02_clients.obj-type = 'скл':U or buf02_clients.obj-type = 'маг':U then do:
      579           message "Неверно выбран контрагент"
      580           view-as alert-box error.
      581           return no-apply.
      582         end.
      583         ASSIGN
      584         cli-code-02 = buf02_clients.obj-code
      585         cli-type-02 = buf02_clients.obj-type
      586         cli-name-02 = buf02_clients.obj-name
      587         .
      588         DISPLAY
      589         cli-type-02
      590         cli-code-02
      591         cli-name-02
      592         WITH FRAME Dialog-Frame.
      593       END.
      594       ELSE DO:
      595         RETURN NO-APPLY.
      596       END.
      597     END.
      598     ELSE DO:
      599       RETURN NO-APPLY.
      600     END.
      601   END.
