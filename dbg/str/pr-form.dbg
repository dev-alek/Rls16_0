     1464   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   procedure check-use-bar-code :
     1466     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     1467     do
     1468     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1469     on stop   undo, return error substitute( "&1. stop", vss-include-info10 )
     1470     on endkey undo, return error substitute( "&1. endkey", vss-include-info10 )
     1471     :
     1472       define buffer buf_bar-code for ub.bar-code .
     1473       find first buf_bar-code no-lock
     1474         where buf_bar-code.b-code     = p-b-code
     1475         no-error .
     1476       if not available buf_bar-code then do:
     1477         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info10, p-b-code ) .
     1478       end.
     1479       if buf_bar-code.stts = integer('99':U) then do:
     1480         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1481                                 + "Выполняется удаление бар-кода"
     1482                                 ,vss-include-info10
     1483                                 ,p-b-code
     1484                                 ,chr(10)
     1485                               ) .
     1486       end.
     1487       if buf_bar-code.stts = integer('79':U) then do:
     1488         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1489                                 + "Бар-код выключен"
     1490                                 ,vss-include-info10
     1491                                 ,p-b-code
     1492                                 ,chr(10)
     1493                               ) .
     1494       end.
     1495       return .
     1496     end.
     1497   end procedure.
