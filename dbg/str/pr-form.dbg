     7105   do:
     7106     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7107       (input  v-cntxt-db-num
     7108       ,input  v-cntxt-userid
     7109       ,input  0
     7110       ,input  'actn_overvalue_update':U
     7111       ,input  'object':U
     7112       ,input  v-chk-act-host-code
     7113       ,input  ub.price-list.obj-code
     7114       ,input  ub.price-list.obj-type
     7115       ,input  0
     7116       ,input  0
     7117       ,input  0
     7118       ,input  true
     7119       ,output ff
     7120       )  .
