     1267   procedure gds-attr_check-code-dt-seasons :
     1268     define input  parameter p-code     like ub.goods.gds-code   no-undo .
     1269     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     1270     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
     1271     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
     1272     define output parameter p-dt-code  as   integer             no-undo .
     1273     do
     1274     on error undo, return error
     1275     :
