     5740       input buf-price-list.prod-code,
     5741       input-output cur-rt-base,
     5742       input-output cur-rt-rubl )
     5743       .
     5744       if var-pr-r-b = "rubl" then do:
     5745           if ( cur-rt-rubl <> ? )   then
     5746             assign
     5747               buf-price-list.road-tax  = cur-rt-rubl
     5748               .
     5749               else
     5750                   assign
     5751                     buf-price-list.road-tax  = 0
     5752                     .
     5753      end.
     5754      else do:
     5755           if ( cur-rt-base <> ? )   then
     5756             assign
     5757               buf-price-list.road-tax  = cur-rt-base
     5758               .
     5759               else
     5760                   assign
     5761                     buf-price-list.road-tax  = 0
     5762                     .
     5763      end.
     5764   case round-method :
     5765     when '9-окончание':U then do:
     5766       if buf-price-list.price-sale < 29 then do:
     5767         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     5768           assign
     5769             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     5770           .
     5771         end.
     5772       end.
     5773       else do:
     5774         if (buf-price-list.price-sale modulo 10) < 3 then do:
     5775           assign
     5776             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     5777                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     5778                   - 1 ) * 10
     5779                 + 9
     5780           .
     5781         end.
     5782         else do:
     5783           assign
     5784             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     5785                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     5786                   ) * 10
     5787                 + 9
     5788           .
     5789         end.
     5790         assign
     5791           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     5792         .
     5793       end.
     5794     end.
     5795     when '9-99окончание':U then do:
     5796       if buf-price-list.price-sale < round-base then do:
     5797         assign
     5798           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     5799         .
     5800       end.
     5801       else do:
     5802         assign
     5803           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     5804         .
     5805       end.
     5806     end.
     5807     when 'Без-дробных':U then do:
     5808       assign
     5809         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     5810       .
     5811     end.
     5812     when 'Произвольно':U then do:
     5813       if round-base <> 0 then do:
     5814         assign
     5815           buf-price-list.price-sale = round (buf-price-list.price-sale / round-base, 0) * round-base
     5816         .
     5817         if buf-price-list.price-sale = 0 then do:
     5818           assign
     5819             buf-price-list.price-sale = round-base
     5820           .
     5821         end.
     5822       end.
     5823     end.
     5824     when 'Вверх':U then do:
     5825       if round-base <> 0 then do:
     5826         if truncate ( buf-price-list.price-sale / round-base, 0 ) <> (buf-price-list.price-sale / round-base) then do:
     5827           assign
     5828             buf-price-list.price-sale = truncate (buf-price-list.price-sale / round-base, 0) * round-base + round-base
     5829           .
     5830         end.
     5831       end.
     5832       if buf-price-list.price-sale = 0 then do:
     5833         assign
     5834           buf-price-list.price-sale = round-base
     5835         .
     5836       end.
     5837     end.
     5838     when 'Коэффициент':U then do:
     5839       if round-base <> 0 then do:
     5840         assign
     5841           buf-price-list.price-sale = buf-price-list.price-sale * round-base
     5842         .
     5843       end.
     5844     end.
     5845     when 'Отключено':U then do:
     5846     end.
     5847     otherwise do:
     5848       message
     5849         vss-workfile vss-revision vss-description skip
     5850         "Неизвестный метод округления продажной цены" skip
     5851         "round-method" round-method skip
     5852         "round-base"   round-base   skip
     5853         "price"        buf-price-list.price-sale             skip
     5854         view-as alert-box error .
     5855     end.
     5856   end.
     5857     calc-rec = recid (buf-price-list).
     5858     run calc-pr-sub (input  buf-bar-code.b-code,
     5859                      input  buf-price-list.doc-num,
     5860                      input  calc-method,
     5861                      input  increase-pc,
     5862                      input  round-method,
     5863                      input  round-base,
     5864                      output calc-rec) no-error.
     5865     if error-status :error then
     5866       undo calc-pr, return error.
     5867       old-price-sale = buf-price-list.price-sale .
     5868      if line-mode = "calc":u then do:
     5869           run calc-sigma (input buf-price-list.b-code,
     5870                           input-output buf-price-list.price-sale,
     5871                           input buf-price-doc.host-code,
     5872                           input buf-price-doc.obj-code,
     5873                           input buf-price-doc.obj-type,
     5874                           output loc-ret).
     5875           if loc-ret = false then
     5876             message "Цена товара :" SKIP
     5877             "артикул :" buf-price-list.artic buf-price-list.prod-type buf-price-list.prod-code skip
     5878             "бар-код :" buf-price-list.b-code skip
     5879               "не изменилась из-за заданного максимально допустимого отклонения! " skip
     5880               " Рассчитанная цена "  old-price-sale skip
     5881               " Действующая цена "   buf-price-list.price-sale
     5882               view-as alert-box .
     5883      end.
     5884   end.
     5885   END PROCEDURE.
     5886   procedure calc-sigma :
     5887    do
     5888    on error undo, return error return-value
     5889    :
     5890   define input parameter l-bcode like ub.price-list.b-code no-undo .
     5891   define input-output parameter new-price as decimal no-undo .
     5892   define input parameter l-host as integer no-undo .
     5893   define input parameter l-code as integer no-undo .
     5894   define input parameter l-type as character no-undo .
     5895   define output parameter p-ret as logical no-undo .
     5896   define variable conf-par     as character no-undo.
     5897   define variable par-type     as character no-undo.
     5898   define variable i-sigma as decimal no-undo .
     5899   define variable cur-pr like ub.price-list.price-sale no-undo.
     5900   define variable cur-rt like ub.price-list.road-tax   no-undo.
     5901   define variable cur-ex like ub.price-list.excise     no-undo.
     5902   define variable cur-dn like ub.price-list.doc-num    no-undo.
     5903   define variable old-price as decimal no-undo .
     5904   define variable v-value-character as character no-undo .
     5905   define variable v-value-date      as date      no-undo .
     5906   define variable v-value-decimal   as decimal   no-undo .
     5907   define variable v-value-integer   as integer   no-undo .
     5908   define variable v-value-logical   as logical   no-undo .
     5909   p-ret = true  .
     5910   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     5911   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5913     (input  l-type
     5914     ,input  l-code
     5915     ,input  l-bcode
     5916     ,input  0
     5917     ,input  0
     5918     ,output cur-dn
     5919     ,output cur-pr
     5920     ,output cur-rt
     5921     ,output cur-ex
     5922     )  .
     5923   old-price = cur-pr .
     5924   if old-price =  new-price then do:
     5925      p-ret = true .
     5926      return.
     5927   end.
     5928      i-sigma = decimal(par-pr-sigma) .
     5929      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     5930          assign
     5931            p-ret = false
     5932            new-price = old-price
     5933          .
     5934          end.
     5935      else p-ret = true .
     5936     end.
     5937    end.
     5938   end procedure.
     5939   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5940   procedure main-road-tax :
     5941   define input parameter p-obj-type  like ub.gds-obj.obj-type  no-undo .
     5942   define input parameter p-obj-code  like ub.gds-obj.obj-code  no-undo .
     5943   define input parameter p-artic     like ub.gds-obj.artic     no-undo .
     5944   define input parameter p-prod-type like ub.gds-obj.prod-type no-undo .
     5945   define input parameter p-prod-code like ub.gds-obj.prod-code no-undo .
     5946   define input-output parameter p-road-tax-base as decimal no-undo .
     5947   define input-output parameter p-road-tax-rubl as decimal no-undo .
     5948   define variable v-doc-code as character no-undo .
     5949   define buffer     buff-goods    for ub.goods      .
     5950   define buffer     buf_gds-obj   for ub.gds-obj .
     5951   define buffer     buf_parts     for ub.parts   .
     5952   define buffer b-td_trn-doc for ub.trn-doc  .
     5953   define buffer b-dl_doc-line for ub.doc-line .
     5954   define variable is-petrolium              as logical no-undo .
     5955   define variable is-pieces                 as logical no-undo .
     5956   define variable is-hold-td                as logical no-undo .
     5957   define variable v-rec                     as recid   no-undo .
     5958   define variable t-ret                     as logical no-undo .
     5959   define variable v-total-avrg-base         as decimal no-undo .
     5960   define variable v-total-avrg-rubl         as decimal no-undo .
     5961   define variable v-total-avrg-qnty         as decimal no-undo .
     5962   define variable v-total-road-tax-base     as decimal no-undo .
     5963   define variable v-total-road-tax-rubl     as decimal no-undo .
     5964   define variable v-all-total-road-tax-base as decimal no-undo .
     5965   define variable v-all-total-road-tax-rubl as decimal no-undo .
     5966   assign
     5967     p-road-tax-base = ?
     5968     p-road-tax-rubl = ?
     5969     .
     5970     Find first buff-goods no-lock where
     5971           buff-goods.artic     = p-artic and
     5972           buff-goods.prod-type = p-prod-type and
     5973           buff-goods.prod-code = p-prod-code
     5974           no-error .
     5975         If avail buff-goods Then DO:
     5976              v-rec = recid (buff-goods).
     5977              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     5978   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5979     (
     5980        input p-artic
     5981     ,  input p-prod-type
     5982     ,  input p-prod-code
     5983     , output is-petrolium
     5984     , output is-pieces
     5985     ) .
     5986              t-ret =  session:set-wait-state("") .
     5987              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     5988                   assign
     5989                     p-road-tax-base = ?
     5990                     p-road-tax-rubl = ?
     5991                     .
     5992                   return.
     5993              end.
     5994         end.
     5995         assign
     5996             v-total-avrg-qnty = 0
     5997             v-total-road-tax-base =  0
     5998             v-total-road-tax-rubl =  0
     5999             v-all-total-road-tax-base =  0
     6000             v-all-total-road-tax-rubl =  0
     6001             .
     6002         for each buf_parts no-lock
     6003           where buf_parts.obj-type  = p-obj-type
     6004             and buf_parts.obj-code  = p-obj-code
     6005             and buf_parts.artic     = p-artic
     6006             and buf_parts.prod-type = p-prod-type
     6007             and buf_parts.prod-code = p-prod-code
     6008             and buf_parts.status_   = no
     6009             and buf_parts.out-code  = 'free-zone':U
     6010             and buf_parts.qnty      > 0
     6011         on error undo, return error
     6012         :
     6013            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     6014   assign
     6015     price-rubl-with-tax-loc = buf_parts.price-rubl
     6016     price-base-with-tax-loc = buf_parts.price-base
     6017   .
     6018   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6020     (output varinvprb
     6021     )  .
     6022     if buf_parts.out-code = 'free-zone':U     or
     6023        buf_parts.out-code = 'out-zone':U   or
     6024        buf_parts.doc-type = 'акт':U then do:
     6025       assign
     6026         in-vatp-have-vat-slt = yes.
     6027     end.
     6028     else do:
     6029       find first in-vatp_doc-attr no-lock
     6030         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6031           and in-vatp_doc-attr.attr-code = 'envd':U
     6032         no-error .
     6033       if not available in-vatp_doc-attr then do:
     6034         assign
     6035           in-vatp-have-vat-slt = yes.
     6036       end.
     6037       else do:
     6038            in-vatp-have-vat-slt = no.
     6039       end.
     6040     end.
     6041     assign
     6042      price-cli-with-tax-loc = buf_parts.price-cli
     6043      cli-base-rate          = buf_parts.cli-base-rate.
     6044     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6045              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6046     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6047             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6048             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6049             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6050             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6051             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6052             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6053       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6054     assign
     6055       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6056     assign
     6057       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6058       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6059       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6060       transport-cli-loc  = 0
     6061       other-cli-loc      = 0
     6062     .
     6063   ASSIGN
     6064             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6065       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6066   .
     6067           assign
     6068             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     6069             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     6070            .
     6071         end.
     6072             if v-total-avrg-qnty > 0 then  do :
     6073                 assign
     6074                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     6075                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     6076                     .
     6077              end.
     6078               if v-total-avrg-qnty <= 0 then do :
     6079                 find first buf_gds-obj no-lock
     6080                   where buf_gds-obj.obj-type  = p-obj-type
     6081                     and buf_gds-obj.obj-code  = p-obj-code
     6082                     and buf_gds-obj.artic     = p-artic
     6083                     and buf_gds-obj.prod-type = p-prod-type
     6084                     and buf_gds-obj.prod-code = p-prod-code
     6085                   no-error .
     6086                       if available buf_gds-obj then do :
     6087                         if buf_gds-obj.in-code <> "" then
     6088                              v-doc-code = buf_gds-obj.in-code.
     6089                         else do:
     6090                           if available ub.price-doc then  v-doc-code = ub.price-doc.out-code.
     6091                         end.
     6092   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6093   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     6094     (input  v-doc-code
     6095     ,output is-hold-td
     6096     )  .
     6097                         if is-hold-td = true then do:
     6098                           assign
     6099                               p-road-tax-rubl = 0
     6100                               p-road-tax-base = 0
     6101                               .
     6102                         end.
     6103                         else do:
     6104                             find b-td_trn-doc  where b-td_trn-doc.doc-code   = v-doc-code no-lock no-error .
     6105                             find b-dl_doc-line where b-dl_doc-line.doc-code  = b-td_trn-doc.doc-code
     6106                                             and b-dl_doc-line.artic     = p-artic
     6107                                             and b-dl_doc-line.prod-type = p-prod-type
     6108                                             and b-dl_doc-line.prod-code = p-prod-code no-lock no-error.
     6109                                   if available b-dl_doc-line then do :
     6110   assign
     6111     price-rubl-with-tax-loc = b-dl_doc-line.price-rubl
     6112     price-base-with-tax-loc = b-dl_doc-line.price-base
     6113   .
     6114   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6116     (output varinvprb
     6117     )  .
     6118      find first in-vatp_doc-attr no-lock
     6119       where in-vatp_doc-attr.doc-code  = b-td_trn-doc.doc-code
     6120         and in-vatp_doc-attr.attr-code = 'envd':U
     6121       no-error .
     6122       if available in-vatp_doc-attr
     6123          then do:
     6124          assign
     6125            in-vatp-have-vat-slt = no.
     6126      end.
     6127      else do:
     6128        assign
     6129          in-vatp-have-vat-slt = yes.
     6130      end.
     6131      find first in-vatp-goods where in-vatp-goods.artic     = b-dl_doc-line.artic     and
     6132                                        in-vatp-goods.prod-type = b-dl_doc-line.prod-type and
     6133                                        in-vatp-goods.prod-code = b-dl_doc-line.prod-code no-lock.
     6134      if (not b-td_trn-doc.internal and
     6135              b-td_trn-doc.doc-type = 'при':U) or
     6136         in-vatp-goods.gds-type = 'у':U then do:
     6137         if varinvprb = "base":u then do:
     6138           assign
     6139             road-tax-base-loc = b-dl_doc-line.road-tax
     6140             road-tax-rubl-loc = b-dl_doc-line.road-tax * b-td_trn-doc.base-rate / b-td_trn-doc.base-scale.
     6141         end.
     6142         else do:
     6143           ASSIGN
     6144             road-tax-rubl-loc = b-dl_doc-line.road-tax
     6145             road-tax-base-loc = b-dl_doc-line.road-tax / b-td_trn-doc.base-rate * b-td_trn-doc.base-scale.
     6146         end.
     6147         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6148         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6149         assign
     6150           road-tax-cli-loc = ?.
     6151         ASSIGN
     6152           transport-base-loc = (if b-dl_doc-line.transport-base = ? then 0 else b-dl_doc-line.transport-base)
     6153           transport-rubl-loc = (if b-dl_doc-line.transport-rubl = ? then 0 else b-dl_doc-line.transport-rubl)
     6154           transport-cli-loc  = 0
     6155           other-base-loc     = (if b-dl_doc-line.other-base     = ? then 0 else b-dl_doc-line.other-base)
     6156           other-rubl-loc     = (if b-dl_doc-line.other-rubl     = ? then 0 else b-dl_doc-line.other-rubl)
     6157           other-cli-loc      = 0
     6158           vat-pc-loc         = (if b-dl_doc-line.vat-pc         = ? then 0 else b-dl_doc-line.vat-pc)
     6159           slt-pc-loc         = (if b-dl_doc-line.slt-pc         = ? then 0 else b-dl_doc-line.slt-pc).
     6160                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6161               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6162         assign
     6163           vat-cli-loc            = ?
     6164           slt-cli-loc            = ?
     6165           price-cli-with-tax-loc = ?.
     6166      end.
     6167      else do:
     6168                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b-dl_doc-line.doc-code  and
     6169                                         in-vatp-parts.obj-type  = b-dl_doc-line.obj-type  and
     6170                                         in-vatp-parts.obj-code  = b-dl_doc-line.obj-code  and
     6171                                         in-vatp-parts.artic     = b-dl_doc-line.artic     and
     6172                                         in-vatp-parts.prod-type = b-dl_doc-line.prod-type and
     6173                                         in-vatp-parts.prod-code = b-dl_doc-line.prod-code
     6174                            use-index out-code no-lock:
     6175             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     6176                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     6177                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     6178                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     6179                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     6180                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     6181                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6182                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6183                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6184                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6185                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6186                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6187                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6188                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6189                         .
     6190         end.
     6191         ASSIGN
     6192           road-tax-base-loc   = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6193           road-tax-rubl-loc   = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6194           transport-base-loc  = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6195           transport-rubl-loc  = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6196           other-base-loc      = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6197           other-rubl-loc      = if b-dl_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-dl_doc-line.fact-qnty  else 0
     6198                                           vat-base-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-dl_doc-line.fact-qnty   else 0
     6199           slt-base-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-dl_doc-line.fact-qnty   else 0
     6200                   vat-rubl-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-dl_doc-line.fact-qnty   else 0
     6201           slt-rubl-loc        = if b-dl_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-dl_doc-line.fact-qnty   else 0
     6202           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6203           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6204         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6205         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6206         if transport-base-loc = ? then transport-base-loc = 0.
     6207         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6208         if other-base-loc     = ? then other-base-loc     = 0.
     6209         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6210         assign
     6211           transport-cli-loc      = 0
     6212           other-cli-loc          = 0
     6213           road-tax-cli-loc       = ?
     6214           vat-cli-loc            = ?
     6215           slt-cli-loc            = ?
     6216           price-cli-with-tax-loc = ?.
     6217      end.
     6218   ASSIGN
     6219             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6220       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6221   .
     6222                                       assign
     6223                                           p-road-tax-rubl =  road-tax-rubl-loc
     6224                                           p-road-tax-base =  road-tax-base-loc
     6225                                           .
     6226                                   end.
     6227                         end.
     6228                        end.
     6229               end.
     6230   end procedure.
     6231   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6232   procedure doc-code:
     6233   define input  parameter parmode          as   character           no-undo.
     6234   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     6235   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     6236   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     6237   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     6238   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     6239   define variable vardb-remote     as   logical             no-undo.
     6240   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     6241   define variable v-delimiter as character no-undo .
     6242   do
     6243   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     6244   :
     6245   find first buf_sys-ctrl no-lock .
     6246   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     6247     CASE parmode:
     6248       when "main":u then do:
     6249         if vardb-remote then do:
     6250           assign
     6251             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     6252         end.
     6253         else do:
     6254           assign
     6255             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     6256         end.
     6257       end.
     6258       when "trio" then do:
     6259         assign
     6260           pardoc-code = replace (parroot-doc-code, "=", "*").
     6261       end.
     6262       otherwise do:
     6263         assign
     6264         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     6265         no-error
     6266         .
     6267         if error-status:error  then do:
     6268           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     6269                                         ,chr(10)
     6270                                         ,parmode
     6271                                         ).
     6272         end.
     6273         if num-entries(parmode) = 1
     6274         and parmode <> "chip":U
     6275         and parmode <> "chip_s":U
     6276         then do:
     6277           assign
     6278           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     6279         end.
     6280         else if (lookup("chip":U, parmode) > 0
     6281                  or
     6282                  lookup("chip_s":U, parmode) > 0) then do:
     6283           assign
     6284             vartemp-doc-code = parroot-doc-code.
     6285           do while true:
     6286             if index (vartemp-doc-code , ".") = 0 then
     6287               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     6288             else
     6289               vartemp-doc-code  =
     6290               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     6291               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     6292               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     6293             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     6294           end.
     6295           assign
     6296             pardoc-code = vartemp-doc-code.
     6297         end.
     6298       end.
     6299     end CASE.
     6300     if pardoc-code = '':U
     6301     or (parroot-doc-code <> '':U
     6302     and pardoc-code = parroot-doc-code) then do:
     6303       undo, return error substitute("Ошибка при генерации номера документа&1"
     6304                                     ,chr(10)).
     6305     end.
     6306   end.
     6307   end. // procedure/method
     6308   function get-doc-code-int64 returns int64
     6309     ( input p-doc-code as character ) :
     6310     define variable v-ind              as integer   no-undo .
     6311     define variable v-num-entries      as integer   no-undo .
     6312     define variable v-doc-code-int64   as int64     no-undo .
     6313     define variable v-canonic-doc-code as character no-undo .
     6314     assign
     6315       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     6316       v-canonic-doc-code = p-doc-code
     6317     .
     6318     do v-ind = 1 to v-num-entries
     6319     :
     6320       assign
     6321         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     6322       .
     6323     end.
     6324     assign
     6325       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     6326     .
     6327     return v-doc-code-int64 .
     6328   end. // function/method
     6329   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6330   define temp-table tt-level-dis-attr no-undo
     6331         field attr-code   like global-state-attr.attr-code
     6332         field attr-value  like global-state-attr.attr-value
     6333         index pi   attr-value descending
     6334         index pi1 is unique attr-value
     6335               attr-code .
     6336   procedure lvldsc-byattr :
     6337   define input  parameter p-attr-code  as character no-undo .
     6338   define input  parameter p-attr-value as character no-undo .
     6339   define output parameter p-val1       as decimal   no-undo .
     6340   define output parameter p-val2       as decimal   no-undo .
     6341   define output parameter p-prc        as decimal   no-undo .
     6342     do
     6343     on error undo, return error return-value
     6344     :
     6345     define variable v-str1 as character no-undo .
     6346     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     6347     v-str1 = trim ( v-str1 , chr(4) ) .
     6348    run lvldsc-bytt (
     6349         input   v-str1
     6350       , input   p-attr-value
     6351       , output  p-val1
     6352       , output  p-val2
     6353       , output  p-prc )
     6354         no-error .
     6355     end.
     6356   end procedure.
     6357   procedure lvldsc-bytt :
     6358   define input  parameter p-attr-code as character no-undo .
     6359   define input  parameter p-attr-value as character no-undo .
     6360   define output parameter p-val1 as decimal   no-undo .
     6361   define output parameter p-val2 as decimal   no-undo .
     6362   define output parameter p-prc  as decimal   no-undo .
     6363   define variable v-str1 as character no-undo .
     6364     do
     6365     on error undo, return error return-value
     6366     :
     6367     assign
     6368        v-str1 = trim ( p-attr-code , "[]()" )
     6369        p-val1 = decimal(entry(1,v-str1, ";"))
     6370        p-val2 = decimal(entry(2,v-str1, ";"))
     6371        p-prc  = decimal(p-attr-value)
     6372        no-error
     6373     .
     6374     end.
     6375   end procedure.
     6376   procedure level-dis-value :
     6377   define input  parameter p-price-prod as decimal   no-undo .
     6378   define input  parameter p-b-code     as integer   no-undo .
     6379   define input  parameter p-obj-type   as character no-undo .
     6380   define input  parameter p-obj-code   as integer   no-undo .
     6381   define output parameter p-prc as decimal   no-undo .
     6382   define variable v-level-dis-attr as character no-undo .
     6383   define variable v-type as character no-undo .
     6384   define variable v-val1 as decimal   no-undo .
     6385   define variable v-val2 as decimal   no-undo .
     6386   define variable v-prc  as decimal   no-undo .
     6387   define variable ix     as integer   no-undo .
     6388   do
     6389    on error undo, return error return-value
     6390    :
     6391   define buffer buf_goods for ub.goods  .
     6392   define buffer buf_bar-code for ub.bar-code  .
     6393   find first buf_bar-code no-lock where
     6394              buf_bar-code.b-code = p-b-code
     6395              no-error .
     6396   find first buf_goods no-lock where
     6397              buf_goods.gds-code = buf_bar-code.gds-code
     6398              no-error .
     6399   run ggoattr-value (
     6400      input   buf_goods.grp-code
     6401     ,input   v-cntxt-host-code-obj
     6402     ,input   p-obj-type
     6403     ,input   p-obj-code
     6404     ,input   'level-dis':U
     6405     ,output  v-level-dis-attr
     6406     ,output  v-type ) no-error .
     6407   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     6408     create
     6409       tt-level-dis-attr
     6410     .
     6411     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     6412     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     6413   end.
     6414   p-prc = 0 .
     6415     if p-price-prod = 0 then do:
     6416         for each tt-level-dis-attr no-lock
     6417                 :
     6418               run lvldsc-bytt (
     6419                 input   tt-level-dis-attr.attr-code
     6420               , input   tt-level-dis-attr.attr-value
     6421               , output  v-val1
     6422               , output  v-val2
     6423               , output  v-prc  )
     6424               .
     6425               if v-val1  = 0  then do:
     6426                  p-prc = v-prc .
     6427                 leave.
     6428               end.
     6429         end.
     6430     end.
     6431     else do:
     6432         for each tt-level-dis-attr no-lock
     6433                 :
     6434               run lvldsc-bytt (
     6435                 input   tt-level-dis-attr.attr-code
     6436               , input   tt-level-dis-attr.attr-value
     6437               , output  v-val1
     6438               , output  v-val2
     6439               , output  v-prc  )
     6440               .
     6441               if p-price-prod   > v-val1 and
     6442                  p-price-prod  <= v-val2 then do:
     6443                  p-prc = v-prc .
     6444                 leave.
     6445               end.
     6446         end.
     6447     end.
     6448   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     6449    end.
     6450   end procedure.
     6451   procedure calc-price-levelprod :
     6452   define input  parameter p-mode     as integer   no-undo .
     6453   define input  parameter p-rb       as character no-undo .
     6454   define input  parameter p-b-code   as integer   no-undo .
     6455   define input  parameter p-obj-type as character no-undo .
     6456   define input  parameter p-obj-code as integer   no-undo .
     6457   define output parameter p-price-sale as decimal   no-undo .
     6458   define output parameter p-descript-calc as character no-undo .
     6459   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     6460   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     6461   define variable  v-prod-vat        as decimal   no-undo init 0.
     6462   define variable  v-discnt          as decimal   no-undo init 0.
     6463   define buffer buf_goods for ub.goods  .
     6464   define buffer buf_bar-code for ub.bar-code  .
     6465   define buffer buf_parts for ub.parts  .
     6466   define variable v-part-code as character no-undo .
     6467   define variable v-in-code   as character no-undo .
     6468     do
     6469     on error undo, return error return-value
     6470     :
     6471   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     6473   (  input  p-b-code
     6474    , input  p-obj-type
     6475    , input  p-obj-code
     6476    , output v-PriceWithoutVat
     6477    , output v-PriceWithVat
     6478    , output v-prod-vat
     6479    , output v-part-code
     6480    , output v-in-code
     6481           ) no-error .
     6482         if error-status :error then do:
     6483           return error "Нет цены производителя!".
     6484         end.
     6485   find first buf_bar-code no-lock where
     6486              buf_bar-code.b-code = p-b-code
     6487              no-error .
     6488   find first buf_goods no-lock where
     6489              buf_goods.gds-code = buf_bar-code.gds-code
     6490              no-error .
     6491   find first buf_parts no-lock where
     6492              buf_parts.artic      = buf_goods.artic        and
     6493              buf_parts.prod-type  = buf_goods.prod-type    and
     6494              buf_parts.prod-code  = buf_goods.prod-code    and
     6495              buf_parts.in-code    = buf_bar-code.in-code   and
     6496              buf_parts.out-code   = buf_bar-code.in-code   and
     6497              buf_parts.part-code  = buf_bar-code.part-code
     6498              no-error .
     6499               if error-status :error then do:
     6500                   find first buf_parts no-lock where
     6501                             buf_parts.artic      = buf_goods.artic        and
     6502                             buf_parts.prod-type  = buf_goods.prod-type    and
     6503                             buf_parts.prod-code  = buf_goods.prod-code    and
     6504                             buf_parts.in-code    = v-in-code              and
     6505                             buf_parts.out-code   = v-in-code              and
     6506                             buf_parts.part-code  = v-part-code
     6507                             no-error .
     6508                   if error-status :error then do:
     6509                      message
     6510                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     6511                                   v-in-code,
     6512                                   v-part-code ,
     6513                                   buf_goods.artic   ,
     6514                                   buf_goods.prod-type,
     6515                                   buf_goods.prod-code ) .
     6516                      return error "Нет цены производителя !!!".
     6517                   end.
     6518               end.
     6519   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     6520   define variable v-postWithoutVat-rubl as decimal   no-undo .
     6521   define variable v-postWithoutVat-base as decimal   no-undo .
     6522      case p-mode :
     6523       when 1 then do:
     6524          if p-rb = "rubl" then do:
     6525             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     6526          end.
     6527          else do:
     6528             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     6529          end.
     6530       end.
     6531       when 2 then do:
     6532         if p-rb = "rubl" then do:
     6533           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     6534           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     6535         end.
     6536         else do:
     6537           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     6538           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     6539         end.
     6540       end.
     6541      end case.
     6542   p-descript-calc =
     6543     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     6544     buf_goods.gds-name                  +  chr(10) +
     6545     buf_goods.artic +
     6546     buf_goods.prod-type +
     6547     string(buf_goods.prod-code)         + chr(10) +
     6548     "бар-код " +  string(p-b-code)      + chr(10)  +
     6549     'ПН    ' + v-in-code  +
     6550     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     6551     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     6552     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     6553     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     6554     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     6555     chr(10) +
     6556     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     6557     chr(10) +
     6558     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     6559     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     6560     chr(10) +
     6561     string(p-price-sale)                                                               +  chr(10) +
     6562     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     6563     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     6564   .
     6565     end.
     6566   end procedure.
     6567   define buffer bb-price-list for ub.price-list .
     6568   define buffer p-doc for ub.price-doc .
