     1289   function hvrdtax return logical (input parrecid as recid):
     1290   define variable varresult as logical no-undo.
     1291   run hvrdtax-proc (input parrecid, output varresult).
     1292   return varresult.
     1293   end function.
     1294   procedure hvrdtax-proc:
     1295   define input  parameter parrecid  as recid   no-undo.
     1296   define output parameter parresult as logical no-undo.
     1297   define buffer bf_goods for ub.goods.
     1298   define buffer bf_units for ub.units.
     1299   define buffer rt_tax   for ub.tax.
     1300   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1301   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1302   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1303   if available rt_tax and
     1304       can-find(first ub.tax-units No-LOCK WHERE
     1305                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1306                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1307                                                       else assign parresult = no.
     1308   end procedure.
     1309   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   procedure tax-name:
     1311   define input  parameter pardef-tax  as character           no-undo.
     1312   define output parameter parname-tax as character initial ? no-undo.
     1313   define buffer bf_tax for ub.tax.
     1314   do on error undo, return error :
     1315      case pardef-tax:
     1316         when 'vat':U then do:
     1317                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     1318         end.
     1319         when 'slt':U then do:
     1320                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     1321         end.
     1322         when 'rdt':U then do:
     1323                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     1324         end.
     1325         when 'exc':U then do:
     1326                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     1327         end.
     1328         otherwise do:
     1329            return error "Задан неверный параметр " + pardef-tax + " .".
     1330         end.
     1331      end case.
     1332   end.
     1333   end procedure.
