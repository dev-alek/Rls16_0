     4909                       buf-price-list.price-calc  = buf_contract-specif.price-cli
     4910                       buf-price-list.price-sale  = buf_contract-specif.price-cli * (1 + loc-increase-pc / 100)
     4911                       tt-price-sale   = buf_contract-specif.price-cli * (1 + loc-increase-pc / 100)
     4912                     .
     4913                   end.
