     6819        SPACE(34.12) SKIP(8.74)
     6820       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6821            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6822            TITLE "Строка переоценки"
     6823            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
     6824   ASSIGN
     6825          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     6826          FRAME Dialog-Frame:HIDDEN           = TRUE.
     6827   ASSIGN
     6828          ub.price-list.excise:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     6829   ASSIGN
     6830          ub.price-list.road-tax:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     6831   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     6832   DO:
     6833     APPLY "END-ERROR":U TO SELF.
     6834   END.
     6835   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     6836   DO:
     6837   run calc-pr in this-procedure .
     6838   END.
     6839   ON CHOOSE OF b-exit-cycl IN FRAME Dialog-Frame
     6840   DO:
     6841   assign frame  Dialog-Frame
     6842        ub.price-list.price-sale
     6843        .
     6844        assign
     6845        ub.price-list.d-pcnt       = p-disc
     6846        ub.price-list.calc-method  = c-m
     6847        ub.price-list.price-calc = ub.price-list.price-sale
     6848        .
     6849        assign
     6850        stp-cycle  =  true
     6851        .
     6852   END.
     6853   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
     6854   OR HELP OF FRAME Dialog-Frame
     6855   DO:
     6856   END.
     6857   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     6858   DO:
     6859          stp-cycle  =  false.
     6860          return "error".
     6861   END.
     6862   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     6863   DO:
     6864    run upd-field in this-procedure .
     6865    run calc-pr in this-procedure .
     6866   assign frame  Dialog-Frame
     6867        ub.price-list.price-sale
     6868        .
     6869        assign
     6870        ub.price-list.d-pcnt       = p-disc
     6871        ub.price-list.calc-method  = c-m
     6872        ub.price-list.price-calc = ub.price-list.price-sale
     6873        .
     6874        stp-cycle  =  false.
     6875   END.
     6876   ON LEAVE OF ub.price-list.excise IN FRAME Dialog-Frame
     6877   DO:
     6878       run upd-field in this-procedure no-error.
     6879   END.
     6880   ON LEAVE OF ub.price-list.price-sale IN FRAME Dialog-Frame
     6881   DO:
     6882     run upd-field in this-procedure no-error.
     6883     run calc-pr in this-procedure .
     6884   END.
     6885   ON LEAVE OF ub.price-list.road-tax IN FRAME Dialog-Frame
     6886   DO:
     6887       run upd-field in this-procedure no-error.
     6888   END.
     6889   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     6890   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     6891   find first p-doc where recid(p-doc) = doc-rec no-lock no-error.
     6892   find first ub.price-list where recid(ub.price-list) = p-doc-rec .
     6893   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6894   on help of frame Dialog-Frame
     6895   do:
     6896     run gbl/app_help.p
     6897       (input this-procedure :file-name
     6898       ,input ''
     6899       ,input ?
     6900       ) no-error.
     6901     if error-status :error then do:
     6902       message
     6903         "Ошибка при вызове помощи"
     6904         error-status :get-message(1)
     6905         view-as alert-box .
     6906     end.
     6907   end.
     6908   run minbtn-set in this-procedure .
     6909   on choose of b-help in frame Dialog-Frame
     6910   do:
     6911     apply "help":u to frame Dialog-Frame .
     6912   end.
     6913   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6914   procedure minbtn-set :
     6915       do
     6916           on error undo, return error return-value
     6917           :
     6918           define variable ii              as integer       no-undo .
     6919           define variable fh              as widget-handle no-undo .
     6920           define variable hh              as widget-handle no-undo .
     6921           define variable v-h             as handle        extent 4 no-undo .
     6922           define variable v-name-button   as character     no-undo .
     6923           define variable v-help-old-x    as decimal       no-undo .
     6924           define variable v-help-old-y    as decimal       no-undo .
     6925           define variable v-help-old-size as decimal       no-undo .
     6926           define variable v-frame-width   as decimal       no-undo .
     6927           define variable jj              as integer       no-undo .
     6928           do
     6929               on error undo, return error
     6930               :
     6931               assign
     6932                   v-frame-width = frame Dialog-Frame:width - 0.3
     6933                   fh            = frame Dialog-Frame:first-child
     6934                   hh            = fh:first-child
     6935                   ii            = 1
     6936                   .
     6937               do while valid-handle(hh):
     6938                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6939                   do:
     6940                       case lc(hh:name) :
     6941                           when "b-help" then
     6942                               do:
     6943                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6944                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6945                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6946                                   hh:TOOLTIP = "Помощь" .
     6947                                   v-help-old-x = hh:column .
     6948                                   v-help-old-y = hh:row    .
     6949                                   v-help-old-size = hh:width .
     6950                                   hh:width-chars = 2.5 .
     6951                               end.
     6952                           when "b-print" then
     6953                               do:
     6954                                   hh:load-image("cmp/b-print.bmp":u) .
     6955                                   hh:TOOLTIP = "Печать" .
     6956                                   v-h[ii] = hh:handle .
     6957                                   ii = ii + 1 .
     6958                                   hh:width-chars = 3 .
     6959                               end.
     6960                           when "b-history" or
     6961                           when "b-hist" then
     6962                               do:
     6963                                   hh:load-image("cmp/b-hist.bmp":u) .
     6964                                   hh:TOOLTIP = "История" .
     6965                                   v-h[ii] = hh:handle .
     6966                                   ii = ii + 1 .
     6967                                   hh:width-chars = 3 .
     6968                               end.
     6969                           when "b-sch" then
     6970                               do:
     6971                                   hh:load-image("cmp/b-sch.bmp":u) .
     6972                                   hh:TOOLTIP = "Установка Фильтра" .
     6973                                   v-h[ii] = hh:handle .
     6974                                   ii = ii + 1 .
     6975                                   hh:width-chars = 3 .
     6976                               end.
     6977                           when "b-hist-user" then
     6978                               do:
     6979                                   hh:load-image("cmp/b-hist.bmp":u) .
     6980                                   hh:TOOLTIP = "История пользователя" .
     6981                                   ii = ii + 1 .
     6982                               end.
     6983                       end case.
     6984                   end.
     6985                   hh = hh:next-sibling.
     6986               end.
     6987               b-help:column = v-frame-width - b-help:width-chars.
     6988               jj = 0.
     6989               repeat ii = 4 to 1 by -1 :
     6990                   if valid-handle (v-h[ii] ) then
     6991                   do:
     6992                       jj  = jj + 1 .
     6993                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6994                       v-h[ii]:row    = v-help-old-y .
     6995                   end.
     6996               end.
     6997           end.
     6998       end.
     6999   end procedure.
     7000   MAIN-BLOCK:
     7001   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7002      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     7003     run enable_ui in this-procedure .
     7004     run loc-init in this-procedure  .
     7005     if  line-mode = "ЦИКЛ":U then do:
     7006        enable  b-exit-cycl with frame Dialog-Frame.
     7007        display b-exit-cycl  with frame Dialog-Frame.
     7008        end.
     7009     WAIT-FOR GO OF FRAME Dialog-Frame.
     7010   END.
     7011   run disable_ui in this-procedure .
     7012   PROCEDURE calc-pr :
     7013   if p-doc.status_ <> 'акт':U and available ub.gds-obj then do:
     7014     new-avrg = input frame Dialog-Frame ub.price-list.price-sale - ub.gds-obj.avrg-rubl.
     7015     new-last = input frame Dialog-Frame ub.price-list.price-sale - ub.gds-obj.last-rubl.
     7016     pc-avrg = (input frame Dialog-Frame ub.price-list.price-sale / ub.gds-obj.avrg-rubl - 1) * 100.
     7017     pc-last  = (input frame Dialog-Frame ub.price-list.price-sale / ub.gds-obj.last-rubl - 1) * 100.
     7018     old-avrg = old-price - ub.gds-obj.avrg-rubl.
     7019     old-last = old-price - ub.gds-obj.last-rubl.
     7020     op-avrg = (old-price / ub.gds-obj.avrg-rubl - 1) * 100.
     7021     op-last = (old-price / ub.gds-obj.last-rubl - 1) * 100.
     7022     disp pc-avrg pc-last new-avrg new-last old-avrg old-last op-avrg op-last with frame Dialog-Frame no-error .
     7023   end.
     7024   new-old = input frame Dialog-Frame ub.price-list.price-sale - old-price.
     7025   pc-prev = (input frame Dialog-Frame ub.price-list.price-sale / old-price - 1) * 100.
     7026   s-new-old = new-old * ub.price-list.doc-qnty.
     7027   s-old = old-price * ub.price-list.doc-qnty.
     7028   s-new = input frame Dialog-Frame ub.price-list.price-sale * ub.price-list.doc-qnty.
     7029   disp new-old pc-prev s-new-old s-old s-new ub.price-list.doc-qnty with frame Dialog-Frame no-error .
     7030   END PROCEDURE.
     7031   PROCEDURE disable_UI :
     7032     HIDE FRAME Dialog-Frame.
     7033   END PROCEDURE.
     7034   PROCEDURE enable_UI :
     7035     OPEN QUERY Dialog-Frame FOR EACH ub.price-list       WHERE recid(ub.price-list) = p-doc-rec SHARE-LOCK,       EACH ub.goods OF ub.price-list SHARE-LOCK.
     7036     GET FIRST Dialog-Frame.
     7037     DISPLAY info b-curr old-price new-old pc-prev loc-gds-obj-avrg op-avrg pc-avrg
     7038             old-avrg new-avrg loc-gds-obg-last op-last pc-last old-last new-last
     7039             loc-in-code loc-in-date akt-num akt-date s-old s-new s-new-old v-dis
     7040         WITH FRAME Dialog-Frame.
     7041     IF AVAILABLE ub.goods THEN
     7042       DISPLAY ub.goods.gds-name
     7043         WITH FRAME Dialog-Frame.
     7044     IF AVAILABLE ub.price-list THEN
     7045       DISPLAY ub.price-list.price-sale ub.price-list.doc-num ub.price-list.artic
     7046             ub.price-list.prod-code ub.price-list.prod-type ub.price-list.b-code
     7047             ub.price-list.doc-qnty
     7048         WITH FRAME Dialog-Frame.
     7049     ENABLE RECT-1 RECT-2 info ub.price-list.price-sale b-calc B-save b-quit B-Help
     7050            ub.price-list.doc-num ub.price-list.artic ub.price-list.prod-code
     7051            ub.price-list.prod-type ub.price-list.b-code b-curr ub.goods.gds-name old-price
     7052            new-old pc-prev loc-gds-obj-avrg op-avrg pc-avrg old-avrg new-avrg
     7053            loc-gds-obg-last op-last pc-last old-last new-last loc-in-code
     7054            loc-in-date akt-num akt-date s-old s-new s-new-old ub.price-list.doc-qnty
     7055            v-dis
     7056         WITH FRAME Dialog-Frame.
     7057     VIEW FRAME Dialog-Frame.
     7058   END PROCEDURE.
     7059   PROCEDURE loc-init :
     7060   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7061   define variable cur-ex like ub.price-list.excise     no-undo.
     7062   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7063   define variable cur-pr like ub.price-list.price-sale    no-undo.
     7064   define buffer lp-price-doc for ub.price-doc.
     7065   define buffer buff-goods for ub.goods.
     7066   define variable dor-nal as character no-undo .
     7067   define variable ff as logical no-undo .
     7068   define variable   is-petrolium  as logical             no-undo.
     7069   define variable   is-pieces     as logical             no-undo.
     7070   define variable v-rec as recid no-undo.
     7071   define variable t-ret as logical no-undo .
     7072   c-m = 'Отсутствует':U .
     7073   v-dis =  p-disc.
     7074     frame Dialog-Frame:title = frame Dialog-Frame:title + " -  " + line-mode.
     7075     run tax-name in this-procedure ( input 'rdt':U, output  dor-nal) .
     7076     assign ub.price-list.road-tax :label in frame Dialog-Frame = dor-nal .
     7077     Find first buff-goods no-lock where
     7078           buff-goods.artic     = ub.price-list.artic and
     7079           buff-goods.prod-type = ub.price-list.prod-type and
     7080           buff-goods.prod-code = ub.price-list.prod-code
     7081           no-error .
     7082         If avail buff-goods Then DO:
     7083             v-rec = recid (buff-goods).
     7084              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7085   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7086     (
     7087        input ub.price-list.artic
     7088     ,  input ub.price-list.prod-type
     7089     ,  input ub.price-list.prod-code
     7090     , output is-petrolium
     7091     , output is-pieces
     7092     ) .
     7093              t-ret =  session:SET-WAIT-STATE("") .
     7094                 IF ( hvrdtax( v-rec ) = true and
     7095                    is-petrolium = true )
     7096                   then  DO :
     7097                     define variable v-chk-act-host-code as integer   no-undo .
     7098   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7100     (input  ub.price-list.obj-code
     7101     ,input  ub.price-list.obj-type
     7102     ,output v-chk-act-host-code
     7103     )  .
