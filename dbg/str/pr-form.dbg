     2079           end.
     2080       end.
     2081   end.
     2082   if par-pr-sclex = "yes" and
     2083      par-pr-notls = "yes" then do:
     2084       if v-cur-dn <> "" then do:
     2085           for each old_price-list no-lock where
     2086                    old_price-list.doc-num    = v-cur-dn and
     2087                    old_price-list.artic      = buf_goods.artic and
     2088                    old_price-list.prod-type  = buf_goods.prod-type and
     2089                    old_price-list.prod-code  = buf_goods.prod-code and
     2090                    old_price-list.main-price = no,
     2091                   first buf_bar-code no-lock where
     2092                         buf_bar-code.b-code   = old_price-list.b-code and
     2093                         buf_bar-code.in-code  = "" and
     2094                         buf_bar-code.unit-cli = buf_goods.unit-base
     2095                         :
     2096                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2097                          if error-status :error then next.
     2098                    run create-line-pdf-mpl-lib (
     2099                          input buf_price-doc-forming.plt-db-num
     2100                         ,input buf_price-doc-forming.plt-id
     2101                         ,input buf_price-doc-forming.pdf-db
     2102                         ,input buf_price-doc-forming.pdf-id
     2103                         ,input p-line-num
     2104                         ,input old_price-list.b-code
     2105                         ,input buf_goods.artic
     2106                         ,input buf_goods.prod-type
     2107                         ,input buf_goods.prod-code
     2108                         ,input ""
     2109                         ,input 0
     2110                         ,input old_price-list.price-sale
     2111                         ,input ""
     2112                         ,input 0
     2113                       ,input-output v-sec ) no-error .
     2114           end.
     2115       end.
     2116   end.
     2117   end.
     2118   end procedure.
     2119   procedure copy_new_price-doc-forming :
     2120   define input  parameter       p-recid      as recid no-undo .
     2121   define input-output parameter p-plt-db-num as integer   no-undo .
     2122   define input-output parameter p-plt-id     as integer   no-undo .
     2123   define output parameter       p-pdf-db-num as integer   no-undo .
     2124   define output parameter       p-pdf-id     as integer   no-undo .
     2125   define buffer buf_price-list-type        for ub.price-list-type  .
     2126   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     2127   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     2128   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     2129   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     2130   define variable v-host-code  as integer   no-undo .
     2131   define variable v-base-rate  as decimal   no-undo .
     2132   define variable v-base-scale as integer   no-undo .
     2133   define variable v-exch-rate  as decimal   no-undo .
     2134   define variable v-exch-scale as integer   no-undo .
     2135   define variable v-base as logical   no-undo .
     2136   define variable v-name as character no-undo .
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2142     (output v-base
     2143     )  .
     2144   find first buf_price-list-type no-lock where
     2145              buf_price-list-type.plt-db-num = p-plt-db-num and
     2146              buf_price-list-type.plt-id     = p-plt-id no-error .
     2147   if error-status :error then return error "Не найден ТПЛ".
     2148   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     2149   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     2150       if available buf_price-doc-forming then do :
     2151           assign
     2152             v-base-rate  = buf_price-doc-forming.base-rate
     2153             v-base-scale = buf_price-doc-forming.base-scale
     2154             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     2155           .
     2156       end.
     2157       else do:
     2158           assign
     2159             v-base-rate  = 1
     2160             v-base-scale = 1
     2161             v-name       = "Автосоздание"
     2162           .
     2163       end.
     2164      create ub.price-doc-forming.
     2165      assign
     2166         ub.price-doc-forming.plt-id       = p-plt-id
     2167         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2168         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2169         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2170         ub.price-doc-forming.base-rate    = v-base-rate
     2171         ub.price-doc-forming.base-scale   = v-base-scale
     2172         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2173         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2174         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2175         ub.price-doc-forming.stts         = 0
     2176         ub.price-doc-forming.sys-date     = today
     2177         ub.price-doc-forming.sys-time     = time
     2178         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2179         ub.price-doc-forming.who          = v-cntxt-userid
     2180         ub.price-doc-forming.name         = v-name
     2181      .
     2182      assign
     2183       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2184       p-pdf-id      = ub.price-doc-forming.pdf-id
     2185       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2186       p-plt-id      = ub.price-doc-forming.plt-id
     2187      .
     2188     end.
     2189     if not available buf_price-doc-forming then return .
     2190   for each buf_price-doc-forming-attr no-lock where
     2191            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2192            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2193            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2194            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2195       create ub.price-doc-forming-attr.
     2196       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     2197       assign
     2198         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     2199         ub.price-doc-forming-attr.plt-id      = p-plt-id
     2200         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2201         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2202         .
     2203   end.
     2204   for each buf_price-doc-forming-gds no-lock where
     2205            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2206            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2207            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2208            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2209       create ub.price-doc-forming-gds.
     2210       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2211       assign
     2212         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2213         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2214         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2215         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2216       .
     2217   end.
     2218   for each buf_pd-forming-gds-attr no-lock where
     2219            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2220            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2221            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2222            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2223       create ub.price-doc-forming-gdsattr.
     2224       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2225       assign
     2226         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2227         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2228         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2229         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2230       .
     2231   end.
     2232   end procedure.
     2233   define variable par-pr-incpc as character no-undo.
     2234   define variable par-pr-rndmt as character no-undo.
     2235   define variable par-pr-rndbs as character no-undo.
     2236   define variable par-pr-clt-q as character no-undo.
     2237   define variable par-pr-dpl-q as character no-undo.
     2238   define variable par-pr-rdc-q as character no-undo.
     2239   define variable par-pr-abs-d as character no-undo.
     2240   define variable par-pr-altex as character no-undo.
     2241   define variable par-pr-parex as character no-undo.
     2242   define variable par-pr-sclex as character no-undo.
     2243   define variable par-pr-notls as character no-undo.
     2244   define variable par-pr-equ-dq as integer  no-undo.
     2245   define variable par-pr-discm as character no-undo .
     2246   define variable par-pr-dscnt as character no-undo .
     2247   define variable par-pr-print as character no-undo .
     2248   define variable par-pr-sigma as character no-undo .
     2249   define variable par-pr-goods as character no-undo.
     2250   define variable par-pr-nogds as character no-undo.
     2251   define variable par-alcohol  as character no-undo.
     2252   define variable par-gen-mrgn-ie as character no-undo .
     2253   define variable par-gen-mrgn-iv as character no-undo .
     2254   define variable par-gen-mrgn-im as character no-undo .
     2255   define variable par-pr-nakl-ie  as logical   no-undo .
     2256   define variable par-pr-nakl-iv  as logical   no-undo .
     2257   define variable par-pr-nakl-im  as logical   no-undo .
     2258   define variable par-pr-nogds-long as longchar no-undo .
     2259   define temp-table tmp-proof-price no-undo
     2260     field node-code like ub.gds-grp.node-code
     2261     field proof as decimal
     2262     field price as decimal
     2263   index pi node-code proof descending .
     2264   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2266   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2267   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2268   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2269   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2270   ASSIGN
     2271      v-S_CONTRACT                = "Contract":U
     2272      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2273      v-DELIM_CHR_3               = ","
     2274      .
     2275   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2276   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2277   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2278   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2279      INPUT iHost-Code    AS INTEGER,
     2280      INPUT iContract-Num AS INTEGER,
     2281      INPUT iGds-Code     AS INTEGER ):
     2282      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2283      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2284      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2285      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2286      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2287      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2288          INPUT  iHost-Code,
     2289          INPUT  iContract-Num,
     2290          OUTPUT iTmp-Extent3
     2291          ).
     2292      IF iTmp-Extent3[1] = 2 THEN DO:
     2293         ASSIGN
     2294            iTmp-Host-Code      = iTmp-Extent3[2]
     2295            iTmp-Contract-Num   = iTmp-Extent3[3]
     2296            .
     2297      END. ELSE DO:
     2298         ASSIGN
     2299            iTmp-Host-Code      = iHost-Code
     2300            iTmp-Contract-Num   = iContract-Num
     2301            .
     2302      END.
     2303      IF iGds-Code = ? THEN DO:
     2304         ASSIGN
     2305            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2306                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2307                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2308                           ).
     2309      END. ELSE DO:
     2310            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2311                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2312                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2313                              AND buf_Spec.Gds-Code      = iGds-Code
     2314                            ).
     2315      END.
     2316      RETURN (lRet).
     2317   END FUNCTION.
     2318   PROCEDURE MS-Contract-EXTENT-3:
     2319      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2320      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2321      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2322      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2323      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2324      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2325      FIND FIRST buf_Cont-2 WHERE
     2326                 buf_Cont-2.Host-Code      = i-Host-Code
     2327             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2328           NO-LOCK NO-ERROR.
     2329      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2330         RETURN.
     2331      END.
     2332      FOR FIRST buf_Ext-Classif WHERE
     2333                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2334           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2335                                               STRING(i-Contract-code)
     2336           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2337          NO-LOCK,
     2338          EACH buf_Cont WHERE
     2339               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2340           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2341          NO-LOCK:
     2342          ASSIGN
     2343             i-Ret[1] = 1
     2344             i-Ret[2] = buf_Cont.Host-code
     2345             i-Ret[3] = buf_Cont.Contract-code
     2346             .
     2347          LEAVE.
     2348      END.
     2349      IF i-Ret[1] <> 1 THEN DO:
     2350         FOR FIRST buf_Ext-Classif WHERE
     2351                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2352              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2353                                                  STRING(i-Contract-code)
     2354              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2355             NO-LOCK,
     2356             EACH buf_Cont WHERE
     2357                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2358              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2359             NO-LOCK:
     2360             ASSIGN
     2361                i-Ret[1] = 2
     2362                i-Ret[2] = buf_Cont.Host-code
     2363                i-Ret[3] = buf_Cont.Contract-code
     2364                .
     2365             LEAVE.
     2366         END.
     2367      END.
     2368      RETURN.
     2369   END PROCEDURE.
     2370   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2371   procedure ggoattr-code :
     2372     define input  parameter p-code           as character no-undo .
     2373     define output parameter p-type           as character no-undo .
     2374     define output parameter p-format         as character no-undo .
