      274       end case.
      275     end.
      276   function cross-list returns logical (
      277     input parfirst-stream  as character,
      278     input parsecond-stream as character,
      279     input pardelim         as character).
      280     if pardelim = ""
      281     or pardelim = ?
      282     then do:
      283       assign
      284         pardelim = ","
      285       .
      286     end.
      287     define variable vari            as integer no-undo .
      288     define variable varresult-cross as logical no-undo .
      289     assign
      290       varresult-cross = no
      291     .
      292     def var v-num-parfirst-stream as integer no-undo .
      293     assign
      294       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      295     .
      296     do vari = 1 to v-num-parfirst-stream
      297     :
      298       if lookup(entry(vari, parfirst-stream, pardelim)
      299                ,parsecond-stream
      300                ,pardelim
      301                ) > 0 then do:
      302         assign
      303           varresult-cross = yes
      304         .
      305         leave.
      306       end.
      307     end.
      308     return varresult-cross .
      309   end function.
