     2004     ,output main-b-code
     2005     ) no-error .
     2006   run check-use-bar-code (main-b-code) no-error .
     2007   if error-status :error then return .
     2008   run create-line-pdf-mpl-lib (
     2009        input buf_price-doc-forming.plt-db-num
     2010       ,input buf_price-doc-forming.plt-id
     2011       ,input buf_price-doc-forming.pdf-db
