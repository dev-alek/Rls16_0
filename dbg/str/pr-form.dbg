     1582         .
     1583       else  f-pr = ?.
     1584   else f-pr = ?.
     1585      return ( f-pr ).
     1586   end function.
     1587   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1588   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1589                                           local-doc-num as char).
     1590   define buffer base-price        for ub.price-list.
     1591   define variable local-main-code like ub.bar-code.b-code no-undo.
     1592   define variable local-base-code like ub.bar-code.b-code no-undo.
     1593     run prc-base-code (input local-bc, output local-base-code).
     1594     find base-price no-lock where
     1595          base-price.doc-num = local-doc-num and
     1596          base-price.b-code  = local-base-code and
     1597          base-price.price-type = "" no-error.
     1598     if not available base-price then do:
     1599       run prc-main-code (input local-bc, output local-main-code).
     1600       find  base-price no-lock where
     1601             base-price.doc-num = local-doc-num and
     1602             base-price.b-code  = local-main-code and
     1603             base-price.price-type = "" no-error.
     1604     end.
     1605     if available base-price then
     1606       return (base-price.price-sale).
     1607     else
     1608       return (?).
     1609   END FUNCTION.
     1610   procedure prc-main-code:
     1611   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1612   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1613   define buffer local-bar-code        for ub.bar-code.
     1614   define buffer local-goods           for ub.goods.
     1615   define buffer main-code             for ub.bar-code.
     1616   define buffer main-prt              for ub.gds-prt.
     1617     local-main-code = ?.
     1618     find local-bar-code no-lock where
     1619          local-bar-code.b-code = local-bc no-error.
     1620     if not available local-bar-code then
     1621       return.
     1622     find local-goods no-lock where
     1623          local-goods.gds-code = local-bar-code.gds-code.
     1624     find first  main-prt no-lock where
     1625                 main-prt.upper-code = local-goods.prt-root.
     1626     find  main-code no-lock where
     1627           main-code.gds-code  = local-bar-code.gds-code and
     1628           main-code.in-code   = "" and
     1629           main-code.part-code = "" and
     1630           main-code.unit-cli  = local-goods.unit-base and
     1631           main-code.node-code = main-prt.node-code.
     1632     local-main-code = main-code.b-code.
     1633   end procedure.
     1634   procedure prc-base-code:
     1635   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1636   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1637   define buffer local-bar-code for ub.bar-code.
     1638   define buffer local-goods    for ub.goods.
     1639   define buffer base-code      for ub.bar-code.
     1640     local-base-code = ?.
     1641     find local-bar-code no-lock where
     1642          local-bar-code.b-code = local-bc no-error.
     1643     if not available local-bar-code then
     1644       return.
     1645     find local-goods no-lock where
     1646          local-goods.gds-code = local-bar-code.gds-code.
     1647     find base-code no-lock where
     1648          base-code.gds-code  = local-bar-code.gds-code and
     1649          base-code.node-code = local-bar-code.node-code and
     1650          base-code.in-code   = local-bar-code.in-code and
     1651          base-code.part-code = local-bar-code.part-code and
     1652          base-code.unit-cli  = local-goods.unit-base.
     1653     local-base-code = base-code.b-code.
     1654   end procedure.
     1655   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1657   procedure prcreate-new-price-doc :
     1658   do
     1659   on error undo, return error return-value
     1660   :
     1661   define input  parameter p-curr-db-num  as integer   no-undo .
     1662   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1663   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1664   define input  parameter p-plt-id       as integer   no-undo .
     1665   define input  parameter p-plt-db-num   as integer   no-undo .
     1666   define input  parameter p-pdf-id       as integer   no-undo .
     1667   define input  parameter p-pdf-db-num   as integer   no-undo .
     1668   define output parameter p-price-doc-recid  as recid                no-undo.
     1669   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1670   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1671   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1672   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1673   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1674   define buffer buf_price-doc         for ub.price-doc.
     1675   find first buf_price-doc-forming no-lock where
     1676              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1677              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1678              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1679              buf_price-doc-forming.plt-id     = p-plt-id
     1680              no-error .
     1681   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1682      run create_new_price-doc-forming
     1683           ( input p-obj-type ,
     1684             input p-obj-code ,
     1685             output p-pdf-db-num ,
     1686             output p-pdf-id ,
     1687             output p-plt-db-num ,
     1688             output p-plt-id
     1689             ).
     1690       find first buf_price-doc-forming no-lock where
     1691                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1692                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1693                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1694                 buf_price-doc-forming.plt-id     = p-plt-id
     1695                 no-error .
     1696   end.
     1697       create buf_price-doc .
     1698       run doc-code in this-procedure
     1699       (input  "main",
     1700        input  p-obj-type  ,
     1701        input  p-obj-code  ,
     1702        input  ?,
     1703        output buf_price-doc.doc-num) no-error.
     1704       if error-status:error then do:
     1705         message vss-workfile vss-revision vss-description skip
     1706                error-status :get-message(1)
     1707               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1708         return error.
     1709       end.
     1710   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1712     (input  p-obj-type
     1713     ,input  p-obj-code
     1714     ,output v-host-code
     1715     )  .
     1716       v-obj-current-date  = today .
     1717       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1718           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1719           v-base-scale  =  buf_price-doc-forming.base-scale .
     1720       end.
     1721       else do:
     1722   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1724     (input  v-host-code
     1725     ,input  v-obj-current-date
     1726     ,output v-base-rate
     1727     ,output v-base-scale
     1728     )  .
     1729       end.
     1730      assign
     1731       buf_price-doc.base-rate      = v-base-rate
     1732       buf_price-doc.base-scale     = v-base-scale
     1733       buf_price-doc.cr-db-num      = p-curr-db-num
     1734       buf_price-doc.doc-date       = v-obj-current-date
     1735       buf_price-doc.fact-num       = 0
     1736       buf_price-doc.host-code      = v-host-code
     1737       buf_price-doc.is-corr        = false
     1738       buf_price-doc.is-del         = false
     1739       buf_price-doc.obj-code       = p-obj-code
     1740       buf_price-doc.obj-type       = p-obj-type
     1741       buf_price-doc.out-code       = ""
     1742       buf_price-doc.pdf-db         = p-pdf-db-num
     1743       buf_price-doc.pdf-id         = p-pdf-id
     1744       buf_price-doc.plt-db-num     = p-plt-db-num
     1745       buf_price-doc.plt-id         = p-plt-id
     1746       buf_price-doc.PS             = "@ "
     1747       buf_price-doc.rest-base      = 0
     1748       buf_price-doc.rest-last      = 0
     1749       buf_price-doc.rest-qnty      = 0
     1750       buf_price-doc.rest-sale      = 0
     1751       buf_price-doc.sale-base      = 0
     1752       buf_price-doc.status_        = 'новый':U
     1753       .
     1754       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1755       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1756       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1757       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1758       assign
     1759           p-price-doc-recid = recid ( buf_price-doc )
     1760       .
     1761   end.
     1762   end procedure.
     1763   procedure prcreate-new-price-list :
     1764   do
     1765   on error undo, return error return-value
     1766   :
     1767   define input parameter p-price-doc-recid   as recid                    no-undo.
     1768   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1769   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1770   define output parameter p-update           as logical                  no-undo.
     1771   define variable kk as integer no-undo .
     1772   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1773   define variable p-hostcode as int no-undo .
     1774   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1775   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1776   define buffer buf_price-doc        for ub.price-doc.
     1777   define buffer buf_price-list       for ub.price-list.
     1778   define buffer buf_bar-code         for ub.bar-code.
     1779   define buffer buf_goods            for ub.goods.
     1780   define buffer buf_root_gds-prt     for ub.gds-prt.
     1781   define buffer buf_gds-prt          for ub.gds-prt.
     1782   find first buf_price-doc no-lock
     1783        where recid( buf_price-doc ) = p-price-doc-recid
     1784   .
     1785   find first buf_goods no-lock
     1786        where buf_goods.gds-code = p-gds-code
     1787   .
     1788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1789     (input  p-gds-code
     1790     ,input  ?
     1791     ,output v-b-code
     1792     ) no-error .
     1793   if error-status :error
     1794   then do:
     1795       message
     1796           "Не найден основной бар-код"
     1797           skip "для товара "
     1798           skip string(buf_goods.artic)
     1799           skip buf_goods.gds-name
     1800       view-as alert-box
     1801       title "Ошибка при выполнении prcreate.i".
     1802       undo, return error .
     1803   end.
     1804   find first buf_bar-code no-lock
     1805        where buf_bar-code.b-code = v-b-code
     1806   no-error.
     1807   if error-status :error
     1808   then do:
     1809       message
     1810           "Не найдена запись bar-code"
     1811           skip "для товара "
     1812           skip string(buf_goods.artic)
     1813           skip buf_goods.gds-name
     1814           skip "С основным бар-кодом"
     1815           skip string(v-b-code)
     1816       view-as alert-box
     1817       title "Ошибка при выполнении prcreate.i".
     1818       undo, return error .
     1819   end.
     1820   find first buf_root_gds-prt no-lock
     1821        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1822   .
     1823   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1824     and buf_bar-code.in-code <> ""
     1825   then do:
     1826       message
     1827           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1828           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1829           view-as alert-box error.
     1830       undo, return error.
     1831   end.
     1832   find first buf_gds-prt no-lock
     1833        where buf_gds-prt.node-code = buf_bar-code.node-code
     1834   .
     1835   find first buf_price-list
     1836        where buf_price-list.doc-num = buf_price-doc.doc-num
     1837          and buf_price-list.b-code  = v-b-code
     1838   no-error.
     1839   if available buf_price-list
     1840   then do:
     1841       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1842          skip "  Цена:   " buf_price-list.price-sale
     1843          skip "Цена будет изменена"
     1844       view-as alert-box warning.
     1845       assign
     1846           p-update = yes
     1847       .
     1848   end.
     1849   else do:
     1850   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1852     (input  buf_price-doc.obj-type
     1853     ,input  buf_price-doc.obj-code
     1854     ,output p-hostcode
     1855     ) no-error .
     1856   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1858     (input  buf_goods.gds-code
     1859     ,input  '1':U
     1860     ,input  ?
     1861     ,input  p-hostcode
     1862     ,input  buf_price-doc.obj-type
     1863     ,input  buf_price-doc.obj-code
     1864     ,output local_vat-pc
     1865     ) no-error .
     1866   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1868     (input  buf_goods.gds-code
     1869     ,input  '2':U
     1870     ,input  ?
     1871     ,input  p-hostcode
     1872     ,input  buf_price-doc.obj-type
     1873     ,input  buf_price-doc.obj-code
     1874     ,output local_slt-pc
     1875     ) no-error .
     1876       kk = kk + 1.
     1877   define variable v-main-bar-code as integer   no-undo .
     1878   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1879     (input  buf_goods.gds-code
     1880     ,input  ?
     1881     ,output v-main-bar-code
     1882     )  .
     1883       create buf_price-list.
     1884       assign
     1885           buf_price-list.line-num    = kk
     1886           buf_price-list.doc-num     = buf_price-doc.doc-num
     1887           buf_price-list.b-code      = buf_bar-code.b-code
     1888           buf_price-list.artic       = buf_goods.artic
     1889           buf_price-list.prod-type   = buf_goods.prod-type
     1890           buf_price-list.prod-code   = buf_goods.prod-code
     1891           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1892           buf_price-list.calc-method = 'Отсутствует':U
     1893           buf_price-list.obj-type    = buf_price-doc.obj-type
     1894           buf_price-list.obj-code    = buf_price-doc.obj-code
     1895           buf_price-list.price-sale  = p-price-sale
     1896           buf_price-list.vat-pc      = local_vat-pc
     1897           buf_price-list.slt-pc      = local_slt-pc
     1898           p-update                   = no
     1899       .
     1900   end.
     1901   end.
     1902   end procedure.
     1903   procedure create_new_price-doc-forming :
     1904   define input  parameter p-obj-type   as character no-undo .
     1905   define input  parameter p-obj-code   as integer   no-undo .
     1906   define output parameter p-pdf-db-num as integer   no-undo .
     1907   define output parameter p-pdf-id     as integer   no-undo .
     1908   define output parameter p-plt-db-num as integer   no-undo .
     1909   define output parameter p-plt-id     as integer   no-undo .
     1910   define buffer buf_price-list-type for ub.price-list-type  .
     1911   define variable v-host-code  as integer   no-undo .
     1912   define variable v-base-rate  as decimal   no-undo .
     1913   define variable v-base-scale as integer   no-undo .
     1914   define variable v-exch-rate  as decimal   no-undo .
     1915   define variable v-exch-scale as integer   no-undo .
     1916   define variable v-base as logical   no-undo .
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1922     (output v-base
     1923     )  .
     1924   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1926     (input  p-obj-type
     1927     ,input  p-obj-code
     1928     ,output v-host-code
     1929     )  .
     1930   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1932     (input  v-host-code
     1933     ,input  today
     1934     ,output v-base-rate
     1935     ,output v-base-scale
     1936     )  .
     1937   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1938   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1939     (input  ?
     1940     ,input  p-obj-type
     1941     ,input  p-obj-code
     1942     ,input  yes
     1943     ,output p-plt-id
     1944     ,output p-plt-db-num
     1945     )  .
     1946      create ub.price-doc-forming.
     1947      assign
     1948         ub.price-doc-forming.plt-id       = p-plt-id
     1949         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1950         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1951         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1952         ub.price-doc-forming.base-rate    = v-base-rate
     1953         ub.price-doc-forming.base-scale   = v-base-scale
     1954         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1955         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1956         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1957         ub.price-doc-forming.stts         = 0
     1958         ub.price-doc-forming.sys-date     = today
     1959         ub.price-doc-forming.sys-time     = time
     1960         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1961         ub.price-doc-forming.who          = v-cntxt-userid
     1962         ub.price-doc-forming.name         = "автосоздание"
     1963      .
     1964      assign
     1965       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1966       p-pdf-id      = ub.price-doc-forming.pdf-id
