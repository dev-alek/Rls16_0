      593   procedure grp-obj-write :
      594   do
      595   on error undo, return error
      596   :
      597   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      598   define input parameter p-host-code  as integer                          no-undo.
      599   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      600   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      601   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      602   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      603   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      604   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      605   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      606   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      607   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      608   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      609   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      610       find first buf_gds-grp-obj exclusive-lock
      611            where buf_gds-grp-obj.node-code  = p-node-code
      612              and buf_gds-grp-obj.host-code  = p-host-code
      613              and buf_gds-grp-obj.obj-type   = p-obj-type
      614              and buf_gds-grp-obj.obj-code   = p-obj-code
      615       no-error.
      616       if not available buf_gds-grp-obj
      617       then do:
      618           create buf_gds-grp-obj.
      619           assign
      620                   buf_gds-grp-obj.node-code  = p-node-code
      621                   buf_gds-grp-obj.host-code  = p-host-code
      622                   buf_gds-grp-obj.obj-type   = p-obj-type
      623                   buf_gds-grp-obj.obj-code   = p-obj-code
      624           .
      625       end.
      626       assign
      627       buf_gds-grp-obj.min-increase = p-min-increase
      628       buf_gds-grp-obj.max-increase = p-max-increase
      629       buf_gds-grp-obj.increase-pc = p-increase-pc
      630       buf_gds-grp-obj.calc-method = p-calc-method
      631       buf_gds-grp-obj.round-method = p-round-method
      632       buf_gds-grp-obj.round-coef = p-round-coef
      633       buf_gds-grp-obj.cli-type   = p-cli-type
      634       buf_gds-grp-obj.cli-code   = p-cli-code
      635       .
      636   end.
      637   end procedure.
      638   procedure grp-obj-margin-value :
      639   do
      640   on error undo, return error
      641   :
      642   define input parameter p-node-code as integer      no-undo.
      643   define input parameter p-obj-type  as character    no-undo.
      644   define input parameter p-obj-code  as integer      no-undo.
      645   define output parameter p-min-value as decimal      no-undo init ?.
      646   define output parameter p-max-value as decimal      no-undo init ?.
      647   define output parameter p-increase-pc as decimal      no-undo init ?.
      648   define output parameter p-round-method as character no-undo init "":U.
      649   define output parameter p-base as decimal no-undo init ?.
      650   define output parameter p-range-margin     as integer      no-undo.
      651   define output parameter p-exists-margin    as logical      no-undo.
      652   define output parameter p-range-increase     as integer      no-undo.
      653   define output parameter p-exists-increase    as logical      no-undo.
      654   define output parameter p-range-rmethod     as integer no-undo .
      655   define output parameter p-exists-rmethod    as logical no-undo .
      656   define variable v-host-code as integer      no-undo.
      657   DEFINE VARIABLE v-found as logical no-undo .
      658   DEFINE VARIABLE v-exists as logical no-undo .
      659   DEFINE VARIABLE v-range as integer no-undo .
      660   DEFINE VARIABLE jj as integer no-undo .
      661   DEFINE VARIABLE v-margin-found as logical no-undo .
      662   DEFINE VARIABLE v-increase-found as logical no-undo .
      663   DEFINE VARIABLE v-min-value as decimal      no-undo.
      664   DEFINE VARIABLE v-max-value as decimal      no-undo.
      665   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      666   define variable v-round-method as character no-undo .
      667   define variable v-base as decimal no-undo .
      668   define variable v-print-code as character no-undo .
      669   define buffer buf_gds-grp for ub.gds-grp.
      670   find first buf_gds-grp no-lock where
      671              buf_gds-grp.node-code = p-node-code no-error .
      672   if not avail buf_gds-grp and p-node-code <> 0 then do:
      673     message
      674       vss-workfile vss-revision vss-description
      675       skip "Не удалось найти группу товаров с кодом" p-node-code
      676       view-as alert-box error .
      677     undo, return error .
      678   end.
      679   if p-obj-type <> '' then do:
      680   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      682     (input  p-obj-type
      683     ,input  p-obj-code
      684     ,output v-host-code
      685     ) no-error .
      686     if error-status :error
      687     then do:
      688         message
      689           vss-workfile vss-revision vss-description
      690           skip "Не удалось найти фирму объекта"
      691           skip p-obj-type p-obj-code
      692           skip return-value
      693           skip trim(error-status :get-message(1))
      694               trim(error-status :get-message(2))
      695               trim(error-status :get-message(3))
      696               trim(error-status :get-message(4))
      697               trim(error-status :get-message(5))
      698         view-as alert-box error.
      699         undo, return error .
      700     end.
      701   end.
      702   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      703   do while v-found = no and jj < 2:
      704     if v-range <> 3 then do:
      705       find first buf_gds-grp-obj no-lock
      706           where buf_gds-grp-obj.node-code = p-node-code
      707             and buf_gds-grp-obj.host-code = v-host-code
      708             and buf_gds-grp-obj.obj-type  = p-obj-type
      709             and buf_gds-grp-obj.obj-code  = p-obj-code
      710       no-error .
      711     end.
      712     if v-range = 3 or not available buf_gds-grp-obj
      713     then do:
      714        if v-range <> 2 then do:
      715           find first buf_gds-grp-obj no-lock
      716               where buf_gds-grp-obj.node-code = p-node-code
      717                 and buf_gds-grp-obj.host-code = v-host-code
      718                 and buf_gds-grp-obj.obj-type  = ""
      719                 and buf_gds-grp-obj.obj-code  = 0
      720           no-error .
      721         end.
      722         if v-range = 2 or not available buf_gds-grp-obj
      723         then do:
      724             if v-range <> 1 then do:
      725               find first buf_gds-grp-obj no-lock
      726                   where buf_gds-grp-obj.node-code = p-node-code
      727                   and buf_gds-grp-obj.host-code = 0
      728                   and buf_gds-grp-obj.obj-type  = ""
      729                   and buf_gds-grp-obj.obj-code  = 0
      730               no-error .
      731             end.
      732             if v-range = 1 or not available buf_gds-grp-obj
      733             then do:
      734                 assign
      735                     v-exists = no
      736                 .
      737             end.
      738             else do:
      739                 assign
      740                     v-exists = yes
      741                     v-range = 1
      742                 .
      743             end.
      744         end.
      745         else do:
      746             assign
      747                 v-exists = yes
      748                 v-range  = 2
      749             .
      750         end.
      751     end.
      752     else do:
      753         assign
      754             v-exists = yes
      755             v-range  = 3
      756         .
      757     end.
      758     if available buf_gds-grp-obj
      759     then do:
      760       assign
      761       v-min-value    = buf_gds-grp-obj.min-increase
      762       v-max-value    = buf_gds-grp-obj.max-increase
      763       v-increase-pc  = buf_gds-grp-obj.increase-pc
      764       v-round-method = buf_gds-grp-obj.round-method
      765       v-base         = buf_gds-grp-obj.round-coef
      766       .
      767       assign
      768       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      769                           then yes
      770                           else p-exists-margin)
      771       p-range-margin = if p-exists-margin and p-min-value = ?
      772                         then v-range
      773                         else p-range-margin
      774       p-min-value   =  if p-exists-margin and  p-min-value = ?
      775                         then v-min-value
      776                         else p-min-value
      777       p-max-value   =  if p-exists-margin and  p-max-value = ?
      778                         then v-max-value
      779                         else p-max-value
      780       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      781                           then yes
      782                           else p-exists-increase)
      783       p-range-increase = if p-exists-increase and p-increase-pc = ?
      784                         then v-range
      785                         else p-range-increase
      786       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      787                         then v-increase-pc
      788                         else p-increase-pc)
      789       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      790                           then yes
      791                           else p-exists-rmethod
      792       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      793                           then v-range
      794                           else p-range-rmethod)
      795       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      796                           then v-round-method
      797                           else p-round-method)
      798       p-base          = (if p-exists-rmethod and p-base = ?
      799                           then v-base
      800                           else p-base)
      801       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      802       jj = jj + 1
      803       .
      804     end.
      805     else do:
      806       assign
      807       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      808       jj = jj + 1
      809       .
      810     end.
      811   end.
      812   end.
      813   end procedure.
