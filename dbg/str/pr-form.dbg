     6752   DEFINE FRAME Dialog-Frame
     6753        "Новая" VIEW-AS TEXT
     6754             SIZE 15 BY 1 AT ROW 11.21 COL 35.13
     6755             BGCOLOR 3 FGCOLOR 15
     6756        "Учетная" VIEW-AS TEXT
     6757             SIZE 15 BY 1 AT ROW 5.21 COL 5.13
     6758             BGCOLOR 3 FGCOLOR 15
     6759        "ПРОЦЕНТ" VIEW-AS TEXT
     6760             SIZE 15 BY .96 AT ROW 3.21 COL 65.13
     6761             BGCOLOR 3 FGCOLOR 15
