     1504   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-list).
     1505   define variable f-cost     as decimal no-undo .
     1506   define variable f-cost-pc  as decimal no-undo .
     1507   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1508                          ub.goods.prod-type = local-price-list.prod-type and
     1509                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1510   find ub.gds-obj no-lock where
     1511        ub.gds-obj.gds-code = ub.goods.gds-code and
     1512        ub.gds-obj.obj-type = local-price-list.obj-type and
     1513        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1514   if  available ub.gds-obj then
     1515     if ub.goods.gds-type = 'т':U then
     1516       assign
     1517         f-cost = ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base)
     1518         .
     1519       else  f-cost = ?.
     1520   else f-cost = ?.
     1521    f-cost-pc = (round(local-price-list.price-sale / f-cost , 2) - 1) * 100.
     1522     if f-cost-pc > 9999 then
     1523       f-cost-pc = ?.
     1524     return (f-cost-pc).
     1525   end function.
     1526   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-list).
     1527   define variable f-pr     as decimal no-undo .
     1528   define variable f-pr-pc  as decimal no-undo.
     1529   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1530                          ub.goods.prod-type = local-price-list.prod-type and
     1531                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1532   find ub.gds-obj no-lock where
     1533        ub.gds-obj.gds-code = ub.goods.gds-code and
     1534        ub.gds-obj.obj-type = local-price-list.obj-type and
     1535        ub.gds-obj.obj-code = local-price-list.obj-code  no-error .
     1536   if  available ub.gds-obj then do:
     1537     if ub.goods.gds-type = 'т':U then
     1538       assign
     1539         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     1540         .
     1541       else f-pr = ?.
     1542   end.
     1543   else f-pr = ?.
     1544     f-pr-pc = ( local-price-list.price-sale / f-pr - 1 ) * 100.
     1545     if f-pr-pc > 9999 then
     1546       f-pr-pc = ?.
     1547     return (f-pr-pc).
     1548   end function.
     1549   function fnc-cost return decimal (buffer local-price-list for ub.price-list).
     1550   define variable f-cost   as decimal no-undo .
     1551   find first ub.goods where
     1552              ub.goods.artic = local-price-list.artic and
     1553              ub.goods.prod-type = local-price-list.prod-type and
     1554              ub.goods.prod-code = local-price-list.prod-code no-lock
     1555              no-error .
     1556   find ub.gds-obj no-lock where
     1557        ub.gds-obj.gds-code = ub.goods.gds-code and
     1558        ub.gds-obj.obj-type = local-price-list.obj-type and
     1559        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1560   if  available ub.gds-obj then
     1561     if ub.goods.gds-type = 'т':U then
     1562       assign
     1563         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     1564         .
     1565       else  f-cost = ?.
     1566   else f-cost = ?.
     1567     return ( f-cost ).
     1568   end function.
     1569   function fnc-pr return decimal (buffer local-price-list for ub.price-list).
     1570   define variable f-pr   as decimal no-undo .
     1571   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1572                          ub.goods.prod-type = local-price-list.prod-type and
     1573                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1574   find ub.gds-obj no-lock where
     1575        ub.gds-obj.gds-code = ub.goods.gds-code and
     1576        ub.gds-obj.obj-type = local-price-list.obj-type and
     1577        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1578   if  available ub.gds-obj then
     1579     if ub.goods.gds-type = 'т':U then
     1580       assign
