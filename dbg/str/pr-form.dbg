     4893                   run read-bonus (
     4894                       input  buf_contract-specif.contract-num  ,
     4895                       input  buf_contract-specif.host-code     ,
     4896                       input  buf_contract-specif.gds-code      ,
     4897                       output v-bonus  ) .
     4898                   if v-bonus <> ? and v-bonus <> 0 then do:
     4899                     assign
     4900                       buf-price-list.calc-method = 'Спецификация':U
     4901                       buf-price-list.price-calc  = buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )
     4902                       buf-price-list.price-sale = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + loc-increase-pc / 100)
     4903                       tt-price-sale  = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + loc-increase-pc / 100)
     4904                     .
     4905                   end.
     4906                   else do:
     4907                     assign
