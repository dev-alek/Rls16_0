     2858   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     2859     (input  ?
     2860     ,input  l-type
     2861     ,input  l-code
     2862     ,output par-gen-mrgn-ie
     2863     ,output par-gen-mrgn-iv
     2864     ,output par-gen-mrgn-im
     2865     ) no-error .
     2866      IF error-status :error THEN message
     2867        vss-workfile vss-revision vss-description skip
     2868        error-status :get-message(1) skip
     2869        return-value skip
     2870        "gbl/gtplmrgn.i"
