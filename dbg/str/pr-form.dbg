     2872      .
     2873   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2874   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2875     (input  ?
     2876     ,input  l-type
     2877     ,input  l-code
     2878     ,output par-pr-nakl-ie
     2879     ,output par-pr-nakl-iv
     2880     ,output par-pr-nakl-im
     2881     ) no-error .
     2882      define variable ii as integer   no-undo .
     2883      define variable nn as integer   no-undo .
     2884      define variable v-fullname as character no-undo .
     2885      nn = num-entries ( par-pr-nogds ).
     2886      par-pr-nogds-long = "".
     2887      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2888         repeat ii = 1 to nn :
     2889           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2890           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2891         end.
     2892         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2893      end.
     2894   l-par = true .
     2895   end procedure.
     2896   PROCEDURE cre-pr-list:
     2897   define input  parameter bc      like ub.price-list.b-code no-undo.
     2898   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2899   define output parameter new-rec as recid             no-undo.
     2900   define buffer buf-price-list for ub.price-list.
     2901   define buffer buf-price-doc  for ub.price-doc.
     2902   define buffer buf-bar-code   for ub.bar-code.
     2903   define buffer buf-goods      for ub.goods.
     2904   define buffer buf-gds-prt    for ub.gds-prt.
     2905   define buffer root-gds-prt   for ub.gds-prt.
     2906   define variable cur-pr like ub.price-list.price-sale no-undo.
     2907   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2908   define variable cur-ex like ub.price-list.excise     no-undo.
     2909   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2910   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2911   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2912   define variable cur-rt-base as decimal no-undo .
     2913   define variable cur-rt-rubl as decimal no-undo .
     2914   define variable p-hostcode as int no-undo .
     2915   define variable v-line-num as integer no-undo .
     2916   define variable v-skip-del-gds as logical no-undo initial no .
     2917   cre-pr:
     2918   do on error undo cre-pr, return error:
     2919     find  buf-bar-code no-lock where
     2920           buf-bar-code.b-code = bc.
     2921     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2922     if error-status :error then do:
     2923       message
     2924         return-value skip
     2925         "Ошибка !"
     2926         view-as alert-box error
     2927       .
     2928       undo cre-pr, return.
     2929     end.
     2930     find  buf-goods no-lock where
     2931           buf-goods.gds-code = buf-bar-code.gds-code.
     2932     find first root-gds-prt no-lock where
     2933               root-gds-prt.upper-code = buf-goods.prt-root.
     2934     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2935       buf-bar-code.in-code <> "" then do:
     2936       message
     2937         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2938         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2939         view-as alert-box error.
     2940       undo cre-pr, return.
     2941     end.
     2942     find  buf-gds-prt no-lock where
     2943           buf-gds-prt.node-code = buf-bar-code.node-code.
     2944     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2945       message
     2946         "Не допускается создавать цены на удаленные товары!" skip (2)
     2947         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2948         view-as alert-box error.
     2949       undo cre-pr, return.
     2950     end.
     2951     find  buf-price-doc where
     2952           buf-price-doc.doc-num = new-num.
     2953   define variable v-ret as logical no-undo .
     2954      run ver-modificator-price-is-null (
     2955             input    buf-goods.artic        ,
     2956             input    buf-goods.prod-type    ,
     2957             input    buf-goods.prod-code    ,
     2958             input    buf-price-doc.obj-type   ,
     2959             input    buf-price-doc.obj-code   ,
     2960             output   v-ret ).
     2961         if v-ret = false then dO:
     2962             message
     2963               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2964               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2965               view-as alert-box error.
     2966             undo cre-pr, return.
     2967           end.
     2968   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2970     (input  buf-price-doc.obj-type
     2971     ,input  buf-price-doc.obj-code
     2972     ,output p-hostcode
     2973     ) no-error .
     2974   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2975   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2976     (input  buf-goods.gds-code
     2977     ,input  '1':U
     2978     ,input  ?
     2979     ,input  p-hostcode
     2980     ,input  buf-price-doc.obj-type
     2981     ,input  buf-price-doc.obj-code
     2982     ,output local_vat-pc
     2983     ) no-error .
     2984   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2986     (input  buf-goods.gds-code
     2987     ,input  '2':U
     2988     ,input  ?
     2989     ,input  p-hostcode
     2990     ,input  buf-price-doc.obj-type
     2991     ,input  buf-price-doc.obj-code
     2992     ,output local_slt-pc
     2993     ) no-error .
     2994   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2996     (input  buf-price-doc.obj-type
     2997     ,input  buf-price-doc.obj-code
     2998     ,input  bc
     2999     ,input  0
     3000     ,input  0
     3001     ,output cur-dn
     3002     ,output cur-pr
     3003     ,output cur-rt
     3004     ,output cur-ex
     3005     ) no-error .
     3006     find first buf-price-list where
     3007               buf-price-list.b-code  = buf-bar-code.b-code and
     3008               buf-price-list.doc-num = new-num  and
     3009               buf-price-list.price-type = ""    no-error .
     3010     if not available buf-price-list then do:
     3011       run calc-price-line-num (input  new-num , output v-line-num) .
     3012       create buf-price-list.
     3013       assign
     3014         buf-price-list.line-num  = v-line-num
     3015         buf-price-list.b-code    = buf-bar-code.b-code
     3016         buf-price-list.doc-num   = buf-price-doc.doc-num
     3017         buf-price-list.prod-type = buf-goods.prod-type
     3018         buf-price-list.prod-code = buf-goods.prod-code
     3019         buf-price-list.artic     = buf-goods.artic
     3020         buf-price-list.obj-type  = buf-price-doc.obj-type
     3021         buf-price-list.obj-code  = buf-price-doc.obj-code
     3022         buf-price-list.vat-pc    = local_vat-pc
     3023         buf-price-list.slt-pc    = local_slt-pc
     3024         buf-price-list.price-prev = cur-pr
     3025         .
     3026       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     3027           buf-bar-code.in-code   = "" and
     3028           buf-bar-code.part-code = "" and
     3029           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     3030         buf-price-list.main-price = yes.
     3031         if cur-pr <> ? then do:
     3032           run exp-prt (input buf-goods.gds-code,
     3033                       input cur-dn,
     3034                       input new-num,
     3035                       output new-rec) no-error.
     3036           if error-status :error then do:
     3037             message
     3038               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     3039               view-as alert-box error.
     3040             undo cre-pr, return error.
     3041           end.
     3042         end.
     3043       end.
     3044       else do:
     3045         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3046           buf-price-list.d-pcnt = ?.
     3047         end.
     3048         buf-price-list.main-price = no.
     3049       end.
     3050     end.
     3051   end.
     3052   new-rec = recid (buf-price-list).
     3053   END PROCEDURE.
     3054   procedure calc-price-line-num :
     3055    do
     3056    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3057    :
     3058   define input parameter p-doc-num as character no-undo .
     3059   define output parameter p-num  as integer no-undo .
     3060   define variable v-fact as integer no-undo .
     3061   define buffer buf_1_price-list for ub.price-list .
     3062   p-num = 1 .
     3063   find last  buf_1_price-list no-lock where
     3064              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     3065              if available buf_1_price-list then
     3066                   assign
     3067                     v-fact = buf_1_price-list.line-num
     3068                   .
     3069   v-fact = v-fact + 1.
     3070   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     3071    end.
     3072   end procedure.
     3073   PROCEDURE del-pr-list:
     3074   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3075   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3076   define input parameter round-method as character         no-undo.
     3077   define input parameter round-base   as decimal      no-undo.
     3078   define buffer buf-price-list for ub.price-list.
     3079   define buffer buf-bar-code   for ub.bar-code.
     3080   define buffer buf-goods      for ub.goods.
     3081   define variable l-ov-on as logical no-undo .
     3082   del-pr:
     3083   do on error undo del-pr, return error:
     3084     find first  buf-price-list no-lock where
     3085                 buf-price-list.doc-num    = d-num and
     3086                 buf-price-list.b-code     = bc and
     3087                 buf-price-list.price-type = "" no-error.
     3088     if not available buf-price-list then
     3089       undo del-pr, return error.
     3090     find  buf-goods no-lock where
     3091           buf-goods.prod-type = buf-price-list.prod-type and
     3092           buf-goods.prod-code = buf-price-list.prod-code and
     3093           buf-goods.artic     = buf-price-list.artic.
     3094     if buf-price-list.main-price then do:
     3095       for each  buf-price-list exclusive-lock where
     3096                 buf-price-list.doc-num   = d-num and
     3097                 buf-price-list.artic     = buf-goods.artic and
     3098                 buf-price-list.prod-type = buf-goods.prod-type and
     3099                 buf-price-list.prod-code = buf-goods.prod-code,
     3100           first buf-bar-code no-lock where
     3101                 buf-bar-code.b-code = buf-price-list.b-code
     3102       on error undo del-pr, return error:
     3103   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3105     (input  ub.buf-price-list.obj-type
     3106     ,input  ub.buf-price-list.obj-code
     3107     ,input  ub.buf-price-list.artic
     3108     ,input  ub.buf-price-list.prod-type
     3109     ,input  ub.buf-price-list.prod-code
     3110     ,input  'ov-on=request:exclusive'
     3111     ,output l-ov-on
     3112     ) no-error .
     3113         if error-status:error then do:
     3114           message
     3115             vss-workfile vss-revision vss-description skip
     3116             "Ошибка получения признака товара на объекте" skip
     3117             error-status :get-message(1) skip
     3118             return-value skip
     3119             view-as alert-box error .
     3120         end.
     3121         if l-ov-on then do:
     3122   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3124     (input  ub.buf-price-list.obj-type
     3125     ,input  ub.buf-price-list.obj-code
     3126     ,input  ub.buf-price-list.artic
     3127     ,input  ub.buf-price-list.prod-type
     3128     ,input  ub.buf-price-list.prod-code
     3129     ,input  'ov-on=false'
     3130     ,output l-ov-on
     3131     ) no-error .
     3132           if error-status :error then do:
     3133           end.
     3134          end.
     3135         delete buf-price-list.
     3136       end.
     3137     end.
     3138     else do:
     3139       find  buf-bar-code no-lock where
     3140             buf-bar-code.b-code = buf-price-list.b-code.
     3141       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3142         message
     3143           "Нельзя удалить неосновную цену." skip
     3144           "Неосновная цена (скидка) не может быть неопределенной." skip
     3145           "Код:" bc skip
     3146           "Переоценка:" d-num
     3147           view-as alert-box error.
     3148         undo del-pr, return error.
     3149       end.
     3150       find current buf-price-list exclusive-lock no-error .
     3151       delete buf-price-list.
     3152       run calc-base-upd (input buf-bar-code.b-code,
     3153                         input d-num,
     3154                         input round-method,
     3155                         input round-base) no-error.
     3156       if error-status :error then
     3157         undo del-pr, return error.
     3158     end.
     3159   end.
     3160   END PROCEDURE.
     3161   PROCEDURE calc-base-upd:
     3162   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3163   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3164   define input parameter round-method as character         no-undo.
     3165   define input parameter round-base   as decimal      no-undo.
     3166   define buffer alt-bar-code   for ub.bar-code.
     3167   define buffer alt-price-list for ub.price-list.
     3168   define buffer buf-bar-code   for ub.bar-code.
     3169   define buffer buf-goods      for ub.goods.
     3170   calc-base:
     3171   do on error undo calc-base, return error:
     3172     find  buf-bar-code no-lock where
     3173           buf-bar-code.b-code = bc.
     3174     find  buf-goods no-lock where
     3175           buf-goods.gds-code = buf-bar-code.gds-code.
     3176     for each  alt-bar-code no-lock where
     3177               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     3178               alt-bar-code.node-code = buf-bar-code.node-code and
     3179               alt-bar-code.part-code = buf-bar-code.part-code and
     3180               alt-bar-code.in-code   = buf-bar-code.in-code and
     3181               alt-bar-code.unit-cli <> buf-goods.unit-base,
     3182         each  alt-price-list where
     3183               alt-price-list.doc-num    = d-num and
     3184               alt-price-list.b-code     = alt-bar-code.b-code and
     3185               alt-price-list.price-type = ""
     3186         on error undo calc-base, return error:
     3187       run calc-pr-alt (input d-num,
     3188                       input alt-bar-code.b-code,
     3189                       input round-method,
     3190                       input round-base) no-error.
     3191       if error-status:error then
     3192         undo calc-base, return error.
     3193     end.
     3194   end.
     3195   END PROCEDURE.
     3196   PROCEDURE calc-pr-alt:
     3197   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3198   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3199   define input parameter r-method as character             no-undo.
     3200   define input parameter r-base   as decimal              no-undo.
     3201   define buffer buf-price-doc  for ub.price-doc.
     3202   define buffer buf-price-list for ub.price-list.
     3203   define buffer buf-bar-code   for ub.bar-code.
     3204   define buffer buf-goods      for ub.goods.
     3205   define buffer old-price-list for ub.price-list.
     3206   define variable pr-rec   as   recid                  no-undo.
     3207   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3208   pr-alt:
     3209   do on error undo pr-alt, return error:
     3210     if r-method = ? or
     3211        r-base = ? then do:
     3212       message
     3213         "Нельзя удалить основную цену." skip
     3214         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     3215         "Код:" bc skip
     3216         "Переоценка:" d-num
     3217         view-as alert-box error.
     3218       undo pr-alt, return error.
     3219     end.
     3220     find  buf-price-doc where
     3221           buf-price-doc.doc-num = d-num.
     3222     find  buf-bar-code no-lock where
     3223           buf-bar-code.b-code = bc.
     3224     find  buf-goods no-lock where
     3225           buf-goods.gds-code = buf-bar-code.gds-code.
     3226     find  buf-price-list where
     3227           buf-price-list.doc-num = buf-price-doc.doc-num and
     3228           buf-price-list.b-code  = bc.
     3229     if buf-price-list.d-pcnt = ? then do:
     3230   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3232     (input  buf-price-doc.obj-type
     3233     ,input  buf-price-doc.obj-code
     3234     ,input  bc
     3235     ,input  0
     3236     ,input  0
     3237     ,output pr-rec
     3238     ,output pr-c-b-r
     3239     )  .
     3240       find old-price-list no-lock where
     3241           recid (old-price-list) = pr-rec no-error.
     3242       if available old-price-list and
     3243         old-price-list.b-code = bc then
     3244         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     3245       else
     3246         buf-price-list.d-pcnt = 0.
     3247     end.
     3248      if buf-price-list.d-pcnt = ? then do:
     3249         assign
     3250           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     3251           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     3252           .
     3253     end.
     3254     else do:
     3255         assign
     3256           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     3257                                         buf-bar-code.cli-base-rate *
     3258                                         (1 - buf-price-list.d-pcnt / 100)
     3259           buf-price-list.calc-method =  'Основная':U
     3260           .
     3261   case r-method :
     3262     when '9-окончание':U then do:
     3263       if buf-price-list.price-sale < 29 then do:
     3264         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     3265           assign
     3266             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     3267           .
     3268         end.
     3269       end.
     3270       else do:
     3271         if (buf-price-list.price-sale modulo 10) < 3 then do:
     3272           assign
     3273             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3274                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3275                   - 1 ) * 10
     3276                 + 9
     3277           .
     3278         end.
     3279         else do:
     3280           assign
     3281             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3282                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3283                   ) * 10
     3284                 + 9
     3285           .
     3286         end.
     3287         assign
     3288           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3289         .
     3290       end.
     3291     end.
     3292     when '9-99окончание':U then do:
     3293       if buf-price-list.price-sale < r-base then do:
     3294         assign
     3295           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     3296         .
     3297       end.
     3298       else do:
     3299         assign
     3300           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     3301         .
     3302       end.
     3303     end.
     3304     when 'Без-дробных':U then do:
     3305       assign
     3306         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3307       .
     3308     end.
     3309     when 'Произвольно':U then do:
     3310       if r-base <> 0 then do:
     3311         assign
     3312           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     3313         .
     3314         if buf-price-list.price-sale = 0 then do:
     3315           assign
     3316             buf-price-list.price-sale = r-base
     3317           .
     3318         end.
     3319       end.
     3320     end.
     3321     when 'Вверх':U then do:
     3322       if r-base <> 0 then do:
     3323         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     3324           assign
     3325             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     3326           .
     3327         end.
     3328       end.
     3329       if buf-price-list.price-sale = 0 then do:
     3330         assign
     3331           buf-price-list.price-sale = r-base
     3332         .
     3333       end.
     3334     end.
     3335     when 'Коэффициент':U then do:
     3336       if r-base <> 0 then do:
     3337         assign
     3338           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     3339         .
     3340       end.
     3341     end.
     3342     when 'Отключено':U then do:
     3343     end.
     3344     otherwise do:
     3345       message
     3346         vss-workfile vss-revision vss-description skip
     3347         "Неизвестный метод округления продажной цены" skip
     3348         "round-method" r-method skip
     3349         "round-base"   r-base   skip
     3350         "price"        buf-price-list.price-sale             skip
     3351         view-as alert-box error .
     3352     end.
     3353   end.
     3354     end.
     3355   end.
     3356   END PROCEDURE.
     3357   PROCEDURE calc-pr-discnt:
     3358   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3359   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3360   define buffer buf-price-doc  for ub.price-doc.
     3361   define buffer buf-price-list for ub.price-list.
     3362   define buffer buf-bar-code   for ub.bar-code.
     3363   define buffer buf-goods      for ub.goods.
     3364   define buffer old-price-list for ub.price-list.
     3365   define variable pr-rec   as   recid                  no-undo.
     3366   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3367   pr-discnt:
     3368   do on error undo pr-discnt, return error:
     3369     find  buf-price-doc where
     3370           buf-price-doc.doc-num = d-num.
     3371     find  buf-bar-code no-lock where
     3372           buf-bar-code.b-code = bc.
     3373     find  buf-goods no-lock where
     3374           buf-goods.gds-code = buf-bar-code.gds-code.
     3375     find  buf-price-list where
     3376           buf-price-list.doc-num = buf-price-doc.doc-num and
     3377           buf-price-list.b-code  = bc.
     3378     buf-price-list.d-pcnt = (1 -
     3379                              buf-price-list.price-sale /
     3380                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3381                              buf-bar-code.cli-base-rate) *
     3382                              100
     3383                              .
     3384   end.
     3385   END PROCEDURE.
     3386   PROCEDURE calc-pr-sub :
     3387   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3388   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3389   define  input  parameter calc-method  as character    no-undo.
     3390   define  input  parameter increase-pc  as decimal      no-undo.
     3391   define  input  parameter round-method as character    no-undo.
     3392   define  input  parameter round-base   as decimal      no-undo.
     3393   define  output parameter calc-rec     as recid        no-undo.
     3394   define  buffer buf-price-list for ub.price-list.
     3395   define  buffer buf-bar-code   for ub.bar-code.
     3396   define  buffer buf-goods      for ub.goods.
     3397   define  buffer buf-gds-prt    for ub.gds-prt.
     3398   define  buffer buf-gds-grp    for ub.gds-grp.
     3399   define  buffer buf-price-doc  for ub.price-doc.
     3400   calc-sub:
     3401   do on error undo calc-sub, return error:
     3402     find  buf-bar-code no-lock where
     3403           buf-bar-code.b-code = bc.
     3404     find  buf-goods no-lock where
     3405           buf-goods.gds-code = buf-bar-code.gds-code.
     3406     find  buf-gds-prt no-lock where
     3407           buf-gds-prt.node-code = buf-bar-code.node-code.
     3408     find  buf-price-list where
     3409           buf-price-list.doc-num    = d-num and
     3410           buf-price-list.b-code     = bc and
     3411           buf-price-list.price-type = "".
     3412     find  buf-price-doc where
     3413           buf-price-doc.doc-num = d-num.
     3414     calc-rec = recid (buf-price-list).
     3415     if buf-price-list.main-price then do:
     3416       for each  buf-price-list where
     3417                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3418                 buf-price-list.main-price = no and
     3419                 buf-price-list.artic      = buf-goods.artic and
     3420                 buf-price-list.prod-type  = buf-goods.prod-type and
     3421                 buf-price-list.prod-code  = buf-goods.prod-code,
     3422           first buf-bar-code no-lock where
     3423                 buf-bar-code.b-code   = buf-price-list.b-code and
     3424                 buf-bar-code.unit-cli = buf-goods.unit-base
     3425           on error undo calc-sub, return error:
     3426         run calc-pr-list (input  buf-bar-code.b-code,
     3427                           input  buf-price-list.doc-num,
     3428                           input  calc-method,
     3429                           input  increase-pc,
     3430                           input  round-method,
     3431                           input  round-base,
     3432                           input ? ,
     3433                           input ? ,
     3434                           input ? ,
     3435                           input ? ,
     3436                           output calc-rec) no-error.
     3437         if error-status :error then
     3438           undo calc-sub, return error.
     3439         calc-rec = recid (buf-price-list).
     3440       end.
     3441       for each  buf-price-list where
     3442                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3443                 buf-price-list.main-price = no and
     3444                 buf-price-list.artic      = buf-goods.artic and
     3445                 buf-price-list.prod-type  = buf-goods.prod-type and
     3446                 buf-price-list.prod-code  = buf-goods.prod-code,
     3447           first buf-bar-code no-lock where
     3448                 buf-bar-code.b-code    = buf-price-list.b-code and
     3449                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3450           on error undo calc-sub, return error:
     3451         run calc-pr-alt (input buf-price-doc.doc-num,
     3452                         input buf-bar-code.b-code,
     3453                         input round-method,
     3454                         input round-base) no-error.
     3455         if error-status :error then
     3456           undo calc-sub, return error.
     3457       end.
     3458     end.
     3459     else do:
     3460       run calc-base-upd (input buf-bar-code.b-code,
     3461                         input buf-price-doc.doc-num,
     3462                         input round-method,
     3463                         input round-base) no-error.
     3464       if error-status :error then
     3465         undo calc-sub, return error.
     3466     end.
     3467   end.
     3468   END PROCEDURE.
     3469   procedure ver-pr-nogds :
     3470   define input  parameter p-gds-code      as integer   no-undo .
     3471   define input  parameter p-par-pr-nogds  as character no-undo .
     3472   define output parameter p-not           as logical   no-undo .
     3473   define output parameter p-str           as character no-undo .
     3474   define buffer buf_goods for ub.goods  .
     3475   define variable nn as integer   no-undo .
     3476   define variable ii as integer   no-undo .
     3477   define variable v-namegrp as character no-undo .
     3478     do
     3479     on error undo, return error return-value
     3480     :
     3481     if p-par-pr-nogds = "1" then do:
     3482        assign
     3483         p-not = true
     3484         p-str = ""
     3485        .
     3486        return .
     3487     end.
     3488     assign
     3489       p-not = false
     3490       p-str = ""
     3491     .
     3492     find first buf_goods no-lock where
     3493                buf_goods.gds-code = p-gds-code no-error .
     3494     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3495     repeat ii = 1 to nn:
     3496        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3497        if buf_goods.grp-name  begins v-namegrp  then do:
     3498           assign
     3499             p-not = true
     3500             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3501           .
     3502           leave .
     3503        end.
     3504     end.
     3505     end.
     3506   end procedure.
     3507   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   PROCEDURE calc-pr-list :
     3509   define input  parameter bc          like ub.price-list.b-code   no-undo .
     3510   define input  parameter d-num       like ub.price-doc.doc-num   no-undo .
     3511   define input  parameter calc-method             as character    no-undo .
     3512   define input  parameter increase-pc             as decimal      no-undo .
     3513   define input  parameter round-method            as character    no-undo .
     3514   define input  parameter round-base              as decimal      no-undo .
     3515   define input  parameter p-doc-price-rubl        as decimal      no-undo .
     3516   define input  parameter p-doc-price-base        as decimal      no-undo .
     3517   define input  parameter p-doc-price-rubl-novat  as decimal      no-undo .
     3518   define input  parameter p-doc-price-base-novat  as decimal      no-undo .
     3519   define output parameter calc-rec                as recid        no-undo .
     3520   define buffer buf-price-list for ub.price-list.
     3521   define buffer buf-price-doc  for ub.price-doc.
     3522   define buffer buf-bar-code   for ub.bar-code.
     3523   define buffer buf-goods      for ub.goods.
     3524   define buffer buf-gds-prt    for ub.gds-prt.
     3525   define buffer buf-gds-grp    for ub.gds-grp.
     3526   define buffer buf_contract   for ub.contract .
     3527   define buffer buf_contract-specif for ub.contract-specif .
     3528   define variable cur-pr like ub.price-list.price-sale no-undo .
     3529   define variable cur-rt like ub.price-list.road-tax   no-undo .
     3530   define variable cur-ex like ub.price-list.excise     no-undo .
     3531   define variable cur-dn like ub.price-list.doc-num    no-undo .
     3532   define variable loc-ret        as logical            no-undo .
     3533   define variable old-price-sale as decimal            no-undo .
     3534   define variable v-bonus        as decimal            no-undo .
     3535   assign
     3536     loc-ret = true
     3537   .
     3538   calc-pr:
     3539   do on error undo calc-pr, return error:
     3540     find  buf-bar-code no-lock where
     3541           buf-bar-code.b-code = bc.
     3542     find  buf-goods no-lock where
     3543           buf-goods.gds-code = buf-bar-code.gds-code.
     3544     find  buf-gds-prt no-lock where
     3545           buf-gds-prt.node-code = buf-bar-code.node-code.
     3546     find  buf-price-list where
     3547           buf-price-list.doc-num    = d-num and
     3548           buf-price-list.b-code     = bc and
     3549           buf-price-list.price-type = "".
     3550     find  buf-price-doc where
     3551           buf-price-doc.doc-num = d-num.
     3552     g#log = yes.
     3553     define variable loc-increase-pc      like  ub.goods.increase-pc no-undo .
     3554     define variable loc-grp-increase-pc  like  ub.goods.increase-pc no-undo .
     3555   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-increase-pc in g#library
     3557     (input  buf-goods.gds-code
     3558     ,input  buf-price-list.obj-type
     3559     ,input  buf-price-list.obj-code
     3560     ,output  loc-increase-pc
     3561     ) no-error .
     3562     if error-status :error then do:
     3563        message vss-workfile vss-revision vss-description skip
     3564        "Ошибка метода поиска наценки товара на объекте" skip
     3565        error-status :get-message(1) .
     3566     end.
     3567   define variable p-prc-min        as decimal   no-undo .
     3568   define variable p-prc-max        as decimal   no-undo .
     3569   define variable p-round-method   as character no-undo .
     3570   define variable p-base           as decimal   no-undo .
     3571   define variable p-value-margin   as integer   no-undo .
     3572   define variable p-type-margin    as logical   no-undo .
     3573   define variable p-value-increase as integer   no-undo .
     3574   define variable p-type-increase  as logical   no-undo .
     3575   define variable p-value-rmethod  as integer   no-undo .
     3576   define variable p-type-rmethod   as logical   no-undo .
     3577   run gds-attr-margin-value
     3578   (
     3579     input   buf-goods.gds-code ,
     3580     input   buf-price-list.obj-type  ,
     3581     input   buf-price-list.obj-code  ,
     3582     output  p-prc-min  ,
     3583     output  p-prc-max  ,
     3584     output  loc-grp-increase-pc,
     3585     output  p-round-method   ,
     3586     output  p-base           ,
     3587     output  p-value-margin    ,
     3588     output  p-type-margin     ,
     3589     output  p-value-increase    ,
     3590     output  p-type-increase   ,
     3591     output  p-value-rmethod    ,
     3592     output  p-type-rmethod
     3593     ) no-error .
     3594     if error-status :error then do:
     3595        message vss-workfile vss-revision vss-description skip
     3596        "Ошибка процедуры поиска наценки по группе товара на объекте" skip
     3597        error-status :get-message(1) skip
     3598        return-value .
     3599     end.
     3600     define variable g-g as logical no-undo .
     3601     g-g = false .
     3602     case calc-method:
     3603       when 'Товар':U then do:
     3604         case buf-goods.calc-method:
     3605           when 'Группа':U then do:
     3606             find buf-gds-grp no-lock where
     3607                 buf-gds-grp.node-code = buf-goods.grp-code.
     3608             case buf-gds-grp.calc-method:
     3609      when 'Накл-безНДС':U  then do:
     3610         if ub.trn-doc.doc-type = 'при':U and
     3611            ( ub.trn-doc.ext-doc-type = 'ie':U  ) then do:
     3612                 run str/gdsnovat.p ('Накл-безНДС':U,
     3613                         buf-price-list.obj-type,
     3614                         buf-price-list.obj-code,
