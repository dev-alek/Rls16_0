      855         skip return-value
      856         skip trim(error-status :get-message(1))
      857              trim(error-status :get-message(2))
      858              trim(error-status :get-message(3))
      859              trim(error-status :get-message(4))
      860              trim(error-status :get-message(5))
      861       view-as alert-box error.
      862       undo, return error .
      863   end.
      864   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      865   do while v-found = no and jj < 2:
      866     if v-range <> 3 then do:
      867       find first buf_gds-grp-obj no-lock
      868           where buf_gds-grp-obj.node-code = p-node-code
      869             and buf_gds-grp-obj.host-code = v-host-code
      870             and buf_gds-grp-obj.obj-type  = p-obj-type
      871             and buf_gds-grp-obj.obj-code  = p-obj-code
      872       no-error .
      873     end.
      874     if v-range = 3 or not available buf_gds-grp-obj
      875     then do:
      876        if v-range <> 2 then do:
      877           find first buf_gds-grp-obj no-lock
      878               where buf_gds-grp-obj.node-code = p-node-code
      879                 and buf_gds-grp-obj.host-code = v-host-code
      880                 and buf_gds-grp-obj.obj-type  = ""
      881                 and buf_gds-grp-obj.obj-code  = 0
      882           no-error .
      883         end.
      884         if v-range = 2 or not available buf_gds-grp-obj
      885         then do:
      886             if v-range <> 1 then do:
      887               find first buf_gds-grp-obj no-lock
      888                   where buf_gds-grp-obj.node-code = p-node-code
      889                   and buf_gds-grp-obj.host-code = 0
      890                   and buf_gds-grp-obj.obj-type  = ""
      891                   and buf_gds-grp-obj.obj-code  = 0
      892               no-error .
      893             end.
      894             if v-range = 1 or not available buf_gds-grp-obj
      895             then do:
      896                 assign
      897                     v-exists = no
      898                 .
      899             end.
      900             else do:
      901                 assign
      902                     v-exists = yes
      903                     v-range = 1
      904                 .
      905             end.
      906         end.
      907         else do:
      908             assign
      909                 v-exists = yes
      910                 v-range  = 2
      911             .
      912         end.
      913     end.
      914     else do:
      915         assign
      916             v-exists = yes
      917             v-range  = 3
      918         .
      919     end.
      920     if available buf_gds-grp-obj
      921     then do:
      922       assign
      923       v-cli-type-value    = buf_gds-grp-obj.cli-type
      924       v-cli-code-value    = buf_gds-grp-obj.cli-code
      925       .
      926       assign
      927       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      928                           then yes
      929                           else p-exists-income-cli)
      930       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      931                         then v-range
      932                         else p-range-income-cli
      933       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      934                         then v-cli-type-value
      935                         else p-cli-type
      936       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      937                         then v-cli-code-value
      938                         else p-cli-code
      939       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      940       jj = jj + 1
      941       .
      942     end.
      943     else do:
      944       assign
      945       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      946       jj = jj + 1
      947       .
      948     end.
      949   end.
      950   end.
      951   end procedure.
