     2065                         ,input buf_price-doc-forming.plt-id
     2066                         ,input buf_price-doc-forming.pdf-db
     2067                         ,input buf_price-doc-forming.pdf-id
     2068                         ,input p-line-num
     2069                         ,input old_price-list.b-code
     2070                         ,input buf_goods.artic
     2071                         ,input buf_goods.prod-type
     2072                         ,input buf_goods.prod-code
     2073                         ,input ""
     2074                         ,input 0
     2075                         ,input old_price-list.price-sale
     2076                         ,input ""
     2077                         ,input 0
