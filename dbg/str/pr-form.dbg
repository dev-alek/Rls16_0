     2561   procedure grp-obj-notcorr-value :
     2562   do
     2563   on error undo, return error
     2564   :
     2565   define input parameter p-node-code             as integer      no-undo.
     2566   define input parameter p-obj-type              as character    no-undo.
     2567   define input parameter p-obj-code              as integer      no-undo.
     2568   define output parameter p-notcorr              as character    no-undo init ?.
     2569   define output parameter p-range-notcorr     as integer      no-undo.
     2570   define output parameter p-exists-notcorr    as logical      no-undo.
     2571   define variable v-host-code as integer      no-undo.
     2572   DEFINE VARIABLE v-found as logical no-undo .
     2573   DEFINE VARIABLE v-exists as logical no-undo .
     2574   DEFINE VARIABLE v-range as integer no-undo .
     2575   DEFINE VARIABLE jj as integer no-undo .
     2576   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2577   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2578   define buffer buf_gds-grp for ub.gds-grp.
     2579   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2580   find first buf_gds-grp no-lock where
     2581              buf_gds-grp.node-code = p-node-code no-error .
     2582   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2583     message
     2584       vss-workfile vss-revision vss-description
     2585       skip "Не удалось найти группу товаров с кодом" p-node-code
     2586       view-as alert-box error .
     2587     undo, return error .
     2588   end.
     2589   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2591     (input  p-obj-type
     2592     ,input  p-obj-code
     2593     ,output v-host-code
     2594     ) no-error .
     2595   if error-status :error
     2596   then do:
     2597       message
     2598         vss-workfile vss-revision vss-description
     2599         skip "Не удалось найти фирму объекта"
     2600         skip p-obj-type p-obj-code
     2601         skip return-value
     2602         skip trim(error-status :get-message(1))
     2603       view-as alert-box error.
     2604       undo, return error .
     2605   end.
     2606   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2607   do while v-found = no and jj < 2:
     2608     if v-range <> 3 then do:
     2609       find first buf_gds-grp-obj no-lock
     2610           where buf_gds-grp-obj.node-code = p-node-code
     2611             and buf_gds-grp-obj.host-code = v-host-code
     2612             and buf_gds-grp-obj.obj-type  = p-obj-type
     2613             and buf_gds-grp-obj.obj-code  = p-obj-code
     2614       no-error .
     2615     end.
     2616     if v-range = 3 or not available buf_gds-grp-obj
     2617     then do:
     2618        if v-range <> 2 then do:
     2619           find first buf_gds-grp-obj no-lock
     2620               where buf_gds-grp-obj.node-code = p-node-code
     2621                 and buf_gds-grp-obj.host-code = v-host-code
     2622                 and buf_gds-grp-obj.obj-type  = ""
     2623                 and buf_gds-grp-obj.obj-code  = 0
     2624           no-error .
     2625         end.
     2626         if v-range = 2 or not available buf_gds-grp-obj
     2627         then do:
     2628             if v-range <> 1 then do:
     2629               find first buf_gds-grp-obj no-lock
     2630                   where buf_gds-grp-obj.node-code = p-node-code
     2631                   and buf_gds-grp-obj.host-code = 0
     2632                   and buf_gds-grp-obj.obj-type  = ""
     2633                   and buf_gds-grp-obj.obj-code  = 0
     2634               no-error .
     2635             end.
     2636             if v-range = 1 or not available buf_gds-grp-obj
     2637             then do:
     2638                 assign
     2639                     v-exists = no
     2640                 .
     2641             end.
     2642             else do:
     2643                 assign
     2644                     v-exists = yes
     2645                     v-range = 1
     2646                 .
     2647             end.
     2648         end.
     2649         else do:
     2650             assign
     2651                 v-exists = yes
     2652                 v-range  = 2
     2653             .
     2654         end.
     2655     end.
     2656     else do:
     2657         assign
     2658             v-exists = yes
     2659             v-range  = 3
     2660         .
     2661     end.
     2662     if available buf_gds-grp-obj
     2663     then do:
     2664       find first buf_gds-grp-obj-attr no-lock
     2665         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2666           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2667           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2668           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2669           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2670         no-error .
     2671       if available buf_gds-grp-obj-attr then do:
     2672         assign
     2673           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2674         .
     2675       end.
     2676       else do:
     2677         assign
     2678           v-notcorr-value = ?
     2679         .
     2680       end.
     2681       assign
     2682       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2683                           then yes
     2684                           else p-exists-notcorr)
     2685       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2686                         then v-range
     2687                         else p-range-notcorr
     2688       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2689                         then v-notcorr-value
     2690                         else p-notcorr
     2691       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2692       jj = jj + 1
     2693       .
     2694     end.
     2695     else do:
     2696       assign
     2697       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2698       jj = jj + 1
     2699       .
     2700     end.
     2701   end.
     2702   end.
     2703   end procedure.
     2704   define variable vss-include-info31 as character format "X(65)" no-undo
     2705   initial "@(#)$Workfile$ $Revision$".
     2706   procedure grplib-get-full-name :
     2707      define input parameter p-node-code  as integer      no-undo.
     2708      define output parameter p-full-name as character    no-undo.
     2709      do
     2710   on error undo, return error
     2711   :
     2712       define variable v-upper-code    as integer           no-undo.
     2713       define buffer buf_gds-grp       for ub.gds-grp.
     2714       define buffer buf_upper_gds-grp for ub.gds-grp.
     2715       find first buf_gds-grp no-lock
     2716            where buf_gds-grp.node-code = p-node-code
     2717       no-error.
     2718       if not available buf_gds-grp
     2719       then do:
     2720           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2721       end.
     2722       assign
     2723           p-full-name  = ""
     2724           v-upper-code = 1
     2725       .
     2726       do while buf_gds-grp.upper-code <> 0
     2727       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2728       :
     2729           assign
     2730               p-full-name  = buf_gds-grp.node-name
     2731                            + (if p-full-name <> "" then chr(47) else "")
     2732                            + p-full-name
     2733               v-upper-code = buf_gds-grp.upper-code
     2734           .
     2735           find first buf_gds-grp no-lock
     2736                where buf_gds-grp.node-code = v-upper-code
     2737           no-error.
     2738           if not available buf_gds-grp
     2739           then do:
     2740               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2741                                   + string( v-upper-code )
     2742                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2743           end.
     2744       end.
     2745       assign
     2746       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2747       .
     2748   end.
     2749   end .
     2750   procedure grplib-get-node-from-full-name :
     2751   define input parameter p-full-name as character no-undo .
     2752   define output parameter p-node-code as integer no-undo .
     2753   define variable v-ii as integer no-undo .
     2754   define variable v-upper-code as integer no-undo .
     2755   define variable v-root-code as integer no-undo .
     2756   define variable v-entry as character no-undo .
     2757   define buffer buf_gds-grp       for ub.gds-grp.
     2758   do
     2759   on error undo, return error
     2760   :
     2761     find first buf_gds-grp no-lock
     2762         where buf_gds-grp.upper-code = 0
     2763     no-error .
     2764     if not available buf_gds-grp
     2765     then do:
     2766         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2767     end.
     2768     else do:
     2769       assign
     2770       v-root-code = buf_gds-grp.node-code
     2771       .
     2772     end.
     2773     v-upper-code = v-root-code.
     2774     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2775       assign
     2776       v-entry = entry(v-ii, p-full-name, chr(47)).
     2777       if v-entry = '' then leave.
     2778       find first buf_gds-grp no-lock where
     2779                 buf_gds-grp.node-name = v-entry
     2780             and buf_gds-grp.upper-code = v-upper-code
     2781             no-error.
     2782       if not available buf_gds-grp then do:
     2783         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2784       end.
     2785       else do:
     2786         p-node-code = buf_gds-grp.node-code.
     2787         v-upper-code = buf_gds-grp.node-code.
     2788       end.
     2789     end.
     2790   end.
     2791   end .
     2792   procedure  chec-par :
     2793   define output parameter l-par as logical no-undo .
     2794   define input parameter l-host like ub.clients.obj-code no-undo .
     2795   define input parameter l-type like ub.clients.obj-type no-undo .
     2796   define input parameter l-code like ub.clients.obj-code no-undo .
     2797   define variable par-type          as character no-undo.
     2798   define variable v-value-character as character no-undo .
     2799   define variable v-value-date      as date      no-undo .
     2800   define variable v-value-decimal   as decimal   no-undo .
     2801   define variable v-value-integer   as integer   no-undo .
     2802   define variable v-value-logical   as logical   no-undo .
