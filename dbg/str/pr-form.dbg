     7127   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     7129     (input  v-cntxt-host-code-obj
     7130     ,output b-curr
     7131     )  .
     7132   find  first ub.gds-obj where
     7133            ub.gds-obj.obj-code = ub.price-list.obj-code and
     7134            ub.gds-obj.obj-type = ub.price-list.obj-type and
     7135            ub.gds-obj.gds-code = ub.goods.gds-code
     7136            no-lock no-error.
     7137     if avail ub.gds-obj then
     7138      assign
     7139           loc-gds-obg-last =  if var-pr-r-b = "rubl" then  ub.gds-obj.last-rubl else ub.gds-obj.last-base
     7140           loc-gds-obj-avrg =  if var-pr-r-b = "rubl" then  ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7141           loc-in-code = ub.gds-obj.in-code
     7142           loc-in-date = ub.gds-obj.in-date
     7143        .
     7144     find first p-doc where recid(p-doc) = doc-rec no-lock no-error.
     7145   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7147     (input  ub.price-list.obj-type
     7148     ,input  ub.price-list.obj-code
     7149     ,input  ub.price-list.b-code
     7150     ,input  0
     7151     ,input  ub.price-list.fact-order
     7152     ,output cur-dn
     7153     ,output cur-pr
     7154     ,output cur-rt
     7155     ,output cur-ex
     7156     ) no-error .
     7157        old-price =  cur-pr.
     7158        akt-num = cur-dn.
     7159        if cur-dn <> ? then find first lp-price-doc where lp-price-doc.doc-num = cur-dn no-lock no-error .
     7160        if avail lp-price-doc then
     7161                 akt-date = lp-price-doc.fact-date .
     7162                 else akt-date = ?.
     7163      display
     7164        old-price
     7165        v-dis
     7166        loc-gds-obg-last
     7167        loc-gds-obj-avrg
     7168        loc-in-code
     7169        loc-in-date
     7170        b-curr akt-num akt-date
     7171        ub.price-list.road-tax
     7172        ub.price-list.excise
     7173        with frame Dialog-Frame.
     7174      enable
     7175        old-price
     7176        loc-in-code
     7177        loc-in-date
     7178        v-dis
     7179        loc-gds-obg-last
     7180        loc-gds-obj-avrg
     7181        b-curr akt-num akt-date
     7182        with frame Dialog-Frame.
     7183        run calc-pr in this-procedure .
     7184        run sel-info in this-procedure .
     7185   END PROCEDURE.
     7186   PROCEDURE sel-info :
     7187    do
     7188    on error undo, return error return-value
     7189    :
     7190   define variable par-type as character no-undo .
     7191   define variable p-node-code like ub.goods.grp-code no-undo .
     7192   define variable p-prc-min as decimal no-undo .
     7193   define variable p-prc-max as decimal no-undo .
     7194   define variable p-increase-pc as decimal no-undo .
     7195   define variable p-round-method as character no-undo .
     7196   define variable p-base         as decimal no-undo .
     7197   define variable p-value-margin   as integer no-undo .
     7198   define variable p-type-margin    as logical no-undo .
     7199   define variable p-value-increase   as integer no-undo .
     7200   define variable p-type-increase    as logical no-undo .
     7201   define variable p-value-rmethod   as integer no-undo .
     7202   define variable p-type-rmethod    as logical no-undo .
     7203   define buffer bl_goods for ub.goods.
     7204   define variable l-par as logical   no-undo .
     7205      run chec-par in this-procedure (
     7206            output l-par
     7207           ,input  p-doc.host-code
     7208           ,input  p-doc.obj-type
     7209           ,input  p-doc.obj-code
     7210         ) no-error .
     7211   if trim(par-pr-discm) = "" then return .
     7212       find first bl_goods   where ub.price-list.artic     = bl_goods.artic     and
     7213                                   ub.price-list.prod-code = bl_goods.prod-code and
     7214                                   ub.price-list.prod-type = bl_goods.prod-type no-lock no-error .
     7215                               if error-status :error then return error.
     7216       assign
     7217         p-node-code  = bl_goods.grp-code
     7218       .
     7219       run gds-attr-margin-value in this-procedure
     7220       ( input   bl_goods.gds-code,
     7221         input   p-doc.obj-type ,
     7222         input   p-doc.obj-code ,
     7223         output  p-prc-min  ,
     7224         output  p-prc-max  ,
     7225         output  p-increase-pc,
     7226         output  p-round-method  ,
     7227         output  p-base          ,
     7228         output  p-value-margin    ,
     7229         output  p-type-margin  ,
     7230         output  p-value-increase    ,
     7231         output  p-type-increase ,
     7232         output  p-value-rmethod   ,
     7233         output  p-type-rmethod
     7234                   ) .
     7235       if p-type-margin = false  then return.
     7236        info = "ИНТЕРВАЛ НАЦЕНКИ" .
     7237         case  par-pr-discm :
     7238           when "cost":u then     do: info = info + " от учетной цены " .    end.
     7239           when "cost-vat":u then do: info = info + " от учетной цены без налогов " .       end.
     7240           when "sale":u then     do: info = info + " от продажной цены " .       end.
     7241           when "sale-":u then     do: info = info + " от продажной цены " .       end.
     7242           when "prod":u then     do: info = info + " от цены производителя с НДС" .  end.
     7243           when "prod-vat":u then     do: info = info + " от цены производителя без НДС" .       end.
     7244         end case.
     7245         info = info + " от " + string(p-prc-min) + "% до " + string (p-prc-max) + "% ".
     7246         display info  with frame Dialog-Frame.
     7247     end.
     7248   END PROCEDURE.
     7249   PROCEDURE upd-field :
     7250   define variable ff as logical no-undo .
     7251   define variable ff1 as logical init true no-undo .
     7252   define variable cur-dn as decimal no-undo .
     7253   define variable cur-pr as decimal no-undo .
     7254   define variable cur-rt as decimal no-undo .
     7255   define variable cur-ex as decimal no-undo .
     7256   define variable calc-rec as recid no-undo.
     7257   define buffer buff-goods for ub.goods .
     7258   define buffer p-doc for ub.price-doc.
     7259   define variable calc-method    as char    no-undo.
     7260   define variable increase-pc    as decimal no-undo.
     7261   define variable round-method   as char    no-undo.
     7262   define variable round-base     as decimal no-undo.
     7263     find current ub.price-list.
     7264     find first p-doc where p-doc.doc-num = ub.price-list.doc-num no-lock no-error.
     7265       assign
     7266          calc-method    = ub.price-list.calc-method
     7267          increase-pc    = p-disc
     7268          round-method   = r-m
     7269          round-base     = r-b
     7270          .
     7271     if dec (ub.price-list.price-sale :screen-value in frame Dialog-Frame) <> ub.price-list.price-sale then do:
     7272       assign
     7273         ub.price-list.calc-method = c-m
     7274         ub.price-list.price-calc = ub.price-list.price-sale
     7275         ub.price-list.price-sale = dec (ub.price-list.price-sale :screen-value in frame Dialog-Frame)
     7276         .
     7277       assign
     7278          calc-method    = c-m
     7279          increase-pc    = p-disc
     7280          round-method   = r-m
     7281          round-base     = r-b
     7282          .
     7283           run calc-pr-sub in this-procedure  (input  ub.price-list.b-code,
     7284                             input  p-doc.doc-num,
     7285                             input  calc-method,
     7286                             input  increase-pc,
     7287                             input  round-method,
     7288                             input  round-base,
     7289                             output calc-rec) no-error.
     7290           if error-status :error then
     7291             undo, return error.
     7292     end.
     7293   If dec (ub.price-list.excise :screen-value in frame Dialog-Frame ) <> ub.price-list.excise then do:
     7294       assign
     7295       ub.price-list.excise     = dec (ub.price-list.excise     :screen-value in frame Dialog-Frame)
     7296       .
     7297   End.
     7298   If dec (ub.price-list.road-tax :screen-value in frame Dialog-Frame) <> ub.price-list.road-tax then do:
     7299          Find first buff-goods no-lock where
     7300               buff-goods.artic     = ub.price-list.artic and
     7301               buff-goods.prod-type = ub.price-list.prod-type and
     7302               buff-goods.prod-code = ub.price-list.prod-code
     7303               no-error .
     7304         If avail buff-goods Then DO:
     7305                 IF hvrdtax( recid(buff-goods)) = false  then  DO :
     7306                    message "В товаре нет компонента цены '"   ub.price-list.road-tax:label  "' ,  изменять нельзя ! " .
     7307                 End.
     7308                 Else do:
     7309                     define variable v-chk-act-host-code as integer   no-undo .
     7310   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7312     (input  ub.price-list.obj-code
     7313     ,input  ub.price-list.obj-type
     7314     ,output v-chk-act-host-code
     7315     )  .
     7316   define variable vss-include-info73 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7317   do:
     7318     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7319       (input  v-cntxt-db-num
     7320       ,input  v-cntxt-userid
     7321       ,input  0
     7322       ,input  'actn_overvalue_update':U
     7323       ,input  'object':U
     7324       ,input  v-chk-act-host-code
     7325       ,input  ub.price-list.obj-code
     7326       ,input  ub.price-list.obj-type
     7327       ,input  0
     7328       ,input  0
     7329       ,input  0
     7330       ,input  true
     7331       ,output ff
     7332       )  .
     7333   end.
     7334                       if not ff then do :
     7335                         assign
     7336                           ub.price-list.road-tax   = ub.price-list.road-tax
     7337                         .
     7338                       end.
     7339                       else do :
     7340                         assign
     7341                           ub.price-list.road-tax = dec(ub.price-list.road-tax:screen-value in frame Dialog-Frame)
     7342                         .
     7343                       end.
     7344                 End.
     7345         End.
     7346    end.
     7347    Display ub.price-list.excise ub.price-list.price-sale ub.price-list.road-tax  with frame Dialog-Frame .
     7348   end procedure.
