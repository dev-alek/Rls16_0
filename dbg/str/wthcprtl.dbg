      621   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   procedure minbtn-set :
      623       do
      624           on error undo, return error return-value
      625           :
      626           define variable ii              as integer       no-undo .
      627           define variable fh              as widget-handle no-undo .
      628           define variable hh              as widget-handle no-undo .
      629           define variable v-h             as handle        extent 4 no-undo .
      630           define variable v-name-button   as character     no-undo .
      631           define variable v-help-old-x    as decimal       no-undo .
      632           define variable v-help-old-y    as decimal       no-undo .
      633           define variable v-help-old-size as decimal       no-undo .
      634           define variable v-frame-width   as decimal       no-undo .
      635           define variable jj              as integer       no-undo .
      636           do
      637               on error undo, return error
      638               :
      639               assign
      640                   v-frame-width = frame Dialog-Frame:width - 0.3
      641                   fh            = frame Dialog-Frame:first-child
      642                   hh            = fh:first-child
      643                   ii            = 1
      644                   .
      645               do while valid-handle(hh):
      646                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      647                   do:
      648                       case lc(hh:name) :
      649                           when "b-help" then
      650                               do:
      651                                   hh:load-image-up("cmp/b-help.bmp":u) .
      652                                   hh:load-image-down("cmp/b-help.bmp":u) .
      653                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      654                                   hh:TOOLTIP = "Помощь" .
      655                                   v-help-old-x = hh:column .
      656                                   v-help-old-y = hh:row    .
      657                                   v-help-old-size = hh:width .
      658                                   hh:width-chars = 2.5 .
      659                               end.
      660                           when "b-print" then
      661                               do:
      662                                   hh:load-image("cmp/b-print.bmp":u) .
      663                                   hh:TOOLTIP = "Печать" .
      664                                   v-h[ii] = hh:handle .
      665                                   ii = ii + 1 .
      666                                   hh:width-chars = 3 .
      667                               end.
      668                           when "b-history" or
      669                           when "b-hist" then
      670                               do:
      671                                   hh:load-image("cmp/b-hist.bmp":u) .
      672                                   hh:TOOLTIP = "История" .
      673                                   v-h[ii] = hh:handle .
      674                                   ii = ii + 1 .
      675                                   hh:width-chars = 3 .
      676                               end.
      677                           when "b-sch" then
      678                               do:
      679                                   hh:load-image("cmp/b-sch.bmp":u) .
      680                                   hh:TOOLTIP = "Установка Фильтра" .
      681                                   v-h[ii] = hh:handle .
      682                                   ii = ii + 1 .
      683                                   hh:width-chars = 3 .
      684                               end.
      685                           when "b-hist-user" then
      686                               do:
      687                                   hh:load-image("cmp/b-hist.bmp":u) .
      688                                   hh:TOOLTIP = "История пользователя" .
      689                                   ii = ii + 1 .
      690                               end.
      691                       end case.
      692                   end.
      693                   hh = hh:next-sibling.
      694               end.
      695               b-help:column = v-frame-width - b-help:width-chars.
      696               jj = 0.
      697               repeat ii = 4 to 1 by -1 :
      698                   if valid-handle (v-h[ii] ) then
      699                   do:
      700                       jj  = jj + 1 .
      701                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      702                       v-h[ii]:row    = v-help-old-y .
      703                   end.
      704               end.
      705           end.
      706       end.
      707   end procedure.
      708   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
