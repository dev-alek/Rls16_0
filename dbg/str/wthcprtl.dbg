     1101       if v-curr-sv-date <> ?
     1102       then do:
     1103         run gbl/d-inpday.w
     1104           (input ?
     1105           ,input "Выбор даты"
     1106           ,input v-description
     1107           ,input ""
     1108           ,input-output v-curr-sv-date
     1109           ,output v-ok
     1110           ).
     1111         if v-ok = true
     1112         then do:
     1113           assign
     1114             self :screen-value = string(v-curr-sv-date) .
     1115           .
     1116         end.
     1117       end.
     1118     end.
     1119     return no-apply .
     1120   end.
     1121     define MENU m-ed-date7
     1122       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1123       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1124       MENU-ITEM m-ed-date7-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1125       MENU-ITEM m-ed-date7-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1126       .
     1127     if tt-c-wth-parts.end-dt :POPUP-MENU in frame Dialog-Frame = ?
     1128     then do:
     1129       ASSIGN
     1130         tt-c-wth-parts.end-dt :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date7 :HANDLE
     1131         tt-c-wth-parts.end-dt :MENU-MOUSE in frame Dialog-Frame = 3
     1132       .
     1133     end.
     1134     define variable v-label-handle7 as handle no-undo .
     1135     assign
     1136       v-label-handle7 = tt-c-wth-parts.end-dt :side-label-handle in frame Dialog-Frame
     1137     .
     1138     if valid-handle (v-label-handle7)
     1139     then do:
     1140       if v-label-handle7 :tooltip = ""
     1141       or v-label-handle7 :tooltip = ?
     1142       then do:
     1143         assign
     1144           v-label-handle7 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1145         .
     1146       end.
     1147     end.
     1148     ON CHOOSE OF MENU-ITEM m-ed-date7-1 in menu m-ed-date7 DO:
     1149       apply "ctrl-b":U to tt-c-wth-parts.end-dt in frame Dialog-Frame .
     1150     END.
     1151     ON CHOOSE OF MENU-ITEM m-ed-date7-2 in menu m-ed-date7 DO:
     1152       apply "ctrl-d":U to tt-c-wth-parts.end-dt in frame Dialog-Frame .
     1153     END.
     1154     ON CHOOSE OF MENU-ITEM m-ed-date7-3 in menu m-ed-date7 DO:
     1155       apply "ctrl-e":U to tt-c-wth-parts.end-dt in frame Dialog-Frame .
     1156     END.
     1157     ON CHOOSE OF MENU-ITEM m-ed-date7-4 in menu m-ed-date7 DO:
     1158       apply "ctrl-f":U to tt-c-wth-parts.end-dt in frame Dialog-Frame .
     1159     END.
     1160   MAIN-BLOCK:
     1161   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1162      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1163      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1164     IF par-mode <>  'ПРОСМОТР':U THEN DO:
     1165       MESSAGE
     1166       "Неверное значение параметра par-mode" par-mode
     1167       VIEW-AS ALERT-BOX ERROR.
     1168       UNDO main-block, RETURN ERROR.
     1169     END.
     1170     FIND FIRST LOCKED_c-wth-parts NO-LOCK WHERE
     1171         recid(LOCKED_c-wth-parts) = p-rec
     1172         NO-ERROR.
     1173        IF NOT AVAILABLE LOCKED_c-wth-parts THEN DO:
     1174           MESSAGE
     1175           SUBSTITUTE("Не найдена партия с recid &1", p-rec)
     1176           VIEW-AS ALERT-BOX ERROR.
     1177           UNDO main-block, RETURN ERROR.
     1178        END.
     1179        FIND FIRST LOCKED_wealth NO-LOCK WHERE
     1180                   LOCKED_wealth.wth-code = LOCKED_c-wth-parts.wth-code NO-ERROR.
     1181        IF NOT AVAILABLE LOCKED_wealth THEN DO:
     1182           MESSAGE
     1183           SUBSTITUTE("Не найдена МЦ с кодом &1 ",LOCKED_c-wth-parts.wth-code)
     1184           VIEW-AS ALERT-BOX ERROR.
     1185           UNDO main-block, RETURN ERROR.
     1186       END.
     1187          FIND FIRST LOCKED_wth-par NO-LOCK WHERE
     1188                   LOCKED_wth-par.par-code = LOCKED_c-wth-parts.par-code
     1189              AND  LOCKED_wth-par.wth-code = LOCKED_c-wth-parts.wth-code          NO-ERROR.
     1190       IF NOT AVAILABLE LOCKED_wth-par THEN DO:
     1191           MESSAGE
     1192           SUBSTITUTE("Не найден номинал с кодом &1 для МЦ с кодом &2", LOCKED_c-wth-parts.par-code,  LOCKED_c-wth-parts.wth-code)
     1193           VIEW-AS ALERT-BOX ERROR.
     1194           UNDO main-block, RETURN ERROR.
     1195       END.
     1196          FIND FIRST LOCKED_wth-ser NO-LOCK WHERE
     1197                   LOCKED_wth-ser.ser-code = LOCKED_c-wth-parts.ser-code
     1198              AND  LOCKED_wth-ser.db-num = LOCKED_c-wth-parts.db-num          NO-ERROR.
     1199       IF NOT AVAILABLE LOCKED_wth-ser THEN DO:
     1200           MESSAGE
     1201           SUBSTITUTE("Не найдена серия с кодом &1-&2", LOCKED_c-wth-parts.ser-code,  LOCKED_c-wth-parts.db-num)
     1202           VIEW-AS ALERT-BOX ERROR.
     1203           UNDO main-block, RETURN ERROR.
     1204       END.
     1205       CREATE tt-c-wth-parts.
     1206       BUFFER-COPY LOCKED_c-wth-parts TO tt-c-wth-parts.
     1207   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1208     run mainmenu_getcntxt in parparentproc
     1209       (output v-cntxt-db-num
     1210       ,output v-cntxt-userid
     1211       ,output v-cntxt-level
     1212       ,output v-cntxt-host-code-obj
     1213       ,output v-cntxt-obj-type
     1214       ,output v-cntxt-obj-code
     1215       ,output v-cntxt-db-num-obj
     1216       ,output v-cntxt-is-admin
     1217       ) .
     1218     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     1219     RUN disp-fl.
     1220     WAIT-FOR GO OF FRAME Dialog-Frame.
     1221   END.
     1222   RUN disable_UI.
     1223   PROCEDURE disable_UI :
     1224     HIDE FRAME Dialog-Frame.
     1225   END PROCEDURE.
     1226   PROCEDURE disp-fl :
     1227   DEF VAR v-cash-type-pay AS CHAR no-undo.
     1228   define variable p-plt-id AS INT no-undo.
     1229   define variable  p-plt-db-num   AS INT no-undo.
     1230   define variable  p-pdf-id  AS INT no-undo.
     1231   define variable  p-pdf-db-num AS INT no-undo.
     1232   define variable  p-sale-price-base AS DEC no-undo.
     1233   define variable  p-sale-price-rubl AS DEC no-undo.
     1234   define variable  p-road-tax-base AS DEC no-undo.
     1235   define variable  p-road-tax-rubl AS DEC no-undo.
     1236   define variable  p-excise-base AS DEC no-undo.
     1237   define variable  p-excise-rubl AS DEC no-undo.
     1238   define variable  p-fact-order  AS DEC no-undo.
     1239   DEF BUFFER b-cash-pay FOR ub.cash-pay.
     1240   DEF BUFFER b-clients FOR ub.clients.
     1241       fill-in-6:SCREEN-VALUE IN FRAME Dialog-Frame = "            Серия".
     1242       fill-in-2:SCREEN-VALUE IN FRAME Dialog-Frame = "         Диапазон (факт)".
     1243       fill-in-3:SCREEN-VALUE IN FRAME Dialog-Frame = "        Диапазон (док)".
     1244       fill-in-4:SCREEN-VALUE IN FRAME Dialog-Frame = "        Срок годности".
     1245       fill-in-5:SCREEN-VALUE IN FRAME Dialog-Frame = "           Цена".
     1246     IF AVAILABLE locked_c-wth-parts THEN DO WITH FRAME Dialog-Frame:
     1247         FIND FIRST b-wealth WHERE b-wealth.wth-code = locked_c-wth-parts.wth-code NO-LOCK NO-ERROR.
     1248         IF AVAILABLE b-wealth THEN DISP b-wealth.wth-name @ fl-wth-name.
     1249         ELSE fl-wth-name:SCREEN-VALUE = '?':U.
     1250         FIND FIRST b-wth-par WHERE b-wth-par.wth-code =  locked_c-wth-parts.wth-code AND b-wth-par.par-code = locked_c-wth-parts.par-code NO-LOCK NO-ERROR.
     1251         IF AVAILABLE b-wth-par THEN DISP b-wth-par.par-val @ fl-par-val
     1252                                          b-wth-par.par-rate @ fl-par-rate.
     1253         ELSE do:
     1254             fl-par-val:SCREEN-VALUE = '?':U.
     1255             fl-par-rate:SCREEN-VALUE = '0':U.
     1256         END.
     1257         FIND FIRST b-goods WHERE b-goods.gds-code = locked_c-wth-parts.gds-code NO-LOCK NO-ERROR.
     1258         IF AVAILABLE b-goods THEN do:
     1259                                   DISP b-goods.artic     @ fl-artic
     1260                                        b-goods.prod-type @ fl-prodType
     1261                                        b-goods.prod-code @ fl-prodCode
     1262                                        b-goods.gds-name  @ fl-gds.
     1263           FIND FIRST b-clients WHERE b-clients.obj-type = b-goods.prod-type AND
     1264                b-clients.obj-code = b-goods.prod-code NO-LOCK NO-ERROR.
     1265           IF AVAILABLE b-clients THEN DISP b-clients.obj-name @ fl-obj-name.
     1266         END.
     1267         ELSE   ASSIGN fl-artic:SCREEN-VALUE = '?':U
     1268                fl-prodType:SCREEN-VALUE = '?':U
     1269                fl-prodCode:SCREEN-VALUE = '?':U
     1270                fl-gds:SCREEN-VALUE = '?':U.
     1271         find first locked_wth-ser exclusive-LOCK WHERE
     1272                 locked_wth-ser.ser-code = LOCKED_c-wth-parts.ser-code AND
     1273                 locked_wth-ser.db-num = locked_c-wth-parts.db-num NO-ERROR.
     1274         if available locked_wth-ser THEN
     1275             ASSIGN fl-maska:SCREEN-VALUE = LOCKED_wth-ser.maska.
     1276     END.
     1277   END PROCEDURE.
     1278   PROCEDURE enable_UI :
     1279     OPEN QUERY Dialog-Frame FOR EACH tt-c-wth-parts SHARE-LOCK,       EACH parts WHERE TRUE  SHARE-LOCK.
     1280     GET FIRST Dialog-Frame.
     1281     DISPLAY fl-artic fl-gds fl-prodType fl-ProdCode fl-obj-name fl-wth-name
     1282             fl-par-val fl-par-rate FILL-IN-2 FILL-IN-3 fl-maska FILL-IN-4
     1283             FILL-IN-5 FILL-IN-6
     1284         WITH FRAME Dialog-Frame.
     1285     IF AVAILABLE tt-c-wth-parts THEN
     1286       DISPLAY tt-c-wth-parts.VAT-pc tt-c-wth-parts.wth-code tt-c-wth-parts.par-code
     1287             tt-c-wth-parts.ser-code tt-c-wth-parts.db-num tt-c-wth-parts.fact-rangeFrom
     1288             tt-c-wth-parts.fact-rangeTo tt-c-wth-parts.doc-rangeFrom
     1289             tt-c-wth-parts.doc-rangeTo tt-c-wth-parts.fact-qnty tt-c-wth-parts.qnty-doc
     1290             tt-c-wth-parts.beg-dt tt-c-wth-parts.end-dt tt-c-wth-parts.price-rubl
     1291             tt-c-wth-parts.price-base
     1292         WITH FRAME Dialog-Frame.
     1293     ENABLE b-quit B-Help fl-artic fl-gds fl-prodType fl-ProdCode fl-obj-name
     1294            tt-c-wth-parts.wth-code fl-wth-name tt-c-wth-parts.par-code fl-par-val
     1295            fl-par-rate tt-c-wth-parts.ser-code tt-c-wth-parts.db-num
     1296            tt-c-wth-parts.fact-rangeFrom tt-c-wth-parts.fact-rangeTo
     1297            tt-c-wth-parts.doc-rangeFrom tt-c-wth-parts.doc-rangeTo
     1298            tt-c-wth-parts.fact-qnty tt-c-wth-parts.qnty-doc fl-maska
     1299            tt-c-wth-parts.beg-dt tt-c-wth-parts.end-dt tt-c-wth-parts.price-rubl
     1300            tt-c-wth-parts.price-base RECT-1 RECT-2 RECT-3 RECT-4 RECT-5
     1301         WITH FRAME Dialog-Frame.
     1302     VIEW FRAME Dialog-Frame.
     1303   END PROCEDURE.
     1304   PROCEDURE MyEnable :
     1305   ENABLE
     1306   b-quit
     1307   B-Help
     1308   WITH FRAME Dialog-Frame.
     1309   DISPLAY
     1310      tt-c-wth-parts.VAT-pc tt-c-wth-parts.wth-code tt-c-wth-parts.par-code tt-c-wth-parts.ser-code tt-c-wth-parts.db-num tt-c-wth-parts.fact-rangeFrom tt-c-wth-parts.fact-rangeTo tt-c-wth-parts.doc-rangeFrom tt-c-wth-parts.doc-rangeTo tt-c-wth-parts.fact-qnty tt-c-wth-parts.qnty-doc tt-c-wth-parts.beg-dt tt-c-wth-parts.end-dt tt-c-wth-parts.price-rubl tt-c-wth-parts.price-base
     1311   WITH FRAME Dialog-Frame  .
     1312   if tt-c-wth-parts.stts = 1 then do:
     1313     tt-c-wth-parts.fact-rangeFrom:screen-value = '?'.
     1314     tt-c-wth-parts.fact-rangeTo:screen-value = '?'.
     1315     tt-c-wth-parts.fact-qnty:screen-value = '0'.
     1316   end.
     1317   IF par-mode = 'ПРОСМОТР':U THEN DO:
     1318     ASSIGN
     1319     b-quit:COLUMN = 1
     1320     b-quit:LABEL = "&Выход".
     1321   END.
     1322   VIEW FRAME Dialog-Frame.
     1323   frame Dialog-Frame:title = substitute("&1 &2"
     1324                                        ,frame Dialog-Frame:title
     1325                                        ,par-mode
     1326                                        ).
     1327   END PROCEDURE.
