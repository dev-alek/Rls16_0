     2274                                   ii = ii + 1 .
     2275                               end.
     2276                       end case.
     2277                   end.
     2278                   hh = hh:next-sibling.
     2279               end.
     2280               b-help:column = v-frame-width - b-help:width-chars.
     2281               jj = 0.
     2282               repeat ii = 4 to 1 by -1 :
     2283                   if valid-handle (v-h[ii] ) then
     2284                   do:
     2285                       jj  = jj + 1 .
