      717   procedure placelib_write-attr:
      718   define input  parameter p-code     like ub.place-attr.attr-code .
      719   define input  parameter p-obj-code like ub.place-attr.obj-code .
      720   define input  parameter p-obj-type like ub.place-attr.obj-type .
      721   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      722   define input  parameter p-value    like ub.place-attr.attr-value .
      723   define output parameter p-ok       as logical.
      724   define buffer buf_place-attr for ub.place-attr .
      725     do on error undo, return error return-value :
      726        p-ok = false.
      727        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      728                                                   and buf_place-attr.obj-code    = p-obj-code
      729                                                   and buf_place-attr.obj-type    = p-obj-type
      730                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      731        if not available buf_place-attr then do :
      732           create buf_place-attr.
      733           assign
      734             buf_place-attr.attr-code   = p-code
      735             buf_place-attr.attr-value  = p-value
      736             buf_place-attr.obj-code    = p-obj-code
      737             buf_place-attr.obj-type    = p-obj-type
      738             buf_place-attr.pl-code     = p-pl-code
      739           .
      740           p-ok = true.
      741        end.
      742        else do:
      743           buf_place-attr.attr-value  = p-value .
      744           p-ok = true.
      745        end.
      746     end.
      747   end.
      748   procedure placelib_get-attr:
      749   define input  parameter  p-code     like ub.place-attr.attr-code .
      750   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      751   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      752   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      753   define output parameter  p-value    like ub.place-attr.attr-value .
      754   define output parameter  p-ok       as logical.
      755   define buffer buf_place-attr for ub.place-attr .
      756     do on error undo, return error return-value :
      757        p-ok = false.
      758        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      759                                                   and buf_place-attr.obj-code    = p-obj-code
      760                                                   and buf_place-attr.obj-type    = p-obj-type
      761                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      762        if available buf_place-attr then do :
      763          p-value = buf_place-attr.attr-value.
      764          p-ok = true.
      765        end.
      766        else do :
      767          p-ok = false.
      768        end.
      769     end.
      770   end.
      771   procedure placelib_del-attr:
      772   define input parameter  p-code     like ub.place-attr.attr-code .
      773   define input parameter  p-obj-code like ub.place-attr.obj-code .
      774   define input parameter  p-obj-type like ub.place-attr.obj-type .
      775   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      776   define input parameter  p-value    like ub.place-attr.attr-value .
      777   define output parameter p-ok       as logical.
      778   define buffer buf_place-attr for ub.place-attr .
      779     do on error undo, return error return-value :
      780        p-ok = false.
      781        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      782                                                   and buf_place-attr.obj-code    = p-obj-code
      783                                                   and buf_place-attr.obj-type    = p-obj-type
      784                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      785        if available buf_place-attr then do :
      786           delete buf_place-attr.
      787           p-ok = true.
      788        end.
      789     end.
      790   end.
      791   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      794   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      795   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      796   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      797   define variable ptrlprop-autopump      as logical   no-undo initial false .
      798   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      799   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      800   define variable ptrlprop-olddens       as logical   no-undo initial false .
      801   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      802   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      803   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      804   define variable ptrlprop-algoincome as integer no-undo init 0.
      805   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      806   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      807   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      808   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      809   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      810   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      811   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      812   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      813   define variable ptrlprop-block-nozzle as logical no-undo init false.
      814   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      815   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      816   procedure get-ptrl-prop :
      817     define input  parameter p-obj-type as character no-undo .
      818     define input  parameter p-obj-code as integer   no-undo .
      819     do
      820     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      821     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      822     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      823     :
      824       define variable par-type          as character no-undo.
      825       define variable v-value-character as character no-undo .
      826       define variable v-value-date      as date      no-undo .
      827       define variable v-value-decimal   as decimal   no-undo .
      828       define variable v-value-integer   as integer   no-undo .
      829       define variable v-value-logical   as logical   no-undo .
      830       for each thbjattr_thbj-attr
      831       :
      832         delete thbjattr_thbj-attr .
      833       end.
      834       run adm/shattri.p
      835         ( input "get":U
      836         , input p-obj-type
      837         , input p-obj-code
      838         , input 'petrol':U
      839         , input  ""
      840         , output v-value-character
      841         , output v-value-date
      842         , output v-value-decimal
      843         , output v-value-integer
      844         , output v-value-logical
      845         , output par-type
      846         , input-output table thbjattr_thbj-attr
      847         ) no-error .
      848       for each thbjattr_thbj-attr
      849       on error undo, return error return-value
      850       :
      851         case thbjattr_thbj-attr.prop-code :
      852           when 'denstclc':U then do:
      853             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      854               assign
      855                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      856               .
      857             end.
      858           end.
      859           when 'expptrl':U then do:
      860             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      861               and thbjattr_thbj-attr.prop-value-type = 'character':U
      862             then do:
      863               assign
      864                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      865               .
      866             end.
      867           end.
      868           when 'inpptrl':U then do:
      869             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      870               and thbjattr_thbj-attr.prop-value-type = 'character':U
      871             then do:
      872               assign
      873                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      874               .
      875             end.
      876           end.
      877           when 'autopump':U then do:
      878             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      879               assign
      880                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      881               .
      882             end.
      883           end.
      884           when 'rvsnmter':U then do:
      885             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      886               assign
      887                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      888               .
      889             end.
      890           end.
      891           when 'avtinvpm':U then do:
      892             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      893               assign
      894                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      895               .
      896             end.
      897           end.
      898           when 'invclipt':U then do:
      899             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      900               assign
      901                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      902               .
      903             end.
      904           end.
      905           when 'olddens':U then do:
      906             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      907               assign
      908                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      909               .
      910             end.
      911           end.
      912           when 'algrvspt':U then do:
      913             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      914               assign
      915                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      916               .
      917             end.
      918           end.
      919           when 'temp-for-pomi':U then do:
      920             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      921               assign
      922                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      923               .
      924             end.
      925           end.
      926           when 'algoincome':U then do:
      927             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      928               assign
      929                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      930               .
      931             end.
      932           end.
      933           when 'mand-choice-autocar':U then do:
      934             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      935               assign
      936                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      937               .
      938             end.
      939           end.
      940           when 'block-nozzle':U then do:
      941             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      942               assign
      943                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      944               .
      945             end.
      946           end.
      947           when 'timeout-block-nozzle':U then do:
      948             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      949               assign
      950                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      951               .
      952             end.
      953           end.
      954           when 'Delta-mass-horiz':U then do:
      955             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      956               assign
      957                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      958               .
      959             end.
      960           end.
      961           when 'Delta-mass-vert':U then do:
      962             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      963               assign
      964                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      965               .
      966             end.
      967           end.
      968           when 'calc-free-vol':U then do:
      969             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      970               assign
      971                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      972               .
      973             end.
      974           end.
      975           when 'calc-free-vol-sug':U then do:
      976             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      977               assign
      978                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      979               .
      980             end.
      981           end.
      982           when 'trn-reas-sug':U then do:
      983             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      984               assign
      985                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      986               .
      987             end.
      988           end.
      989                 when 'rvd-own-nb':U then do:
      990             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      991               assign
      992                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      993               .
      994             end.
      995           end.
      996           when 'qr-scan-time':U then do:
      997             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      998               assign
      999                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1000               .
     1001             end.
     1002           end.
     1003           when 'autopump-skip-time':U then do:
     1004             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1005               assign
     1006                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1007               .
     1008             end.
     1009           end.
     1010         end case.
     1011         delete thbjattr_thbj-attr .
     1012       end.
     1013     end.
     1014     return .
     1015   end procedure.
     1016   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   procedure cur-time :
     1018      define output parameter p-today as date      no-undo .
     1019      define output parameter p-time  as integer   no-undo .
     1020     do
     1021     on error undo, return error
     1022     :
     1023       define variable v-date1 as date      no-undo .
     1024       define variable v-date2 as date      no-undo .
     1025       define variable v-time  as integer   no-undo .
     1026       assign
     1027         v-date1 = today
     1028         v-time  = time
     1029         v-date2 = today
     1030       .
     1031       if v-date1 <> v-date2
     1032       then do:
     1033         assign
     1034           v-date1 = today
     1035           v-time  = v-time
     1036         .
     1037       end.
     1038       assign
     1039         p-today = v-date1
     1040         p-time  = v-time
     1041       .
     1042     end.
     1043   end.
     1044   function cur-time-date returns character
     1045   :
     1046     return string(today, '99/99/9999':U) .
     1047   end.
     1048   function cur-time-mjd returns decimal
     1049   :
     1050     define variable v-date as date      no-undo .
     1051     define variable v-time as integer   no-undo .
     1052     run cur-time in this-procedure
     1053       (output v-date
     1054       ,output v-time
     1055       ) .
     1056     return integer(v-date) - 2400002 + (v-time / 86400) .
     1057   end.
     1058   function cur-time-get-ending-index returns integer
     1059   (input p-number as integer
     1060   )
     1061   :
     1062     if p-number < 0
     1063     or p-number = ?
     1064     then do:
     1065       return 1 .
     1066     end.
     1067     define variable v-rest as integer   no-undo .
     1068     assign
     1069       p-number = p-number modulo 100
     1070     .
     1071     if p-number < 20
     1072     then do:
     1073       assign
     1074         v-rest = p-number
     1075       .
     1076     end.
     1077     else do:
     1078       assign
     1079         v-rest = p-number modulo 10
     1080       .
     1081     end.
     1082     case v-rest :
     1083       when 1
     1084       then do:
     1085         return 2 .
     1086       end.
     1087       when 2 or
     1088       when 3 or
     1089       when 4
     1090       then do:
     1091         return 3 .
     1092       end.
     1093       otherwise do:
     1094         return 1 .
     1095       end.
     1096     end case .
     1097   end.
     1098   procedure cur-time-mjd-to-date :
     1099      define input  parameter i-mjd-diff as decimal no-undo.
     1100      define output parameter o-Date     as date    no-undo.
     1101      define output parameter o-Time     as integer no-undo.
     1102      define variable v-day-number as integer   no-undo .
     1103      if    i-mjd-diff < 0
     1104         or i-mjd-diff = ?
     1105      then do:
     1106         return "?" .
     1107      end.
     1108      assign
     1109         v-day-number = truncate(i-mjd-diff,0).
     1110         o-Date = date(v-day-number + 2400002).
     1111         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1112     .
     1113   end.
     1114   function cur-time-mjd-to-string returns character
     1115   (input p-mjd-diff as decimal
     1116   )
     1117   :
     1118     define variable v-day-number as integer   no-undo .
     1119     define variable v-seconds    as integer   no-undo .
     1120     define variable v-hour       as integer   no-undo .
     1121     define variable v-min        as integer   no-undo .
     1122     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1123     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1124     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1125     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1126     if p-mjd-diff < 0
     1127     or p-mjd-diff = ?
     1128     then do:
     1129       return "?" .
     1130     end.
     1131     assign
     1132       v-day-number = integer(truncate(p-mjd-diff,0))
     1133       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1134     .
     1135     if v-seconds > 86400
     1136     then do:
     1137       assign
     1138         v-seconds = 86400 - 1
     1139       .
     1140     end.
     1141     if v-seconds < 0
     1142     then do:
     1143       assign
     1144         v-seconds = 0
     1145       .
     1146     end.
     1147     assign
     1148       v-hour = truncate(v-seconds / 3600, 0)
     1149     .
     1150     assign
     1151       v-seconds = v-seconds modulo 3600
     1152     .
     1153     assign
     1154       v-min = truncate(v-seconds / 60, 0)
     1155     .
     1156     assign
     1157       v-seconds = v-seconds modulo 60
     1158     .
     1159     return
     1160         (if v-day-number <> 0
     1161           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1162           else ""
     1163         )
     1164       + (if v-day-number <> 0 or v-hour <> 0
     1165           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1166           else ""
     1167         )
     1168       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1169           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1170           else ""
     1171         )
     1172       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1173       .
     1174   end.
     1175   function cur-time-string returns character
     1176   :
     1177     define variable v-date as date      no-undo .
     1178     define variable v-time as integer   no-undo .
     1179     run cur-time in this-procedure
     1180       (output v-date
     1181       ,output v-time
     1182       ) .
     1183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1184   end.
     1185   function cur-time-string-sec returns character
     1186   :
     1187     define variable v-date as date      no-undo .
     1188     define variable v-time as integer   no-undo .
     1189     run cur-time in this-procedure
     1190       (output v-date
     1191       ,output v-time
     1192       ) .
     1193     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1194   end.
     1195   function cur-time-custom  returns character
     1196   (input p-prefix as character
     1197   ,input p-date-format as character
     1198   ,input p-delimiter as character
     1199   ,input p-time-format as character
     1200   ,input p-suffix as character
     1201   )
     1202   :
     1203     define variable v-date as date      no-undo .
     1204     define variable v-time as integer   no-undo .
     1205     run cur-time in this-procedure
     1206       (output v-date
     1207       ,output v-time
     1208       ) .
     1209     return
     1210       p-prefix
     1211       + string(v-date, p-date-format)
     1212       + p-delimiter
     1213       + string(v-time, p-time-format)
     1214       + p-suffix
     1215       .
     1216   end.
     1217   function cur-time-print  returns character
     1218   :
     1219     define variable v-date as date      no-undo .
     1220     define variable v-time as integer   no-undo .
     1221     run cur-time in this-procedure
     1222       (output v-date
     1223       ,output v-time
     1224       ) .
     1225     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1226   end.
     1227   function cur-time-datetime returns datetime
     1228   :
     1229     define variable v-char as character no-undo .
     1230     define variable v-datetime as datetime no-undo .
     1231     v-char = cur-time-string().
     1232     v-datetime = datetime(v-char).
     1233     return  v-datetime.
     1234   end.
     1235   function cur-time-string-msec returns character
     1236   :
     1237     define variable v-date as datetime  no-undo .
     1238     v-date = now.
     1239     return string(v-date) .
     1240   end.
