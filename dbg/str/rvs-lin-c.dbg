     1380        tt-rvs-line.state-measure-cli-qnty AT ROW 13.75 COL 73.5 COLON-ALIGNED
     1381             LABEL "Факт вес"
     1382             VIEW-AS FILL-IN
     1383             SIZE 13 BY .88
     1384       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1385            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1386            CANCEL-BUTTON b-cancel.
     1387   DEFINE FRAME Dialog-Frame
     1388        tt-rvs-line.meas-cli-calc-qnty AT ROW 14.75 COL 34 COLON-ALIGNED WIDGET-ID 10
     1389             LABEL "Вес расчит. по измер."
     1390             VIEW-AS FILL-IN
     1391             SIZE 13 BY .88
     1392        tt-rvs-line.brutto-cli-qnty AT ROW 15.75 COL 28.13 COLON-ALIGNED
     1393             LABEL "Измер. брутто вес"
     1394             VIEW-AS FILL-IN
     1395             SIZE 13 BY .88
     1396        tt-rvs-line.state-brutto-cli-qnty AT ROW 15.75 COL 73.5 COLON-ALIGNED
     1397             LABEL "Факт брутто вес"
     1398             VIEW-AS FILL-IN
     1399             SIZE 13 BY .88
     1400        varmeasure-water-cli-qnty AT ROW 16.75 COL 28.13 COLON-ALIGNED
     1401        varstate-water-cli-qnty AT ROW 16.75 COL 73.5 COLON-ALIGNED
     1402        tt-rvs-line.level-petrol AT ROW 17.75 COL 28.13 COLON-ALIGNED
     1403             LABEL "Измер. уровень топлива"
     1404             VIEW-AS FILL-IN
     1405             SIZE 13 BY .88
     1406        tt-rvs-line.state-level-petrol AT ROW 17.75 COL 73.5 COLON-ALIGNED format ">>,>>9.999"
     1407             LABEL "Факт уровень топлива"
     1408             VIEW-AS FILL-IN
     1409             SIZE 13 BY .88
     1410        tt-rvs-line.level-total AT ROW 18.75 COL 28.13 COLON-ALIGNED
     1411             LABEL "Измер. общий уровень"
     1412             VIEW-AS FILL-IN
     1413             SIZE 13 BY .88
     1414        tt-rvs-line.state-level-total AT ROW 18.75 COL 73.5 COLON-ALIGNED format ">>,>>9.999"
     1415             LABEL "Факт общий уровень"
     1416             VIEW-AS FILL-IN
     1417             SIZE 13 BY .88
     1418        tt-rvs-line.level-water AT ROW 19.75 COL 28.13 COLON-ALIGNED
     1419             LABEL "Измер. уровень воды"
     1420             VIEW-AS FILL-IN
     1421             SIZE 13 BY .88
     1422        tt-rvs-line.state-level-water AT ROW 19.75 COL 73.5 COLON-ALIGNED format ">>,>>9.999"
     1423             LABEL "Факт уровень воды"
     1424             VIEW-AS FILL-IN
     1425             SIZE 13 BY .88
     1426        tt-rvs-line.temperature AT ROW 20.75 COL 28.13 COLON-ALIGNED
     1427             VIEW-AS FILL-IN
     1428             SIZE 13 BY .88
     1429        tt-rvs-line.state-temperature AT ROW 20.75 COL 73.5 COLON-ALIGNED
     1430             VIEW-AS FILL-IN
     1431             SIZE 13 BY .88
     1432        tt-rvs-line.temp-layer1 AT ROW 21.75 COL 8.5 COLON-ALIGNED
     1433             LABEL "ИзмT1"
     1434             VIEW-AS FILL-IN
     1435             SIZE 8 BY .88
     1436        tt-rvs-line.temp-layer2 AT ROW 21.75 COL 23.88 COLON-ALIGNED
     1437             LABEL "ИзмT2"
     1438             VIEW-AS FILL-IN
     1439             SIZE 8 BY .88
     1440        tt-rvs-line.temp-layer3 AT ROW 21.75 COL 39.25 COLON-ALIGNED
     1441             LABEL "ИзмT3"
     1442             VIEW-AS FILL-IN
     1443             SIZE 8 BY .88
     1444        tt-rvs-line.state-temp-layer1 AT ROW 21.75 COL 54.5 COLON-ALIGNED
     1445             VIEW-AS FILL-IN
     1446             SIZE 8 BY .88
     1447        tt-rvs-line.state-temp-layer2 AT ROW 21.75 COL 71.63 COLON-ALIGNED
     1448             VIEW-AS FILL-IN
     1449             SIZE 8 BY .88
     1450        tt-rvs-line.state-temp-layer3 AT ROW 21.75 COL 87.13 COLON-ALIGNED
     1451             VIEW-AS FILL-IN
     1452             SIZE 8 BY .88
     1453        tt-rvs-line.meas-mh-qnty AT ROW 22.75 COL 28.13 COLON-ALIGNED
     1454             VIEW-AS FILL-IN
     1455             SIZE 17 BY .88
     1456        tt-rvs-line.state-mh-qnty AT ROW 22.75 COL 73.5 COLON-ALIGNED
     1457             VIEW-AS FILL-IN
     1458             SIZE 17 BY .88
     1459        tt-rvs-line.meas-am-qnty AT ROW 23.75 COL 28.13 COLON-ALIGNED
     1460             VIEW-AS FILL-IN
     1461             SIZE 17 BY .88
     1462       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1463            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1464            CANCEL-BUTTON b-cancel.
     1465   DEFINE FRAME Dialog-Frame
     1466        tt-rvs-line.state-am-qnty AT ROW 23.75 COL 73.5 COLON-ALIGNED
     1467             LABEL "Факт сумма оборота"
     1468             VIEW-AS FILL-IN
     1469             SIZE 17 BY .88
     1470        tt-rvs-line.meas-cf-qnty AT ROW 24.75 COL 29.13 COLON-ALIGNED
     1471             LABEL "Измеренное кол-во наливов"
     1472             VIEW-AS FILL-IN
     1473             SIZE 17 BY .88
     1474        tt-rvs-line.state-cf-qnty AT ROW 24.75 COL 74.5 COLON-ALIGNED
     1475             LABEL "Факт кол-во наливов"
     1476             VIEW-AS FILL-IN
     1477             SIZE 17 BY .88
     1478        mass-float-cov AT ROW 26.5 COL 54 COLON-ALIGNED WIDGET-ID 2
     1479        RECT-2 AT ROW 4.54 COL 50.25
     1480        RECT-3 AT ROW 4.5 COL 2
     1481        SPACE(53.36) SKIP(2.95)
     1482       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1483            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1484            TITLE "Документ сверки"
     1485            CANCEL-BUTTON b-cancel.
     1486   ASSIGN
     1487          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1488          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1489   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1490   DO:
     1491     assign
     1492       v-return-val = "cancel"
     1493     .
     1494     APPLY "END-ERROR":U TO SELF.
     1495   END.
     1496   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     1497   DO:
     1498   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   if lookup(self :type
     1500            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1501            ) = 0
     1502   then do:
     1503     message
     1504       "$Workfile$"
     1505       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1506       "Интерфейсный элемент" self :name  skip
     1507       "Тип" self :type  skip
     1508       "Процедура" this-procedure :file-name skip
     1509       view-as alert-box .
     1510   end.
     1511   else do:
     1512     apply "entry":u to self  .
     1513     if focus :handle <> self :handle  then do:
     1514       return no-apply .
     1515     end.
     1516   end.
     1517     assign
     1518       v-return-val = "cancel"
     1519     .
     1520     APPLY "END-ERROR":U TO SELF.
     1521   END.
     1522   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     1523   DO:
     1524   define variable v-mm as com-handle.
     1525   define variable v-proc as character no-undo.
     1526   define variable v-code            as character no-undo.
     1527   define variable ii                as integer   no-undo.
     1528   define variable place-type        as integer no-undo.
     1529   define variable place-SI          as integer no-undo.
     1530   define variable place-diameter    as decimal no-undo.
     1531   define variable place-ratio-error as decimal no-undo.
     1532   define variable dens-prov         as decimal no-undo format "9.9999999999":U.
     1533   define variable CalibTable        as character no-undo initial "".
     1534   define variable ToolType          as integer no-undo.
     1535   define variable A_LevelMeasurementTool  as decimal no-undo.
     1536   define variable DeltaAbs_H              as decimal no-undo.
     1537   define variable DeltaAbs_H_Water        as decimal no-undo.
     1538   define variable DeltaAbs_R              as decimal no-undo.
     1539   define variable DeltaAbs_Tv             as decimal no-undo.
     1540   define variable DeltaAbs_Tr             as decimal no-undo.
     1541   define variable DeltaOtn_N              as decimal no-undo.
     1542   define variable DeltaOtn_K              as decimal no-undo.
     1543   define variable temp-for-pomi           as integer no-undo.
     1544   define variable error-string            as character no-undo.
     1545   define variable v-is-meas               as logical no-undo.
     1546   define variable v-mm-density            as decimal no-undo.
     1547   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     1548   define buffer buf_place     for ub.place.
     1549     assign frame Dialog-Frame tt-rvs-line.state-level-total   .
     1550     assign frame Dialog-Frame tt-rvs-line.state-level-water   .
     1551     assign frame Dialog-Frame tt-rvs-line.state-temp-layer1   .
     1552     assign frame Dialog-Frame tt-rvs-line.state-temp-layer2   .
     1553     assign frame Dialog-Frame tt-rvs-line.state-temp-layer3   .
     1554     assign frame Dialog-Frame tt-rvs-line.state-temperature   .
     1555     assign frame Dialog-Frame tt-rvs-line.izmer-density       .
     1556     assign frame Dialog-Frame mass-float-cov                  .
     1557     _trpomi :
     1558       do on error undo, return no-apply :
     1559       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     1560         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     1561         run placelib_get-attr  ( input v-code
     1562                                 ,input tt-rvs-line.obj-code
     1563                                 ,input tt-rvs-line.obj-type
     1564                                 ,input tt-rvs-line.pl-code
     1565                                 ,output v-value
     1566                                 ,output v-ok      ) no-error.
     1567         case v-code :
     1568           when "place-type" then do :
     1569             if v-ok then place-type = integer(v-value) .
     1570           end.
     1571           when "place-SI" then do :
     1572             if v-ok then place-si = integer(v-value) .
     1573           end.
     1574           when "place-diameter" then do :
     1575             if v-ok then place-diameter = decimal(v-value) .
     1576           end.
     1577           when "dens-prov" then do :
     1578             if v-ok then dens-prov = decimal(v-value) .
     1579           end.
     1580         end case.
     1581       end.
     1582       for last pl-level no-lock
     1583           where pl-level.pl-code  = tt-rvs-line.pl-code
     1584             and pl-level.obj-code = tt-rvs-line.obj-code
     1585             and pl-level.obj-type = tt-rvs-line.obj-type by pl-level.pl-level
     1586             :
     1587             CalibTable = Substitute("&1=&2","1",(pl-level.pl-qnty / (pl-level.pl-level))) .
     1588       end.
     1589       for each  pl-level no-lock
     1590           where pl-level.pl-code  = tt-rvs-line.pl-code
     1591             and pl-level.obj-code = tt-rvs-line.obj-code
     1592             and pl-level.obj-type = tt-rvs-line.obj-type by pl-level.pl-level
     1593             :
     1594             if CalibTable = "" then CalibTable = Substitute("&1=&2",(pl-level.pl-level ),pl-level.pl-qnty ) .
     1595                               else CalibTable = CalibTable + ";" + Substitute("&1=&2",(pl-level.pl-level ),pl-level.pl-qnty ) .
     1596       end.
     1597       CalibTable = CalibTable + ";" + fill(chr(32),(2048 - length(CalibTable))).
     1598       if place-si  = 0 then do :
     1599         message
     1600           substitute ("Для складского места &1 не заданно средство измерения",tt-rvs-line.pl-code)
     1601         view-as alert-box error.
     1602         undo _trpomi, return no-apply.
     1603       end.
     1604       else do :
     1605         find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     1606         if not available buf_sr-izmerenia then do :
     1607           message
     1608           "Ошибка работы с библиотекой ПО МИ"
     1609           substitute( 'Не найдено средство измерения с кодом &1', place-si ) skip
     1610           view-as alert-box error.
     1611           undo _trpomi, return no-apply.
     1612         end.
     1613         else do :
     1614           assign
     1615             ToolType               = buf_sr-izmerenia.sr-type-id
     1616             A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     1617             DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     1618             DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     1619             DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     1620             DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     1621             DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     1622             DeltaOtn_N             = buf_sr-izmerenia.sr-otnos
     1623             .
     1624         end.
     1625       end.
     1626   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1627   run get-ptrl-prop in this-procedure
     1628     ( input tt-rvs-line.obj-type
     1629     , input tt-rvs-line.obj-code
     1630     ) .
     1631       if not error-status :error then do:
     1632         if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     1633                                       else temp-for-pomi = 20 .
     1634       end.
     1635       find first buf_place no-lock
     1636            where buf_place.obj-code = tt-rvs-line.obj-code
     1637              and buf_place.obj-type = tt-rvs-line.obj-type
     1638              and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     1639       if buf_place.is-meas  = yes then do :
     1640         if place-type = 1 then do :
     1641           v-proc = "Rosneft.MethodOfMetering13" .
     1642           DeltaOtn_K = 0.20 .
     1643         end.
     1644         else do :
     1645           v-proc = "Rosneft.MethodOfMetering6" .
     1646           DeltaOtn_K = 0.25 .
     1647         end.
     1648       end.
     1649       else do :
     1650         if place-type = 1 then do :
     1651           v-proc = "Rosneft.MethodOfMetering12" .
     1652           DeltaOtn_K = 0.20 .
     1653         end.
     1654         else do :
     1655           v-proc = "Rosneft.MethodOfMetering5" .
     1656           DeltaOtn_K = 0.25 .
     1657         end.
     1658       end.
     1659       if tt-rvs-line.izmer-density = ? or tt-rvs-line.izmer-density = 0 then do :
     1660         message
     1661           "Заполнены не все поля, необходимые" skip
     1662           "для работы библиотеки ПО МИ"        skip
     1663           "Введите плотность измер.для ПО МИ"
     1664         view-as alert-box error.
     1665         apply "entry" to tt-rvs-line.izmer-density in frame Dialog-Frame.
     1666         undo _trpomi, return .
     1667       end.
     1668       if tt-rvs-line.state-level-total = ? then do :
     1669         message
     1670           "Заполнены не все поля, необходимые" skip
     1671           "для работы библиотеки ПО МИ"        skip
     1672           "Введите факт. общий уровень"
     1673         view-as alert-box error.
     1674         apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     1675         undo _trpomi, return .
     1676       end.
     1677       if tt-rvs-line.state-level-water = ? then do :
     1678         message
     1679           "Заполнены не все поля, необходимые" skip
     1680           "для работы библиотеки ПО МИ"        skip
     1681           "Введите факт. уровень топлива"
     1682         view-as alert-box error.
     1683         apply "entry" to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     1684         undo _trpomi, return .
     1685       end.
     1686       if tt-rvs-line.state-temp-layer1 = ? then do :
     1687         message
     1688           "Заполнены не все поля, необходимые" skip
     1689           "для работы библиотеки ПО МИ"        skip
     1690           "Введите Т1"
     1691         view-as alert-box error.
     1692         apply "entry" to tt-rvs-line.state-temp-layer1 in frame Dialog-Frame.
     1693         undo _trpomi, return .
     1694       end.
     1695       if tt-rvs-line.state-temp-layer2 = ? then do :
     1696         message
     1697           "Заполнены не все поля, необходимые" skip
     1698           "для работы библиотеки ПО МИ"        skip
     1699           "Введите Т2"
     1700         view-as alert-box error.
     1701         apply "entry" to tt-rvs-line.state-temp-layer2 in frame Dialog-Frame.
     1702         undo _trpomi, return .
     1703       end.
     1704       if tt-rvs-line.state-temp-layer3 = ? then do :
     1705         message
     1706           "Заполнены не все поля, необходимые" skip
     1707           "для работы библиотеки ПО МИ"        skip
     1708           "Введите Т3"
     1709         view-as alert-box error.
     1710         apply "entry" to tt-rvs-line.state-temp-layer3 in frame Dialog-Frame.
     1711         undo _trpomi, return .
     1712       end.
     1713       if tt-rvs-line.state-temperature = ? then do :
     1714         message
     1715           "Заполнены не все поля, необходимые" skip
     1716           "для работы библиотеки ПО МИ"        skip
     1717           "Введите температуру"
     1718         view-as alert-box error.
     1719         apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     1720         undo _trpomi, return .
     1721       end.
     1722       RELEASE OBJECT v-mm NO-ERROR.
     1723       v-mm = ?.
     1724       CREATE value(v-proc) v-mm no-error.
     1725       IF ERROR-STATUS:ERROR
     1726       OR NOT VALID-HANDLE(v-mm)
     1727       THEN DO:
     1728         message
     1729         "Не удается подключиться к COM-серверу библиотеки для работы с ПО МИ "
     1730         view-as alert-box error.
     1731         enable
     1732           tt-rvs-line.state-density
     1733           tt-rvs-line.state-measure-qnty
     1734         with frame Dialog-Frame.
     1735         RELEASE OBJECT v-mm NO-ERROR.
     1736         v-mm = ?.
     1737         undo _trpomi, return no-apply .
     1738       END.
     1739       ELSE DO :
     1740         ASSIGN
     1741           v-mm:H                      = integer( tt-rvs-line.state-level-total) * 10
     1742           v-mm:H_water                = integer( tt-rvs-line.state-level-water) * 10
     1743           v-mm:CalibrationTable       = CalibTable
     1744           v-mm:Tr                     = tt-rvs-line.state-temperature
     1745           v-mm:R                      = ( tt-rvs-line.izmer-density * 1000 )
     1746           v-mm:Tcy                    = temp-for-pomi
     1747           v-mm:ToolType               = ToolType
     1748           v-mm:DeltaOtn_K             = DeltaOtn_K
     1749           v-mm:A_Reservoir            = 0.0000125
     1750           v-mm:DeltaAbs_H             = DeltaAbs_H
     1751           v-mm:DeltaAbs_H_Water       = DeltaAbs_H_Water
     1752           v-mm:DeltaAbs_R             = DeltaAbs_R
     1753           v-mm:DeltaAbs_Tv            = DeltaAbs_Tv
     1754           v-mm:DeltaAbs_Tr            = DeltaAbs_Tr
     1755           v-mm:DeltaOtn_N             = DeltaOtn_N
     1756         .
     1757         output stream outstream to value ("pomi.log")  append.
     1758         put stream outstream
     1759                                         cur-time-string()                  format "x(16)"  skip
     1760             'Процедура                ' v-proc                             format "x(128)" skip
     1761             'H                      = ' ( tt-rvs-line.state-level-total * 10 )             skip
     1762             'H_water                = ' ( tt-rvs-line.state-level-water * 10 )             skip
     1763             'CalibrationTable       = ' CalibTable                        format "x(2048)" skip
     1764             'Tr                     = ' tt-rvs-line.state-temperature                      skip
     1765             'R                      = ' ( tt-rvs-line.izmer-density * 1000 )               skip
     1766             'Tcy                    = ' temp-for-pomi                                      skip
     1767             'ToolType               = ' ToolType                                           skip
     1768             'DeltaOtn_K             = ' DeltaOtn_K                                         skip
     1769             'A_Reservoir            = ' 0.0000125                                          skip
     1770             'DeltaAbs_H             = ' DeltaAbs_H                                         skip
     1771             'DeltaAbs_H_Water       = ' DeltaAbs_H_Water                                   skip
     1772             'DeltaAbs_R             = ' DeltaAbs_R                                         skip
     1773             'DeltaAbs_Tv            = ' DeltaAbs_Tv                                        skip
     1774             'DeltaAbs_Tr            = ' DeltaAbs_Tr                                        skip
     1775             'DeltaOtn_N             = ' DeltaOtn_N                                         skip
     1776         .
     1777         if place-type = 1 then do :
     1778           v-mm:Rprov = ( dens-prov * 1000 ) .
     1779           v-mm:Mpokr = mass-float-cov .
     1780           put stream outstream
     1781             "v-mm:Rprov             = " ( dens-prov * 1000 ) skip
     1782             "v-mm:Mpokr             = " mass-float-cov skip
     1783           .
     1784         end.
     1785         find first buf_place no-lock
     1786             where buf_place.obj-code = tt-rvs-line.obj-code
     1787               and buf_place.obj-type = tt-rvs-line.obj-type
     1788               and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     1789         if buf_place.is-meas  = yes then do :
     1790            v-mm:Tv = tt-rvs-line.state-temperature .
     1791         end.
     1792         else do :
     1793           if place-type <> 1 then do :
     1794             v-mm:D = place-diameter .
     1795             put stream outstream
     1796               "v-mm:D                      = " place-diameter                skip
     1797             .
     1798           end.
     1799           assign
     1800             v-mm:T_lower                = tt-rvs-line.state-temp-layer1
     1801             v-mm:T_middle               = tt-rvs-line.state-temp-layer2
     1802             v-mm:T_upper                = tt-rvs-line.state-temp-layer3
     1803             v-mm:A_LevelMeasurementTool = A_LevelMeasurementTool
     1804           .
     1805           put stream outstream
     1806             "v-mm:T_lower                = " tt-rvs-line.state-temp-layer1 skip
     1807             "v-mm:T_middle               = " tt-rvs-line.state-temp-layer2 skip
     1808             "v-mm:T_upper                = " tt-rvs-line.state-temp-layer3 skip
     1809             "v-mm:A_LevelMeasurementTool = " A_LevelMeasurementTool        skip
     1810           .
     1811         end.
     1812         output stream outstream close.
     1813         v-mm:Exec() .
     1814         if v-mm:Result <> 0 then do :
     1815           error-string = v-mm:ResultDetail .
     1816           output stream outstream to value ("pomi.log")  append.
     1817           put stream outstream error-string format "X(1024)" skip.
     1818           message
     1819           substitute('Ошибка работы библиотеки ПО МИ. &1',error-string)
     1820           view-as alert-box error.
     1821           RELEASE OBJECT v-mm NO-ERROR.
     1822           v-mm = ?.
     1823           output stream outstream close.
     1824           undo _trpomi, return no-apply .
     1825         end.
     1826         else do :
     1827           v-mm-density = decimal(v-mm:Rcy) / 1000 .
     1828           assign
     1829             tt-rvs-line.state-measure-qnty     = v-mm:Vcy
     1830             tt-rvs-line.state-density          = v-mm-density
     1831             tt-rvs-line.state-measure-cli-qnty = tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density
     1832           .
     1833           display
     1834             tt-rvs-line.state-measure-qnty
     1835             tt-rvs-line.state-density
     1836             tt-rvs-line.state-measure-cli-qnty
     1837            with frame Dialog-Frame .
     1838           output stream outstream to value ("pomi.log")  append.
     1839           put stream outstream
     1840           "v-mm:Vcy"  tt-rvs-line.state-measure-qnty     skip
     1841           "v-mm:Rcy"  tt-rvs-line.state-density          skip .
     1842           output stream outstream close.
     1843           run volume-water no-error.
     1844           if error-status :error then do :
     1845                                    enable
     1846                                      tt-rvs-line.state-density
     1847                                      tt-rvs-line.state-measure-qnty
     1848                                      tt-rvs-line.state-add-qnty
     1849                                      tt-rvs-line.state-brutto-qnty
     1850                                      tt-rvs-line.state-brutto-cli-qnty
     1851                                    with frame Dialog-Frame.
     1852                                    undo _trpomi, return .
     1853                                  end.
     1854           run chg-density no-error.
     1855           if error-status :error then do :
     1856                                    enable
     1857                                      tt-rvs-line.state-density
     1858                                      tt-rvs-line.state-measure-qnty
     1859                                      tt-rvs-line.state-add-qnty
     1860                                      tt-rvs-line.state-brutto-qnty
     1861                                      tt-rvs-line.state-brutto-cli-qnty
     1862                                    with frame Dialog-Frame.
     1863                                    undo _trpomi, return .
     1864                                  end.
     1865           run weath-water no-error.
     1866           if error-status:error then do :
     1867                                   enable
     1868                                     tt-rvs-line.state-density
     1869                                     tt-rvs-line.state-measure-qnty
     1870                                     tt-rvs-line.state-add-qnty
     1871                                     tt-rvs-line.state-brutto-qnty
     1872                                     tt-rvs-line.state-brutto-cli-qnty
     1873                                   with frame Dialog-Frame.
     1874                                   undo _trpomi, return .
     1875                                 end.
     1876         end.
     1877       END.
     1878     end.
     1879     enable
     1880       tt-rvs-line.state-density
     1881       tt-rvs-line.state-measure-qnty
     1882       tt-rvs-line.state-add-qnty
     1883       tt-rvs-line.state-brutto-qnty
     1884       tt-rvs-line.state-brutto-cli-qnty
     1885     with frame Dialog-Frame.
     1886   END.
     1887   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1888   DO:
     1889     define variable v-water     as decimal   no-undo .
     1890     define variable v-water-cli as decimal   no-undo .
     1891   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   if lookup(self :type
     1893            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1894            ) = 0
     1895   then do:
     1896     message
     1897       "$Workfile$"
     1898       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1899       "Интерфейсный элемент" self :name  skip
     1900       "Тип" self :type  skip
     1901       "Процедура" this-procedure :file-name skip
     1902       view-as alert-box .
     1903   end.
     1904   else do:
     1905     apply "entry":u to self  .
     1906     if focus :handle <> self :handle  then do:
     1907       return no-apply .
     1908     end.
     1909   end.
     1910     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty >
     1911        input frame Dialog-Frame tt-rvs-line.state-brutto-qnty  then do:
     1912        message "Объем топлива больше общего объема."
     1913        view-as alert-box error.
     1914        apply "entry" to tt-rvs-line.state-measure-qnty in frame Dialog-Frame.
     1915        return no-apply.
     1916     end.
     1917     assign
     1918       v-water     = input frame Dialog-Frame tt-rvs-line.state-brutto-qnty - input frame Dialog-Frame tt-rvs-line.state-measure-qnty
     1919       v-water-cli = input frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty - input frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty
     1920     .
     1921     if ( v-water <> ?
     1922          and v-water <> 0
     1923          and ( v-water-cli = ?
     1924                or v-water-cli = 0
     1925              )
     1926        )
     1927        or
     1928        ( v-water-cli <> ?
     1929          and v-water-cli <> 0
     1930          and ( v-water = ?
     1931                or v-water = 0
     1932              )
     1933        )
     1934     then do:
     1935        message
     1936          substitute( "Объем воды (&1) не соответствует его весу (&2)!", v-water, v-water-cli )
     1937          view-as alert-box error.
     1938        return no-apply.
     1939     end.
     1940     find first c-rvs-line where recid(c-rvs-line) =  p-code-rec-line no-error.
     1941     run level-water  in this-procedure ( input yes ) no-error.
     1942     if error-status :error then do:
     1943       apply "ENTRY":U to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     1944       return no-apply.
     1945     end.
     1946     run volume-water in this-procedure               no-error.
     1947     if error-status :error then do: return no-apply. end.
     1948     run chg-density  in this-procedure               no-error.
     1949     if error-status :error then do: return no-apply. end.
     1950     run weath-water  in this-procedure               no-error.
     1951     if error-status :error then do: return no-apply. end.
     1952     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty tt-rvs-line.state-add-qnty tt-rvs-line.state-brutto-tc-qnty tt-rvs-line.state-temperature tt-rvs-line.state-temp-layer1 tt-rvs-line.state-temp-layer2 tt-rvs-line.state-temp-layer3.
     1953     buffer-copy tt-rvs-line to c-rvs-line.
     1954     find first rvs-line-attr exclusive-lock
     1955          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     1956            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     1957            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     1958            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     1959            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     1960            and rvs-line-attr.attr-code = "izmer-density" no-error.
     1961     if not available rvs-line-attr then do :
     1962       create rvs-line-attr.
     1963       assign
     1964         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     1965         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     1966         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     1967         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     1968         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     1969         rvs-line-attr.attr-code = "izmer-density"
     1970         rvs-line-attr.attr-value = string(tt-rvs-line.izmer-density)
     1971       .
     1972     end.
     1973     else do :
     1974       rvs-line-attr.attr-value = string(tt-rvs-line.izmer-density) .
     1975     end.
     1976     find first rvs-line-attr exclusive-lock
     1977          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     1978            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     1979            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     1980            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     1981            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     1982            and rvs-line-attr.attr-code = "mass-float-cov" no-error.
     1983     if not available rvs-line-attr then do :
     1984       create rvs-line-attr.
     1985       assign
     1986         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     1987         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     1988         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     1989         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     1990         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     1991         rvs-line-attr.attr-code = "mass-float-cov"
     1992         rvs-line-attr.attr-value = string(mass-float-cov) .
     1993       .
     1994     end.
     1995     else do :
     1996       rvs-line-attr.attr-value = string(mass-float-cov) .
     1997     end.
     1998   END.
     1999   ON LEAVE OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     2000   DO:
     2001     assign frame Dialog-Frame tt-rvs-line.state-add-qnty.
     2002   END.
     2003   ON return OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     2004   DO:
     2005     apply "entry" to tt-rvs-line.state-brutto-qnty in frame Dialog-Frame.
     2006     return no-apply.
     2007   END.
     2008   ON LEAVE OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     2009   DO:
