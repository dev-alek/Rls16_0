     2011     run weath-water no-error.
     2012     if error-status:error then return no-apply.
     2013   end.
     2014   END.
     2015   ON return OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     2016   DO:
     2017     apply "entry" to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     2018     return no-apply.
     2019   END.
     2020   ON LEAVE OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     2021   DO:
     2022   if input frame Dialog-Frame tt-rvs-line.state-brutto-qnty <> tt-rvs-line.state-brutto-qnty then do:
     2023     run volume-water no-error.
     2024     if error-status:error then return no-apply.
     2025   end.
     2026   END.
     2027   ON return OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     2028   DO:
     2029     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     2030     return no-apply.
     2031   END.
     2032   ON LEAVE OF tt-rvs-line.state-brutto-tc-qnty IN FRAME Dialog-Frame
     2033   DO:
     2034     assign frame Dialog-Frame tt-rvs-line.state-brutto-tc-qnty.
     2035   END.
     2036   ON return OF tt-rvs-line.state-brutto-tc-qnty IN FRAME Dialog-Frame
     2037   DO:
     2038     apply "entry" to tt-rvs-line.state-brutto-cli-qnty in frame Dialog-Frame.
     2039     return no-apply.
     2040   END.
     2041   ON LEAVE OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     2042   DO:
     2043     if input frame Dialog-Frame tt-rvs-line.state-density <> tt-rvs-line.state-density then do:
     2044        run chg-density no-error.
     2045        if error-status:error then return no-apply.
     2046        run weath-water no-error.
     2047        if error-status:error then return no-apply.
     2048     end.
     2049   END.
     2050   ON return OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     2051   DO:
     2052     apply "entry" to tt-rvs-line.state-add-qnty in frame Dialog-Frame.
     2053     return no-apply.
     2054   END.
     2055   ON LEAVE OF tt-rvs-line.izmer-density IN FRAME Dialog-Frame
     2056   DO:
     2057     if input frame Dialog-Frame tt-rvs-line.izmer-density <> tt-rvs-line.izmer-density then do:
     2058       if input frame Dialog-Frame tt-rvs-line.izmer-density = ?
     2059         or ( buf_goods.unit-base <> buf_goods.unit-cli
     2060             and ( input frame Dialog-Frame tt-rvs-line.izmer-density <= 0
     2061                   or input frame Dialog-Frame tt-rvs-line.izmer-density >= 1
     2062                 )
     2063           )
     2064         or ( buf_goods.unit-base = buf_goods.unit-cli
     2065             and input frame Dialog-Frame tt-rvs-line.izmer-density <> 1
     2066           )
     2067       then do:
     2068         message "Неверно определена плотность топлива измер. для ПО МИ." view-as alert-box error.
     2069         apply "entry" to tt-rvs-line.izmer-density .
     2070         return no-apply.
     2071       end.
     2072       assign frame Dialog-Frame tt-rvs-line.izmer-density.
     2073     end.
     2074   END.
     2075   ON RETURN OF tt-rvs-line.izmer-density IN FRAME Dialog-Frame
     2076   DO:
     2077     apply "entry" to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     2078     return no-apply.
     2079   END.
     2080   ON LEAVE OF tt-rvs-line.state-level-petrol IN FRAME Dialog-Frame
     2081   DO:
     2082     if input frame Dialog-Frame tt-rvs-line.state-level-petrol <> tt-rvs-line.state-level-petrol then do:
     2083       RUN local-tarir ("state-level-petrol").
     2084       run level-water in this-procedure ( input no )  .
     2085     end.
     2086   END.
     2087   ON return OF tt-rvs-line.state-level-petrol IN FRAME Dialog-Frame
     2088   DO:
     2089     apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     2090     return no-apply.
     2091   END.
     2092   ON LEAVE OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     2093   DO:
     2094     if input frame Dialog-Frame tt-rvs-line.state-level-total <> tt-rvs-line.state-level-total then do:
     2095       RUN local-tarir ("state-level-total").
     2096       run level-water in this-procedure ( input no )  .
     2097     end.
     2098   END.
     2099   ON return OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     2100   DO:
     2101     apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     2102     return no-apply.
     2103   END.
     2104   ON return OF tt-rvs-line.state-measure-cli-qnty IN FRAME Dialog-Frame
     2105   DO:
     2106     apply "entry" to tt-rvs-line.state-brutto-cli-qnty in frame Dialog-Frame.
     2107     return no-apply.
     2108   END.
     2109   ON LEAVE OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     2110   DO:
     2111     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> tt-rvs-line.state-measure-qnty then do:
     2112        run volume-water no-error.
     2113        if error-status:error then return no-apply.
     2114        if tt-rvs-line.state-density <> 0 and
     2115           tt-rvs-line.state-density <> ? then do:
     2116           run chg-density no-error.
     2117           if error-status:error then return no-apply.
     2118           run weath-water no-error.
     2119           if error-status:error then return no-apply.
     2120        end.
     2121     end.
     2122   END.
     2123   ON return OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     2124   DO:
     2125     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     2126     return no-apply.
     2127   END.
     2128   ON LEAVE OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     2129   DO:
     2130     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty.
     2131   END.
     2132   ON return OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     2133   DO:
     2134     apply "entry" to tt-rvs-line.state-density in frame Dialog-Frame.
     2135     return no-apply.
     2136   END.
     2137   ON LEAVE OF tt-rvs-line.state-temp-layer1 IN FRAME Dialog-Frame
     2138   DO:
     2139       assign frame Dialog-Frame tt-rvs-line.state-temp-layer1.
     2140   END.
     2141   ON return OF tt-rvs-line.state-temp-layer1 IN FRAME Dialog-Frame
     2142   DO:
     2143     apply "entry" to tt-rvs-line.state-temp-layer2 in frame Dialog-Frame.
     2144     return no-apply.
     2145   END.
     2146   ON LEAVE OF tt-rvs-line.state-temp-layer2 IN FRAME Dialog-Frame
     2147   DO:
     2148       assign frame Dialog-Frame tt-rvs-line.state-temp-layer2.
     2149   END.
     2150   ON return OF tt-rvs-line.state-temp-layer2 IN FRAME Dialog-Frame
     2151   DO:
     2152     apply "entry" to tt-rvs-line.state-temp-layer3 in frame Dialog-Frame.
     2153     return no-apply.
     2154   END.
     2155   ON LEAVE OF tt-rvs-line.state-temp-layer3 IN FRAME Dialog-Frame
     2156   DO:
     2157       assign frame Dialog-Frame tt-rvs-line.state-temp-layer3.
     2158   END.
     2159   ON return OF tt-rvs-line.state-temp-layer3 IN FRAME Dialog-Frame
     2160   DO:
     2161     if pomi-licvalue  = "yes" then do:
     2162       apply "entry" to mass-float-cov in frame Dialog-Frame.
     2163       return no-apply.
     2164     end.
     2165     else do :
     2166       apply "entry" to b-save in frame Dialog-Frame.
     2167       return no-apply.
     2168     end.
     2169   END.
     2170   ON return OF mass-float-cov IN FRAME Dialog-Frame
     2171   DO:
     2172     apply "entry" to b-calc in frame Dialog-Frame.
     2173     return no-apply.
     2174   END.
     2175   ON LEAVE OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     2176   DO:
     2177       assign frame Dialog-Frame tt-rvs-line.state-temperature.
     2178   END.
     2179   ON return OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     2180   DO:
     2181     apply "entry" to tt-rvs-line.state-temp-layer1 in frame Dialog-Frame.
     2182     return no-apply.
     2183   END.
     2184   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2185   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2186   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2187   on help of frame Dialog-Frame
     2188   do:
     2189     run gbl/app_help.p
     2190       (input this-procedure :file-name
     2191       ,input ''
     2192       ,input ?
     2193       ) no-error.
     2194     if error-status :error then do:
     2195       message
     2196         "Ошибка при вызове помощи"
     2197         error-status :get-message(1)
     2198         view-as alert-box .
     2199     end.
     2200   end.
     2201   run minbtn-set in this-procedure .
     2202   on choose of b-help in frame Dialog-Frame
     2203   do:
     2204     apply "help":u to frame Dialog-Frame .
     2205   end.
     2206   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2207   procedure minbtn-set :
     2208       do
     2209           on error undo, return error return-value
     2210           :
     2211           define variable ii              as integer       no-undo .
     2212           define variable fh              as widget-handle no-undo .
     2213           define variable hh              as widget-handle no-undo .
     2214           define variable v-h             as handle        extent 4 no-undo .
     2215           define variable v-name-button   as character     no-undo .
     2216           define variable v-help-old-x    as decimal       no-undo .
     2217           define variable v-help-old-y    as decimal       no-undo .
     2218           define variable v-help-old-size as decimal       no-undo .
     2219           define variable v-frame-width   as decimal       no-undo .
     2220           define variable jj              as integer       no-undo .
     2221           do
     2222               on error undo, return error
     2223               :
     2224               assign
     2225                   v-frame-width = frame Dialog-Frame:width - 0.3
     2226                   fh            = frame Dialog-Frame:first-child
     2227                   hh            = fh:first-child
     2228                   ii            = 1
     2229                   .
     2230               do while valid-handle(hh):
     2231                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2232                   do:
     2233                       case lc(hh:name) :
     2234                           when "b-help" then
     2235                               do:
     2236                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2237                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2238                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2239                                   hh:TOOLTIP = "Помощь" .
     2240                                   v-help-old-x = hh:column .
     2241                                   v-help-old-y = hh:row    .
     2242                                   v-help-old-size = hh:width .
     2243                                   hh:width-chars = 2.5 .
     2244                               end.
     2245                           when "b-print" then
     2246                               do:
     2247                                   hh:load-image("cmp/b-print.bmp":u) .
     2248                                   hh:TOOLTIP = "Печать" .
     2249                                   v-h[ii] = hh:handle .
     2250                                   ii = ii + 1 .
     2251                                   hh:width-chars = 3 .
     2252                               end.
     2253                           when "b-history" or
     2254                           when "b-hist" then
     2255                               do:
     2256                                   hh:load-image("cmp/b-hist.bmp":u) .
     2257                                   hh:TOOLTIP = "История" .
