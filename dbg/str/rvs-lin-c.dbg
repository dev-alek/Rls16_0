     2590     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     2591        disable tt-rvs-line.izmer-density with frame Dialog-Frame.
     2592        disable mass-float-cov with frame Dialog-Frame.
     2593        disable b-calc with frame Dialog-Frame.
     2594     end.
     2595     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode
     2596                                       + " - " +  partitle.
     2597     WAIT-FOR GO OF FRAME Dialog-Frame.
     2598   END.
     2599   RUN disable_UI.
     2600   return v-return-val .
     2601   PROCEDURE chg-density :
     2602   if input frame Dialog-Frame tt-rvs-line.state-density = ?
     2603     or ( buf_goods.unit-base <> buf_goods.unit-cli
     2604          and ( input frame Dialog-Frame tt-rvs-line.state-density <= 0
     2605                or input frame Dialog-Frame tt-rvs-line.state-density >= 1
     2606              )
     2607        )
     2608     or ( buf_goods.unit-base = buf_goods.unit-cli
     2609          and input frame Dialog-Frame tt-rvs-line.state-density <> 1
     2610        )
     2611   then do:
     2612      message "Неверно определена плотность топлива." view-as alert-box error.
     2613      return error.
     2614   end.
     2615   run gds-attr-value in this-procedure
     2616     ( input  buf_goods.gds-code
     2617     ,input  'gds-ptrl-densities':U
     2618     ,output v-gds-ptrl-densities
     2619     ,output v-attr-type
     2620     ) .
     2621     if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     2622       assign
     2623         v-min-dens = decimal(replace(entry(1, v-gds-ptrl-densities, "-":U ), "кг\л", "":U))
     2624         v-max-dens = decimal(replace(entry(2, v-gds-ptrl-densities, "-":U ), "кг\л":U, "":U))
     2625       no-error .
     2626       if (input frame Dialog-Frame tt-rvs-line.state-density) < v-min-dens
     2627       or (input frame Dialog-Frame tt-rvs-line.state-density) > v-max-dens
     2628       then do:
     2629         message
     2630           substitute("Введенное значение плотности находится вне заданного диапазона: &1.",
     2631           v-gds-ptrl-densities )
     2632           view-as alert-box error .
     2633         return error.
     2634       end.
     2635     end.
     2636   assign frame Dialog-Frame tt-rvs-line.state-density.
     2637   assign
     2638     tt-rvs-line.state-measure-cli-qnty = tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density
     2639   .
     2640   display tt-rvs-line.state-measure-cli-qnty with frame Dialog-Frame.
     2641   if tt-rvs-line.state-measure-cli-qnty > tt-rvs-line.state-brutto-cli-qnty then do:
     2642     message "Измеренный вес больше веса брутто. Подставить измеренный вес в вес брутто?"
     2643     view-as alert-box question buttons yes-no update varlog.
     2644     if varlog = yes then do:
     2645       assign
     2646         tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty.
     2647       display tt-rvs-line.state-brutto-cli-qnty with frame Dialog-Frame.
     2648     end.
     2649   end.
     2650   END PROCEDURE.
     2651   PROCEDURE disable_UI :
     2652     HIDE FRAME Dialog-Frame.
     2653   END PROCEDURE.
     2654   PROCEDURE enable_UI :
     2655     OPEN QUERY Dialog-Frame FOR EACH tt-rvs-line SHARE-LOCK.
     2656     GET FIRST Dialog-Frame.
     2657     DISPLAY varmeasure-water-qnty varstate-water-qnty varmeasure-water-cli-qnty
     2658             varstate-water-cli-qnty mass-float-cov
     2659         WITH FRAME Dialog-Frame.
     2660     IF AVAILABLE tt-rvs-line THEN
     2661       DISPLAY tt-rvs-line.system-qnty tt-rvs-line.system-cli-qnty
     2662             tt-rvs-line.orig-system-qnty tt-rvs-line.orig-system-cli-qnty
     2663             tt-rvs-line.measure-qnty tt-rvs-line.state-measure-qnty
     2664             tt-rvs-line.meas-calc-qnty tt-rvs-line.measure-tc-qnty tt-rvs-line.state-measure-tc-qnty
     2665             tt-rvs-line.density tt-rvs-line.state-density
     2666             tt-rvs-line.meas-calc-dens tt-rvs-line.izmer-density
     2667             tt-rvs-line.add-qnty tt-rvs-line.state-add-qnty
     2668             tt-rvs-line.brutto-qnty tt-rvs-line.state-brutto-qnty
     2669             tt-rvs-line.brutto-tc-qnty tt-rvs-line.state-brutto-tc-qnty
     2670             tt-rvs-line.measure-cli-qnty tt-rvs-line.state-measure-cli-qnty
     2671             tt-rvs-line.meas-cli-calc-qnty
     2672             tt-rvs-line.brutto-cli-qnty tt-rvs-line.state-brutto-cli-qnty
     2673             tt-rvs-line.level-petrol tt-rvs-line.state-level-petrol
     2674             tt-rvs-line.level-total tt-rvs-line.state-level-total
     2675             tt-rvs-line.level-water tt-rvs-line.state-level-water
     2676             tt-rvs-line.temperature tt-rvs-line.state-temperature
     2677             tt-rvs-line.temp-layer1 tt-rvs-line.temp-layer2
     2678             tt-rvs-line.temp-layer3 tt-rvs-line.state-temp-layer1
     2679             tt-rvs-line.state-temp-layer2 tt-rvs-line.state-temp-layer3
     2680             tt-rvs-line.meas-mh-qnty tt-rvs-line.state-mh-qnty
     2681             tt-rvs-line.meas-am-qnty tt-rvs-line.state-am-qnty
     2682             tt-rvs-line.meas-cf-qnty tt-rvs-line.state-cf-qnty
     2683         WITH FRAME Dialog-Frame.
     2684     ENABLE b-save b-cancel b-help RECT-2 RECT-3 tt-rvs-line.state-measure-qnty
     2685            tt-rvs-line.state-density b-calc tt-rvs-line.state-add-qnty
     2686            tt-rvs-line.state-brutto-qnty tt-rvs-line.state-brutto-cli-qnty
     2687            tt-rvs-line.state-level-petrol tt-rvs-line.state-level-total
     2688            tt-rvs-line.state-temperature tt-rvs-line.state-temp-layer1
     2689            tt-rvs-line.state-temp-layer2 tt-rvs-line.state-temp-layer3
     2690            mass-float-cov
     2691         WITH FRAME Dialog-Frame.
     2692     VIEW FRAME Dialog-Frame.
     2693   END PROCEDURE.
     2694   PROCEDURE level-measure-water :
     2695   display input frame Dialog-Frame tt-rvs-line.level-total -
     2696           input frame Dialog-Frame tt-rvs-line.level-petrol @
     2697           tt-rvs-line.level-water with frame Dialog-Frame.
     2698   END PROCEDURE.
     2699   PROCEDURE level-water :
     2700     define input parameter p-mode as logical no-undo.
     2701     define variable is_OK as logical no-undo initial yes.
     2702     if input frame Dialog-Frame tt-rvs-line.state-level-petrol >
     2703        input frame Dialog-Frame tt-rvs-line.state-level-total  then do:
     2704       assign is_OK = no.
     2705       if p-mode = yes then do:
     2706         message "Уровень топлива больше значения общего уровня." view-as alert-box error.
     2707         return error.
     2708       end.
     2709     end.
     2710     display input frame Dialog-Frame tt-rvs-line.state-level-total  -
     2711             input frame Dialog-Frame tt-rvs-line.state-level-petrol @
     2712                                       tt-rvs-line.state-level-water
     2713     with frame Dialog-Frame.
     2714     if is_OK = yes then do:
     2715       assign frame Dialog-Frame tt-rvs-line.state-level-water
     2716                                  tt-rvs-line.state-level-petrol
     2717                                  tt-rvs-line.state-level-total.
     2718     end.
     2719   END PROCEDURE.
     2720   PROCEDURE local-tarir :
     2721   DEFINE INPUT PARAMETER paraction AS CHARACTER NO-UNDO.
     2722   DEFINE VARIABLE varlevel-sm-q AS DECIMAL NO-UNDO.
     2723   define variable vartarirvalue as character no-undo.
     2724   define variable vartarirtype  as character no-undo.
     2725   define variable varlevel-sm   as integer   no-undo.
     2726   define buffer bf_place for ub.place.
     2727   run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output vartarirvalue, output vartarirtype) no-error.
     2728   if vartarirvalue = "yes" then do:
     2729     CASE paraction:
     2730       WHEN "state-level-total" THEN DO:
     2731         ASSIGN
     2732           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-total.
     2733       END.
     2734       WHEN "state-level-petrol" THEN DO:
     2735         ASSIGN
     2736           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-petrol.
     2737       END.
     2738     END CASE.
     2739     assign
     2740       varlevel-sm = trunc (varlevel-sm-q, 0).
     2741     find first bf_place where bf_place.pl-code = tt-rvs-line.pl-code no-lock.
     2742     find first bf_pl-level where bf_pl-level.obj-type = tt-rvs-line.obj-type      and
     2743                                  bf_pl-level.obj-code = tt-rvs-line.obj-code      and
     2744                                  bf_pl-level.pl-code  = bf_place.pl-code          and
     2745                                  bf_pl-level.pl-level = varlevel-sm            no-error.
     2746     if not available bf_pl-level then do:
     2747       message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " bf_place.loc1 " не задан объем для уровня " varlevel-sm view-as alert-box error.
     2748       return no-apply.
     2749     end.
     2750     else do:
     2751       if varlevel-sm = varlevel-sm-q then do:
     2752         if error-status:error then return no-apply.
     2753         display bf_pl-level.pl-qnty @ tt-rvs-line.state-brutto-qnty bf_pl-level.pl-qnty @ tt-rvs-line.state-measure-qnty with frame Dialog-Frame.
     2754       end.
     2755       else do:
     2756         assign
     2757           varlevel-sm = varlevel-sm + 1.
     2758         find first bf-nxt_pl-level where bf-nxt_pl-level.obj-type = tt-rvs-line.obj-type   and
     2759                                          bf-nxt_pl-level.obj-code = tt-rvs-line.obj-code   and
     2760                                          bf-nxt_pl-level.pl-code  = bf_place.pl-code       and
     2761                                          bf-nxt_pl-level.pl-level = varlevel-sm            no-error.
     2762         if not available bf-nxt_pl-level then do:
     2763           message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " bf_place.loc1 " не задан объем для уровня " varlevel-sm " измерение " varlevel-sm-q view-as alert-box error.
     2764           return no-apply.
     2765         end.
     2766         else do:
     2767           display bf_pl-level.pl-qnty + (bf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) @ tt-rvs-line.state-brutto-qnty
     2768                   bf_pl-level.pl-qnty + (bf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) @ tt-rvs-line.state-measure-qnty with frame Dialog-Frame.
     2769         end.
     2770       end.
     2771       assign
     2772         tt-rvs-line.state-brutto-qnty = input frame Dialog-Frame tt-rvs-line.state-measure-qnty.
     2773       display tt-rvs-line.state-brutto-qnty with frame Dialog-Frame.
     2774       if tt-rvs-line.state-density <> 0 and
     2775           tt-rvs-line.state-density <> ? then do:
     2776           run chg-density.
     2777           run weath-water.
     2778       end.
     2779       CASE paraction:
     2780         WHEN "state-level-total" THEN DO:
     2781           DISPLAY input frame Dialog-Frame tt-rvs-line.state-level-total @ tt-rvs-line.state-level-petrol WITH FRAME Dialog-Frame.
     2782         END.
     2783         WHEN "state-level-petrol" THEN DO:
     2784           DISPLAY input frame Dialog-Frame tt-rvs-line.state-level-petrol @ tt-rvs-line.state-level-total WITH FRAME Dialog-Frame.
     2785         END.
     2786       END CASE.
     2787       run volume-water.
     2788     end.
     2789   end.
     2790   END PROCEDURE.
     2791   PROCEDURE volume-measure-water :
     2792   display input frame Dialog-Frame tt-rvs-line.brutto-qnty -
     2793           input frame Dialog-Frame tt-rvs-line.measure-qnty @
     2794           varmeasure-water-qnty with frame Dialog-Frame.
     2795   END PROCEDURE.
     2796   PROCEDURE volume-water :
     2797   display input frame Dialog-Frame tt-rvs-line.state-brutto-qnty -
     2798           input frame Dialog-Frame tt-rvs-line.state-measure-qnty @
     2799           varstate-water-qnty with frame Dialog-Frame.
     2800           assign frame Dialog-Frame tt-rvs-line.state-brutto-qnty
     2801                                      tt-rvs-line.state-measure-qnty.
     2802   END PROCEDURE.
     2803   PROCEDURE weath-measure-water :
     2804   display input frame Dialog-Frame tt-rvs-line.brutto-cli-qnty -
     2805           input frame Dialog-Frame tt-rvs-line.measure-cli-qnty @
     2806           varmeasure-water-cli-qnty with frame Dialog-Frame.
     2807   END PROCEDURE.
     2808   PROCEDURE weath-water :
     2809   if input frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty >
     2810      input frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty then do:
     2811      message "Вес топлива больше общего веса."
     2812      view-as alert-box error.
     2813      return error.
     2814   end.
     2815   display input frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty -
     2816           input frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty @
     2817           varstate-water-cli-qnty with frame Dialog-Frame.
     2818   assign frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty
     2819                              tt-rvs-line.state-measure-cli-qnty.
     2820   END PROCEDURE.
