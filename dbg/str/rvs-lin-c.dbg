     2540         tt-rvs-line.state-measure-qnty
     2541         tt-rvs-line.state-add-qnty
     2542         tt-rvs-line.state-brutto-qnty
     2543         tt-rvs-line.state-brutto-cli-qnty
     2544       with frame Dialog-Frame.
     2545       for each rvs-line-attr no-lock
     2546          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     2547            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     2548            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     2549            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     2550            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     2551            :
     2552             case rvs-line-attr.attr-code :
     2553               when "meas-calc-qnty" then do :
