    10514       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    10515       .
    10516     end.
    10517     when "parts-ean-rsrv-fib":U then do:
    10518       assign
    10519       dsp-rs = substitute("Лок.коды (EAN) зарезерв. ФиБ партий на &1&2 &4", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10520       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    10521       .
    10522     end.
