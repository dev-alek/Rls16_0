    10404       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    10405       .
    10406     end.
    10407     when "parts-ean-last-date":U then do:
    10408       assign
    10409       dsp-rs = substitute("Лок.коды (EAN) партий свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    10410       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
