     3450           input p-curr-obj-type,
     3451           input p-curr-obj-code
     3452           ) no-error.
     3453        if error-status:error then return error.
     3454       end.
     3455     END.
     3456   end.
     3457   if NOT petrol-trk
     3458   or v-notcd
     3459   then do:
     3460     FOR EACH b-bc WHERE
     3461               b-bc.gds-code = ub.goods.gds-code AND
     3462               b-bc.node-code = p-bar-code.node-code AND
     3463               b-bc.part-code = ub.parts.part-code AND
