    10396       assign
    10397       dsp-rs = substitute("Лок.коды партий свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    10398       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    10399       .
    10400     end.
    10401     when "parts-rsrv-last-date":U then do:
