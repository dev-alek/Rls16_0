     8147   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8148   if session:set-wait-state( "" )  then .
     8149   case line-mode :
     8150     when 'ДОБАВЛЕНИЕ':U then do:
     8151       tot-lns = tot-lns + lns-cnt.
     8152       if not p-from-macro or p-step then
     8153       message
     8154       "Добавлено строк :" lns-cnt skip(0)
     8155       string(if lns-ignore <> 0
     8156       then ("Проигнорировано строк :" + string(lns-ignore))
     8157       else "":U)
     8158       .
     8159     end.
     8160     when 'удаление':U then do:
     8161       tot-lns = tot-lns - lns-cnt.
     8162       if not p-from-macro or p-step then
     8163       message
     8164       "Удалено строк :" lns-cnt skip(0)
     8165       string(if lns-ignore <> 0
     8166       then ("Проигнорировано строк :" + string(lns-ignore))
     8167       else "":U)
     8168       .
     8169     end.
     8170   end.
     8171   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on.
     8172   end.
     8173   END PROCEDURE.
     8174   procedure proc-file-list-methods :
     8175   define input parameter p-from-macro as logical no-undo .
     8176   define input parameter rs-list-method as character no-undo .
     8177   define input parameter rs-status as character no-undo .
     8178   define input parameter line-mode as character no-undo .
     8179   define input parameter p-id      as integer no-undo .
     8180   define variable ss as character no-undo .
     8181   define variable b-c as integer no-undo.
     8182   define variable imp-type like ub.goods.prod-type no-undo.
     8183   define variable imp-code like ub.goods.prod-code no-undo.
     8184   define variable imp-art like ub.goods.artic no-undo.
     8185   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     8186   define variable imp-doc-type as character no-undo.
     8187   define variable scan-qnty as dec no-undo.
     8188   define variable bc-qnty as dec no-undo.
     8189   define variable varresult   as character         no-undo.
     8190   define variable vartype-bc  as character         no-undo.
     8191   define variable varweight   as decimal           no-undo.
     8192   define variable v-full-path        as character no-undo .
     8193   define variable v-path             as character no-undo .
     8194   define variable v-file-name        as character no-undo .
     8195   define variable v-file-name-no-ext as character no-undo .
     8196   define variable v-file-name-ext    as character no-undo .
     8197   define buffer buf_bb-list-hist for bb-list-hist.
     8198   do
     8199   on error undo, return error
     8200   :
     8201   find first buf_bb-list-hist where
     8202             buf_bb-list-hist.id = p-id
     8203         AND buf_bb-list-hist.item_ <> '':U .
     8204   run gbl/filename.p
     8205     (input  entry(1, buf_bb-list-hist.item_, chr(4) )
     8206     ,output v-full-path
     8207     ,output v-path
     8208     ,output v-file-name
     8209     ,output v-file-name-no-ext
     8210     ,output v-file-name-ext
     8211     ) no-error .
     8212     if error-status:error then do: end. else do:
     8213     input stream sout from value (v-full-path).
     8214     CASE rs-list-method:
     8215       when "file-gds" then do:
     8216         if p-from-macro then
     8217         run restore-codes in this-procedure (input entry(2, buf_bb-list-hist.item, chr(4)), input p-curr-obj-type, input p-curr-obj-code).
     8218         repeat:
     8219             import stream sout imp-type imp-code imp-art scan-qnty no-error.
     8220             find ub.goods where ub.goods.prod-type = imp-type
     8221                         and ub.goods.prod-code = imp-code
     8222                         and ub.goods.artic     = imp-art no-lock no-error.
     8223             if available ub.goods then do:
     8224               assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8225               run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     8226             end.
     8227           end.
     8228       end.
     8229       when "scaner" then do:
     8230          repeat:
     8231           import stream sout unformatted ss.
     8232           ss = trim (ss).
     8233           if ss = "" then next.
     8234           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
     8235             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
     8236             else next.
     8237             assign
     8238             scan-qnty = dec (entry (2, ss))
     8239             ss = trim (entry (1, ss)).
     8240   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     8241   (
     8242    input  parparentproc
     8243   ,input  ss
     8244   ,input  ?
     8245   ,input  p-curr-obj-type
     8246   ,input  p-curr-obj-type
     8247   ,input  yes
     8248   ,input  no
     8249   ,input  varscales-pref
     8250   ,input  varpgscales-pref
     8251   ,output varresult
     8252   ,output vartype-bc
     8253   ,output varweight
     8254   ,buffer ub.bar-code
     8255   ,buffer ub.prod-bc
     8256   ,buffer ub.place
     8257   ) no-error.
     8258           if not available ub.bar-code then next.
     8259           bc-qnty = ub.bar-code.cli-base-rate.
     8260           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8261           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK no-error.
     8262           if available ub.goods then do:
     8263             run get-prt-and-unit in this-procedure (
     8264                                                     input ub.goods.prt-root
     8265                                                     ,input ub.goods.unit-base
     8266                                                     ,output l-empty-scale
     8267                                                     ) .
     8268             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input (not available prod-bc), buffer bar-code, buffer prod-bc).
     8269             if available bb-list and
     8270               bb-list.artic = ub.goods.artic and
     8271               bb-list.prod-type = ub.goods.prod-type and
     8272               bb-list.prod-code = ub.goods.prod-code then
     8273               bb-list.qnty = bb-list.qnty + scan-qnty * bc-qnty.
     8274           end.
     8275         end.
     8276       end.
     8277     END CASE.
     8278     input stream sout close.
     8279     assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8280     end.
     8281   end.
     8282   END PROCEDURE.
     8283   PROCEDURE write-hist :
     8284   define input parameter p-from-macro as logical no-undo .
     8285   define input parameter rs-list-method as character no-undo .
     8286   define input parameter rs-status as character no-undo .
     8287   define input parameter line-mode as character no-undo .
     8288   define parameter buffer buf_goods for ub.goods.
     8289   define variable v-ii as integer no-undo .
     8290   define variable v-temp-seq as integer no-undo .
     8291   if rs-list-method begins "single" then do:
     8292     if v-no-hist < 0 then do:
     8293       run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8294                                           , input-output v-seq
     8295                                           , input 0
     8296                                           , input get-hist-mode(line-mode)
     8297                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8298                                                   then (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8299                                                             , buf_goods.gds-code
     8300                                                             , buf_goods.artic
     8301                                                             , buf_goods.prod-type
     8302                                                             , buf_goods.prod-code
     8303                                                             , buf_goods.gds-name) +
     8304                                                          (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8305                                                   else substitute("КОД &1 товар c гл.кодом &2 &3 &4&5 &6"
     8306                                                             , (if bb-list.b-str <> '':U then bb-list.b-str else string(bb-list.b-code))
     8307                                                             , bb-list.gds-code
     8308                                                             , bb-list.artic
     8309                                                             , bb-list.prod-type
     8310                                                             , bb-list.prod-code
     8311                                                             , bb-list.gds-name)
     8312                                                   )
     8313                                           , input tot-lns
     8314                                           , input (rs-list-method + (if line-mode = 'ДОБАВЛЕНИЕ':U
     8315                                                                     then '':U
     8316                                                                     else (chr(4) + (if bb-list.b-str <> '':U
     8317                                                                                           then 'prod-bc':U
     8318                                                                                           else (if bb-list.loc-ean
     8319                                                                                                 then 'loc-ean':U
     8320                                                                                                 else 'bar-code':U)
     8321                                                                                           )
     8322                                                                           )
     8323                                                                     )
     8324                                                   )
     8325                                           , input rs-status
     8326                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8327                                                    then ('goods':U + chr(3) + string(buf_goods.gds-code) + chr(4) +
     8328                                                          (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8329                                                    else (if bb-list.b-str <> '':u and bb-list.loc-ean = no
     8330                                                         then ('prod-bc':U + chr(3) + bb-list.b-str)
     8331                                                         else ('bar-code':U + chr(3) + string(bb-list.b-code))
     8332                                                         )
     8333                                                    )
     8334                                           , input '':U
     8335                                           , input ?
     8336                                           ).
     8337     end.
     8338     else do:
     8339       v-temp-seq = v-seq - 1.
     8340       do v-ii = 0 to v-no-hist:
     8341         run create-bb-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8342                                             , input-output v-temp-seq
     8343                                             , input v-ii
     8344                                             , input get-hist-mode(line-mode)
     8345                                             , input (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8346                                                               , bb-list.gds-code
     8347                                                               , bb-list.artic
     8348                                                               , bb-list.prod-type
     8349                                                               , bb-list.prod-code
     8350                                                               , bb-list.gds-name) +
     8351                                                      (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8352                                             , input tot-lns
     8353                                             , input '':U
     8354                                             , input '':U
     8355                                             , input ('goods':U + chr(3) + string(bb-list.gds-code) +
     8356                                                     (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8357                                             , input '':U
     8358                                             , input ?
     8359                                             ).
     8360       end.
     8361     end.
     8362   end.
     8363   else do:
     8364     v-temp-seq = v-seq - 1.
     8365     do v-ii = 0 to v-no-hist:
     8366       run create-bb-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8367                                           , input-output  v-temp-seq
     8368                                           , input v-ii
     8369                                           , input get-hist-mode(line-mode)
     8370                                           , input '':U
     8371                                           , input tot-lns
     8372                                           , input rs-list-method
     8373                                           , input '':U
     8374                                           , input '':U
     8375                                           , input '':U
     8376                                           , input ?
     8377                                           ).
     8378     end.
     8379   end.
     8380   END.
     8381   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8382   DEFINE VARIABLE var-stat-line as character no-undo .
     8383   CASE p-status-chr:
     8384     when 'все':U then do:
     8385       assign
     8386       var-stat-line = "(текущие и удаленные товары)"
     8387       .
     8388     end.
     8389     when 'текущие':U then do:
     8390       assign
     8391       var-stat-line = "(текущие товары)"
     8392       .
     8393     end.
     8394     when 'удаленные':U then do:
     8395       assign
     8396       var-stat-line = "(неактивные товары)"
     8397       .
     8398     end.
     8399   END CASE.
     8400   return var-stat-line .
     8401   END.
     8402   procedure proc-vc-rs-list-method :
     8403   define variable v-operation as integer no-undo .
     8404   define variable main-code like ub.bar-code.b-code no-undo .
     8405   define variable v-chk-date-chr as character no-undo .
     8406   define variable dsp-rs-option as character no-undo .
     8407   define variable v-curr-host-code like ub.sysconf.host-code no-undo .
     8408   define variable v-item_ as character no-undo .
     8409   define variable v-tbl-name as character no-undo .
     8410   define variable v-bh as handle no-undo .
     8411   define variable v-recs as integer   no-undo .
     8412   define variable v-temp-seq as integer   no-undo .
     8413   define variable v-line as integer   no-undo .
     8414   define variable v-tot-lns as integer   no-undo .
     8415   define variable f-name as character no-undo .
     8416   define variable rid-list as character no-undo .
     8417   define variable bar_code as character no-undo .
     8418   define variable v-jj as integer no-undo .
     8419   define variable v-rid as recid no-undo .
     8420   define buffer buf_bb-list-hist for bb-list-hist.
     8421   define buffer buf_prod-bc for ub.prod-bc.
     8422   define buffer buf_bar-code for ub.bar-code.
     8423   define buffer buf_cash-desk for ub.cash-desk.
     8424   define buffer buf_db for ub.db.
     8425     do
     8426     on error undo, return error
     8427     :
     8428     assign
     8429     frame Dialog-Frame
     8430     T-all-prt
     8431     T-loc-alt
     8432     T-loc-base
     8433     .
     8434     if (
     8435     T-all-prt or
     8436     T-bc-alt  or
     8437     T-bc-base or
     8438     T-loc-alt or
     8439     T-loc-base  or
     8440     T-parts-all  or
     8441     T-parts-not-blank or
     8442     T-parts-ser or
     8443     T-pb-alt    or
     8444     T-pb-base   or
     8445     T-sc-base) = no then do:
     8446       message
     8447       "Не выбран ни один тип кодов!"
     8448       view-as alert-box error .
     8449       undo, return error .
     8450     end.
     8451     assign
     8452     temp-shop.obj-code = p-curr-obj-code
     8453     temp-shop.all-prt = T-all-prt
     8454     temp-shop.cd-bc-alt = T-bc-alt
     8455     temp-shop.cd-bc-base = T-bc-base
     8456     temp-shop.cd-loc-alt = T-loc-alt
     8457     temp-shop.cd-loc-base = T-loc-base
     8458     temp-shop.cd-parts-all = T-parts-all
     8459     temp-shop.cd-parts-not-blank = T-parts-not-blank
     8460     temp-shop.cd-parts-ser = T-parts-ser
     8461     temp-shop.cd-pb-alt = T-pb-alt
     8462     temp-shop.cd-pb-base = T-pb-base
     8463     temp-shop.cd-sc-base = T-sc-base
     8464     .
     8465       v-no-hist = - 1.
     8466       if temp-list.fvalue = "single" then
     8467         run UI-on.
     8468       else do:
     8469         v-no-hist = 0.
     8470         case rs-list-method:
     8471           when "all" then do:
     8472             glog = yes.
     8473             message "Коды выбранных типов для всех товаров из справочника товаров"
     8474             skip stat-line(rs-status)
     8475             view-as alert-box question buttons OK-Cancel update glog.
     8476             if not glog then do:
     8477               run UI-on.
     8478               return error .
     8479             end.
     8480             v-no-hist = 1.
     8481             run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8482                                                 , input-output v-seq
     8483                                                 , input 0
     8484                                                 , input '':U
     8485                                                 , input (substitute('Коды всех товаров &1 - ', stat-line(rs-status)) +
     8486                                                        (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8487                                                 , input tot-lns
     8488                                                 , input rs-list-method
     8489                                                 , input rs-status
     8490                                                 , input (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U)
     8491                                                 , input '':U
     8492                                                 , input ?
     8493                                                 ).
     8494           end.
     8495           when "goods"
     8496           or
     8497           when "goods-b-code"
     8498           or
     8499           when "goods-b-code-ean"
     8500           or
     8501           when "goods-b-str"
     8502           then do:
     8503             glog = yes.
     8504             case rs-list-method:
     8505               when "goods" then do:
     8506                 assign
     8507                 dsp-rs-option = substitute("Заданные типы кодов для товаров: &1", stat-line(rs-status)) +
