    10362   end.
    10363   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10364   run userobjs_select-one in this-procedure
    10365     (input  parparentproc
    10366     ,input  v-cntxt-db-num
    10367     ,input  v-cntxt-userid
    10368     ,input  v-cntxt-host-code-obj
    10369     ,input  v-cntxt-obj-type
    10370     ,input  v-cntxt-obj-code
    10371     ,output v-user-select
    10372     ,output v-sel-obj-type
    10373     ,output v-sel-obj-code
    10374     )  .
    10375   if not v-user-select then do:
    10376     return error.
    10377   end.
    10378   run gbl/d-integer.w (
    10379           input ?
    10380         ,input (
    10381         'title=':u + substitute("Введите кол-во дней, в течение которых истекает срок хранения") + '\':u
    10382       + 'text1=':u + "Кол-во дней" + '\':u
    10383       + 'format=' + "->>9" + '\':u
    10384       + 'fillin_row=3\':u
    10385       + 'fillin_col=4\':u
    10386       + 'fillin_width=20\':u
    10387       + 'fillin_height=1\':u
    10388       + 'max-chars=70\':u
    10389       + 'readonly=' +  'no':u + '\':u)
    10390       , input-output v-value-integer
    10391       , output v-ok
    10392           ).
    10393   if not v-ok then return error.
    10394   CASE rs-list-method:
