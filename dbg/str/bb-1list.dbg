    10538   PROCEDURE proc-parts-end :
    10539   define input parameter rs-list-method as character no-undo .
    10540   define variable v-value-integer as integer   no-undo .
    10541   define variable glog as logical no-undo .
    10542   define variable v-message as character no-undo .
    10543   define variable v-item as character no-undo .
    10544   define variable v-from-date as date no-undo .
    10545   define variable v-to-date as date no-undo .
    10546   define buffer buf_rp-by-call for ub.rp-by-call.
    10547   find first buf_rp-by-call no-lock where
    10548             buf_rp-by-call.profile_id = 62 no-error.
    10549   if not available buf_rp-by-call then do:
    10550     message
    10551     "В вашей системе НЕ ВКЛЮЧЕН профайл установки флагов на закончившиеся партии" skip
    10552     "Отбор невозможен"
    10553     view-as alert-box error .
    10554     return error.
    10555   end.
    10556   assign
    10557   frame Dialog-Frame
    10558   t-parts-not-blank
    10559   t-parts-all
    10560   .
    10561   if not (t-parts-not-blank or t-parts-all ) then do:
    10562     message
    10563     "У Вас не включен флаг <на непуст. № парт.> ИЛИ <все партии>" skip
    10564     "Вы уверены, что Вам нужны коды ПАРТИЙ?"
    10565     view-as alert-box question buttons yes-no update glog.
    10566     if not glog then do:
    10567       undo, return error .
    10568     end.
    10569   end.
    10570   glog = yes.
    10571   CASE rs-list-method:
    10572     when "parts-end-date-obj":U then do:
    10573       assign
    10574       v-message = substitute("Лок.коды закончившихся партий по объекту &1&2", chr(10), stat-line(rs-status))
    10575       .
    10576     end.
    10577     when "parts-ean-end-date-obj":U then do:
    10578       assign
    10579       v-message = substitute("Лок.коды (EAN) закончившихся партий по объекту &1&2", chr(10), stat-line(rs-status))
    10580       .
    10581     end.
    10582   END CASE.
    10583   message
    10584   v-message
    10585   view-as alert-box question buttons OK-Cancel update glog.
    10586   if not glog then do:
    10587     return error.
    10588   end.
    10589   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10590   run userobjs_select-one in this-procedure
    10591     (input  parparentproc
    10592     ,input  v-cntxt-db-num
    10593     ,input  v-cntxt-userid
    10594     ,input  v-cntxt-host-code-obj
    10595     ,input  v-cntxt-obj-type
    10596     ,input  v-cntxt-obj-code
    10597     ,output v-user-select
    10598     ,output v-sel-obj-type
    10599     ,output v-sel-obj-code
    10600     )  .
    10601   if not v-user-select then do:
    10602     return error.
    10603   end.
    10604   message
    10605   "Выберите начальную и конечную даты, между которыми было обнаружено, что партия закончилась"
    10606   view-as alert-box.
    10607   run gbl/get-per.w ( output glog
    10608                      ,input-output v-from-date
    10609                      ,input-output v-to-date
    10610                      ) no-error.
    10611   CASE rs-list-method:
    10612     when "parts-end-date-obj":U then do:
    10613       assign
    10614       dsp-rs = substitute("Лок.коды закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10615       v-item = v-sel-obj-type + chr(3) +
    10616                string(v-sel-obj-code) + chr(3) +
    10617                string(v-from-date, "99/99/9999") + chr(3) +
    10618                string(v-to-date, "99/99/9999")
    10619       .
    10620     end.
    10621     when "parts-ean-end-date-obj":U then do:
    10622       assign
    10623       dsp-rs = substitute("Лок.коды (EAN) закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10624       v-item = v-sel-obj-type + chr(3) +
    10625                string(v-sel-obj-code) + chr(3) +
    10626                string(v-from-date, "99/99/9999") + chr(3) +
    10627                string(v-to-date, "99/99/9999")
    10628       .
    10629     end.
    10630   END CASE.
    10631   v-no-hist = 0.
    10632   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10633                                       , input-output v-seq
    10634                                       , input 0
    10635                                       , input '':U
    10636                                       , input dsp-rs
    10637                                       , input tot-lns
    10638                                       , input rs-list-method
    10639                                       , input rs-status
    10640                                       , input v-item
    10641                                       , input '':U
    10642                                       , input ?
    10643                                       ).
    10644   END PROCEDURE.
