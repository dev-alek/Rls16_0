     6801     .
     6802   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6803     run mainmenu_getcntxt in parparentproc
     6804       (output v-cntxt-db-num
     6805       ,output v-cntxt-userid
     6806       ,output v-cntxt-level
     6807       ,output v-cntxt-host-code-obj
     6808       ,output v-cntxt-obj-type
     6809       ,output v-cntxt-obj-code
     6810       ,output v-cntxt-db-num-obj
     6811       ,output v-cntxt-is-admin
     6812       ) .
     6813     if p-curr-obj-type = '':U
     6814     and p-curr-obj-code = 0 then do:
     6815   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6816   run userobjs_select-one in this-procedure
     6817     (input  parparentproc
     6818     ,input  v-cntxt-db-num
     6819     ,input  v-cntxt-userid
     6820     ,input  v-cntxt-host-code-obj
     6821     ,input  v-cntxt-obj-type
     6822     ,input  v-cntxt-obj-code
     6823     ,output v-user-select
     6824     ,output v-sel-obj-type
     6825     ,output v-sel-obj-code
     6826     )  .
     6827       if v-user-select then do: ~
     6828         FIND FIRST buf_user-obj no-lock where
     6829                 buf_user-obj.obj-type = v-sel-obj-type
     6830             and buf_user-obj.obj-code = v-sel-obj-code  No-ERROR.
     6831         if not avail buf_user-obj then return no-apply.
     6832         find first buf_clients no-lock where
     6833                   buf_clients.obj-type = buf_user-obj.obj-type
     6834               and buf_clients.obj-code = buf_user-obj.obj-code no-error.
     6835         if not available buf_clients then return error.
     6836         assign
     6837         p-curr-obj-type = buf_clients.obj-type
     6838         p-curr-obj-code = buf_clients.obj-code
     6839         v-host-code = buf_clients.host-code
     6840         v-no-obj = yes
     6841         .
     6842       end.
     6843       else do:
     6844         message
     6845         "Текущий объект не может быть установлен" skip
     6846         view-as alert-box error .
     6847         undo, return error.
     6848       end.
     6849     end.
     6850     if not (p-curr-obj-type = '':U
     6851             and
     6852             p-curr-obj-code = 0) then do:
     6853       find first buf_clients no-lock
     6854           where buf_clients.obj-type = p-curr-obj-type
     6855           AND    buf_clients.obj-code = p-curr-obj-code no-error.
     6856       if not available buf_clients
     6857       or not (buf_clients.obj-type = 'маг':U
     6858         or
     6859         buf_clients.obj-type = 'скл':U
     6860         )
     6861       then do:
     6862         assign
     6863         p-curr-obj-type = '':U
     6864         p-curr-obj-code = 0
     6865         .
     6866         message
     6867         vss-workfile vss-revision vss-description skip
     6868         "Неверно заданы входные параметры p-curr-obj-type и/или p-curr-obj-code"
     6869         p-curr-obj-type p-curr-obj-code
     6870         view-as alert-box error .
     6871         undo main-block, return error.
     6872       end.
     6873     end.
     6874     assign
     6875     line-rec = ?
     6876     .
     6877     assign
     6878     br-option:column-scrolling in frame Dialog-Frame  = no
     6879     RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     6880                               "Все!" + chr(44) + 'все':U + chr(44) +
     6881                               "Неактивные-" + chr(44) + 'удаленные':U
     6882     RS-status = 'текущие':U
     6883     .
     6884     if v-no-obj
     6885     or v-cntxt-level <>  'object':U then do:
     6886       if v-obj-name = "":U then do:
     6887         run proc-b-obj in this-procedure ( input "":U ).
     6888       end.
     6889       display
     6890         b-obj
     6891         v-obj-type
     6892         v-obj-code
     6893         v-obj-name
     6894       with frame Dialog-Frame .
     6895       enable
     6896         b-obj
     6897       with frame Dialog-Frame .
     6898     end.
     6899     else do:
     6900       assign
     6901       v-obj-type  = p-curr-obj-type
     6902       v-obj-code  = p-curr-obj-code
     6903       .
     6904       if v-obj-type = 'маг':U then do:
     6905         find first ub.shop no-lock where
     6906                   ub.shop.obj-code = v-obj-code.
     6907         find first sysconf no-lock where
     6908                   sysconf.host-code = shop.host-code .
     6909         assign
     6910         v-is-restaurant = ub.shop.is-catering
     6911         v-doc-prt = ub.shop.doc-prt.
     6912         .
     6913       end.
     6914       else do:
     6915         find first ub.store no-lock where
     6916                   ub.store.obj-code = p-curr-obj-code.
     6917         find first sysconf no-lock where
     6918                   sysconf.host-code = store.host-code .
     6919         v-doc-prt = ub.store.doc-prt.
     6920       end.
     6921       run proc-fill-temp-list in this-procedure .
     6922       for each temp-shop:
     6923         delete temp-shop.
     6924       end.
     6925       create temp-shop.
     6926       run proc-b-cd in this-procedure  ( input yes).
     6927     end.
     6928     run UI-on.
     6929     WAIT-FOR GO OF FRAME Dialog-Frame focus br-list.
     6930   END.
     6931   HIDE FRAME Dialog-Frame.
     6932   PROCEDURE UI-on:
     6933   define variable v-recid0 as recid no-undo.
     6934   define variable v-start as logical no-undo .
     6935   define buffer buf_temp-list for temp-list.
     6936   define buffer buf_bb-list-hist for bb-list-hist.
     6937   bb-list.part-code:resizable in browse br-list = yes.
     6938   bb-list.in-code:resizable in browse br-list = yes.
     6939   if v-cntxt-level <> 'object':U
     6940   or v-cntxt-obj-type <> 'маг':U then do:
     6941     assign
     6942     MENU-ITEM m-cd:sensitive in menu m-save = no.
     6943   end.
     6944     find first buf_bb-list-hist where buf_bb-list-hist.id = 0 no-error.
     6945     if available buf_bb-list-hist then
     6946     assign
     6947     frame Dialog-Frame:title = substitute("СПИСОК  КОДОВ &1",  string(buf_bb-list-hist.des, "X(60)"))
     6948     .
     6949     if tot-lns = ? then do:
     6950       v-start = yes.
     6951       for each l-bb-list :
     6952         accumulate l-bb-list.artic (count).
     6953       end.
     6954       tot-lns = (accum count l-bb-list.artic).
     6955       if tot-lns > 0 then do:
     6956         find last  buf_bb-list-hist no-error .
     6957         if available buf_bb-list-hist and buf_bb-list-hist.id = 1 and v-start then delete buf_bb-list-hist.
     6958         v-seq = (if available buf_bb-list-hist then buf_bb-list-hist.id else 0)  + 1.
     6959         run create-bb-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6960                                              , input-output v-seq
     6961                                              , input 0
     6962                                              , input 'S':U
     6963                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6964                                              , input tot-lns
     6965                                              , input "start":U
     6966                                              , input '':U
     6967                                              , input '':U
     6968                                              , input '':U
     6969                                              , input ?
     6970                                              ).
     6971       end.
     6972       else do:
     6973         line-mode = 'ДОБАВЛЕНИЕ':U.
     6974         for each buf_bb-list-hist:
     6975           delete buf_bb-list-hist.
     6976         end.
     6977         v-seq = 1.
     6978         run create-bb-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6979                                              , input-output v-seq
     6980                                              , input 0
     6981                                              , input '':U
     6982                                              , input "# Исходный список кодов пуст."
     6983                                              , input tot-lns
     6984                                              , input 'start':U
     6985                                              , input '':U
     6986                                              , input '':U
     6987                                              , input '':U
     6988                                              , input ?
     6989                                              ).
     6990       end.
     6991     end.
     6992     hide loc-art in frame Dialog-Frame loc-name loc-code loc-b-str in frame Dialog-Frame.
     6993     assign
     6994       loc-art = ""
     6995       RS-list-method = "single"
     6996       dsp-rs = "Всего строк в списке кодов : " + string (tot-lns).
     6997     find first buf_temp-list no-lock where
     6998                buf_temp-list.fvalue = rs-list-method.
     6999     assign
     7000     v-recid0 = recid(buf_temp-list).
     7001     open query br-option for each temp-list no-lock .
     7002     DISPLAY br-option dsp-rs RS-Status WITH FRAME Dialog-Frame.
     7003     ENABLE
     7004     b-exit b-add b-hist b-help br-option br-list RS-Status b-cd
     7005     T-loc-base
     7006     T-loc-alt
     7007     T-all-prt
     7008     WITH FRAME Dialog-Frame.
     7009     if is-tsd = no then do:
     7010       menu-item m-scn-save:sensitive in menu m-save = no.
     7011     end.
     7012     reposition br-option to recid v-recid0.
     7013     if tot-lns > 0 then
     7014       ENABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7015     else do:
     7016       DISABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7017     end.
     7018     open query br-list for each bb-list no-lock indexed-reposition.
     7019    if v-seq > 1 then
     7020     find last buf_bb-list-hist no-lock where
     7021               buf_bb-list-hist.id = (v-seq - 1)
     7022          and  buf_bb-list-hist.line = 0 no-error .
     7023     DISPLAY br-option
     7024     (if available buf_bb-list-hist
     7025     then buf_bb-list-hist.des
     7026     else '') @ dsp-rs
     7027     RS-Status WITH FRAME Dialog-Frame.
     7028     ENABLE
     7029     b-macro  when v-start
     7030     b-record when v-start
     7031     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     7032     if v-start then do:
     7033       hide
     7034       b-stop
     7035       b-clear-macro
     7036       in frame Dialog-Frame.
     7037     end.
     7038     v-start = no.
     7039     if line-rec <> ? then
     7040       reposition br-list to recid line-rec no-error.
     7041     apply "entry" to br-list in frame Dialog-Frame.
     7042     if available bb-list then do:     find ub.clients where ub.clients.obj-type = bb-list.prod-type                    and ub.clients.obj-code = bb-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = bb-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = bb-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = bb-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   disp tot-lns @ f-tot-lns with frame Dialog-Frame.
     7043   END PROCEDURE.
     7044   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7045   PROCEDURE ex-bbc :
     7046   define input parameter rs-list-method as character no-undo .
     7047   define input parameter rs-status as character no-undo .
     7048   define input parameter line-mode as character no-undo .
     7049   define input parameter p-empty-scale as logical no-undo .
     7050   define input parameter p-b-str as character no-undo .
     7051   define input parameter p-is-loc-ean as logical no-undo .
     7052   define parameter buffer buf_bar-code for ub.bar-code.
     7053   define parameter buffer buf_prod-bc for ub.prod-bc.
     7054   define variable v-f-name like ub.gds-prt.f-name no-undo .
     7055   define buffer buf_gds-prt for ub.gds-prt.
     7056   if available buf_prod-bc then
     7057   p-b-str = buf_prod-bc.b-str.
     7058   if rs-list-method begins "single":U or
     7059     (ub.goods.stts = 0  and rs-status <> 'удаленные':U) or
     7060     (ub.goods.stts <> 0 and rs-status <> 'текущие':U) then do:
     7061     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     7062       find first bb-list where bb-list.gds-code  = ub.goods.gds-code
     7063                        and bb-list.b-code    = buf_bar-code.b-code
     7064                        and bb-list.b-str     = p-b-str  no-error.
     7065       if available bb-list then do:
     7066         if line-mode = 'удаление':U then do:
     7067           lns-cnt = lns-cnt + 1.
     7068           delete bb-list.
     7069         end.
     7070         else do:
     7071           if bb-list.to-del = ? then.
     7072           else do:
     7073             lns-cnt = lns-cnt + 1.
     7074             bb-list.to-del = ?.
     7075           end.
     7076         end.
     7077       end.
     7078     end.
     7079     else
     7080       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     7081         if p-empty-scale then  do:
     7082         end.
     7083         else do:
     7084           find first buf_gds-prt no-lock where
     7085                     buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     7086           if not available buf_gds-prt then v-f-name = "!!!Неизвестный признак шкалы".
     7087           else v-f-name = buf_gds-prt.f-name.
     7088         end.
     7089   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7090   find first bb-list
     7091     where bb-list.gds-code = buf_bar-code.gds-code
     7092       and bb-list.b-code   = buf_bar-code.b-code
     7093       and bb-list.b-str    = p-b-str
     7094     no-error .
     7095   if available bb-list then do:
     7096     assign
     7097       bb-list.to-del = no
     7098     .
     7099   end.
     7100   else do:
     7101     define variable v-last62 as integer no-undo .
     7102     find last bb-list use-index oi no-error.
     7103     if available bb-list then do:
     7104       v-last62 = bb-list.order-num .
     7105     end.
     7106     else do:
     7107       v-last62 = 0 .
     7108     end.
     7109     create bb-list .
     7110     buffer-copy ub.goods to bb-list
     7111     assign
     7112       bb-list.to-del = no
     7113       bb-list.order-num = v-last62 + 1
     7114       bb-list.b-code = buf_bar-code.b-code
     7115       bb-list.bc-cli-base-rate = buf_bar-code.cli-base-rate
     7116       bb-list.bc-cr-db-num     = buf_bar-code.cr-db-num
     7117       bb-list.in-code       = buf_bar-code.in-code
     7118       bb-list.node-code     = buf_bar-code.node-code
     7119       bb-list.part-code     = buf_bar-code.part-code
     7120       bb-list.stts_         = buf_bar-code.stts_
     7121       bb-list.bc-unit-cli   = buf_bar-code.unit-cli
     7122       bb-list.b-str         = p-b-str
     7123       bb-list.f-name        = v-f-name
     7124       bb-list.loc-ean       = p-is-loc-ean
     7125       .
     7126       if available buf_prod-bc
     7127       then
     7128       assign
     7129       bb-list.bc-on-type    = buf_prod-bc.bc-on-type
     7130       bb-list.bc-on         = buf_prod-bc.bc-on
     7131       bb-list.pbc-cr-db-num = buf_prod-bc.cr-db-num
     7132       .
     7133     assign
     7134       lns-cnt = lns-cnt + 1
     7135       line-rec = recid (bb-list)
     7136     .
     7137   end.
     7138       end.
     7139     if lns-cnt modulo 25 = 0 then
     7140     disp "ЖДИТЕ...    Обработано кодов :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7141   end.
     7142   else
     7143   assign
     7144   lns-ignore = lns-ignore + 1
     7145   .
     7146   end.
     7147   PROCEDURE rs-do :
     7148   define input parameter p-from-macro as logical no-undo .
     7149   define input parameter p-step as logical no-undo .
     7150   define input parameter rs-list-method as character no-undo .
     7151   define input parameter rs-status as character no-undo .
     7152   define input parameter line-mode as character no-undo .
     7153   define input parameter p-id      as integer no-undo .
     7154   define variable v-rowid   as rowid no-undo .
     7155   define variable v-tbl-name as character no-undo .
     7156   define variable glog as logical no-undo .
     7157   define buffer buf_bb-list-hist for bb-list-hist.
     7158   define variable another-price like ub.price-list.price-sale no-undo.
     7159   define variable scan-qnty as dec no-undo.
     7160   define variable bc-qnty as dec no-undo.
     7161   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7162   define variable varresult   as character         no-undo.
     7163   define variable vartype-bc  as character         no-undo.
     7164   define variable varweight   as decimal           no-undo.
     7165   define variable v-value-integer as integer   no-undo .
     7166   define variable v-db-num as integer no-undo .
     7167   define variable l-prod-bc-weight as logical no-undo .
     7168   define variable l-prod-bc-pgweight as logical no-undo .
     7169   define variable l-prod-bc-glob as logical no-undo .
     7170   define variable v-is-weight as logical no-undo .
     7171   define variable IBM-good-code as character no-undo .
     7172   define variable bar_code as character no-undo .
     7173   define variable v-prev-b-code as integer no-undo .
     7174   define variable v-b-code as integer   no-undo .
     7175   define variable v-from-date as date no-undo .
     7176   define variable v-to-date as date no-undo .
     7177   define variable v-from-date-str as character no-undo .
     7178   define variable v-to-date-str as character no-undo .
     7179   define variable v-using as character no-undo .
     7180   define buffer buf_prod-bc for ub.prod-bc.
     7181   define buffer buf_bar-code for ub.bar-code.
     7182   define buffer buf_cd-plu for ub.cd-plu.
     7183   define buffer buf_parts for ub.parts.
     7184   define buffer buf_gds-obj for ub.gds-obj.
     7185   define buffer buf_parts-obj-attr for ub.parts-obj-attr.
     7186   define buffer buf_code-range for ub.code-range.
     7187   define buffer buf_prod-bc-db for ub.prod-bc-db.
     7188   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     7189   define buffer buf_scales-gds for ub.scales-gds.
     7190   do
     7191   on error undo, return error return-value
     7192   :
     7193   if p-from-macro then do:
     7194   end.
     7195   else do:
     7196     assign
     7197     frame Dialog-Frame
     7198     T-all-prt
     7199     T-loc-alt
     7200     T-loc-base
     7201     .
     7202     if (
     7203     T-all-prt or
     7204     T-bc-alt  or
     7205     T-bc-base or
     7206     T-loc-alt or
     7207     T-loc-base  or
     7208     T-parts-all  or
     7209     T-parts-not-blank or
     7210     T-parts-ser or
     7211     T-pb-alt    or
     7212     T-pb-base   or
     7213     T-sc-base) = no then do:
     7214       message
     7215       "Не выбран ни один тип кодов!"
     7216       view-as alert-box error .
     7217       undo, return error .
     7218     end.
     7219     assign
     7220     temp-shop.obj-code = p-curr-obj-code
     7221     temp-shop.all-prt = T-all-prt
     7222     temp-shop.cd-bc-alt = T-bc-alt
     7223     temp-shop.cd-bc-base = T-bc-base
     7224     temp-shop.cd-loc-alt = T-loc-alt
     7225     temp-shop.cd-loc-base = T-loc-base
     7226     temp-shop.cd-parts-all = T-parts-all
     7227     temp-shop.cd-parts-not-blank = T-parts-not-blank
     7228     temp-shop.cd-parts-ser = T-parts-ser
     7229     temp-shop.cd-pb-alt = T-pb-alt
     7230     temp-shop.cd-pb-base = T-pb-base
     7231     temp-shop.cd-sc-base = T-sc-base
     7232     .
     7233   end.
     7234   assign
     7235   lns-cnt = 0
     7236   lns-ignore = 0
     7237   v-num-add  = 0
     7238   v-num-ignored = 0
     7239   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7240   .
     7241   run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     7242   if session:set-wait-state( "COMPILER" )  then .
     7243   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7244   case rs-list-method:
     7245     when "optimize"  then do:
     7246       find first buf_bb-list-hist where
     7247                  buf_bb-list-hist.id = p-id .
     7248       run proc-b-optimize(input p-from-macro
     7249                         , input rs-list-method
     7250                         , input rs-status
     7251                         , input buf_bb-list-hist.item_
     7252                         ) no-error .
     7253       assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7254     end.
     7255     when "all" then do:
     7256       find first buf_bb-list-hist where
     7257                  buf_bb-list-hist.id = p-id .
     7258       if p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7259       for each goods no-lock:
     7260         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7261         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode, buffer goods) no-error .
     7262       end.
     7263       assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7264     end.
     7265     when "goods" then do:
     7266       for each buf_bb-list-hist where
     7267                buf_bb-list-hist.id = p-id:
     7268         if buf_bb-list-hist.line = 0
     7269         and p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7270         if buf_bb-list-hist.line <> 0 then do:
     7271           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7272           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7273           find goods where rowid (goods) = v-rowid no-lock.
     7274           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     7275           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7276         end.
     7277       end.
     7278     end.
     7279     when "goods-b-code"
     7280     or
     7281     when "goods-b-code-ean"
     7282     then do:
     7283       for each buf_bb-list-hist where
     7284                buf_bb-list-hist.id = p-id
     7285           and  buf_bb-list-hist.item_ <> '':U:
     7286         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7287         find first buf_bar-code no-lock where
     7288                   rowid(buf_bar-code) = v-rowid no-error.
     7289         if available buf_bar-code then do:
     7290           run get-prt-and-unit in this-procedure (
     7291                                                   input goods.prt-root
     7292                                                   ,input goods.unit-base
     7293                                                   ,output l-empty-scale
     7294                                                   ) .
     7295           if rs-list-method = "goods-b-code":U then
     7296           run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7297           if rs-list-method = "goods-b-code-ean":U then do:
     7298             RUN gen-bc( input buf_bar-code.b-code, output bar_code ).
     7299             IBM-good-code  = trim( bar_code ) .
     7300             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input IBM-good-code, input yes, buffer buf_bar-code, buffer buf_prod-bc).
     7301           end.
     7302           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7303         end.
     7304       end.
     7305     end.
     7306     when "goods-b-str" then do:
     7307       for each buf_bb-list-hist where
     7308                buf_bb-list-hist.id = p-id
     7309           and  buf_bb-list-hist.item_ <> '':U:
     7310         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7311         find first buf_prod-bc no-lock where
     7312                 rowid(buf_prod-bc) = v-rowid no-error.
     7313         if available buf_prod-bc then do:
     7314           find first buf_bar-code no-lock where
     7315                     buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     7316           if available buf_prod-bc then do:
     7317             run get-prt-and-unit in this-procedure (
     7318                                                     input goods.prt-root
     7319                                                     ,input goods.unit-base
     7320                                                     ,output l-empty-scale
     7321                                                     ) .
     7322             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode ,  input l-empty-scale, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7323           end.
     7324         end.
     7325       end.
     7326     end.
     7327     when "gds-list"  then do:
     7328       for each buf_bb-list-hist where
     7329                buf_bb-list-hist.id = p-id:
     7330         if buf_bb-list-hist.line = 0
     7331         and p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7332         if buf_bb-list-hist.line <> 0 then do:
     7333           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_bb-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7334           find first goods no-lock where rowid(goods) = v-rowid.
     7335           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7336           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode,buffer goods) no-error .
     7337           assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7338         end.
     7339       end.
     7340     end.
     7341     when "file-gds"
     7342     or
     7343     when "scaner"
     7344     then do:
     7345       run proc-file-list-methods in this-procedure(input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id). .
     7346     end.
     7347     when "last-check":U then do:
     7348       find first buf_bb-list-hist where
     7349                buf_bb-list-hist.id = p-id
     7350            AND buf_bb-list-hist.item_ <> '':U .
     7351       assign
     7352       v-curr-obj-type = entry(1, buf_bb-list-hist.item_, chr(3))
     7353       v-curr-obj-code = integer(entry(2, buf_bb-list-hist.item_, chr(3)))
     7354       v-chk-date-chr = entry(3, buf_bb-list-hist.item_, chr(3))
     7355       v-chk-date = date(integer(substring(v-chk-date-chr, 4, 2)),
     7356                     integer(substring(v-chk-date-chr, 1, 2)),
     7357                     integer(substring(v-chk-date-chr, 7, 4)))
     7358       no-error
     7359       .
     7360       if error-status:error then do: end. else do:
     7361         for each ub.chk-doc no-lock where
     7362                 ub.chk-doc.obj-type = v-curr-obj-type
     7363             AND ub.chk-doc.obj-code = v-curr-obj-code
     7364             and ub.chk-doc.chk-date <= v-chk-date,
     7365             each ub.chk-gds no-lock where
     7366                 ub.chk-gds.doc-code = ub.chk-doc.doc-code:
     7367   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     7368   (
     7369    input  parparentproc
     7370   ,input  entry(1, chk-gds.src-code, chr(4))
     7371   ,input  ?
     7372   ,input  v-curr-obj-type
     7373   ,input  v-curr-obj-code
     7374   ,input  yes
     7375   ,input  no
     7376   ,input  varscales-pref
     7377   ,input  varpgscales-pref
     7378   ,output varresult
     7379   ,output vartype-bc
     7380   ,output varweight
     7381   ,buffer ub.bar-code
     7382   ,buffer ub.prod-bc
     7383   ,buffer ub.place
     7384   ) no-error.
     7385           if not available ub.bar-code then next.
     7386           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7387           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK no-error.
     7388           if available goods then do:
     7389             run get-prt-and-unit in this-procedure (
     7390                                                     input ub.goods.prt-root
     7391                                                     ,input ub.goods.unit-base
     7392                                                     ,output l-empty-scale
     7393                                                     ) .
     7394             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input (not available prod-bc), buffer bar-code, buffer prod-bc).
     7395           end.
     7396         end.
     7397         assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7398       end.
     7399     end.
     7400     when "prod-bc-off" then do:
     7401       find first buf_bb-list-hist where
     7402                  buf_bb-list-hist.id = p-id .
     7403       if p-from-macro then run restore-codes in this-procedure (input buf_bb-list-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7404       for each ub.prod-bc no-lock
     7405       by ub.prod-bc.b-code
     7406       :
     7407         if ub.prod-bc.bc-on = no then do:
     7408           if ub.prod-bc.b-code <> v-prev-b-code then do:
     7409             find first ub.bar-code no-lock where ub.bar-code.b-code = ub.prod-bc.b-code no-error.
     7410             assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7411             if available ub.bar-code then do:
     7412               find first ub.goods no-lock where ub.goods.gds-code = ub.bar-code.gds-code no-error.
     7413             end.
     7414           end.
     7415           if available ub.bar-code
     7416           and available ub.goods then do:
     7417             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input ?, input ub.prod-bc.b-str, input no, buffer bar-code, buffer prod-bc).
     7418             assign                                                           buf_bb-list-hist.num-add  = lns-cnt - v-num-add                       buf_bb-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_bb-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_bb-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
