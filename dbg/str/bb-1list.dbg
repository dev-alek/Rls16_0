    10469       .
    10470     end.
    10471     when "parts-ean-rsrv-fib":U then do:
    10472       assign
    10473       v-message = substitute("Лок.коды (EAN) зарезерв.ФиБ партий &1&2", chr(10), stat-line(rs-status))
    10474       .
    10475     end.
    10476   END CASE.
    10477   message
    10478   v-message
    10479   view-as alert-box question buttons OK-Cancel update glog.
    10480   if not glog then do:
    10481     return error.
    10482   end.
    10483   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10484   run userobjs_select-one in this-procedure
    10485     (input  parparentproc
    10486     ,input  v-cntxt-db-num
    10487     ,input  v-cntxt-userid
    10488     ,input  v-cntxt-host-code-obj
    10489     ,input  v-cntxt-obj-type
    10490     ,input  v-cntxt-obj-code
    10491     ,output v-user-select
    10492     ,output v-sel-obj-type
    10493     ,output v-sel-obj-code
    10494     )  .
    10495   if not v-user-select then do:
    10496     return error.
    10497   end.
    10498   CASE rs-list-method:
    10499     when "parts-fib":U then do:
    10500       assign
    10501       dsp-rs = substitute("Лок.коды ФиБ партий свободной зоны на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10502       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    10503       .
    10504     end.
    10505     when "parts-rsrv-fib":U then do:
    10506       assign
    10507       dsp-rs = substitute("Лок.коды зарезерв. ФиБ партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10508       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
