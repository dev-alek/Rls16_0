     3577             AND
     3578             (
     3579             (ub.goods.unit-base = p-bar-code.unit-cli AND temp-shop.cd-loc-base) OR
     3580             (NOT ub.goods.unit-base = p-bar-code.unit-cli AND temp-shop.cd-loc-alt)
     3581             ) AND
     3582             (NOT petrol-trk
     3583             or v-notcd
     3584             )
     3585             then NEXT.
     3586       if temp-shop.cd-sc-base AND
     3587       (LOOKUP('вес':U, ub.units.type) > 0
     3588       or
     3589       LOOKUP('топ':U, ub.units.type) > 0
     3590       or
     3591       ub.prod-bc.bc-on-type = 'pglc':U
     3592       )
     3593       and
     3594       p-bar-code.unit-cli = ub.goods.unit-base then do:
     3595         if not ub.prod-bc.bc-on-type = 'pglc':U then do:
     3596   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3598     (buffer ub.prod-bc
     3599     ,input  (if LOOKUP('вес':U, ub.units.type) > 0 then 'weight=request':U  else 'petrolium=request':U )
     3600     ,output g#log
     3601     ) no-error .
     3602           if error-status:error or not g#log then NEXT.
     3603         end.
     3604         run asc-gds in this-procedure (
     3605           input rs-list-method,
     3606           input rs-status,
     3607           input line-mode,
     3608           buffer ub.goods,
     3609           buffer p-bar-code,
     3610           buffer ub.gds-prt,
     3611           buffer ub.gds-obj,
     3612           buffer ub.price-list,
     3613           buffer ub.units,
     3614           buffer b-g-p,
     3615           input ub.prod-bc.b-str,
     3616           input ub.prod-bc.bc-on-type,
     3617           input (if avail b-units then b-units.type else ub.units.type),
     3618           input (if avail b-units then b-units.okei else ub.units.okei),
     3619           input ub.sysconf.host-code,
     3620           input p-curr-obj-type,
     3621           input p-curr-obj-code
     3622           ) no-error.
     3623         if error-status:error then return error.
     3624         NEXT.
     3625       end.
     3626       if ((temp-shop.cd-pb-base AND p-bar-code.unit-cli = ub.goods.unit-base
     3627       AND LOOKUP('вес':U, units.type) = 0
     3628       and ub.prod-bc.bc-on-type <> 'pglc':U
     3629       ) OR
     3630           (temp-shop.cd-pb-alt AND p-bar-code.unit-cli <> ub.goods.unit-base)) then do:
     3631         run asc-gds in this-procedure (
     3632           input rs-list-method,
     3633           input rs-status,
     3634           input line-mode,
     3635           buffer ub.goods,
     3636           buffer p-bar-code,
     3637           buffer ub.gds-prt,
     3638           buffer ub.gds-obj,
     3639           buffer ub.price-list,
     3640           buffer ub.units,
     3641           buffer b-g-p,
     3642           input ub.prod-bc.b-str,
     3643           input ub.prod-bc.bc-on-type,
     3644           input (if avail b-units then b-units.type else ub.units.type),
     3645           input (if avail b-units then b-units.okei else ub.units.okei),
     3646           input ub.sysconf.host-code,
     3647           input p-curr-obj-type,
     3648           input p-curr-obj-code
     3649           ) no-error.
     3650        if error-status:error then return error.
     3651       end.
     3652     END.
     3653   end.
     3654   if NOT petrol-trk
     3655   or v-notcd
     3656   then do:
     3657     FOR EACH b-bc WHERE
     3658               b-bc.gds-code = ub.goods.gds-code AND
     3659               b-bc.node-code = p-bar-code.node-code AND
     3660               b-bc.part-code = ub.parts.part-code AND
     3661               b-bc.in-code = ub.parts.in-code NO-LOCK :
     3662       if  b-bc.unit-cli <> ub.goods.unit-base then do:
