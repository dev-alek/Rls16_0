     4566   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4567   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4568   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4569   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4570   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4571   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4572   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4573   define variable v-diasize-current-frame-height as decimal   no-undo .
     4574   define variable v-diasize-change-size          as logical   no-undo .
     4575   define variable v-diasize-resize-button        as handle    no-undo .
     4576   define variable v-diasize-wndmax               as logical   no-undo .
     4577   define variable v-diasize-wndstore             as logical   no-undo .
     4578   define variable v-diasize-proc-name            as character no-undo .
     4579   define variable v-diasize-browse-handle        as handle    no-undo .
     4580   define variable v-diasize-browse-number        as integer   no-undo .
     4581   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4582   define temp-table temp-diasize-handle no-undo
     4583     field handle-value  as handle
     4584     field save-position as decimal
     4585     index xpk is primary unique handle-value
     4586     .
     4587   define temp-table temp-browse-handle no-undo
     4588     field browse-type   as character
     4589     field browse-number as integer
     4590     field browse-handle as handle
     4591     field original-size as decimal
     4592     index xpk is primary unique browse-type browse-number
     4593     index xie browse-type browse-handle
     4594   .
     4595   procedure diasize_change-height :
     4596     define input  parameter p-change-value  as decimal   no-undo .
     4597     define input  parameter p-move-resize   as logical   no-undo .
     4598     define variable v-field-group-handle    as handle    no-undo .
     4599     define variable v-object-handle         as handle    no-undo .
     4600     define variable v-frame-height          as decimal   no-undo .
     4601     define variable v-frame-virtual-height  as decimal   no-undo .
     4602     define variable v-browse-height         as decimal   no-undo .
     4603     define variable v-window-height         as decimal   no-undo .
     4604     define variable v-window-virtual-height as decimal   no-undo .
     4605     define variable v-change-sign           as integer   no-undo .
     4606     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4607     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4608     if p-change-value > 0
     4609     then do:
     4610       if frame Dialog-Frame :height + p-change-value
     4611           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4612       then do:
     4613         assign
     4614           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4615                           - (frame Dialog-Frame :height-chars)
     4616         .
     4617         if p-change-value <= 0
     4618         then do:
     4619           run diasize_position-resize-button in this-procedure .
     4620           return .
     4621         end.
     4622       end.
     4623     end.
     4624     if p-change-value < 0
     4625     then do:
     4626       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4627       then do:
     4628         assign
     4629           p-change-value = v-diasize-orig-frame-height
     4630                          - (frame Dialog-Frame :height-chars)
     4631         .
     4632         if p-change-value >= 0
     4633         then do:
     4634           run diasize_position-resize-button in this-procedure .
     4635           return .
     4636         end.
     4637       end.
     4638     end.
     4639     if p-change-value >= 0
     4640     then do:
     4641       assign
     4642         v-change-sign = 1
     4643       .
     4644     end.
     4645     else do:
     4646       assign
     4647         v-change-sign = -1
     4648       .
     4649     end.
     4650     assign
     4651       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4652     .
     4653     if p-change-value = 0
     4654     then do:
     4655       run diasize_position-resize-button in this-procedure .
     4656       return .
     4657     end.
     4658     move_block:
     4659     do
     4660     on error undo move_block, retry move_block
     4661     :
     4662       if retry
     4663       then do:
     4664         do
     4665         on error undo move_block, leave move_block
     4666         :
     4667           if p-change-value > 0
     4668           then do:
     4669             for each buf_temp-diasize-handle
     4670             on error undo, next
     4671             :
     4672               assign
     4673                 v-object-handle = buf_temp-diasize-handle.handle-value
     4674               .
     4675               if v-object-handle <> v-diasize-resize-button
     4676               then do:
     4677                 assign
     4678                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4679                 .
     4680               end.
     4681             end.
     4682             assign
     4683               v-diasize-browse-handle :height = v-browse-height
     4684             .
     4685             for each buf_temp-browse-handle
     4686               where buf_temp-browse-handle.browse-type = 'height':u
     4687             on error undo, next
     4688             :
     4689               assign
     4690                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4691               .
     4692             end.
     4693             assign
     4694               frame Dialog-Frame :height = v-frame-height
     4695             .
     4696             if frame Dialog-Frame :scrollable = true
     4697             then do:
     4698               assign
     4699                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4700               .
     4701             end.
     4702             run diasize_position-resize-button in this-procedure .
     4703           end.
     4704           else do:
     4705             if frame Dialog-Frame :scrollable = true
     4706             then do:
     4707               assign
     4708                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4709               .
     4710             end.
     4711             assign
     4712               frame Dialog-Frame :height = v-frame-height
     4713             .
     4714             assign
     4715               v-diasize-browse-handle :height = v-browse-height
     4716             .
     4717             for each buf_temp-browse-handle
     4718               where buf_temp-browse-handle.browse-type = 'height':u
     4719             on error undo, next
     4720             :
     4721               assign
     4722                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4723               .
     4724             end.
     4725             for each buf_temp-diasize-handle
     4726             on error undo, next
     4727             :
     4728               assign
     4729                 v-object-handle = buf_temp-diasize-handle.handle-value
     4730               .
     4731               if v-object-handle <> v-diasize-resize-button
     4732               then do:
     4733                 assign
     4734                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4735                 .
     4736               end.
     4737             end.
     4738             run diasize_position-resize-button in this-procedure .
     4739           end.
     4740           assign
     4741             v-diasize-change-size = false
     4742           .
     4743           leave move_block .
     4744         end.
     4745       end.
     4746       assign
     4747         v-diasize-need-full-display = true
     4748       .
     4749       if v-diasize-change-size = false
     4750       then do:
     4751         assign
     4752           v-diasize-change-size = true
     4753         .
     4754       end.
     4755       else do:
     4756         return .
     4757       end.
     4758       assign
     4759         v-frame-height = frame Dialog-Frame :height
     4760         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4761         v-browse-height = v-diasize-browse-handle :height
     4762       .
     4763       for each buf_temp-browse-handle
     4764         where buf_temp-browse-handle.browse-type = 'height':u
     4765       :
     4766         assign
     4767           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4768         .
     4769       end.
     4770       for each buf_temp-diasize-handle
     4771       :
     4772         delete buf_temp-diasize-handle .
     4773       end.
     4774       assign
     4775         v-field-group-handle = frame Dialog-Frame :first-child
     4776       .
     4777       do while valid-handle(v-field-group-handle)
     4778       :
     4779         assign
     4780           v-object-handle = v-field-group-handle :first-child
     4781         .
     4782         do while valid-handle(v-object-handle)
     4783         :
     4784           if  v-object-handle <> v-diasize-browse-handle :handle
     4785           and can-query(v-object-handle, "row")
     4786           and can-query(v-object-handle, "height")
     4787           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4788           then do:
     4789             find first buf_temp-browse-handle
     4790               where buf_temp-browse-handle.browse-type   = 'height':u
     4791                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4792               no-error .
     4793             if available buf_temp-browse-handle
     4794             then do:
     4795             end.
     4796             else do:
     4797               create buf_temp-diasize-handle .
     4798               assign
     4799                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4800                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4801               .
     4802             end.
     4803           end.
     4804           assign
     4805             v-object-handle = v-object-handle :next-sibling
     4806           .
     4807         end.
     4808         assign
     4809           v-field-group-handle = v-field-group-handle :next-sibling
     4810         .
     4811       end.
     4812       do with frame Dialog-Frame
     4813       :
     4814         hide v-diasize-resize-button .
     4815         assign
     4816           v-diasize-resize-button :row    = 1
     4817           v-diasize-resize-button :column = 1
     4818         .
     4819       end.
     4820       if p-change-value > 0
     4821       then do:
     4822         if frame Dialog-Frame :scrollable = true
     4823         then do:
     4824           assign
     4825             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4826             no-error .
     4827           if error-status :error
     4828           or error-status :get-message(1) <> ""
     4829           then do:
     4830             undo move_block, retry move_block .
     4831           end.
     4832         end.
     4833         assign
     4834           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4835           no-error .
     4836         if error-status :error
     4837         or error-status :get-message(1) <> ""
     4838         then do:
     4839           undo move_block, retry move_block .
     4840         end.
     4841         assign
     4842           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4843           no-error .
     4844         if error-status :error
     4845         or error-status :get-message(1) <> ""
     4846         then do:
     4847           undo move_block, retry move_block .
     4848         end.
     4849         for each buf_temp-browse-handle
     4850           where buf_temp-browse-handle.browse-type = 'height':u
     4851         on error undo move_block, retry move_block
     4852         :
     4853           assign
     4854             buf_temp-browse-handle.browse-handle :height
     4855               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4856             no-error .
     4857           if error-status :error
     4858           or error-status :get-message(1) <> ""
     4859           then do:
     4860             undo move_block, retry move_block .
     4861           end.
     4862         end.
     4863         for each buf_temp-diasize-handle
     4864         on error undo move_block, retry move_block
     4865         :
     4866           assign
     4867             v-object-handle = buf_temp-diasize-handle.handle-value
     4868           .
     4869           if v-object-handle <> v-diasize-resize-button
     4870           then do:
     4871             assign
     4872               v-object-handle :row = v-object-handle :row + p-change-value
     4873               no-error .
     4874             if error-status :error
     4875             or error-status :get-message(1) <> ""
     4876             then do:
     4877               undo move_block, retry move_block .
     4878             end.
     4879           end.
     4880         end.
     4881       end.
     4882       else do:
     4883         for each buf_temp-diasize-handle
     4884         on error undo move_block, retry move_block
     4885         :
     4886           assign
     4887             v-object-handle = buf_temp-diasize-handle.handle-value
     4888           .
     4889           if v-object-handle <> v-diasize-resize-button
     4890           then do:
     4891             assign
     4892               v-object-handle :row = v-object-handle :row + p-change-value
     4893               no-error .
     4894             if error-status :error
     4895             or error-status :get-message(1) <> ""
     4896             then do:
     4897               undo move_block, retry move_block .
     4898             end.
     4899           end.
     4900         end.
     4901         assign
     4902           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4903           no-error .
     4904         if error-status :error
     4905         or error-status :get-message(1) <> ""
     4906         then do:
     4907           undo move_block, retry move_block .
     4908         end.
     4909         for each buf_temp-browse-handle
     4910           where buf_temp-browse-handle.browse-type = 'height':u
     4911         on error undo move_block, retry move_block
     4912         :
     4913           assign
     4914             buf_temp-browse-handle.browse-handle :height
     4915               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4916             no-error .
     4917           if error-status :error
     4918           or error-status :get-message(1) <> ""
     4919           then do:
     4920             undo move_block, retry move_block .
     4921           end.
     4922         end.
     4923         assign
     4924           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4925           no-error .
     4926         if error-status :error
     4927         or error-status :get-message(1) <> ""
     4928         then do:
     4929           undo move_block, retry move_block .
     4930         end.
     4931         if frame Dialog-Frame :scrollable = true
     4932         then do:
     4933           assign
     4934             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4935             no-error .
     4936           if error-status :error
     4937           or error-status :get-message(1) <> ""
     4938           then do:
     4939             undo move_block, retry move_block .
     4940           end.
     4941         end.
     4942       end.
     4943       if p-move-resize = true
     4944       then do:
     4945         run diasize_position-resize-button in this-procedure .
     4946       end.
     4947       if v-diasize-wndstore = true
     4948       then do:
     4949         if connected("ub") = true
     4950         then do:
     4951           define variable v-cntxt-db-num        as integer   no-undo .
     4952           define variable v-cntxt-userid        as character no-undo .
     4953           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4954                                             , OUTPUT v-cntxt-userid
     4955                                             ) .
     4956           run gbl/wndsizew.p
     4957             (input  v-cntxt-db-num
     4958             ,input  v-cntxt-userid
     4959             ,input  v-diasize-proc-name
     4960             ,input  'height':u
     4961             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4962             ) .
     4963         end.
     4964       end.
     4965     end.
     4966     assign
     4967       v-diasize-change-size = false
     4968     .
     4969   end procedure.
     4970   procedure diasize_set-height :
     4971     define input  parameter p-new-height  as decimal   no-undo .
     4972     define input  parameter p-move-resize as logical   no-undo .
     4973     do
     4974     on error undo, return error return-value
     4975     :
     4976       run diasize_change-height in this-procedure
     4977         (input  (p-new-height - frame Dialog-Frame :height)
     4978         ,input  p-move-resize
     4979         ) .
     4980     end.
     4981   end procedure.
     4982   procedure diasize_change-width :
     4983     define input  parameter p-change-value as decimal   no-undo .
     4984     define input  parameter p-move-resize  as logical   no-undo .
     4985     define variable v-field-group-handle   as handle    no-undo .
     4986     define variable v-object-handle        as handle    no-undo .
     4987     define variable v-frame-width          as decimal   no-undo .
     4988     define variable v-frame-virtual-width  as decimal   no-undo .
     4989     define variable v-browse-width         as decimal   no-undo .
     4990     define variable v-window-width         as decimal   no-undo .
     4991     define variable v-window-virtual-width as decimal   no-undo .
     4992     define variable v-change-sign          as integer   no-undo .
     4993     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4994     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4995     if p-change-value > 0
     4996     then do:
     4997       if frame Dialog-Frame :width + p-change-value >
     4998           session :width-chars
     4999       then do:
     5000         assign
     5001           p-change-value = session :width-chars - frame Dialog-Frame :width
     5002         .
     5003         if p-change-value <= 0
     5004         then do:
     5005           run diasize_position-resize-button in this-procedure .
     5006           return .
     5007         end.
     5008       end.
     5009     end.
     5010     if p-change-value < 0
     5011     then do:
     5012       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5013       then do:
     5014         assign
     5015           p-change-value = v-diasize-orig-frame-width
     5016                          - frame Dialog-Frame :width
     5017         .
     5018         if p-change-value >= 0
     5019         then do:
     5020           run diasize_position-resize-button in this-procedure .
     5021           return .
     5022         end.
     5023       end.
     5024     end.
     5025     if p-change-value >= 0
     5026     then do:
     5027       assign
     5028         v-change-sign = 1
     5029       .
     5030     end.
     5031     else do:
     5032       assign
     5033         v-change-sign = -1
     5034       .
     5035     end.
     5036     assign
     5037       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5038     .
     5039     if p-change-value = 0
     5040     then do:
     5041       run diasize_position-resize-button in this-procedure .
     5042       return .
     5043     end.
     5044     move_block:
     5045     do
     5046     on error undo move_block, leave move_block
     5047     :
     5048       if retry
     5049       then do:
     5050         do
     5051         on error undo move_block, leave move_block
     5052         :
     5053           if p-change-value > 0
     5054           then do:
     5055             for each buf_temp-diasize-handle
     5056             on error undo, next
     5057             :
     5058               assign
     5059                 v-object-handle = buf_temp-diasize-handle.handle-value
     5060               .
     5061               if v-object-handle <> v-diasize-resize-button
     5062               then do:
     5063                 assign
     5064                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5065                 .
     5066               end.
     5067             end.
     5068             assign
     5069               v-diasize-browse-handle :width = v-browse-width
     5070             .
     5071             for each buf_temp-browse-handle
     5072               where buf_temp-browse-handle.browse-type = 'width':u
     5073             on error undo, next
     5074             :
     5075               assign
     5076                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5077               .
     5078             end.
     5079             assign
     5080               frame Dialog-Frame :width = v-frame-width
     5081             .
     5082             if frame Dialog-Frame :scrollable = true
     5083             then do:
     5084               assign
     5085                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5086               .
     5087             end.
     5088             run diasize_position-resize-button in this-procedure .
     5089           end.
     5090           else do:
     5091             if frame Dialog-Frame :scrollable = true
     5092             then do:
     5093               assign
     5094                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5095               .
     5096             end.
     5097             assign
     5098               frame Dialog-Frame :width = v-frame-width
     5099             .
     5100             for each buf_temp-browse-handle
     5101               where buf_temp-browse-handle.browse-type = 'width':u
     5102             on error undo, next
     5103             :
     5104               assign
     5105                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5106               .
     5107             end.
     5108             assign
     5109               v-diasize-browse-handle :width = v-browse-width
     5110             .
     5111             for each buf_temp-diasize-handle
     5112             on error undo, next
     5113             :
     5114               assign
     5115                 v-object-handle = buf_temp-diasize-handle.handle-value
     5116               .
     5117               if v-object-handle <> v-diasize-resize-button
     5118               then do:
     5119                 assign
     5120                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5121                 .
     5122               end.
     5123             end.
     5124             run diasize_position-resize-button in this-procedure .
     5125           end.
     5126           assign
     5127             v-diasize-change-size = false
     5128           .
     5129           leave move_block .
     5130         end.
     5131       end.
     5132       assign
     5133         v-diasize-need-full-display = true
     5134       .
     5135       if v-diasize-change-size = false
     5136       then do:
     5137         assign
     5138           v-diasize-change-size = true
     5139         .
     5140       end.
     5141       else do:
     5142         return .
     5143       end.
     5144       assign
     5145         v-frame-width = frame Dialog-Frame :width
     5146         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5147         v-browse-width = v-diasize-browse-handle :width
     5148       .
     5149       for each buf_temp-browse-handle
     5150         where buf_temp-browse-handle.browse-type = 'width':u
     5151       :
     5152         assign
     5153           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5154         .
     5155       end.
     5156       for each buf_temp-diasize-handle
     5157       :
     5158         delete buf_temp-diasize-handle .
     5159       end.
     5160       assign
     5161         v-field-group-handle = frame Dialog-Frame :first-child
     5162       .
     5163       do while valid-handle(v-field-group-handle)
     5164       :
     5165         assign
     5166           v-object-handle = v-field-group-handle :first-child
     5167         .
     5168         do while valid-handle(v-object-handle)
     5169         :
     5170           if  v-object-handle <> v-diasize-browse-handle :handle
     5171           and v-object-handle <> v-diasize-resize-button
     5172           and can-query(v-object-handle, "row")
     5173           and can-query(v-object-handle, "height")
     5174           and ( v-object-handle :col + v-object-handle :width
     5175                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5176               )
     5177           then do:
     5178             find first buf_temp-browse-handle
     5179               where buf_temp-browse-handle.browse-type   = 'width':u
     5180                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5181               no-error .
     5182             if available buf_temp-browse-handle
     5183             then do:
     5184             end.
     5185             else do:
     5186               create buf_temp-diasize-handle .
     5187               assign
     5188                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5189                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5190               .
     5191             end.
     5192           end.
     5193           assign
     5194             v-object-handle = v-object-handle :next-sibling
     5195           .
     5196         end.
     5197         assign
     5198           v-field-group-handle = v-field-group-handle :next-sibling
     5199         .
     5200       end.
     5201       do with frame Dialog-Frame
     5202       :
     5203         hide v-diasize-resize-button .
     5204         v-diasize-resize-button :row = 1.
     5205         v-diasize-resize-button :column = 1.
     5206       end.
     5207       if p-change-value > 0
     5208       then do:
     5209         if frame Dialog-Frame :scrollable = true
     5210         then do:
     5211           assign
     5212             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5213             no-error .
     5214           if error-status :error
     5215           or error-status :get-message(1) <> ""
     5216           then do:
     5217             undo move_block, retry move_block.
     5218           end.
     5219         end.
     5220         assign
     5221           frame Dialog-Frame :width = v-frame-width + p-change-value
     5222           no-error .
     5223         if error-status :error
     5224         or error-status :get-message(1) <> ""
     5225         then do:
     5226           undo move_block, retry move_block.
     5227         end.
     5228         assign
     5229           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5230         no-error .
     5231         if error-status :error
     5232         or error-status :get-message(1) <> ""
     5233         then do:
     5234           undo move_block, retry move_block.
     5235         end.
     5236         for each buf_temp-browse-handle
     5237           where buf_temp-browse-handle.browse-type = 'width':u
     5238         on error undo move_block, retry move_block
     5239         :
     5240           assign
     5241             buf_temp-browse-handle.browse-handle :width
     5242               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5243             no-error .
     5244           if error-status :error
     5245           or error-status :get-message(1) <> ""
     5246           then do:
     5247             undo move_block, retry move_block .
     5248           end.
     5249         end.
     5250         for each buf_temp-diasize-handle
     5251         on error undo move_block, retry move_block
     5252         :
     5253           assign
     5254             v-object-handle = buf_temp-diasize-handle.handle-value
     5255           .
     5256           if v-object-handle <> v-diasize-resize-button
     5257           then do:
     5258             assign
     5259               v-object-handle :col = v-object-handle :col + p-change-value
     5260               no-error .
     5261             if error-status :error
     5262             or error-status :get-message(1) <> ""
     5263             then do:
     5264               undo move_block, retry move_block .
     5265             end.
     5266           end.
     5267         end.
     5268       end.
     5269       else do:
     5270         for each buf_temp-diasize-handle
     5271         on error undo move_block, retry move_block
     5272         :
     5273           assign
     5274             v-object-handle = buf_temp-diasize-handle.handle-value
     5275           .
     5276           if v-object-handle <> v-diasize-resize-button
     5277           then do:
     5278             assign
     5279               v-object-handle :col = v-object-handle :col + p-change-value
     5280               no-error .
     5281             if error-status :error
     5282             or error-status :get-message(1) <> ""
     5283             then do:
     5284               undo move_block, retry move_block .
     5285             end.
     5286           end.
     5287         end.
     5288         for each buf_temp-browse-handle
     5289           where buf_temp-browse-handle.browse-type = 'width':u
     5290         on error undo move_block, retry move_block
     5291         :
     5292           assign
     5293             buf_temp-browse-handle.browse-handle :width
     5294               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5295             no-error .
     5296           if error-status :error
     5297           or error-status :get-message(1) <> ""
     5298           then do:
     5299             undo move_block, retry move_block .
     5300           end.
     5301         end.
     5302         assign
     5303           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5304           no-error .
     5305         if error-status :error
     5306         or error-status :get-message(1) <> ""
     5307         then do:
     5308           undo move_block, retry move_block.
     5309         end.
     5310         assign
     5311           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5312         no-error .
     5313         if error-status :error
     5314         or error-status :get-message(1) <> ""
     5315         then do:
     5316           undo move_block, retry move_block.
     5317         end.
     5318         if frame Dialog-Frame :scrollable = true
     5319         then do:
     5320           assign
     5321             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5322           no-error .
     5323           if error-status :error
     5324           or error-status :get-message(1) <> ""
     5325           then do:
     5326             undo move_block, retry move_block.
     5327           end.
     5328         end.
     5329       end.
     5330       if p-move-resize
     5331       then do:
     5332         run diasize_position-resize-button in this-procedure .
     5333       end.
     5334       if v-diasize-wndstore = true
     5335       then do:
     5336         if connected("ub") = true
     5337         then do:
     5338           define variable v-cntxt-db-num        as integer   no-undo .
     5339           define variable v-cntxt-userid        as character no-undo .
     5340           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5341                                             , OUTPUT v-cntxt-userid
     5342                                             ) .
     5343           run gbl/wndsizew.p
     5344             (input  v-cntxt-db-num
     5345             ,input  v-cntxt-userid
     5346             ,input  v-diasize-proc-name
     5347             ,input  'width':u
     5348             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5349             ) .
     5350         end.
     5351       end.
     5352     end.
     5353     assign
     5354       v-diasize-change-size = false
     5355     .
     5356   end procedure.
     5357   procedure diasize_set-width :
     5358     define input  parameter p-new-width  as decimal   no-undo .
     5359     define input  parameter p-move-resize as logical   no-undo .
     5360     do
     5361     on error undo, return error return-value
     5362     :
     5363       run diasize_change-width in this-procedure
     5364         (input  (p-new-width - frame Dialog-Frame :width)
     5365         ,input  p-move-resize
     5366         ) .
     5367     end.
     5368   end procedure.
     5369   procedure diasize_position-resize-button :
     5370     do with frame Dialog-Frame
     5371     :
     5372       hide v-diasize-resize-button .
     5373       assign
     5374         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5375                     - 1
     5376                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5377         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5378                     - 1
     5379                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5380       .
     5381       view v-diasize-resize-button .
     5382     end.
     5383   end procedure.
     5384   on alt-right anywhere
     5385   do:
     5386     run diasize_change-width in this-procedure
     5387       (input 1
     5388       ,input true
     5389       ) .
     5390     return no-apply .
     5391   end.
     5392   on alt-left anywhere
     5393   do:
     5394     run diasize_change-width in this-procedure
     5395       (input -1
     5396       ,input true
     5397       ) .
     5398     return no-apply .
     5399   end.
     5400   on alt-down anywhere
     5401   do:
     5402     run diasize_change-height in this-procedure
     5403       (input 1
     5404       ,input true
     5405       ) .
     5406     return no-apply .
     5407   end.
     5408   on alt-up anywhere
     5409   do:
     5410     run diasize_change-height in this-procedure
     5411       (input -1
     5412       ,input true
     5413       ) .
     5414     return no-apply .
     5415   end.
     5416   on alt-enter of frame Dialog-Frame
     5417   do:
     5418     run diasize_maximize in this-procedure
     5419       (input  ?
     5420       ).
     5421     return no-apply .
     5422   end.
     5423   procedure diasize_end-move :
     5424     do
     5425     on error undo, return error return-value
     5426     :
     5427       define variable v-row-delta as decimal   no-undo .
     5428       define variable v-col-delta as decimal   no-undo .
     5429       define variable v-new-row as decimal   no-undo .
     5430       define variable v-new-col as decimal   no-undo .
     5431       assign
     5432         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5433         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5434       .
     5435       assign
     5436         v-row-delta = v-new-row - frame Dialog-Frame :height
     5437         v-col-delta = v-new-col - frame Dialog-Frame :width
     5438       .
     5439       run diasize_change-height in this-procedure
     5440         (input v-row-delta
     5441         ,input true
     5442         ) .
     5443       run diasize_change-width in this-procedure
     5444         (input v-col-delta
     5445         ,input true
     5446         ) .
     5447     end.
     5448   end procedure.
     5449   procedure diasize_maximize :
     5450     define input  parameter p-action as logical   no-undo .
     5451     do
     5452     on error undo, return error return-value
     5453     :
     5454       if p-action = ?
     5455       then do:
     5456         if v-diasize-need-maximize = true
     5457         then do:
     5458           assign
     5459             p-action = true
     5460           .
     5461         end.
     5462         else do:
     5463           assign
     5464             p-action = false
     5465           .
     5466         end.
     5467       end.
     5468       if p-action = true
     5469       then do:
     5470         run diasize_change-height in this-procedure
     5471           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5472               - frame Dialog-Frame :height-chars
     5473           ,input true
     5474           ) .
     5475         run diasize_change-width in this-procedure
     5476           (input session :width-chars
     5477               - frame Dialog-Frame :width-chars
     5478           ,input true
     5479           ) .
     5480         assign
     5481           v-diasize-need-maximize = false
     5482         .
     5483       end.
     5484       else do:
     5485         run diasize_change-width in this-procedure
     5486           (input v-diasize-orig-frame-width
     5487               - frame Dialog-Frame :width-chars
     5488           ,input true
     5489           ) .
     5490         run diasize_change-height in this-procedure
     5491           (input v-diasize-orig-frame-height
     5492               - frame Dialog-Frame :height-chars
     5493           ,input true
     5494           ) .
     5495         assign
     5496           v-diasize-need-maximize = true
     5497         .
     5498       end.
     5499     end.
     5500   end procedure.
     5501   procedure diasize_restore-orig-size :
     5502     do
     5503     on error undo, return error return-value
     5504     :
     5505       assign
     5506         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5507         v-diasize-current-frame-height = frame Dialog-Frame :height
     5508       .
     5509       run diasize_set-height in this-procedure
     5510         (input  v-diasize-orig-frame-height
     5511         ,input  true
     5512         ) .
     5513       run diasize_set-width in this-procedure
     5514         (input  v-diasize-orig-frame-width
     5515         ,input  true
     5516         ) .
     5517     end.
     5518   end procedure.
     5519   procedure diasize_restore-current-size :
     5520     do
     5521     on error undo, return error return-value
     5522     :
     5523       run diasize_set-height in this-procedure
     5524         (input  v-diasize-current-frame-height
     5525         ,input  true
     5526         ) .
     5527       run diasize_set-width in this-procedure
     5528         (input  v-diasize-current-frame-width
     5529         ,input  true
     5530         ) .
     5531     end.
     5532   end procedure.
     5533   procedure diasize_set-browse-handle :
     5534     define input  parameter p-browse-handle as handle   no-undo .
     5535     define buffer buf_temp-browse-handle for temp-browse-handle .
     5536     do
     5537     on error undo, return error return-value
     5538     :
     5539       assign
     5540         v-diasize-browse-handle = p-browse-handle
     5541       .
     5542       for each buf_temp-browse-handle
     5543       on error undo, return error return-value
     5544       :
     5545         delete buf_temp-browse-handle .
     5546       end.
     5547     end.
     5548   end procedure.
     5549   procedure diasize_add_browse :
     5550     define input  parameter p-browse-type   as character no-undo .
     5551     define input  parameter p-browse-handle as handle    no-undo .
     5552     define buffer buf_temp-browse-handle for temp-browse-handle .
     5553     do
     5554     on error undo, return error return-value
     5555     :
     5556       assign
     5557         v-diasize-browse-number = v-diasize-browse-number + 1
     5558       .
     5559       create buf_temp-browse-handle .
     5560       assign
     5561         buf_temp-browse-handle.browse-type   = p-browse-type
     5562         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5563         buf_temp-browse-handle.browse-handle = p-browse-handle
     5564       .
     5565     end.
     5566   end procedure.
     5567   procedure diasize_init :
     5568     define variable v-default-value    as logical   no-undo .
     5569     define variable v-restore-saved    as logical   no-undo .
     5570     define variable v-resize-value-str as character no-undo .
     5571     do
     5572     on error undo, return error return-value
     5573     :
     5574       do with frame Dialog-Frame
     5575       :
     5576         assign
     5577           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5578           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5579           v-diasize-browse-handle     = browse br-list :handle
     5580         .
     5581         create button v-diasize-resize-button
     5582         assign
     5583           parent        = frame Dialog-Frame :first-child
     5584           label         = "s"
     5585           height-pixels = 16
     5586           width-pixels  = 16
     5587           visible       = true
     5588           sensitive     = true
     5589           movable       = true
     5590           triggers:
     5591             on end-move persistent run diasize_end-move in this-procedure .
     5592           end triggers.
     5593         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5594         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5595         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5596         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5597         assign
     5598           v-diasize-wndmax = false
     5599         .
     5600         if connected("ub") = true
     5601         then do:
     5602           define variable v-cntxt-db-num        as integer   no-undo .
     5603           define variable v-cntxt-userid        as character no-undo .
     5604           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5605                                             , OUTPUT v-cntxt-userid
     5606                                             ) .
     5607           run gbl/wndpar_r.p
     5608             (input  v-cntxt-db-num
     5609             ,input  v-cntxt-userid
     5610             ,input  'wndmax':U
     5611             ,output v-diasize-wndmax
     5612             ,output v-default-value
     5613             ) .
     5614         end.
     5615         assign
     5616           v-diasize-wndstore = false
     5617         .
     5618         if connected("ub") = true
     5619         then do:
     5620           run gbl/wndpar_r.p
     5621             (input  v-cntxt-db-num
     5622             ,input  v-cntxt-userid
     5623             ,input  'wndstore':U
     5624             ,output v-diasize-wndstore
     5625             ,output v-default-value
     5626             ) .
     5627         end.
     5628         assign
     5629           v-diasize-proc-name = entry(1, program-name(2), '.')
     5630         .
     5631         if v-diasize-wndstore = true
     5632         then do:
     5633           assign
     5634             v-restore-saved = false
     5635           .
     5636           if connected("ub") = true
     5637           then do:
     5638             run gbl/wndsizer.p
     5639               (input  v-cntxt-db-num
     5640               ,input  v-cntxt-userid
     5641               ,input  v-diasize-proc-name
     5642               ,input  'height':u
     5643               ,output v-resize-value-str
     5644               ) .
     5645             if v-resize-value-str <> '':U
     5646             then do:
     5647               run diasize_change-height in this-procedure
     5648                 (input  integer(v-resize-value-str)
     5649                 ,input  true
     5650                 ) .
     5651               assign
     5652                 v-restore-saved = true
     5653               .
     5654             end.
     5655           end.
     5656           if connected("ub") = true
     5657           then do:
     5658             run gbl/wndsizer.p
     5659               (input  v-cntxt-db-num
     5660               ,input  v-cntxt-userid
     5661               ,input  v-diasize-proc-name
     5662               ,input  'width':u
     5663               ,output v-resize-value-str
     5664               ) .
     5665             if v-resize-value-str <> '':U
     5666             then do:
     5667               run diasize_change-width in this-procedure
     5668                 (input  integer(v-resize-value-str)
     5669                 ,input  true
     5670                 ) .
     5671               assign
     5672                 v-restore-saved = true
     5673               .
     5674             end.
     5675           end.
     5676           if v-restore-saved <> true
     5677           then do:
     5678             if v-diasize-wndmax = true
     5679             then do:
     5680               run diasize_maximize in this-procedure
     5681                 (input  true
     5682                 ) .
     5683             end.
     5684           end.
     5685         end.
     5686         else do:
     5687           if v-diasize-wndmax = true
     5688           then do:
     5689             run diasize_maximize in this-procedure
     5690               (input  true
     5691               ) .
     5692           end.
     5693         end.
     5694       end.
     5695     end.
     5696   end procedure.
     5697   procedure diasize_need-full-display :
     5698     define output parameter p-need-full-display as logical   no-undo .
     5699     do
     5700     on error undo, return error return-value
     5701     :
     5702       assign
     5703         p-need-full-display = v-diasize-need-full-display
     5704       .
     5705       assign
     5706         v-diasize-need-full-display = false
     5707       .
     5708     end.
     5709   end procedure.
     5710   procedure get-context :
     5711      define output parameter p-db-num as integer          no-undo.
     5712      define output parameter p-user-id as character        no-undo.
     5713      define variable v-login               as character    no-undo.
     5714      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5715      define buffer buf_user-login  for ub.user-login .
     5716      do
     5717      on error undo, return error
     5718      :
     5719            FIND FIRST buf_sys-ctrl no-lock.
     5720            ASSIGN
     5721               v-login = USERID("ub")
     5722               p-db-num = buf_sys-ctrl.db-num
     5723            .
     5724            FIND FIRST buf_user-login
     5725                 WHERE buf_user-login.db-num = p-db-num
     5726                   AND buf_user-login.user-login = v-login
     5727                 no-lock
     5728                 no-error
     5729                 .
     5730            IF AVAILABLE buf_user-login
     5731            THEN DO:
     5732               assign
     5733                  p-user-id = buf_user-login.user-id
     5734               .
     5735            END.
     5736      end.
     5737   end procedure.
     5738   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5739   on help of frame Dialog-Frame
     5740   do:
     5741     run gbl/app_help.p
     5742       (input this-procedure :file-name
     5743       ,input ''
     5744       ,input ?
     5745       ) no-error.
     5746     if error-status :error then do:
     5747       message
     5748         "Ошибка при вызове помощи"
     5749         error-status :get-message(1)
     5750         view-as alert-box .
     5751     end.
     5752   end.
     5753   run minbtn-set in this-procedure .
     5754   on choose of b-help in frame Dialog-Frame
     5755   do:
     5756     apply "help":u to frame Dialog-Frame .
     5757   end.
     5758   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5759   procedure minbtn-set :
     5760       do
     5761           on error undo, return error return-value
     5762           :
     5763           define variable ii              as integer       no-undo .
     5764           define variable fh              as widget-handle no-undo .
     5765           define variable hh              as widget-handle no-undo .
     5766           define variable v-h             as handle        extent 4 no-undo .
     5767           define variable v-name-button   as character     no-undo .
     5768           define variable v-help-old-x    as decimal       no-undo .
     5769           define variable v-help-old-y    as decimal       no-undo .
     5770           define variable v-help-old-size as decimal       no-undo .
     5771           define variable v-frame-width   as decimal       no-undo .
     5772           define variable jj              as integer       no-undo .
     5773           do
     5774               on error undo, return error
     5775               :
     5776               assign
     5777                   v-frame-width = frame Dialog-Frame:width - 0.3
     5778                   fh            = frame Dialog-Frame:first-child
     5779                   hh            = fh:first-child
     5780                   ii            = 1
     5781                   .
     5782               do while valid-handle(hh):
     5783                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5784                   do:
     5785                       case lc(hh:name) :
     5786                           when "b-help" then
     5787                               do:
     5788                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5789                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5790                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5791                                   hh:TOOLTIP = "Помощь" .
     5792                                   v-help-old-x = hh:column .
     5793                                   v-help-old-y = hh:row    .
     5794                                   v-help-old-size = hh:width .
     5795                                   hh:width-chars = 2.5 .
     5796                               end.
     5797                           when "b-print" then
     5798                               do:
     5799                                   hh:load-image("cmp/b-print.bmp":u) .
     5800                                   hh:TOOLTIP = "Печать" .
     5801                                   v-h[ii] = hh:handle .
     5802                                   ii = ii + 1 .
     5803                                   hh:width-chars = 3 .
     5804                               end.
     5805                           when "b-history" or
     5806                           when "b-hist" then
     5807                               do:
     5808                                   hh:load-image("cmp/b-hist.bmp":u) .
     5809                                   hh:TOOLTIP = "История" .
     5810                                   v-h[ii] = hh:handle .
     5811                                   ii = ii + 1 .
     5812                                   hh:width-chars = 3 .
     5813                               end.
     5814                           when "b-sch" then
     5815                               do:
     5816                                   hh:load-image("cmp/b-sch.bmp":u) .
     5817                                   hh:TOOLTIP = "Установка Фильтра" .
     5818                                   v-h[ii] = hh:handle .
     5819                                   ii = ii + 1 .
     5820                                   hh:width-chars = 3 .
     5821                               end.
     5822                           when "b-hist-user" then
     5823                               do:
     5824                                   hh:load-image("cmp/b-hist.bmp":u) .
     5825                                   hh:TOOLTIP = "История пользователя" .
     5826                                   ii = ii + 1 .
     5827                               end.
     5828                       end case.
     5829                   end.
     5830                   hh = hh:next-sibling.
     5831               end.
     5832               b-help:column = v-frame-width - b-help:width-chars.
     5833               jj = 0.
     5834               repeat ii = 4 to 1 by -1 :
     5835                   if valid-handle (v-h[ii] ) then
     5836                   do:
     5837                       jj  = jj + 1 .
     5838                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5839                       v-h[ii]:row    = v-help-old-y .
     5840                   end.
     5841               end.
     5842           end.
     5843       end.
     5844   end procedure.
     5845   run diasize_init in this-procedure .
     5846   def var vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5847   def var vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5848   define variable v-no-context as logical no-undo .
     5849   define variable v-user-obj-type as character no-undo .
     5850   define variable v-user-obj-code as integer no-undo .
     5851   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5852                                            , input p-no-context as logical ):
     5853   define variable v-uniq-key-rec as character no-undo .
     5854   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5855     v-uniq-key-rec = 'clients':U + chr(3) +
     5856                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5857                     entry(5, p-uniq-key-rec, chr(3)).
     5858   end.
     5859   else do:
     5860     v-uniq-key-rec = p-uniq-key-rec.
     5861     case entry(1, p-uniq-key-rec, chr(3)):
     5862        when 'user-obj':U then do:
     5863          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5864          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5865        end.
     5866     end case.
     5867   end.
     5868   return v-uniq-key-rec.
     5869   end function.
     5870   procedure find-user-obj-rowid :
     5871   define input parameter p-rowid as rowid no-undo .
     5872   define input parameter p-no-context as logical no-undo .
     5873   define output parameter p-user-obj-type as character no-undo .
     5874   define output parameter p-user-obj-code as integer no-undo .
     5875   define buffer user-obj_clients for ub.clients.
     5876   define buffer user-obj_user-obj for ub.user-obj .
     5877   if p-no-context then do:
     5878     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5879     assign
     5880     p-user-obj-type = user-obj_clients.obj-type
     5881     p-user-obj-code = user-obj_clients.obj-code.
     5882   end.
     5883   else do:
     5884     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5885     if not available user-obj_user-obj then do:
     5886       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5887     end.
     5888     assign
     5889     p-user-obj-type = user-obj_user-obj.obj-type
     5890     p-user-obj-code = user-obj_user-obj.obj-code.
     5891   end.
     5892   end procedure.
     5893   define variable an-listp-start-macro-id as integer no-undo init ?.
     5894   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5895   define variable an-listp-macros-label-id as integer   no-undo .
     5896   define variable v-macro-is-running as logical no-undo .
     5897   define variable v-current-step as integer no-undo .
     5898   define variable v-expand as logical no-undo .
     5899   define variable v-downed as character no-undo .
     5900   define variable p-title as character no-undo .
     5901   define variable bttns as character no-undo .
     5902   define variable p-keep-query as logical no-undo .
     5903   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5904   define     temp-table keep-macro-list-hist no-undo
     5905   field list-table as character
     5906   field id as integer
     5907   field line as integer
     5908   field hist-mode as character
     5909   field des as character
     5910   field num-recs as integer
     5911   field option_ as character
     5912   field item_ as character
     5913   field status_ as character
     5914   field num-add as integer
     5915   field num-ignored as integer
     5916   field done as logical
     5917   field err_ as logical
     5918   field err-mes as character
     5919   index pi is primary
     5920   id
     5921   line
     5922   index isdone
     5923   done
     5924   .
     5925   procedure assign-nums :
     5926   define input-output parameter p-num-add as integer no-undo .
     5927   define input-output parameter p-num-rec as integer no-undo .
     5928   define input-output parameter p-num-ignored as integer no-undo .
     5929   define input parameter p-line-mode as character no-undo .
     5930   assign
     5931   p-num-add  = lns-cnt - v-num-add
     5932   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5933                             then (tot-lns + p-num-add)
     5934                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5935   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5936   p-num-ignored = lns-ignore  - v-num-ignored
     5937   v-num-add             = lns-cnt
     5938   v-num-ignored         = lns-ignore
     5939   .
     5940   END PROCEDURE.
     5941   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5942   or INSERT-MODE of br-list
     5943   DO:
     5944   define variable glog as logical no-undo .
     5945   define buffer buf-bb-list-hist for bb-list-hist.
     5946   define buffer buf_macro-list-hist for macro-list-hist.
     5947   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5948    if p-keep-query then do:
     5949       glog = no.
     5950       message "Реинициализация списка. Вы уверены ?"
     5951               view-as alert-box question buttons OK-Cancel update glog.
     5952       if not glog then return no-apply.
     5953       if session:set-wait-state( "COMPILER" )  then .
     5954       for each bb-list:
     5955         delete bb-list.
     5956       end.
     5957       if session:set-wait-state( "" )  then .
     5958       tot-lns = 0.
     5959       v-seq = 1.
     5960       for each buf-bb-list-hist:
     5961         delete buf-bb-list-hist.
     5962       end.
     5963      for each buf_keep-macro-list-hist:
     5964        create buf_macro-list-hist.
     5965      end.
     5966      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5967      run create-bb-list-hist in this-procedure (
     5968                                             input 'ДОБАВЛЕНИЕ':U
     5969                                           , input-output v-seq
     5970                                           , input 0
     5971                                           , input '0':U
     5972                                           , input "# Реинициализация списка."
     5973                                           , input 0
     5974                                           , input "init"
     5975                                           , input '':U
     5976                                           , input '':U
     5977                                           , input '':U
     5978                                           , input ?
     5979                                           ).
     5980       display
     5981       tot-lns @ f-tot-lns
     5982       with frame Dialog-Frame.
     5983       run ui-on in this-procedure .
     5984    end.
     5985    else do:
     5986      assign rs-list-method = "single".
     5987      run proc-b-add in this-procedure(input no
     5988                                     ,input ?
     5989                                     ,input rs-list-method
     5990                                     ,input rs-status)  no-error .
     5991     if error-status:error then return no-apply.
     5992   end.
     5993   END.
     5994   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5995   or DELETE-CHARACTER of br-list
     5996   DO:
     5997     if not available bb-list then return no-apply.
     5998     assign rs-list-method = "single".
     5999     run proc-b-del in this-procedure(no, ?, (rs-list-method + chr(4) +
     6000                                              (if bb-list.b-str <> '':U and not bb-list.loc-ean
     6001                                              then 'prod-bc':U
     6002                                              else (if bb-list.loc-ean
     6003                                                    then 'loc-ean':U
     6004                                                    else 'bar-code':U)
     6005                                              )
     6006                                              )
     6007     , rs-status) no-error.
     6008     if error-status:error then return no-apply.
     6009   END.
     6010   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     6011   DO:
     6012   if not available bb-list then return no-apply.
     6013     assign rs-list-method = "single".
     6014     run proc-b-rest in this-procedure(no, ?, (rs-list-method + chr(4) +
     6015                                              (if bb-list.b-str <> '':U and not bb-list.loc-ean
     6016                                              then 'prod-bc':U
     6017                                              else (if bb-list.loc-ean
     6018                                                    then 'loc-ean':U
     6019                                                    else 'bar-code':U)
     6020                                              )
     6021                                              )
     6022     , rs-status) no-error.
     6023     if error-status:error then return no-apply.
     6024   END.
     6025   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     6026   DO:
     6027   run proc-b-macro in this-procedure ( input 'file') no-error .
     6028   if error-status:error then return no-apply.
     6029   END.
     6030   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     6031   DO:
     6032   define variable glog as logical no-undo .
     6033   message
     6034   "Начать запись макроса формирования списка?"
     6035   view-as alert-box QUESTION buttons yes-no update glog.
     6036   if not glog then return no-apply.
     6037   assign
     6038   an-listp-start-macro-id = v-seq
     6039   an-listp-end-macro-id = ?
     6040   .
     6041   disable
     6042   b-record with frame Dialog-Frame .
     6043   hide
     6044   b-record
     6045   b-macro
     6046   in frame Dialog-Frame .
     6047   enable
     6048   b-stop with frame Dialog-Frame .
     6049   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6050                                       , input-output v-seq
     6051                                       , input 0
     6052                                       , input 'o':U
     6053                                       , input "Начата запись макроса формирования списка"
     6054                                       , input tot-lns
     6055                                       , input 'macro':U
     6056                                       , input '':U
     6057                                       , input '':U
     6058                                       , input '':U
     6059                                       , input ?
     6060                                       ).
     6061   END.
     6062   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     6063   DO:
     6064   define variable glog as logical no-undo .
     6065   define variable v-id as integer no-undo .
     6066   define buffer buf_bb-list-hist for bb-list-hist.
     6067   message
     6068   "Закончить запись макроса формирования списка?"
     6069   view-as alert-box QUESTION buttons yes-no update glog.
     6070   if not glog then return no-apply.
     6071   assign
     6072   an-listp-end-macro-id = v-seq.
     6073   disable
     6074   b-stop with frame Dialog-Frame .
     6075   hide
     6076   b-stop in frame Dialog-Frame .
     6077   enable
     6078   b-record
     6079   b-macro
     6080   with frame Dialog-Frame .
     6081   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6082                                       , input-output v-seq
     6083                                       , input 0
     6084                                       , input '[]':U
     6085                                       , input "Закончена запись макроса формирования списка"
     6086                                       , input tot-lns
     6087                                       , input 'macro':U
     6088                                       , input '':U
     6089                                       , input '':U
     6090                                       , input '':U
     6091                                       , input ?
     6092                                       ).
     6093   for each macro-list-hist:
     6094     delete macro-list-hist.
     6095   end.
     6096   for each buf_bb-list-hist where
     6097           buf_bb-list-hist.id >=  an-listp-start-macro-id
     6098     and  buf_bb-list-hist.id <=  an-listp-end-macro-id:
     6099     create macro-list-hist.
     6100     buffer-copy buf_bb-list-hist
     6101     except id num-recs num-add num-ignored
     6102     to macro-list-hist
     6103     assign
     6104     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6105     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6106     .
     6107   end.
     6108   END.
     6109   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     6110   DO:
     6111   disable
     6112   b-clear-macro with frame Dialog-Frame .
     6113   assign
     6114   an-listp-start-macro-id = ?
     6115   an-listp-end-macro-id = ?
     6116   an-listp-macros-label-id = 0
     6117   .
     6118   for each macro-list-hist:
     6119     delete macro-list-hist.
     6120   end.
     6121   hide
     6122   b-clear-macro in frame Dialog-Frame .
     6123   enable
     6124   b-record
     6125   b-macro
     6126   with frame Dialog-Frame .
     6127   END.
     6128   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     6129   DO:
     6130     assign
     6131     Rs-list-method = temp-list.fvalue
     6132     .
     6133     run proc-cd2 in this-procedure.
     6134     run proc-vc-rs-list-method in this-procedure no-error .
     6135     if error-status:error then return no-apply.
     6136   END.
     6137   PROCEDURE get-operation :
     6138   define input parameter p-message as character no-undo .
     6139   define output parameter p-operation as integer no-undo .
     6140     do
     6141     on error undo, return error
     6142     :
     6143       run gbl/d-askw.w (
     6144                     input "Выбор операции над заданным списком"
     6145                    ,input (p-message + chr(10) +
     6146                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     6147                    ,input "|"
     6148                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     6149                            "Удалить" + "|" +
     6150                            "Оставить" + "|" +
     6151                            "Отказ")
     6152                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     6153                           "Удалить полученный список из уже имеющегося" + "|" +
     6154                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     6155                           "Ничего не делать")
     6156                    ,input  (if p-keep-query then 2 else 1)
     6157                    ,input  4
     6158                    ,output p-operation).
     6159      if p-operation = 4 then do:
     6160         return error .
     6161      end.
     6162     end.
     6163   END PROCEDURE.
     6164   PROCEDURE proc-fill-temp-list :
     6165     define variable v-index               as integer   no-undo .
     6166     define variable v-num-entries-options as integer   no-undo .
     6167     do
     6168     on error undo, return error
     6169     :
     6170       assign
     6171         v-num-entries-options = num-entries("Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Файл списка товаров,file-gds,                     Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner")
     6172       .
     6173       do v-index = 1 to v-num-entries-options by 2
     6174       :
     6175         create temp-list.
     6176         assign
     6177           temp-list.fname  = trim(entry(v-index
     6178                                        ,"Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Файл списка товаров,file-gds,                     Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner"
     6179                                        )
     6180                                  ,chr(32)
     6181                                  )
     6182           temp-list.fvalue = trim(entry(v-index + 1
     6183                                        ,"Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Файл списка товаров,file-gds,                     Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner"
     6184                                        )
     6185                                  ,chr(32)
     6186                                  )
     6187           temp-list.id     = v-index
     6188         .
     6189       end.
     6190     end.
     6191   END PROCEDURE.
     6192   procedure proc-b-macro :
     6193   define input parameter p-option as character no-undo .
     6194   define variable glog as logical no-undo .
     6195   define variable v-id as integer no-undo .
     6196   define variable v-result as character no-undo .
     6197   define variable v-des as character no-undo .
     6198   define variable v-hist-mode as character no-undo .
     6199   define variable v-file as logical no-undo .
     6200   define variable v-full-path        as character no-undo .
     6201   define variable v-path             as character no-undo .
     6202   define variable v-file-name        as character no-undo .
     6203   define variable v-file-name-no-ext as character no-undo .
     6204   define variable v-file-name-ext    as character no-undo .
     6205   define variable v-rid-list as character no-undo .
     6206   define variable v-ok as logical no-undo .
     6207   define buffer buf_bb-list-hist for bb-list-hist.
     6208   define buffer buf_clob-bind for ub.clob-bind.
     6209   define buffer buf_clob-data for ub.clob-data.
     6210   do
     6211   on error undo, return error
     6212   :
     6213     if v-macro-is-running then do:
     6214     end.
     6215     else do:
     6216       glog = yes.
     6217       if an-listp-start-macro-id >= 1 then do:
     6218         case p-option:
     6219           when "file" then do:
     6220         message
     6221         "Согласно командам формирования списка из записанного макроса"
     6222         view-as alert-box question buttons OK-Cancel update glog.
     6223           end.
     6224           when "lob" then do:
     6225             message
     6226             "Нелья!"
     6227             view-as alert-box question buttons OK-Cancel update glog.
     6228             run ui-on in this-procedure .
     6229             return error.
     6230           end.
     6231         end case.
     6232         if not glog then do:
     6233           run ui-on in this-procedure .
     6234           return error.
     6235         end.
     6236         if an-listp-end-macro-id = ? then do:
     6237           assign
     6238           an-listp-end-macro-id  = v-seq.
     6239           for each macro-list-hist:
     6240             delete macro-list-hist.
     6241           end.
     6242           for each buf_bb-list-hist where
     6243                   buf_bb-list-hist.id >=  an-listp-start-macro-id
     6244             and  buf_bb-list-hist.id <=  an-listp-end-macro-id:
     6245             create macro-list-hist.
     6246             buffer-copy buf_bb-list-hist
     6247             except id num-recs num-add num-ignored
     6248             to macro-list-hist
     6249             assign
     6250             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6251             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6252             macro-list-hist.done = no
     6253             .
     6254           end.
     6255         end.
     6256         else do:
     6257           find last macro-list-hist no-error.
     6258           if available macro-list-hist then do:
     6259             v-id = macro-list-hist.id.
     6260           end.
     6261         end.
     6262       end.
     6263       else do:
     6264         case p-option:
     6265           when "file" then do:
     6266         message
     6267         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6268         view-as alert-box question buttons OK-Cancel update glog.
     6269         if not glog then do:
     6270           run ui-on in this-procedure .
     6271           return error.
     6272         end.
     6273         system-dialog get-file f-name
     6274           filters "Макрос формирования списка *.bbm" "*.bbm"
     6275           title "Выберите файл макроса"
     6276           INITIAL-DIR "."
     6277           return-to-start-dir
     6278           must-exist
     6279           update glog
     6280           default-extension "bbm".
     6281         if not glog then do:
     6282           run ui-on in this-procedure .
     6283           return error.
     6284         end.
     6285           end.
     6286           when "lob" then do:
     6287             message
     6288             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6289             view-as alert-box question buttons OK-Cancel update glog.
     6290             if not glog then do:
     6291               run ui-on in this-procedure .
     6292               return error.
     6293             end.
     6294             run ref/clobbnds.w ( input parparentproc
     6295                                 ,input this-procedure:handle
     6296                                 ,input 'b-sel'
     6297                                 ,input "uniq-key-rec"
     6298                                 ,input ""
     6299                                 ,input 'list-macro':U
     6300                                 ,input 'bb-list'
     6301                                 ,input -1
     6302                                 ,input-output v-rid-list) no-error.
     6303             if v-rid-list = '' then do:
     6304               run ui-on in this-procedure.
     6305               return error.
     6306             end.
     6307             find first buf_clob-bind no-lock where
     6308                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6309             if not available buf_clob-bind then do:
     6310               message
     6311               "Не найдена ссылка на макрос, сохраненный в БД!"
     6312               view-as alert-box error .
     6313               run ui-on in this-procedure .
     6314               return error.
     6315             end.
     6316             find first buf_clob-data no-lock where
     6317                       buf_clob-data.db-num = buf_clob-bind.db-num
     6318                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6319             if not available buf_clob-data then do:
     6320               message
     6321               "Не найдена ссылка на макрос, сохраненный в БД!"
     6322               view-as alert-box error .
     6323               run ui-on in this-procedure .
     6324               return error.
     6325             end.
     6326             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6327               message
     6328               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6329                         , buf_clob-data.db-num
     6330                         , chr(10))
     6331              view-as alert-box question buttons yes-no update v-ok.
     6332              if not v-ok then do:
     6333                 run ui-on in this-procedure .
     6334                 return error.
     6335              end.
     6336             end.
     6337             run gbl/_tmpfile.p ( input ""
     6338                           ,input "tmp"
     6339                           ,output v-file-name) .
     6340             copy-lob from object buf_clob-data.cdata
     6341             to file f-name.
     6342             run gbl/filename.p
     6343               (input  v-file-name
     6344               ,output f-name
     6345               ,output v-path
     6346               ,output v-file-name
     6347               ,output v-file-name-no-ext
     6348               ,output v-file-name-ext
     6349               ) no-error .
     6350             if error-status:error then do:
     6351             end.
     6352           end.
     6353         end case.
     6354         for each macro-list-hist:
     6355           delete macro-list-hist.
     6356         end.
     6357         input stream sout from value (f-name).
     6358         _macro:
     6359         repeat:
     6360           create macro-list-hist.
     6361           import stream sout macro-list-hist no-error.
     6362           if error-status:error then do:
     6363               undo _macro, next _macro.
     6364           end.
     6365           assign
     6366           macro-list-hist.num-rec = 0
     6367           macro-list-hist.num-add = 0
     6368           macro-list-hist.num-ignored = 0
     6369           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6370           macro-list-hist.done = no
     6371           .
     6372         end.
     6373         find first macro-list-hist where
     6374                 macro-list-hist.id = 0.
     6375         delete macro-list-hist.
     6376         input stream sout close.
     6377         If p-option = "lob" then do:
     6378          os-delete value(f-name).
     6379         end.
     6380         v-file = yes.
     6381       end.
     6382       an-listp-macros-label-id = v-seq.
     6383       run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6384                                           , input-output v-seq
     6385                                           , input 0
     6386                                           , input '>':U
     6387                                           , input (if v-file
     6388                                                   then substitute("Файл макроса : &1", f-name)
     6389                                                   else substitute("Записанный макрос")
     6390                                                   )
     6391                                           , input tot-lns
     6392                                           , input 'macro':U
     6393                                           , input '':U
     6394                                           , input (if v-file then f-name else '':U)
     6395                                           , input '':U
     6396                                           , input ?
     6397                                           ).
     6398     end.
     6399     disable
     6400     b-record
     6401     b-macro
     6402     with frame Dialog-Frame .
     6403     hide
     6404     b-record in frame Dialog-Frame .
     6405     enable
     6406     b-clear-macro with frame Dialog-Frame .
     6407     v-macro-is-running = yes.
     6408     run str/listmcro.w (input parparentproc
     6409                   ,input this-procedure:handle
     6410                  ,input "Макрос формирования списка кодов" + chr(4) + "bbm"
     6411                   ,input "b-play,b-step"
     6412                   ,input-output v-current-step
     6413                   ,input v-id
     6414                   ,output v-result) no-error .
     6415     if error-status:error
     6416     or v-result = "b-stop"
     6417     or v-result = 'end':U
     6418     then do:
     6419       for each macro-list-hist:
     6420         delete macro-list-hist.
     6421       end.
     6422       assign
     6423       an-listp-start-macro-id = ?
     6424       an-listp-end-macro-id = ?
     6425       an-listp-macros-label-id = 0
     6426       .
     6427       if v-result = 'b-stop' then do:
     6428         assign
     6429         v-hist-mode = '[]':U
     6430         v-des = "Выполнение макроса прекращено пользователем"
     6431         .
     6432         hide
     6433         b-clear-macro
     6434         b-stop
     6435         in frame Dialog-Frame .
     6436         enable
     6437         b-record
     6438         with frame Dialog-Frame .
     6439       end.
     6440       if v-result = 'end' then do:
     6441         assign
     6442         v-hist-mode = '<':U
     6443         v-des = "Выполнение макроса завершено"
     6444         .
     6445         hide
     6446         b-clear-macro
     6447         b-stop
     6448         in frame Dialog-Frame .
     6449         enable
     6450         b-record
     6451         with frame Dialog-Frame .
     6452       end.
     6453       if error-status:error then do:
     6454         assign
     6455         v-hist-mode = 'E':U
     6456         v-des = "Выполнение макроса прекращено из-за ошибки"
     6457         .
     6458       end.
     6459       run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6460                                           , input-output v-seq
     6461                                           , input 0
     6462                                           , input v-hist-mode
     6463                                           , input v-des
     6464                                           , input tot-lns
     6465                                           , input 'macro':U
     6466                                           , input '':U
     6467                                           , input f-name
     6468                                           , input '':U
     6469                                           , input ?
     6470                                           ) no-error .
     6471       assign
     6472       v-macro-is-running = no
     6473       v-current-step = 0
     6474       .
     6475     end.
     6476     enable
     6477     b-macro
     6478     with frame Dialog-Frame .
     6479   end.
     6480   end procedure.
     6481   procedure proc-create-macro-list-hist :
     6482   define input parameter p-list-table as character no-undo .
     6483   define input parameter p-id as integer           no-undo .
     6484   define input parameter p-line as integer         no-undo .
     6485   define input parameter p-hist-mode as character  no-undo .
     6486   define input parameter p-des as character        no-undo .
     6487   define input parameter p-option_ as character    no-undo .
     6488   define input parameter p-item_ as character      no-undo .
     6489   define input parameter p-status_ as character    no-undo .
     6490   define buffer buf_macro-list-hist for macro-list-hist.
     6491   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6492     do
     6493     on error undo, return error return-value
     6494     :
     6495       create buf_macro-list-hist.
     6496       assign
     6497       buf_macro-list-hist.list-table = p-list-table
     6498       buf_macro-list-hist.id         = p-id
     6499       buf_macro-list-hist.line       = p-line
     6500       buf_macro-list-hist.hist-mode  = p-hist-mode
     6501       buf_macro-list-hist.des        = p-des
     6502       buf_macro-list-hist.option_    = p-option_
     6503       buf_macro-list-hist.item_      = p-item_
     6504       buf_macro-list-hist.status_    = p-status_
     6505       .
     6506       if p-keep-query then do:
     6507         create buf_keep-macro-list-hist.
     6508         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6509       end.
     6510     end.
     6511   end procedure.
     6512   procedure proc-macro-play :
     6513   define input parameter p-id as integer no-undo .
     6514   define input parameter p-step as logical no-undo .
     6515   define input parameter p-max-id as integer no-undo .
     6516   define variable v-id as integer no-undo .
     6517   define variable v-rowid   as rowid no-undo .
     6518   define variable v-tbl-name as character no-undo .
     6519   define variable v-old-seq as integer no-undo .
     6520   define variable v-current-id as integer no-undo .
     6521   define variable v-temp-seq as integer no-undo .
     6522   define variable v-rs-do-error as logical no-undo .
     6523   define  buffer buf_macro-list-hist for macro-list-hist.
     6524   define  buffer buf_bb-list-hist for bb-list-hist.
     6525   do
     6526   on error undo, return error return-value
     6527   :
     6528     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6529       assign
     6530       v-current-id = v-current-id + 1
     6531       v-id = macro-list-hist.id.
     6532       CASE entry(1, macro-list-hist.option_, chr(4)):
     6533         when 'macro':U
     6534         or
     6535         when 'title':U
     6536         or
     6537         when 'start':U
     6538         then do:
     6539         end.
     6540         when 'clear':U then do:
     6541           for each bb-list:
     6542             delete bb-list.
     6543           end.
     6544           for each bb-list-hist where bb-list-hist.id > an-listp-macros-label-id:
     6545             delete bb-list-hist.
     6546           end.
     6547           tot-lns = 0.
     6548           v-seq = an-listp-macros-label-id + 1.
     6549           v-no-hist = 0.
     6550           create buf_bb-list-hist.
     6551           buffer-copy macro-list-hist
     6552           to buf_bb-list-hist
     6553           assign buf_bb-list-hist.id = v-seq
     6554           v-temp-seq = v-seq
     6555           v-seq = v-seq + 1
     6556           v-no-hist = v-no-hist + 1
     6557           .
     6558           run ui-on in this-procedure .
     6559         end.
     6560         when 'single' then do:
     6561            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6562                                                 ,input ?
     6563                                                 ,input 'ub'
     6564                                                 ,input ?
     6565                                                 ,input no-lock
     6566                                                 ,output v-rowid
     6567                                                 ,output v-tbl-name) no-error .
     6568           if not error-status:error then do:
     6569             CASE macro-list-hist.hist-mode:
     6570               when '+':U then do:
     6571                 run proc-b-add in this-procedure(input yes
     6572                                                 ,input v-rowid
     6573                                                 ,input macro-list-hist.option_
     6574                                                 ,input macro-list-hist.status_) no-error .
     6575               end.
     6576               when '-':U then do:
     6577                 run proc-b-del in this-procedure(input yes
     6578                                                 ,input v-rowid
     6579                                                 ,input macro-list-hist.option_
     6580                                                 ,input macro-list-hist.status_) no-error .
     6581               end.
     6582               when '*':U then do:
     6583                 run proc-b-rest in this-procedure(input yes
     6584                                                  ,input v-rowid
     6585                                                  ,input macro-list-hist.option_
     6586                                                  ,input macro-list-hist.status_) no-error .
     6587               end.
     6588             END.
     6589             if error-status:error then do:
     6590                 return ("error" + chr(4) + return-value) .
     6591             end.
     6592             find first  buf_bb-list-hist where
     6593                     buf_bb-list-hist.id = v-seq - 1 no-error .
     6594             if available buf_bb-list-hist then
     6595             assign
     6596             macro-list-hist.num-recs = buf_bb-list-hist.num-recs
     6597             macro-list-hist.num-add = buf_bb-list-hist.num-add
     6598             macro-list-hist.num-ignored = buf_bb-list-hist.num-ignored
     6599             .
     6600           end.
     6601           else do:
     6602             return ("error" + chr(4) + return-value).
     6603           end.
     6604         end.
     6605         otherwise do:
     6606           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6607           or lookup(macro-list-hist.option_, 'optimize':U) > 0
     6608           then do:
     6609             if macro-list-hist.line = 0 then do:
     6610               v-no-hist = 0.
     6611               for each buf_macro-list-hist where
     6612                       buf_macro-list-hist.id = v-id:
     6613                 create buf_bb-list-hist.
     6614                 buffer-copy buf_macro-list-hist
     6615                 except id  num-recs num-add num-ignored done
     6616                 to buf_bb-list-hist
     6617                 assign
     6618                 buf_bb-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6619                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6620                 v-seq = (if buf_macro-list-hist.line = 0
     6621                         then (v-seq + 1)
     6622                         else v-seq)
     6623                 v-no-hist = v-no-hist + 1
     6624                 .
     6625               end.
     6626               if v-no-hist = 1 then v-no-hist = 0.
     6627               run rs-do in this-procedure (input yes
     6628                                         , input p-step
     6629                                         , input macro-list-hist.option_
     6630                                         , input macro-list-hist.status_
     6631                                         , input get-line-mode(macro-list-hist.hist-mode)
     6632                                         , input v-temp-seq
     6633                                         ) no-error .
     6634               if error-status:error then do:
     6635                 assign
     6636                 v-rs-do-error = yes.
     6637               end.
     6638               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6639                 run proc-b-rest-2 in this-procedure .
     6640                 run ui-on in this-procedure .
     6641               end.
     6642               for each buf_bb-list-hist where
     6643                       buf_bb-list-hist.id = v-temp-seq,
     6644                  first buf_macro-list-hist where
     6645                       buf_macro-list-hist.id = v-id
     6646                   AND buf_macro-list-hist.line = buf_bb-list-hist.line:
     6647                  assign
     6648                  buf_macro-list-hist.num-recs = buf_bb-list-hist.num-recs
     6649                  buf_macro-list-hist.num-add = buf_bb-list-hist.num-add
     6650                  buf_macro-list-hist.num-ignored = buf_bb-list-hist.num-ignored
     6651                  .
     6652               end.
     6653               if v-rs-do-error then do:
     6654                 run ui-on in this-procedure .
     6655                 return ("error" + chr(4) + return-value).
     6656               end.
     6657               v-id = macro-list-hist.id.
     6658             end.
     6659           end.
     6660         end.
     6661       END CASE.
     6662     end.
     6663   end.
     6664   end procedure.
     6665   procedure proc-b-rest-2 :
     6666     do
     6667     on error undo, return error
     6668     :
     6669       for each bb-list:
     6670         if bb-list.to-del = ? then do:
     6671           assign
     6672           bb-list.to-del = no
     6673           .
     6674         end.
     6675         else do:
     6676           delete bb-list.
     6677         end.
     6678       end.
     6679       tot-lns = lns-cnt.
     6680     end.
     6681   end procedure.
     6682   PROCEDURE proc-expand :
     6683   define input parameter p-shift as integer no-undo .
     6684   define input parameter p-from as integer no-undo .
     6685   define input parameter p-to as integer no-undo .
     6686   define input parameter p-forcer-name as character no-undo .
     6687   define variable fh as widget-handle no-undo .
     6688   define variable hh as widget-handle no-undo .
     6689   define variable lh as widget-handle no-undo .
     6690   define variable ii as INTEGER no-undo .
     6691   ASSIGN
     6692   fh = frame Dialog-Frame:first-child
     6693   hh = fh:first-child
     6694   .
     6695   CASE v-expand:
     6696     WHEN YES THEN DO:
     6697       ASSIGN
     6698       v-expand = NO.
     6699       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6700         ASSIGN
     6701         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6702         hh:ROW          = (hh:ROW - p-shift).
     6703         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6704       END.
     6705     END.
     6706     WHEN NO THEN DO:
     6707       v-expand = YES.
     6708       v-downed = ''.
     6709       _do:
     6710       do while valid-handle(hh):
     6711         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6712          AND hh:ROW >= p-from
     6713          AND hh:ROW <= p-to
     6714          and lookup(hh:name, p-forcer-name) = 0
     6715          THEN DO:
     6716           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6717           hh:ROW          = (hh:ROW + p-shift).
     6718           ASSIGN
     6719           v-downed = v-downed + chr(44) + STRING(hh).
     6720           IF hh:TYPE = "fill-in"
     6721           AND valid-handle(hh:side-label-handle) THEN dO:
     6722             assign
     6723             lh = hh:SIDE-LABEL-HANDLE
     6724             lh:ROW = lh:ROW + p-shift
     6725             v-downed = v-downed + chr(44) + STRING(lh)
     6726             .
     6727            END.
     6728          END.
     6729          hh = hh:next-sibling.
     6730       END.
     6731       v-downed = trim(v-downed, chr(44)).
     6732     END.
     6733   END CASE.
     6734   END PROCEDURE.
     6735   define variable v-ok as logical   no-undo .
     6736   assign
     6737     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6738   .
