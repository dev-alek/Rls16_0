     8870             if return-value = 'false':u then do:
     8871               run UI-on.
     8872               return error.
     8873             end.
     8874             run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8875                                                 , input-output v-seq
     8876                                                 , input 0
     8877                                                 , input '':U
     8878                                                 , input substitute("ВСЕ коды продажи для бар-кода в чеках &1&2, пробитых не позже &3 "
     8879                                                                    , v-sel-obj-type
     8880                                                                    , v-sel-obj-code
     8881                                                                    , v-chk-date-chr)
     8882                                                 , input tot-lns
     8883                                                 , input rs-list-method
     8884                                                 , input rs-status
     8885                                                 , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-chk-date-chr
     8886                                                 , input '':U
     8887                                                 , input ?
     8888                                                 ).
     8889           end.
     8890           when "cd-codes":U then do:
     8891             glog = yes.
     8892             message "Коды продажи, привязанные к кассам"
     8893             skip stat-line(rs-status)
     8894             view-as alert-box question buttons OK-Cancel update glog.
     8895             if not glog then do:
     8896               run UI-on.
     8897               return error.
     8898             end.
     8899             run ref/cashlist.w (
     8900                             input parparentproc
     8901                            ,input "b-sel"
     8902                            ,input "db":U
     8903                            ,input g#db-num
     8904                            ,input 0
     8905                            ,input p-curr-obj-type
     8906                            ,input p-curr-obj-code
     8907                            ,input ?
     8908                            ,output ref-list) no-error .
     8909             if error-status:error or ref-list = "":u then do:
     8910               run UI-on.
     8911               return error.
     8912             end.
     8913             find first buf_cash-desk no-lock where
     8914                       recid(buf_cash-desk) = integer(ref-list) no-error .
     8915             if not available buf_cash-desk then do:
     8916               run UI-on.
     8917               return error.
     8918             end.
     8919             if buf_cash-desk.pos-type <> 'r-keeper':U then do:
     8920               message
     8921               substitute("Коды продажи на кассе определены только для кассы типа &1"
     8922                         , 'r-keeper':U)
     8923               view-as alert-box error .
     8924               run UI-on.
     8925               return error.
     8926             end.
     8927             assign
     8928             v-cash-num = buf_Cash-desk.cash-num
     8929             v-pos-type = buf_Cash-desk.pos-type
     8930             v-cash-desk-obj-code = buf_Cash-desk.obj-code
     8931             .
     8932             run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8933                                                 , input-output v-seq
     8934                                                 , input 0
     8935                                                 , input '':U
     8936                                                 , input substitute("Коды продажи для кассы &1 &2 &3&4"
     8937                                                        , v-pos-type, v-cash-num, 'маг':U, v-cash-desk-obj-code)
     8938                                                 , input tot-lns
     8939                                                 , input rs-list-method
     8940                                                 , input rs-status
     8941                                                 , input ('маг':U + chr(3) + string(v-cash-desk-obj-code) + chr(3) +
     8942                                                         v-pos-type + chr(3) + string(v-cash-num))
     8943                                                 , input '':U
     8944                                                 , input ?
     8945                                                 ).
     8946           end.
     8947           when "parts-cashparts":U
     8948           or
     8949           when "parts-ean-cashparts"
     8950           then do:
     8951             run proc-parts-cashparts ( input rs-list-method) no-error.
     8952             if error-status:error then do:
     8953               run Ui-on in this-procedure.
     8954               return no-apply.
     8955             end.
     8956           end.
     8957           when "parts-last-date":U
     8958           or
     8959           when "parts-rsrv-last-date"
     8960           or
     8961           when "parts-ean-last-date":U
     8962           or
     8963           when "parts-ean-rsrv-last-date"
     8964           then do:
     8965             run proc-parts-last-date(rs-list-method) no-error.
     8966             if error-status:error then do:
     8967               run Ui-on in this-procedure.
     8968               return no-apply.
     8969             end.
     8970           end.
     8971           when "parts-fib":U
     8972           or
     8973           when "parts-rsrv-fib"
     8974           or
     8975           when "parts-ean-fib":U
     8976           or
     8977           when "parts-ean-rsrv-fib"
     8978           then do:
     8979             run proc-parts-fib(rs-list-method) no-error.
     8980             if error-status:error then do:
     8981               run Ui-on in this-procedure.
     8982               return no-apply.
     8983             end.
     8984           end.
     8985           when "parts-end-date-obj":U
     8986           or
     8987           when "parts-ean-end-date-obj"
     8988           then do:
     8989             run proc-parts-end(rs-list-method) no-error.
     8990             if error-status:error then do:
     8991               run Ui-on in this-procedure.
     8992               return no-apply.
     8993             end.
     8994           end.
     8995           when "loc-sc-codes"
     8996           or
     8997           when "loc-pg-codes"
     8998           or
     8999           when "gbl-sc-codes"
     9000           then do:
     9001             glog = yes.
     9002             if rs-list-method = "loc-sc-codes" then do:
     9003                if g#db-num = 0 then do:
     9004                  dsp-rs-option = substitute("Локальные весовые коды на выбранной БД: &1", stat-line(rs-status)).
     9005                end.
     9006             end.
     9007             if rs-list-method = "gbl-sc-codes" then do:
     9008                if g#db-num = 0 then do:
     9009                  dsp-rs-option = substitute("Глобальные весовые коды на выбранной БД: &1", stat-line(rs-status)).
     9010                end.
     9011             end.
     9012             if rs-list-method = "loc-pg-codes" then do:
     9013                if g#db-num = 0 then do:
     9014                  dsp-rs-option = substitute("Штучные коды для весов коды на выбранной БД: &1", stat-line(rs-status)).
     9015                end.
     9016             end.
     9017             message dsp-rs-option
     9018             view-as alert-box question buttons OK-Cancel update glog.
     9019             if not glog then do:
     9020               run UI-on.
     9021               return error.
     9022             end.
     9023             if g#db-num = 0 then do:
     9024               run adm/dbs.w ( INPUT parparentproc
     9025                               ,INPUT 'ПРОСМОТР':U
     9026                               ,OUTPUT v-rid) NO-ERROR.
     9027               if error-status:error or v-rid = ? then do:
     9028                 run UI-on.
     9029                 return error.
     9030               end.
     9031             end.
     9032             else do:
     9033                find first buf_db no-lock where buf_db.db-num = g#db-num.
     9034                v-rid = recid(buf_db).
     9035             end.
     9036             define variable choice as integer no-undo .
     9037             run gbl/d-askw.w (input "Вопрос",
     9038                                   input  ("На каждом объекте весовые товары взвешиваются" + chr(10)
     9039                                           + "с ипользованием определенного кода" + chr(10)
     9040                                           + "(Атрибут товара на объекте ВЕСОВОЙ КОД)" + chr(10)
     9041                                           + "Определите какие коды включать в выборку"
     9042                                           ),
     9043                                   input "|",
     9044                                   input "Все|Используемые|НЕиспользуемые|Отменить",
     9045                                   input "Все|Взвешиваются c этим кодом|НЕ взвешиваются c этим кодом|Отменить",
     9046                                   input 1,
     9047                                   input 4,
     9048                                   output choice).
     9049             if choice = 4
     9050             then do:
     9051               run UI-on.
     9052               return error.
     9053             end.
     9054             v-recs = num-entries (string(v-rid)).
     9055             do num-rec = 0 to v-recs:
     9056               if num-rec > 0
     9057               then do:
     9058                 v-ref-rec = integer (entry (num-rec, string(v-rid))).
     9059                 find buf_db where recid (buf_db) = integer(entry(num-rec, string(v-rid))) no-lock.
     9060               end.
     9061               if num-rec = 0 then do:
     9062                 case choice:
     9063                   when 1 then do:
     9064                     assign
     9065                     dsp-rs = dsp-rs-option
     9066                     .
     9067                   end.
     9068                   when 2 then do:
     9069                     assign
     9070                     dsp-rs = substitute("&1 используемые для взвешивания", dsp-rs-option)
     9071                     .
     9072                   end.
     9073                   when 3 then do:
     9074                     assign
     9075                     v-item_    = substitute("&1 НЕиспользуемые для взвешивания", dsp-rs-option)
     9076                     .
     9077                   end.
     9078                 end case.
     9079                 assign
     9080                 v-temp-seq = v-seq
     9081                 v-line     = 0
     9082                 dsp-rs = dsp-rs-option
     9083                 v-item_     = ""
     9084                 v-tbl-name = '':U
     9085                 v-bh       = ?
     9086                 v-tot-lns = tot-lns
     9087                 .
     9088               end.
     9089               else do:
     9090                 case choice:
     9091                   when 1 then do:
     9092                     assign
     9093                     v-item_    = string(buf_db.db-num) + chr(3) + "all"
     9094                     .
     9095                   end.
     9096                   when 2 then do:
     9097                     assign
     9098                     v-item_    = string(buf_db.db-num) + chr(3) + "using"
     9099                     .
     9100                   end.
     9101                   when 3 then do:
     9102                     assign
     9103                     v-item_    = string(buf_db.db-num) + chr(3) + "nonusing"
     9104                     .
     9105                   end.
     9106                 end case.
     9107                 assign
     9108                 v-temp-seq = v-seq - 1
     9109                 v-line     = num-rec
     9110                 dsp-rs =  substitute("     БД &1", buf_db.db-num)
     9111                 v-tbl-name =  ''
     9112                 v-bh       = ?
     9113                 v-tot-lns = tot-lns + num-rec
     9114                 .
     9115               end.
     9116               v-no-hist = num-rec.
     9117               run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9118                                                   , input-output v-temp-seq
     9119                                                   , input v-line
     9120                                                   , input '':U
     9121                                                   , input dsp-rs
     9122                                                   , input v-tot-lns
     9123                                                   , input rs-list-method
     9124                                                   , input rs-status
     9125                                                   , input v-item_
     9126                                                   , input v-tbl-name
     9127                                                   , input v-bh
     9128                                                   ).
     9129               if num-rec = 0 then v-seq  = v-temp-seq.
     9130             end.
     9131           end.
     9132           when "prod-bc-off":U then do:
     9133             glog = yes.
     9134             message "Все выключенные ДопБк"
     9135             skip stat-line(rs-status)
     9136             view-as alert-box question buttons OK-Cancel update glog.
     9137             if not glog then do:
     9138               run UI-on.
     9139               return error.
     9140             end.
     9141             run create-bb-list-hist in this-procedure (
     9142                                                   input 'ДОБАВЛЕНИЕ':U
     9143                                                 , input-output v-seq
     9144                                                 , input 0
     9145                                                 , input '':U
     9146                                                 , input substitute("Все выключенные ДопБК")
     9147                                                 , input tot-lns
     9148                                                 , input rs-list-method
     9149                                                 , input rs-status
     9150                                                 , input 'prod-bc-off':U
     9151                                                 , input '':U
     9152                                                 , input ?
     9153                                                 ).
     9154           end.
     9155           when "scaner" then do:
     9156             glog = yes.
     9157             message "Все коды из файла, полученного с мобильного сканера."
     9158             skip stat-line(rs-status)
     9159             view-as alert-box question buttons OK-Cancel update glog.
     9160             if not glog then do:
     9161               run UI-on.
     9162               return error.
     9163             end.
     9164             system-dialog get-file f-gds-name
     9165             title "Выберите файл со сканера"
     9166             filters "WorkAbout MS15  *.dbs" "*.dbs",
     9167                     "WorkAbout  *.imp" "*.imp",
     9168                     "Инвентаризация касса  *.inv" "*.inv",
     9169                     "Все файлы  *.*" "*.*"
     9170               INITIAL-DIR "."
     9171               return-to-start-dir
     9172               must-exist
     9173               update glog
     9174               default-extension "dbs".
     9175             if not glog then do:
     9176               run UI-on.
     9177               return error.
     9178             end.
     9179             run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9180                                                   , input-output v-seq
     9181                                                   , input 0
     9182                                                   , input '':U
     9183                                                   , input substitute("Файл сканера : &1 &2", f-name, stat-line(rs-status))
     9184                                                   , input tot-lns
     9185                                                   , input rs-list-method
     9186                                                   , input rs-status
     9187                                                   , input f-gds-name
     9188                                                   , input '':U
     9189                                                   , input ?
     9190                                                   ).
     9191           end.
     9192         when "filter" then do:
     9193           glog = yes.
     9194           message "Все баркоды, выбранные в соответствии с заданным фильтром (без учета сортировки)."
     9195           skip stat-line(rs-status)
     9196           view-as alert-box question buttons OK-Cancel update glog.
     9197           if not glog then do:
     9198             run UI-on in this-procedure.
     9199             return error.
     9200           end.
     9201           assign
     9202           tbl = 'bar-code'
     9203           join-tbl = ','
     9204           fld = ""
     9205           lab = ""
     9206           spr = ""
     9207           dim = '0'
     9208           c-point = "bb-list" + chr(4) + "Список кодов" + chr(4) + "no"
     9209           .
     9210           define variable v-flt-rec as recid no-undo .
     9211           define variable v-filter-name as character no-undo .
     9212           define variable where-phrase as character no-undo .
     9213           define variable sort-phrase as character no-undo .
     9214           define variable where-phrase-rus as character no-undo .
     9215           define variable sort-phrase-rus as character no-undo .
     9216           run fltfield-add in this-procedure('part-code', '№ партии', '',
     9217           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9218           run fltfield-add in this-procedure('in-code', '№ ПН', '',
     9219           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9220           run fltfield-add in this-procedure('cli-base-rate', 'Коэфф', '',
     9221           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9222           run fltfield-add in this-procedure('unit-cli', 'Ед.изм.', 'unit',
     9223           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9224           run gbl/filter.w ( input parparentproc
     9225                             ,input c-point
     9226                             ,input tbl
     9227                             ,input join-tbl
     9228                             ,input fld
     9229                             ,input lab
     9230                             ,input spr
     9231                             ,input dim).
     9232           run gbl/flt-get.p (
     9233                            input  c-point
     9234                           ,output v-flt-rec
     9235                           ,output v-filter-name
     9236                           ,output where-phrase
     9237                           ,output sort-phrase
     9238                           ,output where-phrase-rus
     9239                           ,output sort-phrase-rus  ).
     9240           if v-flt-rec = ? then do:
     9241             run UI-on in this-procedure.
     9242             return error.
     9243           end.
     9244           else do:
     9245             find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     9246             run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9247                                                 , input-output v-seq
     9248                                                 , input 0
     9249                                                 , input '':U
     9250                                                 , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     9251                                                 , input tot-lns
     9252                                                 , input rs-list-method
     9253                                                 , input rs-status
     9254                                                 , input ubflt.filter.where-ysl
     9255                                                 , input '':U
     9256                                                 , input ?
     9257                                                 ).
     9258           end.
     9259         end.
     9260         otherwise do:
     9261           message "Неизвестный" rs-list-method view-as alert-box .
     9262         end.
     9263        end CASE.
     9264       if tot-lns <> 0 then do:
     9265         run get-operation in this-procedure (input dsp-rs, output v-operation) no-error .
     9266         CASE v-operation:
     9267           when 1 then do:
     9268             run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
     9269           end.
     9270           when 2 then do:
     9271             run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ) no-error  .
     9272           end.
     9273           when 3 then do:
     9274             run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
     9275           end.
     9276           otherwise do:
     9277             assign
     9278             dsp-rs = "":U.
     9279             run UI-on.
     9280             return error.
     9281           end.
     9282         END CASE.
     9283         if error-status:error then do:
     9284           run UI-on.
     9285           return error return-value .
     9286         end.
     9287       end.
     9288       assign
     9289       rs-list-method = temp-list.fvalue
     9290       .
     9291       find last buf_bb-list-hist no-lock where
     9292                 buf_bb-list-hist.id = (v-seq - 1)
     9293           and  buf_bb-list-hist.line = 0 no-error .
     9294       DISPLAY
     9295       (if available buf_bb-list-hist
     9296       then buf_bb-list-hist.des
     9297       else '') @ dsp-rs
     9298       with frame Dialog-Frame.
     9299       if tot-lns = 0
     9300       then do:
     9301         run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
     9302       end.
     9303     end.
     9304   end.
     9305   end procedure.
     9306   procedure proc-scn-tsd :
     9307     do
     9308     on error undo, return error
     9309     :
     9310     run str/diallog.w (parparentproc
     9311                 , this-procedure
     9312                 , 'str/send-tsd.p':U
     9313                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code) + chr(4) + "bb-list":U)
     9314                 , no
     9315                 , '':U
     9316                 , 'Пересылка товаров на ТСД') no-error .
     9317     end.
     9318   end procedure.
     9319   procedure proc-b-add :
     9320   define input parameter p-from-macro as logical no-undo .
     9321   define input parameter p-rowid as rowid no-undo .
     9322   define input parameter rs-list-method as character no-undo .
     9323   define input parameter rs-status as character no-undo .
     9324     do
     9325     on error undo, return error
     9326     :
     9327     line-mode = 'ДОБАВЛЕНИЕ':U.
     9328     if rs-list-method = "single" then do:
     9329        v-no-hist = - 1.
     9330       if p-from-macro then do:
     9331       end.
     9332       else do:
     9333         assign
     9334         frame Dialog-Frame
     9335         T-all-prt
     9336         T-loc-alt
     9337         T-loc-base
     9338         .
     9339         if (
     9340         T-all-prt or
     9341         T-bc-alt  or
     9342         T-bc-base or
     9343         T-loc-alt or
     9344         T-loc-base  or
     9345         T-parts-all  or
     9346         T-parts-not-blank or
     9347         T-parts-ser or
     9348         T-pb-alt    or
     9349         T-pb-base   or
     9350         T-sc-base) = no then do:
     9351           message
     9352           "Не выбран ни один тип кодов!"
     9353           view-as alert-box error .
     9354           undo, return error .
     9355         end.
     9356         assign
     9357         temp-shop.obj-code = p-curr-obj-code
     9358         temp-shop.all-prt = T-all-prt
     9359         temp-shop.cd-bc-alt = T-bc-alt
     9360         temp-shop.cd-bc-base = T-bc-base
     9361         temp-shop.cd-loc-alt = T-loc-alt
     9362         temp-shop.cd-loc-base = T-loc-base
     9363         temp-shop.cd-parts-all = T-parts-all
     9364         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9365         temp-shop.cd-parts-ser = T-parts-ser
     9366         temp-shop.cd-pb-alt = T-pb-alt
     9367         temp-shop.cd-pb-base = T-pb-base
     9368         temp-shop.cd-sc-base = T-sc-base
     9369         .
     9370       end.
     9371       if p-from-macro then do:
     9372         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
     9373       end.
     9374       else do:
     9375         run ref/gds-ref.p ( input parparentproc
     9376                         ,input "b-sel,b-add"
     9377                         ,input ?
     9378                         ,input ?
     9379                         ,input ?
     9380                         ,input ?
     9381                         ,input ?
     9382                         ,input ?
     9383                         ,input ?
     9384                         ,input p-curr-obj-type
     9385                         ,input p-curr-obj-code
     9386                         ,input ?
     9387                         ,output ref-list).
     9388         apply "entry" to br-list in frame Dialog-Frame.
     9389         if ref-list = "" then
     9390           return no-apply.
     9391         find goods where recid (goods) = integer (ref-list) no-lock no-error.
     9392       end.
     9393       if available goods then do:
     9394         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     9395         tot-lns = tot-lns + lns-cnt.
     9396         run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer goods).
     9397       end.
     9398       else do:
     9399         return error "Нет в БД такого товара".
     9400       end.
     9401       run UI-on.
     9402     end.
     9403     else
     9404       run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9405     end.
     9406   end procedure.
     9407   procedure proc-b-del :
     9408   define input parameter p-from-macro as logical no-undo .
     9409   define input parameter p-rowid as rowid no-undo .
     9410   define input parameter rs-list-method as character no-undo .
     9411   define input parameter rs-status as character no-undo .
     9412   define variable v-rep-rec as recid no-undo .
     9413   define buffer buf_prod-bc for ub.prod-bc.
     9414   define buffer buf_bar-code for ub.bar-code.
     9415     do
     9416     on error undo, return error
     9417     :
     9418       line-mode = 'удаление':U.
     9419       if rs-list-method begins "single" then do:
     9420        v-no-hist = - 1.
     9421         if p-from-macro then do:
     9422           CASE entry(2, rs-list-method, chr(4) ):
     9423             when 'prod-bc':U then do:
     9424               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9425               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9426               find first bb-list where
     9427                          bb-list.b-code = buf_prod-bc.b-code
     9428                      AND bb-list.b-str = buf_prod-bc.b-str no-error.
     9429             end.
     9430             when 'bar-code':U
     9431             or
     9432             when 'loc-ean':U then do:
     9433               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9434               if not available buf_bar-code then return error "Нет в БД такого кода".
     9435               find first bb-list where
     9436                          bb-list.b-code = buf_bar-code.b-code
     9437                      AND bb-list.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9438             end.
     9439           END CASE.
     9440         end.
     9441         if available bb-list then do:
     9442           line-rec = recid (bb-list).
     9443           get next br-list.
     9444           if available bb-list then v-rep-rec = recid (bb-list).
     9445           else do:
     9446             reposition br-list to recid line-rec no-error.
     9447             get prev br-list.
     9448             if available bb-list then v-rep-rec = recid (bb-list).
     9449           end.
     9450           reposition br-list to recid line-rec no-error.
     9451           tot-lns = tot-lns - 1.
     9452           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9453           delete bb-list.
     9454           line-rec = v-rep-rec.
     9455           run UI-on.
     9456         end.
     9457         else do:
     9458           return error "Нет в списке кодов такого кода".
     9459         end.
     9460       end.
     9461       else do:
     9462         glog = no.
     9463         message "Удалить коды ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     9464                 view-as alert-box question buttons OK-Cancel update glog.
     9465         if not glog then  return error.
     9466         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9467       end.
     9468     end.
     9469   end procedure.
     9470   procedure proc-b-rest :
     9471   define input parameter p-from-macro as logical no-undo .
     9472   define input parameter p-rowid as rowid no-undo .
     9473   define input parameter rs-list-method as character no-undo .
     9474   define input parameter rs-status as character no-undo .
     9475   define buffer buf_bb-list-hist for bb-list-hist.
     9476   define buffer buf_prod-bc for ub.prod-bc.
     9477   define buffer buf_bar-code for ub.bar-code.
     9478     do
     9479     on error undo, return error
     9480     :
     9481       line-mode = 'ОСТАВИТЬ':U.
     9482       if rs-list-method begins "single" then do:
     9483         v-no-hist = - 1.
     9484         if p-from-macro then do:
     9485           CASE entry(2, rs-list-method, chr(4) ):
     9486             when 'prod-bc':U then do:
     9487               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9488               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9489               find first bb-list where
     9490                          bb-list.b-code = buf_prod-bc.b-code
     9491                      AND bb-list.b-str = buf_prod-bc.b-str no-error.
     9492             end.
     9493             when 'bar-code':U
     9494             or
     9495             when 'loc-ean':U  then do:
     9496               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9497               if not available buf_bar-code then return error "Нет в БД такого кода".
     9498               find first bb-list where
     9499                          bb-list.b-code = buf_bar-code.b-code
     9500                      AND bb-list.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9501             end.
     9502           END CASE.
     9503         end.
     9504         if available bb-list then do:
     9505         if p-from-macro then do:
     9506             glog = yes.
     9507           end.
     9508           else do:
     9509             glog = no.
     9510             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9511                     view-as alert-box question buttons OK-Cancel update glog.
     9512             if not glog then return error.
     9513           end.
     9514           line-rec = recid (bb-list).
     9515           v-seq = 1.
     9516           for each buf_bb-list-hist:
     9517             delete buf_bb-list-hist.
     9518           end.
     9519           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9520           for each bb-list:
     9521             if line-rec <> recid (bb-list) then delete bb-list.
     9522           end.
     9523           tot-lns = 1.
     9524           run UI-on.
     9525         end.
     9526       end.
     9527       else do:
     9528         glog = no.
     9529         if not p-from-macro then do:
     9530         message "Оставить коды ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9531                 view-as alert-box question buttons OK-Cancel update glog.
     9532           if not glog then
     9533           return no-apply.
     9534         end.
     9535         assign
     9536         lns-cnt = 0
     9537         lns-ignore = 0
     9538         .
     9539         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9540         for each bb-list:
     9541           if bb-list.to-del = ? then do:
     9542             assign
     9543             bb-list.to-del = no
     9544             .
     9545           end.
     9546           else do:
     9547             delete bb-list.
     9548           end.
     9549         end.
     9550         tot-lns = lns-cnt.
     9551         run UI-on.
     9552         message
     9553         "Оставлено строк :" lns-cnt skip(0)
     9554         string(if lns-ignore <> 0
     9555         then ("Проигнорировано строк :" + string(lns-ignore))
     9556         else "":U)
     9557         .
     9558       end.
     9559     end.
     9560   end procedure.
     9561   procedure process-one-good :
     9562   define input  parameter rs-list-method as character no-undo .
     9563   define input  parameter rs-status as character no-undo .
     9564   define input  parameter line-mode as character no-undo .
     9565   define parameter buffer goods for ub.goods.
     9566     do
     9567     on error undo, return error
     9568     :
     9569         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     9570         run get-prt-and-unit in this-procedure (
     9571                                                  input ub.goods.prt-root
     9572                                                 ,input ub.goods.unit-base
     9573                                                 ,output l-empty-scale
     9574                                                 ) .
     9575         FIND FIRST ub.gds-obj WHERE
     9576                   ub.gds-obj.obj-type = p-curr-obj-type AND
     9577                   ub.gds-obj.obj-code = p-curr-obj-code AND
     9578                   ub.gds-obj.artic = ub.goods.artic AND
     9579                   ub.gds-obj.prod-type = ub.goods.prod-type AND
     9580                   ub.gds-obj.prod-code = ub.goods.prod-code nO-LOCK NO-ERROR.
     9581         if v-is-restaurant then do:
     9582           find first buf_fbr-gds-obj no-lock where
     9583                     buf_fbr-gds-obj.obj-type = p-curr-obj-type
     9584                 AND buf_fbr-gds-obj.obj-code = p-curr-obj-code
     9585                 AND buf_fbr-gds-obj.gds-code = ub.goods.gds-code no-error .
     9586           if    available buf_fbr-gds-obj
     9587             and not buf_fbr-gds-obj.is-cd
     9588           then
     9589              NEXT.
     9590         end.
     9591         run get-gds-obj-fields in this-procedure(
     9592                                                    buffer ub.gds-obj
     9593                                                   ,input no
     9594                                                   ,input ub.goods.gds-code
     9595                                                   ,input p-curr-obj-code
     9596                                                   ,input p-curr-obj-type
     9597                                                   ,output for-fact-qnty
     9598                                                   ,output cashparts
     9599                                                   ,output v-is-null-price
     9600                                                   ) no-error .
     9601       RUN term-prt in this-procedure (
     9602                     input rs-list-method
     9603                   , input rs-status
     9604                   , input line-mode
     9605                   , input ub.gds-prt.prt-root
     9606                   , input ?) no-error.
     9607     end.
     9608   end procedure.
     9609   procedure get-gds-obj-fields :
     9610   define parameter buffer buf_gds-obj for ub.gds-obj .
     9611   define input parameter par-find-buffer as logical no-undo .
     9612   define input parameter par-gds-code like ub.goods.gds-code no-undo .
     9613   define input parameter par-obj-code like ub.clients.obj-code no-undo .
     9614   define input parameter par-obj-type like ub.clients.obj-type no-undo .
     9615   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
     9616   define output parameter par-cash-parts as logical no-undo .
     9617   define output parameter p-is-null-price like ub.fbr-gds-obj.is-null-price  no-undo .
     9618     do
     9619     on error undo, return error
     9620     :
     9621       if par-find-buffer then do:
     9622         find first buf_gds-obj no-lock where
     9623                   buf_gds-obj.gds-code = par-gds-code AND
     9624                   buf_gds-obj.obj-type = par-obj-type AND
     9625                   buf_gds-obj.obj-code = par-obj-code no-error .
     9626       end.
     9627       if not avail buf_gds-obj
     9628       and (p-curr-obj-type = 'маг':U and ub.shop.is-catering = no)
     9629       then do:
     9630         return.
     9631       end.
     9632       assign
     9633       par-fact-qnty = (if available buf_gds-obj
     9634                        then buf_gds-obj.fact-qnty
     9635                        else 0)
     9636       .
     9637       assign
     9638       par-cash-parts = (if available buf_gds-obj
     9639                         then buf_gds-obj.cash-parts
     9640                         else no)
     9641       .
     9642       if available buf_fbr-gds-obj then do:
     9643         assign
     9644         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
     9645         .
     9646       end.
     9647     end.
     9648   end procedure.
     9649   procedure get-prt-and-unit :
     9650   define input parameter par-prt-root like ub.goods.prt-root no-undo .
     9651   define input parameter par-unit-base like ub.goods.unit-base no-undo .
     9652   define output parameter par-empty-scale as logical no-undo .
     9653     do
     9654     on error undo, return error
     9655     :
     9656       FIND FIRST ub.gds-prt where
     9657                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
     9658       assign
     9659       par-empty-scale =  NOT (v-doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
     9660       .
     9661       FIND FIRST ub.units WHERE
     9662                  ub.units.unit-name = par-unit-base NO-LOCK .
     9663     end.
     9664   end procedure.
     9665   procedure proc-b-cd :
     9666   define input parameter p-fill-temp-shop as logical no-undo .
     9667     do
     9668     on error undo, return error
     9669     :
     9670     if available ub.shop then do:
     9671       assign
     9672       temp-shop.obj-code =    ub.shop.obj-code
     9673       t-all-prt         =    ub.shop.all-prt
     9674       t-loc-alt         =    ub.shop.cd-loc-alt
     9675       t-loc-base        =    ub.shop.cd-loc-base
     9676       .
     9677       if (t-all-prt or
     9678       t-bc-alt     or
     9679       t-bc-base    or
     9680       t-loc-alt    or
     9681       t-loc-base   or
     9682       t-parts-all  or
     9683       t-parts-not-blank or
     9684       t-parts-ser       or
     9685       t-pb-alt          or
     9686       t-pb-base         or
     9687       t-sc-base ) = no then do:
     9688         message
     9689         substitute("Для магазина &1 не выбран ни один тип кодов, выбираем основные локальные&2"  +
     9690                    "Иначе список формировать бесполезно"
     9691                    , shop.obj-code
     9692                    , chr(10))
     9693         view-as alert-box warning.
     9694         t-loc-base = yes.
     9695       end.
     9696       if p-fill-temp-shop then do:
     9697         assign
     9698         temp-shop.obj-code = p-curr-obj-code
     9699         temp-shop.all-prt = T-all-prt
     9700         temp-shop.cd-bc-alt = T-bc-alt
     9701         temp-shop.cd-bc-base = T-bc-base
     9702         temp-shop.cd-loc-alt = T-loc-alt
     9703         temp-shop.cd-loc-base = T-loc-base
     9704         temp-shop.cd-parts-all = T-parts-all
     9705         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9706         temp-shop.cd-parts-ser = T-parts-ser
     9707         temp-shop.cd-pb-alt = T-pb-alt
     9708         temp-shop.cd-pb-base = T-pb-base
     9709         temp-shop.cd-sc-base = T-sc-base
     9710         .
     9711       end.
     9712     end.
     9713     else do:
     9714       assign
     9715       temp-shop.obj-code =  ub.store.obj-code
     9716       t-loc-base         =   yes
     9717       t-all-prt          = no
     9718       t-bc-alt           = no
     9719       t-bc-base          = no
     9720       t-loc-alt          = no
     9721       t-parts-all        = no
     9722       t-parts-not-blank  = no
     9723       t-parts-ser        = no
     9724       t-pb-alt           = no
     9725       t-pb-base          = no
     9726       t-sc-base          = no
     9727       .
     9728       if p-fill-temp-shop then do:
     9729         assign
     9730         temp-shop.obj-code = p-curr-obj-code
     9731         temp-shop.all-prt = T-all-prt
     9732         temp-shop.cd-bc-alt = T-bc-alt
     9733         temp-shop.cd-bc-base = T-bc-base
     9734         temp-shop.cd-loc-alt = T-loc-alt
     9735         temp-shop.cd-loc-base = T-loc-base
     9736         temp-shop.cd-parts-all = T-parts-all
     9737         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9738         temp-shop.cd-parts-ser = T-parts-ser
     9739         temp-shop.cd-pb-alt = T-pb-alt
     9740         temp-shop.cd-pb-base = T-pb-base
     9741         temp-shop.cd-sc-base = T-sc-base
     9742         .
     9743       end.
     9744     end.
     9745       display
     9746       T-loc-base
     9747       T-pb-base
     9748       T-loc-alt
     9749       T-pb-alt
     9750       T-bc-base
     9751       T-sc-base
     9752       T-bc-alt
     9753       T-all-prt
     9754       T-parts-ser
     9755       T-parts-not-blank
     9756       T-parts-all
     9757       with frame Dialog-Frame.
     9758     run proc-cd2 in this-procedure .
     9759     end.
     9760   end procedure.
     9761   procedure proc-cd2 :
     9762   define variable v-fvalue as character no-undo .
     9763     do
     9764     on error undo, return error
     9765     :
     9766       if available temp-list then v-fvalue = temp-list.fvalue.
     9767       CASE v-fvalue:
     9768         when "all"
     9769         or
     9770         when "goods"
     9771         or
     9772         when "gds-list"
     9773         or
     9774         when "file-gds" then do:
     9775           ENABLE
     9776           T-loc-base
     9777           T-loc-alt
     9778           T-all-prt
     9779           WITH FRAME Dialog-Frame.
     9780         end.
     9781         otherwise do:
     9782           disable
     9783           T-loc-base
     9784           T-loc-alt
     9785           T-all-prt
     9786           WITH FRAME Dialog-Frame.
     9787         end.
     9788       END CASE.
     9789     end.
     9790   end procedure.
     9791   procedure proc-b-optimize :
     9792   define input  parameter p-from-macro as logical   no-undo .
     9793   define input parameter rs-list-method as character no-undo .
     9794   define input parameter rs-status as character no-undo .
     9795   define input parameter p-option as character no-undo .
     9796   define variable v-cnt as integer   no-undo .
     9797   define variable v-temp-seq as integer   no-undo .
     9798   define variable l-prod-bc-petrolium as logical no-undo .
     9799   define variable l-prod-bc-weight as logical no-undo .
     9800   define buffer b-str_bb-list for bb-list.
     9801   define buffer b-code_bb-list for bb-list.
     9802   define buffer buf_prod-bc for ub.prod-bc.
     9803   define buffer buf_bar-code for ub.bar-code.
     9804   define buffer buf_goods for ub.goods.
     9805   define buffer buf_bb-list-hist for bb-list-hist.
     9806     do
     9807     on error undo, return error
     9808     :
     9809       case p-option:
     9810         when "delnprod-bc" then  do:
     9811           for each b-str_bb-list no-lock :
     9812             if b-str_bb-list.b-str <> "":U
     9813             and b-str_bb-list.loc-ean  = no
     9814             then do:
     9815               for each b-code_bb-list where
     9816                          b-code_bb-list.b-code = b-str_bb-list.b-code
     9817                     AND  (b-code_bb-list.b-str = "":U
     9818                           or
     9819                           b-code_bb-list.loc-ean = yes)
     9820                     :
     9821                 delete b-code_bb-list.
     9822                 v-cnt = v-cnt + 1.
     9823               end.
     9824             end.
     9825           end.
     9826         end.
     9827         when "repnprod-bc" then  do:
     9828           for each b-code_bb-list :
     9829             if b-code_bb-list.b-str =  '':U
     9830             or b-code_bb-list.loc-ean = yes then do:
     9831               find first buf_prod-bc no-lock where
     9832                         buf_prod-bc.b-code = b-code_bb-list.b-code
     9833                     AND buf_prod-bc.bc-on = yes no-error.
     9834               if available buf_prod-bc then do:
     9835                 find first b-str_bb-list no-lock where
     9836                            b-str_bb-list.b-code = buf_prod-bc.b-code
     9837                       AND  b-str_bb-list.b-str = buf_prod-bc.b-str no-error .
     9838                 if available b-str_bb-list then next.
     9839                 assign
     9840                 l-prod-bc-petrolium = no
     9841                 l-prod-bc-weight = no
     9842                 .
     9843   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9844   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9845     (buffer buf_prod-bc
     9846     ,input  'weight=request':u
     9847     ,output l-prod-bc-weight
     9848     ) no-error .
     9849                 if error-status:error
     9850                 or l-prod-bc-weight then next.
     9851   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9853     (buffer buf_prod-bc
     9854     ,input  'petrolium=request':u
     9855     ,output l-prod-bc-petrolium
     9856     ) no-error .
     9857                 if error-status:error
     9858                 or l-prod-bc-petrolium then next.
     9859                 find first buf_bar-code no-lock where
     9860                             buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     9861                 if available buf_bar-code then do:
     9862                   find first ub.goods no-lock where
     9863                             ub.goods.gds-code = buf_bar-code.gds-code no-error.
     9864                   if available goods then do:
     9865                     run get-prt-and-unit in this-procedure (
     9866                                                             input ub.goods.prt-root
     9867                                                             ,input ub.goods.unit-base
     9868                                                             ,output l-empty-scale
     9869                                                             ) .
     9870                     delete b-code_bb-list.
     9871                     v-cnt = v-cnt + 1.
     9872                     run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     9873                   end.
     9874                 end.
     9875               end.
     9876             end.
     9877           end.
     9878         end.
     9879       end case.
     9880       lns-cnt = lns-cnt - v-cnt.
     9881     end.
     9882   end procedure.
     9883   procedure proc-b-obj :
     9884     define input parameter p-mode as character no-undo .
     9885     define variable v-rid-list as character no-undo .
     9886     define buffer buf_clients  for ub.clients.
     9887     define buffer buf_user-obj for ub.user-obj.
     9888     do
     9889     on error undo, return error
     9890     :
     9891       find first buf_user-obj no-lock where
     9892                  buf_user-obj.user-id = v-cntxt-userid
     9893              and buf_user-obj.db-num = v-cntxt-db-num
     9894              and buf_user-obj.obj-type  = p-curr-obj-type
     9895              and buf_user-obj.obj-code  = p-curr-obj-code no-error .
     9896       assign
     9897         v-rid-list = ( if available buf_user-obj then string( recid( buf_user-obj ) ) else "":U )
     9898       .
     9899       if p-mode = "change":U then do:
     9900   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9901   run userobjs_select-one in this-procedure
     9902     (input  parparentproc
     9903     ,input  v-cntxt-db-num
     9904     ,input  v-cntxt-userid
     9905     ,input  v-cntxt-host-code-obj
     9906     ,input  v-cntxt-obj-type
     9907     ,input  v-cntxt-obj-code
     9908     ,output v-user-select
     9909     ,output v-sel-obj-type
     9910     ,output v-sel-obj-code
     9911     )  .
     9912         if v-user-select then do:
     9913           FIND FIRST buf_user-obj NO-LOCK WHERE
     9914                     buf_user-obj.obj-type = buf_user-obj.obj-type
     9915               and buf_user-obj.obj-code = buf_user-obj.obj-code
     9916               and buf_user-obj.db-num = v-cntxt-db-num
     9917               and buf_user-obj.user-id = v-cntxt-userid    NO-ERROR.
     9918           if not available buf_user-obj then do: return no-apply. end.
     9919           find first buf_clients no-lock where
     9920                     buf_clients.obj-type = buf_user-obj.obj-type
     9921                 and buf_clients.obj-code = buf_user-obj.obj-code no-error.
     9922           if not available buf_clients then do: return error. end.
     9923           assign
     9924             p-curr-obj-type = buf_clients.obj-type
     9925             p-curr-obj-code = buf_clients.obj-code
     9926             v-host-code = buf_clients.host-code
     9927             v-obj-type = buf_clients.obj-type
     9928             v-obj-code = buf_clients.obj-code
     9929             v-obj-name = buf_clients.obj-name
     9930           .
     9931           display
     9932           v-obj-name
     9933           v-obj-type
     9934           v-obj-code
     9935           with frame Dialog-Frame.
     9936         end.
     9937       end.
     9938     end.
     9939   end procedure.
     9940   procedure restore-codes :
     9941   define input  parameter p-codes as character no-undo .
     9942   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     9943   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
     9944     do
     9945     on error undo, return error return-value
     9946     :
     9947       if p-obj-type = 'маг':U then do:
     9948       assign
     9949       temp-shop.obj-code =   p-obj-code
     9950       t-all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
     9951       t-bc-alt          =    no
     9952       t-bc-base         =    no
     9953       t-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
     9954       t-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
     9955       t-parts-all       =    no
     9956       t-parts-not-blank =    no
     9957       t-parts-ser       =    no
     9958       t-pb-alt = no
     9959       t-pb-base = no
     9960       t-sc-base = no
     9961       temp-shop.all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
     9962       temp-shop.cd-bc-alt          =    no
     9963       temp-shop.cd-bc-base         =    no
     9964       temp-shop.cd-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
     9965       temp-shop.cd-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
     9966       temp-shop.cd-parts-all       =    no
     9967       temp-shop.cd-parts-not-blank =    no
     9968       temp-shop.cd-parts-ser       =    no
     9969       temp-shop.cd-pb-alt          =    no
     9970       temp-shop.cd-pb-base         =    no
     9971       temp-shop.cd-sc-base         =    no
     9972       .
     9973       display
     9974       T-loc-base
     9975       T-pb-base
     9976       T-loc-alt
     9977       T-pb-alt
     9978       T-bc-base
     9979       T-sc-base
     9980       T-bc-alt
     9981       T-all-prt
     9982       T-parts-ser
     9983       T-parts-not-blank
     9984       T-parts-all
     9985       with frame Dialog-Frame.
     9986     end.
     9987     run proc-cd2 in this-procedure .
     9988     end.
     9989   end procedure.
     9990   procedure proc-macros :
     9991   define variable glog as logical no-undo .
     9992   define variable v-option as integer no-undo .
     9993   define buffer buf_bb-list-hist for bb-list-hist.
     9994   define buffer buf_macro-list-hist for macro-list-hist.
     9995   if can-find(first macro-list-hist) then do:
     9996     run gbl/d-askw.w ( input "Сохранение макроса"
     9997                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     9998                   ,input "|"
     9999                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    10000                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    10001                   ,input 1
    10002                   ,input 3
    10003                   ,output v-option).
    10004     if v-option = 3 then return no-apply.
    10005     v-option = 1.
    10006   end.
    10007   else do:
    10008     message
    10009     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    10010     view-as alert-box question buttons yes-no update glog.
    10011     v-option = 2.
    10012     if not glog then do:
    10013       return no-apply.
    10014     end.
    10015   end.
    10016     do
    10017     on error undo, return error
    10018     :
    10019     assign
    10020       f-name = "default.bbm"
    10021       glog = yes
    10022       .
    10023     system-dialog get-file f-name
    10024       filters "Макрос создания списка кодов *.bbm" "*.bbm"
    10025       ask-overwrite
    10026       save-as
    10027       use-filename
    10028       update glog
    10029       default-extension "bbm".
    10030     if not glog then do:
    10031       apply "entry" to br-list in frame Dialog-Frame.
    10032       return no-apply.
    10033     end.
    10034     run waitfram-show in this-procedure ("Сохранение макроса формирования списка кодов.    ЖДИТЕ...").
    10035     output stream PrnLibStream to value (f-name).
    10036     case v-option:
    10037       when 1 then do:
    10038         for each buf_macro-list-hist:
    10039           export stream PrnLibStream
    10040           buf_macro-list-hist.
    10041         end.
    10042       end.
    10043       when 2 then do:
    10044     for each buf_bb-list-hist:
    10045         export stream PrnLibStream
    10046         buf_bb-list-hist.
    10047     end.
    10048       end.
    10049     end case.
    10050     output stream PrnLibStream close.
    10051     run waitfram-hide in this-procedure .
    10052     end.
    10053   end procedure.
    10054   PROCEDURE reposition-goods :
    10055   define input  parameter p-direction   as character no-undo .
    10056   define output parameter p-recid as recid no-undo .
    10057   define buffer buf_goods for ub.goods.
    10058   case p-direction :
    10059     when "first":U
    10060     then do:
    10061       get first br-list.
    10062     end.
    10063     when "last":U
    10064     then do:
    10065       get last br-list.
    10066     end.
    10067     when "prev":U
    10068     then do:
    10069       get prev br-list.
    10070       if not available bb-list then do:
    10071         message
    10072         "Это первый товар списка"
    10073         view-as alert-box.
    10074       end.
    10075     end.
    10076     when "next":U
    10077     then do:
    10078       get next br-list.
    10079       if not available bb-list then do:
    10080         message
    10081         "Это последний товар списка"
    10082         view-as alert-box.
    10083       end.
    10084     end.
    10085   end case .
    10086   find first buf_goods no-lock where
    10087           buf_goods.gds-code = bb-list.gds-code no-error.
    10088   if available bb-list then do:
    10089     assign
    10090     p-recid = recid(buf_goods)
    10091     .
    10092   end.
    10093   run reposition-query in this-procedure
    10094     (input recid(bb-list)
    10095     ).
    10096   END PROCEDURE.
    10097   PROCEDURE reposition-query :
    10098   define input parameter p-recid as recid no-undo .
    10099   if p-recid <> ?
    10100   then do:
    10101     reposition br-list to recid p-recid no-error.
    10102   end.
    10103   do with frame Dialog-Frame:
    10104     apply "entry":u to browse br-list .
    10105     apply "VALUE-CHANGED":u to browse br-list .
    10106   end.
    10107   END PROCEDURE.
    10108   procedure proc-cd :
    10109   define variable v-num as integer no-undo .
    10110   define variable v-action as character no-undo .
    10111   define buffer buf_bb-list for bb-list.
    10112   if p-curr-obj-type <> 'маг':U then return.
    10113   run gbl/d-askw.w (
    10114                     input "Отослать на кассы"
    10115                    ,input "Передача/удаление списка кодов на кассу/с кассы"
    10116                    ,input "|"
    10117                    ,input "Передача|Удаление|Отмена"
    10118                    ,input "Передача на кассу|Удаление с кассы|Отмена"
    10119                    ,input 1
    10120                    ,input 3
    10121                    ,output v-num).
    10122   if v-num = 3 then return.
    10123   v-action = (if v-num = 1 then "U":U else "D").
    10124   define variable v-chk-act-host-code as integer   no-undo .
    10125   define variable v-ok as logical no-undo .
    10126   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10128     (input  'маг':U
    10129     ,input  abs(p-curr-obj-code)
    10130     ,output v-chk-act-host-code
    10131     )  .
    10132   if v-action = "U" then do:
    10133   define variable vss-include-info75 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10134   do:
    10135     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10136       (input  v-cntxt-db-num
    10137       ,input  v-cntxt-userid
    10138       ,input  0
    10139       ,input  'actn_cashdesk-goods_add-def':U
    10140       ,input  'object':U
    10141       ,input  v-chk-act-host-code
    10142       ,input  'маг':U
    10143       ,input  abs(p-curr-obj-code)
    10144       ,input  0
    10145       ,input  0
    10146       ,input  0
    10147       ,input  true
    10148       ,output v-ok
    10149       )  .
    10150   end.
    10151   end.
    10152   else do:
    10153   define variable vss-include-info76 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10154   do:
    10155     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10156       (input  v-cntxt-db-num
    10157       ,input  v-cntxt-userid
    10158       ,input  0
    10159       ,input  'actn_cashdesk-goods_deletion':U
    10160       ,input  'object':U
    10161       ,input  v-chk-act-host-code
    10162       ,input  'маг':U
    10163       ,input  abs(p-curr-obj-code)
    10164       ,input  0
    10165       ,input  0
    10166       ,input  0
    10167       ,input  true
    10168       ,output v-ok
    10169       )  .
    10170   end.
    10171   end.
    10172   if NOT v-ok then return .
    10173   for each bc-list:
    10174     delete bc-list.
    10175   end.
    10176   for each pbc-list:
    10177     delete pbc-list.
    10178   end.
    10179   for each buf_bb-list:
    10180     if buf_bb-list.b-str <> ""
    10181     and buf_bb-list.loc-ean = no
    10182     then do:
    10183       create pbc-list.
    10184       buffer-copy buf_bb-list to pbc-list.
    10185       if v-action = "D" then do:
    10186         assign
    10187         pbc-list.del = yes.
    10188       end.
    10189       release pbc-list.
    10190     end.
    10191     else do:
    10192       find first bc-list where
    10193                 bc-list.b-code = buf_bb-list.b-code no-error.
    10194       if not available bc-list then do:
    10195       create bc-list.
    10196       buffer-copy buf_bb-list to bc-list.
    10197         if v-action = "D" then do:
    10198           assign
    10199           bc-list.del = yes.
    10200         end.
    10201       release bc-list.
    10202       end.
    10203     end.
    10204   end.
    10205   if can-find(first bc-list no-lock) then do:
    10206       run str/diallog.w ( input parparentproc
    10207                     , input this-procedure
    10208                     , input 'str/send-bcn.p':U
    10209                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10210                     , input (if can-find(first pbc-list no-lock)
    10211                              then yes
    10212                              else no)
    10213                     , input 'Прервать'
    10214                     , input (if v-action = "U"
    10215                              then 'Отсылка бар-кодов на кассу'
    10216                              else 'Удаление бар-кодов c кассы'
    10217                              )) no-error .
    10218   end.
    10219   if can-find(first pbc-list no-lock) then do:
    10220       run str/diallog.w ( input parparentproc
    10221                     , input this-procedure
    10222                     , input 'str/s-prdbcn.p':U
    10223                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10224                     , input no
    10225                     , input 'Прервать'
    10226                     , input (if v-action = "U"
    10227                              then 'Отсылка ДопБК на кассу'
    10228                              else 'Удаление ДопБК с кассы'
    10229                              )) no-error .
    10230   end.
    10231   end procedure.
    10232   PROCEDURE proc-parts-cashparts :
    10233   define input parameter rs-list-method as character no-undo .
    10234   define variable v-value-integer as integer   no-undo .
    10235   define variable glog as logical no-undo .
    10236   define variable v-message as character no-undo .
    10237   define variable v-item as character no-undo .
    10238   assign
    10239   frame Dialog-Frame
    10240   t-parts-not-blank
    10241   t-parts-all
    10242   .
    10243   if not (t-parts-not-blank or t-parts-all ) then do:
    10244     message
    10245     "У Вас не включен флаг <на непуст. № парт.> ИЛИ <все партии>" skip
    10246     "Вы уверены, что Вам нужны коды ПАРТИЙ?"
    10247     view-as alert-box question buttons yes-no update glog.
    10248     if not glog then do:
    10249       undo, return error .
    10250     end.
    10251   end.
    10252   glog = yes.
    10253   CASE rs-list-method:
    10254     when "parts-cashparts":U then do:
    10255       assign
    10256       v-message = substitute("Лок.коды партий свободной зоны &1&2 для товаров с продажей по партиям", chr(10), stat-line(rs-status))
    10257       .
    10258     end.
    10259     when "parts-ean-cashparts":U then do:
    10260       assign
    10261       v-message = substitute("Лок.коды (EAN) партий свободной зоны &1&2 для товаров с продажей по партиям", chr(10), stat-line(rs-status))
    10262       .
    10263     end.
    10264   END CASE.
    10265   message
    10266   v-message
    10267   view-as alert-box question buttons OK-Cancel update glog.
    10268   if not glog then do:
    10269     return error.
    10270   end.
    10271   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10272   run userobjs_select-one in this-procedure
    10273     (input  parparentproc
    10274     ,input  v-cntxt-db-num
    10275     ,input  v-cntxt-userid
    10276     ,input  v-cntxt-host-code-obj
    10277     ,input  v-cntxt-obj-type
    10278     ,input  v-cntxt-obj-code
    10279     ,output v-user-select
    10280     ,output v-sel-obj-type
    10281     ,output v-sel-obj-code
    10282     )  .
    10283   if not v-user-select then do:
    10284     return error.
    10285   end.
    10286   CASE rs-list-method:
    10287     when "parts-cashparts":U then do:
    10288       assign
    10289       dsp-rs = substitute("Лок.коды партий свободной зоны на &1&2 для товаров с продажей по партиям &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10290       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    10291       .
    10292     end.
    10293     when "parts-ean-cashparts":U then do:
    10294       assign
    10295       dsp-rs = substitute("Лок.коды (EAN) партий свободной зоны на &1&2 для товаров с продажей по партиям &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10296       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    10297       .
    10298     end.
    10299   END CASE.
    10300   v-no-hist = 0.
    10301   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10302                                       , input-output v-seq
    10303                                       , input 0
    10304                                       , input '':U
    10305                                       , input dsp-rs
    10306                                       , input tot-lns
    10307                                       , input rs-list-method
    10308                                       , input rs-status
    10309                                       , input v-item
    10310                                       , input '':U
    10311                                       , input ?
    10312                                       ).
    10313   END PROCEDURE.
    10314   PROCEDURE proc-parts-last-date :
    10315   define input parameter rs-list-method as character no-undo .
    10316   define variable v-value-integer as integer   no-undo .
    10317   define variable glog as logical no-undo .
