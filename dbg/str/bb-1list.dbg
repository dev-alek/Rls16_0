    10319   define variable v-item as character no-undo .
    10320   assign
    10321   frame Dialog-Frame
    10322   t-parts-not-blank
    10323   t-parts-all
    10324   .
    10325   if not (t-parts-not-blank or t-parts-all ) then do:
    10326     message
