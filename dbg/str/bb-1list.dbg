     3535         by ub.parts.part-code:
     3536           IF FIRST-OF(ub.parts.part-code) then do:
     3537             if ub.parts.part-code <> "" and  temp-shop.cd-parts-not-blank then NEXT.
     3538             FOR EACH p-bar-code NO-LOCK WHERE
     3539                       p-bar-code.gds-code = ub.goods.gds-code AND
     3540                       p-bar-code.in-code = ub.parts.in-code AND
     3541                       p-bar-code.part-code = ub.parts.part-code AND
     3542                       p-bar-code.node-code = ub.bar-code.node-code AND
     3543                       p-bar-code.unit-cli = ub.goods.unit-base:
     3544   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3545   FIND FIRST b-units No-LOCK WHERE
     3546              b-units.unit-name = p-bar-code.unit-cli No-ERROR.
     3547   if (temp-shop.cd-bc-base or temp-shop.cd-loc-base) and (NOT petrol-trk
