    10415       dsp-rs = substitute("Лок.коды (EAN) зарезерв. партий на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    10416       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    10417       .
    10418     end.
    10419   END CASE.
    10420   v-no-hist = 0.
    10421   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10422                                       , input-output v-seq
    10423                                       , input 0
    10424                                       , input '':U
    10425                                       , input dsp-rs
    10426                                       , input tot-lns
    10427                                       , input rs-list-method
    10428                                       , input rs-status
