     4114   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4115   define variable varscales-pref45 as character no-undo .
     4116   define variable varpgscales-pref45 as character no-undo.
     4117   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4118   define variable varscales-pref-type46 as character no-undo.
     4119   varscales-pref45  = ?.
     4120   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4121     (input  'sclspref':u
     4122     ,input  '':u
     4123     ,input  '':u
     4124     ,input  0
     4125     ,input  '':u
     4126     ,input  '':u
     4127     ,input  '':u
     4128     ,input  no
     4129     ,output varscales-pref45
     4130     ,output varscales-pref-type46
     4131     ) no-error .
     4132   if varscales-pref45 = ? then do:
     4133     assign
     4134     varscales-pref45 = '21,23,25':U.
     4135   end.
     4136   define variable varpgscales-pref-type46 as character no-undo.
     4137   varpgscales-pref45  = ?.
     4138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4139     (input  'scpgpref':u
     4140     ,input  '':u
     4141     ,input  '':u
     4142     ,input  0
     4143     ,input  '':u
     4144     ,input  '':u
     4145     ,input  '':u
     4146     ,input  no
     4147     ,output varpgscales-pref45
     4148     ,output varpgscales-pref-type46
     4149     ) no-error .
     4150   if varpgscales-pref45 = ? then do:
     4151     assign
     4152     varpgscales-pref45 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     4153   end.
     4154   on value-changed of a-n-c in frame Dialog-Frame do:
     4155     run proc-valchg-a-n-c in this-procedure  no-error.
     4156     return no-apply.
     4157   end.
     4158   on any-printable of br-list in frame Dialog-Frame do:
     4159     run proc-any-printable-br-list in this-procedure   no-error.
     4160     return no-apply.
     4161   end.
     4162   on backspace of br-list in frame Dialog-Frame do:
     4163     run proc-backspace-br-list in this-procedure   no-error.
     4164     return no-apply.
     4165   end.
     4166   ON return OF loc-code IN FRAME Dialog-Frame do:
     4167     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     4168     return no-apply.
     4169   end.
     4170   ON return, Ctrl-J OF loc-b-str IN FRAME Dialog-Frame do:
     4171     run proc-mouse-dbl-click-loc-b-str in this-procedure   no-error.
     4172     return no-apply.
     4173   end.
     4174   ON return, Ctrl-J OF loc-name IN FRAME Dialog-Frame do:
     4175     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     4176     return no-apply.
     4177   end.
     4178   PROCEDURE proc-valchg-a-n-c:
     4179     case input frame Dialog-Frame a-n-c :
     4180       when "art" then do:
     4181         apply "entry" to br-list in frame Dialog-Frame.
     4182         hide loc-name loc-code
     4183        loc-b-str
     4184         in frame Dialog-Frame.
     4185         loc-art = "".
     4186       end.
     4187       when "name" then do:
     4188         enable loc-name with frame Dialog-Frame.
     4189         disp loc-name with frame Dialog-Frame.
     4190         hide loc-art loc-code
     4191        loc-b-str
     4192         in frame Dialog-Frame.
     4193         apply "entry" to loc-name in frame Dialog-Frame.
     4194       end.
     4195       when "code"
     4196    or when "DataMatrix" then
     4197       do:
     4198         enable loc-code with frame Dialog-Frame.
     4199         disp loc-code with frame Dialog-Frame.
     4200         hide loc-art loc-name
     4201        loc-b-str
     4202         in frame Dialog-Frame.
     4203         apply "entry" to loc-code in frame Dialog-Frame.
     4204       end.
     4205       when "b-str" then do:
     4206         enable loc-b-str with frame Dialog-Frame.
     4207         disp loc-b-str with frame Dialog-Frame.
     4208         hide loc-art loc-name loc-code in frame Dialog-Frame.
     4209         apply "entry" to loc-b-str in frame Dialog-Frame.
     4210       end.
     4211     end CASE.
     4212   END PROCEDURE.
     4213   PROCEDURE proc-any-printable-br-list :
     4214     if input frame Dialog-Frame a-n-c = "art" then do:
     4215       if last-event:label = " " and
     4216          loc-art = "" then
     4217       return error.
     4218       find first l-bb-list where
     4219                   l-bb-list.artic begins (loc-art + last-event:label)
     4220                  no-lock no-error.
     4221       if available l-bb-list then do:
     4222         loc-art = loc-art + last-event:label.
     4223         disp loc-art with frame Dialog-Frame.
     4224         line-rec = recid (l-bb-list).
     4225         reposition br-list to recid line-rec no-error.
     4226         apply "value-changed" to br-list in frame Dialog-Frame.
     4227       end.
     4228     end.
     4229   END PROCEDURE.
     4230   PROCEDURE proc-backspace-br-list:
     4231     if input frame Dialog-Frame a-n-c = "art" then do:
     4232       if loc-art = "" then
     4233         return error.
     4234       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4235       find first l-bb-list where
     4236                   l-bb-list.artic begins loc-art
     4237                  no-lock.
     4238       disp loc-art with frame Dialog-Frame.
     4239       line-rec = recid (l-bb-list).
     4240       reposition br-list to recid line-rec no-error.
     4241       apply "value-changed" to br-list in frame Dialog-Frame.
     4242     end.
     4243   END PROCEDURE.
     4244   PROCEDURE proc-mouse-dbl-click-loc-code:
     4245   def var str-code as integer no-undo.
     4246   define variable varresult   as character         no-undo.
     4247   define variable vartype-bc  as character         no-undo.
     4248   define variable varweight   as decimal           no-undo.
     4249   define buffer l-goods for ub.goods.
     4250   define buffer l-bar-code for ub.bar-code.
     4251   define buffer buf_bar-code for ub.bar-code .
     4252   define buffer buf_prod-bc for ub.prod-bc.
     4253   define buffer buf_place for ub.place.
     4254     if
     4255     frame Dialog-Frame
     4256     loc-code <> loc-code:screen-value OR
     4257        last-event:label = "Ctrl-J" then
     4258       contin = no.
     4259     assign
     4260     frame Dialog-Frame
     4261     loc-code
     4262     a-n-c.
     4263       find first l-bar-code no-lock where
     4264             l-bar-code.b-code = integer(loc-code) no-error.
     4265     if available l-bar-code then do:
     4266         if last-event:label = "Ctrl-J" then
     4267           find next l-bb-list where
     4268                    l-bb-list.gds-code = l-bar-code.gds-code
     4269                             and l-bb-list.b-code   = l-bar-code.b-code
     4270                   no-lock no-error.
     4271         else
     4272           find first l-bb-list where
     4273                    l-bb-list.gds-code = l-bar-code.gds-code
     4274                             and l-bb-list.b-code   = l-bar-code.b-code
     4275                   no-lock no-error.
     4276       if available l-bb-list then do:
     4277         line-rec = recid (l-bb-list).
     4278         reposition br-list to recid line-rec no-error.
     4279         apply "value-changed" to br-list in frame Dialog-Frame.
     4280       end.
     4281       else do:
     4282         message "Строка не найдена."
     4283                 view-as alert-box error.
     4284       end.
     4285     end.
     4286     else
     4287       message "Бар-код не найден."
     4288               view-as alert-box error.
     4289     apply "entry" to loc-code in frame Dialog-Frame.
     4290   END PROCEDURE.
     4291   PROCEDURE proc-mouse-dbl-click-loc-b-str:
     4292   def var str-code as integer no-undo.
     4293   define variable varresult   as character         no-undo.
     4294   define variable vartype-bc  as character         no-undo.
     4295   define variable varweight   as decimal           no-undo.
     4296   define buffer l-prod-bc for ub.prod-bc.
     4297   define buffer l-bar-code for ub.bar-code.
     4298   define buffer buf_bar-code for ub.bar-code .
     4299   define buffer buf_prod-bc for ub.prod-bc.
     4300   define buffer buf_place for ub.place.
     4301     assign
     4302     frame Dialog-Frame
     4303     loc-b-str.
     4304   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4305   (
     4306    input  parparentproc
     4307   ,input  loc-b-str
     4308   ,input  ?
     4309   ,input  p-curr-obj-type
     4310   ,input  p-curr-obj-code
     4311   ,input  yes
     4312   ,input  no
     4313   ,input  varscales-pref45
     4314   ,input  varpgscales-pref45
     4315   ,output varresult
     4316   ,output vartype-bc
     4317   ,output varweight
     4318   ,buffer buf_bar-code
     4319   ,buffer buf_prod-bc
     4320   ,buffer buf_place
     4321   ) no-error.
     4322     if available buf_prod-bc then do:
     4323       find first l-prod-bc where
     4324                   l-prod-bc.b-str = buf_prod-bc.b-str
     4325               AND l-prod-bc.b-code = buf_bar-code.b-code No-LOCK.
     4326       find first l-bb-list where
     4327                   l-bb-list.gds-code = buf_bar-code.gds-code AND
     4328                   l-bb-list.b-code = buf_bar-code.b-code AND
     4329                   l-bb-list.b-str = buf_prod-bc.b-str no-lock no-error.
     4330       if available l-bb-list then do:
     4331         line-rec = recid (l-bb-list).
     4332         reposition br-list to recid line-rec no-error.
     4333         apply "value-changed" to br-list in frame Dialog-Frame.
     4334       end.
     4335       else
     4336         message "Строка не найдена."
     4337                 view-as alert-box error.
     4338     end.
     4339     else do:
     4340       if available buf_bar-code then do:
     4341         find first l-bar-code where
     4342                     l-bar-code.b-code = buf_bar-code.b-code No-LOCK.
     4343         find first l-bb-list where
     4344                     l-bb-list.gds-code = buf_bar-code.gds-code AND
     4345                     l-bb-list.b-code = buf_bar-code.b-code AND
     4346                     l-bb-list.b-str = loc-b-str no-lock no-error.
     4347         if available l-bb-list then do:
     4348           line-rec = recid (l-bb-list).
     4349           reposition br-list to recid line-rec no-error.
     4350           apply "value-changed" to br-list in frame Dialog-Frame.
     4351         end.
     4352         else
     4353           message "Строка не найдена."
     4354                   view-as alert-box error.
     4355       end.
     4356       else
     4357         message "ДопБК не найден."
     4358                 view-as alert-box error.
     4359     end.
     4360     apply "entry" to loc-b-str in frame Dialog-Frame.
     4361   END PROCEDURE.
     4362   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4363     assign
     4364     frame Dialog-Frame
     4365     loc-name.
     4366       if last-event:label = "Ctrl-J" then
     4367         find next l-bb-list where
     4368                   can-find (ub.goods where ub.goods.artic = l-bb-list.artic and
     4369                   ub.goods.prod-type = l-bb-list.prod-type and
     4370                   ub.goods.prod-code = l-bb-list.prod-code and
     4371                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4372       else
     4373         find first l-bb-list where
     4374                   can-find (ub.goods where ub.goods.artic = l-bb-list.artic and
     4375                   ub.goods.prod-type = l-bb-list.prod-type and
     4376                   ub.goods.prod-code = l-bb-list.prod-code and
     4377                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4378       if available l-bb-list then do:
     4379         line-rec = recid (l-bb-list).
     4380         reposition br-list to recid line-rec no-error.
     4381            apply "value-changed" to br-list in frame Dialog-Frame.
     4382       end.
     4383       else do:
     4384         message "Строка не найдена."
     4385                 view-as alert-box error.
     4386       end.
     4387     apply "entry" to loc-name in frame Dialog-Frame.
     4388   END PROCEDURE.
     4389   on value-changed of br-list in frame Dialog-Frame do:
     4390   if not available bb-list or recid (bb-list) <> line-rec then do:
     4391       hide loc-art in frame Dialog-Frame.
     4392       loc-art = "".
     4393   end.
     4394   if available bb-list then do:     find ub.clients where ub.clients.obj-type = bb-list.prod-type                    and ub.clients.obj-code = bb-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = bb-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = bb-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = bb-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   disp tot-lns @ f-tot-lns with frame Dialog-Frame.
     4395   end.
     4396   ON CHOOSE OF b-print IN FRAME Dialog-Frame DO:
     4397   run rep/pri-lst.w (
     4398                  input parparentproc
     4399                , input p-curr-obj-type
     4400                , input p-curr-obj-code
     4401                , input "ALL"
     4402                , input "bb-list").
     4403   apply "entry" to br-list in frame Dialog-Frame.
     4404   END.
     4405   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame DO:
     4406   if not available bb-list then do:
     4407     message "Неправильно выбран товар."
     4408             view-as alert-box error.
     4409     return no-apply.
     4410   end.
     4411   find ub.goods where bb-list.artic = ub.goods.artic
     4412               and bb-list.prod-type = ub.goods.prod-type
     4413               and bb-list.prod-code = ub.goods.prod-code no-lock.
     4414   run str/showgds.p ( input parparentproc
     4415                      ,input this-procedure:handle
     4416                      ,input  goods.gds-code
     4417                      ,input 'ПРОСМОТР':U).
     4418   apply "entry" to br-list in frame Dialog-Frame.
     4419   END.
     4420   ON CHOOSE OF b-hist IN FRAME Dialog-Frame DO:
     4421   define buffer buf_bb-list-hist for bb-list-hist.
     4422   run prn-lib-open-stream  in this-procedure (
     4423                                                input parParentProc
     4424                                               ,input 43
     4425                                               ,input yes
     4426                                               ,input no
     4427                                               ).
     4428   find first buf_bb-list-hist no-lock where buf_bb-list-hist.id = 0 no-error .
     4429   PUT  STREAM PrnLibStream unformatted
     4430   SPACE(25) "История создания списка кодов "
     4431   (if available buf_bb-list-hist
     4432   then buf_bb-list-hist.des
     4433   else "БЕЗЫМЯННЫЙ") skip(0)
     4434   space(25) cur-time-print() skip(1)
     4435   .
     4436   put stream PrnLibStream unformatted
     4437   string("№", "X(9)") chr(32)
     4438   string("Действие", "X(9)") chr(32)
     4439   string("записей", "X(10)") chr(32)
     4440   string(" = итого", "X(12)") chr(32)
     4441   string("Множество", "X(155)")
     4442   skip(0)
     4443   fill('-':U, 9) chr(32)
     4444   fill('-':U, 9) chr(32)
     4445   fill('-':U, 9) chr(32)
     4446   fill('-':U, 12) chr(32)
     4447   fill('-':U, 155)
     4448   skip(0)
     4449   .
     4450   for each buf_bb-list-hist where buf_bb-list-hist.id > 0
     4451   by buf_bb-list-hist.id
     4452   :
     4453     put stream PrnLibStream unformatted
     4454     (if buf_bb-list-hist.line = 0
     4455      then string(buf_bb-list-hist.id, ">>>>>>>>9")
     4456      else fill(chr(32) , 9)
     4457     )  chr(32)
     4458     (if buf_bb-list-hist.item_ <> '':U
     4459      then string(buf_bb-list-hist.hist-mode, "X(8)")
     4460      else fill( chr(32), 8)) chr(32)
     4461     string(buf_bb-list-hist.num-add, "->>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4462     string(buf_bb-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4463     string(buf_bb-list-hist.des, "X(155)") skip.
     4464   end.
     4465   output stream prnlibstream close.
     4466     run prn-lib-prn-file in this-procedure (
     4467                                               input parParentProc
     4468                                               ,input 8
     4469                                               ).
     4470     apply "entry" to br-list in frame Dialog-Frame.
     4471   END.
     4472   ON CHOOSE OF b-clr IN FRAME Dialog-Frame  DO:
     4473   define variable glog as logical no-undo .
     4474   define buffer buf-bb-list-hist for bb-list-hist.
     4475   glog = no.
     4476   message "Удаление всех строк списка. Вы уверены ?"
     4477           view-as alert-box question buttons OK-Cancel update glog.
     4478   if not glog then return no-apply.
     4479   if session:set-wait-state( "COMPILER" )  then .
     4480   for each bb-list:
     4481     delete bb-list.
     4482   end.
     4483   if session:set-wait-state( "" )  then .
     4484   tot-lns = 0.
     4485   v-seq = 1.
     4486   for each buf-bb-list-hist:
     4487     delete buf-bb-list-hist.
     4488   end.
     4489   run create-bb-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     4490                                        , input-output v-seq
     4491                                        , input 0
     4492                                        , input '0':U
     4493                                        , input "# Список кодов очищен."
     4494                                        , input 0
     4495                                        , input "clear"
     4496                                        , input '':U
     4497                                        , input '':U
     4498                                        , input '':U
     4499                                        , input ?
     4500                                        ).
     4501   display
     4502   tot-lns @ f-tot-lns
     4503   ? @ ub.clients.obj-name
     4504   ? @ ub.gds-prt.node-name
     4505   ? @ ub.bar-code.b-code with frame Dialog-Frame.
     4506   run UI-on.
     4507   END.
     4508   ON VALUE-CHANGED OF RS-Status IN FRAME Dialog-Frame DO:
     4509     assign
     4510     RS-status.
     4511   END.
     4512   ON CHOOSE OF b-cd IN FRAME Dialog-Frame DO:
     4513   run proc-b-cd in this-procedure  ( input no) no-error.
     4514   if error-status:error then return no-apply.
     4515   apply "entry" to br-list in frame Dialog-Frame.
     4516   END.
     4517   ON CHOOSE OF b-optimize IN FRAME Dialog-Frame DO:
     4518   if optimize-option = "" then do:
     4519     run gbl/pop-up.p (self:handle, no) no-error.
     4520   end.
     4521   if optimize-option = "" then do:
     4522     return no-apply.
     4523   end.
     4524   run create-bb-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4525                                       , input-output v-seq
     4526                                       , input 0
     4527                                       , input '~~':U
     4528                                       , input substitute('Оптимизация списка &1 - &2'
     4529                                                     , stat-line(rs-status)
     4530                                                     , optimize-label)
     4531                                       , input tot-lns
     4532                                       , input 'optimize'
     4533                                       , input rs-status
     4534                                       , input optimize-option
     4535                                       , input '':U
     4536                                       , input ?
     4537                                       ).
     4538   run rs-do in this-procedure ( input no, input no, input 'optimize', input rs-status, input 'ДОБАВЛЕНИЕ':U, input (v-seq - 1)) no-error .
     4539   if error-status:error then do:
     4540     optimize-option = "".
     4541     optimize-label = '':U.
     4542     return no-apply.
     4543   end.
     4544   apply "entry" to br-list in frame Dialog-Frame.
     4545   END.
     4546   define variable vss-include-info47 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4547   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     4548     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     4549     return no-apply.
     4550   end.
     4551   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4552   on F3 of frame Dialog-Frame anywhere do:
     4553     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     4554     return no-apply.
     4555   end.
     4556   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4557   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     4558     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     4559     return no-apply.
