    10434   PROCEDURE proc-parts-fib :
    10435   define input parameter rs-list-method as character no-undo .
    10436   define variable v-value-integer as integer   no-undo .
    10437   define variable glog as logical no-undo .
    10438   define variable v-message as character no-undo .
    10439   define variable v-item as character no-undo .
    10440   assign
    10441   frame Dialog-Frame
    10442   t-parts-not-blank
    10443   t-parts-all
    10444   .
    10445   if not (t-parts-not-blank or t-parts-all ) then do:
    10446     message
    10447     "У Вас не включен флаг <на непуст. № парт.> ИЛИ <все партии>" skip
    10448     "Вы уверены, что Вам нужны коды ПАРТИЙ?"
    10449     view-as alert-box question buttons yes-no update glog.
    10450     if not glog then do:
    10451       undo, return error .
    10452     end.
    10453   end.
    10454   glog = yes.
    10455   CASE rs-list-method:
    10456     when "parts-fib":U then do:
    10457       assign
    10458       v-message = substitute("Лок.коды ФиБ партий свободной зоны &1&2", chr(10), stat-line(rs-status))
    10459       .
    10460     end.
    10461     when "parts-rsrv-fib":U then do:
    10462       assign
    10463       v-message = substitute("Лок.коды зарезерв. ФиБ партий &1&2", chr(10), stat-line(rs-status))
    10464       .
    10465     end.
    10466     when "parts-ean-fib":U then do:
    10467       assign
