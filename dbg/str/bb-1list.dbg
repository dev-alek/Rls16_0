     3569         )  no-error .
     3570        if error-status:error then return error.
     3571   end.
     3572   if temp-shop.cd-pb-base or temp-shop.cd-pb-alt or temp-shop.cd-sc-base OR petrol-trk then do:
     3573     FOR EACH ub.prod-bc NO-LOCK WHERE
     3574              ub.prod-bc.b-code = p-bar-code.b-code
     3575                 :
