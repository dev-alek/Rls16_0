     8220     do
     8221     on error undo, return error return-value
     8222     :
     8223   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     8224   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     8225   define buffer pp_price-list   for ub.price-doc-forming-gds .
