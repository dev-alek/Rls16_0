     7044        if error-status :error then
     7045        message
     7046          vss-workfile vss-revision vss-description skip
     7047          error-status :get-message(1) skip
     7048          return-value skip
     7049          "4567"
     7050          view-as alert-box error
     7051        .
     7052     end.
     7053   end procedure.
     7054   procedure re-define :
     7055   define input-output parameter p-calc-method      as character no-undo .
     7056   define input        parameter p-gds-code         as integer   no-undo .
     7057     do
     7058     on error undo, return error return-value
     7059     :
     7060   define buffer buf_goods for ub.goods  .
     7061   define buffer buf_gds-grp for ub.gds-grp  .
     7062       case p-calc-method :
     7063         when 'Товар':U then do:
     7064              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     7065                   case buf_goods.calc-method:
     7066                     when 'Группа':U then do:
     7067                       find first buf_gds-grp no-lock where
     7068                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     7069                       p-calc-method  = buf_gds-grp.calc-method.
     7070                     end.
     7071                   otherwise do:
     7072                       p-calc-method  =  buf_goods.calc-method .
     7073                   end.
     7074                   end case.
     7075              run  re-define in this-procedure (
     7076                         input-output  p-calc-method ,
     7077                         input p-gds-code )  .
     7078         end.
     7079         when 'Группа':U then do:
     7080              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     7081              find first buf_gds-grp no-lock where
     7082                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     7083              run re-define in this-procedure (
     7084                         input-output buf_gds-grp.calc-method ,
     7085                         input p-gds-code )  .
     7086         end.
     7087         when 'Учетная':U or
     7088         when 'Учет-объект':U then do:
     7089              p-calc-method = 'УчетнаяS':U .
     7090         end.
     7091         when 'Учет-резерв':U then do:
     7092              p-calc-method = 'Учет-рзрвS':U.
     7093         end.
     7094         when 'Приходная':U or
     7095         when 'Прих-объект':U then do:
     7096              p-calc-method = 'ПриходнаяS':U.
     7097         end.
     7098         when 'Учет-безНДС':U then do:
     7099              p-calc-method = 'Учет-НДСS':U .
     7100         end.
     7101       end case.
     7102     end.
     7103   end procedure.
     7104   procedure create-line-pdf-mpl-lib :
