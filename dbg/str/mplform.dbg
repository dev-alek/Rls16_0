     4921         "round-method" p-round-method skip
     4922         "round-base"   p-round-base   skip
     4923         "price"        p-price-sale-doc             skip
     4924         view-as alert-box error .
     4925     end.
     4926   end.
     4927       if error-status :error then do:
     4928       message
     4929         error-status :get-message(1) skip
     4930         return-value skip
     4931         "pr-99"
     4932         view-as alert-box error
     4933       .
     4934       end.
     4935     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     4936     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     4937     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     4938     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     4939     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     4940     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     4941     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     4942     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     4943     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4944     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4945     p-prev-doc-code = if available bufold_price-doc-forming
     4946                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4947                          else "" .
     4948     end.
     4949   end procedure.
