     2157                         buf_bar-code.unit-cli <> buf_goods.unit-base
     2158                         :
     2159                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2160                          if error-status :error then next.
     2161                    run create-line-pdf-mpl-lib (
     2162                          input buf_price-doc-forming.plt-db-num
     2163                         ,input buf_price-doc-forming.plt-id
     2164                         ,input buf_price-doc-forming.pdf-db
     2165                         ,input buf_price-doc-forming.pdf-id
     2166                         ,input p-line-num
     2167                         ,input old_price-list.b-code
     2168                         ,input buf_goods.artic
     2169                         ,input buf_goods.prod-type
     2170                         ,input buf_goods.prod-code
     2171                         ,input ""
     2172                         ,input 0
     2173                         ,input old_price-list.price-sale
     2174                         ,input ""
     2175                         ,input 0
     2176                        ,input-output v-sec ) no-error .
     2177           end.
     2178       end.
     2179   end.
     2180   if par-pr-sclex = "yes" and
     2181      par-pr-notls = "yes" then do:
     2182       if v-cur-dn <> "" then do:
     2183           for each old_price-list no-lock where
     2184                    old_price-list.doc-num    = v-cur-dn and
     2185                    old_price-list.artic      = buf_goods.artic and
     2186                    old_price-list.prod-type  = buf_goods.prod-type and
     2187                    old_price-list.prod-code  = buf_goods.prod-code and
     2188                    old_price-list.main-price = no,
     2189                   first buf_bar-code no-lock where
     2190                         buf_bar-code.b-code   = old_price-list.b-code and
     2191                         buf_bar-code.in-code  = "" and
     2192                         buf_bar-code.unit-cli = buf_goods.unit-base
     2193                         :
     2194                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2195                          if error-status :error then next.
     2196                    run create-line-pdf-mpl-lib (
     2197                          input buf_price-doc-forming.plt-db-num
     2198                         ,input buf_price-doc-forming.plt-id
     2199                         ,input buf_price-doc-forming.pdf-db
     2200                         ,input buf_price-doc-forming.pdf-id
     2201                         ,input p-line-num
     2202                         ,input old_price-list.b-code
     2203                         ,input buf_goods.artic
     2204                         ,input buf_goods.prod-type
     2205                         ,input buf_goods.prod-code
     2206                         ,input ""
     2207                         ,input 0
     2208                         ,input old_price-list.price-sale
     2209                         ,input ""
     2210                         ,input 0
     2211                       ,input-output v-sec ) no-error .
     2212           end.
     2213       end.
     2214   end.
     2215   end.
     2216   end procedure.
     2217   procedure copy_new_price-doc-forming :
     2218   define input  parameter       p-recid      as recid no-undo .
     2219   define input-output parameter p-plt-db-num as integer   no-undo .
     2220   define input-output parameter p-plt-id     as integer   no-undo .
     2221   define output parameter       p-pdf-db-num as integer   no-undo .
     2222   define output parameter       p-pdf-id     as integer   no-undo .
     2223   define buffer buf_price-list-type        for ub.price-list-type  .
     2224   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     2225   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     2226   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     2227   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     2228   define variable v-host-code  as integer   no-undo .
     2229   define variable v-base-rate  as decimal   no-undo .
     2230   define variable v-base-scale as integer   no-undo .
     2231   define variable v-exch-rate  as decimal   no-undo .
     2232   define variable v-exch-scale as integer   no-undo .
     2233   define variable v-base as logical   no-undo .
     2234   define variable v-name as character no-undo .
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2240     (output v-base
     2241     )  .
     2242   find first buf_price-list-type no-lock where
     2243              buf_price-list-type.plt-db-num = p-plt-db-num and
     2244              buf_price-list-type.plt-id     = p-plt-id no-error .
     2245   if error-status :error then return error "Не найден ТПЛ".
     2246   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     2247   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     2248       if available buf_price-doc-forming then do :
     2249           assign
     2250             v-base-rate  = buf_price-doc-forming.base-rate
     2251             v-base-scale = buf_price-doc-forming.base-scale
     2252             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     2253           .
     2254       end.
     2255       else do:
     2256           assign
     2257             v-base-rate  = 1
     2258             v-base-scale = 1
     2259             v-name       = "Автосоздание"
     2260           .
     2261       end.
     2262      create ub.price-doc-forming.
     2263      assign
     2264         ub.price-doc-forming.plt-id       = p-plt-id
     2265         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2266         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2267         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2268         ub.price-doc-forming.base-rate    = v-base-rate
     2269         ub.price-doc-forming.base-scale   = v-base-scale
     2270         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2271         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2272         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2273         ub.price-doc-forming.stts         = 0
     2274         ub.price-doc-forming.sys-date     = today
     2275         ub.price-doc-forming.sys-time     = time
     2276         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2277         ub.price-doc-forming.who          = v-cntxt-userid
     2278         ub.price-doc-forming.name         = v-name
     2279      .
     2280      assign
     2281       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2282       p-pdf-id      = ub.price-doc-forming.pdf-id
     2283       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2284       p-plt-id      = ub.price-doc-forming.plt-id
     2285      .
     2286     end.
     2287     if not available buf_price-doc-forming then return .
     2288   for each buf_price-doc-forming-attr no-lock where
     2289            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2290            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2291            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2292            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2293       create ub.price-doc-forming-attr.
     2294       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     2295       assign
     2296         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     2297         ub.price-doc-forming-attr.plt-id      = p-plt-id
     2298         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2299         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2300         .
     2301   end.
     2302   for each buf_price-doc-forming-gds no-lock where
     2303            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2304            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2305            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2306            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2307       create ub.price-doc-forming-gds.
     2308       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2309       assign
     2310         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2311         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2312         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2313         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2314       .
     2315   end.
     2316   for each buf_pd-forming-gds-attr no-lock where
     2317            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2318            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2319            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2320            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2321       create ub.price-doc-forming-gdsattr.
     2322       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2323       assign
     2324         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2325         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2326         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2327         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2328       .
     2329   end.
     2330   end procedure.
