     7652      end.
     7653   ASSIGN
     7654             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7655       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7656   .
     7657                 assign
     7658                   p-road-tax-rubl =  road-tax-rubl-loc
     7659                   p-road-tax-base =  road-tax-base-loc
     7660                   .
     7661               end.
     7662         end.
     7663     end.
     7664   end procedure.
     7665   procedure calc-sigma :
     7666    do
     7667    on error undo, return error return-value
     7668    :
     7669   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7670   define input-output parameter new-price as decimal no-undo .
     7671   define input parameter l-host as integer no-undo .
     7672   define input parameter l-code as integer no-undo .
     7673   define input parameter l-type as character no-undo .
     7674   define output parameter p-ret as logical no-undo .
     7675   define variable conf-par     as character no-undo.
     7676   define variable par-type     as character no-undo.
     7677   define variable i-sigma as decimal no-undo .
     7678   define variable cur-pr like ub.price-list.price-sale no-undo.
     7679   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7680   define variable cur-ex like ub.price-list.excise     no-undo.
     7681   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7682   define variable old-price as decimal no-undo .
     7683   p-ret = true  .
     7684   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     7685   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7687     (input  l-type
     7688     ,input  l-code
     7689     ,input  l-bcode
     7690     ,input  0
     7691     ,input  0
     7692     ,output cur-dn
     7693     ,output cur-pr
     7694     ,output cur-rt
     7695     ,output cur-ex
     7696     )  .
     7697   old-price = cur-pr .
     7698   if old-price =  new-price then do:
     7699      p-ret = true .
     7700      return.
     7701   end.
     7702      i-sigma = decimal(par-pr-sigma) .
     7703      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     7704          p-ret = false .
     7705          new-price = old-price.
     7706          end.
     7707      else p-ret = true .
     7708   end.
     7709    end.
     7710   end procedure.
     7711   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7712   define variable var-pr-r-b as character no-undo .
     7713   define variable v-str2 as character no-undo .
     7714   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7716     (output var-pr-r-b
     7717     )  .
     7718   function f-base-code return integer ( p-b-code as integer ).
     7719     define variable main-b-code as integer   no-undo .
     7720     define buffer buf_bar-code for ub.bar-code  .
     7721     find first buf_bar-code no-lock where
     7722               buf_bar-code.b-code = p-b-code no-error .
     7723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7724     (input  buf_bar-code.gds-code
     7725     ,input  ?
     7726     ,output main-b-code
     7727     )  .
     7728     return (main-b-code).
     7729   end function.
     7730   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7731     define variable f-cost     as decimal no-undo .
     7732     define variable f-cost-pc  as decimal no-undo .
     7733     define variable v-qnty     as decimal no-undo .
     7734     define variable v-sum      as decimal no-undo .
     7735     define variable fact_price as decimal no-undo .
     7736     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     7737                               ub.goods.prod-type = local-price-list.prod-type and
     7738                               ub.goods.prod-code = local-price-list.prod-code no-lock
     7739                               no-error .
     7740     assign
     7741       v-sum  =  0
     7742       v-qnty =  0
     7743       .
     7744     for each x_obj-group :
     7745         find ub.gds-obj no-lock where
     7746             ub.gds-obj.gds-code = ub.goods.gds-code and
     7747             ub.gds-obj.obj-type = x_obj-group.obj-type and
     7748             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     7749         if  available ub.gds-obj then
     7750           if ub.goods.gds-type = 'т':U then
     7751             assign
     7752               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     7753               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     7754               .
     7755             else  v-sum = ?.
     7756         else v-sum = ?.
     7757     end.
     7758     f-cost = v-sum / v-qnty .
     7759     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7760     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     7761     return (f-cost-pc).
     7762   end function.
     7763   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7764   define variable f-pr     as decimal no-undo .
     7765   define variable f-pr-pc  as decimal no-undo.
     7766   define variable v-qnty as decimal   no-undo .
     7767   define variable v-sum as decimal   no-undo .
     7768   define variable fact_price as decimal   no-undo .
     7769   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7770                          ub.goods.prod-type = local-price-list.prod-type and
     7771                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7772    assign
     7773      v-sum  =  0
     7774      v-qnty =  0
     7775      .
     7776   for each x_obj-group :
     7777   find ub.gds-obj no-lock where
     7778        ub.gds-obj.gds-code = ub.goods.gds-code and
     7779        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7780        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     7781   if  available ub.gds-obj then do:
     7782     if ub.goods.gds-type = 'т':U then
     7783       assign
     7784         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     7785         .
     7786       else f-pr = ?.
     7787   end.
     7788   else f-pr = ?.
     7789   end.
     7790     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7791     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     7792     return (f-pr-pc).
     7793   end function.
     7794   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7795   define variable f-cost   as decimal no-undo .
     7796   find first  x_obj-group.
     7797   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7798                          ub.goods.prod-type = local-price-list.prod-type and
     7799                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7800   find ub.gds-obj no-lock where
     7801        ub.gds-obj.gds-code = ub.goods.gds-code  and
     7802        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7803        ub.gds-obj.obj-code = x_obj-group.obj-code
     7804        no-error.
     7805   if  available ub.gds-obj then
     7806     if ub.goods.gds-type = 'т':U then
     7807       assign
     7808         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7809         .
     7810       else  f-cost = ?.
     7811   else f-cost = ?.
     7812     return ( f-cost ).
     7813   end function.
     7814   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7815   define variable f-pr   as decimal no-undo .
     7816   find first x_obj-group .
     7817   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7818                          ub.goods.prod-type = local-price-list.prod-type and
     7819                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7820   find ub.gds-obj no-lock where
     7821        ub.gds-obj.gds-code = ub.goods.gds-code and
     7822        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7823        ub.gds-obj.obj-code = x_obj-group.obj-code
     7824        no-error.
     7825   if  available ub.gds-obj then
     7826     if ub.goods.gds-type = 'т':U then
     7827       assign
     7828         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     7829         .
     7830       else  f-pr = ?.
     7831   else f-pr = ?.
     7832      return ( f-pr ).
     7833   end function.
     7834   procedure make-fact-order-lib3 :
     7835   define input  parameter p-recid as recid no-undo .
     7836   define output parameter p-fact-order-sys-from as decimal   no-undo .
     7837   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     7838   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7839   define buffer buf_price-list-type for ub.price-list-type  .
     7840   define variable v-shift-end-fact-order as decimal no-undo .
     7841   define variable v-day-end-fact-order   as decimal no-undo .
     7842   define variable v-fact-order           as decimal no-undo .
     7843     do
     7844     on error undo, return error return-value
     7845     :
     7846   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7847     if error-status :error then return error error-status :get-message(1) .
     7848   find first buf_price-list-type  no-lock where
     7849              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7850              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7851     if error-status :error then return error error-status :get-message(1) .
     7852    if buf_price-doc-forming.have-start-period = 1 then do:
     7853       case buf_price-list-type.work-date :
     7854         when int('1':U)  then
     7855           do :
     7856              run day-begin-fact-order
     7857                   ( buf_price-doc-forming.start-date ,
     7858                    output p-fact-order-sys-from ) no-error .
     7859                    if error-status :error then
     7860                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     7861                                               error-status :get-message(1) ,
     7862                                               return-value ).
     7863           end.
     7864         when int('2':U)   then
     7865           do :
     7866             run factord (
     7867                input   buf_price-doc-forming.start-shift-date
     7868               ,input   buf_price-doc-forming.sys-time
     7869               ,input   1
     7870               ,input   buf_price-doc-forming.start-shift-date
     7871               ,input   buf_price-doc-forming.start-shift-num
     7872               ,input   true
     7873               ,output  p-fact-order-sys-from
     7874               ,output  v-shift-end-fact-order
     7875               ,output  v-day-end-fact-order
     7876               ) no-error  .
     7877               if error-status :error then
     7878                    return error substitute ( "Ошибка из factord &1 &2" ,
     7879                                               error-status :get-message(1) ,
     7880                                               return-value ).
     7881           end.
     7882         when int('3':U)   then
     7883           do :
     7884             run factord (
     7885               input    buf_price-doc-forming.start-sys-date
     7886               ,input   buf_price-doc-forming.start-sys-time
     7887               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     7888               ,input   ?
     7889               ,input   ?
     7890               ,input   false
     7891               ,output  p-fact-order-sys-from
     7892               ,output  v-shift-end-fact-order
     7893               ,output  v-day-end-fact-order
     7894               ) no-error .
     7895               if error-status :error then
     7896                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7897                                               error-status :get-message(1) ,
     7898                                               return-value ).
     7899           end.
     7900       end case.
     7901     end.
     7902    if buf_price-doc-forming.have-end-period = 1 then do:
     7903       case buf_price-list-type.work-date :
     7904         when int('1':U)   then
     7905           do :
     7906              run factord-end-day
     7907                 ( buf_price-doc-forming.end-date ,
     7908                   output p-fact-order-sys-to ) no-error .
     7909                   if error-status :error then
     7910                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     7911                                               error-status :get-message(1) ,
     7912                                               return-value ).
     7913           end.
     7914         when int('2':U)   then
     7915           do :
     7916             run factord (
     7917                input   buf_price-doc-forming.end-shift-date
     7918               ,input   buf_price-doc-forming.sys-time
     7919               ,input   1
     7920               ,input   buf_price-doc-forming.end-shift-date
     7921               ,input   buf_price-doc-forming.end-shift-num
     7922               ,input   true
     7923               ,output  v-fact-order
     7924               ,output  p-fact-order-sys-to
     7925               ,output  v-day-end-fact-order
     7926               ) no-error .
     7927               if error-status :error then
     7928                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     7929                                           error-status :get-message(1) ,
     7930                                           return-value ).
     7931           end.
     7932         when int('3':U)   then
     7933           do :
     7934             run factord (
     7935                input   buf_price-doc-forming.end-sys-date
     7936               ,input   buf_price-doc-forming.end-sys-time
     7937               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     7938               ,input   ?
     7939               ,input   ?
     7940               ,input   false
     7941               ,output  p-fact-order-sys-to
     7942               ,output  v-shift-end-fact-order
     7943               ,output  v-day-end-fact-order
     7944               ) no-error .
     7945               if error-status :error then
     7946                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7947                                           error-status :get-message(1) ,
     7948                                           return-value ).
     7949           end.
     7950       end case.
     7951     end.
     7952     end.
     7953   end procedure.
     7954   procedure ver-dfc-mpl-lib3 :
     7955   define input  parameter p-recid as recid no-undo .
     7956   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7957   define buffer buf_price-list-type for ub.price-list-type  .
     7958   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7959   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     7960   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     7961   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     7962   define variable v-fact-order-sys-from   as decimal   no-undo .
     7963   define variable v-fact-order-sys-to     as decimal   no-undo .
     7964     do
     7965     on error undo, return error return-value
     7966    :
     7967   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7968     if error-status :error then return error error-status :get-message(1) .
     7969   find first buf_price-list-type  no-lock where
     7970              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7971              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7972     if error-status :error then return error error-status :get-message(1) .
     7973     if buf_price-list-type.stts = integer('1':U) then do:
     7974        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     7975     end.
     7976     if buf_price-list-type.bgr-id > 0 then do:
     7977         find ub.buyer-group where
     7978               ub.buyer-group.stts       = 0  and
     7979               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     7980               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     7981               no-lock no-error .
     7982         if not available ub.buyer-group then
     7983         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     7984     end.
     7985     if buf_price-list-type.sgr-id > 0 then do:
     7986         find ub.sum-group where
     7987               ub.sum-group.stts       = 0  and
     7988               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     7989               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     7990               no-lock no-error .
     7991         if not available ub.sum-group then
     7992         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     7993     end.
     7994     if buf_price-list-type.qgr-id > 0 then do:
     7995         find ub.qnty-group where
     7996              ub.qnty-group.stts       = 0  and
     7997              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     7998              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     7999              no-lock no-error .
     8000         if not available ub.qnty-group then
     8001         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     8002     end.
     8003     if buf_price-list-type.tog-id > 0 then do:
     8004         find ub.turnover-group where
     8005              ub.turnover-group.stts       = 0  and
     8006              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     8007              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     8008             no-lock no-error .
     8009         if not available ub.turnover-group then
     8010         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     8011     end.
     8012     if buf_price-list-type.gop-id > 0 then do:
     8013         find ub.grp-obj-price where
     8014               ub.grp-obj-price.stts       = 0  and
     8015               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     8016               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     8017               no-lock no-error .
     8018         if not available ub.grp-obj-price then
     8019         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     8020     end.
     8021     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     8022         find ub.grp-obj-price where
     8023               ub.grp-obj-price.stts       = 0  and
     8024               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     8025               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     8026               no-lock no-error .
     8027         if not available ub.grp-obj-price then
     8028         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     8029     end.
     8030      if buf_price-doc-forming.have-start-period = integer(true) then do:
     8031         case buf_price-list-type.work-date :
     8032             when int('1':U)     then
     8033               do :
     8034                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     8035               end.
     8036             when int('2':U)   then
     8037               do :
     8038                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     8039                   if buf_price-doc-forming.start-shift-num  = ? or
     8040                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     8041               end.
     8042             when int('3':U)     then
     8043               do :
     8044                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     8045                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     8046               end.
     8047         end case.
     8048      end.
     8049      if buf_price-doc-forming.have-end-period = integer(true) then do:
     8050         case buf_price-list-type.work-date :
     8051             when int('1':U)     then
     8052               do :
     8053                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     8054               end.
     8055             when int('2':U)   then
     8056               do :
     8057                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     8058                   if buf_price-doc-forming.end-shift-num  = ? or
     8059                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     8060               end.
     8061             when int('3':U)     then
     8062               do :
     8063                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     8064                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     8065               end.
     8066         end case.
     8067      end.
     8068      if buf_price-doc-forming.have-start-period = integer(true) and
     8069         buf_price-doc-forming.have-end-period = integer(true) then do:
     8070         case buf_price-list-type.work-date :
     8071             when int('1':U)     then
     8072               do :
     8073                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     8074               end.
     8075             when int('2':U)   then
     8076               do :
     8077                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     8078                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     8079                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     8080                   end.
     8081               end.
     8082             when int('3':U)     then
     8083               do :
     8084                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     8085                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     8086                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     8087                   end.
     8088               end.
     8089         end case.
     8090      end.
     8091   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
