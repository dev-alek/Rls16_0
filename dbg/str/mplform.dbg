     4801             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4802             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4803           .
     4804       end.
     4805       else dO:
     4806            case p-calc-method :
