     2371      .
     2372   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2373   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2374   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2375   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2376      INPUT iHost-Code    AS INTEGER,
     2377      INPUT iContract-Num AS INTEGER,
     2378      INPUT iGds-Code     AS INTEGER ):
     2379      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2380      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2381      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2382      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2383      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2384      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2385          INPUT  iHost-Code,
     2386          INPUT  iContract-Num,
     2387          OUTPUT iTmp-Extent3
     2388          ).
     2389      IF iTmp-Extent3[1] = 2 THEN DO:
     2390         ASSIGN
     2391            iTmp-Host-Code      = iTmp-Extent3[2]
     2392            iTmp-Contract-Num   = iTmp-Extent3[3]
     2393            .
     2394      END. ELSE DO:
     2395         ASSIGN
     2396            iTmp-Host-Code      = iHost-Code
     2397            iTmp-Contract-Num   = iContract-Num
     2398            .
     2399      END.
     2400      IF iGds-Code = ? THEN DO:
     2401         ASSIGN
     2402            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2403                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2404                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2405                           ).
     2406      END. ELSE DO:
     2407            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2408                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2409                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2410                              AND buf_Spec.Gds-Code      = iGds-Code
     2411                            ).
     2412      END.
     2413      RETURN (lRet).
     2414   END FUNCTION.
     2415   PROCEDURE MS-Contract-EXTENT-3:
     2416      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2417      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2418      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2419      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2420      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2421      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2422      FIND FIRST buf_Cont-2 WHERE
     2423                 buf_Cont-2.Host-Code      = i-Host-Code
     2424             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2425           NO-LOCK NO-ERROR.
     2426      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2427         RETURN.
     2428      END.
     2429      FOR FIRST buf_Ext-Classif WHERE
     2430                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2431           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2432                                               STRING(i-Contract-code)
     2433           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2434          NO-LOCK,
     2435          EACH buf_Cont WHERE
     2436               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2437           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2438          NO-LOCK:
     2439          ASSIGN
     2440             i-Ret[1] = 1
     2441             i-Ret[2] = buf_Cont.Host-code
     2442             i-Ret[3] = buf_Cont.Contract-code
     2443             .
     2444          LEAVE.
     2445      END.
     2446      IF i-Ret[1] <> 1 THEN DO:
     2447         FOR FIRST buf_Ext-Classif WHERE
     2448                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2449              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2450                                                  STRING(i-Contract-code)
     2451              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2452             NO-LOCK,
     2453             EACH buf_Cont WHERE
     2454                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2455              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2456             NO-LOCK:
     2457             ASSIGN
     2458                i-Ret[1] = 2
     2459                i-Ret[2] = buf_Cont.Host-code
     2460                i-Ret[3] = buf_Cont.Contract-code
     2461                .
     2462             LEAVE.
     2463         END.
     2464      END.
     2465      RETURN.
     2466   END PROCEDURE.
     2467   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
