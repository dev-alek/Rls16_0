     8094           ( input  p-recid ,
     8095             output v-fact-order-sys-from ,
     8096             output v-fact-order-sys-to   ) .
     8097   end.
     8098   define variable old-price as decimal   no-undo .
     8099   define variable v-kol-rec as integer   no-undo .
     8100   define variable v-gds-null-price as character no-undo initial "" .
     8101   define variable v-type as character no-undo .
     8102   v-kol-rec = 0.
     8103   for each buf_price-doc-forming-gds no-lock where
