     8237   define variable l-ok          as logical no-undo .
     8238   define variable check-par     as logical no-undo .
     8239   define variable main-b-code   as integer no-undo .
     8240   define variable par-pr-equ-dq as integer no-undo .
     8241   define variable v-price-sale  as decimal no-undo .
     8242   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8243   empty temp-table thbjattr_thbj-attr.
     8244   run adm/shattri.p (
     8245      input "get":U
     8246     ,input v-cntxt-obj-type
     8247     ,input v-cntxt-obj-code
     8248     ,input 'overval':U
     8249     ,input  ""
     8250     ,output v-value-character
     8251     ,output v-value-date
     8252     ,output v-value-decimal
     8253     ,output v-value-integer
     8254     ,output v-value-logical
     8255     ,output par-type
     8256     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8257     ) no-error .
     8258   for each thbjattr_thbj-attr :
     8259       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     8260   end.
     8261   if par-pr-equ-dq = 1 then return .
     8262   for each pdf_price-list exclusive-lock where
     8263            pdf_price-list.plt-id     = p-plt-id     and
     8264            pdf_price-list.plt-db-num = p-plt-db-num and
     8265            pdf_price-list.pdf-id     = p-pdf-id     and
     8266            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     8267           :
     8268       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     8269       check-par = false .
     8270      find first x_obj-group no-error .
     8271   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8273     (input  x_obj-group.obj-type
     8274     ,input  x_obj-group.obj-code
     8275     ,input  pdf_price-list.b-code
     8276     ,input  0
     8277     ,input  0
     8278     ,output l-doc-num2
     8279     ,output l-price-sale
     8280     ,output l-road-tax
     8281     ,output l-excise
     8282     ) no-error .
     8283       v-price-sale = l-price-sale .
     8284      for each x_obj-group :
     8285   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8287     (input  x_obj-group.obj-type
     8288     ,input  x_obj-group.obj-code
     8289     ,input  pdf_price-list.b-code
     8290     ,input  0
     8291     ,input  0
     8292     ,output l-doc-num2
     8293     ,output l-price-sale
     8294     ,output l-road-tax
     8295     ,output l-excise
     8296     ) no-error .
     8297       if v-price-sale <> l-price-sale  then do :
     8298         v-price-sale = l-price-sale.
     8299         leave .
     8300       end.
     8301      end.
     8302      find first x_obj-group no-error .
     8303   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8305     (input  x_obj-group.obj-type
     8306     ,input  x_obj-group.obj-code
     8307     ,input  pdf_price-list.b-code
     8308     ,input  0
     8309     ,input  0
     8310     ,output l-doc-num2
     8311     ,output l-price-sale
     8312     ,output l-road-tax
     8313     ,output l-excise
     8314     ) no-error .
     8315         if l-doc-num2 <> ? then do :
     8316           if l-price-sale = pdf_price-list.price-sale-doc
     8317           and v-price-sale = pdf_price-list.price-sale-doc
     8318           then do:
     8319                find first buf_goods no-lock where
