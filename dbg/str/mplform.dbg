     5093     if error-status :error then message
     5094       vss-workfile vss-revision vss-description skip
     5095       error-status :get-message(1) skip
     5096       return-value skip
     5097       ""
     5098       view-as alert-box error
     5099     .
     5100     case p-calc-method:
     5101       when 'Единая':U or
     5102       when 'Отсутствует':U or
     5103       when 'Не-считать':U or
     5104       when 'Откат_цен':U
     5105       then do:
     5106          p-increase-pc  = 0  .
     5107          p-round-method = 'Отключено':U .
     5108       end.
     5109       when 'Товар':U then do:
     5110         case buf-goods.calc-method:
     5111           when 'Группа':U then do:
     5112             find buf-gds-grp no-lock where
     5113                  buf-gds-grp.node-code = buf-goods.grp-code.
     5114              p-increase-pc  = loc-grp-increase-pc .
     5115              p-round-method = loc-grp-round-method .
     5116              p-round-base   = loc-grp-round-base .
     5117              g-g = true  .
     5118           end.
     5119           otherwise do:
     5120              p-increase-pc  =  loc-increase-pc .
     5121           end.
     5122         end case.
     5123         if g-g = false then do:
     5124             run gdsoattr-value
     5125                ( input 'round-method':U ,
     5126                  input p-gds-code ,
     5127                  input x_obj-group.obj-type ,
     5128                  input x_obj-group.obj-code ,
     5129                  output loc-rez ,
     5130                  output t-type
     5131                  ) no-error  .
     5132                 if error-status :error then message
     5133                   vss-workfile vss-revision vss-description skip
     5134                   error-status :get-message(1) skip
     5135                   "gdsoattr-value"
     5136                   view-as alert-box error .
     5137             case NUM-ENTRIES (loc-rez," ") :
     5138                 when 0 then do:
     5139                 end.
     5140                 when 1 then do:
     5141                   p-round-method = loc-rez .
     5142                   p-round-base   = 0 .
     5143                 end.
     5144                 when 2 then do:
     5145                   p-round-method = entry(1 , loc-rez, " " ).
     5146                   p-round-base   = decimal(entry(2 , loc-rez, " " )) .
     5147                 end.
     5148                 otherwise do:
     5149                   p-round-method = entry(1 , loc-rez, " " ).
     5150                   p-round-base   = decimal(entry(NUM-ENTRIES (loc-rez," ") , loc-rez, " " )) .
     5151                 end.
     5152             end case.
     5153         end.
     5154       end.
     5155     end case.
