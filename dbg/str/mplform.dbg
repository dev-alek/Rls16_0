     2658   procedure grp-obj-notcorr-value :
     2659   do
     2660   on error undo, return error
     2661   :
     2662   define input parameter p-node-code             as integer      no-undo.
     2663   define input parameter p-obj-type              as character    no-undo.
     2664   define input parameter p-obj-code              as integer      no-undo.
     2665   define output parameter p-notcorr              as character    no-undo init ?.
     2666   define output parameter p-range-notcorr     as integer      no-undo.
     2667   define output parameter p-exists-notcorr    as logical      no-undo.
     2668   define variable v-host-code as integer      no-undo.
     2669   DEFINE VARIABLE v-found as logical no-undo .
     2670   DEFINE VARIABLE v-exists as logical no-undo .
     2671   DEFINE VARIABLE v-range as integer no-undo .
     2672   DEFINE VARIABLE jj as integer no-undo .
     2673   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2674   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2675   define buffer buf_gds-grp for ub.gds-grp.
     2676   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2677   find first buf_gds-grp no-lock where
     2678              buf_gds-grp.node-code = p-node-code no-error .
     2679   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2680     message
     2681       vss-workfile vss-revision vss-description
     2682       skip "Не удалось найти группу товаров с кодом" p-node-code
     2683       view-as alert-box error .
     2684     undo, return error .
     2685   end.
     2686   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2688     (input  p-obj-type
     2689     ,input  p-obj-code
     2690     ,output v-host-code
     2691     ) no-error .
     2692   if error-status :error
     2693   then do:
     2694       message
     2695         vss-workfile vss-revision vss-description
     2696         skip "Не удалось найти фирму объекта"
     2697         skip p-obj-type p-obj-code
     2698         skip return-value
     2699         skip trim(error-status :get-message(1))
     2700       view-as alert-box error.
     2701       undo, return error .
     2702   end.
     2703   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2704   do while v-found = no and jj < 2:
     2705     if v-range <> 3 then do:
     2706       find first buf_gds-grp-obj no-lock
     2707           where buf_gds-grp-obj.node-code = p-node-code
     2708             and buf_gds-grp-obj.host-code = v-host-code
     2709             and buf_gds-grp-obj.obj-type  = p-obj-type
     2710             and buf_gds-grp-obj.obj-code  = p-obj-code
     2711       no-error .
     2712     end.
     2713     if v-range = 3 or not available buf_gds-grp-obj
     2714     then do:
     2715        if v-range <> 2 then do:
     2716           find first buf_gds-grp-obj no-lock
     2717               where buf_gds-grp-obj.node-code = p-node-code
     2718                 and buf_gds-grp-obj.host-code = v-host-code
     2719                 and buf_gds-grp-obj.obj-type  = ""
     2720                 and buf_gds-grp-obj.obj-code  = 0
     2721           no-error .
     2722         end.
     2723         if v-range = 2 or not available buf_gds-grp-obj
     2724         then do:
     2725             if v-range <> 1 then do:
     2726               find first buf_gds-grp-obj no-lock
     2727                   where buf_gds-grp-obj.node-code = p-node-code
     2728                   and buf_gds-grp-obj.host-code = 0
     2729                   and buf_gds-grp-obj.obj-type  = ""
     2730                   and buf_gds-grp-obj.obj-code  = 0
     2731               no-error .
     2732             end.
     2733             if v-range = 1 or not available buf_gds-grp-obj
     2734             then do:
     2735                 assign
     2736                     v-exists = no
     2737                 .
     2738             end.
     2739             else do:
     2740                 assign
     2741                     v-exists = yes
     2742                     v-range = 1
     2743                 .
     2744             end.
     2745         end.
     2746         else do:
     2747             assign
     2748                 v-exists = yes
     2749                 v-range  = 2
     2750             .
     2751         end.
     2752     end.
     2753     else do:
     2754         assign
     2755             v-exists = yes
     2756             v-range  = 3
     2757         .
     2758     end.
     2759     if available buf_gds-grp-obj
     2760     then do:
     2761       find first buf_gds-grp-obj-attr no-lock
     2762         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2763           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2764           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2765           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2766           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2767         no-error .
     2768       if available buf_gds-grp-obj-attr then do:
     2769         assign
     2770           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2771         .
     2772       end.
     2773       else do:
     2774         assign
     2775           v-notcorr-value = ?
     2776         .
     2777       end.
     2778       assign
     2779       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2780                           then yes
     2781                           else p-exists-notcorr)
     2782       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2783                         then v-range
     2784                         else p-range-notcorr
     2785       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2786                         then v-notcorr-value
     2787                         else p-notcorr
     2788       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2789       jj = jj + 1
     2790       .
     2791     end.
     2792     else do:
     2793       assign
     2794       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2795       jj = jj + 1
     2796       .
     2797     end.
     2798   end.
     2799   end.
     2800   end procedure.
     2801   define variable vss-include-info31 as character format "X(65)" no-undo
     2802   initial "@(#)$Workfile$ $Revision$".
     2803   procedure grplib-get-full-name :
     2804      define input parameter p-node-code  as integer      no-undo.
     2805      define output parameter p-full-name as character    no-undo.
     2806      do
     2807   on error undo, return error
     2808   :
     2809       define variable v-upper-code    as integer           no-undo.
     2810       define buffer buf_gds-grp       for ub.gds-grp.
     2811       define buffer buf_upper_gds-grp for ub.gds-grp.
     2812       find first buf_gds-grp no-lock
     2813            where buf_gds-grp.node-code = p-node-code
     2814       no-error.
     2815       if not available buf_gds-grp
     2816       then do:
     2817           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2818       end.
     2819       assign
     2820           p-full-name  = ""
     2821           v-upper-code = 1
     2822       .
     2823       do while buf_gds-grp.upper-code <> 0
     2824       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2825       :
     2826           assign
     2827               p-full-name  = buf_gds-grp.node-name
     2828                            + (if p-full-name <> "" then chr(47) else "")
     2829                            + p-full-name
     2830               v-upper-code = buf_gds-grp.upper-code
     2831           .
     2832           find first buf_gds-grp no-lock
     2833                where buf_gds-grp.node-code = v-upper-code
     2834           no-error.
     2835           if not available buf_gds-grp
     2836           then do:
     2837               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2838                                   + string( v-upper-code )
     2839                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2840           end.
     2841       end.
     2842       assign
     2843       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2844       .
     2845   end.
     2846   end .
     2847   procedure grplib-get-node-from-full-name :
     2848   define input parameter p-full-name as character no-undo .
     2849   define output parameter p-node-code as integer no-undo .
     2850   define variable v-ii as integer no-undo .
     2851   define variable v-upper-code as integer no-undo .
     2852   define variable v-root-code as integer no-undo .
     2853   define variable v-entry as character no-undo .
     2854   define buffer buf_gds-grp       for ub.gds-grp.
     2855   do
     2856   on error undo, return error
     2857   :
     2858     find first buf_gds-grp no-lock
     2859         where buf_gds-grp.upper-code = 0
     2860     no-error .
     2861     if not available buf_gds-grp
     2862     then do:
     2863         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2864     end.
     2865     else do:
     2866       assign
     2867       v-root-code = buf_gds-grp.node-code
     2868       .
     2869     end.
     2870     v-upper-code = v-root-code.
     2871     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2872       assign
     2873       v-entry = entry(v-ii, p-full-name, chr(47)).
     2874       if v-entry = '' then leave.
     2875       find first buf_gds-grp no-lock where
     2876                 buf_gds-grp.node-name = v-entry
     2877             and buf_gds-grp.upper-code = v-upper-code
     2878             no-error.
     2879       if not available buf_gds-grp then do:
     2880         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2881       end.
     2882       else do:
     2883         p-node-code = buf_gds-grp.node-code.
     2884         v-upper-code = buf_gds-grp.node-code.
     2885       end.
     2886     end.
     2887   end.
     2888   end .
     2889   procedure  chec-par :
     2890   define output parameter l-par as logical no-undo .
