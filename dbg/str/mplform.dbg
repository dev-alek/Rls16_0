      295   function cross-list returns logical (
      296     input parfirst-stream  as character,
      297     input parsecond-stream as character,
      298     input pardelim         as character).
      299     if pardelim = ""
      300     or pardelim = ?
      301     then do:
      302       assign
      303         pardelim = ","
      304       .
      305     end.
      306     define variable vari            as integer no-undo .
      307     define variable varresult-cross as logical no-undo .
      308     assign
      309       varresult-cross = no
      310     .
      311     def var v-num-parfirst-stream as integer no-undo .
      312     assign
      313       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      314     .
      315     do vari = 1 to v-num-parfirst-stream
      316     :
      317       if lookup(entry(vari, parfirst-stream, pardelim)
      318                ,parsecond-stream
      319                ,pardelim
      320                ) > 0 then do:
      321         assign
      322           varresult-cross = yes
      323         .
      324         leave.
      325       end.
      326     end.
      327     return varresult-cross .
      328   end function.
