     7354   procedure main-road-taxs :
     7355   define input param p-artic     like ub.gds-obj.artic     no-undo .
     7356   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     7357   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     7358   define input-output param p-road-tax-base as decimal no-undo .
     7359   define input-output param p-road-tax-rubl as decimal no-undo .
     7360       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     7361       define buffer   in-vatp-parts    for ub.parts   .
     7362       define buffer   in-vatp-doc      for ub.trn-doc .
     7363       define buffer   in-vatp-goods    for ub.goods   .
     7364       define buffer   in-vatp-sysconf  for ub.sysconf .
     7365       define buffer   in-vatp_doc-attr for ub.doc-attr.
     7366       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     7367       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     7368       define variable varinvprb                  as   character              no-undo.
     7369       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     7370       define variable cli-base-rate              as   decimal                no-undo.
     7371       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     7372       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     7373       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     7374       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     7375       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     7376       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     7377       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     7378       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7379       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     7380       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     7381       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7382       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     7383       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     7384       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     7385       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     7386       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     7387       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     7388       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     7389       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     7390       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     7391       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     7392       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     7393       define variable varinvatp-envd             as   character              no-undo.
     7394       define variable varinvatp-type             as   character              no-undo.
     7395     do
     7396     on error undo, return error return-value
     7397     :
     7398   define buffer buff-goods   for ub.goods    .
     7399   define buffer buf_gds-obj  for ub.gds-obj  .
     7400   define buffer buf_parts    for ub.parts    .
     7401   define buffer buf_trn-doc  for ub.trn-doc  .
     7402   define buffer buf_doc-line for ub.doc-line .
     7403   define variable is-petrolium as logical   no-undo .
     7404   define variable is-pieces   as  logical   no-undo .
     7405   define variable p-in-code   as  character no-undo .
     7406   define variable p-obj-type  as  character no-undo .
     7407   define variable p-obj-code  as  integer   no-undo .
     7408   define variable v-rec as recid no-undo .
     7409   define variable t-ret as logical no-undo .
     7410   define variable v-total-avrg-base as decimal no-undo .
     7411   define variable v-total-avrg-rubl as decimal no-undo .
     7412   define variable v-total-avrg-qnty as decimal no-undo .
     7413   define variable v-total-road-tax-base     as decimal no-undo .
     7414   define variable v-total-road-tax-rubl     as decimal no-undo .
     7415   define variable v-all-total-road-tax-base as decimal no-undo .
     7416   define variable v-all-total-road-tax-rubl as decimal no-undo .
     7417   assign
     7418     p-road-tax-base = 0
     7419     p-road-tax-rubl = 0
     7420     .
     7421     Find first buff-goods no-lock where
     7422                buff-goods.artic     = p-artic and
     7423                buff-goods.prod-type = p-prod-type and
     7424                buff-goods.prod-code = p-prod-code
     7425         no-error .
     7426         if available buff-goods then do:
     7427            v-rec = recid (buff-goods).
     7428            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7429   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7430     (
     7431        input p-artic
     7432     ,  input p-prod-type
     7433     ,  input p-prod-code
     7434     , output is-petrolium
     7435     , output is-pieces
     7436     ) .
     7437              t-ret =  session:SET-WAIT-STATE("") .
     7438              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     7439                 assign
     7440                   p-road-tax-base = 0
     7441                   p-road-tax-rubl = 0
     7442                   .
     7443                  return.
     7444              end.
     7445         end.
     7446         assign
     7447             v-total-avrg-qnty = 0
     7448             v-total-road-tax-base =  0
     7449             v-total-road-tax-rubl =  0
     7450             v-all-total-road-tax-base =  0
     7451             v-all-total-road-tax-rubl =  0
     7452             .
     7453       for each  x_obj-group ,
     7454           each buf_parts no-lock
     7455           where buf_parts.obj-type  = x_obj-group.obj-type
     7456             and buf_parts.obj-code  = x_obj-group.obj-code
     7457             and buf_parts.artic     = p-artic
     7458             and buf_parts.prod-type = p-prod-type
     7459             and buf_parts.prod-code = p-prod-code
     7460             and buf_parts.status_   = no
     7461             and buf_parts.out-code  = 'free-zone':U
     7462             and buf_parts.qnty      > 0
     7463         on error undo, return error
     7464         :
     7465            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     7466   assign
     7467     price-rubl-with-tax-loc = buf_parts.price-rubl
     7468     price-base-with-tax-loc = buf_parts.price-base
     7469   .
     7470   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7472     (output varinvprb
     7473     )  .
     7474     if buf_parts.out-code = 'free-zone':U     or
     7475        buf_parts.out-code = 'out-zone':U   or
     7476        buf_parts.doc-type = 'акт':U then do:
     7477       assign
     7478         in-vatp-have-vat-slt = yes.
     7479     end.
     7480     else do:
