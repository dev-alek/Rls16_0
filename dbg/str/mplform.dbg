     5570                       "для товара :" p-artic  "- расчет невозможен."
     5571                       view-as alert-box information .
     5572           end.
     5573       end.
     5574      when 'Отсутствует':U or
     5575      when "" then do:
     5576         run str/mplnovat.p
     5577           ( input  'Отсутствует':U    ,
     5578             input  table x_obj-group ,
     5579             input  p-b-code    ,
     5580             input  p-artic     ,
     5581             input  p-prod-type ,
     5582             input  p-prod-code ,
     5583             input  0 ,
     5584             input  v-doc-code ,
     5585             input  p-vat-pc      ,
     5586             input  p-slt-pc      ,
     5587             output vd  ,
     5588             output vd  ,
     5589             output cost-base   ,
     5590             output cost-rubl   ,
     5591             output cur-rt-base ,
     5592             output cur-rt-rubl
     5593             ).
     5594             cost-rubl = vd * p-exch-rate / p-exch-scale .
     5595             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5596             p-new-calc-method = 'Отсутствует':U .
     5597      end.
     5598      when 'Основная':U then do:
     5599      end.
     5600       when 'ПорогПр-НДС':U then do:
     5601         find first x_obj-group.
     5602             run calc-price-levelprod (
     5603               input 2          ,
     5604               input var-pr-r-b ,
     5605               input p-b-code   ,
     5606               input x_obj-group.obj-type ,
     5607               input x_obj-group.obj-code ,
     5608               output vd,
     5609               output v-descript
     5610             ) no-error.
     5611         if vd = 0 or vd = ?  then do:
     5612           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5613                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5614                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     5615                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     5616         end.
     5617         else do:
     5618             cost-rubl = vd .
     5619             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5620             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     5621         end.
     5622       end.
     5623       when 'ПорогПр+НДС':U then do:
     5624         find first x_obj-group.
     5625             run calc-price-levelprod (
     5626               input 1          ,
     5627               input var-pr-r-b ,
     5628               input p-b-code   ,
     5629               input x_obj-group.obj-type ,
     5630               input x_obj-group.obj-code ,
     5631               output vd ,
     5632               output v-descript
     5633             ) no-error.
     5634         if vd = 0 or vd = ?  then do:
     5635           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5636                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5637                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     5638                   view-as alert-box information .
     5639         end.
     5640         else do:
     5641             cost-rubl = vd .
     5642             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5643             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     5644         end.
     5645       end.
     5646       when 'Производит':U
     5647       then do:
     5648         find first x_obj-group.
     5649   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5651   (  input  p-b-code
     5652    , input  x_obj-group.obj-type
     5653    , input  x_obj-group.obj-code
     5654    , output v-PriceWithVat
     5655    , output vd
     5656    , output v-prod-vat
