    10081   assign frame  Dialog-Frame
    10082        buf_price-doc-forming-gds.price-sale-doc
    10083        buf_price-doc-forming-gds.road-tax-doc
    10084        buf_price-doc-forming-gds.excise-doc
    10085        .
    10086     assign
    10087       buf_price-doc-forming-gds.d-pcnt          = p-disc
    10088       buf_price-doc-forming-gds.calc-method     = c-m
    10089       buf_price-doc-forming-gds.price-calc-doc  = buf_price-doc-forming-gds.price-sale-doc
    10090       buf_price-doc-forming-gds.price-calc-rubl = buf_price-doc-forming-gds.price-sale-rubl
    10091       buf_price-doc-forming-gds.price-calc-base = buf_price-doc-forming-gds.price-sale-base
    10092       buf_price-doc-forming-gds.price-sale-rubl = buf_price-doc-forming-gds.price-sale-doc * p-exch-rate / p-exch-scale
    10093       buf_price-doc-forming-gds.road-tax-rubl   = buf_price-doc-forming-gds.road-tax-doc   * p-exch-rate / p-exch-scale
    10094       buf_price-doc-forming-gds.excise-rubl     = buf_price-doc-forming-gds.excise-doc     * p-exch-rate / p-exch-scale
    10095       buf_price-doc-forming-gds.price-sale-base = buf_price-doc-forming-gds.price-sale-rubl / p-base-rate * p-base-scale
    10096       buf_price-doc-forming-gds.road-tax-base   = buf_price-doc-forming-gds.road-tax-rubl   / p-base-rate * p-base-scale
    10097       buf_price-doc-forming-gds.excise-base     = buf_price-doc-forming-gds.excise-rubl     / p-base-rate * p-base-scale
    10098     .
    10099     assign
    10100       stp-cycle  =  true
    10101      .
    10102   END.
    10103   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
    10104   OR HELP OF FRAME Dialog-Frame
    10105   DO:
    10106   END.
    10107   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
    10108   DO:
    10109     stp-cycle  =  false.
    10110     return "error".
    10111   END.
    10112   ON CHOOSE OF B-save IN FRAME Dialog-Frame
    10113   DO:
    10114    run upd-field in this-procedure .
    10115    run calc-pr in this-procedure .
    10116    assign frame  Dialog-Frame
    10117        buf_price-doc-forming-gds.price-sale-doc
    10118        buf_price-doc-forming-gds.road-tax-doc
    10119        buf_price-doc-forming-gds.excise-doc
    10120        .
    10121     assign
    10122       buf_price-doc-forming-gds.d-pcnt          = p-disc
    10123       buf_price-doc-forming-gds.calc-method     = c-m
    10124       buf_price-doc-forming-gds.price-calc-doc  = buf_price-doc-forming-gds.price-sale-doc
    10125       buf_price-doc-forming-gds.price-calc-rubl = buf_price-doc-forming-gds.price-sale-rubl
    10126       buf_price-doc-forming-gds.price-calc-base = buf_price-doc-forming-gds.price-sale-base
    10127       buf_price-doc-forming-gds.price-sale-rubl = buf_price-doc-forming-gds.price-sale-doc * p-exch-rate / p-exch-scale
    10128       buf_price-doc-forming-gds.road-tax-rubl   = buf_price-doc-forming-gds.road-tax-doc   * p-exch-rate / p-exch-scale
    10129       buf_price-doc-forming-gds.excise-rubl     = buf_price-doc-forming-gds.excise-doc     * p-exch-rate / p-exch-scale
    10130       buf_price-doc-forming-gds.price-sale-base = buf_price-doc-forming-gds.price-sale-rubl / p-base-rate * p-base-scale
    10131       buf_price-doc-forming-gds.road-tax-base   = buf_price-doc-forming-gds.road-tax-rubl   / p-base-rate * p-base-scale
    10132       buf_price-doc-forming-gds.excise-base     = buf_price-doc-forming-gds.excise-rubl     / p-base-rate * p-base-scale
    10133     .
    10134     assign
    10135       stp-cycle  =  false
    10136      .
    10137   END.
    10138   ON LEAVE OF buf_price-doc-forming-gds.excise-doc IN FRAME Dialog-Frame
    10139   DO:
    10140       run upd-field in this-procedure no-error.
    10141   END.
    10142   ON LEAVE OF buf_price-doc-forming-gds.price-sale-doc IN FRAME Dialog-Frame
    10143   DO:
    10144     run upd-field in this-procedure no-error.
    10145     run calc-pr in this-procedure .
    10146   END.
    10147   ON LEAVE OF buf_price-doc-forming-gds.road-tax-doc IN FRAME Dialog-Frame
    10148   DO:
    10149       run upd-field in this-procedure no-error.
    10150   END.
    10151   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
    10152   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
    10153   if line-mode = 'ПРОСМОТР':U then
    10154   find first buf_price-doc-forming-gds no-lock where recid(buf_price-doc-forming-gds) = p-doc-rec .
    10155   else
    10156   find first buf_price-doc-forming-gds exclusive-lock where recid(buf_price-doc-forming-gds) = p-doc-rec .
    10157   find first buf_price-doc-forming no-lock where
    10158              buf_price-doc-forming.plt-id     = buf_price-doc-forming-gds.plt-id and
    10159              buf_price-doc-forming.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
    10160              buf_price-doc-forming.pdf-id     = buf_price-doc-forming-gds.pdf-id and
    10161              buf_price-doc-forming.pdf-db     = buf_price-doc-forming-gds.pdf-db
    10162              no-error.
    10163   find first buf_goods no-lock where
    10164              buf_goods.artic     = buf_price-doc-forming-gds.artic and
    10165              buf_goods.prod-type = buf_price-doc-forming-gds.prod-type and
    10166              buf_goods.prod-code = buf_price-doc-forming-gds.prod-code
    10167              no-error .
    10168   find first ub.goods no-lock where
    10169              ub.goods.artic     = buf_price-doc-forming-gds.artic and
    10170              ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
    10171              ub.goods.prod-code = buf_price-doc-forming-gds.prod-code
    10172              no-error .
    10173   find first buf_bar-code no-lock where
    10174              buf_bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
    10175   if buf_bar-code.unit-cli <> buf_goods.unit-base then do:
    10176       message "Изменение в режиме НЕОСНОВНЫЕ ЦЕНЫ !" view-as alert-box information .
    10177       return .
    10178    end.
    10179   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10180   on help of frame Dialog-Frame
    10181   do:
    10182     run gbl/app_help.p
    10183       (input this-procedure :file-name
    10184       ,input ''
    10185       ,input ?
    10186       ) no-error.
    10187     if error-status :error then do:
    10188       message
    10189         "Ошибка при вызове помощи"
    10190         error-status :get-message(1)
    10191         view-as alert-box .
    10192     end.
    10193   end.
    10194   run minbtn-set in this-procedure .
    10195   on choose of b-help in frame Dialog-Frame
    10196   do:
    10197     apply "help":u to frame Dialog-Frame .
    10198   end.
    10199   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10200   procedure minbtn-set :
    10201       do
    10202           on error undo, return error return-value
    10203           :
    10204           define variable ii              as integer       no-undo .
    10205           define variable fh              as widget-handle no-undo .
    10206           define variable hh              as widget-handle no-undo .
    10207           define variable v-h             as handle        extent 4 no-undo .
    10208           define variable v-name-button   as character     no-undo .
    10209           define variable v-help-old-x    as decimal       no-undo .
    10210           define variable v-help-old-y    as decimal       no-undo .
    10211           define variable v-help-old-size as decimal       no-undo .
    10212           define variable v-frame-width   as decimal       no-undo .
    10213           define variable jj              as integer       no-undo .
    10214           do
    10215               on error undo, return error
    10216               :
    10217               assign
    10218                   v-frame-width = frame Dialog-Frame:width - 0.3
    10219                   fh            = frame Dialog-Frame:first-child
    10220                   hh            = fh:first-child
    10221                   ii            = 1
    10222                   .
    10223               do while valid-handle(hh):
    10224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    10225                   do:
    10226                       case lc(hh:name) :
    10227                           when "b-help" then
    10228                               do:
    10229                                   hh:load-image-up("cmp/b-help.bmp":u) .
    10230                                   hh:load-image-down("cmp/b-help.bmp":u) .
    10231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    10232                                   hh:TOOLTIP = "Помощь" .
    10233                                   v-help-old-x = hh:column .
    10234                                   v-help-old-y = hh:row    .
    10235                                   v-help-old-size = hh:width .
    10236                                   hh:width-chars = 2.5 .
    10237                               end.
    10238                           when "b-print" then
    10239                               do:
    10240                                   hh:load-image("cmp/b-print.bmp":u) .
    10241                                   hh:TOOLTIP = "Печать" .
    10242                                   v-h[ii] = hh:handle .
    10243                                   ii = ii + 1 .
    10244                                   hh:width-chars = 3 .
    10245                               end.
    10246                           when "b-history" or
    10247                           when "b-hist" then
    10248                               do:
    10249                                   hh:load-image("cmp/b-hist.bmp":u) .
    10250                                   hh:TOOLTIP = "История" .
    10251                                   v-h[ii] = hh:handle .
    10252                                   ii = ii + 1 .
    10253                                   hh:width-chars = 3 .
    10254                               end.
    10255                           when "b-sch" then
    10256                               do:
    10257                                   hh:load-image("cmp/b-sch.bmp":u) .
    10258                                   hh:TOOLTIP = "Установка Фильтра" .
    10259                                   v-h[ii] = hh:handle .
    10260                                   ii = ii + 1 .
    10261                                   hh:width-chars = 3 .
    10262                               end.
    10263                           when "b-hist-user" then
    10264                               do:
    10265                                   hh:load-image("cmp/b-hist.bmp":u) .
    10266                                   hh:TOOLTIP = "История пользователя" .
    10267                                   ii = ii + 1 .
    10268                               end.
    10269                       end case.
    10270                   end.
    10271                   hh = hh:next-sibling.
    10272               end.
    10273               b-help:column = v-frame-width - b-help:width-chars.
    10274               jj = 0.
    10275               repeat ii = 4 to 1 by -1 :
    10276                   if valid-handle (v-h[ii] ) then
    10277                   do:
    10278                       jj  = jj + 1 .
    10279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    10280                       v-h[ii]:row    = v-help-old-y .
    10281                   end.
    10282               end.
    10283           end.
    10284       end.
    10285   end procedure.
    10286   MAIN-BLOCK:
    10287   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    10288      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
    10289     run enable_ui in this-procedure .
    10290     run loc-init in this-procedure  .
    10291     if  line-mode = "ЦИКЛ":U then do:
    10292        enable  b-exit-cycl with frame Dialog-Frame.
    10293        display b-exit-cycl  with frame Dialog-Frame.
    10294        end.
    10295     if  line-mode = 'ПРОСМОТР':U then do:
    10296        enable b-exit-cycl with frame Dialog-Frame.
    10297        b-exit-cycl:label = "Выход" .
    10298        disable buf_price-doc-forming-gds.price-sale-doc
    10299        B-save
    10300        b-calc
    10301        b-quit
    10302        with frame Dialog-Frame.
    10303     end.
    10304     WAIT-FOR GO OF FRAME Dialog-Frame.
    10305   END.
    10306   run disable_ui in this-procedure .
    10307   PROCEDURE calc-pr :
    10308   define variable v-tmp-price-doc as decimal   no-undo .
    10309   define variable v-tmp-price-rubl as decimal   no-undo .
    10310   define variable v-tmp-price-base as decimal   no-undo .
    10311   v-tmp-price-doc = input frame Dialog-Frame buf_price-doc-forming-gds.price-sale-doc .
    10312   v-tmp-price-rubl = v-tmp-price-doc   * p-exch-rate / p-exch-scale .
    10313   v-tmp-price-base = v-tmp-price-rubl   / p-base-rate * p-base-scale.
    10314   if available ub.gds-obj then do:
    10315     if v-rb-base = true  then do:
    10316         assign
    10317             new-avrg = v-tmp-price-base - ub.gds-obj.avrg-base
    10318             new-last = v-tmp-price-base - ub.gds-obj.last-base
    10319             pc-avrg  = (v-tmp-price-base / ub.gds-obj.avrg-base - 1) * 100
    10320             pc-last  = (v-tmp-price-base / ub.gds-obj.last-base - 1) * 100
    10321             old-avrg = old-price - ub.gds-obj.avrg-base
    10322             old-last = old-price - ub.gds-obj.last-base
    10323             op-avrg  = (old-price / ub.gds-obj.avrg-base - 1) * 100
    10324             op-last  = (old-price / ub.gds-obj.last-base - 1) * 100
    10325         .
    10326     end.
    10327     else do:
    10328         assign
    10329             new-avrg = v-tmp-price-rubl - ub.gds-obj.avrg-rubl
    10330             new-last = v-tmp-price-rubl - ub.gds-obj.last-rubl
    10331             pc-avrg  = (v-tmp-price-rubl / ub.gds-obj.avrg-rubl - 1) * 100
    10332             pc-last  = (v-tmp-price-rubl / ub.gds-obj.last-rubl - 1) * 100
    10333             old-avrg = old-price - ub.gds-obj.avrg-rubl
    10334             old-last = old-price - ub.gds-obj.last-rubl
    10335             op-avrg  = (old-price / ub.gds-obj.avrg-rubl - 1) * 100
    10336             op-last  = (old-price / ub.gds-obj.last-rubl - 1) * 100
    10337         .
    10338     end.
    10339     display  pc-avrg pc-last new-avrg new-last old-avrg old-last op-avrg op-last with frame Dialog-Frame no-error .
    10340   end.
    10341   if v-rb-base = true  then do:
    10342       new-old = v-tmp-price-base - old-price.
    10343       pc-prev = (v-tmp-price-base / old-price - 1) * 100.
    10344   end.
    10345   else do:
    10346       new-old = v-tmp-price-rubl - old-price.
    10347       pc-prev = (v-tmp-price-rubl / old-price - 1) * 100.
    10348   end.
    10349   display  new-old pc-prev   with frame Dialog-Frame no-error .
    10350   END PROCEDURE.
    10351   PROCEDURE disable_UI :
    10352     HIDE FRAME Dialog-Frame.
    10353   END PROCEDURE.
    10354   PROCEDURE enable_UI :
    10355     DISPLAY info b-curr old-price new-old pc-prev loc-gds-obj-avrg op-avrg pc-avrg
    10356             old-avrg new-avrg loc-gds-obg-last op-last pc-last old-last new-last
    10357             loc-in-code loc-in-date akt-num akt-date v-dis
    10358         WITH FRAME Dialog-Frame.
    10359     IF AVAILABLE buf_price-doc-forming-gds THEN
    10360       DISPLAY buf_price-doc-forming-gds.price-sale-doc
    10361             buf_price-doc-forming-gds.pdf-id buf_price-doc-forming-gds.artic
    10362             buf_price-doc-forming-gds.prod-code
    10363             buf_price-doc-forming-gds.prod-type buf_price-doc-forming-gds.b-code
    10364         WITH FRAME Dialog-Frame.
    10365     IF AVAILABLE ub.goods THEN
    10366       DISPLAY ub.goods.gds-name
    10367         WITH FRAME Dialog-Frame.
    10368     ENABLE info buf_price-doc-forming-gds.price-sale-doc b-calc B-save b-quit
    10369            B-Help buf_price-doc-forming-gds.pdf-id
    10370            buf_price-doc-forming-gds.artic buf_price-doc-forming-gds.prod-code
    10371            buf_price-doc-forming-gds.prod-type buf_price-doc-forming-gds.b-code
    10372            b-curr ub.goods.gds-name old-price new-old pc-prev loc-gds-obj-avrg
    10373            op-avrg pc-avrg old-avrg new-avrg loc-gds-obg-last op-last pc-last
    10374            old-last new-last loc-in-code loc-in-date akt-num akt-date v-dis
    10375         WITH FRAME Dialog-Frame.
    10376     VIEW FRAME Dialog-Frame.
    10377   END PROCEDURE.
    10378   PROCEDURE loc-init :
    10379   define variable cur-rt like ub.price-list.road-tax   no-undo.
    10380   define variable cur-ex like ub.price-list.excise     no-undo.
    10381   define variable cur-dn like ub.price-list.doc-num   no-undo.
    10382   define variable cur-pr like ub.price-list.price-sale   no-undo.
    10383   define buffer lp-price-doc-forming for ub.price-doc-forming.
    10384   define variable dor-nal as character no-undo .
    10385   define variable ff as logical no-undo .
    10386   define variable is-petrolium  as logical             no-undo.
    10387   define variable is-pieces     as logical             no-undo.
    10388   define variable v-rec as recid no-undo.
    10389   define variable t-ret as logical no-undo .
    10390   define buffer lp-price-doc for ub.price-doc  .
    10391   find first buf-price-list-type no-lock where
    10392              buf-price-list-type.plt-id     = buf_price-doc-forming-gds.plt-id and
    10393              buf-price-list-type.plt-db-num = buf_price-doc-forming-gds.plt-db-num
    10394              no-error .
    10395   run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf-price-list-type.gop-id , buf-price-list-type.gop-db-num ) .
    10396   run metod-delobj-usr (
    10397       buf_price-doc-forming.pdf-id  ,
    10398       buf_price-doc-forming.pdf-db ,
    10399       buf_price-doc-forming.plt-id    ,
    10400       buf_price-doc-forming.plt-db-num
    10401      ).
    10402   for each x_obj-group :
    10403       v-obj-type = x_obj-group.obj-type .
    10404       v-obj-code = x_obj-group.obj-code .
    10405       if ( v-obj-type = v-cntxt-obj-type and
    10406            v-obj-code = v-cntxt-obj-code )   then leave.
    10407   end.
    10408   c-m   = 'Отсутствует':U .
    10409   v-dis =  p-disc.
    10410     frame Dialog-Frame:title = frame Dialog-Frame:title + " -  " + line-mode + " объект " + v-obj-type + string (v-obj-code).
    10411     run tax-name in this-procedure ( input 'rdt':U, output  dor-nal) .
    10412     assign buf_price-doc-forming-gds.road-tax-doc :label in frame Dialog-Frame = dor-nal .
    10413         If available  buf_goods Then DO:
    10414             v-rec = recid (buf_goods).
    10415              t-ret =  session:SET-WAIT-STATE("GENERAL") .
    10416   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10417     (
    10418        input buf_price-doc-forming-gds.artic
    10419     ,  input buf_price-doc-forming-gds.prod-type
    10420     ,  input buf_price-doc-forming-gds.prod-code
    10421     , output is-petrolium
    10422     , output is-pieces
    10423     ) .
    10424              t-ret =  session:SET-WAIT-STATE("") .
    10425                 if ( hvrdtax( v-rec ) = true and
    10426                    is-petrolium = true )
    10427                   then  do :
    10428   define variable vss-include-info95 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10429   do:
    10430     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10431       (input  v-cntxt-db-num
    10432       ,input  v-cntxt-userid
    10433       ,input  0
    10434       ,input  'actn_overvalue_update':U
    10435       ,input  'object':U
    10436       ,input  v-cntxt-host-code-obj
    10437       ,input  v-cntxt-obj-type
    10438       ,input  v-cntxt-obj-code
    10439       ,input  0
    10440       ,input  0
    10441       ,input  0
    10442       ,input  true
    10443       ,output ff
    10444       )  .
    10445   end.
    10446                       if ff then do:
    10447                              enable buf_price-doc-forming-gds.road-tax-doc with frame Dialog-Frame .
    10448                       end.
    10449                 end.
    10450         end.
    10451   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    10452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
    10453     (input  v-cntxt-host-code-obj
    10454     ,output b-curr
    10455     )  .
    10456   find  first ub.gds-obj where
    10457            ub.gds-obj.obj-code = v-obj-code and
    10458            ub.gds-obj.obj-type = v-obj-type and
    10459            ub.gds-obj.gds-code = ub.goods.gds-code
    10460            no-lock no-error.
    10461     if available  ub.gds-obj then
    10462      assign
    10463           loc-gds-obg-last =  if var-pr-r-b = "rubl" then  ub.gds-obj.last-rubl else ub.gds-obj.last-base
    10464           loc-gds-obj-avrg =  if var-pr-r-b = "rubl" then  ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
    10465           loc-in-code = ub.gds-obj.in-code
    10466           loc-in-date = ub.gds-obj.in-date
    10467        .
    10468   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    10470     (input  v-obj-type
    10471     ,input  v-obj-code
    10472     ,input  buf_price-doc-forming-gds.b-code
    10473     ,input  0
    10474     ,input  0
    10475     ,output cur-dn
    10476     ,output cur-pr
    10477     ,output cur-rt
    10478     ,output cur-ex
    10479     ) no-error .
    10480        old-price =  cur-pr.
    10481        akt-num = cur-dn.
    10482        if cur-dn <> ? then find first lp-price-doc where lp-price-doc.doc-num = cur-dn no-lock no-error .
    10483        if available  lp-price-doc then
    10484                 akt-date = lp-price-doc.fact-date .
    10485                 else akt-date = ?.
    10486      display
    10487        old-price
    10488        v-dis
    10489        loc-gds-obg-last
    10490        loc-gds-obj-avrg
    10491        loc-in-code
    10492        loc-in-date
    10493        b-curr akt-num akt-date
    10494        buf_price-doc-forming-gds.road-tax-doc
    10495        buf_price-doc-forming-gds.excise-doc
    10496        with frame Dialog-Frame.
    10497      enable
    10498        old-price
    10499        loc-in-code
    10500        loc-in-date
    10501        v-dis
    10502        loc-gds-obg-last
    10503        loc-gds-obj-avrg
    10504        b-curr
    10505        akt-num
    10506        akt-date
    10507        with frame Dialog-Frame.
    10508        run calc-pr in this-procedure .
    10509        run sel-info in this-procedure .
    10510   END PROCEDURE.
    10511   PROCEDURE sel-info :
    10512    do
    10513    on error undo, return error return-value
    10514    :
    10515   define variable par-type       as character no-undo .
    10516   define variable par-pr-discm       as character no-undo .
    10517   define variable p-node-code    like ub.goods.grp-code no-undo .
    10518   define variable p-prc-min      as decimal no-undo .
    10519   define variable p-prc-max      as decimal no-undo .
    10520   define variable p-increase-pc  as decimal no-undo .
    10521   define variable p-round-method as character no-undo .
    10522   define variable p-base         as decimal no-undo .
    10523   define variable p-value-margin as integer no-undo .
    10524   define variable p-type-margin  as logical no-undo .
    10525   define variable p-value-increase  as integer no-undo .
    10526   define variable p-type-increase   as logical no-undo .
    10527   define variable p-value-rmethod   as integer no-undo .
    10528   define variable p-type-rmethod    as logical no-undo .
    10529   define variable v-host-code as integer   no-undo .
    10530   define variable new_par as character no-undo init "" .
    10531   define buffer bl_goods for ub.goods.
    10532   find first bl_goods   where
    10533             bl_goods.artic     = buf_price-doc-forming-gds.artic     and
    10534             bl_goods.prod-code = buf_price-doc-forming-gds.prod-code and
    10535             bl_goods.prod-type = buf_price-doc-forming-gds.prod-type no-lock no-error .
    10536   if error-status :error then return error.
    10537   for each x_obj-group :
    10538   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10539   empty temp-table thbjattr_thbj-attr.
    10540   run adm/shattri.p (
    10541      input "get":U
    10542     ,input x_obj-group.obj-type
    10543     ,input x_obj-group.obj-code
    10544     ,input 'overval':U
    10545     ,input  ""
    10546     ,output v-value-character
    10547     ,output v-value-date
    10548     ,output v-value-decimal
    10549     ,output v-value-integer
    10550     ,output v-value-logical
    10551     ,output par-type
    10552     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10553     ) no-error .
    10554     for each thbjattr_thbj-attr :
    10555         if thbjattr_thbj-attr.prop-code = 'pr-discm' then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
    10556     end.
    10557     new_par = new_par + trim(par-pr-discm) + chr(4) .
    10558   end.
    10559   define variable v-i as integer   no-undo init 0.
    10560     for each  x_obj-group :
    10561         v-i = v-i + 1.
    10562         if entry( v-i, new_par , chr(4) ) <> trim ( par-pr-discm ) then do:
    10563             message "На выбранных объектах используются настройки параметра par-pr-discm ! Для расчета выбран "
    10564                     trim ( par-pr-discm ) skip " для товара  " skip
    10565                     "код     :" bl_goods.gds-code  skip
    10566                     "артикул :" bl_goods.artic     skip
    10567                     "производитель :" bl_goods.prod-type skip
    10568                                       bl_goods.prod-code skip
    10569                     "По объекту :" skip
    10570                         v-obj-type  skip
    10571                         v-obj-code  skip
    10572                      view-as alert-box information .
    10573             leave.
    10574         end.
    10575     end.
    10576   if trim(par-pr-discm) = "" then return .
    10577       assign
    10578         p-node-code  = bl_goods.grp-code
    10579       .
    10580       run gds-attr-margin-value in this-procedure
    10581       ( input   bl_goods.gds-code,
    10582         input   v-obj-type ,
    10583         input   v-obj-code ,
    10584         output  p-prc-min  ,
    10585         output  p-prc-max  ,
    10586         output  p-increase-pc,
    10587         output  p-round-method  ,
    10588         output  p-base          ,
    10589         output  p-value-margin    ,
    10590         output  p-type-margin  ,
    10591         output  p-value-increase    ,
    10592         output  p-type-increase ,
    10593         output  p-value-rmethod   ,
    10594         output  p-type-rmethod
    10595       ) .
    10596       if p-type-margin = false  then return.
    10597        info = "ИНТЕРВАЛ НАЦЕНКИ" .
    10598         case  par-pr-discm :
    10599           when "cost":u then     do: info = info + " от учетной цены " .    end.
    10600           when "cost-vat":u then do: info = info + " от учетной цены без налогов " .       end.
    10601           when "sale":u then     do: info = info + " от продажной цены " .       end.
    10602           when "sale-":u then     do: info = info + " от продажной цены " .          end.
    10603           when "prod":u then     do: info = info + " от цены производителя с НДС" .  end.
    10604           when "prod-vat":u then     do: info = info + " от цены производителя без НДС" .       end.
    10605         end case.
    10606         info = info + " от " + string(p-prc-min) + "% до " + string (p-prc-max) + "% ".
    10607         display info  with frame Dialog-Frame.
    10608     end.
    10609   END PROCEDURE.
    10610   PROCEDURE upd-field :
    10611   define variable ff as logical no-undo .
    10612   define variable ff1 as logical init true no-undo .
    10613   define variable cur-dn as decimal no-undo .
    10614   define variable cur-pr as decimal no-undo .
    10615   define variable cur-rt as decimal no-undo .
    10616   define variable cur-ex as decimal no-undo .
    10617   define variable calc-rec as recid no-undo.
    10618   define variable calc-method    as character no-undo.
    10619   define variable increase-pc    as decimal no-undo.
    10620   define variable round-method   as character no-undo.
    10621   define variable round-base     as decimal no-undo.
    10622       assign
    10623          calc-method    = buf_price-doc-forming-gds.calc-method
    10624          increase-pc    = p-disc
    10625          round-method   = r-m
    10626          round-base     = r-b
    10627          .
    10628     if decimal ( buf_price-doc-forming-gds.price-sale-doc :screen-value in frame Dialog-Frame) <> buf_price-doc-forming-gds.price-sale-doc then do:
    10629       assign
    10630         buf_price-doc-forming-gds.calc-method     = c-m
    10631         buf_price-doc-forming-gds.price-calc-doc  = buf_price-doc-forming-gds.price-sale-doc
    10632         buf_price-doc-forming-gds.price-sale-doc  = decimal ( buf_price-doc-forming-gds.price-sale-doc :screen-value in frame Dialog-Frame)
    10633         buf_price-doc-forming-gds.price-sale-rubl = buf_price-doc-forming-gds.price-sale-doc  * p-exch-rate / p-exch-scale
    10634         buf_price-doc-forming-gds.price-sale-base = buf_price-doc-forming-gds.price-sale-rubl / p-base-rate * p-base-scale
    10635         .
    10636       assign
    10637          calc-method    = c-m
    10638          increase-pc    = p-disc
    10639          round-method   = r-m
    10640          round-base     = r-b
    10641          .
    10642         find current buf_price-doc-forming no-lock .
    10643         run calc-price-sub in this-procedure
    10644            (input  buf_price-doc-forming-gds.b-code,
    10645             input  recid ( buf_price-doc-forming ),
    10646             input  calc-method,
    10647             input  increase-pc,
    10648             input  round-method,
    10649             input  round-base,
    10650             input  doc-code,
    10651             input  common-price,
    10652             input  copy-type,
    10653             input  copy-code,
    10654             output calc-rec) no-error.
    10655          if error-status :error then undo, return error.
    10656     end.
    10657   If decimal ( buf_price-doc-forming-gds.excise-doc :screen-value in frame Dialog-Frame ) <> buf_price-doc-forming-gds.excise-doc then do:
    10658       assign
    10659         buf_price-doc-forming-gds.excise-doc     = decimal ( buf_price-doc-forming-gds.excise-doc     :screen-value in frame Dialog-Frame)
    10660         buf_price-doc-forming-gds.excise-rubl = buf_price-doc-forming-gds.excise-doc  * p-exch-rate / p-exch-scale
    10661         buf_price-doc-forming-gds.excise-base = buf_price-doc-forming-gds.excise-rubl / p-base-rate * p-base-scale
    10662       .
    10663   End.
    10664   If decimal ( buf_price-doc-forming-gds.road-tax-doc :screen-value in frame Dialog-Frame) <> buf_price-doc-forming-gds.road-tax-doc then do:
    10665          Find first buf_goods no-lock where
    10666               buf_goods.artic     = buf_price-doc-forming-gds.artic and
    10667               buf_goods.prod-type = buf_price-doc-forming-gds.prod-type and
    10668               buf_goods.prod-code = buf_price-doc-forming-gds.prod-code
    10669               no-error .
    10670         If available  buf_goods Then DO:
    10671                 if hvrdtax( recid(buf_goods)) = false  then  do :
    10672                    message "В товаре нет компонента цены '"   buf_price-doc-forming-gds.road-tax-doc:label  "' ,  изменять нельзя ! " .
    10673                 end.
    10674                 else do:
    10675   define variable vss-include-info99 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10676   do:
    10677     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10678       (input  v-cntxt-db-num
    10679       ,input  v-cntxt-userid
    10680       ,input  0
    10681       ,input  'actn_overvalue_update':U
    10682       ,input  'object':U
    10683       ,input  v-cntxt-host-code-obj
    10684       ,input  v-cntxt-obj-type
    10685       ,input  v-cntxt-obj-code
    10686       ,input  0
    10687       ,input  0
    10688       ,input  0
    10689       ,input  true
    10690       ,output ff
    10691       )  .
    10692   end.
    10693                       if not ff then      do :
    10694                          buf_price-doc-forming-gds.road-tax-doc   = buf_price-doc-forming-gds.road-tax-doc.
    10695                       end.
    10696                       else  do :
    10697                           buf_price-doc-forming-gds.road-tax-doc = decimal ( buf_price-doc-forming-gds.road-tax-doc:screen-value in frame Dialog-Frame ) .
    10698                       end.
    10699                       buf_price-doc-forming-gds.road-tax-rubl = buf_price-doc-forming-gds.road-tax-doc  * p-exch-rate / p-exch-scale.
    10700                       buf_price-doc-forming-gds.road-tax-base = buf_price-doc-forming-gds.road-tax-rubl / p-base-rate * p-base-scale.
    10701                 end.
    10702         end.
    10703    end.
    10704    Display buf_price-doc-forming-gds.excise-doc buf_price-doc-forming-gds.price-sale-doc buf_price-doc-forming-gds.road-tax-doc  with frame Dialog-Frame .
    10705   end procedure.
