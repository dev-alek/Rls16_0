     6119       ub.price-doc-forming-gds.artic            = p-artic
     6120       ub.price-doc-forming-gds.prod-type        = p-prod-type
     6121       ub.price-doc-forming-gds.prod-code        = p-prod-code
     6122       ub.price-doc-forming-gds.calc-method      = p-calc-method
     6123       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     6124       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     6125       ub.price-doc-forming-gds.start-date       = p-start-date
     6126       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     6127       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     6128       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     6129       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     6130       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     6131       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     6132       ub.price-doc-forming-gds.end-date         = p-end-date
     6133       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     6134       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     6135       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     6136       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     6137       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     6138       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     6139       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     6140       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     6141       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     6142       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     6143       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     6144       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     6145       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     6146       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     6147       ub.price-doc-forming-gds.excise-base      = p-excise-base
     6148       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     6149       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     6150       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     6151       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     6152       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     6153       ub.price-doc-forming-gds.stts             = p-stts
     6154       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     6155       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     6156       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     6157       .
     6158     run ref/h-pdfgds.p
     6159       ( buffer ub.price-doc-forming-gds ,
     6160         input p-price-sale-doc ,
     6161         input-output v-sec
     6162         ) .
     6163   END PROCEDURE.
     6164   PROCEDURE last-num :
     6165   define input  parameter p-recid as recid no-undo .
     6166   define output parameter p-last-id as integer   no-undo .
     6167   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     6168   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6169   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     6170         if error-status :error then do:
     6171           p-last-id = ? .
     6172           return .
     6173         end.
     6174       for each buf2_price-doc-forming-gds no-lock  where
     6175               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     6176               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     6177               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     6178               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     6179               by buf2_price-doc-forming-gds.line-num
     6180               :
     6181               p-last-id = buf2_price-doc-forming-gds.line-num .
     6182       end.
     6183   END PROCEDURE.
     6184   PROCEDURE calc-price-alt :
     6185   define input parameter bc         like ub.bar-code.b-code   no-undo.
     6186   define input parameter p-recid as recid no-undo .
     6187   define input parameter d-pcnt as decimal   no-undo .
     6188   define input parameter r-method   as character no-undo .
     6189   define input parameter r-base     as decimal   no-undo .
     6190   define output parameter pa-price-sale-base  as decimal   no-undo .
     6191   define output parameter pa-price-sale-doc   as decimal   no-undo .
     6192   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     6193   pr-alt:
     6194   do on error undo pr-alt, return error:
     6195     if r-method = ? or
     6196        r-base = ? then do:
     6197       message
     6198         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     6199         "Код:" bc skip
     6200         view-as alert-box error.
     6201       undo pr-alt, return error.
     6202     end.
     6203   define buffer buf_bar-code for ub.bar-code  .
     6204   define buffer buf_main_bar-code for ub.bar-code  .
     6205   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     6206   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6207   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     6208   if error-status :error then
     6209   message
     6210     vss-workfile vss-revision vss-description skip
     6211     error-status :get-message(1) skip
     6212     return-value skip
     6213     "Ошибка "
     6214     view-as alert-box error
     6215   .
     6216   find first buf_bar-code no-lock where
     6217              buf_bar-code.b-code = bc no-error .
     6218   if error-status :error then
     6219   message
     6220     vss-workfile vss-revision vss-description skip
     6221     error-status :get-message(1) skip
     6222     return-value skip
     6223     "3"
     6224     view-as alert-box error
     6225   .
     6226         assign
     6227           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     6228                               buf_bar-code.cli-base-rate *
     6229                               (1 - d-pcnt / 100)
     6230                                 .
     6231     if pa-price-sale-doc <> 0 then do:
     6232   case r-method :
     6233     when '9-окончание':U then do:
     6234       if pa-price-sale-doc < 29 then do:
     6235         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     6236           assign
     6237             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     6238           .
     6239         end.
     6240       end.
     6241       else do:
     6242         if (pa-price-sale-doc modulo 10) < 3 then do:
     6243           assign
     6244             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     6245                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     6246                   - 1 ) * 10
     6247                 + 9
     6248           .
     6249         end.
     6250         else do:
     6251           assign
     6252             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     6253                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     6254                   ) * 10
     6255                 + 9
     6256           .
     6257         end.
     6258         assign
     6259           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     6260         .
     6261       end.
     6262     end.
     6263     when '9-99окончание':U then do:
     6264       if pa-price-sale-doc < r-base then do:
     6265         assign
     6266           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     6267         .
     6268       end.
     6269       else do:
     6270         assign
     6271           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     6272         .
     6273       end.
     6274     end.
     6275     when 'Без-дробных':U then do:
     6276       assign
     6277         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     6278       .
     6279     end.
     6280     when 'Произвольно':U then do:
     6281       if r-base <> 0 then do:
     6282         assign
     6283           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     6284         .
     6285         if pa-price-sale-doc = 0 then do:
     6286           assign
     6287             pa-price-sale-doc = r-base
     6288           .
     6289         end.
     6290       end.
     6291     end.
     6292     when 'Вверх':U then do:
     6293       if r-base <> 0 then do:
     6294         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     6295           assign
     6296             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     6297           .
     6298         end.
     6299       end.
     6300       if pa-price-sale-doc = 0 then do:
     6301         assign
     6302           pa-price-sale-doc = r-base
     6303         .
     6304       end.
     6305     end.
     6306     when 'Коэффициент':U then do:
     6307       if r-base <> 0 then do:
     6308         assign
     6309           pa-price-sale-doc = pa-price-sale-doc * r-base
     6310         .
     6311       end.
     6312     end.
     6313     when 'Отключено':U then do:
     6314     end.
     6315     otherwise do:
     6316       message
     6317         vss-workfile vss-revision vss-description skip
     6318         "Неизвестный метод округления продажной цены" skip
     6319         "round-method" r-method skip
     6320         "round-base"   r-base   skip
     6321         "price"        pa-price-sale-doc             skip
     6322         view-as alert-box error .
     6323     end.
     6324   end.
     6325     end.
     6326     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     6327     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     6328   end.
     6329   END PROCEDURE.
     6330   procedure calc-price-discnt :
     6331     do
     6332     on error undo, return error return-value
     6333     :
     6334   define input parameter p-recid as recid no-undo .
     6335   define input parameter bc    like ub.bar-code.b-code   no-undo.
     6336   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     6337   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6338   define buffer buf-bar-code                      for ub.bar-code.
     6339   define buffer buf-goods                         for ub.goods.
     6340   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     6341   define variable pr-rec   as   recid                     no-undo.
     6342   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     6343   pr-discnt:
     6344   do on error undo pr-discnt, return error:
     6345     find  buf-price-doc-forming no-lock where
     6346           recid(buf-price-doc-forming) = p-recid .
     6347     find  buf-bar-code no-lock where
     6348           buf-bar-code.b-code = bc.
     6349     find  buf-goods no-lock where
     6350           buf-goods.gds-code = buf-bar-code.gds-code.
     6351     find  buf-price-doc-forming-gds exclusive-lock where
     6352           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6353           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6354           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6355           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6356           buf-price-doc-forming-gds.b-code  = bc.
     6357      if available buf-price-doc-forming-gds then do:
     6358         buf-price-doc-forming-gds.d-pcnt =
     6359         (1 - buf-price-doc-forming-gds.price-sale-doc /
     6360               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     6361               buf-bar-code.cli-base-rate) * 100 .
     6362      end.
     6363   end.
     6364     end.
     6365   end procedure.
     6366   procedure calc-price-sub :
     6367   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     6368   define  input  parameter p-recid      as recid no-undo .
     6369   define  input  parameter calc-method  as character         no-undo.
     6370   define  input  parameter increase-pc  as decimal           no-undo.
     6371   define  input  parameter round-method as character         no-undo.
     6372   define  input  parameter round-base   as decimal           no-undo.
     6373   define  input  parameter doc-code     as character no-undo .
     6374   define  input  parameter common-price as decimal   no-undo .
     6375   define  input  parameter copy-type    as character no-undo .
     6376   define  input  parameter copy-code    as integer   no-undo .
     6377   define  output parameter calc-rec     as recid             no-undo.
     6378   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6379   define  buffer buf-bar-code              for ub.bar-code.
     6380   define  buffer buf-goods                 for ub.goods.
     6381   define  buffer buf-gds-prt               for ub.gds-prt.
     6382   define  buffer buf-gds-grp               for ub.gds-grp.
     6383   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     6384   calc-sub:
     6385   do on error undo calc-sub, return error:
     6386     find  buf-price-doc-forming no-lock where
     6387           recid (buf-price-doc-forming) =  p-recid .
     6388     find  buf-bar-code no-lock where
     6389           buf-bar-code.b-code = bc.
     6390     find  buf-goods no-lock where
     6391           buf-goods.gds-code = buf-bar-code.gds-code.
     6392     find  buf-gds-prt no-lock where
     6393           buf-gds-prt.node-code = buf-bar-code.node-code.
     6394     find  buf-price-doc-forming-gds where
     6395           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6396           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6397           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6398           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6399           buf-price-doc-forming-gds.b-code      = bc no-error .
     6400     calc-rec = recid (buf-price-doc-forming-gds).
     6401     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     6402       for each  buf-price-doc-forming-gds exclusive-lock where
     6403                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6404                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6405                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6406                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6407                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6408                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6409                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6410           first buf-bar-code no-lock where
     6411                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     6412                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     6413           first buf-gds-prt no-lock where
     6414                 buf-gds-prt.node-code = buf-bar-code.node-code and
     6415                 buf-gds-prt.upper-code <> buf-goods.prt-root
     6416           on error undo calc-sub, return error:
     6417             run calc-price-line  in this-procedure
     6418               ( input  calc-method
     6419               , input  increase-pc
     6420               , input  round-method
     6421               , input  round-base
     6422               , input  buf-bar-code.b-code
     6423               , input  buf-goods.gds-code
     6424               , input  buf-goods.artic
     6425               , input  buf-goods.prod-type
     6426               , input  buf-goods.prod-code
     6427               , input  buf-price-doc-forming.base-rate
     6428               , input  buf-price-doc-forming.base-scale
     6429               , input  buf-price-doc-forming.exch-scale
     6430               , input  buf-price-doc-forming.exch-rate
     6431               , input  doc-code
     6432               , input  common-price
     6433               , input  copy-type
     6434               , input  copy-code
     6435               , output buf-price-doc-forming-gds.calc-method
     6436               , output buf-price-doc-forming-gds.price-calc-base
     6437               , output buf-price-doc-forming-gds.price-calc-doc
     6438               , output buf-price-doc-forming-gds.price-calc-rubl
     6439               , output buf-price-doc-forming-gds.price-prev-base
     6440               , output buf-price-doc-forming-gds.price-prev-doc
     6441               , output buf-price-doc-forming-gds.price-prev-rubl
     6442               , output buf-price-doc-forming-gds.price-sale-base
     6443               , output buf-price-doc-forming-gds.price-sale-doc
     6444               , output buf-price-doc-forming-gds.price-sale-rubl
     6445               , output buf-price-doc-forming-gds.road-tax-base
     6446               , output buf-price-doc-forming-gds.road-tax-doc
     6447               , output buf-price-doc-forming-gds.road-tax-rubl
     6448               , output buf-price-doc-forming-gds.excise-base
     6449               , output buf-price-doc-forming-gds.excise-doc
     6450               , output buf-price-doc-forming-gds.excise-rubl
     6451               , output buf-price-doc-forming-gds.vat-pc
     6452               , output buf-price-doc-forming-gds.slt-pc
     6453               , output buf-price-doc-forming-gds.prev-doc-code
     6454               , output buf-price-doc-forming-gds.d-pcnt
     6455               ) no-error .
     6456             if error-status :error then do :
     6457               message
     6458                 vss-workfile vss-revision vss-description skip
     6459                 error-status :get-message(1) skip
     6460                 return-value skip
     6461                 "calc-price-line"
     6462                 view-as alert-box error
     6463               .
     6464               undo calc-sub, return error.
     6465               end.
     6466         calc-rec = recid (buf-price-doc-forming-gds).
     6467       end.
     6468       for each  buf-price-doc-forming-gds exclusive-lock where
     6469                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6470                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6471                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6472                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6473                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6474                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6475                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6476           first buf-bar-code no-lock where
     6477                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     6478                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     6479           first buf-gds-prt no-lock where
     6480                 buf-gds-prt.node-code = buf-bar-code.node-code
     6481           on error undo calc-sub, return error:
     6482       end.
     6483     end.
     6484     else do:
     6485     end.
     6486   end.
     6487   end procedure.
     6488   procedure calc-base-update :
     6489   define input parameter bc           like ub.bar-code.b-code   no-undo.
     6490   define input parameter p-recid      as recid no-undo .
     6491   define input parameter round-method as character    no-undo.
     6492   define input parameter round-base   as decimal      no-undo.
     6493   define buffer alt-bar-code              for ub.bar-code.
     6494   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     6495   define buffer buf-bar-code              for ub.bar-code.
     6496   define buffer buf-goods                 for ub.goods.
     6497   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     6498   calc-base:
     6499   do on error undo calc-base, return error :
     6500     find  buf-price-doc-forming no-lock where
     6501           recid (buf-price-doc-forming) =  p-recid .
     6502     find  buf-bar-code no-lock where
     6503           buf-bar-code.b-code = bc.
     6504     find  buf-goods no-lock where
     6505           buf-goods.gds-code = buf-bar-code.gds-code.
     6506     for each  alt-bar-code no-lock where
     6507               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     6508               alt-bar-code.node-code = buf-bar-code.node-code and
     6509               alt-bar-code.part-code = buf-bar-code.part-code and
     6510               alt-bar-code.in-code   = buf-bar-code.in-code and
     6511               alt-bar-code.unit-cli <> buf-goods.unit-base,
     6512         each  alt-price-doc-forming-gds exclusive-lock where
     6513               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     6514               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     6515               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     6516               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6517               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     6518         on error undo calc-base, return error:
     6519     run calc-price-alt in this-procedure
     6520         ( input  alt-price-doc-forming-gds.b-code
     6521         , input  p-recid
     6522         , input  alt-price-doc-forming-gds.d-pcnt
     6523         , input  round-method
     6524         , input  round-base
     6525         , output alt-price-doc-forming-gds.price-sale-base
     6526         , output alt-price-doc-forming-gds.price-sale-doc
     6527         , output alt-price-doc-forming-gds.price-sale-rubl
     6528         ) no-error .
     6529       if error-status:error then do:
     6530       message
     6531         vss-workfile vss-revision vss-description skip
     6532         error-status :get-message(1) skip
     6533         return-value skip
     6534         "calc-price-alt"
     6535         view-as alert-box error
     6536       .
     6537         undo calc-base, return error.
     6538       end.
     6539     end.
     6540   end.
     6541   end procedure.
     6542   define temp-table temp-exp-partbc no-undo
     6543   field b-code  as integer
     6544   index pi b-code
     6545   .
     6546   procedure expose-prt :
     6547   define input  parameter p-calc-method  as character no-undo .
     6548   define input  parameter p-increase-pc as decimal   no-undo .
     6549   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     6550   define input  parameter old-recid      as recid no-undo .
     6551   define input  parameter new-recid      as recid no-undo .
     6552   define input  parameter p-round-method as character no-undo .
     6553   define input  parameter p-round-base   as decimal   no-undo .
     6554   define input  parameter v-doc-code     as character no-undo .
     6555   define input  parameter v-common-price as decimal   no-undo .
     6556   define input  parameter v-copy-type    as character no-undo .
     6557   define input  parameter v-copy-code    as integer   no-undo .
     6558   define input-output parameter v-line-num as integer   no-undo .
     6559   define input-output parameter v-sec      as integer   no-undo .
     6560   define output parameter new-rec-str      as recid   no-undo.
     6561   define buffer buf-bar-code              for ub.bar-code.
     6562   define buffer buf-goods                 for ub.goods.
     6563   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6564   define buffer buf-price-list            for ub.price-doc-forming-gds.
     6565   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     6566   define buffer new-price-doc-forming     for ub.price-doc-forming.
     6567   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     6568   define buffer buf-gds-prt               for ub.gds-prt  .
     6569   define buffer buf_parts for ub.parts  .
     6570   define buffer buf_goods for ub.goods  .
     6571     do
     6572     on error undo, return error return-value
     6573     :
     6574     find  buf-price-doc-forming no-lock where
     6575           recid(buf-price-doc-forming) = old-recid .
     6576     find  new-price-doc-forming no-lock where
     6577           recid(new-price-doc-forming) = new-recid .
     6578     find  buf-bar-code no-lock where
     6579           buf-bar-code.b-code = p-main-code.
     6580     find  buf-goods no-lock where
     6581           buf-goods.gds-code = buf-bar-code.gds-code.
     6582     find  buf-price-doc-forming-gds no-lock  where
     6583           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6584           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6585           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6586           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6587           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     6588     if error-status :error then return .
