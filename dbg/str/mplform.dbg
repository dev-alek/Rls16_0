     1673       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1674       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1675       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
