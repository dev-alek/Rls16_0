     9802   def var vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9803   procedure check-use-bar-code :
     9804     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     9805     do
     9806     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info91, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9807     on stop   undo, return error substitute( "&1. stop", vss-include-info91 )
     9808     on endkey undo, return error substitute( "&1. endkey", vss-include-info91 )
     9809     :
     9810       define buffer buf_bar-code for ub.bar-code .
     9811       find first buf_bar-code no-lock
     9812         where buf_bar-code.b-code     = p-b-code
     9813         no-error .
     9814       if not available buf_bar-code then do:
     9815         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info91, p-b-code ) .
     9816       end.
     9817       if buf_bar-code.stts = integer('99':U) then do:
     9818         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9819                                 + "Выполняется удаление бар-кода"
     9820                                 ,vss-include-info91
     9821                                 ,p-b-code
     9822                                 ,chr(10)
     9823                               ) .
     9824       end.
     9825       if buf_bar-code.stts = integer('79':U) then do:
     9826         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9827                                 + "Бар-код выключен"
     9828                                 ,vss-include-info91
     9829                                 ,p-b-code
     9830                                 ,chr(10)
     9831                               ) .
     9832       end.
     9833       return .
     9834     end.
     9835   end procedure.
