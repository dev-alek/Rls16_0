     5228   p-new-calc-method = p-calc-method .
     5229   run re-define in this-procedure (
     5230       input-output p-calc-method
     5231     , input p-gds-code
     5232     ) .
     5233     define variable v-sps as character no-undo .
     5234   v-sps =
     5235    "Товар,
     5236   Группа,
     5237   Учетная,
     5238   Учет-объект,
     5239   Учет-резерв,
     5240   Приходная,
     5241   Прих-объект,
     5242   Начальная,
     5243   Старая,
     5244   Новая,
     5245   Объект,
     5246   Накладная,
     5247   Накл-безНДС,
     5248   Учет-безНДС,
     5249   Стар-безНДС,
     5250   Переоценка,
     5251   ДокФормЦены,
     5252   Отсутствует,
     5253   Признак,
     5254   Специальная,
     5255   Не-считать,
     5256   Основная,
     5257   Единая,
     5258   Учет+накл,
     5259   Уч+накл-НДС,
     5260   НсП,
     5261   НсП+накл,
     5262   УчетнаяS,
     5263   Учет-рзрвS,
     5264   ПриходнаяS,
     5265   Учет-НДСS,
     5266   Откат_цен,
     5267   Спецификация
     5268   "
     5269     .
     5270   if lookup ( p-calc-method , v-sps )  = 0 then  do:
     5271       p-calc-method = entry (1,p-calc-method, " ") no-error .
     5272       if error-status :error then message p-calc-method.
     5273   end.
     5274   define variable v-i as integer   no-undo init 0.
     5275     for each  x_obj-group :
     5276         v-i = v-i + 1.
     5277         if entry( v-i, new_round , chr(4) ) <> string ( loc_round ) then do:
     5278             message "На выбранных объектах используются разные параметры Наценки и округления ! Для расчета выбран" string ( loc_round ) skip "для товара  "
     5279             skip
     5280             "код     :" p-gds-code  skip
     5281             "бар-код :" p-b-code    skip
     5282             "артикул :" p-artic     skip
     5283             "производитель :" p-prod-type        p-prod-code
     5284             view-as alert-box information .
     5285             leave.
     5286         end.
     5287         if entry( v-i, new_vat-pc , chr(4) ) <> string ( local_vat-pc ) then do:
     5288             message "На выбранных объектах используются разные НДС ! Для расчета выбран" string ( local_vat-pc ) "%" skip "для товара  "
     5289             skip
     5290             "код     :" p-gds-code  skip
     5291             "бар-код :" p-b-code    skip
     5292             "артикул :" p-artic     skip
     5293             "производитель :" p-prod-type        p-prod-code
     5294             view-as alert-box information .
     5295             leave.
     5296         end.
     5297         if entry( v-i, new_slt-pc , chr(4) ) <> string ( local_slt-pc ) then do:
     5298             message "На выбранных объектах используются разные НсП ! Для расчета выбран" string ( local_slt-pc )
     5299             skip
     5300             "код     :" p-gds-code   skip
     5301             "бар-код :" p-b-code    skip
     5302             "артикул :" p-artic             skip
     5303             "производитель :" p-prod-type        p-prod-code
     5304             view-as alert-box information .
     5305             leave.
     5306         end.
     5307     end.
     5308   p-vat-pc  = local_vat-pc .
     5309   p-slt-pc  = local_slt-pc .
     5310     if available buf_price-doc-forming then do:
     5311        find first buf_price-list-type no-lock where
     5312                   buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id    and
     5313                   buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num
     5314                   no-error .
     5315        if error-status :error then return error return-value .
     5316     end.
     5317     else do:
     5318   find first buf_price-list-type no-lock where
     5319              buf_price-list-type.plt-id     = v-plt-id    and
     5320              buf_price-list-type.plt-db-num = v-plt-db-num
     5321              no-error .
     5322      if error-status :error then return error return-value .
     5323     end.
     5324   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5325   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-mpl in g#library2
     5326     (input  buf_price-list-type.gop-id
     5327     ,input  buf_price-list-type.gop-db-num
     5328     ,input  p-b-code
     5329     ,input  0
     5330     ,input  0
     5331     ,output v1-recid
     5332     ,output p-price-prev-doc
     5333     ,output v1-cur-rt
     5334     ,output v1-cur-ex
     5335     ) no-error .
     5336       if error-status :error then
     5337       message
     5338         vss-workfile vss-revision vss-description skip
     5339         error-status :get-message(1) skip
     5340         return-value skip
     5341         "bc-mpl"
     5342         view-as alert-box error
     5343       .
     5344   define buffer old1_price-doc-forming     for ub.price-doc-forming  .
     5345   define buffer old1_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5346   find first old1_price-doc-forming no-lock where
     5347              recid(old1_price-doc-forming) = v1-recid no-error .
     5348   find first old1_price-doc-forming-gds no-lock where
     5349              old1_price-doc-forming-gds.pdf-db      = old1_price-doc-forming.pdf-db      and
     5350              old1_price-doc-forming-gds.pdf-id      = old1_price-doc-forming.pdf-id      and
     5351              old1_price-doc-forming-gds.plt-db-num  = old1_price-doc-forming.plt-db-num  and
     5352              old1_price-doc-forming-gds.plt-id      = old1_price-doc-forming.plt-id      and
     5353              old1_price-doc-forming-gds.b-code      = p-b-code
     5354              no-error .
     5355   if available old1_price-doc-forming-gds then do:
     5356      p-d-pcnt = old1_price-doc-forming-gds.d-pcnt .
     5357   end.
     5358   else do:
     5359     p-d-pcnt = 0 .
     5360   end.
     5361   case p-calc-method :
     5362      when 'Новая':U or
     5363      when 'Не-считать':U then do:
     5364       assign
     5365         p-new-calc-method = p-calc-method
     5366         cost-rubl = ?
     5367         cost-base = ?
     5368       .
     5369         if available buf_price-doc-forming then do:
     5370           assign
     5371             v-pdf-id      = buf_price-doc-forming.pdf-id
     5372             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     5373             v-plt-id2     = buf_price-doc-forming.plt-id
     5374             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     5375           .
     5376           find first buf_buf_price-doc-forming-gds no-lock where
     5377                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     5378                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     5379                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     5380                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     5381                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     5382                 no-error .
     5383               if available buf_buf_price-doc-forming-gds then do:
     5384                   assign
     5385                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     5386                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     5387                   .
     5388               end.
     5389         end.
     5390      end.
     5391      when 'УчетнаяS':U  or
     5392      when 'Учет-рзрвS':U  or
     5393      when 'ПриходнаяS':U
     5394      then do:
     5395         run str/sgdsavrg.p
     5396         (   input  p-calc-method    ,
     5397             input  table x_obj-group ,
     5398             input  p-b-code    ,
     5399             input  p-artic     ,
     5400             input  p-prod-type ,
     5401             input  p-prod-code ,
     5402             output cost-base   ,
     5403             output cost-rubl   ,
     5404             output cur-rt-base ,
     5405             output cur-rt-rubl
     5406             ).
     5407      end.
     5408      when 'Учет-НДСS':U or
     5409      when 'Накл-безНДС':U or
     5410      when 'Стар-безНДС':U or
     5411      when 'Старая':U or
     5412      when 'Учет+накл':U or
     5413      when 'Уч+накл-НДС':U or
     5414      when 'Откат_цен':U then do:
     5415         run str/mplnovat.p
     5416           ( input  p-calc-method    ,
     5417             input  table x_obj-group ,
     5418             input  p-b-code    ,
     5419             input  p-artic     ,
     5420             input  p-prod-type ,
     5421             input  p-prod-code ,
     5422             input  0 ,
     5423             input  v-doc-code ,
     5424             input  p-vat-pc      ,
     5425             input  p-slt-pc      ,
     5426             output vd  ,
     5427             output vd  ,
     5428             output cost-base   ,
     5429             output cost-rubl   ,
     5430             output cur-rt-base ,
     5431             output cur-rt-rubl
     5432             ).
     5433      end.
     5434      when 'Накладная':U then do:
     5435           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     5436           find first buf_doc-line  no-lock where
     5437                     buf_doc-line.doc-code = v-doc-code      and
     5438                     buf_doc-line.artic    = p-artic         and
     5439                     buf_doc-line.prod-type   = p-prod-type  and
     5440                     buf_doc-line.prod-code   = p-prod-code no-error .
     5441           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     5442           find first buf_gds-dtl no-lock where
     5443                      buf_gds-dtl.doc-code  = v-doc-code   and
     5444                      buf_gds-dtl.artic     = p-artic      and
     5445                      buf_gds-dtl.prod-type = p-prod-type  and
     5446                      buf_gds-dtl.prod-code = p-prod-code  and
     5447                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     5448           assign
     5449             v1 = recid (buf_trn-doc)
     5450             v2 = recid (buf_doc-line)
     5451             v3 = recid (buf_gds-dtl)
     5452             v4  = buf_gds-dtl.prt-code
     5453             no-error .
     5454             if not v-base then do:
