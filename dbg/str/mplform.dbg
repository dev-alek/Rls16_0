     2094              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     2095              if error-status :error then return error .
     2096   find first buf_goods no-lock where
     2097              buf_goods.gds-code  = p-gds-code no-error .
     2098              if error-status :error then return error .
     2099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2100     (input  buf_goods.gds-code
     2101     ,input  ?
     2102     ,output main-b-code
     2103     ) no-error .
     2104   run check-use-bar-code (main-b-code) no-error .
     2105   if error-status :error then return .
     2106   run create-line-pdf-mpl-lib (
     2107        input buf_price-doc-forming.plt-db-num
     2108       ,input buf_price-doc-forming.plt-id
     2109       ,input buf_price-doc-forming.pdf-db
     2110       ,input buf_price-doc-forming.pdf-id
