      611   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   define temp-table x_obj-group no-undo like ub.clients  .
      613   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      614   procedure metod-gop-obj :
      615     do
      616     on error undo, return error return-value
      617     :
      618   define input  parameter p-cntxt-db-num as integer   no-undo .
      619   define input  parameter p-gop-id       as integer   no-undo .
      620   define input  parameter p-gop-db-num   as integer   no-undo .
      621   define buffer buf1_clients for ub.clients  .
      622   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      623   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      624   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      625   for each  x_obj-group : delete x_obj-group. end.
      626   if p-gop-id = 0 or p-gop-id = ?  then do:
      627      if p-cntxt-db-num = 0  then do:
      628           for each buf1_clients no-lock where
      629                   (buf1_clients.obj-type = 'маг':U  or
      630                    buf1_clients.obj-type = 'скл':U  )
      631                   and
      632                   buf1_clients.db-num >= 0  and
      633                   buf1_clients.stts = 0
      634                   :
      635             create x_obj-group .
      636             assign
      637               x_obj-group.obj-code   = buf1_clients.obj-code
      638               x_obj-group.obj-type   = buf1_clients.obj-type
      639               x_obj-group.obj-name   = buf1_clients.obj-name
      640               x_obj-group.db-num     = buf1_clients.db-num
      641             .
      642           end.
      643      end.
      644      else do:
      645           for each buf1_clients no-lock where
      646                   (buf1_clients.obj-type = 'маг':U  or
      647                    buf1_clients.obj-type = 'скл':U  ) and
      648                    buf1_clients.db-num = p-cntxt-db-num  and
      649                    buf1_clients.stts = 0
      650                   :
      651             create x_obj-group .
      652             assign
      653               x_obj-group.obj-code   = buf1_clients.obj-code
      654               x_obj-group.obj-type   = buf1_clients.obj-type
      655               x_obj-group.obj-name   = buf1_clients.obj-name
      656               x_obj-group.db-num     = buf1_clients.db-num
      657             .
      658           end.
      659      end.
      660   end.
      661   else do:
      662         for each buf_db-grp-obj-price  where
      663                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      664                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      665                 buf_db-grp-obj-price.stts = 0  no-lock :
      666           for each buf1_clients no-lock where
      667                  (buf1_clients.obj-type = 'маг':U  or
      668                   buf1_clients.obj-type = 'скл':U  ) and
      669                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      670                   buf1_clients.stts = 0
      671                   :
      672             create x_obj-group .
      673             assign
      674               x_obj-group.obj-code   = buf1_clients.obj-code
      675               x_obj-group.obj-type   = buf1_clients.obj-type
      676               x_obj-group.obj-name   = buf1_clients.obj-name
      677               x_obj-group.db-num     = buf1_clients.db-num
      678             .
      679           end.
      680         end.
      681       for each buf_host-grp-obj-price where
      682               buf_host-grp-obj-price.gop-id     = p-gop-id and
      683               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      684               buf_host-grp-obj-price.stts = 0
      685               no-lock :
      686         for each buf1_clients no-lock where
      687                (buf1_clients.obj-type = 'маг':U  or
      688                 buf1_clients.obj-type = 'скл':U  ) and
      689                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      690                 buf1_clients.stts = 0
      691                 :
      692             find first x_obj-group no-lock  where
      693                       x_obj-group.obj-code   = buf1_clients.obj-code and
      694                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      695             if not available  x_obj-group then   create x_obj-group .
      696             assign
      697               x_obj-group.obj-code   = buf1_clients.obj-code
      698               x_obj-group.obj-type   = buf1_clients.obj-type
      699               x_obj-group.obj-name   = buf1_clients.obj-name
      700               x_obj-group.db-num     = buf1_clients.db-num
      701             .
      702         end.
      703       end.
      704       for each buf_obj-grp-obj-price where
      705               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      706               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      707               buf_obj-grp-obj-price.stts = 0
      708               no-lock :
      709         for each buf1_clients no-lock where
      710                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      711                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      712                   buf1_clients.stts     = 0
      713                   :
      714             find first  x_obj-group no-lock  where
      715                         x_obj-group.obj-code   = buf1_clients.obj-code and
      716                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      717             if not available  x_obj-group then   create x_obj-group .
      718             assign
      719               x_obj-group.obj-code   = buf1_clients.obj-code
      720               x_obj-group.obj-type   = buf1_clients.obj-type
      721               x_obj-group.obj-name   = buf1_clients.obj-name
      722               x_obj-group.db-num     = buf1_clients.db-num
      723             .
      724         end.
      725       end.
      726   end.
      727   end.
      728   end procedure.
      729   procedure metod-obj-in-gop :
      730   define input  parameter p-curr-db-num as integer   no-undo .
      731   define input  parameter p-obj-type as character no-undo .
      732   define input  parameter p-obj-code as integer   no-undo .
      733   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      734     do
      735     on error undo, return error return-value
      736     :
      737       empty temp-table x_grp-obj-price.
      738       for each buf_grp-obj-price where
      739                buf_grp-obj-price.stts = 0
      740                no-lock :
      741                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      742                  for each x_obj-group where
      743                           x_obj-group.obj-type = p-obj-type and
      744                           x_obj-group.obj-code = p-obj-code :
      745                       create  x_grp-obj-price.
      746                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      747                  end.
      748       end.
      749     end.
      750   end procedure.
      751   procedure metod-delobj-usr :
      752   define input  parameter p-pdf-id  as integer   no-undo .
      753   define input  parameter p-pdf-db  as integer   no-undo .
      754   define input  parameter p-plt-id  as integer   no-undo .
      755   define input  parameter p-plt-db-num as integer   no-undo .
      756   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      757     do
      758     on error undo, return error return-value
      759     :
      760   for each buf_price-doc-forming-attr no-lock  where
      761            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      762            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      763            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      764            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      765            buf_price-doc-forming-attr.attr-code begins "obj" :
      766      for each x_obj-group  where
      767               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      768               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      769        delete x_obj-group.
      770      end.
      771   end.
      772     if not can-find (first x_obj-group) then do:
      773        return "nullobj" .
      774     end.
      775   end.
      776   end procedure.
      777   procedure metod-obj-pdf :
      778   define input  parameter p-cntxt-db-num as integer   no-undo .
      779   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      780   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      781   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      782   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      783   define buffer buf_price-list-type for ub.price-list-type  .
      784   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      785     do
      786     on error undo, return error return-value
      787     :
      788    for each  x_obj-group : delete x_obj-group. end.
      789    find first buf_price-list-type no-lock where
      790               buf_price-list-type.plt-id = p-plt-id and
      791               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      792   if error-status :error then return error return-value .
      793    find first buf_price-doc-forming no-lock where
      794               buf_price-doc-forming.plt-id     = p-plt-id and
      795               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      796               buf_price-doc-forming.pdf-id     = p-pdf-id and
      797               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      798               no-error .
      799   if error-status :error then return error return-value .
      800     run metod-gop-obj in this-procedure (
      801         p-cntxt-db-num,
      802         buf_price-list-type.gop-id ,
      803         buf_price-list-type.gop-db-num
      804         ) no-error .
      805     run metod-delobj-usr in this-procedure (
      806       buf_price-doc-forming.pdf-id ,
      807       buf_price-doc-forming.pdf-db ,
      808       buf_price-doc-forming.plt-id ,
      809       buf_price-doc-forming.plt-db-num
      810       ) no-error .
      811     end.
      812   end procedure.
      813   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   procedure grp-obj-write :
      815   do
      816   on error undo, return error
      817   :
      818   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      819   define input parameter p-host-code  as integer                          no-undo.
      820   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      821   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      822   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      823   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      824   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      825   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      826   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      827   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      828   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      829   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      830   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      831       find first buf_gds-grp-obj exclusive-lock
      832            where buf_gds-grp-obj.node-code  = p-node-code
      833              and buf_gds-grp-obj.host-code  = p-host-code
