     8570   .
     8571   define variable vss-include-info77 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8572   do:
     8573     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8574       (input  v-cntxt-db-num
     8575       ,input  v-cntxt-userid
     8576       ,input  0
     8577       ,input  'actn_overvalue_discount':U
     8578       ,input  'object':U
     8579       ,input  p-host-code
     8580       ,input  p-obj-type
     8581       ,input  p-obj-code
     8582       ,input  0
     8583       ,input  0
     8584       ,input  0
     8585       ,input  false
     8586       ,output v-ok
     8587       )  .
     8588   end.
     8589     if v-ok = true then return .
     8590   if trim(par-pr-discm) = "" then return .
     8591   if par-pr-discm = 'sale-' then par-pr-discm = 'sale' .
     8592   for each  b_price-doc-forming-gds no-lock where
     8593             b_price-doc-forming-gds.plt-id     = p-plt-id      and
     8594             b_price-doc-forming-gds.plt-db-num = p-plt-db-num  and
     8595             b_price-doc-forming-gds.pdf-id     = p-pdf-id      and
     8596             b_price-doc-forming-gds.pdf-db     = p-pdf-db
     8597             :
     8598       find first buf_bar-code no-lock where
     8599                  buf_bar-code.b-code  = b_price-doc-forming-gds.b-code
     8600                  no-error .
     8601       if available buf_bar-code then v-koff = buf_bar-code.cli-base-rate .
     8602       else v-koff = 1.
     8603       if v-koff = ? or v-koff = 0 then v-koff = 1.
     8604      find first bl_goods no-lock   where
     8605                 bl_goods.artic     = b_price-doc-forming-gds.artic     and
     8606                 bl_goods.prod-code = b_price-doc-forming-gds.prod-code and
     8607                 bl_goods.prod-type = b_price-doc-forming-gds.prod-type
     8608                 .
     8609       assign
     8610         p-node-code  = bl_goods.grp-code
     8611       .
     8612       run gds-attr-margin-value
     8613       (
     8614         input   bl_goods.gds-code,
     8615         input   p-obj-type ,
     8616         input   p-obj-code ,
     8617         output  p-prc-min  ,
     8618         output  p-prc-max  ,
     8619         output  p-increase-pc,
     8620         output  p-round-method,
     8621         output  p-base        ,
     8622         output  p-value-margin    ,
     8623         output  p-type-margin     ,
     8624         output  p-value-increase   ,
     8625         output  p-type-increase   ,
     8626         output  p-value-rmethod   ,
     8627         output  p-type-rmethod
     8628         ) .
     8629       if p-type-margin = false  then next.
     8630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8631     (input  bl_goods.gds-code
     8632     ,input  ?
     8633     ,output v-main-b-code
     8634     )  .
     8635       if  trn-doc-code = ? or trn-doc-code = "" then do:
     8636           if v-main-b-code = b_price-doc-forming-gds.b-code then do :
     8637             case  par-pr-discm :
     8638                when "prod":u then do:
     8639   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8641   (  input  b_price-doc-forming-gds.b-code
     8642    , input  p-obj-type
     8643    , input  p-obj-code
     8644    , output l_pricewithoutvat
     8645    , output l_price
     8646    , output l_prod-vat
     8647    , output v-str2
     8648    , output v-str2
     8649           )  .
     8650                     fact_price =  if var-pr-r-b = "rubl"
     8651                                   then  b_price-doc-forming-gds.price-sale-rubl
     8652                                   else  b_price-doc-forming-gds.price-sale-base
     8653                                  .
     8654                     t-prc      =  (fact_price / l_price - 1) * 100  .
     8655                 end.
     8656                 when "prod-vat":u then do:
     8657   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8659   (  input  b_price-doc-forming-gds.b-code
     8660    , input  p-obj-type
     8661    , input  p-obj-code
     8662    , output l_price
     8663    , output l_pricewithvat
     8664    , output l_prod-vat
     8665    , output v-str2
     8666    , output v-str2
     8667           )  .
     8668                     fact_price =  if var-pr-r-b = "rubl"
     8669                                   then  b_price-doc-forming-gds.price-sale-rubl
     8670                                   else  b_price-doc-forming-gds.price-sale-base
     8671                                  .
     8672                     t-prc      =  (fact_price / l_price - 1) * 100  .
     8673                 end.
     8674                 when "cost-vat":u then do:
     8675                     run str/mplnovat.p
     8676                        (input 'Учет-НДСS':U,
     8677                         input table x_obj-group ,
     8678                         input b_price-doc-forming-gds.b-code,
     8679                         input b_price-doc-forming-gds.artic,
     8680                         input b_price-doc-forming-gds.prod-type,
     8681                         input b_price-doc-forming-gds.prod-code,
     8682                         input 0 ,
     8683                         input ? ,
     8684                         input b_price-doc-forming-gds.vat-pc ,
     8685                         input b_price-doc-forming-gds.slt-pc ,
     8686                         output cost-base   ,
     8687                         output cost-rubl   ,
     8688                         output v-price-base  ,
     8689                         output v-price-rubl  ,
     8690                         output cur-rt-base ,
     8691                         output cur-rt-rubl
     8692                         ).
     8693                     assign
     8694                       l_price    =  if var-pr-r-b = "rubl" then v-price-rubl else v-price-base
     8695                       fact_price =  if var-pr-r-b = "rubl" then b_price-doc-forming-gds.price-sale-rubl else b_price-doc-forming-gds.price-sale-base
     8696                     .
     8697                     t-prc      =  (fact_price / l_price - 1) * 100  .
     8698                 end.
     8699               when "cost":u       then do:
     8700                 t-prc =  fnc-cost-pc (buffer b_price-doc-forming-gds) .
     8701               end.
     8702               when "sale":u then do:
     8703                 t-prc =  fnc-pr-pc   (buffer b_price-doc-forming-gds) .
     8704               end.
     8705             end case.
     8706           end.
     8707           else do:
     8708    case  par-pr-discm :
     8709               when "cost":u
     8710               or when "cost-vat":u
     8711               then do:
     8712                 l_price =  fnc-cost (buffer b_price-doc-forming-gds) .
     8713                 t-prc = ((b_price-doc-forming-gds.price-sale-rubl / v-koff)  / l_price - 1) * 100.
