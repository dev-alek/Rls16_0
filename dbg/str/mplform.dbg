     1510   function hvrdtax return logical (input parrecid as recid):
     1511   define variable varresult as logical no-undo.
     1512   run hvrdtax-proc (input parrecid, output varresult).
     1513   return varresult.
     1514   end function.
     1515   procedure hvrdtax-proc:
     1516   define input  parameter parrecid  as recid   no-undo.
     1517   define output parameter parresult as logical no-undo.
     1518   define buffer bf_goods for ub.goods.
     1519   define buffer bf_units for ub.units.
     1520   define buffer rt_tax   for ub.tax.
     1521   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1522   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1523   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1524   if available rt_tax and
     1525       can-find(first ub.tax-units No-LOCK WHERE
     1526                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1527                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1528                                                       else assign parresult = no.
     1529   end procedure.
     1530   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1531   procedure tax-name:
     1532   define input  parameter pardef-tax  as character           no-undo.
     1533   define output parameter parname-tax as character initial ? no-undo.
     1534   define buffer bf_tax for ub.tax.
     1535   do on error undo, return error :
     1536      case pardef-tax:
     1537         when 'vat':U then do:
     1538                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     1539         end.
     1540         when 'slt':U then do:
     1541                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     1542         end.
     1543         when 'rdt':U then do:
     1544                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     1545         end.
     1546         when 'exc':U then do:
     1547                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     1548         end.
     1549         otherwise do:
     1550            return error "Задан неверный параметр " + pardef-tax + " .".
     1551         end.
     1552      end case.
     1553   end.
     1554   end procedure.
