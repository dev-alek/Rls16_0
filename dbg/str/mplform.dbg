     8914              end.
     8915              else do:
     8916                assign
     8917                 s-cost = 0
     8918                 s-qnty = 0
     8919                .
     8920              end.
     8921              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     8922           end.
     8923           when "cost-vat":u then do:
     8924                run str/gdsnovat.p ('Уч+накл-НДС':U,
     8925                        b_trn-doc.obj-type,
     8926                        b_trn-doc.obj-code,
     8927                        b_trn-doc.host-code,
     8928                        b_doc-line.artic,
     8929                        b_doc-line.prod-type,
     8930                        b_doc-line.prod-code,
     8931                        0 ,
     8932                        b_doc-line.doc-code,
     8933                        ?,
     8934                        ?,
     8935                        output cost-base   ,
     8936                        output cost-rubl   ,
     8937                        output v-price-base  ,
     8938                        output v-price-rubl  ,
     8939                        output cur-rt-base ,
     8940                        output cur-rt-rubl ).
     8941                        if var-pr-r-b = "rubl"
     8942                           then l_price = v-price-rubl.
     8943                           else l_price = v-price-base.
     8944           end.
     8945           when "sale":u then do:
     8946                 l_price = ( if var-pr-r-b = "rubl"
     8947                                then b_doc-line.price-rubl
     8948                                else b_doc-line.price-base ).
     8949           end.
     8950           when "prod":u then do:
     8951   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8953   (  input  b_price-doc-forming-gds.b-code
     8954    , input  p-obj-type
     8955    , input  p-obj-code
     8956    , output l_pricewithoutvat
     8957    , output l_price
     8958    , output l_prod-vat
     8959    , output v-str2
     8960    , output v-str2
     8961           )  .
     8962       end.
     8963      when "prod-vat":u then do:
     8964   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8965   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8966   (  input  b_price-doc-forming-gds.b-code
     8967    , input  p-obj-type
     8968    , input  p-obj-code
     8969    , output l_price
     8970    , output l_pricewithvat
     8971    , output l_prod-vat
     8972    , output v-str2
     8973    , output v-str2
     8974           )  .
     8975       end.
     8976         end case.
     8977           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     8978           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     8979      end.
     8980   end.
     8981     if  p-prc-max <> ? then do:
     8982       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     8983       then do:
     8984         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8985             else "По признаку"  )
     8986             b_price-doc-forming-gds.artic
     8987             b_price-doc-forming-gds.prod-type
     8988             b_price-doc-forming-gds.prod-code skip
     8989             "бар-код: " b_price-doc-forming-gds.b-code
     8990              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8991                else "" ) skip
     8992             fnc-pr  (buffer b_price-doc-forming-gds)
     8993             skip
     8994           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8995           "Процент не менее :" p-prc-min "%" skip
     8996           "Процент не более :" p-prc-max "%" skip
     8997           "Процент фактический :" t-prc  "%"  skip
     8998           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     8999           "БД" b_price-doc-forming-gds.pdf-db
     9000             view-as alert-box error .
     9001                 p-err = true .
     9002                 undo , return error .
     9003       end.
     9004       else do:
     9005          if  t-prc = ? then  do:
     9006             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     9007             else "По признаку"  )
     9008             b_price-doc-forming-gds.artic
     9009             b_price-doc-forming-gds.prod-type
     9010             b_price-doc-forming-gds.prod-code skip
     9011             "бар-код: " b_price-doc-forming-gds.b-code
     9012              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     9013                else "" ) skip
     9014             fnc-pr  (buffer b_price-doc-forming-gds)
     9015             skip
     9016             "Нет базовой цены для расчета процента наценки !" skip
     9017             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     9018             "Процент не менее :" p-prc-min "%" skip
     9019             "Процент не более :" p-prc-max "%" skip
     9020             "Процент фактический :" t-prc  "%"  skip
     9021             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     9022             "БД" b_price-doc-forming-gds.pdf-db
     9023             view-as alert-box error .
     9024             p-err = true .
     9025             undo , return error .
     9026          end.
     9027       end.
     9028     end.
     9029   end.
     9030     end.
     9031   end procedure.
     9032   procedure del-doc-line :
     9033   define input  parameter p-recid as recid no-undo .
     9034     do
     9035     on error undo, return error return-value
     9036     :
     9037     find first ub.price-doc-forming-gds exclusive-lock where
     9038          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     9039      if available ub.price-doc-forming-gds then do:
     9040         delete ub.price-doc-forming-gds no-error .
     9041      end.
     9042     end.
     9043   end procedure.
     9044   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9045   procedure factord :
     9046     define input  parameter p-fact-date            as date    no-undo .
     9047     define input  parameter p-fact-time            as integer no-undo .
     9048     define input  parameter p-fact-num             as integer no-undo .
     9049     define input  parameter p-shift-date           as date    no-undo .
     9050     define input  parameter p-shift-num            as integer no-undo .
     9051     define input  parameter p-shift-on             as logical no-undo .
     9052     define output parameter p-fact-order           as decimal no-undo .
     9053     define output parameter p-shift-end-fact-order as decimal no-undo .
     9054     define output parameter p-day-end-fact-order   as decimal no-undo .
     9055     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     9056     if p-fact-date = ?
     9057     then do:
     9058       return error "Не указана фактическая дата" .
     9059     end.
     9060     define variable v-fact-date-num as integer no-undo .
     9061     assign
     9062       v-fact-date-num = integer(p-fact-date)
     9063     .
     9064     if p-fact-num = ?
     9065     or p-fact-num = 0
     9066     then do:
     9067       return error "Не задан p-fact-num " + string(p-fact-num) .
     9068     end.
     9069     if p-fact-num < 0
     9070     then do:
     9071       return error "Отрицательный fact-num " + string(p-fact-num) .
     9072     end.
     9073     if p-fact-num >= 100000000
     9074     then do:
     9075       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     9076     end.
     9077     if p-shift-on = true
     9078     then do:
     9079       if p-shift-date = ?
     9080       then do:
     9081         return error "Не задана дата смены" .
     9082       end.
     9083       if p-shift-num = ?
     9084       or p-shift-num = 0
     9085       then do:
     9086         return error "Не задан номер смены" .
     9087       end.
     9088     end.
     9089     else do:
     9090       assign
     9091         p-shift-date = p-fact-date
     9092         p-shift-num  = 24
     9093       .
     9094     end.
     9095     define variable v-shift-offset as integer no-undo .
     9096     if p-shift-date = p-fact-date
     9097     then do:
     9098       assign
     9099         v-shift-offset = 1
     9100       .
     9101     end.
     9102     if p-shift-date < p-fact-date
     9103     then do:
     9104       assign
     9105         v-shift-offset = 0
     9106       .
     9107     end.
     9108     if p-shift-date > p-fact-date
     9109     then do:
     9110       message
     9111         vss-workfile vss-revision vss-description skip
     9112         "Неправильная дата закрытия смены" skip
     9113         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     9114         view-as alert-box error .
     9115       undo, return error
     9116         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     9117           ,string(p-fact-date, '99/99/9999':U)
     9118           ,string(p-shift-date, '99/99/9999':U)
     9119           )
     9120       .
     9121     end.
     9122     if p-shift-num < 1
     9123     or p-shift-num > 24
     9124     then do:
     9125       message
     9126         vss-workfile vss-revision vss-description skip
     9127         "Неправильный номер смены" skip
     9128         "p-shift-num" p-shift-num skip
     9129         view-as alert-box error .
     9130       undo, return error return-value .
     9131     end.
     9132     assign
     9133       p-fact-order           = v-fact-date-num
     9134                              + v-shift-offset * 0.5
     9135                              + p-shift-num    * 0.02 - 0.01
     9136                              + p-fact-num     * 0.0000000001
     9137       p-shift-end-fact-order = v-fact-date-num
     9138                              + v-shift-offset * 0.5
     9139                              + p-shift-num    * 0.02
     9140       p-day-end-fact-order   = v-fact-date-num
     9141                              + 0.99
     9142     .
     9143     if p-fact-order           <= v-fact-date-num
     9144     or p-shift-end-fact-order <= v-fact-date-num
     9145     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     9146     or p-shift-end-fact-order >= p-day-end-fact-order
     9147     then do:
     9148       message
     9149         vss-workfile vss-revision vss-description skip
     9150         "Внутренняя ошибка при генерации фактического номера" skip
     9151         "p-fact-date"            p-fact-date            skip
     9152         "p-fact-time"            p-fact-time            skip
     9153         "p-fact-num"             p-fact-num             skip
     9154         "p-shift-date"           p-shift-date           skip
     9155         "p-shift-num"            p-shift-num            skip
     9156         "p-shift-on"             p-shift-on             skip
     9157         "p-shift-end-fact-order" p-shift-end-fact-order skip
     9158         "p-day-end-fact-order"   p-day-end-fact-order   skip
     9159         "v-fact-date-num"        v-fact-date-num        skip
     9160         view-as alert-box error .
     9161       undo, return error return-value .
     9162     end.
     9163   end procedure.
     9164   procedure day-begin-fact-order :
     9165     define input  parameter p-fact-date            as date    no-undo .
     9166     define output parameter p-day-begin-fact-order as decimal no-undo .
     9167     do
     9168     on error undo, return error return-value
     9169     :
     9170       if p-fact-date = ?
     9171       then do:
     9172         assign
     9173           p-day-begin-fact-order = 0
     9174         .
     9175       end.
     9176       else do:
     9177         assign
     9178           p-day-begin-fact-order = integer(p-fact-date)
     9179         .
     9180       end.
     9181     end.
     9182   end procedure.
     9183   procedure factord-max-fact-order :
     9184     define output parameter p-max-fact-order as decimal   no-undo .
     9185     do
     9186     on error undo, return error return-value
     9187     :
     9188       run day-begin-fact-order in this-procedure
     9189         (input  date(1, 1, 5000)
     9190         ,output p-max-fact-order
     9191         ) .
     9192     end.
     9193   end procedure.
     9194   procedure factord-cut-archive :
     9195     define input  parameter p-obj-type             as character no-undo .
     9196     define input  parameter p-obj-code             as integer   no-undo .
     9197     define input  parameter p-fact-date            as date      no-undo .
     9198     define output parameter p-shift-on             as logical   no-undo .
     9199     define output parameter p-shift-date           as date      no-undo .
     9200     define output parameter p-shift-num            as integer   no-undo .
     9201     define output parameter p-day-end-fact-order   as decimal   no-undo .
     9202     define output parameter p-shift-end-fact-order as decimal   no-undo .
     9203     define variable v-fact-order as decimal   no-undo .
     9204     define buffer buf_shift-obj for ub.shift-obj .
     9205     do
     9206     on error undo, return error return-value
     9207     :
     9208   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9209   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9210     (input  p-obj-type
     9211     ,input  p-obj-code
     9212     ,input  'shift-on=request'
     9213     ,output p-shift-on
     9214     ) no-error .
     9215       if error-status :error
     9216       then do:
     9217         message
     9218           vss-workfile vss-revision vss-description skip
     9219           "Ошибка при определении атрибута объекта" skip
     9220           "Объект" p-obj-type p-obj-code skip
     9221           error-status :get-message(1) skip
     9222           return-value skip
     9223           view-as alert-box error .
     9224         undo, return error return-value .
     9225       end.
     9226       if p-shift-on = false
     9227       then do:
     9228         assign
     9229           p-shift-date               = ?
     9230           p-shift-num                = 0
     9231         .
     9232       end.
     9233       else do:
     9234         find first buf_shift-obj share-lock
     9235           where buf_shift-obj.obj-type   = p-obj-type
     9236             and buf_shift-obj.obj-code   = p-obj-code
     9237             and buf_shift-obj.shift-date > p-fact-date
     9238           use-index pi
     9239           no-error .
     9240         if not available buf_shift-obj
     9241         or buf_shift-obj.status_ <> 'зкр':U
     9242         then do:
     9243           message
     9244             vss-workfile vss-revision vss-description skip
     9245             "Невозможно вычислить последнюю смену" skip
     9246             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     9247             "Объект" p-obj-type p-obj-code skip
     9248             "Дата" p-fact-date skip
     9249             view-as alert-box error .
     9250           undo, return error return-value .
     9251         end.
     9252         find last buf_shift-obj share-lock
     9253           where buf_shift-obj.obj-type = p-obj-type
     9254             and buf_shift-obj.obj-code = p-obj-code
     9255             and buf_shift-obj.shift-date <= p-fact-date
     9256           use-index pi
     9257           no-error .
     9258         if available buf_shift-obj
     9259         then do:
     9260           if  buf_shift-obj.status_ = 'зкр':U
     9261           then do:
     9262             assign
     9263               p-shift-date = buf_shift-obj.shift-date
     9264               p-shift-num  = buf_shift-obj.shift-num
     9265             .
     9266           end.
     9267           else do:
     9268             message
     9269               vss-workfile vss-revision vss-description skip
     9270               "Невозможно вычислить последнюю смену" skip
     9271               "Статус смены отличен от статуса" 'зкр':U skip
     9272               "Объект" p-obj-type p-obj-code skip
     9273               "Дата" p-fact-date skip
     9274               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     9275               view-as alert-box error .
     9276             undo, return error return-value .
     9277           end.
     9278         end.
     9279         else do:
     9280           assign
     9281             p-shift-date = p-fact-date - 1
     9282             p-shift-num  = 1
     9283           .
     9284         end.
     9285       end.
     9286       run factord in this-procedure
     9287         (input  p-fact-date
     9288         ,input  1
     9289         ,input  1
     9290         ,input  p-shift-date
     9291         ,input  p-shift-num
     9292         ,input  p-shift-on
     9293         ,output v-fact-order
     9294         ,output p-shift-end-fact-order
     9295         ,output p-day-end-fact-order
     9296         ) no-error .
     9297       if error-status :error
     9298       then do:
     9299         message
     9300           vss-workfile vss-revision vss-description skip
     9301           "Ошибка при вызове процедуры factord"
     9302           error-status :get-message(1) skip
     9303           return-value skip
     9304           view-as alert-box error .
     9305         undo, return error return-value .
     9306       end.
     9307     end.
     9308   end procedure.
     9309   procedure factord-lock-shift :
     9310     define input  parameter p-obj-type  as character no-undo .
     9311     define input  parameter p-obj-code  as integer   no-undo .
     9312     define input  parameter p-fact-date as date      no-undo .
     9313     define parameter buffer buf_shift-obj for ub.shift-obj .
     9314     define variable v-shift-on      as logical   no-undo .
     9315     define variable v-extra-message as character no-undo .
     9316     define variable v-error as character no-undo .
     9317     do
     9318     on error undo, return error return-value
     9319     :
     9320   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9322     (input  p-obj-type
     9323     ,input  p-obj-code
     9324     ,input  'shift-on=request'
     9325     ,output v-shift-on
     9326     ) no-error .
     9327       if error-status :error
     9328       then do:
     9329         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     9330         undo, return error v-error .
     9331       end.
     9332       if v-shift-on = true
     9333       then do:
     9334         find first buf_shift-obj share-lock
     9335           where buf_shift-obj.obj-type   = p-obj-type
     9336             and buf_shift-obj.obj-code   = p-obj-code
     9337             and buf_shift-obj.shift-date > p-fact-date
     9338           use-index pi
     9339           no-error .
     9340         if not available buf_shift-obj
     9341         or buf_shift-obj.status_ <> 'зкр':U
     9342         then do:
     9343           find last buf_shift-obj
     9344             where buf_shift-obj.obj-type = p-obj-type
     9345               and buf_shift-obj.obj-code = p-obj-code
     9346               and buf_shift-obj.status_  = 'зкр':U
     9347             use-index stts
     9348             no-error .
     9349           if available buf_shift-obj
     9350           then do:
     9351             assign
     9352               v-extra-message =
     9353                     substitute("Дата начала последеней закрытой смены на объекте &1"
     9354                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     9355                               )
     9356             .
     9357           end.
     9358           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     9359           undo, return error v-error .
     9360         end.
     9361       end.
     9362     end.
     9363   end procedure.
     9364   procedure factord-end-day :
     9365     define input  parameter p-fact-date            as date    no-undo .
     9366     define output parameter p-day-end-fact-order   as decimal no-undo .
     9367     do
     9368     on error undo, return error return-value
     9369     :
     9370       if p-fact-date = ?
     9371       then do:
     9372         return error "Не указана фактическая дата" .
     9373       end.
     9374       assign
     9375         p-day-end-fact-order = integer(p-fact-date) + 0.99
     9376       .
     9377     end.
     9378   end procedure.
     9379   procedure factord-to-date :
     9380     define input  parameter p-fact-order as decimal no-undo .
     9381     define output parameter p-fact-date  as date    no-undo .
     9382     define variable v-ref-date  as date      no-undo .
     9383     define variable v-ref-delta as integer   no-undo .
     9384     do
     9385     on error undo, return error return-value
     9386     :
     9387       if p-fact-order = ?
     9388       or p-fact-order = 0
     9389       then do:
     9390         return error "Не указан fact-order" .
     9391       end.
     9392       assign
     9393         v-ref-date  = date(1, 1, 2000)
     9394       .
     9395       assign
     9396         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     9397       .
     9398       assign
     9399         p-fact-date = v-ref-date + v-ref-delta
     9400       .
     9401     end.
     9402   end procedure.
     9403   procedure factord-to-fact-num :
     9404     define input  parameter p-fact-order as decimal no-undo .
     9405     define output parameter p-fact-num   as integer no-undo .
     9406     define variable v-fact-order-trunc as decimal no-undo .
     9407     do
     9408     on error undo, return error return-value
     9409     :
     9410       if p-fact-order = ?
     9411       or p-fact-order = 0
     9412       then do:
     9413         return error "Не указан fact-order" .
     9414       end.
     9415       assign
     9416        v-fact-order-trunc = truncate(p-fact-order, 2)
     9417       .
     9418       assign
     9419         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     9420       .
     9421     end.
     9422   end procedure.
     9423   procedure factord-to-shift-num :
     9424     define input  parameter p-fact-order as decimal no-undo .
     9425     define output parameter p-shift-num   as integer no-undo .
     9426     define variable  p-shift-numd  as decimal   no-undo .
     9427     define variable v-fact-order-trunc as decimal no-undo .
     9428     do
     9429     on error undo, return error return-value
     9430     :
     9431       if p-fact-order = ?
     9432       or p-fact-order = 0
     9433       then do:
     9434         return error "Не указан fact-order" .
     9435       end.
     9436       assign
     9437        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     9438       .
     9439       if v-fact-order-trunc < 0.5 then do:
     9440         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     9441       end.
     9442       assign
     9443         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     9444         .
     9445        assign
     9446         p-shift-num = truncate (p-shift-numd , 0)
     9447       .
     9448     end.
     9449   end procedure.
     9450   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9451   procedure last-incom-S :
     9452   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     9453   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     9454   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     9455   define output parameter p-in-code   as character no-undo .
     9456   define output parameter p-obj-type  as character no-undo .
     9457   define output parameter p-obj-code  as integer   no-undo .
     9458     do
     9459     on error undo, return error return-value
     9460     :
     9461     define buffer buf_trn-doc for ub.trn-doc .
     9462     define buffer buf_gds-obj for ub.gds-obj  .
     9463     do
     9464     on error undo, return error
     9465     :
     9466       assign
     9467         p-in-code  = ""
     9468         p-obj-type = ""
     9469         p-obj-code = 0
     9470       .
     9471        for each x_obj-group ,
     9472         each buf_gds-obj no-lock
     9473         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     9474           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     9475           and buf_gds-obj.artic     = p-artic
     9476           and buf_gds-obj.prod-type = p-prod-type
     9477           and buf_gds-obj.prod-code = p-prod-code
     9478       , first buf_trn-doc no-lock
     9479         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     9480           and buf_trn-doc.status_  = 'факт':U
     9481       on error undo, return error
     9482       by buf_trn-doc.fact-order descending
     9483       :
     9484         assign
     9485           p-in-code  = buf_gds-obj.in-code
     9486           p-obj-type = buf_gds-obj.obj-type
     9487           p-obj-code = buf_gds-obj.obj-code
     9488         .
     9489         leave .
     9490       end.
     9491     end.
     9492     end.
     9493   end procedure.
     9494   procedure main-road-tax :
     9495   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     9496   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     9497   def input param p-artic     like ub.gds-obj.artic     no-undo .
     9498   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
     9499   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     9500   def input-output param p-road-tax-base as decimal no-undo .
     9501   def input-output param p-road-tax-rubl as decimal no-undo .
     9502   define buffer     buff-goods    for ub.goods   .
     9503   define buffer     buf_gds-obj   for ub.gds-obj .
     9504   define buffer     buf_parts     for ub.parts   .
     9505       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     9506       define buffer   in-vatp-parts    for ub.parts   .
     9507       define buffer   in-vatp-doc      for ub.trn-doc .
     9508       define buffer   in-vatp-goods    for ub.goods   .
     9509       define buffer   in-vatp-sysconf  for ub.sysconf .
     9510       define buffer   in-vatp_doc-attr for ub.doc-attr.
     9511       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     9512       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     9513       define variable varinvprb                  as   character              no-undo.
     9514       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     9515       define variable cli-base-rate              as   decimal                no-undo.
     9516       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     9517       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     9518       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     9519       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     9520       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     9521       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     9522       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     9523       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     9524       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     9525       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     9526       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     9527       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     9528       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     9529       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     9530       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     9531       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     9532       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     9533       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     9534       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     9535       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     9536       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     9537       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     9538       define variable varinvatp-envd             as   character              no-undo.
     9539       define variable varinvatp-type             as   character              no-undo.
     9540   define buffer buf_trn-doc for ub.trn-doc  .
     9541   define buffer buf_doc-line for ub.doc-line .
     9542   define variable   is-petrolium  as logical             no-undo.
     9543   define variable   is-pieces     as logical             no-undo.
     9544   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
     9545   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     9546   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     9547   def var v-rec as recid no-undo.
     9548   def var t-ret as logical no-undo .
     9549   def var v-total-avrg-base as decimal no-undo .
     9550   def var v-total-avrg-rubl as decimal no-undo .
     9551   def var v-total-avrg-qnty as decimal no-undo .
     9552   def var v-total-road-tax-base     as decimal no-undo .
     9553   def var v-total-road-tax-rubl     as decimal no-undo .
     9554   def var v-all-total-road-tax-base as decimal no-undo .
     9555   def var v-all-total-road-tax-rubl as decimal no-undo .
     9556   assign
     9557     p-road-tax-base = ?
     9558     p-road-tax-rubl = ?
     9559     .
     9560     Find first buff-goods no-lock where
     9561           buff-goods.artic     = p-artic and
     9562           buff-goods.prod-type = p-prod-type and
     9563           buff-goods.prod-code = p-prod-code
     9564           no-error .
     9565         if available buff-goods then do:
     9566              v-rec = recid (buff-goods).
     9567              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     9568   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9569     (
     9570        input p-artic
     9571     ,  input p-prod-type
     9572     ,  input p-prod-code
     9573     , output is-petrolium
     9574     , output is-pieces
     9575     ) .
     9576              t-ret =  session:SET-WAIT-STATE("") .
     9577              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     9578                 assign
     9579                   p-road-tax-base = ?
     9580                   p-road-tax-rubl = ?
     9581                   .
     9582                 return.
     9583              end.
     9584         end.
     9585         assign
     9586             v-total-avrg-qnty = 0
     9587             v-total-road-tax-base =  0
     9588             v-total-road-tax-rubl =  0
     9589             v-all-total-road-tax-base =  0
     9590             v-all-total-road-tax-rubl =  0
     9591             .
     9592         for each x_obj-group,
     9593            each buf_parts no-lock
     9594           where buf_parts.obj-type  = x_obj-group.obj-type
     9595             and buf_parts.obj-code  = x_obj-group.obj-code
     9596             and buf_parts.artic     = p-artic
     9597             and buf_parts.prod-type = p-prod-type
     9598             and buf_parts.prod-code = p-prod-code
     9599             and buf_parts.status_   = no
     9600             and buf_parts.out-code  = 'free-zone':U
     9601             and buf_parts.qnty      > 0
     9602         on error undo, return error
     9603         :
     9604            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     9605   assign
     9606     price-rubl-with-tax-loc = buf_parts.price-rubl
     9607     price-base-with-tax-loc = buf_parts.price-base
     9608   .
     9609   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9611     (output varinvprb
     9612     )  .
     9613     if buf_parts.out-code = 'free-zone':U     or
     9614        buf_parts.out-code = 'out-zone':U   or
     9615        buf_parts.doc-type = 'акт':U then do:
     9616       assign
     9617         in-vatp-have-vat-slt = yes.
     9618     end.
     9619     else do:
     9620       find first in-vatp_doc-attr no-lock
     9621         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     9622           and in-vatp_doc-attr.attr-code = 'envd':U
     9623         no-error .
     9624       if not available in-vatp_doc-attr then do:
     9625         assign
     9626           in-vatp-have-vat-slt = yes.
     9627       end.
     9628       else do:
     9629            in-vatp-have-vat-slt = no.
     9630       end.
     9631     end.
     9632     assign
     9633      price-cli-with-tax-loc = buf_parts.price-cli
     9634      cli-base-rate          = buf_parts.cli-base-rate.
     9635     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     9636              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     9637     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     9638             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     9639             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     9640             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     9641             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     9642             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     9643             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9644       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9645     assign
     9646       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     9647     assign
     9648       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     9649       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     9650       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     9651       transport-cli-loc  = 0
     9652       other-cli-loc      = 0
     9653     .
     9654   ASSIGN
     9655             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     9656       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     9657   .
     9658           assign
     9659             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     9660             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     9661            .
     9662         end.
     9663             if v-total-avrg-qnty > 0 then  DO :
     9664                 assign
     9665                   p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     9666                   p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     9667                   .
     9668             end.
     9669               if v-total-avrg-qnty <= 0 then do :
     9670                   run last-incom-S in this-procedure
     9671                   ( input   p-artic ,
     9672                     input   p-prod-type,
     9673                     input   p-prod-code ,
     9674                     output  v-last-in-code,
     9675                     output  v-last-obj-type,
     9676                     output  v-last-obj-code ).
     9677                         find buf_trn-doc where buf_trn-doc.doc-code  = v-last-in-code no-lock no-error .
     9678                         find buf_doc-line where     buf_doc-line.doc-code  = v-last-in-code
     9679                                         and buf_doc-line.artic     = p-artic
     9680                                         and buf_doc-line.prod-type = p-prod-type
     9681                                         and buf_doc-line.prod-code = p-prod-code no-lock no-error.
     9682                         if avail buf_doc-line then do :
     9683   assign
     9684     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     9685     price-base-with-tax-loc = buf_doc-line.price-base
     9686   .
     9687   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9688   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9689     (output varinvprb
     9690     )  .
     9691      find first in-vatp_doc-attr no-lock
     9692       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     9693         and in-vatp_doc-attr.attr-code = 'envd':U
     9694       no-error .
     9695       if available in-vatp_doc-attr
     9696          then do:
     9697          assign
     9698            in-vatp-have-vat-slt = no.
     9699      end.
     9700      else do:
     9701        assign
     9702          in-vatp-have-vat-slt = yes.
     9703      end.
     9704      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     9705                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     9706                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     9707      if (not buf_trn-doc.internal and
     9708              buf_trn-doc.doc-type = 'при':U) or
     9709         in-vatp-goods.gds-type = 'у':U then do:
     9710         if varinvprb = "base":u then do:
     9711           assign
     9712             road-tax-base-loc = buf_doc-line.road-tax
     9713             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     9714         end.
     9715         else do:
     9716           ASSIGN
     9717             road-tax-rubl-loc = buf_doc-line.road-tax
     9718             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     9719         end.
     9720         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     9721         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     9722         assign
     9723           road-tax-cli-loc = ?.
     9724         ASSIGN
     9725           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     9726           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     9727           transport-cli-loc  = 0
     9728           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     9729           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     9730           other-cli-loc      = 0
     9731           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     9732           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     9733                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
