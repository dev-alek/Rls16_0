      858   end procedure.
      859   procedure grp-obj-margin-value :
      860   do
      861   on error undo, return error
      862   :
      863   define input parameter p-node-code as integer      no-undo.
      864   define input parameter p-obj-type  as character    no-undo.
      865   define input parameter p-obj-code  as integer      no-undo.
      866   define output parameter p-min-value as decimal      no-undo init ?.
      867   define output parameter p-max-value as decimal      no-undo init ?.
      868   define output parameter p-increase-pc as decimal      no-undo init ?.
      869   define output parameter p-round-method as character no-undo init "":U.
      870   define output parameter p-base as decimal no-undo init ?.
      871   define output parameter p-range-margin     as integer      no-undo.
      872   define output parameter p-exists-margin    as logical      no-undo.
      873   define output parameter p-range-increase     as integer      no-undo.
      874   define output parameter p-exists-increase    as logical      no-undo.
      875   define output parameter p-range-rmethod     as integer no-undo .
      876   define output parameter p-exists-rmethod    as logical no-undo .
      877   define variable v-host-code as integer      no-undo.
      878   DEFINE VARIABLE v-found as logical no-undo .
      879   DEFINE VARIABLE v-exists as logical no-undo .
      880   DEFINE VARIABLE v-range as integer no-undo .
      881   DEFINE VARIABLE jj as integer no-undo .
      882   DEFINE VARIABLE v-margin-found as logical no-undo .
      883   DEFINE VARIABLE v-increase-found as logical no-undo .
      884   DEFINE VARIABLE v-min-value as decimal      no-undo.
      885   DEFINE VARIABLE v-max-value as decimal      no-undo.
      886   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      887   define variable v-round-method as character no-undo .
      888   define variable v-base as decimal no-undo .
      889   define variable v-print-code as character no-undo .
      890   define buffer buf_gds-grp for ub.gds-grp.
      891   find first buf_gds-grp no-lock where
      892              buf_gds-grp.node-code = p-node-code no-error .
      893   if not avail buf_gds-grp and p-node-code <> 0 then do:
      894     message
      895       vss-workfile vss-revision vss-description
      896       skip "Не удалось найти группу товаров с кодом" p-node-code
      897       view-as alert-box error .
      898     undo, return error .
      899   end.
      900   if p-obj-type <> '' then do:
      901   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      902   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      903     (input  p-obj-type
      904     ,input  p-obj-code
      905     ,output v-host-code
      906     ) no-error .
      907     if error-status :error
      908     then do:
      909         message
      910           vss-workfile vss-revision vss-description
      911           skip "Не удалось найти фирму объекта"
      912           skip p-obj-type p-obj-code
      913           skip return-value
      914           skip trim(error-status :get-message(1))
      915               trim(error-status :get-message(2))
      916               trim(error-status :get-message(3))
      917               trim(error-status :get-message(4))
      918               trim(error-status :get-message(5))
      919         view-as alert-box error.
      920         undo, return error .
      921     end.
      922   end.
      923   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      924   do while v-found = no and jj < 2:
      925     if v-range <> 3 then do:
      926       find first buf_gds-grp-obj no-lock
      927           where buf_gds-grp-obj.node-code = p-node-code
      928             and buf_gds-grp-obj.host-code = v-host-code
      929             and buf_gds-grp-obj.obj-type  = p-obj-type
      930             and buf_gds-grp-obj.obj-code  = p-obj-code
      931       no-error .
      932     end.
      933     if v-range = 3 or not available buf_gds-grp-obj
      934     then do:
      935        if v-range <> 2 then do:
      936           find first buf_gds-grp-obj no-lock
      937               where buf_gds-grp-obj.node-code = p-node-code
      938                 and buf_gds-grp-obj.host-code = v-host-code
      939                 and buf_gds-grp-obj.obj-type  = ""
      940                 and buf_gds-grp-obj.obj-code  = 0
      941           no-error .
      942         end.
      943         if v-range = 2 or not available buf_gds-grp-obj
      944         then do:
      945             if v-range <> 1 then do:
      946               find first buf_gds-grp-obj no-lock
      947                   where buf_gds-grp-obj.node-code = p-node-code
      948                   and buf_gds-grp-obj.host-code = 0
      949                   and buf_gds-grp-obj.obj-type  = ""
      950                   and buf_gds-grp-obj.obj-code  = 0
      951               no-error .
      952             end.
      953             if v-range = 1 or not available buf_gds-grp-obj
      954             then do:
      955                 assign
      956                     v-exists = no
      957                 .
      958             end.
      959             else do:
      960                 assign
      961                     v-exists = yes
      962                     v-range = 1
      963                 .
      964             end.
      965         end.
      966         else do:
      967             assign
      968                 v-exists = yes
      969                 v-range  = 2
      970             .
      971         end.
      972     end.
      973     else do:
      974         assign
      975             v-exists = yes
      976             v-range  = 3
      977         .
      978     end.
      979     if available buf_gds-grp-obj
      980     then do:
      981       assign
      982       v-min-value    = buf_gds-grp-obj.min-increase
      983       v-max-value    = buf_gds-grp-obj.max-increase
      984       v-increase-pc  = buf_gds-grp-obj.increase-pc
      985       v-round-method = buf_gds-grp-obj.round-method
      986       v-base         = buf_gds-grp-obj.round-coef
      987       .
      988       assign
      989       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      990                           then yes
      991                           else p-exists-margin)
      992       p-range-margin = if p-exists-margin and p-min-value = ?
      993                         then v-range
      994                         else p-range-margin
      995       p-min-value   =  if p-exists-margin and  p-min-value = ?
      996                         then v-min-value
      997                         else p-min-value
      998       p-max-value   =  if p-exists-margin and  p-max-value = ?
      999                         then v-max-value
     1000                         else p-max-value
     1001       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     1002                           then yes
     1003                           else p-exists-increase)
     1004       p-range-increase = if p-exists-increase and p-increase-pc = ?
     1005                         then v-range
     1006                         else p-range-increase
     1007       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     1008                         then v-increase-pc
     1009                         else p-increase-pc)
     1010       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     1011                           then yes
     1012                           else p-exists-rmethod
     1013       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     1014                           then v-range
     1015                           else p-range-rmethod)
     1016       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1017                           then v-round-method
     1018                           else p-round-method)
     1019       p-base          = (if p-exists-rmethod and p-base = ?
     1020                           then v-base
     1021                           else p-base)
     1022       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1023       jj = jj + 1
     1024       .
     1025     end.
     1026     else do:
     1027       assign
     1028       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1029       jj = jj + 1
     1030       .
     1031     end.
     1032   end.
     1033   end.
     1034   end procedure.
