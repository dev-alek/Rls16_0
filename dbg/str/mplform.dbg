     1635       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1636       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1637       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1638       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1639       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     1640       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1641       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     1642       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1643       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1644       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1645       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
