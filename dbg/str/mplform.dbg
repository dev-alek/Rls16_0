     2087     on error undo, return error return-value
     2088     :
     2089   define variable v-cur-dn as character no-undo .
     2090   define variable v-cur-pr as decimal   no-undo .
     2091   define variable v-cur-rt as decimal   no-undo .
     2092   define variable v-cur-ex as decimal   no-undo .
