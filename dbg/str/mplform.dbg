     5658    , output v-str1
     5659           ) no-error .
     5660         if error-status :error then
     5661         message
     5662           vss-workfile vss-revision vss-description skip
     5663           error-status :get-message(1) skip
     5664           return-value skip
     5665           "proprice.i"
     5666           view-as alert-box error
     5667         .
     5668         if vd = 0 or vd = ?  then do:
     5669           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5670                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5671                   "- расчет по производителю от последней приходной накладной невозможен."
     5672                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     5673         end.
     5674         else do:
     5675             cost-rubl = vd .
