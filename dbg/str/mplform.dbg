     2969      .
     2970   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2971   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2972     (input  ?
     2973     ,input  l-type
     2974     ,input  l-code
     2975     ,output par-pr-nakl-ie
     2976     ,output par-pr-nakl-iv
     2977     ,output par-pr-nakl-im
     2978     ) no-error .
     2979      define variable ii as integer   no-undo .
     2980      define variable nn as integer   no-undo .
     2981      define variable v-fullname as character no-undo .
     2982      nn = num-entries ( par-pr-nogds ).
     2983      par-pr-nogds-long = "".
     2984      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2985         repeat ii = 1 to nn :
     2986           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2987           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2988         end.
     2989         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2990      end.
     2991   l-par = true .
     2992   end procedure.
     2993   PROCEDURE cre-pr-list:
     2994   define input  parameter bc      like ub.price-list.b-code no-undo.
     2995   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2996   define output parameter new-rec as recid             no-undo.
     2997   define buffer buf-price-list for ub.price-list.
     2998   define buffer buf-price-doc  for ub.price-doc.
     2999   define buffer buf-bar-code   for ub.bar-code.
     3000   define buffer buf-goods      for ub.goods.
     3001   define buffer buf-gds-prt    for ub.gds-prt.
     3002   define buffer root-gds-prt   for ub.gds-prt.
     3003   define variable cur-pr like ub.price-list.price-sale no-undo.
     3004   define variable cur-rt like ub.price-list.road-tax   no-undo.
     3005   define variable cur-ex like ub.price-list.excise     no-undo.
     3006   define variable cur-dn like ub.price-list.doc-num    no-undo.
     3007   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     3008   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     3009   define variable cur-rt-base as decimal no-undo .
     3010   define variable cur-rt-rubl as decimal no-undo .
     3011   define variable p-hostcode as int no-undo .
     3012   define variable v-line-num as integer no-undo .
     3013   define variable v-skip-del-gds as logical no-undo initial no .
     3014   cre-pr:
     3015   do on error undo cre-pr, return error:
     3016     find  buf-bar-code no-lock where
     3017           buf-bar-code.b-code = bc.
     3018     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     3019     if error-status :error then do:
     3020       message
     3021         return-value skip
     3022         "Ошибка !"
     3023         view-as alert-box error
     3024       .
     3025       undo cre-pr, return.
     3026     end.
     3027     find  buf-goods no-lock where
     3028           buf-goods.gds-code = buf-bar-code.gds-code.
     3029     find first root-gds-prt no-lock where
     3030               root-gds-prt.upper-code = buf-goods.prt-root.
     3031     if root-gds-prt.node-name <> '_Пустая шкала':U and
     3032       buf-bar-code.in-code <> "" then do:
     3033       message
     3034         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     3035         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3036         view-as alert-box error.
     3037       undo cre-pr, return.
     3038     end.
     3039     find  buf-gds-prt no-lock where
     3040           buf-gds-prt.node-code = buf-bar-code.node-code.
     3041     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     3042       message
     3043         "Не допускается создавать цены на удаленные товары!" skip (2)
     3044         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3045         view-as alert-box error.
     3046       undo cre-pr, return.
     3047     end.
     3048     find  buf-price-doc where
     3049           buf-price-doc.doc-num = new-num.
     3050   define variable v-ret as logical no-undo .
     3051      run ver-modificator-price-is-null (
     3052             input    buf-goods.artic        ,
     3053             input    buf-goods.prod-type    ,
     3054             input    buf-goods.prod-code    ,
     3055             input    buf-price-doc.obj-type   ,
     3056             input    buf-price-doc.obj-code   ,
     3057             output   v-ret ).
     3058         if v-ret = false then dO:
     3059             message
     3060               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     3061               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3062               view-as alert-box error.
     3063             undo cre-pr, return.
     3064           end.
     3065   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3067     (input  buf-price-doc.obj-type
     3068     ,input  buf-price-doc.obj-code
     3069     ,output p-hostcode
     3070     ) no-error .
     3071   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3072   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3073     (input  buf-goods.gds-code
     3074     ,input  '1':U
     3075     ,input  ?
     3076     ,input  p-hostcode
     3077     ,input  buf-price-doc.obj-type
     3078     ,input  buf-price-doc.obj-code
     3079     ,output local_vat-pc
     3080     ) no-error .
     3081   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3083     (input  buf-goods.gds-code
     3084     ,input  '2':U
     3085     ,input  ?
     3086     ,input  p-hostcode
     3087     ,input  buf-price-doc.obj-type
     3088     ,input  buf-price-doc.obj-code
     3089     ,output local_slt-pc
     3090     ) no-error .
     3091   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3092   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3093     (input  buf-price-doc.obj-type
     3094     ,input  buf-price-doc.obj-code
     3095     ,input  bc
     3096     ,input  0
     3097     ,input  0
     3098     ,output cur-dn
     3099     ,output cur-pr
     3100     ,output cur-rt
     3101     ,output cur-ex
     3102     ) no-error .
     3103     find first buf-price-list where
     3104               buf-price-list.b-code  = buf-bar-code.b-code and
     3105               buf-price-list.doc-num = new-num  and
     3106               buf-price-list.price-type = ""    no-error .
     3107     if not available buf-price-list then do:
     3108       run calc-price-line-num (input  new-num , output v-line-num) .
     3109       create buf-price-list.
     3110       assign
     3111         buf-price-list.line-num  = v-line-num
     3112         buf-price-list.b-code    = buf-bar-code.b-code
     3113         buf-price-list.doc-num   = buf-price-doc.doc-num
     3114         buf-price-list.prod-type = buf-goods.prod-type
     3115         buf-price-list.prod-code = buf-goods.prod-code
     3116         buf-price-list.artic     = buf-goods.artic
     3117         buf-price-list.obj-type  = buf-price-doc.obj-type
     3118         buf-price-list.obj-code  = buf-price-doc.obj-code
     3119         buf-price-list.vat-pc    = local_vat-pc
     3120         buf-price-list.slt-pc    = local_slt-pc
     3121         buf-price-list.price-prev = cur-pr
     3122         .
     3123       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     3124           buf-bar-code.in-code   = "" and
     3125           buf-bar-code.part-code = "" and
     3126           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     3127         buf-price-list.main-price = yes.
     3128         if cur-pr <> ? then do:
     3129           run exp-prt (input buf-goods.gds-code,
     3130                       input cur-dn,
     3131                       input new-num,
     3132                       output new-rec) no-error.
     3133           if error-status :error then do:
     3134             message
     3135               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     3136               view-as alert-box error.
     3137             undo cre-pr, return error.
     3138           end.
     3139         end.
     3140       end.
     3141       else do:
     3142         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3143           buf-price-list.d-pcnt = ?.
     3144         end.
     3145         buf-price-list.main-price = no.
     3146       end.
     3147     end.
     3148   end.
     3149   new-rec = recid (buf-price-list).
     3150   END PROCEDURE.
     3151   procedure calc-price-line-num :
     3152    do
     3153    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3154    :
     3155   define input parameter p-doc-num as character no-undo .
     3156   define output parameter p-num  as integer no-undo .
     3157   define variable v-fact as integer no-undo .
     3158   define buffer buf_1_price-list for ub.price-list .
     3159   p-num = 1 .
     3160   find last  buf_1_price-list no-lock where
     3161              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     3162              if available buf_1_price-list then
     3163                   assign
     3164                     v-fact = buf_1_price-list.line-num
     3165                   .
     3166   v-fact = v-fact + 1.
     3167   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     3168    end.
     3169   end procedure.
     3170   PROCEDURE del-pr-list:
     3171   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3172   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3173   define input parameter round-method as character         no-undo.
     3174   define input parameter round-base   as decimal      no-undo.
     3175   define buffer buf-price-list for ub.price-list.
     3176   define buffer buf-bar-code   for ub.bar-code.
     3177   define buffer buf-goods      for ub.goods.
     3178   define variable l-ov-on as logical no-undo .
     3179   del-pr:
     3180   do on error undo del-pr, return error:
     3181     find first  buf-price-list no-lock where
     3182                 buf-price-list.doc-num    = d-num and
     3183                 buf-price-list.b-code     = bc and
     3184                 buf-price-list.price-type = "" no-error.
     3185     if not available buf-price-list then
     3186       undo del-pr, return error.
     3187     find  buf-goods no-lock where
     3188           buf-goods.prod-type = buf-price-list.prod-type and
     3189           buf-goods.prod-code = buf-price-list.prod-code and
     3190           buf-goods.artic     = buf-price-list.artic.
     3191     if buf-price-list.main-price then do:
     3192       for each  buf-price-list exclusive-lock where
     3193                 buf-price-list.doc-num   = d-num and
     3194                 buf-price-list.artic     = buf-goods.artic and
     3195                 buf-price-list.prod-type = buf-goods.prod-type and
     3196                 buf-price-list.prod-code = buf-goods.prod-code,
     3197           first buf-bar-code no-lock where
     3198                 buf-bar-code.b-code = buf-price-list.b-code
     3199       on error undo del-pr, return error:
     3200   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3202     (input  ub.buf-price-list.obj-type
     3203     ,input  ub.buf-price-list.obj-code
     3204     ,input  ub.buf-price-list.artic
     3205     ,input  ub.buf-price-list.prod-type
     3206     ,input  ub.buf-price-list.prod-code
     3207     ,input  'ov-on=request:exclusive'
     3208     ,output l-ov-on
     3209     ) no-error .
     3210         if error-status:error then do:
     3211           message
     3212             vss-workfile vss-revision vss-description skip
     3213             "Ошибка получения признака товара на объекте" skip
     3214             error-status :get-message(1) skip
     3215             return-value skip
     3216             view-as alert-box error .
     3217         end.
     3218         if l-ov-on then do:
     3219   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3221     (input  ub.buf-price-list.obj-type
     3222     ,input  ub.buf-price-list.obj-code
     3223     ,input  ub.buf-price-list.artic
     3224     ,input  ub.buf-price-list.prod-type
     3225     ,input  ub.buf-price-list.prod-code
     3226     ,input  'ov-on=false'
     3227     ,output l-ov-on
     3228     ) no-error .
     3229           if error-status :error then do:
     3230           end.
     3231          end.
     3232         delete buf-price-list.
     3233       end.
     3234     end.
     3235     else do:
     3236       find  buf-bar-code no-lock where
     3237             buf-bar-code.b-code = buf-price-list.b-code.
     3238       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3239         message
     3240           "Нельзя удалить неосновную цену." skip
     3241           "Неосновная цена (скидка) не может быть неопределенной." skip
     3242           "Код:" bc skip
     3243           "Переоценка:" d-num
     3244           view-as alert-box error.
     3245         undo del-pr, return error.
     3246       end.
     3247       find current buf-price-list exclusive-lock no-error .
     3248       delete buf-price-list.
     3249       run calc-base-upd (input buf-bar-code.b-code,
     3250                         input d-num,
     3251                         input round-method,
     3252                         input round-base) no-error.
     3253       if error-status :error then
     3254         undo del-pr, return error.
     3255     end.
     3256   end.
     3257   END PROCEDURE.
     3258   PROCEDURE calc-base-upd:
     3259   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3260   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3261   define input parameter round-method as character         no-undo.
     3262   define input parameter round-base   as decimal      no-undo.
     3263   define buffer alt-bar-code   for ub.bar-code.
     3264   define buffer alt-price-list for ub.price-list.
     3265   define buffer buf-bar-code   for ub.bar-code.
     3266   define buffer buf-goods      for ub.goods.
     3267   calc-base:
     3268   do on error undo calc-base, return error:
     3269     find  buf-bar-code no-lock where
     3270           buf-bar-code.b-code = bc.
     3271     find  buf-goods no-lock where
     3272           buf-goods.gds-code = buf-bar-code.gds-code.
     3273     for each  alt-bar-code no-lock where
     3274               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     3275               alt-bar-code.node-code = buf-bar-code.node-code and
     3276               alt-bar-code.part-code = buf-bar-code.part-code and
     3277               alt-bar-code.in-code   = buf-bar-code.in-code and
     3278               alt-bar-code.unit-cli <> buf-goods.unit-base,
     3279         each  alt-price-list where
     3280               alt-price-list.doc-num    = d-num and
     3281               alt-price-list.b-code     = alt-bar-code.b-code and
     3282               alt-price-list.price-type = ""
     3283         on error undo calc-base, return error:
     3284       run calc-pr-alt (input d-num,
     3285                       input alt-bar-code.b-code,
     3286                       input round-method,
     3287                       input round-base) no-error.
     3288       if error-status:error then
     3289         undo calc-base, return error.
     3290     end.
     3291   end.
     3292   END PROCEDURE.
     3293   PROCEDURE calc-pr-alt:
     3294   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3295   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3296   define input parameter r-method as character             no-undo.
     3297   define input parameter r-base   as decimal              no-undo.
     3298   define buffer buf-price-doc  for ub.price-doc.
     3299   define buffer buf-price-list for ub.price-list.
     3300   define buffer buf-bar-code   for ub.bar-code.
     3301   define buffer buf-goods      for ub.goods.
     3302   define buffer old-price-list for ub.price-list.
     3303   define variable pr-rec   as   recid                  no-undo.
     3304   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3305   pr-alt:
     3306   do on error undo pr-alt, return error:
     3307     if r-method = ? or
     3308        r-base = ? then do:
     3309       message
     3310         "Нельзя удалить основную цену." skip
     3311         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     3312         "Код:" bc skip
     3313         "Переоценка:" d-num
     3314         view-as alert-box error.
     3315       undo pr-alt, return error.
     3316     end.
     3317     find  buf-price-doc where
     3318           buf-price-doc.doc-num = d-num.
     3319     find  buf-bar-code no-lock where
     3320           buf-bar-code.b-code = bc.
     3321     find  buf-goods no-lock where
     3322           buf-goods.gds-code = buf-bar-code.gds-code.
     3323     find  buf-price-list where
     3324           buf-price-list.doc-num = buf-price-doc.doc-num and
     3325           buf-price-list.b-code  = bc.
     3326     if buf-price-list.d-pcnt = ? then do:
     3327   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3328   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3329     (input  buf-price-doc.obj-type
     3330     ,input  buf-price-doc.obj-code
     3331     ,input  bc
     3332     ,input  0
     3333     ,input  0
     3334     ,output pr-rec
     3335     ,output pr-c-b-r
     3336     )  .
     3337       find old-price-list no-lock where
     3338           recid (old-price-list) = pr-rec no-error.
     3339       if available old-price-list and
     3340         old-price-list.b-code = bc then
     3341         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     3342       else
     3343         buf-price-list.d-pcnt = 0.
     3344     end.
     3345      if buf-price-list.d-pcnt = ? then do:
     3346         assign
     3347           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     3348           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     3349           .
     3350     end.
     3351     else do:
     3352         assign
     3353           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     3354                                         buf-bar-code.cli-base-rate *
     3355                                         (1 - buf-price-list.d-pcnt / 100)
     3356           buf-price-list.calc-method =  'Основная':U
     3357           .
     3358   case r-method :
     3359     when '9-окончание':U then do:
     3360       if buf-price-list.price-sale < 29 then do:
     3361         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     3362           assign
     3363             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     3364           .
     3365         end.
     3366       end.
     3367       else do:
     3368         if (buf-price-list.price-sale modulo 10) < 3 then do:
     3369           assign
     3370             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3371                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3372                   - 1 ) * 10
     3373                 + 9
     3374           .
     3375         end.
     3376         else do:
     3377           assign
     3378             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3379                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3380                   ) * 10
     3381                 + 9
     3382           .
     3383         end.
     3384         assign
     3385           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3386         .
     3387       end.
     3388     end.
     3389     when '9-99окончание':U then do:
     3390       if buf-price-list.price-sale < r-base then do:
     3391         assign
     3392           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     3393         .
     3394       end.
     3395       else do:
     3396         assign
     3397           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     3398         .
     3399       end.
     3400     end.
     3401     when 'Без-дробных':U then do:
     3402       assign
     3403         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3404       .
     3405     end.
     3406     when 'Произвольно':U then do:
     3407       if r-base <> 0 then do:
     3408         assign
     3409           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     3410         .
     3411         if buf-price-list.price-sale = 0 then do:
     3412           assign
     3413             buf-price-list.price-sale = r-base
     3414           .
     3415         end.
     3416       end.
     3417     end.
     3418     when 'Вверх':U then do:
     3419       if r-base <> 0 then do:
     3420         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     3421           assign
     3422             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     3423           .
     3424         end.
     3425       end.
     3426       if buf-price-list.price-sale = 0 then do:
     3427         assign
     3428           buf-price-list.price-sale = r-base
     3429         .
     3430       end.
     3431     end.
     3432     when 'Коэффициент':U then do:
     3433       if r-base <> 0 then do:
     3434         assign
     3435           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     3436         .
     3437       end.
     3438     end.
     3439     when 'Отключено':U then do:
     3440     end.
     3441     otherwise do:
     3442       message
     3443         vss-workfile vss-revision vss-description skip
     3444         "Неизвестный метод округления продажной цены" skip
     3445         "round-method" r-method skip
     3446         "round-base"   r-base   skip
     3447         "price"        buf-price-list.price-sale             skip
     3448         view-as alert-box error .
     3449     end.
     3450   end.
     3451     end.
     3452   end.
     3453   END PROCEDURE.
     3454   PROCEDURE calc-pr-discnt:
     3455   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3456   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3457   define buffer buf-price-doc  for ub.price-doc.
     3458   define buffer buf-price-list for ub.price-list.
     3459   define buffer buf-bar-code   for ub.bar-code.
     3460   define buffer buf-goods      for ub.goods.
     3461   define buffer old-price-list for ub.price-list.
     3462   define variable pr-rec   as   recid                  no-undo.
     3463   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3464   pr-discnt:
     3465   do on error undo pr-discnt, return error:
     3466     find  buf-price-doc where
     3467           buf-price-doc.doc-num = d-num.
     3468     find  buf-bar-code no-lock where
     3469           buf-bar-code.b-code = bc.
     3470     find  buf-goods no-lock where
     3471           buf-goods.gds-code = buf-bar-code.gds-code.
     3472     find  buf-price-list where
     3473           buf-price-list.doc-num = buf-price-doc.doc-num and
     3474           buf-price-list.b-code  = bc.
     3475     buf-price-list.d-pcnt = (1 -
     3476                              buf-price-list.price-sale /
     3477                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3478                              buf-bar-code.cli-base-rate) *
     3479                              100
     3480                              .
     3481   end.
     3482   END PROCEDURE.
     3483   PROCEDURE calc-pr-sub :
     3484   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3485   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3486   define  input  parameter calc-method  as character    no-undo.
     3487   define  input  parameter increase-pc  as decimal      no-undo.
     3488   define  input  parameter round-method as character    no-undo.
     3489   define  input  parameter round-base   as decimal      no-undo.
     3490   define  output parameter calc-rec     as recid        no-undo.
     3491   define  buffer buf-price-list for ub.price-list.
     3492   define  buffer buf-bar-code   for ub.bar-code.
     3493   define  buffer buf-goods      for ub.goods.
     3494   define  buffer buf-gds-prt    for ub.gds-prt.
     3495   define  buffer buf-gds-grp    for ub.gds-grp.
     3496   define  buffer buf-price-doc  for ub.price-doc.
     3497   calc-sub:
     3498   do on error undo calc-sub, return error:
     3499     find  buf-bar-code no-lock where
     3500           buf-bar-code.b-code = bc.
     3501     find  buf-goods no-lock where
     3502           buf-goods.gds-code = buf-bar-code.gds-code.
     3503     find  buf-gds-prt no-lock where
     3504           buf-gds-prt.node-code = buf-bar-code.node-code.
     3505     find  buf-price-list where
     3506           buf-price-list.doc-num    = d-num and
     3507           buf-price-list.b-code     = bc and
     3508           buf-price-list.price-type = "".
     3509     find  buf-price-doc where
     3510           buf-price-doc.doc-num = d-num.
     3511     calc-rec = recid (buf-price-list).
     3512     if buf-price-list.main-price then do:
     3513       for each  buf-price-list where
     3514                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3515                 buf-price-list.main-price = no and
     3516                 buf-price-list.artic      = buf-goods.artic and
     3517                 buf-price-list.prod-type  = buf-goods.prod-type and
     3518                 buf-price-list.prod-code  = buf-goods.prod-code,
     3519           first buf-bar-code no-lock where
     3520                 buf-bar-code.b-code   = buf-price-list.b-code and
     3521                 buf-bar-code.unit-cli = buf-goods.unit-base
     3522           on error undo calc-sub, return error:
     3523         run calc-pr-list (input  buf-bar-code.b-code,
     3524                           input  buf-price-list.doc-num,
     3525                           input  calc-method,
     3526                           input  increase-pc,
     3527                           input  round-method,
     3528                           input  round-base,
     3529                           input ? ,
     3530                           input ? ,
     3531                           input ? ,
     3532                           input ? ,
     3533                           output calc-rec) no-error.
     3534         if error-status :error then
     3535           undo calc-sub, return error.
     3536         calc-rec = recid (buf-price-list).
     3537       end.
     3538       for each  buf-price-list where
     3539                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3540                 buf-price-list.main-price = no and
     3541                 buf-price-list.artic      = buf-goods.artic and
     3542                 buf-price-list.prod-type  = buf-goods.prod-type and
     3543                 buf-price-list.prod-code  = buf-goods.prod-code,
     3544           first buf-bar-code no-lock where
     3545                 buf-bar-code.b-code    = buf-price-list.b-code and
     3546                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3547           on error undo calc-sub, return error:
     3548         run calc-pr-alt (input buf-price-doc.doc-num,
     3549                         input buf-bar-code.b-code,
     3550                         input round-method,
     3551                         input round-base) no-error.
     3552         if error-status :error then
     3553           undo calc-sub, return error.
     3554       end.
     3555     end.
     3556     else do:
     3557       run calc-base-upd (input buf-bar-code.b-code,
     3558                         input buf-price-doc.doc-num,
     3559                         input round-method,
     3560                         input round-base) no-error.
     3561       if error-status :error then
     3562         undo calc-sub, return error.
     3563     end.
     3564   end.
     3565   END PROCEDURE.
     3566   procedure ver-pr-nogds :
     3567   define input  parameter p-gds-code      as integer   no-undo .
     3568   define input  parameter p-par-pr-nogds  as character no-undo .
     3569   define output parameter p-not           as logical   no-undo .
     3570   define output parameter p-str           as character no-undo .
     3571   define buffer buf_goods for ub.goods  .
     3572   define variable nn as integer   no-undo .
     3573   define variable ii as integer   no-undo .
     3574   define variable v-namegrp as character no-undo .
     3575     do
     3576     on error undo, return error return-value
     3577     :
     3578     if p-par-pr-nogds = "1" then do:
     3579        assign
     3580         p-not = true
     3581         p-str = ""
     3582        .
     3583        return .
     3584     end.
     3585     assign
     3586       p-not = false
     3587       p-str = ""
     3588     .
     3589     find first buf_goods no-lock where
     3590                buf_goods.gds-code = p-gds-code no-error .
     3591     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3592     repeat ii = 1 to nn:
     3593        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3594        if buf_goods.grp-name  begins v-namegrp  then do:
     3595           assign
     3596             p-not = true
     3597             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3598           .
     3599           leave .
     3600        end.
     3601     end.
     3602     end.
     3603   end procedure.
     3604   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3605   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3606   define temp-table tt-level-dis-attr no-undo
     3607         field attr-code   like global-state-attr.attr-code
     3608         field attr-value  like global-state-attr.attr-value
     3609         index pi   attr-value descending
     3610         index pi1 is unique attr-value
     3611               attr-code .
     3612   procedure lvldsc-byattr :
     3613   define input  parameter p-attr-code  as character no-undo .
     3614   define input  parameter p-attr-value as character no-undo .
     3615   define output parameter p-val1       as decimal   no-undo .
     3616   define output parameter p-val2       as decimal   no-undo .
     3617   define output parameter p-prc        as decimal   no-undo .
     3618     do
     3619     on error undo, return error return-value
     3620     :
     3621     define variable v-str1 as character no-undo .
     3622     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     3623     v-str1 = trim ( v-str1 , chr(4) ) .
     3624    run lvldsc-bytt (
     3625         input   v-str1
     3626       , input   p-attr-value
     3627       , output  p-val1
     3628       , output  p-val2
     3629       , output  p-prc )
     3630         no-error .
     3631     end.
     3632   end procedure.
     3633   procedure lvldsc-bytt :
     3634   define input  parameter p-attr-code as character no-undo .
     3635   define input  parameter p-attr-value as character no-undo .
     3636   define output parameter p-val1 as decimal   no-undo .
     3637   define output parameter p-val2 as decimal   no-undo .
     3638   define output parameter p-prc  as decimal   no-undo .
     3639   define variable v-str1 as character no-undo .
     3640     do
     3641     on error undo, return error return-value
     3642     :
     3643     assign
     3644        v-str1 = trim ( p-attr-code , "[]()" )
     3645        p-val1 = decimal(entry(1,v-str1, ";"))
     3646        p-val2 = decimal(entry(2,v-str1, ";"))
     3647        p-prc  = decimal(p-attr-value)
     3648        no-error
     3649     .
     3650     end.
     3651   end procedure.
     3652   procedure level-dis-value :
     3653   define input  parameter p-price-prod as decimal   no-undo .
     3654   define input  parameter p-b-code     as integer   no-undo .
     3655   define input  parameter p-obj-type   as character no-undo .
     3656   define input  parameter p-obj-code   as integer   no-undo .
     3657   define output parameter p-prc as decimal   no-undo .
     3658   define variable v-level-dis-attr as character no-undo .
     3659   define variable v-type as character no-undo .
     3660   define variable v-val1 as decimal   no-undo .
     3661   define variable v-val2 as decimal   no-undo .
     3662   define variable v-prc  as decimal   no-undo .
     3663   define variable ix     as integer   no-undo .
     3664   do
     3665    on error undo, return error return-value
     3666    :
     3667   define buffer buf_goods for ub.goods  .
     3668   define buffer buf_bar-code for ub.bar-code  .
     3669   find first buf_bar-code no-lock where
     3670              buf_bar-code.b-code = p-b-code
     3671              no-error .
     3672   find first buf_goods no-lock where
     3673              buf_goods.gds-code = buf_bar-code.gds-code
     3674              no-error .
     3675   run ggoattr-value (
     3676      input   buf_goods.grp-code
     3677     ,input   v-cntxt-host-code-obj
     3678     ,input   p-obj-type
     3679     ,input   p-obj-code
     3680     ,input   'level-dis':U
     3681     ,output  v-level-dis-attr
     3682     ,output  v-type ) no-error .
     3683   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     3684     create
     3685       tt-level-dis-attr
     3686     .
     3687     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3688     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3689   end.
     3690   p-prc = 0 .
     3691     if p-price-prod = 0 then do:
     3692         for each tt-level-dis-attr no-lock
     3693                 :
     3694               run lvldsc-bytt (
     3695                 input   tt-level-dis-attr.attr-code
     3696               , input   tt-level-dis-attr.attr-value
     3697               , output  v-val1
     3698               , output  v-val2
     3699               , output  v-prc  )
     3700               .
     3701               if v-val1  = 0  then do:
     3702                  p-prc = v-prc .
     3703                 leave.
     3704               end.
     3705         end.
     3706     end.
     3707     else do:
     3708         for each tt-level-dis-attr no-lock
     3709                 :
     3710               run lvldsc-bytt (
     3711                 input   tt-level-dis-attr.attr-code
     3712               , input   tt-level-dis-attr.attr-value
     3713               , output  v-val1
     3714               , output  v-val2
     3715               , output  v-prc  )
     3716               .
     3717               if p-price-prod   > v-val1 and
     3718                  p-price-prod  <= v-val2 then do:
     3719                  p-prc = v-prc .
     3720                 leave.
     3721               end.
     3722         end.
     3723     end.
     3724   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     3725    end.
     3726   end procedure.
     3727   procedure calc-price-levelprod :
     3728   define input  parameter p-mode     as integer   no-undo .
     3729   define input  parameter p-rb       as character no-undo .
     3730   define input  parameter p-b-code   as integer   no-undo .
     3731   define input  parameter p-obj-type as character no-undo .
     3732   define input  parameter p-obj-code as integer   no-undo .
     3733   define output parameter p-price-sale as decimal   no-undo .
     3734   define output parameter p-descript-calc as character no-undo .
     3735   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     3736   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     3737   define variable  v-prod-vat        as decimal   no-undo init 0.
     3738   define variable  v-discnt          as decimal   no-undo init 0.
     3739   define buffer buf_goods for ub.goods  .
     3740   define buffer buf_bar-code for ub.bar-code  .
     3741   define buffer buf_parts for ub.parts  .
     3742   define variable v-part-code as character no-undo .
     3743   define variable v-in-code   as character no-undo .
     3744     do
     3745     on error undo, return error return-value
     3746     :
     3747   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3748   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3749   (  input  p-b-code
     3750    , input  p-obj-type
     3751    , input  p-obj-code
     3752    , output v-PriceWithoutVat
     3753    , output v-PriceWithVat
     3754    , output v-prod-vat
     3755    , output v-part-code
     3756    , output v-in-code
     3757           ) no-error .
     3758         if error-status :error then do:
     3759           return error "Нет цены производителя!".
     3760         end.
     3761   find first buf_bar-code no-lock where
     3762              buf_bar-code.b-code = p-b-code
     3763              no-error .
     3764   find first buf_goods no-lock where
     3765              buf_goods.gds-code = buf_bar-code.gds-code
     3766              no-error .
     3767   find first buf_parts no-lock where
     3768              buf_parts.artic      = buf_goods.artic        and
     3769              buf_parts.prod-type  = buf_goods.prod-type    and
     3770              buf_parts.prod-code  = buf_goods.prod-code    and
     3771              buf_parts.in-code    = buf_bar-code.in-code   and
     3772              buf_parts.out-code   = buf_bar-code.in-code   and
     3773              buf_parts.part-code  = buf_bar-code.part-code
     3774              no-error .
     3775               if error-status :error then do:
     3776                   find first buf_parts no-lock where
     3777                             buf_parts.artic      = buf_goods.artic        and
     3778                             buf_parts.prod-type  = buf_goods.prod-type    and
     3779                             buf_parts.prod-code  = buf_goods.prod-code    and
     3780                             buf_parts.in-code    = v-in-code              and
     3781                             buf_parts.out-code   = v-in-code              and
     3782                             buf_parts.part-code  = v-part-code
     3783                             no-error .
     3784                   if error-status :error then do:
     3785                      message
     3786                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     3787                                   v-in-code,
     3788                                   v-part-code ,
     3789                                   buf_goods.artic   ,
     3790                                   buf_goods.prod-type,
     3791                                   buf_goods.prod-code ) .
     3792                      return error "Нет цены производителя !!!".
     3793                   end.
     3794               end.
     3795   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     3796   define variable v-postWithoutVat-rubl as decimal   no-undo .
     3797   define variable v-postWithoutVat-base as decimal   no-undo .
     3798      case p-mode :
     3799       when 1 then do:
     3800          if p-rb = "rubl" then do:
     3801             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     3802          end.
     3803          else do:
     3804             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     3805          end.
     3806       end.
     3807       when 2 then do:
     3808         if p-rb = "rubl" then do:
     3809           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     3810           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     3811         end.
     3812         else do:
     3813           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     3814           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     3815         end.
     3816       end.
     3817      end case.
     3818   p-descript-calc =
     3819     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     3820     buf_goods.gds-name                  +  chr(10) +
     3821     buf_goods.artic +
     3822     buf_goods.prod-type +
     3823     string(buf_goods.prod-code)         + chr(10) +
     3824     "бар-код " +  string(p-b-code)      + chr(10)  +
     3825     'ПН    ' + v-in-code  +
     3826     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     3827     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     3828     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     3829     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     3830     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     3831     chr(10) +
     3832     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     3833     chr(10) +
     3834     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     3835     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     3836     chr(10) +
     3837     string(p-price-sale)                                                               +  chr(10) +
     3838     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     3839     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     3840   .
     3841     end.
     3842   end procedure.
     3843   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3844   PROCEDURE write-bonus :
     3845   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3846   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3847   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3848   define input  parameter v-bonus as decimal   no-undo .
     3849     do
     3850     on error undo, return error return-value
     3851     :
     3852       find first ub.contract-specif-attr exclusive-lock  where
     3853                  ub.contract-specif-attr.contract-num = p-contract-num  and
     3854                  ub.contract-specif-attr.host-code    = p-host-code     and
     3855                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     3856                  ub.contract-specif-attr.attr-code    = 'bonus':U
     3857                 no-error .
     3858         if not available ub.contract-specif-attr then do:
     3859            create ub.contract-specif-attr .
     3860            assign
     3861                 ub.contract-specif-attr.contract-num = p-contract-num
     3862                 ub.contract-specif-attr.host-code    = p-host-code
     3863                 ub.contract-specif-attr.gds-code     = p-gds-code
     3864                 ub.contract-specif-attr.attr-code    = 'bonus':U
     3865            .
     3866         end.
     3867         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     3868   end.
     3869   END PROCEDURE.
     3870   PROCEDURE read-bonus :
     3871   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3872   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3873   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3874   define output parameter v-bonus as decimal   no-undo .
     3875     do
     3876     on error undo, return error return-value
     3877     :
     3878   find first ub.contract-specif-attr no-lock  where
     3879              ub.contract-specif-attr.contract-num = p-contract-num  and
     3880              ub.contract-specif-attr.host-code    = p-host-code     and
     3881              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3882              ub.contract-specif-attr.attr-code    = 'bonus':U
     3883              no-error .
     3884      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     3885                                           else  v-bonus = 0 .
     3886   end.
     3887   END PROCEDURE.
     3888   PROCEDURE write-prc-min :
     3889   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3890   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3891   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3892   define input  parameter v-prc-min        as decimal   no-undo .
     3893     do
     3894     on error undo, return error return-value
     3895     :
     3896       find first ub.contract-specif-attr exclusive-lock  where
     3897                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3898                 ub.contract-specif-attr.host-code    = p-host-code     and
     3899                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3900                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3901                 no-error .
     3902         if not available ub.contract-specif-attr then do:
     3903            create ub.contract-specif-attr .
     3904            assign
     3905                 ub.contract-specif-attr.contract-num = p-contract-num
     3906                 ub.contract-specif-attr.host-code    = p-host-code
     3907                 ub.contract-specif-attr.gds-code     = p-gds-code
     3908                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3909                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     3910            .
     3911         end.
     3912         else do:
     3913            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     3914         end.
     3915       find first ub.contract-specif exclusive-lock where
     3916           ub.contract-specif.contract-num = p-contract-num and
     3917           ub.contract-specif.host-code    = p-host-code    and
     3918           ub.contract-specif.gds-code     = p-gds-code.
     3919           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3920   end.
     3921   END PROCEDURE.
     3922   PROCEDURE read-prc-min :
     3923   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3924   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3925   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3926   define output parameter v-prc-min as decimal   no-undo .
     3927     do
     3928     on error undo, return error return-value
     3929     :
     3930   find first ub.contract-specif-attr no-lock  where
     3931              ub.contract-specif-attr.contract-num = p-contract-num  and
     3932              ub.contract-specif-attr.host-code    = p-host-code     and
     3933              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3934              ub.contract-specif-attr.attr-code    = 'prc-min':U
     3935              no-error .
     3936      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     3937                                           else  v-prc-min = 0 .
     3938   end.
     3939   END PROCEDURE.
     3940   PROCEDURE write-retro-bonus :
     3941   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3942   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3943   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3944   define input  parameter v-retro-bonus as character   no-undo .
     3945     do
     3946     on error undo, return error return-value
     3947     :
     3948       find first ub.contract-specif-attr exclusive-lock  where
     3949                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3950                 ub.contract-specif-attr.host-code    = p-host-code     and
     3951                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3952                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3953                 no-error .
     3954         if not available ub.contract-specif-attr then do:
     3955            create ub.contract-specif-attr .
     3956            assign
     3957                 ub.contract-specif-attr.contract-num = p-contract-num
     3958                 ub.contract-specif-attr.host-code    = p-host-code
     3959                 ub.contract-specif-attr.gds-code     = p-gds-code
     3960                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3961            .
     3962            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3963            if error-status:error then
     3964               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3965         end.
     3966         else do:
     3967            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3968            if error-status:error then
     3969               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3970         end.
     3971       find first ub.contract-specif exclusive-lock where
     3972           ub.contract-specif.contract-num = p-contract-num and
     3973           ub.contract-specif.host-code    = p-host-code    and
     3974           ub.contract-specif.gds-code     = p-gds-code.
     3975           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3976   end.
     3977   END PROCEDURE.
     3978   PROCEDURE read-retro-bonus :
     3979   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3980   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3981   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3982   define output parameter v-retro-bonus as character   no-undo .
     3983     do
     3984     on error undo, return error return-value
     3985     :
     3986   find first ub.contract-specif-attr no-lock  where
     3987              ub.contract-specif-attr.contract-num = p-contract-num  and
     3988              ub.contract-specif-attr.host-code    = p-host-code     and
     3989              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3990              ub.contract-specif-attr.attr-code    = "retro-bonus"
     3991              no-error .
     3992      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     3993                                           else  v-retro-bonus = "" .
     3994   end.
     3995   END PROCEDURE.
     3996   define variable v-str1 as character no-undo .
     3997   FUNCTION fnc-base-price-doc RETURN decimal
     3998     ( local-bc as integer, p-recid as recid ).
     3999   define buffer   base-price       for ub.price-doc-forming-gds .
     4000   define variable local-main-code like ub.bar-code.b-code no-undo.
     4001   define variable local-base-code like ub.bar-code.b-code no-undo.
     4002   define buffer   buf_main-pdf     for ub.price-doc-forming .
     4003   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     4004     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     4005     find base-price no-lock where
     4006          base-price.pdf-id = buf_main-pdf.pdf-id and
     4007          base-price.pdf-db = buf_main-pdf.pdf-db and
     4008          base-price.plt-id = buf_main-pdf.plt-id and
     4009          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     4010          base-price.b-code  = local-base-code
     4011          no-error.
     4012     if not available base-price then do:
     4013       run prc-main-code in this-procedure
     4014          ( input local-bc, output local-main-code ).
     4015       find  base-price no-lock where
     4016             base-price.pdf-id = buf_main-pdf.pdf-id and
     4017             base-price.pdf-db = buf_main-pdf.pdf-db and
     4018             base-price.plt-id = buf_main-pdf.plt-id and
     4019             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     4020             base-price.b-code  = local-main-code
     4021             no-error.
     4022     end.
     4023     if available base-price then
     4024       return (base-price.price-sale-doc).
     4025     else
     4026       return (?).
     4027   END FUNCTION.
     4028   procedure set-price-line :
     4029     do
     4030     on error undo, return error return-value
     4031     :
     4032   define input  parameter p-plt-id as integer   no-undo .
