     8322                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     8323               check-par = false .
     8324                  for each pp_price-list no-lock where
     8325                           pp_price-list.plt-id     = p-plt-id     and
     8326                           pp_price-list.plt-db-num = p-plt-db-num and
     8327                           pp_price-list.pdf-id     = p-pdf-id     and
     8328                           pp_price-list.pdf-db     = p-pdf-db     and
     8329                           pp_price-list.artic      = pdf_price-list.artic and
     8330                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     8331                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     8332                        first buf1-bar-code no-lock where
     8333                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8334                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     8335                       :
     8336                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     8337                       check-par = true  .
     8338                       leave.
     8339                   end.
     8340                  for each pp_price-list no-lock where
     8341                           pp_price-list.plt-id     = p-plt-id     and
     8342                           pp_price-list.plt-db-num = p-plt-db-num and
     8343                           pp_price-list.pdf-id     = p-pdf-id     and
     8344                           pp_price-list.pdf-db     = p-pdf-db     and
     8345                           pp_price-list.artic      = pdf_price-list.artic and
     8346                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     8347                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     8348                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     8349                        first buf1-bar-code no-lock where
     8350                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8351                             buf1-bar-code.unit-cli = buf_goods.unit-base
     8352                       :
     8353                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     8354                       check-par = true  .
     8355                       leave.
     8356                   end.
     8357               if check-par = true then next.
     8358               if par-pr-equ-dq = 2 then do:
     8359                     if  ( v-num <= 2  and check-par = false ) then
     8360                         run gbl/d-askw.w
     8361                           (input "Удалить строку?"
     8362                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     8363                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     8364                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     8365                                       + " Бар-код " + string(pdf_price-list.b-code)
     8366                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     8367                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     8368                                       + " Удалить строку? "
     8369                           ,input "|^"
     8370                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     8371                           ,input "Удалить строку|"
     8372                               + "Не удалять строку|"
     8373                               + "Удалять у всех товаров, цена на которые не изменилась|"
     8374                               + "Не удалять у всех товаров, цена на которые не изменилась"
     8375                           ,input 1
     8376                           ,input 2
     8377                           ,output v-num
     8378                           ).
     8379                 end.
     8380                 else do:
     8381                   v-num = 3 .
     8382                 end.
     8383                   if v-num = 1 then do:
     8384                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     8385                                     if error-status :error then do:
     8386                                             message  vss-workfile vss-revision vss-description skip
     8387                                             "Ошибка при удаление строки ДНЦ"
     8388                                             pdf_price-list.b-code skip
     8389                                             error-status :get-message(1) .
     8390                                             return error.
     8391                                     end.
     8392                   end.
     8393                   if v-num = 3  then do:
     8394                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     8395                   end.
     8396           end.
     8397          end.
     8398   end.
     8399     for each main_price-list no-lock where
     8400                 main_price-list.plt-id      = p-plt-id and
     8401                 main_price-list.plt-db-num  = p-plt-db-num and
     8402                 main_price-list.pdf-id      = p-pdf-id and
     8403                 main_price-list.pdf-db      = p-pdf-db
     8404                 :
     8405                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     8406                   for each pp_price-list no-lock where
     8407                             pp_price-list.plt-id       = main_price-list.plt-id     and
     8408                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     8409                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     8410                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     8411                             pp_price-list.artic        = main_price-list.artic      and
     8412                             pp_price-list.prod-type    = main_price-list.prod-type  and
     8413                             pp_price-list.prod-code    = main_price-list.prod-code  and
     8414                             pp_price-list.b-code      <> main_price-list.b-code     and
     8415                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     8416                       first buf_goods no-lock where
     8417                             buf_goods.artic     =  pp_price-list.artic and
     8418                             buf_goods.prod-type =  pp_price-list.prod-type and
     8419                             buf_goods.prod-code =  pp_price-list.prod-code ,
     8420                       first buf1-bar-code no-lock where
     8421                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8422                             buf1-bar-code.unit-cli = buf_goods.unit-base
     8423                             :
     8424                             bbb = true .
     8425                             for each alt_price-list no-lock where
     8426                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     8427                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     8428                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     8429                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     8430                                     alt_price-list.artic      = pp_price-list.artic      and
     8431                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     8432                                     alt_price-list.b-code     <> main_price-list.b-code  and
     8433                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     8434                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     8435                               first buf2_goods no-lock where
     8436                                     buf2_goods.artic     =  pp_price-list.artic     and
     8437                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     8438                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     8439                               first buf2-bar-code no-lock where
     8440                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     8441                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     8442                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     8443                                   :
     8444                                   bbb = false.
     8445                                   leave.
     8446                             end.
     8447                             if bbb = true  then do:
     8448                                 run del-doc-line ( input recid (pp_price-list)) no-error  .
     8449                                 if error-status :error then do:
     8450                                     message  vss-workfile vss-revision vss-description skip
     8451                                     " Нельзя удалить " pp_price-list.b-code skip
     8452                                     error-status :get-message(1) .
     8453                                 end.
     8454                             end.
     8455                   end.
     8456     end.
     8457   end.
     8458   end procedure.
     8459   procedure ver-pr-discnS :
