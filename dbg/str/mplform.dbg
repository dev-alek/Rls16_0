     4847                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4848                   - 1 ) * 10
     4849                 + 9
     4850           .
     4851         end.
     4852         else do:
     4853           assign
     4854             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4855                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4856                   ) * 10
     4857                 + 9
     4858           .
     4859         end.
     4860         assign
