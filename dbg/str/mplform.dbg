     5679       end.
     5680       when 'Произв-НДС':U
     5681       then do:
     5682         find first x_obj-group.
     5683   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5685   (  input  p-b-code
     5686    , input  x_obj-group.obj-type
     5687    , input  x_obj-group.obj-code
     5688    , output vd
     5689    , output v-PriceWithVat
     5690    , output v-prod-vat
     5691    , output v-str1
     5692    , output v-str1
     5693           ) no-error .
     5694         if error-status :error then
     5695         message
     5696           vss-workfile vss-revision vss-description skip
     5697           error-status :get-message(1) skip
     5698           return-value skip
     5699           "proprice.i"
     5700           view-as alert-box error
     5701         .
     5702         if vd = 0 or vd = ?  then do:
     5703           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5704                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5705                   "- расчет по производителю от последней приходной накладной невозможен."
     5706                   view-as alert-box  .
     5707         end.
     5708         else do:
     5709             cost-rubl = vd .
     5710             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5711             p-new-calc-method = p-calc-method .
     5712         end.
     5713       end.
     5714      when 'Спецификация':U
     5715      then do:
     5716         find first x_obj-group.
     5717         assign
     5718           v-num-specif    = 0
     5719           v-contract-code = 0
     5720         .
     5721         for each buf_contract no-lock
     5722         where buf_contract.host-code = v-cntxt-host-code-obj
     5723         :
     5724   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5725   ASSIGN
     5726      i-gl-Host-Code      = 0
     5727      i-gl-Contract-Code  = 0
     5728      i-gl-Extent3        = 0
     5729      .
     5730   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5731       INPUT  v-cntxt-host-code-obj,
     5732       INPUT  buf_contract.contract-code,
     5733       OUTPUT i-gl-Extent3
     5734      ).
     5735   IF i-gl-Extent3[1] = 2 THEN DO:
     5736      ASSIGN
     5737         i-gl-Host-Code      = i-gl-Extent3[2]
     5738         i-gl-Contract-Code  = i-gl-Extent3[3]
     5739         .
     5740   END. ELSE DO:
     5741      ASSIGN
     5742         i-gl-Host-Code      = v-cntxt-host-code-obj
     5743         i-gl-Contract-Code  = buf_contract.contract-code
     5744         .
     5745   END.
     5746   FOR EACH
     5747       buf_contract-specif
     5748        NO-LOCK
     5749        WHERE
     5750            buf_contract-specif.Host-code    = i-gl-Host-Code
     5751        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5752              :
     5753               if buf_contract-specif.gds-code = p-gds-code then do:
     5754                 assign
     5755                   v-num-specif = v-num-specif + 1
     5756                   v-contract-code = buf_contract.contract-code
     5757                 .
     5758               end.
     5759           end.
     5760         end.
     5761         if v-num-specif > 1 then do:
     5762            run str/gds-cnts.w
     5763               (input parparentproc
     5764               ,input p-gds-code
     5765               , "b-sel":U
     5766               ,output v-spis
     5767             ) no-error.
     5768           find first buf_contract-specif no-lock
     5769           where recid(buf_contract-specif) = integer(v-spis)
     5770             no-error.
     5771             if available buf_contract-specif then do:
     5772                 run read-bonus (
     5773                     input  buf_contract-specif.contract-num  ,
     5774                     input  buf_contract-specif.host-code     ,
     5775                     input  buf_contract-specif.gds-code      ,
     5776                     output v-bonus  ) .
     5777                 assign
     5778                   cost-rubl = buf_contract-specif.price-cli
     5779                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5780                   p-new-calc-method = 'Спецификация':U
     5781                 .
     5782                 if v-bonus <> ? and v-bonus <> 0 then do:
     5783                    assign
     5784                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5785                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5786                    .
     5787                 end.
     5788             end.
     5789             else do:
     5790               message "Не найдена спецификация с recid " v-spis skip
     5791                       "для товара с артикулом " p-artic skip
     5792                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5793                       view-as alert-box information .
     5794             end.
     5795         end.
     5796         if v-num-specif = 0 then do:
     5797             message "Не найдена ни одна спецификация" skip
     5798                     "для товара с артикулом " p-artic skip
     5799                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5800                     view-as alert-box information .
     5801         end.
     5802         if v-num-specif = 1 then do:
     5803   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5804   ASSIGN
     5805      i-gl-Host-Code      = 0
     5806      i-gl-Contract-Code  = 0
     5807      i-gl-Extent3        = 0
     5808      .
     5809   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5810       INPUT  v-cntxt-host-code-obj,
     5811       INPUT  v-contract-code,
     5812       OUTPUT i-gl-Extent3
     5813      ).
     5814   IF i-gl-Extent3[1] = 2 THEN DO:
     5815      ASSIGN
     5816         i-gl-Host-Code      = i-gl-Extent3[2]
     5817         i-gl-Contract-Code  = i-gl-Extent3[3]
     5818         .
     5819   END. ELSE DO:
     5820      ASSIGN
     5821         i-gl-Host-Code      = v-cntxt-host-code-obj
     5822         i-gl-Contract-Code  = v-contract-code
     5823         .
     5824   END.
     5825   FOR EACH
     5826       buf_contract-specif
     5827        NO-LOCK
     5828        WHERE
     5829            buf_contract-specif.Host-code    = i-gl-Host-Code
     5830        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5831               :
     5832               if buf_contract-specif.gds-code = p-gds-code then do:
     5833                 run read-bonus (
     5834                     input  buf_contract-specif.contract-num  ,
     5835                     input  buf_contract-specif.host-code     ,
     5836                     input  buf_contract-specif.gds-code      ,
     5837                     output v-bonus  ) .
     5838                 assign
     5839                   cost-rubl = buf_contract-specif.price-cli
     5840                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5841                   p-new-calc-method = 'Спецификация':U
     5842                 .
     5843                 if v-bonus <> ? and v-bonus <> 0 then do:
     5844                    assign
     5845                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5846                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5847                    .
     5848                 end.
     5849               end.
     5850             end.
     5851         end.
     5852      end.
     5853      otherwise do:
     5854        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     5855                  p-new-calc-method  skip
     5856                 "p-price-prev-doc " p-price-prev-doc  skip
     5857                 "mpl-lib ERR !!! " skip
     5858                 'артикул ' p-artic skip
     5859                 view-as alert-box information .
     5860      end.
     5861    end case.
     5862   run main-road-taxs in this-procedure
     5863     ( input p-artic     ,
     5864       input p-prod-type ,
     5865       input p-prod-code ,
     5866       input-output cur-rt-base ,
     5867       input-output cur-rt-rubl )
     5868       .
     5869     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5870       return error "Не определен курс валюты документа" .
     5871     end.
     5872     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5873        return error "Не определен курс базовой валюты " .
     5874     end.
     5875   if v-base = false then var-pr-r-b = "rubl":U .
     5876                     else var-pr-r-b =  "base":U .
     5877       if var-pr-r-b = "rubl":U then do:
     5878            case p-calc-method :
     5879            when 'ПорогПр-НДС':U then do:
     5880               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     5881            end.
     5882            when 'ПорогПр+НДС':U then do:
     5883               p-price-sale-rubl  =  cost-rubl .
     5884            end.
     5885            when  'Производит':U then do:
     5886               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     5887            end.
     5888            when  'Произв-НДС':U then do:
     5889               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     5890            end.
     5891            otherwise do:
     5892               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5893            end.
     5894           end case.
     5895           assign
     5896             p-price-calc-rubl  =  cost-rubl
     5897             p-road-tax-rubl    =  cur-rt-rubl
     5898             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5899             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5900             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5901           .
     5902       end.
     5903       else do:
     5904            case p-calc-method:
     5905               when 'ПорогПр-НДС':U then do:
     5906                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     5907               end.
     5908               when 'ПорогПр+НДС':U then do:
     5909                   p-price-sale-base  =  cost-base .
     5910               end.
     5911               when 'Производит':U then do:
     5912                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     5913               end.
     5914               when 'Произв-НДС':U then do:
     5915                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5916               end.
     5917               otherwise do:
     5918                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5919               end.
     5920            end case.
     5921           assign
     5922             p-price-calc-base  =  cost-base
     5923             p-road-tax-base    =  cur-rt-base
     5924             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5925             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5926             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5927             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5928             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5929             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5930           .
     5931       end.
     5932      if p-price-sale-doc <> 0 then do:
     5933   case p-round-method :
     5934     when '9-окончание':U then do:
     5935       if p-price-sale-doc < 29 then do:
     5936         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5937           assign
     5938             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5939           .
     5940         end.
     5941       end.
     5942       else do:
     5943         if (p-price-sale-doc modulo 10) < 3 then do:
     5944           assign
     5945             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5946                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5947                   - 1 ) * 10
     5948                 + 9
     5949           .
     5950         end.
     5951         else do:
     5952           assign
     5953             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5954                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5955                   ) * 10
     5956                 + 9
     5957           .
     5958         end.
     5959         assign
     5960           p-price-sale-doc = round (p-price-sale-doc, 0)
     5961         .
     5962       end.
     5963     end.
     5964     when '9-99окончание':U then do:
     5965       if p-price-sale-doc < p-round-base then do:
     5966         assign
     5967           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5968         .
     5969       end.
     5970       else do:
     5971         assign
     5972           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5973         .
     5974       end.
     5975     end.
     5976     when 'Без-дробных':U then do:
     5977       assign
     5978         p-price-sale-doc = round (p-price-sale-doc, 0)
     5979       .
     5980     end.
     5981     when 'Произвольно':U then do:
     5982       if p-round-base <> 0 then do:
     5983         assign
     5984           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5985         .
     5986         if p-price-sale-doc = 0 then do:
     5987           assign
     5988             p-price-sale-doc = p-round-base
     5989           .
     5990         end.
     5991       end.
     5992     end.
     5993     when 'Вверх':U then do:
     5994       if p-round-base <> 0 then do:
     5995         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5996           assign
     5997             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5998           .
     5999         end.
     6000       end.
     6001       if p-price-sale-doc = 0 then do:
     6002         assign
     6003           p-price-sale-doc = p-round-base
     6004         .
     6005       end.
     6006     end.
     6007     when 'Коэффициент':U then do:
     6008       if p-round-base <> 0 then do:
     6009         assign
     6010           p-price-sale-doc = p-price-sale-doc * p-round-base
     6011         .
     6012       end.
     6013     end.
     6014     when 'Отключено':U then do:
     6015     end.
     6016     otherwise do:
     6017       message
     6018         vss-workfile vss-revision vss-description skip
     6019         "Неизвестный метод округления продажной цены" skip
     6020         "round-method" p-round-method skip
     6021         "round-base"   p-round-base   skip
     6022         "price"        p-price-sale-doc             skip
     6023         view-as alert-box error .
     6024     end.
     6025   end.
     6026     end.
     6027     assign
     6028       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     6029       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     6030       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     6031       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     6032      .
     6033     assign
     6034       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     6035       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     6036       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     6037       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     6038     .
     6039     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     6040     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     6041     p-prev-doc-code = if available bufold_price-doc-forming
     6042                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     6043                          else "" .
     6044   END PROCEDURE.
     6045   PROCEDURE create-line :
     6046   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     6047   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     6048   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     6049   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     6050   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     6051   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     6052   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     6053   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     6054   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     6055   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     6056   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     6057   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     6058   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     6059   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     6060   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     6061   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     6062   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     6063   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     6064   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     6065   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     6066   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     6067   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     6068   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     6069   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     6070   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     6071   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     6072   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     6073   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     6074   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     6075   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     6076   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     6077   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     6078   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     6079   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     6080   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     6081   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     6082   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     6083   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     6084   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     6085   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     6086   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     6087   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     6088   define input  parameter p-prev-doc-code     as character no-undo .
     6089   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     6090   define input-output parameter  v-sec        as integer   no-undo .
     6091     run check-use-bar-code ( p-b-code ) no-error .
     6092     if error-status :error then do:
     6093       message
     6094         return-value skip
     6095         "Ошибка !"
     6096         view-as alert-box error
     6097       .
     6098       undo, return error return-value.
     6099     end.
     6100   find first ub.price-doc-forming-gds exclusive-lock where
     6101              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     6102              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     6103              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     6104              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     6105              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     6106       if not available ub.price-doc-forming-gds then
     6107       do:
     6108         create ub.price-doc-forming-gds .
     6109          assign
     6110           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     6111           ub.price-doc-forming-gds.plt-id     = p-plt-id
     6112           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     6113           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     6114           ub.price-doc-forming-gds.b-code     = p-b-code
     6115           ub.price-doc-forming-gds.line-num   = p-line-num
     6116          .
     6117       end.
