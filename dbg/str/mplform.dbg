     5459                 input v2               ,
     5460                 input v3               ,
     5461                 input v-doc-code       ,
     5462                 input ""               ,
     5463                 input p-gds-code       ,
     5464                 input p-artic          ,
     5465                 input p-prod-type      ,
     5466                 input p-prod-code      ,
     5467                 input v4               ,
     5468                 input 0                ,
     5469                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     5470                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5471                 output cost-rubl       ,
     5472                 output v4
     5473                 ) no-error .
     5474             end.
     5475             else do:
     5476               run str/pr-wbil.p
     5477               ( input "pr-doc"            ,
     5478                 input 'Накладная':U ,
     5479                 input v1               ,
     5480                 input v2               ,
     5481                 input v3               ,
     5482                 input v-doc-code       ,
     5483                 input ""               ,
     5484                 input p-gds-code       ,
     5485                 input p-artic          ,
     5486                 input p-prod-type      ,
     5487                 input p-prod-code      ,
     5488                 input v4               ,
     5489                 input 0                ,
     5490                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     5491                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5492                 output cost-base       ,
     5493                 output v4
     5494                 ) no-error .
     5495             end.
     5496             if not error-status :error then
     5497                 assign
     5498                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     5499                .
     5500       end.
     5501       when 'Переоценка':U then do:
     5502         find prev-list where
     5503              prev-list.b-code     = p-b-code and
     5504              prev-list.price-type = "" and
     5505              prev-list.doc-num    = v-doc-code no-lock no-error.
     5506         if available prev-list then
     5507           assign
     5508             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     5509             cur-rt-base = prev-list.road-tax
     5510             cur-rt-rubl = prev-list.road-tax
     5511             cost-rubl = prev-list.price-sale
     5512             cost-base = prev-list.price-sale
     5513             .
     5514         else
     5515           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     5516                   "- расчет невозможен."
     5517                   view-as alert-box information .
     5518       end.
     5519       when 'ДокФормЦены':U then do:
     5520       find first b_price-doc-forming no-lock where
     5521                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     5522                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     5523                  no-error .
     5524         find b_price-doc-forming-gds no-lock where
     5525              b_price-doc-forming-gds.b-code     = p-b-code and
     5526              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     5527              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     5528              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     5529              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     5530              no-error.
     5531         if available b_price-doc-forming-gds then
     5532           assign
     5533             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     5534             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     5535             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     5536             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     5537             cost-base   = b_price-doc-forming-gds.price-sale-base
     5538             .
     5539         else
     5540           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     5541                   "для товара :" skip
     5542                    "Бар-код" p-b-code     skip
     5543                    "Артикул" p-artic      skip
     5544                     p-prod-type  skip
     5545                     p-prod-code  skip
     5546                   "- расчет невозможен."
     5547                   view-as alert-box information .
     5548       end.
     5549       when 'Единая':U then do:
     5550           assign
     5551             p-new-calc-method = 'Единая':U + " " + string(common-price)
     5552             cost-rubl = common-price
     5553             cost-base = common-price
     5554             .
     5555       end.
     5556       when 'Объект':U then do:
     5557       find first buf_gds-obj no-lock where
     5558                  buf_gds-obj.gds-code = p-gds-code and
     5559                  buf_gds-obj.obj-type = v-copy-type and
     5560                  buf_gds-obj.obj-code = v-copy-code no-error .
     5561           if available buf_gds-obj then do:
     5562           assign
     5563             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     5564             cost-rubl = buf_gds-obj.price-sale
     5565             cost-base = buf_gds-obj.price-sale
     5566             .
     5567           end.
     5568           else do:
