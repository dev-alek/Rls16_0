     1685   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1687                                           local-doc-num as char).
     1688   define buffer base-price        for ub.price-list.
     1689   define variable local-main-code like ub.bar-code.b-code no-undo.
     1690   define variable local-base-code like ub.bar-code.b-code no-undo.
     1691     run prc-base-code (input local-bc, output local-base-code).
     1692     find base-price no-lock where
     1693          base-price.doc-num = local-doc-num and
     1694          base-price.b-code  = local-base-code and
     1695          base-price.price-type = "" no-error.
     1696     if not available base-price then do:
     1697       run prc-main-code (input local-bc, output local-main-code).
     1698       find  base-price no-lock where
     1699             base-price.doc-num = local-doc-num and
     1700             base-price.b-code  = local-main-code and
     1701             base-price.price-type = "" no-error.
     1702     end.
     1703     if available base-price then
     1704       return (base-price.price-sale).
     1705     else
     1706       return (?).
     1707   END FUNCTION.
     1708   procedure prc-main-code:
     1709   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1710   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1711   define buffer local-bar-code        for ub.bar-code.
     1712   define buffer local-goods           for ub.goods.
     1713   define buffer main-code             for ub.bar-code.
     1714   define buffer main-prt              for ub.gds-prt.
     1715     local-main-code = ?.
     1716     find local-bar-code no-lock where
     1717          local-bar-code.b-code = local-bc no-error.
     1718     if not available local-bar-code then
     1719       return.
     1720     find local-goods no-lock where
     1721          local-goods.gds-code = local-bar-code.gds-code.
     1722     find first  main-prt no-lock where
     1723                 main-prt.upper-code = local-goods.prt-root.
     1724     find  main-code no-lock where
     1725           main-code.gds-code  = local-bar-code.gds-code and
     1726           main-code.in-code   = "" and
     1727           main-code.part-code = "" and
     1728           main-code.unit-cli  = local-goods.unit-base and
     1729           main-code.node-code = main-prt.node-code.
     1730     local-main-code = main-code.b-code.
     1731   end procedure.
     1732   procedure prc-base-code:
     1733   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1734   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1735   define buffer local-bar-code for ub.bar-code.
     1736   define buffer local-goods    for ub.goods.
     1737   define buffer base-code      for ub.bar-code.
     1738     local-base-code = ?.
     1739     find local-bar-code no-lock where
     1740          local-bar-code.b-code = local-bc no-error.
     1741     if not available local-bar-code then
     1742       return.
     1743     find local-goods no-lock where
     1744          local-goods.gds-code = local-bar-code.gds-code.
     1745     find base-code no-lock where
     1746          base-code.gds-code  = local-bar-code.gds-code and
     1747          base-code.node-code = local-bar-code.node-code and
     1748          base-code.in-code   = local-bar-code.in-code and
     1749          base-code.part-code = local-bar-code.part-code and
     1750          base-code.unit-cli  = local-goods.unit-base.
     1751     local-base-code = base-code.b-code.
     1752   end procedure.
     1753   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1754   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1755   procedure prcreate-new-price-doc :
     1756   do
     1757   on error undo, return error return-value
     1758   :
     1759   define input  parameter p-curr-db-num  as integer   no-undo .
     1760   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1761   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1762   define input  parameter p-plt-id       as integer   no-undo .
     1763   define input  parameter p-plt-db-num   as integer   no-undo .
     1764   define input  parameter p-pdf-id       as integer   no-undo .
     1765   define input  parameter p-pdf-db-num   as integer   no-undo .
     1766   define output parameter p-price-doc-recid  as recid                no-undo.
     1767   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1768   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1769   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1770   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1771   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1772   define buffer buf_price-doc         for ub.price-doc.
     1773   find first buf_price-doc-forming no-lock where
     1774              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1775              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1776              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1777              buf_price-doc-forming.plt-id     = p-plt-id
     1778              no-error .
     1779   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1780      run create_new_price-doc-forming
     1781           ( input p-obj-type ,
     1782             input p-obj-code ,
     1783             output p-pdf-db-num ,
     1784             output p-pdf-id ,
     1785             output p-plt-db-num ,
     1786             output p-plt-id
     1787             ).
     1788       find first buf_price-doc-forming no-lock where
     1789                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1790                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1791                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1792                 buf_price-doc-forming.plt-id     = p-plt-id
     1793                 no-error .
     1794   end.
     1795       create buf_price-doc .
     1796       run doc-code in this-procedure
     1797       (input  "main",
     1798        input  p-obj-type  ,
     1799        input  p-obj-code  ,
     1800        input  ?,
     1801        output buf_price-doc.doc-num) no-error.
     1802       if error-status:error then do:
     1803         message vss-workfile vss-revision vss-description skip
     1804                error-status :get-message(1)
     1805               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1806         return error.
     1807       end.
     1808   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1810     (input  p-obj-type
     1811     ,input  p-obj-code
     1812     ,output v-host-code
     1813     )  .
     1814       v-obj-current-date  = today .
     1815       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1816           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1817           v-base-scale  =  buf_price-doc-forming.base-scale .
     1818       end.
     1819       else do:
     1820   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1822     (input  v-host-code
     1823     ,input  v-obj-current-date
     1824     ,output v-base-rate
     1825     ,output v-base-scale
     1826     )  .
     1827       end.
     1828      assign
     1829       buf_price-doc.base-rate      = v-base-rate
     1830       buf_price-doc.base-scale     = v-base-scale
     1831       buf_price-doc.cr-db-num      = p-curr-db-num
     1832       buf_price-doc.doc-date       = v-obj-current-date
     1833       buf_price-doc.fact-num       = 0
     1834       buf_price-doc.host-code      = v-host-code
     1835       buf_price-doc.is-corr        = false
     1836       buf_price-doc.is-del         = false
     1837       buf_price-doc.obj-code       = p-obj-code
     1838       buf_price-doc.obj-type       = p-obj-type
     1839       buf_price-doc.out-code       = ""
     1840       buf_price-doc.pdf-db         = p-pdf-db-num
     1841       buf_price-doc.pdf-id         = p-pdf-id
     1842       buf_price-doc.plt-db-num     = p-plt-db-num
     1843       buf_price-doc.plt-id         = p-plt-id
     1844       buf_price-doc.PS             = "@ "
     1845       buf_price-doc.rest-base      = 0
     1846       buf_price-doc.rest-last      = 0
     1847       buf_price-doc.rest-qnty      = 0
     1848       buf_price-doc.rest-sale      = 0
     1849       buf_price-doc.sale-base      = 0
     1850       buf_price-doc.status_        = 'новый':U
     1851       .
     1852       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1853       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1854       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1855       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1856       assign
     1857           p-price-doc-recid = recid ( buf_price-doc )
     1858       .
     1859   end.
     1860   end procedure.
     1861   procedure prcreate-new-price-list :
     1862   do
     1863   on error undo, return error return-value
     1864   :
     1865   define input parameter p-price-doc-recid   as recid                    no-undo.
     1866   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1867   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1868   define output parameter p-update           as logical                  no-undo.
     1869   define variable kk as integer no-undo .
     1870   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1871   define variable p-hostcode as int no-undo .
     1872   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1873   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1874   define buffer buf_price-doc        for ub.price-doc.
     1875   define buffer buf_price-list       for ub.price-list.
     1876   define buffer buf_bar-code         for ub.bar-code.
     1877   define buffer buf_goods            for ub.goods.
     1878   define buffer buf_root_gds-prt     for ub.gds-prt.
     1879   define buffer buf_gds-prt          for ub.gds-prt.
     1880   find first buf_price-doc no-lock
     1881        where recid( buf_price-doc ) = p-price-doc-recid
     1882   .
     1883   find first buf_goods no-lock
     1884        where buf_goods.gds-code = p-gds-code
     1885   .
     1886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1887     (input  p-gds-code
     1888     ,input  ?
     1889     ,output v-b-code
     1890     ) no-error .
     1891   if error-status :error
     1892   then do:
     1893       message
     1894           "Не найден основной бар-код"
     1895           skip "для товара "
     1896           skip string(buf_goods.artic)
     1897           skip buf_goods.gds-name
     1898       view-as alert-box
     1899       title "Ошибка при выполнении prcreate.i".
     1900       undo, return error .
     1901   end.
     1902   find first buf_bar-code no-lock
     1903        where buf_bar-code.b-code = v-b-code
     1904   no-error.
     1905   if error-status :error
     1906   then do:
     1907       message
     1908           "Не найдена запись bar-code"
     1909           skip "для товара "
     1910           skip string(buf_goods.artic)
     1911           skip buf_goods.gds-name
     1912           skip "С основным бар-кодом"
     1913           skip string(v-b-code)
     1914       view-as alert-box
     1915       title "Ошибка при выполнении prcreate.i".
     1916       undo, return error .
     1917   end.
     1918   find first buf_root_gds-prt no-lock
     1919        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1920   .
     1921   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1922     and buf_bar-code.in-code <> ""
     1923   then do:
     1924       message
     1925           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1926           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1927           view-as alert-box error.
     1928       undo, return error.
     1929   end.
     1930   find first buf_gds-prt no-lock
     1931        where buf_gds-prt.node-code = buf_bar-code.node-code
     1932   .
     1933   find first buf_price-list
     1934        where buf_price-list.doc-num = buf_price-doc.doc-num
     1935          and buf_price-list.b-code  = v-b-code
     1936   no-error.
     1937   if available buf_price-list
     1938   then do:
     1939       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1940          skip "  Цена:   " buf_price-list.price-sale
     1941          skip "Цена будет изменена"
     1942       view-as alert-box warning.
     1943       assign
     1944           p-update = yes
     1945       .
     1946   end.
     1947   else do:
     1948   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1949   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1950     (input  buf_price-doc.obj-type
     1951     ,input  buf_price-doc.obj-code
     1952     ,output p-hostcode
     1953     ) no-error .
     1954   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1956     (input  buf_goods.gds-code
     1957     ,input  '1':U
     1958     ,input  ?
     1959     ,input  p-hostcode
     1960     ,input  buf_price-doc.obj-type
     1961     ,input  buf_price-doc.obj-code
     1962     ,output local_vat-pc
     1963     ) no-error .
     1964   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1966     (input  buf_goods.gds-code
     1967     ,input  '2':U
     1968     ,input  ?
     1969     ,input  p-hostcode
     1970     ,input  buf_price-doc.obj-type
     1971     ,input  buf_price-doc.obj-code
     1972     ,output local_slt-pc
     1973     ) no-error .
     1974       kk = kk + 1.
     1975   define variable v-main-bar-code as integer   no-undo .
     1976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1977     (input  buf_goods.gds-code
     1978     ,input  ?
     1979     ,output v-main-bar-code
     1980     )  .
     1981       create buf_price-list.
     1982       assign
     1983           buf_price-list.line-num    = kk
     1984           buf_price-list.doc-num     = buf_price-doc.doc-num
     1985           buf_price-list.b-code      = buf_bar-code.b-code
     1986           buf_price-list.artic       = buf_goods.artic
     1987           buf_price-list.prod-type   = buf_goods.prod-type
     1988           buf_price-list.prod-code   = buf_goods.prod-code
     1989           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1990           buf_price-list.calc-method = 'Отсутствует':U
     1991           buf_price-list.obj-type    = buf_price-doc.obj-type
