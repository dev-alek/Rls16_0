     2112       ,input main-b-code
     2113       ,input buf_goods.artic
     2114       ,input buf_goods.prod-type
     2115       ,input buf_goods.prod-code
     2116       ,input ""
     2117       ,input 0
     2118       ,input p-price-sale
     2119       ,input ""
     2120       ,input 0
     2121      ,input-output v-sec ) no-error .
     2122      if error-status :error  then do:
     2123        message
     2124          vss-workfile vss-revision vss-description skip
     2125          error-status :get-message(1) skip
     2126          return-value skip
     2127          "2"
     2128          view-as alert-box error
     2129        .
     2130      end.
     2131   define buffer old_price-list for ub.price-list  .
     2132   if par-pr-notls = "yes" then do:
     2133   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2135     (input  p-obj-type
     2136     ,input  p-obj-code
     2137     ,input  main-b-code
     2138     ,input  0
     2139     ,input  0
     2140     ,output v-cur-dn
     2141     ,output v-cur-pr
     2142     ,output v-cur-rt
     2143     ,output v-cur-ex
     2144     )  .
     2145   end.
     2146   if par-pr-altex = "yes" and
     2147      par-pr-notls = "yes" then do:
     2148       if v-cur-dn <> "" then do:
     2149           for each old_price-list no-lock where
     2150                    old_price-list.doc-num = v-cur-dn and
