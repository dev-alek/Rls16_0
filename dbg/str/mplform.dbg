     4825             p-road-tax-base    =  cur-rt-base
     4826             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4827             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4828             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4829             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4830             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4831             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4832           .
     4833       end.
     4834   case p-round-method :
     4835     when '9-окончание':U then do:
     4836       if p-price-sale-doc < 29 then do:
     4837         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4838           assign
     4839             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4840           .
     4841         end.
     4842       end.
     4843       else do:
     4844         if (p-price-sale-doc modulo 10) < 3 then do:
     4845           assign
