     1661       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1662       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1663       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1664       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1665       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1666       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
