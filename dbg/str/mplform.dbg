     1680       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1681       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1682       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
