        1   define temp-table tt-goods no-undo
        2     field gds-code as integer
        3     field artic as character
        4     field gds-name as character
        5     index pi
        6       as primary unique
        7       gds-code
        8   .
        9   define input parameter p-gds-list as character no-undo .
       10   define output parameter p-gds-code as integer no-undo .
       11   procedure proc-alt-shift-f2:
       12     if not ibs.th.gbl.gbl-var:rcode
       13   then
       14     run gbl\inidebug.p .
       15   end.
       16   procedure proc-alt-shift-f3:
       17     run gbl/prvssinf.p
       18       ( input this-procedure
       19       ) .
       20   end.
       21   define variable v-inform-launched as logical no-undo initial false .
       22   procedure proc-alt-shift-f4:
       23     define variable v-action as character no-undo .
       24     if v-inform-launched = false then do:
       25       assign
       26         v-inform-launched = true
       27       .
       28       run gbl/d-inform.w
       29         (  input self
       30         ,  input this-procedure
       31         , output v-action
       32         ) no-error .
       33       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       34       assign
       35         v-inform-launched = false
       36       .
       37     end.
       38   end.
       39   procedure proc-alt-f1:
       40     run gbl/corrhelp.p
       41       (input this-procedure
       42       ) .
       43   end .
       44   on alt-shift-f2 anywhere do:
       45     run proc-alt-shift-f2.
       46   end.
       47   on alt-shift-f3 anywhere do:
       48     run proc-alt-shift-f3 in this-procedure .
       49   end.
       50   on alt-shift-f4 anywhere do:
       51     run proc-alt-shift-f4 in this-procedure.
       52   end.
       53   on alt-f1 anywhere do:
       54     run proc-alt-f1 in this-procedure .
       55   end.
       56   DEFINE BUTTON b-cancel AUTO-END-KEY
       57        LABEL "Отмена"
       58        SIZE 15 BY 1.14
       59        BGCOLOR 8 .
       60   DEFINE BUTTON b-ok AUTO-GO
       61        LABEL "Выбор"
       62        SIZE 15 BY 1.14
       63        BGCOLOR 8 .
       64   define query br-goods for tt-goods .
       65   define browse br-goods query br-goods no-lock
       66     display
       67       tt-goods.gds-code  label "Код" format ">>>>>>>>>9"
       68       tt-goods.artic     label "Артикул" format "X(12)"
       69       tt-goods.gds-name  label "Наименование" format "X(25)"
       70     with size 51 by 10 separators
       71   .
       72   DEFINE FRAME Dialog-Frame
       73        b-ok AT ROW 1.24 COL 2
       74        b-cancel AT ROW 1.24 COL 17
       75        br-goods at row 2.5 col 1
       76        SPACE(0.1) SKIP(0.1)
       77       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       78            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       79            TITLE "Выберите топливо для приёмки"
       80            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
       81   ASSIGN
       82          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       83          FRAME Dialog-Frame:HIDDEN           = TRUE.
       84   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       85   DO:
       86     APPLY "END-ERROR":U TO SELF.
       87   END.
       88   on choose of b-ok in frame Dialog-Frame
       89   do :
       90     if available tt-goods
       91     then do :
       92       p-gds-code = tt-goods.gds-code .
       93     end .
       94     else do :
       95       return no-apply .
       96     end .
       97   end .
       98   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       99   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      100   MAIN-BLOCK:
      101   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      102      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      103     run fill-tt .
      104     RUN enable_UI.
      105     WAIT-FOR GO OF FRAME Dialog-Frame.
      106   END.
      107   RUN disable_UI.
      108   procedure fill-tt :
      109     define variable ii as integer no-undo .
      110     define buffer buf_goods for ub.goods .
      111     do ii = 1 to num-entries(p-gds-list) :
      112       for first buf_goods no-lock where buf_goods.gds-code = integer(entry(ii, p-gds-list)) :
      113         find first tt-goods where tt-goods.gds-code = buf_goods.gds-code no-error .
      114         if not available tt-goods
      115         then do :
      116           create tt-goods .
      117           assign
      118             tt-goods.gds-code = buf_goods.gds-code
      119             tt-goods.artic = buf_goods.artic
      120             tt-goods.gds-name = buf_goods.gds-name
      121           .
      122         end .
      123       end .
      124     end .
      125   end procedure .
      126   PROCEDURE disable_UI :
      127     HIDE FRAME Dialog-Frame.
      128   END PROCEDURE.
      129   PROCEDURE enable_UI :
      130     ENABLE b-ok b-cancel br-goods
      131         WITH FRAME Dialog-Frame.
      132     VIEW FRAME Dialog-Frame.
      133     open query br-goods for each tt-goods .
      134   END PROCEDURE.
