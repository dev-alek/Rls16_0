        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Smart browser общения с записями резервуар-ТРК".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable varmes-log as logical no-undo.
      132   define variable parparentproc as widget-handle no-undo .
      133   define variable varobj-type like ub.clients.obj-type no-undo.
      134   define variable varobj-code like ub.clients.obj-code no-undo.
      135   define variable varbuttons  as   character        no-undo.
      136   define variable varps-upd   as   logical          no-undo.
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   function nzpl-spl returns logical
      139   (input p-obj-type as character
      140                                   , input p-obj-code as integer):
      141   define variable v-dopi    as integer no-undo .
      142   define variable v-param-type as character no-undo .
      143   define variable v-value-character as character no-undo .
      144   define variable v-value-date as date no-undo .
      145   define variable v-value-decimal as decimal no-undo .
      146   define variable v-value-integer as integer no-undo .
      147   define variable v-value-logical as logical no-undo .
      148   define variable v-tth as handle no-undo .
      149   define variable dflt-cd as character no-undo .
      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   define variable v-param-type2 as character no-undo .
      152   define variable v-value-date2 as date no-undo .
      153   define variable v-value-decimal2 as decimal no-undo .
      154   define variable v-value-integer2 as INTEGER no-undo .
      155   define variable v-value-logical2 AS LOGICAL no-undo .
      156   define variable v-tth2 as handle no-undo .
      157   run adm/shattri.p (
      158       input "get":U
      159       ,input  p-obj-type
      160       ,input  p-obj-code
      161       ,input  'cd-sending':U
      162       ,input  'dflt-cd':U
      163       ,output dflt-cd
      164       ,output v-value-date2
      165       ,output v-value-decimal2
      166       ,output v-value-integer2
      167       ,output v-value-logical2
      168       ,output v-param-type2
      169       ,INPUT-OUTPUT table-handle v-tth2
      170       ) no-error .
      171   delete object v-tth2 no-error.
      172   if dflt-cd <> 'IBM':U
      173   and dflt-cd <> 'IBM-XML':U then return no.
      174   if dflt-cd = 'IBM-XML':U then return yes.
      175   run adm/shattri.p (
      176       input "get":U
      177       ,input  p-obj-type
      178       ,input  p-obj-code
      179       ,input  'cd-type-ibm':U
      180       ,input  'ibmspool':U
      181       ,output v-value-character
      182       ,output v-value-date
      183       ,output v-value-decimal
      184       ,output v-value-integer
      185       ,output v-value-logical
      186       ,output v-param-type
      187       ,INPUT-OUTPUT table-handle v-tth
      188       ) no-error .
      189   if error-status:error then do:
      190     delete object v-tth.
      191     return no.
      192   end.
      193   delete object v-tth.
      194   assign
      195   v-dopi = v-value-integer no-error .
      196   if v-dopi >= 6 then return yes.
      197   end. // FUNCTION/method
      198   FUNCTION nzpl-two returns logical
      199                                    (input p-obj-type as character
      200                                     , input p-obj-code as integer):
      201     define variable v-nzpl-two as logical no-undo.
      202     run
      203     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      204     return v-nzpl-two.
      205   end. // FUNCTION/method
      206   procedure nzpl-two-proc :
      207   define input  parameter p-obj-type   as character no-undo.
      208   define input  parameter p-obj-code   as integer   no-undo.
      209   define output parameter varge-two-pl as logical   no-undo.
      210   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      211   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      212   //do on error undo, return error return-value :
      213   assign
      214     varge-two-pl = no.
      215   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      216                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      217                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      218     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      219                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      220                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      221                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      222                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      223                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      224     if available bf-other_pl-gds-pump then do:
      225       assign
      226         varge-two-pl = yes.
      227       leave.
      228     end.
      229   end.
      230   //end.
      231   end. // procedure/method .
      232   procedure cplgdspm :
      233     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      234     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      235     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      236     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      237     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      238     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      239       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      240       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      241       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      242       define buffer bf-place                for ub.place.
      243       if parstatus = 'тек':U then do:
      244         for each bf_pl-gds-pump no-lock
      245           where bf_pl-gds-pump.obj-type  =  parobj-type
      246             and bf_pl-gds-pump.obj-code  =  parobj-code
      247             and bf_pl-gds-pump.gds-code  =  pargds-code
      248             and bf_pl-gds-pump.pump-code =  parpump-code
      249             and bf_pl-gds-pump.pl-code   <> parpl-code
      250             and bf_pl-gds-pump.status_   =  'тек':U
      251         on error undo, return error
      252         :
      253           find first place where
      254                      place.obj-type = parobj-type
      255                  and place.obj-code = parobj-code
      256                  and place.pl-code  = parpl-code
      257                no-lock no-error.
      258           find first bf-place where
      259                      bf-place.obj-type = parobj-type
      260                  and bf-place.obj-code = parobj-code
      261                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      262                no-lock no-error.
      263           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      264             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      265                                        ,parobj-type
      266                                        ,parobj-code
      267                                        ,if available place then place.loc1 else string(parpl-code)
      268                                        ,pargds-code
      269                                        ,parpump-code
      270                                        ,parstatus
      271                                        ,chr(10)
      272                                       )
      273                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      274                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      275                                     ).
      276           end.
      277           else do:
      278             find first bf_pl-pump-nozzle no-lock
      279               where bf_pl-pump-nozzle.obj-type  = parobj-type
      280                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      281                 and bf_pl-pump-nozzle.pump-code = parpump-code
      282                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      283               no-error.
      284             if available bf_pl-pump-nozzle then do:
      285               find first bf-other_pl-pump-nozzle no-lock
      286                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      287                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      288                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      289                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      290                 no-error.
      291               if available bf-other_pl-pump-nozzle
      292                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      293               then do:
      294                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      295                                          ,parobj-type
      296                                          ,parobj-code
      297                                          ,if available place then place.loc1 else string(parpl-code)
      298                                          ,pargds-code
      299                                          ,parpump-code
      300                                          ,parstatus
      301                                          ,chr(10)
      302                                        )
      303                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      304                                           ,bf_pl-gds-pump.obj-type
      305                                           ,bf_pl-gds-pump.obj-code
      306                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      307                                           ,bf_pl-gds-pump.status_
      308                                         ).
      309               end.
      310             end.
      311           end.
      312         end.
      313       end.
      314   end . // procedure/method
      315   procedure plpumpdv:
      316   define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      317   define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      318   define input parameter parpl-code     like ub.place.pl-code      no-undo.
      319   define input parameter parpump-code   like ub.pump.pump-code     no-undo.
      320   define buffer bf_clients           for ub.clients.
      321   define buffer bf_pl-pump           for ub.pl-pump.
      322   define buffer bf_pl-pump-nozzle    for ub.pl-pump-nozzle.
      323   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      324   define variable varrec-id as recid no-undo.
      325   define variable varmes-log as logical no-undo.
      326   define variable varobj-type like ub.clients.obj-type no-undo.
      327   define variable varobj-code like ub.clients.obj-code no-undo.
      328   define variable varbuttons  as   character        no-undo.
      329   define variable varps-upd   as   logical          no-undo.
      330   find first bf_clients where bf_clients.obj-type = parobj-type and
      331                               bf_clients.obj-code = parobj-code no-lock no-error.
      332   if not available bf_clients then
      333      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      334   tr:
      335   do transaction on error undo tr, return error return-value :
      336     find first bf_pl-pump where bf_pl-pump.obj-type  = parobj-type    and
      337                                 bf_pl-pump.obj-code  = parobj-code    and
      338                                 bf_pl-pump.pl-code   = parpl-code     and
      339                                 bf_pl-pump.pump-code = parpump-code
      340                                 no-lock no-error.
      341     if not available bf_pl-pump then do:
      342        return error substitute("Не найден запись резервуар-ТРК с номером резервуара &1 и номером ТРК &2", parpl-code, parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      343     end.
      344     assign varrec-id = RECID(bf_pl-pump).
      345   run chkcsptr (input parobj-type,
      346                 input parobj-code) no-error.
      347   if error-status:error then return error trim(return-value) +
      348                                           trim(error-status:get-message(1)) +
      349                                           trim(error-status:get-message(2)) +
      350                                           trim(error-status:get-message(3)) +
      351                                           trim(error-status:get-message(4)) +
      352                                           trim(error-status:get-message(5)).
      353     for each bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = parobj-type  and
      354                                      bf_pl-pump-nozzle.obj-code    = parobj-code  and
      355                                      bf_pl-pump-nozzle.pl-code     = parpl-code   and
      356                                      bf_pl-pump-nozzle.pump-code   = parpump-code exclusive-lock
      357                                      on error undo tr, return error return-value :
      358         delete bf_pl-pump-nozzle.
      359     end.
      360     for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type  = parobj-type  and
      361                                   bf_pl-gds-pump.obj-code  = parobj-code  and
      362                                   bf_pl-gds-pump.pl-code   = parpl-code   and
      363                                   bf_pl-gds-pump.pump-code = parpump-code exclusive-lock
      364                                   on error undo tr, return error return-value :
      365       delete bf_pl-gds-pump.
      366     end.
      367     find first bf_pl-pump where RECID(bf_pl-pump) = varrec-id exclusive-lock.
      368     delete bf_pl-pump.
      369   end.
      370   end procedure.
      371   procedure chkcsptr:
      372   define input parameter parobj-type   like ub.clients.obj-type     no-undo.
      373   define input parameter parobj-code   like ub.clients.obj-code     no-undo.
      374   define variable        varretobjat   as   character            no-undo.
      375   define variable        varshift-date like ub.shift-obj.shift-date no-undo.
      376   define variable        varshift-num  like ub.shift-obj.shift-num  no-undo.
      377   define buffer bf_clients   for ub.clients.
      378   define buffer bf_shift-obj for ub.shift-obj.
      379   define buffer bf_rvs-doc   for ub.rvs-doc.
      380   find first bf_clients where bf_clients.obj-type = parobj-type and
      381                               bf_clients.obj-code = parobj-code no-lock no-error.
      382   if not available bf_clients then return error "Нет такого объекта " + parobj-type +
      383                                                 " "                   + string(parobj-code) + ".".
      384   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      386     (input  parobj-type
      387     ,input  parobj-code
      388     ,input  'shift-on=request'
      389     ,output varretobjat
      390     ) no-error .
      391   if error-status:error then  return error "Ошибка при вызове файла library.p: objat".
      392   if varretobjat <> "yes" then do:
      393      return error "Фатальная ошибка. На объекте " + parobj-type + " " + string(parobj-code) + " не включены смены.".
      394   end.
      395   find first bf_shift-obj
      396        where bf_shift-obj.obj-type = parobj-type
      397          and bf_shift-obj.obj-code = parobj-code
      398          and bf_shift-obj.status_  = 'тек':U
      399         use-index pi no-error .
      400   if available bf_shift-obj then do:
      401      find first bf_rvs-doc where bf_rvs-doc.obj-type   = parobj-type             and
      402                                  bf_rvs-doc.obj-code   = parobj-code             and
      403                                  bf_rvs-doc.shift-date = bf_shift-obj.shift-date and
      404                                  bf_rvs-doc.shift-num  = bf_shift-obj.shift-num  and
      405                                  bf_rvs-doc.status_    = 'факт':U                 and
      406                                  bf_rvs-doc.rvs-type   = 'смена':U            no-lock no-error.
      407      if not available bf_rvs-doc then
      408      return error "Смена открыта и не сделан документ сверки типа 'смена' за текущую смену.".
      409   end.
      410   end procedure.
      411         define variable v-chk-act-host-code as integer   no-undo .
      412         define variable glog                as logical   no-undo .
      413         define variable v-userid            as character no-undo .
      414         define variable v-db-num            as integer   no-undo .
      415         define variable v-host-code         as integer   no-undo .
      416         define variable v-obj-type          as character no-undo .
      417         define variable v-obj-code          as integer   no-undo .
      418   RUN set-attribute-list (
      419       'Keys-Accepted = ,
      420        Keys-Supplied = ':U).
      421   RUN set-attribute-list (
      422       'SortBy-Options = ""':U).
      423   DEFINE BUTTON b-add
      424        LABEL "&Добавить"
      425        SIZE 10 BY 1.
      426   DEFINE BUTTON b-del
      427        LABEL "&Удалить"
      428        SIZE 10 BY 1.
      429   DEFINE BUTTON b-help
      430        LABEL "&Помощь"
      431        SIZE 10 BY 1.
      432   DEFINE BUTTON b-hist
      433        LABEL "&История"
      434        SIZE 10 BY 1.
      435   DEFINE VARIABLE varps AS CHARACTER FORMAT "X(256)":U
      436        VIEW-AS FILL-IN
      437        SIZE 46.25 BY 1.88 NO-UNDO.
      438   DEFINE QUERY br_table FOR
      439         ub.pl-pump SCROLLING.
      440   DEFINE BROWSE br_table
      441     QUERY br_table NO-LOCK DISPLAY
      442         ub.pl-pump.pl-code COLUMN-LABEL "Бар-код резервуара" FORMAT "99999999999":U
      443         ub.pl-pump.pump-code
      444       WITH NO-ASSIGN SEPARATORS SIZE 30.5 BY 7.29.
      445   DEFINE FRAME F-Main
      446        br_table AT ROW 1 COL 1
      447        varps AT ROW 8.42 COL 1 NO-LABEL
      448        b-add AT ROW 10.54 COL 1.38
      449        b-del AT ROW 10.54 COL 11.75
      450        b-hist AT ROW 10.54 COL 22.13
      451        b-help AT ROW 10.54 COL 32.5
      452       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      453            SIDE-LABELS NO-UNDERLINE THREE-D
      454            AT COL 1 ROW 1 SCROLLABLE
      455            BGCOLOR 8 FGCOLOR 0 .
      456   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      457   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      458   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      459   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      460   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      461   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      462   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      463   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      464   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      465   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      466   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      467         adm-object-hdl = FRAME F-Main:HANDLE.
      468   RUN ensure-broker.
      469   THIS-PROCEDURE:ADM-DATA =
      470        'ADM1.1~`':U +
      471        'SmartObject~`':U +
      472        '~`':U +
      473        'YES~`':U +
      474        '~`':U +
      475        'ub.pl-pump~`':U +
      476        '~`':U +
      477        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      478           + "~`":U +
      479        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      480        'Record-Source,Record-Target,TableIO-Target~`':U +
      481        '~`':U +
      482        '~`~`~`~`~`~`~`~`~`~`~`':U +
      483        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      484            THEN "^^":U
      485        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      486             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      487   PROCEDURE adm-apply-entry :
      488     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      489   END PROCEDURE.
      490   PROCEDURE adm-destroy :
      491    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      492   END PROCEDURE.
      493   PROCEDURE adm-disable :
      494       DISABLE br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      495       RUN dispatch ('disable-fields':U).
      496       RUN set-attribute-list ('ENABLED=no':U).
      497       RETURN.
      498   END PROCEDURE.
      499   PROCEDURE adm-edit-attribute-list :
      500         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      501         RETURN.
      502   END PROCEDURE.
      503   PROCEDURE adm-enable :
      504       ENABLE UNLESS-HIDDEN br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      505       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      506       RUN set-attribute-list ('ENABLED=yes':U).
      507       RETURN.
      508   END PROCEDURE.
      509   PROCEDURE adm-exit :
      510        RUN notify ('exit':U).
      511     RETURN.
      512   END PROCEDURE.
      513   PROCEDURE adm-hide :
      514     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      515   END PROCEDURE.
      516   PROCEDURE adm-initialize :
      517     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      518   END PROCEDURE.
      519   PROCEDURE adm-show-errors :
      520       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      521       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      522           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      523       END.
      524       RETURN.
      525   END PROCEDURE.
      526   PROCEDURE adm-UIB-mode :
      527     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      528   END PROCEDURE.
      529   PROCEDURE adm-view :
      530     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      531   END PROCEDURE.
      532   PROCEDURE dispatch :
      533       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      534       RUN broker-dispatch IN adm-broker-hdl
      535           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      536       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      537   END PROCEDURE.
      538   PROCEDURE ensure-broker :
      539   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      540   IF RETURN-VALUE NE "ADM-Broker":U THEN
      541   DO:
      542       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      543       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      544   END.
      545   END PROCEDURE.
      546   PROCEDURE get-attribute :
      547     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      548     RUN broker-get-attribute IN adm-broker-hdl
      549         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      550     RETURN RETURN-VALUE.
      551   END PROCEDURE.
      552   PROCEDURE get-attribute-list :
      553     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      554     RUN broker-get-attribute-list IN adm-broker-hdl
      555         (INPUT THIS-PROCEDURE,
      556          INPUT ?,
      557          OUTPUT p-attr-list) NO-ERROR.
      558     RETURN.
      559   END PROCEDURE.
      560   PROCEDURE new-state :
      561     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      562     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      563     RETURN.
      564   END PROCEDURE.
      565   PROCEDURE notify :
      566     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      567     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      568     IF RETURN-VALUE = "ADM-ERROR":U THEN
      569         RETURN "ADM-ERROR":U.
      570     RETURN.
      571   END PROCEDURE.
      572   PROCEDURE set-attribute-list :
      573     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      574     RUN ensure-broker.
      575     RUN broker-set-attribute-list IN adm-broker-hdl
      576         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      577     RETURN.
      578   END PROCEDURE.
      579   PROCEDURE set-position :
      580       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      581       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      582       IF VALID-HANDLE(adm-object-hdl) THEN
      583       DO:
      584         ASSIGN adm-object-hdl:ROW    =   p-row
      585                adm-object-hdl:COLUMN =   p-col.
      586       END.
      587       RETURN.
      588   END PROCEDURE.
      589     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      590     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      591     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      592     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      593     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      594     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      595     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      596     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      597     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      598     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      599     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      600     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      601     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      602     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      603     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      604     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      605     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      606     IF "":U = "":U THEN
      607       RUN modify-list-attribute IN adm-broker-hdl
      608         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      609     RUN use-create-on-add(?).
      610   PROCEDURE adm-add-record :
      611       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      612          "must have at least one Enabled Table to perform Add.":U
      613          VIEW-AS ALERT-BOX ERROR.
      614       RETURN.
      615   END PROCEDURE.
      616   PROCEDURE adm-assign-record :
      617    MESSAGE
      618          "Object ":U THIS-PROCEDURE:FILE-NAME
      619            "must have at least one Enabled Table to perform Assign.":U
      620              VIEW-AS ALERT-BOX ERROR.
      621      RETURN.
      622     END PROCEDURE.
      623   PROCEDURE adm-assign-statement :
      624     RETURN.
      625   END PROCEDURE.
      626   PROCEDURE adm-cancel-record :
      627      RETURN.
      628     END PROCEDURE.
      629   PROCEDURE adm-copy-record :
      630       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      631        "must have at least one Enabled Table to perform Copy.":U
      632          VIEW-AS ALERT-BOX ERROR.
      633       RETURN.
      634   END PROCEDURE.
      635   PROCEDURE adm-create-record :
      636      RETURN.
      637   END PROCEDURE.
      638   PROCEDURE adm-current-changed :
      639     RETURN.
      640   END PROCEDURE.
      641   PROCEDURE adm-delete-record :
      642    MESSAGE
      643          "Object ":U THIS-PROCEDURE:FILE-NAME
      644            "must have at least one Enabled Table to perform Delete.":U
      645              VIEW-AS ALERT-BOX ERROR.
      646       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      647       RETURN.
      648   END PROCEDURE.
      649   PROCEDURE adm-disable-fields :
      650         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      651       RETURN.
      652   END PROCEDURE.
      653   PROCEDURE adm-enable-fields :
      654       RETURN.
      655   END PROCEDURE.
      656   PROCEDURE adm-end-update :
      657     RETURN.
      658   END PROCEDURE.
      659   PROCEDURE adm-reset-record :
      660       RETURN.
      661   END PROCEDURE.
      662   PROCEDURE adm-update-record :
      663       MESSAGE
      664         "Object ":U THIS-PROCEDURE:FILE-NAME
      665           "must have at least one Enabled Table to perform Update.":U
      666             VIEW-AS ALERT-BOX ERROR.
      667      RETURN.
      668   END PROCEDURE.
      669   PROCEDURE check-modified :
      670   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      672   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      673   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      674     IF check-state = "check":U THEN
      675     DO:
      676       RUN get-link-handle IN adm-broker-hdl
      677         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      678            OUTPUT group-target-list).
      679       IF group-target-list NE "":U THEN
      680       DO i = 1 TO NUM-ENTRIES(group-target-list):
      681         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      682         RUN check-modified IN curr-widget ('group-check':U).
      683         IF RETURN-VALUE NE "":U THEN
      684         DO:
      685           RUN check-modified-message(RETURN-VALUE).
      686           RETURN "":U.
      687         END.
      688       END.
      689     END.
      690     RETURN "":U.
      691   END PROCEDURE.
      692   PROCEDURE check-modified-message :
      693     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      694        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      695           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      696        IF RETURN-VALUE = "YES":U THEN
      697           RUN notify ('view,CONTAINER-SOURCE':U).
      698        MESSAGE IF p-changed-table NE ? THEN
      699           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      700           ELSE "Current values have been changed."
      701           SKIP "  Do you wish to save those changes?"
      702           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      703        IF ANS THEN
      704        DO:
      705           IF group-assign-target THEN
      706             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      707           ELSE RUN dispatch('update-record':U).
      708           IF RETURN-VALUE = "ADM-ERROR":U THEN
      709           DO:
      710               MESSAGE "Changes to the previous record were not saved."
      711                 VIEW-AS ALERT-BOX ERROR.
      712               IF group-assign-target THEN
      713                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      714               ELSE RUN dispatch ('cancel-record':U).
      715           END.
      716        END.
      717        ELSE DO:
      718          IF group-assign-target THEN
      719             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      720          ELSE RUN dispatch('cancel-record':U).
      721        END.
      722        RETURN.
      723   END PROCEDURE.
      724   PROCEDURE get-rowid :
      725       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      726       ASSIGN
      727       p-table   =   adm-first-table.
      728       RETURN.
      729   END PROCEDURE.
      730   PROCEDURE init-group-assign :
      731       RUN request-attribute IN adm-broker-hdl
      732         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      733       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      734         group-assign-target = yes.
      735       ELSE group-assign-target = no.
      736       RETURN.
      737   END PROCEDURE.
      738   PROCEDURE set-editors :
      739       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      740       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      741       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      742       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      743       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      744       DO WHILE VALID-HANDLE (curr-widget):
      745           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      746              curr-widget:HIDDEN = no THEN DO:
      747             CASE p-field-setting:
      748               WHEN "INITIALIZE":U THEN
      749               DO:
      750                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      751                     read-only-list +
      752                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      753                        STRING(curr-widget).
      754               END.
      755               WHEN "DISABLE":U OR
      756               WHEN "ENABLE":U THEN
      757               DO:
      758                   curr-widget:SENSITIVE = yes.
      759                   RUN get-attribute ('Read-Only-Editors':U).
      760                   IF RETURN-VALUE = ? OR
      761                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      762                       curr-widget:READ-ONLY =
      763                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      764               END.
      765               WHEN "CLEAR":U THEN
      766                   curr-widget:SCREEN-VALUE = "":U.
      767             END CASE.
      768           END.
      769           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      770       END.
      771       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      772         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      773           + '"':U).
      774       RETURN.
      775   END PROCEDURE.
      776   PROCEDURE use-check-modified-all :
      777    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      778     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      779     RETURN.
      780   END PROCEDURE.
      781   PROCEDURE use-create-on-add :
      782   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      783      RETURN.
      784   END PROCEDURE.
      785   PROCEDURE use-initial-lock :
      786     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      787     ASSIGN adm-initial-lock = p-attr-value.
      788     RETURN.
      789   END PROCEDURE.
      790   PROCEDURE adm-display-fields :
      791         IF AVAILABLE ub.pl-pump THEN
      792             DISPLAY ub.pl-pump.pl-code ub.pl-pump.pump-code WITH BROWSE br_table
      793               NO-ERROR.
      794         DISPLAY UNLESS-HIDDEN varps
      795             WITH FRAME F-Main NO-ERROR.
      796       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      797       RETURN.
      798   END PROCEDURE.
      799   PROCEDURE adm-open-query :
      800               RUN dispatch ('open-query-cases':U).
      801           adm-query-opened = yes.
      802           IF NUM-RESULTS("br_table":U) = 0 THEN
      803               RUN new-state ('no-record-available,SELF':U).
      804           ELSE DO:
      805               RUN new-state ('record-available,SELF':U).
      806               RUN new-state ('first-record,SELF':U).
      807           END.
      808           IF NOT adm-updating-record THEN
      809               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      810     RETURN.
      811   END PROCEDURE.
      812   PROCEDURE adm-row-changed :
      813         IF VALID-HANDLE(adm-object-hdl) THEN
      814           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      815         RUN notify ('row-available':U).
      816         RETURN.
      817   END PROCEDURE.
      818   PROCEDURE reposition-query :
      819       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      820       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      821       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      822       IF table-name <> ? THEN
      823           REPOSITION br_table TO ROWID table-name NO-ERROR.
      824       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      825       RETURN.
      826   END PROCEDURE.
      827     adm-sts = br_table:SET-REPOSITIONED-ROW
      828       (br_table:DOWN,"CONDITIONAL":U).
      829     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      830   PROCEDURE set-size :
      831     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      832     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      833     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      834     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      835     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      836     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      837     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      838     ASSIGN pd_height = MAX(pd_height, 2.0)
      839            pd_width  = MAX(pd_width, 2.0)
      840            hBrowse     = br_table:HANDLE IN FRAME F-Main
      841            hFieldGroup = hBrowse:PARENT
      842            htmpWidget  = hFieldGroup:FIRST-CHILD
      843            hFrame      = hFieldGroup:PARENT.
      844     Search-For-Siblings:
      845     REPEAT WHILE VALID-HANDLE(htmpWidget):
      846       IF htmpWidget NE hBrowse THEN DO:
      847         IF htmpWidget:TYPE NE "BUTTON" OR
      848            htmpWidget:X    NE 4 OR
      849            htmpWidget:Y    NE 4 THEN DO:
      850           RETURN.
      851         END.
      852       END.
      853       htmpWidget = htmpWidget:NEXT-SIBLING.
      854     END.
      855     IF pd_width < hBrowse:WIDTH THEN
      856       ASSIGN hBrowse:WIDTH = pd_width
      857              hFrame:WIDTH  = pd_width     NO-ERROR.
      858     ELSE
      859       ASSIGN hFrame:WIDTH  = pd_width
      860              hBrowse:WIDTH = pd_width     NO-ERROR.
      861     IF pd_height < hBrowse:HEIGHT THEN
      862       ASSIGN hBrowse:HEIGHT = pd_height
      863              hFrame:HEIGHT  = pd_height     NO-ERROR.
      864     ELSE
      865       ASSIGN hFrame:HEIGHT  = pd_height
      866              hBrowse:HEIGHT = pd_height     NO-ERROR.
      867   END PROCEDURE.
      868   ASSIGN
      869          FRAME F-Main:SCROLLABLE       = FALSE
      870          FRAME F-Main:HIDDEN           = TRUE.
      871   ON CHOOSE OF b-add IN FRAME F-Main
      872   DO:
      873   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   do:
      875     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      876       (input  v-db-num
      877       ,input  v-userid
      878       ,input  0
      879       ,input  'actn_pump-reference_work':U
      880       ,input  'object':U
      881       ,input  v-host-code
      882       ,input  v-obj-type
      883       ,input  v-obj-code
      884       ,input  0
      885       ,input  0
      886       ,input  0
      887       ,input  true
      888       ,output glog
      889       )  .
      890   end.
      891     if NOT glog then return no-apply.
      892   define variable varrec-id as recid no-undo.
      893     CASE "plpump"
      894     :
      895      WHEN "nozzle" THEN DO:
      896        run str/d-nozzle.w (input  varobj-type,
      897                        input  varobj-code,
      898                        output varrec-id) no-error.
      899      END.
      900      WHEN "plpmnz" THEN DO:
      901        run str/d-plpmnz.w
      902         ( input parparentproc
      903          ,input varobj-type
      904          ,input varobj-code
      905          ,output varrec-id
      906         ) no-error.
      907      END.
      908      WHEN "plpump" THEN DO:
      909        run str/d-plpump.w
      910         ( input parparentproc
      911          ,input varobj-type
      912          ,input varobj-code
      913          ,output varrec-id
      914         ) no-error.
      915      END.
      916      WHEN "pump" THEN DO:
      917        run str/d-pump.w
      918         ( input parparentproc
      919          ,input varobj-type
      920          ,input  varobj-code
      921          ,output varrec-id
      922         ) no-error.
      923      END.
      924      WHEN "pumpnz" THEN DO:
      925        run str/d-pumpnz.w
      926         ( input parparentproc
      927          ,input varobj-type
      928          ,input varobj-code
      929          ,output varrec-id
      930         ) no-error.
      931      END.
      932      OTHERWISE DO:
      933   message
      934     vss-workfile vss-revision vss-description skip
      935     "Неверное имя файла d-plpump.w." skip
      936     "-----------Cистемная ошибка------------" skip
      937     return-value skip
      938     "------Ошибка исполнения программы------" skip
      939     trim(error-status :get-message(1)) +
      940     trim(error-status :get-message(2)) +
      941     trim(error-status :get-message(3)) +
      942     trim(error-status :get-message(4)) +
      943     trim(error-status :get-message(5)) skip
      944     view-as alert-box error .
      945        return no-apply.
      946      END.
      947     END CASE.
      948     if error-status:error then do:
      949   message
      950     vss-workfile vss-revision vss-description skip
      951     "Ошибка при вызове файла d-plpump.w." skip
      952     "-----------Cистемная ошибка------------" skip
      953     return-value skip
      954     "------Ошибка исполнения программы------" skip
      955     trim(error-status :get-message(1)) +
      956     trim(error-status :get-message(2)) +
      957     trim(error-status :get-message(3)) +
      958     trim(error-status :get-message(4)) +
      959     trim(error-status :get-message(5)) skip
      960     view-as alert-box error .
      961        return no-apply.
      962     end.
      963     if varrec-id <> ? then do:
      964        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      965        REPOSITION br_table to recid varrec-id.
      966     end.
      967   END.
      968   ON CHOOSE OF b-del IN FRAME F-Main
      969   DO:
      970   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   do:
      972     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      973       (input  v-db-num
      974       ,input  v-userid
      975       ,input  0
      976       ,input  'actn_pump-reference_work':U
      977       ,input  'object':U
      978       ,input  v-host-code
      979       ,input  v-obj-type
      980       ,input  v-obj-code
      981       ,input  0
      982       ,input  0
      983       ,input  0
      984       ,input  true
      985       ,output glog
      986       )  .
      987   end.
      988     if NOT glog then return no-apply.
      989   if available ub.pl-pump then do:
      990      assign varmes-log = no.
      991      message "Вы хотите удалить запись <<резервуар-ТРК>> с номером резервуара" ub.pl-pump.pl-code
      992              " и номером ТРК " ub.pl-pump.pump-code " ?" skip
      993              "Вы уверены?"
      994              view-as alert-box question buttons yes-no update varmes-log.
      995     if varmes-log = yes then do:
      996        run plpumpdv in this-procedure (input ub.pl-pump.obj-type,
      997                                        input ub.pl-pump.obj-code,
      998                                        input ub.pl-pump.pl-code,
      999                                        input ub.pl-pump.pump-code) no-error.
     1000        if error-status:error then do:
     1001   message
     1002     vss-workfile vss-revision vss-description skip
     1003     "Ошибка при удалении записи резервуар-ТРК." skip
     1004     "-----------Cистемная ошибка------------" skip
     1005     return-value skip
     1006     "------Ошибка исполнения программы------" skip
     1007     trim(error-status :get-message(1)) +
     1008     trim(error-status :get-message(2)) +
     1009     trim(error-status :get-message(3)) +
     1010     trim(error-status :get-message(4)) +
     1011     trim(error-status :get-message(5)) skip
     1012     view-as alert-box error .
     1013           return no-apply.
     1014        end.
     1015        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1016     end.
     1017   end.
     1018   END.
     1019   ON CHOOSE OF b-hist IN FRAME F-Main
     1020   DO:
     1021     define variable v-rec-list as character no-undo.
     1022     if available ub.pl-pump then do:
     1023         run ref/cplchist.w (
     1024                          INPUT parParentProc
     1025                        , input ub.pl-pump.obj-type
     1026                        , input  ub.pl-pump.obj-code
     1027                        , input "":U
     1028                        , "subject":U
     1029                        , input ub.pl-pump.obj-type
     1030                        , input ub.pl-pump.obj-code
     1031                        , input ub.pl-pump.pl-code
     1032                        , input 0
     1033                        , input ub.pl-pump.pump-code
     1034                        , input 0
     1035                        , input 'pl-pump':U
     1036                        , input-output v-rec-list
     1037                        ) no-error .
     1038     end.
     1039     apply "entry" to browse br_table.
     1040   END.
     1041   ON ROW-ENTRY OF br_table IN FRAME F-Main
     1042   DO:
     1043   END.
     1044   ON ROW-LEAVE OF br_table IN FRAME F-Main
     1045   DO:
     1046   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
     1047   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
     1048   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
     1049     widget-enter = last-event:widget-enter.
     1050     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
     1051     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
     1052       THEN widget-frame = widget-enter:FRAME.
     1053     IF ((NOT VALID-HANDLE(widget-enter)) OR
     1054         (widget-parent:TYPE = "BROWSE":U) OR
     1055         (NOT VALID-HANDLE(widget-frame)) OR
     1056         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
     1057     THEN DO:
     1058         IF adm-brs-in-update THEN
     1059         DO:
     1060           MESSAGE
     1061           "You must complete or cancel the update before leaving the current row."
     1062               VIEW-AS ALERT-BOX WARNING.
     1063           RETURN NO-APPLY.
     1064         END.
     1065         IF br_table:CURRENT-ROW-MODIFIED  OR
     1066           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
     1067         DO:
     1068           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
     1069           THEN DO:
     1070             MESSAGE
     1071             "Current record has been changed. " SKIP
     1072             "Do you wish to save those changes?"
     1073               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
     1074             IF l-save THEN
     1075             DO:
     1076                RUN dispatch('update-record':U).
     1077                IF RETURN-VALUE = "ADM-ERROR":U THEN
     1078                    RETURN NO-APPLY.
     1079             END.
     1080             ELSE RUN dispatch ('cancel-record':U).
     1081           END.
     1082           ELSE DO:
     1083             RUN dispatch('update-record':U).
     1084             IF RETURN-VALUE = "ADM-ERROR":U THEN
     1085                 RETURN NO-APPLY.
     1086           END.
     1087         END.
     1088     END.
     1089   END.
     1090   ON VALUE-CHANGED OF br_table IN FRAME F-Main
     1091   DO:
     1092   RUN get-attribute('ADM-NEW-RECORD':U).
     1093   IF RETURN-VALUE NE "YES":U THEN
     1094     RUN notify ('row-available':U).
     1095     if available ub.pl-pump then do:
     1096        assign varPS = ub.pl-pump.pS.
     1097        display varPS with frame F-Main.
     1098     end.
     1099   END.
     1100   ON LEAVE OF varps IN FRAME F-Main
     1101   DO:
     1102     define buffer bf_pl-pump for ub.pl-pump.
     1103     if available ub.pl-pump then do:
     1104       if ub.pl-pump.ps <> input frame F-Main varps then do:
     1105         if varps-upd = no then do:
     1106             message
     1107               "Вы не можете изменять примечание!"
     1108               view-as alert-box.
     1109             display
     1110               ub.pl-pump.ps @ varps
     1111               with frame F-Main
     1112             .
     1113         end.
     1114         else do:
     1115           assign
     1116             varmes-log = yes
     1117           .
     1118           message
     1119             "Вы хотите изменить примечание к " "резервуар-ТРК"
     1120             view-as alert-box question buttons yes-no update varmes-log.
     1121           if varmes-log = true then do:
     1122             do transaction
     1123             on error  undo, retry
     1124             on stop   undo, retry
     1125             on endkey undo, retry
     1126             :
     1127               if retry then do:
     1128                 message
     1129                   vss-workfile vss-revision vss-description skip(1)
     1130                   "Ошибка при сохранении PS!!!" skip
     1131                   error-status :get-message(1) skip
     1132                   return-value skip
     1133                   view-as alert-box error .
     1134                 return no-apply.
     1135               end.
     1136               find first bf_pl-pump exclusive-lock
     1137                 where recid(bf_pl-pump) = recid(ub.pl-pump)
     1138               .
     1139               assign
     1140                 frame F-Main varps
     1141               .
     1142               assign
     1143                 bf_pl-pump.ps = varps
     1144               .
     1145             end.
     1146           end.
     1147           else do:
     1148             assign
     1149               varps = ub.pl-pump.ps
     1150             .
     1151             display
     1152               varps
     1153               with frame F-Main
     1154             .
     1155           end.
     1156         end.
     1157       end.
     1158     end.
     1159   END.
     1160   if not this-procedure :persistent
     1161   then do:
     1162     message
     1163       vss-workfile vss-revision vss-description skip
     1164       "Ошибка при запуске процедуры" skip
     1165       "Данную процедуру следует запускать только с параметром persistent" skip
     1166       view-as alert-box error .
     1167     undo, return error .
     1168   end.
     1169   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   on help of frame F-Main
     1171   do:
     1172     run gbl/app_help.p
     1173       (input this-procedure :file-name
     1174       ,input ''
     1175       ,input ?
     1176       ) no-error.
     1177     if error-status :error then do:
     1178       message
     1179         "Ошибка при вызове помощи"
     1180         error-status :get-message(1)
     1181         view-as alert-box .
     1182     end.
     1183   end.
     1184   run minbtn-set in this-procedure .
     1185   on choose of b-help in frame F-Main
     1186   do:
     1187     apply "help":u to frame F-Main .
     1188   end.
     1189   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   procedure minbtn-set :
     1191       do
     1192           on error undo, return error return-value
     1193           :
     1194           define variable ii              as integer       no-undo .
     1195           define variable fh              as widget-handle no-undo .
     1196           define variable hh              as widget-handle no-undo .
     1197           define variable v-h             as handle        extent 4 no-undo .
     1198           define variable v-name-button   as character     no-undo .
     1199           define variable v-help-old-x    as decimal       no-undo .
     1200           define variable v-help-old-y    as decimal       no-undo .
     1201           define variable v-help-old-size as decimal       no-undo .
     1202           define variable v-frame-width   as decimal       no-undo .
     1203           define variable jj              as integer       no-undo .
     1204           do
     1205               on error undo, return error
     1206               :
     1207               assign
     1208                   v-frame-width = frame F-Main:width - 0.3
     1209                   fh            = frame F-Main:first-child
     1210                   hh            = fh:first-child
     1211                   ii            = 1
     1212                   .
     1213               do while valid-handle(hh):
     1214                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1215                   do:
     1216                       case lc(hh:name) :
     1217                           when "b-help" then
     1218                               do:
     1219                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1220                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1221                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1222                                   hh:TOOLTIP = "Помощь" .
     1223                                   v-help-old-x = hh:column .
     1224                                   v-help-old-y = hh:row    .
     1225                                   v-help-old-size = hh:width .
     1226                                   hh:width-chars = 2.5 .
     1227                               end.
     1228                           when "b-print" then
     1229                               do:
     1230                                   hh:load-image("cmp/b-print.bmp":u) .
     1231                                   hh:TOOLTIP = "Печать" .
     1232                                   v-h[ii] = hh:handle .
     1233                                   ii = ii + 1 .
     1234                                   hh:width-chars = 3 .
     1235                               end.
     1236                           when "b-history" or
     1237                           when "b-hist" then
     1238                               do:
     1239                                   hh:load-image("cmp/b-hist.bmp":u) .
     1240                                   hh:TOOLTIP = "История" .
     1241                                   v-h[ii] = hh:handle .
     1242                                   ii = ii + 1 .
     1243                                   hh:width-chars = 3 .
     1244                               end.
     1245                           when "b-sch" then
     1246                               do:
     1247                                   hh:load-image("cmp/b-sch.bmp":u) .
     1248                                   hh:TOOLTIP = "Установка Фильтра" .
     1249                                   v-h[ii] = hh:handle .
     1250                                   ii = ii + 1 .
     1251                                   hh:width-chars = 3 .
     1252                               end.
     1253                           when "b-hist-user" then
     1254                               do:
     1255                                   hh:load-image("cmp/b-hist.bmp":u) .
     1256                                   hh:TOOLTIP = "История пользователя" .
     1257                                   ii = ii + 1 .
     1258                               end.
     1259                       end case.
     1260                   end.
     1261                   hh = hh:next-sibling.
     1262               end.
     1263               b-help:column = v-frame-width - b-help:width-chars.
     1264               jj = 0.
     1265               repeat ii = 4 to 1 by -1 :
     1266                   if valid-handle (v-h[ii] ) then
     1267                   do:
     1268                       jj  = jj + 1 .
     1269                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1270                       v-h[ii]:row    = v-help-old-y .
     1271                   end.
     1272               end.
     1273           end.
     1274       end.
     1275   end procedure.
     1276   PROCEDURE adm-open-query-cases :
     1277     OPEN QUERY br_table FOR EACH ub.pl-pump WHERE ub.pl-pump.obj-type = varobj-type and                                                ub.pl-pump.obj-code = varobj-code NO-LOCK      INDEXED-REPOSITION.
     1278   END PROCEDURE.
     1279   PROCEDURE adm-row-available :
     1280     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1281     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1282     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1283     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1284     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1285     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1286     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1287     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1288     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1289     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1290     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1291     IF adm-updating-record THEN RETURN.
     1292     RUN get-attribute ('FIELDS-ENABLED':U).
     1293     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1294     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1295         OUTPUT link-handle) NO-ERROR.
     1296     IF link-handle = "":U THEN
     1297         RETURN.
     1298     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1299     IF NUM-ENTRIES(link-handle) > 1 THEN
     1300         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1301             "encountered more than one RECORD-SOURCE.":U SKIP
     1302             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1303                VIEW-AS ALERT-BOX ERROR.
     1304     RUN get-attribute ('Key-Name':U).
     1305     key-name = RETURN-VALUE.
     1306     IF key-name = "":U THEN key-name = ?.
     1307     IF key-name NE ? THEN DO:
     1308       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1309         NO-ERROR.
     1310       IF key-value NE ? THEN
     1311         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1312     END.
     1313   IF VALID-HANDLE (adm-object-hdl) THEN
     1314       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1315     IF key-name ne ? OR different-row
     1316     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1317     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1318   END PROCEDURE.
     1319   PROCEDURE disable_UI :
     1320     HIDE FRAME F-Main.
     1321     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1322   END PROCEDURE.
     1323   PROCEDURE local-initialize :
     1324   RUN request-attribute IN adm-broker-hdl
     1325       (INPUT THIS-PROCEDURE,
     1326        INPUT 'Container-Source':U,
     1327        INPUT 'parparentproc':U) NO-ERROR.
     1328   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "parparentproc" + " для получения данных." view-as alert-box error. return error.                    end.
     1329   assign parparentproc = widget-handle(return-value).
     1330   RUN request-attribute IN adm-broker-hdl
     1331       (INPUT THIS-PROCEDURE,
     1332        INPUT 'Container-Source':U,
     1333        INPUT 'obj-type':U) NO-ERROR.
     1334   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-type" + " для получения данных." view-as alert-box error. return error.                    end.
     1335   assign varobj-type = return-value.
     1336   RUN request-attribute IN adm-broker-hdl
     1337       (INPUT THIS-PROCEDURE,
     1338        INPUT 'Container-Source':U,
     1339        INPUT 'obj-code':U) NO-ERROR.
     1340   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-code" + " для получения данных." view-as alert-box error. return error.                    end.
     1341   assign varobj-code = integer(return-value).
     1342   RUN request-attribute IN adm-broker-hdl
     1343       (INPUT THIS-PROCEDURE,
     1344        INPUT 'Container-Source':U,
     1345        INPUT 'buttons':U) NO-ERROR.
     1346   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "buttons" + " для получения данных." view-as alert-box error. return error.                    end.
     1347   assign varbuttons = return-value.
     1348   assign varbuttons = replace (varbuttons, "|", ",").
     1349   if lookup('b-add', varbuttons) = 0 then do:
     1350     assign
     1351       b-add:sensitive in frame F-Main = no
     1352       b-add:visible   in frame F-Main = no
     1353       varps:read-only in frame F-Main = yes
     1354       varps-upd                    = no
     1355     .
     1356   end.
     1357   else do:
     1358     assign
     1359       varps-upd = yes
     1360     .
     1361   end.
     1362   if lookup('b-del', varbuttons) = 0 then
     1363      assign b-del:sensitive in frame F-Main = no
     1364             b-del:visible   in frame F-Main = no.
     1365     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1366   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367     run mainmenu_getcntxt in parparentproc
     1368       (output v-cntxt-db-num
     1369       ,output v-cntxt-userid
     1370       ,output v-cntxt-level
     1371       ,output v-cntxt-host-code-obj
     1372       ,output v-cntxt-obj-type
     1373       ,output v-cntxt-obj-code
     1374       ,output v-cntxt-db-num-obj
     1375       ,output v-cntxt-is-admin
     1376       ) .
     1377         assign
     1378           v-db-num    = v-cntxt-db-num
     1379           v-host-code = v-cntxt-host-code-obj
     1380           v-obj-code  = v-cntxt-obj-code
     1381           v-obj-type  = v-cntxt-obj-type
     1382           v-userid    = v-cntxt-userid
     1383           .
     1384     if available ub.pl-pump then do:
     1385        assign varps     = ub.pl-pump.ps.
     1386        display varps with frame F-Main.
     1387     end.
     1388   END PROCEDURE.
     1389   PROCEDURE send-key :
     1390   END PROCEDURE.
     1391   PROCEDURE send-records :
     1392     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1393     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1394     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1395     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1396     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1397     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1398         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1399         CASE ENTRY(i, p-tbl-list):
     1400       WHEN "ub.pl-pump":U THEN p-rowid-list = p-rowid-list +
     1401           IF AVAILABLE ub.pl-pump THEN STRING(ROWID(ub.pl-pump))
     1402           ELSE "?":U.
     1403           OTHERWISE
     1404           DO:
     1405               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1406                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1407               IF link-handle NE "":U THEN
     1408               DO:
     1409                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1410                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1411                               "encountered more than one RECORD-SOURCE.":U SKIP
     1412                               "The first will be used.":U
     1413                               VIEW-AS ALERT-BOX ERROR.
     1414                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1415                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1416                   p-rowid-list = p-rowid-list + rowid-string.
     1417               END.
     1418               ELSE
     1419               DO:
     1420                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1421                           "does not match tables in send-records":U
     1422                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1423                           "Check that objects are linked properly and that":U
     1424                           "database qualification is consistent.":U
     1425                       VIEW-AS ALERT-BOX ERROR.
     1426                   RETURN ERROR.
     1427               END.
     1428           END.
     1429           END CASE.
     1430       END.
     1431   END PROCEDURE.
     1432   PROCEDURE state-changed :
     1433     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1434     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1435     CASE p-state:
     1436       WHEN "update-begin":U THEN
     1437       DO:
     1438           adm-brs-in-update = yes.
     1439           RUN dispatch ('enable-fields':U).
     1440           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1441           DO:
     1442             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1443             RUN new-state('update-complete':U).
     1444           END.
     1445           ELSE DO:
     1446             RUN dispatch ('apply-entry':U).
     1447             RUN new-state('update':U).
     1448           END.
     1449       END.
     1450       WHEN "update":U THEN
     1451         DO:
     1452           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1453           RUN get-link-handle IN adm-broker-hdl
     1454               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1455                   NO-ERROR.
     1456           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1457             br_table:SENSITIVE IN FRAME F-Main = no.
     1458         END.
     1459       WHEN "update-complete":U THEN DO:
     1460           br_table:SENSITIVE IN FRAME F-Main = yes.
     1461           adm-brs-in-update = no.
     1462           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1463           IF RETURN-VALUE NE "YES":U THEN
     1464           DO:
     1465             IF NUM-RESULTS("br_table":U) NE ? AND
     1466                NUM-RESULTS("br_table":U) NE 0
     1467             THEN DO:
     1468               GET CURRENT br_table.
     1469               RUN dispatch ('row-changed':U).
     1470             END.
     1471           END.
     1472           RUN new-state ('update-complete':U).
     1473       END.
     1474       WHEN "delete-complete":U THEN DO:
     1475          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1476          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1477          IF NUM-RESULTS("br_table":U) = 0 THEN
     1478            RUN notify('row-available':U).
     1479       END.
     1480       WHEN   'first-record':U        OR
     1481         WHEN 'last-record':U         OR
     1482         WHEN 'only-record':U         OR
     1483         WHEN 'not-first-or-last':U   OR
     1484         WHEN 'no-record-available':U OR
     1485         WHEN 'no-external-record-available':U THEN
     1486           RUN set-attribute-list('Query-Position=':U + p-state).
     1487     END CASE.
     1488   END PROCEDURE.
