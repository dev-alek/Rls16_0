        1   block-level on error undo, throw.
        2   define input parameter parrec-doc as recid                no-undo.
        3   define input parameter parstatus  like ub.trn-doc.status_ no-undo.
        4   define input parameter parflag    like ub.trn-doc.flag_   no-undo.
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   define new global shared variable g#library  as handle no-undo .
       10   define new global shared variable g#library2 as handle no-undo .
       11   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define new global shared variable g#trdcalib as handle no-undo.
       13   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       16   define variable par-type          as character no-undo.
       17   define variable v-value-character as character no-undo .
       18   define variable v-value-date      as date      no-undo .
       19   define variable v-value-decimal   as decimal   no-undo .
       20   define variable v-value-integer   as integer   no-undo .
       21   define variable v-value-logical   as logical   no-undo .
       22   define buffer io_trn-doc     for ub.trn-doc.
       23   define buffer io_trn-doc-sum for ub.trn-doc-sum.
       24   define buffer io_doc-line    for ub.doc-line.
       25   define buffer io_gds-obj     for ub.gds-obj.
       26   define variable varlns-cnt as integer  no-undo.
       27   define variable varvaluewt    as character no-undo.
       28   define variable vartypewt     as character no-undo.
       29   define variable varvalueol    as character no-undo.
       30   define variable vartypeol     as character no-undo.
       31   define variable wastagevalue  as character no-undo.
       32   define variable wastagetype   as character no-undo.
       33   define variable varinvclcspvalue as character no-undo.
       34   define variable varinvclcsptype  as character no-undo.
       35   define variable varcount         as integer   no-undo.
       36   do
       37   on error undo, return error return-value
       38   :
       39     find first io_trn-doc where recid(io_trn-doc) = parrec-doc.
       40   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       41   empty temp-table thbjattr_thbj-attr.
       42   run adm/shattri.p (
       43      input "get":U
       44     ,input io_trn-doc.obj-type
       45     ,input io_trn-doc.obj-code
       46     ,input 'inv-obj':U
       47     ,input  ""
       48     ,output v-value-character
       49     ,output v-value-date
       50     ,output v-value-decimal
       51     ,output v-value-integer
       52     ,output v-value-logical
       53     ,output par-type
       54     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
       55     ) no-error .
       56     for each thbjattr_thbj-attr :
       57         if thbjattr_thbj-attr.prop-code = 'invclcsp'  then varinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
       58     end.
       59     assign
       60       io_trn-doc.doc-qnty    = 0
       61       io_trn-doc.fact-qnty   = 0
       62       io_trn-doc.tot-calc    = 0
       63       io_trn-doc.discnt-rubl = 0
       64       io_trn-doc.tot-doc     = 0
       65       io_trn-doc.tot-rubl    = 0
       66       io_trn-doc.fact-base   = 0
       67       io_trn-doc.fact-rubl   = 0
       68       io_trn-doc.tot-ov      = 0
       69       io_trn-doc.re-grading-parts-minus = no
       70     .
       71     run trg/lock-gds.p
       72       (input io_trn-doc.doc-code
       73       ,input no
       74       ,input no
       75       ,input 0
       76       ,input 0
       77       ,input false
       78       ,input false
       79       ) no-error .
       80     if error-status :error then do:
       81       undo, return error return-value.
       82     end.
       83     assign
       84       varcount = 0.
       85     for each io_doc-line
       86       where io_doc-line.doc-code = io_trn-doc.doc-code
       87     on error undo, return error return-value
       88     :
       89       assign
       90         varcount = varcount + 1.
       91       if io_trn-doc.status_ <> 'запрос':U then do:
       92         run trg/rsrv-del.p
       93           (input io_doc-line.doc-code
       94           ,input io_doc-line.artic
       95           ,input io_doc-line.prod-type
       96           ,input io_doc-line.prod-code
       97           ) no-error .
       98       end.
       99       if error-status :error then do:
      100         undo, return error substitute("Ошибка при снятии резервов. Документ &1 Артикул: &2 &3 &4 Открыть инвентаризацию невозможно.",
      101                                       io_doc-line.doc-code,
      102                                       io_doc-line.artic,
      103                                       io_doc-line.prod-type,
      104                                       io_doc-line.prod-code).
      105       end.
      106     end.
      107     run gbl/conf-rd.p ("wastage":u , io_trn-doc.host-code, io_trn-doc.obj-type, io_trn-doc.obj-code, "", "", "", no,  output wastagevalue, output wastagetype) no-error.
      108   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input io_trn-doc.doc-code ,
      109                           input 'clcaswt':U ,
      110                          output varvaluewt ,
      111                          output vartypewt )  .
      112   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input io_trn-doc.doc-code ,
      113                           input 'clcasol':U ,
      114                          output varvalueol ,
      115                          output vartypeol )  .
      116         find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'bd':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'bd':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      117       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'bcd':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'bcd':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      118       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'wst':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'wst':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      119       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'wstc':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'wstc':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      120       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'gen':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'gen':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      121       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'genc':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'genc':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      122       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'ext':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'ext':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      123       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'extc':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'extc':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      124       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'mis':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'mis':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      125       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'misc':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'misc':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      126       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'ad':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'ad':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      127       find first io_trn-doc-sum where io_trn-doc-sum.doc-code = io_trn-doc.doc-code  and                                         io_trn-doc-sum.sum-type = 'acd':U no-error.         if available io_trn-doc-sum then do:           run delete-trn  in this-procedure (input io_trn-doc.doc-code,                                               input 'acd':U) no-error.           if error-status:error then do:             undo, return error return-value.           end.         end.
      128   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input io_trn-doc.doc-code ,
      129                          input 'addsum':U ,
      130                          input ' ' ) no-error .
      131     if error-status :error then do:
      132       undo, return error substitute( "Ошибка при вызове процедуры tdatr-wrt &1.", return-value ).
      133     end.
      134   end.
      135   procedure delete-trn :
      136     define input parameter pardoc-code like ub.trn-doc.doc-code     no-undo.
      137     define input parameter parsum-type like ub.trn-doc-sum.sum-type no-undo.
      138     define buffer bf_trn-doc      for ub.trn-doc.
      139     define buffer bf_trn-doc-sum  for ub.trn-doc-sum.
      140     define buffer bf_doc-line-sum for ub.doc-line-sum.
      141     do on error undo, return error return-value :
      142       find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
      143       for each bf_trn-doc-sum where bf_trn-doc-sum.doc-code = pardoc-code and
      144                                     bf_trn-doc-sum.sum-type = parsum-type exclusive-lock on error undo, return error return-value :
      145         for each bf_doc-line-sum where bf_doc-line-sum.doc-code = bf_trn-doc.doc-code and
      146                                        bf_doc-line-sum.sum-type = parsum-type         exclusive-lock on error undo, return error return-value :
      147           delete bf_doc-line-sum.
      148         end.
      149         delete bf_trn-doc-sum.
      150       end.
      151     end.
      152   end procedure.
