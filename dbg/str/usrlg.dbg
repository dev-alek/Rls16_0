     1447   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   on help of frame Dialog-Frame
     1449   do:
     1450     run gbl/app_help.p
     1451       (input this-procedure :file-name
     1452       ,input ''
     1453       ,input ?
     1454       ) no-error.
     1455     if error-status :error then do:
     1456       message
     1457         "Ошибка при вызове помощи"
     1458         error-status :get-message(1)
     1459         view-as alert-box .
     1460     end.
     1461   end.
     1462   run minbtn-set in this-procedure .
     1463   on choose of b-help in frame Dialog-Frame
     1464   do:
     1465     apply "help":u to frame Dialog-Frame .
     1466   end.
     1467   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1468   procedure minbtn-set :
     1469       do
     1470           on error undo, return error return-value
     1471           :
     1472           define variable ii              as integer       no-undo .
     1473           define variable fh              as widget-handle no-undo .
     1474           define variable hh              as widget-handle no-undo .
     1475           define variable v-h             as handle        extent 4 no-undo .
     1476           define variable v-name-button   as character     no-undo .
     1477           define variable v-help-old-x    as decimal       no-undo .
     1478           define variable v-help-old-y    as decimal       no-undo .
     1479           define variable v-help-old-size as decimal       no-undo .
     1480           define variable v-frame-width   as decimal       no-undo .
     1481           define variable jj              as integer       no-undo .
     1482           do
     1483               on error undo, return error
     1484               :
     1485               assign
     1486                   v-frame-width = frame Dialog-Frame:width - 0.3
     1487                   fh            = frame Dialog-Frame:first-child
     1488                   hh            = fh:first-child
     1489                   ii            = 1
     1490                   .
     1491               do while valid-handle(hh):
     1492                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1493                   do:
     1494                       case lc(hh:name) :
     1495                           when "b-help" then
     1496                               do:
     1497                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1498                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1499                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1500                                   hh:TOOLTIP = "Помощь" .
     1501                                   v-help-old-x = hh:column .
     1502                                   v-help-old-y = hh:row    .
     1503                                   v-help-old-size = hh:width .
     1504                                   hh:width-chars = 2.5 .
     1505                               end.
     1506                           when "b-print" then
     1507                               do:
     1508                                   hh:load-image("cmp/b-print.bmp":u) .
     1509                                   hh:TOOLTIP = "Печать" .
     1510                                   v-h[ii] = hh:handle .
     1511                                   ii = ii + 1 .
     1512                                   hh:width-chars = 3 .
     1513                               end.
     1514                           when "b-history" or
     1515                           when "b-hist" then
     1516                               do:
     1517                                   hh:load-image("cmp/b-hist.bmp":u) .
     1518                                   hh:TOOLTIP = "История" .
     1519                                   v-h[ii] = hh:handle .
     1520                                   ii = ii + 1 .
     1521                                   hh:width-chars = 3 .
     1522                               end.
     1523                           when "b-sch" then
     1524                               do:
     1525                                   hh:load-image("cmp/b-sch.bmp":u) .
     1526                                   hh:TOOLTIP = "Установка Фильтра" .
     1527                                   v-h[ii] = hh:handle .
     1528                                   ii = ii + 1 .
     1529                                   hh:width-chars = 3 .
     1530                               end.
     1531                           when "b-hist-user" then
     1532                               do:
     1533                                   hh:load-image("cmp/b-hist.bmp":u) .
     1534                                   hh:TOOLTIP = "История пользователя" .
     1535                                   ii = ii + 1 .
     1536                               end.
     1537                       end case.
     1538                   end.
     1539                   hh = hh:next-sibling.
     1540               end.
     1541               b-help:column = v-frame-width - b-help:width-chars.
     1542               jj = 0.
     1543               repeat ii = 4 to 1 by -1 :
     1544                   if valid-handle (v-h[ii] ) then
     1545                   do:
     1546                       jj  = jj + 1 .
     1547                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1548                       v-h[ii]:row    = v-help-old-y .
     1549                   end.
     1550               end.
     1551           end.
     1552       end.
     1553   end procedure.
     1554   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1555   define variable v-diasize-need-maximize        as logical   no-undo init true  .
