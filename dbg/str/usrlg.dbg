        1   define temp-table temp_userhist no-undo
        2       field ush-key  as integer
        3       field ushDate  as date
        4       field ushtime  as integer
        5       field ushTable as character
        6       field ushDesc  as character
        7       index pi is primary unique
        8       ush-key
        9       .
       10   define temp-table temp_userhist-line no-undo
       11       field usl-key as integer
       12       field ush-key as integer
       13       field uslDesc as character
       14       index pi is primary unique
       15       usl-key
       16       .
       17   define temp-table tt-field no-undo
       18       field f-name  as character
       19       field f-table as character.
       20   define variable v-usrlg-ush-key as integer no-undo.
       21   define variable v-usrlg-usl-key as integer no-undo.
       22   define input parameter parparentproc    as handle           no-undo.
       23   define input parameter p-userid         as character        no-undo.
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "История пользователя - просмотр".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure gen-key-rec :
       92     define input  parameter p-tbl-name    as character no-undo.
       93     define input  parameter p-bh_tbl-name as handle    no-undo.
       94     define output parameter p-key-rec     as character no-undo.
       95     do
       96     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       97     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       98     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       99     :
      100       define variable fh               as handle    no-undo .
      101       define variable v-ok             as logical   no-undo .
      102       define variable v-inform         as character no-undo .
      103       define variable v-ind            as integer   no-undo .
      104       define variable v-idx-field-qnty as integer   no-undo .
      105       if p-tbl-name = ?
      106         or p-tbl-name = "":U
      107       then do:
      108         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      109       end.
      110       if not p-bh_tbl-name:available then do:
      111         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      112       end.
      113       assign
      114         p-key-rec = p-tbl-name
      115         v-inform  = p-bh_tbl-name:index-information(1)
      116         v-ind     = 2
      117       .
      118       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      119       on error undo, return error
      120       :
      121         assign
      122           v-inform = p-bh_tbl-name:index-information( v-ind )
      123           v-ind    = v-ind + 1
      124         .
      125       end.
      126       if v-inform = ?
      127         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      128         or entry( 3, v-inform, ",":U ) <> "1":U
      129       then do:
      130         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      131       end.
      132       else do:
      133         assign
      134           v-idx-field-qnty = num-entries( v-inform ) - 4
      135         .
      136         if v-idx-field-qnty < 2 then do:
      137           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      138         end.
      139         do v-ind = 1 to v-idx-field-qnty by 2
      140         on error undo, return error
      141         :
      142           assign
      143             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      144             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      145           .
      146         end.
      147       end.
      148       if p-key-rec = ? then do:
      149         assign
      150           p-key-rec = "":U
      151         .
      152         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      153       end.
      154     end.
      155     return.
      156   end procedure.
      157   procedure gen-where-keyr-tab :
      158     define input  parameter i-tableSerach as character no-undo.
      159     define input  parameter i-tablekey   as character  no-undo.
      160     define input  parameter p-key-rec    as character  no-undo.
      161     define input  parameter p-key-handle as handle     no-undo .
      162     define input  parameter p-db-name    as character  no-undo .
      163     define input  parameter p-tt-handle  as handle     no-undo .
      164     define output parameter o-Where      as character  no-undo.
      165     do
      166     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      167     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      168     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      169     :
      170       define variable v-full-tbl-name  as character no-undo .
      171       define variable bh_tbl-name      as handle    no-undo .
      172       define variable fh_key           as handle    no-undo .
      173       define variable fh_search        as handle    no-undo .
      174       define variable v-field-num      as integer   no-undo .
      175       define variable v-count-fld      as integer   no-undo .
      176       define variable v-inform         as character no-undo .
      177       define variable v-ind            as integer   no-undo .
      178       define variable v-idx-field-qnty as integer   no-undo .
      179       define variable v-field-name     as character no-undo .
      180       define variable v-field-val      as character no-undo .
      181       define variable v-word-link      as character no-undo .
      182       define variable vTable           as character no-undo.
      183       define variable bh_tbl-key       as handle    no-undo .
      184       assign
      185         p-key-rec = trim( p-key-rec )
      186       .
      187       if p-key-handle <> ? then do:
      188         if not valid-handle(p-key-handle)
      189            or p-key-handle:type <> "buffer"
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      192         end.
      193         if num-entries( p-key-rec, chr(3) ) > 1
      194           or p-key-rec = ?
      195           or p-key-rec = "":U
      196         then do:
      197           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      198         end.
      199       end.
      200       else do:
      201         if p-key-rec = ?
      202           or p-key-rec = "":U
      203         then do:
      204           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      205         end.
      206       end.
      207       assign
      208         vTable = entry( 1 , p-key-rec, chr(3) )
      209       .
      210       if p-tt-handle <> ?
      211         and ( not valid-handle(p-tt-handle)
      212               or p-tt-handle:type <> "buffer"
      213             )
      214       then do:
      215         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      216       end.
      217       if p-tt-handle = ? then do:
      218         assign
      219           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      220         .
      221         create buffer bh_tbl-name for table v-full-tbl-name .
      222       end.
      223       else do:
      224         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      225       end.
      226       assign
      227         v-inform = bh_tbl-name:index-information(1)
      228         v-ind    = 2
      229       .
      230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      231       on error undo, return error
      232       :
      233         assign
      234           v-inform = bh_tbl-name:index-information( v-ind )
      235           v-ind    = v-ind + 1
      236         .
      237       end.
      238       if v-inform = ?
      239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      240         or entry( 3, v-inform, ",":U ) <> "1":U
      241       then do:
      242         delete object bh_tbl-name no-error.
      243         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      244       end.
      245       assign
      246         v-idx-field-qnty = num-entries( v-inform ) - 4
      247       .
      248       if v-idx-field-qnty < 2 then do:
      249         delete object bh_tbl-name no-error.
      250         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      251       end.
      252       assign
      253         o-where     = "where":U
      254         v-word-link = "":U
      255         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      256         v-count-fld = 0
      257       .
      258       if i-tablekey ne "" and i-tablekey ne ?
      259       then do:
      260         assign
      261           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      262         .
      263         create buffer bh_tbl-key for table v-full-tbl-name .
      264       end.
      265       if i-tableSerach ne "" and i-tableSerach ne ?
      266       then do:
      267         delete object bh_tbl-name no-error.
      268         assign
      269           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      270         .
      271         create buffer bh_tbl-name for table v-full-tbl-name .
      272       end.
      273       block_where:
      274       do v-ind = 1 to v-idx-field-qnty by 2
      275       on error undo, return error
      276       :
      277         assign
      278           v-count-fld = v-count-fld + 1
      279         .
      280         if p-key-handle = ?
      281           and v-count-fld > v-field-num
      282         then do:
      283           leave block_where.
      284         end.
      285         define variable VfieldKeyTable as handle no-undo.
      286         assign
      287           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      288           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      289         .
      290         if     bh_tbl-key ne ?
      291         then do:
      292            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      293            if VfieldKeyTable eq ?
      294            then next block_where.
      295         end.
      296         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      297         then
      298            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      299         else
      300            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      301         if p-key-handle = ? then do:
      302           assign
      303             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      304           .
      305         end.
      306         else do:
      307           assign
      308             fh_key = p-key-handle:buffer-field( v-field-name )
      309           .
      310           if fh_key = ?
      311             or not valid-handle( fh_key )
      312           then do:
      313             delete object bh_tbl-name.
      314             if     bh_tbl-key ne ?
      315             then
      316                delete object bh_tbl-key.
      317             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      318           end.
      319           assign
      320             v-field-val = fh_key:buffer-value
      321           .
      322         end.
      323         if fh_search:data-type ="character":U then do:
      324           assign
      325             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      326             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      327             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      328             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      329             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      330             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      331             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      332             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      333             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      334             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      335             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      336             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      337             v-field-val = substitute( '"&1"', v-field-val )
      338           .
      339         end.
      340         assign
      341           o-where = substitute( "&1 &2", o-where, v-field-val )
      342         .
      343         if v-word-link = "":U then do:
      344           assign
      345             v-word-link = "and":U
      346           .
      347         end.
      348       end.
      349       delete object bh_tbl-name.
      350       if     bh_tbl-key ne ?
      351       then
      352          delete object bh_tbl-key.
      353       if p-key-handle = ?
      354         and v-count-fld <> v-field-num
      355       then do:
      356         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      357       end.
      358     end.
      359   end procedure.
      360   procedure gen-hn-keyr-tab :
      361     define input  parameter i-tableSerach as character no-undo.
      362     define input  parameter i-tablekey   as character no-undo.
      363     define input  parameter p-key-rec    as character no-undo.
      364     define input  parameter p-key-handle as handle    no-undo .
      365     define input  parameter p-db-name    as character no-undo .
      366     define input  parameter p-tt-handle  as handle    no-undo .
      367     define input  parameter p-stts-lock  as integer   no-undo .
      368     define output parameter o-hn         as handle    no-undo.
      369     define variable v-full-tbl-name as character no-undo.
      370     define variable v-where         as character no-undo.
      371     define variable bh_tbl-name     as handle    no-undo.
      372     define variable vTable          as character no-undo.
      373     do
      374     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      375     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      377         run gen-where-keyr-tab(i-tableSerach,
      378                                i-tablekey,
      379                                p-key-rec,
      380                                p-key-handle,
      381                                p-db-name,
      382                                p-tt-handle,
      383                                output v-where).
      384         if i-tableSerach ne "" and i-tableSerach ne ?
      385         then do:
      386            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      387            create buffer bh_tbl-name for table v-full-tbl-name .
      388         end.
      389         else do:
      390            if p-tt-handle = ? then do:
      391               assign
      392                  vTable = entry( 1 , p-key-rec, chr(3) )
      393               .
      394               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      395               create buffer bh_tbl-name for table v-full-tbl-name .
      396            end.
      397            else do:
      398               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      399            end.
      400         end.
      401         if p-tt-handle = ? then do:
      402            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      403         end.
      404         else do:
      405            bh_tbl-name:find-first( v-where ) no-error .
      406         end.
      407         o-hn = bh_tbl-name.
      408      end.
      409   end procedure.
      410   procedure gen-hn-keyr :
      411     define input  parameter p-key-rec    as character no-undo.
      412     define input  parameter p-key-handle as handle    no-undo .
      413     define input  parameter p-db-name    as character no-undo .
      414     define input  parameter p-tt-handle  as handle    no-undo .
      415     define input  parameter p-stts-lock  as integer   no-undo .
      416     define output parameter o-hn         as handle    no-undo.
      417     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      418   end.
      419   procedure gen-row-keyr :
      420     define input  parameter p-key-rec    as character no-undo.
      421     define input  parameter p-key-handle as handle    no-undo .
      422     define input  parameter p-db-name    as character no-undo .
      423     define input  parameter p-tt-handle  as handle    no-undo .
      424     define input  parameter p-stts-lock  as integer   no-undo .
      425     define output parameter p-tbl-row    as rowid     no-undo.
      426     define output parameter p-tbl-name   as character no-undo.
      427     define variable vHn as handle no-undo.
      428       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      429       p-tbl-row = if vHn:available then vHn:rowid else ?.
      430       p-tbl-name =  vHn:table.
      431       delete object vHn no-error.
      432     if p-tbl-row = ? then do:
      433       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      434     end.
      435     else do:
      436       return.
      437     end.
      438   end procedure.
      439   procedure gen-key-fv :
      440     define input  parameter p-key-rec    as character no-undo .
      441     define output parameter p-field-list as character no-undo .
      442     define output parameter p-value-list as character no-undo.
      443     do
      444     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      445     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      446     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      447     :
      448       define variable v-full-tbl-name  as character no-undo .
      449       define variable bh_tbl-name      as handle    no-undo .
      450       define variable v-tbl-name       as character no-undo .
      451       define variable v-field-num      as integer   no-undo .
      452       define variable v-count-fld      as integer   no-undo .
      453       define variable v-inform         as character no-undo .
      454       define variable v-ind            as integer   no-undo .
      455       define variable v-idx-field-qnty as integer   no-undo .
      456       define variable v-delim-key      as character no-undo .
      457       if p-key-rec = ?
      458         or p-key-rec = "":U
      459       then do:
      460         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      461       end.
      462       assign
      463         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      464         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      465       .
      466       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      467       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      468       assign
      469         v-inform = bh_tbl-name:index-information(1)
      470         v-ind    = 2
      471       .
      472       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      473       on error undo, return error
      474       :
      475         assign
      476           v-inform = bh_tbl-name:index-information( v-ind )
      477           v-ind    = v-ind + 1
      478         .
      479       end.
      480       if v-inform = ?
      481         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      482         or entry( 3, v-inform, ",":U ) <> "1":U
      483       then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      486       end.
      487       assign
      488         v-idx-field-qnty = num-entries( v-inform ) - 4
      489       .
      490       if v-idx-field-qnty < 2 then do:
      491         delete object bh_tbl-name no-error.
      492         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      493       end.
      494       assign
      495         p-field-list = "":U
      496         p-value-list = "":U
      497         v-delim-key  = "":U
      498         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      499         v-count-fld  = 0
      500       .
      501       block_where:
      502       do v-ind = 1 to v-idx-field-qnty by 2
      503       on error undo, return error
      504       :
      505         assign
      506           v-count-fld = v-count-fld + 1
      507         .
      508         if v-count-fld > v-field-num then do:
      509           leave block_where.
      510         end.
      511         assign
      512           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      513           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      514         .
      515         if v-ind = 1 then do:
      516           assign
      517             v-delim-key = chr(3)
      518           .
      519         end.
      520       end.
      521       delete object bh_tbl-name.
      522       if v-count-fld <> v-field-num then do:
      523         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      524       end.
      525     end.
      526   end procedure.
      527   procedure gen-key-field :
      528     define input  parameter p-table      as character no-undo .
      529     define output parameter p-field-list as character no-undo .
      530     do
      531     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      534     :
      535       define variable v-full-tbl-name  as character no-undo .
      536       define variable bh_tbl-name      as handle    no-undo .
      537       define variable v-tbl-name       as character no-undo .
      538       define variable v-field-num      as integer   no-undo .
      539       define variable v-count-fld      as integer   no-undo .
      540       define variable v-inform         as character no-undo .
      541       define variable v-ind            as integer   no-undo .
      542       define variable v-idx-field-qnty as integer   no-undo .
      543       define variable v-delim-key      as character no-undo .
      544       if p-table = ?
      545         or p-table = "":U
      546       then do:
      547         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      548       end.
      549       assign
      550         v-tbl-name      = p-table
      551         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      552       .
      553       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      554       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      555       assign
      556         v-inform = bh_tbl-name:index-information(1)
      557         v-ind    = 2
      558       .
      559       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      560       on error undo, return error
      561       :
      562         assign
      563           v-inform = bh_tbl-name:index-information( v-ind )
      564           v-ind    = v-ind + 1
      565         .
      566       end.
      567       if v-inform = ?
      568         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      569         or entry( 3, v-inform, ",":U ) <> "1":U
      570       then do:
      571         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      572       end.
      573       assign
      574         v-idx-field-qnty = num-entries( v-inform ) - 4
      575       .
      576       if v-idx-field-qnty < 2 then do:
      577         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      578       end.
      579       assign
      580         p-field-list = "":U
      581         v-delim-key  = "":U
      582         v-count-fld  = 0
      583       .
      584       block_where:
      585       do v-ind = 1 to v-idx-field-qnty by 2
      586       on error undo, return error
      587       :
      588         assign
      589           v-count-fld = v-count-fld + 1
      590         .
      591         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      592         if v-ind = 1 then do:
      593           assign
      594             v-delim-key = chr(3)
      595           .
      596         end.
      597       end.
      598       delete object bh_tbl-name.
      599     end.
      600   end procedure.
      601   procedure proc-alt-shift-f2:
      602     if not ibs.th.gbl.gbl-var:rcode
      603   then
      604     run gbl\inidebug.p .
      605   end.
      606   procedure proc-alt-shift-f3:
      607     run gbl/prvssinf.p
      608       ( input this-procedure
      609       ) .
      610   end.
      611   define variable v-inform-launched as logical no-undo initial false .
      612   procedure proc-alt-shift-f4:
      613     define variable v-action as character no-undo .
      614     if v-inform-launched = false then do:
      615       assign
      616         v-inform-launched = true
      617       .
      618       run gbl/d-inform.w
      619         (  input self
      620         ,  input this-procedure
      621         , output v-action
      622         ) no-error .
      623       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      624       assign
      625         v-inform-launched = false
      626       .
      627     end.
      628   end.
      629   procedure proc-alt-f1:
      630     run gbl/corrhelp.p
      631       (input this-procedure
      632       ) .
      633   end .
      634   on alt-shift-f2 anywhere do:
      635     run proc-alt-shift-f2.
      636   end.
      637   on alt-shift-f3 anywhere do:
      638     run proc-alt-shift-f3 in this-procedure .
      639   end.
      640   on alt-shift-f4 anywhere do:
      641     run proc-alt-shift-f4 in this-procedure.
      642   end.
      643   on alt-f1 anywhere do:
      644     run proc-alt-f1 in this-procedure .
      645   end.
      646   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   define  stream PrnLibStream.
      648   procedure prn-lib-prn-file :
      649     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      650     define input parameter p-DIsabledoptions as integer no-undo .
      651     define variable v-report-name as character no-undo .
      652     define variable v-user-action as character no-undo .
      653     define variable v-printed     as logical   no-undo .
      654     define variable v-exist       as logical   no-undo .
      655     do
      656       on error undo, return error
      657       :
      658       run prn-lib-get-report-name  in this-procedure (
      659         input parParentProc
      660         ,output v-report-name
      661         ).
      662   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      664     (input  v-report-name
      665     ,input  2
      666     ,output v-exist
      667     )  .
      668       if NOT v-exist then
      669       DO:
      670         Message
      671           "Нет заданий на печать ! "
      672           view-as alert-box .
      673         Return  .
      674       End.
      675       run gbl/prnfilen.w
      676         (input  ""
      677         ,input  p-DisabledOptions
      678         ,input  string(v-report-name )
      679         ,input  7
      680         ,output v-user-action
      681         ,output v-printed
      682         ) .
      683       if v-printed then
      684       do:
      685         return "YES" .
      686       end.
      687       else
      688       do:
      689         return "NO" .
      690       end.
      691     end.
      692   end procedure.
      693   procedure prn-lib-open-stream :
      694     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      695     define input parameter p-page-size    as integer no-undo .
      696     define input parameter p-is-stream    as logical no-undo .
      697     define input parameter p-append       as logical no-undo .
      698     define variable v-report-name as character no-undo .
      699     do
      700       on error undo, return error
      701       :
      702       run prn-lib-get-report-name  in this-procedure (
      703         input parParentProc
      704         ,output v-report-name
      705         ).
      706       if p-is-stream then
      707       do:
      708         if p-append then
      709         do:
      710           output stream PrnLibStream to value( v-report-name )
      711             page-size value(p-page-size) append .
      712         end.
      713         if not p-append then
      714         do:
      715           output stream PrnLibStream to value( v-report-name )
      716             page-size value(p-page-size) .
      717         end.
      718       end.
      719       if not p-is-stream then
      720       do:
      721         if p-append then
      722         do:
      723           output to value( v-report-name )
      724             page-size value(p-page-size) append .
      725         end.
      726         if not p-append then
      727         do:
      728           output to value( v-report-name )
      729             page-size value(p-page-size) .
      730         end.
      731       end.
      732     end.
      733   end procedure.
      734   procedure prn-lib-open-exp :
      735     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      736     define input parameter p-is-stream    as logical no-undo .
      737     define input parameter p-is-append    as logical no-undo .
      738     define output parameter p-ReportFileName as char init "report" no-undo.
      739     define output parameter p-process as logical no-undo .
      740     define variable glog as logical no-undo .
      741     do
      742       on error undo, return error
      743       :
      744       SYSTEM-DIALOG GET-FILE p-ReportFileName
      745         TITLE      "Укажите путь"
      746         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      747         ASK-OVERWRITE
      748         CREATE-TEST-FILE
      749         SAVE-AS
      750         USE-FILENAME
      751         DEFAULT-EXTENSION "txt"
      752         UPDATE glog
      753         .
      754       if not glog then  return.
      755       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      756       if p-is-stream then
      757       do:
      758         if p-is-append then
      759         do:
      760           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      761         end.
      762         else
      763         do:
      764           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      765         end.
      766       end.
      767       else
      768       do:
      769         if p-is-append then
      770         do:
      771           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      772         end.
      773         else
      774         do:
      775           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      776         end.
      777       end.
      778       p-process = yes.
      779     end.
      780   end procedure.
      781   procedure prn-lib-get-report-name :
      782     define input parameter parParentProc  as widget-handle no-undo.
      783     define output parameter p-report-name as character no-undo .
      784     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      785   end procedure.
      786   procedure prn-lib-reportviewer-report-name :
      787     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      788     define input parameter p-report-name-html as character no-undo .
      789     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      790   end procedure.
      791   procedure prn-lib-reportviewer :
      792     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      793     define input parameter p-report-name-html as character no-undo .
      794     define input parameter p-param        as character no-undo .
      795     define variable v-excel           as character no-undo init 'TRUE' .
      796     define variable v-value-character as character no-undo .
      797     define variable v-value-integer   as character no-undo .
      798     define variable v-value-date      as date      no-undo .
      799     define variable v-value-decimal   as decimal   no-undo .
      800     define variable rep-excel         as logical   no-undo .
      801     define variable excel-string      as character no-undo .
      802     define variable v-param-type      as character no-undo .
      803     define variable v-tth             as handle    no-undo .
      804     run adm/shattri.p (
      805       input "get":U
      806       ,input  ""
      807       ,input  0
      808       ,input  'report-glob':U
      809       ,input  'rep-excel':U
      810       ,output v-value-character
      811       ,output v-value-date
      812       ,output v-value-decimal
      813       ,output v-value-integer
      814       ,output rep-excel
      815       ,output v-param-type
      816       ,INPUT-OUTPUT table-handle v-tth
      817       )  .
      818     if rep-excel then v-excel = "TRUE" .
      819     else v-excel = "FALSE" .
      820     if p-param eq ""
      821     then
      822        p-param = "EXCEL:" + v-excel.
      823     else
      824        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      825     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      826   end procedure.
      827   define variable v-c-table as character no-undo .
      828   define variable v-table   as character no-undo .
      829   define buffer buf_head_c-user-log for c-user-log.
      830   define buffer buf_line_c-user-log for c-user-log.
      831   define stream out-stream.
      832   define stream OutStr-html.
      833   define variable p-report-id             as integer   no-undo .
      834   define variable v-report-name-html      as CHARACTER no-undo .
      835   define variable v-report-name-html-list as CHARACTER no-undo .
      836   FUNCTION get-unique-key RETURNS CHARACTER
      837       ( p-head-table as character,
      838         p-unique-key-rec as character )  FORWARD.
      839   DEFINE BUTTON b-cancel AUTO-END-KEY
      840       LABEL "&Отмена"
      841       SIZE 10 BY 1
      842       BGCOLOR 8 .
      843   DEFINE BUTTON b-exit AUTO-GO
      844       LABEL "В&ыход"
      845       SIZE 10 BY 1
      846       BGCOLOR 8 .
      847   DEFINE BUTTON b-help
      848       LABEL "Помо&щь"
      849       SIZE 3 BY 1
      850       BGCOLOR 8 .
      851   DEFINE BUTTON b-print
      852       LABEL "Печать"
      853       SIZE 3 BY 1.
      854   DEFINE BUTTON bt-doc-hist
      855       LABEL "Просмотр"
      856       SIZE 10 BY 1.
      857   DEFINE VARIABLE cb-table    AS CHARACTER FORMAT "X(256)":U
      858       LABEL "Объект"
      859       VIEW-AS COMBO-BOX INNER-LINES 15
      860       DROP-DOWN-LIST
      861       SIZE 22.75 BY 1 NO-UNDO.
      862   DEFINE VARIABLE fi-date-for AS DATE      FORMAT "99.99.9999":U
      863       LABEL "по"
      864       VIEW-AS FILL-IN
      865       SIZE 12.63 BY 1 NO-UNDO.
      866   DEFINE VARIABLE fi-date-to  AS DATE      FORMAT "99.99.9999":U
      867       LABEL "Даты с"
      868       VIEW-AS FILL-IN
      869       SIZE 12.63 BY 1 NO-UNDO.
      870   DEFINE QUERY br-head FOR
      871       buf_head_c-user-log SCROLLING.
      872   DEFINE BROWSE br-head
      873       QUERY br-head NO-LOCK DISPLAY
      874       buf_head_c-user-log.corr-date FORMAT "99.99.9999":U
      875       string( buf_head_c-user-log.corr-time, "hh:mm:ss" ) FORMAT "X(9)":U column-label "Время"
      876       buf_head_c-user-log.des FORMAT "x(256)":U width 40
      877       buf_head_c-user-log.head-table FORMAT "x(15)":U
      878       get-unique-key( buf_head_c-user-log.head-table, buf_head_c-user-log.uniq-key-rec ) FORMAT "x(40)":U
      879       WITH NO-ROW-MARKERS SEPARATORS SIZE 104 BY 21 FIT-LAST-COLUMN.
      880   DEFINE FRAME Dialog-Frame
      881       b-exit AT ROW 1 COL 1
      882       b-cancel AT ROW 1 COL 11
      883       fi-date-to AT ROW 1 COL 27.5 COLON-ALIGNED WIDGET-ID 2
      884       fi-date-for AT ROW 1 COL 44.63 COLON-ALIGNED WIDGET-ID 10
      885       cb-table AT ROW 1 COL 65.75 COLON-ALIGNED WIDGET-ID 8
      886       bt-doc-hist AT ROW 1 COL 91 WIDGET-ID 4
      887       b-print AT ROW 1 COL 101.5 WIDGET-ID 62
      888       b-help AT ROW 1 COL 102.25 WIDGET-ID 64
      889       br-head AT ROW 2.25 COL 1 WIDGET-ID 200
      890       SPACE(0.74) SKIP(0.37)
      891       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      892       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      893       TITLE "История действий пользователя"
      894       CANCEL-BUTTON b-cancel WIDGET-ID 100.
      895   ASSIGN
      896       FRAME Dialog-Frame:SCROLLABLE = FALSE
      897       FRAME Dialog-Frame:HIDDEN     = TRUE.
      898   ASSIGN
      899       br-head:COLUMN-RESIZABLE IN FRAME Dialog-Frame = TRUE.
      900   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      901       DO:
      902           APPLY "END-ERROR":U TO SELF.
      903       END.
      904   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      905       DO:
      906   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   if lookup(self :type
      908            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      909            ) = 0
      910   then do:
      911     message
      912       "$Workfile$"
      913       "Указанному интерфейсному элементу фокус не может быть передан" skip
      914       "Интерфейсный элемент" self :name  skip
      915       "Тип" self :type  skip
      916       "Процедура" this-procedure :file-name skip
      917       view-as alert-box .
      918   end.
      919   else do:
      920     apply "entry":u to self  .
      921     if focus :handle <> self :handle  then do:
      922       return no-apply .
      923     end.
      924   end.
      925   END.
      926   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      927       DO:
      928           run get-report-num in parParentProc (
      929               output p-report-id
      930               ).
      931           v-report-name-html-list = session:temp-directory + "rpt" + string(p-report-id) + ".html".
      932           run PROC-print-list in this-procedure.
      933       END.
      934   ON VALUE-CHANGED OF br-head IN FRAME Dialog-Frame
      935       DO:
      936       END.
      937   ON CHOOSE OF bt-doc-hist IN FRAME Dialog-Frame
      938       DO:
      939           if available buf_head_c-user-log
      940               then
      941           do:
      942               run str/usrlgd.p (
      943                   input parparentproc
      944                   , input buf_head_c-user-log.head-table
      945                   , input buf_head_c-user-log.head-table-key
      946                   ) .
      947               if error-status :error
      948                   then
      949               do:
      950                   message
      951                       vss-workfile vss-revision vss-description
      952                       skip(1)
      953                       skip
      954                       "Ошибка вызова истории по документу"
      955                       skip return-value
      956                       skip trim( error-status :get-message( 1 ) )
      957                       trim( error-status :get-message( 2 ) )
      958                       trim( error-status :get-message( 3 ) )
      959                       view-as alert-box error.
      960                   undo, return no-apply substitute( "Ошибка вызова истории по документу. &1. &2"
      961                       , return-value
      962                       , trim( error-status :get-message( 1 ) ) ).
      963               end.
      964           end.
      965           run local-open-query-head in this-procedure. .
      966       END.
      967   ON VALUE-CHANGED OF cb-table IN FRAME Dialog-Frame
      968       DO:
      969           assign
      970               v-table   = ""
      971               v-c-table = ""
      972               .
      973           assign
      974               cb-table.
      975           if cb-table = "все" then v-table = "" .
      976           else
      977           do:
      978               find first tt-field no-lock where tt-field.f-name = cb-table no-error .
      979               if AVAILABLE (tt-field) then
      980               do:
      981                   v-table = tt-field.f-table .
      982                   v-c-table = "c-" + tt-field.f-table .
      983               end.
      984           end.
      985           run local-open-query-head in this-procedure. .
      986       END.
      987   ON RETURN OF fi-date-for IN FRAME Dialog-Frame
      988       DO:
      989           assign
      990               fi-date-for
      991               .
      992           run local-open-query-head in this-procedure. .
      993       END.
      994   ON RETURN OF fi-date-to IN FRAME Dialog-Frame
      995       DO:
      996           assign
      997               fi-date-to
      998               .
      999           run local-open-query-head in this-procedure. .
     1000       END.
