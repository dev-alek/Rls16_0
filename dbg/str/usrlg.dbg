     1572     .
     1573   define temp-table temp-browse-handle no-undo
     1574     field browse-type   as character
     1575     field browse-number as integer
     1576     field browse-handle as handle
     1577     field original-size as decimal
     1578     index xpk is primary unique browse-type browse-number
     1579     index xie browse-type browse-handle
     1580   .
     1581   procedure diasize_change-height :
     1582     define input  parameter p-change-value  as decimal   no-undo .
     1583     define input  parameter p-move-resize   as logical   no-undo .
     1584     define variable v-field-group-handle    as handle    no-undo .
     1585     define variable v-object-handle         as handle    no-undo .
     1586     define variable v-frame-height          as decimal   no-undo .
     1587     define variable v-frame-virtual-height  as decimal   no-undo .
     1588     define variable v-browse-height         as decimal   no-undo .
     1589     define variable v-window-height         as decimal   no-undo .
     1590     define variable v-window-virtual-height as decimal   no-undo .
     1591     define variable v-change-sign           as integer   no-undo .
     1592     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1593     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1594     if p-change-value > 0
     1595     then do:
     1596       if frame Dialog-Frame :height + p-change-value
     1597           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1598       then do:
     1599         assign
     1600           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1601                           - (frame Dialog-Frame :height-chars)
     1602         .
     1603         if p-change-value <= 0
     1604         then do:
     1605           run diasize_position-resize-button in this-procedure .
     1606           return .
     1607         end.
     1608       end.
     1609     end.
     1610     if p-change-value < 0
     1611     then do:
     1612       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1613       then do:
     1614         assign
     1615           p-change-value = v-diasize-orig-frame-height
     1616                          - (frame Dialog-Frame :height-chars)
     1617         .
     1618         if p-change-value >= 0
     1619         then do:
     1620           run diasize_position-resize-button in this-procedure .
     1621           return .
     1622         end.
     1623       end.
     1624     end.
     1625     if p-change-value >= 0
     1626     then do:
     1627       assign
     1628         v-change-sign = 1
     1629       .
     1630     end.
     1631     else do:
     1632       assign
     1633         v-change-sign = -1
     1634       .
     1635     end.
     1636     assign
     1637       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1638     .
     1639     if p-change-value = 0
     1640     then do:
     1641       run diasize_position-resize-button in this-procedure .
     1642       return .
     1643     end.
     1644     move_block:
     1645     do
     1646     on error undo move_block, retry move_block
     1647     :
     1648       if retry
     1649       then do:
     1650         do
     1651         on error undo move_block, leave move_block
     1652         :
     1653           if p-change-value > 0
     1654           then do:
     1655             for each buf_temp-diasize-handle
     1656             on error undo, next
     1657             :
     1658               assign
     1659                 v-object-handle = buf_temp-diasize-handle.handle-value
     1660               .
     1661               if v-object-handle <> v-diasize-resize-button
     1662               then do:
     1663                 assign
     1664                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1665                 .
     1666               end.
     1667             end.
     1668             assign
     1669               v-diasize-browse-handle :height = v-browse-height
     1670             .
     1671             for each buf_temp-browse-handle
     1672               where buf_temp-browse-handle.browse-type = 'height':u
     1673             on error undo, next
     1674             :
     1675               assign
     1676                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1677               .
     1678             end.
     1679             assign
     1680               frame Dialog-Frame :height = v-frame-height
     1681             .
     1682             if frame Dialog-Frame :scrollable = true
     1683             then do:
     1684               assign
     1685                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1686               .
     1687             end.
     1688             run diasize_position-resize-button in this-procedure .
     1689           end.
     1690           else do:
     1691             if frame Dialog-Frame :scrollable = true
     1692             then do:
     1693               assign
     1694                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1695               .
     1696             end.
     1697             assign
     1698               frame Dialog-Frame :height = v-frame-height
     1699             .
     1700             assign
     1701               v-diasize-browse-handle :height = v-browse-height
     1702             .
     1703             for each buf_temp-browse-handle
     1704               where buf_temp-browse-handle.browse-type = 'height':u
     1705             on error undo, next
     1706             :
     1707               assign
     1708                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1709               .
     1710             end.
     1711             for each buf_temp-diasize-handle
     1712             on error undo, next
     1713             :
     1714               assign
     1715                 v-object-handle = buf_temp-diasize-handle.handle-value
     1716               .
     1717               if v-object-handle <> v-diasize-resize-button
     1718               then do:
     1719                 assign
     1720                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1721                 .
     1722               end.
     1723             end.
     1724             run diasize_position-resize-button in this-procedure .
     1725           end.
     1726           assign
     1727             v-diasize-change-size = false
     1728           .
     1729           leave move_block .
     1730         end.
     1731       end.
     1732       assign
     1733         v-diasize-need-full-display = true
     1734       .
     1735       if v-diasize-change-size = false
     1736       then do:
     1737         assign
     1738           v-diasize-change-size = true
     1739         .
     1740       end.
     1741       else do:
     1742         return .
     1743       end.
     1744       assign
     1745         v-frame-height = frame Dialog-Frame :height
     1746         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1747         v-browse-height = v-diasize-browse-handle :height
     1748       .
     1749       for each buf_temp-browse-handle
     1750         where buf_temp-browse-handle.browse-type = 'height':u
     1751       :
     1752         assign
     1753           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1754         .
     1755       end.
     1756       for each buf_temp-diasize-handle
     1757       :
     1758         delete buf_temp-diasize-handle .
     1759       end.
     1760       assign
     1761         v-field-group-handle = frame Dialog-Frame :first-child
     1762       .
     1763       do while valid-handle(v-field-group-handle)
     1764       :
     1765         assign
     1766           v-object-handle = v-field-group-handle :first-child
     1767         .
     1768         do while valid-handle(v-object-handle)
     1769         :
     1770           if  v-object-handle <> v-diasize-browse-handle :handle
     1771           and can-query(v-object-handle, "row")
     1772           and can-query(v-object-handle, "height")
     1773           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1774           then do:
     1775             find first buf_temp-browse-handle
     1776               where buf_temp-browse-handle.browse-type   = 'height':u
     1777                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1778               no-error .
     1779             if available buf_temp-browse-handle
     1780             then do:
     1781             end.
     1782             else do:
     1783               create buf_temp-diasize-handle .
     1784               assign
     1785                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1786                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1787               .
     1788             end.
     1789           end.
     1790           assign
     1791             v-object-handle = v-object-handle :next-sibling
     1792           .
     1793         end.
     1794         assign
     1795           v-field-group-handle = v-field-group-handle :next-sibling
     1796         .
     1797       end.
     1798       do with frame Dialog-Frame
     1799       :
     1800         hide v-diasize-resize-button .
     1801         assign
     1802           v-diasize-resize-button :row    = 1
     1803           v-diasize-resize-button :column = 1
     1804         .
     1805       end.
     1806       if p-change-value > 0
     1807       then do:
     1808         if frame Dialog-Frame :scrollable = true
     1809         then do:
     1810           assign
     1811             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1812             no-error .
     1813           if error-status :error
     1814           or error-status :get-message(1) <> ""
     1815           then do:
     1816             undo move_block, retry move_block .
     1817           end.
     1818         end.
     1819         assign
     1820           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1821           no-error .
     1822         if error-status :error
     1823         or error-status :get-message(1) <> ""
     1824         then do:
     1825           undo move_block, retry move_block .
     1826         end.
     1827         assign
     1828           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1829           no-error .
     1830         if error-status :error
     1831         or error-status :get-message(1) <> ""
     1832         then do:
     1833           undo move_block, retry move_block .
     1834         end.
     1835         for each buf_temp-browse-handle
     1836           where buf_temp-browse-handle.browse-type = 'height':u
     1837         on error undo move_block, retry move_block
     1838         :
     1839           assign
     1840             buf_temp-browse-handle.browse-handle :height
     1841               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1842             no-error .
     1843           if error-status :error
     1844           or error-status :get-message(1) <> ""
     1845           then do:
     1846             undo move_block, retry move_block .
     1847           end.
     1848         end.
     1849         for each buf_temp-diasize-handle
     1850         on error undo move_block, retry move_block
     1851         :
     1852           assign
     1853             v-object-handle = buf_temp-diasize-handle.handle-value
     1854           .
     1855           if v-object-handle <> v-diasize-resize-button
     1856           then do:
     1857             assign
     1858               v-object-handle :row = v-object-handle :row + p-change-value
     1859               no-error .
     1860             if error-status :error
     1861             or error-status :get-message(1) <> ""
     1862             then do:
     1863               undo move_block, retry move_block .
     1864             end.
     1865           end.
     1866         end.
     1867       end.
     1868       else do:
     1869         for each buf_temp-diasize-handle
     1870         on error undo move_block, retry move_block
     1871         :
     1872           assign
     1873             v-object-handle = buf_temp-diasize-handle.handle-value
     1874           .
     1875           if v-object-handle <> v-diasize-resize-button
     1876           then do:
     1877             assign
     1878               v-object-handle :row = v-object-handle :row + p-change-value
     1879               no-error .
     1880             if error-status :error
     1881             or error-status :get-message(1) <> ""
     1882             then do:
     1883               undo move_block, retry move_block .
     1884             end.
     1885           end.
     1886         end.
     1887         assign
     1888           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1889           no-error .
     1890         if error-status :error
     1891         or error-status :get-message(1) <> ""
     1892         then do:
     1893           undo move_block, retry move_block .
     1894         end.
     1895         for each buf_temp-browse-handle
     1896           where buf_temp-browse-handle.browse-type = 'height':u
     1897         on error undo move_block, retry move_block
     1898         :
     1899           assign
     1900             buf_temp-browse-handle.browse-handle :height
     1901               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1902             no-error .
     1903           if error-status :error
     1904           or error-status :get-message(1) <> ""
     1905           then do:
     1906             undo move_block, retry move_block .
     1907           end.
     1908         end.
     1909         assign
     1910           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1911           no-error .
     1912         if error-status :error
     1913         or error-status :get-message(1) <> ""
     1914         then do:
     1915           undo move_block, retry move_block .
     1916         end.
     1917         if frame Dialog-Frame :scrollable = true
     1918         then do:
     1919           assign
     1920             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1921             no-error .
     1922           if error-status :error
     1923           or error-status :get-message(1) <> ""
     1924           then do:
     1925             undo move_block, retry move_block .
     1926           end.
     1927         end.
     1928       end.
     1929       if p-move-resize = true
     1930       then do:
     1931         run diasize_position-resize-button in this-procedure .
     1932       end.
     1933       if v-diasize-wndstore = true
     1934       then do:
     1935         if connected("ub") = true
     1936         then do:
     1937           define variable v-cntxt-db-num        as integer   no-undo .
     1938           define variable v-cntxt-userid        as character no-undo .
     1939           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1940                                             , OUTPUT v-cntxt-userid
     1941                                             ) .
     1942           run gbl/wndsizew.p
     1943             (input  v-cntxt-db-num
     1944             ,input  v-cntxt-userid
     1945             ,input  v-diasize-proc-name
     1946             ,input  'height':u
     1947             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1948             ) .
     1949         end.
     1950       end.
     1951     end.
     1952     assign
     1953       v-diasize-change-size = false
     1954     .
     1955   end procedure.
     1956   procedure diasize_set-height :
     1957     define input  parameter p-new-height  as decimal   no-undo .
     1958     define input  parameter p-move-resize as logical   no-undo .
     1959     do
     1960     on error undo, return error return-value
     1961     :
     1962       run diasize_change-height in this-procedure
     1963         (input  (p-new-height - frame Dialog-Frame :height)
     1964         ,input  p-move-resize
     1965         ) .
     1966     end.
     1967   end procedure.
     1968   procedure diasize_change-width :
     1969     define input  parameter p-change-value as decimal   no-undo .
     1970     define input  parameter p-move-resize  as logical   no-undo .
     1971     define variable v-field-group-handle   as handle    no-undo .
     1972     define variable v-object-handle        as handle    no-undo .
     1973     define variable v-frame-width          as decimal   no-undo .
     1974     define variable v-frame-virtual-width  as decimal   no-undo .
     1975     define variable v-browse-width         as decimal   no-undo .
     1976     define variable v-window-width         as decimal   no-undo .
     1977     define variable v-window-virtual-width as decimal   no-undo .
     1978     define variable v-change-sign          as integer   no-undo .
     1979     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1980     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1981     if p-change-value > 0
     1982     then do:
     1983       if frame Dialog-Frame :width + p-change-value >
     1984           session :width-chars
     1985       then do:
     1986         assign
     1987           p-change-value = session :width-chars - frame Dialog-Frame :width
     1988         .
     1989         if p-change-value <= 0
     1990         then do:
     1991           run diasize_position-resize-button in this-procedure .
     1992           return .
     1993         end.
     1994       end.
     1995     end.
     1996     if p-change-value < 0
     1997     then do:
     1998       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1999       then do:
     2000         assign
     2001           p-change-value = v-diasize-orig-frame-width
     2002                          - frame Dialog-Frame :width
     2003         .
     2004         if p-change-value >= 0
     2005         then do:
     2006           run diasize_position-resize-button in this-procedure .
     2007           return .
     2008         end.
     2009       end.
     2010     end.
     2011     if p-change-value >= 0
     2012     then do:
     2013       assign
     2014         v-change-sign = 1
     2015       .
     2016     end.
     2017     else do:
     2018       assign
     2019         v-change-sign = -1
     2020       .
     2021     end.
     2022     assign
     2023       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2024     .
     2025     if p-change-value = 0
     2026     then do:
     2027       run diasize_position-resize-button in this-procedure .
     2028       return .
     2029     end.
     2030     move_block:
     2031     do
     2032     on error undo move_block, leave move_block
     2033     :
     2034       if retry
     2035       then do:
     2036         do
     2037         on error undo move_block, leave move_block
     2038         :
     2039           if p-change-value > 0
     2040           then do:
     2041             for each buf_temp-diasize-handle
     2042             on error undo, next
     2043             :
     2044               assign
     2045                 v-object-handle = buf_temp-diasize-handle.handle-value
     2046               .
     2047               if v-object-handle <> v-diasize-resize-button
     2048               then do:
     2049                 assign
     2050                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2051                 .
     2052               end.
     2053             end.
     2054             assign
     2055               v-diasize-browse-handle :width = v-browse-width
     2056             .
     2057             for each buf_temp-browse-handle
     2058               where buf_temp-browse-handle.browse-type = 'width':u
     2059             on error undo, next
     2060             :
     2061               assign
     2062                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2063               .
     2064             end.
     2065             assign
     2066               frame Dialog-Frame :width = v-frame-width
     2067             .
     2068             if frame Dialog-Frame :scrollable = true
     2069             then do:
     2070               assign
     2071                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2072               .
     2073             end.
     2074             run diasize_position-resize-button in this-procedure .
     2075           end.
     2076           else do:
     2077             if frame Dialog-Frame :scrollable = true
     2078             then do:
     2079               assign
     2080                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2081               .
     2082             end.
     2083             assign
     2084               frame Dialog-Frame :width = v-frame-width
     2085             .
     2086             for each buf_temp-browse-handle
     2087               where buf_temp-browse-handle.browse-type = 'width':u
     2088             on error undo, next
     2089             :
     2090               assign
     2091                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2092               .
     2093             end.
     2094             assign
     2095               v-diasize-browse-handle :width = v-browse-width
     2096             .
     2097             for each buf_temp-diasize-handle
     2098             on error undo, next
     2099             :
     2100               assign
     2101                 v-object-handle = buf_temp-diasize-handle.handle-value
     2102               .
     2103               if v-object-handle <> v-diasize-resize-button
     2104               then do:
     2105                 assign
     2106                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2107                 .
     2108               end.
     2109             end.
     2110             run diasize_position-resize-button in this-procedure .
     2111           end.
     2112           assign
     2113             v-diasize-change-size = false
     2114           .
     2115           leave move_block .
     2116         end.
     2117       end.
     2118       assign
     2119         v-diasize-need-full-display = true
     2120       .
     2121       if v-diasize-change-size = false
     2122       then do:
     2123         assign
     2124           v-diasize-change-size = true
     2125         .
     2126       end.
     2127       else do:
     2128         return .
     2129       end.
     2130       assign
     2131         v-frame-width = frame Dialog-Frame :width
     2132         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2133         v-browse-width = v-diasize-browse-handle :width
     2134       .
     2135       for each buf_temp-browse-handle
     2136         where buf_temp-browse-handle.browse-type = 'width':u
     2137       :
     2138         assign
     2139           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2140         .
     2141       end.
     2142       for each buf_temp-diasize-handle
     2143       :
     2144         delete buf_temp-diasize-handle .
     2145       end.
     2146       assign
     2147         v-field-group-handle = frame Dialog-Frame :first-child
     2148       .
     2149       do while valid-handle(v-field-group-handle)
     2150       :
     2151         assign
     2152           v-object-handle = v-field-group-handle :first-child
     2153         .
     2154         do while valid-handle(v-object-handle)
     2155         :
     2156           if  v-object-handle <> v-diasize-browse-handle :handle
     2157           and v-object-handle <> v-diasize-resize-button
     2158           and can-query(v-object-handle, "row")
     2159           and can-query(v-object-handle, "height")
     2160           and ( v-object-handle :col + v-object-handle :width
     2161                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2162               )
     2163           then do:
     2164             find first buf_temp-browse-handle
     2165               where buf_temp-browse-handle.browse-type   = 'width':u
     2166                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2167               no-error .
     2168             if available buf_temp-browse-handle
     2169             then do:
     2170             end.
     2171             else do:
     2172               create buf_temp-diasize-handle .
     2173               assign
     2174                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2175                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2176               .
     2177             end.
     2178           end.
     2179           assign
     2180             v-object-handle = v-object-handle :next-sibling
     2181           .
     2182         end.
     2183         assign
     2184           v-field-group-handle = v-field-group-handle :next-sibling
     2185         .
     2186       end.
     2187       do with frame Dialog-Frame
     2188       :
     2189         hide v-diasize-resize-button .
     2190         v-diasize-resize-button :row = 1.
     2191         v-diasize-resize-button :column = 1.
     2192       end.
     2193       if p-change-value > 0
     2194       then do:
     2195         if frame Dialog-Frame :scrollable = true
     2196         then do:
     2197           assign
     2198             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2199             no-error .
     2200           if error-status :error
     2201           or error-status :get-message(1) <> ""
     2202           then do:
     2203             undo move_block, retry move_block.
     2204           end.
     2205         end.
     2206         assign
     2207           frame Dialog-Frame :width = v-frame-width + p-change-value
     2208           no-error .
     2209         if error-status :error
     2210         or error-status :get-message(1) <> ""
     2211         then do:
     2212           undo move_block, retry move_block.
     2213         end.
     2214         assign
     2215           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2216         no-error .
     2217         if error-status :error
     2218         or error-status :get-message(1) <> ""
     2219         then do:
     2220           undo move_block, retry move_block.
     2221         end.
     2222         for each buf_temp-browse-handle
     2223           where buf_temp-browse-handle.browse-type = 'width':u
     2224         on error undo move_block, retry move_block
     2225         :
     2226           assign
     2227             buf_temp-browse-handle.browse-handle :width
     2228               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2229             no-error .
     2230           if error-status :error
     2231           or error-status :get-message(1) <> ""
     2232           then do:
     2233             undo move_block, retry move_block .
     2234           end.
     2235         end.
     2236         for each buf_temp-diasize-handle
     2237         on error undo move_block, retry move_block
     2238         :
     2239           assign
     2240             v-object-handle = buf_temp-diasize-handle.handle-value
     2241           .
     2242           if v-object-handle <> v-diasize-resize-button
     2243           then do:
     2244             assign
     2245               v-object-handle :col = v-object-handle :col + p-change-value
     2246               no-error .
     2247             if error-status :error
     2248             or error-status :get-message(1) <> ""
     2249             then do:
     2250               undo move_block, retry move_block .
     2251             end.
     2252           end.
     2253         end.
     2254       end.
     2255       else do:
     2256         for each buf_temp-diasize-handle
     2257         on error undo move_block, retry move_block
     2258         :
     2259           assign
     2260             v-object-handle = buf_temp-diasize-handle.handle-value
     2261           .
     2262           if v-object-handle <> v-diasize-resize-button
     2263           then do:
     2264             assign
     2265               v-object-handle :col = v-object-handle :col + p-change-value
     2266               no-error .
     2267             if error-status :error
     2268             or error-status :get-message(1) <> ""
     2269             then do:
     2270               undo move_block, retry move_block .
     2271             end.
     2272           end.
     2273         end.
     2274         for each buf_temp-browse-handle
     2275           where buf_temp-browse-handle.browse-type = 'width':u
     2276         on error undo move_block, retry move_block
     2277         :
     2278           assign
     2279             buf_temp-browse-handle.browse-handle :width
     2280               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2281             no-error .
     2282           if error-status :error
     2283           or error-status :get-message(1) <> ""
     2284           then do:
     2285             undo move_block, retry move_block .
     2286           end.
     2287         end.
     2288         assign
     2289           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2290           no-error .
     2291         if error-status :error
     2292         or error-status :get-message(1) <> ""
     2293         then do:
     2294           undo move_block, retry move_block.
     2295         end.
     2296         assign
     2297           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2298         no-error .
     2299         if error-status :error
     2300         or error-status :get-message(1) <> ""
     2301         then do:
     2302           undo move_block, retry move_block.
     2303         end.
     2304         if frame Dialog-Frame :scrollable = true
     2305         then do:
     2306           assign
     2307             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2308           no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block.
     2313           end.
     2314         end.
     2315       end.
     2316       if p-move-resize
     2317       then do:
     2318         run diasize_position-resize-button in this-procedure .
     2319       end.
     2320       if v-diasize-wndstore = true
     2321       then do:
     2322         if connected("ub") = true
     2323         then do:
     2324           define variable v-cntxt-db-num        as integer   no-undo .
     2325           define variable v-cntxt-userid        as character no-undo .
     2326           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2327                                             , OUTPUT v-cntxt-userid
     2328                                             ) .
     2329           run gbl/wndsizew.p
     2330             (input  v-cntxt-db-num
     2331             ,input  v-cntxt-userid
     2332             ,input  v-diasize-proc-name
     2333             ,input  'width':u
     2334             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2335             ) .
     2336         end.
     2337       end.
     2338     end.
     2339     assign
     2340       v-diasize-change-size = false
     2341     .
     2342   end procedure.
     2343   procedure diasize_set-width :
     2344     define input  parameter p-new-width  as decimal   no-undo .
     2345     define input  parameter p-move-resize as logical   no-undo .
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       run diasize_change-width in this-procedure
     2350         (input  (p-new-width - frame Dialog-Frame :width)
     2351         ,input  p-move-resize
     2352         ) .
     2353     end.
     2354   end procedure.
     2355   procedure diasize_position-resize-button :
     2356     do with frame Dialog-Frame
     2357     :
     2358       hide v-diasize-resize-button .
     2359       assign
     2360         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2361                     - 1
     2362                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2363         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2364                     - 1
     2365                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2366       .
     2367       view v-diasize-resize-button .
     2368     end.
     2369   end procedure.
     2370   on alt-right anywhere
     2371   do:
     2372     run diasize_change-width in this-procedure
     2373       (input 1
     2374       ,input true
     2375       ) .
     2376     return no-apply .
     2377   end.
     2378   on alt-left anywhere
     2379   do:
     2380     run diasize_change-width in this-procedure
     2381       (input -1
     2382       ,input true
     2383       ) .
     2384     return no-apply .
     2385   end.
     2386   on alt-down anywhere
     2387   do:
     2388     run diasize_change-height in this-procedure
     2389       (input 1
     2390       ,input true
     2391       ) .
     2392     return no-apply .
     2393   end.
     2394   on alt-up anywhere
     2395   do:
     2396     run diasize_change-height in this-procedure
     2397       (input -1
     2398       ,input true
     2399       ) .
     2400     return no-apply .
     2401   end.
     2402   on alt-enter of frame Dialog-Frame
     2403   do:
     2404     run diasize_maximize in this-procedure
     2405       (input  ?
     2406       ).
     2407     return no-apply .
     2408   end.
     2409   procedure diasize_end-move :
     2410     do
     2411     on error undo, return error return-value
     2412     :
     2413       define variable v-row-delta as decimal   no-undo .
     2414       define variable v-col-delta as decimal   no-undo .
     2415       define variable v-new-row as decimal   no-undo .
     2416       define variable v-new-col as decimal   no-undo .
     2417       assign
     2418         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2419         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2420       .
     2421       assign
     2422         v-row-delta = v-new-row - frame Dialog-Frame :height
     2423         v-col-delta = v-new-col - frame Dialog-Frame :width
     2424       .
     2425       run diasize_change-height in this-procedure
     2426         (input v-row-delta
     2427         ,input true
     2428         ) .
     2429       run diasize_change-width in this-procedure
     2430         (input v-col-delta
     2431         ,input true
     2432         ) .
     2433     end.
     2434   end procedure.
     2435   procedure diasize_maximize :
     2436     define input  parameter p-action as logical   no-undo .
     2437     do
     2438     on error undo, return error return-value
     2439     :
     2440       if p-action = ?
     2441       then do:
     2442         if v-diasize-need-maximize = true
     2443         then do:
     2444           assign
     2445             p-action = true
     2446           .
     2447         end.
     2448         else do:
     2449           assign
     2450             p-action = false
     2451           .
     2452         end.
     2453       end.
     2454       if p-action = true
     2455       then do:
     2456         run diasize_change-height in this-procedure
     2457           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2458               - frame Dialog-Frame :height-chars
     2459           ,input true
     2460           ) .
     2461         run diasize_change-width in this-procedure
     2462           (input session :width-chars
     2463               - frame Dialog-Frame :width-chars
     2464           ,input true
     2465           ) .
     2466         assign
     2467           v-diasize-need-maximize = false
     2468         .
     2469       end.
     2470       else do:
     2471         run diasize_change-width in this-procedure
     2472           (input v-diasize-orig-frame-width
     2473               - frame Dialog-Frame :width-chars
     2474           ,input true
     2475           ) .
     2476         run diasize_change-height in this-procedure
     2477           (input v-diasize-orig-frame-height
     2478               - frame Dialog-Frame :height-chars
     2479           ,input true
     2480           ) .
     2481         assign
     2482           v-diasize-need-maximize = true
     2483         .
     2484       end.
     2485     end.
     2486   end procedure.
     2487   procedure diasize_restore-orig-size :
     2488     do
     2489     on error undo, return error return-value
     2490     :
     2491       assign
     2492         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2493         v-diasize-current-frame-height = frame Dialog-Frame :height
     2494       .
     2495       run diasize_set-height in this-procedure
     2496         (input  v-diasize-orig-frame-height
     2497         ,input  true
     2498         ) .
     2499       run diasize_set-width in this-procedure
     2500         (input  v-diasize-orig-frame-width
     2501         ,input  true
     2502         ) .
     2503     end.
     2504   end procedure.
     2505   procedure diasize_restore-current-size :
     2506     do
     2507     on error undo, return error return-value
     2508     :
     2509       run diasize_set-height in this-procedure
     2510         (input  v-diasize-current-frame-height
     2511         ,input  true
     2512         ) .
     2513       run diasize_set-width in this-procedure
     2514         (input  v-diasize-current-frame-width
     2515         ,input  true
     2516         ) .
     2517     end.
     2518   end procedure.
     2519   procedure diasize_set-browse-handle :
     2520     define input  parameter p-browse-handle as handle   no-undo .
     2521     define buffer buf_temp-browse-handle for temp-browse-handle .
     2522     do
     2523     on error undo, return error return-value
     2524     :
     2525       assign
     2526         v-diasize-browse-handle = p-browse-handle
     2527       .
     2528       for each buf_temp-browse-handle
     2529       on error undo, return error return-value
     2530       :
     2531         delete buf_temp-browse-handle .
     2532       end.
     2533     end.
     2534   end procedure.
     2535   procedure diasize_add_browse :
     2536     define input  parameter p-browse-type   as character no-undo .
     2537     define input  parameter p-browse-handle as handle    no-undo .
     2538     define buffer buf_temp-browse-handle for temp-browse-handle .
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542       assign
     2543         v-diasize-browse-number = v-diasize-browse-number + 1
     2544       .
     2545       create buf_temp-browse-handle .
     2546       assign
     2547         buf_temp-browse-handle.browse-type   = p-browse-type
     2548         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2549         buf_temp-browse-handle.browse-handle = p-browse-handle
     2550       .
     2551     end.
     2552   end procedure.
     2553   procedure diasize_init :
     2554     define variable v-default-value    as logical   no-undo .
     2555     define variable v-restore-saved    as logical   no-undo .
     2556     define variable v-resize-value-str as character no-undo .
     2557     do
     2558     on error undo, return error return-value
     2559     :
     2560       do with frame Dialog-Frame
     2561       :
     2562         assign
     2563           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2564           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2565           v-diasize-browse-handle     = browse br-head :handle
     2566         .
     2567         create button v-diasize-resize-button
     2568         assign
     2569           parent        = frame Dialog-Frame :first-child
     2570           label         = "s"
     2571           height-pixels = 16
     2572           width-pixels  = 16
     2573           visible       = true
     2574           sensitive     = true
     2575           movable       = true
     2576           triggers:
     2577             on end-move persistent run diasize_end-move in this-procedure .
     2578           end triggers.
     2579         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2580         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2581         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2582         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2583         assign
     2584           v-diasize-wndmax = false
     2585         .
     2586         if connected("ub") = true
     2587         then do:
     2588           define variable v-cntxt-db-num        as integer   no-undo .
     2589           define variable v-cntxt-userid        as character no-undo .
     2590           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2591                                             , OUTPUT v-cntxt-userid
     2592                                             ) .
     2593           run gbl/wndpar_r.p
     2594             (input  v-cntxt-db-num
     2595             ,input  v-cntxt-userid
     2596             ,input  'wndmax':U
     2597             ,output v-diasize-wndmax
     2598             ,output v-default-value
     2599             ) .
     2600         end.
     2601         assign
     2602           v-diasize-wndstore = false
     2603         .
     2604         if connected("ub") = true
     2605         then do:
     2606           run gbl/wndpar_r.p
     2607             (input  v-cntxt-db-num
     2608             ,input  v-cntxt-userid
     2609             ,input  'wndstore':U
     2610             ,output v-diasize-wndstore
     2611             ,output v-default-value
     2612             ) .
     2613         end.
     2614         assign
     2615           v-diasize-proc-name = entry(1, program-name(2), '.')
     2616         .
     2617         if v-diasize-wndstore = true
     2618         then do:
     2619           assign
     2620             v-restore-saved = false
     2621           .
     2622           if connected("ub") = true
     2623           then do:
     2624             run gbl/wndsizer.p
     2625               (input  v-cntxt-db-num
     2626               ,input  v-cntxt-userid
     2627               ,input  v-diasize-proc-name
     2628               ,input  'height':u
     2629               ,output v-resize-value-str
     2630               ) .
     2631             if v-resize-value-str <> '':U
     2632             then do:
     2633               run diasize_change-height in this-procedure
     2634                 (input  integer(v-resize-value-str)
     2635                 ,input  true
     2636                 ) .
     2637               assign
     2638                 v-restore-saved = true
     2639               .
     2640             end.
     2641           end.
     2642           if connected("ub") = true
     2643           then do:
     2644             run gbl/wndsizer.p
     2645               (input  v-cntxt-db-num
     2646               ,input  v-cntxt-userid
     2647               ,input  v-diasize-proc-name
     2648               ,input  'width':u
     2649               ,output v-resize-value-str
     2650               ) .
     2651             if v-resize-value-str <> '':U
     2652             then do:
     2653               run diasize_change-width in this-procedure
     2654                 (input  integer(v-resize-value-str)
     2655                 ,input  true
     2656                 ) .
     2657               assign
     2658                 v-restore-saved = true
     2659               .
     2660             end.
     2661           end.
     2662           if v-restore-saved <> true
     2663           then do:
     2664             if v-diasize-wndmax = true
     2665             then do:
     2666               run diasize_maximize in this-procedure
     2667                 (input  true
     2668                 ) .
     2669             end.
     2670           end.
     2671         end.
     2672         else do:
     2673           if v-diasize-wndmax = true
     2674           then do:
     2675             run diasize_maximize in this-procedure
     2676               (input  true
     2677               ) .
     2678           end.
     2679         end.
     2680       end.
     2681     end.
     2682   end procedure.
     2683   procedure diasize_need-full-display :
     2684     define output parameter p-need-full-display as logical   no-undo .
     2685     do
     2686     on error undo, return error return-value
     2687     :
     2688       assign
     2689         p-need-full-display = v-diasize-need-full-display
     2690       .
     2691       assign
     2692         v-diasize-need-full-display = false
     2693       .
     2694     end.
     2695   end procedure.
     2696   procedure get-context :
     2697      define output parameter p-db-num as integer          no-undo.
     2698      define output parameter p-user-id as character        no-undo.
     2699      define variable v-login               as character    no-undo.
     2700      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2701      define buffer buf_user-login  for ub.user-login .
     2702      do
     2703      on error undo, return error
     2704      :
     2705            FIND FIRST buf_sys-ctrl no-lock.
     2706            ASSIGN
     2707               v-login = USERID("ub")
     2708               p-db-num = buf_sys-ctrl.db-num
     2709            .
     2710            FIND FIRST buf_user-login
     2711                 WHERE buf_user-login.db-num = p-db-num
     2712                   AND buf_user-login.user-login = v-login
     2713                 no-lock
     2714                 no-error
     2715                 .
     2716            IF AVAILABLE buf_user-login
     2717            THEN DO:
     2718               assign
     2719                  p-user-id = buf_user-login.user-id
     2720               .
     2721            END.
     2722      end.
     2723   end procedure.
     2724       run diasize_init in this-procedure .
     2725   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2726       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2727   MAIN-BLOCK:
     2728   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2729       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2730       run init-fields in this-procedure .
     2731       RUN enable_UI.
     2732       WAIT-FOR GO OF FRAME Dialog-Frame.
     2733   END.
     2734   RUN disable_UI.
     2735   PROCEDURE disable_UI :
     2736       HIDE FRAME Dialog-Frame.
     2737   END PROCEDURE.
     2738   PROCEDURE enable_UI :
     2739       DISPLAY fi-date-to fi-date-for cb-table
     2740           WITH FRAME Dialog-Frame.
     2741       ENABLE b-exit b-cancel fi-date-to fi-date-for cb-table bt-doc-hist b-print
     2742           b-help br-head
     2743           WITH FRAME Dialog-Frame.
     2744       VIEW FRAME Dialog-Frame.
     2745       run local-open-query-head in this-procedure. .
     2746   END PROCEDURE.
     2747   PROCEDURE get-unique-key-proc :
     2748       DEFINE INPUT  PARAMETER p-unique-key-rec    AS CHARACTER   NO-UNDO.
     2749       DEFINE OUTPUT PARAMETER p-unique-key-string AS CHARACTER   NO-UNDO.
     2750       define variable v-field-list        as character    no-undo.
     2751       define variable v-field-value-list  as character    no-undo.
     2752   do
     2753   on error undo, return error
     2754   :
     2755       run gen-key-fv in this-procedure (
     2756             input p-unique-key-rec
     2757           , output v-field-list
     2758           , output v-field-value-list
     2759       ) no-error.
     2760       if error-status:error
     2761       then
     2762          assign
     2763             p-unique-key-rec = substring (p-unique-key-rec, index(p-unique-key-rec,chr(3)) + 1 )
     2764             p-unique-key-string = replace( p-unique-key-rec, chr(3), ",":U )
     2765          .
     2766       else
     2767          assign
     2768              p-unique-key-string = replace( v-field-value-list, chr(3), ",":U )
     2769          .
     2770   end.
     2771   END PROCEDURE.
     2772   PROCEDURE init-fields :
     2773       do
     2774           with frame Dialog-Frame
     2775           on error undo, return error
     2776           :
     2777           define VARIABLE v-head-table as character no-undo .
     2778           if fi-date-for = ? then fi-date-for = today .
     2779           if fi-date-to = ? then fi-date-to = today - 30 .
     2780           define BUFFER bf_c-user-log for ub.c-user-log .
     2781           define variable v-user-table-name as character no-undo .
     2782           define variable v-user-table      as character no-undo .
     2783           define variable v-table           as character no-undo .
     2784           for each bf_c-user-log no-lock where bf_c-user-log.corr-date > fi-date-to  and bf_c-user-log.corr-date <= fi-date-for and bf_c-user-log.corr-user-name = p-userid by bf_c-user-log.head-table :
     2785               v-table = bf_c-user-log.head-table .
     2786               if v-table begins "c-" and v-table <> 'c-usr-hist':U and v-table <> 'c-plc-hist':U then
     2787               do:
     2788                   v-user-table = replace(v-table,"c-","").
     2789               end.
     2790               else v-user-table = v-table .
     2791               find first tt-field where tt-field.f-table = v-user-table no-error .
     2792               if not AVAILABLE (tt-field) then
     2793               do:
     2794   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     2796     (input  v-user-table
     2797     ,output v-user-table-name
     2798     )  .
     2799                   create tt-field .
     2800                   assign
     2801                       tt-field.f-table = v-user-table
     2802                       tt-field.f-name  = v-user-table-name
     2803                       .
     2804               end.
     2805           end.
     2806           cb-table:LIST-ITEMS = "ВСЕ" .
     2807           for each tt-field NO-LOCK by tt-field.f-name:
     2808               assign
     2809                   cb-table :list-items = substitute( "&2&1&3"
     2810                                          , ","
     2811                                          , cb-table :list-items
     2812                                          , tt-field.f-name
     2813                                                      )
     2814                   .
     2815           end.
     2816       end.
     2817   END PROCEDURE.
     2818   PROCEDURE local-open-query-head :
     2819       do
     2820           on error undo, return error
     2821           :
     2822   if v-c-table eq "c-usr-hist"
     2823   then
     2824       OPEN QUERY br-head
     2825         FOR EACH buf_head_c-user-log NO-LOCK
     2826            where buf_head_c-user-log.corr-user-name = p-userid
     2827              and buf_head_c-user-log.corr-date     >= ( if fi-date-to  = ? then 12/31/2000 else fi-date-to )
     2828              and buf_head_c-user-log.corr-date     <= ( if fi-date-for = ? then 12/31/3000 else fi-date-for )
     2829              and (buf_head_c-user-log.head-table = v-c-table or buf_head_c-user-log.head-table = v-table)
     2830         by buf_head_c-user-log.corr-date descending
     2831         by buf_head_c-user-log.corr-time descending
     2832       INDEXED-REPOSITION.
     2833   else
     2834           if v-table <> "" or v-c-table <> "" then
     2835           do:
     2836               OPEN QUERY br-head
     2837                   FOR EACH buf_head_c-user-log NO-LOCK
     2838                   where buf_head_c-user-log.corr-user-name = p-userid
     2839                   and buf_head_c-user-log.corr-date     >= ( if fi-date-to = ? then today - 30 else fi-date-to )
     2840                   and buf_head_c-user-log.corr-date <= (if fi-date-for = ? then today else fi-date-for)
     2841                   and buf_head_c-user-log.head-table-key = buf_head_c-user-log.uniq-key-rec
     2842                   and (buf_head_c-user-log.head-table = v-c-table or buf_head_c-user-log.head-table = v-table)
     2843                   by buf_head_c-user-log.corr-date descending
     2844                   by buf_head_c-user-log.corr-time descending
     2845                   INDEXED-REPOSITION.
     2846           end.
     2847           else
     2848           do:
     2849               OPEN QUERY br-head
     2850                   FOR EACH buf_head_c-user-log NO-LOCK
     2851                   where buf_head_c-user-log.corr-user-name = p-userid
     2852                   and buf_head_c-user-log.corr-date     >= ( if fi-date-to = ? then today - 30 else fi-date-to )
     2853                   and buf_head_c-user-log.corr-date <= (if fi-date-for = ? then today else fi-date-for)
     2854                   and buf_head_c-user-log.head-table-key = buf_head_c-user-log.uniq-key-rec
     2855                   by buf_head_c-user-log.corr-date descending
     2856                   by buf_head_c-user-log.corr-time descending
     2857                   INDEXED-REPOSITION.
     2858           end.
     2859       end.
     2860   END PROCEDURE.
     2861   PROCEDURE proc-print-list :
     2862       define buffer buf_c-user-log for ub.c-user-log .
     2863       do
     2864           on error undo, return error
     2865           :
     2866           output stream OutStr-html to value(v-report-name-html-list) convert target 'UTF-8'.
     2867           put stream OutStr-html unformatted
     2868               "<!DOCTYPE HTML>" skip
     2869               ' <html>' skip
     2870               '  <head>' skip
     2871               '   <meta charset="utf-8">' skip
     2872               '    <style type="text/css">' skip
     2873               '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2874               '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2875               '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     2876               '   </style>' skip
     2877               '  </head>' skip
     2878               .
     2879           put stream OutStr-html unformatted
     2880               '<body>' skip
     2881               '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     2882               '<thead>' skip
     2883               .
     2884           put stream OutStr-html unformatted
     2885               '<tr>' skip
     2886               '<td style="width: 150px;"></td>' skip
     2887               '<td style="width: 150px;"></td>' skip
     2888               '<td style="width: 150px;"></td>' skip
     2889               '<td style="width: 180px;"></td>' skip
     2890               '<td style="width: 180px;"></td>' skip
     2891               '</tr>' skip
     2892               .
     2893           put stream OutStr-html unformatted
     2894               '<tr>' skip
     2895               '<td colspan="5" style="text-align: center;">История действий пользователя за период с ' + string(fi-date-to,"99.99.99") + ' по ' + string(fi-date-for,"99.99.99") + ' </td>' skip
     2896               '</tr>' skip
     2897               '</thead>' skip .
     2898           put stream OutStr-html unformatted
     2899               '<tbody>' skip
     2900               '<TR>' skip
     2901               '<TD text_wrap="true" style="text-align: center;">Дата</TD>' skip
     2902               '<TD text_wrap="true" style="text-align: center;">Время</TD>' skip
     2903               '<TD text_wrap="true" style="text-align: center;">Описание</TD>' skip
     2904               '<TD text_wrap="true" style="text-align: center;">Объект</TD>' skip
     2905               '<TD text_wrap="true" style="text-align: center;">Информация</TD>' skip
     2906               '</TR>'skip
     2907               .
     2908           if v-table <> "" or v-c-table <> "" then
     2909           do:
     2910               FOR EACH buf_c-user-log NO-LOCK
     2911                   where buf_c-user-log.corr-user-name = p-userid
     2912                   and buf_c-user-log.corr-date     >= ( if fi-date-to = ? then today - 30 else fi-date-to )
     2913                   and buf_c-user-log.corr-date <= (if fi-date-for = ? then today else fi-date-for)
     2914                   and buf_c-user-log.head-table-key = buf_c-user-log.uniq-key-rec
     2915                   and (buf_c-user-log.head-table = v-c-table or buf_c-user-log.head-table = v-table)
     2916                   by buf_c-user-log.corr-date descending
     2917                   by buf_c-user-log.corr-time descending:
     2918                   put stream OutStr-html unformatted
     2919                       '<TR>' skip
     2920                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.corr-date,"99.99.9999") + '</TD>' skip
     2921                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.corr-time,"hh:mm:ss") + '</TD>' skip
     2922                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.des) + '</TD>' skip
     2923                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.head-table) + '</TD>' skip
     2924                       '<TD text_wrap="true" style="text-align: center;">' + STRING (buf_c-user-log.uniq-key-rec) + '</TD>' skip
     2925                       '</TR>'skip
     2926                       .
     2927               end.
     2928           end.
     2929           else
     2930           do:
     2931               FOR EACH buf_c-user-log NO-LOCK
     2932                   where buf_c-user-log.corr-user-name = p-userid
     2933                   and buf_c-user-log.corr-date     >= ( if fi-date-to = ? then today - 30 else fi-date-to )
     2934                   and buf_c-user-log.corr-date <= (if fi-date-for = ? then today else fi-date-for)
     2935                   and buf_c-user-log.head-table-key = buf_c-user-log.uniq-key-rec
     2936                   by buf_c-user-log.corr-date descending
     2937                   by buf_c-user-log.corr-time descending:
     2938                   put stream OutStr-html unformatted
     2939                       '<TR>' skip
     2940                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.corr-date,"99.99.9999") + '</TD>' skip
     2941                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.corr-time,"hh:mm:ss") + '</TD>' skip
     2942                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.des) + '</TD>' skip
     2943                       '<TD text_wrap="true" style="text-align: center;">' + string(buf_c-user-log.head-table) + '</TD>' skip
     2944                       '<TD text_wrap="true" style="text-align: center;">' + STRING (buf_c-user-log.uniq-key-rec) + '</TD>' skip
     2945                       '</TR>'skip
     2946                       .
     2947               end.
     2948           end.
     2949           output stream OutStr-html close.
     2950           run prn-lib-reportviewer-report-name in this-procedure (
     2951               input parParentProc
     2952               ,input v-report-name-html-list
     2953               ).
     2954       end.
     2955   END PROCEDURE.
     2956   FUNCTION get-unique-key RETURNS CHARACTER
     2957       ( p-head-table as character,
     2958         p-unique-key-rec as character ) :
     2959       DEFINE variable v-unique-key-string AS CHARACTER NO-UNDO.
     2960       if p-unique-key-rec begins 'report':U
     2961           or p-unique-key-rec begins 'utl':U
     2962           or p-head-table begins 'run-proc':U
     2963           or p-head-table begins 'run_proc':U
     2964           or p-head-table begins 'sysadm-pwd':U
     2965           or p-head-table begins 'one-pwd':U
     2966           or p-head-table begins 'MEASURER_PAR':U
     2967           or p-head-table begins 'atd-alarm-sched':U
     2968           or p-unique-key-rec begins 'prtdoc:':U  then return p-unique-key-rec.
     2969       run get-unique-key-proc in this-procedure (
     2970           input p-unique-key-rec
     2971           , output v-unique-key-string
     2972           ).
     2973       RETURN v-unique-key-string.
     2974   END FUNCTION.
