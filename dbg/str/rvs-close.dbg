       78     define output parameter p-user-can-edit  as logical   no-undo .
       79     define output parameter p-output-display as logical   no-undo .
       80     define output parameter p-other          as character no-undo .
       81     do
       82     on error undo, return error
       83     :
       84           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
       85         (input  p-code
