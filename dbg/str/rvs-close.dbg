      669   procedure placelib_write-attr:
      670   define input  parameter p-code     like ub.place-attr.attr-code .
      671   define input  parameter p-obj-code like ub.place-attr.obj-code .
      672   define input  parameter p-obj-type like ub.place-attr.obj-type .
      673   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      674   define input  parameter p-value    like ub.place-attr.attr-value .
      675   define output parameter p-ok       as logical.
      676   define buffer buf_place-attr for ub.place-attr .
      677     do on error undo, return error return-value :
      678        p-ok = false.
      679        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      680                                                   and buf_place-attr.obj-code    = p-obj-code
      681                                                   and buf_place-attr.obj-type    = p-obj-type
      682                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      683        if not available buf_place-attr then do :
      684           create buf_place-attr.
      685           assign
      686             buf_place-attr.attr-code   = p-code
      687             buf_place-attr.attr-value  = p-value
      688             buf_place-attr.obj-code    = p-obj-code
      689             buf_place-attr.obj-type    = p-obj-type
      690             buf_place-attr.pl-code     = p-pl-code
      691           .
      692           p-ok = true.
      693        end.
      694        else do:
      695           buf_place-attr.attr-value  = p-value .
      696           p-ok = true.
      697        end.
      698     end.
      699   end.
      700   procedure placelib_get-attr:
      701   define input  parameter  p-code     like ub.place-attr.attr-code .
      702   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      703   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      704   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      705   define output parameter  p-value    like ub.place-attr.attr-value .
      706   define output parameter  p-ok       as logical.
      707   define buffer buf_place-attr for ub.place-attr .
      708     do on error undo, return error return-value :
      709        p-ok = false.
      710        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      711                                                   and buf_place-attr.obj-code    = p-obj-code
      712                                                   and buf_place-attr.obj-type    = p-obj-type
      713                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      714        if available buf_place-attr then do :
      715          p-value = buf_place-attr.attr-value.
      716          p-ok = true.
      717        end.
      718        else do :
      719          p-ok = false.
      720        end.
      721     end.
      722   end.
      723   procedure placelib_del-attr:
      724   define input parameter  p-code     like ub.place-attr.attr-code .
      725   define input parameter  p-obj-code like ub.place-attr.obj-code .
      726   define input parameter  p-obj-type like ub.place-attr.obj-type .
      727   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      728   define input parameter  p-value    like ub.place-attr.attr-value .
      729   define output parameter p-ok       as logical.
      730   define buffer buf_place-attr for ub.place-attr .
      731     do on error undo, return error return-value :
      732        p-ok = false.
      733        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      734                                                   and buf_place-attr.obj-code    = p-obj-code
      735                                                   and buf_place-attr.obj-type    = p-obj-type
      736                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      737        if available buf_place-attr then do :
      738           delete buf_place-attr.
      739           p-ok = true.
      740        end.
      741     end.
      742   end.
      743   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   define  temp-table gds-list no-undo like ub.goods
      745     field qnty   as decimal
      746     field to-del as logical
      747     field order-num as integer
      748     field to-sel as logical
      749     field promo-code as character
      750     field ActionId  as int64
      751     field db-num as integer
      752     index art  is primary unique artic prod-type prod-code
      753     index code is         unique gds-code
      754     index oi order-num
      755     index isel to-sel
      756     .
      757   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   define    temp-table gds-list-hist no-undo
      759   field list-table as character
      760   field id as integer
      761   field line as integer
      762   field hist-mode as character
      763   field des as character
      764   field num-recs as integer
      765   field option_ as character
      766   field item_ as character
      767   field status_ as character
      768   field num-add as integer
      769   field num-ignored as integer
      770   field done as logical
      771   field err_ as logical
      772   field err-mes as character
      773   index pi is primary
      774   id
      775   line
      776   index isdone
      777   done
      778   .
      779   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780     define variable v-cntxt-db-num        as integer   no-undo .
      781     define variable v-cntxt-userid        as character no-undo .
      782     define variable v-cntxt-level         as character no-undo .
      783     define variable v-cntxt-host-code-obj as integer   no-undo .
      784     define variable v-cntxt-obj-type      as character no-undo .
      785     define variable v-cntxt-obj-code      as integer   no-undo .
      786     define variable v-cntxt-db-num-obj    as integer   no-undo .
      787     define variable v-cntxt-is-admin      as logical   no-undo .
      788   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789     run mainmenu_getcntxt in parparentproc
      790       (output v-cntxt-db-num
      791       ,output v-cntxt-userid
      792       ,output v-cntxt-level
      793       ,output v-cntxt-host-code-obj
      794       ,output v-cntxt-obj-type
      795       ,output v-cntxt-obj-code
      796       ,output v-cntxt-db-num-obj
      797       ,output v-cntxt-is-admin
      798       ) .
      799     define new global shared variable g#lib-rvs as handle no-undo.
      800   define buffer r-doc for ub.rvs-doc.
      801   define buffer buf-inv_trn-doc for ub.trn-doc .
      802   define buffer buf-spi_trn-doc for ub.trn-doc .
      803   define variable varlog as logical no-undo.
      804   define variable varstr as character no-undo.
      805   define variable v-value as character no-undo.
      806   define variable v-ok as logical no-undo.
      807   define variable is-vir as logical no-undo.
      808   define buffer open-shift         for ub.shift-obj .
      809   find first r-doc where r-doc.rvs-code eq iRvsCode
      810   no-lock no-error.
      811   if available r-doc
      812   then do:
      813           define variable varchg-inv as logical   no-undo.
      814           define variable v-inv-doc  as character no-undo .
      815     if r-doc.status_ = 'факт':U
      816       or r-doc.status_ = 'нередакт':U
      817     then do:
      818           message
      819               "Данный документ сверки закрыт по факту или не может быть обработан в этом списке."
      820               view-as alert-box.
      821           return no-apply.
      822       end.
      823   if r-doc.status_ = 'новый':U then
      824   do:
      825       assign
      826           varlog = no
      827           .
      828       tr:
      829       do transaction
      830           on error   undo tr, leave
      831           on end-key undo tr, leave
      832           on stop    undo tr, leave
      833           :
      834   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
      835                         input recid(r-doc) ,
      836                         input yes ) no-error .
      837         if error-status :error then do:
      838           message
      839             "Ошибка при закрытии документа сверки." skip
      840             error-status:get-message(1) skip
      841             return-value
      842             view-as alert-box error.
      843           //run userlogrvs(58, return-value + error-status:get-message(1) ) .
      844           undo tr, leave.
      845         end.
      846       end.
      847   end.
      848   else
      849   do:
      850       find first buf-inv_trn-doc no-lock
      851           where buf-inv_trn-doc.out-code = r-doc.rvs-code
      852           no-error.
      853       if ambiguous buf-inv_trn-doc then
      854       do:
      855           message
      856               "Найдено более одного складского документа связанного со сверкой."
      857               view-as alert-box error.
      858           return no-apply.
      859       end.
      860       if available buf-inv_trn-doc then
      861       do:
      862           if buf-inv_trn-doc.doc-type <> 'инв':U then
      863           do:
      864               message
      865                   "Документ связанный с документом сверки не яв-ся инвентаризацией."
      866                   view-as alert-box error.
      867               return no-apply.
      868           end.
      869           if buf-inv_trn-doc.status_ <> 'нередакт':U
      870               or buf-inv_trn-doc.flag_ <> yes
      871               then
      872           do:
      873               message
      874                   substitute( "Ошибка в документе инвентаризации &1 по сверке.", buf-inv_trn-doc.doc-code ) skip
      875                   substitute( "Связанный со сверкой документ инвентаризации не находится в статусе &1", 'нередакт':U )
      876                   view-as alert-box error.
      877               return no-apply.
      878           end.
      879           assign
      880               varstr    = " документ инвентаризации"
      881               v-inv-doc = buf-inv_trn-doc.doc-code
      882               .
      883       end.
      884       assign
      885           varlog = no
      886           .
      887       find first ub.rvs-line no-lock
      888           where ub.rvs-line.rvs-code           = r-doc.rvs-code
      889           and ub.rvs-line.state-measure-qnty = ?
      890           no-error.
      891       if available ub.rvs-line then
      892       do:
      893           find first ub.goods no-lock
      894               where ub.goods.gds-code = ub.rvs-line.gds-code.
      895           run placelib_get-attr(input "place-virtual"
      896               ,input rvs-line.obj-code
      897               ,input rvs-line.obj-type
      898               ,input rvs-line.pl-code
      899               ,output v-value
      900               ,output v-ok) no-error.
      901           is-vir = if (v-ok and logical(v-value)) then true else false.
      902           if not is-gas(ub.rvs-line.gds-code) and not is-vir then
      903           do:
      904               message
      905                   substitute( "Не заданы фактические остатки по товару &1 (&2)", ub.goods.gds-code, ub.goods.gds-name )
      906                   view-as alert-box error.
      907               return no-apply.
      908           end.
      909       end.
      910       tr:
      911       do transaction
      912           on error   undo tr, leave
      913           on end-key undo tr, leave
      914           on stop    undo tr, leave
      915           :
      916           find last open-shift where
      917               open-shift.obj-type = v-cntxt-obj-type and
      918               open-shift.obj-code = v-cntxt-obj-code and
      919               open-shift.status_ = 'тек':U
      920               use-index pi no-error.
      921           open-shift.close-time = time.
      922   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclose in g#lib-rvs ( input parparentproc ,
      923                         input recid(r-doc) ,
      924                         input no ) no-error .
      925           if error-status :error then
      926           do:
      927               mutil:put-log( return-value + error-status:get-message(1) ) .
      928               message
      929                   "Ошибка при закрытии документа сверки." skip
      930                   error-status:get-message(1) skip
      931                   return-value
      932                   view-as alert-box error.
      933               undo tr, leave.
      934           end.
      935           release r-doc no-error .
      936           if error-status :error then
      937           do:
      938               message
      939                   "Ошибка при закрытии документа сверки." skip
      940                   error-status:get-message(1) skip
      941                   return-value
      942                   view-as alert-box error.
      943               undo tr, leave.
      944           end.
      945           find first buf-inv_trn-doc exclusive-lock
      946               where buf-inv_trn-doc.doc-code = v-inv-doc
      947               no-error.
      948           if available buf-inv_trn-doc then
      949           do:
      950               assign
      951                   buf-inv_trn-doc.status_ = 'разрешен':U
      952                   buf-inv_trn-doc.flag_   = yes
      953                   .
      954               run str/trn-stat.p
      955                   ( input parparentproc
      956                   , input this-procedure
      957                   , input '<закрытие документа>':U
      958                   , input v-inv-doc
      959                   , input ?
      960                   , input v-cntxt-db-num
      961                   , input ?
      962                   , input ?
      963                   , input ?
      964                   , input ?
      965                   , input yes
      966                   , output varchg-inv
      967                   , output table gds-list
      968                   ) no-error.
      969               if error-status :error then
      970               do:
      971                   message
      972                       "Не удалось закрыть инвентаризацию." skip
      973                       return-value                         skip
      974                       error-status :get-message(1)         skip
      975                       view-as alert-box error.
      976                   undo tr, leave.
      977               end.
      978               release buf-inv_trn-doc no-error .
      979               if error-status :error then
      980               do:
      981                   message
      982                       "Ошибка при закрытии документа интвентаризации." skip
      983                       error-status:get-message(1) skip
      984                       return-value
      985                       view-as alert-box error.
      986                   undo tr, leave.
      987               end.
      988               find first buf-spi_trn-doc exclusive-lock
      989                   where buf-spi_trn-doc.out-code = v-inv-doc
      990                   and buf-spi_trn-doc.ext-doc-type = 'we':U
      991                   no-error .
      992               if available buf-spi_trn-doc then
      993               do:
      994                   assign
      995                       buf-spi_trn-doc.status_ = 'разрешен':U
      996                       buf-spi_trn-doc.flag_   = yes
      997                       .
      998                   run str/trn-stat.p
      999                       ( input parparentproc
     1000                       , input this-procedure
     1001                       , input '<закрытие документа>':U
     1002                       , input buf-spi_trn-doc.doc-code
     1003                       , input ?
     1004                       , input v-cntxt-db-num
     1005                       , input ?
     1006                       , input ?
     1007                       , input ?
     1008                       , input ?
     1009                       , input yes
     1010                       , output varchg-inv
     1011                       , output table gds-list
     1012                       ) no-error.
     1013                   if error-status :error then
     1014                   do:
     1015                       message
     1016                           "Не удалось закрыть документ списания." skip
     1017                           return-value                            skip
     1018                           error-status:get-message(1)             skip
     1019                           view-as alert-box error.
     1020                       undo tr, leave.
     1021                   end.
     1022                   release buf-spi_trn-doc no-error .
     1023                   if error-status :error then
     1024                   do:
     1025                       message
     1026                           "Ошибка при закрытии документа списания." skip
     1027                           error-status:get-message(1) skip
     1028                           return-value
     1029                           view-as alert-box error.
     1030                       undo tr, leave.
     1031                   end.
     1032               end.
     1033           end.
     1034       end.
     1035   end.
     1036   end.
