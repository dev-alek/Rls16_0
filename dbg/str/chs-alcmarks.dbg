      208   define new global shared variable g#trdcalib as handle no-undo.
      209   function cross-list returns logical (
      210     input parfirst-stream  as character,
      211     input parsecond-stream as character,
      212     input pardelim         as character).
      213     if pardelim = ""
      214     or pardelim = ?
      215     then do:
      216       assign
      217         pardelim = ","
      218       .
      219     end.
      220     define variable vari            as integer no-undo .
      221     define variable varresult-cross as logical no-undo .
      222     assign
      223       varresult-cross = no
      224     .
      225     def var v-num-parfirst-stream as integer no-undo .
      226     assign
      227       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      228     .
      229     do vari = 1 to v-num-parfirst-stream
      230     :
      231       if lookup(entry(vari, parfirst-stream, pardelim)
      232                ,parsecond-stream
      233                ,pardelim
      234                ) > 0 then do:
      235         assign
      236           varresult-cross = yes
      237         .
      238         leave.
      239       end.
      240     end.
      241     return varresult-cross .
      242   end function.
      243   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   procedure lineattr-value :
      245     do
      246     on error undo, return error return-value
      247     :
      248       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      249       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      250       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      251       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      252       define output parameter p-type     as character no-undo .
      253       define buffer buf_doc-line-attr for ub.doc-line-attr .
      254       def var v-format         as character no-undo .
      255       def var v-fillin_width   as integer   no-undo .
      256       def var v-fillin_height  as integer   no-undo .
      257       def var v-label          as character no-undo .
      258       def var v-user-can-edit  as logical   no-undo .
      259       def var v-output-display as logical   no-undo .
      260       def var v-other          as character no-undo .
      261       run lineattr-code in this-procedure
      262         (input  p-code
      263         ,output p-type
      264         ,output v-format
      265         ,output v-fillin_width
      266         ,output v-fillin_height
      267         ,output v-label
      268         ,output v-user-can-edit
      269         ,output v-output-display
      270         ,output v-other
      271         ) no-error .
      272       if error-status :error then do:
      273         undo, return error return-value .
      274       end.
      275       find first buf_doc-line-attr no-lock
      276         where buf_doc-line-attr.doc-code  = p-doc-code
      277           and buf_doc-line-attr.gds-code  = p-gds-code
      278           and buf_doc-line-attr.attr-code = p-code
      279         no-error .
      280       if avail buf_doc-line-attr then do:
      281         assign
      282           p-value =  buf_doc-line-attr.attr-value
      283         .
      284       end.
      285       else do:
      286         assign
      287           p-value = if p-type = 'L':U then "no":U else ""
      288         .
      289       end.
      290     end.
      291   end procedure.
      292   procedure lineattr-write :
      293     do
      294     on error undo, return error return-value
      295     :
      296       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      297       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      298       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      299       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      300       define buffer buf_doc-line-attr for ub.doc-line-attr .
      301       def var v-type           as character no-undo .
      302       def var v-format         as character no-undo .
      303       def var v-fillin_width   as integer   no-undo .
      304       def var v-fillin_height  as integer   no-undo .
      305       def var v-label          as character no-undo .
      306       def var v-user-can-edit  as logical   no-undo .
      307       def var v-output-display as logical   no-undo .
      308       def var v-other          as character no-undo .
      309       run lineattr-code in this-procedure
      310         (input  p-code
      311         ,output v-type
      312         ,output v-format
      313         ,output v-fillin_width
      314         ,output v-fillin_height
      315         ,output v-label
      316         ,output v-user-can-edit
      317         ,output v-output-display
      318         ,output v-other
      319         ) no-error .
      320       if error-status :error then do:
      321         undo, return error return-value .
      322       end.
      323       find first buf_doc-line-attr exclusive-lock
      324         where buf_doc-line-attr.doc-code  = p-doc-code
      325           and buf_doc-line-attr.gds-code  = p-gds-code
      326           and buf_doc-line-attr.attr-code = p-code
      327         no-error .
      328       if not available buf_doc-line-attr then do:
      329         create buf_doc-line-attr .
      330         assign
      331           buf_doc-line-attr.doc-code  = p-doc-code
      332           buf_doc-line-attr.gds-code = p-gds-code
      333           buf_doc-line-attr.attr-code = p-code
      334         .
      335       end.
      336       assign
      337         buf_doc-line-attr.attr-value = p-value
      338       .
      339        release buf_doc-line-attr.
      340     end.
      341   end procedure.
