      383   procedure lineattr-delete :
      384     do
      385     on error undo, return error return-value
      386     :
      387       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      388       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      389       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      390       define output parameter p-deleted  as logical no-undo.
      391       define buffer buf_doc-line-attr for ub.doc-line-attr .
      392       def var v-type           as character no-undo .
      393       def var v-format         as character no-undo .
      394       def var v-fillin_width   as integer   no-undo .
      395       def var v-fillin_height  as integer   no-undo .
      396       def var v-label          as character no-undo .
      397       def var v-user-can-edit  as logical   no-undo .
      398       def var v-output-display as logical   no-undo .
      399       def var v-other          as character no-undo .
      400       run lineattr-code in this-procedure
      401         (input  p-code
      402         ,output v-type
      403         ,output v-format
      404         ,output v-fillin_width
      405         ,output v-fillin_height
      406         ,output v-label
      407         ,output v-user-can-edit
      408         ,output v-output-display
      409         ,output v-other
      410         ) no-error .
      411       if error-status :error then do:
      412         undo, return error return-value .
      413       end.
      414       find first buf_doc-line-attr exclusive-lock
      415         where buf_doc-line-attr.doc-code  = p-doc-code
      416           and buf_doc-line-attr.gds-code  = p-gds-code
      417           and buf_doc-line-attr.attr-code = p-code
      418         no-error NO-WAIT.
      419       if not available buf_doc-line-attr then do:
      420         p-deleted = no.
      421       end.
      422       else do:
      423         delete buf_doc-line-attr.
      424         p-deleted = yes.
      425       end.
      426     end.
      427   end procedure.
      428   procedure lineattr-code :
      429     do on error undo, return error return-value
      430     :
      431       define input  parameter p-code           as character no-undo .
      432       define output parameter p-type           as character no-undo .
      433       define output parameter p-format         as character no-undo .
      434       define output parameter p-fillin_width   as integer   no-undo .
      435       define output parameter p-fillin_height  as integer   no-undo .
      436       define output parameter p-label          as character no-undo .
      437       define output parameter p-user-can-edit  as logical   no-undo .
      438       define output parameter p-output-display as logical   no-undo .
      439       define output parameter p-other          as character no-undo .
      440       case p-code :
      441               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      442               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      443               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      444               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      445               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      446               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      447               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      448               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      449               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      450               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      451               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      452         otherwise do:
      453           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      454         end.
      455       end.
      456     end.
      457   end procedure.
      458   procedure lineattr-value-flora-gds :
      459     do
      460     on error undo, return error return-value
      461     :
      462       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      463       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      464       define input  parameter p-prt-code    as integer   no-undo .
      465       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      466       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      467       define output parameter p-value       as    decimal   no-undo .
      468       define buffer buf_doc-line-attr for ub.doc-line-attr .
      469       find first buf_doc-line-attr no-lock
      470         where buf_doc-line-attr.doc-code  = p-doc-code
      471           and buf_doc-line-attr.gds-code  = p-gds-code
      472           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      473         no-error .
      474       if avail buf_doc-line-attr then do:
      475         assign
      476           p-value = decimal( buf_doc-line-attr.attr-value)
      477         .
      478       end.
      479       else do:
      480         assign
      481           p-value = 0
      482         .
      483       end.
      484     end.
      485   end procedure.
      486   procedure lineattr-write-flora-gds :
      487     do
      488     on error undo, return error return-value
      489     :
      490       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      491       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      492       define input parameter p-prt-code    as integer   no-undo .
      493       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      494       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      495       define input parameter p-value    as decimal   no-undo .
      496       define buffer buf_doc-line-attr for ub.doc-line-attr .
      497       find first buf_doc-line-attr exclusive-lock
      498         where buf_doc-line-attr.doc-code  = p-doc-code
      499           and buf_doc-line-attr.gds-code  = p-gds-code
      500           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      501         no-error .
      502       if not available buf_doc-line-attr then do:
      503         create buf_doc-line-attr .
      504         assign
      505           buf_doc-line-attr.doc-code  = p-doc-code
      506           buf_doc-line-attr.gds-code  = p-gds-code
      507           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      508         .
      509       end.
      510       assign
      511         buf_doc-line-attr.attr-value = string( p-value )
      512       .
      513     end.
      514   end procedure.
      515   procedure lineattr-delete-flora-gds :
      516     do
      517     on error undo, return error return-value
      518     :
      519       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      520       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      521       define input  parameter p-prt-code    as integer   no-undo .
      522       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      523       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      524       define output parameter p-deleted  as logical no-undo.
      525       define buffer buf_doc-line-attr for ub.doc-line-attr .
      526       find first buf_doc-line-attr exclusive-lock
      527         where buf_doc-line-attr.doc-code  = p-doc-code
      528           and buf_doc-line-attr.gds-code  = p-gds-code
      529           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      530         no-error NO-WAIT.
      531       if not available buf_doc-line-attr then do:
      532         p-deleted = no.
      533       end.
      534       else do:
      535         delete buf_doc-line-attr.
      536         p-deleted = yes.
      537       end.
      538     end.
      539   end procedure.
      540   procedure lineattr-delete-flora-all :
      541     do
      542     on error undo, return error return-value
      543     :
      544       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      545       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      546       define input  parameter p-prt-code    as integer   no-undo .
      547       define buffer buf_doc-line-attr for ub.doc-line-attr .
      548       for each buf_doc-line-attr exclusive-lock
      549         where buf_doc-line-attr.doc-code  = p-doc-code
      550           and buf_doc-line-attr.gds-code  = p-gds-code
      551           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      552        :
      553         delete buf_doc-line-attr.
      554       end.
      555    end.
      556   end procedure.
      557   procedure lineattr-exist-flora-gds :
      558     do
      559     on error undo, return error return-value
      560     :
      561       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      562       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      563       define input  parameter p-prt-code    as integer   no-undo .
      564       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      565       define output parameter p-exist as logical   no-undo .
      566       define buffer buf_doc-line-attr for ub.doc-line-attr .
      567       p-exist = false .
      568       find first buf_doc-line-attr no-lock
      569         where buf_doc-line-attr.doc-code  = p-doc-code
      570           and buf_doc-line-attr.gds-code  = p-gds-code
      571           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      572         no-error .
      573       if avail buf_doc-line-attr then do:
      574         assign
      575          p-exist = true
      576         .
      577       end.
      578     end.
      579   end procedure.
      580   procedure lineattr-write-add-line-cli :
      581   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      582   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      583   define input  parameter p-cli-type      as character no-undo .
      584   define input  parameter p-cli-code      as integer   no-undo .
      585   define input  parameter p-contract-code as integer   no-undo .
      586   define input  parameter p-host-code     as integer   no-undo .
      587   define input  parameter p-exch-code     as integer   no-undo .
      588   define input  parameter p-exch-rate     as decimal   no-undo .
      589   define input  parameter p-exch-scale    as integer   no-undo .
      590   define input  parameter p-sum-cli       as decimal   no-undo .
      591   define input  parameter p-sum-vat       as decimal   no-undo .
      592   define buffer buf_doc-line-attr for ub.doc-line-attr .
      593     do
      594     on error undo, return error return-value
      595     :
      596       find first buf_doc-line-attr exclusive-lock
      597         where buf_doc-line-attr.doc-code  = p-doc-code
      598           and buf_doc-line-attr.gds-code  = p-gds-code
      599           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      600                                             chr(4) + p-cli-type +
      601                                             chr(4) + string(p-cli-code) +
      602                                             chr(4) + string(p-contract-code) +
      603                                             chr(4) + string(p-host-code)
      604         no-error .
      605       if not available buf_doc-line-attr then do:
      606         create buf_doc-line-attr .
      607         assign
      608           buf_doc-line-attr.doc-code  = p-doc-code
      609           buf_doc-line-attr.gds-code  = p-gds-code
      610           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      611                                         chr(4) + p-cli-type +
      612                                         chr(4) + string(p-cli-code) +
      613                                         chr(4) + string(p-contract-code) +
      614                                         chr(4) + string(p-host-code)
      615         .
      616       end.
      617       assign
      618         buf_doc-line-attr.attr-value =
      619         string(p-exch-code)  + chr(4) +
      620         string(p-exch-rate)  + chr(4) +
      621         string(p-exch-scale) + chr(4) +
      622         string(p-sum-cli)    + chr(4) +
      623         string(p-sum-vat)
      624         .
      625     end.
      626   end procedure.
      627   procedure lineattr-value-add-line-cli :
      628   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      629   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      630   define input   parameter p-cli-type      as character no-undo .
      631   define input   parameter p-cli-code      as integer   no-undo .
      632   define input   parameter p-contract-code as integer   no-undo .
      633   define input   parameter p-host-code     as integer   no-undo .
      634   define output  parameter p-exch-code     as integer   no-undo .
      635   define output  parameter p-exch-rate     as decimal   no-undo .
      636   define output  parameter p-exch-scale    as integer   no-undo .
      637   define output  parameter p-sum-cli       as decimal   no-undo .
      638   define output  parameter p-sum-vat       as decimal   no-undo .
      639   define buffer buf_doc-line-attr for ub.doc-line-attr .
      640     do
      641     on error undo, return error return-value
      642     :
      643       find first buf_doc-line-attr exclusive-lock
      644         where buf_doc-line-attr.doc-code  = p-doc-code
      645           and buf_doc-line-attr.gds-code  = p-gds-code
      646           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      647                                             chr(4) + p-cli-type +
      648                                             chr(4) + string(p-cli-code) +
      649                                             chr(4) + string(p-contract-code) +
      650                                             chr(4) + string(p-host-code)
      651         no-error .
      652       if available buf_doc-line-attr then do:
      653        assign
      654           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      655           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      656           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      657           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      658           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      659          .
      660        end.
      661     end.
      662   end procedure.
      663   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      664     define variable v-code as character no-undo .
      665     define variable v-type as character no-undo .
      666     define variable v-gds-code as integer   no-undo .
      667   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      669     (input  local-doc-line.artic
      670     ,input  local-doc-line.prod-type
      671     ,input  local-doc-line.prod-code
      672     ,output v-gds-code
      673     )  .
      674     run lineattr-value (
      675         input   local-doc-line.doc-code ,
      676         input   v-gds-code              ,
      677         input   'reason-code':U ,
      678         output  v-code                  ,
      679         output  v-type ) .
      680     find first ub.trn-reason no-lock where
      681                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      682     if not available ub.trn-reason then do:
      683        return "" .
      684     end.
      685     else do:
      686        return ub.trn-reason.reason-name .
      687     end.
      688   end function.
      689   procedure lineattr-value-parts :
      690     do
      691     on error undo, return error return-value
      692     :
      693       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      694       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      695       define input  parameter p-part-code   as character no-undo .
      696       define input  parameter p_in-code     as character no-undo .
      697       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      698       define output parameter p-value       as    decimal   no-undo .
      699       define buffer buf_doc-line-attr for ub.doc-line-attr .
      700       find first buf_doc-line-attr no-lock
      701         where buf_doc-line-attr.doc-code  = p-doc-code
      702           and buf_doc-line-attr.gds-code  = p-gds-code
      703           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      704         no-error .
      705       if avail buf_doc-line-attr then do:
      706         assign
      707           p-value = decimal( buf_doc-line-attr.attr-value)
      708         .
      709       end.
      710       else do:
      711         assign
      712           p-value = 0
      713         .
      714       end.
      715     end.
      716   end procedure.
      717   procedure lineattr-write-parts :
      718     do
      719     on error undo, return error return-value
      720     :
      721       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      722       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
