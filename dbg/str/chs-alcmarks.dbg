      878   define temp-table tt-utd-err like ub.utd-err
      879     field descr as character
      880     field gds-code as integer
      881     field LineNum  as integer
      882     field type     as integer
      883     .
      884   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   define variable vss-include-info9 as character format "X(65)" no-undo
      886   initial "@(#)$Workfile$ $Revision$".
      887   procedure xmlchar-test :
      888   define input parameter p-in-string          as character        no-undo.
      889   define output parameter p-out-string-enc    as character        no-undo.
      890   define output parameter p-out-string-dec    as character        no-undo.
      891   do
      892   on error undo, return error
      893   :
      894          run xmlchar-encode in this-procedure
      895       (
      896             input p-in-string
      897           , output p-out-string-enc
      898       ).
      899          run xmlchar-decode in this-procedure
      900       (
      901             input p-out-string-enc
      902           , output p-out-string-dec
      903       ).
      904   end.
      905   end .
      906   procedure xmlchar-encode :
      907   define input parameter p-in-string      as character        no-undo.
      908   define output parameter p-out-string    as character        no-undo.
      909       define variable v-position      as integer      no-undo.
      910       define variable v-current-char  as character    no-undo.
      911   do
      912   on error undo, return error
      913   :
      914       assign
      915           p-out-string = "":U
      916       .
      917       case p-in-string
      918       :
      919           when ?
      920           then do:
      921               assign
      922                   p-out-string = "?":U
      923               .
      924           end.
      925           when "?":U
      926           then do:
      927               assign
      928                   p-out-string = "&#63;":U
      929               .
      930           end.
      931           otherwise do:
      932               do v-position = 1 to length( p-in-string )
      933               :
      934                   assign
      935                       v-current-char = substring( p-in-string, v-position, 1 )
      936                   .
      937                   case v-current-char
      938                   :
      939                       when "&":U
      940                       then do:
      941                           assign
      942                               p-out-string = p-out-string + "&amp;":U
      943                           .
      944                       end.
      945                       when ">":U
      946                       then do:
      947                           assign
      948                               p-out-string = p-out-string + "&gt;":U
      949                           .
      950                       end.
      951                       when "<":U
      952                       then do:
      953                           assign
      954                               p-out-string = p-out-string + "&lt;":U
      955                           .
      956                       end.
      957                       when "'":U
      958                       then do:
      959                           assign
      960                               p-out-string = p-out-string + "&apos;":U
      961                           .
      962                       end.
      963                       when '"':U
      964                       then do:
      965                           assign
      966                               p-out-string = p-out-string + "&quot;":U
      967                           .
      968                       end.
      969                       when chr(1)
      970                       then do:
      971                           assign
      972                               p-out-string = p-out-string + "":U
      973                           .
      974                       end.
      975                       when chr(2)
      976                       then do:
      977                           assign
      978                               p-out-string = p-out-string + "":U
      979                           .
      980                       end.
      981                       when chr(3)
      982                       then do:
      983                           assign
      984                               p-out-string = p-out-string + "":U
      985                           .
      986                       end.
      987                       when chr(4)
      988                       then do:
      989                           assign
      990                               p-out-string = p-out-string + "":U
      991                           .
      992                       end.
      993                       when chr(5)
      994                       then do:
      995                           assign
      996                               p-out-string = p-out-string + "":U
      997                           .
      998                       end.
      999                       when chr(6)
     1000                       then do:
     1001                           assign
     1002                               p-out-string = p-out-string + "":U
     1003                           .
     1004                       end.
     1005                       when chr(7)
     1006                       then do:
     1007                           assign
     1008                               p-out-string = p-out-string + "":U
     1009                           .
     1010                       end.
     1011                       when chr(8)
     1012                       then do:
     1013                           assign
     1014                               p-out-string = p-out-string + "":U
     1015                           .
     1016                       end.
     1017                       when chr(9)
     1018                       then do:
     1019                           assign
     1020                               p-out-string = p-out-string + "":U
     1021                           .
     1022                       end.
     1023                       when chr(29)
     1024                       then do:
     1025                           assign
     1026                               p-out-string = p-out-string + "":U
     1027                           .
     1028                       end.
     1029                       when chr(10)
     1030                       then do:
     1031                           assign
     1032                               p-out-string = p-out-string + "&#10;":U
     1033                           .
     1034                       end.
     1035                       when chr(13)
     1036                       then do:
     1037                           assign
     1038                               p-out-string = p-out-string + "&#13;":U
     1039                           .
     1040                       end.
     1041                       otherwise do:
     1042                           assign
     1043                               p-out-string = p-out-string + v-current-char
     1044                           .
     1045                       end.
     1046                   end case.
     1047               end.
     1048           end.
     1049       end case.
     1050   end.
     1051   end .
     1052   procedure xmlchar-encode-1c :
     1053   define input parameter p-in-string      as character        no-undo.
     1054   define output parameter p-out-string    as character        no-undo.
     1055       define variable v-position      as integer      no-undo.
     1056       define variable v-current-char  as character    no-undo.
     1057   do
     1058   on error undo, return error
     1059   :
     1060       assign
     1061           p-out-string = "":U
     1062       .
     1063       case p-in-string
     1064       :
     1065           when ?
     1066           then do:
     1067               assign
     1068                   p-out-string = "?":U
     1069               .
     1070           end.
     1071           otherwise do:
     1072               do v-position = 1 to length( p-in-string )
     1073               :
     1074                   assign
     1075                       v-current-char = substring( p-in-string, v-position, 1 )
     1076                   .
     1077                   case v-current-char
     1078                   :
     1079                       when chr(1)
     1080                       then do:
     1081                           assign
     1082                               p-out-string = p-out-string + " ":U
     1083                           .
     1084                       end.
     1085                       when chr(2)
     1086                       then do:
     1087                           assign
     1088                               p-out-string = p-out-string + " ":U
     1089                           .
     1090                       end.
     1091                       when chr(3)
     1092                       then do:
     1093                           assign
     1094                               p-out-string = p-out-string + " ":U
     1095                           .
     1096                       end.
     1097                       when chr(4)
     1098                       then do:
     1099                           assign
     1100                               p-out-string = p-out-string + " ":U
     1101                           .
     1102                       end.
     1103                       when chr(5)
     1104                       then do:
     1105                           assign
     1106                               p-out-string = p-out-string + " ":U
     1107                           .
     1108                       end.
     1109                       when chr(6)
     1110                       then do:
     1111                           assign
     1112                               p-out-string = p-out-string + " ":U
     1113                           .
     1114                       end.
     1115                       when chr(7)
     1116                       then do:
     1117                           assign
     1118                               p-out-string = p-out-string + " ":U
     1119                           .
     1120                       end.
     1121                       when chr(8)
     1122                       then do:
     1123                           assign
     1124                               p-out-string = p-out-string + " ":U
     1125                           .
     1126                       end.
     1127                       when chr(9)
     1128                       then do:
     1129                           assign
     1130                               p-out-string = p-out-string + " ":U
     1131                           .
     1132                       end.
     1133                       when chr(29)
     1134                       then do:
     1135                           assign
     1136                               p-out-string = p-out-string + " ":U
     1137                           .
     1138                       end.
     1139                       when chr(10)
     1140                       then do:
     1141                           assign
     1142                               p-out-string = p-out-string + " ":U
     1143                           .
     1144                       end.
     1145                       when chr(13)
     1146                       then do:
     1147                           assign
     1148                               p-out-string = p-out-string + " ":U
     1149                           .
     1150                       end.
     1151                       otherwise do:
     1152                           assign
     1153                               p-out-string = p-out-string + v-current-char
     1154                           .
     1155                       end.
     1156                   end case.
     1157               end.
     1158           end.
     1159       end case.
     1160   end.
     1161   end .
     1162   procedure xmlchar-decode :
     1163   define input parameter p-in-string      as character        no-undo.
     1164   define output parameter p-out-string    as character        no-undo.
     1165       define variable v-position      as integer      no-undo.
     1166       define variable v-last-position as integer      no-undo.
     1167       define variable v-temp-integer  as integer      no-undo.
     1168       define variable v-current-char  as character    no-undo.
     1169       define variable v-next-char     as character    no-undo.
     1170       define variable v-success       as logical      no-undo.
     1171   do
     1172   on error undo, return error
     1173   :
     1174       assign
     1175           p-out-string = "":U
     1176           v-position   = 0
     1177       .
     1178       replace-cycle:
     1179       do while yes
     1180       on error undo, return error
     1181       :
     1182           assign
     1183               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1184           .
     1185           if v-last-position <= v-position
     1186           then do:
     1187               if v-position = 0
     1188               then do:
     1189                   assign
     1190                       p-out-string = p-in-string
     1191                   .
     1192               end.
     1193               else do:
     1194                   assign
     1195                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1196                   .
     1197               end.
     1198               leave replace-cycle.
     1199           end.
     1200           else do:
     1201               assign
     1202                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1203                   v-position      = v-last-position
     1204                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1205               .
     1206               if v-current-char = "#":U
     1207               then do:
     1208                   assign
     1209                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1210                   .
     1211                   if v-last-position > 0
     1212                   then do:
     1213                       run xmlchar-read-integer in this-procedure
     1214                        (
     1215                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1216                           , output v-temp-integer
     1217                           , output v-success
     1218                       ).
     1219                       if v-success = yes
     1220                       and v-temp-integer >= 1
     1221                       and v-temp-integer <= 255
     1222                       then do:
     1223                           assign
     1224                               p-out-string = p-out-string + chr( v-temp-integer )
     1225                               v-position   = v-last-position + 1
     1226                           .
     1227                       end.
     1228                       else do:
     1229                           assign
     1230                               p-out-string = p-out-string + "&":U
     1231                               v-position   = v-position   + 1
     1232                           .
     1233                       end.
     1234                   end.
     1235                   else do:
     1236                       assign
     1237                           p-out-string = p-out-string + "&":U
     1238                           v-position   = v-position   + 1
     1239                       .
     1240                   end.
     1241               end.
     1242               else do:
     1243                   case substring( p-in-string, v-position + 1, 3 )
     1244                   :
     1245                       when "lt;":U
     1246                       then do:
     1247                           assign
     1248                               p-out-string = p-out-string + "<":U
     1249                               v-position   = v-position   + 3
     1250                           .
     1251                       end.
     1252                       when "gt;":U
     1253                       then do:
     1254                           assign
     1255                               p-out-string = p-out-string + ">":U
     1256                               v-position   = v-position   + 3
     1257                           .
     1258                       end.
     1259                       otherwise do:
     1260                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1261                           then do:
     1262                               assign
     1263                                   p-out-string = p-out-string + "&":U
     1264                                   v-position   = v-position   + 4
     1265                               .
     1266                           end.
     1267                           else do:
     1268                               case substring( p-in-string, v-position + 1, 5 )
     1269                               :
     1270                                   when "quot;":U
     1271                                   then do:
     1272                                       assign
     1273                                           p-out-string = p-out-string + '"':U
     1274                                           v-position   = v-position   + 5
     1275                                       .
     1276                                   end.
     1277                                   when "apos;":U
     1278                                   then do:
     1279                                       assign
     1280                                           p-out-string = p-out-string + "'":U
     1281                                           v-position   = v-position   + 5
     1282                                       .
     1283                                   end.
     1284                                   otherwise do:
     1285                                       assign
     1286                                           p-out-string = p-out-string + "&":U
     1287                                       .
     1288                                   end.
     1289                               end case.
     1290                           end.
     1291                       end.
     1292                   end case.
     1293               end.
     1294           end.
     1295       end.
     1296   end.
     1297   end .
     1298   procedure xmlchar-read-integer :
     1299   define input parameter p-input-string      as character        no-undo.
     1300   define output parameter p-output-integer   as integer          no-undo.
     1301   define output parameter p-success       as logical          no-undo.
     1302   do
     1303   on error undo, return error
     1304   :
     1305       assign
     1306           p-output-integer = integer( p-input-string )
     1307       no-error.
     1308       if error-status :error
     1309       then do:
     1310           assign
     1311               p-success           = no
     1312               p-output-integer    = 0
     1313           .
     1314       end.
     1315       else do:
     1316           assign
     1317               p-success           = yes
     1318           .
     1319       end.
     1320   end.
     1321   end.
     1322   define new global shared variable g#attr-lib  as handle no-undo .
     1323   define variable v-attr-lib-variable as handle no-undo .
     1324   define variable mMRCCode  as logical    no-undo.
     1325   define variable mTypeMark as character  no-undo.
     1326   function IS-NeedMark returns logical
     1327   ( input ib-code as integer  ,
     1328     input ib-str as character ):
     1329      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1330      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1331                                    and buf_prod-bc-attr.b-str  eq ib-str
     1332                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1333        no-lock no-error.
     1334      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1335   end.
     1336   function repTegforDm return char
     1337   (iDM as char ):
     1338       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1339       define variable vteg as character no-undo.
     1340       define variable oDM as character no-undo.
     1341       define variable vi as integer no-undo.
     1342       oDM = iDm.
     1343       do vi = 1 to num-entries(vTeglist):
     1344          vTeg = entry(vi,vTeglist).
     1345          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1346       end.
     1347       return oDM.
     1348   end.
     1349   function repSpecSimbforDm return char
     1350   (iDM as char ):
     1351       define variable oDM as character no-undo.
     1352     run
     1353       xmlchar-decode(iDM, output oDM).
     1354     return repTegforDm (oDM).
     1355   end.
     1356   function CheckGtin return logical
     1357   (iGtin as char):
     1358      define variable bar_code as character no-undo.
     1359      define variable vGtin as logical no-undo init "yes".
     1360      if length(iGtin) eq 14
     1361      then do:
     1362         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1363         run str/chk-sum.p
     1364          (input-output bar_code ) no-error .
     1365         if iGtin ne  bar_code
     1366         then
     1367            vGtin = no.
     1368      end.
     1369      else
     1370         vGtin = no.
     1371      return vgtin.
     1372   end.
     1373   function repSpecSimbforXlm return char
     1374   (iDM as char ):
     1375       iDM = replace(iDM,chr(29),"").
     1376       return iDM.
     1377   end.
     1378   function getGtinByDM return char
     1379   (IDM as char):
     1380      define variable VTXT as char no-undo.
     1381      define variable vGtin as char no-undo.
     1382      vTXt = IdM.
     1383      vGtin = IDM.
     1384      if    length(vtxt) > 14
     1385      then do:
     1386         if   vtxt begins "(01)"
     1387                or vtxt begins "(02)"
     1388         then
     1389            vGtin = substring(vtxt,5,14).
     1390         else if   (vtxt begins "01"
     1391                or vtxt begins "02" )
     1392                and (   (    substring(iDm,17,2) eq "21"
     1393                         and length(vtxt) >= 21)
     1394                     or substring(iDm,17,2) eq "37"
     1395                     or substring(iDm,17,4) eq "(37)" )
     1396         then do:
     1397            vGtin = substring(vtxt,3,14).
     1398            if not checkGtin(vGtin)
     1399            then
     1400               vGtin = substring(vtxt,1,14).
     1401         end.
     1402         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1403             or length(vtxt) eq 14 + 7 + 4
     1404             or length(vtxt) eq 14 + 7
     1405         then
     1406            vGtin = substring(vtxt,1,14).
     1407      end.
     1408      if not checkGtin(vGtin)
     1409      then
     1410         vGtin = "".
     1411      return vgtin.
     1412   end.
     1413   function getGdsCodeByGtin return int
     1414   (iGtin as char):
     1415      define buffer prod-bc  for ub.prod-bc.
     1416      define buffer bar-code for ub.bar-code.
     1417      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1418      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1419      return if avail bar-code then bar-code.gds-code else ?.
     1420   end.
     1421   function getQntyCodeByGtin return decimal
     1422   (iGtin as char):
     1423      define buffer prod-bc  for ub.prod-bc.
     1424      define buffer bar-code for ub.bar-code.
     1425      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1426      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1427      return if avail bar-code then bar-code.cli-base-rate else ?.
     1428   end.
     1429   function getGdsCodeByDM return int
     1430   (iDm as char):
     1431      define variable vGtin as char no-undo.
     1432      define buffer prod-bc for ub.prod-bc.
     1433      vGtin  = getGtinByDM (IDM ).
     1434      return getGdsCodeByGtin (vGtin).
     1435   end.
     1436   function ChekTypeMarkByGds return logical
     1437   (iGds-code as integer ):
     1438      define buffer goods-attr for ub.goods-attr.
     1439      find first goods-attr where goods-attr.gds-code   = iGds-code
     1440                              and goods-attr.attr-code  = 'mark-type':U
     1441      no-lock no-error.
     1442      if available goods-attr
     1443      then do:
     1444         mTypeMark = goods-attr.attr-value.
     1445         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1446           .
     1447      end.
     1448      else
     1449         return no.
     1450   end.
     1451   function ChekTypeMarkByDm return logical
     1452   (iDM as char ):
     1453      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1454   end.
     1455   function ChekTypeMarkByGtin return logical
     1456   (iGtin as char ):
     1457      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1458   end.
     1459   function GetNextElement return character
     1460     (input iAllTeg        as logical
     1461     ,output oteg          as character
     1462     ,output otegval       as character
     1463     ,input-output pstr    as character
     1464      ):
     1465        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1466        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1467        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1468        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1469        define variable vTeg as character no-undo.
     1470        define variable vLength as integer no-undo.
     1471        define variable vi as integer no-undo.
     1472        define variable vj as integer no-undo.
     1473        define buffer code for ub.code.
     1474        find first code where Code.parent eq "MarkType"
     1475                          and Code.CodeValue   eq mTypeMark
     1476                          no-lock no-error.
     1477        if     available code
     1478           and Code.misc1 ne ""
     1479           and Code.misc1 ne ?
     1480        then do:
     1481           integer (Code.misc1) no-error.
     1482           if not error-status:error
     1483           then
     1484             entry (4,vlistleng) = Code.misc1.
     1485        end.
     1486        if iAllTeg
     1487        then
     1488           assign
     1489              vlistElem     = vlistElem    + vlistElemDop
     1490              vlistleng     = vlistleng    + vlistlengDop
     1491           .
     1492        else if mMRCCode
     1493        then
     1494           assign
     1495              vlistElem     = vlistElem    + ",(8005),8005"
     1496              vlistleng     = vlistleng    + ",000006,0006"
     1497           .
     1498       block-elem:
     1499       do vi = 1 to num-entries(vlistElem):
     1500          vTeg = entry(vi,vlistElem).
     1501          if pstr begins vTeg
     1502          then do:
     1503             if    vTeg eq "21"
     1504             then
     1505                vLength = index(pstr,chr(29)) - 2 no-error.
     1506             if vLength  <= 0
     1507             then
     1508                vLength = int(entry(vi,vlistleng)).
     1509             otegval = substring (pstr,length(vteg) + 1, vLength).
     1510             oteg = replace(replace(vteg,")",""),"(","").
     1511             vTeg = vteg + otegval.
     1512             otegval = replace(otegval,chr(29),"").
     1513             oteg = replace(replace(oteg,")",""),"(","").
     1514             pstr = substring (pstr,length(vTeg)+ 1).
     1515             vTeg = replace(vTeg,chr(29),"").
     1516             leave block-elem.
     1517          end.
     1518          else
     1519             vTeg = "".
     1520       end.
     1521       return vteg.
     1522   end.
     1523   function GetCodeIdent return character
     1524   (iDm as char):
     1525      define variable Velement   as character no-undo init "first".
     1526      define variable oCodeIdent as character no-undo.
     1527      define variable vteg as character no-undo.
     1528      define variable vtegval as character no-undo.
     1529      define variable vGtin as character no-undo.
     1530      define buffer marking for ub.marking.
     1531      for first marking no-lock where
     1532                marking.mark eq iDm
     1533            and marking.unit-ext = "LEVEL2"
     1534      :
     1535        return iDm.
     1536      end.
     1537      vGtin  = getGtinByDM (iDm ).
     1538      ChekTypeMarkByDm(idm).
     1539      if iDm begins 'tech_':U
     1540      then
     1541         oCodeIdent = iDm.
     1542      else if length(iDm) < 21
     1543      then do:
     1544         find first marking where marking.mark eq idm
     1545         no-lock no-error.
     1546         oCodeIdent = if available marking then marking.mark else  ?.
     1547      end.
     1548      else if     length(iDm) eq 29
     1549         and not iDm begins "01"
     1550         and not iDm begins "02"
     1551      then
     1552         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1553      else  if     length(iDm) >= 24
     1554               and (  iDm begins "01"
     1555                   or iDm begins "02")
     1556               and  substring(iDm,17,2) ne "21"
     1557      then do:
     1558         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1559                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1560         then
     1561            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1562         else
     1563            oCodeIdent = iDM.
     1564      end.
     1565      else  if     (   length(iDm) eq 25
     1566                    or length(iDm) eq 21)
     1567               and (not iDm begins "01"
     1568               and  not iDm begins "02")
     1569      then
     1570         oCodeIdent = substring(iDm,1,21).
     1571      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1572      then
     1573         oCodeIdent = substring(iDm,1,21).
     1574      else do while Velement ne "" and idm ne "":
     1575         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1576         oCodeIdent = oCodeIdent + Velement.
     1577      end.
     1578      return oCodeIdent.
     1579   end.
     1580   function GetTegCod return character
     1581   (icodeIdent as char, iTeg as char):
     1582      define variable Velement   as character no-undo init "first".
     1583      define variable oTeg as character no-undo init ?.
     1584      define variable vteg as character no-undo.
     1585      define variable vtegval as character no-undo.
     1586      if     ((length(icodeIdent) eq 21
     1587         and not icodeIdent begins "01"
     1588         and not icodeIdent begins "02")
     1589         or
     1590             ( length(icodeIdent) eq 25
     1591               and not icodeIdent begins "01"
     1592               and not icodeIdent begins "02"))
     1593      then do:
     1594         if iTeg eq "01" or iTeg eq "02"
     1595         then
     1596            oTeg = substring(icodeIdent,1,21).
     1597         else  if  iTeg eq "21"
     1598         then
     1599            oTeg = substring(icodeIdent,15,7).
     1600      end.
     1601      else do:
     1602         ChekTypeMarkByDm(icodeIdent).
     1603         block-teg:
     1604            do while Velement ne "" and icodeIdent ne "":
     1605            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1606            if    Velement begins iTeg
     1607               or Velement begins "(" + iTeg + ")"
     1608            then do:
     1609               oTeg = vtegval.
     1610               leave block-teg.
     1611            end.
     1612         end.
     1613      end.
     1614      return oTeg.
     1615   end.
     1616   function isOAD return logical
     1617   (icodeIdent as character):
     1618      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1619   end.
     1620   function isMark return logical
     1621   (icodeIdent as character):
     1622      define buffer buf_marking for ub.marking.
     1623      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1624             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1625   end.
     1626   function addBracketForCode return character
     1627   (icodeIdent as char):
     1628      define variable Velement   as character no-undo init "first".
     1629      define variable oTeg as character no-undo.
     1630      define variable vteg as character no-undo.
     1631      define variable vtegval as character no-undo.
     1632      define buffer marking for ub.marking.
     1633      find first marking no-lock where
     1634                 marking.mark begins icodeIdent no-error.
     1635      if    not ChekTypeMarkByDm(icodeIdent)
     1636         or length(icodeIdent) le 24
     1637         or (avail marking and marking.unit-ext = "LEVEL2")
     1638      then
     1639         oTeg = icodeIdent.
     1640      else do:
     1641         if (  icodeIdent begins "01"
     1642            or icodeIdent begins "02"
     1643            ) and CheckGtin(substring (icodeIdent,3,14))
     1644            and substring (icodeIdent,17,2) eq "21"
     1645         then do:
     1646            mMRCCode = yes.
     1647            ChekTypeMarkByDm(icodeIdent).
     1648            block-teg:
     1649            do while Velement ne "" and icodeIdent ne "":
     1650               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1651               if vteg ne ""
     1652               then
     1653                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1654            end.
     1655            mMRCCode = no.
     1656         end.
     1657         else do:
     1658            oTeg = icodeIdent.
     1659         end.
     1660      end.
     1661      return oTeg.
     1662   end.
     1663   function getlevelByCodId return int
     1664   (iCode as char):
     1665      define variable vLength as int no-undo.
     1666      define variable vLevel  as int no-undo.
     1667      if not ChekTypeMarkByDM (icode) then return ?.
     1668      vLength = length(iCode).
     1669      if    vLength eq 18
     1670         or vLength eq 20
     1671      then
     1672         Vlevel = 4.
     1673      else if vLength eq 21
     1674      then
     1675         Vlevel = 1.
     1676      else if vLength eq 25
     1677      then do:
     1678         if  iCode begins "01"
     1679         then
     1680            Vlevel = 3.
     1681         else
     1682            Vlevel = 1.
     1683      end.
     1684      else if     vLength >= 26
     1685              and vLength <= 46
     1686      then do:
     1687         if    substring(iCode,17,2) eq "11"
     1688            or substring(iCode,17,2) eq "13"
     1689            or (    substring(iCode,17,2) eq "21"
     1690                and vLength >= 33
     1691                and substring(iCode,26,4) ne "8005")
     1692         then
     1693            Vlevel = 4.
     1694         else if    vLength eq 31
     1695                 or vLength eq 38
     1696                 or vLength eq 39
     1697                 or vLength eq 45
     1698         then
     1699            Vlevel = 1.
     1700         else if    vLength eq 35
     1701                 or vLength eq 43
     1702         then
     1703            Vlevel = 3.
     1704         else
     1705            Vlevel = ?.
     1706      end.
     1707      else
     1708         Vlevel = ?.
     1709      return Vlevel.
     1710   end.
     1711   function getLevelMotpBycodid return character
     1712   (iDm as char):
     1713      define variable vLevel as integer no-undo.
     1714      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1715      vLevel = getlevelByCodId(iDm).
     1716      if    vLevel eq ?
     1717         or vLevel < 1
     1718         or vLevel > 6
     1719      then
     1720         return ?.
     1721      else
     1722         return entry(vlevel,vList).
     1723   end.
     1724   function getLevelUTDByLevelMotp return character
     1725   (iUnit as char):
     1726      define variable vLevel as integer no-undo.
     1727      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1728      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1729      vLevel = lookup(iUnit,vListMOTP).
     1730      if    vLevel eq ?
     1731         or vLevel < 1
     1732         or vLevel > 4
     1733      then
     1734         return ?.
     1735      else
     1736         return entry(vlevel,vListutd).
     1737   end.
     1738   function getLevelMotpByDM return character
     1739   (iDm as char):
     1740      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1741   end.
     1742   function getLevelUTDByCodId return character
     1743   (iDm as char):
     1744      define variable vLevel as integer no-undo.
     1745      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1746      vLevel = getlevelByCodId(iDm).
     1747      if    vLevel eq ?
     1748         or vLevel < 1
     1749         or vLevel > 4
     1750      then
     1751         return ?.
     1752      else
     1753         return entry(vlevel,vList).
     1754   end.
     1755   function getLevelUTDByDM return character
     1756   (iDm as char):
     1757      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1758   end.
     1759   define variable mNotMarkQnty as logical no-undo.
     1760   function getQntyUTDByCodId return decimal
     1761   (iDM as char):
     1762      define variable vLevel as integer no-undo.
     1763      define variable vList as character no-undo init "1,5,10,500".
     1764      define variable vGtin as character no-undo.
     1765      define variable vqnty as decimal no-undo init ?.
     1766      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1767      if vqnty eq ?
     1768      then do:
     1769         if not mNotMarkQnty
     1770         then do:
     1771            define buffer marking for ub.marking.
     1772            define variable vCodident as character no-undo.
     1773            vCodident = GetCodeIdent(idm).
     1774            find first marking where marking.mark begins vCodident no-lock no-error.
     1775            if     available marking
     1776               and marking.box-qnty ne ?
     1777            then
     1778               return marking.box-qnty.
     1779         end.
     1780         vGtin = getGtinByDm(iDM).
     1781         if ChekTypeMarkByGtin (vGtin)
     1782         then do:
     1783            vLevel = getlevelByCodId(iDM).
     1784            if     vLevel >= 1
     1785               and vLevel <= 4
     1786            then
     1787               vqnty = int(entry(vlevel,vList)).
     1788         end.
     1789         else
     1790            vqnty = getQntyCodeByGtin(vgtin).
     1791      end.
     1792      return vqnty.
     1793   end.
     1794   function getQntyUTDByDM return decimal
     1795   (iDm as char):
     1796      define variable vDM as character no-undo.
     1797      if     length (iDm) ne 25
     1798         and length (iDm) ne 29
     1799         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1800      then
     1801         vDM = substring (iDm,1,length (iDm) - 6 ).
     1802      else
     1803         vDM = substring (iDm,1,length (iDm) - 4 ).
     1804      return getQntyUTDByCodId(vDM).
     1805   end.
     1806   function getMRC4 return decimal
     1807   (iMRC as char):
     1808      define variable oMrc     as decimal no-undo init ?.
     1809      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1810      define variable vi       as integer no-undo.
     1811      define variable vfound   as integer no-undo.
     1812      define variable vposStart   as integer no-undo.
     1813      do:
     1814      OMRc = 0.
     1815      do vi = 1 to 4:
     1816         define variable vsimb as character no-undo.
     1817         vsimb = substring(iMRC,vi,1).
     1818         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1819         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1820         if vfound > 0
     1821         then
     1822            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1823         end.
     1824         OMRc = OMRc / 100.
     1825      end.
     1826      return OMRc.
     1827   end.
     1828   function getMRCByDM return decimal
     1829   (iDm as char):
     1830      define variable vMRC     as character no-undo.
     1831      define variable oMrc     as decimal no-undo init ?.
     1832      define variable Velement as character no-undo init "empty".
     1833      define variable vteg as character no-undo.
     1834      define variable vtegval as character no-undo.
     1835      if    length(idm) eq 14 + 7 + 4 + 4
     1836         or length(idm) eq 14 + 7 + 4
     1837      then do:
     1838         vMRC = substring(idm,22,4).
     1839         omrc = getMRC4(vMRC).
     1840      end.
     1841      else do:
     1842          ChekTypeMarkByDm(iDm).
     1843          block-mrc:
     1844          do while Velement ne "" and idm ne "":
     1845             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1846             if Velement begins "8005"
     1847             then do:
     1848                vMRC = substring(Velement,5,6).
     1849                leave block-mrc.
     1850             end.
     1851             else if Velement begins "(8005)"
     1852             then do:
     1853                vMRC = substring(Velement,7,6).
     1854                leave block-mrc.
     1855             end.
     1856          end.
     1857          if vMRC ne ""
     1858          then
     1859             OMRc = dec(vmrc) / 100 no-error.
     1860      end.
     1861      return OMRc.
     1862   end.
     1863   function MoveDate return Date
     1864   (idate as date,
     1865    iMonth as int64):
     1866      define variable vMonth   as int64 no-undo.
     1867      define variable vYear    as int64 no-undo.
     1868      define variable vDateNew as date  no-undo.
     1869       define variable vDay     as int64 no-undo.
     1870       vMonth = month(iDate) + iMonth.
     1871       vYear =  year(iDate).
     1872       if vMonth <= 0
     1873       then assign
     1874          vMonth = vMonth + 12
     1875           vYear  = vYear - 1
     1876       .
     1877       else if vMonth > 12
     1878       then assign
     1879          vMonth = vMonth - 12
     1880           vYear  = vYear + 1
     1881       .
     1882       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1883       do while error-status:error eq yes:
     1884          VDay = vDay + 1.
     1885          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1886       end.
     1887       if VDay > 0
     1888       then
     1889          vDateNew + 1.
     1890       return vDateNew.
     1891   end.
     1892   procedure checkEMRC:
     1893   define input  parameter iDm as character no-undo.
     1894   define output parameter vok as logical   no-undo init yes.
     1895      define variable v-value-emrc as character no-undo.
     1896      define variable v-type-emrc  as character no-undo.
     1897      define variable vDateIso     as character no-undo.
     1898      define variable vMRC         as decimal no-undo.
     1899      define variable vqnty        as decimal no-undo.
     1900      define variable vPrice       as decimal no-undo.
     1901      define variable vparent      as character no-undo.
     1902      define variable vgds-code    as integer no-undo.
     1903      define buffer code for ub.code.
     1904      vMRC = getMRCByDM(iDm).
     1905      if vMRC > 0
     1906      then do:
     1907         vgds-code = getGdsCodeByDM(iDm).
     1908         vqnty     = getQntyUTDByDM(iDm).
     1909               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1910            (
     1911             input   vgds-code
     1912            ,input   'emrc-type':U
     1913            ,output   v-value-emrc
     1914            ,output   v-type-emrc
     1915          ) no-error.
     1916          if     v-value-emrc ne ""
     1917             and v-value-emrc ne ?
     1918          then do:
     1919             vDateIso = iso-date(today).
     1920             vPrice = vMRC / vqnty.
     1921             vparent ="emc" + chr(4) + v-value-emrc.
     1922             find last code where Code.parent      eq vparent
     1923                              and Code.code        le vDateIso
     1924                              and code.status_  eq 0
     1925             no-lock no-error.
     1926             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1927             then
     1928                vOk = true .
     1929             else do:
     1930                 define variable vText      as character no-undo.
     1931                 define variable vDate      as date no-undo.
     1932                 define variable vDateLast  as character no-undo.
     1933                 define variable vDateFirst as character no-undo.
     1934                 define variable vDate3     as date no-undo.
     1935                 vdate = date(code.misc1).
     1936                 vDateLast = code.misc1.
     1937                 vDate3 = MoveDate(today, - 3 ).
     1938                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1939                                      string(vDate3  , "99/99/9999"),
     1940                                      string(vDate   , "99/99/9999")
     1941                                      ).
     1942                 vdateIso = iso-date(vdate3).
     1943                 find last code  where Code.parent      eq vparent
     1944                                   and Code.code        le vDateIso
     1945                                   and code.status_  eq 0 no-lock no-error.
     1946                 if available code
     1947                 then
     1948                    vDateIso = code.code.
     1949                 vDateFirst = vDateIso.
     1950                 vDateLast = iso-date(vdate).
     1951                 define variable vGood as logical no-undo.
     1952                 define variable vDateSale as date no-undo.
     1953                 define buffer bcode for code.
     1954                 for last code where Code.parent   eq vparent
     1955                                 and code.status_  eq 0
     1956                                 and code.code     < vDateLast
     1957                                 and code.code     >= vDateFirst
     1958                 no-lock:
     1959                    find first bcode where bCode.parent   eq vparent
     1960                                       and bcode.status_  eq 0
     1961                                       and bcode.code     > code.code no-lock no-error.
     1962                    if available bcode
     1963                    then do:
     1964                       if vPrice < dec(Code.CodeValue)
     1965                       then
     1966                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1967                                                     chr(10),
     1968                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1969                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1970                                                     ).
     1971                       else do:
     1972                          vGood = yes.
     1973                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1974                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1975                                                     chr(10),
     1976                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1977                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1978                                                     string(         vDateSale            ,"99/99/9999"),
     1979                                                     string(vDateSale - today)
     1980                                                     ).
     1981                       end.
     1982                    end.
     1983                 end.
     1984                 if vgood
     1985                 then do:
     1986                    define variable choice as integer no-undo .
     1987                    run gbl/d-askw.w (input "Уточнение"
     1988                           ,input  vText
     1989                           ,input "|"
     1990                           ,input "Принять|Вернуть"
     1991                           ,input "Принять данный товар|Вернуть товар постащику"
     1992                           ,input 1
     1993                           ,input 2
     1994                           ,output choice) no-error.
     1995                    vok = choice eq 1.
     1996                 end.
     1997                 else
     1998                    vok =false.
     1999             end.
     2000          end.
     2001      end.
     2002   end.
     2003   function addGs2Mark return character
     2004   (iMark as char):
     2005      define variable vDM   as character no-undo.
     2006      define variable vIdx  as integer   no-undo.
     2007      if index(iMark,chr(29),1) > 0
     2008      then return iMark.
     2009      if substring(iMark,26,4) = "8005" then
     2010      do:
     2011        vIdx = index(iMark,"93",26 + 4 + 5).
     2012        if vIdx > 1 then do:
     2013          vDM = substitute("&1&4&2&4&3",
     2014                           substring(iMark,1,25),
     2015                           substring(iMark,26,vIdx - 25 - 1),
     2016                           substring(iMark,vIdx),
     2017                           chr(29)) no-error.
     2018          vIdx = index(vDm,"240",vIdx + 4).
     2019          if vIdx > 0 then
     2020          do:
     2021            vDM = substitute("&1&3&2",
     2022                             substring(vDm,1,vIdx - 1),
     2023                             substring(vDm,vIdx),
     2024                             chr(29)) no-error.
     2025          end.
     2026        end.
     2027        else
     2028          vDM = substitute("&1&3&2",
     2029                           substring(iMark,1,25),
     2030                           substring(iMark,26),
     2031                           chr(29)) no-error.
     2032      end.
     2033      else if substring(iMark,32,2) = "91" then
     2034      do:
     2035        vIdx = index(iMark,"92",32).
     2036        if vIdx > 1 then
     2037          vDM = substitute("&1&4&2&4&3",
     2038                           substring(iMark,1,31),
     2039                           substring(iMark,32,vIdx - 31 - 1),
     2040                           substring(iMark,vIdx),
     2041                           chr(29)) no-error.
     2042        else
     2043          vDM = substitute("&1&3&2",
     2044                           substring(iMark,1,31),
     2045                           substring(iMark,32),
     2046                           chr(29)) no-error.
     2047      end.
     2048      else if substring(iMark,39,2) = "91" then
     2049      do:
     2050        vIdx = index(iMark,"92",38).
     2051        if vIdx > 1 then
     2052          vDM = substitute("&1&4&2&4&3",
     2053                           substring(iMark,1,38),
     2054                           substring(iMark,39,vIdx - 38 - 1),
     2055                           substring(iMark,vIdx),
     2056                           chr(29)) no-error.
     2057        else
     2058          vDM = substitute("&1&3&2",
     2059                           substring(iMark,1,38),
     2060                           substring(iMark,39),
     2061                           chr(29)) no-error.
     2062      end.
     2063      else if substring(iMark,25,2) = "93" then
     2064      do:
     2065        vIdx = index(iMark,"92",25).
     2066        if vIdx > 1 then
     2067          vDM = substitute("&1&4&2&4&3",
     2068                           substring(iMark,1,24),
     2069                           substring(iMark,25,vIdx - 24 - 1),
     2070                           substring(iMark,vIdx),
     2071                           chr(29)) no-error.
     2072        else
     2073          vIdx = index(iMark,"3103",25).
     2074          if vIdx > 0 then
     2075          vDM = substitute("&1&4&2&4&3",
     2076                           substring(iMark,1,24),
     2077                           substring(iMark,25,vIdx - 24 - 1),
     2078                           substring(iMark,vIdx),
     2079                           chr(29)) no-error.
     2080          else
     2081            vDM = substitute("&1&3&2",
     2082                             substring(iMark,1,24),
     2083                             substring(iMark,25),
     2084                             chr(29)) no-error.
     2085      end.
     2086      else if substring(iMark,32,2) = "93" then
     2087      do:
     2088        vDM = substitute("&1&3&2",
     2089              substring(iMark,1,31),
     2090              substring(iMark,32),
     2091              chr(29)) no-error.
     2092      end.
     2093      return if vDM <> "" then vDm else iMark.
     2094   end.
     2095   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2096   function func-get-name-from-ext-type   returns char
     2097     ( p-ext-type as character   ,
     2098       p-caps     as logical ).
     2099   define variable v-ext-name as character no-undo .
     2100   run get-name-from-ext-type in this-procedure (
     2101       input p-ext-type  ,
     2102       input p-caps  ,
     2103       output v-ext-name )
     2104       no-error .
     2105       if error-status :error then do:
     2106          assign
     2107            v-ext-name = p-ext-type
     2108          .
     2109       end.
     2110    return (v-ext-name) .
     2111   end.
     2112   procedure get-name-from-ext-type :
     2113    do
     2114    on error undo, return error return-value
     2115    :
     2116   define input  parameter p-ext-type as character no-undo .
     2117   define input  parameter p-caps     as logical no-undo   .
     2118   define output parameter p-ext-name as character no-undo .
     2119   define variable v-num as integer no-undo .
     2120     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     2121       message
     2122         vss-include-info10 skip
     2123         "Неправильно задано значение входящего параметра! "
     2124         "Нет такого типа документов " p-ext-type
     2125         view-as alert-box error .
     2126         undo, return error .
     2127     end.
     2128     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     2129     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     2130     if p-caps  = true then do :
     2131        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     2132     end .
     2133     end.
     2134   end procedure.
