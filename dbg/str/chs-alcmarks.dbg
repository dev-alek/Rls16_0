     2715   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   function getattrUtdex returns char
     2717   (idb-num   as integer,
     2718    idoc-id   as integer,
     2719    iattrcode as character,
     2720    iExValue  as character  ):
     2721      define buffer utd-attr for utd-attr.
     2722      find first utd-attr where utd-attr.db-num eq idb-num
     2723                            and utd-attr.doc-id eq idoc-id
     2724                            and utd-attr.attr-code eq iattrcode
     2725      no-lock no-error.
     2726      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2727   end.
     2728   function getattrUtd returns char
     2729   (idb-num   as integer,
     2730    idoc-id   as integer,
     2731    iattrcode as character ):
     2732     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2733   end.
     2734   function setattrUtd returns logical
     2735   (idb-num   as integer,
     2736    idoc-id   as integer,
     2737    iattrcode as character,
     2738    iattrval  as character ):
     2739      define buffer utd-attr for utd-attr.
     2740      find first utd-attr where utd-attr.db-num eq idb-num
     2741                            and utd-attr.doc-id eq idoc-id
     2742                            and utd-attr.attr-code eq iattrcode
     2743      no-lock no-error.
     2744      if not available utd-attr
     2745      then do:
     2746         create utd-attr.
     2747         assign
     2748            utd-attr.db-num    = idb-num
     2749            utd-attr.doc-id    = idoc-id
     2750            utd-attr.attr-code = iattrcode
     2751            utd-attr.attr-value = iattrval
     2752         .
     2753      end.
     2754      else do:
     2755         if utd-attr.attr-value ne iattrval
     2756         then do:
     2757            find current utd-attr exclusive-lock no-error.
     2758            if available utd-attr
     2759            then
     2760               utd-attr.attr-value = iattrval.
     2761         end.
     2762      end.
     2763      release utd-attr.
     2764   end.
     2765   function GetAttrUtdlinesEx returns char
     2766   (idb-num   as integer,
     2767    idoc-id   as integer,
     2768    ilinenum  as integer,
     2769    iattrcode as character,
     2770    iExValue  as character  ):
     2771      define buffer utd-lines-attr for utd-lines-attr.
     2772      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2773                                  and utd-lines-attr.doc-id    eq idoc-id
     2774                                  and utd-lines-attr.lineNum   eq ilineNum
     2775                                  and utd-lines-attr.attr-code eq iattrcode
     2776      no-lock no-error.
     2777      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2778   end.
     2779   function GetAttrUtdlines returns char
     2780   (idb-num   as integer,
     2781    idoc-id   as integer,
     2782    ilinenum  as integer,
     2783    iattrcode as character ):
     2784      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2785   end.
     2786   function setattrUtdlines returns logical
     2787   (idb-num   as integer,
     2788    idoc-id   as integer,
     2789    ilinenum  as integer,
     2790    iattrcode as character,
     2791    iattrval  as character ):
     2792      define buffer utd-lines-attr for utd-lines-attr.
     2793      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2794                                  and utd-lines-attr.doc-id    eq idoc-id
     2795                                  and utd-lines-attr.lineNum   eq ilineNum
     2796                                  and utd-lines-attr.attr-code eq iattrcode
     2797      no-lock no-error.
     2798      if not available utd-lines-attr
     2799      then do:
     2800         if iattrval ne ?
     2801            and iattrval ne ""
     2802         then do:
     2803            create utd-lines-attr.
     2804            assign
     2805               utd-lines-attr.db-num    = idb-num
     2806               utd-lines-attr.doc-id    = idoc-id
     2807               utd-lines-attr.lineNum   = ilineNum
     2808               utd-lines-attr.attr-code = iattrcode
     2809               utd-lines-attr.attr-value = iattrval
     2810            .
     2811         end.
     2812      end.
     2813      else do:
     2814         if utd-lines-attr.attr-value ne iattrval
     2815         then do:
     2816            find current utd-lines-attr exclusive-lock no-error.
     2817            if available utd-lines-attr
     2818            then do:
     2819               if    iattrval eq ?
     2820                  or iattrval eq ""
     2821               then do:
     2822                  delete utd-lines-attr.
     2823               end.
     2824               else do:
     2825                  utd-lines-attr.attr-value = iattrval.
     2826               end.
     2827            end.
     2828         end.
     2829      end.
     2830      release utd-lines-attr.
     2831   end.
     2832   function GetAttrUtdMarkingLinesEx returns char
     2833   (idb-num   as integer,
     2834    idoc-id   as integer,
     2835    ilinenum  as integer,
     2836    imark     as character,
     2837    iattrcode as character,
     2838    iExValue  as character  ):
     2839      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2840      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2841                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2842                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2843                                          and utd-marking-lines-attr.mark      eq imark
     2844                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2845      no-lock no-error.
     2846      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     2847   end.
     2848   function GetAttrUtdMarkingLines returns char
     2849   (idb-num   as integer,
     2850    idoc-id   as integer,
     2851    ilinenum  as integer,
     2852    imark     as character,
     2853    iattrcode as character ):
     2854      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     2855   end.
     2856   function setattrUtdMarkingLines returns logical
     2857   (idb-num   as integer,
     2858    idoc-id   as integer,
     2859    ilinenum  as integer,
     2860    imark     as character,
     2861    iattrcode as character,
     2862    iattrval  as character ):
     2863      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     2864      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     2865                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2866                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2867                                          and utd-marking-lines-attr.mark      eq imark
     2868                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2869      no-lock no-error.
     2870      if not available utd-marking-lines-attr
     2871      then do:
     2872         if iattrval ne ?
     2873            and iattrval ne ""
     2874         then do:
     2875            create utd-marking-lines-attr.
     2876            assign
     2877               utd-marking-lines-attr.db-num     = idb-num
     2878               utd-marking-lines-attr.doc-id     = idoc-id
     2879               utd-marking-lines-attr.lineNum    = ilineNum
     2880               utd-marking-lines-attr.mark       = imark
     2881               utd-marking-lines-attr.attr-code  = iattrcode
     2882               utd-marking-lines-attr.attr-value = iattrval
     2883            .
     2884         end.
     2885      end.
     2886      else do:
     2887         if utd-marking-lines-attr.attr-value ne iattrval
     2888         then do:
     2889            find current utd-marking-lines-attr exclusive-lock no-error.
     2890            if available utd-marking-lines-attr
     2891            then do:
     2892               if    iattrval eq ?
     2893                  or iattrval eq ""
     2894               then do:
     2895                  delete utd-marking-lines-attr.
     2896               end.
     2897               else do:
     2898                  utd-marking-lines-attr.attr-value = iattrval.
     2899               end.
     2900            end.
     2901         end.
     2902      end.
     2903      release utd-marking-lines-attr.
     2904   end.
     2905   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2906   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2908   procedure gen-key-rec :
     2909     define input  parameter p-tbl-name    as character no-undo.
     2910     define input  parameter p-bh_tbl-name as handle    no-undo.
     2911     define output parameter p-key-rec     as character no-undo.
     2912     do
     2913     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2914     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2915     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2916     :
     2917       define variable fh               as handle    no-undo .
     2918       define variable v-ok             as logical   no-undo .
     2919       define variable v-inform         as character no-undo .
     2920       define variable v-ind            as integer   no-undo .
     2921       define variable v-idx-field-qnty as integer   no-undo .
     2922       if p-tbl-name = ?
     2923         or p-tbl-name = "":U
     2924       then do:
     2925         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info15 ).
     2926       end.
     2927       if not p-bh_tbl-name:available then do:
     2928         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info15, p-tbl-name ).
     2929       end.
     2930       assign
     2931         p-key-rec = p-tbl-name
     2932         v-inform  = p-bh_tbl-name:index-information(1)
     2933         v-ind     = 2
     2934       .
     2935       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2936       on error undo, return error
     2937       :
     2938         assign
     2939           v-inform = p-bh_tbl-name:index-information( v-ind )
     2940           v-ind    = v-ind + 1
     2941         .
     2942       end.
     2943       if v-inform = ?
     2944         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2945         or entry( 3, v-inform, ",":U ) <> "1":U
     2946       then do:
     2947         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, p-tbl-name ).
     2948       end.
     2949       else do:
     2950         assign
     2951           v-idx-field-qnty = num-entries( v-inform ) - 4
     2952         .
     2953         if v-idx-field-qnty < 2 then do:
     2954           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, p-tbl-name ).
     2955         end.
     2956         do v-ind = 1 to v-idx-field-qnty by 2
     2957         on error undo, return error
     2958         :
     2959           assign
     2960             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2961             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2962           .
     2963         end.
     2964       end.
     2965       if p-key-rec = ? then do:
     2966         assign
     2967           p-key-rec = "":U
     2968         .
     2969         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info15, p-tbl-name ).
     2970       end.
     2971     end.
     2972     return.
     2973   end procedure.
     2974   procedure gen-where-keyr-tab :
     2975     define input  parameter i-tableSerach as character no-undo.
     2976     define input  parameter i-tablekey   as character  no-undo.
     2977     define input  parameter p-key-rec    as character  no-undo.
     2978     define input  parameter p-key-handle as handle     no-undo .
     2979     define input  parameter p-db-name    as character  no-undo .
     2980     define input  parameter p-tt-handle  as handle     no-undo .
     2981     define output parameter o-Where      as character  no-undo.
     2982     do
     2983     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2984     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2985     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2986     :
     2987       define variable v-full-tbl-name  as character no-undo .
     2988       define variable bh_tbl-name      as handle    no-undo .
     2989       define variable fh_key           as handle    no-undo .
     2990       define variable fh_search        as handle    no-undo .
     2991       define variable v-field-num      as integer   no-undo .
     2992       define variable v-count-fld      as integer   no-undo .
     2993       define variable v-inform         as character no-undo .
     2994       define variable v-ind            as integer   no-undo .
     2995       define variable v-idx-field-qnty as integer   no-undo .
     2996       define variable v-field-name     as character no-undo .
     2997       define variable v-field-val      as character no-undo .
     2998       define variable v-word-link      as character no-undo .
     2999       define variable vTable           as character no-undo.
     3000       define variable bh_tbl-key       as handle    no-undo .
     3001       assign
     3002         p-key-rec = trim( p-key-rec )
     3003       .
     3004       if p-key-handle <> ? then do:
     3005         if not valid-handle(p-key-handle)
     3006            or p-key-handle:type <> "buffer"
     3007         then do:
     3008           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info15 ).
     3009         end.
     3010         if num-entries( p-key-rec, chr(3) ) > 1
     3011           or p-key-rec = ?
     3012           or p-key-rec = "":U
     3013         then do:
     3014           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info15, p-key-rec ).
     3015         end.
     3016       end.
     3017       else do:
     3018         if p-key-rec = ?
     3019           or p-key-rec = "":U
     3020         then do:
     3021           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     3022         end.
     3023       end.
     3024       assign
     3025         vTable = entry( 1 , p-key-rec, chr(3) )
     3026       .
     3027       if p-tt-handle <> ?
     3028         and ( not valid-handle(p-tt-handle)
     3029               or p-tt-handle:type <> "buffer"
     3030             )
     3031       then do:
     3032         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info15, vTable, chr(10) ).
     3033       end.
     3034       if p-tt-handle = ? then do:
     3035         assign
     3036           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3037         .
     3038         create buffer bh_tbl-name for table v-full-tbl-name .
     3039       end.
     3040       else do:
     3041         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3042       end.
     3043       assign
     3044         v-inform = bh_tbl-name:index-information(1)
     3045         v-ind    = 2
     3046       .
     3047       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3048       on error undo, return error
     3049       :
     3050         assign
     3051           v-inform = bh_tbl-name:index-information( v-ind )
     3052           v-ind    = v-ind + 1
     3053         .
     3054       end.
     3055       if v-inform = ?
     3056         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3057         or entry( 3, v-inform, ",":U ) <> "1":U
     3058       then do:
     3059         delete object bh_tbl-name no-error.
     3060         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info15, vTable ).
     3061       end.
     3062       assign
     3063         v-idx-field-qnty = num-entries( v-inform ) - 4
     3064       .
     3065       if v-idx-field-qnty < 2 then do:
     3066         delete object bh_tbl-name no-error.
     3067         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, vTable ).
     3068       end.
     3069       assign
     3070         o-where     = "where":U
     3071         v-word-link = "":U
     3072         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3073         v-count-fld = 0
     3074       .
     3075       if i-tablekey ne "" and i-tablekey ne ?
     3076       then do:
     3077         assign
     3078           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3079         .
     3080         create buffer bh_tbl-key for table v-full-tbl-name .
     3081       end.
     3082       if i-tableSerach ne "" and i-tableSerach ne ?
     3083       then do:
     3084         delete object bh_tbl-name no-error.
     3085         assign
     3086           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3087         .
     3088         create buffer bh_tbl-name for table v-full-tbl-name .
     3089       end.
     3090       block_where:
     3091       do v-ind = 1 to v-idx-field-qnty by 2
     3092       on error undo, return error
     3093       :
     3094         assign
     3095           v-count-fld = v-count-fld + 1
     3096         .
     3097         if p-key-handle = ?
     3098           and v-count-fld > v-field-num
     3099         then do:
     3100           leave block_where.
     3101         end.
     3102         define variable VfieldKeyTable as handle no-undo.
     3103         assign
     3104           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3105           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3106         .
     3107         if     bh_tbl-key ne ?
     3108         then do:
     3109            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3110            if VfieldKeyTable eq ?
     3111            then next block_where.
     3112         end.
     3113         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3114         then
     3115            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3116         else
     3117            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3118         if p-key-handle = ? then do:
     3119           assign
     3120             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3121           .
     3122         end.
     3123         else do:
     3124           assign
     3125             fh_key = p-key-handle:buffer-field( v-field-name )
     3126           .
     3127           if fh_key = ?
     3128             or not valid-handle( fh_key )
     3129           then do:
     3130             delete object bh_tbl-name.
     3131             if     bh_tbl-key ne ?
     3132             then
     3133                delete object bh_tbl-key.
     3134             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info15, p-key-handle:name, v-field-name ).
     3135           end.
     3136           assign
     3137             v-field-val = fh_key:buffer-value
     3138           .
     3139         end.
     3140         if fh_search:data-type ="character":U then do:
     3141           assign
     3142             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3143             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3144             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3145             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3146             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3147             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3148             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3149             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3150             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3151             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3152             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3153             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3154             v-field-val = substitute( '"&1"', v-field-val )
     3155           .
     3156         end.
     3157         assign
     3158           o-where = substitute( "&1 &2", o-where, v-field-val )
     3159         .
     3160         if v-word-link = "":U then do:
     3161           assign
     3162             v-word-link = "and":U
     3163           .
     3164         end.
     3165       end.
     3166       delete object bh_tbl-name.
     3167       if     bh_tbl-key ne ?
     3168       then
     3169          delete object bh_tbl-key.
     3170       if p-key-handle = ?
     3171         and v-count-fld <> v-field-num
     3172       then do:
     3173         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info15, vTable ).
     3174       end.
     3175     end.
     3176   end procedure.
     3177   procedure gen-hn-keyr-tab :
     3178     define input  parameter i-tableSerach as character no-undo.
     3179     define input  parameter i-tablekey   as character no-undo.
     3180     define input  parameter p-key-rec    as character no-undo.
     3181     define input  parameter p-key-handle as handle    no-undo .
     3182     define input  parameter p-db-name    as character no-undo .
     3183     define input  parameter p-tt-handle  as handle    no-undo .
     3184     define input  parameter p-stts-lock  as integer   no-undo .
     3185     define output parameter o-hn         as handle    no-undo.
     3186     define variable v-full-tbl-name as character no-undo.
     3187     define variable v-where         as character no-undo.
     3188     define variable bh_tbl-name     as handle    no-undo.
     3189     define variable vTable          as character no-undo.
     3190     do
     3191     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3192     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3193     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3194         run gen-where-keyr-tab(i-tableSerach,
     3195                                i-tablekey,
     3196                                p-key-rec,
     3197                                p-key-handle,
     3198                                p-db-name,
     3199                                p-tt-handle,
     3200                                output v-where).
     3201         if i-tableSerach ne "" and i-tableSerach ne ?
     3202         then do:
     3203            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3204            create buffer bh_tbl-name for table v-full-tbl-name .
     3205         end.
     3206         else do:
     3207            if p-tt-handle = ? then do:
     3208               assign
     3209                  vTable = entry( 1 , p-key-rec, chr(3) )
     3210               .
     3211               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3212               create buffer bh_tbl-name for table v-full-tbl-name .
     3213            end.
     3214            else do:
     3215               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3216            end.
     3217         end.
     3218         if p-tt-handle = ? then do:
     3219            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3220         end.
     3221         else do:
     3222            bh_tbl-name:find-first( v-where ) no-error .
     3223         end.
     3224         o-hn = bh_tbl-name.
     3225      end.
     3226   end procedure.
     3227   procedure gen-hn-keyr :
     3228     define input  parameter p-key-rec    as character no-undo.
     3229     define input  parameter p-key-handle as handle    no-undo .
     3230     define input  parameter p-db-name    as character no-undo .
     3231     define input  parameter p-tt-handle  as handle    no-undo .
     3232     define input  parameter p-stts-lock  as integer   no-undo .
     3233     define output parameter o-hn         as handle    no-undo.
     3234     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3235   end.
     3236   procedure gen-row-keyr :
     3237     define input  parameter p-key-rec    as character no-undo.
     3238     define input  parameter p-key-handle as handle    no-undo .
     3239     define input  parameter p-db-name    as character no-undo .
     3240     define input  parameter p-tt-handle  as handle    no-undo .
     3241     define input  parameter p-stts-lock  as integer   no-undo .
     3242     define output parameter p-tbl-row    as rowid     no-undo.
     3243     define output parameter p-tbl-name   as character no-undo.
     3244     define variable vHn as handle no-undo.
     3245       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3246       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3247       p-tbl-name =  vHn:table.
     3248       delete object vHn no-error.
     3249     if p-tbl-row = ? then do:
     3250       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info15, p-tbl-name, p-key-rec ).
     3251     end.
     3252     else do:
     3253       return.
     3254     end.
     3255   end procedure.
     3256   procedure gen-key-fv :
     3257     define input  parameter p-key-rec    as character no-undo .
     3258     define output parameter p-field-list as character no-undo .
     3259     define output parameter p-value-list as character no-undo.
     3260     do
     3261     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3262     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3263     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3264     :
     3265       define variable v-full-tbl-name  as character no-undo .
     3266       define variable bh_tbl-name      as handle    no-undo .
     3267       define variable v-tbl-name       as character no-undo .
     3268       define variable v-field-num      as integer   no-undo .
     3269       define variable v-count-fld      as integer   no-undo .
     3270       define variable v-inform         as character no-undo .
     3271       define variable v-ind            as integer   no-undo .
     3272       define variable v-idx-field-qnty as integer   no-undo .
     3273       define variable v-delim-key      as character no-undo .
     3274       if p-key-rec = ?
     3275         or p-key-rec = "":U
     3276       then do:
     3277         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     3278       end.
     3279       assign
     3280         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3281         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3282       .
     3283       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3284       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info15 ).
     3285       assign
     3286         v-inform = bh_tbl-name:index-information(1)
     3287         v-ind    = 2
     3288       .
     3289       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3290       on error undo, return error
     3291       :
     3292         assign
     3293           v-inform = bh_tbl-name:index-information( v-ind )
     3294           v-ind    = v-ind + 1
     3295         .
     3296       end.
     3297       if v-inform = ?
     3298         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3299         or entry( 3, v-inform, ",":U ) <> "1":U
     3300       then do:
     3301         delete object bh_tbl-name no-error.
     3302         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     3303       end.
     3304       assign
     3305         v-idx-field-qnty = num-entries( v-inform ) - 4
     3306       .
     3307       if v-idx-field-qnty < 2 then do:
     3308         delete object bh_tbl-name no-error.
     3309         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     3310       end.
     3311       assign
     3312         p-field-list = "":U
     3313         p-value-list = "":U
     3314         v-delim-key  = "":U
     3315         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3316         v-count-fld  = 0
     3317       .
     3318       block_where:
     3319       do v-ind = 1 to v-idx-field-qnty by 2
     3320       on error undo, return error
     3321       :
     3322         assign
     3323           v-count-fld = v-count-fld + 1
     3324         .
     3325         if v-count-fld > v-field-num then do:
     3326           leave block_where.
     3327         end.
     3328         assign
     3329           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3330           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3331         .
     3332         if v-ind = 1 then do:
     3333           assign
     3334             v-delim-key = chr(3)
     3335           .
     3336         end.
     3337       end.
     3338       delete object bh_tbl-name.
     3339       if v-count-fld <> v-field-num then do:
     3340         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info15, v-tbl-name ).
     3341       end.
     3342     end.
     3343   end procedure.
     3344   procedure gen-key-field :
     3345     define input  parameter p-table      as character no-undo .
     3346     define output parameter p-field-list as character no-undo .
     3347     do
     3348     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3349     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3350     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3351     :
     3352       define variable v-full-tbl-name  as character no-undo .
     3353       define variable bh_tbl-name      as handle    no-undo .
     3354       define variable v-tbl-name       as character no-undo .
     3355       define variable v-field-num      as integer   no-undo .
     3356       define variable v-count-fld      as integer   no-undo .
     3357       define variable v-inform         as character no-undo .
     3358       define variable v-ind            as integer   no-undo .
     3359       define variable v-idx-field-qnty as integer   no-undo .
     3360       define variable v-delim-key      as character no-undo .
     3361       if p-table = ?
     3362         or p-table = "":U
     3363       then do:
     3364         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info15 ).
     3365       end.
     3366       assign
     3367         v-tbl-name      = p-table
     3368         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3369       .
     3370       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3371       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info15 ).
     3372       assign
     3373         v-inform = bh_tbl-name:index-information(1)
     3374         v-ind    = 2
     3375       .
     3376       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3377       on error undo, return error
     3378       :
     3379         assign
     3380           v-inform = bh_tbl-name:index-information( v-ind )
     3381           v-ind    = v-ind + 1
     3382         .
     3383       end.
     3384       if v-inform = ?
     3385         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3386         or entry( 3, v-inform, ",":U ) <> "1":U
     3387       then do:
     3388         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     3389       end.
     3390       assign
     3391         v-idx-field-qnty = num-entries( v-inform ) - 4
     3392       .
     3393       if v-idx-field-qnty < 2 then do:
     3394         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     3395       end.
     3396       assign
     3397         p-field-list = "":U
     3398         v-delim-key  = "":U
     3399         v-count-fld  = 0
     3400       .
     3401       block_where:
     3402       do v-ind = 1 to v-idx-field-qnty by 2
     3403       on error undo, return error
     3404       :
     3405         assign
     3406           v-count-fld = v-count-fld + 1
     3407         .
     3408         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3409         if v-ind = 1 then do:
     3410           assign
     3411             v-delim-key = chr(3)
     3412           .
     3413         end.
     3414       end.
     3415       delete object bh_tbl-name.
     3416     end.
     3417   end procedure.
     3418   function AddUtdErrForTab returns logical
     3419   (idb-num         as integer ,
     3420    idoc-id         as integer ,
     3421    iTab            as character,
     3422    iObj            as handle ,
     3423    iCheckType      as character,
     3424    iCodeErr        as character,
     3425    iCheckObj       as character ):
     3426      define buffer utd-err for utd-err.
     3427      define buffer utd for utd.
     3428      find first utd where utd.db-num     eq idb-num
     3429                       and utd.doc-id     eq idoc-id
     3430                       and utd.Direction  eq 'Outbound'
     3431      no-lock no-error.
     3432      if available utd
     3433      then
     3434         return no.
     3435      define variable vRecKey as character no-undo.
     3436            run gen-key-rec (input iTab,
     3437                             input  iObj,
     3438                             output vRecKey).
     3439      find first utd-err where utd-err.db-num     eq idb-num
     3440                           and utd-err.doc-id     eq idoc-id
     3441                           and utd-err.CheckType  eq iCheckType
     3442                           and utd-err.CodeErr    eq iCodeErr
     3443                           and utd-err.CheckObj   eq iCheckObj
     3444      exclusive-lock no-error.
     3445      if not available utd-err
     3446      then do:
     3447         create utd-err.
     3448         assign
     3449            utd-err.db-num         = idb-num
     3450            utd-err.doc-id         = idoc-id
     3451            utd-err.CheckType      = iCheckType
     3452            utd-err.CodeErr        = iCodeErr
     3453            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3454            utd-err.reckey         = vRecKey
     3455            utd-err.qnty           = 1
     3456         .
     3457      end.
     3458      else
     3459         utd-err.qnty = utd-err.qnty + 1.
     3460      return utd-err.qnty eq 1.
     3461   end.
     3462   function AddUtdErr returns logical
     3463   (idb-num         as integer ,
     3464    idoc-id         as integer ,
     3465    iObj            as handle ,
     3466    iCheckType      as character,
     3467    iCodeErr        as character,
     3468    iCheckObj       as character ):
     3469      AddUtdErrForTab
     3470         (idb-num,
     3471          idoc-id,
     3472          iObj:table,
     3473          iObj,
     3474          iCheckType,
     3475          iCodeErr,
     3476          iCheckObj).
     3477   end.
     3478   function ClearUtdErrTypeCode returns logical
     3479   (idb-num         as integer,
     3480    idoc-id         as integer ,
     3481    iCheckType      as character,
     3482    iCodeErr        as character
     3483    ):
     3484      define buffer utd-err for utd-err.
     3485      if    iCheckType eq "*"
     3486         or iCheckType eq ?
     3487      then do:
     3488         if     iCodeErr ne ?
     3489            and iCodeErr ne "*"
     3490         then
     3491            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3492            view-as alert-box.
     3493         else
     3494         for each utd-err where utd-err.db-num  eq idb-num
     3495                            and utd-err.doc-id  eq idoc-id
     3496         exclusive-lock:
     3497            delete utd-err.
     3498         end.
     3499      end.
     3500      else do:
     3501         if    iCodeErr eq ?
     3502            or iCodeErr eq "*"
     3503         then do:
     3504            for each utd-err where utd-err.db-num     eq idb-num
     3505                               and utd-err.doc-id     eq idoc-id
     3506                               and utd-err.CheckType  eq iCheckType
     3507            exclusive-lock:
     3508               delete utd-err.
     3509            end.
     3510         end.
     3511         else do:
     3512            for each utd-err where utd-err.db-num     eq idb-num
     3513                               and utd-err.doc-id     eq idoc-id
     3514                               and utd-err.CheckType  eq iCheckType
     3515                               and ub.utd-err.CodeErr eq iCodeErr
     3516            exclusive-lock:
     3517               delete utd-err.
     3518            end.
     3519         end.
     3520      end.
     3521   end.
     3522   function ClearUtdErr returns logical
     3523   (idb-num         as integer,
     3524    idoc-id         as integer ,
     3525    iCheckType      as character
     3526    ):
     3527      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3528   end.
     3529   function GetMesError returns character
     3530   (itxt as character,
     3531    iobj as character ):
     3532    define variable vi as integer no-undo.
     3533    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3534       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3535    end.
     3536    return itxt.
     3537   end.
     3538   function GetTextErrorType returns character
     3539   (iCheckType as character,
     3540    iCodeErr   as character,
     3541    iChechObj  as character,
     3542    iType      as character  ):
     3543      define buffer code    for code.
     3544      define variable vError as character no-undo.
     3545      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3546                        and code.code   eq iCodeErr
     3547      no-lock no-error.
     3548      if available code
     3549      then do:
     3550         define variable vType as integer no-undo.
     3551         if code.misc3 eq "error"
     3552         then
     3553            vType = 0.
     3554         else if code.misc3 eq "warning"
     3555         then
     3556            vType = 1.
     3557         else if code.misc3 eq "Hiden"
     3558         then
     3559            vType = 2.
     3560         else
     3561            vtype = int(code.misc3) no-error.
     3562         case itype:
     3563            when "error"
     3564            then do:
     3565               if vtype eq 0
     3566               then
     3567                  vError = GetMesError(Code.CodeValue,iChechObj).
     3568            end.
     3569            when "warning"
     3570            then do:
     3571               if vtype <= 1
     3572               then
     3573                  vError = GetMesError(Code.CodeValue,iChechObj).
     3574            end.
     3575            otherwise do:
     3576               vError = GetMesError(Code.CodeValue,iChechObj).
     3577            end.
     3578         end.
     3579      end.
     3580      else
     3581         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3582      return vError.
     3583   end.
     3584   function GetTypeError returns integer
     3585   (iCheckType as character,
     3586    iCodeErr   as character):
     3587      define buffer code    for code.
     3588      define variable vType as integer no-undo.
     3589      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3590                        and code.code   eq iCodeErr
     3591      no-lock no-error.
     3592      if     not available code
     3593         and code.misc3 eq "error"
     3594      then
     3595         vType = 0.
     3596      else if code.misc3 eq "warning"
     3597      then
     3598         vType = 1.
     3599      else if code.misc3 eq "Hiden"
     3600      then
     3601         vType = 2.
     3602      else
     3603         vtype = int(code.misc3) no-error.
     3604      return vtype.
     3605   end.
     3606   function GetTextError returns character
     3607   (iCheckType as character,
     3608    iCodeErr   as character,
     3609    iChechObj  as character ):
     3610      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3611   end.
     3612   function GetErrForUtdStr returns character
     3613   (idb-num     as integer ,
     3614    idoc-id     as integer ,
     3615    iCheckType  as character
     3616    ):
     3617      define buffer utd-err for utd-err.
     3618      define buffer code    for code.
     3619      define variable vHQry as handle no-undo.
     3620      define variable vError as longchar no-undo.
     3621      define variable vErrorOne as longchar  no-undo.
     3622      define variable oError as character no-undo.
     3623      create query vHQry.
     3624      vHQry:set-buffers(buffer utd-err:handle).
     3625      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3626                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3627                               + if    iCheckType eq "*"
     3628                                    or iCheckType eq ?
     3629                                 then       ""
     3630                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3631      vHQry:query-open().
     3632      vHQry:get-first().
     3633      QRY-BLOCK:
     3634      repeat while not vHQry:query-off-end:
     3635         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3636         if     vErrorOne ne ""
     3637            and vErrorOne ne ?
     3638         then
     3639            vError = vError + ", " + vErrorOne.
     3640         vHQry:get-next().
     3641      end.
     3642      oError = substring(vError,3,4002).
     3643      return oError.
     3644   end.
     3645   function GetErrJsonForUtd returns character
     3646   (idb-num         as integer ,
     3647    idoc-id         as integer ,
     3648    iCheckType      as character
     3649    ):
     3650      define buffer utd-err for utd-err.
     3651      define variable vHQry as handle no-undo.
     3652      define variable vError as longchar no-undo.
     3653      define variable oError as character no-undo.
     3654      create query vHQry.
     3655      define variable vi as integer no-undo.
     3656      vHQry:set-buffers(buffer utd-err:handle).
     3657      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3658                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3659                               + if    iCheckType eq "*"
     3660                                    or iCheckType eq ?
     3661                                 then       ""
     3662                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3663      vHQry:query-open().
     3664      vHQry:get-first().
     3665      QRY-BLOCK:
     3666      repeat while not vHQry:query-off-end:
     3667         define variable vErrorOne as character no-undo.
     3668         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3669         if     vErrorOne ne ?
     3670            and vErrorOne ne ""
     3671         then do:
     3672            vi = vi + 1.
     3673            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3674                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3675                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3676         end.
     3677         vHQry:get-next().
     3678      end.
     3679      for first utd where utd.db-num eq idb-num
     3680                      and utd.doc-id eq idoc-id
     3681                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3682      no-lock,
     3683         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3684                                  and utd-marking-lines.doc-id eq idoc-id
     3685                                  and utd-marking-lines.doc-level eq 1
     3686      no-lock,
     3687         first marking where marking.mark eq utd-marking-lines.mark
     3688                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3689      no-lock:
     3690         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3691         if     vErrorOne ne ?
     3692            and vErrorOne ne ""
     3693         then do:
     3694            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3695                            + '","ОбъектОш":"' + marking.mark
     3696                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3697         end.
     3698      end.
     3699      if vError ne ""
     3700      then
     3701         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3702      return oError.
     3703   end.
     3704   function GetErrJsonForUtdReturn returns character
     3705   (idb-num         as integer ,
     3706    idoc-id         as integer ,
     3707    iCheckType      as character
     3708    ):
     3709      define buffer utd-err for utd-err.
     3710      define variable vHQry as handle no-undo.
     3711      define variable vError as longchar no-undo.
     3712      define variable oError as character no-undo.
     3713      define variable vi as integer no-undo.
     3714      create query vHQry.
     3715      vHQry:set-buffers(buffer utd-err:handle).
     3716      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3717                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3718                               + if    iCheckType eq "*"
     3719                                    or iCheckType eq ?
     3720                                 then       ""
     3721                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3722      vHQry:query-open().
     3723      vHQry:get-first().
     3724      QRY-BLOCK:
     3725      repeat while not vHQry:query-off-end:
     3726         define variable vErrorOne as character no-undo.
     3727         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3728         if     vErrorOne ne ?
     3729            and vErrorOne ne ""
     3730         then do:
     3731            vi = vi + 1.
     3732            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3733                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3734                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3735         end.
     3736         vHQry:get-next().
     3737      end.
     3738      if vError ne ""
     3739      then
     3740         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3741      return oError.
     3742   end.
     3743   function GetCodeTextError returns character
     3744   (iCheckType as character,
     3745    iCodeErr   as character,
     3746    iChechObj  as character,
     3747    output oCode as character,
     3748    output ovalue as character ):
     3749      define buffer code    for code.
     3750      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3751                        and code.code   eq iCodeErr
     3752      no-lock no-error.
     3753      if     available code
     3754      then do:
     3755         define variable vi as integer no-undo init ?.
     3756         vi = int(Code.misc3) no-error.
     3757         if    code.misc3 ne "error"
     3758            and vi ne 0
     3759         then
     3760            oCode = ?.
     3761         else if     Code.misc1 ne ?
     3762                 and Code.misc1 ne ""
     3763         then
     3764            assign
     3765               oCode  = GetMesError(Code.misc1,iChechObj)
     3766               ovalue = GetMesError(Code.misc2,iChechObj)
     3767            .
     3768      end.
     3769      return if oCode eq ""
     3770             then ""
     3771             else (oCode + "_" + ovalue).
     3772   end.
     3773   define temp-table TT-err no-undo
     3774     field code_ as character
     3775     field text_ as character
     3776   index code_ code_.
     3777   function GetErrTxtForUtd returns character
     3778   (idb-num         as integer ,
     3779    idoc-id         as integer ,
     3780    iCheckType      as character
     3781    ):
     3782      define buffer utd-err for utd-err.
     3783      define variable vHQry as handle no-undo.
     3784      define variable oError as character no-undo.
     3785      create query vHQry.
     3786      define variable vi as integer no-undo.
     3787      for each tt-err :
     3788         delete tt-err.
     3789      end.
     3790      vHQry:set-buffers(buffer utd-err:handle).
     3791      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3792                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3793                               + if    iCheckType eq "*"
     3794                                    or iCheckType eq ?
     3795                                 then       ""
     3796                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3797      vHQry:query-open().
     3798      vHQry:get-first().
     3799      define variable vcode as character no-undo.
     3800      define variable vvalue as character no-undo.
     3801      QRY-BLOCK:
     3802      repeat while not vHQry:query-off-end:
     3803         vi = vi + 1.
     3804         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3805         if vcode ne ?
     3806         then do:
     3807            find first tt-err where tt-err.code eq vcode
     3808            no-error.
     3809            if not available tt-err
     3810            then do:
     3811               create tt-err.
     3812               assign
     3813                  tt-err.code_ = vcode
     3814                  tt-err.text_ = vvalue
     3815               .
     3816            end.
     3817            else
     3818               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3819         end.
     3820         vHQry:get-next().
     3821      end.
     3822     find first utd where utd.db-num eq idb-num
     3823                         and utd.doc-id eq idoc-id
     3824         no-lock.
     3825      define buffer cancel_utd-lines for utd-lines.
     3826      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3827                                  and cancel_utd-lines.doc-id eq idoc-id
     3828      no-lock:
     3829         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3830         then do:
     3831            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3832                                        and utd-marking-lines.doc-id eq idoc-id
     3833                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3834            no-lock,
     3835               first marking where marking.mark eq utd-marking-lines.mark
     3836                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3837            no-lock:
     3838               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3839               find first tt-err where tt-err.code eq vcode
     3840               no-error.
     3841               if not available tt-err
     3842               then do:
     3843                  create tt-err.
     3844                  assign
     3845                     tt-err.code_ = vcode
     3846                     tt-err.text_ = vvalue
     3847                  .
     3848               end.
     3849               else
     3850                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3851            end.
     3852         end.
     3853         else do:
     3854            define variable vqnty as decimal no-undo.
     3855            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3856            if vqnty eq ? then vqnty = 0.
     3857            if vqnty ne cancel_utd-lines.Quantity
     3858            then do:
     3859               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3860               find first tt-err where tt-err.code eq vcode
     3861               no-error.
     3862               if not available tt-err
     3863               then do:
     3864                  create tt-err.
     3865                  assign
     3866                     tt-err.code_ = vcode
     3867                     tt-err.text_ = vvalue
     3868                  .
     3869               end.
     3870               else
     3871                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3872            end.
     3873         end.
     3874      end.
     3875      for each tt-err:
     3876         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3877      end.
     3878      return oError.
     3879   end.
     3880   define variable mFormatErr as character no-undo init "text".
     3881   function GetErrForUtd returns character
     3882   (idb-num         as integer ,
     3883    idoc-id         as integer ,
     3884    iType           as character
     3885    ):
     3886      if mFormatErr eq "text"
     3887      then
     3888         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3889      else do:
     3890         if itype eq "return"
     3891         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3892         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3893      end.
     3894   end.
     3895   function GetErrComText returns longchar
     3896   (icomment as character,
     3897    itext    as longchar ):
     3898       define variable vText as longchar no-undo.
     3899      if mFormatErr eq "text"
     3900      then do:
     3901         if icomment ne ""
     3902         then
     3903            icomment = substitute("comment:|&1|",icomment).
     3904         vText = icomment + itext.
     3905      end.
     3906      else do:
     3907         icomment = if icomment begins  '"'
     3908                    then icomment
     3909                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3910         vText = icomment + "," + itext.
     3911         vText = "~{" + trim(vText,",") + "~}".
     3912      end.
     3913      return vText.
     3914   end.
     3915   function CheckTypeForMarkLineType returns logical
     3916   (iObj            as handle,
     3917    iCheckType      as character,
     3918    iCodeErr        as character ,
     3919    iTypeErr        as character ):
     3920      define variable vRecKey-markLine as character no-undo.
     3921      define variable vGoodMark        as logical no-undo.
     3922      define variable vdb-num          as integer no-undo.
     3923      define variable vdoc-id          as integer no-undo.
     3924      define variable vlinenum         as integer no-undo.
     3925      define variable vErrorOne as character no-undo.
     3926      define buffer buf_utd-err for utd-err.
     3927      run gen-key-rec (input "utd-marking-lines",
     3928                       input  iObj,
     3929                       output vRecKey-markLine).
     3930      vGoodMark = yes.
     3931      vdb-num = iObj::db-num.
     3932      vdoc-id = iObj::doc-id.
     3933      vlinenum = iObj::linenum.
     3934      block-mark-err:
     3935      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3936                               and buf_utd-err.db-num = vdb-num
     3937                               and buf_utd-err.reckey = vRecKey-markLine
     3938                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3939                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3940      no-lock:
     3941         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3942         if     vErrorOne ne ?
     3943            and vErrorOne ne ""
     3944         then do:
     3945            vGoodMark = no.
     3946            leave block-mark-err.
     3947         end.
     3948      end.
     3949      return not vGoodMark.
     3950   end.
     3951   function CheckErrForMarkLineType returns logical
     3952   (iObj            as handle,
     3953    iType           as character  ):
     3954      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3955   end.
     3956   function CheckErrForMarkLine returns logical
     3957   (iObj            as handle):
     3958      return CheckErrForMarkLineType(iObj,"*").
     3959   end.
     3960   function CheckErrForLineTypeCode returns logical
     3961   (iObj                 as handle,
     3962    iCheckType           as character,
     3963    iCodeErr             as character,
     3964    iTypeErr             as character,
     3965    iOneErr              as logical):
     3966      define variable vRecKey-line     as character no-undo.
     3967      define buffer buf_utd-err for utd-err.
     3968      define variable vUtdlineError as logical no-undo.
     3969      define variable vErrorOne as character no-undo.
     3970            run gen-key-rec (input "utd-lines",
     3971                             input  iObj,
     3972                             output vRecKey-line).
     3973         define variable vdb-num as integer no-undo.
     3974         define variable vdoc-id as integer no-undo.
     3975         define variable vlinenum as integer no-undo.
     3976         vdb-num = iObj::db-num.
     3977         vdoc-id = iObj::doc-id.
     3978         vlinenum = iObj::linenum.
     3979         block-err:
     3980         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3981                                  and buf_utd-err.db-num = vdb-num
     3982                                  and buf_utd-err.reckey = vRecKey-line
     3983                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3984                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3985         no-lock:
     3986            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3987            if     vErrorOne ne ?
     3988               and vErrorOne ne ""
     3989            then do:
     3990               vUtdlineError = yes.
     3991               leave block-err.
     3992            end.
     3993         end.
     3994         if  not vUtdlineError
     3995         then do:
     3996            define variable vGoodMark as logical no-undo.
     3997            vGoodMark = yes.
     3998            block-line-err:
     3999            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     4000                                         and utd-marking-lines.doc-id  eq vdoc-id
     4001                                         and utd-marking-lines.LineNum eq vLineNum
     4002            no-lock:
     4003               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     4004               if     vGoodMark
     4005                  and iOneErr eq no
     4006               then
     4007                  leave block-line-err.
     4008               if     iOneErr = yes
     4009                  and not vGoodMark
     4010               then
     4011                  leave block-line-err.
     4012            end.
     4013            vUtdlineError = not vGoodMark.
     4014         end.
     4015      return vUtdlineError.
     4016   end.
     4017   function getErrForLineType returns character
     4018   (iObj            as handle,
     4019    iType           as character  ):
     4020      define variable vRecKey-line     as character no-undo.
     4021      define buffer buf_utd-err for utd-err.
     4022      define variable vUtdlineError as logical no-undo.
     4023      define variable vErrorOne as character no-undo.
     4024      define variable oError as character no-undo.
     4025            run gen-key-rec (input "utd-lines",
     4026                             input  iObj,
     4027                             output vRecKey-line).
     4028         define variable vdb-num as integer no-undo.
     4029         define variable vdoc-id as integer no-undo.
     4030         define variable vlinenum as integer no-undo.
     4031         vdb-num = iObj::db-num.
     4032         vdoc-id = iObj::doc-id.
     4033         vlinenum = iObj::linenum.
     4034         block-err:
     4035         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4036                                  and buf_utd-err.db-num = vdb-num
     4037                                  and buf_utd-err.reckey = vRecKey-line
     4038                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     4039         no-lock:
     4040            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     4041            if     vErrorOne ne ?
     4042               and vErrorOne ne ""
     4043            then do:
     4044               oError = oError + vErrorOne + " ".
     4045            end.
     4046         end.
     4047      return oError.
     4048   end.
     4049   function CheckErrForLineType returns logical
     4050   (iObj            as handle,
     4051    iType           as character  ):
     4052       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     4053   end.
     4054   function CheckErrForLine returns logical
     4055   (iObj            as handle):
     4056      return CheckErrForLineType(iobj,"*").
     4057   end.
     4058   function CheckErrForUtd returns logical
     4059   (idb-num         as integer ,
     4060    idoc-id         as integer ):
     4061      for each utd-lines where utd-lines.db-num eq idb-num
     4062                           and utd-lines.doc-id eq idoc-id
     4063      no-lock :
     4064         if not CheckErrForLine (buffer ub.utd-lines:handle)
     4065         then
     4066            return no.
     4067      end.
     4068      return yes.
     4069   end.
     4070   function CheckMarkUtd-28rel return logical
     4071    (input idb-num as integer,
     4072    input idoc-id as integer):
     4073    define buffer utd                   for utd.
     4074    define buffer utd-lines             for utd-lines.
     4075    define buffer utd-marking-lines     for utd-marking-lines.
     4076    define variable v-par-type as character no-undo.
     4077    define variable vgdsNoMark as logical no-undo.
     4078    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4079      define variable v-par-val  as character no-undo.
     4080      find first utd where utd.db-num eq idb-num
     4081                       and utd.doc-id eq idoc-id
     4082      no-lock no-error.
     4083      if available utd
     4084      then do:
     4085         if     utd.obj-code ne ?
     4086            and utd.obj-type ne ?
     4087         then do:
     4088            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     4089            Block-utd-lines:
     4090            for each utd-lines where utd-lines.db-num eq idb-num
     4091                                 and utd-lines.doc-id eq idoc-id
     4092            no-lock:
     4093               if     utd-lines.gds-code ne ?
     4094                  and utd-lines.gds-code ne 0
     4095               then do:
     4096                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4097                       ( utd-lines.gds-code,
     4098                         'mark-type':U,
     4099                          output v-par-val,
     4100                          output v-par-type
     4101                       ).
     4102                  if     EDOParSec:IsEdo
     4103                     and EDOParSec:GetIsEDOForType(v-par-val)
     4104                  then do:
     4105                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4106                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4107                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     4108                                                    and length(utd-marking-lines.mark) > 13
     4109                     no-lock no-error.
     4110                     if     avail utd-marking-lines
     4111                        and not CheckErrForLine(buffer utd-lines:handle)
     4112                     then
     4113                        leave Block-utd-lines.
     4114                  end.
     4115                  else
     4116                     vgdsNoMark = yes.
     4117               end.
     4118            end.
     4119            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     4120            if vgdsNoMark then return available utd-lines . else return yes .
     4121         end.
     4122      end.
     4123      return yes.
     4124   end.
     4125   function CheckMarkUtd return logical
     4126    (input idb-num  as integer,
     4127     input idoc-id  as integer):
     4128     define buffer utd-lines             for ub.utd-lines.
     4129     block-line:
     4130     for each utd-lines where utd-lines.db-num eq idb-num
     4131                          and utd-lines.doc-id eq idoc-id
     4132     no-lock:
     4133        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     4134        then
     4135           leave block-line.
     4136     end.
     4137     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     4138     return available utd-lines.
     4139   end.
     4140   function CheckNotMarkUtd return logical
     4141    (input idb-num  as integer,
     4142     input idoc-id  as integer):
     4143     define buffer utd-lines             for ub.utd-lines.
     4144     for each utd-lines where utd-lines.db-num eq idb-num
     4145                          and utd-lines.doc-id eq idoc-id
     4146     no-lock:
     4147        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     4148        then
     4149           return yes.
     4150     end.
     4151     return no.
     4152   end.
     4153   function CheckMarkUtdLine return logical
     4154    (input idb-num  as integer,
     4155     input idoc-id  as integer,
     4156     input iLineNum as integer):
     4157    define buffer utd                   for utd.
     4158    define buffer utd-lines             for utd-lines.
     4159    define buffer utd-marking-lines     for utd-marking-lines.
     4160    define variable v-par-type as character no-undo.
     4161    define variable vMarking        as logical no-undo.
     4162    define variable vArtic          as logical no-undo.
     4163    define variable vTransitional   as logical no-undo.
     4164    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4165      define variable v-par-val  as character no-undo.
     4166      find first utd where utd.db-num eq idb-num
     4167                       and utd.doc-id eq idoc-id
     4168      no-lock no-error.
     4169      if available utd
     4170      then do:
     4171         if     utd.obj-code ne ?
     4172            and utd.obj-type ne ?
     4173         then do:
     4174            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     4175            Block-utd-lines:
     4176            for each utd-lines where utd-lines.db-num   eq idb-num
     4177                                 and utd-lines.doc-id   eq idoc-id
     4178                                 and utd-lines.LineNum  eq iLineNum
     4179            no-lock:
     4180               if     utd-lines.gds-code ne ?
     4181                  and utd-lines.gds-code ne 0
     4182               then do:
     4183                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4184                       ( utd-lines.gds-code,
     4185                         'mark-type':U,
     4186                          output v-par-val,
     4187                          output v-par-type
     4188                       ).
     4189                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     4190                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     4191                  if vMarking
     4192                  then do:
     4193                     block-marking:
     4194                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4195                                                    and utd-marking-lines.doc-id   eq idoc-id
     4196                                                    and utd-marking-lines.LineNum  eq iLineNum
     4197                                                    and length(utd-marking-lines.mark) > 13
     4198                     no-lock:
     4199                        if isOAD(utd-marking-lines.mark)
     4200                        then do:
     4201                           assign
     4202                              vArtic   = yes
     4203                              vMarking = no
     4204                           .
     4205                           leave block-marking.
     4206                        end.
     4207                     end.
     4208                  end.
     4209                  if vArtic
     4210                  then do:
     4211                     block-artic:
     4212                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4213                                                    and utd-marking-lines.doc-id   eq idoc-id
     4214                                                    and utd-marking-lines.LineNum  eq iLineNum
     4215                                                    and length(utd-marking-lines.mark) > 13
     4216                     no-lock:
     4217                        if isMark(utd-marking-lines.mark)
     4218                        then do:
     4219                           assign
     4220                              vArtic   = no
     4221                              vMarking = yes
     4222                           .
     4223                           leave block-artic.
     4224                        end.
     4225                     end.
     4226                  end.
     4227                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     4228                  if vTransitional
     4229                  then do:
     4230                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     4231                                                    and utd-marking-lines.doc-id   eq idoc-id
     4232                                                    and utd-marking-lines.LineNum  eq iLineNum
     4233                                                    and length(utd-marking-lines.mark) > 13
     4234                     no-lock no-error.
     4235                     if not available utd-marking-lines
     4236                     then assign
     4237                        vMarking = no
     4238                        vArtic   = no
     4239                     .
     4240                  end.
     4241               end.
     4242               else
     4243                  assign
     4244                     vMarking      = yes
     4245                     vArtic        = no
     4246                     vTransitional = no
     4247                  .
     4248               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     4249               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     4250               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     4251            end.
     4252         end.
     4253      end.
     4254      return vMarking or vArtic.
     4255   end.
     4256   function getMarkUtdLine return logical
     4257    (input  idb-num  as integer,
     4258     input  idoc-id  as integer,
     4259     input  iLineNum as integer,
     4260     output oMarking        as logical,
     4261     output oArtic          as logical,
     4262     output oTransitional   as logical):
     4263     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     4264     oArtic        = not oMarking
     4265            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     4266     oTransitional = (oMarking or oArtic)
     4267            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     4268   end.
     4269   function CheckMarking return logical
     4270    (input idb-num as integer,
     4271    input idoc-id as integer,
     4272    input iTypeErr as character ):
     4273     define variable vMarkutd as logical no-undo.
     4274     define variable vCrErr   as logical no-undo.
     4275     define buffer utd-lines         for utd-lines.
     4276     define buffer utd-marking-lines for utd-marking-lines.
     4277     define buffer marking           for marking.
     4278     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     4279      block-line:
     4280      for each utd-lines where utd-lines.db-num eq idb-num
     4281                           and utd-lines.doc-id eq idoc-id
     4282      no-lock:
     4283         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     4284         then do:
     4285            for each utd-marking-lines
     4286                     where utd-marking-lines.db-num  = utd-lines.db-num
     4287                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4288                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4289            no-lock:
     4290               if isMark(utd-marking-lines.mark)
     4291               then do:
     4292                  find first marking where marking.mark eq utd-marking-lines.mark
     4293                  no-lock no-error.
     4294                  if not available marking
     4295                  then do:
     4296                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     4297                     vCrErr = yes.
     4298                     next block-line.
     4299                  end.
     4300               end.
     4301            end.
     4302         end.
     4303      end.
     4304      return vCrErr.
     4305   end.
     4306   function CheckMarkForType return logical
     4307    (input idb-num   as integer,
     4308     input idoc-id   as integer):
     4309      define variable vMarking        as logical no-undo.
     4310      define variable vArtic          as logical no-undo.
     4311      define variable vTransitional   as logical no-undo.
     4312      define buffer utd-lines         for utd-lines.
     4313      define buffer utd-marking-lines for utd-marking-lines.
     4314      block-line:
     4315      for each utd-lines where utd-lines.db-num eq idb-num
     4316                           and utd-lines.doc-id eq idoc-id
     4317      no-lock:
     4318         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     4319                          output vMarking         , output vArtic          , output vTransitional).
     4320         for each utd-marking-lines
     4321                     where utd-marking-lines.db-num  = utd-lines.db-num
     4322                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     4323                       and utd-marking-lines.LineNum = utd-lines.LineNum
     4324         no-lock:
     4325            if length(utd-marking-lines.mark) < 14
     4326            then do:
     4327               if (vMarking or vArtic) and not vTransitional
     4328               then
     4329                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4330            end.
     4331            else if not isMark(utd-marking-lines.mark)
     4332            then do:
     4333               if vMarking
     4334               then
     4335                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     4336            end.
     4337            else do:
     4338            end.
     4339         end.
     4340      end.
     4341   end.
     4342   function WeighedProd return logical
     4343      ( input p-gds-code as integer) :
     4344      define variable v-par-val  as character no-undo.
     4345      define variable v-par-type as character no-undo.
     4346              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4347               ( p-gds-code,
     4348                 'weighed-gds':U,
     4349                  output v-par-val,
     4350                  output v-par-type
     4351               ).
     4352      return logical(v-par-val).
     4353   end.
     4354   function WghProdVariable return logical
     4355       (input p-obj-type as char,
     4356        input p-obj-code as integer,
     4357        input p-gds-code as integer) :
     4358      define variable v-wgh-val  as character no-undo.
     4359      define variable v-par-val  as character no-undo.
     4360      define variable v-par-type as character no-undo.
     4361      define variable vMarking        as logical no-undo.
     4362      define variable vArtic          as logical no-undo.
     4363      define variable vTransitional   as logical no-undo.
     4364      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4365         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4366           ( p-gds-code,
     4367             'weighed-gds':U,
     4368              output v-wgh-val,
     4369              output v-par-type
     4370           ).
     4371       if logical(v-wgh-val) = yes then do:
     4372           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4373               ( p-gds-code,
     4374                 'mark-type':U,
     4375                  output v-par-val,
     4376                  output v-par-type
     4377               ).
     4378           if v-par-val <> "" then do:
     4379               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     4380               assign
     4381                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     4382                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     4383                  .
     4384           end.
     4385      end.
     4386      if v-wgh-val > "" and (vMarking or vArtic)
     4387      then return yes.
     4388      else return no.
     4389   end.
     4390   function MarkWeight return decimal
     4391      ( input p-mark as character) :
     4392      define buffer  buf_marking-attr for  ub.marking-attr.
     4393      define variable vMarkWeight as decimal no-undo.
     4394      vMarkWeight = 0.
     4395      if p-mark <> "" and p-mark <> ?
     4396      then do:
     4397          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     4398                                        and buf_marking-attr.attr-code eq "weight"
     4399             no-lock no-error.
     4400          if not available buf_marking-attr
     4401          then do :
     4402            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     4403                                          and buf_marking-attr.attr-code eq "weight"
     4404               no-lock no-error.
     4405          end .
     4406          if avail buf_marking-attr
     4407          then vMarkWeight = dec(buf_marking-attr.attr-value).
     4408      end.
     4409      return vMarkWeight.
     4410   end.
     4411   define temp-table tt-mark no-undo
     4412     field alcmark as character.
     4413   define variable thMarkSts  as class ibs.th.str.marking.sts.mark no-undo.
     4414   define variable EDOParSec  as class ibs.th.gbl.env.prmtrs.edo   no-undo.
     4415   define variable Marking    as class ibs.th.skt.ControlledClients.marking.
     4416   define variable extGdsObj       as class     extgds.
     4417   define variable iLang           as integer   no-undo.
     4418   define variable p-value-logical as logical no-undo.
     4419   define variable p-value-character  as character no-undo.
     4420   define variable p-value-date       as date no-undo.
     4421   define variable p-value-decimal    as decimal no-undo.
     4422   define variable p-value-integer    as integer no-undo.
     4423   define variable p-param-type       as character no-undo.
     4424   define variable v-tth as handle no-undo .
     4425   define variable v-alc-code      as character no-undo .
     4426   define variable v-proc-name-err as character no-undo initial 'impmark.txt'.
     4427   define variable l-error         as logical   no-undo.
     4428   define variable is-impfile      as logical   no-undo.
     4429   define variable v-user-action   as character no-undo.
     4430   define variable v-printed       as logical   no-undo.
     4431   define variable Tree            as class     tree   no-undo .
     4432   define buffer t_doc        for ub.trn-doc .
     4433   define buffer bf_trn-doc   for ub.trn-doc .
     4434   define buffer buf_gen-attr for ub.gen-attr .
     4435   define buffer bf_parts     for ub.parts .
     4436   define buffer out_parts    for ub.parts .
     4437   define buffer bf_gen-attr  for ub.gen-attr .
     4438   define buffer bf_marking-lines for ub.marking-lines .
     4439   define buffer buf_goods    for ub.goods .
     4440   define buffer bf_prod-bc  for ub.prod-bc .
     4441   define buffer bf_bar-code for ub.bar-code .
     4442   define variable v-scan-str       as character no-undo.
     4443   define VARIABLE v-manual         as logical   no-undo .
     4444   DEFINE VARIABLE v-timedelay as integer no-undo .
     4445   define variable v-is-return as logical no-undo init no .
     4446   define variable v-gds-code as integer no-undo .
     4447   define variable v-free-qnty as decimal no-undo .
     4448   define variable v-free-part-qnty as decimal no-undo .
     4449   define variable v-scan-qnty as decimal no-undo .
     4450   define variable varvalue as character no-undo.
     4451   define variable vartype  as character no-undo.
     4452   define stream str-err .
     4453   define stream in-stream.
     4454   DEFINE BUTTON b-exit AUTO-GO
     4455     LABEL "&Выход"
     4456     SIZE 10 BY 1
     4457     BGCOLOR 8 .
     4458   DEFINE BUTTON b-imp
     4459     LABEL "Импорт"
     4460     SIZE 10 BY 1.
     4461   DEFINE VARIABLE F-text AS CHARACTER FORMAT "X(256)":U
     4462     VIEW-AS FILL-IN
     4463     SIZE 83 BY 1.25
     4464     FGCOLOR 12 NO-UNDO.
     4465   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     4466     LABEL "Марка"
     4467     VIEW-AS FILL-IN
     4468     SIZE 80 BY 1
     4469     BGCOLOR 15 NO-UNDO.
     4470   define variable mWork as logical no-undo.
     4471   DEFINE FRAME Dialog-Frame
     4472     b-exit AT ROW 1 COL 1
     4473     b-imp AT ROW 1 COL 32.5 WIDGET-ID 2
     4474     v-mark AT ROW 2.71 COL 7.5 COLON-ALIGNED
     4475     F-text AT ROW 4.24 COL 4 NO-LABEL WIDGET-ID 224
     4476     SPACE(2.59) SKIP(0.70)
     4477     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4478     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4479     TITLE "Сканирование марок"
     4480     DEFAULT-BUTTON b-exit.
     4481   ASSIGN
     4482     FRAME Dialog-Frame:SCROLLABLE = FALSE
     4483     FRAME Dialog-Frame:HIDDEN     = TRUE.
     4484   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4485     DO:
     4486       APPLY "END-ERROR":U TO SELF.
     4487     END.
     4488   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     4489     DO:
     4490       mWork = false.
     4491       if p-mode = 'ДОБАВЛЕНИЕ':U then
     4492       do:
     4493         run save_update  no-error.
     4494         if error-status:error
     4495         then
     4496            return no-apply.
     4497       end.
     4498       else
     4499       do:
     4500         define variable vcodident as character no-undo.
     4501         vcodident = GetCodeIdent(v-mark:screen-value).
     4502         p-mark = vcodident .
     4503       end.
     4504     END.
     4505   ON return OF b-exit IN FRAME Dialog-Frame
     4506     DO:
     4507        mWork = false.
     4508       if p-mode = 'ДОБАВЛЕНИЕ':U then
     4509       do:
     4510         run save_update .
     4511         if error-status:error
     4512         then
     4513            return no-apply.
     4514       end.
     4515       else
     4516       do:
     4517         define variable vcodident as character no-undo.
     4518         vcodident = GetCodeIdent(v-mark:screen-value).
     4519         p-mark = vcodident .
     4520       end.
     4521     END.
     4522   ON choose OF b-imp IN FRAME Dialog-Frame
     4523     DO:
     4524       is-impfile = true.
     4525       run proc-choose-file no-error.
     4526       is-impfile = false.
     4527     END.
     4528   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     4529     DO:
     4530       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4531       run adm/shattri.p (
     4532                  input "get":U
     4533                  ,input  v-cntxt-obj-type
     4534                  ,input  v-cntxt-obj-code
     4535                  ,input  'marking':U
     4536                  ,input  'rus-key':U
     4537                  ,output p-value-character
     4538                  ,output p-value-date
     4539                  ,output p-value-decimal
     4540                  ,output p-value-integer
     4541                  ,output p-value-logical
     4542                  ,output p-param-type
     4543                  ,input-output table-handle v-tth
     4544                  ) no-error .
     4545       IF p-value-logical = yes THEN  iLang = 68748313.
     4546       run ActivateKeyboardLayout (input iLang, input 0).
     4547     END.
     4548   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     4549     DO:
     4550       assign frame Dialog-Frame v-mark .
     4551     END.
     4552   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     4553     DO:
     4554       if p-mode = 'ДОБАВЛЕНИЕ':U then
     4555       do:
     4556         run save_update .
     4557       end.
     4558       else
     4559       do:
     4560         apply "CHOOSE" to b-exit in frame Dialog-Frame.
     4561       end.
     4562     END.
     4563   ON return OF v-mark IN FRAME Dialog-Frame
     4564     DO:
     4565       if p-mode = 'ДОБАВЛЕНИЕ':U then
     4566       do:
     4567         run save_update .
     4568       end.
     4569       else
     4570       do:
     4571         apply "CHOOSE" to b-exit in frame Dialog-Frame.
     4572       end.
     4573     END.
     4574   ON any-printable OF v-mark IN FRAME Dialog-Frame
     4575   do:
     4576     run proc-any-key.
     4577   end.
     4578   ON any-printable OF b-exit IN FRAME Dialog-Frame
     4579   do:
     4580     run proc-any-key.
     4581   end.
     4582   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4583     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4584   MAIN-BLOCK:
     4585   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4586     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4587     thMarkSts = ObjSrv:Env:Marking:Sts:Mark.
     4588     find first t_doc no-lock where t_doc.doc-code = p-doc-code no-error .
     4589     EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t_doc.obj-type, t_doc.obj-code).
     4590     Marking = new ibs.th.skt.ControlledClients.marking().
     4591   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t_doc.doc-code ,
     4592                           input 'is-return':U ,
     4593                          output varvalue ,
     4594                          output vartype ) no-error .
     4595     if varvalue = "yes" then do:
     4596       v-is-return = yes .
     4597       find first bf_parts no-lock where recid(bf_parts) = integer(p-message) no-error .
     4598       p-message = "" .
     4599       if available bf_parts
     4600       then do :
     4601         find first buf_goods no-lock where buf_goods.artic     = bf_parts.artic
     4602                                        and buf_goods.prod-type = bf_parts.prod-type
     4603                                        and buf_goods.prod-code = bf_parts.prod-code
     4604                                        .
     4605         frame Dialog-Frame:title = "Сканирование марок по товару " + string(buf_goods.gds-code) + " " + buf_goods.gds-name .
     4606         v-free-part-qnty = bf_parts.fact-qnty .
     4607         for each bf_gen-attr no-lock where bf_gen-attr.table-name = 'parts':U
     4608                                        and bf_gen-attr.attr-code  = "in-part-key"
     4609                                        and bf_gen-attr.attr-value =  "parts"                + chr(3) +
     4610    bf_parts.obj-type           + chr(3) +
     4611    string(bf_parts.obj-code)   + chr(3) +
     4612    bf_parts.artic              + chr(3) +
     4613    bf_parts.prod-type          + chr(3) +
     4614    string(bf_parts.prod-code)  + chr(3) +
     4615    bf_parts.In-code            + chr(3) +
     4616    bf_parts.Out-code           + chr(3) +
     4617    bf_parts.part-Code          + chr(3) +
     4618    string(bf_parts.prt-code)
     4619    ,
     4620         first out_parts no-lock where out_parts.obj-type  = entry(2, bf_gen-attr.p-key, chr(3))
     4621                                   and out_parts.obj-code  = integer(entry(3, bf_gen-attr.p-key, chr(3)))
     4622                                   and out_parts.artic     = entry(4, bf_gen-attr.p-key, chr(3))
     4623                                   and out_parts.prod-type = entry(5, bf_gen-attr.p-key, chr(3))
     4624                                   and out_parts.prod-code = integer(entry(6, bf_gen-attr.p-key, chr(3)))
     4625                                   and out_parts.in-code   = entry(7, bf_gen-attr.p-key, chr(3))
     4626                                   and out_parts.out-code  = entry(8, bf_gen-attr.p-key, chr(3))
     4627                                   and out_parts.part-code = entry(9, bf_gen-attr.p-key, chr(3))
     4628         :
     4629           v-free-part-qnty = v-free-part-qnty - out_parts.fact-qnty .
     4630         end .
     4631         if v-free-part-qnty < 0 then v-free-part-qnty = 0 .
     4632         run calcMarks in this-procedure
     4633           (bf_parts.obj-type, bf_parts.obj-code, buffer buf_goods, output v-free-qnty, output v-scan-qnty).
     4634         p-message = "Доступно по партии: " + string(v-free-part-qnty) +
     4635                "     Книжный остаток: " + string(v-free-qnty) +
     4636                "     Просканировано: " + string(v-scan-qnty) .
     4637       end .
     4638     end.
     4639     if p-gds-code <> ? then
     4640     do:
     4641       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error.
     4642       if avail buf_goods then
     4643       do:
     4644         run calcMarks in this-procedure
     4645           (t_doc.obj-type, t_doc.obj-code, buffer buf_goods, output v-free-qnty, output v-scan-qnty).
     4646         p-message = "Книжный остаток: " + string(v-free-qnty) +
     4647                "     Просканировано: " + string(v-scan-qnty) .
     4648       end.
     4649     end.
     4650     if v-free-qnty = 0 then
     4651     do:
     4652       message "Количество просканированных марок достигло книжного остатка." view-as alert-box.
     4653       return.
     4654     end.
     4655     F-text = p-message .
     4656     Tree = ObjSrv:Lib:MarkingTree .
     4657     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4658     run adm/shattri.p (
     4659                  input "get":U
     4660                  ,input  v-cntxt-obj-type
     4661                  ,input  v-cntxt-obj-code
     4662                  ,input  'marking':U
     4663                  ,input  'rus-key':U
     4664                  ,output p-value-character
     4665                  ,output p-value-date
     4666                  ,output p-value-decimal
     4667                  ,output p-value-integer
     4668                  ,output p-value-logical
     4669                  ,output p-param-type
     4670                  ,input-output table-handle v-tth
     4671                  ) no-error .
     4672     IF p-value-logical = yes THEN  iLang = 68748313.
     4673     run ActivateKeyboardLayout (input iLang, input 0).
     4674     RUN enable_UI.
     4675     apply "entry" to v-mark in FRAME Dialog-Frame.
     4676     if v-is-return
     4677     then do :
     4678       hide b-imp in frame Dialog-Frame.
     4679     end .
     4680     find first trn-doc exclusive-lock where trn-doc.doc-code = p-doc-code no-error .
     4681       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     4682       then v-manual = yes.
     4683       else do:
     4684           v-manual = no .
     4685           v-mark:READ-ONLY IN FRAME Dialog-Frame        = TRUE .
     4686       end.
     4687       mWork = true.
     4688     do while mWork:
     4689        WAIT-FOR GO OF FRAME Dialog-Frame pause 1.
     4690        run gbl/readcom.p.
     4691        if length(return-value) > 0
     4692        then do:
     4693           v-scan-str = return-value.
     4694           v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4695        end.
     4696     end.
     4697   END.
     4698   RUN disable_UI.
     4699   PROCEDURE ActivateKeyboardLayout external "user32" :
     4700     define input parameter P1 as long.
     4701     define input parameter P2 as long.
     4702   end procedure.
     4703   PROCEDURE calcMarks :
     4704     define input  parameter p-obj-type as  character no-undo.
     4705     define input  parameter p-obj-code as  integer   no-undo.
     4706     define parameter buffer b_goods    for ub.goods.
     4707     define output parameter o-free-qnty as  decimal   no-undo.
     4708     define output parameter o-scan-qnty as  decimal   no-undo.
     4709     define buffer bf_gds-obj  for ub.gds-obj .
     4710     define buffer buf_parts         for ub.parts .
     4711     find first bf_gds-obj no-lock where bf_gds-obj.obj-type  = p-obj-type
     4712                                     and bf_gds-obj.obj-code  = p-obj-code
     4713                                     and bf_gds-obj.artic     = b_goods.artic
     4714                                     and bf_gds-obj.prod-type = b_goods.prod-type
     4715                                     and bf_gds-obj.prod-code = b_goods.prod-code
     4716                                     no-error .
     4717     if available bf_gds-obj then
     4718       o-free-qnty = bf_gds-obj.free-qnty .
     4719     for each buf_parts no-lock where buf_parts.out-code  = t_doc.doc-code
     4720                                  and buf_parts.obj-type  = t_doc.obj-type
     4721                                  and buf_parts.obj-code  = t_doc.obj-code
     4722                                  and buf_parts.artic     = b_goods.artic
     4723     :
     4724       o-scan-qnty = o-scan-qnty +  buf_parts.qnty .
     4725     end .
     4726   END PROCEDURE.
     4727   PROCEDURE disable_UI :
     4728     HIDE FRAME Dialog-Frame.
     4729   END PROCEDURE.
     4730   PROCEDURE dispmessage :
     4731   do with frame Dialog-Frame:
     4732     define input parameter p-str as character no-undo.
     4733     if is-impfile
     4734       then
     4735     do:
     4736       put stream str-err unformatted
     4737         p-str
     4738         skip.
     4739       l-error = yes .
     4740     end.
     4741     else
     4742     do:
     4743       message p-str view-as alert-box information title "Информация".
     4744     end.
     4745     assign
     4746       v-mark              = ""
     4747       v-mark:screen-value = ""
     4748       v-scan-str          = ""
     4749       p-mark              = ""
     4750     .
     4751   end.
     4752   END PROCEDURE.
     4753   PROCEDURE enable_UI :
     4754     DISPLAY v-mark F-text
     4755       WITH FRAME Dialog-Frame.
     4756     if p-mode = 'ДОБАВЛЕНИЕ':U then
     4757     do:
     4758       enable b-imp  with frame Dialog-Frame .
     4759     end.
     4760     ENABLE b-exit v-mark
     4761       WITH FRAME Dialog-Frame.
     4762     VIEW FRAME Dialog-Frame.
     4763   END PROCEDURE.
     4764   PROCEDURE LoadKeyboardLayoutA external "user32" :
     4765     define input  parameter P1 as char.
     4766     define input  parameter P2 as long.
     4767     define return parameter pret as long.
     4768   end procedure.
     4769   PROCEDURE proc-choose-file :
     4770     if search (v-proc-name-err) <> ? then
     4771     do:
     4772       os-delete value(v-proc-name-err).
     4773     end.
     4774     DEFINE VARIABLE vCh AS CHARACTER NO-UNDO.
     4775     DEFINE VARIABLE vLg AS LOGICAL   NO-UNDO.
     4776     def    var      ii  as int.
     4777     SYSTEM-DIALOG GET-FILE vCh
     4778       MUST-EXIST
     4779       TITLE "Выбор файла"
     4780       USE-FILENAME UPDATE vLg.
     4781     IF vCh <> "" THEN
     4782     DO:
     4783       output stream str-err to value(v-proc-name-err)  APPEND .
     4784       input stream in-stream from value(search (vCh)).
     4785       rpt_:
     4786       REPEAT WITH FRAME Dialog-Frame:
     4787         import stream in-stream v-mark.
     4788         v-mark:screen-value = v-mark.
     4789         run save_update .
     4790       END.
     4791       INPUT CLOSE.
     4792       output stream str-err close.
     4793       message substitute ("Не все марки были загружены") view-as alert-box.
     4794       if l-error then
     4795       do:
     4796         if search (v-proc-name-err) <> ? then
     4797         do:
     4798           run gbl/prnfilen.w
     4799             (input  substitute ("Не все марки были загружены")
     4800             ,input  0
     4801             ,input  v-proc-name-err
     4802             ,input  7
     4803             ,output v-user-action
     4804             ,output v-printed
     4805             ).
     4806         end.
     4807       end.
     4808       else
     4809       do:
     4810         message substitute("Импорт акцизных марок завершен успешно.")
     4811           view-as alert-box.
     4812       end.
     4813     END.
     4814     else os-delete value(v-proc-name-err).
     4815   END PROCEDURE.
     4816   PROCEDURE save_update :
     4817     define variable v-error      as logical   no-undo init no.
     4818     define variable l-error      as logical   no-undo init no.
     4819     define variable v-error-lang as logical   no-undo init no.
     4820     define variable v-ok         as logical   no-undo .
     4821     define variable ii           as integer   no-undo .
     4822     define variable v-parts      as character no-undo .
     4823     define variable gds-rec      as recid     no-undo .
     4824     define variable v-gds-code   as integer   no-undo .
     4825     define variable v-host-code  like sysconf.host-code no-undo.
     4826     define variable v-tax-date   as date      no-undo.
     4827     define variable v-vat-pc     like ub.doc-line.vat-pc no-undo.
     4828     define variable v-slt-pc     like ub.doc-line.slt-pc no-undo.
     4829     define variable ungroup      as logical   no-undo .
     4830     define variable chg-qnty     as integer   no-undo .
     4831     define variable v-level      as integer   no-undo .
     4832     define variable v-exp-date-txt as character no-undo .
     4833     define buffer buf_doc-line for ub.doc-line .
     4834     define buffer buf_parts    for ub.parts .
     4835     define buffer out_parts    for ub.parts .
     4836     define buffer buf_goods-alt for ub.goods .
     4837     define buffer buf_gds-prt  for ub.gds-prt .
     4838     define buffer cpl_gds-dtl  for ub.gds-dtl .
     4839     define variable v-GTIN as character no-undo .
     4840     define variable v-GTIN-qnty as integer no-undo .
     4841     define variable v-cis-gds-code as integer no-undo .
     4842     define variable v-alt-gds-code as integer no-undo .
     4843     define variable vcodident      as character no-undo.
     4844     define variable vStatusCheckMark as integer no-undo.
     4845     define variable vRunedOffLineCheck as logical no-undo.
     4846     define buffer buf_marking-lines for ub.marking-lines.
     4847     define buffer buf_marking       for ub.marking.
     4848     define buffer b_marking-lines   for ub.marking-lines.
     4849     define buffer b_trn-doc         for ub.trn-doc.
     4850     define buffer buf_mark_goods    for ub.goods.
     4851     define variable v-mark-weight   as decimal no-undo .
     4852     define variable v-isweighed     as logical no-undo .
     4853      if v-mark:screen-value in frame Dialog-Frame = ""
     4854       then do:
     4855         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4856         v-scan-str = "".
     4857       end.
     4858     assign
     4859       v-mark = v-mark:screen-value in frame Dialog-Frame .
     4860     if v-mark <> "" then
     4861     do:
     4862       vcodident = GetCodeIdent(v-mark).
     4863       p-mark = vcodident .
     4864       if v-is-return
     4865       and (vcodident = ? or vcodident = "")
     4866       then do :
     4867         p-mark = v-mark .
     4868       end .
     4869       find first marking where marking.mark begins vcodident
     4870         and vcodident > ""
     4871         no-lock no-error  .
     4872       if not avail marking or marking.unit-ext <> "LEVEL2" then
     4873       do:
     4874         v-GTIN = getGtinByDM(p-mark) .
     4875         if v-GTIN = "" then
     4876         do:
     4877           run dispmessage ("Марка не распознана.").
     4878           return error.
     4879         end.
     4880         v-cis-gds-code = getGdsCodeByGtin(v-GTIN) .
     4881         if v-cis-gds-code = 0 or v-cis-gds-code = ? then
     4882         do:
     4883           run dispmessage ("Не определен товар.").
     4884           return error.
     4885         end.
     4886         if avail buf_goods and buf_goods.gds-code <> v-cis-gds-code then
     4887         do:
     4888           find first buf_mark_goods where
     4889                      buf_mark_goods.gds-code = v-cis-gds-code no-lock no-error.
     4890           run dispmessage (substitute("Просканированная марка принадлежит другому товару, необходимо сканировать товар &1 &2.", buf_goods.gds-code, buf_goods.gds-name)).
     4891           return error.
     4892         end.
     4893         find first bf_prod-bc no-lock where bf_prod-bc.b-str = v-GTIN
     4894                                         and bf_prod-bc.bc-on
     4895                                         no-error.
     4896         if not available bf_prod-bc
     4897         then do :
     4898           run dispmessage ("В системе не найден доп. код " + v-GTIN + " (GTIN)").
     4899           return .
     4900         end .
     4901         find first bf_bar-code no-lock where bf_bar-code.b-code = bf_prod-bc.b-code no-error .
     4902         if not available bf_bar-code
     4903         then do :
     4904           run dispmessage ("В системе не найден бар-код " + string(bf_prod-bc.b-code) + "!!!").
     4905           return .
     4906         end .
     4907         if bf_bar-code.cli-base-rate <> 1 and can-do('рас,спи':U, t_doc.doc-type) and
     4908            v-free-qnty < bf_bar-code.cli-base-rate then
     4909         do:
     4910           run dispmessage ("Марка групповой упаковки не может быть добавлена в документ, т.к. будет превышено количество товара по документу.~nСканируйте потребительские упаковки").
     4911           return.
     4912         end.
     4913         v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, v-cis-gds-code) .
     4914         if v-isweighed then do:
     4915            if not avail marking
     4916            then do:
     4917               run dispmessage ("Марка не найдена в БД").
     4918               return .
     4919            end.
     4920            v-mark-weight = MarkWeight(marking.mark).
     4921            if v-mark-weight = 0
     4922            or v-mark-weight = ?
     4923            then do :
     4924               run dispmessage ("Марка не может быть добавлена, т.к. в БД отсутствует ее вес.").
     4925               return .
     4926            end .
     4927          end.
     4928       end.
     4929       if can-find(bf_marking-lines no-lock where bf_marking-lines.mark = p-mark
     4930                                              and bf_marking-lines.out-code = t_doc.doc-code)
     4931       then do :
     4932         run dispmessage ("КМ добавлен в документ ранее").
     4933         return .
     4934       end .
     4935       if v-is-return then
     4936       do:
     4937         if available marking then
     4938         do:
     4939           if marking.unit-ext <> "UNIT"
     4940           and marking.unit-ext <> ?
     4941           and marking.unit-ext <> ""
     4942           then do :
     4943             run dispmessage ("Некорректный тип упаковки. Сканируйте КМ потребительской упаковки.").
     4944             return.
     4945           end .
     4946           if marking.sts <> thMarkSts:FreeZone:KeyIntDB and
     4947              marking.sts <> thMarkSts:ReturnLock:KeyIntDB then
     4948           do:
     4949             run dispmessage (substitute("Марка в статусе <&1> не может быть возвращена поставщику.",
     4950                              thMarkSts:GetLabel(marking.sts))
     4951                              ).
     4952             return.
     4953           end.
     4954         end.
     4955         if available bf_parts
     4956         then do :
     4957           find first buf_goods no-lock where buf_goods.artic = bf_parts.artic
     4958                                          and buf_goods.prod-type = bf_parts.prod-type
     4959                                          and buf_goods.prod-code = bf_parts.prod-code
     4960                                          .
     4961           if available marking
     4962           and not (num-entries(bf_parts.part-code, "_") = 2
     4963                    and (length(entry(1, bf_parts.part-code, "_")) = 8
     4964                     or length(entry(1, bf_parts.part-code, "_")) = 12
     4965                     or length(entry(1, bf_parts.part-code, "_")) = 13
     4966                     or length(entry(1, bf_parts.part-code, "_")) = 14))
     4967           then do :
     4968             find first buf_marking-lines no-lock where buf_marking-lines.gds-code  = buf_goods.gds-code
     4969                                                    and buf_marking-lines.obj-type  = bf_parts.obj-type
     4970                                                    and buf_marking-lines.obj-code  = bf_parts.obj-code
     4971                                                    and buf_marking-lines.in-code   = bf_parts.in-code
     4972                                                    and buf_marking-lines.out-code  = bf_parts.out-code
     4973                                                    and buf_marking-lines.part-code = bf_parts.part-code
     4974                                                    and buf_marking-lines.mark      = marking.mark
     4975                                                    no-error .
     4976             if not available buf_marking-lines
     4977             then do :
     4978               if t_doc.reason-code = 25
     4979               then do :
     4980                 run dispmessage ("Просканированный КМ отсутствует в выбранной партии").
     4981                 return .
     4982               end .
     4983               if t_doc.reason-code = 23
     4984               then do :
     4985                 message "КМ отсутствует в выбранной партии, продолжить оформление возврата упаковки?" view-as alert-box question buttons yes-no update v-ok .
     4986                 if not v-ok
     4987                 then do :
     4988                   assign
     4989                     v-mark              = ""
     4990                     v-mark:screen-value = ""
     4991                     v-scan-str          = ""
     4992                     p-mark              = ""
     4993                   .
     4994                   return .
     4995                 end .
     4996               end .
     4997             end .
     4998           end .
     4999           else do :
     5000             if num-entries(bf_parts.part-code, "_") = 2
     5001             then do :
     5002               if v-GTIN <> entry(1, bf_parts.part-code, "_")
     5003               then do :
     5004                 if t_doc.reason-code = 25
     5005                 then do :
     5006                   run dispmessage ("Возврат упаковки с GTIN " + v-GTIN + " по выбранной партии не возможен").
     5007                   return .
     5008                 end .
     5009                 if t_doc.reason-code = 23
     5010                 then do :
     5011                   message ("Упаковка с GTIN " + v-GTIN + " отсутствует в выбранной партии, продолжить оформление возврата упаковки?") view-as alert-box question buttons yes-no update v-ok .
     5012                   if not v-ok
     5013                   then do :
     5014                     assign
     5015                       v-mark              = ""
     5016                       v-mark:screen-value = ""
     5017                       v-scan-str          = ""
     5018                       p-mark              = ""
     5019                     .
     5020                     return .
     5021                   end .
     5022                 end .
     5023               end .
     5024             end .
     5025             else do :
     5026               if t_doc.reason-code = 25
     5027               then do :
     5028                 run dispmessage ("Возврат упаковки с GTIN " + v-GTIN + " по выбранной партии не возможен").
     5029                 return .
     5030               end .
     5031               if t_doc.reason-code = 23
     5032               then do :
     5033                 message ("Упаковка с GTIN " + v-GTIN + " отсутствует в выбранной партии, продолжить оформление возврата упаковки?") view-as alert-box question buttons yes-no update v-ok .
     5034                 if not v-ok
     5035                 then do :
     5036                   assign
     5037                     v-mark              = ""
     5038                     v-mark:screen-value = ""
     5039                     v-scan-str          = ""
     5040                     p-mark              = ""
     5041                   .
     5042                   return .
     5043                 end .
     5044               end .
     5045             end .
     5046           end .
     5047         end .
     5048       end.
     5049       if available marking
     5050       then do:
     5051         v-exp-date-txt = "" .
     5052         if marking.sts = thMarkSts:Reserved:KeyIntDB then
     5053         do:
     5054           run dispmessage (substitute("Операция невозможна. Статус марки – <&1>. ", thMarkSts:GetLabel(marking.sts)) + v-exp-date-txt).
     5055           return.
     5056         end.
     5057         if marking.unit-ext = "LEVEL2" and
     5058           t_doc.ext-doc-type = 'we':U
     5059         then do:
     5060           run dispmessage ("Некорректный тип упаковки. Сканируйте КМ групповой или потребительской упаковки.").
     5061           return.
     5062         end.
     5063         case t_doc.ext-doc-type:
     5064         when 'ee':U then
     5065         do:
     5066           if not v-is-return and
     5067              marking.sts <> thMarkSts:FreeZone:KeyIntDB and
     5068              marking.sts <> thMarkSts:Checked_:KeyIntDB then
     5069           do:
     5070             run dispmessage (substitute("Операция невозможна. Статус марки – <&1>. ", thMarkSts:GetLabel(marking.sts)) + v-exp-date-txt).
     5071             return.
     5072           end.
     5073         end.
     5074         when 'ev':U then
     5075         do:
     5076           if marking.sts <> thMarkSts:FreeZone:KeyIntDB then
     5077           do:
     5078             run dispmessage (substitute("Операция невозможна. Статус марки – <&1>. ", thMarkSts:GetLabel(marking.sts)) + v-exp-date-txt).
     5079             return.
     5080           end.
     5081         end.
     5082         when 'we':U then
     5083         do:
     5084           if marking.sts = thMarkSts:WrittenOff:KeyIntDB then
     5085           do:
     5086             run dispmessage ("Товар списан ранее." + v-exp-date-txt).
     5087             return.
     5088           end.
     5089           if marking.sts = thMarkSts:DeliveryControl:KeyIntDB then
     5090           do:
     5091             run dispmessage ("Товар еще не оприходован." + v-exp-date-txt).
     5092             return.
     5093           end.
     5094           if marking.sts = thMarkSts:Ungrouped:KeyIntDB then
     5095           do:
     5096             run dispmessage ("Упаковка разгруппирована. Необходимо сканировать индивидуальные товары." + v-exp-date-txt).
     5097             return.
     5098           end.
     5099           if marking.sts = thMarkSts:UsedInProduction:KeyIntDB then
     5100           do:
     5101             run dispmessage ("Товар использован для производства.~n" +
     5102                              " В списание необходимо добавить товар-ингредиент,~n" +
     5103                              "для которого не требуется сканирование марок").
     5104             return.
     5105           end.
     5106           if marking.sts = thMarkSts:Moved:KeyIntDB then
     5107           do:
     5108             run dispmessage ("Товар перемещен на другой АЗК." + v-exp-date-txt).
     5109             return.
     5110           end.
     5111           if marking.sts <> thMarkSts:OutZone:KeyIntDB and
     5112              marking.sts <> thMarkSts:Checked_:KeyIntDB and
     5113              marking.sts <> thMarkSts:SaleLock:KeyIntDB and
     5114              marking.sts <> thMarkSts:ReturnLock:KeyIntDB and
     5115              marking.sts <> thMarkSts:FreeZone:KeyIntDB and
     5116              marking.sts <> thMarkSts:Moved:KeyIntDB and
     5117              marking.sts <> thMarkSts:OutOfInventory:KeyIntDB then
     5118           do:
     5119             run dispmessage (substitute("Операция невозможна. Статус марки – <&1>. ",thMarkSts:GetLabel(marking.sts)) + v-exp-date-txt).
     5120             return.
     5121           end.
     5122           if marking.sts = thMarkSts:OutZone:KeyIntDB or
     5123              marking.sts = thMarkSts:SaleLock:KeyIntDB or
     5124              marking.sts = thMarkSts:SaleWaitLock:KeyIntDB or
     5125              marking.sts = thMarkSts:Moved:KeyIntDB or
     5126              marking.sts = thMarkSts:OutOfInventory:KeyIntDB then
     5127           do:
     5128             for each b_marking-lines no-lock where
     5129                      b_marking-lines.mark    =  marking.mark
     5130                  and b_marking-lines.out-code <> t_doc.doc-code,
     5131                 first b_trn-doc no-lock where
     5132                       b_trn-doc.doc-code     =  b_marking-lines.out-code
     5133                   and b_trn-doc.ext-doc-type =  'we':U
     5134                   and b_trn-doc.status_      <> 'факт':U:
     5135                 run dispmessage (substitute("КМ в статусе <&1>, марка не может быть добавлена повторно. ",thMarkSts:GetLabel(marking.sts)) + v-exp-date-txt).
     5136                 return.
     5137             end.
     5138           end.
     5139         end.
     5140         end case.
     5141         if avail bf_bar-code and bf_bar-code.cli-base-rate <> 1 then
     5142         do:
     5143           for each buf_marking where
     5144                    buf_marking.mark-parent begins p-mark
     5145               no-lock:
     5146             v-GTIN-qnty = v-GTIN-qnty + 1.
     5147           end.
     5148           if v-GTIN-qnty <> bf_bar-code.cli-base-rate then
     5149           do:
     5150             run dispmessage (
     5151               substitute("Групповая упаковка с &1 составом. Для добавления в документ сканируйте марки потребительских упаковок.",
     5152                          if v-GTIN-qnty = 0 then "неизвестным" else "неполным")
     5153               ).
     5154             return.
     5155           end.
     5156         end.
     5157         if v-exp-date-txt > ""
     5158         then do :
     5159           run dispmessage (v-exp-date-txt) .
     5160           return .
     5161         end .
     5162       end.
     5163       else
     5164       do:
     5165         if bf_bar-code.cli-base-rate <> 1 then
     5166         do:
     5167             run dispmessage (
     5168               "Групповая упаковка с неизвестным составом. Для добавления в документ сканируйте марки потребительских упаковок."
     5169               ).
     5170             return.
     5171         end.
     5172         create ub.marking.
     5173         assign
     5174           ub.marking.mark     = vcodident
     5175           ub.marking.sts      = thMarkSts:FreeZone:KeyIntDB
     5176           ub.marking.box-qnty = 1
     5177         .
     5178       end.
     5179       assign
     5180         v-mark              = ""
     5181         v-mark:screen-value = ""
     5182         v-scan-str          = ""
     5183       .
     5184       apply "CHOOSE" to b-exit in frame Dialog-Frame.
     5185     end.
     5186   end procedure.
     5187   PROCEDURE proc-any-key :
     5188       if not v-manual
     5189           then
     5190           if v-scan-str = ""
     5191               then etime(yes).
     5192           else
     5193               if etime > 700
     5194                   then v-scan-str = "".
     5195       v-scan-str = v-scan-str + last-event:label.
     5196   end.
