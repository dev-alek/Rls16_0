      726       define input parameter p-value      as decimal   no-undo .
      727       define buffer buf_doc-line-attr for ub.doc-line-attr .
      728       find first buf_doc-line-attr exclusive-lock
      729         where buf_doc-line-attr.doc-code  = p-doc-code
      730           and buf_doc-line-attr.gds-code  = p-gds-code
      731           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      732         no-error .
      733       if not available buf_doc-line-attr then do:
      734         create buf_doc-line-attr .
      735         assign
      736           buf_doc-line-attr.doc-code  = p-doc-code
      737           buf_doc-line-attr.gds-code  = p-gds-code
