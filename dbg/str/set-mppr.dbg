        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: set-mppr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/set-mppr.p $":U .
        7   define variable vss-description as character no-undo init "Вызов процедуры  mpl-autoprice".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   procedure factord :
      297     define input  parameter p-fact-date            as date    no-undo .
      298     define input  parameter p-fact-time            as integer no-undo .
      299     define input  parameter p-fact-num             as integer no-undo .
      300     define input  parameter p-shift-date           as date    no-undo .
      301     define input  parameter p-shift-num            as integer no-undo .
      302     define input  parameter p-shift-on             as logical no-undo .
      303     define output parameter p-fact-order           as decimal no-undo .
      304     define output parameter p-shift-end-fact-order as decimal no-undo .
      305     define output parameter p-day-end-fact-order   as decimal no-undo .
      306     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      307     if p-fact-date = ?
      308     then do:
      309       return error "Не указана фактическая дата" .
      310     end.
      311     define variable v-fact-date-num as integer no-undo .
      312     assign
      313       v-fact-date-num = integer(p-fact-date)
      314     .
      315     if p-fact-num = ?
      316     or p-fact-num = 0
      317     then do:
      318       return error "Не задан p-fact-num " + string(p-fact-num) .
      319     end.
      320     if p-fact-num < 0
      321     then do:
      322       return error "Отрицательный fact-num " + string(p-fact-num) .
      323     end.
      324     if p-fact-num >= 100000000
      325     then do:
      326       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      327     end.
      328     if p-shift-on = true
      329     then do:
      330       if p-shift-date = ?
      331       then do:
      332         return error "Не задана дата смены" .
      333       end.
      334       if p-shift-num = ?
      335       or p-shift-num = 0
      336       then do:
      337         return error "Не задан номер смены" .
      338       end.
      339     end.
      340     else do:
      341       assign
      342         p-shift-date = p-fact-date
      343         p-shift-num  = 24
      344       .
      345     end.
      346     define variable v-shift-offset as integer no-undo .
      347     if p-shift-date = p-fact-date
      348     then do:
      349       assign
      350         v-shift-offset = 1
      351       .
      352     end.
      353     if p-shift-date < p-fact-date
      354     then do:
      355       assign
      356         v-shift-offset = 0
      357       .
      358     end.
      359     if p-shift-date > p-fact-date
      360     then do:
      361       message
      362         vss-workfile vss-revision vss-description skip
      363         "Неправильная дата закрытия смены" skip
      364         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      365         view-as alert-box error .
      366       undo, return error
      367         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      368           ,string(p-fact-date, '99/99/9999':U)
      369           ,string(p-shift-date, '99/99/9999':U)
      370           )
      371       .
      372     end.
      373     if p-shift-num < 1
      374     or p-shift-num > 24
      375     then do:
      376       message
      377         vss-workfile vss-revision vss-description skip
      378         "Неправильный номер смены" skip
      379         "p-shift-num" p-shift-num skip
      380         view-as alert-box error .
      381       undo, return error return-value .
      382     end.
      383     assign
      384       p-fact-order           = v-fact-date-num
      385                              + v-shift-offset * 0.5
      386                              + p-shift-num    * 0.02 - 0.01
      387                              + p-fact-num     * 0.0000000001
      388       p-shift-end-fact-order = v-fact-date-num
      389                              + v-shift-offset * 0.5
      390                              + p-shift-num    * 0.02
      391       p-day-end-fact-order   = v-fact-date-num
      392                              + 0.99
      393     .
      394     if p-fact-order           <= v-fact-date-num
      395     or p-shift-end-fact-order <= v-fact-date-num
      396     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      397     or p-shift-end-fact-order >= p-day-end-fact-order
      398     then do:
      399       message
      400         vss-workfile vss-revision vss-description skip
      401         "Внутренняя ошибка при генерации фактического номера" skip
      402         "p-fact-date"            p-fact-date            skip
      403         "p-fact-time"            p-fact-time            skip
      404         "p-fact-num"             p-fact-num             skip
      405         "p-shift-date"           p-shift-date           skip
      406         "p-shift-num"            p-shift-num            skip
      407         "p-shift-on"             p-shift-on             skip
      408         "p-shift-end-fact-order" p-shift-end-fact-order skip
      409         "p-day-end-fact-order"   p-day-end-fact-order   skip
      410         "v-fact-date-num"        v-fact-date-num        skip
      411         view-as alert-box error .
      412       undo, return error return-value .
      413     end.
      414   end procedure.
      415   procedure day-begin-fact-order :
      416     define input  parameter p-fact-date            as date    no-undo .
      417     define output parameter p-day-begin-fact-order as decimal no-undo .
      418     do
      419     on error undo, return error return-value
      420     :
      421       if p-fact-date = ?
      422       then do:
      423         assign
      424           p-day-begin-fact-order = 0
      425         .
      426       end.
      427       else do:
      428         assign
      429           p-day-begin-fact-order = integer(p-fact-date)
      430         .
      431       end.
      432     end.
      433   end procedure.
      434   procedure factord-max-fact-order :
      435     define output parameter p-max-fact-order as decimal   no-undo .
      436     do
      437     on error undo, return error return-value
      438     :
      439       run day-begin-fact-order in this-procedure
      440         (input  date(1, 1, 5000)
      441         ,output p-max-fact-order
      442         ) .
      443     end.
      444   end procedure.
      445   procedure factord-cut-archive :
      446     define input  parameter p-obj-type             as character no-undo .
      447     define input  parameter p-obj-code             as integer   no-undo .
      448     define input  parameter p-fact-date            as date      no-undo .
      449     define output parameter p-shift-on             as logical   no-undo .
      450     define output parameter p-shift-date           as date      no-undo .
      451     define output parameter p-shift-num            as integer   no-undo .
      452     define output parameter p-day-end-fact-order   as decimal   no-undo .
      453     define output parameter p-shift-end-fact-order as decimal   no-undo .
      454     define variable v-fact-order as decimal   no-undo .
      455     define buffer buf_shift-obj for ub.shift-obj .
      456     do
      457     on error undo, return error return-value
      458     :
      459   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      461     (input  p-obj-type
      462     ,input  p-obj-code
      463     ,input  'shift-on=request'
      464     ,output p-shift-on
      465     ) no-error .
      466       if error-status :error
      467       then do:
      468         message
      469           vss-workfile vss-revision vss-description skip
      470           "Ошибка при определении атрибута объекта" skip
      471           "Объект" p-obj-type p-obj-code skip
      472           error-status :get-message(1) skip
      473           return-value skip
      474           view-as alert-box error .
      475         undo, return error return-value .
      476       end.
      477       if p-shift-on = false
      478       then do:
      479         assign
      480           p-shift-date               = ?
      481           p-shift-num                = 0
      482         .
      483       end.
      484       else do:
      485         find first buf_shift-obj share-lock
      486           where buf_shift-obj.obj-type   = p-obj-type
      487             and buf_shift-obj.obj-code   = p-obj-code
      488             and buf_shift-obj.shift-date > p-fact-date
      489           use-index pi
      490           no-error .
      491         if not available buf_shift-obj
      492         or buf_shift-obj.status_ <> 'зкр':U
      493         then do:
      494           message
      495             vss-workfile vss-revision vss-description skip
      496             "Невозможно вычислить последнюю смену" skip
      497             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      498             "Объект" p-obj-type p-obj-code skip
      499             "Дата" p-fact-date skip
      500             view-as alert-box error .
      501           undo, return error return-value .
      502         end.
      503         find last buf_shift-obj share-lock
      504           where buf_shift-obj.obj-type = p-obj-type
      505             and buf_shift-obj.obj-code = p-obj-code
      506             and buf_shift-obj.shift-date <= p-fact-date
      507           use-index pi
      508           no-error .
      509         if available buf_shift-obj
      510         then do:
      511           if  buf_shift-obj.status_ = 'зкр':U
      512           then do:
      513             assign
      514               p-shift-date = buf_shift-obj.shift-date
      515               p-shift-num  = buf_shift-obj.shift-num
      516             .
      517           end.
      518           else do:
      519             message
      520               vss-workfile vss-revision vss-description skip
      521               "Невозможно вычислить последнюю смену" skip
      522               "Статус смены отличен от статуса" 'зкр':U skip
      523               "Объект" p-obj-type p-obj-code skip
      524               "Дата" p-fact-date skip
      525               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      526               view-as alert-box error .
      527             undo, return error return-value .
      528           end.
      529         end.
      530         else do:
      531           assign
      532             p-shift-date = p-fact-date - 1
      533             p-shift-num  = 1
      534           .
      535         end.
      536       end.
      537       run factord in this-procedure
      538         (input  p-fact-date
      539         ,input  1
      540         ,input  1
      541         ,input  p-shift-date
      542         ,input  p-shift-num
      543         ,input  p-shift-on
      544         ,output v-fact-order
      545         ,output p-shift-end-fact-order
      546         ,output p-day-end-fact-order
      547         ) no-error .
      548       if error-status :error
      549       then do:
      550         message
      551           vss-workfile vss-revision vss-description skip
      552           "Ошибка при вызове процедуры factord"
      553           error-status :get-message(1) skip
      554           return-value skip
      555           view-as alert-box error .
      556         undo, return error return-value .
      557       end.
      558     end.
      559   end procedure.
      560   procedure factord-lock-shift :
      561     define input  parameter p-obj-type  as character no-undo .
      562     define input  parameter p-obj-code  as integer   no-undo .
      563     define input  parameter p-fact-date as date      no-undo .
      564     define parameter buffer buf_shift-obj for ub.shift-obj .
      565     define variable v-shift-on      as logical   no-undo .
      566     define variable v-extra-message as character no-undo .
      567     define variable v-error as character no-undo .
      568     do
      569     on error undo, return error return-value
      570     :
      571   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      573     (input  p-obj-type
      574     ,input  p-obj-code
      575     ,input  'shift-on=request'
      576     ,output v-shift-on
      577     ) no-error .
      578       if error-status :error
      579       then do:
      580         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      581         undo, return error v-error .
      582       end.
      583       if v-shift-on = true
      584       then do:
      585         find first buf_shift-obj share-lock
      586           where buf_shift-obj.obj-type   = p-obj-type
      587             and buf_shift-obj.obj-code   = p-obj-code
      588             and buf_shift-obj.shift-date > p-fact-date
      589           use-index pi
      590           no-error .
      591         if not available buf_shift-obj
      592         or buf_shift-obj.status_ <> 'зкр':U
      593         then do:
      594           find last buf_shift-obj
      595             where buf_shift-obj.obj-type = p-obj-type
      596               and buf_shift-obj.obj-code = p-obj-code
      597               and buf_shift-obj.status_  = 'зкр':U
      598             use-index stts
      599             no-error .
      600           if available buf_shift-obj
      601           then do:
      602             assign
      603               v-extra-message =
      604                     substitute("Дата начала последеней закрытой смены на объекте &1"
      605                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      606                               )
      607             .
      608           end.
      609           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      610           undo, return error v-error .
      611         end.
      612       end.
      613     end.
      614   end procedure.
      615   procedure factord-end-day :
      616     define input  parameter p-fact-date            as date    no-undo .
      617     define output parameter p-day-end-fact-order   as decimal no-undo .
      618     do
      619     on error undo, return error return-value
      620     :
      621       if p-fact-date = ?
      622       then do:
      623         return error "Не указана фактическая дата" .
      624       end.
      625       assign
      626         p-day-end-fact-order = integer(p-fact-date) + 0.99
      627       .
      628     end.
      629   end procedure.
      630   procedure factord-to-date :
      631     define input  parameter p-fact-order as decimal no-undo .
      632     define output parameter p-fact-date  as date    no-undo .
      633     define variable v-ref-date  as date      no-undo .
      634     define variable v-ref-delta as integer   no-undo .
      635     do
      636     on error undo, return error return-value
      637     :
      638       if p-fact-order = ?
      639       or p-fact-order = 0
      640       then do:
      641         return error "Не указан fact-order" .
      642       end.
      643       assign
      644         v-ref-date  = date(1, 1, 2000)
      645       .
      646       assign
      647         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      648       .
      649       assign
      650         p-fact-date = v-ref-date + v-ref-delta
      651       .
      652     end.
      653   end procedure.
      654   procedure factord-to-fact-num :
      655     define input  parameter p-fact-order as decimal no-undo .
      656     define output parameter p-fact-num   as integer no-undo .
      657     define variable v-fact-order-trunc as decimal no-undo .
      658     do
      659     on error undo, return error return-value
      660     :
      661       if p-fact-order = ?
      662       or p-fact-order = 0
      663       then do:
      664         return error "Не указан fact-order" .
      665       end.
      666       assign
      667        v-fact-order-trunc = truncate(p-fact-order, 2)
      668       .
      669       assign
      670         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      671       .
      672     end.
      673   end procedure.
      674   procedure factord-to-shift-num :
      675     define input  parameter p-fact-order as decimal no-undo .
      676     define output parameter p-shift-num   as integer no-undo .
      677     define variable  p-shift-numd  as decimal   no-undo .
      678     define variable v-fact-order-trunc as decimal no-undo .
      679     do
      680     on error undo, return error return-value
      681     :
      682       if p-fact-order = ?
      683       or p-fact-order = 0
      684       then do:
      685         return error "Не указан fact-order" .
      686       end.
      687       assign
      688        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      689       .
      690       if v-fact-order-trunc < 0.5 then do:
      691         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      692       end.
      693       assign
      694         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      695         .
      696        assign
      697         p-shift-num = truncate (p-shift-numd , 0)
      698       .
      699     end.
      700   end procedure.
      701   procedure fact-order-mpl :
      702     do
      703     on error undo, return error return-value
      704     :
      705   define input  parameter p-doc-date as date     no-undo .
      706   define input  parameter p-obj-type as character no-undo .
      707   define input  parameter p-obj-code as integer   no-undo .
      708   define output parameter p-fact-order as decimal   no-undo .
      709   define variable v-fact-date            as date    no-undo .
      710   define variable v-fact-time            as integer no-undo .
      711   define variable v-fact-order           as decimal no-undo .
      712   define variable v-shift-end-fact-order as decimal no-undo .
      713   define variable v-day-end-fact-order   as decimal no-undo .
      714   define variable l-shift-on as logical no-undo .
      715   define variable l-date as date      no-undo .
      716   define variable l-time as integer   no-undo .
      717   define variable shift-date as date      no-undo .
      718   define variable shift-num  as integer   no-undo .
      719   define variable shift-name as character no-undo .
      720   define variable max-fact-order as decimal   no-undo .
      721   define buffer buf_global-state for ub.global-state  .
      722   find first buf_global-state no-lock no-error .
      723   if not available buf_global-state then do:
      724      message
      725        "Не заданы параметры ценообразования!"
      726        view-as alert-box error
      727      .
      728      return error return-value .
      729   end.
      730     run cur-time in this-procedure
      731     ( output v-fact-date ,
      732       output v-fact-time  ).
      733   if p-doc-date = ? then do:
      734   if buf_global-state.pl-use-sys-date-time  = true then do:
      735         run factord in this-procedure
      736           (input  v-fact-date
      737           ,input  v-fact-time
      738           ,input  v-fact-time
      739           ,input  ?
      740           ,input  ?
      741           ,input  false
      742           ,output v-fact-order
      743           ,output v-shift-end-fact-order
      744           ,output v-day-end-fact-order
      745           ) no-error .
      746         if error-status :error
      747         or v-fact-order = ?
      748         or v-fact-order = 0 then do:
      749           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      750         end.
      751         p-fact-order = v-fact-order .
      752   end.
      753   else do:
      754   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      756     (input  p-obj-type
      757     ,input  p-obj-code
      758     ,input  'shift-on=request'
      759     ,output l-shift-on
      760     ) no-error .
      761         if error-status :error then return error "Неопределена дата на объекте " + return-value .
      762         if p-doc-date <> ? then do:
      763         end.
      764          run gbl/factdate.p
      765          ( input        p-obj-type  ,
      766            input        p-obj-code  ,
      767            input-output v-fact-date ,
      768            input-output v-fact-time ,
      769            input-output shift-date      ,
      770            input-output shift-num       ,
      771            input-output shift-name      ,
      772            input        yes
      773            ) no-error .
      774         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
      775         run factord in this-procedure
      776           (input  v-fact-date
      777           ,input  v-fact-time
      778           ,input  v-fact-time
      779           ,input  shift-date
      780           ,input  shift-num
      781           ,input  l-shift-on
      782           ,output v-fact-order
      783           ,output v-shift-end-fact-order
      784           ,output v-day-end-fact-order
      785           ) no-error .
      786         if error-status :error
      787         or v-fact-order = ?
      788         or v-fact-order = 0 then do:
      789           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      790         end.
      791         p-fact-order = v-fact-order .
      792   end.
      793   end.
      794   else do:
      795          run gbl/factdate.p
      796          ( input        p-obj-type  ,
      797            input        p-obj-code  ,
      798            input-output v-fact-date ,
      799            input-output v-fact-time ,
      800            input-output shift-date      ,
      801            input-output shift-num       ,
      802            input-output shift-name      ,
      803            input        yes
      804            ) no-error .
      805         if error-status :error then return error "Ошибка factdate.p " + return-value .
      806         v-fact-date = p-doc-date .
      807         run factord in this-procedure
      808           (input  v-fact-date
      809           ,input  v-fact-time
      810           ,input  v-fact-time
      811           ,input  shift-date
      812           ,input  shift-num
      813           ,input  l-shift-on
      814           ,output v-fact-order
      815           ,output v-shift-end-fact-order
      816           ,output v-day-end-fact-order
      817           ) no-error .
      818         if error-status :error
      819         or v-fact-order = ?
      820         or v-fact-order = 0 then do:
      821           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      822         end.
      823         p-fact-order = v-fact-order .
      824   end.
      825     end.
      826   end procedure.
      827   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
      828   field sale-qnty as decimal
      829   field sale-sum  as decimal
      830   field sale-tnv  as decimal
      831   field price-sale-base as decimal
      832   field price-sale-rubl as decimal
      833   field road-tax-base   as decimal
      834   field road-tax-rubl   as decimal
      835   field excise-base as decimal
      836   field excise-rubl as decimal
      837   field date-1 as date
      838   field date-2 as date
      839   field shift-1 as int
      840   field shift-2 as int
      841   field time-1 as int
      842   field time-2 as int
      843   field grp-name as char
      844   field interv-name as char
      845   field pay-name as char
      846   field unit-cli as char
      847   index pi
      848   plt-priority DESCENDING
      849   fact-order DESCENDING
      850   qnty-from asc
      851   sum-from asc
      852   turnover-from asc
      853   date-1 DESCENDING
      854   time-1 DESCENDING
      855   date-2 DESCENDING
      856   time-2 DESCENDING
      857   type-price DESCENDING
      858   .
      859   procedure mpl-autoprice :
      860   define input  parameter p-only-b-code as logical   no-undo .
      861   define input  parameter p-cli-type    as character no-undo .
      862   define input  parameter p-cli-code    as integer   no-undo .
      863   define input  parameter p-main-b-code as integer   no-undo .
      864   define input  parameter p-b-code      as integer   no-undo .
      865   define input  parameter p-obj-type    as character no-undo .
      866   define input  parameter p-obj-code    as integer   no-undo .
      867   define input  parameter p-qnty-doc    as decimal   no-undo .
      868   define input  parameter p-sum-doc     as decimal   no-undo .
      869   define input  parameter p-vid-pay        as character no-undo .
      870   define input  parameter p-cash-pay-type  as character no-undo .
      871   define input  parameter p-fact-order  as decimal   no-undo .
      872   define output parameter p-plt-id          as integer   no-undo .
      873   define output parameter p-plt-db-num      as integer   no-undo .
      874   define output parameter p-pdf-id          as integer   no-undo .
      875   define output parameter p-pdf-db-num      as integer   no-undo .
      876   define output parameter p-sale-price-base as decimal   no-undo .
      877   define output parameter p-sale-price-rubl as decimal   no-undo .
      878   define output parameter p-road-tax-base as decimal   no-undo .
      879   define output parameter p-road-tax-rubl as decimal   no-undo .
      880   define output parameter p-excise-base   as decimal   no-undo .
      881   define output parameter p-excise-rubl   as decimal   no-undo .
      882   define variable v-cli-oborot-ALL as decimal   no-undo .
      883   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
      884   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
      885   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      886   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      887   define buffer buf_price-all              for ub.price-all  .
      888   define buffer buf_goods                  for ub.goods      .
      889   define buffer buf_global-state           for ub.global-state  .
      890   define buffer buf_buyer-group            for ub.buyer-group  .
      891   define buffer buf_turnover-group         for ub.turnover-group  .
      892   define buffer buf_main-code              for ub.bar-code  .
      893   define buffer buf_bar-code               for ub.bar-code  .
      894   define buffer buf_pay-type               for ub.pay-type  .
      895   define buffer buf_cash-pay               for ub.cash-pay  .
      896   define variable to-day          as date      no-undo .
      897   define variable v-base-rate0    as decimal   no-undo .
      898   define variable v-base-scale0   as decimal   no-undo .
      899   define variable v-exch-rate0    as decimal   no-undo .
      900   define variable v-exch-scale0   as decimal   no-undo .
      901   define variable v-base-rate     as decimal   no-undo .
      902   define variable v-base-scale    as decimal   no-undo .
      903   define variable v-exch-rate     as decimal   no-undo .
      904   define variable v-exch-scale    as decimal   no-undo .
      905   define variable v-host-code     as integer   no-undo .
      906   define variable v-curr-abbr     as character no-undo .
      907   define variable v-grp-name      as character no-undo .
      908   define variable v-date-1        as date      no-undo .
      909   define variable v-date-2        as date      no-undo .
      910   define variable v-interv        as character no-undo .
      911   define variable v-pay-name      as character no-undo .
      912   define variable v-cli-oborot    as decimal   no-undo .
      913   define variable v-trn-pay-code  as integer   no-undo .
      914   define variable v-cash-pay-curr as integer   no-undo .
      915   define variable v-cash-pay-code as integer   no-undo .
      916   do
      917   on error undo, return error return-value
      918   :
      919   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
      920   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
      921   if p-fact-order = ? then do:
      922     run fact-order-mpl (
      923         input   today       ,
      924         input   p-obj-type  ,
      925         input   p-obj-code  ,
      926         output  p-fact-order ).
      927   end.
      928   if p-vid-pay <> "" then do:
      929      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
      930      if available buf_pay-type
      931         then v-trn-pay-code = buf_pay-type.obj-code.
      932         else v-trn-pay-code =  0.
      933   end.
      934   else v-trn-pay-code = 0 .
      935   if p-cash-pay-type <> "" then do:
      936      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
      937      if available buf_pay-type
      938         then
      939           assign
      940             v-cash-pay-curr = buf_cash-pay.curr-code
      941             v-cash-pay-code = buf_cash-pay.cdpay-code
      942           .
      943         else
      944           assign
      945             v-cash-pay-curr = 0
      946             v-cash-pay-code = 0
      947             .
      948   end.
      949   else
      950     assign
      951       v-cash-pay-curr = 0
      952       v-cash-pay-code = 0
      953       .
      954   for each tt_price-all  : delete tt_price-all . end.
      955   assign
      956     p-plt-id             = ?
      957     p-plt-db-num         = ?
      958     p-pdf-id             = ?
      959     p-pdf-db-num         = ?
      960     p-sale-price-base    = ?
      961     p-sale-price-rubl    = ?
      962     v-cli-oborot         = 0
      963   .
      964   find first buf_global-state no-lock no-error .
      965   if not available buf_global-state then do:
      966      message
      967        "Не заданы параметры ценообразования!"
      968        view-as alert-box error
      969      .
      970      return error return-value .
      971   end.
      972   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      974     (input  p-obj-type
      975     ,input  p-obj-code
      976     ,output to-day
      977     )  .
      978   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      980     (input  p-obj-type
      981     ,input  p-obj-code
      982     ,output v-host-code
      983     )  .
      984   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      986     (input  v-host-code
      987     ,input  to-day
      988     ,output v-base-rate0
      989     ,output v-base-scale0
      990     )  .
      991     v-cli-oborot-ALL  = 0 .
      992     for each buf_turnover-buyer-main no-lock  where
      993              buf_turnover-buyer-main.cli-type = p-cli-type  and
      994              buf_turnover-buyer-main.cli-code = p-cli-code
      995              :
      996              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
      997     end.
      998   for each buf_price-all no-lock where
      999            buf_price-all.obj-type = p-obj-type and
     1000            buf_price-all.obj-code = p-obj-code and
     1001            buf_price-all.gds-code = buf_goods.gds-code and
     1002            buf_price-all.status_  = 'акт':U  and
     1003          ( p-only-b-code = false   or
     1004          ( buf_price-all.b-code = p-main-b-code or
     1005            buf_price-all.b-code = p-b-code))    and
     1006           ( p-only-b-code = true  or
     1007             buf_price-all.b-code = p-b-code)
     1008             and
     1009             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1010           ( buf_price-all.fact-order-sys-to = ? or
     1011             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1012           :
     1013            v-interv   = "" .
     1014            v-grp-name = "" .
     1015            v-pay-name = "" .
     1016            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1017            if buf_price-all.bgr-id > 0 then do:
     1018               find first buf_buyer-group no-lock where
     1019                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1020                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1021               if available buf_buyer-group then do:
     1022                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1023                  find first buf_buyer-in-buyer-group no-lock where
     1024                             buf_buyer-in-buyer-group.stts         = 0 and
     1025                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1026                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1027                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1028                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1029                             no-error .
     1030                             if not available buf_buyer-in-buyer-group then do:
     1031                                v-grp-name = "".
     1032                                next.
     1033                             end.
     1034                             v-grp-name = buf_buyer-group.name .
     1035                  end.
     1036               end.
     1037               else do:
     1038                    v-grp-name = "".
     1039                    next.
     1040               end.
     1041            end.
     1042            if buf_price-all.tog-id > 0 then do:
     1043               find first buf_turnover-group no-lock where
     1044                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1045                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1046               if available buf_turnover-group then do:
     1047                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1048                     v-cli-oborot = v-cli-oborot-all  .
     1049                     find first buf1_tnv-in-turnover-group no-lock where
     1050                                buf1_tnv-in-turnover-group.stts       =  0     and
     1051                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1052                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1053                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1054                     find first buf2_tnv-in-turnover-group no-lock where
     1055                                buf2_tnv-in-turnover-group.stts       =  0     and
     1056                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1057                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1058                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1059                     if not (available buf1_tnv-in-turnover-group and
     1060                             available buf2_tnv-in-turnover-group ) then do:
     1061                             v-grp-name = "".
     1062                             next .
     1063                     end.
     1064                     v-grp-name = buf_turnover-group.name.
     1065                  end.
     1066               end.
     1067               else do:
     1068                    v-grp-name = "".
     1069                    next.
     1070               end.
     1071            end.
     1072            if buf_price-all.plt-fix-cource-crc-base = true then
     1073               assign
     1074                 v-base-rate  = buf_price-all.pdf-base-rate
     1075                 v-base-scale = buf_price-all.pdf-base-scale
     1076               .
     1077               else
     1078               assign
     1079                 v-base-rate  = v-base-rate0
     1080                 v-base-scale = v-base-scale0
     1081               .
     1082            if buf_price-all.plt-fix-cource-crc-doc = true then
     1083               assign
     1084                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1085                 v-exch-scale = buf_price-all.pdf-exch-scale
     1086               .
     1087               else do:
     1088   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1090     (input  buf_price-all.curr-code
     1091     ,input  to-day
     1092     ,output v-exch-rate0
     1093     ,output v-exch-scale0
     1094     ,output v-curr-abbr
     1095     )  .
     1096               assign
     1097                 v-exch-rate  = v-exch-rate0
     1098                 v-exch-scale = v-exch-scale0
     1099                 .
     1100              end.
     1101              v-date-1 = date ( "" )  .
     1102              if buf_price-all.fact-order-sys-from > 0 then do:
     1103                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1104                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1105                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1106              end.
     1107              v-date-2 =  date ( "" )  .
     1108              if buf_price-all.fact-order-sys-to > 0 then do:
     1109                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1110                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1111                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1112              end.
     1113              if buf_price-all.qnty-from <> ? then do :
     1114                 if not (
     1115                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1116                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1117                 ) then do:
     1118                        v-interv = "".
     1119                        next.
     1120                 end.
     1121                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1122              end.
     1123              if buf_price-all.sum-from <> ? then do :
     1124                 if not (
     1125                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1126                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1127                 ) then do:
     1128                    v-interv = "".
     1129                    next.
     1130                 end.
     1131                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1132              end.
     1133              if buf_price-all.turnover-from <> ? then do :
     1134                 if not (
     1135                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1136                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1137                 ) then do:
     1138                    v-interv = "".
     1139                    next.
     1140                 end.
     1141                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1142              end.
     1143              if buf_price-all.use-pay-type = 1 then do :
     1144                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1145                    v-pay-name = "" .
     1146                    next.
     1147                  end.
     1148                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1149              end.
     1150              if buf_price-all.use-cash-pay = 1 then do :
     1151                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1152                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1153                   v-pay-name = "" .
     1154                   next.
     1155                 end.
     1156                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1157              end.
     1158             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1159             create tt_price-all .
     1160             buffer-copy buf_price-all to tt_price-all
     1161             assign
     1162               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1163               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1164               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1165               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1166               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1167               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1168               tt_price-all.price-sale     = buf_price-all.price-sale
     1169               tt_price-all.road-tax       = buf_price-all.road-tax
     1170               tt_price-all.excise         = buf_price-all.excise
     1171               tt_price-all.pdf-exch-rate   = v-exch-rate
     1172               tt_price-all.pdf-exch-scale  = v-exch-scale
     1173               tt_price-all.pdf-base-rate   = v-base-rate
     1174               tt_price-all.pdf-base-scale  = v-base-scale
     1175               tt_price-all.grp-name        = v-grp-name
     1176               tt_price-all.date-1          = v-date-1
     1177               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1178               tt_price-all.time-1          = buf_price-all.start-sys-time
     1179               tt_price-all.date-2          = v-date-2
     1180               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1181               tt_price-all.time-2          = buf_price-all.end-sys-time
     1182               tt_price-all.interv-name     = v-interv
     1183               tt_price-all.pay-name        = v-pay-name
     1184               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1185             .
     1186   end.
     1187   define variable vt-plt-id as integer   no-undo .
     1188   define variable vt-plt-db as integer   no-undo .
     1189   define variable vt-pdf-id as integer   no-undo .
     1190   define variable vt-pdf-db as integer   no-undo .
     1191   define buffer neos_price-all for tt_price-all  .
     1192   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1193       if available tt_price-all then do:
     1194        assign
     1195          vt-plt-id = tt_price-all.plt-id
     1196          vt-plt-db = tt_price-all.plt-db-num
     1197          vt-pdf-id = tt_price-all.pdf-id
     1198          vt-pdf-db = tt_price-all.pdf-db
     1199        .
     1200        if tt_price-all.b-code = p-b-code then do:
     1201             assign
     1202               p-plt-id           = tt_price-all.plt-id
     1203               p-plt-db-num       = tt_price-all.plt-db-num
     1204               p-pdf-id           = tt_price-all.pdf-id
     1205               p-pdf-db-num       = tt_price-all.pdf-db
     1206               p-sale-price-base  = tt_price-all.price-sale-base
     1207               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1208               p-road-tax-base    = tt_price-all.road-tax-base
     1209               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1210               p-excise-base      = tt_price-all.excise-base
     1211               p-excise-rubl      = tt_price-all.excise-rubl
     1212               .
     1213        end.
     1214        else do:
     1215          find first neos_price-all where
     1216                     neos_price-all.b-code     = p-b-code  and
     1217                     neos_price-all.plt-id     = vt-plt-id and
     1218                     neos_price-all.plt-db-num = vt-plt-db and
     1219                     neos_price-all.pdf-id     = vt-pdf-id and
     1220                     neos_price-all.pdf-db     = vt-pdf-db
     1221                     use-index pi no-error .
     1222            if available neos_price-all then do:
     1223             assign
     1224               p-plt-id           = tt_price-all.plt-id
     1225               p-plt-db-num       = tt_price-all.plt-db-num
     1226               p-pdf-id           = tt_price-all.pdf-id
     1227               p-pdf-db-num       = tt_price-all.pdf-db
     1228               p-sale-price-base  = neos_price-all.price-sale-base
     1229               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1230               p-road-tax-base    = neos_price-all.road-tax-base
     1231               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1232               p-excise-base      = neos_price-all.excise-base
     1233               p-excise-rubl      = neos_price-all.excise-rubl
     1234               .
     1235            end.
     1236            else do:
     1237                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1238                 if error-status :error    then do:
     1239                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1240                   return error return-value .
     1241                 end.
     1242             assign
     1243               p-plt-id           = tt_price-all.plt-id
     1244               p-plt-db-num       = tt_price-all.plt-db-num
     1245               p-pdf-id           = tt_price-all.pdf-id
     1246               p-pdf-db-num       = tt_price-all.pdf-db
     1247               p-sale-price-base  = tt_price-all.price-sale-base
     1248               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1249               p-road-tax-base    = tt_price-all.road-tax-base
     1250               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1251               p-excise-base      = tt_price-all.excise-base
     1252               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1253               .
     1254            end.
     1255        end.
     1256     end.
     1257   end.
     1258   end procedure.
     1259   procedure mpl-tpl-auto :
     1260   define input  parameter p-b-code     as integer   no-undo .
     1261   define input  parameter p-obj-type   as character no-undo .
     1262   define input  parameter p-obj-code   as integer   no-undo .
     1263   define input  parameter p-plt-id     as integer   no-undo .
     1264   define input  parameter p-plt-db-num as integer   no-undo .
     1265   define input  parameter p-fact-order as decimal   no-undo .
     1266   define output parameter p-sale-price as decimal   no-undo .
     1267   define output parameter p-pdf-id     as integer   no-undo .
     1268   define output parameter p-pdf-db-num as integer   no-undo .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272   if p-fact-order = ? then do:
     1273     run fact-order-mpl (
     1274         input   today       ,
     1275         input   p-obj-type  ,
     1276         input   p-obj-code  ,
     1277         output  p-fact-order ) .
     1278   end.
     1279   assign
     1280     p-pdf-id      = ?
     1281     p-pdf-db-num  = ?
     1282     p-sale-price  = ?
     1283   .
     1284   define buffer buf_bar-code for ub.bar-code  .
     1285   define buffer buf_goods for ub.goods  .
     1286   find first buf_bar-code no-lock where
     1287              buf_bar-code.b-code = p-b-code
     1288              no-error .
     1289   if error-status :error then return error return-value .
     1290   find first buf_goods no-lock where
     1291              buf_goods.gds-code = buf_bar-code.gds-code
     1292              no-error .
     1293   if error-status :error then return error return-value .
     1294   define variable v-main-b-code as integer   no-undo .
     1295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1296     (input  buf_goods.gds-code
     1297     ,input  ?
     1298     ,output v-main-b-code
     1299     )  .
     1300   define buffer buf_price-all for ub.price-all  .
     1301   for each tt_price-all : delete tt_price-all. end.
     1302       for each buf_price-all no-lock where
     1303               buf_price-all.plt-id     = p-plt-id                 and
     1304               buf_price-all.plt-db-num = p-plt-db-num             and
     1305               buf_price-all.obj-type   = p-obj-type               and
     1306               buf_price-all.obj-code   = p-obj-code               and
     1307               buf_price-all.gds-code   = buf_goods.gds-code       and
     1308             ( buf_price-all.b-code = v-main-b-code or
     1309               buf_price-all.b-code = p-b-code)    and
     1310               buf_price-all.status_    = 'акт':U         and
     1311               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1312             ( buf_price-all.fact-order-sys-to = ? or
     1313               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1314               :
     1315                 create tt_price-all .
     1316                 buffer-copy buf_price-all to tt_price-all
     1317                 assign
     1318                   tt_price-all.price-sale  = buf_price-all.price-sale
     1319                 .
     1320       end.
     1321   define variable vt-plt-id as integer   no-undo .
     1322   define variable vt-plt-db as integer   no-undo .
     1323   define variable vt-pdf-id as integer   no-undo .
     1324   define variable vt-pdf-db as integer   no-undo .
     1325   define buffer neos_price-all for tt_price-all  .
     1326   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1327       if available tt_price-all then do:
     1328        assign
     1329          vt-plt-id = tt_price-all.plt-id
     1330          vt-plt-db = tt_price-all.plt-db-num
     1331          vt-pdf-id = tt_price-all.pdf-id
     1332          vt-pdf-db = tt_price-all.pdf-db
     1333        .
     1334        if tt_price-all.b-code = p-b-code then do:
     1335             assign
     1336               p-plt-id           = tt_price-all.plt-id
     1337               p-plt-db-num       = tt_price-all.plt-db-num
     1338               p-pdf-id           = tt_price-all.pdf-id
     1339               p-pdf-db-num       = tt_price-all.pdf-db
     1340               p-sale-price       = tt_price-all.price-sale
     1341               .
     1342        end.
     1343        else do:
     1344          find first neos_price-all where
     1345                     neos_price-all.b-code     = p-b-code  and
     1346                     neos_price-all.plt-id     = vt-plt-id and
     1347                     neos_price-all.plt-db-num = vt-plt-db and
     1348                     neos_price-all.pdf-id     = vt-pdf-id and
     1349                     neos_price-all.pdf-db     = vt-pdf-db
     1350                     use-index pi no-error .
     1351            if available neos_price-all then do:
     1352             assign
     1353               p-plt-id           = tt_price-all.plt-id
     1354               p-plt-db-num       = tt_price-all.plt-db-num
     1355               p-pdf-id           = tt_price-all.pdf-id
     1356               p-pdf-db-num       = tt_price-all.pdf-db
     1357               p-sale-price       = neos_price-all.price-sale
     1358               .
     1359            end.
     1360            else do:
     1361           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1362           if error-status :error    then do:
     1363              message "Не найден бар-код" p-b-code view-as alert-box error .
     1364              return error return-value .
     1365           end.
     1366             assign
     1367               p-plt-id           = tt_price-all.plt-id
     1368               p-plt-db-num       = tt_price-all.plt-db-num
     1369               p-pdf-id           = tt_price-all.pdf-id
     1370               p-pdf-db-num       = tt_price-all.pdf-db
     1371               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1372               .
     1373            end.
     1374        end.
     1375     end.
     1376     end.
     1377   end procedure.
     1378   define input  parameter p-only-b-code as logical   no-undo .
     1379   define input  parameter p-cli-type        as character no-undo .
     1380   define input  parameter p-cli-code        as integer   no-undo .
     1381   define input  parameter p-main-b-code     as integer   no-undo .
     1382   define input  parameter p-b-code          as integer   no-undo .
     1383   define input  parameter p-obj-type        as character no-undo .
     1384   define input  parameter p-obj-code        as integer   no-undo .
     1385   define input  parameter p-doc-qnty        as decimal   no-undo .
     1386   define input  parameter p-tot-rubl        as decimal   no-undo .
     1387   define input  parameter p-vid-pay         as character no-undo .
     1388   define input  parameter p-cash-pay-type   as character no-undo .
     1389   define input  parameter p-fact-order      as decimal   no-undo .
     1390   define output parameter p-plt-id          as integer   no-undo .
     1391   define output parameter p-plt-db-num      as integer   no-undo .
     1392   define output parameter p-pdf-id          as integer   no-undo .
     1393   define output parameter p-pdf-db-num      as integer   no-undo .
     1394   define output parameter p-sale-price-base as decimal   no-undo .
     1395   define output parameter p-sale-price-rubl as decimal   no-undo .
     1396   define output parameter p-road-tax-base   as decimal   no-undo .
     1397   define output parameter p-road-tax-rubl   as decimal   no-undo .
     1398   define output parameter p-excise-base     as decimal   no-undo .
     1399   define output parameter p-excise-rubl     as decimal   no-undo .
     1400   run mpl-autoprice in this-procedure (
     1401      input  p-only-b-code
     1402     ,input  p-cli-type
     1403     ,input  p-cli-code
     1404     ,input  p-main-b-code
     1405     ,input  p-b-code
     1406     ,input  p-obj-type
     1407     ,input  p-obj-code
     1408     ,input  p-doc-qnty
     1409     ,input  p-tot-rubl
     1410     ,input  p-vid-pay
     1411     ,input  p-cash-pay-type
     1412     ,input  p-fact-order
     1413     ,output p-plt-id
     1414     ,output p-plt-db-num
     1415     ,output p-pdf-id
     1416     ,output p-pdf-db-num
     1417     ,output p-sale-price-base
     1418     ,output p-sale-price-rubl
     1419     ,output p-road-tax-base
     1420     ,output p-road-tax-rubl
     1421     ,output p-excise-base
     1422     ,output p-excise-rubl
     1423     ) no-error .
     1424     if error-status :error then
     1425     message
     1426       vss-workfile vss-revision vss-description skip
     1427       error-status :get-message(1) skip
     1428       return-value skip
     1429       "Ошибка mpl-autoprice"
     1430       view-as alert-box error
     1431     .
