        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code    as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: inqivdel.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/inqivdel.p $":U .
        8   define variable vss-description as character no-undo init "Удаление обслуженного внутреннего приходного запроса".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     end.
      145   end procedure.
      146   procedure waitfram-show :
      147     define input  parameter p-message as character no-undo .
      148     define variable v-left-margin as integer   no-undo .
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       if length(p-message) <= 70 then do:
      154         assign
      155           v-left-margin = integer((70 - length(p-message)) / 2)
      156         .
      157         assign
      158           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      159         .
      160         assign
      161           v-waitfram-action01 = " "
      162           v-waitfram-action02 = " "
      163                                    + fill(" ", v-left-margin)
      164                                    + p-message
      165           v-waitfram-action03 = " "
      166         .
      167       end.
      168       else do:
      169         define variable vRindex1 as integer no-undo.
      170         define variable vRindex2 as integer no-undo.
      171         vRindex1 = r-index(p-message," ",70).
      172         if vRindex1 = 0
      173         then
      174            vRindex1 = 70.
      175         if length(p-message)  <= vRindex1 + 70 then do:
      176           assign
      177             v-waitfram-action01 = " "
      178             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      179             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      180           .
      181         end.
      182         else do:
      183           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      184           if vRindex2 <= vRindex1
      185           then
      186              vRindex2 = vRindex1 + 70.
      187           assign
      188             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      191           .
      192         end.
      193       end.
      194       B-viewProcInfo:visible   in frame waitfram = no.
      195       B-viewProcInfo:sensitive in frame waitfram = no.
      196       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       if  (   mWaitFramView
      199          or  mWaitProcEvent)
      200          and not mBatchMode
      201       then
      202          display
      203             v-waitfram-action01 skip
      204             v-waitfram-action02 skip
      205             v-waitfram-action03 skip
      206          with frame waitfram .
      207     end.
      208   end procedure.
      209      procedure waitfram-show-this:
      210         define input  parameter iInterval as int64 no-undo.
      211         define variable vtime as int64 no-undo.
      212         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      213         mWaitFramInterval = iInterval.
      214         run waitfram-show (substitute("&1&2 &3&4" ,
      215                                       mWaitFramTextBeg ,
      216                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      217                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      218                                       mWaitFramTextEnd
      219                                      )
      220                           ).
      221      end.
      222      procedure WaitFramRunPause:
      223         define input  parameter iInterval as dec no-undo.
      224         define variable vStart  as datetime-tz no-undo.
      225         define variable vend    as datetime-tz no-undo.
      226         define variable vint as int64 no-undo.
      227         define variable vOk as logical no-undo.
      228         vStart = now.
      229         vend   = vStart.
      230         publish "WaitFramPause" (iInterval,output vOk).
      231         vend   =  now.
      232         vint = vend - vStart.
      233         vint = iInterval - vint / 1000.
      234         if     not mWaitFramStop
      235            and (   vint > 0
      236                 or (    not vOk
      237                     and iInterval eq ?
      238                     )
      239                 )
      240         then
      241            run waitfram-show-this (iInterval).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and vint > 0
      247         then do:
      248            run gbl/pause.p (vint * 1000).
      249         end.
      250         if iInterval ne ?
      251         then
      252            publish "WaitFramStop".
      253         waitfram-check-timeout().
      254      end.
      255      procedure WaitFramWaitFor:
      256         define input  parameter iInterval as dec no-undo.
      257         assign
      258            mWaitFramStartProc   = now
      259            mWaitFramStopUser    = no
      260            mWaitFramStopTimeOut = no
      261         .
      262         block-wait:
      263         do while not mWaitFramStop:
      264            run WaitFramRunPause (iInterval).
      265            if  waitfram-check-timeout()
      266            then do:
      267               leave block-wait.
      268            end.
      269         end.
      270         run waitfram-hide.
      271      end.
      272   procedure waitfram-join :
      273     define input  parameter p-line-1  as character no-undo .
      274     define input  parameter p-line-2  as character no-undo .
      275     define input  parameter p-line-3  as character no-undo .
      276     define output parameter p-message as character no-undo .
      277     do
      278     on error undo, return error return-value
      279     :
      280       assign
      281         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      282                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      283                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      284       .
      285     end.
      286   end procedure.
      287   function waitfram-join-function returns character
      288     (input p-line-1 as character
      289     ,input p-line-2 as character
      290     ,input p-line-3 as character
      291     ).
      292     define variable v-message as character no-undo .
      293     run waitfram-join in this-procedure
      294       (input  p-line-1
      295       ,input  p-line-2
      296       ,input  p-line-3
      297       ,output v-message
      298       ) .
      299     return v-message .
      300   end function .
      301   do
      302   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      303   :
      304   define buffer PN_trn-doc for ub.trn-doc  .
      305   define buffer PZ_trn-doc for ub.trn-doc  .
      306   define buffer RN_trn-doc for ub.trn-doc  .
      307   define variable v-mane-code as character no-undo .
      308   define variable v-pz-code as character no-undo .
      309     find first PN_trn-doc no-lock where
      310                PN_trn-doc.doc-code  = p-doc-code .
      311     if PN_trn-doc.ext-doc-type <> 'iv':U then return .
      312     v-mane-code = entry(1,p-doc-code , "=") .
      313     find first PZ_trn-doc no-lock where
      314                PZ_trn-doc.doc-code  begins  v-mane-code + "-"  and
      315                Pz_trn-doc.ext-doc-type = 'iv':U  and
      316                Pz_trn-doc.status_      = 'запрос':U no-error .
      317     if error-status :error then return .
      318        v-pz-code = PZ_trn-doc.doc-code .
      319   for each RN_trn-doc no-lock where
      320            RN_trn-doc.doc-code  begins  v-mane-code + "-"  and
      321            RN_trn-doc.ext-doc-type = 'ev':U  :
      322        for each PN_trn-doc no-lock where
      323                 PN_trn-doc.out-code = RN_trn-doc.doc-code :
      324              if PN_trn-doc.status_ <> 'факт':U then return .
      325        end.
      326   end.
      327     find first PZ_trn-doc exclusive-lock where
      328                PZ_trn-doc.doc-code = v-pz-code no-error .
      329     if available PZ_trn-doc then do:
      330        delete PZ_trn-doc.
      331     end.
      332   end.
