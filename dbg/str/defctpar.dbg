      433   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   procedure godendo-date-to-offset :
      435     define input  parameter p-today  as date      no-undo .
      436     define input  parameter p-date   as date      no-undo .
      437     define output parameter p-offset as integer   no-undo .
      438     do
      439     on error undo, return error return-value
      440     :
      441       if p-date  = ?
      442       or p-today = ?
      443       then do:
      444         assign
      445           p-offset = ?
      446         .
      447       end.
      448       else do:
      449         assign
      450           p-offset = p-date - p-today + 1
      451         .
      452       end.
      453     end.
      454   end procedure.
      455   procedure godendo-offset-to-date :
      456     define input  parameter p-today  as date      no-undo .
      457     define input  parameter p-offset as integer   no-undo .
      458     define output parameter p-date   as date      no-undo .
      459     do
      460     on error undo, return error return-value
      461     :
      462       if p-today  = ?
      463       or p-offset = ?
      464       then do:
      465         assign
      466           p-date = ?
      467         .
      468       end.
      469       else do:
      470         assign
      471           p-date = p-offset + p-today - 1
      472         .
      473       end.
      474     end.
      475   end procedure.
      476   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   procedure cur-time :
      478      define output parameter p-today as date      no-undo .
      479      define output parameter p-time  as integer   no-undo .
      480     do
      481     on error undo, return error
      482     :
      483       define variable v-date1 as date      no-undo .
      484       define variable v-date2 as date      no-undo .
      485       define variable v-time  as integer   no-undo .
      486       assign
      487         v-date1 = today
      488         v-time  = time
      489         v-date2 = today
      490       .
      491       if v-date1 <> v-date2
      492       then do:
      493         assign
      494           v-date1 = today
      495           v-time  = v-time
      496         .
      497       end.
      498       assign
      499         p-today = v-date1
      500         p-time  = v-time
      501       .
      502     end.
      503   end.
      504   function cur-time-date returns character
      505   :
      506     return string(today, '99/99/9999':U) .
      507   end.
      508   function cur-time-mjd returns decimal
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return integer(v-date) - 2400002 + (v-time / 86400) .
      517   end.
      518   function cur-time-get-ending-index returns integer
      519   (input p-number as integer
      520   )
      521   :
      522     if p-number < 0
      523     or p-number = ?
      524     then do:
      525       return 1 .
      526     end.
      527     define variable v-rest as integer   no-undo .
      528     assign
      529       p-number = p-number modulo 100
      530     .
      531     if p-number < 20
      532     then do:
      533       assign
      534         v-rest = p-number
      535       .
      536     end.
      537     else do:
      538       assign
      539         v-rest = p-number modulo 10
      540       .
      541     end.
      542     case v-rest :
      543       when 1
      544       then do:
      545         return 2 .
      546       end.
      547       when 2 or
      548       when 3 or
      549       when 4
      550       then do:
      551         return 3 .
      552       end.
      553       otherwise do:
      554         return 1 .
      555       end.
      556     end case .
      557   end.
      558   procedure cur-time-mjd-to-date :
      559      define input  parameter i-mjd-diff as decimal no-undo.
      560      define output parameter o-Date     as date    no-undo.
      561      define output parameter o-Time     as integer no-undo.
      562      define variable v-day-number as integer   no-undo .
      563      if    i-mjd-diff < 0
      564         or i-mjd-diff = ?
      565      then do:
      566         return "?" .
      567      end.
      568      assign
      569         v-day-number = truncate(i-mjd-diff,0).
      570         o-Date = date(v-day-number + 2400002).
      571         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      572     .
      573   end.
      574   function cur-time-mjd-to-string returns character
      575   (input p-mjd-diff as decimal
      576   )
      577   :
      578     define variable v-day-number as integer   no-undo .
      579     define variable v-seconds    as integer   no-undo .
      580     define variable v-hour       as integer   no-undo .
      581     define variable v-min        as integer   no-undo .
      582     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      583     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      584     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      585     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      586     if p-mjd-diff < 0
      587     or p-mjd-diff = ?
      588     then do:
      589       return "?" .
      590     end.
      591     assign
      592       v-day-number = integer(truncate(p-mjd-diff,0))
      593       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      594     .
      595     if v-seconds > 86400
      596     then do:
      597       assign
      598         v-seconds = 86400 - 1
      599       .
      600     end.
      601     if v-seconds < 0
      602     then do:
      603       assign
      604         v-seconds = 0
      605       .
      606     end.
      607     assign
      608       v-hour = truncate(v-seconds / 3600, 0)
      609     .
      610     assign
      611       v-seconds = v-seconds modulo 3600
      612     .
      613     assign
      614       v-min = truncate(v-seconds / 60, 0)
      615     .
      616     assign
      617       v-seconds = v-seconds modulo 60
      618     .
      619     return
      620         (if v-day-number <> 0
      621           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      622           else ""
      623         )
      624       + (if v-day-number <> 0 or v-hour <> 0
      625           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      626           else ""
      627         )
      628       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      629           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      630           else ""
      631         )
      632       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      633       .
      634   end.
      635   function cur-time-string returns character
      636   :
      637     define variable v-date as date      no-undo .
      638     define variable v-time as integer   no-undo .
      639     run cur-time in this-procedure
      640       (output v-date
      641       ,output v-time
      642       ) .
      643     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      644   end.
      645   function cur-time-string-sec returns character
      646   :
      647     define variable v-date as date      no-undo .
      648     define variable v-time as integer   no-undo .
      649     run cur-time in this-procedure
      650       (output v-date
      651       ,output v-time
      652       ) .
      653     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      654   end.
      655   function cur-time-custom  returns character
      656   (input p-prefix as character
      657   ,input p-date-format as character
      658   ,input p-delimiter as character
      659   ,input p-time-format as character
      660   ,input p-suffix as character
      661   )
      662   :
      663     define variable v-date as date      no-undo .
      664     define variable v-time as integer   no-undo .
      665     run cur-time in this-procedure
      666       (output v-date
      667       ,output v-time
      668       ) .
      669     return
      670       p-prefix
      671       + string(v-date, p-date-format)
      672       + p-delimiter
      673       + string(v-time, p-time-format)
      674       + p-suffix
      675       .
      676   end.
      677   function cur-time-print  returns character
      678   :
      679     define variable v-date as date      no-undo .
      680     define variable v-time as integer   no-undo .
      681     run cur-time in this-procedure
      682       (output v-date
      683       ,output v-time
      684       ) .
      685     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      686   end.
      687   function cur-time-datetime returns datetime
      688   :
      689     define variable v-char as character no-undo .
      690     define variable v-datetime as datetime no-undo .
      691     v-char = cur-time-string().
      692     v-datetime = datetime(v-char).
      693     return  v-datetime.
      694   end.
      695   function cur-time-string-msec returns character
      696   :
      697     define variable v-date as datetime  no-undo .
      698     v-date = now.
      699     return string(v-date) .
      700   end.
      701   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   define variable c-point  as character no-undo .
      703   define variable tbl      as character no-undo .
      704   define variable join-tbl as character no-undo .
      705   define variable fld      as character no-undo .
      706   define variable lab      as character no-undo .
