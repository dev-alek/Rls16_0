     1659        SIZE 6.5 BY 1 TOOLTIP "Импортировать из Excel ( Alt+I ) подготовленный файл программой ФАЛЬСИФИКАТ"
     1660        BGCOLOR 8 .
     1661   DEFINE BUTTON b-make-add
     1662        LABEL "Добавить"
