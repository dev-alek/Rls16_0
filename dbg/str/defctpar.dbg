      710   procedure fltfield-clear :
      711     define output parameter loc-fld as character no-undo.
      712     define output parameter loc-lab as character no-undo .
      713     define output parameter loc-spr as character no-undo .
      714     define output parameter loc-dim as character no-undo .
      715     assign
      716       loc-fld = ""
      717       loc-lab = ""
      718       loc-spr = ""
      719       loc-dim = "0"
      720     .
      721   end procedure .
      722   procedure fltfield-add :
      723     define input        parameter par-fld as character no-undo.
      724     define input        parameter par-lab as character no-undo .
      725     define input        parameter par-spr as character no-undo .
      726     define input-output parameter loc-fld as character no-undo.
      727     define input-output parameter loc-lab as character no-undo .
      728     define input-output parameter loc-spr as character no-undo .
      729     define input-output parameter loc-dim as character no-undo .
      730     do
      731     on error undo, return error
      732     :
      733       assign
      734       loc-fld = if loc-dim = '0'
      735                 then par-fld
      736                 else (loc-fld + chr(44) + par-fld)
      737       loc-lab = if loc-dim = '0'
      738                 then par-lab
      739                 else (loc-lab + chr(44) + par-lab)
      740       loc-spr = if loc-dim = '0'
      741                 then par-spr
      742                 else (loc-spr + chr(44) + par-spr)
      743       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      744                 string(integer(if num-entries(loc-dim) > 1
      745                               then entry(2, loc-dim)
      746                               else entry(1, loc-dim)
      747                               ) + 1)
      748       no-error
      749       .
      750     end.
      751   end procedure.
      752   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      754   procedure fltopend_fltopend :
      755   define input parameter p-parent-handle as handle no-undo .
      756   define input parameter p-qh as handle no-undo .
      757   define input parameter p-flt-open-open-query  as character no-undo .
      758   define input parameter p-where-cond as character no-undo .
      759   define input parameter p-use-indFIRST-query-tail as character no-undo .
      760   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      761   define input parameter p-indexed-reposition as character no-undo .
      762     do
      763     on error undo, return error
      764     :
      765   define variable v-prepare-string as character no-undo .
      766   define variable glog as logical no-undo .
      767   assign
      768   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      769                      p-where-cond + chr(32)  +
      770                      p-use-indFIRST-query-tail + chr(32) +
      771                      p-use-ind-sort-clmn-by + chr(32) +
      772                      p-indexed-reposition
      773   .
      774   assign
      775   glog = p-qh:query-prepare(v-prepare-string) no-error .
      776   if not glog
      777   or error-status:error then do:
      778     message error-status:get-message(1) view-as alert-box .
      779     undo, return error .
      780   end.
      781   assign
      782   glog = p-qh:query-open no-error .
      783   if not glog
      784   or error-status:error then do:
      785     message error-status:get-message(1) view-as alert-box .
      786     undo, return error .
      787   end.
      788     end.
      789   end procedure.
      790   procedure fltopend_fltfindd :
      791   define input parameter p-parent-handle as handle no-undo .
      792   define input parameter p-qh as handle no-undo .
      793   define input parameter p-rowid as rowid no-undo .
      794   define input parameter p-next as logical no-undo .
      795   define input parameter p-lock as integer no-undo .
      796   define input parameter p-bh as handle no-undo .
      797   define input parameter p-where-cond as character no-undo .
      798   define input parameter p-use-index-phrase as character no-undo .
      799   define variable glog as logical no-undo .
      800   define variable v-qh as handle no-undo .
      801   define variable v-bh as handle no-undo .
      802   define variable v-recid as recid no-undo .
      803   define variable v-prepare-string as character no-undo .
      804   do
      805   on error undo, return error
      806   on stop undo, return error
      807   :
      808     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      809     create buffer v-bh for table p-bh buffer-name p-bh:name.
      810     create query v-qh.
      811     v-qh:set-buffers(v-bh).
      812     v-prepare-string = substitute("for each &1 &2 &3"
      813                                     ,v-bh:name
      814                                     ,p-where-cond
      815                                     ,p-use-index-phrase).
      816     glog = v-qh:query-prepare(v-prepare-string) no-error.
      817     if not glog then do:
      818       delete object v-qh.
      819       delete object v-bh.
      820       undo, return error .
      821     end.
      822     glog = v-qh:query-open no-error .
      823     if not glog then do:
      824       delete object v-qh.
      825       delete object v-bh.
      826       undo, return error .
      827     end.
      828     if p-next then do:
      829       v-qh:reposition-to-rowid(p-rowid) no-error .
      830       glog = v-qh:get-next( p-lock) no-error .
      831       glog = v-qh:get-next( p-lock) no-error .
      832       if not glog or v-qh:query-off-end = yes then do:
      833         glog = v-qh:get-first( p-lock) no-error .
      834       end.
      835     end.
      836     else do:
      837       glog = v-qh:get-first( p-lock) no-error .
      838     end.
      839     v-recid = v-bh:recid no-error .
      840     delete object v-qh.
      841     delete object v-bh.
      842     return string(v-recid) .
      843   end.
      844   end procedure.
      845   procedure fltopend_fltfindq :
      846   define input parameter p-parent-handle as handle no-undo .
      847   define input parameter p-qh as handle no-undo .
      848   define input parameter p-next as logical no-undo .
      849   define input parameter p-lock as integer no-undo .
      850   define input parameter p-flt-open-open-query  as character no-undo .
      851   define input parameter p-where-cond as character no-undo .
      852   define input parameter p-use-indFIRST-query-tail as character no-undo .
      853   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      854   define input parameter p-indexed-reposition as character no-undo .
      855   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      856   define variable glog as logical no-undo .
      857   define variable v-qh as handle no-undo .
      858   define variable v-bh as handle no-undo extent 18.
      859   define variable v-rowid as rowid no-undo extent 18.
      860   define variable v-ii as integer no-undo .
      861   define variable v-prepare-string as character no-undo .
      862   do
      863   on error undo, return error
      864   on stop undo, return error
      865   :
      866     create query v-qh.
      867     do v-ii = 1 to p-qh:num-buffers:
      868       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      869       assign
      870       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      871       no-error.
      872       v-qh:add-buffer(v-bh[v-ii]).
      873     end.
      874     assign
      875     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      876                       p-where-cond + chr(32)  +
      877                       p-use-indFIRST-query-tail + chr(32) +
      878                       p-use-ind-sort-clmn-by + chr(32) +
      879                       p-indexed-reposition
      880     .
      881     glog = v-qh:query-prepare( v-prepare-string) no-error .
      882     if not glog then do:
      883       delete object v-qh.
      884       do v-ii = 1 to p-qh:num-buffers:
      885         delete object v-bh[v-ii].
      886       end.
      887       undo, return error .
      888     end.
      889     glog = v-qh:query-open no-error .
      890     if not glog then do:
      891       delete object v-qh.
      892       do v-ii = 1 to p-qh:num-buffers:
      893         delete object v-bh[v-ii].
      894       end.
      895       undo, return error .
      896     end.
      897     if p-next then do:
      898       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      899       glog = v-qh:get-next( p-lock) no-error .
      900       glog = v-qh:get-next( p-lock) no-error .
      901       if not glog or v-qh:query-off-end = yes then do:
      902         glog = v-qh:get-first( p-lock) no-error .
      903       end.
      904     end.
      905     else do:
      906       glog = v-qh:get-first( p-lock) no-error .
      907     end.
      908     do v-ii = 1 to p-qh:num-buffers:
      909       assign
      910       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      911       no-error.
      912     end.
      913     delete object v-qh.
      914     do v-ii = 1 to p-qh:num-buffers:
      915       delete object v-bh[v-ii].
      916     end.
      917   end.
      918   end procedure.
      919   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   FUNCTION mark-string RETURNS CHARACTER
      921     ( input p-recid as recid, input mark-list as character  ) :
      922     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      923   END FUNCTION.
      924   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      925   define variable v-waitfram-action01         as character   no-undo .
      926   define variable v-waitfram-action02         as character   no-undo .
      927   define variable v-waitfram-action03         as character   no-undo .
      928   define variable mWaitFramTextBeg            as character   no-undo.
      929   define variable mWaitFramTextEnd            as character   no-undo.
      930   define variable mWaitFramView               as logical     no-undo.
      931   define variable mWaitProcEvent              as logical     no-undo init yes.
      932   define variable mWaitFramInterval           as integer     no-undo init 1 .
      933   define variable mWaitFramStop               as logical     no-undo.
      934   define variable mWaitFramStopUser           as logical     no-undo.
      935   define variable mWaitFramStopTimeOut        as logical     no-undo.
      936   define variable mWaitFramStartProc          as datetime-tz no-undo.
      937   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      938   define button B-WaitFramStop auto-end-key
      939        label "Стоп"
      940        size 10 by 1 tooltip "Остоновить процесс".
      941   define button B-viewProcInfo
      942        label "Информация"
      943        size 15 by 1 tooltip "Информация о процесс".
      944   define frame waitfram
      945     v-waitfram-action01 format "x(72)" no-label skip
      946     v-waitfram-action02 format "x(72)" no-label skip
      947     v-waitfram-action03 format "x(72)" no-label skip
      948     B-viewProcInfo
      949     B-WaitFramStop at row 4 col 30
      950     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      951     .
      952   define new global shared variable mBatchMode as logical no-undo init ?.
      953   define variable mFramBachModHandle as handle no-undo.
      954   mFramBachModHandle = frame waitfram:handle.
      955   define variable mFameOldVis as logical no-undo.
      956   define variable mVisCUrentVin as logical no-undo.
      957   if session:batch-mode
      958   then
      959      mBatchMode = yes.
      960   if mBatchMode = ? then do:
      961     mVisCUrentVin = current-window:visible.
      962     mFameOldVis = mFramBachModHandle:visible.
      963     mFramBachModHandle:visible  = yes.
      964     mBatchMode = mFramBachModHandle:visible ne yes.
      965     mFramBachModHandle:visible = mFameOldVis.
      966     current-window:visible = mVisCUrentVin.
      967   end.
      968    if  log-manager:logfile-name ne ?
      969     then DO:
      970         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      971         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      972         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      973     end.
      974   on choose of B-WaitFramStop in frame waitfram
      975   do:
      976     mWaitFramStop = yes.
      977     mWaitFramStopUser = yes.
      978   end.
      979   function waitfram-check-timeout returns logical():
      980      define variable vtime as int64 no-undo.
      981      if mWaitFramStopTimeOut
      982      then
      983         return yes.
      984      vtime = ( now - mWaitFramStartProc ) / 1000 .
      985      if     mWaitFramTimeOut ne ?
      986         and mWaitFramTimeOut ne 0
      987         and mWaitFramTimeOut lt vtime
      988      then do:
      989         mWaitFramStopTimeOut = yes.
      990      end.
      991      return mWaitFramStopTimeOut.
      992   end.
      993   procedure waitfram-hide :
      994     if not session:batch-mode
      995     then do
      996     on error undo, return error return-value
      997     :
      998       pause 0 before-hide .
      999       if not mBatchMode then
     1000         hide frame waitfram .
     1001     if     not mWaitFramView
     1002        and mWaitProcEvent
     1003     then
     1004       process events .
     1005     end.
     1006   end procedure.
     1007   procedure waitfram-show :
     1008     define input  parameter p-message as character no-undo .
     1009     define variable v-left-margin as integer   no-undo .
     1010     if not session:batch-mode
     1011     then do
     1012     on error undo, return error return-value
     1013     :
     1014       if length(p-message) <= 70 then do:
     1015         assign
     1016           v-left-margin = integer((70 - length(p-message)) / 2)
     1017         .
     1018         assign
     1019           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1020         .
     1021         assign
     1022           v-waitfram-action01 = " "
     1023           v-waitfram-action02 = " "
     1024                                    + fill(" ", v-left-margin)
     1025                                    + p-message
     1026           v-waitfram-action03 = " "
     1027         .
     1028       end.
     1029       else do:
     1030         define variable vRindex1 as integer no-undo.
     1031         define variable vRindex2 as integer no-undo.
     1032         vRindex1 = r-index(p-message," ",70).
     1033         if vRindex1 = 0
     1034         then
     1035            vRindex1 = 70.
     1036         if length(p-message)  <= vRindex1 + 70 then do:
     1037           assign
     1038             v-waitfram-action01 = " "
     1039             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1040             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1041           .
     1042         end.
     1043         else do:
     1044           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1045           if vRindex2 <= vRindex1
     1046           then
     1047              vRindex2 = vRindex1 + 70.
     1048           assign
     1049             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1050             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1051             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1052           .
     1053         end.
     1054       end.
     1055       B-viewProcInfo:visible   in frame waitfram = no.
     1056       B-viewProcInfo:sensitive in frame waitfram = no.
     1057       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1058       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1059       if  (   mWaitFramView
     1060          or  mWaitProcEvent)
     1061          and not mBatchMode
     1062       then
     1063          display
     1064             v-waitfram-action01 skip
     1065             v-waitfram-action02 skip
     1066             v-waitfram-action03 skip
     1067          with frame waitfram .
     1068       if     mWaitFramView
     1069          then do:
     1070             if     mWaitFramInterval ne ?
     1071                and not mBatchMode
     1072             then
     1073                wait-for go of frame waitfram pause mWaitFramInterval.
     1074          end.
     1075          else
     1076             if     mWaitProcEvent
     1077                and not mBatchMode
     1078             then
     1079                process events .
     1080     end.
     1081   end procedure.
     1082      procedure waitfram-show-this:
     1083         define input  parameter iInterval as int64 no-undo.
     1084         define variable vtime as int64 no-undo.
     1085         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1086         mWaitFramInterval = iInterval.
     1087         run waitfram-show (substitute("&1&2 &3&4" ,
     1088                                       mWaitFramTextBeg ,
     1089                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1090                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1091                                       mWaitFramTextEnd
     1092                                      )
     1093                           ).
     1094      end.
     1095      procedure WaitFramRunPause:
     1096         define input  parameter iInterval as dec no-undo.
     1097         define variable vStart  as datetime-tz no-undo.
     1098         define variable vend    as datetime-tz no-undo.
     1099         define variable vint as int64 no-undo.
     1100         define variable vOk as logical no-undo.
     1101         vStart = now.
     1102         vend   = vStart.
     1103         publish "WaitFramPause" (iInterval,output vOk).
     1104         vend   =  now.
     1105         vint = vend - vStart.
     1106         vint = iInterval - vint / 1000.
     1107         if     not mWaitFramStop
     1108            and (   vint > 0
     1109                 or (    not vOk
     1110                     and iInterval eq ?
     1111                     )
     1112                 )
     1113         then
     1114            run waitfram-show-this (iInterval).
     1115         vend   =  now.
     1116         vint = vend - vStart.
     1117         vint = iInterval - vint / 1000.
     1118         if     not mWaitFramStop
     1119            and vint > 0
     1120         then do:
     1121            run gbl/pause.p (vint * 1000).
     1122         end.
     1123         if iInterval ne ?
     1124         then
     1125            publish "WaitFramStop".
     1126         waitfram-check-timeout().
     1127      end.
     1128      procedure WaitFramWaitFor:
     1129         define input  parameter iInterval as dec no-undo.
     1130         assign
     1131            mWaitFramStartProc   = now
     1132            mWaitFramStopUser    = no
     1133            mWaitFramStopTimeOut = no
     1134         .
     1135         block-wait:
     1136         do while not mWaitFramStop:
     1137            run WaitFramRunPause (iInterval).
     1138            if  waitfram-check-timeout()
     1139            then do:
     1140               leave block-wait.
     1141            end.
     1142         end.
     1143         run waitfram-hide.
     1144      end.
     1145   procedure waitfram-join :
     1146     define input  parameter p-line-1  as character no-undo .
     1147     define input  parameter p-line-2  as character no-undo .
     1148     define input  parameter p-line-3  as character no-undo .
     1149     define output parameter p-message as character no-undo .
     1150     do
     1151     on error undo, return error return-value
     1152     :
     1153       assign
     1154         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1155                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1156                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1157       .
     1158     end.
     1159   end procedure.
     1160   function waitfram-join-function returns character
     1161     (input p-line-1 as character
     1162     ,input p-line-2 as character
     1163     ,input p-line-3 as character
     1164     ).
     1165     define variable v-message as character no-undo .
     1166     run waitfram-join in this-procedure
     1167       (input  p-line-1
     1168       ,input  p-line-2
     1169       ,input  p-line-3
     1170       ,output v-message
     1171       ) .
     1172     return v-message .
     1173   end function .
