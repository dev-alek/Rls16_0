     1578     ,output v-host-code
     1579     )  .
     1580     DEFINE TEMP-TABLE xx_parts NO-UNDO LIKE ub.parts.
     1581   FUNCTION f-obj-name RETURN CHARACTER
     1582   ( input p-recid as recid ).
     1583   define buffer bf_parts for x_parts  .
     1584     find first  bf_parts no-lock where recid(bf_parts) = p-recid no-error .
     1585     if not available bf_parts then RETURN "".
     1586     find first  ub.clients no-lock where
     1587                 ub.clients.obj-code = bf_parts.obj-code and
     1588                 ub.clients.obj-type = bf_parts.obj-type no-error .
     1589                 if not available ub.clients then RETURN "".
     1590     return ub.clients.obj-name .
     1591   END FUNCTION.
     1592   FUNCTION f-cli-name RETURN CHARACTER
     1593   ( input p-recid as recid ).
     1594   define buffer bf_parts for x_parts  .
     1595     find first  bf_parts no-lock where recid (bf_parts) = p-recid no-error .
     1596     if not available bf_parts then RETURN "" .
     1597     find first  ub.clients no-lock where
     1598                 ub.clients.obj-code = bf_parts.supp-code and
     1599                 ub.clients.obj-type = bf_parts.supp-type no-error .
     1600                 if not available ub.clients then RETURN "".
     1601     return ub.clients.obj-name .
     1602   END FUNCTION.
